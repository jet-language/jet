// `jetpack browser lock|provision|resolve|list` (Rust
// jetpack::CLI::browser #1187): lock WebDriver-BiDi
// browser binaries into `.jet/lock` and read them back verified.

BrowserVerb: enum {
    Lock
    Provision
    Resolve
    List

    parse: fn(text: String) -> BrowserVerb? Never! {
        if text == {
            BROWSER_VERB_LOCK -> Val(BrowserVerb.Lock)
            BROWSER_VERB_PROVISION -> Val(BrowserVerb.Provision)
            BROWSER_VERB_RESOLVE -> Val(BrowserVerb.Resolve)
            BROWSER_VERB_LIST -> Val(BrowserVerb.List)
            else -> None
        }
    }
}

cli_cmd_browser: fn(verification: &StoreVerification, theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    cache := WorkspaceDeclarationCache.new()
    raw: parsed.positional.get(0) ?? {
        theme.error("`jetpack browser` needs a verb", "verbs are: {BROWSER_VERBS.join(", ")} — lock or provision a project-pinned browser binary.", "try `jetpack browser list` or `jetpack browser lock chromium --binary ./chromium`.")
        return EXIT_USAGE
    }
    verb: BrowserVerb.parse(raw) ?? {
        theme.error("`{raw}` is not a jetpack browser verb", "`jetpack browser` verbs are: {BROWSER_VERBS.join(", ")}.", "try `jetpack browser lock chromium --binary /path/to/chromium`.")
        return EXIT_USAGE
    }
    if verb == {
        .Lock -> cli_browser_lock(theme, parsed)
        .Provision -> cli_browser_provision(verification, cache, theme, parsed)
        .Resolve -> cli_browser_resolve(theme, parsed)
        .List -> cli_browser_list(theme)
    }
}

// Browser commands pin relative to the current directory.
cli_browser_project_root: fn() -[FS, Env]> String Never! {
    sys.current_dir() ?? "."
}

// A browser flag from the parsed flags, else `name <value>` among the
// positional arguments.
cli_browser_flag_value: fn(parsed: CLIParsed, name: String) -> String? Never! {
    parsed_value: if name == {
        BROWSER_FLAG_BINARY -> parsed.flags.browser_binary
        BROWSER_FLAG_VERSION -> parsed.flags.version
        BROWSER_FLAG_PROTOCOL -> parsed.flags.browser_protocol
        BROWSER_FLAG_DRIVER -> parsed.flags.browser_driver
        else -> None
    }
    if parsed_value != None -> return parsed_value
    index := 0
    loop index + 1 < parsed.positional.len() {
        if parsed.positional[index] == name -> return Val(parsed.positional[index + 1])
        index += 1
    }
    None
}

cli_browser_protocol: fn(parsed: CLIParsed) -> String Never! {
    cli_browser_flag_value(parsed, BROWSER_FLAG_PROTOCOL) ?? BROWSER_DEFAULT_PROTOCOL
}

cli_browser_lock: fn(theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
    engine: parsed.positional.get(1) ?? {
        theme.error("`jetpack browser lock` needs an engine", "engines are: {BROWSER_ENGINES.join(", ")}.", "try `jetpack browser lock chromium --binary /usr/bin/chromium`.")
        return EXIT_USAGE
    }
    binary: cli_browser_flag_value(parsed, BROWSER_FLAG_BINARY) ?? {
        theme.error("`jetpack browser lock` needs --binary <path>", "locking pins an exact on-disk browser for automation; PATH lookups are rejected.", "try `jetpack browser lock chromium --binary /nix/store/.../bin/chromium`.")
        return EXIT_USAGE
    }
    version: cli_browser_flag_value(parsed, BROWSER_FLAG_VERSION) ?? env_browser_read_version_label(binary)
    driver: cli_browser_flag_value(parsed, BROWSER_FLAG_DRIVER) ?? ""
    if env_browser_lock_binary(cli_browser_project_root(), engine, binary, version, cli_browser_protocol(parsed), driver, "locked from {binary}") == {
        .Ok(locked) -> {
            theme.status("locked {theme.bold(locked.engine)} {theme.bold(locked.version)} -> {locked.binary} ({locked.envelope.output_hash})")
            EXIT_OK
        }
        .Err(error) -> {
            theme.error("browser lock failed", error.message(), "fix the binary path and retry.")
            EXIT_USAGE
        }
    }
}

cli_browser_provision: fn(verification: &StoreVerification, cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    raw: parsed.positional.get(1) ?? {
        theme.error("`jetpack browser provision` needs a package ref", "provision realizes one browser package and locks its binary into `.jet/lock`.", "try `jetpack browser provision chromium@jetpack`.")
        return EXIT_USAGE
    }
    spec: cli_classify_or_report(cache, theme, raw) ?? return EXIT_USAGE
    engine: env_browser_normalize_engine(spec.short_name()) ?? {
        theme.error("browser provision needs a supported engine package", err.message(), "package short name must be one of: {BROWSER_ENGINES.join(", ")}.")
        return EXIT_USAGE
    }
    // An engine that serves BiDi only through a WebDriver driver provisions
    // that driver from the same source, so the two versions match.
    driver_package: env_browser_driver_package(engine) ?? ""
    refs := [RefSpec]{spec}
    if driver_package != "" {
        driver_spec: cli_classify_or_report(cache, theme, cli_browser_driver_ref(raw, driver_package)) ?? return EXIT_USAGE
        refs.push(driver_spec)
    }
    roots: pkg_resolve_roots()
    plan: RunPlan{
        project_root: cli_current_dir(),
        refs: refs,
        adapters: [AdapterPlan]{},
        table: cli_cwd_table(cache),
        label: JETPACK_PROMPT_LABEL,
        prompt_path: PromptPathMode.Short,
        prompt_strip: PromptStripMode.Off,
        dev_services: [DevServicePlan]{},
        secrets: [SecretSpec]{},
        environment: EnvironmentFacts{},
    }
    env: cli_compose_env(verification, theme, roots, parsed.flags, plan) ?? {
        if err == .Reported(code) -> return code
        theme.error("couldn't compose the browser environment", err.message(), "retry the provision after fixing the reported problem.")
        return EXIT_USAGE
    }
    // The lock pins durable binaries for later processes, so it names each
    // sealed output itself once its lease revalidates it.
    binary := ""
    driver := ""
    loop lease in env.cache_leases {
        lease.validate() ?? {
            store_report_integrity(theme, lease.consumption_failure(err))
            return EXIT_USAGE
        }
        output: lease.original_output()
        if binary == "" && env_browser_find_engine_binary(output, engine) == .Ok(found) -> binary = found
        if driver_package != "" && driver == "" && env_browser_find_driver(output, driver_package) == .Ok(found) -> driver = found
    }
    if binary == "" {
        theme.error("could not find the browser binary in the realized package", "`{spec.raw}` realized no executable {engine} under bin/.", "pick chromium, firefox, or webkit from a realizable source.")
        return EXIT_USAGE
    }
    if driver_package != "" && driver == "" {
        theme.error("could not find the browser driver in the realized package", "{engine} launches through {driver_package}, and its package realized no executable under bin/.", "provision from a source that ships {driver_package} beside {engine}.")
        return EXIT_USAGE
    }
    version: cli_browser_flag_value(parsed, BROWSER_FLAG_VERSION) ?? env_browser_read_version_label(binary)
    if env_browser_lock_binary(cli_browser_project_root(), engine, binary, version, cli_browser_protocol(parsed), driver, "{spec.raw} via jetpack browser provision") == {
        .Ok(locked) -> {
            theme.status("provisioned {theme.bold(locked.engine)} {theme.bold(locked.version)} -> {locked.binary} ({locked.envelope.output_hash})")
            EXIT_OK
        }
        .Err(error) -> {
            theme.error("browser provision lock failed", error.message(), "the realized binary could not be pinned; check permissions on `.jet/lock`.")
            EXIT_USAGE
        }
    }
}

// `chromedriver@<source>` for `chromium@<source>`: the driver ref keeps the
// engine ref's source.
cli_browser_driver_ref: fn(raw: String, driver_package: String) -> String Never! {
    pieces: raw.split("@").to_list()
    out := driver_package.copy()
    index := 1
    loop index < pieces.len() {
        out = "{out}@{pieces[index]}"
        index += 1
    }
    out
}

cli_browser_resolve: fn(theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Time.Wait]> Int Never! {
    engine: parsed.positional.get(1) ?? {
        theme.error("`jetpack browser resolve` needs an engine", "engines are: {BROWSER_ENGINES.join(", ")}.", "try `jetpack browser resolve chromium`.")
        return EXIT_USAGE
    }
    if env_browser_resolve(cli_browser_project_root(), engine) == {
        .Ok(locked) -> {
            driver: if locked.driver == "" -> "" else -> "\ndriver={locked.driver}\ndriver-size={locked.driver_size}"
            print("engine={locked.engine}\nversion={locked.version}\nbinary={locked.binary}\nprotocol={locked.protocol}\noutput-hash={locked.envelope.output_hash}\nplatform={locked.envelope.platform}\nsize={locked.size}{driver}")
            EXIT_OK
        }
        .Err(error) -> {
            theme.error("browser resolve failed", error.message(), "run `jetpack browser lock` or `jetpack browser provision` first.")
            EXIT_USAGE
        }
    }
}

cli_browser_list: fn(theme: Theme) -[IO, FS, Env, Time.Wait]> Int Never! {
    browsers: env_browser_list(cli_browser_project_root())
    if browsers.len() == 0 {
        theme.status("no locked browsers yet.")
        return EXIT_OK
    }
    print("ENGINE    VERSION  PROTOCOL     HASH")
    loop browser in browsers {
        version: if browser.version == "" -> "-" else -> browser.version
        print("{terminal_pad_end(browser.engine, 9)} {terminal_pad_end(version, 8)} {terminal_pad_end(browser.protocol, 12)} {browser.envelope.output_hash}")
    }
    EXIT_OK
}
