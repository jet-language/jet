// Rust: crates/jetpack/src/CLI/run_enter_dev.rs:2425
// Avoid the existing owner's quadratic array membership union.
fn format_env_changes(previous: [(name: String, version: String)], current: [(name: String, version: String)]) -> String? {
    before := [String: String]{}
    after := [String: String]{}
    names := [String: Bool]{}
    loop pair in previous {
        before[pair.name] = pair.version
        names[pair.name] = true
    }
    loop pair in current {
        after[pair.name] = pair.version
        names[pair.name] = true
    }
    sorted := names.keys().to_list()
    &sorted.sort()
    updated := [(name: String, old: String, new: String)]{}
    added := [(name: String, version: String)]{}
    removed := [(name: String, version: String)]{}
    loop name in sorted {
        old :: before.get(name)
        new :: after.get(name)
        if old == .Val(old_version) && new == .Val(new_version) {
            if old_version != new_version -> &updated.push((name: name, old: old_version, new: new_version))
        } else if new == .Val(version) {
            &added.push((name: name, version: version))
        } else if old == .Val(version) {
            &removed.push((name: name, version: version))
        }
    }
    parts := [String]{}
    if updated.len() > 0 {
        first :: updated[0]
        &parts.push(if first.old.is_empty() || first.new.is_empty() -> "{first.name} updated" else -> "{first.name} {first.old} to {first.new}")
        if updated.len() > 1 -> &parts.push("{updated.len()} tools updated")
    }
    if added.len() > 0 {
        first :: added[0]
        label :: if first.version.is_empty() -> first.name else -> "{first.name} {first.version}"
        &parts.push("{label} added")
        if added.len() > 1 -> &parts.push("{added.len()} tools added")
    }
    if removed.len() > 0 {
        first :: removed[0]
        label :: if first.version.is_empty() -> first.name else -> "{first.name} {first.version}"
        &parts.push("{label} removed")
        if removed.len() > 1 -> &parts.push("{removed.len()} tools removed")
    }
    if parts.is_empty() -> None else -> Val(parts.join(", "))
}

