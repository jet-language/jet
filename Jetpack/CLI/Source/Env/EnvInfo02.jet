// Rust: crates/jetpack/src/CLI/run_enter_dev.rs:2183
// GATE #4494: exclusive native file creation, sync, rename, clock and process ID.
// GATE #4409: validation is InvalidInput, not canonical CLIError.InvalidData.
fn write_env_entry_receipt(project_dir: OSPath, stamp: String, secret_identity: String, packages: [EnvironmentSelection]) -> Error! {
    if stamp.is_empty() || stamp.chars().any(character -> character == '\t' || character == '\n' || character == '\r')
        || secret_identity.is_empty() || secret_identity.chars().any(character -> character == '\t' || character == '\n' || character == '\r') {
        return Err(Error.new(ErrorKind.InvalidInput, "environment entry identity cannot contain line separators"))
    }
    loop package in packages {
        loop field in [String]{package.reference, package.name, package.version, package.output_hash, package.metadata} {
            if field.chars().any(character -> character == '\t' || character == '\n' || character == '\r') {
                return Err(Error.new(ErrorKind.InvalidInput, "environment entry package fields cannot contain line separators"))
            }
        }
    }
    path :: project_dir.join(".jet").join("receipts").join(ENV_ENTRY_RECEIPT_NAME)
    parent :: path.parent() ?? panic("environment entry receipt has a parent")
    fs.create_dir_all(parent)?
    nonce :: SystemTime.now().duration_since(UNIX_EPOCH).map_or(0, duration -> duration.as_nanos())
    temporary :: parent.join(".{ENV_ENTRY_RECEIPT_NAME}.{process.id()}.{nonce}.tmp")
    result :: (() -> {
        file := OpenOptions.new().create_new(true).write(true).open(temporary)?
        &file.write_all("{ENV_ENTRY_RECEIPT_HEADER}\n".bytes())?
        &file.write_all("stamp\t{stamp}\n".bytes())?
        &file.write_all("secrets\t{secret_identity}\n".bytes())?
        loop package in cli_canonical_env_entry(packages) {
            &file.write_all("{package.reference}\t{package.name}\t{package.version}\t{package.output_hash}\t{package.metadata}\n".bytes())?
        }
        file.sync_all()?
        fs.rename(temporary, path)
    })()
    if result == .Err(_) -> _ :: fs.remove_file(temporary)
    result
}

