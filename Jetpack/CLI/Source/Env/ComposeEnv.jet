// Environment composition, ported from jetpack::CLI::trust_env_build
// (compose_env and its helpers): realize every ref of a run plan, reuse warm
// verified realizations, project provider search paths, presets, language
// packs, dotenv, Git hooks, and the native dev-tool projection, then seal
// provider records against the final project lock. A failure is rendered
// here and travels as `CliError.Reported(code)`.

// Realization facts for the env-entry banner and the receipt stamp.
pub struct EnvReadyStats {
    pub total: Int
    pub cache_hits: Int
    pub realized: [EnvironmentSelection]

    fn empty() -> EnvReadyStats Never! {
        EnvReadyStats{total: 0, cache_hits: 0, realized: [EnvironmentSelection]{}}
    }

    // A local reuse and a verified binary-cache substitution both avoid
    // fresh work for the user entering the environment.
    fn record(&self, entry: StoreEntry, state: SourceState) Never! {
        self.total += 1
        if state == SourceState.Cached || state == SourceState.Substituted -> self.cache_hits += 1
        &self.realized.push(store_environment_entry_selection(entry))
    }

    // Refresh each selection to the most recently used matching entry.
    fn canonicalize(&self, roots: HangarRoots) Never! -[FS, Env]> {
        if self.realized.len() == 0 -> return
        latest := [String: StoreEntry]{}
        loop entry in store_list_read_only(roots) {
            key :: "{entry.reference}\t{entry.name}\t{entry.version}\t{entry.envelope.output_hash}"
            replace :: if latest.get(key) == {
                .Val(current) -> entry.last_used_at > current.last_used_at || (entry.last_used_at == current.last_used_at && entry.id > current.id)
                .None -> true
            }
            if replace -> latest[key] = entry
        }
        loop index in 0..<self.realized.len() {
            if latest.get(self.realized[index].base_key()) == .Val(entry) -> self.realized[index] = store_environment_entry_selection(entry)
        }
    }

    fn cache_hit_percent(self) -> Int Never! {
        if self.total == 0 -> return 100
        self.cache_hits * 100 /% self.total
    }

    // The distinct realized `(name, version)` pairs in order.
    fn realized_set(self) -> [(name: String, version: String)] Never! {
        pairs := [(name: String, version: String)]{}
        loop selection in self.realized {
            version :: if selection.version == "" -> cli_version_from_out(selection.name, selection.output_hash) ?? "" else -> selection.version
            pair :: (name: selection.name, version: version)
            if !pairs.contains(pair) -> &pairs.push(pair)
        }
        &pairs.sort_by((left: (name: String, version: String), right: (name: String, version: String)) -> (left.name <=> right.name).then(left.version <=> right.version))
        pairs
    }

    fn realized_entries(self) -> [EnvironmentSelection] Never! {
        entries := self.realized
        &entries.sort_by((left: EnvironmentSelection, right: EnvironmentSelection) -> left.key() <=> right.key())
        entries
    }
}

// Seal every provider record against the final project lock after all
// package publications; only this post-pass writes the digest that later
// online and offline replays use.
fn cli_seal_project_producer_records(roots: HangarRoots, project_root: String, ready_stats: EnvReadyStats) CliError! -[FS, Env, Time]> {
    lock_digest :: provider_project_lock_digest(Val(project_root)) ?? return Err(CliError.Other(err.message()))
    if lock_digest == "" -> return Ok()
    references := [String]{}
    loop selection in ready_stats.realized {
        if !references.contains(selection.reference) -> &references.push(selection.reference)
    }
    &references.sort()
    loop reference in references {
        entry :: store_find_by_reference_read_only(roots, reference) ?? next
        producer :: ProducerRecord.decode(entry.producer_record) ?? return Err(CliError.Other("could not decode `{reference}` producer record: {err.message()}"))
        if producer.provider != "nix" && producer.provider != "jetpackage" -> next
        store_refresh_lock_digest(roots, entry, lock_digest) ?? return Err(CliError.Other("could not seal `{reference}` producer record: {err.message()}"))
    }
    // Checked listing completes any closure migration or compaction before
    // the caller records the environment-entry stamp for warm reuse.
    store_list_checked(roots) ?? return Err(CliError.Other("could not finalize sealed closure state: {err.message()}"))
    Ok()
}

// Warm verified realizations by their original reference.
fn cli_index_warm_realizations(warm: [VerifiedRealization]) -> [String: [VerifiedRealization]] Never! {
    indexed := [String: [VerifiedRealization]]{}
    loop realized in warm {
        reference :: realized.original_reference()
        bucket := indexed.get(reference) ?? [VerifiedRealization]{}
        &bucket.push(realized)
        indexed[reference] = bucket
    }
    indexed
}

// Take the last warm realization recorded for `reference`.
fn cli_take_warm_realization(warm: &[String: [VerifiedRealization]], reference: String) -> VerifiedRealization? Never! {
    bucket := warm.get(reference) ?? return None
    realized :: &bucket.pop() ?? return None
    if bucket.len() == 0 {
        _ := &warm.remove(reference)
    } else {
        warm[reference] = bucket
    }
    Val(realized)
}

// A native dev tool: the flake definition name, the command, and the
// repository-relative binary it projects.
pub struct NativeDevTool {
    pub definition: String
    pub command: String
    pub relative_binary: String
}

// The target condition of a native output fact.
pub enum NativeOutputPlatform {
    Any
    Linux

    fn applies(self) -[Env]> Bool Never! {
        if self == {
            .Any -> true
            .Linux -> sys.name() == "linux"
        }
    }
}

// A realized package output selected by the native shell contract: the
// package, the relative output, the variable, and its target condition.
pub struct NativeOutputFact {
    pub package: String
    pub relative: String
    pub variable: String
    pub platform: NativeOutputPlatform
}

@CLI_NATIVE_OUTPUT_FACTS :: [NativeOutputFact]{
    NativeOutputFact{package: "tzdata", relative: "share/zoneinfo", variable: "TZDIR", platform: NativeOutputPlatform.Any},
    NativeOutputFact{package: "vulkan-loader", relative: "lib", variable: "LD_LIBRARY_PATH", platform: NativeOutputPlatform.Linux},
    NativeOutputFact{package: "raylib", relative: "lib", variable: "LD_LIBRARY_PATH", platform: NativeOutputPlatform.Linux}
}

// The two repo-local dev tools are native projections of the cargo-built
// binaries, not realized packages, and get no generated shell wrapper.
@CLI_NATIVE_DEV_TOOLS :: [NativeDevTool]{
    NativeDevTool{definition: "jetDev", command: "jet", relative_binary: "target/debug/jet"},
    NativeDevTool{definition: "jetpackDev", command: "jetpack", relative_binary: "target/debug/jetpack"}
}

pub enum NativeActivation {
    Disabled
}

pub enum NixShellScratch {
    NotCreated
}

// Typed host facts for the Jet-native shell projection. The variable map is
// only the child-process adapter; paths and markers stay typed until then.
pub struct NativeEnvironmentProjection {
    pub project_root: String
    pub native_bin_dirs: [String]
    pub tzdir: String?
    pub loader_paths: [String]
    pub activation: NativeActivation
    pub nix_shell_scratch: NixShellScratch

    fn from_realized(project_root: String, realized: [(name: String, output: String)], inherited_loader_path: String?) -[Env]> NativeEnvironmentProjection Never! {
        native_bin_dirs := [String]{}
        loop tool in cli_native_dev_tool_paths(project_root) {
            directory :: files.dirname(tool.binary)
            if !native_bin_dirs.contains(directory) -> &native_bin_dirs.push(directory)
        }
        tzdir := None
        loader_paths := [String]{}
        loop fact in @CLI_NATIVE_OUTPUT_FACTS {
            path :: cli_native_output_path(realized, fact) ?? next
            if fact.variable == {
                "TZDIR" -> {
                    if tzdir == None -> tzdir = Val(path)
                }
                "LD_LIBRARY_PATH" -> &loader_paths.push(path)
                else -> {}
            }
        }
        if sys.name() == "linux" {
            inherited :: inherited_loader_path ?? ""
            loop path in inherited.split(pkg_path_separator_for_os(sys.name())) {
                if path != "" -> &loader_paths.push(path)
            }
        }
        // Jetpack never creates Nix shell scratch directories; the marker
        // records that the old one-time cleanup boundary is satisfied.
        NativeEnvironmentProjection{project_root, native_bin_dirs, tzdir, loader_paths, activation: NativeActivation.Disabled, nix_shell_scratch: NixShellScratch.NotCreated}
    }

    fn bin_dirs(self) -> [String] Never! {
        self.native_bin_dirs
    }

    fn env_vars(self) -[Env]> [String: String] Never! {
        vars := [String: String]{"JET_ROOT": self.project_root}
        if self.activation == {
            .Disabled -> vars[@ENV_DISABLE_VAR] = "1"
        }
        if self.nix_shell_scratch == {
            .NotCreated -> vars["JET_NIX_TMP_CLEANED"] = "1"
        }
        if self.tzdir == .Val(tzdir) -> vars["TZDIR"] = tzdir
        if sys.name() == "linux" && self.loader_paths.len() > 0 {
            vars["LD_LIBRARY_PATH"] = self.loader_paths.join(pkg_path_separator_for_os(sys.name()))
        }
        vars
    }
}

fn cli_native_output_path(realized: [(name: String, output: String)], fact: NativeOutputFact) -[Env]> String? Never! {
    if !fact.platform.applies() -> return None
    loop pair in realized {
        if pair.name == fact.package -> return Val(files.join(pair.output, fact.relative))
    }
    None
}

fn cli_native_dev_tool_paths(project_root: String) -> [(command: String, binary: String)] Never! {
    tools := [(command: String, binary: String)]{}
    loop tool in @CLI_NATIVE_DEV_TOOLS -> &tools.push((command: tool.command, binary: files.join(project_root, tool.relative_binary)))
    tools
}

// Native projection for the repository dev-shell contract, derived from
// the project root and realized package outputs.
fn cli_native_environment_projection(project_root: String, realized: [(name: String, output: String)], inherited_loader_path: String?) -[Env]> NativeEnvironmentProjection Never! {
    NativeEnvironmentProjection.from_realized(project_root, realized, inherited_loader_path)
}

// Realize every ref in `plan` and compose the shell env. A realization
// failure is reported here and travels as `Reported(code)`.
pub fn cli_compose_env(theme: Theme, roots: HangarRoots, flags: CliFlags, plan: RunPlan) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> ShellEnv CliError! {
    cli_compose_env_scoped(theme, roots, flags, plan, RealizeScope.Project, false)
}

// A user tool installs into the user profile, so it is never reconciled
// against the project the shell happens to stand in.
pub fn cli_compose_env_scoped(theme: Theme, roots: HangarRoots, flags: CliFlags, plan: RunPlan, scope: RealizeScope, confirm_download: Bool) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> ShellEnv CliError! {
    composed :: cli_compose_env_scoped_with_stats(theme, roots, flags, plan, scope, confirm_download)
    Ok(composed.env)
}

pub fn cli_compose_env_scoped_with_stats(theme: Theme, roots: HangarRoots, flags: CliFlags, plan: RunPlan, scope: RealizeScope, confirm_download: Bool) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> (env: ShellEnv, stats: EnvReadyStats) CliError! {
    cli_compose_env_scoped_with_warm(theme, roots, flags, plan, scope, confirm_download, None, true)
}

// Whether the warm realizations cover every ref and adapter of the plan.
fn cli_warm_complete(warm: [String: [VerifiedRealization]]?, plan: RunPlan) -> Bool Never! {
    realized :: warm ?? return false
    required := [String: Int]{}
    loop spec in plan.refs -> required[spec.raw] = (required.get(spec.raw) ?? 0) + 1
    loop adapter in plan.adapters {
        reference :: "adapt:{adapter.name}:{adapter.source}"
        required[reference] = (required.get(reference) ?? 0) + 1
    }
    loop entry in required {
        available :: realized.get(entry.key) ?? return false
        if available.len() < entry.value -> return false
    }
    true
}

// The composer with optional warm realizations from a verified environment
// receipt. Cold or partial project composition still collects selections
// for the receipt and producer sealing.
pub fn cli_compose_env_scoped_with_warm(theme: Theme, roots: HangarRoots, flags: CliFlags, plan: RunPlan, scope: RealizeScope, confirm_download: Bool, warm: [VerifiedRealization]?, collect_stats: Bool) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> (env: ShellEnv, stats: EnvReadyStats) CliError! {
    warm_realizations := if warm == {
        .Val(list) -> Val(cli_index_warm_realizations(list))
        .None -> None
    }
    warm_complete :: cli_warm_complete(warm_realizations, plan)
    project_scope :: scope == RealizeScope.Project
    needs_stats :: collect_stats || (project_scope && !warm_complete)
    lock_diff := if project_scope && !warm_complete -> CliLockDiffGuard.new(theme, plan.project_root) else -> CliLockDiffGuard.inactive(theme)
    defer close(^lock_diff)
    if confirm_download && !warm_complete {
        download_plan :: cli_reject_unprompted_acquisition(theme, roots, flags, plan, scope)
        &lock_diff.set_sizes(cli_sizes_from_plan(download_plan))
    }
    cli_enforce_required_sandbox_policy(theme, flags.json)
    if cli_validate_integration_facts(plan) == {
        .Err(error) -> {
            theme.error_coded("E1335", "environment integration facts are not executable", error.message(), "use the supported integration preset and keep its typed package, host, task, and grant facts intact")
            return Err(CliError.Reported(@EXIT_USAGE))
        }
        .Ok(_) -> {}
    }
    bin_dirs := [String]{}
    if project_scope {
        profile_bin :: cli_dev_shell_projection(plan.project_root, plan.environment) ?? {
            theme.error_coded("E1335", "the active package profile cannot project into the dev shell", err.message(), "build and switch the named package profile, then retry the shell")
            return Err(CliError.Reported(@EXIT_USAGE))
        }
        if profile_bin == .Val(path) -> &bin_dirs.push(path)
    }
    provider_vars := [String: [String]]{}
    provider_var_order := [String]{}
    nix_vars := [String: String]{}
    realized_refs := [String]{}
    realized_outputs := [(name: String, output: String)]{}
    holes := [NixBridgeNeed]{}
    failed := false
    unavailable := false
    cache_leases := [CacheLease]{}
    ready_stats := EnvReadyStats.empty()
    name_w :: if warm_complete -> 0 else -> cli_name_column_width(plan.refs)
    // Multi-package realization gets one pinned aggregate on a TTY and one
    // settled row per package; plain output keeps only the settled rows.
    total_steps :: plan.refs.len() + plan.adapters.len()
    live_mode :: total_steps > 1 && !warm_complete
    live_tty :: live_mode && theme.live_enabled()
    live := theme.live_region()
    completed_steps := 0
    phase_timing :: sys.get("JETPACK_TIMING") != None
    compose_started :: time.start()
    if phase_timing -> term.eprint("TIMING compose-preamble: {time.elapsed(compose_started)}")
    loop spec in plan.refs {
        if live_tty -> &live.set_aggregate_status("Resolving {spec.package}", completed_steps, total_steps)
        style :: if live_mode -> RowStyle.Silent else -> RowStyle.Ready
        warm_hit :: if warm_realizations == {
            .Val(index) -> {
                pool := index
                taken :: cli_take_warm_realization(&pool, spec.raw)
                warm_realizations = Val(pool)
                taken
            }
            .None -> None
        }
        step_outcome :: if warm_hit == {
            .Val(realized) -> {
                parts :: ^realized.into_parts()
                RefOutcome.Realized{entry: parts.entry, state: parts.source_state, line: "", lease: parts.lease}
            }
            .None -> {
                step_started :: time.start()
                slot := if live_tty -> Val(live) else -> None
                outcome :: cli_realize_ref_outcome(theme, roots, flags, plan.table, spec, name_w, style, &slot, scope)
                if slot == .Val(updated) -> live = updated
                if phase_timing -> term.eprint("TIMING step {spec.package}: {time.elapsed(step_started)}")
                outcome
            }
        }
        if step_outcome == {
            .Realized(entry, state, line, lease) -> {
                if live_mode && line != "" -> &live.finish(line)
                completed_steps += 1
                if needs_stats -> &ready_stats.record(entry, state)
                leased_output :: lease.stable_path(entry.out) ?? {
                    &live.clear()
                    theme.error_coded("E1335", "the realized package output could not be confined to its executable lease", err.message(), "re-realize the package so Jetpack can hand only its verified lease to the child")
                    failed = true
                    next
                }
                // A `library` package realizes with an empty `bin` (U10) and
                // contributes nothing to PATH.
                if lease.projected_bin_dir_after_validation() == .Val(bin) -> &bin_dirs.push(bin)
                invalid_metadata := None
                loop meta in @CLI_PROVIDER_METADATA_FILES {
                    raw :: files.read(files.join(leased_output, meta.file)) ?? next
                    value :: raw.trim()
                    if value == "" -> next
                    if cli_resolve_provider_paths(leased_output, meta.file, value) == {
                        .Val(resolved) -> {
                            values := provider_vars.get(meta.variable) ?? [String]{}
                            if values.len() == 0 -> &provider_var_order.push(meta.variable)
                            &values.push(resolved)
                            provider_vars[meta.variable] = values
                        }
                        .None -> if invalid_metadata == None -> invalid_metadata = Val(meta.file)
                    }
                }
                if invalid_metadata == .Val(file) {
                    &live.clear()
                    theme.error("couldn't compose package environment", "`{file}` for `{entry.reference}` contains a relative path outside its verified package output.", "reinstall the package; provider metadata paths must be absolute or contain only normal relative components.")
                    failed = true
                }
                if ProducerRecord.decode(entry.producer_record) == .Ok(producer) {
                    loop runtime in provider_nix_runtime_environment(producer) -> nix_vars[runtime.key] = runtime.value
                }
                &realized_outputs.push((name: entry.name, output: leased_output))
                &realized_refs.push(entry.reference)
                &cache_leases.push(lease)
            }
            .NeedsNix(need) -> &holes.push(need)
            .Unavailable -> unavailable = true
            .Failed -> failed = true
        }
    }
    loop index in 0..<plan.adapters.len() {
        adapter :: plan.adapters[index]
        &live.clear()
        if total_steps > 1 && !warm_complete -> theme.progress_chain("Adapt", plan.refs.len() + index + 1, total_steps, adapter.name, "adapter")
        warm_reference :: "adapt:{adapter.name}:{adapter.source}"
        warm_hit :: if warm_realizations == {
            .Val(pool_index) -> {
                pool := pool_index
                taken :: cli_take_warm_realization(&pool, warm_reference)
                warm_realizations = Val(pool)
                taken
            }
            .None -> None
        }
        adapter_outcome :: if warm_hit == {
            .Val(realized) -> {
                parts :: ^realized.into_parts()
                Val((entry: parts.entry, state: parts.source_state, lease: parts.lease))
            }
            .None -> cli_realize_adapter(theme, roots, flags, adapter, plan.table, true)
        }
        if adapter_outcome == {
            .Val(realized) -> {
                if needs_stats -> &ready_stats.record(realized.entry, realized.state)
                if realized.lease.projected_bin_dir() == .Val(bin) -> &bin_dirs.push(bin)
                &realized_refs.push(realized.entry.reference)
                &cache_leases.push(realized.lease)
            }
            .None -> failed = true
        }
    }
    if holes.len() > 0 {
        &live.clear()
        cli_report_nix_bridge_required(theme, flags, holes, realized_refs)
        return Err(CliError.Reported(@EXIT_USAGE))
    }
    if unavailable -> return Err(CliError.Reported(@EXIT_USAGE))
    if failed -> return Err(CliError.Reported(@EXIT_USER_ERROR))
    missing_language_tools := [String]{}
    loop pack in plan.environment.language_packs {
        loop tool in pack.required_tools {
            command :: pack.commands.get(tool) ?? next
            present := false
            loop dir in bin_dirs {
                if files.is_file(files.join(dir, command)) -> present = true
            }
            if !present -> &missing_language_tools.push("{pack.name}:{tool}")
        }
    }
    if missing_language_tools.len() > 0 {
        &live.clear()
        theme.error_coded("E1333", "a language pack tool is missing from the realized environment", "missing required language tools: {missing_language_tools.join(", ")}", "realize the pack's declared packages again, or remove the language selection until its tools are available")
        return Err(CliError.Reported(@EXIT_USAGE))
    }
    native_projection :: if project_scope -> Val(cli_native_environment_projection(plan.project_root, realized_outputs, sys.get("LD_LIBRARY_PATH"))) else -> None
    if native_projection == .Val(projection) {
        loop dir in projection.bin_dirs() -> &bin_dirs.push(dir)
    }
    composed_vars := [String: String]{}
    loop name in provider_var_order {
        values :: provider_vars.get(name) ?? next
        composed_vars[name] = if name == {
            "LUA_PATH" | "LUA_CPATH" -> "{values.join(";")};;"
            "GEM_HOME" -> values[0]
            else -> values.join(pkg_path_separator_for_os(sys.name()))
        }
    }
    // The Nix compatibility provider contributes the fixed builder facts it
    // recorded at realization; PATH stays composed from verified packages.
    loop entry in nix_vars -> composed_vars[entry.key] = entry.value
    if plan.environment.selected_preset == .Val(preset) {
        theme.detail("preset: {preset.applied.join(" -> ")}")
        loop entry in preset.variables -> composed_vars[entry.key] = entry.value
    }
    loop pack in plan.environment.language_packs {
        loop entry in pack.variables -> composed_vars[entry.key] = entry.value
    }
    loop dotenv in plan.environment.lifecycle.dotenv {
        values :: cli_read_dotenv_snapshot(plan.project_root, dotenv.file, dotenv.allow) ?? {
            &live.clear()
            theme.error("couldn't load dotenv file", "{dotenv.file}: {err.message()}", "fix the dotenv path and keep each assignment in KEY=value form.")
            return Err(CliError.Reported(@EXIT_USAGE))
        }
        loop entry in values -> composed_vars[entry.key] = entry.value
    }
    if plan.environment.lifecycle.git_hooks_path == .Val(relative) {
        loop name in plan.environment.lifecycle.unset {
            if name == "GIT_CONFIG_COUNT" || name == "GIT_CONFIG_KEY_0" || name == "GIT_CONFIG_VALUE_0" {
                &live.clear()
                theme.error_coded("E1333", "the environment Git hook configuration conflicts with `unset`", "Git cannot receive core.hooksPath when its configuration environment is removed", "remove the Git configuration names from `unset`, or remove `git_hooks_path`")
                return Err(CliError.Reported(@EXIT_USAGE))
            }
        }
        hooks :: env_hook_git_hooks_environment(plan.project_root, relative) ?? {
            &live.clear()
            theme.error_coded("E1333", "the environment Git hook path is not usable", err.message(), "create an in-project hook directory and set `git_hooks_path` to its project-relative path")
            return Err(CliError.Reported(@EXIT_USAGE))
        }
        loop entry in hooks -> composed_vars[entry.key] = entry.value
    }
    // The native projection applies last so the Jet-owned root, markers, and
    // generated output paths cannot be shadowed by dotenv or preset values.
    if native_projection == .Val(projection) {
        loop entry in projection.env_vars() -> composed_vars[entry.key] = entry.value
    }
    if project_scope && !warm_complete {
        if cli_seal_project_producer_records(roots, plan.project_root, ready_stats) == {
            .Err(error) -> {
                &live.clear()
                theme.error_coded("E1335", "the project lock could not seal provider records", error.message(), "retry the environment entry so every producer uses the final project lock")
                return Err(CliError.Reported(@EXIT_USER_ERROR))
            }
            .Ok(_) -> {}
        }
    }
    // Warm reuse already carries the exact entries selected under the Hangar
    // lock; cold realizations refresh selections after publication.
    if !warm_complete -> &ready_stats.canonicalize(roots)
    env :: ShellEnv{
        bin_dirs: bin_dirs,
        vars: composed_vars,
        unset_vars: plan.environment.lifecycle.unset,
        refs: realized_refs,
        label: plan.label,
        prompt_path: plan.prompt_path,
        prompt_strip: plan.prompt_strip,
        cache_leases: cache_leases,
    }
    Ok((env: env, stats: ready_stats))
}

// One provider metadata file and the variable it feeds.
pub struct ProviderMetadataFile {
    pub file: String
    pub variable: String
}

@CLI_PROVIDER_METADATA_FILES :: [ProviderMetadataFile]{
    ProviderMetadataFile{file: "lua-path", variable: "LUA_PATH"},
    ProviderMetadataFile{file: "lua-cpath", variable: "LUA_CPATH"},
    ProviderMetadataFile{file: "gem-home", variable: "GEM_HOME"},
    ProviderMetadataFile{file: "gem-path", variable: "GEM_PATH"},
    ProviderMetadataFile{file: "ruby-lib", variable: "RUBYLIB"},
    ProviderMetadataFile{file: "perl5lib", variable: "PERL5LIB"},
    ProviderMetadataFile{file: "composer-autoload", variable: "COMPOSER_AUTOLOAD"}
}

// A piped `jetpack env`/`use` must not start realization without an explicit
// `-y`. Existing Hangar entries pass so fully cached environments stay
// silent; every missing package is refused before acquisition.
fn cli_reject_unprompted_acquisition(theme: Theme, roots: HangarRoots, flags: CliFlags, plan: RunPlan, scope: RealizeScope) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> DownloadPlan CliError! {
    specs := [RefSpec]{}
    loop spec in plan.refs {
        if provider_requires_acquisition(spec, plan.table, flags.offline, roots.hangar_dir()) -> &specs.push(spec)
    }
    label :: if scope == {
        .Project -> if plan.environment.active_environment == {
            .Val(name) -> "env.{name}"
            .None -> "env"
        }
        .Use -> "use"
        .UserProfile -> "tool"
    }
    planning :: specs.len() > 0 || plan.adapters.len() > 0
    planning_live :: planning && theme.live_enabled()
    live := theme.live_region()
    if {
        planning_live -> &live.set_aggregate_status("Planning", 0, specs.len() + plan.adapters.len())
        planning -> theme.status("Resolving {label} package plan...")
        else -> {}
    }
    progress :: if planning_live -> Val(live.progress_handle()) else -> None
    planned :: cli_plan_downloads(theme, roots, flags, plan.table, specs, scope, progress) ?? {
        &live.clear()
        return Err(err)
    }
    &live.clear()
    download := planned
    loop adapter in plan.adapters {
        &download.add_item(PlanItem{package: adapter.name, state: PlanState.New, download_bytes: None, disk_bytes: None})
    }
    if download.items.len() == 0 -> return Ok(download)
    if theme.confirm_download(label, download, flags.explain_plan, flags.assume_yes) -> return Ok(download)
    Err(CliError.Reported(@EXIT_USAGE))
}

// Every integration fact must still be executable: disclosed tasks keep their
// packages, secrets, providers, grants, and host checks.
pub fn cli_validate_integration_facts(plan: RunPlan) CliError! -[Env]> {
    facts :: plan.environment.integration_facts
    if facts.validate() == {
        .Err(error) -> return Err(CliError.InvalidData(error.message))
        .Ok(_) -> {}
    }
    os :: if sys.name() == "macos" -> "darwin" else -> sys.name()
    target :: sys.get("JET_TARGET") ?? "{sys.arch()}-{os}"
    loop fact in facts.task_facts {
        if !facts.tasks.contains(fact.name) -> return Err(CliError.InvalidData("integration task `{fact.name}` is not disclosed by its fact projection"))
        loop package in fact.packages {
            kept := false
            loop reference in plan.refs {
                if reference.raw == package || reference.short_name() == package -> kept = true
            }
            if !kept -> return Err(CliError.InvalidData("integration task `{fact.name}` lost package `{package}` before realization"))
        }
        loop secret in fact.secrets -> cli_validate_task_secret_allowlist(fact.name, secret, plan.secrets)
        expected_provider :: if fact.integration == {
            .Android | .Apple | .Editor -> "nixpkgs"
            .Certificates | .Vault -> "vault"
            .CloudCredentials -> "credential-store"
            .Hosts -> "host-binding"
            .CodexAgent -> "mcp"
        }
        if !fact.providers.contains(expected_provider) -> return Err(CliError.InvalidData("integration task `{fact.name}` has no executable `{expected_provider}` provider"))
        loop provider in fact.providers {
            if provider == {
                "nixpkgs" | "vault" | "credential-store" | "host-binding" | "mcp" -> {}
                else -> return Err(CliError.InvalidData("integration task `{fact.name}` names an unsupported provider"))
            }
        }
        loop provider in fact.providers {
            if !facts.providers.contains(provider) -> return Err(CliError.InvalidData("integration task `{fact.name}` lost provider `{provider}` before realization"))
        }
        loop grant in fact.grants {
            if !facts.grants.contains(grant) -> return Err(CliError.InvalidData("integration task `{fact.name}` lost grant `{grant}` before realization"))
        }
        loop check in fact.host_checks {
            if cli_validate_integration_host_check(check, target) == {
                .Err(error) -> return Err(CliError.InvalidData("{fact.integration.as_str()} integration `{fact.name}` failed: {error.message()}"))
                .Ok(_) -> {}
            }
        }
    }
    loop provider in facts.providers {
        if provider.trim() == "" -> return Err(CliError.InvalidData("integration provider authority cannot be empty"))
    }
    loop check in facts.host_checks {
        if check.trim() == "" -> return Err(CliError.InvalidData("integration host checks cannot be empty"))
    }
    Ok()
}

fn cli_validate_task_secret_allowlist(task_name: String, secret: String, declared: [SecretSpec]) CliError! {
    loop spec in declared {
        if spec.name == secret -> return Ok()
    }
    Err(CliError.InvalidData("integration task `{task_name}` lost secret `{secret}` before activation"))
}

fn cli_validate_integration_host_check(check: String, target: String) CliError! {
    if !check.starts_with("target:") -> return Ok()
    expected :: check.removeprefix("target:")
    lowered :: target.to_lower()
    loop candidate in expected.split("-or-") {
        if lowered.contains(candidate.to_lower()) -> return Ok()
    }
    Err(CliError.InvalidData("integration host check `{check}` failed for target `{lowered}`"))
}

// A checked dotenv snapshot, narrowed to `allow` when it names keys.
fn cli_read_dotenv_snapshot(root: String, relative: String, allow: [String]) -[FS]> [String: String] CliError! {
    bytes :: envmodel_checked_dotenv_snapshot(root, relative) ?? return Err(CliError.InvalidData(err.message))
    values :: cli_read_dotenv(bytes)
    if allow.len() == 0 -> return Ok(values)
    kept := [String: String]{}
    loop entry in values {
        if allow.contains(entry.key) -> kept[entry.key] = entry.value
    }
    Ok(kept)
}

// `KEY=value` lines; `#` comments and blank lines are skipped, a matched
// pair of surrounding quotes is removed.
fn cli_read_dotenv(bytes: [U8]) -> [String: String] CliError! {
    text :: String.from_bytes(bytes) ?? return Err(CliError.InvalidData("invalid utf-8 sequence"))
    values := [String: String]{}
    lines :: text.split("\n").to_list()
    loop index in 0..<lines.len() {
        // Rust `str::lines` drops a trailing `\r`; `trim` removes it too.
        line :: lines[index].trim()
        if line == "" || line.starts_with("#") -> next
        pair :: line.split_once("=") ?? return Err(CliError.InvalidData("line {index + 1} has no '='"))
        name :: pair.before.trim()
        if !cli_dotenv_valid_name(name) -> return Err(CliError.InvalidData("line {index + 1} has an invalid variable name"))
        value := pair.after.trim()
        if value.len() >= 2 && ((value.starts_with("\"") && value.ends_with("\"")) || (value.starts_with("'") && value.ends_with("'"))) {
            value = String.from_bytes(value.bytes()[1..<(value.len() - 1)]) ?? value
        }
        values[name] = value
    }
    Ok(values)
}

// `[A-Za-z_][A-Za-z0-9_]*`.
fn cli_dotenv_valid_name(name: String) -> Bool Never! {
    raw :: name.bytes()
    if raw.len() == 0 -> return false
    loop index in 0..<raw.len() {
        code :: Int.from_u8(raw[index])
        letter :: (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
        digit :: code >= 48 && code <= 57
        if !(letter || (index > 0 && digit)) -> return false
    }
    true
}

// Relative provider metadata paths resolve inside the realized output;
// absolute legacy paths stay as written, and a parent escape is refused.
pub fn cli_resolve_provider_paths(entry_out: String, file: String, value: String) -[Env]> String? Never! {
    if !cli_is_provider_metadata_file(file) -> return Val(value)
    separator :: if file == "lua-path" || file == "lua-cpath" -> ";" else -> pkg_path_separator_for_os(sys.name())
    resolved := [String]{}
    loop path in value.split(separator) {
        if files.is_absolute(path) {
            &resolved.push(path)
            next
        }
        parts :: path.split("/").to_list()
        components := 0
        loop part in parts {
            if part == ".." -> return None
            if part != "" -> components += 1
        }
        if components == 0 -> return None
        joined :: if entry_out.ends_with("/") -> "{entry_out}{path}" else -> "{entry_out}/{path}"
        &resolved.push(joined)
    }
    Val(resolved.join(separator))
}

fn cli_is_provider_metadata_file(file: String) -> Bool Never! {
    loop meta in @CLI_PROVIDER_METADATA_FILES {
        if meta.file == file -> return true
    }
    false
}

// The ledger's name-column width (at least 8, so one short name does not
// collapse the table).
fn cli_name_column_width(refs: [RefSpec]) -> Int Never! {
    width := 8
    loop spec in refs {
        if spec.package.len() > width -> width = spec.package.len()
    }
    width
}

// The `config sandbox require` policy refuses composition when no native
// sandbox is available.
fn cli_enforce_required_sandbox_policy(theme: Theme, json_output: Bool) CliError! -[IO, FS, Env, Exec, Time.Wait]> {
    if env_read_sandbox_policy() != SandboxPolicy.Require -> return Ok()
    if env_enforce_sandbox_policy(theme, json_output) == .Val(code) -> return Err(CliError.Reported(code))
    Ok()
}
