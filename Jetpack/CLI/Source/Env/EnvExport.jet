// The opt-in prompt hook (D-ENVHOOK1=A), ported from
// jetpack::CLI::run_enter_dev. `jet env hook <shell>` prints the hook the
// user installs once; `jet env export <shell>` is its private per-prompt
// callback. Realize, trust, and compose reuse the exact `jet env` path, so
// there is one environment engine (I8). Human output (ledger rows, the trust
// prompt) goes to stderr through `Theme`; stdout carries only shell code for
// the hook to `eval`.

// Rust `print!`: stdout bytes with no added newline.
fn cli_print_raw(text: String) Never! -[IO]> {
    term.stdout().write(text).drop("a closed stdout cannot take the shell script")
}

// `jet env hook <shell>` — pure text: installing the hook is a safe editor
// action; the trust gate fires later, on the first activation.
fn cli_cmd_env_hook(theme: Theme, parsed: CliParsed) -[IO, Env]> Int Never! {
    shell :: if parsed.positional.len() > 1 -> Val(parsed.positional[1]) else -> String?{None}
    kind :: ShellKind.parse(shell) ?? {
        theme.error(
            "unknown shell for `jet env hook`",
            "the auto-activation hook is available for: {@ENV_HOOK_SHELLS.join(", ")}.",
            "try `jet env hook bash`, `jet env hook zsh`, or `jet env hook fish`."
        )
        return @EXIT_USAGE
    }
    cli_print_raw(env_hook_render_hook(kind))
    @EXIT_OK
}

// `jet env export <shell>` — the statements that load the nearest `env.jet`
// into the current shell, or unload it once the shell leaves that tree.
fn cli_cmd_env_export(theme: Theme, parsed: CliParsed) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    shell :: if parsed.positional.len() > 1 -> Val(parsed.positional[1]) else -> String?{None}
    // An unknown shell from an installed hook is not worth a diagnostic on
    // every prompt: emit nothing and let the shell keep its environment.
    kind :: ShellKind.parse(shell) ?? return @EXIT_OK
    disabled :: (sys.get(@ENV_DISABLE_VAR) ?? "") != ""
    target :: if disabled -> String?{None} else -> env_hook_find_env_root(cli_current_dir())
    active :: cli_nonempty_env(@ENV_HOOK_ACTIVE_DIR_VAR)
    active_hash :: cli_nonempty_env(@ENV_HOOK_ACTIVE_HASH_VAR)
    target_hash := String?{None}
    if target == .Val(root) -> target_hash = env_hook_definition_fingerprint_with_selections(root, parsed.flags.preset, parsed.flags.environment)
    // Nothing changed since the last prompt: stay silent, so the hook is a
    // no-op on most prompts and never re-realizes.
    if target == active && target_hash == active_hash -> return @EXIT_OK
    // A changed definition does not always reload now. `Never` keeps the
    // current activation; `Watch` records the first changed hash and
    // coalesces prompt callbacks until its debounce window expires.
    watched_reload_ready := false
    if target == active && target_hash != active_hash {
        if target == .Val(root) && target_hash == .Val(hash) {
            if env_hook_reload_policy_with_environment(root, parsed.flags.environment) == {
                .Never -> return @EXIT_OK
                .Prompt -> {}
                .Watch(_, debounce_ms) -> {
                    if env_hook_watch_reload_ready(root, hash, debounce_ms) == {
                        .Ok(ready) -> {
                            if !ready -> return @EXIT_OK
                            watched_reload_ready = true
                        }
                        .Err(error) -> {
                            theme.detail("environment reload is waiting: {error.message()}")
                            return @EXIT_OK
                        }
                    }
                }
            }
        }
    }
    // The PATH to restore on unload, or to build on when activating: the
    // saved pre-env PATH while an env is live, else the live PATH.
    live_path :: sys.get("PATH") ?? ""
    base_path :: if active != None -> cli_nonempty_env(@ENV_HOOK_OLD_PATH_VAR) ?? live_path else -> live_path
    // No unload is emitted until the replacement environment is fully
    // realized, trusted, composed, and entered: a failed reload leaves the
    // previous activation usable.
    script := ""
    if target == .Val(root) {
        script = cli_env_export_activate(theme, parsed, kind, root, target_hash, active != None, base_path, watched_reload_ready) ?? return err.code
    } else if active != None {
        script = env_hook_render_unload(kind, base_path)
    }
    cli_print_raw(script)
    @EXIT_OK
}

fn cli_nonempty_env(name: String) -[Env]> String? Never! {
    value :: sys.get(name) ?? return None
    if value == "" -> return None
    Val(value)
}

// The failure carrier of an activation attempt: the exit code the prompt
// callback returns, after keeping the previous activation.
#Error
struct EnvExportStop {
    pub code: Int
}

// Realize, trust, compose, and render the activation of `root`. Every
// refusal before the script is final returns exit 0 so the previous
// activation stays live; a rejected activation render exits 2.
fn cli_env_export_activate(theme: Theme, parsed: CliParsed, kind: ShellKind, root: String, target_hash: String?, active: Bool, base_path: String, watched_reload_ready: Bool) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> String EnvExportStop! {
    keep :: EnvExportStop{code: @EXIT_OK}
    // Realize with `root` as cwd so the cwd-relative plan and realize path
    // composes it exactly like `jet env` would from inside it. This process
    // exits right after, so changing its cwd affects nothing else.
    sys.set_current_dir(root) ?? return Err(keep)
    roots :: pkg_resolve_roots()
    // A malformed or foreign-only env keeps the previous activation.
    plan := cli_load_project_plan_with_selections(theme, parsed.flags.preset, parsed.flags.environment) ?? return Err(keep)
    cli_apply_locked_channels(theme, root, &plan.table, parsed.flags) ?? return Err(keep)
    // D-JPK-GRANTCMD1 trust law: the first activation of an untrusted,
    // trust-sensitive env prompts (interactive) or is refused with a hint
    // (non-interactive). A trusted or non-sensitive env activates silently.
    store :: trust_store_path()
    hash :: trust_environment_definition_hash(plan.refs, plan.table, plan.secrets, plan.environment)
    sensitive :: trust_is_typed_environment(plan.environment) || trust_is_trust_sensitive_ext(plan.refs, plan.secrets.len() > 0)
    trusted :: !sensitive || trust_is_environment_trusted(store, root, hash, plan.refs, plan.secrets, plan.environment)
    if !trusted {
        if term.stdin().is_terminal() || parsed.flags.trust {
            if trust_gate_with_environment(theme, store, root, plan.refs, plan.table, plan.secrets, plan.environment, parsed.flags.trust) != None -> return Err(keep)
        } else {
            theme.detail("{@ENV_FILE} here is not trusted — run `jet env` to approve it once")
            return Err(keep)
        }
    }
    secret_identity :: trust_secrets_validation_identity(root, plan.secrets, plan.environment.active_environment) ?? None
    previous_receipt :: cli_read_env_entry_receipt(root)
    reuse_verified_store :: cli_receipt_secret_matches(previous_receipt, secret_identity)
    cli_validate_declared_secrets_with_reuse(theme, root, plan.secrets, plan.environment.active_environment, reuse_verified_store) ?? return Err(keep)
    fingerprints :: cli_environment_entry_definition_fingerprint_with_hook(parsed.flags.preset, parsed.flags.environment, plan, secret_identity, target_hash)
    receipt_matches_plan :: if previous_receipt == {
        .Val(receipt) -> cli_env_entry_matches_plan(receipt, plan)
        .None -> false
    }
    inherited_loader_path :: sys.get("LD_LIBRARY_PATH")
    local_catalog :: parsed.flags.local_nix_catalog != None
    warm := [VerifiedRealization]?{None}
    if receipt_matches_plan {
        receipt :: previous_receipt ?? panic("a matching receipt exists")
        warm = store_reuse_verified_environment(roots, receipt.stamp, root, fingerprints.definition, inherited_loader_path, receipt.packages, local_catalog) ?? None
        if warm == None {
            expectations :: cli_environment_member_expectations(roots, root, parsed.flags, plan)
            warm = store_reuse_verified_environment_members(roots, receipt.packages, expectations, local_catalog) ?? None
        }
    }
    warm_reused :: cli_warm_realizations_complete(plan, warm)
    // A missing receipt still uses the canonical Store authority check and
    // retains its checked entries and leases for composition.
    if !warm_reused {
        cli_replay_locked_nix(theme, roots, root, plan.refs, plan.table, parsed.flags.offline, local_catalog, &warm) ?? {
            theme.detail("locked Nix replay was unavailable: {err.message()}")
            return Err(keep)
        }
    }
    composed :: cli_compose_env_scoped_with_warm(theme, roots, parsed.flags, plan, RealizeScope.Project, false, warm, !warm_reused) ?? return Err(keep)
    env :: composed.env
    // Reconcile the source graph after realization. If a prompt races an
    // edit, keep the prior activation and let the next prompt retry the new
    // hash instead of emitting a plan assembled from mixed revisions.
    if env_hook_definition_fingerprint_with_selections(root, parsed.flags.preset, parsed.flags.environment) != target_hash -> return Err(keep)
    plan_hash :: target_hash ?? ""
    entry :: cli_find_project_entry(root)
    cli_run_lifecycle_hooks_silent(theme, parsed, roots, root, entry, env, plan.environment.lifecycle.on_enter, "on_enter") ?? return Err(keep)
    if env_hook_definition_fingerprint_with_selections(root, parsed.flags.preset, parsed.flags.environment) != target_hash -> return Err(keep)
    script := ""
    if active -> script = env_hook_render_unload(kind, base_path)
    composed_path :: env.composed_path_for_parent(base_path) ?? {
        theme.detail("environment activation was not published because a package lease has no durable parent-shell path")
        return Err(keep)
    }
    activation :: EnvHookActivation{
        base_path: base_path,
        composed_path: composed_path,
        refs: env.refs.join(" "),
        root: root,
        vars: env.vars,
        unset: env.unset_vars,
        plan_hash: plan_hash,
    }
    rendered :: activation.render_activate(kind) ?? {
        theme.detail("environment activation was rejected: {err.message()}")
        return Err(EnvExportStop{code: @EXIT_USAGE})
    }
    script = "{script}{rendered}"
    if !warm_reused {
        if cli_record_env_entry_receipt(theme, root, roots, fingerprints.definition, inherited_loader_path, secret_identity ?? "", composed.stats) == .Err(error) {
            theme.detail("couldn't record env entry: {error.message()}")
        }
    }
    if watched_reload_ready -> env_hook_clear_watch_reload(root)
    Ok(script)
}
