// Rust: crates/jetpack/src/CLI/run_enter_dev.rs:4113
// GATE #4494: canonical native process, filesystem and service readiness hosts.
pub fn cmd_dev(verification: &StoreVerification, cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    roots :: pkg_resolve_roots()
    if roots.dev_mode -> theme.detail(theme.gray("user-owned hangar: using {roots.root}"))
    project_dir :: cli_project_env_root(&cache, cli_current_dir())
    entry :: cli_find_project_entry(project_dir)
    if !cli_has_dev_or_run_entry(entry) {
        theme.error_coded(
            "E1254",
            "this project has no `jet dev` entry",
            "`jet dev` runs the entry file's top-level `fn dev()` if it defines one, else `fn run()` (U19); `{entry}` defines neither",
            "add `fn dev() {{ … }}` (a custom dev command) or `fn run() {{ … }}` (the default) to the entry file."
        )
        return EXIT_USAGE
    }
    plan := cli_load_project_plan_with_selections(&cache, theme, parsed.flags.preset, parsed.flags.environment) ?? return cli_exit_for(theme, err)
    cli_apply_locked_channels(theme, project_dir, &plan.table, parsed.flags) ?? return cli_exit_for(theme, err)
    if trust_gate_with_environment(theme, trust_store_path(), project_dir, plan.refs, plan.table, plan.secrets, plan.environment, parsed.flags.trust) == .Val(code) -> return code
    cli_validate_declared_secrets(theme, project_dir, plan.secrets, plan.environment.active_environment) ?? return cli_exit_for(theme, err)
    env :: cli_compose_env(&verification, theme, roots, parsed.flags, plan) ?? return cli_exit_for(theme, err)
    cli_run_lifecycle_hooks(&verification, &cache, theme, parsed, roots, project_dir, entry, env, plan.environment.lifecycle.on_enter, "on_enter") ?? return cli_exit_for(theme, err)
    cli_wait_for_services_ready(&verification, &cache, theme, parsed, roots, project_dir, entry, env, plan.dev_services) ?? return cli_exit_for(theme, err)
    theme.status("running {theme.bold(entry)}")
    command := [String]{cli_find_jet_binary(), DEV_SUBCOMMAND, entry}
    &command.extend(parsed.positional)
    &env.run_command(command)
}

