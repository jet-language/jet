// Rust: crates/jetpack/src/CLI/tool.rs:2561
// Rust: crates/jetpack/src/CLI/tool.rs:2587
// Replace Tools/BinProjection.jet:196 cli_finalize_profile_pointer:
// Windows requires MoveFileExW replacement plus write-through, not a generic rename.
fn finalize_profile_pointer(partial: OSPath, destination: OSPath) -> () Error! {
    if selected_family() == "windows" {
        // Rust: crates/jetpack/src/CLI/tool.rs:2563
        MOVEFILE_REPLACE_EXISTING: U32 :: 0x0000_0001
        // Rust: crates/jetpack/src/CLI/tool.rs:2564
        MOVEFILE_WRITE_THROUGH: U32 :: 0x0000_0008
        // Rust: crates/jetpack/src/CLI/tool.rs:2567
        // GATE #4494: canonical native wide path conversion and kernel32 binding.
        existing :: wide_for_win32(partial)?
        replacement :: wide_for_win32(destination)?
        moved :: #Unsafe("both NUL-terminated wide path owners stay live through MoveFileExW") {
            MoveFileExW(wide_ptr(existing, 0), wide_ptr(replacement, 0), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)
        }
        if moved == 0 { return .Err(Error.last_os_error()) }
        .Ok(())
    } else {
        fs.rename(partial, destination)
    }
}

