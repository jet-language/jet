// Rust: crates/jetpack/src/CLI/tool.rs:2829
// Replace Profile/GenerationMetadata.jet:247 cli_path_is_normalized_absolute
// text splitting: use native OSPath components (backslash is normal on Unix).
fn validate_store_root(value: String) -> () Err! {
    path :: OSPath.from(value)
    if !path.is_absolute() || path.components().any(component -> if component == {
        .ParentDir | .CurDir -> true
        _ -> false
    }) {
        return .Err("profile Store authority is not an absolute normalized path")
    }
    .Ok(())
}

