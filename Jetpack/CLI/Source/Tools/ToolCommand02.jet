// install_profile_projection -> Tools/BinProjection.jet:124 cli_install_profile_projection.
// Refuses nonregular destination/staging, hard-links then copies only on
// non-PermissionDenied failure, finalizes staged pointer. Use replacement below.

// Rust: crates/jetpack/src/CLI/tool.rs:2456
// Replace Tools/BinProjection.jet:148 cli_make_profile_projection_read_only:
// non-Unix uses native readonly permissions, never Unix mode-bit arithmetic.
fn make_profile_projection_read_only(path: OSPath) -> () Error! {
    // GATE #4494, #4483: real selected-platform permissions.
    if selected_family() == "unix" {
        mode :: fs.metadata(path)?.permissions().mode() & 0o777
        fs.set_permissions(path, fs.Permissions.from_mode(mode & !0o222))?
    } else {
        permissions := fs.metadata(path)?.permissions()
        &permissions.set_readonly(true)
        fs.set_permissions(path, permissions)?
    }
    .Ok(())
}
