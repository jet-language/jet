// Rust: crates/jetpack/src/CLI/tool.rs:1902
// Replace Tools/ToolProfile.jet:235 cli_tool_next_generation at integration:
// Rust accepts the entire U64 range and obtains entry type without following links.
fn next_generation() -> U64 Error! {
    directory :: OSPath.from(cli_tool_generations_dir())
    fs.create_dir_all(directory)?
    maximum: U64 := 0
    loop entry in fs.read_dir(directory)? {
        entry :: entry?
        name :: entry.file_name().into_string().map_err(_ -> Error.other("tool generation name is not UTF-8"))?
        generation :: name.parse<U64>().map_err(_ -> Error.other("invalid tool generation `{name}`"))?
        if generation == 0 || !entry.file_type()?.is_dir() {
            return .Err(Error.other("invalid tool generation `{name}`"))
        }
        maximum = maximum.max(generation)
    }
    maximum.checked_add(1).ok_or_else(() -> Error.other("tool generation number overflow"))
}

