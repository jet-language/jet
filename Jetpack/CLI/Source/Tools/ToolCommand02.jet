// Rust: crates/jetpack/src/CLI/tool.rs:2786
// Replace signed-return Profile/GenerationMetadata.jet:339 cli_json_integer_field
// for this Rust U64 helper without losing exact numeric/error precedence.
fn json_field_u64(object: &[(String, DataTree)], key: String) -> U64 Err! {
    value :: object.iter().find_map((name, value) -> if name == key -> Val(value) else -> None)
    if value == {
        .Val(.Int(value)) -> {
            if value >= 0 -> .Ok(U64{value})
                else -> .Err("profile field `{key}` is not an exact integer")
        }
        .Val(.Float(value)) -> {
            if value.is_finite() && value >= 0.0 && value.fract() == 0.0 && value <= 9007199254740991.0 ->
                .Ok(U64{value})
                else -> .Err("profile field `{key}` is not an exact integer")
        }
        .Val(_) -> .Err("profile field `{key}` is not an exact integer")
        .None -> .Err("profile field `{key}` is not a number")
    }
}
