// Rust: crates/jetpack/src/CLI/tool.rs:2387
// Replace BinProjection.cli_managed_tool_write_error's error conversion:
// the original IO PermissionDenied kind is retained with the contextual message.
fn managed_tool_write_error(bin: String, path: OSPath, error: Error) -> Error {
    if error.kind() == ErrorKind.PermissionDenied ->
        Error.new(ErrorKind.PermissionDenied, "managed tool `{bin}` cannot write `{path.display()}`: {error}")
        else -> ^error
}
