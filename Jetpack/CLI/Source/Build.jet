use std.[env, fs]
use std.path.[Component]
use core.sys.target.[selected_family]
use core.text.runtime.kernel_escape_debug.[debug_str_into]

// Rust: crates/jetpack/build.rs:5
// GATE #4494: native build environment, no-follow metadata and file IO.
fn main() -> {
    manifest_dir :: OSPath.from(env.var_os("CARGO_MANIFEST_DIR") ?? panic("CARGO_MANIFEST_DIR"))
    batteries_dir :: manifest_dir.join("batteries")
    println("cargo:rerun-if-changed={batteries_dir.display()}")
    packages := [(slug: String, files: [(relative: String, bytes: [U8], mode: U32)])]{}
    if batteries_dir.is_dir() {
        iterator :: fs.read_dir(batteries_dir) ?? error -> panic("cannot read {batteries_dir.display()}: {error}")
        entries := iterator.collect() ?? error -> panic("cannot inspect {batteries_dir.display()}: {error}")
        &entries.sort_by_key(entry -> entry.file_name())
        loop entry in entries {
            path :: entry.path()
            metadata :: fs.symlink_metadata(path) ?? error -> panic("cannot inspect {path.display()}: {error}")
            if metadata.file_type().is_symlink() -> panic("battery registry cannot include symlink {path.display()}")
            if !metadata.is_dir() -> panic("battery registry entry is not a directory: {path.display()}")
            slug :: entry.file_name().into_string() ?? panic("battery directory name is not UTF-8: {path.display()}")
            if slug.is_empty() || slug == "." || slug == ".." || !is_safe_component(slug) -> panic("battery directory name is unsafe: {rust_string(slug)}")
            println("cargo:rerun-if-changed={path.display()}")
            files :: collect_files(path, path)
            if !files.iter().any(file -> file.relative == "package.jet") -> panic("battery {slug} is missing package.jet")
            canonical :: "{slug}.jet"
            if !files.iter().any(file -> file.relative == canonical) -> panic("battery {slug} is missing canonical {canonical}")
            &packages.push((slug: slug, files: files))
        }
    }
    out_dir :: OSPath.from(env.var_os("OUT_DIR") ?? panic("OUT_DIR"))
    generated :: out_dir.join("batteries_registry.rs")
    source := "pub(crate) static PACKAGES: &[EmbeddedPackage] = &[\n"
    loop package in packages {
        &source.push_str("    EmbeddedPackage {{ slug: ")
        &source.push_str(rust_string(package.slug))
        &source.push_str(", files: &[\n")
        loop file in package.files {
            &source.push_str("        EmbeddedFile {{ path: ")
            &source.push_str(rust_string(file.relative))
            &source.push_str(", mode: ")
            &source.push_str("0o{file.mode:o}")
            &source.push_str(", bytes: include_bytes!(concat!(env!(\"CARGO_MANIFEST_DIR\"), ")
            &source.push_str(rust_string("/batteries/{package.slug}/{file.relative}"))
            &source.push_str(")), }},\n")
        }
        &source.push_str("    ] }},\n")
    }
    &source.push_str("];\n")
    fs.write(generated, source) ?? error -> panic("cannot write {generated.display()}: {error}")
}

// Rust: crates/jetpack/build.rs:70
fn collect_files(root: OSPath, current: OSPath) -> [(relative: String, bytes: [U8], mode: U32)] {
    iterator :: fs.read_dir(current) ?? error -> panic("cannot read {current.display()}: {error}")
    entries := iterator.collect() ?? error -> panic("cannot inspect {current.display()}: {error}")
    &entries.sort_by_key(entry -> entry.file_name())
    files := [(relative: String, bytes: [U8], mode: U32)]{}
    loop entry in entries {
        path :: entry.path()
        metadata :: fs.symlink_metadata(path) ?? error -> panic("cannot inspect {path.display()}: {error}")
        if metadata.file_type().is_symlink() -> panic("battery registry cannot include symlink {path.display()}")
        if metadata.is_dir() {
            &files.extend(collect_files(root, path))
            continue
        }
        if !metadata.is_file() -> panic("battery registry cannot include non-file {path.display()}")
        below :: path.strip_prefix(root) ?? panic("collected path must be below package root")
        components := [String]{}
        loop component in below.components() {
            if component == {
                .Normal(name) -> &components.push(name.to_str() ?? panic("battery path is not UTF-8: {path.display()}"))
                _ -> panic("battery path is not a normal relative path: {path.display()}")
            }
        }
        relative :: components.join("/")
        println("cargo:rerun-if-changed={path.display()}")
        // GATE #4483: selected-target family, not build-host assumptions.
        mode: U32 :: if selected_family() == .Unix -> metadata.permissions().mode() & 0o7777 else -> 0o644
        bytes :: fs.read(path) ?? error -> panic("cannot read {path.display()}: {error}")
        &files.push((relative: relative, bytes: bytes, mode: mode))
    }
    &files.sort_by((left, right) -> left.relative.cmp(right.relative))
    files
}

// Rust: crates/jetpack/build.rs:119
fn is_safe_component(value: String) -> Bool {
    !value.chars().any(character -> character.is_control()) && !value.contains("/") && !value.contains("\\")
}

// Rust: crates/jetpack/build.rs:124
fn rust_string(value: String) -> String {
    // GATE #4500: canonical Rust Debug escaping for generated registry text.
    bytes := [U8]{}
    debug_str_into(&bytes, value)
    String.from_utf8(bytes) ?? panic("debug string must be UTF-8")
}

