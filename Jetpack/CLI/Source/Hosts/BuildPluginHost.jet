// The hidden, bounded build-plugin host (Rust jetpack-bin
// `run_build_plugin_host` plus Prelude/BuildPlugin.rs). Request bytes arrive
// on stdin; one `list<u8>` guest response goes to stdout. The caller
// validates the graph response and performs the transaction in the compiler
// process.
//
// The guest is a runtime-path WebAssembly component that must load against
// its verified digest and run with no host imports under fuel, memory,
// table, and wall-clock limits. Core's plugin loader only binds a literal,
// registered artifact, with no digest pin and no resource limits, so the
// host fails closed after the package and request checks: no guest code
// runs.

BUILD_PLUGIN_HOST_UNSUPPORTED :: "build plugins are not available: this jetpack cannot load a runtime WebAssembly component against a pinned digest under fuel, memory, table, and time limits"

fn cli_run_build_plugin_host(args: [String]) -[IO, FS]> Int Never! {
    if args.len() != 4 {
        term.eprint("build-plugin host requires manifest, component, and expected digests")
        return EXIT_USAGE
    }
    manifest_path :: args[0]
    component_path :: args[1]
    expected_manifest_digest :: args[2]
    expected_component_digest :: args[3]
    manifest :: cli_read_packaged_file_bounded(manifest_path, "manifest", BUILD_PLUGIN_MAX_MANIFEST_BYTES) ?? {
        term.eprint("couldn't read build-plugin manifest: {err.message}")
        return EXIT_USAGE
    }
    component :: cli_read_packaged_file_bounded(component_path, "component", BUILD_PLUGIN_MAX_COMPONENT_BYTES) ?? {
        term.eprint("couldn't read build-plugin component: {err.message}")
        return EXIT_USAGE
    }
    if ContentDigest.from_bytes(manifest).as_str() != expected_manifest_digest {
        term.eprint("build-plugin manifest changed after verification")
        return EXIT_USAGE
    }
    spec :: WasmComponentPluginSpec.load_packaged_bytes(manifest, component) ?? {
        term.eprint("couldn't verify build-plugin package: {err.message}")
        return EXIT_USAGE
    }
    if spec.component_digest.as_str() != expected_component_digest {
        term.eprint("build-plugin component changed after verification")
        return EXIT_USAGE
    }
    request :: term.take(BUILD_PLUGIN_MAX_REQUEST_BYTES + 1) ?? {
        term.eprint("couldn't read build-plugin request: {err}")
        return EXIT_USAGE
    }
    if request.len() > BUILD_PLUGIN_MAX_REQUEST_BYTES {
        term.eprint("build-plugin request exceeds {BUILD_PLUGIN_MAX_REQUEST_BYTES} bytes")
        return EXIT_USAGE
    }
    term.eprint(BUILD_PLUGIN_HOST_UNSUPPORTED)
    EXIT_USER_ERROR
}
