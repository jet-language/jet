// The hidden, bounded compiler-extension host (Rust jetpack-bin
// `run_compiler_extension_host` plus Prelude/CompilerExtension.rs,
// D-DX5-HOOK1=A). Snapshot bytes arrive on stdin; one validated response
// goes to stdout. Every failure is plain Jet-owned stderr plus a nonzero
// status. The component is loaded against the declared `analyze` interface
// with no host imports (D-CORE-PLUGINPATH1) and the v1 resource limits
// (D-CORE-PLUGINLIMITS1); the shared PackageModel orchestration owns the
// session, staging, validation, and close.

// World `compiler-extension-v1`: one pure `analyze(snapshot) -> list<u8>`.
pub trait CompilerExtensionGuest {
    fn analyze(self, snapshot: [U8]) -> [U8]
}

@COMPILER_EXTENSION_WORLD :: "compiler-extension-v1"

// The v1 limits as the Core plugin budget: fuel is refilled and the timer
// restarts before each call; memory and tables cap the component's life.
fn cli_compiler_extension_limits(limits: ExtensionResourceLimits) -> plugin.Limits Never! {
    plugin.Limits{fuel: limits.max_fuel, memory_bytes: limits.max_memory_bytes, table_elements: limits.max_table_elements, timeout: time.duration_ms(limits.timeout_ms)}
}

// The one loaded guest behind the orchestration's handle protocol.
pub struct CompilerExtensionSlot {
    pub guest: Plugin<CompilerExtensionGuest>?
}

pub fn cli_run_compiler_extension_host(args: [String]) -[IO, FS, Env, Exec, Time, Time.Wait]> Int Never! {
    if args.len() != 1 {
        term.eprint("compiler-extension host requires exactly one component path")
        return @EXIT_USAGE
    }
    wasm_path :: args[0]
    request :: term.take(@EXTENSION_MAX_SNAPSHOT_BYTES + 1) ?? {
        term.eprint("couldn't read compiler-extension snapshot: {err}")
        return @EXIT_USAGE
    }
    if request.len() > @EXTENSION_MAX_SNAPSHOT_BYTES {
        term.eprint("compiler-extension snapshot exceeds IPC limit ({@EXTENSION_MAX_SNAPSHOT_BYTES} bytes)")
        return @EXIT_USAGE
    }
    snapshot :: TypedSnapshot.decode(request) ?? {
        term.eprint(err.message)
        return @EXIT_USAGE
    }
    limits :: cli_compiler_extension_limits(ExtensionResourceLimits.v1_defaults())
    slot :: shared CompilerExtensionSlot{guest: None}
    load_guest :: (path: String) -> cli_compiler_extension_load(slot, path, limits)
    analyze_guest :: (handle: Int, bytes: [U8]) -> cli_compiler_extension_analyze(slot, bytes)
    close_guest :: (handle: Int) -> cli_compiler_extension_close(slot)
    analyzed :: pkg_extension_analyze_with_host(wasm_path, snapshot, load_guest, analyze_guest, close_guest) ?? {
        term.eprint(err.message)
        return @EXIT_USAGE
    }
    response :: analyzed.encode() ?? {
        term.eprint(err.message)
        return @EXIT_USAGE
    }
    if response.len() > snapshot.limits.max_response_bytes {
        term.eprint("compiler-extension response exceeds IPC limit ({response.len()} > {snapshot.limits.max_response_bytes})")
        return @EXIT_USAGE
    }
    term.stdout().write_bytes(response) ?? {
        term.eprint("couldn't write compiler-extension response: {err}")
        return @EXIT_USAGE
    }
    @EXIT_OK
}

// Load the component into the slot: `O:<handle>` or `E:<message>`. A
// component that asks for any import or lacks `analyze` fails closed.
fn cli_compiler_extension_load(slot: Shared<CompilerExtensionSlot>, path: String, limits: plugin.Limits) -[FS, Exec]> String Never! {
    guest_name :: files.basename(path)
    authority :: Authority.from_rights([String]{"FS.Read:{path}"})
    if plugin.load<CompilerExtensionGuest>(path, authority, limits: limits) == {
        .Ok(guest) -> {
            permit :: slot.guard_edit()
            permit.value.guest = Val(guest)
            "O:1"
        }
        .Err(error) -> "E:couldn't load compiler-extension `{guest_name}` (world `{@COMPILER_EXTENSION_WORLD}` admits no host imports — no clock, random, filesystem, network, or process; it must export `analyze`): {error}"
    }
}

// Call `analyze` with the per-call fuel and wall-clock budget:
// `O:<len>:<hex>` or `E:<message>`.
fn cli_compiler_extension_analyze(slot: Shared<CompilerExtensionSlot>, snapshot: [U8]) -[Exec]> String Never! {
    permit :: slot.guard_read()
    guest :: permit.value.guest ?? return "E:no compiler-extension loaded for this handle"
    if guest.analyze(snapshot) == {
        .Ok(bytes) -> "O:{bytes.len()}:{hex.encode(bytes)}"
        .Err(error) -> "E:calling `analyze` trapped: {error}"
    }
}

// Close the loaded component; true when one was live.
fn cli_compiler_extension_close(slot: Shared<CompilerExtensionSlot>) -> Bool Never! {
    permit :: slot.guard_edit()
    guest :: permit.value.guest ?? return false
    permit.value.guest = None
    close(^guest)
    true
}
