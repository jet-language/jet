// The hidden, bounded compiler-extension host (Rust jetpack-bin
// `run_compiler_extension_host` plus Prelude/CompilerExtension.rs).
// Snapshot bytes arrive on stdin; one validated response goes to stdout.
// Every failure is plain Jet-owned stderr plus a nonzero status.
//
// The guest is a runtime-path WebAssembly component that must run with no
// host imports under the v1 fuel, memory, table, and wall-clock limits.
// Core's plugin loader only binds a literal, registered artifact and takes
// no resource limits, so the host fails closed after it has read and
// checked the snapshot: no guest code runs.

COMPILER_EXTENSION_HOST_UNSUPPORTED :: "compiler extensions are not available: this jetpack cannot load a runtime WebAssembly component under fuel, memory, table, and time limits"

fn cli_run_compiler_extension_host(args: [String]) -[IO]> Int Never! {
    if args.len() != 1 {
        term.eprint("compiler-extension host requires exactly one component path")
        return EXIT_USAGE
    }
    request :: term.take(EXTENSION_MAX_SNAPSHOT_BYTES + 1) ?? {
        term.eprint("couldn't read compiler-extension snapshot: {err}")
        return EXIT_USAGE
    }
    if request.len() > EXTENSION_MAX_SNAPSHOT_BYTES {
        term.eprint("compiler-extension snapshot exceeds IPC limit ({EXTENSION_MAX_SNAPSHOT_BYTES} bytes)")
        return EXIT_USAGE
    }
    _ :: TypedSnapshot.decode_bytes(request) ?? {
        term.eprint(err.message)
        return EXIT_USAGE
    }
    term.eprint(COMPILER_EXTENSION_HOST_UNSUPPORTED)
    EXIT_USER_ERROR
}
