// The hidden package-dependency host `jet` execs for `jet add`, `jet remove`,
// `jet fetch`, `jet update [<dep>]`, `jet registry vendor [--vendor-dir <dir>]`
// and the lock check of `jet build --locked`
// (Compiler/JetCli EngineCommands.jet). The compiler front selects the
// project root and its Package carrier; this host edits the carrier through
// the checked source editor and Foundation publisher, then runs the package
// fetch. Success is plain stdout; spanless input and I/O refusals are one
// report on stderr (one failed `jet.status/v1` line on stdout under
// `--json`); source-owned parse and fetch errors stay direct, uncolored
// diagnostics against their carrier.
//
// argv after the subcommand: `<root> <entry> <color 0|1> <json 0|1>` and then
// the command words as the user typed them, command first. `fetch --lock
// <script>` locks a loose script and gets no entry.
PACKAGE_DEPENDENCY_HOST_SUBCOMMAND: "__package-v1"
PACKAGE_DEPENDENCY_COMMANDS: [String]{"add", "remove", "fetch", "update", "vendor"}
// jet's output flags, already applied by the front.
PACKAGE_DEPENDENCY_OUTPUT_FLAGS: [String]{"--json", "--quiet", "-q", "--verbose", "-v", "--color"}
PACKAGE_DEPENDENCY_VALUE_FLAGS: [String]{"--path", "--git", "--tag", "--branch", "--rev"}

PackageDependencyOutput: struct {
    stdout: String{""}
    stderr: String{""}
    exit_code: Int{EXIT_OK}
}
#Error
PackageDependencyError: struct { output: PackageDependencyOutput }
#Error
PackageDependencyWriteError: struct { message: String }
PackageDependencyInput: struct {
    path: String
    raw: String
    inline: InlinePackageBlock?
    manifest: Manifest
    authority: FoundationFileAuthority
}

cli_run_package_dependency_host: fn(args: [String]) -[IO, FS, Env, Exec, Net, Time, Time.Wait]> Int Never! {
    if args.len() < 5 || !PACKAGE_DEPENDENCY_COMMANDS.contains(args[4]) {
        eprint("package-dependency host requires `<root> <entry> <color> <json> <add|remove|fetch|update|vendor> ...`")
        return EXIT_USAGE
    }
    output: cli_package_dependency(args[0], args[1], cli_tail(args, 4), args[2] == "1", args[3] == "1")
    if output.stdout.len() > 0 {
        stdout_handle := term.stdout()
        stdout_handle.write(output.stdout).drop("package output is best-effort")
    }
    if output.stderr.len() > 0 -> terminal_write_output(output.stderr)
    output.exit_code
}

cli_package_dependency_cli_error: fn(code: String, what: String, fix: String?, color: Bool, json: Bool) -[FS, Env]> PackageDependencyError Never! {
    row: diagnostic_registry_row(code) ?? panic("package-dependency refusals use registered codes")
    report: diagnostic_from_registry(code, None, what, row.why, fix ?? row.fix)
    exit_code: if code == "E2102" -> EXIT_USAGE else -> EXIT_USER_ERROR
    if json {
        line: StatusEnvelope.new("cli", false).with_reports([ReportEnvelope]{cli_diagnostic_to_report(report, ReportPath.from_process(""))}).json_line() ?? return PackageDependencyError{output: PackageDependencyOutput{stderr: "status JSON: {err.message}\n", exit_code: EXIT_USAGE}}
        return PackageDependencyError{output: PackageDependencyOutput{stdout: line, exit_code: exit_code}}
    }
    PackageDependencyError{output: PackageDependencyOutput{stderr: diagnostic_render_all("", "", [Diagnostic]{report}, color), exit_code: exit_code}}
}
cli_package_dependency_source_error: fn(path: String, raw: String, report: Diagnostic) -> PackageDependencyError Never! {
    PackageDependencyError{output: PackageDependencyOutput{stderr: diagnostic_render_all(path, raw, [Diagnostic]{report}, false), exit_code: EXIT_USER_ERROR}}
}

// The command's positional words. Every flag is one the command takes; a
// value flag owns the next token verbatim, even a flag.
cli_package_dependency_words: fn(raw: [String], color: Bool, json: Bool) -[FS, Env]> [String] PackageDependencyError! {
    command: raw[0]
    words := [String]{command}
    index := 1
    loop index < raw.len() {
        word: raw[index]
        index += 1
        if !word.starts_with("-") || word == "-" {
            words.push(word.copy())
            next
        }
        if PACKAGE_DEPENDENCY_OUTPUT_FLAGS.contains(word) || word.starts_with("--color=") -> next
        if command == "add" && PACKAGE_DEPENDENCY_VALUE_FLAGS.contains(word) {
            if index >= raw.len() -> return Err(cli_package_dependency_cli_error("E2104", "`{word}` needs a value", Val("write `jet add <name> {word} <value>`"), color, json))
            index += 1
            next
        }
        if command == "fetch" && (word == "--locked" || word == "--offline") -> next
        if command == "vendor" && word == "--vendor-dir" {
            if index >= raw.len() -> return Err(cli_package_dependency_cli_error("E2104", "`--vendor-dir` needs a directory", Val("write `jet registry vendor --vendor-dir <dir>`"), color, json))
            index += 1
            next
        }
        if command == "fetch" && word == "--lock" {
            if index >= raw.len() -> return Err(cli_package_dependency_cli_error("E2104", "`--lock` needs a script", Val("write `jet fetch --lock <script.jet>`"), color, json))
            index += 1
            next
        }
        return Err(cli_package_dependency_cli_error("E2102", "`{word}` isn't a `jet {cli_package_dependency_spelling(command)}` flag", Val("run `jet {cli_package_dependency_spelling(command)} --help` to see its flags"), color, json))
    }
    limit: if command == "fetch" || command == "vendor" -> 1 else -> 2
    takes: if limit == 1 -> "no arguments" else -> "one dependency name"
    if words.len() > limit -> return Err(cli_package_dependency_cli_error("E2104", "`jet {cli_package_dependency_spelling(command)}` takes {takes}, not `{words[limit]}`", None, color, json))
    Ok(words)
}

// The command as the user spells it: vendoring lives under `jet registry`.
cli_package_dependency_spelling: fn(command: String) -> String Never! {
    if command == "vendor" -> return "registry vendor"
    command.copy()
}

// A value flag takes only the separate-token spelling.
cli_package_dependency_flag: fn(raw: [String], flag: String) -> String? Never! {
    loop (index, word) in raw {
        if word == flag -> return raw.get(index + 1)
    }
    None
}
cli_package_dependency_add_spec: fn(raw: [String], name: String?, color: Bool, json: Bool) -[FS, Env]> (name: String, spec: DepSpec) PackageDependencyError! {
    dependency: name ?? return Err(cli_package_dependency_cli_error("E2104", "`jet add` needs a dependency name", Val("try `jet add mylib --path ../mylib`"), color, json))
    if cli_package_dependency_flag(raw, "--path") == .Val(path) -> return Ok((name: dependency, spec: DepSpec.Path{path: path}))
    if cli_package_dependency_flag(raw, "--git") == .Val(url) {
        selector := GitSelector?{None}
        if {
            cli_package_dependency_flag(raw, "--tag") == .Val(selected_tag) -> selector = Val(GitSelector.Tag(selected_tag))
            cli_package_dependency_flag(raw, "--branch") == .Val(branch) -> selector = Val(GitSelector.Branch(branch))
            cli_package_dependency_flag(raw, "--rev") == .Val(rev) -> selector = Val(GitSelector.Rev(rev))
            else -> {}
        }
        selected: selector ?? return Err(cli_package_dependency_cli_error("E2104", "git dependency `{dependency}` needs one of: --tag, --branch, --rev", None, color, json))
        return Ok((name: dependency, spec: DepSpec.Git{url: url, selector: selected}))
    }
    Err(cli_package_dependency_cli_error("E2104", "`jet add {dependency}` needs --path or --git", Val("try `jet add {dependency} --path ../{dependency}` or `jet add {dependency} --git <url> --tag <tag>`"), color, json))
}

cli_package_dependency_read: fn(path: String, color: Bool, json: Bool) -[FS, Env]> (raw: String, authority: FoundationFileAuthority) PackageDependencyError! {
    authority: foundation_open_file_authority(files.dirname(path), files.basename(path)) ?? return Err(cli_package_dependency_cli_error("E2105", "couldn't read {path}: {err}", None, color, json))
    bytes: authority.read_bounded(MAX_TREE_FILE_BYTES) ?? return Err(cli_package_dependency_cli_error("E2105", "couldn't read {path}: {err}", None, color, json))
    raw: String.from_bytes(bytes) ?? return Err(cli_package_dependency_cli_error("E2105", "couldn't read {path}: stream did not contain valid UTF-8", None, color, json))
    Ok((raw: raw, authority: authority))
}

// The checked Package carrier of `entry`: its inline `package: { }` block, or
// the root's `package.jet`. A project with no entry file yet (a package that
// only declares dependencies) has the root's `package.jet` alone.
cli_package_dependency_input: fn(root: String, entry: String, color: Bool, json: Bool) -[FS, Env]> PackageDependencyInput PackageDependencyError! {
    cache := WorkspaceDeclarationCache.new()
    if !files.exists(entry) {
        rooted: if pkg_package_facts_for_root(cache, root) == {
            .Ok(value) -> value
            .Err(error) -> { return Err(cli_package_dependency_source_error(PACKAGE_FILE, "", error.diagnostic)) }
        }
        return cli_package_dependency_root_input(root, rooted ?? return Err(cli_package_dependency_cli_error("E2105", "couldn't resolve package facts for {root}", None, color, json)), color, json)
    }
    source: cli_package_dependency_read(entry, color, json)
    inline: if pkg_extract_inline_package(source.raw) == {
        .Ok(value) -> value
        .Err(error) -> { return Err(cli_package_dependency_source_error(entry, source.raw, error.diagnostic())) }
    }
    found: if pkg_package_facts_for_entry(cache, entry) == {
        .Ok(value) -> value
        .Err(error) -> { return Err(cli_package_dependency_source_error(entry, source.raw, error.diagnostic)) }
    }
    facts: found ?? return Err(cli_package_dependency_cli_error("E2105", "couldn't resolve package facts for {entry}", None, color, json))
    if inline == .Val(block) {
        manifest: pkg_to_manifest(facts, block.body(source.raw)) ?? return Err(cli_package_dependency_source_error(entry, block.body(source.raw), err.diagnostic))
        return Ok(PackageDependencyInput{path: entry, raw: source.raw, inline: inline, manifest: manifest, authority: source.authority.move()})
    }
    cli_package_dependency_root_input(root, facts, color, json)
}

// The root's `package.jet` as the carrier of `facts`.
cli_package_dependency_root_input: fn(root: String, facts: PackageFacts, color: Bool, json: Bool) -[FS, Env]> PackageDependencyInput PackageDependencyError! {
    located: if pkg_manifest_path_checked(root) == {
        .Ok(value) -> value
        .Err(error) -> { return Err(cli_package_dependency_source_error(PACKAGE_FILE, "", error.diagnostic)) }
    }
    path: located ?? return Err(cli_package_dependency_cli_error("E2105", "couldn't locate {PACKAGE_FILE}", None, color, json))
    carrier: cli_package_dependency_read(path, color, json)
    manifest: pkg_to_manifest(facts, carrier.raw) ?? return Err(cli_package_dependency_source_error(path, carrier.raw, err.diagnostic))
    Ok(PackageDependencyInput{path: path, raw: carrier.raw, inline: None, manifest: manifest, authority: carrier.authority.move()})
}

cli_package_dependency_edit: fn(input: PackageDependencyInput, name: String, spec: DepSpec?) -> String Never! {
    body: if input.inline == .Val(block) -> block.body(input.raw) else -> input.raw
    updated: if spec == .Val(value) -> pkg_add_dependency(body, name, value) else -> pkg_remove_dependency(body, name)
    if input.inline == .Val(block) -> return "{pkg_binder_slice(input.raw, 0, block.body_span.start)}{updated}{pkg_binder_slice(input.raw, block.body_span.end, input.raw.bytes().len())}"
    updated
}

// Retain the ORIGINAL source authority through stage/fsync/rename, and re-read
// the source before staging: a concurrent edit is never overwritten.
cli_package_dependency_publish: fn(input: PackageDependencyInput, updated: String) PackageDependencyWriteError! -[FS, Env, Time]> {
    parent: files.dirname(input.path)
    name: files.basename(input.path)
    resolver: AuthorityResolver.open(parent) ?? return Err(PackageDependencyWriteError{message: "could not open package source authority: {err.message()}"})
    current: resolver.checked_file(name) ?? return Err(PackageDependencyWriteError{message: "could not check {input.path}: {err.message()}"})
    raw: current.text() ?? return Err(PackageDependencyWriteError{message: "could not read {input.path}: {err.message()}"})
    if raw != input.raw -> return Err(PackageDependencyWriteError{message: "{input.path} changed while the package edit was prepared"})
    resolver.revalidate_file(current) ?? return Err(PackageDependencyWriteError{message: "package source changed before writing: {err.message()}"})
    input.authority.revalidate() ?? return Err(PackageDependencyWriteError{message: "package source changed before writing: {err}"})
    foundation_write_file_nofollow_at_root(parent, name, updated.bytes(), Val(fn() { input.authority.revalidate() })) ?? return Err(PackageDependencyWriteError{message: cli_package_dependency_publication_error(input.path, err)})
}

cli_package_dependency_publication_error: fn(path: String, failure: FoundationPublicationError) -> String Never! {
    detail: "{failure.error}"
    if failure.phase == {
        .PreparePath -> "could not check {path}: {detail}"
        .OpenRoot | .OpenParent -> "could not open package source authority: {detail}"
        .CreateStage | .WriteStage | .SetMode | .InspectStage -> "could not stage {path}: {detail}"
        .SyncStage | .SyncParent -> "could not sync {path}: {detail}"
        .ValidateSource -> "package source changed before publishing: {detail}"
        .InspectDestination | .ValidateAuthority | .Rename | .ValidatePublished -> "could not publish {path}: {detail}"
    }
}

cli_package_dependency_success: fn(lock: LockFile, options: PackageFetchOptions) -> String Never! {
    output := ""
    loop package in lock.packages {
        if package.source == .Registry(registry, _, _, _, _, _, tier, gate_status) -> output = "{output}resolved `{package.name}` {package.version} from registry `{registry}` (tier: {tier}; gate status: {gate_status})\n"
    }
    message: if {
        options.update && options.update_dep == .Val(name) -> "updated `{name}`"
        options.update -> "updated all moving selectors"
        options.locked -> "lock verified"
        else -> "fetched all dependencies"
    }
    "{output}{message}\n"
}

cli_package_dependency_edit_success: fn(command: String, name: String, path: String) -> String Never! {
    if command == "add" -> return "added `{name}` to {path}\n"
    "removed `{name}` from {path}\n"
}

// `jet fetch --lock <script>`: resolve every inline `use pkg#version` of a
// loose script and write its `<script>.lock` sidecar, keyed by the script's
// content hash. A dependency no local copy satisfies resolves through the
// configured package registry on the one fetch path (pkg_fetch_resolve:
// verified, then ingested into Hangar) and is copied to
// `.jet/inline-deps/<name>/<version>/`, so the locked script resolves offline
// afterwards. `--offline` never asks the registry. An unresolved dependency
// is E1253 and writes no lock. A relative `script` names a file under `root`,
// jet's working directory.
cli_package_dependency_script_lock: fn(root: String, script: String, offline: Bool, quiet: Bool, color: Bool, json: Bool) -[FS, Env, Exec, Net, Time, Time.Wait]> PackageDependencyOutput Never! {
    path: if script.starts_with("/") -> script else -> files.join(root, script)
    source: cli_package_dependency_read(path, color, json) ?? return err.output
    parsed: parse_source(source.raw.bytes())
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> return PackageDependencyOutput{stderr: diagnostic_render_all(script, source.raw, parsed.diagnostics, color), exit_code: EXIT_USER_ERROR}
    }
    script_dir: files.dirname(path)
    deps := [LockedInlineDep]{}
    loop dep in pkg_inline_deps_collect(parsed.program) {
        resolved: if pkg_inline_deps_resolve(dep, script_dir) == {
            .Ok(found) -> found
            .Err(reason) -> {
                // A local package stays authoritative: only an unknown one
                // is fetched.
                missed: if reason == {
                    .UnknownPackage -> true
                    .InvalidName | .InvalidSelector | .NoMatch | .InvalidTree(_) -> false
                }
                if offline || !missed -> return PackageDependencyOutput{stderr: diagnostic_render_all(script, source.raw, [Diagnostic]{pkg_inline_deps_e1253(dep, reason)}, color), exit_code: EXIT_USER_ERROR}
                cli_package_dependency_inline_fetch(script, script_dir, dep) ?? return cli_package_dependency_source_error(script, source.raw, err.diagnostic).output
                pkg_inline_deps_resolve(dep, script_dir) ?? return PackageDependencyOutput{stderr: diagnostic_render_all(script, source.raw, [Diagnostic]{pkg_inline_deps_e1253(dep, err)}, color), exit_code: EXIT_USER_ERROR}
            }
        }
        deps.push(LockedInlineDep{name: dep.name, selector: dep.selector, resolved: resolved.resolved_version, content_hash: resolved.content_hash})
    }
    script_hash: pkg_inline_deps_file_hash(path) ?? return cli_package_dependency_cli_error("E2105", "couldn't hash {script}: {err}", None, color, json).output
    env_script_lock_write(path, ScriptLockFile{version: SCRIPT_LOCK_VERSION, script_hash: script_hash, deps: deps}) ?? return cli_package_dependency_cli_error("E2105", "couldn't write {env_script_lock_sidecar_path(script)}: {err}", None, color, json).output
    if quiet -> return PackageDependencyOutput{}
    PackageDependencyOutput{stdout: "locked {script} in {env_script_lock_sidecar_path(script)}\n"}
}

// One inline dependency through the registry: the selector becomes the
// registry requirement it means (`1.4.2` exactly, `1.4` any `1.4.x`), the
// verified artifact is ingested into Hangar, and its tree is copied to the
// script's managed `.jet/inline-deps/<name>/<version>/` folder.
cli_package_dependency_inline_fetch: fn(script: String, script_dir: String, dep: InlineDep) PackageFetchError! -[FS, Env, Exec, Net, Time, Time.Wait]> {
    root: files.canonicalize(script_dir) ?? return Err(pkg_fetch_error("E1224", "couldn't open the script directory", "{err}", "restore the script's directory"))
    parts: pkg_inline_deps_numeric_version(dep.selector) ?? return Err(pkg_fetch_registry_error(dep.name, "invalid inline selector `{dep.selector}`"))
    words := [String]{}
    loop part in parts -> words.push("{part}")
    requirement: if words.len() == 3 -> "={words.join(".")}" else -> "{words.join(".")}.*"
    roots: pkg_resolve_roots()
    context: ProviderCtx{fixtures: provider_fixtures_from_env(None), store_dir: roots.hangar_dir(), offline: false, project_dir: Val(root), nix_index: None, nix_roots: None, allow_local_nix_catalog: false}
    resolver := PackageFetchResolver{root: root, previous: None, options: PackageFetchOptions{}, policy: PackagePolicy.default(), nodes: [String: PackageFetchNode]{}, versions: [String: PackageFetchVersion]{}, visiting: [String]{}, registry_plan: [String: PublicationIndexEntry]{}, update_scope: pkg_fetch_update_scope(None, PackageFetchOptions{}), foreign: [String: ForeignRealization]{}, advisory_loaded: false, advisory: None}
    verification := StoreVerification.new()
    pkg_fetch_resolve(verification, roots, context, resolver, dep.name, DepSpec.Registry(requirement), root, [String]{"{script} (script)", dep.name})
    node: resolver.nodes[dep.name]
    cli_package_dependency_inline_copy(root, dep.name, node.package.version, node.directory) ?? return Err(pkg_fetch_error("E1224", "couldn't copy `{dep.name}` into .jet/inline-deps", "{err}", "make the script directory writable, then run the script again"))
}

// Stage the verified tree beside its final name, then rename it into place;
// a failed copy leaves no partial version directory.
cli_package_dependency_inline_copy: fn(root: String, name: String, version: String, source: String) IOError! -[FS, Env, Time]> {
    project: foundation_open_directory_authority(root)
    package: project.child(".jet", true).child("inline-deps", true).child(name, true)
    if package.child(version) == .Ok(_) -> return
    stage: package.private_child("fetch")
    stage_name: files.basename(stage.path())
    if stage.copy_tree_from(foundation_open_directory_authority(source), reject_hardlinks: false) == .Err(error) {
        package.remove_tree(stage_name).drop("the copy error is the primary failure")
        return Err(error)
    }
    if package.rename(stage_name, version) == .Err(error) {
        package.remove_tree(stage_name).drop("the rename error is the primary failure")
        return Err(error)
    }
}

// `raw` is the command's words as typed, command first. `--quiet` keeps
// success silent; the lock check of `jet build --locked` runs that way.
cli_package_dependency: fn(root: String, entry: String, raw: [String], color: Bool, json: Bool) -[FS, Env, Exec, Net, Time, Time.Wait]> PackageDependencyOutput Never! {
    command: raw[0]
    words: cli_package_dependency_words(raw, color, json) ?? return err.output
    quiet: raw.contains("--quiet") || raw.contains("-q")
    if command == "fetch" && cli_package_dependency_flag(raw, "--lock") == .Val(script) -> return cli_package_dependency_script_lock(root, script, raw.contains("--offline"), quiet, color, json)
    prefix := ""
    if command == "add" || command == "remove" {
        name := ""
        spec := DepSpec?{None}
        if command == "add" {
            selected: cli_package_dependency_add_spec(raw, words.get(1), color, json) ?? return err.output
            name = selected.name
            spec = Val(selected.spec)
        } else {
            name = words.get(1) ?? return cli_package_dependency_cli_error("E2104", "`jet remove` needs a dependency name", Val("try `jet remove mylib`"), color, json).output
        }
        input: cli_package_dependency_input(root, entry, color, json) ?? return err.output
        if command == "remove" && input.manifest.dependencies.get(name) == None -> return cli_package_dependency_cli_error("E2104", "dependency `{name}` is not present in {files.basename(input.path)}", Val("remove a dependency listed in {files.basename(input.path)}, or add `{name}` first"), color, json).output
        cli_package_dependency_publish(input, cli_package_dependency_edit(input, name, spec)) ?? return cli_package_dependency_cli_error("E2105", "couldn't write {input.path}: {err.message}", None, color, json).output
        if !quiet -> prefix = cli_package_dependency_edit_success(command, name, input.path)
    }
    options: PackageFetchOptions{locked: command == "fetch" && (raw.contains("--locked") || raw.contains("--offline")), update: command == "update", update_dep: if command == "update" -> words.get(1) else -> None}
    input: cli_package_dependency_input(root, entry, color, json) ?? {
        failed: err.output
        return PackageDependencyOutput{stdout: "{prefix}{failed.stdout}", stderr: failed.stderr, exit_code: failed.exit_code}
    }
    verification := StoreVerification.new()
    fetched: pkg_fetch(verification, root, input.manifest, pkg_lock_load(root), options) ?? {
        failed: cli_package_dependency_source_error(input.path, input.raw, err.diagnostic).output
        return PackageDependencyOutput{stdout: prefix, stderr: failed.stderr, exit_code: failed.exit_code}
    }
    if command == "vendor" -> return cli_package_dependency_vendor(root, raw, fetched, quiet, color, json)
    if quiet -> return PackageDependencyOutput{}
    PackageDependencyOutput{stdout: "{prefix}{cli_package_dependency_success(fetched.lock, options)}"}
}

// `jet registry vendor`: after the fetch, copy every resolved dependency tree
// to `<dir>/<name>/` and record each one's locked name, version and
// fingerprint in `<dir>/manifest.json`, so a committed vendor tree can be
// checked against the lock offline. `<dir>` is `vendor` unless
// `--vendor-dir` names it; a relative one is under the project root.
cli_package_dependency_vendor: fn(root: String, raw: [String], fetched: PackageFetchResult, quiet: Bool, color: Bool, json: Bool) -[FS, Env, Time]> PackageDependencyOutput Never! {
    chosen: cli_package_dependency_flag(raw, "--vendor-dir") ?? "vendor"
    target: if chosen.starts_with("/") -> chosen else -> files.join(root, chosen)
    files.create_dir_all(target) ?? return cli_package_dependency_cli_error("E2105", "couldn't create the vendor directory {target}: {err}", None, color, json).output
    names := fetched.directories.keys().to_list()
    names.sort()
    entries := [Dyn]{}
    loop name in names {
        source: fetched.directories.get(name) ?? next
        cli_package_dependency_vendor_copy(target, name, source) ?? return cli_package_dependency_cli_error("E2105", "couldn't copy `{name}` into {target}: {err}", Val("vendored dependency trees hold only regular files and directories; fix `{name}`'s source, then run `jet registry vendor` again"), color, json).output
        loop package in fetched.lock.packages {
            if package.name == name -> entries.push(Dyn.Object(["name": Dyn.Text(package.name), "version": Dyn.Text(package.version), "fingerprint": Dyn.Text(package.fingerprint)]))
        }
    }
    manifest: "{pkg_json_render_pretty(Dyn.Object(["vendor_format": Dyn.Int(1), "packages": Dyn.Array(entries)]))}\n"
    foundation_write_file_nofollow_at_root(target, "manifest.json", manifest.bytes(), None) ?? return cli_package_dependency_cli_error("E2105", cli_package_dependency_publication_error(files.join(target, "manifest.json"), err), None, color, json).output
    if quiet -> return PackageDependencyOutput{}
    if names.len() == 0 -> return PackageDependencyOutput{stdout: "vendor: no dependencies to copy\n"}
    shown: if target != root && cli_path_starts_with(target, root) -> files.relative(target, root) else -> target
    out := ""
    loop name in names -> out = "{out}vendored: {name}\n"
    noun: if names.len() == 1 -> "dependency" else -> "dependencies"
    PackageDependencyOutput{stdout: "{out}ok: {names.len()} {noun} copied to {shown}/\ntip: commit {shown}/ and use `jet fetch --locked` for reproducible offline builds.\n"}
}

// Stage the copy beside its final name and rename it into place once its
// tree hash matches the source; an identical existing copy is kept and a
// stale one replaced. A symlink or special file in the source refuses the
// copy and leaves nothing behind.
cli_package_dependency_vendor_copy: fn(target: String, name: String, source: String) IOError! -[FS, Env, Time]> {
    vendor: foundation_open_directory_authority(target)
    origin: foundation_open_directory_authority(source)
    expected: origin.tree_hash()
    if vendor.child(name) == .Ok(existing) {
        if (existing.tree_hash() ?? "") == expected -> return
        vendor.remove_tree(name)
    }
    stage: vendor.private_child("vendor")
    stage_name: files.basename(stage.path())
    if stage.copy_tree_from(origin, reject_hardlinks: false) == .Err(error) {
        vendor.remove_tree(stage_name).drop("the copy error is the primary failure")
        return Err(error)
    }
    if (stage.tree_hash() ?? "") != expected {
        vendor.remove_tree(stage_name).drop("the hash mismatch is the primary failure")
        return Err(IOError.Other(IOContext{operation: .Write, resource: Val(files.join(target, name)), os_code: None, cause: Val("the staged vendor copy does not match the source tree")}))
    }
    if vendor.rename(stage_name, name) == .Err(error) {
        vendor.remove_tree(stage_name).drop("the rename error is the primary failure")
        return Err(error)
    }
}
