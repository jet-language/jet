// The error carrier of Jetpack's standalone CLI tools: the hermetic `cc`
// driver and the `jetpack-nix-index` and `jetpack-trust-root` helper
// binaries. Each failure carries its final diagnostic text, which the tool
// prints verbatim; the Rust reference returns the same text as `String`.

#Error
CLIToolError: struct {
    message: String

    new: fn(message: String) -> CLIToolError Never! {
        CLIToolError{message: message}
    }
}
