// Editable migration-import IR ported from the plan half of
// crates/jetpack/src/MigrationImport.rs.
//
// Command spelling and TODO diagnostic codes are gated. An import produces a
// canonical editable `package.jet` plus data-only TODO facts; every provider
// fact that could not be carried losslessly stays a visible finding.

// The importer's editable result.
ImportPlan: struct {
    source_kind: String
    packages: [ImportedPackage]
    deps: [ImportedDep]
    generated_files: [GeneratedFile]
    adapters: [AdapterDraft]
    ffi_stubs: [FFIStub]
    todos: [ImportTodo]
    migration: [MigrationStatus]
    // One shared provider-fact record per imported provider reference.
    // Losses remain on the record so generated files cannot hide an
    // unresolved fact.
    provider_facts: [String: ProviderFacts]

    empty: fn(kind: String) -> ImportPlan Never! {
        ImportPlan{
            source_kind: kind,
            packages: [ImportedPackage]{},
            deps: [ImportedDep]{},
            generated_files: [GeneratedFile]{},
            adapters: [AdapterDraft]{},
            ffi_stubs: [FFIStub]{},
            todos: [ImportTodo]{},
            migration: [MigrationStatus]{},
            provider_facts: [String: ProviderFacts]{}
        }
    }

    retain_provider_facts: fn(&self, facts: ProviderFacts) Never! {
        self.retain_provider_facts_with_source(facts, "")
    }

    // Keep `facts` under its reference, merging into an existing record, and
    // surface every loss and conflict as a finding at `source_path`.
    retain_provider_facts_with_source: fn(&self, facts: ProviderFacts, source_path: String) Never! {
        self.record_fact_findings(facts, source_path)
        reference: facts.reference
        existing := self.provider_facts.get(reference) ?? {
            self.provider_facts[reference] = facts
            return
        }
        if existing.provider != facts.provider {
            previous_provider: existing.provider.copy()
            existing.add_conflict("provider", previous_provider, facts.provider, "provider.import")
        }
        if existing.target != facts.target {
            previous_target: existing.target.copy()
            existing.add_conflict("target", previous_target, facts.target, "provider.import")
        }
        if facts.resolved_source != "" -> existing.set_resolved_source(facts.resolved_source)
        if facts.native_format != "" -> existing.set_native_document(facts.native_format, facts.native_document)
        keys := facts.facts.keys().to_list()
        keys.sort()
        loop key in keys {
            source: facts.provenance.get(key) ?? "provider.import"
            existing.add_fact(key, facts.facts[key], source)
        }
        loop loss in facts.losses {
            if !existing.losses.contains(loss) -> existing.losses.push(loss.copy())
        }
        loop conflict in facts.conflicts {
            if !existing.conflicts.contains(conflict) -> existing.conflicts.push(conflict.copy())
        }
        self.provider_facts[reference] = existing
        self.record_fact_findings(existing, source_path)
    }

    // One finding per loss and conflict of `facts`.
    record_fact_findings: fn(&self, facts: ProviderFacts, source_path: String) Never! {
        loop loss in facts.losses {
            self.record_provider_finding(cli_import_source_path_for_finding(loss.source, source_path), "provider fact `{loss.key}` is lossy: {loss.reason}; migration remains unresolved")
        }
        loop conflict in facts.conflicts {
            self.record_provider_finding(cli_import_source_path_for_finding(conflict.source, source_path), "provider fact `{conflict.key}` conflicts: {conflict.left} vs {conflict.right}; migration is unresolved")
        }
    }

    // A data-only finding, recorded once.
    record_provider_finding: fn(&self, source_path: String, message: String) Never! {
        todo: ImportTodo{source_path: source_path, message: message, suggested_surface: None}
        if !self.todos.contains(todo) -> self.todos.push(todo)
    }

    // The canonical editable `package.jet`. Only lossless runtime
    // dependencies become source; while the root itself is unresolved the
    // dependency block stays empty.
    emit_pkg_jet: fn(self) -> String Never! {
        first: self.packages.get(0)
        name: first?.name ?? "imported-app"
        version: first?.version ?? "0.1.0"
        out := "payload: {{\n    name: \"{name}\",\n    version: \"{version}\",\n    jet: \">=0.1.0\",\n    description: \"Imported from {self.source_kind}\",\n    license: \"\",\n    repository: \"\",\n}}\n"
        out = "{out}\ndeps: {{\n"
        unresolved_root := false
        loop entry in self.provider_facts {
            if entry.value.is_lossless() -> next
            declared := false
            loop dependency in self.deps {
                if dependency.provider_ref == entry.key -> declared = true
            }
            if !declared -> unresolved_root = true
        }
        if unresolved_root -> return "{out}}}\n"
        deps := self.deps
        deps.sort_by((left: ImportedDep, right: ImportedDep) -> left.name <=> right.name)
        loop dep in deps {
            facts: self.provider_facts.get(dep.provider_ref) ?? next
            // A mutable foreign selector belongs in the source-linked
            // migration finding, never in generated Jet source. The canonical
            // manifest has no dev/optional/peer dependency section, so those
            // roles also stay as provider facts plus a migration finding
            // instead of becoming runtime dependencies.
            if !facts.is_lossless() -> next
            if (facts.text_fact("package.dependency_kind") ?? "runtime") != "runtime" -> next
            out = "{out}    {dep.name}: {facts.qualified_reference()},\n"
        }
        "{out}}}\n"
    }
}

ImportedPackage: struct {
    name: String
    version: String
}

ImportedDep: struct {
    name: String
    provider_ref: String
    locked_version: String
    dev: Bool
}

GeneratedFile: struct {
    path: String
    contents: String
    owned: Bool
}

AdapterDraft: struct {
    name: String
    source: String
    recipe: String
}

FFIStub: struct {
    path: String
    symbol: String
}

ImportTodo: struct {
    source_path: String
    message: String
    suggested_surface: String?
}

// Where one imported package stands on the way to a native replacement.
MigrationStatus: enum {
    ForeignDependencyRetained(name: String)
    AdapterWrapped(name: String)
    FFIStubGenerated(name: String)
    NativeReplacementCandidate(name: String)
    CompatibilityProved(name: String)
    NativeReplacementActive(name: String)
}

// A regenerated file would overwrite a user edit.
#Error
ImportConflict: enum {
    UserEditedGeneratedLine(path: String)

    message: fn(self) -> String Never! {
        if self == {
            .UserEditedGeneratedLine(path) -> "generated file `{path}` was edited by the user"
        }
    }
}

// TODO diagnostic codes await a ballot.
cli_todo_diagnostics_need_ballot: fn() -> Bool Never! {
    true
}

// The generated contents when the file is new or unchanged; a user-edited
// file is a conflict.
cli_merge_generated_file: fn(existing: String?, generated: GeneratedFile) -> String ImportConflict! {
    current: existing ?? return Ok(generated.contents)
    if current == generated.contents -> return Ok(generated.contents)
    Err(ImportConflict.UserEditedGeneratedLine{path: generated.path})
}

// The finding path for a fact recorded at `source`: provider-internal
// sources point at the imported document instead.
cli_import_source_path_for_finding: fn(source: String, fallback: String) -> String Never! {
    internal: if source == {
        "" | "provider.native_document" | "reference.provider" | "reference.selector" -> true
        else -> source.starts_with("package.json.")
    }
    if fallback.trim() != "" && internal -> return fallback.copy()
    if source.trim() == "" {
        if fallback.trim() == "" -> return "provider facts"
        return fallback.copy()
    }
    source.copy()
}
