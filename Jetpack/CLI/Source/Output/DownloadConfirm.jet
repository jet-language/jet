// CLI-only parts of jetpack::Output: the first-acquisition gate over a
// resolved Provider download plan, and the adapter that feeds Store progress
// facts into a live region. Both need types above Foundation, so they extend
// the Foundation Theme, LiveRegion, and ByteProgress here.

impl Theme {
    // `env.dev: 2 new, 3 cached, 1 repaired · download 1.5 MB · on disk
    // 4.2 MB · about 3s`. A cached-only plan says `no download` and no time.
    fn render_download_summary(label: String, plan: DownloadPlan) -> String Never! {
        download :: if plan.download_bytes == {
            .Val(bytes) -> if bytes == 0 -> "no download" else -> "download {terminal_human_size(bytes)}"
            .None -> "download unknown"
        }
        disk :: if plan.disk_bytes == {
            .Val(bytes) -> terminal_human_size(bytes)
            .None -> "unknown"
        }
        estimate := ""
        if plan.estimated_seconds == .Val(seconds) {
            if plan.download_bytes != Val(0) -> estimate = " · about {terminal_human_duration(time.duration_ms(seconds * 1000))}"
        }
        "{label}: {plan.new} new, {plan.cached} cached, {plan.repaired} repaired · {download} · on disk {disk}{estimate}"
    }

    fn download_plan_table(self, plan: DownloadPlan) Never! -[IO, Time.Wait]> {
        self.detail("package                                  state     download   on disk")
        loop item in plan.items {
            state :: if item.state == {
                .New -> "new"
                .Cached -> "cached"
                .Repaired -> "repaired"
            }
            download :: if item.download_bytes == {
                .Val(bytes) -> terminal_human_size(bytes)
                .None -> "unknown"
            }
            disk :: if item.disk_bytes == {
                .Val(bytes) -> terminal_human_size(bytes)
                .None -> "unknown"
            }
            self.detail("{terminal_pad_end(item.package, 40)} {terminal_pad_end(state, 9)} {terminal_pad_end(download, 10)} {disk}")
        }
    }

    // Confirm the first acquisition for an environment. The closure is
    // already resolved, so the gate reports trusted plan facts before any
    // payload is fetched.
    fn confirm_download(self, label: String, plan: DownloadPlan, explain: Bool, assume_yes: Bool) -[IO, Time.Wait]> Bool Never! {
        summary :: Theme.render_download_summary(label, plan)
        if explain -> self.download_plan_table(plan)
        if assume_yes || plan.new + plan.repaired == 0 {
            self.status(summary)
            return true
        }
        if !term.stdin().is_terminal() {
            self.error_coded("E1340", "{summary} and cannot prompt here", "the environment needs package downloads and stdin is not a terminal to ask for confirmation", "pass -y to accept, or pre-warm with `jetpack env --prep -y`")
            return false
        }
        terminal_write_output("  {self.gutter()}  {summary} - Continue? [Y/n] ")
        answer :: term.readline() ?? {
            self.status("download cancelled.")
            return false
        }
        reply :: answer.trim().to_lower()
        apply :: reply == "" || reply == "y" || reply == "yes"
        if !apply -> self.status("download cancelled.")
        apply
    }
}

impl ByteProgress {
    // The Store progress sink that drives this ledger.
    fn handle(self) -> ProgressHandle Never! {
        progress :: self
        ProgressHandle{
            discovered_bytes: (bytes: Int) Never! -[IO, Env, Time.Wait]> { progress.discovered_bytes(bytes) },
            transferred_bytes: (bytes: Int) Never! -[IO, Env, Time.Wait]> { progress.transferred_bytes(bytes) },
            phase: (phase: String) Never! -[IO, Env, Time.Wait]> { progress.phase(phase) },
            object_progress: (done: Int, total: Int) Never! -[IO, Env, Time.Wait]> { progress.object_progress(done, total) },
        }
    }
}

impl LiveRegion {
    // The sink a provider reports byte and object progress through.
    fn progress_handle(self) -> ProgressHandle Never! {
        self.progress.handle()
    }
}
