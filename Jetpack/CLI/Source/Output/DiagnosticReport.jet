// The `jet.report/v3` projection of CLI diagnostics, ported from
// `Diagnostic::to_report(&file, "")`. Command `--json` failures put this
// report inside their `jet.status/v1` envelope. CLI diagnostics carry no
// source text, so no span becomes a line and column here.

// Rust `Diagnostic::error(code, what, why, fix, None).to_report(&ReportPath::from_process(""), "")`.
pub fn cli_diagnostic_report(code: String, what: String, why: String, fix: String) -[FS, Env]> ReportEnvelope Never! {
    cli_diagnostic_to_report(diagnostic_from_registry(code, None, what, why, fix), ReportPath.from_process(""))
}

// Rust `diagnostic.to_report(&file, "")`.
pub fn cli_diagnostic_to_report(diagnostic: Diagnostic, file: ReportPath) -> ReportEnvelope Never! {
    moment :: if diagnostic.moment == {
        .Compile -> "compile"
        .Run -> "run"
        .Test -> "test"
        .Tool -> "tool"
    }
    severity :: if diagnostic.severity == DIAGNOSTIC_ERROR -> "error" else -> "warning"
    report := ReportEnvelope.new(moment, severity, diagnostic.code, diagnostic.what, diagnostic.why, diagnostic.fix)
    if diagnostic.applicability == .Val(applicability) {
        report.applicability = Val(if applicability == {
            .Safe -> FixApplicability.Safe
            .Suggested -> FixApplicability.Suggested
        })
    }
    report.denial_kind = diagnostic.denial_kind
    report.call_chain = diagnostic.call_chain
    report.scope_chain = diagnostic.scope_chain
    report.nearest_granting_scope = diagnostic.nearest_granting_scope
    report.detail = diagnostic.detail
    if !file.is_empty() -> report.file = Val(file)
    if diagnostic.edit == .Val(edit) {
        safety :: diagnostic.safety ?? panic("diagnostic `{diagnostic.code}` has an edit without a safety grade")
        &report.push_fix_edit(ReportEdit.new(file, ReportSpan.new(edit.span.start, edit.span.end), edit.new_text, cli_report_fix_safety(safety))) ?? panic("a registry edit is valid for its report")
    }
    if diagnostic.no_fix_reason == .Val(reason) {
        kind :: if reason.kind == {
            .Behavior -> NoFixReasonKind.Behavior
            .Design -> NoFixReasonKind.Design
            .Ambiguous -> NoFixReasonKind.Ambiguous
        }
        &report.set_no_fix_reason(NoFixReason.new(kind, reason.next)) ?? panic("a registry no-fix reason is valid for its report")
    }
    loop cause in diagnostic.cause {
        projected := ReportCause.new(cause.code)
        if cause.span == .Val(span) -> projected.span = Val(ReportSpan.new(span.start, span.end))
        &report.cause.push(projected)
    }
    report
}

fn cli_report_fix_safety(safety: DiagnosticFixSafety) -> FixSafety Never! {
    if safety == {
        .Formatting -> FixSafety.Formatting
        .BehaviorPreserving -> FixSafety.BehaviorPreserving
        .ApiChanging -> FixSafety.ApiChanging
        .TargetChanging -> FixSafety.TargetChanging
        .NeedsReview -> FixSafety.NeedsReview
    }
}
