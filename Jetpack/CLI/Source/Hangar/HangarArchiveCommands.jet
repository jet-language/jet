// The one signed Hangar archive verbs, ported from
// jetpack::CLI::package_hangar_vendor (D-CLI-HANGAR1=B): export, import,
// dump, restore, copy, sign, and repair. Every mutating verb is
// plan-before-apply and every byte is content verified by the Store.

// An archive operation; `Verify` shares the archive result and error
// rendering but is dispatched as its own Hangar verb.
pub enum HangarArchiveAction {
    Export
    Import
    Dump
    Restore
    Copy
    Sign
    Repair
    Verify

    // The dispatched archive verbs (not `verify`).
    fn parse(word: String) -> HangarArchiveAction? Never! {
        if word == {
            "export" -> Val(HangarArchiveAction.Export)
            "import" -> Val(HangarArchiveAction.Import)
            "dump" -> Val(HangarArchiveAction.Dump)
            "restore" -> Val(HangarArchiveAction.Restore)
            "copy" -> Val(HangarArchiveAction.Copy)
            "sign" -> Val(HangarArchiveAction.Sign)
            "repair" -> Val(HangarArchiveAction.Repair)
            else -> None
        }
    }

    fn label(self) -> String Never! {
        if self == {
            .Export -> "export"
            .Import -> "import"
            .Dump -> "dump"
            .Restore -> "restore"
            .Copy -> "copy"
            .Sign -> "sign"
            .Repair -> "repair"
            .Verify -> "verify"
        }
    }
}

fn cli_hangar_archive(theme: Theme, parsed: CliParsed, action: HangarArchiveAction) -[IO, FS, Env, Time, Time.Wait]> Int Never! {
    roots :: pkg_resolve_roots()
    targets :: cli_positional_values_after(parsed, action.label())
    target :: if targets.len() == 0 -> String?{None} else -> Val(targets[0])
    key :: parsed.flags.archive_key
    if action == {
        .Export -> {
            entry :: target ?? return cli_hangar_archive_usage(theme, parsed, "`hangar export` needs an entry id, reference, or output digest", "jetpack hangar export <entry> --to <archive.hangar> --yes")
            destination :: parsed.flags.archive_to ?? return cli_hangar_archive_usage(theme, parsed, "`hangar export` needs `--to <archive.hangar>`", "write one signed archive, then import it on the target Hangar")
            if !cli_hangar_confirm_apply(theme, parsed, action.label()) -> return @EXIT_OK
            exported :: store_export_archive(roots, entry, !parsed.flags.archive_no_deps, key) ?? return cli_hangar_archive_error(theme, parsed, action, err)
            store_write_archive_file(destination, exported.bytes) ?? return cli_hangar_archive_error(theme, parsed, action, err)
            cli_hangar_archive_done(theme, parsed, action, exported.report)
        }
        .Import -> {
            source :: target ?? return cli_hangar_archive_usage(theme, parsed, "`hangar import` needs an archive path", "jetpack hangar import <archive.hangar> --yes")
            bytes :: store_read_archive_file(source) ?? return cli_hangar_archive_error(theme, parsed, action, err)
            if !cli_hangar_confirm_apply(theme, parsed, action.label()) -> return @EXIT_OK
            report :: store_import_archive(roots, bytes, key, parsed.flags.archive_allow_unsigned) ?? return cli_hangar_archive_error(theme, parsed, action, err)
            cli_hangar_archive_done(theme, parsed, action, report)
        }
        .Dump -> {
            if parsed.flags.json {
                return cli_hangar_report_error(
                    theme,
                    parsed,
                    "E1340",
                    "`hangar dump --json` cannot stream archive bytes",
                    "JSON mode reserves stdout for one `jet.report/v1` machine result.",
                    "omit `--json` when redirecting the signed archive, or use `export --json` for a status report."
                )
            }
            entry :: target ?? return cli_hangar_archive_usage(theme, parsed, "`hangar dump` needs an entry id or reference", "jetpack hangar dump <entry> > closure.hangar")
            exported :: store_export_archive(roots, entry, !parsed.flags.archive_no_deps, key) ?? return cli_hangar_archive_error(theme, parsed, action, err)
            term.stdout().write_bytes(exported.bytes) ?? return cli_hangar_archive_error(theme, parsed, action, StoreError.Io(err))
            @EXIT_OK
        }
        .Restore -> {
            bytes :: term.take(@STORE_MAX_ARCHIVE_BYTES + 1) ?? return cli_hangar_archive_error(theme, parsed, action, StoreError.Other("could not read archive from stdin: {err}"))
            if bytes.len() > @STORE_MAX_ARCHIVE_BYTES {
                return cli_hangar_archive_error(theme, parsed, action, StoreError.InvalidInput("archive from stdin exceeds the 1 GiB Hangar limit"))
            }
            if !cli_hangar_confirm_apply(theme, parsed, action.label()) -> return @EXIT_OK
            report :: store_import_archive(roots, bytes, key, parsed.flags.archive_allow_unsigned) ?? return cli_hangar_archive_error(theme, parsed, action, err)
            cli_hangar_archive_done(theme, parsed, action, report)
        }
        .Copy -> {
            entry :: target ?? return cli_hangar_archive_usage(theme, parsed, "`hangar copy` needs an entry id or reference", "jetpack hangar copy <entry> --to <hangar-root> --yes")
            destination :: parsed.flags.archive_to ?? return cli_hangar_archive_usage(theme, parsed, "`hangar copy` needs `--to <hangar-root>`", "copy uses the signed export/import backbone")
            if !cli_hangar_confirm_apply(theme, parsed, action.label()) -> return @EXIT_OK
            report :: store_copy_archive(roots, entry, destination, key) ?? return cli_hangar_archive_error(theme, parsed, action, err)
            cli_hangar_archive_done(theme, parsed, action, report)
        }
        .Sign -> {
            entry :: target ?? return cli_hangar_archive_usage(theme, parsed, "`hangar sign` needs an entry id or archive path", "jetpack hangar sign <entry-or-archive> [--to <path>] --yes")
            if !cli_hangar_confirm_apply(theme, parsed, action.label()) -> return @EXIT_OK
            report :: store_sign_archive(roots, entry, parsed.flags.archive_to, key) ?? return cli_hangar_archive_error(theme, parsed, action, err)
            cli_hangar_archive_done(theme, parsed, action, report)
        }
        .Repair -> {
            entry :: target ?? return cli_hangar_archive_usage(theme, parsed, "`hangar repair` needs an entry id or reference", "jetpack hangar repair <entry> --from <signed.hangar> --yes")
            if !cli_hangar_confirm_apply(theme, parsed, action.label()) -> return @EXIT_OK
            report :: store_repair_archive(roots, entry, parsed.flags.archive_from, key) ?? return cli_hangar_archive_error(theme, parsed, action, err)
            cli_hangar_archive_done(theme, parsed, action, report)
        }
        .Verify -> panic("verify is dispatched as its own Hangar verb")
    }
}

fn cli_hangar_archive_done(theme: Theme, parsed: CliParsed, action: HangarArchiveAction, report: HangarArchiveReport) -[IO, FS, Env]> Int Never! {
    if parsed.flags.json {
        print(report.json(action.label()))
    } else {
        signed :: if report.signed -> ", signed" else -> ""
        theme.status("{action.label()}: {report.objects} object(s), {cli_human_bytes(report.bytes)}{signed}")
    }
    @EXIT_OK
}

// A rejected ingest found by `verify` keeps its E1315 identity; every other
// archive failure is the E1340 Hangar operation failure.
fn cli_hangar_archive_error(theme: Theme, parsed: CliParsed, action: HangarArchiveAction, error: StoreError) -[IO, FS, Env]> Int Never! {
    message :: error.message()
    if action == HangarArchiveAction.Verify && message.starts_with("hangar ingest ") {
        return cli_hangar_report_error(theme, parsed, "E1315", message, message, "Fix the rejected tree (path law, special files, or unsupported xattrs) and ingest again.")
    }
    cli_hangar_report_error(theme, parsed, "E1340", "Hangar {action.label()} failed", message, "check the archive signature and paths, or retry from a verified source archive.")
}

fn cli_hangar_archive_usage(theme: Theme, parsed: CliParsed, what: String, fix: String) -[IO, FS, Env]> Int Never! {
    cli_hangar_report_error(theme, parsed, "E1340", what, "Hangar archive operations are plan-before-apply and content verified.", fix)
}
