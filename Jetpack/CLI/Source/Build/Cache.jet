// The action cache: input snapshots, output capture and restore, action
// records, and the no-follow file primitives under them. Ported 1:1 from
// crates/jet-comptime Build/{cache_cas,execution_runtime}.rs (the remote
// transport belongs to the unported remote builder; see Model.jet). The Rust
// openat/mkdirat/renameat FFI is the ratified Core directory handle
// whose relative opens refuse links.

// Host reads of build files (declared inputs, work-tree outputs, published
// outputs) are bounded: one file at most 512 MiB and one action's files at
// most 1 GiB together, checked against the opened file's size before any
// byte is read and enforced again while reading.
BUILD_MAX_ACTION_FILE_BYTES :: 536870912
BUILD_MAX_ACTION_TOTAL_BYTES :: 1073741824
BUILD_READ_CHUNK_BYTES :: 1048576

// Rust `io::Error`: the kind the cache decisions branch on, and the message
// `io_action` reports.
enum BuildIOKind {
    NotFound
    InvalidInput
    InvalidData
    PermissionDenied
    NotADirectory
    AlreadyExists
    Unsupported
    Other
}

#Error
struct BuildIOError {
    kind: BuildIOKind
    message: String

    fn new(kind: BuildIOKind, message: String) -> BuildIOError Never! {
        BuildIOError{kind, message}
    }

    // An operating-system error from Core, keeping its kind and text.
    fn from(error: IOError) -> BuildIOError Never! {
        kind :: if error == {
            .NotFound(_) -> BuildIOKind.NotFound
            .AlreadyExists(_) -> BuildIOKind.AlreadyExists
            .PermissionDenied(_) -> BuildIOKind.PermissionDenied
            .InvalidInput(_) -> BuildIOKind.InvalidInput
            .InvalidData(_) -> BuildIOKind.InvalidData
            else -> BuildIOKind.Other
        }
        BuildIOError{kind, message: "{error}"}
    }
}

struct ActionInputSnapshot {
    path: String
    digest: ContentDigest
    byte_len: Int
}

// One declared input as it was hashed: the snapshot the action key uses and
// the exact bytes the work tree receives, so execution never reads the input
// a second time.
struct ActionInputCapture {
    snapshot: ActionInputSnapshot
    bytes: [U8]
}

struct ActionOutputRecord {
    path: String
    digest: ContentDigest
    byte_len: Int
}

enum ActionOutcome {
    Succeeded(exit_code: Int)
    Failed(exit_code: Int)
    RestoredFromCache
}

enum CacheHitReason {
    LocalActionRecordMatched
    DeclaredOutputsRestored
}

enum CacheMissReason {
    NoLocalActionRecord
    ActionKeyChanged
    DeclaredOutputMissing
    CacheRecordInvalid
    CacheRestoreFailed
    RemoteDenied
    UncachedAction
    FrontEndIncomplete
}

enum ActionCacheStatus {
    Hit(CacheHitReason)
    Miss(CacheMissReason)
}

// A local action record (Rust `ActionResultRecord`). A failed record carries
// the structured report that reached the build edge; success never does.
struct ActionResultRecord {
    key: String
    outcome: ActionOutcome
    outputs: [ActionOutputRecord]
    failure_report: DiagnosticBuildError?
    status: ActionCacheStatus
}

// Rust `snapshot_declared_inputs`: every declared input read without
// following links, bounded, and published to the CAS. The captured bytes are
// the ones the work tree receives.
fn build_snapshot_declared_inputs(store: BuildArtifactStoreHandle, base: String, action: HermeticBuildAction) -[FS, Env, Exec, Time, Rand]> [ActionInputCapture] BuildIOError! {
    inputs := [ActionInputCapture]{}
    total := 0
    loop input in action.inputs {
        path :: build_resolve_under(base, input)
        bytes :: build_secure_read_file(base, path, build_read_budget(total))
        total += bytes.len()
        digest :: store.put_blob(bytes)
        &inputs.push(ActionInputCapture{snapshot: ActionInputSnapshot{path: input, digest, byte_len: bytes.len()}, bytes})
    }
    Ok(inputs)
}

// Rust `capture_declared_outputs`.
fn build_capture_declared_outputs(store: BuildArtifactStoreHandle, base: String, action: HermeticBuildAction, key: String, outcome: ActionOutcome, status: ActionCacheStatus) -[FS, Env, Exec, Time, Rand]> ActionResultRecord BuildIOError! {
    outputs := [ActionOutputRecord]{}
    total := 0
    loop output in action.outputs {
        path :: build_resolve_under(base, output)
        bytes :: build_secure_read_file(base, path, build_read_budget(total))
        total += bytes.len()
        digest :: store.put_blob(bytes)
        &outputs.push(ActionOutputRecord{path: output, digest, byte_len: bytes.len()})
    }
    Ok(ActionResultRecord{key, outcome, outputs, failure_report: None, status})
}

// The byte limit of the next file of one action after `used` bytes: the
// per-file limit, lowered to what remains of the per-action limit.
fn build_read_budget(used: Int) -> Int Never! {
    remaining :: BUILD_MAX_ACTION_TOTAL_BYTES - used
    if remaining < BUILD_MAX_ACTION_FILE_BYTES -> remaining else -> BUILD_MAX_ACTION_FILE_BYTES
}

// Rust `restore_action_outputs`: the record must name exactly the declared
// outputs, in order, before any byte is restored.
fn build_restore_action_outputs(store: BuildArtifactStoreHandle, base: String, action: HermeticBuildAction, record: ActionResultRecord) BuildIOError! -[FS, Env, Exec, Time, Rand]> {
    matches := record.outputs.len() == action.outputs.len()
    if matches {
        loop index in 0..<record.outputs.len() {
            if record.outputs[index].path != action.outputs[index] -> matches = false
        }
    }
    if !matches -> return Err(BuildIOError.new(.InvalidData, "cached output record does not exactly match action declarations"))
    loop output in record.outputs {
        path :: build_resolve_under(base, output.path)
        bytes :: store.get_blob(output.digest) ?? return Err(err)
        found :: bytes ?? return Err(BuildIOError.new(.NotFound, "CAS blob is missing"))
        build_atomic_restore_file(base, path, found)
    }
}

// `path` relative to `base` as its normal components (Rust `strip_prefix`
// then `Component::Normal`).
fn build_relative_components(base: String, path: String, escape: String) -> [String] BuildIOError! {
    relative := ""
    if path == base {
        relative = ""
    } else if path.starts_with("{base}/") {
        relative = path.removeprefix("{base}/")
    } else {
        return Err(BuildIOError.new(.InvalidInput, escape))
    }
    parts := [String]{}
    loop part in relative.split("/") {
        if part == "" || part == "." || part == ".." -> next
        &parts.push(part)
    }
    Ok(parts)
}

// Rust `secure_read_file_bounded`: open `base` as a real directory and walk
// every parent component without following links. The final name is
// inspected through the held parent without following a link and must be a
// regular file before it is opened; the open itself never waits on a FIFO or
// device peer (Core's non-blocking reader, the `jet self completions --for`
// pattern), and the opened file must be that same inode. Its size is checked
// against `limit` before any byte is read, and the read stops one byte past
// `limit`.
fn build_secure_read_file(base: String, path: String, limit: Int) -[FS]> [U8] BuildIOError! {
    parts :: build_relative_components(base, path, "cache path escapes root")
    if parts.len() == 0 -> return Err(BuildIOError.new(.InvalidInput, "cache path has no file name"))
    directory := files.open_directory(base) ?? return Err(BuildIOError.from(err))
    loop index in 0..<parts.len() - 1 {
        directory = directory.open_directory(parts[index]) ?? return Err(BuildIOError.from(err))
    }
    name :: parts[parts.len() - 1]
    entry :: directory.entry_stat(name) ?? return Err(BuildIOError.from(err))
    if entry.is_symlink || !entry.is_file -> return Err(BuildIOError.new(.PermissionDenied, "cache entry is not a regular file"))
    if entry.size > limit -> return Err(BuildIOError.new(.InvalidData, "cache entry exceeds its byte limit"))
    reader :: files.jet_std_files_open_reader_nonblocking(files.join(directory.path, name)) ?? return Err(BuildIOError.from(err))
    info :: reader.stat() ?? return Err(BuildIOError.from(err))
    if !info.is_file -> return Err(BuildIOError.new(.PermissionDenied, "cache entry is not a regular file"))
    if info.id != entry.id -> return Err(BuildIOError.new(.PermissionDenied, "cache entry changed while it was opened"))
    if info.size > limit -> return Err(BuildIOError.new(.InvalidData, "cache entry exceeds its byte limit"))
    bytes := [U8]{}
    loop bytes.len() <= limit {
        want :: limit + 1 - bytes.len()
        chunk :: reader.read(if want < BUILD_READ_CHUNK_BYTES -> want else -> BUILD_READ_CHUNK_BYTES) ?? return Err(BuildIOError.from(err))
        if chunk.len() == 0 -> break
        &bytes.extend(chunk)
    }
    if bytes.len() > limit -> return Err(BuildIOError.new(.InvalidData, "cache entry exceeds its byte limit"))
    Ok(bytes)
}

// Rust `atomic_restore_file`: walk (creating 0755) every parent without
// following links, write a fresh `.jet-restore-<nonce>` exclusively (0600),
// fsync it, then rename it over the final name inside the held directory.
fn build_atomic_restore_file(base: String, path: String, bytes: [U8]) BuildIOError! -[FS, Rand]> {
    parts :: build_relative_components(base, path, "build output escapes root")
    if parts.len() == 0 -> return Err(BuildIOError.new(.InvalidInput, "build output has no file name"))
    directory := files.open_directory(base) ?? return Err(BuildIOError.from(err))
    loop index in 0..<parts.len() - 1 {
        part :: parts[index]
        if directory.open_directory(part) == {
            .Ok(child) -> directory = child
            .Err(error) -> {
                if error != .NotFound(_) -> return Err(BuildIOError.from(error))
                if directory.create_directory(part, mode: Val(0o755)) == {
                    .Ok(_) -> {}
                    .Err(created) -> if created != .AlreadyExists(_) -> return Err(BuildIOError.from(created))
                }
                directory = directory.open_directory(part) ?? return Err(BuildIOError.from(err))
            }
        }
    }
    final_name :: parts[parts.len() - 1]
    loop {
        random_bytes :: random.bytes(16) ?? return Err(BuildIOError.new(.Other, "{err}"))
        temp_name :: ".jet-restore-{build_hex_encode(random_bytes)}"
        if directory.create(temp_name, if_exists: .Refuse, mode: Val(0o600)) == {
            .Ok(writer) -> {
                writer.write_all(bytes) ?? return Err(BuildIOError.from(err))
                writer.fsync() ?? return Err(BuildIOError.from(err))
                close(^writer)
                if directory.rename(temp_name, final_name) == {
                    .Ok(_) -> return
                    .Err(error) -> {
                        _ :: directory.remove(temp_name)
                        return Err(BuildIOError.from(error))
                    }
                }
            }
            .Err(error) -> if error != .AlreadyExists(_) -> return Err(BuildIOError.from(error))
        }
    }
}

// Rust `ensure_real_directory`: create a directory tree without ever
// following an existing link; `..` is refused.
fn build_ensure_real_directory(path: String) BuildIOError! -[FS]> {
    current := if path.starts_with("/") -> "/" else -> ""
    loop part in path.split("/") {
        if part == "" || part == "." -> next
        if part == ".." -> return Err(BuildIOError.new(.InvalidInput, "directory path contains `..`"))
        current = if current == "" -> part else -> files.join(current, part)
        build_ensure_real_directory_step(current, "directory path `{current}` is a symlink", "directory path `{current}` is not a directory", "directory path `{current}` is not a real directory")
    }
}

// One component of a no-follow directory walk: an existing link or
// non-directory is refused; a missing name is created, and a concurrent
// creator must have made a real directory.
fn build_ensure_real_directory_step(current: String, symlink: String, not_directory: String, not_real: String) BuildIOError! -[FS]> {
    if files.stat(current) == {
        .Ok(info) -> {
            if info.is_symlink -> return Err(BuildIOError.new(.PermissionDenied, symlink))
            if !info.is_dir -> return Err(BuildIOError.new(.NotADirectory, not_directory))
        }
        .Err(error) -> {
            if error != .NotFound(_) -> return Err(BuildIOError.from(error))
            if files.create_dir(current) == {
                .Ok(_) -> {}
                .Err(created) -> {
                    if created != .AlreadyExists(_) -> return Err(BuildIOError.from(created))
                    again :: files.stat(current) ?? return Err(BuildIOError.from(err))
                    if again.is_symlink || !again.is_dir -> return Err(BuildIOError.new(.PermissionDenied, not_real))
                }
            }
        }
    }
}

// Rust `prepare_output_destination`: every parent of `output` below `root`
// is a real directory (created when missing); a final link is removed so the
// restore never writes through it.
fn build_prepare_output_destination(root: String, output: String) BuildIOError! -[FS]> {
    parent :: files.dirname(output)
    parts :: build_relative_components(root, if parent == "" -> root else -> parent, "build output parent escapes project root")
    current := root
    loop part in parts {
        current = files.join(current, part)
        build_ensure_real_directory_step(current, "build output parent `{current}` is a symlink", "build output parent `{current}` is not a directory", "build output parent `{current}` is not a real directory")
    }
    if files.stat(output) == {
        .Ok(info) -> if info.is_symlink -> files.remove(output) ?? return Err(BuildIOError.from(err))
        .Err(_) -> {}
    }
}

fn build_hex_encode(bytes: [U8]) -> String Never! {
    digits :: "0123456789abcdef".bytes()
    out := [U8]{}
    loop byte in bytes {
        value :: Int.from_u8(byte)
        &out.push(digits[value >> 4])
        &out.push(digits[value.bit_and(15)])
    }
    String.from_bytes(out) ?? panic("hex digits are ASCII")
}

// Rust `hex_decode` (`RemoteCacheError::InvalidRecord` messages).
fn build_hex_decode(value: String) -> [U8] String! {
    raw :: value.bytes()
    if raw.len() % 2 != 0 -> return Err("hex field has odd length")
    out := [U8]{}
    index := 0
    loop index < raw.len() {
        high :: build_hex_digit(raw[index]) ?? return Err("hex field contains a non-hex digit")
        low :: build_hex_digit(raw[index + 1]) ?? return Err("hex field contains a non-hex digit")
        &out.push(U8{high * 16 + low})
        index += 2
    }
    Ok(out)
}

fn build_hex_digit(byte: U8) -> Int? Never! {
    code :: Int.from_u8(byte)
    if {
        code >= 48 && code <= 57 -> Val(code - 48)
        code >= 97 && code <= 102 -> Val(code - 87)
        code >= 65 && code <= 70 -> Val(code - 55)
        else -> None
    }
}

fn build_encode_outcome(outcome: ActionOutcome) -> String Never! {
    if outcome == {
        .Succeeded(exit_code) -> "succeeded:{exit_code}"
        .Failed(exit_code) -> "failed:{exit_code}"
        .RestoredFromCache -> "restored"
    }
}

fn build_parse_outcome(value: String) -> ActionOutcome BuildIOError! {
    if value == "restored" -> return Ok(ActionOutcome.RestoredFromCache)
    parts :: value.split_once(":") ?? return Err(BuildIOError.new(.InvalidData, "action record outcome is malformed"))
    exit_code :: build_parse_i32(parts.after) ?? return Err(BuildIOError.new(.InvalidData, "action record outcome exit code is not a number"))
    if parts.before == {
        "succeeded" -> Ok(ActionOutcome.Succeeded{exit_code})
        "failed" -> Ok(ActionOutcome.Failed{exit_code})
        else -> Err(BuildIOError.new(.InvalidData, "action record outcome is unknown"))
    }
}

// Rust `str::parse::<i32>`: optional sign, ASCII digits, in range.
fn build_parse_i32(text: String) -> Int? Never! {
    digits :: if text.starts_with("+") || text.starts_with("-") -> text.slice(1, text.len()) else -> text
    if digits == "" -> return None
    loop byte in digits.bytes() {
        code :: Int.from_u8(byte)
        if code < 48 || code > 57 -> return None
    }
    if digits.len() > 10 -> return None
    value :: Int.parse(text.removeprefix("+")) ?? return None
    if value < -2147483648 || value > 2147483647 -> return None
    Val(value)
}

// Rust `str::parse::<u64>`.
fn build_parse_u64(text: String) -> Int? Never! {
    if text == "" || text.len() > 20 -> return None
    loop byte in text.bytes() {
        code :: Int.from_u8(byte)
        if code < 48 || code > 57 -> return None
    }
    value :: Int.parse(text) ?? return None
    if value < 0 -> return None
    Val(value)
}

// Rust `write_action_record`.
fn build_write_action_record(store: BuildArtifactStoreHandle, key: String, record: ActionResultRecord) BuildIOError! -[FS, Env, Exec, Time, Rand]> {
    text := "{record.key}\noutcome={build_encode_outcome(record.outcome)}\n"
    if record.failure_report == .Val(report) -> text = "{text}failure={build_hex_encode(build_report_to_json(report).bytes())}\n"
    loop output in record.outputs -> text = "{text}{output.path}\t{output.digest.as_str()}\t{output.byte_len}\n"
    store.put_record(key, text.bytes())
}

fn build_cache_restore_miss_reason(error: BuildIOError) -> CacheMissReason Never! {
    if error.kind == {
        .NotFound -> CacheMissReason.DeclaredOutputMissing
        .InvalidData -> CacheMissReason.CacheRecordInvalid
        else -> CacheMissReason.CacheRestoreFailed
    }
}

// Rust `read_action_record`: the first line names the key; one outcome; a
// failure report exactly when the outcome failed, and then no outputs.
fn build_read_action_record(store: BuildArtifactStoreHandle, key: String) -[FS, Env, Exec, Time, Rand]> ActionResultRecord? BuildIOError! {
    stored :: store.get_record(key)
    bytes :: stored ?? return Ok(None)
    text :: String.from_bytes(bytes) ?? return Err(BuildIOError.new(.InvalidData, "action record is not UTF-8"))
    lines :: build_record_lines(text)
    if lines.len() == 0 || lines[0] != key -> return Err(BuildIOError.new(.InvalidData, "action record key does not match its cache path"))
    outcome := ActionOutcome?{None}
    failure_report := DiagnosticBuildError?{None}
    outputs := [ActionOutputRecord]{}
    loop index in 1..<lines.len() {
        line :: lines[index]
        if line.starts_with("outcome=") {
            if outcome != None -> return Err(BuildIOError.new(.InvalidData, "action record has duplicate outcome"))
            outcome = Val(build_parse_outcome(line.removeprefix("outcome=")))
            next
        }
        if line.starts_with("failure=") {
            value :: line.removeprefix("failure=")
            if failure_report != None || value == "" -> return Err(BuildIOError.new(.InvalidData, "action record has an invalid failure report"))
            decoded :: build_hex_decode(value) ?? return Err(BuildIOError.new(.InvalidData, err))
            report_text :: String.from_bytes(decoded) ?? return Err(BuildIOError.new(.InvalidData, "action failure report is not UTF-8"))
            report :: build_report_from_json(report_text) ?? return Err(BuildIOError.new(.InvalidData, "action failure report is invalid: {err}"))
            failure_report = Val(report)
            next
        }
        fields :: line.split("\t").to_list()
        if fields.len() != 3 -> return Err(BuildIOError.new(.InvalidData, "malformed action output record"))
        path :: build_path_new(fields[0]) ?? return Err(BuildIOError.new(.InvalidData, "malformed action output record"))
        digest :: ContentDigest.parse(fields[1]) ?? return Err(BuildIOError.new(.InvalidData, err.message))
        byte_len :: build_parse_u64(fields[2]) ?? return Err(BuildIOError.new(.InvalidData, "malformed action output record"))
        &outputs.push(ActionOutputRecord{path, digest, byte_len})
    }
    found :: outcome ?? return Err(BuildIOError.new(.InvalidData, "action record has no outcome"))
    failed :: if found == {
        .Failed(_) -> true
        else -> false
    }
    if failed != (failure_report != None) -> return Err(BuildIOError.new(.InvalidData, "failed action record and failure report disagree"))
    if failure_report != None && outputs.len() != 0 -> return Err(BuildIOError.new(.InvalidData, "failed action record contains outputs"))
    Ok(Val(ActionResultRecord{key, outcome: found, outputs, failure_report, status: ActionCacheStatus.Hit(.LocalActionRecordMatched)}))
}

// Rust `str::lines`: split on `\n`, drop one trailing empty line and a `\r`
// before each `\n`.
fn build_record_lines(text: String) -> [String] Never! {
    lines := [String]{}
    loop line in text.split("\n") {
        raw :: line.bytes()
        // A CR (13) before the LF belongs to the line ending.
        if raw.len() > 0 && Int.from_u8(raw[raw.len() - 1]) == 13 -> &lines.push(String.from_bytes(raw.slice(0, raw.len() - 1)) ?? line) else -> &lines.push(line)
    }
    if lines.len() > 0 && lines[lines.len() - 1] == "" -> _ := &lines.pop()
    lines
}

// Rust `record_comptime_cache_event`: opt-in proof evidence appended to
// `JET_COMPTIME_CACHE_OBSERVATION_PATH` when it is absolute and inside
// `$HOME/.cache`. A `.` or `..` component is refused, so the prefix check
// confines the path, and a final link is never followed. It never supplies
// or influences a cache decision.
fn build_record_cache_event(action: String, key: String, status: ActionCacheStatus, phase: String, outcome: ActionOutcome?) -[FS, Env]> {
    path :: sys.get("JET_COMPTIME_CACHE_OBSERVATION_PATH") ?? return
    home :: sys.get("HOME") ?? return
    allowed_root :: files.join(home, ".cache")
    if !path.starts_with("/") || !(path == allowed_root || path.starts_with("{allowed_root}/")) -> return
    loop part in path.split("/") {
        if part == "." || part == ".." -> return
    }
    labels :: if status == {
        .Hit(.LocalActionRecordMatched) -> (status: "hit", reason: "local_action_record_matched")
        .Hit(.DeclaredOutputsRestored) -> (status: "hit", reason: "declared_outputs_restored")
        .Miss(.NoLocalActionRecord) -> (status: "miss", reason: "no_local_action_record")
        .Miss(.ActionKeyChanged) -> (status: "miss", reason: "action_key_changed")
        .Miss(.DeclaredOutputMissing) -> (status: "miss", reason: "declared_output_missing")
        .Miss(.CacheRecordInvalid) -> (status: "miss", reason: "cache_record_invalid")
        .Miss(.CacheRestoreFailed) -> (status: "miss", reason: "cache_restore_failed")
        .Miss(.RemoteDenied) -> (status: "miss", reason: "remote_denied")
        .Miss(.UncachedAction) -> (status: "miss", reason: "uncached_action")
        .Miss(.FrontEndIncomplete) -> (status: "miss", reason: "front_end_incomplete")
    }
    rendered_outcome :: if outcome == {
        .Val(value) -> foundation_json_quote(build_encode_outcome(value))
        .None -> "null"
    }
    mode :: sys.get("JET_COMPTIME_MODE") ?? "unknown"
    operation_id :: sys.get("JET_COMPTIME_OPERATION_ID") ?? "unknown"
    payload :: "{{\"schema\":\"jet.comptime-cache-event.v1\",\"mode\":{foundation_json_quote(mode)},\"operation_id\":{foundation_json_quote(operation_id)},\"action\":{foundation_json_quote(action)},\"key\":{foundation_json_quote(key)},\"phase\":{foundation_json_quote(phase)},\"status\":{foundation_json_quote(labels.status)},\"reason\":{foundation_json_quote(labels.reason)},\"outcome\":{rendered_outcome}}}\n"
    parent :: files.dirname(path)
    if parent != "" -> _ := files.create_dir_all(parent)
    writer :: files.append(path, links: .Refuse) ?? return
    _ := writer.write_all(payload.bytes())
    _ := writer.flush()
}

// The `jet.err/v1` wire of one structured report (Rust
// `JetErrorReport::to_json`). The report type carries no origin frame, and
// the executor's reports never carry a journey, so neither field is written.
fn build_report_to_json(report: DiagnosticBuildError) -> String Never! {
    fields := [String]{"\"schema\":\"jet.err/v1\"", "\"message\":{foundation_json_quote(report.message)}"}
    code :: if report.code == {
        .Val(text) -> foundation_json_quote(text)
        .None -> "null"
    }
    &fields.push("\"code\":{code}")
    cause :: if report.causes.len() == {
        0 -> "null"
        1 -> build_report_to_json(report.causes[0])
        else -> {
            rendered :: loop item in report.causes -> build_report_to_json(item)
            "[{rendered.join(",")}]"
        }
    }
    &fields.push("\"cause\":{cause}")
    if report.typed_identity == .Val(identity) -> &fields.push("\"typed_identity\":{foundation_json_quote(identity)}")
    if report.context_frames.len() > 0 {
        frames :: loop frame in report.context_frames -> "{{\"text\":{foundation_json_quote(frame.text)},\"file\":{foundation_json_quote(frame.file)},\"line\":{frame.line}}}"
        &fields.push("\"context_frames\":[{frames.join(",")}]")
    }
    if report.conversion_history.len() > 0 {
        conversions :: loop conversion in report.conversion_history -> "{{\"source\":{foundation_json_quote(conversion.source)},\"target\":{foundation_json_quote(conversion.target)}}}"
        &fields.push("\"conversion_history\":[{conversions.join(",")}]")
    }
    if report.details == .Val(details) {
        detail_fields :: loop field in details.fields -> "{foundation_json_quote(field.name)}:{field.value}"
        span :: if details.source_span == {
            .Val(range) -> "{{\"start\":{range.start},\"end\":{range.end}}}"
            .None -> "null"
        }
        &fields.push("\"details\":{{\"variant\":{foundation_json_quote(details.variant)},\"fields\":{{{detail_fields.join(",")}}},\"source_span\":{span}}}")
    }
    "{{{fields.join(",")}}}"
}

// Rust `JetErrorReport::from_json`: decode the canonical wire and refuse any
// spelling `build_report_to_json` would not write back byte for byte.
fn build_report_from_json(text: String) -> DiagnosticBuildError String! {
    tree :: json.parse(text) ?? return Err("invalid error report: {err.reason}")
    report :: build_report_from_tree(tree)
    if build_report_to_json(report) != text -> return Err("error report is not canonical")
    Ok(report)
}

fn build_report_object(value: Dyn, name: String) -> [String: Dyn] String! {
    pkg_json_object(value) ?? return Err("error report {name} is not an object")
}

fn build_report_text(value: Dyn, name: String) -> String String! {
    pkg_json_text(value) ?? return Err("error report {name} is not text")
}

fn build_report_field(fields: [String: Dyn], name: String) -> Dyn String! {
    fields.get(name) ?? return Err("error report lacks {name}")
}

fn build_report_u32(value: Dyn, name: String) -> Int String! {
    if value == {
        .Int(number) -> if number >= 0 && number <= 4294967295 -> Ok(number) else -> Err("error report {name} is not a u32")
        else -> Err("error report {name} is not an integer")
    }
}

fn build_report_from_tree(value: Dyn) -> DiagnosticBuildError String! {
    fields :: build_report_object(value, "report")
    if build_report_text(build_report_field(fields, "schema"), "schema") != "jet.err/v1" -> return Err("unsupported error report schema")
    message :: build_report_text(build_report_field(fields, "message"), "message")
    code_value :: build_report_field(fields, "code")
    code :: if code_value == {
        .Null -> String?{None}
        else -> Val(build_report_text(code_value, "code"))
    }
    cause_value :: build_report_field(fields, "cause")
    causes := [DiagnosticBuildError]{}
    if cause_value == {
        .Null -> {}
        .Object(_) -> &causes.push(build_report_from_tree(cause_value))
        .Array(items) -> loop item in items -> &causes.push(build_report_from_tree(item))
        else -> return Err("error report cause is not null, an object, or an array")
    }
    typed_identity := String?{None}
    if fields.get("typed_identity") == .Val(identity) -> typed_identity = Val(build_report_text(identity, "typed_identity"))
    context_frames := [DiagnosticErrorContextFrame]{}
    if fields.get("context_frames") == .Val(raw) {
        items :: pkg_json_array(raw) ?? return Err("error report context_frames is not an array")
        loop item in items {
            frame :: build_report_object(item, "context frame")
            &context_frames.push(DiagnosticErrorContextFrame{
                text: build_report_text(build_report_field(frame, "text"), "context text"),
                file: build_report_text(build_report_field(frame, "file"), "context file"),
                line: build_report_u32(build_report_field(frame, "line"), "context line"),
            })
        }
    }
    // The executor's reports carry no origin or journey; a report that does
    // cannot be written back canonically and is refused.
    if fields.get("origin") != None || fields.get("source_journey") != None -> return Err("error report is not canonical")
    conversion_history := [DiagnosticErrorConversion]{}
    if fields.get("conversion_history") == .Val(raw) {
        items :: pkg_json_array(raw) ?? return Err("error report conversion_history is not an array")
        loop item in items {
            conversion :: build_report_object(item, "conversion")
            &conversion_history.push(DiagnosticErrorConversion{
                source: build_report_text(build_report_field(conversion, "source"), "conversion source"),
                target: build_report_text(build_report_field(conversion, "target"), "conversion target"),
            })
        }
    }
    details := DiagnosticErrorDetails?{None}
    if fields.get("details") == .Val(raw) {
        detail :: build_report_object(raw, "details")
        values :: build_report_field(detail, "fields")
        pairs :: if values == {
            .Object(entries) -> entries
            else -> { return Err("error report detail fields is not an object") }
        }
        detail_fields :: loop pair in pairs -> DiagnosticErrorField{name: pair.key, value: build_report_encode_value(pair.value)}
        span_value :: build_report_field(detail, "source_span")
        source_span := DiagnosticErrorSpan?{None}
        if span_value != .Null {
            span :: build_report_object(span_value, "source span")
            source_span = Val(DiagnosticErrorSpan{start: build_report_u32(build_report_field(span, "start"), "span start"), end: build_report_u32(build_report_field(span, "end"), "span end")})
        }
        details = Val(DiagnosticErrorDetails{variant: build_report_text(build_report_field(detail, "variant"), "detail variant"), fields: detail_fields, source_span})
    }
    Ok(DiagnosticBuildError{code, message, typed_identity, causes, context_frames, conversion_history, details})
}

// Rust `jet_error_json_encode_value`: one detail value back to JSON text.
fn build_report_encode_value(value: Dyn) -> String Never! {
    if value == {
        .Null -> "null"
        .Bool(flag) -> if flag -> "true" else -> "false"
        .Int(number) -> "{number}"
        .Text(text) -> foundation_json_quote(text)
        .Array(items) -> {
            rendered :: loop item in items -> build_report_encode_value(item)
            "[{rendered.join(",")}]"
        }
        .Object(pairs) -> {
            rendered :: loop pair in pairs -> "{foundation_json_quote(pair.key)}:{build_report_encode_value(pair.value)}"
            "{{{rendered.join(",")}}}"
        }
        else -> pkg_json_render(value)
    }
}

// Rust `JetErrorReport::render` on the stderr edge (no `--json` wire in this
// process): the E3015 entry report, the structured rows, and the More line.
// The executor's reports carry no journey, so no journey block is written.
fn build_report_render(report: DiagnosticBuildError) -> String Never! {
    row :: diagnostic_registry_row("E3015") ?? panic("registered entry error row is missing")
    message :: build_terminal_text(report.message)
    out := "Error [{row.code}]: {row.what.replace("{{msg}}", message)}\n Why: {row.why.replace("{{msg}}", message)}\n Fix: {row.fix.replace("{{msg}}", message)}\n"
    out = "{out}{build_report_render_rows(report, 0)}"
    "{out}More: jet-lang.dev/e/E3015\n"
}

fn build_report_render_rows(report: DiagnosticBuildError, depth: Int) -> String Never! {
    out := ""
    if depth == 0 {
        if report.code == .Val(code) -> out = "{out}error code: {build_terminal_text(code)}\n"
        if report.typed_identity == .Val(identity) -> out = "{out}type: {build_terminal_text(identity)}\n"
    } else {
        out = "{out}{build_indent(depth)}cause: {build_terminal_text(report.message)}"
        suffix :: if report.typed_identity == {
            .Val(identity) -> if report.code == {
                .Val(code) -> " (type: {build_terminal_text(identity)}; error code: {build_terminal_text(code)})"
                .None -> " (type: {build_terminal_text(identity)})"
            }
            .None -> if report.code == {
                .Val(code) -> " (error code: {build_terminal_text(code)})"
                .None -> ""
            }
        }
        out = "{out}{suffix}\n"
    }
    loop cause in report.causes -> out = "{out}{build_report_render_rows(cause, depth + 1)}"
    inner :: build_indent(depth + 1)
    loop frame in report.context_frames -> out = "{out}{inner}context ({build_terminal_text(frame.file)}:{frame.line}): {build_terminal_text(frame.text)}\n"
    loop conversion in report.conversion_history -> out = "{out}{inner}conversion: {build_terminal_text(conversion.source)} -> {build_terminal_text(conversion.target)}\n"
    if report.details == .Val(details) {
        out = "{out}{inner}variant: {build_terminal_text(details.variant)}\n"
        loop field in details.fields -> out = "{out}{inner}{build_terminal_text(field.name)}: {build_terminal_text(field.value)}\n"
        if details.source_span == .Val(span) -> out = "{out}{inner}source span: {span.start}..{span.end}\n"
    }
    out
}

fn build_indent(depth: Int) -> String Never! {
    out := ""
    loop _ in 0..<depth -> out = "{out}  "
    out
}

// Rust `jet_write_terminal_text`: `\n`, `\r`, `\t` short escapes; every other
// control scalar and U+2028/U+2029 as `\u{xxxx}`.
fn build_terminal_text(value: String) -> String Never! {
    out := ""
    loop scalar in value.chars() {
        text :: "{scalar}"
        code :: build_scalar_code(text)
        out = if {
            code == 10 -> "{out}\\n"
            code == 13 -> "{out}\\r"
            code == 9 -> "{out}\\t"
            code < 32 || (code >= 127 && code < 160) || code == 8232 || code == 8233 -> "{out}\\u{{{build_hex4(code)}}}"
            else -> "{out}{text}"
        }
    }
    out
}

// The Unicode scalar value of one UTF-8 encoded scalar.
fn build_scalar_code(text: String) -> Int Never! {
    raw :: text.bytes()
    first :: Int.from_u8(raw[0])
    if raw.len() == 1 -> return first
    if raw.len() == 2 -> return (first.bit_and(31) << 6) + Int.from_u8(raw[1]).bit_and(63)
    if raw.len() == 3 -> return (first.bit_and(15) << 12) + (Int.from_u8(raw[1]).bit_and(63) << 6) + Int.from_u8(raw[2]).bit_and(63)
    (first.bit_and(7) << 18) + (Int.from_u8(raw[1]).bit_and(63) << 12) + (Int.from_u8(raw[2]).bit_and(63) << 6) + Int.from_u8(raw[3]).bit_and(63)
}

// Rust `{:04x}`: lowercase hex, at least four digits.
fn build_hex4(value: Int) -> String Never! {
    digits :: "0123456789abcdef"
    out := ""
    rest := value
    loop rest > 0 {
        out = "{digits.slice(rest % 16, rest % 16 + 1)}{out}"
        rest = rest / 16
    }
    loop out.len() < 4 -> out = "0{out}"
    out
}
