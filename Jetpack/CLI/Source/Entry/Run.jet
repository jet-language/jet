// The jetpack process entry after the binary's hidden-protocol routing
// (Rust jetpack::run): open one diagnostic invocation, so repeated coded
// failures collapse into one card per root cause, run the verb, and flush
// the collected cards when the invocation closes.

fn cli_run(args: [String]) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    invocation :: terminal_begin_invocation()
    code :: cli_main(args, invocation)
    close(^invocation)
    code
}
