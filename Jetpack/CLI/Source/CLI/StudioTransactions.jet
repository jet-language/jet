    revision :: result.source_revision.as_deref().map(value -> JSON.quote(value)) ?? "null"
    changed :: if result.source_changed_after -> "true" else -> "false"
    "{{\"host\":{JSON.quote(context.host)},\"action\":{JSON.quote(result.action)},\"status\":{result.status},\"success\":{success},\"source_revision\":{revision},\"source_changed_after\":{changed},\"stdout\":{JSON.quote(result.stdout)},\"stderr\":{JSON.quote(result.stderr)}}}"
}
