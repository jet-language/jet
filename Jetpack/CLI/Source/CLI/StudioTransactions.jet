// Rust: crates/jetpack/src/CLI/studio_transactions.rs:1038
fn create_studio_source_snapshot_platform(context: &StudioContext, source: String) -> StudioSourceSnapshot Err! {
    // GATE #4483: dispatch on the selected target, not the compiler host.
    if selected_os() == "linux" {
        // Rust: crates/jetpack/src/CLI/studio_transactions.rs:994
        MFD_ALLOW_SEALING: U32 :: 0x0002
        // Rust: crates/jetpack/src/CLI/studio_transactions.rs:995
        F_ADD_SEALS: I32 :: 1033
        // Rust: crates/jetpack/src/CLI/studio_transactions.rs:996
        REQUIRED_SEALS: I32 :: 0x0001 | 0x0002 | 0x0004 | 0x0008
        // Rust: crates/jetpack/src/CLI/studio_transactions.rs:998
        // Rust: crates/jetpack/src/CLI/studio_transactions.rs:999
        // GATE #4494: canonical native memfd_create/fcntl, C string loan and owned File.
        name :: CString.new("jetos-studio-source-{studio_unique_id()}").map_err(_ -> "creating sealed Studio source name failed")?
        descriptor :: #Unsafe("C name stays live through memfd_create; returned fd is transferred once") {
            memfd_create(name.as_ptr(), MFD_ALLOW_SEALING)
        }
        if descriptor < 0 { return .Err("creating sealed Studio source failed: {Error.last_os_error()}") }
        file := #Unsafe("successful memfd descriptor is uniquely owned by the File") { fs.File.from_raw_fd(descriptor) }
        &file.write_all(source.as_bytes()).map_err(error -> "writing sealed Studio source failed: {error}")?
        file.sync_all().map_err(error -> "syncing sealed Studio source failed: {error}")?
        file.set_permissions(fs.Permissions.from_mode(0o400)).map_err(error -> "protecting sealed Studio source failed: {error}")?
        sealed :: #Unsafe("fcntl operates on the retained memfd with F_ADD_SEALS integer argument") {
            fcntl(file.as_raw_fd(), F_ADD_SEALS, REQUIRED_SEALS)
        }
        if sealed != 0 { return .Err("sealing Studio source failed: {Error.last_os_error()}") }
        metadata :: file.metadata().map_err(error -> "reading sealed Studio source metadata failed: {error}")?
        snapshot :: StudioSourceSnapshot{
            path: OSPath.from("/proc/self/fd/{file.as_raw_fd()}"), file: ^file, cleanup_dir: None,
            source_revision: studio_source_revision(source), identity: studio_snapshot_identity(&metadata)
        }
        snapshot.validate()?
        return .Ok(^snapshot)
    }
    parent :: context.config.parent() ?? OSPath.from(".")
    dir :: parent.join(".jetos-studio-snapshot-{studio_unique_id()}")
    dir_builder := fs.DirBuilder.new()
    if selected_family() == "unix" { &dir_builder.mode(0o700) }
    dir_builder.create(dir).map_err(error -> "creating protected Studio snapshot failed: {error}")?
    path :: dir.join("config.jet")
    result :: (() -> StudioSourceSnapshot Err! {
        options := fs.OpenOptions.new()
        &options.write(true).create_new(true)
        if selected_family() == "unix" { &options.mode(0o600) }
        file := options.open(path).map_err(error -> "creating protected Studio source failed: {error}")?
        &file.write_all(source.as_bytes()).map_err(error -> "writing protected Studio source failed: {error}")?
        file.sync_all().map_err(error -> "syncing protected Studio source failed: {error}")?
        metadata :: fs.metadata(path).map_err(error -> "reading protected Studio source metadata failed: {error}")?
        snapshot :: StudioSourceSnapshot{
            file: ^file, path: ^path, cleanup_dir: Val(dir.clone()), source_revision: studio_source_revision(source),
            identity: studio_snapshot_identity(&metadata)
        }
        snapshot.validate()?
        .Ok(^snapshot)
    })()
    if result.is_err() { _ :: fs.remove_dir_all(dir) }
    result
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:1089
fn run_studio_snapshot_command(context: &StudioContext, snapshot: &StudioSourceSnapshot, action: String, generation_name: String?, input_plan_revision: String?) -> StudioCommandResult Err! {
    snapshot.validate()?
    target :: "{snapshot.path.display()}@{context.host}"
    result :: run_studio_command_target(context, action, target, generation_name,
        Val(context.config.parent() ?? OSPath.from(".")), input_plan_revision)
    snapshot.validate()?
    result
}
// Rust: crates/jetpack/src/CLI/studio_transactions.rs:1110
fn run_studio_command_target(context: &StudioContext, action: String, target: String, generation_name: String?, source_base: OSPath?, input_plan_revision: String?) -> StudioCommandResult Err! {
    jet :: sibling_binary("jet") ?? return .Err("could not find sibling jet binary")
    cwd :: context.config.parent().map(path -> path.to_path_buf()) ?? OSPath.from(".")
    // GATE #4494: process execution, environment and descriptor inheritance use native std names.
    cmd := Command.new(jet)
    &cmd.arg("os").arg(action).arg(target).arg("--no-color")
    if action == "plan" || action == "proof" { &cmd.arg("--json") }
    if context.offline { &cmd.arg("--offline") }
    if source_base :: source_base { &cmd.env("JETOS_STUDIO_SOURCE_BASE", source_base) }
    if input_plan_revision :: input_plan_revision { &cmd.env("JETOS_STUDIO_INPUT_PLAN_SHA256", input_plan_revision) }
    if action == "build" || action == "switch" || (action == "proof" && generation_name.is_some()) {
        &cmd.arg("--name").arg(generation_name ?? "zz-studio-candidate")
    }
    if action == "switch" { &cmd.arg("--yes") }
    output :: &cmd.current_dir(cwd).output().map_err(error -> "running jet failed: {error}")?
    .Ok(StudioCommandResult{
        action: action.to_string(), status: output.status.code() ?? 1, success: output.status.success(),
        stdout: String.from_utf8_lossy(&output.stdout).into_owned(), stderr: String.from_utf8_lossy(&output.stderr).into_owned(),
        source_revision: None, source_changed_after: false
    })
}
