// Rust: crates/jetpack/src/CLI/studio_transactions.rs:1198
fn rebuild_studio_projection_from(context: &StudioContext, generation_data: OSPath) -> String Err! {
    check :: run_studio_command(context, "check")?
    if !check.success {
        detail := check.stderr.trim() // #4303
        return .Err("jet os check failed: {detail}")
    }
    plan :: run_studio_command(context, "plan")?
    if !plan.success {
        detail := plan.stderr.trim() // #4303
        return .Err("jet os plan failed: {detail}")
    }
    generation :: fs.read_to_string(generation_data).unwrap_or_else(_ -> "null")
    generations :: run_studio_command(context, "generations").map(result -> if result.success -> ^result.stdout else -> ^result.stderr).unwrap_or_default()
    current_source :: fs.read_to_string(context.config).unwrap_or_default()
    proof_revision :: context.proved_source.lock().ok().and_then(proved -> proved.clone())
        .filter(proved -> proved.source == current_source && proved.revision == SHA256.sha256_hex(current_source.as_bytes()))
        .map(proved -> ^proved.revision)
    plan_json := plan.stdout.trim() // #4303
    generation_json := generation.trim() // #4303
    state :: if proof_revision.is_some() -> "proved" else -> "unproved"
    revision :: proof_revision.as_deref().map(value -> JSON.quote(value)) ?? "null"
    projection :: "{{\"kind\":\"jetos-studio-projection\",\"source_truth\":\"live-checked-plan\",\"host\":{JSON.quote(context.host)},\"page_registry\":[{JetOS.studio_pages_json()}],\"system_plan\":{plan_json},\"proof_state\":{{\"state\":{JSON.quote(state)},\"source_revision\":{revision}}},\"generations\":{JSON.quote(generations)},\"generation_projection\":{generation_json}}}"
    live := context.live_projection.lock().map_err(_ -> "Studio live projection state is unavailable")?
    *live = Val(projection.clone())
    .Ok(^projection)
}
// Rust: crates/jetpack/src/CLI/studio_transactions.rs:1253
fn sibling_binary(name: String) -> OSPath? {
    current :: env.current_exe().ok()?
    dir :: current.parent()?
    direct :: dir.join(name)
    if direct.is_file() { return Val(^direct) }
    if selected_family() == "unix" {
        debug :: dir.parent()?.join(name)
        if debug.is_file() { return Val(^debug) }
    }
    Val(OSPath.from(name))
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:1270
fn apply_option_transaction(source: String, key: String, value: String) -> (String, Bool) Err! {
    lines := source.lines().map(line -> line.to_string()).collect<[String]>()
    in_options := false
    insert_at: USize? := None
    loop (idx, line) in lines.iter_mut().enumerate() {
        trimmed := line.trim_start() // #4303
        if trimmed.starts_with("options:") && trimmed.contains('[') {
            in_options = true
            continue
        }
        if in_options && trimmed.starts_with(']') {
            insert_at = Val(idx)
            break
        }
        if in_options && trimmed.starts_with("{key}:") {
            indent_len :: line.len() - trimmed.len()
            indent := line[0..<indent_len] // #4303
            trailing := trimmed.trim_end() // #4303
            comma :: if trailing.ends_with(',') -> "," else -> ""
            next :: "{indent}{key}: {value}{comma}"
            changed :: *line != next
            *line = ^next
            output := lines.join("\n")
            if source.ends_with('\n') { &output.push('\n') }
            return .Ok((^output, changed))
        }
    }
    idx :: insert_at ?? return .Err("Studio could not find an options block in config.jet")
    &lines.insert(idx, "            {key}: {value},")
    output := lines.join("\n")
    if source.ends_with('\n') { &output.push('\n') }
    .Ok((^output, true))
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:1317
fn source_diff(path: OSPath, before: String, after: String) -> String {
    if before == after { return "diff -- {path.display()}\n(no changes)\n" }
    diff := "diff --git a/{path.display()} b/{path.display()}\n--- a/{path.display()}\n+++ b/{path.display()}\n"
    before_lines :: before.lines().collect<[_]>()
    after_lines :: after.lines().collect<[_]>()
    width :: after_lines.len() + 1
    lcs := [USize].repeat(0, (before_lines.len() + 1) * width)
    loop old in (0..<before_lines.len()).rev() {
        loop new in (0..<after_lines.len()).rev() {
            lcs[old * width + new] = if before_lines[old] == after_lines[new] ->
                1 + lcs[(old + 1) * width + new + 1]
                else -> lcs[(old + 1) * width + new].max(lcs[old * width + new + 1])
        }
    }
    &diff.push_str("@@ -1,{before_lines.len()} +1,{after_lines.len()} @@\n")
    old := 0
    new := 0
    loop old < before_lines.len() || new < after_lines.len() {
        if old < before_lines.len() && new < after_lines.len() && before_lines[old] == after_lines[new] {
            &diff.push_str(" {before_lines[old]}\n")
            old += 1
            new += 1
        } else if new < after_lines.len() && (old == before_lines.len() || lcs[old * width + new + 1] >= lcs[(old + 1) * width + new]) {
            &diff.push_str("+{after_lines[new]}\n")
            new += 1
        } else {
            &diff.push_str("-{before_lines[old]}\n")
            old += 1
        }
    }
    ^diff
}
