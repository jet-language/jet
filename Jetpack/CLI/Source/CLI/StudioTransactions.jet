fn acquire_studio_source_file_lock(path: OSPath) -> StudioSourceFileLock Err! {
    if selected_family() != "unix" { return .Err("cross-process Studio source locks require Unix") }
    // Rust: crates/jetpack/src/CLI/studio_transactions.rs:1491
    O_NOFOLLOW: I32 :: 0x20000
    // Rust: crates/jetpack/src/CLI/studio_transactions.rs:1492
    LOCK_EX: I32 :: 2
    // Rust: crates/jetpack/src/CLI/studio_transactions.rs:1494
    // GATE #4494: real flock on a retained descriptor; descriptor close releases the lock.
    parent :: path.parent() ?? OSPath.from(".")
    name :: path.file_name().and_then(name -> name.to_str()) ?? "config.jet"
    lock_path :: parent.join(".{name}.studio.lock")
    if fs.symlink_metadata(lock_path).map(metadata -> metadata.file_type().is_symlink()).unwrap_or(false) {
        return .Err("Studio source lock path is a symlink")
    }
    file :: fs.OpenOptions.new().read(true).write(true).create(true).mode(0o600).custom_flags(O_NOFOLLOW)
        .open(lock_path).map_err(error -> "opening Studio source lock failed: {error}")?
    locked :: #Unsafe("flock operates on the live owned source lock descriptor with LOCK_EX") {
        flock(file.as_raw_fd(), LOCK_EX)
    }
