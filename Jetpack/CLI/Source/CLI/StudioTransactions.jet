// Rust: crates/jetpack/src/CLI/studio_transactions.rs:86
pub fn handle_studio_transaction(body: String, context: &StudioContext?) -> (String, String) {
    context :: context ?? return ("400 Bad Request", "{\"error\":\"missing Studio project context\"}")
    request :: studio_request(body) ?? return ("400 Bad Request", "{{\"error\":{JSON.quote(err)}}}")
    op :: studio_request_string(&request, "op") ?? ""
    if op == "session" {
        session_id :: studio_changeset_token("studio-session", studio_unique_id())
        return if context.sessions.lock() == {
            .Ok(sessions) -> {
                // Canonical StudioServer stores its session set as a keyed map.
                &sessions.insert(session_id.clone(), true)
                ("200 OK", "{{\"session_id\":{JSON.quote(session_id)}}}")
            }
            .Err(_) -> ("500 Internal Server Error", "{\"error\":\"Studio session state is unavailable\"}")
        }
    }
    session_id :: studio_request_string(&request, "session_id") ?? return (
        "401 Unauthorized", "{\"error\":\"Studio transaction requires a server-issued session\"}")
    valid_session :: context.sessions.lock().map(sessions -> sessions.contains_key(session_id)).unwrap_or(false)
    if !valid_session { return ("401 Unauthorized", "{\"error\":\"Studio session is not valid\"}") }
    if op == "status" { return studio_changeset_status(context, &request) }
    if op == "discard" { return studio_changeset_discard(context, &request) }
    if op == "apply" { return studio_changeset_apply(context, &request) }
    if op == "stage-rollback" { return studio_changeset_stage_rollback(context, &request) }
    if op != "set-option" { return ("400 Bad Request", "{\"error\":\"unsupported Studio transaction\"}") }
    key :: studio_request_string(&request, "key") ?? return ("400 Bad Request", "{\"error\":\"missing key\"}")
    value :: studio_request_string(&request, "value") ?? return ("400 Bad Request", "{\"error\":\"missing value\"}")
    if studio_request_bool(&request, "write") {
        return ("400 Bad Request", "{\"error\":\"direct Studio writes are disabled\",\"fix\":\"stage the edit, review the exact diff, then Apply the Changeset\"}")
    }
    // GATE #4494: mutex guards and file locks remain owned until scope exit.
    _source_write :: context.source_write.lock() ?? return ("500 Internal Server Error", "{\"error\":\"Studio source lock is unavailable\"}")
    _source_file_lock :: acquire_studio_source_file_lock(context.config) ?? return ("500 Internal Server Error", "{{\"error\":{JSON.quote(err)}}}")
    source :: fs.read_to_string(context.config) ?? {
        error :: "reading config failed: {err}"
        return ("500 Internal Server Error", "{{\"error\":{JSON.quote(error)},\"path\":{JSON.quote(context.config.display().to_string())}}}")
    }
    changeset := context.changeset.lock() ?? return ("500 Internal Server Error", "{\"error\":\"Studio changeset state is unavailable\"}")
    if staged :: changeset.as_ref() {
        if !studio_request_owns_changeset(&request, staged) { return studio_changeset_owner_conflict() }
        if staged.base_source != source {
            return ("409 Conflict", "{\"error\":\"config.jet changed after this Changeset was staged\",\"fix\":\"discard or review the Changeset against current source\"}")
        }
    }
    transaction_source :: changeset.as_ref().map(staged -> staged.next_source.as_str()) ?? source
    (next, changed) :: apply_option_transaction(transaction_source, key, value) ?? return ("400 Bad Request", "{{\"error\":{JSON.quote(err)}}}")
    if changed {
        staged := &changeset.get_or_insert_with(() -> StudioChangeSet{
            session_id: session_id.clone(), token: studio_changeset_token(source, session_id),
            base_revision: studio_source_revision(source), base_source: source.clone(),
            next_source: source.clone(), changes: []
        })
        staged.next_source = ^next
        &staged.changes.push(StudioChange{op: "set-option", key: key.clone(), value: value.clone()})
    }
    response :: studio_changeset_response(context, if changeset.is_some() -> "staged" else -> "empty", changed, false, changeset.as_ref())
    ("200 OK", response)
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:266
fn studio_changeset_status(context: &StudioContext, request: &[(String, DataTree)]) -> (String, String) {
    if context.changeset.lock() == {
        .Ok(changeset) -> {
            if staged :: changeset.as_ref() {
                if !studio_request_owns_changeset(request, staged) { return studio_changeset_owner_conflict() }
            }
            ("200 OK", studio_changeset_response(context, if changeset.is_some() -> "staged" else -> "empty", changeset.is_some(), false, changeset.as_ref()))
        }
        .Err(_) -> ("500 Internal Server Error", "{\"error\":\"Studio changeset state is unavailable\"}")
    }
}
// Rust: crates/jetpack/src/CLI/studio_transactions.rs:299
fn studio_changeset_discard(context: &StudioContext, request: &[(String, DataTree)]) -> (String, String) {
    if context.changeset.lock() == {
        .Ok(changeset) -> {
            if staged :: changeset.as_ref() {
                if !studio_request_owns_changeset(request, staged) { return studio_changeset_owner_conflict() }
            }
            changed :: changeset.is_some()
            *changeset = None
            ("200 OK", studio_changeset_response(context, "discarded", changed, false, None))
        }
        .Err(_) -> ("500 Internal Server Error", "{\"error\":\"Studio changeset state is unavailable\"}")
    }
}
// Rust: crates/jetpack/src/CLI/studio_transactions.rs:324
fn studio_changeset_apply(context: &StudioContext, request: &[(String, DataTree)]) -> (String, String) {
    _source_write :: context.source_write.lock() ?? return ("500 Internal Server Error", "{\"error\":\"Studio source lock is unavailable\"}")
    _source_file_lock :: acquire_studio_source_file_lock(context.config) ?? return ("500 Internal Server Error", "{{\"error\":{JSON.quote(err)}}}")
    changeset := context.changeset.lock() ?? return ("500 Internal Server Error", "{\"error\":\"Studio changeset state is unavailable\"}")
    staged :: changeset.as_ref() ?? return ("409 Conflict", "{\"error\":\"no staged Changeset to apply\"}")
    if !studio_request_owns_changeset(request, staged) { return studio_changeset_owner_conflict() }
    current :: fs.read_to_string(context.config) ?? {
        error :: "reading config failed: {err}"
        return ("500 Internal Server Error", "{{\"error\":{JSON.quote(error)}}}")
    }
    if current != staged.base_source || studio_source_revision(current) != staged.base_revision {
        return ("409 Conflict", "{\"error\":\"config.jet changed after this Changeset was staged\",\"fix\":\"discard or review the Changeset against current source\"}")
    }
    receipt :: atomic_write_studio_source_if_revision(context.config, staged.next_source, staged.base_revision) ?? {
        status :: if err.starts_with("source revision changed") -> "409 Conflict" else -> "500 Internal Server Error"
        error :: "applying Changeset failed: {err}"
        return (status, "{{\"error\":{JSON.quote(error)},\"reprojected\":false}}")
    }
    if rebuild_studio_projection(context) == {
        .Ok(_) -> {}
        .Err(error) -> {
            restore :: if receipt.matches(context.config) -> atomic_write_studio_source_if_revision(context.config, staged.base_source, receipt.revision).map(_ -> ())
                else -> .Err("source changed after Studio rename; external content preserved")
            _ :: rebuild_studio_projection(context)
            restored :: if restore.is_ok() -> "true" else -> "false"
            return ("422 Unprocessable Entity", "{{\"error\":{JSON.quote(error)},\"restored\":{restored},\"reprojected\":false}}")
        }
    }
    if receipt.matches(context.config) {
        // GATE #4494: real native sleep, preserving the original post-rename window.
        thread.sleep(Duration.from_millis(100))
    }
    if !receipt.matches(context.config) {
        return ("409 Conflict", "{\"error\":\"config.jet changed during Apply; external content was preserved\",\"reprojected\":false}")
    }
    if context.last_applied.lock() == {
        .Ok(applied) -> *applied = Val(StudioAppliedChange{before_source: staged.base_source.clone(), after_source: staged.next_source.clone()})
        .Err(_) -> {}
    }
    if context.proved_source.lock() == {
        .Ok(proved) -> *proved = None
        .Err(_) -> {}
    }
    *changeset = None
    ("200 OK", studio_changeset_response(context, "applied", true, true, None))
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:447
fn studio_changeset_stage_rollback(context: &StudioContext, request: &[(String, DataTree)]) -> (String, String) {
    _source_write :: context.source_write.lock() ?? return ("500 Internal Server Error", "{\"error\":\"Studio source lock is unavailable\"}")
    applied_guard :: context.last_applied.lock() ?? return ("500 Internal Server Error", "{\"error\":\"Studio rollback state is unavailable\"}")
    applied :: applied_guard.as_ref() ?? return ("409 Conflict", "{\"error\":\"no applied source Changeset is available to roll back\"}")
    current :: fs.read_to_string(context.config) ?? {
        error :: "reading config failed: {err}"
        return ("500 Internal Server Error", "{{\"error\":{JSON.quote(error)}}}")
    }
    if current != applied.after_source {
        return ("409 Conflict", "{\"error\":\"config.jet changed after the last applied Changeset\",\"fix\":\"review current source before staging a rollback\"}")
    }
    changeset := context.changeset.lock() ?? return ("500 Internal Server Error", "{\"error\":\"Studio changeset state is unavailable\"}")
    if changeset.is_some() { return ("409 Conflict", "{\"error\":\"discard or apply the current Changeset before staging rollback\"}") }
    session_id :: studio_request_string(request, "session_id") ?? ""
    *changeset = Val(StudioChangeSet{
        session_id: session_id.clone(), token: studio_changeset_token(current, session_id),
        base_revision: studio_source_revision(current), base_source: ^current,
        next_source: applied.before_source.clone(),
        changes: [StudioChange{op: "restore-source", key: "config.jet", value: "previous applied source"}]
    })
    ("200 OK", studio_changeset_response(context, "staged", true, false, changeset.as_ref()))
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:528
fn studio_changeset_response(context: &StudioContext, state: String, changed: Bool, reprojected: Bool, changeset: &StudioChangeSet?) -> String {
    (count, token, base_revision, diff, source, edits) :: if changeset == {
        .Val(staged) -> {
            edits :: staged.changes.iter().map(change ->
                "{{\"op\":{JSON.quote(change.op)},\"key\":{JSON.quote(change.key)},\"value\":{JSON.quote(change.value)}}}"
            ).collect<[String]>().join(",")
            (staged.changes.len(), staged.token.clone(), staged.base_revision.clone(),
                source_diff(context.config, staged.base_source, staged.next_source), staged.next_source.clone(), edits)
        }
        .None -> (0, "", "", "", "", "")
    }
    changed_json :: if changed -> "true" else -> "false"
    staged_count :: if state == "applied" -> 0 else -> count
    token_json :: if token.is_empty() -> "null" else -> JSON.quote(token)
    revision_json :: if base_revision.is_empty() -> "null" else -> JSON.quote(base_revision)
    reprojected_json :: if reprojected -> "true" else -> "false"
    "{{\"host\":{JSON.quote(context.host)},\"path\":{JSON.quote(context.config.display().to_string())},\"state\":{JSON.quote(state)},\"write\":false,\"changed\":{changed_json},\"staged_count\":{staged_count},\"token\":{token_json},\"base_revision\":{revision_json},\"reprojected\":{reprojected_json},\"diff\":{JSON.quote(diff)},\"source\":{JSON.quote(source)},\"edits\":[{edits}]}}"
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:584
fn atomic_write_studio_source_if_revision(path: OSPath, source: String, expected_revision: String) -> StudioSourceWriteReceipt Err! {
    parent :: path.parent() ?? OSPath.from(".")
    name :: path.file_name().and_then(name -> name.to_str()) ?? "config.jet"
    temp :: parent.join(".{name}.studio-{studio_unique_id()}.tmp")
    result :: (() -> StudioSourceWriteReceipt Err! {
        // GATE #4494: std file operations retain native descriptors and original creation mode.
        options := fs.OpenOptions.new()
        &options.write(true).create_new(true)
        if selected_family() == "unix" {
            metadata :: fs.metadata(path).map_err(error -> error.to_string())?
            &options.mode(metadata.permissions().mode())
        }
        file := options.open(temp).map_err(error -> error.to_string())?
        &file.write_all(source.as_bytes()).map_err(error -> error.to_string())?
        file.sync_all().map_err(error -> error.to_string())?
        current :: fs.read(path).map_err(error -> error.to_string())?
        current_revision :: SHA256.sha256_hex(&current)
        if current_revision != expected_revision {
            return .Err("source revision changed: expected {expected_revision}, found {current_revision}")
        }
        fs.rename(temp, path).map_err(error -> error.to_string())?
        if fs.File.open(parent) == {
            .Ok(parent_dir) -> _ :: parent_dir.sync_all()
            .Err(_) -> {}
        }
        metadata :: fs.metadata(path).map_err(error -> error.to_string())?
        .Ok(StudioSourceWriteReceipt{identity: studio_snapshot_identity(&metadata), revision: studio_source_revision(source)})
    })()
    if result.is_err() { _ :: fs.remove_file(temp) }
    result
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:632
pub fn handle_studio_run(body: String, context: &StudioContext?) -> (String, String) {
    context :: context ?? return ("400 Bad Request", "{\"error\":\"missing Studio project context\"}")
    request :: studio_request(body) ?? return ("400 Bad Request", "{{\"error\":{JSON.quote(err)}}}")
    action :: studio_request_string(&request, "action") ?? return ("400 Bad Request", "{\"error\":\"missing action\"}")
    if !["check", "plan", "build", "proof", "switch", "generations"].contains(action) {
        return ("400 Bad Request", "{\"error\":\"unsupported Studio run action\"}")
    }
    if ["build", "proof", "switch"].contains(action) && context.changeset.lock().map(changeset -> changeset.is_some()).unwrap_or(true) {
        return ("409 Conflict", "{\"error\":\"apply or discard the staged Changeset before build, proof, or switch\"}")
    }
    command :: if action == "proof" -> run_studio_proof_action(context)
        else if action == "switch" -> run_studio_switch_action(context)
        else -> run_studio_command(context, action)
    result :: command ?? {
        refresh_studio_projection(context)
        status :: if err.starts_with("current config.jet has no matching") -> "409 Conflict" else -> "500 Internal Server Error"
        return (status, "{{\"error\":{JSON.quote(err)}}}")
    }
    refresh_studio_projection(context)
    ("200 OK", studio_command_json(context, &result))
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:699
fn run_studio_proof_action(context: &StudioContext) -> StudioCommandResult Err! {
    _source_write :: context.source_write.lock().map_err(_ -> "Studio source lock is unavailable")?
    _source_file_lock :: acquire_studio_source_file_lock(context.config)?
    if context.proved_source.lock() == {
        .Ok(proved) -> *proved = None
        .Err(_) -> {}
    }
    captured :: fs.read_to_string(context.config).map_err(error -> "reading config failed: {error}")?
    source_revision :: studio_source_revision(captured)
    snapshot :: create_studio_source_snapshot(context, captured)?
    plan := run_studio_snapshot_command(context, &snapshot, "plan", None, None)?
    if !plan.success {
        plan.action = "proof"
        plan.source_revision = Val(^source_revision)
        return .Ok(^plan)
    }
    plan_text := plan.stdout.trim() // #4303
    input_plan_revision :: studio_source_revision(plan_text)
    unique :: studio_unique_id()
    prefix := unique[0..<16] // #4303
    generation_name :: "zz-studio-proof-{prefix}"
    build := run_studio_snapshot_command(context, &snapshot, "build", Val(generation_name), Val(input_plan_revision))?
    if !build.success {
        build.action = "proof"
        build.source_revision = Val(^source_revision)
        return .Ok(^build)
    }
    result := run_studio_snapshot_command(context, &snapshot, "proof", Val(generation_name), None)?
    result.source_revision = Val(source_revision.clone())
    artifact :: if result.success -> {
        if validate_studio_proof_artifact(result.stdout, source_revision, input_plan_revision) == {
            .Ok(artifact) -> Val(^artifact)
            .Err(error) -> {
                result.success = false
                result.status = 3
                result.stderr = ^error
                None
            }
        }
    } else -> None
    unchanged :: fs.read_to_string(context.config).map(source -> source == captured).unwrap_or(false)
    result.source_changed_after = !unchanged
    if result.success && unchanged {
        if artifact :: artifact {
            if context.proved_source.lock() == {
                .Ok(proved) -> *proved = Val(StudioProvedSource{
                    source: ^captured, revision: ^source_revision, plan_revision: ^input_plan_revision,
                    artifact_plan_revision: ^artifact.plan_revision, generation: ^artifact.generation,
                    generation_path: ^artifact.path
                })
                .Err(_) -> {}
            }
        }
    } else if !unchanged {
        result.success = false
        result.status = 3
        result.stderr = "config.jet changed while proof was running; proof was not bound"
    }
    .Ok(^result)
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:773
fn run_studio_switch_action(context: &StudioContext) -> StudioCommandResult Err! {
    _source_write :: context.source_write.lock().map_err(_ -> "Studio source lock is unavailable")?
    _source_file_lock :: acquire_studio_source_file_lock(context.config)?
    current :: fs.read_to_string(context.config).unwrap_or_default()
    current_identity :: fs.metadata(context.config).map(metadata -> studio_snapshot_identity(&metadata))
        .map_err(error -> "reading config.jet metadata failed: {error}")?
    proved :: context.proved_source.lock().ok().and_then(proved -> proved.clone())
        .ok_or_else(() -> "current config.jet has no matching successful proof; build and prove this exact source before switching")?
    if current != proved.source || studio_source_revision(current) != proved.revision {
        return .Err("current config.jet has no matching successful proof; build and prove this exact source before switching")
    }
    validate_studio_generation_binding(&proved)?
    snapshot :: create_studio_source_snapshot(context, proved.source)?
    plan :: run_studio_snapshot_command(context, &snapshot, "plan", None, None)?
    plan_text := plan.stdout.trim() // #4303
    if !plan.success || studio_source_revision(plan_text) != proved.plan_revision {
        return .Err("current config.jet plan no longer matches its successful proof; prove again before switching")
    }
    previous_generation :: studio_current_generation_name()
    result := run_studio_snapshot_command(context, &snapshot, "switch", Val(proved.generation), None)?
    result.source_revision = Val(^proved.revision)
    source_unchanged :: fs.read_to_string(context.config).map(source -> source == proved.source).unwrap_or(false)
        && fs.metadata(context.config).map(metadata -> studio_snapshot_identity(&metadata) == current_identity).unwrap_or(false)
    result.source_changed_after = !source_unchanged
    if !source_unchanged {
        rollback :: previous_generation.as_deref().map(name -> run_studio_generation_rollback(context, name)).transpose()
        result.success = false
        result.status = 3
        result.stderr = if rollback == {
            .Ok(.Val(rollback)) -> {
                if rollback.success -> "config.jet changed during switch; proved generation activation was rolled back"
                else -> {
                    detail := rollback.stderr.trim() // #4303
                    "config.jet changed during switch; rollback failed: {detail}"
                }
            }
            .Ok(.None) -> "config.jet changed during switch; no previous generation was available for rollback"
            .Err(error) -> "config.jet changed during switch; rollback failed: {error}"
        }
    }
    .Ok(^result)
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:837
fn validate_studio_generation_binding(proved: &StudioProvedSource) -> () Err! {
    source_proof :: fs.read_to_string(proved.generation_path.join("source-proof.json"))
        .map_err(error -> "reading proved generation source proof failed: {error}")?
    parsed :: JSON.parse(source_proof).map_err(error -> "proved generation source proof is invalid: {error}")?
    fields :: if parsed == {
        .Object(fields) -> fields
        _ -> return .Err("proved generation source proof is not an object")
    }
    string :: (name: String) -> fields.iter().find_map((key, value) -> if key == name -> value.as_str().ok() else -> None)
    plan :: fs.read(proved.generation_path.join("plan.json")).map_err(error -> "reading proved generation plan failed: {error}")?
    if string("source_sha256") != Val(proved.revision.as_str())
        || string("input_plan_sha256") != Val(proved.plan_revision.as_str())
        || string("plan_sha256") != Val(proved.artifact_plan_revision.as_str())
        || SHA256.sha256_hex(&plan) != proved.artifact_plan_revision
        || proved.generation_path.file_name().and_then(name -> name.to_str()) != Val(proved.generation.as_str()) {
        return .Err("proved generation source or plan binding changed")
    }
    .Ok(())
}
// Rust: crates/jetpack/src/CLI/studio_transactions.rs:867
fn invalidate_studio_projection(context: &StudioContext) -> {
    if context.live_projection.lock() == {
        .Ok(projection) -> *projection = None
        .Err(_) -> {}
    }
}
// Rust: crates/jetpack/src/CLI/studio_transactions.rs:873
fn refresh_studio_projection(context: &StudioContext) -> {
    invalidate_studio_projection(context)
    _ :: rebuild_studio_projection(context)
}

// Rust: crates/jetpack/src/CLI/studio_transactions.rs:878
fn validate_studio_proof_artifact(proof: String, source_revision: String, input_plan_revision: String) -> StudioProofArtifact Err! {
    proof_text := proof.trim() // #4303
    parsed :: JSON.parse(proof_text).map_err(error -> "generation proof JSON is invalid: {error}")?
    root :: if parsed == {
        .Object(root) -> root
        _ -> return .Err("generation proof is not a JSON object")
    }
    source_proof :: if studio_tree_value(&root, "source_proof") == {
        .Val(.Object(source_proof)) -> source_proof
        _ -> return .Err("generation proof is missing source_proof")
    }
    field :: (name: String) -> source_proof.iter().find_map((key, value) -> if key == name -> value.as_str().ok() else -> None)
    if field("source_sha256") != Val(source_revision) { return .Err("generation proof source hash does not match captured config.jet") }
    if field("input_plan_sha256") != Val(input_plan_revision) { return .Err("generation proof input plan hash does not match captured plan") }
    plan :: if studio_tree_value(&root, "plan") == {
        .Val(.Text(plan)) -> plan
        _ -> return .Err("generation proof is missing its plan artifact")
    }
    artifact_plan_revision :: studio_source_revision(plan)
    if field("plan_sha256") != Val(artifact_plan_revision.as_str()) { return .Err("generation proof plan hash does not match its plan artifact") }
    generation :: if studio_tree_value(&root, "generation") == {
        .Val(.Text(value)) -> value.clone()
        _ -> return .Err("generation proof is missing its generation ID")
    }
    path :: if studio_tree_value(&root, "path") == {
        .Val(.Text(value)) -> OSPath.from(value)
        _ -> return .Err("generation proof is missing its generation path")
    }
    .Ok(StudioProofArtifact{generation: ^generation, path: ^path, plan_revision: ^artifact_plan_revision})
}

