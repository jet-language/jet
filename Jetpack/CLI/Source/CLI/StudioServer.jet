use jetpack.CLI.parse.[Parsed]
use jetpack.CLI.StudioTransactions.[handle_studio_run, handle_studio_transaction, studio_live_projection, StudioAppliedChange, StudioChangeSet, StudioProvedSource]
use jetpack.Output.[Theme]
use jetpack.[Syntax]
use jetpack.TrustRoot.[os_random_bytes]
use std.[fs, thread]
use std.net.[IpAddr, SocketAddr, TcpListener, TcpStream]
use std.sync.[Arc, Mutex, mpsc]
use std.io.[Error, ErrorKind]
use std.time.[Duration, Instant]
use std.process.[Command]

// Rust: crates/jetpack/src/CLI/studio_server.rs:12
// GATE #4494: canonical native mutex guards, scoped threads and sockets.
pub struct StudioContext {
    pub config: OSPath
    pub host: String
    pub offline: Bool
    pub session_secret: String
    pub source_write: Mutex<()>
    pub sessions: Mutex<[String: Bool]>
    pub changeset: Mutex<StudioChangeSet?>
    pub last_applied: Mutex<StudioAppliedChange?>
    pub live_projection: Mutex<String?>
    pub proved_source: Mutex<StudioProvedSource?>
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:25
STUDIO_IO_TIMEOUT :: Duration.from_secs(10)
// Rust: crates/jetpack/src/CLI/studio_server.rs:26
STUDIO_WORKER_COUNT: USize :: 4
// Rust: crates/jetpack/src/CLI/studio_server.rs:27
STUDIO_CONNECTION_QUEUE: USize :: 4

// Rust: crates/jetpack/src/CLI/studio_server.rs:29
pub fn studio_host(parsed: Parsed) -> String? { parsed.flags.studio_host }

// Rust: crates/jetpack/src/CLI/studio_server.rs:33
pub fn studio_context(parsed: Parsed) -> StudioContext? {
    project :: parsed.positional.iter().find(arg -> !arg.starts_with("-")).map(arg -> OSPath.from(arg)) ?? OSPath.from(".")
    config :: if project.is_dir() -> project.join(Syntax.CONFIG_FILE) else -> project
    secret :: studio_session_secret() ?? return None
    Val(StudioContext{
        config: config, host: studio_host(parsed) ?? "host", offline: parsed.flags.offline,
        session_secret: secret, source_write: Mutex.new(()), sessions: Mutex.new([String: Bool]{}),
        changeset: Mutex.new(None), last_applied: Mutex.new(None),
        live_projection: Mutex.new(None), proved_source: Mutex.new(None)
    })
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:62
pub fn serve_studio(theme: Theme, addr: String, app: OSPath, meta: OSPath, data: OSPath, context: &StudioContext?, open_browser: Bool) -> Int {
    context :: context ?? {
        theme.error("jetos Studio could not start its secure service", "the operating system did not provide a secure session secret", "retry `jetos studio` after restoring the OS random source.")
        return 2
    }
    listener :: TcpListener.bind(addr) ?? {
        theme.error("jetos Studio could not bind the local service", "binding `{addr}` failed: {err}", "choose a free loopback address, for example `--serve 127.0.0.1:7417`.")
        return 2
    }
    local_addr :: listener.local_addr() ?? {
        theme.error("jetos Studio could not start its secure service", "reading the bound address failed: {err}", "retry `jetos studio --serve`.")
        return 2
    }
    url :: "http://{local_addr}/studio/?session={context.session_secret}"
    println(url)
    theme.ok("Jetos Studio Service Listening")
    if open_browser {
        if Command.new("xdg-open").arg(url).spawn() == {
            .Ok(_) -> theme.ok("Opened Jetos Studio")
            .Err(_) -> theme.detail("open the printed Studio URL in a browser.")
        }
    }
    with_studio_workers(app, meta, data, &context, local_addr, sender -> {
        loop stream in listener.incoming() {
            if stream == {
                .Ok(stream) -> _ :: queue_studio_connection(sender, ^stream)
                .Err(error) -> {
                    theme.error("jetos Studio service connection failed", "accepting a local connection failed: {error}", "restart `jetos studio --serve`.")
                    return 2
                }
            }
        }
        0
    })
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:133
fn with_studio_workers<T>(app: OSPath, meta: OSPath, data: OSPath, context: &StudioContext, local_addr: SocketAddr, serve: fn(&mpsc.SyncSender<TcpStream>) -> T) -> T {
    thread.scope(scope -> {
        (sender, incoming) :: mpsc.sync_channel<TcpStream>(STUDIO_CONNECTION_QUEUE)
        receiver :: Arc.new(Mutex.new(^incoming))
        workers := [thread.ScopedJoinHandle<()>]{}
        loop _ in 0..<STUDIO_WORKER_COUNT {
            owned_receiver :: Arc.clone(receiver)
            &workers.push(scope.spawn(() -> {
                receiver :: ^owned_receiver
                loop {
                    // Guard is released before request processing.
                    stream_result :: if receiver.lock() == {
                        .Ok(guard) -> guard.recv()
                        .Err(_) -> return
                    }
                    stream := stream_result ?? return
                    _ :: handle_studio_request(&stream, app, meta, data, context, local_addr)
                }
            }))
        }
        result :: serve(&sender)
        drop(^sender)
        loop worker in workers -> _ :: worker.join()
        result
    })
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:167
fn queue_studio_connection(sender: &mpsc.SyncSender<TcpStream>, stream: TcpStream) -> Bool {
    _ :: configure_studio_stream(&stream)
    if sender.try_send(^stream) == {
        .Ok(_) -> true
        .Err(.Full(stream)) | .Err(.Disconnected(stream)) -> {
            drop(^stream)
            false
        }
    }
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:179
fn configure_studio_stream(stream: &TcpStream) -> Error! {
    stream.set_read_timeout(Val(STUDIO_IO_TIMEOUT))?
    stream.set_write_timeout(Val(STUDIO_IO_TIMEOUT))
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:184
fn handle_studio_request(stream: &TcpStream, app: OSPath, meta: OSPath, data: OSPath, context: &StudioContext, local_addr: SocketAddr) -> Error! {
    request_bytes :: read_http_request(stream)?
    request :: parse_studio_request(request_bytes) ?? return studio_write_response(stream, "400 Bad Request", "text/plain; charset=utf-8", "malformed Studio request\n".bytes(), None)
    if !studio_request_authorized(request, context, local_addr) -> return studio_write_response(stream, "401 Unauthorized", "text/plain; charset=utf-8", "Studio session, host, or origin rejected\n".bytes(), None)
    path := request.target.split("?").next() ?? "/" // #4303
    if request.method == "POST" && path == "/studio/transaction" {
        response :: handle_studio_transaction(request.body, Val(context))
        return studio_write_response(stream, response.0, "application/json", response.1.bytes(), None)
    }
    if request.method == "POST" && path == "/studio/run" {
        response :: handle_studio_run(request.body, Val(context))
        return studio_write_response(stream, response.0, "application/json", response.1.bytes(), None)
    }
    response :: if path == {
        "/" | "/studio" | "/studio/" | "/studio/index.html" -> (status: "200 OK", content_type: "text/html; charset=utf-8", body: fs_read_for_http(app), cookie: Val(context.session_secret))
        "/studio/app.json" -> (status: "200 OK", content_type: "application/json", body: fs_read_for_http(meta), cookie: None)
        "/studio/data.json" -> if studio_live_projection(context, data) == {
            .Ok(body) -> (status: "200 OK", content_type: "application/json", body: body.bytes(), cookie: None)
            .Err(body) -> (status: "500 Internal Server Error", content_type: "application/json", body: body.bytes(), cookie: None)
        }
        "/studio/source" -> (status: "200 OK", content_type: "text/plain; charset=utf-8", body: fs_read_for_http(context.config), cookie: None)
        _ -> (status: "404 Not Found", content_type: "text/plain; charset=utf-8", body: "not found\n".bytes(), cookie: None)
    }
    studio_write_response(stream, response.status, response.content_type, response.body, response.cookie)
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:261
struct StudioRequest {
    method: String
    target: String
    headers: [String: String]
    body: String
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:268
fn studio_session_secret() -> String? {
    HEX :: "0123456789abcdef".bytes()
    bytes :: os_random_bytes<32>() ?? return None
    secret := [U8]{}
    &secret.reserve(bytes.len() * 2)
    loop byte in bytes {
        &secret.push(HEX[byte >> 4])
        &secret.push(HEX[byte & 0x0f])
    }
    Val(String.from_utf8(secret) ?? panic("hex is UTF-8"))
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:279
fn parse_studio_request(bytes: [U8]) -> StudioRequest? {
    header_end :: (bytes.windows(4).position(window -> window == "\r\n\r\n".bytes()) ?? return None) + 4
    headers := String.from_utf8(bytes[..header_end]) ?? return None
    lines := headers.split("\r\n")
    request_line := (lines.next() ?? return None).split_whitespace()
    method := request_line.next() ?? return None
    target := request_line.next() ?? return None
    if (request_line.next() ?? return None) != "HTTP/1.1" || request_line.next() != None -> return None
    parsed_headers := [String: String]{}
    loop line in lines {
        if line.is_empty() -> continue
        pair :: line.split_once(":") ?? return None
        name := pair.before.trim().to_ascii_lowercase() // #4303
        if name.is_empty() || parsed_headers.contains_key(name) -> return None
        value := pair.after.trim() // #4303
        parsed_headers[name] = value
    }
    Val(StudioRequest{method: method, target: target, headers: parsed_headers, body: String.from_utf8_lossy(bytes[header_end..])})
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:314
fn studio_request_authorized(request: StudioRequest, context: &StudioContext, local_addr: SocketAddr) -> Bool {
    if request.method != "GET" && request.method != "POST" -> return false
    host :: request.headers.get("host") ?? return false
    if !studio_host_allowed(host, local_addr) -> return false
    origin :: request.headers.get("origin")
    if origin == .Val(value) {
        if !studio_origin_allowed(value, host, local_addr) -> return false
    }
    if request.method == "POST" {
        if origin == None -> return false
        content_type :: request.headers.get("content-type") ?? return false
        media := content_type.split(";").next() ?? return false
        media := media.trim() // #4303
        if !media.eq_ignore_ascii_case("application/json") || !request.headers.contains_key("content-length") -> return false
    }
    query_session :: studio_query_session(request.target) ?? return false
    cookie_session :: if request.headers.get("cookie") == {
        .Val(cookie) -> studio_cookie_session(cookie) ?? return false
        .None -> None
    }
    authenticated := false
    if request.headers.get("authorization") == .Val(authorization) {
        token := authorization.strip_prefix("Bearer ") ?? return false
        if !constant_time_equal(token, context.session_secret) -> return false
        authenticated = true
    }
    if query_session == .Val(session) {
        if !constant_time_equal(session, context.session_secret) -> return false
        authenticated = true
    }
    if cookie_session == .Val(session) {
        if !constant_time_equal(session, context.session_secret) -> return false
        if request.method == "GET" && origin == None {
            site :: request.headers.get("sec-fetch-site") ?? return false
            if !site.eq_ignore_ascii_case("same-origin") -> return false
        }
        authenticated = true
    }
    authenticated
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:391
fn studio_query_session(target: String) -> String? Err! {
    pair :: target.split_once("?") ?? return Ok(None)
    session := String?{None}
    loop part in pair.after.split("&") {
        item :: part.split_once("=")
        name := if item == .Val(pair) -> pair.before else -> part
        value := if item == .Val(pair) -> pair.after else -> ""
        if name == "session" {
            if session != None -> return Err("duplicate Studio session")
            session = Val(value)
        }
    }
    Ok(session)
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:408
fn studio_cookie_session(value: String) -> String? Err! {
    session := String?{None}
    loop part in value.split(";") {
        trimmed := part.trim() // #4303
        item :: trimmed.split_once("=")
        name := if item == .Val(pair) -> pair.before else -> trimmed
        value := if item == .Val(pair) -> pair.after else -> ""
        if name == "jetos_studio" {
            if session != None -> return Err("duplicate Studio session")
            session = Val(value)
        }
    }
    Ok(session)
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:422
fn studio_host_allowed(value: String, local_addr: SocketAddr) -> Bool {
    value := value.trim() // #4303
    pair :: studio_host_port(value) ?? return false
    if pair.port != local_addr.port() -> return false
    if pair.host.eq_ignore_ascii_case("localhost") -> return local_addr.ip().is_loopback() || local_addr.ip().is_unspecified()
    ip :: IpAddr.parse(pair.host) ?? return false
    ip == local_addr.ip() || local_addr.ip().is_unspecified() || (local_addr.ip().is_loopback() && ip.is_loopback())
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:441
fn studio_host_port(value: String) -> (host: String, port: U16)? {
    if value.strip_prefix("[") == .Val(rest) {
        end :: rest.find("]") ?? return None
        host := rest[..end] // #4303
        suffix := rest.get(end + 1..) ?? return None
        port_text := suffix.strip_prefix(":") ?? return None
        port :: U16.parse(port_text) ?? return None
        return Val((host: host, port: port))
    }
    pair :: value.rsplit_once(":") ?? return None
    if pair.before.contains(":") -> return None
    port :: U16.parse(pair.after) ?? return None
    Val((host: pair.before, port: port))
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:455
fn studio_origin_allowed(value: String, host: String, local_addr: SocketAddr) -> Bool {
    value := value.trim() // #4303
    origin_host := value.strip_prefix("http://") ?? return false
    trimmed_host := host.trim() // #4303
    !origin_host.contains("/") && studio_host_allowed(origin_host, local_addr) && origin_host.eq_ignore_ascii_case(trimmed_host)
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:464
fn constant_time_equal(left: String, right: String) -> Bool {
    left :: left.bytes()
    right :: right.bytes()
    difference := left.len() ^ right.len()
    loop index in 0..<left.len().max(right.len()) {
        difference |= USize.from(left.get(index) ?? U8{0}) ^ USize.from(right.get(index) ?? U8{0})
    }
    difference == 0
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:475
fn studio_write_response(stream: &TcpStream, status: String, content_type: String, body: [U8], set_cookie: String?) -> Error! {
    cookie :: if set_cookie == .Val(session) -> "Set-Cookie: jetos_studio={session}; Path=/studio; HttpOnly; SameSite=Strict\r\n" else -> ""
    stream.write_all("HTTP/1.1 {status}\r\nContent-Type: {content_type}\r\nContent-Length: {body.len()}\r\nCache-Control: no-store\r\n{cookie}Connection: close\r\n\r\n".bytes())?
    stream.write_all(body)
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:499
fn fs_read_for_http(path: OSPath) -> [U8] { fs.read(path) ?? "missing\n".bytes() }

// Rust: crates/jetpack/src/CLI/studio_server.rs:503
fn read_http_request(stream: &TcpStream) -> [U8] Error! {
    read_http_request_until(stream, Instant.now() + STUDIO_IO_TIMEOUT)
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:507
fn read_http_request_until(stream: &TcpStream, deadline: Instant) -> [U8] Error! {
    buf := [U8]{}
    chunk := [U8; 1024]{0}
    loop {
        remaining :: deadline.saturating_duration_since(Instant.now())
        // GATE #4409: retain explicit deadline TimedOut and native read errors.
        if remaining.is_zero() -> return Err(Error.new(ErrorKind.TimedOut, "Studio request deadline exceeded"))
        stream.set_read_timeout(Val(remaining))?
        n :: stream.read(&chunk)?
        if n == 0 -> break
        &buf.extend_from_slice(chunk[..n])
        if http_request_complete(buf) || buf.len() > 64 * 1024 -> break
    }
    Ok(buf)
}

// Rust: crates/jetpack/src/CLI/studio_server.rs:535
fn http_request_complete(buf: [U8]) -> Bool {
    header_end :: (buf.windows(4).position(window -> window == "\r\n\r\n".bytes()) ?? return false) + 4
    headers := String.from_utf8_lossy(buf[..header_end])
    content_len: USize := 0
    loop line in headers.lines() {
        pair :: line.split_once(":") ?? continue
        if pair.before.eq_ignore_ascii_case("content-length") {
            value := pair.after.trim() // #4303
            if USize.parse(value) == .Ok(length) {
                content_len = length
                break
            }
        }
    }
    buf.len().saturating_sub(header_end) >= content_len
}

