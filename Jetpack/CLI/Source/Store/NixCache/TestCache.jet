// Rust: crates/jetpack/src/Store/NixCache/TestCache.rs:65
// Replace canonical store_nix_test_signed_narinfo_with_payload: Rust takes
// the literal suffix after '/', then split_whitespace of the joined names.
fn signed_narinfo_with_payload(store_path: String, nar_name: String, payload: [U8], nar: [U8], compression: NixCompression, references: [String], key_id: String, seed: [U8]) -> [U8] {
    file_hash :: "sha256:{store_sha256_hex(payload)}"
    nar_hash :: "sha256:{store_sha256_hex(nar)}"
    names := [String]{}
    loop reference in references {
        suffix :: reference.rsplit("/").first() ?? panic("split always yields a suffix")
        &names.push(suffix)
    }
    reference_text :: names.join(" ")
    parsed_references := [String]{}
    loop reference in reference_text.split_whitespace() -> &parsed_references.push(reference)
    info := NixNarInfo{
        store_path: store_path, url: "nar/{nar_name}", compression: compression,
        file_hash: Val(file_hash), file_size: Val(U64.from_usize(payload.len())),
        nar_hash: nar_hash, nar_size: U64.from_usize(nar.len()),
        references: parsed_references, deriver: None, ca: None,
        signatures: [NixNarInfoSignature]{}
    }
    fingerprint :: info.fingerprint("/nix/store") ?? panic("narinfo fingerprint")
    signature :: crypto.sign(crypto.SigningKey{bytes: seed}, fingerprint) ?? panic("narinfo signature")
    &info.signatures.push(NixNarInfoSignature{key_id: key_id, signature: signature.bytes})
    "StorePath: {info.store_path}\nURL: {info.url}\nCompression: {info.compression.as_str()}\nFileHash: {file_hash}\nFileSize: {info.file_size ?? panic("file size")}\nNarHash: {info.nar_hash}\nNarSize: {info.nar_size}\nReferences: {reference_text}\nSig: {key_id}:{base64.encode(info.signatures[0].signature)}\n".bytes()
}

