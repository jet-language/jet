// Test-only continuation of canonical Store.NixCache support, not a second
// binary-cache client. Replace the disk-backed test server at integration.
use std.[env, fs, io, net, sync, thread, time]

// Rust: crates/jetpack/src/Store/NixCache/TestCache.rs:13
fn unique_dir(tag: String) -> OSPath {
    path :: env.temp_dir().join("jet-nix-cache-{tag}-{std.process.id()}")
    _ :: fs.remove_dir_all(path)
    fs.create_dir_all(path) ?? panic("create cache test directory")
    path
}
// Rust: crates/jetpack/src/Store/NixCache/TestCache.rs:20
fn remove_dir(path: OSPath) -> {
    _ :: fs.remove_dir_all(path)
}
