// Rust: crates/jetpack/src/Store/NixCache/TestCache.rs:143
struct TestCacheServer {
    endpoint: String
    routes: sync.Arc<sync.Mutex<[String: [U8]]>>
    stop: sync.Arc<sync.atomic.AtomicBool>
    join: thread.JoinHandle<Unit>?

    // Rust: crates/jetpack/src/Store/NixCache/TestCache.rs:151
    fn start(routes: [String: [U8]]) -> TestCacheServer {
        // GATE #4494: native TCP listener, Arc/Mutex, atomics and join handles.
        listener :: net.TcpListener.bind(("127.0.0.1", 0)) ?? panic("bind test cache")
        listener.set_nonblocking(true) ?? panic("nonblocking test cache")
        address :: listener.local_addr() ?? panic("test cache address")
        shared_routes :: sync.Arc.new(sync.Mutex.new(^routes))
        thread_routes :: shared_routes.clone()
        stop :: sync.Arc.new(sync.atomic.AtomicBool.new(false))
        thread_stop :: stop.clone()
        join :: thread.spawn(() -> {
            loop !thread_stop.load(sync.atomic.Ordering.Relaxed) {
                if listener.accept() == {
                    .Ok((stream, _)) -> serve_cache_request(^stream, &thread_routes)
                    .Err(error) -> {
                        if error.kind() == io.ErrorKind.WouldBlock { // GATE #4409
                            thread.sleep(time.Duration.from_millis(1))
                        } else {
                            break
                        }
                    }
                }
            }
        })
        TestCacheServer{endpoint: "http://127.0.0.1:{address.port()}", routes: shared_routes, stop: stop, join: Val(^join)}
    }

    // Rust: crates/jetpack/src/Store/NixCache/TestCache.rs:178
    fn replace_routes(self, routes: [String: [U8]]) -> {
        guard := self.routes.lock() ?? panic("poisoned test cache routes")
        guard.value = ^routes
    }

}

impl TestCacheServer.Close {
    // Rust: crates/jetpack/src/Store/NixCache/TestCache.rs:184
    fn close(^self) -> {
        self.stop.store(true, sync.atomic.Ordering.Relaxed)
        address :: self.endpoint.removeprefix("http://")
        _ :: net.TcpStream.connect(address)
        if self.join == {
            .Val(join) -> ^join.join() ?? panic("test cache thread")
            .None -> {}
        }
    }
}

// Rust: crates/jetpack/src/Store/NixCache/TestCache.rs:193
fn serve_cache_request(stream: net.TcpStream, routes: &sync.Arc<sync.Mutex<[String: [U8]]>>) -> {
    request := [U8; 4096].filled(0)
    count :: &stream.read(&request) ?? 0
    // Borrowed UTF-8 view, not a copied whole HTTP request.
    decoded :: std.str.from_utf8(&request[0..<count])
    path := "/"
    if decoded == {
        .Ok(text) -> {
            if text.lines().first() == {
                .Val(line) -> path = line.split_whitespace().nth(1) ?? "/"
                .None -> {}
            }
        }
        .Err(_) -> {}
    }
    path = path.split("?").first() ?? "/"
    body := [U8]?{None}
    {
        guard :: routes.lock() ?? panic("poisoned test cache routes")
        // Clone the selected body before releasing the map mutex, as Rust.
        if guard.value.get(path) == {
            .Val(found) -> body = Val(~found)
            .None -> {}
        }
    }
    if body == {
        .Val(bytes) -> {
            header :: "HTTP/1.1 200 OK\r\nContent-Length: {bytes.len()}\r\nConnection: close\r\n\r\n"
            _ :: &stream.write_all(header.bytes())
            _ :: &stream.write_all(bytes)
        }
        .None -> {
            _ :: &stream.write_all("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".bytes())
        }
    }
}
