// The typed project plan every environment command realizes, ported from
// jetpack::CLI::realize (RunPlan, load_project_plan, typed_plan). One
// `env.jet` has two author surfaces: the typed `module { … }` surface goes
// through the environment evaluator, and the Phase-1 `pkg.*` directive
// surface stays the fallback until the typed surface replaces it.

// The refs to realize, the table that resolves their named sources, and the
// prompt label for the resulting shell.
pub struct RunPlan {
    // Canonical project root for project-relative lifecycle files, so nested
    // hook commands never resolve `.env` against a caller's subdirectory.
    pub project_root: String
    pub refs: [RefSpec]
    pub adapters: [AdapterPlan]
    pub table: SourceTable
    pub label: String
    pub prompt_path: PromptPathMode
    pub prompt_strip: PromptStripMode
    // U12: dev-supervised `services:` entries the typed surface declared;
    // empty for the Phase-1 directive surface.
    pub dev_services: [DevServicePlan]
    // D-JPK-SECRETMETA1=B / D-JPK-SECRETCOMPOSE1=D: the selected typed
    // `secrets:` map. Trust sees the redacted declaration identity.
    pub secrets: [SecretSpec]
    // Typed lifecycle, preset, and language-pack facts shared by activation,
    // lifecycle hooks, and service commands.
    pub environment: EnvironmentFacts

    // A plan with no packages over `table`: job-only projects, `-p`-only
    // shells, `use`, and the foreign-flake projection start here.
    fn empty(project_root: String, table: SourceTable) -> RunPlan Never! {
        RunPlan{
            project_root: project_root,
            refs: [RefSpec]{},
            adapters: [AdapterPlan]{},
            table: table,
            label: @JETPACK_PROMPT_LABEL,
            prompt_path: PromptPathMode.Short,
            prompt_strip: PromptStripMode.Off,
            dev_services: [DevServicePlan]{},
            secrets: [SecretSpec]{},
            environment: EnvironmentFacts{},
        }
    }

    // The reference an adapter realization is recorded under.
    fn adapter_reference(adapter: AdapterPlan) -> String Never! {
        "adapt:{adapter.name}:{adapter.source}"
    }
}

// Resolve the nearest directory that owns an `env.jet` or `workspace.jet`.
// Environment and workspace commands run from a project subdirectory keep
// this one root so planning, trust, dotenv composition, managed state, and
// explicit refs share the same project identity.
pub fn cli_project_env_root(start: String) -[IO, FS, Env, Exec]> String Never! {
    cli_project_root(start)
}

// Build a plan from the project `env.jet` (the no-explicit-ref path).
pub fn cli_load_project_plan(theme: Theme) -[IO, FS, Env, Exec]> RunPlan CliError! {
    cli_load_project_plan_with_selections(theme, None, None)
}

pub fn cli_load_project_plan_with_selections(theme: Theme, requested_preset: String?, requested_environment: String?) -[IO, FS, Env, Exec]> RunPlan CliError! {
    cwd :: cli_current_dir()
    if cli_reject_retired_jetpack_toml(cwd) == .Val(code) -> return Err(CliError.Reported(code))
    dir :: cli_project_env_root(cwd)
    src :: files.read(EnvFile.path_in(dir)) ?? {
        theme.error("nothing to do", "no ref was given and there is no {@ENV_FILE} here.", "try `jet run fastfetch@jetpack`, or `jet add <ref>` first.")
        return Err(CliError.Reported(@EXIT_USAGE))
    }
    if envmodel_is_module_surface(src) -> return cli_typed_plan(theme, src, dir, requested_preset, requested_environment)
    if requested_environment == .Val(name) {
        theme.error_coded(
            "E1337",
            "environment module `{name}` is not declared",
            "the explicit selector applies to typed `env.<name>` modules",
            "select a declared `env.<name>` module with `--env <name>`, or omit `--env`"
        )
        return Err(CliError.Reported(@EXIT_USAGE))
    }
    env_file :: EnvFile.parse(src)
    table := env_file.source_table()
    cli_ensure_builtin_sources(&table)
    refs :: cli_classify_all(theme, env_file.refs(), table)
    plan := RunPlan.empty(dir, table)
    plan.refs = refs
    plan.label = env_file.prompt_label()
    Ok(plan)
}

// Add `package` to `refs` once, keeping first-seen order.
fn cli_push_package_ref(refs: &[String], package: String) Never! {
    if !refs.contains(package) -> &refs.push(package)
}

// Evaluate the typed `module { … }` env surface (U3/U6/U8) into a plan.
// Source refs merge across modules, `Pkg` sugar resolves to
// `package@source` refs, and the merged `prompt` becomes the shell label.
fn cli_typed_plan(theme: Theme, src: String, dir: String, requested_preset: String?, requested_environment: String?) -[IO, FS, Env, Exec]> RunPlan CliError! {
    plan :: envmodel_evaluate_env_with_selections(src, dir, requested_preset, requested_environment) ?? {
        term.eprint(diagnostics_render_all(@ENV_FILE, src, [Diagnostic]{err.diagnostic}))
        return Err(CliError.Reported(@EXIT_USAGE))
    }
    table := plan.table
    cli_ensure_builtin_sources(&table)
    // A formatter package, the selected preset's packages, the language
    // expansion's packages, integration packages, and the catalog package of
    // an enabled service with no explicit `run:` all realize like the
    // author's own `packages:`. `evaluate_env_with_selections` already
    // expanded the typed selections; re-expanding here could make planning,
    // trust, and activation disagree if the catalog changes.
    package_refs := plan.package_refs
    if plan.lifecycle.formatter == .Val(formatter) -> cli_push_package_ref(&package_refs, formatter.package)
    if plan.selected_preset == .Val(preset) {
        loop package in preset.packages -> cli_push_package_ref(&package_refs, package)
    }
    expansion :: plan.language_expansion
    loop package in expansion.packages -> cli_push_package_ref(&package_refs, package)
    loop integration in plan.integrations {
        loop package in integration.packages -> cli_push_package_ref(&package_refs, package)
    }
    loop service in plan.dev_services {
        if service.enable && service.run == None {
            if services_catalog_pkg_ref(service.name) == .Val(package) -> cli_push_package_ref(&package_refs, package)
        }
    }
    refs :: cli_classify_all(theme, package_refs, table)
    Ok(RunPlan{
        project_root: dir,
        refs: refs,
        adapters: plan.adapters,
        table: table,
        label: plan.prompt ?? @JETPACK_PROMPT_LABEL,
        prompt_path: plan.prompt_path,
        prompt_strip: plan.prompt_strip,
        dev_services: plan.dev_services,
        secrets: plan.secrets,
        environment: EnvironmentFacts{
            environment_names: plan.environment_names,
            active_environment: plan.active_environment,
            active_environment_provenance: plan.active_environment_provenance,
            source_files: plan.source_files,
            environment_reads: plan.environment_reads,
            dev_services: plan.dev_services,
            lifecycle: plan.lifecycle,
            presets: plan.presets,
            languages: expansion.selections,
            selected_preset: plan.selected_preset,
            language_expansion: expansion,
            language_packs: expansion.packs,
            language_projections: expansion.projections,
            files: plan.files,
            integrations: plan.integrations,
            integration_facts: plan.integration_facts,
            package_profiles: plan.package_profiles,
        },
    })
}

// Classify a sequence of `package@source` refs against `table`, printing the
// first failure and exiting 2.
fn cli_classify_all(theme: Theme, raws: [String], table: SourceTable) -[IO]> [RefSpec] CliError! {
    refs := [RefSpec]{}
    loop raw in raws {
        spec :: RefSpec.classify_in(raw, table) ?? {
            cli_ref_error(theme, err)
            return Err(CliError.Reported(@EXIT_USAGE))
        }
        &refs.push(spec)
    }
    Ok(refs)
}
