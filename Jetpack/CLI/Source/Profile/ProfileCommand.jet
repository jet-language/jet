// D-JPK-PROFILE1=D: `jet profile plan|build|switch|rollback|generations
// <name>`, ported from jetpack::CLI::profile. `jet profile <verb> tools`
// addresses the standalone user-tools profile instead.

// A loaded project profile plan and where it came from.
struct PackageProfileLoad {
    project_dir: String
    source: String
    plan: PackageProfilePlan
}

pub fn cli_cmd_profile(verification: &StoreVerification, theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    cache := WorkspaceDeclarationCache.new()
    if (parsed.positional.get(1) ?? "") == TOOL_PROFILE_NAME && parsed.positional.len() > 1 -> return cli_cmd_tool_profile(&verification, theme, parsed)
    word :: parsed.positional.get(0) ?? {
        theme.error("`jet profile` needs a verb", "verbs are: {PROFILE_VERBS.join(", ")}.", "try `jet profile plan <name>`.")
        return EXIT_USAGE
    }
    verb :: ProfileVerb.parse(word) ?? {
        theme.error("`{word}` is not a package-generation verb", "`jet profile` verbs are: {PROFILE_VERBS.join(", ")}.", "try `jet profile plan <name>`.")
        return EXIT_USAGE
    }
    if verb == {
        .Plan -> cli_package_profile_plan(&cache, theme, parsed)
        .Build -> cli_package_profile_build(&verification, &cache, theme, parsed)
        .Switch -> cli_package_profile_switch(&verification, &cache, theme, parsed)
        .Rollback -> cli_package_profile_rollback(&verification, &cache, theme, parsed)
        .Generations -> cli_package_profile_generations(&verification, &cache, theme, parsed)
    }
}

fn cli_package_profile_plan(cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Time.Wait]> Int Never! {
    name :: parsed.positional.get(1) ?? {
        theme.error("`jet profile plan` needs a generation name", "planning resolves one source-backed `profile.<name>` declaration and its parents", "try `jet profile plan dev`.")
        return EXIT_USAGE
    }
    if parsed.positional.len() != 2 || parsed.command != None {
        theme.error("`jet profile plan` accepts one generation name", "planning is read-only and has no trailing command", "run `jet profile plan <name> --json` for machine-readable output")
        return EXIT_USAGE
    }
    loaded :: cli_load_package_profile_plan(&cache, theme, name) ?? return EXIT_USAGE
    plan :: loaded.plan
    if parsed.flags.json {
        facts := [String]{}
        loop raw in cli_sorted_provider_fact_keys(plan.provider_facts) -> &facts.push("{cli_json_quote(raw)}:{plan.provider_facts[raw].to_json()}")
        packages := [String]{}
        loop package in plan.packages {
            &packages.push("{{\"raw\":{cli_json_quote(package.raw)},\"target\":{cli_json_quote(package.target)},\"source\":{cli_json_quote(package.source)},\"upstream\":{cli_json_optional(package.upstream)},\"provider\":{cli_json_quote(package.provider)},\"channel\":{cli_json_optional(package.channel)},\"declared_by\":[{cli_json_quote_list(package.declared_by)}],\"provider_facts\":{package.provider_facts.to_json()}}}")
        }
        collisions := [String]{}
        loop path in cli_sorted_map_keys(plan.collisions) -> &collisions.push("{cli_json_quote(path)}:{cli_json_quote(plan.collisions[path])}")
        print("{{\"name\":{cli_json_quote(plan.name)},\"fingerprint\":{cli_json_quote(plan.fingerprint)},\"selected_profiles\":[{cli_json_quote_list(plan.selected_profiles)}],\"applied\":[{cli_json_quote_list(plan.applied)}],\"sources\":[{cli_json_quote_list(plan.sources)}],\"packages\":[{packages.join(",")}],\"collisions\":{{{collisions.join(",")}}},\"provider_facts\":{{{facts.join(",")}}}}}")
        return EXIT_OK
    }
    theme.ok("package generation {theme.bold(plan.name)} planned")
    theme.detail("fingerprint: {plan.fingerprint}")
    theme.detail("applied: {plan.applied.join(" -> ")}")
    if plan.sources.len() > 0 -> theme.detail("declared by: {plan.sources.join(", ")}")
    loop package in plan.packages {
        channel :: if package.channel == {
            .Val(value) -> "#{value}"
            .None -> ""
        }
        theme.detail("package {package.raw}  [{package.source}{channel} via {package.provider}]  ({package.declared_by.join(", ")})")
        if package.upstream == .Val(upstream) -> theme.detail("  source -> {upstream}")
        loop line in package.provider_facts.explain_lines() -> theme.detail("  fact {line}")
    }
    loop path in cli_sorted_map_keys(plan.collisions) -> theme.detail("collision {path} <- {plan.collisions[path]}")
    EXIT_OK
}

fn cli_sorted_provider_fact_keys(values: [String: ProviderFacts]) -> [String] Never! {
    keys := values.keys().to_list()
    &keys.sort()
    keys
}

fn cli_package_profile_build(verification: &StoreVerification, cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    name :: cli_one_profile_name(theme, parsed, PROFILE_VERB_BUILD) ?? return EXIT_USAGE
    loaded :: cli_load_package_profile_plan(&cache, theme, name) ?? return EXIT_USAGE
    plan :: loaded.plan
    generation :: cli_build_package_generation_locked(&verification, &cache, theme, parsed, loaded.project_dir, plan) ?? return cli_report_package_generation_error(theme, err)
    if parsed.flags.json {
        print("{{\"profile\":{cli_json_quote(plan.name)},\"generation\":{generation},\"fingerprint\":{cli_json_quote(plan.fingerprint)}}}")
    } else {
        theme.ok("package generation {theme.bold(plan.name)} built as {generation}")
    }
    EXIT_OK
}

fn cli_build_package_generation_locked(verification: &StoreVerification, cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed, project_dir: String, plan: PackageProfilePlan) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int CLIError! {
    lock :: cli_package_profile_lock(project_dir, plan.name)
    cli_build_package_generation(&verification, &cache, theme, parsed, project_dir, plan)
}

fn cli_package_profile_switch(verification: &StoreVerification, cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    name :: cli_one_profile_name(theme, parsed, PROFILE_VERB_SWITCH) ?? return EXIT_USAGE
    loaded :: cli_load_package_profile_plan(&cache, theme, name) ?? return EXIT_USAGE
    plan :: loaded.plan
    record :: cli_switch_package_generation_locked(&verification, &cache, theme, parsed, loaded.project_dir, plan) ?? return cli_report_package_generation_error(theme, err)
    if parsed.flags.json {
        print("{{\"profile\":{cli_json_quote(plan.name)},\"current\":{record.generation},\"witness\":{cli_json_quote(record.witness)}}}")
    } else {
        theme.ok("package generation {theme.bold(plan.name)} switched to {record.generation}")
    }
    EXIT_OK
}

// Reuse the newest generation built from this exact plan, else build one,
// then activate it.
fn cli_switch_package_generation_locked(verification: &StoreVerification, cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed, project_dir: String, plan: PackageProfilePlan) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> PackageGenerationRecord CLIError! {
    lock :: cli_package_profile_lock(project_dir, plan.name)
    state :: cli_package_profile_state_dir(project_dir, plan.name)
    records :: cli_read_package_generations(&verification, state)
    generation := 0
    loop record in records {
        if record.fingerprint == plan.fingerprint -> generation = record.generation
    }
    if generation == 0 -> generation = cli_build_package_generation(&verification, &cache, theme, parsed, project_dir, plan)
    cli_activate_package_generation(&verification, project_dir, plan.name, generation, Val(plan.fingerprint))
}

fn cli_package_profile_rollback(verification: &StoreVerification, cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Time.Wait]> Int Never! {
    name :: parsed.positional.get(1) ?? {
        theme.error("`jet profile rollback` needs a generation name", "rollback activates an older immutable generation from the same profile history", "try `jet profile rollback dev` or `jet profile rollback dev 3`")
        return EXIT_USAGE
    }
    count :: parsed.positional.len()
    if (count != 2 && count != 3) || parsed.command != None {
        theme.error("`jet profile rollback` accepts a name and optional generation", "without a number it selects the generation immediately before the current one", "try `jet profile rollback dev 3`")
        return EXIT_USAGE
    }
    if !cli_valid_profile_name(name) {
        theme.error("profile generation name is unsafe", "generation names are single path components", "use a name such as `dev` or `release`")
        return EXIT_USAGE
    }
    target := Int?{None}
    if parsed.positional.get(2) == .Val(value) {
        number :: cli_parse_u64(value) ?? 0
        if number == 0 {
            theme.error("profile rollback generation is invalid", "generation numbers are positive decimal integers", "try `jet profile rollback dev 3`")
            return EXIT_USAGE
        }
        target = Val(number)
    }
    project_dir :: cli_project_env_root(&cache, cli_current_dir())
    record :: cli_rollback_package_generation_locked(&verification, project_dir, name, target) ?? return cli_report_package_generation_error(theme, err)
    if parsed.flags.json {
        print("{{\"profile\":{cli_json_quote(name)},\"current\":{record.generation},\"witness\":{cli_json_quote(record.witness)}}}")
    } else {
        theme.ok("package generation {theme.bold(name)} rolled back to {record.generation}")
    }
    EXIT_OK
}

// The explicit target, or the newest generation older than the current one.
fn cli_rollback_package_generation_locked(verification: &StoreVerification, project_dir: String, name: String, target: Int?) -[FS, Env]> PackageGenerationRecord CLIError! {
    lock :: cli_package_profile_lock(project_dir, name)
    state :: cli_package_profile_state_dir(project_dir, name)
    records :: cli_read_package_generations(&verification, state)
    pointer :: cli_read_package_current_pointer(&verification, state)
    generation := target ?? 0
    if target == None {
        current :: pointer ?? return Err(CLIError.Other("profile has no current generation to roll back"))
        loop record in records {
            if record.generation < current.generation && record.generation > generation -> generation = record.generation
        }
        if generation == 0 -> return Err(CLIError.Other("profile has no older generation to roll back to"))
    }
    cli_activate_package_generation(&verification, project_dir, name, generation, None)
}

// A profile's generation history and its current generation.
struct PackageGenerationHistory {
    records: [PackageGenerationRecord]
    current: Int?
}

fn cli_package_generation_history_locked(verification: &StoreVerification, project_dir: String, name: String) -[FS, Env]> PackageGenerationHistory CLIError! {
    lock :: cli_package_profile_lock(project_dir, name)
    state :: cli_package_profile_state_dir(project_dir, name)
    records :: cli_read_package_generations(&verification, state)
    pointer :: cli_read_package_current_pointer(&verification, state)
    current :: if pointer == {
        .Val(found) -> Val(found.generation)
        .None -> None
    }
    Ok(PackageGenerationHistory{records: records, current: current})
}

fn cli_package_profile_generations(verification: &StoreVerification, cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed) -[IO, FS, Env, Exec, Time.Wait]> Int Never! {
    name :: cli_one_profile_name(theme, parsed, PROFILE_VERB_GENERATIONS) ?? return EXIT_USAGE
    project_dir :: cli_project_env_root(&cache, cli_current_dir())
    history :: cli_package_generation_history_locked(&verification, project_dir, name) ?? return cli_report_package_generation_error(theme, err)
    if parsed.flags.json {
        generations := [String]{}
        loop record in history.records {
            &generations.push("{{\"generation\":{record.generation},\"fingerprint\":{cli_json_quote(record.fingerprint)},\"witness\":{cli_json_quote(record.witness)},\"lock\":{record.metadata.trim()}}}")
        }
        current :: if history.current == {
            .Val(value) -> "{value}"
            .None -> "null"
        }
        print("{{\"profile\":{cli_json_quote(name)},\"current\":{current},\"generations\":[{generations.join(",")}]}}")
    } else if history.records.len() == 0 {
        theme.detail("package generation {name} has no built generations")
    } else {
        index := history.records.len() - 1
        loop index >= 0 {
            record :: history.records[index]
            marker :: if (history.current ?? 0) == record.generation -> " current" else -> ""
            theme.detail("generation {record.generation}{marker}  {record.fingerprint}")
            index -= 1
        }
    }
    EXIT_OK
}

// The one profile name a lifecycle verb takes, validated as a single path
// component.
fn cli_one_profile_name(theme: Theme, parsed: CLIParsed, verb: String) -[IO, Time.Wait]> String? Never! {
    name :: parsed.positional.get(1) ?? {
        theme.error("`jet profile {verb}` needs a generation name", "the name selects one source-backed `profile.<name>` declaration", "try `jet profile {verb} dev`")
        return None
    }
    if parsed.positional.len() != 2 || parsed.command != None {
        theme.error("`jet profile {verb}` accepts one generation name", "profile lifecycle commands do not accept a trailing command", "try `jet profile {verb} {name}`")
        return None
    }
    if !cli_valid_profile_name(name) {
        theme.error("profile generation name is unsafe", "generation names are single path components", "use a name such as `dev` or `release`")
        return None
    }
    Val(name)
}

pub fn cli_valid_profile_name(name: String) -> Bool Never! {
    name != "" && name != "." && name != ".." && !name.contains("/") && !name.contains("\\") && !name.bytes().contains(U8{0})
}

// Evaluate `profile.<name>` from the project's env.jet; a read failure or a
// diagnostic is rendered here.
fn cli_load_package_profile_plan(cache: &WorkspaceDeclarationCache, theme: Theme, name: String) -[IO, FS, Env, Exec, Time.Wait]> PackageProfileLoad? Never! {
    project_dir :: cli_project_env_root(&cache, cli_current_dir())
    path :: EnvFile.path_in(project_dir)
    source :: files.read(path) ?? {
        theme.error("couldn't read {path}", "{err}", "create an env.jet with a `module profile.<name> {{ … }}` declaration")
        return None
    }
    plan :: envmodel_evaluate_package_profile(source, project_dir, name) ?? {
        terminal_write_output(diagnostics_render_all(ENV_FILE, source, [Diagnostic]{err.diagnostic}))
        return None
    }
    Val(PackageProfileLoad{project_dir: project_dir, source: source, plan: plan})
}

// E1335 provider-fact and collision refusals are coded; anything else is a
// generation failure.
fn cli_report_package_generation_error(theme: Theme, error: CLIError) -[IO, Time.Wait]> Int Never! {
    if error == {
        .ProviderFacts(message) -> theme.error_coded("E1335", message, "package-generation provider facts and exact path collisions must remain explicit", "pin the provider or add an exact collision selection, then rebuild")
        else -> theme.error("package generation failed", error.message(), "repair the reported source, provider, or generation state and retry")
    }
    EXIT_USAGE
}
