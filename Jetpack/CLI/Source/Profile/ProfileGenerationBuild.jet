// Source-backed package generations, ported from
// jetpack::CLI::profile. The source resolver owns package identity and
// provider facts; this module only realizes those facts, projects the
// outputs into an immutable generation root, records its lock, and publishes
// a checked pointer to one generation. State lives under
// `<project>/.jet/profiles/<name>`.

PACKAGE_PROFILE_STATE_DIR: "profiles"
PACKAGE_PROFILE_GENERATIONS_DIR: "generations"
PACKAGE_PROFILE_META_FILE: "meta.json"
PACKAGE_PROFILE_ROOTFS_DIR: "root"
PACKAGE_PROFILE_COMPLETE_FILE: "complete"
PACKAGE_PROFILE_CURRENT_FILE: "current"
PACKAGE_PROFILE_CURRENT_PARTIAL: "current.partial"
PACKAGE_PROFILE_STAGE_PREFIX: ".generation-"
PACKAGE_PROFILE_STAGE_SUFFIX: ".partial"
PACKAGE_PROFILE_SCHEMA: "jet-package-generation-v1"
PACKAGE_PROFILE_POINTER_SCHEMA: "jet-package-generation-pointer-v1"
PACKAGE_PROFILE_MAX_NODES: 100000
PACKAGE_PROFILE_LOCK_PREFIX: "package-profile-"

PackageOutputNodeKind: enum {
    File
    Directory
    Symlink

    as_str: fn(self) -> String Never! {
        if self == {
            .File -> "file"
            .Directory -> "directory"
            .Symlink -> "symlink"
        }
    }
}

// One filesystem node of a realized package output, relative to its root.
PackageOutputNode: struct {
    package: String
    path: String
    kind: PackageOutputNodeKind
    // `sha256-…` of a file's bytes or a symlink's target; empty for a directory.
    digest: String
    link_target: String?
}

// A realized package, its checked StoreEntry and lease, and its output nodes.
RealizedProfilePackage: struct {
    fact: PackageProfileFact
    entry: StoreEntry
    lease: CacheLease
    nodes: [PackageOutputNode]
}

// A complete generation: number, plan fingerprint, witness, and lock text.
PackageGenerationRecord: struct {
    generation: Int
    fingerprint: String
    witness: String
    metadata: String
}

PackageGenerationPointer: struct {
    generation: Int
    witness: String
}

// One recorded collision contender, in `(provider, kind, digest)` order.
PackageCollisionContender: struct {
    provider: String
    kind: String
    digest: String
}

PackageCollisionRecord: struct {
    selected: String?
    contenders: [PackageCollisionContender]
}

// A staged generation directory; unless published, it is removed at scope
// exit (a published stage no longer exists at its staged path).
PackageGenerationStage: struct {
    path: String

    create: fn(generations: String, generation: Int) -[FS]> PackageGenerationStage CLIError! {
        path: files.join(generations, "{PACKAGE_PROFILE_STAGE_PREFIX}{generation}{PACKAGE_PROFILE_STAGE_SUFFIX}")
        if cli_stat_optional(path) == .Val(existing) {
            if existing.is_symlink -> return Err(CLIError.Other("profile generation stage is a symlink"))
            if !existing.is_dir -> return Err(CLIError.Other("profile generation stage is not a directory"))
            files.remove_all(path)
        }
        files.create_dir(path)
        Ok(PackageGenerationStage{path: path})
    }

    publish: fn(self, destination: String) CLIError! -[FS]> {
        files.rename(self.path, destination)
    }
}

impl PackageGenerationStage.Close {
    close: fn(&&self) -[FS]> {
        if files.exists(self.path) -> files.remove_all(self.path).drop("an unpublished generation stage is scratch")
    }
}

cli_package_profile_state_dir: fn(project_dir: String, name: String) -> String Never! {
    files.join(files.join(pkg_managed_dir(project_dir), PACKAGE_PROFILE_STATE_DIR), name)
}

cli_package_generations_dir: fn(state: String) -> String Never! {
    files.join(state, PACKAGE_PROFILE_GENERATIONS_DIR)
}

// The per-profile project lock; released at scope exit.
cli_package_profile_lock: fn(project_dir: String, profile: String) -[FS, Env, Time]> RuntimeLock IOError! {
    env_runtime_project_lock(project_dir, "{PACKAGE_PROFILE_LOCK_PREFIX}{profile}")
}

// The Store root owner of a project's generations.
cli_package_profile_owner: fn(project_dir: String) -> String Never! {
    digest: pkg_sha256_hex(project_dir.bytes())
    "project-{String.from_bytes(digest.bytes()[0..<16]) ?? digest}"
}

// Realize every package fact, project the chosen outputs into a staged
// generation root, record and root its lock, and publish the generation.
cli_build_package_generation: fn(verification: &StoreVerification, cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed, project_dir: String, plan: PackageProfilePlan) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int CLIError! {
    realized := [RealizedProfilePackage]{}
    // Every realized lease is released whether or not the build succeeded.
    generation := 0
    failure := CLIError?{None}
    if cli_build_package_generation_body(verification, cache, theme, parsed, project_dir, plan, realized) == {
        .Ok(built) -> generation = built
        .Err(error) -> failure = Val(error)
    }
    loop package in realized.move() -> package.lease.release()
    if failure == .Val(error) -> return Err(error)
    Ok(generation)
}

cli_build_package_generation_body: fn(verification: &StoreVerification, cache: &WorkspaceDeclarationCache, theme: Theme, parsed: CLIParsed, project_dir: String, plan: PackageProfilePlan, realized: &[RealizedProfilePackage]) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int CLIError! {
    state: cli_package_profile_state_dir(project_dir, plan.name)
    generations: cli_package_generations_dir(state)
    files.create_dir_all(generations)
    previous: cli_read_package_generations(verification, state)
    generation: cli_next_package_generation(state)
    stage: PackageGenerationStage.create(generations, generation)
    generation_dir: stage.path
    final_generation_dir: files.join(generations, "{generation}")
    rootfs: files.join(generation_dir, PACKAGE_PROFILE_ROOTFS_DIR)
    roots: pkg_resolve_roots()
    table: cli_cwd_table(cache)
    name_width := 1
    loop package in plan.packages {
        if package.target.len() > name_width -> name_width = package.target.len()
    }
    loop package in plan.packages {
        spec: cli_package_realization_spec(package, table)
        live := LiveRegion?{None}
        outcome: cli_realize_ref_outcome(verification, theme, roots, parsed.flags, table, spec, name_width, RowStyle.Ledger, live, RealizeScope.UserProfile)
        if outcome == {
            .Realized(entry, _, _, lease) -> realized.push(RealizedProfilePackage{fact: package, entry: entry, lease: lease.move(), nodes: [PackageOutputNode]{}})
            .NeedsNix(need) -> {
                cli_report_nix_bridge_required(theme, parsed.flags, [NixBridgeNeed]{need}, [String]{})
                return Err(CLIError.Other("profile package needs the provider bridge before it can be generated"))
            }
            .Unavailable | .Failed -> {
                return Err(CLIError.Other("profile package realization failed"))
            }
        }
        index: realized.len() - 1
        realized[index].lease.validate()
        if !cli_is_canonical_digest(realized[index].entry.envelope.output_hash) -> return Err(CLIError.ProviderFacts("realized `{package.raw}` has no canonical output digest"))
        realized[index].nodes = cli_collect_output_nodes(realized[index].lease, package.raw)
    }
    groups := [String: [PackageOutputNode]]{}
    loop package in realized {
        loop node in package.nodes {
            contenders := groups.get(node.path) ?? [PackageOutputNode]{}
            contenders.push(node)
            groups[node.path] = contenders
        }
    }
    selected: cli_choose_output_nodes(plan, groups, previous)
    files.create_dir(rootfs)
    cli_copy_package_projection(rootfs, selected, realized)
    loop package in realized -> package.lease.validate()
    metadata: cli_format_package_generation_metadata(generation, plan, realized, groups, roots, rootfs)
    target_hashes := [String]{}
    loop package in realized -> target_hashes.push(package.entry.envelope.output_hash)
    targets: cli_sorted_unique(target_hashes)
    witness: cli_profile_generation_witness(metadata, targets)
    cli_write_synced(files.join(generation_dir, PACKAGE_PROFILE_META_FILE), metadata.bytes())
    owner: cli_package_profile_owner(project_dir)
    if targets.len() > 0 {
        prepared: store_prepare_profile_generation_root(verification, roots, owner, plan.name, generation, witness, targets, cli_now_secs()) ?? return Err(CLIError.Store(err))
        store_commit_profile_generation_root(verification, roots, prepared, cli_now_secs()) ?? return Err(CLIError.Store(err))
    }
    cli_write_synced(files.join(generation_dir, PACKAGE_PROFILE_COMPLETE_FILE), "{witness}\n".bytes())
    store_sync_store_directory(generation_dir) ?? return Err(CLIError.Store(err))
    store_sync_store_directory(generations) ?? return Err(CLIError.Store(err))
    stage.publish(final_generation_dir)
    store_sync_store_directory(generations) ?? return Err(CLIError.Store(err))
    Ok(generation)
}

// The exact ref a package fact realizes as. It must keep the provider
// identity the planner recorded (a `default`-source fact may realize through
// its `jetpack` alias).
cli_package_realization_spec: fn(package: PackageProfileFact, table: SourceTable) -> RefSpec CLIError! {
    package.provider_facts.validate() ?? return Err(CLIError.ProviderFacts(err.message))
    facts_reference: package.provider_facts.reference
    if facts_reference != package.raw -> return Err(CLIError.ProviderFacts("provider reference `{facts_reference}` disagrees with source ref `{package.raw}`"))
    target: if package.channel == {
        .Val(channel) -> "{package.target}#{channel}"
        .None -> package.target
    }
    source: if package.source == DEFAULT_SOURCE -> REF_SOURCE_JETPACK else -> package.source
    raw: if package.source == REF_SOURCE_PATH -> target else -> "{target}{REF_PROVIDER_AT}{source}"
    spec: RefSpec.classify_in(raw, table) ?? return Err(CLIError.ProviderFacts("unsupported profile ref: {err:Debug}"))
    default_alias := String?{None}
    if facts_reference.cut_last(REF_PROVIDER_AT) == .Val(halves) {
        if halves.after == DEFAULT_SOURCE -> default_alias = Val("{halves.before}{REF_PROVIDER_AT}{REF_SOURCE_JETPACK}")
    }
    if raw != facts_reference && (default_alias ?? "") != raw {
        return Err(CLIError.ProviderFacts("realized ref `{raw}` would discard provider identity `{facts_reference}`"))
    }
    Ok(spec)
}

// Pick one node per output path. Contenders must agree on kind (and, for
// symlinks, on target); differing contents need an explicit, still-current
// collision selection.
cli_choose_output_nodes: fn(plan: PackageProfilePlan, groups: [String: [PackageOutputNode]], previous: [PackageGenerationRecord]) -> [String: PackageOutputNode] CLIError! {
    loop path in cli_sorted_map_keys(plan.collisions) {
        provider: plan.collisions[path]
        nodes: groups.get(path) ?? return Err(CLIError.ProviderFacts("collision selection for `{path}` names `{provider}`, but no realized contender provides that path"))
        if !cli_nodes_include_package(nodes, provider) {
            return Err(CLIError.ProviderFacts("collision selection for `{path}` names `{provider}`, but contenders are {cli_contender_text(nodes)}"))
        }
    }
    selected := [String: PackageOutputNode]{}
    paths := groups.keys().to_list()
    paths.sort()
    loop path in paths {
        nodes: groups[path]
        kinds := [String]{}
        digests := [String]{}
        has_symlink := false
        loop node in nodes {
            if !kinds.contains(node.kind.as_str()) -> kinds.push(node.kind.as_str())
            if node.kind != PackageOutputNodeKind.Directory && !digests.contains(node.digest) -> digests.push(node.digest)
            if node.kind == PackageOutputNodeKind.Symlink -> has_symlink = true
        }
        if kinds.len() != 1 -> return Err(CLIError.ProviderFacts("collision at `{path}` has a file/directory or symlink-target type mismatch; contenders: {cli_contender_text(nodes)}"))
        if has_symlink && digests.len() > 1 -> return Err(CLIError.ProviderFacts("collision at `{path}` has a symlink-target mismatch; contenders: {cli_contender_text(nodes)}"))
        provider: plan.collisions.get(path)
        if digests.len() > 1 && provider == None -> return Err(CLIError.ProviderFacts("unresolved package collision at `{path}`; contenders: {cli_contender_text(nodes)}"))
        chosen := nodes[0]
        if provider == .Val(named) {
            cli_ensure_collision_selection_current(previous, path, named, nodes)
            loop node in nodes {
                if node.package == named {
                    chosen = node
                    break
                }
            }
        }
        selected[path] = chosen
    }
    Ok(selected)
}

cli_nodes_include_package: fn(nodes: [PackageOutputNode], package: String) -> Bool Never! {
    loop node in nodes {
        if node.package == package -> return true
    }
    false
}

cli_sorted_map_keys: fn(values: [String: String]) -> [String] Never! {
    keys := values.keys().to_list()
    keys.sort()
    keys
}

cli_sorted_contenders: fn(contenders: [PackageCollisionContender]) -> [PackageCollisionContender] Never! {
    sorted := contenders
    sorted.sort_by((left: PackageCollisionContender, right: PackageCollisionContender) -> (left.provider <=> right.provider).then(left.kind <=> right.kind).then(left.digest <=> right.digest))
    sorted
}

// A selection reviewed against one set of contender facts is stale when the
// newest generation recorded the same selection over different facts.
cli_ensure_collision_selection_current: fn(previous: [PackageGenerationRecord], path: String, provider: String, nodes: [PackageOutputNode]) CLIError! {
    if previous.len() == 0 -> return
    record: cli_package_collision_record(previous[previous.len() - 1].metadata, path) ?? return
    previous_provider: record.selected ?? return
    if previous_provider != provider -> return
    current := [PackageCollisionContender]{}
    loop node in nodes -> current.push(PackageCollisionContender{provider: node.package, kind: node.kind.as_str(), digest: node.digest})
    if cli_sorted_contenders(current) != record.contenders {
        return Err(CLIError.ProviderFacts("stale collision selection at `{path}` for `{provider}`; contender facts changed: {cli_contender_text(nodes)}; re-review `collisions` before rebuilding"))
    }
}

// The recorded collision at `path` in a generation lock, if any.
cli_package_collision_record: fn(metadata: String, path: String) -> PackageCollisionRecord? CLIError! {
    object: pkg_json_object(cli_json_parse(metadata)) ?? return Err(CLIError.Other(PKG_JSON_NOT_OBJECT))
    collisions_value: object.get("collisions") ?? return Ok(None)
    collisions: pkg_json_object(collisions_value) ?? return Ok(None)
    record_value: collisions.get(path) ?? return Ok(None)
    record: pkg_json_object(record_value) ?? return Err(CLIError.Other("profile collision record is not an object"))
    selected := String?{None}
    if record.get("selected") == .Val(value) {
        if value != Dyn.Null {
            text: pkg_json_text(value) ?? return Err(CLIError.Other(PKG_JSON_NOT_STRING))
            selected = Val(text)
        }
    }
    contender_values: record.get("contenders") ?? return Err(CLIError.Other("profile collision record lacks contenders"))
    items: pkg_json_array(contender_values) ?? return Err(CLIError.Other(PKG_JSON_NOT_ARRAY))
    contenders := [PackageCollisionContender]{}
    loop item in items {
        contender: pkg_json_object(item) ?? return Err(CLIError.Other(PKG_JSON_NOT_OBJECT))
        provider: cli_required_json_text(contender, "provider", "profile collision contender lacks provider")
        kind: cli_required_json_text(contender, "kind", "profile collision contender lacks kind")
        digest: cli_required_json_text(contender, "digest", "profile collision contender lacks digest")
        contenders.push(PackageCollisionContender{provider: provider, kind: kind, digest: digest})
    }
    Ok(Val(PackageCollisionRecord{selected: selected, contenders: cli_sorted_contenders(contenders)}))
}

// A required string field: `missing` when absent, the Dyn accessor
// message when not a string.
cli_required_json_text: fn(object: [String: Dyn], key: String, missing: String) -> String CLIError! {
    value: object.get(key) ?? return Err(CLIError.Other(missing))
    text: pkg_json_text(value) ?? return Err(CLIError.Other(PKG_JSON_NOT_STRING))
    Ok(text)
}

cli_contender_text: fn(nodes: [PackageOutputNode]) -> String Never! {
    parts := [String]{}
    loop node in nodes -> parts.push("{node.package} [{node.kind.as_str()} {node.digest}]")
    parts.join(", ")
}

cli_json_optional: fn(value: String?) -> String Never! {
    if value == {
        .Val(text) -> cli_json_quote(text)
        .None -> "null"
    }
}

// The generation lock: plan identity, root hash, every collision with more
// than one contender (or an explicit selection), and each realized package.
cli_format_package_generation_metadata: fn(generation: Int, plan: PackageProfilePlan, realized: [RealizedProfilePackage], groups: [String: [PackageOutputNode]], roots: HangarRoots, rootfs: String) -[FS, Env]> String CLIError! {
    packages := [String]{}
    loop package in realized {
        fact: package.fact
        packages.push("{{\"raw\":{cli_json_quote(fact.raw)},\"target\":{cli_json_quote(fact.target)},\"source\":{cli_json_quote(fact.source)},\"upstream\":{cli_json_optional(fact.upstream)},\"provider\":{cli_json_quote(fact.provider)},\"channel\":{cli_json_optional(fact.channel)},\"declared_by\":[{cli_json_quote_list(fact.declared_by)}],\"provider_facts\":{fact.provider_facts.to_json()},\"provider_facts_digest\":{cli_json_quote(fact.provider_facts.digest())},\"output_hash\":{cli_json_quote(package.entry.envelope.output_hash)},\"store_root\":{cli_json_quote(roots.root)}}}")
    }
    collisions := [String]{}
    paths := groups.keys().to_list()
    paths.sort()
    loop path in paths {
        nodes: groups[path]
        if nodes.len() <= 1 && !plan.collisions.has_key(path) -> next
        contenders := [String]{}
        loop node in nodes -> contenders.push("{{\"provider\":{cli_json_quote(node.package)},\"kind\":{cli_json_quote(node.kind.as_str())},\"digest\":{cli_json_quote(node.digest)}}}")
        collisions.push("{cli_json_quote(path)}:{{\"selected\":{cli_json_optional(plan.collisions.get(path))},\"contenders\":[{contenders.join(",")}]}}")
    }
    root_hash: pkg_try_output_hash_of(rootfs) ?? return Err(CLIError.Other(err.message()))
    Ok("{{\"schema\":{cli_json_quote(PACKAGE_PROFILE_SCHEMA)},\"profile\":{cli_json_quote(plan.name)},\"generation\":{generation},\"fingerprint\":{cli_json_quote(plan.fingerprint)},\"root_hash\":{cli_json_quote(root_hash)},\"selected_profiles\":[{cli_json_quote_list(plan.selected_profiles)}],\"applied\":[{cli_json_quote_list(plan.applied)}],\"sources\":[{cli_json_quote_list(plan.sources)}],\"collisions\":{{{collisions.join(",")}}},\"packages\":[{packages.join(",")}]}}\n")
}

// Every node below a realized output root, depth-first in name order, read
// through the directory the lease holds.
cli_collect_output_nodes: fn(lease: &CacheLease, package: String) -[FS]> [PackageOutputNode] CLIError! {
    info: lease.output_entry("")
    if !info.is_dir || info.is_symlink -> return Err(CLIError.ProviderFacts("realized `{package}` output is not a real directory"))
    nodes := [PackageOutputNode]{}
    cli_collect_output_nodes_inner(lease, "", package, nodes)
    Ok(nodes)
}

cli_collect_output_nodes_inner: fn(lease: &CacheLease, prefix: String, package: String, nodes: &[PackageOutputNode]) CLIError! -[FS]> {
    names := [String]{}
    loop entry in lease.list_output(prefix) -> names.push(entry.name)
    names.sort()
    loop name in names {
        if nodes.len() >= PACKAGE_PROFILE_MAX_NODES -> return Err(CLIError.Other("profile output contains too many filesystem nodes"))
        path: if prefix == "" -> name else -> "{prefix}/{name}"
        parts: path.split("/").to_list()
        if path == "" || parts.contains("..") || parts.contains("") -> return Err(CLIError.Other("profile output contains an unsafe relative path"))
        info: lease.output_entry(path)
        if {
            info.is_symlink -> {
                target: lease.read_output_link(path)
                digest: "sha256-{pkg_sha256_hex("symlink:{target}".bytes())}"
                nodes.push(PackageOutputNode{package: package, path: path, kind: PackageOutputNodeKind.Symlink, digest: digest, link_target: Val(target)})
            }
            info.is_dir -> {
                nodes.push(PackageOutputNode{package: package, path: path, kind: PackageOutputNodeKind.Directory, digest: "", link_target: None})
                cli_collect_output_nodes_inner(lease, path, package, nodes)
            }
            info.is_file -> {
                input := lease.open_output(path)
                hasher := StreamingSHA256.new()
                loop {
                    chunk: input.read(65536)
                    if chunk.len() == 0 -> break
                    hasher.update(chunk)
                }
                nodes.push(PackageOutputNode{package: package, path: path, kind: PackageOutputNodeKind.File, digest: "sha256-{hasher.finalize_hex()}", link_target: None})
            }
            else -> {
                return Err(CLIError.ProviderFacts("profile output contains unsupported node `{path}`"))
            }
        }
    }
}

// Materialize the selected nodes under the generation root, in path order.
// File bytes stream from the handle each package's lease holds.
cli_copy_package_projection: fn(root: String, selected: [String: PackageOutputNode], realized: &[RealizedProfilePackage]) CLIError! -[FS, Env]> {
    paths := selected.keys().to_list()
    paths.sort()
    loop relative in paths {
        node: selected[relative]
        destination: cli_safe_projection_path(root, relative)
        if node.kind == {
            .Directory -> {
                if cli_stat_optional(destination) == .Val(existing) {
                    if existing.is_symlink || !existing.is_dir -> return Err(CLIError.Other("profile projection type changed at `{relative}`"))
                } else {
                    files.create_dir_all(destination)
                }
            }
            .File -> {
                cli_ensure_projection_parent(destination)
                owner := Int?{None}
                loop index in 0..<realized.len() {
                    if owner == None && realized[index].fact.raw == node.package -> owner = Val(index)
                }
                at: owner ?? return Err(CLIError.Other("profile projection node `{relative}` lost its package lease"))
                cli_copy_projection_file(realized[at].lease, node.path, destination, node.digest)
            }
            .Symlink -> {
                cli_ensure_projection_parent(destination)
                if sys.is_windows() -> return Err(CLIError.Other("profile generation cannot materialize symlinks on this platform"))
                target: node.link_target ?? return Err(CLIError.Other("profile symlink lost its target"))
                files.symlink(target, destination)
            }
        }
    }
    store_sync_store_directory(root) ?? return Err(CLIError.Store(err))
}

cli_safe_projection_path: fn(root: String, relative: String) -> String CLIError! {
    if files.is_abs(relative) || relative.replace("\\", "/").split("/").to_list().contains("..") -> return Err(CLIError.Other("profile projection path is unsafe"))
    Ok(files.join(root, relative))
}

cli_ensure_projection_parent: fn(path: String) CLIError! -[FS]> {
    parent: files.dirname(path)
    if parent == "" -> return Err(CLIError.Other("profile projection has no parent"))
    files.create_dir_all(parent)
}

// Copy one regular file from its lease, keep its permission bits, and prove
// the copy still has the digest the node recorded.
cli_copy_projection_file: fn(lease: &CacheLease, relative: String, destination: String, expected: String) CLIError! -[FS, Env]> {
    info: lease.output_entry(relative)
    if info.is_symlink || !info.is_file -> return Err(CLIError.Other("profile projection source is not a regular file"))
    input := lease.open_output(relative)
    proof: store_reuse_copy_open_profile_file(input, destination)
    if proof.digest != expected -> return Err(CLIError.Other("profile projection source changed while copying"))
}

// Remove every abandoned `.generation-<n>.partial` stage.
cli_cleanup_package_generation_stages: fn(directory: String) CLIError! -[FS]> {
    removed := false
    loop entry in files.list_dir(directory) {
        inner: cli_strip_prefix(entry.name, PACKAGE_PROFILE_STAGE_PREFIX) ?? next
        if !inner.ends_with(PACKAGE_PROFILE_STAGE_SUFFIX) -> next
        number: cli_parse_u64(inner.removesuffix(PACKAGE_PROFILE_STAGE_SUFFIX)) ?? 0
        if number == 0 -> return Err(CLIError.Other("profile generation stage name is invalid"))
        info: files.stat(entry.path)
        if info.is_symlink || !info.is_dir -> return Err(CLIError.Other("profile generation stage is not a real directory"))
        files.remove_all(entry.path)
        removed = true
    }
    if removed -> store_sync_store_directory(directory) ?? return Err(CLIError.Store(err))
}

cli_next_package_generation: fn(state: String) -[FS]> Int CLIError! {
    directory: cli_package_generations_dir(state)
    files.create_dir_all(directory)
    maximum := 0
    loop entry in files.list_dir(directory) {
        info: files.stat(entry.path)
        if info.is_symlink || !info.is_dir -> next
        generation: cli_parse_u64(entry.name) ?? next
        if generation > maximum -> maximum = generation
    }
    if maximum == CLI_INT_MAX -> return Err(CLIError.Other("profile generation number overflow"))
    Ok(maximum + 1)
}

// Every complete generation, ascending; abandoned stages are removed first.
cli_read_package_generations: fn(verification: &StoreVerification, state: String) -[FS, Env, Time]> [PackageGenerationRecord] CLIError! {
    directory: cli_package_generations_dir(state)
    info: cli_stat_optional(directory) ?? return Ok([PackageGenerationRecord]{})
    if info.is_symlink || !info.is_dir -> return Err(CLIError.Other("profile generations path is not a real directory"))
    cli_cleanup_package_generation_stages(directory)
    numbers := [Int]{}
    loop entry in files.list_dir(directory) {
        entry_info: files.stat(entry.path)
        if entry_info.is_symlink || !entry_info.is_dir -> next
        generation: cli_parse_u64(entry.name) ?? next
        numbers.push(generation)
    }
    numbers.sort()
    records := [PackageGenerationRecord]{}
    loop generation in numbers {
        complete: files.join(files.join(directory, "{generation}"), PACKAGE_PROFILE_COMPLETE_FILE)
        marker: cli_stat_optional(complete) ?? next
        if marker.is_symlink || !marker.is_file -> return Err(CLIError.Other("profile generation completion marker is not a regular file"))
        records.push(cli_read_package_generation_record(verification, state, generation))
    }
    Ok(records)
}

cli_positive_json_int: fn(value: Dyn?) -> Int? Never! {
    tree: value ?? return None
    number: foundation_json_integer(tree) ?? return None
    if number > 0 -> Val(number) else -> None
}

// One complete generation, with every recorded fact revalidated: schema,
// profile, number, fingerprint, root hash, each package's provider facts and
// their digest, the completion witness, the projected root, and its Store
// root.
cli_read_package_generation_record: fn(verification: &StoreVerification, state: String, generation: Int) -[FS, Env, Time]> PackageGenerationRecord CLIError! {
    directory: files.join(cli_package_generations_dir(state), "{generation}")
    metadata: cli_read_bounded(files.join(directory, PACKAGE_PROFILE_META_FILE))
    object: pkg_json_object(cli_json_parse(metadata)) ?? return Err(CLIError.Other(PKG_JSON_NOT_OBJECT))
    schema: cli_required_json_text(object, "schema", "profile generation metadata lacks schema")
    if schema != PACKAGE_PROFILE_SCHEMA -> return Err(CLIError.Other("profile generation metadata schema is unsupported"))
    recorded_profile: cli_required_json_text(object, "profile", "profile generation metadata lacks profile")
    expected_profile: files.basename(state)
    if expected_profile == "" -> return Err(CLIError.Other("profile state path has no valid name"))
    if recorded_profile != expected_profile -> return Err(CLIError.Other("profile generation metadata profile disagrees with its path"))
    actual_generation: cli_positive_json_int(object.get("generation")) ?? return Err(CLIError.Other("profile generation metadata lacks generation"))
    if actual_generation != generation -> return Err(CLIError.Other("profile generation metadata number disagrees with its path"))
    fingerprint: cli_required_json_text(object, "fingerprint", "profile generation metadata lacks fingerprint")
    if fingerprint == "" -> return Err(CLIError.Other("profile generation fingerprint is empty"))
    if !cli_is_canonical_digest(fingerprint) -> return Err(CLIError.Other("profile generation fingerprint is not canonical"))
    root_hash: cli_required_json_text(object, "root_hash", "profile generation metadata lacks root hash")
    if !cli_is_canonical_digest(root_hash) -> return Err(CLIError.Other("profile generation root hash is not canonical"))
    packages_value: object.get("packages") ?? return Err(CLIError.Other("profile generation metadata lacks packages"))
    packages: pkg_json_array(packages_value) ?? return Err(CLIError.Other(PKG_JSON_NOT_ARRAY))
    targets := [String]{}
    loop package_value in packages {
        package: pkg_json_object(package_value) ?? return Err(CLIError.Other(PKG_JSON_NOT_OBJECT))
        targets.push(cli_validate_package_generation_entry(package))
    }
    marker_text: cli_read_bounded(files.join(directory, PACKAGE_PROFILE_COMPLETE_FILE))
    marker: marker_text.trim()
    if !cli_is_canonical_digest(marker) -> return Err(CLIError.Other("profile generation completion witness is invalid"))
    sorted_targets: cli_sorted_unique(targets)
    if marker != cli_profile_generation_witness(metadata, sorted_targets) -> return Err(CLIError.Other("profile generation completion witness mismatches metadata"))
    root: files.join(directory, PACKAGE_PROFILE_ROOTFS_DIR)
    root_info: files.stat(root)
    if root_info.is_symlink || !root_info.is_dir -> return Err(CLIError.Other("profile generation root is not a real directory"))
    actual_root_hash: pkg_try_output_hash_of(root) ?? return Err(CLIError.Other(err.message()))
    if actual_root_hash != root_hash -> return Err(CLIError.Other("profile generation root hash disagrees with its lock"))
    project_dir: files.dirname(files.dirname(files.dirname(state)))
    if project_dir == "" -> return Err(CLIError.Other("profile generation state has no project root"))
    store_validate_profile_generation_root(verification, pkg_resolve_roots(), cli_package_profile_owner(project_dir), expected_profile, generation, marker, sorted_targets) ?? return Err(CLIError.Store(err))
    Ok(PackageGenerationRecord{generation: generation, fingerprint: fingerprint, witness: marker, metadata: metadata})
}

// One recorded package: its output digest, and provider facts that parse,
// validate, match their digest, and agree with the package's raw ref,
// target, and provider. Returns the output digest.
cli_validate_package_generation_entry: fn(package: [String: Dyn]) -> String CLIError! {
    output_hash: cli_required_json_text(package, "output_hash", "profile generation package lacks output hash")
    if !cli_is_canonical_digest(output_hash) -> return Err(CLIError.Other("profile generation package has invalid output hash"))
    facts_value: package.get("provider_facts") ?? return Err(CLIError.Other("profile generation package lacks provider facts"))
    parsed_facts: ProviderFacts.from_json_tree(facts_value) ?? return Err(CLIError.Other("profile generation provider facts are invalid: {err.message}"))
    parsed_facts.validate() ?? return Err(CLIError.Other("profile generation provider facts fail validation: {err.message}"))
    digest: cli_required_json_text(package, "provider_facts_digest", "profile generation package lacks provider facts digest")
    if digest != parsed_facts.digest() -> return Err(CLIError.Other("profile generation provider facts digest disagrees with its record"))
    raw: cli_required_json_text(package, "raw", "profile generation package lacks raw ref")
    if parsed_facts.reference != raw -> return Err(CLIError.Other("profile generation provider reference disagrees with its raw ref"))
    target: cli_required_json_text(package, "target", "profile generation package lacks target")
    if parsed_facts.target != target -> return Err(CLIError.Other("profile generation provider target disagrees with its package target"))
    provider: cli_required_json_text(package, "provider", "profile generation package lacks provider")
    if parsed_facts.provider != provider -> return Err(CLIError.Other("profile generation provider identity disagrees with its package provider"))
    facts: pkg_json_object(facts_value) ?? return Err(CLIError.Other(PKG_JSON_NOT_OBJECT))
    required: [String]{"schema", "provider", "reference", "selector", "facts", "losses", "conflicts"}
    loop key in required {
        if !facts.has_key(key) -> return Err(CLIError.Other("profile generation provider facts lack `{key}`"))
    }
    Ok(output_hash)
}

// The published pointer, verified against the generation it names.
cli_read_package_current_pointer: fn(verification: &StoreVerification, state: String) -[FS, Env, Time]> PackageGenerationPointer? CLIError! {
    path: files.join(state, PACKAGE_PROFILE_CURRENT_FILE)
    info: cli_stat_optional(path) ?? return Ok(None)
    if info.is_symlink || !info.is_file -> return Err(CLIError.Other("profile current pointer is not a regular file"))
    object: pkg_json_object(cli_json_parse(cli_read_bounded(path))) ?? return Err(CLIError.Other(PKG_JSON_NOT_OBJECT))
    schema: cli_required_json_text(object, "schema", "profile current pointer lacks schema")
    if schema != PACKAGE_PROFILE_POINTER_SCHEMA -> return Err(CLIError.Other("profile current pointer schema is unsupported"))
    generation: cli_positive_json_int(object.get("generation")) ?? return Err(CLIError.Other("profile current pointer lacks generation"))
    witness: cli_required_json_text(object, "witness", "profile current pointer lacks witness")
    if !cli_is_canonical_digest(witness) -> return Err(CLIError.Other("profile current pointer witness is invalid"))
    record: cli_read_package_generation_record(verification, state, generation)
    if record.witness != witness -> return Err(CLIError.Other("profile current pointer witness disagrees with its generation"))
    Ok(Val(PackageGenerationPointer{generation: generation, witness: witness}))
}

// Point `current` at one verified generation (refusing a stale one when the
// plan fingerprint is given) and re-read the pointer to prove it.
cli_activate_package_generation: fn(verification: &StoreVerification, project_dir: String, profile: String, generation: Int, expected_fingerprint: String?) -[FS, Env, Time]> PackageGenerationRecord CLIError! {
    state: cli_package_profile_state_dir(project_dir, profile)
    record: cli_read_package_generation_record(verification, state, generation)
    if expected_fingerprint == .Val(expected) {
        if record.fingerprint != expected -> return Err(CLIError.Other("profile generation is stale for the current source plan; rebuild before switching"))
    }
    files.create_dir_all(state)
    pointer: "{{\"schema\":{cli_json_quote(PACKAGE_PROFILE_POINTER_SCHEMA)},\"generation\":{generation},\"witness\":{cli_json_quote(record.witness)}}}\n"
    partial: files.join(state, PACKAGE_PROFILE_CURRENT_PARTIAL)
    if cli_stat_optional(partial) != None -> files.remove(partial)
    cli_write_synced(partial, pointer.bytes())
    cli_finalize_profile_pointer(partial, files.join(state, PACKAGE_PROFILE_CURRENT_FILE))
    store_sync_store_directory(state) ?? return Err(CLIError.Store(err))
    current: cli_read_package_current_pointer(verification, state) ?? return Err(CLIError.Other("profile current pointer disappeared after publication"))
    if current.generation != generation || current.witness != record.witness -> return Err(CLIError.Other("profile current pointer failed post-write verification"))
    Ok(record)
}

// The immutable `profile.dev` projection the project shell puts on PATH.
// `switch` selects the active generation; the shell never rebuilds a profile
// or adds source outputs directly. `--env` selects an environment module,
// not a package generation.
cli_dev_shell_projection: fn(verification: &StoreVerification, project_dir: String, environment: EnvironmentFacts) -[FS, Env, Time]> String? CLIError! {
    name: "dev"
    declared := false
    loop profile in environment.package_profiles {
        if profile.name == name -> declared = true
    }
    if !declared -> return Ok(None)
    state: cli_package_profile_state_dir(project_dir, name)
    current: cli_read_package_current_pointer(verification, state) ?? return Err(CLIError.Other("package profile `{name}` has no active generation; run `jet profile build {name}` then `jet profile switch {name}`"))
    record: cli_read_package_generation_record(verification, state, current.generation)
    if record.witness != current.witness -> return Err(CLIError.Other("package profile current pointer disagrees with its generation"))
    bin: files.join(files.join(files.join(cli_package_generations_dir(state), "{current.generation}"), PACKAGE_PROFILE_ROOTFS_DIR), "bin")
    info: cli_stat_optional(bin) ?? return Ok(None)
    if info.is_symlink || !info.is_dir -> return Err(CLIError.Other("package profile shell projection is not a real bin directory"))
    Ok(Val(bin))
}
