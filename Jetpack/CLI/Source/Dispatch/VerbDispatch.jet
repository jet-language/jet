// The jetpack verb dispatcher, ported from jetpack::CLI::parse::main. It
// refuses retired spellings with their teaching diagnostics, runs the legacy
// Hangar migration and user-tools drift check before mutating commands, and
// routes one typed verb to its command. JetOS verbs (`os`, `user`,
// `studio`, `push`) are not part of this port.

// Every verb this dispatcher routes.
enum JetpackVerb {
    Doctor
    Env
    Use
    Config
    Trust
    Hangar
    Audit
    Import
    Add
    Remove
    Update
    Lock
    Outdated
    Search
    Info
    Explain
    Why
    Logs
    ServiceProbe
    Override
    Image
    Bridge
    Services
    Secrets
    Tool
    Profile
    Browser
    Help

    fn parse(text: String) -> JetpackVerb? Never! {
        if text == {
            "doctor" -> Val(JetpackVerb.Doctor)
            "env" -> Val(JetpackVerb.Env)
            "use" -> Val(JetpackVerb.Use)
            CONFIG_SUBCOMMAND -> Val(JetpackVerb.Config)
            TRUST_SUBCOMMAND -> Val(JetpackVerb.Trust)
            "hangar" -> Val(JetpackVerb.Hangar)
            "audit" -> Val(JetpackVerb.Audit)
            JETPACK_IMPORT_VERB -> Val(JetpackVerb.Import)
            "add" -> Val(JetpackVerb.Add)
            "remove" -> Val(JetpackVerb.Remove)
            "update" -> Val(JetpackVerb.Update)
            JETPACK_LOCK_VERB -> Val(JetpackVerb.Lock)
            "outdated" -> Val(JetpackVerb.Outdated)
            "search" -> Val(JetpackVerb.Search)
            "info" -> Val(JetpackVerb.Info)
            "explain" -> Val(JetpackVerb.Explain)
            JETPACK_WHY -> Val(JetpackVerb.Why)
            "logs" -> Val(JetpackVerb.Logs)
            "__service-probe" -> Val(JetpackVerb.ServiceProbe)
            "override" -> Val(JetpackVerb.Override)
            IMAGE_SUBCOMMAND -> Val(JetpackVerb.Image)
            BRIDGE_SUBCOMMAND -> Val(JetpackVerb.Bridge)
            SERVICES_SUBCOMMAND -> Val(JetpackVerb.Services)
            SECRETS_SUBCOMMAND -> Val(JetpackVerb.Secrets)
            TOOL_SUBCOMMAND -> Val(JetpackVerb.Tool)
            PROFILE_SUBCOMMAND -> Val(JetpackVerb.Profile)
            BROWSER_SUBCOMMAND -> Val(JetpackVerb.Browser)
            "help" | "--help" | "-h" -> Val(JetpackVerb.Help)
            else -> None
        }
    }
}

// The refusal for a flag jetpack does not have, before the argument separator,
// or None. The argument parser has no unknown-flag check of its own.
fn cli_unknown_flag(before_separator: [String]) -> Diagnostic? Never! {
    env_prefix :: "{ENV_FLAG_ENV_UNKNOWN}="
    loop arg in before_separator {
        if arg == ENV_FLAG_ENV_UNKNOWN || arg.starts_with(env_prefix) {
            return Val(diagnostic_from_registry("E1342", None, "jetpack has no `{ENV_FLAG_ENV_UNKNOWN}` flag", "the environment selector chooses one `env.<name>` module; `--preset` chooses a named composition", "select the module with `{ENV_FLAG_ENV} <name>`"))
        }
    }
    if before_separator.contains(ENV_FLAG_PROFILE_UNKNOWN) {
        return Val(diagnostic_from_registry("E1300", None, "jetpack has no `{ENV_FLAG_PROFILE_UNKNOWN}` flag", "profile answers how hard to optimize a build; a named environment composition is a preset", "select the composition with `{ENV_FLAG_PRESET} <name>`, declared under `{ENV_FIELD_PRESETS}:`"))
    }
    if before_separator.contains(ENV_FLAG_PREP_UNKNOWN) {
        return Val(diagnostic_from_registry("E1353", None, "jetpack has no `{ENV_FLAG_PREP_UNKNOWN}` flag", "Jetpack materialization is an explicit preparation step, not a second command spelling", "use `{ENV_FLAG_PREP}` on `env` or `use`"))
    }
    None
}

// Read-only commands observe state without repairing or migrating it: a
// `hangar list` must not create its profile lock or rewrite a drifted pin.
fn cli_read_only_command(verb: String, parsed: CLIParsed) -> Bool Never! {
    first :: parsed.positional.get(0) ?? ""
    second :: parsed.positional.get(1) ?? ""
    hangar :: verb == "hangar"
    shared_status :: hangar && first == "shared" && second == "status"
    hangar_doctor :: hangar && first == "doctor" && !parsed.positional.contains("--repair")
    hangar_list :: hangar && first == "list"
    shared_status || verb == "doctor" || verb == "audit" || verb == JETPACK_WHY || verb == JETPACK_LOCK_VERB || hangar_doctor || hangar_list
}

// Process entry after invocation setup. Returns the process exit code.
fn cli_main(args: [String], invocation: DiagnosticInvocation) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    verification := StoreVerification.new()
    // Bare `jetpack` is the keyboard-first dashboard; its own TTY guard keeps
    // the status-summary floor for pipes, CI, and redirected output.
    verb :: args.get(0) ?? return cli_run_dashboard(&verification)
    rest :: cli_tail(args, 1)
    if verb == "cc" || verb == "c++" -> return cli_cc_main(&verification, verb, rest)
    // GateWriters.rs:266 / Source/main.rs:1537: invocation choices must
    // be refused before migration, profile drift repair, or any command.
    if pkg_check_invocation_flags(cli_current_dir(), cli_before_argument_separator(args)) == .Err(error) {
        loop diagnostic in error.diagnostics {
            terminal_write_output(diagnostic_render_all("command line", "", [Diagnostic]{diagnostic}, false))
        }
        return EXIT_USAGE
    }
    parsed :: cli_parse_args_for(verb, rest)
    color :: if parsed.flags.json -> ColorChoice.Never else -> parsed.flags.color
    theme :: Theme.resolve_choice(color).with_invocation(invocation)
    if env_reject_filter_dsl(rest) == .Val(diagnostic) {
        theme.error_coded(diagnostic.code, diagnostic.what, diagnostic.why, diagnostic.fix)
        return EXIT_USAGE
    }
    if cli_unknown_flag(cli_before_argument_separator(rest)) == .Val(diagnostic) {
        theme.error_coded(diagnostic.code, diagnostic.what, diagnostic.why, diagnostic.fix)
        return EXIT_USAGE
    }
    read_only :: cli_read_only_command(verb, parsed)
    if !read_only {
        if store_migrate_legacy_hangar(pkg_resolve_roots()) == .Err(error) {
            store_report_integrity(theme, IntegrityFailure{
                package: "Hangar path migration",
                version: "legacy",
                expected: "complete native per-user Hangar",
                actual: error.message(),
                reason: "reversible Hangar path migration",
                disposition: "Jetpack stopped before reading or changing package state.",
                fix_text: "Inspect the reported Hangar path and migration staging path; move unsafe nodes aside without deleting them, then retry the command.",
            })
            return EXIT_USAGE
        }
        drift_code :: cli_check_user_tools_drift(&verification, theme, parsed)
        if drift_code != 0 -> return drift_code
    }
    code :: if JetpackVerb.parse(verb) == {
        .Val(known) -> cli_dispatch_verb(&verification, known, theme, color, parsed)
        .None -> {
            theme.error("`{verb}` is not a jetpack command", "Phase 1 commands are: {JETPACK_VERBS.join(", ")}.", "run `jetpack help` to see them.")
            EXIT_USAGE
        }
    }
    if store_seal_census_report(&verification) == .Val(report) -> terminal_write_output(report)
    code
}

fn cli_dispatch_verb(verification: &StoreVerification, verb: JetpackVerb, theme: Theme, color: ColorChoice, parsed: CLIParsed) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Int Never! {
    if verb == {
        .Doctor -> cli_cmd_doctor(&verification, theme, parsed)
        .Env -> cli_cmd_env(&verification, theme, parsed)
        .Use -> cli_cmd_use(&verification, theme, parsed)
        .Config -> cli_cmd_config(theme, parsed)
        .Trust -> cli_cmd_trust(theme, parsed)
        .Hangar -> cli_cmd_hangar(&verification, theme, parsed)
        .Audit -> cli_cmd_audit(&verification, theme)
        .Import -> cli_cmd_import(theme, parsed)
        .Add -> cli_cmd_add(&verification, theme, parsed)
        .Remove -> cli_cmd_remove(theme, parsed)
        .Update -> cli_cmd_update(&verification, theme, parsed)
        .Lock -> cli_cmd_lock(theme, parsed)
        .Outdated -> cli_cmd_outdated(theme, parsed)
        .Search -> cli_cmd_search(&verification, theme, parsed)
        .Info -> cli_cmd_info(&verification, theme, parsed)
        .Explain -> cli_cmd_explain(&verification, theme, parsed)
        .Why -> cli_cmd_why(&verification, theme, parsed)
        .Logs -> cli_cmd_logs(theme, parsed)
        .ServiceProbe -> cli_cmd_service_probe(&verification, theme, parsed)
        .Override -> cli_cmd_override(theme, parsed)
        .Image -> cli_cmd_image(&verification, theme, parsed)
        .Bridge -> cli_cmd_bridge(theme, parsed)
        .Services -> cli_cmd_services(&verification, theme, parsed)
        .Secrets -> cli_cmd_secrets(theme, parsed)
        .Tool -> cli_cmd_tool(&verification, theme, parsed)
        .Profile -> cli_cmd_profile(&verification, theme, parsed)
        .Browser -> cli_cmd_browser(&verification, theme, parsed)
        .Help -> {
            help_theme :: Theme.resolve_for(color, term.stdout().is_tty())
            print(cli_usage_with_color(help_theme.color))
            EXIT_OK
        }
    }
}
