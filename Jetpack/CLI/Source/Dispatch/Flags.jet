// Jetpack argv parsing, ported from jetpack::CLI::parse (Flags, Parsed,
// parse_args_for). One ordered arm table maps each flag spelling to its
// typed field; everything else is positional, and a `--` hands the rest to
// the child command untouched. `cli_verb_flags` lists the flags each verb
// takes, and `cli_unknown_flag` refuses any other flag before the command runs.

// Parsed global flags shared by every command.
CLIFlags: struct {
    color: ColorChoice
    fixtures: String?
    // Explicit local unofficial nixpkgs catalog. It has no publisher
    // signature and is never selected by default.
    local_nix_catalog: String?
    offline: Bool
    online: Bool
    // U19: one-shot bypass of the env/dev trust gate (`--trust`); it never
    // persists a grant.
    trust: Bool
    // U16: ad-hoc packages from `-p <pkg>...`, repeatable.
    packages: [String]
    // U16: force foreign-flake/devenv detection over declared `env.*`.
    flake: Bool
    // U16: isolate the foreign projected shell from host variables.
    pure: Bool
    // Materialize without entering a shell.
    prep: Bool
    // Card #2214: show the full environment acquisition plan.
    explain_plan: Bool
    // The registry ref or local layout `image --push` targets.
    push: String?
    // The generic `--name <name>` flag (`hangar ingest`).
    name: String?
    // The named environment composition under `presets:`.
    preset: String?
    // Explicit selector for one `env.<name>` module.
    environment: String?
    // U20: `jetpack add <ref> --adapt` drafts an adapter declaration.
    adapt: Bool
    // Emit machine-readable output where the command has a structured form.
    json: Bool
    // U27: open a shell in preserved failed build scratch.
    shell_on_fail: Bool
    // `jet trust grant <selector> --scope repo|user`.
    trust_scope: String?
    // Bypass mutation confirmation gates (`-y` / `--yes`).
    assume_yes: Bool
    // Narrow `jetpack update` to project dependencies or
    // to user tools.
    update_deps: Bool
    update_tools: Bool
    // Card #2218: git revision used by `jetpack lock diff`.
    lock_against: String?
    // `jetpack tool install <ref> --as <name>`.
    as_name: String?
    // (#1187): browser lock/provision inputs; `--version` is also the
    // `hangar ingest` object version.
    browser_binary: String?
    version: String?
    browser_protocol: String?
    browser_driver: String?
    // Hangar archive destination, signer, and source.
    archive_to: String?
    archive_key: String?
    archive_from: String?
    // Export only the selected object, not its closure.
    archive_no_deps: Bool
    // Explicit expert escape hatch for a local unsigned archive.
    archive_allow_unsigned: Bool
    // Host-owned cache role and typed credential
    // provider label (never a secret) the write grant.
    cache_role: String?
    cache_credential: String?
    cache_write: Bool
    // Hangar switches: `du --all`, `doctor --repair`, `shared enroll --read-only`.
    hangar_all: Bool
    hangar_repair: Bool
    read_only: Bool
    // `secrets keygen --force` overwrites an existing identity.
    force: Bool
    // `split|fold --check` previews the transition without writing.
    transition_check: Bool

    empty: fn() -> CLIFlags Never! {
        CLIFlags{
            color: ColorChoice.Auto,
            fixtures: None,
            local_nix_catalog: None,
            offline: false,
            online: false,
            trust: false,
            packages: [String]{},
            flake: false,
            pure: false,
            prep: false,
            explain_plan: false,
            push: None,
            name: None,
            preset: None,
            environment: None,
            adapt: false,
            json: false,
            shell_on_fail: false,
            trust_scope: None,
            assume_yes: false,
            update_deps: false,
            update_tools: false,
            lock_against: None,
            as_name: None,
            browser_binary: None,
            version: None,
            browser_protocol: None,
            browser_driver: None,
            archive_to: None,
            archive_key: None,
            archive_from: None,
            archive_no_deps: false,
            archive_allow_unsigned: false,
            cache_role: None,
            cache_credential: None,
            cache_write: false,
            hangar_all: false,
            hangar_repair: false,
            read_only: false,
            force: false,
            transition_check: false,
        }
    }
}

// Flags, positional arguments, and the command after a `--`.
CLIParsed: struct {
    flags: CLIFlags
    positional: [String]
    // Everything after a `--`, if present.
    command: [String]?
}

// `args[start..]` as an owned list.
cli_tail: fn(args: [String], start: Int) -> [String] Never! {
    out := [String]{}
    loop index in start..<args.len() -> out.push(args[index])
    out
}

// Rust `str::trim_start_matches`: strip every leading copy of `prefix`.
cli_trim_start_matches: fn(text: String, prefix: String) -> String Never! {
    if prefix == "" -> return text.copy()
    rest := text
    loop rest.starts_with(prefix) -> rest = rest.removeprefix(prefix)
    rest
}

// The value after a flag at `args[index]`, when present.
cli_flag_argument: fn(args: [String], index: Int) -> String? Never! {
    if index < args.len() -> return Val(args[index])
    None
}

// Verb-agnostic parse.
cli_parse_args: fn(args: [String]) -> CLIParsed Never! {
    cli_parse_args_for("", args)
}

// Verb-aware parse: `update` and `lock` own their scope flags.
cli_parse_args_for: fn(verb: String, args: [String]) -> CLIParsed Never! {
    lock_verb: verb == JETPACK_LOCK_VERB
    lock_against_prefix: "{LOCK_DIFF_FLAG_AGAINST}="
    flags := CLIFlags.empty()
    positional := [String]{}
    command := [String]?{None}
    index := 0
    loop index < args.len() {
        arg: args[index]
        if arg == "--" {
            command = Val(cli_tail(args, index + 1))
            break
        }
        if {
            arg == "--no-color" -> flags.color = ColorChoice.Never
            arg.starts_with("--color=") -> flags.color = ColorChoice.parse(cli_trim_start_matches(arg, "--color="))
            arg == "--offline" -> flags.offline = true
            arg == "--online" -> flags.online = true
            arg == CLI_FLAG_YES_SHORT || arg == CLI_FLAG_YES_LONG -> flags.assume_yes = true
            verb == "update" && arg == UPDATE_FLAG_DEPS -> flags.update_deps = true
            verb == "update" && arg == UPDATE_FLAG_TOOLS -> flags.update_tools = true
            lock_verb && arg == LOCK_DIFF_FLAG_AGAINST -> {
                index += 1
                flags.lock_against = Val(cli_flag_argument(args, index) ?? "")
            }
            lock_verb && arg.starts_with(lock_against_prefix) -> flags.lock_against = Val(cli_trim_start_matches(arg, lock_against_prefix))
            arg == TRUST_BYPASS_FLAG -> flags.trust = true
            arg == ENV_FLAG_FLAKE -> flags.flake = true
            arg == ENV_FLAG_PURE -> flags.pure = true
            arg == ENV_FLAG_PREP -> flags.prep = true
            arg == ENV_FLAG_EXPLAIN -> flags.explain_plan = true
            arg == ENV_FLAG_PRESET -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(name) -> flags.preset = Val(name)
            }
            arg == ENV_FLAG_ENV -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(name) -> flags.environment = Val(name)
            }
            arg == "--all" -> flags.hangar_all = true
            arg == "--repair" -> flags.hangar_repair = true
            arg == "--read-only" -> flags.read_only = true
            arg == SECRETS_FLAG_FORCE -> flags.force = true
            arg == "--adapt" -> flags.adapt = true
            (verb == TRANSITION_SPLIT_VERB || verb == TRANSITION_FOLD_VERB) && arg == TRANSITION_FLAG_CHECK -> flags.transition_check = true
            arg == "--json" -> flags.json = true
            arg == BUILD_FLAG_SHELL_ON_FAIL -> flags.shell_on_fail = true
            arg == TRUST_FLAG_SCOPE -> {
                scope: cli_flag_argument(args, index + 1) ?? ""
                if scope != "" && !scope.starts_with("-") {
                    index += 1
                    flags.trust_scope = Val(scope)
                } else {
                    flags.trust_scope = Val("")
                }
            }
            arg == IMAGE_FLAG_PUSH -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(reference) -> flags.push = Val(reference)
            }
            arg == OS_FLAG_NAME -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(name) -> flags.name = Val(name)
            }
            arg == "--fixtures" -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(dir) -> flags.fixtures = Val(dir)
            }
            arg == "--local-nix-catalog" -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(dir) -> flags.local_nix_catalog = Val(dir)
            }
            arg == ENV_FLAG_PACKAGE -> {
                // U16 enter: `-p <pkg>...` greedily consumes bare tokens.
                index += 1
                loop index < args.len() {
                    package: args[index]
                    if package == "--" || package.starts_with("-") -> break
                    flags.packages.push(package.copy())
                    index += 1
                }
                next
            }
            arg == TOOL_FLAG_AS -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(name) -> flags.as_name = Val(name)
            }
            arg == BROWSER_FLAG_BINARY -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(path) -> flags.browser_binary = Val(path)
            }
            arg == BROWSER_FLAG_VERSION -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(version) -> flags.version = Val(version)
            }
            arg == BROWSER_FLAG_PROTOCOL -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(protocol) -> flags.browser_protocol = Val(protocol)
            }
            arg == BROWSER_FLAG_DRIVER -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(driver) -> flags.browser_driver = Val(driver)
            }
            arg == "--to" -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(path) -> flags.archive_to = Val(path)
            }
            arg == "--key" -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(path) -> flags.archive_key = Val(path)
            }
            arg == "--from" -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(path) -> flags.archive_from = Val(path)
            }
            arg == "--no-deps" -> flags.archive_no_deps = true
            arg == "--allow-unsigned" -> flags.archive_allow_unsigned = true
            arg == "--write" -> flags.cache_write = true
            arg == "--role" -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(role) -> flags.cache_role = Val(role)
            }
            arg.starts_with("--role=") -> flags.cache_role = Val(cli_trim_start_matches(arg, "--role="))
            arg == "--credential" -> {
                index += 1
                if cli_flag_argument(args, index) == .Val(provider) -> flags.cache_credential = Val(provider)
            }
            arg.starts_with("--credential=") -> flags.cache_credential = Val(cli_trim_start_matches(arg, "--credential="))
            else -> positional.push(arg.copy())
        }
        index += 1
    }
    CLIParsed{flags, positional, command}
}

// The arguments before the first `--`; invocation checks never read the
// child command.
cli_before_argument_separator: fn(args: [String]) -> [String] Never! {
    out := [String]{}
    loop arg in args {
        if arg == "--" -> break
        out.push(arg.copy())
    }
    out
}

// The flags every verb takes: color, machine output, the network policy,
// captured fixtures, and the confirmation bypass.
CLI_COMMON_FLAGS: comptime { [String]{"--color=<when>", "--no-color", "--json", "--offline", "--fixtures <dir>", CLI_FLAG_YES_SHORT, CLI_FLAG_YES_LONG} }
// The flags of every verb that realizes packages.
CLI_REALIZE_FLAGS: comptime { [String]{TRUST_BYPASS_FLAG, "--local-nix-catalog <dir>", BUILD_FLAG_SHELL_ON_FAIL} }
// The environment selectors.
CLI_SCOPE_FLAGS: comptime { [String]{"{ENV_FLAG_ENV} <name>", "{ENV_FLAG_PRESET} <name>"} }

// The flags `verb` takes, each written as the flag, then ` <value>` when it
// takes the next argument or `=<value>` when the value joins it.
cli_verb_flags: fn(verb: String) -> [String] Never! {
    realize: verb == "env" || verb == "use" || verb == JETPACK_IMPORT_VERB || verb == "add" || verb == "update" || verb == "outdated" || verb == "search" || verb == "info" || verb == "explain" || verb == JETPACK_WHY || verb == "__service-probe" || verb == IMAGE_SUBCOMMAND || verb == BRIDGE_SUBCOMMAND || verb == SERVICES_SUBCOMMAND || verb == TOOL_SUBCOMMAND || verb == PROFILE_SUBCOMMAND || verb == BROWSER_SUBCOMMAND
    scoped: verb == "env" || verb == "update" || verb == "__service-probe" || verb == IMAGE_SUBCOMMAND || verb == SERVICES_SUBCOMMAND
    own: if verb == {
        "doctor" -> [String]{"--online"}
        "env" -> [String]{"{ENV_FLAG_PACKAGE} <pkg>...", ENV_FLAG_FLAKE, ENV_FLAG_PURE, ENV_FLAG_PREP, ENV_FLAG_EXPLAIN}
        "use" -> [String]{ENV_FLAG_PREP, ENV_FLAG_EXPLAIN}
        TRUST_SUBCOMMAND -> [String]{"{TRUST_FLAG_SCOPE} <user|repo>"}
        "hangar" -> [String]{"--all", "--repair", "--read-only", "{OS_FLAG_NAME} <name>", "--version <version>", "--platform-artifact-kind <kind>", "--ref <ref>", "--output-dev <dir>", "--expires-in <duration>", "--if-etag <etag>", "--etag <etag>", "--to <path>", "--key <path-or-name>", "--from <path>", "--no-deps", "--allow-unsigned", "--write", "--role <role>", "--role=<role>", "--credential <provider>", "--credential=<provider>"}
        "add" -> [String]{"--adapt"}
        "update" -> [String]{UPDATE_FLAG_DEPS, UPDATE_FLAG_TOOLS}
        JETPACK_LOCK_VERB -> [String]{"{LOCK_DIFF_FLAG_AGAINST} <rev>", "{LOCK_DIFF_FLAG_AGAINST}=<rev>"}
        "override" -> [String]{"--overlay <name>", "--patch <file>", "--provider <provider>", "--channel <channel>", "--allow-unfree"}
        IMAGE_SUBCOMMAND -> [String]{"{IMAGE_FLAG_PUSH} <ref>"}
        SECRETS_SUBCOMMAND -> [String]{SECRETS_FLAG_FORCE}
        TOOL_SUBCOMMAND -> [String]{"{TOOL_FLAG_AS} <name>"}
        BROWSER_SUBCOMMAND -> [String]{"{BROWSER_FLAG_BINARY} <path>", "{BROWSER_FLAG_VERSION} <version>", "{BROWSER_FLAG_PROTOCOL} <protocol>", "{BROWSER_FLAG_DRIVER} <path>"}
        TRANSITION_SPLIT_VERB | TRANSITION_FOLD_VERB -> [String]{TRANSITION_FLAG_CHECK}
        else -> [String]{}
    }
    out := [String]{}
    loop flag in own -> out.push(flag)
    if scoped {
        loop flag in CLI_SCOPE_FLAGS -> out.push(flag)
    }
    if realize {
        loop flag in CLI_REALIZE_FLAGS -> out.push(flag)
    }
    loop flag in CLI_COMMON_FLAGS -> out.push(flag)
    out
}

// The flag a spelling matches: `--env` for `--env <name>`, `--color=` for
// `--color=<when>`.
cli_flag_spelling_head: fn(spelling: String) -> String Never! {
    if spelling.split_once(" ") == .Val(halves) -> return halves.before.copy()
    if spelling.split_once("=") == .Val(halves) -> return "{halves.before}="
    spelling.copy()
}

// The first flag before the argument separator that `verb` does not take, or
// None. A value-taking flag's value is never read as a flag, as the parser
// consumes it; only `--scope` leaves a following flag in place.
cli_unknown_flag: fn(verb: String, args: [String]) -> String? Never! {
    legal: cli_verb_flags(verb)
    index := 0
    loop index < args.len() {
        arg: args[index]
        if arg == "--" -> break
        index += 1
        if !arg.starts_with("-") || arg == "-" -> next
        takes_value := false
        matched := false
        loop spelling in legal {
            head: cli_flag_spelling_head(spelling)
            if head.ends_with("=") {
                matched = arg.starts_with(head)
            } else {
                matched = arg == head
                takes_value = matched && spelling.contains(" <") && !spelling.ends_with("...")
            }
            if matched -> break
        }
        if !matched -> return Val(arg.copy())
        scope_without_value: arg == TRUST_FLAG_SCOPE && (args.get(index) ?? "-").starts_with("-")
        if takes_value && !scope_without_value -> index += 1
    }
    None
}
