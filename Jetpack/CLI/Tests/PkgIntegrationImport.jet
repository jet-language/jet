// Ported from pkg.rs:857-866.
#Test("pkg integration import_idempotent_without_user_edits") {
    file :: GeneratedFile{path: "env.jet", contents: "module env.dev\n", owned: true}
    merged :: cli_merge_generated_file(Val("module env.dev\n"), file) ?? panic("stable")
    assert_eq(merged, "module env.dev\n")
}

// Ported from pkg.rs:869-884.
#Test("pkg integration import_conflict_preserves_user_edit") {
    file :: GeneratedFile{path: "env.jet", contents: "module env.dev\n", owned: true}
    if cli_merge_generated_file(Val("# jet-import: edited\nmodule env.dev\n"), file) == {
        .Err(error) -> assert_eq(error, ImportConflict.UserEditedGeneratedLine{path: "env.jet"})
        .Ok(_) -> panic("user edit must conflict")
    }
}

// Ported from pkg.rs:887-902.
#Test("pkg integration import_conflicts_on_any_generated_file_drift") {
    file :: GeneratedFile{path: "env.jet", contents: "module env.dev\n", owned: true}
    if cli_merge_generated_file(Val("module env.dev\n// user change\n"), file) == {
        .Err(error) -> assert_eq(error, ImportConflict.UserEditedGeneratedLine{path: "env.jet"})
        .Ok(_) -> panic("any drift from generated baseline must conflict")
    }
}

// Ported from pkg.rs:905-916,312-337; full original record fixture retained.
#Test("pkg integration migration_status_feeds_lock_explain") {
    status :: MigrationStatus.AdapterWrapped{name: "left-pad"}
    record := SemanticRecord.new(
        LockIdentity{kind: LockRecordKind.Package, key: "left-pad", exact: "1.0.0", hash: "sha256-1.0.0", platform: "x86_64-linux"},
        LockRationale{owner_package: "app", reason: "app declared left-pad", source_ref: "catalog:left-pad", provider: "core", channel_input: "stable", exact_output: "1.0.0", policy_fingerprint: "policy-1", recipe_id: "", adapter_id: "", signature: "ed25519:sig", cache_provenance: "hangar", update_command: "jet update left-pad"}
    )
    record.rationales[0].adapter_id = if status == {
        .AdapterWrapped(name) -> "adapter:{name}"
        else -> ""
    }
    assert_eq(record.rationales[0].adapter_id, "adapter:left-pad")
}
