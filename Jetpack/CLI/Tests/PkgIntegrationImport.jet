// Reviewed tests/pkg.rs migration library ports; package-tests seam.
// Original native documents and generated-file baseline bytes are unchanged.

fn cli_pkg_integration_todo(plan: ImportPlan, needle: String) -> Bool Never! {
    loop todo in plan.todos {
        if todo.message.contains(needle) -> return true
    }
    false
}

fn cli_pkg_integration_loss(facts: ProviderFacts, needle: String) -> Bool Never! {
    loop loss in facts.losses {
        if loss.reason.contains(needle) -> return true
    }
    false
}

// Ported from pkg.rs:701-708.
#Test("pkg integration nix_import_emits_role_modules_and_todos") {
    plan :: cli_import_nix_facts("flake.nix", "{{\"name\":\"app\",\"packages\":[\"ripgrep\"],\"shellHook\":\"echo hi\"}}")
    found := false
    loop file in plan.generated_files {
        if file.path == "env.jet" -> found = true
    }
    assert(found)
    assert(cli_pkg_integration_todo(plan, "shellHook"))
}

// Ported from pkg.rs:711-730.
#Test("pkg integration nix_import_emits_exact_refs_and_retains_native_facts") {
    plan :: cli_import_nix_facts("flake.lock", "{{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"nixpkgs\",\"packages\":[{{\"name\":\"ripgrep\",\"version\":\"14.1.1\",\"drvPath\":\"/nix/store/hash-ripgrep-14.1.1.drv\",\"buildInputs\":[\"openssl\"],\"system\":\"x86_64-linux\",\"license\":\"BSD-3-Clause\"}}]}}")
    assert_eq(plan.deps[0].provider_ref, "ripgrep@nixpkgs#version=14.1.1")
    assert_eq(plan.deps[0].locked_version, "14.1.1")
    assert(plan.emit_pkg_jet().contains("ripgrep: ripgrep@nixpkgs#version=14.1.1"))
    facts :: plan.provider_facts["ripgrep@nixpkgs#version=14.1.1"]
    facts.validate() ?? panic("exact Nix import is lossless")
    assert_eq(facts.native_format, "flake-facts.json")
    assert(facts.native_document.contains("drvPath"))
    assert(facts.facts.has_key("provider.nix.import.drvPath"))
    assert(facts.facts.has_key("provider.nix.dependency.build"))
    assert(facts.facts.has_key("provider.nix.variant.system"))
    assert(facts.facts.has_key("provider.nix.license"))
    assert(facts.facts.has_key("provider.nix.source.drv_path"))
}

// Ported from pkg.rs:733-748.
#Test("pkg integration nix_import_keeps_mutable_refs_out_of_generated_source") {
    plan :: cli_import_nix_facts("flake.nix", "{{\"name\":\"app\",\"packages\":[\"ripgrep\"]}}")
    assert_eq(plan.deps[0].provider_ref, "ripgrep@nixpkgs")
    assert(!plan.emit_pkg_jet().contains("ripgrep: ripgrep@nixpkgs"))
    assert(cli_pkg_integration_loss(plan.provider_facts["ripgrep@nixpkgs"], "no exact version"))
    assert(cli_pkg_integration_todo(plan, "migration remains unresolved"))
}

// Ported from pkg.rs:751-768.
#Test("pkg integration nix_import_reports_malformed_package_facts_without_generating_them") {
    plan :: cli_import_nix_facts("flake.lock", "{{\"name\":\"app\",\"version\":\"1.0.0\",\"packages\":[{{\"name\":\"broken\",\"version\":\"1.0.0\",\"drvPath\":1,\"buildInputs\":false}}]}}")
    facts :: plan.provider_facts["broken@nixpkgs#version=1.0.0"]
    assert(cli_pkg_integration_loss(facts, "drvPath"))
    assert(cli_pkg_integration_loss(facts, "buildInputs"))
    assert(!plan.emit_pkg_jet().contains("broken: broken@nixpkgs#version=1.0.0"))
}

// Ported from pkg.rs:771-785.
#Test("pkg integration cargo_import_preserves_locked_versions") {
    plan :: cli_import_cargo("[package]\nname = \"app\"\nversion = \"0.1.0\"\n[dependencies]\nserde = \"1\"\n", "[[package]]\nname = \"serde\"\nversion = \"1.0.200\"\n")
    assert_eq(plan.deps[0].locked_version, "1.0.200")
    assert_eq(plan.deps[0].provider_ref, "serde@cargo#version=1.0.200")
    assert(plan.emit_pkg_jet().contains("serde: serde@cargo#version=1.0.200"))
    plan.provider_facts["serde#version=1.0.200@cargo"].validate() ?? panic("exact Cargo facts")
    found := false
    loop stub in plan.ffi_stubs {
        if stub.symbol == "serde" -> found = true
    }
    assert(found)
}

// Ported from pkg.rs:788-803.
#Test("pkg integration npm_import_turns_scripts_into_legacy_build_actions") {
    plan :: cli_import_npm("{{\"name\":\"web\",\"version\":\"1.0.0\",\"dependencies\":{{\"vite\":\"5\"}},\"scripts\":{{\"build\":\"vite build\"}}}}")
    dep_found := false
    loop dep in plan.deps {
        if dep.name == "vite" -> dep_found = true
    }
    assert(dep_found)
    assert_eq(plan.deps[0].provider_ref, "vite@npm")
    assert(!plan.emit_pkg_jet().contains("vite: vite@npm"))
    assert(cli_pkg_integration_todo(plan, "legacy build action"))
    loss_found := false
    loop entry in plan.provider_facts {
        if cli_pkg_integration_loss(entry.value, "not an exact lock") -> loss_found = true
    }
    assert(loss_found)
}

