// Ported from pkg.rs:819-834.
#Test("pkg integration cargo_import_reports_missing_lock_without_generating_mutable_ref") {
    plan :: cli_import_cargo("[package]\nname = \"app\"\nversion = \"0.1.0\"\n[dependencies]\nserde = \"1\"\n", "")
    assert_eq(plan.deps[0].provider_ref, "serde@cargo")
    assert(!plan.emit_pkg_jet().contains("serde: serde@cargo"))
    assert(cli_pkg_integration_todo(plan, "unresolved"))
    assert(cli_pkg_integration_loss(plan.provider_facts["serde@cargo"], "no exact version"))
}

