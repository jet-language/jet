// Claims for `jetpack tool` and the user-tools profile.

cli_tools_test_digest: fn(fill: String) -> String { "sha256-{fill.repeat(64)}" }

cli_tools_test_tool: fn(name: String, reference: String, bin: String, member: String) -> InstalledUserTool {
    InstalledUserTool{
        name: name,
        version: "1",
        source: "path",
        reference: reference,
        bins: [String]{bin},
        members: [String]{member},
        member_digests: [String]{cli_tools_test_digest("e")},
        output_hash: cli_tools_test_digest("d"),
        store_root: "/store",
    }
}

cli_tools_test_generation_rows: fn(tools: [InstalledUserTool]) -> [ToolGenerationTool] {
    ^rows: [ToolGenerationTool]{}
    loop entry in tools {
        rows.push(
            ToolGenerationTool{
                name: entry.name,
                version: entry.version,
                source: entry.source,
                reference: entry.reference,
                output_hash: entry.output_hash,
                store_root: entry.store_root,
                bins: entry.bins,
                members: entry.members,
                projection_hashes: entry.member_digests,
            },
        )
    }
    rows
}

cli_tools_test_replace_first: fn(text: String, from: String, to: String) -> String {
    parts: text.split_once(from) ?? return text
    "{parts.before}{to}{parts.after}"
}

#Test("task names parse plain and scheduled jobs") {
    src: "\n#Job serve: fn() {{ }}\n#Job(every: 5min) lint: fn() {{ }}\nrun: fn() {{ }}\n"
    names: cli_task_names_in(src)
    assert(names.contains("serve"), "{names}")
    assert(names.contains("lint"), "{names}")
    assert(!names.contains("run"))
}

#Test("external provider list covers ballot examples") {
    assert(TOOL_EXTERNAL_PROVIDERS.contains("npm"))
    assert(TOOL_EXTERNAL_PROVIDERS.contains("cargo"))
    assert(TOOL_EXTERNAL_PROVIDERS.contains("pypi"))
}

#Test("profile witness binds immutable metadata and sorted digests") {
    left: [String]{cli_tools_test_digest("b"), cli_tools_test_digest("a")}
    right: [String]{cli_tools_test_digest("a"), cli_tools_test_digest("b")}
    witness: cli_profile_generation_witness("immutable", left)
    assert_eq(witness, cli_profile_generation_witness("immutable", right))
    assert(witness != cli_profile_generation_witness("changed", left))
    assert(witness.starts_with("sha256-"))
    assert_eq(TOOL_PROFILE_LOCK_SCOPE, "profile-user-tools")
}

#Test("generation metadata roundtrips original store digest") {
    tools: [InstalledUserTool]{cli_tools_test_tool("tool", "./tool", "tool", "tool")}
    metadata: cli_format_tool_generation_meta(7, tools) ?? panic("format metadata")
    parsed: cli_parse_tool_generation_meta(metadata, 7) ?? panic("parse metadata")
    assert_eq(parsed.len(), 1)
    assert_eq(parsed[0].output_hash, cli_tools_test_digest("d"))
    assert(metadata.contains("\"generation\": 7"))
}

#Test("profile metadata rejects unknown fields and duplicate bins") {
    tool: cli_tools_test_tool("left", "./left", "same", "left")
    metadata: cli_format_tool_generation_meta(1, [InstalledUserTool]{tool}) ?? panic("format metadata")
    corrupted: cli_tools_test_replace_first(metadata, "{{\n", "{{\n  \"unknown\": true,\n")
    assert(cli_parse_tool_generation_meta(corrupted, 1) == .Err(_))

    ^right: tool
    right.name = "right"
    right.reference = "./right"
    right.members = [String]{"right"}
    duplicate: ToolGenerationMetadata{generation: 1, created_at: 1, tools: cli_tools_test_generation_rows([InstalledUserTool]{tool, right})}
    assert(duplicate.format() == .Err(_))
}

#Test("current pointer checksum rejects bitflips and truncation") {
    record: ToolProfilePointer{generation: 9, witness: cli_tools_test_digest("f")}
    pointer: record.format() ?? panic("format pointer")
    assert_eq(ToolProfilePointer.parse(pointer) ?? panic("parse pointer"), record)
    assert(ToolProfilePointer.parse(pointer.replace("generation\t9", "generation\t8")) == .Err(_))
    assert(ToolProfilePointer.parse(pointer.trim_end()) == .Err(_))
}

#Test("tool manifest round-trips canonical refs") {
    reference: "can1357/oh-my-pi@github#auto"
    resolved: "can1357/oh-my-pi@github#v18.0.4"
    text: "{{\n  \"profile\":\"tools\",\n  \"schema\":\"jet-user-tools-v1\",\n  \"sources\":[{{\"name\":\"releases\",\"policy\":\"pinned\",\"provider\":\"jetpackage\",\"raw\":{cli_json_quote(reference)},\"upstream\":\"github:can1357/oh-my-pi#v18.0.4\"}}],\n  \"tools\":[{{\"bins\":[\"omp\"],\"members\":[\"omp\"],\"name\":\"omp\",\"reference\":{cli_json_quote(reference)},\"resolved\":{cli_json_quote(resolved)},\"tier\":\"pinned\"}}]\n}}"
    manifest: ToolManifest.parse(text) ?? panic("tool manifest parses")
    assert_eq(manifest.sources[0].policy, ChannelPolicy.Automatic)
    assert_eq(manifest.tools[0].tier, ChannelPolicy.Automatic)
    assert_eq(manifest.tools[0].reference, reference)
    assert_eq(manifest.tools[0].resolved, resolved)
    formatted: manifest.format()
    assert(formatted.contains("\"reference\":{cli_json_quote(reference)}"))
    assert_eq((ToolManifest.parse(formatted) ?? panic("formatted manifest parses")).format(), formatted)

    ^installed: cli_tools_test_tool("omp", resolved, "omp", "omp")
    installed.version = "18.0.4"
    installed.source = "github"
    installed.output_hash = cli_tools_test_digest("f")
    metadata: cli_format_tool_generation_meta(7, [InstalledUserTool]{installed}) ?? panic("generation metadata formats")
    assert(metadata.contains(resolved))
}

cli_tools_test_admit_bin: fn(verification: StoreVerification, root: String, bin_name: String, script: String) -> InstalledUserTool {
    roots: HangarRoots{root: root, dev_mode: true}
    stage: files.tmpdir("jet-tool-recovery-src-") ?? panic("tmpdir")
    bin_dir: files.join(stage, "bin")
    files.create_dir_all(bin_dir) ?? panic("create bin")
    bin_path: files.join(bin_dir, bin_name)
    files.write(bin_path, script) ?? panic("write bin")
    files.set_mode(bin_path, 493) ?? panic("chmod bin")
    request: IngestRequest{
        name: bin_name,
        version: "1",
        reference: "{bin_name}@jetpack",
        cache_identity: CacheIdentity{
            source_fingerprint: "sha256-source-{bin_name}",
            recipe_fingerprint: "sha256-recipe-{bin_name}",
            policy_fingerprint: "policy=tool-recovery-test",
            platform: pkg_host_platform(),
        },
        references: [String]{},
        outputs: [String:String]{"out": stage},
        signature: "",
        provenance: "tool-recovery-test",
        platform_artifact_kind: "",
    }
    ingested: store_ingest_tree(verification, roots, request) ?? panic("ingest {bin_name}: {err.message()}")
    files.remove_all(stage).drop("cleanup")
    InstalledUserTool{
        name: bin_name,
        version: "1",
        source: "jetpack",
        reference: "{bin_name}@jetpack",
        bins: [String]{bin_name},
        members: [String]{bin_name},
        member_digests: [String]{},
        output_hash: ingested.entry.envelope.output_hash,
        store_root: root,
    }
}

#Test("multi-store crash between root commits rolls forward on recovery while preserving intentional rollback") {
    base: files.tmpdir("jet-tool-recovery-") ?? panic("tmpdir")
    home: files.join(base, "home")
    left_root: files.join(base, "left-root")
    right_root: files.join(base, "right-root")
    files.create_dir_all(home) ?? panic("home")
    files.create_dir_all(left_root) ?? panic("left")
    files.create_dir_all(right_root) ?? panic("right")
    old_home: sys.get("HOME")
    old_fp: sys.get(TOOL_PROFILE_FAILPOINT_ENV)
    sys.set("HOME", home)
    sys.unset(TOOL_PROFILE_FAILPOINT_ENV)

    verification: StoreVerification.new()
    left: cli_tools_test_admit_bin(verification, left_root, "left", "#!/bin/sh\necho left\n")
    right: cli_tools_test_admit_bin(verification, right_root, "right", "#!/bin/sh\necho right\n")

    gen1: cli_write_tool_generation_locked(verification, [InstalledUserTool]{left}, None) ?? panic("gen1: {err:Debug}")
    assert_eq(gen1, 1)
    assert_eq(cli_tool_current_generation_locked() ?? panic("current1"), 1)

    // Crash between multi-store root commits: generation 2 is complete on disk,
    // left-root is committed, right-root is uncommitted, and current stays 1.
    sys.set(TOOL_PROFILE_FAILPOINT_ENV, "between-root-commits")
    assert(cli_write_tool_generation_locked(verification, [InstalledUserTool]{left, right}, None) == .Err(_))
    sys.unset(TOOL_PROFILE_FAILPOINT_ENV)
    assert(files.is_file(files.join(cli_tool_generation_dir(2), TOOL_PROFILE_COMPLETE_FILE)))
    assert_eq(cli_tool_current_generation_locked() ?? panic("current_pre_recover"), 1)

    // Recovery commits both store roots and rolls forward to generation 2.
    cli_recover_tool_profile_state(verification) ?? panic("recover between-root-commits: {err:Debug}")
    assert_eq(cli_tool_current_generation_locked() ?? panic("current_post_recover"), 2)
    assert(!files.exists(cli_tool_pending_path()))
    left_snap: store_lifecycle_snapshot(verification, HangarRoots{root: left_root, dev_mode: true}) ?? panic("left snap")
    right_snap: store_lifecycle_snapshot(verification, HangarRoots{root: right_root, dev_mode: true}) ?? panic("right snap")
    assert(left_snap.roots.get("profile-generation:user:tools:2") != None)
    assert(right_snap.roots.get("profile-generation:user:tools:2") != None)

    // Crash after all roots commit (before-pointer) also rolls forward via pending-publish.
    sys.set(TOOL_PROFILE_FAILPOINT_ENV, "before-pointer")
    assert(cli_write_tool_generation_locked(verification, [InstalledUserTool]{right}, None) == .Err(_))
    sys.unset(TOOL_PROFILE_FAILPOINT_ENV)
    assert_eq(cli_tool_current_generation_locked() ?? panic("current_before_pointer"), 2)
    cli_recover_tool_profile_state(verification) ?? panic("recover before-pointer: {err:Debug}")
    assert_eq(cli_tool_current_generation_locked() ?? panic("current_post_before_pointer"), 3)
    assert(!files.exists(cli_tool_pending_path()))

    // Intentional rollback to generation 1 stays at generation 1 across subsequent recovery.
    cli_activate_tool_generation_locked(verification, 1) ?? panic("rollback to 1: {err:Debug}")
    assert_eq(cli_tool_current_generation_locked() ?? panic("current_rolled_back"), 1)
    cli_recover_tool_profile_state(verification) ?? panic("recover after rollback: {err:Debug}")
    assert_eq(cli_tool_current_generation_locked() ?? panic("current_stays_1"), 1)

    if old_home == .Val(h) -> sys.set("HOME", h) else -> sys.unset("HOME")
    if old_fp == .Val(f) -> sys.set(TOOL_PROFILE_FAILPOINT_ENV, f) else {
        sys.unset(TOOL_PROFILE_FAILPOINT_ENV)
    }
    files.remove_all(base).drop("cleanup")
}
