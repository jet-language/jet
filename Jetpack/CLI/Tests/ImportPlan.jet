// Claims ported from crates/jetpack/src/MigrationImport.rs #[cfg(test)].

#Test("cargo import keeps commented root identity and reports missing lock") {
    plan :: cli_import_cargo("[package]\nname = \"app\" # package name\nversion = \"1.0.0\" # package version\n", "")
    assert(plan.provider_facts.has_key("app@cargo#version=1.0.0"))
    reported := false
    loop todo in plan.todos {
        if todo.source_path == "Cargo.lock" && todo.message.contains("missing") -> reported = true
    }
    assert(reported)
}

#Test("nix import production path retains exact provider facts") {
    plan :: cli_import_nix_facts("flake.lock", "{{\"name\":\"app\",\"version\":\"1.0.0\",\"source\":\"nixpkgs\",\"packages\":[{{\"name\":\"ripgrep\",\"version\":\"14.1.1\",\"drvPath\":\"/nix/store/hash-ripgrep-14.1.1.drv\"}}]}}")
    facts :: plan.provider_facts.get("ripgrep@nixpkgs#version=14.1.1") ?? panic("exact Nix import is retained")
    facts.validate() ?? panic("exact Nix import is lossless")
    assert(plan.emit_pkg_jet().contains("ripgrep: ripgrep@nixpkgs#version=14.1.1"))
    assert(facts.native_document.contains("drvPath"))
    assert(facts.facts.has_key("provider.nix.import.drvPath"))
}

#Test("nix import production path reports mutable provider facts") {
    plan :: cli_import_nix_facts("flake.nix", "{{\"name\":\"app\",\"packages\":[\"ripgrep\"]}}")
    assert(!plan.emit_pkg_jet().contains("ripgrep: ripgrep@nixpkgs"))
    facts :: plan.provider_facts.get("ripgrep@nixpkgs") ?? panic("mutable Nix import is retained")
    inexact := false
    loop loss in facts.losses {
        if loss.reason.contains("no exact version") -> inexact = true
    }
    assert(inexact)
    unresolved := false
    loop todo in plan.todos {
        if todo.message.contains("migration remains unresolved") -> unresolved = true
    }
    assert(unresolved)
}
