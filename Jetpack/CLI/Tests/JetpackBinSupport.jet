// Shared helpers for the jetpack-bin process claims (crates/jetpack-bin/
// tests/*.rs). The built `jetpack` binary is named by `JETPACK_BIN`, the Jet
// analog of Cargo's `CARGO_BIN_EXE_jetpack`.

cli_test_jetpack_bin: fn() -[Env]> String {
    sys.get("JETPACK_BIN") ?? panic("JETPACK_BIN must name the built jetpack binary for process claims")
}

// A `jetpack` process spec with captured output and `args`.
cli_test_jetpack: fn(args: [String]) -[Env, Exec]> ProcessSpec {
    argv := [String]{cli_test_jetpack_bin()}
    argv.extend(args.copy())
    process.cmd(argv).stdout(.Capture).stderr(.Capture)
}

// Whether `text` carries an ANSI escape byte.
cli_test_has_escape: fn(text: String) -> Bool {
    text.bytes().contains(U8{27})
}
