// Process claims for the environment formatter fact on the live jetpack
// surface: `jetpack env info` discloses the typed `formatter:` fact, and
// `jetpack env -- <formatter>` (the step `jet fmt --lang` dispatches) realizes
// the formatter package and runs it inside the composed environment. The
// dry-run diff, staging, and write-after-success batch are jet-side and are
// claimed by Compiler/JetCli/Tests/ExternalFormat.jet.

// A fresh scratch tree with project, root, formatter repo, and scratch dirs.
struct FormatterTree {
    base: String
    project: String
    root: String
    repo: String
    scratch: String

    fn new(label: String) -[FS]> FormatterTree {
        base :: files.tmpdir("jet-environment-formatter-{label}-") ?? panic("claim formatter scratch")
        tree :: FormatterTree{
            base: base,
            project: files.join(base, "project"),
            root: files.join(base, "root"),
            repo: files.join(base, "formatter-repo"),
            scratch: files.join(base, "scratch")
        }
        files.create_dir_all(tree.project) ?? panic("create project")
        files.create_dir_all(tree.root) ?? panic("create root")
        files.create_dir_all(tree.scratch) ?? panic("create scratch")
        tree
    }

    fn remove(self) -[FS]> {
        files.remove_all(self.base).drop("scratch cleanup is best-effort")
    }
}

// Stage a local-source `nixfmt` package and a project whose env declares it
// as the formatter, then run `jetpack env -- nixfmt flake.nix`.
fn cli_test_formatter_run(tree: FormatterTree, fail: Bool) -[FS, Env, Exec, Time.Wait]> ProcessReceipt {
    bin :: files.join(tree.repo, "bin")
    files.create_dir_all(bin) ?? panic("create formatter bin")
    nixfmt :: files.join(bin, "nixfmt")
    files.write(nixfmt, "#!/bin/sh\nset -e\nif test \"x$JET_FMT_FAIL\" = x1; then exit 7; fi\nfor path do\n    printf 'formatted\\n' > \"$path\"\ndone\n") ?? panic("write nixfmt")
    files.set_mode(nixfmt, 0o755) ?? panic("chmod nixfmt")
    files.write(files.join(tree.repo, "nixfmt.jet"), "module nixfmt {{ }}\n") ?? panic("write nixfmt.jet")
    files.write(files.join(tree.repo, "package.jet"), "name: \"formatter-repo\"\nversion: \"0.1.0\"\npackages: {{ nixfmt: executable }}\n") ?? panic("write formatter package.jet")
    files.write(files.join(tree.project, "env.jet"), "module env.dev {{\n    sources: {{ local: {tree.repo} }}\n    formatter: \"nixfmt@local\"\n}}\n") ?? panic("write env.jet")
    files.write(files.join(tree.project, "flake.nix"), "unformatted\n") ?? panic("write flake.nix")
    spec := cli_test_jetpack([String]{"env", "--trust", "--offline", "--no-color", "--", "nixfmt", "flake.nix"}).cwd(tree.project).env("JETPACK_ROOT", tree.root).env("HOME", files.join(tree.root, "home")).env("TMPDIR", tree.scratch)
    if fail -> spec = spec.env("JET_FMT_FAIL", "1")
    spec.run() ?? panic("run jetpack env -- nixfmt")
}

#Test("jetpack env runs the realized environment formatter") {
    tree :: FormatterTree.new("success")
    receipt :: cli_test_formatter_run(tree, false)
    assert(receipt.success, "formatter failed:\n{receipt.errors}")
    assert_eq(files.read(files.join(tree.project, "flake.nix")) ?? panic("read flake.nix"), "formatted\n")
    tree.remove()
}

// `pkgs.<name>` is the ratified formatter spelling; it names the public
// Jetpack source.
#Test("jetpack environment info discloses the typed formatter fact") {
    tree :: FormatterTree.new("info")
    files.write(files.join(tree.project, "env.jet"), "module env.dev {{ formatter: pkgs.nixfmt }}\n") ?? panic("write env.jet")
    receipt :: cli_test_jetpack([String]{"env", "info", "--json", "--no-color"}).cwd(tree.project).env("JETPACK_ROOT", tree.root).env("HOME", files.join(tree.root, "home")).run() ?? panic("run jetpack env info")
    assert(receipt.success, "info failed:\n{receipt.errors}")
    assert(receipt.output.contains("\"formatter\":\"nixfmt@jetpack\""), "formatter fact missing from info: {receipt.output}")
    tree.remove()
}

#Test("jetpack env formatter failure propagates its exit and keeps sources") {
    tree :: FormatterTree.new("failure")
    receipt :: cli_test_formatter_run(tree, true)
    assert_eq(receipt.code, 7)
    assert_eq(files.read(files.join(tree.project, "flake.nix")) ?? panic("read flake.nix"), "unformatted\n")
    tree.remove()
}
