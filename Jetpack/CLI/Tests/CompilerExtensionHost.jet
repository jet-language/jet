// Hidden component-host claims. Core's plugin loader cannot load a
// runtime-path WebAssembly component under fuel, memory, table, and time
// limits (or against a pinned digest), so both hidden hosts check their input
// and then refuse with a plain Jet-owned message and EXIT_USER_ERROR before
// any guest code runs. The real-guest round-trip claims that need the loader
// are listed in the U7 Core-gap ledger.

// A fixture guest, resolved from the test driver's working directory (the
// repository root).
fn cli_test_extension_fixture(name: String) -[FS, Env]> String {
    root :: files.cwd() ?? panic("the test driver has a working directory")
    files.join(root, "tests/fixtures/compiler_extension/{name}")
}

// Run a hidden host with `input` on stdin and wait for its receipt.
fn cli_test_host_receipt(spec: ProcessSpec, input: String) -[Exec, Time.Wait]> ProcessReceipt {
    child :: spec.stdin(.Stream).spawn() ?? panic("spawn jetpack host")
    child.stdin.write(input) ?? panic("write host stdin")
    child.stdin.close()
    child.wait() ?? panic("wait for jetpack host")
}

#Test("compiler extension host fails closed without runtime component loading") {
    snapshot :: TypedSnapshot.new(
        ExtensionAbility.v1_defaults(),
        [TypeFact]{TypeFact{id: "t1", repr: "Int", shape: TypeFactShape.Scalar}},
        [SymbolFact]{SymbolFact{id: "s1", name: "x", kind: "let", type_id: "t1", span_id: "sp1", effects: [String]{"pure"}, provenance: "sema"}},
        [SpanFact]{SpanFact{id: "sp1", file: "main.jet", start: 10, end: 11}}
    ) ?? panic("valid snapshot")
    encoded :: snapshot.encode_bytes() ?? panic("encode snapshot")
    input :: String.from_bytes(encoded) ?? panic("the snapshot wire is UTF-8 JSON")
    spec :: cli_test_jetpack([String]{EXTENSION_HOST_SUBCOMMAND, cli_test_extension_fixture("lint_no_x.wasm")})
    receipt :: cli_test_host_receipt(spec, input)
    assert_eq(receipt.code, EXIT_USER_ERROR)
    assert_eq(receipt.output, "")
    assert_eq(receipt.errors.trim(), COMPILER_EXTENSION_HOST_UNSUPPORTED)
}

#Test("build plugin host fails closed without runtime component loading") {
    component_path :: cli_test_extension_fixture("lint_no_x.wasm")
    component :: files.read_bytes(component_path) ?? panic("read fixture component")
    component_digest :: ContentDigest.from_bytes(component).as_str()
    scratch :: files.tmpdir("jetpack-build-plugin-host-") ?? panic("scratch dir")
    manifest_path :: files.join(scratch, "plugin.manifest")
    manifest :: "name = \"lint\"\nversion = \"0.1.0\"\napi_version = \"{BUILD_PLUGIN_API_VERSION}\"\ncomponent_digest = \"{component_digest}\"\n"
    files.write(manifest_path, manifest) ?? panic("write plugin manifest")
    manifest_digest :: ContentDigest.from_bytes(manifest.bytes()).as_str()
    spec :: cli_test_jetpack([String]{BUILD_PLUGIN_HOST_SUBCOMMAND, manifest_path, component_path, manifest_digest, component_digest})
    receipt :: cli_test_host_receipt(spec, "{{}}")
    files.remove_all(scratch).drop("scratch cleanup")
    assert_eq(receipt.code, EXIT_USER_ERROR)
    assert_eq(receipt.output, "")
    assert_eq(receipt.errors.trim(), BUILD_PLUGIN_HOST_UNSUPPORTED)
}
