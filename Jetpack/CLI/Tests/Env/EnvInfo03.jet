// GATE #4494: canonical native files, executable resolution and receipt IO.

// Rust: crates/jetpack/src/CLI/run_enter_dev.rs:4538
// Faithful missing control: retain the original default (not empty) table.
#Test("task_cache_key_changes_when_environment_module_facts_change") {
    root :: files.tmpdir("jet-job-cache-environment-") ?? panic("create cache scratch")
    entry :: files.join(root, "main.jet")
    files.write(entry, "#Job fn build() {{}}\n") ?? panic("write job entry")
    compiler :: sys.executable()
    metadata :: JobMetadata{
        scope: JobScope.Dev,
        after: [String]{},
        packages: [String]{},
        cwd: None,
        inputs: [String]{"main.jet"},
        outputs: [String]{"out.txt"},
        skip: None,
        cache: JobCachePolicy.Local,
        parallel: None,
        limits: [StringMapEntry]{},
    }
    table :: SourceTable.default()
    first :: cli_task_cache_key(root, entry, "build", compiler, metadata, [String]{}, [RefSpec]{}, table, "preset=dev;var=MODE=one") ?? panic("first cache key")
    second :: cli_task_cache_key(root, entry, "build", compiler, metadata, [String]{}, [RefSpec]{}, table, "preset=dev;var=MODE=two") ?? panic("second cache key")
    assert(first != second)
    files.remove_all(root) ?? panic("remove cache scratch")
}
