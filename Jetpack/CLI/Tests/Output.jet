// Claims for the CLI-only parts of jetpack::Output (the download-plan
// summary). The pure Theme claims live with Foundation/Terminal.jet.

#Test("cli environment plan summary reports real counts sizes and cached only") {
    plan :: DownloadPlan{new: 2, cached: 3, repaired: 1, download_bytes: Val(1500000), disk_bytes: Val(4200000), estimated_seconds: Val(3), items: [PlanItem]{}}
    assert_eq(Theme.render_download_summary("env.dev", plan), "env.dev: 2 new, 3 cached, 1 repaired · download 1.5 MB · on disk 4.2 MB · about 3s")
    cached := DownloadPlan.empty()
    cached.cached = 4
    cached.disk_bytes = Val(900000)
    assert_eq(Theme.render_download_summary("env.dev", cached), "env.dev: 0 new, 4 cached, 0 repaired · no download · on disk 900 KB")
}

#Test("CLI diagnostic projection uses canonical fix and no fix carriers") {
    diagnostic := Diagnostic{severity: DIAGNOSTIC_ERROR, code: "E1340", what: "what", why: "why", fix: "fix"}
    diagnostic.moment = DiagnosticMoment.Tool
    diagnostic.applicability = Val(FixApplicability.Suggested)
    diagnostic.edit = Val(TextEdit{span: Span{start: 0, end: 1}, new_text: "x"})
    safeties :: [FixSafety]{FixSafety.Formatting, FixSafety.BehaviorPreserving, FixSafety.APIChanging, FixSafety.TargetChanging, FixSafety.NeedsReview}
    loop safety in safeties {
        diagnostic.safety = Val(safety)
        report :: cli_diagnostic_to_report(diagnostic, ReportPath.from_process("<cli>"))
        assert_eq(report.applicability, Val(FixApplicability.Suggested))
        assert_eq(report.fix_edits[0].safety, safety)
        assert_eq(report.fix_edits[0].new_text, "x")
        assert_eq(report.json(), "{{\"schema\":\"jet.report/v3\",\"moment\":\"tool\",\"severity\":\"error\",\"code\":\"E1340\",\"what\":\"what\",\"why\":\"why\",\"fix\":\"fix\",\"applicability\":\"suggested\",\"detail\":null,\"denial_kind\":null,\"call_chain\":[],\"scope_chain\":[],\"nearest_granting_scope\":null,\"file\":\"<cli>\",\"line\":null,\"col\":null,\"span\":null,\"fix_edits\":[{{\"file\":\"<cli>\",\"span\":{{\"start\":0,\"end\":1}},\"new_text\":\"x\",\"safety\":\"{safety.as_str()}\"}}],\"cause\":[],\"clears\":0}}")
    }
    diagnostic.edit = None
    diagnostic.safety = None
    diagnostic.applicability = None
    reason :: NoFixReason.new(NoFixReasonKind.Design, "choose the design")
    diagnostic.no_fix_reason = Val(reason)
    report :: cli_diagnostic_to_report(diagnostic, ReportPath.from_process(""))
    assert_eq(report.no_fix_reason, Val(reason))
    assert_eq(StatusEnvelope.new("why", false).with_report(report).json_line(), "{{\"schema\":\"jet.status/v1\",\"action\":\"why\",\"ok\":false,\"reports\":[{{\"schema\":\"jet.report/v3\",\"moment\":\"tool\",\"severity\":\"error\",\"code\":\"E1340\",\"what\":\"what\",\"why\":\"why\",\"fix\":\"fix\",\"detail\":null,\"denial_kind\":null,\"call_chain\":[],\"scope_chain\":[],\"nearest_granting_scope\":null,\"file\":null,\"line\":null,\"col\":null,\"span\":null,\"no_fix_reason\":{{\"kind\":\"design\",\"next\":\"choose the design\"}},\"cause\":[],\"clears\":0}}]}}\n")
}
