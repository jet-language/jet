    bytes.iter().map(|byte| -> format("{byte:02x}")).collect()
}
// Rust: crates/jetpack/src/Store/Tests.rs:1854
#Test("mutable_replaced_crypto_helper_is_never_a_trust_root") {
    if core.sys.target.selected_family() != "unix" -> return
    (roots, _g) :: temp_roots()
    out :: roots.root.join("signed-output-hostile")
    fs.create_dir_all(out) ?? panic("create output")
    fs.write(out.join("payload"), "signed") ?? panic("write payload")
    fs.create_dir_all(roots.root.join("trust")) ?? panic("create trust")
    fs.write(roots.root.join("trust/cache.ed25519.pub"), "attacker-key") ?? panic("write hostile key")
    marker :: roots.root.join("helper-ran")
    helper :: roots.root.join("trust/jet-crypto-helper")
    fs.write(helper, "#!/bin/sh\ntouch '{marker.display()}'\nexit 0\n") ?? panic("write helper")
    fs.set_permissions(helper, fs.Permissions.from_mode(0o755)) ?? panic("chmod")
    envelope := Envelope.for_output(out.to_string_lossy(), "cache:hostile", "remote-cache")
    envelope.signature = "ed25519:forged"
    entry :: StoreEntry{id: entry_id("hostile", "1", "cache:hostile", out.to_string_lossy()), name: "hostile", version: "1",
        reference: "cache:hostile", out: out.to_string_lossy().to_string(), bin: "", rlib: "", envelope: ^envelope,
        cache_identity: test_identity(), references: [], named_outputs: [:], platform_artifact_kind: "",
        producer_record: "", receipt: "", realized_at: 0, last_used_at: 0}
    expectation :: CacheExpectation{identity: test_identity(), owned_output: None, allow_unsigned_local: false}
    proof :: verify_cache_entry(roots, entry, "cache:hostile", expectation)
    assert(!proof.signature_verified)
    assert(!proof.trusted())
    assert(!marker.exists(), "mutable helper must never execute")
}
// Rust: crates/jetpack/src/Store/Tests.rs:1907
#Test("e2604_reason_snapshot_is_exact") {
    failure :: IntegrityFailure{package: "demo", version: "1.2.3", expected: "sha256-good", actual: "sha256-bad",
        reason: "content digest verification",
        disposition: "Jetpack quarantined it instead of using or silently repairing it.",
        fix: "Re-run `jet store fetch` after `jet clean`. If the problem persists, audit the source before rebuilding."}
    assert_eq(failure.what(), "Integrity check failed for `demo` `1.2.3` — expected `sha256-good`, got `sha256-bad`.")
    assert_eq(failure.why(), "The cached artifact failed content digest verification. Jetpack quarantined it instead of using or silently repairing it.")
    assert_eq(failure.fix(), "Re-run `jet store fetch` after `jet clean`. If the problem persists, audit the source before rebuilding.")
}
// Rust: crates/jetpack/src/Store/Tests.rs:1934
#Test("ingest_atomic_dedupes_same_bytes_and_records_referrers") {
    (roots, _g) :: temp_roots()
    src_a :: roots.root.join("src-a")
    src_b :: roots.root.join("src-b")
    src_c :: roots.root.join("src-c")
    fs.create_dir_all(src_a) ?? panic("create a")
    fs.create_dir_all(src_b) ?? panic("create b")
    fs.create_dir_all(src_c) ?? panic("create c")
    fs.write(src_a.join("payload"), "same-bytes") ?? panic("write a")
    fs.write(src_b.join("payload"), "same-bytes") ?? panic("write b")
    fs.write(src_c.join("payload"), "different") ?? panic("write c")
    first :: ingest_tree(roots, IngestRequest{name: "alpha", version: "1", reference: "path:a",
        cache_identity: test_identity(), references: [], outputs: ["out": ^src_a], signature: "",
        provenance: "test via hangar-ingest", platform_artifact_kind: ""}) ?? panic("ingest a")
    assert(!first.deduplicated)
    assert(first.entry.envelope.output_hash.starts_with("sha256-"))
    second :: ingest_tree(roots, IngestRequest{name: "beta", version: "1", reference: "path:b",
        cache_identity: test_identity(), references: [], outputs: ["out": ^src_b], signature: "",
        provenance: "test via hangar-ingest", platform_artifact_kind: ""}) ?? panic("ingest b")
    assert(second.deduplicated)
    assert_eq(first.entry.envelope.output_hash, second.entry.envelope.output_hash)
    third :: ingest_tree(roots, IngestRequest{name: "gamma", version: "1", reference: "path:c",
        cache_identity: test_identity(), references: [~first.entry.envelope.output_hash], outputs: ["out": ^src_c],
        signature: "", provenance: "test via hangar-ingest", platform_artifact_kind: ""}) ?? panic("ingest c")
    assert(!third.deduplicated)
    assert_ne(first.entry.envelope.output_hash, third.entry.envelope.output_hash)
    assert_eq(referrers_of(roots, first.entry.envelope.output_hash) ?? panic("referrers"), [~third.entry.envelope.output_hash])
    assert_eq(recover_hangar_staging(roots) ?? panic("recover staging"), 0)
}
// Rust: crates/jetpack/src/Store/Tests.rs:2019
#Test("ingest_missing_output_is_typed_atomic_and_retryable") {
    (roots, _g) :: temp_roots()
    src :: roots.root.join("late-ingest-output")
    request :: |src: OSPath| -> IngestRequest{name: "late-ingest", version: "1", reference: "path:late-ingest",
        cache_identity: test_identity(), references: [], outputs: ["out": ^src], signature: "", provenance: "", platform_artifact_kind: ""}
    error :: ingest_tree(roots, request(~src)).unwrap_err()
    assert(match error { IngestError.IO(_) -> true, _ -> false }, "{error:?}")
    assert_eq(error.code(), "E1315")
    assert((list_checked(roots) ?? panic("list")).is_empty())
    assert((closure_graph(roots) ?? panic("graph")).records.is_empty())
    assert(find_by_reference(roots, "path:late-ingest").is_none())
    assert((find_verified_by_reference(roots, "path:late-ingest", test_expectation(src)) ?? panic("verify")).is_none())
    assert(!roots.root.join("leases").exists())
    fs.create_dir_all(src) ?? panic("create late output")
    fs.write(src.join("payload"), "now-real") ?? panic("write late payload")
    ingested :: ingest_tree(roots, request(^src)) ?? panic("retry ingest")
    assert_eq(find_by_reference(roots, "path:late-ingest"), Some(~ingested.entry))
    expectation :: test_expectation(OSPath.from(ingested.entry.out))
    hit :: (find_verified_by_reference(roots, "path:late-ingest", expectation) ?? panic("verify retry")) ?? panic("retry must publish one verified cache hit")
    assert_eq(hit.entry, ingested.entry)
}
// Rust: crates/jetpack/src/Store/Tests.rs:2062
#Test("ingest_child_replaced_after_copy_is_typed_atomic_and_retryable") {
    (roots, _g) :: temp_roots()
    src :: roots.root.join("racing-tree")
    replaced :: src.join("replaced-after-copy")
    replacement :: roots.root.join("replacement")
    fs.create_dir_all(src) ?? panic("create racing tree")
    fs.write(replaced, "first") ?? panic("write first")
    fs.write(replacement, "later") ?? panic("write later")
    fs.write(src.join("stable"), "stable") ?? panic("write stable")
    request :: |src: OSPath| -> IngestRequest{name: "child-race", version: "1", reference: "path:child-race",
        cache_identity: test_identity(), references: [], outputs: ["out": ^src], signature: "", provenance: "", platform_artifact_kind: ""}
    fired :: Arc.new(AtomicBool.new(false))
    hook_fired :: ~fired
    hook_replaced :: ~replaced
    hook_replacement :: ~replacement
    attempted :: with_after_child_copy_hook(|copied| -> {
        if copied == hook_replaced && !hook_fired.swap(true, Ordering.SeqCst) {
            if core.sys.target.selected_family() != "unix" {
                fs.remove_file(hook_replaced) ?? panic("remove replaced child")
            }
            fs.rename(hook_replacement, hook_replaced) ?? panic("replace child")
        }
    }, || -> ingest_tree(roots, request(~src)))
    assert(fired.load(Ordering.SeqCst))
    error :: attempted.expect_err("source mutation must not return a success receipt")
    assert(match error { IngestError.Mutated(_) -> true, _ -> false }, "{error:?}")
    assert_eq(error.code(), "E1315")
    assert((list_checked(roots) ?? panic("list")).is_empty())
    assert((closure_graph(roots) ?? panic("graph")).records.is_empty())
    assert(find_by_reference(roots, "path:child-race").is_none())
    assert((find_verified_by_reference(roots, "path:child-race", test_expectation(src)) ?? panic("verify")).is_none())
    assert(!roots.root.join("leases").exists())
    fs.write(replaced, "first") ?? panic("restore first")
    ingested :: ingest_tree(roots, request(^src)) ?? panic("retry")
    assert_eq(list_checked(roots) ?? panic("list retry"), [~ingested.entry])
    expectation :: test_expectation(OSPath.from(ingested.entry.out))
    hit :: (find_verified_by_reference(roots, "path:child-race", expectation) ?? panic("verify retry")) ?? panic("retry must publish one verified cache hit")
    assert_eq(hit.entry, ingested.entry)
}
