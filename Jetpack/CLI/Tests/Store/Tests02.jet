// Rust: crates/jetpack/src/Store/Tests.rs:2184
#Test("ingest_rejects_output_names_that_escape_staging") {
    for alias in ["../escaped-output", "..\\escaped-output", ".", "out/", "out//", "out/.", "out/./", "out\\", "out\\."] {
        (roots, _g) :: temp_roots()
        src :: roots.root.join("src-output-name")
        fs.create_dir_all(src) ?? panic("create source")
        fs.write(src.join("payload"), "bytes") ?? panic("write source")
        escaped :: roots.root.join("escaped-output")
        outputs := ["out": ~src]
        outputs.insert(alias.to_string(), ^src)
        err :: ingest_tree(roots, IngestRequest{name: "bad-output-name", version: "1", reference: "path:bad-output-name",
            cache_identity: test_identity(), references: [], outputs: ^outputs, signature: "", provenance: "", platform_artifact_kind: ""}).unwrap_err()
        assert_eq(err.code(), "E1315", "alias {alias:?}: {err:?}")
        assert(err.what().contains("one path component"), "alias {alias:?}: {err:?}")
        assert(!roots.hangar_dir().exists(), "alias {alias:?}")
        assert(!escaped.exists(), "alias {alias:?}")
    }
}

// Rust: crates/jetpack/src/Store/Tests.rs:2232
namespace tempdir {
    // Rust: crates/jetpack/src/Store/Tests.rs:2236
    ENVIRONMENT_LOCK :: OnceLock[Mutex[Unit]].new()
    // Rust: crates/jetpack/src/Store/Tests.rs:2238
    struct Guard { path: OSPath, parent: OSPath, environment: EnvironmentGuard? }
    // Rust: crates/jetpack/src/Store/Tests.rs:2244
    struct EnvironmentGuard { previous: [(String, OSString?)], _lock: MutexGuard[Unit] }
    // Rust: crates/jetpack/src/Store/Tests.rs:2250
    impl EnvironmentGuard {
        fn new(root: OSPath, parent: OSPath) -> EnvironmentGuard {
            lock :: ENVIRONMENT_LOCK.get_or_init(|| -> Mutex.new(())).lock().unwrap_or_else(|error| -> error.into_inner())
            desired :: [("HOME", Some(parent.join("home").into_os_string())),
                ("USERPROFILE", Some(parent.join("home").into_os_string())),
                ("LOCALAPPDATA", Some(parent.join("local").into_os_string())),
                ("XDG_DATA_HOME", Some(parent.join("data").into_os_string())),
                ("XDG_STATE_HOME", Some(parent.join("state").into_os_string())),
                ("XDG_CACHE_HOME", Some(parent.join("cache").into_os_string())),
                ("XDG_CONFIG_HOME", Some(parent.join("config").into_os_string())),
                ("JETPACK_ROOT", Some(root.as_os_str().to_os_string())),
                ("JETPACK_SHARED_CAS", Some(parent.join("shared-cas").into_os_string()))]
            previous :: desired.iter().map(|(name, _)| -> (name.to_string(), env.var_os(name))).collect()
            for (name, value) in desired {
                match value { Some(value) -> env.set_var(name, value), None -> env.remove_var(name) }
            }
            EnvironmentGuard{previous: ^previous, _lock: ^lock}
        }
    }
    // Rust: crates/jetpack/src/Store/Tests.rs:2297
    impl EnvironmentGuard.Close {
        fn close(^self) -> {
            for (name, value) in self.previous.drain(..).rev() {
                match value { Some(value) -> env.set_var(name, value), None -> env.remove_var(name) }
            }
        }
    }
    // Rust: crates/jetpack/src/Store/Tests.rs:2309
    impl Guard {
        fn new(tag: String) -> Guard {
            static NEXT :: AtomicU64.new(0)
            nanos :: (time.SystemTime.now().duration_since(time.UNIX_EPOCH) ?? panic("clock")).as_nanos()
            parent :: env.temp_dir().join("{tag}-{process.id()}-{nanos}-{NEXT.fetch_add(1, Ordering.Relaxed)}")
            path :: parent.join("root")
            fs.create_dir_all(path) ?? panic("create root")
            environment :: EnvironmentGuard.new(path, parent)
            Guard{path: ^path, parent: ^parent, environment: Some(^environment)}
        }
    }
    // Rust: crates/jetpack/src/Store/Tests.rs:2332
    impl Guard.Close {
        fn close(^self) -> {
            if Some(environment) :: self.environment.take() -> environment.close()
            _ :: fs.remove_dir_all(self.parent)
        }
    }
}

// Rust: crates/jetpack/src/Store/Tests.rs:2340
#Test("store_stays_split_along_existing_phases") {
    MAX_MODULE_LINES :: 2500
    root :: OSPath.from(env.manifest_dir())
    read :: |relative: String| -> fs.read_to_string(root.join(relative)) ?? panic("read module")
    store :: read("Source/Store.jet")
    ingest :: read("Source/Store/Ingest.jet")
    closure :: read("Source/Store/Closure.jet")
    receipt :: read("Source/Store/Receipt.jet")
    journal :: read("Source/Store/Journal.jet")
    tests :: read("Tests/Store/Tests02.jet")
    // Exclude this test's body, including its own forbidden literal construction.
    tests_production :: tests.split("#Test(\"store_stays_split_along_existing_phases\")").next() ?? panic("tests prefix")
    include_marker :: "include{'!'}("
    path_marker :: "#{'['}path"
    for (relative, source) in [("Source/Store.jet", store), ("Source/Store/Ingest.jet", ingest),
        ("Source/Store/Closure.jet", closure), ("Source/Store/Receipt.jet", receipt),
        ("Source/Store/Journal.jet", journal), ("Tests/Store/Tests02.jet", tests_production)] {
        assert(source.lines().count() < MAX_MODULE_LINES, "{relative} must stay below the card #510 module boundary")
        assert(!source.contains(include_marker))
        assert(!source.contains(path_marker))
    }
    assert(store.contains("use Jetpack.Store.Ingest"))
    assert(store.contains("use Jetpack.Store.Closure"))
    assert(store.contains("use Jetpack.Store.Receipt"))
    assert(store.contains("use Jetpack.Store.Journal"))
    assert(tests.contains("#Test("))
    ordered :: ["struct IngestRequest", "fn recover_hangar_staging", "fn ingest_tree", "fn copy_nofollow_tree", "fn stable_meta_identity"]
    positions :: ordered.iter().map(|needle| -> ingest.find(needle) ?? panic("ingest declaration")).collect()
    assert(positions.windows(2).all(|pair| -> pair[0] < pair[1]))
    closure_ordered :: ["fn closure_graph", "fn referrers_of", "fn migrate_closure_graph"]
    closure_positions :: closure_ordered.iter().map(|needle| -> closure.find(needle) ?? panic("closure declaration")).collect()
    assert(closure_positions.windows(2).all(|pair| -> pair[0] < pair[1]))
    journal_ordered :: ["fn load_graph", "fn validate_graph"]
    journal_positions :: journal_ordered.iter().map(|needle| -> journal.find(needle) ?? panic("journal declaration")).collect()
    assert(journal_positions.windows(2).all(|pair| -> pair[0] < pair[1]))
}
// Rust: crates/jetpack/src/Store/Tests.rs:2411
#Test("locked_nix_cas_replay_is_cold_and_warm_stable") {
    (source_roots, _source_guard) :: temp_roots()
    source_project :: source_roots.root.join("project")
    fs.create_dir_all(source_project) ?? panic("create project")
    source :: ingest_fixture(source_roots, "locked-nix", [("out", "portable")], [])
    source_entry := ~source.entry
    assert(remove_closure_record(source_roots, source_entry.id) ?? panic("remove closure"))
    revision :: "a".repeat(40)
    signed_manifest :: "b".repeat(64)
    derivation :: "c".repeat(64)
    nar_hash :: "sha256:{"d".repeat(64)}"
    upstream_proof :: "sha256-{"e".repeat(64)}"
    cache_key :: "f".repeat(64)
    system :: host_platform()
    producer := ProducerRecord.decode(source_entry.producer_record) ?? panic("decode producer")
    producer.provider = "nix"
    producer.immutable_source = "nix-source-locked-nix"
    producer.source_digest = ~source_entry.envelope.output_hash
    producer.facts.extend(["nix.index.channel": "nixpkgs-unstable", "nix.index.revision": ~revision,
        "nix.index.system": ~system, "nix.index.manifest.sha256": ~signed_manifest,
        "nix.derivation.sha256": ~derivation, "nix.output.out": ~source_entry.out,
        "nix.store-path": "/nix/store/locked-nix", "nix.proof": ~upstream_proof, "nix.nar-hash": ~nar_hash,
        "nix.nar-size": "1", "nix.compression": "none", "nix.cache.key": ~cache_key])
    source_entry.producer_record = producer.encode()
    assert(with_lock(source_roots.root, "hangar", || -> register_admitted_nix_entries_unlocked(source_roots, [~source_entry])) ?? panic("register nix"))
    bundle :: publish_nix_cas_bundle(source_project, source_roots, source_entry.id) ?? panic("publish bundle")
    // A single process-environment guard owns both Hangars; never re-enter it.
    imported_root :: (source_roots.root.parent() ?? panic("parent")).join("imported-root")
    fs.create_dir_all(imported_root) ?? panic("create imported root")
    imported_roots :: Roots{root: ^imported_root, dev_mode: true}
    (_, object_digests) :: import_nix_cas_bundle(source_project, imported_roots, bundle) ?? panic("import bundle")
    closure :: NixClosureRecord{channel: "nixpkgs-unstable", revision: ^revision, system: ~system,
        index_authority: ^signed_manifest, derivation: ^derivation, output: ~source_entry.envelope.output_hash,
        nar_hash: ^nar_hash, size: 1, compression: "none", references: [], upstream_proof: ^upstream_proof,
        cache_key: ^cache_key, project_cas_bundle: ^bundle}
    envelope :: LockEnvelope{output_hash: ~closure.output, platform: ~closure.system, signature: "",
        provenance: "locked-nix", catalog_tier: "local-unofficial", catalog_trust: "unverified"}
    first :: record_locked_nix(imported_roots, "locked-nix", "1", "locked-nix@nixpkgs", envelope, closure, object_digests, "lock-digest") ?? panic("cold record")
    second :: record_locked_nix(imported_roots, "locked-nix", "1", "locked-nix@nixpkgs", envelope, closure, object_digests, "lock-digest") ?? panic("warm record")
    assert_eq(first.id, second.id)
    assert_eq(first.envelope.output_hash, second.envelope.output_hash)
    assert_eq((list_checked(imported_roots) ?? panic("list imported")).iter().filter(|entry| -> entry.reference == "locked-nix@nixpkgs").count(), 1)
}
// Rust: crates/jetpack/src/Store/Tests.rs:2521
#Test("hangar_doctor_preserves_malformed_cas_lock_namespace") {
    if core.sys.target.selected_family() != "unix" -> return
    (roots, _guard) :: temp_roots()
    cas :: roots.hangar_dir().join("cas")
    fs.create_dir_all(cas) ?? panic("create cas")
    locks :: cas.join(".locks")
    assert_unrepaired :: |report: HangarDoctorReport| -> {
        assert_eq(report.findings.len(), 1)
        finding :: report.findings[0]
        assert_eq(finding.kind, "drift")
        assert_eq(finding.subject, "cas/.locks")
        assert(!finding.fixed)
    }
    fs.write(locks, b"not a directory") ?? panic("write bad locks")
    file_metadata :: fs.symlink_metadata(locks) ?? panic("locks metadata")
    assert_unrepaired(hangar_doctor(roots, false, true) ?? panic("doctor dry"))
    assert_unrepaired(hangar_doctor(roots, true, true) ?? panic("doctor repair"))
    after :: fs.symlink_metadata(locks) ?? panic("locks after")
    assert(after.is_file())
    assert_eq((after.dev(), after.ino()), (file_metadata.dev(), file_metadata.ino()))
    assert_eq(fs.read(locks) ?? panic("read locks"), b"not a directory")
    fs.remove_file(locks) ?? panic("remove locks")
    outside_cas :: roots.root.join("outside-cas")
    fs.create_dir_all(outside_cas) ?? panic("create outside")
    protected :: outside_cas.join("must-retain")
    fs.write(protected, b"outside CAS") ?? panic("write protected")
    protected_metadata :: fs.metadata(protected) ?? panic("protected metadata")
    fs.symlink(outside_cas, locks) ?? panic("symlink locks")
    link_metadata :: fs.symlink_metadata(locks) ?? panic("link metadata")
    assert_unrepaired(hangar_doctor(roots, false, true) ?? panic("doctor dry link"))
    assert_unrepaired(hangar_doctor(roots, true, true) ?? panic("doctor repair link"))
    after_link :: fs.symlink_metadata(locks) ?? panic("link after")
    assert(after_link.file_type().is_symlink())
    assert_eq((after_link.dev(), after_link.ino()), (link_metadata.dev(), link_metadata.ino()))
    assert_eq(fs.read_link(locks) ?? panic("read link"), outside_cas)
    after_protected :: fs.metadata(protected) ?? panic("protected after")
    assert_eq((after_protected.dev(), after_protected.ino()), (protected_metadata.dev(), protected_metadata.ino()))
    assert_eq(fs.read(protected) ?? panic("read protected"), b"outside CAS")
}
