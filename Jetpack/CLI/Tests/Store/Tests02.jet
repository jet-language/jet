#Test("ingest_retry_after_object_publish_seals_before_metadata") {
    (roots, _g) :: temp_roots()
    first :: ingest_fixture(roots, "retry-crash", [("out", "retry")], [])
    object :: OSPath.from(first.entry.out)
    make_tree_writable_for_removal(object) ?? panic("make writable")
    fs.remove_dir_all(roots.hangar_dir().join(first.entry.id)) ?? panic("remove metadata")
    fs.remove_dir_all(roots.hangar_dir().join("closure-db")) ?? panic("remove graph")
    retry :: ingest_fixture(roots, "retry-crash", [("out", "retry")], [])
    assert(retry.deduplicated)
    assert((fs.metadata(object) ?? panic("object metadata")).permissions().readonly())
    assert((fs.metadata(object.join("payload")) ?? panic("payload metadata")).permissions().readonly())
    assert(roots.hangar_dir().join(retry.entry.id).join("meta.json").is_file())
    assert((closure_graph(roots) ?? panic("graph")).records.contains_key(retry.entry.id))
}
