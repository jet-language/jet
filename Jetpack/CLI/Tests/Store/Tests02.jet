// Rust: crates/jetpack/src/Store/Tests.rs:1789
#Test("configured_ed25519_signature_verifies_the_cache_receipt") {
    (roots, _g) :: temp_roots()
    out :: roots.root.join("signed-output-real")
    fs.create_dir_all(out) ?? panic("create output")
    fs.write(out.join("payload"), "signed") ?? panic("write payload")
    envelope :: Envelope.for_output(out.to_string_lossy(), "cache:demo", "remote-cache")
    entry := StoreEntry{id: entry_id("demo", "1", "cache:demo", out.to_string_lossy()), name: "demo", version: "1",
        reference: "cache:demo", out: out.to_string_lossy().to_string(), bin: "", rlib: "", envelope: ^envelope,
        cache_identity: test_identity(), references: [], named_outputs: [:], platform_artifact_kind: "",
        producer_record: "", receipt: "", realized_at: 0, last_used_at: 0}
    expectation :: CacheExpectation{identity: test_identity(), owned_output: None, allow_unsigned_local: false}
    signing_key :: SigningKey.from_bytes([7; 32])
    fs.create_dir_all(roots.root.join("trust")) ?? panic("create trust")
    fs.write(roots.root.join("trust/cache.ed25519.pub"), hex(signing_key.verifying_key().to_bytes())) ?? panic("public key")
    entry.envelope.signature = "ed25519:{hex(signing_key.sign(cache_signature_message(entry, expectation).bytes()).to_bytes())}"
    assert(verify_configured_signature(roots, entry, expectation))
    replacement :: if entry.envelope.signature.bytes()[9] == b'0' -> "1" else -> "0"
    entry.envelope.signature.replace_range(9..10, replacement)
    assert(!verify_configured_signature(roots, entry, expectation))
}
