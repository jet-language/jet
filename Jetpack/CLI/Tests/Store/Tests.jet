// Rust: crates/jetpack/src/Store/Tests.rs:85
#Test("open_snapshot_files_rejects_paths_outside_root_before_inspection") {
    roots :: store_test_temp_roots()
    snapshot_root :: files.join(roots.root, "snapshot")
    outside :: files.join(roots.root, "outside/payload")
    outside_dir :: files.join(roots.root, "outside-empty-dir")
    files.create_dir_all(snapshot_root) ?? panic("snapshot root")
    files.create_dir_all(files.dirname(outside)) ?? panic("outside directory")
    files.create_dir_all(outside_dir) ?? panic("outside empty directory")
    files.write(outside, "outside") ?? panic("outside payload")
    opened := [SnapshotFile]{}
    reject :: (path: String) -> {
        if store_open_snapshot_files(snapshot_root, path, &opened) == {
            .Ok(_) -> panic("outside snapshot path must be rejected")
            .Err(error) -> {
                assert(error == .InvalidInput(_)) // GATE #4409
                assert_eq(error.message(), "snapshot path `{path}` is outside snapshot root `{snapshot_root}`")
            }
        }
        assert(opened.is_empty())
    }
    reject(outside)
    reject(outside_dir)
    // GATE #4483: only the original Unix symlink arm is selected.
    if target.selected_family() == .Unix {
        outside_link :: files.join(roots.root, "outside-link")
        files.symlink(outside, outside_link) ?? panic("outside symlink") // GATE #4494
        reject(outside_link)
        assert_eq(files.read_link(outside_link) ?? panic("read link"), outside)
        assert_eq(files.read(outside) ?? panic("read payload"), "outside")
    }
    store_test_drop_roots(roots)
}

// Rust: crates/jetpack/src/Store/Tests.rs:554
#Test("symlinked_project_lock_is_rejected_before_hangar_cleanup") {
    if target.selected_family() != .Unix -> return // GATE #4483
    roots :: store_test_temp_roots()
    project :: files.join(roots.root, "project")
    managed :: files.join(project, SOURCE_ROOT_DIR)
    outside :: files.join(roots.root, "outside-lock")
    files.create_dir_all(managed) ?? panic("managed directory")
    files.write(outside, "version = 1\n") ?? panic("outside lock")
    files.symlink(outside, files.join(managed, "lock")) ?? panic("symlink") // GATE #4494
    if store_nearest_lock_path(project) == {
        .Ok(_) -> panic("symlinked project lock must fail")
        .Err(error) -> {
            assert(error == .InvalidData(_)) // GATE #4409
            assert(error.message().contains("is a symlink"))
        }
    }
    store_test_drop_roots(roots)
}

// Rust: crates/jetpack/src/Store/Tests.rs:911
#Test("verified_cache_rejects_deleted_and_tampered_outputs") {
    verification := StoreVerification.new()
    roots :: store_test_temp_roots()
    entry :: store_test_ingest_fixture(&verification, roots, "verified-cache", [String: String]{"out": "trusted"}, [String]{}).entry
    out :: entry.out
    expectation :: store_test_expectation(out)
    proof :: store_verify_cache_entry(&verification, roots, entry, entry.reference, expectation)
    assert(!proof.signature_verified)
    assert(proof.unsigned_local_allowed)
    assert(store_test_verified(&verification, roots, entry.reference, expectation))
    // GATE #4494: lstat root and original set_readonly(false) semantics, not 0644.
    native_out :: OSPath.from_text(out)
    stamp :: store_object_stamp(std.fs.symlink_metadata(native_out) ?? panic("root lstat"))
    payload :: native_out.join("payload")
    permissions := (std.fs.metadata(payload) ?? panic("payload metadata")).permissions()
    &permissions.set_readonly(false)
    std.fs.set_permissions(payload, permissions) ?? panic("payload permissions")
    std.fs.write(payload, "tampered".bytes()) ?? panic("rewrite payload")
    assert_eq(stamp, store_object_stamp(std.fs.symlink_metadata(native_out) ?? panic("root lstat")))
    use_proof :: store_verify_cache_entry(&verification, roots, entry, entry.reference, expectation)
    assert(!use_proof.output_digest)
    assert(!use_proof.trusted())
    assert(store_verify_hangar_object(&verification, roots, entry) == .Err(_))
    root_permissions := (std.fs.metadata(native_out) ?? panic("root metadata")).permissions()
    &root_permissions.set_readonly(false)
    std.fs.set_permissions(native_out, root_permissions) ?? panic("root permissions")
    std.fs.remove_dir_all(native_out) ?? panic("delete output")
    assert(!store_test_verified(&verification, roots, entry.reference, expectation))
    store_test_drop_roots(roots)
}

// Rust: crates/jetpack/src/Store/Tests.rs:1312
#Test("unreadable_shared_cas_object_survives_quarantine") {
    if target.selected_family() != .Unix -> return // GATE #4483
    verification := StoreVerification.new()
    roots :: store_test_temp_roots()
    stale :: store_test_ingest_fixture(&verification, roots, "unreadable-stale", [String: String]{"out": "same"}, [String]{})
    survivor :: store_test_ingest_fixture(&verification, roots, "unreadable-survivor", [String: String]{"out": "same"}, [String]{})
    assert_eq(stale.entry.out, survivor.entry.out)
    object :: stale.entry.out
    payload :: OSPath.from_text(object).join("payload")
    // GATE #4494: preserve the original complete native permissions value.
    original_permissions :: (std.fs.metadata(payload) ?? panic("metadata")).permissions()
    std.fs.set_permissions(payload, std.fs.Permissions.from_mode(0)) ?? panic("mode000")
    assert(store_full_verified_output_hash(&verification, object, roots.hangar_dir(), false) == .Err(_))
    mismatch := store_test_expectation(object)
    mismatch.identity.source_fingerprint = "wrong-source"
    store_quarantine_invalid_entry(&verification, roots, stale.entry, mismatch) ?? panic("quarantine")
    assert(files.exists(object))
    assert(store_find_by_reference(&verification, roots, stale.entry.reference) == None)
    std.fs.set_permissions(payload, original_permissions) ?? panic("restore permissions")
    graph :: store_closure_graph(&verification, roots) ?? panic("graph")
    assert(!graph.records.has_key(stale.entry.id))
    assert(graph.deleted_records.contains(stale.entry.id))
    hit :: store_find_verified_by_reference(&verification, roots, survivor.entry.reference, store_test_expectation(object)) ?? panic("lookup")
    verified :: hit ?? panic("survivor hit")
    verified.lease.validate() ?? panic("validate lease")
    verified.lease.release()
    store_test_drop_roots(roots)
}

// Rust: crates/jetpack/src/Store/Tests.rs:1458
#Test("quarantine_failure_restores_permissions_without_tombstone") {
    if target.selected_family() != .Unix -> return // GATE #4483
    verification := StoreVerification.new()
    roots :: store_test_temp_roots()
    entry :: store_test_ingest_fixture(&verification, roots, "restore", [String: String]{"out": "same"}, [String]{}).entry
    hangar :: roots.hangar_dir()
    files.write(files.join(hangar, "quarantine"), "blocks directory creation") ?? panic("block quarantine")
    files.set_mode(hangar, 0o555) ?? panic("mode0555") // GATE #4494
    mismatch := store_test_expectation(entry.out)
    mismatch.identity.source_fingerprint = "wrong-source"
    if store_quarantine_invalid_entry(&verification, roots, entry, mismatch) == {
        .Ok(_) -> panic("blocked quarantine must fail")
        .Err(error) -> assert(error == .InvalidData(_)) // GATE #4409
    }
    assert_eq((files.stat(hangar) ?? panic("metadata")).mode & 0o777, 0o555)
    assert(files.exists(files.join(hangar, entry.id)))
    files.set_mode(hangar, 0o755) ?? panic("mode0755")
    assert(store_find_by_reference(&verification, roots, entry.reference) != None)
    store_test_drop_roots(roots)
}

// Rust: crates/jetpack/src/Store/Tests.rs:1521
#Test("lease_recovery_waits_for_descendant_then_reclaims_idle_container") {
    if target.selected_family() != .Unix -> return // GATE #4483
    verification := StoreVerification.new()
    roots :: store_test_temp_roots()
    ingested :: store_test_ingest_fixture(&verification, roots, "lease-tree", [String: String]{"out": "trusted"}, [String]{})
    hit :: store_find_verified_by_reference(&verification, roots, ingested.entry.reference, store_test_expectation(ingested.entry.out)) ?? panic("lookup")
    verified :: hit ?? panic("cache hit")
    lease_root :: files.dirname(verified.lease.snapshot_root)
    verified.lease.mark_process_handoff()
    // GATE #4494: native child descendants inherit the actual handoff lifetime.
    child := std.process.Command.new("/bin/sh").args([String]{"-c", "/bin/sleep 2 >/dev/null 2>&1 &"}).spawn() ?? panic("spawn")
    _ :: &child.wait() ?? panic("wait")
    verified.lease.release()
    assert(files.exists(lease_root))
    assert_eq(store_recover_hangar(&verification, roots) ?? panic("recover"), 0)
    assert(files.exists(lease_root))
    std.thread.sleep(std.time.Duration.from_secs(2))
    assert_eq(store_recover_hangar(&verification, roots) ?? panic("recover"), 1)
    assert(!files.exists(lease_root))
    store_test_drop_roots(roots)
}

// Rust: crates/jetpack/src/Store/Tests.rs:1631
#Test("leased_fd_view_executes_original_after_rename_symlink_swap") {
    if target.selected_os() != .Linux -> return // GATE #4483
    verification := StoreVerification.new()
    roots :: store_test_temp_roots()
    out :: files.join(roots.root, "fd-view-output")
    tool :: files.join(out, "bin/tool")
    files.create_dir_all(files.dirname(tool)) ?? panic("fixture directory")
    files.write(files.join(out, "bin/tool-real"), "#!/bin/sh\nprintf trusted") ?? panic("trusted tool")
    files.set_mode(files.join(out, "bin/tool-real"), 0o555) ?? panic("mode0555")
    files.symlink("tool-real", tool) ?? panic("symlink") // GATE #4494
    envelope :: Envelope.for_output(out, "fd-view@mine", "core-source")
    store_record_verified(&verification, roots, "fd-view", "1", "fd-view@mine", out, files.join(out, "bin"), "", envelope, store_test_identity()) ?? panic("record")
    hit :: store_find_verified_by_reference(&verification, roots, "fd-view@mine", store_test_expectation(out)) ?? panic("lookup")
    verified :: hit ?? panic("cache hit")
    lease :: verified.lease
    projected_bin :: lease.projected_bin_dir() ?? panic("projected bin")
    assert(projected_bin.starts_with("/proc/self/fd/"))
    assert(!store_path_starts_with(projected_bin, out))
    stable_tool :: lease.stable_path(tool) ?? panic("stable tool")
    explicit_tool :: lease.executable_for(tool) ?? panic("explicit executable")
    // GATE #4494: actual native child stdout bytes, not text-decoded receipts.
    explicit :: std.process.Command.new(explicit_tool).output() ?? panic("execute")
    assert_eq(explicit.stdout, "trusted".bytes())
    assert(lease.executable_for(files.join(out, "bin/other-tool")) == None)
    assert(lease.executable_for_command(files.join(out, "bin/other-tool")) == .Err(_))
    moved :: files.join(roots.root, "fd-view-original")
    attacker :: files.join(roots.root, "fd-view-attacker")
    files.rename(out, moved) ?? panic("rename original")
    files.create_dir_all(files.join(attacker, "bin")) ?? panic("attacker directory")
    files.write(files.join(attacker, "bin/tool"), "#!/bin/sh\nprintf attacker") ?? panic("attacker tool")
    files.set_mode(files.join(attacker, "bin/tool"), 0o755) ?? panic("mode0755")
    files.symlink(attacker, out) ?? panic("swap")
    lease.validate() ?? panic("validate lease")
    confined :: lease.executable_for(tool) ?? panic("confined executable")
    assert_eq((std.process.Command.new(confined).output() ?? panic("execute confined")).stdout, "trusted".bytes())
    assert(lease.executable_for(files.join(attacker, "bin/tool")) == None)
    wrapper :: lease.wrapper_dir() ?? panic("wrapper")
    assert(files.set_mode(wrapper, 0o755) == .Err(_))
    assert(files.remove(files.join(wrapper, "tool")) == .Err(_))
    lease.validate() ?? panic("validate lease")
    store_make_tree_writable_for_removal(lease.snapshot_root) ?? panic("writable snapshot")
    snapshot_tool :: files.join(lease.snapshot_root, "bin/tool")
    files.remove(snapshot_tool) ?? panic("remove snapshot tool")
    files.write(snapshot_tool, "#!/bin/sh\nprintf snapshot-attacker") ?? panic("snapshot attacker")
    files.set_mode(snapshot_tool, 0o755) ?? panic("mode0755")
    output :: std.process.Command.new(stable_tool).output() ?? panic("execute stable")
    assert(output.status.success())
    assert_eq(String.from_bytes(output.stdout) ?? panic("UTF8 stdout"), "trusted")
    nested :: std.process.Command.new("/bin/sh").args([String]{"-c", "exec tool"}).env("PATH", "{wrapper}:/usr/bin:/bin").output() ?? panic("nested")
    assert(nested.status.success())
    assert_eq(String.from_bytes(nested.stdout) ?? panic("UTF8 stdout"), "trusted")
    assert_eq(files.read(files.join(out, "bin/tool")) ?? panic("read attacker"), "#!/bin/sh\nprintf attacker")
    lease.release()
    store_test_drop_roots(roots)
}
