// Rust: crates/jetpack/src/Store/NixCache/Tests.rs:1365
#Test("native_nix_cache_negative_inputs_fail_closed") {
    verification := StoreVerification.new()
    store_path :: "/nix/store/22222222222222222222222222222222-negative"
    seed :: store_nix_test_seed(9)
    wrong_seed :: store_nix_test_seed(10)
    key_id :: "test-cache-1"
    valid_nar :: store_nix_test_nar_with_directory_entries([[U8]]{})
    invalid_magic_nar := [U8]{U8{9}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}, U8{0}}
    &invalid_magic_nar.extend("not-a-nar".bytes())
    loop _ in 0..<7 -> &invalid_magic_nar.push(U8{0})
    _ :: store_nix_test_single_failure(&verification, "wrong-key", store_path, store_nix_test_signed_narinfo(store_path, "negative.nar", valid_nar, [String]{}, key_id, seed), valid_nar, wrong_seed, NixCacheErrorKind.Signature)

    // Original deterministic frame and LAST-byte corruption, not a magic-byte
    // substitute. Metadata hashes the exact uncorrupted deterministic frame.
    compressed :: encode_zstd_deterministic(valid_nar) ?? panic("deterministic zstd")
    zstd_info :: store_nix_test_signed_narinfo_with_payload(store_path, "negative.nar.zst", compressed, valid_nar, NixCompression.Zstd, [String]{}, key_id, seed)
    corrupted := compressed.clone()
    corruption_index :: corrupted.len() - 1
    corrupted[corruption_index] = U8{Int.from_u8(corrupted[corruption_index]) ~| 1}
    _ :: store_nix_test_single_failure(&verification, "compressed-corruption", store_path, zstd_info, corrupted, seed, NixCacheErrorKind.CompressedCorruption)

    nar_error :: store_nix_test_single_failure(&verification, "nar-corruption", store_path, store_nix_test_signed_narinfo(store_path, "negative.nar", invalid_magic_nar, [String]{}, key_id, seed), invalid_magic_nar, seed, NixCacheErrorKind.NarCorruption)
    assert(nar_error.message().contains(store_path))
    assert(nar_error.message().contains("invalid magic"))
    duplicate_nar :: store_nix_test_nar_with_directory_entries([[U8]]{"A".bytes(), "A".bytes()})
    _ :: store_nix_test_single_failure(&verification, "duplicate-entry", store_path, store_nix_test_signed_narinfo(store_path, "duplicate.nar", duplicate_nar, [String]{}, key_id, seed), duplicate_nar, seed, NixCacheErrorKind.DuplicateEntry)
    traversal_nar :: store_nix_test_nar_with_directory_entries([[U8]]{"..".bytes()})
    _ :: store_nix_test_single_failure(&verification, "path-traversal", store_path, store_nix_test_signed_narinfo(store_path, "traversal.nar", traversal_nar, [String]{}, key_id, seed), traversal_nar, seed, NixCacheErrorKind.PathTraversal)
    signed :: String.from_bytes(store_nix_test_signed_narinfo(store_path, "negative.nar", valid_nar, [String]{}, key_id, seed)) ?? panic("narinfo text")
    url_traversal :: signed.replace("URL: nar/negative.nar\n", "URL: ../negative.nar\n")
    _ :: store_nix_test_single_failure(&verification, "url-traversal", store_path, url_traversal.bytes(), valid_nar, seed, NixCacheErrorKind.PathTraversal)
    reference :: "/nix/store/33333333333333333333333333333333-reference"
    with_reference :: String.from_bytes(store_nix_test_signed_narinfo(store_path, "negative.nar", valid_nar, [String]{reference}, key_id, seed)) ?? panic("narinfo text")
    duplicate_references :: with_reference.replace("References: 33333333333333333333333333333333-reference\n", "References: 33333333333333333333333333333333-reference 33333333333333333333333333333333-reference\n")
    _ :: store_nix_test_single_failure(&verification, "duplicate-reference", store_path, duplicate_references.bytes(), valid_nar, seed, NixCacheErrorKind.DuplicateEntry)
}

// Rust: crates/jetpack/src/Store/NixCache/Tests.rs:1509
#Test("native_nix_cache_failures_are_e1350_and_snapshot_pinned") {
    error :: NixCacheError.new(NixCacheErrorKind.PathTraversal, "test")
    assert_eq(error.code(), "E1350")
    // Bind the original producer diagnostic, not a synthesized expected string.
    rendered :: diagnostic_render_all("<nix-cache>", "", [Diagnostic]{error.diagnostic()}, false)
    snapshot :: "tests/fixtures/jetpack-diagnostics/nix_cache_admission_failures.stderr"
    if sys.var_os("UPDATE_EXPECT") != None -> files.write(snapshot, rendered) ?? panic("update diagnostic snapshot")
    assert_eq(rendered, files.read(snapshot) ?? panic("missing Nix cache diagnostic snapshot"))
    kinds :: [NixCacheErrorKind]{.Metadata, .WrongKey, .Signature, .Transport, .UnsupportedCompression, .CompressedCorruption, .NarCorruption, .MissingReference, .PathTraversal, .DuplicateEntry, .Admission}
    loop kind in kinds -> assert_eq(NixCacheError.new(kind, "test").code(), "E1350")
    cases :: [(detail: String, kind: NixCacheErrorKind)]{
        (detail: "NAR stream directory contains duplicate names", kind: .DuplicateEntry),
        (detail: "NAR name is not one safe path component", kind: .PathTraversal),
        (detail: "zstd data corruption detected", kind: .CompressedCorruption),
    }
    loop case in cases {
        // GATE #4409: original io::ErrorKind::InvalidData classification input.
        io_error :: std.io.Error.new(.InvalidData, case.detail)
        assert_eq(classify_nar_error(&io_error), case.kind)
        assert_eq(NixCacheError.new(case.kind, case.detail).code(), "E1350")
    }
}
