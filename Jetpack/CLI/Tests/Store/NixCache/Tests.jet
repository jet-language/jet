// Rust: crates/jetpack/src/Store/NixCache/Tests.rs:93
#Test("native_nix_cache_streams_without_process_tools") {
    source :: files.read("Jetpack/Store/Source/NixCache/NixCacheTransport.jet") ?? panic("native cache source")
    assert(!source.contains("Command"))
    assert(!source.contains("curl"))
    assert(!source.contains("nix-store"))
    root :: store_nix_test_unique_dir("stream")
    files.create_dir_all(files.join(root, "bin")) ?? panic("bin")
    payload := [U8]{}
    loop _ in 0..<(128 * 1024) -> &payload.push(U8{120})
    files.write_bytes(files.join(root, "bin/payload"), payload) ?? panic("payload")
    encoded :: store_write_nar(root) ?? panic("write nar")
    nar :: encoded.bytes
    expected :: encoded.stats
    assert(expected.bytes > 64 * 1024)
    streaming := crypto.Hasher.new()
    start := 0
    loop start < nar.len() {
        end :: if start + 73 < nar.len() -> start + 73 else -> nar.len()
        &streaming.update(nar[start..<end])
        start = end
    }
    assert_eq(streaming.digest(), store_sha256_hex(nar))
    compressed :: encode_zstd_deterministic(nar) ?? panic("deterministic zstd")
    assert_eq(zstd.decompress(compressed) ?? panic("zstd round trip"), nar)
    destination :: "{root}.decoded"
    actual :: store_read_nar_stream(store_nix_test_byte_source(nar, 65536), destination, expected.bytes) ?? panic("read nar")
    assert_eq(actual, expected)
    assert_eq((files.read_bytes(files.join(destination, "bin/payload")) ?? panic("decoded payload")).len(), 128 * 1024)
    store_nix_test_remove_dir(root)
    store_nix_test_remove_dir(destination)
}

