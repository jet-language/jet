// Rust: crates/jetpack/src/Store/SealTests.rs:220
#Test("hangar_verify_rehashes_despite_valid_seal_and_catches_content_corruption") {
    if core.sys.target.selected_family() != "unix" -> return
    verification := StoreVerification.new()
    fixture_root :: temp_roots()
    roots :: fixture_root.roots
    ingested :: store_test_seal_fixture(&verification, roots, "audit", "seal-test")
    object :: OSPath.from(ingested.entry.out)
    digest :: ingested.entry.envelope.output_hash
    assert_eq(store_check_seal(&verification, object, roots.hangar_dir()) ?? panic("check"), Val(digest))
    payload :: object.join("payload")
    before :: fs.metadata(payload) ?? panic("metadata")
    make_writable(payload)
    fs.write(payload, "tamper!".bytes()) ?? panic("tamper")
    stamp :: mtime(before)
    set_mtime(payload, stamp.seconds, stamp.nanos)
    assert_eq(mtime(before), mtime(fs.metadata(payload) ?? panic("metadata")))
    store_reset_verified_digest_hash_count(&verification, object)
    assert(store_verify_hangar_object(&verification, roots, ingested.entry) == .Err(_))
    assert_eq(store_verified_digest_hash_count(&verification, object), 1)
}

// Rust: crates/jetpack/src/Store/SealTests.rs:245
#Test("armed_command_memo_checks_identity_once_and_stays_thread_local") {
    if core.sys.target.selected_family() != "unix" -> return
    verification := StoreVerification.new()
    fixture_root :: temp_roots()
    roots :: fixture_root.roots
    ingested :: store_test_seal_fixture(&verification, roots, "memo", "seal-test")
    object :: OSPath.from(ingested.entry.out)
    digest :: ingested.entry.envelope.output_hash
    hangar :: roots.hangar_dir()
    child_object :: ~object
    child_hangar :: ~hangar
    child_digest :: ~digest
    armed :: thread.spawn(() -> {
        // Canonical explicit owner models the original independent TLS window.
        child_verification := StoreVerification.new()
        store_arm_command_memo(&child_verification)
        assert_eq(store_check_seal(&child_verification, child_object, child_hangar) ?? panic("check"), Val(child_digest))
        payload :: child_object.join("payload")
        stamp :: mtime(fs.metadata(payload) ?? panic("metadata"))
        set_mtime(payload, stamp.seconds + 7, stamp.nanos)
        assert_eq(store_check_seal(&child_verification, child_object, child_hangar) ?? panic("check"), Val(child_digest))
        store_remove_seal(&child_verification, child_object, child_hangar) ?? panic("remove")
        assert_eq(store_check_seal(&child_verification, child_object, child_hangar) ?? panic("check"), None)
    })
    ^armed.join() ?? panic("armed thread")
    // Main owner was never armed, preserving the original sibling isolation.
    assert_eq(store_check_seal(&verification, object, hangar) ?? panic("check"), None)
}
