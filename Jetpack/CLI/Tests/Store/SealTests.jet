use std.[env, fs, process, thread]
use std.sync.atomic.[AtomicU64, Ordering]
// GATE #4494: real files, atomic sequence, exact native metadata, subprocess,
// scoped cleanup, and independent native thread; no Rust callback.

// Rust: crates/jetpack/src/Store/SealTests.rs:8
TEST_SEQUENCE :: AtomicU64.new(0)
// Rust: crates/jetpack/src/Store/SealTests.rs:10
struct TestRoot { path: OSPath }
// Rust: crates/jetpack/src/Store/SealTests.rs:15
impl TestRoot.Close {
    fn close(^self) -> { _ :: fs.remove_dir_all(self.path) }
}
// Rust: crates/jetpack/src/Store/SealTests.rs:20
fn temp_roots() -> (roots: HangarRoots, guard: TestRoot) {
    path :: env.temp_dir().join("jetpack-seal-{process.id()}-{TEST_SEQUENCE.fetch_add(1, Ordering.Relaxed)}")
    fs.create_dir_all(path) ?? panic("create seal test root")
    guard :: TestRoot{path: path}
    roots :: HangarRoots{root: ~guard.path, dev_mode: true}
    (roots: roots, guard: ^guard)
}
