// native_admission_seals_after_shared_cas_hardlinking -> Store/Tests/Seal.jet39:
// real CAS directory, digest seal, admitted hash and zero content hash count.
// Rust: crates/jetpack/src/Store/SealTests.rs:91
fn mtime(metadata: fs.Metadata) -> (seconds: I64, nanos: I64) {
    (seconds: metadata.mtime(), nanos: metadata.mtime_nsec())
}
// Rust: crates/jetpack/src/Store/SealTests.rs:97
fn set_mtime(path: OSPath, seconds: I64, nanos: I64) -> {
    stamp :: "@{seconds}.{nanos.to_string().pad_start(9, "0")}"
    status :: process.Command.new("touch").arg("-m").arg("-d").arg(stamp).arg(path).status() ?? panic("touch")
    assert(status.success(), "touch failed for {path.display()}")
}
// Rust: crates/jetpack/src/Store/SealTests.rs:114
fn make_writable(path: OSPath) -> {
    permissions := (fs.metadata(path) ?? panic("metadata")).permissions()
    permissions.set_mode(permissions.mode() | 0o200)
    fs.set_permissions(path, permissions) ?? panic("set permissions")
}

// Rust: crates/jetpack/src/Store/SealTests.rs:123
#Test("seal_written_at_admission_and_warm_verification_skips_content_hash") {
    if core.sys.target.selected_family() != "unix" -> return // GATE #4483
    verification := StoreVerification.new()
    fixture_root :: temp_roots()
    roots :: fixture_root.roots
    ingested :: store_test_seal_fixture(&verification, roots, "warm", "seal-test")
    object :: OSPath.from(ingested.entry.out)
    digest :: ingested.entry.envelope.output_hash
    seal :: roots.hangar_dir().join(STORE_SEALS_DIR).join(digest)
    assert(seal.is_file(), "admission must write {seal}")
    store_reset_verified_digest_hash_count(&verification, object)
    assert_eq(store_try_entry_output_hash(&verification, roots, ingested.entry) ?? panic("hash"), digest)
    assert_eq(store_verified_digest_hash_count(&verification, object), 0)
    // Restore the ORIGINAL nanoseconds; no preliminary mtime mutation/reseal.
    payload :: object.join("payload")
    before :: fs.metadata(payload) ?? panic("metadata")
    make_writable(payload)
    fs.write(payload, "tamper!".bytes()) ?? panic("tamper")
    stamp :: mtime(before)
    set_mtime(payload, stamp.seconds, stamp.nanos)
    after :: fs.metadata(payload) ?? panic("metadata")
    assert_eq(before.len(), after.len())
    assert_eq(mtime(before), mtime(after))
    store_reset_verified_digest_hash_count(&verification, object)
    assert_eq((store_list_checked(&verification, roots) ?? panic("list")).len(), 1)
    assert_eq(store_verified_digest_hash_count(&verification, object), 0)
    assert_eq(store_check_seal(&verification, object, roots.hangar_dir()) ?? panic("check"), Val(digest))
}

// Rust: crates/jetpack/src/Store/SealTests.rs:161
#Test("seal_mtime_drift_rehashes_once_and_reseals") {
    if core.sys.target.selected_family() != "unix" -> return
    verification := StoreVerification.new()
    fixture_root :: temp_roots()
    roots :: fixture_root.roots
    ingested :: store_test_seal_fixture(&verification, roots, "drift", "seal-test")
    object :: OSPath.from(ingested.entry.out)
    digest :: ingested.entry.envelope.output_hash
    seal :: roots.hangar_dir().join(STORE_SEALS_DIR).join(digest)
    before :: fs.read(seal) ?? panic("read seal")
    payload :: object.join("payload")
    stamp :: mtime(fs.metadata(payload) ?? panic("metadata"))
    set_mtime(payload, stamp.seconds + 1, stamp.nanos)
    store_reset_verified_digest_hash_count(&verification, object)
    assert_eq(store_try_entry_output_hash(&verification, roots, ingested.entry) ?? panic("hash"), digest)
    assert_eq(store_verified_digest_hash_count(&verification, object), 1)
    assert(before != (fs.read(seal) ?? panic("read seal")))
    assert_eq(store_try_entry_output_hash(&verification, roots, ingested.entry) ?? panic("hash"), digest)
    assert_eq(store_verified_digest_hash_count(&verification, object), 1)
}

