// Process claim ported from crates/jetpack-bin/tests/criterion1.rs (card
// #2189 criterion 1): `env` selects the default or positional module. Named
// env modules make a typed environment, so each entry passes `--trust` for
// that run instead of depending on the caller's trust store. The shell's PS1
// reads the module's label from $JETPACK_PROMPT_LABEL when it is drawn, so the
// claim prints PS1 as bash expands it (`${PS1@P}`).

cli_test_criterion_root: fn() -[FS, Env]> String {
    home: sys.get("HOME") ?? panic("HOME must be set")
    scratch: sys.get("JET_SCRATCH_ROOT") ?? (sys.get("JET_STATE_ROOT") ?? files.join(sys.get("XDG_CACHE_HOME") ?? files.join(home, ".cache"), "jet-dev"))
    root: files.join(scratch, "jetpack-criterion1-root")
    files.create_dir_all(root) ?? panic("create criterion root")
    root
}

#Test("jetpack env enters default and positional modules") {
    project: files.tmpdir("jet-criterion1-project-") ?? panic("claim project scratch")
    root: cli_test_criterion_root()
    files.write(files.join(project, "env.jet"), "env.dev: module {{ prompt: \"default-module\" }}\nenv.full: module {{ prompt: \"full-module\" }}\n") ?? panic("write env.jet")
    cases: [(args: [String], prompt: String)]{
        (args: [String]{"env", "--trust", "--no-color"}, prompt: "default-module"),
        (args: [String]{"env", "full", "--trust", "--no-color"}, prompt: "full-module")
    }
    loop entry in cases {
        child := cli_test_jetpack(entry.args).cwd(project).env("JETPACK_ROOT", root).env("SHELL", "/bin/bash").stdin(.Stream).spawn() ?? panic("spawn jetpack env")
        child.stdin.write_text("printf '%s\\n' \"${{PS1@P}}\"\nexit\n") ?? panic("write shell input")
        child.stdin.close()
        receipt: child.wait() ?? panic("wait for jetpack env")
        assert(receipt.success, "args={entry.args}\nstdout={receipt.output}\nstderr={receipt.errors}")
        assert(receipt.output.contains(entry.prompt), "args={entry.args}\nprompt={entry.prompt}\nstdout={receipt.output}\nstderr={receipt.errors}")
    }
    files.remove_all(project) ?? panic("remove project scratch")
}
