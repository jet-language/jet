// The package-dependency host's observable bytes plus checked carrier
// edit/publication acceptance. Fetch execution against path, git and locked
// graphs is proved end to end by the tests/cases/pkg cases.

#Test("package dependency host success lines name every registry tier") {
    lock := LockFile.empty()
    lock.packages = [LockedPackage]{
        {name: "root", version: "1.0.0", source: .Root},
        {name: "local", version: "1.0.0", source: .Path("../local")},
        {name: "zeta", version: "2.3.4", source: .Registry{registry: "stable", reference: "zeta#2.3.4", output: "out", source_hash: "hash", repository: "repo", authority: "auth", tier: "core", gate_status: "passed"}},
        {name: "alpha", version: "0.1.2", source: .Registry{registry: "community", reference: "alpha#0.1.2", output: "other", source_hash: "hash", repository: "repo", authority: "auth", tier: "community", gate_status: "local"}},
    }
    tiers :: "resolved `zeta` 2.3.4 from registry `stable` (tier: core; gate status: passed)\nresolved `alpha` 0.1.2 from registry `community` (tier: community; gate status: local)\n"
    assert_eq(cli_package_dependency_success(lock, PackageFetchOptions{}), "{tiers}fetched all dependencies\n")
    assert_eq(cli_package_dependency_success(lock, PackageFetchOptions{locked: true}), "{tiers}lock verified\n")
    assert_eq(cli_package_dependency_success(lock, PackageFetchOptions{update: true}), "{tiers}updated all moving selectors\n")
    assert_eq(cli_package_dependency_success(lock, PackageFetchOptions{update: true, update_dep: Val("local")}), "{tiers}updated `local`\n")
    assert_eq(cli_package_dependency_edit_success("add", "local", "/project/package.jet"), "added `local` to /project/package.jet\n")
    assert_eq(cli_package_dependency_edit_success("remove", "local", "/project/run.jet"), "removed `local` from /project/run.jet\n")
}

#Test("package dependency host publication errors name their phase") {
    failure :: IOError.Other(IOContext{operation: .Write, resource: Val("/project/package.jet"), os_code: None, cause: Val("failure")})
    detail :: "{failure}"
    loop phase in ([FoundationPublicationPhase]{.CreateStage, .WriteStage, .SetMode, .InspectStage}) -> assert_eq(cli_package_dependency_publication_error("/project/package.jet", FoundationPublicationError{phase: phase, error: failure}), "could not stage /project/package.jet: {detail}")
    loop phase in ([FoundationPublicationPhase]{.SyncStage, .SyncParent}) -> assert_eq(cli_package_dependency_publication_error("/project/package.jet", FoundationPublicationError{phase: phase, error: failure}), "could not sync /project/package.jet: {detail}")
    assert_eq(cli_package_dependency_publication_error("/project/package.jet", FoundationPublicationError{phase: .ValidateSource, error: failure}), "package source changed before publishing: {detail}")
    loop phase in ([FoundationPublicationPhase]{.InspectDestination, .ValidateAuthority, .Rename, .ValidatePublished}) -> assert_eq(cli_package_dependency_publication_error("/project/package.jet", FoundationPublicationError{phase: phase, error: failure}), "could not publish /project/package.jet: {detail}")
    loop phase in ([FoundationPublicationPhase]{.OpenRoot, .OpenParent}) -> assert_eq(cli_package_dependency_publication_error("/project/package.jet", FoundationPublicationError{phase: phase, error: failure}), "could not open package source authority: {detail}")
    assert_eq(cli_package_dependency_publication_error("/project/package.jet", FoundationPublicationError{phase: .PreparePath, error: failure}), "could not check /project/package.jet: {detail}")
}

#Test("package dependency host flags take their own words") {
    assert_eq(cli_package_dependency_flag([String]{"add", "local", "--path", "--git"}, "--path"), Val("--git"))
    assert_eq(cli_package_dependency_flag([String]{"add", "local", "--path=../local"}, "--path"), None)
    raw :: [String]{"add", "local", "--path", "../local", "--git", "url", "--tag", "tag"}
    words :: cli_package_dependency_words(raw, false, false) ?? panic("add takes value flags")
    assert_eq(words, [String]{"add", "local"})
    selected :: cli_package_dependency_add_spec(raw, words.get(1), false, false) ?? panic("path wins")
    assert_eq(selected, (name: "local", spec: DepSpec.Path{path: "../local"}))
    git :: cli_package_dependency_add_spec([String]{"add", "local", "--git", "url", "--rev", "rev", "--branch", "branch", "--tag", "tag"}, Val("local"), false, false) ?? panic("tag wins")
    assert_eq(git, (name: "local", spec: DepSpec.Git{url: "url", selector: GitSelector.Tag("tag")}))
    if cli_package_dependency_add_spec([String]{"add"}, None, false, false) == {
        .Ok(_) -> panic("missing dependency name")
        .Err(error) -> {
            assert_eq(error.output.stdout, "")
            assert(error.output.stderr.starts_with("Error [jet.InvalidCommandInput]: `jet add` needs a dependency name\n"), error.output.stderr)
            assert_eq(error.output.exit_code, EXIT_USER_ERROR)
        }
    }
    if cli_package_dependency_words([String]{"fetch", "--path", "x"}, false, false) == {
        .Ok(_) -> panic("fetch takes no --path")
        .Err(error) -> {
            assert(error.output.stderr.starts_with("Error [jet.UnknownFlag]: `--path` isn't a `jet fetch` flag\n"), error.output.stderr)
            assert_eq(error.output.exit_code, EXIT_USAGE)
        }
    }
    locked :: cli_package_dependency_words([String]{"fetch", "--locked", "--json"}, false, false) ?? panic("fetch --locked")
    assert_eq(locked, [String]{"fetch"})
}

#Test("package dependency host edits the checked inline carrier and never overwrites a concurrent writer") {
    root :: files.tmpdir("jetpack-package-dependency-") ?? panic("fixture directory")
    raw :: "name: \"consumer\"\nversion: \"1.0.0\"\ndeps: {{\n    // preserve\n}}\n"
    inline :: "// carrier\npackage {{\n{raw}}}\nfn run() {{}}\n"
    path :: files.join(root, "run.jet")
    files.write(path, inline) ?? panic("inline fixture")
    input :: cli_package_dependency_input(root, path, false, false) ?? panic("checked Package carrier")
    assert_eq(input.path, path)
    assert_eq(input.raw, inline)
    expected :: "// carrier\npackage {{\nname: \"consumer\"\nversion: \"1.0.0\"\ndeps: {{\n    // preserve\n    local: ../local,\n}}\n}}\nfn run() {{}}\n"
    updated :: cli_package_dependency_edit(input, "local", Val(DepSpec.Path{path: "../local"}))
    assert_eq(updated, expected)
    cli_package_dependency_publish(input, updated) ?? panic("existing checked publisher")
    assert_eq(files.read(path) ?? panic("read published carrier"), expected)
    second :: cli_package_dependency_input(root, path, false, false) ?? panic("reload published carrier")
    removed :: cli_package_dependency_edit(second, "local", None)
    assert_eq(removed, inline)
    concurrent :: "{expected}// concurrent writer\n"
    files.write(path, concurrent) ?? panic("concurrent fixture edit")
    if cli_package_dependency_publish(second, removed) == {
        .Ok(_) -> panic("must not overwrite concurrent writer")
        .Err(error) -> assert_eq(error.message, "{path} changed while the package edit was prepared")
    }
    assert_eq(files.read(path) ?? panic("read concurrent carrier"), concurrent)
    absent :: cli_package_dependency(root, path, [String]{"remove", "absent"}, false, false)
    assert_eq(absent.stdout, "")
    assert(absent.stderr.starts_with("Error [jet.InvalidCommandInput]: Dependency `absent` is not present in run.jet\n"), absent.stderr)
    assert_eq(absent.exit_code, EXIT_USER_ERROR)
    files.remove_all(root).drop("scratch cleanup")
}
