#Test("image environment rejects an unsupported integration host") {
    project :: cli_test_image_scratch("environment-unsupported-host")
    files.write(files.join(project, "env.jet"), "module env.dev {{ imports: [env.platform.apple()] }}\nmodule image.server {{ from: env.dev }}\n") ?? panic("write env.jet")
    out :: cli_test_image_jetpack(project, [String]{"image", "server"}).run() ?? panic("run jetpack image")
    assert_eq(out.code, 2, "unsupported hosts must fail: {out.errors}")
    assert(out.errors.contains("E1333"), out.errors)
    assert(out.errors.contains("not supported on target"), out.errors)
    report :: files.read(files.join(project, ".jet/images/server/projection.json")) ?? panic("read projection.json")
    assert(report.contains("integration:apple:host"), "projection: {report}")
    files.remove_all(project).drop("scratch cleanup is best-effort")
}

#Test("image environment omits cloud and vault facts without secret names") {
    claim :: EnvironmentImageClaim.new("environment-secret-integrations", "module env.dev {{\n    packages: [\"bash@nixpkgs\"]\n    imports: [\n        env.cloud.credentials([aws_production]),\n        env.security.vault([database_password])\n    ]\n}}\nmodule image.server {{ from: env.dev }}\n")
    cli_test_ingest_executable(claim.root, "bash", "bash@nixpkgs", "bash")
    out :: claim.build()
    assert_eq(out.code, 0, "image should project the environment successfully: {out.errors}")
    report :: claim.projection()
    facts :: [String]{
        "integration:cloud-credentials:activation",
        "integration:cloud-credentials:task:credential-store-check",
        "integration:cloud-credentials:provider:credential-store",
        "integration:cloud-credentials:grant:credential.read",
        "integration:vault:activation",
        "integration:vault:task:vault-check",
        "integration:vault:provider:vault",
        "integration:vault:grant:vault.read",
        "integration:cloud-credentials:secret-refs=1",
        "integration:vault:secret-refs=1"
    }
    loop fact in facts -> assert(report.contains(fact), "projection: {report}")
    assert(!report.contains("aws_production"), "secret name leaked: {report}")
    assert(!report.contains("database_password"), "secret name leaked: {report}")
    blobs :: cli_test_image_blobs(claim.image_dir())
    loop blob in blobs {
        assert(!cli_test_bytes_contain(blob, "aws_production".bytes()))
        assert(!cli_test_bytes_contain(blob, "database_password".bytes()))
    }
    claim.remove()
}

#Test("image environment rejects secret extra file") {
    claim :: EnvironmentImageClaim.new("environment-secret-file", "module env.dev {{\n    packages: [\"bash@nixpkgs\"]\n    dotenv: [Dotenv{{ file: \".env\", allow: [\"TOKEN\"], secrets: [\"TOKEN\"] }}]\n}}\nmodule image.server {{ from: env.dev, files: [\".env\"] }}\n")
    files.write(files.join(claim.project, ".env"), "TOKEN=super-secret-value\n") ?? panic("write .env")
    cli_test_ingest_executable(claim.root, "bash", "bash@nixpkgs", "bash")
    out :: claim.build()
    assert_eq(out.code, 2, out.errors)
    assert(out.errors.contains("E1336"), "stderr: {out.errors}")
    assert(!out.errors.contains("super-secret-value"), "secret leaked: {out.errors}")
    report :: claim.projection()
    assert(report.contains("file:.env"), "projection: {report}")
    assert(!report.contains("super-secret-value"), "secret leaked: {report}")
    if files.is_dir(files.join(claim.image_dir(), "blobs/sha256")) {
        blobs :: cli_test_image_blobs(claim.image_dir())
        loop blob in blobs -> assert(!cli_test_bytes_contain(blob, "super-secret-value".bytes()))
    }
    claim.remove()
}

#Test("image environment rejects project escape layer path") {
    claim :: EnvironmentImageClaim.new("environment-layer-path", "module env.dev {{ packages: [\"bash@nixpkgs\"] }}\nmodule image.server {{ from: env.dev, files: [\"../outside\"] }}\n")
    cli_test_ingest_executable(claim.root, "bash", "bash@nixpkgs", "bash")
    out :: claim.build()
