#Test("image environment rejects symlinked extra file") {
    if sys.is_windows() -> return
    claim :: EnvironmentImageClaim.new("environment-image-symlink-file", "module env.dev {{ packages: [\"bash@nixpkgs\"] }}\nmodule image.server {{ from: env.dev, files: [\"payload.bin\"] }}\n")
    outside :: cli_test_image_scratch("environment-image-symlink-outside")
    files.write(files.join(outside, "payload.bin"), "must not be read\n") ?? panic("write outside payload")
    files.symlink(files.join(outside, "payload.bin"), files.join(claim.project, "payload.bin")) ?? panic("link payload")
    cli_test_ingest_executable(claim.root, "bash", "bash@nixpkgs", "bash")
    out :: claim.build()
    assert_eq(out.code, 2, "symlinked image file must fail: {out.errors}")
    assert(out.errors.contains("not a symlink") || out.errors.contains("symlink"), "stderr: {out.errors}")
    assert_eq(files.read(files.join(outside, "payload.bin")) ?? panic("read outside payload"), "must not be read\n")
    files.remove_all(outside).drop("scratch cleanup is best-effort")
    claim.remove()
}

#Test("image environment rejects hardlinked extra file") {
    if sys.is_windows() -> return
    claim :: EnvironmentImageClaim.new("environment-image-hardlink-file", "module env.dev {{ packages: [\"bash@nixpkgs\"] }}\nmodule image.server {{ from: env.dev, files: [\"payload.bin\"] }}\n")
    outside :: cli_test_image_scratch("environment-image-hardlink-outside")
    files.write(files.join(outside, "payload.bin"), "must not be read\n") ?? panic("write outside payload")
    files.hard_link(files.join(outside, "payload.bin"), files.join(claim.project, "payload.bin")) ?? panic("hard link payload")
    cli_test_ingest_executable(claim.root, "bash", "bash@nixpkgs", "bash")
    out :: claim.build()
    assert_eq(out.code, 2, "hardlinked image file must fail: {out.errors}")
    assert(out.errors.contains("hard link"), "stderr: {out.errors}")
    assert_eq(files.read(files.join(outside, "payload.bin")) ?? panic("read outside payload"), "must not be read\n")
    files.remove_all(outside).drop("scratch cleanup is best-effort")
    claim.remove()
}

#Test("image environment rejects symlinked ancestor extra file") {
    if sys.is_windows() -> return
    claim :: EnvironmentImageClaim.new("environment-image-symlink-ancestor-file", "module env.dev {{ packages: [\"bash@nixpkgs\"] }}\nmodule image.server {{ from: env.dev, files: [\"nested/payload.bin\"] }}\n")
    outside :: cli_test_image_scratch("environment-image-symlink-ancestor-outside")
    files.write(files.join(outside, "payload.bin"), "must not be read\n") ?? panic("write outside payload")
    files.symlink(outside, files.join(claim.project, "nested")) ?? panic("link nested dir")
    cli_test_ingest_executable(claim.root, "bash", "bash@nixpkgs", "bash")
    out :: claim.build()
    assert_eq(out.code, 2, "symlinked ancestor image file must fail: {out.errors}")
    assert(out.errors.contains("not a symlink") || out.errors.contains("symlink") || out.errors.contains("not a directory"), "stderr: {out.errors}")
    assert_eq(files.read(files.join(outside, "payload.bin")) ?? panic("read outside payload"), "must not be read\n")
    files.remove_all(outside).drop("scratch cleanup is best-effort")
    claim.remove()
}

#Test("image environment rejects unredactable cloud secret") {
    project :: cli_test_image_scratch("environment-cloud-secret-loss")
    files.write(files.join(project, "env.jet"), "module env.dev {{\n    imports: [env.cloud.credentials(\"super_secret_value\")]\n}}\nmodule image.server {{ from: env.dev }}\n") ?? panic("write env.jet")
    out :: cli_test_image_jetpack(project, [String]{"image", "server"}).run() ?? panic("run jetpack image")
    assert_eq(out.code, 2)
    assert(out.errors.contains("E1335"), "stderr: {out.errors}")
    assert(!out.errors.contains("super_secret_value"), "secret input leaked: {out.errors}")
    files.remove_all(project).drop("scratch cleanup is best-effort")
}

// The E1336 block of `stderr`, blank lines dropped and each line trimmed.
fn cli_test_e1336_block(stderr: String) -> String {
    blocks :: stderr.split("\n\n")
    loop block in blocks {
        if !block.contains("Error [E1336]") -> next
        lines := [String]{}
        loop line in block.lines() {
            if line != "" -> &lines.push(line.trim())
        }
        return lines.join("\n")
    }
    panic("E1336 diagnostic block")
}

#Test("image environment requires explicit service selection") {
    project :: cli_test_image_scratch("environment-service")
    files.write(files.join(project, "env.jet"), "module env.dev {{ services: {{ api: {{ run: [\"true\"] }} }} }}\nmodule image.server {{ from: env.dev }}\n") ?? panic("write env.jet")
    out :: cli_test_image_jetpack(project, [String]{"image", "server"}).run() ?? panic("run jetpack image")
    assert_eq(out.code, 2, "service projection must fail: {out.errors}")
    assert_eq(cli_test_e1336_block(out.errors), @CLI_TEST_IMAGE_SERVICE_E1336.trim())
    report :: files.read(files.join(project, ".jet/images/server/projection.json")) ?? panic("rejected image projection report")
    assert(report.contains("\"rejected\":[\"services\"]"), "projection: {report}")
    files.remove_all(project).drop("scratch cleanup is best-effort")
}

#Test("image environment projects supervised services") {
    project :: cli_test_image_scratch("environment-service-image")
    files.write(files.join(project, "env.jet"), "module env.dev {{\n    packages: [\"bash@nixpkgs\", \"db@nixpkgs\", \"sleep@nixpkgs\", \"worker@nixpkgs\"]\n    services: {{ db: {{ enable: true, run: [\"db\"] }}, api: {{ enable: true, ports: [8080], after: [\"db\"], run: [\"worker\", \"--port\", \"8080\"] }} }}\n}}\nmodule image.server {{ from: env.dev, services: [\"api\"] }}\n") ?? panic("write env.jet")
    cli_test_ingest_executable(project, "bash", "bash@nixpkgs", "bash")
    cli_test_ingest_executable(project, "db", "db@nixpkgs", "db")
    cli_test_ingest_executable(project, "sleep", "sleep@nixpkgs", "sleep")
    cli_test_ingest_executable(project, "worker", "worker@nixpkgs", "worker")
    out :: cli_test_image_jetpack(project, [String]{"image", "server"}).env("JETPACK_ROOT", project).run() ?? panic("run jetpack image")
    assert_eq(out.code, 0, "supervised image must build: {out.errors}")
    layer :: cli_test_image_layer(files.join(project, ".jet/images/server"))
    assert(cli_test_bytes_contain(layer, "jet/supervise".bytes()), "supervisor path is not in the OCI layer")
    assert(cli_test_bytes_contain(layer, "start '/usr/local/bin/worker' '--port' '8080'".bytes()), "service command is not in the generated supervisor")
    db_start :: cli_test_bytes_position(layer, "start '/usr/local/bin/db'".bytes()) ?? panic("dependency command")
    worker_start :: cli_test_bytes_position(layer, "start '/usr/local/bin/worker'".bytes()) ?? panic("dependent command")
    assert(db_start < worker_start, "dependency must start first")
    report :: files.read(files.join(project, ".jet/images/server/projection.json")) ?? panic("read projection.json")
    assert(report.contains("services:jet/supervise"), "projection: {report}")
    assert(report.contains("service:api"), "projection: {report}")
    plan :: files.read(files.join(project, ".jet/images/server/plan.json")) ?? panic("read plan.json")
    assert(plan.contains("\"entrypoint\":[\"/jet/supervise\"]"), "plan: {plan}")
    assert(plan.contains("\"services\":[\"api\",\"db\"]"), "plan: {plan}")
    files.remove_all(project).drop("scratch cleanup is best-effort")
}

#Test("image environment rejects a service without projected executable") {
    claim :: EnvironmentImageClaim.new("environment-service-missing-tool", "module env.dev {{\n    packages: [\"bash@nixpkgs\"]\n    services: {{ api: {{ enable: true, run: [\"worker\"] }} }}\n}}\nmodule image.server {{ from: env.dev, services: [\"api\"] }}\n")
    cli_test_ingest_executable(claim.root, "bash", "bash@nixpkgs", "bash")
    out :: claim.build()
    assert_eq(out.code, 2, "missing service tool: {out.errors}")
    assert(out.errors.contains("E1336"), "stderr: {out.errors}")
    assert(out.errors.contains("not a projected package"), "stderr: {out.errors}")
    report :: claim.projection()
    assert(report.contains("\"rejected\":[\"services\"]"), "projection: {report}")
    claim.remove()
}

// An unbuilt package reports an honest "not built yet" and never fabricates
// a binary or an empty image.
#Test("image of unbuilt package is honest") {
    scratch :: cli_test_image_scratch("unbuilt")
    cli_test_image_project(scratch, "executable", false)
    out :: cli_test_image_jetpack(scratch, [String]{"image", "server"}).run() ?? panic("run jetpack image")
    assert_eq(out.code, 2)
    assert(out.errors.contains("isn't built yet"), out.errors)
    assert(!files.exists(files.join(scratch, ".jet/images")))
    files.remove_all(scratch).drop("scratch cleanup is best-effort")
}

// An unqualified registry-looking `--push <ref>` remains the E1268 gate.
#Test("image push is gated E1268") {
    scratch :: cli_test_image_scratch("push-gated")
    cli_test_image_project(scratch, "executable", true)
    out :: cli_test_image_jetpack(scratch, [String]{"image", "server", "--push", "ghcr.io/acme/server:1.0"}).run() ?? panic("run jetpack image --push")
    assert_eq(out.code, 2)
    assert(out.errors.contains("E1268"), "expected E1268: {out.errors}")
    assert(out.errors.contains("TLS"), out.errors)
    // The rejected remote name never silently builds or pushes anything.
    assert(!files.exists(files.join(scratch, ".jet/images")))
    files.remove_all(scratch).drop("scratch cleanup is best-effort")
}

// Naming an image that doesn't exist lists the declared ones.
#Test("image unknown name is friendly") {
    scratch :: cli_test_image_scratch("unknown-name")
    cli_test_image_project(scratch, "executable", true)
    out :: cli_test_image_jetpack(scratch, [String]{"image", "ghost"}).run() ?? panic("run jetpack image")
    assert_eq(out.code, 2)
    assert(out.errors.contains("no image `ghost`"), out.errors)
    assert(out.errors.contains("server"), "lists declared images: {out.errors}")
    files.remove_all(scratch).drop("scratch cleanup is best-effort")
}

// A `.Iso` disk image gets a friendly pointer at the jetos installer tier;
// `jet image` never mis-treats it as a container.
#Test("image of iso kind is friendly not built") {
    scratch :: cli_test_image_scratch("iso-not-built")
    files.write(files.join(scratch, "env.jet"), "module system.web {{ target: linux.x64 }}\nmodule image.installer {{ from: system.web }}\n") ?? panic("write env.jet")
    out :: cli_test_image_jetpack(scratch, [String]{"image", "installer"}).run() ?? panic("run jetpack image")
    assert_eq(out.code, 2)
    assert(out.errors.contains("disk image, not a container"), out.errors)
    assert(out.errors.contains("Phase D"), out.errors)
    files.remove_all(scratch).drop("scratch cleanup is best-effort")
}
