// Additional control for Rust: crates/jetpack/src/CLI/tool.rs:2786
#Test("tool_json_u64_preserves_exact_integer_and_missing_field_errors") {
    fields :: [("int", DataTree.Int(42)), ("float", DataTree.Float(9007199254740991.0)), ("fraction", DataTree.Float(1.5)), ("negative", DataTree.Int(-1)), ("text", DataTree.Text("42"))]
    assert_eq(json_field_u64(&fields, "int") ?? panic("integer"), U64{42})
    assert_eq(json_field_u64(&fields, "float") ?? panic("exact float"), U64{9007199254740991})
    assert(json_field_u64(&fields, "fraction").is_err())
    assert(json_field_u64(&fields, "negative").is_err())
    if json_field_u64(&fields, "text") == {
        .Err(error) -> assert_eq(error, "profile field `text` is not an exact integer")
        .Ok(_) -> panic("text must not parse as numeric")
    }
    if json_field_u64(&fields, "missing") == {
        .Err(error) -> assert_eq(error, "profile field `missing` is not a number")
        .Ok(_) -> panic("missing field")
    }
}

// Additional control for Rust: crates/jetpack/src/CLI/tool.rs:2829
#Test("tool_store_root_uses_selected_native_path_components") {
    assert(validate_store_root("relative").is_err())
    if selected_family() == "unix" {
        validate_store_root("/store") ?? panic("absolute store")
        validate_store_root("/store/back\\slash") ?? panic("backslash is a normal Unix filename")
        assert(validate_store_root("/store/../escape").is_err())
    }
}
