// Rust: tests/fleet.rs:1
use Jetpack.CLI.Tests.Integration.Fleet.*
use Jetpack.CLI.Tests.Integration.Common.[Scratch, manifest_dir]
use Jetpack.EnvModel.ModuleEval.[evaluate_env, HostOverrideValue]
use Compiler.Comptime.CtValue
use std.fs

// Rust: tests/fleet.rs:27
#Test("fleet_host_unknown_system_is_e1242") {
    (code, rendered) :: render("module fleet.prod { hosts: { web1: system.ghost } }")
    assert_eq(code, "E1242")
    assert(rendered.contains("host `web1` names an unknown system `ghost`"), "{rendered}")
}

