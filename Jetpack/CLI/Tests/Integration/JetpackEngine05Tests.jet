#Test("jetpack_import_reports_unmappable_and_keeps_mappable_packages") {
    dir :: Scratch.new("import-gap")
    fs.write(dir.join("flake.nix"), "{{ }}") ?? panic("flake")
    fixtures :: Scratch.new("import-gap-fx")
    fs.write(fixtures.join("flake-devshell.json"), "{{\"buildInputs\": [\"ripgrep\", \"ripgrepp\"], \"shellHook\": \"\"}}") ?? panic("devshell")
    fs.write(fixtures.join("catalog.json"), "{{\"packages\": [\"ripgrep\"]}}") ?? panic("catalog")
    output :: jetpack().args([String]{"import", "flake.nix", "--no-color", "--fixtures"}).arg(fixtures.path).current_dir(dir.path).env("PATH", "").output() ?? panic("import")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    environment :: fs.read_to_string(dir.join("env.jet")) ?? panic("env")
    assert(environment.contains("packages: [ripgrep]"), "env: {environment}")
    assert(!environment.contains("ripgrepp"), "env: {environment}")
    stderr :: String.from_utf8_lossy(output.stderr)
    assert_eq(stderr.matches("JT0101").count(), 1, "stderr: {stderr}")
    assert(stderr.contains("unmappable Nix input `ripgrepp` at `flake.nix`; nearest catalog candidate: `ripgrep`"), "stderr: {stderr}")
    lock :: fs.read_to_string(dir.join(".jet/lock")) ?? panic("lock")
    assert(lock.contains("key = \"nix-import-unmapped:ripgrepp\""), "lock: {lock}")
}

