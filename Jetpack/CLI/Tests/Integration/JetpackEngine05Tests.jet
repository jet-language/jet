// Rust: tests/jetpack_engine.rs:8540
#Test("jet_build_reports_source_states") {
    (_base, proj, root) :: core_hello_project("t4-build")
    run :: () -> jetpack().args([String]{"build", "--no-color"}).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output() ?? panic("build")
    first :: run()
    assert(first.status.success(), "stderr: {String.from_utf8_lossy(first.stderr)}")
    out1 :: String.from_utf8_lossy(first.stderr)
    assert(out1.contains("built"), "first build must report `built`: {out1}")
    assert(out1.contains("1 built"), "summary must count the built package: {out1}")
    assert(out1.contains("build sandbox outcome: non-executing (no child launched)"), "build must report the recorded non-executing receipt: {out1}")
    second :: run()
    assert(second.status.success())
    out2 :: String.from_utf8_lossy(second.stderr)
    assert(out2.contains("cached"), "re-build of the same content must report `cached`: {out2}")
    assert(out2.contains("1 cached"), "summary must count the cache hit: {out2}")
    assert(out2.contains("build sandbox outcome: verified cache only"), "cache-only build must not claim a fresh sandbox execution: {out2}")
}

// Rust: tests/jetpack_engine.rs:8591
#Test("epoch4_dogfood_portfolio_rebuilds_offline_after_component_loss") {
    (base, project, root) :: core_hello_project("epoch4-dogfood-portfolio")
    missing_tools :: base.join("missing-tools")
    fs.create_dir_all(missing_tools) ?? panic("missing tools")
    source_executable :: base.join("jet-pkgs/pkgs/hello/bin/hello")
    build :: (offline: Bool) -> {
        command := jetpack()
        &command.args([String]{"build", "--no-color"}).current_dir(project).env("JETPACK_ROOT", root).env("PATH", missing_tools)
        if offline -> &command.arg("--offline")
        command.output() ?? panic("portfolio build")
    }
    first :: build(false)
    assert(first.status.success(), "first portfolio build failed: {String.from_utf8_lossy(first.stderr)}")
    first_stderr :: String.from_utf8_lossy(first.stderr)
    assert(first_stderr.contains("built") && first_stderr.contains("1 built"), "first portfolio build must publish a real result: {first_stderr}")
    cached :: build(true)
    assert(cached.status.success(), "offline portfolio reuse failed: {String.from_utf8_lossy(cached.stderr)}")
    cached_stderr :: String.from_utf8_lossy(cached.stderr)
    assert(cached_stderr.contains("cached") && cached_stderr.contains("1 cached"), "offline portfolio reuse must report a verified cache hit: {cached_stderr}")
    entered :: jetpack().args([String]{"env", "--no-color", "--trust", "--offline", "--", "hello"}).current_dir(project)
        .env("JETPACK_ROOT", root).env("HOME", base.join("home")).env("PATH", missing_tools).output() ?? panic("entry")
    assert(entered.status.success(), "offline front-door entry needs no ambient tools: {String.from_utf8_lossy(entered.stderr)}")
    entered_stdout := String.from_utf8_lossy(entered.stdout).trim() // #4303
    assert_eq(entered_stdout, "hello from jet-pkgs")
    roots :: Store.Roots.at(root.clone())
    entry :: (fs.read_dir(roots.hangar_dir()) ?? panic("hangar")).filter_map((item) -> item.ok()).find_map((node) -> {
        text :: fs.read_to_string(node.path().join("meta.json")).ok()?
        parsed :: Store.parse_meta(&text)?
        if parsed.reference == "hello@mine" -> Val(parsed) else -> None
    }) ?? panic("portfolio build must register its Hangar entry")
    make_directories_writable(OSPath.from(entry.out))
    fs.remove_dir_all(entry.out) ?? panic("remove output")
    fs.remove_file(source_executable) ?? panic("remove source")
    failed :: build(true)
    assert(!failed.status.success(), "missing portfolio component must fail closed")
    failed_stderr :: String.from_utf8_lossy(failed.stderr)
    assert(!failed_stderr.contains("built 1 package(s): 0 built, 1 cached"), "missing portfolio component was falsely reported as cached: {failed_stderr}")
    fs.write(source_executable, "#!/bin/sh\necho hello from jet-pkgs\n") ?? panic("repair source")
    if sys.target.selected_family() == "unix" -> fs.set_permissions(source_executable, fs.Permissions.from_mode(0o755)) ?? panic("executable")
    rebuilt :: build(true)
    assert(rebuilt.status.success(), "offline portfolio rebuild failed: {String.from_utf8_lossy(rebuilt.stderr)}")
    rebuilt_stderr :: String.from_utf8_lossy(rebuilt.stderr)
    assert(rebuilt_stderr.contains("built") && !rebuilt_stderr.contains("1 cached"), "repaired portfolio must rebuild instead of hiding the failure: {rebuilt_stderr}")
    (stale, _) :: write_hangar_meta(&root, "epoch4-dogfood-stale", "stale", "1.0", Val(1))
    clean :: jetpack().args([String]{"hangar", "clean", "--no-color", "--yes"}).env("JETPACK_ROOT", root).env("PATH", missing_tools).output() ?? panic("clean")
    assert(clean.status.success(), "portfolio clean failed: {String.from_utf8_lossy(clean.stderr)}")
    assert(!stale.exists(), "portfolio clean left stale Hangar state")
}

// Rust: tests/jetpack_engine.rs:8715
#Test("jet_build_publishes_then_falls_back_to_source_when_cache_is_unavailable") {
    (_base, proj, root) :: core_hello_project("cache-source-fallback")
    mirror :: Scratch.new("cache-source-fallback-mirror")
    roots :: Store.Roots{root: root.clone(), dev_mode: false}
    Store.bind_cache(&roots, "public", [String]{mirror.path.display().to_string()}, None, None, true) ?? panic("bind cache")
    run :: (fake_sandbox: String?) -> {
        command := jetpack()
        &command.args([String]{"build", "--no-color"}).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin")
        if fake_sandbox == { .Val(value) -> &command.env("JETPACK_FAKE_SANDBOX", value); .None -> {} }
        command.output() ?? panic("build")
    }
    first :: run(None)
    assert(first.status.success(), "stderr: {String.from_utf8_lossy(first.stderr)}")
    entry :: Store.find_by_reference(&roots, "hello@mine") ?? panic("entry")
    producer :: Store.ProducerRecord.decode(entry.producer_record) ?? panic("producer")
    assert(producer.facts.get("cache.reproducibility").is_some_and((value) -> value.starts_with("independent-agreeing-v1:")), "uncached source builds must carry fresh independent agreement")
    assert(!root.join("private/unreproducible").exists())
    assert((fs.read_dir(mirror.path) ?? panic("mirror")).flatten().any((entry) -> entry.path().extension().and_then((ext) -> ext.to_str()) == Val("narinfo")), "source realization must publish a signed cache record")
    make_writable(&entry.out)
    fs.write(OSPath.from(entry.out).join("bin/hello"), "tampered\n") ?? panic("tamper")
    substituted :: run(Val("unavailable"))
    assert(substituted.status.success(), "verified cache substitution must repair the local candidate: {String.from_utf8_lossy(substituted.stderr)}")
    substituted_stderr :: String.from_utf8_lossy(substituted.stderr)
    assert(substituted_stderr.contains("L0205"), "unavailable allow-mode action must record the fallback decision: {substituted_stderr}")
    assert(substituted_stderr.contains("substituted") && substituted_stderr.contains("1 substituted"), "production build must report the verified substitution: {substituted_stderr}")
    repaired :: Store.find_by_reference(&roots, "hello@mine") ?? panic("repaired entry")
    assert_eq(fs.read_to_string(OSPath.from(repaired.out).join("bin/hello")) ?? panic("repaired payload"), "#!/bin/sh\necho hello from jet-pkgs\n")
    make_writable(&repaired.out)
    fs.write(OSPath.from(repaired.out).join("bin/hello"), "tampered again\n") ?? panic("tamper again")
    fs.remove_dir_all(mirror.path) ?? panic("remove mirror")
    fs.write(mirror.path, "cache substituter unavailable") ?? panic("unavailable mirror")
    fallback :: run(None)
    assert(fallback.status.success(), "source fallback must survive an unavailable substituter: {String.from_utf8_lossy(fallback.stderr)}")
    stderr :: String.from_utf8_lossy(fallback.stderr)
    assert(stderr.contains("built"), "fallback must rebuild from source: {stderr}")
    assert(!stderr.contains("1 cached"), "an unavailable substituter must not report a cache hit: {stderr}")
}

// Rust: tests/jetpack_engine.rs:8818
#Test("jet_build_rejects_cache_after_manifest_semantics_change") {
    (base, proj, root) :: core_hello_project("truth-manifest-identity")
    manifest :: base.join("jet-pkgs/package.jet")
    fs.write(manifest, "name: \"demo\"\nversion: \"1.0.0\"\npackages: {{ hello: executable }}\n") ?? panic("manifest")
    run :: () -> jetpack().args([String]{"build", "--no-color"}).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output() ?? panic("build")
    assert(run().status.success())
    fs.write(manifest, "name: \"demo\"\nversion: \"2.0.0\"\npackages: {{ hello: executable }}\n") ?? panic("changed manifest")
    rejected :: run()
    assert(!rejected.status.success())
    stderr :: String.from_utf8_lossy(rejected.stderr)
    assert(stderr.contains("E2604"), "stderr: {stderr}")
    assert(stderr.contains("recipe identity verification"), "stderr: {stderr}")
}

// Rust: tests/jetpack_engine.rs:8852
#Test("independent_root_runner_promotes_only_agreed_source_output") {
    (_base, project, root) :: core_hello_project("independent-root-runner")
    roots :: Store.Roots.at(root.clone())
    repo :: (project.parent() ?? panic("parent")).join("jet-pkgs")
    table :: RefSpec.SourceTable.from_decls([(String, String, RefSpec.ProviderKind)]{("mine", "path:{repo.display()}", RefSpec.ProviderKind.Core)})
    spec :: RefSpec.classify_in("hello@mine", &table) ?? panic("spec")
    store_dir :: roots.hangar_dir()
    ctx :: Provider.Ctx{fixtures: None, store_dir: &store_dir, offline: true, project_dir: None, nix_index: None, nix_roots: None, allow_local_nix_catalog: false}
    result :: Store.certify_independent_root_build(&roots, &ctx, Store.RealizeRequest.Package{spec: &spec, table: &table}, Store.IndependentRootOptions.default()) ?? panic("independent build")
    assert(result.attestation.starts_with("independent-agreeing-v1:"))
    assert(OSPath.from(result.entry.out).starts_with(roots.hangar_dir().join("objects")))
    producer :: Store.ProducerRecord.decode(result.entry.producer_record) ?? panic("producer")
    assert_eq(producer.facts.get("cache.reproducibility"), Val(result.attestation))
    assert(!root.join("private/unreproducible").exists())
    assert(!fs.read_dir(roots.hangar_dir().join("reproducibility-staging")).map((entries) -> entries.flatten().next().is_some()).unwrap_or(false))
}

// Rust: tests/jetpack_engine.rs:8898
#Test("independent_root_runner_rejects_divergence_before_registration") {
    (_base, project, root) :: core_hello_project("independent-root-divergence")
    roots :: Store.Roots.at(root.clone())
    repo :: (project.parent() ?? panic("parent")).join("jet-pkgs")
    table :: RefSpec.SourceTable.from_decls([(String, String, RefSpec.ProviderKind)]{("mine", "path:{repo.display()}", RefSpec.ProviderKind.Core)})
    spec :: RefSpec.classify_in("hello@mine", &table) ?? panic("spec")
    store_dir :: roots.hangar_dir()
    ctx :: Provider.Ctx{fixtures: None, store_dir: &store_dir, offline: true, project_dir: None, nix_index: None, nix_roots: None, allow_local_nix_catalog: false}
    checks :: Cell.new(0)
    source :: repo.join("pkgs/hello/bin/hello")
    changed :: () -> {
        count :: checks.get() + 1
        checks.set(count)
        if count == 2 -> fs.write(source, "#!/bin/sh\necho divergent\n") ?? panic("diverge")
        false
    }
    failure :: Store.certify_independent_root_build(&roots, &ctx, Store.RealizeRequest.Package{spec: &spec, table: &table}, Store.IndependentRootOptions{retries: 0, cancelled: Val(&changed)}).err() ?? panic("expected divergence")
    error :: "{failure:?}"
    assert(error.contains("conflicting independent roots"), "{error}")
    assert(Store.list(&roots).is_empty())
    reports :: root.join("private/unreproducible")
    report_entry :: (fs.read_dir(reports) ?? panic("reports")).flatten().find((entry) -> entry.path().extension().and_then((value) -> value.to_str()) == Val("json")) ?? panic("divergence evidence")
    report :: fs.read_to_string(report_entry.path()) ?? panic("report")
    assert(report.contains("\"kind\":\"action-identity\""), "{report}")
    assert(report.contains("\"left_action_key\""), "{report}")
    assert(report.contains("\"right_action_key\""), "{report}")
}

// Rust: tests/jetpack_engine.rs:8957
#Test("independent_root_runner_cancellation_leaves_no_store_result") {
    (_base, project, root) :: core_hello_project("independent-root-cancel")
    roots :: Store.Roots.at(root.clone())
    repo :: (project.parent() ?? panic("parent")).join("jet-pkgs")
    table :: RefSpec.SourceTable.from_decls([(String, String, RefSpec.ProviderKind)]{("mine", "path:{repo.display()}", RefSpec.ProviderKind.Core)})
    spec :: RefSpec.classify_in("hello@mine", &table) ?? panic("spec")
    store_dir :: roots.hangar_dir()
    ctx :: Provider.Ctx{fixtures: None, store_dir: &store_dir, offline: true, project_dir: None, nix_index: None, nix_roots: None, allow_local_nix_catalog: false}
    cancelled :: () -> true
    error :: Store.certify_independent_root_build(&roots, &ctx, Store.RealizeRequest.Package{spec: &spec, table: &table}, Store.IndependentRootOptions{retries: 1, cancelled: Val(&cancelled)}).err() ?? panic("expected cancellation")
    assert("{error:?}".contains("cancelled"), "{error:?}")
    assert(Store.list(&roots).is_empty())
}
