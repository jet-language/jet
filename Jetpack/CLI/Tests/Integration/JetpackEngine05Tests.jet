// Rust: tests/jetpack_engine.rs:7195
#Test("bridge_flake_native_commits_losses_and_preserves_lock_on_failure") {
    dir :: Scratch.new("bridge-native-loss-lock")
    fs.write(dir.join("flake.nix"), "{{\n  devShells.x86_64-linux.default = {{\n    packages = [ pkgs.fd ];\n    shellHook = \"export FOO=1\";\n  }};\n}}\n") ?? panic("flake")
    first :: jetpack().args([String]{"bridge", "flake", "--no-color"}).current_dir(dir.path).env("PATH", "/usr/bin:/bin").output() ?? panic("bridge")
    assert(first.status.success(), "stderr: {String.from_utf8_lossy(first.stderr)}")
    assert(String.from_utf8_lossy(first.stdout).contains("packages: [fd]"), "stdout: {String.from_utf8_lossy(first.stdout)}")
    stderr :: String.from_utf8_lossy(first.stderr)
    assert(stderr.contains("L0204"), "native loss was not disclosed: {stderr}")
    assert(stderr.contains("shellHook"), "native loss name missing: {stderr}")
    lock_path :: dir.join(".jet/lock")
    before :: fs.read(lock_path) ?? panic("native bridge must commit its lock")
    lock_text :: String.from_utf8_lossy(before)
    assert(lock_text.contains("shellHook"), "lock lost native loss fact: {lock_text}")
    fs.write(dir.join("flake.nix"), "{{ devShells.x86_64-linux.default = {{ packages = pkgs.lib.optionals true [ pkgs.fd ]; }}; }}\n") ?? panic("dynamic flake")
    failed :: jetpack().args([String]{"bridge", "flake", "--no-color"}).current_dir(dir.path).env("PATH", "/usr/bin:/bin").output() ?? panic("bridge failure")
    assert_eq(failed.status.code(), Val(1))
    assert(String.from_utf8_lossy(failed.stderr).contains("E1256"))
    assert_eq(fs.read(lock_path) ?? panic("preserved lock"), before)
}

// Rust: tests/jetpack_engine.rs:7258
#Test("bridge_flake_commits_transitive_locked_registry_facts_without_nix") {
    dir :: Scratch.new("bridge-locked-flake")
    fs.write(dir.join("flake.nix"), "{{\n  inputs.tools.url = \"github:example/tools?rev=0123456789abcdef0123456789abcdef01234567\";\n  devShells.x86_64-linux.default = pkgs.mkShell {{ packages = [ pkgs.fd ]; }};\n}}\n") ?? panic("flake")
    flake_lock :: "{{\n  \"nodes\": {{\n    \"root\": {{ \"inputs\": {{ \"tools\": \"tools\" }} }},\n    \"tools\": {{\n      \"inputs\": {{ \"nixpkgs\": \"nixpkgs\" }},\n      \"locked\": {{ \"owner\": \"example\", \"repo\": \"tools\", \"rev\": \"0123456789abcdef0123456789abcdef01234567\", \"type\": \"github\" }},\n      \"original\": {{ \"owner\": \"example\", \"repo\": \"tools\", \"type\": \"github\" }}\n    }},\n    \"nixpkgs\": {{\n      \"locked\": {{ \"owner\": \"NixOS\", \"repo\": \"nixpkgs\", \"rev\": \"89abcdef0123456789abcdef0123456789abcdef\", \"type\": \"github\" }},\n      \"original\": {{ \"id\": \"nixpkgs\", \"type\": \"indirect\" }}\n    }}\n  }},\n  \"root\": \"root\",\n  \"version\": 7\n}}\n"
    fs.write(dir.join("flake.lock"), flake_lock) ?? panic("flake lock")
    output :: jetpack().args([String]{"bridge", "flake", "--no-color"}).current_dir(dir.path).env("PATH", "/usr/bin:/bin").output() ?? panic("bridge")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    assert(String.from_utf8_lossy(output.stdout).contains("packages: [fd]"), "stdout: {String.from_utf8_lossy(output.stdout)}")
    semantic :: fs.read_to_string(dir.join(".jet/lock")) ?? panic("semantic lock")
    lock :: SemanticLock.parse(&semantic)
    edge :: lock.records.iter().find((record) -> record.identity.key == "flake-lock-node:tools") ?? panic("tools lock node record")
    assert_eq(edge.identity.exact, "{{\"inputs\":[{{\"name\":\"nixpkgs\",\"target\":\"nixpkgs\"}}],\"locked\":{{\"owner\":\"example\",\"repo\":\"tools\",\"rev\":\"0123456789abcdef0123456789abcdef01234567\",\"type\":\"github\"}},\"name\":\"tools\",\"original\":{{\"owner\":\"example\",\"repo\":\"tools\",\"type\":\"github\"}}}}")
    registry :: lock.records.iter().find((record) -> record.identity.key == "flake-registry:nixpkgs") ?? panic("nixpkgs registry record")
    assert_eq(registry.identity.exact, "{{\"alias\":\"nixpkgs\",\"locked\":{{\"owner\":\"NixOS\",\"repo\":\"nixpkgs\",\"rev\":\"89abcdef0123456789abcdef0123456789abcdef\",\"type\":\"github\"}},\"node\":\"nixpkgs\",\"original\":{{\"id\":\"nixpkgs\",\"type\":\"indirect\"}}}}")
    replay :: jetpack().args([String]{"bridge", "flake", "--no-color"}).current_dir(dir.path).env("PATH", "/usr/bin:/bin").output() ?? panic("replay")
    assert_eq(replay.status.code(), Val(0), "replay stderr: {String.from_utf8_lossy(replay.stderr)}")
    assert_eq(replay.stdout, output.stdout)
    assert_eq(fs.read_to_string(dir.join(".jet/lock")) ?? panic("lock replay"), semantic)
    wrong_lock :: flake_lock.replace("\"original\": {{ \"owner\": \"example\", \"repo\": \"tools\", \"type\": \"github\" }}", "\"original\": {{ \"owner\": \"wrong\", \"repo\": \"repo\", \"type\": \"github\" }}")
    fs.remove_file(dir.join(".jet/lock")) ?? panic("remove semantic lock")
    fs.write(dir.join("flake.lock"), wrong_lock) ?? panic("wrong lock")
    failure :: jetpack().args([String]{"bridge", "flake", "--no-color"}).current_dir(dir.path).env("PATH", "/usr/bin:/bin").output() ?? panic("wrong bridge")
    failure_stderr :: String.from_utf8(failure.stderr) ?? panic("stderr UTF8")
    assert_eq(failure.status.code(), Val(1), "{failure_stderr}")
    assert(failure_stderr.contains("Error [E1340]: couldn't load the foreign graph"), "{failure_stderr}")
    assert(failure_stderr.contains("flake.lock root input `tools` maps to node `tools` with a different source URL or indirect alias"), "{failure_stderr}")
}

