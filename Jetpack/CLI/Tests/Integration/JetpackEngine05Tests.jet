    originals :: [(String, String)]{
        ("pkg.jet", "name: \"demo\"\nversion: \"0.1.0\"\n"),
        ("env.jet", "module env.dev {{ tools: [\"git@nixpkgs\"] }}\n"),
        ("workspace.jet", "module workspace {{ members: [] }}\n"),
        ("config.jet", "Config{{ }}\n")
    }
    loop (name, source) in originals -> fs.write(legacy_project.join(name), source) ?? panic("role file")
    init_check :: jet().args([String]{"init", "--check"}).current_dir(legacy_project.path).output() ?? panic("init check")
    assert(init_check.status.success(), "stderr: {String.from_utf8_lossy(init_check.stderr)}")
    assert(String.from_utf8_lossy(init_check.stdout).contains("No files changed."))
    init :: jet().args([String]{"init"}).current_dir(legacy_project.path).output() ?? panic("init")
    assert(init.status.success(), "stderr: {String.from_utf8_lossy(init.stderr)}")
    assert(legacy_project.join("package.jet").is_file())
    restore_check :: jet().args([String]{"init", "--restore-role-files", "--check"}).current_dir(legacy_project.path).output() ?? panic("restore check")
    assert(restore_check.status.success(), "stderr: {String.from_utf8_lossy(restore_check.stderr)}")
