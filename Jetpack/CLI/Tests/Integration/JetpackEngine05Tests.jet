// Rust: tests/jetpack_engine.rs:7741
#Test("core_cargo_build_requires_exact_trust_before_running_build_script") {
    base :: Scratch.new("core-cargo-trust")
    repo :: base.join("jet-pkgs")
    project :: base.join("project")
    root :: base.join("root")
    home :: base.join("home")
    marker :: base.join("host-marker")
    fs.create_dir_all(repo) ?? panic("repo")
    fs.create_dir_all(project) ?? panic("project")
    fs.create_dir_all(home) ?? panic("home")
    fs.write(repo.join("package.jet"), "name: \"jet-pkgs\"\nversion: \"0.1.0\"\npackages: {{ escape: library }}\n") ?? panic("package")
    fs.write(repo.join("escape.jet"), "module escape {{ }}\n") ?? panic("module")
    // Foreign Cargo source is the trust-gate attack fixture, not a Rust runtime bridge.
    fs.write(repo.join("lib.rs"), "pub fn value() -> u8 {{ 1 }}\n") ?? panic("foreign library")
    fs.write(repo.join("Cargo.toml"), "[package]\nname = \"escape\"\nversion = \"0.1.0\"\nbuild = \"build.rs\"\n[lib]\npath = \"lib.rs\"\n") ?? panic("foreign manifest")
    fs.write(repo.join("Cargo.lock"), "# This file is automatically @generated by Cargo.\nversion = 3\n\n[[package]]\nname = \"escape\"\nversion = \"0.1.0\"\n\n") ?? panic("foreign lock")
    marker_text :: marker.to_string_lossy()
    fs.write(repo.join("build.rs"), "fn main() {{ let _ = std::fs::write({marker_text:?}, \"escaped\"); }}\n") ?? panic("foreign attack")
    fs.write(project.join("env.jet"), "use jetpack as pkg\npub fn shell() -> [JSON] {{\n    return [\n        pkg.source(\"mine\", \"{repo.to_string_lossy()}\", \"core\"),\n        pkg.packages([\"escape@mine\"])\n    ]\n}}\n") ?? panic("environment")
    output :: jetpack().args([String]{"build", "--no-color"}).current_dir(project).env("HOME", home).env("JETPACK_ROOT", root)
        .env("JETPACK_FAKE_SANDBOX", "unavailable").env("PATH", "/usr/bin:/bin").output() ?? panic("untrusted build")
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(!output.status.success(), "stderr: {stderr}")
    assert(stderr.contains("E1255"), "stderr: {stderr}")
    assert(!marker.exists(), "build.rs ran before exact trust approval")
    assert(Store.list(&Store.Roots.at(root)).is_empty())
}

// Rust: tests/jetpack_engine.rs:7802
#Test("committed_example_builds_offline_end_to_end") {
    project :: Scratch.new("example-e2e-project")
    copy_dir_recursive(&example_dir(), &project.path)
    root :: Scratch.new("example-e2e")
    output :: jetpack().args([String]{"build", "--no-color", "--offline"}).current_dir(project.path).env("JETPACK_ROOT", root.path).env("JETPACK_FIXTURES", example_fixtures(&root.path)).output() ?? panic("offline build")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("building completed 0/3 · current: stable -> ripgrep · resolving") && stderr.contains("building completed 1/3 · current: unstable -> neovim · resolving") && stderr.contains("building completed 2/3 · current: mine -> hello · resolving"), "plain non-TTY output must preserve ordered source-to-package edges: {stderr}")
    loop pkg in [String]{"ripgrep", "neovim", "hello"} -> assert(stderr.contains(pkg), "expected `{pkg}` in build output: {stderr}")
    assert(stderr.contains("built 3 package(s)"), "stderr: {stderr}")
}

// Rust: tests/jetpack_engine.rs:7843
#Test("use_many_packages_settles_one_row_per_package_without_output_flood") {
    if sys.target.selected_family() != "unix" -> return
    project :: Scratch.new("use-many-packages")
    copy_dir_recursive(&example_dir(), &project.path)
    root :: Scratch.new("use-many-packages-root")
    fixtures :: example_fixtures(&root.path)
    artifact :: fixtures.join("omp-1.0.0")
    fs.write(artifact, "#!/bin/sh\nprintf '%s\\n' omp\n") ?? panic("artifact")
    digest :: SHA256.sha256_file_hex(&artifact) ?? panic("digest")
    fs.write(fixtures.join("jetpackage-omp.json"), "{{\"tag\":\"v1.0.0\",\"version\":\"1.0.0\",\"sha256\":\"{digest}\",\"artifact\":\"omp-1.0.0\"}}") ?? panic("metadata")
    refs :: (0..26).map((_) -> "omp@releases#1.0.0").collect().join(" ")
    binary :: common.jetpack_bin().display().to_string().replace('\'', "'\\''")
    fixtures_arg :: fixtures.display().to_string().replace('\'', "'\\''")
    command :: "stty rows 30 cols 120; exec '{binary}' use --prep --offline --fixtures '{fixtures_arg}' -y {refs}"
    output :: Command.new("script").args([String]{"-qfec", command, "/dev/null"}).current_dir(project.path).env("JETPACK_ROOT", root.path)
        .env("JETPACK_FIXTURES", fixtures).env_remove("NO_COLOR").env_remove("FORCE_COLOR").output() ?? panic("pty command")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}\nstdout: {String.from_utf8_lossy(output.stdout)}")
    transcript :: String.from_utf8_lossy(output.stdout)
    settled :: transcript.matches('✓').count()
    assert_eq(settled, 26, "one settled row per package: {transcript}")
    assert(settled + 1 <= 30, "26 settled rows plus aggregate must fit the 30-row terminal: {transcript}")
    assert(transcript.contains("0/26 packages"), "aggregate live line must remain pinned above settled rows: {transcript}")
}

// Rust: tests/jetpack_engine.rs:7899
#Test("failed_first_dependency_reports_zero_completed_nodes") {
    (_base, proj, root) :: core_hello_project("progress-first-failure")
    env_path :: proj.join("env.jet")
    environment :: (fs.read_to_string(env_path) ?? panic("environment")).replace("[\"hello@mine\"]", "[\"missing@mine\", \"hello@mine\"]")
    fs.write(env_path, environment) ?? panic("environment")
    out :: jetpack().args([String]{"build", "--no-color"}).current_dir(proj).env("JETPACK_ROOT", root).output() ?? panic("build")
    assert(!out.status.success())
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("building completed 0/2 · current: mine -> missing · resolving"), "first failure must not claim completion: {stderr}")
    assert(!stderr.contains("building completed 1/2 · current: mine -> missing"))
    assert(stderr.contains("error:") || stderr.to_lowercase().contains("could not"), "failure must print a diagnostic after erasing the live region: {stderr}")
}

