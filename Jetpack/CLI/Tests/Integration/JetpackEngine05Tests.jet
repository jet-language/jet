    fs.copy(journal, journal_dir.join("duplicate-journal")) ?? panic("duplicate journal")
    ambiguous_fold :: jet().args([String]{"fold", "package/fleet.jet"}).current_dir(ambiguous_hosts.path).output() ?? panic("ambiguous fold")
    assert_eq(ambiguous_fold.status.code(), Val(1))
    assert(String.from_utf8_lossy(ambiguous_fold.stderr).contains("found 2"))

