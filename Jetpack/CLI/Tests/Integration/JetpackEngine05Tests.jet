// Rust: tests/jetpack_engine.rs:7577
#Test("core_provider_runs_first_party_package_without_nix") {
    base :: Scratch.new("core")
    repo :: base.join("jet-pkgs")
    proj :: base.join("proj")
    root :: base.join("root")
    hello_pkg :: repo.join("pkgs/hello")
    hello_bin :: hello_pkg.join("bin")
    fs.create_dir_all(hello_bin) ?? panic("bin")
    fs.create_dir_all(proj) ?? panic("project")
    fs.write(hello_pkg.join("hello.jet"), "module hello {{ }}\n") ?? panic("module")
    greet :: hello_bin.join("hello")
    fs.write(greet, "#!/bin/sh\necho hello from jet-pkgs\n") ?? panic("executable")
    if sys.target.selected_family() == "unix" -> fs.set_permissions(greet, fs.Permissions.from_mode(0o755)) ?? panic("permissions")
    fs.write(proj.join("env.jet"), "use jetpack as pkg\npub fn shell() -> [JSON] {{\n    return [\n        pkg.source(\"mine\", \"{repo.to_string_lossy()}\", \"core\"),\n        pkg.packages([\"hello@mine\"])\n    ]\n}}\n") ?? panic("environment")
    output :: jetpack().args([String]{"run", "--no-color", "--", "hello"}).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output() ?? panic("run")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    stdout := String.from_utf8_lossy(output.stdout).trim() // #4303
    assert_eq(stdout, "hello from jet-pkgs")
}

