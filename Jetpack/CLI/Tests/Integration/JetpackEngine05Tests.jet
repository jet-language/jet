    unknown :: jet().args([String]{"split", "hosts", "missing"}).current_dir(unknown_hosts.path).output() ?? panic("unknown split")
    assert_eq(unknown.status.code(), Val(1))
    assert(String.from_utf8_lossy(unknown.stderr).contains("outputs.missing"))
