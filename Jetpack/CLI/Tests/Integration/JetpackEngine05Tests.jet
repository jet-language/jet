// Rust: tests/jetpack_engine.rs:7467
#Test("jetpack_import_flake_writes_env_and_lock_from_fixture") {
    dir :: Scratch.new("import-flake")
    fs.write(dir.join("flake.nix"), "{{ }}") ?? panic("flake")
    fixtures :: Scratch.new("import-flake-fx")
    fs.write(fixtures.join("flake-devshell.json"), "{{\"buildInputs\": [\"ripgrep\", \"fd\"], \"shellHook\": \"\"}}") ?? panic("devshell")
    fs.write(fixtures.join("catalog.json"), "{{\"packages\": [\"fd\", \"ripgrep\"]}}") ?? panic("catalog")
    output :: jetpack().args([String]{"import", "flake.nix", "--no-color", "--fixtures"}).arg(fixtures.path).current_dir(dir.path).env("PATH", "").output() ?? panic("import")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    assert_eq(fs.read_to_string(dir.join("env.jet")) ?? panic("env"), "// Generated by `jetpack import` from a bounded Nix devShell.\nmodule env.dev {{\n    packages: [fd, ripgrep]\n}}\n")
    lock :: fs.read_to_string(dir.join(".jet/lock")) ?? panic("lock")
    assert(lock.contains("kind = \"package\""), "lock: {lock}")
    assert(lock.contains("key = \"fd\""), "lock: {lock}")
    assert(lock.contains("exact = \"fd@jetpack\""), "lock: {lock}")
    assert(lock.contains("key = \"ripgrep\""), "lock: {lock}")
}

