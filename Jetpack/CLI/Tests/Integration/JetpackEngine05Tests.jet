    fs.write(invalid_hosts.join("package.jet"), "name: \"demo\"\noutputs: {{ server: System{{ name: \"server\" }} }}\n") ?? panic("invalid hosts")
    invalid :: jet().args([String]{"split", "hosts", "server/name"}).current_dir(invalid_hosts.path).output() ?? panic("invalid split")
    assert_eq(invalid.status.code(), Val(1))
