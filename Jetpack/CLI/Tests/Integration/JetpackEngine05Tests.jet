    root :: Scratch.new("typed-e2e")
    output :: jetpack().args([String]{"build", "--no-color", "--offline"}).current_dir(project.path).env("JETPACK_ROOT", root.path)
        .env("JETPACK_FIXTURES", realized_fixtures(&project.join("fixtures"), &root.path)).output() ?? panic("typed build")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    stderr :: String.from_utf8_lossy(output.stderr)
    loop pkg in [String]{"ripgrep", "fd", "jq"} -> assert(stderr.contains(pkg), "expected `{pkg}` in build output: {stderr}")
    assert(stderr.contains("built 3 package(s)"), "stderr: {stderr}")
}

