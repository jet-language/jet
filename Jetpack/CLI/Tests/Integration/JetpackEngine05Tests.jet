    ambiguous_split :: jet().args([String]{"split", "hosts", "server"}).current_dir(ambiguous_hosts.path).output() ?? panic("ambiguous split")
    assert(ambiguous_split.status.success(), "stderr: {String.from_utf8_lossy(ambiguous_split.stderr)}")
    journal_dir :: ambiguous_hosts.join(".jet/package-transition")
