    assert_eq(duplicate.status.code(), Val(1))
    assert(String.from_utf8_lossy(duplicate.stderr).contains("member Package name `app` is declared more than once"))
    assert_eq(fs.read_to_string(duplicate_project.join("package.jet")) ?? panic("preserved package"), duplicate_original)
