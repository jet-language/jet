    stale_hosts_fold :: jet().args([String]{"fold", "package/fleet.jet"}).current_dir(stale_hosts.path).output() ?? panic("stale hosts fold")
    assert_eq(stale_hosts_fold.status.code(), Val(1))
    assert(String.from_utf8_lossy(stale_hosts_fold.stderr).contains("stale transition"))

    ambiguous_hosts :: Scratch.new("transition-cli-ambiguous-host-journal")
