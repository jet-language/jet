// Supervised dev service integration fixtures (tests/jetpack_services.rs).
use common.[jetpack_bin, Scratch]
use std.[fs, env, process, thread]
use std.process.Command
use std.time.[Duration, Instant]
use std.sync.OnceLock
use JetEnvModel.ModuleEval.[DevServicePlan, PromptPathMode, PromptStripMode]
use Jetpack.Shell.Env as ShellEnv
use core.sys.target
// GATE #4494: real subprocesses, filesystem permissions, OnceLock, threads and environment.
// GATE #4483: Linux fixtures are selected by target facts, not host assumptions.

// Rust: tests/jetpack_services.rs:28
pub fn jetpack() -> Command {
    command := Command.new(jetpack_bin())
    if target.selected_os() == "linux" {
        fake :: fake_systemd()
        current_path :: env.var_os("PATH") ?? OSString.new()
        path :: "{fake.bin.display()}:{current_path.to_string_lossy()}"
        command.env("PATH", path).env("JETPACK_FAKE_SYSTEMD_STATE", fake.state)
    }
    command
}

// Rust: tests/jetpack_services.rs:43
pub struct FakeSystemd { bin: OSPath, state: OSPath }

// Rust: tests/jetpack_services.rs:49
pub fn fake_systemd() -> &FakeSystemd {
    // GATE #4494: process-lifetime thread-safe fixture initialization.
    static FAKE :: OnceLock[FakeSystemd].new()
    FAKE.get_or_init(() -> {
        root :: env.temp_dir().join("jpk-fake-systemd-{process.id()}")
        bin :: root.join("bin")
        state :: root.join("state")
        fs.create_dir_all(bin).expect("create systemd bin")
        fs.create_dir_all(state).expect("create systemd state")
        systemd_run :: "#!/bin/sh\nset -eu\nstate=${{JETPACK_FAKE_SYSTEMD_STATE:-$(dirname \"$0\")/../state}}\nunit=\nworkdir=\nsaw_user=0\nsaw_scope=0\nsaw_collect=0\nsaw_quiet=0\nsaw_delegate=0\nsaw_kill_mode=0\nwhile [ \"$#\" -gt 0 ]; do\n    case \"$1\" in\n        --user) saw_user=1 ;;\n        --scope) saw_scope=1 ;;\n        --collect) saw_collect=1 ;;\n        --quiet) saw_quiet=1 ;;\n        --property=Delegate=yes) saw_delegate=1 ;;\n        --property=KillMode=control-group) saw_kill_mode=1 ;;\n        --unit=*) unit=${{1#--unit=}} ;;\n        --working-directory=*) workdir=${{1#--working-directory=}} ;;\n        --setenv=*) export \"${{1#--setenv=}}\" ;;\n        --unsetenv=*) unset \"${{1#--unsetenv=}}\" ;;\n        --) shift; break ;;\n    esac\n    shift\ndone\n[ -n \"$unit\" ]\n[ \"$saw_user\" -eq 1 ]\n[ \"$saw_scope\" -eq 1 ]\n[ \"$saw_collect\" -eq 1 ]\n[ \"$saw_quiet\" -eq 1 ]\n[ \"$saw_delegate\" -eq 1 ]\n[ \"$saw_kill_mode\" -eq 1 ]\nmkdir -p \"$state\"\nprintf '%s\\n' \"$$\" > \"$state/$unit.pid\"\n[ -z \"$workdir\" ] || cd \"$workdir\"\nexec \"$@\"\n"
        systemd_run_path :: bin.join("systemd-run")
        fs.write(systemd_run_path, systemd_run).expect("write systemd-run")
        permissions := fs.metadata(systemd_run_path).expect("systemd-run metadata").permissions()
        permissions.set_mode(0o755)
        fs.set_permissions(systemd_run_path, permissions).expect("chmod systemd-run")
        systemctl :: "#!/bin/sh\nset -eu\nstate=${{JETPACK_FAKE_SYSTEMD_STATE:-$(dirname \"$0\")/../state}}\nsignal=TERM\nunit=\noperation=kill\nfor arg in \"$@\"; do\n    case \"$arg\" in\n        is-active) operation=active ;;\n        --signal=*) signal=${{arg#--signal=}} ;;\n        *.scope) unit=$arg ;;\n    esac\ndone\n[ -n \"$unit\" ]\npid=$(cat \"$state/$unit.pid\")\nif [ \"$operation\" = active ]; then\n    for stat in /proc/[0-9]*/stat; do\n        [ -r \"$stat\" ] || continue\n        line=$(cat \"$stat\") || continue\n        rest=${{line##*)}}\n        set -- $rest\n        state_code=$1\n        process_group=$3\n        if [ \"$process_group\" = \"$pid\" ] && [ \"$state_code\" != Z ]; then\n            exit 0\n        fi\n    done\n    exit 3\nfi\nkill \"-$signal\" -- \"-$pid\" 2>/dev/null || kill \"-$signal\" \"$pid\" 2>/dev/null || true\nexit 0\n"
        systemctl_path :: bin.join("systemctl")
        fs.write(systemctl_path, systemctl).expect("write systemctl")
        ctl_permissions := fs.metadata(systemctl_path).expect("systemctl metadata").permissions()
        ctl_permissions.set_mode(0o755)
        fs.set_permissions(systemctl_path, ctl_permissions).expect("chmod systemctl")
        FakeSystemd { bin, state }
    })
}

// Rust: tests/jetpack_services.rs:146
// A packageless project (never trust-sensitive) declaring one dev service.
pub fn write_project(dir: &OSPath, services_body: &String, main_src: &String) -> {
    fs.write(dir.join("env.jet"), "module env.dev {{ services: {{ {services_body} }} }}\n").expect("write env.jet")
    fs.write(dir.join("run.jet"), main_src).expect("write run.jet")
}

// Rust: tests/jetpack_services.rs:610
pub fn wait_for_file_lines(path: &OSPath, minimum: USize) -> {
    deadline :: Instant.now() + Duration.from_secs(5)
    loop {
        lines :: fs.read_to_string(path).map((text) -> text.lines().count()) ?? 0
        if lines >= minimum { return }
        assert(Instant.now() < deadline, "timed out waiting for {minimum} lines in {path.display()}")
        thread.sleep(Duration.from_millis(50))
    }
}

// Rust: tests/jetpack_services.rs:630
pub fn process_is_alive(pid: U32) -> Bool {
    if stat :: fs.read_to_string("/proc/{pid}/stat").ok() {
        if (_, rest) :: stat.rsplit_once(')') {
            if rest.split_whitespace().next() == Some("Z") { return false }
        }
    }
    Command.new("kill").args(["-0", pid.to_string()]).status().is_ok_and((status) -> status.success())
}

// Rust: tests/jetpack_services.rs:646
pub fn wait_for_missing(path: &OSPath) -> {
    deadline :: Instant.now() + Duration.from_secs(5)
    while path.exists() {
        assert(Instant.now() < deadline, "timed out waiting for {path.display()} to disappear")
        thread.sleep(Duration.from_millis(50))
    }
}

// Rust: tests/jetpack_services.rs:658
pub fn wait_for_file_contains(path: &OSPath, expected: &String) -> {
    deadline :: Instant.now() + Duration.from_secs(5)
    loop {
        if fs.read_to_string(path).map((text) -> text.contains(expected)) ?? false { return }
        assert(Instant.now() < deadline, "timed out waiting for `{expected}` in {path.display()}")
        thread.sleep(Duration.from_millis(50))
    }
}

// Rust: tests/jetpack_services.rs:677
pub fn write_executable(path: &OSPath, contents: &String) -> {
    fs.write(path, contents).expect("write executable")
    permissions := fs.metadata(path).expect("executable metadata").permissions()
    permissions.set_mode(0o755)
    fs.set_permissions(path, permissions).expect("chmod executable")
}

// Rust: tests/jetpack_services.rs:687
pub fn catalog_tool_env(root: &OSPath, systemd_bin: OSPath?) -> ShellEnv {
    bin_dirs := [root.join("bin").display().to_string()]
    if bin :: systemd_bin { bin_dirs.push(bin.display().to_string()) }
    ShellEnv {
        bin_dirs, vars: [:], unset_vars: [], refs: [], label: "catalog-test",
        prompt_path: PromptPathMode.Short, prompt_strip: PromptStripMode.Off,
        cache_leases: []
    }
}

// Rust: tests/jetpack_services.rs:705
pub fn install_catalog_tools(root: &OSPath) -> {
    fs.create_dir_all(root.join("bin")).expect("create catalog bin")
    tool :: "#!/bin/sh\nset -eu\nname=${{0##*/}}\ncase \"$name\" in\ninitdb)\n    data=\n    while [ \"$#\" -gt 0 ]; do\n        case \"$1\" in\n            --pgdata) shift; data=$1 ;;\n            --pgdata=*) data=${{1#--pgdata=}} ;;\n        esac\n        shift\n    done\n    [ -n \"$data\" ]\n    mkdir -p \"$data\"\n    printf '16\\n' > \"$data/PG_VERSION\"\n    ;;\nredis-server)\n    data=\n    bound=0\n    while [ \"$#\" -gt 0 ]; do\n        case \"$1\" in\n            --bind) shift; [ \"${{1:-}}\" = \"127.0.0.1\" ]; bound=1 ;;\n            --dir) shift; data=$1 ;;\n        esac\n        shift\n    done\n    [ -n \"$data\" ]\n    [ \"$bound\" -eq 1 ]\n    mkdir -p \"$data\"\n    : > \"$data/.service-running\"\n    exec sleep 30\n    ;;\nmysqld)\n    if [ \"${{1:-}}\" = \"--initialize-insecure\" ]; then\n        data=\n        for arg in \"$@\"; do\n            case \"$arg\" in --datadir=*) data=${{arg#--datadir=}} ;; esac\n        done\n        [ -n \"$data\" ]\n        mkdir -p \"$data/mysql\"\n    else\n        data=\n        bound=0\n        for arg in \"$@\"; do\n            case \"$arg\" in --datadir=*) data=${{arg#--datadir=}} ;; esac\n            case \"$arg\" in --bind-address=127.0.0.1) bound=1 ;; esac\n        done\n        [ -n \"$data\" ]\n        [ \"$bound\" -eq 1 ]\n        : > \"$data/.service-running\"\n        exec sleep 30\n    fi\n    ;;\nmariadb-install-db)\n    data=\n    auth=0\n    skip=0\n    for arg in \"$@\"; do\n        case \"$arg\" in --datadir=*) data=${{arg#--datadir=}} ;; esac\n        case \"$arg\" in --auth-root-authentication-method=normal) auth=1 ;; esac\n        case \"$arg\" in --skip-test-db) skip=1 ;; esac\n    done\n    [ -n \"$data\" ]\n    [ \"$auth\" -eq 1 ]\n    [ \"$skip\" -eq 1 ]\n    mkdir -p \"$data/mysql\"\n    ;;\npostgres)\n    data=\n    bound=0\n    while [ \"$#\" -gt 0 ]; do\n        case \"$1\" in -D) shift; data=$1 ;; esac\n        case \"$1\" in -h) shift; [ \"${{1:-}}\" = \"127.0.0.1\" ]; bound=1 ;; esac\n        shift\n    done\n    [ -n \"$data\" ]\n    [ \"$bound\" -eq 1 ]\n    : > \"$data/.service-running\"\n    exec sleep 30\n    ;;\nmariadbd)\n    data=\n    bound=0\n    for arg in \"$@\"; do\n        case \"$arg\" in --datadir=*) data=${{arg#--datadir=}} ;; esac\n        case \"$arg\" in --bind-address=127.0.0.1) bound=1 ;; esac\n    done\n    [ -n \"$data\" ]\n    [ \"$bound\" -eq 1 ]\n    : > \"$data/.service-running\"\n    exec sleep 30\n    ;;\nminio)\n    [ \"${{1:-}}\" = \"server\" ]\n    data=${{2:-}}\n    address=\n    while [ \"$#\" -gt 0 ]; do\n        case \"$1\" in\n            server) ;;\n            --address) shift; address=${{1:-}} ;;\n            *) [ -n \"$data\" ] || data=$1 ;;\n        esac\n        shift\n    done\n    [ \"$address\" = \"127.0.0.1:${{JETPACK_SERVICE_PORT}}\" ]\n    [ -n \"$data\" ]\n    : > \"$data/.service-running\"\n    exec sleep 30\n    ;;\nmailpit)\n    database=\n    listen=\n    smtp=\n    while [ \"$#\" -gt 0 ]; do\n        case \"$1\" in\n            --database) shift; database=$1 ;;\n            --listen) shift; listen=$1 ;;\n            --smtp) shift; smtp=$1 ;;\n        esac\n        shift\n    done\n    [ -n \"$database\" ]\n    [ \"$listen\" = \"127.0.0.1:${{JETPACK_SERVICE_PORT}}\" ]\n    [ \"$smtp\" = \"127.0.0.1:1025\" ]\n    : > \"$(dirname \"$database\")/.service-running\"\n    exec sleep 30\n    ;;\nMailHog)\n    ui=\n    api=\n    smtp=\n    while [ \"$#\" -gt 0 ]; do\n        case \"$1\" in\n            -ui-bind-addr) shift; ui=$1 ;;\n            -api-bind-addr) shift; api=$1 ;;\n            -smtp-bind-addr) shift; smtp=$1 ;;\n        esac\n        shift\n    done\n    [ \"$ui\" = \"127.0.0.1:${{JETPACK_SERVICE_PORT}}\" ]\n    [ \"$api\" = \"127.0.0.1:${{JETPACK_SERVICE_PORT}}\" ]\n    [ \"$smtp\" = \"127.0.0.1:1025\" ]\n    : > .service-running\n    exec sleep 30\n    ;;\nblackfire)\n    [ \"${{1:-}}\" = \"agent:start\" ]\n    : > .service-running\n    exec sleep 30\n    ;;\ntideways-daemon)\n    address=\n    while [ \"$#\" -gt 0 ]; do\n        case \"$1\" in\n            -address) shift; address=$1 ;;\n        esac\n        shift\n    done\n    [ \"$address\" = \"tcp://127.0.0.1:${{JETPACK_SERVICE_PORT}}\" ]\n    : > .service-running\n    exec nc -lk 127.0.0.1 \"${{JETPACK_SERVICE_PORT}}\"\n    ;;\nnginx)\n    prefix=\n    config=\n    while [ \"$#\" -gt 0 ]; do\n        case \"$1\" in\n            -p) shift; prefix=$1 ;;\n            -c) shift; config=$1 ;;\n        esac\n        shift\n    done\n    [ -n \"$prefix\" ]\n    [ -f \"$config\" ]\n    grep -F 'listen 127.0.0.1:' \"$config\" >/dev/null\n    : > \"$prefix/.service-running\"\n    exec sleep 30\n    ;;\npg_isready)\n    [ -f .jet/services/postgres/data/.service-running ]\n    ;;\nredis-cli)\n    [ -f .jet/services/redis/data/.service-running ]\n    ;;\nmysqladmin)\n    [ \"${{1:-}}\" = ping ]\n    user=\n    while [ \"$#\" -gt 0 ]; do\n        case \"$1\" in\n            -u) shift; user=${{1:-}} ;;\n            --user=*) user=${{1#--user=}} ;;\n        esac\n        shift\n    done\n    [ \"$user\" = root ]\n    [ -f .jet/services/mysql/data/.service-running ]\n    ;;\nmariadb-admin)\n    [ \"${{1:-}}\" = ping ]\n    user=\n    while [ \"$#\" -gt 0 ]; do\n        case \"$1\" in\n            -u) shift; user=${{1:-}} ;;\n            --user=*) user=${{1#--user=}} ;;\n        esac\n        shift\n    done\n    [ \"$user\" = root ]\n    [ -f .jet/services/mariadb/data/.service-running ]\n    ;;\ncurl)\n    url=\n    for arg in \"$@\"; do url=$arg; done\n    case \"$url\" in\n        */minio/health/live)\n            port=$(cat .jet/services/minio/ports)\n            [ \"$url\" = \"http://127.0.0.1:${{port}}/minio/health/live\" ]\n            [ -f .jet/services/minio/data/.service-running ]\n            ;;\n        */api/v1/info)\n            port=$(cat .jet/services/mailpit/ports)\n            [ \"$url\" = \"http://127.0.0.1:${{port}}/api/v1/info\" ]\n            [ -f .jet/services/mailpit/data/.service-running ]\n            ;;\n        */api/v2/messages)\n            port=$(cat .jet/services/mailhog/ports)\n            [ \"$url\" = \"http://127.0.0.1:${{port}}/api/v2/messages\" ]\n            [ -f .jet/services/mailhog/data/.service-running ]\n            ;;\n        *)\n            healthy=1\n            matched=0\n            for service in nginx; do\n                port=$(cat \".jet/services/$service/ports\" 2>/dev/null || true)\n                [ -n \"$port\" ] || continue\n                case \"$url\" in *\":$port/\"*)\n                    matched=1\n                    if [ \"$service\" = nginx ]; then\n                        nginx_marker=\n                        for marker in .jet/services/nginx/data/nginx-*/.service-running; do\n                            [ -f \"$marker\" ] || continue\n                            nginx_marker=1\n                            break\n                        done\n                        [ -n \"$nginx_marker\" ] || healthy=0\n                    fi\n                esac\n            done\n            [ \"$matched\" -eq 1 ]\n            [ \"$healthy\" -eq 1 ]\n            ;;\n    esac\n    ;;\n*)\n    exit 1\n    ;;\nesac\n"
    for name in ["initdb", "redis-server", "mysqld", "mariadb-install-db", "postgres", "mariadbd", "minio", "mailpit", "MailHog", "blackfire", "tideways-daemon", "nginx", "pg_isready", "redis-cli", "mysqladmin", "mariadb-admin", "curl"] {
        write_executable(&root.join("bin").join(name), &tool)
    }
}
