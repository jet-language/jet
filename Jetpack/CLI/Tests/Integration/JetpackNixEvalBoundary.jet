use core.sys
// GATE #4494: actual filesystem, process and native permission operations.
use std.[fs, Command, Output]
use common.[jetpack_bin, Scratch]
use Jetpack.CLI.Tests.Integration.Support.JetpackFixtures
use nix_index_cache_server
use Jetpack.Store

// Rust: tests/jetpack_nix_index.rs:24
REVISION :: nix_index_cache_server.REVISION

// Rust: tests/jetpack_nix_index.rs:26
fn project(scratch: &Scratch) -> {
    fs.create_dir_all(scratch.join(".jet")) ?? panic("project managed directory")
    fs.write(scratch.join(".jet/lock"), "version = 1\n\n[[source_channel]]\nname = \"jetpack\"\nchannel = \"nixpkgs-unstable\"\nexact = \"github:NixOS/nixpkgs#{REVISION}\"\n\n[root]\ndependencies = []\n") ?? panic("project lock")
    fs.write(scratch.join("env.jet"), "module env.dev {\n    sources: { jetpack: NixOS/nixpkgs/nixpkgs-unstable@github }\n    packages: [jetpack.ripgrep]\n}\n") ?? panic("project environment")
}

// Rust: tests/jetpack_nix_index.rs:41
fn isolated_jetpack(project: &Scratch, root: &Scratch) -> Command {
    temporary :: root.join("tmp")
    fs.create_dir_all(&temporary) ?? panic("private command temporary directory")
    command := JetpackFixtures.jetpack()
    command.env_clear().current_dir(&project.path).env("PATH", "")
        .env("HOME", root.join("home")).env("XDG_DATA_HOME", root.join("home/data"))
        .env("XDG_STATE_HOME", root.join("home/state")).env("XDG_CACHE_HOME", root.join("home/cache"))
        .env("XDG_CONFIG_HOME", root.join("home/config")).env("XDG_RUNTIME_DIR", root.join("run"))
        .env("TMPDIR", &temporary).env("TMP", &temporary).env("TEMP", &temporary)
        .env("JETPACK_ROOT", &root.path).env("JETPACK_SHARED_CAS", root.join("hangar/cas"))
        .env("JETPACK_NIX_FALLBACK_POLICY", "deny")
    command
}

// Rust: tests/jetpack_nix_index.rs:64
fn prepare(project: &Scratch, root: &Scratch, offline: Bool) -> Output {
    command := isolated_jetpack(project, root)
    command.args(["env", "--env", "dev", "--prep", "--trust", "--yes", "--no-color"])
    if offline -> command.arg("--offline")
    command.output() ?? panic("prepare index-backed Nix environment")
}

// Rust: tests/jetpack_nix_index.rs:73
fn package_entry(root: &Scratch) -> Store.StoreEntry {
    (Store.list_checked(&Store.Roots.at(root.path.clone())) ?? panic("list Hangar"))
        .into_iter().find(entry -> entry.reference == "ripgrep@jetpack" && entry.version == "15.2.0") ?? panic("realized ripgrep package entry")
}

// Rust: tests/jetpack_nix_index.rs:81
fn make_directories_writable(path: &OSPath) -> {
    metadata :: fs.symlink_metadata(path) ?? panic("inspect Hangar object")
    if !metadata.is_dir() -> return
    permissions := metadata.permissions()
    // GATE #4483: preserve Unix and non-Unix permission behavior.
    if sys.target.selected_family() == "unix" {
        permissions.set_mode(permissions.mode() | 0o200)
    } else {
        permissions.set_readonly(false)
    }
    fs.set_permissions(path, permissions) ?? panic("make Hangar directory writable")
    for child in fs.read_dir(path) ?? panic("read Hangar object") {
        make_directories_writable(&(child ?? panic("Hangar object child")).path())
    }
}

// Rust: tests/jetpack_no_daemon.rs:11
fn jetpack() -> Command { Command.new(jetpack_bin()) }

// Rust: tests/jetpack_no_daemon.rs:202
// The source-policy walk now scans staged Jet source and excludes paired test homes.
fn source_files(root: &OSPath) -> [OSPath] {
    out := [OSPath]{}
    rd :: fs.read_dir(root)
    if rd.is_ok() {
        for ent in rd.unwrap().flatten() {
            path :: ent.path()
            if path.is_dir() {
                if path.file_name().and_then(name -> name.to_str()) != Val("Tests") {
                    out.extend(source_files(&path))
                }
            } else if path.extension().and_then(extension -> extension.to_str()) == Val("jet") {
                out.push(path)
            }
        }
    }
    out
}
