fn fixture_root() -> OSPath {
    OSPath.from(env.compile_time("CARGO_MANIFEST_DIR")).join("tests/fixtures/jetpack-typed")
}
// Rust: tests/jetpack_discovery.rs:26
fn copy_project(dst: &OSPath) -> { copy_dir(&fixture_root(), dst) }
// Rust: tests/jetpack_discovery.rs:30
fn copy_dir(src: &OSPath, dst: &OSPath) -> {
    fs.create_dir_all(dst) ?? panic("create fixture directory")
    for result in fs.read_dir(src) ?? panic("read fixture directory") {
        entry :: result ?? panic("read fixture entry")
        from :: entry.path()
        to :: dst.join(entry.file_name())
        if from.is_dir() { copy_dir(&from, &to) }
        else { _ :: fs.copy(from, to) ?? panic("copy fixture") }
    }
}
