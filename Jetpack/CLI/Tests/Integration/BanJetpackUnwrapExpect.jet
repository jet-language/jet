// Rust: tests/ban_jetpack_unwrap_expect.rs:499
#Test("scanner_treats_unknown_cfg_conservatively") {
    source :: "#[cfg(any(test, unix))]\nfn maybe_production() { value.unwrap(); }\n#[cfg(all(test, unix))]\nfn definitely_test() { value.expect(\"test\"); }\n#[cfg(test = \"custom\")]\nfn key_value_is_not_builtin_test_cfg() { value.expect(\"production\"); }\n#[cfg(any(test = \"custom\", test))]\nfn nested_key_value_is_not_builtin_test_cfg() { value.unwrap(); }\n"
    findings :: scan_source("fixture.rs", source)
    assert_eq(findings.len(), 3)
    assert_eq(findings[0].item, "fn maybe_production")
    assert_eq(findings[1].item, "fn key_value_is_not_builtin_test_cfg")
    assert_eq(findings[2].item, "fn nested_key_value_is_not_builtin_test_cfg")
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:525
#Test("file_walk_does_not_follow_outside_or_cyclic_symlinks") {
    if core.sys.target.selected_family() != "unix" -> return // GATE #4483
    nonce :: (time.SystemTime.now().duration_since(time.UNIX_EPOCH) ?? panic("clock after epoch")).as_nanos()
    base :: env.temp_dir().join("jetpack-unwrap-ratchet-{process.id()}-{nonce}")
    scan_root :: base.join("scan")
    outside :: base.join("outside")
    fs.create_dir_all(scan_root) ?? panic("create scan")
    fs.create_dir_all(outside) ?? panic("create outside")
    fs.write(scan_root.join("safe.rs"), "fn safe() {}\n") ?? panic("write safe")
    fs.write(outside.join("escape.rs"), "fn escaped() { value.unwrap(); }\n") ?? panic("write outside")
    fs.symlink(outside, scan_root.join("outside-link")) ?? panic("outside symlink")
    fs.symlink(scan_root, scan_root.join("cycle")) ?? panic("cyclic symlink")
    files := []
    collect_rs_files(scan_root, &files)
    files.sort()
    assert_eq(files, [scan_root.join("safe.rs")])
    assert(outside.join("escape.rs").is_file())
    fs.remove_dir_all(base) ?? panic("remove fixture")
}
