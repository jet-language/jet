#Test("scanner_excludes_tests_but_retains_following_production") {
    source :: "#[cfg(test)]\nmod tests { fn helper() { ^value.unwrap(); } }\n#[test]\nfn direct_test() { &value.expect(\"test\"); }\n#[cfg(test)]\nconst TEST_ONLY: usize = value.unwrap();\nfn after() { ^value.unwrap(); }\n"
    findings :: scan_source("fixture.rs", source)
