#Derive(Clone, Debug, PartialEq, Eq)
enum TokenKind { Ident(String), Punct(Char) }
// Rust: tests/ban_jetpack_unwrap_expect.rs:18
struct Token { kind: TokenKind, line: USize }
// Rust: tests/ban_jetpack_unwrap_expect.rs:24
#Derive(Clone, Debug, PartialEq, Eq)
struct Finding { path: String, line: USize, method: String, item: String }
// Rust: tests/ban_jetpack_unwrap_expect.rs:32
#Derive(Copy, Debug, PartialEq, Eq)
enum Truth { Yes, No, Maybe }
// Rust: tests/ban_jetpack_unwrap_expect.rs:39
fn lex(source: String) -> [Token] {
    bytes :: source.bytes()
    out := []
    i := 0
    line := 1
    while i < bytes.len() {
        if bytes[i] == b'\n' { line += 1; i += 1; continue }
        if bytes[i].is_ascii_whitespace() { i += 1; continue }
        if bytes[i..].starts_with(b"//") {
            i += 2
            while i < bytes.len() && bytes[i] != b'\n' { i += 1 }
            continue
        }
        if bytes[i..].starts_with(b"/*") {
            i += 2
            depth := 1
            while i < bytes.len() && depth > 0 {
                if bytes[i..].starts_with(b"/*") { depth += 1; i += 2 }
                else if bytes[i..].starts_with(b"*/") { depth -= 1; i += 2 }
                else { if bytes[i] == b'\n' { line += 1 }; i += 1 }
            }
            continue
        }
        if Some((end, newlines)) :: raw_string_end(bytes, i) { line += newlines; i = end; continue }
        normal_prefix :: if bytes[i..].starts_with(b"b\"") || bytes[i..].starts_with(b"c\"") -> Some(2)
            else if bytes[i] == b'"' -> Some(1) else -> None
        if Some(prefix) :: normal_prefix {
            i += prefix
            while i < bytes.len() {
                if bytes[i] == b'\\' { i = (i + 2).min(bytes.len()) }
                else if bytes[i] == b'"' { i += 1; break }
                else { if bytes[i] == b'\n' { line += 1 }; i += 1 }
            }
            continue
        }
        if bytes[i] == b'\'' {
            if Some(end) :: char_literal_end(bytes, i) {
                line += bytes[i..end].iter().filter(|byte| -> byte == b'\n').count()
                i = end
                continue
            }
        }
        if is_ident_start(bytes[i]) {
            start :: i
            i += 1
            while i < bytes.len() && is_ident_continue(bytes[i]) { i += 1 }
            out.push(Token{kind: TokenKind.Ident(source[start..i].to_string()), line: line})
            continue
        }
        out.push(Token{kind: TokenKind.Punct(bytes[i] as Char), line: line})
        i += 1
    }
    out
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:137
fn raw_string_end(bytes: [U8], start: USize) -> (USize, USize)? {
    i := start
    if bytes.get(i) == Some(b'b') || bytes.get(i) == Some(b'c') { i += 1 }
    if bytes.get(i) != Some(b'r') -> return None
    i += 1
    hashes_start :: i
    while bytes.get(i) == Some(b'#') { i += 1 }
    if bytes.get(i) != Some(b'"') -> return None
    hashes :: i - hashes_start
    i += 1
    newlines := 0
    while i < bytes.len() {
        if bytes[i] == b'\n' { newlines += 1 }
        // Compare the hash suffix without allocating a repeated vector per byte.
        if bytes[i] == b'"' && i + 1 + hashes <= bytes.len() && bytes[i + 1..i + 1 + hashes].iter().all(|b| -> b == b'#') {
            return Some((i + 1 + hashes, newlines))
        }
        i += 1
    }
    Some((bytes.len(), newlines))
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:168
fn char_literal_end(bytes: [U8], start: USize) -> USize? {
    i := start + 1
    while i < bytes.len() && bytes[i] != b'\n' {
        if bytes[i] == b'\\' { i += 2 }
        else if bytes[i] == b'\'' -> return Some(i + 1)
        else { i += 1 }
    }
    None
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:182
fn is_ident_start(byte: U8) -> Bool { byte == b'_' || byte.is_ascii_alphabetic() || byte >= 0x80 }
// Rust: tests/ban_jetpack_unwrap_expect.rs:186
fn is_ident_continue(byte: U8) -> Bool { is_ident_start(byte) || byte.is_ascii_digit() }
// Rust: tests/ban_jetpack_unwrap_expect.rs:190
fn punct(token: Token, expected: Char) -> Bool { token.kind == TokenKind.Punct(expected) }
// Rust: tests/ban_jetpack_unwrap_expect.rs:194
fn ident(token: Token, expected: String) -> Bool { match token.kind { TokenKind.Ident(actual) -> actual == expected, _ -> false } }
// Rust: tests/ban_jetpack_unwrap_expect.rs:198
fn matching(tokens: [Token], start: USize, open: Char, close: Char) -> USize? {
    depth := 0
    for (offset, token) in tokens[start..].iter().enumerate() {
        if punct(token, open) { depth += 1 }
        else if punct(token, close) { depth -= 1; if depth == 0 -> return Some(start + offset) }
    }
    None
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:213
fn cfg_truth(tokens: [Token]) -> Truth {
    cursor := 0
    truth :: parse_cfg_expr(tokens, &cursor)
    if cursor == tokens.len() -> truth else -> Truth.Maybe
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:223
fn parse_cfg_expr(tokens: [Token], cursor: &USize) -> Truth {
    token :: tokens.get(cursor) ?? return Truth.Maybe
    name :: match token.kind { TokenKind.Ident(name) -> name, _ -> return Truth.Maybe }
    cursor += 1
    if name == "test" {
        return if cursor == tokens.len() || tokens.get(cursor).is_some_and(|token| -> punct(token, ',') || punct(token, ')')) -> Truth.No else -> Truth.Maybe
    }
    if !["all", "any", "not"].contains(name) || !tokens.get(cursor).is_some_and(|t| -> punct(t, '(')) -> return Truth.Maybe
    cursor += 1
    values := []
    while cursor < tokens.len() && !punct(tokens[cursor], ')') {
        values.push(parse_cfg_expr(tokens, &cursor))
        while cursor < tokens.len() && !punct(tokens[cursor], ',') && !punct(tokens[cursor], ')') { cursor += 1 }
        if tokens.get(cursor).is_some_and(|t| -> punct(t, ',')) { cursor += 1 }
    }
    if tokens.get(cursor).is_some_and(|t| -> punct(t, ')')) { cursor += 1 }
    match name {
        "all" if values.iter().any(|v| -> v == Truth.No) -> Truth.No,
        "all" if values.iter().all(|v| -> v == Truth.Yes) -> Truth.Yes,
        "any" if values.iter().any(|v| -> v == Truth.Yes) -> Truth.Yes,
        "any" if values.iter().all(|v| -> v == Truth.No) -> Truth.No,
        "not" if values == [Truth.Yes] -> Truth.No,
        "not" if values == [Truth.No] -> Truth.Yes,
        _ -> Truth.Maybe
    }
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:276
fn attribute_is_test_only(tokens: [Token]) -> Bool {
    if tokens.first().is_some_and(|token| -> ident(token, "test")) -> return true
    if !tokens.first().is_some_and(|token| -> ident(token, "cfg")) || !tokens.get(1).is_some_and(|token| -> punct(token, '(')) -> return false
    end :: matching(tokens, 1, '(', ')') ?? return false
    cfg_truth(tokens[2..end]) == Truth.No
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:291
fn scan_source(path: String, source: String) -> [Finding] {
    tokens :: lex(source)
    findings := []
    scan_scope(tokens, 0, tokens.len(), false, "<module>", path, &findings)
    findings
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:306
fn scan_scope(tokens: [Token], start: USize, end: USize, test_only: Bool, current_item: String, path: String, findings: &[Finding]) -> {
    i := start
    pending_test := false
    pending_item: String? := None
    while i < end {
        if punct(tokens[i], '#') && tokens.get(i + 1).is_some_and(|token| -> punct(token, '[')) {
            if Some(close) :: matching(tokens, i + 1, '[', ']') {
                pending_test |= attribute_is_test_only(tokens[i + 2..close])
                i = close + 1
                continue
            }
        }
        if TokenKind.Ident(keyword) :: tokens[i].kind {
            if ["fn", "mod", "const", "static", "struct", "enum", "trait"].contains(keyword) {
                if Some(next) :: tokens.get(i + 1) {
                    if TokenKind.Ident(name) :: next.kind { pending_item = Some("{keyword} {name}") }
                }
            } else if keyword == "impl" { pending_item = Some("impl") }
        }
        if !test_only && !pending_test && i + 2 < end && punct(tokens[i], '.') &&
            (ident(tokens[i + 1], "unwrap") || ident(tokens[i + 1], "expect")) && punct(tokens[i + 2], '(') {
            method :: match tokens[i + 1].kind { TokenKind.Ident(method) -> method, _ -> panic("unreachable method") }
            findings.push(Finding{path: path.to_string(), line: tokens[i + 1].line, method: method.to_string(), item: current_item.to_string()})
        }
        if punct(tokens[i], '{') {
            close :: matching(tokens, i, '{', '}') ?? return
            item :: pending_item.as_deref().unwrap_or(current_item)
            scan_scope(tokens, i + 1, close, test_only || pending_test, item, path, &findings)
            pending_test = false
            pending_item = None
            i = close + 1
            continue
        }
        if punct(tokens[i], ';') { pending_test = false; pending_item = None }
        i += 1
    }
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:386
fn collect_rs_files(dir: OSPath, files: &[OSPath]) -> {
    entries :: fs.read_dir(dir) ?? return
    for entry in entries.flatten() {
        path :: entry.path()
        metadata :: fs.symlink_metadata(path) ?? continue
        if metadata.file_type().is_symlink() -> continue
        if metadata.is_dir() { collect_rs_files(path, &files) }
        else if path.extension().is_some_and(|extension| -> extension == "rs") { files.push(^path) }
    }
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:406
fn production_findings() -> [Finding] {
    root :: OSPath.from(env.manifest_dir())
    files := []
    collect_rs_files(root.join("crates/jetpack/src"), &files)
    files.sort()
    findings := []
    for file in files {
        relative :: (file.strip_prefix(root) ?? panic("scanned file stays beneath repository root")).to_string_lossy().replace('\\', "/")
        source :: fs.read_to_string(file) ?? panic("Jetpack source is readable")
        findings.extend(scan_source(relative, source))
    }
    findings
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:424
fn enforce_zero(findings: [Finding]) -> Err! {
    if findings.is_empty() -> return
    throw findings.iter().map(|finding| -> "{finding.path}:{finding.line}: .{finding.method}( in {finding.item}").collect().join("\n")
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:441
#Test("jetpack_production_has_no_unwrap_or_expect") {
    findings :: production_findings()
    result :: enforce_zero(findings)
    assert(result.is_ok(), "production Jetpack unwrap/expect ceiling is zero:\n{result.unwrap_err()}")
}
// Rust: tests/ban_jetpack_unwrap_expect.rs:451
#Test("scanner_detects_production_and_seeded_gate_failure") {
    findings :: scan_source("fixture.rs", "fn live() { value.unwrap(); other.expect(\"x\"); }")
    assert_eq(findings.len(), 2)
    assert_eq(findings[0].item, "fn live")
    assert(enforce_zero(findings).is_err())
}
