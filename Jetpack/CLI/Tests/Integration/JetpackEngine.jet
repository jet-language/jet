// Rust: tests/jetpack_engine.rs:1
// Offline package engine journeys use the real CLI and native provider fixtures.
use Jetpack.CLI.Tests.Integration.Support.JetpackFixtures.*
use Jetpack.[SHA256, Envelope]
use Jetpack.Store
use core.sys
// GATE #4494: native filesystem permissions, rename, symlinks and real subprocesses.
use std.fs

// Rust: tests/jetpack_engine.rs:21
fn make_writable(path: &String) -> {
    // Rust: tests/jetpack_engine.rs:22
    fn walk(path: &OSPath) -> {
        metadata :: fs.symlink_metadata(path) ?? panic("lstat")
        if metadata.is_dir() {
            loop entry in fs.read_dir(path) ?? panic("read directory") {
                walk(&(entry ?? panic("directory entry")).path())
            }
        }
        permissions := metadata.permissions()
        if sys.target.selected_family() == "unix" {
            &permissions.set_mode(permissions.mode() | 0o200)
        }
        fs.set_permissions(path, permissions) ?? panic("set permissions")
    }
    walk(&OSPath.from(path))
}

// Rust: tests/jetpack_engine.rs:40
fn make_directories_writable(path: &OSPath) -> {
    metadata :: fs.symlink_metadata(path) ?? panic("lstat")
    if !metadata.is_dir() -> return
    permissions := metadata.permissions()
    if sys.target.selected_family() == "unix" {
        &permissions.set_mode(permissions.mode() | 0o200)
    } else {
        &permissions.set_readonly(false)
    }
    fs.set_permissions(path, permissions) ?? panic("set directory permissions")
    loop entry in fs.read_dir(path) ?? panic("read directory") {
        make_directories_writable(&(entry ?? panic("directory entry")).path())
    }
}

// Rust: tests/jetpack_engine.rs:59
fn write_native_lease_fixture(fixtures: &OSPath) -> {
    fs.create_dir_all(fixtures) ?? panic("create fixture directory")
    artifact :: fixtures.join("omp-1.0.0")
    fs.write(artifact, "#!/bin/sh\necho hello from jetpack\n") ?? panic("write native artifact")
    digest :: SHA256.sha256_file_hex(&artifact) ?? panic("digest artifact")
    fs.write(fixtures.join("jetpackage-omp.json"), "{{\"tag\":\"v1.0.0\",\"version\":\"1.0.0\",\"sha256\":\"{digest}\",\"artifact\":\"omp-1.0.0\"}}") ?? panic("write native fixture")
}

// Rust: tests/jetpack_engine.rs:1549
fn seed_profile_fixture(root: &OSPath, fixtures: &OSPath, package: &String, setup: fn(&OSPath)) -> {
    fs.create_dir_all(fixtures) ?? panic("create fixture directory")
    staging :: Scratch.new("profile-generation-{package}-staging")
    setup(&staging.path)
    Store.seal_local_output(&staging.path) ?? panic("seal staging")
    digest :: Envelope.try_output_hash_of(staging.path.to_string_lossy()) ?? panic("output digest")
    out_dir :: root.join("hangar/objects").join(digest)
    fs.create_dir_all(out_dir.parent() ?? panic("object parent")) ?? panic("create object parent")
    permissions := (fs.metadata(staging.path) ?? panic("staging metadata")).permissions()
    if sys.target.selected_family() == "unix" {
        &permissions.set_mode(permissions.mode() | 0o200)
    } else {
        &permissions.set_readonly(false)
    }
    fs.set_permissions(staging.path, permissions) ?? panic("unseal staging directory")
    fs.rename(staging.path, out_dir) ?? panic("install object")
    Store.seal_local_output(&out_dir) ?? panic("seal object")
    fs.write(fixtures.join("nixpkgs-{package}.json"), "[{{\"drvPath\":\"/nix/store/0fixture00000000000000000000-{package}.drv\",\"outputs\":{{\"out\":{out_dir.to_string_lossy():?}}}}}]") ?? panic("write profile fixture")
}
