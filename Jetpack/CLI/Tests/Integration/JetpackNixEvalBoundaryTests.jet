// Rust: tests/jetpack_nix_eval_boundary.rs:7
#Test("evaluator_seam_is_no_std_dependency_free_and_unsafe_forbidden") {
    // Rust-reference architectural stop-line: the independent seam and its escape
    // controls remain checked against their real manifests and committed fixtures.
    root :: OSPath.from(env("CARGO_MANIFEST_DIR"))
    manifest :: fs.read_to_string(root.join("crates/jet-nix-eval/Cargo.toml")) ?? panic("native evaluator seam manifest")
    dependency_section :: manifest.split_once("[dependencies]") ?? panic("evaluator seam must declare an explicit dependency section")
    dependencies := dependency_section.1.trim() // #4303
    assert(dependencies.is_empty(), "native evaluator seam must remain dependency-free, got:\n{dependencies}")
    assert(manifest.lines().any(line -> line.trim() == "build = false"))
    assert(!root.join("crates/jet-nix-eval/build.rs").exists())
    seam :: fs.read_to_string(root.join("crates/jet-nix-eval/src/lib.rs")) ?? panic("native evaluator seam root")
    assert(seam.contains("#![no_std]"))
    assert(seam.contains("#![forbid(unsafe_code)]"))
    assert(seam.contains("#![deny(clippy::disallowed_types)]"))
    clippy :: fs.read_to_string(root.join("clippy.toml")) ?? panic("workspace Clippy policy")
    assert(clippy.contains("std::process::Command"))
    verify :: fs.read_to_string(root.join("Tools/agent/verify-full.sh")) ?? panic("full verification entry point")
    assert(verify.contains("verify-nix-eval-stopline.sh"))
    escape :: fs.read_to_string(root.join("tests/fixtures/nix-compat/authority-escape/lib.rs")) ?? panic("native evaluator authority escape fixture")
    assert(escape.contains("extern crate std as host;"))
    assert(escape.contains("host::process::Command::new"))
    assert(escape.contains("host::net::TcpStream as Wire"))
    assert(escape.contains("host::net::ToSocketAddrs as Resolve"))
    assert(escape.contains("host::os::unix::net::UnixStream as Wire"))
    build_escape :: fs.read_to_string(root.join("tests/fixtures/nix-compat/build-script-escape/build.rs")) ?? panic("native evaluator build-script escape fixture")
    assert(build_escape.contains("std::process::Command::new"))
    jetpack_manifest :: fs.read_to_string(root.join("crates/jetpack/Cargo.toml")) ?? panic("jetpack manifest")
    assert(jetpack_manifest.contains("jet-nix-eval = { path = \"../jet-nix-eval\" }"))
    jetpack_root :: fs.read_to_string(root.join("crates/jetpack/src/lib.rs")) ?? panic("jetpack library root")
    assert(jetpack_root.contains("pub(crate) mod NixEval;"))
    assert(!jetpack_root.contains("pub mod NixEval;"))
}

// Rust: tests/jetpack_nix_eval_boundary.rs:56
#Test("oracle_pin_is_independent_from_mutable_root_flake_lock") {
    root :: OSPath.from(env("CARGO_MANIFEST_DIR"))
    oracle :: fs.read_to_string(root.join("tests/fixtures/nix-compat/oracle.json")) ?? panic("committed oracle manifest")
    assert(oracle.contains("\"version\": \"2.34.8\""))
    assert(oracle.contains("b6769c588f60b3e762f73d3a8cf60294df078ccd"))
    assert(oracle.contains("f3f1c3c5b8ad91850e0f7c590cf177f7ab022024"))
    assert(oracle.contains("b5aa0fbd538984f6e3d201be0005b4463d8b09f8"))
    assert(oracle.contains("\"last_modified\": 1782723713"))
    assert(oracle.contains("sha256-oPXCU/SSUokcGaJREHibG1CBX3+s/W7orDWQOZDsEeQ="))
    assert_eq(oracle.matches("\"build_nar_hash\": \"").count(), 4)
    assert_eq(oracle.matches("\"executable_nar_hash\": \"").count(), 4)
    assert_eq(oracle.matches("\"status\": \"ready\"").count(), 4)
    assert(oracle.contains("\"corpus_status\": \"bit_exact\""))
    breadth :: fs.read_to_string(root.join("tests/fixtures/nix-compat/breadth.json")) ?? panic("pinned breadth fixture")
    assert(breadth.contains("\"fuzz_seeds\""))
    assert(breadth.contains("\"locks\""))
    assert(breadth.contains("\"output_identities\""))
    assert(breadth.contains("\"memory_bytes\": 16777216"))
    assert(breadth.contains("\"latency_micros\": 1000000"))
    stopline :: fs.read_to_string(root.join("Tools/agent/verify-nix-eval-stopline.sh")) ?? panic("native evaluator stop-line")
    assert(stopline.contains("breadth.json"))
}

// Rust: tests/jetpack_nix_index.rs:101
#Test("index_backed_nixpkgs_records_complete_closure_and_both_proofs") {
    project_root :: Scratch.new("nix-index-project")
    hangar_root :: Scratch.new("nix-index-hangar")
    server :: NixIndexCacheServer.start_ripgrep(&project_root.path)
    server.install(&hangar_root.path)
    project(&project_root)
    output :: prepare(&project_root, &hangar_root, false)
    assert(output.status.success(), "stdout: {String.from_utf8_lossy(&output.stdout)}\nstderr: {String.from_utf8_lossy(&output.stderr)}")
    entry :: package_entry(&hangar_root)
    assert(!entry.references.is_empty(), "Realized.references is empty")
    roots :: Store.Roots.at(hangar_root.path.clone())
    graph :: Store.closure_graph(&roots) ?? panic("read Hangar closure graph")
    closure :: graph.closure(&entry.envelope.output_hash)
    assert_eq(closure.len(), 3, "closure graph: {graph:?}")
    assert(entry.references.iter().all(digest -> graph.objects.contains_key(digest)))
    assert(graph.transitive_references(&entry.envelope.output_hash).len() >= 2)
    producer :: ProducerRecord.decode(&entry.producer_record) ?? panic("decode Nix producer")
    for fact in ["nix.index.proof.v1", "nix.index.record.sha256", "nix.index.target.sha256", "nix.index.manifest.sha256", "nix.cache.output.out.proof.sha256", "nix.cache.closure.receipt.sha256"] {
        assert(producer.facts.get(fact).is_some_and(value -> !value.is_empty()), "missing provenance fact {fact}: {producer.facts:?}")
    }
    assert_eq(producer.facts.get("nix.native.format").map(value -> value.as_str()), Val("jet-nixpkgs-index-v1"))
    assert(producer.facts.get("nix.index.proof.v1").is_some_and(proof -> proof.contains("fixture-index-signer-v1")))
}

// Rust: tests/jetpack_nix_index.rs:164
#Test("static_publication_resolves_signed_index_and_nix_objects") {
    project_root :: Scratch.new("static-nix-index-project")
