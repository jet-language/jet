use Jetpack.CLI.Tests.Integration.Pkg.*
use Compiler.Publish
use std.Command
// GATE #4494: native subprocesses, environment mutation and mutex poisoning fidelity.

// Rust: tests/pkg.rs:8442
fn have_cargo() -> Bool { Command.new("cargo").arg("--version").output().is_ok() }

// Rust: tests/pkg.rs:8448
fn with_keys<T>(dir: &OSPath, f: fn() -> T) -> T {
    guard :: STORE_LOCK.lock().unwrap_or_else((e) -> e.into_inner())
    prev :: std.env.var("JET_KEYS_DIR").ok()
    std.env.set_var("JET_KEYS_DIR", dir)
    result :: f()
    match prev {
        Val(v) -> std.env.set_var("JET_KEYS_DIR", v)
        None -> std.env.remove_var("JET_KEYS_DIR")
    }
    result
}

// Rust: tests/pkg.rs:8460
fn signed_entry(name: &String, version: &String, content_hash: &String, public_key: &String, signature: &String) -> Publish.IndexEntry {
    Publish.IndexEntry {
        name: name.to_string(), version: version.to_string(), content_hash: content_hash.to_string(),
        fingerprint: "sha256-fp", yanked: false, tier: Publish.RegistryTier.Core,
        gate_status: Publish.GateStatus.core_reviewed(), public_key: public_key.to_string(), signature: signature.to_string()
    }
}
