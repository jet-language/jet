// U13: encrypted repository secrets lifecycle; real native crypto and disk scans.
use std.[fs, env, process]
use std.process.Command
use std.time.[SystemTime, UNIX_EPOCH]
use std.collections.BTreeSet
use core.files.OSPath
use common.[jetpack_bin, Scratch]
// GATE #4494: filesystem, clock, native commands and crypto substrate.

// Rust: tests/secrets.rs:18
pub fn jetpack() -> Command { Command.new(jetpack_bin()) }

// Rust: tests/secrets.rs:22
pub fn strip_ansi(s: &String) -> String {
    out := String.with_capacity(s.len())
    chars := s.chars().peekable()
    while chars.next() is Some(c) {
        if c == '\u{1b}' {
            if chars.peek() == Some(&'[') {
                _ :: chars.next()
                for c2 in chars.by_ref() { if c2.is_ascii_alphabetic() { break } }
            }
            continue
        }
        out.push(c)
    }
    out
}

// Rust: tests/secrets.rs:43
pub fn setup_vault(proj: &Scratch, keys: &Scratch) -> {
    keygen_out :: jetpack().current_dir(&proj.path).args(["secrets", "keygen"])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("run jetpack secrets keygen")
    assert(keygen_out.status.success(), "keygen failed without exposing secret data")
    keygen_text :: strip_ansi(&String.from_utf8_lossy(&keygen_out.stderr))
    recipient :: keygen_text.lines().find_map((line) -> line.split_once("recipient: ")
        .map((pair) -> pair.1.trim().to_string())).expect("keygen must print a recipient line")
    assert(recipient.starts_with("age1"), "recipient should be age-formatted")
    add_out :: jetpack().current_dir(&proj.path).args(["secrets", "recipients", "add", &recipient])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("run jetpack secrets recipients add")
    assert(add_out.status.success(), "recipient registration failed")
}

// Rust: tests/secrets.rs:430
pub fn walk(dir: &OSPath) -> [OSPath] {
    out: [OSPath] := []
    entries :: match fs.read_dir(dir) { Ok(value) -> value; Err(_) -> { return out } }
    for e in entries.flatten() {
        p :: e.path()
        if p.is_dir() { out.extend(walk(&p)) } else { out.push(p) }
    }
    out
}

// Rust: tests/workspace.rs:103
pub fn unique_temp_dir(tag: &String) -> OSPath {
    stamp :: SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()
    dir :: env.temp_dir().join("jet-{tag}-{process.id()}-{stamp}")
    fs.create_dir_all(&dir).unwrap()
    dir
}

// Rust: tests/workspace_crates.rs:8
pub fn manifest_deps(manifest: &String) -> BTreeSet[String] {
    deps := BTreeSet[String].new()
    in_deps := false
    for raw in manifest.lines() {
        line := raw.trim() // #4303
        if line.starts_with('[') { in_deps = line == "[dependencies]"; continue }
        if !in_deps || line.is_empty() || line.starts_with('#') { continue }
        pair :: match line.split_once('=') { Some(value) -> value; None -> { continue } }
        name := pair.0.trim() // #4303
        if name.starts_with("jet-") || name == "jetpack" { _ :: deps.insert(name.to_string()) }
    }
    deps
}

// Rust: tests/workspace_crates.rs:31
pub fn assert_deps(path: &String, allowed: &[String]) -> {
    root :: OSPath.from(env!("CARGO_MANIFEST_DIR"))
    manifest :: fs.read_to_string(root.join(path)).unwrap()
    actual :: manifest_deps(&manifest)
    allowed_set :: allowed.iter().map((dep) -> dep.to_string()).collect[BTreeSet[String]]()
    assert_eq(actual, allowed_set, "{path} Jet path-dependency drift")
}

// Rust: tests/workspace_crates.rs:42
pub fn repo_files_with_suffix(dir: &String, suffix: &String) -> [OSPath] {
    root :: OSPath.from(env!("CARGO_MANIFEST_DIR"))
    out: [OSPath] := []
    stack := [root.join(dir)]
    while stack.pop() is Some(path) {
        meta :: match fs.metadata(&path) { Ok(value) -> value; Err(_) -> { continue } }
        if meta.is_dir() {
            for entry in fs.read_dir(&path).unwrap() {
                child :: entry.unwrap().path()
                name :: child.file_name().and_then((n) -> n.to_str()).unwrap_or("")
                if name == "target" || name == ".git" { continue }
                stack.push(child)
            }
        } else if path.strip_prefix(&root).unwrap().to_string_lossy().ends_with(suffix) {
            out.push(path)
        }
    }
    out.sort()
    out
}
