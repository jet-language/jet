#Test("unreadable_and_wrong_kind_outputs_leave_no_store_entry") {
    if selected_family() != "unix" -> return // GATE #4483
    root :: Scratch.new("invalid-output-root")
    fixtures :: Scratch.new("invalid-output-fixtures")
    fixture :: fixtures.join("nixpkgs-greet.json")
    write_fixture :: (out: OSPath) -> {
        fs.write(fixture, "[{{\"drvPath\":\"/nix/store/0fixture-greet.drv\",\"outputs\":{{\"out\":{out.to_string_lossy():?}}}}}]").unwrap()
    }
    build :: () -> {
        jetpack().args([String]{"build", "greet@nixpkgs", "--no-color", "--offline"}).env("JETPACK_ROOT", root.path).env("JETPACK_FIXTURES", fixtures.path).output().unwrap()
    }
    unreadable :: root.join("unreadable")
    fs.create_dir_all(unreadable).unwrap()
    fs.set_permissions(unreadable, fs.Permissions.from_mode(0o000)).unwrap()
    if fs.read_dir(unreadable).is_err() {
        write_fixture(unreadable)
        failed :: build()
        stderr :: String.from_utf8_lossy(failed.stderr)
        assert(!failed.status.success(), stderr)
        assert(stderr.contains("Error [E1315]:"), stderr)
        assert(stderr.contains("Permission denied"), stderr)
        assert_no_hangar_entry(root.path, "greet-")
    }
    fs.set_permissions(unreadable, fs.Permissions.from_mode(0o700)).unwrap()
    socket :: std.env.temp_dir().join("jpk-sock-{std.process.id()}")
    listener :: std.os.unix.net.UnixListener.bind(socket).unwrap() // GATE #4494
    write_fixture(socket)
    failed :: build()
    stderr :: String.from_utf8_lossy(failed.stderr)
    assert(!failed.status.success(), stderr)
    assert(stderr.contains("Error [E1315]:"), stderr)
    assert(stderr.contains("unsupported special file"), stderr)
    assert_no_hangar_entry(root.path, "greet-")
    std.mem.drop(^listener)
    _ :: fs.remove_file(socket)
}

