    fs.write(source.join("payload"), "orphaned bytes\n").unwrap()
    roots :: Roots{root: root.path, dev_mode: false}
    entry :: Store.ingest_tree(roots, IngestRequest{name: "canonical-gc", version: "1", reference: "path:canonical-gc", cache_identity: CacheIdentity{source_fingerprint: "sha256:canonical-gc-source", recipe_fingerprint: "sha256:canonical-gc-recipe", policy_fingerprint: "sha256:canonical-gc-policy", platform: Envelope.host_platform()}, references: [String]{}, outputs: [String: OSPath]{"out": source.path}, signature: "", provenance: "canonical GC test", platform_artifact_kind: ""}).unwrap().entry
    output :: OSPath.from(entry.out)
    receipt :: roots.hangar_dir().join("receipts").join(entry.receipt)
    assert(output.is_dir())
    assert(receipt.is_file())
    assert(Store.remove_closure_record(roots, entry.id).unwrap())
    plan :: Store.clean_plan(roots).unwrap()
    assert(plan.removed_objects >= 1, "canonical object missing from GC plan")
    assert(plan.removed_receipts == 1)
    report :: Store.clean(roots).unwrap()
    assert(report.removed_objects >= 1)
    assert(report.removed_receipts == 1)
    assert(!output.exists(), "unreachable canonical object survived GC")
    assert(!receipt.exists(), "unreachable receipt survived GC")
}
// Rust: tests/jetpack_engine.rs:3435
#Test("build_runs_opportunistic_clean_after_success") {
    root :: Scratch.new("root")
    stale :: write_hangar_meta(root.path, "old-auto", "oldauto", "1.0", Val(1)).0
    out :: jetpack().args([String]{"build", "fastfetch@nixpkgs", "--no-color", "--offline"}).env("JETPACK_ROOT", root.path).env("JETPACK_FIXTURES", example_fixtures(root.path)).env("JETPACK_AUTO_CLEAN_ALWAYS", "1").output().unwrap()
    assert(out.status.success(), String.from_utf8_lossy(out.stderr))
    assert(!stale.exists(), "successful build should run opportunistic clean")
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("auto-cleaned hangar"), stderr)
}

