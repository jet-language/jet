}

// Rust: tests/jetpack_engine.rs:2374
#Test("doctor_checks_real_state_and_is_read_only") {
    project :: Scratch.new("doctor-project")
    root :: Scratch.new("doctor-root")
    keys :: Scratch.new("doctor-keys")
    registry :: project.join("registry.git")
    registry_init :: Command.new("git").args([String]{"init", "--bare"}).arg(registry).output().unwrap()
    assert(registry_init.status.success(), String.from_utf8_lossy(registry_init.stderr))
    keygen :: jet().args([String]{"registry", "keygen"}).current_dir(project.path).env("JET_KEYS_DIR", keys.path).output().unwrap()
    assert(keygen.status.success(), String.from_utf8_lossy(keygen.stderr))
    registry_url :: "file://{registry.display()}"
    credentialed_registry_url :: "http://user:super-secret@example.invalid/index"
    // Native crypto has no Rust signing bridge. Snapshot the real key artifact/cache instead.
    helper :: keys.join("jet.ed25519")
    helper_before :: fs.metadata(helper).unwrap()
    helper_bytes_before :: fs.read(helper).unwrap()
    // Rust: tests/jetpack_engine.rs:2406 (signing_bridge_files)
    signing_bridge_files :: (dir: OSPath, key: String) -> {
        names := [std.ffi.OsString]{}
        loop entry in fs.read_dir(dir).unwrap() {
            name :: entry.unwrap().file_name()
            if name.to_string_lossy().contains(key) -> &names.push(name)
        }
        &names.sort()
        names
    }
    helper_dir :: keys.path
    helper_key :: "jet.ed25519"
    helper_parent_before :: signing_bridge_files(helper_dir, helper_key)
    healthy :: jetpack().args([String]{"doctor", "--json", "--online"}).current_dir(project.path).env("JETPACK_ROOT", root.path).env("JET_KEYS_DIR", keys.path).env("JET_REGISTRY_URL", registry_url).output().unwrap()
    assert(healthy.status.success(), String.from_utf8_lossy(healthy.stderr))
    healthy_json :: JSON.parse(String.from_utf8_lossy(healthy.stdout)).unwrap()
    assert(json_string(healthy_json, "status") == "healthy")
    assert(fs.metadata(helper).unwrap().len() == helper_before.len(), "doctor changed native signing artifact")
    assert(fs.read(helper).unwrap() == helper_bytes_before, "doctor changed native signing bytes")
    assert(signing_bridge_files(helper_dir, helper_key) == helper_parent_before, "doctor changed signing key cache")
    fs.remove_file(keys.join("jet.ed25519")).unwrap()
    degraded :: jetpack().args([String]{"doctor", "--online"}).current_dir(project.path).env("JETPACK_ROOT", root.path).env("JET_KEYS_DIR", keys.path).env("JET_REGISTRY_URL", credentialed_registry_url).output().unwrap()
    assert(degraded.status.code() == Val(2))
    degraded_text :: String.from_utf8(degraded.stderr).unwrap()
    assert(degraded_text.contains("[Fail] registry"), degraded_text)
    assert(degraded_text.contains("embedded registry credentials"), degraded_text)
    assert(degraded_text.contains("[Warn] signing"), degraded_text)
    assert(degraded_text.ends_with("Result: broken\n"), degraded_text)
    assert(!degraded_text.contains("super-secret"), "credential leaked: {degraded_text}")
    query_degraded :: jetpack().args([String]{"doctor", "--online"}).current_dir(project.path).env("JETPACK_ROOT", root.path).env("JET_KEYS_DIR", keys.path).env("JET_REGISTRY_URL", "file:///registry.git?access_token=super-secret").output().unwrap()
    assert(query_degraded.status.code() == Val(2))
    query_degraded_text :: String.from_utf8(query_degraded.stderr).unwrap()
    assert(query_degraded_text.contains("embedded registry credentials"), query_degraded_text)
    assert(!query_degraded_text.contains("super-secret"), "credential leaked: {query_degraded_text}")
    forced :: jet().args([String]{"registry", "keygen", "--force"}).current_dir(project.path).env("JET_KEYS_DIR", keys.path).output().unwrap()
    assert(forced.status.success(), String.from_utf8_lossy(forced.stderr))
    public_path :: keys.join("jet.ed25519.pub")
    matching_public :: fs.read_to_string(public_path).unwrap()
    mismatched_public := matching_public.bytes()
    mismatched_public[0] = if mismatched_public[0] == U8{48} -> U8{49} else -> U8{48}
    fs.write(public_path, mismatched_public).unwrap()
    mismatch :: jetpack().args([String]{"doctor", "--online"}).current_dir(project.path).env("JETPACK_ROOT", root.path).env("JET_KEYS_DIR", keys.path).env("JET_REGISTRY_URL", credentialed_registry_url).output().unwrap()
    mismatch_text :: String.from_utf8(mismatch.stderr).unwrap()
    assert(mismatch.status.code() == Val(2), mismatch_text)
    assert(mismatch_text.contains("does not match its public key"), mismatch_text)
    assert(!mismatch_text.contains("super-secret"), "credential leaked: {mismatch_text}")
    fs.write(public_path, matching_public).unwrap()
    output :: root.join("owned-output")
    fs.create_dir_all(output).unwrap()
    fs.write(output.join("payload"), "trusted bytes").unwrap()
    roots :: Roots{root: root.path, dev_mode: false}
    entry :: Store.ingest_tree(roots, IngestRequest{name: "demo", version: "1", reference: "./demo", cache_identity: CacheIdentity{source_fingerprint: "sha256-test-source", recipe_fingerprint: "sha256-test-recipe", policy_fingerprint: "sha256-test-policy", platform: Envelope.host_platform()}, references: [String]{}, outputs: [String: OSPath]{"out": output}, signature: "", provenance: "./demo via test", platform_artifact_kind: ""}).unwrap().entry
    meta :: root.join("hangar/{entry.id}/meta.json")
    old_meta :: fs.read_to_string(meta).unwrap()
    stale_meta :: old_meta.replace("\"last_used_at\": \"{entry.last_used_at}\"", "\"last_used_at\": \"0\"")
    fs.write(meta, stale_meta).unwrap()
    make_writable(&entry.out)
    fs.write(OSPath.from(entry.out).join("payload"), "corrupt bytes").unwrap()
    fs.create_dir_all(root.join(".locks")).unwrap()
    stale_lock :: root.join(".locks/abandoned.lock")
    fs.write(stale_lock, "pid=4294967294\n").unwrap()
    fs.remove_file(keys.join("jet.ed25519")).unwrap()
    before_meta :: fs.read(meta).unwrap()
    before_lock :: fs.read(stale_lock).unwrap()
    before_public :: fs.read(keys.join("jet.ed25519.pub")).unwrap()
    before_public_permissions :: fs.metadata(keys.join("jet.ed25519.pub")).unwrap().permissions()
    before_output_permissions :: fs.metadata(output.join("payload")).unwrap().permissions()
    broken :: jetpack().args([String]{"doctor", "--json", "--offline"}).current_dir(project.path).env("JETPACK_ROOT", root.path).env("JET_KEYS_DIR", keys.path).env("JET_REGISTRY_URL", "file://{project.join("missing").display()}").output().unwrap()
    assert(broken.status.code() == Val(2))
    text :: String.from_utf8(broken.stdout).unwrap()
    assert(text.contains("failed its content digest"), text)
    assert(text.contains("local index missing"), text)
    assert(!text.contains("stale lock"), text)
    assert(text.contains("kernel advisory locks readable"), text)
    assert(text.contains("unused for more than 30 days"), text)
    assert(text.contains("signing key for `jet` is missing"), text)
    assert(fs.read(meta).unwrap() == before_meta, "doctor changed metadata")
    assert(fs.read(stale_lock).unwrap() == before_lock, "doctor changed lock state")
    assert(fs.read(keys.join("jet.ed25519.pub")).unwrap() == before_public, "doctor changed public key")
    assert(fs.metadata(keys.join("jet.ed25519.pub")).unwrap().permissions() == before_public_permissions, "doctor changed key permissions")
    assert(fs.metadata(output.join("payload")).unwrap().permissions() == before_output_permissions, "doctor changed output permissions")
}

// Rust: tests/jetpack_engine.rs:2633
#Test("override_draft_writes_reviewed_workspace_policy_and_explains_it") {
    project :: Scratch.new("override-draft")
    fs.create_dir_all(project.join("patches")).unwrap()
    fs.write(project.join("patches/foo.patch"), "patch body\n").unwrap()
    out :: jetpack().args([String]{"override", "draft", "foo@nixpkgs", "--overlay", "plasma_beta", "--provider", "nixpkgs", "--channel", "plasma-beta", "--patch", "patches/foo.patch", "--allow-unfree", "--no-color"}).current_dir(project.path).output().unwrap()
    assert(out.status.success(), String.from_utf8_lossy(out.stderr))
    workspace :: fs.read_to_string(project.join("workspace.jet")).unwrap()
    assert(workspace.contains("overlay plasma_beta"), workspace)
    assert(workspace.contains("Provider.nixpkgs(channel: \"plasma-beta\")"), workspace)
    assert(workspace.contains("\"foo\": .{") && workspace.contains("patches: [patch(\"patches/foo.patch\")]") && workspace.contains("allowUnfree: true"), workspace)
    explain :: jetpack().args([String]{"explain", "package-overlay:plasma_beta:foo", "--no-color"}).current_dir(project.path).output().unwrap()
    assert(explain.status.success(), String.from_utf8_lossy(explain.stderr))
    stdout :: String.from_utf8_lossy(explain.stdout)
    assert(stdout.contains("package-overlay:plasma_beta:foo") && stdout.contains("provider: nixpkgs") && stdout.contains("policy: workspace.overlay.resolved:foo"), "explain: {stdout}")
    explain_json :: jetpack().args([String]{"explain", "package-overlay:plasma_beta:foo", "--json", "--no-color"}).current_dir(project.path).output().unwrap()
    assert(explain_json.status.success(), String.from_utf8_lossy(explain_json.stderr))
    assert(explain_json.stderr.is_empty())
    explain_json_stdout :: String.from_utf8_lossy(explain_json.stdout)
    assert(!explain_json_stdout.contains("schema_version"))
    report :: JSON.parse(explain_json_stdout.trim()).expect("overlay explain JSON")
    assert(json_string(report, "schema") == "jet.report/v1")
    assert(json_string(report, "moment") == "tool")
    assert(json_string(report, "action") == "explain")
    assert(json_string(report, "status") == "ok")
    assert(json_string(report, "lens") == "overlay")
}

