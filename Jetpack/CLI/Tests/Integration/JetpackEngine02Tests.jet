    assert(explanation.rebuild.attempt.unwrap().package == "left-pad")
}
// Rust: tests/jetpack_engine.rs:2857
#Test("no_nix_projects_external_output_and_build_facts") {
    root :: Scratch.new("nix-projection-root")
    fixtures :: Scratch.new("nix-projection-fixtures")
    staging :: Scratch.new("nix-projection-output")
    bin :: staging.join("bin")
    fs.create_dir_all(bin).unwrap()
    executable :: bin.join("greet")
    fs.write(executable, "#!/bin/sh\necho projected\n").unwrap()
    if selected_family() == "unix" -> fs.set_permissions(executable, fs.Permissions.from_mode(0o755)).unwrap()
    Store.seal_local_output(staging.path).unwrap()
    fs.write(fixtures.join("nixpkgs-greet.json"), "[{{\"drvPath\":\"/nix/store/0fixture00000000000000000000-greet.drv\",\"outputs\":{{\"out\":{staging.path.to_string_lossy():?}}}}}]").unwrap()
    built :: jetpack().args([String]{"build", "greet@nixpkgs", "--no-color", "--offline"}).env("JETPACK_ROOT", root.path).env("JETPACK_FIXTURES", fixtures.path).env("PATH", "").output().unwrap()
    assert(built.status.success(), String.from_utf8_lossy(built.stderr))
    roots :: Roots.at(root.path)
    entry :: Store.list_checked(roots).unwrap().iter().find(entry -> entry.reference == "greet@nixpkgs").expect("raw Nix output must publish through Store")
    assert(OSPath.from(entry.out).starts_with(roots.hangar_dir().join("objects")), "Nix output escaped Hangar projection: {entry.out}")
    assert(staging.path.exists(), "projection must not mutate source store")
    producer :: ProducerRecord.decode(entry.producer_record).unwrap()
    assert(producer.provider == "nix")
    assert(producer.facts.get("nix.projection.mode") == Val("canonical-hangar"))
    assert(producer.facts.get("nix.build.root") == Val("/build"))
    assert(producer.facts.get("nix.build.home") == Val("/homeless-shelter"))
    provider_facts :: ProviderFacts.from_json(producer.facts.get("provider-facts").expect("Nix production path must publish shared provider carrier")).expect("Nix producer provider facts must decode")
    provider_facts.validate().expect("Nix producer facts must remain lossless")
    assert(provider_facts.native_format == "json")
    assert(provider_facts.native_document.contains("drvPath"))
    assert(provider_facts.facts.has_key("nix.native.document"))
    entered :: jetpack().args([String]{"env", "--no-color", "--trust", "--offline", "--fixtures"}).arg(fixtures.path).args([String]{"-p", "greet", "--", "/bin/sh", "-c", "printf '%s|%s|%s|%s' \"$HOME\" \"$NIX_BUILD_TOP\" \"$TMPDIR\" \"$LC_ALL\""}).env("JETPACK_ROOT", root.path).env("PATH", "").output().unwrap()
    assert(entered.status.success(), String.from_utf8_lossy(entered.stderr))
    assert(String.from_utf8_lossy(entered.stdout).trim() == "/homeless-shelter|/build|/build|C")
}

// Rust: tests/jetpack_engine.rs:2969
#Test("connected_receipt_reaches_lock_and_fails_closed_on_corruption") {
    project :: Scratch.new("connected-receipt-project")
    root :: Scratch.new("connected-receipt-root")
    fixtures :: Scratch.new("connected-receipt-fixtures")
    staging :: Scratch.new("connected-receipt-staging")
    write_runnable_fixture(fixtures.path, root.path, staging.path)
    fs.write(project.join("env.jet"), "module dev { env.dev: Env{ packages: [nixpkgs.greet] } }\n").unwrap()
    build :: () -> {
        jetpack().args([String]{"build", "--no-color", "--offline"}).current_dir(project.path).env("JETPACK_ROOT", root.path).env("JETPACK_FIXTURES", fixtures.path).output().unwrap()
    }
    first :: build()
    assert(first.status.success(), String.from_utf8_lossy(first.stderr))
    roots :: Roots{root: root.path, dev_mode: false}
    entry :: Store.list_checked(roots).unwrap().iter().find(entry -> entry.name == "greet").expect("production build must publish greet")
    assert(entry.receipt.starts_with("sha256-"))
    receipt_path :: root.join("hangar/receipts").join(entry.receipt)
    receipt :: fs.read(receipt_path).unwrap()
    receipt_text :: String.from_utf8(receipt).unwrap()
    assert(receipt_text.starts_with("jet-development-receipt-v1\n"))
    assert(receipt_text.contains("act\t\t7061636b6167652d7265616c697a6174696f6e\t"))
    assert(receipt_text.contains("closure\t\t7368613235362d"))
    loop field in [String]{"input\t", "action\t", "output\t", "activation-proof\t\t\n", "parent-generation\t\t\n"} -> assert(receipt_text.contains(field), "missing {field:?}: {receipt_text}")
    assert(receipt_text.contains("witness\t\t"))
    assert(receipt_text.contains("outcome\t\t706173736564\t"))
    lock :: fs.read_to_string(project.join(".jet/lock")).unwrap()
    assert(lock.contains("receipt = \"{entry.receipt}\""), "lock does not project receipt {entry.receipt}: {lock}")
    output :: OSPath.from(entry.out).join("bin/greet")
    output_before_failure :: fs.read(output).unwrap()
    fs.write(receipt_path, "corrupt receipt".bytes()).unwrap()
    failed :: build()
    assert(!failed.status.success())
    failure :: "{String.from_utf8_lossy(failed.stdout)}{String.from_utf8_lossy(failed.stderr)}"
    assert(failure.contains("receipt"), "corruption was not explained: {failure}")
    assert(fs.read(output).unwrap() == output_before_failure)
    fs.remove_file(receipt_path).unwrap()
    recovered :: jetpack().args([String]{"hangar", "recover", "--no-color"}).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(recovered.status.success(), String.from_utf8_lossy(recovered.stderr))
    assert(fs.read(receipt_path).unwrap() == receipt)
    rebuilt :: build()
    assert(rebuilt.status.success(), "recovered receipt was not reusable: stdout={String.from_utf8_lossy(rebuilt.stdout)} stderr={String.from_utf8_lossy(rebuilt.stderr)}")
    orphan_bytes :: "orphan receipt".bytes()
    orphan_digest :: "sha256-{SHA256.sha256_hex(orphan_bytes)}"
    orphan_path :: root.join("hangar/receipts").join(orphan_digest)
    fs.write(orphan_path, orphan_bytes).unwrap()
    cleaned :: jetpack().args([String]{"hangar", "clean", "--no-color", "--yes"}).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(cleaned.status.success(), "receipt cleanup failed: {String.from_utf8_lossy(cleaned.stderr)}")
    assert(!orphan_path.exists(), "unreachable receipt was not collected")
    assert(fs.read(receipt_path).unwrap() == receipt)
}

