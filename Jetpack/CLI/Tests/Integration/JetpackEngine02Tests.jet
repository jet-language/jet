// Private continuation of JetpackEngine02 imports and canonical native fixtures.
// Rust: tests/jetpack_engine.rs:1813
#Test("package_policy_parses_exact_expiring_source_exception") {
    raw :: "\nname: \"consumer\"\nversion: \"0.1.0\"\npolicy: {\n    exceptions: [PolicyException{\n        id: \"JSA-2026-0001\",\n        scope: \"Acme.Widget#1.2.3\",\n        reason: \"urgent security fix\",\n        expires: 9999999999,\n    }],\n}\n"
    manifest :: Manifest.parse(OSPath.from("package.jet"), raw).expect("source policy exception should parse")
    assert(manifest.policy.exceptions.len() == 1)
    exception :: manifest.policy.exceptions[0]
    assert(exception.id == "JSA-2026-0001")
    assert(exception.scope == "Acme.Widget#1.2.3")
    assert(exception.matches("Acme.Widget", "1.2.3"))
    assert(exception.summary().contains("reason=urgent security fix"))
    invalid :: Manifest.parse(OSPath.from("package.jet"), "name: \"consumer\"\nversion: \"0.1.0\"\npolicy: { exceptions: [PolicyException{ id: \"JSA-1\", scope: \"Acme.Widget#^1.2\", reason: \"why\", expires: 10 }] }\n").expect_err("exception scope ranges must fail closed")
    assert(invalid.code == "E1206")
    assert(invalid.why.contains("PolicyException.scope"))
}
// Rust: tests/jetpack_engine.rs:1845
#Test("package_policy_drops_expired_source_exception_from_receipt") {
    policy := PackagePolicy.default()
    policy.exceptions = [PackagePolicyException]{PackagePolicyException{id: "JSA-EXPIRED", scope: "Acme.Widget#1.2.3", reason: "old waiver", expires_at: 0}}
    receipt :: authorize_package_candidate(policy, "Acme.Widget", "1.2.3", Val("MIT"), "public").expect("expired exceptions do not invalidate otherwise valid candidate")
    assert(receipt.exception == None)
    assert(!receipt.summary().contains("exception="))
}
// Rust: tests/jetpack_engine.rs:1868
#Test("package_policy_rejects_unmapped_or_non_spdx_candidates_before_ingest") {
    policy := PackagePolicy.default()
    policy.licenses = Val([String]{"MIT"})
    policy.source_maps = [(String, [String])]{("Acme.*", [String]{"internal"})}
    source_error :: authorize_package_candidate(policy, "Acme.Widget", "1.2.3", Val("MIT"), "public").expect_err("dependency-confusion source must be denied")
    assert(source_error.detail.contains("not allowed"))
    license_error :: validate_published_license("Acme.Widget", "1.2.3", Val("not a license")).expect_err("malformed SPDX must be denied")
    assert(license_error.detail.contains("invalid SPDX"))
    diagnostic :: package_policy_diagnostic(license_error)
    assert(diagnostic.code == "E2607")
    assert(diagnostic.what.contains("invalid SPDX"))
    assert(diagnostic.why.contains("security-sensitive"))
    assert(diagnostic.fix.contains("valid SPDX expression"))
    malformed :: Manifest.parse(OSPath.from("package.jet"), "name: \"consumer\"\nversion: \"0.1.0\"\npolicy: { licenses: .Allow([\"MIT\", \"MIT\"]) }\n").expect_err("duplicate license policy entries must be rejected")
    assert(malformed.code == "E1206")
    assert(malformed.what.contains("package.jet"))
    assert(malformed.why.contains("package metadata policy is malformed"))
    assert(malformed.fix.contains("syntax-decisions.md"))
}

// Rust: tests/jetpack_engine.rs:1909
#Test("real_cargo_project_import_preserves_lock_facts_and_migration_findings") {
    project :: Scratch.new("provider-import-real-cargo")
    fs.write(project.join("Cargo.toml"), "[package]\nname = \"real-app\"\nversion = \"0.4.0\"\nlicense = \"MIT\"\nbuild = \"build.rs\"\n\n[dependencies]\nserde = \"1\"\n\n[target.'cfg(unix)'.dependencies]\ncc = \"1\"\n\n[dev-dependencies]\ninsta = \"1\"\n").unwrap()
    fs.write(project.join("Cargo.lock"), "version = 4\n\n[[package]]\nname = \"serde\"\nversion = \"1.0.200\"\nsource = \"registry+https://example.invalid\"\nchecksum = \"serde-checksum\"\n\n[[package]]\nname = \"cc\"\nversion = \"1.0.99\"\nsource = \"registry+https://example.invalid\"\nchecksum = \"cc-checksum\"\n\n[[package]]\nname = \"insta\"\nversion = \"1.39.0\"\nsource = \"registry+https://example.invalid\"\nchecksum = \"insta-checksum\"\n").unwrap()
    plan :: import_cargo(fs.read_to_string(project.join("Cargo.toml")).unwrap(), fs.read_to_string(project.join("Cargo.lock")).unwrap())
    assert(plan.todos.iter().any(todo -> todo.source_path == "Cargo.toml" && todo.message.contains("build script")))
    loop (name, version, provider_ref) in [(String, String, String)]{("serde", "1.0.200", "serde@cargo#version=1.0.200"), ("cc", "1.0.99", "cc@cargo#version=1.0.99&platform=cfg(unix)")} {
        assert(plan.emit_pkg_jet().contains("{name}: {provider_ref}"), "generated package omitted {provider_ref}: {plan.emit_pkg_jet()}")
        facts :: plan.provider_facts.get(provider_ref).expect("real project provider facts")
        facts.validate().expect("lossless Cargo dependency facts")
        assert(facts.native_document.contains("Cargo.toml:"))
        assert(facts.native_document.contains("Cargo.lock:"))
        assert(facts.resolved_source == "cargo:{name}@{version}")
        assert(facts.provenance.get("package.version") == Val("Cargo.lock.version"))
        assert(facts.explain_lines().iter().any(line -> line == "native Cargo.toml+Cargo.lock: retained"))
        assert(ProviderFacts.from_json(facts.to_json()).expect("Cargo provider facts export") == facts)
        if name == "cc" -> assert(facts.selector.platform == "cfg(unix)")
    }
    insta :: plan.provider_facts.get("insta@cargo#version=1.39.0").expect("real project dev-dependency facts")
    insta.validate().expect("lossless Cargo dev-dependency facts")
    assert(!plan.emit_pkg_jet().contains("insta:"))
    assert(plan.todos.iter().any(todo -> todo.source_path == "Cargo.toml" && todo.message.contains("dev")))
    assert(plan.deps.iter().any(dep -> dep.name == "cc"))
    assert(plan.deps.iter().any(dep -> dep.name == "insta" && dep.dev))
}
// Rust: tests/jetpack_engine.rs:2013
#Test("cargo_import_keeps_unlocked_target_identity_without_duplicate_selector_facts") {
    plan :: import_cargo("[package]\nname = \"app\"\nversion = \"0.1.0\"\n[target.'cfg(unix)'.dependencies]\ncc = \"1\"\n", "")
    assert(plan.deps[0].provider_ref == "cc@cargo#platform=cfg(unix)")
    facts :: plan.provider_facts.get("cc@cargo#platform=cfg(unix)").expect("unlocked target provider facts")
    assert(facts.losses.iter().all(loss -> !loss.reason.contains("duplicate selector fact `platform=cfg(unix)`")))
    assert(plan.todos.iter().any(todo -> todo.source_path == "Cargo.lock" && todo.message.contains("unresolved")))
    assert(!plan.emit_pkg_jet().contains("cc:"))
}
// Rust: tests/jetpack_engine.rs:2036
#Test("jet_registry_dependency_roles_features_and_constraints_round_trip") {
    native :: "{{\"name\":\"rolekit\",\"version\":\"1.0.0\",\"content_hash\":\"sha256-rolekit\",\"dependencies\":{{\"runtime\":\"^1.0\"}},\"build_dependencies\":{{\"cc\":{{\"require\":\"^1.0\",\"strict\":true}}}},\"dev_dependencies\":{{\"insta\":\"^1.0\"}},\"optional_dependencies\":{{\"trace\":\"^1.0\"}},\"peer_dependencies\":{{\"host\":\"^2.0\"}},\"features\":{{\"default\":[\"trace\"]}},\"constraints\":{{\"runtime\":{{\"prefer\":\"1.0.1\",\"reject\":[\"1.0.2\"],\"strict\":true}}}}}}"
    report :: normalize_provider_document(ProviderFamily.JetRegistry, native)
    report.validate().expect("registry dependency metadata must be lossless")
    loop key in [String]{"provider.registry.dependency-role.build", "provider.registry.dependency.build.cc", "provider.registry.features", "provider.registry.constraints"} {
        assert(report.facts.typed.has_key(key), "registry fact carrier omitted {key}")
    }
    lock :: report.lock_record("engine-test", "rolekit@jet-registry#version=1.0.0", "x86_64-linux").expect("registry provider lock")
    facts :: ProviderFacts.from_json(lock.future_fields.get("provider-facts").expect("provider facts in semantic lock")).expect("provider facts round trip")
    assert(facts.native_document == native)
    assert(facts.facts.has_key("provider.registry.dependency-role.build"))
    assert(facts.facts.has_key("provider.registry.constraints"))
}
// Rust: tests/jetpack_engine.rs:2078
#Test("provider_conformance_nuget_conan_vcpkg_uses_shared_production_carrier") {
    documents :: [(ProviderFamily, String, String)]{
        (ProviderFamily.NuGet, "<package><metadata><id>widget</id><version>1.2.3</version><licenseExpression>MIT</licenseExpression><repository type=\"git\" url=\"https://example.invalid/widget\" /></metadata></package>", "widget@nuget#version=1.2.3"),
        (ProviderFamily.Conan, "name = \"widget\"\nversion = \"1.2.3\"\nlicense = \"MIT\"\ndef requirements(self):\n    self.requires(\"zlib/1.3.1\")\n", "widget@conan#version=1.2.3"),
        (ProviderFamily.Vcpkg, "{{\"name\":\"widget\",\"version-string\":\"1.2.3\",\"license\":\"MIT\",\"dependencies\":[{{\"name\":\"zlib\",\"version>=\":\"1.3.0\",\"features\":[\"core\"]}}],\"features\":{{\"tools\":[\"fmt\"]}}}}", "widget@vcpkg#version=1.2.3")
    }
    loop (family, native, reference) in documents {
        report :: normalize_provider_document(family, native)
        report.validate().expect("lossless provider report")
        lock :: report.lock_record("engine-test", reference, "x86_64-linux").expect("provider lock")
        facts :: ProviderFacts.from_json(lock.future_fields.get("provider-facts").expect("shared provider facts in lock")).expect("shared provider facts JSON")
        assert(facts.native_document == native)
        assert(facts.qualified_reference() == reference)
        assert(report.shared_facts().explain_lines().iter().any(line -> line.contains("provider")))
    }
    malformed :: normalize_provider_document(ProviderFamily.Vcpkg, "{{\"name\":\"widget\",\"version\":\"1.0.0\",\"version-string\":\"1.1.0\",\"dependencies\":[{{\"features\":[\"core\"]}}]}}")
    assert(malformed.validate().is_err())
    assert(malformed.losses.iter().any(loss -> loss.contains("no non-empty `name`")))
    assert(malformed.conflicts.iter().any(conflict -> conflict.contains("conflicting version fields")))
}
// Rust: tests/jetpack_engine.rs:2137
#Test("provider_conformance_homebrew_github_binary_uses_shared_production_carrier") {
    digest :: "sha256-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    revision :: "0123456789abcdef0123456789abcdef01234567"
    homebrew :: "{{\"name\":\"jq\",\"version\":\"1.7.1\",\"versions\":{{\"stable\":\"1.7.1\"}},\"tap\":\"homebrew/core\",\"dependencies\":[\"oniguruma\"],\"source\":{{\"url\":\"https://example.invalid/jq.tar.gz\",\"sha256\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}},\"bottle\":{{\"stable\":{{\"files\":{{\"x86_64_linux\":{{\"url\":\"https://example.invalid/jq.bottle.tar.gz\",\"sha256\":\"abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789\"}}}}}}}},\"relocatable\":true,\"test\":\"system \\\"#{{bin}}/jq\\\"\"}}"
    github :: "{{\"name\":\"tool\",\"tag_name\":\"v1.2.3\",\"target_commitish\":\"{revision}\",\"repository\":{{\"full_name\":\"acme/tool\"}},\"assets\":[{{\"name\":\"tool-linux\",\"platform\":\"x86_64-linux\",\"digest\":\"{digest}\",\"browser_download_url\":\"https://example.invalid/tool\"}}],\"signature\":{{\"key\":\"pk\",\"value\":\"sig\"}},\"advisories\":[\"CVE-0000-0000\"]}}"
    binary :: "{{\"name\":\"tool\",\"hash\":\"{digest}\",\"platforms\":[\"x86_64-linux\"],\"url\":\"https://example.invalid/tool\",\"signature\":{{\"key\":\"pk\",\"value\":\"sig\"}},\"provenance\":{{\"builder\":\"ci\"}},\"sbom\":{{\"format\":\"spdx\"}},\"variants\":{{\"debug\":{{\"features\":[\"trace\"]}}}}}}"
    loop (family, native, reference) in [(ProviderFamily, String, String)]{(ProviderFamily.Homebrew, homebrew, "jq#version=1.7.1@homebrew"), (ProviderFamily.Github, github, "tool@github#version=v1.2.3"), (ProviderFamily.Binary, binary, "tool#digest=sha256-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef@binary")} {
        report :: normalize_provider_document(family, native)
        report.validate().unwrap_or_else(error -> panic("lossless provider report: {error}"))
        shared :: report.shared_facts()
        assert(shared.native_document == native)
        assert(shared.explain_lines().iter().any(line -> line.contains("native") && line.contains("retained")))
        assert(ProviderFacts.from_json(report.export_json()).expect("provider export uses shared carrier") == shared)
        lock :: report.lock_record("engine-test", reference, "x86_64-linux").expect("provider lock uses shared carrier")
        locked :: ProviderFacts.from_json(lock.future_fields.get("provider-facts").expect("provider facts in lock")).expect("locked provider facts JSON")
        assert(locked == shared)
        assert(lock.future_fields.get("provider-facts-digest") == Val(shared.digest()))
    }
    assert(normalize_provider_document(ProviderFamily.Homebrew, homebrew).facts.typed.has_key("provider.homebrew.bottle.x86_64_linux.sha256"))
    github_report :: normalize_provider_document(ProviderFamily.Github, github)
    assert(github_report.facts.typed.has_key("provider.github.revision"))
    assert(github_report.shared_facts().facts.has_key("provider.github.asset.tool-linux.browser_download_url"))
    assert(normalize_provider_document(ProviderFamily.Binary, binary).shared_facts().facts.has_key("provider.binary.provenance"))
}
// Rust: tests/jetpack_engine.rs:2221
#Test("provider_conformance_homebrew_github_binary_reports_loss_and_conflict_without_defaults") {
    homebrew :: normalize_provider_document(ProviderFamily.Homebrew, "{{\"name\":\"jq\",\"version\":\"1.7.1\",\"versions\":{{\"stable\":\"1.7.2\"}}}}")
    assert(homebrew.conflicts.iter().any(conflict -> conflict.contains("conflicting version")))
    assert(homebrew.validate().is_err())
    assert(homebrew.shared_facts().conflicts.iter().any(conflict -> conflict.right.contains("conflicting version") && conflict.left != conflict.right))
    github :: normalize_provider_document(ProviderFamily.Github, "{{\"name\":\"tool\",\"tag_name\":\"v1.2.3\",\"assets\":[{{\"name\":\"tool-linux\",\"platform\":\"x86_64-linux\",\"browser_download_url\":\"https://example.invalid/tool\"}}]}}")
    assert(github.losses.iter().any(loss -> loss.contains("no content digest")))
    assert(github.validate().is_err())
    assert(github.shared_facts().losses.iter().any(loss -> loss.reason.contains("no content digest")))
    binary :: normalize_provider_document(ProviderFamily.Binary, "{{\"name\":\"tool\",\"hash\":\"sha256-aa\"}}")
    assert(binary.losses.iter().any(loss -> loss.contains("not an exact digest")))
    assert(binary.losses.iter().any(loss -> loss.contains("no target platform")))
    assert(binary.validate().is_err())
    assert(binary.shared_facts().losses.iter().any(loss -> loss.reason.contains("exact version, revision, or digest")))
}
// Rust: tests/jetpack_engine.rs:2273
#Test("real_project_import_reports_lossy_npm_requests_without_generated_refs") {
    project :: Scratch.new("provider-import-real-npm")
    fs.write(project.join("package.json"), "{{\n  \"name\": \"web-app\",\n  \"version\": \"1.2.3\",\n  \"dependencies\": {{\"vite\": \"^5.4.0\"}},\n  \"devDependencies\": {{\"typescript\": \"~5.5.0\"}},\n  \"optionalDependencies\": {{\"fsevents\": \"2.3.3\"}},\n  \"peerDependencies\": {{\"react\": \"^18.0.0\"}},\n  \"bundledDependencies\": [\"local-tool\"],\n  \"scripts\": {{\"build\": \"vite build\"}}\n}}\n").unwrap()
    document :: fs.read_to_string(project.join("package.json")).unwrap()
    plan :: import_npm(document)
    generated :: plan.emit_pkg_jet()
    loop name in [String]{"vite", "typescript", "fsevents", "react"} -> assert(!generated.contains("{name}:"), "lossy ref generated: {generated}")
    loop (name, field) in [(String, String)]{("vite", "dependencies"), ("typescript", "devDependencies"), ("react", "peerDependencies")} {
        facts :: plan.provider_facts.get("{name}@npm").expect("provider facts for unresolved npm dependency")
        assert(facts.native_document.contains("web-app"))
        assert(facts.losses.iter().any(loss -> loss.source == "package.json.{field}"))
        assert(plan.todos.iter().any(todo -> todo.source_path == "package.json" && todo.message.contains("unresolved")))
    }
    optional :: plan.provider_facts.get("fsevents#version=2.3.3@npm").expect("provider facts for exact optional npm dependency")
    optional.validate().expect("lossless npm optional dependency facts")
    assert(optional.provenance.get("package.dependency_kind") == Val("package.json.optionalDependencies"))
    assert(optional.explain_lines().iter().any(line -> line == "native package.json: retained"))
    assert(ProviderFacts.from_json(optional.to_json()).expect("npm facts export") == optional)
    assert(plan.todos.iter().any(todo -> todo.source_path == "package.json" && todo.message.contains("optional")))
    assert(plan.todos.iter().any(todo -> todo.source_path == "package.json" && todo.message.contains("bundled")))
    assert(plan.todos.iter().any(todo -> todo.message.contains("legacy build action")))
}
// Rust: tests/jetpack_engine.rs:2354
#Test("cargo_import_reports_ambiguous_lock_identity_without_generation") {
    plan :: import_cargo("[package]\nname = \"app\"\nversion = \"0.1.0\"\n[dependencies]\nserde = \"1\"\n", "[[package]]\nname = \"serde\"\nversion = \"1.0.200\"\nsource = \"registry+one\"\n[[package]]\nname = \"serde\"\nversion = \"1.0.201\"\nsource = \"registry+two\"\n")
