// Rust: tests/jetpack_engine.rs:3542
#Test("parent_env_unchanged_after_use") {
    root :: Scratch.new("root")
    fixtures :: Scratch.new("fx")
    write_native_lease_fixture(&fixtures.path)
    before :: std.env.var("PATH").unwrap_or_default()
    output :: jetpack().args([String]{"use", "omp@releases#1.0.0", "-y", "--no-color", "--offline", "--fixtures"}).arg(fixtures.path).args([String]{"--", "sh", "-c", "printf %s \"$PATH\""}).env("JETPACK_ROOT", root.path).env("JETPACK_FIXTURES", fixtures.path).output().unwrap()
    assert(output.status.success(), "lease handoff command failed: {String.from_utf8_lossy(output.stderr)}")
    child_path :: String.from_utf8_lossy(output.stdout)
    entries := child_path.split(':')
    wrapper :: entries.next().unwrap_or_default()
    assert(wrapper.starts_with("/proc/self/fd/"), "expected sealed FD-pinned exec-wrapper dir first, got: {child_path}")
    bin :: entries.next().unwrap_or_default()
    assert(!bin.starts_with(root.path.to_string_lossy().to_string()), "raw package output escaped lease handoff, got: {child_path}")
    assert(std.env.var("PATH").unwrap_or_default() == before)
    entry :: Store.find_by_reference(Roots.at(root.path), "omp@releases#1.0.0").unwrap()
    explicit_raw_path :: OSPath.from(entry.out).join("bin/omp")
    explicit :: jetpack().args([String]{"use", "omp@releases#1.0.0", "-y", "--no-color", "--offline", "--fixtures"}).arg(fixtures.path).arg("--").arg(explicit_raw_path).env("JETPACK_ROOT", root.path).env("JETPACK_FIXTURES", fixtures.path).output().unwrap()
    assert(explicit.status.success(), "explicit leased executable escaped confinement: {String.from_utf8_lossy(explicit.stderr)}")
    assert(String.from_utf8_lossy(explicit.stdout).trim() == "hello from jetpack")
}
