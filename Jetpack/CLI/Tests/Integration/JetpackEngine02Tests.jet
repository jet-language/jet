#Test("package_explain_matches_failed_provider_reference_target") {
    root :: Scratch.new("package-explain-failed-provider-ref")
    roots :: Roots{root: root.path, dev_mode: false}
    attempt := Attempt.new("left-pad", "left-pad#version=2.0.17@npm", "npm", "sha256-recipe", "sha256-source")
    &attempt.push_step(StepLog{index: 1, total: 1, name: "fetch", command: "fetch left-pad", cwd: root.path.display().to_string(), status: "failed", stdout: "", stderr: "network unavailable"})
    attempt.persist(roots.hangar_dir()).unwrap()
