// Rust: tests/jetpack_tool.rs:25
pub fn physical_bin(name: String) -> String {
    if selected_os() == "windows" && !name.to_ascii_lowercase().ends_with(".exe") { "{name}.exe" } else { name.to_string() }
}

// Rust: tests/jetpack_tool.rs:33
pub fn write_tool_bin_fixture(root: OSPath, fixtures: OSPath, pkg: String, bin: String, script: String) -> {
    fs.create_dir_all(fixtures) ?? panic("create fixtures")
    out_dir :: root.join("hangar").join("provider-fixture-{pkg}")
    bin_dir :: out_dir.join("bin")
    fs.create_dir_all(bin_dir) ?? panic("create bin")
    path :: bin_dir.join(bin)
    fs.write(path, script) ?? panic("write bin")
    if selected_family() == "unix" {
        fs.set_permissions(path, fs.Permissions.from_mode(0o555)) ?? panic("chmod bin")
        fs.set_permissions(bin_dir, fs.Permissions.from_mode(0o555)) ?? panic("chmod bin directory")
        fs.set_permissions(out_dir, fs.Permissions.from_mode(0o555)) ?? panic("chmod output")
    }
    json :: "[{\"drvPath\":\"/nix/store/fixture-{pkg}.drv\",\"outputs\":{\"out\":{out_dir.to_string_lossy():?}}}]"
    fs.write(fixtures.join("nixpkgs-{pkg}.json"), json) ?? panic("write provider fixture")
}

// Rust: tests/jetpack_tool.rs:54
pub fn write_native_omp_fixture(fixtures: OSPath, version: String, script: String) -> {
    fs.create_dir_all(fixtures) ?? panic("create native fixtures")
    artifact_name :: "omp-{version}"
    artifact :: fixtures.join(artifact_name)
    fs.write(artifact, script) ?? panic("write artifact")
    digest :: SHA256.sha256_file_hex(artifact) ?? panic("hash artifact")
    fs.write(fixtures.join("jetpackage-omp.json"), "{\"tag\":\"v{version}\",\"version\":\"{version}\",\"sha256\":\"{digest}\",\"artifact\":\"{artifact_name}\"}") ?? panic("write native metadata")
}

// Rust: tests/jetpack_tool.rs:69
pub fn tool_install_command(root: OSPath, project: OSPath, fixtures: OSPath, home: OSPath, package: String) -> Command {
    command := jetpack()
    command.args(["tool", "install", "{package}@nixpkgs", "--no-color", "--offline", "--fixtures"]).arg(fixtures).current_dir(project).env("JETPACK_ROOT", root).env("HOME", home)
    command
}

// Rust: tests/jetpack_tool.rs:93
pub fn lifecycle_wire(root: OSPath) -> String {
    journal :: root.join("hangar/lifecycle-db/journal")
    paths := fs.read_dir(journal) ?? panic("read journal")
    ordered := paths.map(entry -> (entry ?? panic("journal entry")).path()).collect()
    ordered.sort()
    wire := String.new()
    for path in ordered {
        if text :: fs.read_to_string(path).ok() { wire.push_str(text) }
    }
    wire
}

// Rust: tests/jetpack_tool.rs:107
// Rust: tests/jetpack_tool.rs:113
pub fn metadata_mode(metadata: fs.Metadata) -> U32 {
    if selected_family() == "unix" { metadata.permissions().mode() }
    else if metadata.permissions().readonly() { 1 } else { 0 }
}

// Rust: tests/jetpack_tool.rs:122
#Derive(Debug, PartialEq, Eq)
pub struct FilesystemEntry {
    path: OSPath
    kind: U8
    length: U64
    mode: U32
    modified: SystemTime?
    bytes: [U8]
}

// Rust: tests/jetpack_tool.rs:131
pub fn filesystem_snapshot(root: OSPath) -> [FilesystemEntry] {
    // Rust: tests/jetpack_tool.rs:132
    fn visit(root: OSPath, path: OSPath, entries: &[FilesystemEntry]) -> {
        metadata :: fs.symlink_metadata(path) ?? panic("snapshot metadata")
        file_type :: metadata.file_type()
        kind :: if file_type.is_symlink() { 3 } else if file_type.is_dir() { 1 } else if file_type.is_file() { 2 } else { 4 }
        bytes :: if file_type.is_file() { fs.read(path) ?? panic("snapshot bytes") } else { [] }
        entries.push(FilesystemEntry(path: (path.strip_prefix(root) ?? panic("snapshot prefix")).to_path_buf(), kind: kind, length: metadata.len(), mode: metadata_mode(metadata), modified: metadata.modified().ok(), bytes: bytes))
        if !file_type.is_dir() { return }
        children := (fs.read_dir(path) ?? panic("snapshot directory")).map(entry -> (entry ?? panic("snapshot entry")).path()).collect()
        children.sort()
        for child in children { visit(root, child, entries) }
    }
    entries := []
    visit(root, root, &entries)
    entries
}

// Rust: tests/jetpack_tool.rs:175
pub fn ascii_hex(value: String) -> String {
    result := String.new()
    for byte in value.bytes() { result.push_str("{byte:02x}") }
    result
}

// Rust: tests/jetpack_tool.rs:179
pub fn metadata_output_hash(metadata: String) -> String {
    (_, tail) :: metadata.split_once("\"output_hash\": \"") ?? panic("output hash")
    (digest, _) :: tail.split_once('"') ?? panic("output hash terminator")
    digest.to_string()
}

// Rust: tests/jetpack_tool.rs:229
pub fn json_meta_field(metadata: String, key: String) -> String {
    needle :: "\"{key}\": \""
    (_, tail) :: metadata.split_once(needle) ?? panic("missing {key} in {metadata}")
    (value, _) :: tail.split_once('"') ?? panic("missing {key} in {metadata}")
    value.to_string()
}
