// Rust: tests/pkg.rs:1902
#Test("foreign_package_provider_fetch_lock_and_locked_round_trip") {
    _guard :: STORE_LOCK.lock().expect("store lock")
    project :: Scratch.new("foreign_provider_project")
    stale_project :: Scratch.new("foreign_provider_stale")
    failed_project :: Scratch.new("foreign_provider_failure")
    fixtures :: Scratch.new("foreign_provider_fixtures")
    store :: Scratch.new("foreign_provider_store")
    artifact :: fixtures.join("foreign/npm/plotly-plotly_version_2_35_0/.jet/bindings/js/plotly.jet")
    fs.create_dir_all(artifact.parent().expect("artifact parent")).expect("create artifact dir")
    descriptor :: AST.binder_descriptor(AST.ForeignLanguage.JS).expect("JS descriptor").stamp()
    fs.write(artifact, "// jet-ffi-descriptor={descriptor}\npub fn scatter() -> Int {\n    return 7\n}\n").expect("write binding")
    manifest_text :: manifest_with_deps("consumer", "0.1.0", "    plotly: js@\"plotly#version=2.35.0@npm\",")
    for root in [project.path, failed_project.path] { fs.write(root.join("package.jet"), manifest_text).expect("write manifest") }
    main :: project.join("main.jet")
    fs.write(main, "use js.plotly as plot\nfn run() -> {\n    print(plot.scatter())\n}\n").expect("write consumer")
    manifest :: Manifest.parse(project.join("package.jet"), manifest_text).expect("parse consumer")
    old_root :: env.var_os("JETPACK_ROOT")
    old_fixtures :: env.var_os("JETPACK_FIXTURES")
    env.set_var("JETPACK_ROOT", store.path)
    env.set_var("JETPACK_FIXTURES", fixtures.path)
    fs.write(stale_project.join("package.jet"), manifest_text).expect("write stale manifest")
    fs.write(artifact, "// jet-ffi-descriptor=stale\npub fn scatter() -> Int {\n    return 7\n}\n").expect("write stale binding")
    stale_manifest :: Manifest.parse(stale_project.join("package.jet"), manifest_text).expect("parse stale manifest")
    stale :: Fetch.fetch(stale_project.path, stale_manifest, None, Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)).expect_err("stale provider binding must fail before ingestion")
    assert(stale.iter().any(diagnostic -> diagnostic.code == "E1256"))
    fs.write(artifact, "// jet-ffi-descriptor={descriptor}\npub fn scatter() -> Int {\n    return 7\n}\n").expect("restore binding")
    fetched :: Fetch.fetch(project.path, manifest, None, Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative))
    (lock, dep_dirs) :: fetched.expect("foreign provider fetch should realize the package")
    assert(dep_dirs.get("plotly").is_some_and(path -> path.is_dir()))
    assert(Foreign.project_binding_path(project.path, AST.ForeignLanguage.JS, "plotly").is_file())
    foreign :: lock.packages.iter().find(package -> package.name == "plotly").expect("foreign package must be in lock")
    assert(match foreign.source { Lock.LockSource.Foreign(AST.ForeignLanguage.JS, reference, output) -> reference == "plotly#version=2.35.0@npm" && !output.is_empty(); _ -> false })
    assert(foreign.envelope.is_some_and(envelope -> !envelope.output_hash.is_empty()))
    lock_text :: fs.read_to_string(project.join(".jet/lock")).expect("read lock")
    round_trip :: Lock.parse(lock_text).expect("foreign lock should parse back")
    assert_eq(round_trip.packages, lock.packages)
    source :: fs.read_to_string(main).expect("read consumer")
    _ :: compile_with_path(source, main.to_string_lossy()).expect("compiler must consume the provider-projected binding")
    locked :: Fetch.fetch(project.path, manifest, Some(lock), Fetch.FetchOptions(locked: true, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)).expect("locked foreign provider round-trip should verify")
    assert_eq(locked.0.packages, lock.packages)
    fs.remove_dir_all(fixtures.join("foreign/npm")).expect("remove provider")
    failed_manifest :: Manifest.parse(failed_project.join("package.jet"), manifest_text).expect("parse failure manifest")
    failure :: Fetch.fetch(failed_project.path, failed_manifest, None, Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)).expect_err("missing provider artifact must fail before foreign fetch succeeds")
    assert(failure.iter().any(diagnostic -> diagnostic.code == "E1256"))
    assert(!failed_project.join(".jet/lock").exists())
    if value :: old_root { env.set_var("JETPACK_ROOT", value) } else { env.remove_var("JETPACK_ROOT") }
    if value :: old_fixtures { env.set_var("JETPACK_FIXTURES", value) } else { env.remove_var("JETPACK_FIXTURES") }
}

