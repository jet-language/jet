// Rust: tests/pkg.rs:2282
#Test("cli_build_prints_effect_summary") {
    if !jet_bin().is_file() { eprintln("note: skipping cli_build_prints_effect_summary (run `cargo build` first)"); return }
    tmp :: tmp_dir("effbudget_summary")
    store :: tmp.join("store")
    fs.create_dir_all(store).expect("create store")
    write(tmp, "hello.jet", "use core.files as fs\nfn run() -> { fs.write(\"/tmp/jet_effbudget_test.txt\", \"x\") ?? panic(\"e\") }\n")
    out :: jet_cmd(["build", "hello.jet"], tmp, store)
    assert(out.status.success(), "jet build failed:\n{String.from_utf8_lossy(out.stderr)}")
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("effects:") && stderr.contains("FS"), "expected an effect summary naming FS on stderr, got:\n{stderr}")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:2316
#Test("cli_build_enforces_effect_budget_e1220") {
    if !jet_bin().is_file() { eprintln("note: skipping cli_build_enforces_effect_budget_e1220 (run `cargo build` first)"); return }
