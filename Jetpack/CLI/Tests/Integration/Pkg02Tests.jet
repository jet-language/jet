// Rust: tests/pkg.rs:2108
#Test("manifest_panic_budget_names_the_dependency_stop_site") {
    raw :: min_manifest("app", "0.1.0") + "\nauthority: { holds: { deny: [Panic] } }\n"
    manifest :: Package.PackageFacts.parse(raw, "test").expect("Panic should be a manifest effect root")
    entries :: [EffectBudget.PackageEffects(name: "panicdep", effects: Sema.EffectSet.from(["Panic"]), effect_sites: [:], panic_sites: ["panicdep::parse_port"], boundary_span: Some(Diagnostics.Span.new(4, 12)))]
    diagnostics :: EffectBudget.enforce(entries, manifest)
    assert_eq(diagnostics.len(), 1)
    assert_eq(diagnostics[0].code, "E1220")
    assert(diagnostics[0].what.contains("panicdep"))
    assert(diagnostics[0].what.contains("parse_port"))
    assert(diagnostics[0].fix.contains("fallible result"))
    assert(diagnostics[0].fix.contains("#Pre"))
    assert_eq(diagnostics[0].span, Some(Diagnostics.Span.new(4, 12)))
}

