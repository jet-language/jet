// Rust: tests/pkg.rs:2144
#Test("manifest_parse_authority_block_holds_grants_trust_and_providers") {
    raw :: min_manifest("app", "0.1.0") + "\nauthority: {\n    holds: { allow: [Net, DB.Read], deny: [Exec] },\n    grants: { \"image-codec\": [FS.Read] },\n    trust: { default: prompt, ci: { prompt: deny }, services: { stripe: allow } },\n    providers: { nix: { registry: \"nixpkgs\", deny: [\"openssl-1.0\"] } },\n}\n"
    pm :: Package.PackageFacts.parse(raw, "test").expect("one authority block should parse")
    assert_eq(pm.authority.holds.allow, Some(["Net", "DB.Read"]))
    assert_eq(pm.authority.holds.deny, Some(["Exec"]))
    assert_eq(pm.authority.grants, [("image-codec", ["FS.Read"])])
    assert_eq(pm.grants, pm.authority.grants)
    assert_eq(pm.effects_allow, pm.authority.holds.allow)
    assert_eq(pm.effects_deny, pm.authority.holds.deny)
    assert_eq(pm.authority.trust.and_then(trust -> trust.default), Some(Package.TrustDecision.Prompt))
    assert_eq(pm.authority.providers.len(), 1)
    assert_eq(pm.authority.providers[0].provider, "nix")
    assert_eq(pm.authority.providers[0].registry, "nixpkgs")
    assert_eq(pm.authority.providers[0].deny, ["openssl-1.0"])
}

// Rust: tests/pkg.rs:2182
#Test("manifest_parse_authority_trust_block") {
    raw :: min_manifest("app", "0.1.0") + "\nauthority: { trust: { default: prompt, ci: { prompt: deny }, services: { postgres: prompt }, require: attested } }\n"
    pm :: Package.PackageFacts.parse(raw, "test").expect("authority.trust block should parse")
    policy :: pm.authority.trust.expect("authority trust policy should be stored")
    assert_eq(policy.default, Some(Package.TrustDecision.Prompt))
    assert_eq(policy.ci_prompt, Some(Package.TrustDecision.Deny))
    assert_eq(policy.services, [("postgres", Package.TrustDecision.Prompt)])
    assert_eq(policy.require, Some(Package.ProvenanceRequirement.Attested))
}

