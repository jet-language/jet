    fp_none_a :: Lock.compute_fingerprint("sha256-aabbcc", ["sha256-x"], "")
    fp_none_b :: Lock.compute_fingerprint("sha256-aabbcc", ["sha256-x"], "")
    assert_eq(fp_none_a, fp_none_b)
    assert_ne(fp_none_a, fp_read, "a frozen digest must differ from none")
}

