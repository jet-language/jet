// Rust: tests/pkg.rs:2890
#Test("store_install_rejects_source_and_destination_symlinks") {
    if selected_family() == "unix" {
        tmp :: tmp_dir("store_symlink_boundary")
        store :: tmp.join("store")
        fs.create_dir_all(store).expect("create store")
        outside :: tmp.join("outside")
        fs.write(outside, "must survive\n").expect("write outside")
        source :: tmp.join("source")
        fs.create_dir_all(source).expect("create source")
        fs.write(source.join("package.jet"), "name: \"safe\"\n").expect("write package")
        outcomes :: with_store(store, () -> {
            entry :: Store.store_path("safe", "0.1.0", "sha256-safe")
            fs.symlink(outside, entry).expect("destination symlink")
            destination :: Store.ensure_path_dep("safe", "0.1.0", "sha256-safe", source)
            fs.remove_file(entry).expect("remove symlink")
            fs.symlink(outside, source.join("leak")).expect("source symlink")
            source_result :: Store.ensure_path_dep("safe", "0.1.0", "sha256-source", source)
            (destination, source_result)
        })
        assert(outcomes.0.is_err(), "store entry symlink must be refused")
        assert(outcomes.1.is_err(), "source tree symlink must be refused")
        assert_eq(fs.read_to_string(outside).expect("outside survived"), "must survive\n")
        _ :: fs.remove_dir_all(tmp)
    }
}

// Rust: tests/pkg.rs:2926
#Test("store_snapshot_install_and_vendor_reject_multiply_linked_source") {
    if ["linux", "android", "macos", "ios"].contains(selected_os()) {
        scratch :: Scratch.new("store_vendor_hardlink")
        store :: scratch.join("store")
        fs.create_dir_all(store).expect("create store")
        source :: scratch.join("source")
        write(source, "package.jet", min_manifest("dep", "0.1.0"))
        outside :: scratch.join("outside.bin")
        fs.write(outside, b"must remain outside\n").expect("write outside")
        fs.hard_link(outside, source.join("linked.bin")).expect("link source")
        snapshot :: with_store(store, () -> Store.snapshot_tree(source))
        assert(snapshot.is_err(), "snapshot_tree must reject multiply-linked source files")
        ensured :: with_store(store, () -> Store.ensure_path_dep("dep", "0.1.0", "sha256-hardlink", source))
        assert(ensured.is_err(), "ensure_path_dep must reject multiply-linked source files")
        dep_dirs := [:]
        dep_dirs.insert("dep", source.clone())
        vendor_dir :: scratch.join("vendor")
        vendored :: Publish.vendor(scratch.path, make_test_lock("dep", "0.1.0", "sha256-hardlink"), dep_dirs, vendor_dir)
        assert(vendored.is_err(), "Publish::vendor must reject multiply-linked source files")
        assert(!vendor_dir.join("dep").exists(), "failed vendor must not publish a dependency directory")
        assert_eq(fs.read(outside).expect("read outside"), b"must remain outside\n", "hardlinked source bytes must remain unchanged")
    }
}

// Rust: tests/pkg.rs:2977
#Test("source_snapshot_keeps_verified_bytes_after_source_mutation") {
    tmp :: tmp_dir("source_snapshot_mutation")
    store :: tmp.join("store")
    fs.create_dir_all(store).expect("create store")
    source :: tmp.join("source")
    write(source, "package.jet", min_manifest("safe", "0.1.0"))
    write(source, "lib.jet", "pub fn trusted() -> {}\n")
    (snapshot, verified_hash) :: with_store(store, () -> {
        snapshot :: Store.snapshot_tree(source).expect("snapshot must verify")
        verified_hash :: snapshot.content_hash().to_string()
        (snapshot, verified_hash)
    })
    fs.write(source.join("lib.jet"), "pub fn hostile() -> {}\n").expect("mutate source")
    assert_eq(fs.read_to_string(snapshot.path().join("lib.jet")).expect("read verified bytes"), "pub fn trusted() -> {}\n", "consumers must keep using the verified snapshot after the source changes")
    assert_eq(snapshot.content_hash(), verified_hash)
    assert_eq(SHA256.try_tree_hash(snapshot.path()).expect("hash snapshot"), verified_hash)
    drop(snapshot)
    _ :: fs.remove_dir_all(tmp)
}

