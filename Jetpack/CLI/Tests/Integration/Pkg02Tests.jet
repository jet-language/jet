// Rust: tests/pkg.rs:3518
#Test("compiler_rejects_transitive_path_dependency_escape") {
    tmp :: tmp_dir("compiler_transitive_path_escape")
    outer :: tmp.join("outer")
    outside :: tmp.join("outside")
    write(outer, "package.jet", min_manifest("outer", "0.1.0") + "\ndeps: { escape: ../outside }\n")
    write(outer, "outer.jet", "pub fn value() -> {}\n")
    write(outside, "package.jet", min_manifest("outside", "0.1.0"))
    write(outside, "outside.jet", "pub fn value() -> {}\n")
    raw :: manifest_with_deps("app", "0.1.0", "    outer: ./outer,")
    write(tmp, "package.jet", raw)
    write(tmp, "run.jet", "fn run() -> {}\n")
    entry :: tmp.join("run.jet")
    errors :: Driver.compile_bundle_path_build(entry.to_str().expect("entry text"), Driver.BuildRunOptions.default()).expect_err("the compiler must not read a transitive manifest outside its package")
    assert_eq(first_diag_code(errors), "E1206")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:3545
#Test("compiler_accepts_transitive_path_dependency_the_root_declares") {
    tmp :: tmp_dir("compiler_transitive_path_root_declared")
    outer :: tmp.join("outer")
    shared :: tmp.join("shared")
    write(outer, "package.jet", min_manifest("outer", "0.1.0") + "\ndeps: { shared: ../shared }\n")
    write(outer, "outer.jet", "pub fn value() -> {}\n")
    write(shared, "package.jet", min_manifest("shared", "0.1.0"))
    write(shared, "shared.jet", "pub fn value() -> {}\n")
    raw :: manifest_with_deps("app", "0.1.0", "    outer: ./outer,\n    shared: ./shared,")
    write(tmp, "package.jet", raw)
    write(tmp, "run.jet", "fn run() -> {}\n")
    entry :: tmp.join("run.jet")
    result :: Driver.compile_bundle_path_build(entry.to_str().expect("entry text"), Driver.BuildRunOptions.default())
    assert(result.err().map_or(true, errors -> errors.iter().all(d -> d.code != "E1206")), "a path the root declares is not an escape: {result.err().map(errors -> errors.iter().map(d -> d.code.clone()).collect()):?}")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:3577
#Test("fetch_locked_rejects_tampered_path_dependency_store_entry") {
    tmp :: tmp_dir("locked_path_tamper")
    store :: tmp.join("store")
    dependency :: tmp.join("greeter")
    fs.create_dir_all(store).expect("create store")
    write(dependency, "package.jet", min_manifest("greeter", "0.1.0"))
    write(dependency, "greeter.jet", "pub fn greet() -> {}\n")
    raw :: manifest_with_deps("app", "0.1.0", "    greeter: ./greeter,")
    write(tmp, "package.jet", raw)
    manifest :: Manifest.parse(tmp.join("package.jet"), raw).expect("parse manifest")
    unlocked :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    (lock, _) :: with_store(store, () -> { Fetch.fetch(tmp, manifest, None, unlocked).expect("initial path fetch should create a content hash") })
    locked :: Fetch.FetchOptions(locked: true, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    error :: with_store(store, () -> {
        package :: lock.packages.iter().find(package -> package.name == "greeter").expect("path dependency must be recorded in the lock")
        store_entry :: Store.store_path(package.name, package.version, package.fingerprint)
        fs.write(store_entry.join("greeter.jet"), "pub fn compromised() -> {}\n").expect("tamper")
        Fetch.fetch(tmp, manifest, Some(lock), locked).expect_err("locked fetch must reject a changed store entry")
    })
    assert_eq(first_diag_code(error), "E1204")
    _ :: fs.remove_dir_all(tmp)
}
