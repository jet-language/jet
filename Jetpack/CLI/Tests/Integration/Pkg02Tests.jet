    diags :: compile_with_path("", entry.to_string_lossy()).expect_err("version conflict must fail with E1201")
    assert_eq(first_diag_code(diags), "E1201")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:3403
#Test("toolchain_only_lock_keeps_declared_path_unlocked") {
    tmp :: tmp_dir("toolchain_only_lock")
    write(tmp, "greeter/package.jet", min_manifest("greeter", "0.1.0"))
    write(tmp, "greeter/greeter.jet", "pub fn greet() -> String { return \"hi\" }\n")
    manifest_text :: manifest_with_deps("app", "0.1.0", "    greeter: ./greeter,")
    write(tmp, "package.jet", manifest_text)
    write(tmp, ".jet/lock", "version = 1\n\n[[package]]\nname = \"app\"\nsource = { root = \".\" }\n\n[root]\ndependencies = []\n")
    entry :: tmp.join("run.jet")
    fs.write(entry, "fn run() -> {}\n").expect("write entry")
    ordinary :: compile_with_path("", entry.to_string_lossy())
    assert(ordinary.is_ok(), "toolchain-only lock must not block declared path loading: {ordinary.err():?}")
    manifest :: Manifest.parse(tmp.join("package.jet"), manifest_text).expect("parse manifest")
    lock :: Lock.parse(fs.read_to_string(tmp.join(".jet/lock")).expect("read lock")).expect("parse lock")
    locked :: Fetch.FetchOptions(locked: true, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    error :: Fetch.fetch(tmp, manifest, Some(lock), locked).expect_err("strict locked resolution must reject missing dependency facts")
    assert_eq(first_diag_code(error), "E1217")
    _ :: fs.remove_dir_all(tmp)
}

