// Rust: tests/jetpack_engine.rs:3914
#Test("declared_source_package_named_like_provider_resolves_as_package") {
    src :: "\nmodule env.dev {\n    sources: { default: NixOS/nixpkgs/nixos-unstable@github }\n    packages: [default.[cargo]]\n}\n"
    plan :: evaluate_env(src, OSPath.from(env("CARGO_MANIFEST_DIR"))) ?? panic("evaluate")
    assert_eq(plan.package_refs, ["cargo@default"])
    spec :: RefSpec.classify_in(&plan.package_refs[0], &plan.table) ?? panic("classify")
    assert_eq(spec.package, "cargo")
    assert_eq(spec.source, RefSpec.Source.Named("default"))
}

