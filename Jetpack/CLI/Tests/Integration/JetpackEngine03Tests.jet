// Rust: tests/jetpack_engine.rs:4971
#Test("indexed_nixpkgs_closure_reuses_offline_and_repairs_one_object") {
    TEST_NAME :: "indexed_nixpkgs_closure_reuses_offline_and_repairs_one_object"
    PHASE_ENV :: "JETPACK_INDEXED_NIX_PHASE"
    PROJECT_ENV :: "JETPACK_INDEXED_NIX_PROJECT"
    ROOT_ENV :: "JETPACK_INDEXED_NIX_ROOT"
    (project_dir, root_dir, _owned_project, _owned_root, server, child) :: match (env.var_os(PROJECT_ENV).map(path -> OSPath.from(path)), env.var_os(ROOT_ENV).map(path -> OSPath.from(path))) {
        (Val(project_dir), Val(root_dir)) -> (project_dir, root_dir, nil, nil, nil, true)
        (nil, nil) -> {
            project :: Scratch.new("indexed-nixpkgs-project")
            root :: Scratch.new("root")
            project_dir :: project.path.clone()
            root_dir :: root.path.clone()
            server :: nix_index_cache_server.NixIndexCacheServer.start_ripgrep(&project_dir)
            server.install(&root_dir)
            (project_dir, root_dir, Val(project), Val(root), Val(server), false)
        }
        _ -> panic("indexed Nix project/root environment must be configured together")
    }
    if !child {
        // Channel agrees with the signed fixture index key.
        fs.write(project_dir.join("env.jet"), "module dev {{\n    sources: {{ default: NixOS/nixpkgs/{nix_index_cache_server.CHANNEL}@github }}\n    env.dev: Env{{ packages: [default.ripgrep] }}\n}}\n") ?? panic("env")
        fs.create_dir_all(project_dir.join(".jet")) ?? panic("jet dir")
        fs.write(project_dir.join(".jet/lock"), "version = 1\n\n[[source_channel]]\nname = \"default\"\nchannel = \"{nix_index_cache_server.CHANNEL}\"\nexact = \"github:NixOS/nixpkgs#{nix_index_cache_server.REVISION}\"\n\n[root]\ndependencies = []\n") ?? panic("lock")
    }
    run :: |offline: Bool| -> {
        command := jetpack()
        command.args(["env", "--no-color", "--trust"]).current_dir(&project_dir).env("JETPACK_ROOT", &root_dir).env("PATH", "/usr/bin").env("JETPACK_DEBUG_NIX_CACHE", "1").env_remove("JETPACK_FIXTURES")
        if offline -> command.arg("--offline")
        command.args(["--", "rg", "--version"])
        command.output() ?? panic("run")
    }
    if child {
        phase :: env.var(PHASE_ENV) ?? panic("indexed Nix child phase")
        network :: match phase.as_str() {
            "online-initial" | "online-repair" -> no_nix_namespace.NetworkMode.Enabled
            "offline-reuse" | "offline-missing" -> no_nix_namespace.NetworkMode.Disabled
            other -> panic("unknown indexed Nix test phase `{other}`")
        }
        no_nix_namespace.run_in_no_nix_namespace(TEST_NAME, network, || -> {
            output :: run(phase.starts_with("offline-"))
            stdout :: String.from_utf8_lossy(&output.stdout)
            stderr :: String.from_utf8_lossy(&output.stderr)
            match phase.as_str() {
                "online-initial" | "offline-reuse" | "online-repair" -> {
                    assert(output.status.success(), "stdout: {stdout}\nstderr: {stderr}")
                    assert(stdout.contains("ripgrep 15.2.0"), "stdout: {stdout}")
                }
                "offline-missing" -> {
                    assert_eq(output.status.code(), Val(2), "stdout: {stdout}\nstderr: {stderr}")
                    assert(stderr.contains("E1350"), "stderr: {stderr}")
                    assert(stderr.contains(nix_index_cache_server.RUNTIME_PATH), "offline error must name missing reference: {stderr}")
                }
                _ -> panic("unreachable phase")
            }
        })
        return
    }
    env.set_var(PROJECT_ENV, &project_dir)
    env.set_var(ROOT_ENV, &root_dir)
    for (phase, network) in [("online-initial", no_nix_namespace.NetworkMode.Enabled), ("offline-reuse", no_nix_namespace.NetworkMode.Disabled)] {
        env.set_var(PHASE_ENV, phase)
        // Parent callback intentionally empty: the namespace harness re-execs this test.
        no_nix_namespace.run_in_no_nix_namespace(TEST_NAME, network, || -> {})
    }
    env.remove_var(PHASE_ENV)
    roots :: Store.Roots.at(root_dir.clone())
    entries :: Store.list_checked(&roots) ?? panic("list")
    producer :: |entry: &Store.StoreEntry| -> Store.ProducerRecord.decode(&entry.producer_record).unwrap()
    package :: entries.iter().find(entry -> producer(entry).facts.contains_key("nix.index.proof.v1")) ?? panic("indexed Nix package entry")
    package_producer :: producer(package)
    assert(!package_producer.facts["nix.index.proof.v1"].is_empty())
    assert(!package_producer.facts["nix.cache.output.out.proof.sha256"].is_empty())
    assert(!package_producer.facts["nix.cache.closure.receipt.sha256"].is_empty())
    object_digest :: |store_path: &String| -> {
        entry :: entries.iter().find(entry -> producer(entry).facts.get("nix.store-path").map(value -> value.as_str()) == Val(store_path)) ?? panic("missing admitted object {store_path}")
        entry.envelope.output_hash.clone()
    }
    root_digest :: object_digest(nix_index_cache_server.ROOT_PATH)
    library_digest :: object_digest(nix_index_cache_server.LIB_PATH)
    runtime_digest :: object_digest(nix_index_cache_server.RUNTIME_PATH)
    graph :: Store.closure_graph(&roots) ?? panic("graph")
    assert_eq(package.envelope.output_hash, root_digest)
    assert_eq(package.references, [library_digest.clone()])
    assert_eq(graph.direct_references(&root_digest), [library_digest.clone()])
    assert_eq(graph.direct_references(&library_digest), [runtime_digest.clone()])
    assert(graph.transitive_references(&root_digest).contains(&runtime_digest))
    missing :: roots.hangar_dir().join("objects").join(&runtime_digest)
    make_tree_writable(&missing)
    fs.remove_dir_all(&missing) ?? panic("remove runtime")
    env.set_var(PHASE_ENV, "offline-missing")
    no_nix_namespace.run_in_no_nix_namespace(TEST_NAME, no_nix_namespace.NetworkMode.Disabled, || -> {})
    env.remove_var(PHASE_ENV)
    env.set_var(PHASE_ENV, "online-repair")
    no_nix_namespace.run_in_no_nix_namespace(TEST_NAME, no_nix_namespace.NetworkMode.Enabled, || -> {})
    env.remove_var(PHASE_ENV)
    env.remove_var(PROJECT_ENV)
    env.remove_var(ROOT_ENV)
    owned_server :: server.as_ref() ?? panic("parent owns indexed Nix server")
    assert_eq(owned_server.object_request_count(nix_index_cache_server.ROOT_PATH), 2, "repair must reuse root object")
    assert_eq(owned_server.object_request_count(nix_index_cache_server.LIB_PATH), 2, "repair must reuse library object")
    assert_eq(owned_server.object_request_count(nix_index_cache_server.RUNTIME_PATH), 4, "repair must fetch only missing runtime object")
}

// Rust: tests/jetpack_engine.rs:5170
#Test("package_and_environment_paths_have_no_installed_nix_shellout") {
    sources :: [
        ("Bridge", include_str("Jetpack/Provider/Source/Bridge/FlakeBridge.jet")),
        ("Bridge/FlakeImport", include_str("Jetpack/Provider/Source/Bridge/FlakeImport.jet")),
        ("Provider", include_str("Jetpack/Provider/Source/Core/ProviderDispatch.jet")),
        ("Provider/Core", include_str("Jetpack/Provider/Source/Core/CorePackageProvider.jet")),
        ("Provider/Nix", include_str("Jetpack/Provider/Source/Nix/NixRealization.jet")),
        ("NixIndex", include_str("Jetpack/Nix/Source/Index/IndexClient.jet")),
        ("NixIndex/Wire", include_str("Jetpack/Nix/Source/Index/IndexWire.jet")),
        ("Store/NixCache", include_str("Jetpack/Store/Source/NixCache/NixCacheTransport.jet")),
        ("Store/NixClosure", include_str("Jetpack/Store/Source/NixCache/NixClosureAdmission.jet")),
        ("Store/NixDownload", include_str("Jetpack/Store/Source/NixCache/NixDownloadPlan.jet")),
        ("CLI/realize", include_str("Jetpack/CLI/Source/Realize/RealizeRefs.jet")),
        ("CLI/realize/Project", include_str("Jetpack/CLI/Source/Realize/ProjectPlan.jet")),
        ("CLI/run_enter_dev", include_str("Jetpack/CLI/Source/Env/UseCommand.jet")),
        ("CLI/run_enter_dev/Env", include_str("Jetpack/CLI/Source/Env/EnvCommand.jet")),
        ("CLI/run_enter_dev/Compose", include_str("Jetpack/CLI/Source/Env/ComposeEnv.jet")),
        ("CLI/profile", include_str("Jetpack/CLI/Source/Profile/ProfileCommand.jet")),
        ("CLI/profile/Build", include_str("Jetpack/CLI/Source/Profile/ProfileGenerationBuild.jet")),
        ("CLI/tool", include_str("Jetpack/CLI/Source/Tools/ToolCommand.jet")),
        ("CLI/tool/Profile", include_str("Jetpack/CLI/Source/Tools/ToolProfile.jet")),
        ("CLI/trust_env_build", include_str("Jetpack/CLI/Source/Build.jet")),
        ("CLI/trust_env_build/Trust", include_str("Jetpack/CLI/Source/Commands/TrustCommand.jet")),
        ("Store", include_str("Jetpack/Store/Source/Hangar/RealizeVerified.jet")),
        ("Store/Admission", include_str("Jetpack/Store/Source/Hangar/AdmissionTransaction.jet")),
        ("Store/Listing", include_str("Jetpack/Store/Source/Hangar/HangarListing.jet"))
    ]
    for (path, source) in sources {
        for forbidden in ["Command.new(\"nix\")", "Command.new(\"nix-store\")", "Command.new(\"curl\")", "Command.new(\"wget\")"] {
            assert(!source.contains(forbidden), "{path} must not shell out to installed Nix via {forbidden}")
        }
    }
}

// Rust: tests/jetpack_engine.rs:5223
#Test("no_nix_ad_hoc_package_reports_e1272") {
    proj :: Scratch.new("proj")
    root :: Scratch.new("root")
    output :: jetpack().args(["env", "-p", "postgres", "--no-color", "--trust", "--", "true"]).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).env("PATH", "").output() ?? panic("env")
    assert_eq(output.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert(stderr.contains("E1272"), "stderr: {stderr}")
    assert(stderr.contains("postgres@nixpkgs"), "stderr: {stderr}")
    assert(!stderr.contains("couldn't run `nix`"), "stderr: {stderr}")
}

// Rust: tests/jetpack_engine.rs:5249
#Test("no_nix_mixed_env_realizes_core_then_reports_nix_hole") {
    (base, proj, root) :: core_hello_project("no-nix-mixed")
    fs.write(proj.join("env.jet"), (fs.read_to_string(proj.join("env.jet")) ?? panic("env")).replace("pkg.packages([\"hello@mine\"])", "pkg.packages([\"hello@mine\", \"postgres@nixpkgs\"])")) ?? panic("mixed env")
    output :: jetpack().args(["build", "--no-color"]).current_dir(&proj).env("JETPACK_ROOT", &root).env("HOME", base.join("home")).env("PATH", "").output() ?? panic("build")
    assert_eq(output.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert(stderr.lines().any(line -> line.contains("hello") && line.split_whitespace().any(word -> word == "built")), "stderr: {stderr}")
    assert(stderr.contains("E1272"), "stderr: {stderr}")
    assert(stderr.contains("postgres@nixpkgs"), "stderr: {stderr}")
    metas :: (fs.read_dir(root.join("hangar")) ?? panic("hangar")).flatten().filter_map(entry -> fs.read_to_string(entry.path().join("meta.json")).ok()).collect().join("\n")
    assert(metas.contains("\"name\": \"hello\""), "metas: {metas}")
}

// Rust: tests/jetpack_engine.rs:5288
#Test("no_nix_json_lists_realized_refs_and_holes") {
    (base, proj, root) :: core_hello_project("no-nix-json")
    fs.write(proj.join("env.jet"), (fs.read_to_string(proj.join("env.jet")) ?? panic("env")).replace("pkg.packages([\"hello@mine\"])", "pkg.packages([\"hello@mine\", \"postgres@nixpkgs\"])")) ?? panic("mixed env")
    output :: jetpack().args(["build", "--no-color", "--json"]).current_dir(&proj).env("JETPACK_ROOT", &root).env("HOME", base.join("home")).env("PATH", "").output() ?? panic("build")
    assert_eq(output.status.code(), Val(2))
    stdout :: String.from_utf8_lossy(&output.stdout)
    assert(stdout.contains("\"code\":\"E1272\""), "stdout: {stdout}")
    assert(stdout.contains("\"realized\":[\"hello@mine\"]"), "stdout: {stdout}")
    assert(stdout.contains("\"holes\":[\"postgres@nixpkgs\"]"), "stdout: {stdout}")
}

// Rust: tests/jetpack_engine.rs:5320
#Test("typed_env_bad_adapter_is_e1270") {
    proj :: Scratch.new("proj")
    root :: Scratch.new("root")
    fs.write(proj.join("env.jet"), "\nmodule dev {\n    env.dev: Env{\n        packages: [\n            Pkg.adapt(\n                name: \"broken\",\n                source: \"./vendor/broken\",\n                recipe: Recipe.build()\n            )\n        ],\n    }\n}\n") ?? panic("env")
    output :: jetpack().args(["build", "--no-color"]).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).output() ?? panic("build")
    assert_eq(output.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert(stderr.contains("E1270"), "stderr: {stderr}")
}

// Rust: tests/jetpack_engine.rs:5352
#Test("channel_update_writes_exact_lock_and_build_uses_it_offline") {
    proj :: Scratch.new("proj")
    root :: Scratch.new("root")
    fixtures :: Scratch.new("fx")
    fs.write(proj.join("env.jet"), "\nmodule dev {\n    sources: { default: acme/tools@github#latest }\n    env.dev: Env{ packages: [default.greet] }\n}\n") ?? panic("env")
    write_channel_fixture(&fixtures.path, "github:acme/tools", "latest", "github:acme/tools#v1.2.0")
    fs.write(fixtures.join("default-greet.json"), "[{\"drvPath\":\"/nix/store/0000000000000000000000000000000b-greet-1.2.0.drv\",\"outputs\":{\"out\":\"/nix/store/0000000000000000000000000000000a-greet-1.2.0\"}}]") ?? panic("fixture")
    update :: jetpack().args(["update", "--no-color", "--yes", "--fixtures"]).arg(&fixtures.path).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).output() ?? panic("update")
    assert(update.status.success(), "stderr: {String.from_utf8_lossy(&update.stderr)}")
    assert(String.from_utf8_lossy(&update.stderr).contains("Download 240 MB"), "stderr: {String.from_utf8_lossy(&update.stderr)}")
    lock :: fs.read_to_string(proj.join(".jet/lock")) ?? panic("lock")
    assert(lock.contains("[[source_channel]]"), "lock: {lock}")
    assert(lock.contains("channel = \"latest\""), "lock: {lock}")
    assert(lock.contains("exact = \"github:acme/tools#v1.2.0\""), "lock: {lock}")
    build :: jetpack().args(["build", "--no-color", "--offline"]).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).env("JETPACK_FIXTURES", realized_fixtures(&fixtures.path, &root.path)).output() ?? panic("build")
    assert(build.status.success(), "stderr: {String.from_utf8_lossy(&build.stderr)}")
}
