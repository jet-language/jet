// Rust: tests/jetpack_engine.rs:3960
#Test("add_then_remove_edits_env_file") {
    (_base, proj, root) :: core_hello_project("add-remove")
    env_path :: proj.join("env.jet")
    fs.write(&env_path, (fs.read_to_string(&env_path) ?? panic("env")).replace("\"hello@mine\"", "")) ?? panic("clear package")
    add :: jetpack().args(["add", "hello@mine", "--no-color"]).current_dir(&proj).env("JETPACK_ROOT", &root).output() ?? panic("add")
    assert(add.status.success(), "stderr: {String.from_utf8_lossy(&add.stderr)}")
    assert(String.from_utf8_lossy(&add.stderr).contains("✓ hello     0.1.0"), "add must print its verified resolved version: {String.from_utf8_lossy(&add.stderr)}")
    added_env :: fs.read_to_string(proj.join("env.jet")) ?? panic("env")
    assert(added_env.contains("hello"), "env.jet: {added_env}")
    assert(added_env.contains("pkg.packages"), "env.jet: {added_env}")
    remove :: jetpack().args(["remove", "hello@mine", "--no-color", "--yes"]).current_dir(&proj).env("JETPACK_ROOT", &root).output() ?? panic("remove")
    assert(remove.status.success())
    removed_env :: fs.read_to_string(proj.join("env.jet")) ?? panic("env")
    assert(!removed_env.contains("\"hello@mine\""), "env.jet still has hello: {removed_env}")
}

// Rust: tests/jetpack_engine.rs:4005
#Test("remove_without_yes_prints_plan_and_keeps_env_file_in_non_tty") {
    (_base, proj, root) :: core_hello_project("remove-plan")
    env_path :: proj.join("env.jet")
    fs.write(&env_path, (fs.read_to_string(&env_path) ?? panic("env")).replace("\"hello@mine\"", "")) ?? panic("clear package")
    add :: jetpack().args(["add", "hello@mine", "--no-color"]).current_dir(&proj).env("JETPACK_ROOT", &root).output() ?? panic("add")
    assert(add.status.success())
    remove :: jetpack().args(["remove", "hello@mine", "--no-color"]).current_dir(&proj).env("JETPACK_ROOT", &root).output() ?? panic("remove")
    assert(remove.status.success())
    unchanged :: fs.read_to_string(proj.join("env.jet")) ?? panic("env")
    assert(unchanged.contains("\"hello@mine\""), "env.jet was changed: {unchanged}")
    stderr :: String.from_utf8_lossy(&remove.stderr)
    assert(stderr.contains("Plan env edit"), "stderr: {stderr}")
    assert(stderr.contains("- hello"), "stderr: {stderr}")
    assert(stderr.contains("Download 0 B"), "stderr: {stderr}")
    assert(stderr.contains("-y or --yes"), "stderr: {stderr}")
}

// Rust: tests/jetpack_engine.rs:4040
#Test("remove_with_short_yes_applies_identically_to_long_yes") {
    // D-FE-CLI1: -y and --yes bypass the mutation gate identically.
    (_base, proj, root) :: core_hello_project("remove-short-yes")
    env_path :: proj.join("env.jet")
    fs.write(&env_path, (fs.read_to_string(&env_path) ?? panic("env")).replace("\"hello@mine\"", "")) ?? panic("clear package")
    add :: jetpack().args(["add", "hello@mine", "--no-color"]).current_dir(&proj).env("JETPACK_ROOT", &root).output() ?? panic("add")
    assert(add.status.success(), "stderr: {String.from_utf8_lossy(&add.stderr)}")
    remove :: jetpack().args(["remove", "hello@mine", "--no-color", "-y"]).current_dir(&proj).env("JETPACK_ROOT", &root).output() ?? panic("remove")
    assert(remove.status.success(), "stderr: {String.from_utf8_lossy(&remove.stderr)}")
    removed_env :: fs.read_to_string(proj.join("env.jet")) ?? panic("env")
    assert(!removed_env.contains("\"hello@mine\""), "short -y must apply the remove plan: {removed_env}")
    stderr :: String.from_utf8_lossy(&remove.stderr)
    assert(stderr.contains("Plan env edit"), "stderr: {stderr}")
    assert(stderr.contains("- hello"), "stderr: {stderr}")
    assert(stderr.contains("applying plan (--yes)") || stderr.contains("removed"), "short -y must take the yes-bypass path: {stderr}")
}

