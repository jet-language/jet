    project :: Scratch.new("unindexed-nixpkgs-project")
    root :: Scratch.new("root")
    server :: nix_index_cache_server.NixIndexCacheServer.start_unindexed(&project.path)
    server.install(&root.path)
    fs.create_dir_all(project.join(".jet")) ?? panic("jet dir")
    fs.write(project.join(".jet/lock"), "version = 1\n\n[[source_channel]]\nname = \"nixpkgs\"\nchannel = \"nixpkgs-unstable\"\nexact = \"github:NixOS/nixpkgs#{nix_index_cache_server.REVISION}\"\n\n[root]\ndependencies = []\n") ?? panic("lock")
