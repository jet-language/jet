// Rust: tests/jetpack_engine.rs:4441
#Test("typed_env_build_hook_approval_binds_declared_dependency_refs") {
    proj :: Scratch.new("build-hook-dependency-identity-project")
    root :: Scratch.new("build-hook-dependency-identity-root")
    fixtures :: Scratch.new("build-hook-dependency-identity-fixtures")
    home :: Scratch.new("build-hook-dependency-identity-home")
    staging :: Scratch.new("build-hook-dependency-identity-staging")
    write_runnable_fixture(&fixtures.path, &root.path, &staging.path)
    // Same executable, different declared ref: trust/cache identity must include deps.
    fs.copy(fixtures.join("nixpkgs-greet.json"), fixtures.join("nixpkgs-hello.json")) ?? panic("copy fixture")
    fs.create_dir_all(proj.join("vendor/tool")) ?? panic("vendor dir")
    fs.write(proj.join("env.jet"), "\nmodule dev {\n    env.dev: Env{\n        packages: [\n            Pkg.adapt(\n                name: \"tool\",\n                source: \"./vendor/tool\",\n                deps: [default.greet],\n                recipe: Recipe.build(steps: [\n                    .exec(tool: \"greet\", args: []),\n                ])\n            )\n        ],\n    }\n}\n") ?? panic("env")
    first :: jetpack().args(["build", "--no-color", "--offline", "--trust"]).current_dir(&proj.path).env("HOME", &home.path).env("JETPACK_ROOT", &root.path).env("JETPACK_FIXTURES", &fixtures.path).output() ?? panic("build")
    assert(first.status.success(), "initial build failed: {String.from_utf8_lossy(&first.stderr)}")
    roots :: Store.Roots{root: root.path.clone(), dev_mode: false}
    entry :: Store.list(&roots).into_iter().find(entry -> entry.reference == "adapt:tool:./vendor/tool") ?? panic("initial adapter should be recorded")
    decoded :: Store.ProducerRecord.decode(&entry.producer_record) ?? panic("adapter producer record should decode")
    old_identity :: (decoded.facts.get("build.identity") ?? panic("adapter producer should record its build identity")).clone()
    selector :: "build:{old_identity}"
    grant :: jetpack().args(["trust", "grant", &selector, "--scope", "user"]).env("HOME", &home.path).output() ?? panic("grant")
    assert(grant.status.success(), "build identity trust setup failed: {String.from_utf8_lossy(&grant.stderr)}")
    changed :: (fs.read_to_string(proj.join("env.jet")) ?? panic("env")).replace("default.greet", "default.hello")
    fs.write(proj.join("env.jet"), changed) ?? panic("change deps")
    second :: jetpack().args(["build", "--no-color", "--offline"]).current_dir(&proj.path).env("HOME", &home.path).env("JETPACK_ROOT", &root.path).env("JETPACK_FIXTURES", &fixtures.path).output() ?? panic("build changed deps")
    stderr :: String.from_utf8_lossy(&second.stderr)
    assert_eq(second.status.code(), Val(1), "stderr: {stderr}")
    assert(stderr.contains("E1255"), "changed dependency was accepted: {stderr}")
    assert(stderr.contains("build hook"), "wrong trust failure: {stderr}")
}

