// Rust: tests/jetpack_engine.rs:3633
#Test("use_rejects_unrecorded_path_inside_lease") {
    root :: Scratch.new("lease-caller-confinement-root")
    fixtures :: Scratch.new("lease-caller-confinement-fixtures")
    write_native_lease_fixture(&fixtures.path)
    prime :: jetpack().args(["use", "omp@releases#1.0.0", "-y", "--no-color", "--offline", "--fixtures"]).arg(&fixtures.path).args(["--", "sh", "-c", "true"]).env("JETPACK_ROOT", &root.path).env("JETPACK_FIXTURES", &fixtures.path).output() ?? panic("prime")
    assert(prime.status.success(), "lease setup failed: {String.from_utf8_lossy(&prime.stderr)}")
    entry :: Store.find_by_reference(&Store.Roots.at(root.path.clone()), "omp@releases#1.0.0") ?? panic("find entry")
    // Valid after OS normalization, but not a recorded member spelling.
    unrecorded :: OSPath.from(entry.out).join("bin/../bin/omp")
    output :: jetpack().args(["use", "omp@releases#1.0.0", "-y", "--no-color", "--offline", "--fixtures"]).arg(&fixtures.path).args(["--", unrecorded.to_str().unwrap()]).env("JETPACK_ROOT", &root.path).env("JETPACK_FIXTURES", &fixtures.path).output() ?? panic("use")
    assert_eq(output.status.code(), Val(126), "unrecorded lease path must fail before child launch: {String.from_utf8_lossy(&output.stderr)}")
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert(stderr.contains("Error [E1340]:"), "stderr: {stderr}")
    assert(stderr.contains("not a recorded member"), "stderr: {stderr}")
    assert(!String.from_utf8_lossy(&output.stdout).contains("hello from jetpack"))
    // GATE #4483: original Unix symlink arm.
    if sys.target.selected_family() == "unix" {
        alias :: root.path.join("lease-output-alias")
        fs.symlink(OSPath.from(entry.out).join("bin"), &alias) ?? panic("symlink")
        aliased :: alias.join("omp")
        aliased_output :: jetpack().args(["use", "omp@releases#1.0.0", "-y", "--no-color", "--offline", "--fixtures"]).arg(&fixtures.path).args(["--", aliased.to_str().unwrap()]).env("JETPACK_ROOT", &root.path).env("JETPACK_FIXTURES", &fixtures.path).output() ?? panic("aliased use")
        assert_eq(aliased_output.status.code(), Val(126), "symlink alias into a lease must fail before child launch: {String.from_utf8_lossy(&aliased_output.stderr)}")
        assert(String.from_utf8_lossy(&aliased_output.stderr).contains("not a recorded member"), "stderr: {String.from_utf8_lossy(&aliased_output.stderr)}")
        assert(!String.from_utf8_lossy(&aliased_output.stdout).contains("hello from jetpack"))
    }
}

// Rust: tests/jetpack_engine.rs:3739
#Test("use_fails_closed_when_executable_lease_service_key_is_invalid") {
    root :: Scratch.new("invalid-executable-lease-key-root")
    fixtures :: Scratch.new("invalid-executable-lease-key-fixtures")
    write_native_lease_fixture(&fixtures.path)
    service :: root.path.join("lease-service")
    fs.create_dir_all(&service) ?? panic("service dir")
    fs.write(service.join("auth.key"), [U8; 31].filled(0)) ?? panic("invalid key")
    output :: jetpack().args(["use", "omp@releases#1.0.0", "-y", "--no-color", "--offline", "--fixtures"]).arg(&fixtures.path).args(["--", "omp"]).env("JETPACK_ROOT", &root.path).env("JETPACK_FIXTURES", &fixtures.path).output() ?? panic("use")
    assert(!output.status.success())
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert(stderr.contains("Error [E1315]:"), "stderr: {stderr}")
    assert(stderr.contains("32-byte file"), "stderr: {stderr}")
    assert(!String.from_utf8_lossy(&output.stdout).contains("hello from jetpack"))
    assert(fs.read_dir(root.path.join("leases")).map(entries -> entries.flatten().next().is_none()).unwrap_or(true), "failed lease setup left an executable container")
    offset :: stderr.find("Error [E1315]:") ?? panic("lease failure diagnostic")
    diagnostic := stderr[offset..] // #4303
    assert_jetos_stderr_snapshot_trimmed("executable_lease_service_key_invalid", diagnostic)
}

// Rust: tests/jetpack_engine.rs:3791
#Test("executable_lease_process_tree_recovery_uses_store_production_path") {
    if sys.target.selected_family() == "unix" {
        root :: Scratch.new("lease-process-tree-root")
        fixtures :: Scratch.new("lease-process-tree-fixtures")
        out_dir :: Scratch.new("lease-process-tree-output")
        ready :: root.path.join("descendant-ready")
        release :: root.path.join("descendant-release")
        write_native_jetpack_fixture(&fixtures.path, &root.path, &out_dir.path)
        run :: jetpack().args(["use", "omp@releases#1.0.0", "-y", "--no-color", "--offline", "--fixtures"]).arg(&fixtures.path).args(["--", "/bin/sh", "-c", "printf ready > \"$LEASE_READY\"; while [ ! -f \"$LEASE_RELEASE\" ]; do /bin/sleep 0.01; done >/dev/null 2>&1 </dev/null &"]).env("JETPACK_ROOT", &root.path).env("JETPACK_FIXTURES", &fixtures.path).env("LEASE_READY", &ready).env("LEASE_RELEASE", &release).output() ?? panic("use")
        assert(run.status.success(), "stderr: {String.from_utf8_lossy(&run.stderr)}")
        assert(ready.exists(), "descendant did not start before parent exit")
        leases :: root.path.join("leases")
        lease :: ((fs.read_dir(&leases) ?? panic("leases")).next() ?? panic("lease entry")).unwrap().path()
        recover_while_child_runs :: jetpack().args(["hangar", "recover", "--no-color"]).env("JETPACK_ROOT", &root.path).output() ?? panic("recover")
        assert(recover_while_child_runs.status.success(), "stderr: {String.from_utf8_lossy(&recover_while_child_runs.stderr)}")
        assert(lease.exists(), "live descendant lease was reclaimed early")
        fs.write(&release, "release") ?? panic("release")
        deadline :: Instant.now() + Duration.from_secs(5)
        while lease.exists() {
            assert(Instant.now() < deadline, "idle descendant lease was not reclaimed")
            recover_after_child_exit :: jetpack().args(["hangar", "recover", "--no-color"]).env("JETPACK_ROOT", &root.path).output() ?? panic("recover")
            assert(recover_after_child_exit.status.success(), "stderr: {String.from_utf8_lossy(&recover_after_child_exit.stderr)}")
            thread.sleep(Duration.from_millis(10))
        }
    }
}

