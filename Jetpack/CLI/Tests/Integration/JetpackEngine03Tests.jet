// Rust: tests/jetpack_engine.rs:4265
#Test("typed_env_copy_adapter_realizes_local_source") {
    proj :: Scratch.new("proj")
    root :: Scratch.new("root")
    vendor :: proj.join("vendor/tool")
    fs.create_dir_all(vendor.join("share")) ?? panic("share dir")
    fs.write(vendor.join("share/readme.txt"), "adapted\n") ?? panic("readme")
    fs.write(proj.join("env.jet"), "\nmodule dev {\n    env.dev: Env{\n        packages: [\n            Pkg.adapt(\n                name: \"tool\",\n                source: \"./vendor/tool\",\n                recipe: Recipe.copy()\n            )\n        ],\n    }\n}\n") ?? panic("env")
    output :: jetpack().args(["build", "--no-color"]).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).output() ?? panic("build")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(&output.stderr)}")
    roots :: Store.Roots{root: root.path.clone(), dev_mode: false}
    entries :: Store.list_checked(&roots) ?? panic("portfolio Hangar listing failed under {roots.hangar_dir().display()}")
    assert(entries.iter().any(entry -> fs.read_to_string(OSPath.from(entry.out).join("share/readme.txt")).unwrap_or_default() == "adapted\n"), "adapter output missing copied file: {entries:?}")
    cached :: jetpack().args(["build", "--no-color"]).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).output() ?? panic("cached build")
    assert(cached.status.success(), "stderr: {String.from_utf8_lossy(&cached.stderr)}")
    assert(String.from_utf8_lossy(&cached.stderr).contains("1 cached"), "stderr: {String.from_utf8_lossy(&cached.stderr)}")
}

