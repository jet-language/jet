// Rust: tests/jetpack_engine.rs:4147
#Test("typed_environment_without_packages_or_secrets_requires_trust") {
    project :: Scratch.new("typed-trust-gate")
    root :: Scratch.new("typed-trust-gate-root")
    home :: Scratch.new("typed-trust-gate-home")
    fs.write(project.join("env.jet"), "module env.dev {\n    services: {\n        hostile: { enable: false, run: [\"sh\", \"-c\", \"touch escaped\"] }\n    }\n}\n") ?? panic("env")
    output :: jetpack().args(["env", "--no-color", "--offline", "--", "true"]).current_dir(&project.path).env("HOME", &home.path).env("JETPACK_ROOT", &root.path).output() ?? panic("env")
    assert_eq(output.status.code(), Val(2), "typed environment must not run before trust: {String.from_utf8_lossy(&output.stderr)}")
    stderr :: String.from_utf8_lossy(&output.stderr)
    assert(stderr.contains("E1255"), "missing trust diagnostic: {stderr}")
    assert(!project.join("escaped").exists(), "untrusted typed environment executed a hostile command")
    run_output :: jetpack().args(["run", "--no-color", "--offline", "--", "true"]).current_dir(&project.path).env("HOME", &home.path).env("JETPACK_ROOT", &root.path).output() ?? panic("run")
    assert_eq(run_output.status.code(), Val(2), "jet run must not realize an untrusted typed environment: {String.from_utf8_lossy(&run_output.stderr)}")
    run_stderr :: String.from_utf8_lossy(&run_output.stderr)
    assert(run_stderr.contains("E1255"), "jet run skipped the typed-environment trust gate: {run_stderr}")
    assert(!project.join("escaped").exists(), "jet run executed a hostile typed environment before trust")
}

