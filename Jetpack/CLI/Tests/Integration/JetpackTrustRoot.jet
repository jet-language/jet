// Rust: tests/jetpack_truth.rs:125
pub fn collect_direct_provider_calls(dir: &OSPath, found: &[String]) -> {
    for entry in fs.read_dir(dir).unwrap().flatten() {
        path :: entry.path()
        if path.is_dir() {
            collect_direct_provider_calls(&path, &found)
        } else if path.extension().and_then((ext) -> ext.to_str()) == Some("rs") {
            source :: fs.read_to_string(&path).unwrap()
            if source.contains("Provider::realize(") || source.contains("Provider::realize_adapter(") {
                found.push(path.strip_prefix(OSPath.new(env!("CARGO_MANIFEST_DIR"))).unwrap().to_string_lossy().into_owned())
            }
        }
    }
    found.sort()
    found.dedup()
}

// Rust: tests/jetpack_truth.rs:148
pub fn live_repo_root(root: &OSPath) -> OSPath {
    output :: Command.new("git").args(["rev-parse", "--path-format=absolute", "--git-common-dir"])
        .current_dir(root).output().unwrap()
    assert(output.status.success(), "cannot locate live Git common dir")
    text :: String.from_utf8(output.stdout).unwrap()
    trimmed := text.trim() // #4303
    common :: OSPath.from(trimmed)
    common.parent().unwrap().to_path_buf()
}

// Rust: tests/jetpack_truth.rs:159
pub fn evidence_resolves(root: &OSPath, evidence: &String) -> Bool {
    paths :: evidence.split('`').enumerate().filter_map((pair) -> {
        (index, token) :: pair
        if index % 2 == 1 { Some(token) } else { None }
    }).collect()
    !paths.is_empty() && paths.iter().all((path) -> root.join(path).exists())
}

// Rust: tests/jetpack_truth.rs:168
pub fn matrix_rows(raw: &String) -> [U64: (String, String, String)] {
    rows: [U64: (String, String, String)] := [:]
    for line in raw.lines().filter((line) -> line.starts_with("| #")) {
        cells :: line.trim_matches('|').split('|').map((cell) -> cell.trim().to_string()).collect()
        assert_eq(cells.len(), 4, "malformed truth row: {line}")
        num :: cells[0].trim_start_matches('#').parse[U64]().unwrap()
        assert(rows.insert(num, (cells[1].to_string(), cells[2].to_string(), cells[3].to_string())).is_none(),
            "duplicate truth row for #{num}")
    }
    rows
}

// Rust: tests/jetpack_truth.rs:194
pub struct CardState {
    epoch: String,
    phase: String,
    log_empty: Bool,
}

// Rust: tests/jetpack_truth.rs:200
pub fn tower_cards(root: &OSPath) -> [U64: CardState] {
    // #461: retired cards remain in history; live projection alone is insufficient.
    cards: [U64: CardState] := [:]
    live :: Command.new("node").args(["Tools/tower/tower.mjs", "card", "list", "--json"])
        .current_dir(root).output().unwrap()
    assert(live.status.success(), "Tower projection failed: {String.from_utf8_lossy(live.stderr)}")
    live_json :: JSON.parse(&String.from_utf8(live.stdout).unwrap()).unwrap()
    for card in live_json.as_array().unwrap() {
        ingest_tower_card(&cards, card, false)
    }
    match fs.read_to_string(root.join(".tower/history.json")) {
        Ok(raw) -> {
            hist :: JSON.parse(&raw).unwrap()
            match hist.get("cards").and_then((v) -> v.as_array()) {
                Ok(arr) -> { for card in arr { ingest_tower_card(&cards, card, true) } }
                Err(_) -> {}
            }
        }
        Err(_) -> {}
    }
    cards
}

// Rust: tests/jetpack_truth.rs:230
pub fn ingest_tower_card(cards: &[U64: CardState], card: &DataTree, prefer_existing: Bool) -> {
    num :: match card.get("num").unwrap() {
        DataTree.Int(value) -> value as U64
        DataTree.Float(value) -> value as U64
        DataTree.Number(value) -> value.parse[F64]().expect("card num is not numeric") as U64
        other -> panic("card num is not numeric: {other:?}")
    }
    if prefer_existing && cards.contains_key(&num) { return }
    log_empty :: match card.get("log") {
        Ok(log) -> log.as_array().map((a) -> a.is_empty()).unwrap_or(true)
        Err(_) -> true
    }
    epoch :: card.get("epoch").ok().and_then((v) -> v.as_str().ok()).unwrap_or("").to_string()
    phase :: card.get("phase").ok().and_then((v) -> v.as_str().ok()).unwrap_or("").to_string()
    _ :: cards.insert(num, CardState { epoch: epoch, phase: phase, log_empty: log_empty })
}

// Rust: tests/jetpack_truth.rs:274
pub fn card_refs(text: &String) -> [U64] {
    bytes :: text.as_bytes()
    refs: [U64] := []
    index := 0
    while index < bytes.len() {
        if bytes[index] == b'#' {
            start :: index + 1
            end := start
            while end < bytes.len() && bytes[end].is_ascii_digit() { end += 1 }
            if end > start {
                refs.push(text[start..end].parse[U64]().unwrap())
                index = end
                continue
            }
        }
        index += 1
    }
    refs
}
