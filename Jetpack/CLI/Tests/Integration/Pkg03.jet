use std.[fs, env]
use core.sys.target.selected_family
use jet.[Manifest, Fetch, Publish]
use jetpack_cli.Tests.Integration.Pkg.[tmp_dir, write, manifest_with_deps, with_store, first_diag_code]

// Rust: tests/pkg.rs:4833
// GATE #4494: real executable rejection sentinel, native environment and permissions.
pub fn assert_option_git_url_rejected_before_execution(selector: String, label: String) -> {
    if selected_family() != "unix" { return }
    tmp :: tmp_dir(label)
    fake_bin :: tmp.join("bin")
    marker :: tmp.join("git-url-invoked")
    fs.create_dir_all(fake_bin).unwrap()
    fake_git :: fake_bin.join("git")
    fs.write(fake_git, r#"#!/bin/sh
touch "$JET_TEST_GIT_INVOKED"
exit 99
"#).unwrap()
    fs.set_permissions(fake_git, fs.Permissions.from_mode(0o755)).unwrap()
    raw :: manifest_with_deps("app", "0.1.0", "    hostile: {{ git: \"--upload-pack=touch\", {selector} }},")
    write(tmp, "package.jet", raw)
    manifest :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    store :: tmp.join("store")
    fs.create_dir_all(store).unwrap()
    options :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    path_entries := [fake_bin]
    if path :: env.var_os("PATH") { &path_entries.extend(env.split_paths(path)) }
    fake_path :: env.join_paths(path_entries).unwrap()
    previous_path :: env.var_os("PATH")
    previous_invoked :: env.var_os("JET_TEST_GIT_INVOKED")
    result :: with_store(store, () -> {
        env.set_var("PATH", fake_path)
        env.set_var("JET_TEST_GIT_INVOKED", marker)
        result :: Fetch.fetch(tmp, manifest, None, options)
        match previous_path {
            Some(value) -> env.set_var("PATH", value)
            None -> env.remove_var("PATH")
        }
        match previous_invoked {
            Some(value) -> env.set_var("JET_TEST_GIT_INVOKED", value)
            None -> env.remove_var("JET_TEST_GIT_INVOKED")
        }
        result
    })
    diagnostics :: result.expect_err("leading-option Git URL must be rejected before Git runs")
    assert_eq(first_diag_code(diagnostics), "E1203")
    assert(!marker.exists(), "leading-option Git URL reached the Git process")
    assert(!tmp.join(".jet").exists())
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:5151
// Extract the first rev from a locked inline table.
pub fn extract_rev_from_lock(lock_raw: String) -> String {
    loop line in lock_raw.lines() {
        if !line.contains("rev = \"") { continue }
        if after :: line.find("rev = \"") {
            rest := line[after + 7..] // #4303: retain byte offset after ASCII prefix.
            if end :: rest.find('"') { return rest[..end].to_string() }
        }
    }
    String.new()
}
