// E4-JP1 Hangar Store v2 — native integration test helpers.
use std.fs
use core.files.OSPath
use core.sys.target
use jetpack.Store

// Rust: tests/jetpack_hangar_store_v2.rs:263
pub fn physical_files(paths: [OSPath]) -> (USize, U64) {
    // GATE #4499: exact device/inode tuple identity, never path/string surrogate.
    files := [(U64, U64):U64]{}
    loop path in paths { walk(path, &files) }
    (files.len(), files.values().sum())
}

// Rust: tests/jetpack_hangar_store_v2.rs:264
fn walk(path: OSPath, files: &[(U64, U64):U64]) -> {
    // GATE #4494: native device, inode, allocated-block metadata.
    metadata :: fs.symlink_metadata(path).unwrap()
    if metadata.file_type().is_symlink() { return }
    if metadata.is_file() {
        &files.insert((metadata.dev(), metadata.ino()), metadata.blocks().saturating_mul(512))
        return
    }
    loop entry in fs.read_dir(path).unwrap() { walk(entry.unwrap().path(), &files) }
}

// Rust: tests/jetpack_hangar_store_v2.rs:1281
// Rust: tests/jetpack_hangar_store_v2.rs:1296
pub fn seal_tree(path: OSPath) -> {
    // GATE #4483: preserve both selected-target permission arms.
    metadata :: if target.selected_family() == "unix" -> fs.symlink_metadata(path).unwrap() else -> fs.metadata(path).unwrap()
    if metadata.is_dir() { loop child in fs.read_dir(path).unwrap() { seal_tree(child.unwrap().path()) } }
    permissions := metadata.permissions()
    if target.selected_family() == "unix" { &permissions.set_mode(permissions.mode() & !0o222) }
    else { &permissions.set_readonly(true) }
    fs.set_permissions(path, permissions).unwrap()
}

// Rust: tests/jetpack_hangar_store_v2.rs:1715
pub fn logical_bytes(path: OSPath) -> U64 {
    metadata :: fs.symlink_metadata(path).unwrap()
    if metadata.is_dir() {
        total := U64{0}
        loop entry in fs.read_dir(path).unwrap() { total += logical_bytes(entry.unwrap().path()) }
        total
    } else { metadata.len() }
}

// Rust: tests/jetpack_hangar_store_v2.rs:1727
pub fn quota_fixture(roots: &Store.Roots, name: String, fill: U8, bytes: USize) -> Store.StoreEntry {
    source :: roots.root.join("quota-source-{name}")
    fs.create_dir_all(source).unwrap()
    fs.write(source.join("payload"), [U8].repeat(fill, bytes)).unwrap()
    entry :: Store.ingest_tree(roots, Store.IngestRequest{name: "quota-{name}", version: "1", reference: "quota@fixture#{name}",
        cache_identity: Store.CacheIdentity.default(), references: [], outputs: [String:OSPath]{"out": source},
        signature: "", provenance: "quota-test", platform_artifact_kind: ""}).unwrap().entry
    fs.remove_dir_all(source).unwrap()
    entry
}
