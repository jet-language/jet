    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("cleaned hangar"), "stderr: {stderr}")
}

// Rust: tests/jetpack_dispatch.rs:60
#Test("jet_shared_store_status_does_not_default_to_install") {
    home :: Scratch.new("shared-store-status-home")
    data :: Scratch.new("shared-store-status-data")
    state :: Scratch.new("shared-store-status-state")
    legacy_hangar :: state.join("jet/hangar")
    fs.create_dir_all(legacy_hangar) ?? panic("create legacy hangar")
    fs.write(legacy_hangar.join("marker"), "legacy") ?? panic("write marker")
    output :: fixtures.jet().args(["shared-store", "status", "--no-color"]).env_remove("JETPACK_ROOT")
        .env("HOME", &home.path).env("XDG_DATA_HOME", &data.path).env("XDG_STATE_HOME", &state.path).output() ?? panic("status")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("shared-store broker is not installed."), "stderr: {stderr}")
    assert(!stderr.contains("Error [E1340]"), "stderr: {stderr}")
    assert(!stderr.contains("shared-store install failed"), "stderr: {stderr}")
    assert(!stderr.contains("sudo"), "stderr: {stderr}")
    assert(!stderr.contains("jetpack hangar shared install"), "stderr: {stderr}")
    assert(legacy_hangar.join("marker").is_file())
    assert(!data.path.join("jet/hangar").exists())
    assert(!data.path.join("jet/shared-store").exists())
}

// Rust: tests/jetpack_dispatch.rs:105
#Test("bare_jet_outdated_is_a_teaching_error_naming_jet_inspect_outdated") {
    proj :: Scratch.new("proj")
    root :: Scratch.new("root")
    fx :: Scratch.new("fx")
    fs.write(proj.join("env.jet"), "\nmodule dev {\n    sources: { default: acme/tools@github#latest }\n    env.dev: Env.{ packages: [default.greet] }\n}\n") ?? panic("write env")
    fs.create_dir_all(proj.join(".jet")) ?? panic("create .jet")
    fs.write(proj.join(".jet/lock"), "version = 1\n\n[[source_channel]]\nname = \"default\"\nchannel = \"latest\"\nexact = \"github:acme/tools#v1.2.0\"\n\n[root]\ndependencies = []\n") ?? panic("write lock")
    fixtures.write_channel_fixture(&fx.path, "github:acme/tools", "latest", "github:acme/tools#v1.3.0")
    out :: fixtures.jet().args(["outdated", "--no-color", "--fixtures"]).arg(&fx.path).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).env("PATH", "").output() ?? panic("outdated")
    assert_eq(out.status.code(), Val(2), "bare `jet outdated` must be rejected")
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("E2101"), "stderr: {stderr}")
    assert(stderr.contains("jet inspect outdated"), "stderr: {stderr}")
}

