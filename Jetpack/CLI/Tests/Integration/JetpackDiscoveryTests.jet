use Jetpack.CLI.Tests.Integration.JetpackDiscovery.*
use Jetpack.CLI.Tests.Integration.Support.JetpackFixtures as fixtures
use common.Scratch
use std.[fs, Command, env]
use Jetpack.JSON
// GATE #4494: real native process and filesystem integration.

// Rust: tests/jetpack_discovery.rs:45
#Test("search_reads_local_fixture_metadata_offline") {
    project :: Scratch.new("project")
    root :: Scratch.new("root")
    copy_project(&project.path)
    out :: jetpack().args(["search", "rip", "--no-color", "--offline", "--fixtures", "fixtures"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).output() ?? panic("search")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    stdout :: String.from_utf8_lossy(out.stdout)
    assert(stdout.contains("default.ripgrep"), "stdout: {stdout}")
    assert(stdout.contains("14.1.0"), "stdout: {stdout}")
    assert(project.path.join(".jet/discovery/index.jsonl").is_file(), "search should persist the local discovery index")
}

// Rust: tests/jetpack_discovery.rs:78
#Test("info_json_is_stable_and_includes_service_options") {
    project :: Scratch.new("project")
    root :: Scratch.new("root")
    copy_project(&project.path)
    out :: jetpack().args(["info", "default.ripgrep", "--json", "--no-color", "--offline", "--fixtures", "fixtures"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).output() ?? panic("info")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    stdout :: String.from_utf8_lossy(out.stdout)
    assert(stdout.contains("\"reference\":\"ripgrep@default\""), stdout)
    assert(stdout.contains("\"version\":\"14.1.0\""), stdout)
    assert(stdout.contains("\"maintainer_liveness\":\"not-applicable\""), stdout)
    assert(stdout.contains("\"name\":\"enable\""), stdout)
    assert(stdout.contains("\"name\":\"ready\""), stdout)
}

// Rust: tests/jetpack_discovery.rs:117
#Test("jet_inspect_info_shows_registry_maintainer_liveness") {
    project :: Scratch.new("registry-info-project")
    root :: Scratch.new("registry-info-root")
    fs.create_dir_all(project.path.join(".jet")) ?? panic("create .jet")
    fs.write(project.path.join(".jet/lock"), "version = 1\n\n[[package]]\nname = \"textkit\"\nversion = \"1.2.0\"\nsource = { registry = \"jet\", reference = \"textkit@jet\", output = \"out\", source-hash = \"sha256-tree\", repository = \"https://registry\", authority = \"jet-registry-index\", tier = \"community\", gate-status = \"signature=passed;audit=passed;name=passed;liveness=passed;review=not-required\" }\nfingerprint = \"fp\"\ndependencies = []\n") ?? panic("write lock")
    json_out :: jet().args(["inspect", "info", "jet.textkit", "--json", "--offline", "--no-color"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).output() ?? panic("info")
    assert(json_out.status.success(), "stderr: {String.from_utf8_lossy(json_out.stderr)}")
    json :: String.from_utf8_lossy(json_out.stdout)
    assert(json.contains("\"maintainer_liveness\":\"passed\""), json)
    human_out :: jet().args(["inspect", "info", "jet.textkit", "--offline", "--no-color"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).output() ?? panic("human info")
    assert(human_out.status.success(), "stderr: {String.from_utf8_lossy(human_out.stderr)}")
    human :: String.from_utf8_lossy(human_out.stdout)
    assert(human.contains("maintainer liveness: passed"), human)
}

