}

// Rust: tests/jetpack_dispatch.rs:19
#Test("bare_jetpack_prints_help_without_entering_an_environment") {
    project :: Scratch.new("bare-jetpack-project")
    root :: Scratch.new("bare-jetpack-root")
    fs.write(project.join("env.jet"), "module broken { invalid }") ?? panic("write env")
    output :: fixtures.jetpack().current_dir(&project.path).env("JETPACK_ROOT", &root.path).output() ?? panic("bare jetpack")
    assert(output.status.success(), "bare `jetpack` should print help and exit successfully: {String.from_utf8_lossy(output.stderr)}")
    help :: String.from_utf8_lossy(output.stderr)
    assert(help.contains("jet env"), "stderr: {help}")
    assert(!project.join(".jet").exists(), "bare `jetpack` entered env")
}

// Rust: tests/jetpack_dispatch.rs:40
#Test("jet_clean_delegates_to_jetpack_clean") {
    root :: Scratch.new("root")
    (stale, _) :: fixtures.write_hangar_meta(&root.path, "old-top", "oldtop", "1.0", Val(1))
    out :: fixtures.jet().args(["clean", "--no-color", "--yes"]).env("JETPACK_ROOT", &root.path).output() ?? panic("clean")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
