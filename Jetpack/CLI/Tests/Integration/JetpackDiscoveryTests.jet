// Rust: tests/jetpack_dispatch.rs:198
#Test("jet_env_delegates_to_jetpack_env") {
    (base, proj, root) :: fixtures.core_hello_project("jet-env")
    output :: Command.new(env.compile_time("CARGO_BIN_EXE_jet")).args(["env", "--no-color", "--trust", "--offline", "--", "hello"])
        .current_dir(proj).env("JETPACK_ROOT", root).env("HOME", base.join("home")).env("PATH", "").output() ?? panic("env")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
