// Rust: tests/env_hook.rs:1
// Direnv-style opt-in activation through the jet env front door.
use std.[fs, env, Command, Stdio]
use core.sys
use common.[jetpack_bin, Scratch]

// Rust: tests/env_hook.rs:28
// GATE #4494: real native executable discovery. Unix callers dispatch on selected_family.
fn host_bash() -> OSPath {
    for directory in env.split_paths(env.var_os("PATH") ?? panic("tests run with PATH")) {
        candidate :: directory.join("bash")
        if candidate.is_file() { return candidate }
    }
    panic("tests need a bash executable")
}

// Rust: tests/env_hook.rs:38
// Noninteractive command with cleared activation state and a fixed PATH baseline.
fn export_cmd(dir: &OSPath) -> Command {
    cmd := Command.new(jetpack_bin())
    &cmd.current_dir(dir).stdin(Stdio.null())
        .env_remove("JET_ENV_DISABLE").env_remove("JETPACK_ENV")
        .env_remove("JETPACK_ENV_DIR").env_remove("JETPACK_ENV_HASH")
        .env_remove("JETPACK_ENV_OLD_PATH").env_remove("JETPACK_REF")
        .env("PATH", "/usr/bin:/bin")
    cmd
}

// Rust: tests/env_hook.rs:52
fn write_prompt_only_env(dir: &OSPath) -> {
    fs.write(dir.join("env.jet"), "module env.dev {\n  prompt: \"smoke\"\n}\n") ?? panic("write env")
}

// Rust: tests/env_hook.rs:60
fn activation_hash(stdout: &[U8]) -> String {
    text :: String.from_utf8_lossy(stdout)
    for line in text.lines() {
        if value :: line.strip_prefix("export JETPACK_ENV_HASH='") {
            if hash :: value.strip_suffix("'") { return hash.to_string() }
        }
    }
    panic("activation must export its definition hash")
}
