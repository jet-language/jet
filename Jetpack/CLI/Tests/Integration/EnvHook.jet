// PORT-PENDING 1046 tests-env-hook: tests/env_hook.rs:1-1019
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! D-ENVHOOK1=A: direnv-style opt-in env auto-activation.
//RS //!
//RS //! Covers the front-door subverbs of `jet env` (which route through `jetpack
//RS //! enter`, D-JPK-DISPATCH1):
//RS //!   * `jet env hook <shell>` prints an installable per-prompt hook for each
//RS //!     supported shell, and rejects an unknown shell with a clean error;
//RS //!   * `jet env export <shell>` is silent outside any `env.jet`;
//RS //!   * it activates the nearest `env.jet` (exporting PATH + markers + the
//RS //!     active-env-dir state), from the root and from a nested subdirectory;
//RS //!   * `JET_ENV_DISABLE` unloads an active env; and an unchanged directory is a
//RS //!     silent no-op (never re-realizes).
//RS //!   * typed `git_hooks_path` projects native Git hooks through entry and the
//RS //!     clean `jet env test` CI path, while invalid paths fail before launch.
//RS //!
//RS //! These drive `jetpack` directly (same as `env_dev_trust.rs`) so the intercept
//RS //! in `cmd_enter` is exercised without depending on engine-binary discovery.
//RS 
//RS use std::fs;
//RS #[cfg(unix)]
//RS use std::io::Write;
//RS use jetpack::SHA256;
//RS use std::process::{Command, Stdio};
//RS 
//RS mod common;
//RS use common::{jetpack_bin, Scratch};
//RS 
