#Test("os_cachyos_kernel_source_builder_failure_is_diagnostic") {
    proj :: Scratch.new("os-kernel-source-build-fail")
    root :: Scratch.new("os-kernel-source-build-fail-root")
    pkg :: proj.join("jet-pkgs/pkgs/cachyos-kernel")
    systemd :: proj.join("jet-pkgs/pkgs/systemd")
    fs.create_dir_all(pkg) ?? panic("kernel dir")
    fs.create_dir_all(systemd.join("bin")) ?? panic("systemd dir")
    fs.write(proj.join("jet-pkgs/package.jet"), "name: \"jet-pkgs\"\nversion: \"0.1.0\"\npackages: { cachyos-kernel: library, systemd: executable }\n") ?? panic("packages")
    fs.write(pkg.join("cachyos-kernel.jet"), "module cachyos-kernel { }\n") ?? panic("kernel module")
    write_cachyos_source_recipe(&pkg)
    write_cachyos_source_builder(&pkg, "#!/bin/sh\necho compiler missing >&2\nexit 7\n")
    fs.write(systemd.join("systemd.jet"), "module systemd { }\n") ?? panic("systemd module")
    fs.write(systemd.join("bin/systemd"), "test systemd\n") ?? panic("systemd")
    fs.write(proj.join("config.jet"), "module box {\n    sources: { mine: ./jet-pkgs }\n    system.box: { target: linux.x64 }\n}\n") ?? panic("config")
    out :: jet().args(["os", "build", "box", "--no-color", "--offline"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("build")
    assert_eq(out.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(out.stderr)
    diagnostic := stderr.find("\n  error[E1286]").map((idx) -> stderr[idx..]).unwrap_or(stderr) // #4303
    assert_jetos_stderr_snapshot("cachyos_source_build_failed", diagnostic)
}

