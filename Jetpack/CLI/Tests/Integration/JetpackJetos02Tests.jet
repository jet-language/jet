#Test("os_vm_prove_runs_qemu_and_records_guest_proof") {
    root :: Scratch.new("os-vm-run-root")
    tools :: Scratch.new("os-vm-run-tools")
    write_fake_vm_tools(&tools.path, true)
    out :: jet().args(["os", "vm", "prove", "halcyon", "--disk", "halcyon.qcow2", "--name", "vm-live", "--no-color", "--offline"]).current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", tools.path).output() ?? panic("prove")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    proof :: root.path.join("systems/vm-proofs/halcyon-vm-live-vm-proof.json")
    guest :: root.path.join("systems/vm-proofs/halcyon-vm-live-vm-proof-guest-proof.json")
    final_proof :: fs.read_to_string(proof) ?? panic("proof")
    assert(final_proof.contains("\"state\":\"guest-passed\""), "proof: {final_proof}")
    assert(final_proof.contains("\"proof_tier\":\"plumbing\""), "regular VM proof is harness plumbing until --real passes: {final_proof}")
    assert(final_proof.contains("\"guest_proof_sha256\""), "proof: {final_proof}")
    guest_proof :: fs.read_to_string(guest) ?? panic("guest proof")
    assert(guest_proof.contains("\"serial_report\""), "guest proof: {guest_proof}")
    assert(guest_proof.contains("halcyon") && guest_proof.contains("vm-live"), "guest serial report should bind host and generation: {guest_proof}")
    assert(guest_proof.contains("\"qemu-system-x86_64\""), "guest proof should bind the runner toolchain: {guest_proof}")
    boot_log :: root.path.join("systems/vm-proofs/halcyon-vm-live-vm-proof.run/boot-graphical-desktop.stdout")
    assert((fs.read_to_string(boot_log) ?? panic("boot log")).contains("JETOS_GUEST_PROOF"), "boot log should carry guest proof marker")
    run :: jet().args(["os", "vm", "run", "halcyon", "--disk", "halcyon.qcow2", "--no-color", "--offline"]).current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", tools.path).output() ?? panic("run")
    assert(run.status.success(), "stderr: {String.from_utf8_lossy(run.stderr)}")
    stdout :: String.from_utf8_lossy(run.stdout)
    stderr :: String.from_utf8_lossy(run.stderr)
    assert(stderr.contains("booting jetos VM halcyon generation vm-live"), "stderr: {stderr}")
    assert(stdout.contains("JETOS_GUEST_PROOF"), "interactive run should launch QEMU with the proved disk: {stdout}")
}

// Rust: tests/jetpack_jetos.rs:4064
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("os_vm_test_runs_declared_scenario_and_records_proof") {
    project :: Scratch.new("os-vmtest-project")
    copy_dir_recursive(&config_example_dir(), &project.path)
    config := fs.read_to_string(project.path.join("config.jet")) ?? panic("config")
    config.push_str("\n\nmodule vmtest.ssh-smoke {\n    hosts: { halcyon: system.halcyon }\n    run: test {\n        halcyon.wait_for_boot()\n        halcyon.assert_unit_active(.openssh)\n        halcyon.assert_port_open(22)\n    }\n}\n")
    fs.write(project.path.join("config.jet"), config) ?? panic("write config")
    root :: Scratch.new("os-vmtest-root")
    tools :: Scratch.new("os-vmtest-tools")
    write_fake_vm_tools(&tools.path, true)
    out :: jet().args(["os", "vm", "test", "ssh-smoke", "--disk", "ssh-smoke.qcow2", "--name", "vmtest-proof", "--no-color", "--offline"]).current_dir(project.path).env("JETPACK_ROOT", root.path).env("PATH", tools.path).output() ?? panic("vmtest")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    proof :: root.path.join("systems/vm-tests/ssh-smoke-vmtest-proof.json")
    data :: fs.read_to_string(proof) ?? panic("proof")
    assert(data.contains("\"kind\":\"jetos.vmtest.proof\"") && data.contains("\"state\":\"passed\"") && data.contains("\"name\":\"ssh-smoke\""), "proof: {data}")
    assert(data.contains("\"name\": \"halcyon\"") && data.contains("\"system\": \"halcyon\"") && data.contains("\"disk\": \"ssh-smoke.qcow2\""), "proof: {data}")
    assert(data.contains("\"wait_for_boot\"") && data.contains("\"assert_unit_active\"") && data.contains("\"assert_port_open\""), "proof should capture typed assertion methods: {data}")
    assert(data.contains("halcyon.assert_unit_active(.openssh)"), "proof should carry the source test body for replay: {data}")
    assert(root.path.join("systems/vm-proofs/halcyon-vmtest-proof-vm-proof.json").is_file(), "vmtest should reuse the install/reboot VM proof harness")
}

// Rust: tests/jetpack_jetos.rs:4144
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("os_vm_prove_accepts_matching_guest_proof") {
    root :: Scratch.new("os-vm-guest-proof-root")
    tools :: Scratch.new("os-vm-guest-proof-tools")
    write_fake_vm_tools(&tools.path, false)
    args :: ["os", "vm", "prove", "halcyon", "--disk", "halcyon.qcow2", "--name", "vm-proof", "--no-color", "--offline"]
    first :: jet().args(args).current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", tools.path).output() ?? panic("first prove")
    assert_eq(first.status.code(), Val(2))
    proof :: root.path.join("systems/vm-proofs/halcyon-vm-proof-vm-proof.json")
    guest :: root.path.join("systems/vm-proofs/halcyon-vm-proof-vm-proof-guest-proof.json")
    media_proof :: root.path.join("systems/images/jetos-installer-halcyon.iso.proof.json")
    harness :: fs.read_to_string(proof) ?? panic("harness")
    fs.write(guest, "{{\"state\":\"guest-passed\",\"host\":\"halcyon\",\"generation\":\"vm-proof\",\"disk\":\"halcyon.qcow2\",\"media_proof\":\"{test_json_escape(media_proof.display().to_string())}\",\"media_proof_sha256\":\"{harness_json_field(&harness, "media_proof_sha256")}\",\"installer_iso_fingerprint\":\"{harness_json_field(&harness, "installer_iso_fingerprint")}\",\"assertions\":[\"current-generation-matches\",\"packages-present\",\"services-active\",\"network-up\",\"rollback-generation-bootable\",\"terminal-login-ready\",\"desktop-session-ready\",\"graphical-console-ready\",\"desktop-launchers-run\"],\"toolchain\":\"{test_json_escape(&harness)}\"}}\n") ?? panic("write guest")
    second :: jet().args(args).current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", tools.path).output() ?? panic("second prove")
    assert(second.status.success(), "stderr: {String.from_utf8_lossy(second.stderr)}")
    final_proof :: fs.read_to_string(proof) ?? panic("final proof")
    assert(final_proof.contains("\"state\":\"guest-passed\""), "proof: {final_proof}")
    assert(final_proof.contains("\"guest_proof_sha256\""), "proof: {final_proof}")
}

