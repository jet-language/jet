    assert_eq(first.status.code(), Val(2))
    proof :: root.path.join("systems/vm-proofs/halcyon-vm-proof-vm-proof.json")
    guest :: root.path.join("systems/vm-proofs/halcyon-vm-proof-vm-proof-guest-proof.json")
