    harness :: fs.read_to_string(proof) ?? panic("harness")
    fs.write(guest, "{{\"state\":\"guest-passed\",\"host\":\"halcyon\",\"generation\":\"vm-proof\",\"disk\":\"halcyon.qcow2\",\"media_proof\":\"{test_json_escape(media_proof.display().to_string())}\",\"media_proof_sha256\":\"{harness_json_field(&harness, "media_proof_sha256")}\",\"installer_iso_fingerprint\":\"{harness_json_field(&harness, "installer_iso_fingerprint")}\",\"assertions\":[\"current-generation-matches\",\"packages-present\",\"services-active\",\"network-up\"],\"toolchain\":\"{test_json_escape(&harness)}\"}}\n") ?? panic("write guest")
