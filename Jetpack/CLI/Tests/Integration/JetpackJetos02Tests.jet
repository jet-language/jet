#Test("os_generations_are_newest_first_and_rollback_activates_prior") {
    root :: Scratch.new("os-gens-root")
    for name in ["first", "second"] {
        out :: jet().args(["os", "switch", "halcyon", "--name", name, "--no-color", "--offline"]).current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("switch")
        assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    }
    assert(!root.join("systems/generations/second/activation-proof.txt").exists(), "activation must never mutate a sealed generation")
    sealed_retry :: jet().args(["os", "build", "halcyon", "--name", "second", "--no-color", "--offline"]).current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("sealed retry")
    assert(sealed_retry.status.success(), "activation left the sealed proof stale: {String.from_utf8_lossy(sealed_retry.stderr)}")
    for name in ["first", "second"] {
        proof :: fs.read_to_string(root.path.join("systems/generations").join(name).join("generation-root.json")) ?? panic("root proof")
        assert(proof.contains("\"kind\":\"jetos.generation-root.v1\"") && proof.contains("\"output_digests\":[\"sha256-"), "retained generation {name} must keep its typed Hangar root proof: {proof}")
    }
    journal :: root.join("hangar/lifecycle-db/journal")
    read_journal :: () -> {
        entries := (fs.read_dir(journal) ?? panic("journal")).filter_map((entry) -> entry.ok()).map((entry) -> (entry.file_name(), fs.read(entry.path()).expect("read journal"))).collect()
        entries.sort_by((a, b) -> a.0.cmp(b.0))
        entries
    }
    lifecycle_before_rollback :: read_journal()
    lifecycle_text :: lifecycle_before_rollback.iter().map((entry) -> String.from_utf8_lossy(entry.1)).collect()
    assert(lifecycle_text.matches("external-consumer").count() >= 2, "both retained generations must remain lifecycle roots: {lifecycle_text}")
    list :: jet().args(["os", "generations", "halcyon", "--no-color"]).env("JETPACK_ROOT", root.path).output() ?? panic("list")
    assert(list.status.success())
    stdout :: String.from_utf8_lossy(list.stdout)
    second :: stdout.find("second") ?? panic("second")
    first :: stdout.find("first") ?? panic("first")
    assert(second < first, "generations should be newest-first: {stdout}")
    proof :: fs.read_to_string(root.path.join("systems/activation-proofs/halcyon/second.txt")) ?? panic("activation proof")
    assert(proof.contains("service-risk"), "proof: {proof}")
    assert(proof.contains("rollback-proof: pass previous=first"), "proof: {proof}")
    rollback :: jet().args(["os", "rollback", "halcyon", "first", "--no-color"]).env("JETPACK_ROOT", root.path).output() ?? panic("rollback")
    assert(rollback.status.success(), "stderr: {String.from_utf8_lossy(rollback.stderr)}")
    assert(String.from_utf8_lossy(rollback.stderr).contains("rolled back"), "stderr: {String.from_utf8_lossy(rollback.stderr)}")
    assert_eq(read_journal(), lifecycle_before_rollback, "rollback changes activation pointers, never lifecycle roots")
    same :: jet().args(["os", "rollback", "halcyon", "first", "--no-color"]).env("JETPACK_ROOT", root.path).output() ?? panic("same rollback")
    assert_eq(same.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(same.stderr)
    assert(stderr.contains("no generation is available"), "stderr: {stderr}")
}

