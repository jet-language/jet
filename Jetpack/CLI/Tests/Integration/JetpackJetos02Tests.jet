// Rust: tests/jetpack_jetos.rs:2348
#Test("os_plan_prints_checked_system_contract_without_building") {
    root :: Scratch.new("os-plan-root")
    out :: jet().args(["os", "plan", "halcyon", "--json", "--no-color", "--offline"]).current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("plan")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    json :: String.from_utf8_lossy(out.stdout)
    assert(json.contains("\"host\":\"halcyon\""), "plan: {json}")
    assert(json.contains("\"loader\":\"Limine\""), "plan: {json}")
    assert(json.contains("\"kernel\":\"CachyOS\""), "plan: {json}")
    assert(json.contains("\"key\": \"users.nate.normal\""), "plan: {json}")
    assert(!root.join("systems/generations").exists(), "plan must not create a generation")
}

// Rust: tests/jetpack_jetos.rs:2378
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("jetos_user_commands_use_same_generation_engine") {
    root :: Scratch.new("jetos-user-root")
    plan :: jetos().args(["user", "plan", "nate", "--json", "--no-color"]).current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("user plan")
    assert(plan.status.success(), "stderr: {String.from_utf8_lossy(plan.stderr)}")
    stdout :: String.from_utf8_lossy(plan.stdout)
    assert(stdout.contains("\"kind\":\"jetos.user-generation\"") && stdout.contains("\"user\":\"nate\""), "plan: {stdout}")
    build :: jetos().args(["user", "build", "nate", "--name", "user-gen", "--no-color", "--offline"]).current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("user build")
    assert(build.status.success(), "stderr: {String.from_utf8_lossy(build.stderr)}")
    assert(root.path.join("systems/generations/user-gen/users/nate/profile.json").is_file(), "expected user generation artifact")
    proof :: jetos().args(["user", "prove", "nate", "--json", "--no-color"]).current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("user prove")
    assert(proof.status.success(), "stderr: {String.from_utf8_lossy(proof.stderr)}")
    stdout :: String.from_utf8_lossy(proof.stdout)
    assert(stdout.contains("\"user\":\"nate\"") && stdout.contains("user-gen"), "proof: {stdout}")
}

// Rust: tests/jetpack_jetos.rs:2447
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("os_build_bare_host_uses_current_repo_config") {
    proj :: Scratch.new("os-repo")
    root :: Scratch.new("os-default-root")
    pkg :: proj.join("jet-pkgs/pkgs/cachyos-kernel")
    systemd :: proj.join("jet-pkgs/pkgs/systemd")
    fs.create_dir_all(pkg.join("boot")) ?? panic("kernel dir")
    fs.create_dir_all(systemd.join("bin")) ?? panic("systemd dir")
    fs.write(proj.join("jet-pkgs/package.jet"), "name: \"jet-pkgs\"\nversion: \"0.1.0\"\npackages: { cachyos-kernel: library, systemd: executable }\n") ?? panic("packages")
    fs.write(pkg.join("cachyos-kernel.jet"), "module cachyos-kernel { }\n") ?? panic("kernel module")
    write_bootlike_cachyos_artifacts(&pkg)
    write_cachyos_source_recipe(&pkg)
    fs.write(systemd.join("systemd.jet"), "module systemd { }\n") ?? panic("systemd module")
    fs.write(systemd.join("bin/systemd"), "test systemd\n") ?? panic("systemd")
    fs.write(proj.join("config.jet"), "module box {\n    sources: { mine: ./jet-pkgs }\n    system.box: { target: linux.x64 }\n}\n") ?? panic("config")
    out :: jet().args(["os", "build", "box", "--no-color", "--offline"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("build")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("box"), "stderr: {stderr}")
}

// Rust: tests/jetpack_jetos.rs:2493
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("os_cachyos_kernel_source_recipe_builds_boot_artifacts") {
    proj :: Scratch.new("os-kernel-source-build")
    root :: Scratch.new("os-kernel-source-build-root")
    pkg :: proj.join("jet-pkgs/pkgs/cachyos-kernel")
    systemd :: proj.join("jet-pkgs/pkgs/systemd")
    fs.create_dir_all(pkg) ?? panic("kernel dir")
    fs.create_dir_all(systemd.join("bin")) ?? panic("systemd dir")
    fs.write(proj.join("jet-pkgs/package.jet"), "name: \"jet-pkgs\"\nversion: \"0.1.0\"\npackages: { cachyos-kernel: library, systemd: executable }\n") ?? panic("packages")
    fs.write(pkg.join("cachyos-kernel.jet"), "module cachyos-kernel { }\n") ?? panic("kernel module")
    write_cachyos_source_recipe(&pkg)
    write_cachyos_source_builder(&pkg, "#!/bin/sh\nset -eu\nprintf 'MZ built cachyos kernel\nHdrS\n' > \"$JETOS_KERNEL_OUT/vmlinuz-cachyos\"\nprintf '070701 built cachyos initrd\n' > \"$JETOS_KERNEL_OUT/initrd-cachyos\"\n")
    fs.write(systemd.join("systemd.jet"), "module systemd { }\n") ?? panic("systemd module")
    fs.write(systemd.join("bin/systemd"), "test systemd\n") ?? panic("systemd")
    fs.write(proj.join("config.jet"), "module box {\n    sources: { mine: ./jet-pkgs }\n    system.box: { target: linux.x64 }\n}\n") ?? panic("config")
    out :: jet().args(["os", "build", "box", "--name", "kernel-source-built", "--no-color", "--offline"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("build")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    kernel :: fs.read_to_string(root.path.join("systems/generations/kernel-source-built/boot/kernel")) ?? panic("kernel")
    assert(kernel.contains("built cachyos kernel"), "kernel: {kernel}")
    boot :: fs.read_to_string(root.path.join("systems/generations/kernel-source-built/boot/facts.json")) ?? panic("boot facts")
    assert(boot.contains("\"bootstrap\":\"source-built\""), "boot: {boot}")
}

