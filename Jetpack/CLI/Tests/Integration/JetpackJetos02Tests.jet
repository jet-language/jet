// Rust: tests/jetpack_jetos.rs:3317
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("nixos_migration_protects_stage_before_writing_inputs") {
    if sys.target.selected_os() != "linux" -> return
    root :: Scratch.new("nixos-private-stage")
    out_dir :: root.join("published")
    trace :: root.join("stage.trace")
    jet_program :: jet().get_program().to_owned()
    out :: Command.new("strace").args(["-f", "-s", "4096", "-o"]).arg(trace).args(["-e", "trace=%file", "--"]).arg(jet_program)
        .args(["os", "migrate", "compare-nixos", "halcyon-gnome", "--out", out_dir.to_str().expect("out path"), "--no-color"])
        .current_dir(OSPath.from(env("CARGO_MANIFEST_DIR")).join("tests/fixtures/jetpack-config-real"))
        .env("JETPACK_ROOT", root.path).env("NIX_REMOTE", "invalid").output() ?? panic("strace")
    assert_eq(out.status.code(), Val(2))
    assert(!out_dir.exists())
    trace :: fs.read_to_string(trace) ?? panic("trace")
    marker :: "/.nixos-comparison-halcyon-gnome-"
    lines :: trace.lines().collect()
    mkdir :: lines.iter().position((line) -> line.contains("mkdir(") && line.contains(marker) && line.contains("0700")) ?? panic("private 0700 mkdir missing:\n{trace}")
    first_input :: lines.iter().position((line) -> line.contains(marker) && (line.contains("/flake.nix") || line.contains("/configuration.nix") || line.contains("/input-facts.json"))) ?? panic("private input creation missing:\n{trace}")
    protected :: lines.iter().enumerate().filter_map((entry) -> {
        (index, line) :: entry
        if index < first_input && line.contains(marker) && line.contains("AT_SYMLINK_NOFOLLOW") && (line.contains("S_IFDIR|0700") || line.contains("stx_mode=S_IFDIR|0700")) { Val(index) } else { None }
    }).collect()
    assert_eq(protected.len(), 2, "expected post-mkdir and pre-write verification:\n{trace}")
    insecure :: lines.iter().find((line) -> line.contains(marker) && (line.contains("st_mode=S_IFDIR|") || line.contains("stx_mode=S_IFDIR|")) && !line.contains("S_IFDIR|0700"))
    assert(insecure.is_none(), "stage mode widened: {insecure}")
    assert(mkdir < protected[0], "mode checked before mkdir:\n{trace}")
    assert(protected[1] < first_input, "private input opened before mode/no-follow verification:\n{trace}")
}

// Rust: tests/jetpack_jetos.rs:3593
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("nixos_migration_publish_stage_is_private_and_collision_safe") {
    if sys.target.selected_os() != "linux" -> return
    root :: Scratch.new("nixos-private-publish")
    (path, outputs) :: build_nixos_migration_test_tools(&root.path)
    published :: root.join("published")
    success_trace :: root.join("publish-success.trace")
    out :: traced_nixos_migration(&root, &published, &success_trace, &path, &outputs, false, false)
    assert(out.status.success(), "stdout: {String.from_utf8_lossy(out.stdout)}\nstderr: {String.from_utf8_lossy(out.stderr)}")
    trace :: fs.read_to_string(success_trace) ?? panic("trace")
    marker :: "/.nixos-comparison-publish-halcyon-gnome-"
    lines :: trace.lines().collect()
    mkdir :: lines.iter().position((line) -> line.contains("mkdir(") && line.contains(marker) && line.contains("0700")) ?? panic("private publish mkdir missing:\n{trace}")
    protected :: lines.iter().position((line) -> line.contains(marker) && line.contains("AT_SYMLINK_NOFOLLOW") && (line.contains("S_IFDIR|0700") || line.contains("stx_mode=S_IFDIR|0700"))) ?? panic("private publish verification missing:\n{trace}")
    first_output :: lines.iter().position((line) -> line.contains(marker) && line.contains("/nixos/halcyon-gnome/system.qcow2")) ?? panic("private publish output missing:\n{trace}")
    assert(mkdir < protected && protected < first_output, "{trace}")
    if sys.target.selected_family() == "unix" {
        assert_eq((fs.metadata(published) ?? panic("published metadata")).permissions().mode() & 0o777, 0o700)
    }
    host :: published.join("nixos/halcyon-gnome")
    image :: host.join("system.qcow2")
    proof :: host.join("proof.json")
    receipt :: host.join("receipt.json")
    assert(image.is_file())
    assert(proof.is_file())
    assert(receipt.is_file())
    assert((fs.read_to_string(proof) ?? panic("proof")).contains("\"image\":\"system.qcow2\""))
    assert((fs.read_to_string(receipt) ?? panic("receipt")).contains("\"boot_proof\":\"proof.json\""))
    plan :: fs.read_to_string(host.join("build-boot-plan.json")) ?? panic("plan")
    assert_eq(plan.matches("\"--offline\"").count(), 2, "{plan}")
    stdout :: String.from_utf8(out.stdout) ?? panic("stdout")
    for path in [&image, &proof, &receipt] { assert(stdout.contains(path.display().to_string()), "{stdout}") }
    json_out_dir :: root.join("json-output")
    json_trace :: root.join("publish-json.trace")
    out :: traced_nixos_migration(&root, &json_out_dir, &json_trace, &path, &outputs, false, true)
    assert(out.status.success(), "stdout: {String.from_utf8_lossy(out.stdout)}\nstderr: {String.from_utf8_lossy(out.stderr)}")
    assert_eq(String.from_utf8(out.stdout) ?? panic("stdout"),
        "{{\"kind\":\"nixos.migration.comparison\",\"state\":\"proved\",\"host\":\"halcyon-gnome\",\"image\":\"{json_out_dir.join("nixos/halcyon-gnome/system.qcow2").display()}\",\"proof\":\"{json_out_dir.join("nixos/halcyon-gnome/proof.json").display()}\",\"receipt\":\"{json_out_dir.join("nixos/halcyon-gnome/receipt.json").display()}\"}}\n")
    collision_out :: root.join("collision-output")
    collision_trace :: root.join("publish-collision.trace")
    out :: traced_nixos_migration(&root, &collision_out, &collision_trace, &path, &outputs, true, false)
    assert_eq(out.status.code(), Val(2))
    assert(!collision_out.exists())
    trace :: fs.read_to_string(collision_trace) ?? panic("trace")
    assert(trace.lines().any((line) -> line.contains("mkdir(") && line.contains(marker) && line.contains("0700") && line.contains("EEXIST")), "preexisting publish leaf did not fail atomically:\n{trace}")
}

