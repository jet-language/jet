// Rust: tests/jetpack_tool.rs:1
use Jetpack.CLI.Tests.Integration.JetpackTool.*
use Jetpack.CLI.Tests.Integration.Support.JetpackFixtures.*
use Jetpack.CLI.Tests.Integration.Common as common
use std.[env, fs, Command, Stdio, Instant, Duration, thread]
use core.sys.target.[selected_os, selected_family]
// GATE #4494: real native processes, filesystem permissions, clocks and detached descendants.
// GATE #4483: target-specific tests dispatch using selected target facts.

// Rust: tests/jetpack_tool.rs:188
#Test("command_helpers_use_stable_filesystem_root") {
    temp :: env.temp_dir()
    root :: temp.ancestors().last() ?? panic("temp root")
    assert(root.has_root())
    for command in [jetpack(), jet(), jetos()] { assert_eq(command.get_current_dir(), Some(root)) }
}

// Rust: tests/jetpack_tool.rs:199
#Test("stable_cwd_survives_abrupt_parent_and_detached_descendant") {
    if selected_os() == "linux" {
        proof :: Scratch.new("stable-cwd-proof")
        marker :: proof.join("cwd")
        status :: neutral_command(OSPath.from("sh")).args(["-c", "setsid sh -c 'sleep 0.05; pwd > \"$1\"' sh \"$1\" </dev/null >/dev/null 2>&1 & kill -KILL $$", "sh", marker.to_str() ?? panic("marker text")]).status() ?? panic("detached parent")
        assert(!status.success())
        deadline :: Instant.now() + Duration.from_secs(5)
        while !marker.is_file() {
            assert(Instant.now() < deadline, "detached cwd proof timed out")
            thread.sleep(Duration.from_millis(5))
        }
        temp :: env.temp_dir()
        root :: temp.ancestors().last() ?? panic("temp root")
        cwd := (fs.read_to_string(marker) ?? panic("read cwd")).trim() // #4303
        assert_eq(cwd, root.to_str() ?? panic("root text"))
    }
}

// Rust: tests/jetpack_tool.rs:239
#Test("tool_help_lists_install_list_uninstall_and_shell_verbs") {
    output :: jetpack().args(["help"]).output() ?? panic("help")
    assert(output.status.success())
    stdout :: String.from_utf8_lossy(output.stdout)
    assert(stdout.contains("tool install"), "stdout: {stdout}")
    assert(stdout.contains("tool list"), "stdout: {stdout}")
    assert(stdout.contains("tool uninstall"), "stdout: {stdout}")
    assert(stdout.contains("env <name>"), "stdout: {stdout}")
    assert(stdout.contains("use <package>"), "stdout: {stdout}")
}

// Rust: tests/jetpack_tool.rs:251
#Test("use_ephemeral_execs_inside_and_outside_project_without_path_projection") {
    root :: Scratch.new("use-root")
    project :: Scratch.new("use-project")
    outside :: Scratch.new("use-outside")
    fixtures :: Scratch.new("use-fx")
    write_native_omp_fixture(fixtures.path, "1.0.0", "#!/bin/sh\necho hello from jetpack use\n")
    // The explicitly named package set must not merge the cwd project's plan.
    fs.write(project.join("env.jet"), "module env.dev { packages: [\"missing@releases#1.0.0\"] }\n") ?? panic("write project plan")
    home :: Scratch.new("use-home")
    for cwd in [project.path, outside.path] {
        command :: "stty rows 30 cols 120; exec {test_shell_quote(common.jetpack_bin())} use omp@releases#1.0.0 -y --no-color --offline --fixtures {test_shell_quote(fixtures.path)}"
        child := Command.new("script").args(["-qfec", command, "/dev/null"]).current_dir(cwd).env("JETPACK_ROOT", root.path).env("HOME", home.path).stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn() ?? panic("interactive use")
        (child.stdin.take() ?? panic("shell stdin")).write_all(b"if test \"$JETPACK_REF\" = 'omp@releases#1.0.0' && command -v omp >/dev/null; then printf 'JETPACK_USE_OK\\n'; exit 0; else exit 1; fi\n") ?? panic("write shell probe")
        output :: child.wait_with_output() ?? panic("shell output")
        assert(output.status.success(), "cwd={cwd.display()}: stdout: {String.from_utf8_lossy(output.stdout)} stderr: {String.from_utf8_lossy(output.stderr)}")
        assert(String.from_utf8_lossy(output.stdout).contains("JETPACK_USE_OK"), "cwd={cwd.display()}: interactive shell probe did not run: {String.from_utf8_lossy(output.stdout)}")
    }
    assert(!home.join(".jet/bin").join(physical_bin("omp")).exists(), "use must not leave PATH projection")
    assert(!home.join(".jet/tools/profile.json").exists())
}

// Rust: tests/jetpack_tool.rs:317
#Test("use_prep_materializes_then_entry_reuses_the_package") {
    root :: Scratch.new("use-prep-root")
    project :: Scratch.new("use-prep-project")
    fixtures :: Scratch.new("use-prep-fx")
    home :: Scratch.new("use-prep-home")
    write_native_omp_fixture(fixtures.path, "1.0.0", "#!/bin/sh\necho prepared omp\n")
    prep :: jetpack().args(["use", "omp@releases#1.0.0", "--prep", "--no-color", "--offline", "--fixtures"]).arg(fixtures.path).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("prepare use")
    assert(prep.status.success(), "use --prep failed: {String.from_utf8_lossy(prep.stderr)}")
    assert(prep.stdout.is_empty(), "prep must not enter a shell")
    fs.remove_file(fixtures.path.join("jetpackage-omp.json")) ?? panic("remove metadata")
    fs.remove_file(fixtures.path.join("omp-1.0.0")) ?? panic("remove artifact")
    entry :: jetpack().args(["use", "omp@releases#1.0.0", "--no-color", "--offline", "--fixtures"]).arg(fixtures.path).args(["--", "omp"]).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("enter prepared package")
    assert(entry.status.success(), "entry after use --prep failed: {String.from_utf8_lossy(entry.stderr)}")
    assert_eq(String.from_utf8_lossy(entry.stdout).trim(), "prepared omp")
}

// Rust: tests/jetpack_tool.rs:371
#Test("use_unavailable_provider_is_e1298_not_silent") {
    root :: Scratch.new("tool-prov-root")
    proj :: Scratch.new("tool-prov-proj")
    home :: Scratch.new("tool-prov-home")
    output :: jetpack().args(["use", "prettier@npm", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("unavailable provider")
    assert_eq(output.status.code(), Some(2))
    stderr :: String.from_utf8_lossy(output.stderr)
