    assert_jetos_stderr_snapshot("tool_provider_unavailable", diagnostic)
}

// Rust: tests/jetpack_tool.rs:393
#Test("tool_install_publishes_real_projection_and_generation") {
    root :: Scratch.new("tool-inst-root")
    proj :: Scratch.new("tool-inst-proj")
    fixtures :: Scratch.new("tool-inst-fx")
    home :: Scratch.new("tool-inst-home")
    write_tool_bin_fixture(root.path, fixtures.path, "greet", "greet", "#!/bin/sh\necho installed greet\n")
    output :: jetpack().args(["tool", "install", "greet@nixpkgs", "--no-color", "--offline", "--fixtures"]).arg(fixtures.path).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("install greet")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    link :: home.join(".jet/bin").join(physical_bin("greet"))
    assert(link.exists() || link.is_symlink(), "missing PATH projection at {link.display()}")
    assert_eq(fs.read(link) ?? panic("read projection"), b"#!/bin/sh\necho installed greet\n", "install must project the tool bytes, not jetpack")
    paths := [ (link.parent() ?? panic("link parent")).to_path_buf() ]
    if existing :: env.var_os("PATH") { paths.extend(env.split_paths(existing)) }
    path :: env.join_paths(paths) ?? panic("join PATH")
    invoked :: Command.new(link).env("HOME", home.path).env("PATH", path).output() ?? panic("invoke greet")
    assert(invoked.status.success(), "status={invoked.status.code():?}, stderr={String.from_utf8_lossy(invoked.stderr)}")
    assert_eq(String.from_utf8_lossy(invoked.stdout).trim(), "installed greet")
    meta :: home.join(".jet/tools/generations/1/meta.json")
    assert(meta.is_file(), "missing generation metadata {meta.display()}")
    meta_text :: fs.read_to_string(meta) ?? panic("read metadata")
    assert(meta_text.contains("\"generation\": 1"), "{meta_text}")
    assert(meta_text.contains("greet@nixpkgs"), "{meta_text}")
    output_hash :: metadata_output_hash(meta_text)
    assert(output_hash.starts_with("sha256-"), "{meta_text}")
    assert(home.join(".jet/tools/generations/1/complete").is_file())
    profile :: fs.read_to_string(home.join(".jet/tools/profile.json")) ?? panic("read profile")
    assert(profile.contains("\"current\": 1"), "{profile}")
    manifest :: fs.read_to_string(home.join(".jet/tools/manifest.json")) ?? panic("read manifest")
    assert(manifest.contains("\"reference\":\"greet@nixpkgs\""), "{manifest}")
    assert(manifest.contains("\"resolved\":\"greet@nixpkgs\""), "{manifest}")
    current :: fs.read_to_string(home.join(".jet/tools/current")) ?? panic("read current")
    assert(current.contains("generation\t1"), "{current}")
    assert(current.contains("checksum\tsha256-"), "{current}")
    rooted :: lifecycle_wire(root.path)
    assert(rooted.contains(output_hash), "{rooted}")
    assert(rooted.contains(ascii_hex("profile-generation:user:tools:1")), "{rooted}")
    cleaned :: jetpack().args(["hangar", "clean", "--no-color", "--yes"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("clean")
    assert(cleaned.status.success(), "stderr: {String.from_utf8_lossy(cleaned.stderr)}")
    assert(link.exists(), "lease teardown and clean must preserve rooted tool")
    listed :: jetpack().args(["tool", "list", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("list tools")
    assert(listed.status.success())
    stdout :: String.from_utf8_lossy(listed.stdout)
    assert(stdout.contains("greet"), "stdout: {stdout}")
    projection :: home.join(".jet/tools/generations/1/bin").join(physical_bin("greet"))
    original_projection :: fs.read(projection) ?? panic("read original projection")
    original_permissions :: (fs.metadata(projection) ?? panic("projection metadata")).permissions()
    writable_permissions := original_permissions.clone()
    if selected_family() == "unix" { writable_permissions.set_mode(writable_permissions.mode() | 0o200) }
    else { writable_permissions.set_readonly(false) }
    fs.set_permissions(projection, writable_permissions) ?? panic("make writable")
    fs.write(projection, b"#!/bin/sh\necho corrupted\n") ?? panic("corrupt projection")
    rejected :: jetpack().args(["tool", "list", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("reject corruption")
    assert_eq(rejected.status.code(), Some(2))
    assert(String.from_utf8_lossy(rejected.stderr).contains("projection proof mismatch"), "stderr: {String.from_utf8_lossy(rejected.stderr)}")
    fs.write(projection, original_projection) ?? panic("restore projection")
    fs.set_permissions(projection, original_permissions) ?? panic("restore permissions")
    removed :: jetpack().args(["tool", "uninstall", "greet", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("uninstall greet")
    assert(removed.status.success(), "stderr: {String.from_utf8_lossy(removed.stderr)}")
    assert(!link.exists(), "uninstall must remove the managed projection")
    empty_meta :: fs.read_to_string(home.join(".jet/tools/generations/2/meta.json")) ?? panic("empty metadata")
    assert(empty_meta.contains("\"tools\": [\n  ]"), "{empty_meta}")
    assert(home.join(".jet/tools/generations/2/complete").is_file())
    profile_two :: fs.read_to_string(home.join(".jet/tools/profile.json")) ?? panic("read profile two")
    assert(profile_two.contains("\"current\": 2"), "{profile_two}")
    roots_after_empty :: lifecycle_wire(root.path)
    assert(!roots_after_empty.contains(ascii_hex("profile-generation:user:tools:2")), "empty generation must not create a root: {roots_after_empty}")
}

// Rust: tests/jetpack_tool.rs:577
#Test("native_omp_recipe_admits_hangar_projects_and_rolls_back") {
    root :: Scratch.new("native-omp-root")
    project :: Scratch.new("native-omp-project")
    fixtures :: Scratch.new("native-omp-fixtures")
    home :: Scratch.new("native-omp-home")
    write_native_omp_fixture(fixtures.path, "1.0.0", "#!/bin/sh\necho omp version one\n")
    install :: (reference: String) -> { jetpack().args(["tool", "install", reference, "--no-color", "--offline", "--fixtures"]).arg(fixtures.path).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("native install") }
    first :: install("omp@releases#auto")
    assert(first.status.success(), "first native install failed: {String.from_utf8_lossy(first.stderr)}")
    link :: home.join(".jet/bin/omp")
    first_run :: Command.new(link).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("run native one")
    assert_eq(String.from_utf8_lossy(first_run.stdout).trim(), "omp version one")
    manifest :: fs.read_to_string(home.join(".jet/tools/manifest.json")) ?? panic("native manifest")
    assert(manifest.contains("\"provider\":\"jetpackage\""), "{manifest}")
    assert(manifest.contains("github:can1357/oh-my-pi") || manifest.contains("can1357/oh-my-pi"))
    assert(manifest.contains("\"tier\":\"#auto\""), "{manifest}")
    first_generation :: fs.read_to_string(home.join(".jet/tools/generations/1/meta.json")) ?? panic("native generation")
    first_store_root :: json_meta_field(first_generation, "store_root")
    assert(first_store_root.starts_with(root.path.to_string_lossy()))
    assert(!first_generation.contains("/nix/store/"), "{first_generation}")
    hangar_objects := []
    for entry in fs.read_dir(OSPath.from(first_store_root).join("hangar")) ?? panic("native hangar") {
        path :: (entry ?? panic("hangar entry")).path()
        if path.join("meta.json").is_file() { hangar_objects.push(path) }
    }
    assert(!hangar_objects.is_empty(), "native install did not register Hangar metadata")
    assert(hangar_objects.iter().any(path -> {
        metadata :: fs.read_to_string(path.join("meta.json")) ?? panic("hangar metadata")
        metadata.contains("omp@releases") && !metadata.contains("/nix/store/")
    }), "native package was not recorded as a Hangar-owned output: {hangar_objects:?}")
    write_native_omp_fixture(fixtures.path, "2.0.0", "#!/bin/sh\necho omp version two\n")
    fs.write(fixtures.path.join("channels.txt"), "github:can1357/oh-my-pi latest v2.0.0\n") ?? panic("write channel")
    second :: jetpack().args(["profile", "build", "tools", "--no-color", "--fixtures"]).arg(fixtures.path).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("native update")
    assert(second.status.success(), "native channel update failed: {String.from_utf8_lossy(second.stderr)}")
    second_run :: Command.new(link).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("run native two")
    assert_eq(String.from_utf8_lossy(second_run.stdout).trim(), "omp version two")
    rollback :: jetpack().args(["profile", "rollback", "tools", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("native rollback")
    assert(rollback.status.success(), "rollback failed: {String.from_utf8_lossy(rollback.stderr)}")
    rolled_back :: Command.new(link).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("run rolled back native")
    assert_eq(String.from_utf8_lossy(rolled_back.stdout).trim(), "omp version one")
}

// Rust: tests/jetpack_tool.rs:705
#Test("tool_profile_reports_drift_without_prompt_and_yes_moves_pin") {
    root :: Scratch.new("tool-drift-root")
    project :: Scratch.new("tool-drift-project")
    fixtures :: Scratch.new("tool-drift-fixtures")
    home :: Scratch.new("tool-drift-home")
    write_native_omp_fixture(fixtures.path, "1.0.0", "#!/bin/sh\necho omp version one\n")
    installed :: jetpack().args(["tool", "install", "omp@releases#1.0.0", "--no-color", "--offline", "--fixtures"]).arg(fixtures.path).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("drift install")
    assert(installed.status.success(), "install failed: {String.from_utf8_lossy(installed.stderr)}")
    manifest_path :: home.join(".jet/tools/manifest.json")
    manifest :: fs.read_to_string(manifest_path) ?? panic("read drift manifest")
    fs.write(manifest_path, manifest.replace("\"reference\":\"omp@releases#1.0.0\"", "\"reference\":\"omp@releases#0.9.0\"")) ?? panic("change pin")
    root_before :: filesystem_snapshot(root.path)
    home_before :: filesystem_snapshot(home.path)
    listed :: jetpack().args(["hangar", "list", "--json", "--offline", "--no-color", "--yes"]).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("read-only list")
    assert(listed.status.success(), "hangar list failed: {String.from_utf8_lossy(listed.stderr)}")
    assert(listed.stderr.is_empty(), "read-only hangar list emitted unexpected stderr: {String.from_utf8_lossy(listed.stderr)}")
    assert_eq(filesystem_snapshot(root.path), root_before, "hangar list changed Hangar bytes, metadata, or tree")
    assert_eq(filesystem_snapshot(home.path), home_before, "hangar list changed user profile bytes, metadata, or tree")
    report :: () -> { jetpack().args(["tool", "list", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("report drift") }
    first :: report()
    first_stderr :: String.from_utf8_lossy(first.stderr)
    assert(first.status.success(), "stderr: {first_stderr}")
    assert(first_stderr.contains("omp drifted"), "stderr: {first_stderr}")
    assert(first_stderr.contains("installed 1.0.0"), "stderr: {first_stderr}")
    assert(first_stderr.contains("pinned 0.9.0"), "stderr: {first_stderr}")
    assert(!first_stderr.contains("[Y/n]"), "non-interactive drift check prompted: {first_stderr}")
    assert((fs.read_to_string(manifest_path) ?? panic("read unchanged pin")).contains("\"reference\":\"omp@releases#0.9.0\""))
    second :: report()
    second_stderr :: String.from_utf8_lossy(second.stderr)
    assert(second.status.success(), "stderr: {second_stderr}")
    assert(second_stderr.contains("omp drifted"), "stderr: {second_stderr}")
    reconciled :: jetpack().args(["tool", "list", "--no-color", "-y"]).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("reconcile pin")
    assert(reconciled.status.success(), "reconcile failed: {String.from_utf8_lossy(reconciled.stderr)}")
    assert((fs.read_to_string(manifest_path) ?? panic("read moved pin")).contains("\"reference\":\"omp@releases#1.0.0\""))
    tool :: Command.new(home.join(".jet/bin/omp")).output() ?? panic("run pinned tool")
    assert_eq(String.from_utf8_lossy(tool.stdout).trim(), "omp version one")
}

// Rust: tests/jetpack_tool.rs:834
#Test("managed_tool_projection_write_failure_is_registered_and_actionable") {
    if selected_family() == "unix" {
        root :: Scratch.new("tool-write-root")
        project :: Scratch.new("tool-write-project")
        fixtures :: Scratch.new("tool-write-fixtures")
        home :: Scratch.new("tool-write-home")
        write_native_omp_fixture(fixtures.path, "1.0.0", "#!/bin/sh\necho omp version one\n")
        installed :: jetpack().args(["tool", "install", "omp@releases#1.0.0", "--no-color", "--offline", "--fixtures"]).arg(fixtures.path).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("write-failure install")
        assert(installed.status.success(), "install failed: {String.from_utf8_lossy(installed.stderr)}")
        bin_dir :: home.join(".jet/bin")
        permissions := (fs.metadata(bin_dir) ?? panic("bin metadata")).permissions()
        original_mode :: permissions.mode()
        permissions.set_mode(original_mode & !0o222)
        fs.set_permissions(bin_dir, permissions) ?? panic("deny bin writes")
        failed :: jetpack().args(["tool", "uninstall", "omp", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("failed uninstall")
        fs.set_permissions(bin_dir, fs.Permissions.from_mode(original_mode)) ?? panic("restore bin mode")
        stderr :: String.from_utf8_lossy(failed.stderr)
        assert_eq(failed.status.code(), Some(2), "stderr: {stderr}")
        assert(stderr.contains("Error [E1340]"), "stderr: {stderr}")
        assert(stderr.contains("managed tool `omp`"), "stderr: {stderr}")
        assert(stderr.contains("managed by jetpack"), "stderr: {stderr}")
        assert(stderr.contains("jetpack update tools -y"), "stderr: {stderr}")
    }
}

// Rust: tests/jetpack_tool.rs:890
#Test("declarative_user_tools_realize_outside_repo_and_rollback_runs_previous_generation") {
    (base, _project, root) :: core_hello_project("user-tools-declarative")
    repo :: base.join("jet-pkgs")
    outside :: Scratch.new("user-tools-outside")
    home :: Scratch.new("user-tools-home")
    manifest_dir :: home.join(".jet/tools")
    fs.create_dir_all(manifest_dir) ?? panic("create manifest directory")
    write_manifest :: (source: String, repo: OSPath) -> {
        upstream :: "path:{repo.to_string_lossy()}"
        fs.write(manifest_dir.join("manifest.json"), "{\n  \"profile\":\"tools\",\n  \"schema\":\"jet-user-tools-v1\",\n  \"sources\":[{\"name\":{source:?},\"policy\":\"pinned\",\"provider\":\"core\",\"raw\":{upstream:?},\"upstream\":{upstream:?}}],\n  \"tools\":[{\"bins\":[],\"members\":[],\"name\":\"hello\",\"reference\":\"hello@{source}\",\"resolved\":\"hello@{source}\",\"tier\":\"pinned\"}]\n}\n") ?? panic("write declarative manifest")
    }
    write_manifest("mine", repo)
    switch :: () -> { jetpack().args(["profile", "switch", "tools", "--no-color", "--offline"]).current_dir(outside.path).env("JETPACK_ROOT", root).env("HOME", home.path).output() ?? panic("switch declarative profile") }
    first :: switch()
    assert(first.status.success(), "first declarative switch failed\nstdout={String.from_utf8_lossy(first.stdout)}\nstderr={String.from_utf8_lossy(first.stderr)}")
    tool :: home.join(".jet/bin/hello")
    run :: (tool: OSPath) -> { Command.new(tool).env("JETPACK_ROOT", root).env("HOME", home.path).output() ?? panic("run declarative tool") }
    first_run :: run(tool)
    assert_eq(String.from_utf8_lossy(first_run.stdout).trim(), "hello from jet-pkgs")
    assert((fs.read_to_string(home.join(".jet/tools/current")) ?? panic("first pointer")).contains("generation\t1"))
    assert((fs.read_to_string(home.join(".jet/tools/profile.json")) ?? panic("first mirror")).contains("\"current\": 1"))
    repo_two :: base.join("jet-pkgs-two")
    fs.create_dir_all(repo_two.join("pkgs/hello/bin")) ?? panic("create second package")
    _ :: fs.copy(repo.join("package.jet"), repo_two.join("package.jet")) ?? panic("copy package")
    _ :: fs.copy(repo.join("pkgs/hello/hello.jet"), repo_two.join("pkgs/hello/hello.jet")) ?? panic("copy recipe")
    fs.write(repo_two.join("pkgs/hello/bin/hello"), "#!/bin/sh\necho hello from user-tools generation two\n") ?? panic("write second tool")
    if selected_family() == "unix" { fs.set_permissions(repo_two.join("pkgs/hello/bin/hello"), fs.Permissions.from_mode(0o755)) ?? panic("chmod second tool") }
    write_manifest("mine-two", repo_two)
    second :: switch()
    assert(second.status.success(), "second declarative switch failed\nstdout={String.from_utf8_lossy(second.stdout)}\nstderr={String.from_utf8_lossy(second.stderr)}")
    second_run :: run(tool)
    assert_eq(String.from_utf8_lossy(second_run.stdout).trim(), "hello from user-tools generation two")
    assert((fs.read_to_string(home.join(".jet/tools/current")) ?? panic("second pointer")).contains("generation\t2"))
    assert((fs.read_to_string(home.join(".jet/tools/profile.json")) ?? panic("second mirror")).contains("\"current\": 2"))
    rollback :: jetpack().args(["profile", "rollback", "tools", "--no-color"]).current_dir(outside.path).env("JETPACK_ROOT", root).env("HOME", home.path).output() ?? panic("rollback declarative profile")
    assert(rollback.status.success(), "rollback failed\nstdout={String.from_utf8_lossy(rollback.stdout)}\nstderr={String.from_utf8_lossy(rollback.stderr)}")
    rolled_back :: run(tool)
    assert_eq(String.from_utf8_lossy(rolled_back.stdout).trim(), "hello from jet-pkgs")
    assert((fs.read_to_string(home.join(".jet/tools/current")) ?? panic("rollback pointer")).contains("generation\t1"))
    assert((fs.read_to_string(home.join(".jet/tools/profile.json")) ?? panic("rollback mirror")).contains("\"current\": 1"))
    generations :: jetpack().args(["profile", "generations", "tools", "--no-color", "--json"]).current_dir(outside.path).env("JETPACK_ROOT", root).env("HOME", home.path).output() ?? panic("report generations")
    assert(generations.status.success())
    report :: String.from_utf8_lossy(generations.stdout)
    assert(report.contains("\"profile_bytes\":"), "{report}")
    assert(report.contains("\"generations_bytes\":"), "{report}")
    assert(report.contains("\"generation\":1"), "{report}")
    assert(report.contains("\"generation\":2"), "{report}")
    assert(report.contains("\"current\":true"), "{report}")
}

// Rust: tests/jetpack_tool.rs:1031
#Test("windows_logical_alias_executes_native_exe_with_exact_arguments_and_exit") {
    if selected_os() == "windows" {
        root :: Scratch.new("tool-win-root")
        proj :: Scratch.new("tool-win-proj")
        fixtures :: Scratch.new("tool-win-fx")
        home :: Scratch.new("tool-win-home")
        fs.create_dir_all(fixtures.path) ?? panic("create windows fixtures")
        out_dir :: root.path.join("hangar/provider-fixture-native")
        bin_dir :: out_dir.join("bin")
        fs.create_dir_all(bin_dir) ?? panic("create windows bin")
        system_root :: env.var_os("SystemRoot") ?? panic("SystemRoot")
        _ :: fs.copy(OSPath.from(system_root).join("System32/cmd.exe"), bin_dir.join("cmd.exe")) ?? panic("copy native cmd")
        json :: "[{\"drvPath\":\"C:\\\\fixture-native.drv\",\"outputs\":{\"out\":{out_dir.to_string_lossy():?}}}]"
        fs.write(fixtures.join("nixpkgs-native.json"), json) ?? panic("write windows fixture")
        output :: tool_install_command(root.path, proj.path, fixtures.path, home.path, "native").args(["--as", "native-alias"]).output() ?? panic("install native alias")
        assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
        alias :: home.join(".jet/bin/native-alias.exe")
        assert(alias.is_file())
        paths := [(alias.parent() ?? panic("alias parent")).to_path_buf()]
        if existing :: env.var_os("PATH") { paths.extend(env.split_paths(existing)) }
        path :: env.join_paths(paths) ?? panic("join windows PATH")
        status :: Command.new("native-alias").args(["/d", "/s", "/c", "if \"a&b\"==\"a&b\" (exit /b 23) else (exit /b 9)"]).env("HOME", home.path).env("PATH", path).status() ?? panic("run alias")
        assert_eq(status.code(), Some(23))
    }
}

// Rust: tests/jetpack_tool.rs:1085
#Test("concurrent_installs_serialize_and_retain_two_rooted_generations") {
    left_root :: Scratch.new("tool-concurrent-left-root")
    right_root :: Scratch.new("tool-concurrent-right-root")
    proj :: Scratch.new("tool-concurrent-proj")
    fixtures :: Scratch.new("tool-concurrent-fx")
    home :: Scratch.new("tool-concurrent-home")
    write_tool_bin_fixture(left_root.path, fixtures.path, "left", "left", "#!/bin/sh\necho left\n")
    write_tool_bin_fixture(right_root.path, fixtures.path, "right", "right", "#!/bin/sh\necho right\n")
    left_child :: tool_install_command(left_root.path, proj.path, fixtures.path, home.path, "left").stdout(Stdio.piped()).stderr(Stdio.piped()).spawn() ?? panic("spawn left install")
    right_child :: tool_install_command(right_root.path, proj.path, fixtures.path, home.path, "right").stdout(Stdio.piped()).stderr(Stdio.piped()).spawn() ?? panic("spawn right install")
    left :: left_child.wait_with_output() ?? panic("wait left")
    right :: right_child.wait_with_output() ?? panic("wait right")
    assert(left.status.success(), "left stderr: {String.from_utf8_lossy(left.stderr)}")
    assert(right.status.success(), "right stderr: {String.from_utf8_lossy(right.stderr)}")
    profile :: fs.read_to_string(home.join(".jet/tools/profile.json")) ?? panic("concurrent profile")
    assert(profile.contains("\"current\": 2"), "{profile}")
    first :: fs.read_to_string(home.join(".jet/tools/generations/1/meta.json")) ?? panic("first concurrent metadata")
    second :: fs.read_to_string(home.join(".jet/tools/generations/2/meta.json")) ?? panic("second concurrent metadata")
    assert(first.contains("left") || first.contains("right"), "{first}")
    assert(second.contains("left") && second.contains("right"), "{second}")
    assert(home.join(".jet/tools/generations/1/complete").is_file())
    assert(home.join(".jet/tools/generations/2/complete").is_file())
    left_roots :: lifecycle_wire(left_root.path)
    right_roots :: lifecycle_wire(right_root.path)
    generation_one :: ascii_hex("profile-generation:user:tools:1")
    generation_two :: ascii_hex("profile-generation:user:tools:2")
    assert(left_roots.contains(generation_one) || right_roots.contains(generation_one), "missing retained generation 1: left={left_roots}, right={right_roots}")
    assert(left_roots.contains(generation_two) && right_roots.contains(generation_two), "generation 2 must bind both Store authorities: left={left_roots}, right={right_roots}")
    listed :: jetpack().args(["tool", "list", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", left_root.path).env("HOME", home.path).output() ?? panic("list concurrent tools")
    assert(listed.status.success())
    stdout :: String.from_utf8_lossy(listed.stdout)
    assert(stdout.contains("left") && stdout.contains("right"), "{stdout}")
}

// Rust: tests/jetpack_tool.rs:1181
#Test("multi_store_root_commit_crash_recovers_before_pointer_switch") {
    left_root :: Scratch.new("tool-multiroot-left")
    right_root :: Scratch.new("tool-multiroot-right")
    proj :: Scratch.new("tool-multiroot-proj")
    fixtures :: Scratch.new("tool-multiroot-fx")
    home :: Scratch.new("tool-multiroot-home")
    write_tool_bin_fixture(left_root.path, fixtures.path, "left", "left", "#!/bin/sh\necho left\n")
    write_tool_bin_fixture(right_root.path, fixtures.path, "right", "right", "#!/bin/sh\necho right\n")
    left :: tool_install_command(left_root.path, proj.path, fixtures.path, home.path, "left").output() ?? panic("install first root")
    assert(left.status.success(), "{String.from_utf8_lossy(left.stderr)}")
    interrupted :: tool_install_command(right_root.path, proj.path, fixtures.path, home.path, "right").env("JETPACK_INTERNAL_TEST_PROFILE_FAILPOINT", "between-root-commits").output() ?? panic("interrupt roots")
    assert_eq(interrupted.status.code(), Some(2))
    assert(home.join(".jet/tools/generations/2/complete").is_file())
    assert((fs.read_to_string(home.join(".jet/tools/current")) ?? panic("old pointer")).contains("generation\t1"))
    recovered :: jetpack().args(["tool", "list", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", left_root.path).env("HOME", home.path).output() ?? panic("recover roots")
    assert(recovered.status.success(), "{String.from_utf8_lossy(recovered.stderr)}")
    assert((fs.read_to_string(home.join(".jet/tools/current")) ?? panic("new pointer")).contains("generation\t2"))
    generation_two :: ascii_hex("profile-generation:user:tools:2")
    assert(lifecycle_wire(left_root.path).contains(generation_two))
    assert(lifecycle_wire(right_root.path).contains(generation_two))
}

// Rust: tests/jetpack_tool.rs:1256
#Test("legacy_generation_is_verified_and_migrated_to_owned_projection") {
    root :: Scratch.new("tool-legacy-root")
    proj :: Scratch.new("tool-legacy-proj")
    fixtures :: Scratch.new("tool-legacy-fx")
    home :: Scratch.new("tool-legacy-home")
    write_tool_bin_fixture(root.path, fixtures.path, "greet", "greet", "#!/bin/sh\necho migrated greet\n")
    installed :: tool_install_command(root.path, proj.path, fixtures.path, home.path, "greet").output() ?? panic("install legacy fixture")
    assert(installed.status.success(), "{String.from_utf8_lossy(installed.stderr)}")
    canonical :: fs.read_to_string(home.join(".jet/tools/generations/1/meta.json")) ?? panic("canonical metadata")
    output_hash :: metadata_output_hash(canonical)
    store_root :: json_meta_field(canonical, "store_root")
    store_meta := None
    for entry in fs.read_dir(OSPath.from(store_root).join("hangar")) ?? panic("legacy hangar") {
        if item :: entry.ok() {
            path :: item.path().join("meta.json")
            if path.is_file() {
                metadata :: fs.read_to_string(path) ?? panic("store metadata")
                if metadata.contains("greet@nixpkgs") { store_meta = Some(metadata); break }
            }
        }
    }
    metadata := store_meta ?? panic("greet Store metadata")
    bin :: json_meta_field(metadata, "bin")
    metadata.clear()
    target :: OSPath.from(bin).join("greet").to_string_lossy().to_string()
    legacy :: "{\n  \"generation\": 1,\n  \"profile\": \"tools\",\n  \"created_at\": 1,\n  \"tools\": [\n    {\n      \"name\": \"greet\",\n      \"version\": \"\",\n      \"source\": \"nixpkgs\",\n      \"reference\": \"greet@nixpkgs\",\n      \"output_hash\": {output_hash:?},\n      \"bins\": [\"greet\"],\n      \"targets\": [{target:?}]\n    }\n  ]\n}\n"
    fs.write(home.join(".jet/tools/generations/1/meta.json"), legacy) ?? panic("write legacy metadata")
    fs.write(home.join(".jet/tools/generations/1/complete"), "complete\n") ?? panic("write legacy completion")
    fs.remove_file(home.join(".jet/tools/current")) ?? panic("remove pointer")
    fs.remove_file(home.join(".jet/tools/profile.json")) ?? panic("remove mirror")
    migrated :: jetpack().args(["tool", "list", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("migrate legacy")
    assert(migrated.status.success(), "{String.from_utf8_lossy(migrated.stderr)}")
    assert(home.join(".jet/tools/legacy-generations/generation-1").is_dir())
    assert(home.join(".jet/tools/generations/2/bin").join(physical_bin("greet")).is_file())
    current :: fs.read_to_string(home.join(".jet/tools/current")) ?? panic("migrated pointer")
    assert(current.contains("generation\t2"), "{current}")
    invoked :: Command.new(home.join(".jet/bin").join(physical_bin("greet"))).output() ?? panic("run migrated greet")
    assert(invoked.status.success())
    assert_eq(String.from_utf8_lossy(invoked.stdout).trim(), "migrated greet")
}

// Rust: tests/jetpack_tool.rs:1332
#Test("profile_failpoints_recover_conservatively_around_root_and_pointer_publish") {
    for phase in ["after-generation", "after-root-prepare", "after-root-commit", "before-pointer", "after-current-pointer", "after-pointer"] {
        root :: Scratch.new("tool-fail-{phase}-root")
        proj :: Scratch.new("tool-fail-{phase}-proj")
        fixtures :: Scratch.new("tool-fail-{phase}-fx")
        home :: Scratch.new("tool-fail-{phase}-home")
        write_tool_bin_fixture(root.path, fixtures.path, "greet", "greet", "#!/bin/sh\necho failpoint greet\n")
        failed :: tool_install_command(root.path, proj.path, fixtures.path, home.path, "greet").env("JETPACK_INTERNAL_TEST_PROFILE_FAILPOINT", phase).output() ?? panic("failpoint install")
        assert_eq(failed.status.code(), Some(2), "phase {phase}: {String.from_utf8_lossy(failed.stderr)}")
        assert(home.join(".jet/tools/generations/1/complete").is_file())
        pointer :: home.join(".jet/tools/current")
        mirror :: home.join(".jet/tools/profile.json")
        if phase == "after-pointer" {
            assert((fs.read_to_string(pointer) ?? panic("published pointer")).contains("generation\t1"), "phase {phase}")
            assert(mirror.is_file(), "phase {phase}")
        } else if phase == "after-current-pointer" {
            assert((fs.read_to_string(pointer) ?? panic("current-only pointer")).contains("generation\t1"))
            assert(!mirror.exists(), "phase {phase}")
        } else { assert(!pointer.exists(), "phase {phase}") }
        recovered :: jetpack().args(["tool", "list", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("recover failpoint")
        assert(recovered.status.success(), "phase {phase}: {String.from_utf8_lossy(recovered.stderr)}")
        pointer_text :: fs.read_to_string(pointer) ?? panic("recovered pointer")
        assert(pointer_text.contains("generation\t1"), "phase {phase}: {pointer_text}")
        assert(home.join(".jet/tools/generations/1").is_dir())
        assert(!home.join(".jet/tools/generations/2").exists())
        roots :: lifecycle_wire(root.path)
        assert(roots.contains(ascii_hex("profile-generation:user:tools:1")), "phase {phase}: {roots}")
    }
}

// Rust: tests/jetpack_tool.rs:1412
#Test("tool_install_job_collision_is_e1297_snapshot") {
    // Collision guidance teaches the canonical email-order reference.
    root :: Scratch.new("tool-collide-root")
    proj :: Scratch.new("tool-collide-proj")
    fixtures :: Scratch.new("tool-collide-fx")
    home :: Scratch.new("tool-collide-home")
    write_tool_bin_fixture(root.path, fixtures.path, "serve", "serve", "#!/bin/sh\necho serve tool\n")
    fs.write(proj.join("main.jet"), "#Job fn serve() -> {\n    print(\"task\")\n}\n\nfn run() -> {\n    print(\"run\")\n}\n") ?? panic("write colliding job")
    output :: jetpack().args(["tool", "install", "serve@nixpkgs", "--no-color", "--offline", "--fixtures"]).arg(fixtures.path).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output() ?? panic("install colliding tool")
    assert_eq(output.status.code(), Some(2), "stderr: {String.from_utf8_lossy(output.stderr)}")
    stderr :: String.from_utf8_lossy(output.stderr)
    diagnostic := if idx :: stderr.find("\n  error[E1297]") { stderr[idx..] } else { stderr } // #4303
    assert_jetos_stderr_snapshot("tool_job_collide", diagnostic)
    assert(!home.join(".jet/bin").join(physical_bin("serve")).exists())
}

// Rust: tests/jetpack_tool.rs:1461
#Test("test_runs_unimported_sibling_jet_tests_and_propagates_failure") {
    project :: Scratch.new("test-project")
    root :: Scratch.new("test-root")
    fs.write(project.join("package.jet"), "name: \"test_project\"\nversion: \"0.1.0\"\n") ?? panic("write package")
    fs.write(project.join("main.jet"), "#Test(\"entry test\") {\n    assert(true)\n}\n") ?? panic("write entry test")
    fs.write(project.join("sibling_test.jet"), "#Test(\"unimported sibling test\") {\n    assert(false)\n}\n") ?? panic("write failing sibling")
    fs.write(project.join("env.jet"), "use jetpack as pkg\npub fn shell() -> [JSON] { [pkg.source(\"local\", \"./\", \"core\"), pkg.packages([\"test_project@local\"]), pkg.prompt(\"test\")] }\n") ?? panic("write environment")
    output :: jetpack().args(["test", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output() ?? panic("run package tests")
    assert(!output.status.success(), "jet test must report the failing test\nstdout: {String.from_utf8_lossy(output.stdout)}\nstderr: {String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8_lossy(output.stdout)
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stdout.contains("unimported sibling test") || stderr.contains("unimported sibling test"), "test name missing from output:\nstdout: {stdout}\nstderr: {stderr}")
    assert(stdout.contains("FAIL") || stderr.contains("FAIL"), "failure missing from output:\nstdout: {stdout}\nstderr: {stderr}")
}

