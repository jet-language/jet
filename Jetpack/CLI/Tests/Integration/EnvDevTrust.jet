// Rust: tests/env_dev_trust.rs:571
#Test("config_trust_list_and_remove") {
    home :: Scratch.new("config-trust-list")
    pattern :: "/some/project/*"
    _ :: jetpack().args(["config", "trust", "add", pattern, "--no-color"]).env("HOME", home.path).output() ?? panic("add")
    list_out :: jetpack().args(["config", "trust", "list", "--no-color"]).env("HOME", home.path).output() ?? panic("list")
    assert(list_out.status.success())
    stderr :: String.from_utf8_lossy(list_out.stderr)
    assert(stderr.contains(pattern), "stderr: {stderr}")
    remove_out :: jetpack().args(["config", "trust", "remove", pattern, "--no-color"]).env("HOME", home.path).output() ?? panic("remove")
    assert(remove_out.status.success())
    trust_file :: home.path.join(".jet").join("trust")
    contents :: fs.read_to_string(trust_file).unwrap_or_default()
    assert(!contents.contains(pattern), "contents: {contents}")
}
// Rust: tests/env_dev_trust.rs:602
#Test("top_level_jet_trust_grant_list_explain_revoke") {
    home :: Scratch.new("top-level-jet-trust")
    grant :: jet().args(["trust", "grant", "acme/web@github:postgres.service", "--scope", "repo", "--color=never"]).env("HOME", home.path).output() ?? panic("grant")
    assert(grant.status.success(), "stderr: {String.from_utf8_lossy(grant.stderr)}")
    list :: jet().args(["trust", "list", "--json", "--color=never"]).env("HOME", home.path).output() ?? panic("list")
    assert(list.status.success())
    stdout :: String.from_utf8_lossy(list.stdout)
    assert(stdout.contains("\"authority\":\"service\""), "stdout: {stdout}")
    assert(stdout.contains("\"subject\":\"acme/web@github:postgres.service\""), "stdout: {stdout}")
    assert(stdout.contains("\"scope\":\"repo\""), "stdout: {stdout}")
    explain :: jet().args(["trust", "explain", "service:acme/web@github:postgres.service", "--color=never"]).env("HOME", home.path).output() ?? panic("explain")
    assert(explain.status.success())
    stderr :: String.from_utf8_lossy(explain.stderr)
    assert(stderr.contains("exact authority: service"), "stderr: {stderr}")
    revoke :: jet().args(["trust", "revoke", "service:acme/web@github:postgres.service", "--color=never"]).env("HOME", home.path).output() ?? panic("revoke")
    assert(revoke.status.success())
    list_after :: jet().args(["trust", "list", "--json", "--color=never"]).env("HOME", home.path).output() ?? panic("list after")
    assert_eq(String.from_utf8_lossy(list_after.stdout).trim(), "{\"grants\":[]}")
}
// Rust: tests/env_dev_trust.rs:681
#Test("top_level_jet_trust_grant_scope_needs_value") {
    home :: Scratch.new("trust-scope-value-home")
