        loop index in 0..70 {
            _ :: ingest_fixture(&writer_roots, "reader-compact-{index}", [(String, String)]{("out", "reader-compact-bytes-{index}")}, [String]{})
        }
    })
    reader_root :: roots.root.clone()
    reader :: thread.spawn(() -> {
        reader_roots :: Roots{root: reader_root, dev_mode: true}
        previous := 0
        loop _ in 0..100 {
            count :: (closure_graph(&reader_roots) ?? panic("reader graph")).records.len()
            assert(count >= previous, "reader observed a stale graph")
            previous = count
        }
    })
    writer.join() ?? panic("writer join")
    reader.join() ?? panic("reader join")
    assert_eq((closure_graph(&roots) ?? panic("graph")).records.len(), 70)
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:869
#Test("cas_pool_hardlink_preserves_cache_verification_and_rejects_outside_peers") {
    if sys.target.selected_family() != "unix" -> return
    (roots, _g) :: temp_roots()
    src_c :: roots.root.join("cas-c")
    fs.create_dir_all(src_c) ?? panic("c")
    fs.write(src_c.join("payload"), "shared-cas-bytes") ?? panic("c shared")
    fs.write(src_c.join("unique"), "c-only") ?? panic("c unique")
    src_d :: roots.root.join("cas-d")
    fs.create_dir_all(src_d) ?? panic("d")
    fs.write(src_d.join("payload"), "shared-cas-bytes") ?? panic("d shared")
    fs.write(src_d.join("unique"), "d-only") ?? panic("d unique")
    third :: ingest_tree(&roots, &IngestRequest{name: "cas-c", version: "1", reference: "path:cas-c", cache_identity: test_identity(),
        references: [String]{}, outputs: [String: OSPath]{"out": src_c}, signature: "", provenance: "", platform_artifact_kind: ""}) ?? panic("ingest c")
    fourth :: ingest_tree(&roots, &IngestRequest{name: "cas-d", version: "1", reference: "path:cas-d", cache_identity: test_identity(),
        references: [String]{}, outputs: [String: OSPath]{"out": src_d}, signature: "", provenance: "", platform_artifact_kind: ""}) ?? panic("ingest d")
    assert_ne(third.entry.envelope.output_hash, fourth.entry.envelope.output_hash)
    pay_c :: OSPath.from(third.entry.out).join("payload")
    assert((fs.metadata(pay_c) ?? panic("metadata")).nlink() >= 2)
    report :: optimize_cas_pool(&roots) ?? panic("optimize")
    assert_eq(report.optimized_files, 0, "{report:?}")
    assert(roots.shared_cas_dir().is_dir())
    assert((fs.metadata(pay_c) ?? panic("metadata")).nlink() >= 2)
    verify_hangar_object(&roots, &third.entry) ?? panic("verify c")
    verify_hangar_object(&roots, &fourth.entry) ?? panic("verify d")
    expectation :: test_expectation(OSPath.from(third.entry.out))
    proof :: verify_cache_entry(&roots, &third.entry, &third.entry.reference, &expectation)
    assert(proof.output_digest, "{proof:?}")
    assert(proof.trusted(), "{proof:?}")
    ((find_verified_by_reference(&roots, &third.entry.reference, &expectation) ?? panic("find")) ?? panic("verified entry")).lease.validate() ?? panic("validate lease")
    outside :: roots.root.join("outside-peer")
    fs.hard_link(pay_c, outside) ?? panic("outside peer")
    in_hangar :: Envelope.try_output_hash_of_in_hangar(&third.entry.out, &roots.hangar_dir(), false)
    assert_eq(in_hangar ?? panic("pool-backed hash"), third.entry.envelope.output_hash)
    pool_proof :: verify_cache_entry(&roots, &third.entry, &third.entry.reference, &expectation)
    assert(pool_proof.output_digest, "{pool_proof:?}")
    assert(pool_proof.trusted(), "{pool_proof:?}")
    ((find_verified_by_reference(&roots, &third.entry.reference, &expectation) ?? panic("find")) ?? panic("verified entry")).lease.validate() ?? panic("validate lease")
    _ :: fs.remove_file(outside).ok()
    non_pool :: roots.hangar_dir().join("non-pool-output")
    fs.create_dir_all(non_pool) ?? panic("non pool")
    non_pool_payload :: non_pool.join("payload")
    fs.write(non_pool_payload, "unpooled") ?? panic("unpooled")
    non_pool_peer :: roots.root.join("outside-non-pool-peer")
    fs.hard_link(non_pool_payload, non_pool_peer) ?? panic("foreign peer")
    non_pool_result :: Envelope.try_output_hash_of_in_hangar(non_pool.to_string_lossy(), &roots.hangar_dir(), false)
    assert(non_pool_result.is_err(), "{non_pool_result:?}")
    _ :: fs.remove_file(non_pool_peer).ok()
    _ :: fs.remove_dir_all(non_pool).ok()
}

