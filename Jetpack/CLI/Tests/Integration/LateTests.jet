// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:4
#Test("ingest_installs_valid_secondary_named_output_with_matching_digest") {
    (roots, _g) :: temp_roots()
    out :: roots.root.join("src-primary")
    dev :: roots.root.join("src-dev")
    fs.create_dir_all(out) ?? panic("create primary")
    fs.write(out.join("payload"), "primary") ?? panic("write primary")
    fs.write(dev, "development") ?? panic("write dev")
    if sys.target.selected_family() == "unix" {
        fs.symlink("payload", out.join("payload-link")) ?? panic("symlink")
    }
    outputs :: [String: OSPath]{"out": out, "dev": dev}
    ingested :: ingest_tree(&roots, &IngestRequest{
        name: "named-output", version: "1", reference: "path:named-output",
        cache_identity: test_identity(), references: [String]{}, outputs: outputs,
        signature: "", provenance: "", platform_artifact_kind: ""
    }) ?? panic("ingest")
    dev_digest :: ingested.entry.named_outputs.get("dev") ?? panic("dev digest")
    installed :: roots.hangar_dir().join("objects").join(dev_digest)
    assert_eq(fs.read_to_string(installed) ?? panic("read dev"), "development")
    if sys.target.selected_family() == "unix" {
        assert_eq(fs.read_link(OSPath.from(ingested.entry.out).join("payload-link")) ?? panic("read link"), OSPath.from("payload"))
    }
    actual :: Envelope.try_output_hash_of(installed.to_string_lossy()) ?? panic("hash dev")
    assert_eq(ingested.entry.named_outputs.get("dev"), Val(actual))
    verify_hangar_object(&roots, &ingested.entry) ?? panic("verify")
}

