    fs.create_dir_all(right) ?? panic("right")
    fs.write(left.join("f"), "x") ?? panic("left payload")
    fs.write(right.join("f"), "x") ?? panic("right payload")
    a :: ingest_tree(&roots, &IngestRequest{
        name: "a", version: "1", reference: "path:left", cache_identity: test_identity(),
        references: [String]{}, outputs: [String: OSPath]{"out": left},
        signature: "", provenance: "", platform_artifact_kind: ""
    }) ?? panic("ingest left")
    b :: ingest_tree(&roots, &IngestRequest{
        name: "b", version: "1", reference: "path:right", cache_identity: test_identity(),
        references: [String]{}, outputs: [String: OSPath]{"out": right},
        signature: "", provenance: "", platform_artifact_kind: ""
    }) ?? panic("ingest right")
    assert_eq(a.entry.envelope.output_hash, b.entry.envelope.output_hash)
    assert(b.deduplicated)
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:92
#Test("closure_graph_named_outputs_are_independent_and_queries_are_cycle_safe") {
    (roots, _g) :: temp_roots()
    base :: ingest_fixture(&roots, "base", [(String, String)]{("out", "base")}, [String]{})
    middle :: ingest_fixture(&roots, "middle", [(String, String)]{("out", "middle")}, [String]{base.entry.envelope.output_hash})
    consumer :: ingest_fixture(&roots, "consumer", [(String, String)]{("out", "consumer-out"), ("dev", "consumer-dev")}, [String]{middle.entry.envelope.output_hash})
    primary :: consumer.entry.envelope.output_hash.clone()
    dev :: (consumer.entry.named_outputs.get("dev") ?? panic("dev")).clone()
    assert_ne(primary, dev)
    assert_eq(direct_references_of(&roots, &primary) ?? panic("references"), [String]{middle.entry.envelope.output_hash})
    assert_eq(direct_references_of(&roots, &dev) ?? panic("dev references"), [String]{middle.entry.envelope.output_hash})
    assert_eq(transitive_references_of(&roots, &dev) ?? panic("transitive"), [String]{base.entry.envelope.output_hash, middle.entry.envelope.output_hash})
    expected_closure := [String]{base.entry.envelope.output_hash, dev, middle.entry.envelope.output_hash}
    &expected_closure.sort()
    assert_eq(closure_of(&roots, &dev) ?? panic("closure"), expected_closure)
    assert_eq(referrers_of(&roots, &middle.entry.envelope.output_hash) ?? panic("referrers"), [String]{dev, primary})
    action :: entry_action_key(&consumer.entry)
    assert_eq((action_outputs_of(&roots, &action) ?? panic("action outputs")).get("dev"), Val(dev))
    assert_eq(actions_for_output(&roots, &primary) ?? panic("actions"), [String]{action})
    _ :: ingest_fixture(&roots, "base", [(String, String)]{("out", "base")}, [String]{primary})
    transitive :: transitive_references_of(&roots, &primary) ?? panic("cycle traversal")
    assert(transitive.contains(base.entry.envelope.output_hash))
    assert(transitive.contains(middle.entry.envelope.output_hash))
    assert(!transitive.contains(primary))
    expected_referrers := [String]{dev, middle.entry.envelope.output_hash, primary}
    &expected_referrers.sort()
    assert_eq(transitive_referrers_of(&roots, &base.entry.envelope.output_hash) ?? panic("reverse traversal"), expected_referrers)
    expected_reverse_closure := [String]{base.entry.envelope.output_hash, dev, middle.entry.envelope.output_hash, primary}
    &expected_reverse_closure.sort()
    assert_eq(reverse_closure_of(&roots, &base.entry.envelope.output_hash) ?? panic("reverse closure"), expected_reverse_closure)
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:173
#Test("closure_refresh_and_delete_remove_stale_reverse_edges") {
    (roots, _g) :: temp_roots()
    left :: ingest_fixture(&roots, "left", [(String, String)]{("out", "left")}, [String]{})
    right :: ingest_fixture(&roots, "right", [(String, String)]{("out", "right")}, [String]{})
    consumer :: ingest_fixture(&roots, "refresh", [(String, String)]{("out", "same")}, [String]{left.entry.envelope.output_hash})
    assert_eq(referrers_of(&roots, &left.entry.envelope.output_hash) ?? panic("left referrers"), [String]{consumer.entry.envelope.output_hash})
    refreshed :: ingest_fixture(&roots, "refresh", [(String, String)]{("out", "same")}, [String]{right.entry.envelope.output_hash})
    assert((closure_graph(&roots) ?? panic("graph")).referrers(left.entry.envelope.output_hash).is_empty())
    assert_eq((closure_graph(&roots) ?? panic("graph")).referrers(right.entry.envelope.output_hash), [String]{refreshed.entry.envelope.output_hash})
    assert(remove_closure_record(&roots, &refreshed.entry.id) ?? panic("remove record"))
    stale_meta :: roots.hangar_dir().join(refreshed.entry.id).join("meta.json")
    fs.write(stale_meta, refreshed.entry.meta_json()) ?? panic("stale meta")
    assert((closure_graph(&roots) ?? panic("graph")).referrers(right.entry.envelope.output_hash).is_empty())
    assert(!stale_meta.exists())
    assert(!(remove_closure_record(&roots, &refreshed.entry.id) ?? panic("remove again")))
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:219
#Test("closure_rejects_one_action_mapping_to_different_outputs") {
    (roots, _g) :: temp_roots()
    make :: (name: String, bytes: String) -> {
        out :: roots.root.join(name)
        fs.create_dir_all(out) ?? panic("create output")
        fs.write(out.join("payload"), bytes) ?? panic("write output")
        envelope :: Envelope.for_output(out.to_string_lossy(), "path:same-action", "action-conflict")
        record_verified(&roots, name, "1", "path:same-action", out.to_string_lossy(), "", "", &envelope, &test_identity())
    }
    make("first-action-output", "first") ?? panic("first action")
    error :: make("second-action-output", "second").err() ?? panic("expected conflict")
    assert(error.to_string().contains("conflicting bytes"))
    assert_eq((closure_graph(&roots) ?? panic("graph")).records.len(), 1)
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:249
#Test("closure_action_key_includes_sorted_reference_digests") {
    (roots, _g) :: temp_roots()
    first :: ingest_fixture(&roots, "key-first", [(String, String)]{("out", "first")}, [String]{})
    second :: ingest_fixture(&roots, "key-second", [(String, String)]{("out", "second")}, [String]{})
    entry := first.entry.clone()
    entry.references = [String]{second.entry.envelope.output_hash, first.entry.envelope.output_hash}
    ordered :: entry_action_key(&entry)
    &entry.references.reverse()
    assert_eq(entry_action_key(&entry), ordered)
    _ :: &entry.references.pop()
    assert_ne(entry_action_key(&entry), ordered)
    left := first.entry.clone()
    left.reference = "a\nsource=b"
    left.cache_identity.source_fingerprint = "c"
    right := first.entry.clone()
    right.reference = "a"
    right.cache_identity.source_fingerprint = "b\nsource=c"
    assert_ne(entry_action_key(&left), entry_action_key(&right))
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:274
#Test("closure_action_key_excludes_realized_outputs_but_keeps_action_facts") {
    (roots, _g) :: temp_roots()
    entry := ingest_fixture(&roots, "action-projection", [(String, String)]{("out", "bytes")}, [String]{}).entry
    original_record :: entry.producer_record.clone()
    original :: entry_action_key(&entry)
    producer := ProducerRecord.decode(entry.producer_record) ?? panic("producer")
    replay := producer.plan.facts().clone()
    &replay.insert("output.out", "sha256-different")
    producer.plan = ProviderPlanFacts.from_facts(replay) ?? panic("plan")
    entry.producer_record = producer.encode()
    assert_eq(entry_action_key(&entry), original)
    producer = ProducerRecord.decode(entry.producer_record) ?? panic("producer")
    replay = producer.plan.facts().clone()
    &replay.insert("action.recipe", "different-recipe")
    producer.plan = ProviderPlanFacts.from_facts(replay) ?? panic("plan")
    entry.producer_record = producer.encode()
    assert_ne(entry_action_key(&entry), original)
    producer = ProducerRecord.decode(original_record) ?? panic("original producer")
    &producer.toolchain_facts.push_str("-different")
    entry.producer_record = producer.encode()
    assert_ne(entry_action_key(&entry), original)
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:302
#Test("nix_action_key_is_input_derivation_only") {
    (roots, _g) :: temp_roots()
    first := ingest_fixture(&roots, "nix-action", [(String, String)]{("out", "bytes")}, [String]{}).entry
    nix_record :: (drv: String, output: String, reference: String) -> {
        (ProducerRecord.new("nix", drv, SHA256.sha256_hex(drv.as_bytes()),
            ProviderPlanFacts.from_facts([String: String]{"nix.drv_path": drv, "nix.reference": reference, "nix.output.out": output}) ?? panic("plan"),
            "nix-derivation:{drv}", "policy=test\nplatform=test", [String: String]{"nix.output.out": output}) ?? panic("producer")).encode()
    }
    first.reference = "first@nixpkgs"
    first.cache_identity.source_fingerprint = "sha256-first-output"
    first.producer_record = nix_record("/nix/store/action.drv", "/nix/store/first", "first@nixpkgs")
    action :: entry_action_key(&first)
    second := first.clone()
    second.reference = "alias:second"
    second.cache_identity.source_fingerprint = "sha256-second-output"
    second.producer_record = nix_record("/nix/store/action.drv", "/nix/store/second", "alias:second")
    assert_eq(entry_action_key(&second), action)
    second.producer_record = nix_record("/nix/store/other.drv", "/nix/store/second", "alias:second")
    assert_ne(entry_action_key(&second), action)
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:342
#Test("nix_multi_projection_registers_recovers_queries_and_rolls_back_conflict") {
    (roots, _g) :: temp_roots()
    out_source :: ingest_fixture(&roots, "projection-out-bytes", [(String, String)]{("out", "out")}, [String]{})
    dev_source :: ingest_fixture(&roots, "projection-dev-bytes", [(String, String)]{("out", "dev")}, [String]{})
    conflict :: ingest_fixture(&roots, "projection-bad-dev", [(String, String)]{("out", "bad")}, [String]{})
    drv :: "/nix/store/multi-projection.drv"
    project :: (source: StoreEntry, id: String, output_name: String) -> {
        entry := source
        path :: entry.out.clone()
        entry.id = id
        entry.name = "multi-projection"
        entry.reference = "alias:{output_name}"
        entry.named_outputs = [String: String]{"out": entry.envelope.output_hash, output_name: entry.envelope.output_hash}
        entry.producer_record = (ProducerRecord.new("nix", drv, SHA256.sha256_hex(drv.as_bytes()),
            ProviderPlanFacts.from_facts([String: String]{"nix.drv_path": drv, "nix.reference": entry.reference, "nix.output.{output_name}": path}) ?? panic("plan"),
            "nix-derivation:{drv}", "policy=test\nplatform=test", [String: String]{"nix.output.{output_name}": path}) ?? panic("producer")).encode()
        entry
    }
    out :: project(out_source.entry, "projection-out", "out")
    dev :: project(dev_source.entry, "projection-dev", "dev")
    bad :: project(conflict.entry, "projection-bad", "dev")
    action :: entry_action_key(&out)
    assert_eq(entry_action_key(&dev), action)
    RuntimePolicy.with_lock(&roots.root, "hangar", () -> {
        register_entry_unlocked(&roots, &out)?
        register_entry_unlocked(&roots, &dev)
    }) ?? panic("register projections")
    fs.remove_file(roots.hangar_dir().join(dev.id).join("meta.json")) ?? panic("remove projection")
    outputs :: action_outputs_of(&roots, &action) ?? panic("recover outputs")
    assert_eq(outputs.get("out"), Val(out.envelope.output_hash))
    assert_eq(outputs.get("dev"), Val(dev.envelope.output_hash))
    assert(roots.hangar_dir().join(dev.id).join("meta.json").is_file())
    before :: closure_graph(&roots) ?? panic("before")
    error :: RuntimePolicy.with_lock(&roots.root, "hangar", () -> register_entry_unlocked(&roots, &bad)).err() ?? panic("expected conflict")
    assert(error.to_string().contains("conflicting bytes"))
    assert_eq(closure_graph(&roots) ?? panic("after"), before)
}

