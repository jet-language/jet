// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:480
#Test("closure_journal_recovers_partial_and_rejects_committed_corruption") {
    (roots, _g) :: temp_roots()
    _ :: ingest_fixture(&roots, "journal", [(String, String)]{("out", "journal")}, [String]{})
    journal :: roots.hangar_dir().join("closure-db/journal")
    fs.write(journal.join("999.partial"), "torn") ?? panic("partial")
    assert_eq(recover_closure_journal(&roots) ?? panic("recovery"), 1)
    assert(!journal.join("999.partial").exists())
    transaction :: (fs.read_dir(journal) ?? panic("journal")).flatten().map((entry) -> entry.path()).find((path) -> path.extension().and_then((ext) -> ext.to_str()) == Val("txn")) ?? panic("transaction")
    legacy_referrers :: roots.hangar_dir().join("referrers")
    fs.create_dir_all(legacy_referrers) ?? panic("legacy")
    fs.write(legacy_referrers.join("fake.refs"), "fallback-must-not-win\n") ?? panic("legacy refs")
    file := OpenOptions.new().append(true).open(transaction) ?? panic("append open")
    &file.write_all("corrupt".as_bytes()) ?? panic("corrupt transaction")
    error :: closure_graph(&roots).err() ?? panic("expected corruption")
    assert_eq(error.kind(), IOErrorKind.InvalidData)
    assert(error.to_string().contains("checksum"))
    assert(referrers_of(&roots, "fake").is_err())
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:516
#Test("committed_producer_transaction_recovers_missing_package_projection") {
    (roots, _g) :: temp_roots()
    ingested :: ingest_fixture(&roots, "producer-recovery", [(String, String)]{("out", "primary"), ("dev", "headers")}, [String]{})
    meta :: roots.hangar_dir().join(ingested.entry.id).join("meta.json")
    expected :: fs.read_to_string(meta) ?? panic("expected projection")
    fs.remove_file(meta) ?? panic("remove projection")
    assert_eq(recover_closure_journal(&roots) ?? panic("recover"), 1)
    assert((list_checked(&roots) ?? panic("list")).iter().any((entry) -> entry.id == ingested.entry.id))
    graph :: closure_graph(&roots) ?? panic("graph")
    record :: graph.records.get(ingested.entry.id) ?? panic("record")
    assert_eq((ProducerRecord.decode(record.producer_record) ?? panic("producer")).provider, "hangar-ingest")
    assert_eq(record.outputs.len(), 2)
    assert_eq(fs.read_to_string(meta) ?? panic("projection"), expected)
    fs.write(meta, "stale but parseable projection") ?? panic("stale")
    assert_eq(recover_closure_journal(&roots) ?? panic("recover stale"), 1)
    assert_eq(fs.read_to_string(meta) ?? panic("projection"), expected)
    fs.write(meta, [U8]{0xff, 0xfe, 0xfd}) ?? panic("invalid utf8")
    assert_eq(recover_closure_journal(&roots) ?? panic("recover bytes"), 1)
    assert_eq(fs.read_to_string(meta) ?? panic("projection"), expected)
    fs.remove_file(meta) ?? panic("remove")
    changed :: RuntimePolicy.with_lock(&roots.root, "hangar", () -> register_entry_unlocked(&roots, &ingested.entry)) ?? panic("register unchanged")
    assert(!changed)
    assert_eq(fs.read_to_string(meta) ?? panic("projection"), expected)
}

