// Rust: crates/jetpack/src/Store/Tests/tests/nix_projection.rs:331
#Test("nix_store_projection_includes_every_hangar_closure_object") {
    (roots, _guard) :: temp_roots()
    admitted :: admit_signed_closure(&roots)
    entries :: canonicalize_admitted_records(&roots, &admitted)
    root_path :: admitted.outputs["out"].store_path.clone()
    entry :: find_entry(&entries, &root_path)
    lease :: snapshot_lease(&roots, &entry) ?? panic("lease")
    projected := [OSPath: OSPath]{}
    loop (logical, source) in lease.nix_store_projection().iter() {
        resolved :: fs.read_link(source).unwrap_or_else((_) -> source.clone())
        assert(!resolved.starts_with("/nix/store"), "projection source escaped into the host store: {resolved.display()}")
        &projected.insert(logical.clone(), resolved)
    }
    expected_paths := [String]{}
    loop path in admitted.objects.keys() -> &expected_paths.push((path.strip_prefix("/nix/store/") ?? panic("store prefix")).to_string())
    &expected_paths.sort()
    actual_paths := [String]{}
    loop path in projected.keys() -> &actual_paths.push((path.strip_prefix("/nix/store/") ?? panic("store prefix")).to_string())
    &actual_paths.sort()
    assert_eq(actual_paths, expected_paths)
    assert(projected.values().all((path) -> path == lease.snapshot_root || path.starts_with(roots.hangar_dir().join(OBJECTS_DIR))))
}

// Rust: crates/jetpack/src/Store/Tests/tests/nix_projection.rs:368
#Test("nix_store_projection_rejects_missing_conflicting_or_external_objects") {
    {
        (roots, _guard) :: temp_roots()
        admitted :: admit_signed_closure(&roots)
        entries :: canonicalize_admitted_records(&roots, &admitted)
        root_path :: admitted.outputs["out"].store_path.clone()
        entry :: find_entry(&entries, &root_path)
        leaf :: admitted.objects.values().find((object) -> object.store_path != root_path) ?? panic("leaf")
        if fs.symlink_metadata(leaf.hangar_path) == {
            .Ok(metadata) -> {
                if !metadata.is_dir() {
                    println("skipping missing-object proof: admitted Hangar object is not a directory")
                    return
                }
            }
            .Err(error) -> {
                if error.kind() == IOErrorKind.NotFound {
                    println("skipping missing-object proof: admitted Hangar object is unavailable (ENOENT)")
                    return
                }
                panic("inspect admitted Hangar object: {error}")
            }
        }
        if make_tree_writable_for_removal(&leaf.hangar_path) == {
            .Ok(_) -> {}
            .Err(error) -> {
                if error.kind() == IOErrorKind.NotFound {
                    println("skipping missing-object proof: admitted Hangar object disappeared before permission update (ENOENT)")
                    return
                }
                panic("make admitted Hangar object writable: {error}")
            }
        }
        if fs.remove_dir_all(leaf.hangar_path) == {
            .Ok(_) -> {}
            .Err(error) -> {
                if error.kind() == IOErrorKind.NotFound {
                    println("skipping missing-object proof: admitted Hangar object disappeared during removal (ENOENT)")
                    return
                }
                panic("remove admitted Hangar object: {error}")
            }
        }
        error :: snapshot_lease(&roots, &entry).err() ?? panic("missing closure object must reject the lease")
        assert(error.to_string().contains("Hangar object"), "{error}")
    }
    {
        (roots, _guard) :: temp_roots()
        admitted :: admit_signed_closure(&roots)
        entries :: canonicalize_admitted_records(&roots, &admitted)
        root_path :: admitted.outputs["out"].store_path.clone()
        root_entry :: find_entry(&entries, &root_path)
        leaf_path :: (admitted.objects.keys().find((path) -> path != root_path) ?? panic("leaf path")).clone()
        conflict := (entries.iter().find((entry) -> {
            ProducerRecord.decode(entry.producer_record).ok().and_then((producer) -> producer.facts.get("nix.store-path").cloned()) == Val(leaf_path)
        }) ?? panic("leaf entry")).clone()
        conflict.name = "nix-projection-conflict"
        conflict.reference = "nix-projection-conflict@nixpkgs"
        conflict.id = entry_id(&conflict.name, &conflict.version, &conflict.reference, &conflict.out)
        producer := ProducerRecord.decode(conflict.producer_record) ?? panic("producer")
        &producer.facts.insert("nix.output.out", "/nix/store/conflicting-leaf")
        conflict.producer_record = producer.encode()
        &conflict.receipt.clear()
        // Registration rejects the conflicting owner before any lease sees it.
        error :: RuntimePolicy.with_lock(&roots.root, "hangar", () -> {
            Receipt.prepare_entry_receipt(&roots, &conflict)?
            Closure.register_entry_unlocked(&roots, &conflict)
        }).err() ?? panic("conflicting closure owner must be rejected at registration")
        assert(error.to_string().contains("conflicting bytes or provenance"), "{error}")
        lease :: snapshot_lease(&roots, &root_entry) ?? panic("the untouched root entry must still lease")
        drop(lease)
    }
    if sys.target.selected_family() == "unix" {
        (roots, _guard) :: temp_roots()
        admitted :: admit_signed_closure(&roots)
        entries :: canonicalize_admitted_records(&roots, &admitted)
        root_path :: admitted.outputs["out"].store_path.clone()
        entry :: find_entry(&entries, &root_path)
        leaf :: admitted.objects.values().find((object) -> object.store_path != root_path) ?? panic("leaf")
        // The canonical node hash must reject a symlink escaping the Hangar.
        target :: roots.root.join("external-object")
        fs.create_dir(target) ?? panic("external target")
        make_tree_writable_for_removal(&leaf.hangar_path) ?? panic("writable")
        fs.remove_dir_all(leaf.hangar_path) ?? panic("remove leaf")
        fs.symlink(target, leaf.hangar_path) ?? panic("external symlink")
        expectation :: CacheExpectation{identity: entry.cache_identity.clone(), owned_output: None, allow_unsigned_local: true}
        proof :: verify_cache_entry(&roots, &entry, &entry.reference, &expectation)
        assert(!proof.closure, "{proof:?}")
        assert(!proof.trusted(), "{proof:?}")
    }
}
