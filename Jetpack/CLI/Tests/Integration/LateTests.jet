// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:584
#Test("admission_failure_points_hide_partial_metadata_and_recover_idempotently") {
    points :: [AdmissionFailurePoint]{.AfterObjectPublication, .AfterReceiptPublication, .AfterClosureRegistration}
    loop (index, point) in points.iter().enumerate() {
        (roots, _g) :: temp_roots()
        source :: roots.root.join("failure-source-{index}")
        fs.create_dir_all(source) ?? panic("source")
        fs.write(source.join("payload"), "failure-{index}") ?? panic("payload")
        request :: IngestRequest{name: "failure-{index}", version: "1", reference: "path:failure-{index}",
            cache_identity: test_identity(), references: [String]{}, outputs: [String: OSPath]{"out": source},
            signature: "", provenance: "transaction-test", platform_artifact_kind: ""}
        result :: with_admission_failure(point, () -> ingest_tree(&roots, &request))
        assert(result.is_err(), "failure point {point:?} did not fire")
        if point != .AfterClosureRegistration {
            recover_hangar(&roots) ?? panic("recover")
            recover_hangar(&roots) ?? panic("recover again")
            assert((list_checked(&roots) ?? panic("list")).is_empty())
            assert_eq((fs.read_dir(roots.hangar_dir().join(OBJECTS_DIR)) ?? panic("objects")).count(), 0)
        } else {
            committed :: list_checked(&roots) ?? panic("committed")
            assert_eq(committed.len(), 1)
            meta :: roots.hangar_dir().join(committed[0].id).join("meta.json")
            fs.remove_file(meta) ?? panic("remove projection")
            recover_hangar(&roots) ?? panic("recover")
            recovered :: list_checked(&roots) ?? panic("recovered")
            recover_hangar(&roots) ?? panic("recover again")
            assert_eq(list_checked(&roots) ?? panic("list"), recovered)
            assert_eq(recovered, committed)
        }
    }
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:636
#Test("closure_legacy_migration_is_idempotent") {
    (roots, _g) :: temp_roots()
    first := ingest_fixture(&roots, "legacy-first", [(String, String)]{("out", "first")}, [String]{}).entry
    second := ingest_fixture(&roots, "legacy-second", [(String, String)]{("out", "second")}, [String]{}).entry
    first.references = [String]{second.envelope.output_hash}
    second.references = [String]{first.envelope.output_hash}
    fs.write(roots.hangar_dir().join(first.id).join("meta.json"), first.meta_json()) ?? panic("first meta")
    fs.write(roots.hangar_dir().join(second.id).join("meta.json"), second.meta_json()) ?? panic("second meta")
    fs.remove_dir_all(roots.hangar_dir().join("closure-db")) ?? panic("remove db")
    assert_eq(migrate_closure_graph(&roots) ?? panic("migrate"), 2)
    assert_eq(migrate_closure_graph(&roots) ?? panic("migrate again"), 0)
    graph :: closure_graph(&roots) ?? panic("graph")
    assert(graph.records.contains_key(first.id))
    assert(graph.records.contains_key(second.id))
    assert_eq(graph.direct_references(first.envelope.output_hash), first.references)
    assert_eq(graph.direct_references(second.envelope.output_hash), second.references)
}

