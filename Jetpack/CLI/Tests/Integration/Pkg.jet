// Rust: tests/pkg.rs:28
pub fn tmp_dir(label: &String) -> OSPath {
    base :: env.temp_dir().join("jet_pkg_{label}_{process.id()}")
    fs.create_dir_all(base).expect("create temp dir")
    base
}

// Rust: tests/pkg.rs:34
pub fn write(dir: &OSPath, rel: &String, content: &String) -> {
    path :: dir.join(rel)
    if parent :: path.parent() { fs.create_dir_all(parent).expect("create parent") }
    fs.write(path, content).expect("write fixture")
}

// Rust: tests/pkg.rs:42
pub fn first_diag_code(diags: &[Diagnostic]) -> String {
    diags.first().map((d) -> d.code.as_str()) ?? ""
}

// Rust: tests/pkg.rs:46
pub fn jet_bin() -> OSPath {
    // GATE #4494: test runner supplies the built native Jet executable.
    OSPath.from(env.var_os("CARGO_BIN_EXE_jet").expect("Jet test executable"))
}

// Rust: tests/pkg.rs:50
pub fn have_git() -> Bool { Command.new("git").arg("--version").output().is_ok() }

// Rust: tests/pkg.rs:54
pub fn jet_cmd(args: &[String], cwd: &OSPath, store_dir: &OSPath) -> Output {
    Command.new(jet_bin()).args(args).current_dir(cwd).env("JET_PACKAGE_STORE_DIR", store_dir).output().expect("jet binary should run")
}

// Rust: tests/pkg.rs:66
pub fn jet_cmd_env(args: &[String], cwd: &OSPath, envs: &[(String, String)]) -> Output {
    cmd := Command.new(jet_bin())
    cmd.args(args).current_dir(cwd)
    for (k, v) in envs { cmd.env(k, v) }
    cmd.output().expect("jet binary should run")
}

// Rust: tests/pkg.rs:110
pub fn isolated_crypto_helper_paths(home: &OSPath) -> (OSPath, OSPath) {
    real_helper :: FFI.cached_crypto_helper_path()
    real_root :: real_helper.ancestors().find((dir) -> dir.ends_with("ffi")).expect("the crypto helper lives under the FFI cache root")
    relative :: real_helper.strip_prefix(real_root).expect("helper relative path")
    helper :: home.join(".cache/jet/ffi").join(relative)
    cache_key :: ffi_bridge_key(&helper)
    rlib :: helper.parent().expect("helper parent").join("libjet_ffi_{cache_key}.rlib")
    (rlib, helper)
}

// Rust: tests/pkg.rs:131
// Test-only closed-status crypto helper and its verification sidecar.
pub fn install_closed_status_crypto_helper(home: &OSPath) -> {
    (rlib, helper) :: isolated_crypto_helper_paths(home)
    release :: helper.parent().expect("release dir")
    fs.create_dir_all(release).expect("create release dir")
    rlib_bytes :: "test cache sentinel".as_bytes().to_vec()
    fs.write(rlib, rlib_bytes).expect("write rlib sentinel")
    crate_stem :: rlib.file_stem().expect("rlib stem").to_str().expect("UTF-8 stem").to_string()
    cdylib :: release.join("{crate_stem}.{target.dll_extension()}") // GATE #4483
    cdylib_bytes :: "test cache cdylib sentinel".as_bytes().to_vec()
    fs.write(cdylib, cdylib_bytes).expect("write cdylib sentinel")
    signature :: "00".repeat(64)
    helper_bytes :: "#!/bin/sh\nIFS= read -r command\ncase \"$command\" in\n  keygen*) printf 'secret helper output' ; printf 'raw OS status and dependency text' >&2 ; exit 75 ;;\n  sign*) printf '%s\\n' '{signature}' ;;\n  verify*) exit 0 ;;\n  *) exit 1 ;;\nesac\n".into_bytes()
    fs.write(helper, helper_bytes).expect("write closed helper")
    if target.selected_family() == "unix" {
        fs.set_permissions(helper, fs.Permissions.from_mode(0o755)).expect("chmod helper")
    }
    crate_name :: crate_stem.strip_prefix("lib").expect("bridge rlib is `lib*`")
    manifest := "jet-ffi-artifacts-v2\n".to_string()
    for (bytes, path) in [(&rlib_bytes, &rlib), (&cdylib_bytes, &cdylib), (&helper_bytes, &helper)] {
        relative :: path.file_name().expect("artifact name").to_str().expect("UTF-8 artifact name")
        manifest.push_str("{SHA256.sha256_hex(bytes)} {relative}\n")
    }
    fs.write(release.join("{crate_name}.sha256"), manifest).expect("write verification sidecar")
}

// Rust: tests/pkg.rs:173
pub fn bare_registry(dir: &OSPath) -> String {
    _ :: Command.new("git").args(["init", "--bare", dir.to_str().expect("UTF-8 registry path")]).output().expect("git init")
    "file://{dir.to_str().expect("UTF-8 registry path")}"
}

// Rust: tests/pkg.rs:182
pub fn seed_core_review(dir: &OSPath, package: &String, version: &String) -> {
    work :: dir.with_extension("review-{process.id()}")
    url :: "file://{dir.to_str().expect("UTF-8 registry path")}"
    _ :: Command.new("git").args(["--git-dir", dir.to_str().expect("UTF-8 path"), "symbolic-ref", "HEAD", "refs/heads/main"]).status().expect("set registry HEAD")
    _ :: Command.new("git").args(["clone", url, work.to_str().expect("UTF-8 work path")]).status().expect("clone registry")
    review :: work.join("reviews").join(package).join("{version}.review")
    fs.create_dir_all(review.parent().expect("review parent")).expect("create review dir")
    fs.write(review, "jet-registry-core-review-v1\npackage={package}\nversion={version}\nreviewer=test-maintainer\ndecision=approved\n").expect("write review")
    for args in [["config", "user.email", "test@jet.test"], ["config", "user.name", "Jet Test"], ["add", "."], ["commit", "-m", "approve core package"], ["push", "origin", "HEAD:main"]] {
        _ :: Command.new("git").args(args).current_dir(work).status().expect("commit review")
    }
    fs.remove_dir_all(work).expect("remove review checkout")
}

// Rust: tests/pkg.rs:228
pub fn read_index_file(bare: &OSPath, name: &String) -> String? {
    spec :: "HEAD:index/{name}/{name}.jsonl"
    out :: Command.new("git").args(["--git-dir", bare.to_str().expect("UTF-8 path"), "show", spec]).output().expect("git show index")
    if out.status.success() { Some(String.from_utf8_lossy(out.stdout).to_string()) } else { None }
}

// Rust: tests/pkg.rs:243
pub fn init_clean_project(dir: &OSPath, name: &String, version: &String) -> {
    write(dir, "package.jet", &min_manifest(name, version))
    write(dir, "run.jet", "#Test(\"smoke\") {{ expect(1 == 1) }}\nfn run() {{ print(\"hi\") }}\n")
    for args in [["init", "-b", "main"], ["config", "user.email", "test@jet.test"], ["config", "user.name", "Jet Test"], ["add", "."], ["commit", "-m", "init"]] {
        _ :: Command.new("git").args(args).current_dir(dir).output().expect("initialize clean project")
    }
}

// Rust: tests/pkg.rs:266
pub fn with_store[T](store_dir: &OSPath, f: () -> T) -> T {
    _guard :: STORE_LOCK.lock().unwrap_or_else((e) -> e.into_inner())
    prev :: env.var("JET_PACKAGE_STORE_DIR").ok()
    env.set_var("JET_PACKAGE_STORE_DIR", store_dir)
    result :: f()
    match prev {
        Some(v) -> env.set_var("JET_PACKAGE_STORE_DIR", v)
        None -> env.remove_var("JET_PACKAGE_STORE_DIR")
    }
    result
}

// Rust: tests/pkg.rs:279
pub fn min_manifest(name: &String, version: &String) -> String {
    "name: \"{name}\"\nversion: \"{version}\"\njet: \">=0.1.0\"\ndescription: \"\"\nlicense: \"MIT\"\nrepository: \"\"\n"
}

// Rust: tests/pkg.rs:287
pub fn manifest_with_deps(name: &String, version: &String, dep_lines: &String) -> String {
    "{min_manifest(name, version)}\ndeps: {{\n{dep_lines}\n}}\n"
}

// Rust: tests/pkg.rs:299
pub fn graph_with_app() -> PackageGraph {
    graph := PackageGraph.new()
    graph.add_package(PackageNode.new("app").with_deps(["ui"]).with_transitives(["log"]))
    graph.add_package(PackageNode.new("ui").with_deps(["log"]))
    graph.add_package(PackageNode.new("worker").with_transitives(["log"]))
    graph
}

// Rust: tests/pkg.rs:312
pub fn semantic_record(owner: &String, key: &String, exact: &String) -> SemanticRecord {
    SemanticRecord.new(
        LockIdentity { kind: LockRecordKind.Package, key: key.to_string(), exact: exact.to_string(), hash: "sha256-{exact}", platform: "x86_64-linux" },
        LockRationale { owner_package: owner.to_string(), reason: "{owner} declared {key}", source_ref: "catalog:{key}", provider: "core", channel_input: "stable", exact_output: exact.to_string(), policy_fingerprint: "policy-1", recipe_id: "", adapter_id: "", signature: "ed25519:sig", cache_provenance: "hangar", update_command: "jet update {key}" }
    )
}

// Rust: tests/pkg.rs:339
pub fn semantic_record_with_hash(owner: &String, key: &String, exact: &String, hash: &String) -> SemanticRecord {
    record := semantic_record(owner, key, exact)
    record.identity.hash = hash.to_string()
    record
}

// Rust: tests/pkg.rs:350
pub fn replacement_identity(provider: &String, name: &String, version: &String) -> PackageIdentity {
    PackageIdentity.new(provider, name, version)
}

// Rust: tests/pkg.rs:358
pub fn replacement_surface(provider: &String, name: &String, version: &String) -> CompatibilitySurface {
    surface := CompatibilitySurface.new(PackageIdentity.new(provider, name, version))
    surface.public_symbols = [PublicSymbol.new("pad_left", "fn(String, Int) -> String").with_effects(["pure"]).with_errors(["ValueError"]), PublicSymbol.new("trim", "fn(String) -> String").with_effects(["pure"])]
    surface.examples = ["examples/replacement/pad.jet"]
    surface.goldens = [GoldenFixture.new("pad_left_basic", "  hi\n")]
    surface.platforms = ["x86_64-linux"]
    surface
}

// Rust: tests/pkg.rs:379
pub fn replacement_passed_candidate() -> ReplacementCandidate {
    foreign :: replacement_surface("npm", "left-pad", "1.0.0")
    native :: replacement_surface("core", "core.text.pad", "1.0.0")
    report :: Replacement.run_proof(&foreign, &native, "x86_64-linux")
    report.candidate("MIT", ["x86_64-linux"])
}
