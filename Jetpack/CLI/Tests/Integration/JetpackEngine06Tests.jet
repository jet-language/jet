// Rust: tests/jetpack_engine.rs:8996
#Test("two_process_reverse_package_order_does_not_deadlock") {
    base :: Scratch.new("reverse-order-leases")
    repo :: base.join("repo")
    root :: base.join("root")
    for name in ["a", "b"] {
        package :: repo.join("pkgs/{name}")
        fs.create_dir_all(package.join("bin")) ?? panic("create package")
        fs.write(package.join("{name}.jet"), "module {name} {{ }}\n") ?? panic("write module")
        tool :: package.join("bin/{name}")
        fs.write(tool, "#!/bin/sh\necho {name}\n") ?? panic("write tool")
        if sys.target.selected_family() == "unix" {
            fs.set_permissions(tool, fs.Permissions.from_mode(0o755)) ?? panic("chmod")
        }
    }
    fs.write(repo.join("package.jet"), "name: \"pair\"\nversion: \"1.0.0\"\npackages: { a: executable, b: executable }\n") ?? panic("write package")
    write_project :: (name: String, packages: [String]) -> {
        project :: base.join(name)
        fs.create_dir_all(project) ?? panic("create project")
        refs :: packages.iter().map((package) -> "\"{package}@mine\"").collect().join(", ")
        fs.write(project.join("env.jet"), "use jetpack as pkg\npub fn shell() -> [JSON] {{\n return [pkg.source(\"mine\", \"{repo.display()}\", \"core\"), pkg.packages([{refs}])]\n}}\n") ?? panic("write env")
        project
    }
    ab :: write_project("ab", ["a", "b"])
    ba :: write_project("ba", ["b", "a"])
    seeded :: jetpack().args(["build", "--no-color"]).current_dir(ab).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output() ?? panic("seed")
    assert(seeded.status.success(), "stderr: {String.from_utf8_lossy(seeded.stderr)}")
    spawn :: (project: OSPath) -> jetpack().args(["env", "--no-color", "--trust", "--", "/bin/sh", "-c", "true"]).current_dir(project).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").spawn().expect("spawn")
    first :: spawn(ab)
    second :: spawn(ba)
    assert((first.wait_with_output() ?? panic("first wait")).status.success())
    assert((second.wait_with_output() ?? panic("second wait")).status.success())
}

// Rust: tests/jetpack_engine.rs:9077
#Test("jet_build_never_reports_deleted_output_as_cached") {
    (_base, proj, root) :: core_hello_project("truth-deleted-cache")
    run :: () -> jetpack().args(["build", "--no-color"]).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output().expect("build")
    assert(run().status.success())
    roots :: Store.Roots { root: root.clone(), dev_mode: false }
    entry :: Store.find_by_reference(&roots, "hello@mine") ?? panic("find hello")
    make_tree_writable(OSPath.from(entry.out))
    fs.remove_dir_all(entry.out) ?? panic("delete output")
    rejected :: run()
    assert(!rejected.status.success())
    rejected_stderr :: String.from_utf8_lossy(rejected.stderr)
    assert(rejected_stderr.contains("E2604"), "stderr: {rejected_stderr}")
    rebuilt :: run()
    assert(rebuilt.status.success())
    stderr :: String.from_utf8_lossy(rebuilt.stderr)
    assert(stderr.contains("built"), "deleted output must rebuild: {stderr}")
    assert(!stderr.contains("1 cached"), "deleted output must never count as cache hit: {stderr}")
}

// Rust: tests/jetpack_engine.rs:9118
#Test("jet_build_never_reports_tampered_output_as_cached") {
    (_base, proj, root) :: core_hello_project("truth-tampered-cache")
    run :: () -> jetpack().args(["build", "--no-color"]).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output().expect("build")
    assert(run().status.success())
    roots :: Store.Roots { root: root.clone(), dev_mode: false }
    entry :: Store.find_by_reference(&roots, "hello@mine") ?? panic("find hello")
    make_tree_writable(OSPath.from(entry.out))
    fs.write(OSPath.from(entry.out).join("bin/hello"), "tampered") ?? panic("tamper")
    rejected :: run()
    assert(!rejected.status.success())
    rejected_stderr :: String.from_utf8_lossy(rejected.stderr)
    assert(rejected_stderr.contains("E2604"), "stderr: {rejected_stderr}")
    rebuilt :: run()
    assert(rebuilt.status.success())
    stderr :: String.from_utf8_lossy(rebuilt.stderr)
    assert(stderr.contains("built"), "tampered output must rebuild: {stderr}")
    assert(!stderr.contains("1 cached"), "tampered output must never count as cache hit: {stderr}")
}

// Rust: tests/jetpack_engine.rs:9159
#Test("jet_vendor_writes_pinned_sources") {
    (_base, proj, root) :: core_hello_project("t4-vendor")
    built :: jetpack().args(["build", "--no-color"]).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output() ?? panic("build")
    assert(built.status.success())
    out :: jetpack().args(["hangar", "vendor", "--no-color"]).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output() ?? panic("vendor")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    pin :: proj.join("vendor/hello.sha256")
    assert(pin.is_file(), "vendor must write a per-package sha256 pin")
    hash :: fs.read_to_string(pin) ?? panic("read pin")
    trimmed := hash.trim() // #4303
    assert(trimmed.starts_with("sha256-"), "the pin must be a content hash: {hash}")
    assert(proj.join("vendor/hello").is_dir(), "vendor must copy the package source tree")
}

// Rust: tests/jetpack_engine.rs:9199
#Test("jet_audit_reads_without_exec") {
    (_base, proj, root) :: core_hello_project("t4-audit")
    built :: jetpack().args(["build", "--no-color"]).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output() ?? panic("build")
    assert(built.status.success())
    out :: jetpack().args(["audit", "--no-color"]).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output() ?? panic("audit")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    report :: String.from_utf8_lossy(out.stderr)
    assert(report.contains("read-only, no build ran"), "audit is read-only: {report}")
    assert(report.contains("Provenance:"), "audit reports provenance: {report}")
    assert(report.contains("Source:"), "audit reports source identity: {report}")
    assert(report.contains("Action:"), "audit reports action identity: {report}")
    assert(report.contains("Sandbox:"), "audit reports sandbox policy: {report}")
    assert(report.contains("Closure:"), "audit reports closure: {report}")
    assert(report.contains("Leases:"), "audit reports executable lease state: {report}")
    assert(!report.contains("resolving"), "audit must not realize anything: {report}")
    journal :: root.join("hangar/closure-db/journal")
    fs.create_dir_all(journal) ?? panic("create journal")
    partial :: journal.join("00000000000000000099-corrupt.txn.partial")
    fs.write(partial, "interrupted") ?? panic("partial journal")
    broken :: jetpack().args(["audit", "--no-color"]).current_dir(proj).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output() ?? panic("broken audit")
    assert_eq(broken.status.code(), Val(2))
    broken_report :: String.from_utf8_lossy(broken.stderr)
    assert(broken_report.contains("Error [E1340]:"), "{broken_report}")
    assert(broken_report.contains("More: jet-lang.dev/e/E1340"), "{broken_report}")
    assert(partial.is_file(), "audit repaired a partial journal")
}

// Rust: tests/jetpack_engine.rs:9284
#Test("jet_inspect_audit_missing_inputs_fails_closed") {
    project :: Scratch.new("inspect-audit-missing-inputs")
    fs.write(project.join("package.jet"), "name: \"audit-probe\"\nversion: \"0.1.0\"\n") ?? panic("write package")
    missing_lock :: jet().args(["inspect", "audit", "--no-color"]).current_dir(project.path).env_remove("JET_ADVISORY_DB").env_remove("JET_ADVISORY_TRUST").env_remove("JET_ADVISORY_PUBLIC_KEY").output() ?? panic("missing lock")
    assert_eq(missing_lock.status.code(), Val(1))
    missing_lock_stderr :: String.from_utf8_lossy(missing_lock.stderr)
    assert(missing_lock_stderr.contains("E2611"), "{missing_lock_stderr}")
    assert(missing_lock_stderr.contains("unified lockfile"), "{missing_lock_stderr}")
    fs.create_dir_all(project.join(".jet")) ?? panic("create .jet")
    fs.write(project.join(".jet/lock"), "version = 1\n\n[[package]]\nname = \"audit-probe\"\nversion = \"0.1.0\"\nsource = { root = \".\" }\n\n[root]\ndependencies = []\n") ?? panic("write lock")
    missing_db :: jet().args(["inspect", "audit", "--no-color"]).current_dir(project.path).env_remove("JET_ADVISORY_DB").env_remove("JET_ADVISORY_TRUST").env_remove("JET_ADVISORY_PUBLIC_KEY").output() ?? panic("missing database")
    assert_eq(missing_db.status.code(), Val(1), "stdout={String.from_utf8_lossy(missing_db.stdout)} stderr={String.from_utf8_lossy(missing_db.stderr)}")
    missing_db_stderr :: String.from_utf8_lossy(missing_db.stderr)
    assert(missing_db_stderr.contains("E2611"), "{missing_db_stderr}")
    assert(missing_db_stderr.contains("signed advisory database"), "{missing_db_stderr}")
}

