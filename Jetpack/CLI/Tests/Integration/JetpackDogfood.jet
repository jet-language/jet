// Live compiler dogfood: shared coordinated target, fresh bounded disk-backed root.
use std.[env, fs]
use std.process.[Command, Output]
use core.files.OSPath
use jet_env_model.ModuleEval
use jetpack.Store
use jetpack.Store.ProducerRecord
use tests.common

// Rust: tests/jetpack_dogfood.rs:19
pub TEST :: "jet_repository_env_cold_and_offline_without_nix_host_store_or_fixtures"
// Rust: tests/jetpack_dogfood.rs:20
pub ROOT :: "JETPACK_DOGFOOD_ROOT"
// Rust: tests/jetpack_dogfood.rs:21
pub TARGET :: "JETPACK_DOGFOOD_TARGET_DIR"
// Rust: tests/jetpack_dogfood.rs:22
pub MODE :: "JETPACK_DOGFOOD_MODE"

// Rust: tests/jetpack_dogfood.rs:85
pub fn required_directory(variable: String) -> OSPath {
    // GATE #4494: actual native filesystem and environment.
    path :: OSPath.from(env.var_os(variable).unwrap_or_else(() -> panic("set {variable} explicitly")))
    assert(path.is_absolute() && path.is_dir(), "{variable} must be an existing absolute directory")
    canonical :: path.canonicalize().unwrap()
    assert(!canonical.starts_with("/tmp"), "dogfood scratch and target must be disk-backed")
    canonical
}

// Rust: tests/jetpack_dogfood.rs:93
pub fn command(base: OSPath, project: OSPath, target: OSPath) -> Command {
    command := Command.new(common.jetpack_bin())
    &command.env_clear().current_dir(project).env("PATH", "").env("HOME", base.join("home"))
        .env("TMPDIR", base.join("tmp")).env("JETPACK_ROOT", base.join("store"))
        .env("JETPACK_NIX_FALLBACK_POLICY", "deny").env("CARGO_TARGET_DIR", target)
        .env("CARGO_INCREMENTAL", "0").env("CARGO_BUILD_JOBS", "2").env("CARGO_NET_OFFLINE", "true")
        .env("CARGO_HOME", env.var_os("JETPACK_DOGFOOD_CARGO_HOME").unwrap())
        .env("RUST_MIN_STACK", "8388608").env("NO_COLOR", "1")
    if env.var_os("LD_LIBRARY_PATH") == Val(loader) { &command.env("LD_LIBRARY_PATH", loader) }
    command
}

// Rust: tests/jetpack_dogfood.rs:115
pub fn enter(base: OSPath, project: OSPath, target: OSPath, offline: Bool) -> Command {
    command := command(base, project, target)
    &command.args(["env", "--env", "compiler", "--trust", "--yes"])
    if offline { &command.arg("--offline").arg("--local-nix-catalog").arg(base.join("replaced-catalog")) }
    else { &command.arg("--local-nix-catalog").arg(project.join("crates/jetpack/catalogs/jet-dev").canonicalize().unwrap()) }
    &command.arg("--")
    command
}

// Rust: tests/jetpack_dogfood.rs:128
pub fn checked(base: OSPath, label: String, command: &Command) -> Output {
    output :: &command.output().unwrap_or_else(error -> panic("{label}: {error}"))
    fs.write(base.join("{label}.stdout"), output.stdout).unwrap()
    fs.write(base.join("{label}.stderr"), output.stderr).unwrap()
    assert(output.status.success(), "{label}: {output.status}\n{String.from_utf8_lossy(output.stderr)}")
    output
}

// Rust: tests/jetpack_dogfood.rs:136
pub fn run_phase(base: OSPath, project: OSPath, target: OSPath, offline: Bool) -> {
    mode :: if offline -> "offline" else -> "online"
    if !offline {
        update := command(base, project, target).args(["update", "default", "--env", "compiler", "--yes"])
            .arg("--local-nix-catalog").arg(project.join("crates/jetpack/catalogs/jet-dev").canonicalize().unwrap())
        _ :: checked(base, "update", &update)
    }
    tools := enter(base, project, target, offline).args(["bash", "-eu", "-c", """
! command -v nix
cargo --version
rustc --version
cc --version
node --version
python3 --version
bwrap --version
printf '#include <stdio.h>\nint main(void) {{ puts("native-c-ok"); }}\n' > "$TMPDIR/probe.c"
cc "$TMPDIR/probe.c" -o "$TMPDIR/probe"
test "$("$TMPDIR/probe")" = native-c-ok
printf 'JETPACK_NATIVE_TOOLS_OK\n'
"""])
    probe :: checked(base, "{mode}-tools", &tools)
    assert(String.from_utf8_lossy(probe.stdout).ends_with("JETPACK_NATIVE_TOOLS_OK\n"))
    if !offline {
        build := enter(base, project, target, false).args(["cargo", "build", "--locked", "--offline", "--bin", "jet", "-j", "2"])
        _ :: checked(base, "compiler-build", &build)
    }
    executable :: target.join("debug/jet")
    magic := [U8]{0, 0, 0, 0}
    fs.File.open(executable).unwrap().read_exact(&magic).unwrap()
    assert_eq(magic, [U8]{127, 69, 76, 70}, "compiler proof must execute a real compiled binary, not a shell fixture")
    smoke_command := enter(base, project, target, offline).arg(executable).args(["run", "Examples/features/basics/hello.jet"])
    smoke :: checked(base, "{mode}-compiler-smoke", &smoke_command)
    rendered := String.from_utf8(smoke.stdout).unwrap().trim() // #4303
    assert_eq(rendered, "hello, world")
    source :: fs.read_to_string(project.join("env.jet")).unwrap()
    plan :: ModuleEval.evaluate_env_with_environment(source, project, Val("compiler")).unwrap()
    roots :: Store.Roots.at(base.join("store"))
    entries :: Store.list_checked(roots).unwrap()
    loop reference in plan.package_refs {
        entry :: entries.iter().find(entry -> entry.reference == reference).unwrap_or_else(() -> panic("missing declared package {reference}"))
        producer :: ProducerRecord.decode(entry.producer_record).unwrap()
        assert_eq(producer.facts.get("nix.index.revision"), Val("3ed67ec0a4d3c7ab4ae1f04f8ee8df07bfa506a2"))
        assert_eq(producer.facts.get("nix.index.tier"), Val("local-unofficial"))
        assert(producer.facts.contains_key("nix.cache.closure.receipt.sha256"))
        assert(!producer.facts.contains_key("nix.fallback.provenance"))
    }
    du := command(base, project, target).args(["hangar", "du", "--json"])
    _ :: checked(base, "{mode}-du", &du)
}
