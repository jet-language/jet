// Rust: tests/env_overlay.rs:1
use Jetpack.CLI.Tests.Integration.EnvOverlay.*
use Jetpack.CLI.Tests.Integration.Common as common
use Compiler.Interpreter.[dev_iteration, RunOutcome]
use Compiler.[Loader, Sema, Diagnostics]
use jet_jit.[CraneliftBackend, cranelift_host_supported, reset_jit_trace_for_test, jit_executed_for_test, deopt_invoked_for_test, fallback_invoked_for_test]
use core.sys
use Core.Foundation.TEXT_NUL
// GATE #4494: real native processes, raw OS strings, threads, atomics and host environment access.
use std.[fs, Command, OsString, thread]

// Rust: tests/env_overlay.rs:52
#Test("mutation_enumeration_and_child_snapshot_run") {
    if sys.target.selected_family() != "unix" -> return
    src :: """
use core.sys as env
use core.process as process

fn run() -> {
    env.set("JET_OVERLAY_A", "one")
    env.set("JET_OVERLAY_B", "two")
    print(env.get("JET_OVERLAY_A") ?? "missing")
    names :: env.vars() ?? panic("vars failed")
    print(names.join(",").contains("JET_OVERLAY_A,JET_OVERLAY_B"))
    print(env.unset("JET_OVERLAY_A") ?? false)
    print(env.unset("JET_OVERLAY_A") ?? true)
    inherited :: process.cmd(["/usr/bin/env"]).run() ?? panic("child failed")
    print(inherited.output.contains("JET_OVERLAY_B=two"))
    print(!inherited.output.contains("JET_OVERLAY_A="))
    cleared :: process.cmd(["/usr/bin/env"])
        .env_clear().env("ONLY_THIS", "yes").env_remove("JET_OVERLAY_B")
        .run() ?? panic("clear child failed")
    print(cleared.output == "ONLY_THIS=yes\n")
    removed_wins :: process.cmd(["/usr/bin/env"])
        .env_clear().env("SAME_KEY", "set-first").env_remove("SAME_KEY")
        .run() ?? panic("precedence child failed")
    print(!removed_wins.output.contains("SAME_KEY="))
}
"""
    (dir, out) :: compile("mutation", &src)
    bin :: build(&dir, "mutation", &out)
    // Exceeds pipe capacity: capture must drain while the child is running.
    run :: Command.new(bin).current_dir(dir).env("JET_OVERLAY_PIPE_PRESSURE", "x".repeat(96 * 1024)).output() ?? panic("run mutation")
    assert_eq(run.status.code(), Val(0), "{String.from_utf8_lossy(run.stderr)}")
    assert_eq(String.from_utf8_lossy(run.stdout), "one\ntrue\ntrue\nfalse\ntrue\ntrue\ntrue\ntrue\n")
}

// Rust: tests/env_overlay.rs:105
#Test("codegen_is_raw_locked_and_never_mutates_host_env") {
    (_, out) :: compile("shape", """
use core.sys as env
use core.process as process

fn remove(name: String) -> Bool env.EnvError! {
    return Ok(env.unset(name))
}

fn run() -> {
    env.set("MODE", "test")
    removed :: remove("CI")
    names :: env.vars()
    child :: process.run(["worker"])
}
""")
    assert(out.rust.contains("std::env::vars_os()"))
    assert(out.rust.contains("type JetEnvEntries = Vec<(std::ffi::OsString, std::ffi::OsString)>"))
    assert(out.rust.contains("RwLock<JetEnvEntries>"))
    assert(out.rust.contains("fn main() {\n    jet_std_env_init();"))
    assert(out.rust.contains("command.env_clear()"))
    assert(out.rust.contains("command.envs(child_env)"))
    assert(out.rust.contains("std::thread::spawn(move ||"))
    drain :: out.rust.find("let drains = jet_process_start_output_drain(child);") ?? panic("process wait must start capture drains")
    wait :: out.rust.find("inner.try_wait()") ?? panic("process wait must poll child status")
    assert(drain < wait, "capture drains must start before child wait")
    assert(out.rust.contains("i32::try_from(left.len())"))
    assert(out.rust.contains("2 => std::cmp::Ordering::Equal"))
    assert(out.rust.contains("_ => left.cmp(&right)"))
    assert(!out.rust.contains("std::env::set_var"))
    assert(!out.rust.contains("std::env::remove_var"))
}

// Rust: tests/env_overlay.rs:151
#Test("raw_non_unicode_value_survives_child_snapshot_and_vars_fails_whole_snapshot") {
    if sys.target.selected_family() != "unix" -> return
    (dir, out) :: compile("raw", """
use core.sys as env
use core.process as process

fn run() -> {
    child :: process.run(["./raw_probe"]) ?? panic("raw child failed")
    print(child.output)
    if env.vars() == {
        .Ok(_) -> { print("unexpected vars success") }
        .Err(e) -> { print(e) }
    }
}
""")
    // The raw-byte Rust child is an independent OS-environment comparator.
    _ :: build_rust(&dir, "raw_probe", """
use std::os::unix::ffi::OsStrExt;
fn main() {
    let raw_value = std::env::var_os("JET_RAW_VALUE").expect("missing raw value");
    println!("{}", raw_value.as_os_str().as_bytes() == [0x66, 0x80, 0x6f]);
    let raw_name = [b'J', b'E', b'T', b'_', 0x81];
    let found = std::env::vars_os().any(|(name, value)| {
        name.as_os_str().as_bytes() == raw_name
            && value.as_os_str().as_bytes() == [0x76, 0x82, 0x6c]
    });
    println!("{}", found);
}
""")
    bin :: build(&dir, "raw", &out)
    run :: Command.new(bin).current_dir(dir)
        .env("JET_RAW_VALUE", OsString.from_vec([U8]{0x66, 0x80, 0x6f}))
        .env(OsString.from_vec([U8]{74, 69, 84, 95, 0x81}), OsString.from_vec([U8]{0x76, 0x82, 0x6c}))
        .output() ?? panic("run raw snapshot")
    assert_eq(run.status.code(), Val(0), "{String.from_utf8_lossy(run.stderr)}")
    assert_eq(String.from_utf8_lossy(run.stdout), "true\ntrue\n\nenvironment contains a name or value that is not valid Unicode\n")
}

// Rust: tests/env_overlay.rs:224
#Test("eager_snapshot_and_host_getenv_isolation_run_in_process") {
    (dir, out) :: compile("host_isolation", """
use core.sys as env

fn run() -> {
    print(env.get("JET_HOST_ISOLATION") ?? "missing")
    env.set("JET_HOST_ISOLATION", "jet-owned")
    print(env.get("JET_HOST_ISOLATION") ?? "missing")
}
""")
    // Attach a test-only host mutation after eager initialization, in the same process.
    rust :: out.rust.replacen(
        "    jet_std_env_init();\n    jet_gc::runtime_or_exit(jet_gc::initialize_trace());\n    jet_runtime_boundary(|| __jet_run());",
        "    jet_std_env_init();\n    std::env::set_var(\"JET_HOST_ISOLATION\", \"host-after-snapshot\");\n    jet_gc::runtime_or_exit(jet_gc::initialize_trace());\n    jet_runtime_boundary(|| __jet_run());\n    assert_eq!(std::env::var(\"JET_HOST_ISOLATION\").as_deref(), Ok(\"host-after-snapshot\"));", 1)
    assert_ne(rust, out.rust, "test probe did not attach after eager init")
    bin :: build_rust(&dir, "host_isolation", &rust)
    run :: Command.new(bin).current_dir(dir).env("JET_HOST_ISOLATION", "host-before-snapshot").output() ?? panic("run isolation")
    assert_eq(run.status.code(), Val(0), "{String.from_utf8_lossy(run.stderr)}")
    assert_eq(String.from_utf8_lossy(run.stdout), "host-before-snapshot\njet-owned\n")
}

// Rust: tests/env_overlay.rs:263
#Test("concurrent_mutation_and_real_child_spawns_take_untorn_snapshots") {
    if sys.target.selected_family() != "unix" -> return
    (dir, out) :: compile("atomic_spawn", "use core.sys as env\nfn run() -> { print(env.get(\"JET_PAIR_UNUSED\") ?? \"\") }\n")
    _ :: build_rust(&dir, "pair_probe", """
use std::os::unix::ffi::OsStrExt;
fn main() {
    let left_name = [b'J', b'E', b'T', b'_', b'P', b'A', b'I', b'R', b'_', 0x81];
    let right_name = [b'J', b'E', b'T', b'_', b'P', b'A', b'I', b'R', b'_', 0x82];
    let mut left = None;
    let mut right = None;
    for (name, value) in std::env::vars_os() {
        if name.as_os_str().as_bytes() == left_name { left = Some(value); }
        else if name.as_os_str().as_bytes() == right_name { right = Some(value); }
    }
    let state = match (left, right) {
        (Some(left), Some(right)) if left.as_os_str().as_bytes() == [b'A', 0x91]
            && right.as_os_str().as_bytes() == [b'A', 0x91] => "A",
        (Some(left), Some(right)) if left.as_os_str().as_bytes() == [b'B', 0x92]
            && right.as_os_str().as_bytes() == [b'B', 0x92] => "B",
        (Some(_), Some(_)) => "MIXED",
        _ => "MISSING",
    };
    println!("{state}");
}
""")
    hooked_snapshot :: out.rust.replacen("fn jet_std_env_snapshot_raw() -> JetEnvEntries {\n    jet_env_read().clone()\n}", """
fn jet_std_env_snapshot_raw() -> JetEnvEntries {
    jet_test_snapshot_entry();
    jet_env_read().clone()
}
static JET_TEST_SNAPSHOT_ENTERED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
static JET_TEST_FIRST_COMMIT_DONE: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
static JET_TEST_SNAPSHOT_HOOK_USED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
fn jet_test_snapshot_entry() {
    use std::sync::atomic::Ordering;
    if JET_TEST_SNAPSHOT_HOOK_USED.compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire).is_ok() {
        JET_TEST_SNAPSHOT_ENTERED.store(true, Ordering::Release);
        while !JET_TEST_FIRST_COMMIT_DONE.load(Ordering::Acquire) { std::thread::yield_now(); }
    }
}
""", 1)
    assert_ne(hooked_snapshot, out.rust, "snapshot-entry test hook did not attach")
    probe :: """
    jet_std_env_init();
    use std::os::unix::ffi::OsStringExt;
    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
    let left_name = std::ffi::OsString::from_vec(vec![b'J', b'E', b'T', b'_', b'P', b'A', b'I', b'R', b'_', 0x81]);
    let right_name = std::ffi::OsString::from_vec(vec![b'J', b'E', b'T', b'_', b'P', b'A', b'I', b'R', b'_', 0x82]);
    {
        let mut entries = jet_env_write();
        entries.retain(|(name, _)| !jet_env_key_eq(name.as_os_str(), left_name.as_os_str())
            && !jet_env_key_eq(name.as_os_str(), right_name.as_os_str()));
        entries.push((left_name.clone(), std::ffi::OsString::from_vec(vec![b'A', 0x91])));
        entries.push((right_name.clone(), std::ffi::OsString::from_vec(vec![b'A', 0x91])));
    }
    let stop = std::sync::Arc::new(AtomicBool::new(false));
    let generation = std::sync::Arc::new(AtomicU64::new(0));
    let writer_stop = stop.clone();
    let writer_generation = generation.clone();
    let writer_left = left_name.clone();
    let writer_right = right_name.clone();
    let writer = std::thread::spawn(move || {
        while !JET_TEST_SNAPSHOT_ENTERED.load(Ordering::Acquire) { std::thread::yield_now(); }
        let mut use_b = true;
        while !writer_stop.load(Ordering::Acquire) {
            let value = if use_b { std::ffi::OsString::from_vec(vec![b'B', 0x92]) }
                else { std::ffi::OsString::from_vec(vec![b'A', 0x91]) };
            {
                let mut entries = jet_env_write();
                entries.retain(|(name, _)| !jet_env_key_eq(name.as_os_str(), writer_left.as_os_str())
                    && !jet_env_key_eq(name.as_os_str(), writer_right.as_os_str()));
                entries.push((writer_left.clone(), value.clone()));
                entries.push((writer_right.clone(), value));
            }
            writer_generation.fetch_add(1, Ordering::AcqRel);
            JET_TEST_FIRST_COMMIT_DONE.store(true, Ordering::Release);
            use_b = !use_b;
            std::thread::yield_now();
        }
    });
    let mut advanced_during_launch = false;
    let mut observations = Vec::new();
    let mut launch_error = None;
    for _ in 0..16 {
        let before = generation.load(Ordering::Acquire);
        let result = match jet_std_process_run(&vec!["./pair_probe".to_string()]) {
            Ok(result) => result,
            Err(error) => { launch_error = Some(format!("{error:?}")); break; }
        };
        let after = generation.load(Ordering::Acquire);
        advanced_during_launch |= after > before;
        observations.push(result.output.trim().to_string());
    }
    stop.store(true, Ordering::Release);
    writer.join().unwrap();
    assert!(launch_error.is_none(), "child launch failed: {launch_error:?}");
    assert_eq!(observations.len(), 16, "not every real child probe completed");
    for state in observations { assert!(state == "A" || state == "B", "child observed {state} raw pair"); }
    assert!(advanced_during_launch, "writer generation never advanced across a child launch");
    jet_runtime_boundary(|| __jet_run());
"""
    rust :: hooked_snapshot.replacen("    jet_std_env_init();\n    jet_gc::runtime_or_exit(jet_gc::initialize_trace());\n    jet_runtime_boundary(|| __jet_run());", probe, 1)
    assert_ne(rust, hooked_snapshot, "atomicity probe did not attach")
    bin :: build_rust(&dir, "atomic_spawn", &rust)
    run :: Command.new(bin).current_dir(dir).output() ?? panic("run atomic spawn")
    assert_eq(run.status.code(), Val(0), "{String.from_utf8_lossy(run.stderr)}")
}

// Rust: tests/env_overlay.rs:438
#Test("fallible_set_runtime_hook_is_typed_for_next_edition") {
    (dir, out) :: compile("fallible_set_hook", "use core.sys as env\nfn run() -> { print(env.get(\"JET_ENV_UNUSED\") ?? \"\") }\n")
    probe :: """
    jet_std_env_init();
    let invalid_name: Result<(), jet_std::EnvError> = jet_std_env_set(&"".to_string(), &"value".to_string());
    assert!(matches!(invalid_name, Err(jet_std::EnvError::InvalidName)));
    let invalid_value: Result<(), jet_std::EnvError> = jet_std_env_set(&"name".to_string(), &format!("bad{}value", char::from(0)));
    assert!(matches!(invalid_value, Err(jet_std::EnvError::InvalidValue)));
    jet_runtime_boundary(|| __jet_run());
"""
    rust :: out.rust.replacen("    jet_std_env_init();\n    jet_gc::runtime_or_exit(jet_gc::initialize_trace());\n    jet_runtime_boundary(|| __jet_run());", probe, 1)
    assert_ne(rust, out.rust, "fallible-set probe did not attach")
    bin :: build_rust(&dir, "fallible_set_hook", &rust)
    run :: Command.new(bin).current_dir(dir).output() ?? panic("run fallible set")
    assert_eq(run.status.code(), Val(0), "{String.from_utf8_lossy(run.stderr)}")
}

// Rust: tests/env_overlay.rs:469
#Test("windows_casefold_last_spelling_and_child_inheritance_run_natively") {
    if sys.target.selected_os() != "windows" -> return
    (dir, out) :: compile("windows_native", """
use core.sys as env
use core.process as process

fn run() -> {
    env.set("Jet_Win_Case", "first")
    print(env.get("jET_wIN_cASE") ?? "missing")
    env.set("JET_WIN_CASE", "last-✓")
    print(env.get("jet_win_case") ?? "missing")
    names :: env.vars() ?? panic("vars failed")
    print(names.join(",").contains("JET_WIN_CASE"))
    child :: process.run(["cmd.exe", "/C", "echo %jet_win_case%"])
        ?? panic("child failed")
    print(child.output.contains("last-✓"))
}
""")
    bin :: build(&dir, "windows_native", &out)
    run :: Command.new(bin).current_dir(dir).output() ?? panic("run Windows inheritance")
    assert_eq(run.status.code(), Val(0), "{String.from_utf8_lossy(run.stderr)}")
    assert_eq(String.from_utf8_lossy(run.stdout), "first\nlast-✓\ntrue\ntrue\n")
}

// Rust: tests/env_overlay.rs:502
#Test("old_edition_invalid_set_uses_exact_runtime_error") {
    (dir, out) :: compile("invalid", """
use core.sys as env

fn run() -> {
    env.set("", "value")
}
""")
    bin :: build(&dir, "invalid", &out)
    run :: Command.new(bin).current_dir(dir).output() ?? panic("run invalid set")
    stderr :: String.from_utf8_lossy(run.stderr)
    assert_eq(run.status.code(), Val(70))
    assert(stderr.contains("panic: core.sys.set: invalid environment variable name"))
    assert(stderr.contains("invalid.jet:5 in run"), "missing call-site frame: {stderr}")
}

// Rust: tests/env_overlay.rs:543
#Test("env_set_is_visible_identically_on_aot_jit_and_interpreter") {
    if !common.have_rustc() || !cranelift_host_supported() {
        eprintln("note: rustc or the cranelift host is unavailable; skipping tier differential")
        return
    }
    thread.Builder.new().name("env-owner-tier-parity").stack_size(64 * 1024 * 1024)
        .spawn(env_set_is_visible_identically_on_aot_jit_and_interpreter_inner)
        .expect("spawn env tier-parity worker").join().expect("env tier-parity worker must not panic")
}

// Rust: tests/env_overlay.rs:557
fn env_set_is_visible_identically_on_aot_jit_and_interpreter_inner() -> {
    src :: """
use core.sys as env
use core.term as io

fn run() -> {
    env.set("JET_ENV_TIER_OWNER", "shared-owner")
    env.set("COLUMNS", "137")
    env.set("LINES", "41")
    print(env.get("JET_ENV_TIER_OWNER") ?? "missing")
    print(io.terminal_width())
    print(io.terminal_height())
}
"""
    EXPECTED :: "shared-owner\n137\n41\n"
    (dir, out) :: compile("tier_owner", &src)
    shown :: dir.join("tier_owner.jet").to_string_lossy().into_owned()
    bin :: build(&dir, "tier_owner", &out)
    aot :: Command.new(bin).current_dir(dir).output() ?? panic("run AOT")
    assert_eq(aot.status.code(), Val(0), "AOT run failed: {String.from_utf8_lossy(aot.stderr)}")
    aot_stdout :: String.from_utf8_lossy(aot.stdout).into_owned()
    bundle := Loader.load_entry(&shown) ?? panic("tier fixture must load")
    errors :: Sema.check_bundle(&bundle, Sema.CompileMode.Run).filter((diag) -> diag.severity == Diagnostics.Severity.Error).collect()
    assert(errors.is_empty(), "tier fixture must type-check: {errors:?}")
    assert(common.cranelift_resident_safe(&bundle), "env fixture must be resident-JIT safe: {common.cranelift_resident_safe_detail(&bundle):?}")
    policy :: common.development_policy()
    reset_jit_trace_for_test()
    backend := CraneliftBackend.new()
    jit_stdout :: if common.run_cranelift_bundle(&backend, &bundle, false, &policy) == {
        .Ran{stdout, exit_code, ..} -> {
            assert_eq(exit_code, 0, "resident JIT exited non-zero")
            stdout
        }
        .Problems(diags) -> panic("resident JIT did not run the fixture: {diags:?}")
    }
    assert(jit_executed_for_test(), "fixture did not execute in the resident JIT")
    assert(!deopt_invoked_for_test() && !fallback_invoked_for_test(), "resident JIT tier deopted or fell back, so it proves nothing about the JIT")
    reset_jit_trace_for_test()
    interpreted_stdout :: if dev_iteration(&shown, false, true) == {
        .Ran{stdout, exit_code, ..} -> {
            assert_eq(exit_code, 0, "interpreter exited non-zero")
            stdout
        }
        .Problems(diags) -> panic("interpreter did not run the fixture: {diags:?}")
    }
    assert(!jit_executed_for_test(), "the interpreter tier silently executed native JIT code")
    assert_eq(aot_stdout, EXPECTED, "AOT drifted from the pinned observable")
    assert_eq(jit_stdout, aot_stdout, "resident JIT diverged from AOT")
    assert_eq(interpreted_stdout, aot_stdout, "interpreter diverged from AOT — `env.set` reached a different owner")
    _ :: fs.remove_dir_all(dir)
}
