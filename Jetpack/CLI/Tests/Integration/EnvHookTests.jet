// Rust: tests/env_hook.rs:461
#Test("export_changed_definition_reactivates_at_next_prompt") {
    scratch :: Scratch.new("changed")
    write_prompt_only_env(&scratch.path)
    root :: scratch.path.to_string_lossy().to_string()
    first :: export_cmd(&scratch.path).args(["env", "export", "bash"]).output() ?? panic("first export")
    assert(first.status.success())
    hash :: activation_hash(first.stdout)
    fs.write(scratch.path.join("env.jet"), "module env.dev {\n  prompt: \"changed\"\n}\n") ?? panic("change env")
    out :: export_cmd(&scratch.path).args(["env", "export", "bash"]).env("JETPACK_ENV_DIR", root).env("JETPACK_ENV_HASH", hash).output() ?? panic("export")
    assert(out.status.success())
    assert(!out.stdout.is_empty(), "a changed definition must emit replacement activation")
    replacement :: String.from_utf8_lossy(out.stdout)
    assert(replacement.contains("changed"), "replacement facts missing:\n{replacement}")
    assert(!replacement.contains("smoke"), "stale facts survived reload:\n{replacement}")
    assert(replacement.contains("export JETPACK_ENV_HASH='"))
}

