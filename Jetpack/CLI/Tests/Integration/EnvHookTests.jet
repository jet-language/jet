// Rust: tests/env_hook.rs:812
#Test("enter_installs_and_runs_a_native_git_hook_from_the_typed_environment") {
    if sys.target.selected_family() == "unix" {
        scratch :: Scratch.new("git-hooks-enter")
        hooks :: scratch.path.join("scripts/githooks")
        fs.create_dir_all(hooks) ?? panic("create hooks")
        hook :: hooks.join("pre-commit")
        fs.write(hook, "#!/bin/sh\nprintf ran > .git-hook-ran\n") ?? panic("write hook")
        fs.set_permissions(hook, Permissions.from_mode(0o755)) ?? panic("chmod hook")
        fs.write(scratch.path.join("env.jet"), "module env.dev {\n  git_hooks_path: \"scripts/githooks\"\n}\n") ?? panic("write env")
        fs.write(scratch.path.join("tracked.txt"), "tracked\n") ?? panic("write tracked")
        for args in [["init", "--quiet"], ["config", "user.name", "Jet Test"], ["config", "user.email", "jet-test@example.invalid"], ["add", "tracked.txt"]] {
            out :: Command.new("git").current_dir(&scratch.path).args(args).output() ?? panic("git setup")
            assert(out.status.success(), "git setup failed: {String.from_utf8_lossy(out.stderr)}")
        }
        path :: fs.canonicalize(hooks) ?? panic("canonicalize hooks")
        path_output :: Command.new(jetpack_bin()).current_dir(&scratch.path).args(["env", "--trust", "--no-color", "--", "git", "config", "--get", "core.hooksPath"])
            .env("PATH", env.var_os("PATH") ?? panic("tests run with Git on PATH")).output() ?? panic("git projection")
        assert(path_output.status.success(), "Git config projection failed: {String.from_utf8_lossy(path_output.stderr)}")
        text := String.from_utf8_lossy(path_output.stdout).trim() // #4303
        assert_eq(text, path.to_string_lossy())
        commit :: Command.new(jetpack_bin()).current_dir(&scratch.path).args(["env", "--trust", "--no-color", "--", "git", "commit", "-m", "hook"])
            .env("PATH", env.var_os("PATH") ?? panic("tests run with Git on PATH")).output() ?? panic("git commit")
        assert(commit.status.success(), "native Git hook run failed: {String.from_utf8_lossy(commit.stderr)}")
        assert_eq(fs.read_to_string(scratch.path.join(".git-hook-ran")) ?? panic("read hook marker"), "ran")
    }
}

// Rust: tests/env_hook.rs:905
#Test("env_test_projects_git_hooks_into_the_clean_ci_command") {
    scratch :: Scratch.new("git-hooks-ci")
    hooks :: scratch.path.join("scripts/githooks")
    fs.create_dir_all(hooks) ?? panic("create hooks")
    fs.write(scratch.path.join("env.jet"), "module env.ci {\n  git_hooks_path: \"scripts/githooks\"\n}\n") ?? panic("write env")
    expected :: (fs.canonicalize(hooks) ?? panic("canonicalize hooks")).to_string_lossy().to_string()
    git := nil as OSPath?
    for directory in env.split_paths(env.var_os("PATH") ?? panic("tests run with Git on PATH")) {
        candidate :: directory.join("git")
        if candidate.is_file() { git = Val(candidate); break }
    }
    executable :: git ?? panic("Git executable must be discoverable for the CI projection test")
    out :: Command.new(jetpack_bin()).current_dir(&scratch.path).args(["env", "--trust", "--env", "ci", "--no-color", "test", "--"])
        .arg(executable).args(["config", "--get", "core.hooksPath"]).env("PATH", env.var_os("PATH") ?? panic("tests run with Git on PATH")).output() ?? panic("env test")
    assert(out.status.success(), "CI environment test failed: {String.from_utf8_lossy(out.stderr)}")
    assert(String.from_utf8_lossy(out.stdout).contains(expected), "CI command did not receive core.hooksPath: stdout={String.from_utf8_lossy(out.stdout)} stderr={String.from_utf8_lossy(out.stderr)}")
}

// Rust: tests/env_hook.rs:955
#Test("enter_rejects_a_missing_git_hooks_directory_before_launch") {
    scratch :: Scratch.new("git-hooks-missing")
    fs.write(scratch.path.join("env.jet"), "module env.dev {\n  git_hooks_path: \"scripts/githooks\"\n}\n") ?? panic("write env")
    out :: Command.new(jetpack_bin()).current_dir(&scratch.path).args(["env", "--trust", "--no-color", "--", "sh", "-c", "touch child-ran"])
        .env("PATH", "/usr/bin:/bin").output() ?? panic("enter")
    assert_eq(out.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("E1333"), "missing git hook path diagnostic: {stderr}")
    assert(!scratch.path.join("child-ran").exists())
}

// Rust: tests/env_hook.rs:987
#Test("enter_rejects_a_trusted_hook_cwd_that_escapes_through_a_symlink") {
    if sys.target.selected_family() == "unix" {
        project :: Scratch.new("trusted-hook-symlink")
        outside :: Scratch.new("trusted-hook-outside")
        fs.symlink(&outside.path, project.path.join("link")) ?? panic("symlink")
        fs.write(project.path.join("env.jet"), "module env.dev {\n    on_enter: [{\n        name: \"escape\",\n        cwd: \"link\",\n        command: \"printf escaped > escaped\",\n        trusted: true,\n    }]\n}\n") ?? panic("write env")
        out :: Command.new(jetpack_bin()).current_dir(&project.path).args(["env", "--trust", "--no-color", "--", "/bin/true"])
            .env("PATH", "/usr/bin:/bin").output() ?? panic("enter")
        assert_eq(out.status.code(), Val(2))
        stderr :: String.from_utf8_lossy(out.stderr)
        assert(stderr.contains("unsafe cwd"), "missing boundary diagnostic:\n{stderr}")
        assert(!outside.path.join("escaped").exists())
    }
}
