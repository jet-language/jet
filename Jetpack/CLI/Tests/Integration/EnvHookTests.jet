    assert_eq(fs.read_to_string(scratch.path.join(".hook-marker")) ?? panic("read marker"), "entered")
}

// Rust: tests/env_hook.rs:565
#Test("enter_resolves_a_bare_lifecycle_name_to_a_typed_job") {
    scratch :: Scratch.new("typed-lifecycle-job")
    fs.write(scratch.path.join("env.jet"), "module env.dev {\n    on_enter: [seed_config]\n}\n") ?? panic("write env")
    fs.write(scratch.path.join("run.jet"), "#Job\nfn seed_config() {\n        print(\"typed lifecycle job\")\n}\nfn run() {}\n") ?? panic("write job")
    // Keep the caller's toolchain visible to the nested jet run task.
    out :: Command.new(jetpack_bin()).current_dir(&scratch.path).args(["env", "--trust", "--no-color", "--", "true"])
        .env("PATH", env.var_os("PATH") ?? panic("tests run with Rust on PATH")).output() ?? panic("enter")
    assert(out.status.success(), "typed lifecycle job must run through the job path: {String.from_utf8_lossy(out.stderr)}")
    assert(String.from_utf8_lossy(out.stdout).contains("typed lifecycle job"), "task output missing: {String.from_utf8_lossy(out.stdout)}")
}

// Rust: tests/env_hook.rs:610
#Test("enter_rejects_an_undeclared_lifecycle_job_before_launch") {
    scratch :: Scratch.new("undeclared-lifecycle-job")
    fs.write(scratch.path.join("env.jet"), "module env.dev {\n  on_enter: [missing_task]\n}\n") ?? panic("write env")
    fs.write(scratch.path.join("run.jet"), "fn run() {}\n") ?? panic("write job")
    out :: Command.new(jetpack_bin()).current_dir(&scratch.path).args(["env", "--trust", "--no-color", "--", "true"])
        .env("PATH", env.var_os("PATH") ?? panic("tests run with Rust on PATH")).output() ?? panic("enter")
    assert_eq(out.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("E1294"), "missing lifecycle job diagnostic:\n{stderr}")
    assert(stderr.contains("missing_task"), "missing task name:\n{stderr}")
    assert(!stderr.contains("running job missing_task"), "undeclared lifecycle job must be rejected before child launch:\n{stderr}")
}

// Rust: tests/env_hook.rs:644
#Test("export_runs_typed_lifecycle_jobs_without_stdout_pollution") {
    scratch :: Scratch.new("typed-lifecycle-export")
    home :: Scratch.new("typed-lifecycle-export-home")
    fs.write(scratch.path.join("env.jet"), "module env.dev {\n  on_enter: [seed_config]\n}\n") ?? panic("write env")
    fs.write(scratch.path.join("run.jet"), "#Job\nfn seed_config() { print(\"typed lifecycle job\") }\nfn run() {}\n") ?? panic("write job")
    selector :: "env:{scratch.path.display()}"
    trusted :: Command.new(jetpack_bin()).current_dir(&scratch.path).args(["trust", "grant", selector, "--scope", "user"])
        .env("HOME", &home.path).env("PATH", env.var_os("PATH") ?? panic("tests run with Rust on PATH")).output() ?? panic("grant trust")
    assert(trusted.status.success(), "trust setup failed: {String.from_utf8_lossy(trusted.stderr)}")
    out :: export_cmd(&scratch.path).args(["env", "--no-color", "export", "bash"]).env("HOME", &home.path)
        .env("PATH", env.var_os("PATH") ?? panic("tests run with Rust on PATH")).output() ?? panic("export")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    stdout :: String.from_utf8_lossy(out.stdout)
    assert(stdout.contains("export JETPACK_ENV=1"), "missing activation; stderr: {String.from_utf8_lossy(out.stderr)}\nstdout:\n{stdout}")
    assert(!stdout.contains("typed lifecycle job"), "task output must not corrupt shell activation:\n{stdout}")
}

