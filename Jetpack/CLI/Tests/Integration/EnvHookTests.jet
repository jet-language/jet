// Rust: tests/env_hook.rs:132
#Test("export_does_not_emit_untrusted_typed_environment_shell_code") {
    project :: Scratch.new("typed-env-hook-trust")
    home :: Scratch.new("typed-env-hook-trust-home")
    marker :: project.path.join("envhook-pwned")
    fs.write(project.path.join("env.jet"), "module env.dev {\n    presets: {\n        default: { variables: [String:String]{ \"PROMPT_COMMAND\": \"printf injected > envhook-pwned\" } }\n    }\n}\n") ?? panic("write env")
    out :: export_cmd(&project.path).args(["env", "export", "bash"]).env("HOME", &home.path).output() ?? panic("export")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    if sys.target.selected_family() == "unix" {
        shell := Command.new(host_bash()).args(["--noprofile", "--norc", "-c", "source /dev/stdin; if [ -n \"${PROMPT_COMMAND:-}\" ]; then eval \"$PROMPT_COMMAND\"; fi"])
            .current_dir(&project.path).env_clear().env("HOME", &home.path).env("PATH", "/usr/bin:/bin")
            .stdin(Stdio.piped()).stdout(Stdio.null()).stderr(Stdio.piped()).spawn() ?? panic("spawn bash")
        input := &shell.stdin.take() ?? panic("shell stdin")
        &input.write_all(out.stdout) ?? panic("write script")
        drop(^input)
        shell_out :: &shell.wait_with_output() ?? panic("wait bash")
        assert(shell_out.status.success(), "the shell harness rejected the generated script: {String.from_utf8_lossy(shell_out.stderr)}")
    }
    assert(!marker.exists(), "untrusted shell payload executed")
    assert(out.stdout.is_empty(), "an untrusted typed environment must not emit shell code:\n{String.from_utf8_lossy(out.stdout)}")
}

// Rust: tests/env_hook.rs:197
#Test("export_rejects_shell_syntax_in_environment_names") {
    for (name, body, marker) in [
        ("var-name", "module env.dev {\n    presets: {\n        default: { variables: [String:String]{ \"BAD; touch envhook-var-pwned\": \"value\" } }\n    }\n}\n", "envhook-var-pwned"),
        ("unset-name", "module env.dev {\n    unset: [\"BAD; touch envhook-unset-pwned\"]\n}\n", "envhook-unset-pwned")
    ] {
        project :: Scratch.new(name)
        fs.write(project.path.join("env.jet"), body) ?? panic("write env")
        out :: export_cmd(&project.path).args(["env", "export", "bash"]).output() ?? panic("export")
        assert(!out.status.success(), "hostile {name} must be rejected")
        assert(String.from_utf8_lossy(out.stderr).contains("not a valid environment name"), "missing name validation diagnostic for {name}:\n{String.from_utf8_lossy(out.stderr)}")
        assert(!project.path.join(marker).exists())
    }
}

// Rust: tests/env_hook.rs:235
#Test("export_activates_nearest_env_from_root_and_subdir") {
    scratch :: Scratch.new("activate")
    write_prompt_only_env(&scratch.path)
    inner :: scratch.path.join("src").join("inner")
    fs.create_dir_all(inner) ?? panic("create inner")
    root :: scratch.path.to_string_lossy().to_string()
    for dir in [&scratch.path, &inner] {
        out :: export_cmd(dir).args(["env", "export", "bash"]).output() ?? panic("export")
        assert(out.status.success())
        stdout :: String.from_utf8_lossy(out.stdout)
        assert(stdout.contains("export JETPACK_ENV_DIR='{root}'"), "activation from {dir} must anchor to the env root:\n{stdout}")
        assert(stdout.contains("export JETPACK_ENV=1"), stdout)
        assert(stdout.contains("export JETPACK_ENV_OLD_PATH="), stdout)
        assert(stdout.contains("export PATH="), stdout)
    }
}

// Rust: tests/env_hook.rs:262
#Test("export_uses_a_durable_hangar_path_for_realized_package") {
    if sys.target.selected_family() == "unix" {
        project :: Scratch.new("package-export")
        root :: Scratch.new("package-export-root")
        fixtures :: Scratch.new("package-export-fixtures")
        home :: Scratch.new("package-export-home")
        artifact :: fixtures.join("omp-1.0.0")
        fs.write(artifact, "#!/bin/sh\nprintf '%s\\n' cached\n") ?? panic("write artifact")
        artifact_digest :: SHA256.sha256_file_hex(artifact) ?? panic("hash artifact")
        fs.write(fixtures.join("jetpackage-omp.json"), "{\"tag\":\"v1.0.0\",\"version\":\"1.0.0\",\"sha256\":\"{artifact_digest}\",\"artifact\":\"omp-1.0.0\"}") ?? panic("write manifest")
        fs.write(project.join("env.jet"), "module env.dev { packages: [\"omp@releases#1.0.0\"] }\n") ?? panic("write env")
        prep :: Command.new(jetpack_bin()).args(["env", "--prep", "--yes", "--trust", "--offline", "--no-color", "--fixtures"])
            .arg(&fixtures.path).current_dir(&project.path).env("JETPACK_ROOT", &root.path).env("HOME", &home.path)
            .env("JETPACK_DENY_NETWORK", "1").output() ?? panic("prep")
        assert(prep.status.success(), "env --prep failed: {String.from_utf8_lossy(prep.stderr)}")
        fs.remove_file(fixtures.join("jetpackage-omp.json")) ?? panic("remove manifest")
        fs.remove_file(artifact) ?? panic("remove artifact")
        out :: export_cmd(&project.path).args(["env", "--trust", "--offline", "export", "bash"])
            .env("JETPACK_ROOT", &root.path).env("HOME", &home.path).env("JETPACK_DENY_NETWORK", "1").output() ?? panic("export")
        assert(out.status.success(), "package export failed: {String.from_utf8_lossy(out.stderr)}")
        script :: String.from_utf8_lossy(out.stdout)
        assert(!script.contains("/proc/self/fd/"), "parent-shell activation leaked a process-local lease path:\n{script}")
        durable_bin := nil as OSPath?
        for result in fs.read_dir(root.path.join("hangar/objects")) ?? panic("read objects") {
            if entry :: result.ok() {
                object :: entry.path()
                if filename :: object.file_name() {
                    if name :: filename.to_str() {
                        if name.starts_with("sha256-") && object.join("bin").is_dir() {
                            durable_bin = Val(object.join("bin"))
                            break
                        }
                    }
                }
            }
        }
        bin :: durable_bin ?? panic("prep must publish a sealed Hangar object with a bin directory")
        expected_prefix :: "export PATH='{bin.display()}:"
        assert(script.contains(expected_prefix), "activation did not publish the sealed Hangar bin directory:\n{script}")
        shell := Command.new(host_bash()).args(["--noprofile", "--norc", "-c", "source /dev/stdin; omp"])
            .current_dir(&project.path).env_clear().env("HOME", &home.path).env("PATH", "/usr/bin:/bin")
            .stdin(Stdio.piped()).stdout(Stdio.piped()).stderr(Stdio.piped()).spawn() ?? panic("spawn bash")
        input := &shell.stdin.take() ?? panic("shell stdin")
        &input.write_all(out.stdout) ?? panic("write script")
        drop(^input)
        shell_out :: &shell.wait_with_output() ?? panic("wait bash")
        assert(shell_out.status.success(), "generated activation did not run after exporter exit: {String.from_utf8_lossy(shell_out.stderr)}")
        text := String.from_utf8_lossy(shell_out.stdout).trim() // #4303
        assert_eq(text, "cached")
    }
}

// Rust: tests/env_hook.rs:375
#Test("enter_from_nested_directory_projects_allowlisted_dotenv_and_unsets") {
    scratch :: Scratch.new("dotenv-nested")
    inner :: scratch.path.join("src").join("inner")
    fs.create_dir_all(inner) ?? panic("create inner")
    fs.write(scratch.path.join(".env"), "VISIBLE=from-dotenv\nSECRET=hidden\nUNLISTED=must-not-load\n") ?? panic("write dotenv")
    fs.write(scratch.path.join("env.jet"), "module env.dev {\n  dotenv: Dotenv{ file: \".env\", allow: [\"VISIBLE\", \"SECRET\"], secrets: [\"SECRET\"] }\n  unset: [\"REMOVE_ME\"]\n}\n") ?? panic("write env")
    out :: export_cmd(&inner).args(["env", "--trust", "--no-color", "--", "sh", "-c", "printf '%s|%s|%s|%s' \"$VISIBLE\" \"$SECRET\" \"${UNLISTED:-unset}\" \"${REMOVE_ME:-unset}\""])
        .env("VISIBLE", "from-parent").env("REMOVE_ME", "remove-me").env("UNLISTED", "from-parent").output() ?? panic("enter")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    text := String.from_utf8_lossy(out.stdout).trim() // #4303
    assert_eq(text, "from-dotenv|hidden|from-parent|unset")
}

