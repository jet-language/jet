use Jetpack.CLI.Tests.Integration.EnvHook.*
use common.[jetpack_bin, Scratch]
use Jetpack.SHA256
use std.[fs, env, Command, Stdio, Permissions]
use core.sys
// GATE #4494: real process, piped IO, filesystem permissions and symlinks.
// GATE #4483: selected-family dispatch preserves Unix-only coverage.

// Rust: tests/env_hook.rs:72
#Test("hook_prints_installable_snippet_per_shell") {
    for (shell, needle) in [("bash", "PROMPT_COMMAND"), ("zsh", "add-zsh-hook precmd __jet_env_hook"), ("fish", "--on-event fish_prompt")] {
        out :: Command.new(jetpack_bin()).args(["env", "hook", shell]).output() ?? panic("hook output")
        assert(out.status.success(), "`enter hook {shell}` must exit 0")
        stdout :: String.from_utf8_lossy(out.stdout)
        assert(stdout.contains(needle), "`hook {shell}` output missing `{needle}`:\n{stdout}")
        assert(stdout.contains("command jet env export {shell}"), "`hook {shell}` must call back into `jet env export {shell}`:\n{stdout}")
        assert(stdout.contains("__jet_help_prefill"), "`hook {shell}` must install help-app prefill widgets:\n{stdout}")
        assert(!stdout.contains("__jetpack_"), "hook {shell} leaked engine identifiers:\n{stdout}")
    }
}

// Rust: tests/env_hook.rs:104
#Test("hook_unknown_shell_is_a_clean_error") {
    out :: Command.new(jetpack_bin()).args(["env", "hook", "tcsh"]).output() ?? panic("hook output")
    assert_eq(out.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.to_ascii_lowercase().contains("unknown shell"), stderr)
    assert(stderr.contains("bash, zsh, fish"), stderr)
}

