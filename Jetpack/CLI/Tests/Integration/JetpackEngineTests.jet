// Rust: tests/jetpack_engine.rs:262
#Test("hangar_migration_rejects_destination_symlink_without_following_it") {
    if sys.target.selected_family() != "unix" -> return
    data :: Scratch.new("hangar-migration-destination-link-data")
    state :: Scratch.new("hangar-migration-destination-link-state")
    outside :: Scratch.new("hangar-migration-destination-link-outside")
    destination_parent :: data.path.join("jet")
    fs.create_dir_all(destination_parent) ?? panic("create destination parent")
    fs.write(outside.join("marker"), "must stay outside") ?? panic("write outside marker")
    fs.symlink(outside.path, destination_parent.join("hangar")) ?? panic("destination link")
    output :: jet().args(["hangar", "path", "--no-color"]).env_remove("JETPACK_ROOT")
        .env("XDG_DATA_HOME", data.path).env("XDG_STATE_HOME", state.path).env_remove("LOCALAPPDATA").output() ?? panic("destination link migration")
    assert_eq(output.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("E2604"), "{stderr}")
    assert(stderr.contains("Inspect the reported Hangar path"), "{stderr}")
    assert(stderr.contains("is a symlink"), "{stderr}")
    assert_eq(fs.read_to_string(outside.join("marker")) ?? panic("read outside marker"), "must stay outside")
    assert_eq(fs.read_link(destination_parent.join("hangar")) ?? panic("read destination link"), outside.path)
}

// Rust: tests/jetpack_engine.rs:300
#Test("binary_cache_local_publish_verify_and_reject_corruption") {
    root :: Scratch.new("cache-root")
    source :: Scratch.new("cache-source")
    blocked :: Scratch.new("cache-blocked-mirror")
    mirror :: Scratch.new("cache-mirror")
    fs.remove_dir_all(blocked.path) ?? panic("remove blocked mirror")
    fs.write(blocked.path, "the first mirror is unavailable") ?? panic("block first mirror")
    roots :: Store.Roots{root: root.path, dev_mode: false}
    fs.write(source.join("payload"), "cache bytes\n") ?? panic("write payload")
    if sys.target.selected_family() == "unix" {
        fs.symlink("payload", source.join("alias")) ?? panic("payload link")
    }
    entry :: (Store.ingest_tree(&roots, &Store.IngestRequest{
        name: "cache-demo", version: "1", reference: "./cache-demo",
        cache_identity: Store.CacheIdentity{source_fingerprint: "sha256:cache-source", recipe_fingerprint: "sha256:cache-recipe", policy_fingerprint: "sha256:cache-policy", platform: Envelope.host_platform()},
        references: [String]{}, outputs: [String:OSPath]{"out": source.path}, signature: "", provenance: "cache test", platform_artifact_kind: ""
    }) ?? panic("ingest cache demo")).entry
    Store.bind_cache(&roots, "public", [String]{blocked.path.display().to_string(), mirror.path.display().to_string()}, None, None, true) ?? panic("bind cache")
    published :: Store.publish_cache_entry(&roots, &entry.id, "public") ?? panic("publish cache")
    assert_eq(published.output_hash, entry.envelope.output_hash)
    assert_eq(published.mirror, mirror.path.display().to_string())
    verified :: Store.verify_cache_transfer(&roots, &entry.id, "public") ?? panic("verify cache")
    assert_eq(verified.output_hash, entry.envelope.output_hash)
    assert_eq(verified.builder, published.builder)
    assert_eq(verified.provenance, published.provenance)
    assert(published.witness.as_deref().is_some_and((witness) -> !witness.is_empty()))
    assert_eq(verified.witness, published.witness)
    assert_eq(published.receipt_version, Val(1))
    assert(published.receipt_expires_unix.is_some())
    assert_eq(verified.receipt_version, Val(1))
    assert(verified.receipt_expires_unix.is_some())
    assert(!verified.signed_fingerprint.is_empty())
    report_json :: Store.cache_report_json("verify", &verified)
    assert(report_json.contains("\"operation\":\"verify\""))
    assert(report_json.contains("\"signed_fingerprint\":"))
    assert(report_json.contains("\"builder\":"))
    assert(report_json.contains("\"provenance\":"))
    assert(report_json.contains("\"witness\":"))
    assert(report_json.contains("\"receipt_version\":1"))
    assert(report_json.contains("\"receipt_expires_unix\":"))
    explanation :: (Store.explain_package(&roots, &entry.id, Store.ExplainLens.Rebuild) ?? panic("explain")) ?? panic("published cache entry should be explainable")
    explanation_json :: explanation.to_json()
    assert(explanation_json.contains("\"cache_admissions\":"))
    assert(explanation_json.contains("\"decision\":\"accepted\""))
    assert(explanation_json.contains("\"receipt_version\":1"))
    assert(explanation_json.contains("\"receipt_expires_unix\":"))
    assert(explanation_json.contains(published.builder))
    assert(explanation.text().contains("cache-trust public accepted"))
    assert(explanation_json.contains("\"decision\":\"rebuild-required\""))
    assert(explanation_json.contains("producer record lacks the shared provider-facts carrier"))
    restored :: Scratch.new("cache-restored")
    Store.substitute_cache_entry(&roots, &entry.id, "public", &restored.join("out")) ?? panic("substitute cache")
    assert_eq(fs.read_to_string(restored.join("out/payload")) ?? panic("read restored"), "cache bytes\n")
    if sys.target.selected_family() == "unix" {
        assert_eq(fs.read_link(restored.join("out/alias")) ?? panic("read restored link"), OSPath.from("payload"))
    }
    nar :: mirror.join("nar").join("{entry.envelope.output_hash}.nar")
    info :: mirror.join("{entry.envelope.output_hash}-{entry.id}.narinfo")
    nar_bytes :: fs.read(nar) ?? panic("read NAR")
    info_bytes :: fs.read(info) ?? panic("read narinfo")
    fs.remove_file(blocked.path) ?? panic("unblock mirror")
    fs.create_dir_all(blocked.join("nar")) ?? panic("create blocked NAR directory")
    fs.write(blocked.join("nar").join("{entry.envelope.output_hash}.nar"), "corrupted first mirror".as_bytes()) ?? panic("corrupt first mirror")
    fs.write(blocked.join("{entry.envelope.output_hash}-{entry.id}.narinfo"), &info_bytes) ?? panic("copy narinfo")
    fallback :: Store.verify_cache_transfer(&roots, &entry.id, "public") ?? panic("fallback mirror")
    assert_eq(fallback.mirror, mirror.path.display().to_string())
    fs.remove_file(nar) ?? panic("remove NAR")
    fs.remove_file(info) ?? panic("remove narinfo")
    fs.write(nar.with_extension("partial"), nar_bytes.slice(0, nar_bytes.len().max(2) / 2)) ?? panic("partial NAR")
    fs.write(info.with_extension("partial"), info_bytes.slice(0, info_bytes.len().max(2) / 2)) ?? panic("partial narinfo")
    _ :: Store.publish_cache_entry(&roots, &entry.id, "public") ?? panic("republish")
    assert_eq(fs.read(nar) ?? panic("read NAR"), nar_bytes)
    assert_eq(fs.read(info) ?? panic("read narinfo"), info_bytes)
    assert(!nar.with_extension("partial").exists())
    assert(!info.with_extension("partial").exists())
    cache_key_bytes :: fs.read(root.join("trust/cache-public.key")) ?? panic("read cache key")
    cache_key :: TrustRoot.TrustKey.from_secret(cache_key_bytes.clone()) ?? panic("cache key")
    clear_negative_hint :: () -> { _ :: fs.remove_dir_all(mirror.join(".jet-negative")) }
    unsigned :: (String.from_utf8(info_bytes.clone()) ?? panic("narinfo UTF8")).lines().filter((line) -> !line.starts_with("Sig: ")).collect().join("\n") + "\n"
    fs.write(info, unsigned) ?? panic("write unsigned narinfo")
    assert(Store.verify_cache_transfer(&roots, &entry.id, "public").is_err())
    unsigned_destination :: Scratch.new("cache-unsigned-rejected")
    assert(Store.substitute_cache_entry(&roots, &entry.id, "public", &unsigned_destination.join("out")).is_err())
    assert(!unsigned_destination.join("out").exists())
    clear_negative_hint()
    fs.write(info, &info_bytes) ?? panic("restore narinfo")
    mismatched := Store.NarInfo.parse(String.from_utf8(&info_bytes) ?? panic("UTF8")) ?? panic("parse narinfo")
    mismatched.deriver = Val("/jet/derivations/{\"f\".repeat(64)}")
    fs.write(info, (mismatched.signed(&cache_key) ?? panic("sign")).to_text() ?? panic("narinfo text")) ?? panic("write mismatched narinfo")
    assert(Store.verify_cache_transfer(&roots, &entry.id, "public").is_err())
    mismatched_destination :: Scratch.new("cache-mismatched-rejected")
    assert(Store.substitute_cache_entry(&roots, &entry.id, "public", &mismatched_destination.join("out")).is_err())
    assert(!mismatched_destination.join("out").exists())
    clear_negative_hint()
    replayed := Store.NarInfo.parse(String.from_utf8(&info_bytes) ?? panic("UTF8")) ?? panic("parse narinfo")
    replayed.store_path = "/jet/hangar/{entry.envelope.output_hash}-replayed"
    fs.write(info, (replayed.signed(&cache_key) ?? panic("sign")).to_text() ?? panic("narinfo text")) ?? panic("write replayed narinfo")
    assert(Store.verify_cache_transfer(&roots, &entry.id, "public").is_err())
    clear_negative_hint()
    fs.write(info, &info_bytes) ?? panic("restore narinfo")
    malicious_nar :: "this is not a NAR".as_bytes()
    malicious := Store.NarInfo.parse(String.from_utf8(&info_bytes) ?? panic("UTF8")) ?? panic("parse narinfo")
    malicious.file_size = U64(malicious_nar.len())
    malicious.nar_size = U64(malicious_nar.len())
    malicious.nar_hash = Store.nar_digest(malicious_nar)
    fs.write(nar, malicious_nar) ?? panic("write malicious NAR")
    fs.write(info, (malicious.signed(&cache_key) ?? panic("sign")).to_text() ?? panic("narinfo text")) ?? panic("write malicious narinfo")
    assert(Store.verify_cache_transfer(&roots, &entry.id, "public").is_err())
    malicious_destination :: Scratch.new("cache-malicious-rejected")
    assert(Store.substitute_cache_entry(&roots, &entry.id, "public", &malicious_destination.join("out")).is_err())
    assert(!malicious_destination.join("out").exists())
    clear_negative_hint()
    fs.write(nar, &nar_bytes) ?? panic("restore NAR")
    fs.write(info, &info_bytes) ?? panic("restore narinfo")
    fs.write(nar, "corrupted cache bytes".as_bytes()) ?? panic("corrupt NAR")
    assert(Store.verify_cache_transfer(&roots, &entry.id, "public").is_err())
    rejected :: Scratch.new("cache-rejected")
    assert(Store.substitute_cache_entry(&roots, &entry.id, "public", &rejected.join("out")).is_err())
    assert(!rejected.join("out").exists())
    fs.write(root.join("trust/cache-public.key"), [U8].repeat(0x7f, 32)) ?? panic("change cache key")
    changed_key :: Store.verify_cache_transfer(&roots, &entry.id, "public").expect_err("changed key").to_string()
    assert(changed_key.contains("cache key for `public` changed"), "{changed_key}")
    fs.write(root.join("trust/cache-public.key"), cache_key_bytes) ?? panic("restore cache key")
    TrustRoot.revoke_cache_builder(&root.path, &published.builder) ?? panic("revoke builder")
    revoked :: Store.verify_cache_transfer(&roots, &entry.id, "public").expect_err("revoked builder").to_string()
    assert(revoked.contains("revoked"), "{revoked}")
    assert(revoked.contains("rebuild"), "{revoked}")
    revoked_destination :: Scratch.new("cache-revoked-rejected")
    assert(Store.substitute_cache_entry(&roots, &entry.id, "public", &revoked_destination.join("out")).is_err())
    assert(!revoked_destination.join("out").exists())
    revoked_explanation :: ((Store.explain_package(&roots, &entry.id, Store.ExplainLens.Rebuild) ?? panic("explain revoked")) ?? panic("revoked explanation")).to_json()
    assert(revoked_explanation.contains("\"decision\":\"denied\""))
    assert(revoked_explanation.contains("cache builder is revoked"))
}

// Rust: tests/jetpack_engine.rs:584
#Test("cache_cli_json_uses_shared_report_schema") {
    root :: Scratch.new("cache-cli-json-root")
    mirror :: Scratch.new("cache-cli-json-mirror")
    bind :: jetpack().args(["hangar", "cache", "bind", "public", mirror.path.to_str() ?? panic("mirror text"), "--yes", "--json", "--no-color"])
        .env("JETPACK_ROOT", root.path).output() ?? panic("bind cache CLI")
    assert(bind.status.success(), "stderr: {bind.stderr:?}")
    assert(bind.stderr.is_empty(), "JSON bind leaked stderr: {bind.stderr:?}")
    bind_text :: String.from_utf8_lossy(bind.stdout)
    bind_view := bind_text.trim() // #4303
    bind_report :: JSON.parse(bind_view) ?? panic("cache bind JSON report")
    assert_eq(json_string(&bind_report, "schema"), "jet.report/v1")
    assert_eq(json_string(&bind_report, "moment"), "tool")
    assert_eq(json_string(&bind_report, "action"), "cache-bind")
    assert_eq(json_string(&bind_report, "role"), "public")
    list :: jetpack().args(["hangar", "cache", "list", "--json", "--no-color"]).env("JETPACK_ROOT", root.path).output() ?? panic("list cache CLI")
    assert(list.status.success(), "stderr: {list.stderr:?}")
    assert(list.stderr.is_empty(), "JSON list leaked stderr: {list.stderr:?}")
    list_stdout :: String.from_utf8_lossy(list.stdout)
    list_view := list_stdout.trim() // #4303
    list_report :: JSON.parse(list_view) ?? panic("cache list JSON report")
    assert_eq(json_string(&list_report, "schema"), "jet.report/v1")
    assert_eq(json_string(&list_report, "action"), "cache-list")
    assert(list_stdout.contains("\"bindings\":["))
    repeated :: jetpack().args(["hangar", "cache", "list", "--json", "--no-color"]).env("JETPACK_ROOT", root.path).output() ?? panic("repeat cache list")
    assert_eq(repeated.stdout, list.stdout)
    missing :: jetpack().args(["hangar", "cache", "verify", "missing", "--json", "--no-color"]).env("JETPACK_ROOT", root.path).output() ?? panic("verify missing cache")
    assert_eq(missing.status.code(), Val(2))
    assert(missing.stderr.is_empty(), "JSON failure leaked stderr: {missing.stderr:?}")
    missing_text :: String.from_utf8_lossy(missing.stdout)
    missing_view := missing_text.trim() // #4303
    missing_report :: JSON.parse(missing_view) ?? panic("cache failure JSON report")
    assert_eq(json_string(&missing_report, "schema"), "jet.report/v1")
    assert_eq(json_string(&missing_report, "code"), "E1340")
    remove :: jetpack().args(["hangar", "cache", "remove", "public", "--yes", "--json", "--no-color"]).env("JETPACK_ROOT", root.path).output() ?? panic("remove cache")
    assert(remove.status.success(), "stderr: {remove.stderr:?}")
    remove_text :: String.from_utf8_lossy(remove.stdout)
    remove_view := remove_text.trim() // #4303
    remove_report :: JSON.parse(remove_view) ?? panic("cache remove JSON report")
    assert_eq(json_string(&remove_report, "schema"), "jet.report/v1")
    assert_eq(json_string(&remove_report, "action"), "cache-remove")
}

// Rust: tests/jetpack_engine.rs:682
#Test("retired_store_verbs_teach_hangar_routes") {
    root :: Scratch.new("retired-store-verbs")
    loop (retired, route) in [(String, String)]{("cache", "hangar cache"), ("shared-store", "hangar shared"), ("vendor", "hangar vendor"), ("clean", "hangar clean"), ("list", "hangar list")} {
        output :: jetpack().args([retired, "--no-color"]).env("JETPACK_ROOT", root.path).output() ?? panic("retired verb")
        stderr :: String.from_utf8_lossy(output.stderr)
        assert_eq(output.status.code(), Val(2), "{retired}: {stderr}")
        assert(stderr.contains("Error [E1354]"), "{retired}: {stderr}")
        assert(stderr.contains("jetpack {route}"), "{retired}: {stderr}")
    }
}

