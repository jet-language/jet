// Rust: tests/jetpack_engine.rs:1
use Jetpack.CLI.Tests.Integration.JetpackEngine.*
use Jetpack.CLI.Tests.Integration.Support.JetpackFixtures.*
use Jetpack.[Store, TrustRoot, Envelope, JSON, EnvHook]
use Compiler.[Manifest, Publish]
use core.sys
// GATE #4494: real native filesystem, subprocesses, clock, permissions and symlinks.
use std.[fs, SystemTime, UNIX_EPOCH]

// Rust: tests/jetpack_engine.rs:84
#Test("hangar_path_reports_the_native_user_data_location") {
    data :: Scratch.new("hangar-path-data")
    output :: jet().args(["hangar", "path", "--no-color"]).env_remove("JETPACK_ROOT")
        .env("XDG_DATA_HOME", data.path).env_remove("XDG_STATE_HOME").env_remove("LOCALAPPDATA").output() ?? panic("hangar path")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    home :: std.env.var_os("USERPROFILE").or_else(() -> std.env.var_os("HOME")) ?? panic("home directory environment variable")
    expected :: if sys.target.selected_os() == "macos" {
        OSPath.from(home).join("Library/Application Support/Jet/Hangar")
    } else if sys.target.selected_os() == "windows" {
        OSPath.from(home).join("AppData/Local/Jet/Hangar")
    } else { data.path.join("jet/hangar") }
    assert_eq(String.from_utf8_lossy(output.stdout).trim(), expected.display().to_string())
}

// Rust: tests/jetpack_engine.rs:116
#Test("checked_hangar_listing_rejects_oversized_metadata") {
    scratch :: Scratch.new("hangar-scale-budget")
    roots :: Store.Roots.at(scratch.path)
    object :: roots.hangar_dir().join("oversized")
    fs.create_dir_all(object) ?? panic("create object")
    fs.write(object.join("meta.json"), [U8].repeat(120, (1 << 20) + 1)) ?? panic("write oversized metadata")
    error :: Store.list_checked(&roots).expect_err("oversized metadata must fail")
    assert(error.to_string().contains("exceeds 1048576 bytes"), "{error}")
}

// Rust: tests/jetpack_engine.rs:131
#Test("hangar_migration_round_trips_without_consuming_legacy_state") {
    legacy :: Scratch.new("hangar-migration-legacy")
    data :: Scratch.new("hangar-migration-data")
    old_hangar :: legacy.join("jet/hangar")
    fs.create_dir_all(old_hangar) ?? panic("create legacy")
    fs.write(old_hangar.join("migration-marker"), "legacy bytes") ?? panic("write legacy marker")
    output :: jet().args(["hangar", "path", "--no-color"]).env_remove("JETPACK_ROOT")
        .env("XDG_STATE_HOME", legacy.path).env("XDG_DATA_HOME", data.path).env_remove("LOCALAPPDATA").output() ?? panic("migration")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    new_hangar :: data.join("jet/hangar")
    assert_eq(fs.read_to_string(new_hangar.join("migration-marker")) ?? panic("read migrated marker"), "legacy bytes")
    assert_eq(fs.read_to_string(old_hangar.join("migration-marker")) ?? panic("read legacy marker"), "legacy bytes")
    assert(!data.join("jet/.hangar-migration.partial").exists())
    fs.remove_dir_all(new_hangar) ?? panic("remove migrated tree")
    rollback :: jet().args(["hangar", "path", "--no-color"]).env_remove("JETPACK_ROOT")
        .env("XDG_STATE_HOME", legacy.path).env("XDG_DATA_HOME", data.path).env_remove("LOCALAPPDATA").output() ?? panic("repeat migration")
    assert(rollback.status.success(), "stderr: {String.from_utf8_lossy(rollback.stderr)}")
    assert_eq(fs.read_to_string(new_hangar.join("migration-marker")) ?? panic("read migrated marker"), "legacy bytes")
    assert_eq(fs.read_to_string(old_hangar.join("migration-marker")) ?? panic("read legacy marker"), "legacy bytes")
    assert(!data.join("jet/.hangar-migration.partial").exists())
}

// Rust: tests/jetpack_engine.rs:189
#Test("hangar_migration_rejects_path_escape_and_leaves_repair_state_visible") {
    if sys.target.selected_os() != "linux" -> return
    legacy :: Scratch.new("hangar-migration-escape-legacy")
    data :: Scratch.new("hangar-migration-escape-data")
    old_hangar :: legacy.join("jet/hangar")
    fs.create_dir_all(old_hangar) ?? panic("create legacy")
    outside :: legacy.join("escape-target")
    fs.write(outside, "must stay outside") ?? panic("write outside")
    fs.symlink("../../escape-target", old_hangar.join("escape")) ?? panic("escape link")
    output :: jet().args(["hangar", "path", "--no-color"]).env_remove("JETPACK_ROOT")
        .env("XDG_STATE_HOME", legacy.path).env("XDG_DATA_HOME", data.path).env_remove("LOCALAPPDATA").output() ?? panic("migration escape")
    assert_eq(output.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("E2604"), "{stderr}")
    assert(stderr.contains("escapes its migration root"), "{stderr}")
    assert(!data.join("jet/hangar").exists())
    assert(data.join("jet/.hangar-migration.partial").is_dir())
    assert_eq(fs.read_to_string(outside) ?? panic("read outside"), "must stay outside")
    retry :: jet().args(["hangar", "path", "--no-color"]).env_remove("JETPACK_ROOT")
        .env("XDG_STATE_HOME", legacy.path).env("XDG_DATA_HOME", data.path).env_remove("LOCALAPPDATA").output() ?? panic("retry escape")
    assert_eq(retry.status.code(), Val(2))
    assert(String.from_utf8_lossy(retry.stderr).contains("incomplete Hangar migration"), "{String.from_utf8_lossy(retry.stderr)}")
    assert_eq(fs.read_to_string(outside) ?? panic("read outside"), "must stay outside")
}

