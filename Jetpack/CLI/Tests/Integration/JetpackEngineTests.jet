// Rust: tests/jetpack_engine.rs:1780
#Test("package_policy_authorizes_spdx_and_source_mapping_through_publish_seam") {
    raw :: """
name: "consumer"
version: "0.1.0"
license: "MIT"
policy: {
    licenses: .Allow(["MIT", "Apache-2.0"]),
    sources: { "Acme.*": ["internal"] },
}
"""
    manifest :: Manifest.parse(OSPath.from("package.jet"), &raw) ?? panic("policy manifest")
    assert_eq(manifest.policy.licenses, Val([String]{"MIT", "Apache-2.0"}))
    assert_eq(manifest.policy.source_maps, [(String, [String])]{("Acme.*", [String]{"internal"})})
    receipt :: Publish.authorize_package_candidate(&manifest.policy, "Acme.Widget", "1.2.3", Val("MIT OR Apache-2.0"), "internal") ?? panic("mapped SPDX candidate should be allowed")
    assert(receipt.summary().contains("source-rule=Acme.*"))
    assert(receipt.summary().contains("fingerprint=sha256-"))
}
