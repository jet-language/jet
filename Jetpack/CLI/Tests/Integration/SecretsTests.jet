#Test("explicit_path_list_yields_members") {
    dir :: unique_temp_dir("workspace-explicit")
    for (relative, name) in [("packages/hello", "hello"), ("packages/ranker", "ranker")] {
        package :: dir.join(relative)
        fs.create_dir_all(&package).unwrap()
        fs.write(package.join("package.jet"), "name: \"{name}\"\n").unwrap()
    }
    src :: "module workspace {\n    members: [\"./packages/hello\", \"./packages/ranker\"]\n}\n"
    plan :: WorkspaceFile.evaluate(src, &dir).expect("explicit path list should succeed")
    assert_eq(plan.members.len(), 2)
    assert_eq(plan.members[0].name, "hello")
    assert_eq(plan.members[1].name, "ranker")
    _ :: fs.remove_dir_all(dir).ok()
}

// Rust: tests/workspace.rs:42
#Test("package_root_owns_membership_over_retired_workspace_source") {
    dir :: unique_temp_dir("package-members")
    for (relative, name) in [("packages/hello", "hello"), ("packages/ranker", "ranker")] {
        package :: dir.join(relative)
        fs.create_dir_all(&package).unwrap()
        fs.write(package.join("package.jet"), "name: \"{name}\"\n").unwrap()
    }
    fs.write(dir.join("package.jet"), "name: \"root\"\nmembers: [\"packages/hello\", \"packages/ranker\"]\n").unwrap()
    // A stale role file is not a second graph authority.
    fs.write(dir.join("workspace.jet"), "module workspace { members: 1 }\n").unwrap()
    plan :: WorkspaceFile.load(&dir).expect("Package membership should select the graph").expect("Package membership should evaluate")
    names :: plan.members.iter().map((member) -> member.name.as_str()).collect()
    assert_eq(names, ["hello", "ranker"])
    assert_eq(plan.source_digest, SHA256.sha256_hex(fs.read(dir.join("package.jet")).unwrap().as_slice()))
    _ :: fs.remove_dir_all(dir).ok()
}

// Rust: tests/workspace.rs:79
#Test("package_member_cannot_declare_nested_members") {
    dir :: unique_temp_dir("package-nested-members")
    member :: dir.join("packages/app")
    fs.create_dir_all(&member).unwrap()
    fs.write(dir.join("package.jet"), "name: \"root\"\nmembers: [\"packages/app\"]\n").unwrap()
    fs.write(member.join("package.jet"), "name: \"app\"\nmembers: [\"child\"]\n").unwrap()
    error :: WorkspaceFile.load(&dir).expect("Package membership should be discovered").expect_err("nested Package membership must fail")
    assert_eq(error.code, "E1323")
    assert(error.what.contains("packages/app/package.jet"))
    assert(error.why.contains("package.jet"))
    _ :: fs.remove_dir_all(dir).ok()
}

