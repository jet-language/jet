// Rust: tests/secrets.rs:80
#Test("secrets_keygen_set_get_roundtrip_no_plaintext_on_disk") {
    proj :: Scratch.new("roundtrip-proj")
    keys :: Scratch.new("roundtrip-keys")
    setup_vault(&proj, &keys)
    if selected_family() == "unix" {
        assert_eq(fs.metadata(keys.join("secrets.identity")).unwrap().permissions().mode() & 0o777, 0o600,
            "the private identity must never be created with ambient permissions")
    }
    list_out :: jetpack().current_dir(&proj.path).args(["secrets", "recipients", "list"])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("run jetpack secrets recipients list")
    assert(String.from_utf8_lossy(&list_out.stdout).trim().starts_with("age1"))
    PLAINTEXT :: "hunter2-super-secret-value"
    set_out :: jetpack().current_dir(&proj.path).args(["secrets", "set", "db_password", PLAINTEXT])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("run jetpack secrets set")
    assert(set_out.status.success(), "set failed: {String.from_utf8_lossy(&set_out.stderr)}")
    for entry in walk(&proj.path) {
        bytes :: fs.read(&entry).unwrap_or_default()
        text :: String.from_utf8_lossy(&bytes)
        assert(!text.contains(PLAINTEXT), "plaintext leaked into `{entry.display()}` — secrets must only ever touch disk as ciphertext")
    }
    for entry in walk(&proj.path) {
        assert(entry.extension().and_then((e) -> e.to_str()) != Some("tmp"),
            "a stray temp file `{entry.display()}` survived `secrets set` — the write must be atomic")
    }
    store :: proj.path.join(".jet").join("secrets.age")
    assert(store.is_file(), "store must exist after `set`")
    assert(!fs.read(&store).unwrap().is_empty())
    get_out :: jetpack().current_dir(&proj.path).args(["secrets", "get", "db_password"])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("run jetpack secrets get")
    assert(get_out.status.success(), "get failed: {String.from_utf8_lossy(&get_out.stderr)}")
    assert(String.from_utf8_lossy(&get_out.stdout).trim() == PLAINTEXT, "decrypted value mismatch")
    // Existing store replacement must remain atomic on Windows too.
    UPDATED :: "second-super-secret-value"
    update_out :: jetpack().current_dir(&proj.path).args(["secrets", "set", "db_password", UPDATED])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("update existing secret")
    assert(update_out.status.success(), "update failed: {String.from_utf8_lossy(&update_out.stderr)}")
    updated_get :: jetpack().current_dir(&proj.path).args(["secrets", "get", "db_password"])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("read updated secret")
    assert(updated_get.status.success())
    assert(String.from_utf8_lossy(&updated_get.stdout).trim() == UPDATED, "updated secret mismatch")
    for entry in walk(&proj.path) {
        bytes :: fs.read(&entry).unwrap_or_default()
        text :: String.from_utf8_lossy(&bytes)
        assert(!text.contains(PLAINTEXT), "old plaintext leaked into `{entry.display()}`")
        assert(!text.contains(UPDATED), "updated plaintext leaked into `{entry.display()}`")
    }
}

// Rust: tests/secrets.rs:205
#Test("secrets_unset_reencrypts_store_and_removes_value") {
    proj :: Scratch.new("unset-proj")
    keys :: Scratch.new("unset-keys")
    setup_vault(&proj, &keys)
    REMOVED :: "unset-value-never-printed"
    set_removed :: jetpack().current_dir(&proj.path).args(["secrets", "set", "removed_name", REMOVED])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("set removed secret")
    assert(set_removed.status.success(), "initial secret setup failed")
    set_kept :: jetpack().current_dir(&proj.path).args(["secrets", "set", "kept_name", "kept-value"])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("set kept secret")
    assert(set_kept.status.success(), "second secret setup failed")
    store :: proj.path.join(".jet").join("secrets.age")
    before :: fs.read(&store).unwrap()
    unset :: jetpack().current_dir(&proj.path).args(["secrets", "unset", "removed_name"])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("unset secret")
    assert(unset.status.success(), "unset failed")
    assert(!String.from_utf8_lossy(&unset.stdout).contains(REMOVED) && !String.from_utf8_lossy(&unset.stderr).contains(REMOVED), "unset output leaked a secret value")
    assert(before != fs.read(&store).unwrap(), "unset must re-encrypt the store")
    assert(!String.from_utf8_lossy(&fs.read(&store).unwrap()).contains(REMOVED))
    missing :: jetpack().current_dir(&proj.path).args(["secrets", "get", "removed_name"])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("read removed secret")
    assert(!missing.status.success(), "removed secret was still readable")
    assert(strip_ansi(&String.from_utf8_lossy(&missing.stderr)).contains("E1263"), "removed secret must return not-found")
}

// Rust: tests/secrets.rs:262
#Test("secrets_list_prints_names_without_values") {
    proj :: Scratch.new("list-proj")
    keys :: Scratch.new("list-keys")
    setup_vault(&proj, &keys)
    FIRST_VALUE :: "list-value-one-never-printed"
    SECOND_VALUE :: "list-value-two-never-printed"
    for (name, value) in [("first_name", FIRST_VALUE), ("second_name", SECOND_VALUE)] {
        set :: jetpack().current_dir(&proj.path).args(["secrets", "set", name, value])
            .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("set listed secret")
        assert(set.status.success(), "listed secret setup failed")
    }
    list :: jetpack().current_dir(&proj.path).args(["secrets", "list"])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("list secrets")
    assert(list.status.success(), "list failed")
    assert(String.from_utf8_lossy(&list.stdout).lines().collect() == ["first_name", "second_name"], "list must print declared names only")
    output :: "{String.from_utf8_lossy(&list.stdout)}{String.from_utf8_lossy(&list.stderr)}"
    assert(!output.contains(FIRST_VALUE), "list output leaked a secret value")
    assert(!output.contains(SECOND_VALUE), "list output leaked a secret value")
}

// Rust: tests/secrets.rs:308
#Test("secrets_import_dotenv_preserves_source_and_reports_names") {
    proj :: Scratch.new("import-proj")
    keys :: Scratch.new("import-keys")
    setup_vault(&proj, &keys)
    API_VALUE :: "import-api-value-never-printed"
    TOKEN_VALUE :: "import-token-value-never-printed"
    SESSION_VALUE :: "import-session-value-never-printed"
    source :: "# source remains unchanged\nAPI_URL={API_VALUE}\nIMPORTED_TOKEN=\"{TOKEN_VALUE}\"\nexport SESSION_KEY={SESSION_VALUE}\n"
    env_file :: proj.path.join(".env")
    fs.write(&env_file, &source).unwrap()
    before :: fs.read(&env_file).unwrap()
    imported :: jetpack().current_dir(&proj.path).args(["secrets", "import"])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("import .env secrets")
    assert(imported.status.success(), "dotenv import failed")
    output :: "{String.from_utf8_lossy(&imported.stdout)}{strip_ansi(&String.from_utf8_lossy(&imported.stderr))}"
    for name in ["API_URL", "IMPORTED_TOKEN", "SESSION_KEY"] { assert(output.contains(name), "import output omitted a secret name") }
    assert(output.contains("left `.env` untouched"), "import omitted source advice")
    assert(output.contains("remove it"), "import omitted cleanup advice")
    assert(!output.contains(API_VALUE), "import output leaked a secret value")
    assert(!output.contains(TOKEN_VALUE), "import output leaked a secret value")
    assert(!output.contains(SESSION_VALUE), "import output leaked a secret value")
    assert(fs.read(&env_file).unwrap() == before, "import changed the source file")
    get :: jetpack().current_dir(&proj.path).args(["secrets", "get", "IMPORTED_TOKEN"])
        .env("JET_KEYS_DIR", keys.path.to_str().unwrap()).output().expect("read imported secret")
    assert(get.status.success(), "imported secret was not stored")
    assert(String.from_utf8_lossy(&get.stdout).trim() == TOKEN_VALUE, "imported secret value mismatch")
}

