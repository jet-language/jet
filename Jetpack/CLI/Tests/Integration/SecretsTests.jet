// Rust: tests/workspace.rs:193
#Test("dot_form_classified_when_source_is_declared") {
    table :: SourceTable.from_decls([("mono", "github:acme/monorepo", ProviderKind.default())])
    r :: classify_in("mono.ranker", &table).expect("dot form should classify")
    assert(match r.source { Source.Named(s) -> s == "mono"; _ -> false }, "expected Named(\"mono\"), got {r.source:?}")
    assert_eq(r.package, "ranker")
}

// Rust: tests/workspace.rs:214
#Test("source_form_still_works") {
    table :: SourceTable.from_decls([("mono", "github:acme/monorepo", ProviderKind.default())])
    r :: classify_in("ranker@mono", &table).expect("source form should classify")
    assert(match r.source { Source.Named(_) -> true; _ -> false })
    assert_eq(r.package, "ranker")
}

