    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/workspace.rs:433
#Test("discovery_probe_skips_deep_non_workspace_jet_without_stack_overflow") {
    nanos :: SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()
    dir :: env.temp_dir().join("ws-deep-probe-{nanos}")
    fs.create_dir_all(&dir).unwrap()
    // Declaration probe must stay token-cheap instead of parsing deep lambdas.
    deep := String.from("fn run() {\n    x :: ")
    for _ in 0..400 { deep.push_str("(() => ") }
    deep.push('1')
    for _ in 0..400 { deep.push(')') }
    deep.push_str("\n}\n")
    fs.write(dir.join("noise.jet"), deep).unwrap()
    assert(WorkspaceFile.load(&dir).is_none(), "deep non-workspace file must not count as a workspace index")
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/workspace_crates.rs:73
#Test("workspace_crates_keep_declared_dependency_direction") {
    assert_deps("crates/jet-foundation/Cargo.toml", &[])
    assert_deps("crates/jet-lexer/Cargo.toml", &["jet-foundation"])
    assert_deps("crates/jet-parser/Cargo.toml", &["jet-foundation", "jet-lexer"])
    assert_deps("crates/jet-comptime/Cargo.toml", &["jet-foundation", "jet-net"])
    assert_deps("crates/jet-sema/Cargo.toml", &["jet-comptime", "jet-foundation", "jet-lexer", "jet-parser"])
    assert_deps("crates/jet-codegen/Cargo.toml", &["jet-foundation", "jet-sema"])
    assert_deps("crates/jet-driver/Cargo.toml", &["jet-codegen", "jet-comptime", "jet-foundation", "jet-lexer",
        "jet-parser", "jet-pkg-model", "jet-queries", "jet-sema"])
    // Read-only model and pure plan layers depend inward, never on realizers.
    assert_deps("crates/jet-pkg-model/Cargo.toml", &["jet-sema"])
    assert_deps("crates/jet-env-model/Cargo.toml", &["jet-codegen", "jet-pkg-model"])
    assert_deps("crates/jetpack/Cargo.toml", &["jet-codegen", "jet-comptime", "jet-env-model", "jet-foundation",
        "jet-lexer", "jet-nix-eval", "jet-net", "jet-parser", "jet-pkg-model", "jet-sema"])
    assert_deps("crates/jet-queries/Cargo.toml", &[])
    assert_deps("crates/jet-rt/Cargo.toml", &["jet-foundation"])
    assert_deps("crates/jet-net/Cargo.toml", &[])
    assert_deps("crates/jet-semindex/Cargo.toml", &["jet-driver", "jet-foundation", "jet-lexer", "jet-sema"])
    assert_deps("crates/jet-impact/Cargo.toml", &["jet-semindex"])
    assert_deps("crates/jet-repl/Cargo.toml", &["jet-driver", "jet-foundation", "jet-semindex"])
    assert_deps("crates/jet-debug/Cargo.toml", &["jet-driver", "jet-foundation"])
    assert_deps("crates/jet-cli/Cargo.toml", &["jet-foundation", "jet-repl", "jet-semindex"])
    assert_deps("crates/jet-canvas/Cargo.toml", &["jet-foundation"])
    assert_deps("crates/jet-devserver/Cargo.toml", &["jet-canvas", "jet-debug", "jet-driver", "jet-env-model",
        "jet-impact", "jet-repl", "jet-semindex"])
    assert_deps("crates/jet-jit/Cargo.toml", &["jet-codegen", "jet-foundation", "jet-rt"])
    assert_deps("crates/jetos/Cargo.toml", &["jetpack"])
    assert_deps("Cargo.toml", &["jet-debug", "jet-cli", "jet-canvas", "jet-devserver", "jet-driver", "jet-env-model",
        "jet-foundation", "jet-impact", "jet-jit", "jet-queries", "jet-repl", "jet-semindex", "jetpack"])
}

// Rust: tests/workspace_crates.rs:211
#Test("jetpack_dependency_debt_is_explicit_until_product_split") {
    root :: OSPath.from(env!("CARGO_MANIFEST_DIR"))
    // Root keeps genuine engine dispatch; JetOS retains realization dependency.
    allowed :: ["Cargo.toml", "crates/jetos/Cargo.toml"]
    actual: [String] := []
    for manifest in repo_files_with_suffix("crates", "Cargo.toml").into_iter().chain([root.join("Cargo.toml")]) {
        rel :: manifest.strip_prefix(&root).unwrap().to_string_lossy().replace('\\', "/")
        if manifest_deps(&fs.read_to_string(&manifest).unwrap()).contains("jetpack") { actual.push(rel) }
    }
    actual.sort()
    assert_eq(actual, allowed, "new jetpack crate dependency added outside the current product-split debt list")
}

// Rust: tests/workspace_crates.rs:253
#Test("direct_jetpack_imports_stay_behind_known_boundaries") {
    root :: OSPath.from(env!("CARGO_MANIFEST_DIR"))
    allowed :: ["crates/jetos/src/main.rs", "Source/LSP/Completion.rs", "Source/LSP/Server.rs", "Source/lib.rs",
        "Source/main.rs"].into_iter().map((path) -> String.from(path)).collect[BTreeSet[String]]()
    actual := BTreeSet[String].new()
    for file in repo_files_with_suffix("Source", ".rs").into_iter().chain(repo_files_with_suffix("crates", ".rs")) {
        text :: fs.read_to_string(&file).unwrap()
        code_text :: text.lines().map((line) -> line.split_once("//").map((pair) -> pair.0).unwrap_or(line)).collect().join("\n")
        if code_text.contains("crate::Jetpack")
            || code_text.lines().any((line) -> line.trim() == "use jetpack;" || line.trim() == "pub use jetpack;")
            || code_text.contains("pub use jetpack as ") || code_text.contains("use jetpack as ") || code_text.contains("jetpack::") {
            rel :: file.strip_prefix(&root).unwrap().to_string_lossy().replace('\\', "/")
            if rel.contains("/tests/") || rel.starts_with("crates/jetpack/") { continue }
            _ :: actual.insert(rel)
        }
    }
    assert_eq(actual, allowed, "new direct Jetpack coupling added; route it through a product boundary first")
}

// Rust: tests/workspace_crates.rs:323
#Test("jet_codegen_lib_tests_compile") {
    // Peer Rust comparator gate; compile all codegen lib tests even in default root suite.
    output :: Command.new("cargo").args(["test", "-p", "jet-codegen", "--lib", "--no-run", "--quiet"])
        .output().expect("cargo test -p jet-codegen --lib --no-run")
    assert(output.status.success(), "jet-codegen lib tests must compile\nstdout:\n{String.from_utf8_lossy(&output.stdout)}\nstderr:\n{String.from_utf8_lossy(&output.stderr)}")
}
