    dir :: env.temp_dir().join("ws-e1239-{nanos}")
    fs.create_dir_all(&dir).unwrap()
    fs.write(dir.join("a.jet"), "module workspace { members: [] }\n").unwrap()
    fs.write(dir.join("b.jet"), "module workspace { members: [] }\n").unwrap()
    d :: WorkspaceFile.load(&dir).expect("workspace files present").expect_err("duplicate workspace declarations")
