// Rust: tests/workspace.rs:244
#Test("bare_and_path_form_resolve_workspace_members") {
    index :: WorkspaceIndex.from_members([("logging", "./infra/logging"), ("ranker", "packages/ranker")])
    r :: classify_with_workspace("logging", &SourceTable.empty(), &index).unwrap()
    assert_eq(r.source, Source.Path)
    assert_eq(r.package, "infra/logging")
    r2 :: classify_with_workspace("packages/ranker", &SourceTable.empty(), &index).unwrap()
    assert_eq(r2.package, "packages/ranker")
}

