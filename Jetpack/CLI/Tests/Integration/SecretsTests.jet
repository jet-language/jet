// Rust: tests/secrets_expiry.rs:248
#Test("expiring_secret_system_observation_is_not_pure") {
    src :: """
use core.crypto as crypto
use core.crypto.vault as vault
fn inspect(secret: &ExpiringSecret<crypto.SigningKey>) -[]> Bool {
    return secret.with((borrowed) -> borrowed.public_key()) == .Ok(_)
}
fn run() {
    ttl := Duration.seconds(1) ?? panic("duration")
    key := crypto.SigningKey.new_random() ?? panic("key")
    secret := vault.ExpiringSecret.new(^key, ttl, Clock.system())
    print(inspect(&secret))
}
"""
    diags :: compile(src).expect_err("a hidden system clock must remain effectful")
    assert(diags.iter().any((diag) -> diag.code == "E3403"), "{diags:?}")
}

// Rust: tests/secrets_expiry.rs:268
#Test("expiring_secret_requires_ownership_and_rejects_loan_escape") {
    no_move :: """
use core.crypto as crypto
use core.time as time
use core.crypto.vault as vault
fn run() {
    clock := Clock.new(0)
    ttl := Duration.seconds(1) ?? panic("duration")
    key := crypto.SigningKey.new_random() ?? panic("key")
    _ := vault.ExpiringSecret.new(key, ttl, clock)
}
"""
    diags :: compile(no_move).expect_err("named secret must move into the wrapper")
    assert(diags.iter().any((diag) -> diag.code == "E0201"), "wrong ownership diagnostic: {diags:?}")
    escape :: """
use core.crypto as crypto
use core.time as time
use core.crypto.vault as vault
fn run() {
    clock := Clock.new(0)
    ttl := Duration.seconds(1) ?? panic("duration")
    key := crypto.SigningKey.new_random() ?? panic("key")
    secret := vault.ExpiringSecret.new(^key, ttl, clock)
    _ := secret.with((borrowed) -> borrowed)
}
"""
    escape_diags :: compile(escape).expect_err("callback loan must not escape")
    assert(escape_diags.iter().any((diag) -> diag.code == "E0201" && diag.what.contains("loan cannot escape")))
    closure_escape :: """
use core.crypto as crypto
use core.time as time
use core.crypto.vault as vault
fn run() {
    clock := Clock.new(0)
    ttl := Duration.seconds(1) ?? panic("duration")
    key := crypto.SigningKey.new_random() ?? panic("key")
    secret := vault.ExpiringSecret.new(^key, ttl, clock)
    _ := secret.with((borrowed) -> () -> borrowed.public_key())
}
"""
    closure_diags :: compile(closure_escape).expect_err("callback closure must not capture the loan")
    assert(closure_diags.iter().any((diag) -> diag.code == "E0201"), "closure escape needs an ownership diagnostic: {closure_diags:?}")
    storage_escape :: """
use core.crypto as crypto
use core.time as time
use core.crypto.vault as vault
fn run() {
    clock := Clock.new(0)
    ttl := Duration.seconds(1) ?? panic("duration")
    key := crypto.SigningKey.new_random() ?? panic("key")
    secret := vault.ExpiringSecret.new(^key, ttl, clock)
    _ := secret.with((borrowed) -> {
        saved := [borrowed]
        return saved
    })
}
"""
    storage_diags :: compile(storage_escape).expect_err("callback loan must not enter storage")
    assert(storage_diags.iter().any((diag) -> diag.code == "E0201"), "storage escape needs an ownership diagnostic: {storage_diags:?}")
}

// Rust: tests/secrets_expiry.rs:349
#Test("expiring_secret_loan_rejects_move_variadic_and_drop_paths") {
    cases :: [
        ("move parameter", """
use core.crypto as crypto
use core.time as time
use core.crypto.vault as vault
fn consume(value: ^crypto.SigningKey) {}
fn run() {
    clock := Clock.new(0)
    ttl := Duration.seconds(1) ?? panic("duration")
    key := crypto.SigningKey.new_random() ?? panic("key")
    secret := vault.ExpiringSecret.new(^key, ttl, clock)
    _ := secret.with((borrowed) -> {
        consume(^borrowed)
        return 0
    })
}
"""),
        ("variadic collection", """
use core.crypto as crypto
use core.time as time
use core.crypto.vault as vault
fn collect(values: ...crypto.SigningKey) {}
fn run() {
    clock := Clock.new(0)
    ttl := Duration.seconds(1) ?? panic("duration")
    key := crypto.SigningKey.new_random() ?? panic("key")
    secret := vault.ExpiringSecret.new(^key, ttl, clock)
    _ := secret.with((borrowed) -> {
        collect(borrowed)
        return 0
    })
}
"""),
        ("explicit consume/drop", """
use core.crypto as crypto
use core.time as time
use core.crypto.vault as vault
fn run() {
    clock := Clock.new(0)
    ttl := Duration.seconds(1) ?? panic("duration")
    key := crypto.SigningKey.new_random() ?? panic("key")
    secret := vault.ExpiringSecret.new(^key, ttl, clock)
    _ := secret.with((borrowed) -> {
        #Unsafe("attempt to discard a loan") { consume(borrowed) }
        return 0
    })
}
"""),
    ]
    for (name, src) in cases {
        diagnostics :: compile(src).expect_err(name)
        assert(diagnostics.iter().any((diagnostic) -> diagnostic.code == "E0201"), "{name} did not reject the loan: {diagnostics:#?}")
    }
}

// Rust: tests/secrets_expiry.rs:420
#Test("generic_ttl_remains_while_expiring_secret_replaces_rotting") {
    // Behavioral surface checks replace retired generated-Rust struct assertions.
    _ :: compile("fn run() {}").expect("empty program compiles")
    generic :: compile("fn keep(value: Expiring<Int>) {}\nfn run() {}")
    assert(generic.is_ok(), "generic TTL carrier must remain available: {generic.err():?}")
    secret :: compile("use core.crypto as crypto\nfn keep(value: ExpiringSecret<crypto.SigningKey>) {}\nfn run() {}")
    assert(secret.is_ok(), "closed expiring secret carrier must remain available: {secret.err():?}")
    _ :: compile("fn keep(value: Rotting<Int>) {}\nfn run() {}").expect_err("retired Rotting carrier must not be available")
}

