// Rust: tests/workspace.rs:307
#Test("workspace_find_example_evaluates") {
    nanos :: SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()
    dir :: env.temp_dir().join("ws-commit-test-{nanos}")
    packages :: dir.join("packages")
    hello :: packages.join("hello")
    ranker :: packages.join("ranker")
    fs.create_dir_all(&hello).unwrap()
    fs.create_dir_all(&ranker).unwrap()
    fs.write(hello.join("package.jet"), "name: \"hello\"\n").unwrap()
    fs.write(ranker.join("package.jet"), "name: \"ranker\"\n").unwrap()
    fs.write(dir.join("workspace.jet"), "module workspace {\n    members: find(\"./packages\")\n}\n").unwrap()
    src :: fs.read_to_string(dir.join("workspace.jet")).unwrap()
    plan :: WorkspaceFile.evaluate(&src, &dir).expect("workspace.jet with find() must evaluate without errors")
    names := plan.members.iter().map((m) -> m.name.as_str()).collect()
    names.sort()
    assert_eq(names, ["hello", "ranker"], "members: {plan.members:?}")
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/workspace.rs:342
#Test("committed_monorepo_example_indexes_and_addresses_members") {
    dir :: OSPath.new(env!("CARGO_MANIFEST_DIR")).join("Examples/features/packages/monorepo")
    src :: fs.read_to_string(dir.join("workspace.jet")).expect("committed monorepo example must have a workspace.jet")
    plan :: WorkspaceFile.evaluate(&src, &dir).expect("example workspace must evaluate clean")
    names := plan.members.iter().map((m) -> m.name.as_str()).collect()
    names.sort()
    assert_eq(names, ["hello", "ranker"], "members: {plan.members:?}")
    index :: WorkspaceIndex.from_members(plan.members.iter().map((m) -> (m.name.clone(), m.path.clone())))
    hello :: classify_with_workspace("hello", &SourceTable.empty(), &index).expect("bare `hello` must resolve")
    assert_eq(hello.source, Source.Path)
    assert(hello.package.ends_with("hello"), "got {hello.package}")
    ranker_path :: plan.members.iter().find((m) -> m.name == "ranker").map((m) -> m.path.trim_start_matches("./").to_string()).unwrap()
    ranker :: classify_with_workspace(&ranker_path, &SourceTable.empty(), &index).expect("path form must resolve")
    assert(ranker.package.ends_with("ranker"), "got {ranker.package}")
}

// Rust: tests/workspace.rs:382
#Test("find_discovers_packages_with_package_jet") {
    nanos :: SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()
    tmp :: env.temp_dir().join("ws-find-test-{nanos}")
    hello :: tmp.join("packages/hello")
    fs.create_dir_all(&hello).unwrap()
    fs.write(hello.join("package.jet"), "name: \"hello\"\n").unwrap()
    ranker :: tmp.join("packages/ranker")
    fs.create_dir_all(&ranker).unwrap()
    fs.write(ranker.join("package.jet"), "name: \"ranker\"\n").unwrap()
    fs.create_dir_all(tmp.join("packages/bare")).unwrap()
    src :: "module workspace { members: find(\"./packages\") }\n"
    plan :: WorkspaceFile.evaluate(src, &tmp).expect("find should succeed")
    assert_eq(plan.members.len(), 2, "expected 2 members: {plan:?}")
    names :: plan.members.iter().map((m) -> m.name.as_str()).collect()
    assert(names.contains("hello"), "names: {names:?}")
    assert(names.contains("ranker"), "names: {names:?}")
    _ :: fs.remove_dir_all(&tmp).ok()
}

