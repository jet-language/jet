// Rust: tests/jetpack_services.rs:159
#Test("services_up_health_logs_down_roundtrip") {
    proj :: Scratch.new("roundtrip")
    root :: Scratch.new("roundtrip-root")
    home :: Scratch.new("roundtrip-home")
    write_project(&proj.path, "fixture: {{ run: [\"sh\", \"-c\", \"echo fixture-started; sleep 30\"] }}", "fn run() {{}}\n")
    vars :: [("JETPACK_ROOT", root.path.display().to_string()), ("HOME", home.path.display().to_string())]
    up :: jetpack().args(["services", "up", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("up")
    assert(up.status.success(), "stderr: {String.from_utf8_lossy(up.stderr)}")
    health :: jetpack().args(["services", "health", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("health")
    assert(health.status.success(), "stderr: {String.from_utf8_lossy(health.stderr)}")
    wait :: jetpack().args(["services", "wait", "fixture", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("wait")
    assert(wait.status.success(), "stderr: {String.from_utf8_lossy(wait.stderr)}")
    assert(String.from_utf8_lossy(wait.stderr).contains("service `fixture` is ready"), "stderr: {String.from_utf8_lossy(wait.stderr)}")
    logs :: jetpack().args(["services", "logs", "fixture", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("logs")
    logs_out :: String.from_utf8_lossy(logs.stdout)
    assert(logs_out.contains("fixture-started"), "logs: {logs_out}")
    down :: jetpack().args(["services", "down", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("down")
    assert(down.status.success(), "stderr: {String.from_utf8_lossy(down.stderr)}")
    // Stopped now: a fresh health check must report unhealthy.
    health_after :: jetpack().args(["services", "health", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("health after down")
    assert(!health_after.status.success())
}

// Rust: tests/jetpack_services.rs:246
#Test("services_from_nested_project_directory_use_the_project_state_root") {
    proj :: Scratch.new("nested-services")
    root :: Scratch.new("nested-services-root")
    home :: Scratch.new("nested-services-home")
    write_project(&proj.path, "fixture: {{ run: [\"sh\", \"-c\", \"echo nested-started; sleep 30\"] }}", "fn run() {{}}\n")
    nested :: proj.path.join("src/nested")
    fs.create_dir_all(nested).expect("create nested directory")
    vars :: [("JETPACK_ROOT", root.path.display().to_string()), ("HOME", home.path.display().to_string())]
    up :: jetpack().args(["services", "up", "--no-color"]).current_dir(nested).envs(vars).output().expect("up")
    assert(up.status.success(), "{String.from_utf8_lossy(up.stderr)}")
    assert(proj.path.join(".jet/services/fixture/pid").is_file())
    assert(!nested.join(".jet/services/fixture/pid").exists())
    health :: jetpack().args(["services", "health", "--no-color"]).current_dir(nested).envs(vars).output().expect("health")
    assert(health.status.success(), "{String.from_utf8_lossy(health.stderr)}")
    down :: jetpack().args(["services", "down", "--no-color"]).current_dir(nested).envs(vars).output().expect("down")
    assert(down.status.success(), "{String.from_utf8_lossy(down.stderr)}")
}

// Rust: tests/jetpack_services.rs:302
#Test("services_wait_reports_readiness_timeout") {
    proj :: Scratch.new("wait-timeout")
    root :: Scratch.new("wait-timeout-root")
    home :: Scratch.new("wait-timeout-home")
    write_project(&proj.path, "fixture: {{ run: [\"sleep\", \"30\"], ready: \"false\" }}", "fn run() {{}}\n")
    out :: jetpack().args(["services", "wait", "fixture", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).env("JETPACK_SERVICE_HEALTH_TIMEOUT_MS", "500").output().expect("wait")
    assert_eq(out.status.code(), Some(1))
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("E1261"), "stderr: {stderr}")
    assert(stderr.contains("service `fixture` is not ready"), "stderr: {stderr}")
}

// Rust: tests/jetpack_services.rs:330
#Test("services_up_readiness_timeout_preserves_startup_failure_receipt") {
    if target.selected_os() == "linux" {
        proj :: Scratch.new("up-timeout-receipt")
        root :: Scratch.new("up-timeout-receipt-root")
        home :: Scratch.new("up-timeout-receipt-home")
        write_project(&proj.path, "timeout: {{ run: [\"sh\", \"-c\", \"sleep 30\"], ready: \"false\" }}", "fn run() {{}}\n")
        out :: jetpack().args(["services", "up", "timeout", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).env("JETPACK_SERVICE_HEALTH_TIMEOUT_MS", "500").output().expect("up")
        assert(!out.status.success(), "readiness timeout unexpectedly succeeded")
        output :: "{String.from_utf8_lossy(out.stdout)}{String.from_utf8_lossy(out.stderr)}"
        assert(output.contains("E1261"), "output: {output}")
        service_dir :: proj.path.join(".jet/services/timeout")
        lifecycle :: fs.read_to_string(service_dir.join("lifecycle")).expect("read lifecycle")
        assert(lifecycle.contains("phase=failed"), "{lifecycle}")
        assert(lifecycle.contains("recovery=startup-failed"), "{lifecycle}")
        assert(service_dir.join("supervisor.error").is_file())
        assert(!service_dir.join("pid").exists())
    }
}

// Rust: tests/jetpack_services.rs:369
// The project dev path must wait for healthy services before invoking dev().
#Test("dev_health_gate_waits_for_service_before_running") {
    proj :: Scratch.new("health-gate")
    root :: Scratch.new("health-gate-root")
    home :: Scratch.new("health-gate-home")
    write_project(&proj.path, "fixture: {{ run: [\"sleep\", \"30\"] }}", "fn dev() {{ print(\"DEV-RAN\") }}\n")
    out :: jetpack().args(["dev", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output().expect("dev")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    stdout :: String.from_utf8_lossy(out.stdout)
    assert(stdout.contains("DEV-RAN"), "stdout: {stdout}")
    // Clean up the fixture daemon left running by dev.
    _ :: jetpack().args(["services", "down", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output().ok()
}

