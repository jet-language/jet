// Rust: tests/jetpack_services.rs:1230
#Test("production_path_persists_linux_authority_and_dependency_lifecycle") {
    if target.selected_os() == "linux" {
        proj :: Scratch.new("authority-lifecycle")
        root :: Scratch.new("authority-lifecycle-root")
        home :: Scratch.new("authority-lifecycle-home")
        write_project(&proj.path, "database: {{ run: [\"sleep\", \"30\"] }}, api: {{ run: [\"sleep\", \"30\"], after: [\"database\"] }}", "fn run() {{}}\n")
        vars :: [("JETPACK_ROOT", root.path.display().to_string()), ("HOME", home.path.display().to_string())]
        up :: jetpack().args(["services", "up", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("up")
        assert(up.status.success(), "{String.from_utf8_lossy(up.stderr)}")
        lifecycle :: fs.read_to_string(proj.path.join(".jet/services/api/lifecycle")).expect("read lifecycle")
        assert(lifecycle.contains("backend=linux-systemd-user"), "{lifecycle}")
        assert(lifecycle.contains("containment=delegated-cgroup"), "{lifecycle}")
        assert(lifecycle.contains("phase=ready"), "{lifecycle}")
        assert(lifecycle.contains("dependency=database"), "{lifecycle}")
        health :: jetpack().args(["services", "health", "--json", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("health")
        assert(health.status.success(), "{String.from_utf8_lossy(health.stderr)}")
        json :: String.from_utf8_lossy(health.stdout)
        assert(json.contains("linux-systemd-user"), "{json}")
        assert(json.contains("\"after\":[\"database\"]"), "{json}")
        down :: jetpack().args(["services", "down", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("down")
        assert(down.status.success(), "{String.from_utf8_lossy(down.stderr)}")
        stopped :: fs.read_to_string(proj.path.join(".jet/services/api/lifecycle")).expect("read stopped lifecycle")
        assert(stopped.contains("phase=stopped"), "{stopped}")
    }
}

// Rust: tests/jetpack_services.rs:1303
// Fake systemd checks production flags and process-group cleanup, not a real cgroup runtime.
#Test("production_path_kills_descendants_in_the_supervisor_process_group") {
    if target.selected_os() == "linux" {
        proj :: Scratch.new("authority-descendants")
        root :: Scratch.new("authority-descendants-root")
        home :: Scratch.new("authority-descendants-home")
        write_project(&proj.path, "fixture: {{ run: [\"sh\", \"-c\", \"sleep 30 & child=$!; echo $child > child.pid; wait\"] }}", "fn run() {{}}\n")
        vars :: [("JETPACK_ROOT", root.path.display().to_string()), ("HOME", home.path.display().to_string())]
        up :: jetpack().args(["services", "up", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("up")
        assert(up.status.success(), "{String.from_utf8_lossy(up.stderr)}")
        child_file :: proj.path.join(".jet/services/fixture/data/child.pid")
        wait_for_file_lines(&child_file, 1)
        child_text :: fs.read_to_string(child_file).expect("read child pid")
        child_trimmed := child_text.trim() // #4303
        child_pid :: child_trimmed.parse[U32]().expect("parse child pid")
        pid_text :: fs.read_to_string(proj.path.join(".jet/services/fixture/pid")).expect("read service pid")
        service_pid :: pid_text.lines().find_map((line) -> line.strip_prefix("pid=").and_then((value) -> value.parse[U32]().ok())).expect("parse service pid")
        assert_ne(child_pid, service_pid, "fixture must have a real descendant")
        assert(process_is_alive(child_pid), "descendant must be alive before down")
        down :: jetpack().args(["services", "down", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("down")
        assert(down.status.success(), "{String.from_utf8_lossy(down.stderr)}")
        deadline :: Instant.now() + Duration.from_secs(3)
        while process_is_alive(child_pid) {
            assert(Instant.now() < deadline, "descendant survived systemd scope shutdown")
            thread.sleep(Duration.from_millis(25))
        }
    }
}

// Rust: tests/jetpack_services.rs:1373
#Test("production_supervisor_stops_descendants_after_leader_exit") {
    if target.selected_os() == "linux" {
        proj :: Scratch.new("authority-leader-exit")
        root :: Scratch.new("authority-leader-exit-root")
        home :: Scratch.new("authority-leader-exit-home")
        write_project(&proj.path, "fixture: {{ run: [\"sh\", \"-c\", \"sleep 30 & child=$!; echo $child > child.pid; while [ ! -f exit.flag ]; do sleep 0.01; done; exit 0\"] }}", "fn run() {{}}\n")
        vars :: [("JETPACK_ROOT", root.path.display().to_string()), ("HOME", home.path.display().to_string())]
        up :: jetpack().args(["services", "up", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("up")
        stderr :: String.from_utf8_lossy(up.stderr)
        assert(up.status.success(), "{stderr}")
        service_dir :: proj.path.join(".jet/services/fixture")
        child_file :: service_dir.join("data/child.pid")
        wait_for_file_lines(&child_file, 1)
        child_text :: fs.read_to_string(child_file).expect("read child pid")
        child_trimmed := child_text.trim() // #4303
        child_pid :: child_trimmed.parse[U32]().expect("parse child pid")
        assert(process_is_alive(child_pid), "descendant must outlive the leader")
        fs.write(service_dir.join("data/exit.flag"), "exit\n".as_bytes()).expect("request leader exit")
        wait_for_file_contains(&service_dir.join("lifecycle"), "phase=failed")
        deadline :: Instant.now() + Duration.from_secs(3)
        while process_is_alive(child_pid) {
            assert(Instant.now() < deadline, "supervisor left a descendant alive after leader exit: child={child_pid}, lifecycle={fs.read_to_string(service_dir.join("lifecycle")) ?? ""}, pid_state={fs.read_to_string(service_dir.join("pid")) ?? ""}")
            thread.sleep(Duration.from_millis(25))
        }
        cleanup_deadline :: Instant.now() + Duration.from_secs(5)
        while service_dir.join("pid").exists() {
            assert(Instant.now() < cleanup_deadline, "supervisor retained PID after cleanup: lifecycle={fs.read_to_string(service_dir.join("lifecycle")) ?? ""}")
            thread.sleep(Duration.from_millis(50))
        }
    }
}

// Rust: tests/jetpack_services.rs:1434
#Test("production_path_rejects_retired_depends_on_field") {
    if target.selected_os() == "linux" {
        proj :: Scratch.new("depends-on-rejected")
        root :: Scratch.new("depends-on-rejected-root")
        home :: Scratch.new("depends-on-rejected-home")
        write_project(&proj.path, "database: {{ run: [\"sleep\", \"30\"] }}, api: {{ run: [\"sleep\", \"30\"], depends_on: [\"database\"] }}", "fn run() {{}}\n")
        out :: jetpack().args(["services", "up", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output().expect("up")
        assert_eq(out.status.code(), Some(2))
        stderr :: String.from_utf8_lossy(out.stderr)
        assert(stderr.contains("E1262"), "{stderr}")
        assert(!proj.path.join(".jet/services/api/pid").exists())
    }
}

// Rust: tests/jetpack_services.rs:1458
#Test("production_path_bounds_readiness_probe_runtime") {
    if target.selected_os() == "linux" {
        proj :: Scratch.new("bounded-readiness-production")
        root :: Scratch.new("bounded-readiness-production-root")
        home :: Scratch.new("bounded-readiness-production-home")
        write_project(&proj.path, "fixture: {{ run: [\"sleep\", \"30\"], ready: \"sleep 30\" }}", "fn run() {{}}\n")
        started :: Instant.now()
        out :: jetpack().args(["services", "up", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).env("JETPACK_SERVICE_HEALTH_TIMEOUT_MS", "200").output().expect("up")
        assert_eq(out.status.code(), Some(2))
        assert(started.elapsed() < Duration.from_secs(3), "readiness probe was not bounded: {started.elapsed()}")
        assert(String.from_utf8_lossy(out.stderr).contains("E1261"))
        assert(!proj.path.join(".jet/services/fixture/pid").exists())
    }
}

// Rust: tests/jetpack_services.rs:1488
#Test("production_path_stops_dependents_after_dependency_failure") {
    if target.selected_os() == "linux" {
        proj :: Scratch.new("dependency-failure")
        root :: Scratch.new("dependency-failure-root")
        home :: Scratch.new("dependency-failure-home")
        write_project(&proj.path, "database: {{ run: [\"sh\", \"-c\", \"sleep 1\"] }}, api: {{ run: [\"sleep\", \"30\"], after: [\"database\"] }}", "fn run() {{}}\n")
        vars :: [("JETPACK_ROOT", root.path.display().to_string()), ("HOME", home.path.display().to_string()), ("JETPACK_SERVICE_HEALTH_TIMEOUT_MS", "1500")]
        up :: jetpack().args(["services", "up", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("up")
        assert(up.status.success(), "{String.from_utf8_lossy(up.stderr)}")
        api_pid :: proj.path.join(".jet/services/api/pid")
        assert(api_pid.is_file())
        wait_for_missing(&api_pid)
        error :: proj.path.join(".jet/services/api/supervisor.error")
        wait_for_file_contains(&error, "dependency `database` failed")
        lifecycle :: fs.read_to_string(proj.path.join(".jet/services/api/lifecycle")).expect("read lifecycle")
        assert(lifecycle.contains("recovery=dependency-failed"), "{lifecycle}")
        down :: jetpack().args(["services", "down", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("down")
        assert(down.status.success(), "{String.from_utf8_lossy(down.stderr)}")
    }
}
