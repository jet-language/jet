    root :: Scratch.new("e1261-root")
    home :: Scratch.new("e1261-home")
    write_project(&proj.path, "fixture: {{ run: [\"sleep\", \"30\"], ready: \"false\" }}", "fn dev() {{ print(\"DEV-RAN\") }}\n")
    out :: jetpack().args(["dev", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).env("JETPACK_SERVICE_HEALTH_TIMEOUT_MS", "500").output().expect("dev")
