// Rust: tests/jetpack_services.rs:493
#Test("services_watch_restarts_after_nested_file_change") {
    proj :: Scratch.new("watch-nested")
    root :: Scratch.new("watch-nested-root")
    home :: Scratch.new("watch-nested-home")
    fs.create_dir_all(proj.path.join("src/nested")).expect("create watch directory")
    fs.write(proj.path.join("src/nested/input"), "one\n").expect("write input")
    write_project(&proj.path, "fixture: {{ run: [\"sh\", \"-c\", \"echo started >> restart-count; sleep 30\"], watch: [\"src\"] }}", "fn run() {{}}\n")
    vars :: [("JETPACK_ROOT", root.path.display().to_string()), ("HOME", home.path.display().to_string())]
    up :: jetpack().args(["services", "up", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("up")
    assert(up.status.success(), "{String.from_utf8_lossy(up.stderr)}")
    count :: proj.path.join(".jet/services/fixture/data/restart-count")
    wait_for_file_lines(&count, 1)
    fs.write(proj.path.join("src/nested/input"), "two with a changed length\n").expect("change input")
    wait_for_file_lines(&count, 2)
    health :: jetpack().args(["services", "health", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("health")
    assert(health.status.success(), "{String.from_utf8_lossy(health.stderr)}")
    down :: jetpack().args(["services", "down", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("down")
    assert(down.status.success(), "{String.from_utf8_lossy(down.stderr)}")
}

// Rust: tests/jetpack_services.rs:556
#Test("services_restart_exhaustion_cleans_state") {
    proj :: Scratch.new("restart-exhaustion")
    root :: Scratch.new("restart-exhaustion-root")
    home :: Scratch.new("restart-exhaustion-home")
    write_project(&proj.path, "fixture: {{ run: [\"sh\", \"-c\", \"exit 7\"], restart: .OnFailure{{ max: 1, backoff_ms: 1 }} }}", "fn run() {{}}\n")
    vars :: [("JETPACK_ROOT", root.path.display().to_string()), ("HOME", home.path.display().to_string()), ("JETPACK_SERVICE_HEALTH_TIMEOUT_MS", "500")]
    up :: jetpack().args(["services", "up", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("up")
    assert(!up.status.success(), "{String.from_utf8_lossy(up.stderr)}")
    assert(String.from_utf8_lossy(up.stderr).contains("E1261"), "stderr: {String.from_utf8_lossy(up.stderr)}")
    pid :: proj.path.join(".jet/services/fixture/pid")
    wait_for_missing(&pid)
    assert(proj.path.join(".jet/services/fixture/supervisor.error").is_file(), "restart exhaustion must leave a supervisor error")
    health :: jetpack().args(["services", "health", "--no-color"]).current_dir(proj.path).envs(vars).output().expect("health")
    assert(!health.status.success())
    _ :: jetpack().args(["services", "down", "--no-color"]).current_dir(proj.path).envs(vars).output().ok()
    assert(!proj.path.join(".jet/services/fixture/.stopping").exists())
}

// Rust: tests/jetpack_services.rs:992
#Ignore("subprocess worker invoked explicitly by production catalog tests")
#Test("production_catalog_service_worker") {
    if target.selected_os() == "linux" {
        project :: OSPath.from(env.var_os("JETPACK_CATALOG_PROJECT").expect("catalog project"))
        tools :: OSPath.from(env.var_os("JETPACK_CATALOG_TOOLS").expect("catalog tools"))
        systemd_bin :: OSPath.from(env.var_os("JETPACK_CATALOG_SYSTEMD_BIN").expect("catalog systemd bin"))
        name :: env.var("JETPACK_CATALOG_NAME").expect("catalog name")
        port :: env.var("JETPACK_CATALOG_PORT").ok().and_then((value) -> value.parse[I64]().ok()) ?? 0
        plan :: DevServicePlan { name, enable: true, ports: [port], ..DevServicePlan.default() }
        shell_env :: catalog_tool_env(&tools, Some(systemd_bin))
        Services.up_one(&project, &shell_env, &plan).expect("up catalog service")
    }
}

// Rust: tests/jetpack_services.rs:1013
#Test("production_catalog_services_prepare_state_and_pass_readiness") {
    if target.selected_os() == "linux" {
        proj :: Scratch.new("catalog-production")
        tools :: Scratch.new("catalog-production-tools")
        install_catalog_tools(&tools.path)
        fake :: fake_systemd()
        current_path :: env.var_os("PATH") ?? OSString.new()
        path :: "{fake.bin.display()}:{current_path.to_string_lossy()}"
        shell_env :: catalog_tool_env(&tools.path, None)
        for name in ["redis", "postgres", "mysql", "mariadb", "nginx", "minio", "mailpit", "mail", "mailhog", "blackfire", "tideways"] {
            plan :: DevServicePlan { name: name.to_string(), enable: true, ports: [0], ..DevServicePlan.default() }
            supervisor := Command.new(env.current_exe().expect("test executable"))
                .args(["--exact", "production_catalog_service_worker", "--ignored", "--nocapture"])
                .env("JETPACK_CATALOG_PROJECT", proj.path).env("JETPACK_CATALOG_TOOLS", tools.path)
                .env("JETPACK_CATALOG_SYSTEMD_BIN", fake.bin).env("JETPACK_CATALOG_NAME", name)
                .env("JETPACK_SERVICE_SUPERVISOR", "1").env("PATH", path)
                .stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("spawn catalog worker")
            state_name :: if name == "mail" -> "mailpit" else -> name
            service_dir :: proj.path.join(".jet/services").join(state_name)
            wait_for_file_contains(&service_dir.join("pid"), "pid=")
            assert(Services.wait_healthy_with_env(&proj.path, Some(&shell_env), &plan, Duration.from_secs(3)), "catalog service `{name}` did not pass its production readiness command")
            data_dir :: service_dir.join("data")
            match name {
                "redis" -> assert(data_dir.join(".service-running").is_file())
                "postgres" -> assert(data_dir.join("PG_VERSION").is_file())
                "mysql" | "mariadb" -> assert(data_dir.join("mysql").is_dir())
                "minio" | "mailpit" | "mail" -> { assert(data_dir.join(".service-running").is_file()) }
                "mailhog" | "blackfire" | "tideways" -> { assert(data_dir.join(".service-running").is_file()) }
                "nginx" -> {
                    ports :: fs.read_to_string(service_dir.join("ports")).expect("read ports")
                    port :: ports.lines().next().expect("port line").parse[U16]().expect("parse port")
                    config :: data_dir.join("nginx-{port}/conf/nginx.conf")
                    config_text :: fs.read_to_string(config).expect("read nginx config")
                    assert(config_text.contains("listen 127.0.0.1:{port};"))
                }
                _ -> panic("unreachable catalog service")
            }
            fs.write(service_dir.join(".stopping"), "test\n".as_bytes()).expect("request catalog stop")
            output :: supervisor.wait_with_output().expect("wait catalog worker")
            assert(output.status.success(), "catalog worker failed: stdout={String.from_utf8_lossy(output.stdout)} stderr={String.from_utf8_lossy(output.stderr)}")
            wait_for_missing(&service_dir.join("pid"))
        }
    }
}

// Rust: tests/jetpack_services.rs:1112
#Test("production_adminer_preset_fails_closed_without_php_projection") {
    if target.selected_os() == "linux" {
        proj :: Scratch.new("adminer-owner-gate")
        tools :: Scratch.new("adminer-owner-gate-tools")
