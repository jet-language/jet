// Rust: tests/jetpack_services.rs:1144
#Test("production_minio_preset_port_conflict_has_terminal_state") {
    if target.selected_os() == "linux" {
        proj :: Scratch.new("minio-port-conflict")
        tools :: Scratch.new("minio-port-conflict-tools")
        install_catalog_tools(&tools.path)
        blocker :: TcpListener.bind(("127.0.0.1", 0)).expect("bind conflicting port")
        port :: blocker.local_addr().expect("blocker address").port()
        fake :: fake_systemd()
        current_path :: env.var_os("PATH") ?? OSString.new()
        path :: "{fake.bin.display()}:{current_path.to_string_lossy()}"
        worker := Command.new(env.current_exe().expect("test executable"))
            .args(["--exact", "production_catalog_service_worker", "--ignored", "--nocapture"])
            .env("JETPACK_CATALOG_PROJECT", proj.path).env("JETPACK_CATALOG_TOOLS", tools.path)
            .env("JETPACK_CATALOG_SYSTEMD_BIN", fake.bin).env("JETPACK_CATALOG_NAME", "minio")
            .env("JETPACK_CATALOG_PORT", port.to_string()).env("JETPACK_SERVICE_SUPERVISOR", "1").env("PATH", path)
            .stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().expect("spawn minio worker")
        service_dir :: proj.path.join(".jet/services/minio")
        output :: worker.wait_with_output().expect("wait minio worker")
        assert(!output.status.success(), "port conflict must reach the worker")
        assert(!service_dir.join("pid").exists())
        assert(!service_dir.join("ports").exists())
        assert(service_dir.join("supervisor.error").is_file())
        lifecycle :: fs.read_to_string(service_dir.join("lifecycle")).expect("read lifecycle")
        assert(lifecycle.contains("phase=failed"), "{lifecycle}")
        assert(lifecycle.contains("recovery=startup-failed"), "{lifecycle}")
    }
}

