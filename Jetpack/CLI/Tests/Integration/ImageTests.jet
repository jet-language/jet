// Rust: tests/image.rs:965
#Test("environment_image_rejects_symlinked_extra_file") {
    // GATE #4483: original test is Unix-only; #4494 real symlink primitive.
    if sys.target.selected_family() == "unix" {
        project :: Scratch.new("environment-image-symlink-file")
        root :: Scratch.new("environment-image-symlink-root")
        outside :: Scratch.new("environment-image-symlink-outside")
        fs.write(project.path.join("env.jet"), "module env.dev { packages: [\"bash@nixpkgs\"] }\nmodule image.server { from: env.dev, files: [\"payload.bin\"] }\n") ?? panic("env")
        fs.write(outside.path.join("payload.bin"), "must not be read\n".as_bytes()) ?? panic("outside")
        fs.symlink(outside.path.join("payload.bin"), project.path.join("payload.bin")) ?? panic("symlink")
        ingest_executable(&root.path, "bash", "bash@nixpkgs", "bash")
        out :: jetpack().args(["image", "server"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).env("NO_COLOR", "1").output() ?? panic("image")
        stderr :: String.from_utf8_lossy(&out.stderr)
        assert_eq(out.status.code(), Val(2), "symlinked image file must fail: {stderr}")
        assert(stderr.contains("not a symlink") || stderr.contains("symlink"), "stderr: {stderr}")
        assert_eq(fs.read_to_string(outside.path.join("payload.bin")) ?? panic("outside read"), "must not be read\n")
    }
}

