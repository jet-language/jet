use std.[fs, TcpListener, thread]

// Rust: tests/image.rs:219
#Test("committed_oci_image_example_field_checks_clean") {
    path :: OSPath.from(env("CARGO_MANIFEST_DIR")).join("tests/fixtures/jetpack-typed/image.jet")
    src :: fs.read_to_string(path) ?? panic("fixture")
    plan :: evaluate_env(&src, path.parent().unwrap()) ?? panic("evaluate")
    assert_eq(plan.images.len(), 1)
    image :: &plan.images[0]
    assert_eq(image.name, "server")
    assert_eq(image.from, "server")
    assert_eq(image.expose, [8080, 8443])
    assert_eq(image.env_vars, [("RUST_LOG", "info")])
    assert_eq(image.files, ["config/app.toml"])
}

// Rust: tests/image.rs:238
#Test("committed_environment_image_example_field_checks_clean") {
    path :: OSPath.from(env("CARGO_MANIFEST_DIR")).join("tests/fixtures/jetpack-typed/environment_image.jet")
    src :: fs.read_to_string(path) ?? panic("fixture")
    plan :: evaluate_env(&src, path.parent().unwrap()) ?? panic("evaluate")
    assert_eq(plan.images.len(), 1)
    image :: &plan.images[0]
    assert(image.from_environment)
    assert_eq(image.from, "dev")
    assert_eq(image.target.as_deref(), Val("linux.arm64"))
    assert_eq(image.user, Val(10001))
    assert_eq(image.entrypoint.as_deref(), Val("/bin/sh"))
    assert_eq(image.health.as_deref(), Val("test -x /bin/sh"))
    assert_eq(image.expose, [8080])
    assert_eq(image.files, ["config/app.toml"])
}

// Rust: tests/image.rs:259
#Test("oci_from_library_source_is_rejected") {
    scratch :: Scratch.new("library-rejected")
    write_project(&scratch.path, "library", false)
    src :: fs.read_to_string(scratch.path.join("env.jet")) ?? panic("env")
    err :: evaluate_env(&src, &scratch.path).unwrap_err()
    assert_eq(err.code, "E1267")
    rendered :: Diagnostics.render_all("env.jet", &src, [&err])
    assert(rendered.contains("non-executable package `app`"), rendered)
    assert(rendered.contains("declared `library`"), rendered)
}

