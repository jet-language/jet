// Rust: tests/image.rs:818
#Test("environment_image_omits_cloud_and_vault_facts_without_secret_names") {
    project :: Scratch.new("environment-secret-integrations")
    root :: Scratch.new("environment-secret-integrations-root")
    fs.write(project.path.join("env.jet"), "module env.dev {\n    packages: [\"bash@nixpkgs\"]\n    imports: [\n        env.cloud.credentials([aws_production]),\n        env.security.vault([database_password])\n    ]\n}\nmodule image.server { from: env.dev }\n") ?? panic("env")
    ingest_executable(&root.path, "bash", "bash@nixpkgs", "bash")
    out :: jetpack().args(["image", "server"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).env("NO_COLOR", "1").output() ?? panic("image")
    assert_eq(out.status.code(), Val(0), "image should project the environment successfully: {String.from_utf8_lossy(&out.stderr)}")
    report :: fs.read_to_string(project.path.join(".jet/images/server/projection.json")) ?? panic("report")
    assert(report.contains("integration:cloud-credentials:activation"))
    assert(report.contains("integration:cloud-credentials:task:credential-store-check"))
    assert(report.contains("integration:cloud-credentials:provider:credential-store"))
    assert(report.contains("integration:cloud-credentials:grant:credential.read"))
    assert(report.contains("integration:vault:activation"))
    assert(report.contains("integration:vault:task:vault-check"))
    assert(report.contains("integration:vault:provider:vault"))
    assert(report.contains("integration:vault:grant:vault.read"))
    assert(report.contains("integration:cloud-credentials:secret-refs=1"))
    assert(report.contains("integration:vault:secret-refs=1"))
    assert(!report.contains("aws_production"), "secret name leaked: {report}")
    assert(!report.contains("database_password"), "secret name leaked: {report}")
    image :: project.path.join(".jet/images/server")
    for blob in fs.read_dir(image.join("blobs/sha256")) ?? panic("blobs") {
        bytes :: fs.read((blob ?? panic("entry")).path()) ?? panic("blob")
        assert(!bytes.windows("aws_production".len()).any(window -> window == "aws_production".as_bytes()))
        assert(!bytes.windows("database_password".len()).any(window -> window == "database_password".as_bytes()))
    }
}

// Rust: tests/image.rs:882
#Test("environment_image_rejects_secret_extra_file") {
    project :: Scratch.new("environment-secret-file")
    root :: Scratch.new("environment-secret-file-root")
    fs.write(project.path.join("env.jet"), "module env.dev {\n    packages: [\"bash@nixpkgs\"]\n    dotenv: [Dotenv{ file: \".env\", allow: [\"TOKEN\"], secrets: [\"TOKEN\"] }]\n}\nmodule image.server { from: env.dev, files: [\".env\"] }\n") ?? panic("env")
    fs.write(project.path.join(".env"), "TOKEN=super-secret-value\n".as_bytes()) ?? panic("dotenv")
    ingest_executable(&root.path, "bash", "bash@nixpkgs", "bash")
    out :: jetpack().args(["image", "server"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).env("NO_COLOR", "1").output() ?? panic("image")
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert_eq(out.status.code(), Val(2), stderr)
    assert(stderr.contains("E1336"), "stderr: {stderr}")
    assert(!stderr.contains("super-secret-value"), "secret leaked: {stderr}")
    report :: fs.read_to_string(project.path.join(".jet/images/server/projection.json")) ?? panic("report")
    assert(report.contains("file:.env"), "projection: {report}")
    assert(!report.contains("super-secret-value"), "secret leaked: {report}")
    blobs :: fs.read_dir(project.path.join(".jet/images/server/blobs/sha256"))
    if blobs.is_ok() {
        for blob in blobs.unwrap() {
            bytes :: fs.read((blob ?? panic("entry")).path()) ?? panic("blob")
            assert(!bytes.windows("super-secret-value".len()).any(window -> window == "super-secret-value".as_bytes()))
        }
    }
}

