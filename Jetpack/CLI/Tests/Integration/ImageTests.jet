// Rust: tests/image.rs:309
#Test("image_builds_real_oci_layout") {
    scratch :: Scratch.new("build-ok")
    write_project(&scratch.path, "executable", true)
    out :: jetpack().args(["image", "server"]).current_dir(&scratch.path).env("NO_COLOR", "1").output() ?? panic("image")
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert_eq(out.status.code(), Val(0), "build should succeed: {stderr}")
    assert(stderr.contains("built image `server`"), stderr)
    out_dir :: scratch.path.join(".jet/images/server")
    assert(out_dir.join("oci-layout").is_file())
    assert(out_dir.join("index.json").is_file())
    index :: fs.read_to_string(out_dir.join("index.json")) ?? panic("index")
    assert(index.contains("application/vnd.oci.image.manifest.v1+json"))
}

// Rust: tests/image.rs:334
#Test("image_build_is_reproducible_end_to_end") {
    scratch :: Scratch.new("reproducible")
    write_project(&scratch.path, "executable", true)
    digest_of :: || -> {
        out :: jetpack().args(["image", "server"]).current_dir(&scratch.path).env("NO_COLOR", "1").output() ?? panic("image")
        assert_eq(out.status.code(), Val(0))
        fs.read_to_string(scratch.path.join(".jet/images/server/index.json")) ?? panic("index")
    }
    a :: digest_of()
    fs.remove_dir_all(scratch.path.join(".jet/images")) ?? panic("remove images")
    b :: digest_of()
    assert_eq(a, b, "same project must build byte-identical index.json")
}

// Rust: tests/image.rs:356
#Test("image_push_copies_a_real_layout_and_refuses_conflicts") {
    project :: Scratch.new("copy-layout-project")
    destination_root :: Scratch.new("copy-layout-destination")
    write_project(&project.path, "executable", true)
    destination :: destination_root.path.join("published")
    destination_ref :: "file://{destination.display()}"
    out :: jetpack().args(["image", "server", "--push"]).arg(&destination_ref).current_dir(&project.path).env("NO_COLOR", "1").output() ?? panic("push")
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert_eq(out.status.code(), Val(0), "copy should succeed: {stderr}")
    source :: project.path.join(".jet/images/server")
    assert_eq(fs.read(source.join("index.json")) ?? panic("source index"), fs.read(destination.join("index.json")) ?? panic("destination index"))
    assert_eq(fs.read(source.join("oci-layout")) ?? panic("source layout"), fs.read(destination.join("oci-layout")) ?? panic("destination layout"))
    source_blobs := (fs.read_dir(source.join("blobs/sha256")) ?? panic("source blobs")).map(entry -> (entry ?? panic("entry")).file_name()).collect()
    destination_blobs := (fs.read_dir(destination.join("blobs/sha256")) ?? panic("destination blobs")).map(entry -> (entry ?? panic("entry")).file_name()).collect()
    source_blobs.sort()
    destination_blobs.sort()
    assert_eq(source_blobs, destination_blobs)
    fs.write(destination.join("index.json"), "conflicting layout".as_bytes()) ?? panic("conflict")
    rejected :: jetpack().args(["image", "server", "--push"]).arg(&destination_ref).current_dir(&project.path).env("NO_COLOR", "1").output() ?? panic("push conflict")
    rejected_stderr :: String.from_utf8_lossy(&rejected.stderr)
    assert_eq(rejected.status.code(), Val(2), "conflicts must fail: {rejected_stderr}")
    assert(rejected_stderr.contains("byte-identical"), rejected_stderr)
    assert_eq(fs.read(destination.join("index.json")) ?? panic("conflict index"), "conflicting layout".as_bytes())
}

// Rust: tests/image.rs:411
#Test("image_push_uses_the_real_oci_distribution_path") {
    project :: Scratch.new("registry-project")
    write_project(&project.path, "executable", true)
    listener :: TcpListener.bind("127.0.0.1:0") ?? panic("bind")
    port :: (listener.local_addr() ?? panic("local address")).port()
    server :: thread.spawn(|| -> registry_test_server(^listener, 7))
    reference :: "http://127.0.0.1:{port}/demo/server:1"
    out :: jetpack().args(["image", "server", "--push"]).arg(&reference).current_dir(&project.path).env("NO_COLOR", "1").output() ?? panic("push")
    stderr :: String.from_utf8_lossy(&out.stderr)
    requests :: server.join() ?? panic("join server")
    assert_eq(out.status.code(), Val(0), "registry push should succeed: {stderr}")
    assert_eq(requests.len(), 7, "requests: {requests:?}")
    assert_eq(requests.iter().filter(request -> request.0 == "HEAD").count(), 2)
    assert_eq(requests.iter().filter(request -> request.0 == "POST").count(), 2)
    assert_eq(requests.iter().filter(request -> request.0 == "PUT" && request.1.starts_with("/test-upload")).count(), 2)
    manifest :: requests.iter().find(request -> request.0 == "PUT" && request.1.contains("/manifests/1")) ?? panic("manifest PUT")
    assert(manifest.2.windows("schemaVersion".len()).any(window -> window == "schemaVersion".as_bytes()))
    assert(stderr.contains("published"), stderr)
}

// Rust: tests/image.rs:467
#Test("image_registry_missing_tool_fails_before_claiming_publish") {
    project :: Scratch.new("registry-missing-tool")
