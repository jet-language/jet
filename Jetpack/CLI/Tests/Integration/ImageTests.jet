    out :: jetpack().args(["image", "server"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).env("NO_COLOR", "1").output() ?? panic("image")
    assert_eq(out.status.code(), Val(0), String.from_utf8_lossy(&out.stderr))
    report :: fs.read_to_string(project.path.join(".jet/images/server/projection.json")) ?? panic("report")
