// Rust: tests/image.rs:1117
#Test("environment_image_requires_explicit_service_selection") {
    project :: Scratch.new("environment-service")
    fs.write(project.path.join("env.jet"), "module env.dev { services: { api: { run: [\"true\"] } } }\nmodule image.server { from: env.dev }\n") ?? panic("env")
    out :: jetpack().args(["image", "server"]).current_dir(&project.path).env("NO_COLOR", "1").output() ?? panic("image")
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert_eq(out.status.code(), Val(2), "service projection must fail: {stderr}")
    block :: stderr.split("\n\n").find(block -> block.contains("Error [E1336]")) ?? panic("E1336 diagnostic block")
    diagnostic :: block.lines().filter(line -> !line.is_empty()).map(line -> { trimmed := line.trim() // #4303
        trimmed.to_string()
    }).collect().join("\n")
    expected := include_str("tests/cli/image_service_projection_e1336.txt").trim() // #4303
    assert_eq(diagnostic, expected)
    report :: fs.read_to_string(project.path.join(".jet/images/server/projection.json")) ?? panic("rejected image projection report")
    assert(report.contains("\"rejected\":[\"services\"]"), "projection: {report}")
}

// Rust: tests/image.rs:1161
#Test("environment_image_projects_supervised_services") {
    project :: Scratch.new("environment-service-image")
    fs.write(project.path.join("env.jet"), "module env.dev {\n    packages: [\"bash@nixpkgs\", \"db@nixpkgs\", \"sleep@nixpkgs\", \"worker@nixpkgs\"]\n    services: { db: { enable: true, run: [\"db\"] }, api: { enable: true, ports: [8080], after: [\"db\"], run: [\"worker\", \"--port\", \"8080\"] } }\n}\nmodule image.server { from: env.dev, services: [\"api\"] }\n") ?? panic("env")
    ingest_executable(&project.path, "bash", "bash@nixpkgs", "bash")
    ingest_executable(&project.path, "db", "db@nixpkgs", "db")
    ingest_executable(&project.path, "sleep", "sleep@nixpkgs", "sleep")
    ingest_executable(&project.path, "worker", "worker@nixpkgs", "worker")
    out :: jetpack().args(["image", "server"]).current_dir(&project.path).env("JETPACK_ROOT", &project.path).env("NO_COLOR", "1").output() ?? panic("image")
    assert_eq(out.status.code(), Val(0), "supervised image must build: {String.from_utf8_lossy(&out.stderr)}")
    layer :: image_layer(&project.path.join(".jet/images/server"))
    assert(layer.windows("jet/supervise".len()).any(window -> window == "jet/supervise".as_bytes()), "supervisor path is not in the OCI layer")
    worker_cmd :: "start '/usr/local/bin/worker' '--port' '8080'".as_bytes()
    assert(layer.windows(worker_cmd.len()).any(window -> window == worker_cmd), "service command is not in the generated supervisor")
    db_cmd :: "start '/usr/local/bin/db'".as_bytes()
    db_start :: layer.windows(db_cmd.len()).position(window -> window == db_cmd) ?? panic("dependency command")
    worker_prefix :: "start '/usr/local/bin/worker'".as_bytes()
    worker_start :: layer.windows(worker_prefix.len()).position(window -> window == worker_prefix) ?? panic("dependent command")
    assert(db_start < worker_start, "dependency must start first")
    report :: fs.read_to_string(project.path.join(".jet/images/server/projection.json")) ?? panic("report")
    assert(report.contains("services:jet/supervise"), "projection: {report}")
    assert(report.contains("service:api"), "projection: {report}")
    plan :: fs.read_to_string(project.path.join(".jet/images/server/plan.json")) ?? panic("plan")
    assert(plan.contains("\"entrypoint\":[\"/jet/supervise\"]"), "plan: {plan}")
    assert(plan.contains("\"services\":[\"api\",\"db\"]"), "plan: {plan}")
}

