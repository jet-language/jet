}

// Rust: tests/image.rs:496
#Test("environment_image_uses_realized_package_output") {
    project :: Scratch.new("environment-store")
    root :: Scratch.new("environment-store-root")
    fs.write(project.path.join("env.jet"), "module env.dev { packages: [\"bash@nixpkgs\"] }\nmodule image.server { from: env.dev }\n") ?? panic("env")
    ingest_executable(&root.path, "bash", "bash@nixpkgs", "bash")
    out :: jetpack().args(["image", "server"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).env("NO_COLOR", "1").output() ?? panic("image")
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert_eq(out.status.code(), Val(0), "image should use Hangar output: {stderr}")
    report :: fs.read_to_string(project.path.join(".jet/images/server/projection.json")) ?? panic("report")
    assert(report.contains("package:bash@nixpkgs"), "projection: {report}")
    assert(!project.path.join(".jet/build").exists())
    image :: project.path.join(".jet/images/server")
    layer :: image_layer(&image)
    shell :: ("bin/sh" + TEXT_NUL).as_bytes()
    assert(layer.windows(shell.len()).any(window -> window == shell))
    assert(!image_blob_containing(&image, "\"User\":\"10001\"".as_bytes()).is_empty())
    plan :: fs.read_to_string(image.join("plan.json")) ?? panic("plan")
    assert(plan.contains("\"source\":\"env:dev\""), "plan: {plan}")
    assert(plan.contains("\"entrypoint\":[\"/bin/sh\"]"), "plan: {plan}")
    assert(plan.contains("\"platform\":\"linux.x64\""), "plan: {plan}")
    assert(plan.contains("\"user\":10001"), "plan: {plan}")
    assert(plan.contains("\"expose\":[]"), "plan: {plan}")
    assert(plan.contains("\"healthcheck\":false"), "plan: {plan}")
    assert(plan.contains("\"services\":[]"), "plan: {plan}")
    assert(plan.contains("\"content\":\"Hangar\""), "plan: {plan}")
    assert(plan.contains("\"cache\":\"Hangar\""), "plan: {plan}")
    assert(plan.contains("\"archive\":\"Hangar\""), "plan: {plan}")
    assert(plan.contains("\"signing\":\"Hangar\""), "plan: {plan}")
    assert(plan.contains("\"provenance\":\"Hangar+.jet/lock\""), "plan: {plan}")
    assert(plan.contains("\"inputs\":\".jet/lock\""), "plan: {plan}")
    assert(plan.contains("\"platforms\":\".jet/lock\""), "plan: {plan}")
    assert(plan.contains("\"publish\":\"Hangar\""), "plan: {plan}")
    assert(plan.contains("\"remote\":\"D-JPK-REMOTE1\""), "plan: {plan}")
    dossier :: fs.read_to_string(image.join("dossier.json")) ?? panic("dossier")
    assert(dossier.contains("runtime-mount-or-reference-only"), "dossier: {dossier}")
}

// Rust: tests/image.rs:567
#Test("environment_image_projects_explicit_extra_file_reproducibly") {
    project :: Scratch.new("environment-extra-file")
    root :: Scratch.new("environment-extra-file-root")
    fs.create_dir_all(project.path.join("config")) ?? panic("config dir")
    fs.write(project.path.join("env.jet"), "module env.dev { packages: [\"bash@nixpkgs\"] }\nmodule image.server { from: env.dev, files: [\"config/app.toml\"] }\n") ?? panic("env")
    fs.write(project.path.join("config/app.toml"), "port = 8080\n".as_bytes()) ?? panic("extra file")
    ingest_executable(&root.path, "bash", "bash@nixpkgs", "bash")
    build :: || -> {
        out :: jetpack().args(["image", "server"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).env("NO_COLOR", "1").output() ?? panic("image")
        assert_eq(out.status.code(), Val(0), String.from_utf8_lossy(&out.stderr))
        fs.read_to_string(project.path.join(".jet/images/server/index.json")) ?? panic("index")
    }
    first :: build()
    image :: project.path.join(".jet/images/server")
    report :: fs.read_to_string(image.join("projection.json")) ?? panic("report")
    assert(report.contains("file:config/app.toml"), "projection: {report}")
    plan :: fs.read_to_string(image.join("plan.json")) ?? panic("plan")
    assert(plan.contains("config/app.toml"), "plan: {plan}")
    assert(image_layer(&image).windows("port = 8080\n".len()).any(window -> window == "port = 8080\n".as_bytes()))
    fs.remove_dir_all(project.path.join(".jet/images")) ?? panic("remove images")
    second :: build()
    assert_eq(first, second, "extra-file projection must preserve image identity")
}

// Rust: tests/image.rs:618
#Test("environment_image_rejects_public_managed_extra_file") {
    project :: Scratch.new("environment-managed-file")
    root :: Scratch.new("environment-managed-file-root")
    fs.create_dir_all(project.path.join("config")) ?? panic("config dir")
    fs.write(project.path.join("env.jet"), "module env.dev {\n    packages: [\"bash@nixpkgs\"]\n    files: [\"config/generated.txt\": File{ content: \"managed\\n\", mode: .Copy }]\n}\nmodule image.server { from: env.dev, files: [\"config/generated.txt\"] }\n") ?? panic("env")
    fs.write(project.path.join("config/generated.txt"), "project\n".as_bytes()) ?? panic("generated file")
    ingest_executable(&root.path, "bash", "bash@nixpkgs", "bash")
    out :: jetpack().args(["image", "server"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).env("NO_COLOR", "1").output() ?? panic("image")
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert_eq(out.status.code(), Val(2), stderr)
    assert(stderr.contains("E1336"), "stderr: {stderr}")
    assert(stderr.contains("managed environment files"), "stderr: {stderr}")
    report :: fs.read_to_string(project.path.join(".jet/images/server/projection.json")) ?? panic("report")
    assert(report.contains("file:config/generated.txt"), "projection: {report}")
    assert(report.contains("\"rejected\""), "projection: {report}")
    assert(!project.path.join(".jet/images/server/blobs").exists())
}

