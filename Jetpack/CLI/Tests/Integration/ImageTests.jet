// Rust: tests/image.rs:691
#Test("environment_image_projects_named_environment_not_default") {
    project :: Scratch.new("environment-selection")
    root :: Scratch.new("environment-selection-root")
    fs.write(project.path.join("env.jet"), "module env.dev { packages: [\"bash@nixpkgs\"] }\nmodule env.full { packages: [\"sh@nixpkgs\"] }\nmodule image.server { from: env.full, target: linux.arm64 }\n") ?? panic("env")
    ingest_executable(&root.path, "bash", "bash@nixpkgs", "bash")
