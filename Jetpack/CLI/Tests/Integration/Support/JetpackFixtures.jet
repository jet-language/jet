// Rust: tests/support/jetpack_fixtures.rs:815
pub fn harness_json_field(text: String, key: String) -> String {
    needle := "\"{key}\":\""
    (_, rest) := text.split_once(needle).unwrap_or_else(() -> panic("harness JSON lacks `{key}`: {text}"))
    rest.split('"').next().unwrap().to_string()
}

