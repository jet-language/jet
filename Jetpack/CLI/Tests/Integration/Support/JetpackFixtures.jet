//RS /// Register a real, contract-valid hangar object via the production
//RS /// `ingest_tree` API.
//RS ///
//RS /// Card #420's producer-record refactor made `jetpack hangar clean`/`closure_graph`
//RS /// fail-closed: every hangar entry it walks must decode a valid
//RS /// `ProducerRecord` and pass `store_validates_complete_closure` (real content
//RS /// re-hashed against the recorded digest — see
//RS /// `crates/jetpack/src/Store/Closure.rs::{normalize_legacy_entry,
//RS /// store_validates_complete_closure}`). A hand-written `meta.json` with a
//RS /// fictitious `/nix/store/...` `out` and blank `CacheIdentity` can no longer
//RS /// satisfy that — it always fails with "legacy package lacks immutable
//RS /// producer facts" or "has no dependency references or store-validated
//RS /// closure proof". `ingest_tree` (provider `hangar-ingest`) is the only
//RS /// producer-record-issuing constructor reachable from outside the `jetpack`
//RS /// crate (the `store-record`/`core` provider path is `#[cfg(test)]`-gated
//RS /// inside `jetpack` itself), so fixtures now go through it to get a real
//RS /// digest over real bytes.
//RS ///
//RS /// The digest is no longer caller-chosen (it's the real hash of the fixture
//RS /// payload), so this returns `(hangar_dir, envelope_output_hash)` — callers
//RS /// that need to cross-reference the digest elsewhere (e.g. a lockfile's
//RS /// `output-hash`) read it back from the second element.
//RS ///
//RS /// `last_used_at`, when given, is backdated via the card #650 `test-seam`
//RS /// (`jetpack::Store::test_backdate_last_used_at`) — a plain `meta.json` text
//RS /// edit doesn't survive the next hangar operation (the closure journal is
//RS /// the real source of truth and gets re-materialized over it).
//RS pub fn write_hangar_meta(
//RS     root: &Path,
//RS     id: &str,
//RS     name: &str,
//RS     version: &str,
//RS     last_used_at: Option<u64>,
//RS ) -> (PathBuf, String) {
//RS     let roots = jetpack::Store::Roots {
