// Rust: tests/support/jetpack_fixtures.rs:78
// GATE #4494: native TCP stream; #4409: ConnectionReset error-kind fidelity.
pub fn studio_raw(addr: String, request: String) -> String {
    connect_addr := addr.split_once('?').map((pair) -> pair.0).unwrap_or(addr)
    stream := TcpStream.connect(connect_addr).unwrap()
    stream.write_all(request.as_bytes()).unwrap()
    _ :: stream.shutdown(Shutdown.Write)
    response := String.new()
    match stream.read_to_string(&response) {
        Err(e) -> assert_eq(e.kind(), ErrorKind.ConnectionReset, "studio HTTP read failed: {e}")
        Ok(_) -> {}
    }
    response
}

// Rust: tests/support/jetpack_fixtures.rs:100
// GATE #4494: native TCP stream; #4409: ConnectionReset error-kind fidelity.
pub fn studio_http(addr: String, method: String, path: String, body: String) -> String {
    (connect_addr, session) := addr.split_once('?').unwrap_or((addr, ""))
    target := if session.is_empty() { path.to_string() } else {
        separator := if path.contains('?') { '&' } else { '?' }
        "{path}{separator}{session}"
    }
    origin := "http://{connect_addr}"
    content_type := if method == "POST" { "Content-Type: application/json\r\n" } else { "" }
    origin_header := if method == "POST" { "Origin: {origin}\r\n" } else { String.new() }
    stream := TcpStream.connect(connect_addr).unwrap()
    stream.write_all("{method} {target} HTTP/1.1\r\nHost: {connect_addr}\r\n{origin_header}{content_type}Content-Length: {body.len()}\r\nConnection: close\r\n\r\n{body}".as_bytes()).unwrap()
    _ :: stream.shutdown(Shutdown.Write)
    response := String.new()
    match stream.read_to_string(&response) {
        Err(e) -> assert_eq(e.kind(), ErrorKind.ConnectionReset, "studio HTTP read failed: {e}")
        Ok(_) -> {}
    }
    response
}

