//RS     let src = root.join(format!("hangar-meta-src-{id}"));
//RS     fs::create_dir_all(&src).unwrap();
//RS     fs::write(src.join("payload"), format!("fixture payload: {id}")).unwrap();
//RS     let entry = jetpack::Store::ingest_tree(
//RS         &roots,
//RS         &jetpack::Store::IngestRequest {
//RS             name: name.to_string(),
//RS             version: version.to_string(),
//RS             reference: format!("fixture:{id}"),
//RS             cache_identity: jetpack::Store::CacheIdentity {
//RS                 source_fingerprint: format!("sha256-fixture-source-{id}"),
//RS                 recipe_fingerprint: format!("sha256-fixture-recipe-{id}"),
//RS                 policy_fingerprint: "policy=fixture".to_string(),
//RS                 platform: jetpack::Envelope::host_platform(),
