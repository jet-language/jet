// Rust: tests/support/jetpack_fixtures.rs:338
// GATE #4494: native permission modes; #4483: selected target family.
fn seed_hangar_object(root: OSPath, staging_dir: OSPath) -> OSPath {
    Store.seal_local_output(staging_dir).unwrap()
    digest := Envelope.try_output_hash_of(staging_dir.to_string_lossy()).unwrap()
    out_dir := root.join("hangar").join("objects").join(digest)
    fs.create_dir_all(out_dir.parent().unwrap()).unwrap()
    staging_permissions := fs.metadata(staging_dir).unwrap().permissions()
    if selected_family() == "unix" {
        staging_permissions.set_mode(staging_permissions.mode() | 0o200)
    } else {
        staging_permissions.set_readonly(false)
    }
    fs.set_permissions(staging_dir, staging_permissions).unwrap()
    fs.rename(staging_dir, out_dir).unwrap()
    Store.seal_local_output(out_dir).unwrap()
    assert_eq(Envelope.try_output_hash_of(out_dir.to_string_lossy()).unwrap(), digest,
        "published fixture must retain its content-addressed identity")
    out_dir
}

// Rust: tests/support/jetpack_fixtures.rs:364
pub fn write_runnable_fixture(fixtures: OSPath, root: OSPath, staging_dir: OSPath) -> OSPath {
    fs.create_dir_all(fixtures).unwrap()
    bin := staging_dir.join("bin")
    fs.create_dir_all(bin).unwrap()
    greet := bin.join("greet")
    fs.write(greet, "#!/bin/sh\necho hello from jetpack\n").unwrap()
    if selected_family() == "unix" { // GATE #4494, #4483
        fs.set_permissions(greet, fs.Permissions.from_mode(0o755)).unwrap()
    }
    out_dir := seed_hangar_object(root, staging_dir)
    json := "[{{\"drvPath\":\"/nix/store/0fixture00000000000000000000-greet.drv\",\"outputs\":{{\"out\":{out_dir.to_string_lossy():?}}}}}]"
    fs.write(fixtures.join("nixpkgs-greet.json"), json).unwrap()
    fs.write(fixtures.join("jetpack-greet.json"), json).unwrap()
    out_dir
}

// Rust: tests/support/jetpack_fixtures.rs:388
// GATE #4494: compile and execute real native platform fixture.
pub fn write_native_jetpack_fixture(fixtures: OSPath, root: OSPath, staging_dir: OSPath) -> OSPath {
    fs.create_dir_all(fixtures).unwrap()
    bin := staging_dir.join("bin")
    fs.create_dir_all(bin).unwrap()
    suffix := if selected_os() == "windows" { ".exe" } else { "" } // GATE #4483
    name := "jetpack{suffix}"
    executable := bin.join(name)
    source := staging_dir.parent().unwrap_or(staging_dir).join("native-jetpack-fixture.rs")
    // Rust fixture source text remains Rust; this is not a Jet entry point.
    fs.write(source, r#"fn main() {
    if std::env::args().nth(1).as_deref() == Some("--hold") {
        std::thread::sleep(std::time::Duration::from_secs(5));
    }
    if std::env::args().nth(1).as_deref() == Some("--help") {
        println!("jetpack platform fixture");
    }
}
"#).unwrap()
    rustc := env.var_os("RUSTC").unwrap_or_else(() -> OSPath.new("rustc"))
    output := Command.new(rustc).args(["--edition=2021", "-C", "debuginfo=0", "-C", "opt-level=0"])
        .arg(source).arg("-o").arg(executable).output()
        .unwrap_or_else((error) -> panic("could not compile native platform fixture: {error}"))
    assert(output.status.success(), "native platform fixture compilation failed: {String.from_utf8_lossy(output.stderr)}")
    artifact_name := "omp-native-jetpack-fixture{suffix}"
    artifact := fixtures.join(artifact_name)
    fs.copy(executable, artifact).unwrap()
    artifact_digest := SHA256.sha256_file_hex(artifact).unwrap()
    out_dir := seed_hangar_object(root, staging_dir)
    json := "[{{\"drvPath\":\"/nix/store/0fixture00000000000000000000-native-jetpack.drv\",\"outputs\":{{\"out\":{out_dir.to_string_lossy():?}}}}}]"
    fs.write(fixtures.join("nixpkgs-native-jetpack.json"), json).unwrap()
    fs.write(fixtures.join("jetpackage-omp.json"),
        "{{\"tag\":\"v1.0.0\",\"version\":\"1.0.0\",\"sha256\":\"{artifact_digest}\",\"artifact\":{artifact_name:?}}}").unwrap()
    out_dir
}

// Rust: tests/support/jetpack_fixtures.rs:444
pub fn assert_no_hangar_entry(root: OSPath, name: String) -> {
    hangar := root.join("hangar")
    if fs.read_dir(hangar) is Ok(entries) {
        assert(entries.flatten().all((entry) -> !entry.file_name().to_string_lossy().starts_with(name)))
    }
    journal := hangar.join("closure-db/journal")
    if fs.read_dir(journal) is Ok(entries) {
        assert_eq(entries.flatten().filter((entry) -> entry.path().extension().and_then((ext) -> ext.to_str()) == Some("txn")).count(),
            0, "failed registration left a closure journal transaction")
    }
    for empty in [hangar.join("objects"), root.join("leases")] {
        if fs.read_dir(empty) is Ok(entries) {
            assert(entries.next().is_none(), "failed registration left state in {empty.display()}")
        }
    }
    // Rust: tests/support/jetpack_fixtures.rs:473
    fn assert_no_root(path: OSPath) -> {
        entries := match fs.read_dir(path) { Ok(value) -> value, Err(_) -> return }
        for entry in entries.flatten() {
            assert_ne(entry.file_name(), "nix-gc-root", "failed registration left a Nix GC root")
            if entry.file_type().is_ok_and((kind) -> kind.is_dir()) { assert_no_root(entry.path()) }
        }
    }
    assert_no_root(hangar)
}

