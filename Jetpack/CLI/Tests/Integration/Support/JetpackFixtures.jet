// Rust: tests/support/jetpack_fixtures.rs:719
pub fn assert_jetos_stderr_snapshot(name: String, stderr: String) -> {
    path := OSPath.new(env.var("CARGO_MANIFEST_DIR").unwrap()).join("tests/fixtures/jetpack-diagnostics").join("{name}.stderr")
    expected := fs.read_to_string(path).unwrap_or_else((e) -> panic("missing jetos diagnostic snapshot {path.display()}: {e}"))
    assert_eq(stderr, expected, "jetos diagnostic snapshot `{name}` changed")
}

// Rust: tests/support/jetpack_fixtures.rs:731
pub fn assert_jetos_stderr_snapshot_trimmed(name: String, stderr: String) -> {
    path := OSPath.new(env.var("CARGO_MANIFEST_DIR").unwrap()).join("tests/fixtures/jetpack-diagnostics").join("{name}.stderr")
    expected := fs.read_to_string(path).unwrap_or_else((e) -> panic("missing jetos diagnostic snapshot {path.display()}: {e}"))
    actual_trimmed := stderr.trim_end() // #4303
    expected_trimmed := expected.trim_end() // #4303
    assert_eq(actual_trimmed, expected_trimmed, "jetos diagnostic snapshot `{name}` changed")
}

// Rust: tests/support/jetpack_fixtures.rs:744
pub fn assert_jetos_stderr_snapshot_normalized(name: String, stderr: String, replacements: [(String, String)]) -> {
    normalized := stderr.to_string()
    for (from, to) in replacements { normalized = normalized.replace(from, to) }
    assert_jetos_stderr_snapshot(name, normalized)
}

