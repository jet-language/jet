// Rust: tests/support/jetpack_fixtures.rs:790
pub fn write_live_import_fixture(src: OSPath, tools: OSPath, output: String?) -> {
    fs.write(src.join("flake.nix"), "{\n  outputs = { ... }: { nixosConfigurations.halcyon = { }; };\n}\n").unwrap()
    fs.write(src.join("flake.lock"), r#"{"nodes":{"nixpkgs":{"locked":{"owner":"NixOS","repo":"nixpkgs","rev":"fef9403a3e4d31b0a23f0bacebbec52c248fbb51"}}}}"#).unwrap()
    fs.create_dir_all(tools).unwrap()
    body := match output {
        Some(json) -> "#!/bin/sh\ncase \" $* \" in\n  *' eval '*) printf '%s\\n' '{json}'; exit 0 ;;\nesac\nexit 0\n"
        None -> "#!/bin/sh\necho 'error: attribute missing' >&2\nexit 1\n"
    }
    write_executable(tools.join("nix"), body)
}

