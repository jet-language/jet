// Rust: tests/support/jetpack_fixtures.rs:681
pub fn core_hello_project(tag: String) -> (Scratch, OSPath, OSPath) {
    base := Scratch.new(tag)
    repo := base.join("jet-pkgs")
    proj := base.join("proj")
    root := base.join("root")
    hello_pkg := repo.join("pkgs/hello")
    hello_bin := hello_pkg.join("bin")
    fs.create_dir_all(hello_bin).unwrap()
    fs.create_dir_all(proj).unwrap()
    fs.write(hello_pkg.join("hello.jet"), "module hello { }\n").unwrap()
    fs.write(repo.join("package.jet"), "name: \"fixture\"\nversion: \"0.1.0\"\npackages: { hello: executable }\n").unwrap()
    greet := hello_bin.join("hello")
    fs.write(greet, "#!/bin/sh\necho hello from jet-pkgs\n").unwrap()
    if selected_family() == "unix" { // GATE #4494, #4483
        fs.set_permissions(greet, fs.Permissions.from_mode(0o755)).unwrap()
    }
    fs.write(proj.join("env.jet"), "use jetpack as pkg\npub fn shell() -> [JSON] {{\n    return [\n        pkg.source(\"mine\", \"{repo.to_string_lossy()}\", \"core\"),\n        pkg.packages([\"hello@mine\"])\n    ]\n}}\n").unwrap()
    (^base, proj, root)
}

