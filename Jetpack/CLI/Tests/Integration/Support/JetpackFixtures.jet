// Rust: tests/support/jetpack_fixtures.rs:228
// GATE #4494: native thread, procfs descriptor inspection and hostile open.
pub fn studio_attack_snapshot(server_pid: U32, truncate: Bool) -> thread.JoinHandle[Unit] {
    thread.spawn(() -> {
        deadline := time.Instant.now() + time.Duration.from_secs(10)
        loop {
            snapshot := fs.read_dir("/proc/{server_pid}/fd").into_iter().flatten()
                .filter_map((entry) -> entry.ok())
                .find((entry) -> fs.read_link(entry.path())
                    .map((target) -> target.to_string_lossy().contains("memfd:jetos-studio-source-"))
                    .unwrap_or(false))
                .map((entry) -> entry.path())
            if snapshot is Some(path) {
                attempt := fs.OpenOptions.new().write(true).truncate(truncate).open(path)
                assert(attempt.is_err(), "sealed Studio source accepted hostile write access")
                return
            }
            assert(time.Instant.now() < deadline, "Studio snapshot never appeared")
            thread.sleep(time.Duration.from_millis(1))
        }
    })
}

// Rust: tests/support/jetpack_fixtures.rs:266
pub fn assert_no_ephemeral_links(path: OSPath) -> {
    meta := match fs.symlink_metadata(path) { Ok(value) -> value, Err(_) -> return }
    if meta.file_type().is_symlink() {
        target := fs.read_link(path).unwrap()
        text := target.to_string_lossy()
        assert(!text.contains("/proc/self/fd/"), "ephemeral FD link: {path.display()} -> {text}")
        assert(!text.contains("/leases/"), "ephemeral lease link: {path.display()} -> {text}")
        return
    }
    if meta.is_dir() {
        for entry in fs.read_dir(path).unwrap().flatten() { assert_no_ephemeral_links(entry.path()) }
    }
}

