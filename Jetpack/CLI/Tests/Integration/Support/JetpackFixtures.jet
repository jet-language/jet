// Rust: tests/support/jetpack_fixtures.rs:299
pub fn realized_fixtures(committed: OSPath, root: OSPath) -> OSPath {
    fixtures := root.join("realized-fixtures")
    if fixtures.is_dir() { return fixtures }
    fs.create_dir_all(fixtures).unwrap()
    for result in fs.read_dir(committed).unwrap() {
        entry := result.unwrap()
        name := entry.file_name()
        source := entry.path()
        destination := fixtures.join(name)
        if source.extension().and_then((ext) -> ext.to_str()) != Some("json") {
            fs.copy(source, destination).unwrap()
            continue
        }
        stem := source.file_stem().unwrap().to_string_lossy()
        staging := root.join("example-fixture-outputs").join(stem)
        fs.create_dir_all(staging).unwrap()
        fs.write(staging.join("payload"), stem.as_bytes()).unwrap()
        output := seed_hangar_object(root, staging)
        json := fs.read_to_string(source).unwrap()
        key := json.find("\"out\"").unwrap()
        colon := key + json[key..].find(':').unwrap() + 1
        value_start := colon + json[colon..].find('"').unwrap()
        value_end := value_start + 1 + json[value_start + 1..].find('"').unwrap() + 1
        json.replace_range(value_start..value_end, "{output.to_string_lossy():?}")
        fs.write(destination, json).unwrap()
    }
    fixtures
}

