// Rust: tests/support/jetpack_fixtures.rs:37
// Keep no-project commands outside the repository and redirect temporary files
// to the disk-backed test scratch root, without a disposable cwd.
// GATE #4494: native process environment and working-directory setup.
pub fn neutral_command(binary: OSPath) -> Command {
    command := Command.new(binary)
    temp := test_scratch_root("jetpack-command-tmp")
    root := temp.ancestors().last().expect("temp path has no root")
    command.current_dir(root).env("TMPDIR", temp).env("TMP", temp).env("TEMP", temp)
    command
}

// Rust: tests/support/jetpack_fixtures.rs:49
pub fn copy_dir_recursive(src: OSPath, dst: OSPath) -> {
    fs.create_dir_all(dst).unwrap()
    entries := fs.read_dir(src).unwrap().filter_map((entry) -> entry.ok()).collect()
    entries.sort_by_key((entry) -> entry.file_name())
    for entry in entries {
        path := entry.path()
        target := dst.join(entry.file_name())
        if entry.file_type().unwrap().is_dir() {
            copy_dir_recursive(path, target)
        } else {
            fs.copy(path, target).unwrap()
        }
    }
}

