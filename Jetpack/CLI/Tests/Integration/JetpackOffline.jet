use std.fs
use std.process.Command
use core.files.OSPath
use core.sys.target.[selected_os, selected_family]
use common.jetpack_bin
use Jetpack.[Store, Envelope]

// Rust: tests/jetpack_offline.rs:10
pub fn jetpack() -> Command {
    // GATE #4494: real native process command.
    Command.new(jetpack_bin())
}

// Rust: tests/jetpack_offline.rs:14
pub fn write_runnable_fixture(fixtures: OSPath, root: OSPath, staging_dir: OSPath, lua_path: String?) -> OSPath {
    // GATE #4494: native filesystem permissions and rename.
    fs.create_dir_all(fixtures).unwrap()
    bin :: staging_dir.join("bin")
    fs.create_dir_all(bin).unwrap()
    greet :: bin.join(if selected_os() == "windows" { "greet.bat" } else { "greet" })
    if selected_os() == "windows" {
        fs.write(greet, "@echo hello from offline cache\r\n").unwrap()
    } else {
        fs.write(greet, "#!/bin/sh\necho hello from offline cache\n").unwrap()
        fs.set_permissions(greet, fs.Permissions.from_mode(0o755)).unwrap()
    }
    if lua_path is Some(value) { fs.write(staging_dir.join("lua-path"), value).unwrap() }
    Store.seal_local_output(staging_dir).unwrap()
    digest :: Envelope.try_output_hash_of(staging_dir.to_string_lossy()).unwrap()
    out_dir :: root.join("hangar").join("objects").join(digest)
    fs.create_dir_all(out_dir.parent().unwrap()).unwrap()
    staging_permissions := fs.metadata(staging_dir).unwrap().permissions()
    if selected_family() == "unix" {
        &staging_permissions.set_mode(staging_permissions.mode() | 0o200)
    } else {
        &staging_permissions.set_readonly(false)
    }
    fs.set_permissions(staging_dir, staging_permissions).unwrap()
    fs.rename(staging_dir, out_dir).unwrap()
    Store.seal_local_output(out_dir).unwrap()
    assert_eq(Envelope.try_output_hash_of(out_dir.to_string_lossy()).unwrap(), digest,
        "published fixture must retain its content-addressed identity")
    json :: "[{{\"drvPath\":\"/nix/store/0fixture00000000000000000000-greet.drv\",\"outputs\":{{\"out\":{out_dir.to_string_lossy():?}}}}}]"
    fs.write(fixtures.join("nixpkgs-greet.json"), json).unwrap()
    out_dir
}

// Rust: tests/jetpack_output.rs:6
pub fn rust_sources(root: OSPath, out: &[OSPath]) -> {
    loop entry in fs.read_dir(root).unwrap() {
        path :: entry.unwrap().path()
        if path.is_dir() {
            rust_sources(path, &out)
        } else if path.extension().and_then(fn(value) -> value.to_str()) == Some("rs") {
            &out.push(path)
        }
    }
}
