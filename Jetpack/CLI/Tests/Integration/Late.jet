// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:1
use core.sys
use std.[fs, CString, IOError]

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:1244
fn set_user_xattr(path: &OSPath, name: &String, value: &[U8]) -> {
    if sys.target.selected_os() != "linux" -> return
    // GATE #4494: no-follow native xattr syscall and native path bytes.
    c_path :: CString.new(path.as_os_str().as_bytes()) ?? panic("xattr path contains NUL")
    c_name :: CString.new(name) ?? panic("xattr name contains NUL")
    rc :: #Unsafe("C strings and value remain live for the syscall") {
        lsetxattr(c_path.as_ptr(), c_name.as_ptr(), value.as_ptr(), value.len(), 0)
    }
    assert_eq(rc, 0, "lsetxattr failed: {IOError.last_os_error()}")
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:1249
// GATE #4494: libc Linux no-follow xattr ABI.
#FFI(c, "lsetxattr")
fn lsetxattr(path: Ptr[I8], name: Ptr[I8], value: Ptr[U8], size: USize, flags: I32) -> I32

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:1277
fn set_apple_xattr(path: &OSPath, name: &String, value: &[U8]) -> {
    if sys.target.selected_os() != "macos" -> return
    // GATE #4494: native xattr syscall and native path bytes.
    c_path :: CString.new(path.as_os_str().as_bytes()) ?? panic("xattr path contains NUL")
    c_name :: CString.new(name) ?? panic("xattr name contains NUL")
    rc :: #Unsafe("C strings and value remain live for the syscall") {
        setxattr(c_path.as_ptr(), c_name.as_ptr(), value.as_ptr(), value.len(), 0, 0x0001)
    }
    assert_eq(rc, 0, "setxattr failed: {IOError.last_os_error()}")
}

// Rust: crates/jetpack/src/Store/Tests/tests/late.rs:1280
// GATE #4494: libc macOS xattr ABI, XATTR_NOFOLLOW = 0x0001.
#FFI(c, "setxattr")
fn setxattr(path: Ptr[I8], name: Ptr[I8], value: Ptr[U8], size: USize, position: U32, options: I32) -> I32
