// Rust: tests/env_overlay.rs:1
use Compiler.[compile_with_path, render_diagnostics, CompileOutput]
use core.sys
// GATE #4494: filesystem and real subprocess capture, including native environment bytes.
use std.[fs, Command]

// Rust: tests/env_overlay.rs:11
fn compile(name: &String, src: &String) -> (OSPath, CompileOutput) {
    dir :: std.env.temp_dir().join("jet_env_overlay_{name}_{std.process.id()}")
    _ :: fs.remove_dir_all(dir)
    fs.create_dir_all(dir) ?? panic("create fixture directory")
    path :: dir.join("{name}.jet")
    fs.write(path, src) ?? panic("write fixture")
    shown :: path.to_string_lossy()
    out :: compile_with_path(src, &shown).unwrap_or_else((diags) -> panic("front end rejected fixture:\n{render_diagnostics(&shown, src, &diags)}"))
    (dir, out)
}

// Rust: tests/env_overlay.rs:27
fn build(dir: &OSPath, name: &String, out: &CompileOutput) -> OSPath {
    build_rust(dir, name, &out.rust)
}

// Rust: tests/env_overlay.rs:31
// Rust-generated code is an external reference comparator, never a runtime provider.
fn build_rust(dir: &OSPath, name: &String, rust: &String) -> OSPath {
    rs :: dir.join("{name}.rs")
    bin :: dir.join(name)
    fs.write(rs, rust) ?? panic("write comparator")
    rustc :: Command.new("rustc").args(["--edition", "2021"]).arg(rs).arg("-o").arg(bin).output() ?? panic("run rustc comparator")
    assert(rustc.status.success(), "rustc rejected generated code:\n{String.from_utf8_lossy(rustc.stderr)}")
    bin
}
