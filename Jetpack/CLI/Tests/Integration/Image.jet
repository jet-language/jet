//RS use std::io::{Read, Write};
//RS use std::net::TcpListener;
//RS use std::path::{Path, PathBuf};
//RS use std::process::Command;
//RS use std::thread;
//RS use std::time::{Duration, Instant};
//RS 
//RS mod common;
//RS use common::{jetpack_bin, Scratch};
//RS use jet_env_model::ModuleEval::evaluate_env;
//RS use jetpack::Store;
//RS 
//RS fn jetpack() -> Command {
//RS     Command::new(jetpack_bin())
//RS }
