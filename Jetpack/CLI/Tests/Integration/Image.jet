// Rust: tests/image.rs:1
// U14 OCI images: real deterministic layouts, Hangar environment projection and
// explicit Distribution pushes. ISO disk images remain the installer tier.
use core.sys
use Core.Foundation.TEXT_NUL
// GATE #4494: real filesystem, process, socket, timeout and thread primitives.
use std.[fs, Command, TcpListener, thread, Duration, Instant]
use common.[jetpack_bin, Scratch]
use jet_env_model.ModuleEval.evaluate_env
use Jetpack.Store
use Jetpack.Envelope

// Rust: tests/image.rs:35
fn jetpack() -> Command { Command.new(jetpack_bin()) }

// Rust: tests/image.rs:43
// Minimal package/image project, optionally with an executable staged at build/app.
fn write_project(dir: &OSPath, pkg_kind: &String, built: Bool) -> {
    fs.write(dir.join("package.jet"), "name: \"demo\"\nversion: \"0.1.0\"\npackages: {{ app: {pkg_kind} }}\n") ?? panic("write package")
    fs.write(dir.join("env.jet"), "module image.server {\n    kind: .Oci\n    from: packages.app\n    expose: [8080]\n    env_vars: [\"RUST_LOG\": \"info\"]\n}\n") ?? panic("write env")
    if built {
        fs.create_dir_all(dir.join(".jet/build")) ?? panic("create build")
        fs.write(dir.join(".jet/build/app"), "#!/bin/sh\necho hi\n".as_bytes()) ?? panic("write binary")
        // GATE #4483: preserve the Unix-only permission branch.
        if sys.target.selected_family() == "unix" {
            bin :: dir.join(".jet/build/app")
            perm := (fs.metadata(bin) ?? panic("binary metadata")).permissions()
            perm.set_mode(0o755)
            fs.set_permissions(bin, perm) ?? panic("binary permissions")
        }
    }
}

// Rust: tests/image.rs:68
fn ingest_executable(root: &OSPath, name: &String, reference: &String, binary: &String) -> {
    ingest_executable_for_platform(root, name, reference, binary, &Envelope.host_platform())
}

// Rust: tests/image.rs:78
fn ingest_executable_for_platform(root: &OSPath, name: &String, reference: &String, binary: &String, platform: &String) -> {
    source :: root.join("source-{name}")
    fs.create_dir_all(source.join("bin")) ?? panic("create source bin")
    fs.write(source.join("bin").join(binary), "#!/bin/sh\necho image\n".as_bytes()) ?? panic("write source binary")
    if sys.target.selected_family() == "unix" {
        path :: source.join("bin").join(binary)
        permissions := (fs.metadata(path) ?? panic("source metadata")).permissions()
        permissions.set_mode(0o755)
        fs.set_permissions(path, permissions) ?? panic("source permissions")
    }
    roots :: Store.Roots{root: root.to_path_buf(), dev_mode: false}
    Store.ingest_tree(&roots, &Store.IngestRequest{
        name: name.to_string(), version: "1.0.0", reference: reference.to_string(),
        cache_identity: Store.CacheIdentity{
            source_fingerprint: "sha256-source-{name}", recipe_fingerprint: "sha256-recipe-{name}",
            policy_fingerprint: "policy=image-test", platform: platform.to_string()
        },
        references: [String]{}, outputs: [String: OSPath]{"out": source},
        signature: "", provenance: "image-test", platform_artifact_kind: ""
    }) ?? panic("ingest executable")
}

// Rust: tests/image.rs:122
fn image_blob_containing(root: &OSPath, needle: &[U8]) -> [U8] {
    for entry in fs.read_dir(root.join("blobs/sha256")) ?? panic("read blobs") {
        bytes :: fs.read((entry ?? panic("blob entry")).path()) ?? panic("read blob")
        if bytes.windows(needle.len()).any(window -> window == needle) -> return bytes
    }
    panic("image has no blob containing {needle:?}")
}

// Rust: tests/image.rs:130
fn image_layer(root: &OSPath) -> [U8] {
    for entry in fs.read_dir(root.join("blobs/sha256")) ?? panic("read blobs") {
        bytes :: fs.read((entry ?? panic("blob entry")).path()) ?? panic("read blob")
        if bytes.len() >= 263 && bytes[257..263] == ("ustar" + TEXT_NUL).as_bytes() -> return bytes
    }
    panic("image has no ustar layer blob")
}

// Rust: tests/image.rs:138
fn registry_test_server(listener: TcpListener, expected_requests: USize) -> [(String, String, [U8])] {
    listener.set_nonblocking(true) ?? panic("nonblocking listener")
    deadline :: Instant.now() + Duration.from_secs(20)
    requests := [(String, String, [U8])]{ }
    while requests.len() < expected_requests && Instant.now() < deadline {
        accepted :: listener.accept()
        if accepted.is_err() {
            thread.sleep(Duration.from_millis(5))
            continue
        }
        (stream, _) := accepted.unwrap()
        stream.set_read_timeout(Val(Duration.from_secs(2))) ?? panic("read timeout")
        request := [U8]{}
        buffer := [U8; 4096].filled(0)
        header_end := nil as USize?
        loop {
            read :: stream.read(&buffer) ?? panic("read headers")
            if read == 0 -> break
            request.extend_from_slice(buffer[..read])
            if index :: request.windows(4).position(window -> window == "\r\n\r\n".as_bytes()) {
                header_end = Val(index + 4)
                break
            }
            assert(request.len() < 128 * 1024, "registry test request headers are unbounded")
        }
        if header_end.is_none() -> continue
        end :: header_end.unwrap()
        headers :: request[..end]
        header_text :: String.from_utf8_lossy(headers)
        lines := header_text.lines()
        request_line :: lines.next() ?? ""
        request_parts := request_line.split_whitespace()
        method :: (request_parts.next() ?? "").to_string()
        path :: (request_parts.next() ?? "").to_string()
        content_length := 0 as USize
        for line in lines {
            if pair :: line.split_once(':') {
                (name, value) :: pair
                if name.eq_ignore_ascii_case("content-length") {
                    trimmed := value.trim() // #4303
                    content_length = trimmed.parse[USize]() ?? panic("content length")
                    break
                }
            }
        }
        while request.len() < end + content_length {
            read :: stream.read(&buffer) ?? panic("read body")
            if read == 0 -> break
            request.extend_from_slice(buffer[..read])
        }
        body :: request[end..request.len().min(end + content_length)].to_vec()
        requests.push((method.clone(), path.clone(), body))
        (status, extra_headers) :: match method.as_str() {
            "HEAD" -> (404, "")
            "POST" -> (202, "Location: /test-upload\r\n")
            "PUT" if path.contains("/blobs/uploads/") || path.starts_with("/test-upload") -> (201, "")
            "PUT" if path.contains("/manifests/") -> (201, "")
            _ -> (404, "")
        }
        response :: "HTTP/1.1 {status} Test\r\n{extra_headers}Content-Length: 0\r\nConnection: close\r\n\r\n"
        stream.write_all(response.as_bytes()) ?? panic("write response")
    }
    requests
}
