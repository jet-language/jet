use Jetpack.Lock.[LockFile, LockSource, LockedPackage]

// Rust: tests/pkg.rs:6436
pub fn make_test_lock(name: &String, version: &String, fp: &String) -> LockFile {
    LockFile {
        version: 1,
        packages: [LockedPackage {
            name: name.to_string(), version: version.to_string(), fingerprint: fp.to_string(),
            content_hash: None, source: LockSource.Path("/tmp/placeholder"), nix_closure: None,
            locked: None, dependencies: [], layer: None, inferred_layer: None, effects: [],
            effect_grants: [], required_effects: [], granted_effects: [], denied_effects: [],
            effect_authority: None, envelope: None, receipt: None, provenance: None,
        }],
        root_dependencies: [name.to_string()], authority: None, workspace_members: [],
        workspace_source_digest: None, workspace_overlay_policy: Default.default(),
        comptime_inputs: [], toolchains: [], browsers: [], source_channels: [],
        build_stamp: None, build_contributions: [],
    }
}
