//RS fn audit_e2603_on_vulnerable_dep() {
//RS     use jet::Publish::Advisory::Advisory;
//RS     use jet::Publish::SemVer::SemVer;
//RS     use jet::Publish::{audit_lockfile, Severity, VersionReq};
//RS 
//RS     let lock = make_test_lock("crypto-lib", "0.9.0", "sha256-aabb");
//RS     // Advisory: crypto-lib ^0 (pre-1.0) has a critical issue fixed in 0.9.5.
//RS     let advisories = vec![Advisory {
//RS         id: "JET-2026-SEC-001".into(),
//RS         package: "crypto-lib".into(),
