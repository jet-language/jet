#Test("outdated_labels_pinned_manual_and_automatic_sources") {
    proj :: Scratch.new("proj")
    root :: Scratch.new("root")
    fixtures :: Scratch.new("fx")
    fs.write(proj.join("env.jet"), "\nmodule dev {\n    sources: {\n        pinned: rustc@jetpack,\n        manual: jq@jetpack#latest,\n        automatic: omp@jetpack#auto,\n    }\n    env.dev: Env{ packages: [] }\n}\n") ?? panic("write env")
    fs.create_dir_all(proj.join(".jet")) ?? panic("create .jet")
    fs.write(proj.join(".jet/lock"), "version = 1\n\n[[source_channel]]\nname = \"manual\"\nchannel = \"latest\"\nexact = \"nixpkgs:jq#1.0\"\n\n[[source_channel]]\nname = \"automatic\"\nchannel = \"latest\"\nexact = \"nixpkgs:omp#1.0\"\n\n[root]\ndependencies = []\n") ?? panic("write lock")
    write_channel_fixture(&fixtures.path, "nixpkgs:jq", "latest", "nixpkgs:jq#1.0")
    write_channel_fixture(&fixtures.path, "nixpkgs:omp", "latest", "nixpkgs:omp#1.0")
    out :: jetpack().args(["outdated", "--no-color", "--fixtures"]).arg(&fixtures.path).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).output() ?? panic("outdated")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("pinned"), "stderr: {stderr}")
    assert(stderr.contains("manual"), "stderr: {stderr}")
    assert(stderr.contains("automatic"), "stderr: {stderr}")
}

