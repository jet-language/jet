// Rust: tests/jetpack_engine.rs:6528
#Test("env_sync_applies_typed_files_and_refuses_unmanaged_destinations") {
    project :: Scratch.new("env-sync-files")
    root :: Scratch.new("env-sync-files-root")
    home :: Scratch.new("env-sync-files-home")
    fs.write(project.join("env.jet"), "module env.dev {\n    files: [\n        \"generated/config.txt\": File{ content: \"generated\\n\", mode: .Copy },\n        \"seed/config.txt\": File{ content: \"seeded\\n\", mode: .Seed }\n    ]\n}\n") ?? panic("write env")
    fs.create_dir_all(project.join("seed")) ?? panic("create seed")
    fs.write(project.join("seed/config.txt"), "keep me\n") ?? panic("write seed")
    output :: jetpack().args(["env", "sync", "--trust", "--yes", "--offline", "--no-color"]).current_dir(&project.path).env("JETPACK_ROOT", &root.path).env("HOME", &home.path).output() ?? panic("sync")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    assert_eq(fs.read_to_string(project.join("generated/config.txt")) ?? panic("read generated"), "generated\n")
    assert_eq(fs.read_to_string(project.join("seed/config.txt")) ?? panic("read seed"), "keep me\n")
    assert(project.join(".jet/files/state").is_file())
    blocked :: Scratch.new("env-sync-files-blocked")
    blocked_root :: Scratch.new("env-sync-files-blocked-root")
    blocked_home :: Scratch.new("env-sync-files-blocked-home")
    fs.write(blocked.join("env.jet"), fs.read(project.join("env.jet")) ?? panic("read env")) ?? panic("copy env")
    fs.create_dir_all(blocked.join("generated")) ?? panic("create generated")
    fs.write(blocked.join("generated/config.txt"), "user-owned\n") ?? panic("write user-owned")
    refused :: jetpack().args(["env", "sync", "--trust", "--yes", "--offline", "--no-color"]).current_dir(&blocked.path).env("JETPACK_ROOT", &blocked_root.path).env("HOME", &blocked_home.path).output() ?? panic("sync")
    assert_eq(refused.status.code(), Val(2))
    assert(String.from_utf8_lossy(refused.stderr).contains("unmanaged destination"), "stderr: {String.from_utf8_lossy(refused.stderr)}")
    assert_eq(fs.read_to_string(blocked.join("generated/config.txt")) ?? panic("read user-owned"), "user-owned\n")
    assert(!blocked.join(".jet/files/state").exists())
}

