// Rust: tests/jetpack_engine.rs:6818
#Test("bridge_flake_uses_native_evaluator_without_nix") {
    dir :: Scratch.new("bridge-nonix")
    fs.write(dir.join("flake.nix"), "{ devShells.x86_64-linux.default = pkgs.mkShell { packages = [ pkgs.fd ]; }; }") ?? panic("write flake")
    output :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&dir.path).env("PATH", "").output() ?? panic("bridge")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    assert(String.from_utf8_lossy(output.stdout).contains("packages: [fd]"), "stdout: {String.from_utf8_lossy(output.stdout)}")
    lock_text :: fs.read_to_string(dir.join(".jet/lock")) ?? panic("native bridge must commit the pinned evaluator ledger")
    lock :: SemanticLock.parse(lock_text)
    inventory :: lock.records.iter().filter(record -> record.identity.key.starts_with("flake-evaluator-inventory:")).collect()
    assert_eq(inventory.len(), 17, lock_text)
    assert_eq(inventory.iter().filter(record -> record.identity.exact.contains("class=evaluable")).count(), 10)
    assert_eq(inventory.iter().filter(record -> record.identity.exact.contains("class=buildable")).count(), 5)
    skipped :: inventory.iter().filter(record -> record.identity.exact.starts_with("status=skipped;")).collect()
    assert_eq(skipped.len(), 2, lock_text)
    assert(skipped.iter().any(record -> record.identity.key.ends_with(":dynamic-derivations") && record.identity.exact == "status=skipped;class=skipped;reason=dynamic staging has a separate compatibility boundary"))
    assert(skipped.iter().any(record -> record.identity.key.ends_with(":ifd") && record.identity.exact == "status=skipped;class=skipped;reason=import-from-derivation requires a separate authority grant"))
    for (surface, class, reason) in [
        ("fixed-output-fetchers", "buildable", "explicit fetch authority returns verified canonical store paths"),
        ("cross-system-packages", "buildable", "explicit target authority projects pinned systems"),
        ("external-flakes", "evaluable", "explicit provider authority evaluates bounded external sources")
    ] {
        key :: "flake-evaluator-inventory:{surface}"
        exact :: "status=covered;class={class};reason={reason}"
        assert(inventory.iter().any(record -> record.identity.key == key && record.identity.exact == exact), "missing inventory record {key}: {lock_text}")
    }
    assert(lock.records.iter().any(record -> record.identity.key == "flake-evaluator" && record.identity.exact == "native-nix:2.34.8:b5aa0fbd538984f6e3d201be0005b4463d8b09f8:x86_64-linux"))
    before_failure :: lock_text
    fs.write(dir.join("flake.nix"), " ".repeat((1 << 20) + 1)) ?? panic("write oversized flake")
    failed :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&dir.path).env("PATH", "").output() ?? panic("bridge")
    assert_eq(failed.status.code(), Val(1))
    stderr :: String.from_utf8_lossy(failed.stderr)
    assert(stderr.contains("E1256"), "stderr: {stderr}")
    assert(!stderr.contains("nix eval"), "stderr: {stderr}")
    assert_eq(fs.read_to_string(dir.join(".jet/lock")) ?? panic("read lock"), before_failure)
}

// Rust: tests/jetpack_engine.rs:6936
#Test("bridge_flake_breadth_and_json_budget_use_native_evaluator_without_nix") {
    dir :: Scratch.new("bridge-native-breadth")
    fs.write(dir.join("flake.nix"), "{ devShells.x86_64-linux.default = pkgs.mkShell {\n  packages = builtins.attrValues (builtins.fromJSON \"{\\\"b\\\":\\\"ripgrep\\\",\\\"a\\\":\\\"fd\\\"}\");\n}; }") ?? panic("write flake")
    output :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&dir.path).env("PATH", "").output() ?? panic("bridge")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    assert(String.from_utf8_lossy(output.stdout).contains("packages: [fd, ripgrep]"), "stdout: {String.from_utf8_lossy(output.stdout)}")
    lock_before_budget_failure :: fs.read_to_string(dir.join(".jet/lock")) ?? panic("native breadth bridge must commit a lock before the failure case")
    opens :: "[".repeat(257)
    closes :: "]".repeat(257)
    nested_json :: "{opens}true{closes}"
    over_budget :: "{ devShells.x86_64-linux.default = pkgs.mkShell { packages = builtins.fromJSON \"{nested_json}\"; }; }"
    fs.write(dir.join("flake.nix"), over_budget) ?? panic("write over-budget flake")
    failed :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&dir.path).env("PATH", "").output() ?? panic("bridge")
    assert(!failed.status.success())
    stderr :: String.from_utf8_lossy(failed.stderr)
    assert(stderr.contains("E1256"), "stderr: {stderr}")
    assert(stderr.contains("JSON value is too deeply nested"), "stderr: {stderr}")
    assert(!stderr.contains("nix eval"), "stderr: {stderr}")
    assert_eq(fs.read_to_string(dir.join(".jet/lock")) ?? panic("read lock"), lock_before_budget_failure)
}

// Rust: tests/jetpack_engine.rs:6990
#Test("bridge_flake_projects_fetchers_cross_packages_and_external_flakes_without_nix") {
    dir :: Scratch.new("bridge-native-nix-breadth")
    fs.create_dir_all(dir.join("dep")) ?? panic("create dep")
    fs.write(dir.join("dep/flake.nix"), "{ packages.x86_64-linux.default = pkgs.fd; }") ?? panic("write dep")
    source_bytes :: "fixed-output\n".as_bytes()
    fs.write(dir.join("source.txt"), source_bytes) ?? panic("write source")
    source_hash :: SHA256.sha256_hex(source_bytes)
    source :: "{\n  devShells.x86_64-linux.default = pkgs.mkShell {\n    packages = [\n      (builtins.getFlake \"path:./dep\").packages.x86_64-linux.default\n      pkgs.pkgsCross.aarch64-multiplatform.foo\n    ];\n  };\n  packages.x86_64-linux.fetched = builtins.derivationStrict {\n    name = \"fetched\";\n    system = \"x86_64-linux\";\n    builder = \"/bin/sh\";\n    args = [ \"-c\" \"echo $src > $out\" ];\n    src = builtins.fetchurl {\n      url = \"file:./source.txt\";\n      sha256 = \"{source_hash}\";\n      name = \"source.txt\";\n    };\n  };\n}\n"
    fs.write(dir.join("flake.nix"), source) ?? panic("write flake")
    output :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&dir.path).env("PATH", "").output() ?? panic("bridge")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    stdout :: String.from_utf8_lossy(output.stdout)
    assert(stdout.contains("packages: [fd, fetched]"), "stdout: {stdout}")
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("cross-package:aarch64-linux/foo"), "stderr: {stderr}")
    assert(!stderr.contains("nix eval"), "stderr: {stderr}")
    lock_path :: dir.join(".jet/lock")
    lock_before_failure :: fs.read_to_string(lock_path) ?? panic("breadth bridge lock")
    assert(lock_before_failure.contains("flake-devshell:devShells:x86_64-linux:default") && lock_before_failure.contains("packages=fd;unsupported=cross-package:aarch64-linux/foo"), "lock: {lock_before_failure}")
    assert(lock_before_failure.contains("flake-derivation:packages:x86_64-linux:fetched"), "lock: {lock_before_failure}")
    fs.write(dir.join("source.txt"), "tampered\n".as_bytes()) ?? panic("tamper source")
    fetch_failed :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&dir.path).env("PATH", "").output() ?? panic("bridge")
    assert_eq(fetch_failed.status.code(), Val(1))
    fetch_failure_stderr :: String.from_utf8_lossy(fetch_failed.stderr)
    assert(fetch_failure_stderr.contains("E1256"), "stderr: {fetch_failure_stderr}")
    assert(fetch_failure_stderr.contains("verified fetch hash mismatch"), "stderr: {fetch_failure_stderr}")
    assert_eq(fs.read_to_string(lock_path) ?? panic("read lock"), lock_before_failure)
    fs.write(dir.join("flake.nix"), "{ devShells.x86_64-linux.default = pkgs.mkShell {\n  packages = [ (builtins.getFlake \"github:NixOS/nixpkgs\").packages.x86_64-linux.default ];\n}; }") ?? panic("write external flake")
    failed :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&dir.path).env("PATH", "").output() ?? panic("bridge")
    assert_eq(failed.status.code(), Val(1))
    failure_stderr :: String.from_utf8_lossy(failed.stderr)
    assert(failure_stderr.contains("E1256"), "stderr: {failure_stderr}")
    assert(failure_stderr.contains("provider authority"), "stderr: {failure_stderr}")
    assert(!failure_stderr.contains("nix eval"), "stderr: {failure_stderr}")
    assert_eq(fs.read_to_string(lock_path) ?? panic("read lock"), lock_before_failure)
}

// Rust: tests/jetpack_engine.rs:7108
#Test("bridge_flake_projects_overlays_named_devshells_and_all_outputs_without_nix") {
    dir :: Scratch.new("bridge-native-evaluator-breadth")
    fs.write(dir.join("flake.nix"), "{\n  packages.x86_64-linux.default = builtins.derivation {\n    name = \"many\";\n    system = \"x86_64-linux\";\n    builder = \"/bin/sh\";\n    outputs = [ \"out\" \"dev\" \"doc\" ];\n  };\n  devShells.x86_64-linux.default =\n    (import pkgs { overlays = [ (final: prev: { custom = prev.fd; }) ]; }).mkShell {\n      packages = [ (import pkgs { overlays = [ (final: prev: { custom = prev.fd; }) ]; }).custom ];\n    };\n  devShells.x86_64-linux.debug = {\n    packages = [ pkgs.ripgrep ];\n    inputsFrom = [];\n    shellHook = \"export DEBUG=1\";\n  };\n}\n") ?? panic("write flake")
    output :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&dir.path).env("PATH", "").output() ?? panic("bridge")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    assert(String.from_utf8_lossy(output.stdout).contains("packages: [fd]"), "stdout: {String.from_utf8_lossy(output.stdout)}")
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("L0204"), "stderr: {stderr}")
    assert(stderr.contains("inputsFrom"), "stderr: {stderr}")
    lock :: fs.read_to_string(dir.join(".jet/lock")) ?? panic("read lock")
    assert(lock.contains("flake-devshell:devShells:x86_64-linux:debug"), "lock: {lock}")
    assert(lock.contains("packages=ripgrep;unsupported=inputsFrom,shellHook"), "lock: {lock}")
    assert(lock.contains("flake-derivation:packages:x86_64-linux:default"), "lock: {lock}")
    assert(lock.contains("drvPath=/nix/store/iqjpmbf780gw1gqzhcvarkhw6h9y4c98-many.drv;dev=/nix/store/0cmdcz6gdcx6k0wf2ir78dh5isib04w3-many-dev;doc=/nix/store/v5m6bfihjhlp2ggsr9zcgw1j4wz1z1az-many-doc;out=/nix/store/3d8xbsqfn74lgzz2x82y3hh8i9mmx7xy-many"), "lock: {lock}")
    overlay_list :: std.iter.repeat("overlay").take(65).collect().join(" ")
    over_budget :: "let overlay = final: prev: {}; in { devShells.x86_64-linux.default = (import pkgs { overlays = [ {overlay_list} ]; }).mkShell { packages = []; }; }"
    fs.write(dir.join("flake.nix"), over_budget) ?? panic("write over-budget flake")
    failed :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&dir.path).env("PATH", "").output() ?? panic("bridge")
    assert_eq(failed.status.code(), Val(1))
    failure_stderr :: String.from_utf8_lossy(failed.stderr)
    assert(failure_stderr.contains("E1256"), "stderr: {failure_stderr}")
    assert(failure_stderr.contains("overlay list exceeds 64"), "stderr: {failure_stderr}")
    assert_eq(fs.read_to_string(dir.join(".jet/lock")) ?? panic("read lock"), lock)
}
