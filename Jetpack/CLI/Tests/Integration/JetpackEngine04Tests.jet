    fs.write(project.join("run.jet"), "#Job\nfn lint() {}\n") ?? panic("write job")
    output :: jetpack().args(["env", "info", "--json", "--no-color"]).current_dir(&project.path).env("HOSTNAME", "epoch5-host").env("USER", "epoch5-user").output() ?? panic("info")
