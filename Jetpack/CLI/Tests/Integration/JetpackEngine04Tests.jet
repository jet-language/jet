// Rust: tests/jetpack_engine.rs:5782
#Test("jetpack_env_runs_command_in_project_env") {
    (base, proj, root) :: core_hello_project("env")
    output :: jetpack().args(["env", "--no-color", "--trust", "--", "hello"]).current_dir(proj).env("JETPACK_ROOT", root).env("HOME", base.join("home")).env("PATH", "/usr/bin:/bin").output() ?? panic("env")
    assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
    text := String.from_utf8_lossy(output.stdout).trim() // #4303
    assert_eq(text, "hello from jet-pkgs")
    roots :: Store.Roots.at(root)
    entry :: Store.find_by_reference(&roots, "hello@mine") ?? panic("core realization should register a Store entry")
    producer :: Store.ProducerRecord.decode(entry.producer_record) ?? panic("Store producer record")
    shared :: ProviderFacts.from_json(producer.facts.get("provider-facts") ?? panic("Store entry should carry shared provider facts")) ?? panic("shared provider facts JSON")
    shared.validate() ?? panic("Store provider facts are lossless")
    assert_eq(shared.reference, entry.reference)
    assert(!shared.native_document.is_empty())
}

