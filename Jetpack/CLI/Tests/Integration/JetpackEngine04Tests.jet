// Rust: tests/jetpack_engine.rs:5421
#Test("channel_build_without_lock_is_e1271") {
    proj :: Scratch.new("proj")
    root :: Scratch.new("root")
    fs.write(proj.join("env.jet"), "\nmodule dev {\n    sources: { default: acme/tools@github#latest }\n    env.dev: Env{ packages: [default.greet] }\n}\n") ?? panic("write env")
    out :: jetpack().args(["build", "--no-color", "--offline"]).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).output() ?? panic("build")
    assert_eq(out.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("E1271"), "stderr: {stderr}")
    assert(stderr.contains("jetpack update default"), "stderr: {stderr}")
}

// Rust: tests/jetpack_engine.rs:5450
#Test("channel_update_accepts_main_and_semver_mask") {
    proj :: Scratch.new("proj")
    root :: Scratch.new("root")
    fixtures :: Scratch.new("fx")
    fs.write(proj.join("env.jet"), "\nmodule dev {\n    sources: {\n        trunk: acme/tools@github#main,\n        stable: acme/tools@github#v0.x,\n    }\n    env.dev: Env{ packages: [trunk.greet, stable.greet] }\n}\n") ?? panic("write env")
    fs.create_dir_all(&fixtures.path) ?? panic("create fixtures")
    fs.write(fixtures.join("channels.txt"), "github:acme/tools main github:acme/tools#abc123\ngithub:acme/tools v0.x github:acme/tools#v0.9.4\n") ?? panic("write channels")
    out :: jetpack().args(["update", "--no-color", "--yes", "--fixtures"]).arg(&fixtures.path).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).output() ?? panic("update")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    lock :: fs.read_to_string(proj.join(".jet/lock")) ?? panic("read lock")
    assert(lock.contains("name = \"trunk\""), "lock: {lock}")
    assert(lock.contains("channel = \"main\""), "lock: {lock}")
    assert(lock.contains("exact = \"github:acme/tools#abc123\""), "lock: {lock}")
    assert(lock.contains("name = \"stable\""), "lock: {lock}")
    assert(lock.contains("channel = \"v0.x\""), "lock: {lock}")
    assert(lock.contains("exact = \"github:acme/tools#v0.9.4\""), "lock: {lock}")
}

// Rust: tests/jetpack_engine.rs:5503
#Test("outdated_reports_newer_channel_without_mutating_lock") {
    proj :: Scratch.new("proj")
    root :: Scratch.new("root")
    fixtures :: Scratch.new("fx")
    fs.write(proj.join("env.jet"), "\nmodule dev {\n    sources: { default: acme/tools@github#latest }\n    env.dev: Env{ packages: [default.greet] }\n}\n") ?? panic("write env")
    fs.create_dir_all(proj.join(".jet")) ?? panic("create .jet")
    fs.write(proj.join(".jet/lock"), "version = 1\n\n[[source_channel]]\nname = \"default\"\nchannel = \"latest\"\nexact = \"github:acme/tools#v1.2.0\"\n\n[root]\ndependencies = []\n") ?? panic("write lock")
    write_channel_fixture(&fixtures.path, "github:acme/tools", "latest", "github:acme/tools#v1.3.0")
    out :: jetpack().args(["outdated", "--no-color", "--fixtures"]).arg(&fixtures.path).current_dir(&proj.path).env("JETPACK_ROOT", &root.path).output() ?? panic("outdated")
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("v1.2.0"), "stderr: {stderr}")
    assert(stderr.contains("v1.3.0"), "stderr: {stderr}")
    lock :: fs.read_to_string(proj.join(".jet/lock")) ?? panic("read lock")
    assert(lock.contains("exact = \"github:acme/tools#v1.2.0\""), "lock mutated: {lock}")
}

