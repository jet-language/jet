    assert(lock.contains("exact = \"nixpkgs:omp#1.2.4\""), "lock: {lock}")
    manifest :: fs.read_to_string(proj.join("env.jet")) ?? panic("read env")
    assert(manifest.contains("omp@nixpkgs#auto"), "manifest: {manifest}")
}

