// Rust: tests/jetpack_engine.rs:6151
#Test("bridge_flake_projects_imported_flake_parts_module_and_preserves_last_lock_on_failure") {
    project :: Scratch.new("flake-parts-bridge")
    fs.create_dir_all(project.join("parts")) ?? panic("create parts")
    fs.write(project.join("flake.nix"), "\nlet marker = \"flake-parts mkFlake\"; in {\n  imports = [ ./parts/dev.nix ];\n  systems = [ \"x86_64-linux\" ];\n  perSystem = true;\n  outputs = import ./parts/dev.nix;\n}\n") ?? panic("write flake")
    fs.write(project.join("parts/dev.nix"), "{ devShells.x86_64-linux.default = { packages = [ pkgs.fd ]; }; }\n") ?? panic("write module")
    first :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&project.path).env("PATH", "").output() ?? panic("bridge")
    assert(first.status.success(), "stderr: {String.from_utf8_lossy(first.stderr)}")
    assert(String.from_utf8_lossy(first.stdout).contains("packages: [fd]"), "stdout: {String.from_utf8_lossy(first.stdout)}")
    lock_path :: project.join(".jet/lock")
    before :: fs.read(lock_path) ?? panic("successful bridge must commit a semantic lock")
    lock_text :: String.from_utf8(before.clone()) ?? panic("lock utf8")
    assert(lock_text.contains("flake-composition:flake-parts"), lock_text)
    assert(lock_text.contains("./parts/dev.nix"), lock_text)
    previous :: SemanticLock.parse(lock_text)
    previous_graph :: SemanticLock.FlakeGraph.from_semantic_lock("flake.nix", &previous) ?? panic("the committed imported-module projection must remain usable")
    assert(previous_graph.named_dev_shells().iter().any(output -> output.provenance.contains("./parts/dev.nix")))
    fs.write(project.join("parts/dev.nix"), "{ devShells.x86_64-linux.default = { packages = pkgs.lib.optionals true [ pkgs.fd ]; }; }\n") ?? panic("write dynamic module")
    failed :: jetpack().args(["bridge", "flake", "--no-color"]).current_dir(&project.path).env("PATH", "").output() ?? panic("bridge")
    assert_eq(failed.status.code(), Val(1))
    stderr :: String.from_utf8_lossy(failed.stderr)
    assert(stderr.contains("E1256"), "stderr: {stderr}")
    assert_eq(fs.read(lock_path) ?? panic("read preserved lock"), before)
}

