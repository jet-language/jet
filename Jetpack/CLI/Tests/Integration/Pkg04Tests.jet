    envs :: &[("JET_REGISTRY_URL", url.as_str()), ("JET_REGISTRY_CACHE_DIR", cache.to_str().unwrap()),
        ("JET_PACKAGE_STORE_DIR", store.to_str().unwrap()), ("JET_KEYS_DIR", keys.to_str().unwrap())]
