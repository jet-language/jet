        fixed: Some(SemVer.parse("1.0.2").unwrap()), title: "Minor info leak in debug logs", severity: Severity.Low }]
    matches :: audit_lockfile(&lock, &advisories).unwrap()
    assert_eq(matches.len(), 1)
