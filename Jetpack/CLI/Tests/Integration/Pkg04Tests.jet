    assert(stderr2.contains("E1234"), "republish must cite E1234:\n{stderr2}")
    _ :: fs.remove_dir_all(&tmp)
}

// Rust: tests/pkg.rs:6875
#Test("cli_concurrent_publish_keeps_one_immutable_version") {
    if !jet_bin().is_file() || !have_git() { eprintln("note: skipping cli_concurrent_publish (need built binary and git)"); return }
    tmp :: tmp_dir("pub_concurrent")
    left :: tmp.join("left")
    right :: tmp.join("right")
    bare :: tmp.join("registry.git")
    url :: bare_registry(&bare)
    cache :: tmp.join("cache")
    keys :: tmp.join("keys")
    fs.create_dir_all(&left).unwrap()
    fs.create_dir_all(&right).unwrap()
    init_clean_project(&left, "racekit", "1.0.0")
    init_clean_project(&right, "racekit", "1.0.0")
    write(&right, "run.jet", "#Test(\"smoke\") { expect(1 == 1) }\nfn run() { print(\"different bytes\") }\n")
    for args in [["add", "."], ["commit", "-m", "different source"]] {
        _ :: Command.new("git").args(args).current_dir(&right).output().unwrap()
    }
    seed_core_review(&bare, "racekit", "1.0.0")
    keygen :: jet_cmd_env(&["registry", "keygen"], &left, &[("JET_KEYS_DIR", keys.to_str().unwrap())])
    assert(keygen.status.success(), "shared publish keygen failed: {String.from_utf8_lossy(&keygen.stderr)}")
    spawn :: (project: &OSPath, store: &OSPath) -> Command.new(jet_bin()).args(["registry", "publish"])
        .current_dir(project).env("JET_REGISTRY_URL", &url).env("JET_REGISTRY_CACHE_DIR", &cache)
        .env("JET_KEYS_DIR", &keys).env("JET_PACKAGE_STORE_DIR", store)
        .stdout(Stdio.piped()).stderr(Stdio.piped()).spawn().unwrap()
    left_child :: spawn(&left, &tmp.join("left-store"))
    right_child :: spawn(&right, &tmp.join("right-store"))
    left_output :: left_child.wait_with_output().unwrap()
    right_output :: right_child.wait_with_output().unwrap()
    outputs :: [&left_output, &right_output]
    assert_eq(outputs.iter().filter((output) -> output.status.success()).count(), 1,
        "exactly one concurrent immutable publish may win: left={left_output.status:?}, right={right_output.status:?}")
    loser :: outputs.iter().find((output) -> !output.status.success()).expect("one concurrent publisher must lose")
    assert(String.from_utf8_lossy(&loser.stderr).contains("E1234"),
        "duplicate concurrent publish must report immutable-version error: {String.from_utf8_lossy(&loser.stderr)}")
    index :: read_index_file(&bare, "racekit").expect("winning index entry must be published")
    assert_eq(index.lines().filter((line) -> line.contains("\"version\":\"1.0.0\"")).count(), 1,
        "concurrent publication must leave one immutable index line: {index}")
    for path in ["artifacts/racekit/1.0.0/package.jet", "metadata/racekit.json", "transparency/log", "transparency/checkpoint"] {
        output :: Command.new("git").args(["--git-dir", bare.to_str().unwrap(), "cat-file", "-e"]).arg("HEAD:{path}").output().unwrap()
        assert(output.status.success(), "winning publish omitted {path}")
    }
    _ :: fs.remove_dir_all(&tmp)
}

