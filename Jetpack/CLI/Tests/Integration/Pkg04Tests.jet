// Rust: tests/pkg.rs:5967
#Test("physical_unit_api_freeze_and_semver_share_one_canonical_signature") {
    dir :: tmp_dir("physical_unit_api_freeze")
    current :: "#UnitFamily(Length, base: meter) { meter millimeter(scale: 1/1000) }\npub fn distance() -> Millimeter { return Millimeter.from_float(1.0) }\n"
    current_path :: dir.join("current.jet")
    fs.write(&current_path, current).unwrap()
    current_api :: extract_public_api_for_package(current, current_path.to_str().unwrap(), "physics")
    bundle := Loader.load_entry_with_overlay(current_path.to_str().unwrap(), None, true).unwrap()
    (_, facts) :: Sema.check_bundle_with_effect_facts(&bundle, Sema.CompileMode.Check)
    entry :: &bundle.modules[bundle.entry]
    frozen :: snapshot_from_items_with_effects(&entry.items, "physics", "1.0.0", Some(&facts.solved), Some(&entry.alias))
    assert_eq(frozen.api_version, API_SNAPSHOT_VERSION)
    frozen_api: [ApiItem] :: frozen.funcs.iter().map((function) -> ApiItem { kind: "fn", name: function.name.clone(), signature: function.signature.clone() }).collect()
    assert(diff_public_api(&frozen_api, &current_api).is_empty())
    changed :: "#UnitFamily(Length, base: meter) { meter millimeter(scale: 1/100) }\npub fn distance() -> Millimeter { return Millimeter.from_float(1.0) }\n"
    changed_path :: dir.join("changed.jet")
    fs.write(&changed_path, changed).unwrap()
    changed_api :: extract_public_api_for_package(changed, changed_path.to_str().unwrap(), "physics")
    assert_eq(diff_public_api(&current_api, &changed_api).len(), 1)
    foreign_api :: extract_public_api_for_package(current, current_path.to_str().unwrap(), "geometry")
    assert_eq(diff_public_api(&current_api, &foreign_api).len(), 1)
    affine :: "#UnitFamily(Temperature, base: kelvin) { kelvin celsius(scale: 1, offset: 27315/100) }\npub fn target() -> CelsiusPoint { return CelsiusPoint.from_float(20.0) }\n"
    affine_path :: dir.join("affine.jet")
    fs.write(&affine_path, affine).unwrap()
    affine_api :: extract_public_api_for_package(affine, affine_path.to_str().unwrap(), "physics")
    shifted :: "#UnitFamily(Temperature, base: kelvin) { kelvin celsius(scale: 1, offset: 27415/100) }\npub fn target() -> CelsiusPoint { return CelsiusPoint.from_float(20.0) }\n"
    shifted_path :: dir.join("shifted.jet")
    fs.write(&shifted_path, shifted).unwrap()
    shifted_api :: extract_public_api_for_package(shifted, shifted_path.to_str().unwrap(), "physics")
    assert_eq(diff_public_api(&affine_api, &shifted_api).len(), 1)
    length_generic :: "pub fn keep<Q: Quantity<Length, .Linear>>(value: ^Q) -> Q { return value }\n"
    time_generic :: "pub fn keep<Q: Quantity<Time, .Linear>>(value: ^Q) -> Q { return value }\n"
    length_path :: dir.join("length_generic.jet")
    time_path :: dir.join("time_generic.jet")
    fs.write(&length_path, length_generic).unwrap()
    fs.write(&time_path, time_generic).unwrap()
    length_api :: extract_public_api_for_package(length_generic, length_path.to_str().unwrap(), "physics")
    time_api :: extract_public_api_for_package(time_generic, time_path.to_str().unwrap(), "physics")
    assert_eq(length_api[0].signature, "fn keep<Q: Quantity<Length, .Linear>>(value: ^Q) Q -[]>")
    assert_eq(diff_public_api(&length_api, &time_api).len(), 1)
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/pkg.rs:6066
#Test("soft_public_names_are_not_semver_promises") {
    dir :: tmp_dir("soft_public_api")
    old :: "pub fn stable() {}\npub fn _unstable() {}\n"
    new :: "pub fn stable() {}\n"
    old_path :: dir.join("old.jet")
    new_path :: dir.join("new.jet")
    fs.write(&old_path, old).unwrap()
    fs.write(&new_path, new).unwrap()
    old_api :: extract_public_api(old, old_path.to_str().unwrap())
    new_api :: extract_public_api(new, new_path.to_str().unwrap())
    assert(old_api.iter().all((item) -> item.name != "_unstable"))
    assert(diff_public_api(&old_api, &new_api).is_empty())
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/pkg.rs:6086
#Test("inferred_public_effect_drift_is_breaking") {
    dir :: tmp_dir("effect_api_drift")
    pure_path :: dir.join("pure.jet")
    io_path :: dir.join("io.jet")
    pure :: "pub fn report() -> Int { return 1 }\n"
    io :: "pub fn report() -> Int {\n    print(\"report\")\n    return 1\n}\n"
    fs.write(&pure_path, pure).unwrap()
    fs.write(&io_path, io).unwrap()
    pure_api :: extract_public_api(pure, pure_path.to_str().unwrap())
    io_api :: extract_public_api(io, io_path.to_str().unwrap())
    assert(pure_api[0].signature.contains("-[]>"))
    assert(io_api[0].signature.contains("-[IO]>"))
    assert_eq(diff_public_api(&pure_api, &io_api).len(), 1)
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/pkg.rs:6107
#Test("inferred_inline_module_effects_are_published") {
    dir :: tmp_dir("inline_module_effect_api")
    old_dir :: dir.join("old")
    new_dir :: dir.join("new")
    fs.create_dir_all(&old_dir).unwrap()
    fs.create_dir_all(&new_dir).unwrap()
    old_path :: old_dir.join("run.jet")
    new_path :: new_dir.join("run.jet")
    old :: "module files { pub fn report() { print(\"report\") } }\nmodule bench { pub fn report() {} }\n"
    new :: "module files { pub fn report() { print(\"report\") } }\nmodule bench { pub fn report() { print(\"bench\") } }\n"
    fs.write(&old_path, old).unwrap()
    fs.write(&new_path, new).unwrap()
    old_api :: extract_public_api(old, old_path.to_str().unwrap())
    new_api :: extract_public_api(new, new_path.to_str().unwrap())
    report :: old_api.iter().find((item) -> item.name == "files.report").expect("inline module function is public API")
    assert(report.signature.contains("-[IO]>"), "{report.signature}")
    assert(old_api.iter().any((item) -> item.name == "bench.report"))
    assert_eq(diff_public_api(&old_api, &new_api).len(), 1)
    _ :: fs.remove_dir_all(&dir)
}

// Rust: tests/pkg.rs:6136
#Test("v2_snapshot_upgrade_matches_duplicate_inline_leaves") {
    dir :: tmp_dir("v2_inline_api_upgrade")
    path :: dir.join("current.jet")
    source :: "module bench { pub fn report() {} }\nmodule files { pub fn report(x: Int) {} }\n"
    fs.write(&path, source).unwrap()
    current := extract_public_api(source, path.to_str().unwrap()).into_iter().filter((item) -> item.kind == "fn").collect()
    for item in &current {
        item.name = legacy_api_name(&item.name).to_string()
        item.signature = legacy_api_signature(&item.signature)
    }
    previous :: ApiSnapshot.parse("api_version = 2\npackage = demo\npublished_version = 1.0.0\nfn report()\nfn report(x: Int (a whole number))\n").expect("v2 snapshot")
    old := previous.funcs.iter().map((function) -> ApiItem { kind: "fn", name: function.name.clone(), signature: function.signature.clone() }).collect()
    for item in &old {
        item.name = legacy_api_name(&item.name).to_string()
        item.signature = legacy_api_signature(&item.signature)
    }
    assert(diff_public_api(&old, &current).is_empty(), "old={old:#?}\ncurrent={current:#?}")
    _ :: fs.remove_dir_all(&dir)
}

