    breaking :: diff_public_api(&old, &new)
    assert(!breaking.is_empty())
    bump :: classify_bump(&SemVer.parse("1.0.0").unwrap(), &SemVer.parse("1.1.0").unwrap())
    assert_eq(bump, BumpKind.Minor)
    d :: e1218("1.0.0", "1.1.0", bump, &breaking[0], 2)
