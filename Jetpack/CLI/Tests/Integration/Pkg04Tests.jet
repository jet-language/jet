#Test("resolver_conflict_e2602") {
    constraints :: [VersionConstraint { package: "log", req: VersionReq.parse("^1.0").unwrap(), from: "web-server 2.1.0" },
        VersionConstraint { package: "log", req: VersionReq.parse("^2.0").unwrap(), from: "db-client 3.0.0" }]
    diags :: check_conflicts(&constraints, &[:])
    assert(!diags.is_empty(), "disjoint major caret ranges must be a conflict")
    assert_eq(diags[0].code, "E2602")
    why :: &diags[0].why
