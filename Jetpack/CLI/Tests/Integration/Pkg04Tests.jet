// Rust: tests/pkg.rs:6518
#Test("audit_e2603_on_vulnerable_dep") {
    lock :: make_test_lock("crypto-lib", "0.9.0", "sha256-aabb")
    advisories :: [Advisory { id: "JET-2026-SEC-001", package: "crypto-lib", affected: VersionReq.parse("^0").unwrap(),
        fixed: Some(SemVer.parse("0.9.5").unwrap()), title: "Timing side-channel in AES-GCM", severity: Severity.Critical }]
    matches :: audit_lockfile(&lock, &advisories).unwrap()
    assert_eq(matches.len(), 1, "one advisory match expected")
    d :: &matches[0].diagnostic
    assert_eq(d.code, "E2603")
    assert(d.what.contains("JET-2026-SEC-001"))
    assert(d.what.contains("crypto-lib"))
    assert(d.what.contains("Timing side-channel"))
    assert(d.what.contains("[critical]"), "severity must prefix the message")
    assert_eq(matches[0].severity, Severity.Critical)
}

// Rust: tests/pkg.rs:6549
