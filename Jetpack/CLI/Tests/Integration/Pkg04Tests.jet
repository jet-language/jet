// Rust: tests/pkg.rs:5515
#Test("unsupported_authority_reports_a_host_recovery") {
    diagnostic :: Authority.AuthorityError.Unsupported("descriptor-relative no-follow authority is unavailable on this platform").diagnostic()
    assert_eq(diagnostic.code, "E1334")
    assert(diagnostic.what.contains("unavailable on this platform"))
    assert(diagnostic.why.contains("descriptor-relative no-follow"))
    assert(diagnostic.fix.contains("use a platform"))
}

// Rust: tests/pkg.rs:5528
#Test("cli_run_authority_failure_offers_specific_recovery") {
    if selected_family() != "unix" { return }
    tmp :: tmp_dir("cli_run_authority_recovery")
    store :: tmp.join("store")
    fs.create_dir_all(&store).unwrap()
    write(&tmp, "package.jet", &min_manifest("authority", "0.1.0"))
    write(&tmp, "real.jet", "fn run() { print(\"real\") }\n")
    symlink("real.jet", tmp.join("run.jet")).unwrap()
    out :: jet_cmd(&["run"], &tmp, &store)
    assert(!out.status.success())
    stderr :: String.from_utf8_lossy(&out.stderr)
    assert(stderr.contains("Error [E1334]:"), "{stderr}")
    assert(stderr.contains("run.jet") && stderr.contains("symlink"), "{stderr}")
    assert(stderr.contains("replace the symlink with the expected regular file"), "{stderr}")
    fs.remove_dir_all(&tmp).unwrap()
}

// Rust: tests/pkg.rs:5555
#Test("cli_build_sbom_writes_spdx") {
    if !jet_bin().is_file() { eprintln("note: skipping cli_build_sbom (run `cargo build` first)"); return }
    tmp :: tmp_dir("cli_build_sbom")
    store :: tmp.join("store")
    fs.create_dir_all(&store).unwrap()
    write(&tmp, "hello.jet", "fn run() { print(\"hi\") }\n")
    out :: jet_cmd(&["build", "--sbom", "hello.jet"], &tmp, &store)
    stdout :: String.from_utf8_lossy(&out.stdout)
    assert(out.status.success(), "jet build --sbom failed:\n{String.from_utf8_lossy(&out.stderr)}")
    assert(stdout.contains("sbom:"), "build output must announce the SBOM path")
    spdx :: tmp.join(".jet/build/hello.spdx")
    assert(spdx.is_file(), "expected SBOM at {spdx.display()}")
    body :: fs.read_to_string(&spdx).unwrap()
    assert(body.starts_with("SPDXVersion: SPDX-2.3\n"), "SBOM must be SPDX 2.3")
    _ :: fs.remove_dir_all(&tmp)
}

// Rust: tests/pkg.rs:5591
#Test("cli_vendor_dir_flag_relocates") {
    if !jet_bin().is_file() || !have_git() { eprintln("note: skipping cli_vendor_dir (need built binary)"); return }
    tmp :: tmp_dir("cli_vendor_dir")
    store :: tmp.join("store")
    fs.create_dir_all(&store).unwrap()
    write(&tmp, "greeter/package.jet", &min_manifest("greeter", "0.1.0"))
    write(&tmp, "greeter/greeter.jet", "pub fn greet() -> String { return \"hi\" }\n")
    write(&tmp, "package.jet", &manifest_with_deps("app", "0.1.0", "    greeter: ./greeter,"))
    out :: jet_cmd(&["registry", "vendor", "--vendor-dir", "third_party"], &tmp, &store)
    assert(out.status.success(), "jet registry vendor --vendor-dir failed:\n{String.from_utf8_lossy(&out.stderr)}")
    assert(tmp.join("third_party/greeter").is_dir(), "dep must land in the chosen dir")
    assert(tmp.join("third_party/manifest.json").is_file(), "vendor manifest must be written")
    assert(!tmp.join("vendor").exists(), "default vendor/ must not be created")
    _ :: fs.remove_dir_all(&tmp)
}

