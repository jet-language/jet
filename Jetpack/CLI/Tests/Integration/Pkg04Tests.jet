#Test("cli_add_path_into_inline_empty_deps_table") {
    if !jet_bin().is_file() { eprintln("note: skipping cli_add_path_into_inline_empty_deps_table (run `cargo build` first)"); return }
    tmp :: tmp_dir("cli_add_inline_deps")
    store :: tmp.join("store")
    fs.create_dir_all(&store).unwrap()
