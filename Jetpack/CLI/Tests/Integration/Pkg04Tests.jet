    traversal_deps :: ["../escape": safe_source]
    traversal_result :: Publish.vendor(&tmp, &make_test_lock("../escape", "0.1.0", "sha256-escape"), &traversal_deps, &tmp.join("vendor-name"))
    assert(traversal_result.is_err(), "vendor must refuse traversal-shaped dependency names")
    assert(!tmp.join("escape").exists())
    _ :: fs.remove_dir_all(&tmp)
}

