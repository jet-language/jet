    lib :: tmp.join("mylib")
    write(&lib, "package.jet", &min_manifest("mylib", "0.1.0"))
    write(&lib, "mylib.jet", "pub fn answer() -> Int { return 42 }\n")
    out :: jet_cmd(&["add", "mylib", "--path", "./mylib"], &tmp, &store)
    assert(out.status.success(), "jet add --path failed:\n{String.from_utf8_lossy(&out.stderr)}")
