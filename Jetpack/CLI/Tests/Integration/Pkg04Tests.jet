    fetch :: jet_cmd(&["fetch"], &tmp, &store)
    assert(fetch.status.success(), "fetch after add failed:\n{String.from_utf8_lossy(&fetch.stderr)}")
    _ :: fs.remove_dir_all(&tmp)
}

// Rust: tests/pkg.rs:5754
#Test("cli_remove_absent_dependency_is_an_error") {
    if !jet_bin().is_file() { eprintln("note: skipping cli_remove_absent_dependency_is_an_error (run `cargo build` first)"); return }
    tmp :: tmp_dir("cli_remove_absent")
    store :: tmp.join("store")
    fs.create_dir_all(&store).unwrap()
    manifest_path :: tmp.join("package.jet")
    before :: min_manifest("app", "0.1.0")
    write(&tmp, "package.jet", &before)
    out :: jet_cmd(&["remove", "json"], &tmp, &store)
    stderr :: String.from_utf8_lossy(&out.stderr)
    stdout :: String.from_utf8_lossy(&out.stdout)
    assert(!out.status.success(), "absent dependency removal must fail")
    assert(stderr.contains("json") && stderr.contains("not present"), "missing absent-dep diagnostic:\n{stderr}")
    assert(!stdout.contains("removed") && !stdout.contains("fetched"), "false success output:\n{stdout}")
    assert_eq(fs.read_to_string(manifest_path).unwrap(), before)
    _ :: fs.remove_dir_all(&tmp)
}

// Rust: tests/pkg.rs:5787
#Test("cli_corrupt_manifest_has_one_diagnostic_across_package_commands") {
    if !jet_bin().is_file() { eprintln("note: skipping cli_corrupt_manifest_has_one_diagnostic_across_package_commands (run `cargo build` first)"); return }
    tmp :: tmp_dir("cli_corrupt_manifest")
    store :: tmp.join("store")
    fs.create_dir_all(&store).unwrap()
    write(&tmp, "package.jet", &(min_manifest("app", "0.1.0") + "\ndeps: {\n}\nunknown: ../broken,\n"))
    write(&tmp, "run.jet", "fn run() { print(\"hi\") }\n")
    lib :: tmp.join("mylib")
    write(&lib, "package.jet", &min_manifest("mylib", "0.1.0"))
    outputs :: [jet_cmd(&["fetch"], &tmp, &store), jet_cmd(&["build", "run.jet"], &tmp, &store),
        jet_cmd(&["add", "mylib", "--path", "./mylib"], &tmp, &store)]
    lines: [String] :: outputs.iter().map((out) -> {
        assert(!out.status.success(), "corrupt manifest command unexpectedly succeeded")
        String.from_utf8_lossy(&out.stderr).lines().find((line) -> line.starts_with("Error [E1206]:")).unwrap_or("").to_string()
    }).collect()
    assert(lines.iter().all((line) -> !line.is_empty()), "missing E1206 diagnosis: {lines:?}")
    assert(lines.windows(2).all((pair) -> pair[0] == pair[1]), "inconsistent diagnostics: {lines:?}")
    _ :: fs.remove_dir_all(&tmp)
}

// Rust: tests/pkg.rs:5841
#Test("semver_break_e2601") {
    old_api :: [ApiItem { kind: "fn", name: "parse", signature: "fn parse(raw: String) -> Int" }]
    new_api: [ApiItem] :: []
    changes :: diff_public_api(&old_api, &new_api)
    assert(!changes.is_empty(), "removed pub fn must be a breaking change")
    diag :: e2601("1.2.0", BumpKind.Minor, &changes[0], 2)
    assert_eq(diag.code, "E2601")
    assert(diag.what.contains("1.2.0"), "what must name the version")
    assert(diag.why.contains("minor"), "why must name the bump kind")
    assert(diag.fix.contains("2.0.0"), "fix must name the next major")
    assert(diag.why.contains("parse") || diag.why.contains("removed"), "why must name the broken item or action")
}

// Rust: tests/pkg.rs:5870
#Test("returned_view_source_union_change_feeds_e1218_and_e2601") {
    item :: (source: &String) -> ApiItem { kind: "fn", name: "pick",
        signature: "fn pick(left: [Int], right: [Int]) -> View<Int> ; view_source = {source}" }
    changes :: diff_public_api(&[item("parameter:0;access:read;path:range")],
        &[item("one_of(parameter:0;path:range,parameter:1;path:range);access:read")])
    assert_eq(changes.len(), 1, "adding a possible owner to a source union must be breaking")
    assert(changes[0].description.contains("parameter:0"))
    assert(changes[0].description.contains("parameter:1"))
    bump :: classify_bump(&SemVer.parse("1.0.0").unwrap(), &SemVer.parse("1.1.0").unwrap())
    assert_eq(bump, BumpKind.Minor)
    assert_eq(e1218("1.0.0", "1.1.0", bump, &changes[0], 2).code, "E1218")
    assert_eq(e2601("1.1.0", bump, &changes[0], 2).code, "E2601")
}

// Rust: tests/pkg.rs:5903
#Test("capability_sigil_frozen_in_public_api") {
    dir :: tmp_dir("cap_api_freeze")
    write_src :: "struct Account { balance: Int }\npub fn deposit(a: &Account, amount: Int) -> Int {\n    a.balance = a.balance + amount\n    return a.balance\n}\n"
    f :: dir.join("write.jet")
    fs.write(&f, write_src).unwrap()
    write_api :: extract_public_api(write_src, f.to_str().unwrap())
    deposit :: write_api.iter().find((i) -> i.name == "deposit").expect("deposit must be in the public API")
    assert(deposit.signature.contains("a: &"), "the write sigil must be frozen onto the param type in the published signature, got `{deposit.signature}`")
    read_src :: "struct Account { balance: Int }\npub fn deposit(a: Account, amount: Int) -> Int { return a.balance + amount }\n"
    f2 :: dir.join("read.jet")
    fs.write(&f2, read_src).unwrap()
    read_api :: extract_public_api(read_src, f2.to_str().unwrap())
    changes :: diff_public_api(&read_api, &write_api)
    assert(!changes.is_empty(), "a read -> write capability drift on a pub fn must be a breaking change")
    _ :: fs.remove_dir_all(&dir)
}

