#Test("vendored_offline_locked_build") {
    tmp :: tmp_dir("m8_vendor_locked")
    store :: tmp.join("store")
    fs.create_dir_all(&store).unwrap()
    write(&tmp, "greeter/package.jet", &min_manifest("greeter", "0.1.0"))
    write(&tmp, "greeter/greeter.jet", "pub fn greet() -> String { return \"hi\" }\n")
    write(&tmp, "package.jet", &manifest_with_deps("vendored_app", "0.1.0", "    greeter: ./greeter,"))
    write(&tmp, "run.jet", "use greeter\nfn run() { print(greeter.greet()) }\n")
    entry :: tmp.join("run.jet")
    pack_path :: tmp.join("package.jet")
    mf :: Manifest.parse(&pack_path, &fs.read_to_string(&pack_path).unwrap()).unwrap()
    opts :: Fetch.FetchOptions { locked: false, update: false, update_dep: None, resolution: ResolveMode.Conservative }
    result :: with_store(&store, () -> Fetch.fetch(&tmp, &mf, None, &opts))
    assert(result.is_ok(), "initial fetch must succeed")
    (lock, dep_dirs) :: result.unwrap()
    vendor_dir :: tmp.join("vendor")
    vendor_result :: Publish.vendor(&tmp, &lock, &dep_dirs, &vendor_dir)
    assert(vendor_result.is_ok(), "vendor must succeed")
    copied :: vendor_result.unwrap()
    assert(copied.contains("greeter"), "greeter must be vendored")
    assert(tmp.join("vendor/greeter").is_dir(), "vendor/greeter must exist")
    manifest :: fs.read_to_string(tmp.join("vendor/manifest.json")).unwrap()
    assert(manifest.contains("\"name\": \"greeter\""), "manifest must list greeter")
    assert(manifest.contains("\"fingerprint\""), "manifest must record fingerprints")
    lock_text :: fs.read_to_string(tmp.join(".jet/lock")).unwrap_or_default()
    assert(!lock_text.is_empty(), "lock file must exist after fetch")
    compile_result :: with_store(&store, () -> compile_with_path("", &entry.to_string_lossy()))
    assert(compile_result.is_ok(), "vendored project must compile offline")
    _ :: fs.remove_dir_all(&tmp)
}

