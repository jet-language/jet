#Test("physical_unit_trait_methods_use_canonical_dimensions") {
    dir :: tmp_dir("physical_unit_trait_api")
    path :: dir.join("current.jet")
    // Bare Meter uses the canonical Prelude family, not a local nominal shadow.
    source :: "pub trait Measure { fn scale(value: Meter) -> Meter }\n"
    fs.write(&path, source).unwrap()
    api :: extract_public_api(source, path.to_str().unwrap())
    method :: api.iter().find((item) -> item.name == "Measure.scale").expect("public trait method")
    assert_eq(method.signature, "fn Measure.scale(value: Meter{package=core.units; family=Length; base=Meter; dimension=core.units%3A%3ALength:1; scale=1; provenance=Rational; offset=0}) Meter{package=core.units; family=Length; base=Meter; dimension=core.units%3A%3ALength:1; scale=1; provenance=Rational; offset=0}")
    bundle := Loader.load_entry_with_overlay(path.to_str().unwrap(), None, true).expect("trait source bundle")
    (_, facts) :: Sema.check_bundle_with_effect_facts(&bundle, Sema.CompileMode.Check)
    entry :: &bundle.modules[bundle.entry]
    frozen :: snapshot_from_items_with_effects(&entry.items, "physics", "1.0.0", Some(&facts.solved), Some(&entry.alias))
    assert_eq(frozen.funcs.iter().find((item) -> item.name == "Measure.scale").expect("frozen public trait method").signature, method.signature)
    _ :: fs.remove_dir_all(&dir)
}

