// Rust: tests/jetpack_output.rs:63
#Test("repeated_diagnostic_uses_one_card_count_and_next_step_snapshot") {
    theme :: Output.Theme{color: false}
    actual :: theme.render_collapsed_error("E1350", "native Nix cache closure could not be admitted",
        "the same signed Nix closure failed for every requested object",
        "repair the signed cache response or restore network access, then retry the realization.", 8)
    assert_eq(actual, include_str("tests/fixtures/jetpack-diagnostics/collapsed_diagnostics.stderr"))
    assert_eq(actual.matches("Error [E1350]").count(), 1)
    assert_eq(actual.matches("Next:").count(), 1)
}

// Rust: tests/jetpack_output.rs:81
#Test("retired_off_compiler_report_renderers_do_not_return") {
    root :: OSPath.from(env.manifest_dir())
    sources := [] as [OSPath]
    rust_sources(root.join("crates/jetpack/src"), &sources)
    &sources.push(root.join("Source/CmdGc.rs"))
    retired :: ["eprintln!(\"error:", "eprintln!(\"Error [", "self.red(\"error:\")",
        "format!(\"error[{{code}}]:\")", "format!(\"warning[{{code}}]:\")", "matches the compiler's house style"]
    loop path in sources {
        source :: fs.read_to_string(path).unwrap()
        loop text in retired {
            assert(!source.contains(text), "{path.display()} restored retired report text `{text}`")
        }
    }
}

// Rust: tests/jetpack_package_outputs.rs:12
#Test("package_fleet_output_reaches_the_immutable_generation_and_retries_cleanly") {
    project :: Scratch.new("package-fleet-output")
    root :: Scratch.new("package-fleet-output-root")
    fs.write(project.path.join("package.jet"), """name: "demo"
outputs: {
    workstation: System{
        target: linux.x64
        options: { boot: { kernel: Linux }, init: { path: "/bin/init" } }
    }
    prod: Fleet{
        name: "prod"
        hosts: { edge: system.workstation }
    }
}""").unwrap()
    run :: fn() -> fixtures.jet().args(["os", "build", "workstation", "--name", "fleet-output", "--no-color", "--offline"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output().unwrap()
    first :: run()
    assert(first.status.success(), "stderr: {String.from_utf8_lossy(first.stderr)}")
    deploy_plan :: root.path.join("systems/generations/fleet-output/fleet/deploy-plan.json")
    script :: root.path.join("systems/generations/fleet-output/fleet/deploy-edge.sh")
    system_plan :: root.path.join("systems/generations/fleet-output/plan.json")
    first_plan :: fs.read_to_string(deploy_plan).unwrap()
    first_system_plan :: fs.read_to_string(system_plan).unwrap()
    assert(first_system_plan.contains("\"graph_identity\":\""))
    graph_identity :: first_system_plan.split_once("\"graph_identity\":\"")
        .and_then(fn(pair) -> pair.1.split_once('"').map(fn(part) -> part.0)).expect("system plan graph identity")
    assert(first_plan.contains("\"graph_identity\":\"{graph_identity}\""), first_plan)
    assert(first_plan.contains("\"fleet\":\"prod\""), first_plan)
    assert(first_plan.contains("\"host\":\"edge\""), first_plan)
    assert(first_plan.contains("\"system\":\"workstation\""), first_plan)
    assert(script.is_file(), "missing generated Fleet host script")
    script_text :: fs.read_to_string(script).unwrap()
    assert(script_text.contains("\"graph_identity\":\"{graph_identity}\""), script_text)
    root_proof :: fs.read_to_string(root.path.join("systems/generations/fleet-output/generation-root.json")).unwrap()
    assert(root_proof.contains("\"kind\":\"jetos.generation-root.v1\"") && root_proof.contains("\"source_proof_sha256\":\"")
        && root_proof.contains("\"files_proof_sha256\":\"") && root_proof.contains("\"witness\":\""), root_proof)
    ledger :: fs.read_to_string(root.path.join("systems/generations.log")).unwrap()
    ledger_row :: ledger.lines().find(fn(line) -> line.contains("\tfleet-output\t")).expect("generation ledger row")
    witness :: root_proof.split_once("\"witness\":\"")
        .and_then(fn(pair) -> pair.1.split_once('"').map(fn(part) -> part.0)).expect("generation root witness")
    assert(ledger_row.ends_with("\t{witness}"), ledger)
    second :: run()
    assert(second.status.success(), "retry stderr: {String.from_utf8_lossy(second.stderr)}")
    assert_eq(fs.read_to_string(deploy_plan).unwrap(), first_plan)
    assert_eq(fs.read_to_string(system_plan).unwrap(), first_system_plan)
}

