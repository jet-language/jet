// Rust: tests/jetpack_platform.rs:20
#Test("platform_tier_audit_contract_names_linux_macos_windows") {
    assert_eq(Platform.TIER_ONE_OSES, [Platform.OS_LINUX, Platform.OS_MACOS, Platform.OS_WINDOWS])
    loop arch in Platform.TIER_ONE_ARCHES {
        loop os in Platform.TIER_ONE_OSES {
            key :: Platform.PlatformKey.new(arch, os).unwrap()
            assert(key.is_tier_one())
            assert_eq(key.envelope_key(), "{arch}-{os}")
        }
    }
    host :: Platform.PlatformKey.host()
    assert(host.is_tier_one(), "the current CI host is outside Jetpack's tier-1 matrix: {host.envelope_key()}")
    assert_eq(Platform.host_key(), host.envelope_key())
    assert(Platform.PlatformKey.new("riscv64", Platform.OS_LINUX).is_none())
    assert(Platform.PlatformKey.new(Platform.ARCH_X64, "freebsd").is_none())
    assert_eq(Platform.exe_suffix_for_os(Platform.OS_WINDOWS), ".exe")
    assert_eq(Platform.path_separator_for_os(Platform.OS_WINDOWS), ';')
    assert_eq(Platform.path_separator_for_os(Platform.OS_LINUX), ':')
    assert_eq(Platform.path_separator_for_os(Platform.OS_MACOS), ':')
}

// Rust: tests/jetpack_platform.rs:53
#Test("platform_tier_gate_runs_native_package_offline_and_cleans_store") {
    if selected_os() != "linux" { return }
    root :: Scratch.new("platform-gate-root")
    fixture_dir :: Scratch.new("platform-gate-fixtures")
    staging :: Scratch.new("platform-gate-staging")
    missing_tools :: Scratch.new("platform-gate-missing-tools")
    fixtures.write_native_jetpack_fixture(fixture_dir.path, root.path, staging.path)
    program :: "jetpack{Platform.exe_suffix_for_os(selected_os())}"
    run :: jetpack().args(["use", "native-jetpack@nixpkgs", "--no-color", "--offline", "--", program, "--help"])
        .env("JETPACK_ROOT", root.path).env("JETPACK_FIXTURES", fixture_dir.path).env("PATH", missing_tools.path).output().unwrap()
    assert(run.status.success(), "stderr: {String.from_utf8_lossy(run.stderr)}")
    assert(String.from_utf8_lossy(run.stdout).contains("jetpack"), "native package did not run: {String.from_utf8_lossy(run.stdout)}")
    stale :: fixtures.write_hangar_meta(root.path, "platform-stale", "platform-stale", "1.0", Some(1)).0
    clean :: jetpack().args(["hangar", "clean", "--no-color", "--yes"])
        .env("JETPACK_ROOT", root.path).env("PATH", missing_tools.path).output().unwrap()
    assert(clean.status.success(), "stderr: {String.from_utf8_lossy(clean.stderr)}")
    assert(!stale.exists(), "production clean left stale platform state")
}

// Rust: tests/jetpack_platform.rs:114
#Test("platform_tier_gate_accepts_data_only_output_without_executable_service") {
    if selected_os() == "linux" { return }
    base :: Scratch.new("platform-data-only")
    repo :: base.path.join("jet-pkgs")
    project :: base.path.join("project")
    root :: base.path.join("root")
    package :: repo.join("lib/mathlib")
    fs.create_dir_all(package).unwrap()
    fs.create_dir_all(project).unwrap()
    fs.write(repo.join("package.jet"), "name: \"jet-pkgs\"\nversion: \"0.1.0\"\npackages: {\n    mathlib: library,\n}\n").unwrap()
    fs.write(package.join("mathlib.jet"), "module mathlib {\n    pub fn add(a: Int, b: Int) -> Int { return a + b }\n}\n").unwrap()
    fs.write(project.join("env.jet"), "module dev {{\n    sources: {{ mine: {repo.to_string_lossy()} }}\n    env.dev: Env{{\n        packages: [mine.mathlib],\n    }}\n}}\n").unwrap()
    output :: jetpack().args(["build", "--no-color"]).current_dir(project).env("JETPACK_ROOT", root)
        .env("PATH", "/usr/bin:/bin").output().unwrap()
    assert(output.status.success(), "data-only realization failed: {String.from_utf8_lossy(output.stderr)}")
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("built 1 package(s)"), "expected one data-only package, got: {stderr}")
    assert(fs.read_dir(root.join("leases")).map(fn(entries) -> entries.flatten().next().is_none()).unwrap_or(true),
        "data-only realization left a lease container")
    assert(fs.read_dir(root.join("lease-service/leases")).map(fn(entries) -> entries.flatten().next().is_none()).unwrap_or(true),
        "data-only realization left an authenticated lease record")
}

// Rust: tests/jetpack_platform.rs:177
#Test("platform_gate_reaches_store_authenticated_lease_service") {
    if selected_os() != "linux" { return }
    root :: Scratch.new("platform-authenticated-lease-root")
    fixture_dir :: Scratch.new("platform-authenticated-lease-fixtures")
    staging :: Scratch.new("platform-authenticated-lease-staging")
    missing_tools :: Scratch.new("platform-authenticated-lease-missing-tools")
    fixtures.write_native_jetpack_fixture(fixture_dir.path, root.path, staging.path)
    program :: "omp{Platform.exe_suffix_for_os(selected_os())}"
    run := jetpack().args(["use", "omp@releases#1.0.0", "-y", "--no-color", "--offline", "--fixtures"])
        .arg(fixture_dir.path).args(["--", program, "--hold"]).env("JETPACK_ROOT", root.path)
        .env("JETPACK_FIXTURES", fixture_dir.path).env("PATH", missing_tools.path).spawn().unwrap()
    records :: root.path.join("lease-service/leases")
    deadline :: Instant.now() + Duration.from_secs(5)
    found := None as (OSPath, String)?
    loop {
        if fs.read_dir(records).ok() is Some(entries) {
            loop entry in entries.flatten() {
                generation :: entry.path().join("generations/1")
                receipt :: generation.join("receipt")
                complete :: generation.join("complete")
                if receipt.is_file() && complete.is_file() {
                    if fs.read_to_string(receipt).ok() is Some(contents) {
                        found = Some((entry.path(), contents))
                        break
                    }
                }
            }
        }
        if found.is_some() || Instant.now() >= deadline { break }
        thread.sleep(Duration.from_millis(10))
    }
    if found.is_none() {
        _ :: &run.kill()
        output :: &run.wait_with_output().unwrap()
        panic("production run did not publish a complete authenticated lease receipt: {String.from_utf8_lossy(output.stderr)}")
    }
    (record, receipt) :: found.unwrap()
    assert(receipt.starts_with("JET-EXECUTABLE-LEASE/1 receipt\n"))
    assert(receipt.contains("\ngeneration=1\n"), "receipt: {receipt}")
    mac :: receipt.lines().find_map(fn(line) -> line.strip_prefix("mac=")).expect("authenticated lease receipt tag")
    assert_eq(mac.len(), 64)
    assert(mac.bytes().all(fn(byte) -> byte.is_ascii_hexdigit()))
    witness :: fs.read_to_string(record.join("generations/1/complete")).unwrap()
    assert_eq(witness.trim().len(), 71)
    assert(witness.trim().starts_with("sha256-"))
    recover :: jetpack().args(["hangar", "recover", "--no-color"]).env("JETPACK_ROOT", root.path)
        .env("PATH", missing_tools.path).output().unwrap()
    assert(recover.status.success(), "stderr: {String.from_utf8_lossy(recover.stderr)}")
    assert(record.join("generations/1/receipt").is_file(), "recovery removed a live authenticated lease")
    run_output :: &run.wait_with_output().unwrap()
    assert(run_output.status.success(), "stderr: {String.from_utf8_lossy(run_output.stderr)}")
    recover_after_exit :: jetpack().args(["hangar", "recover", "--no-color"]).env("JETPACK_ROOT", root.path)
        .env("PATH", missing_tools.path).output().unwrap()
    assert(recover_after_exit.status.success(), "stderr: {String.from_utf8_lossy(recover_after_exit.stderr)}")
    assert(fs.read_dir(records).map(fn(entries) -> entries.flatten().next().is_none()).unwrap_or(true),
        "idle authenticated lease record survived recovery")
}

// Rust: tests/jetpack_platform.rs:286
#Test("platform_tier_gate_recovers_hostile_partial_lease_without_losing_good_output") {
    root :: Scratch.new("platform-hostile-lease-root")
    fixture_dir :: Scratch.new("platform-hostile-lease-fixtures")
    staging :: Scratch.new("platform-hostile-lease-staging")
    missing_tools :: Scratch.new("platform-hostile-lease-missing-tools")
    fixtures.write_native_jetpack_fixture(fixture_dir.path, root.path, staging.path)
    (good_object, _) :: fixtures.write_hangar_meta(root.path, "platform-hostile-good", "platform-hostile-good", "1.0", None)
    interrupted :: root.path.join("leases").join("4294967294-1-platform-hostile-good")
    fs.create_dir_all(interrupted.join("snapshot/bin")).unwrap()
    fs.write(interrupted.join("snapshot/bin/partial"), "interrupted").unwrap()
    recover :: jetpack().args(["hangar", "recover", "--no-color"]).env("JETPACK_ROOT", root.path)
        .env("JETPACK_FIXTURES", fixture_dir.path).env("PATH", missing_tools.path).output().unwrap()
    assert(recover.status.success(), "stderr: {String.from_utf8_lossy(recover.stderr)}")
    assert(!interrupted.exists(), "recovery left an interrupted hostile lease")
    assert(good_object.join("meta.json").is_file(), "recovery removed the last good Hangar object")
}

// Rust: tests/jetpack_platform.rs:329
#Test("platform_tier_gate_exercises_native_lease_diagnostics_and_audit") {
    if selected_os() != "linux" { return }
    root :: Scratch.new("platform-diagnostics-root")
    fixture_dir :: Scratch.new("platform-diagnostics-fixtures")
    staging :: Scratch.new("platform-diagnostics-staging")
    missing_tools :: Scratch.new("platform-diagnostics-missing-tools")
    fixtures.write_native_jetpack_fixture(fixture_dir.path, root.path, staging.path)
    program :: "omp{Platform.exe_suffix_for_os(selected_os())}"
    run :: jetpack().args(["use", "omp@releases#1.0.0", "--no-color", "--offline", "--", program, "--help"])
        .env("JETPACK_ROOT", root.path).env("JETPACK_FIXTURES", fixture_dir.path).env("PATH", missing_tools.path).output().unwrap()
    assert(run.status.success(), "native lease handoff failed: {String.from_utf8_lossy(run.stderr)}")
    assert(String.from_utf8_lossy(run.stdout).contains("jetpack"), "native lease child did not run: {String.from_utf8_lossy(run.stdout)}")
    assert(fs.read_dir(root.path.join("leases")).unwrap().next().is_none(), "production child exit left an executable lease behind")
    (good_object, _) :: fixtures.write_hangar_meta(root.path, "platform-diagnostics-good", "platform-diagnostics-good", "1.0", None)
    stale :: root.path.join("leases").join("4294967294-1-platform-diagnostics-good")
    fs.create_dir_all(stale.join("snapshot")).unwrap()
    fs.write(stale.join("snapshot/partial"), "interrupted").unwrap()
    doctor :: jetpack().args(["doctor", "--json", "--offline"]).env("JETPACK_ROOT", root.path).output().unwrap()
    doctor_json :: String.from_utf8_lossy(doctor.stdout)
    assert(doctor_json.contains("stale executable lease(s) found"), "doctor missed stale lease: {doctor_json}")
    assert(stale.is_dir(), "doctor changed lease state")
    audit :: jetpack().args(["audit", "--no-color"]).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(audit.status.success(), "audit stderr: {String.from_utf8_lossy(audit.stderr)}")
    audit_text :: String.from_utf8_lossy(audit.stderr)
    assert(audit_text.contains("Leases:"), "audit omitted lease state")
    assert(audit_text.contains("0 active, 1 stale"), "audit missed stale lease: {audit_text}")
    journal :: root.path.join("hangar/closure-db/journal")
    fs.create_dir_all(journal).unwrap()
    partial :: journal.join("00000000000000000099-corrupt.txn.partial")
    fs.write(partial, "interrupted").unwrap()
    broken :: jetpack().args(["audit", "--no-color"]).env("JETPACK_ROOT", root.path).output().unwrap()
    assert_eq(broken.status.code(), Some(2))
    broken_text :: String.from_utf8_lossy(broken.stderr)
    assert(broken_text.contains("Error [E1340]:"), broken_text)
    assert(broken_text.contains("Why:"), broken_text)
    assert(broken_text.contains("Fix:"), broken_text)
    assert(broken_text.contains("More: jet-lang.dev/e/E1340"), broken_text)
    assert(partial.is_file(), "audit repaired partial journal")
    assert(good_object.join("meta.json").is_file())
    fs.remove_file(partial).unwrap()
    recover :: jetpack().args(["hangar", "recover", "--no-color"]).env("JETPACK_ROOT", root.path)
        .env("PATH", missing_tools.path).output().unwrap()
    assert(recover.status.success(), "lease recovery stderr: {String.from_utf8_lossy(recover.stderr)}")
    assert(!stale.exists(), "production recovery left stale lease")
    assert(good_object.join("meta.json").is_file(), "production recovery removed the last good Hangar object")
}

// Rust: tests/jetpack_platform.rs:452
#Test("platform_store_lease_projection_rejects_invalid_identity_in_doctor_and_audit") {
    root :: Scratch.new("platform-invalid-lease-identity")
    malformed :: root.path.join("leases").join("not-a-lease")
    fs.create_dir_all(malformed).unwrap()
    doctor :: jetpack().args(["doctor", "--json", "--offline"]).env("JETPACK_ROOT", root.path).output().unwrap()
    assert_eq(doctor.status.code(), Some(2))
    doctor_json :: String.from_utf8_lossy(doctor.stdout)
    assert(doctor_json.contains("\"name\":\"leases\""), doctor_json)
    assert(doctor_json.contains("\"status\":\"broken\""), doctor_json)
    assert(doctor_json.contains("invalid identity"), doctor_json)
    audit :: jetpack().args(["audit", "--no-color"]).env("JETPACK_ROOT", root.path).output().unwrap()
    assert_eq(audit.status.code(), Some(2))
    audit_stderr :: String.from_utf8_lossy(audit.stderr)
    assert(audit_stderr.contains("Error [E1340]:"), audit_stderr)
    assert(audit_stderr.contains("invalid identity"), audit_stderr)
    assert(audit_stderr.contains("More: jet-lang.dev/e/E1340"), audit_stderr)
    assert(malformed.is_dir(), "diagnostics mutated the lease projection")
}

// Rust: tests/jetpack_platform.rs:484
#Test("audit_reports_stale_executable_lease_golden") {
    root :: Scratch.new("audit-stale-lease-golden")
    stale :: root.path.join("leases").join("4294967294-1-audit-stale")
    fs.create_dir_all(stale.join("snapshot")).unwrap()
    fs.write(stale.join("snapshot/partial"), "interrupted").unwrap()
    audit :: jetpack().args(["audit", "--no-color"]).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(audit.status.success(), "audit stderr: {String.from_utf8_lossy(audit.stderr)}")
    audit_text :: String.from_utf8_lossy(audit.stderr)
    lease_lines :: audit_text.lines().filter(fn(line) -> line.contains("Leases:") || line.contains("Lease Note:")).collect().join("\n")
    assert_eq("{lease_lines}\n", include_str("tests/cli/jetpack_audit_stale_lease.txt"))
    assert(stale.is_dir(), "audit repaired stale lease state")
}

// Rust: tests/jetpack_platform.rs:514
#Test("platform_tier_gate_reports_missing_offline_component") {
    root :: Scratch.new("platform-failure-root")
    fixture_dir :: Scratch.new("platform-failure-fixtures")
    missing_tools :: Scratch.new("platform-failure-missing-tools")
    missing :: root.path.join("missing-component-output")
    fs.create_dir_all(fixture_dir.path).unwrap()
    fs.write(fixture_dir.path.join("nixpkgs-native-jetpack.json"),
        "[{{\"drvPath\":\"/nix/store/0fixture-native-jetpack.drv\",\"outputs\":{{\"out\":{missing.to_string_lossy():?}}}}}]").unwrap()
    output :: jetpack().args(["build", "native-jetpack@nixpkgs", "--no-color", "--offline"])
        .env("JETPACK_ROOT", root.path).env("JETPACK_FIXTURES", fixture_dir.path).env("PATH", missing_tools.path).output().unwrap()
    assert(!output.status.success())
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("Error [E1315]:"), "stderr: {stderr}")
    assert(stderr.contains("does not exist"), "stderr: {stderr}")
    fixtures.assert_no_hangar_entry(root.path, "native-jetpack-")
}
