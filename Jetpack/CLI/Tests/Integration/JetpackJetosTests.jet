// Rust: tests/jetpack_jetos.rs:488
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("os_build_realizes_selected_system_offline") {
    root :: Scratch.new("os-build-root")
    run :: () -> {
        jet().args(["os", "build", "halcyon", "--name", "fixture-source-built", "--no-color", "--offline"])
            .current_dir(config_example_dir()).env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("build selected system")
    }
    out :: run()
    assert(out.status.success(), "stderr: {String.from_utf8_lossy(out.stderr)}")
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.lines().any((line) -> line.contains("building system") && line.contains(" -> hello · resolving") && !line.contains(TEXT_ESC)), "plain jetos build must project its real package edge without ANSI: {stderr}")
    loop pkg in [String]{"hello", "btop"} { assert(stderr.contains(pkg), "expected `{pkg}` in output: {stderr}") }
    assert(stderr.contains("halcyon"), "stderr: {stderr}")
    assert(stderr.contains("generation"), "stderr: {stderr}")
    lifecycle_before_retry :: lifecycle_bytes(&root.path)
    cached :: run()
    assert(cached.status.success(), "cached generation stderr: {String.from_utf8_lossy(cached.stderr)}")
    assert(String.from_utf8_lossy(cached.stderr).contains("cached"), "exact retry must rebuild a candidate from resolved cached outputs: {String.from_utf8_lossy(cached.stderr)}")
    assert_eq(lifecycle_bytes(&root.path), lifecycle_before_retry, "exact committed retry must change zero lifecycle bytes")
    assert(root.join("systems").is_dir(), "expected a systems dir under the root")
    generation :: root.join("systems/generations/fixture-source-built")
    root_proof :: fs.read_to_string(generation.join("generation-root.json")) ?? panic("read root proof")
    assert(root_proof.contains("\"kind\":\"jetos.generation-root.v1\"") && root_proof.contains("\"source_proof_sha256\":\"") && root_proof.contains("\"files_proof_sha256\":\"") && root_proof.contains("\"output_digests\":[\"sha256-"), "generation root must bind complete source/files proof and Hangar digests: {root_proof}")
    assert(!(fs.read(generation.join("generation-files.proof")) ?? panic("files proof")).is_empty(), "generation files proof must be durable before ledger publication")
    ledger :: fs.read_to_string(root.join("systems/generations.log")) ?? panic("ledger")
    assert_eq(ledger.lines().filter((line) -> line.contains("\tfixture-source-built\t")).count(), 1, "exact retry must not duplicate a generation ledger row")
    root_json :: JSON.parse(&root_proof) ?? panic("root JSON")
    witness :: (root_json.get("witness") ?? panic("witness")).as_str() ?? panic("witness text")
    targets :: ((root_json.get("output_digests") ?? panic("digests")).as_array() ?? panic("digests array")).iter().map((value) -> (value.as_str() ?? panic("digest text")).to_string()).collect()
    fields :: ledger.trim_end().split('\t').collect()
    assert_eq(fields.len(), 5, "ledger must contain witness field: {ledger}")
    assert_eq(fields[4], witness, "ledger witness must equal generation root")
    assert_eq(lifecycle_roots(&root.path), [LifecycleRootProof]{LifecycleRootProof{
        kind: "external-consumer", id: "external-consumer:jetos-generation:6469c44e94fc44d3d95215983c22ae71b36e76b67d2b68600091c9e12cbdbf84",
        producer: "jetos-generation", witness: witness.to_string(), targets: targets, phase: "committed"
    }}, "effective lifecycle state must exactly match durable generation metadata")
    kernel :: fs.read_to_string(generation.join("boot/kernel")) ?? panic("kernel")
    initrd :: fs.read_to_string(generation.join("boot/initrd")) ?? panic("initrd")
    assert(kernel.contains("fixture-built cachyos kernel"), "kernel should come from source/build.sh: {kernel}")
    assert(initrd.contains("fixture-built cachyos initrd"), "initrd should come from source/build.sh: {initrd}")
    assert_no_ephemeral_links(&generation)
    hello :: Command.new(generation.join("sw/bin/hello")).output() ?? panic("run generation hello")
    assert(hello.status.success())
    assert(String.from_utf8_lossy(hello.stdout).contains("hello"), "generation-owned executable must survive lease close and FD reuse")
}

// Rust: tests/jetpack_jetos.rs:634
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("os_published_name_binds_imported_source_closure") {
    root :: Scratch.new("os-imported-closure-root")
    project :: Scratch.new("os-imported-closure-project")
    copy_dir_recursive(&config_example_dir(), &project.path)
    config :: project.join("config.jet")
    source :: (fs.read_to_string(config) ?? panic("config")).replacen("module halcyon {", "module halcyon {\n    imports: find(\"./modules\")", 1)
    fs.write(config, source) ?? panic("write source")
    fs.create_dir_all(project.join("modules")) ?? panic("modules")
    imported :: project.join("modules/extra.jet")
    fs.write(imported, "// closure revision one\nmodule extra {}\n") ?? panic("write imported")
    run :: () -> {
        jet().args(["os", "build", "halcyon", "--name", "import-bound", "--no-color", "--offline"]).current_dir(project.path)
            .env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("build import-bound")
    }
    first :: run()
    assert(first.status.success(), "stderr: {String.from_utf8_lossy(first.stderr)}")
    fs.write(imported, "// closure revision two\nmodule extra {}\n") ?? panic("change imported")
    changed :: run()
    assert_eq(changed.status.code(), Val(2))
    assert(String.from_utf8_lossy(changed.stderr).contains("already published"), "import-only change must reject immutable name: {String.from_utf8_lossy(changed.stderr)}")
}

// Rust: tests/jetpack_jetos.rs:683
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("os_zero_hangar_generation_has_ledger_without_external_root") {
    root :: Scratch.new("os-zero-hangar-root")
    project :: Scratch.new("os-zero-hangar-project")
    fs.write(project.join("config.jet"), "module empty { system.empty: { target: linux.x64, options: [ boot.kernel: .Linux, init.path: \"/bin/init\" ] } }\n") ?? panic("write empty system")
    run :: () -> {
        jet().args(["os", "build", "empty", "--name", "zero-hangar", "--no-color", "--offline"]).current_dir(project.path)
            .env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin").output() ?? panic("build empty")
    }
    first :: run()
    assert(first.status.success(), "stderr: {String.from_utf8_lossy(first.stderr)}")
    generation :: root.join("systems/generations/zero-hangar")
    root_text :: fs.read_to_string(generation.join("generation-root.json")) ?? panic("root proof")
    root_json :: JSON.parse(&root_text) ?? panic("root JSON")
    assert(((root_json.get("output_digests") ?? panic("digests")).as_array() ?? panic("digests array")).is_empty())
    witness :: (root_json.get("witness") ?? panic("witness")).as_str() ?? panic("witness text")
    ledger :: fs.read_to_string(root.join("systems/generations.log")) ?? panic("ledger")
    assert_eq(ledger.trim_end().split('\t').collect()[4], witness)
    assert(!root.join("hangar/lifecycle-db").exists(), "zero-Hangar publication must leave provider roots separate")
    retry :: run()
    assert(retry.status.success(), "stderr: {String.from_utf8_lossy(retry.stderr)}")
    assert_eq(fs.read_to_string(root.join("systems/generations.log")) ?? panic("ledger"), ledger)
    assert(!root.join("hangar/lifecycle-db").exists())
}

// Rust: tests/jetpack_jetos.rs:748
#Ignore("epoch-7 jetos suite: writes ~24G scratch under TMPDIR (card 1638); run deliberately with -- --ignored")
#Test("os_generation_recovers_prepared_root_after_durable_ledger_crash_window") {
    root :: Scratch.new("os-generation-root-recovery")
    project :: Scratch.new("os-generation-root-project")
    copy_dir_recursive(&config_example_dir(), &project.path)
    run :: (failpoint: String?) -> {
        command := jet()
        &command.args(["os", "build", "halcyon", "--name", "root-recovery", "--no-color", "--offline"]).current_dir(project.path)
            .env("JETPACK_ROOT", root.path).env("PATH", "/usr/bin:/bin")
        if failpoint == .Val(point) -> &command.env("JET_TEST_GENERATION_FAILPOINT", point)
        command.output() ?? panic("build root recovery")
    }
    loop failpoint in [String]{"after-root-prepare", "after-ledger-partial", "after-ledger-append", "after-ledger-durable", "after-ledger", "after-commit"} {
        interrupted :: run(Val(failpoint))
        assert_eq(interrupted.status.code(), Val(2), "failpoint {failpoint} did not stop publication: {String.from_utf8_lossy(interrupted.stderr)}")
        generation :: root.join("systems/generations/root-recovery")
        assert(generation.join("generation-root.json").is_file(), "{failpoint} exposed a ledger/root before the immutable directory")
    }
    recovered :: run(None)
    assert(recovered.status.success(), "stderr: {String.from_utf8_lossy(recovered.stderr)}")
    ledger :: fs.read_to_string(root.join("systems/generations.log")) ?? panic("ledger")
    assert_eq(ledger.lines().count(), 1, "recovery must reuse exact ledger row")
    assert_eq(ledger.split('\t').count(), 5, "ledger row must bind the immutable root witness: {ledger}")
    generation :: root.join("systems/generations/root-recovery")
    root_text :: fs.read_to_string(generation.join("generation-root.json")) ?? panic("root proof")
    root_json :: JSON.parse(&root_text) ?? panic("root JSON")
    witness :: (root_json.get("witness") ?? panic("witness")).as_str() ?? panic("witness text")
    targets :: ((root_json.get("output_digests") ?? panic("digests")).as_array() ?? panic("digests array")).iter().map((value) -> (value.as_str() ?? panic("digest text")).to_string()).collect()
    fields :: ledger.trim_end().split('\t').collect()
    assert_eq(fields[4], witness)
    assert_eq(lifecycle_roots(&root.path), [LifecycleRootProof]{LifecycleRootProof{
        kind: "external-consumer", id: "external-consumer:jetos-generation:d68db8f4f63784e2062f9df39019967a7fa3e06ba0026d7696d32011c62d26e7",
        producer: "jetos-generation", witness: witness.to_string(), targets: targets, phase: "committed"
    }})
    source :: project.join("config.jet")
    original_source :: fs.read(source) ?? panic("source")
    changed_source := original_source.clone()
    &changed_source.extend_from_slice("\n// changed after immutable publication\n".as_bytes())
    fs.write(source, changed_source) ?? panic("change source")
    changed :: run(None)
    assert_eq(changed.status.code(), Val(2))
    assert(String.from_utf8_lossy(changed.stderr).contains("already published"), "changed source must not replace a retained generation: {String.from_utf8_lossy(changed.stderr)}")
    fs.write(source, original_source) ?? panic("restore source")
    sealed :: generation.join("proof.txt")
    original_sealed :: fs.read(sealed) ?? panic("sealed proof")
    fs.write(sealed, "tampered\n".as_bytes()) ?? panic("tamper proof")
    tampered :: run(None)
    assert_eq(tampered.status.code(), Val(2))
    assert_eq(fs.read(sealed) ?? panic("read tampered"), "tampered\n".as_bytes())
    fs.write(sealed, original_sealed) ?? panic("restore proof")
    extra :: generation.join("unproved-extra")
    fs.write(extra, "extra".as_bytes()) ?? panic("write extra")
    assert_eq(run(None).status.code(), Val(2))
    fs.remove_file(extra) ?? panic("remove extra")
    files_proof :: generation.join("generation-files.proof")
    original_files_proof :: fs.read(files_proof) ?? panic("files proof")
    fs.write(files_proof, "tampered-proof".as_bytes()) ?? panic("tamper files proof")
    assert_eq(run(None).status.code(), Val(2))
    fs.write(files_proof, original_files_proof) ?? panic("restore files proof")
    lifecycle_before_retry :: lifecycle_bytes(&root.path)
    committed_retry :: run(None)
    assert(committed_retry.status.success(), "exact committed-name retry must validate without mutation: {String.from_utf8_lossy(committed_retry.stderr)}")
    assert_eq(lifecycle_bytes(&root.path), lifecycle_before_retry, "exact committed retry must change zero lifecycle bytes")
}

