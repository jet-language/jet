    assert(proof.status.success(), "stderr: {String.from_utf8_lossy(proof.stderr)}")
    proof_json :: String.from_utf8_lossy(proof.stdout)
    assert(proof_json.contains("\"host\":\"halcyon\""), "proof: {proof_json}")
    assert(proof_json.contains("\"boot\":"), "proof: {proof_json}")
    assert(proof_json.contains("\"provenance\":"), "proof: {proof_json}")
    assert(proof_json.contains("\"vm_proof\":"), "proof: {proof_json}")
}
