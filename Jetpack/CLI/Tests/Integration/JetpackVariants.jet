use jet.Comptime.Build.[ActionSpec, BuildCapability, BuildContext, BuildProvenance, LinkerIdentity, LockRecord, SdkIdentity, SigningIdentitySpec, SysrootIdentity, ToolchainSpec]

// Rust: tests/jetpack_variants.rs:84
pub fn key(variant: String, sysroot_digest: String, target_triple: String, signer: String) -> String {
    b := BuildContext.new()
    toolchain :: &b.toolchain("cross-tc", ToolchainSpec.target(target_triple,
        BuildProvenance.jetpack_dependency("toolchain.{target_triple}#1", LockRecord.new("toolchain:{target_triple}", "sha256:tc")))
        .with_host_triple("x86_64-linux")
        .with_sdk(SdkIdentity.new("sdk", "1", BuildProvenance.jetpack_dependency("sdk#1", LockRecord.new("sdk:1", "sha256:sdk"))))
        .with_linker(LinkerIdentity.new("lld", BuildProvenance.jetpack_dependency("lld#1", LockRecord.new("linker:lld", "sha256:lld"))))
        .with_sysroot(SysrootIdentity.new("sysroot", sysroot_digest, BuildProvenance.jetpack_dependency("sysroot#1", LockRecord.new("sysroot:1", sysroot_digest))))).unwrap()
    signing :: &b.signing_identity("signer", SigningIdentitySpec.new(signer,
        BuildProvenance.user_declared("keychain:{signer}", Some(LockRecord.new("signing:1", "sha256:sig"))))).unwrap()
    action :: &b.action("compile", ActionSpec.cached(["jetc", "--emit", "obj"])
        .with_outputs(["build/out.o"]).with_cap(BuildCapability.Exec).with_toolchain(toolchain)
        .with_signing_identity(signing).with_variant_identity(variant)).unwrap()
    plan :: b.plan().unwrap()
    plan.action_key(action).unwrap().as_str().to_string()
}
