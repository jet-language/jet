// Rust: tests/jetpack_jetos.rs:1
use Jetpack.CLI.Tests.Integration.Support.JetpackFixtures.*
// GATE #4494: native journal files and byte-preserving directory entry names.
use std.[fs, OsString]

// Rust: tests/jetpack_jetos.rs:20
struct LifecycleRootProof {
    kind: String
    id: String
    producer: String
    witness: String
    targets: [String]
    phase: String
}

// Rust: tests/jetpack_jetos.rs:30
fn lifecycle_bytes(root: &OSPath) -> [(OsString, [U8])] {
    entries := (fs.read_dir(root.join("hangar/lifecycle-db/journal")) ?? panic("read lifecycle journal"))
        .filter_map((entry) -> entry.ok())
        .map((entry) -> (entry.file_name(), fs.read(entry.path()) ?? panic("read journal"))).collect()
    &entries.sort_by((a, b) -> a.0.cmp(&b.0))
    entries
}

// Rust: tests/jetpack_jetos.rs:40
fn lifecycle_roots(root: &OSPath) -> [LifecycleRootProof] {
    roots := [String:LifecycleRootProof]{}
    loop (_, bytes) in lifecycle_bytes(root) {
        text :: String.from_utf8(bytes) ?? panic("journal UTF8")
        current := String?{None}
        loop line in text.lines() {
            fields :: line.split('\t').collect()
            if fields == {
                ["prepare", kind, id_hex, producer, _incarnation, witness, _at] -> {
                    id :: decode_hex(id_hex)
                    &roots.insert(id.clone(), LifecycleRootProof{
                        kind: kind.to_string(), id: id.clone(), producer: decode_hex(producer),
                        witness: decode_hex(witness), targets: [String]{}, phase: "prepared"
                    })
                    current = Val(id)
                }
                ["target", target] -> {
                    id :: current ?? panic("target must follow prepare")
                    proof :: &roots.get_mut(id) ?? panic("prepared root")
                    &proof.targets.push(target.to_string())
                }
                ["commit", id_hex, _incarnation, witness, _at] -> {
                    id :: decode_hex(id_hex)
                    proof :: &roots.get_mut(id) ?? panic("commit must follow durable prepare")
                    assert_eq(proof.witness, decode_hex(witness))
                    proof.phase = "committed"
                    current = None
                }
                _ -> {}
            }
        }
    }
    keys := roots.keys().collect()
    &keys.sort()
    keys.map((key) -> roots.remove(key) ?? panic("journal root"))
}

// Rust: tests/jetpack_jetos.rs:86
fn decode_hex(value: &String) -> String {
    assert_eq(value.len() % 2, 0, "invalid lifecycle hex: {value}")
    bytes :: value.as_bytes().chunks_exact(2).map((pair) -> {
        text :: String.from_utf8(pair) ?? panic("hex UTF8")
        U8.from_str_radix(text, 16) ?? panic("lifecycle hex")
    }).collect()
    String.from_utf8(bytes) ?? panic("lifecycle field UTF8")
}
