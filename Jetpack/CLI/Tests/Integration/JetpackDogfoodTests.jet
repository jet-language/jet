// Rust: tests/jetpack_dogfood.rs:26
#Ignore("live signed-cache downloads and real compiler build; requires a bounded coordinated dogfood root and target")
#Test("jet_repository_env_cold_and_offline_without_nix_host_store_or_fixtures") {
    if target.selected_os() == "linux" {
        base :: required_directory(ROOT)
        build_target :: required_directory(TARGET)
        repo :: OSPath.from_text(env.var("CARGO_MANIFEST_DIR").unwrap())
        project :: base.join("project")
        if env.var_os(no_nix_namespace.CHILD_MARKER).is_some() {
            offline :: env.var(MODE).unwrap() == "offline"
            network :: if offline -> no_nix_namespace.NetworkMode.Disabled else -> no_nix_namespace.NetworkMode.Enabled
            no_nix_namespace.run_in_no_nix_namespace(TEST, network, () -> run_phase(base, project, build_target, offline))
            return
        }
        assert(env.var_os("JETPACK_FIXTURES").is_none(), "live proof must not use fixtures")
        assert(!project.exists(), "use a fresh dogfood root; do not overwrite a previous receipt")
        assert(!base.join("store").exists(), "cold proof requires an empty Hangar")
        loop directory in [project, base.join("home"), base.join("tmp")] { fs.create_dir_all(directory).unwrap() }
        loop entry in fs.read_dir(repo).unwrap() {
            entry :: entry.unwrap()
            name :: entry.file_name()
            text :: name.to_string_lossy()
            if text == ".git" || text == ".jet" || text == "target" || text.starts_with("target-") { continue }
            if text == "env.jet" { fs.copy(entry.path(), project.join(name)).unwrap() }
            else { fs.symlink(entry.path(), project.join(name)).unwrap() }
        }
        fs.symlink(build_target, project.join("target")).unwrap()
        cargo_home :: env.var_os("CARGO_HOME").map(value -> OSPath.from(value))
            .unwrap_or_else(() -> OSPath.from(env.var_os("HOME").unwrap()).join(".cargo"))
        env.set_var("JETPACK_DOGFOOD_CARGO_HOME", cargo_home)
        env.set_var("TMPDIR", base.join("tmp"))
        env.set_var(MODE, "online")
        no_nix_namespace.run_in_no_nix_namespace(TEST, no_nix_namespace.NetworkMode.Enabled, () -> {})
        lock :: fs.read(project.join(".jet/lock")).expect("native admission must produce a lock")
        fs.create_dir(base.join("replaced-catalog")).unwrap()
        env.set_var(MODE, "offline")
        no_nix_namespace.run_in_no_nix_namespace(TEST, no_nix_namespace.NetworkMode.Disabled, () -> {})
        assert_eq(fs.read(project.join(".jet/lock")).unwrap(), lock, "offline replay changed locked authority")
        smoke := fs.read_to_string(base.join("offline-compiler-smoke.stdout")).unwrap().trim() // #4303
        assert_eq(smoke, "hello, world", "the namespace child must execute the ignored test body, not silently skip it")
        assert(!base.join("home/.jet/trust").exists(), "one-run trust must not persist a grant")
    }
}

// Rust: tests/jetpack_env_use_offline.rs:51
#Test("warm_jet_entry_execs_tool_without_wrapper_process") {
    if target.selected_os() == "linux" {
        project :: Scratch.new("warm-jet-entry-project")
        root :: Scratch.new("warm-jet-entry-root")
        fixtures :: Scratch.new("warm-jet-entry-fixtures")
        home :: Scratch.new("warm-jet-entry-home")
        write_native_pid_fixture(fixtures.path)
        fs.write(project.join("env.jet"), "module env.dev {{ packages: [\"omp@releases#1.0.0\"] }}\n").unwrap()
        prep :: jetpack().args(["env", "--prep", "--yes", "--trust", "--offline", "--no-color", "--fixtures"]).arg(fixtures.path)
            .current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output().unwrap()
        assert(prep.status.success(), "env --prep failed: {String.from_utf8_lossy(prep.stderr)}")
        fs.remove_file(fixtures.path.join("jetpackage-omp.json")).unwrap()
        fs.remove_file(fixtures.path.join("omp-1.0.0")).unwrap()
        command := jet()
        &command.args(["env", "--trust", "--offline", "--no-color", "--", "omp"]).current_dir(project.path)
            .env("JETPACK_ROOT", root.path).env("HOME", home.path).env("JETPACK_DENY_NETWORK", "1").env_remove("JETPACK_FIXTURES")
        &command.stdout(Stdio.piped())
        child :: &command.spawn().unwrap()
        pid :: child.id()
        output :: child.wait_with_output().unwrap()
        assert(output.status.success(), "warm jet entry failed: {String.from_utf8_lossy(output.stderr)}")
        pid_text := String.from_utf8_lossy(output.stdout).trim() // #4303
        tool_pid :: pid_text.parse<U32>().unwrap_or_else(error -> panic("warm entry did not return the selected tool pid: {error}; stdout={output.stdout:?}; stderr={output.stderr:?}"))
        assert_eq(tool_pid, pid, "warm entry retained a Jet/Jetpack wrapper process")
    }
}

// Rust: tests/jetpack_env_use_offline.rs:173
#Test("fully_materialized_env_and_use_enter_without_network_or_prompt") {
    if target.selected_os() == "linux" {
        project :: Scratch.new("env-use-offline-project")
        root :: Scratch.new("env-use-offline-root")
        fixtures :: Scratch.new("env-use-offline-fixtures")
        home :: Scratch.new("env-use-offline-home")
        _ :: write_native_omp_fixture(fixtures.path)
        fs.write(project.join("env.jet"), "module env.dev {{ packages: [\"omp@releases#1.0.0\"] }}\n").unwrap()
        prep :: jetpack().args(["env", "--prep", "--yes", "--trust", "--offline", "--no-color", "--fixtures"]).arg(fixtures.path)
            .current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path).output().unwrap()
        assert(prep.status.success(), "env --prep failed: {String.from_utf8_lossy(prep.stderr)}")
        fs.remove_file(fixtures.path.join("jetpackage-omp.json")).unwrap()
        fs.remove_file(fixtures.path.join("omp-1.0.0")).unwrap()
        warmup :: run_env(project.path, root.path, home.path, false)
        assert(warmup.status.success(), "cached entry failed: {String.from_utf8_lossy(warmup.stderr)}")
        warmup_text := String.from_utf8_lossy(warmup.stdout).trim() // #4303
        assert_eq(warmup_text, "cached")
        receipt_path :: project.join(".jet/receipts/env-entry")
        receipt_before :: fs.read(receipt_path).unwrap()
        output_hash :: String.from_utf8(receipt_before).unwrap().lines().find(line -> line.starts_with("omp@"))
            .and_then(line -> line.split('\t').nth(3)).unwrap().to_string()
        out_dir :: root.path.join("hangar/objects").join(output_hash)
        lock_path :: project.join(".jet/lock")
        lock_before :: fs.read(lock_path).ok()
        root_bytes_before_warm_runs :: tree_bytes(root.path)
        loop run in 0..<3 {
            started :: Instant.now()
            output :: run_env(project.path, root.path, home.path, run == 0)
            elapsed :: started.elapsed()
            assert(elapsed < Duration.from_secs(1), "warm env run {run} took {elapsed:?}: {String.from_utf8_lossy(output.stderr)}")
            assert(output.status.success(), "warm env run {run} failed: {String.from_utf8_lossy(output.stderr)}")
            stdout := String.from_utf8_lossy(output.stdout).trim() // #4303
            assert_eq(stdout, "cached")
            stderr :: String.from_utf8_lossy(output.stderr)
            assert(stderr.contains("cache hit 100 percent"), "stderr: {stderr}")
            if run == 0 { assert(!stderr.contains("TIMING step omp"), "warm path realized omp; receipt:\n{fs.read_to_string(receipt_path).unwrap()}\nstderr:\n{stderr}") }
            assert(!stderr.contains("continue?"), "cached entry prompted: {stderr}")
        }
        assert_eq(fs.read(receipt_path).unwrap(), receipt_before)
        assert_eq(fs.read(lock_path).ok(), lock_before)
        assert_eq(tree_bytes(root.path), root_bytes_before_warm_runs, "warm reuse left net Hangar/lease bytes")
        env_path :: project.join("env.jet")
        original_env :: fs.read(env_path).unwrap()
        changed_env := ~original_env
        &changed_env.extend_from_slice("\n".bytes())
        fs.write(env_path, changed_env).unwrap()
        changed_input :: run_env(project.path, root.path, home.path, true)
        assert(changed_input.status.success(), "changed environment input failed: {String.from_utf8_lossy(changed_input.stderr)}")
        changed_text := String.from_utf8_lossy(changed_input.stdout).trim() // #4303
        assert_eq(changed_text, "cached")
        assert(String.from_utf8_lossy(changed_input.stderr).contains("TIMING step omp"), "changed environment input was incorrectly warm-reused: {String.from_utf8_lossy(changed_input.stderr)}")
        fs.write(env_path, original_env).unwrap()
        restored_input :: run_env(project.path, root.path, home.path, false)
        assert(restored_input.status.success(), "restored environment input failed: {String.from_utf8_lossy(restored_input.stderr)}")
        journal_path :: fs.read_dir(root.path.join("hangar/closure-db/journal")).unwrap().map(entry -> entry.unwrap().path())
            .find(path -> path.extension().and_then(extension -> extension.to_str()) == Val("txn")).unwrap()
        journal_metadata :: fs.metadata(journal_path).unwrap()
        status :: Command.new("touch").args(["-d", "@1"]).arg(journal_path).status().unwrap()
        assert(status.success(), "could not mutate journal mtime")
        changed_journal :: run_env(project.path, root.path, home.path, true)
        assert(changed_journal.status.success(), "changed store journal failed: {String.from_utf8_lossy(changed_journal.stderr)}")
        assert(String.from_utf8_lossy(changed_journal.stderr).contains("TIMING step omp"), "changed store journal was incorrectly warm-reused: {String.from_utf8_lossy(changed_journal.stderr)}")
        restore_mtime(journal_path, &journal_metadata)
        restored_journal :: run_env(project.path, root.path, home.path, false)
        assert(restored_journal.status.success(), "restored store journal failed: {String.from_utf8_lossy(restored_journal.stderr)}")
        if target.selected_family() == "unix" {
            seal_path :: root.path.join("hangar/seals").join(output_hash)
            seal_before :: fs.read(seal_path).unwrap()
            seal_metadata :: fs.metadata(seal_path).unwrap()
            tampered_seal := ~seal_before
            tampered_seal[0] ^= 1
            fs.write(seal_path, tampered_seal).unwrap()
            restore_mtime(seal_path, &seal_metadata)
            tampered_metadata :: fs.metadata(seal_path).unwrap()
            assert_eq(tampered_metadata.len(), seal_metadata.len())
            assert_eq(tampered_metadata.mtime(), seal_metadata.mtime())
            assert_eq(tampered_metadata.mtime_nsec(), seal_metadata.mtime_nsec())
            output :: run_env(project.path, root.path, home.path, true)
            assert(output.status.success(), "same-stat seal mutation did not cold-fallback: {String.from_utf8_lossy(output.stderr)}")
            stderr :: String.from_utf8_lossy(output.stderr)
            assert(stderr.contains("TIMING step omp"), "same-stat seal mutation was incorrectly warm-reused: {stderr}")
            fs.write(seal_path, seal_before).unwrap()
            restore_mtime(seal_path, &seal_metadata)
            restored :: run_env(project.path, root.path, home.path, false)
            assert(restored.status.success(), "restored seal failed: {String.from_utf8_lossy(restored.stderr)}")
            fs.remove_file(seal_path).unwrap()
            deleted_seal :: run_env(project.path, root.path, home.path, true)
            assert(deleted_seal.status.success(), "deleted seal did not cold-fallback: {String.from_utf8_lossy(deleted_seal.stderr)}")
            deleted_stderr :: String.from_utf8_lossy(deleted_seal.stderr)
            assert(deleted_stderr.contains("TIMING step omp"), "deleted seal was incorrectly warm-reused: {deleted_stderr}")
        }
        receipt :: fs.read_to_string(project.join(".jet/receipts/env-entry")).unwrap()
        assert(receipt.starts_with("jetpack-env-entry-v4\n"), "normal env entry must publish the verified activation receipt: {receipt}")
        output :: jetpack().args(["use", "omp@releases#1.0.0", "--offline", "--", "omp"]).current_dir(project.path)
            .env("JETPACK_ROOT", root.path).env("HOME", home.path).env("JETPACK_DENY_NETWORK", "1").env_remove("JETPACK_FIXTURES").output().unwrap()
        assert(output.status.success(), "cached entry failed: {String.from_utf8_lossy(output.stderr)}")
        stdout := String.from_utf8_lossy(output.stdout).trim() // #4303
        assert_eq(stdout, "cached")
        stderr :: String.from_utf8_lossy(output.stderr)
        assert(!stderr.contains("continue?"), "cached entry prompted: {stderr}")
        common.make_tree_writable(out_dir)
        fs.remove_dir_all(out_dir).unwrap()
        deleted_object :: run_env(project.path, root.path, home.path, true)
        assert(!deleted_object.status.success(), "deleted direct-CAS output was served: {String.from_utf8_lossy(deleted_object.stderr)}")
    }
}

