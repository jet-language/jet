// Rust: tests/jetpack_semantic_lock.rs:57
#Test("provenance_policy_none_logged_attested_and_e1204") {
    loop (spelling, expected) in [("none", ProvenanceRequirement.None), ("logged", ProvenanceRequirement.Logged), ("attested", ProvenanceRequirement.Attested)] {
        facts :: PackageFacts.parse("name: \"app\"\nversion: \"0.1.0\"\nauthority: {{ trust: {{ require: {spelling} }} }}\n", "test").expect("authority provenance requirement should parse")
        assert_eq(facts.authority.trust.unwrap().require, Val(expected))
    }
    lock := Lock.parse("""
version = 1

[[package]]
name = "textkit"
version = "1.2.0"
source = {{ path = "textkit" }}
fingerprint = "fp-textkit"
content-hash = "sha256-locked"
dependencies = []

[root]
dependencies = ["textkit"]
""").expect("provenance lock fixture should parse")
    assert(Lock.enforce_provenance_requirement(lock, ProvenanceRequirement.None).is_ok())
    assert(Lock.enforce_provenance_requirement(lock, ProvenanceRequirement.Logged).is_err())
    lock.packages[0].provenance = Val(DependencyProvenance{transparency: Val("registry log #48122"), publisher: Val("ed25519:ak3f \"textkit team\""), build: None})
    lock.packages[0].envelope = Val(LockEnvelope{output_hash: "sha256-output", platform: "x86_64-linux", signature: "", provenance: "provider-built", catalog_tier: "", catalog_trust: ""})
    assert(Lock.enforce_provenance_requirement(lock, ProvenanceRequirement.Logged).is_ok())
    assert(Lock.enforce_provenance_requirement(lock, ProvenanceRequirement.Attested).is_err(), "generic envelope provenance is recorded evidence, not an attestation")
    lock.packages[0].provenance.as_mut().unwrap().build = Val("slsa v1.0")
    assert(Lock.enforce_provenance_requirement(lock, ProvenanceRequirement.Attested).is_ok())
    encoded :: Lock.write(lock)
    assert(encoded.contains("provenance-transparency = \"registry log #48122\""))
    assert(encoded.contains("provenance-publisher = \"ed25519:ak3f \\\"textkit team\\\"\""))
    assert(encoded.contains("provenance-build = \"slsa v1.0\""))
    round_trip :: Lock.parse(encoded).expect("provenance fields should round-trip")
    assert_eq(round_trip.packages[0].provenance, lock.packages[0].provenance)
    root :: unique_root("provenance-e1204")
    entry :: root.join("textkit")
    fs.create_dir_all(entry).unwrap()
    fs.write(entry.join("package.jet"), "name: \"textkit\"\nversion: \"1.2.0\"\n").unwrap()
    diagnostic :: Store.verify_content_hash("textkit", entry, "sha256-not-the-tree").expect_err("a changed store entry must retain E1204")
    assert_eq(diagnostic.code, "E1204")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/jetpack_semantic_lock.rs:139
#Test("live_lock_path_atomic_commit_roundtrip_preserves_machine_sections") {
    root :: unique_root("live")
    lock_path :: Store.lock_path(root)
    fs.create_dir_all(lock_path.parent().unwrap()).unwrap()
    fs.write(lock_path, """
version = 1

[[package]]
name = "app"
version = "0.1.0"
source = {{ root = "." }}
fingerprint = "fp-app"
dependencies = []

[root]
dependencies = ["app"]
""").unwrap()
    semantic := SemanticLockFile.with_records([pkg("app", "core.log", "1.2.3", "sha256-log")])
    semantic.inputs = [LockInput{name: "nixpkgs", url: "github:NixOS/nixpkgs/abc", follows: ""}, LockInput{name: "home", url: "github:nix-community/home-manager", follows: "nixpkgs"}]
    semantic.source_maps = [SourceMapEntry{pattern: "core.*", sources: ["catalog:core.log", "core"]}]
    atomic_commit(root, semantic).expect("atomic commit")
    raw :: fs.read_to_string(lock_path).unwrap()
    assert(raw.contains("[[package]]"))
    assert(raw.contains("name = \"app\""))
    assert(raw.contains("[[semantic_record]]"))
    assert(raw.contains("[[lock_input]]"))
    assert(raw.contains("[[source_map]]"))
    assert(raw.contains("follows = \"nixpkgs\""))
    machine :: Lock.parse(raw).expect("machine lock parse")
    assert_eq(machine.packages.len(), 1)
    assert_eq(machine.packages[0].name, "app")
    loaded :: load(root).expect("semantic load")
    assert_eq(loaded.records.len(), 1)
    assert_eq(loaded.inputs.len(), 2)
    assert_eq(loaded.source_maps.len(), 1)
    assert_eq(loaded.records[0].identity.exact, "1.2.3")
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/jetpack_semantic_lock.rs:203
#Test("catalog_selection_records_owner_and_source_ref") {
    lock := SemanticLockFile.default()
    record_catalog_selection(&lock, "app", "log", "core.log@1.2.3", "sha256-catalog", "x86_64-linux", "workspace selected shared logging")
    assert_eq(lock.records.len(), 1)
    assert_eq(lock.records[0].rationales[0].source_ref, "catalog:log")
    assert_eq(lock.records[0].rationales[0].adapter_id, "workspace.catalog")
    assert(revalidate(lock).is_ok())
}

// Rust: tests/jetpack_semantic_lock.rs:224
#Test("selective_update_keeps_unrelated_record_bytes_stable") {
    lock := SemanticLockFile.with_records([pkg("app", "core.log", "1.2.3", "sha256-log"), pkg("app", "core.http", "2.0.0", "sha256-http")])
    before :: SemanticLock.write(lock)
    http_block :: before.split("[[semantic_record]]").find(block -> block.contains("key = \"core.http\"")).expect("http record").to_string()
    selective_update(&lock, pkg("app", "core.log", "1.3.0", "sha256-log-new"))
    after :: SemanticLock.write(lock)
    http_after :: after.split("[[semantic_record]]").find(block -> block.contains("key = \"core.http\"")).expect("http record after").to_string()
    assert_eq(http_block, http_after)
    assert(after.contains("exact = \"1.3.0\""))
}

// Rust: tests/jetpack_semantic_lock.rs:248
#Test("input_follows_cycle_and_missing_target_fail_revalidate") {
    lock := SemanticLockFile.with_records([pkg("app", "core.log", "1.2.3", "sha256-log")])
    lock.inputs = [LockInput{name: "a", url: "u-a", follows: "b"}, LockInput{name: "b", url: "u-b", follows: "a"}]
    err :: revalidate(lock).expect_err("cycle")
    assert(err.iter().any(issue -> issue == ValidationIssue.InputCycle(_)))
    lock.inputs = [LockInput{name: "home", url: "u", follows: "missing"}]
    missing :: revalidate(lock).expect_err("missing follows")
    assert(missing.iter().any(issue -> issue == ValidationIssue.MissingFollows{..}))
}

// Rust: tests/jetpack_semantic_lock.rs:280
#Test("source_map_rejects_wrong_authority") {
    lock := SemanticLockFile.with_records([pkg("app", "Company.Lib", "1.0.0", "sha256-lib")])
    lock.records[0].rationales[0].source_ref = "nuget:PublicGallery"
    lock.source_maps = [SourceMapEntry{pattern: "Company.*", sources: ["nuget:CompanyFeed"]}]
    err :: revalidate(lock).expect_err("source authority")
    assert(err.iter().any(issue -> issue == ValidationIssue.SourceAuthority{..}))
}

// Rust: tests/jetpack_semantic_lock.rs:295
#Test("overlay_change_invalidates_exact_action_keys_and_explains_why") {
    before :: OverlayPolicy{overlays: [OverlaySet{name: "beta", provider: None, packages: [PackageOverride{package: "foo", source: None, version: Val("1.0.0"), flags: [], priority: 0, field_priorities: [:], env: [], patches: ["patches/a.patch"], allow_unfree: false}]}], ..OverlayPolicy.default()}
    after :: OverlayPolicy{overlays: [OverlaySet{name: "beta", provider: None, packages: [PackageOverride{package: "foo", source: None, version: Val("1.0.0"), flags: [], priority: 0, field_priorities: [:], env: [], patches: ["patches/a.patch", "patches/b.patch"], allow_unfree: false}]}], ..OverlayPolicy.default()}
    actions :: [String:[String]]{"foo": ["action:foo:build", "action:foo:check"]}
    inv :: Overlay.invalidations_against(before, after, actions).unwrap()
    assert_eq(inv.len(), 1)
    assert_eq(inv[0].affected_action_keys, ["action:foo:build", "action:foo:check"])
    assert(inv[0].reason.contains("changed package `foo`"))
    assert_ne(inv[0].policy_fingerprint_before, inv[0].policy_fingerprint_after)
    overlay_record :: Overlay.semantic_records(before, "app", "x86_64-linux").unwrap().into_iter().next().unwrap()
    lock := SemanticLockFile.with_records([pkg("app", "foo", "1.0.0", "sha256-foo"), overlay_record])
    apply_overlay_invalidations(&lock, inv)
    assert(!lock.records.iter().any(record -> record.identity.kind == LockRecordKind.PackageOverlay))
    foo :: lock.records.iter().find(record -> record.identity.key == "foo").unwrap()
    assert(foo.identity.hash.is_empty(), "hash cleared for rebuild")
}

// Rust: tests/jetpack_semantic_lock.rs:374
#Test("overlay_semantic_projection_uses_resolved_facts_and_provenance") {
    policy :: Overlay.parse_workspace_policy("""
module workspace {{
    overlay base {{
        package("foo").version: "1"
    }}
    overlay force {{
        package("foo").version: Force("2")
    }}
}}
""").unwrap()
    records :: Overlay.semantic_records(policy, "app", "x86_64-linux").unwrap()
    record :: records.iter().find(record -> record.identity.key == "force:foo").unwrap()
    assert_eq(record.identity.exact, "2")
    assert_eq(record.future_fields.get("overlay-fact-version"), Val("2"))
    assert_eq(record.rationales.len(), 2)
    assert(record.rationales.iter().any(rationale -> rationale.reason.contains("base")))
    assert(record.rationales.iter().any(rationale -> rationale.reason.contains("force")))
    loaded :: SemanticLock.parse(SemanticLock.write(SemanticLockFile.with_records(records)))
    loaded_record :: loaded.records.iter().find(record -> record.identity.key == "force:foo").unwrap()
    assert_eq(loaded_record.future_fields.get("overlay-fact-version"), Val("2"))
    assert_eq(loaded_record.rationales.len(), 2)
    explanation :: SemanticLock.explain(SemanticLockFile.with_records([~loaded_record]), "package-overlay:force:foo").expect("overlay explanation")
    assert_eq(explanation.contenders.len(), 2)
    assert(explanation.contenders.iter().any(rationale -> rationale.reason.contains("base")))
    assert(explanation.contenders.iter().any(rationale -> rationale.reason.contains("force")))
}

// Rust: tests/jetpack_semantic_lock.rs:436
#Test("merge_revalidate_commit_rejects_conflicts_before_write") {
    root :: unique_root("merge-conflict")
    left :: SemanticLockFile.with_records([pkg("app", "core.log", "1.2.3", "sha256-a")])
    right :: SemanticLockFile.with_records([pkg("app", "core.log", "1.3.0", "sha256-b")])
    err :: merge_revalidate_commit(root, SemanticLockFile.default(), left, right).expect_err("conflict")
    assert(!err.issues.is_empty())
    assert(!SemanticLock.live_path(root).exists())
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/jetpack_semantic_lock.rs:448
#Test("merge_revalidate_commit_writes_when_clean") {
    root :: unique_root("merge-ok")
    left :: SemanticLockFile.with_records([pkg("app", "core.log", "1.2.3", "sha256-log")])
    right :: SemanticLockFile.with_records([pkg("app", "core.http", "2.0.0", "sha256-http")])
    merged :: merge_revalidate_commit(root, SemanticLockFile.default(), left, right).unwrap()
    assert_eq(merged.records.len(), 2)
    loaded :: load(root).unwrap()
    assert_eq(loaded.records.len(), 2)
    raw :: fs.read_to_string(SemanticLock.live_path(root)).unwrap()
    machine :: strip_semantic_sections(raw)
    assert(!machine.contains("semantic_record"))
    assert(machine.contains("version = 1"))
    _ :: fs.remove_dir_all(root)
}

// Rust: tests/jetpack_semantic_lock.rs:469
#Test("overlay_invalidations_helper_matches_fingerprint_diff") {
    before :: [(String, String):String]{("beta", "foo"): "fp-1"}
    after :: [(String, String):String]{("beta", "foo"): "fp-2"}
    actions :: [String:[String]]{"foo": ["a:foo"]}
    inv :: overlay_invalidations(before, after, actions)
    assert_eq(inv[0].affected_action_keys, ["a:foo"])
}

// Rust: tests/jetpack_semantic_lock.rs:478
#Test("three_way_merge_preserves_inputs_and_source_maps") {
    base := SemanticLockFile.default()
    base.inputs = [LockInput{name: "nixpkgs", url: "old", follows: ""}]
    left := ~base
    left.source_maps = [SourceMapEntry{pattern: "Acme.*", sources: ["nuget:Acme"]}]
    right := ~base
    right.inputs = [LockInput{name: "nixpkgs", url: "new", follows: ""}]
    out :: merge(base, left, right)
    assert(out.conflicts.is_empty())
    assert_eq(out.merged.inputs[0].url, "new")
    assert_eq(out.merged.source_maps[0].pattern, "Acme.*")
}
