fn lock_envelope(output: &String, platform: &String) -> Lock.LockEnvelope {
    Lock.LockEnvelope{output_hash: output.to_string(), platform: platform.to_string(), provenance: "integration-test",
        catalog_tier: "local-unofficial", catalog_trust: "unverified", ..Lock.LockEnvelope.default()}
}
// Rust: tests/jetpack_nix_closure_replay.rs:606
fn copy_tree_nofollow(source: &OSPath, destination: &OSPath) -> {
    metadata :: fs.symlink_metadata(source) ?? panic("source metadata")
    if metadata.file_type().is_symlink() {
        fs.symlink(fs.read_link(source) ?? panic("read link"), destination) ?? panic("copy link")
    } else if metadata.is_dir() {
        fs.create_dir(destination) ?? panic("create directory")
        for result in fs.read_dir(source) ?? panic("read directory") {
            entry :: result ?? panic("entry")
            copy_tree_nofollow(&entry.path(), &destination.join(entry.file_name()))
        }
        fs.set_permissions(destination, Permissions.from_mode(metadata.permissions().mode())) ?? panic("chmod directory")
    } else {
        _ :: fs.copy(source, destination) ?? panic("copy file")
        fs.set_permissions(destination, Permissions.from_mode(metadata.permissions().mode())) ?? panic("chmod file")
    }
}
// Rust: tests/jetpack_nix_closure_replay.rs:634
fn relative_link_entry(root: &Scratch, source: &Scratch, target: &String) -> Store.StoreEntry {
    fs.write(source.path.join(target), "link target payload\n".as_bytes()) ?? panic("write link payload")
    fs.symlink(target, source.join("link")) ?? panic("create link")
    roots :: Store.Roots{root: root.path.clone(), dev_mode: false}
    request :: Store.IngestRequest{
        name: "link-fixture", version: "1.0.0", reference: "link-fixture@fixture",
        cache_identity: Store.CacheIdentity{source_fingerprint: "source-fingerprint", recipe_fingerprint: "recipe-fingerprint",
            policy_fingerprint: "policy-fingerprint", platform: "x86_64-linux"},
        references: [], outputs: [String: OSPath]{"out": source.path.clone()}, signature: "",
        provenance: "integration-test", platform_artifact_kind: ""
    }
    (Store.ingest_tree(&roots, &request) ?? panic("ingest link")).entry
}
// Rust: tests/jetpack_nix_closure_replay.rs:666
fn read_u32(bytes: &[U8], at: &mut USize) -> U32 {
    end :: at + 4
    value :: U32.from_le_bytes(bytes[at..end].try_into() ?? panic("u32 bytes"))
    at = end
    value
}
// Rust: tests/jetpack_nix_closure_replay.rs:674
fn read_u64(bytes: &[U8], at: &mut USize) -> U64 {
    end :: at + 8
    value :: U64.from_le_bytes(bytes[at..end].try_into() ?? panic("u64 bytes"))
    at = end
    value
}
// Rust: tests/jetpack_nix_closure_replay.rs:682
fn skip_string(bytes: &[U8], at: &mut USize) -> {
    length :: read_u32(bytes, &at) as USize
    at += length
}
// Rust: tests/jetpack_nix_closure_replay.rs:688
fn read_bytes(bytes: &[U8], at: &mut USize) -> [U8] {
    length :: read_u32(bytes, &at) as USize
    end :: at + length
    value :: bytes[at..end].to_vec()
    at = end
    value
}
// Rust: tests/jetpack_nix_closure_replay.rs:698
struct RawArchiveNode { kind: U8, path: [U8], mode: U32, bytes: [U8] }
// Rust: tests/jetpack_nix_closure_replay.rs:707
struct RawArchiveOutput { root_mode: U32, nodes: [RawArchiveNode] }
// Rust: tests/jetpack_nix_closure_replay.rs:713
fn read_generic_output(bytes: &[U8], expected: &String) -> RawArchiveOutput {
    magic :: "jet-hangar-archive-v1{TEXT_NUL}".as_bytes()
    at := magic.len()
    skip_string(bytes, &at)
    object_count :: read_u32(bytes, &at) as USize
    output := nil as RawArchiveOutput?
    for _ in 0..object_count {
        _id :: read_bytes(bytes, &at)
        digest :: read_bytes(bytes, &at)
        meta :: read_bytes(bytes, &at)
        root_mode :: read_u32(bytes, &at)
        node_count :: read_u32(bytes, &at) as USize
        nodes := [RawArchiveNode].with_capacity(node_count)
        for _ in 0..node_count {
            kind :: bytes[at]
            at += 1
            path :: read_bytes(bytes, &at)
            mode :: read_u32(bytes, &at)
            size :: read_u64(bytes, &at) as USize
            end :: at + size
            payload :: bytes[at..end].to_vec()
            at = end
            &nodes.push(RawArchiveNode{kind: kind, path: path, mode: mode, bytes: payload})
        }
        if meta.is_empty() && digest == expected.as_bytes() { output = Val(RawArchiveOutput{root_mode: root_mode, nodes: nodes}) }
    }
    output ?? panic("generic archive must contain the requested output")
}
// Rust: tests/jetpack_nix_closure_replay.rs:750
fn put_bytes(out: &mut [U8], bytes: &[U8]) -> {
    &out.extend_from_slice((bytes.len() as U32).to_le_bytes())
    &out.extend_from_slice(bytes)
}
// Rust: tests/jetpack_nix_closure_replay.rs:756
fn put_raw_u64(out: &mut [U8], value: U64) -> { &out.extend_from_slice(value.to_le_bytes()) }
// Rust: tests/jetpack_nix_closure_replay.rs:761
fn encode_nix_bundle(output: &String, source: &RawArchiveOutput, platform: &String, revision: &String, cache_key: &String) -> [U8] {
    canonical := [U8]{}
    &canonical.extend_from_slice(source.root_mode.to_le_bytes())
    for node in source.nodes {
        &canonical.push(node.kind)
        put_bytes(&canonical, node.path)
        &canonical.extend_from_slice(node.mode.to_le_bytes())
        put_raw_u64(&canonical, node.bytes.len() as U64)
        &canonical.extend_from_slice(node.bytes)
    }
    member_hash :: "sha256-{SHA256.sha256_hex(canonical)}"
    out := [U8]{}
    &out.extend_from_slice("jet-hangar-archive-v1{TEXT_NUL}".as_bytes())
    put_bytes(&out, output.as_bytes())
    &out.extend_from_slice((1 as U32).to_le_bytes())
    put_bytes(&out, output.as_bytes())
    put_bytes(&out, output.as_bytes())
    put_bytes(&out, [])
    &out.extend_from_slice(source.root_mode.to_le_bytes())
    &out.extend_from_slice((source.nodes.len() as U32).to_le_bytes())
    for node in source.nodes {
        &out.push(node.kind)
        put_bytes(&out, node.path)
        &out.extend_from_slice(node.mode.to_le_bytes())
        put_raw_u64(&out, node.bytes.len() as U64)
        &out.extend_from_slice(node.bytes)
    }
    &out.push(2)
    put_bytes(&out, output.as_bytes())
    put_bytes(&out, platform.as_bytes())
    put_bytes(&out, revision.as_bytes())
    put_bytes(&out, cache_key.as_bytes())
    &out.extend_from_slice((1 as U32).to_le_bytes())
    put_bytes(&out, output.as_bytes())
    put_bytes(&out, member_hash.as_bytes())
    put_raw_u64(&out, canonical.len() as U64)
    &out.extend_from_slice((0 as U32).to_le_bytes())
    &out.push(0)
    out
}
// Rust: tests/jetpack_nix_closure_replay.rs:810
fn replace_link_target(bytes: &[U8], old: &[U8], replacement: &[U8]) -> [U8] {
    assert(!old.is_empty())
    assert_eq(old.len(), replacement.len())
    magic :: "jet-hangar-archive-v1{TEXT_NUL}".as_bytes()
    assert(bytes.starts_with(magic))
    at := magic.len()
    skip_string(bytes, &at)
    object_count :: read_u32(bytes, &at) as USize
    assert_eq(object_count, 1, "fixture must contain one output object")
    object_digest := nil as [U8]?
    object := nil as RawArchiveOutput?
    for _ in 0..object_count {
        _id :: read_bytes(bytes, &at)
        digest :: read_bytes(bytes, &at)
        meta :: read_bytes(bytes, &at)
        root_mode :: read_u32(bytes, &at)
        node_count :: read_u32(bytes, &at) as USize
        nodes := [RawArchiveNode].with_capacity(node_count)
        for _ in 0..node_count {
            kind :: bytes[at]
            at += 1
            path :: read_bytes(bytes, &at)
            mode :: read_u32(bytes, &at)
            size :: read_u64(bytes, &at) as USize
            end :: at + size
            &nodes.push(RawArchiveNode{kind: kind, path: path, mode: mode, bytes: bytes[at..end].to_vec()})
            at = end
        }
        if meta.is_empty() {
            object_digest = Val(digest)
            object = Val(RawArchiveOutput{root_mode: root_mode, nodes: nodes})
        }
    }
    assert_eq(bytes[at], 2, "fixture must carry a Nix manifest")
    at += 1
    manifest_output :: read_bytes(bytes, &at)
    platform :: read_bytes(bytes, &at)
    revision :: read_bytes(bytes, &at)
    cache_key :: read_bytes(bytes, &at)
    member_count :: read_u32(bytes, &at) as USize
    for _ in 0..member_count {
        skip_string(bytes, &at)
        skip_string(bytes, &at)
        _ :: read_u64(bytes, &at)
        reference_count :: read_u32(bytes, &at) as USize
        for _ in 0..reference_count { skip_string(bytes, &at) }
    }
    digest :: object_digest ?? panic("fixture must carry an output object")
    assert_eq(digest, manifest_output)
    decoded := object ?? panic("fixture must carry an output object")
    matches := 0
    for node in &decoded.nodes {
        if node.kind == 2 && node.bytes == old { node.bytes = replacement.to_vec(); matches += 1 }
    }
    assert_eq(matches, 1, "archive must contain one symlink target")
    encode_nix_bundle(String.from_utf8(manifest_output) ?? panic("output utf8"), &decoded,
        String.from_utf8(platform) ?? panic("platform utf8"), String.from_utf8(revision) ?? panic("revision utf8"), String.from_utf8(cache_key) ?? panic("cache key utf8"))
}
// Rust: tests/jetpack_nix_closure_replay.rs:886
fn replace_all(bytes: &[U8], old: &[U8], replacement: &[U8]) -> ([U8], USize) {
    assert(!old.is_empty())
    assert_eq(old.len(), replacement.len())
    result := [U8].with_capacity(bytes.len())
    cursor := 0
    count := 0
    loop {
        relative :: bytes[cursor..].windows(old.len()).position(window -> window == old)
        if offset_in_tail :: relative {
            offset :: cursor + offset_in_tail
            &result.extend_from_slice(bytes[cursor..offset])
            &result.extend_from_slice(replacement)
            cursor = offset + old.len()
            count += 1
        } else { break }
    }
    &result.extend_from_slice(bytes[cursor..])
    (result, count)
}
// Rust: tests/jetpack_nix_closure_replay.rs:907
fn cas_digest_from_bytes(bytes: &[U8]) -> String { "sha256-{SHA256.sha256_hex(bytes)}" }
