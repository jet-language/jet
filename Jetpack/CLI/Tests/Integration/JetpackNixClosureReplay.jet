// Rust: tests/jetpack_nix_closure_replay.rs:407
fn hex_digest(prefix: &String, fill: Char) -> String { "{prefix}{fill.to_string().repeat(64)}" }
// Rust: tests/jetpack_nix_closure_replay.rs:411
fn cas_digest(fill: Char) -> String { hex_digest("sha256-", fill) }
// Rust: tests/jetpack_nix_closure_replay.rs:415
fn valid_nix_closure(output: &String) -> Lock.NixClosureRecord {
    Lock.NixClosureRecord{
        channel: "nixpkgs-unstable", revision: "a".repeat(40), system: Envelope.host_platform(),
        index_authority: "b".repeat(64), derivation: "c".repeat(64), output: output.to_string(),
        nar_hash: "sha256:{'d'.to_string().repeat(64)}", size: 1, compression: "none",
        references: [], upstream_proof: cas_digest('e'), cache_key: "f".repeat(64), project_cas_bundle: cas_digest('0')
    }
}
