#Test("real_core_provider_registers_canonical_object_and_action_relation") {
    (_base, project, root) :: core_hello_project("hangar-v2-core-closure")
    built :: jetpack().args(["build", "--no-color"]).current_dir(project).env("JETPACK_ROOT", root).env("PATH", "/usr/bin:/bin").output().unwrap()
