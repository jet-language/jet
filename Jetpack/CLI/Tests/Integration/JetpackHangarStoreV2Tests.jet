// Rust: tests/jetpack_hangar_store_v2.rs:19
#Test("hangar_ingest_path_law_reserved_is_e1299") {
    root :: Scratch.new("hangar-v2-path-root")
    proj :: Scratch.new("hangar-v2-path-proj")
    src :: Scratch.new("hangar-v2-path-src")
    fs.write(src.path.join("CON"), "nope").unwrap()
    output :: jetpack().args(["hangar", "ingest", src.path.to_str().unwrap(), "--name", "bad", "--no-color"])
        .current_dir(proj.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert_eq(output.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(output.stderr)
    diagnostic :: stderr.find("Error [E1299]:").map(index -> stderr.slice(index..)).unwrap_or(stderr)
    assert_jetos_stderr_snapshot("hangar_path_law_reserved", diagnostic)
}

// Rust: tests/jetpack_hangar_store_v2.rs:47
#Test("hangar_ingest_missing_output_is_atomic_and_retryable") {
    root :: Scratch.new("hangar-v2-missing-root")
    proj :: Scratch.new("hangar-v2-missing-proj")
    source :: root.path.join("late-output")
    ingest :: () -> jetpack().args(["hangar", "ingest", source.to_str().unwrap(), "--name", "late", "--no-color"])
        .current_dir(proj.path).env("JETPACK_ROOT", root.path).output().unwrap()
    failed :: ingest()
    assert_eq(failed.status.code(), Val(2))
    stderr :: String.from_utf8_lossy(failed.stderr)
    assert(stderr.contains("Error [E1315]"), "{stderr}")
    assert(stderr.contains("does not exist"), "{stderr}")
    assert(!stderr.contains("ingested"), "failure emitted a success receipt: {stderr}")
    roots :: Store.Roots{root: root.path, dev_mode: false}
    assert(Store.list_checked(roots).unwrap().is_empty())
    assert(Store.closure_graph(roots).unwrap().records.is_empty())
    assert(!root.path.join("leases").exists())
    fs.create_dir_all(source).unwrap()
    fs.write(source.join("payload"), "now-real").unwrap()
    retried :: ingest()
    assert(retried.status.success(), "stderr: {String.from_utf8_lossy(retried.stderr)}")
    assert(String.from_utf8_lossy(retried.stderr).contains("ingested"))
    assert_eq(Store.list_checked(roots).unwrap().len(), 1)
}

// Rust: tests/jetpack_hangar_store_v2.rs:101
#Test("hangar_ingest_verify_and_dedupe_roundtrip") {
    root :: Scratch.new("hangar-v2-ingest-root")
    proj :: Scratch.new("hangar-v2-ingest-proj")
    src :: Scratch.new("hangar-v2-ingest-src")
    fs.create_dir_all(src.path.join("bin")).unwrap()
    fs.write(src.path.join("bin/hello"), "#!/bin/sh\necho hi\n").unwrap()
    if target.selected_family() == "unix" { fs.set_permissions(src.path.join("bin/hello"), fs.Permissions.from_mode(0o755)).unwrap() }
    ingest :: jetpack().args(["hangar", "ingest", src.path.to_str().unwrap(), "--name", "hello", "--version", "1.0.0", "--no-color"])
        .current_dir(proj.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(ingest.status.success(), "stderr: {String.from_utf8_lossy(ingest.stderr)}")
    stderr :: String.from_utf8_lossy(ingest.stderr)
    assert(stderr.contains("ingested"), "{stderr}")
    assert(stderr.contains("sha256-"), "{stderr}")
    src2 :: Scratch.new("hangar-v2-ingest-src2")
    fs.create_dir_all(src2.path.join("bin")).unwrap()
    fs.write(src2.path.join("bin/hello"), "#!/bin/sh\necho hi\n").unwrap()
    if target.selected_family() == "unix" { fs.set_permissions(src2.path.join("bin/hello"), fs.Permissions.from_mode(0o755)).unwrap() }
    ingest2 :: jetpack().args(["hangar", "ingest", src2.path.to_str().unwrap(), "--name", "hello2", "--version", "1.0.0", "--no-color"])
        .current_dir(proj.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(ingest2.status.success())
    stderr2 :: String.from_utf8_lossy(ingest2.stderr)
    assert(stderr2.contains("deduplicated"), "{stderr2}")
    list :: jetpack().args(["hangar", "list", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(list.status.success())
    listed :: String.from_utf8_lossy(list.stderr)
    assert(listed.contains("hello"), "{listed}")
    list_json :: jetpack().args(["hangar", "list", "--json", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(list_json.status.success(), "stderr: {list_json.stderr:?}")
    assert(list_json.stderr.is_empty(), "JSON list leaked stderr: {list_json.stderr:?}")
    list_text := String.from_utf8_lossy(list_json.stdout).trim() // #4303
    list_report :: JSON.parse(list_text).expect("list JSON report")
    assert_eq(json_string(list_report, "schema"), "jet.report/v1")
    assert_eq(json_string(list_report, "action"), "list")
    assert(String.from_utf8_lossy(list_json.stdout).contains("\"packages\":["))
    digest :: stderr.split_whitespace().find(token -> token.starts_with("sha256-")).expect("digest in ingest status")
    verify :: jetpack().args(["hangar", "verify", digest, "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(verify.status.success(), "stderr: {String.from_utf8_lossy(verify.stderr)}")
    verify_stderr :: String.from_utf8_lossy(verify.stderr)
    assert(verify_stderr.contains("verified"), "{verify_stderr}")
    assert(!String.from_utf8_lossy(verify.stdout).contains("hangar is empty"), "Jetpack Hangar verification reported an empty store: {String.from_utf8_lossy(verify.stdout)}")
    roots :: Store.Roots{root: root.path, dev_mode: false}
    // Parent-side store read finishes before spawning child recovery.
    meta :: {
        entry :: Store.list(roots).into_iter().find(entry -> entry.name == "hello").unwrap()
        roots.hangar_dir().join(entry.id).join("meta.json")
    }
    fs.remove_file(meta).unwrap()
    recover :: jetpack().args(["hangar", "recover", "--no-color"]).current_dir(proj.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(recover.status.success(), "stderr: {String.from_utf8_lossy(recover.stderr)}")
    assert(meta.is_file(), "CLI recovery must replay committed package metadata")
}

// Rust: tests/jetpack_hangar_store_v2.rs:259
#Test("distinct_hangar_roots_share_one_cas_object_and_file_bytes") {
    if target.selected_family() == "unix" {
        shared :: Scratch.new("hangar-shared-cas")
        left_root :: Scratch.new("hangar-shared-left")
        right_root :: Scratch.new("hangar-shared-right")
        project :: Scratch.new("hangar-shared-project")
        source :: Scratch.new("hangar-shared-source")
        fs.create_dir_all(source.join("bin")).unwrap()
        fs.write(source.join("bin/tool"), "shared package bytes\n").unwrap()
        fs.create_dir_all(source.join("share")).unwrap()
        fs.write(source.join("share/data"), "second shared object\n").unwrap()
        ingest :: (root: &Scratch) -> jetpack().args(["hangar", "ingest", source.path.to_str().unwrap(), "--name", "shared-tool", "--version", "1.0.0", "--ref", "shared-tool@fixture#1.0.0", "--no-color"])
            .current_dir(project.path).env("JETPACK_ROOT", root.path).env("JETPACK_SHARED_CAS", shared.path).output().unwrap()
        loop root in [&left_root, &right_root] {
            output :: ingest(root)
            assert(output.status.success(), "stderr: {String.from_utf8_lossy(output.stderr)}")
        }
        left :: Store.Roots.at(left_root.path)
        right :: Store.Roots.at(right_root.path)
        left_entry :: Store.find_by_reference(left, "shared-tool@fixture#1.0.0").unwrap()
        right_entry :: Store.find_by_reference(right, "shared-tool@fixture#1.0.0").unwrap()
        assert_eq(left_entry.envelope.output_hash, right_entry.envelope.output_hash)
        assert_ne(left_entry.out, right_entry.out)
        shared_objects :: fs.read_dir(shared.path).unwrap().filter_map(result -> result.ok()).filter(entry -> entry.file_type().unwrap().is_file()).map(entry -> entry.path()).collect<[OSPath]>()
        assert_eq(shared_objects.len(), 2, "shared CAS object count")
        expected :: physical_files(shared_objects)
        all_paths := [OSPath.from_text(left_entry.out), OSPath.from_text(right_entry.out)]
        &all_paths.extend(shared_objects)
        actual :: physical_files(all_paths)
        assert_eq(actual, expected, "shared CAS physical file count and bytes")
    }
}

// Rust: tests/jetpack_hangar_store_v2.rs:359
#Test("hangar_sign_and_verify_production_path_rejects_tamper") {
    root :: Scratch.new("hangar-sign-verify-root")
    project :: Scratch.new("hangar-sign-verify-project")
    source :: Scratch.new("hangar-sign-verify-source")
    fs.write(source.join("payload"), "signed bytes\n").unwrap()
    ingest :: jetpack().args(["hangar", "ingest", source.path.to_str().unwrap(), "--name", "signed", "--ref", "signed@fixture", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(ingest.status.success(), "stderr: {String.from_utf8_lossy(ingest.stderr)}")
    sign :: jet().args(["hangar", "sign", "signed@fixture", "--yes", "--json", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(sign.status.success(), "stderr: {String.from_utf8_lossy(sign.stderr)}")
    sign_stdout :: String.from_utf8_lossy(sign.stdout)
    assert(sign_stdout.contains("\"schema\":\"jet.report/v1\""), "{sign_stdout}")
    assert(sign_stdout.contains("\"action\":\"sign\""), "{sign_stdout}")
    assert(sign_stdout.contains("\"signed\":true"), "{sign_stdout}")
    sign_text := sign_stdout.trim() // #4303
    sign_report :: JSON.parse(sign_text).expect("sign JSON report")
    assert_eq(json_string(sign_report, "schema"), "jet.report/v1")
    assert_eq(json_string(sign_report, "moment"), "tool")
    assert_eq(json_string(sign_report, "status"), "ok")
    assert_eq(json_string(sign_report, "action"), "sign")
    assert(sign.stderr.is_empty(), "JSON sign leaked stderr: {sign.stderr:?}")
    dump_json :: jet().args(["hangar", "dump", "signed@fixture", "--json", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert_eq(dump_json.status.code(), Val(2))
    assert(dump_json.stderr.is_empty(), "JSON dump leaked stderr: {dump_json.stderr:?}")
    dump_text := String.from_utf8_lossy(dump_json.stdout).trim() // #4303
    dump_report :: JSON.parse(dump_text).expect("dump JSON report")
    assert_eq(json_string(dump_report, "schema"), "jet.report/v1")
    assert_eq(json_string(dump_report, "moment"), "compile")
    assert_eq(json_string(dump_report, "severity"), "error")
    assert_eq(json_string(dump_report, "code"), "E1340")
    roots :: Store.Roots{root: root.path, dev_mode: false}
    entry :: Store.find_by_reference(roots, "signed@fixture").unwrap()
    sidecar :: roots.hangar_dir().join(entry.id).join(".hangar")
    assert(sidecar.is_file(), "sign must publish the detached archive sidecar")
    verify :: jet().args(["hangar", "verify", "signed@fixture", "--json", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(verify.status.success(), "stderr: {String.from_utf8_lossy(verify.stderr)}")
    verify_stdout :: String.from_utf8_lossy(verify.stdout)
    assert(verify_stdout.contains("\"schema\":\"jet.report/v1\""), "{verify_stdout}")
    assert(verify_stdout.contains("\"action\":\"verify\""), "{verify_stdout}")
    assert(verify_stdout.contains("\"signed\":true"), "{verify_stdout}")
    unsigned_archive :: root.path.join("unsigned.hangar")
    signed_archive_path :: root.path.join("signed.hangar")
    fs.write(unsigned_archive, Store.export_unsigned_archive(roots, entry.id, false).unwrap()).unwrap()
    sign_archive :: jet().args(["hangar", "sign", unsigned_archive.to_str().unwrap(), "--to", signed_archive_path.to_str().unwrap(), "--yes", "--json", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(sign_archive.status.success(), "stderr: {String.from_utf8_lossy(sign_archive.stderr)}")
    assert(signed_archive_path.is_file())
    verify_archive :: jet().args(["hangar", "verify", signed_archive_path.to_str().unwrap(), "--json", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(verify_archive.status.success(), "stderr: {String.from_utf8_lossy(verify_archive.stderr)}")
    corrupt_unsigned := fs.read(unsigned_archive).unwrap()
    payload :: "signed bytes\n".bytes()
    offset :: corrupt_unsigned.windows(payload.len()).position(window -> window == payload).expect("archive carries the fixture payload")
    corrupt_unsigned[offset] ^= 1
    fs.write(unsigned_archive, corrupt_unsigned).unwrap()
    corrupt_signed_path :: root.path.join("corrupt-signed.hangar")
    reject_corrupt_sign :: jet().args(["hangar", "sign", unsigned_archive.to_str().unwrap(), "--to", corrupt_signed_path.to_str().unwrap(), "--yes", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert_eq(reject_corrupt_sign.status.code(), Val(2))
    assert(!corrupt_signed_path.exists())
    all_verify :: jet().args(["hangar", "verify", "--json", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(all_verify.status.success(), "stderr: {String.from_utf8_lossy(all_verify.stderr)}")
    assert(String.from_utf8_lossy(all_verify.stdout).contains("\"objects\":1"), "{String.from_utf8_lossy(all_verify.stdout)}")
    signed_archive :: fs.read(sidecar).unwrap()
    corrupted_archive := ~signed_archive
    corrupted_archive[corrupted_archive.len() - 1] ^= 1
    fs.write(sidecar, corrupted_archive).unwrap()
    rejected_signature :: jet().args(["hangar", "verify", "signed@fixture", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert_eq(rejected_signature.status.code(), Val(2), "stderr: {String.from_utf8_lossy(rejected_signature.stderr)}\nstdout: {String.from_utf8_lossy(rejected_signature.stdout)}")
    assert(String.from_utf8_lossy(rejected_signature.stderr).contains("Hangar verify failed"), "stderr: {String.from_utf8_lossy(rejected_signature.stderr)}")
    rejected_signature_json :: jet().args(["hangar", "verify", "signed@fixture", "--json", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert_eq(rejected_signature_json.status.code(), Val(2))
    rejected_signature_json_stdout :: String.from_utf8_lossy(rejected_signature_json.stdout)
    assert(rejected_signature_json_stdout.contains("\"schema\":\"jet.report/v1\""), "{rejected_signature_json_stdout}")
    assert(rejected_signature_json_stdout.contains("\"code\":\"E1340\""), "{rejected_signature_json_stdout}")
    assert(rejected_signature_json.stderr.is_empty())
    rejected_text := rejected_signature_json_stdout.trim() // #4303
    rejected_report :: JSON.parse(rejected_text).expect("verify JSON report")
    assert_eq(json_string(rejected_report, "schema"), "jet.report/v1")
    assert_eq(json_string(rejected_report, "moment"), "compile")
    assert_eq(json_string(rejected_report, "severity"), "error")
    fs.write(sidecar, signed_archive).unwrap()
    make_tree_writable(OSPath.from_text(entry.out))
    payload_path :: OSPath.from_text(entry.out).join("payload")
    fs.write(payload_path, "tampered bytes\n").unwrap()
    rejected_contents :: jet().args(["hangar", "verify", "signed@fixture", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert_eq(rejected_contents.status.code(), Val(2))
    assert(String.from_utf8_lossy(rejected_contents.stderr).contains("E1315"), "stderr: {String.from_utf8_lossy(rejected_contents.stderr)}")
    assert_eq(fs.read_to_string(payload_path).unwrap(), "tampered bytes\n")
}

// Rust: tests/jetpack_hangar_store_v2.rs:628
#Test("hangar_export_plan_does_not_create_archive_or_signer") {
    root :: Scratch.new("hangar-export-plan-root")
    project :: Scratch.new("hangar-export-plan-project")
    source :: Scratch.new("hangar-export-plan-source")
    fs.write(source.join("payload"), "plan only\n").unwrap()
    ingest :: jetpack().args(["hangar", "ingest", source.path.to_str().unwrap(), "--name", "planned", "--ref", "planned@fixture", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(ingest.status.success(), "stderr: {String.from_utf8_lossy(ingest.stderr)}")
    archive :: root.path.join("planned.hangar")
    planned :: jet().args(["hangar", "export", "planned@fixture", "--to", archive.to_str().unwrap(), "--json", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(planned.status.success(), "stderr: {String.from_utf8_lossy(planned.stderr)}")
    assert(planned.stderr.is_empty(), "JSON plan leaked stderr: {planned.stderr:?}")
    planned_stdout := String.from_utf8_lossy(planned.stdout).trim() // #4303
    planned_report :: JSON.parse(planned_stdout).expect("export plan JSON")
    assert_eq(json_string(planned_report, "schema"), "jet.report/v1")
    assert_eq(json_string(planned_report, "moment"), "tool")
    assert_eq(json_string(planned_report, "status"), "plan")
    assert_eq(json_string(planned_report, "action"), "export")
    assert(planned_report.get("applied").unwrap() == DataTree.Bool(false))
    assert(!archive.exists())
    assert(!root.path.join("trust/hangar.key").exists())
}

// Rust: tests/jetpack_hangar_store_v2.rs:695
#Test("hangar_export_import_rekeys_and_rejects_corruption_without_mutation") {
    source_root :: Scratch.new("hangar-archive-source-root")
    destination_root :: Scratch.new("hangar-archive-destination-root")
    project :: Scratch.new("hangar-archive-project")
    source :: Scratch.new("hangar-archive-source")
    fs.write(source.join("payload"), "portable bytes\n").unwrap()
    ingest :: jetpack().args(["hangar", "ingest", source.path.to_str().unwrap(), "--name", "portable", "--ref", "portable@fixture", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", source_root.path).output().unwrap()
    assert(ingest.status.success(), "stderr: {String.from_utf8_lossy(ingest.stderr)}")
    source_roots :: Store.Roots{root: source_root.path, dev_mode: false}
    source_entry :: Store.find_by_reference(source_roots, "portable@fixture").unwrap()
    archive :: source_root.path.join("portable.hangar")
    export :: jet().args(["hangar", "export", "portable@fixture", "--to", archive.to_str().unwrap(), "--yes", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", source_root.path).output().unwrap()
    export_stderr :: String.from_utf8_lossy(export.stderr)
    assert(export.status.success(), "stderr: {export_stderr}")
    assert(export_stderr.contains("export: ") && export_stderr.contains(" object(s)"))
    assert(archive.is_file())
    key :: source_root.path.join("trust/hangar.key")
    assert(key.is_file())
    import :: () -> jet().args(["hangar", "import", archive.to_str().unwrap(), "--key", key.to_str().unwrap(), "--yes", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", destination_root.path).output().unwrap()
    imported :: import()
    assert(imported.status.success(), "stderr: {String.from_utf8_lossy(imported.stderr)}")
    destination_roots :: Store.Roots{root: destination_root.path, dev_mode: false}
    destination_entry :: Store.find_by_reference(destination_roots, "portable@fixture").unwrap()
    assert_eq(destination_entry.envelope.output_hash, source_entry.envelope.output_hash)
    expected_destination_id :: Store.entry_id(destination_entry.name, destination_entry.version, destination_entry.reference, destination_entry.out)
    assert_eq(destination_entry.id, expected_destination_id, "source id: {source_entry.id}; source out: {source_entry.out}; destination out: {destination_entry.out}")
    assert_ne(destination_entry.id, source_entry.id)
    assert_eq(destination_entry.id, Store.entry_id(destination_entry.name, destination_entry.version, destination_entry.reference, destination_entry.out))
    Store.verify_hangar_object(destination_roots, destination_entry).unwrap()
    graph :: Store.closure_graph(destination_roots).unwrap()
    assert_eq(graph.records.get(destination_entry.id).unwrap().primary, destination_entry.envelope.output_hash)
    assert(!destination_entry.receipt.is_empty())
    assert(destination_roots.hangar_dir().join("receipts").join(destination_entry.receipt).is_file())
    repeated :: import()
    assert(repeated.status.success(), "repeated import stderr: {String.from_utf8_lossy(repeated.stderr)}")
    assert_eq(Store.list_checked(destination_roots).unwrap().len(), 1)
    corrupted :: source_root.path.join("portable-corrupt.hangar")
    bytes := fs.read(archive).unwrap()
    bytes[bytes.len() - 1] ^= 1
    fs.write(corrupted, bytes).unwrap()
    rejected :: jet().args(["hangar", "import", corrupted.to_str().unwrap(), "--key", key.to_str().unwrap(), "--yes", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", destination_root.path).output().unwrap()
    assert_eq(rejected.status.code(), Val(2), "stdout: {String.from_utf8_lossy(rejected.stdout)}\nstderr: {String.from_utf8_lossy(rejected.stderr)}")
    assert(String.from_utf8_lossy(rejected.stderr).contains("Hangar import failed"))
    after :: Store.find_by_reference(destination_roots, "portable@fixture").unwrap()
    assert_eq(after.id, destination_entry.id)
    assert_eq(after.envelope.output_hash, destination_entry.envelope.output_hash)
    assert_eq(fs.read_to_string(OSPath.from_text(after.out).join("payload")).unwrap(), "portable bytes\n")
}

// Rust: tests/jetpack_hangar_store_v2.rs:871
#Test("hangar_dump_restore_streams_one_archive_and_preserves_live_data_on_corruption") {
    source_root :: Scratch.new("hangar-dump-source-root")
    destination_root :: Scratch.new("hangar-dump-destination-root")
    project :: Scratch.new("hangar-dump-project")
    source :: Scratch.new("hangar-dump-source")
    fs.write(source.join("payload"), "streamed bytes\n").unwrap()
    ingest :: jetpack().args(["hangar", "ingest", source.path.to_str().unwrap(), "--name", "streamed", "--ref", "streamed@fixture", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", source_root.path).output().unwrap()
    assert(ingest.status.success(), "stderr: {String.from_utf8_lossy(ingest.stderr)}")
    dumped :: jet().args(["hangar", "dump", "streamed@fixture", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", source_root.path).output().unwrap()
    assert(dumped.status.success(), "stderr: {String.from_utf8_lossy(dumped.stderr)}")
    assert(dumped.stdout.starts_with("jet-hangar-archive-v1{TEXT_NUL}".bytes()), "dump must emit the canonical archive bytes")
    key :: source_root.path.join("trust/hangar.key")
    assert(key.is_file(), "dump must create the source Hangar signer")
    restore :: (bytes: [U8]) -> {
        child := jet().args(["hangar", "restore", "--key", key.to_str().unwrap(), "--yes", "--no-color"])
            .current_dir(project.path).env("JETPACK_ROOT", destination_root.path).stdin(Stdio.piped()).spawn().unwrap()
        &child.stdin.as_mut().unwrap().write_all(bytes).unwrap()
        drop(&child.stdin.take())
        child.wait_with_output().unwrap()
    }
    restored :: restore(dumped.stdout)
    assert(restored.status.success(), "stderr: {String.from_utf8_lossy(restored.stderr)}")
    roots :: Store.Roots{root: destination_root.path, dev_mode: false}
    entry :: Store.find_by_reference(roots, "streamed@fixture").unwrap()
    assert_eq(fs.read_to_string(OSPath.from_text(entry.out).join("payload")).unwrap(), "streamed bytes\n")
    repeated :: restore(dumped.stdout)
    assert(repeated.status.success(), "repeated restore stderr: {String.from_utf8_lossy(repeated.stderr)}")
    assert_eq(Store.list_checked(roots).unwrap().len(), 1)
    corrupt := ~dumped.stdout
    corrupt[corrupt.len() - 1] ^= 1
    rejected :: restore(corrupt)
    assert_eq(rejected.status.code(), Val(2))
    assert_eq(fs.read_to_string(OSPath.from_text(entry.out).join("payload")).unwrap(), "streamed bytes\n")
}

// Rust: tests/jetpack_hangar_store_v2.rs:972
#Test("hangar_copy_roundtrip_is_idempotent_and_conflict_safe") {
    source_root :: Scratch.new("hangar-copy-source-root")
    destination_root :: Scratch.new("hangar-copy-destination-root")
    project :: Scratch.new("hangar-copy-project")
    source :: Scratch.new("hangar-copy-source")
    fs.write(source.join("payload"), "copy me\n").unwrap()
    ingest :: jetpack().args(["hangar", "ingest", source.path.to_str().unwrap(), "--name", "copyable", "--ref", "copyable@fixture", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", source_root.path).output().unwrap()
    assert(ingest.status.success(), "stderr: {String.from_utf8_lossy(ingest.stderr)}")
    source_roots :: Store.Roots{root: source_root.path, dev_mode: false}
    source_entry :: Store.find_by_reference(source_roots, "copyable@fixture").expect("ingest must publish the source package record")
    source_payload :: OSPath.from_text(source_entry.out).join("payload")
    copy :: () -> jet().args(["hangar", "copy", "copyable@fixture", "--to", destination_root.path.to_str().unwrap(), "--yes", "--json", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", source_root.path).output().unwrap()
    first :: copy()
    assert(first.status.success(), "stderr: {String.from_utf8_lossy(first.stderr)}")
    first_stdout :: String.from_utf8_lossy(first.stdout)
    assert(first_stdout.contains("\"schema\":\"jet.report/v1\""), "{first_stdout}")
    assert(first_stdout.contains("\"action\":\"copy\""), "{first_stdout}")
    destination_roots :: Store.Roots{root: destination_root.path, dev_mode: false}
    destination_entry :: Store.find_by_reference(destination_roots, "copyable@fixture").expect("copy must publish the destination package record")
    Store.verify_hangar_object(destination_roots, destination_entry).unwrap()
    assert_eq(fs.read_to_string(OSPath.from_text(destination_entry.out).join("payload")).unwrap(), "copy me\n")
    repeated :: copy()
    assert(repeated.status.success(), "stderr: {String.from_utf8_lossy(repeated.stderr)}")
    assert_eq(first_stdout, String.from_utf8_lossy(repeated.stdout))
    assert_eq(Store.list_checked(destination_roots).unwrap().len(), 1)
    make_tree_writable(OSPath.from_text(destination_entry.out))
    destination_payload :: OSPath.from_text(destination_entry.out).join("payload")
    fs.write(destination_payload, "keep corrupt bytes\n").unwrap()
    rejected :: copy()
    assert_eq(rejected.status.code(), Val(2))
    rejected_stderr :: String.from_utf8_lossy(rejected.stderr)
    rejected_stdout :: String.from_utf8_lossy(rejected.stdout)
    assert(rejected_stdout.contains("conflicting digest"), "stderr: {rejected_stderr}\nstdout: {rejected_stdout}")
    assert_eq(fs.read_to_string(destination_payload).unwrap(), "keep corrupt bytes\n")
    assert_eq(fs.read_to_string(source_payload).unwrap(), "copy me\n")
}

// Rust: tests/jetpack_hangar_store_v2.rs:1087
#Test("hangar_repair_uses_jet_dispatch_and_restores_or_preserves_the_object") {
    root :: Scratch.new("hangar-repair-root")
    project :: Scratch.new("hangar-repair-project")
    source :: Scratch.new("hangar-repair-source")
    fs.write(source.join("payload"), "trusted bytes\n").unwrap()
    ingest :: jetpack().args(["hangar", "ingest", source.path.to_str().unwrap(), "--name", "repairable", "--ref", "repairable@fixture", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(ingest.status.success(), "stderr: {String.from_utf8_lossy(ingest.stderr)}")
    roots :: Store.Roots{root: root.path, dev_mode: false}
    entry :: Store.find_by_reference(roots, "repairable@fixture").unwrap()
    archive :: root.join("repairable.hangar")
    export :: jetpack().args(["hangar", "export", "repairable@fixture", "--to", archive.to_str().unwrap(), "--yes", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(export.status.success(), "stderr: {String.from_utf8_lossy(export.stderr)}")
    unsigned_archive :: root.join("unsigned.hangar")
    fs.write(unsigned_archive, Store.export_unsigned_archive(roots, entry.id, false).unwrap()).unwrap()
    payload :: OSPath.from_text(entry.out).join("payload")
    make_tree_writable(OSPath.from_text(entry.out))
    fs.write(payload, "tampered bytes\n").unwrap()
    rejected :: jet().args(["hangar", "repair", "repairable@fixture", "--from", unsigned_archive.to_str().unwrap(), "--yes", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert_eq(rejected.status.code(), Val(2))
    assert(String.from_utf8_lossy(rejected.stderr).contains("unsigned Hangar archives"), "stderr: {String.from_utf8_lossy(rejected.stderr)}")
    assert_eq(fs.read_to_string(payload).unwrap(), "tampered bytes\n")
    repair :: (archive: OSPath) -> jet().args(["hangar", "repair", "repairable@fixture", "--from", archive.to_str().unwrap(), "--yes", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    repaired :: repair(archive)
    assert(repaired.status.success(), "stderr: {String.from_utf8_lossy(repaired.stderr)}")
    assert_eq(fs.read_to_string(payload).unwrap(), "trusted bytes\n")
    Store.verify_hangar_object(roots, Store.find_by_reference(roots, "repairable@fixture").unwrap()).unwrap()
    repeated :: repair(archive)
    assert(repeated.status.success(), "repeated repair should be idempotent: {String.from_utf8_lossy(repeated.stderr)}")
    assert_eq(fs.read_to_string(payload).unwrap(), "trusted bytes\n")
    quarantine :: root.path.join("hangar").join("quarantine")
    fs.create_dir_all(quarantine).unwrap()
    // Crash after quarantine: preserve corrupt evidence and use signed archive next.
    make_tree_writable(OSPath.from_text(entry.out))
    fs.write(payload, "crashed corrupt bytes\n").unwrap()
    corrupt_backup :: quarantine.join("repair-{entry.envelope.output_hash}-corrupt")
    fs.rename(OSPath.from_text(entry.out), corrupt_backup).unwrap()
    seal_tree(corrupt_backup)
    recovered_corrupt :: jet().args(["hangar", "recover", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(recovered_corrupt.status.success(), "stderr: {String.from_utf8_lossy(recovered_corrupt.stderr)}")
    assert(!OSPath.from_text(entry.out).exists())
    assert(fs.read_dir(quarantine).unwrap().flatten().any(item -> item.file_name().to_string_lossy().starts_with("rejected-repair-")))
    repaired_after_crash :: repair(archive)
    assert(repaired_after_crash.status.success(), "stderr: {String.from_utf8_lossy(repaired_after_crash.stderr)}")
    assert_eq(fs.read_to_string(payload).unwrap(), "trusted bytes\n")
    make_tree_writable(OSPath.from_text(entry.out))
    crash_backup :: quarantine.join("repair-{entry.envelope.output_hash}-crash")
    fs.rename(OSPath.from_text(entry.out), crash_backup).unwrap()
    seal_tree(crash_backup)
    recovered :: jet().args(["hangar", "recover", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(recovered.status.success(), "stderr: {String.from_utf8_lossy(recovered.stderr)}")
    assert_eq(fs.read_to_string(payload).unwrap(), "trusted bytes\n")
    Store.verify_hangar_object(roots, Store.find_by_reference(roots, "repairable@fixture").unwrap()).unwrap()
    make_tree_writable(OSPath.from_text(entry.out))
    fs.remove_dir_all(OSPath.from_text(entry.out)).unwrap()
    repaired_missing :: repair(archive)
    assert(repaired_missing.status.success(), "stderr: {String.from_utf8_lossy(repaired_missing.stderr)}")
    assert_eq(fs.read_to_string(payload).unwrap(), "trusted bytes\n")
    Store.verify_hangar_object(roots, Store.find_by_reference(roots, "repairable@fixture").unwrap()).unwrap()
}

