    Store.verify_hangar_object(roots, entry).unwrap()
}

// Rust: tests/jetpack_hangar_store_v2.rs:1350
#Test("manual_external_root_cli_is_atomic_and_reports_stale_etag") {
    root :: Scratch.new("hangar-v2-manual-root")
    project :: Scratch.new("hangar-v2-manual-project")
    source :: Scratch.new("hangar-v2-manual-source")
    fs.write(source.join("payload"), "manual-root-bytes").unwrap()
    ingest :: jetpack().args(["hangar", "ingest", source.path.to_str().unwrap(), "--name", "manual", "--ref", "manual@fixture", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(ingest.status.success(), "stderr: {String.from_utf8_lossy(ingest.stderr)}")
    register :: jetpack().args(["hangar", "register-external-root", "backup-sdk", "manual@fixture", "--expires-in", "1w", "--yes", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).env("JETPACK_PRINCIPAL", "manual-root-cli").output().unwrap()
    assert(register.status.success(), "stderr: {String.from_utf8_lossy(register.stderr)}")
    assert(String.from_utf8_lossy(register.stderr).contains("etag 1.1"))
    listed :: jetpack().args(["hangar", "list-external-roots", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).env("JETPACK_PRINCIPAL", "manual-root-cli").output().unwrap()
    assert(listed.status.success())
    listed_stderr :: String.from_utf8_lossy(listed.stderr)
    assert(listed_stderr.contains("backup-sdk"))
    assert(listed_stderr.contains("etag 1.1"))
    stale :: jetpack().args(["hangar", "register-external-root", "backup-sdk", "manual@fixture", "--if-etag", "1.0", "--yes", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).env("JETPACK_PRINCIPAL", "manual-root-cli").output().unwrap()
    assert_eq(stale.status.code(), Val(2))
    stale_stderr :: String.from_utf8_lossy(stale.stderr)
    assert(stale_stderr.contains("Error [E1320]"), "{stale_stderr}")
    assert(stale_stderr.contains("No requested root mutation was applied."))
    diagnostic :: stale_stderr.find("Error [E1320]").map(index -> stale_stderr.slice(index..)).unwrap_or(stale_stderr)
    assert_jetos_stderr_snapshot_trimmed("external_root_stale_etag", diagnostic)
    unregister :: jetpack().args(["hangar", "unregister-external-root", "backup-sdk", "--etag", "1.1", "--yes", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).env("JETPACK_PRINCIPAL", "manual-root-cli").output().unwrap()
    assert(unregister.status.success(), "stderr: {String.from_utf8_lossy(unregister.stderr)}")
    assert(String.from_utf8_lossy(unregister.stderr).contains("Removed external root"))
}

// Rust: tests/jetpack_hangar_store_v2.rs:1462
#Test("hangar_recovery_reclaims_crashed_stages_and_idle_leases_without_following_escape") {
    root :: Scratch.new("hangar-v2-recovery-root")
    roots :: Store.Roots{root: root.path, dev_mode: false}
    archive_stage :: roots.hangar_dir().join(".archive-stage/abandoned")
    fs.create_dir_all(archive_stage).unwrap()
    fs.write(archive_stage.join("payload"), "partial archive").unwrap()
    dead_lease :: roots.root.join("leases/4294967295-0-abandoned")
    fs.create_dir_all(dead_lease).unwrap()
    fs.write(dead_lease.join("payload"), "lease snapshot").unwrap()
    assert_eq(Store.recover_hangar(roots).unwrap(), 2)
    assert(!roots.hangar_dir().join(".archive-stage/abandoned").exists())
    assert(!dead_lease.exists())
    if target.selected_family() == "unix" {
        outside :: Scratch.new("hangar-v2-recovery-outside")
        fs.write(outside.join("must-survive"), "live data").unwrap()
        stage_root :: roots.hangar_dir().join(".archive-stage")
        fs.remove_dir_all(stage_root).unwrap()
        fs.symlink(outside.path, stage_root).unwrap()
        error :: Store.recover_hangar(roots).unwrap_err()
        assert(error.to_string().contains("archive staging"), "{error}")
        assert_eq(fs.read_to_string(outside.join("must-survive")).unwrap(), "live data")
        fs.remove_file(stage_root).unwrap()
        lease_root :: roots.root.join("leases")
        fs.remove_dir_all(lease_root).unwrap()
        fs.symlink(outside.path, lease_root).unwrap()
        lease_error :: Store.recover_hangar(roots).unwrap_err()
        assert(lease_error.to_string().contains("lease directory"), "{lease_error}")
        assert_eq(fs.read_to_string(outside.join("must-survive")).unwrap(), "live data")
        fs.remove_file(lease_root).unwrap()
    }
}

// Rust: tests/jetpack_hangar_store_v2.rs:1508
#Test("hangar_verify_reports_corrupt_store_instead_of_empty_success") {
    root :: Scratch.new("hangar-v2-verify-corrupt-root")
    project :: Scratch.new("hangar-v2-verify-corrupt-project")
    source :: Scratch.new("hangar-v2-verify-corrupt-source")
    fs.write(source.join("payload"), "live bytes").unwrap()
    ingest :: jetpack().args(["hangar", "ingest", source.path.to_str().unwrap(), "--name", "verify-corrupt", "--ref", "verify-corrupt@fixture", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(ingest.status.success(), "stderr: {ingest.stderr:?}")
    roots :: Store.Roots{root: root.path, dev_mode: false}
    journal :: roots.hangar_dir().join("closure-db/journal")
    journal_entry :: fs.read_dir(journal).unwrap().map(entry -> entry.unwrap().path()).find(path -> path.extension().and_then(value -> value.to_str()) == Val("txn")).expect("committed closure transaction")
    journal_bytes :: fs.read(journal_entry).unwrap()
    fs.write(journal_entry, "corrupt closure journal".bytes()).unwrap()
    verify :: jet().args(["hangar", "verify", "verify-corrupt@fixture", "--json", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    fs.write(journal_entry, journal_bytes).unwrap()
    assert_eq(verify.status.code(), Val(2), "stdout: {String.from_utf8_lossy(verify.stdout)}\nstderr: {String.from_utf8_lossy(verify.stderr)}")
    assert(verify.stderr.is_empty(), "JSON verify leaked stderr: {verify.stderr:?}")
    report_text := String.from_utf8_lossy(verify.stdout).trim() // #4303
    report :: JSON.parse(report_text).expect("corrupt store report")
    assert_eq(json_string(report, "schema"), "jet.report/v1")
    assert_eq(json_string(report, "code"), "E1340")
    assert_eq(json_string(report, "what"), "could not read the Hangar")
    assert(!String.from_utf8_lossy(verify.stdout).contains("no hangar object"))
    assert_eq(fs.read_to_string(source.join("payload")).unwrap(), "live bytes")
}

// Rust: tests/jetpack_hangar_store_v2.rs:1582
#Test("hangar_du_rejects_corrupt_output_projection_without_following_escape") {
    root :: Scratch.new("hangar-v2-du-root")
    project :: Scratch.new("hangar-v2-du-project")
    source :: Scratch.new("hangar-v2-du-source")
    fs.write(source.join("payload"), "owned bytes").unwrap()
    ingest :: jetpack().args(["hangar", "ingest", source.path.to_str().unwrap(), "--name", "du-proof", "--ref", "du-proof@fixture", "--no-color"])
        .current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(ingest.status.success(), "stderr: {String.from_utf8_lossy(ingest.stderr)}")
    roots :: Store.Roots{root: root.path, dev_mode: false}
    entry :: Store.find_by_reference(roots, "du-proof@fixture").unwrap()
    entry_dir :: roots.hangar_dir().join(entry.id)
    make_tree_writable(entry_dir)
    outside :: Scratch.new("hangar-v2-du-outside")
    fs.write(outside.join("must-survive"), "outside bytes").unwrap()
    meta :: entry_dir.join("meta.json")
    original :: fs.read_to_string(meta).unwrap()
    escaped :: original.replace(entry.out, outside.path.to_string_lossy())
    assert_ne(escaped, original)
    fs.write(meta, escaped).unwrap()
    journal :: roots.hangar_dir().join("closure-db/journal")
    journal_backup :: roots.hangar_dir().join("closure-db/journal.corrupt-backup")
    fs.rename(journal, journal_backup).unwrap()
    du :: jetpack().args(["hangar", "du", "--json", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    fs.rename(journal_backup, journal).unwrap()
    assert_eq(du.status.code(), Val(2), "du stdout: {String.from_utf8_lossy(du.stdout)}; stderr: {String.from_utf8_lossy(du.stderr)}")
    assert(du.stderr.is_empty(), "JSON disk-usage failure leaked stderr: {du.stderr:?}")
    report_text := String.from_utf8_lossy(du.stdout).trim() // #4303
    report :: JSON.parse(report_text).expect("du corruption report")
    assert_eq(json_string(report, "schema"), "jet.report/v1")
    assert_eq(json_string(report, "moment"), "compile")
    assert_eq(json_string(report, "code"), "E1340")
    assert(entry.out.starts_with(root.path.to_str().unwrap()))
    assert(OSPath.from_text(entry.out).is_dir())
    assert_eq(fs.read_to_string(outside.path.join("must-survive")).unwrap(), "outside bytes")
    repair :: jetpack().args(["hangar", "recover", "--json", "--no-color"]).current_dir(project.path).env("JETPACK_ROOT", root.path).output().unwrap()
    assert(repair.status.success(), "repair stderr: {String.from_utf8_lossy(repair.stderr)}")
    assert(repair.stderr.is_empty(), "JSON repair leaked stderr")
    repair_text := String.from_utf8_lossy(repair.stdout).trim() // #4303
    repair_report :: JSON.parse(repair_text).expect("repair report")
    assert_eq(json_string(repair_report, "schema"), "jet.report/v1")
    assert_eq(json_string(repair_report, "action"), "recover")
    assert_eq(fs.read_to_string(meta).unwrap(), original)
    assert_eq(fs.read_to_string(outside.path.join("must-survive")).unwrap(), "outside bytes")
}

// Rust: tests/jetpack_hangar_store_v2.rs:1682
#Test("explain_json_uses_the_report_schema_for_registered_queries") {
    project :: Scratch.new("hangar-v2-explain-project")
    loop command in ["jet", "jetpack"] {
        process := if command == "jet" -> jet() else -> jetpack()
        output :: &process.args(["explain", "@", "--json", "--no-color"]).current_dir(project.path).output().unwrap()
        assert(output.status.success(), "{command} explain stderr: {String.from_utf8_lossy(output.stderr)}")
        assert(output.stderr.is_empty(), "{command} JSON explain leaked stderr")
        stdout :: String.from_utf8_lossy(output.stdout)
        assert(!stdout.contains("schema_version"), "legacy explain schema: {stdout}")
        report_text := stdout.trim() // #4303
        report :: JSON.parse(report_text).expect("explain report")
        assert_eq(json_string(report, "schema"), "jet.report/v1")
        assert_eq(json_string(report, "moment"), "tool")
        assert_eq(json_string(report, "action"), "explain")
        assert_eq(json_string(report, "status"), "ok")
    }
}

// Rust: tests/jetpack_hangar_store_v2.rs:1714
#Test("hangar_quota_evicts_oldest_unreferenced_before_publishing_past_ceiling") {
    root :: Scratch.new("hangar-quota-root")
    roots :: Store.Roots.at(root.path)
    oldest :: quota_fixture(roots, "oldest", U8{97}, 4 * 1024 * 1024)
    newer :: quota_fixture(roots, "newer", U8{98}, 4 * 1024 * 1024)
    Store.test_backdate_last_used_at(roots, oldest.id, 1).unwrap()
    Store.test_backdate_last_used_at(roots, newer.id, 2).unwrap()
    before :: logical_bytes(roots.hangar_dir())
    limit :: before - 2 * 1024 * 1024
    fs.create_dir_all(root.path.join("config")).unwrap()
    fs.write(root.path.join("config/hangar-max-bytes"), "{limit}\n").unwrap()
    assert(before > limit)
    admitted :: quota_fixture(roots, "admitted", U8{99}, 64 * 1024)
    after :: logical_bytes(roots.hangar_dir())
    assert(after <= limit, "quota admitted {after} logical bytes above ceiling {limit}")
    assert(!root.path.join("hangar").join(oldest.id).exists())
    assert(root.path.join("hangar").join(newer.id).exists())
    assert(root.path.join("hangar").join(admitted.id).exists())
}

// Rust: tests/jetpack_hangar_store_v2.rs:1785
#Test("nix_project_cas_bundle_rejects_tamper_and_missing_bytes") {
    root :: Scratch.new("nix-cas-bundle-root")
    project :: Scratch.new("nix-cas-bundle-project")
    server :: nix_index_cache_server.NixIndexCacheServer.start_ripgrep(project.path)
    server.install(root.path)
    fs.write(project.join("env.jet"), "module dev {{\n    sources: {{ default: NixOS/nixpkgs/nixpkgs-unstable@github }}\n    env.dev: Env{{ packages: [default.ripgrep] }}\n}}\n").unwrap()
    fs.create_dir_all(project.join(".jet")).unwrap()
    fs.write(project.join(".jet/lock"), "version = 1\n\n[[source_channel]]\nname = \"default\"\nchannel = \"{nix_index_cache_server.CHANNEL}\"\nexact = \"github:NixOS/nixpkgs#{nix_index_cache_server.REVISION}\"\n\n[root]\ndependencies = []\n").unwrap()
    build :: jetpack().args(["env", "--prep", "--no-color", "--trust", "--yes"]).current_dir(project.path).env("JETPACK_ROOT", root.path).env("PATH", "").output().unwrap()
    assert(build.status.success(), "stdout: {String.from_utf8_lossy(build.stdout)}\nstderr: {String.from_utf8_lossy(build.stderr)}")
    roots :: Store.Roots.at(root.path)
    entry :: Store.list_checked(roots).unwrap().into_iter().find(entry -> entry.name == "ripgrep").expect("index-backed Nix entry")
    producer :: Store.ProducerRecord.decode(entry.producer_record).expect("Nix producer")
    assert_eq(producer.provider, "nix")
    assert_eq(producer.facts.get("nix.index.revision"), Val(nix_index_cache_server.REVISION))
    assert_eq(producer.facts.get("nix.index.system"), Val(nix_index_cache_server.SYSTEM))
    assert(producer.facts.get("nix.cache.key").is_some_and(value -> value.len() == 64))
    digest :: Store.publish_nix_cas_bundle(project.path, roots, entry.id).unwrap()
    bundle :: project.path.join(".jet/nix-cas").join(digest)
    bytes := fs.read(bundle).unwrap()
    bytes[bytes.len() - 1] ^= 1
    fs.write(bundle, bytes).unwrap()
    imported_root :: Scratch.new("nix-cas-bundle-import")
    imported :: Store.Roots.at(imported_root.path)
    assert(Store.import_nix_cas_bundle(project.path, imported, digest).is_err(), "tampered project CAS bytes must fail closed")
    fs.remove_file(bundle).unwrap()
    assert(Store.import_nix_cas_bundle(project.path, imported, digest).is_err(), "missing project CAS bytes must fail closed")
}
