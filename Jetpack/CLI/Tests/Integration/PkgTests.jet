// Rust: tests/pkg.rs:76
#Test("shape6_registry_routes_and_retired_bare_snapshots") {
    tmp :: tmp_dir("shape6_registry")
    store :: tmp.join("store")
    fs.create_dir_all(store).expect("create store")
    key :: jet_cmd(["registry", "key"], &tmp, &store)
    assert(!key.status.success())
    assert_eq(String.from_utf8(key.stderr).expect("UTF-8 error"), "Error [E2104]: `jet registry key` needs a subcommand — try `jet registry key backup`.\n Why: Jet needs valid command input before it can run this command\n Fix: correct the named argument or input, then run the command again\n")
    for verb in ["publish", "keygen", "key", "yank"] {
        bare :: jet_cmd([verb, "sentinel"], &tmp, &store)
        assert_eq(bare.status.code(), Some(2), "bare jet {verb}")
        assert_eq(String.from_utf8(bare.stderr).expect("UTF-8 error"), "Error [E2101]: `{verb}` moved under `jet registry`.\n Why: infrequent commands live in a named area so daily Jet commands stay easy to scan.\n Fix: run `jet registry {verb} sentinel`.\n")
    }
    fs.remove_dir_all(tmp).expect("remove scratch")
}

// Rust: tests/pkg.rs:387
#Test("strict_graph_rejects_transitive_import") {
