    assert_eq(out.merged.records.len(), 2)
}

// Rust: tests/pkg.rs:645
#Test("lock_explain_names_owner_policy_provider_platform") {
    lock :: SemanticLockFile { records: [semantic_record("app", "core.log", "1.2.3")], ..SemanticLockFile.default() }
    fact :: SemanticLock.explain(&lock, "package:core.log").expect("explain fact")
    assert_eq(fact.owners, ["app"])
    assert_eq(fact.provider, "core")
    assert_eq(fact.platform, "x86_64-linux")
    assert_eq(fact.policy_fingerprint, "policy-1")
    assert_eq(fact.contenders.len(), 1)
}

// Rust: tests/pkg.rs:660
#Test("lock_satisfied_offline_verbs_do_not_touch_network") {
    obj :: ProviderObject { family: ProviderFamily.Npm, ref_key: "left-pad", exact_identity: "npm:left-pad@1.0.0", hash: "sha256-aa", platform: "any", signature: "", audit: [], sandbox_effects: [], build_effects: [] }
    graph := AuthorityGraph.default()
    graph.add_locked(obj)
    decision :: graph.fetch_allowed(&ProviderRequest { family: ProviderFamily.Npm, ref_key: "left-pad", exact_identity: "npm:left-pad@1.0.0", hash: "sha256-aa", platform: "any", offline: true })
    assert_eq(decision, FetchDecision.AllowedOfflineSatisfied)
}

