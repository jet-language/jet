// Rust: tests/pkg.rs:1593
#Test("manifest_parse_import_boundaries") {
    raw :: min_manifest("app", "0.1.0") + "\nboundaries: {{\n    deny: [\n        {{ from: \"app.ui\", to: \"app.db\" }},\n        {{ from: \"app.api.*\", to: \"app.db.*\" }},\n    ],\n}}\n"
    mf :: Manifest.parse(&OSPath.from("package.jet"), &raw).expect("boundary policy should parse")
    assert_eq(mf.boundaries.len(), 2)
    assert_eq(mf.boundaries[0].from, "app.ui")
    assert_eq(mf.boundaries[0].to, "app.db")
    assert(mf.boundaries[1].matches("app.api.auth", "app.db.users"))
    assert(!mf.boundaries[1].matches("app.web", "app.db.users"))
}

// Rust: tests/pkg.rs:1613
#Test("manifest_parse_import_boundaries_rejects_malformed_patterns") {
    for (label, pattern) in [("unquoted", "app.ui"), ("interior wildcard", "app.*.ui"), ("multiple wildcards", "app.**")] {
        raw :: min_manifest("app", "0.1.0") + "boundaries: {{ deny: [{{ from: {pattern}, to: \"app.db\" }}] }}\n"
        error :: Manifest.parse(&OSPath.from("package.jet"), &raw).expect_err("malformed boundary pattern must use E1206")
        assert_eq(error.code, "E1206", "{label}")
        assert(error.what.contains("package.jet"), "{label}: {error.what}")
    }
    for (label, block) in [
        ("unknown boundary field", "boundaries: {{ allow: [{{ from: \"app.ui\", to: \"app.db\" }}] }}"),
        ("missing from", "boundaries: {{ deny: [{{ to: \"app.db\" }}] }}"),
        ("missing to", "boundaries: {{ deny: [{{ from: \"app.ui\" }}] }}"),
        ("duplicate edge field", "boundaries: {{ deny: [{{ from: \"app.ui\", from: \"app.api\", to: \"app.db\" }}] }}")
    ] {
        raw :: min_manifest("app", "0.1.0") + block + "\n"
        error :: Manifest.parse(&OSPath.from("package.jet"), &raw).expect_err("malformed boundary record must use E1206")
        assert_eq(error.code, "E1206", "{label}")
    }
}

// Rust: tests/pkg.rs:1651
#Test("loader_enforces_import_boundaries_and_warns_on_zero_match") {
    denied :: tmp_dir("import_boundary_denied")
    write(&denied, "package.jet", &(min_manifest("app", "0.1.0") + "boundaries: {{ deny: [{{ from: \"app.ui\", to: \"app.db\" }}] }}\n"))
    write(&denied, "ui.jet", "use db\nfn run() -[IO]> {{ }}\n")
    write(&denied, "db.jet", "pub fn value() -> Int {{ 1 }}\n")
    error :: Loader.load_entry(denied.join("ui.jet").to_str().expect("UTF-8 entry")).expect_err("a denied import edge must fail during loading")
    assert_eq(first_diag_code(&error), "E0619")
    assert(error[0].what.contains("app.ui"))
    assert(error[0].what.contains("app.db"))
    fs.remove_dir_all(denied).expect("remove denied project")
    unused :: tmp_dir("import_boundary_unused")
    write(&unused, "package.jet", &(min_manifest("app", "0.1.0") + "boundaries: {{ deny: [{{ from: \"app.ui\", to: \"app.db\" }}] }}\n"))
    write(&unused, "ui.jet", "fn run() {{ }}\n")
    bundle :: Loader.load_entry(unused.join("ui.jet").to_str().expect("UTF-8 entry")).expect("an unmatched boundary is a warning")
    assert(bundle.parse_teaching.iter().any((diagnostic) -> diagnostic.code == "L0619"))
    fs.remove_dir_all(unused).expect("remove unused project")
}

// Rust: tests/pkg.rs:1686
#Test("loader_records_import_edge_facts_and_erases_boundary_policy_before_codegen") {
    root :: tmp_dir("import_boundary_structure_fact")
    write(&root, "package.jet", &(min_manifest("app", "0.1.0") + "boundaries: {{ deny: [{{ from: \"app.ui\", to: \"app.hidden.*\" }}] }}\n"))
    write(&root, "ui.jet", "use db\nfn run() -[IO]> {{ print(db.value()) }}\n")
    write(&root, "db.jet", "pub fn value() -> Int {{ 1 }}\n")
    entry :: root.join("ui.jet")
    shown :: entry.to_str().expect("UTF-8 entry")
    bundle := Loader.load_entry(shown).expect("allowed edge must load")
    diagnostics :: Sema.check_bundle(&bundle, Sema.CompileMode.Run)
    assert(diagnostics.iter().all((diagnostic) -> diagnostic.severity == Diagnostics.Severity.Lint), "allowed boundary edge diagnostics: {diagnostics:?}")
    edge :: bundle.name_ledger.structure_facts().iter().find((fact) -> fact.kind == StructureFactKind.ImportEdge).expect("allowed edge structure fact")
    assert_eq(edge.subject, "app.ui -> app.db")
    assert_eq(edge.status, "allowed")
    assert_eq(edge.gate.as_deref(), Some("manifest rule edit"))
    gates :: Sema.GateLedger.GateLedger.collect(&bundle, Policy.GateSet.default())
    assert(gates.entries().iter().any((entry) -> entry.kind == Sema.GateLedger.GateKind.Structure && entry.scope == "import-edge" && entry.subject == "app.ui -> app.db"))
    inspected_output :: Command.new(jet_bin()).current_dir(root).args(["inspect", "structure", shown]).env("NO_COLOR", "1").output().expect("inspect structure must run")
    assert(inspected_output.status.success(), "inspect failed: {inspected_output:?}")
    inspected :: String.from_utf8(inspected_output.stdout).expect("inspection is UTF-8")
    assert(inspected.contains("Structure.ImportEdge"))
    assert(inspected.contains("app.ui -> app.db"))
    assert(inspected.contains("manifest rule edit"))
    // Rust generated-source/JIT/interpreter assertions migrate to native tier behavior.
    // The structural boundary remains inspection-only while every executable tier
    // runs the allowed edge and returns exactly the same observable output.
    for tier in ["O0", "O1", "O2"] {
        output :: build_and_run(&entry, tier, &root.join(".cache").join(tier)).expect("allowed edge must codegen and run")
        assert(output.status.success(), "{tier} failed: stdout={String.from_utf8_lossy(output.stdout)} stderr={String.from_utf8_lossy(output.stderr)}")
        assert_eq(output.stdout, "1\n".as_bytes(), "{tier} output")
        assert(!String.from_utf8_lossy(output.stdout).contains("manifest rule edit"))
        assert(!String.from_utf8_lossy(output.stdout).contains("app.hidden.*"))
    }
    dev_output :: Command.new(jet_bin()).current_dir(root).args(["dev", shown, "--watch=off"]).env("NO_COLOR", "1").env("JET_RUN_CACHE_DIR", root.join(".cache/dev/run")).env("JET_STORE_DIR", root.join(".cache/dev/build")).output().expect("dev command must run")
    assert(dev_output.status.success(), "dev failed: stdout={String.from_utf8_lossy(dev_output.stdout)} stderr={String.from_utf8_lossy(dev_output.stderr)}")
    assert_eq(dev_output.stdout, "1\n".as_bytes(), "dev output")
    if have_web_target() {
        output :: Command.new(jet_bin()).current_dir(root).args(["build", "--target=web", shown]).env("NO_COLOR", "1").env("JET_STORE_DIR", root.join(".cache/web")).output().expect("web command must run")
        assert(output.status.success(), "web failed: stdout={String.from_utf8_lossy(output.stdout)} stderr={String.from_utf8_lossy(output.stderr)}")
    } else {
        eprintln("note: skipping import-boundary web tier proof (wasm target unavailable)")
    }
    fs.remove_dir_all(root).expect("remove boundary project")
}
