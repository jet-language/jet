// Rust: tests/pkg.rs:499
#Test("lock_record_kinds_roundtrip_unknown_future_fields") {
    raw :: "semantic-lock-version = 1\n\n[[semantic_record]]\nkind = \"future-kind\"\nkey = \"k\"\nexact = \"e\"\nhash = \"h\"\nplatform = \"p\"\nfuture-key = \"future-value\"\n"
    parsed :: SemanticLock.parse(&raw)
    assert(match parsed.records[0].identity.kind { LockRecordKind.Future(_) -> true; _ -> false })
    assert_eq(parsed.records[0].future_fields.get("future-key"), Some("future-value"))
    reparsed :: SemanticLock.parse(&SemanticLock.write(&SemanticLockFile { records: parsed.records, ..SemanticLockFile.default() }))
    assert_eq(reparsed.records[0].future_fields.get("future-key"), Some("future-value"))
}

