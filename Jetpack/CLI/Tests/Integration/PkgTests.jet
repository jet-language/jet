        }
        _ -> panic("prefer policy should activate replacement")
    }
}

// Rust: tests/pkg.rs:1455
#Test("replacement_lock_records_foreign_native_proof_and_policy") {
    candidate :: replacement_passed_candidate()
    record :: Replacement.replacement_lock_record(&candidate, "app", "x86_64-linux", "policy.replacements:npm:left-pad@1.0.0=>core:core.text.pad@1.0.0:allow")
    assert_eq(record.future_fields.get("replacement-foreign").map((s) -> s.as_str()), Some("npm:left-pad@1.0.0"))
    assert_eq(record.future_fields.get("replacement-native").map((s) -> s.as_str()), Some("core:core.text.pad@1.0.0"))
    assert_eq(record.future_fields.get("replacement-proof-digest").map((s) -> s.as_str()), Some(candidate.proof_digest.as_str()))
    assert_eq(record.future_fields.get("replacement-proof-inputs").map((s) -> s.contains("platform=x86_64-linux")), Some(true))
    assert(record.rationales[0].policy_fingerprint.contains("policy.replacements"))
}

// Rust: tests/pkg.rs:1497
#Test("replacement_lock_merge_conflict_names_owners") {
    foreign :: replacement_identity("npm", "left-pad", "1.0.0")
    mk_candidate :: (native: String) -> ReplacementCandidate {
        foreign_identity: foreign.clone(), native_identity: PackageIdentity.new("core", native, "1.0.0"),
        covered_public_symbols: ["pad_left"], unsupported_symbols: [], license: "MIT",
        platforms: ["x86_64-linux"], proof_status: ProofStatus.Passed, proof_digest: "proof-{native}",
        proof_inputs: ["platform=x86_64-linux;native={native}"]
    }
    left :: SemanticLockFile { records: [Replacement.replacement_lock_record(&mk_candidate("core.text.pad"), "app", "x86_64-linux", "policy-left")], ..SemanticLockFile.default() }
    right :: SemanticLockFile { records: [Replacement.replacement_lock_record(&mk_candidate("core.string.pad"), "app", "x86_64-linux", "policy-right")], ..SemanticLockFile.default() }
    out :: SemanticLock.merge(&SemanticLockFile.default(), &left, &right)
    assert_eq(out.conflicts.len(), 1)
    assert_eq(out.conflicts[0].owner_package, "app")
    assert_eq(out.conflicts[0].semantic_key, "replacement-overlay:npm:left-pad@1.0.0@x86_64-linux")
}

