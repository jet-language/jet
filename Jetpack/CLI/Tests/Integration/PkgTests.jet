// Rust: tests/pkg.rs:961
#Test("provider_report_round_trips_through_lock_and_explain") {
    native :: "{{\"name\":\"web\",\"version\":\"1.0.0\",\"license\":\"MIT\",\"dependencies\":{{\"vite\":\"5\"}}}}"
    report :: ProviderGraph.normalize_provider_document(ProviderFamily.Npm, &native)
    report.validate().expect("lossless npm report")
    shared :: report.shared_facts()
    assert_eq(shared.qualified_reference(), "web#version=1.0.0@npm")
    assert_eq(shared.native_document, native)
    assert(shared.explain_lines().iter().any((line) -> line == "native json: retained"))
    round_trip :: ProviderFacts.from_json(&report.export_json()).expect("shared provider facts JSON")
    assert_eq(round_trip, shared)
    lock :: report.lock_record("app", "web@npm#1.0.0", "any").expect("provider semantic lock")
    assert_eq(lock.identity.exact, "web#version=1.0.0@npm")
    digest :: shared.digest()
    assert_eq(lock.future_fields.get("provider-facts-digest"), Some(&digest))
}

// Rust: tests/pkg.rs:988
#Test("provider_report_surfaces_missing_identity_as_loss") {
    report :: ProviderGraph.normalize_provider_document(ProviderFamily.Npm, "{{\"name\":\"web\"}}")
    assert(!report.is_lossless())
    error :: report.validate().expect_err("missing provider version")
    assert(error.contains("lossy") || error.contains("exact"), "{error}")
    shared :: report.shared_facts_for("web@npm")
    assert(shared.losses.iter().any((loss) -> loss.reason.contains("exact version")))
}

// Rust: tests/pkg.rs:1005
#Test("provider_report_preserves_alias_resolution_and_typed_native_facts") {
    native :: "{{\"name\":\"web\",\"version\":\"1.0.0\",\"yanked\":false}}"
    report :: ProviderGraph.normalize_provider_document(ProviderFamily.Npm, &native)
    shared :: report.shared_facts_for("web@catalog")
    shared.validate().expect("catalog alias remains lossless")
    assert_eq(shared.qualified_reference(), "web#version=1.0.0@catalog")
    assert_eq(shared.native_document, native)
    assert_eq(shared.facts.get("provider.resolved_selector"), Some(&ProviderFactValue.Text("#version=1.0.0")))
    assert_eq(shared.facts.get("provider.npm.native.yanked"), Some(&ProviderFactValue.List([ProviderFactValue.Bool(false)])))
    lock :: report.lock_record("app", "web@catalog", "any").expect("alias lock retains source authority")
    assert_eq(lock.identity.exact, "web#version=1.0.0@catalog")
    locked :: ProviderFacts.from_json(lock.future_fields.get("provider-facts").expect("provider facts in lock")).expect("locked provider facts")
    locked.validate().expect("locked alias facts")
    assert_eq(locked.reference, "web@catalog")
}

// Rust: tests/pkg.rs:1040
#Test("swiftpm_v2_report_keeps_revision_and_native_bytes") {
    revision :: "0123456789abcdef0123456789abcdef01234567"
    native :: "{{\"pins\":[{{\"identity\":\"swift-log\",\"state\":{{\"revision\":\"{revision}\",\"version\":\"1.5.4\"}}}}]}}"
    report :: ProviderGraph.normalize_provider_document(ProviderFamily.SwiftPM, &native)
    report.validate().expect("SwiftPM v2 pin is lossless")
    shared :: report.shared_facts()
    assert_eq(shared.qualified_reference(), "swift-log#revision={revision}@swiftpm")
    assert_eq(shared.native_document, native)
    assert(shared.facts.get("provider.revision").is_some_and((value) -> "{value:?}".contains(revision)))
}

// Rust: tests/pkg.rs:1061
#Test("homebrew_report_reads_stable_version_and_dependencies") {
