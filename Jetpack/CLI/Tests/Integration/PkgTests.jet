}

// Rust: tests/pkg.rs:407
#Test("catalog_edge_behaves_like_direct_dep_after_selection") {
    graph := graph_with_app()
    graph.add_catalog(CatalogEntry { logical_name: "log", provider_ref: "core.log@1.2.3", version_rule: "1.2", allowed_packages: ["app"], owner_workspace: "root", rationale: "workspace selected shared logging version" })
    edge :: graph.check_visible("app", "log").expect("catalog edge visible")
    assert_eq(edge.kind, VisibleEdgeKind.Catalog)
    assert_eq(edge.provider_ref, "core.log@1.2.3")
}

// Rust: tests/pkg.rs:426
#Test("lock_records_catalog_owner_and_rationale") {
    lock :: SemanticLockFile { records: [semantic_record("app", "core.log", "1.2.3")], ..SemanticLockFile.default() }
    text :: SemanticLock.write(&lock)
    assert(text.contains("owner-package = \"app\""))
    assert(text.contains("reason = \"app declared core.log\""))
    parsed :: SemanticLock.parse(&text)
    assert_eq(parsed.records[0].rationales[0].owner_package, "app")
}

// Rust: tests/pkg.rs:440
#Test("catalog_merge_conflict_names_owner_package") {
    left :: SemanticLockFile { records: [semantic_record("app", "core.log", "1.2.3")], ..SemanticLockFile.default() }
    right :: SemanticLockFile { records: [semantic_record("app", "core.log", "1.3.0")], ..SemanticLockFile.default() }
    out :: SemanticLock.merge(&SemanticLockFile.default(), &left, &right)
    assert_eq(out.conflicts.len(), 1)
    assert_eq(out.conflicts[0].owner_package, "app")
    assert_eq(out.conflicts[0].semantic_key, "package:core.log")
}

