// Rust: tests/pkg.rs:7275
#Test("registry_fetch_rejects_tampered_referrer_index_before_hangar_ingest") {
    if !jet_bin().is_file() || !have_git() {
        eprintln("note: skipping registry_fetch_rejects_tampered_referrer_index (need built binary and git)")
        return
    }
    tmp :: tmp_dir("registry_referrer_tamper")
    publisher :: tmp.join("publisher")
    consumer :: tmp.join("consumer")
    tamper :: tmp.join("tamper")
    bare :: tmp.join("registry.git")
    url :: bare_registry(&bare)
    cache :: tmp.join("registry-cache")
    store :: tmp.join("legacy-store")
    hangar_root :: tmp.join("jetpack-root")
    keys :: tmp.join("keys")
    fs.create_dir_all(publisher) ?? panic("publisher")
    fs.create_dir_all(consumer) ?? panic("consumer")
    fs.create_dir_all(store) ?? panic("store")
    init_clean_project(&publisher, "refkit", "1.2.0")
    seed_core_review(&bare, "refkit", "1.2.0")
    publish :: jet_cmd_env(["registry", "publish"], &publisher, [("JET_REGISTRY_URL", url.as_str()), ("JET_REGISTRY_CACHE_DIR", cache.to_str().expect("cache")), ("JET_PACKAGE_STORE_DIR", store.to_str().expect("store")), ("JET_KEYS_DIR", keys.to_str().expect("keys"))])
    assert(publish.status.success(), "registry publish failed:\n{String.from_utf8_lossy(publish.stderr)}")
    entry :: read_index_file(&bare, "refkit").and_then((text) -> text.lines().find_map(Publish.IndexEntry.parse_line)) ?? panic("published refkit entry")
    assert(Command.new("git").args(["clone", url.as_str(), tamper.to_str().expect("tamper")]).status().expect("clone").success())
    referrer_index :: tamper.join("referrers").join(entry.content_hash).join("index.json")
    bytes := fs.read(referrer_index) ?? panic("read index")
    bytes.push(10)
    fs.write(referrer_index, bytes) ?? panic("tamper index")
    for args in [["config", "user.email", "test@jet.test"], ["config", "user.name", "Jet Test"], ["add", "."], ["commit", "-m", "tamper referrer index"], ["push", "origin", "HEAD:main"]] {
        assert(Command.new("git").args(args).current_dir(tamper).status().expect("git").success(), "tamper registry command failed: {args}")
    }
    raw :: manifest_with_deps("ref-consumer", "0.1.0", "    refkit: refkit#1.2.0,")
    write(&consumer, "package.jet", &raw)
    manifest :: Manifest.parse(consumer.join("package.jet"), &raw) ?? panic("manifest")
    opts :: Fetch.FetchOptions { locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative }
    denied :: with_store(&store, () -> {
        previous :: ["JET_REGISTRY_URL", "JET_REGISTRY_CACHE_DIR", "JET_KEYS_DIR", "JETPACK_ROOT"].map((key) -> (key, std.env.var_os(key)))
        std.env.set_var("JET_REGISTRY_URL", url)
        std.env.set_var("JET_REGISTRY_CACHE_DIR", cache)
        std.env.set_var("JET_KEYS_DIR", keys)
        std.env.set_var("JETPACK_ROOT", hangar_root)
        result :: Fetch.fetch(&consumer, &manifest, None, &opts)
        for (key, value) in previous {
            match value { Val(value) -> std.env.set_var(key, value), None -> std.env.remove_var(key) }
        }
        result
    }).expect_err("a referrer index changed outside signed metadata must fail closed")
    assert_eq(denied[0].code, "E1207")
    assert(denied[0].fix.contains("restore the immutable OCI referrer set") || denied[0].what.contains("OCI referrer index digest"), "tampered referrer recovery must be explicit: {denied[0]}")
    assert(Store.list(&Store.Roots.at(hangar_root)).into_iter().all((entry) -> !(entry.name == "refkit" && entry.version == "1.2.0")), "tampered registry evidence must not reach Hangar")
    make_tree_writable(&tmp)
    fs.remove_dir_all(tmp) ?? panic("cleanup")
}

// Rust: tests/pkg.rs:7404
#Test("registry_fetch_applies_artifact_dependency_roles_features_and_constraints") {
    if !jet_bin().is_file() || !have_git() {
        eprintln("note: skipping registry dependency metadata delivery (need built binary and git)")
        return
    }
    tmp :: tmp_dir("registry_dependency_metadata")
    bare :: tmp.join("registry.git")
    url :: bare_registry(&bare)
    cache :: tmp.join("registry-cache")
    keys :: tmp.join("keys")
    store :: tmp.join("store")
    hangar_root :: tmp.join("jetpack-root")
    consumer :: tmp.join("consumer")
    fs.create_dir_all(store) ?? panic("store")
    fs.create_dir_all(consumer) ?? panic("consumer")
    publish :: (name: String, version: String, metadata: String?) -> {
        project :: tmp.join("publish-{name}-{version}")
        fs.create_dir_all(project) ?? panic("project")
        init_clean_project(&project, name, version)
        if metadata == Val(metadata) {
            write(&project, "registry.json", metadata)
            for args in [["add", "."], ["commit", "-m", "registry metadata"]] {
                _ :: Command.new("git").args(args).current_dir(project).output() ?? panic("commit metadata")
            }
        }
        seed_core_review(&bare, name, version)
        output :: jet_cmd_env(["registry", "publish"], &project, [("JET_REGISTRY_URL", url.as_str()), ("JET_REGISTRY_CACHE_DIR", cache.to_str().expect("cache")), ("JET_PACKAGE_STORE_DIR", store.to_str().expect("store")), ("JET_KEYS_DIR", keys.to_str().expect("keys"))])
        assert(output.status.success(), "publishing {name} {version} failed:\n{String.from_utf8_lossy(output.stderr)}")
    }
    publish("runtime", "1.0.0", None)
    publish("runtime", "1.0.1", None)
    publish("buildtool", "1.0.0", None)
    publish("trace", "1.0.0", None)
    publish("rolekit", "1.0.0", Val("{\"name\":\"rolekit\",\"version\":\"1.0.0\",\"dependencies\":{\"runtime\":\"^1.0\"},\"build_dependencies\":{\"buildtool\":\"1.0.0\"},\"dev_dependencies\":{\"devkit\":\"1.0.0\"},\"optional_dependencies\":{\"trace\":\"1.0.0\"},\"features\":{\"default\":[\"trace\"]},\"constraints\":{\"runtime\":{\"require\":\"^1.0\",\"prefer\":\"1.0.1\",\"reject\":[\"1.0.1\"],\"strict\":true}}}"))
    raw :: manifest_with_deps("consumer", "0.1.0", "    rolekit: rolekit#1.0.0,")
    write(&consumer, "package.jet", &raw)
    manifest :: Manifest.parse(consumer.join("package.jet"), &raw) ?? panic("manifest")
    opts :: Fetch.FetchOptions { locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Latest }
    (lock, dep_dirs) :: with_store(&store, () -> {
        previous :: ["JET_REGISTRY_URL", "JET_REGISTRY_CACHE_DIR", "JET_KEYS_DIR", "JETPACK_ROOT"].map((key) -> (key, std.env.var_os(key)))
        std.env.set_var("JET_REGISTRY_URL", url)
        std.env.set_var("JET_REGISTRY_CACHE_DIR", cache)
        std.env.set_var("JET_KEYS_DIR", keys)
        std.env.set_var("JETPACK_ROOT", hangar_root)
        result :: Fetch.fetch(&consumer, &manifest, None, &opts)
        for (key, value) in previous { match value { Val(value) -> std.env.set_var(key, value), None -> std.env.remove_var(key) } }
        result.expect("artifact dependency metadata should resolve through Hangar")
    })
    rolekit :: lock.packages.iter().find((package) -> package.name == "rolekit") ?? panic("rolekit must be locked")
    assert_eq(rolekit.version, "1.0.0")
    assert(rolekit.dependencies.contains("runtime") && rolekit.dependencies.contains("buildtool") && rolekit.dependencies.contains("trace"), "active normal/build/default-feature edges must enter the lock: {rolekit.dependencies}")
    assert(!rolekit.dependencies.contains("devkit"), "dev dependency must stay outside the production closure")
    assert_eq(lock.packages.iter().find((package) -> package.name == "runtime").map((package) -> package.version.as_str()), Val("1.0.0"), "reject must exclude 1.0.1 even though prefer requests it")
    assert(dep_dirs.contains_key("buildtool") && dep_dirs.contains_key("trace"))
    lock_text :: fs.read_to_string(consumer.join(".jet/lock")) ?? panic("lock")
    assert(lock_text.contains("dependency-metadata = "), "semantic lock must carry the exact artifact-bound dependency meaning")
    locked_opts :: Fetch.FetchOptions { locked: true, update: false, update_dep: None, resolution: Publish.ResolveMode.Latest }
    (locked, locked_dirs) :: with_store(&store, () -> {
        previous :: ["JET_REGISTRY_URL", "JET_REGISTRY_CACHE_DIR", "JET_KEYS_DIR", "JETPACK_ROOT"].map((key) -> (key, std.env.var_os(key)))
        std.env.set_var("JET_REGISTRY_URL", url)
        std.env.set_var("JET_REGISTRY_CACHE_DIR", cache)
        std.env.set_var("JET_KEYS_DIR", keys)
        std.env.set_var("JETPACK_ROOT", hangar_root)
        result :: Fetch.fetch(&consumer, &manifest, Val(&lock), &locked_opts)
        for (key, value) in previous { match value { Val(value) -> std.env.set_var(key, value), None -> std.env.remove_var(key) } }
        result.expect("locked registry metadata must agree with the dependency lock")
    })
    assert(locked.packages.iter().any((package) -> package.name == "rolekit" && package.dependencies.contains("runtime") && package.dependencies.contains("buildtool") && package.dependencies.contains("trace")))
    assert(locked_dirs.contains_key("rolekit"))
    tamper_work :: tmp.join("tamper-registry")
    assert(Command.new("git").args(["clone", url.as_str(), tamper_work.to_str().expect("tamper")]).status().expect("clone").success())
    metadata_path :: tamper_work.join("artifacts/rolekit/1.0.0/registry.json")
    metadata :: fs.read_to_string(metadata_path) ?? panic("metadata")
    tampered_metadata :: metadata.replace("\"build_dependencies\":{\"buildtool\":\"1.0.0\"}", "\"build_dependencies\":{\"runtime\":\"1.0.0\"}")
    assert_ne(metadata, tampered_metadata, "tamper fixture must change meaning")
    fs.write(metadata_path, tampered_metadata) ?? panic("tamper")
    for args in [["config", "user.email", "test@jet.test"], ["config", "user.name", "Jet Test"], ["add", "artifacts/rolekit/1.0.0/registry.json"], ["commit", "-m", "tamper registry metadata"], ["push", "origin", "HEAD:main"]] {
        assert(Command.new("git").args(args).current_dir(tamper_work).status().expect("git").success(), "git command failed: {args}")
    }
    tampered_consumer :: tmp.join("consumer-tampered")
    tampered_cache :: tmp.join("registry-cache-tampered")
    tampered_hangar :: tmp.join("jetpack-root-tampered")
    fs.create_dir_all(tampered_consumer) ?? panic("consumer")
    tampered_raw :: manifest_with_deps("tampered-consumer", "0.1.0", "    rolekit: rolekit#1.0.0,")
    write(&tampered_consumer, "package.jet", &tampered_raw)
    tampered_manifest :: Manifest.parse(tampered_consumer.join("package.jet"), &tampered_raw) ?? panic("manifest")
    tampered_result :: with_store(&store, () -> {
        previous :: ["JET_REGISTRY_URL", "JET_REGISTRY_CACHE_DIR", "JET_KEYS_DIR", "JETPACK_ROOT"].map((key) -> (key, std.env.var_os(key)))
        std.env.set_var("JET_REGISTRY_URL", url)
        std.env.set_var("JET_REGISTRY_CACHE_DIR", tampered_cache)
        std.env.set_var("JET_KEYS_DIR", keys)
        std.env.set_var("JETPACK_ROOT", tampered_hangar)
        result :: Fetch.fetch(&tampered_consumer, &tampered_manifest, None, &opts)
        for (key, value) in previous { match value { Val(value) -> std.env.set_var(key, value), None -> std.env.remove_var(key) } }
        result
    })
    tampered_error :: tampered_result.expect_err("metadata tampering must fail closed")
    assert_eq(first_diag_code(&tampered_error), "E1207")
    assert(tampered_error.iter().any((diagnostic) -> diagnostic.what.contains("content hash")), "tampered metadata must be rejected as an identity failure: {tampered_error}")
    assert(Store.list(&Store.Roots.at(tampered_hangar.clone())).into_iter().all((entry) -> !(entry.name == "rolekit" && entry.version == "1.0.0")), "tampered registry metadata must not reach Hangar")
    make_tree_writable(&tmp)
    fs.remove_dir_all(tmp) ?? panic("cleanup")
}

// Rust: tests/pkg.rs:7666
#Test("registry_fetch_applies_verified_advisory_freshness_before_hangar_ingest") {
    if !jet_bin().is_file() || !have_git() {
        eprintln("note: skipping registry_fetch_applies_advisory_freshness (need built binary and git)")
        return
    }
    tmp :: tmp_dir("registry_fetch_advisory_freshness")
    publisher :: tmp.join("publisher")
    consumer :: tmp.join("consumer")
    bare :: tmp.join("registry.git")
    url :: bare_registry(&bare)
    cache :: tmp.join("registry-cache")
    store :: tmp.join("legacy-store")
    hangar_root :: tmp.join("jetpack-root")
    keys :: tmp.join("keys")
    fs.create_dir_all(publisher) ?? panic("publisher")
    fs.create_dir_all(consumer) ?? panic("consumer")
    fs.create_dir_all(store) ?? panic("store")
    init_clean_project(&publisher, "freshlib", "1.2.0")
    seed_core_review(&bare, "freshlib", "1.2.0")
    publish :: jet_cmd_env(["registry", "publish"], &publisher, [("JET_REGISTRY_URL", url.as_str()), ("JET_REGISTRY_CACHE_DIR", cache.to_str().expect("cache")), ("JET_PACKAGE_STORE_DIR", store.to_str().expect("store")), ("JET_KEYS_DIR", keys.to_str().expect("keys"))])
    assert(publish.status.success(), "registry publish failed:\n{String.from_utf8_lossy(publish.stderr)}")
    raw :: manifest_with_deps("fresh-consumer", "0.1.0", "    freshlib: freshlib#1.2.0,")
    write(&consumer, "package.jet", &raw)
    manifest :: Manifest.parse(consumer.join("package.jet"), &raw) ?? panic("manifest")
    opts :: Fetch.FetchOptions { locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative }
    with_keys(&keys, () -> {
        (seed, _public_path, public_key) :: Publish.Sign.keygen("advisory", false) ?? panic("advisory keygen should succeed")
        feed := Publish.AdvisoryFeed { sequence: 1, issued_at: 100, expires_at: 200_000, maturity_seconds: Publish.DEFAULT_MATURITY_SECONDS,
            key_id: Publish.advisory_key_id(&public_key).expect("key id"), public_key: public_key.clone(), signature: "",
            releases: [Publish.AdvisoryRelease { package: "freshlib", version: SemVer.parse("1.2.0").expect("version"), first_seen: 100, source_class: Publish.SourceClass.ThirdParty }], advisories: [], exceptions: [] }
        feed.signature = Publish.sign_advisory_feed(&feed, &seed) ?? panic("sign feed")
        fs.create_dir_all(consumer.join(".jet")) ?? panic(".jet")
        fs.write(consumer.join(".jet/advisories.db"), Publish.advisory_feed_text(&feed)) ?? panic("feed")
        fs.write(consumer.join(".jet/advisory-trust"), "public_key={public_key}\nmin_sequence=1\n") ?? panic("trust")
        env_keys :: ["JET_REGISTRY_URL", "JET_REGISTRY_CACHE_DIR", "JET_PACKAGE_STORE_DIR", "JETPACK_ROOT", "JET_ADVISORY_NOW", "JET_ADVISORY_DB", "JET_ADVISORY_TRUST", "JET_ADVISORY_PUBLIC_KEY"]
        previous :: env_keys.iter().map((key) -> (key, std.env.var_os(key))).collect()
        std.env.set_var("JET_REGISTRY_URL", url)
        std.env.set_var("JET_REGISTRY_CACHE_DIR", cache)
        std.env.set_var("JET_PACKAGE_STORE_DIR", store)
        std.env.set_var("JETPACK_ROOT", hangar_root)
        std.env.set_var("JET_ADVISORY_NOW", "200")
        std.env.remove_var("JET_ADVISORY_DB")
        std.env.remove_var("JET_ADVISORY_TRUST")
        std.env.remove_var("JET_ADVISORY_PUBLIC_KEY")
        immature :: Fetch.fetch(&consumer, &manifest, None, &opts).expect_err("an immature registry candidate must be rejected")
        assert_eq(first_diag_code(&immature), "E2609", "diagnostics: {immature}")
        assert(immature[0].what.contains("freshlib#1.2.0"))
        assert(!consumer.join(".jet/build/deps/freshlib").exists(), "freshness must fail before a registry artifact is usable")
        exception_raw :: "{raw}\npolicy: {{ exceptions: [PolicyException{{ id: \"JSA-2026-0001\", scope: \"freshlib#1.2.0\", reason: \"urgent security fix\", expires: 9999999999 }}] }}\n"
        exception_manifest :: Manifest.parse(consumer.join("package.jet"), &exception_raw) ?? panic("source exception manifest should parse")
        (_exception_lock, exception_dirs) :: Fetch.fetch(&consumer, &exception_manifest, None, &opts) ?? panic("an active exact source exception should admit the fresh release")
        assert(exception_dirs.contains_key("freshlib"))
        excepted_entry :: Store.list(&Store.Roots.at(hangar_root.clone())).into_iter().find((entry) -> entry.name == "freshlib" && entry.version == "1.2.0") ?? panic("source exception must still use the production Hangar path")
        assert(excepted_entry.envelope.provenance.contains("source-policy-exception=id=JSA-2026-0001;scope=freshlib#1.2.0"), "source exception evidence must be visible in provenance: {excepted_entry.envelope.provenance}")
        std.env.set_var("JET_ADVISORY_NOW", "100000")
        (lock, dep_dirs) :: Fetch.fetch(&consumer, &manifest, None, &opts) ?? panic("a mature, verified candidate should resolve and ingest")
        assert(dep_dirs.contains_key("freshlib"))
        assert(lock.packages.iter().any((package) -> package.name == "freshlib"))
        entry :: Store.list(&Store.Roots.at(hangar_root.clone())).into_iter().find((entry) -> entry.name == "freshlib" && entry.version == "1.2.0") ?? panic("mature candidate must produce a Hangar entry")
        assert(entry.envelope.provenance.contains("advisory-feed=sequence=1"), "verified advisory receipt must be visible in Hangar provenance: {entry.envelope.provenance}")
        assert(entry.envelope.provenance.contains("maturity=86400s"))
        stale := feed.clone()
        stale.expires_at = 150
        stale.signature = Publish.sign_advisory_feed(&stale, &seed) ?? panic("stale feed should sign")
        fs.write(consumer.join(".jet/advisories.db"), Publish.advisory_feed_text(&stale)) ?? panic("stale feed")
        std.env.set_var("JET_ADVISORY_NOW", "200")
        (_same_lock, locked_dirs) :: Fetch.fetch(&consumer, &manifest, Val(&lock), &opts) ?? panic("an exact lock must remain usable when advisory metadata expires")
        assert_eq(locked_dirs.get("freshlib"), dep_dirs.get("freshlib"), "exact-lock reuse must keep the same Hangar object")
        reused_entry :: Store.list(&Store.Roots.at(hangar_root.clone())).into_iter().find((entry) -> entry.name == "freshlib" && entry.version == "1.2.0") ?? panic("exact-lock reuse must keep the Hangar entry")
        assert(reused_entry.envelope.provenance.contains("advisory-feed=sequence=1"), "exact-lock reuse must not erase the verified advisory receipt")
        for (key, value) in previous { match value { Val(value) -> std.env.set_var(key, value), None -> std.env.remove_var(key) } }
    })
    make_tree_writable(&tmp)
    fs.remove_dir_all(tmp) ?? panic("cleanup")
}

// Rust: tests/pkg.rs:7872
#Test("cli_yank_flips_index_entry") {
    if !jet_bin().is_file() { eprintln("note: skipping cli_yank_flips_index_entry (run `cargo build` first)"); return }
    if !have_git() { eprintln("note: skipping cli_yank_flips_index_entry (git not found)"); return }
    tmp :: tmp_dir("yank_flip")
    proj :: tmp.join("proj")
    fs.create_dir_all(proj) ?? panic("project")
    bare :: tmp.join("registry.git")
    url :: bare_registry(&bare)
    cache :: tmp.join("cache")
    store :: tmp.join("store")
    fs.create_dir_all(store) ?? panic("store")
    keys :: tmp.join("keys")
    init_clean_project(&proj, "mypkg", "2.0.0")
    seed_core_review(&bare, "mypkg", "2.0.0")
    envs :: [("JET_REGISTRY_URL", url.as_str()), ("JET_REGISTRY_CACHE_DIR", cache.to_str().expect("cache")), ("JET_PACKAGE_STORE_DIR", store.to_str().expect("store")), ("JET_KEYS_DIR", keys.to_str().expect("keys"))]
    pubd :: jet_cmd_env(["registry", "publish"], &proj, envs)
    assert(pubd.status.success(), "publish should succeed:\n{String.from_utf8_lossy(pubd.stderr)}")
    for cmd_args in [["add", "."], ["commit", "-m", "snapshot api"]] {
        _ :: Command.new("git").args(cmd_args).current_dir(proj).output() ?? panic("commit release")
    }
    yanked :: jet_cmd_env(["registry", "yank", "2.0.0", "--message", "regression"], &proj, envs)
    assert(yanked.status.success(), "yank should succeed:\n{String.from_utf8_lossy(yanked.stderr)}")
    index :: read_index_file(&bare, "mypkg") ?? panic("index file must exist")
    assert_eq(index.lines().filter((l) -> l.contains("\"version\":\"2.0.0\"")).count(), 1, "yank must not delete the line:\n{index}")
    assert(index.contains("\"yanked\":true"), "version must be flipped to yanked:\n{index}")
    republish :: jet_cmd_env(["registry", "publish"], &proj, envs)
    assert(!republish.status.success(), "a yanked version must remain reserved")
    republish_stderr :: String.from_utf8_lossy(republish.stderr)
    assert(republish_stderr.contains("E1234"), "republishing a yanked version must cite E1234:\n{republish_stderr}")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:7964
#Test("registry_transport_rejects_and_redacts_embedded_credentials") {
    registry :: Publish.RegistryConfig.private("scratch", "https://user:super-secret@example.invalid/registry.git", false)
    assert_eq(Publish.redact_registry_url(&registry.url), "https://example.invalid/registry.git")
    assert_eq(Publish.redact_registry_url("https://example.invalid/registry.git?access_token=super-secret#fragment"), "https://example.invalid/registry.git")
    diagnostic :: Publish.ensure_index_clone(&registry).expect_err("registry transport must reject embedded credentials")
    rendered :: Diagnostics.render_all("package.jet", "", [diagnostic])
    assert(rendered.contains("E1235"), "unexpected diagnostic:\n{rendered}")
    assert(!rendered.contains("super-secret"), "registry credential leaked in diagnostic:\n{rendered}")
    query_registry :: Publish.RegistryConfig.private("scratch", "https://example.invalid/registry.git?access_token=super-secret", false)
    query_diagnostic :: Publish.ensure_index_clone(&query_registry).expect_err("registry transport must reject credential-bearing URL parameters")
    query_rendered :: Diagnostics.render_all("package.jet", "", [query_diagnostic])
    assert(query_rendered.contains("E1235"), "unexpected diagnostic:\n{query_rendered}")
    assert(!query_rendered.contains("super-secret"), "registry credential leaked in query diagnostic:\n{query_rendered}")
    file_registry :: Publish.RegistryConfig.private("scratch", "file:///tmp/registry.git?access_token=super-secret", false)
    file_diagnostic :: Publish.ensure_index_clone(&file_registry).expect_err("credential-bearing file URLs must fail before transport")
    file_rendered :: Diagnostics.render_all("package.jet", "", [file_diagnostic])
    assert(!file_rendered.contains("super-secret"), "credential leaked: {file_rendered}")
    detail :: Publish.e1235("https://example.invalid/registry.git", "git helper failed after receiving password super-secret")
    detail_rendered :: Diagnostics.render_all("package.jet", "", [detail])
    assert(!detail_rendered.contains("super-secret"), "raw credential-bearing transport detail leaked:\n{detail_rendered}")
}

// Rust: tests/pkg.rs:8033
#Test("registry_refresh_failure_preserves_previous_cache") {
    if !have_git() { eprintln("note: skipping registry_refresh_failure_preserves_previous_cache (git not found)"); return }
    tmp :: tmp_dir("registry_stale_cache")
    bare :: tmp.join("registry.git")
    url :: bare_registry(&bare)
    seed_core_review(&bare, "stale-kit", "1.0.0")
    cache :: tmp.join("cache")
    registry :: Publish.RegistryConfig.private("scratch", &url, false)
    guard :: STORE_LOCK.lock().unwrap_or_else((error) -> error.into_inner())
    previous_cache :: std.env.var_os("JET_REGISTRY_CACHE_DIR")
    std.env.set_var("JET_REGISTRY_CACHE_DIR", cache)
    repo :: Publish.ensure_index_clone(&registry) ?? panic("initial registry clone")
    before :: fs.read(repo.join("reviews/stale-kit/1.0.0.review")) ?? panic("review")
    fs.remove_dir_all(bare) ?? panic("remove registry")
    error :: Publish.ensure_index_clone(&registry).expect_err("a failed refresh must not replace the existing cache")
    assert_eq(error.code, "E1235")
    assert_eq(fs.read(repo.join("reviews/stale-kit/1.0.0.review")) ?? panic("cached review"), before)
    parent :: repo.parent() ?? panic("parent")
    leftovers :: (fs.read_dir(parent) ?? panic("cache parent")).filter_map((entry) -> entry.ok()).map((entry) -> entry.file_name().to_string_lossy().into_owned()).filter((name) -> name.contains(".partial-") || name.contains(".backup-")).collect()
    assert(leftovers.is_empty(), "failed refresh left staging paths: {leftovers}")
    match previous_cache { Val(value) -> std.env.set_var("JET_REGISTRY_CACHE_DIR", value), None -> std.env.remove_var("JET_REGISTRY_CACHE_DIR") }
    drop(guard)
    _ :: fs.remove_dir_all(tmp)
}

