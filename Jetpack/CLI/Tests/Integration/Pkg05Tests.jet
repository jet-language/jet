    project :: tmp.join("project")
    bare :: tmp.join("registry.git")
    registry_url :: bare_registry(&bare)
    registry_cache :: tmp.join("registry-cache")
    store :: tmp.join("store")
    keys :: tmp.join("keys")
    fs.create_dir_all(home) ?? panic("home")
    fs.create_dir_all(project) ?? panic("project")
    fs.create_dir_all(store) ?? panic("store")
    install_closed_status_crypto_helper(&home)
    init_clean_project(&project, "entropyfail", "1.0.0")
    out :: jet_cmd_env(["registry", "publish"], &project, [("HOME", home.to_str().expect("home")), ("JET_KEYS_DIR", keys.to_str().expect("keys")), ("JET_REGISTRY_URL", registry_url.as_str()), ("JET_REGISTRY_CACHE_DIR", registry_cache.to_str().expect("cache")), ("JET_PACKAGE_STORE_DIR", registry_cache.to_str().expect("cache"))])
    assert_eq(out.status.code(), Val(1))
    assert(out.stdout.is_empty(), "stdout must stay empty: {out.stdout}")
    assert_eq(String.from_utf8(out.stderr) ?? panic("stderr"), fs.read_to_string("tests/fixtures/jetpack-diagnostics/keygen_entropy_unavailable.stderr").expect("snapshot"))
    assert(!keys.exists(), "auto-keygen failure created key artifacts")
    assert(!registry_cache.exists(), "auto-keygen failure cloned an index")
    assert(read_index_file(&bare, "entropyfail").is_none(), "auto-keygen failure mutated the registry index")
    assert(!project.join(".jet/cache/api").exists() && !project.join(".jet/cache/schema").exists(), "auto-keygen failure created package snapshots")
    fs.remove_dir_all(tmp) ?? panic("cleanup")
}

