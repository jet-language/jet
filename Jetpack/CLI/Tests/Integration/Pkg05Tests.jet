// Rust: tests/pkg.rs:9027
#Test("sign_verify_roundtrip_and_tamper_e1246") {
    if !have_cargo() { eprintln("note: skipping sign_verify_roundtrip (cargo not found)"); return }
    tmp :: tmp_dir("sign_verify")
    keys :: tmp.join("keys")
    with_keys(&keys, () -> {
        (seed_a, _pub_path, pub_a) :: Publish.Sign.keygen("jet", false) ?? panic("keygen should succeed")
        content_hash :: "sha256-0011223344556677"
        sig :: Publish.Sign.sign(&seed_a, content_hash) ?? panic("sign should succeed")
        good :: signed_entry("textkit", "1.0.0", content_hash, &pub_a, &sig)
        all :: [good.clone()]
        Publish.verify_index_entry(&all, &good, false, "jet") ?? panic("an untampered signature must verify")
        assert(Publish.Sign.verify(&pub_a, content_hash, &sig) ?? panic("verify"), "Sign::verify must accept a genuine signature")
        bad := good.clone()
        bad.content_hash = "sha256-TAMPEREDdeadbeef"
        all_bad :: [bad.clone()]
        err :: Publish.verify_index_entry(&all_bad, &bad, false, "jet").expect_err("a tampered content hash must fail verification")
        assert_eq(err.code, "E1246", "tamper must cite E1246")
    })
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:9067
#Test("require_signed_unsigned_entry_e1247") {
    unsigned :: signed_entry("corpkit", "1.0.0", "sha256-abc", "", "")
    all :: [unsigned.clone()]
    err :: Publish.verify_index_entry(&all, &unsigned, true, "corp").expect_err("require_signed + no signature must error")
    assert_eq(err.code, "E1247", "must cite E1247")
    Publish.verify_index_entry(&all, &unsigned, false, "corp") ?? panic("an unsigned entry is fine when the registry doesn't require signing")
}

// Rust: tests/pkg.rs:9082
#Test("takeover_requires_review_and_resigning") {
    if !have_cargo() { eprintln("note: skipping takeover (cargo not found)"); return }
    tmp :: tmp_dir("takeover")
    keys :: tmp.join("keys")
    with_keys(&keys, () -> {
        (seed_a, _pa, pub_a) :: Publish.Sign.keygen("jet", false) ?? panic("first key")
        original_seed :: fs.read(seed_a) ?? panic("seed")
        (seed_b, _pb, pub_b) :: Publish.Sign.keygen("other", false) ?? panic("second key")
        assert_ne(pub_a, pub_b, "the two keys must differ")
        ch1 :: "sha256-v1v1v1"
        ch2 :: "sha256-v2v2v2"
        sig1 :: Publish.Sign.sign(&seed_a, ch1) ?? panic("first signature")
        old_key_sig :: Publish.Sign.sign(&seed_a, ch2) ?? panic("old signature")
        new_key_sig :: Publish.Sign.sign(&seed_b, ch2) ?? panic("new signature")
        v1 :: signed_entry("textkit", "1.0.0", ch1, &pub_a, &sig1)
        v2_old_key :: signed_entry("textkit", "2.0.0", ch2, &pub_b, &old_key_sig)
        v2 :: signed_entry("textkit", "2.0.0", ch2, &pub_b, &new_key_sig)
        repo :: tmp.join("registry")
        fs.create_dir_all(repo) ?? panic("repo")
        Publish.Index.write_index_entry(&repo, &v1) ?? panic("v1")
        missing_review :: Publish.Index.write_index_entry(&repo, &v2).expect_err("takeover without review must be refused")
        assert(missing_review.to_string().contains("no approved registry review"), "missing review must be named: {missing_review}")
        review :: repo.join("reviews/textkit/2.0.0.review")
        fs.create_dir_all(review.parent().expect("review parent")) ?? panic("reviews")
        fs.write(review, "jet-registry-core-review-v1\npackage=textkit\nversion=2.0.0\nreviewer=registry-owner\ndecision=approved\n") ?? panic("review")
        wrong_signature :: Publish.Index.write_index_entry(&repo, &v2_old_key).expect_err("takeover signed by the old key must be refused")
        assert(wrong_signature.to_string().contains("signature verification failed"), "wrong signer must be named: {wrong_signature}")
        Publish.Index.write_index_entry(&repo, &v2) ?? panic("reviewed takeover signed by the new key must pass")
        all :: Publish.Index.read_entries(&repo, "textkit") ?? panic("entries")
        Publish.verify_index_entry(&all, &v2, false, "jet") ?? panic("reviewed takeover signature must verify")
        assert_eq(fs.read(seed_a) ?? panic("seed"), original_seed)
        fs.remove_dir_all(repo) ?? panic("cleanup repo")
    })
    fs.remove_dir_all(tmp) ?? panic("cleanup")
}

// Rust: tests/pkg.rs:9148
#Test("keygen_refuses_existing_key_e1248") {
    if !have_cargo() { eprintln("note: skipping keygen_refuses_existing_key (cargo not found)"); return }
    tmp :: tmp_dir("keygen_refuse")
    keys :: tmp.join("keys")
    with_keys(&keys, () -> {
        (seed, public, _) :: Publish.Sign.keygen("jet", false) ?? panic("first keygen should succeed")
        if sys.target.selected_family() == "unix" {
            assert_eq((fs.metadata(seed) ?? panic("seed metadata")).permissions().mode() & 0o7777, 0o600, "private signing seed must remain owner-only")
            assert_eq((fs.metadata(public) ?? panic("public metadata")).permissions().mode() & 0o7777, 0o644, "public signing key keeps its published mode")
        }
        err :: Publish.Sign.keygen("jet", false).expect_err("a second keygen without --force must refuse")
        assert_eq(err.code, "E1248", "must cite E1248")
        _ :: Publish.Sign.keygen("jet", true) ?? panic("--force keygen must overwrite")
    })
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:9185
#Test("locked_build_rejects_manifest_lock_git_identity_mismatches") {
    if !have_git() { eprintln("note: skipping locked_build_git_identity_mismatches (git not found)"); return }
    tmp :: tmp_dir("locked_build_git_identity")
    source :: tmp.join("mylib_source")
    write(&source, "package.jet", &min_manifest("mylib", "0.1.0"))
    write(&source, "mylib.jet", "pub fn answer() -> Int { return 42 }\n")
    assert(Command.new("git").args(["init"]).current_dir(source).status().expect("git init").success(), "git init failed")
    for (key, value) in [("user.email", "test@jet.test"), ("user.name", "Jet Test")] {
        assert(Command.new("git").args(["config", key, value]).current_dir(source).status().expect("git config").success(), "git config {key} failed")
    }
    assert(Command.new("git").args(["add", "."]).current_dir(source).status().expect("git add").success(), "git add failed")
    assert(Command.new("git").args(["commit", "-m", "init"]).current_dir(source).status().expect("git commit").success(), "git commit failed")
    revision_text :: String.from_utf8(Command.new("git").args(["rev-parse", "HEAD"]).current_dir(source).output().expect("revision").stdout) ?? panic("revision UTF8")
    revision := revision_text.trim() // #4303
    assert_eq(revision.len(), 40, "test Git revision must be a full object id")
    bare :: tmp.join("mylib.git")
    assert(Command.new("git").args(["clone", "--bare", source.to_str().expect("source"), bare.to_str().expect("bare")]).status().expect("clone bare").success(), "git clone --bare failed")
    repo_url :: "file://{bare.display()}"
    raw :: manifest_with_deps("app", "0.1.0", "    mylib: {{ git: \"{repo_url}\", rev: \"{revision}\" }},")
    write(&tmp, "package.jet", &raw)
    entry :: tmp.join("run.jet")
    write(&tmp, "run.jet", "use mylib\nfn run() -> { print(mylib.answer()) }\n")
    manifest :: Manifest.parse(tmp.join("package.jet"), &raw) ?? panic("manifest")
    store :: tmp.join("store")
    home :: tmp.join("home")
    fs.create_dir_all(store) ?? panic("store")
    fs.create_dir_all(home) ?? panic("home")
    unlocked :: Fetch.FetchOptions { locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative }
    (base_lock, _) :: with_store(&store, () -> {
        previous_home :: std.env.var_os("HOME")
        std.env.set_var("HOME", home)
        result :: Fetch.fetch(&tmp, &manifest, None, &unlocked)
        match previous_home { Val(value) -> std.env.set_var("HOME", value), None -> std.env.remove_var("HOME") }
        result.expect("initial Git fetch should create a lock")
    })
    locked_package :: base_lock.packages.iter().find((package) -> package.name == "mylib") ?? panic("Git dependency must be recorded in the lock")
    assert(match locked_package.source { Lock.LockSource.Git { .. } -> true, _ -> false })
    assert_eq(locked_package.locked.expect("Git dependency must pin a revision").rev, revision)
    baseline_options := Driver.BuildRunOptions.default()
    baseline_options.locked = true
    with_store(&store, () -> Driver.compile_bundle_path_build(entry.to_str().expect("entry"), baseline_options).expect("the unchanged locked Git dependency should build"))
    expected :: "Error [E1204]: locked dependency `mylib` failed source verification\n Why: the locked Git URL or revision disagrees with the manifest\n Fix: run `jet fetch` to recreate the lock from the verified dependency source\nMore: jet-lang.dev/e/E1204\n"
    for (label, mutation) in [("URL", "url"), ("selector kind and value", "selector"), ("explicit revision", "revision")] {
        hostile_lock := base_lock.clone()
        package := hostile_lock.packages.iter_mut().find((package) -> package.name == "mylib") ?? panic("Git dependency must be recorded in every hostile lock")
        match mutation {
            "url" -> match &package.source {
                Lock.LockSource.Git { url, .. } -> { url = "file://{tmp.display()}/other.git" }
                _ -> panic("Git dependency source changed unexpectedly")
            }
            "selector" -> match &package.source {
                Lock.LockSource.Git { selector, .. } -> { selector = "tag = \"hostile-selector\"" }
                _ -> panic("Git dependency source changed unexpectedly")
            }
            "revision" -> { package.locked.as_mut().expect("Git dependency must pin a revision").rev = "0".repeat(40) }
            _ -> panic("all hostile mutations are named above")
        }
        fs.write(tmp.join(".jet/lock"), Lock.write(&hostile_lock)) ?? panic("hostile lock")
        options := Driver.BuildRunOptions.default()
        options.locked = true
        errors :: with_store(&store, () -> Driver.compile_bundle_path_build(entry.to_str().expect("entry"), options).expect_err("{label} mismatch must fail before package use"))
        assert_eq(first_diag_code(&errors), "E1204", "{label} mismatch")
        rendered :: Diagnostics.render_all("package.jet", &raw, &errors)
        assert_eq(rendered, expected, "{label} mismatch diagnostic")
    }
    _ :: fs.remove_dir_all(tmp)
}
