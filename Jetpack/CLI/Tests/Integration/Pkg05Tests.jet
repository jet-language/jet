// Rust: tests/pkg.rs:8481
#Test("cli_signed_advisory_feed_receipt_and_tamper_fail_closed") {
    if !have_cargo() { eprintln("note: skipping signed advisory feed audit (cargo not found)"); return }
    tmp :: tmp_dir("signed_advisory_audit")
    project :: tmp.join("project")
    keys :: tmp.join("keys")
    fs.create_dir_all(project.join(".jet")) ?? panic(".jet")
    fs.write(project.join("package.jet"), min_manifest("app", "0.1.0")) ?? panic("manifest")
    fs.write(project.join(".jet/lock"), Lock.write(&make_test_lock("mylib", "1.0.0", "sha256-locked"))) ?? panic("lock")
    with_keys(&keys, () -> {
        (seed, _public_path, public_key) :: Publish.Sign.keygen("advisory", false) ?? panic("advisory keygen should succeed")
        key_id :: Publish.advisory_key_id(&public_key) ?? panic("key id")
        feed := Publish.AdvisoryFeed { sequence: 1, issued_at: 100, expires_at: 10_000, maturity_seconds: 86_400, key_id: key_id,
            public_key: public_key.clone(), signature: "", releases: [], advisories: [], exceptions: [] }
        feed.signature = Publish.sign_advisory_feed(&feed, &seed) ?? panic("advisory feed signing should succeed")
        feed_path :: project.join(".jet/advisories.db")
        fs.write(feed_path, Publish.advisory_feed_text(&feed)) ?? panic("feed")
        fs.write(project.join(".jet/advisory-trust"), "public_key={public_key}\nmin_sequence=1\n") ?? panic("trust")
        audit :: () -> Command.new(jet_bin()).args(["inspect", "audit"]).current_dir(project).env("JET_ADVISORY_NOW", "200").env("NO_COLOR", "1").output().expect("audit")
        clean :: audit()
        assert_eq(clean.status.code(), Val(0), "stderr={clean.stderr}")
        stdout :: String.from_utf8_lossy(clean.stdout)
        assert(stdout.contains("feed sequence 1 verified"), "stdout={stdout}")
        assert(stdout.contains("no advisories found"), "stdout={stdout}")
        fs.remove_file(project.join(".jet/advisory-trust")) ?? panic("remove trust")
        key_only :: Command.new(jet_bin()).args(["inspect", "audit"]).current_dir(project).env("JET_ADVISORY_NOW", "200").env("JET_ADVISORY_PUBLIC_KEY", public_key).env("NO_COLOR", "1").output() ?? panic("key-only audit")
        assert_eq(key_only.status.code(), Val(1))
        assert(String.from_utf8_lossy(key_only.stderr).contains("advisory trust root"), "key-only environment input must not replace the pinned trust root: {String.from_utf8_lossy(key_only.stderr)}")
        fs.write(project.join(".jet/advisory-trust"), "public_key={public_key}\nmin_sequence=1\n") ?? panic("trust")
        weakened := feed.clone()
        weakened.maturity_seconds = 1
        weakened.signature = Publish.sign_advisory_feed(&weakened, &seed) ?? panic("weakened feed signing should succeed")
        fs.write(feed_path, Publish.advisory_feed_text(&weakened)) ?? panic("weakened feed")
        weakened_result :: audit()
        assert_eq(weakened_result.status.code(), Val(1))
        assert(String.from_utf8_lossy(weakened_result.stderr).contains("weaker than the 24-hour default"), "a signed feed must not weaken the default maturity policy: {String.from_utf8_lossy(weakened_result.stderr)}")
        assert_eq(String.from_utf8(weakened_result.stderr) ?? panic("stderr"), fs.read_to_string("tests/cli/advisory_weakened_maturity_e2610.txt").expect("snapshot"))
        fs.write(feed_path, Publish.advisory_feed_text(&feed)) ?? panic("restore feed")
        fs.write(project.join(".jet/advisory-trust"), "public_key={public_key}\nmin_sequence=2\n") ?? panic("trust")
        rollback :: audit()
        assert_eq(rollback.status.code(), Val(1))
        assert(String.from_utf8_lossy(rollback.stderr).contains("rolled back"))
        fs.write(project.join(".jet/advisory-trust"), "public_key={public_key}\nmin_sequence=1\nrevoked_key={public_key}\n") ?? panic("revoked trust")
        compromised :: audit()
        assert_eq(compromised.status.code(), Val(1))
        assert(String.from_utf8_lossy(compromised.stderr).contains("revoked"))
        fs.write(project.join(".jet/advisory-trust"), "public_key={public_key}\nmin_sequence=1\n") ?? panic("trust")
        accepted_digest :: "sha256-{SHA256.sha256_hex(Publish.advisory_feed_text(&feed).as_bytes())}"
        fs.write(project.join(".jet/advisory-trust"), "public_key={public_key}\nmin_sequence=1\naccepted_digest={accepted_digest}\n") ?? panic("digest trust")
        fork := feed.clone()
        fork.maturity_seconds = 86_401
        fork.signature = Publish.sign_advisory_feed(&fork, &seed) ?? panic("fork feed signing should succeed")
        fs.write(feed_path, Publish.advisory_feed_text(&fork)) ?? panic("fork feed")
        mixed :: audit()
        assert_eq(mixed.status.code(), Val(1))
        assert(String.from_utf8_lossy(mixed.stderr).contains("forked"))
        fs.write(project.join(".jet/advisory-trust"), "public_key={public_key}\nmin_sequence=1\n") ?? panic("trust")
        stale := feed.clone()
        stale.expires_at = 150
        stale.signature = Publish.sign_advisory_feed(&stale, &seed) ?? panic("stale feed signing should succeed")
        fs.write(feed_path, Publish.advisory_feed_text(&stale)) ?? panic("stale feed")
        frozen :: audit()
        assert_eq(frozen.status.code(), Val(1))
        assert(String.from_utf8_lossy(frozen.stderr).contains("stale or expired"))
        fs.write(project.join(".jet/advisory-trust"), "public_key={public_key}\nmin_sequence=1\n") ?? panic("trust")
        fs.write(feed_path, Publish.advisory_feed_text(&feed)) ?? panic("restore feed")
        immature_feed := feed.clone()
        immature_feed.releases.push(Publish.AdvisoryRelease { package: "mylib", version: SemVer.parse("1.0.0").expect("version"), first_seen: 100, source_class: Publish.SourceClass.ThirdParty })
        immature_feed.signature = Publish.sign_advisory_feed(&immature_feed, &seed) ?? panic("immature feed signing should succeed")
        fs.write(feed_path, Publish.advisory_feed_text(&immature_feed)) ?? panic("immature feed")
        immature :: audit()
        assert_eq(immature.status.code(), Val(1), "immature release must fail closed")
        assert_eq(String.from_utf8(immature.stderr) ?? panic("stderr"), fs.read_to_string("tests/cli/audit_maturity_e2609.txt").expect("snapshot"))
        fs.write(project.join("package.jet"), "{min_manifest("app", "0.1.0")}\npolicy: {{ exceptions: [PolicyException{{ id: \"JSA-2026-0001\", scope: \"mylib#1.0.0\", reason: \"urgent security fix\", expires: 1000 }}] }}\n") ?? panic("exception manifest")
        source_excepted :: audit()
        assert_eq(source_excepted.status.code(), Val(0), "the source-owned exact exception should clear only maturity: {String.from_utf8_lossy(source_excepted.stderr)}")
        assert(String.from_utf8_lossy(source_excepted.stdout).contains("source policy exception applied: id=JSA-2026-0001"), "audit must show the source exception evidence: {String.from_utf8_lossy(source_excepted.stdout)}")
        fs.write(project.join("package.jet"), min_manifest("app", "0.1.0")) ?? panic("restore manifest")
        excepted_feed := ^immature_feed
        excepted_feed.exceptions.push(Publish.AdvisoryException { package: "mylib", version: SemVer.parse("1.0.0").expect("version"), reason: "urgent security fix", reviewer: "security-team", expires_at: 1_000 })
        excepted_feed.signature = Publish.sign_advisory_feed(&excepted_feed, &seed) ?? panic("exception feed signing should succeed")
        fs.write(feed_path, Publish.advisory_feed_text(&excepted_feed)) ?? panic("exception feed")
        excepted :: audit()
        assert_eq(excepted.status.code(), Val(0), "exact exception should allow the release")
        assert(String.from_utf8_lossy(excepted.stdout).contains("no advisories found"))
        feed.maturity_seconds = 86_401
        tampered :: Publish.advisory_feed_text(&feed)
        fs.write(feed_path, tampered) ?? panic("tampered feed")
        rejected :: audit()
        assert_eq(rejected.status.code(), Val(1), "tamper must fail closed")
        assert(String.from_utf8_lossy(rejected.stderr).contains("Error [E2610]:"), "stderr={String.from_utf8_lossy(rejected.stderr)}")
        assert_eq(String.from_utf8(rejected.stderr) ?? panic("stderr"), fs.read_to_string("tests/cli/audit_tampered_e2610.txt").expect("snapshot"))
    })
    _ :: fs.remove_dir_all(tmp)
}

