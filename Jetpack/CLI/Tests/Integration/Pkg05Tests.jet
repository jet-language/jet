// Rust: tests/pkg.rs:8281
#Test("resolver_selects_highest_compatible") {
    // Rust: tests/pkg.rs:8287
    sv :: (s: String) -> SemVer.parse(s).expect("semver")
    candidates :: [sv("1.0.0"), sv("1.2.0"), sv("1.5.0"), sv("2.0.0")]
    c1 :: Publish.VersionConstraint { package: "log", req: Publish.VersionReq.parse("^1.0").expect("req"), from: "app" }
    c2 :: Publish.VersionConstraint { package: "log", req: Publish.VersionReq.parse("^1.2").expect("req"), from: "lib" }
    winner :: Publish.select_highest_compatible("log", [&c1, &c2], &candidates) ?? panic("compatible constraints with candidates should resolve")
    assert_eq(winner.to_string(), "1.5.0", "must pick the highest satisfying candidate")
    c3 :: Publish.VersionConstraint { package: "log", req: Publish.VersionReq.parse("^2.0").expect("req"), from: "other" }
    winner2 :: Publish.select_highest_compatible("log", [&c3], &candidates) ?? panic("^2.0 should resolve to 2.0.0")
    assert_eq(winner2.to_string(), "2.0.0")
    err :: Publish.select_highest_compatible("log", [&c1, &c3], &candidates).expect_err("incompatible constraints must fail")
    assert_eq(err.code, "E2602", "conflict must be E2602")
    detail :: err.detail.unwrap_or_default()
    assert(detail.contains("PubGrub proof tree:"))
    assert(detail.contains("Smallest fixes:"))
    assert(detail.contains("app") && detail.contains("other"))
}

