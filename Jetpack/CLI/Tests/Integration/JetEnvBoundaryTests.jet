// Rust: tests/jetpack_build_debug.rs:115
#Test("bare_jet_logs_is_a_teaching_error_naming_jet_inspect_logs") {
    project :: common.Scratch.new("project")
    root :: common.Scratch.new("root")
    debug.write_project(&project.path)
    _ :: debug.jetpack().args([String]{"build", "--no-color"}).current_dir(project.path).env("JETPACK_ROOT", root.path).output() ?? panic("build")
    logs :: debug.jet().args([String]{"logs", "weirdctl", "--json", "--no-color"}).current_dir(project.path).env("JETPACK_ROOT", root.path).output() ?? panic("logs")
    assert_eq(logs.status.code(), Val(2), "bare `jet logs` must be rejected")
    // E2101 JSON reports on stdout, not stderr.
    stdout :: String.from_utf8_lossy(logs.stdout)
    assert(stdout.contains("\"code\":\"E2101\""), "stdout: {stdout}")
    assert(stdout.contains("jet inspect logs"), "stdout: {stdout}")
}

