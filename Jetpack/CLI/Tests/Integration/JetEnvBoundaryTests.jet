// Rust: tests/jet_env_boundary.rs:9
#Test("toolchain_only_run_and_dev_skip_environment_realization") {
    project :: common.Scratch.new("jet-env-toolchain-only")
    jetpack_root :: project.join("jetpack-root-must-not-be-created")
    fs.write(project.join("package.jet"), "name: \"jet-env-toolchain-only\"\nversion: \"0.1.0\"\n") ?? panic("package")
    fs.write(project.join("env.jet"), "module env.dev {{ packages: [nixpkgs.git] }}\n") ?? panic("environment")
    // ONE-arrow owner ruling: the fixture keeps the same scalar-count behavior.
    fs.write(project.join("run.jet"), "use core.text as text\npub fn count() -> Int {{ text.scalar_count(\"toolchain\") }}\nfn run() -> {{}}\n") ?? panic("run source")
    loop active in [Bool]{false, true} {
        loop args in [[String]]{[String]{"run", "run.jet"}, [String]{"dev", "run.jet", "--watch=off"}} {
            command := debug.jet()
            &command.args(args.iter()).current_dir(project.path).env("JETPACK_ROOT", jetpack_root)
                .env_remove("JETPACK_ENV").env_remove("JETPACK_ENV_DIR").env_remove("JETPACK_ENV_HASH")
            if active -> &command.env("JETPACK_ENV", "1").env("JETPACK_ENV_DIR", project.path)
            output :: command.output() ?? panic("run toolchain command")
            assert(output.status.success(), "toolchain-only {args[0]} failed (active={active}):\n{String.from_utf8_lossy(output.stderr)}")
            assert_eq(String.from_utf8_lossy(output.stdout), "", "toolchain-only {args[0]} output (active={active})")
        }
    }
    assert(!jetpack_root.exists(), "toolchain-only run/dev must not create a Jetpack root")
}

// Rust: tests/jet_env_boundary.rs:68
#Test("declared_package_import_refuses_run_without_prepare_and_gates_dev_test_without_acquiring") {
    project :: common.Scratch.new("jet-env-boundary")
    jetpack_root :: project.join("jetpack-root-must-not-be-created")
    fs.write(project.join("package.jet"), "name: \"jet-env-boundary\"\nversion: \"0.1.0\"\ndeps: {{ helper: ./helper }}\n") ?? panic("package")
    fs.write(project.join("env.jet"), "module env.dev {{\n    sources: {{ stable: NixOS/nixpkgs/nixos-24.05@github }}\n}}\n") ?? panic("environment")
    fs.write(project.join("run.jet"), "use helper\nfn run() -> {{}}\n") ?? panic("run source")
    fs.write(project.join("helper.jet"), "fn help() -> {{}}\n") ?? panic("helper")
    loop args in [[String]]{[String]{"run", "run.jet", "--no-prepare"}, [String]{"dev", "run.jet", "--watch=off"}, [String]{"test", "run.jet"}} {
        output :: debug.jet().args(args.iter()).current_dir(project.path).env("JETPACK_ROOT", jetpack_root)
            .env_remove("JETPACK_ENV").env_remove("JETPACK_ENV_DIR").env_remove("JETPACK_ENV_HASH").output() ?? panic("gated command")
        assert_eq(output.status.code(), Val(1), "{args[0]} should be gated")
        stderr :: String.from_utf8_lossy(output.stderr)
        assert(stderr.contains("Error [E1355]"), "{args[0]} stderr: {stderr}")
        assert(stderr.contains("Import: `use helper`"), "{args[0]} stderr: {stderr}")
        if args[0] == "test" {
            expected :: fs.read_to_string(OSPath.from("tests/fixtures/jetpack-diagnostics/E1355.stderr")) ?? panic("diagnostic snapshot")
            assert_eq(stderr, expected)
        }
    }
    assert(!jetpack_root.exists(), "jet must not create a Jetpack root while refusing the commands")
    assert(!project.join(".jet").exists(), "jet must not create project state while refusing the command")
}

// Rust: tests/jetpack_acquisition.rs:28
#Test("non_tty_download_without_yes_fails_before_realization") {
    root :: fixtures.Scratch.new("acquisition-non-tty-root")
    project :: fixtures.Scratch.new("acquisition-non-tty-project")
    fixture_dir :: fixtures.Scratch.new("acquisition-non-tty-fixtures")
    home :: fixtures.Scratch.new("acquisition-non-tty-home")
    write_native_omp_fixture(&fixture_dir.path)
    output :: fixtures.jetpack().args([String]{"use", "omp@releases#1.0.0", "--no-color", "--offline", "--fixtures"})
        .arg(fixture_dir.path).current_dir(project.path).env("JETPACK_ROOT", root.path).env("HOME", home.path)
        .args([String]{"--", "omp"}).output() ?? panic("acquire")
    assert(!output.status.success())
    stderr :: String.from_utf8_lossy(output.stderr)
    assert(stderr.contains("-y"), "stderr: {stderr}")
    assert(output.stdout.is_empty())
    assert(Store.list(&Store.Roots.at(root.path.clone())).is_empty())
}

// Rust: tests/jetpack_build_debug.rs:42
#Test("failed_adapter_preserves_scratch_and_json_logs") {
    project :: common.Scratch.new("project")
    root :: common.Scratch.new("root")
    debug.write_project(&project.path)
    out :: debug.jetpack().args([String]{"build", "--no-color"}).current_dir(project.path).env("JETPACK_ROOT", root.path).output() ?? panic("build")
    assert(!out.status.success())
    stderr :: String.from_utf8_lossy(out.stderr)
    assert(stderr.contains("E1273"), "stderr: {stderr}")
    assert(stderr.contains("jet logs weirdctl"), "stderr: {stderr}")
    assert(stderr.contains("--shell-on-fail"), "stderr: {stderr}")
    logs :: debug.jetpack().args([String]{"logs", "weirdctl", "--json", "--no-color"}).current_dir(project.path).env("JETPACK_ROOT", root.path).output() ?? panic("logs")
    assert(logs.status.success())
    stdout :: String.from_utf8_lossy(logs.stdout)
    assert(stdout.contains("\"package\":\"weirdctl\""), "{stdout}")
    assert(stdout.contains("\"status\":\"failed\""), "{stdout}")
    assert(stdout.contains("\"scratch_dir\":\""), "{stdout}")
    assert(stdout.contains("missing-bin"), "{stdout}")
    scratch :: root.path.join("hangar/failed-scratch")
    assert((fs.read_dir(scratch) ?? panic("scratch")).next().is_some(), "failed scratch should be preserved under hangar")
}

