// Rust: tests/pkg.rs:4136
#Test("git_transport_uses_canonical_public_ip_classifier") {
    source :: fs.read_to_string(OSPath.from_text(env.var("CARGO_MANIFEST_DIR").unwrap()).join("Compiler/JetCli/Source/Cli/Fetch02.jet")).expect("Fetch source should be readable")
    assert_eq(source.matches("jet_net.is_public_ip(").count(), 1, "Git transport should have one call site for the canonical IP classifier")
    assert(!source.contains("fn is_public_ip("), "Git transport must not define a duplicate IP classifier")
    assert(!source.contains("to_ipv4_mapped") && !source.contains("first & 0xe000"), "Git transport must not carry a second IP range table")
}

// Rust: tests/pkg.rs:4156
#Test("git_dep_pins_validated_address_for_dns_rebinding") {
    if selected_family() != "unix" { return }
    tmp :: tmp_dir("git_dns_rebinding")
    fake_bin :: tmp.join("bin")
    fs.create_dir_all(fake_bin).unwrap()
    fake_git :: fake_bin.join("git")
    log :: tmp.join("git-args.log")
    fs.write(fake_git, r#"#!/bin/sh
case " $* " in
    *" --version"*) exit 0 ;;
esac
clone_dir=""
previous=""
for arg in "$@"; do
    if [ "$previous" = "-C" ]; then clone_dir="$arg"; fi
    previous="$arg"
done
if [ -n "$clone_dir" ]; then exit 0; fi
printf '%s\n' "$@" >> "$JET_TEST_GIT_LOG"
printf 'cwd=%s\n' "$(pwd -P)" >> "$JET_TEST_GIT_LOG"
printf 'config-count=%s\n' "${GIT_CONFIG_COUNT-}" >> "$JET_TEST_GIT_LOG"
printf 'config-system=%s\n' "${GIT_CONFIG_SYSTEM-}" >> "$JET_TEST_GIT_LOG"
printf 'config-global=%s\n' "${GIT_CONFIG_GLOBAL-}" >> "$JET_TEST_GIT_LOG"
printf 'config-local=%s\n' "${GIT_CONFIG_LOCAL-}" >> "$JET_TEST_GIT_LOG"
printf 'config-parameters=%s\n' "${GIT_CONFIG_PARAMETERS-}" >> "$JET_TEST_GIT_LOG"
printf 'git-exec-path=%s\n' "${GIT_EXEC_PATH-}" >> "$JET_TEST_GIT_LOG"
printf 'git-template-dir=%s\n' "${GIT_TEMPLATE_DIR-}" >> "$JET_TEST_GIT_LOG"
printf 'git-dir=%s\n' "${GIT_DIR-}" >> "$JET_TEST_GIT_LOG"
printf 'git-namespace=%s\n' "${GIT_NAMESPACE-}" >> "$JET_TEST_GIT_LOG"
printf 'git-no-replace-objects=%s\n' "${GIT_NO_REPLACE_OBJECTS-}" >> "$JET_TEST_GIT_LOG"
printf 'git-replace-ref-base=%s\n' "${GIT_REPLACE_REF_BASE-}" >> "$JET_TEST_GIT_LOG"
printf 'git-allow-protocol=%s\n' "${GIT_ALLOW_PROTOCOL-}" >> "$JET_TEST_GIT_LOG"
printf 'git-protocol-from-user=%s\n' "${GIT_PROTOCOL_FROM_USER-}" >> "$JET_TEST_GIT_LOG"
printf 'http-proxy=%s\n' "${http_proxy-}" >> "$JET_TEST_GIT_LOG"
printf 'git-proxy=%s\n' "${GIT_PROXY_COMMAND-}" >> "$JET_TEST_GIT_LOG"
case " $* " in
    *" ls-remote "*)
        printf '%s\trefs/heads/main\n' '0000000000000000000000000000000000000000'
        exit 0 ;;
esac
last=""
for arg in "$@"; do last="$arg"; done
case " $* " in
    *" clone "*)
        mkdir -p "$last"
        printf '%s\n' 'name: "rebind"' 'version: "0.1.0"' 'jet: ">=0.1.0"' 'description: ""' 'license: "MIT"' 'repository: ""' > "$last/package.jet"
        ;;
esac
exit 0
"#).unwrap()
    permissions := fs.metadata(fake_git).unwrap().permissions()
    &permissions.set_mode(0o755)
    fs.set_permissions(fake_git, permissions).unwrap()
    raw :: manifest_with_deps("app", "0.1.0", "    rebind: { git: \"https://8.8.8.8/repository.git\", branch: \"main\" },")
    write(tmp, "package.jet", raw)
    manifest :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    store :: tmp.join("store")
    home :: tmp.join("home")
    fs.create_dir_all(store).unwrap()
    fs.create_dir_all(home).unwrap()
    local_config :: tmp.join(".git")
    fs.create_dir_all(local_config).unwrap()
    fs.write(local_config.join("config"), "[url \"file:///outside/repository.git\"]\n\tinsteadOf = https://8.8.8.8/\n").unwrap()
    path_entries := [fake_bin.clone()]
    if path :: env.var_os("PATH") { &path_entries.extend(env.split_paths(path)) }
    fake_path :: env.join_paths(path_entries).unwrap()
    options :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    previous_home :: env.var_os("HOME")
    previous_path :: env.var_os("PATH")
    previous_log :: env.var_os("JET_TEST_GIT_LOG")
    injected_env :: ["GIT_CONFIG_COUNT", "GIT_CONFIG_KEY_0", "GIT_CONFIG_VALUE_0", "GIT_CONFIG_PARAMETERS", "GIT_EXEC_PATH", "GIT_TEMPLATE_DIR", "GIT_CONFIG_SYSTEM", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_LOCAL", "GIT_DIR", "GIT_NAMESPACE", "GIT_NO_REPLACE_OBJECTS", "GIT_REPLACE_REF_BASE", "GIT_ALLOW_PROTOCOL", "GIT_PROTOCOL_FROM_USER", "http_proxy", "GIT_PROXY_COMMAND"]
    previous_injected :: injected_env.map(key -> (key, env.var_os(key)))
    result :: with_store(store, () -> {
        env.set_var("HOME", home)
        env.set_var("PATH", fake_path)
        env.set_var("JET_TEST_GIT_LOG", log)
        env.set_var("GIT_CONFIG_COUNT", "1")
        env.set_var("GIT_CONFIG_KEY_0", "url.file:///outside/.insteadOf")
        env.set_var("GIT_CONFIG_VALUE_0", "https://8.8.8.8/")
        env.set_var("GIT_CONFIG_PARAMETERS", "url.file:///outside/.insteadOf")
        env.set_var("GIT_EXEC_PATH", tmp.join("evil-exec"))
        env.set_var("GIT_TEMPLATE_DIR", tmp.join("evil-template"))
        env.set_var("GIT_CONFIG_SYSTEM", tmp.join("system-config"))
        env.set_var("GIT_CONFIG_GLOBAL", tmp.join("global-config"))
        env.set_var("GIT_CONFIG_LOCAL", tmp.join("local-config"))
        env.set_var("GIT_DIR", tmp.join("evil.git"))
        env.set_var("GIT_NAMESPACE", "evil")
        env.set_var("GIT_NO_REPLACE_OBJECTS", "1")
        env.set_var("GIT_REPLACE_REF_BASE", "refs/evil/")
        env.set_var("GIT_ALLOW_PROTOCOL", "ext:file")
        env.set_var("GIT_PROTOCOL_FROM_USER", "1")
        env.set_var("http_proxy", "http://127.0.0.1:9")
        env.set_var("GIT_PROXY_COMMAND", "touch hostile")
        result :: Fetch.fetch(tmp, manifest, None, options)
        match previous_home { Some(value) -> env.set_var("HOME", value); None -> env.remove_var("HOME") }
        match previous_path { Some(value) -> env.set_var("PATH", value); None -> env.remove_var("PATH") }
        match previous_log { Some(value) -> env.set_var("JET_TEST_GIT_LOG", value); None -> env.remove_var("JET_TEST_GIT_LOG") }
        loop (key, value) in previous_injected {
            match value { Some(value) -> env.set_var(key, value); None -> env.remove_var(key) }
        }
        result
    })
    result.expect("fake Git transport should complete without network access")
    log_text :: fs.read_to_string(log).unwrap()
    loop value in ["http.followRedirects=false", "http.proxy=", "http.sslVerify=true", "http.curloptResolve=8.8.8.8:443:8.8.8.8", "https://8.8.8.8/repository.git"] {
        assert_eq(log_text.lines().filter(line -> line == value).count(), 2, "{value} must reach both ls-remote and clone")
    }
    loop value in ["cwd=/", "config-count=0", "config-system=/dev/null", "config-global=/dev/null", "config-local=/dev/null", "config-parameters=", "git-exec-path=", "git-template-dir=", "git-dir=", "git-namespace=", "git-no-replace-objects=", "git-replace-ref-base=", "git-allow-protocol=", "git-protocol-from-user=", "http-proxy=", "git-proxy="] {
        assert_eq(log_text.lines().filter(line -> line == value).count(), 2, "{value} must reach both ls-remote and clone")
    }
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:4370
#Test("git_dep_keeps_local_source_authority_after_path_swap") {
    if !["linux", "android", "macos", "ios"].contains(selected_os()) { return }
    tmp :: tmp_dir("git_local_authority_race")
    source :: tmp.join("source.git")
    backup :: tmp.join("source.original")
    outside :: tmp.with_file_name("jet_pkg_git_local_race_outside_{process.id()}")
    fake_bin :: tmp.join("bin")
    log :: tmp.join("git-authority.log")
    fs.create_dir_all(source).unwrap()
    fs.create_dir_all(outside).unwrap()
    write(source, "package.jet", min_manifest("safe", "0.1.0"))
    write(outside, "package.jet", min_manifest("evil", "0.1.0"))
    fs.create_dir_all(fake_bin).unwrap()
    fake_git :: fake_bin.join("git")
    fs.write(fake_git, r#"#!/bin/sh
case " $* " in
    *" --version"*) exit 0 ;;
esac
command_name=""
remote=""
after_separator=0
for arg in "$@"; do
    if [ "$arg" = "ls-remote" ] || [ "$arg" = "clone" ]; then command_name="$arg"; fi
    if [ "$after_separator" = 1 ] && [ -z "$remote" ]; then remote="$arg"; fi
    if [ "$arg" = "--" ]; then after_separator=1; fi
done
printf 'command=%s\nremote=%s\n' "$command_name" "$remote" >> "$JET_TEST_GIT_LOG"
if [ "$command_name" = "ls-remote" ]; then
    mv "$JET_TEST_GIT_SOURCE" "$JET_TEST_GIT_BACKUP" || exit 10
    ln -s "$JET_TEST_GIT_OUTSIDE" "$JET_TEST_GIT_SOURCE" || exit 11
    printf '%s\trefs/heads/main\n' '0000000000000000000000000000000000000000'
    exit 0
fi
if [ "$command_name" = "clone" ]; then
    destination=""
    for arg in "$@"; do destination="$arg"; done
    mkdir -p "$destination" || exit 12
    case "$remote" in
        /proc/self/fd/*|/dev/fd/*)
            printf 'authority=fd\n' >> "$JET_TEST_GIT_LOG"
            source_path="$remote" ;;
        file://*)
            printf 'authority=path\n' >> "$JET_TEST_GIT_LOG"
            source_path="${remote#file://}" ;;
        *) exit 13 ;;
    esac
    cat "$source_path/package.jet" > "$destination/package.jet" || exit 14
    exit 0
fi
exit 0
"#).unwrap()
    fs.set_permissions(fake_git, fs.Permissions.from_mode(0o755)).unwrap()
    raw :: manifest_with_deps("app", "0.1.0", "    safe: {{ git: \"file://{source.display()}\", branch: \"main\" }},")
    write(tmp, "package.jet", raw)
    manifest :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    store :: tmp.join("store")
    home :: tmp.join("home")
    fs.create_dir_all(store).unwrap()
    fs.create_dir_all(home).unwrap()
    path_entries := [fake_bin.clone()]
    if path :: env.var_os("PATH") { &path_entries.extend(env.split_paths(path)) }
    fake_path :: env.join_paths(path_entries).unwrap()
    options :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    env_names :: ["HOME", "PATH", "JET_TEST_GIT_LOG", "JET_TEST_GIT_SOURCE", "JET_TEST_GIT_BACKUP", "JET_TEST_GIT_OUTSIDE"]
    previous_env :: env_names.map(key -> (key, env.var_os(key)))
    result :: with_store(store, () -> {
        env.set_var("HOME", home)
        env.set_var("PATH", fake_path)
        env.set_var("JET_TEST_GIT_LOG", log)
        env.set_var("JET_TEST_GIT_SOURCE", source)
        env.set_var("JET_TEST_GIT_BACKUP", backup)
        env.set_var("JET_TEST_GIT_OUTSIDE", outside)
        result :: Fetch.fetch(tmp, manifest, None, options)
        loop (key, value) in previous_env {
            match value { Some(value) -> env.set_var(key, value); None -> env.remove_var(key) }
        }
        result
    })
    _ :: fs.remove_file(source)
    if backup.exists() { fs.rename(backup, source).unwrap() }
    (_, dep_dirs) :: result.expect("local Git fetch must use the opened source authority")
    fetched_manifest :: fs.read_to_string(dep_dirs.get("safe").expect("local Git dependency directory is returned").join("package.jet")).unwrap()
    assert(fetched_manifest.contains("name: \"safe\""))
    assert(!fetched_manifest.contains("name: \"evil\""))
    log_text :: fs.read_to_string(log).unwrap()
    assert(log_text.lines().any(line -> line == "authority=fd"), "local Git consumer did not receive the opened directory authority:\n{log_text}")
    assert(!log_text.lines().any(line -> line == "authority=path"), "local Git consumer fell back to a raceable path:\n{log_text}")
    _ :: fs.remove_dir_all(tmp)
    _ :: fs.remove_dir_all(outside)
}

