// Rust: tests/pkg.rs:4618
#Test("git_dep_hostile_transports_reject_before_fake_git_execution") {
    if selected_family() != "unix" { return }
    run_case :: (label: String, url: String, expected_reason: String) -> {
        tmp :: tmp_dir(label)
        fake_bin :: tmp.join("fake-bin")
        marker :: tmp.join("git-transport-invoked")
        fs.create_dir_all(fake_bin).unwrap()
        fake_git :: fake_bin.join("git")
        fs.write(fake_git, r#"#!/bin/sh
touch "$JET_TEST_GIT_INVOKED"
exit 99
"#).unwrap()
        fs.set_permissions(fake_git, fs.Permissions.from_mode(0o755)).unwrap()
        raw :: manifest_with_deps("app", "0.1.0", "    hostile: {{ git: \"{url}\", rev: \"0000000000000000000000000000000000000000\" }},")
        write(tmp, "package.jet", raw)
        manifest :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
        store :: tmp.join("store")
        fs.create_dir_all(store).unwrap()
        options :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
        path_entries := [fake_bin]
        if path :: env.var_os("PATH") { &path_entries.extend(env.split_paths(path)) }
        fake_path :: env.join_paths(path_entries).unwrap()
        previous_path :: env.var_os("PATH")
        previous_marker :: env.var_os("JET_TEST_GIT_INVOKED")
        diagnostics :: with_store(store, () -> {
            env.set_var("PATH", fake_path)
            env.set_var("JET_TEST_GIT_INVOKED", marker)
            result :: Fetch.fetch(tmp, manifest, None, options)
            match previous_path { Some(value) -> env.set_var("PATH", value); None -> env.remove_var("PATH") }
            match previous_marker { Some(value) -> env.set_var("JET_TEST_GIT_INVOKED", value); None -> env.remove_var("JET_TEST_GIT_INVOKED") }
            result.expect_err("hostile Git transport must be rejected")
        })
        assert_eq(first_diag_code(diagnostics), "E1203")
        rendered :: Diagnostics.render_all(tmp.join("package.jet").to_string_lossy(), raw, diagnostics)
        assert(rendered.contains(expected_reason), "unexpected hostile Git policy diagnostic:\n{rendered}")
        assert(!marker.exists(), "hostile Git transport executed fake git for {url}")
        assert(!tmp.join(".jet").exists(), "rejected Git transport created project state")
        _ :: fs.remove_dir_all(tmp)
    }
    run_case("git_hostile_private", "http://127.0.0.1:9/private.git", "destination resolves to a non-public address")
    run_case("git_hostile_reserved", "https://192.0.0.1/repository.git", "destination resolves to a non-public address")
    run_case("git_hostile_link_local", "https://169.254.169.254/latest/repository.git", "destination resolves to a non-public address")
    run_case("git_hostile_credentials", "https://user:secret@example.com/repository.git", "SSH user-info must be a safe username")
    local_project :: tmp_dir("git_hostile_local")
    outside :: local_project.with_file_name("jet_pkg_git_hostile_outside_{process.id()}")
    fs.create_dir_all(outside).unwrap()
    run_case("git_hostile_local_file", "file://{outside.display()}", "local Git path resolves outside the project root")
    _ :: fs.remove_dir_all(local_project)
    _ :: fs.remove_dir_all(outside)
    run_case("git_hostile_local_path", "../unscoped.git", "local git paths must use file:// inside the project root")
}

