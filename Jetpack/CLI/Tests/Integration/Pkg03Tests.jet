// Rust: tests/pkg.rs:3625
#Test("locked_build_rejects_tampered_path_dependency_store_entry") {
    tmp :: tmp_dir("locked_build_path_tamper")
    store :: tmp.join("store")
    dependency :: tmp.join("greeter")
    fs.create_dir_all(store).unwrap()
    write(dependency, "package.jet", min_manifest("greeter", "0.1.0"))
    write(dependency, "greeter.jet", "pub fn greet() -> {}")
    raw :: manifest_with_deps("app", "0.1.0", "    greeter: ./greeter,")
    write(tmp, "package.jet", raw)
    write(tmp, "run.jet", "fn run() -> {}\n")
    manifest :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    unlocked :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    (lock, _) :: with_store(store, () -> Fetch.fetch(tmp, manifest, None, unlocked).expect("initial path fetch should create a lock hash"))
    locked := Driver.BuildRunOptions.default()
    &locked.locked = true
    entry :: tmp.join("run.jet")
    errors :: with_store(store, () -> {
        package :: lock.packages.iter().find(package -> package.name == "greeter").expect("path dependency must be recorded in the lock")
        store_entry :: Store.store_path(package.name, package.version, package.fingerprint)
        fs.write(store_entry.join("greeter.jet"), "pub fn compromised() -> {}\n").unwrap()
        Driver.compile_bundle_path_build(entry.to_str().unwrap(), locked).expect_err("locked build must reject a changed store entry before loading it")
    })
    assert_eq(first_diag_code(errors), "E1204")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:3671
#Test("locked_build_rejects_wide_empty_store_tree_before_dependency_manifest_load") {
    tmp :: tmp_dir("locked_build_wide_empty_tree")
    store :: tmp.join("store")
    dependency :: tmp.join("greeter")
    fs.create_dir_all(store).unwrap()
    write(dependency, "package.jet", min_manifest("greeter", "0.1.0"))
    write(dependency, "greeter.jet", "pub fn greet() -> {}\n")
    loop index in 0..128 { fs.create_dir(dependency.join("empty-{index}")).unwrap() }
    raw :: manifest_with_deps("app", "0.1.0", "    greeter: ./greeter,")
    write(tmp, "package.jet", raw)
    write(tmp, "run.jet", "fn run() -> {}\n")
    manifest :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    unlocked :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    (lock, _) :: with_store(store, () -> Fetch.fetch(tmp, manifest, None, unlocked).expect("initial path fetch should create a lock hash"))
    lock_before :: fs.read(tmp.join(".jet/lock")).unwrap()
    locked := Driver.BuildRunOptions.default()
    &locked.locked = true
    entry :: tmp.join("run.jet")
    errors :: with_store(store, () -> {
        package :: lock.packages.iter().find(package -> package.name == "greeter").expect("path dependency must be recorded in the lock")
        store_entry :: Store.store_path(package.name, package.version, package.fingerprint)
        assert(store_entry.join("empty-127").is_dir())
        // Bounded verification must precede malformed manifest loading.
        fs.write(store_entry.join("package.jet"), "not a package\n").unwrap()
        errors :: Driver.compile_bundle_path_build(entry.to_str().unwrap(), locked).expect_err("locked build must reject a changed wide source tree")
        assert_eq(fs.read(store_entry.join("package.jet")).unwrap(), "not a package\n".as_bytes())
        errors
    })
    assert_eq(first_diag_code(errors), "E1204")
    assert_eq(fs.read(tmp.join(".jet/lock")).unwrap(), lock_before)
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:3730
#Test("locked_build_rejects_deep_store_tree_before_dependency_manifest_load") {
    tmp :: tmp_dir("locked_build_deep_tree")
    store :: tmp.join("store")
    dependency :: tmp.join("greeter")
    fs.create_dir_all(store).unwrap()
    write(dependency, "package.jet", min_manifest("greeter", "0.1.0"))
    write(dependency, "greeter.jet", "pub fn greet() -> {}\n")
    raw :: manifest_with_deps("app", "0.1.0", "    greeter: ./greeter,")
    write(tmp, "package.jet", raw)
    write(tmp, "run.jet", "fn run() -> {}\n")
    manifest :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    unlocked :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    (lock, _) :: with_store(store, () -> Fetch.fetch(tmp, manifest, None, unlocked).expect("initial path fetch should create a lock hash"))
    locked := Driver.BuildRunOptions.default()
    &locked.locked = true
    entry :: tmp.join("run.jet")
    errors :: with_store(store, () -> {
        package :: lock.packages.iter().find(package -> package.name == "greeter").expect("path dependency must be recorded in the lock")
        store_entry :: Store.store_path(package.name, package.version, package.fingerprint)
        nested := store_entry.clone()
        loop index in 0..=SHA256.MAX_TREE_DEPTH {
            &nested.push("d{index}")
            fs.create_dir(nested).unwrap()
        }
        fs.write(store_entry.join("package.jet"), "not a package\n").unwrap()
        Driver.compile_bundle_path_build(entry.to_str().unwrap(), locked).expect_err("locked build must reject a deep source tree before loading it")
    })
    assert_eq(first_diag_code(errors), "E1204")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:3783
#Test("locked_build_rejects_manifest_lock_path_identity_mismatch") {
    tmp :: tmp_dir("locked_build_path_identity")
    store :: tmp.join("store")
    dependency :: tmp.join("greeter")
    fs.create_dir_all(store).unwrap()
    write(dependency, "package.jet", min_manifest("greeter", "0.1.0"))
    write(dependency, "greeter.jet", "pub fn greet() -> {}\n")
    raw :: manifest_with_deps("app", "0.1.0", "    greeter: ./greeter,")
    write(tmp, "package.jet", raw)
    write(tmp, "run.jet", "fn run() -> {}\n")
    manifest :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    unlocked :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    (lock, _) := with_store(store, () -> Fetch.fetch(tmp, manifest, None, unlocked).expect("initial path fetch should create a lock"))
    package := &lock.packages.iter_mut().find(package -> package.name == "greeter").expect("path dependency must be recorded in the lock")
    assert_eq(package.version, "0.1.0")
    &package.source = Lock.LockSource.Path("./other")
    fs.write(tmp.join(".jet/lock"), Lock.write(lock)).unwrap()
    locked := Driver.BuildRunOptions.default()
    &locked.locked = true
    entry :: tmp.join("run.jet")
    errors :: with_store(store, () -> Driver.compile_bundle_path_build(entry.to_str().unwrap(), locked).expect_err("locked build must reject a manifest/lock path identity mismatch"))
    assert_eq(first_diag_code(errors), "E1204")
    rendered :: Diagnostics.render_all("package.jet", raw, errors)
    assert_eq(rendered, "Error [E1204]: locked dependency `greeter` failed source verification\n Why: the locked path source disagrees with the manifest\n Fix: run `jet fetch` to recreate the lock from the verified dependency source\nMore: jet-lang.dev/e/E1204\n")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:3836
#Test("registry_dependency_reports_transport_failure") {
    tmp :: tmp_dir("registry_dep_staged")
    store :: tmp.join("store")
    fs.create_dir_all(store).unwrap()
    raw :: manifest_with_deps("app", "0.1.0", "    textkit: textkit#1.2.0,")
    write(tmp, "package.jet", raw)
    mf :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    opts :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    diags :: with_store(store, () -> Fetch.fetch(tmp, mf, None, opts)).expect_err("registry dependency must report its verified transport diagnostic")
    assert_eq(first_diag_code(diags), "E1207")
    rendered :: Diagnostics.render_all(tmp.join("package.jet").to_string_lossy(), raw, diags)
    assert(rendered.contains("Error [E1207]:"), "unexpected diagnostic:\n{rendered}")
    assert(rendered.contains("Why:"), "missing E1207 reason:\n{rendered}")
    assert(rendered.contains("Fix:"), "missing E1207 fix:\n{rendered}")
    snapshot :: OSPath.from_text(env.var("CARGO_MANIFEST_DIR").unwrap()).join("tests/fixtures/jetpack-diagnostics/E1207.stderr")
    if env.var_os("UPDATE_EXPECT").is_some() { fs.write(snapshot, rendered).unwrap() }
    assert_eq(rendered, fs.read_to_string(snapshot).unwrap())
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:3877
#Test("git_dep_local_bare_repo_fetches_ok") {
    if !have_git() {
        eprintln("note: skipping git_dep_local_bare_repo (git not found)")
        return
    }
    tmp :: tmp_dir("git_dep")
    src :: tmp.join("mylib_src")
    write(src, "mylib.jet", "pub fn answer() -> Int { return 42 }\n")
    write(src, "package.jet", min_manifest("mylib", "0.1.0"))
    bare :: tmp.join("mylib.git")
    _ :: Command.new("git").args(["init", "--bare", bare.to_str().unwrap()]).output().unwrap()
    clone :: tmp.join("mylib_clone")
    _ :: Command.new("git").args(["clone", bare.to_str().unwrap(), clone.to_str().unwrap()]).output().unwrap()
    loop e in fs.read_dir(src).unwrap().flatten() { fs.copy(e.path(), clone.join(e.file_name())).unwrap() }
    loop (k, v) in [("user.email", "test@jet.test"), ("user.name", "Jet Test")] {
        _ :: Command.new("git").args(["config", k, v]).current_dir(clone).output().unwrap()
    }
    _ :: Command.new("git").args(["add", "."]).current_dir(clone).output().unwrap()
    _ :: Command.new("git").args(["commit", "-m", "init"]).current_dir(clone).output().unwrap()
    _ :: Command.new("git").args(["push", "origin", "HEAD:main"]).current_dir(clone).output().unwrap()
    _ :: Command.new("git").args(["tag", "v0.1.0"]).current_dir(clone).output().unwrap()
    _ :: Command.new("git").args(["push", "origin", "v0.1.0"]).current_dir(clone).output().unwrap()
    repo_url :: "file://{bare.to_str().unwrap()}"
    raw :: manifest_with_deps("app", "0.1.0", "    mylib: {{ git: \"{repo_url}\", tag: \"v0.1.0\" }},")
    write(tmp, "package.jet", raw)
    write(tmp, "run.jet", "fn run() -> {}\n")
    store :: tmp.join("store")
    fs.create_dir_all(store).unwrap()
    home :: tmp.join("home")
    fs.create_dir_all(home).unwrap()
    mf :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    opts :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    previous_home :: env.var_os("HOME")
    env.set_var("HOME", home)
    (lock, _) :: with_store(store, () -> Fetch.fetch(tmp, mf, None, opts).expect("git dep fetch should succeed"))
    match previous_home {
        Some(value) -> env.set_var("HOME", value)
        None -> env.remove_var("HOME")
    }
    revision :: lock.packages.iter().find(package -> package.name == "mylib").and_then(package -> package.locked.as_ref()).expect("git lock entry should pin a revision")
    url_hash :: SHA256.sha256_hex(repo_url.as_bytes())
    revision_prefix: String :: revision.rev.chars().take(16).collect()
    cache_dir :: home.join(".jet").join("git-cache").join(url_hash[..16]).join(revision_prefix)
    fs.write(cache_dir.join("mylib.jet"), "pub fn compromised() -> {}\n").unwrap()
    fs.write(tmp.join(".jet/build/deps/mylib/mylib.jet"), "pub fn compromised() -> {}\n").unwrap()
    locked :: Fetch.FetchOptions(locked: true, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    previous_home :: env.var_os("HOME")
    env.set_var("HOME", home)
    error :: with_store(store, () -> Fetch.fetch(tmp, mf, Some(lock), locked).expect_err("locked fetch must reject a changed git cache"))
    match previous_home {
        Some(value) -> env.set_var("HOME", value)
        None -> env.remove_var("HOME")
    }
    assert_eq(first_diag_code(error), "E1204")
    locked_build := Driver.BuildRunOptions.default()
    &locked_build.locked = true
    entry :: tmp.join("run.jet")
    build_error :: with_store(store, () -> Driver.compile_bundle_path_build(entry.to_str().unwrap(), locked_build).expect_err("locked build must reject a changed Git dependency link"))
    assert_eq(first_diag_code(build_error), "E1204")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:4022
#Test("git_revision_with_multibyte_prefix_does_not_panic") {
    if !have_git() {
        eprintln("note: skipping git_revision_with_multibyte_prefix (git not found)")
        return
    }
    tmp :: tmp_dir("git_revision_utf8")
    revision :: "{\"a\".repeat(15)}é"
    raw :: manifest_with_deps("app", "0.1.0", "    broken: {{ git: \"file:///definitely/missing.git\", rev: \"{revision}\" }},")
    write(tmp, "package.jet", raw)
    manifest :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    store :: tmp.join("store")
    fs.create_dir_all(store).unwrap()
    options :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    result :: panic.catch_unwind(panic.AssertUnwindSafe(() -> with_store(store, () -> Fetch.fetch(tmp, manifest, None, options))))
    assert(result.is_ok(), "a multibyte git revision must return a diagnostic, not panic")
    assert(result.unwrap().is_err(), "the missing repository must fail")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:4060
#Test("git_dep_rejects_private_transport_before_network_access") {
    if !have_git() {
        eprintln("note: skipping git_dep_private_transport (git not found)")
        return
    }
    tmp :: tmp_dir("git_private_transport")
    raw :: manifest_with_deps("app", "0.1.0", "    private: { git: \"http://127.0.0.1:9/private.git\", rev: \"0000000000000000000000000000000000000000\" },")
    write(tmp, "package.jet", raw)
    mf :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    store :: tmp.join("store")
    fs.create_dir_all(store).unwrap()
    opts :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    diags :: with_store(store, () -> Fetch.fetch(tmp, mf, None, opts)).expect_err("private git transport must be rejected before clone")
    assert_eq(first_diag_code(diags), "E1203")
    rendered :: Diagnostics.render_all(tmp.join("package.jet").to_string_lossy(), raw, diags)
    assert(rendered.contains("not allowed"), "unexpected diagnostic:\n{rendered}")
    assert(!tmp.join(".jet").exists(), "rejected transport created project state")
    _ :: fs.remove_dir_all(tmp)
}

