#Test("git_dep_branch_update_rewrites_lock") {
    if !have_git() {
        eprintln("note: skipping git_dep_branch_update_rewrites_lock (git not found)")
        return
    }
    tmp :: tmp_dir("git_branch_upd")
    src :: tmp.join("mylib_src")
    write(src, "mylib.jet", "pub fn answer() -> Int { return 42 }\n")
    write(src, "package.jet", min_manifest("mylib", "0.1.0"))
    init_repo :: tmp.join("mylib_init")
    _ :: Command.new("git").args(["init", "-b", "main", init_repo.to_str().unwrap()]).output().unwrap()
    loop e in fs.read_dir(src).unwrap().flatten() { fs.copy(e.path(), init_repo.join(e.file_name())).unwrap() }
    loop (k, v) in [("user.email", "test@jet.test"), ("user.name", "Jet Test")] {
        _ :: Command.new("git").args(["config", k, v]).current_dir(init_repo).output().unwrap()
    }
    _ :: Command.new("git").args(["add", "."]).current_dir(init_repo).output().unwrap()
    _ :: Command.new("git").args(["commit", "-m", "init"]).current_dir(init_repo).output().unwrap()
    bare :: tmp.join("mylib.git")
    _ :: Command.new("git").args(["clone", "--bare", init_repo.to_str().unwrap(), bare.to_str().unwrap()]).output().unwrap()
    clone :: tmp.join("mylib_clone")
    _ :: Command.new("git").args(["clone", bare.to_str().unwrap(), clone.to_str().unwrap()]).output().unwrap()
    loop (k, v) in [("user.email", "test@jet.test"), ("user.name", "Jet Test")] {
        _ :: Command.new("git").args(["config", k, v]).current_dir(clone).output().unwrap()
    }
    repo_url :: "file://{bare.to_str().unwrap()}"
    raw :: manifest_with_deps("app", "0.1.0", "    mylib: {{ git: \"{repo_url}\", branch: \"main\" }},")
    write(tmp, "package.jet", raw)
    store :: tmp.join("store")
    fs.create_dir_all(store).unwrap()
    mf :: Manifest.parse(tmp.join("package.jet"), raw).unwrap()
    opts :: Fetch.FetchOptions(locked: false, update: false, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    result :: with_store(store, () -> Fetch.fetch(tmp, mf, None, opts))
    assert(result.is_ok(), "initial git branch fetch should succeed: {result.err():?}")
    lock_raw :: fs.read_to_string(tmp.join(".jet/lock")).expect(".jet/lock must exist")
    initial_rev :: extract_rev_from_lock(lock_raw)
    assert(!initial_rev.is_empty(), "lock must contain a rev after initial fetch")
    write(clone, "extra.jet", "pub fn extra() -> Int { return 99 }\n")
    _ :: Command.new("git").args(["add", "."]).current_dir(clone).output().unwrap()
    _ :: Command.new("git").args(["commit", "-m", "second commit"]).current_dir(clone).output().unwrap()
    _ :: Command.new("git").args(["push", "origin", "HEAD:main"]).current_dir(clone).output().unwrap()
    lock_str :: fs.read_to_string(tmp.join(".jet/lock")).unwrap()
    existing_lock :: Lock.parse(lock_str).expect("initial lock must parse")
    update_opts :: Fetch.FetchOptions(locked: false, update: true, update_dep: None, resolution: Publish.ResolveMode.Conservative)
    result2 :: with_store(store, () -> Fetch.fetch(tmp, mf, Some(existing_lock), update_opts))
    assert(result2.is_ok(), "update fetch should succeed: {result2.err():?}")
    lock_raw2 :: fs.read_to_string(tmp.join(".jet/lock")).expect(".jet/lock must exist after update")
    new_rev :: extract_rev_from_lock(lock_raw2)
    assert(!new_rev.is_empty(), "lock must contain a rev after update fetch")
    assert_ne(initial_rev, new_rev, "lock rev must change after a new commit was pushed")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:5173
#Test("cli_jet_new_creates_project_structure") {
    assert(jet_bin().is_file(), "the Cargo-provided jet binary must exist for this production-path test")
    tmp :: tmp_dir("cli_new")
    store :: tmp.join("store")
    fs.create_dir_all(store).unwrap()
    out :: jet_cmd(["new", "myapp"], tmp, store)
    assert(out.status.success(), "jet new failed:\n{String.from_utf8_lossy(out.stderr)}")
    proj :: tmp.join("myapp")
    assert(proj.join("package.jet").is_file(), "jet new must create package.jet")
    assert(proj.join("run.jet").is_file(), "jet new must create run.jet")
    generated_run :: fs.read_to_string(proj.join("run.jet")).unwrap()
    assert(generated_run.contains("fn run()") && !generated_run.contains("#CLI") && !generated_run.contains("core.ui"), "plain jet-new starter must be print-only:\n{generated_run}")
    assert(proj.join(".gitignore").is_file(), "jet new must create .gitignore")
    run :: jet_cmd(["run"], proj, store)
    assert(run.status.success(), "new project must run without naming a file:\n{String.from_utf8_lossy(run.stderr)}")
    assert_eq(String.from_utf8_lossy(run.stdout), "hello, world\n")
    check :: jet_cmd(["check"], proj, store)
    assert(check.status.success(), "new project must check without naming a file:\n{String.from_utf8_lossy(check.stderr)}")
    edited_source :: "fn run() -> { print(\"edited\") }\n#Test(\"scaffold smoke\") { assert(true) }\n"
    write(proj, "run.jet", edited_source)
    test :: jet_cmd(["test"], proj, store)
    assert(test.status.success(), "an edited project with a test must test without naming a file:\n{String.from_utf8_lossy(test.stderr)}")
    write(proj, "run.jet", "fn run() -> { print(unknown_scaffold_name) }\n")
    invalid :: jet_cmd(["check"], proj, store)
    assert(!invalid.status.success(), "invalid source must fail `jet check`")
    assert(String.from_utf8_lossy(invalid.stderr).contains("Error ["), "invalid source lost its diagnostic:\n{String.from_utf8_lossy(invalid.stderr)}")
    write(proj, "run.jet", edited_source)
    loop args in [["run", "--profile=debug"], ["dev", "--watch=off"]] {
        output :: jet_cmd(args, proj, store)
        assert(output.status.success(), "newcomer command {args:?} failed:\n{String.from_utf8_lossy(output.stderr)}")
        assert_eq(String.from_utf8_lossy(output.stdout), "edited\n", "newcomer command {args:?} chose a different entry or tier")
    }
    update :: jet_cmd(["update", "jet"], proj, store)
    assert(update.status.success(), "new project toolchain pin must update:\n{String.from_utf8_lossy(update.stderr)}")
    assert(proj.join(".jet/lock").is_file(), "toolchain update must write .jet/lock")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:5282
#Test("cli_beginner_onboarding_ordered_workflow_uses_real_binary") {
    assert(jet_bin().is_file(), "the Cargo-provided jet binary must exist for this production-path test")
    tmp :: tmp_dir("cli_beginner_onboarding")
    store :: tmp.join("store")
    fs.create_dir_all(store).unwrap()
    created :: jet_cmd(["new", "hello"], tmp, store)
    assert(created.status.success(), "jet new failed:\n{String.from_utf8_lossy(created.stderr)}")
    project :: tmp.join("hello")
    assert(project.join("run.jet").is_file())
    assert(project.join("package.jet").is_file())
    first_run :: jet_cmd(["run"], project, store)
    assert(first_run.status.success())
    assert_eq(String.from_utf8_lossy(first_run.stdout), "hello, world\n")
    source :: r#"#CLI
struct GreetingArgs {
    #Doc("name to greet") name: String{"Jet"}
}

fn greet(name: String) -> String {
    return "hello, {name}"
}

#Test("greet says hello") {
    assert_eq(greet("Jet"), "hello, Jet")
}

fn run(args: GreetingArgs) -> {
    print(greet(args.name))
}
"#
    write(project, "run.jet", source)
    check :: jet_cmd(["check"], project, store)
    assert(check.status.success(), "jet check failed:\n{String.from_utf8_lossy(check.stderr)}")
    tests :: jet_cmd(["test"], project, store)
    assert(tests.status.success(), "jet test failed:\n{String.from_utf8_lossy(tests.stderr)}")
    test_stdout :: String.from_utf8_lossy(tests.stdout)
    assert(test_stdout.contains("greet says hello: pass"), "{test_stdout}")
    assert(test_stdout.contains("1 passed, 0 failed, 0 skipped"), "{test_stdout}")
    explicit_run :: jet_cmd(["run", "run.jet"], project, store)
    assert(explicit_run.status.success())
    assert_eq(String.from_utf8_lossy(explicit_run.stdout), "hello, Jet\n")
    write(project, "run.jet", "print(\"before\")\nfn run() -> { print(\"middle\") }\nprint(\"after\")\n")
    invalid :: jet_cmd(["check"], project, store)
    assert(!invalid.status.success())
    invalid_stderr :: String.from_utf8_lossy(invalid.stderr)
    assert(invalid_stderr.contains("E0621"), "{invalid_stderr}")
    explanation :: jet_cmd(["explain", "E0621"], project, store)
    assert(explanation.status.success())
    explanation_stdout :: String.from_utf8_lossy(explanation.stdout)
    assert(explanation_stdout.contains("What this means:"), "{explanation_stdout}")
    assert(explanation_stdout.contains("Why Jet enforces it:"), "{explanation_stdout}")
    assert(explanation_stdout.contains("How to fix it:"), "{explanation_stdout}")
    _ :: fs.remove_dir_all(tmp)
}

// Rust: tests/pkg.rs:5385
#Test("cli_run_migrates_all_retired_entry_layouts") {
    assert(jet_bin().is_file(), "the Cargo-provided jet binary must exist")
    tmp :: tmp_dir("cli_run_entry_migration")
    store :: tmp.join("store")
    fs.create_dir_all(store).unwrap()
    loop (label, retired, canonical) in [("root", "main.jet", "run.jet"), ("src", "src/main.jet", "src/run.jet"), ("managed", ".jet/main.jet", "run.jet")] {
        project :: tmp.join(label)
        fs.create_dir_all(project).unwrap()
        write(project, "package.jet", min_manifest(label, "0.1.0"))
        write(project, retired, "fn run() -> {{ print(\"{label}\") }}\n")
        out :: jet_cmd(["run"], project, store)
        assert(out.status.success(), "jet run failed for {label} layout:\n{String.from_utf8_lossy(out.stderr)}")
        assert_eq(String.from_utf8_lossy(out.stdout), "{label}\n")
        assert(project.join(canonical).is_file())
        assert(!project.join(retired).exists())
        stderr :: String.from_utf8_lossy(out.stderr)
        assert(stderr.contains("notice: migrated retired entry"), "{stderr}")
        assert(stderr.contains("main.jet") && stderr.contains("run.jet"), "{stderr}")
    }
    fs.remove_dir_all(tmp).unwrap()
}
