// Claims for `jetpack lock diff` rendering (Rust jetpack::CLI::lock tests).

fn cli_lock_test_lock(package: String, version: String, trust: String) -> LockFile {
    tier :: if trust == {
        "signed" -> "official-signed"
        "unverified-mapping" -> "local-unofficial"
        else -> ""
    }
    catalog_trust :: if trust == {
        "signed" -> "verified"
        "unverified-mapping" -> "unverified"
        else -> ""
    }
    // A Nix package carries its portable closure record (Lock/Parse.jet
    // `pkg_lock_validate_package_nix`): the source output, `nix-output`, and
    // the envelope `output-hash` are one CAS digest; `nix-system` is the
    // envelope platform.
    output :: "sha256-{"1".repeat(64)}"
    closure :: "nix-channel = \"nixpkgs-unstable\"\nnix-revision = \"{"a".repeat(40)}\"\nnix-system = \"x86_64-linux\"\nnix-index-authority = \"{"b".repeat(64)}\"\nnix-derivation = \"{"c".repeat(64)}\"\nnix-output = \"{output}\"\nnix-nar-hash = \"sha256:{"d".repeat(64)}\"\nnix-size = 42\nnix-compression = \"zstd\"\nnix-references = []\nnix-upstream-proof = \"sha256-{"e".repeat(64)}\"\nnix-cache-key = \"{"f".repeat(64)}\"\nnix-project-cas-bundle = \"sha256-{"0".repeat(64)}\"\n"
    text :: "version = 1\n\n[[package]]\nname = \"{package}\"\nversion = \"{version}\"\nsource = {{ nix = \"{package}@nixpkgs\", output = \"{output}\" }}\nfingerprint = \"fp\"\ndependencies = []\noutput-hash = \"{output}\"\nplatform = \"x86_64-linux\"\ncatalog-tier = \"{tier}\"\ncatalog-trust = \"{catalog_trust}\"\nprovenance = \"\"\n{closure}"
    pkg_lock_parse(text) ?? panic("test lock")
}

#Test("cli lock diff rendering is changelog shaped") {
    before :: cli_lock_test_lock("alpha", "1.0.0", "signed")
    after := cli_lock_test_lock("alpha", "1.1.0", "unverified-mapping")
    added :: pkg_lock_parse("version = 1\n\n[[package]]\nname = \"beta\"\nversion = \"2.0.0\"\nsource = {{ path = \"beta\" }}\nfingerprint = \"fp\"\ndependencies = []\n") ?? panic("added package")
    &after.packages.push(added.packages[0])
    diff :: LockDiff.between(Val(before), Val(after))
    rendered :: cli_render_lock_diff_lines(diff, DiffSizes{download: Val(1500000), disk: Val(-2000000)}).join("\n")
    assert(rendered.contains("~ alpha 1.0.0 → 1.1.0"), rendered)
    assert(rendered.contains("+ beta 2.0.0"), rendered)
    assert(rendered.contains("1 added, 0 removed, 1 updated"), rendered)
    assert(rendered.contains("net download +1.5 MB · net disk -2.0 MB"), rendered)
    assert(rendered.contains("trust alpha: signed → unverified-mapping"), rendered)
}
