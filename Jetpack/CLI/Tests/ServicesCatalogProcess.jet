// Catalog-preset claims ported from tests/jetpack_services.rs (Linux only).
//
// The Rust suite re-executes its own test binary as the detached supervisor
// (`production_catalog_service_worker`, `Services::up_one` under
// JETPACK_SERVICE_SUPERVISOR=1). A Jet claim cannot re-execute one claim, so
// the worker is the same production supervisor path reached through the real
// binary: `jetpack services up <name> --trust` with JETPACK_SERVICE_SUPERVISOR
// set, the catalog tool fixture and fake systemd first on PATH, and a project
// declaring exactly the worker's plan (`<name>: { ports: [<port>] }`).
// That path also realizes the catalog package an enabled preset folds into
// the project (`redis@jetpack` for `redis`), so each worker runs offline
// against a pinned fixture whose output carries the catalog tool fixture.

// The catalog tool fixture under `<root>/bin`, one script per tool name.
cli_test_install_catalog_tools: fn(root: String) -[FS]> {
    bin: files.join(root, "bin")
    files.create_dir_all(bin) ?? panic("create catalog tool bin")
    names: [String]{"initdb", "redis-server", "mysqld", "mariadb-install-db", "postgres", "mariadbd", "minio", "blackfire", "tideways-daemon", "nginx", "pg_isready", "redis-cli", "mysqladmin", "mariadb-admin", "curl"}
    loop name in names -> cli_test_write_script(files.join(bin, name), CLI_TEST_CATALOG_TOOL)
}

// The offline fixture directory pinning the catalog package of service
// `name`. Its sealed output's `bin/` holds the catalog tool fixture scripts
// installed under `<root>/bin` (none when the claim installed no tools).
cli_test_catalog_package_fixtures: fn(root: String, name: String) -[FS, Env]> String {
    reference: services_catalog_pkg_ref(name) ?? panic("catalog service `{name}` folds a package")
    package: reference.cut_last("@")?.before ?? panic("catalog package ref `{reference}` names a source")
    fixtures: files.join(root, "fixtures")
    output: files.join(root, "package-{package}")
    output_bin: files.join(output, "bin")
    files.create_dir_all(fixtures) ?? panic("create catalog fixtures")
    files.create_dir_all(output_bin) ?? panic("create catalog package bin")
    tool_bin: files.join(root, "bin")
    if files.is_dir(tool_bin) {
        loop entry in files.list_dir(tool_bin) ?? panic("list catalog tools") -> cli_test_write_script(files.join(output_bin, entry.name), CLI_TEST_CATALOG_TOOL)
    }
    store_seal_local_output(output) ?? panic("seal catalog package: {err.message()}")
    output_hash: pkg_try_output_hash_of(output) ?? panic("hash catalog package: {err.message()}")
    jetpack_import: Dyn.Object([
        "closedGraph": Dyn.Object(["root": Dyn.Object(["dependencies": Dyn.Array([Dyn]{})])]),
        "selectedOutputs": Dyn.Object(["out": Dyn.Text(output.copy())]),
        "dependencies": Dyn.Array([Dyn]{}),
        "sources": Dyn.Array([Dyn]{}),
        "hashes": Dyn.Object(["out": Dyn.Text(output_hash)]),
        "losses": Dyn.Array([Dyn]{}),
        "proof": Dyn.Object(["source": Dyn.Text("services-catalog")]),
        "recipe": Dyn.Object(["kind": Dyn.Text("compatibility")]),
        "lock": Dyn.Object(["system": Dyn.Text("x86_64-linux")]),
    ])
    record: Dyn.Object(["drvPath": Dyn.Text("/nix/store/0fixture00000000000000000000-{package}.drv"), "outputs": Dyn.Object(["out": Dyn.Text(output.copy())]), "jetpackImport": jetpack_import])
    files.write(files.join(fixtures, "jetpack-{package}.json"), cli_json_render(Dyn.Array([Dyn]{record}))) ?? panic("write catalog package fixture")
    fixtures
}

// The tool scratch, sealed package fixtures included; best-effort.
cli_test_remove_catalog_tools: fn(root: String) -[FS, Env]> {
    store_make_tree_writable_for_removal(root).drop("sealed scratch cleanup is best-effort")
    files.remove_all(root).drop("scratch cleanup is best-effort")
}

// The Rust `catalog_tool_env`: the tool bin (and optionally the fake
// systemd bin) with no variables or refs.
cli_test_catalog_tool_env: fn(root: String, systemd_bin: String?) -> ShellEnv {
    bin_dirs := [String]{files.join(root, "bin")}
    if systemd_bin == {
        .Val(bin) -> bin_dirs.push(bin.copy())
        .None -> {}
    }
    ShellEnv{
        bin_dirs: bin_dirs,
        vars: [String: String]{},
        unset_vars: [String]{},
        refs: [String]{},
        label: "catalog-test",
        prompt_path: PromptPathMode.Short,
        prompt_strip: PromptStripMode.Off,
        cache_leases: [CacheLease]{}
    }
}

// The production supervisor for catalog service `name` on `port`, started
// offline in `project` with its catalog package fixture, and the catalog
// tools and fake systemd first on PATH.
cli_test_catalog_worker: fn(claim: ServicesClaim, tools: String, fake: FakeSystemd, name: String, port: Int) -[FS, Env, Exec]> ProcessSpec {
    files.write(files.join(claim.project, "env.jet"), "env.dev: module {{ services: {{ {name}: {{ enable: true, ports: [{port}] }} }} }}\n") ?? panic("write catalog env.jet")
    fixtures: cli_test_catalog_package_fixtures(tools, name)
    path: "{files.join(tools, "bin")}:{fake.path()}"
    cli_test_jetpack([String]{"services", "up", name, "--trust", "--offline", "--no-color"})
        .cwd(claim.project)
        .env("JETPACK_ROOT", claim.root)
        .env("HOME", claim.home)
        .env("JETPACK_FAKE_SYSTEMD_STATE", fake.state)
        .env("JETPACK_FIXTURES", fixtures)
        .env("JETPACK_SERVICE_SUPERVISOR", "1")
        .env("PATH", path)
}

#Test("services production catalog services prepare state and pass readiness") {
    if !sys.is_linux() -> return
    claim: ServicesClaim.new("catalog-production")
    tools: files.tmpdir("jet-catalog-production-tools-") ?? panic("claim tool scratch")
    cli_test_install_catalog_tools(tools)
    fake: claim.fake ?? panic("Linux claims install the fake systemd")
    env := cli_test_catalog_tool_env(tools, None)
    names: [String]{"redis", "postgres", "mysql", "mariadb", "nginx", "minio", "blackfire", "tideways"}
    loop name in names {
        plan: DevServicePlan{name: name, enable: true, ports: [Int]{0}}
        supervisor := cli_test_catalog_worker(claim, tools, fake, name, 0).spawn() ?? panic("spawn catalog supervisor")
        service_dir: claim.service_dir(name)
        cli_test_wait_for_file_contains(files.join(service_dir, "pid"), "pid=")
        assert(services_wait_healthy(claim.project, env, plan, time.duration_seconds(3)), "catalog service `{name}` did not pass its production readiness command")
        data_dir: files.join(service_dir, "data")
        if name == {
            "redis" -> assert(files.is_file(files.join(data_dir, ".service-running")))
            "postgres" -> assert(files.is_file(files.join(data_dir, "PG_VERSION")))
            "mysql" | "mariadb" -> assert(files.is_dir(files.join(data_dir, "mysql")))
            "minio" | "blackfire" | "tideways" -> assert(files.is_file(files.join(data_dir, ".service-running")))
            "nginx" -> {
                ports: files.read(files.join(service_dir, "ports")) ?? panic("read nginx ports")
                port: Int.parse(ports.lines().get(0) ?? "") ?? panic("nginx port is an integer")
                config: files.read(files.join(data_dir, "nginx-{port}/conf/nginx.conf")) ?? panic("read nginx config")
                assert(config.contains("listen 127.0.0.1:{port};"))
            }
            else -> panic("unexpected catalog service {name}")
        }
        files.write(files.join(service_dir, ".stopping"), "test\n") ?? panic("request supervisor stop")
        receipt: supervisor.wait() ?? panic("wait for catalog supervisor")
        assert(receipt.success, "catalog worker failed: stdout={receipt.output} stderr={receipt.errors}")
        cli_test_wait_for_missing(files.join(service_dir, "pid"))
    }
    cli_test_remove_catalog_tools(tools)
    claim.remove()
}

#Test("services production adminer preset fails closed without php projection") {
    if !sys.is_linux() -> return
    claim: ServicesClaim.new("adminer-owner-gate")
    tools: files.tmpdir("jet-adminer-owner-gate-tools-") ?? panic("claim tool scratch")
    fake: claim.fake ?? panic("Linux claims install the fake systemd")
    receipt: cli_test_catalog_worker(claim, tools, fake, "adminer", 0).run() ?? panic("run adminer worker")
    assert(!receipt.success, "Adminer must stay owner-gated")
    assert(receipt.errors.contains("owner-gated"), receipt.errors)
    service_dir: claim.service_dir("adminer")
    assert(!files.exists(files.join(service_dir, "pid")))
    assert(!files.exists(files.join(service_dir, "lifecycle")))
    cli_test_remove_catalog_tools(tools)
    claim.remove()
}

#Test("services production minio preset port conflict has terminal state") {
    if !sys.is_linux() -> return
    claim: ServicesClaim.new("minio-port-conflict")
    tools: files.tmpdir("jet-minio-port-conflict-tools-") ?? panic("claim tool scratch")
    cli_test_install_catalog_tools(tools)
    blocker: net.tcp_listen("127.0.0.1:0") ?? panic("bind the blocking listener")
    port: net.socket_port(net.listener_local_socket_addr(blocker) ?? panic("read the blocking listener address"))
    fake: claim.fake ?? panic("Linux claims install the fake systemd")
    receipt: cli_test_catalog_worker(claim, tools, fake, "minio", port).run() ?? panic("run minio worker")
    service_dir: claim.service_dir("minio")
    assert(!receipt.success, "port conflict must reach the worker")
    assert(!files.exists(files.join(service_dir, "pid")))
    assert(!files.exists(files.join(service_dir, "ports")))
    assert(files.is_file(files.join(service_dir, "supervisor.error")))
    lifecycle: files.read(files.join(service_dir, "lifecycle")) ?? panic("read lifecycle")
    assert(lifecycle.contains("phase=failed"), lifecycle)
    assert(lifecycle.contains("recovery=startup-failed"), lifecycle)
    blocker.drop("the blocking listener is released once the worker has failed")
    cli_test_remove_catalog_tools(tools)
    claim.remove()
}

#Test("services production postgres preset initialization failure has terminal state") {
    if !sys.is_linux() -> return
    claim: ServicesClaim.new("postgres-init-failure")
    tools: files.tmpdir("jet-postgres-init-failure-tools-") ?? panic("claim tool scratch")
    cli_test_install_catalog_tools(tools)
    files.remove(files.join(tools, "bin/initdb")) ?? panic("remove initdb")
    fake: claim.fake ?? panic("Linux claims install the fake systemd")
    receipt: cli_test_catalog_worker(claim, tools, fake, "postgres", 0).run() ?? panic("run postgres worker")
    service_dir: claim.service_dir("postgres")
    assert(!receipt.success, "initdb failure must reach the worker")
    assert(!files.exists(files.join(service_dir, "pid")))
    assert(!files.exists(files.join(service_dir, "ports")))
    assert(files.is_file(files.join(service_dir, "supervisor.error")))
    lifecycle: files.read(files.join(service_dir, "lifecycle")) ?? panic("read lifecycle")
    assert(lifecycle.contains("phase=failed"), lifecycle)
    assert(lifecycle.contains("recovery=startup-failed"), lifecycle)
    cli_test_remove_catalog_tools(tools)
    claim.remove()
}
