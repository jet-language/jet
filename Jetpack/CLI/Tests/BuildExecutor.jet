// Fixtures for the build executor ported from crates/jet-comptime
// Build/*.rs. Every boundary check has the allowed case and the refused
// neighbour beside it.

build_test_root: fn(label: String) -[FS, Env]> String Never! {
    home: sys.get("HOME") ?? panic("build executor fixtures require HOME")
    scratch: sys.get("JET_SCRATCH_ROOT") ?? (sys.get("JET_STATE_ROOT") ?? files.join(sys.get("XDG_CACHE_HOME") ?? files.join(home, ".cache"), "jet-dev"))
    root: files.join(scratch, "jet-build-executor-{label}-{sys.pid()}")
    files.remove_all(root).drop("a stale build executor fixture may be absent")
    files.create_dir_all(root) ?? panic("create fixture root")
    files.canonicalize(root) ?? panic("canonical fixture root")
}

build_test_restore_env: fn(name: String, previous: String?) -[Env]> {
    if previous == {
        .Val(value) -> sys.set(name, value)
        .None -> { sys.unset(name) ?? panic("restore environment") }
    }
}

// The sandbox PATH is `/nix/store`, a directory of store paths rather than a
// bin directory, so `cp`, `sleep` and other host tools are not commands inside
// it (Rust execution_runtime.rs tests). Sandboxed fixture scripts use shell
// builtins only.
BUILD_TEST_COPY_SCRIPT: "read -r line < input.txt; printf %s \"$line\" > out.txt"

// A fixture that exercises the native boundary needs the backend: false once
// the claim reports SKIP-HOST for the backend's absent tool (Linux runs it
// under bubblewrap), so the claim ends there. A present backend that fails its
// probe fails the claim; it never passes without running anything.
build_test_require_sandbox: fn() -[FS, Env, Exec, Time.Wait]> Bool {
    if sys.is_linux() && kit_require_tool("bwrap") == None -> return false
    status: foundation_native_sandbox_status()
    if !status.available -> panic("this fixture needs the native sandbox backend ({status.mechanism}): {status.reason}")
    true
}

// Rust `delayed_descendant_script`: a background descendant that holds the
// output pipes for two seconds of Bash's builtin `SECONDS` clock, then writes
// `marker`; `rest` runs in the foreground.
build_test_delayed_descendant: fn(marker: String, rest: String) -> String Never! {
    "(start=$SECONDS; while [ $((SECONDS-start)) -lt 2 ]; do :; done; printf leaked > {marker}) & {rest}"
}

// Rust `assert_descendant_reaped`: the descendant's marker never appears.
build_test_assert_descendant_reaped: fn(marker: String) -[FS, Time]> {
    time.sleep(time.duration_ms(3000))
    assert(!files.exists(marker))
}

// One host action `sh -c <script>` reading `input.txt` and writing `out.txt`.
build_test_plan: fn(caps: [BuildEffect], script: String) -[Rand]> HermeticBuildPlan Never! {
    build := HermeticBuildContext.new()
    spec := ActionSpec.new([String]{"sh", "-c", script}).with_inputs([String]{"input.txt"}).with_outputs([String]{"out.txt"})
    loop cap in caps -> spec = spec.with_cap(cap)
    action: build.action("write", spec) ?? panic("declare action")
    target: build.add_executable("out", TargetSpec.new().with_action(action)) ?? panic("declare target")
    build.plan_with_default(target) ?? panic("plan")
}

#Test("declared build paths: relative paths are accepted, absolute and parent paths are refused") {
    assert_eq(build_path_new("src/main.c") ?? panic("relative path"), "src/main.c")
    if build_path_new("/etc/passwd") == {
        .Err(error) -> assert(error == HermeticBuildError.InvalidPath("/etc/passwd"))
        .Ok(_) -> panic("an absolute build path must be refused")
    }
    if build_path_new("../outside") == {
        .Err(error) -> assert(error == HermeticBuildError.InvalidPath("../outside"))
        .Ok(_) -> panic("a parent build path must be refused")
    }
    if build_path_new("  ") == {
        .Err(error) -> assert(error == HermeticBuildError.EmptyPath)
        .Ok(_) -> panic("a blank build path must be refused")
    }
    build := HermeticBuildContext.new()
    if build.action("escape", ActionSpec.new([String]{"cc"}).with_outputs([String]{"../escape.o"})) == {
        .Err(error) -> assert(error == HermeticBuildError.InvalidPath("../escape.o"))
        .Ok(_) -> panic("an escaping output must be refused")
    }
    _: build.action("inside", ActionSpec.new([String]{"cc"}).with_outputs([String]{"build/inside.o"})) ?? panic("an inside output must be accepted")
}

#Test("resolve under: normal components join under the base, parent and root components are refused") {
    assert_eq(build_resolve_under("/base", "a/./b") ?? panic("normal path"), "/base/a/b")
    if build_resolve_under("/base", "a/../../etc") == {
        .Ok(_) -> panic("a parent component must not resolve")
        .Err(error) -> assert(error.kind == BuildIOKind.InvalidInput)
    }
    assert(build_resolve_under("/base", "/etc/passwd") == .Err(_))
}

#Test("ability grants: a granted ability passes the grant gate, an ungranted one is refused before any action runs") {
    root: build_test_root("grants")
    files.write(files.join(root, "input.txt"), "input") ?? panic("input")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    marker: files.join(root, "ran")
    plan: build_test_plan([BuildEffect]{BuildEffect.Exec, BuildEffect.Net}, "printf ran > '{marker}'; {BUILD_TEST_COPY_SCRIPT}")
    if build_execute_build_plan(plan, root, store, [BuildEffect]{BuildEffect.Exec}) == {
        .Err(error) -> assert(error == BuildExecutionError.MissingGrant{action: "write", capability: BuildEffect.Net})
        .Ok(_) -> panic("an ungranted Net ability must be refused")
    }
    assert(!files.exists(marker))
    assert(!files.exists(files.join(root, ".jet/build-sandbox")))
    // With both abilities granted the gate passes; the fake-sandbox override
    // then stops the action at the sandbox boundary instead.
    previous: sys.get("JETPACK_FAKE_SANDBOX")
    sys.set("JETPACK_FAKE_SANDBOX", "1")
    if build_execute_build_plan(plan, root, store, [BuildEffect]{BuildEffect.Exec, BuildEffect.Net}) == {
        .Err(error) -> {
            build_test_restore_env("JETPACK_FAKE_SANDBOX", previous)
            assert(error == BuildExecutionError.SandboxUnavailable{reason: "test sandbox override prevents child execution"})
        }
        .Ok(_) -> {
            build_test_restore_env("JETPACK_FAKE_SANDBOX", previous)
            panic("the fake sandbox must stop the action")
        }
    }
    assert(!files.exists(marker))
    files.remove_all(root).drop("test cleanup")
}

#Test("probe grants: probes run only with the Exec grant") {
    root: build_test_root("probe-grant")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    build := HermeticBuildContext.new()
    probe: build.find_program("has-sh", "sh") ?? panic("probe")
    target: build.add_executable("probed", TargetSpec.new().with_probe(probe)) ?? panic("target")
    plan: build.plan_with_default(target) ?? panic("plan")
    if build_execute_build_plan(plan, root, store, [BuildEffect]{}) == {
        .Err(error) -> assert(error == BuildExecutionError.MissingGrant{action: "probe has-sh", capability: BuildEffect.Exec})
        .Ok(_) -> panic("a probe without the Exec grant must be refused")
    }
    result: build_execute_build_plan(plan, root, store, [BuildEffect]{BuildEffect.Exec}) ?? panic("an Exec-granted find_program probe needs no child")
    assert_eq(result.probes.len(), 1)
    assert(result.probes[0].success)
    files.remove_all(root).drop("test cleanup")
}

#Test("network sharing: shared only when the root grants Net and the action declares it") {
    with_net: ActionSpec.new([String]{"cc"}).with_outputs([String]{"a.o"}).with_cap(BuildEffect.Net)
    without_net: ActionSpec.new([String]{"cc"}).with_outputs([String]{"a.o"}).with_cap(BuildEffect.Exec)
    assert(build_action_shares_network([BuildEffect]{BuildEffect.Net}, with_net.caps))
    assert(!build_action_shares_network([BuildEffect]{BuildEffect.Exec}, with_net.caps))
    assert(!build_action_shares_network([BuildEffect]{BuildEffect.Net}, without_net.caps))
}

#Test("no unsandboxed fallback: an unavailable backend refuses the action and nothing is published") {
    root: build_test_root("unavailable")
    files.write(files.join(root, "input.txt"), "input") ?? panic("input")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    plan: build_test_plan([BuildEffect]{BuildEffect.Exec}, BUILD_TEST_COPY_SCRIPT)
    previous: sys.get("JETPACK_FAKE_SANDBOX")
    sys.set("JETPACK_FAKE_SANDBOX", "1")
    if build_execute_build_plan(plan, root, store, [BuildEffect]{BuildEffect.Exec}) == {
        .Err(error) -> {
            build_test_restore_env("JETPACK_FAKE_SANDBOX", previous)
            assert(error == BuildExecutionError.SandboxUnavailable{reason: "test sandbox override prevents child execution"})
        }
        .Ok(_) -> {
            build_test_restore_env("JETPACK_FAKE_SANDBOX", previous)
            panic("an unavailable sandbox must refuse")
        }
    }
    assert(!files.exists(files.join(root, "out.txt")))
    assert(build_native_sandbox_error(plan.actions[0], NativeSandboxError.Unsupported("x")) == BuildExecutionError.SandboxUnavailable{reason: "x"})
    assert(build_native_sandbox_error(plan.actions[0], NativeSandboxError.IO("disk")) == BuildExecutionError.IO{action: "write", detail: "disk"})
    files.remove_all(root).drop("test cleanup")
}

// The allowed neighbour of the refusal above, which needs the native backend.
#Test("no unsandboxed fallback: with the backend available the same action runs and publishes only its declared output") {
    if !build_test_require_sandbox() -> return
    root: build_test_root("available")
    files.write(files.join(root, "input.txt"), "input") ?? panic("input")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    plan: build_test_plan([BuildEffect]{BuildEffect.Exec}, BUILD_TEST_COPY_SCRIPT)
    result: build_execute_build_plan(plan, root, store, [BuildEffect]{BuildEffect.Exec}) ?? panic("sandboxed action should run")
    assert_eq(result.report.metrics.actions_total, 1)
    assert_eq(files.read(files.join(root, "out.txt")) ?? panic("declared output"), "input")
    files.remove_all(root).drop("test cleanup")
}

#Test("action reuse: an action with no ambient effect is restored until an input changes, one with an ambient effect always runs") {
    if !build_test_require_sandbox() -> return
    root: build_test_root("reuse")
    files.write(files.join(root, "input.txt"), "one") ?? panic("input")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    grants: [BuildEffect]{BuildEffect.Exec, BuildEffect.Time}
    pure: build_test_plan([BuildEffect]{BuildEffect.Exec}, BUILD_TEST_COPY_SCRIPT)
    assert(pure.actions[0].reusable())
    first: build_execute_build_plan(pure, root, store, grants) ?? panic("first run")
    assert_eq(first.report.metrics.reusable_actions, 1)
    assert_eq(first.report.metrics.cache_restored_actions, 0)
    again: build_execute_build_plan(pure, root, store, grants) ?? panic("unchanged run")
    assert_eq(again.report.metrics.cache_restored_actions, 1)
    assert_eq(files.read(files.join(root, "out.txt")) ?? panic("restored output"), "one")
    files.write(files.join(root, "input.txt"), "two") ?? panic("edit input")
    changed: build_execute_build_plan(pure, root, store, grants) ?? panic("changed run")
    assert_eq(changed.report.metrics.cache_restored_actions, 0)
    assert_eq(files.read(files.join(root, "out.txt")) ?? panic("rebuilt output"), "two")
    ambient: build_test_plan([BuildEffect]{BuildEffect.Exec, BuildEffect.Time}, BUILD_TEST_COPY_SCRIPT)
    assert(!ambient.actions[0].reusable())
    build_execute_build_plan(ambient, root, store, grants) ?? panic("ambient run")
    rerun: build_execute_build_plan(ambient, root, store, grants) ?? panic("ambient rerun")
    assert_eq(rerun.report.metrics.ambient_actions, 1)
    assert_eq(rerun.report.metrics.cache_restored_actions, 0)
    files.remove_all(root).drop("test cleanup")
}

#Test("action work tree: a real sandbox root is used, a symlinked sandbox root is refused") {
    root: build_test_root("sandbox-root")
    outside: build_test_root("sandbox-root-outside")
    files.write(files.join(root, "input.txt"), "input") ?? panic("input")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    files.create_dir_all(files.join(root, ".jet")) ?? panic("state dir")
    files.symlink(outside, files.join(root, ".jet/build-sandbox")) ?? panic("link sandbox root")
    plan: build_test_plan([BuildEffect]{BuildEffect.Exec}, BUILD_TEST_COPY_SCRIPT)
    if build_execute_build_plan(plan, root, store, [BuildEffect]{BuildEffect.Exec}) == {
        .Err(error) -> if error == {
            .IO(action, detail) -> {
                assert_eq(action, "write")
                assert(detail.contains("is a symlink"))
            }
            else -> panic("a symlinked sandbox root must be an I/O refusal")
        }
        .Ok(_) -> panic("a symlinked sandbox root must be refused")
    }
    assert_eq((files.list_dir(outside) ?? panic("list outside")).len(), 0)
    files.remove(files.join(root, ".jet/build-sandbox")) ?? panic("unlink")
    build_ensure_real_directory(files.join(root, ".jet/build-sandbox")) ?? panic("a real sandbox root is created")
    assert(files.is_dir(files.join(root, ".jet/build-sandbox")))
    files.remove_all(root).drop("test cleanup")
    files.remove_all(outside).drop("test cleanup")
}

#Test("secure read: a regular file is read, a final link, a linked parent and a directory are refused") {
    root: build_test_root("secure-read")
    outside: build_test_root("secure-read-outside")
    files.create_dir_all(files.join(root, "dir")) ?? panic("dir")
    files.write(files.join(root, "dir/file.txt"), "inside") ?? panic("file")
    files.write(files.join(outside, "secret.txt"), "secret") ?? panic("secret")
    assert_eq(build_secure_read_file(root, files.join(root, "dir/file.txt"), BUILD_MAX_ACTION_FILE_BYTES) ?? panic("regular file"), "inside".bytes())
    assert_eq(build_secure_read_file(root, files.join(root, "dir/file.txt"), 6) ?? panic("a file at its exact limit"), "inside".bytes())
    if build_secure_read_file(root, files.join(root, "dir/file.txt"), 5) == {
        .Err(error) -> assert(error == BuildIOError.new(.InvalidData, "cache entry exceeds its byte limit"))
        .Ok(_) -> panic("a file over its limit must be refused")
    }
    files.symlink(files.join(outside, "secret.txt"), files.join(root, "dir/link.txt")) ?? panic("final link")
    assert(build_secure_read_file(root, files.join(root, "dir/link.txt"), BUILD_MAX_ACTION_FILE_BYTES) == .Err(_))
    files.symlink(outside, files.join(root, "linked")) ?? panic("parent link")
    assert(build_secure_read_file(root, files.join(root, "linked/secret.txt"), BUILD_MAX_ACTION_FILE_BYTES) == .Err(_))
    if build_secure_read_file(root, files.join(root, "dir"), BUILD_MAX_ACTION_FILE_BYTES) == {
        .Err(_) -> {}
        .Ok(_) -> panic("a directory is not a regular file")
    }
    if build_secure_read_file(root, "/etc/hostname", BUILD_MAX_ACTION_FILE_BYTES) == {
        .Err(error) -> assert(error == BuildIOError.new(.InvalidInput, "cache path escapes root"))
        .Ok(_) -> panic("a path outside the base must be refused")
    }
    files.remove_all(root).drop("test cleanup")
    files.remove_all(outside).drop("test cleanup")
}

// One cached action `cc` declaring `outputs`, for the work-tree publication
// fixtures.
build_test_output_action: fn(outputs: [String]) -[Rand]> HermeticBuildAction Never! {
    build := HermeticBuildContext.new()
    handle: build.action("cc", ActionSpec.new([String]{"cc"}).with_outputs(outputs)) ?? panic("declare action")
    plan: build.plan() ?? panic("plan")
    plan.actions[handle.id]
}

#Test("sandbox outputs: regular outputs publish, a FIFO output is refused at once and nothing is published") {
    root: build_test_root("fifo-output")
    sandbox: build_test_root("fifo-output-sandbox")
    action: build_test_output_action([String]{"a.o", "b.o"})
    files.write(files.join(sandbox, "a.o"), "object") ?? panic("first output")
    files.write(files.join(sandbox, "b.o"), "second") ?? panic("second output")
    published: build_publish_sandbox_outputs(sandbox, root, action) ? edited -> edited ! error -> panic("regular outputs publish: {error.message}")
    assert_eq(published, String?{None})
    assert_eq(files.read(files.join(root, "b.o")) ?? panic("published output"), "second")
    files.remove(files.join(root, "a.o")) ?? panic("reset first output")
    files.remove(files.join(root, "b.o")) ?? panic("reset second output")
    // A FIFO with no writer would block a plain open forever.
    files.remove(files.join(sandbox, "b.o")) ?? panic("drop second output")
    made: process.cmd([String]{"mkfifo", files.join(sandbox, "b.o")}).run() ?? panic("run host mkfifo")
    assert(made.success)
    started: time.instant()
    if build_publish_sandbox_outputs(sandbox, root, action) == {
        .Err(error) -> assert(error == BuildIOError.new(.PermissionDenied, "cache entry is not a regular file"))
        .Ok(_) -> panic("a FIFO output must be refused")
    }
    assert(started.elapsed_millis() < 3000)
    assert(!files.exists(files.join(root, "a.o")))
    assert(!files.exists(files.join(root, "b.o")))
    files.remove_all(root).drop("test cleanup")
    files.remove_all(sandbox).drop("test cleanup")
}

#Test("sandbox outputs: an output at its limit is read, an oversized sparse output is refused without being read") {
    root: build_test_root("sparse-output")
    sandbox: build_test_root("sparse-output-sandbox")
    action: build_test_output_action([String]{"a.o", "big.o"})
    files.write(files.join(sandbox, "a.o"), "object") ?? panic("first output")
    // One byte past the per-file limit after a hole: no disk is used, and a
    // reader that read it would allocate the whole limit.
    big: files.join(sandbox, "big.o")
    files.write(big, "") ?? panic("sparse output")
    files.write_at(big, BUILD_MAX_ACTION_FILE_BYTES, "x".bytes()) ?? panic("extend sparse output")
    assert_eq((files.stat(big) ?? panic("sparse size")).size, BUILD_MAX_ACTION_FILE_BYTES + 1)
    started: time.instant()
    if build_publish_sandbox_outputs(sandbox, root, action) == {
        .Err(error) -> assert(error == BuildIOError.new(.InvalidData, "cache entry exceeds its byte limit"))
        .Ok(_) -> panic("an oversized output must be refused")
    }
    assert(started.elapsed_millis() < 3000)
    assert(!files.exists(files.join(root, "a.o")))
    // The per-action limit lowers the next file's limit.
    assert_eq(build_read_budget(0), BUILD_MAX_ACTION_FILE_BYTES)
    assert_eq(build_read_budget(BUILD_MAX_ACTION_TOTAL_BYTES - 5), 5)
    files.remove_all(root).drop("test cleanup")
    files.remove_all(sandbox).drop("test cleanup")
}

#Test("kept outputs: a missing one is written, one holding the made bytes is left alone, a hand edit publishes nothing") {
    root: build_test_root("kept-output")
    sandbox: build_test_root("kept-output-sandbox")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    build := HermeticBuildContext.new()
    // The last build wrote "old" to `table.txt`.
    spec: ActionSpec.new([String]{"gen"}).with_outputs([String]{"a.o", "table.txt"}).with_kept("table.txt", Val(ContentDigest.from_bytes("old".bytes()).as_str()))
    handle: build.action("gen", spec) ?? panic("declare action")
    action: (build.plan() ?? panic("plan")).actions[handle.id]
    files.write(files.join(sandbox, "a.o"), "object") ?? panic("first output")
    files.write(files.join(sandbox, "table.txt"), "new") ?? panic("kept output")
    table: files.join(root, "table.txt")
    first: build_publish_sandbox_outputs(sandbox, root, action) ? edited -> edited ! error -> panic("a missing kept output is written: {error.message}")
    assert_eq(first, String?{None})
    assert_eq(files.read(table) ?? panic("written kept output"), "new")
    // Already holding the made bytes: the same file stays.
    before: (files.stat(table) ?? panic("kept stat")).id
    unchanged: build_publish_sandbox_outputs(sandbox, root, action) ? edited -> edited ! error -> panic("an unchanged kept output publishes: {error.message}")
    assert_eq(unchanged, String?{None})
    assert((files.stat(table) ?? panic("kept stat")).id == before)
    // Holding the last build's bytes: rewritten.
    files.write(table, "old") ?? panic("last build's bytes")
    rewritten: build_publish_sandbox_outputs(sandbox, root, action) ? edited -> edited ! error -> panic("the last build's bytes are rewritten: {error.message}")
    assert_eq(rewritten, String?{None})
    assert_eq(files.read(table) ?? panic("rewritten kept output"), "new")
    // Holding bytes no build wrote: nothing is published, from the work
    // tree or from a cache record.
    files.write(table, "edited") ?? panic("hand edit")
    files.remove(files.join(root, "a.o")) ?? panic("reset first output")
    refused: build_publish_sandbox_outputs(sandbox, root, action) ? edited -> edited ! error -> panic("a hand edit is reported: {error.message}")
    assert_eq(refused, String?{Val("table.txt")})
    assert(!files.exists(files.join(root, "a.o")))
    object: store.put_blob("object".bytes()) ?? panic("object blob")
    made: store.put_blob("new".bytes()) ?? panic("kept blob")
    record: ActionResultRecord{key: "act-sha256:k", outcome: ActionOutcome.Succeeded{exit_code: 0}, outputs: [ActionOutputRecord]{{path: "a.o", digest: object, byte_len: 6}, {path: "table.txt", digest: made, byte_len: 3}}, failure_report: None, status: ActionCacheStatus.Miss(.NoLocalActionRecord)}
    unrestored: build_restore_action_outputs(store, root, action, record) ? edited -> edited ! error -> panic("a hand edit is reported: {error.message}")
    assert_eq(unrestored, String?{Val("table.txt")})
    assert(!files.exists(files.join(root, "a.o")))
    assert_eq(files.read(table) ?? panic("hand-edited kept output"), "edited")
    // A kept path must be one of the action's outputs.
    if build.action("stray", ActionSpec.new([String]{"gen"}).with_outputs([String]{"b.o"}).with_kept("c.txt", None)) == {
        .Err(error) -> assert(error == HermeticBuildError.UndeclaredKeptOutput{action: "stray", output: "c.txt"})
        .Ok(_) -> panic("a kept path that is not an output must be refused")
    }
    files.remove_all(root).drop("test cleanup")
    files.remove_all(sandbox).drop("test cleanup")
}

#Test("atomic restore: outputs land under real parents, a linked parent is refused without writing outside") {
    root: build_test_root("restore")
    outside: build_test_root("restore-outside")
    build_atomic_restore_file(root, files.join(root, "build/obj/a.o"), "object".bytes()) ?? panic("restore under fresh parents")
    assert_eq(files.read(files.join(root, "build/obj/a.o")) ?? panic("restored"), "object")
    files.symlink(outside, files.join(root, "linked")) ?? panic("parent link")
    assert(build_atomic_restore_file(root, files.join(root, "linked/a.o"), "object".bytes()) == .Err(_))
    assert(!files.exists(files.join(outside, "a.o")))
    names: loop entry in files.list_dir(files.join(root, "build/obj")) ?? panic("list") -> entry.name
    assert_eq(names, [String]{"a.o"})
    files.remove_all(root).drop("test cleanup")
    files.remove_all(outside).drop("test cleanup")
}

#Test("output destination: real parents are prepared, a linked parent is refused and a final link is removed, not followed") {
    root: build_test_root("destination")
    outside: build_test_root("destination-outside")
    build_prepare_output_destination(root, files.join(root, "out/bin/app")) ?? panic("prepare real parents")
    assert(files.is_dir(files.join(root, "out/bin")))
    files.symlink(outside, files.join(root, "linked")) ?? panic("parent link")
    if build_prepare_output_destination(root, files.join(root, "linked/app")) == {
        .Err(error) -> assert(error == BuildIOError.new(.PermissionDenied, "build output parent `{files.join(root, "linked")}` is a symlink"))
        .Ok(_) -> panic("a linked output parent must be refused")
    }
    files.write(files.join(outside, "victim"), "keep") ?? panic("victim")
    files.symlink(files.join(outside, "victim"), files.join(root, "out/bin/app")) ?? panic("final link")
    build_prepare_output_destination(root, files.join(root, "out/bin/app")) ?? panic("final link is removed")
    assert(!files.exists(files.join(root, "out/bin/app")))
    assert_eq(files.read(files.join(outside, "victim")) ?? panic("victim kept"), "keep")
    files.remove_all(root).drop("test cleanup")
    files.remove_all(outside).drop("test cleanup")
}

#Test("tool resolution: declared tools resolve, a declared-only toolchain refuses undeclared tools and a foreign target refuses PATH") {
    sh: build_find_program_path("sh") ?? panic("host sh on PATH")
    build := HermeticBuildContext.new()
    declared: build.toolchain("declared", ToolchainSpec.target("riscv64-unknown-elf", BuildProvenance.user_declared("fixture", None)).with_tool("sh", sh).declared_only()) ?? panic("declared toolchain")
    foreign: build.toolchain("foreign", ToolchainSpec.target("riscv64-unknown-elf", BuildProvenance.user_declared("fixture", None))) ?? panic("foreign toolchain")
    plan: build.plan() ?? panic("plan")
    assert_eq(build_resolve_program_path(plan, declared, "sh") ?? panic("declared tool"), sh)
    assert(build_resolve_program_path(plan, declared, "cat") == None)
    assert(build_resolve_program_path(plan, foreign, "sh") == None)
    assert_eq(build_resolve_program_path(plan, ToolchainHandle{id: 0, context: plan.context}, "sh") ?? panic("host PATH tool"), sh)
}

#Test("PATH resolution: an absolute PATH entry resolves, empty and relative entries never resolve to the working directory") {
    root: build_test_root("path-cwd")
    tool: "jet-build-cwd-tool-{sys.pid()}"
    files.write(files.join(root, tool), "#!/bin/sh\n") ?? panic("tool in the working directory")
    previous_path: sys.get("PATH")
    previous_cwd: sys.current_dir() ?? panic("working directory")
    sys.set_current_dir(root) ?? panic("enter the fixture root")
    sys.set("PATH", ":.:relative/bin:")
    from_cwd: build_find_program_path(tool)
    sys.set("PATH", "/nonexistent-jet-path:{root}")
    from_absolute: build_find_program_path(tool)
    sys.set_current_dir(previous_cwd) ?? panic("restore the working directory")
    build_test_restore_env("PATH", previous_path)
    assert(from_cwd == None)
    assert_eq(from_absolute ?? panic("absolute PATH entry"), files.join(root, tool))
    files.remove_all(root).drop("test cleanup")
}

#Test("mounted tools: a tool under a mount maps to its source by path components; `..`, `//` escapes and partial components are refused") {
    root: build_test_root("mounted-tool")
    files.create_dir_all(files.join(root, "bin")) ?? panic("bin")
    files.write(files.join(root, "bin/cc"), "#!/bin/sh\n") ?? panic("tool")
    toolchain: HermeticBuildToolchain{
        id: 1, name: "cc", role: ToolchainRole.Target, host_triple: "host", target_triple: "x", sdk: None, linker: None, sysroot: None,
        tools: [String: String]{}, resolution: ToolchainResolution.DeclaredOnly,
        mounts: [BuildMount]{BuildMount{source: root, destination: "/toolchain", identity: ""}}, provenance: BuildProvenance.inferred_host(),
    }
    assert_eq(build_canonical_tool_path(toolchain, "/toolchain/bin/cc") ?? panic("mounted tool"), files.join(root, "bin/cc"))
    assert(build_canonical_tool_path(toolchain, "/toolchain/../etc/passwd") == None)
    // `//` and `.` after the destination stay under the mount source; a
    // string join would have made `/toolchain//etc/passwd` the host file.
    assert_eq(build_canonical_tool_path(toolchain, "/toolchain//bin/cc") ?? panic("`//` mounted tool"), files.join(root, "bin/cc"))
    assert_eq(build_canonical_tool_path(toolchain, "/toolchain/./bin//cc") ?? panic("`.` mounted tool"), files.join(root, "bin/cc"))
    assert(build_canonical_tool_path(toolchain, "/toolchain//etc/passwd") == None)
    // A destination is matched by whole components, never by string prefix.
    assert(build_canonical_tool_path(toolchain, "/toolchainx/bin/cc") == None)
    // A non-normalized destination still matches its normalized tool paths.
    nested: HermeticBuildToolchain{
        id: 2, name: "nested", role: ToolchainRole.Target, host_triple: "host", target_triple: "x", sdk: None, linker: None, sysroot: None,
        tools: [String: String]{}, resolution: ToolchainResolution.DeclaredOnly,
        mounts: [BuildMount]{BuildMount{source: root, destination: "/tc//nested/", identity: ""}}, provenance: BuildProvenance.inferred_host(),
    }
    assert_eq(build_canonical_tool_path(nested, "/tc/nested/bin/cc") ?? panic("non-normalized destination"), files.join(root, "bin/cc"))
    assert(build_canonical_tool_path(nested, "/tc/nested//etc/passwd") == None)
    files.remove_all(root).drop("test cleanup")
}

#Test("context handles: same-context handles are accepted, another context's handles are refused") {
    build := HermeticBuildContext.new()
    other := HermeticBuildContext.new()
    own: build.toolchain("own", ToolchainSpec.host("x86_64-linux", BuildProvenance.inferred_host())) ?? panic("own toolchain")
    foreign: other.toolchain("foreign", ToolchainSpec.host("x86_64-linux", BuildProvenance.inferred_host())) ?? panic("foreign toolchain")
    _: build.action("own", ActionSpec.new([String]{"cc"}).with_outputs([String]{"a.o"}).with_toolchain(own)) ?? panic("a same-context toolchain must be accepted")
    if build.action("foreign", ActionSpec.new([String]{"cc"}).with_outputs([String]{"b.o"}).with_toolchain(foreign)) == {
        .Err(error) -> assert(error == HermeticBuildError.UnknownToolchain(foreign.id))
        .Ok(_) -> panic("another context's toolchain must be refused")
    }
    foreign_action: other.action("x", ActionSpec.new([String]{"cc"}).with_outputs([String]{"c.o"})) ?? panic("foreign action")
    if build.add_executable("bad", TargetSpec.new().with_action(foreign_action)) == {
        .Err(error) -> assert(error == HermeticBuildError.UnknownAction(foreign_action.id))
        .Ok(_) -> panic("another context's action must be refused")
    }
    foreign_target: other.add_executable("t", TargetSpec.new()) ?? panic("foreign target")
    if build.plan_with_default(foreign_target) == {
        .Err(error) -> assert(error == HermeticBuildError.UnknownTarget(foreign_target.id))
        .Ok(_) -> panic("another context's target must be refused")
    }
}

#Test("action environment: allowlisted variables reach the action, others and undeclared allowlist names are refused") {
    spec: ActionSpec.new([String]{"cc"}).with_outputs([String]{"a.o"}).with_env("PATH", "/toolchain/bin").with_env("SECRET", "x").with_env_allowlist([String]{"PATH"})
    build := HermeticBuildContext.new()
    handle: build.action("env", spec) ?? panic("action")
    plan: build.plan() ?? panic("plan")
    env: build_action_environment(plan.actions[handle.id])
    assert_eq(env.keys().to_list(), [String]{"PATH"})
    if build.action("undeclared", ActionSpec.new([String]{"cc"}).with_outputs([String]{"b.o"}).with_env_allowlist([String]{"HOME"})) == {
        .Err(error) -> assert(error == HermeticBuildError.UndeclaredEnvName{action: "undeclared", key: "HOME"})
        .Ok(_) -> panic("an allowlist name without a declared value must be refused")
    }
}

#Test("output ownership: distinct outputs plan, a second owner of one output is refused") {
    build := HermeticBuildContext.new()
    build.action("first", ActionSpec.new([String]{"cc"}).with_outputs([String]{"a.o"})) ?? panic("first")
    build.action("second", ActionSpec.new([String]{"cc"}).with_outputs([String]{"b.o"})) ?? panic("second")
    assert(build.plan() == .Ok(_))
    build.action("third", ActionSpec.new([String]{"cc"}).with_outputs([String]{"a.o"})) ?? panic("third")
    if build.plan() == {
        .Err(error) -> assert(error == HermeticBuildError.DuplicateBuildOutput{output: "a.o", first_action: "first", second_action: "third"})
        .Ok(_) -> panic("a second owner of one output must be refused")
    }
}

#Test("folder inputs: an output outside every read folder plans, one inside a read folder and a folder outside the project are refused") {
    build := HermeticBuildContext.new()
    build.action("read", ActionSpec.new([String]{"sh"}).with_outputs([String]{"out.txt"}).with_folder("data", None)) ?? panic("read")
    build.action("near", ActionSpec.new([String]{"sh"}).with_outputs([String]{"database.txt"})) ?? panic("near")
    assert(build.plan() == .Ok(_))
    if build.action("escape", ActionSpec.new([String]{"sh"}).with_outputs([String]{"e.txt"}).with_folder("../up", None)) == {
        .Err(error) -> assert(error == HermeticBuildError.InvalidPath("../up"))
        .Ok(_) -> panic("a folder outside the project must be refused")
    }
    build.action("inside", ActionSpec.new([String]{"sh"}).with_outputs([String]{"data/gen.txt"})) ?? panic("inside")
    if build.plan() == {
        .Err(error) -> assert(error == HermeticBuildError.OutputInFolder{action: "read", output: "data/gen.txt", folder: "data"})
        .Ok(_) -> panic("an output inside a read folder must be refused")
    }
}

#Test("found folders: an action reads a found folder only through a find_folder probe it uses") {
    build := HermeticBuildContext.new()
    if build.probe("nested", ProbeSpec.find_folder("lib/libc.a")) == {
        .Err(_) -> {}
        .Ok(_) -> panic("a find_folder probe names a file alone")
    }
    musl: build.probe("musl", ProbeSpec.find_folder("libc.a")) ?? panic("musl")
    shell: build.probe("shell", ProbeSpec.find_program("sh")) ?? panic("shell")
    if build.action("unused", ActionSpec.new([String]{"sh"}).with_outputs([String]{"a.txt"}).with_found_folder(".jet/found/musl", musl)) == {
        .Err(error) -> assert(error == HermeticBuildError.UnknownProbe(musl.id))
        .Ok(_) -> panic("the action must use the probe that finds its folder")
    }
    if build.action("program", ActionSpec.new([String]{"sh"}).with_outputs([String]{"b.txt"}).with_found_folder(".jet/found/shell", shell).with_probe(shell)) == {
        .Err(error) -> assert(error == HermeticBuildError.UnknownProbe(shell.id))
        .Ok(_) -> panic("only a find_folder probe finds a folder")
    }
    build.action("link", ActionSpec.new([String]{"sh"}).with_outputs([String]{"c.txt"}).with_found_folder(".jet/found/musl", musl).with_probe(musl)) ?? panic("link")
    assert(build.plan() == .Ok(_))
}

#Test("found programs: an action is passed a found program only through a find_program probe it uses, as one of its arguments") {
    build := HermeticBuildContext.new()
    cc: build.probe("cc", ProbeSpec.find_program("cc")) ?? panic("cc")
    musl: build.probe("musl", ProbeSpec.find_folder("libc.a")) ?? panic("musl")
    if build.action("unused", ActionSpec.new([String]{"sh", "cc"}).with_outputs([String]{"a.txt"}).with_found_program(1, "", cc)) == {
        .Err(error) -> assert(error == HermeticBuildError.UnknownProbe(cc.id))
        .Ok(_) -> panic("the action must use the probe that finds its program")
    }
    if build.action("folder", ActionSpec.new([String]{"sh", "libc.a"}).with_outputs([String]{"b.txt"}).with_found_program(1, "", musl).with_probe(musl)) == {
        .Err(error) -> assert(error == HermeticBuildError.UnknownProbe(musl.id))
        .Ok(_) -> panic("only a find_program probe finds a program")
    }
    if build.action("tool", ActionSpec.new([String]{"cc"}).with_outputs([String]{"c.txt"}).with_found_program(0, "", cc).with_probe(cc)) == {
        .Err(error) -> assert(error == HermeticBuildError.EmptyActionArgv("tool"))
        .Ok(_) -> panic("a found program passed to an action is one of its arguments")
    }
    build.action("compile", ActionSpec.new([String]{"sh", "--cc=cc"}).with_outputs([String]{"d.txt"}).with_found_program(1, "--cc=", cc).with_probe(cc)) ?? panic("compile")
    assert(build.plan() == .Ok(_))
}

#Test("folder snapshots: each file is hashed under the folder path, `.jet` and ignored files are skipped, a link out of the folder is refused") {
    root: build_test_root("folder-snapshot")
    outside: build_test_root("folder-snapshot-outside")
    files.create_dir_all(files.join(root, "data/sub")) ?? panic("data")
    files.create_dir_all(files.join(root, "data/.jet")) ?? panic("data .jet")
    files.write(files.join(root, "data/a.txt"), "a") ?? panic("a")
    files.write(files.join(root, "data/sub/b.txt"), "bb") ?? panic("b")
    files.write(files.join(root, "data/.jet/state"), "x") ?? panic("state")
    files.write(files.join(root, "data/.gitignore"), "skip.txt\n") ?? panic("ignore")
    files.write(files.join(root, "data/skip.txt"), "skip") ?? panic("skip")
    build := HermeticBuildContext.new()
    build.action("read", ActionSpec.new([String]{"sh"}).with_outputs([String]{"out.txt"}).with_folder("data", None)) ?? panic("action")
    plan: build.plan() ?? panic("plan")
    stamps := StampTable.load(root)
    first: build_snapshot_folders(stamps, root, plan.actions[0]) ?? panic("snapshot")
    paths: loop snapshot in first -> snapshot.path
    assert(paths.contains("data/a.txt"))
    assert(paths.contains("data/sub/b.txt"))
    assert(!paths.contains("data/.jet/state"))
    assert(!paths.contains("data/skip.txt"))
    loop snapshot in first {
        if snapshot.path == "data/a.txt" {
            assert_eq(snapshot.digest, ContentDigest.from_bytes("a".bytes()))
            assert_eq(snapshot.byte_len, 1)
        }
    }
    files.write(files.join(root, "data/a.txt"), "AA") ?? panic("edit a")
    files.write(files.join(root, "data/c.txt"), "c") ?? panic("add c")
    second: build_snapshot_folders(stamps, root, plan.actions[0]) ?? panic("second snapshot")
    assert((loop snapshot in second -> snapshot.path).contains("data/c.txt"))
    loop snapshot in second {
        if snapshot.path == "data/a.txt" -> assert_eq(snapshot.digest, ContentDigest.from_bytes("AA".bytes()))
    }
    files.write(files.join(outside, "secret"), "secret") ?? panic("secret")
    files.symlink(files.join(outside, "secret"), files.join(root, "data/link")) ?? panic("link")
    if build_snapshot_folders(stamps, root, plan.actions[0]) == {
        .Err(error) -> assert(error.kind == BuildIOKind.PermissionDenied)
        .Ok(_) -> panic("a link out of the folder must be refused")
    }
    files.remove_all(root).drop("test cleanup")
    files.remove_all(outside).drop("test cleanup")
}

#Test("folder inputs: the folder is bound read-only at its path, and a changed file in it runs the action again") {
    if !build_test_require_sandbox() -> return
    root: build_test_root("folder-run")
    files.create_dir_all(files.join(root, "data")) ?? panic("data")
    files.write(files.join(root, "data/a.txt"), "one") ?? panic("a")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    build := HermeticBuildContext.new()
    script: "read -r line < data/a.txt; printf %s \"$line\" > out.txt; if (printf x > data/w) 2>/dev/null; then printf ' writable' >> out.txt; fi"
    spec: ActionSpec.new([String]{"sh", "-c", script}).with_outputs([String]{"out.txt"}).with_folder("data", None).with_cap(BuildEffect.Exec)
    action: build.action("read", spec) ?? panic("action")
    target: build.add_executable("out", TargetSpec.new().with_action(action)) ?? panic("target")
    plan: build.plan_with_default(target) ?? panic("plan")
    build_execute_build_plan(plan, root, store, [BuildEffect]{BuildEffect.Exec}) ?? panic("first run")
    assert_eq(files.read(files.join(root, "out.txt")) ?? panic("out"), "one")
    assert(!files.exists(files.join(root, "data/w")))
    files.write(files.join(root, "data/a.txt"), "three") ?? panic("edit a")
    build_execute_build_plan(plan, root, store, [BuildEffect]{BuildEffect.Exec}) ?? panic("second run")
    assert_eq(files.read(files.join(root, "out.txt")) ?? panic("out again"), "three")
    files.remove_all(root).drop("test cleanup")
}

#Test("found folders: the folder a find_folder probe chose is bound at its path, and a probe that finds none fails naming each folder") {
    if !build_test_require_sandbox() -> return
    root: build_test_root("found-folder")
    lib: build_test_root("found-folder-lib")
    files.write(files.join(lib, "marker.txt"), "found") ?? panic("marker")
    previous: sys.get("LIBRARY_PATH")
    sys.set("LIBRARY_PATH", "{files.join(root, "none")}:{lib}")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    build := HermeticBuildContext.new()
    probe: build.probe("marks", ProbeSpec.find_folder("marker.txt")) ?? panic("probe")
    script: "read -r line < .jet/found/marks/marker.txt; printf %s \"$line\" > out.txt"
    spec: ActionSpec.new([String]{"sh", "-c", script}).with_outputs([String]{"out.txt"}).with_found_folder(".jet/found/marks", probe).with_probe(probe).with_cap(BuildEffect.Exec)
    action: build.action("read", spec) ?? panic("action")
    target: build.add_executable("out", TargetSpec.new().with_action(action)) ?? panic("target")
    plan: build.plan_with_default(target) ?? panic("plan")
    build_execute_build_plan(plan, root, store, [BuildEffect]{BuildEffect.Exec}) ?? panic("run")
    assert_eq(files.read(files.join(root, "out.txt")) ?? panic("out"), "found")
    missing := HermeticBuildContext.new()
    absent: missing.probe("absent", ProbeSpec.find_folder("jet-test-no-such-file.a")) ?? panic("absent probe")
    needs: missing.action("needs", ActionSpec.new([String]{"sh"}).with_outputs([String]{"o.txt"}).with_found_folder(".jet/found/absent", absent).with_probe(absent).with_cap(BuildEffect.Exec)) ?? panic("needs")
    missing_target: missing.add_executable("o", TargetSpec.new().with_action(needs)) ?? panic("missing target")
    missing_plan: missing.plan_with_default(missing_target) ?? panic("missing plan")
    if build_execute_build_plan(missing_plan, root, store, [BuildEffect]{BuildEffect.Exec}) == {
        .Err(error) -> if error == {
            .FolderNotFound(name, file, searched) -> {
                assert_eq(name, "absent")
                assert_eq(file, "jet-test-no-such-file.a")
                assert_eq(searched[0], "{files.join(root, "none")}: no `jet-test-no-such-file.a`")
                assert_eq(searched[1], "{lib}: no `jet-test-no-such-file.a`")
                assert_eq(searched[searched.len() - 1], "/usr/local/musl/lib: no `jet-test-no-such-file.a`")
            }
            else -> panic("a probe that finds no folder fails as FolderNotFound")
        }
        .Ok(_) -> panic("a probe that finds no folder must fail the build")
    }
    build_test_restore_env("LIBRARY_PATH", previous)
    files.remove_all(root).drop("test cleanup")
    files.remove_all(lib).drop("test cleanup")
}

#Test("cache records: a matching record restores, a record for another key or with mismatched outputs is refused") {
    root: build_test_root("records")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    build := HermeticBuildContext.new()
    handle: build.action("cc", ActionSpec.new([String]{"cc"}).with_outputs([String]{"a.o"})) ?? panic("action")
    plan: build.plan() ?? panic("plan")
    action: plan.actions[handle.id]
    digest: store.put_blob("object".bytes()) ?? panic("blob")
    record: ActionResultRecord{key: "act-sha256:k", outcome: ActionOutcome.Succeeded{exit_code: 0}, outputs: [ActionOutputRecord]{ActionOutputRecord{path: "a.o", digest, byte_len: 6}}, failure_report: None, status: ActionCacheStatus.Miss(.NoLocalActionRecord)}
    build_write_action_record(store, "act-sha256:k", record) ?? panic("write record")
    read: build_read_action_record(store, "act-sha256:k") ? found -> found ! error -> panic("read record")
    found: read ?? panic("record present")
    restored: build_restore_action_outputs(store, root, action, found) ? edited -> edited ! error -> panic("restore matching record: {error.message}")
    assert_eq(restored, String?{None})
    assert_eq(files.read(files.join(root, "a.o")) ?? panic("restored output"), "object")
    store.put_record("act-sha256:other", "act-sha256:k\noutcome=succeeded:0\n".bytes()) ?? panic("forged record")
    if build_read_action_record(store, "act-sha256:other") == {
        .Err(error) -> assert(error == BuildIOError.new(.InvalidData, "action record key does not match its cache path"))
        .Ok(_) -> panic("a record naming another key must be refused")
    }
    mismatched := found
    mismatched.outputs = [ActionOutputRecord]{ActionOutputRecord{path: "b.o", digest, byte_len: 6}}
    if build_restore_action_outputs(store, root, action, mismatched) == {
        .Err(error) -> assert(error == BuildIOError.new(.InvalidData, "cached output record does not exactly match action declarations"))
        .Ok(_) -> panic("a record with other outputs must be refused")
    }
    store.put_record("act-sha256:failed", "act-sha256:failed\noutcome=failed:1\n".bytes()) ?? panic("failed record")
    if build_read_action_record(store, "act-sha256:failed") == {
        .Err(error) -> assert(error == BuildIOError.new(.InvalidData, "failed action record and failure report disagree"))
        .Ok(_) -> panic("a failed record without its report must be refused")
    }
    files.remove_all(root).drop("test cleanup")
}

#Test("failure reports: the canonical wire round-trips, a non-canonical spelling is refused") {
    report: build_action_failure_report("cc", 1, "error: \"x\"")
    wire: build_report_to_json(report) ?? panic("report wire")
    assert_eq(wire, "{{\"schema\":\"jet.err/v1\",\"message\":\"build action `cc` exited with status 1\",\"code\":\"E3505\",\"cause\":null,\"typed_identity\":\"BuildAction::Failed\",\"details\":{{\"variant\":\"BuildActionFailure\",\"fields\":{{\"action\":\"cc\",\"exit_code\":1,\"stderr\":\"error: \\\"x\\\"\"}},\"source_span\":null}}}}")
    decoded: build_report_from_json(wire) ?? panic("canonical report")
    assert_eq(build_report_to_json(decoded) ?? panic("decoded report wire"), wire)
    if build_report_from_json(wire.replace(",\"cause\":null", ", \"cause\":null")) == {
        .Err(error) -> assert_eq(error.message, "error report is not canonical")
        .Ok(_) -> panic("a non-canonical report must be refused")
    }
    rendered: build_report_render(report)
    assert(rendered.starts_with("Error [E3015]: Entry returned an unhandled error: build action `cc` exited with status 1\n"))
    assert(rendered.contains("error code: E3505\ntype: BuildAction::Failed\n  variant: BuildActionFailure\n  action: \"cc\"\n"))
    assert(rendered.ends_with("More: jet-lang.dev/e/E3015\n"))
}

#Test("cached failures: a recorded failed action replays its report without running again") {
    root: build_test_root("failure-replay")
    files.write(files.join(root, "input.txt"), "input") ?? panic("input")
    store: BuildArtifactStoreHandle.at(files.join(root, ".jet-store")) ?? panic("store")
    plan: build_test_plan([BuildEffect]{BuildEffect.Exec}, "exit 3")
    action: plan.actions[0]
    inputs: build_snapshot_declared_inputs(store, root, action) ?? panic("snapshot")
    // The captured bytes are the hashed bytes the work tree receives.
    assert_eq(inputs.len(), 1)
    assert_eq(inputs[0].bytes, "input".bytes())
    assert(inputs[0].snapshot.digest == ContentDigest.from_bytes("input".bytes()))
    snapshots: loop input in inputs -> input.snapshot
    executable: build_resolve_program_path(plan, action.toolchain, "sh") ?? panic("sh")
    key: build_canonical_effective_action_key(plan, action, snapshots, [BuildEffect]{BuildEffect.Exec}, ContentDigest.from_bytes(files.read_bytes(executable) ?? panic("sh bytes")), [ContentDigest]{}, [BuildProbeFact]{})
    report: build_action_failure_report("write", 3, "")
    build_write_action_record(store, key, ActionResultRecord{key, outcome: ActionOutcome.Failed{exit_code: 3}, outputs: [ActionOutputRecord]{}, failure_report: Val(report), status: ActionCacheStatus.Miss(.NoLocalActionRecord)}) ?? panic("record")
    previous: sys.get("JETPACK_FAKE_SANDBOX")
    sys.set("JETPACK_FAKE_SANDBOX", "1")
    if build_execute_build_plan(plan, root, store, [BuildEffect]{BuildEffect.Exec}) == {
        .Err(error) -> {
            build_test_restore_env("JETPACK_FAKE_SANDBOX", previous)
            assert(error == BuildExecutionError.Reported{report})
        }
        .Ok(_) -> {
            build_test_restore_env("JETPACK_FAKE_SANDBOX", previous)
            panic("a recorded failure must replay")
        }
    }
    files.remove_all(root).drop("test cleanup")
}

#Test("action timeout: a child inside its budget completes, one past it is killed, and a pipe-holding descendant is reaped on both paths") {
    if !build_test_require_sandbox() -> return
    root: build_test_root("timeout")
    bash: build_find_program_path("bash") ?? panic("bash is required for the sandbox descendant fixtures")
    exit_started: time.instant()
    quick: foundation_run_native_sandboxed_with_timeout_and_mounts(bash, [String]{"-c", build_test_delayed_descendant("exit-marker", "exit 0")}, root, None, [String: String]{}, false, [NativeSandboxMount]{}, Val(time.duration_ms(5000))) ?? panic("quick child")
    assert(quick.receipt.success)
    assert(exit_started.elapsed_millis() < 3000)
    build_test_assert_descendant_reaped(files.join(root, "exit-marker"))
    timeout_started: time.instant()
    if foundation_run_native_sandboxed_with_timeout_and_mounts(bash, [String]{"-c", build_test_delayed_descendant("timeout-marker", "while :; do :; done")}, root, None, [String: String]{}, false, [NativeSandboxMount]{}, Val(time.duration_ms(500))) == {
        .Err(error) -> assert(error == NativeSandboxError.TimedOut{limit_ms: 500})
        .Ok(_) -> panic("a child past its budget must be killed")
    }
    assert(timeout_started.elapsed_millis() < 3000)
    build_test_assert_descendant_reaped(files.join(root, "timeout-marker"))
    files.remove_all(root).drop("test cleanup")
}

#Test("probe budget: a probe inside its budget completes, one past it is killed and fails") {
    if !build_test_require_sandbox() -> return
    bash: build_find_program_path("bash") ?? panic("bash is required for the sandbox probe fixture")
    quick: build_run_probe_sandboxed(bash, [String]{"-c", "exit 0"}, None, time.duration_ms(5000)) ?? panic("quick probe")
    assert(quick.success)
    started: time.instant()
    if build_run_probe_sandboxed(bash, [String]{"-c", "while :; do :; done"}, None, time.duration_ms(500)) == {
        .Err(error) -> assert(error == BuildExecutionError.IO{action: "build probe sandbox", detail: "sandbox process timed out after 500ms"})
        .Ok(_) -> panic("a probe past its budget must be killed")
    }
    assert(started.elapsed_millis() < 3000)
}

#Test("cache observation: an event path inside $HOME/.cache is appended, a `..` path is refused") {
    home: sys.get("HOME") ?? panic("build executor fixtures require HOME")
    // The event path must lie inside $HOME/.cache, so this fixture lives there,
    // spelled under $HOME as the prefix check sees it.
    spelled: files.join(files.join(home, ".cache"), "jet-build-executor-observe-{sys.pid()}")
    files.remove_all(spelled).drop("a stale build executor fixture may be absent")
    files.create_dir_all(spelled) ?? panic("create fixture root")
    root: files.canonicalize(spelled) ?? panic("canonical fixture root")
    name: "JET_COMPTIME_CACHE_OBSERVATION_PATH"
    previous: sys.get(name)
    sys.set(name, "{spelled}/sub/../escaped.jsonl")
    build_record_cache_event("cc", "act-sha256:k", ActionCacheStatus.Miss(.NoLocalActionRecord), "lookup", None)
    sys.set(name, "{spelled}/events.jsonl")
    build_record_cache_event("cc", "act-sha256:k", ActionCacheStatus.Miss(.NoLocalActionRecord), "lookup", None)
    build_test_restore_env(name, previous)
    assert(!files.exists(files.join(root, "escaped.jsonl")))
    assert(!files.exists(files.join(root, "sub")))
    assert((files.read(files.join(root, "events.jsonl")) ?? panic("appended event")).contains("\"schema\":\"jet.comptime-cache-event.v1\""))
    files.remove_all(root).drop("test cleanup")
}

#Test("action keys: identical declarations share a key, a changed grant, input digest, input mode or found program splits it") {
    plan: build_test_plan([BuildEffect]{BuildEffect.Exec}, "true")
    action: plan.actions[0]
    input: ActionInputSnapshot{path: "input.txt", digest: ContentDigest.from_bytes("a".bytes()), byte_len: 1}
    changed: ActionInputSnapshot{path: "input.txt", digest: ContentDigest.from_bytes("b".bytes()), byte_len: 1}
    runnable: ActionInputSnapshot{path: "input.txt", digest: ContentDigest.from_bytes("a".bytes()), byte_len: 1, executable: true}
    tool: ContentDigest.from_bytes("sh".bytes())
    programs: [ContentDigest]{ContentDigest.from_bytes("cc".bytes())}
    base: build_canonical_effective_action_key(plan, action, [ActionInputSnapshot]{input}, [BuildEffect]{BuildEffect.Exec}, tool, programs, [BuildProbeFact]{})
    assert(base.starts_with("act-sha256:") && base.len() == 75)
    assert_eq(build_canonical_effective_action_key(plan, action, [ActionInputSnapshot]{input}, [BuildEffect]{BuildEffect.Exec}, tool, programs, [BuildProbeFact]{}), base)
    assert(build_canonical_effective_action_key(plan, action, [ActionInputSnapshot]{input}, [BuildEffect]{BuildEffect.Exec, BuildEffect.Net}, tool, programs, [BuildProbeFact]{}) != base)
    assert(build_canonical_effective_action_key(plan, action, [ActionInputSnapshot]{changed}, [BuildEffect]{BuildEffect.Exec}, tool, programs, [BuildProbeFact]{}) != base)
    assert(build_canonical_effective_action_key(plan, action, [ActionInputSnapshot]{runnable}, [BuildEffect]{BuildEffect.Exec}, tool, programs, [BuildProbeFact]{}) != base)
    upgraded: [ContentDigest]{ContentDigest.from_bytes("cc 2".bytes())}
    assert(build_canonical_effective_action_key(plan, action, [ActionInputSnapshot]{input}, [BuildEffect]{BuildEffect.Exec}, tool, upgraded, [BuildProbeFact]{}) != base)
}

#Test("toolchain mounts: an absolute mount is accepted, relative and parent destinations are refused") {
    provenance: BuildProvenance.user_declared("fixture", None)
    build := HermeticBuildContext.new()
    _: build.toolchain("absolute", ToolchainSpec.target("x86_64-linux", provenance).with_read_only_mount_identity("/nix/store", "/toolchain", "sha256:x")) ?? panic("an absolute mount must be accepted")
    destinations: [String]{"toolchain", "/toolchain/../etc"}
    loop destination in destinations {
        if build.toolchain("bad-{destination.len()}", ToolchainSpec.target("x86_64-linux", provenance).with_read_only_mount_identity("/nix/store", destination, "sha256:x")) == {
            .Err(error) -> assert(error == HermeticBuildError.InvalidPath("toolchain `bad-{destination.len()}` has an invalid read-only mount"))
            .Ok(_) -> panic("mount destination `{destination}` must be refused")
        }
    }
}
