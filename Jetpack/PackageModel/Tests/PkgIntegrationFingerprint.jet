// Ported from tests/pkg.rs:2770-2804 over the public lock fingerprint API.
// PENDING-SEAM(package-tests); no fabricated fingerprint oracle.

// Ported from pkg.rs:2770-2775.
#Test("pkg integration fingerprint_is_deterministic") {
    fp1 :: pkg_lock_compute_fingerprint("sha256-aabbcc", [String]{"sha256-ddeeff"}, "")
    fp2 :: pkg_lock_compute_fingerprint("sha256-aabbcc", [String]{"sha256-ddeeff"}, "")
    assert_eq(fp1, fp2)
    assert(fp1.starts_with("sha256-"))
}

// Ported from pkg.rs:2778-2785.
#Test("pkg integration fingerprint_changes_with_deps") {
    fp1 :: pkg_lock_compute_fingerprint("sha256-aabbcc", [String]{}, "")
    fp2 :: pkg_lock_compute_fingerprint("sha256-aabbcc", [String]{"sha256-ddeeff"}, "")
    assert(fp1 != fp2)
}

// Ported from pkg.rs:2791-2804; public capability spelling is verbatim.
#Test("pkg integration fingerprint_changes_with_capability_digest") {
    fp_read :: pkg_lock_compute_fingerprint("sha256-aabbcc", [String]{}, "pkg\nfn scale(v: Vec3)")
    fp_write :: pkg_lock_compute_fingerprint("sha256-aabbcc", [String]{}, "pkg\nfn scale(v: &Vec3)")
    assert(fp_read != fp_write)
    fp_none_a :: pkg_lock_compute_fingerprint("sha256-aabbcc", [String]{"sha256-x"}, "")
    fp_none_b :: pkg_lock_compute_fingerprint("sha256-aabbcc", [String]{"sha256-x"}, "")
    assert_eq(fp_none_a, fp_none_b)
    assert(fp_none_a != fp_read)
}
