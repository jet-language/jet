// Claims ported from crates/jet-pkg-model/src/Overlay.rs #[cfg(test)].

fn pkg_test_overlay_error(src: String) -> OverlayError {
    if pkg_parse_workspace_policy(src) == {
        .Ok(_) -> panic("expected workspace policy to fail closed")
        .Err(error) -> error
    }
}

fn pkg_test_policy(src: String) -> OverlayPolicy {
    pkg_parse_workspace_policy(src) ?? panic("workspace policy should parse")
}

#Test("build deny uses exact balanced policy fields") {
    policy :: pkg_test_policy(`
module workspace {
    policy_note: { deny: #(Exec) }
    policy: { deny: #(Exec, FS) }
}
`)
    assert_eq(policy.build_deny, [String]{"Exec", "FS"})
}

#Test("build grants are subject scoped and quote aware") {
    policy :: pkg_test_policy(`
module workspace {
    policy: {
        grants: { "native:tools": #(Net, Exec), "app": #(FS) },
        deny: #(Time)
    }
}
`)
    assert_eq(policy.build_deny, [String]{"Time"})
    assert_eq(policy.build_grants, [BuildGrant]{
        BuildGrant{subject: "native:tools", effects: [String]{"Net", "Exec"}},
        BuildGrant{subject: "app", effects: [String]{"FS"}}
    })
}

#Test("malformed build grants fail closed") {
    error :: pkg_test_overlay_error(`module workspace { policy: { grants: { "app": [Net] } } }`)
    assert(error.message().contains("policy.grants"))
}

#Test("unsupported workspace policy allow fails closed") {
    sources :: [String]{
        `module workspace { policy: { allow: #(Exec) } }`,
        `module workspace { policy.allow: #(Exec) }`
    }
    loop source in sources {
        if pkg_test_overlay_error(source) == {
            .UnsupportedPolicy(_) -> {}
            else -> panic("expected UnsupportedPolicy")
        }
    }
}

#Test("workspace policy fields fail closed") {
    sources :: [String]{
        `module workspace { policy: { deny: #(Exec), unknown: #(FS) } }`,
        `module workspace { policy.unknown: #(FS) }`,
        `module workspace { policy.allowUnfree: ["a"]
 policy.allowUnfree: ["b"] }`,
        `module workspace { policy: { deny: #(Exec), deny: #(FS) } }`,
        `module workspace { policy: { deny: #(Exec) } policy: { grants: { "app": #(FS) } } }`,
        `module workspace { policy: { grants: { "app": #(FS), "app": #(Net) } } }`
    }
    loop source in sources {
        rejected :: if pkg_parse_workspace_policy(source) == {
            .Ok(_) -> false
            .Err(_) -> true
        }
        assert(rejected, "authority policy metadata must reject {source}")
    }
}

#Test("unknown build effects fail closed") {
    error :: pkg_test_overlay_error(`module workspace { policy: { deny: #(Teleport) } }`)
    assert(error.message().contains("unknown build effect"))
}

#Test("parses workspace overlay policy") {
    policy :: pkg_test_policy(`
module workspace {
    members: ["./packages/app"]
    policy.allowUnfree: ["discord"]
    overlay plasma_beta {
        provider: Provider.nixpkgs(channel: "plasma-beta")
        package("kdePackages.plasma-desktop").patches += [patch("patches/focus.patch")]
        package("kdePackages.plasma-desktop").flags += ["wayland"]
        package("discord").allowUnfree: true
    }
}
`)
    assert_eq(policy.allow_unfree, [String]{"discord"})
    overlay :: policy.overlay("plasma_beta") ?? panic("overlay plasma_beta")
    provider :: overlay.provider ?? panic("provider override")
    assert_eq(provider.provider, "nixpkgs")
    assert_eq(provider.channel, Val("plasma-beta"))
    desktop :: policy.package_override("plasma_beta", "kdePackages.plasma-desktop") ?? panic("plasma-desktop override")
    assert_eq(desktop.patches, [String]{"patches/focus.patch"})
    assert_eq(desktop.flags, [String]{"wayland"})
    assert(policy.allows_unfree("discord"))
}

#Test("patches keep append order and duplicates in identity") {
    policy :: pkg_test_policy(`
module workspace {
    overlay ordered {
        package("app").patches += [patch("b.patch")]
        package("app").patches += [patch("a.patch"), patch("c.patch")]
    }
}
`)
    app :: policy.package_override("ordered", "app") ?? panic("app override")
    assert_eq(app.patches, [String]{"b.patch", "a.patch", "c.patch"})
    reversed := ~app
    reversed.patches = [String]{"c.patch", "a.patch", "b.patch"}
    overlay :: policy.overlay("ordered") ?? panic("overlay ordered")
    assert(app.policy_fingerprint(overlay) != reversed.policy_fingerprint(overlay))
}

#Test("strips overlay policy before workspace eval") {
    stripped :: pkg_strip_overlay_policy(`
module workspace {
    members: ["./packages/app"]
    overlay test {
        package("foo").patches += [patch("patches/foo.patch")]
    }
    policy.allowUnfree: ["foo"]
}
`)
    assert(stripped.contains("members:"))
    assert(!stripped.contains("overlay test"))
    assert(!stripped.contains("policy.allowUnfree"))
}

#Test("keyed overrides merge typed environment by priority") {
    policy :: pkg_test_policy(`
module workspace {
    overlay dev {
        overrides: {
            "app": { version: Priority(10: "2"), env: { CC: "clang", CFLAGS: "-O2" }, flags: { lto: true } }
        }
        package("app").version = "1"
        package("app").env += { CC: "gcc", RUST_LOG: "debug" }
    }
}
`)
    app :: policy.package_override("dev", "app") ?? panic("app override")
    assert_eq(app.version, Val("2"))
    assert_eq(app.env, [OverrideEnv]{
        OverrideEnv{key: "CC", value: "clang"},
        OverrideEnv{key: "CFLAGS", value: "-O2"},
        OverrideEnv{key: "RUST_LOG", value: "debug"}
    })
    assert_eq(app.flags, [String]{"lto"})
    assert_eq(app.priority, 10)
}

#Test("field priority does not bleed between package facts") {
    policy :: pkg_test_policy(`
module workspace {
    overlay dev {
        package("app").version: Force("2")
        package("app").source: "local"
    }
}
`)
    app :: if policy.resolve_package_override_checked("app") == {
        .Ok(found) -> found ?? panic("app has an override")
        .Err(_) -> panic("app resolves")
    }
    assert_eq(app.version, Val("2"))
    assert_eq(app.source, Val("local"))
    assert_eq(app.field_priorities["version"], 100)
    assert_eq(app.field_priorities["source"], 0)
}

#Test("equal priority scalar conflicts keep both overlay origins") {
    message :: pkg_test_overlay_error(`
module workspace {
    overlay base { package("app").version: "1" }
    overlay local { package("app").version: "2" }
}
`).message()
    assert(message.contains("base"))
    assert(message.contains("local"))
    assert(message.contains("version"))
}

#Test("resolves overlays by priority then declaration order with provenance") {
    policy :: pkg_test_policy(`
module workspace {
    overlay base {
        package("app").version: Priority(10: "1")
        package("app").env += { CC: "gcc" }
        package("app").patches += [patch("base.patch")]
    }
    overlay local {
        package("app").version: "2"
        package("app").env += { CC: "clang", RUST_LOG: "debug" }
        package("app").patches += [patch("local.patch")]
    }
}
`)
    app :: policy.resolve_package_override("app") ?? panic("app resolves")
    assert_eq(app.version, Val("1"))
    assert_eq(app.env, [OverrideEnv]{
        OverrideEnv{key: "CC", value: "gcc"},
        OverrideEnv{key: "RUST_LOG", value: "debug"}
    })
    assert_eq(app.patches, [String]{"base.patch", "local.patch"})
    assert_eq(app.provenance.len(), 7)
    base_version := false
    local_cc := false
    loop fact in app.provenance {
        if fact.overlay == "base" && fact.field == "version" -> base_version = true
        if fact.overlay == "local" && fact.field == "env.CC" -> local_cc = true
    }
    assert(base_version)
    assert(local_cc)
}

#Test("malformed or duplicate environment facts fail closed") {
    invalid :: pkg_test_overlay_error(`module workspace { overlay dev { overrides: { app: { env: { 1BAD: "x" } } } } }`)
    assert(invalid.message().contains("variable name"))
    duplicate :: pkg_test_overlay_error(`module workspace { overlay dev { overrides: { app: { version: "1" }, app: { version: "2" } } } }`)
    assert(duplicate.message().contains("declared more than once"))
}
