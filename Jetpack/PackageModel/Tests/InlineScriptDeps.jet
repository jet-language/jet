// Claims ported from ScriptDeps.rs `tests`: pinned selectors, version
// matching, the order-independent script cache identity, and structured
// hostile-tree failures.
use {
    jet_pkg_model.[
        InlineDep, InlineDepResolved, InlineDepUnresolved, ScriptCacheIdentity,
        ScriptDependencyIdentity, pkg_inline_deps_best_match, pkg_inline_deps_cache_identity,
        pkg_inline_deps_e1253, pkg_inline_deps_is_pinned, pkg_inline_deps_resolve,
    ]
    jet_foundation.[Span]
    jetpack_foundation.[MAX_TREE_DEPTH]
    files: core.files
}

pkg_inline_deps_test_dep: fn(name: String) -> InlineDep Never! {
    InlineDep{name: name, selector: "1.0.0", span: Span{start: 0, end: 0}}
}

pkg_inline_deps_test_candidates: fn(pairs: [String]) -> [(version: String, dir: String)] Never! {
    out := [(version: String, dir: String)]{}
    loop index in 0..<(pairs.len() /% 2) -> out.push((version: pairs[index * 2], dir: pairs[index * 2 + 1]))
    out
}

pkg_inline_deps_test_unresolved: fn(dep: InlineDep, script_dir: String) -[FS, Env]> InlineDepUnresolved Never! {
    if pkg_inline_deps_resolve(dep, script_dir) == {
        .Ok(_) -> panic("hostile inline dependency must not resolve")
        .Err(error) -> error
    }
}

#Test("pinned requires exact three parts") {
    assert(pkg_inline_deps_is_pinned("1.4.2"))
    assert(!pkg_inline_deps_is_pinned("1.4"))
    assert(!pkg_inline_deps_is_pinned("1"))
    assert(!pkg_inline_deps_is_pinned("latest"))
    assert(!pkg_inline_deps_is_pinned("*"))
    assert(!pkg_inline_deps_is_pinned("^1.4.2"))
    assert(!pkg_inline_deps_is_pinned("01.4.2"))
    assert(!pkg_inline_deps_is_pinned("1.4.999999999999999999999999"))
}

#Test("numeric selectors retain Rust unsigned parsing semantics") {
    assert(pkg_inline_deps_is_pinned("18446744073709551615.1.2"))
    assert(!pkg_inline_deps_is_pinned("18446744073709551616.1.2"))
    assert(pkg_inline_deps_is_pinned("+1.4.2"))
    assert(!pkg_inline_deps_is_pinned("01.4.2"))
    selected: pkg_inline_deps_best_match("18446744073709551615", [(version: String, dir: String)]{(version: "18446744073709551615.0.1", dir: "older"), (version: "18446744073709551615.0.2", dir: "newer")}) ?? panic("full unsigned selector")
    assert_eq(selected.dir, "newer")
}

#Test("exact match does not accept incompatible or malformed versions") {
    candidates: pkg_inline_deps_test_candidates([String]{"1.4.2", "exact", "1.4.3", "newer", "1.4.2.1", "malformed"})
    chosen: pkg_inline_deps_best_match("1.4.2", candidates) ?? panic("exact version matches")
    assert_eq(chosen.version, "1.4.2")
    assert_eq(pkg_inline_deps_best_match("1.4.1", candidates), None)
}

#Test("cache identity is order independent but binds all facts") {
    left: InlineDepResolved{name: "textkit", selector: "1.4", resolved_version: "1.4.2", dir: "/first/checkout", content_hash: "sha256-source"}
    right := left
    right.name = "other"
    right.dir = "/second/checkout"
    first: pkg_inline_deps_cache_identity("sha256-script", [InlineDepResolved]{left, right}, "jet-1", "x86_64")
    reordered: pkg_inline_deps_cache_identity("sha256-script", [InlineDepResolved]{right, left}, "jet-1", "x86_64")
    assert_eq(first.digest(), reordered.digest())
    identities: [ScriptDependencyIdentity]{left.dependency_identity(), right.dependency_identity()}
    changed_source: ScriptCacheIdentity.new("sha256-script-edited", identities, "jet-1", "x86_64")
    changed_toolchain: ScriptCacheIdentity.new("sha256-script", identities, "jet-2", "x86_64")
    assert(first.digest() != changed_source.digest())
    assert(first.digest() != changed_toolchain.digest())
}

#Test("best match prefers prefix and highest") {
    candidates: pkg_inline_deps_test_candidates([String]{"1.4.0", "a", "1.4.2", "b", "2.0.0", "c"})
    loose: pkg_inline_deps_best_match("1.4", candidates) ?? panic("prefix match")
    assert_eq(loose.version, "1.4.2")
    exact: pkg_inline_deps_best_match("1.4.0", candidates) ?? panic("exact match")
    assert_eq(exact.version, "1.4.0")
    assert_eq(pkg_inline_deps_best_match("9.9", candidates), None)
}

#Test("resolve rejects recursive symlink as structured failure") {
    root: files.temp_dir("jet-script-deps-symlink") ?? panic("scratch")
    package: files.join(root.path, ".jet/inline-deps/hostile/1.0.0")
    files.create_dir_all(files.join(package, "src")) ?? panic("package tree")
    files.write(files.join(package, "src/value.jet"), "stable\n") ?? panic("source file")
    files.symlink(".", files.join(package, "src/loop")) ?? panic("loop link")
    dependency: pkg_inline_deps_test_dep("hostile")
    error: pkg_inline_deps_test_unresolved(dependency, root.path)
    if error == {
        .InvalidTree(tree_error) -> if tree_error == {
            .Symlink(path) -> assert(path.ends_with("src/loop"))
            .IO(_, _) | .Special(_) | .InvalidName(_) | .TooLarge(_, _) -> panic("expected a symlink tree failure")
        }
        .InvalidName | .InvalidSelector | .UnknownPackage | .NoMatch -> panic("expected an invalid tree failure")
    }
    diagnostic: pkg_inline_deps_e1253(dependency, error)
    assert_eq(diagnostic.code, "E1253")
    assert(diagnostic.why.contains("symlink"))
}

#Test("resolve rejects oversized recursive source as structured failure") {
    root: files.temp_dir("jet-script-deps-depth") ?? panic("scratch")
    current := files.join(root.path, ".jet/inline-deps/hostile/1.0.0")
    files.create_dir_all(current) ?? panic("package root")
    loop index in 0..<(MAX_TREE_DEPTH + 2) {
        current = files.join(current, "d{index}")
        files.create_dir_all(current) ?? panic("nested directory")
    }
    files.write(files.join(current, "payload.jet"), "stable\n") ?? panic("payload")
    error: pkg_inline_deps_test_unresolved(pkg_inline_deps_test_dep("hostile"), root.path)
    if error == {
        .InvalidTree(tree_error) -> if tree_error == {
            .TooLarge(_, limit) -> assert_eq(limit, MAX_TREE_DEPTH)
            .IO(_, _) | .Symlink(_) | .Special(_) | .InvalidName(_) -> panic("expected a tree bound failure")
        }
        .InvalidName | .InvalidSelector | .UnknownPackage | .NoMatch -> panic("expected an invalid tree failure")
    }
}

// tests/build_cache_normalization.rs:191-238: an unknown package and a hostile
// source tree both fail closed with E1253 and leave no cache, lock or `.jet`
// tree behind; the hostile one says its source cannot be hashed safely.
#Test("missing and hostile inline dependency material fails closed without creating state") {
    missing: files.temp_dir("jet-script-deps-missing") ?? panic("scratch")
    dependency: pkg_inline_deps_test_dep("missing_buildnorm")
    error: pkg_inline_deps_test_unresolved(dependency, missing.path)
    if error == {
        .UnknownPackage -> {}
        .InvalidName | .InvalidSelector | .NoMatch | .InvalidTree(_) -> panic("an absent package must be unknown")
    }
    assert_eq(pkg_inline_deps_e1253(dependency, error).code, "E1253")
    assert(!files.exists(files.join(missing.path, ".jet")), "a missing dependency must not materialize a cache or lock tree")

    hostile: files.temp_dir("jet-script-deps-hostile-state") ?? panic("scratch")
    package: files.join(hostile.path, ".jet/inline-deps/hostile/1.0.0")
    files.create_dir_all(package) ?? panic("package tree")
    files.write(files.join(package, "value.jet"), "stable\n") ?? panic("source file")
    files.symlink(".", files.join(package, "loop")) ?? panic("loop link")
    hostile_dependency: pkg_inline_deps_test_dep("hostile")
    hostile_error: pkg_inline_deps_test_unresolved(hostile_dependency, hostile.path)
    if hostile_error == {
        .InvalidTree(_) -> {}
        .InvalidName | .InvalidSelector | .UnknownPackage | .NoMatch -> panic("a hostile tree must be an invalid tree failure")
    }
    hostile_diagnostic: pkg_inline_deps_e1253(hostile_dependency, hostile_error)
    assert_eq(hostile_diagnostic.code, "E1253")
    assert(hostile_diagnostic.why.contains("cannot be hashed safely"), "the hostile failure must explain that the source cannot be hashed safely")
    assert(!files.exists(files.join(hostile.path, "standalone.jet.lock")), "a hostile dependency must not write a lock")
}
