// Manifest.rs tests: release status, the authority diagnostic family, and
// the package metadata policy surface.
use jet_pkg_model.[
    JET_VERSION, Manifest, PackageFacts, PolicySourceMap, pkg_ascii_lower, pkg_current_release_status,
    pkg_jet_build_from_stamps, pkg_satisfies_constraint, pkg_version_banner, pkg_version_json, pkg_version_line,
]

#Test("current release status is separate from package semver") {
    status: pkg_current_release_status()
    assert_eq(status.channel, "prerelease")
    assert_eq(status.disposition, "current")
    assert_eq(status.readiness, "not-ready")
    assert_eq(status.policy, "future-1.0")
    assert_eq(status.policy_disposition, "planned")
    assert(!status.policy_active)
    banner: pkg_version_banner(pkg_jet_build_from_stamps(None, None))
    assert(banner.starts_with("jet {JET_VERSION}-dev\n"))
    assert(banner.contains("\nRelease status: Prerelease\n"))
    assert(banner.contains("\nRelease disposition: Current\n"))
    assert(banner.contains("\nRelease readiness: Not ready\n"))
    assert(banner.contains("\nCompatibility policy: Future 1.0 (planned; not active)\n"))
}

#Test("the version line names a release, a dev commit, or neither") {
    commit: "29517f5447e1d7c0b3a8f6d2c4e5b6a7f8091a2b"
    released: pkg_jet_build_from_stamps(Val("{JET_VERSION} {commit} 2026-11-09\n"), Val("{commit}\n"))
    assert(released.released)
    assert_eq(pkg_version_line(released), "jet {JET_VERSION} (29517f5447, 2026-11-09, alpha)")
    dev: pkg_jet_build_from_stamps(None, Val("{commit}\n"))
    assert(!dev.released)
    assert_eq(pkg_version_line(dev), "jet {JET_VERSION}-dev+29517f5447")
    assert(pkg_version_json(dev).starts_with("{{\"version\":\"{JET_VERSION}-dev+29517f5447\",\"release\":\"{JET_VERSION}\",\"released\":false,\"commit\":\"{commit}\",\"date\":null,\"channel\":\"alpha\","))
    // Another release's stamp, or a malformed one, is not this build's.
    other: pkg_jet_build_from_stamps(Val("a0.0.9 {commit} 2026-11-09\n"), None)
    assert_eq(other.version, "{JET_VERSION}-dev")
    assert_eq(pkg_jet_build_from_stamps(Val("{JET_VERSION} {commit}\n"), Val("not-a-commit\n")).version, "{JET_VERSION}-dev")
    assert(pkg_version_json(other).contains("\"commit\":null,\"date\":null"))
}

#Test("toolchain constraints order the alpha before the plain version") {
    assert(pkg_satisfies_constraint("a0.0.43", ">=a0.0.43"))
    assert(pkg_satisfies_constraint("a0.0.44", ">=a0.0.43"))
    assert(!pkg_satisfies_constraint("a0.0.42", ">=a0.0.43"))
    assert(!pkg_satisfies_constraint("a0.0.43", ">=0.0.43"))
    assert(!pkg_satisfies_constraint("a0.0.43", ">=99.0.0"))
    assert(pkg_satisfies_constraint("a1.0.0", ">=0.9.0"))
}

#Test("malformed authority outer value uses E1221") {
    authorities: [String]{"authority: []", "authority: {{}}\nauthority: {{}}"}
    loop authority in authorities {
        raw: "name: \"demo\"\nversion: \"0.1.0\"\n{authority}\n"
        if PackageFacts.parse(raw, "package.jet") == {
            .Err(error) -> {
                is_effects: if error == {
                    .BadEffectsBlock(_) -> true
                    else -> false
                }
                assert(is_effects)
            }
            .Ok(_) -> panic("malformed authority must be rejected")
        }
        if Manifest.parse("package.jet", raw) == {
            .Err(error) -> assert_eq(error.diagnostic.code, "E1221")
            .Ok(_) -> panic("malformed authority must use the authority diagnostic family")
        }
    }
}

#Test("package policy surface parses and rejects duplicate license entries") {
    raw: "\nname: \"consumer\"\nversion: \"0.1.0\"\nlicense: \"MIT\"\npolicy: {{\n    licenses: .Allow([\"MIT\", \"Apache-2.0\"]),\n    sources: {{ \"Acme.*\": [\"internal\"] }},\n}}\n"
    manifest: Manifest.parse("package.jet", raw) ?? panic("package policy parses")
    assert_eq(manifest.policy.licenses, Val([String]{"MIT", "Apache-2.0"}))
    assert_eq(manifest.policy.source_maps, [PolicySourceMap]{PolicySourceMap{pattern: "Acme.*", sources: [String]{"internal"}}})

    duplicate: "name: \"consumer\"\nversion: \"0.1.0\"\npolicy: {{ licenses: .Allow([\"MIT\", \"MIT\"]) }}\n"
    if Manifest.parse("package.jet", duplicate) == {
        .Err(error) -> {
            assert_eq(error.diagnostic.code, "E1215")
            assert(error.diagnostic.what.contains("package.jet"))
            assert(pkg_ascii_lower(error.diagnostic.why).contains("package metadata policy is malformed"))
            assert(error.diagnostic.fix.contains("syntax-decisions.md"))
        }
        .Ok(_) -> panic("duplicate license policy entries must fail")
    }
}
