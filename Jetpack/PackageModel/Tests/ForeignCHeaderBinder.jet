use {
    jet_pkg_model.[
        CBindResult, ForeignLanguage, HandleOverlay, pkg_binder_descriptor, pkg_cbind_bind_files,
        pkg_cbind_generate, pkg_cbind_generate_with_descriptor, pkg_cbind_parse_prototype,
    ]
    jet_lexer.[lex_generated]
    jet_parser.[parse_lexed]
}

pkg_test_cbind: fn(header: String, lib: String) -> CBindResult Never! {
    pkg_cbind_generate(header, lib) ?? panic("C header must bind")
}

pkg_test_cbind_error: fn(header: String, lib: String) -> String Never! {
    if pkg_cbind_generate(header, lib) == {
        .Ok(_) -> panic("C header must not bind")
        .Err(error) -> error.message
    }
}

// Whether generated cache source lexes and parses without errors.
pkg_test_cbind_source_parses: fn(source: String) -> Bool Never! {
    lexed: lex_generated(source.bytes())
    if lexed.diagnostics.len() != 0 -> return false
    parsed: parse_lexed(lexed)
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == 1 -> return false
    }
    true
}

#Test("C binder malformed prototype names return the existing error without panic") {
    assert(pkg_cbind_parse_prototype("(int)") == None)
    assert_eq(pkg_test_cbind_error("(int);", "empty-name"), "no bindable C function prototypes found for `empty-name`")
    assert(pkg_cbind_parse_prototype("éfoo(int)") == None)
    assert_eq(pkg_test_cbind_error("éfoo(int);", "unicode-name"), "no bindable C function prototypes found for `unicode-name`")
    valid: pkg_test_cbind("int foo(int value);", "valid")
    assert_eq(valid.bound, [String]{"foo"})
    assert(valid.source.contains("foo: fn(value: Int) -> Int = \"foo\"\n"))
    leading_underscore: pkg_test_cbind("int _foo(int value);", "underscore")
    assert_eq(leading_underscore.bound, [String]{"_foo"})
    assert(leading_underscore.source.contains("_foo: fn(value: Int) -> Int = \"_foo\"\n"))
}

#Test("C binder rejects malformed or unsupported declarators without guessing") {
    header: "\n    int trailing_comma(int value,);\n    int trailing_junk(int value) garbage;\n    int unbalanced(int (*callback)(int);\n    int valid(int value);\n"
    result: pkg_test_cbind(header, "hostile")
    assert_eq(result.bound, [String]{"valid"})
    assert(result.source.contains("valid: fn(value: Int) -> Int"))
    assert(!result.source.contains("trailing_comma"))
    assert(!result.source.contains("trailing_junk"))
    assert(!result.source.contains("unbalanced"))
}

#Test("C binder binds simple prototypes") {
    header: "\n    // a small lib\n    int jetc_add(int a, int b);\n    double scale(double x, float k);\n    void reset(void);\n    const char *name_of(int id);\n    bool is_ready();\n"
    r: pkg_test_cbind(header, "jetc")
    assert(r.source.contains("#Bindgen c.jetc.__bindgen__: module {{"))
    assert(r.source.contains("jetc_add: fn(a: Int, b: Int) -> Int = \"jetc_add\"\n"))
    assert(r.source.contains("scale: fn(x: Float, k: Float) -> Float = \"scale\"\n"))
    assert(r.source.contains("reset: fn() = \"reset\"\n"))
    assert(r.source.contains("name_of: fn(id: Int) -> String = \"name_of\"\n"))
    assert(r.source.contains("is_ready: fn() -> Bool = \"is_ready\"\n"))
    assert_eq(r.bound.len(), 5)
    assert_eq(r.skipped.len(), 0)
}

#Test("C binder descriptor change rewrites the stub identity") {
    descriptor: pkg_binder_descriptor(ForeignLanguage.C) ?? panic("C binder descriptor is registered")
    base: pkg_test_cbind("int ping(int value);", "identity")
    assert_eq(base.descriptor_stamp, descriptor.stamp())
    assert(base.source.contains("jet-ffi-descriptor={descriptor.stamp()}"))
    assert(pkg_test_cbind_source_parses(base.source))
    changed := descriptor
    changed.effect_root = "FFI.changed"
    rebound: pkg_cbind_generate_with_descriptor("int ping(int value);", "identity", changed) ?? panic("changed descriptor must bind")
    assert(base.descriptor_stamp != rebound.descriptor_stamp)
    assert(rebound.source.contains("jet-ffi-descriptor={rebound.descriptor_stamp}"))
    assert(!rebound.source.contains("jet-ffi-descriptor={base.descriptor_stamp}"))
}

#Test("C binder skips unbindable prototypes and keeps the rest") {
    header: "\n    int ok(int x);\n    struct Point {{ int x; int y; }};\n    void *raw_alloc(size_t n);\n    int sum(int *items, int n);\n    void log_msg(const char *fmt, ...);\n"
    r: pkg_test_cbind(header, "lib")
    assert(r.source.contains("ok: fn(x: Int) -> Int = \"ok\"\n"))
    assert(r.source.contains("sum: fn(items: &[I32], n: Int) -> Int = \"sum\"\n"))
    // `void*` return and varargs stay skipped; a pointer paired with a scalar
    // count is a typed Jet slice at the generated boundary.
    skipped := [String]{}
    loop entry in r.skipped -> skipped.push(entry.name)
    assert(skipped.contains("raw_alloc"))
    assert(skipped.contains("log_msg"))
    assert_eq(r.bound, [String]{"ok", "sum"})
}

#Test("C binder binds typed pointer arrays and C layout records") {
    header: "\n    typedef struct Sample {{\n        uint32_t value;\n        double ratio;\n    }} Sample;\n    const Sample *samples(size_t *length);\n    void mutate(Sample *items, size_t count);\n    void open(Sample *out);\n    int inspect(const Sample *value);\n    void write_u8(uint8_t *out);\n"
    result: pkg_test_cbind(header, "arrays")
    assert(result.source.contains("#Layout(c)\nSample: struct {{\n    value: U32,\n    ratio: Float,\n}}"))
    assert(result.source.contains("samples: fn(length: &U64) -> [Sample] = \"samples\"\n"))
    assert(result.source.contains("mutate: fn(items: &[Sample], count: Int) = \"mutate\"\n"))
    assert(result.source.contains("open: fn(out: &Sample) = \"open\"\n"))
    assert(result.source.contains("inspect: fn(value: Sample) -> Int = \"inspect\"\n"))
    assert(result.source.contains("write_u8: fn(out: &U8) = \"write_u8\"\n"))
    assert_eq(result.bound, [String]{"samples", "mutate", "open", "inspect", "write_u8"})
}

#Test("C binder binds declarations inside an extern C wrapper") {
    header: "\n    #ifdef __cplusplus\n    extern \"C\" {{\n    #endif\n    typedef struct Sample {{\n        uint32_t value;\n    }} Sample;\n    int open(const Sample *input, Sample *out);\n    #ifdef __cplusplus\n    }}\n    #endif\n"
    result: pkg_test_cbind(header, "wrapped")
    assert(result.source.contains("#Layout(c)\nSample: struct {{\n    value: U32,\n}}"))
    assert(result.source.contains("open: fn(input: Sample, out: &Sample) -> Int = \"open\"\n"))
    assert_eq(result.bound, [String]{"open"})
}

#Test("C binder errors when nothing is bindable") {
    _: pkg_test_cbind_error("struct Opaque; typedef int Handle;", "x")
}

#Test("C binder gives unnamed parameters synthetic names") {
    r: pkg_test_cbind("int f(int, double);", "m")
    assert(r.source.contains("f: fn(arg0: Int, arg1: Float) -> Int = \"f\"\n"))
}

// c43: C integers of every fixed width unify to Jet `Int` at the FFI
// surface; signedness and width are transparent to Jet callers.
#Test("C binder maps uint32_t and other fixed width integers to Int") {
    header: "\n    #include <stdint.h>\n    uint32_t add_u32(uint32_t a, uint32_t b);\n    int32_t sub_i32(int32_t a, int32_t b);\n    uint64_t identity_u64(uint64_t x);\n"
    r: pkg_test_cbind(header, "lib")
    assert(r.source.contains("add_u32: fn(a: Int, b: Int) -> Int = \"add_u32\"\n"))
    assert(r.source.contains("sub_i32: fn(a: Int, b: Int) -> Int = \"sub_i32\"\n"))
    assert(r.source.contains("identity_u64: fn(x: Int) -> Int = \"identity_u64\"\n"))
    assert_eq(r.bound, [String]{"add_u32", "sub_i32", "identity_u64"})
}

#Test("C binder binds opaque zlib handles and string edges") {
    header: "\n    typedef void *gzFile;\n    gzFile gzopen(const char *path, const char *mode);\n    int gzread(gzFile file, char *buf, unsigned int len);\n    int gzclose(gzFile file);\n"
    result: pkg_test_cbind(header, "zlib")
    assert(!result.source.contains("GzFile: struct"))
    assert(result.source.contains("    #Close(gzclose)\n    gzopen: fn(path: String, mode: String) -> GzFile = \"gzopen\"\n"))
    assert(result.source.contains("    gzread: fn(file: &GzFile, buf: &[I8], len: Int) -> Int = \"gzread\"\n"))
    assert(result.source.contains("    gzclose: fn(file: &&GzFile) -> Int = \"gzclose\"\n"))
    assert(pkg_test_cbind_source_parses(result.source))
    assert_eq(result.handles.len(), 1)
    assert_eq(result.handles[0].close, "gzclose")
}

#Test("C header bind writes each handle as a metadata row beside the cache") {
    header: "\n    typedef void *gzFile;\n    gzFile gzopen(const char *path, const char *mode);\n    int gzclose(gzFile file);\n"
    bound: pkg_cbind_bind_files(header, "z", HandleOverlay.empty()) ?? panic("C header must bind")
    assert_eq(bound.metadata, String?{Val("schema=jet-c-binding-metadata-v1\nlibrary=z\nclosure.direct=z\nhandle=z|gzFile|GzFile|gzclose|conventional|unspecified\n")})
    assert_eq(bound.hash.len(), 64)
    plain: pkg_cbind_bind_files("int add(int a, int b);\n", "math", HandleOverlay.empty()) ?? panic("C header must bind")
    assert_eq(plain.metadata, String?{None})
}
