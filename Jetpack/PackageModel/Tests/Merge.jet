// Claims ported from crates/jet-pkg-model/src/Merge.rs #[cfg(test)].

#Test("sugar member spread") {
    assert_eq(Pkg.parse_list("default.[cargo, ripgrep, fd]"), [Pkg]{Pkg.new("default", "cargo"), Pkg.new("default", "ripgrep"), Pkg.new("default", "fd")})
}

#Test("sugar dotted single") {
    assert_eq(Pkg.parse_list("default.ripgrep"), [Pkg]{Pkg.new("default", "ripgrep")})
}

#Test("sugar mixed sources in one list") {
    // The example from unified-ecosystem §5.
    assert_eq(Pkg.parse_list("default.ripgrep, default.fd, unstable.neovim"), [Pkg]{Pkg.new("default", "ripgrep"), Pkg.new("default", "fd"), Pkg.new("unstable", "neovim")})
}

#Test("sugar escape hatch string") {
    assert_eq(Pkg.parse_list("\"mine@hello\""), [Pkg]{Pkg.new("", "mine@hello")})
}

#Test("sugar bare name has empty source") {
    assert_eq(Pkg.parse_list("ripgrep"), [Pkg]{Pkg.new("", "ripgrep")})
}

#Test("sugar empty and whitespace skipped") {
    assert_eq(Pkg.parse_list("   ").len(), 0)
    assert_eq(Pkg.parse_list("default.fd, , default.rg"), [Pkg]{Pkg.new("default", "fd"), Pkg.new("default", "rg")})
}

#Test("sources merge by key and dedup") {
    first :: [String: String]{"default": "NixOS/nixpkgs/nixos-24.05@github"}
    second :: [String: String]{
        "default": "NixOS/nixpkgs/nixos-24.05@github",
        "unstable": "NixOS/nixpkgs/nixpkgs-unstable@github"
    }
    merged :: pkg_merge_sources([[String: String]]{first, second}) ?? panic("identical sources merge")
    assert_eq(merged.len(), 2)
    assert_eq(merged["unstable"], "NixOS/nixpkgs/nixpkgs-unstable@github")
}

#Test("sources conflict on different refs") {
    first :: [String: String]{"default": "NixOS/nixpkgs/nixos-24.05@github"}
    second :: [String: String]{"default": "NixOS/nixpkgs/nixos-23.11@github"}
    if pkg_merge_sources([[String: String]]{first, second}) == {
        .Ok(_) -> panic("expected SourceConflict")
        .Err(error) -> assert_eq(error, MergeError.SourceConflict{name: "default", a: "NixOS/nixpkgs/nixos-24.05@github", b: "NixOS/nixpkgs/nixos-23.11@github"})
    }
}

#Test("packages concat dedup preserve source and order") {
    first :: [Pkg]{Pkg.new("default", "ripgrep"), Pkg.new("default", "fd")}
    second :: [Pkg]{
        Pkg.new("default", "ripgrep"),
        Pkg.new("unstable", "ripgrep"),
        Pkg.new("default", "jq")
    }
    assert_eq(pkg_merge_packages([[Pkg]]{first, second}), [Pkg]{Pkg.new("default", "ripgrep"), Pkg.new("default", "fd"), Pkg.new("unstable", "ripgrep"), Pkg.new("default", "jq")})
}

fn pkg_merge_test_writer(key: String, value: String, layer: ContributionLayer, source: String) -> FactContribution {
    FactContribution.new(key, FactValue.Text{value: value}, SourceScope.Package, layer, source)
}

#Test("fact law resolves layers and force without a second priority table") {
    resolved :: pkg_fact_resolve(FactKey.new("k"), [FactContribution]{
        pkg_merge_test_writer("k", "default", ContributionLayer.Declaration, "package.jet"),
        pkg_merge_test_writer("k", "bundle", ContributionLayer.OptimizationBundle, "release"),
        pkg_merge_test_writer("k", "cli", ContributionLayer.CommandLine, "command line")
    }) ?? panic("layers resolve to a deciding writer")
    assert_eq(resolved.value, FactValue.Text{value: "cli"})
    pinned :: pkg_fact_resolve(FactKey.new("k"), [FactContribution]{
        pkg_merge_test_writer("k", "bundle", ContributionLayer.OptimizationBundle, "release"),
        pkg_merge_test_writer("k", "fleet", ContributionLayer.Fleet, "fleet.jet").forced(),
        pkg_merge_test_writer("k", "cli", ContributionLayer.CommandLine, "command line")
    }) ?? panic("a fleet pin resolves to a deciding writer")
    assert_eq(pinned.value, FactValue.Text{value: "fleet"})
}

#Test("fact law conflict keeps both writers") {
    if pkg_fact_resolve(FactKey.new("k"), [FactContribution]{pkg_merge_test_writer("k", "a", ContributionLayer.Environment, "env-a"), pkg_merge_test_writer("k", "b", ContributionLayer.Environment, "env-b")}) == {
        .Ok(_) -> panic("expected a conflict")
        .Err(error) -> {
            if error == {
                .Conflict(_, _, first, second) -> {
                    assert_eq(first.source, "env-a")
                    assert_eq(second.source, "env-b")
                }
                else -> panic("expected FactError.Conflict")
            }
        }
    }
}

#Test("entry combines packages and resolves settings") {
    first :: EntryContribution{packages: [Pkg]{Pkg.new("default", "ripgrep")}, settings: [String: [FactContribution]]{"prompt": [FactContribution]{pkg_merge_test_writer("prompt", "jetpack", ContributionLayer.Declaration, "package.jet")}}}
    second :: EntryContribution{packages: [Pkg]{Pkg.new("default", "fd")}, settings: [String: [FactContribution]]{"prompt": [FactContribution]{pkg_merge_test_writer("prompt", "wordstats", ContributionLayer.OptimizationBundle, "profile")}}}
    merged :: pkg_merge_entry([EntryContribution]{first, second}) ?? panic("entries merge")
    assert_eq(merged.packages, [Pkg]{Pkg.new("default", "ripgrep"), Pkg.new("default", "fd")})
    // The optimization bundle overrides the declaration fallback.
    assert_eq(merged.settings["prompt"], "wordstats")
}

#Test("entry propagates fact conflict") {
    first :: EntryContribution{settings: [String: [FactContribution]]{"host": [FactContribution]{pkg_merge_test_writer("host", "a", ContributionLayer.Environment, "env-a")}}}
    second :: EntryContribution{settings: [String: [FactContribution]]{"host": [FactContribution]{pkg_merge_test_writer("host", "b", ContributionLayer.Environment, "env-b")}}}
    if pkg_merge_entry([EntryContribution]{first, second}) == {
        .Ok(_) -> panic("expected a fact conflict")
        .Err(error) -> {
            if error == {
                .FactConflict(fact_error) -> {
                    if fact_error == {
                        .Conflict(key, _, _, _) -> assert_eq(key, "host")
                        else -> panic("expected FactError.Conflict")
                    }
                }
                else -> panic("expected MergeError.FactConflict")
            }
        }
    }
}

#Test("locked fact values keep Rust tuple debug spelling") {
    assert_eq(FactValue.Bool{value: true}.debug_text(), "Bool(true)")
    assert_eq(FactValue.Int{value: 42}.debug_text(), "Int(42)")
    assert_eq(FactValue.Char{value: '\n'}.debug_text(), "Char('\\n')")
    assert_eq(FactValue.Text{value: "quoted \"text\"\n"}.debug_text(), "Text(\"quoted \\\"text\\\"\\n\")")
    assert_eq(FactValue.Enum{variant: "Fast"}.debug_text(), "Enum(\"Fast\")")
    assert_eq(FactValue.OptionalText{value: Val("x")}.debug_text(), "OptionalText(Some(\"x\"))")
    assert_eq(FactValue.OptionalText{value: None}.debug_text(), "OptionalText(None)")
    assert_eq(FactValue.Policy{value: PolicyValue.Limit{value: 7}}.debug_text(), "Policy(Limit(7))")
    assert_eq(FactValue.Policy{value: PolicyValue.Forbid}.debug_text(), "Policy(Forbid)")
}

#Test("entry ignores an unwritten fact with no default") {
    contribution :: EntryContribution{settings: [String: [FactContribution]]{"absent": [FactContribution]{}}}
    merged :: pkg_merge_entry([EntryContribution]{contribution}) ?? panic("empty fact contributions merge")
    assert(!merged.settings.has_key("absent"))
}
