// Claims ported from crates/jet-pkg-model/src/EffectBudget.rs #[cfg(test)].
// The Rust fixture lexes and parses two modules into a ProgramBundle; here
// the same program is written directly as the budget's EffectBudgetProgram
// view (module paths, aliases, and the effect keys their items define).
use {
    jet_pkg_model.[
        EffectBudgetImport, EffectBudgetModule, EffectBudgetProgram, EffectBudgetWitness,
        EffectProjection, PackageEffectSummary, PackageEffects, PackageFacts, PackageGrant,
        pkg_compute_package_effects, pkg_effect_enforce, pkg_effect_summary_json_for_entry,
        pkg_effect_summary_line_for_entry, pkg_render_effect_projection_json,
    ]
    jet_foundation.[Span, authority_holds]
}

pkg_test_effect_summary: fn(direct: [String], edges: [String], maximal: Bool) -> PackageEffectSummary Never! {
    PackageEffectSummary{direct: direct, edges: edges, maximal: maximal}
}

pkg_test_effect_program: fn() -> EffectBudgetProgram Never! {
    EffectBudgetProgram{
        entry: 0,
        modules: [EffectBudgetModule]{
            {path: "/workspace/app/run.jet", alias: "run", function_keys: [String]{"run"}, function_spans: [String: Span]{"run": Span{start: 3, end: 6}}, imports: [EffectBudgetImport]{}, has_build_entry: false},
            {path: "/workspace/deps/email/src/crypto.jet", alias: "crypto", function_keys: [String]{"migrate_v1", "seal", "unused"}, function_spans: [String: Span]{"migrate_v1": Span{start: 3, end: 13}, "seal": Span{start: 22, end: 26}, "unused": Span{start: 35, end: 41}}, imports: [EffectBudgetImport]{}, has_build_entry: false}
        },
        dep_roots: [String: String]{"email": "/workspace/deps/email"},
        selected_output: None
    }
}

pkg_test_effect_summaries: fn(root_calls_migrate: Bool) -> [String: PackageEffectSummary] Never! {
    run_edges: if root_calls_migrate -> [String]{"crypto::migrate_v1"} else -> [String]{}
    [String: PackageEffectSummary]{
        "run::run": pkg_test_effect_summary([String]{}, run_edges, false),
        "crypto::migrate_v1": pkg_test_effect_summary([String]{}, [String]{"crypto::seal"}, false),
        "crypto::seal": pkg_test_effect_summary([String]{"Rand"}, [String]{}, false),
        "crypto::unused": pkg_test_effect_summary([String]{"Rand"}, [String]{}, false)
    }
}

pkg_test_effect_solved: fn() -> [String: [String]] Never! {
    [String: [String]]{
        "run::run": [String]{},
        "crypto::migrate_v1": [String]{"Rand"},
        "crypto::seal": [String]{"Rand"},
        "crypto::unused": [String]{"Rand"}
    }
}

pkg_test_effect_package: fn(entries: [PackageEffects], name: String) -> PackageEffects Never! {
    loop entry in entries {
        if entry.name == name -> return entry
    }
    panic("fixture package entry")
}

pkg_test_budget_manifest: fn(allow: [String]) -> PackageFacts Never! {
    manifest := PackageFacts.default()
    manifest.effects_enabled = true
    manifest.authority.allow = Val(allow)
    manifest
}

pkg_test_package_effects: fn(name: String, effects: [String], chains: [String: [String]], panic_sites: [String], span: Span?) -> PackageEffects Never! {
    PackageEffects{name: name, effects: effects, effect_chains: chains, effect_witnesses: [String: EffectBudgetWitness]{}, panic_sites: panic_sites, boundary_span: span}
}

#Test("package budget ignores an unreachable loaded rand helper") {
    entries: pkg_compute_package_effects(pkg_test_effect_program(), pkg_test_effect_solved(), pkg_test_effect_summaries(false))
    email: pkg_test_effect_package(entries, "email")
    assert_eq(email.effects.len(), 0)
    assert_eq(email.effect_chains.len(), 0)
    assert_eq(pkg_effect_enforce(entries, pkg_test_budget_manifest([String]{"IO"})).len(), 0)
}

#Test("package budget keeps reachable rand at the dependency boundary") {
    entries: pkg_compute_package_effects(pkg_test_effect_program(), pkg_test_effect_solved(), pkg_test_effect_summaries(true))
    email: pkg_test_effect_package(entries, "email")
    assert(email.effects.contains("Rand"))
    assert_eq(email.effect_chains.get("Rand"), Val([String]{"crypto::migrate_v1", "crypto::seal"}))
    diagnostics: pkg_effect_enforce(entries, pkg_test_budget_manifest([String]{"IO"}))
    found := false
    loop diagnostic in diagnostics {
        if diagnostic.what.contains("`email`") && diagnostic.what.contains("Rand") -> found = true
    }
    assert(found)
}

#Test("package budget preserves the authored effect witness location") {
    solved := pkg_test_effect_solved()
    solved["run::run"] = [String]{"Rand"}
    entries: pkg_compute_package_effects(pkg_test_effect_program(), solved, pkg_test_effect_summaries(true))
    diagnostics: pkg_effect_enforce(entries, pkg_test_budget_manifest([String]{"IO"}))
    assert_eq(diagnostics.len(), 2)
    loop diagnostic in diagnostics {
        if diagnostic.code == "E0749" {
            // The root's chain stays in the root: the call into `email`
            // leaves email's Rand with email.
            assert_eq(diagnostic.span, Val(Span{start: 3, end: 6}))
            assert_eq(diagnostic.source_path, Val("/workspace/app/run.jet"))
            assert_eq(diagnostic.call_chain, [String]{"run::run"})
        } else {
            assert_eq(diagnostic.code, "E1220")
            assert_eq(diagnostic.span, Val(Span{start: 22, end: 26}))
            assert_eq(diagnostic.source_path, Val("/workspace/deps/email/src/crypto.jet"))
            assert(diagnostic.what.contains("crypto::seal"))
        }
    }
}

#Test("effect budget authority block is the E1220 source") {
    manifest := pkg_test_budget_manifest([String]{"FS"})
    // Deliberately disagree with the retired mirror field; the authority
    // block must decide the result.
    manifest.effects_allow = Val([String]{"Net"})
    entries: [PackageEffects]{pkg_test_package_effects("dep", [String]{"Net"}, [String: [String]]{}, [String]{}, None)}
    diagnostics: pkg_effect_enforce(entries, manifest)
    assert_eq(diagnostics.len(), 1)
    assert(diagnostics[0].fix.contains("authority.allow"))
    manifest.authority.grants = [PackageGrant]{PackageGrant{package: "dep", rights: [String]{"Net"}}}
    assert_eq(pkg_effect_enforce(entries, manifest).len(), 0)
}

#Test("a written allow row is a ceiling over the root package's own code") {
    manifest := pkg_test_budget_manifest([String]{"FS"})
    entries: [PackageEffects]{pkg_test_package_effects("root", [String]{"Net"}, [String: [String]]{"Net": [String]{"run::run", "run::fetch"}}, [String]{}, None)}
    diagnostics: pkg_effect_enforce(entries, manifest)
    assert_eq(diagnostics.len(), 1)
    assert_eq(diagnostics[0].code, "E0749")
    assert(diagnostics[0].what.contains("`run::fetch`"))
    assert(diagnostics[0].what.contains("Net"))
    assert(diagnostics[0].fix.contains("authority.allow"))
    assert_eq(diagnostics[0].call_chain, [String]{"run::run", "run::fetch"})
    // A deny over the root's own code is sema's, not the budget's.
    manifest.authority.deny = Val([String]{"Net"})
    manifest.authority.allow = Val([String]{"Net"})
    assert_eq(pkg_effect_enforce(entries, manifest).len(), 0)
}

#Test("panic budget ignores allow omission but honors denial") {
    manifest := pkg_test_budget_manifest([String]{"IO", "GPU", "Mem.Alloc", "FS", "Rand"})
    span: Span{start: 4, end: 12}
    entries: [PackageEffects]{pkg_test_package_effects("panicdep", [String]{"Panic"}, [String: [String]]{}, [String]{"panicdep::parse_port"}, Val(span))}
    assert_eq(pkg_effect_enforce(entries, manifest).len(), 0)
    manifest.authority.deny = Val([String]{"Panic"})
    denied: pkg_effect_enforce(entries, manifest)
    assert_eq(denied.len(), 1)
    assert_eq(denied[0].code, "E1220")
    assert(denied[0].what.contains("panicdep::parse_port"))
    assert_eq(denied[0].span, Val(span))
    manifest.authority.grants = [PackageGrant]{PackageGrant{package: "panicdep", rights: [String]{"Panic"}}}
    granted: pkg_effect_enforce(entries, manifest)
    assert_eq(granted.len(), 1)
    assert_eq(granted[0].code, "E1220")
    assert(granted[0].what.contains("panicdep::parse_port"))
    assert_eq(granted[0].span, Val(span))
}

#Test("effect entry summary ignores open callback possibilities") {
    summaries: [String: PackageEffectSummary]{
        "run": pkg_test_effect_summary([String]{"IO"}, [String]{"callbacks::apply_twice"}, true),
        "callbacks::apply_twice": pkg_test_effect_summary([String]{}, [String]{}, true)
    }
    assert_eq(pkg_effect_summary_line_for_entry(summaries, "run"), "effects: IO")
    assert((pkg_effect_summary_json_for_entry(summaries, "run") ?? panic("render effects")).contains("\"action\":\"build.effects\""))
}

#Test("effect projection json keeps required granted denied and authority distinct") {
    required: authority_holds([String]{"FS.Read", "Net", "Panic"})
    projection: EffectProjection{
        required_effects: required,
        granted_effects: authority_holds([String]{"FS", "IO"}),
        denied_effects: [String]{"Panic"},
        authority: "package.jet authority"
    }
    json: pkg_render_effect_projection_json(projection) ?? panic("render projection json")
    assert(json.contains("\"required_effects\":[\"FS.Read\",\"Net\",\"Panic\"]"), json)
    assert(json.contains("\"granted_effects\":[\"FS\",\"IO\"]"), json)
    assert(json.contains("\"denied_effects\":[\"Panic\"]"), json)
    assert(json.contains("\"authority\":\"package.jet authority\""), json)
}
