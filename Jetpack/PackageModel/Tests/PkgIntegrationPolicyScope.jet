// Exact originals tests/policy_scope.rs; no fixture spelling migrations.
use {
    jet_pkg_model.[PackageFacts, pkg_parse_organization_document]
    jet_foundation.[PolicyKey, PolicyValue]
}

#Test("package policy cannot authorize unsafe") {
    rejected: if PackageFacts.parse("name: \"bad_policy\"\nversion: \"0.1.0\"\npolicy: {{ unsafe: .Allow }}\n", "test") == {
        .Ok(_) -> false
        .Err(error) -> {
            bad: if error == {
                .BadPackagePolicy(_) -> true
                .MissingName | .MissingRecord(_) | .MalformedField(_) | .UnknownField(_) | .UnknownOutputKind(_) | .InvalidValue(_, _) | .RetiredRecordHead | .ConfigMembers | .Composition(_) | .NestedMembers(_, _) | .LintPolicyCode(_, _) | .BadTarget(_, _, _) | .BadTargetField(_, _) | .ReservedSection(_) | .BadEffectsBlock(_) | .RetiredAuthorityField(_, _) | .BadMemoryPolicy(_) | .RetiredPolicyField(_, _) | .BadGuaranteePolicy(_) | .BadAllocatorPolicy(_) -> false
            }
            assert(bad)
            assert(error.message().contains("policy.unsafe"))
            assert(error.message().contains(".Deny"))
            true
        }
    }
    assert(rejected)
}

// Effect ceilings are module caps (`#FX(…) name: module`) and package
// `authority.deny`, never a policy field.
#Test("package policy has no effect ceilings") {
    rejected: if PackageFacts.parse("name: \"policy\"\nversion: \"0.1.0\"\npolicy: {{ effects: {{ \"./src\": -[]> }} }}\n", "test") == {
        .Ok(_) -> false
        .Err(error) -> {
            assert(error.message().contains("`effects` is not a registered package policy"))
            true
        }
    }
    assert(rejected)
}

// volatile: original input ends "})" without closing the policy brace.
#Test("package team policy parser normalizes typed controls") {
    package: PackageFacts.parse("name: \"policy\"\nversion: \"0.1.0\"\ndeps: {{ zlib: c@system }}\npolicy: {{ unsafe: .Paths([\"./src\", \"src\"]), expert: .Deny, deps: .List([\"zlib\", \"zlib\"]), lints: {{ deny: [float_money] }})\n", "test") ?? panic("typed controls parse")
    assert_eq(package.policy.unsafe_paths, Val([String]{"src"}))
    assert_eq(package.policy.expert, Val(false))
    assert_eq(package.policy.deps, Val([String]{"zlib"}))
    assert_eq(package.policy.lints_deny, Val([String]{"float_money"}))
}

#Test("manifest memory denial uses the effects rights tree") {
    package: PackageFacts.parse("name: \"memory\"\nversion: \"0.1.0\"\nauthority: {{ deny: [Mem.Alloc(above: 65536)] }}\n", "test") ?? panic("memory denial parse")
    assert_eq(package.effects_deny, Val([String]{"Mem.Alloc(above: 65536)"}))
}

#Test("organization policy document is exact and fails closed") {
    valid: pkg_parse_organization_document("policy: {{ unsafe: .Obligations, impure: .GateOnly, nondeterministic: .GateOnly }}\n") ?? panic("organization policy parse")
    assert_eq(valid.declarations.len(), 3)
    assert_eq(valid.declarations[0].value, PolicyValue.Obligations)
    assert_eq(valid.declarations[1].key, PolicyKey.Impure)
    assert_eq(valid.declarations[2].key, PolicyKey.Nondeterministic)
    assert_eq(valid.deny.len(), 0)
    invalid: [String]{"policy: {{ unsafe: .Obligations", "policy: {{ unsafe: .Obligations }}\npackage: {{}}", "authority: {{ allow: [Meta] }}", "authority: {{ deny: [Meta], needs: [Net] }}", "authority: {{ deny: [Meta] }}\nauthority: {{ deny: [Net] }}", ""}
    loop text in invalid {
        rejected: if pkg_parse_organization_document(text) == {
            .Err(_) -> true
            .Ok(_) -> false
        }
        assert(rejected)
    }
}

#Test("organization policy document denies effects to every package") {
    denied: pkg_parse_organization_document("authority: {{ deny: [Meta] }}\n") ?? panic("organization authority parse")
    assert_eq(denied.deny, [String]{"Meta"})
    assert_eq(denied.declarations.len(), 0)
    both: pkg_parse_organization_document("policy: {{ unsafe: .Forbid }}\nauthority: {{ deny: [Meta.Generate, Exec] }}\n") ?? panic("organization policy and authority parse")
    assert_eq(both.declarations.len(), 1)
    assert_eq(both.deny, [String]{"Meta.Generate", "Exec"})
}

#Test("package policy document accepts explicit units") {
    declarations: (pkg_parse_organization_document("policy: {{ explicit_units: true }}\n") ?? panic("policy parse")).declarations
    assert_eq(declarations.len(), 1)
    assert_eq(declarations[0].key, PolicyKey.ExplicitUnits)
    assert_eq(declarations[0].value, PolicyValue.Enabled)
}

#Test("copies policy is package and source explicit only") {
    declarations: (pkg_parse_organization_document("policy: {{ copies: .Explicit }}\n") ?? panic("policy parse")).declarations
    assert_eq(declarations.len(), 1)
    assert_eq(declarations[0].key, PolicyKey.Copies)
    assert_eq(declarations[0].value, PolicyValue.Explicit)
    rejected: if pkg_parse_organization_document("policy: {{ copies: true }}\n") == {
        .Err(_) -> true
        .Ok(_) -> false
    }
    assert(rejected)
}
