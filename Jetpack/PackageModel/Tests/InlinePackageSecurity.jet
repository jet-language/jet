// Package/Blocks.rs security tests: retired build environment payloads and
// the contextual inline `package { … }` carrier.

#Test("build profile rejects retired environment payload") {
    hostile :: "release: Build.{{ optimize: \"full\", env: \"RUSTFLAGS=--cfg=hostile; touch pwned\" }}"
    if pkg_parse_build(hostile) == {
        .Ok(_) -> panic("retired build-profile environment data must not reach rustc")
        .Err(_) -> {}
    }
}

// Rust `extract_inline_package(source).unwrap()`: the scan succeeds and the
// carrier may be absent. A single `??` would consume both the Result and the
// Option rail, so absence must stay observable here.
fn pkg_test_scan_inline_package(source: String) -> InlinePackageBlock? Never! {
    scanned := InlinePackageBlock?{None}
    if pkg_extract_inline_package(source) == {
        .Ok(found) -> scanned = found
        .Err(error) -> panic("inline Package scan failed: {error.message()}")
    }
    scanned
}

#Test("inline package spans and mask preserve offsets") {
    source :: "// header\npackage /* carrier */ {{\nname: \"demo\"\n}}\nfn run() {{}}\n"
    block :: pkg_test_scan_inline_package(source) ?? panic("leading inline Package")
    assert_eq(pkg_binder_slice(source, block.keyword_span.start, block.keyword_span.end), "package")
    masked :: block.mask_source(source)
    assert_eq(source.bytes().len(), masked.bytes().len())
    raw :: masked.bytes()
    loop index in block.span.start..<block.span.end {
        code :: Int.from_u8(raw[index])
        assert(code == 32 || code == 10 || code == 13)
    }
}

#Test("inline package scanner ignores nested words") {
    nested :: "fn run() {{ print(\"package {{ not a declaration }}\") }}\n"
    assert(pkg_test_scan_inline_package(nested) == None)
    source :: "package {{ description: \"\"\"package {{ still text }}\"\"\" }}\nfn run() {{}}\n"
    block :: pkg_test_scan_inline_package(source) ?? panic("triple-quoted Package values stay inside the carrier")
    assert(block.body(source).contains("still text"))
}

#Test("inline package scanner ignores module path segments") {
    source :: "module perf.package {{\n}}\nfn run() {{}}\n"
    assert(pkg_test_scan_inline_package(source) == None)
}

#Test("inline package allows byte zero shebang header") {
    source :: "#!/usr/bin/env jet\npackage {{ name: \"demo\" }}\nfn run() {{}}\n"
    assert(pkg_test_scan_inline_package(source) != None)
}

#Test("inline package rejects not first duplicate and unbalanced") {
    if pkg_extract_inline_package("fn run() {{}}\npackage {{ name: \"demo\" }}\n") == {
        .Err(error) -> assert(error.message() == "the inline Package declaration must be first")
        .Ok(_) -> panic("a later carrier is not first")
    }
    if pkg_extract_inline_package("package {{ name: \"one\" }}\npackage {{ name: \"two\" }}\nfn run() {{}}\n") == {
        .Err(error) -> assert(error.message() == "only one inline Package declaration is allowed")
        .Ok(_) -> panic("a second carrier is a duplicate")
    }
    if pkg_extract_inline_package("package {{ name: \"demo\"\nfn run() {{}}\n") == {
        .Err(error) -> assert(error.message() == "the inline Package declaration is missing its closing `}}`")
        .Ok(_) -> panic("an unclosed carrier is unbalanced")
    }
}

// Insert a carrier at the computed offset; the result must parse as a
// leading carrier.
fn pkg_test_insert_inline_package(source: String) -> String Never! {
    at :: pkg_inline_package_insertion_offset(source)
    out :: "{pkg_binder_slice(source, 0, at)}package {{ name: \"demo\" }}\n{pkg_binder_tail(source, at)}"
    block :: pkg_test_scan_inline_package(out) ?? panic("insertion must produce a leading carrier")
    assert_eq(block.body(out).trim(), "name: \"demo\"")
    out
}

#Test("inline package insertion keeps header first and docs attached") {
    assert_eq(pkg_test_insert_inline_package("#!/usr/bin/env jet\n// tool header\nuse core.files as files\n"), "#!/usr/bin/env jet\n// tool header\npackage {{ name: \"demo\" }}\nuse core.files as files\n")
    assert_eq(pkg_test_insert_inline_package("// header\n\n/// Entry.\n/// More.\nfn run() {{}}\n"), "// header\n\npackage {{ name: \"demo\" }}\n/// Entry.\n/// More.\nfn run() {{}}\n")
    assert_eq(pkg_test_insert_inline_package("fn run() {{}}\n"), "package {{ name: \"demo\" }}\nfn run() {{}}\n")
}

// Package/mod.rs `source_files_checked`: interpolated suffixes compare values,
// never bind string-pattern holes or admit an unrelated Config stem.
#Test("declared config filenames compare exact suffix and preserve provenance") {
    facts := PackageFacts.parse("name: \"demo\"\nconfigs: [dev, \"release.jet\"]\n", "inline-config-paths") ?? panic("package fields parse")
    facts.resolved_config_paths = [String]{"profiles/check", "profiles/.local", "profiles/edge."}
    assert_eq(facts.field_provenance("configs"), [String]{"inline-config-paths"})
    assert(facts.is_config_file("dev"))
    assert(facts.is_config_file("dev.jet"))
    assert(facts.is_config_file("release.jet"))
    assert(facts.is_config_file("profiles/check.jet"))
    assert(!facts.is_config_file("ordinary.jet"))
    assert(!facts.is_config_file("release.jet.jet"))
    assert(!facts.is_config_file("other/check.jet"))
    assert(facts.is_config_file("profiles/.local.jet"))
    assert(!facts.is_config_file("profiles/edge..jet"))
    assert(facts.is_config_file("profiles/edge."))
}

// Package/mod.rs:1581-1634: root/src retired entries are metadata, but a
// deeper same-named module is an ordinary checked source.
#Test("checked package sources exclude only root and src retired entries") {
    root :: files.tmpdir("jet-inline-security-retired-entries") ?? panic("scratch")
    files.create_dir_all(files.join(root, "src/cli")) ?? panic("source directory")
    relatives :: [String]{LEGACY_ENTRY_FILE, "src/{LEGACY_ENTRY_FILE}", "src/cli/{LEGACY_ENTRY_FILE}", "ordinary.jet"}
    loop relative in relatives {
        files.write(files.join(root, relative), "fn run() {{}}\n") ?? panic("source fixture")
    }
    facts :: PackageFacts.default()
    resolver :: AuthorityResolver.open(root) ?? panic("checked root")
    selected :: facts.source_files_checked(resolver) ?? panic("checked sources")
    names := [String]{}
    loop file in selected -> &names.push(file.relative)
    assert_eq(names, [String]{"ordinary.jet", "src/cli/{LEGACY_ENTRY_FILE}"})
    files.remove_all(root) ?? panic("remove source fixtures")
}
