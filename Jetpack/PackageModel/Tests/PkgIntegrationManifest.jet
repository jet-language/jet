// Assertion-for-assertion ports of tests/pkg.rs. The input strings retain
// the originals' bytes, including intentionally historical manifest forms.
// PENDING-SEAM(package-tests): these tests require the PackageModel test package.

// Ported from pkg.rs:279-293; braces escape Jet interpolation only.
fn pkg_integration_min_manifest(name: String, version: String) -> String Never! {
    "name: \"{name}\"\nversion: \"{version}\"\njet: \">=0.1.0\"\ndescription: \"\"\nlicense: \"MIT\"\nrepository: \"\"\n"
}

fn pkg_integration_manifest_with_deps(name: String, version: String, deps: String) -> String Never! {
    "{pkg_integration_min_manifest(name, version)}\ndeps: {{\n{deps}\n}}\n"
}

fn pkg_integration_manifest_error(raw: String) -> ManifestError Never! {
    if Manifest.parse("package.jet", raw) == {
        .Err(error) -> error
        .Ok(_) -> panic("original required Manifest.parse to fail")
    }
}

fn pkg_integration_package_error(raw: String) -> PackageParseError Never! {
    if PackageFacts.parse(raw, "test") == {
        .Err(error) -> error
        .Ok(_) -> panic("original required PackageFacts.parse to fail")
    }
}

// Ported from pkg.rs:1570-1590.
#Test("pkg integration manifest_parse_valid_fields") {
    raw :: "name:    \"myapp\"\nversion: \"1.2.3\"\njet:     \">=0.1.0\"\ndescription: \"A test package\"\nlicense: \"MIT OR Apache-2.0\"\nrepository: \"https://example.com\"\ndeps: {{\n}}\n"
    mf :: Manifest.parse("package.jet", raw) ?? panic("valid manifest should parse")
    assert_eq(mf.package.name, "myapp")
    assert_eq(mf.package.version, "1.2.3")
    assert_eq(mf.package.jet_constraint, Val(">=0.1.0"))
    assert_eq(mf.package.description, Val("A test package"))
    assert_eq(mf.package.license, Val("MIT OR Apache-2.0"))
    assert_eq(mf.dependencies.len(), 0)
    assert_eq(mf.boundaries.len(), 0)
}

// Ported from pkg.rs:1593-1610.
#Test("pkg integration manifest_parse_import_boundaries") {
    raw :: pkg_integration_min_manifest("app", "0.1.0") + "\nboundaries: {{\n    deny: [\n        {{ from: \"app.ui\", to: \"app.db\" }},\n        {{ from: \"app.api.*\", to: \"app.db.*\" }},\n    ],\n}}\n"
    mf :: Manifest.parse("package.jet", raw) ?? panic("boundary policy should parse")
    assert_eq(mf.boundaries.len(), 2)
    assert_eq(mf.boundaries[0].from, "app.ui")
    assert_eq(mf.boundaries[0].to, "app.db")
    assert(mf.boundaries[1].matches("app.api.auth", "app.db.users"))
    assert(!mf.boundaries[1].matches("app.web", "app.db.users"))
}

// Ported from pkg.rs:1613-1648; all seven invalid inputs are retained.
#Test("pkg integration manifest_parse_import_boundaries_rejects_malformed_patterns") {
    patterns :: [String]{"app.ui", "app.*.ui", "app.**"}
    loop pattern in patterns {
        raw :: pkg_integration_min_manifest("app", "0.1.0") + "boundaries: {{ deny: [{{ from: {pattern}, to: \"app.db\" }}] }}\n"
        error :: pkg_integration_manifest_error(raw)
        assert_eq(error.diagnostic.code, "E1206")
        assert(error.diagnostic.what.contains("package.jet"))
    }
    blocks :: [String]{
        "boundaries: {{ allow: [{{ from: \"app.ui\", to: \"app.db\" }}] }}",
        "boundaries: {{ deny: [{{ to: \"app.db\" }}] }}",
        "boundaries: {{ deny: [{{ from: \"app.ui\" }}] }}",
        "boundaries: {{ deny: [{{ from: \"app.ui\", from: \"app.api\", to: \"app.db\" }}] }}"
    }
    loop block in blocks {
        error :: pkg_integration_manifest_error(pkg_integration_min_manifest("app", "0.1.0") + block + "\n")
        assert_eq(error.diagnostic.code, "E1206")
    }
}

// Ported from pkg.rs:1848-1854.
#Test("pkg integration manifest_parse_dep_path") {
    mf :: Manifest.parse("package.jet", pkg_integration_manifest_with_deps("root", "0.1.0", "    helpers: ../helpers,")) ?? panic("path dep should parse")
    dep :: mf.dependencies.get("helpers") ?? panic("missing helpers dep")
    assert(dep == DepSpec.Path{path: "../helpers"})
}

