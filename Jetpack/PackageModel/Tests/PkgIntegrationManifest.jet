// Ported from pkg.rs:2674-2690.
#Test("pkg integration manifest_add_dep_expands_inline_empty_table") {
    raw :: pkg_integration_min_manifest("root", "0.1.0") + "\ndeps: {{}}\n"
    updated :: pkg_add_dep(raw, "helpers", DepSpec.Path{path: "../helpers"})
    mf :: Manifest.parse("package.jet", updated) ?? panic("inline empty deps table should stay parseable")
    assert_eq(mf.dependencies.get("helpers"), Val(DepSpec.Path{path: "../helpers"}))
    assert(updated.contains("deps: {{\n    helpers: ../helpers,\n}}\n"))
}

// Ported from pkg.rs:2693-2706.
#Test("pkg integration manifest_remove_dep_removes_correct_entry") {
    raw :: pkg_integration_min_manifest("root", "0.1.0") + "\ndeps: {{\n    helpers: ../helpers,\n    other: ../other,\n}}\n"
    updated :: pkg_remove_dep(raw, "helpers")
    mf :: Manifest.parse("package.jet", updated) ?? panic("should reparse")
    assert_eq(mf.dependencies.get("helpers"), None)
    assert(mf.dependencies.get("other") != None)
}
