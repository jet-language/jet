    error :: pkg_integration_package_error(pkg_integration_min_manifest("app", "0.1.0") + "\nauthority: {{ trust: {{ default: maybe }} }}\n")
    bad :: if error == {
        .BadEffectsBlock(_) -> true
        else -> false
    }
    assert(bad)
}

