// Ported from pkg.rs:1865-1881.
#Test("pkg integration manifest_parse_dep_git_tag") {
    mf :: Manifest.parse("package.jet", pkg_integration_manifest_with_deps("root", "0.1.0", "    parsekit: {{ git: \"https://github.com/acme/parsekit\", tag: \"v0.4.1\" }},")) ?? panic("git tag dep should parse")
    dep :: mf.dependencies.get("parsekit") ?? panic("missing parsekit")
    valid :: if dep == {
        .Git(url, selector) -> url.contains("parsekit") && selector == GitSelector.Tag("v0.4.1")
        else -> false
    }
    assert(valid)
}

// Ported from pkg.rs:1884-1899.
#Test("pkg integration manifest_parse_foreign_package_dep") {
    mf :: Manifest.parse("package.jet", pkg_integration_manifest_with_deps("root", "0.1.0", "    plotly: js@\"plotly#version=2.35.0@npm\",")) ?? panic("foreign package dep should parse")
    assert_eq(mf.dependencies.get("plotly"), Val(DepSpec.Foreign{language: ForeignLanguage.JS, reference: "plotly#version=2.35.0@npm"}))
}

