// Ported from pkg.rs:2091-2105.
#Test("pkg integration manifest_parse_effects_block") {
    raw :: pkg_integration_min_manifest("app", "0.1.0") + "\nauthority: {{\n    holds: {{ allow: [FS, Time], deny: [Net, Panic] }},\n}}\n"
    pm :: PackageFacts.parse(raw, "test") ?? panic("authority holds should parse")
    assert(pm.effects_enabled)
    assert_eq(pm.effects_allow, Val([String]{"FS", "Time"}))
    assert_eq(pm.effects_deny, Val([String]{"Net", "Panic"}))
}

// Ported from pkg.rs:2108-2130; no weaker reuse of the existing budget test.
#Test("pkg integration manifest_panic_budget_names_the_dependency_stop_site") {
    raw :: pkg_integration_min_manifest("app", "0.1.0") + "\nauthority: {{ holds: {{ deny: [Panic] }} }}\n"
    manifest :: PackageFacts.parse(raw, "test") ?? panic("Panic should be a manifest effect root")
    entries :: [PackageEffects]{PackageEffects{name: "panicdep", effects: [String]{"Panic"}, effect_sites: [String: String]{}, effect_witnesses: [String: EffectBudgetWitness]{}, panic_sites: [String]{"panicdep::parse_port"}, boundary_span: Val(Span{start: 4, end: 12})}}
    diagnostics :: pkg_effect_enforce(entries, manifest)
    assert_eq(diagnostics.len(), 1)
    assert_eq(diagnostics[0].code, "E1220")
    assert(diagnostics[0].what.contains("panicdep"))
    assert(diagnostics[0].what.contains("parse_port"))
    assert(diagnostics[0].fix.contains("fallible result"))
    assert(diagnostics[0].fix.contains("#Pre"))
    assert_eq(diagnostics[0].span, Val(Span{start: 4, end: 12}))
}

// Ported from pkg.rs:2133-2141.
#Test("pkg integration manifest_parse_grants_block") {
    raw :: pkg_integration_min_manifest("app", "0.1.0") + "\nauthority: {{ grants: {{ \"pdf-lib\": [Net] }} }}\n"
    pm :: PackageFacts.parse(raw, "test") ?? panic("grants block should parse")
    assert_eq(pm.grants, [PackageGrant]{PackageGrant{package: "pdf-lib", rights: [String]{"Net"}}})
}

// Ported from pkg.rs:2144-2179.
#Test("pkg integration manifest_parse_authority_block_holds_grants_trust_and_providers") {
    raw :: pkg_integration_min_manifest("app", "0.1.0") + "\nauthority: {{\n    holds: {{ allow: [Net, DB.Read], deny: [Exec] }},\n    grants: {{ \"image-codec\": [FS.Read] }},\n    trust: {{ default: prompt, ci: {{ prompt: deny }}, services: {{ stripe: allow }} }},\n    providers: {{ nix: {{ registry: \"nixpkgs\", deny: [\"openssl-1.0\"] }} }},\n}}\n"
    pm :: PackageFacts.parse(raw, "test") ?? panic("one authority block should parse")
    assert_eq(pm.authority.holds.allow, Val([String]{"Net", "DB.Read"}))
    assert_eq(pm.authority.holds.deny, Val([String]{"Exec"}))
    assert_eq(pm.authority.grants, [PackageGrant]{PackageGrant{package: "image-codec", rights: [String]{"FS.Read"}}})
    assert_eq(pm.grants, pm.authority.grants)
    assert_eq(pm.effects_allow, pm.authority.holds.allow)
    assert_eq(pm.effects_deny, pm.authority.holds.deny)
    trust :: pm.authority.trust ?? panic("expected prompt trust")
    assert_eq(trust.default, Val(TrustDecision.Prompt))
    assert_eq(pm.authority.providers.len(), 1)
    assert_eq(pm.authority.providers[0].provider, "nix")
    assert_eq(pm.authority.providers[0].registry, "nixpkgs")
    assert_eq(pm.authority.providers[0].deny, [String]{"openssl-1.0"})
}

// Ported from pkg.rs:2182-2210.
#Test("pkg integration manifest_parse_authority_trust_block") {
    raw :: pkg_integration_min_manifest("app", "0.1.0") + "\nauthority: {{ trust: {{ default: prompt, ci: {{ prompt: deny }}, services: {{ postgres: prompt }}, require: attested }} }}\n"
    pm :: PackageFacts.parse(raw, "test") ?? panic("authority.trust block should parse")
    policy :: pm.authority.trust ?? panic("authority trust policy should be stored")
    assert_eq(policy.default, Val(TrustDecision.Prompt))
    assert_eq(policy.ci_prompt, Val(TrustDecision.Deny))
    assert_eq(policy.services, [ServiceTrust]{ServiceTrust{service: "postgres", decision: TrustDecision.Prompt}})
    assert_eq(policy.require, Val(ProvenanceRequirement.Attested))
}

