// The input strings retain the originals' bytes, including intentionally
// historical manifest forms.
// PENDING-SEAM(package-tests): these tests require the PackageModel test package.
use jet_pkg_model.[pkg_add_dep, pkg_check_toolchain, pkg_effect_enforce, pkg_new_template, pkg_remove_dep]

// Braces escape Jet interpolation only.
pkg_integration_min_manifest: fn(name: String, version: String) -> String Never! {
    "name: \"{name}\"\nversion: \"{version}\"\njet: \">=a0.0.43\"\ndescription: \"\"\nlicense: \"MIT\"\nrepository: \"\"\n"
}

pkg_integration_manifest_with_deps: fn(name: String, version: String, deps: String) -> String Never! {
    "{pkg_integration_min_manifest(name, version)}\ndeps: {{\n{deps}\n}}\n"
}

pkg_integration_manifest_error: fn(raw: String) -> ManifestError Never! {
    if Manifest.parse("package.jet", raw) == {
        .Err(error) -> error
        .Ok(_) -> panic("original required Manifest.parse to fail")
    }
}

pkg_integration_package_error: fn(raw: String) -> PackageParseError Never! {
    if PackageFacts.parse(raw, "test") == {
        .Err(error) -> error
        .Ok(_) -> panic("original required PackageFacts.parse to fail")
    }
}

#Test("pkg integration manifest_parse_valid_fields") {
    raw: "name:    \"myapp\"\nversion: \"1.2.3\"\njet:     \">=a0.0.43\"\ndescription: \"A test package\"\nlicense: \"MIT OR Apache-2.0\"\nrepository: \"https://example.com\"\ndeps: {{\n}}\n"
    mf: Manifest.parse("package.jet", raw) ?? panic("valid manifest should parse")
    assert_eq(mf.package.name, "myapp")
    assert_eq(mf.package.version, "1.2.3")
    assert_eq(mf.package.jet_constraint, Val(">=a0.0.43"))
    assert_eq(mf.package.description, Val("A test package"))
    assert_eq(mf.package.license, Val("MIT OR Apache-2.0"))
    assert_eq(mf.dependencies.len(), 0)
    assert_eq(mf.boundaries.len(), 0)
}

#Test("pkg integration manifest_parse_import_boundaries") {
    raw: "{pkg_integration_min_manifest("app", "0.1.0")}\nboundaries: {{\n    deny: [\n        {{ from: \"app.ui\", to: \"app.db\" }},\n        {{ from: \"app.api.*\", to: \"app.db.*\" }},\n    ],\n}}\n"
    mf: Manifest.parse("package.jet", raw) ?? panic("boundary policy should parse")
    assert_eq(mf.boundaries.len(), 2)
    assert_eq(mf.boundaries[0].from, "app.ui")
    assert_eq(mf.boundaries[0].to, "app.db")
    assert(mf.boundaries[1].matches("app.api.auth", "app.db.users"))
    assert(!mf.boundaries[1].matches("app.web", "app.db.users"))
}

// All seven invalid inputs are retained.
#Test("pkg integration manifest_parse_import_boundaries_rejects_malformed_patterns") {
    patterns: [String]{"app.ui", "app.*.ui", "app.**"}
    loop pattern in patterns {
        raw: "{pkg_integration_min_manifest("app", "0.1.0")}boundaries: {{ deny: [{{ from: {pattern}, to: \"app.db\" }}] }}\n"
        error: pkg_integration_manifest_error(raw)
        assert_eq(error.diagnostic.code, "E1215")
        assert(error.diagnostic.what.contains("package.jet"))
    }
    blocks: [String]{
        "boundaries: {{ allow: [{{ from: \"app.ui\", to: \"app.db\" }}] }}",
        "boundaries: {{ deny: [{{ to: \"app.db\" }}] }}",
        "boundaries: {{ deny: [{{ from: \"app.ui\" }}] }}",
        "boundaries: {{ deny: [{{ from: \"app.ui\", from: \"app.api\", to: \"app.db\" }}] }}"
    }
    loop block in blocks {
        error: pkg_integration_manifest_error("{pkg_integration_min_manifest("app", "0.1.0")}{block}\n")
        assert_eq(error.diagnostic.code, "E1215")
    }
}

#Test("pkg integration manifest_parse_dep_path") {
    mf: Manifest.parse("package.jet", pkg_integration_manifest_with_deps("root", "0.1.0", "    helpers: ../helpers,")) ?? panic("path dep should parse")
    dep: mf.dependencies.get("helpers") ?? panic("missing helpers dep")
    assert(dep == DepSpec.Path{path: "../helpers"})
}

#Test("pkg integration manifest_rejects_traversal_dependency_name") {
    error: pkg_integration_manifest_error(pkg_integration_manifest_with_deps("root", "0.1.0", "    ../escape: \"1.0.0\","))
    assert_eq(error.diagnostic.code, "E1215")
}

#Test("pkg integration manifest_parse_dep_git_tag") {
    mf: Manifest.parse("package.jet", pkg_integration_manifest_with_deps("root", "0.1.0", "    parsekit: {{ git: \"https://github.com/acme/parsekit\", tag: \"v0.4.1\" }},")) ?? panic("git tag dep should parse")
    dep: mf.dependencies.get("parsekit") ?? panic("missing parsekit")
    valid: if dep == {
        .Git(url, selector) -> url.contains("parsekit") && selector == GitSelector.Tag("v0.4.1")
        .Path(_) | .Registry(_) | .Foreign(_, _) -> false
    }
    assert(valid)
}

#Test("pkg integration manifest_parse_foreign_package_dep") {
    mf: Manifest.parse("package.jet", pkg_integration_manifest_with_deps("root", "0.1.0", "    plotly: js@\"plotly@npm#version=2.35.0\",")) ?? panic("foreign package dep should parse")
    assert_eq(mf.dependencies.get("plotly"), Val(DepSpec.Foreign{language: ForeignLanguage.JS, reference: "plotly@npm#version=2.35.0"}))
}

#Test("pkg integration manifest_parse_e1215_missing_required_field") {
    assert_eq(pkg_integration_manifest_error("version: \"0.1.0\"\n").diagnostic.code, "E1215")
}

// The bytes of tests/ui/manifest_unknown_field/package.jet are inlined.
#Test("pkg integration manifest_parse_e1215_unknown_field") {
    raw: "// The retired `payload:` wrapper is a normal\n// unknown-field error now — there is no second parser that still accepts it.\npayload: {{\n    name: \"myapp\",\n    version: \"0.1.0\",\n}}\n"
    error: pkg_integration_manifest_error(raw)
    assert_eq(error.diagnostic.code, "E1215")
    assert(error.diagnostic.what.contains("payload"))
}

#Test("pkg integration manifest_parse_e1209_reserved_nonempty") {
    error: pkg_integration_manifest_error("{pkg_integration_min_manifest("myapp", "0.1.0")}\ndev_deps: {{\n    testlib: ../testlib,\n}}\n")
    assert_eq(error.diagnostic.code, "E1209")
}

#Test("pkg integration manifest_parse_effects_block") {
    raw: "{pkg_integration_min_manifest("app", "0.1.0")}\nauthority: {{\n    allow: [FS, Time], deny: [Net, Panic],\n}}\n"
    pm: PackageFacts.parse(raw, "test") ?? panic("authority holds should parse")
    assert(pm.effects_enabled)
    assert_eq(pm.effects_allow, Val([String]{"FS", "Time"}))
    assert_eq(pm.effects_deny, Val([String]{"Net", "Panic"}))
}

// No weaker reuse of the existing budget test.
#Test("pkg integration manifest_panic_budget_names_the_dependency_stop_site") {
    raw: "{pkg_integration_min_manifest("app", "0.1.0")}\nauthority: {{ deny: [Panic] }}\n"
    manifest: PackageFacts.parse(raw, "test") ?? panic("Panic should be a manifest effect root")
    entries: [PackageEffects]{PackageEffects{name: "panicdep", effects: [String]{"Panic"}, effect_chains: [String: [String]]{}, effect_witnesses: [String: EffectBudgetWitness]{}, panic_sites: [String]{"panicdep::parse_port"}, boundary_span: Val(Span{start: 4, end: 12})}}
    diagnostics: pkg_effect_enforce(entries, manifest)
    assert_eq(diagnostics.len(), 1)
    assert_eq(diagnostics[0].code, "E1220")
    assert(diagnostics[0].what.contains("panicdep"))
    assert(diagnostics[0].what.contains("parse_port"))
    assert(diagnostics[0].fix.contains("fallible result"))
    assert(diagnostics[0].fix.contains("#Pre"))
    assert_eq(diagnostics[0].span, Val(Span{start: 4, end: 12}))
}

#Test("pkg integration manifest_parse_grants_block") {
    raw: "{pkg_integration_min_manifest("app", "0.1.0")}\nauthority: {{ grants: {{ \"pdf-lib\": [Net] }} }}\n"
    pm: PackageFacts.parse(raw, "test") ?? panic("grants block should parse")
    assert_eq(pm.grants, [PackageGrant]{PackageGrant{package: "pdf-lib", rights: [String]{"Net"}}})
}

#Test("pkg integration manifest_parse_authority_block_holds_grants_trust_and_providers") {
    raw: "{pkg_integration_min_manifest("app", "0.1.0")}\nauthority: {{\n    allow: [Net, DB.Read], deny: [Exec],\n    grants: {{ \"image-codec\": [FS.Read] }},\n    trust: {{ default: prompt, ci: {{ prompt: deny }}, services: {{ stripe: allow }} }},\n    providers: {{ nix: {{ registry: \"nixpkgs\", deny: [\"openssl-1.0\"] }} }},\n}}\n"
    pm: PackageFacts.parse(raw, "test") ?? panic("one authority block should parse")
    assert_eq(pm.authority.allow, Val([String]{"Net", "DB.Read"}))
    assert_eq(pm.authority.deny, Val([String]{"Exec"}))
    assert_eq(pm.authority.grants, [PackageGrant]{PackageGrant{package: "image-codec", rights: [String]{"FS.Read"}}})
    assert_eq(pm.grants, pm.authority.grants)
    assert_eq(pm.effects_allow, pm.authority.allow)
    assert_eq(pm.effects_deny, pm.authority.deny)
    trust: pm.authority.trust ?? panic("expected prompt trust")
    assert_eq(trust.default, Val(TrustDecision.Prompt))
    assert_eq(pm.authority.providers.len(), 1)
    assert_eq(pm.authority.providers[0].provider, "nix")
    assert_eq(pm.authority.providers[0].registry, "nixpkgs")
    assert_eq(pm.authority.providers[0].deny, [String]{"openssl-1.0"})
}

// Record fields inside `authority:` separate as package.jet's own fields do:
// by newline as well as by comma, so `allow`'s list ends at its `]`.
#Test("pkg integration manifest_authority_fields_separate_by_newline") {
    raw: "{pkg_integration_min_manifest("app", "0.1.0")}\nauthority: {{\n    allow: [IO, Mem.Alloc, Browser]\n    needs: [UI.IME, UI.FileDialog]\n    trust: {{\n        default: prompt\n        require: attested\n    }}\n}}\n"
    pm: PackageFacts.parse(raw, "test") ?? panic("newline-separated authority fields should parse: {err}")
    assert_eq(pm.authority.allow, Val([String]{"IO", "Mem.Alloc", "Browser"}))
    assert_eq(pm.authority.needs, [String]{"UI.IME", "UI.FileDialog"})
    trust: pm.authority.trust ?? panic("expected the trust record")
    assert_eq(trust.default, Val(TrustDecision.Prompt))
    assert_eq(trust.require, Val(ProvenanceRequirement.Attested))
}

#Test("pkg integration manifest_parse_authority_trust_block") {
    raw: "{pkg_integration_min_manifest("app", "0.1.0")}\nauthority: {{ trust: {{ default: prompt, ci: {{ prompt: deny }}, services: {{ postgres: prompt }}, require: attested }} }}\n"
    pm: PackageFacts.parse(raw, "test") ?? panic("authority.trust block should parse")
    policy: pm.authority.trust ?? panic("authority trust policy should be stored")
    assert_eq(policy.default, Val(TrustDecision.Prompt))
    assert_eq(policy.ci_prompt, Val(TrustDecision.Deny))
    assert_eq(policy.services, [ServiceTrust]{ServiceTrust{service: "postgres", decision: TrustDecision.Prompt}})
    assert_eq(policy.require, Val(ProvenanceRequirement.Attested))
}

#Test("pkg integration manifest_authority_trust_rejects_unknown_decision") {
    error: pkg_integration_package_error("{pkg_integration_min_manifest("app", "0.1.0")}\nauthority: {{ trust: {{ default: maybe }} }}\n")
    bad: if error == {
        .BadEffectsBlock(_) -> true
        .MissingName | .MissingRecord(_) | .MalformedField(_) | .UnknownField(_) | .UnknownOutputKind(_) | .InvalidValue(_, _) | .RetiredRecordHead | .ConfigMembers | .Composition(_) | .NestedMembers(_, _) | .LintPolicyCode(_, _) | .BadTarget(_, _, _) | .BadTargetField(_, _) | .ReservedSection(_) | .RetiredAuthorityField(_, _) | .BadMemoryPolicy(_) | .RetiredPolicyField(_, _) | .BadGuaranteePolicy(_) | .BadPackagePolicy(_) | .BadAllocatorPolicy(_) -> false
    }
    assert(bad)
}

#Test("pkg integration manifest_no_effects_block_disables_enforcement") {
    pm: PackageFacts.parse(pkg_integration_min_manifest("app", "0.1.0"), "test") ?? panic("valid manifest should parse")
    assert(!pm.effects_enabled)
    assert_eq(pm.effects_allow, None)
}

#Test("pkg integration manifest_parse_effects_e1221_unknown_effect") {
    raw: "{pkg_integration_min_manifest("app", "0.1.0")}\nauthority: {{ allow: [NotAnEffect] }}\n"
    error: pkg_integration_package_error(raw)
    assert_eq(pkg_integration_manifest_error(raw).diagnostic.code, "E1221")
    bad: if error == {
        .BadEffectsBlock(_) -> true
        .MissingName | .MissingRecord(_) | .MalformedField(_) | .UnknownField(_) | .UnknownOutputKind(_) | .InvalidValue(_, _) | .RetiredRecordHead | .ConfigMembers | .Composition(_) | .NestedMembers(_, _) | .LintPolicyCode(_, _) | .BadTarget(_, _, _) | .BadTargetField(_, _) | .ReservedSection(_) | .RetiredAuthorityField(_, _) | .BadMemoryPolicy(_) | .RetiredPolicyField(_, _) | .BadGuaranteePolicy(_) | .BadPackagePolicy(_) | .BadAllocatorPolicy(_) -> false
    }
    assert(bad)
}

#Test("pkg integration manifest_parse_effects_e1221_unknown_field") {
    raw: "{pkg_integration_min_manifest("app", "0.1.0")}\nauthority: {{ nope: [FS] }}\n"
    assert_eq(pkg_integration_manifest_error(raw).diagnostic.code, "E1221")
}

#Test("pkg integration manifest_toolchain_ok") {
    mf: Manifest.parse("package.jet", pkg_integration_min_manifest("myapp", "0.1.0")) ?? panic("parse manifest")
    if pkg_check_toolchain(mf, "package.jet") == {
        .Ok(_) -> {}
        .Err(_) -> panic("original required toolchain success")
    }
}

#Test("pkg integration manifest_toolchain_e1208_future_version") {
    mf: Manifest.parse("package.jet", "name: \"myapp\"\nversion: \"0.1.0\"\njet: \">=99.0.0\"\n") ?? panic("parse manifest")
    if pkg_check_toolchain(mf, "package.jet") == {
        .Err(error) -> assert_eq(error.diagnostic.code, "E1208")
        .Ok(_) -> panic("original required E1208")
    }
}

#Test("pkg integration manifest_template_plain_parses") {
    mf: Manifest.parse("package.jet", pkg_new_template("myapp", false)) ?? panic("plain template should parse")
    assert_eq(mf.package.name, "myapp")
    assert_eq(mf.package.version, "0.1.0")
    assert(mf.package.jet_constraint != None)
}

#Test("pkg integration manifest_template_annotated_has_dep_comments") {
    raw: pkg_new_template("myapp", true)
    assert(raw.contains("// Jet package dependencies:"))
    _: Manifest.parse("package.jet", raw) ?? panic("annotated template should parse")
}

#Test("pkg integration manifest_add_dep_inserts_in_existing_table") {
    raw: "{pkg_integration_min_manifest("root", "0.1.0")}\ndeps: {{\n}}\n"
    updated: pkg_add_dep(raw, "helpers", DepSpec.Path{path: "../helpers"})
    mf: Manifest.parse("package.jet", updated) ?? panic("should reparse")
    assert_eq(mf.dependencies.get("helpers"), Val(DepSpec.Path{path: "../helpers"}))
}

#Test("pkg integration manifest_add_dep_creates_table_when_absent") {
    updated: pkg_add_dep(pkg_integration_min_manifest("root", "0.1.0"), "helpers", DepSpec.Path{path: "../helpers"})
    assert(updated.contains("deps:"))
    mf: Manifest.parse("package.jet", updated) ?? panic("should reparse")
    assert_eq(mf.dependencies.get("helpers"), Val(DepSpec.Path{path: "../helpers"}))
}

#Test("pkg integration manifest_add_dep_expands_inline_empty_table") {
    raw: "{pkg_integration_min_manifest("root", "0.1.0")}\ndeps: {{}}\n"
    updated: pkg_add_dep(raw, "helpers", DepSpec.Path{path: "../helpers"})
    mf: Manifest.parse("package.jet", updated) ?? panic("inline empty deps table should stay parseable")
    assert_eq(mf.dependencies.get("helpers"), Val(DepSpec.Path{path: "../helpers"}))
    assert(updated.contains("deps: {{\n    helpers: ../helpers,\n}}\n"))
}

#Test("pkg integration manifest_remove_dep_removes_correct_entry") {
    raw: "{pkg_integration_min_manifest("root", "0.1.0")}\ndeps: {{\n    helpers: ../helpers,\n    other: ../other,\n}}\n"
    updated: pkg_remove_dep(raw, "helpers")
    mf: Manifest.parse("package.jet", updated) ?? panic("should reparse")
    assert(mf.dependencies.get("helpers") == None)
    assert(mf.dependencies.get("other") != None)
}
