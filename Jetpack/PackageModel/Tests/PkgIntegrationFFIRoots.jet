// Original parser, the FFI leaf of every foreign language (the binder table,
// checked against the FFI effect's cases), exact diagnostic count/code and one
// occurrence of each leaf; no CLI substitute.
use jet_pkg_model.[EffectBudgetWitness, PackageEffects, PackageFacts, pkg_effect_enforce, pkg_foreign_binders]

#Test("integration package FFI denial covers every language leaf") {
    source: "\nname: \"ffi_denied\"\nversion: \"0.1.0\"\nauthority: {{ deny: [FFI] }}\n"
    package: PackageFacts.parse(source, "package.jet") ?? panic("one-line FFI denial should parse")
    assert_eq(package.effects_deny, Val([String]{"FFI"}))
    leaves: loop binder in pkg_foreign_binders() -> "FFI.{binder.name}"
    entry: PackageEffects{name: "foreign-dep", effects: leaves, effect_chains: [String:[String]]{}, effect_witnesses: [String:EffectBudgetWitness]{}, panic_sites: [String]{}, boundary_span: None}
    diagnostics: pkg_effect_enforce([PackageEffects]{entry}, package)
    assert_eq(diagnostics.len(), leaves.len())
    loop diagnostic in diagnostics -> assert_eq(diagnostic.code, "E1220")
    loop leaf in leaves {
        count := 0
        loop diagnostic in diagnostics {
            // Quoted: `FFI.R` is a prefix of `FFI.Ruby`.
            if diagnostic.what.contains("`{leaf}`") -> count += 1
        }
        assert_eq(count, 1)
    }
}
