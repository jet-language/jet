    pkg_entry_test_write(root, "other.jet", "fn run() {{}}\n")
    assert_eq(pkg_entry_test_failure(&cache, files.join(root, "other.jet")).code, "E1362")
    files.remove_all(root) ?? panic("cleanup")
}

// Loader.rs:6110-6152. Filename-independent workspace declaration boundaries.
#Test("declaration resolved workspace stops both outer carrier walks") {
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("declared-boundary")
    pkg_entry_test_write(root, "package.jet", "name: \"outer\"\n")
    pkg_entry_test_write(root, "run.jet", "package {{ name: \"outer-inline\" }}\nfn run() {{}}\n")
    pkg_entry_test_write(root, "child/authority.jet", "module workspace {{ policy: {{ deny: #(FS) }} }}\n")
    pkg_entry_test_write(root, "child/src/other.jet", "fn run() {{}}\n")
    nested :: files.join(root, "child/src")
    assert((pkg_find_manifest_root_checked(&cache, nested) ?? panic("manifest walk")) == None)
    assert((pkg_find_inline_package_root_checked(&cache, nested) ?? panic("inline walk")) == None)
    assert((pkg_package_facts_for_entry(&cache, files.join(nested, "other.jet")) ?? panic("boundary entry")) == None)
    files.remove_all(root) ?? panic("cleanup")
}

#Test("ambiguous inner workspace cannot expose outer Package") {
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("ambiguous-boundary")
    pkg_entry_test_write(root, "package.jet", "name: \"outer\"\nversion: \"0.1.0\"\n")
    loop name in [String]{"a", "b"} {
        pkg_entry_test_write(root, "child/{name}.jet", "module workspace {{ policy: {{ deny: #(FS) }} }}\n")
    }
    pkg_entry_test_write(root, "child/src/other.jet", "fn run() {{}}\n")
    diagnostic :: pkg_entry_test_failure(&cache, files.join(root, "child/src/other.jet"))
    assert_eq(diagnostic.code, "E1239")
    files.remove_all(root) ?? panic("cleanup")
}

#Test("malformed canonical workspace stops outer package discovery") {
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("malformed-boundary")
    pkg_entry_test_write(root, "package.jet", "name: \"outer\"\n")
    pkg_entry_test_write(root, "child/workspace.jet", "fn ordinary() {{}}\n")
    pkg_entry_test_write(root, "child/other.jet", "fn run() {{}}\n")
    assert_eq(pkg_entry_test_failure(&cache, files.join(root, "child/other.jet")).code, "E0995")
    files.remove_all(root) ?? panic("cleanup")
}

// Loader.rs:6155-6190, package-facts portion of explicit shared authority test.
#Test("explicit shared package manifest keeps declared application authority") {
    if !sys.is_unix() -> return
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("shared-package")
    pkg_entry_test_write(root, "package.jet", "name: \"fixture\"\nversion: \"0.1.0\"\nauthority: {{ holds: {{ allow: [IO] }}, needs: [UI.FontShaping] }}\n")
    pkg_entry_test_write(root, "run.jet", "fn run() {{}}\n")
    files.set_mode(root, 0o777) ?? panic("chmod shared")
    expected :: files.canonicalize(root) ?? panic("canonical root")
    assert_eq(pkg_find_manifest_root_checked(&cache, root) ?? panic("explicit manifest"), Val(expected))
    facts :: pkg_entry_test_facts(&cache, files.join(root, "run.jet"))
    assert_eq(facts.authority.needs, [String]{"UI.FontShaping"})
    files.set_mode(root, 0o700) ?? panic("restore mode")
    files.remove_all(root) ?? panic("cleanup")
}

#Test("linked stock entry and linked manifest are refused as authority") {
    if !sys.is_unix() -> return
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("linked-carriers")
    pkg_entry_test_write(root, "target.txt", "package {{ name: \"linked\" }}\nfn run() {{}}\n")
    files.symlink(files.join(root, "target.txt"), files.join(root, "run.jet")) ?? panic("link entry")
    assert_eq(pkg_entry_test_failure(&cache, files.join(root, "run.jet")).code, "E1334")
    files.remove(files.join(root, "run.jet")) ?? panic("remove link")
    pkg_entry_test_write(root, "run.jet", "fn run() {{}}\n")
    pkg_entry_test_write(root, "manifest.txt", "name: \"linked\"\n")
    files.symlink(files.join(root, "manifest.txt"), files.join(root, "package.jet")) ?? panic("link manifest")
    assert_eq(pkg_entry_test_failure(&cache, files.join(root, "run.jet")).code, "E1334")
    files.remove_all(root) ?? panic("cleanup")
}

// tests/inline_package.rs:387-435, held metadata/no hidden host mutation.
#Test("inline symlinked Config fails without changing host state") {
    if !sys.is_unix() -> return
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("linked-config")
    source :: "package {{ name: \"symlink\", configs: [\"config.jet\"] }}\nfn run() {{}}\n"
    pkg_entry_test_write(root, "run.jet", source)
    pkg_entry_test_write(root, "outside-config.txt", "description: \"host-state\"\n")
    files.symlink(files.join(root, "outside-config.txt"), files.join(root, "config.jet")) ?? panic("link config")
    diagnostic :: pkg_entry_test_failure(&cache, files.join(root, "run.jet"))
    assert(diagnostic.code == "E1334" || diagnostic.code == "E1362")
    assert_eq(files.read(files.join(root, "outside-config.txt")) ?? panic("read target"), "description: \"host-state\"\n")
    assert((files.stat(files.join(root, "config.jet")) ?? panic("stat link")).is_symlink)
    assert_eq(files.read(files.join(root, "run.jet")) ?? panic("read source"), source)
    files.remove_all(root) ?? panic("cleanup")
}

#Test("inaccessible entry reports E1331 without becoming package absence") {
    if !sys.is_unix() -> return
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("unreadable")
    pkg_entry_test_write(root, "run.jet", "fn run() {{}}\n")
    path :: files.join(root, "run.jet")
    files.set_mode(path, 0o000) ?? panic("remove read access")
    diagnostic :: pkg_entry_test_failure(&cache, path)
    assert_eq(diagnostic.code, "E1331")
    assert_eq(diagnostic.what, "entry `{path}` cannot be read")
    assert_eq(diagnostic.fix, "restore the entry source, then retry")
    assert(diagnostic.span == None)
    files.set_mode(path, 0o600) ?? panic("restore access")
    files.remove_all(root) ?? panic("cleanup")
}

// BLOCKED #4394, intentionally retains the original exact native detail.
// This is not a relaxed authority-message assertion or a source-text test.
#Test("missing entry retains exact native E1331 detail #4394") {
    if !sys.is_linux() -> return
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("missing-native-detail")
    path :: files.join(root, "missing.jet")
    diagnostic :: pkg_entry_test_failure(&cache, path)
    assert_eq(diagnostic.code, "E1331")
    assert_eq(diagnostic.what, "entry `{path}` cannot be read")
    assert_eq(diagnostic.why, "No such file or directory (os error 2)")
    assert_eq(diagnostic.fix, "restore the entry source, then retry")
    assert(diagnostic.span == None)
    files.remove_all(root) ?? panic("cleanup")
}

// BLOCKED #4394: fs::read_to_string's original UTF-8 error must be retained
// independently of the checked carrier's valid-UTF-8 authority diagnostic.
#Test("invalid UTF8 entry retains exact E1331 read detail #4394") {
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("utf8-native-detail")
    path :: files.join(root, "run.jet")
    files.write_bytes(path, [U8]{U8{255}}) ?? panic("write invalid UTF8")
    diagnostic :: pkg_entry_test_failure(&cache, path)
    assert_eq(diagnostic.code, "E1331")
    assert_eq(diagnostic.why, "stream did not contain valid UTF-8")
    assert(diagnostic.span == None)
    files.remove_all(root) ?? panic("cleanup")
}

#Test("missing inline member cannot be silently dropped") {
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("missing-member")
    pkg_entry_test_write(root, "run.jet", "package {{ name: \"root\", members: [\"absent\"] }}\nfn run() {{}}\n")
    assert_eq(pkg_entry_test_failure(&cache, files.join(root, "run.jet")).code, "E1362")
    files.remove_all(root) ?? panic("cleanup")
}

#Test("duplicate inline member names are refused rather than merged") {
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("duplicate-member")
    pkg_entry_test_write(root, "run.jet", "package {{ name: \"root\", members: [\"one\", \"two\"] }}\nfn run() {{}}\n")
    loop name in [String]{"one", "two"} {
        pkg_entry_test_write(root, "{name}/package.jet", "name: \"same\"\n")
    }
    diagnostic :: pkg_entry_test_failure(&cache, files.join(root, "run.jet"))
    assert_eq(diagnostic.code, "E1362")
    assert(diagnostic.why.contains("declared more than once"))
    files.remove_all(root) ?? panic("cleanup")
}

#Test("held entry identity is revalidated rather than reopened for new bytes") {
    root :: pkg_entry_test_root("held-source")
    pkg_entry_test_write(root, "run.jet", "package {{ name: \"held\" }}\nfn run() {{}}\n")
    resolver :: AuthorityResolver.open(root) ?? panic("open authority")
    held :: resolver.checked_file("run.jet") ?? panic("hold entry")
    files.remove(files.join(root, "run.jet")) ?? panic("unlink held path")
    pkg_entry_test_write(root, "run.jet", "package {{ name: \"replacement\" }}\nfn run() {{}}\n")
    if pkg_package_facts_from_checked_entry(resolver, held, held.path, None) == {
        .Err(error) -> assert_eq(error.diagnostic.code, "E1334")
        .Ok(_) -> panic("replacement bytes must not become the held source")
    }
    files.remove_all(root) ?? panic("cleanup")
}

#Test("entry carrier discovery reuses one workspace declaration cache") {
    cache := WorkspaceDeclarationCache.new()
    root :: pkg_entry_test_root("cache-session")
    pkg_entry_test_write(root, "run.jet", "package {{ name: \"cached\" }}\nfn run() {{}}\n")
    pkg_entry_test_write(root, "other.jet", "fn other() {{}}\n")
    assert_eq(pkg_entry_test_facts(&cache, files.join(root, "other.jet")).name, "cached")
    first :: cache.lexes
    assert(first > 0)
    assert_eq(pkg_entry_test_facts(&cache, files.join(root, "other.jet")).name, "cached")
    assert_eq(cache.lexes, first)
    files.remove_all(root) ?? panic("cleanup")
}
