// Claims ported from crates/jet-pkg-model/src/OpaqueHandleBinder.rs #[cfg(test)].

#Test("discovers a zlib style typedef and close") {
    discovered :: OpaqueHandleDiscovery.discover("typedef struct gzFile_s *gzFile; gzFile gzopen(const char *path, const char *mode); int gzclose(gzFile file);", "zlib", HandleOverlay.empty())
    assert_eq(discovered.handles.len(), 1)
    handle :: discovered.handles[0]
    assert_eq(handle.typedef_name, "gzFile")
    assert_eq(handle.jet_name, "GzFile")
    assert_eq(handle.close, "gzclose")
    assert_eq(handle.close_source, CloseSource.Conventional)
}

#Test("discovers a harfbuzz style forward struct") {
    discovered :: OpaqueHandleDiscovery.discover("typedef struct hb_buffer_t hb_buffer_t; hb_buffer_t *hb_buffer_create(void); void hb_buffer_destroy(hb_buffer_t *buffer);", "harfbuzz", HandleOverlay.empty())
    assert_eq(discovered.handles[0].jet_name, "HbBuffer")
    assert_eq(discovered.handles[0].close, "hb_buffer_destroy")
}

#Test("ambiguous close requires an overlay") {
    source :: "typedef struct thing_t thing_t; thing_t *thing_create(void); void thing_destroy(thing_t *x); void thing_free(thing_t *x);"
    unresolved :: OpaqueHandleDiscovery.discover(source, "thing", HandleOverlay.empty())
    assert_eq(unresolved.handles.len(), 0)
    assert(unresolved.unresolved[0].reason.contains("ambiguous"))
    resolved :: OpaqueHandleDiscovery.discover(source, "thing", HandleOverlay.empty().with_close("thing_t", "thing_destroy"))
    assert_eq(resolved.handles[0].close, "thing_destroy")
    assert_eq(resolved.handles[0].close_source, CloseSource.Overlay)
}

#Test("no thread or link fact is inferred") {
    discovered :: OpaqueHandleDiscovery.discover("typedef struct thing_t thing_t; thing_t *thing_new(void); void thing_destroy(thing_t *x);", "thing", HandleOverlay.empty())
    assert_eq(discovered.handles[0].thread_safety, ThreadSafety.Unspecified)
    assert_eq(discovered.handles[0].link_closure.libraries(), [String]{"thing"})
}
