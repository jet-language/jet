// Source-store contracts; all filesystem fixtures have explicit held scratch
// parents, so these tests do not alter the user's default source store.
use {
    jet_pkg_model.[
        pkg_source_snapshot_into,
        pkg_source_store_component,
        pkg_source_store_path,
        pkg_source_store_verify,
        pkg_source_store_view_into_project,
    ]
    jetpack_foundation.[
        foundation_open_directory_authority,
        foundation_read_file_nofollow_at_root,
        foundation_tree_hash,
    ]
    files: core.files
    process: core.process
    sys: core.sys
}

pkg_source_store_test_root: fn(label: String) -[FS, Env]> String Never! {
    root: files.join(sys.temp_dir(), "jet-source-store-{label}-{process.current_pid()}")
    files.remove_all(root).drop("a stale fixture may be absent")
    files.create_dir_all(root) ?? panic("create fixture")
    root
}

#Test("source-store components reject path syntax and all C0/C1 controls") {
    next_line: String.from_bytes([U8]{194, 133}) ?? panic("valid C1 scalar")
    loop value in
        ([String]{"", ".", "..", "../pkg", "pkg/name", "pkg\\name", "pkg:version", "pkg\nname", "pkg{next_line}name"}) {
        assert(pkg_source_store_component(value) == .Err(_))
    }
    loop value in ([String]{"jet", "1.2.3-dev+build", "abcdef0123456789", "工具"}) {
        assert(pkg_source_store_component(value) == .Ok(_))
    }
}

#Test("held source copies preserve empty directories and hash the exact copied bytes") {
    root: pkg_source_store_test_root("copy")
    source_path: files.join(root, "source")
    target_path: files.join(root, "target-copy")
    files.create_dir_all(files.join(source_path, "empty")) ?? panic("empty source directory")
    files.create_dir_all(files.join(source_path, "nested")) ?? panic("nested source directory")
    files.write(files.join(source_path, "nested/main.jet"), "run: fn() {{ 42 }}\n") ?? panic("source file")
    files.write(files.join(source_path, ".ignored"), "not hashed") ?? panic("ignored file")
    source: foundation_open_directory_authority(source_path) ?? panic("hold source")
    target: foundation_open_directory_authority(target_path, true) ?? panic("hold target")
    target.copy_tree_from(source) ?? panic("copy held source")
    assert(files.is_dir(files.join(target_path, "empty")))
    assert(!files.exists(files.join(target_path, ".ignored")))
    expected: source.tree_hash(true) ?? panic("source hash")
    actual: target.tree_hash() ?? panic("copied hash")
    assert_eq(actual, expected)
    assert_eq(actual, foundation_tree_hash(target_path))
    assert_eq((files.stat(files.join(target_path, "nested/main.jet")) ?? panic("copied stat")).mode.bit_and(511), 384)
    files.remove_all(root) ?? panic("fixture cleanup")
}

#Test("source snapshots consume staged bytes after the mutable source changes and clean up") {
    root: pkg_source_store_test_root("snapshot")
    source_path: files.join(root, "source")
    snapshots_path: files.join(root, "snapshots")
    files.create_dir_all(source_path) ?? panic("source directory")
    files.write(files.join(source_path, "main.jet"), "before") ?? panic("source bytes")
    source: foundation_open_directory_authority(source_path) ?? panic("hold source")
    snapshots: foundation_open_directory_authority(snapshots_path, true) ?? panic("hold snapshots")
    snapshot: pkg_source_snapshot_into(source, snapshots) ?? panic("snapshot")
    path: snapshot.path()
    files.write(files.join(source_path, "main.jet"), "after") ?? panic("change source")
    bytes: foundation_read_file_nofollow_at_root(path, "main.jet", 1024) ?? panic("read snapshot")
    assert_eq(bytes, "before".bytes())
    assert_eq(snapshot.content_hash, snapshot.directory.tree_hash() ?? panic("snapshot hash"))
    close(snapshot)
    assert(!files.exists(path))
    files.remove_all(root) ?? panic("fixture cleanup")
}

#Test("source snapshots refuse links even when the link name is ignored and remove failed stages") {
    if sys.is_unix() {
        root: pkg_source_store_test_root("links")
        source_path: files.join(root, "source")
        snapshots_path: files.join(root, "snapshots")
        files.create_dir_all(source_path) ?? panic("source directory")
        files.write(files.join(root, "external"), "external") ?? panic("external bytes")
        files.symlink(files.join(root, "external"), files.join(source_path, ".ignored")) ?? panic("symlink fixture")
        source: foundation_open_directory_authority(source_path) ?? panic("hold source")
        assert(pkg_source_snapshot_into(source, foundation_open_directory_authority(snapshots_path, true) ?? panic("hold snapshots")) == .Err(_))
        assert_eq((files.list_dir(snapshots_path) ?? panic("failed stage list")).len(), 0)
        files.remove(files.join(source_path, ".ignored")) ?? panic("remove symlink")
        files.hard_link(files.join(root, "external"), files.join(source_path, ".ignored")) ?? panic("hardlink fixture")
        assert(pkg_source_snapshot_into(source, foundation_open_directory_authority(snapshots_path, true) ?? panic("hold snapshots")) == .Err(_))
        assert_eq((files.list_dir(snapshots_path) ?? panic("failed stage list")).len(), 0)
        files.remove_all(root) ?? panic("fixture cleanup")
    }
}

#Test("project dependency views are verified copies that keep a match and replace a stale view") {
    root: pkg_source_store_test_root("project-view")
    source_path: files.join(root, "source")
    source_file: files.join(source_path, "main.jet")
    view_path: files.join(root, "project/deps/pkg")
    view_file: files.join(view_path, "main.jet")
    files.create_dir_all(files.join(source_path, "empty")) ?? panic("source empty directory")
    files.write(source_file, "immutable source") ?? panic("source bytes")
    assert(!(pkg_source_store_view_into_project(source_path, view_path) ?? panic("publish project view")))
    assert(files.is_dir(files.join(view_path, "empty")))
    assert_eq(files.read_bytes(view_file) ?? panic("view bytes"), "immutable source".bytes())
    assert_eq((files.stat(source_file) ?? panic("store stat")).links, 1)
    assert_eq((files.stat(view_file) ?? panic("view stat")).links, 1)
    // A matching view is kept: the same file, not a rewrite.
    kept: files.stat(view_file) ?? panic("kept stat")
    assert(!(pkg_source_store_view_into_project(source_path, view_path) ?? panic("keep matching project view")))
    assert_eq((files.stat(view_file) ?? panic("kept again")).id, kept.id)
    // A view with different bytes is replaced by a verified copy.
    files.write(view_file, "different") ?? panic("stale bytes")
    assert(pkg_source_store_view_into_project(source_path, view_path) ?? panic("replace stale project view"))
    assert_eq(files.read_bytes(view_file) ?? panic("replaced bytes"), "immutable source".bytes())
    // An older linked view shares the store file; replacing it restores the
    // store file's single link.
    files.remove(view_file) ?? panic("unlink view file")
    files.hard_link(source_file, view_file) ?? panic("linked view fixture")
    assert_eq((files.stat(source_file) ?? panic("linked store stat")).links, 2)
    assert(pkg_source_store_view_into_project(source_path, view_path) ?? panic("replace linked project view"))
    assert_eq((files.stat(source_file) ?? panic("restored store stat")).links, 1)
    assert_eq((files.stat(view_file) ?? panic("copied view stat")).links, 1)
    // Neither the stage nor the swapped-out view is left beside the view.
    assert_eq((files.list_dir(files.join(root, "project/deps")) ?? panic("deps list")).len(), 1)
    files.remove_all(root) ?? panic("fixture cleanup")
}

// A store entry is named <name>-<version>-<fingerprint without sha256->.
#Test("store_path_format_name_version_fp") {
    assert_eq(files.basename(pkg_source_store_path("mylib", "1.0.0", "sha256-deadbeef")), "mylib-1.0.0-deadbeef")
}

#Test("store_path_strips_sha256_prefix") {
    assert_eq(pkg_source_store_path("mylib", "1.0.0", "sha256-deadbeef"), pkg_source_store_path("mylib", "1.0.0", "deadbeef"))
}

// A store entry edited after install fails verification with E1204. The entry
// is written under a held scratch root instead of installing into the user's
// default store.
#Test("content_hash_mismatch_after_tamper") {
    root: pkg_source_store_test_root("tamper")
    entry: files.join(root, "mylib-0.1.0-bbbb")
    files.create_dir_all(entry) ?? panic("entry directory")
    files.write(files.join(entry, "lib.jet"), "x: fn() {{}}\n") ?? panic("entry source")
    files.write(files.join(entry, "package.jet"), "name: \"mylib\"\nversion: \"0.1.0\"\n") ?? panic("entry manifest")
    original: (foundation_open_directory_authority(entry) ?? panic("hold entry")).tree_hash() ?? panic("entry hash")
    pkg_source_store_verify("mylib", entry, original) ?? panic("a fresh entry verifies: {err.diagnostic.what}")
    files.write(files.join(entry, "lib.jet"), "evil: fn() {{}}\n") ?? panic("tamper")
    if pkg_source_store_verify("mylib", entry, original) == {
        .Err(error) -> { assert_eq(error.diagnostic.code, "E1204") }
        .Ok(_) -> panic("a tampered entry must fail verification")
    }
    files.remove_all(root) ?? panic("fixture cleanup")
}
