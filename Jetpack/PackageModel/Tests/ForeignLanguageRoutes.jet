// Ports of the foreign language registry and route tests from the deleted
// tests/cffi.rs (#6096 cffi-language-routes, cffi-namespace-model).
//
// The Rust route plan (`jet::Foreign::route_plan`) paired the descriptor with a
// `ForeignHost` and the binding cache, type-stub and provenance paths. In Jet the
// canonical descriptor table (pkg_foreign_binders) is the only routing record:
// the runtime names the host, `cache_extension` and `type_stub_file` name the
// generated files under `ForeignLanguage.bindings_subdir()`. There is no separate
// host enum or path planner, so the ports assert those descriptor fields.
use jet_pkg_model.[
    BinderRuntime, BinderStatus, BinderSurface, BindingStubKind, ForeignLanguage, ForeignStubFile,
    pkg_binder_descriptor,
]

fn flr_route(root: String, language: ForeignLanguage, status: BinderStatus, runtime: BinderRuntime, stub_kind: BindingStubKind, type_stub: ForeignStubFile) {
    found :: ForeignLanguage.from_root(root) ?? panic("{root} is a registered foreign root")
    assert(found == language, "{root} routes to {language.debug_name()}, found {found.debug_name()}")
    descriptor :: pkg_binder_descriptor(language) ?? panic("{root} has a registered binder")
    assert(descriptor.language == language, "{root} descriptor language")
    assert(descriptor.surface == BinderSurface.Namespace, "{root} binds a namespace")
    assert_eq(descriptor.status.debug_name(), status.debug_name())
    assert_eq(descriptor.runtime.debug_name(), runtime.debug_name())
    assert_eq(descriptor.stub_kind.debug_name(), stub_kind.debug_name())
    assert_eq(descriptor.cache_extension, "jet")
    assert_eq(descriptor.type_stub_file.debug_name(), type_stub.debug_name())
    assert_eq(language.bindings_subdir(), "bindings/{root}")
}

// tests/cffi.rs:488
#Test("unified_foreign_binder_registry_routes_active_and_planned_languages") {
    expected :: [(language: ForeignLanguage, root: String, status: BinderStatus)]{
        (language: ForeignLanguage.C, root: "c", status: BinderStatus.Active),
        (language: ForeignLanguage.Rust, root: "rust", status: BinderStatus.Planned),
        (language: ForeignLanguage.Py, root: "py", status: BinderStatus.Active),
        (language: ForeignLanguage.JS, root: "js", status: BinderStatus.Active),
        (language: ForeignLanguage.Swift, root: "swift", status: BinderStatus.Planned),
        (language: ForeignLanguage.Fortran, root: "fortran", status: BinderStatus.Active),
        (language: ForeignLanguage.Cobol, root: "cobol", status: BinderStatus.Active),
        (language: ForeignLanguage.Java, root: "java", status: BinderStatus.Active),
        (language: ForeignLanguage.DotNet, root: "cs", status: BinderStatus.Active),
        (language: ForeignLanguage.Tcl, root: "tcl", status: BinderStatus.Active),
        (language: ForeignLanguage.Ada, root: "ada", status: BinderStatus.Active),
        (language: ForeignLanguage.Pascal, root: "pascal", status: BinderStatus.Active),
        (language: ForeignLanguage.Dart, root: "dart", status: BinderStatus.Active),
        (language: ForeignLanguage.PowerShell, root: "pwsh", status: BinderStatus.Active),
        (language: ForeignLanguage.Perl, root: "perl", status: BinderStatus.Active),
        (language: ForeignLanguage.Ruby, root: "ruby", status: BinderStatus.Active),
        (language: ForeignLanguage.Php, root: "php", status: BinderStatus.Active),
        (language: ForeignLanguage.R, root: "r", status: BinderStatus.Active),
        (language: ForeignLanguage.Octave, root: "octave", status: BinderStatus.Active),
        (language: ForeignLanguage.Com, root: "com", status: BinderStatus.Active),
    }
    loop entry in expected {
        found :: ForeignLanguage.from_root(entry.root) ?? panic("{entry.root} is a registered root")
        assert(found == entry.language, "{entry.root} maps to {entry.language.debug_name()}")
        assert_eq(entry.language.root(), entry.root)
        assert_eq(entry.language.bindings_subdir(), "bindings/{entry.root}")
        binder :: pkg_binder_descriptor(entry.language) ?? panic("{entry.root} has a registered binder")
        assert(binder.surface == BinderSurface.Namespace, "{entry.root} binds a namespace")
        assert_eq(binder.status.debug_name(), entry.status.debug_name())
    }
}

// tests/cffi.rs:646. Not ported: `ForeignNamespace::from_module_path` and its
// display round trip; Jet has no dotted foreign-path model beside the root
// table, so the port checks the root table and its declaration order.
#Test("unified_foreign_namespace_model_recognizes_every_registered_root") {
    roots :: [(root: String, language: ForeignLanguage)]{
        (root: "c", language: ForeignLanguage.C),
        (root: "cpp", language: ForeignLanguage.Cpp),
        (root: "rust", language: ForeignLanguage.Rust),
        (root: "py", language: ForeignLanguage.Py),
        (root: "js", language: ForeignLanguage.JS),
        (root: "swift", language: ForeignLanguage.Swift),
        (root: "go", language: ForeignLanguage.Go),
        (root: "java", language: ForeignLanguage.Java),
        (root: "cs", language: ForeignLanguage.DotNet),
        (root: "tcl", language: ForeignLanguage.Tcl),
        (root: "lua", language: ForeignLanguage.Lua),
        (root: "fortran", language: ForeignLanguage.Fortran),
        (root: "cobol", language: ForeignLanguage.Cobol),
        (root: "ada", language: ForeignLanguage.Ada),
        (root: "pascal", language: ForeignLanguage.Pascal),
        (root: "dart", language: ForeignLanguage.Dart),
        (root: "pwsh", language: ForeignLanguage.PowerShell),
        (root: "perl", language: ForeignLanguage.Perl),
        (root: "ruby", language: ForeignLanguage.Ruby),
        (root: "php", language: ForeignLanguage.Php),
        (root: "r", language: ForeignLanguage.R),
        (root: "octave", language: ForeignLanguage.Octave),
        (root: "com", language: ForeignLanguage.Com),
    }
    all :: ForeignLanguage.all()
    assert_eq(all.len(), roots.len())
    loop (index, entry) in roots {
        assert(all[index] == entry.language, "ForeignLanguage.all() keeps {entry.root} at {index}")
        found :: ForeignLanguage.from_root(entry.root) ?? panic("{entry.root} namespace")
        assert(found == entry.language, "{entry.root} maps to {entry.language.debug_name()}")
        assert(ForeignLanguage.from_root("{entry.root}.lib") == None, "{entry.root}.lib is not a root")
    }
    assert(ForeignLanguage.from_root("unknown") == None, "unknown is not a foreign root")
}

// tests/cffi.rs:692: every registered root, planned ones included, through the
// shared selective-import check of ForeignSelectiveImport.jet (which covers the
// active binders for tests/lib_use.rs).
#Test("foreign_namespace_selective_imports_reuse_ordinary_parser_path") {
    loop language in ForeignLanguage.all() -> pkg_test_selective_import(language)
}

// tests/cffi.rs:980. Not ported: ForeignHost NativeJsWasmComponent/BrowserJsEngine
// per ForeignTarget (no host enum in Jet; TargetDispatchedJs is the route).
#Test("foreign_interop_routes_js_with_target_dispatched_host_and_dts_stub") {
    flr_route("js", ForeignLanguage.JS, BinderStatus.Active, BinderRuntime.TargetDispatchedJS, BindingStubKind.TypeScriptDeclarations, ForeignStubFile.Suffix("d.ts"))
}

