// Rust: crates/jet-pkg-model/src/FFI.rs:1818
// Native socket/TLS/thread/atomic primitives retain their names: GATE #4494.
use Jetpack.PackageModel.Source.Foreign.RustBridge.FFITests.*
use std.net.[TcpListener, SocketAddr]
use std.sync.[Arc, Mutex]
use std.thread.[JoinHandle, spawn, sleep]
use std.sync.atomic.Ordering
use std.time.Duration
use rustls.[ServerConnection, StreamOwned]
use core.email as email
use core.email as smtp_adapter
use sha2.[Sha256]
use ed25519_dalek.[SigningKey, Signature]

// Rust: crates/jet-pkg-model/src/FFI.rs:1818
fn spawn_smtp_server(starttls: Bool, fixture: SMTPFixture) -> (SocketAddr, Arc[Mutex[[String]]], JoinHandle[Unit]) {
    listener :: TcpListener.bind("127.0.0.1:0").unwrap() // GATE #4494
    address :: listener.local_addr().unwrap()
    transcript :: Arc.new(Mutex.new([String]{}))
    server_transcript :: transcript.clone()
    config :: smtp_server_config()
    server :: spawn(() -> {
        (socket, _) := listener.accept().unwrap()
        if starttls {
            socket.write_all("220 relay ready\r\n".bytes()).unwrap()
            socket.flush().unwrap()
            ehlo :: smtp_read_line(&socket)
            server_transcript.lock().unwrap().push(ehlo)
            socket.write_all("250-relay\r\n250-STARTTLS\r\n250 AUTH PLAIN LOGIN\r\n".bytes()).unwrap()
            socket.flush().unwrap()
            command :: smtp_read_line(&socket)
            server_transcript.lock().unwrap().push(command.clone())
            assert_eq(command, "STARTTLS\r\n")
            socket.write_all("220 begin TLS\r\n".bytes()).unwrap()
            socket.flush().unwrap()
        }
        conn :: ServerConnection.new(config).unwrap()
        tls := StreamOwned.new(conn, socket)
        loop tls.conn.is_handshaking() {
            if tls.conn.complete_io(&tls.sock).is_err() -> return
        }
        smtp_tls_session(&tls, !starttls, fixture, &server_transcript)
    })
    (address, transcript, server)
}

// Rust: crates/jet-pkg-model/src/FFI.rs:1860
fn smtp_message() -> email.Message {
    from :: email.address("sender@example.com").unwrap()
    to :: email.address("recipient@example.net").unwrap()
    email.message(&from, &[email.Address]{to}, &[email.Address]{}, "subject", "first\r\n.second", "", &[email.Attachment]{}).unwrap()
}

// Rust: crates/jet-pkg-model/src/FFI.rs:1876
fn smtp_config(port: U16, starttls: Bool) -> email.SMTPConfig[[U8]] {
    email.SMTPConfig{
        host: "localhost",
        port: port as I64,
        security: if starttls -> email.SMTPSecurity.StartTLS else -> email.SMTPSecurity.TLS,
        auth: email.SMTPAuth.Password{username: "mailer", password: "swordfish".bytes()},
        recipient_policy: email.RecipientPolicy.RequireAll,
        trust: email.TLSTrust.SystemPlusCa{pem: prep { embed_file("../../../tests/fixtures/tls/smtp.ca.cert.pem").bytes() }},
        limits: email.Limits.safe(),
        dkim: Err(smtp_adapter.JetAbsent)
    }
}

// Rust: crates/jet-pkg-model/src/FFI.rs:1899
fn test_base64_decode(text: String) -> [U8] {
    value :: (byte: U8) -> if byte == {
        65..=90 -> byte - 65
        97..=122 -> byte - 97 + 26
        48..=57 -> byte - 48 + 52
        43 -> 62
        47 -> 63
        else -> 0
    }
    bytes :: text.bytes().filter(byte -> !byte.is_ascii_whitespace()).collect()
    out := [U8]{}
    loop chunk in bytes.chunks_exact(4) {
        values :: [U8]{value(chunk[0]), value(chunk[1]), value(chunk[2]), value(chunk[3])}
        &out.push((values[0] << 2) | (values[1] >> 4))
        if chunk[2] != 61 -> &out.push((values[1] << 4) | (values[2] >> 2))
        if chunk[3] != 61 -> &out.push((values[2] << 6) | values[3])
    }
    out
}

// Rust: crates/jet-pkg-model/src/FFI.rs:1931
fn test_relaxed_header(header: String) -> String {
    (name, value) :: header.split_once(':').unwrap()
    unfolded :: value.replace("\r\n ", " ").replace("\r\n\t", " ")
    value :: unfolded.split_ascii_whitespace().collect().join(" ")
    "{name.to_ascii_lowercase()}:{value}\r\n"
}

// Rust: crates/jet-pkg-model/src/FFI.rs:1941
fn verify_dkim_wire(wire: String, seed: [U8; 32]) -> {
    boundary :: wire.find("\r\n\r\n").unwrap()
    headers :: wire[..boundary]
    body :: wire[boundary + 4..]
    first_end := 0
    loop (index, line) in headers.split("\r\n").enumerate() {
        if index != 0 && !line.starts_with([' ', '\t']) -> break
        first_end += line.len() + 2
    }
    dkim_header :: headers[..first_end - 2]
    unfolded :: dkim_header.replace("\r\n ", " ")
    tags := [String: String]{}
    loop tag in unfolded.split_once(':').unwrap().1.split(';') {
        trimmed := tag.trim() // #4303
        if trimmed.split_once('=') == .Val((name, value)) -> tags[name] = value
    }
    assert_eq(tags["a"], "ed25519-sha256")
    assert_eq(tags["c"], "relaxed/relaxed")
    assert_eq(tags["d"], "example.com")
    assert_eq(tags["s"], "login-2026")
    body_lines := body.split("\r\n").collect()
    loop body_lines.last().is_some_and(line -> line.trim_end_matches([' ', '\t']).is_empty()) {
        _ :: &body_lines.pop()
    }
    canonical_body :: if body_lines.is_empty() -> "\r\n" else -> body_lines.map(line -> line.trim_end_matches([' ', '\t'])).collect().join("\r\n") + "\r\n"
    body_hash: [U8; 32] :: Sha256.digest(canonical_body.bytes()).into() // GATE #4494
    assert_eq(test_base64_decode(tags["bh"]), body_hash)
    signing_input := String.new()
    loop wanted in tags["h"].split(':') {
        header :: headers.rsplit("\r\n").find(line -> line.split_once(':').is_some_and((name, _) -> name.eq_ignore_ascii_case(wanted))).unwrap()
        &signing_input.push_str(test_relaxed_header(header))
    }
    empty_b :: "{unfolded.split("b=").next().unwrap()}b="
    &signing_input.push_str(test_relaxed_header(empty_b))
    signature: [U8; 64] :: test_base64_decode(tags["b"]).try_into().unwrap()
    header_hash: [U8; 32] :: Sha256.digest(signing_input.bytes()).into()
    SigningKey.from_bytes(&seed).verifying_key().verify_strict(&header_hash, &Signature.from_bytes(&signature)).unwrap() // GATE #4494
}

// Rust: crates/jet-pkg-model/src/FFI.rs:2013
#Test("mailer_real_tls_starttls_cancellation_deadline_and_unknown_boundaries") {
    SMTP_CANCELLED.store(false, Ordering.SeqCst) // GATE #4494
    SMTP_DEADLINE_MS.store(I64.MAX, Ordering.SeqCst)
    loop starttls in [false, true] {
        (address, transcript, server) :: spawn_smtp_server(starttls, SMTPFixture.Success)
        config :: smtp_config(address.port(), starttls)
        mailer := email.smtp(&config, secret -> secret.clone(), smtp_runtime()).unwrap()
        report :: mailer.send(smtp_message()).unwrap()
        assert_eq((report.response_code, report.accepted.len(), report.rejected.len()), (250, 1, 0))
        server.join().unwrap()
        transcript :: transcript.lock().unwrap().join("")
        assert_eq(transcript.matches("DATA\r\n").count(), 1)
        assert(!transcript.contains("swordfish"))
        if starttls -> assert(transcript.contains("STARTTLS\r\nEHLO localhost\r\n"))
    }
    (address, transcript, server) :: spawn_smtp_server(false, SMTPFixture.CloseAfterData)
    config :: smtp_config(address.port(), false)
    mailer := email.smtp(&config, secret -> secret.clone(), smtp_runtime()).unwrap()
    if mailer.send(smtp_message()) == {
        .Err(email.Error.DeliveryUnknown{..}) -> {}
        else -> panic("expected DeliveryUnknown")
    }
    server.join().unwrap()
    assert_eq(transcript.lock().unwrap().join("").matches("DATA\r\n").count(), 1)
    (address, _, server) :: spawn_smtp_server(false, SMTPFixture.RejectAuth)
    config :: smtp_config(address.port(), false)
    mailer := email.smtp(&config, secret -> secret.clone(), smtp_runtime()).unwrap()
    auth_error :: mailer.send(smtp_message()).unwrap_err()
    if auth_error == {
        email.Error.Auth{..} -> {}
        else -> panic("expected Auth")
    }
    assert(!"{auth_error:?}".contains("swordfish"))
    server.join().unwrap()
    (address, _, server) :: spawn_smtp_server(false, SMTPFixture.StallGreeting)
    config :: smtp_config(address.port(), false)
    mailer := email.smtp(&config, secret -> secret.clone(), smtp_runtime()).unwrap()
    cancel :: spawn(() -> {
        sleep(Duration.from_millis(60)) // GATE #4494
        SMTP_CANCELLED.store(true, Ordering.SeqCst)
    })
    if mailer.send(smtp_message()) == {
        .Err(email.Error.Cancelled{..}) -> {}
        else -> panic("expected Cancelled")
    }
    cancel.join().unwrap()
    server.join().unwrap()
    SMTP_CANCELLED.store(false, Ordering.SeqCst)
    (address, _, server) :: spawn_smtp_server(false, SMTPFixture.StallGreeting)
    SMTP_DEADLINE_MS.store(smtp_now_ms() + 60, Ordering.SeqCst)
    config :: smtp_config(address.port(), false)
    mailer := email.smtp(&config, secret -> secret.clone(), smtp_runtime()).unwrap()
    if mailer.send(smtp_message()) == {
        .Err(email.Error.TimedOut{..}) -> {}
        else -> panic("expected TimedOut")
    }
    server.join().unwrap()
    SMTP_DEADLINE_MS.store(I64.MAX, Ordering.SeqCst)
}

// Rust: crates/jet-pkg-model/src/FFI.rs:2093
#Test("mailer_dkim_signs_final_wire_with_real_ed25519_verifier") {
    seed :: [U8; 32].filled(7)
    wires := [String]{}
    loop _ in 0..<2 {
        (address, transcript, server) :: spawn_smtp_server(false, SMTPFixture.Success)
        config := smtp_config(address.port(), false)
        config.dkim = Ok(email.DkimConfig{
            domain: "example.com", selector: "login-2026", private_key: seed.to_vec(),
            signed_headers: [String]{"from", "to", "subject", "mime-version", "content-type", "content-transfer-encoding"}
        })
        mailer := email.smtp(&config, secret -> secret.clone(), smtp_runtime()).unwrap()
        mailer.send(smtp_message()).unwrap()
        server.join().unwrap()
        transcript :: transcript.lock().unwrap()
        stuffed :: transcript.iter().find(part -> part.starts_with("DKIM-Signature:")).unwrap()
        &wires.push(stuffed.strip_suffix(".\r\n").unwrap().replace("\r\n..", "\r\n."))
    }
    assert_eq(wires[0], wires[1], "DKIM ordering and folding must be deterministic")
    verify_dkim_wire(wires[0], seed)
    relaxed_variant := wires[0].replace("\r\nFrom: ", "\r\nfRoM:\t  ")
    body :: relaxed_variant.find("\r\n\r\n").unwrap() + 4
    first_body_line :: relaxed_variant[body..].find("\r\n").unwrap() + body
    &relaxed_variant.insert_str(first_body_line, " \t")
    verify_dkim_wire(relaxed_variant, seed)
    assert(wires[0].starts_with("DKIM-Signature: v=1; a=ed25519-sha256; c=relaxed/relaxed;\r\n"))
}

// Rust: crates/jet-pkg-model/src/FFI.rs:2147
#Test("mailer_dkim_rejects_before_connect_and_wipes_every_key_copy") {
    SMTP_WIPES.store(0, Ordering.SeqCst) // GATE #4494
    config := smtp_config(465, false)
    config.dkim = Ok(email.DkimConfig{domain: "example.com", selector: "login-2026", private_key: [U8].filled(31, 0x5a), signed_headers: [String]{"from"}})
    error :: if email.smtp(&config, secret -> secret.clone(), smtp_counting_runtime()) == {
        .Err(error) -> error
        .Ok(_) -> panic("31-byte DKIM seed was accepted")
    }
    if error == {
        email.Error.Configuration{operation, reason, ..} -> {
            assert_eq(operation, "dkim")
            assert_eq(reason, "private_key must contain exactly 32 bytes")
        }
        else -> panic("expected Configuration")
    }
    assert(!"{error:?}".contains("5a5a"))
    assert_eq(SMTP_WIPES.load(Ordering.SeqCst), 2, "construction failure must wipe copied SMTP password and DKIM seed")
    config.dkim.as_mut().unwrap().private_key.push(0x5a)
    mailer :: email.smtp(&config, secret -> secret.clone(), smtp_counting_runtime()).unwrap()
    drop(^mailer)
    assert_eq(SMTP_WIPES.load(Ordering.SeqCst), 4, "Mailer drop must wipe owned SMTP password and DKIM seed")
    config.dkim.as_mut().unwrap().signed_headers.push("x-absent")
    mailer := email.smtp(&config, secret -> secret.clone(), smtp_counting_runtime()).unwrap()
    error :: mailer.send(smtp_message()).unwrap_err()
    if error == {
        email.Error.Configuration{operation, reason, ..} -> {
            assert_eq(operation, "dkim")
            assert(reason.contains("x-absent") && reason.contains("absent"))
        }
        else -> panic("expected Configuration")
    }
    drop(^mailer)
    assert_eq(SMTP_WIPES.load(Ordering.SeqCst), 6)
}

// Rust: crates/jet-pkg-model/src/FFI.rs:2200
#Test("smtp_from_env_dkim_is_all_or_none_and_redacted") {
    guard :: SMTP_ENV_LOCK.lock().unwrap() // GATE #4494
    defer drop(^guard)
    loop name in [String]{"SMTP_DKIM_DOMAIN", "SMTP_DKIM_SELECTOR", "SMTP_DKIM_PRIVATE_KEY_BASE64", "SMTP_DKIM_SIGNED_HEADERS"} -> std.env.remove_var(name)
    std.env.set_var("SMTP_HOST", "localhost")
    std.env.set_var("SMTP_SECURITY", "tls")
    std.env.set_var("SMTP_PORT", "465")
    std.env.set_var("SMTP_DKIM_DOMAIN", "example.com")
    partial :: if email.smtp_from_env(smtp_runtime()) == {
        .Err(error) -> error
        .Ok(_) -> panic("partial DKIM environment was accepted")
    }
    if partial == {
        email.Error.Configuration{operation, reason, ..} -> {
            assert_eq(operation, "smtp_from_env")
            assert(reason.contains("must be set together"))
        }
        else -> panic("expected Configuration")
    }
    std.env.set_var("SMTP_DKIM_SELECTOR", "login-2026")
    std.env.set_var("SMTP_DKIM_PRIVATE_KEY_BASE64", "private-key-not-base64")
    malformed :: if email.smtp_from_env(smtp_runtime()) == {
        .Err(error) -> error
        .Ok(_) -> panic("malformed DKIM environment was accepted")
    }
    assert(!"{malformed:?}".contains("private-key-not-base64"))
    std.env.set_var("SMTP_DKIM_PRIVATE_KEY_BASE64", "BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=")
    mailer :: email.smtp_from_env(smtp_runtime()).unwrap()
    drop(^mailer)
    loop name in [String]{"SMTP_HOST", "SMTP_SECURITY", "SMTP_PORT", "SMTP_DKIM_DOMAIN", "SMTP_DKIM_SELECTOR", "SMTP_DKIM_PRIVATE_KEY_BASE64", "SMTP_DKIM_SIGNED_HEADERS"} -> std.env.remove_var(name)
}
