// Dyn accessors shared by the PackageModel codecs. Parsing and
// rendering are Core's (`json`); these only read one shape out of a tree.
use pkg_json_tree_core: core.encoding.json

// The Rust `Dyn` accessor failures the reference embeds in its errors.
PKG_JSON_NOT_OBJECT: "expected a Dyn object"
PKG_JSON_NOT_ARRAY: "expected a Dyn array"
PKG_JSON_NOT_STRING: "expected a Dyn string"

pkg_json_object: fn(value: Dyn) -> [String: Dyn]? Never! {
    if value == {
        // The object's ordered pairs, indexed by name.
        .Object(fields) -> {
            members := [String: Dyn]{}
            loop pair in fields -> members[pair.key] = pair.value
            Val(members)
        }
        else -> None
    }
}

pkg_json_array: fn(value: Dyn) -> [Dyn]? Never! {
    if value == {
        .Array(items) -> Val(items)
        else -> None
    }
}

// serde_json object equality: the same names, each value structurally equal
// with nested object entries in any order.
pkg_json_objects_equal: fn(left: [String: Dyn], right: [String: Dyn]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop key in left.keys() {
        mine: left.get(key) ?? return false
        theirs: right.get(key) ?? return false
        if !mine.equal_unordered(theirs) -> return false
    }
    true
}

pkg_json_text: fn(value: Dyn) -> String? Never! {
    if value == {
        .Text(text) -> Val(text)
        else -> None
    }
}

pkg_json_bool: fn(value: Dyn) -> Bool? Never! {
    if value == {
        .Bool(flag) -> Val(flag)
        else -> None
    }
}

// Compact JSON with object keys in insertion order. Parsed file trees and
// Jetpack-owned facts exclude nonfinite numbers and unsupported native values;
// an encoding failure here breaches that invariant, not a recoverable document.
pkg_json_render: fn(value: Dyn) -> String Never! {
    pkg_json_tree_core.to_string(value) ?? panic("Jetpack rendered a value JSON can't encode: {err.kind:Debug}")
}

// A string array of `values`.
pkg_json_texts: fn(values: [String]) -> Dyn Never! {
    items := [Dyn]{}
    loop value in values -> &items.push(Dyn.Text(value))
    Dyn.Array(items)
}
