// Lowercase hex SHA-256 of `bytes`, through the compiler's canonical infallible
// hash (the package model's `SHA256::sha256_hex`).
use jet_foundation.[sha256_bytes, sha256_hex_bytes]

fn pkg_sha256_hex(bytes: [U8]) -> String Never! {
    view :: bytes[0..<bytes.len()]
    sha256_hex_bytes(sha256_bytes(view))
}
