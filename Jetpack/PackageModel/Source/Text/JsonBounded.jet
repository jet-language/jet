// Bounded JSON parsing: the protocol decode every package model carrier and
// integration reads. Core's whole-value parser bounds nesting at 256; the
// protocol's tighter 64-level bound is checked on the parsed tree.
use core.encoding.json as json
use core.encoding as encoding


// jet_foundation::JSON protocol bounds: nesting depth and default message
// size (`MAX_JSON_DEPTH`, `MAX_PROTOCOL_MESSAGE_BYTES`).
PKG_JSON_MAX_DEPTH :: prep { 64 }
PKG_JSON_MAX_PROTOCOL_BYTES :: prep { 1048576 }

// A bounded parse: the tree, or the reference's failure text.
enum PkgJSONDocument {
    Parsed(Dyn)
    Failed(String)
}

// Rust `JSON::parse`: at most 1 MiB and 64 nesting levels.
fn pkg_json_parse_protocol(text: String) -> PkgJSONDocument Never! {
    if text.bytes().len() > PKG_JSON_MAX_PROTOCOL_BYTES -> return PkgJSONDocument.Failed("JSON input exceeds the 1 MiB limit")
    pkg_json_parse_bounded(text, PKG_JSON_MAX_PROTOCOL_BYTES)
}

// Rust `JSON::parse_json_with_limit`: at most `max_bytes` and 64 nesting
// levels.
fn pkg_json_parse_bounded(text: String, max_bytes: Int) -> PkgJSONDocument Never! {
    if text.bytes().len() > max_bytes -> return PkgJSONDocument.Failed("JSON input exceeds the {max_bytes}-byte limit")
    if json.parse(text) == {
        .Ok(tree) -> {
            if !pkg_json_within_depth(tree, 0) -> return PkgJSONDocument.Failed("JSON exceeds maximum nesting depth")
            PkgJSONDocument.Parsed(tree)
        }
        .Err(error) -> {
            if error.kind == encoding.EncodingErrorKind.Limit -> return PkgJSONDocument.Failed("JSON exceeds maximum nesting depth")
            PkgJSONDocument.Failed(error.reason)
        }
    }
}

// A container opened at `depth` (the root is 0) is within the protocol bound
// when depth < PKG_JSON_MAX_DEPTH, as the reference parser checks on entry.
fn pkg_json_within_depth(tree: Dyn, depth: Int) -> Bool Never! {
    if tree == {
        .Array(items) -> {
            if depth >= PKG_JSON_MAX_DEPTH -> return false
            loop item in items {
                if !pkg_json_within_depth(item, depth + 1) -> return false
            }
        }
        .Object(fields) -> {
            if depth >= PKG_JSON_MAX_DEPTH -> return false
            loop field in fields {
                if !pkg_json_within_depth(field.value, depth + 1) -> return false
            }
        }
        else -> {}
    }
    true
}
