// The one contribution law for build facts (jet_foundation::Policy fact
// resolution): every writer carries its layer, source scope, span, and source
// label; the resolver orders them, rejects same-rung disagreement, honors
// `.Force` pins at the system/fleet layers, and keeps the whole writer chain
// for explanation. It lives beside the §6 merge engine because it carries
// compiler spans and diagnostics, which the compiler-free Foundation area may
// not reference.
use jet_foundation.[Diagnostic, Item, PolicyValue, Span, diagnostic_from_registry, overflow_mode_name]

// The six lexical source rungs used by every build fact. Package is the
// outermost source and Item is the nearest source.
#Comparable
SourceScope: enum {
    Package,
    File,
    Module,
    Function,
    Block,
    Item,

    name: fn(self) -> String Never! {
        if self == {
            .Package -> "package"
            .File -> "file"
            .Module -> "module"
            .Function -> "function"
            .Block -> "block"
            .Item -> "item"
        }
    }

    rank: fn(self) -> Int Never! {
        if self == {
            .Package -> 0
            .File -> 1
            .Module -> 2
            .Function -> 3
            .Block -> 4
            .Item -> 5
        }
    }
}

// Contribution layers are ordered from least to most explicit. A later layer
// may replace an earlier layer; two different values at one deciding layer
// are a hard conflict.
#Comparable
ContributionLayer: enum {
    Declaration,
    // A dependency's entry in another package's `deps:` (`tool: { path: ../tool,
    // settings: { loud: true } }`); entries may disagree when a more explicit
    // writer decides.
    DependencyEntry,
    // The root package's own entry for the dependency.
    RootEntry,
    OptimizationBundle,
    // One build output's own values, which `build: fn` gives the output it
    // declares (`b.add_executable(..., options: { settings: { ... } })`):
    // over the selected profile, beneath the build's pins and the flags.
    Output,
    Workspace,
    Environment,
    System,
    Fleet,
    CommandLine,

    name: fn(self) -> String Never! {
        if self == {
            .Declaration -> "declaration"
            .DependencyEntry -> "dependency entry"
            .RootEntry -> "root entry"
            .OptimizationBundle -> "optimization bundle"
            .Output -> "build output"
            .Workspace -> "workspace"
            .Environment -> "environment"
            .System -> "system"
            .Fleet -> "fleet"
            .CommandLine -> "command line"
        }
    }

    rank: fn(self) -> Int Never! {
        if self == {
            .Declaration -> 0
            .DependencyEntry -> 1
            .RootEntry -> 2
            .OptimizationBundle -> 3
            .Output -> 4
            .Workspace -> 5
            .Environment -> 6
            .System -> 7
            .Fleet -> 8
            .CommandLine -> 9
        }
    }

    can_force: fn(self) -> Bool Never! {
        if self == {
            .System | .Fleet -> true
            .Declaration | .DependencyEntry | .RootEntry | .OptimizationBundle | .Output | .Workspace | .Environment | .CommandLine -> false
        }
    }
}

// How a fact combines across the contribution ladder.
FactMerge: enum {
    Override,
    TightenOnly,
}

// A resolver-owned declaration default and its source label.
FactDefault: struct {
    value: FactValue,
    source: String,
}

// A fact key carries its resolver merge direction and an optional
// resolver-owned default writer; contributors supply only a value and
// provenance.
FactKey: struct {
    name: String,
    merge: FactMerge{FactMerge.Override},
    default: FactDefault?{None},

    new: fn(name: String) -> FactKey Never! { FactKey{name: name} }

    tighten_only: fn(name: String) -> FactKey Never! {
        FactKey{name: name, merge: FactMerge.TightenOnly}
    }

    // Set the resolver-owned declaration default for this fact.
    with_default: fn(name: String, value: FactValue) -> FactKey Never! {
        FactKey.with_default_source(name, value, "<default>")
    }

    // Set the resolver-owned declaration default and preserve its source
    // label for the explanation chain.
    with_default_source: fn(name: String, value: FactValue, source: String) -> FactKey Never! {
        FactKey{name: name, default: Val(FactDefault{value: value, source: source})}
    }
}

// Tier-0 values that can travel through the contribution law. Facts erase
// before runtime; this carrier exists only for folding and explanation.
FactValue: enum {
    Bool(value: Bool),
    Int(value: Int),
    Char(value: Char),
    Text(value: String),
    Enum(variant: String),
    OptionalText(value: String?),
    Policy(value: PolicyValue),

    display: fn(self) -> String Never! {
        if self == {
            .Bool(value) -> "{value}"
            .Int(value) -> "{value}"
            .Char(value) -> "'{value}'"
            .Text(value) -> "\"{value}\""
            .Enum(variant) -> ".{variant}"
            .OptionalText(value) -> if value == {
                .Val(text) -> "Some(\"{text}\")"
                .None -> "None"
            }
            .Policy(value) -> pkg_policy_value_display(value)
        }
    }

    // Rust's tuple-variant Debug spelling is part of the lock projection,
    // distinct from the human-facing value display above.
    debug_text: fn(self) -> String Never! {
        if self == {
            .Bool(value) -> "Bool({value:Debug})"
            .Int(value) -> "Int({value:Debug})"
            .Char(value) -> "Char({value:Debug})"
            .Text(value) -> "Text({value:Debug})"
            .Enum(variant) -> "Enum({variant:Debug})"
            .OptionalText(value) -> if value == {
                .Val(text) -> "OptionalText(Some({text:Debug}))"
                .None -> "OptionalText(None)"
            }
            .Policy(value) -> if value == {
                .Limit(limit) -> "Policy(Limit({limit:Debug}))"
                .Enabled | .Forbid | .Default | .GateOnly | .Obligations | .Relaxed | .PerSite | .Track | .Skip | .Allow | .On | .Off | .Explicit | .Arithmetic(_) | .NoEager | .Only -> "Policy({value:Debug})"
            }
        }
    }

    safety_relation: fn(self, next: FactValue) -> SafetyRelation Never! {
        if self == next -> return SafetyRelation.Same
        if self == {
            .Bool(outer) -> {
                if next == {
                    .Bool(inner) -> {
                        return if outer && !inner -> SafetyRelation.Tighten else -> SafetyRelation.Widen
                    }
                    .Int(_) | .Char(_) | .Text(_) | .Enum(_) | .OptionalText(_) | .Policy(_) -> {}
                }
            }
            .Int(outer) -> {
                if next == {
                    .Int(inner) -> {
                        return if inner < outer -> SafetyRelation.Tighten else -> SafetyRelation.Widen
                    }
                    .Bool(_) | .Char(_) | .Text(_) | .Enum(_) | .OptionalText(_) | .Policy(_) -> {}
                }
            }
            .Policy(outer) -> {
                if next == {
                    .Policy(inner) -> {
                        return if pkg_policy_gate_widens(outer, inner) -> SafetyRelation.Widen else -> SafetyRelation.Tighten
                    }
                    .Bool(_) | .Int(_) | .Char(_) | .Text(_) | .Enum(_) | .OptionalText(_) -> {}
                }
            }
            .Char(_) | .Text(_) | .Enum(_) | .OptionalText(_) -> {}
        }
        SafetyRelation.Incomparable
    }
}

SafetyRelation: enum {
    Same,
    Tighten,
    Widen,
    Incomparable,
}

// Rust `PolicyValue::display`.
pkg_policy_value_display: fn(value: PolicyValue) -> String Never! {
    if value == {
        .Enabled -> "true"
        .Limit(limit) -> "{limit}"
        .Forbid -> ".Forbid"
        .Default -> ".Default"
        .GateOnly -> ".GateOnly"
        .Obligations -> ".Obligations"
        .Relaxed -> ".Relaxed"
        .PerSite -> ".PerSite"
        .Track -> ".Track"
        .Skip -> ".Skip"
        .Allow -> ".Allow"
        .On -> ".On"
        .Off -> ".Off"
        .Explicit -> ".Explicit"
        .Arithmetic(mode) -> ".{overflow_mode_name(mode)}"
        .NoEager -> ".NoEager"
        .Only -> ".Only"
    }
}

// True when moving from `outer` to `inner` loosens a policy gate.
pkg_policy_gate_widens: fn(outer: PolicyValue, inner: PolicyValue) -> Bool Never! {
    if inner == PolicyValue.Allow -> return outer == PolicyValue.Forbid
    if outer == {
        .Forbid -> inner != PolicyValue.Forbid
        .Obligations -> inner != PolicyValue.Obligations && inner != PolicyValue.Track
        .PerSite -> inner != PolicyValue.Track && inner != PolicyValue.Skip && inner != PolicyValue.PerSite
        .Default | .GateOnly | .Relaxed -> if inner == {
            .Track | .Obligations | .Default | .GateOnly | .Relaxed | .Skip -> false
            .Enabled | .Limit(_) | .Forbid | .PerSite | .Allow | .On | .Off | .Explicit | .Arithmetic(_) | .NoEager | .Only -> true
        }
        .Track -> inner != PolicyValue.Track
        .Skip -> inner != PolicyValue.Skip
        .On -> inner != PolicyValue.On && inner != PolicyValue.Off
        .Off -> inner != PolicyValue.Off
        .Enabled | .Limit(_) | .Allow | .Explicit | .Arithmetic(_) | .NoEager | .Only -> true
    }
}

// One written contributor to one fact. `target` lets a source-scoped value
// identify the item it governs without changing the global ordering law.
FactContribution: struct {
    key: String,
    value: FactValue,
    scope: SourceScope,
    layer: ContributionLayer,
    span: Span{Span{start: 0, end: 0}},
    target: Span?{None},
    source: String,
    // Human-readable reason retained for explain and lock provenance. The
    // caller supplies this only when the writer is computed rather than a
    // manifest or command-line declaration.
    reason: String?{None},
    force: Bool{false},
    force_reason: String?{None},
    default: Bool{false},

    new: fn(key: String, value: FactValue, scope: SourceScope, layer: ContributionLayer, source: String) -> FactContribution Never! {
        FactContribution{key: key, value: value, scope: scope, layer: layer, source: source}
    }

    at: fn(^^self, span: Span) -> FactContribution Never! {
        updated := self
        updated.span = span
        updated
    }

    for_target: fn(^^self, target: Span) -> FactContribution Never! {
        updated := self
        updated.target = Val(target)
        updated
    }

    force_with_reason: fn(^^self, reason: String) -> FactContribution Never! {
        updated := self
        updated.force = true
        updated.force_reason = Val(reason)
        updated
    }

    pinned_with_reason: fn(^^self, reason: String) -> FactContribution Never! {
        self.force_with_reason(reason)
    }

    pinned: fn(^^self) -> FactContribution Never! { self.force_with_reason(".Pin") }

    forced: fn(^^self) -> FactContribution Never! { self.force_with_reason(".Pin") }

    with_reason: fn(^^self, reason: String) -> FactContribution Never! {
        updated := self
        updated.reason = Val(reason)
        updated
    }

    default_for: fn(key: FactKey, value: FactValue, source: String) -> FactContribution Never! {
        FactContribution{key: key.name, value: value, scope: SourceScope.Package, layer: ContributionLayer.Declaration, source: source, default: true}
    }
}

// The resolved value plus the complete writer chain. `effective` indexes
// `provenance`, so explain output can mark exactly one writer.
EffectiveFact: struct {
    key: FactKey,
    value: FactValue,
    provenance: [FactContribution],
    effective: Int,
    forced: Bool,

    explain: fn(self) -> String Never! {
        out := "{self.key.name} = {self.value.display()}"
        loop index in 0..<self.provenance.len() {
            contribution: self.provenance[index]
            status: if {
                index == self.effective -> "effective"
                contribution.force -> "pinned"
                else -> "shadowed"
            }
            pin: if contribution.force_reason == {
                .Val(text) -> " pin={text}"
                .None -> ""
            }
            reason: if contribution.reason == {
                .Val(text) -> " reason={text}"
                .None -> ""
            }
            out = "{out}\n  [{status}] {contribution.layer.name()} / {contribution.scope.name()} {contribution.value.display()} at {contribution.source}:{contribution.span.start}..{contribution.span.end}{pin}{reason}"
        }
        out
    }
}

#Error
FactError: enum {
    InvalidForce(key: String, layer: ContributionLayer, source: String),
    Conflict(key: String, layer: ContributionLayer, first: FactContribution, second: FactContribution),
    PinnedConflict(key: String, pinned: FactContribution, conflicting: FactContribution),
    SafetyWidening(key: String, previous: FactContribution, next: FactContribution),
    SafetyIncomparable(key: String, previous: FactContribution, next: FactContribution),

    message: fn(self) -> String Never! {
        if self == {
            .InvalidForce(key, layer, source) -> "fact `{key}` uses `.Pin` at the unsupported {layer.name()} layer ({source})"
            .Conflict(key, layer, first, second) -> "fact `{key}` has conflicting values at the {layer.name()} layer: {first.source}:{first.span.start} and {second.source}:{second.span.start}"
            .PinnedConflict(key, pinned, conflicting) -> "`{key}` is pinned to `{pinned.value.display()}` at `{pinned.source}`, so `{conflicting.source}` (`{conflicting.value.display()}`) can't change it"
            .SafetyWidening(key, previous, next) -> "fact `{key}` widens from {previous.value.display()} at {previous.source} to {next.value.display()} at {next.source}"
            .SafetyIncomparable(key, previous, next) -> "fact `{key}` has unrelated safety values at {previous.source} and {next.source}"
        }
    }

    // The same typed conflict reaches the product diagnostic and names both
    // written locations. A host or fleet pin refused by a conflicting later
    // writer uses E2113, the same registered error as a build-code pin.
    diagnostic: fn(self) -> Diagnostic? Never! {
        if self == {
            .Conflict(key, layer, first, second) -> Val(diagnostic_from_registry("E3521", Val(second.span), "fact `{key}` has conflicting values at the {layer.name()} layer", "`{first.source}` writes {first.value.display()} at {first.span.start}:{first.span.end}; `{second.source}` writes {second.value.display()} at {second.span.start}:{second.span.end}.", "make same-layer writers agree, or move one value to a more explicit contribution layer"))
            .PinnedConflict(key, pinned, conflicting) -> Val(diagnostic_from_registry("E2113", Val(conflicting.span), "`{key}` is pinned to `{pinned.value.display()}` at `{pinned.source}`, so `{conflicting.source}` can't change it", "`{pinned.source}` pins `{key}` at the {pinned.layer.name()} layer; a later writer may only match the pinned value.", "remove the conflicting `{conflicting.layer.name()}` override, or remove the pin at `{pinned.source}`"))
            .InvalidForce(_, _, _) | .SafetyWidening(_, _, _) | .SafetyIncomparable(_, _, _) -> None
        }
    }
}

// Writer order: layer, then scope, then source label, then span.
pkg_fact_precedes: fn(left: FactContribution, right: FactContribution) -> Bool Never! {
    if left.layer.rank() != right.layer.rank() -> return left.layer.rank() < right.layer.rank()
    if left.scope.rank() != right.scope.rank() -> return left.scope.rank() < right.scope.rank()
    if left.source != right.source -> return left.source < right.source
    if left.span.start != right.span.start -> return left.span.start < right.span.start
    left.span.end < right.span.end
}

// Resolve one fact from every writer that names it: the most explicit
// eligible layer and nearest scope decide, a System/Fleet `.Pin` refuses any
// conflicting higher-layer writer with E2113 while allowing a matching value,
// and a tighten-only key may never widen along the chain. None when nobody
// writes the fact and the key has no default.
pkg_fact_resolve: fn(key: FactKey, declarations: [FactContribution]) -> EffectiveFact? FactError! {
    chain := [FactContribution]{}
    loop declaration in declarations {
        if declaration.key == key.name -> chain.push(declaration.copy())
    }
    if key.default == {
        .Val(written) -> {
            has_default := false
            loop declaration in chain {
                if declaration.default -> has_default = true
            }
            if !has_default {
                chain.push(FactContribution.default_for(key, written.value, written.source))
            }
        }
        .None -> {}
    }
    if chain.len() == 0 -> return Ok(None)
    // A stable insertion sort keeps equal writers in their written order.
    sorted := [FactContribution]{}
    loop declaration in chain {
        index := sorted.len()
        loop index > 0 && pkg_fact_precedes(declaration, sorted[index - 1]) -> index -= 1
        sorted.insert(index, declaration)
    }
    chain = sorted
    loop declaration in chain {
        if declaration.force && !declaration.layer.can_force() {
            return Err(FactError.InvalidForce{key: key.name, layer: declaration.layer, source: declaration.source})
        }
    }
    // Same-rung writers must agree, except dependency entries: they stand
    // when a more explicit writer decides, and conflict below when their
    // layer is the one that decides.
    group_start := 0
    loop index in 1..<chain.len() {
        declaration: chain[index]
        first: chain[group_start]
        if declaration.layer != first.layer || declaration.scope != first.scope {
            group_start = index
        } else if declaration.value != first.value && declaration.layer != ContributionLayer.DependencyEntry {
            return Err(FactError.Conflict{key: key.name, layer: declaration.layer, first: first, second: declaration})
        }
    }
    force_layer := -1
    loop declaration in chain {
        if declaration.force && declaration.layer.rank() > force_layer {
            force_layer = declaration.layer.rank()
        }
    }
    eligible := [Int]{}
    loop index in 0..<chain.len() {
        if force_layer < 0 || chain[index].layer.rank() <= force_layer -> eligible.push(index)
    }
    effective_layer := -1
    loop index in eligible {
        if chain[index].layer.rank() > effective_layer {
            effective_layer = chain[index].layer.rank()
        }
    }
    effective_scope := -1
    loop index in eligible {
        if chain[index].layer.rank() == effective_layer && chain[index].scope.rank() > effective_scope {
            effective_scope = chain[index].scope.rank()
        }
    }
    candidates := [Int]{}
    loop index in eligible {
        if chain[index].layer.rank() == effective_layer && chain[index].scope.rank() == effective_scope {
            candidates.push(index)
        }
    }
    first: chain[candidates[0]]
    loop position in 1..<candidates.len() {
        second: chain[candidates[position]]
        if second.value != first.value {
            return Err(FactError.Conflict{key: key.name, layer: first.layer, first: first, second: second})
        }
    }
    if force_layer >= 0 {
        loop index in 0..<chain.len() {
            later: chain[index]
            if later.layer.rank() > force_layer && later.value != first.value {
                return Err(FactError.PinnedConflict{key: key.name, pinned: first.copy(), conflicting: later.copy()})
            }
        }
    }
    if key.merge == FactMerge.TightenOnly {
        loop position in 1..<eligible.len() {
            previous: chain[eligible[position - 1]]
            next_writer: chain[eligible[position]]
            if previous.value.safety_relation(next_writer.value) == {
                .Same | .Tighten -> {}
                .Widen -> {
                    return Err(FactError.SafetyWidening{key: key.name, previous: previous, next: next_writer})
                }
                .Incomparable -> {
                    return Err(FactError.SafetyIncomparable{key: key.name, previous: previous, next: next_writer})
                }
            }
        }
    }
    // copy: the first candidate row (owner: `chain`, which moves into the provenance field below)
    // and the effective value (owner: the EffectiveFact) are both kept; a view of chain cannot
    // outlive that move.
    value: first.value.copy()
    forced: first.force || force_layer >= 0
    Ok(Val(EffectiveFact{key: key, value: value, provenance: chain, effective: candidates[0], forced: forced}))
}
