// The one contribution law for build facts (jet_foundation::Policy fact
// resolution): every writer carries its layer, source scope, span, and source
// label; the resolver orders them, rejects same-rung disagreement, honours
// `.Force` pins at the system/fleet layers, and keeps the whole writer chain
// for explanation. It lives beside the §6 merge engine because it carries
// compiler spans and diagnostics, which the compiler-free Foundation area may
// not reference.

// The six lexical source rungs used by every build fact. Package is the
// outermost source and Item is the nearest source.
#Comparable
pub enum SourceScope {
    Package
    File
    Module
    Function
    Block
    Item

    fn name(self) -> String Never! {
        if self == {
            .Package -> "package"
            .File -> "file"
            .Module -> "module"
            .Function -> "function"
            .Block -> "block"
            .Item -> "item"
        }
    }

    fn rank(self) -> Int Never! {
        if self == {
            .Package -> 0
            .File -> 1
            .Module -> 2
            .Function -> 3
            .Block -> 4
            .Item -> 5
        }
    }
}

// Contribution layers are ordered from least to most explicit. A later layer
// may replace an earlier layer; two different values at one deciding layer
// are a hard conflict.
#Comparable
pub enum ContributionLayer {
    Declaration
    OptimizationBundle
    Workspace
    Environment
    System
    Fleet
    CommandLine

    fn name(self) -> String Never! {
        if self == {
            .Declaration -> "declaration"
            .OptimizationBundle -> "optimization bundle"
            .Workspace -> "workspace"
            .Environment -> "environment"
            .System -> "system"
            .Fleet -> "fleet"
            .CommandLine -> "command line"
        }
    }

    fn rank(self) -> Int Never! {
        if self == {
            .Declaration -> 0
            .OptimizationBundle -> 1
            .Workspace -> 2
            .Environment -> 3
            .System -> 4
            .Fleet -> 5
            .CommandLine -> 6
        }
    }

    fn can_force(self) -> Bool Never! {
        if self == {
            .System | .Fleet -> true
            else -> false
        }
    }
}

// How a fact combines across the contribution ladder.
pub enum FactMerge {
    Override
    TightenOnly
}

// A resolver-owned declaration default and its source label.
pub struct FactDefault {
    pub value: FactValue
    pub source: String
}

// A fact key carries its resolver merge direction and an optional
// resolver-owned default writer; contributors supply only a value and
// provenance.
pub struct FactKey {
    pub name: String
    pub merge: FactMerge{FactMerge.Override}
    pub default: FactDefault?{None}

    fn new(name: String) -> FactKey Never! {
        FactKey{name: name}
    }

    fn tighten_only(name: String) -> FactKey Never! {
        FactKey{name: name, merge: FactMerge.TightenOnly}
    }

    // Set the resolver-owned declaration default for this fact.
    fn with_default(name: String, value: FactValue) -> FactKey Never! {
        FactKey.with_default_source(name, value, "<default>")
    }

    // Set the resolver-owned declaration default and preserve its source
    // label for the explanation chain.
    fn with_default_source(name: String, value: FactValue, source: String) -> FactKey Never! {
        FactKey{name: name, default: Val(FactDefault{value: value, source: source})}
    }
}

// Tier-0 values that can travel through the contribution law. Facts erase
// before runtime; this carrier exists only for folding and explanation.
pub enum FactValue {
    Bool(value: Bool)
    Int(value: Int)
    Char(value: Char)
    Text(value: String)
    Enum(variant: String)
    OptionalText(value: String?)
    Policy(value: PolicyValue)

    fn display(self) -> String Never! {
        if self == {
            .Bool(value) -> "{value}"
            .Int(value) -> "{value}"
            .Char(value) -> "'{value}'"
            .Text(value) -> "\"{value}\""
            .Enum(variant) -> ".{variant}"
            .OptionalText(value) -> {
                if value == {
                    .Val(text) -> "Some(\"{text}\")"
                    .None -> "None"
                }
            }
            .Policy(value) -> pkg_policy_value_display(value)
        }
    }

    fn safety_relation(self, next: FactValue) -> SafetyRelation Never! {
        if self == next -> return SafetyRelation.Same
        if self == {
            .Bool(outer) -> {
                if next == {
                    .Bool(inner) -> { return if outer && !inner -> SafetyRelation.Tighten else -> SafetyRelation.Widen }
                    else -> {}
                }
            }
            .Int(outer) -> {
                if next == {
                    .Int(inner) -> { return if inner < outer -> SafetyRelation.Tighten else -> SafetyRelation.Widen }
                    else -> {}
                }
            }
            .Policy(outer) -> {
                if next == {
                    .Policy(inner) -> { return if pkg_policy_gate_widens(outer, inner) -> SafetyRelation.Widen else -> SafetyRelation.Tighten }
                    else -> {}
                }
            }
            else -> {}
        }
        SafetyRelation.Incomparable
    }
}

enum SafetyRelation {
    Same
    Tighten
    Widen
    Incomparable
}

// Rust `PolicyValue::display`.
pub fn pkg_policy_value_display(value: PolicyValue) -> String Never! {
    if value == {
        .Enabled -> "true"
        .Limit(limit) -> "{limit}"
        .Forbid -> ".Forbid"
        .Default -> ".Default"
        .GateOnly -> ".GateOnly"
        .Obligations -> ".Obligations"
        .Relaxed -> ".Relaxed"
        .PerSite -> ".PerSite"
        .Track -> ".Track"
        .Skip -> ".Skip"
        .Allow -> ".Allow"
        .On -> ".On"
        .Off -> ".Off"
        .Explicit -> ".Explicit"
    }
}

// True when moving from `outer` to `inner` loosens a policy gate.
pub fn pkg_policy_gate_widens(outer: PolicyValue, inner: PolicyValue) -> Bool Never! {
    if inner == PolicyValue.Allow -> return outer == PolicyValue.Forbid
    if outer == {
        .Forbid -> inner != PolicyValue.Forbid
        .Obligations -> inner != PolicyValue.Obligations && inner != PolicyValue.Track
        .PerSite -> inner != PolicyValue.Track && inner != PolicyValue.Skip && inner != PolicyValue.PerSite
        .Default | .GateOnly | .Relaxed -> {
            if inner == {
                .Track | .Obligations | .Default | .GateOnly | .Relaxed | .Skip -> false
                else -> true
            }
        }
        .Track -> inner != PolicyValue.Track
        .Skip -> inner != PolicyValue.Skip
        .On -> inner != PolicyValue.On && inner != PolicyValue.Off
        .Off -> inner != PolicyValue.Off
        else -> true
    }
}

// One written contributor to one fact. `target` lets a source-scoped value
// identify the item it governs without changing the global ordering law.
pub struct FactContribution {
    pub key: String
    pub value: FactValue
    pub scope: SourceScope
    pub layer: ContributionLayer
    pub span: Span{Span{start: 0, end: 0}}
    pub target: Span?{None}
    pub source: String
    // Human-readable reason retained for explain and lock provenance. The
    // caller supplies this only when the writer is computed rather than a
    // manifest or command-line declaration.
    pub reason: String?{None}
    pub force: Bool{false}
    pub force_reason: String?{None}
    pub default: Bool{false}

    fn new(key: String, value: FactValue, scope: SourceScope, layer: ContributionLayer, source: String) -> FactContribution Never! {
        FactContribution{key: key, value: value, scope: scope, layer: layer, source: source}
    }

    fn at(^self, span: Span) -> FactContribution Never! {
        updated := self
        updated.span = span
        updated
    }

    fn for_target(^self, target: Span) -> FactContribution Never! {
        updated := self
        updated.target = Val(target)
        updated
    }

    fn force_with_reason(^self, reason: String) -> FactContribution Never! {
        updated := self
        updated.force = true
        updated.force_reason = Val(reason)
        updated
    }

    fn forced(^self) -> FactContribution Never! {
        ^self.force_with_reason(".Force")
    }

    fn with_reason(^self, reason: String) -> FactContribution Never! {
        updated := self
        updated.reason = Val(reason)
        updated
    }

    fn default_for(key: FactKey, value: FactValue, source: String) -> FactContribution Never! {
        FactContribution{key: key.name, value: value, scope: SourceScope.Package, layer: ContributionLayer.Declaration, source: source, default: true}
    }
}

// The resolved value plus the complete writer chain. `effective` indexes
// `provenance`, so explain output can mark exactly one writer.
pub struct EffectiveFact {
    pub key: FactKey
    pub value: FactValue
    pub provenance: [FactContribution]
    pub effective: Int
    pub forced: Bool

    fn explain(self) -> String Never! {
        out := "{self.key.name} = {self.value.display()}"
        loop index in 0..<self.provenance.len() {
            contribution :: self.provenance[index]
            status :: if {
                index == self.effective -> "effective"
                contribution.force -> "pinned"
                else -> "shadowed"
            }
            pin :: if contribution.force_reason == {
                .Val(text) -> " pin={text}"
                .None -> ""
            }
            reason :: if contribution.reason == {
                .Val(text) -> " reason={text}"
                .None -> ""
            }
            out = "{out}\n  [{status}] {contribution.layer.name()} / {contribution.scope.name()} {contribution.value.display()} at {contribution.source}:{contribution.span.start}..{contribution.span.end}{pin}{reason}"
        }
        out
    }
}

#Error
pub enum FactError {
    InvalidForce(key: String, layer: ContributionLayer, source: String)
    Conflict(key: String, layer: ContributionLayer, first: FactContribution, second: FactContribution)
    SafetyWidening(key: String, previous: FactContribution, next: FactContribution)
    SafetyIncomparable(key: String, previous: FactContribution, next: FactContribution)

    fn message(self) -> String Never! {
        if self == {
            .InvalidForce(key, layer, source) -> "fact `{key}` uses `.Force` at the unsupported {layer.name()} layer ({source})"
            .Conflict(key, layer, first, second) -> "fact `{key}` has conflicting values at the {layer.name()} layer: {first.source}:{first.span.start} and {second.source}:{second.span.start}"
            .SafetyWidening(key, previous, next) -> "fact `{key}` widens from {previous.value.display()} at {previous.source} to {next.value.display()} at {next.source}"
            .SafetyIncomparable(key, previous, next) -> "fact `{key}` has unrelated safety values at {previous.source} and {next.source}"
        }
    }

    // The same typed conflict reaches the product diagnostic and names both
    // written locations. Other resolver failures remain typed resolver errors.
    fn diagnostic(self) -> Diagnostic? Never! {
        if self == {
            .Conflict(key, layer, first, second) -> Val(diagnostic_from_registry("E3521", Val(second.span), "fact `{key}` has conflicting values at the {layer.name()} layer", "`{first.source}` writes {first.value.display()} at {first.span.start}:{first.span.end}; `{second.source}` writes {second.value.display()} at {second.span.start}:{second.span.end}.", "make same-layer writers agree, or move one value to a more explicit contribution layer"))
            else -> None
        }
    }
}

// Writer order: layer, then scope, then source label, then span.
fn pkg_fact_precedes(left: FactContribution, right: FactContribution) -> Bool Never! {
    if left.layer.rank() != right.layer.rank() -> return left.layer.rank() < right.layer.rank()
    if left.scope.rank() != right.scope.rank() -> return left.scope.rank() < right.scope.rank()
    if left.source != right.source -> return left.source < right.source
    if left.span.start != right.span.start -> return left.span.start < right.span.start
    left.span.end < right.span.end
}

// Resolve one fact from every writer that names it: the most explicit
// eligible layer and nearest scope decide, `.Force` caps eligibility at its
// layer, and a tighten-only key may never widen along the chain. None when
// nobody writes the fact and the key has no default.
pub fn pkg_fact_resolve(key: FactKey, declarations: [FactContribution]) -> EffectiveFact? FactError! {
    chain := [FactContribution]{}
    loop declaration in declarations {
        if declaration.key == key.name { &chain.push(declaration) }
    }
    if key.default == {
        .Val(written) -> {
            has_default := false
            loop declaration in chain {
                if declaration.default -> has_default = true
            }
            if !has_default {
                &chain.push(FactContribution.default_for(key, written.value, written.source))
            }
        }
        .None -> {}
    }
    if chain.len() == 0 -> return Ok(None)
    // A stable insertion sort keeps equal writers in their written order.
    sorted := [FactContribution]{}
    loop declaration in chain {
        index := sorted.len()
        loop index > 0 && pkg_fact_precedes(declaration, sorted[index - 1]) -> index -= 1
        &sorted.insert(index, declaration)
    }
    chain = sorted
    loop declaration in chain {
        if declaration.force && !declaration.layer.can_force() {
            return Err(FactError.InvalidForce{key: key.name, layer: declaration.layer, source: declaration.source})
        }
    }
    group_start := 0
    loop index in 1..<chain.len() {
        declaration :: chain[index]
        first :: chain[group_start]
        if declaration.layer != first.layer || declaration.scope != first.scope {
            group_start = index
        } else if declaration.value != first.value {
            return Err(FactError.Conflict{key: key.name, layer: declaration.layer, first: first, second: declaration})
        }
    }
    force_layer := -1
    loop declaration in chain {
        if declaration.force && declaration.layer.rank() > force_layer -> force_layer = declaration.layer.rank()
    }
    eligible := [Int]{}
    loop index in 0..<chain.len() {
        if force_layer < 0 || chain[index].layer.rank() <= force_layer { &eligible.push(index) }
    }
    effective_layer := -1
    loop index in eligible {
        if chain[index].layer.rank() > effective_layer -> effective_layer = chain[index].layer.rank()
    }
    effective_scope := -1
    loop index in eligible {
        if chain[index].layer.rank() == effective_layer && chain[index].scope.rank() > effective_scope -> effective_scope = chain[index].scope.rank()
    }
    candidates := [Int]{}
    loop index in eligible {
        if chain[index].layer.rank() == effective_layer && chain[index].scope.rank() == effective_scope { &candidates.push(index) }
    }
    first :: chain[candidates[0]]
    loop position in 1..<candidates.len() {
        second :: chain[candidates[position]]
        if second.value != first.value {
            return Err(FactError.Conflict{key: key.name, layer: first.layer, first: first, second: second})
        }
    }
    if key.merge == FactMerge.TightenOnly {
        loop position in 1..<eligible.len() {
            previous :: chain[eligible[position - 1]]
            next_writer :: chain[eligible[position]]
            if previous.value.safety_relation(next_writer.value) == {
                .Same | .Tighten -> {}
                .Widen -> { return Err(FactError.SafetyWidening{key: key.name, previous: previous, next: next_writer}) }
                .Incomparable -> { return Err(FactError.SafetyIncomparable{key: key.name, previous: previous, next: next_writer}) }
            }
        }
    }
    Ok(Val(EffectiveFact{key: key, value: first.value, provenance: chain, effective: candidates[0], forced: first.force || force_layer >= 0}))
}
