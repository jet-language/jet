// The canonical merge engine (U5, unified-ecosystem §6).
//
// One referee reconciles the typed contributions every module makes, across
// all three tiers (`env` / `system` / `image`):
//
// | Field    | Rule                                                            |
// |----------|-----------------------------------------------------------------|
// | sources  | merge by key; duplicate names with different refs conflict      |
// | packages | concatenate, de-duplicate, preserve source identity             |
//
// This is the pure data-reconciliation core. Conflicts are typed
// `MergeError`s; they become diagnostics when wired into evaluation.

// A package value (`Pkg`, §5) with its source identity preserved, so
// de-duplication keeps `default.ripgrep` distinct from `unstable.ripgrep`.
pub struct Pkg {
    pub source: String
    pub name: String

    fn new(source: String, name: String) -> Pkg Never! {
        Pkg{source: source, name: name}
    }

    // Parse a `packages:` list body (the text inside `[ … ]`), expanding the
    // type-directed sugar (U6 / D-JPK19):
    //
    // - `default.ripgrep`      -> Pkg{default, ripgrep}
    // - `default.[a, b]`       -> one Pkg per member (D-SPREAD1=A)
    // - `"mine@hello"`         -> escape-hatch string; source left empty for
    //                             the resolver to interpret
    // - bare `ripgrep`         -> Pkg{"", ripgrep} (source filled in later
    //                             from the default source)
    //
    // Lenient: empty items are skipped. The split is bracket-aware, so a nested
    // list value never splits mid-item.
    fn parse_list(body: String) -> [Pkg] Never! {
        out := [Pkg]{}
        loop item in pkg_merge_split_top_level(body) {
            loop pkg in Pkg.parse_item(item.trim()) -> &out.push(pkg)
        }
        out
    }

    fn parse_item(item: String) -> [Pkg] Never! {
        if item == "" -> return [Pkg]{}
        // Escape-hatch quoted string: keep verbatim, source unresolved.
        if item.starts_with("\"") {
            inner := item
            loop inner.starts_with("\"") -> inner = inner.removeprefix("\"")
            loop inner.ends_with("\"") -> inner = inner.removesuffix("\"")
            if inner == "" -> return [Pkg]{}
            return [Pkg]{Pkg.new("", inner)}
        }
        if item.split_once(".") == {
            .Val(parts) -> {
                rest :: parts.after.trim()
                if rest.starts_with("[") && rest.ends_with("]") {
                    members := [Pkg]{}
                    loop name in rest.removeprefix("[").removesuffix("]").split(",") {
                        member :: name.trim()
                        if member != "" -> &members.push(Pkg.new(parts.before, member))
                    }
                    return members
                }
                if rest != "" -> return [Pkg]{Pkg.new(parts.before, rest)}
            }
            .None -> {}
        }
        // Bare name: source resolved from the default later.
        [Pkg]{Pkg.new("", item)}
    }
}

// Why a merge could not be reconciled (§6 conflict diagnostics).
#Error
pub enum MergeError {
    // Two `sources` declarations share a name but resolve to different refs.
    SourceConflict(name: String, a: String, b: String)
    // A fact setting failed the canonical contribution law.
    FactConflict(error: FactError)
}

// Split on commas not nested inside `()`/`[]`/`{}` (so `["a", "b"]` is one
// item). Returns the raw, untrimmed pieces; a trailing comma adds no piece.
fn pkg_merge_split_top_level(body: String) -> [String] Never! {
    raw :: body.bytes()
    out := [String]{}
    depth := 0
    start := 0
    loop index in 0..<raw.len() {
        code :: Int.from_u8(raw[index])
        if code == {
            40 | 91 | 123 -> depth += 1
            41 | 93 | 125 -> depth -= 1
            44 -> {
                if depth == 0 {
                    &out.push(pkg_bytes_text(raw, start, index))
                    start = index + 1
                }
            }
            else -> {}
        }
    }
    if start < raw.len() -> &out.push(pkg_bytes_text(raw, start, raw.len()))
    out
}

// Merge `sources` maps by key: identical refs de-duplicate; the same name with
// different refs is a conflict (§6). Each map is read in key order.
pub fn pkg_merge_sources(contribs: [[String: String]]) -> [String: String] MergeError! {
    out := [String: String]{}
    loop map in contribs {
        loop name in pkg_merge_sorted_names(map) {
            reference :: map[name]
            if out.get(name) == {
                .Val(existing) -> {
                    if existing != reference -> return Err(MergeError.SourceConflict{name: name, a: existing, b: reference})
                }
                .None -> out[name] = reference
            }
        }
    }
    Ok(out)
}

fn pkg_merge_sorted_names(map: [String: String]) -> [String] Never! {
    names := map.keys().to_list()
    &names.sort()
    names
}

// Concatenate package lists, de-duplicate while preserving source identity,
// and keep first-seen order (§6).
pub fn pkg_merge_packages(lists: [[Pkg]]) -> [Pkg] Never! {
    out := [Pkg]{}
    loop list in lists {
        loop pkg in list {
            if !out.contains(pkg) -> &out.push(pkg)
        }
    }
    out
}

// One namespace entry's contributions (e.g. everything modules contribute to
// `env.dev`). Package lists combine; fact settings reconcile through the
// canonical contribution law. Each writer already carries its layer, scope,
// span, and source.
pub struct EntryContribution {
    pub packages: [Pkg]{[Pkg]{}}
    pub settings: [String: [FactContribution]]{[String: [FactContribution]]{}}
}

// A fully merged namespace entry: deduped packages + resolved text facts.
pub struct MergedEntry {
    pub packages: [Pkg]{[Pkg]{}}
    pub settings: [String: String]{[String: String]{}}
}

// Merge several contributions to one namespace entry: packages combine and
// de-duplicate, fact settings reconcile through the one resolver (§6). Only
// text facts surface as settings.
pub fn pkg_merge_entry(contribs: [EntryContribution]) -> MergedEntry MergeError! {
    lists := [[Pkg]]{}
    loop contribution in contribs -> &lists.push(contribution.packages)
    by_key := [String: [FactContribution]]{}
    loop contribution in contribs {
        loop key in pkg_merge_sorted_setting_keys(contribution.settings) {
            writers := by_key.get(key) ?? [FactContribution]{}
            loop writer in contribution.settings[key] -> &writers.push(writer)
            by_key[key] = writers
        }
    }
    settings := [String: String]{}
    loop key in pkg_merge_sorted_setting_keys(by_key) {
        if fact_resolve(fact_key_new(key), by_key[key]) == {
            .Ok(resolved) -> {
                if resolved == {
                    .Val(fact) -> {
                        if fact.value == {
                            .Text(value) -> settings[key] = value
                            else -> {}
                        }
                    }
                    .None -> {}
                }
            }
            .Err(error) -> return Err(MergeError.FactConflict{error: error})
        }
    }
    Ok(MergedEntry{packages: pkg_merge_packages(lists), settings: settings})
}

fn pkg_merge_sorted_setting_keys(settings: [String: [FactContribution]]) -> [String] Never! {
    names := settings.keys().to_list()
    &names.sort()
    names
}
