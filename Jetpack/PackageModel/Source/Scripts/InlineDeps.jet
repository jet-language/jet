// U11 inline script dependencies. A manifest-less
// `.jet` script may open with `use pkg#version;` instead of shipping a
// `package.jet`. `jet run` resolves and locks by file-content hash,
// `jet fetch --lock` writes a `<script>.lock` sidecar, and `jet init` lifts
// the inline refs into a generated `package.jet`.
//
// Resolution itself is local and offline:
//   1. `<script_dir>/.jet/inline-deps/<name>/<version>/`, the managed-folder
//      copy (committed, or written by `jet fetch --lock`).
//   2. `JET_INLINE_DEPS_FIXTURES=<dir>`, an offline test/dev override with
//      the same `<name>/<version>/` shape, checked only when set.
//   3. The toolchain's first-party battery `<batteries>/<name>/`, whose
//      package.jet declares that name and a version the selector matches,
//      the rule a version dependency in package.jet follows.
// A package none knows is fetched only by `jet run` (its first run) and
// `jet fetch --lock`, through the configured package registry;
// anywhere else it is E1253. A local package stays
// authoritative: an unmatched selector is E1253, never a fetch.
use {
    jet_foundation.[Diagnostic, ENV_JET_INLINE_DEPS_FIXTURES, ImportDecl, Program, Span, diagnostic_from_registry]
    jetpack_foundation.[
        FOUNDATION_U64_SHIFTS, TreeHashError, foundation_sha256_file_hex, foundation_try_tree_hash,
    ]
    files: core.files
    sys: core.sys
}

PKG_INLINE_DEPS_FIXTURES_ENV: ENV_JET_INLINE_DEPS_FIXTURES

// One `use pkg#version;` ref collected from a manifest-less script.
InlineDep: struct {
    name: String
    selector: String
    span: Span
}

// Every inline dependency ref among a parsed program's top-level imports.
pkg_inline_deps_collect: fn(program: Program) -> [InlineDep] Never! {
    pkg_inline_deps_collect_from_imports(program.imports)
}

// Only a single-segment module import carries an inline version.
pkg_inline_deps_collect_from_imports: fn(imports: [ImportDecl]) -> [InlineDep] Never! {
    out := [InlineDep]{}
    loop decl in imports {
        version: decl.inline_version ?? next
        if decl.kind == {
            .Module(name, _) -> out.push(InlineDep{name: name, selector: version.text, span: version.span})
            .File(_, _) | .Unqualified(_, _, _, _, _) -> {}
        }
    }
    out
}

// A selector is pinned when it names an exact three-part version (`1.4.2`).
// Anything looser (`1.4`, `1`, `latest`, `*`) is L0203: fine to write, but
// not reproducible without `jet fetch --lock`.
pkg_inline_deps_is_pinned: fn(selector: String) -> Bool Never! {
    parts: pkg_inline_deps_numeric_version(selector) ?? return false
    parts.len() == 3
}

// The content-addressed identity carried from an inline reference into a
// lock, a package lift, or a build cache. The selector is kept apart from
// the selected version: changing a loose selector is a semantic change even
// when it selects the same source today.
ScriptDependencyIdentity: struct {
    name: String
    selector: String
    resolved_version: String
    content_hash: String
}

// The facts that identify a prepared script result. Paths and ambient
// process state are absent: only recorded source/dependency content plus
// the selected toolchain and target can authorize reuse.
ScriptCacheIdentity: struct {
    source_hash: String
    dependencies: [ScriptDependencyIdentity]
    toolchain: String
    target: String

    // Dependencies are held in (name, selector, resolved_version,
    // content_hash) order so the identity is order independent.
    new: fn(source_hash: String, dependencies: [ScriptDependencyIdentity], toolchain: String, target: String) -> ScriptCacheIdentity Never! {
        sorted := dependencies
        sorted = loop fresh_item in sorted -> fresh_item
        sorted.sort_by(fn(identity) { identity.content_hash })
        sorted = loop fresh_item in sorted -> fresh_item
        sorted.sort_by(fn(identity) { identity.resolved_version })
        sorted = loop fresh_item in sorted -> fresh_item
        sorted.sort_by(fn(identity) { identity.selector })
        sorted = loop fresh_item in sorted -> fresh_item
        sorted.sort_by(fn(identity) { identity.name })
        ScriptCacheIdentity{source_hash: source_hash, dependencies: sorted, toolchain: toolchain, target: target}
    }

    // Stable cache key. Length framing keeps distinct fields distinct even
    // when a name, hash, or toolchain contains delimiters.
    digest: fn(self) -> String Never! {
        bytes := [U8]{}
        pkg_inline_deps_framed(bytes, "jet-script-cache.v1")
        pkg_inline_deps_framed(bytes, self.source_hash)
        pkg_inline_deps_framed_count(bytes, self.dependencies.len())
        loop dependency in self.dependencies {
            pkg_inline_deps_framed(bytes, dependency.name)
            pkg_inline_deps_framed(bytes, dependency.selector)
            pkg_inline_deps_framed(bytes, dependency.resolved_version)
            pkg_inline_deps_framed(bytes, dependency.content_hash)
        }
        pkg_inline_deps_framed(bytes, self.toolchain)
        pkg_inline_deps_framed(bytes, self.target)
        "sha256-{pkg_sha256_hex(bytes)}"
    }
}

// The identity of a resolved script, computed without reading or running
// any dependency source, so callers can recompute it after a source edit
// and reject a stale prepared result before execution.
pkg_inline_deps_cache_identity: fn(source_hash: String, dependencies: [InlineDepResolved], toolchain: String, target: String) -> ScriptCacheIdentity Never! {
    identities := [ScriptDependencyIdentity]{}
    loop dependency in dependencies -> identities.push(dependency.dependency_identity())
    ScriptCacheIdentity.new(source_hash, identities, toolchain, target)
}

// A resolved inline dependency: `dir` is the module search root that
// satisfies it.
InlineDepResolved: struct {
    name: String
    selector: String
    resolved_version: String
    dir: String
    content_hash: String

    // The portable dependency identity. `dir` is not part of it: the same
    // prepared source identifies the same way after a clone moves.
    dependency_identity: fn(self) -> ScriptDependencyIdentity Never! {
        ScriptDependencyIdentity{name: self.name, selector: self.selector, resolved_version: self.resolved_version, content_hash: self.content_hash}
    }
}

// Why an inline dependency did not resolve (E1253's reason half).
#Error
InlineDepUnresolved: enum {
    // The import name would escape the local dependency root.
    InvalidName
    // The selector is not the supported dotted numeric form.
    InvalidSelector
    // No local source has ever heard of the package.
    UnknownPackage
    // The package is known locally, but no version satisfies the selector.
    NoMatch
    // A matching source exists, but its contents cannot be hashed safely.
    InvalidTree(TreeHashError)

    message: fn(self) -> String Never! {
        if self == {
            .InvalidName -> "invalid inline dependency name"
            .InvalidSelector -> "invalid inline dependency selector"
            .UnknownPackage -> "unknown inline dependency"
            .NoMatch -> "no inline dependency version matches"
            .InvalidTree(error) -> error.message()
        }
    }
}

// Resolve one inline dependency against the script's `.jet/inline-deps/`
// copy, then (when set) `JET_INLINE_DEPS_FIXTURES`, then the toolchain's
// `batteries` directory (when known), hashing the selected tree. The
// project-local source is authoritative: when it has the package but not a
// matching version, no later root is consulted.
pkg_inline_deps_resolve: fn(dep: InlineDep, script_dir: String, batteries: String?) -[FS, Env]> InlineDepResolved InlineDepUnresolved! {
    if !pkg_inline_deps_valid_package_name(dep.name) -> return Err(InlineDepUnresolved.InvalidName)
    if pkg_inline_deps_numeric_version(dep.selector) == None -> return Err(InlineDepUnresolved.InvalidSelector)
    roots := [String]{files.join(files.join(script_dir, ".jet"), "inline-deps")}
    if sys.get(PKG_INLINE_DEPS_FIXTURES_ENV) == {
        .Val(fixtures) -> roots.push(fixtures)
        .None -> {}
    }
    loop root in roots {
        candidates: pkg_inline_deps_list_versions(root, dep.name) ?? next
        chosen: pkg_inline_deps_best_match(dep.selector, candidates) ?? return Err(InlineDepUnresolved.NoMatch)
        // The same `sha256-<hex>` shape as `LockedPackage.content_hash`;
        // a hostile-tree failure stays typed for the caller.
        content_hash: if foundation_try_tree_hash(chosen.dir) == {
            .Ok(hash) -> hash
            .Err(error) -> { return Err(InlineDepUnresolved.InvalidTree(error)) }
        }
        return Ok(InlineDepResolved{name: dep.name, selector: dep.selector, resolved_version: chosen.version, dir: chosen.dir, content_hash: content_hash})
    }
    battery: pkg_inline_deps_battery(batteries ?? return Err(InlineDepUnresolved.UnknownPackage), dep.name) ?? return Err(InlineDepUnresolved.UnknownPackage)
    if !pkg_inline_deps_version_matches(dep.selector, battery.version) -> return Err(InlineDepUnresolved.NoMatch)
    content_hash: if foundation_try_tree_hash(battery.dir) == {
        .Ok(hash) -> hash
        .Err(error) -> { return Err(InlineDepUnresolved.InvalidTree(error)) }
    }
    Ok(InlineDepResolved{name: dep.name, selector: dep.selector, resolved_version: battery.version, dir: battery.dir, content_hash: content_hash})
}

// The first-party battery `<batteries>/<name>` and the version its
// package.jet declares, or None when no battery there declares that name.
pkg_inline_deps_battery: fn(batteries: String, name: String) -[FS]> (version: String, dir: String)? Never! {
    dir: files.join(batteries, name)
    manifest_path: files.join(dir, "package.jet")
    text: files.read(manifest_path) ?? return None
    manifest: pkg_manifest_parse(manifest_path, text) ?? return None
    if manifest.package.name != name -> return None
    Val((version: manifest.package.version, dir: dir))
}

// Every version directory under `<root>/<name>`, or None when `<name>` does
// not exist under `root`. File-system errors and links fail closed: a
// missing source is not interchangeable with another source root.
pkg_inline_deps_list_versions: fn(root: String, name: String) -[FS]> [(version: String, dir: String)]? InlineDepUnresolved! {
    root_stat: if files.stat(root) == {
        .Ok(stat) -> stat
        .Err(error) -> if error == {
            .NotFound(_) -> { return Ok(None) }
            .InvalidInput(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> { return Err(InlineDepUnresolved.InvalidTree(TreeHashError.IO{path: root, detail: "{error}"})) }
        }
    }
    if root_stat.is_symlink -> return Err(InlineDepUnresolved.InvalidTree(TreeHashError.Symlink(root)))
    if !root_stat.is_dir -> return Ok(None)

    package_dir: files.join(root, name)
    package_stat: if files.stat(package_dir) == {
        .Ok(stat) -> stat
        .Err(error) -> if error == {
            .NotFound(_) -> { return Ok(None) }
            .InvalidInput(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> { return Err(InlineDepUnresolved.InvalidTree(TreeHashError.IO{path: package_dir, detail: "{error}"})) }
        }
    }
    if package_stat.is_symlink -> return Err(InlineDepUnresolved.InvalidTree(TreeHashError.Symlink(package_dir)))
    if !package_stat.is_dir -> return Ok(None)

    entries: if files.list_dir(package_dir) == {
        .Ok(listed) -> listed
        .Err(error) -> { return Err(InlineDepUnresolved.InvalidTree(TreeHashError.IO{path: package_dir, detail: "{error}"})) }
    }
    out := [(version: String, dir: String)]{}
    loop entry in entries {
        stat: if files.stat(entry.path) == {
            .Ok(found) -> found
            .Err(error) -> { return Err(InlineDepUnresolved.InvalidTree(TreeHashError.IO{path: entry.path, detail: "{error}"})) }
        }
        if stat.is_dir || stat.is_symlink -> out.push((version: entry.name, dir: entry.path))
    }
    Ok(Val(out))
}

// The highest version whose dotted prefix matches `selector` (`1.4` matches
// `1.4.2`); an exact `1.4.2` selector matches only that version.
pkg_inline_deps_best_match: fn(selector: String, candidates: [(version: String, dir: String)]) -> (version: String, dir: String)? Never! {
    selector_parts: pkg_inline_deps_numeric_version(selector) ?? return None
    matches := [(version: String, dir: String)]{}
    loop candidate in candidates {
        version_parts: pkg_inline_deps_numeric_version(candidate.version) ?? next
        accepted: if selector_parts.len() == 3 -> version_parts == selector_parts else -> version_parts.len() == 3 && pkg_inline_deps_has_prefix(version_parts, selector_parts)
        if accepted -> matches.push(candidate.copy())
    }
    if matches.len() == 0 -> return None
    // Stable passes order by (major, minor, patch); ties keep input order.
    matches.sort_by(fn(candidate) { pkg_inline_deps_version_part(candidate.version, 2) })
    matches.sort_by(fn(candidate) { pkg_inline_deps_version_part(candidate.version, 1) })
    matches.sort_by(fn(candidate) { pkg_inline_deps_version_part(candidate.version, 0) })
    Val(matches[matches.len() - 1])
}

// The same numeric matching law for one admitted version, without a
// temporary candidate list or sorting at the driver's import seam.
pkg_inline_deps_version_matches: fn(selector: String, version: String) -> Bool Never! {
    selector_parts: pkg_inline_deps_numeric_version(selector) ?? return false
    version_parts: pkg_inline_deps_numeric_version(version) ?? return false
    if selector_parts.len() == 3 -> version_parts == selector_parts else -> version_parts.len() == 3 && pkg_inline_deps_has_prefix(version_parts, selector_parts)
}

// Whether `parts` begins with every element of `prefix`.
pkg_inline_deps_has_prefix: fn(parts: [U64], prefix: [U64]) -> Bool Never! {
    loop index in 0..<prefix.len() {
        if index >= parts.len() || parts[index] != prefix[index] -> return false
    }
    true
}

// One numeric component of a version key, 0 when absent or malformed.
pkg_inline_deps_version_part: fn(version: String, index: Int) -> U64 Never! {
    parts: pkg_inline_deps_numeric_version(version) ?? return U64{0}
    if index >= parts.len() -> return U64{0}
    parts[index]
}

// Rust ScriptDeps::numeric_version uses the full unsigned 64-bit domain.
pkg_inline_deps_numeric_version: fn(value: String) -> [U64]? Never! {
    parts: value.split(".").to_list()
    if parts.len() < 1 || parts.len() > 3 -> return None
    out := [U64]{}
    loop part in parts {
        if part == "" || (part.bytes().len() > 1 && part.starts_with("0")) -> return None
        digits: if part.starts_with("+") -> part.slice(1..<part.len()) else -> part
        if digits == "" -> return None
        number := U64{0}
        loop byte in digits.bytes() {
            if byte < (U8{48}) || byte > (U8{57}) -> return None
            digit: U64{byte - U8{48}}
            if number > (U64{1844674407370955161}) || (number == (U64{1844674407370955161}) && digit > (U64{5})) -> return None
            number = number * U64{10} + digit
        }
        out.push(number)
    }
    Val(out)
}

// A single safe package name: no path separators, NUL, `.`, or `..`.
pkg_inline_deps_valid_package_name: fn(name: String) -> Bool Never! {
    if name == "" || name == "." || name == ".." -> return false
    loop byte in name.bytes() {
        code: Int{byte}
        if code == 47 || code == 92 || code == 0 -> return false
    }
    true
}

// A big-endian 64-bit length prefix, then the UTF-8 bytes.
pkg_inline_deps_framed: fn(bytes: &[U8], value: String) Never! {
    raw: value.bytes()
    pkg_inline_deps_framed_count(bytes, raw.len())
    loop byte in raw -> bytes.push(byte)
}

pkg_inline_deps_framed_count: fn(bytes: &[U8], count: Int) Never! {
    loop shift in FOUNDATION_U64_SHIFTS -> bytes.push(U8{((count >> shift)).bit_and(255)})
}

// E1253 an inline `use pkg#version;` ref that cannot
// be resolved: unknown package, unreachable or unsafe source tree, or no
// version satisfies the selector.
pkg_inline_deps_e1253: fn(dep: InlineDep, reason: InlineDepUnresolved) -> Diagnostic Never! {
    explanation: if reason == {
        .InvalidName -> (fix: "use a single package name without path separators.", why: "`{dep.name}` is not a safe local package name.")
        .InvalidSelector -> (fix: "use `major`, `major.minor`, or `major.minor.patch`.", why: "`{dep.selector}` is not a supported dotted numeric version selector.")
        .UnknownPackage -> (fix: "run the script with `jet run`, which fetches and locks `{dep.name}` from the configured package registry on its first run, or commit a copy at `.jet/inline-deps/{dep.name}/<version>/`.", why: "no local copy under `.jet/inline-deps/{dep.name}/` holds `{dep.name}`, and only `jet run` and `jet fetch --lock` fetch a missing inline dependency.")
        .NoMatch -> (fix: "commit a matching version under `.jet/inline-deps/{dep.name}/`, or loosen the selector to one you have.", why: "`{dep.name}` is available locally, but no version satisfies `#{dep.selector}`.")
        .InvalidTree(error) -> (fix: "remove the hostile or oversized entry from `.jet/inline-deps/{dep.name}/`, then try again.", why: "the local source for `{dep.name}` cannot be hashed safely: {error.message()}.")
    }
    diagnostic_from_registry("E1253", Val(dep.span), "inline dependency `{dep.name}#{dep.selector}` didn't resolve", explanation.why, explanation.fix)
}

// L0203 an inline dependency with a loose selector
// (anything but an exact `major.minor.patch`).
pkg_inline_deps_l0203_unpinned: fn(dep: InlineDep) -> Diagnostic Never! {
    pkg_diagnostic_from_row("L0203", [(name: String, value: String)]{(name: "name", value: dep.name), (name: "selector", value: dep.selector)}, Val(dep.span))
}

// SHA-256 of a script file's bytes as `sha256-<hex>`: the `content_hash`
// shape `jet fetch --lock` and `jet run` use to detect an edited script.
pkg_inline_deps_file_hash: fn(path: String) -[FS]> String IOError! {
    Ok("sha256-{foundation_sha256_file_hex(path)}")
}
