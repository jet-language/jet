// Rust: crates/jet-pkg-model/src/ProviderFacts.rs:1
// Lossless provider carrier. Reuse the canonical carrier and selector owners;
// do not define competing public types or a second normalization algorithm.
use Jetpack.PackageModel.Source.Provider.ProviderFacts.*
use Jetpack.PackageModel.Source.Provider.ProviderSelector.*
use jet_foundation.DataTree.DataTree

// Rust: crates/jet-pkg-model/src/ProviderFacts.rs:12
// field -> object.get; canonical DataTree objects are keyed maps.
// Rust: crates/jet-pkg-model/src/ProviderFacts.rs:19
// ProviderFactValue -> ProviderFacts.jet:12 (all six variants).
// Rust: crates/jet-pkg-model/src/ProviderFacts.rs:29
// ProviderFactValue.to_json -> ProviderFacts.jet:41.
// Rust: crates/jet-pkg-model/src/ProviderFacts.rs:54
// ProviderFactValue.from_json -> from_json_value below; all DataTree variants,
// including lexical numbers, typed text, and byte lists, remain represented.
impl ProviderFactValue {
    // Rust: crates/jet-pkg-model/src/ProviderFacts.rs:80
    pub fn from_json_value(value: DataTree) -> ProviderFactValue Err! {
        if value == {
            .Null -> ProviderFactValue.Null
            .Bool(flag) -> ProviderFactValue.Bool(flag)
            .Int(number) -> ProviderFactValue.Number("{number}")
            .Float(number) -> ProviderFactValue.Number("{number}")
            .Number(text) -> ProviderFactValue.Number(^text)
            .Text(text) | .TypedText(text) -> ProviderFactValue.Text(^text)
            .Bytes(bytes) -> {
                values := [ProviderFactValue]{}
                loop byte in bytes -> &values.push(ProviderFactValue.Number("{byte}"))
                ProviderFactValue.List(^values)
            }
            .Array(items) -> {
                values := [ProviderFactValue]{}
                loop item in items -> &values.push(ProviderFactValue.from_json_value(item)?)
                ProviderFactValue.List(^values)
            }
            .Object(fields) -> {
                values := [String: ProviderFactValue]{}
                loop (key, item) in fields -> values[key] = ProviderFactValue.from_json_value(item)?
                ProviderFactValue.Map(^values)
            }
        }
    }
}

