// Checked filesystem authority snapshots and the one authority error carrier
// (jet-pkg-model Authority.rs). Every authority-sensitive reader goes through
// AuthorityResolver (Resolver.jet); the records here keep the opened object,
// its identity, and the bytes read from that same handle.
//
// Handles are the ratified Core directory/file handles (
// ); identity is the ratified Stat identity.
use jet_foundation.[Diagnostic, diagnostic_from_registry]
use core.files as files
use core.sys as sys

AUTHORITY_KIND_FILE :: comptime { "regular file" }
AUTHORITY_KIND_DIRECTORY :: comptime { "directory" }
AUTHORITY_KIND_SPECIAL :: comptime { "special file" }
AUTHORITY_KIND_SYMLINK :: comptime { "symlink" }
AUTHORITY_HARDLINK_DETAIL :: comptime { "authority file must have exactly one hard link" }

// The kind proven by a checked open.
enum AuthorityKind {
    File
    Directory

    fn name(self) -> String Never! {
        if self == {
            .File -> AUTHORITY_KIND_FILE
            .Directory -> AUTHORITY_KIND_DIRECTORY
        }
    }
}

// Stable identity of the object that was opened.
//
// A regular file's identity includes its length and mtime: its bytes were
// read from the opened handle, so drift in either means the snapshot no
// longer describes what was read. A directory is identified by the object
// itself (kind plus device and inode): its length and mtime change whenever a
// legitimate writer creates or removes an entry below the authority root, and
// a path swapped between two observations still yields a different inode.
struct FileIdentity {
    kind: AuthorityKind
    length: Int
    modified_ns: Int?
    device: Int
    inode: Int

    fn from_stat(info: files.Stat, kind: AuthorityKind) -> FileIdentity Never! {
        if kind == AuthorityKind.Directory {
            return FileIdentity{kind: kind, length: 0, modified_ns: None, device: info.id.device, inode: info.id.inode}
        }
        FileIdentity{kind: kind, length: info.size, modified_ns: Val(info.modified.to_unix_ns() ?? panic("file times fit Unix nanoseconds")), device: info.id.device, inode: info.id.inode}
    }
}

// One no-follow opened file and the bytes read from that same handle.
struct CheckedFile {
    path: String
    relative: String
    identity: FileIdentity
    handle: FileReader
    bytes: [U8]

    // Decode the bytes that were read from the opened object.
    fn text(self) -> String AuthorityError! {
        text :: String.from_bytes(self.bytes) ?? return Err(AuthorityError.Invalid{path: self.path, detail: "authority file is not valid UTF-8: {pkg_authority_utf8_error(self.bytes)}"})
        Ok(text)
    }
}

// One checked directory: only descendants own a new no-follow handle.
struct CheckedDirectory {
    path: String
    relative: String
    identity: FileIdentity
    handle: Directory?
    priv allow_hardlinks: Bool
}

// A parsed canonical `package.jet` plus the opened manifest snapshot.
struct CheckedManifest {
    file: CheckedFile
    facts: PackageFacts
}

// A checked member directory and its canonical manifest.
struct CheckedMember {
    directory: CheckedDirectory
    manifest: CheckedManifest
}

// A member snapshot after checked Config composition and member validation.
struct CheckedPackage {
    member: CheckedMember
    facts: PackageFacts
}

// Failure from the shared authority resolver.
#Error
enum AuthorityError {
    Missing(String)
    // `package.jet` parsed as text but violates the manifest vocabulary; kept
    // typed so the registered manifest diagnostics reach the user.
    ManifestParse(path: String, error: PackageParseError)
    IO(path: String, operation: String, detail: String)
    Symlink(String)
    WrongKind(path: String, expected: String, actual: String)
    Escapes(String)
    WorkspaceAmbiguous([String])
    WorkspaceNoModule
    NestedMembers(root: String, member: String)
    Invalid(path: String, detail: String)
    Changed(String)
    Unsupported(String)

    fn is_missing(self) -> Bool Never! {
        if self == {
            .Missing(_) -> true
            else -> false
        }
    }

    // The Rust `Display` text.
    fn message(self) -> String Never! {
        if self == {
            .Missing(path) -> "authority path `{path}` is missing"
            .IO(path, operation, detail) -> "couldn't {operation} `{path}`: {detail}"
            .Symlink(path) -> "authority path `{path}` is a symlink"
            .WrongKind(path, expected, actual) -> "authority path `{path}` is a {actual}, expected a {expected}"
            .Escapes(path) -> "authority path `{path}` escapes its root"
            .WorkspaceAmbiguous(paths) -> "workspace authority is declared in {paths.len()} files"
            .WorkspaceNoModule -> "canonical workspace source has no workspace module"
            .NestedMembers(root, member) -> "Package root `{root}` cannot contain member Package `{member}` with its own members"
            .Invalid(path, detail) -> "invalid authority `{path}`: {detail}"
            .ManifestParse(path, error) -> "invalid manifest `{path}`: {error.message()}"
            .Changed(path) -> "authority object `{path}` changed during resolution"
            .Unsupported(detail) -> detail
        }
    }

    fn diagnostic(self) -> Diagnostic Never! {
        if self == {
            .WorkspaceAmbiguous(paths) -> pkg_e1239_ambiguous_workspace(paths)
            .WorkspaceNoModule -> pkg_e0995_no_workspace_module()
            .NestedMembers(root, member) -> pkg_authority_error_diagnostic("E1323",
                "member Package `{member}` declares `members`",
                "Package membership has depth cap one: `{root}` owns the member list, but `{member}` declares another one",
                "remove `members:` from `{member}` and lift its references into `{root}`")
            .ManifestParse(path, error) -> pkg_manifest_parse_diagnostic(path, error)
            .Missing(path) -> pkg_authority_error_diagnostic("E1334",
                "authority file `{path}` is missing",
                "authority metadata must exist before it can be used",
                "restore the required metadata and try again")
            .Symlink(path) -> pkg_authority_error_diagnostic("E1334",
                "authority path `{path}` is a symlink",
                "authority metadata is opened without following links",
                "replace the symlink with the expected regular file or directory")
            .WrongKind(path, expected, actual) -> pkg_authority_error_diagnostic("E1334",
                "authority path `{path}` is not a {expected}",
                "the opened object is a {actual}, not the required {expected}",
                "replace `{path}` with a {expected}")
            .Escapes(path) -> pkg_authority_error_diagnostic("E1322",
                "authority path `{path}` escapes its root",
                "authority identity is physical and cannot cross the checked root",
                "use a relative path below the authority root")
            .Invalid(path, detail) -> pkg_authority_error_diagnostic("E1334",
                "authority metadata `{path}` is invalid",
                detail,
                "fix the metadata fields and try again")
            .Changed(path) -> pkg_authority_error_diagnostic("E1334",
                "authority object `{path}` changed during resolution",
                "the opened authority snapshot no longer matches the object at its path",
                "restore the authority input and retry the operation")
            .IO(path, operation, detail) -> pkg_authority_error_diagnostic("E1334",
                "couldn't {operation} authority `{path}`",
                detail,
                "restore access to the authority metadata and try again")
            .Unsupported(detail) -> pkg_authority_error_diagnostic("E1334",
                "authority resolution is unavailable on this platform",
                detail,
                "use a platform with descriptor-relative no-follow filesystem access")
        }
    }

    fn workspace_diagnostic(self) -> Diagnostic Never! {
        if self == {
            .ManifestParse(path, error) -> pkg_manifest_parse_diagnostic(path, error)
            .WorkspaceAmbiguous(paths) -> pkg_e1239_ambiguous_workspace(paths)
            .WorkspaceNoModule -> pkg_e0995_no_workspace_module()
            .Symlink(_) -> self.diagnostic()
            .Unsupported(_) -> self.diagnostic()
            else -> pkg_authority_error_diagnostic("E1239",
                "couldn't inspect workspace sources",
                self.message(),
                "restore the workspace metadata and try again")
        }
    }
}

fn pkg_authority_error_diagnostic(code: String, what: String, why: String, fix: String) -> Diagnostic Never! {
    diagnostic_from_registry(code, None, what, why, fix)
}

// Rust `FromUtf8Error` Display: where the first invalid sequence starts.
fn pkg_authority_utf8_error(bytes: [U8]) -> String Never! {
    valid := 0
    loop valid < bytes.len() {
        lead :: Int.from_u8(bytes[valid])
        width :: if {
            lead < 0x80 -> 1
            lead >= 0xC2 && lead <= 0xDF -> 2
            lead >= 0xE0 && lead <= 0xEF -> 3
            lead >= 0xF0 && lead <= 0xF4 -> 4
            else -> 0
        }
        if width == 0 -> break
        if valid + width > bytes.len() -> return "incomplete utf-8 byte sequence from index {valid}"
        if String.from_bytes(bytes[valid..<valid + width]) == .Err(_) -> break
        valid += width
    }
    "invalid utf-8 sequence of 1 bytes from index {valid}"
}

// `authority_limit_error`: every walk/read bound is an `Invalid` detail.
fn pkg_authority_limit_error(path: String, detail: String) -> AuthorityError Never! {
    AuthorityError.Invalid{path: path, detail: detail}
}

// The `kind_name` of a no-follow Stat.
fn pkg_authority_kind_name(info: files.Stat) -> String Never! {
    if {
        info.is_dir -> AUTHORITY_KIND_DIRECTORY
        info.is_file -> AUTHORITY_KIND_FILE
        else -> AUTHORITY_KIND_SPECIAL
    }
}

// `kind_name_from_file_type`: a directory entry kind, links included.
fn pkg_authority_entry_kind_name(info: files.Stat) -> String Never! {
    if {
        info.is_dir -> AUTHORITY_KIND_DIRECTORY
        info.is_file -> AUTHORITY_KIND_FILE
        info.is_symlink -> AUTHORITY_KIND_SYMLINK
        else -> AUTHORITY_KIND_SPECIAL
    }
}

// `require_single_link_file`.
fn pkg_authority_require_single_link(path: String, info: files.Stat) AuthorityError! {
    if info.links == 1 -> return
    return Err(AuthorityError.Invalid{path: path, detail: AUTHORITY_HARDLINK_DETAIL})
}

// The OS error number behind a provider failure, when known.
fn pkg_io_os_code(error: IOError) -> Int? Never! {
    if error == {
        .InvalidInput(context) | .NotFound(context) | .PermissionDenied(context) |
        .TimedOut(context) | .Cancelled(context) | .Closed(context) |
        .Protocol(context) | .Other(context) | .AlreadyExists(context) |
        .Unsupported(context) -> context.os_code
        else -> None
    }
}

// ELOOP: the final component was a link opened with no-follow.
fn pkg_io_is_symlink_error(error: IOError) -[Env]> Bool Never! {
    code :: pkg_io_os_code(error) ?? return false
    if sys.is_linux() -> return code == 40
    if sys.is_macos() -> return code == 62
    false
}

// ENOTDIR: a directory open reached a non-directory.
fn pkg_io_is_not_a_directory(error: IOError) -> Bool Never! {
    code :: pkg_io_os_code(error) ?? return false
    code == 20
}

fn pkg_io_is_not_found(error: IOError) -> Bool Never! {
    if error == {
        .NotFound(_) -> true
        else -> false
    }
}

// `map_io`: the typed authority failure of one open.
fn pkg_authority_map_io(path: String, error: IOError, directory: Bool) -[Env]> AuthorityError Never! {
    if pkg_io_is_not_found(error) -> return AuthorityError.Missing(path)
    if pkg_io_is_symlink_error(error) -> return AuthorityError.Symlink(path)
    if directory && pkg_io_is_not_a_directory(error) {
        return AuthorityError.WrongKind{path: path, expected: AUTHORITY_KIND_DIRECTORY, actual: AUTHORITY_KIND_FILE}
    }
    operation :: if directory -> "open directory" else -> "open file"
    AuthorityError.IO{path: path, operation: operation, detail: "{error}"}
}

// `root.join(relative)`: an empty relative keeps Rust's trailing separator.
fn pkg_authority_join(root: String, relative: String) -> String Never! {
    if relative == "" {
        if root.ends_with("/") -> return root.copy()
        return "{root}/"
    }
    files.join(root, relative)
}

// Whether `path` is `root` itself or lies below it, component-wise.
fn pkg_authority_path_within(path: String, root: String) -> Bool Never! {
    trimmed :: if root.ends_with("/") && root != "/" -> root.removesuffix("/") else -> root
    if path == trimmed || path == ("{trimmed}/") -> return true
    if trimmed == "/" -> return path.starts_with("/")
    path.starts_with("{trimmed}/")
}

// `Path::extension`: the text after the last `.` of the final component,
// unless that dot starts the name.
fn pkg_authority_extension(name: String) -> String? Never! {
    raw :: name.bytes()
    index := raw.len() - 1
    loop index > 0 {
        if Int.from_u8(raw[index]) == 46 -> return Val(String.from_bytes(raw[index + 1..<raw.len()]) ?? "")
        index -= 1
    }
    None
}
