// Rust: crates/jet-pkg-model/src/Authority.rs:1596
struct SourceListing {
    entries: Int
    sources: [OSPath]
    stale_manifest: Bool
}
// Rust: crates/jet-pkg-model/src/Authority.rs:1607
LISTING_SETTLE_FINE_NS :: prep { U128{50_000_000} }
// Rust: crates/jet-pkg-model/src/Authority.rs:1608
LISTING_SETTLE_COARSE_NS :: prep { U128{2_000_000_000} }
// Rust: crates/jet-pkg-model/src/Authority.rs:1611
// GATE #4494: shared cache is process-global and locked, never a local replacement.
SOURCE_LISTINGS :: LazyLock<Mutex<[(U64, U64):(U128, Arc<SourceListing>) ]>>.new(() -> Mutex.new([(U64, U64):(U128, Arc<SourceListing>)]{}))

// Rust: crates/jet-pkg-model/src/Authority.rs:1615
fn listing_stamp(dir: OSPath) -[FS.Read]> (U64, U64, U128)? {
    if core.sys.target.selected_family() != "unix" -> return None // GATE #4483
    // GATE #4494/#4483: std metadata/time projection keeps original u128 epoch.
    metadata :: std.fs.metadata(dir).ok() ?? return None
    modified :: metadata.modified().ok() ?? return None
    duration :: modified.duration_since(UNIX_EPOCH).ok() ?? return None
    Val((metadata.dev(), metadata.ino(), duration.as_nanos()))
}

// Rust: crates/jet-pkg-model/src/Authority.rs:1642
// Listings may be cached only after stable before/after stamps AND timestamp
// granularity has elapsed. File bytes are never cached here.
fn source_listing(dir: OSPath, map_read: fn(IOError) -> AuthorityError) -[FS.Read, Time]> Arc<SourceListing> AuthorityError! {
    before :: listing_stamp(dir)
    if before == {
        .Val((device, inode, modified)) -> {
            memoized: Arc<SourceListing>? = None
            if SOURCE_LISTINGS.lock() == {
                .Ok(memo) -> {
                    if memo.get((device, inode)) == {
                        .Val((stamp, listing)) -> { if stamp == modified -> memoized = Val(Arc.clone(listing)) }
                        .None -> {}
                    }
                }
                .Err(_) -> {}
            }
            if memoized == { .Val(listing) -> return Ok(listing); .None -> {} }
        }
        .None -> {}
    }
    // GATE #4494: native name/stream producers from the retained descriptor ABI.
    directory :: authority_io.open_directory(dir, pkg_authority_open_options()) ?? return Err(map_read(err))
    stream := directory.entries() ?? return Err(map_read(err))
    entries := 0
    sources := [OSPath]{}
    stale_manifest := false
    loop {
        maybe :: stream.next() ?? return Err(AuthorityError.IO{path: path_components.display(dir), operation: "inspect", detail: "{err}"})
        entry :: maybe ?? break
        entries += 1
        name :: entry.file_name()
        if pkg_authority_extension(name) == Val(FILE_EXT) {
            &sources.push(name)
        } else {
            if path_components.to_str(name) == {
                .Val(text) -> { if STALE_MANIFEST_NAMES.contains(text) -> stale_manifest = true }
                .None -> {}
            }
        }
    }
    &sources.sort_by(name -> name.encoded)
    listing :: Arc.new(SourceListing{entries: entries, sources: ^sources, stale_manifest: stale_manifest})
    after :: listing_stamp(dir)
    if before == {
        .Val((device, inode, modified)) -> {
            settle :: if modified % U128{1_000_000_000} == U128{0} -> LISTING_SETTLE_COARSE_NS else -> LISTING_SETTLE_FINE_NS
            // GATE #4494/#4483: original wall-clock epoch and wide saturating age.
            settled :: if SystemTime.now().duration_since(UNIX_EPOCH) == {
                .Ok(now) -> now.as_nanos().saturating_sub(modified) > settle
                .Err(_) -> false
            }
            if after == Val((device, inode, modified)) && settled {
                if SOURCE_LISTINGS.lock() == {
                    .Ok(memo) -> { &memo.insert((device, inode), (modified, Arc.clone(listing))) }
                    .Err(_) -> {}
                }
            }
        }
        .None -> {}
    }
    Ok(listing)
}
// Rust: crates/jet-pkg-model/src/Authority.rs:1704
fn has_authority_candidate(root: OSPath) -[FS.Read, Time, Env]> Bool AuthorityError! {
    listing :: source_listing(root, error -> pkg_authority_map_io(root, error, true))
    Ok(!listing.sources.is_empty() || listing.stale_manifest)
}
