impl AuthorityWalkBudget {
    // Rust: crates/jet-pkg-model/src/Authority.rs:1535
    pub fn note_entries(&self, path: OSPath, count: Int) -> AuthorityError! {
        if self.entries.saturating_add(count) > PKG_MAX_TREE_FILES {
            return Err(pkg_authority_limit_error(path, "authority directory walk exceeds the {PKG_MAX_TREE_FILES}-entry bound"))
        }
        self.entries += count
    }
}
