// Compiler/package projection for the runtime-owned model contract
// (jet-pkg-model Model.rs). This home owns only the package-manifest
// projection (a `.Model` output of PackageFacts -> a model descriptor) and the
// authority-bound artifact verification used while loading a package.
//
// DEPENDS ON D-CORE-MODELDESC1 (still OPEN): written against option A, where
// core.models publishes ModelDescriptor, ModelFile, TensorSpec, TensorType,
// TensorDim, ModelPackage, ModelError, and `models.check(descriptor)`. The
// Rust kernel (`jet_rt::model`) is retired by that cutover; the checks it ran
// (`ModelPackage::from_descriptor`) are `models.check`.

// The only fields a `.Model` output may declare.
@MODEL_ALLOWED_FIELDS :: [String]{
    "name",
    "graph", "graph_sha256",
    "weights", "weights_sha256",
    "tokenizer", "tokenizer_sha256",
    "adapter", "adapter_sha256",
    "inputs", "outputs",
    "provider", "preprocessing", "pooling", "normalization", "output_meaning", "metric",
    "custom_operators", "max_context", "max_batch", "max_buffer_bytes"
}
@MODEL_TENSOR_FIELDS :: [String]{"name", "dtype", "shape"}
@MODEL_DIMENSION_FIELDS :: [String]{"name", "min", "max"}
@MODEL_MAX_RANK :: 64

// Rust `ModelError::load`: a load failure reported against `<package>`.
fn pkg_model_load_error(package: String, reason: String) -> models.ModelError Never! {
    models.ModelError.Artifact(package: package, path: "<package>", reason: reason)
}

fn pkg_model_declaration(package: String, reason: String) -> models.ModelError Never! {
    models.ModelError.Declaration(package: package, reason: reason)
}

fn pkg_model_provenance(package: String, reason: String) -> models.ModelError Never! {
    models.ModelError.Provenance(package: package, reason: reason)
}

// Parse `source` as a package and project its `.Model` output `output_name`.
pub fn pkg_model_descriptor_from_source(source: String, origin: String, output_name: String) -> models.ModelDescriptor models.ModelError! {
    facts :: PackageFacts.parse(source, origin) ?? return Err(pkg_model_load_error(origin, err.message()))
    Ok(pkg_model_descriptor_from_facts(facts, output_name))
}

// The checked model package of one `.Model` output (Rust
// `ModelPackage::from_facts`).
pub fn pkg_model_from_facts(facts: PackageFacts, output_name: String) -> models.ModelPackage models.ModelError! {
    models.check(pkg_model_descriptor_from_facts(facts, output_name))
}

// The declared descriptor of one `.Model` output, before the Core check.
pub fn pkg_model_descriptor_from_facts(facts: PackageFacts, output_name: String) -> models.ModelDescriptor models.ModelError! {
    output :: facts.outputs.get(output_name) ?? return Err(models.ModelError.MissingOutput(package: facts.name, output: output_name))
    if output.kind != PackageOutputKind.Model {
        return Err(models.ModelError.WrongKind(package: facts.name, output: output_name))
    }
    pkg_model_descriptor_from_output(facts, output_name, output)
}

// Load the package at `root`, project `output_name`, check it, and verify
// every artifact's bytes through the authority resolver.
pub fn pkg_model_load(root: String, output_name: String) -[FS, Env]> models.ModelPackage models.ModelError! {
    loaded :: PackageFacts.load_checked(root) ?? return Err(pkg_model_load_error("<package>", err.message()))
    facts :: loaded ?? return Err(models.ModelError.MissingPackage(root: root))
    package :: pkg_model_from_facts(facts, output_name)
    pkg_model_verify_artifacts(package, root)
    Ok(package)
}

fn pkg_model_descriptor_from_output(facts: PackageFacts, output_name: String, output: OutputFact) -> models.ModelDescriptor models.ModelError! {
    package :: facts.name
    version :: pkg_model_required_package_field(facts.version, package, "version")
    license :: pkg_model_required_package_field(facts.license, package, "license")
    fields :: pkg_model_object_payload(package, output_name, output.payload)
    pkg_model_validate_fields(fields, package, output_name)
    Ok(models.ModelDescriptor{
        package: package,
        output: output_name,
        signature: pkg_model_optional_string(fields, package, output_name, "name"),
        version: version,
        license: license,
        graph: pkg_model_artifact(fields, package, output_name, "graph"),
        weights: pkg_model_artifact(fields, package, output_name, "weights"),
        tokenizer: pkg_model_artifact(fields, package, output_name, "tokenizer"),
        adapter: pkg_model_optional_artifact(fields, package, output_name, "adapter"),
        inputs: pkg_model_tensor_list(fields, package, output_name, "inputs"),
        outputs: pkg_model_tensor_list(fields, package, output_name, "outputs"),
        provider: pkg_model_required_string(fields, package, output_name, "provider"),
        preprocessing: pkg_model_required_string(fields, package, output_name, "preprocessing"),
        pooling: pkg_model_required_string(fields, package, output_name, "pooling"),
        normalization: pkg_model_required_string(fields, package, output_name, "normalization"),
        meaning: pkg_model_required_string(fields, package, output_name, "output_meaning"),
        metric: pkg_model_required_string(fields, package, output_name, "metric"),
        custom_operators: pkg_model_optional_bool(fields, package, output_name, "custom_operators") ?? false,
        max_context: pkg_model_optional_u64(fields, package, output_name, "max_context"),
        max_batch: pkg_model_optional_u64(fields, package, output_name, "max_batch"),
        max_buffer_bytes: pkg_model_optional_u64(fields, package, output_name, "max_buffer_bytes")
    })
}

// Hash every distinct artifact through a fresh authority resolver pinned at
// `root`; a digest that differs from the declaration is a provenance failure.
fn pkg_model_verify_artifacts(package: models.ModelPackage, root: String) models.ModelError! -[FS, Env]> {
    checked_paths := [String: Bool]{}
    loop artifact in package.files {
        if checked_paths.has_key(artifact.path) -> next
        checked_paths[artifact.path] = true
        resolver :: AuthorityResolver.open(root) ?? return Err(models.ModelError.Artifact(package: package.name, path: artifact.path, reason: err.message()))
        checked :: resolver.checked_file(artifact.path) ?? return Err(models.ModelError.Artifact(package: package.name, path: artifact.path, reason: err.message()))
        actual :: pkg_sha256_hex(checked.bytes)
        if actual != artifact.sha256 {
            return Err(pkg_model_provenance(package.name, "artifact `{artifact.path}` hash is `{actual}`, expected `{artifact.sha256}`"))
        }
    }
    Ok()
}

fn pkg_model_validate_fields(fields: [String: OutputPayload], package: String, output: String) models.ModelError! {
    names := fields.keys().to_list()
    &names.sort()
    loop field in names {
        if !@MODEL_ALLOWED_FIELDS.contains(field) {
            return Err(pkg_model_declaration(package, "output `{output}` has unknown model field `{field}`"))
        }
    }
    Ok()
}

fn pkg_model_object_payload(package: String, output: String, value: OutputPayload) -> [String: OutputPayload] models.ModelError! {
    if value == {
        .Object(fields) -> Ok(fields)
        else -> Err(pkg_model_declaration(package, "output `{output}` must carry an object payload"))
    }
}

fn pkg_model_artifact(fields: [String: OutputPayload], package: String, output: String, role: String) -> models.ModelFile models.ModelError! {
    path :: pkg_model_required_string(fields, package, output, role)
    hash :: pkg_model_required_string(fields, package, output, "{role}_sha256")
    Ok(models.ModelFile{path: path, sha256: hash})
}

fn pkg_model_optional_artifact(fields: [String: OutputPayload], package: String, output: String, role: String) -> models.ModelFile? models.ModelError! {
    path :: fields.get(role)
    hash :: fields.get("{role}_sha256")
    if path == None && hash == None -> return Ok(None)
    path_value :: path ?? return Err(pkg_model_provenance(package, "optional `{role}` and `{role}_sha256` must be declared together"))
    hash_value :: hash ?? return Err(pkg_model_provenance(package, "optional `{role}` and `{role}_sha256` must be declared together"))
    Ok(Val(models.ModelFile{
        path: pkg_model_payload_string(path_value, package, output, role),
        sha256: pkg_model_payload_string(hash_value, package, output, "{role}_sha256")
    }))
}

fn pkg_model_tensor_list(fields: [String: OutputPayload], package: String, output: String, field: String) -> [models.TensorSpec] models.ModelError! {
    value :: fields.get(field) ?? return Err(pkg_model_declaration(package, "output `{output}` is missing `{field}`"))
    values :: if value == {
        .Array(items) -> items
        else -> {
            return Err(pkg_model_declaration(package, "output `{output}` field `{field}` must be an array"))
        }
    }
    if values.len() == 0 -> return Err(pkg_model_declaration(package, "output `{output}` field `{field}` must not be empty"))
    specs := [models.TensorSpec]{}
    loop item in values -> &specs.push(pkg_model_tensor_spec(item, package, output, field))
    Ok(specs)
}

fn pkg_model_tensor_spec(value: OutputPayload, package: String, output: String, field: String) -> models.TensorSpec models.ModelError! {
    fields :: if value == {
        .Object(entries) -> entries
        else -> {
            return Err(pkg_model_declaration(package, "output `{output}` field `{field}` tensor must be an object"))
        }
    }
    names := fields.keys().to_list()
    &names.sort()
    loop name in names {
        if !@MODEL_TENSOR_FIELDS.contains(name) {
            return Err(pkg_model_declaration(package, "output `{output}` field `{field}` has unknown tensor field `{name}`"))
        }
    }
    name :: pkg_model_required_string(fields, package, output, "name")
    dtype_text :: pkg_model_required_string(fields, package, output, "dtype")
    dtype :: models.TensorType.parse(dtype_text) ?? return Err(pkg_model_declaration(package, "tensor `{name}` has unsupported dtype `{dtype_text}`"))
    shape :: fields.get("shape") ?? return Err(pkg_model_declaration(package, "tensor `{name}` is missing a shape"))
    Ok(models.TensorSpec{name: name, dtype: dtype, shape: pkg_model_tensor_shape(shape, package, output, field)})
}

fn pkg_model_tensor_shape(value: OutputPayload, package: String, output: String, field: String) -> [models.TensorDim] models.ModelError! {
    values :: if value == {
        .Array(items) -> items
        else -> {
            return Err(pkg_model_declaration(package, "output `{output}` field `{field}` shape must be an array"))
        }
    }
    if values.len() == 0 || values.len() > @MODEL_MAX_RANK {
        return Err(pkg_model_declaration(package, "output `{output}` field `{field}` has invalid rank"))
    }
    dimensions := [models.TensorDim]{}
    loop item in values -> &dimensions.push(pkg_model_tensor_dimension(item, package, output, field))
    Ok(dimensions)
}

fn pkg_model_tensor_dimension(value: OutputPayload, package: String, output: String, field: String) -> models.TensorDim models.ModelError! {
    if value == {
        .Number(number) -> {
            size :: pkg_model_parse_u64(number) ?? return Err(pkg_model_declaration(package, "output `{output}` field `{field}` has an invalid static dimension"))
            if size == 0 -> return Err(pkg_model_declaration(package, "output `{output}` field `{field}` has an invalid static dimension"))
            Ok(models.TensorDim.Fixed(size))
        }
        .Object(fields) -> {
            names := fields.keys().to_list()
            &names.sort()
            loop name in names {
                if !@MODEL_DIMENSION_FIELDS.contains(name) {
                    return Err(pkg_model_declaration(package, "output `{output}` field `{field}` has unknown dimension field `{name}`"))
                }
            }
            name :: pkg_model_required_string(fields, package, output, "name")
            min :: pkg_model_payload_u64(fields.get("min"), package, output, "min")
            max :: pkg_model_payload_u64(fields.get("max"), package, output, "max")
            if min == 0 || min > max {
                return Err(pkg_model_declaration(package, "output `{output}` field `{field}` has invalid dynamic bounds"))
            }
            Ok(models.TensorDim.Named(name: name, min: min, max: max))
        }
        else -> Err(pkg_model_declaration(package, "output `{output}` field `{field}` must be a number or bounded dimension"))
    }
}

// A package field that model outputs require pinned: non-blank after trim
// and free of ASCII control bytes.
fn pkg_model_required_package_field(value: String?, package: String, field: String) -> String models.ModelError! {
    raw :: value ?? return Err(pkg_model_provenance(package, "package `{field}` must be pinned for model outputs"))
    trimmed :: raw.trim()
    if trimmed == "" -> return Err(pkg_model_provenance(package, "package `{field}` must be pinned for model outputs"))
    if pkg_model_has_ascii_control(trimmed) -> return Err(pkg_model_provenance(package, "package `{field}` contains a control character"))
    Ok(trimmed)
}

fn pkg_model_required_string(fields: [String: OutputPayload], package: String, output: String, field: String) -> String models.ModelError! {
    value :: fields.get(field) ?? return Err(pkg_model_declaration(package, "output `{output}` is missing `{field}`"))
    pkg_model_payload_string(value, package, output, field)
}

fn pkg_model_optional_string(fields: [String: OutputPayload], package: String, output: String, field: String) -> String? models.ModelError! {
    value :: fields.get(field) ?? return Ok(None)
    Ok(Val(pkg_model_payload_string(value, package, output, field)))
}

fn pkg_model_payload_string(value: OutputPayload, package: String, output: String, field: String) -> String models.ModelError! {
    if value == {
        .String(text) -> {
            if text.trim() == "" -> return Err(pkg_model_declaration(package, "output `{output}` field `{field}` must be a non-empty string"))
            if pkg_model_has_ascii_control(text) {
                return Err(pkg_model_declaration(package, "output `{output}` field `{field}` contains a control character"))
            }
            Ok(text)
        }
        else -> Err(pkg_model_declaration(package, "output `{output}` field `{field}` must be a non-empty string"))
    }
}

fn pkg_model_optional_bool(fields: [String: OutputPayload], package: String, output: String, field: String) -> Bool? models.ModelError! {
    value :: fields.get(field) ?? return Ok(None)
    if value == {
        .Bool(flag) -> Ok(Val(flag))
        else -> Err(pkg_model_declaration(package, "output `{output}` field `{field}` must be a boolean"))
    }
}

fn pkg_model_optional_u64(fields: [String: OutputPayload], package: String, output: String, field: String) -> Int? models.ModelError! {
    value :: fields.get(field) ?? return Ok(None)
    Ok(Val(pkg_model_payload_u64(Val(value), package, output, field)))
}

fn pkg_model_payload_u64(value: OutputPayload?, package: String, output: String, field: String) -> Int models.ModelError! {
    present :: value ?? return Err(pkg_model_declaration(package, "output `{output}` field `{field}` must be a non-negative integer"))
    if present == {
        .Number(text) -> {
            parsed :: pkg_model_parse_u64(text) ?? return Err(pkg_model_declaration(package, "output `{output}` field `{field}` must be a non-negative integer"))
            Ok(parsed)
        }
        else -> Err(pkg_model_declaration(package, "output `{output}` field `{field}` must be a non-negative integer"))
    }
}

// Rust `str::parse::<u64>`: an optional `+`, then ASCII digits only.
fn pkg_model_parse_u64(text: String) -> Int? Never! {
    digits :: text.removeprefix("+")
    if digits == "" -> return None
    loop byte in digits.bytes() {
        code :: Int.from_u8(byte)
        if code < 48 || code > 57 -> return None
    }
    Int.parse(digits) ?? None
}

fn pkg_model_has_ascii_control(text: String) -> Bool Never! {
    loop byte in text.bytes() {
        code :: Int.from_u8(byte)
        if code < 32 || code == 127 -> return true
    }
    false
}
