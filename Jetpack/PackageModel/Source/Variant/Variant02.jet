// Rust: crates/jet-pkg-model/src/Variant.rs:489
// VariantSelectError -> Variant.jet:486 #Error NoMatch/Ambiguous exact payloads.
impl VariantSelectError {
    // Rust: crates/jet-pkg-model/src/Variant.rs:502
    pub fn to_diagnostic(self) -> Diagnostic {
        if self == {
            .NoMatch(need, candidate_count) -> Diagnostic.error(
                "E1316",
                "no package variant matches need `{need.identity_key()}` among {candidate_count} candidate(s)",
                "Native selection uses only the closed typed axes (D-JPK-VARIANT1); none of the offered producers are exact or compatible.",
                "Add a producer for this domain, loosen the need, or map provider facts with `variant_map`.",
                None
            )
            .Ambiguous(need, axis, labels) -> e1316_ambiguous(need, axis.as_str(), labels)
        }
    }
}

// Rust: crates/jet-pkg-model/src/Variant.rs:527
pub fn e1316_ambiguous(need: PackageVariant, axis: String, labels: [String]) -> Diagnostic {
    listed :: labels.join(", ")
    Diagnostic.error(
        "E1316",
        "ambiguous package variants for need `{need.identity_key()}`: {listed} (first distinguishing axis: {axis})",
        "Matching is exact-then-compatible under one total order; an ambiguous tie is never a silent pick (D-JPK-VARIANT1).",
        "Add a `variant_map`, pin one candidate, or make the need more specific on the named axis.",
        None
    )
}

