//RS //! `BuildRecipe` data model (D-JPK-ADAPTER1=A safety contract).
//RS //!
//RS //! A `BuildRecipe` turns a staged source tree into a realized package under a
//RS //! confined, auditable build. This is the pure **data** half of the build
//RS //! substrate — the struct/enum the `Build(BuildRecipe)` plan variant carries.
//RS //! The engine (`validate`/`run`/`run_logged`, sandboxing, fetch/exec/install,
//RS //! trust gate) stays in `jetpack`'s `Recipe.rs`, which imports `BuildRecipe`
//RS //! from here (card #367 slice 4, data-down / engine-up).
//RS //!
//RS //! std-only (I6).
//RS 
//RS use crate::SHA256;
//RS use jet_foundation::BuildEffect;
//RS use std::collections::{BTreeMap, BTreeSet};
//RS use std::fmt;
//RS use std::path::{Component, Path};
//RS 
//RS /// One step of a build recipe. Names are internal; the user-facing spellings are
//RS /// the finite `Recipe.build(steps: […])` forms from D-JPK-BUILDRECIPE1.
//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub enum BuildStep {
//RS     /// A locked network fetch. `sha256` must be present; an empty hash is
//RS     /// ungranted ambient network (`E1236`).
//RS     Fetch { url: String, sha256: String },
//RS     /// Run a build tool. `tool` must be the name of a realized `Pkg` dep in the
//RS     /// `BuildContext.tools` map — never resolved from host PATH (`E1238`).
//RS     Exec { tool: String, args: Vec<String> },
//RS     /// Copy `src` (relative to the source dir) to `dest` under the output root.
//RS     /// `dest` must resolve inside the output root (`E1237`).
//RS     Install { src: String, dest: String },
//RS     /// Copy a whole directory tree relative to the source dir into `dest`
//RS     /// under the output root. Used by `Recipe.copy()`.
//RS     InstallTree { src: String, dest: String },
//RS }
//RS 
//RS /// A build recipe over a staged source tree.
//RS #[derive(Debug, Clone, PartialEq, Eq, Default)]
//RS pub struct BuildRecipe {
//RS     pub steps: Vec<BuildStep>,
//RS }
