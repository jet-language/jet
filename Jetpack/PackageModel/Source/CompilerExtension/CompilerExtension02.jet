impl ExtensionProtocolError {
    // Rust: crates/jet-pkg-model/src/CompilerExtension.rs:218
    // GATE #4499: the standard formatter protocol; preserve the exact message.
    fn fmt(self, formatter: &std.fmt.Formatter) -> std.fmt.Result {
        &formatter.write_str(self.message)
    }
}

