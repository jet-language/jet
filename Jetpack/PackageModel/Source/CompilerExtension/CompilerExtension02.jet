//RS /// Host-side lifecycle for one extension instance.
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum SessionPhase {
//RS     Idle,
//RS     Loaded,
//RS     Closed,
//RS }
//RS 
//RS /// Session state machine: staging is ephemeral; rollback discards staged only
//RS /// (accept latch stays final); close invokes the guest closer so WASM memory
//RS /// is dropped.
//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub struct ExtensionSession {
//RS     phase: SessionPhase,
//RS     handle: Option<u64>,
//RS     staged: Option<AnalyzeResponse>,
//RS     /// True only after host explicitly accepts staged output (never auto).
//RS     committed: bool,
//RS }
//RS 
//RS impl ExtensionSession {
//RS     pub fn new() -> Self {
//RS         Self {
//RS             phase: SessionPhase::Idle,
//RS             handle: None,
//RS             staged: None,
//RS             committed: false,
//RS         }
//RS     }
//RS 
//RS     pub fn phase(&self) -> SessionPhase {
//RS         self.phase
//RS     }
//RS 
//RS     pub fn is_committed(&self) -> bool {
//RS         self.committed
//RS     }
//RS 
//RS     pub fn staged(&self) -> Option<&AnalyzeResponse> {
//RS         self.staged.as_ref()
//RS     }
//RS 
//RS     pub fn on_loaded(&mut self, handle: u64) -> Result<(), ProtocolError> {
//RS         if self.phase != SessionPhase::Idle {
//RS             return Err(ProtocolError::new(
//RS                 "extension session can only load from Idle",
//RS             ));
//RS         }
//RS         if handle == 0 {
//RS             return Err(ProtocolError::new("handle 0 is the error sentinel"));
//RS         }
//RS         self.handle = Some(handle);
//RS         self.phase = SessionPhase::Loaded;
//RS         Ok(())
//RS     }
//RS 
//RS     /// Validate guest bytes and stage them. Does not commit into compiler state.
//RS     pub fn stage_response(
//RS         &mut self,
//RS         snapshot: &TypedSnapshot,
//RS         bytes: &[u8],
//RS     ) -> Result<&AnalyzeResponse, ProtocolError> {
//RS         if self.phase != SessionPhase::Loaded {
//RS             return Err(ProtocolError::new(
//RS                 "stage_response requires a Loaded session",
//RS             ));
//RS         }
//RS         if self.committed {
//RS             return Err(ProtocolError::new(
//RS                 "session already committed; open a new session",
//RS             ));
//RS         }
//RS         let response = decode_and_validate_response(snapshot, bytes)?;
//RS         self.staged = Some(response);
//RS         Ok(self.staged.as_ref().unwrap())
//RS     }
//RS 
//RS     /// Discard staged findings/edits only. Compiler facts unchanged.
//RS     /// Does **not** clear the accept latch — after [`Self::accept_staged`],
//RS     /// rollback cannot reopen staging; open a new session instead.
//RS     pub fn rollback(&mut self) {
//RS         self.staged = None;
//RS     }
//RS 
//RS     /// Host-only accept of staged output. Still does not call rustc (I2/I3).
//RS     pub fn accept_staged(&mut self) -> Result<AnalyzeResponse, ProtocolError> {
//RS         if self.phase != SessionPhase::Loaded {
//RS             return Err(ProtocolError::new("accept requires Loaded session"));
//RS         }
//RS         let staged = self
//RS             .staged
//RS             .take()
//RS             .ok_or_else(|| ProtocolError::new("nothing staged to accept"))?;
//RS         self.committed = true;
//RS         Ok(staged)
//RS     }
//RS 
//RS     /// Close the session and drop the guest via `close_guest(handle)`.
//RS     ///
//RS     /// Host path must pass the WASM runtime closer
//RS     /// (`jet_compiler_extension_close` in `Prelude/CompilerExtension.rs`) so
//RS     /// the guest `Store`/linear memory is freed. Returns whatever the closer
//RS     /// reports (or `false` when no handle was live). Clears staged output;
//RS     /// session ends in [`SessionPhase::Closed`].
//RS     pub fn close(&mut self, close_guest: impl FnOnce(u64) -> bool) -> bool {
//RS         let handle = self.handle.take();
//RS         self.staged = None;
//RS         self.committed = false;
//RS         self.phase = SessionPhase::Closed;
//RS         match handle {
//RS             Some(h) => close_guest(h),
//RS             None => false,
//RS         }
//RS     }
//RS }
