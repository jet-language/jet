//RS     ApplicationPlugin,
//RS     /// D-DX5-HOOK1=A: compiler-extension WASM component (this module).
//RS     CompilerExtension,
//RS }
//RS 
//RS /// Wire protocol version for the typed post-sema snapshot contract.
