fn json_usize(value: DataTree, name: String) -> UInt ExtensionProtocolError! {
    n :: pkg_extension_json_u64(value, name)
    UInt.try_from(n).map_err(_ -> ExtensionProtocolError.new("`{name}` out of range"))
}

