// Rust: crates/jet-pkg-model/src/Platform.rs:65
pub fn path_separator() -> String {
    // GATE #4483: target selection supplies Rust's target OS constant.
    pkg_path_separator_for_os(core.sys.target.selected_os())
}

// Rust: crates/jet-pkg-model/src/Platform.rs:72
pub fn clean_path() -> String {
    // GATE #4483: preserve both cfg arms independently of build-host OS.
    if core.sys.target.selected_family() == "windows" {
        "C:\\Windows\\System32;C:\\Windows"
    } else {
        "/usr/bin:/bin"
    }
}

// Rust: crates/jet-pkg-model/src/Platform.rs:80
// exe_suffix_for_os -> pkg_exe_suffix_for_os (Platform.jet:79).
// Rust: crates/jet-pkg-model/src/Platform.rs:88
pub fn exe_suffix() -> String {
    // GATE #4483: Rust std::env::consts::OS is the selected target.
    pkg_exe_suffix_for_os(core.sys.target.selected_os())
}

// Rust: crates/jet-pkg-model/src/Platform.rs:92
pub fn shell_command(script: String) -> Command {
    // GATE #4494: native command builder, not a Rust execution bridge.
    // GATE #4483: original windows and non-windows cfg arms.
    if core.sys.target.selected_family() == "windows" {
        cmd := Command.new("cmd")
        &cmd.args([String]{"/C", ^script})
        ^cmd
    } else {
        cmd := Command.new("sh")
        &cmd.arg("-c")
        &cmd.arg(^script)
        ^cmd
    }
}

