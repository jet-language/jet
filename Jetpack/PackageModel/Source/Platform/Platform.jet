// U25 (D-JPK-PLATFORM1=A): Jetpack's tier-1 platform contract.
//
// Jetpack is a native product on Linux, macOS, and Windows. Target spelling,
// PATH separators, and executable suffixes live in this one module so platform
// handling does not drift across providers, the hangar envelope, services,
// secrets, and trust code.

@OS_LINUX :: "linux"
@OS_MACOS :: "macos"
@OS_WINDOWS :: "windows"

@ARCH_X64 :: "x86_64"
@ARCH_ARM64 :: "aarch64"

@TIER_ONE_OSES :: [String]{@OS_LINUX, @OS_MACOS, @OS_WINDOWS}
@TIER_ONE_ARCHES :: [String]{@ARCH_X64, @ARCH_ARM64}

// An `arch-os` target identity. The fields stay open strings because a host
// key may name a platform outside tier one; `is_tier_one` reports that fact.
pub struct PlatformKey {
    pub arch: String
    pub os: String

    // A tier-one key, or None when either half is outside tier one.
    fn new(arch: String, os: String) -> PlatformKey? Never! {
        if !pkg_is_tier_one(arch, os) -> return None
        Val(PlatformKey{arch: arch, os: os})
    }

    fn envelope_key(self) -> String Never! {
        "{self.arch}-{self.os}"
    }

    fn is_tier_one(self) -> Bool Never! {
        pkg_is_tier_one(self.arch, self.os)
    }
}

fn pkg_is_tier_one(arch: String, os: String) -> Bool Never! {
    arch_ok :: if arch == {
        @ARCH_X64 | @ARCH_ARM64 -> true
        else -> false
    }
    os_ok :: if os == {
        @OS_LINUX | @OS_MACOS | @OS_WINDOWS -> true
        else -> false
    }
    arch_ok && os_ok
}

pub fn pkg_path_separator_for_os(os: String) -> String Never! {
    if os == @OS_WINDOWS -> return ";"
    ":"
}

pub fn pkg_exe_suffix_for_os(os: String) -> String Never! {
    if os == @OS_WINDOWS -> return ".exe"
    ""
}
