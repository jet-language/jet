// `.jetlib` loadable-library artifact identity and header codec
// (jet-pkg-model JetLib.rs, cards #1421/#1345).
//
// A `.jetlib` is a checked stamp followed by the opaque native payload. The
// stamp carries the exact compiler/build/target/linker/ABI identity, the
// Library name, the checked export table, the payload digest, and the effects
// the library's own code declares. The load site parses and checks the whole
// header before it writes or maps the payload (JetLibTrust.jet).

@JETLIB_MAGIC :: "jet-jetlib-v3"
// The ABI table version, independent of the compiler version.
@JETLIB_ABI_VERSION :: 2
// The complete native boundary identity: a data value the driver records and
// the loader gates, not a second policy table.
@JETLIB_ABI_IDENTITY :: "jet.library.abi.v2;call=extern-c;scalar=homogeneous;access=read-write-move;text=jet-text-v1;ptr-len=checked-utf8"
@JETLIB_MAX_HEADER_ITEMS :: 4096
@JETLIB_MAX_HEADER_FIELD_BYTES :: 1048576
@JETLIB_MAX_EXPORT_PARAMS :: 4096

// Why a `.jetlib` header or artifact was refused; `message` is the reference text.
#Error
pub struct JetLibError {
    pub message: String

    fn new(message: String) -> JetLibError Never! {
        JetLibError{message: message}
    }
}

// The one scalar vocabulary D-EMBED1 admits for native Library rows.
pub enum JetLibScalar {
    Int
    Float
    Bool
    Text

    fn tag(self) -> Int Never! {
        if self == {
            .Int -> 0
            .Float -> 1
            .Bool -> 2
            .Text -> 3
        }
    }

    fn from_tag(code: Int) -> JetLibScalar JetLibError! {
        if code == {
            0 -> Ok(JetLibScalar.Int)
            1 -> Ok(JetLibScalar.Float)
            2 -> Ok(JetLibScalar.Bool)
            3 -> Ok(JetLibScalar.Text)
            else -> Err(JetLibError.new("unknown .jetlib scalar tag {code}"))
        }
    }
}

// The access convention carried with each native parameter: the C scalar
// representation stays homogeneous while the Jet ownership contract survives.
pub enum JetLibAccess {
    Read
    Write
    Move

    fn tag(self) -> Int Never! {
        if self == {
            .Read -> 0
            .Write -> 1
            .Move -> 2
        }
    }

    fn from_tag(code: Int) -> JetLibAccess JetLibError! {
        if code == {
            0 -> Ok(JetLibAccess.Read)
            1 -> Ok(JetLibAccess.Write)
            2 -> Ok(JetLibAccess.Move)
            else -> Err(JetLibError.new("unknown .jetlib access-convention tag {code}"))
        }
    }
}

// One exact C ABI row: `symbol` is the emitted foreign name; access
// conventions stay explicit metadata, never inferred from generated code.
pub struct JetLibExport {
    pub name: String
    pub symbol: String
    pub scalar: JetLibScalar
    pub params: Int
    pub conventions: [JetLibAccess]

    fn new(name: String, scalar: JetLibScalar, params: Int) -> JetLibExport Never! {
        conventions := [JetLibAccess]{}
        loop _ in 0..<params -> &conventions.push(JetLibAccess.Read)
        JetLibExport.with_conventions(name, scalar, conventions)
    }

    fn with_conventions(name: String, scalar: JetLibScalar, conventions: [JetLibAccess]) -> JetLibExport Never! {
        JetLibExport{name: name, symbol: pkg_jetlib_c_symbol(name), scalar: scalar, params: conventions.len(), conventions: conventions}
    }
}

// The load-time identity a `.jetlib` header carries.
pub struct JetLibStamp {
    pub compiler_version: String
    pub compiler_build: String
    pub library_name: String
    // The selected manifest output entry, kept for build provenance.
    pub entry: String?
    pub target: String
    pub target_triple: String
    pub linker_identity: String
    pub abi_identity: String
    pub abi_version: Int
    pub exports: [JetLibExport]
    // Sorted and duplicate-free (Rust `EffectSet`).
    pub declared_effects: [String]
    pub payload_digest: String

    // The all-empty stamp (Rust `Default`).
    fn empty() -> JetLibStamp Never! {
        JetLibStamp{
            compiler_version: "",
            compiler_build: "",
            library_name: "",
            entry: None,
            target: "",
            target_triple: "",
            linker_identity: "",
            abi_identity: "",
            abi_version: 0,
            exports: [JetLibExport]{},
            declared_effects: [String]{},
            payload_digest: ""
        }
    }

    // The stamp a build on this running compiler would write.
    fn for_this_compiler(declared_effects: [String]) -[Env]> JetLibStamp Never! {
        target :: pkg_jetlib_current_target()
        JetLibStamp{
            compiler_version: @COMPILER_VERSION,
            compiler_build: @COMPILER_VERSION,
            library_name: "anonymous",
            entry: None,
            target: target,
            target_triple: target,
            linker_identity: "system",
            abi_identity: @JETLIB_ABI_IDENTITY,
            abi_version: @JETLIB_ABI_VERSION,
            exports: [JetLibExport]{},
            declared_effects: authority_holds(declared_effects),
            payload_digest: ""
        }
    }

    // The stamp emitted for one checked native Library projection.
    fn for_library(name: String, exports: [JetLibExport], declared_effects: [String]) -[Env]> JetLibStamp Never! {
        JetLibStamp.for_library_with_identity(name, exports, declared_effects, @COMPILER_VERSION, pkg_jetlib_current_target(), "system")
    }

    // The stamp the native driver emits with the exact identities that
    // produced the payload; `linker_identity` is the whole toolchain identity.
    fn for_library_with_identity(name: String, exports: [JetLibExport], declared_effects: [String], compiler_build: String, target_triple: String, linker_identity: String) -[Env]> JetLibStamp Never! {
        JetLibStamp{
            compiler_version: @COMPILER_VERSION,
            compiler_build: compiler_build,
            library_name: name,
            entry: None,
            target: pkg_jetlib_current_target(),
            target_triple: target_triple,
            linker_identity: linker_identity,
            abi_identity: @JETLIB_ABI_IDENTITY,
            abi_version: @JETLIB_ABI_VERSION,
            exports: exports,
            declared_effects: authority_holds(declared_effects),
            payload_digest: ""
        }
    }

    // Seal the native payload identity once the final shared object exists.
    fn seal_payload(&self, payload: [U8]) {
        self.payload_digest = pkg_jetlib_payload_digest(payload)
    }

    // The header bytes: magic, identities, the checked export table, the
    // count of length-prefixed effect names (sorted), and the payload digest.
    fn encode(self) -> [U8] Never! {
        out := JetLibWriter.new()
        &out.push_raw(@JETLIB_MAGIC.bytes())
        &out.push_raw([U8]{U8{0}})
        &out.push_text(self.compiler_version)
        &out.push_text(self.compiler_build)
        &out.push_text(self.library_name)
        if self.entry == {
            .Val(entry) -> {
                &out.push_raw([U8]{U8{1}})
                &out.push_text(entry)
            }
            .None -> &out.push_raw([U8]{U8{0}})
        }
        &out.push_text(self.target)
        &out.push_text(self.target_triple)
        &out.push_text(self.linker_identity)
        &out.push_text(self.abi_identity)
        &out.push_u32(self.abi_version)
        &out.push_u32(self.exports.len())
        loop export in self.exports {
            &out.push_text(export.name)
            &out.push_text(export.symbol)
            &out.push_raw([U8]{U8{export.scalar.tag()}})
            &out.push_u32(export.params)
            loop convention in export.conventions -> &out.push_raw([U8]{U8{convention.tag()}})
        }
        effects :: authority_holds(self.declared_effects)
        &out.push_u32(effects.len())
        loop effect_name in effects -> &out.push_text(effect_name)
        &out.push_text(self.payload_digest)
        out.bytes
    }

    // Parse header bytes written by `encode`. A bad magic, a truncated
    // buffer, or non-UTF-8 text fails closed; nothing is partially trusted.
    fn decode(bytes: [U8]) -> JetLibStamp JetLibError! {
        reader := JetLibReader{bytes: bytes, at: 0}
        stamp :: JetLibStamp.decode_prefix(&reader)
        if reader.at != bytes.len() -> return Err(JetLibError.new("unexpected payload after .jetlib stamp"))
        Ok(stamp)
    }

    fn decode_prefix(reader: &JetLibReader) -> JetLibStamp JetLibError! {
        magic :: @JETLIB_MAGIC.bytes()
        if !pkg_bytes_starts_with(reader.bytes, 0, magic) || reader.bytes.len() <= magic.len() || Int.from_u8(reader.bytes[magic.len()]) != 0 {
            return Err(JetLibError.new("not a .jetlib artifact (bad magic)"))
        }
        reader.at = magic.len() + 1
        compiler_version :: &reader.take_string("compiler version")
        compiler_build :: &reader.take_string("compiler build")
        library_name :: &reader.take_string("library name")
        entry :: &reader.take_optional_string("output entry")
        target :: &reader.take_string("target")
        target_triple :: &reader.take_string("target triple")
        linker_identity :: &reader.take_string("linker identity")
        abi_identity :: &reader.take_string("ABI identity")
        abi_version :: &reader.take_u32("ABI version")
        export_count :: &reader.take_count("export")
        exports := [JetLibExport]{}
        loop _ in 0..<export_count {
            name :: &reader.take_string("export name")
            symbol :: &reader.take_string("export symbol")
            scalar_code :: &reader.take_byte() ?? return Err(JetLibError.new("truncated .jetlib header (export scalar)"))
            scalar :: JetLibScalar.from_tag(scalar_code)
            params :: &reader.take_u32("export parameter count")
            if params > @JETLIB_MAX_EXPORT_PARAMS -> return Err(JetLibError.new(".jetlib export has too many parameters"))
            conventions := [JetLibAccess]{}
            loop _ in 0..<params {
                convention :: &reader.take_byte() ?? return Err(JetLibError.new("truncated .jetlib header (access convention)"))
                &conventions.push(JetLibAccess.from_tag(convention))
            }
            &exports.push(JetLibExport{name: name, symbol: symbol, scalar: scalar, params: params, conventions: conventions})
        }
        effect_count :: &reader.take_count("effect")
        effects := [String]{}
        loop _ in 0..<effect_count {
            raw :: &reader.take_bytes()
            effect_name :: String.from_bytes(raw) ?? return Err(JetLibError.new("effect name is not UTF-8"))
            &effects.push(effect_name)
        }
        payload_digest :: &reader.take_string("payload digest")
        Ok(JetLibStamp{
            compiler_version: compiler_version,
            compiler_build: compiler_build,
            library_name: library_name,
            entry: entry,
            target: target,
            target_triple: target_triple,
            linker_identity: linker_identity,
            abi_identity: abi_identity,
            abi_version: abi_version,
            exports: exports,
            declared_effects: authority_holds(effects),
            payload_digest: payload_digest
        })
    }
}

// A complete `.jetlib`: the checked stamp, then the opaque native payload.
pub struct JetLibArtifact {
    pub stamp: JetLibStamp
    pub payload: [U8]

    fn encode(self) -> [U8] Never! {
        out := JetLibWriter{bytes: self.stamp.encode()}
        loop byte in pkg_u64_be_bytes(self.payload.len()) -> &out.bytes.push(byte)
        &out.push_raw(self.payload)
        out.bytes
    }

    fn decode(bytes: [U8]) -> JetLibArtifact JetLibError! {
        reader := JetLibReader{bytes: bytes, at: 0}
        stamp :: JetLibStamp.decode_prefix(&reader)
        if bytes.len() - reader.at < 8 -> return Err(JetLibError.new("truncated .jetlib artifact (payload length)"))
        declared := 0
        loop index in 0..<8 -> declared = (declared << 8) | Int.from_u8(bytes[reader.at + index])
        payload :: bytes[reader.at + 8..<bytes.len()]
        if payload.len() != declared {
            return Err(JetLibError.new("truncated .jetlib artifact (payload declares {declared} bytes, found {payload.len()})"))
        }
        Ok(JetLibArtifact{stamp: stamp, payload: payload})
    }
}

// Big-endian header writer.
struct JetLibWriter {
    bytes: [U8]

    fn new() -> JetLibWriter Never! {
        JetLibWriter{bytes: [U8]{}}
    }

    fn push_raw(&self, bytes: [U8]) {
        loop byte in bytes -> &self.bytes.push(byte)
    }

    fn push_u32(&self, value: Int) {
        shift_values :: [Int]{24, 16, 8, 0}
        loop shift in shift_values -> &self.bytes.push(U8{(value >> shift) & 0xFF})
    }

    // A u32 length prefix, then the bytes.
    fn push_text(&self, text: String) {
        raw :: text.bytes()
        &self.push_u32(raw.len())
        &self.push_raw(raw)
    }
}

// Cursor over header bytes; every take fails closed on truncation.
struct JetLibReader {
    bytes: [U8]
    at: Int

    fn take_byte(&self) -> Int? Never! {
        if self.at >= self.bytes.len() -> return None
        value :: Int.from_u8(self.bytes[self.at])
        self.at += 1
        Val(value)
    }

    fn take_u32(&self, what: String) -> Int JetLibError! {
        if self.bytes.len() - self.at < 4 -> return Err(JetLibError.new("truncated .jetlib header ({what})"))
        value := 0
        loop index in 0..<4 -> value = (value << 8) | Int.from_u8(self.bytes[self.at + index])
        self.at += 4
        Ok(value)
    }

    fn take_bytes(&self) -> [U8] JetLibError! {
        if self.bytes.len() - self.at < 4 -> return Err(JetLibError.new("truncated .jetlib header (length prefix)"))
        length := 0
        loop index in 0..<4 -> length = (length << 8) | Int.from_u8(self.bytes[self.at + index])
        self.at += 4
        if length > @JETLIB_MAX_HEADER_FIELD_BYTES -> return Err(JetLibError.new(".jetlib header field is too large"))
        if self.bytes.len() - self.at < length -> return Err(JetLibError.new("truncated .jetlib header (field bytes)"))
        field :: self.bytes[self.at..<self.at + length]
        self.at += length
        Ok(field)
    }

    fn take_string(&self, what: String) -> String JetLibError! {
        raw :: &self.take_bytes() ?? return Err(JetLibError.new("{err.message} ({what})"))
        text :: String.from_bytes(raw) ?? return Err(JetLibError.new("{what} is not UTF-8"))
        Ok(text)
    }

    fn take_optional_string(&self, what: String) -> String? JetLibError! {
        present :: &self.take_byte() ?? return Err(JetLibError.new("truncated .jetlib header ({what} presence)"))
        if present == {
            0 -> Ok(None)
            1 -> Ok(Val(self.take_string(what)))
            else -> Err(JetLibError.new("invalid .jetlib {what} presence tag {present}"))
        }
    }

    fn take_count(&self, what: String) -> Int JetLibError! {
        count :: &self.take_u32("{what} count")
        if count > @JETLIB_MAX_HEADER_ITEMS -> return Err(JetLibError.new(".jetlib header has too many {what} entries"))
        Ok(count)
    }
}

// The target identity shared by artifact producer and load-time adapter:
// Library builds are host-native, so `<os>-<arch>` is the whole identity.
pub fn pkg_jetlib_current_target() -[Env]> String Never! {
    os :: if {
        sys.is_linux() -> "linux"
        sys.is_macos() -> "macos"
        sys.is_windows() -> "windows"
        else -> sys.name()
    }
    "{os}-{sys.arch()}"
}

pub fn pkg_jetlib_payload_digest(payload: [U8]) -> String Never! {
    "sha256-{pkg_sha256_hex(payload)}"
}

// The emitted C symbol of an export name: ASCII alphanumerics and `_` kept,
// everything else `_`, with a leading `_` before an empty or digit start.
fn pkg_jetlib_c_symbol(name: String) -> String Never! {
    out := [U8]{}
    loop byte in name.bytes() {
        code :: Int.from_u8(byte)
        keep :: (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
        if (code >= 0x80) && (code < 0xC0) {
            next
        }
        &out.push(if keep -> byte else -> U8{95})
    }
    if out.len() == 0 || (Int.from_u8(out[0]) >= 48 && Int.from_u8(out[0]) <= 57) {
        prefixed := [U8]{U8{95}}
        loop byte in out -> &prefixed.push(byte)
        return String.from_bytes(prefixed) ?? "_"
    }
    String.from_bytes(out) ?? "_"
}
