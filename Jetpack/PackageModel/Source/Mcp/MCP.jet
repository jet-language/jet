// Rust: crates/jet-pkg-model/src/MCP.rs:1423
fn append_fragment(output: &String, fragment: String, maximum: UInt) -> MCPCodecError! {
    actual :: output.bytes().len().saturating_add(fragment.bytes().len())
    if actual > maximum -> return Err(MCPCodecError.MessageTooLarge(actual: actual, maximum: maximum))
    &output.push_str(fragment)
}

// Rust: crates/jet-pkg-model/src/MCP.rs:1436
fn append_json_string(output: &String, value: String, maximum: UInt) -> MCPCodecError! {
    append_fragment(output, "\"", maximum)
    loop character in value.chars() {
        code :: character.to_u32()
        escaped :: if code == {
            34 -> Val("\\\"")
            92 -> Val("\\\\")
            10 -> Val("\\n")
            13 -> Val("\\r")
            9 -> Val("\\t")
            8 -> Val("\\b")
            12 -> Val("\\f")
            else -> None
        }
        if escaped == {
            .Val(text) -> append_fragment(output, text, maximum)
            else -> if character.is_control() {
                append_fragment(output, "\\u{code:04x}", maximum)
            } else {
                // Check scalar bytes before appending, without allocating an
                // intermediate one-character String or heap UTF-8 buffer.
                actual :: output.bytes().len().saturating_add(character.len_utf8())
                if actual > maximum -> return Err(MCPCodecError.MessageTooLarge(actual: actual, maximum: maximum))
                &output.push(character)
            }
        }
    }
    append_fragment(output, "\"", maximum)
}

// Rust: crates/jet-pkg-model/src/MCP.rs:1472
// valid_json_number -> McpMessages.jet:443 pkg_mcp_valid_json_number;
// complete grammar, i64 integer range, finite floating point.

// Rust: crates/jet-pkg-model/src/MCP.rs:1531
fn stringify(value: DataTree, depth: UInt, maximum_depth: UInt, maximum_bytes: UInt) -> String MCPCodecError! {
    pkg_mcp_ensure_depth(value, depth, maximum_depth)
    output := String.with_capacity(maximum_bytes.min(4096))
    stringify_into(value, &output, maximum_bytes)
    output
}

// Rust: crates/jet-pkg-model/src/MCP.rs:1543
fn stringify_into(value: DataTree, output: &String, maximum: UInt) -> MCPCodecError! {
    if value == {
        .Null -> append_fragment(output, "null", maximum)
        .Bool(v) -> append_fragment(output, if v -> "true" else -> "false", maximum)
        .Int(v) -> append_fragment(output, v.to_string(), maximum)
        .Float(v) -> {
            if !v.is_finite() -> return Err(MCPCodecError.InvalidMessage("JSON numbers must be finite"))
            append_fragment(output, v.to_string(), maximum)
        }
        .Number(text) -> {
            if text.bytes().len() > maximum -> return Err(MCPCodecError.MessageTooLarge(actual: text.bytes().len(), maximum: maximum))
            if !pkg_mcp_valid_json_number(text) -> return Err(MCPCodecError.InvalidMessage("JSON number is invalid"))
            append_fragment(output, text, maximum)
        }
        .TypedText(text) | .Text(text) -> append_json_string(output, text, maximum)
        .Bytes(bytes) -> {
            append_fragment(output, "[", maximum)
            loop (index, byte) in bytes.enumerate() {
                if index > 0 -> append_fragment(output, ",", maximum)
                append_fragment(output, byte.to_string(), maximum)
            }
            append_fragment(output, "]", maximum)
        }
        .Array(items) -> {
            append_fragment(output, "[", maximum)
            loop (index, item) in items.enumerate() {
                if index > 0 -> append_fragment(output, ",", maximum)
                stringify_into(item, output, maximum)
            }
            append_fragment(output, "]", maximum)
        }
        .Object(fields) -> {
            append_fragment(output, "{", maximum)
            // Retain the ordered DataTree field traversal used by the reference.
            loop (index, (key, item)) in fields.iter().enumerate() {
                if index > 0 -> append_fragment(output, ",", maximum)
                append_json_string(output, key, maximum)
                append_fragment(output, ":", maximum)
                stringify_into(item, output, maximum)
            }
            append_fragment(output, "}", maximum)
        }
    }
}

