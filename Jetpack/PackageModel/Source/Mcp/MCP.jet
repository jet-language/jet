// Rust: crates/jet-pkg-model/src/MCP.rs:874
fn validate_peer_versions(peer_versions: [String]) -> MCPNegotiationError! {
    if peer_versions.len() > MCP_MAX_PEER_VERSION_COUNT -> return Err(MCPNegotiationError.PeerVersionListTooLarge(actual: peer_versions.len(), maximum: MCP_MAX_PEER_VERSION_COUNT))
    loop version in peer_versions {
        if version.bytes().len() > MCP_MAX_REVISION_BYTES -> return Err(MCPNegotiationError.PeerVersionTooLong(MCP_MAX_REVISION_BYTES))
    }
}

// Rust: crates/jet-pkg-model/src/MCP.rs:892
fn redacted_peer_versions(peer_versions: [String]) -> [String] {
    out: [String] := []
    loop version in peer_versions {
        &out.push(if MCPRevision.parse(version) == { .Val(revision) -> revision.as_str() else -> "<unknown>" })
    }
    out
}
