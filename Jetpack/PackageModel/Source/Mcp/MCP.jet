//RS /// Stable MCP revision selected by default.
//RS pub const STABLE_REVISION: &str = "2025-11-25";
//RS /// Release-candidate revision. It needs explicit policy opt-in.
//RS pub const PREVIEW_REVISION: &str = "2026-07-28";
//RS 
//RS /// Default maximum encoded MCP message size.
//RS pub const DEFAULT_MAX_MESSAGE_BYTES: usize = 1024 * 1024;
//RS /// Hard maximum encoded MCP message size accepted by this core.
//RS pub const MAX_MESSAGE_BYTES: usize = 16 * 1024 * 1024;
//RS /// Maximum JSON/schema nesting supported by the shared JSON parser.
//RS pub const MAX_SCHEMA_DEPTH: usize = JSON::MAX_JSON_DEPTH;
//RS /// Default maximum number of capability entries in one initialize message.
//RS pub const DEFAULT_MAX_CAPABILITY_ENTRIES: usize = 64;
//RS /// Hard maximum number of capability entries accepted by this core.
//RS pub const MAX_CAPABILITY_ENTRIES: usize = 256;
//RS /// Maximum peer revision offers accepted during negotiation.
//RS const MAX_PEER_VERSION_COUNT: usize = 32;
//RS /// Maximum wire spelling accepted for one peer revision offer.
//RS const MAX_REVISION_BYTES: usize = 64;
//RS /// Maximum implementation identity field length.
//RS const MAX_IMPLEMENTATION_FIELD_BYTES: usize = 256;
