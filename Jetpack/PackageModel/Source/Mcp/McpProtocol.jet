// D-MCP-SURFACE1=A — the shared MCP protocol core, ported from
// jet_pkg_model::MCP.
//
// Protocol revisions, revision negotiation, bounds, and the lifecycle state
// machine. There is no transport or authorization code: tooling puts any
// transport on top of `McpPeer` without a second protocol implementation.

// Stable MCP revision selected by default.
MCP_STABLE_REVISION :: prep { "2025-11-25" }
// Release-candidate revision; it needs explicit policy opt-in.
MCP_PREVIEW_REVISION :: prep { "2026-07-28" }
// Default and hard maximum encoded MCP message size.
MCP_DEFAULT_MAX_MESSAGE_BYTES :: prep { 1048576 }
MCP_MAX_MESSAGE_BYTES :: prep { 16777216 }
// Maximum JSON/schema nesting supported by the shared JSON parser
// (`JSON::MAX_JSON_DEPTH`).
MCP_MAX_SCHEMA_DEPTH :: prep { 64 }
// Default and hard maximum capability entries in one initialize message.
MCP_DEFAULT_MAX_CAPABILITY_ENTRIES :: prep { 64 }
MCP_MAX_CAPABILITY_ENTRIES :: prep { 256 }
// Maximum peer revision offers, and bytes per offer, accepted during
// negotiation.
MCP_MAX_PEER_VERSION_COUNT :: prep { 32 }
MCP_MAX_REVISION_BYTES :: prep { 64 }
// Maximum implementation identity field length.
MCP_MAX_IMPLEMENTATION_FIELD_BYTES :: prep { 256 }

// MCP protocol revisions known to this SDK.
pub enum MCPRevision {
    // Session-oriented stable MCP revision.
    Stable20251125
    // Stateless release-candidate MCP revision.
    Preview20260728

    // The wire spelling.
    fn as_str(self) -> String Never! {
        if self == {
            .Stable20251125 -> MCP_STABLE_REVISION
            .Preview20260728 -> MCP_PREVIEW_REVISION
        }
    }

    // Parse a wire revision; unknown revisions stay unselected.
    fn parse(value: String) -> MCPRevision? Never! {
        if value == {
            MCP_STABLE_REVISION -> Val(MCPRevision.Stable20251125)
            MCP_PREVIEW_REVISION -> Val(MCPRevision.Preview20260728)
            else -> None
        }
    }

    fn is_preview(self) -> Bool Never! {
        if self == {
            .Stable20251125 -> false
            .Preview20260728 -> true
        }
    }

    fn codec(self) -> MCPCodec Never! {
        if self == {
            .Stable20251125 -> MCPCodec.Stable20251125
            .Preview20260728 -> MCPCodec.Preview20260728
        }
    }

    fn lifecycle_profile(self) -> MCPLifecycleProfile Never! {
        if self == {
            .Stable20251125 -> MCPLifecycleProfile.Session
            .Preview20260728 -> MCPLifecycleProfile.Stateless
        }
    }
}

// Revision-specific JSON codec profile.
pub enum MCPCodec {
    Stable20251125
    Preview20260728

    fn revision(self) -> MCPRevision Never! {
        if self == {
            .Stable20251125 -> MCPRevision.Stable20251125
            .Preview20260728 -> MCPRevision.Preview20260728
        }
    }
}

// Local revision selection policy.
pub enum MCPVersionPolicy {
    // Stable MCP only (the default).
    Stable
    // One exact revision; selecting the preview revision is explicit.
    Exact(MCPRevision)
    // Stable plus explicitly listed revisions.
    StableAnd([MCPRevision])

    // Supported revisions in preference order, stable first.
    fn supported(self) -> [MCPRevision] Never! {
        if self == {
            .Stable -> [MCPRevision]{MCPRevision.Stable20251125}
            .Exact(revision) -> [MCPRevision]{revision}
            .StableAnd(extra) -> {
                supported := [MCPRevision]{MCPRevision.Stable20251125}
                loop revision in extra {
                    if !supported.contains(revision) -> &supported.push(revision)
                }
                supported
            }
        }
    }

    fn admits_preview(self) -> Bool Never! {
        loop revision in self.supported() {
            if revision.is_preview() -> return true
        }
        false
    }
}

// Bounds applied by every MCP codec and structured initialize value.
pub struct MCPLimits {
    // Maximum encoded UTF-8 JSON message size.
    pub max_message_bytes: Int
    // Maximum JSON nesting depth for params, results, and capabilities.
    pub max_schema_depth: Int
    // Maximum capability entries in one initialize value.
    pub max_capability_entries: Int

    fn defaults() -> MCPLimits Never! {
        MCPLimits{max_message_bytes: MCP_DEFAULT_MAX_MESSAGE_BYTES, max_schema_depth: MCP_MAX_SCHEMA_DEPTH, max_capability_entries: MCP_DEFAULT_MAX_CAPABILITY_ENTRIES}
    }

    // Every configured bound is positive and within its hard cap.
    fn validate(self) MCPCodecError! {
        if self.max_message_bytes == 0 || self.max_message_bytes > MCP_MAX_MESSAGE_BYTES {
            return Err(MCPCodecError.InvalidLimit{name: "max_message_bytes", value: self.max_message_bytes, maximum: MCP_MAX_MESSAGE_BYTES})
        }
        if self.max_schema_depth == 0 || self.max_schema_depth > MCP_MAX_SCHEMA_DEPTH {
            return Err(MCPCodecError.InvalidLimit{name: "max_schema_depth", value: self.max_schema_depth, maximum: MCP_MAX_SCHEMA_DEPTH})
        }
        if self.max_capability_entries == 0 || self.max_capability_entries > MCP_MAX_CAPABILITY_ENTRIES {
            return Err(MCPCodecError.InvalidLimit{name: "max_capability_entries", value: self.max_capability_entries, maximum: MCP_MAX_CAPABILITY_ENTRIES})
        }
    }
}

// One local MCP protocol policy.
pub struct MCPPolicy {
    // Revisions this peer may negotiate.
    pub versions: MCPVersionPolicy
    // Wire and structured-value bounds.
    pub limits: MCPLimits

    // Stable-by-default policy.
    fn stable() -> MCPPolicy Never! {
        MCPPolicy{versions: MCPVersionPolicy.Stable, limits: MCPLimits.defaults()}
    }

    // Exact revision policy; preview selection is explicit at this call.
    fn exact(revision: MCPRevision) -> MCPPolicy Never! {
        MCPPolicy{versions: MCPVersionPolicy.Exact(revision), limits: MCPLimits.defaults()}
    }

    // Stable plus explicit additional revisions.
    fn stable_and(revisions: [MCPRevision]) -> MCPPolicy Never! {
        MCPPolicy{versions: MCPVersionPolicy.StableAnd(revisions), limits: MCPLimits.defaults()}
    }

    fn supported_revisions(self) -> [MCPRevision] Never! {
        self.versions.supported()
    }

    // Negotiate one revision against the other peer's wire offers,
    // preferring this policy's order (stable first).
    fn negotiate(self, peer_versions: [String]) -> MCPNegotiatedProtocol MCPNegotiationError! {
        if self.limits.validate() == {
            .Err(error) -> return Err(MCPNegotiationError.InvalidPolicy(error.message()))
            .Ok(_) -> {}
        }
        if peer_versions.len() > MCP_MAX_PEER_VERSION_COUNT {
            return Err(MCPNegotiationError.PeerVersionListTooLarge{actual: peer_versions.len(), maximum: MCP_MAX_PEER_VERSION_COUNT})
        }
        loop version in peer_versions {
            if version.bytes().len() > MCP_MAX_REVISION_BYTES -> return Err(MCPNegotiationError.PeerVersionTooLong(MCP_MAX_REVISION_BYTES))
        }
        peer_revisions := [MCPRevision]{}
        loop version in peer_versions {
            if MCPRevision.parse(version) == {
                .Val(revision) -> &peer_revisions.push(revision)
                .None -> {}
            }
        }
        supported :: self.supported_revisions()
        loop revision in supported {
            if peer_revisions.contains(revision) -> return Ok(MCPNegotiatedProtocol{revision: revision, codec: revision.codec(), lifecycle: revision.lifecycle_profile()})
        }
        peer_has_preview := false
        loop revision in peer_revisions {
            if revision.is_preview() -> peer_has_preview = true
        }
        if peer_has_preview && !self.versions.admits_preview() -> return Err(MCPNegotiationError.PreviewRequiresOptIn)
        if self.versions == {
            .Exact(requested) -> {
                if requested.is_preview() && peer_revisions.contains(MCPRevision.Stable20251125) {
                    return Err(MCPNegotiationError.DowngradeRefused{requested: requested, offered: peer_revisions})
                }
            }
            else -> {}
        }
        redacted := [String]{}
        loop version in peer_versions {
            if MCPRevision.parse(version) == {
                .Val(revision) -> &redacted.push(revision.as_str())
                .None -> &redacted.push("<unknown>")
            }
        }
        Err(MCPNegotiationError.NoCommonRevision{local: supported, peer: redacted})
    }
}

// Lifecycle law selected by a negotiated revision.
pub enum MCPLifecycleProfile {
    // `initialize` → `initialized` → `shutdown` → `exit`.
    Session
    // No session handshake; each request is independently usable.
    Stateless
}

// Current peer lifecycle stage.
pub enum MCPLifecycleState {
    New
    Negotiated
    Initializing
    Ready
    ShuttingDown
    Closed

    // The audit spelling.
    fn name(self) -> String Never! {
        if self == {
            .New -> "new"
            .Negotiated -> "negotiated"
            .Initializing -> "initializing"
            .Ready -> "ready"
            .ShuttingDown -> "shutting_down"
            .Closed -> "closed"
        }
    }

    // The variant name used in lifecycle diagnostics.
    fn debug_name(self) -> String Never! {
        if self == {
            .New -> "New"
            .Negotiated -> "Negotiated"
            .Initializing -> "Initializing"
            .Ready -> "Ready"
            .ShuttingDown -> "ShuttingDown"
            .Closed -> "Closed"
        }
    }
}

// Client or server role for audit and lifecycle ownership.
pub enum MCPPeerRole {
    Client
    Server

    fn name(self) -> String Never! {
        if self == {
            .Client -> "client"
            .Server -> "server"
        }
    }
}

// Result of successful revision negotiation.
pub struct MCPNegotiatedProtocol {
    pub revision: MCPRevision
    pub codec: MCPCodec
    pub lifecycle: MCPLifecycleProfile
}

// An implementation identity: non-empty, bounded, control-free fields.
pub struct MCPImplementation {
    pub name: String
    pub version: String

    fn new(name: String, version: String) -> MCPImplementation MCPCodecError! {
        implementation :: MCPImplementation{name: name, version: version}
        implementation.validate()
        Ok(implementation)
    }

    fn validate(self) MCPCodecError! {
        if self.name == "" || self.version == "" || self.name.bytes().len() > MCP_MAX_IMPLEMENTATION_FIELD_BYTES || self.version.bytes().len() > MCP_MAX_IMPLEMENTATION_FIELD_BYTES || pkg_text_has_control(self.name) || pkg_text_has_control(self.version) {
            return Err(MCPCodecError.InvalidMessage("implementation name and version must be non-empty bounded text"))
        }
    }
}

// Revision negotiation failure.
#Error
pub enum MCPNegotiationError {
    InvalidPolicy(String)
    PreviewRequiresOptIn
    PeerVersionListTooLarge(actual: Int, maximum: Int)
    PeerVersionTooLong(Int)
    DowngradeRefused(requested: MCPRevision, offered: [MCPRevision])
    NoCommonRevision(local: [MCPRevision], peer: [String])
    AlreadyNegotiated

    fn message(self) -> String Never! {
        if self == {
            .InvalidPolicy(detail) -> "invalid MCP policy: {detail}"
            .PreviewRequiresOptIn -> "MCP preview revision requires explicit policy opt-in"
            .PeerVersionListTooLarge(actual, maximum) -> "MCP peer revision offer count {actual} exceeds maximum {maximum}"
            .PeerVersionTooLong(maximum) -> "MCP peer revision offer exceeds {maximum} bytes"
            .DowngradeRefused(requested, offered) -> "MCP downgrade refused for {requested.as_str()}; peer offered {offered.len()} compatible revision(s)"
            .NoCommonRevision(local, peer) -> "no common MCP revision ({local.len()} local, {peer.len()} peer offer(s))"
            .AlreadyNegotiated -> "MCP peer already negotiated"
        }
    }
}

// Lifecycle transition failure.
#Error
pub enum MCPLifecycleError {
    InvalidState(operation: String, lifecycle: MCPLifecycleState)
    NotNegotiated
    StatelessRevision
    InvalidInitialize
    ProtocolVersionMismatch(expected: MCPRevision, received: String)

    fn message(self) -> String Never! {
        if self == {
            .InvalidState(operation, lifecycle) -> "cannot {operation} MCP peer in state {lifecycle.debug_name()}"
            .NotNegotiated -> "MCP peer has no negotiated revision"
            .StatelessRevision -> "the negotiated MCP revision does not use session lifecycle"
            .InvalidInitialize -> "invalid MCP initialize value"
            .ProtocolVersionMismatch(expected, _) -> "initialize protocol version mismatch: expected {expected.as_str()}"
        }
    }
}

// Codec and structured-value failure.
#Error
pub enum MCPCodecError {
    InvalidJSON
    InvalidMessage(String)
    MessageTooLarge(actual: Int, maximum: Int)
    SchemaTooDeep(Int)
    CapabilityLimitExceeded(actual: Int, maximum: Int)
    InvalidLimit(name: String, value: Int, maximum: Int)

    fn message(self) -> String Never! {
        if self == {
            .InvalidJSON -> "invalid MCP JSON message"
            .InvalidMessage(detail) -> detail
            .MessageTooLarge(actual, maximum) -> "MCP message exceeds {maximum} bytes ({actual})"
            .SchemaTooDeep(maximum) -> "MCP value exceeds schema depth limit {maximum}"
            .CapabilityLimitExceeded(actual, maximum) -> "MCP capability count exceeds {maximum} entries ({actual})"
            .InvalidLimit(name, value, maximum) -> "MCP limit {name}={value} exceeds maximum {maximum}"
        }
    }
}

// Redacted, structured facts suitable for a dossier or trace.
pub struct MCPAuditFacts {
    pub role: MCPPeerRole
    pub negotiated_revision: MCPRevision?
    pub codec: MCPCodec?
    pub lifecycle: MCPLifecycleState

    // Stable, secret-free key/value fields.
    fn as_map(self) -> [String: String] Never! {
        facts := [String: String]{}
        facts["mcp.role"] = self.role.name()
        facts["mcp.lifecycle"] = self.lifecycle.name()
        if self.negotiated_revision == {
            .Val(revision) -> facts["mcp.protocol_version"] = revision.as_str()
            .None -> {}
        }
        if self.codec == {
            .Val(codec) -> facts["mcp.codec"] = codec.revision().as_str()
            .None -> {}
        }
        facts
    }
}

// One negotiated MCP peer. Transports own I/O; this type owns protocol and
// lifecycle state only.
pub struct MCPPeer {
    peer_role: MCPPeerRole
    policy: MCPPolicy
    negotiated: MCPNegotiatedProtocol?
    lifecycle: MCPLifecycleState

    fn client(policy: MCPPolicy) -> MCPPeer Never! {
        MCPPeer.new(MCPPeerRole.Client, policy)
    }

    fn server(policy: MCPPolicy) -> MCPPeer Never! {
        MCPPeer.new(MCPPeerRole.Server, policy)
    }

    fn new(role: MCPPeerRole, policy: MCPPolicy) -> MCPPeer Never! {
        MCPPeer{peer_role: role, policy: policy, negotiated: None, lifecycle: MCPLifecycleState.New}
    }

    fn role(self) -> MCPPeerRole Never! {
        self.peer_role
    }

    fn state(self) -> MCPLifecycleState Never! {
        self.lifecycle
    }

    fn limits(self) -> MCPLimits Never! {
        self.policy.limits
    }

    fn revision(self) -> MCPRevision? Never! {
        self.negotiated?.revision
    }

    fn codec(self) -> MCPCodec? Never! {
        self.negotiated?.codec
    }

    fn lifecycle_profile(self) -> MCPLifecycleProfile? Never! {
        self.negotiated?.lifecycle
    }

    // Negotiate once against the other peer's wire offers. A stateless
    // revision is ready at once; a session revision waits for initialize.
    fn negotiate(&self, peer_versions: [String]) -> MCPNegotiatedProtocol MCPNegotiationError! {
        if self.lifecycle != MCPLifecycleState.New -> return Err(MCPNegotiationError.AlreadyNegotiated)
        negotiated :: self.policy.negotiate(peer_versions)
        self.lifecycle = if negotiated.lifecycle == MCPLifecycleProfile.Stateless -> MCPLifecycleState.Ready else -> MCPLifecycleState.Negotiated
        self.negotiated = Val(~negotiated)
        Ok(negotiated)
    }

    // Process the stable-session `initialize` and produce the typed result.
    fn initialize(&self, params: MCPInitializeParams, server_info: MCPImplementation, server_capabilities: MCPCapabilities) -> MCPInitializeResult MCPLifecycleError! {
        protocol :: self.negotiated ?? return Err(MCPLifecycleError.NotNegotiated)
        if protocol.lifecycle != MCPLifecycleProfile.Session -> return Err(MCPLifecycleError.StatelessRevision)
        if self.lifecycle != MCPLifecycleState.Negotiated -> return Err(MCPLifecycleError.InvalidState{operation: "initialize", lifecycle: self.lifecycle})
        if params.protocol_version != protocol.revision.as_str() {
            return Err(MCPLifecycleError.ProtocolVersionMismatch{expected: protocol.revision, received: pkg_mcp_redacted_revision(params.protocol_version)})
        }
        if params.to_json_tree(self.policy.limits) == {
            .Ok(_) -> {}
            .Err(_) -> return Err(MCPLifecycleError.InvalidInitialize)
        }
        result :: MCPInitializeResult.new(protocol.revision, server_capabilities, server_info)
        if result.to_json_tree(self.policy.limits) == {
            .Ok(_) -> {}
            .Err(_) -> return Err(MCPLifecycleError.InvalidInitialize)
        }
        self.lifecycle = MCPLifecycleState.Initializing
        Ok(result)
    }

    // The stable `initialized` notification.
    fn initialized(&self) MCPLifecycleError! {
        if self.negotiated == None -> return Err(MCPLifecycleError.NotNegotiated)
        if self.lifecycle != MCPLifecycleState.Initializing -> return Err(MCPLifecycleError.InvalidState{operation: "initialized", lifecycle: self.lifecycle})
        self.lifecycle = MCPLifecycleState.Ready
    }

    // The stable `shutdown` request.
    fn shutdown(&self) MCPLifecycleError! {
        if self.lifecycle_profile() == {
            .None -> return Err(MCPLifecycleError.NotNegotiated)
            .Val(profile) -> {
                if profile == MCPLifecycleProfile.Stateless -> return Err(MCPLifecycleError.StatelessRevision)
            }
        }
        if self.lifecycle != MCPLifecycleState.Ready -> return Err(MCPLifecycleError.InvalidState{operation: "shutdown", lifecycle: self.lifecycle})
        self.lifecycle = MCPLifecycleState.ShuttingDown
    }

    // The stable `exit` notification, or closing a stateless peer.
    fn exit(&self) MCPLifecycleError! {
        if self.lifecycle_profile() == {
            .None -> return Err(MCPLifecycleError.NotNegotiated)
            .Val(profile) -> {
                closes :: if profile == {
                    .Session -> self.lifecycle == MCPLifecycleState.ShuttingDown
                    .Stateless -> self.lifecycle == MCPLifecycleState.Ready
                }
                if !closes -> return Err(MCPLifecycleError.InvalidState{operation: "exit", lifecycle: self.lifecycle})
            }
        }
        self.lifecycle = MCPLifecycleState.Closed
    }

    fn audit_facts(self) -> MCPAuditFacts Never! {
        MCPAuditFacts{role: self.peer_role, negotiated_revision: self.revision(), codec: self.codec(), lifecycle: self.lifecycle}
    }
}
