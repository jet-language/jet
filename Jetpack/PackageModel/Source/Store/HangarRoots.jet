// Read-only slice of the Jetpack hangar store (jet-pkg-model Store.rs;
// U2): root resolution and listing of already-recorded entries.
// Realization, verification, leasing, GC, and quarantine stay in the Store
// area, which builds on these names instead of re-homing them.

// The native data-directory leaf (macOS/Windows spell it
// `Hangar`); explicit roots keep the historical lower-case child.
HANGAR_NATIVE_SUBDIR_TITLE :: prep { "Hangar" }
HANGAR_LEGACY_SUBDIR :: prep { "hangar" }
HANGAR_SHARED_CAS_ENV :: prep { "JETPACK_SHARED_CAS" }
HANGAR_MAX_STORE_OBJECTS :: prep { 1000000 }
HANGAR_MAX_STORE_META_BYTES :: prep { 1048576 }

// The native leaf of the resolved root's content-addressed store.
fn pkg_hangar_subdir() -[Env]> String Never! {
    if sys.is_macos() || sys.is_windows() -> return HANGAR_NATIVE_SUBDIR_TITLE
    HANGAR_LEGACY_SUBDIR
}

// The resolved root, and whether it is the default user-owned root.
struct HangarRoots {
    root: String
    dev_mode: Bool

    // An explicit non-default root for an isolated operation; it never
    // inherits the native user-data spelling.
    fn at(root: String) -> HangarRoots Never! {
        HangarRoots{root: root, dev_mode: false}
    }

    // The global content-addressed store (hangar) under this root.
    fn hangar_dir(self) -[Env]> String Never! {
        leaf :: if self.dev_mode -> pkg_hangar_subdir() else -> HANGAR_LEGACY_SUBDIR
        files.join(self.root, leaf)
    }

    // The immutable payload pool this root shares: the machine-wide pool for
    // the default user root or an explicit JETPACK_SHARED_CAS, else its own.
    fn shared_cas_dir(self) -[Env]> String Never! {
        if self.root == pkg_user_data_root() || pkg_environment_path(HANGAR_SHARED_CAS_ENV) != None {
            return pkg_shared_cas_dir()
        }
        files.join(self.hangar_dir(), "cas")
    }

    // User and custom Hangar roots visible from this machine. Discovery stays
    // bounded to known parents; it never walks an arbitrary tree.
    fn machine_roots() -[FS, Env]> [HangarRoots] Never! {
        roots := [HangarRoots]{}
        candidates :: [HangarRoots]{
            pkg_resolve_roots(),
            {root: pkg_user_data_root(), dev_mode: true},
            HangarRoots.at(pkg_legacy_user_root())
        }
        loop candidate in candidates -> pkg_hangar_add_machine_root(&roots, candidate)
        parents := [String]{}
        loop root in roots {
            if root.root != "/" && root.root != "" -> &parents.push(files.dirname(root.root))
        }
        name_values :: [String]{"XDG_DATA_HOME", "XDG_STATE_HOME", "LOCALAPPDATA"}
        loop name in name_values {
            parent :: pkg_environment_path(name) ?? next
            &parents.push(parent)
        }
        &parents.push(pkg_environment_path("XDG_CACHE_HOME") ?? files.join(pkg_home_dir(), ".cache"))
        loop parent in authority_holds(parents) {
            entries :: files.list_dir(parent) ?? next
            loop entry in entries {
                info :: files.stat(entry.path) ?? next
                if info.is_symlink || !info.is_dir -> next
                if pkg_hangar_real_directory(files.join(entry.path, pkg_hangar_subdir())) {
                    pkg_hangar_add_machine_root(&roots, HangarRoots{root: entry.path, dev_mode: true})
                } else if pkg_hangar_real_directory(files.join(entry.path, HANGAR_LEGACY_SUBDIR)) {
                    pkg_hangar_add_machine_root(&roots, HangarRoots.at(entry.path))
                }
            }
        }
        roots
    }
}

// The machine/user shared immutable payload pool.
fn pkg_shared_cas_dir() -[Env]> String Never! {
    explicit :: pkg_environment_path(HANGAR_SHARED_CAS_ENV) ?? return files.join(files.join(pkg_user_data_root(), pkg_hangar_subdir()), "cas")
    explicit
}

fn pkg_hangar_add_machine_root(roots: &[HangarRoots], candidate: HangarRoots) -[Env]> {
    loop root in roots {
        if root.root == candidate.root && root.hangar_dir() == candidate.hangar_dir() -> return
    }
    &roots.push(candidate)
}

fn pkg_hangar_real_directory(path: String) -[FS]> Bool Never! {
    info :: files.stat(path) ?? return false
    !info.is_symlink && info.is_dir
}

// The project-local `.jet/` managed folder (lockfile, caches, GC roots).
// Never holds realized packages; those live in the shared hangar.
fn pkg_managed_dir(project: String) -> String Never! {
    files.join(project, SOURCE_ROOT_DIR)
}

// The single unified lockfile path for `project` (`.jet/lock`, U2).
fn pkg_lock_path(project: String) -> String Never! {
    files.join(pkg_managed_dir(project), "lock")
}

// Resolve the Jetpack root: `JETPACK_ROOT` when set, else the platform data
// directory from.
fn pkg_resolve_roots() -[Env]> HangarRoots Never! {
    explicit :: pkg_environment_path("JETPACK_ROOT") ?? return HangarRoots{root: pkg_user_data_root(), dev_mode: true}
    HangarRoots{root: explicit, dev_mode: false}
}

fn pkg_home_dir() -[Env]> String Never! {
    if sys.is_windows() {
        if pkg_environment_path("USERPROFILE") == .Val(home) -> return home
    }
    pkg_environment_path("HOME") ?? "."
}

// A non-empty environment value.
fn pkg_environment_path(name: String) -[Env]> String? Never! {
    value :: sys.get(name) ?? return None
    if value == "" -> return None
    Val(value)
}

// An environment directory honoured only when absolute.
fn pkg_absolute_environment_path(name: String) -[Env]> String? Never! {
    value :: pkg_environment_path(name) ?? return None
    if !files.is_abs(value) -> return None
    Val(value)
}

fn pkg_user_data_root() -[Env]> String Never! {
    if sys.is_macos() -> return files.join(files.join(files.join(pkg_home_dir(), "Library"), "Application Support"), "Jet")
    if sys.is_windows() {
        local :: pkg_environment_path("LOCALAPPDATA") ?? files.join(files.join(pkg_home_dir(), "AppData"), "Local")
        return files.join(local, "Jet")
    }
    data :: pkg_absolute_environment_path("XDG_DATA_HOME") ?? files.join(files.join(pkg_home_dir(), ".local"), "share")
    files.join(data, "jet")
}

// The pre- user root, kept only as a migration source.
fn pkg_legacy_user_root() -[Env]> String Never! {
    state :: pkg_absolute_environment_path("XDG_STATE_HOME") ?? files.join(files.join(pkg_home_dir(), ".local"), "state")
    files.join(state, "jet")
}

// The old Hangar path of the pre- resolver.
fn pkg_legacy_user_hangar_dir() -[Env]> String Never! {
    files.join(pkg_legacy_user_root(), HANGAR_LEGACY_SUBDIR)
}

// JP0 cache identity. Legacy records have empty fields and can never hit.
struct CacheIdentity {
    source_fingerprint: String
    recipe_fingerprint: String
    policy_fingerprint: String
    platform: String

    fn empty() -> CacheIdentity Never! {
        CacheIdentity{source_fingerprint: "", recipe_fingerprint: "", policy_fingerprint: "", platform: ""}
    }
}

// A realized package recorded under the Jetpack store.
struct StoreEntry {
    // Directory name under the hangar, e.g. `fastfetch-2.1.0-<fp>` (
    // name and version first, fingerprint last).
    id: String
    name: String
    // Package version, or empty when the provider cannot determine one.
    version: String
    reference: String
    // The realized output root (often a `/nix/store/...` path).
    out: String
    // The `bin` directory to add to PATH.
    bin: String
    // The built Rust rlib of a library package compiled from Cargo.toml
    // empty otherwise.
    rlib: String
    // The A4 envelope; empty for pre-envelope records.
    envelope: Envelope
    cache_identity: CacheIdentity
    // Content digests this object references (runtime/build closure edges).
    references: [String]
    // Named outputs -> content digests (`out` is the primary).
    named_outputs: [String: String]
    // Explicit platform artifact kind that permits semantic xattrs on ingest.
    platform_artifact_kind: String
    // Versioned canonical producer/action/source replay record.
    producer_record: String
    // Digest of the immutable Hangar receipt.
    receipt: String
    // Unix seconds when this hangar object was first realized.
    realized_at: Int
    // Unix seconds when Jetpack last reused/refreshed this object.
    last_used_at: Int

    // The `meta.json` text the engine writes when recording an entry.
    fn meta_json(self) -> String Never! {
        fields :: [(key: String, value: String, raw: Bool)]{
            (key: "name", value: self.name, raw: false),
            (key: "version", value: self.version, raw: false),
            (key: "ref", value: self.reference, raw: false),
            (key: "out", value: self.out, raw: false),
            (key: "bin", value: self.bin, raw: false),
            (key: "rlib", value: self.rlib, raw: false),
            (key: "output_hash", value: self.envelope.output_hash, raw: false),
            (key: "platform", value: self.envelope.platform, raw: false),
            (key: "signature", value: self.envelope.signature, raw: false),
            (key: "provenance", value: self.envelope.provenance, raw: false),
            (key: "source_fingerprint", value: self.cache_identity.source_fingerprint, raw: false),
            (key: "recipe_fingerprint", value: self.cache_identity.recipe_fingerprint, raw: false),
            (key: "policy_fingerprint", value: self.cache_identity.policy_fingerprint, raw: false),
            (key: "identity_platform", value: self.cache_identity.platform, raw: false),
            (key: "references", value: pkg_hangar_json_string_array(self.references), raw: true),
            (key: "named_outputs", value: pkg_hangar_json_string_object(self.named_outputs), raw: true),
            (key: "platform_artifact_kind", value: self.platform_artifact_kind, raw: false),
            (key: "producer_record", value: self.producer_record, raw: false),
            (key: "receipt", value: self.receipt, raw: false),
            (key: "realized_at", value: "{self.realized_at}", raw: false)
        }
        out := "{{\n"
        loop field in fields {
            rendered :: if field.raw -> field.value else -> pkg_json_quote(field.value)
            out = "{out}  {pkg_json_quote(field.key)}: {rendered},\n"
        }
        // The last field carries no trailing comma.
        "{out}  {pkg_json_quote("last_used_at")}: {pkg_json_quote("{self.last_used_at}")}\n}}"
    }
}

// A JSON string literal for `text`.
fn pkg_json_quote(text: String) -> String Never! {
    pkg_json_render(Dyn.Text(text.copy()))
}

fn pkg_hangar_json_string_array(items: [String]) -> String Never! {
    quoted := [String]{}
    loop item in items -> &quoted.push(pkg_json_quote(item))
    "[{quoted.join(", ")}]"
}

fn pkg_hangar_json_string_object(map: [String: String]) -> String Never! {
    keys := map.keys().to_list()
    &keys.sort()
    parts := [String]{}
    loop key in keys -> &parts.push("{pkg_json_quote(key)}: {pkg_json_quote(map[key])}")
    "{{{parts.join(", ")}}}"
}

// A `meta.json` record parsed back into typed fields; the engine's
// `read_meta` shares this parser.
struct ParsedMeta {
    name: String
    version: String
    reference: String
    out: String
    bin: String
    rlib: String
    envelope: Envelope
    cache_identity: CacheIdentity
    references: [String]
    named_outputs: [String: String]
    platform_artifact_kind: String
    producer_record: String
    receipt: String
    realized_at: Int?
    last_used_at: Int?
}

fn pkg_parse_meta(text: String) -> ParsedMeta? Never! {
    tree :: json.parse(text) ?? return None
    object :: pkg_json_object(tree) ?? return None
    name :: pkg_meta_text(object, "name") ?? return None
    reference :: pkg_meta_text(object, "ref") ?? return None
    out :: pkg_meta_text(object, "out") ?? return None
    bin :: pkg_meta_text(object, "bin") ?? return None
    references := [String]{}
    if object.get("references") == {
        .Val(value) -> {
            items :: pkg_json_array(value) ?? [Dyn]{}
            loop item in items {
                reference_text :: pkg_json_text(item) ?? next
                &references.push(reference_text)
            }
        }
        .None -> {}
    }
    named_outputs := [String: String]{}
    if object.get("named_outputs") == {
        .Val(value) -> {
            fields :: pkg_json_object(value) ?? [String: Dyn]{}
            loop field in fields {
                digest :: pkg_json_text(field.value) ?? next
                named_outputs[field.key] = digest
            }
        }
        .None -> {}
    }
    Val(ParsedMeta{
        name: name,
        version: pkg_meta_text(object, "version") ?? "",
        reference: reference,
        out: out,
        bin: bin,
        rlib: pkg_meta_text(object, "rlib") ?? "",
        envelope: Envelope{
            output_hash: pkg_meta_text(object, "output_hash") ?? "",
            platform: pkg_meta_text(object, "platform") ?? "",
            signature: pkg_meta_text(object, "signature") ?? "",
            provenance: pkg_meta_text(object, "provenance") ?? ""
        },
        cache_identity: CacheIdentity{
            source_fingerprint: pkg_meta_text(object, "source_fingerprint") ?? "",
            recipe_fingerprint: pkg_meta_text(object, "recipe_fingerprint") ?? "",
            policy_fingerprint: pkg_meta_text(object, "policy_fingerprint") ?? "",
            platform: pkg_meta_text(object, "identity_platform") ?? ""
        },
        references: references,
        named_outputs: named_outputs,
        platform_artifact_kind: pkg_meta_text(object, "platform_artifact_kind") ?? "",
        producer_record: pkg_meta_text(object, "producer_record") ?? "",
        receipt: pkg_meta_text(object, "receipt") ?? "",
        realized_at: pkg_meta_unsigned(object, "realized_at"),
        last_used_at: pkg_meta_unsigned(object, "last_used_at")
    })
}

fn pkg_meta_text(object: [String: Dyn], key: String) -> String? Never! {
    value :: object.get(key) ?? return None
    pkg_json_text(value)
}

// A decimal u64 text field.
fn pkg_meta_unsigned(object: [String: Dyn], key: String) -> Int? Never! {
    text :: pkg_meta_text(object, key) ?? return None
    digits :: text.removeprefix("+")
    if digits == "" -> return None
    loop byte in digits.bytes() {
        code :: Int.from_u8(byte)
        if code < 48 || code > 57 -> return None
    }
    value :: Int.parse(digits) ?? return None
    Val(value)
}

// A malformed or over-budget read of the recorded store projection.
#Error
enum HangarReadError {
    IO(IOError)
    InvalidData(String)

    fn message(self) -> String Never! {
        if self == {
            .IO(error) -> "{error}"
            .InvalidData(detail) -> detail
        }
    }
}

// Every recorded store entry, skipping malformed ones quietly: the driver's
// read-only compatibility view.
fn pkg_store_list(roots: HangarRoots) -[FS, Env]> [StoreEntry] Never! {
    pkg_store_list_impl(roots, false) ?? [StoreEntry]{}
}

// Every recorded store entry, failing closed on a malformed or over-budget
// projection; integrity-sensitive engine operations use this boundary.
fn pkg_store_list_checked(roots: HangarRoots) -[FS, Env]> [StoreEntry] HangarReadError! {
    pkg_store_list_impl(roots, true)
}

fn pkg_store_list_impl(roots: HangarRoots, strict: Bool) -[FS, Env]> [StoreEntry] HangarReadError! {
    out := [StoreEntry]{}
    store :: roots.hangar_dir()
    entries :: files.list_dir(store) ? listed -> listed ! error -> {
        if pkg_io_is_not_found(error) || !strict -> return Ok(out)
        return Err(HangarReadError.IO(error))
    }
    object_count := 0
    loop entry in entries {
        kind :: if files.stat(entry.path) == {
            .Ok(info) -> info
            .Err(error) -> {
                if !strict -> next
                return Err(HangarReadError.IO(error))
            }
        }
        if !kind.is_dir -> next
        meta :: files.join(entry.path, "meta.json")
        info :: files.stat(meta) ? found -> found ! error -> {
            if pkg_io_is_not_found(error) || !strict -> next
            return Err(HangarReadError.IO(error))
        }
        if !info.is_file || info.is_symlink {
            if strict -> return Err(HangarReadError.InvalidData("Hangar metadata `{meta}` is not a regular file"))
            next
        }
        object_count += 1
        if object_count > HANGAR_MAX_STORE_OBJECTS {
            return Err(HangarReadError.InvalidData("Hangar contains more than {HANGAR_MAX_STORE_OBJECTS} store objects"))
        }
        text :: if pkg_hangar_read_bounded_text(meta, HANGAR_MAX_STORE_META_BYTES) == {
            .Ok(read) -> read
            .Err(error) -> {
                if !strict -> next
                return Err(error)
            }
        }
        parsed :: if pkg_parse_meta(text) == {
            .Val(found) -> found
            .None -> {
                if !strict -> next
                return Err(HangarReadError.InvalidData("invalid Hangar metadata `{meta}`"))
            }
        }
        &out.push(StoreEntry{
            id: entry.name,
            name: parsed.name,
            version: parsed.version,
            reference: parsed.reference,
            out: parsed.out,
            bin: parsed.bin,
            rlib: parsed.rlib,
            envelope: parsed.envelope,
            cache_identity: parsed.cache_identity,
            references: parsed.references,
            named_outputs: parsed.named_outputs,
            platform_artifact_kind: parsed.platform_artifact_kind,
            producer_record: parsed.producer_record,
            receipt: parsed.receipt,
            realized_at: parsed.realized_at ?? 0,
            last_used_at: parsed.last_used_at ?? 0
        })
    }
    &out.sort_by(entry -> entry.id)
    Ok(out)
}

// A metadata file of at most `limit` bytes, as UTF-8.
fn pkg_hangar_read_bounded_text(path: String, limit: Int) -[FS]> String HangarReadError! {
    info :: files.stat(path) ?? return Err(HangarReadError.IO(err))
    if info.size > limit -> return Err(HangarReadError.InvalidData("Hangar metadata `{path}` exceeds {limit} bytes"))
    bytes :: files.read_at(path, 0, limit + 1) ?? return Err(HangarReadError.IO(err))
    if bytes.len() > limit -> return Err(HangarReadError.InvalidData("Hangar metadata `{path}` exceeds {limit} bytes"))
    text :: String.from_bytes(bytes) ?? return Err(HangarReadError.InvalidData("Hangar metadata `{path}` is not UTF-8"))
    Ok(text)
}
