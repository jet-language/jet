// A package's public API snapshot: the rows sema produced (sema_public_api)
// at a `jet registry publish`, one canonical signature per line under three
// header lines. The registry keeps one per published version, which the
// publish SemVer gate (E1218) diffs; the package's own
// `.jet/cache/api/<package>.api` copy feeds the lock fingerprint, which folds
// the signatures in as canonical TEXT, not a second hash: Lock folds it into
// SHA256.
use {
    jet_foundation.[diagnostic_text_lines]
    jetpack_foundation.[foundation_read_file_nofollow_at_root]
    sys: core.sys
    files: core.files
}

PKG_API_SNAPSHOT_VERSION: 4
// The kind keywords a snapshot signature line starts with.
PKG_API_SNAPSHOT_KINDS: [String]{"cap", "const", "distinct", "enum", "field", "fn", "impl", "require", "struct", "trait", "type", "unit", "variant"}

PackageCapabilitySnapshot: struct {
    api_version: Int
    package: String
    published_version: String
    signatures: [String]
}

// The kind and name a snapshot signature line declares: the kind keyword and
// the dotted path after it, up to the first `<`, `(`, `{`, `[`, `:`, `=` or space.
pkg_api_snapshot_line_name: fn(line: String) -> (kind: String, name: String)? Never! {
    loop kind in PKG_API_SNAPSHOT_KINDS {
        if !line.starts_with("{kind} ") -> next
        name := line.removeprefix("{kind} ")
        loop marker in ([String]{"<", "(", "{{", "[", ":", "=", " "}) {
            if name.split_once(marker) == .Val(pair) -> name = pair.before
        }
        if name == "" -> return None
        return Val((kind: kind.copy(), name: name))
    }
    None
}

pkg_capability_snapshot_parse: fn(raw: String) -> PackageCapabilitySnapshot? Never! {
    version := Int?{None}
    package := String?{None}
    published := String?{None}
    signatures := [String]{}
    loop raw_line in diagnostic_text_lines(raw) {
        line: raw_line.trim()
        if line == "" -> next
        if {
            line.starts_with("api_version = ") -> version = Val(pkg_lock_parse_unsigned(line.removeprefix("api_version = "), 4294967295) ?? return None)
            line.starts_with("package = ") -> package = Val(line.removeprefix("package = "))
            line.starts_with("published_version = ") -> published = Val(line.removeprefix("published_version = "))
            pkg_api_snapshot_line_name(line) != None -> signatures.push(line)
            line.contains(": fn") -> {
                name := line
                if line.split_once(": fn") == .Val(pair) -> name = pair.before
                if name.trim() == "" -> return None
                signatures.push(line)
            }
            else -> return None
        }
    }
    api_version: version ?? return None
    release: published ?? return None
    name: package ?? return None
    signatures.sort()
    Val(PackageCapabilitySnapshot{api_version: api_version, package: name, published_version: release, signatures: signatures})
}

pkg_api_snapshot_render: fn(package: String, published_version: String, signatures: [String]) -> String Never! {
    body: if signatures.len() == 0 -> "" else -> "{signatures.join("\n")}\n"
    "api_version = {PKG_API_SNAPSHOT_VERSION}\npackage = {package}\npublished_version = {published_version}\n{body}"
}
pkg_capability_snapshot_text: fn(snapshots: [PackageCapabilitySnapshot]) -> String Never! {
    ordered := snapshots
    ordered.sort_by((left: PackageCapabilitySnapshot, right: PackageCapabilitySnapshot) -> left.package <=> right.package)
    parts := [String]{}
    loop snapshot in ordered -> parts.push("{snapshot.package}\n{snapshot.signatures.join("\n")}")
    parts.join("\n--\n")
}
pkg_project_capability_digest: fn(project_root: String) -[FS, Env]> String Never! {
    directory: sys.get("JET_API_CACHE_DIR") ?? files.join(project_root, ".jet/cache/api")
    entries := files.list_dir(directory) ?? return ""
    entries.sort_by((left: files.DirEntry, right: files.DirEntry) -> left.name <=> right.name)
    snapshots := [PackageCapabilitySnapshot]{}
    loop entry in entries {
        if !entry.name.ends_with(".api") -> next
        bytes: foundation_read_file_nofollow_at_root(directory, entry.name, PKG_MAX_LOCK_BYTES) ?? next
        raw: String.from_bytes(bytes) ?? next
        snapshot: pkg_capability_snapshot_parse(raw) ?? next
        snapshots.push(snapshot)
    }
    pkg_capability_snapshot_text(snapshots)
}
