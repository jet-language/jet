// Hangar Store v2 path law (jet-pkg-model Envelope.rs, E4-JP1): reserved
// Windows names, trailing `.`/space aliases, backslashes, case-fold sibling
// collisions, and `.`/`..` components are rejected so the same tree is
// representable on every tier-one platform. Unicode normalization is never
// implicit: NFC and NFD spellings that differ in bytes are distinct names.

@PATH_LAW_RESERVED_NAMES :: [String]{
    "CON", "PRN", "AUX", "NUL",
    "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8", "COM9",
    "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7", "LPT8", "LPT9"
}

// Path-law failure (E1299) with a stable code the CLI and tests match on.
#Error
pub struct PathLawError {
    pub code: String
    pub path: String
    pub detail: String

    fn what(self) -> String Never! {
        "store path rejected: `{self.path}`"
    }

    fn why(self) -> String Never! {
        "Hangar Store v2 path law ({self.code}) forbids this name: {self.detail}."
    }

    fn fix(self) -> String Never! {
        "Rename the entry to a portable store path: no reserved Windows names, no trailing `.`/` `, no case-fold collisions with a sibling, and no `.`/`..` components."
    }

    fn message(self) -> String Never! {
        "{self.what()} — {self.detail}"
    }
}

// Reject one path component under the native ingest law.
pub fn pkg_validate_path_component(name: [U8]) PathLawError! {
    pkg_validate_path_component_with_mode(name, false)
}

// Validate one component; Nix admission (`allow_nix_store_symlinks`) accepts
// exactly Nix's own component law: any byte except `/` and NUL, not `.`/`..`.
pub fn pkg_validate_path_component_with_mode(name: [U8], allow_nix_store_symlinks: Bool) PathLawError! {
    if name.len() == 0 -> return Err(PathLawError{code: "empty", path: "", detail: "empty path component"})
    if name.contains(U8{0}) -> return Err(PathLawError{code: "nul", path: pkg_lossy_text(name), detail: "NUL byte in path component"})
    if name == ".".bytes() || name == "..".bytes() {
        return Err(PathLawError{code: "dot", path: pkg_lossy_text(name), detail: "`.` and `..` are not store path components"})
    }
    if allow_nix_store_symlinks -> return Ok()
    if name.contains(U8{92}) {
        return Err(PathLawError{code: "backslash", path: pkg_lossy_text(name), detail: "backslash is not a portable path component outside Nix admission"})
    }
    last :: Int.from_u8(name[name.len() - 1])
    if last == 46 || last == 32 {
        return Err(PathLawError{code: "trailing-alias", path: pkg_lossy_text(name), detail: "trailing `.` or space is a Windows alias and is rejected"})
    }
    if pkg_path_law_is_windows_reserved(name) {
        return Err(PathLawError{code: "reserved", path: pkg_lossy_text(name), detail: "Windows reserved device name"})
    }
    Ok()
}

// Validate every component of a relative store path under the native law.
pub fn pkg_validate_rel_path(rel: String) PathLawError! {
    pkg_validate_rel_path_with_mode(rel, false)
}

// Validate a relative store path; the empty path is the output root itself.
// Like Rust `Path::components`, an interior `.` is skipped while a leading
// `.` and every `..` are rejected.
pub fn pkg_validate_rel_path_with_mode(rel: String, allow_nix_store_symlinks: Bool) PathLawError! {
    if rel.starts_with("/") -> return Err(PathLawError{code: "absolute", path: rel, detail: "store paths must be relative"})
    parts :: rel.split("/").to_list()
    loop index in 0..<parts.len() {
        part :: parts[index]
        if part == "" -> next
        if part == "." {
            if index == 0 -> return Err(PathLawError{code: "dot", path: rel, detail: "`.` and `..` are not store path components"})
            next
        }
        if part == ".." -> return Err(PathLawError{code: "dot", path: rel, detail: "`.` and `..` are not store path components"})
        pkg_validate_path_component_with_mode(part.bytes(), allow_nix_store_symlinks)
    }
    Ok()
}

// Reject case-fold collisions among sibling directory entry names.
pub fn pkg_reject_casefold_collisions(names: [[U8]]) PathLawError! {
    folded := [String: [U8]]{}
    loop name in names {
        key :: pkg_hex_bytes(pkg_ascii_fold(name))
        if folded.get(key) == {
            .Val(prior) -> {
                if prior != name {
                    return Err(PathLawError{code: "case-fold", path: pkg_lossy_text(name), detail: "collides with `{pkg_lossy_text(prior)}` under ASCII case-folding"})
                }
            }
            .None -> folded[key] = name
        }
    }
    Ok()
}

fn pkg_ascii_fold(bytes: [U8]) -> [U8] Never! {
    out := [U8]{}
    loop byte in bytes {
        code :: Int.from_u8(byte)
        &out.push(if code >= 65 && code <= 90 -> U8{code + 32} else -> byte)
    }
    out
}

fn pkg_path_law_is_windows_reserved(name: [U8]) -> Bool Never! {
    stem_end := name.len()
    loop index in 0..<name.len() {
        if Int.from_u8(name[index]) == 46 {
            if index > 0 -> stem_end = index
            break
        }
    }
    upper := [U8]{}
    loop index in 0..<stem_end {
        code :: Int.from_u8(name[index])
        &upper.push(if code >= 97 && code <= 122 -> U8{code - 32} else -> name[index])
    }
    text :: String.from_bytes(upper) ?? return false
    @PATH_LAW_RESERVED_NAMES.contains(text)
}

// `String::from_utf8_lossy`: each invalid byte becomes U+FFFD.
pub fn pkg_lossy_text(bytes: [U8]) -> String Never! {
    whole :: String.from_bytes(bytes) ?? {
        out := [U8]{}
        index := 0
        loop index < bytes.len() {
            lead :: Int.from_u8(bytes[index])
            width :: if {
                lead < 0x80 -> 1
                lead >= 0xC2 && lead <= 0xDF -> 2
                lead >= 0xE0 && lead <= 0xEF -> 3
                lead >= 0xF0 && lead <= 0xF4 -> 4
                else -> 0
            }
            if width > 0 && index + width <= bytes.len() && String.from_bytes(bytes[index..<index + width]) != None {
                loop offset in 0..<width -> &out.push(bytes[index + offset])
                index += width
            } else {
                &out.push(U8{0xEF})
                &out.push(U8{0xBF})
                &out.push(U8{0xBD})
                index += 1
            }
        }
        return String.from_bytes(out) ?? ""
    }
    whole
}

// Lowercase hex of `bytes`.
pub fn pkg_hex_bytes(bytes: [U8]) -> String Never! {
    digits :: "0123456789abcdef".bytes()
    out := [U8]{}
    loop byte in bytes {
        value :: Int.from_u8(byte)
        &out.push(digits[value >> 4])
        &out.push(digits[value & 15])
    }
    String.from_bytes(out) ?? ""
}
