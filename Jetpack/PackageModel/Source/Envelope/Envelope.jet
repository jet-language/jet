// (U24): the A4 hangar-object envelope. Every realized hangar object carries
// the content hash of its output tree, the platform it was built for, a
// detached- signature slot (filled by package signing, card #13), and
// provenance. A build-from-source output is an envelope-carrying object exactly
// like a substituted one, so the resolver never cares which path produced it.

Envelope: struct {
    // Content hash of the realized output tree (`sha256-…`): the cache key.
    output_hash: String
    // Target platform key (`<arch>-<os>`, e.g. `x86_64-linux`).
    platform: String
    // Detached-signature slot; empty until package signing fills it.
    signature: String
    // How this output was produced: the resolved source ref + build recipe id.
    provenance: String

    // The empty envelope of legacy records and providers that predate it.
    empty: fn() -> Envelope Never! {
        Envelope{output_hash: "", platform: "", signature: "", provenance: ""}
    }

    // True when no envelope field is populated.
    is_empty: fn(self) -> Bool Never! {
        self.output_hash == "" && self.platform == "" && self.signature == "" && self.provenance == ""
    }

    // The envelope of a freshly realized output rooted at `out`. `recipe_id`
    // names the build path (`core-source`, `core-cargo-rlib`, `nix`, …).
    for_output: fn(out: String, reference: String, recipe_id: String) -[FS, Env]> Envelope Never! {
        Envelope{
            output_hash: pkg_output_hash_of(out),
            platform: pkg_host_platform(),
            signature: "",
            provenance: "{reference} via {recipe_id}"
        }
    }
}

// The platform key of the host build target (`<arch>-<os>`).
pkg_host_platform: fn() -[Env]> String Never! {
    pkg_host_key()
}
