// Rust: crates/jet-pkg-model/src/Envelope.rs:232
fn path_component_bytes(os: OSPath) -> [U8] {
    // GATE #4494 #4483: Unix native bytes; non-Unix display is validation only.
    if selected_family() == "unix" -> return os.encoded
    os.to_string_lossy().bytes()
}

