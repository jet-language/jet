// Rust: crates/jet-pkg-model/src/Envelope.rs:348
fn xattr_value_linux(path: OSPath, name: String) -[FS]> [U8] Err! {
    // GATE #4494: C strings, synchronous buffer loans and actual errno.
    path_c :: CString.new(path.encoded) ?? return Err("xattr path contains NUL")
    name_c :: CString.new(name.bytes()) ?? return Err("xattr name contains NUL")
    size :: lgetxattr(path_c.as_ptr(), name_c.as_ptr(), null, 0)
    if size < 0 -> return Err("lgetxattr `{name}` failed: {Error.last_os_error()}")
    value := [U8].filled(size, U8{0})
    wrote :: lgetxattr(path_c.as_ptr(), name_c.as_ptr(), value.as_mut_ptr(), value.len())
    if wrote < 0 -> return Err("lgetxattr `{name}` failed: {Error.last_os_error()}")
    &value.truncate(wrote)
    value
}

// Rust: crates/jet-pkg-model/src/Envelope.rs:383
fn xattr_value_apple(path: OSPath, name: String) -[FS]> [U8] Err! {
    // GATE #4494: Darwin getxattr, XATTR_NOFOLLOW=1, position=0.
    path_c :: CString.new(path.encoded) ?? return Err("xattr path contains NUL")
    name_c :: CString.new(name.bytes()) ?? return Err("xattr name contains NUL")
    size :: getxattr(path_c.as_ptr(), name_c.as_ptr(), null, 0, 0, 0x0001)
    if size < 0 -> return Err("getxattr `{name}` failed: {Error.last_os_error()}")
    value := [U8].filled(size, U8{0})
    wrote :: getxattr(path_c.as_ptr(), name_c.as_ptr(), value.as_mut_ptr(), value.len(), 0, 0x0001)
    if wrote < 0 -> return Err("getxattr `{name}` failed: {Error.last_os_error()}")
    &value.truncate(wrote)
    value
}

// Rust: crates/jet-pkg-model/src/Envelope.rs:437
// Windows xattr-value arm rejects "semantic xattrs are unsupported on Windows".
// Rust: crates/jet-pkg-model/src/Envelope.rs:442
// Other target arm rejects "semantic xattr values are unsupported on target `<host key>`".

// Rust: crates/jet-pkg-model/src/Envelope.rs:348
// Rust: crates/jet-pkg-model/src/Envelope.rs:383
// Rust: crates/jet-pkg-model/src/Envelope.rs:437
// Rust: crates/jet-pkg-model/src/Envelope.rs:442
fn native_xattr_value(path: OSPath, name: String) -[FS]> [U8] Err! {
    // GATE #4483: exact selected-OS native value dispatcher.
    os :: selected_os()
    if os == "linux" -> return xattr_value_linux(path, name)
    if os == "macos" || os == "ios" -> return xattr_value_apple(path, name)
    if selected_family() == "windows" -> return Err("semantic xattrs are unsupported on Windows")
    return Err("semantic xattr values are unsupported on target `{pkg_host_key()}`")
}


// Rust: crates/jet-pkg-model/src/Envelope.rs:450
fn list_xattr_names_linux(path: OSPath) -[FS]> [String] Err! {
    // GATE #4494: llistxattr never follows the final symlink.
    c_path :: CString.new(path.encoded) ?? return Err("path `{path.display()}` contains NUL")
    size :: llistxattr(c_path.as_ptr(), null, 0)
    if size < 0 -> return Err("cannot inspect xattrs on `{path.display()}`: {Error.last_os_error()}")
    if size == 0 -> return [String]{}
    buf := [U8].filled(size, U8{0})
    wrote :: llistxattr(c_path.as_ptr(), buf.as_mut_ptr(), buf.len())
    if wrote < 0 -> return Err("cannot read xattr names on `{path.display()}`: {Error.last_os_error()}")
    names := [String]{}
    loop name in buf[0..<wrote].split(U8{0}) {
        if !name.is_empty() -> &names.push(String.from_utf8_lossy(name))
    }
    names
}

// Rust: crates/jet-pkg-model/src/Envelope.rs:488
fn list_xattr_names_apple(path: OSPath) -[FS]> [String] Err! {
    // GATE #4494: Darwin listxattr with XATTR_NOFOLLOW=1.
    c_path :: CString.new(path.encoded) ?? return Err("path `{path.display()}` contains NUL")
    size :: listxattr(c_path.as_ptr(), null, 0, 0x0001)
    if size < 0 -> return Err("listxattr failed: {Error.last_os_error()}")
    names_buf := [U8].filled(size, U8{0})
    wrote :: listxattr(c_path.as_ptr(), names_buf.as_mut_ptr(), names_buf.len(), 0x0001)
    if wrote < 0 -> return Err("listxattr failed: {Error.last_os_error()}")
    names := [String]{}
    loop name in names_buf[0..<wrote].split(U8{0}) {
        if !name.is_empty() -> &names.push(String.from_utf8_lossy(name))
    }
    names
}

// Rust: crates/jet-pkg-model/src/Envelope.rs:529
// Canonical Xattrs.jet:87 pkg_file_has_sparse_holes; Linux implementation below,
// every non-Linux target returns false as in the reference.

// Rust: crates/jet-pkg-model/src/Envelope.rs:529
fn native_file_has_sparse_holes(path: OSPath) -[FS]> Bool Err! {
    if selected_os() == "linux" -> return file_has_sparse_holes_linux(path)
    false
}

// Rust: crates/jet-pkg-model/src/Envelope.rs:542
fn file_has_sparse_holes_linux(path: OSPath) -[FS]> Bool Err! {
    // GATE #4494: SAME held descriptor for metadata and Linux SEEK_HOLE.
    file :: descriptors.open_reader(path, descriptors.OpenOptions{
        nofollow: true, cloexec: true, open_reparse_point: false,
        read: true, write: None, share_mode: None,
        custom_flags: U32{nofollow_open_flag()}
    }) ?? return Err("cannot open `{path.display()}` for sparse probe: {err}")
    len :: file.stat() ?? return Err("cannot stat `{path.display()}`: {err}")
    if len.size == 0 -> return false
    hole :: lseek(file.as_raw_fd(), I64{0}, I32{4})
    if hole < 0 -> return false
    U64{hole} < len.size
}

