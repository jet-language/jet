// Rust: crates/jet-pkg-model/src/Envelope.rs:265
pub fn nofollow_open_flag() -> I32 Err! {
    // GATE #4483: selected target, not the machine running the compiler.
    os :: selected_os()
    if os == "linux" || os == "android" -> return I32{0o400000}
    if os == "macos" || os == "ios" -> return I32{0x0100}
    return Err("nofollow file access is unsupported on target `{pkg_host_key()}`")
}

// Rust: crates/jet-pkg-model/src/Envelope.rs:278
// Canonical Xattrs.jet:30 pkg_list_xattr_names; native Linux/Apple arms below.
// Windows returns an empty list; every other OS rejects with
// "semantic xattr inspection is unsupported on target `<host key>`".

// Rust: crates/jet-pkg-model/src/Envelope.rs:278
fn native_list_xattr_names(path: OSPath) -[FS]> [String] Err! {
    // GATE #4483: preserve every cfg arm of the sole canonical entry.
    os :: selected_os()
    if os == "linux" -> return list_xattr_names_linux(path)
    if os == "macos" || os == "ios" -> return list_xattr_names_apple(path)
    if selected_family() == "windows" -> return [String]{}
    return Err("semantic xattr inspection is unsupported on target `{pkg_host_key()}`")
}

