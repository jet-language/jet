fn path_bytes(path: OSPath) -> [U8] {
    // GATE #4483 #4494: raw Unix bytes, the reference's lossy non-Unix encoding.
    if selected_family() == "unix" -> return path.encoded
    path.to_string_lossy().bytes()
}

