//RS /// The A4 envelope. `Default` is the empty envelope (older records / providers
//RS /// that predate the field), so reading a legacy `meta.json` never fails.
//RS #[derive(Debug, Clone, PartialEq, Eq, Default)]
//RS pub struct Envelope {
//RS     /// Content hash of the realized output tree (`sha256-…`) — the cache key.
//RS     pub output_hash: String,
//RS     /// Target platform key (`<arch>-<os>`, e.g. `x86_64-linux`).
//RS     pub platform: String,
//RS     /// Detached-signature slot; empty until package signing (card #13) fills it.
//RS     pub signature: String,
//RS     /// How this output was produced: the resolved source ref + build recipe id.
//RS     pub provenance: String,
//RS }
//RS 
//RS impl Envelope {
//RS     /// True when no envelope field is populated (a legacy or unrealized record).
//RS     pub fn is_empty(&self) -> bool {
//RS         self.output_hash.is_empty()
//RS             && self.platform.is_empty()
//RS             && self.signature.is_empty()
//RS             && self.provenance.is_empty()
//RS     }
//RS 
//RS     /// Build the envelope for a freshly realized output rooted at `out`.
//RS     /// `reference` is the resolved source ref; `recipe_id` names the build path
//RS     /// that produced it (`core-source`, `core-cargo-rlib`, `nix`, …).
//RS     pub fn for_output(out: &str, reference: &str, recipe_id: &str) -> Envelope {
//RS         Envelope {
//RS             output_hash: output_hash_of(out),
//RS             platform: host_platform(),
//RS             signature: String::new(),
//RS             provenance: format!("{reference} via {recipe_id}"),
//RS         }
//RS     }
//RS }
//RS 
//RS /// The platform key for the host build target (`<arch>-<os>`). std-only (I6):
//RS /// derived from the compile target, which is what the realized artifact runs on.
//RS pub fn host_platform() -> String {
//RS     super::Platform::host_key()
//RS }
//RS 
//RS /// Content hash of a realized output root.
//RS ///
//RS /// For a real local directory or regular-file root this is the full content
//RS /// hash (every node's relative path, length, and bytes) — not the compiler's
//RS /// `.jet`-only `tree_hash`, since a realized output is `bin/`, `.rlib`, and
//RS /// arbitrary files.
//RS /// Existing files and symlinks are hashed from their bytes/target. Callers
//RS /// that can report failure should use [`try_output_hash_of`]; missing or
//RS /// unreadable outputs produce an empty compatibility digest here and Store
//RS /// registration rejects that digest.
//RS pub fn output_hash_of(out: &str) -> String {
//RS     try_output_hash_of(out).unwrap_or_default()
//RS }
//RS 
//RS /// Canonical archive digest. The byte stream records every node's relative
//RS /// path, type, mode, and type-specific payload. Symlinks are never followed
//RS /// while encoding; native relative targets stay lexically inside the root,
//RS /// while Nix admission may name one sibling store object. Absolute Nix-store
//RS /// targets are allowed only in Hangar mode. Hardlink identity is explicit;
//RS /// unsupported special files fail closed.
//RS pub fn try_output_hash_of(out: &str) -> Result<String, String> {
//RS     try_output_hash_of_with_policy(out, false, &mut |_, _| {})
//RS }
//RS 
//RS /// Like [`try_output_hash_of`], but Hangar/internal shared-CAS hardlink peers
//RS /// do not fail the external-hardlink law. Peers outside those roots still
//RS /// reject. Digest bytes stay path-local: CAS peers are never encoded as
//RS /// in-tree `H` records.
//RS pub fn try_output_hash_of_in_hangar(
//RS     out: &str,
//RS     hangar_root: &Path,
//RS     allow_semantic_xattrs: bool,
//RS ) -> Result<String, String> {
//RS     try_output_hash_of_in_hangar_with_policy(
//RS         out,
//RS         hangar_root,
//RS         allow_semantic_xattrs,
//RS         &mut |_, _| {},
//RS     )
//RS }
//RS 
//RS /// Like [`try_output_hash_of_in_hangar`], with the same canonical traversal
//RS /// event hook as [`try_output_hash_of_with_policy`]. The hook is an observation
//RS /// seam only; the canonical archive remains the sole output identity.
//RS pub fn try_output_hash_of_in_hangar_with_policy(
//RS     out: &str,
//RS     hangar_root: &Path,
//RS     allow_semantic_xattrs: bool,
//RS     hook: &mut dyn FnMut(&Path, &'static str),
//RS ) -> Result<String, String> {
//RS     try_output_hash_of_with_hook(out, allow_semantic_xattrs, Some(hangar_root), hook)
//RS }
//RS 
//RS /// Like [`try_output_hash_of`], with an explicit semantic-xattr policy.
//RS pub fn try_output_hash_of_with_policy(
//RS     out: &str,
//RS     allow_semantic_xattrs: bool,
//RS     hook: &mut dyn FnMut(&Path, &'static str),
//RS ) -> Result<String, String> {
//RS     try_output_hash_of_with_hook(out, allow_semantic_xattrs, None, hook)
//RS }
//RS 
