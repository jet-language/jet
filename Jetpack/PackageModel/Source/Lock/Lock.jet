//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub enum LockSource {
//RS     Root,
//RS     Path(String),
//RS     Git {
//RS         url: String,
//RS         selector: String,
//RS     },
//RS     /// D-JPK-OFFLINE2=B: a package realized through the Nix compatibility
//RS     /// provider. `reference` is the source ref it was realized from
//RS     /// (`openssl@nixpkgs`); `output` is the portable Hangar content digest.
//RS     /// The complete replay identity lives on `LockedPackage::nix_closure` and
//RS     /// is mandatory for this source variant.
//RS     Nix {
//RS         reference: String,
//RS         output: String,
//RS     },
//RS     /// D-FFI-R1: exact CRAN closure pinned by SHA-256 and realized output.
//RS     Cran {
//RS         reference: String,
//RS         output: String,
//RS         source_hash: String,
//RS         repository: String,
//RS         authority: String,
//RS     },
//RS     /// D-FFI-LUA1 / D-JPK-PROVIDERS2: exact LuaRocks closure and output.
//RS     LuaRocks {
//RS         reference: String,
//RS         output: String,
//RS         source_hash: String,
//RS         repository: String,
//RS         authority: String,
//RS     },
//RS     /// D-FFI-RUBY1/PERL1/PHP1: exact foreign scripting-registry closure.
//RS     Registry {
//RS         registry: String,
//RS         reference: String,
//RS         output: String,
//RS         source_hash: String,
//RS         repository: String,
//RS         authority: String,
//RS         /// `core` or `community` for Jet's package registry. Other registry
//RS         /// providers use `not-applicable`.
//RS         tier: String,
//RS         /// Canonical gate summary recorded by the Jet package registry.
//RS         gate_status: String,
//RS     },
//RS     /// D-FFI-UNIFY1: the exact foreign package provider ref and the verified
//RS     /// Hangar projection used to materialize its binding.
//RS     Foreign {
//RS         language: crate::AST::ForeignLanguage,
//RS         reference: String,
//RS         output: String,
//RS     },
//RS }
