//RS                     self.missing_field,
//RS                     Syntax::UNIFIED_LOCK_FILE
//RS                 ),
//RS                 format!("run {command} and commit `{}`", Syntax::UNIFIED_LOCK_FILE),
//RS                 None,
//RS             ),
//RS             LockRecordKind::Toolchain => Diagnostic::error(
//RS                 "E1250",
//RS                 format!("toolchain channel `{}` has an incomplete lock record", self.name),
//RS                 format!(
//RS                     "`{}` is missing `{}` in `{}`; locked or offline builds need \
//RS                      the exact toolchain identity",
//RS                     self.name,
//RS                     self.missing_field,
//RS                     Syntax::UNIFIED_LOCK_FILE
//RS                 ),
//RS                 format!("run {command} and commit `{}`", Syntax::UNIFIED_LOCK_FILE),
//RS                 None,
//RS             ),
//RS             LockRecordKind::SourceChannel => Diagnostic::error(
//RS                 "E1271",
//RS                 format!("source channel `{}` has an incomplete lock record", self.name),
//RS                 format!(
//RS                     "`{}` is missing `{}` in `{}`; realization must use the \
//RS                      previously locked exact source",
//RS                     self.name,
//RS                     self.missing_field,
//RS                     Syntax::UNIFIED_LOCK_FILE
//RS                 ),
//RS                 format!("run {command} and commit `{}`", Syntax::UNIFIED_LOCK_FILE),
//RS                 None,
//RS             ),
//RS         }
//RS     }
//RS }
//RS 
