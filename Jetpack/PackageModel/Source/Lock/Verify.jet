// `--locked` verification: typed lock completeness, manifest staleness,
// generated-input and build-contribution replay, the plan fingerprint, and
// the registered lock diagnostics.

// The lock record kind that is incomplete. The distinction lets hosts
// report a missing generated fact without treating it as a request to move a
// declared dependency.
pub enum LockIncompleteKind {
    Dependency
    Toolchain
    SourceChannel

    fn label(self) -> String Never! {
        if self == {
            .Dependency -> "dependency"
            .Toolchain -> "toolchain"
            .SourceChannel -> "source channel"
        }
    }
}

// Safe regeneration data for a lock diagnostic. `argv` stays separate from a
// shell command string so CLI hosts can run it without interpolation.
pub struct LockRegeneration {
    pub argv: [String]

    fn dependency() -> LockRegeneration Never! {
        LockRegeneration{argv: [String]{BINARY_NAME, "fetch"}}
    }

    fn toolchain() -> LockRegeneration Never! {
        LockRegeneration{argv: [String]{BINARY_NAME, "update", "jet"}}
    }

    fn source_channel(name: String) -> LockRegeneration Never! {
        LockRegeneration{argv: [String]{JETPACK_BINARY_NAME, "update", name}}
    }

    // Each argument in backticks, space separated.
    fn display(self) -> String Never! {
        quoted := [String]{}
        loop arg in self.argv -> &quoted.push("`{arg}`")
        quoted.join(" ")
    }
}

// A generated lock record is missing one concrete fact a later locked or
// offline realization needs.
#Error
pub struct LockCompletenessError {
    pub kind: LockIncompleteKind
    pub name: String
    pub missing_field: String
    pub regeneration: LockRegeneration

    fn missing(kind: LockIncompleteKind, name: String, missing_field: String, regeneration: LockRegeneration) -> LockCompletenessError Never! {
        LockCompletenessError{kind: kind, name: name, missing_field: missing_field, regeneration: regeneration}
    }

    fn dependency(name: String, missing_field: String) -> LockCompletenessError Never! {
        LockCompletenessError.missing(LockIncompleteKind.Dependency, name, missing_field, LockRegeneration.dependency())
    }

    // The Rust `Display` text.
    fn message(self) -> String Never! {
        "{self.kind.label()} `{self.name}` is missing `{self.missing_field}`; regenerate with {self.regeneration.display()}"
    }

    // The registered host diagnostic. Hosts may instead read the typed
    // fields and run `regeneration.argv` directly.
    fn diagnostic(self) -> Diagnostic Never! {
        command :: self.regeneration.display()
        fix :: "run {command} and commit `{UNIFIED_LOCK_FILE}`"
        if self.kind == {
            .Dependency -> diagnostic_from_registry("E1217", None, "dependency `{self.name}` has an incomplete lock record", "`{self.name}` is missing `{self.missing_field}` in `{UNIFIED_LOCK_FILE}`; a locked or offline realization cannot reconstruct this dependency", fix)
            .Toolchain -> diagnostic_from_registry("E1250", None, "toolchain channel `{self.name}` has an incomplete lock record", "`{self.name}` is missing `{self.missing_field}` in `{UNIFIED_LOCK_FILE}`; locked or offline builds need the exact toolchain identity", fix)
            .SourceChannel -> diagnostic_from_registry("E1271", None, "source channel `{self.name}` has an incomplete lock record", "`{self.name}` is missing `{self.missing_field}` in `{UNIFIED_LOCK_FILE}`; realization must use the previously locked exact source", fix)
        }
    }
}

// The manifest's dependency names in key order.
fn pkg_lock_manifest_dependency_names(manifest: Manifest) -> [String] Never! {
    names := manifest.dependencies.keys().to_list()
    &names.sort()
    names
}

// Whether a manifest dependency and its lock record share a source kind.
fn pkg_lock_same_source_kind(spec: DepSpec, source: LockSource) -> Bool Never! {
    if spec == {
        .Path(_) -> if source == {
            .Path(_) -> true
            else -> false
        }
        .Git(_, _) -> if source == {
            .Git(_, _) -> true
            else -> false
        }
        .Registry(_) -> if source == {
            .Registry(_, _, _, _, _, _, _, _) -> true
            else -> false
        }
        .Foreign(_, _) -> if source == {
            .Foreign(_, _, _) -> true
            else -> false
        }
    }
}

// Validate only the lock material the manifest's direct dependencies need.
// Source identity mismatches are left to `pkg_lock_verify_lock_matches_manifest`,
// which reports a stale lock and asks the user to update it.
pub fn pkg_lock_validate_manifest_lock_completeness(manifest: Manifest, lock: LockFile) LockCompletenessError! {
    loop dep_name in pkg_lock_manifest_dependency_names(manifest) {
        spec :: manifest.dependencies[dep_name]
        package :: lock.find_package(dep_name) ?? return Err(LockCompletenessError.dependency(dep_name, "package"))
        if package.version.trim() == "" -> return Err(LockCompletenessError.dependency(dep_name, "version"))
        // A source-kind mismatch is stale manifest/lock state, not an
        // incomplete generated record; the stale-only verifier owns it.
        if pkg_lock_same_source_kind(spec, package.source) -> package.validate_completeness()
    }
}

// Check that the lock still describes each manifest dependency's declared
// source. Stale-only: missing generated facts are reported by
// `pkg_lock_verify_all_manifest_deps_locked` as a typed completeness error.
pub fn pkg_lock_verify_lock_matches_manifest(lock: LockFile, manifest: Manifest, lock_path: String) LockError! {
    loop dep_name in pkg_lock_manifest_dependency_names(manifest) {
        spec :: manifest.dependencies[dep_name]
        // The stronger typed verifier owns a missing package record.
        package :: lock.find_package(dep_name) ?? next
        source_matches :: if spec == {
            .Path(path) -> if package.source == {
                .Path(locked_path) -> path == locked_path
                else -> false
            }
            .Git(url, selector) -> if package.source == {
                .Git(locked_url, locked_selector) -> url == locked_url && pkg_lock_git_selector_str(selector) == locked_selector
                else -> false
            }
            .Registry(_) | .Foreign(_, _) -> pkg_lock_same_source_kind(spec, package.source)
        }
        if !source_matches -> return Err(LockError.Reported(pkg_lock_e1202(lock_path)))
    }
}

// Stronger, bidirectional completeness check (D-SUPPLY1, Step 2): every
// manifest dependency must carry the exact generated facts a locked/offline
// realization consumes. Source-kind mismatches stay with the stale verifier
// so callers can tell "regenerate the lock" from "update the lock".
pub fn pkg_lock_verify_all_manifest_deps_locked(manifest: Manifest, lock: LockFile) LockCompletenessError! {
    pkg_lock_validate_manifest_lock_completeness(manifest, lock)
}

// D-RINGLAYER1=A M2: the manifest `runtime:` ceiling set on locked packages
// at fetch time.
pub fn pkg_lock_layer_from_manifest(manifest: Manifest) -> MIRRuntimeLayer? Never! {
    manifest.package.layer
}

fn pkg_lock_e3512(what: String, why: String, fix: String) -> Diagnostic Never! {
    diagnostic_from_registry("E3512", None, what, why, fix)
}

// D-BUILDGEN1: `--locked` requires every generated input to already be in
// the unified lock with the same hash.
pub fn pkg_lock_verify_locked_generated_inputs(project_root: String, generated: [ComptimeInput]) LockError! -[FS]> {
    loaded :: pkg_lock_load(project_root)
    if loaded == None {
        if generated.len() == 0 -> return
        return Err(LockError.Reported(pkg_lock_e3512("locked generated input `{generated[0].path}` has no unified lock entry", "`--locked` requires every generated source hash to be recorded before materialization", "rerun without `--locked` to review and record the generated provenance")))
    }
    lock :: loaded
    loop input in generated {
        if !lock.comptime_inputs.contains(input) -> return Err(LockError.Reported(pkg_lock_e3512("locked generated input `{input.path}` drifted", "`--locked` requires generated input and output hashes to match the unified lock exactly", "rerun without `--locked` to review and record the new generated provenance")))
    }
}

// D-BUILDGEN1: record generated-module output hashes in the unified lock,
// upserting by managed path so a rebuild replaces drift instead of
// appending.
pub fn pkg_lock_record_generated_inputs(project_root: String, generated: [ComptimeInput], locked: Bool, stamp: BuildStamp) LockError! -[FS, Env, Time]> {
    lock_was_present :: files.exists(pkg_lock_file_path(project_root))
    pkg_lock_record_generated_inputs_with_lock_state(project_root, generated, locked, stamp, lock_was_present)
}

// Record generated provenance while preserving whether the build started
// with a lock. The driver captures that state before its runtime reload can
// publish any lock update, so a first build bootstraps dependencies once.
pub fn pkg_lock_record_generated_inputs_with_lock_state(project_root: String, generated: [ComptimeInput], locked: Bool, stamp: BuildStamp, lock_was_present: Bool) LockError! -[FS, Env, Time]> {
    lock := pkg_lock_load_or_empty(project_root)
    if locked {
        expected :: pkg_lock_dedup_comptime_inputs(pkg_lock_sorted_comptime_inputs(lock.comptime_inputs))
        actual :: pkg_lock_dedup_comptime_inputs(pkg_lock_sorted_comptime_inputs(generated))
        if expected == actual -> return
        path := "<unknown>"
        drifted := false
        loop input in actual {
            if !drifted && !expected.contains(input) {
                path = input.path
                drifted = true
            }
        }
        loop input in expected {
            if !drifted && !actual.contains(input) {
                path = input.path
                drifted = true
            }
        }
        return Err(LockError.Reported(pkg_lock_e3512("locked generated input `{path}` drifted", "`--locked` requires generated input and output hashes to match the unified lock exactly", "rerun without `--locked` to review and record the new generated provenance")))
    }
    // Bootstrap direct dependency names only for a new lock. Existing locks
    // stay under the loader's fail-closed manifest-drift check.
    if !lock_was_present {
        loaded :: if pkg_manifest_load(project_root) == {
            .Ok(manifest) -> manifest
            .Err(error) -> { return Err(LockError.Reported(error.diagnostic)) }
        }
        if loaded == {
            .Val(manifest) -> {
                loop dependency in pkg_lock_manifest_dependency_names(manifest) {
                    if !lock.root_dependencies.contains(dependency) -> &lock.root_dependencies.push(dependency)
                }
                &lock.root_dependencies.sort()
            }
            .None -> {}
        }
    }
    if lock.build_stamp == None -> lock.build_stamp = Val(stamp)
    loop input in generated {
        replaced := false
        loop index in 0..<lock.comptime_inputs.len() {
            if !replaced && lock.comptime_inputs[index].path == input.path {
                lock.comptime_inputs[index] = input
                replaced = true
            }
        }
        if !replaced -> &lock.comptime_inputs.push(input)
    }
    lock.comptime_inputs = pkg_lock_sorted_comptime_inputs(lock.comptime_inputs)
    if pkg_lock_write_atomically(project_root, pkg_lock_write(lock).bytes()) == {
        .Ok(_) -> {}
        .Err(error) -> return Err(LockError.Reported(pkg_lock_write_error(pkg_lock_file_path(project_root), error.message())))
    }
}

// One computed fact writer's stable lock projection. The value is the
// writer's Rust `Debug` spelling (`Text("…")`, `Bool(true)`, …).
fn pkg_lock_locked_build_contribution(package: String, contribution: FactContribution) -> LockedBuildContribution Never! {
    LockedBuildContribution{
        package: package,
        key: contribution.key,
        value: fact_value_debug_text(contribution.value),
        scope: source_scope_name(contribution.scope),
        layer: contribution_layer_name(contribution.layer),
        source: contribution.source,
        reason: contribution.reason ?? ""
    }
}

fn pkg_lock_locked_build_contribution_set(package: String, contributions: [FactContribution]) -> [LockedBuildContribution] Never! {
    records := [LockedBuildContribution]{}
    loop contribution in contributions -> &records.push(pkg_lock_locked_build_contribution(package, contribution))
    pkg_lock_sorted_contributions(records)
}

// D-CONF-SPLIT1=A: locked builds replay the exact computed writer set.
pub fn pkg_lock_verify_locked_build_contributions(project_root: String, package: String, contributions: [FactContribution]) LockError! -[FS]> {
    actual :: pkg_lock_locked_build_contribution_set(package, contributions)
    loaded :: pkg_lock_load(project_root)
    if loaded == None {
        if actual.len() == 0 -> return
        return Err(LockError.Reported(pkg_lock_e3512("locked build contributions for `{package}` are not recorded", "a locked build must replay every computed fact writer from `.jet/lock`", "rerun without `--locked` to record the computed contribution chain")))
    }
    lock :: loaded
    recorded := [LockedBuildContribution]{}
    loop contribution in lock.build_contributions {
        if contribution.package == package -> &recorded.push(contribution)
    }
    if pkg_lock_sorted_contributions(recorded) == actual -> return
    return Err(LockError.Reported(pkg_lock_e3512("locked build contribution for `{package}` drifted", "the computed fact writer chain differs from the chain recorded in `.jet/lock`", "rerun without `--locked` to review and record the new contribution chain")))
}

// D-CONF-SPLIT1=A: replace one package's computed writer records in the
// unified lock after the selected runtime bundle passed the front end.
pub fn pkg_lock_record_build_contributions(project_root: String, package: String, contributions: [FactContribution], locked: Bool, stamp: BuildStamp) LockError! -[FS, Env, Time]> {
    if locked -> return pkg_lock_verify_locked_build_contributions(project_root, package, contributions)
    lock := pkg_lock_load_or_empty(project_root)
    // Explicit foreign-build selections are project-level activation state,
    // not computed package facts; a later native package build must not
    // erase the reviewed plan that ordinary `jet build` consumes.
    kept := [LockedBuildContribution]{}
    loop contribution in lock.build_contributions {
        if contribution.package == "__jet_foreign_build__" || contribution.package != package -> &kept.push(contribution)
    }
    loop record in pkg_lock_locked_build_contribution_set(package, contributions) -> &kept.push(record)
    lock.build_contributions = pkg_lock_sorted_contributions(kept)
    if lock.build_stamp == None -> lock.build_stamp = Val(stamp)
    if pkg_lock_write_atomically(project_root, pkg_lock_write(lock).bytes()) == {
        .Ok(_) -> {}
        .Err(error) -> return Err(LockError.Reported(pkg_lock_write_error(pkg_lock_file_path(project_root), error.message())))
    }
}

// E3502: a generated-provenance lock update the file system rejected.
fn pkg_lock_write_error(path: String, error: String) -> Diagnostic Never! {
    diagnostic_from_registry("E3502", None, "generated provenance could not update `{path}`", "the unified lock update is transactional and the filesystem rejected it: {error}", "make the project lock directory writable and rerun the build")
}

// The plan fingerprint of one package: sha256 over the source tree hash,
// the sorted direct-dependency fingerprints, and (S2/D-MEM1) the snapshotted
// public-fn capability digest when one exists, each NUL-terminated. An
// empty `cap_digest` (first publish) leaves the tree+deps form unchanged.
pub fn pkg_lock_compute_fingerprint(tree_hash: String, dep_fingerprints: [String], cap_digest: String) -> String Never! {
    data := [U8]{}
    loop byte in tree_hash.bytes() -> &data.push(byte)
    &data.push(U8{0})
    sorted := dep_fingerprints
    &sorted.sort()
    loop fingerprint in sorted {
        loop byte in fingerprint.bytes() -> &data.push(byte)
        &data.push(U8{0})
    }
    if cap_digest != "" {
        loop byte in "cap:{cap_digest}".bytes() -> &data.push(byte)
        &data.push(U8{0})
    }
    "sha256-{pkg_sha256_hex(data)}"
}

// E1201: two versions of one package with their dependency chains.
pub fn pkg_lock_e1201(package_name: String, version_a: String, chain_a: [String], version_b: String, chain_b: [String]) -> Diagnostic Never! {
    diagnostic_from_registry(
        "E1201",
        None,
        "two versions of `{package_name}` are required",
        "a package graph can have only one version of each package — two different packages require `{package_name}` at conflicting versions",
        "choose one version and update the conflicting dependencies:\n  {chain_a.join(" → ")} ({version_a})\n  {chain_b.join(" → ")} ({version_b})"
    )
}

// E1202: the lock is out of date.
pub fn pkg_lock_e1202(lock_path: String) -> Diagnostic Never! {
    diagnostic_from_registry("E1202", None, "the lock file is out of date", "`{PACKAGE_FILE}` changed since `{UNIFIED_LOCK_FILE}` was last written", "run `jet fetch` to update `{UNIFIED_LOCK_FILE}`")
}

// E1205: lock data is corrupt or exceeds the reader safety bound.
pub fn pkg_lock_e1205_lock_corrupt(lock_path: String) -> Diagnostic Never! {
    pkg_diagnostic_from_row("E1205", [(name: String, value: String)]{(name: "path", value: lock_path)}, None)
}

// E1214: the lock declares a format version outside this reader's support
// set.
pub fn pkg_lock_e1214_lock_unsupported(lock_path: String, version: String, supported: String) -> Diagnostic Never! {
    pkg_diagnostic_from_row("E1214", [(name: String, value: String)]{(name: "path", value: lock_path), (name: "version", value: version), (name: "supported", value: supported)}, None)
}

// E1202 for a workspace lock whose source/index identity cannot be trusted.
pub fn pkg_lock_e1202_workspace(lock_path: String) -> Diagnostic Never! {
    diagnostic_from_registry("E1202", None, "the workspace lock `{lock_path}` is malformed or stale", "workspace membership and overlay facts must match the current `workspace.jet` and Package sources", "run `jetpack env` from the workspace root after fixing the workspace or Package sources")
}

// E1202 for a workspace lock write that did not complete.
pub fn pkg_lock_e1202_workspace_write(lock_path: String, error: String) -> Diagnostic Never! {
    diagnostic_from_registry("E1202", None, "the workspace lock `{lock_path}` could not be written", "the workspace index is not usable until the lock write succeeds: {error}", "fix the workspace lock directory permissions or storage error, then run `jetpack env` again")
}

// E1203: git is not installed.
pub fn pkg_lock_e1203() -> Diagnostic Never! {
    diagnostic_from_registry("E1203", None, "`git` is not installed", "git dependencies need the `git` command to fetch source trees", "install git and make sure it is on your PATH")
}

// The lock source selector text for a git dependency.
pub fn pkg_lock_git_selector_str(selector: GitSelector) -> String Never! {
    if selector == {
        .Tag(name) -> "tag = \"{pkg_lock_escape(name)}\""
        .Branch(branch) -> "branch = \"{pkg_lock_escape(branch)}\""
        .Rev(rev) -> "rev = \"{pkg_lock_escape(rev)}\""
    }
}

// The lock source recorded for a manifest dependency.
pub fn pkg_lock_dep_source(dep_name: String, spec: DepSpec) -> LockSource Never! {
    if spec == {
        .Path(path) -> LockSource.Path(path)
        .Git(url, selector) -> LockSource.Git{url: url, selector: pkg_lock_git_selector_str(selector)}
        .Registry(_) -> LockSource.Path("registry:{dep_name}")
        .Foreign(language, reference) -> LockSource.Foreign{language: language, reference: reference, output: ""}
    }
}

// A registered diagnostic whose What/Why/Fix come from the registry row
// templates, with each `{name}` placeholder filled (Rust
// `Diagnostic::from_row`).
fn pkg_diagnostic_from_row(code: String, args: [(name: String, value: String)], span: Span?) -> Diagnostic Never! {
    row :: diagnostic_registry_row(code) ?? panic("diagnostic `{code}` has no generated Source registry row")
    diagnostic_from_registry(code, span, pkg_diagnostic_fill_row(row.what, args), pkg_diagnostic_fill_row(row.why, args), pkg_diagnostic_fill_row(row.fix, args))
}

fn pkg_diagnostic_fill_row(template: String, args: [(name: String, value: String)]) -> String Never! {
    text := template
    loop arg in args -> text = text.replace("{{{arg.name}}}", arg.value)
    text
}
