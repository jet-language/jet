//RS /// Check that the lock still describes each manifest dependency's declared
//RS /// source. This is intentionally stale-only: missing generated facts are
//RS /// returned by [`verify_all_manifest_deps_locked`] as a typed
//RS /// [`LockCompletenessError`].
//RS pub fn verify_lock_matches_manifest(
//RS     lock: &LockFile,
//RS     manifest: &Manifest,
//RS     _lock_path: &str,
//RS ) -> Result<(), Diagnostic> {
//RS     for (dep_name, spec) in &manifest.dependencies {
//RS         let Some(package) = lock.packages.iter().find(|package| &package.name == dep_name) else {
//RS             // The stronger typed verifier owns the distinction between a
//RS             // missing package record and a stale source identity.
//RS             continue;
//RS         };
//RS 
//RS         let source_matches = match (spec, &package.source) {
//RS             (DepSpec::Path { path }, LockSource::Path(locked_path)) => path == locked_path,
//RS             (
//RS                 DepSpec::Git { url, selector },
//RS                 LockSource::Git {
//RS                     url: locked_url,
//RS                     selector: locked_selector,
//RS                 },
//RS             ) => url == locked_url && git_selector_str(selector) == *locked_selector,
//RS             (DepSpec::Registry(_), LockSource::Registry { .. })
//RS             | (DepSpec::Foreign { .. }, LockSource::Foreign { .. }) => true,
//RS             _ => false,
//RS         };
//RS         if !source_matches {
//RS             return Err(e1202(Syntax::UNIFIED_LOCK_FILE));
//RS         }
//RS     }
//RS     Ok(())
//RS }
//RS 
//RS /// Stronger, bidirectional completeness check (D-SUPPLY1, Step 2): every
//RS /// manifest dependency must have the exact generated facts consumed by a
//RS /// locked/offline realization. Source-kind mismatches stay with the stale
//RS /// verifier above so callers can distinguish "regenerate the lock" from
//RS /// "update the lock for a changed manifest".
//RS pub fn verify_all_manifest_deps_locked(
//RS     manifest: &Manifest,
//RS     lock: &LockFile,
//RS ) -> Result<(), LockCompletenessError> {
//RS     validate_manifest_lock_completeness(manifest, lock)
//RS }
