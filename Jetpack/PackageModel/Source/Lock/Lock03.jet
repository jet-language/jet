//RS 
//RS // ──────────────────────────────────────────────
//RS // Fingerprint computation
//RS // ──────────────────────────────────────────────
//RS 
//RS /// Compute the plan fingerprint for a package.
//RS /// `tree_hash` is the sha256 hash of the source tree (from `SHA256::tree_hash`).
//RS /// `dep_fingerprints` is the sorted list of direct dep fingerprints.
//RS /// `cap_digest` (S2/D-MEM1, was c129) is the package's snapshotted public-fn
//RS /// surface (`Publish::ApiFreeze::project_capability_digest`); folding it in
//RS /// means a public signature change shifts the pin even when the source tree
//RS /// hash would otherwise match. Empty for a package with no snapshot yet (first
//RS /// publish) — the fingerprint is then unchanged from the tree+deps-only form.
//RS pub fn compute_fingerprint(tree_hash: &str, dep_fingerprints: &[&str], cap_digest: &str) -> String {
//RS     let mut data = tree_hash.as_bytes().to_vec();
//RS     data.push(0);
//RS     let mut sorted = dep_fingerprints.to_vec();
//RS     sorted.sort_unstable();
//RS     for fp in sorted {
//RS         data.extend_from_slice(fp.as_bytes());
//RS         data.push(0);
//RS     }
//RS     if !cap_digest.is_empty() {
//RS         data.extend_from_slice(b"cap:");
//RS         data.extend_from_slice(cap_digest.as_bytes());
//RS         data.push(0);
//RS     }
//RS     format!("sha256-{}", sha256_hex(&data))
//RS }
