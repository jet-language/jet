// D-CONF-STAMP1=B: the provenance carried by the build fact plane. `at` is
// lock history: it is empty until a lock-writing path supplies the first
// stamp and is never refreshed while a lock already has one.

// The toolchain identity a fresh stamp records: the Rust `BuildStamp`
// default (`CARGO_PKG_VERSION` of jet-foundation).
@PKG_BUILD_STAMP_TOOLCHAIN :: "0.1.0"

pub struct BuildStamp {
    pub git: ?String
    pub dirty: Bool
    pub toolchain: String
    pub at: String

    fn default() -> BuildStamp !Never {
        BuildStamp{git: None, dirty: false, toolchain: @PKG_BUILD_STAMP_TOOLCHAIN, at: ""}
    }
}

// Return the lock-pinned provenance, or capture one stamp for the
// lock-writing operation. A locked build may not fall back to the wall
// clock: a missing stamp is a stale lock input.
pub fn pkg_lock_build_stamp(project_root: String, locked: Bool) -[FS, Exec, Time, Time.Wait]> BuildStamp !LockError {
    if pkg_lock_load(project_root) == {
        .Val(lock) -> if lock.build_stamp == {
            .Val(stamp) -> return Ok(stamp)
            .None -> {}
        }
        .None -> {}
    }
    if locked -> return Err(LockError.Invalid("locked build has no `[build.stamp]` in `{files.join(project_root, @UNIFIED_LOCK_FILE)}`"))
    Ok(pkg_lock_capture_build_stamp(project_root))
}

// Pin provenance on every writer of the unified lock. Existing stamps are
// immutable; a new lock gets one capture at the write boundary.
pub fn pkg_lock_ensure_build_stamp(project_root: String, lock: &LockFile) -[Exec, Time, Time.Wait]> {
    if lock.build_stamp == None -> lock.build_stamp = Val(pkg_lock_capture_build_stamp(project_root))
}

fn pkg_lock_capture_build_stamp(project_root: String) -[Exec, Time, Time.Wait]> BuildStamp {
    stamp := BuildStamp.default()
    stamp.at = pkg_lock_timestamp_now()
    revision :: pkg_lock_git_output(project_root, [String]{"rev-parse", "HEAD"}) ?? return stamp
    status :: pkg_lock_git_output(project_root, [String]{"status", "--porcelain", "--untracked-files=all"}) ?? ""
    stamp.dirty = status != ""
    stamp.git = Val(if stamp.dirty -> "{revision}-dirty" else -> revision)
    stamp
}

// Trimmed stdout of `git -C <root> <args>` when it succeeds.
fn pkg_lock_git_output(project_root: String, args: [String]) -[Exec, Time.Wait]> ?String {
    argv := [String]{"git", "-C", project_root}
    loop arg in args -> argv.push(arg)
    spec :: process.cmd(argv).stdout(.Capture).stderr(.Capture)
    receipt :: process.run_spec(spec) ?? return None
    if !receipt.success -> return None
    Val(receipt.output.trim())
}

// The current UTC time as RFC 3339 with nanoseconds
// (`2026-08-20T20:41:14.841770348Z`).
fn pkg_lock_timestamp_now() -[Time]> String {
    now :: time.now()
    "{pkg_lock_pad(now.year, 4)}-{pkg_lock_pad(now.month, 2)}-{pkg_lock_pad(now.day, 2)}T{pkg_lock_pad(now.hour, 2)}:{pkg_lock_pad(now.minute, 2)}:{pkg_lock_pad(now.second, 2)}.{pkg_lock_pad(now.nano, 9)}Z"
}

// `value` in decimal, zero-padded to `width` digits.
fn pkg_lock_pad(value: Int, width: Int) -> String !Never {
    text := "{value}"
    loop text.bytes().len() < width -> text = "0{text}"
    text
}
