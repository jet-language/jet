// Unsupported versions carry LockError.UnsupportedVersion rather than re-decoding text.

// Rust: crates/jet-pkg-model/src/Lock.rs:2356
fn unsupported_lock_version(error: String) -> String? {
    rest :: error.strip_prefix("unsupported lock version ") ?? return None
    halves :: rest.split_once(";") ?? return None
    expected := halves.after.trim() // #4303
    version := halves.before.trim() // #4303
    if expected == "expected {PKG_LOCK_VERSION}" -> Val(version) else -> None
}

