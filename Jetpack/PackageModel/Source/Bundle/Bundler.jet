//RS //! Deterministic package bundle plans and layout artifacts.
//RS //!
//RS //! This module owns the data side of desktop and game packaging.  It does not
//RS //! invoke platform packers, signers, launchers, or update services.  A caller
//RS //! supplies an explicit target and executable bytes; the resulting plan is a
//RS //! complete, typed file layout that a later platform adapter may materialize.
//RS //!
//RS //! The same model is used for desktop and game packages.  `BundleKind` records
//RS //! that intent for receipts without creating a second game-specific bundler.
//RS 
//RS use crate::SHA256;
//RS use jet_foundation::Hex::nibble as hex_nibble;
//RS use jet_foundation::PerformanceBudget::CanonicalJson;
//RS use std::collections::BTreeSet;
//RS use std::fmt;
//RS use std::fmt::Write as _;
//RS 
