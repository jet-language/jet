// Ref migration and canonical identity: the one disk migration seam for
// retired selector positions and the retired public `nixpkgs` spelling, plus
// the channel-policy reading of a canonical ref.
//
// User input never calls the persisted migrator to accept a retired spelling;
// the classifiers compare its result with the input and report the canonical
// replacement instead.

// The canonical form of a ref read from a persisted manifest or lock.
pub struct MigratedRef {
    pub canonical: String
    pub policy: ChannelPolicy

    // Migrate one persisted ref from the retired selector positions.
    fn persisted(input: String) -> MigratedRef Never! {
        raw :: input.trim()
        prefix :: pkg_ref_legacy_policy_prefix(raw)
        unchanged :: MigratedRef{canonical: raw, policy: prefix.policy ?? ChannelPolicy.Pinned}
        halves :: prefix.rest.cut_last(@REF_PROVIDER_AT) ?? return unchanged
        if halves.before == "" || halves.after == "" -> return unchanged
        source :: pkg_ref_split_selector(halves.after)
        if !pkg_ref_valid_source_token(source.source) || source.empty_half -> return unchanged
        target :: pkg_ref_split_last_selector(halves.before)
        if target.empty_half -> return unchanged
        selector :: pkg_ref_first_selector(source.selector, target.selector, prefix.policy)
        canonical :: if ~selector == {
            .Val(value) -> if value != "" -> "{target.source}{@REF_PROVIDER_AT}{source.source}{@REF_CHANNEL_MARKER}{value}" else -> "{target.source}{@REF_PROVIDER_AT}{source.source}"
            .None -> "{target.source}{@REF_PROVIDER_AT}{source.source}"
        }
        policy :: if prefix.policy == {
            .Val(legacy) -> legacy
            .None -> {
                if selector == {
                    .Val(value) -> ChannelPolicy.for_selector(value) ?? ChannelPolicy.Pinned
                    .None -> ChannelPolicy.Pinned
                }
            }
        }
        MigratedRef{canonical: canonical, policy: policy}
    }

    // Migrate public package/source input without changing the persisted
    // spelling. `nixpkgs` is retained by `persisted` so locks and receipts can
    // show upstream provenance; public refs get the exact `@jetpack` spelling
    // instead, and classifiers use the difference to issue the teaching
    // diagnostic.
    fn public(raw: String) -> MigratedRef Never! {
        persisted :: MigratedRef.persisted(raw)
        canonical :: pkg_ref_rewrite_public_nixpkgs(persisted.canonical) ?? persisted.canonical
        MigratedRef{canonical: canonical, policy: persisted.policy}
    }
}

// A retired `#auto ` / `#latest ` policy prefix and the ref after it.
fn pkg_ref_legacy_policy_prefix(text: String) -> (policy: ChannelPolicy?, rest: String) Never! {
    auto_prefix :: "{@REF_CHANNEL_MARKER}{@REF_CHANNEL_AUTO}"
    if text.starts_with(auto_prefix) {
        rest :: text.removeprefix(auto_prefix)
        if pkg_ref_starts_with_whitespace(rest) -> return (policy: Val(ChannelPolicy.Automatic), rest: rest.trim_start())
    }
    latest_prefix :: "{@REF_CHANNEL_MARKER}{@REF_CHANNEL_LATEST}"
    if text.starts_with(latest_prefix) {
        rest :: text.removeprefix(latest_prefix)
        if pkg_ref_starts_with_whitespace(rest) -> return (policy: Val(ChannelPolicy.Manual), rest: rest.trim_start())
    }
    (policy: None, rest: text)
}

fn pkg_ref_starts_with_whitespace(text: String) -> Bool Never! {
    text != "" && text.trim_start() != text
}

// Split `package#selector` at the last `#`, mirroring `pkg_ref_split_selector`.
fn pkg_ref_split_last_selector(text: String) -> (source: String, selector: String?, empty_half: Bool) Never! {
    parts :: text.cut_last(@REF_CHANNEL_MARKER) ?? return (source: text, selector: None, empty_half: false)
    empty_half :: parts.before == "" || parts.after == ""
    (source: parts.before, selector: Val(parts.after), empty_half: empty_half)
}

// The selector a migrated ref keeps: the source-side selector, then the
// retired target-side selector, then the retired policy prefix.
fn pkg_ref_first_selector(source: String?, target: String?, legacy: ChannelPolicy?) -> String? Never! {
    if source != None -> return Val(source)
    if target != None -> return Val(target)
    policy :: legacy ?? return None
    if policy == {
        .Automatic -> Val(@REF_CHANNEL_AUTO)
        .Manual -> Val(@REF_CHANNEL_LATEST)
        .Pinned -> Val("")
    }
}

fn pkg_ref_valid_source_token(source: String) -> Bool Never! {
    if source == "" -> return false
    loop byte in source.bytes() {
        code :: Int.from_u8(byte)
        allowed :: (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 45 || code == 95 || code == 46
        if !allowed -> return false
    }
    true
}

// The user-facing error for a retired source spelling, without routing
// canonical input through the persisted-data migrator.
fn pkg_ref_noncanonical_input_error(raw: String) -> RefError? Never! {
    retired :: pkg_ref_retired_selector_replacement(raw)
    if pkg_ref_rewrite_public_nixpkgs(retired ?? raw) == {
        .Val(replacement) -> return Val(RefError.RetiredNixpkgs{raw: raw, replacement: replacement})
        .None -> {}
    }
    replacement :: retired ?? return None
    Val(RefError.NonCanonical{raw: raw, replacement: replacement})
}

// Rewrite only the deleted selector positions for a diagnostic. This is not a
// parser and is never used to classify or accept user input.
fn pkg_ref_retired_selector_replacement(input: String) -> String? Never! {
    prefix :: pkg_ref_legacy_policy_prefix(input.trim())
    halves :: prefix.rest.cut_last(@REF_PROVIDER_AT) ?? return None
    if halves.before == "" || halves.after == "" -> return None
    source :: pkg_ref_split_selector(halves.after)
    target :: pkg_ref_split_last_selector(halves.before)
    if target.selector == None && prefix.policy == None -> return None
    selector :: pkg_ref_first_selector(source.selector, target.selector, prefix.policy) ?? return None
    if target.source == "" || selector == "" -> return None
    Val("{target.source}{@REF_PROVIDER_AT}{source.source}{@REF_CHANNEL_MARKER}{selector}")
}

fn pkg_ref_rewrite_public_nixpkgs(raw: String) -> String? Never! {
    halves :: raw.cut_last(@REF_PROVIDER_AT) ?? return None
    if halves.before == "" || halves.after == "" -> return None
    source :: pkg_ref_split_selector(halves.after)
    if source.source != @REF_SOURCE_NIXPKGS -> return None
    if source.selector == {
        .Val(selector) -> {
            if selector == "" -> return None
            Val("{halves.before}{@REF_PROVIDER_AT}{@REF_SOURCE_JETPACK}{@REF_CHANNEL_MARKER}{selector}")
        }
        .None -> Val("{halves.before}{@REF_PROVIDER_AT}{@REF_SOURCE_JETPACK}")
    }
}

// Canonical ref used in lock and receipt identity. Public nixpkgs spelling
// remains classifiable during migration, but cannot create a second lock key.
pub fn pkg_canonical_locked_ref(raw: String) -> String Never! {
    canonical :: MigratedRef.persisted(raw).canonical
    halves :: canonical.cut_last(@REF_PROVIDER_AT) ?? return canonical
    source :: pkg_ref_split_selector(halves.after)
    if source.source != @REF_SOURCE_NIXPKGS && source.source != @REF_SOURCE_JETPACK -> return canonical
    suffix :: if source.selector == {
        .Val(selector) -> "{@REF_CHANNEL_MARKER}{selector}"
        .None -> ""
    }
    "{halves.before}{@REF_PROVIDER_AT}{@REF_SOURCE_JETPACK}{suffix}"
}

// The policy encoded in a canonical user ref. Retired prefix input is not
// accepted here and therefore returns the pinned default.
pub fn pkg_policy_for_ref(raw: String) -> ChannelPolicy Never! {
    source :: raw.trim().cut_last(@REF_PROVIDER_AT)?.after ?? return ChannelPolicy.Pinned
    selector :: source.cut_last(@REF_CHANNEL_MARKER)?.after ?? return ChannelPolicy.Pinned
    ChannelPolicy.for_selector(selector) ?? ChannelPolicy.Pinned
}

// Split an internal provider-first target at its last `#` when that selector
// is a channel. Exact selectors such as `#v1.2.3` are left untouched.
pub fn pkg_split_channel_ref(text: String) -> (base: String, channel: ChannelRef?) Never! {
    halves :: text.cut_last("#") ?? return (base: text, channel: None)
    if ChannelRef.parse_selector(halves.after) == {
        .Val(channel) -> (base: halves.before, channel: Val(channel))
        .None -> (base: text, channel: None)
    }
}
