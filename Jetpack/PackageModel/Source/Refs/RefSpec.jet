// Jetpack ref classifier: `name['@'source]['#'selector]` or `source.package`
//
// A ref reads like an address: the package, its source, then its version or
// channel. Bare `./`, `../`, and `/` paths need no provider word.
// Examples:
//   `fastfetch@jetpack`
//   `owner/my-fastfetch-jet-config@github`
//   `./my-env`
use jetpack_foundation.[
    REF_CHANNEL_AUTO, REF_CHANNEL_LATEST, REF_CHANNEL_MAIN, REF_CHANNEL_MARKER, REF_PROVIDER_AT,
    REF_SEPARATOR, REF_SOURCE_JETPACK, REF_SOURCE_NIXPKGS,
]

// Where a ref is resolved from. The built-in sources need no declaration;
// `Named` is a source declared in an `env.jet` that resolves to an
// upstream/pin through a `SourceTable`.
RefSource: enum {
    // The canonical Jetpack package catalog.
    Jetpack
    // The nixpkgs collection, retained as an internal migration alias; its
    // locked identity is canonicalized to `jetpack`.
    Nixpkgs
    // A GitHub repo holding an `env.jet` (or a translatable `flake.nix`).
    Github
    // A local directory holding a pack file or used as a flake fallback.
    Path
    // A package from the CRAN R package registry.
    Cran
    // A package from the LuaRocks registry.
    LuaRocks
    // A package from RubyGems.
    RubyGems
    // A distribution from CPAN.
    Cpan
    // A package from Packagist.
    Packagist
    // A package from Jet's first-party registry.
    JetRegistry
    // A package from npm.
    Npm
    // A package from Cargo.
    Cargo
    // A distribution from PyPI.
    PyPI
    // A package from Swift Package Manager.
    SwiftPM
    // A package from Maven.
    Maven
    // A package from NuGet.
    NuGet
    // A package from Conan.
    Conan
    // A port from vcpkg.
    Vcpkg
    // A formula or cask from Homebrew.
    Homebrew
    // A verified binary artifact named by URL and digest.
    Binary
    // A verified release artifact admitted directly by Jetpack (card #2166).
    Releases
    // A pack-declared named source, e.g. `stable` -> a pinned nixpkgs.
    Named(String)

    // The source token as written after the `@` in a ref: the provider row
    // that names this built-in source, or the declared name.
    label: fn(self) -> String Never! {
        if self == {
            .Named(name) -> return name
            .Jetpack | .Nixpkgs | .Github | .Path | .Cran | .LuaRocks | .RubyGems | .Cpan | .Packagist | .JetRegistry | .Npm | .Cargo | .PyPI | .SwiftPM | .Maven | .NuGet | .Conan | .Vcpkg | .Homebrew | .Binary | .Releases -> {}
        }
        loop row in PROVIDER_ROWS {
            if row.source == .Val(source) {
                if source == self -> return row.name
            }
        }
        panic("every built-in ref source has one provider row")
    }

    // Whether `name` is one of the built-in source keywords.
    is_builtin: fn(name: String) -> Bool Never! {
        RefSource.builtin(name) != None
    }

    // Resolve the source half of a `package@source` ref: a public built-in or
    // a declared named source. `path` and `nixpkgs` are internal source
    // words, so a ref naming either is malformed.
    resolve: fn(source: String, raw: String, table: SourceTable) -> RefSource RefError! {
        if RefSource.builtin(source) == {
            .Val(builtin) -> {
                if builtin == {
                    .Path | .Nixpkgs -> return Err(RefError.Malformed(raw))
                    .Jetpack | .Github | .Cran | .LuaRocks | .RubyGems | .Cpan | .Packagist | .JetRegistry | .Npm | .Cargo | .PyPI | .SwiftPM | .Maven | .NuGet | .Conan | .Vcpkg | .Homebrew | .Binary | .Releases | .Named(_) -> return Ok(builtin)
                }
            }
            .None -> {}
        }
        if table.upstream(source) != None -> return Ok(RefSource.Named(source))
        Err(RefError.UnknownSource{source: source, raw: raw, declared: table.declared_names()})
    }

    // The built-in source the provider row `name` declares.
    builtin: fn(name: String) -> RefSource? Never! {
        row: pkg_provider_row(name) ?? return None
        row.source
    }

    // The provider kind a direct `package@source` ref realizes through
    // without consulting a source table: the kind of this source's provider
    // row, unless that row realizes through the `nix` compatibility provider
    // or infers its kind from the target.
    direct_kind: fn(self) -> ProviderKind? Never! {
        loop row in PROVIDER_ROWS {
            if row.source == .Val(source) {
                if source == self {
                    kind: row.kind ?? return None
                    if kind == ProviderKind.Nix -> return None
                    return Val(kind)
                }
            }
        }
        None
    }
}

// Which backend realizes a source: the `nix` compatibility provider, the
// first-party `core` provider, or an explicit external provider boundary.
// Unknown named-source declarations default to `nix`, while direct external
// roots retain their concrete kind for fail-closed dispatch.
//
// `Infer` is the unresolved state of the typed surface (U9): a `…@github`
// source's kind depends on whether the remote repo carries a `package.jet`,
// which only a realize-time probe can answer. It never reaches a provider.
ProviderKind: enum {
    Nix
    Core
    Cran
    LuaRocks
    RubyGems
    Cpan
    Packagist
    JetRegistry
    Npm
    Cargo
    PyPI
    SwiftPM
    Maven
    NuGet
    Conan
    Vcpkg
    Homebrew
    Binary
    // A native Jetpack release-artifact recipe.
    JetPackage
    // Decide `Nix` vs `Core` at realize time by peeking the source's
    // `package.jet` (U9). Only the typed `…@github` surface produces this.
    Infer

    // The provider row's name; `Infer` has no row because it is resolved
    // before any listing or diagnostic.
    label: fn(self) -> String Never! {
        if self == ProviderKind.Infer -> return "infer"
        loop row in PROVIDER_ROWS {
            if row.kind == .Val(kind) {
                if kind == self -> return row.name
            }
        }
        panic("every provider kind but Infer has one provider row")
    }

    // The variant identity folded into the trust-gate hash (`trust_lines`).
    // These bytes are the persisted identity and must not change.
    identity: fn(self) -> String Never! {
        if self == {
            .Nix -> "Nix"
            .Core -> "Core"
            .Cran -> "Cran"
            .LuaRocks -> "LuaRocks"
            .RubyGems -> "RubyGems"
            .Cpan -> "Cpan"
            .Packagist -> "Packagist"
            .JetRegistry -> "JetRegistry"
            .Npm -> "Npm"
            .Cargo -> "Cargo"
            .PyPI -> "PyPI"
            .SwiftPM -> "SwiftPM"
            .Maven -> "Maven"
            .NuGet -> "NuGet"
            .Conan -> "Conan"
            .Vcpkg -> "Vcpkg"
            .Homebrew -> "Homebrew"
            .Binary -> "Binary"
            .JetPackage -> "JetPackage"
            .Infer -> "Infer"
        }
    }

    // Parse a provider name from a source declaration's third argument.
    // A provider row with a kind keeps that concrete kind; every other name
    // stays the default `nix` for named-source inference.
    parse: fn(name: String) -> ProviderKind Never! {
        row: pkg_provider_row(name) ?? return ProviderKind.Nix
        row.kind ?? ProviderKind.Nix
    }
}

// Federated provider families: the third view of the provider rows, beside
// RefSource and ProviderKind. Their contracts and first-party split are in
// Provider/Source/Federation/ProviderFamily.jet.
ProviderFamily: enum {
    Core
    Nix
    Path
    Github
    JetRegistry
    Npm
    PyPI
    Cargo
    SwiftPM
    Maven
    NuGet
    Conan
    Vcpkg
    Homebrew
    Binary
    Cran
    LuaRocks
    RubyGems
    Cpan
    Packagist
    JetPackage

    // The first provider row holding this family.
    label: fn(self) -> String Never! {
        loop row in PROVIDER_ROWS {
            if row.family == .Val(family) {
                if family == self -> return row.name
            }
        }
        panic("every provider family has a provider row")
    }

    // Every family once, in provider-row order.
    all: fn() -> [ProviderFamily] Never! {
        families := [ProviderFamily]{}
        loop row in PROVIDER_ROWS {
            family: row.family ?? next
            if !families.contains(family) -> families.push(family.copy())
        }
        families
    }
}

// Who is allowed to move a source pin.
ChannelPolicy: enum {
    // No channel marker: the declaration never moves.
    Pinned
    // Existing channel declarations move only through `jetpack update`.
    Manual
    // `#auto`: realization refreshes the channel and writes the exact pin back.
    Automatic

    as_str: fn(self) -> String Never! {
        if self == {
            .Pinned -> "pinned"
            .Manual -> "manual"
            .Automatic -> "automatic"
        }
    }

    moves: fn(self) -> Bool Never! {
        if self == {
            .Pinned -> false
            .Manual | .Automatic -> true
        }
    }

    // The policy a channel selector declares, or None for an exact selector.
    for_selector: fn(selector: String) -> ChannelPolicy? Never! {
        if selector == {
            REF_CHANNEL_AUTO -> Val(ChannelPolicy.Automatic)
            REF_CHANNEL_LATEST -> Val(ChannelPolicy.Manual)
            else -> if ChannelRef.parse_selector(selector) != None -> Val(ChannelPolicy.Manual) else -> None
        }
    }

    // A provider-first upstream moves manually when it ends in a channel.
    for_upstream: fn(upstream: String) -> ChannelPolicy Never! {
        if pkg_split_channel_ref(upstream).channel == None -> return ChannelPolicy.Pinned
        ChannelPolicy.Manual
    }
}

// One `(name, upstream, provider)` source declaration.
NamedSourceDecl: struct {
    name: String
    upstream: String
    via: ProviderKind
}

SourceTableEntry: struct {
    upstream: String
    via: ProviderKind
    policy: ChannelPolicy
    raw: String
}

// The named sources an `env.jet` declares name -> upstream/pin and
// the provider that realizes it. Built-in sources always resolve and are not
// stored here. Every listing is in name order.
SourceTable: struct {
    priv named: [String: SourceTableEntry]

    // A table with no declared sources: only the built-ins resolve. This is
    // the table for direct CLI refs (`jetpack use fastfetch@jetpack`).
    empty: fn() -> SourceTable Never! {
        SourceTable{named: [String: SourceTableEntry]{}}
    }

    // Build from declarations; a repeated name keeps its last declaration.
    from_decls: fn(decls: [NamedSourceDecl]) -> SourceTable Never! {
        table := SourceTable.empty()
        loop decl in decls {
            table.named[decl.name] = SourceTableEntry{upstream: decl.upstream, via: decl.via, policy: ChannelPolicy.for_upstream(decl.upstream), raw: decl.upstream}
        }
        table
    }

    // Add a declaration when a CLI surface supplies a built-in native catalog
    // entry alongside project declarations. An existing name is kept.
    ensure_decl: fn(&self, name: String, upstream: String, via: ProviderKind) Never! {
        if self.named.has_key(name) -> return
        self.named[name] = SourceTableEntry{upstream: upstream, via: via, policy: ChannelPolicy.for_upstream(upstream), raw: upstream}
    }

    // Set the authoring policy and raw source spelling for a declaration.
    set_channel_metadata: fn(&self, name: String, policy: ChannelPolicy, raw: String) Never! {
        if !self.named.has_key(name) -> return
        self.named[name].policy = policy
        self.named[name].raw = raw
    }

    // The upstream/pin a declared name resolves to, if any.
    upstream: fn(self, name: String) -> String? Never! {
        self.named.get(name)?.upstream
    }

    // The provider a declared name uses (`nix` when undeclared).
    provider: fn(self, name: String) -> ProviderKind Never! {
        self.named.get(name)?.via ?? ProviderKind.Nix
    }

    // The source's movement policy. Undeclared names are pinned.
    channel_policy: fn(self, name: String) -> ChannelPolicy Never! {
        self.named.get(name)?.policy ?? ChannelPolicy.Pinned
    }

    // The original source spelling used for manifest writeback.
    source_ref: fn(self, name: String) -> String? Never! {
        self.named.get(name)?.raw
    }

    // Declared names, sorted; used to make "unknown source" errors helpful.
    declared_names: fn(self) -> [String] Never! {
        names := self.named.keys().to_list()
        names.sort()
        names
    }

    // Declared source records, sorted by name.
    declarations: fn(self) -> [NamedSourceDecl] Never! {
        out := [NamedSourceDecl]{}
        loop name in self.declared_names() {
            entry: self.named[name]
            out.push(NamedSourceDecl{name: name, upstream: entry.upstream, via: entry.via})
        }
        out
    }

    // Replace one declared source's upstream after reading an exact lock entry.
    set_upstream: fn(&self, name: String, upstream: String) Never! {
        if !self.named.has_key(name) -> return
        self.named[name].upstream = upstream
    }

    // One `name=upstream@Provider` line per declared source, in name order.
    // U19: folded into the trust gate's env-definition hash, so re-pointing a
    // named source counts as a change and re-prompts.
    trust_lines: fn(self) -> [String] Never! {
        out := [String]{}
        loop decl in self.declarations() {
            out.push("{decl.name}={decl.upstream}@{decl.via.identity()}")
        }
        out
    }
}

// A classified ref. `package` is the target before the final `@`: an attr
// name for nixpkgs or an `owner/repo[/subpath]` for GitHub.
RefSpec: struct {
    source: RefSource
    package: String
    raw: String

    // A short, human display name for the package (last path segment).
    short_name: fn(self) -> String Never! {
        package: self.package.split_once(REF_CHANNEL_MARKER)?.before ?? self.package
        package.cut_last("/")?.after ?? package
    }

    // Classify a `name['#'selector]['@'source]` ref against built-in sources.
    // This is the strict path for direct CLI refs.
    classify: fn(raw: String) -> RefSpec RefError! {
        RefSpec.classify_in(raw, SourceTable.empty())
    }

    // Classify a ref, accepting built-in sources plus any named source declared
    // in `table`. Puts the package before `@`; a local
    // path is bare. A provider word before `@` is a teaching error only when
    // the suffix is not a source; a valid source suffix makes the left half a
    // package name.
    classify_in: fn(input: String, table: SourceTable) -> RefSpec RefError! {
        raw: input.trim()
        if pkg_is_bare_path(raw) && !raw.contains(REF_PROVIDER_AT) -> return Ok(RefSpec{source: RefSource.Path, package: raw, raw: raw})
        if raw.cut_last(REF_PROVIDER_AT) == {
            .Val(halves) -> {
                package: halves.before
                if halves.after == "" || package == "" -> return Err(RefError.EmptyHalf(raw))
                if !pkg_ref_valid_target(package) -> return Err(RefError.Malformed(raw))
                split: pkg_ref_split_selector(halves.after)
                if split.empty_half || !pkg_ref_valid_source(split.source) -> return Err(RefError.Malformed(raw))
                source: RefSource.resolve(split.source, raw, table)
                if split.selector == {
                    .Val(selector) -> return Ok(RefSpec{source: source, package: "{package}{REF_CHANNEL_MARKER}{selector}", raw: raw})
                    .None -> return Ok(RefSpec{source: source, package: package, raw: raw})
                }
            }
            .None -> {}
        }
        if raw.split_once(".") == {
            .Val(parts) -> {
                if parts.before != "" && parts.after != "" && table.upstream(parts.before) != None {
                    return Ok(RefSpec{source: RefSource.Named(parts.before), package: parts.after, raw: raw})
                }
            }
            .None -> {}
        }
        // A bare package is the Jetpack catalog spelling.
        // Workspace-aware callers probe their member index before reaching
        // this branch; a direct classifier has no workspace to consult.
        if raw != "" && !raw.contains("/") -> return RefSpec.classify_in(pkg_with_default_source(raw), table)
        Err(RefError.MissingSeparator(raw))
    }

    // Classify a ref with workspace-member awareness (Slice B).
    //
    // Resolution order, first match wins:
    //   1. source forms `package@source` and `source.package` (classify_in)
    //   2. local form `./package` (classify_in)
    //   3. path form `infra/logging`: exact relative-path match in the index
    //   4. bare form `logging`: exact member-name match in the index
    //
    // An explicit source suffix always wins over an accidental index
    // collision. Only a ref with no source suffix falls through to the index.
    // A path/bare ref that matches no member is `UnknownMember` (E1231); one
    // that matches more than one is `AmbiguousMember` (E1230).
    classify_with_workspace: fn(input: String, table: SourceTable, index: WorkspaceIndex) -> RefSpec RefError! {
        raw: input.trim()
        if !raw.contains(REF_PROVIDER_AT) && !pkg_is_bare_path(raw) && !index.is_empty() {
            // Preserve an explicitly declared `source.package` form before the
            // source-less workspace lookup. A bare package's Jetpack default is
            // deliberately deferred so an unknown member remains E1231.
            if RefSpec.classify_in(raw, table) == {
                .Ok(spec) -> {
                    if spec.source == {
                        .Jetpack -> {}
                        .Nixpkgs | .Github | .Path | .Cran | .LuaRocks | .RubyGems | .Cpan | .Packagist | .JetRegistry | .Npm | .Cargo | .PyPI | .SwiftPM | .Maven | .NuGet | .Conan | .Vcpkg | .Homebrew | .Binary | .Releases | .Named(_) -> return Ok(spec)
                    }
                }
                .Err(error) -> {
                    if error == {
                        .MissingSeparator(_) -> {}
                        .EmptyHalf(_) | .Malformed(_) | .UnknownSource(_, _, _) | .AmbiguousBare(_) | .AmbiguousMember(_, _) | .UnknownMember(_, _) -> return Err(error)
                    }
                }
            }
            return index.resolve(raw)
        }
        if RefSpec.classify_in(raw, table) == {
            .Ok(spec) -> return Ok(spec)
            // No source suffix. Consult the index only when a workspace exists:
            // outside a monorepo a path ref is still a missing-source error.
            .Err(error) -> {
                if error == {
                    .MissingSeparator(_) -> {}
                    .EmptyHalf(_) | .Malformed(_) | .UnknownSource(_, _, _) | .AmbiguousBare(_) | .AmbiguousMember(_, _) | .UnknownMember(_, _) -> return Err(error)
                }
                if index.is_empty() -> return Err(error)
            }
        }
        index.resolve(raw)
    }
}

// Why a ref string could not be classified. Each variant maps to a friendly
// diagnostic; the three shape failures share E1358, which lists the legal
// ref forms.
#Error
RefError: enum {
    // No `@` separator at all, e.g. `fastfetch`.
    MissingSeparator(String)
    // An empty source or package half, e.g. `@jetpack` or `fastfetch@`.
    EmptyHalf(String)
    // Neither a `package@source[#version]` ref nor a bare local path: a `#`
    // or whitespace before `@`, or an internal source word (`path`,
    // `nixpkgs`) after it.
    Malformed(String)
    // The source suffix is neither a built-in nor a declared named source.
    // `declared` lists the pack's named sources so the message can help.
    UnknownSource(source: String, raw: String, declared: [String])
    // Bare name with no source suffix, and no workspace member
    // matches, or the match was ambiguous.
    AmbiguousBare(String)
    // E1230: a bare or path-form ref matched more than one workspace member.
    // `candidates` are the members' relative paths.
    AmbiguousMember(query: String, candidates: [String])
    // E1231: a bare or path-form ref matched no workspace member.
    // `suggestions` are the closest member names/paths, for a did-you-mean.
    UnknownMember(query: String, suggestions: [String])

    // The registered diagnostic code for the errors that carry one.
    code: fn(self) -> String? Never! {
        if self == {
            .MissingSeparator(_) | .EmptyHalf(_) | .Malformed(_) -> Val("E1358")
            .AmbiguousMember(_, _) -> Val("E1230")
            .UnknownMember(_, _) -> Val("E1231")
            .UnknownSource(_, _, _) | .AmbiguousBare(_) -> None
        }
    }
}

// One workspace member: its name and normalized relative path.
WorkspaceMember: struct {
    name: String
    path: String
}

// A queryable index of the current workspace's members (Slice B), consulted
// by `RefSpec.classify_with_workspace` to resolve path-form (`infra/logging`)
// and bare-form (`logging`) addressing.
WorkspaceIndex: struct {
    // Members in workspace source order, paths normalized.
    priv members: [WorkspaceMember]

    // An index with no members: path refs remain unresolved, while bare
    // package refs fall through to the Jetpack catalog.
    empty: fn() -> WorkspaceIndex Never! {
        WorkspaceIndex{members: [WorkspaceMember]{}}
    }

    // Build from a workspace plan's members. Paths are normalized (leading
    // `./` and trailing `/` trimmed) so a query and a stored path compare
    // byte-for-byte regardless of how each was spelled.
    from_members: fn(members: [WorkspaceMember]) -> WorkspaceIndex Never! {
        normalized := [WorkspaceMember]{}
        loop member in members {
            normalized.push(WorkspaceMember{name: member.name, path: pkg_normalize_member_path(member.path)})
        }
        WorkspaceIndex{members: normalized}
    }

    // True when the index has no members (no workspace, or an empty one).
    is_empty: fn(self) -> Bool Never! {
        self.members.len() == 0
    }

    // Labels for did-you-mean suggestions in the same address space as the
    // query: bare names for bare refs, normalized paths for path refs.
    candidate_labels: fn(self, path_form: Bool) -> [String] Never! {
        out := [String]{}
        loop member in self.members {
            out.push(if path_form -> member.path else -> member.name)
        }
        out
    }

    // Member paths whose normalized path equals the path-form query.
    by_path: fn(self, query: String) -> [String] Never! {
        wanted: pkg_normalize_member_path(query)
        out := [String]{}
        loop member in self.members {
            if member.path == wanted -> out.push(member.path)
        }
        out
    }

    // Member paths whose name equals the bare-form query.
    by_name: fn(self, query: String) -> [String] Never! {
        out := [String]{}
        loop member in self.members {
            if member.name == query -> out.push(member.path)
        }
        out
    }

    // Resolve a source-less ref: `raw` with a `/` is path form, otherwise
    // bare form.
    resolve: fn(self, raw: String) -> RefSpec RefError! {
        query: raw.trim()
        path_form: query.contains("/")
        matches: if path_form -> self.by_path(query) else -> self.by_name(query)
        if matches.len() == {
            // A workspace member is a local package directory: it realizes
            // through the `path` source at its relative path.
            1 -> return Ok(RefSpec{source: RefSource.Path, package: matches[0], raw: query})
            0 -> return Err(RefError.UnknownMember{query: query, suggestions: pkg_ref_nearest(query, self.candidate_labels(path_form))})
            else -> return Err(RefError.AmbiguousMember{query: query, candidates: matches})
        }
    }
}

// Normalize a workspace member path: trim a leading `./` and any trailing `/`,
// and collapse `\` to `/` so Windows-spelled paths compare equal to POSIX ones.
pkg_normalize_member_path: fn(path: String) -> String Never! {
    out := path.trim().replace("\\", "/")
    if out.starts_with("./") -> out = out.removeprefix("./")
    loop out.ends_with("/") -> out = out.removesuffix("/")
    out
}

// True for bare local-path refs.
pkg_is_bare_path: fn(raw: String) -> Bool Never! {
    raw.starts_with("./") || raw.starts_with("../") || raw.starts_with("/")
}

// Attach the canonical built-in package source to a bare package ref.
// Workspace member/path refs stay untouched and are resolved by the caller's
// index.
pkg_with_default_source: fn(input: String) -> String Never! {
    raw: input.trim()
    if raw.contains(REF_PROVIDER_AT) || pkg_is_bare_path(raw) -> return raw
    if raw.split_once(REF_CHANNEL_MARKER) == {
        .Val(parts) -> {
            if parts.before != "" && parts.after != "" {
                return "{parts.before}{REF_PROVIDER_AT}{REF_SOURCE_JETPACK}{REF_CHANNEL_MARKER}{parts.after}"
            }
        }
        .None -> {}
    }
    "{raw}{REF_PROVIDER_AT}{REF_SOURCE_JETPACK}"
}

// Whether `target`, the half before `@`, is a package or upstream target: no
// whitespace or control byte and no `#`, since a version or channel follows
// the source.
pkg_ref_valid_target: fn(target: String) -> Bool Never! {
    if target.contains(REF_CHANNEL_MARKER) -> return false
    loop byte in target.bytes() {
        if (Int{byte}) <= 32 -> return false
    }
    true
}

// Whether `source`, the half after `@` and before `#`, is a source name:
// ASCII letters, digits, `-`, `_` and `.`. A path or `owner/repo` after `@`
// is a provider-first ref, not a source.
pkg_ref_valid_source: fn(source: String) -> Bool Never! {
    loop byte in source.bytes() {
        code: Int{byte}
        allowed: (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 45 || code == 95 || code == 46
        if !allowed -> return false
    }
    true
}

// Split `source#selector`. `empty_half` reports a present `#` with an empty
// side, which every ref classifier rejects.
pkg_ref_split_selector: fn(text: String) -> (source: String, selector: String?, empty_half: Bool) Never! {
    parts: text.split_once(REF_CHANNEL_MARKER) ?? return (empty_half: false, selector: None, source: text)
    empty_half: parts.before == "" || parts.after == ""
    (empty_half: empty_half, selector: Val(parts.after), source: parts.before)
}

// Up to three closest labels to `query` by edit distance, for a did-you-mean
// list. Ties order by label; the list is deterministic.
pkg_ref_nearest: fn(query: String, labels: [String]) -> [String] Never! {
    scored := [(distance: Int, label: String)]{}
    loop label in labels -> scored.push((distance: pkg_edit_distance(query, label), label: label))
    // Two stable passes order by (distance, label).
    scored.sort_by(fn(entry) { entry.label })
    scored.sort_by(fn(entry) { entry.distance })
    out := [String]{}
    query_len: query.bytes().len()
    loop entry in scored {
        if out.len() == 3 -> break
        label_len: entry.label.bytes().len()
        longest: if query_len > label_len -> query_len else -> label_len
        if entry.distance <= longest /% 2 + 1 -> out.push(entry.label)
    }
    out
}

// Classic Levenshtein distance over Unicode scalars.
pkg_edit_distance: fn(a: String, b: String) -> Int Never! {
    left := [String]{}
    loop scalar in a.chars() -> left.push("{scalar}")
    right := [String]{}
    loop scalar in b.chars() -> right.push("{scalar}")
    // One row of the classic DP; `diagonal` holds the previous row's value
    // one column to the left.
    row := [Int]{}
    loop j in 0..<(right.len() + 1) -> row.push(j)
    diagonal := 0
    loop i in 1..<(left.len() + 1) {
        diagonal = row[0].copy()
        row[0] = i
        loop j in 1..<(right.len() + 1) {
            above: row[j].copy()
            cost: if left[i - 1] == right[j - 1] -> 0 else -> 1
            deletion: above + 1
            insertion: row[j - 1] + 1
            substitution: diagonal + cost
            row[j] = if {
                deletion <= insertion && deletion <= substitution -> deletion
                insertion <= substitution -> insertion
                else -> substitution
            }
            diagonal = above
        }
    }
    row[right.len()]
}

// ── `target@provider` source refs (amends U6) ──
//
// The typed authoring surface (env.jet/package.jet `sources:`/`packages:`)
// writes source refs as `target@provider` — `owner/repo/rev@github`,
// `nixos-unstable@jetpack`. Local paths are bare (`./local`, `../local`, `/opt/local`).

// A source ref tracking intent, resolved only by update
// verbs and stored exact in `.jet/lock`.
ChannelRef: enum {
    Latest
    Main
    SemverMask(String)

    as_str: fn(self) -> String Never! {
        if self == {
            .Latest -> REF_CHANNEL_LATEST
            .Main -> REF_CHANNEL_MAIN
            .SemverMask(mask) -> mask
        }
    }

    parse_selector: fn(selector: String) -> ChannelRef? Never! {
        if selector == {
            REF_CHANNEL_LATEST -> Val(ChannelRef.Latest)
            REF_CHANNEL_MAIN -> Val(ChannelRef.Main)
            else -> {
                if !pkg_is_semver_mask(selector) -> return None
                Val(ChannelRef.SemverMask(selector))
            }
        }
    }
}

// `v<digits>.x`, e.g. `v0.x`.
pkg_is_semver_mask: fn(selector: String) -> Bool Never! {
    if !selector.starts_with("v") -> return false
    series: selector.removeprefix("v")
    if !series.ends_with(".x") -> return false
    digits: series.removesuffix(".x")
    if digits == "" -> return false
    loop byte in digits.bytes() {
        code: Int{byte}
        if code < 48 || code > 57 -> return false
    }
    true
}

// A classified `target@provider` source ref. `provider` is a built-in source
// (or path for a bare path); `target` is the upstream locator (a repo+rev, a
// local path, a channel/pin).
ProviderRef: struct {
    provider: RefSource
    target: String
    channel: ChannelRef?
    policy: ChannelPolicy
    raw: String

    // Reconstruct the provider-first upstream form without dropping a channel
    // selector. The source table uses this form for lock/update resolution,
    // so channel intent must survive the typed lowering pass.
    upstream: fn(self) -> String Never! {
        channel: if self.channel == {
            .Val(value) -> "{REF_CHANNEL_MARKER}{value.as_str()}"
            .None -> ""
        }
        "{self.provider.label()}{REF_SEPARATOR}{self.target}{channel}"
    }

    // Classify a `target@provider[#selector]` source ref or a bare local path.
    classify: fn(input: String) -> ProviderRef RefError! {
        raw: input.trim()
        if pkg_is_bare_path(raw) && !raw.contains(REF_PROVIDER_AT) {
            return Ok(ProviderRef{provider: RefSource.Path, target: raw, channel: None, policy: ChannelPolicy.Pinned, raw: raw})
        }
        halves: raw.cut_last(REF_PROVIDER_AT) ?? return Err(RefError.MissingSeparator(raw))
        if halves.after == "" || halves.before == "" -> return Err(RefError.EmptyHalf(raw))
        if !pkg_ref_valid_target(halves.before) -> return Err(RefError.Malformed(raw))
        split: pkg_ref_split_selector(halves.after)
        if split.empty_half || !pkg_ref_valid_source(split.source) -> return Err(RefError.Malformed(raw))
        provider: RefSource.builtin(split.source) ?? return Err(RefError.UnknownSource{source: split.source, raw: raw, declared: [String]{}})
        if provider == {
            .Path | .Nixpkgs -> return Err(RefError.Malformed(raw))
            .Jetpack | .Github | .Cran | .LuaRocks | .RubyGems | .Cpan | .Packagist | .JetRegistry | .Npm | .Cargo | .PyPI | .SwiftPM | .Maven | .NuGet | .Conan | .Vcpkg | .Homebrew | .Binary | .Releases | .Named(_) -> {}
        }
        tracked: ProviderRef.track(halves.before, split.selector)
        Ok(ProviderRef{provider: provider, target: tracked.target, channel: tracked.channel, policy: tracked.policy, raw: raw})
    }

    // Read a source selector: `#auto` and `#latest` track the latest release
    // (automatic vs manual movement), another channel selector moves manually,
    // and an exact selector stays part of the pinned target.
    track: fn(target: String, selector: String?) -> (target: String, channel: ChannelRef?, policy: ChannelPolicy) Never! {
        value: selector ?? return (channel: None, policy: ChannelPolicy.Pinned, target: target)
        if value == {
            REF_CHANNEL_AUTO -> (channel: Val(ChannelRef.Latest), policy: ChannelPolicy.Automatic, target: target)
            REF_CHANNEL_LATEST -> (channel: Val(ChannelRef.Latest), policy: ChannelPolicy.Manual, target: target)
            else -> {
                if ChannelRef.parse_selector(value) == {
                    .Val(channel) -> (channel: Val(channel), policy: ChannelPolicy.Manual, target: target)
                    .None -> (channel: None, policy: ChannelPolicy.Pinned, target: "{target}{REF_CHANNEL_MARKER}{value}")
                }
            }
        }
    }
}

// Canonical ref used in lock and receipt identity. The Nix compatibility
// provider records `@nixpkgs` provenance; it shares the `@jetpack` key so one
// package never gets a second lock entry.
pkg_canonical_locked_ref: fn(raw: String) -> String Never! {
    canonical: raw.trim()
    halves: canonical.cut_last(REF_PROVIDER_AT) ?? return canonical
    source: pkg_ref_split_selector(halves.after)
    if source.source != REF_SOURCE_NIXPKGS && source.source != REF_SOURCE_JETPACK -> return canonical
    suffix: if source.selector == {
        .Val(selector) -> "{REF_CHANNEL_MARKER}{selector}"
        .None -> ""
    }
    "{halves.before}{REF_PROVIDER_AT}{REF_SOURCE_JETPACK}{suffix}"
}

// The policy encoded in a canonical ref's source selector.
pkg_policy_for_ref: fn(raw: String) -> ChannelPolicy Never! {
    source: raw.trim().cut_last(REF_PROVIDER_AT)?.after ?? return ChannelPolicy.Pinned
    selector: source.cut_last(REF_CHANNEL_MARKER)?.after ?? return ChannelPolicy.Pinned
    ChannelPolicy.for_selector(selector) ?? ChannelPolicy.Pinned
}

// Split an internal provider-first target at its last `#` when that selector
// is a channel. Exact selectors such as `#v1.2.3` are left untouched.
pkg_split_channel_ref: fn(text: String) -> (base: String, channel: ChannelRef?) Never! {
    halves: text.cut_last("#") ?? return (base: text, channel: None)
    if ChannelRef.parse_selector(halves.after) == {
        .Val(channel) -> (base: halves.before, channel: Val(channel))
        .None -> (base: text, channel: None)
    }
}
