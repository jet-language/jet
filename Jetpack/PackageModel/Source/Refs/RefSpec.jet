//RS     MissingSeparator(String),
//RS     /// An empty source or package half, e.g. `@nixpkgs` or `fastfetch@`.
//RS     EmptyHalf(String),
//RS     /// A retired provider-first ref that must be flipped, never reinterpreted.
//RS     ProviderFirst { raw: String, replacement: String },
//RS     /// A package ref uses one of the retired selector positions.
//RS     NonCanonical { raw: String, replacement: String },
//RS     /// The public `nixpkgs` source spelling retired; use `jetpack` exactly.
//RS     RetiredNixpkgs { raw: String, replacement: String },
//RS     /// The `path` provider word retired; local paths are bare.
//RS     PathProviderRetired { raw: String, path: String },
//RS     /// The source suffix is neither a built-in nor a declared named source.
//RS     /// `declared` lists the pack's named sources so the message can help.
//RS     UnknownSource {
//RS         source: String,
//RS         raw: String,
//RS         declared: Vec<String>,
//RS     },
//RS     /// D-MONOREF1=A: bare name with no source suffix, and no workspace member
//RS     /// matches, or the match was ambiguous.
//RS     AmbiguousBare(String),
//RS     /// E1230 (D-MONOREF1=A): a bare or path-form ref matched more than one
//RS     /// workspace member. `candidates` are the members' relative paths, so the
//RS     /// message can point at the exact addresses to disambiguate.
//RS     AmbiguousMember {
//RS         query: String,
//RS         candidates: Vec<String>,
//RS     },
//RS     /// E1231 (D-MONOREF1=A): a bare or path-form ref matched no workspace
//RS     /// member. `suggestions` are the closest member names/paths, for a
//RS     /// did-you-mean.
//RS     UnknownMember {
//RS         query: String,
//RS         suggestions: Vec<String>,
//RS     },
//RS }
