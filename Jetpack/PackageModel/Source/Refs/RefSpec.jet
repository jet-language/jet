//RS pub enum ChannelPolicy {
//RS     /// No channel marker: the declaration never moves.
//RS     #[default]
//RS     Pinned,
//RS     /// Existing channel declarations move only through `jetpack update`.
//RS     Manual,
//RS     /// `#auto`: realization refreshes the channel and writes the exact pin back.
//RS     Automatic,
//RS }
