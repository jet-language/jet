//RS //! Jetpack ref classifier: `name['@'source]['#'selector]` or
//RS //! `source.package` (D-JPK-REF1=A, D-MONOREF1=A).
//RS //!
//RS //! A ref reads like an address: the package, its source, then its version or
//RS //! channel. Bare `./`, `../`, and `/` paths need no provider word.
//RS //! Examples:
//RS //!   `fastfetch@nixpkgs`
//RS //!   `halcyonomega/my-fastfetch-jet-config@github`
//RS //!   `./my-env`
//RS 
//RS use crate::Syntax;
//RS use std::collections::BTreeMap;
//RS 
//RS /// Where a ref is resolved from. The three built-in sources need no
//RS /// declaration; `Named` is a source declared in an `env.jet` (D-JPK17) that
//RS /// resolves to an upstream/pin via a `SourceTable`.
//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub enum Source {
//RS     /// The canonical Jetpack package catalog (D-JPK-SNIXREUSE1).
//RS     Jetpack,
//RS     /// The nixpkgs collection, realized through the Nix provider.
//RS     ///
//RS     /// Retained as an internal migration alias; its locked identity is
//RS     /// canonicalized to `jetpack`.
//RS     Nixpkgs,
//RS     /// A GitHub repo holding an `env.jet` (or a translatable `flake.nix`).
//RS     Github,
//RS     /// A local directory holding a pack file or used as a flake fallback.
//RS     Path,
//RS     /// A package from the CRAN R package registry (D-FFI-R1).
//RS     Cran,
//RS     /// A package from the LuaRocks registry (D-FFI-LUA1).
//RS     LuaRocks,
//RS     /// A package from RubyGems (D-FFI-RUBY1).
//RS     RubyGems,
//RS     /// A distribution from CPAN (D-FFI-PERL1).
//RS     Cpan,
//RS     /// A package from Packagist (D-FFI-PHP1).
//RS     Packagist,
//RS     /// A package from Jet's first-party registry (D-JPK-REGISTRY1).
//RS     JetRegistry,
//RS     /// A package from npm (D-JPK-PROVIDERS2).
//RS     Npm,
//RS     /// A package from Cargo (D-JPK-PROVIDERS2).
//RS     Cargo,
//RS     /// A distribution from PyPI (D-JPK-EXTPROV1).
//RS     PyPI,
//RS     /// A package from Swift Package Manager (D-JPK-EXTPROV1).
//RS     SwiftPM,
//RS     /// A verified release artifact admitted directly by Jetpack (card #2166).
//RS     Releases,
//RS     /// A pack-declared named source, e.g. `stable` → a pinned nixpkgs (D-JPK17).
//RS     Named(String),
//RS }
//RS 
