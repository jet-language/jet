//RS 
//RS /// Which backend realizes a source: the `nix` compatibility provider, the
//RS /// first-party `core` provider, or an explicit external provider boundary.
//RS /// Unknown named-source declarations still default to `nix` (R1 behavior),
//RS /// while direct external roots retain their concrete kind for fail-closed
//RS /// dispatch.
//RS ///
//RS /// `Infer` is a third, *unresolved* state used by the typed surface (U9): a
//RS /// `…@github` source's kind can't be known during pure `evaluate_env`
//RS /// evaluation — it depends on whether the remote repo carries a `package.jet`,
//RS /// which only a realize-time probe (with the offline flag + source cache) can
//RS /// answer. `Provider::resolve_kind` turns `Infer` into a concrete `Nix`/`Core`
//RS /// when realization runs; it never reaches a provider.
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
//RS pub enum ProviderKind {
//RS     #[default]
//RS     Nix,
//RS     Core,
//RS     Cran,
//RS     LuaRocks,
//RS     RubyGems,
//RS     Cpan,
//RS     Packagist,
//RS     JetRegistry,
//RS     Npm,
//RS     Cargo,
//RS     PyPI,
//RS     SwiftPM,
//RS     /// A native Jetpack release-artifact recipe.
//RS     JetPackage,
//RS     /// Decide `Nix` vs `Core` at realize time by peeking the source's
//RS     /// `package.jet` (U9). Only the typed `…@github` surface produces this.
//RS     Infer,
//RS }
//RS 
//RS impl ProviderKind {
//RS     /// Parse a provider name from a source declaration's third argument.
//RS     /// Recognized direct ecosystem roots retain their concrete kind; unknown
//RS     /// names remain the default `nix` for named-source inference.
//RS     pub fn parse(s: &str) -> ProviderKind {
//RS         match s {
//RS             "core" => ProviderKind::Core,
//RS             "cran" => ProviderKind::Cran,
//RS             "luarocks" => ProviderKind::LuaRocks,
//RS             "ruby" => ProviderKind::RubyGems,
//RS             "perl" => ProviderKind::Cpan,
//RS             "php" => ProviderKind::Packagist,
//RS             "jet-registry" => ProviderKind::JetRegistry,
//RS             "npm" => ProviderKind::Npm,
//RS             "cargo" => ProviderKind::Cargo,
//RS             "pypi" => ProviderKind::PyPI,
//RS             "swiftpm" => ProviderKind::SwiftPM,
//RS             "jetpackage" => ProviderKind::JetPackage,
//RS             _ => ProviderKind::Nix,
//RS         }
//RS     }
//RS 
//RS     pub fn label(self) -> &'static str {
//RS         match self {
//RS             ProviderKind::Nix => "nix",
//RS             ProviderKind::Core => "core",
//RS             ProviderKind::Cran => "cran",
//RS             ProviderKind::LuaRocks => "luarocks",
//RS             ProviderKind::RubyGems => "ruby",
//RS             ProviderKind::Cpan => "perl",
//RS             ProviderKind::Packagist => "php",
//RS             ProviderKind::JetRegistry => "jet-registry",
//RS             ProviderKind::Npm => "npm",
//RS             ProviderKind::Cargo => "cargo",
//RS             ProviderKind::PyPI => "pypi",
//RS             ProviderKind::SwiftPM => "swiftpm",
//RS             ProviderKind::JetPackage => "jetpackage",
//RS             // Never user-shown: resolved before any listing/diagnostic.
//RS             ProviderKind::Infer => "infer",
//RS         }
//RS     }
//RS }
