//RS /// Resolve a source-prefix-less ref against the workspace index. `raw` with a
//RS /// `/` is path form; otherwise bare form.
//RS fn resolve_in_index(raw: &str, index: &WorkspaceIndex) -> Result<RefSpec, RefError> {
//RS     let raw = raw.trim();
//RS     let query = raw;
//RS     let matches = if raw.contains('/') {
//RS         index.by_path(query)
//RS     } else {
//RS         index.by_name(query)
//RS     };
//RS     match matches.len() {
//RS         1 => Ok(RefSpec {
//RS             // A workspace member is a local package directory: it realizes
//RS             // through the `path` source at its relative path.
//RS             source: Source::Path,
//RS             package: matches[0].to_string(),
//RS             raw: raw.to_string(),
//RS         }),
//RS         0 => Err(RefError::UnknownMember {
//RS             query: raw.to_string(),
//RS             suggestions: nearest(
//RS                 query,
//RS                 &index.candidate_labels(query.contains('/')),
//RS             ),
//RS         }),
//RS         _ => Err(RefError::AmbiguousMember {
//RS             query: raw.to_string(),
//RS             candidates: matches.iter().map(|s| s.to_string()).collect(),
//RS         }),
//RS     }
//RS }
//RS 
//RS /// Up to three closest labels to `query` by a cheap prefix/substring/edit
//RS /// heuristic, for a did-you-mean list. Deterministic (stable sort).
//RS fn nearest(query: &str, labels: &[String]) -> Vec<String> {
//RS     let mut scored: Vec<(usize, &String)> = labels
//RS         .iter()
//RS         .map(|l| (edit_distance(query, l), l))
//RS         .collect();
//RS     scored.sort_by(|a, b| a.0.cmp(&b.0).then_with(|| a.1.cmp(b.1)));
//RS     scored
//RS         .into_iter()
//RS         .filter(|(d, l)| *d <= query.len().max(l.len()) / 2 + 1)
//RS         .take(3)
//RS         .map(|(_, l)| l.clone())
//RS         .collect()
//RS }
//RS 
//RS /// Classic Levenshtein distance (std-only, I6). Small inputs (ref names), so the
//RS /// simple two-row DP is more than fast enough.
//RS fn edit_distance(a: &str, b: &str) -> usize {
//RS     let a: Vec<char> = a.chars().collect();
//RS     let b: Vec<char> = b.chars().collect();
//RS     let mut prev: Vec<usize> = (0..=b.len()).collect();
//RS     let mut cur = vec![0usize; b.len() + 1];
//RS     for i in 1..=a.len() {
//RS         cur[0] = i;
//RS         for j in 1..=b.len() {
//RS             let cost = usize::from(a[i - 1] != b[j - 1]);
//RS             cur[j] = (prev[j] + 1).min(cur[j - 1] + 1).min(prev[j - 1] + cost);
//RS         }
//RS         std::mem::swap(&mut prev, &mut cur);
//RS     }
//RS     prev[b.len()]
//RS }
