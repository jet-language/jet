// Native C header -> Jet `#Bindgen` cache generator, ported from
// jet_pkg_model::CBind (E2-M14).
//
// The generator stays inside Jet: no bindgen, no libclang. The focused parser
// (HeaderParser.jet) binds scalar values, strings, uncounted object pointers,
// typed pointer/count slices, and complete C-layout records, while the
// opaque-handle seam (OpaqueHandleBinder.jet) records owned nominal types plus
// explicit close/thread/link facts. A declaration it cannot map is skipped and
// reported, never faked. Anything beyond this subset is an
// `#Import module c.<lib>` overlay, which still wins on merge.
//
// Output is a `#Bindgen module c.<lib>.__bindgen__` cache; each binding is
// `fn name(p: T, ...) -> R = "c_symbol"`.

// Why a C header could not produce a binding cache.
#Error
pub struct CBindError {
    pub message: String
}

// Result of translating a header: the cache source plus what was bound.
pub struct CBindResult {
    // The `#Bindgen module ...` cache file text.
    pub source: String
    // Function names successfully bound.
    pub bound: [String]
    // Prototypes skipped because a type is not bindable, with the reason.
    pub skipped: [(name: String, reason: String)]
    // Opaque typedefs that became owned nominal Jet handle facts.
    pub handles: [HandleFact]
    // Opaque typedefs withheld because ownership was not resolvable.
    pub handle_skipped: [(typedef_name: String, reason: String)]
    // Explicit primary plus transitive native libraries for this binding.
    pub link_closure: LinkClosure
    // Exact descriptor identity embedded in the generated cache.
    pub descriptor_stamp: String
    // The one boundary row consumed by binders, sema, inspect, and
    // comparison views; the foreign source stays authoritative.
    pub boundary: ForeignBoundaryContract
    // Caller-selected adaptation plans whose boundary digest matches.
    pub plans: [BindingPlan]
}

// The bind hash for a header + cflags pair (cache invalidation):
// SHA-256(header || NUL || cflags) as 64 lowercase hex digits. `cflags` is a
// space-joined flag list, `""` when there are none.
pub fn pkg_cbind_compute_bind_hash(header_src: String, cflags: String) -> String !Never {
    input := header_src.bytes()
    input.push(U8{0})
    loop byte in cflags.bytes() -> input.push(byte)
    pkg_sha256_hex(input)
}

// The sidecar path holding the hash next to a `<lib>.jet` cache: the cache
// path with its extension replaced by (or extended with) `hash`.
pub fn pkg_cbind_hash_sidecar_path(cache_path: String) -> String !Never {
    bytes :: cache_path.bytes()
    name_start := bytes.len()
    loop name_start > 0 && Int.from_u8(bytes[name_start - 1]) != 47 -> name_start -= 1
    dot := bytes.len() - 1
    loop dot > name_start && Int.from_u8(bytes[dot]) != 46 -> dot -= 1
    if dot > name_start && Int.from_u8(bytes[dot]) == 46 -> return "{pkg_bytes_text(bytes, 0, dot)}.hash"
    "{cache_path}.hash"
}

// The stored hash from the sidecar, or nothing when absent or unreadable.
pub fn pkg_cbind_read_stored_hash(cache_path: String) -[FS]> ?String {
    text :: files.read(pkg_cbind_hash_sidecar_path(cache_path)) ?? return None
    Val(text.trim())
}

// Write the hash sidecar next to `cache_path`.
pub fn pkg_cbind_write_bind_hash(cache_path: String, header_src: String, cflags: String) !IOError -[FS]> {
    files.write(pkg_cbind_hash_sidecar_path(cache_path), pkg_cbind_compute_bind_hash(header_src, cflags))
}

// Translate C header source into a `#Bindgen` cache for library `lib`. The
// only failure is structural (no bindable function at all), so the caller can
// surface E3208 instead of writing an empty cache.
pub fn pkg_cbind_generate(header_src: String, lib: String) -> CBindResult !CBindError {
    pkg_cbind_generate_with_descriptor(header_src, lib, pkg_cbind_c_descriptor())
}

// Generate with explicit opaque-handle overlay facts.
pub fn pkg_cbind_generate_with_overlay(header_src: String, lib: String, overlay: HandleOverlay) -> CBindResult !CBindError {
    pkg_cbind_generate_with_descriptor_and_overlay(header_src, lib, pkg_cbind_c_descriptor(), overlay)
}

// The overlay as generator options.
pub fn pkg_cbind_generate_with_options(header_src: String, lib: String, overlay: HandleOverlay) -> CBindResult !CBindError {
    pkg_cbind_generate_with_overlay(header_src, lib, overlay)
}

// Generate a C cache and append caller-selected, already-resolved facades.
// Plans are accepted only when their boundary digest matches this exact
// header/overlay generation.
pub fn pkg_cbind_generate_with_overlay_and_plans(header_src: String, lib: String, overlay: HandleOverlay, plans: [String: BindingPlan]) -> CBindResult !CBindError {
    result := pkg_cbind_generate_with_overlay(header_src, lib, overlay)
    pkg_cbind_attach_plans(&result, plans, "generated")
    Ok(result)
}

// Generate against a caller-supplied canonical boundary contract and carry
// the selected plans into the cache. The contract identity must still name
// this exact header/library generation.
pub fn pkg_cbind_generate_with_contract_and_plans(header_src: String, lib: String, overlay: HandleOverlay, contract: ForeignBoundaryContract, plans: [String: BindingPlan]) -> CBindResult !CBindError {
    result := pkg_cbind_generate_with_overlay(header_src, lib, overlay)
    if result.boundary.identity != contract.identity || result.boundary.library != contract.library {
        return Err(CBindError{message: "canonical foreign boundary contract is stale against the generated C source"})
    }
    previous_stamp :: result.boundary.stamp()
    result.source = result.source.replace(previous_stamp, contract.stamp())
    result.boundary = contract
    pkg_cbind_attach_plans(&result, plans, "canonical")
    Ok(result)
}

// Generate from an explicit descriptor: the production entry points supply
// the canonical C descriptor; descriptor mutation uses the same path.
pub fn pkg_cbind_generate_with_descriptor(header_src: String, lib: String, descriptor: BinderDescriptor) -> CBindResult !CBindError {
    pkg_cbind_generate_with_descriptor_and_overlay(header_src, lib, descriptor, HandleOverlay.empty())
}

// Descriptor-aware generation with explicit opaque-handle facts.
pub fn pkg_cbind_generate_with_descriptor_and_overlay(header_src: String, lib: String, descriptor: BinderDescriptor, overlay: HandleOverlay) -> CBindResult !CBindError {
    if pkg_cbind_overlay_contains_line_break(overlay) -> return Err(CBindError{message: "C binding overlay identities cannot contain line breaks"})
    contract :: descriptor.contract
    cleaned :: pkg_cbind_strip_comments_and_directives(header_src)
    discovery :: OpaqueHandleDiscovery.discover(cleaned, lib, overlay)
    catalog :: CTypeCatalog.parse(cleaned, discovery)
    bound := [String]{}
    skipped := [(name: String, reason: String)]{}
    lines := [String]{}
    used_names := [String]{}
    loop handle in discovery.handles {
        if !used_names.contains(handle.jet_name) -> used_names.push(handle.jet_name)
    }

    loop raw_decl in pkg_opaque_split_declarations(cleaned) {
        decl :: raw_decl.trim()
        if decl == "" -> next
        proto :: pkg_cbind_parse_prototype(decl) ?? next
        if pkg_cbind_render_binding(proto, &used_names, contract, discovery, catalog) == {
            .Ok(line) -> {
                bound.push(proto.name)
                lines.push("    {line}\n")
                if pkg_cbind_managed_callback_param_index(proto, catalog) != None {
                    lines.push("    fn {proto.name}(callback: fn(FfiCallbackEvent<I64>)) FfiCallbackRegistration = {pkg_cbind_quote(proto.name)}\n")
                }
                if proto.name == "unsubscribe" && pkg_cbind_native_void_pointer_proto(proto) {
                    lines.push("    fn unsubscribe(subscription: ^FfiCallbackRegistration) -> Task<!String> = \"__jet_ffi_callback_unsubscribe\"\n")
                }
                if proto.name == "emit_async" {
                    lines.push("    fn emit_async(value: I64) Task<I64 ! String> = \"__jet_ffi_emit_async\"\n")
                }
            }
            .Err(skip) -> skipped.push((name: proto.name, reason: skip.reason))
        }
    }

    if bound.len() == 0 {
        unresolved := [String]{}
        loop entry in discovery.unresolved -> unresolved.push("`{entry.typedef_name}`: {entry.reason}")
        suffix :: if unresolved.len() == 0 -> "" else -> "; opaque handle bindings were unresolved: {unresolved.join("; ")}"
        return Err(CBindError{message: "no bindable C function prototypes found for `{lib}`{suffix}"})
    }

    module_lib :: foundation_generated_snake_name(lib, "library")
    descriptor_stamp :: descriptor.stamp()
    boundary_identity :: ForeignBoundaryIdentity.new(
        "header:sha256-{pkg_sha256_hex(header_src.bytes())}",
        pkg_cbind_boundary_overlay_identity(overlay),
        "c-bind-source-v1;descriptor={descriptor_stamp}",
        "generated-c-bindgen",
        "jet-pkg-model:c-bind",
        pkg_bridge_foreign_host_target()
    )
    boundary := ForeignBoundaryContract.new(descriptor, lib, boundary_identity)
    if discovery.handles.len() == 0 {
        boundary.ownership = "signature-declared; no opaque handles"
        boundary.cleanup = "no generated close contract"
    } else {
        handle_names := [String]{}
        loop handle in discovery.handles -> handle_names.push(handle.jet_name)
        boundary.ownership = "owned opaque handles: {handle_names.join(",")}"
        boundary.cleanup = "overlay/conventional close symbol consumes each handle"
    }
    boundary.copy_cost = "scalar values copy by value; records retain declared C layout; handles never copy native state"
    assumptions := [String]{}
    loop entry in discovery.unresolved -> assumptions.push("{entry.typedef_name}: {entry.reason}")
    boundary.assumptions = assumptions
    boundary_stamp :: boundary.stamp()
    type_declarations :: "{discovery.render_type_declarations()}{catalog.render_type_declarations()}"
    source :: "// jet-ffi-descriptor={descriptor_stamp}\n// jet-ffi-boundary={boundary_stamp}\n{type_declarations}#Bindgen module c.{module_lib}.__bindgen__ {{\n{lines.join("")}}}\n"
    Ok(CBindResult{
        source: source,
        bound: bound,
        skipped: skipped,
        handles: discovery.handles,
        handle_skipped: discovery.unresolved,
        link_closure: LinkClosure.new(lib, overlay.links),
        descriptor_stamp: descriptor_stamp,
        boundary: boundary,
        plans: [BindingPlan]{}
    })
}

fn pkg_cbind_c_descriptor() -> BinderDescriptor !CBindError {
    descriptor :: pkg_binder_descriptor(ForeignLanguage.C) ?? return Err(CBindError{message: "C binder descriptor is not registered"})
    Ok(descriptor)
}

// Check each plan against its key and the result's boundary, then append the
// plans' facades in key order. `against` names the boundary in the refusal.
fn pkg_cbind_attach_plans(result: &CBindResult, plans: [String: BindingPlan], against: String) !CBindError {
    boundary_digest :: result.boundary.digest()
    names := plans.keys().to_list()
    names.sort()
    loop name in names {
        plan :: plans[name]
        if name != plan.operation.name -> return Err(CBindError{message: "adaptation plan key `{name}` names `{plan.operation.name}`"})
        if plan.boundary_digest != boundary_digest -> return Err(CBindError{message: "adaptation plan `{name}` is stale against the {against} C boundary"})
    }
    selected := [BindingPlan]{}
    loop name in names {
        plan :: plans[name]
        result.source = "{result.source}{plan.render_facade()}\n"
        selected.push(plan)
    }
    result.plans = selected
}

// The overlay's identity in the boundary row: its close map, thread-safety
// map, and sorted links, spelled as the Rust reference's debug rendering
// (`close={"k": "v"};thread-safety={"k": Safe};links=["a"]`).
fn pkg_cbind_boundary_overlay_identity(overlay: HandleOverlay) -> String !Never {
    close_keys := overlay.close_functions.keys().to_list()
    close_keys.sort()
    close := [String]{}
    loop key in close_keys -> close.push("{pkg_cbind_debug_quote(key)}: {pkg_cbind_debug_quote(overlay.close_functions[key])}")
    safety_keys := overlay.thread_safety.keys().to_list()
    safety_keys.sort()
    safety := [String]{}
    loop key in safety_keys {
        spelled :: if overlay.thread_safety[key] == {
            .Unspecified -> "Unspecified"
            .Safe -> "Safe"
            .Unsafe -> "Unsafe"
        }
        safety.push("{pkg_cbind_debug_quote(key)}: {spelled}")
    }
    links := overlay.links
    links.sort()
    quoted_links := [String]{}
    loop link in links -> quoted_links.push(pkg_cbind_debug_quote(link))
    "close={{{close.join(", ")}}};thread-safety={{{safety.join(", ")}}};links=[{quoted_links.join(", ")}]"
}

// A string in Rust debug spelling: quoted, with `"` and `\` escaped, tab,
// CR, LF and NUL as short escapes, and other control scalars as `\u{hex}`.
fn pkg_cbind_debug_quote(value: String) -> String !Never {
    out := [String]{"\""}
    raw :: value.bytes()
    index := 0
    loop index < raw.len() {
        code :: Int.from_u8(raw[index])
        // C1 controls U+0080..U+009F encode as 0xC2 0x80..0x9F.
        second :: pkg_bytes_code(raw, index + 1)
        if code == 0xC2 && second >= 0x80 && second <= 0x9F {
            out.push("\\u{{{pkg_cbind_lower_hex(second)}}}")
            index += 2
            next
        }
        width :: if {
            code >= 0xF0 -> 4
            code >= 0xE0 -> 3
            code >= 0x80 -> 2
            else -> 1
        }
        if code == {
            34 -> out.push("\\\"")
            92 -> out.push("\\\\")
            9 -> out.push("\\t")
            10 -> out.push("\\n")
            13 -> out.push("\\r")
            0 -> out.push("\\0")
            else -> {
                if code < 32 || code == 127 {
                    out.push("\\u{{{pkg_cbind_lower_hex(code)}}}")
                } else {
                    out.push(pkg_bytes_text(raw, index, index + width))
                }
            }
        }
        index += width
    }
    out.push("\"")
    out.join("")
}

fn pkg_cbind_lower_hex(value: Int) -> String !Never {
    digits :: "0123456789abcdef".bytes()
    if value == 0 -> return "0"
    out := ""
    rest := value
    loop rest > 0 {
        out = "{pkg_bytes_text(digits, rest % 16, rest % 16 + 1)}{out}"
        rest = rest / 16
    }
    out
}

fn pkg_cbind_overlay_contains_line_break(overlay: HandleOverlay) -> Bool !Never {
    loop entry in overlay.close_functions {
        if pkg_cbind_has_line_break(entry.key) || pkg_cbind_has_line_break(entry.value) -> return true
    }
    loop entry in overlay.thread_safety {
        if pkg_cbind_has_line_break(entry.key) -> return true
    }
    loop link in overlay.links {
        if pkg_cbind_has_line_break(link) -> return true
    }
    false
}

fn pkg_cbind_has_line_break(value: String) -> Bool !Never {
    loop byte in value.bytes() {
        if byte == (U8{10}) || byte == (U8{13}) -> return true
    }
    false
}
