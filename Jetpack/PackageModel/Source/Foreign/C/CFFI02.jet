// Rust: crates/jet-pkg-model/src/CFFI.rs:2548
fn load_binding_caches(bundle: &ProgramBundle, diags: &[Diagnostic], overlays: [String: HandleOverlay]) -[FS, Env, Exec, Time.Wait]> CBindingMetadata {
    libs := [String]{}
    headers := [String: String]{}
    seen := [String: Bool]{}
    loaded_paths := [String]{}
    loop module in bundle.modules {
        &loaded_paths.push(module.path.to_string_lossy())
        loop (_, import) in all_imports(module) {
            if c_module_imports(import) == {
                .Ok(c_imports) -> {
                    loop (lib, _) in c_imports {
                        if !seen.has_key(lib) {
                            seen[lib] = true
                            &libs.push(lib)
                        }
                    }
                }
                .Err(error) -> {
                    &diags.push(error.diagnostic())
                    next
                }
            }
            if c_header_lib(import) == .Val((header, lib)) {
                if !seen.has_key(lib) {
                    seen[lib] = true
                    &libs.push(lib)
                }
                if !headers.has_key(lib) -> headers[lib] = header
            }
        }
    }
    metadata := CBindingMetadata.empty()
    entry_path := String?{None}
    if bundle.modules.get(bundle.entry) == .Val(module) -> entry_path = Val(module.path.to_string_lossy())
    loop lib in libs {
        // All regeneration, frozen-plan, hash, metadata and immutable
        // provenance branches stay in the canonical preparation owner.
        // Prepare and parse per library to retain Rust diagnostic order.
        // GATE #4494: native fs/process/clock primitives of cache preparation.
        preparation :: pkg_cffi_prepare_binding_caches(bundle.project_root.to_string_lossy(), [CBindingImport]{CBindingImport{lib: lib, header: headers.get(lib)}}, loaded_paths, entry_path, overlays)
        loop diagnostic in preparation.diagnostics -> &diags.push(diagnostic)
        loop load in preparation.loads -> load_cache_source(load.source, OSPath.from(load.path), load.lib, &diags, &bundle.modules)
        loop fact in preparation.metadata.handle_facts -> &metadata.add_handle(fact)
        &metadata.add_closure(preparation.metadata.link_closure)
    }
    metadata
}

