// Rust: crates/jet-pkg-model/src/CFFI.rs:1826
fn map_diagnostics(bundle: ProgramBundle, origins: AssemblyOrigins, diagnostics: [Diagnostic]) -[FS]> [CffiDiagnostic] {
    origins := origins
    cache_origins :: cache_diagnostic_origins(bundle)
    used := [Bool]{}
    loop _ in cache_origins -> &used.push(false)
    next_duplicate_use := 0
    next_invalid_bindgen := 0
    next_incompatible_override := 0
    next_header_origin := 0
    fallback_file :: bundle.project_root.display().to_string()
    out := [CffiDiagnostic]{}
    loop diagnostic in diagnostics {
        origin := (String, String)?{None}
        loop (index, candidate) in cache_origins.iter().enumerate() {
            if !used[index] && same_diagnostic(diagnostic, candidate.diagnostic) {
                used[index] = true
                origin = Val((candidate.file, candidate.source))
                break
            }
        }
        if origin == None {
            origin = if diagnostic.code == {
                "E3204" -> take_origin(origins.duplicate_uses, &next_duplicate_use)
                "E3205" -> take_origin(origins.incompatible_overrides, &next_incompatible_override)
                "E3207" -> take_origin(origins.invalid_bindgen, &next_invalid_bindgen)
                else -> None
            }
        }
        if origin == None {
            if diagnostic.span == .Val(span) {
                if origins.spans.get(span) == .Val(candidates) {
                    if !candidates.is_empty() {
                        candidates := candidates
                        origin = Val(&candidates.remove(0))
                        origins.spans[span] = candidates
                    }
                }
            }
        }
        if origin == None && diagnostic.code == "E3208" -> origin = take_origin(origins.headers, &next_header_origin)
        (file, source) :: origin ?? (fallback_file, "")
        &out.push(CffiDiagnostic{file: file, source: source, diagnostic: diagnostic})
    }
    out
}

// Rust: crates/jet-pkg-model/src/CFFI.rs:1884
fn take_origin(origins: [(String, String)], next: &Int) -> (String, String)? {
    origin :: origins.get(next)
    if origin != None -> next += 1
    origin
}

// Rust: crates/jet-pkg-model/src/CFFI.rs:1892
fn assembly_origins(bundle: ProgramBundle) -> AssemblyOrigins {
    origins := AssemblyOrigins{spans: [Span: [(String, String)]]{}, headers: [], duplicate_uses: [], invalid_bindgen: [], incompatible_overrides: []}
    surfaces := [String: OriginSurface]{}
    order := [String]{}
    library_order := [String]{}
    library_seen := [String: Bool]{}
    header_origins_by_lib := [String: (String, String)]{}
    loop module in bundle.modules {
        origin :: (module.display, module.source)
        generated :: pkg_cffi_generated_cache_language(module.path.to_string_lossy()) != None
        seen := [(String?, String): (Bool, String)]{}
        loop (scope, import) in all_imports(module) {
            spans := origins.spans.get(import.span) ?? []
            &spans.push(origin)
            origins.spans[import.span] = spans
            alias_spans := origins.spans.get(import.alias_span) ?? []
            &alias_spans.push(origin)
            origins.spans[import.alias_span] = alias_spans
            c_imports :: c_module_imports(import) ?? next
            uses := [(String, Bool, String)]{}
            loop (lib, _) in c_imports -> &uses.push((lib, false, ""))
            if c_header_lib(import) == .Val((header, lib)) -> &uses.push((lib, true, header))
            loop (lib, is_header, header) in uses {
                key :: (scope, lib)
                if !library_seen.has_key(lib) {
                    library_seen[lib] = true
                    &library_order.push(lib)
                }
                if seen.get(key) == {
                    .Val((previous_is_header, _)) -> {
                        if previous_is_header != is_header -> &origins.duplicate_uses.push(origin)
                    }
                    .None -> seen[key] = (is_header, header)
                }
                if is_header && !header_origins_by_lib.has_key(lib) -> header_origins_by_lib[lib] = origin
            }
        }
        loop item in module.items {
            if item != .CModule(c_module) -> next
            if c_module.kind == CModuleKind.Bindgen && !generated {
                &origins.invalid_bindgen.push(origin)
                next
            }
            if !surfaces.has_key(c_module.lib) {
                &order.push(c_module.lib)
                surfaces[c_module.lib] = OriginSurface{bindgen: [], overlay: []}
            }
            surface := surfaces[c_module.lib]
            loop function in c_module.functions {
                if c_module.kind == CModuleKind.Bindgen -> &surface.bindgen.push((function, origin))
                else -> &surface.overlay.push((function, origin))
            }
            surfaces[c_module.lib] = surface
            spans := [Span]{c_module.span, c_module.path_span}
            loop function in c_module.functions {
                &spans.push(function.span)
                &spans.push(function.name_span)
                &spans.push(function.rust_path_span)
                loop (_, span) in function.abi -> &spans.push(span)
            }
            loop span in spans {
                candidates := origins.spans.get(span) ?? []
                &candidates.push(origin)
                origins.spans[span] = candidates
            }
        }
    }
    loop lib in library_order {
        if header_origins_by_lib.remove(lib) == .Val(origin) -> &origins.headers.push(origin)
    }
    loop lib in order {
        surface :: surfaces.get(lib) ?? next
        merged := [String: ExternFn]{}
        loop (function, _) in surface.bindgen -> merged[function.name] = function
        loop (function, origin) in surface.overlay {
            if merged.get(function.name) == .Val(previous) {
                if !jet_driver_foreign_same_signature(previous, function) {
                    &origins.incompatible_overrides.push(origin)
                    next
                }
            }
            merged[function.name] = function
        }
    }
    origins
}

// Rust: crates/jet-pkg-model/src/CFFI.rs:2038
fn cache_diagnostic_origins(bundle: ProgramBundle) -[FS]> [CffiDiagnostic] {
    libs := [String]{}
    seen := [String: Bool]{}
    loop module in bundle.modules {
        loop (_, import) in all_imports(module) {
            c_imports :: c_module_imports(import) ?? next
            loop (lib, _) in c_imports {
                if !seen.has_key(lib) {
                    seen[lib] = true
                    &libs.push(lib)
                }
            }
            if c_header_lib(import) == .Val((_, lib)) {
                if !seen.has_key(lib) {
                    seen[lib] = true
                    &libs.push(lib)
                }
            }
        }
    }
    out := [CffiDiagnostic]{}
    loop lib in libs {
        path :: OSPath.from(pkg_cffi_binding_cache_file(bundle.project_root.to_string_lossy(), ForeignLanguage.C, lib))
        // GATE #4494: native filesystem read; never a Rust callback.
        source :: fs.read_to_string(path) ?? next
        (tokens, lex_diags) :: Lexer.lex_generated(source)
        diagnostics := lex_diags
        if diagnostics.is_empty() {
            if Parser.parse(tokens) == {
                .Ok(_) -> {}
                .Err(parse_diags) -> diagnostics = parse_diags
            }
        }
        loop diagnostic in diagnostics -> &out.push(CffiDiagnostic{file: path.display().to_string(), source: source, diagnostic: diagnostic})
    }
    out
}

// Rust: crates/jet-pkg-model/src/CFFI.rs:2086
fn same_diagnostic(left: Diagnostic, right: Diagnostic) -> Bool {
    left.code == right.code && left.what == right.what && left.why == right.why && left.fix == right.fix && left.span == right.span
}

// Rust: crates/jet-pkg-model/src/CFFI.rs:2094
fn duplicate_use_form_diagnostics(bundle: ProgramBundle) -> [Diagnostic] {
    diagnostics := [Diagnostic]{}
    reported := [(Int, Span, String): Bool]{}
    loop (module_idx, module) in bundle.modules.iter().enumerate() {
        seen := [(String?, String): (Bool, String)]{}
        loop (scope, import) in all_imports(module) {
            uses := [(String, Bool, String)]{}
            loop (lib, _) in c_module_imports_after_preflight(import) -> &uses.push((lib, false, ""))
            if c_header_lib(import) == .Val((header, lib)) -> &uses.push((lib, true, header))
            loop (lib, is_header, header) in uses {
                key :: (scope, lib)
                if seen.get(key) == {
                    .Val((previous_is_header, previous_header)) -> {
                        report_key :: (module_idx, import.span, lib)
                        if previous_is_header != is_header && !reported.has_key(report_key) {
                            reported[report_key] = true
                            selected_header :: if is_header -> header else -> previous_header
                            &diagnostics.push(pkg_cffi_e3204(lib, selected_header, import.span))
                        }
                    }
                    .None -> seen[key] = (is_header, header)
                }
            }
        }
    }
    diagnostics
}

