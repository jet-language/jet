// Rust: crates/jet-pkg-model/src/CFFI.rs:3297
fn load_cache_source(source: String, path: OSPath, lib: String, diags: &[Diagnostic], modules: &[LoadedModule]) -> () {
    if pkg_cffi_check_cache_descriptor(source, path.to_string_lossy(), lib) == .Val(diagnostic) {
        &diags.push(diagnostic)
        return
    }
    (tokens, lex_diags) :: Lexer.lex_generated(source)
    if !lex_diags.is_empty() {
        loop diagnostic in lex_diags -> &diags.push(diagnostic)
        return
    }
    program :: if Parser.parse(tokens) == {
        .Ok(program) -> program
        .Err(diagnostics) -> {
            loop diagnostic in diagnostics -> &diags.push(diagnostic)
            return
        }
    }
    &modules.push(LoadedModule{
        path: path, display: path.display().to_string(), source: source,
        alias: "__c_cache_{lib}", imports: ^program.imports, items: ^program.items,
        script_body: ^program.script_body, block_spans: ^program.block_spans,
        web_target_ceiling: program.web_target_ceiling, pub_file: program.pub_file,
        no_prelude: program.no_prelude, default_target: program.default_target,
        html_path: program.html_path, policy_declarations: program.policy_declarations,
        user_policy_declarations: program.user_policy_declarations, rule_facts: ^program.rule_facts
    })
}

