// Preparation of generated C binding caches for a program's C imports,
// ported from jet_pkg_model::CFFI (D-CBIND2 automatic half).
//
// For every C library a program brings in (`use c.<lib>` / `use "<lib>.h"`),
// this stage generates or refreshes the binding cache under
// `.jet/bindings/c/<lib>.jet`, writes its typed metadata and provenance
// sidecars, and selects the adaptation facade: the frozen one recorded by
// `jet bind` under `.jet/lock/bindings/<lib>.plan`, or the canonical
// automatic facade derived from the current header evidence. The loader
// then parses the returned cache and facade sources; the in-memory merge of
// overlays and generated surfaces into synthetic C modules is the compiler
// loader's (`Compiler/JetDriver/Source/Driver/ForeignProviders.jet`).

// One C library a program brings in, with its header for the header form.
pub struct CBindingImport {
    pub lib: String
    pub header: String?
}

// One generated source the loader must parse.
pub struct CBindingLoad {
    pub path: String
    pub lib: String
    pub source: String
}

// The prepared caches, their collected metadata, and any refusals.
pub struct CBindingPreparation {
    pub loads: [CBindingLoad]
    pub metadata: CBindingMetadata
    pub diagnostics: [Diagnostic]
}

// Admit close contracts written in a source `#Import` overlay to the typed
// binder seam before a header is generated. Caller-supplied facts stay
// authoritative; source markers only fill missing close mappings.
pub fn pkg_cffi_admit_source_handle_overlays(program: RustBridgeProgram, supplied: [String: HandleOverlay]) -> [String: HandleOverlay] Never! {
    admitted := supplied
    loop program_module in program.modules {
        items :: program_module.items
        loop item in items {
            if item == {
                .CModule(c_module) -> {
                    if c_module.kind != CModuleKind.Extern -> next
                    overlay := admitted.get(c_module.lib) ?? HandleOverlay.empty()
                    functions :: c_module.functions
                    loop function in functions {
                        close :: function.close ?? next
                        returned :: function.return_type ?? next
                        handle :: pkg_ffi_named(returned) ?? next
                        if !overlay.close_functions.has_key(handle) -> overlay.close_functions[handle] = close.name
                    }
                    admitted[c_module.lib] = overlay
                }
                else -> {}
            }
        }
    }
    admitted
}

// The first `<marker>: value` in `source`, unquoted.
fn pkg_cffi_marker_value(source: String, marker: String) -> String? Never! {
    loop line in pkg_bridge_text_lines(source) {
        parts :: line.split_once(marker) ?? next
        value := parts.after.trim()
        value = value.removeprefix(":").trim()
        if value == "" -> next
        loop value.starts_with("\"") -> value = value.removeprefix("\"")
        loop value.ends_with("\"") -> value = value.removesuffix("\"")
        return Val(value)
    }
    None
}

// The Jet result type spelling of a C declaration's return type.
fn pkg_cffi_automatic_result_type(prefix: String) -> String Never! {
    if prefix.contains("char") && prefix.contains("*") -> return "String"
    tokens :: pkg_cffi_whitespace_tokens(prefix)
    if tokens.len() == 0 -> return "Unit"
    value :: tokens[tokens.len() - 1].replace("const ", "")
    if value == {
        "void" -> "Unit"
        "uint64_t" | "size_t" -> "U64"
        "int" | "int32_t" -> "Int"
        "float" | "double" -> "Float"
        else -> value
    }
}

fn pkg_cffi_last_token(parameter: String) -> String? Never! {
    tokens :: pkg_cffi_whitespace_tokens(parameter)
    if tokens.len() == 0 -> return None
    Val(tokens[tokens.len() - 1])
}

fn pkg_cffi_count_parameter(parameter: String) -> Bool Never! {
    if parameter.contains("*") -> return false
    lower :: pkg_ascii_lower(parameter)
    lower.contains("count") || lower.contains("length") || lower.contains("len") || lower == "n" || lower.ends_with(" n")
}

// The pointer/count fact the header's `jet-ffi-*` markers declare for one
// `(pointer, count)` parameter pair.
fn pkg_cffi_marked_pointer_count(source: String, pointer: String, count: String) -> PointerCountFact Never! {
    unit_marker :: pkg_cffi_marker_value(source, "jet-ffi-count-unit") ?? ""
    unit :: if {
        unit_marker == "bytes" -> CountUnit.Bytes
        unit_marker.starts_with("elements:") -> CountUnit.Elements(unit_marker.removeprefix("elements:"))
        else -> CountUnit.Unknown
    }
    meaning_marker :: pkg_cffi_marker_value(source, "jet-ffi-count-meaning") ?? ""
    meaning :: if meaning_marker == {
        "full-extent" -> CountMeaning.FullExtent
        "prefix" -> CountMeaning.Prefix
        else -> CountMeaning.Unknown
    }
    width_text :: pkg_cffi_marker_value(source, "jet-ffi-count-width") ?? ""
    parsed :: Int.parse(width_text) ?? 0
    width :: if parsed >= 0 && parsed <= 65535 -> parsed else -> 0
    retention_marker :: pkg_cffi_marker_value(source, "jet-ffi-retention") ?? ""
    retention :: if retention_marker == {
        "borrowed-for-call" -> PointerRetention.BorrowedForCall
        "may-retain" -> PointerRetention.MayRetain
        else -> PointerRetention.Unknown
    }
    PointerCountFact.new(pointer, count, unit, meaning, width, retention)
}

// The binding operation the header evidence declares for one bound C
// function: its prototype, result type, pointer/count pair, and the
// `jet-ffi-*` adaptation markers.
fn pkg_cffi_automatic_operation(name: String, source: String) -> BindingOperation Never! {
    call :: "{name}("
    declaration := ""
    loop raw in pkg_bridge_text_lines(source) {
        line :: raw.trim()
        if line.contains(call) {
            declaration = line
            break
        }
    }
    native_signature := declaration
    loop native_signature.ends_with(";") -> native_signature = native_signature.removesuffix(";")
    result_type := "Unit"
    if declaration.split_once(call) == .Val(parts) -> result_type = pkg_cffi_automatic_result_type(parts.before)
    operation := BindingOperation.new(name, native_signature, result_type)
    if declaration.split_once(call) == .Val(parts) {
        if parts.after.split_once(")") == .Val(closing) {
            parameters := [String]{}
            loop parameter in closing.before.split(",") -> &parameters.push(parameter.trim())
            pointer := None
            count := None
            loop parameter in parameters {
                if pointer == None && parameter.contains("*") {
                    if pkg_cffi_last_token(parameter) == .Val(token) {
                        bare := token
                        loop bare.starts_with("*") -> bare = bare.removeprefix("*")
                        pointer = Val(bare)
                    }
                }
                if count == None && pkg_cffi_count_parameter(parameter) -> count = pkg_cffi_last_token(parameter)
            }
            if pointer == .Val(pointer_name) {
                if count == .Val(count_name) -> operation = operation.with_pointer_count(pkg_cffi_marked_pointer_count(source, pointer_name, count_name))
            }
        }
    }
    operation.nullable_return = source.contains("jet-ffi-nullable")
    operation.borrowed_view = source.contains("jet-ffi-borrowed-view")
    operation.status_out = source.contains("jet-ffi-status-out")
    operation.partial_success = source.contains("jet-ffi-partial-success")
    operation.fallible_close = source.contains("jet-ffi-fallible-close")
    operation.callback_transport = pkg_cffi_marker_value(source, "jet-ffi-callback") ?? "none"
    operation.effects = pkg_cffi_marker_value(source, "jet-ffi-effects") ?? "foreign"
    operation.ownership = pkg_cffi_marker_value(source, "jet-ffi-ownership") ?? "signature-declared"
    operation.failure_mapping = pkg_cffi_marker_value(source, "jet-ffi-failure") ?? "preserve"
    operation.copies = pkg_cffi_marker_value(source, "jet-ffi-copies") ?? "none"
    operation.placement = pkg_cffi_marker_value(source, "jet-ffi-placement") ?? "caller"
    operation.cleanup = pkg_cffi_marker_value(source, "jet-ffi-cleanup") ?? "none"
    operation
}

// One `jet-ffi-obligation: name=…; basis=…; checker=…; assumptions=a|b`
// marker recorded against the contract's header coverage.
fn pkg_cffi_record_obligation_marker(contract: &ForeignBoundaryContract, line: String) ForeignBridgeError! {
    obligation := None
    basis := FfiEvidenceBasis.Unknown
    checker := ""
    assumptions := [String]{}
    loop field in line.split(";") {
        parts :: field.split_once("=") ?? next
        value :: parts.after.trim()
        if parts.before.trim() == {
            "name" | "obligation" -> {
                obligation = Val(value)
            }
            "basis" -> {
                basis = FfiEvidenceBasis.parse(value) ?? return Err(pkg_bridge_error("unknown evidence basis `{value}`"))
            }
            "checker" -> {
                checker = value
            }
            "assumptions" -> {
                assumptions = [String]{}
                loop item in value.split("|") {
                    trimmed :: item.trim()
                    if trimmed != "" -> &assumptions.push(trimmed)
                }
            }
            else -> {}
        }
    }
    name :: obligation ?? return Err(pkg_bridge_error("an obligation marker needs `name=`"))
    &contract.set_obligation(name, basis, checker, assumptions)
}

// The binder's boundary with header coverage and the header's declared
// obligation evidence.
fn pkg_cffi_annotated_contract(contract: ForeignBoundaryContract, source: String, header: String) -[Env]> ForeignBoundaryContract ForeignBridgeError! {
    coverage :: ForeignArtifactCoverage.new("{header}:sha256-{pkg_sha256_hex(source.bytes())}", pkg_bridge_foreign_host_target(), "jet-bindgen-v1").with_transitive_dependencies([String]{}).with_reachable_callbacks([String]{}).with_compiler_flags([String]{})
    annotated := contract.with_artifact_coverage(coverage)
    loop line in pkg_bridge_text_lines(source) {
        parts :: line.split_once("jet-ffi-obligation:") ?? next
        pkg_cffi_record_obligation_marker(&annotated, parts.after.trim())
    }
    annotated.validate()
    Ok(annotated)
}

// The canonical automatic facade over every bound function whose header
// evidence justifies an adaptation plan, or `None` when none does.
fn pkg_cffi_automatic_header_facade_from_result(header_source: String, header_path: String, generated: CBindResult) -[Env]> String? ForeignBridgeError! {
    contract :: pkg_cffi_annotated_contract(generated.boundary, header_source, header_path)
    inputs :: BindingInputs.new(pkg_bridge_foreign_host_target(), "jet-bindgen-v1", "{header_path}:sha256-{pkg_sha256_hex(header_source.bytes())}").with_dependencies([String]{}).with_compiler_flags([String]{})
    names := generated.bound
    &names.sort()
    facade := ""
    planned := [String]{}
    loop name in names {
        if planned.contains(name) -> next
        plan :: BindingPlan.resolve(contract, pkg_cffi_automatic_operation(name, header_source), inputs, BindingShape.Automatic) ?? next
        &planned.push(name)
        facade = "{facade}{plan.render_facade()}\n"
    }
    if planned.len() == 0 -> return Ok(None)
    Ok(Val(facade))
}

fn pkg_cffi_generate(header_source: String, lib: String, overlay: HandleOverlay) -> CBindResult ForeignBridgeError! {
    generated :: pkg_cbind_generate_with_overlay(header_source, lib, overlay) ?? return Err(pkg_bridge_error(err.message))
    Ok(generated)
}

fn pkg_cffi_automatic_header_facade(header_source: String, header_path: String, lib: String, overlay: HandleOverlay) -[Env]> String? ForeignBridgeError! {
    pkg_cffi_automatic_header_facade_from_result(header_source, header_path, pkg_cffi_generate(header_source, lib, overlay))
}

// The canonical boundary digest the current header evidence produces.
fn pkg_cffi_canonical_header_boundary(header_source: String, header_path: String, lib: String, overlay: HandleOverlay) -[Env]> String ForeignBridgeError! {
    generated :: pkg_cffi_generate(header_source, lib, overlay)
    contract :: pkg_cffi_annotated_contract(generated.boundary, header_source, header_path)
    Ok(contract.digest())
}

fn pkg_cffi_plan_lock_path(project_root: String, lib: String) -> String Never! {
    files.join(files.join(files.join(files.join(project_root, ".jet"), "lock"), "bindings"), "{lib}.plan")
}

// The first `<prefix><value>` line's value.
fn pkg_cffi_line_value(lines: [String], prefix: String) -> String? Never! {
    loop line in lines {
        if line.starts_with(prefix) -> return Val(line.removeprefix(prefix))
    }
    None
}

// The canonical adaptation facade selected by `jet bind`. Ordinary
// `use "header.h"` compilation consumes the same lock and facade as the
// explicit command; an unfrozen project may omit it, a frozen one may not.
fn pkg_cffi_binding_plan_facade(project_root: String, lib: String, header_source: String?, expected_boundary: String?, frozen: Bool) -[FS]> String? ForeignBridgeError! {
    lock_path :: pkg_cffi_plan_lock_path(project_root, lib)
    lock :: files.read(lock_path) ?? {
        if frozen -> return Err(pkg_bridge_error("frozen binding policy requires `{lock_path}`; run `jet bind {lib} --freeze`"))
        return Ok(None)
    }
    lines :: pkg_bridge_text_lines(lock)
    digest :: pkg_cffi_line_value(lines, "digest=") ?? ""
    if digest.trim() == "" -> return Err(pkg_bridge_error("binding lock `{lock_path}` has no candidate digest"))
    if header_source == .Val(source) {
        artifact :: pkg_cffi_line_value(lines, "artifact=") ?? ""
        if !artifact.contains("sha256-{pkg_sha256_hex(source.bytes())}") -> return Err(pkg_bridge_error("binding `{lib}` input artifact changed under its recorded plan; run `jet bind {lib} --update --preview`"))
    }
    boundary := pkg_cffi_line_value(lines, "boundary=")
    if boundary == .Val(value) {
        if value.trim() == "" -> boundary = None
    }
    if expected_boundary == .Val(expected) {
        if boundary == .Val(recorded) {
            if expected != recorded -> return Err(pkg_bridge_error("binding `{lib}` changed under its recorded plan; run `jet bind {lib} --update --preview`"))
        }
    }
    facade_parts :: lock.split_once("\nfacade:\n") ?? return Err(pkg_bridge_error("binding lock `{lock_path}` has no generated facade"))
    facade :: facade_parts.after
    if expected_boundary == .Val(expected) {
        if pkg_cffi_binding_cache_boundary(facade) != Val(expected) -> return Err(pkg_bridge_error("binding `{lib}` facade boundary does not match the generated header"))
    }
    marker :: pkg_cffi_plan_marker(facade) ?? return Err(pkg_bridge_error("binding lock `{lock_path}` has no facade plan marker"))
    if marker != digest.trim() -> return Err(pkg_bridge_error("binding `{lib}` facade digest does not match `{lock_path}`"))
    if !facade.contains("#Import module c.{lib}") -> return Err(pkg_bridge_error("binding `{lib}` facade does not import its canonical C library"))
    Ok(Val(facade))
}

// The first non-empty `// jet-ffi-plan=<digest>` marker.
fn pkg_cffi_plan_marker(source: String) -> String? Never! {
    loop line in pkg_bridge_text_lines(source) {
        if !line.starts_with("// jet-ffi-plan=") -> next
        value :: line.removeprefix("// jet-ffi-plan=").trim()
        if value != "" -> return Val(value)
    }
    None
}

// Whether `package.jet` freezes binding plans (`bindings: .Frozen`).
fn pkg_cffi_binding_policy_is_frozen(project_root: String) -[FS]> Bool Never! {
    source :: files.read(files.join(project_root, @PACKAGE_FILE)) ?? return false
    pkg_cffi_whitespace_tokens(source).join("").contains("bindings:.Frozen")
}

// The last `// jet-ffi-boundary=<digest>` marker's digest.
fn pkg_cffi_binding_cache_boundary(source: String) -> String? Never! {
    lines :: pkg_bridge_text_lines(source)
    index := lines.len() - 1
    loop index >= 0 {
        line :: lines[index]
        index -= 1
        if !line.starts_with("// jet-ffi-boundary=") -> next
        tokens :: pkg_cffi_whitespace_tokens(line.removeprefix("// jet-ffi-boundary="))
        if tokens.len() > 0 -> return Val(tokens[0])
    }
    None
}

// Append the selected facade to a generated cache. A cache already carrying
// that exact plan is accepted; any other recorded plan is a conflict.
fn pkg_cffi_append_binding_plan_facade(source: &String, facade: String) ForeignBridgeError! {
    selected :: pkg_cffi_plan_marker(facade) ?? return Err(pkg_bridge_error("binding facade has no plan digest"))
    if pkg_cffi_plan_marker(source) == .Val(existing) {
        if existing != selected -> return Err(pkg_bridge_error("generated binding already carries adaptation plan `{existing}`, selected `{selected}`"))
        marker :: "// jet-ffi-plan={selected}"
        suffix :: if source.split_once(marker) == {
            .Val(parts) -> "{marker}{parts.after}".trim_end()
            .None -> ""
        }
        if suffix == facade.trim_end() -> return Ok()
        return Err(pkg_bridge_error("generated binding plan `{selected}` does not match its canonical facade"))
    }
    if !source.ends_with("\n") -> source = source + "\n"
    source = "{source}\n{facade}"
    if !source.ends_with("\n") -> source = source + "\n"
    Ok()
}

// Fold one cache's typed metadata into the program's; an older cache without
// a sidecar keeps the explicit program link with no handle facts.
fn pkg_cffi_collect_binding_metadata(metadata: &CBindingMetadata, cache: String, lib: String, diagnostics: &[Diagnostic]) Never! -[FS]> {
    if pkg_cffi_read_binding_metadata(cache, lib) == {
        .Ok(found) -> {
            if found == .Val(cache_metadata) {
                loop fact in cache_metadata.handle_facts -> &metadata.add_handle(fact)
                &metadata.add_closure(cache_metadata.link_closure)
            } else {
                &metadata.add_closure(FfiLinkClosure.new([String]{lib}, [String]{}))
            }
        }
        .Err(error) -> {
            &diagnostics.push(pkg_cffi_e3208(pkg_cffi_binding_metadata_path(cache), lib, error.message))
        }
    }
}

// A header path: absolute as written, else relative to the project root.
fn pkg_cffi_resolve_header_path(header_path: String, project_root: String) -> String Never! {
    if files.is_absolute(header_path) -> header_path else -> files.join(project_root, header_path)
}

// A generated `#Bindgen` cache must carry the current C descriptor stamp;
// a stale one is refused before the loader parses it.
pub fn pkg_cffi_check_cache_descriptor(source: String, path: String, lib: String) -> Diagnostic? Never! {
    if !source.contains("#Bindgen") -> return None
    descriptor :: pkg_binder_descriptor(ForeignLanguage.C) ?? return None
    expected :: descriptor.stamp()
    loop line in pkg_bridge_text_lines(source) {
        if !line.starts_with("// jet-ffi-descriptor=") -> next
        actual :: line.removeprefix("// jet-ffi-descriptor=")
        if actual != expected -> return Val(pkg_cffi_e3208(path, lib, "the generated cache descriptor is stale (expected `{expected}`, found `{actual}`)"))
        return None
    }
    None
}

// Queue one generated source for the loader after its descriptor check.
fn pkg_cffi_queue_load(preparation: &CBindingPreparation, source: String, path: String, lib: String) Never! {
    if pkg_cffi_check_cache_descriptor(source, path, lib) == .Val(diagnostic) {
        &preparation.diagnostics.push(diagnostic)
        return
    }
    &preparation.loads.push(CBindingLoad{path: path, lib: lib, source: source})
}

// Discover, generate, and refresh the binding caches of every C library the
// program brings in. The first header seen for a library wins. A cache path
// already loaded by the program is not queued again; its facade still is.
pub fn pkg_cffi_prepare_binding_caches(project_root: String, imports: [CBindingImport], loaded_paths: [String], entry: String?, overlays: [String: HandleOverlay]) -[FS, Env, Exec, Time.Wait]> CBindingPreparation Never! {
    preparation := CBindingPreparation{loads: [CBindingLoad]{}, metadata: CBindingMetadata.empty(), diagnostics: [Diagnostic]{}}
    libs := [String]{}
    headers := [String: String]{}
    loop import in imports {
        if !libs.contains(import.lib) -> &libs.push(import.lib)
        if import.header == .Val(header) {
            if !headers.has_key(import.lib) -> headers[import.lib] = header
        }
    }
    frozen :: pkg_cffi_binding_policy_is_frozen(project_root)
    loop lib in libs {
        overlay :: overlays.get(lib) ?? HandleOverlay.empty()
        request :: CBindingRequest{project_root: project_root, lib: lib, header_path: headers.get(lib), overlay: overlay, overlay_supplied: overlays.has_key(lib), entry: entry, frozen: frozen}
        cache_path :: pkg_cffi_binding_cache_file(project_root, ForeignLanguage.C, lib)
        if loaded_paths.contains(cache_path) {
            if pkg_cffi_prepare_loaded_cache(request, cache_path, &preparation) == .Err(error) -> &preparation.diagnostics.push(pkg_cffi_e3208(cache_path, lib, error.message))
            next
        }
        pkg_cffi_prepare_cache(request, cache_path, &preparation)
    }
    preparation
}

// One library's preparation inputs.
struct CBindingRequest {
    project_root: String
    lib: String
    header_path: String?
    overlay: HandleOverlay
    // A typed overlay is an additional bind input beyond the header hash.
    overlay_supplied: Bool
    entry: String?
    frozen: Bool
}

// The boundary a cache's facade must match: the cache's own recorded plan
// boundary, or, when a plan lock exists, the canonical boundary of the
// current header evidence.
fn pkg_cffi_expected_boundary(request: CBindingRequest, source: String, header_source: String?) -[FS, Env]> String? ForeignBridgeError! {
    if source.contains("// jet-ffi-plan=") -> return Ok(pkg_cffi_binding_cache_boundary(source))
    header :: header_source ?? return Ok(None)
    if !files.is_file(pkg_cffi_plan_lock_path(request.project_root, request.lib)) -> return Ok(None)
    header_path :: request.header_path ?? request.lib
    Ok(Val(pkg_cffi_canonical_header_boundary(header, header_path, request.lib, request.overlay)))
}

fn pkg_cffi_read_header(request: CBindingRequest) -[FS]> String? Never! {
    header_path :: request.header_path ?? return None
    source :: files.read(pkg_cffi_resolve_header_path(header_path, request.project_root)) ?? return None
    Val(source)
}

// The adapted facade to load beside a cache that carries no plan of its own:
// the recorded facade, else the automatic one.
fn pkg_cffi_select_facade(request: CBindingRequest, source: String, header_source: String?, expected_boundary: String?) -[FS, Env]> String? ForeignBridgeError! {
    recorded :: pkg_cffi_binding_plan_facade(request.project_root, request.lib, header_source, expected_boundary, request.frozen)
    if recorded == .Val(facade) {
        checked := source
        pkg_cffi_append_binding_plan_facade(&checked, facade)
        if source.contains("// jet-ffi-plan=") -> return Ok(None)
        return Ok(Val(facade))
    }
    if source.contains("// jet-ffi-plan=") -> return Ok(None)
    header :: header_source ?? return Ok(None)
    pkg_cffi_automatic_header_facade(header, request.header_path ?? request.lib, request.lib, request.overlay)
}

// A cache the program already loaded: only its adaptation facade is queued.
fn pkg_cffi_prepare_loaded_cache(request: CBindingRequest, cache_path: String, preparation: &CBindingPreparation) ForeignBridgeError! -[FS, Env]> {
    source :: files.read(cache_path) ?? ""
    header_source :: pkg_cffi_read_header(request)
    expected_boundary :: pkg_cffi_expected_boundary(request, source, header_source)
    facade :: pkg_cffi_select_facade(request, source, header_source, expected_boundary)
    if facade == .Val(text) -> pkg_cffi_queue_load(preparation, text, pkg_cffi_sidecar(cache_path, "adapted.jet"), request.lib)
    pkg_cffi_collect_binding_metadata(&preparation.metadata, cache_path, request.lib, &preparation.diagnostics)
    Ok()
}

// Generate a missing or stale cache from its header, or load a present,
// fresh one, with its sidecars and facade.
fn pkg_cffi_prepare_cache(request: CBindingRequest, cache_path: String, preparation: &CBindingPreparation) Never! -[FS, Env, Exec, Time.Wait]> {
    lib :: request.lib
    header_source := None
    if request.header_path == .Val(header_path) {
        // A source header import authorizes only bindings derived from that
        // readable header; `use c.<lib>` is the explicit headerless mode.
        if files.read(pkg_cffi_resolve_header_path(header_path, request.project_root)) == {
            .Ok(source) -> header_source = Val(source)
            .Err(error) -> {
                &preparation.diagnostics.push(pkg_cffi_e3208(header_path, lib, "the header file could not be read ({error})."))
                return
            }
        }
    }
    need_rebind := false
    if files.is_file(cache_path) {
        if request.overlay_supplied {
            // The legacy `.hash` sidecar covers header bytes only.
            need_rebind = true
        } else if header_source == .Val(header) {
            need_rebind = pkg_cbind_read_stored_hash(cache_path) != Val(pkg_cbind_compute_bind_hash(header, ""))
        }
    }
    if !files.is_file(cache_path) || need_rebind {
        header_path :: request.header_path ?? {
            // No header: load an existing headerless cache as-is.
            if files.is_file(cache_path) -> pkg_cffi_load_headerless_cache(request, cache_path, preparation)
            return
        }
        header :: header_source ?? panic("header path was collected")
        pkg_cffi_generate_cache(request, cache_path, header_path, header, preparation)
        return
    }
    pkg_cffi_load_fresh_cache(request, cache_path, header_source, preparation)
}

fn pkg_cffi_load_headerless_cache(request: CBindingRequest, cache_path: String, preparation: &CBindingPreparation) Never! -[FS, Env]> {
    source := files.read(cache_path) ?? return
    expected_boundary := None
    if source.contains("// jet-ffi-plan=") -> expected_boundary = pkg_cffi_binding_cache_boundary(source)
    if pkg_cffi_binding_plan_facade(request.project_root, request.lib, None, expected_boundary, request.frozen) == {
        .Ok(selected) -> {
            if selected == .Val(facade) {
                if pkg_cffi_append_binding_plan_facade(&source, facade) == .Err(error) {
                    &preparation.diagnostics.push(pkg_cffi_e3208(cache_path, request.lib, error.message))
                    return
                }
            }
        }
        .Err(error) -> {
            &preparation.diagnostics.push(pkg_cffi_e3208(cache_path, request.lib, error.message))
            return
        }
    }
    pkg_cffi_queue_load(preparation, source, cache_path, request.lib)
    pkg_cffi_collect_binding_metadata(&preparation.metadata, cache_path, request.lib, &preparation.diagnostics)
}

// Run the C binder over the header and publish the cache, its hash, typed
// metadata, and provenance. A header that no longer binds never revives the
// previous generation.
fn pkg_cffi_generate_cache(request: CBindingRequest, cache_path: String, header_path: String, header: String, preparation: &CBindingPreparation) Never! -[FS, Env, Exec, Time.Wait]> {
    lib :: request.lib
    result :: if pkg_cbind_generate_with_overlay(header, lib, request.overlay) == {
        .Ok(generated) -> generated
        .Err(error) -> {
            &preparation.diagnostics.push(pkg_cffi_e3208(header_path, lib, "{error.message}."))
            return
        }
    }
    if result.handle_skipped.len() > 0 {
        details := [String]{}
        loop skipped in result.handle_skipped -> &details.push("`{skipped.typedef_name}`: {skipped.reason}")
        &preparation.diagnostics.push(pkg_cffi_e3208(header_path, lib, "opaque handle bindings were unresolved: {details.join("; ")}"))
        return
    }
    generated_source := result.source
    automatic_facade := None
    if pkg_cffi_generated_facade(request, header_path, header, result, &generated_source) == {
        .Ok(facade) -> automatic_facade = facade
        .Err(error) -> {
            &preparation.diagnostics.push(pkg_cffi_e3208(header_path, lib, error.message))
            return
        }
    }
    files.create_dir_all(files.dirname(cache_path)).drop("the cache write below reports a missing directory")
    if files.write(cache_path, generated_source) == .Err(_) {
        &preparation.diagnostics.push(pkg_cffi_e3208(header_path, lib, "could not write generated cache `{cache_path}`"))
        return
    }
    pkg_cbind_write_bind_hash(cache_path, header, "").drop("the bind hash is the quick rebind check; a missing one only forces a rebind")
    if pkg_cffi_write_c_binding_metadata(cache_path, result.handles, result.link_closure) == .Err(error) {
        &preparation.diagnostics.push(pkg_cffi_e3208(cache_path, lib, error.message))
        return
    }
    pkg_cffi_collect_binding_metadata(&preparation.metadata, cache_path, lib, &preparation.diagnostics)
    header_file :: pkg_cffi_resolve_header_path(header_path, request.project_root)
    if pkg_cffi_write_c_binding_provenance_with_boundary(request.project_root, lib, header_file, cache_path, request.entry, Val(result.boundary)) == .Err(error) {
        &preparation.diagnostics.push(pkg_cffi_e3208(header_path, lib, error.message))
        return
    }
    pkg_cffi_queue_load(preparation, generated_source, cache_path, lib)
    if automatic_facade == .Val(facade) -> pkg_cffi_queue_load(preparation, facade, pkg_cffi_sidecar(cache_path, "adapted.jet"), lib)
}

// The recorded facade appended to a newly generated cache, or the automatic
// facade to load beside it.
fn pkg_cffi_generated_facade(request: CBindingRequest, header_path: String, header: String, result: CBindResult, generated_source: &String) -[FS, Env]> String? ForeignBridgeError! {
    contract :: pkg_cffi_annotated_contract(result.boundary, header, header_path)
    expected_boundary :: contract.digest()
    recorded :: pkg_cffi_binding_plan_facade(request.project_root, request.lib, Val(header), Val(expected_boundary), request.frozen)
    if recorded == .Val(facade) {
        pkg_cffi_append_binding_plan_facade(generated_source, facade)
        return Ok(None)
    }
    pkg_cffi_automatic_header_facade_from_result(header, header_path, result)
}

// A present, fresh cache: publish provenance once (it is an immutable record
// of the bind that produced the cache), then load it with its facade.
fn pkg_cffi_load_fresh_cache(request: CBindingRequest, cache_path: String, header_source: String?, preparation: &CBindingPreparation) Never! -[FS, Env, Exec, Time.Wait]> {
    lib :: request.lib
    source := files.read(cache_path) ?? return
    if request.header_path == .Val(header_path) {
        if !files.is_file(pkg_cffi_sidecar(cache_path, "provenance")) {
            header_file :: pkg_cffi_resolve_header_path(header_path, request.project_root)
            if pkg_cffi_write_c_binding_provenance_with_entry(request.project_root, lib, header_file, cache_path, request.entry) == .Err(error) {
                &preparation.diagnostics.push(pkg_cffi_e3208(header_path, lib, error.message))
                return
            }
        }
    }
    automatic_facade := None
    if pkg_cffi_fresh_cache_facade(request, &source, header_source) == {
        .Ok(facade) -> automatic_facade = facade
        .Err(error) -> {
            &preparation.diagnostics.push(pkg_cffi_e3208(cache_path, lib, error.message))
            return
        }
    }
    pkg_cffi_collect_binding_metadata(&preparation.metadata, cache_path, lib, &preparation.diagnostics)
    pkg_cffi_queue_load(preparation, source, cache_path, lib)
    if automatic_facade == .Val(facade) -> pkg_cffi_queue_load(preparation, facade, pkg_cffi_sidecar(cache_path, "adapted.jet"), lib)
}

fn pkg_cffi_fresh_cache_facade(request: CBindingRequest, source: &String, header_source: String?) -[FS, Env]> String? ForeignBridgeError! {
    expected_boundary :: pkg_cffi_expected_boundary(request, source, header_source)
    recorded :: pkg_cffi_binding_plan_facade(request.project_root, request.lib, header_source, expected_boundary, request.frozen)
    if recorded == .Val(facade) {
        pkg_cffi_append_binding_plan_facade(source, facade)
        return Ok(None)
    }
    if source.contains("// jet-ffi-plan=") -> return Ok(None)
    header :: header_source ?? return Ok(None)
    pkg_cffi_automatic_header_facade(header, request.header_path ?? request.lib, request.lib, request.overlay)
}
