// Rust CFFI coverage extends the sole existing compiler CFFI owners, not a
// second binder/serializer/assembly path. Native assembly lives in Driver.
use jet_foundation.[Diagnostic, Span, ForeignLanguage, ImportDecl, ImportKind, ForeignImportError, ExternFn]
use jet_pkg_model.AST.[LoadedModule, ProgramBundle, walk_imports]

// Rust: crates/jet-pkg-model/src/CFFI.rs:39
// CFfi/CImportLink/COverlayOverride/CLib remain canonical Foundation AST facts;
// callers import those owners directly (no compatibility re-exports).

// Rust: crates/jet-pkg-model/src/CFFI.rs:41
// GATE #4499: exact equality/hash of (optional scope, Span), no encoded keys.
fn all_imports(module: LoadedModule) -> [(String?, ImportDecl)] {
    seen := [(String?, Span): Bool]{}
    imports := [(String?, ImportDecl)]{}
    for (scope, declaration) in walk_imports(module) {
        key := (scope, declaration.span)
        if seen.contains_key(key) { continue }
        seen[key] = true
        imports.push((scope, declaration))
    }
    imports
}

// Rust: crates/jet-pkg-model/src/CFFI.rs:50
// GATE #4499: exact (module index, Span) map keys.
fn invalid_foreign_import_diagnostics(bundle: ProgramBundle) -> [Diagnostic] {
    diagnostics := [Diagnostic]{}
    seen := [(Int, Span): Bool]{}
    for (module_idx, module) in bundle.modules.enumerate() {
        for (_, declaration) in all_imports(module) {
            key := (module_idx, declaration.span)
            if seen.contains_key(key) { continue }
            seen[key] = true
            if declaration.foreign_imports() is Err(error) {
                diagnostics.push(error.diagnostic())
            }
        }
    }
    diagnostics
}

// Rust: crates/jet-pkg-model/src/CFFI.rs:68
pub fn c_module_imports(imp: ImportDecl) -> [(String, String)] ForeignImportError! {
    imports := imp.foreign_imports()?
    result := [(String, String)]{}
    for (namespace, alias) in imports {
        if namespace.language == ForeignLanguage.C {
            result.push((namespace.lib, alias))
        }
    }
    result
}

// Rust: crates/jet-pkg-model/src/CFFI.rs:78
fn c_module_imports_after_preflight(imp: ImportDecl) -> [(String, String)] {
    c_module_imports(imp).unwrap_or_else((error) ->
        panic("invalid foreign import reached CFFI after preflight: {error.path}"))
}

// Rust: crates/jet-pkg-model/src/CFFI.rs:90
pub fn c_header_lib(imp: ImportDecl) -> (String, String)? {
    if imp.kind is ImportKind.File(path, _) {
        if path.ends_with(".h") {
            base := path.rsplit('/').next().unwrap_or(path)
            lib := base.strip_suffix(".h").unwrap_or(base).to_string()
            return Some((path.clone(), lib))
        }
    }
    None
}

// Rust: crates/jet-pkg-model/src/CFFI.rs:102
pub fn is_c_import(imp: ImportDecl) -> Bool ForeignImportError! {
    !c_module_imports(imp)?.is_empty() || c_header_lib(imp).is_some()
}

