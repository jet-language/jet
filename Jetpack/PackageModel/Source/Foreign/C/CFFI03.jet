//RS /// E3201 — C library not found via a declared `c@…` dep or pkg-config.
//RS fn e3201(lib: &str) -> Diagnostic {
//RS     Diagnostic::error(
//RS         "E3201",
//RS         format!("C library `{}` was not found.", lib),
//RS         format!(
//RS             "Jet looked for a `{lib}: {}@…` dep in `{}`, then tried `pkg-config {lib}` on the system; neither provided include/link paths.",
//RS             Syntax::DEP_PROVIDER_C, Syntax::PACKAGE_FILE,
//RS         ),
//RS         format!(
//RS             "Install the system package (e.g. `pacman -S {lib}`), or declare it as `{lib}: {}{}{}` in `deps:`.",
//RS             Syntax::DEP_PROVIDER_C, Syntax::REF_PROVIDER_AT, Syntax::SYSTEM_LIB_TARGET,
//RS         ),
//RS         None,
//RS     )
//RS }
//RS 
//RS /// E3209 — the linker could not find a C library at link time. Distinct from
//RS /// E3201 (resolution found no paths up front): here resolution produced a
//RS /// `-l<name>` but the library is not on the link search path. Kept off the I2
//RS /// ICE banner — a missing system library is a user/system problem, not
//RS /// generated code being rejected by rustc.
//RS pub fn e3209(lib: &str) -> Diagnostic {
//RS     Diagnostic::error(
//RS         "E3209",
//RS         format!("The linker couldn't find C library `{}`.", lib),
//RS         format!(
//RS             "Your program links against `{lib}`, but the linker reported `cannot find -l{lib}` — the library isn't on the link search path.",
//RS         ),
//RS         format!(
//RS             "Declare it in `deps:` so Jet provisions it: `{lib}: {}{}{}` (host pkg-config, else fetched from nixpkgs), or `{lib}: {}@nixpkgs:<attr>` to pick the nixpkgs attribute, or install the system package.",
//RS             Syntax::DEP_PROVIDER_C, Syntax::REF_PROVIDER_AT, Syntax::SYSTEM_LIB_TARGET,
//RS             Syntax::DEP_PROVIDER_C,
//RS         ),
//RS         None,
//RS     )
//RS }
