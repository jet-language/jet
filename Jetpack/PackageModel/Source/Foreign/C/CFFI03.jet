//RS         format!(
//RS             "`{lib}: {}{}{}` asked Jet to provision `nixpkgs#{attr}`, but `nix build` failed: {reason}",
//RS             Syntax::DEP_PROVIDER_C, Syntax::REF_PROVIDER_AT, Syntax::SYSTEM_LIB_TARGET,
//RS         ),
//RS         format!(
//RS             "Check the attr exists (`nix build nixpkgs#{attr}`), or point at a local build with `{lib}: {}@\"<path>\"`, or install it and use `{}`.",
//RS             Syntax::DEP_PROVIDER_C, Syntax::SYSTEM_LIB_TARGET,
//RS         ),
//RS         None,
//RS     )
