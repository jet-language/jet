//RS /// Native-library link inputs for rustc (`-l`, `-L`, `-I` analog via cc args).
//RS #[derive(Debug, Clone, Default)]
//RS pub struct LinkFlags {
//RS     pub include_dirs: Vec<String>,
//RS     pub lib_dirs: Vec<String>,
//RS     /// Names passed to `-l` (e.g. `raylib`).
//RS     pub link_names: Vec<String>,
//RS     /// Dirs to bake into the binary's runtime search path (`-Wl,-rpath`), so a
//RS     /// shared library realized into `/nix/store` is found at run time with no
//RS     /// `LD_LIBRARY_PATH`.
//RS     pub rpath_dirs: Vec<String>,
//RS }
