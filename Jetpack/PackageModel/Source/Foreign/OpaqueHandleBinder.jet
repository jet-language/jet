// Opaque C typedef discovery for the C binding generator, ported from
// jet_pkg_model::OpaqueHandleBinder.
//
// Discovery stops at a source/model boundary: it records the ownership,
// thread-safety, and link-closure facts a later compiler seam lowers into
// ordinary Jet handle types. It never turns an unknown pointer into an
// integer and never infers thread safety or transitive libraries.

@OPAQUE_HANDLE_CLOSE_VERBS :: [String]{"close", "destroy", "free", "release", "unref", "deinit", "fini", "finalize", "dispose"}

// Thread safety is an explicit overlay fact. `Unspecified` is intentional:
// the binder never infers a concurrency guarantee from C spelling.
pub enum ThreadSafety {
    Unspecified
    Safe
    Unsafe
}

// Why a handle's close symbol was selected.
pub enum CloseSource {
    Conventional
    Overlay
}

// Native libraries that must stay attached to one generated binding.
// `primary` is the library the C import names; `transitive` holds only
// libraries the overlay supplied, never ones guessed from includes or symbols.
pub struct LinkClosure {
    pub primary: String
    pub transitive: [String]

    // The overlay's libraries without the primary or repeats, sorted.
    fn new(primary: String, transitive: [String]) -> LinkClosure Never! {
        links := [String]{}
        loop link in transitive {
            if link == primary || links.contains(link) -> next
            &links.push(link)
        }
        &links.sort()
        LinkClosure{primary: primary, transitive: links}
    }

    // The complete deterministic link list, primary first.
    fn libraries(self) -> [String] Never! {
        out := [String]{self.primary}
        loop link in self.transitive -> &out.push(link)
        out
    }
}

// Explicit metadata supplied by a package's C binding overlay.
pub struct HandleOverlay {
    // A C typedef, its generated Jet name, or an opaque struct tag mapped to a
    // close symbol; required when conventional discovery is absent or
    // ambiguous.
    pub close_functions: [String: String]
    // Per-handle concurrency declarations; missing entries stay unspecified.
    pub thread_safety: [String: ThreadSafety]
    // Explicit transitive libraries this binding needs.
    pub links: [String]

    fn empty() -> HandleOverlay Never! {
        HandleOverlay{close_functions: [String: String]{}, thread_safety: [String: ThreadSafety]{}, links: [String]{}}
    }

    fn with_close(self, handle: String, symbol: String) -> HandleOverlay Never! {
        out := self
        out.close_functions[handle] = symbol
        out
    }

    fn with_thread_safety(self, handle: String, safety: ThreadSafety) -> HandleOverlay Never! {
        out := self
        out.thread_safety[handle] = safety
        out
    }

    fn with_link(self, library: String) -> HandleOverlay Never! {
        out := self
        &out.links.push(library)
        out
    }

    // The first close mapping for the typedef, its Jet name, or its tag.
    fn close_for(self, typedef_name: String, jet_name: String, struct_tag: String) -> String? Never! {
        keys :: [String]{typedef_name, jet_name, struct_tag}
        loop key in keys {
            if self.close_functions.get(key) == {
                .Val(symbol) -> return Val(symbol)
                .None -> {}
            }
        }
        None
    }

    fn thread_safety_for(self, typedef_name: String, jet_name: String, struct_tag: String) -> ThreadSafety Never! {
        keys :: [String]{typedef_name, jet_name, struct_tag}
        loop key in keys {
            if self.thread_safety.get(key) == {
                .Val(safety) -> return safety
                .None -> {}
            }
        }
        ThreadSafety.Unspecified
    }
}

// A generated owned handle. Every fact is owned, so its close symbol is
// mandatory; handles without one stay in `unresolved`.
pub struct HandleFact {
    // The C typedef spelling that introduced the opaque pointer.
    pub typedef_name: String
    // The generated nominal Jet type name.
    pub jet_name: String
    // The native close function.
    pub close: String
    pub close_source: CloseSource
    pub thread_safety: ThreadSafety
    pub link_closure: LinkClosure
}

// An opaque pointer shape: the incomplete struct (or `void`) it names and
// how many `*` the typedef itself carries.
struct OpaqueHandleShape {
    struct_tag: String
    pointer_depth: Int
}

// What a typedef aliases.
enum OpaqueAliasBase {
    Struct(String)
    Alias(String)
    Opaque
    Other
}

struct OpaqueAliasDecl {
    base: OpaqueAliasBase
    pointer_depth: Int
}

struct OpaqueCPrototype {
    name: String
    params: [String]
}

struct OpaqueCTypeShape {
    base: String?
    struct_tag: String?
    pointer_depth: Int
}

// Opaque handle discovery over one C header, consumed by the C binder.
pub struct OpaqueHandleDiscovery {
    pub handles: [HandleFact]
    // Opaque typedefs that cannot safely become owned handles, with the
    // reason, so the binder reports them instead of pretending they are
    // scalars.
    pub unresolved: [(typedef_name: String, reason: String)]
    opaque: [String: OpaqueHandleShape]
    handle_indices: [String: Int]

    // Discover opaque struct-pointer typedefs and resolve their ownership
    // facts. `source` is the original header or the binder's cleaned
    // declaration stream; unsupported declarations are left to the binder.
    fn discover(source: String, lib: String, overlay: HandleOverlay) -> OpaqueHandleDiscovery Never! {
        declarations :: pkg_opaque_split_declarations(pkg_opaque_strip_comments_and_directives(source))
        complete_tags :: pkg_opaque_complete_struct_tags(declarations)
        alias_decls := [String: OpaqueAliasDecl]{}
        loop declaration in declarations {
            if pkg_opaque_parse_typedef(declaration) == {
                .Val(parsed) -> alias_decls[parsed.name] = parsed.decl
                .None -> {}
            }
        }
        opaque := [String: OpaqueHandleShape]{}
        loop name in pkg_opaque_sorted_keys(alias_decls.keys().to_list()) {
            resolved :: pkg_opaque_resolve_alias(name, alias_decls, complete_tags, [String]{}) ?? next
            if resolved.pointer_depth <= 1 && !complete_tags.contains(resolved.struct_tag) -> opaque[name] = resolved
        }
        prototypes := [OpaqueCPrototype]{}
        loop declaration in declarations {
            if pkg_opaque_parse_prototype(declaration) == {
                .Val(prototype) -> &prototypes.push(prototype)
                .None -> {}
            }
        }
        used_names := [String]{}
        handles := [HandleFact]{}
        unresolved := [(typedef_name: String, reason: String)]{}
        links :: LinkClosure.new(lib, overlay.links)
        loop typedef_name in pkg_opaque_sorted_keys(opaque.keys().to_list()) {
            shape :: opaque[typedef_name]
            candidates := [String]{}
            loop prototype in prototypes {
                if prototype.params.len() != 1 -> next
                if !pkg_opaque_matches_shape(prototype.params[0], typedef_name, shape) -> next
                if pkg_opaque_conventional_close_name(prototype.name, typedef_name, shape.struct_tag) -> &candidates.push(prototype.name)
            }
            jet_name :: pkg_opaque_unique_name(&used_names, foundation_generated_type_name(pkg_opaque_handle_name_seed(typedef_name), "Handle"))
            close := ""
            close_source := CloseSource.Conventional
            if overlay.close_for(typedef_name, jet_name, shape.struct_tag) == {
                .Val(symbol) -> {
                    if !pkg_opaque_is_ident(symbol) {
                        &unresolved.push((typedef_name: ~typedef_name, reason: "overlay close symbol `{symbol}` for opaque handle `{typedef_name}` is not a valid C identifier"))
                        next
                    }
                    close = symbol
                    close_source = CloseSource.Overlay
                }
                .None -> {
                    if candidates.len() == 0 {
                        &unresolved.push((typedef_name: ~typedef_name, reason: "opaque handle `{typedef_name}` has no conventional close function; provide an overlay close mapping"))
                        next
                    }
                    if candidates.len() > 1 {
                        &unresolved.push((typedef_name: ~typedef_name, reason: "opaque handle `{typedef_name}` has ambiguous conventional close functions ({candidates.join(", ")}); provide an overlay close mapping"))
                        next
                    }
                    close = candidates[0]
                }
            }
            safety :: overlay.thread_safety_for(typedef_name, jet_name, shape.struct_tag)
            &handles.push(HandleFact{
                typedef_name: typedef_name,
                jet_name: jet_name,
                close: close,
                close_source: close_source,
                thread_safety: safety,
                link_closure: ~links
            })
        }
        handle_indices := [String: Int]{}
        loop index in 0..<handles.len() -> handle_indices[handles[index].typedef_name] = index
        OpaqueHandleDiscovery{handles: handles, unresolved: unresolved, opaque: opaque, handle_indices: handle_indices}
    }

    // The owned handle a C parameter or return type spells, if any.
    fn handle_for_type(self, c_type: String) -> HandleFact? Never! {
        loop alias in pkg_opaque_sorted_keys(self.opaque.keys().to_list()) {
            if !pkg_opaque_matches_shape(c_type, alias, self.opaque[alias]) -> next
            index :: self.handle_indices.get(alias) ?? next
            return Val(self.handles[index])
        }
        None
    }

    // Why the opaque typedef a C type spells could not become a handle.
    fn unresolved_reason_for_type(self, c_type: String) -> String? Never! {
        loop alias in pkg_opaque_sorted_keys(self.opaque.keys().to_list()) {
            if !pkg_opaque_matches_shape(c_type, alias, self.opaque[alias]) -> next
            loop entry in self.unresolved {
                if entry.typedef_name == alias -> return Val(entry.reason)
            }
        }
        None
    }

    fn is_close_function(self, function: String, c_type: String) -> Bool Never! {
        handle :: self.handle_for_type(c_type) ?? return false
        handle.close == function
    }

    // One empty nominal struct per handle, then a blank line.
    fn render_type_declarations(self) -> String Never! {
        lines := [String]{}
        loop handle in self.handles -> &lines.push("pub struct {handle.jet_name} {{}}\n")
        if lines.len() == 0 -> return ""
        "{lines.join("")}\n"
    }
}

fn pkg_opaque_sorted_keys(keys: [String]) -> [String] Never! {
    out := keys
    &out.sort()
    out
}

// `name_t` names its handle `name`.
fn pkg_opaque_handle_name_seed(typedef_name: String) -> String Never! {
    if typedef_name.ends_with("_t") && typedef_name != "_t" -> return typedef_name.removesuffix("_t")
    ~typedef_name
}

// Whether `function` is `<stem><verb>`, `<stem>_<verb>`, or `<verb>_<stem>`
// for a close verb and a stem of the typedef or struct tag (lowercase, snake,
// or any leading run of snake words).
fn pkg_opaque_conventional_close_name(function: String, typedef_name: String, struct_tag: String) -> Bool Never! {
    stems := [String]{}
    spellings :: [String]{typedef_name, struct_tag}
    loop spelling in spellings {
        raw := spelling
        loop raw.starts_with("_") -> raw = raw.removeprefix("_")
        loop raw.ends_with("_t") -> raw = raw.removesuffix("_t")
        if raw == "" -> next
        &stems.push(raw.to_lower())
        snake :: pkg_opaque_camel_to_snake(raw)
        &stems.push(snake)
        parts :: snake.split("_").to_list()
        prefix := ""
        loop index in 0..<parts.len() {
            prefix = if index == 0 -> parts[index] else -> "{prefix}_{parts[index]}"
            &stems.push(prefix)
        }
    }
    wanted :: function.to_lower()
    loop stem in stems {
        loop verb in @OPAQUE_HANDLE_CLOSE_VERBS {
            forms :: [String]{[String]{~stem, ~verb}.join(""), "{stem}_{verb}", "{verb}_{stem}"}
            if forms.contains(wanted) -> return true
        }
    }
    false
}

// ASCII camel case to snake case; every other non-alphanumeric run is one `_`.
fn pkg_opaque_camel_to_snake(raw: String) -> String Never! {
    out := [U8]{}
    previous_lower := false
    loop byte in raw.bytes() {
        code :: Int.from_u8(byte)
        upper :: code >= 65 && code <= 90
        lower :: code >= 97 && code <= 122
        digit :: code >= 48 && code <= 57
        ends_underscore :: out.len() > 0 && Int.from_u8(out[out.len() - 1]) == 95
        if upper && previous_lower && !ends_underscore -> &out.push(U8{95})
        if {
            upper || lower || digit -> {
                &out.push(if upper -> U8{code + 32} else -> byte)
                previous_lower = lower || digit
            }
            else -> {
                if !(out.len() > 0 && Int.from_u8(out[out.len() - 1]) == 95) -> &out.push(U8{95})
                previous_lower = false
            }
        }
    }
    end := out.len()
    loop end > 0 && Int.from_u8(out[end - 1]) == 95 -> end -= 1
    pkg_bytes_text(out, 0, end)
}

// Whether a C type spells the opaque typedef `alias`: through its struct tag
// with exactly one `*`, or through the alias with the `*` the typedef itself
// does not carry.
fn pkg_opaque_matches_shape(raw: String, alias: String, shape: OpaqueHandleShape) -> Bool Never! {
    actual :: pkg_opaque_parse_type_shape(pkg_opaque_parameter_type(raw))
    base :: actual.base ?? return false
    if actual.struct_tag == {
        .Val(found) -> {
            if found == shape.struct_tag -> return actual.pointer_depth == 1
        }
        .None -> {}
    }
    if base != alias -> return false
    // A typedef that already names a pointer is written without another `*`;
    // one naming an incomplete struct is written with exactly one `*`.
    expected :: if shape.pointer_depth == 0 -> 1 else -> 0
    actual.pointer_depth == expected
}

// A prototype parameter's C type without its declarator name, so `gzFile
// file` is the type `gzFile`, not a type named `file`.
fn pkg_opaque_parameter_type(input: String) -> String Never! {
    raw :: input.trim()
    bytes :: raw.bytes()
    position := bytes.len() - 1
    loop position >= 0 && pkg_bytes_is_word(Int.from_u8(bytes[position])) -> position -= 1
    if position < 0 -> return raw
    tail :: pkg_bytes_text(bytes, position + 1, bytes.len())
    separator :: Int.from_u8(bytes[position])
    separates :: separator == 42 || separator == 32 || (separator >= 9 && separator <= 13)
    if pkg_opaque_is_ident(tail) && separates {
        declared :: pkg_bytes_text(bytes, 0, position + 1).trim()
        if declared != "" -> return declared
    }
    raw
}

// Resolve a typedef through alias chains to its opaque shape; `path` holds
// the aliases already on this chain so a cycle resolves to nothing.
fn pkg_opaque_resolve_alias(name: String, aliases: [String: OpaqueAliasDecl], complete_tags: [String], path: [String]) -> OpaqueHandleShape? Never! {
    if path.contains(name) -> return None
    decl :: aliases.get(name) ?? return None
    if decl.base == {
        .Opaque -> Val(OpaqueHandleShape{struct_tag: name, pointer_depth: decl.pointer_depth})
        .Struct(struct_tag) -> if complete_tags.contains(struct_tag) -> None else -> Val(OpaqueHandleShape{struct_tag: struct_tag, pointer_depth: decl.pointer_depth})
        .Other -> None
        .Alias(other) -> {
            chain := path
            &chain.push(name)
            inner :: pkg_opaque_resolve_alias(other, aliases, complete_tags, chain) ?? return None
            Val(OpaqueHandleShape{struct_tag: inner.struct_tag, pointer_depth: inner.pointer_depth + decl.pointer_depth})
        }
    }
}

// Struct tags some declaration defines with a body.
fn pkg_opaque_complete_struct_tags(declarations: [String]) -> [String] Never! {
    complete := [String]{}
    loop declaration in declarations {
        tokens :: pkg_opaque_tokenize(declaration)
        // A tag is complete when a `{` follows its name anywhere later.
        last_brace := -1
        loop index in 0..<tokens.len() {
            if tokens[index] == "{{" -> last_brace = index
        }
        loop index in 0..<(tokens.len() - 2) {
            if tokens[index] != "struct" || !pkg_opaque_is_ident(tokens[index + 1]) -> next
            if last_brace >= index + 2 && !complete.contains(tokens[index + 1]) -> &complete.push(tokens[index + 1])
        }
    }
    complete
}

// `typedef <type> name`; function-pointer typedefs need a declarator parser
// and are never guessed as handles.
fn pkg_opaque_parse_typedef(declaration: String) -> (name: String, decl: OpaqueAliasDecl)? Never! {
    tokens :: pkg_opaque_tokenize(declaration)
    if tokens.len() == 0 || tokens[0] != "typedef" -> return None
    if tokens[1..<tokens.len()].contains("(") -> return None
    alias_position := tokens.len() - 1
    loop alias_position >= 0 && !pkg_opaque_is_ident(tokens[alias_position]) -> alias_position -= 1
    if alias_position <= 0 -> return None
    type_tokens := [String]{}
    loop index in 1..<alias_position -> &type_tokens.push(tokens[index])
    pointer_depth := 0
    loop token in type_tokens {
        if token == "*" -> pointer_depth += 1
    }
    base := OpaqueAliasBase.Other
    struct_position := -1
    loop index in 0..<type_tokens.len() {
        if type_tokens[index] == "struct" {
            struct_position = index
            break
        }
    }
    if {
        struct_position >= 0 -> {
            if struct_position + 1 < type_tokens.len() && pkg_opaque_is_ident(type_tokens[struct_position + 1]) -> base = OpaqueAliasBase.Struct(type_tokens[struct_position + 1])
        }
        pointer_depth > 0 && type_tokens.contains("void") && pkg_opaque_only_void_pointer(type_tokens) -> base = OpaqueAliasBase.Opaque
        type_tokens.len() == 1 && pkg_opaque_is_ident(type_tokens[0]) -> base = OpaqueAliasBase.Alias(type_tokens[0])
        else -> {}
    }
    Val((name: tokens[alias_position], decl: OpaqueAliasDecl{base: base, pointer_depth: pointer_depth}))
}

fn pkg_opaque_only_void_pointer(tokens: [String]) -> Bool Never! {
    loop token in tokens {
        if token == {
            "void" | "const" | "volatile" | "restrict" | "*" -> {}
            else -> return false
        }
    }
    true
}

// `<return type> name(<params>)` with nothing after the closing paren.
fn pkg_opaque_parse_prototype(declaration: String) -> OpaqueCPrototype? Never! {
    if declaration.contains("{{") || declaration.trim_start().starts_with("typedef") -> return None
    bytes :: declaration.bytes()
    open := -1
    close := -1
    loop index in 0..<bytes.len() {
        code :: Int.from_u8(bytes[index])
        if code == 40 && open < 0 -> open = index
        if code == 41 -> close = index
    }
    if open < 0 || close < 0 || close < open -> return None
    if pkg_bytes_text(bytes, close + 1, bytes.len()).trim() != "" -> return None
    before :: pkg_bytes_text(bytes, 0, open).trim()
    if before.contains("(") -> return None
    before_bytes :: before.bytes()
    name_start := before_bytes.len()
    loop name_start > 0 && pkg_bytes_is_word(Int.from_u8(before_bytes[name_start - 1])) -> name_start -= 1
    name :: pkg_bytes_text(before_bytes, name_start, before_bytes.len())
    if !pkg_opaque_is_ident(name) -> return None
    if pkg_bytes_text(before_bytes, 0, name_start).trim() == "" -> return None
    params :: pkg_opaque_split_params(pkg_bytes_text(bytes, open + 1, close).trim()) ?? return None
    Val(OpaqueCPrototype{name: name, params: params})
}

// Top-level comma-separated parameters; `void` or nothing is none, and an
// empty or unbalanced parameter rejects the prototype.
fn pkg_opaque_split_params(text: String) -> [String]? Never! {
    if text == "" || text == "void" -> return Val([String]{})
    bytes :: text.bytes()
    params := [String]{}
    start := 0
    depth := 0
    loop index in 0..<bytes.len() {
        code :: Int.from_u8(bytes[index])
        if code == {
            40 | 91 -> depth += 1
            41 | 93 -> {
                depth -= 1
                if depth < 0 -> return None
            }
            44 -> {
                if depth == 0 {
                    param :: pkg_bytes_text(bytes, start, index)
                    if param.trim() == "" -> return None
                    &params.push(param)
                    start = index + 1
                }
            }
            else -> {}
        }
    }
    last :: pkg_bytes_text(bytes, start, bytes.len())
    if depth != 0 || last.trim() == "" -> return None
    &params.push(last)
    Val(params)
}

// The base type name, struct tag, and pointer depth a C type spells;
// qualifiers and integer modifiers are ignored.
fn pkg_opaque_parse_type_shape(raw: String) -> OpaqueCTypeShape Never! {
    shape := OpaqueCTypeShape{base: None, struct_tag: None, pointer_depth: 0}
    previous_struct := false
    loop token in pkg_opaque_tokenize(raw) {
        if token == {
            "*" -> shape.pointer_depth += 1
            "const" | "volatile" | "restrict" | "register" | "extern" | "unsigned" | "signed" | "long" | "short" -> {}
            "struct" -> previous_struct = true
            else -> {
                if pkg_opaque_is_ident(token) {
                    if previous_struct {
                        shape.struct_tag = Val(~token)
                        previous_struct = false
                    }
                    shape.base = Val(token)
                }
            }
        }
    }
    shape
}

// ASCII identifier runs plus `* ( ) { } [ ]`; everything else separates.
fn pkg_opaque_tokenize(text: String) -> [String] Never! {
    bytes :: text.bytes()
    tokens := [String]{}
    start := -1
    loop index in 0..<bytes.len() {
        code :: Int.from_u8(bytes[index])
        if pkg_bytes_is_word(code) {
            if start < 0 -> start = index
            next
        }
        if start >= 0 {
            &tokens.push(pkg_bytes_text(bytes, start, index))
            start = -1
        }
        if code == {
            42 | 40 | 41 | 123 | 125 | 91 | 93 -> &tokens.push(pkg_bytes_text(bytes, index, index + 1))
            else -> {}
        }
    }
    if start >= 0 -> &tokens.push(pkg_bytes_text(bytes, start, bytes.len()))
    tokens
}

// Declarations end at a `;` outside braces; text after the last one is
// dropped.
fn pkg_opaque_split_declarations(text: String) -> [String] Never! {
    bytes :: text.bytes()
    declarations := [String]{}
    start := 0
    depth := 0
    loop index in 0..<bytes.len() {
        code :: Int.from_u8(bytes[index])
        if code == {
            123 -> depth += 1
            125 -> depth -= 1
            59 -> {
                if depth == 0 {
                    &declarations.push(pkg_bytes_text(bytes, start, index))
                    start = index + 1
                }
            }
            else -> {}
        }
    }
    declarations
}

// Drop block comments (each becomes one space), line comments, and
// preprocessor directives with their `\` continuation lines. Kept lines end
// in LF.
fn pkg_opaque_strip_comments_and_directives(text: String) -> String Never! {
    bytes :: text.bytes()
    kept := [U8]{}
    index := 0
    loop index < bytes.len() {
        code :: Int.from_u8(bytes[index])
        next_code :: pkg_bytes_code(bytes, index + 1)
        if {
            code == 47 && next_code == 42 -> {
                index += 2
                loop index + 1 < bytes.len() && !(Int.from_u8(bytes[index]) == 42 && Int.from_u8(bytes[index + 1]) == 47) -> index += 1
                index = if index + 2 < bytes.len() -> index + 2 else -> bytes.len()
                &kept.push(U8{32})
            }
            code == 47 && next_code == 47 -> {
                index += 2
                loop index < bytes.len() && Int.from_u8(bytes[index]) != 10 -> index += 1
            }
            else -> {
                &kept.push(bytes[index])
                index += 1
            }
        }
    }
    content :: pkg_bytes_text(kept, 0, kept.len())
    segments :: content.split("\n").to_list()
    // `str::lines`: a final LF ends the last line, and a CR is dropped only
    // before an LF.
    ends_with_newline :: content.ends_with("\n")
    count :: if ends_with_newline -> segments.len() - 1 else -> segments.len()
    out := [String]{}
    continued := false
    loop position in 0..<count {
        line :: if position < segments.len() - 1 -> pkg_opaque_without_trailing_cr(segments[position]) else -> segments[position]
        if continued || line.trim_start().starts_with("#") {
            continued = line.trim_end().ends_with("\\")
            next
        }
        &out.push("{line}\n")
    }
    out.join("")
}

fn pkg_opaque_without_trailing_cr(line: String) -> String Never! {
    bytes :: line.bytes()
    if bytes.len() > 0 && Int.from_u8(bytes[bytes.len() - 1]) == 13 -> return pkg_bytes_text(bytes, 0, bytes.len() - 1)
    ~line
}

// `preferred`, or `preferred_2`, `preferred_3`, … when taken.
fn pkg_opaque_unique_name(used: &[String], preferred: String) -> String Never! {
    if !used.contains(preferred) {
        &used.push(~preferred)
        return ~preferred
    }
    suffix := 2
    loop {
        candidate :: "{preferred}_{suffix}"
        if !used.contains(candidate) {
            &used.push(~candidate)
            return candidate
        }
        suffix += 1
    }
}

// An ASCII C identifier.
fn pkg_opaque_is_ident(value: String) -> Bool Never! {
    bytes :: value.bytes()
    if bytes.len() == 0 -> return false
    first :: Int.from_u8(bytes[0])
    if first >= 48 && first <= 57 -> return false
    loop byte in bytes {
        if !pkg_bytes_is_word(Int.from_u8(byte)) -> return false
    }
    true
}
