// Rust: crates/jet-pkg-model/src/PowerShellBind.rs:525
// Drain all bytes even after the retained prefix is full, so a writer cannot block.
fn drain(input: &std.io.Read, limit: Int) -[IO]> [U8] ForeignBindError! {
    out := [U8]{}
    buf := [U8; 8192]{0}
    loop {
        // GATE #4494: native reader, bounded stack buffer.
        n :: input.read(&buf) catch e {
            return Err(ForeignBindError.IO("could not read foreign tool output: {e}"))
        }
        if n == 0 -> break
        keep :: (limit - out.len()).min(n)
        &out.extend(buf[0..<keep])
    }
    out
}

