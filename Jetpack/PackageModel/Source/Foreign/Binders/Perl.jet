// Persistent supervised Perl binder (D-FFI-PERL1=A), ported from
// jet_pkg_model::PerlBind.

// The persistent worker. Hole: `allowed`, one `'Name' => 1` row per sub.
@PKG_PERL_WORKER :: ```use strict;
use warnings;
use JSON::PP ();
use IO::Handle ();
binmode(STDIN);
binmode(STDOUT);
my %allowed = (
@@allowed@@
);
my $script = $ARGV[0];
my $loaded = do $script;
die "load failed" if !defined($loaded);
my $json = JSON::PP->new->allow_nonref(1);

sub read_exact {
    my ($length) = @_;
    my $value = '';
    while (length($value) < $length) {
        my $read = read(STDIN, my $part, $length - length($value));
        return undef if !defined($read) || $read == 0;
        $value .= $part;
    }
    return $value;
}

print STDOUT pack('V', 5), 'READY';
STDOUT->flush();
while (1) {
    my $header = read_exact(4);
    last if !defined($header);
    my $length = unpack('V', $header);
    last if $length < 1 || $length > 1048576;
    my $payload = read_exact($length);
    last if !defined($payload);
    my ($request, $response);
    eval {
        $request = $json->decode($payload);
        die "invalid request" if ref($request) ne 'HASH';
        last if ($request->{op} // '') eq 'shutdown';
        my $command = $request->{command} // '';
        die "rejected command" if ($request->{op} // '') ne 'invoke' || !$allowed{$command};
        no strict 'refs';
        my $value = &{$command}($request->{input});
        $response = { id => $request->{id}, ok => JSON::PP::true, value => $value };
    };
    if ($@) {
        my $id = ref($request) eq 'HASH' ? ($request->{id} // 0) : 0;
        $response = { id => $id, ok => JSON::PP::false, code => 'CommandFailed', value => undef };
    }
    my $encoded = eval { $json->canonical(1)->encode($response) };
    last if !defined($encoded) || length($encoded) > 1048576;
    my $id = $response->{id} // 0;
    my $low = $id % 4294967296;
    my $high = int($id / 4294967296);
    print STDOUT pack('V', length($encoded)), pack('V2', $low, $high), $encoded;
    STDOUT->flush();
}
```

@PKG_PERL_RESERVED :: [String]{"open", "cancel", "close", "decode_response", "Session", "PerlError"}

// A discovered sub: its Perl name (the worker's lookup key) and its
// snake-cased Jet name.
struct PerlBoundFunction {
    perl: String
    jet: String
}

// Bind the named top-level subs of the Perl script at `path`.
pub fn pkg_perl_bind(path: String, source: String, lib: String, cache: String) -[FS, Env, Exec, Time.Wait]> ForeignBindResult ForeignBindError! {
    language :: WorkerLanguage.Perl
    pkg_worker_require_supported_host(language, pkg_binder_host_is_unix())
    pkg_binder_require_lib_name(lib)
    perl :: pkg_bridge_tool_path("perl") ?? return Err(ForeignBindError.ToolMissing("perl"))
    script :: pkg_binder_canonicalize(path, "could not resolve the Perl script")
    build :: pkg_worker_prepare_build(cache, "perl", lib, "Perl")
    // Discovery is deliberately source-only. `perl -c` executes BEGIN/CHECK
    // blocks and `use` imports, so it is not a safe parser for attacker-owned
    // binding input. The worker remains the explicit runtime boundary after a
    // binding has been generated.
    functions :: pkg_perl_parse_function_names(source.bytes())
    worker_source :: pkg_perl_render_worker(functions)
    worker_file :: files.join(cache, "{lib}_worker.pl")
    pkg_binder_write(worker_file, worker_source, "could not write Perl worker")
    worker :: pkg_binder_canonicalize(worker_file, "could not resolve the Perl worker")
    abi :: "jet_perl_{lib}"
    wrappers := [String]{}
    loop function in functions -> &wrappers.push(pkg_worker_invoke_wrapper(abi, function.jet, "invoke", function.perl))
    bridge :: pkg_worker_render_supervisor_c(abi, perl, worker, script, wrappers.join(""), "worker_path,script_path")
    archive :: pkg_worker_build_archive(language, abi, build, cache, bridge, "could not write Perl process bridge")
    digest :: pkg_binder_identity_digest([String]{"jet-perl-bind-v1", source, script, perl, worker_source})
    provenance := "schema=jet-perl-bind-v1\nsha256={digest}\nperl={perl}\nscript={script}\nworker={worker}\n"
    pkg_binder_append_artifact_boundary(&provenance, ForeignLanguage.Perl, "Perl", lib, script, archive, "perl={perl};{pkg_binder_cc_ar_identity()}")
    bound := [String]{}
    loop function in functions -> &bound.push(function.jet)
    result :: ForeignBindResult{source: pkg_perl_render_jet(lib, functions), bound: bound, archive: archive, provenance: provenance}
    pkg_binder_remove_tree_quiet(build)
    Ok(result)
}

// Source-only discovery of `sub Name` declarations; never runs Perl.
fn pkg_perl_parse_function_names(bytes: [U8]) -> [PerlBoundFunction] ForeignBindError! {
    text :: String.from_bytes(bytes) ?? return Err(ForeignBindError.Source("Perl source is not UTF-8"))
    pkg_perl_validate_structure(text)
    out := [PerlBoundFunction]{}
    loop raw_line in pkg_binder_lines(text) {
        line :: raw_line.trim_start()
        if !line.starts_with("sub") -> next
        after :: line.removeprefix("sub")
        after_bytes :: after.bytes()
        if after_bytes.len() == 0 || pkg_bytes_space_width(after_bytes, 0) == 0 || Int.from_u8(after_bytes[0]) > 127 -> next
        rest :: after.trim_start()
        rest_bytes :: rest.bytes()
        name_len := 0
        loop name_len < rest_bytes.len() && pkg_bytes_is_word(Int.from_u8(rest_bytes[name_len])) -> name_len += 1
        name :: pkg_bytes_text(rest_bytes, 0, name_len)
        if name == "" -> return Err(ForeignBindError.Source("a Perl sub declaration needs a named function"))
        tail :: pkg_bytes_text(rest_bytes, name_len, rest_bytes.len()).trim_start().bytes()
        opener :: pkg_bytes_code(tail, 0)
        if opener != 40 && opener != 123 && opener != 58 -> return Err(ForeignBindError.Source("Perl function `{name}` has an unsupported declaration"))
        if !pkg_binder_is_ident(name) -> return Err(ForeignBindError.Source("Perl function `{name}` cannot be projected as a Jet identifier"))
        jet :: pkg_perl_snake(name)
        if pkg_perl_reserved(jet) -> return Err(ForeignBindError.Source("Perl function `{name}` projects to reserved Jet name `{jet}`"))
        loop existing in out {
            if existing.jet == jet -> return Err(ForeignBindError.Source("Perl function `{name}` collides with another generated Jet function `{jet}`"))
        }
        &out.push(PerlBoundFunction{perl: name, jet: jet})
    }
    if out.len() == 0 -> return Err(ForeignBindError.Source("no top-level named Perl functions were found"))
    Ok(out)
}

// Balanced brackets outside quotes and `#` comments.
fn pkg_perl_validate_structure(source: String) ForeignBindError! {
    stack := [Int]{}
    quote := 0
    escaped := false
    comment := false
    loop byte in source.bytes() {
        code :: Int.from_u8(byte)
        if comment {
            if code == 10 -> comment = false
            next
        }
        if quote != 0 {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == quote -> quote = 0
                else -> {}
            }
            next
        }
        if code == {
            35 -> comment = true
            39 | 34 | 96 -> quote = code
            40 | 91 | 123 -> &stack.push(code)
            41 | 93 | 125 -> {
                expected :: if code == {
                    41 -> 40
                    93 -> 91
                    else -> 123
                }
                if stack.len() == 0 || &stack.pop() != expected -> return Err(ForeignBindError.Source("the script has a Perl parse error"))
            }
            else -> {}
        }
    }
    if quote != 0 || stack.len() != 0 -> return Err(ForeignBindError.Source("the script has a Perl parse error"))
    Ok()
}

fn pkg_perl_render_worker(functions: [PerlBoundFunction]) -> String Never! {
    allowed := [String]{}
    loop function in functions -> &allowed.push("    '{function.perl.replace("'", "\\'")}' => 1")
    pkg_binder_fill_template(@PKG_PERL_WORKER, [String: String]{"allowed": allowed.join(",\n")})
}

fn pkg_perl_render_jet(lib: String, functions: [PerlBoundFunction]) -> String Never! {
    abi :: "jet_perl_{lib}"
    out := [String]{"#Import module c.{abi} {{\n    fn open() -> Int = \"{abi}_open\"\n    fn take_error() -> Int = \"{abi}_take_error\"\n    fn cancel(handle: Int) = \"{abi}_cancel\"\n    fn close(handle: Int) = \"{abi}_close\"\n"}
    loop function in functions {
        name :: function.jet
        &out.push("    fn {name}(handle: Int, input: String, deadline_ms: Int) -> String = \"{abi}_invoke_{name}\"\n")
    }
    &out.push("}}\nuse c.{abi} as abi\nuse core.encoding.json as json\n\npub struct Session {{ value: Int }}\n#Error\npub enum PerlError {{ NotRunning Timeout Cancelled Protocol CommandFailed Limit }}\n\nimpl Session.Close {{\n    fn close(^self) {{ abi.close(self.value) }}\n}}\n\npub fn close(^session: Session) -[FFI.Perl]> {{ abi.close(session.value) }}\n\npub fn open() -[FFI.Perl]> Session !PerlError {{\n    handle :: abi.open()\n    if abi.take_error() != 0 {{ return Err(PerlError.NotRunning) }}\n    return Ok(Session{{ value: handle }})\n}}\n\npub fn cancel(session: Session) -[FFI.Perl]> {{ abi.cancel(session.value) }}\n\n")
    &out.push(pkg_render_decode_response("PerlError", DecoderProtocol.StandardEnvelope))
    loop function in functions {
        name :: function.jet
        &out.push("pub fn {name}(session: Session, input: DataTree, deadline_ms: Int) -[FFI.Perl]> DataTree !PerlError {{\n    raw :: abi.{name}(session.value, json.to_string(input), deadline_ms)\n    code :: abi.take_error()\n    return decode_response(raw, code)\n}}\n\n")
    }
    out.join("")
}

// The generated surface for the binder registry's rendering probe.
pub fn pkg_perl_render_probe() -> String Never! {
    pkg_perl_render_jet("registry", [PerlBoundFunction]{PerlBoundFunction{perl: "Transform", jet: "transform"}})
}

// `FooBar` -> `foo_bar`: an `_` before every non-leading ASCII capital.
fn pkg_perl_snake(value: String) -> String Never! {
    out := [String]{}
    index := 0
    loop scalar in value.chars() {
        text :: "{scalar}"
        code :: pkg_bytes_code(text.bytes(), 0)
        if code >= 65 && code <= 90 && index > 0 -> &out.push("_")
        &out.push(pkg_ascii_lower(text))
        index += 1
    }
    out.join("")
}

fn pkg_perl_reserved(value: String) -> Bool Never! {
    @PKG_PERL_RESERVED.contains(value) || @JET_KEYWORD_LIST.contains(value) || @JET_TYPE_LIST.contains(value)
}
