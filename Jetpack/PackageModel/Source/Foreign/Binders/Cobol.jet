// GnuCOBOL C-ABI and copybook binder (D-FFI-COBOL1=A), ported from
// jet_pkg_model::CobolBind.
//
// The accepted copybook subset is deliberately closed: fixed text, native
// binary integers, and packed decimal. Unknown clauses fail binding rather
// than guessing a wire layout. COMP-3 is surfaced as Jet Decimal metadata;
// the callable bridge uses scaled minor units because Decimal is not a C ABI
// scalar.

@COBOL_BIND_SCHEMA :: "jet-cobol-bind-v1"
@COBOL_TOOL_ACTION :: "rejected the COBOL binding"

pub struct CobolBindResult {
    pub source: String
    pub archive: String
    pub runtime_dir: String
    pub program: String
    pub layout: CobolRecordLayout
    pub provenance: String
}

// One level 01 record and its level 05 fields in declaration order.
pub struct CobolRecordLayout {
    pub name: String
    pub width: Int
    pub fields: [CobolFieldLayout]
}

pub struct CobolFieldLayout {
    pub name: String
    pub offset: Int
    pub width: Int
    pub kind: CobolFieldKind
}

pub enum CobolFieldKind {
    FixedText(characters: Int)
    NativeInt(digits: Int, signed: Bool)
    PackedDecimal(digits: Int, scale: Int, signed: Bool)

    pub fn jet_type(self) -> String Never! {
        if self == {
            .FixedText(_) -> "String"
            .NativeInt(_, _) -> "Int"
            .PackedDecimal(_, _, _) -> "Decimal"
        }
    }

    // Rust's derived `Debug` spelling, recorded in layout provenance.
    fn debug(self) -> String Never! {
        if self == {
            .FixedText(characters) -> "FixedText {{ characters: {characters} }}"
            .NativeInt(digits, signed) -> "NativeInt {{ digits: {digits}, signed: {signed} }}"
            .PackedDecimal(digits, scale, signed) -> "PackedDecimal {{ digits: {digits}, scale: {scale}, signed: {signed} }}"
        }
    }

    // The byte width the kind occupies in the record.
    fn width(self) -> Int ForeignBindError! {
        if self == {
            .FixedText(characters) -> Ok(characters)
            .NativeInt(digits, _) -> {
                if {
                    digits <= 4 -> Ok(2)
                    digits <= 9 -> Ok(4)
                    digits <= 18 -> Ok(8)
                    else -> Err(ForeignBindError.Source("COMP-5 fields may contain at most 18 digits"))
                }
            }
            .PackedDecimal(digits, _, _) -> Ok((digits + 2) / 2)
        }
    }

    fn is_packed(self) -> Bool Never! {
        if self == {
            .PackedDecimal(_, _, _) -> true
            else -> false
        }
    }

    fn is_native_int(self) -> Bool Never! {
        if self == {
            .NativeInt(_, _) -> true
            else -> false
        }
    }
}

// Compile the program with cobc, prove the C bridge links against libcob,
// archive both objects, and render the Jet binding with provenance.
pub fn pkg_cobol_bind(source_path: String, source: String, copybook_path: String, copybook: String, lib: String, cache: String) -[FS, Env, Exec, Time.Wait]> CobolBindResult ForeignBindError! {
    if !pkg_binder_is_ident(lib) -> return Err(ForeignBindError.Source("`{lib}` is not a valid Jet library name"))
    program :: pkg_cobol_parse_program_id(source)
    layout :: pkg_cobol_parse_copybook(copybook)
    packed := [CobolFieldLayout]{}
    loop field in layout.fields {
        if field.kind.is_packed() -> &packed.push(field)
    }
    if packed.len() != 1 -> return Err(ForeignBindError.Source("the callable v1 bridge requires exactly one COMP-3 field"))
    input := None
    loop field in layout.fields {
        if field.kind.is_native_int() {
            input = Val(field)
            break
        }
    }
    pkg_binder_create_dir_all(cache, "could not create binding cache")
    stem :: "jet_cobol_{lib}"
    object :: files.join(cache, "{stem}_program.o")
    bridge_c :: files.join(cache, "{stem}_bridge.c")
    bridge_o :: files.join(cache, "{stem}_bridge.o")
    archive :: files.join(cache, "lib{stem}.a")
    probe_c :: files.join(cache, "{stem}_probe.c")
    probe :: files.join(cache, "{stem}_probe")
    copy_dir :: files.dirname(copybook_path)
    pkg_cobol_run([String]{"cobc", "-c", "-I", copy_dir, source_path, "-o", object}, "cobc")
    config :: pkg_cobol_checked_output([String]{"cob-config", "--cflags"}, "cob-config")
    cflags :: pkg_binder_words(String.from_bytes_lossy(config.stdout))
    libs :: pkg_cobol_checked_output([String]{"cob-config", "--libs"}, "cob-config")
    runtime_flags :: pkg_binder_words(String.from_bytes_lossy(libs.stdout))
    runtime_dir :: pkg_cobol_runtime_dir_from_flags(runtime_flags) ?? return Err(ForeignBindError.Source("cob-config did not report an absolute libcob directory"))
    pkg_binder_write(bridge_c, pkg_cobol_render_bridge(program, layout, packed[0], input, lib), "could not write the COBOL C bridge")
    compile := [String]{"cc", "-c", "-fPIC"}
    loop flag in cflags -> &compile.push(flag)
    &compile.push(bridge_c)
    &compile.push("-o")
    &compile.push(bridge_o)
    pkg_cobol_run(compile, "cc")
    pkg_binder_write(probe_c, "int main(void) {{ return 0; }}\n", "could not write the COBOL link probe")
    link := [String]{"cc", "-Wl,--no-undefined", object, bridge_o, probe_c}
    loop flag in runtime_flags -> &link.push(flag)
    tail :: [String]{"-pthread", "-ldl", "-lm", "-o", probe}
    loop flag in tail -> &link.push(flag)
    if pkg_cobol_prove_link(link) == {
        .Ok(_) -> {}
        .Err(error) -> {
            pkg_cobol_remove_scratch([String]{object, bridge_o, bridge_c, probe_c, probe})
            return Err(error)
        }
    }
    pkg_cobol_run([String]{"ar", "rcs", archive, object, bridge_o}, "ar")
    pkg_cobol_remove_scratch([String]{object, bridge_o, bridge_c, probe_c, probe})
    generated_source :: pkg_cobol_render_jet(lib, layout, packed[0], input)
    provenance :: pkg_cobol_render_provenance(source_path, source, generated_source, copybook_path, copybook, program, layout, runtime_dir, archive, lib)
    Ok(CobolBindResult{source: generated_source, archive: archive, runtime_dir: runtime_dir, program: program, layout: layout, provenance: provenance})
}

fn pkg_cobol_remove_scratch(paths: [String]) -[FS]> {
    loop path in paths -> pkg_binder_remove_file_quiet(path)
}

// Parse the closed copybook subset: one level 01 record of level 05 PIC
// fields laid out back to back.
pub fn pkg_cobol_parse_copybook(source: String) -> CobolRecordLayout ForeignBindError! {
    record := None
    fields := [CobolFieldLayout]{}
    names := [String]{}
    offset := 0
    loop raw in pkg_binder_lines(source) {
        line :: pkg_cobol_copybook_line(raw) ?? next
        words :: pkg_binder_words(line)
        if words.len() < 2 -> return Err(ForeignBindError.Source("unsupported copybook declaration `{line}`; use level 01 with level 05 PIC fields"))
        if words[0] == "01" {
            if record != None -> return Err(ForeignBindError.Source("copybook must contain exactly one level 01 record"))
            if words.len() != 2 -> return Err(ForeignBindError.Source("unsupported level 01 declaration `{line}`; use one record name only"))
            name :: pkg_cobol_jet_name(words[1])
            if !pkg_binder_is_ident(name) || name == "_" || name.starts_with("__") -> return Err(ForeignBindError.Source("copybook record name `{words[1]}` is not a valid Jet identifier"))
            record = Val(name)
            next
        }
        if words[0] != "05" || record == None -> return Err(ForeignBindError.Source("unsupported copybook declaration `{line}`; use level 01 with level 05 PIC fields"))
        name :: pkg_cobol_jet_name(words[1])
        if !pkg_binder_is_ident(name) || name == "_" || name.starts_with("__") || foundation_is_reserved_generated_name(name) || names.contains(name) {
            return Err(ForeignBindError.Source("copybook field name `{words[1]}` is not a unique, usable Jet identifier"))
        }
        &names.push(name)
        if words.len() < 3 || pkg_binder_ascii_upper(words[2]) != "PIC" -> return Err(ForeignBindError.Source("copybook field `{words[1]}` must use a PIC clause"))
        if words.len() < 4 -> return Err(ForeignBindError.Source("copybook field `{words[1]}` has no PIC shape"))
        pic :: pkg_binder_ascii_upper(words[3])
        clauses := [String]{}
        loop index in 4..<words.len() -> &clauses.push(pkg_binder_ascii_upper(words[index]))
        kind :: pkg_cobol_parse_pic(pic, clauses)
        width :: kind.width()
        &fields.push(CobolFieldLayout{name: name, offset: offset, width: width, kind: kind})
        offset = offset + width
    }
    name :: record ?? return Err(ForeignBindError.Source("copybook has no level 01 record"))
    if fields.len() == 0 -> return Err(ForeignBindError.Source("copybook record has no level 05 fields"))
    if foundation_is_reserved_generated_name(pkg_cobol_upper_camel(name)) -> return Err(ForeignBindError.Source("copybook record name `{name}` projects to a reserved Jet type"))
    Ok(CobolRecordLayout{name: name, width: offset, fields: fields})
}

fn pkg_cobol_parse_pic(pic: String, clauses: [String]) -> CobolFieldKind ForeignBindError! {
    if pic.starts_with("X(") && pic.ends_with(")") {
        if pkg_cobol_parse_count(pic.removeprefix("X(").removesuffix(")")) == {
            .Val(count) -> {
                if clauses.len() == 0 && count > 0 -> return Ok(CobolFieldKind.FixedText{characters: count})
            }
            .None -> {}
        }
    }
    signed :: pic.starts_with("S")
    numeric :: pic.removeprefix("S")
    split :: numeric.split_once("V")
    whole :: split?.before ?? numeric
    fraction :: split?.after
    whole_digits :: pkg_cobol_pic_digits(whole)
    fraction_digits :: pkg_cobol_pic_digits(fraction ?? "")
    scale :: pkg_cobol_pic_digits(fraction ?? "") ?? 0
    if whole_digits == None || fraction_digits == None -> return Err(ForeignBindError.Source("unsupported PIC shape `{pic}`"))
    digits :: (whole_digits ?? 0) + (fraction_digits ?? 0)
    if clauses.len() == 1 && clauses[0] == "COMP-3" {
        if digits == 0 || digits > 18 -> return Err(ForeignBindError.Source("COMP-3 fields may contain 1 to 18 digits for the Int minor-unit bridge"))
        return Ok(CobolFieldKind.PackedDecimal{digits: digits, scale: scale, signed: signed})
    }
    if clauses.len() == 1 && clauses[0] == "COMP-5" && scale == 0 {
        if digits == 0 || digits > 18 -> return Err(ForeignBindError.Source("COMP-5 fields may contain 1 to 18 digits for the Int bridge"))
        return Ok(CobolFieldKind.NativeInt{digits: digits, signed: signed})
    }
    Err(ForeignBindError.Source("unsupported PIC/usage `{pic} {clauses.join(" ")}`; use X(n), COMP-5, or COMP-3"))
}

// `9`, `999`, or `9(n)`; the empty shape has no digits.
fn pkg_cobol_pic_digits(shape: String) -> Int? Never! {
    if shape == "" -> return Val(0)
    all_nines := true
    loop byte in shape.bytes() {
        if Int.from_u8(byte) != 57 -> all_nines = false
    }
    if all_nines -> return Val(shape.bytes().len())
    if !shape.starts_with("9(") || !shape.ends_with(")") -> return None
    pkg_cobol_parse_count(shape.removeprefix("9(").removesuffix(")"))
}

// A non-negative decimal count (`usize::from_str`).
fn pkg_cobol_parse_count(text: String) -> Int? Never! {
    digits :: text.removeprefix("+")
    if digits == "" -> return None
    loop byte in digits.bytes() {
        if !pkg_binder_is_ascii_digit(Int.from_u8(byte)) -> return None
    }
    Int.parse(digits) ?? None
}

// The code part of one copybook line, or None for blank lines and comments.
// Fixed-format lines keep columns 8 onward when they hold a level number.
fn pkg_cobol_copybook_line(raw: String) -> String? Never! {
    trimmed :: raw.trim()
    if trimmed == "" || trimmed.starts_with("*") -> return None
    bytes :: raw.bytes()
    if bytes.len() > 6 {
        indicator :: Int.from_u8(bytes[6])
        if indicator == 42 || indicator == 47 -> return None
        fixed :: pkg_bytes_text(bytes, 6, bytes.len()).trim()
        first :: pkg_binder_words(fixed)
        if first.len() > 0 && (first[0] == "01" || first[0] == "05") -> return Val(pkg_cobol_code_text(fixed))
    }
    Val(pkg_cobol_code_text(trimmed))
}

fn pkg_cobol_code_text(line: String) -> String Never! {
    code :: line.split_once("*>")?.before ?? line
    pkg_binder_trim_end_matches(code.trim(), ".").trim()
}

// The first `-L` search directory cob-config reports, when absolute.
fn pkg_cobol_runtime_dir_from_flags(flags: [String]) -> String? Never! {
    loop index in 0..<flags.len() {
        flag :: flags[index]
        found := None
        if flag.starts_with("-L") && flag != "-L" -> found = Val(flag.removeprefix("-L"))
        if flag == "-L" && index + 1 < flags.len() -> found = Val(flags[index + 1])
        if found == {
            .Val(path) -> {
                if files.is_abs(path) -> return Val(path)
                return None
            }
            .None -> {}
        }
    }
    None
}

// A failed link probe is an ABI mismatch, not a tool rejection.
fn pkg_cobol_prove_link(argv: [String]) ForeignBindError! -[Exec, Time.Wait]> {
    if pkg_cobol_run(argv, "cc") == {
        .Ok(_) -> Ok()
        .Err(error) -> {
            if error == {
                .ToolFailed(_, _, detail) -> Err(ForeignBindError.AbiMismatch(detail))
                else -> Err(error)
            }
        }
    }
}

fn pkg_cobol_render_provenance(source_path: String, foreign_source: String, generated_source: String, copybook_path: String, copybook: String, program: String, layout: CobolRecordLayout, runtime_dir: String, archive: String, lib: String) -[FS, Env, Exec]> String ForeignBindError! {
    descriptor :: pkg_cobol_descriptor_stamp()
    program_symbol :: pkg_cobol_c_symbol(program)
    facts := [String]{}
    loop field in layout.fields -> &facts.push("{field.name}:{field.offset}:{field.width}:{field.kind.debug()}")
    layout_facts :: facts.join(",")
    identity := ForeignIdentityBuilder.new(@COBOL_BIND_SCHEMA)
    &identity.field("descriptor", descriptor.bytes())
    &identity.field("source", foreign_source.bytes())
    &identity.field("generated", generated_source.bytes())
    &identity.field("copybook", copybook.bytes())
    &identity.field("program", program.bytes())
    &identity.field("program_symbol", program_symbol.bytes())
    &identity.field("layout", layout_facts.bytes())
    &identity.field("runtime", runtime_dir.bytes())
    archive_bytes :: pkg_binder_read_bytes(archive, "could not read the COBOL archive for provenance")
    provenance := "schema={@COBOL_BIND_SCHEMA}\nidentity={identity.finish()}\ndescriptor={descriptor}\nabi=C\nprogram={program}\nprogram_symbol={program_symbol}\nsource_path={source_path}\nsource_sha256={pkg_sha256_hex(foreign_source.bytes())}\ngenerated_sha256={pkg_sha256_hex(generated_source.bytes())}\ncopybook_path={copybook_path}\ncopybook_sha256={pkg_sha256_hex(copybook.bytes())}\nrecord={layout.name}\nrecord_width={layout.width}\nfields={layout_facts}\nruntime={runtime_dir}\narchive_sha256={pkg_sha256_hex(archive_bytes)}\n"
    pkg_binder_append_artifact_boundary(&provenance, ForeignLanguage.Cobol, "COBOL", lib, source_path, archive, "cobc/cc/ar")
    Ok(provenance)
}

// The first valid `PROGRAM-ID.` name, kept in GnuCOBOL's uppercase spelling.
fn pkg_cobol_parse_program_id(source: String) -> String ForeignBindError! {
    loop raw in pkg_binder_lines(source) {
        trimmed :: raw.trim()
        if trimmed == "" || trimmed.starts_with("*") -> next
        bytes :: raw.bytes()
        if bytes.len() > 6 && (Int.from_u8(bytes[6]) == 42 || Int.from_u8(bytes[6]) == 47) -> next
        code :: (trimmed.split_once("*>")?.before ?? trimmed).trim()
        upper :: pkg_binder_ascii_upper(code)
        if !upper.starts_with("PROGRAM-ID.") -> next
        words :: pkg_binder_words(upper.removeprefix("PROGRAM-ID."))
        if words.len() == 0 -> next
        name :: pkg_binder_trim_end_matches(words[0], ".")
        if name != "" && pkg_cobol_is_program_name(name) -> return Ok(name)
    }
    Err(ForeignBindError.Source("source has no valid PROGRAM-ID"))
}

fn pkg_cobol_is_program_name(name: String) -> Bool Never! {
    loop scalar in name.chars() {
        bytes :: "{scalar}".bytes()
        if bytes.len() != 1 -> return false
        code :: Int.from_u8(bytes[0])
        if !pkg_bytes_is_word(code) && code != 45 -> return false
    }
    true
}

fn pkg_cobol_render_jet(lib: String, layout: CobolRecordLayout, packed: CobolFieldLayout, input: CobolFieldLayout?) -> String Never! {
    abi :: "jet_cobol_{lib}"
    descriptor :: pkg_cobol_descriptor_stamp()
    out := "// jet-ffi-descriptor={descriptor}\n// cobol-layout {layout.name}: {layout.width} bytes\n"
    loop field in layout.fields {
        encoding :: if field.kind == {
            .PackedDecimal(_, scale, _) -> " scale={scale} encoding=COMP-3"
            .NativeInt(_, _) -> " encoding=COMP-5"
            .FixedText(_) -> " encoding=fixed-text"
        }
        out = "{out}// cobol-field {field.name}: offset={field.offset} width={field.width} type={field.kind.jet_type()}{encoding}\n"
    }
    out = "{out}#Codable\npub struct {pkg_cobol_upper_camel(layout.name)} {{\n"
    loop field in layout.fields -> out = "{out}    {field.name}: {field.kind.jet_type()}\n"
    out = "{out}}}\n\n"
    record_param :: if input != None -> "record_id: Int, " else -> ""
    record_arg :: if input != None -> "record_id, " else -> ""
    out = "{out}#Import module c.{abi} {{\n    fn apply_minor({record_param}{packed.name}_minor: Int) Int = \"{abi}_apply_minor\"\n}}\nuse c.{abi} as abi\n\npub enum CobolError {{ Range ProgramFailed }}\n\n"
    out = "{out}pub fn apply_minor({record_param}{packed.name}_minor: Int) -[FFI.Cobol]> Int !CobolError {{\n"
    if packed.kind == {
        .PackedDecimal(digits, _, signed) -> {
            max :: pkg_cobol_max_digits(digits)
            min :: if signed -> -max else -> 0
            out = "{out}    if {packed.name}_minor < {min} || {packed.name}_minor > {max} -> return Err(CobolError.Range)\n"
        }
        else -> {}
    }
    if input == {
        .Val(field) -> {
            if field.kind == {
                .NativeInt(digits, signed) -> {
                    max :: pkg_cobol_max_digits(digits)
                    min :: if signed -> -max else -> 0
                    out = "{out}    if record_id < {min} || record_id > {max} -> return Err(CobolError.Range)\n"
                }
                else -> {}
            }
        }
        .None -> {}
    }
    out = "{out}    result :: abi.apply_minor({record_arg}{packed.name}_minor)\n"
    "{out}    if result == -9223372036854775808 -> return Err(CobolError.ProgramFailed)\n    return Ok(result)\n}}\n"
}

// `10^digits - 1`, the largest magnitude a field of `digits` digits holds.
fn pkg_cobol_max_digits(digits: Int) -> Int Never! {
    value := 1
    loop index in 0..<digits -> value = value * 10
    value - 1
}

fn pkg_cobol_render_bridge(program: String, layout: CobolRecordLayout, packed: CobolFieldLayout, input: CobolFieldLayout?, lib: String) -> String Never! {
    args :: if input != None -> "int64_t record_id, int64_t minor" else -> "int64_t minor"
    program_symbol :: pkg_cobol_c_symbol(program)
    pre := ""
    if input == {
        .Val(field) -> {
            cty :: if field.width == {
                2 -> "int16_t"
                4 -> "int32_t"
                else -> "int64_t"
            }
            pre = "  {cty} id = ({cty})record_id; memcpy(record + {field.offset}, &id, {field.width});\n"
        }
        .None -> {}
    }
    lines :: [String]{
        "#include <stdint.h>",
        "#include <string.h>",
        "#include <libcob.h>",
        "#include <pthread.h>",
        "extern int {program_symbol}(cob_u8_t *record);",
        "static pthread_once_t jet_cobol_once = PTHREAD_ONCE_INIT;",
        "static void jet_cobol_init(void) {{ cob_init(0, NULL); }}",
        "static void pack(int64_t value, unsigned char *out, size_t n) {{",
        "  uint64_t mag = value < 0 ? (uint64_t)(-(value + 1)) + 1 : (uint64_t)value;",
        "  memset(out, 0, n); out[n-1] = (unsigned char)(value < 0 ? 0x0d : 0x0c);",
        "  for (size_t pos = n * 2 - 1; pos > 0; --pos) {{ size_t nib = pos - 1; unsigned d=(unsigned)(mag%10); mag/=10; size_t b=nib/2; if(nib%2) out[b]|=(unsigned char)d; else out[b]|=(unsigned char)(d<<4); }}",
        "}}",
        "static int64_t unpack(const unsigned char *in, size_t n) {{",
        "  int64_t v=0; for(size_t nib=0;nib<n*2-1;++nib){{ unsigned d=(nib%2)?(in[nib/2]&15):(in[nib/2]>>4); v=v*10+(int64_t)d; }} return ((in[n-1]&15)==0x0d)?-v:v;",
        "}}",
        "int64_t jet_cobol_{lib}_apply_minor({args}) {{",
        "  cob_u8_t record[{layout.width}]; memset(record, ' ', sizeof record);",
        "{pre}  pack(minor, record + {packed.offset}, {packed.width});",
        "  if(pthread_once(&jet_cobol_once, jet_cobol_init)!=0) return INT64_MIN;",
        "  if({program_symbol}(record)!=0) return INT64_MIN;",
        "  return unpack(record + {packed.offset}, {packed.width});",
        "}}"
    }
    "{lines.join("\n")}\n"
}

fn pkg_cobol_run(argv: [String], tool: String) ForeignBindError! -[Exec, Time.Wait]> {
    pkg_cobol_checked_output(argv, tool)
    Ok()
}

fn pkg_cobol_checked_output(argv: [String], tool: String) -[Exec, Time.Wait]> BinderToolOutput ForeignBindError! {
    output :: pkg_binder_capture(argv, None, tool, @COBOL_TOOL_ACTION)
    if !output.success -> return Err(ForeignBindError.ToolFailed{tool: tool, action: @COBOL_TOOL_ACTION, detail: pkg_cobol_launder(output.stderr)})
    Ok(output)
}

fn pkg_cobol_launder(stderr: [U8]) -> String Never! {
    loop raw in pkg_binder_lines(String.from_bytes_lossy(stderr)) {
        line :: raw.trim()
        if line == "" -> next
        if line.split_once("error:") == {
            .Val(parts) -> {
                detail :: parts.after.trim()
                if detail != "" -> return "the foreign tool reported: {pkg_binder_take_chars(detail, 160)}"
            }
            .None -> {}
        }
        at :: pkg_binder_find(line, "undefined reference to", 0)
        if at >= 0 -> return "the linker reported: {pkg_binder_take_chars(pkg_binder_tail(line, at), 160)}"
    }
    @BINDER_TOOL_FAILURE_DETAIL
}

// GnuCOBOL's C entry symbol: `-` becomes `__`.
fn pkg_cobol_c_symbol(program: String) -> String Never! {
    &program.replace("-", "__")
}

fn pkg_cobol_jet_name(word: String) -> String Never! {
    pkg_ascii_lower(pkg_binder_trim_end_matches(word, ".")).replace("-", "_")
}

// Each `_`-separated part with its first character ASCII-uppercased.
fn pkg_cobol_upper_camel(name: String) -> String Never! {
    parts := [String]{}
    loop part in name.split("_") {
        if part == "" -> next
        first := ""
        rest := [String]{}
        loop scalar in part.chars() {
            if {
                first == "" && rest.len() == 0 -> first = pkg_binder_ascii_upper("{scalar}")
                else -> &rest.push("{scalar}")
            }
        }
        &parts.push("{first}{rest.join("")}")
    }
    parts.join("")
}

fn pkg_cobol_descriptor_stamp() -> String Never! {
    descriptor :: pkg_binder_descriptor(ForeignLanguage.Cobol) ?? panic("COBOL binder descriptor")
    descriptor.stamp()
}
