// Persistent supervised R binder (D-FFI-R1=A), ported from
// jet_pkg_model::RBind. Each function binds three ways: a DataTree call, a
// typed table call, and a sanitized SVG plot call.

@PKG_R_RESERVED :: [String]{"open", "cancel", "close", "decode_response", "Session", "RError"}

// The private scratch prefix the supervisor creates per worker for plots.
@PKG_R_PLOT_TEMP_PREFIX :: "/tmp/jet-r-plot-"

// Bind the top-level one-argument functions of the R script at `path`.
pub fn pkg_r_bind(path: String, source: String, lib: String, cache: String) -[FS, Env, Exec, Time.Wait]> ForeignBindResult ForeignBindError! {
    language :: WorkerLanguage.R
    pkg_worker_require_supported_host(language, pkg_binder_host_is_unix())
    pkg_binder_require_lib_name(lib)
    rscript :: pkg_binder_resolved_tool_path("Rscript") ?? return Err(ForeignBindError.ToolMissing("Rscript"))
    script :: pkg_binder_canonicalize(path, "could not resolve the R script")
    build :: pkg_worker_prepare_build(cache, "r", lib, "R")
    discoverer :: files.join(build, "jet_discover.R")
    pkg_binder_write(discoverer, @PKG_R_DISCOVERER, "could not write R binding inspector")
    metadata :: pkg_worker_run_tool([String]{rscript, "--vanilla", discoverer, script}, "Rscript", language, true)
    functions :: pkg_r_parse_function_names(metadata)
    worker_source :: pkg_r_render_worker(functions)
    worker_file :: files.join(cache, "{lib}_worker.R")
    pkg_binder_write(worker_file, worker_source, "could not write R worker")
    worker :: pkg_binder_canonicalize(worker_file, "could not resolve the R worker")
    abi :: "jet_r_{lib}"
    wrappers := [String]{}
    loop name in functions {
        &wrappers.push(pkg_worker_invoke_wrapper(abi, name, "invoke", name))
        &wrappers.push(pkg_worker_invoke_wrapper(abi, "{name}_table", "invoke", "__jet_table__{name}"))
        &wrappers.push(pkg_worker_invoke_wrapper(abi, "{name}_plot", "invoke", "__jet_plot__{name}"))
    }
    bridge :: pkg_worker_render_supervisor_c_with_temp(abi, rscript, worker, script, wrappers.join(""), "\"--vanilla\",worker_path,script_path", Val(@PKG_R_PLOT_TEMP_PREFIX))
    archive :: pkg_worker_build_archive(language, abi, build, cache, bridge, "could not write R process bridge")
    digest :: pkg_binder_identity_digest([String]{"jet-r-bind-v1", source, script, rscript, worker_source})
    provenance := "schema=jet-r-bind-v1\nsha256={digest}\nrscript={rscript}\nscript={script}\nworker={worker}\nworkers_per_session=1\nmax_sessions=32\ntransport=jsonlite\n"
    pkg_binder_append_artifact_boundary(&provenance, ForeignLanguage.R, "R", lib, script, archive, "Rscript={rscript};{pkg_binder_cc_ar_identity()}")
    result :: ForeignBindResult{source: pkg_r_render_jet(lib, functions), bound: functions, archive: archive, provenance: provenance}
    pkg_binder_remove_tree_quiet(build)
    Ok(result)
}

// Validate the parser's `N\t` / `E\tARG\t` rows and reject names that collide
// with a generated `_table` or `_plot` binding.
fn pkg_r_parse_function_names(bytes: [U8]) -> [String] ForeignBindError! {
    text :: String.from_bytes(bytes) ?? return Err(ForeignBindError.Source("R returned non-UTF-8 function metadata"))
    out := [String]{}
    loop line in pkg_binder_lines(text) {
        if line.starts_with("E\tARG\t") -> return Err(ForeignBindError.Source("R function `{line.removeprefix("E\tARG\t")}` must take one required positional argument"))
        if !line.starts_with("N\t") -> return Err(ForeignBindError.Source("R parser returned malformed function metadata"))
        name :: line.removeprefix("N\t")
        if !pkg_binder_is_ident(name) -> return Err(ForeignBindError.Source("R function `{name}` cannot be projected as a Jet identifier"))
        if pkg_r_reserved(name) -> return Err(ForeignBindError.Source("R function `{name}` uses a reserved generated binding name"))
        loop existing in out {
            if existing == name || existing == "{name}_table" || existing == "{name}_plot" -> return Err(ForeignBindError.Source("R function `{name}` collides with a generated binding name"))
        }
        loop existing in out {
            if "{existing}_table" == name -> return Err(ForeignBindError.Source("R function `{name}` collides with a generated table binding"))
        }
        loop existing in out {
            if "{existing}_plot" == name -> return Err(ForeignBindError.Source("R function `{name}` collides with a generated plot binding"))
        }
        &out.push(name)
    }
    if out.len() == 0 -> return Err(ForeignBindError.Source("no top-level named R functions were found"))
    Ok(out)
}

fn pkg_r_render_worker(functions: [String]) -> String Never! {
    allowed := [String]{}
    loop name in functions -> &allowed.push("  {name} = TRUE")
    pkg_binder_fill_template(@PKG_R_WORKER, [String: String]{"allowed": allowed.join(",\n"), "svg_runtime": @PKG_R_SVG_RUNTIME})
}

fn pkg_r_render_jet(lib: String, functions: [String]) -> String Never! {
    abi :: "jet_r_{lib}"
    out := [String]{"#Import module c.{abi} {{\n    fn open() -> Int = \"{abi}_open\"\n    fn take_error() -> Int = \"{abi}_take_error\"\n    fn cancel(handle: Int) = \"{abi}_cancel\"\n    fn close(handle: Int) = \"{abi}_close\"\n"}
    loop name in functions {
        &out.push("    fn {name}(handle: Int, input: String, deadline_ms: Int) -> String = \"{abi}_invoke_{name}\"\n")
        &out.push("    fn {name}_table(handle: Int, input: String, deadline_ms: Int) String = \"{abi}_invoke_{name}_table\"\n")
        &out.push("    fn {name}_plot(handle: Int, input: String, deadline_ms: Int) String = \"{abi}_invoke_{name}_plot\"\n")
    }
    &out.push("}}\nuse c.{abi} as abi\nuse core.encoding.json as json\n\npub struct Session {{ value: Int }}\n#Error\npub enum RError {{ NotRunning Timeout Cancelled Protocol CommandFailed Limit }}\n\n")
    &out.push(pkg_render_decode_response("RError", DecoderProtocol.StandardEnvelope))
    &out.push(@PKG_R_JET_SESSION)
    loop name in functions {
        &out.push("pub fn {name}(session: Session, input: DataTree, deadline_ms: Int) -> DataTree RError! {{\n    raw :: abi.{name}(session.value, json.to_string(input), deadline_ms)\n    code :: abi.take_error()\n    return decode_response(raw, code)\n}}\n\n")
        &out.push("pub fn {name}_table<T: [Encode, Decode]>(session: Session, rows: [T], deadline_ms: Int) -> [T] RError! {{\n    raw :: abi.{name}_table(session.value, json.to_string(~rows), deadline_ms)\n    code :: abi.take_error()\n    value :: decode_response(raw, code)\n    return Ok(json.decode<[T]>(json.to_string(value)) ?? return Err(RError.Protocol))\n}}\n\n")
        &out.push("pub fn {name}_plot(session: Session, input: DataTree, deadline_ms: Int) -> String RError! {{\n    raw :: abi.{name}_plot(session.value, json.to_string(input), deadline_ms)\n    code :: abi.take_error()\n    value :: decode_response(raw, code)\n    return Ok(value.text() ?? return Err(RError.Protocol))\n}}\n\n")
    }
    out.join("")
}

// The generated surface for the binder registry's rendering probe.
pub fn pkg_r_render_probe() -> String Never! {
    pkg_r_render_jet("registry", [String]{"transform"})
}

fn pkg_r_reserved(value: String) -> Bool Never! {
    @PKG_R_RESERVED.contains(value) || @JET_KEYWORD_LIST.contains(value) || @JET_TYPE_LIST.contains(value)
}

@PKG_R_JET_SESSION :: ```impl Session.Close {
    fn close(^self) { abi.close(self.value) }
}

pub fn close(^session: Session) { abi.close(session.value) }

pub fn open() -> Session RError! {
    handle :: abi.open()
    if abi.take_error() != 0 -> return Err(RError.NotRunning)
    return Ok(Session{ value: handle })
}

pub fn cancel(session: Session) { abi.cancel(session.value) }

```

// Parses the script without evaluating it and prints `N\t<name>` per
// top-level one-argument function or `E\tARG\t<name>` for an unsupported one.
@PKG_R_DISCOVERER :: ```args <- commandArgs(trailingOnly = TRUE)
expressions <- parse(file = args[[1]], keep.source = FALSE)
for (expression in expressions) {
  if (!is.call(expression) || !(as.character(expression[[1]]) %in% c("<-", "="))) next
  if (!is.symbol(expression[[2]]) || !is.call(expression[[3]]) || !identical(expression[[3]][[1]], as.name("function"))) next
  name <- as.character(expression[[2]])
  parameters <- expression[[3]][[2]]
  valid <- length(parameters) == 1 && names(parameters)[[1]] != "..." && identical(deparse(parameters[[1]]), "")
  if (!valid) { cat("E\tARG\t", name, "\n", sep = ""); quit(status = 0) }
  cat("N\t", name, "\n", sep = "")
}
