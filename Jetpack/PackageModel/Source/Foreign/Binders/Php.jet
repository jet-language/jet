// Persistent supervised PHP worker-pool binder (D-FFI-PHP1=A), ported from
// jet_pkg_model::PhpBind. Each pool owns four supervised workers built from
// the shared supervisor in Foreign/WorkerSupervisor.jet.

// Static token discovery run with `php -r`: prints `N\t<name>` per top-level
// one-argument function or `E\tARG\t<name>` for an unsupported signature.
// Source bytes are tokenized, never executed.
PKG_PHP_TOKEN_ANALYZER :: prep { ```
$source = @file_get_contents($argv[1]);
if ($source === false) exit(2);
$tokens = token_get_all($source, TOKEN_PARSE);
$ignorable = static function ($token): bool {
    return is_array($token) && in_array($token[0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true);
};
$ampersand = static function ($token): bool {
    if ($token === '&') return true;
    if (!is_array($token)) return false;
    return (defined('T_AMPERSAND_FOLLOWED_BY_VAR_OR_VARARG') && $token[0] === constant('T_AMPERSAND_FOLLOWED_BY_VAR_OR_VARARG'))
        || (defined('T_AMPERSAND_NOT_FOLLOWED_BY_VAR_OR_VARARG') && $token[0] === constant('T_AMPERSAND_NOT_FOLLOWED_BY_VAR_OR_VARARG'));
};
$depth = 0;
for ($i = 0, $count = count($tokens); $i < $count; $i++) {
    $token = $tokens[$i];
    if ($token === '{') { $depth++; continue; }
    if ($token === '}') { $depth = max(0, $depth - 1); continue; }
    if ($depth !== 0 || !is_array($token) || $token[0] !== T_FUNCTION) continue;
    $j = $i + 1;
    while ($j < $count && $ignorable($tokens[$j])) $j++;
    if ($j < $count && $ampersand($tokens[$j])) {
        $j++;
        while ($j < $count && $ignorable($tokens[$j])) $j++;
    }
    if ($j >= $count || !is_array($tokens[$j]) || $tokens[$j][0] !== T_STRING) continue;
    $name = $tokens[$j][1];
    $j++;
    while ($j < $count && $ignorable($tokens[$j])) $j++;
    if ($j >= $count || $tokens[$j] !== '(') continue;
    $parens = 1;
    $variables = 0;
    $unsupported = false;
    for ($j++; $j < $count && $parens > 0; $j++) {
        $param = $tokens[$j];
        if ($param === '(') { $parens++; continue; }
        if ($param === ')') { $parens--; continue; }
        if ($parens !== 1) continue;
        if (is_array($param) && $param[0] === T_VARIABLE) $variables++;
        if (is_array($param) && $param[0] === T_ELLIPSIS) $unsupported = true;
        if ($param === ',' || $param === '=' || $ampersand($param)) $unsupported = true;
    }
    if ($variables !== 1 || $unsupported) {
        echo "E\tARG\t", $name, "\n";
        exit(0);
    }
    echo "N\t", $name, "\n";
}
``` }

// The pool worker. Hole: `allowed`, one `'name' => true` row per function.
PKG_PHP_WORKER :: prep { ```<?php
ini_set('display_errors', '0');
error_reporting(0);
$autoload = getenv('COMPOSER_AUTOLOAD');
if ($autoload !== false && $autoload !== '') {
    foreach (explode(PATH_SEPARATOR, $autoload) as $file) {
        if ($file !== '') require_once $file;
    }
}
require_once $argv[1];
$allowed = [
@@allowed@@
];

function jet_read_exact(int $length): ?string {
    $value = '';
    while (strlen($value) < $length) {
        $part = fread(STDIN, $length - strlen($value));
        if ($part === false || $part === '') return null;
        $value .= $part;
    }
    return $value;
}

fwrite(STDOUT, pack('V', 5) . 'READY');
fflush(STDOUT);
while (true) {
    $header = jet_read_exact(4);
    if ($header === null) break;
    $length = unpack('Vlength', $header)['length'];
    if ($length < 1 || $length > 1048576) break;
    $payload = jet_read_exact($length);
    if ($payload === null) break;
    $request = null;
    try {
        $request = json_decode($payload, true, 512, JSON_THROW_ON_ERROR);
        if (!is_array($request)) throw new RuntimeException('invalid request');
        if (($request['op'] ?? '') === 'shutdown') break;
        $command = $request['command'] ?? '';
        if (($request['op'] ?? '') !== 'invoke' || !isset($allowed[$command])) throw new RuntimeException('rejected command');
        $value = $command($request['input']);
        $response = ['id' => $request['id'], 'ok' => true, 'value' => $value];
    } catch (Throwable $error) {
        $response = ['id' => is_array($request) ? ($request['id'] ?? 0) : 0, 'ok' => false, 'code' => 'CommandFailed', 'value' => null];
    }
    try { $encoded = json_encode($response, JSON_THROW_ON_ERROR); } catch (Throwable $error) { break; }
    if (strlen($encoded) > 1048576) break;
    $id = (int)($response['id'] ?? 0);
    fwrite(STDOUT, pack('V', strlen($encoded)) . pack('V2', $id & 0xffffffff, intdiv($id, 4294967296)) . $encoded);
    fflush(STDOUT);
}
``` }

// The pool layer over the supervisor. Holes: `abi` (the public pool ABI),
// `inner` (the supervisor ABI), and `wrappers`.
PKG_PHP_POOL_C :: prep { ```
#define PHP_POOL_WORKERS 4
#define PHP_POOLS 8
typedef struct {int64_t workers[PHP_POOL_WORKERS];uint32_t generation;uint32_t next;int opening;int open;int closing;int active;pthread_mutex_t mutex;pthread_cond_t idle;} PhpPool;
static PhpPool php_pools[PHP_POOLS];
static pthread_mutex_t php_lock=PTHREAD_MUTEX_INITIALIZER;
static pthread_once_t php_once=PTHREAD_ONCE_INIT;
static _Thread_local int64_t php_failed;
static void php_init(void){for(int i=0;i<PHP_POOLS;i++){pthread_mutex_init(&php_pools[i].mutex,0);pthread_cond_init(&php_pools[i].idle,0);}}
static int php_acquire(int64_t h,int*idx,int64_t*worker){int n=(int)(h&255)-1;uint32_t gen=(uint32_t)((uint64_t)h>>8);if(n<0||n>=PHP_POOLS)return 0;pthread_mutex_lock(&php_lock);PhpPool*p=&php_pools[n];pthread_mutex_lock(&p->mutex);int ok=p->open&&!p->closing&&p->generation==gen;if(ok){p->active++;uint32_t selected=p->next++%PHP_POOL_WORKERS;*worker=p->workers[selected];*idx=n;}pthread_mutex_unlock(&p->mutex);pthread_mutex_unlock(&php_lock);return ok;}
static void php_release(int idx){PhpPool*p=&php_pools[idx];pthread_mutex_lock(&p->mutex);p->active--;if(p->active==0)pthread_cond_broadcast(&p->idle);pthread_mutex_unlock(&p->mutex);}
int64_t @@abi@@_take_error(void){int64_t value=php_failed;php_failed=0;return value;}
int64_t @@abi@@_open(void){pthread_once(&php_once,php_init);php_failed=0;int slot=-1;uint32_t gen=0;pthread_mutex_lock(&php_lock);for(int i=0;i<PHP_POOLS;i++){PhpPool*p=&php_pools[i];pthread_mutex_lock(&p->mutex);if(!p->opening&&!p->open&&!p->closing&&p->active==0){p->opening=1;p->generation++;if(p->generation==0)p->generation=1;slot=i;gen=p->generation;pthread_mutex_unlock(&p->mutex);break;}pthread_mutex_unlock(&p->mutex);}pthread_mutex_unlock(&php_lock);if(slot<0){php_failed=1;return 0;}int64_t made[PHP_POOL_WORKERS]={0};for(int i=0;i<PHP_POOL_WORKERS;i++){made[i]=@@inner@@_open();if(!made[i]){for(int j=0;j<i;j++)@@inner@@_close(made[j]);pthread_mutex_lock(&php_pools[slot].mutex);php_pools[slot].opening=0;pthread_mutex_unlock(&php_pools[slot].mutex);php_failed=1;return 0;}}PhpPool*p=&php_pools[slot];pthread_mutex_lock(&p->mutex);for(int i=0;i<PHP_POOL_WORKERS;i++)p->workers[i]=made[i];p->next=0;p->opening=0;p->open=1;pthread_mutex_unlock(&p->mutex);return (int64_t)(((uint64_t)gen<<8)|(uint64_t)(slot+1));}
static const char* pool_invoke(int64_t h,const char*command,const char*json,int64_t deadline){php_failed=0;int idx;int64_t worker;if(!php_acquire(h,&idx,&worker)){php_failed=1;result[0]=0;return result;}const char*value=invoke(worker,command,json,deadline);int64_t code=@@inner@@_take_error();if(code==1||code==2||code==3||code==4){PhpPool*p=&php_pools[idx];pthread_mutex_lock(&p->mutex);for(int i=0;i<PHP_POOL_WORKERS;i++)if(p->workers[i]==worker&&p->open){int64_t replacement=@@inner@@_open();p->workers[i]=replacement;break;}pthread_mutex_unlock(&p->mutex);}php_failed=code;php_release(idx);return value;}
void @@abi@@_cancel(int64_t h){php_failed=0;int idx;int64_t worker;if(!php_acquire(h,&idx,&worker)){php_failed=1;return;}PhpPool*p=&php_pools[idx];pthread_mutex_lock(&p->mutex);int64_t copy[PHP_POOL_WORKERS];for(int i=0;i<PHP_POOL_WORKERS;i++)copy[i]=p->workers[i];for(int i=0;i<PHP_POOL_WORKERS;i++)@@inner@@_cancel(copy[i]);for(int i=0;i<PHP_POOL_WORKERS;i++){@@inner@@_close(copy[i]);p->workers[i]=@@inner@@_open();}pthread_mutex_unlock(&p->mutex);php_release(idx);}
void @@abi@@_close(int64_t h){php_failed=0;int n=(int)(h&255)-1;uint32_t gen=(uint32_t)((uint64_t)h>>8);if(n<0||n>=PHP_POOLS){php_failed=1;return;}pthread_mutex_lock(&php_lock);PhpPool*p=&php_pools[n];pthread_mutex_lock(&p->mutex);if(!p->open||p->generation!=gen){pthread_mutex_unlock(&p->mutex);pthread_mutex_unlock(&php_lock);php_failed=1;return;}p->closing=1;p->open=0;pthread_mutex_unlock(&php_lock);while(p->active>0)pthread_cond_wait(&p->idle,&p->mutex);int64_t copy[PHP_POOL_WORKERS];for(int i=0;i<PHP_POOL_WORKERS;i++){copy[i]=p->workers[i];p->workers[i]=0;}p->closing=0;pthread_mutex_unlock(&p->mutex);for(int i=0;i<PHP_POOL_WORKERS;i++)@@inner@@_close(copy[i]);}
@@wrappers@@
``` }

PKG_PHP_RESERVED :: prep { [String]{"open", "take_error", "cancel", "close", "decode_response", "abi", "json", "PhpPool", "PhpError"} }

// Bind the top-level one-argument functions of the PHP script at `path`.
pub fn pkg_php_bind(path: String, source: String, lib: String, cache: String) -[FS, Env, Exec, Time.Wait]> ForeignBindResult ForeignBindError! {
    language :: WorkerLanguage.Php
    pkg_worker_require_supported_host(language, pkg_binder_host_is_unix())
    pkg_binder_require_lib_name(lib)
    php :: pkg_binder_resolved_tool_path("php") ?? return Err(ForeignBindError.ToolMissing("php"))
    script :: pkg_binder_canonicalize(path, "could not resolve the PHP script")
    pkg_php_lint(php, script)
    functions :: pkg_php_discover_functions(php, script)
    build :: pkg_worker_prepare_build(cache, "php", lib, "PHP")
    worker_source :: pkg_php_render_worker(functions)
    worker_file :: files.join(cache, "{lib}_worker.php")
    pkg_binder_write(worker_file, worker_source, "could not write PHP worker")
    worker :: pkg_binder_canonicalize(worker_file, "could not resolve the PHP worker")
    abi :: "jet_php_{lib}"
    inner :: "{abi}_worker"
    base :: pkg_worker_render_supervisor_c(inner, php, worker, script, "", "worker_path,script_path")
    bridge :: "{base}\n{pkg_php_render_pool_c(abi, inner, functions)}"
    archive :: pkg_worker_build_archive(language, abi, build, cache, bridge, "could not write PHP pool bridge")
    digest :: pkg_binder_identity_digest([String]{"jet-php-bind-v1", source, script, php, worker_source})
    provenance := "schema=jet-php-bind-v1\nsha256={digest}\nphp={php}\nscript={script}\nworker={worker}\npool_workers=4\n"
    pkg_binder_append_artifact_boundary(&provenance, ForeignLanguage.Php, "PHP", lib, script, archive, "php={php};{pkg_binder_cc_ar_identity()}")
    result :: ForeignBindResult{source: pkg_php_render_jet(lib, functions), bound: functions, archive: archive, provenance: provenance}
    pkg_binder_remove_tree_quiet(build)
    Ok(result)
}

// `php -n -l`: any failing status is reported as a parse error.
fn pkg_php_lint(php: String, script: String) ForeignBindError! -[Exec, Time.Wait]> {
    if pkg_worker_run_tool([String]{php, "-n", "-l", script}, "php", WorkerLanguage.Php, true) == {
        .Ok(_) -> {}
        .Err(error) -> {
            if error == {
                .ToolFailed(_, _, _) -> return Err(ForeignBindError.ToolFailed{tool: "php", action: WorkerLanguage.Php.action(), detail: "the PHP source has a parse error"})
                else -> return Err(error)
            }
        }
    }
}

// Static discovery through PHP's own tokenizer.
fn pkg_php_discover_functions(php: String, script: String) -[Exec, Time.Wait]> [String] ForeignBindError! {
    output :: pkg_worker_run_tool([String]{php, "-d", "auto_prepend_file=", "-d", "auto_append_file=", "-r", PKG_PHP_TOKEN_ANALYZER, "--", script}, "php", WorkerLanguage.Php, true)
    pkg_php_parse_discovery(output)
}

// Validate the tokenizer's `N\t` / `E\tARG\t` rows.
fn pkg_php_parse_discovery(output: [U8]) -> [String] ForeignBindError! {
    text :: String.from_bytes(output) ?? return Err(ForeignBindError.Source("PHP tokenizer returned non-UTF-8 metadata"))
    out := [String]{}
    loop line in pkg_binder_lines(text) {
        if line.starts_with("E\tARG\t") -> return Err(ForeignBindError.Source("PHP function `{line.removeprefix("E\tARG\t")}` must take one required positional argument by value"))
        if !line.starts_with("N\t") -> return Err(ForeignBindError.Source("PHP tokenizer returned malformed metadata"))
        name :: line.removeprefix("N\t")
        if !pkg_binder_is_ident(name) -> return Err(ForeignBindError.Source("PHP function `{name}` cannot be projected as a Jet identifier"))
        if pkg_php_reserved(name) -> return Err(ForeignBindError.Source("PHP function `{name}` uses a reserved generated binding name"))
        loop existing in out {
            if pkg_ascii_lower(existing) == pkg_ascii_lower(name) -> return Err(ForeignBindError.Source("PHP function `{name}` is declared more than once"))
        }
        &out.push(name)
    }
    if out.len() == 0 -> return Err(ForeignBindError.Source("no top-level named PHP functions were found"))
    Ok(out)
}

fn pkg_php_render_worker(functions: [String]) -> String Never! {
    allowed := [String]{}
    loop name in functions -> &allowed.push("    '{name}' => true")
    pkg_binder_fill_template(PKG_PHP_WORKER, [String: String]{"allowed": allowed.join(",\n")})
}

fn pkg_php_render_pool_c(abi: String, inner: String, functions: [String]) -> String Never! {
    wrappers := [String]{}
    loop name in functions -> &wrappers.push(pkg_worker_invoke_wrapper(abi, name, "pool_invoke", name))
    pkg_binder_fill_template(PKG_PHP_POOL_C, [String: String]{"abi": abi, "inner": inner, "wrappers": wrappers.join("")})
}

fn pkg_php_render_jet(lib: String, functions: [String]) -> String Never! {
    abi :: "jet_php_{lib}"
    out := [String]{"#Import module c.{abi} {{\n    fn open() -> Int = \"{abi}_open\"\n    fn take_error() -> Int = \"{abi}_take_error\"\n    fn cancel(handle: Int) = \"{abi}_cancel\"\n    fn close(handle: Int) = \"{abi}_close\"\n"}
    loop name in functions {
        &out.push("    fn {name}(handle: Int, input: String, deadline_ms: Int) -> String = \"{abi}_invoke_{name}\"\n")
    }
    &out.push("}}\nuse c.{abi} as abi\nuse core.encoding.json as json\n\npub struct PhpPool {{ value: Int }}\n#Error\npub enum PhpError {{ NotRunning Timeout Cancelled Protocol CommandFailed Limit }}\n\nimpl PhpPool.Close {{\n    fn close(^self) {{ abi.close(self.value) }}\n}}\n\npub fn close(^pool: PhpPool) {{ abi.close(pool.value) }}\n\npub fn open() -> PhpPool PhpError! {{\n    handle :: abi.open()\n    if abi.take_error() != 0 {{ return Err(PhpError.NotRunning) }}\n    return Ok(PhpPool{{ value: handle }})\n}}\n\npub fn cancel(pool: PhpPool) {{ abi.cancel(pool.value) }}\n\n")
    &out.push(pkg_render_decode_response("PhpError", DecoderProtocol.StandardEnvelope))
    loop name in functions {
        &out.push("pub fn {name}(pool: PhpPool, input: DataTree, deadline_ms: Int) -> DataTree PhpError! {{\n    raw :: abi.{name}(pool.value, json.to_string(input), deadline_ms)\n    code :: abi.take_error()\n    return decode_response(raw, code)\n}}\n\n")
    }
    out.join("")
}

// The generated surface for the binder registry's rendering probe.
pub fn pkg_php_render_probe() -> String Never! {
    pkg_php_render_jet("registry", [String]{"transform"})
}

fn pkg_php_reserved(value: String) -> Bool Never! {
    PKG_PHP_RESERVED.contains(value) || JET_KEYWORD_LIST.contains(value) || JET_TYPE_LIST.contains(value)
}
