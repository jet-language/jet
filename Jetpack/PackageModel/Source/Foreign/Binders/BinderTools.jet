use {
    binder_core_files: core.files
    binder_core_process: core.process
}

// Shared failure carrier, supervised tool runs, and small text helpers for
// the foreign-language binders (jet_pkg_model::{Ada,Cobol,Com,Cpp,Dart,
// DotNet,Fortran,Go,...}Bind). Every binder spawned its tools the same way:
// captured stdout/stderr, a per-stream byte cap, and a wall-clock limit. One
// helper owns that policy here; each binder keeps its own success rule and
// its own laundering of the failing tool's output.

// The per-stream capture limit the binders apply to foreign tool output.
BINDER_TOOL_CAPTURE_LIMIT: 65536
BINDER_TOOL_TIMEOUT_DETAIL: "the tool exceeded the 60 second limit"
BINDER_TOOL_FAILURE_DETAIL: "the foreign tool returned a failure status"

// Why a foreign binding could not be produced. `ToolFailed.action` carries
// the binder's own verb phrase ("rejected the Ada binding source") so every
// language keeps its diagnostic text on the one carrier.
#Error
ForeignBindError: enum {
    Source(String)
    IO(String)
    ToolMissing(String)
    SelectedToolMissing(String)
    ToolFailed(tool: String, action: String, detail: String)
    ToolchainRejected(String)
    ABIMismatch(String)
    UnsupportedHost(String)
    // Python/JavaScript binders spell the tool without backticks.
    PlainToolMissing(String)
    PlainToolFailed(tool: String, action: String, detail: String)

    message: fn(self) -> String Never! {
        if self == {
            .Source(text) | .IO(text) | .UnsupportedHost(text) -> text
            .ToolMissing(tool) -> "the provisioned `{tool}` tool was not found"
            .SelectedToolMissing(tool) -> "the selected `{tool}` tool was not found"
            .ToolFailed(tool, action, detail) -> "`{tool}` {action}: {detail}"
            .ToolchainRejected(detail) -> "the C++ toolchain rejected the binding: {detail}"
            .ABIMismatch(detail) -> "the generated COBOL C-ABI bridge failed its link proof: {detail}"
            .PlainToolMissing(tool) -> "the provisioned {tool} tool was not found"
            .PlainToolFailed(tool, action, detail) -> "{tool} {action}: {detail}"
        }
    }
}

// A bridge-record failure surfaces as an I/O failure of the binding.
impl ForeignBridgeError -> ForeignBindError { pkg_binder_bridge_error(self) }

pkg_binder_bridge_error: fn(error: ForeignBridgeError) -> ForeignBindError Never! {
    ForeignBindError.IO(error.message)
}

// The four-part result shared by binders that publish one archive.
ForeignBindResult: struct {
    source: String
    bound: [String]
    archive: String
    provenance: String
}

// One supervised tool run: exit success, whether the wall-clock limit ended
// it, and each captured stream bounded by the capture limit.
BinderToolOutput: struct {
    success: Bool
    timed_out: Bool
    stdout: [U8]
    stderr: [U8]
}

// Run `argv` with captured, bounded output under `timeout`. A tool that does
// not exist is `ToolMissing(tool)`; any other launch failure is `IO`. The
// caller decides what a timeout or a failing status means.
pkg_binder_supervise: fn(argv: [String], cwd: String?, env: [(name: String, value: String)], limit: Int, timeout: Duration, tool: String) -[Exec, Time.Wait]> BinderToolOutput ForeignBindError! {
    spec := binder_core_process.cmd(argv).stdout(.Capture).stderr(.Capture).timeout(timeout).output_limit(limit)
    if cwd == {
        .Val(directory) -> spec = spec.cwd(directory)
        .None -> {}
    }
    loop pair in env -> spec = spec.env(pair.name, pair.value)
    if spec.run() == {
        .Ok(receipt) -> Ok(BinderToolOutput{
            success: receipt.success,
            timed_out: receipt.timed_out,
            stdout: receipt.output.bytes(),
            stderr: receipt.errors.bytes()
        })
        .Err(error) -> {
            if error == {
                .NotFound(_) -> Err(ForeignBindError.ToolMissing(tool))
                .InvalidInput(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> Err(ForeignBindError.IO("could not start `{tool}`: {error}"))
            }
        }
    }
}

// The common 64 KiB / 60 s supervision; a timeout is a `ToolFailed`.
pkg_binder_capture: fn(argv: [String], cwd: String?, tool: String, action: String) -[Exec, Time.Wait]> BinderToolOutput ForeignBindError! {
    pkg_binder_capture_env(argv, cwd, [(name: String, value: String)]{}, tool, action)
}

pkg_binder_capture_env: fn(argv: [String], cwd: String?, env: [(name: String, value: String)], tool: String, action: String) -[Exec, Time.Wait]> BinderToolOutput ForeignBindError! {
    output: pkg_binder_supervise(argv, cwd, env, BINDER_TOOL_CAPTURE_LIMIT, 60s, tool)
    if output.timed_out -> return Err(ForeignBindError.ToolFailed{tool: tool, action: action, detail: BINDER_TOOL_TIMEOUT_DETAIL})
    Ok(output)
}

// The first non-empty trimmed line, at most 160 characters.
pkg_binder_launder_first_line: fn(bytes: [U8]) -> String Never! {
    loop line in pkg_binder_lines(String.from_bytes_lossy(bytes)) {
        trimmed: line.trim()
        if trimmed != "" -> return pkg_binder_take_chars(trimmed, 160)
    }
    BINDER_TOOL_FAILURE_DETAIL
}

// An ASCII identifier: a letter or `_`, then letters, digits, or `_`.
pkg_binder_is_ident: fn(value: String) -> Bool Never! {
    raw: value.bytes()
    if raw.len() == 0 -> return false
    first: Int{raw[0]}
    if !pkg_binder_is_ascii_alpha(first) && first != 95 -> return false
    loop byte in raw {
        if !pkg_bytes_is_word(Int{byte}) -> return false
    }
    true
}

pkg_binder_is_ascii_alpha: fn(code: Int) -> Bool Never! {
    (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
}

pkg_binder_is_ascii_digit: fn(code: Int) -> Bool Never! {
    code >= 48 && code <= 57
}

// ── Filesystem steps with the binder's failure context ──

pkg_binder_canonicalize: fn(path: String, context: String) -[FS, Env]> String ForeignBindError! {
    if binder_core_files.canonicalize(path) == {
        .Ok(resolved) -> Ok(resolved)
        .Err(error) -> return Err(ForeignBindError.IO("{context}: {error}"))
    }
}

pkg_binder_create_dir_all: fn(path: String, context: String) ForeignBindError! -[FS]> {
    if binder_core_files.create_dir_all(path) == {
        .Ok(_) -> {}
        .Err(error) -> return Err(ForeignBindError.IO("{context}: {error}"))
    }
}

pkg_binder_write: fn(path: String, text: String, context: String) ForeignBindError! -[FS]> {
    if binder_core_files.write(path, text) == {
        .Ok(_) -> {}
        .Err(error) -> return Err(ForeignBindError.IO("{context}: {error}"))
    }
}

pkg_binder_read_bytes: fn(path: String, context: String) -[FS]> [U8] ForeignBindError! {
    if binder_core_files.read_bytes(path) == {
        .Ok(bytes) -> Ok(bytes)
        .Err(error) -> return Err(ForeignBindError.IO("{context}: {error}"))
    }
}

pkg_binder_copy: fn(from: String, to: String, context: String) ForeignBindError! -[FS]> {
    if binder_core_files.copy2(from, to) == {
        .Ok(_) -> {}
        .Err(error) -> return Err(ForeignBindError.IO("{context}: {error}"))
    }
}

// Best-effort cleanup (`let _ = remove_dir_all`): a missing tree is fine.
pkg_binder_remove_tree_quiet: fn(path: String) -[FS]> {
    binder_core_files.remove_all(path) ?? return
}

pkg_binder_remove_file_quiet: fn(path: String) -[FS]> {
    binder_core_files.remove(path) ?? return
}

// ── Text helpers over Rust `str` semantics ──

// `str::lines`: split on `\n`, drop one trailing `\r` per line, and no final
// empty line after a trailing newline.
pkg_binder_lines: fn(text: String) -> [String] Never! {
    out := [String]{}
    if text == "" -> return out
    parts: text.split("\n").to_list()
    loop index in 0..<parts.len() {
        if index == parts.len() - 1 && parts[index] == "" -> break
        raw: parts[index].bytes()
        cut: if raw.len() > 0 && (Int{raw[raw.len() - 1]}) == 13 -> raw.len() - 1 else -> raw.len()
        out.push(pkg_bytes_text(raw, 0, cut))
    }
    out
}

// `str::split_whitespace`.
pkg_binder_words: fn(text: String) -> [String] Never! {
    raw: text.bytes()
    out := [String]{}
    cursor := 0
    loop cursor < raw.len() {
        cursor = pkg_bytes_skip_space(raw, cursor)
        if cursor >= raw.len() -> break
        start: cursor
        loop cursor < raw.len() && pkg_bytes_space_width(raw, cursor) == 0 -> cursor += 1
        out.push(pkg_bytes_text(raw, start, cursor))
    }
    out
}

// The byte index of the first `needle` at or after `from`, or -1.
pkg_binder_find: fn(text: String, needle: String, from: Int) -> Int Never! {
    raw: text.bytes()
    pattern: needle.bytes()
    cursor := if from < 0 -> 0 else -> from
    loop cursor + pattern.len() <= raw.len() {
        if pkg_bytes_starts_with(raw, cursor, pattern) -> return cursor
        cursor += 1
    }
    -1
}

// The byte index of the last `needle`, or -1.
pkg_binder_rfind: fn(text: String, needle: String) -> Int Never! {
    raw: text.bytes()
    pattern: needle.bytes()
    cursor := raw.len() - pattern.len()
    loop cursor >= 0 {
        if pkg_bytes_starts_with(raw, cursor, pattern) -> return cursor
        cursor -= 1
    }
    -1
}

// `text[start..end]` by byte offsets.
pkg_binder_slice: fn(text: String, start: Int, end: Int) -> String Never! {
    pkg_bytes_text(text.bytes(), start, end)
}

// `text[start..]` by byte offset.
pkg_binder_tail: fn(text: String, start: Int) -> String Never! {
    raw: text.bytes()
    pkg_bytes_text(raw, start, raw.len())
}

// The first `count` characters.
pkg_binder_take_chars: fn(text: String, count: Int) -> String Never! {
    out := [String]{}
    loop scalar in text.chars() {
        if out.len() >= count -> break
        out.push("{scalar}")
    }
    out.join("")
}

// `str::trim_end_matches(pattern)` for a non-empty pattern.
pkg_binder_trim_end_matches: fn(text: String, pattern: String) -> String Never! {
    out := text
    loop pattern != "" && out.ends_with(pattern) -> out = out.removesuffix(pattern)
    out
}

// `str::trim_matches(pattern)` for a non-empty pattern.
pkg_binder_trim_matches: fn(text: String, pattern: String) -> String Never! {
    out := text
    loop pattern != "" && out.starts_with(pattern) -> out = out.removeprefix(pattern)
    pkg_binder_trim_end_matches(out, pattern)
}

// ASCII-only uppercase (`str::to_ascii_uppercase`).
pkg_binder_ascii_upper: fn(value: String) -> String Never! {
    out := [U8]{}
    loop byte in value.bytes() {
        code: Int{byte}
        if {
            code >= 97 && code <= 122 -> out.push(checked(U8{code - 32}) ?? byte)
            else -> out.push(byte)
        }
    }
    String.from_bytes(out) ?? value
}

// A `u64` length field in little-endian bytes (`(n as u64).to_le_bytes()`).
pkg_binder_u64_le: fn(value: Int) -> [U8] Never! {
    out := [U8]{}
    rest := value
    loop index in 0..<8 {
        out.push(checked(U8{rest % 256}) ?? U8{0})
        rest = rest /% 256
    }
    out
}

// The bytes of `text` followed by one NUL separator.
pkg_binder_append_field: fn(identity: &[U8], text: [U8]) {
    loop byte in text -> identity.push(byte)
    identity.push(U8{0})
}
