// Shared failure carrier, supervised tool runs, and small text helpers for
// the foreign-language binders (jet_pkg_model::{Ada,Cobol,Com,Cpp,Dart,
// DotNet,Fortran,Go,...}Bind). Every binder spawned its tools the same way:
// captured stdout/stderr, a per-stream byte cap, and a wall-clock limit. One
// helper owns that policy here; each binder keeps its own success rule and
// its own laundering of the failing tool's output.

// The per-stream capture limit the binders apply to foreign tool output.
BINDER_TOOL_CAPTURE_LIMIT :: prep { 65536 }
BINDER_TOOL_TIMEOUT_DETAIL :: prep { "the tool exceeded the 60 second limit" }
BINDER_TOOL_FAILURE_DETAIL :: prep { "the foreign tool returned a failure status" }


// The four-part result shared by binders that publish one archive.
pub struct ForeignBindResult {
    pub source: String
    pub bound: [String]
    pub archive: String
    pub provenance: String
}

// One supervised tool run: exit success, whether the wall-clock limit ended
// it, and each captured stream bounded by the capture limit.
pub struct BinderToolOutput {
    pub success: Bool
    pub timed_out: Bool
    pub stdout: [U8]
    pub stderr: [U8]
}

// Run `argv` with captured, bounded output under `timeout`. A tool that does
// not exist is `ToolMissing(tool)`; any other launch failure is `IO`. The
// caller decides what a timeout or a failing status means.
pub fn pkg_binder_supervise(argv: [String], cwd: String?, env: [(name: String, value: String)], limit: Int, timeout: Duration, tool: String) -[Exec, Time.Wait]> BinderToolOutput ForeignBindError! {
    spec := process.cmd(argv).stdout(.Capture).stderr(.Capture).timeout(timeout).output_limit(limit)
    if cwd == {
        .Val(directory) -> spec = spec.cwd(directory)
        .None -> {}
    }
    loop pair in env -> spec = spec.env(pair.name, pair.value)
    if spec.run() == {
        .Ok(receipt) -> Ok(BinderToolOutput{
            success: receipt.success,
            timed_out: receipt.timed_out,
            stdout: receipt.output.bytes(),
            stderr: receipt.errors.bytes()
        })
        .Err(error) -> {
            if error == {
                .NotFound(_) -> Err(ForeignBindError.ToolMissing(tool))
                else -> Err(ForeignBindError.IO("could not start `{tool}`: {error}"))
            }
        }
    }
}

// The common 64 KiB / 60 s supervision; a timeout is a `ToolFailed`.
pub fn pkg_binder_capture(argv: [String], cwd: String?, tool: String, action: String) -[Exec, Time.Wait]> BinderToolOutput ForeignBindError! {
    pkg_binder_capture_env(argv, cwd, [(name: String, value: String)]{}, tool, action)
}

pub fn pkg_binder_capture_env(argv: [String], cwd: String?, env: [(name: String, value: String)], tool: String, action: String) -[Exec, Time.Wait]> BinderToolOutput ForeignBindError! {
    output :: pkg_binder_supervise(argv, cwd, env, BINDER_TOOL_CAPTURE_LIMIT, 60s, tool)
    if output.timed_out -> return Err(ForeignBindError.ToolFailed{tool: tool, action: action, detail: BINDER_TOOL_TIMEOUT_DETAIL})
    Ok(output)
}

// The first non-empty trimmed line, at most 160 characters.
pub fn pkg_binder_launder_first_line(bytes: [U8]) -> String Never! {
    loop line in pkg_binder_lines(String.from_bytes_lossy(bytes)) {
        trimmed :: line.trim()
        if trimmed != "" -> return pkg_binder_take_chars(trimmed, 160)
    }
    BINDER_TOOL_FAILURE_DETAIL
}


// ── Filesystem steps with the binder's failure context ──

pub fn pkg_binder_canonicalize(path: String, context: String) -[FS, Env]> String ForeignBindError! {
    if files.canonicalize(path) == {
        .Ok(resolved) -> Ok(resolved)
        .Err(error) -> return Err(ForeignBindError.IO("{context}: {error}"))
    }
}

pub fn pkg_binder_create_dir_all(path: String, context: String) ForeignBindError! -[FS]> {
    if files.create_dir_all(path) == {
        .Ok(_) -> {}
        .Err(error) -> return Err(ForeignBindError.IO("{context}: {error}"))
    }
}

pub fn pkg_binder_write(path: String, text: String, context: String) ForeignBindError! -[FS]> {
    if files.write(path, text) == {
        .Ok(_) -> {}
        .Err(error) -> return Err(ForeignBindError.IO("{context}: {error}"))
    }
}

pub fn pkg_binder_read_bytes(path: String, context: String) -[FS]> [U8] ForeignBindError! {
    if files.read_bytes(path) == {
        .Ok(bytes) -> Ok(bytes)
        .Err(error) -> return Err(ForeignBindError.IO("{context}: {error}"))
    }
}

pub fn pkg_binder_copy(from: String, to: String, context: String) ForeignBindError! -[FS]> {
    if files.copy2(from, to) == {
        .Ok(_) -> {}
        .Err(error) -> return Err(ForeignBindError.IO("{context}: {error}"))
    }
}

// Best-effort cleanup (`let _ = remove_dir_all`): a missing tree is fine.
pub fn pkg_binder_remove_tree_quiet(path: String) -[FS]> {
    files.remove_all(path) ?? return
}

pub fn pkg_binder_remove_file_quiet(path: String) -[FS]> {
    files.remove(path) ?? return
}

