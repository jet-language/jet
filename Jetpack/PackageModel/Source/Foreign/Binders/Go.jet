// Go c-archive to Jet binding generator (D-FFI-GO1=A), ported from
// jet_pkg_model::GoBind.
//
// Exported scalar functions and `runtime/cgo.Handle`-compatible `uintptr`
// values compile into one in-process Go runtime archive. Handles become
// move-only Jet values, so a foreign call cannot reuse a consumed handle.
// Unsupported signatures fail before compilation instead of guessing an ABI.

@PKG_GO_BUILD_TOOL :: "go build -buildmode=c-archive"
@PKG_GO_BUILD_ACTION :: "rejected the source"

// The Go scalar shapes the c-archive boundary accepts.
enum GoScalar {
    Int
    Float
    Handle

    fn parse(value: String) -> GoScalar? Never! {
        if value == {
            "int64" -> Val(GoScalar.Int)
            "float64" -> Val(GoScalar.Float)
            "uintptr" -> Val(GoScalar.Handle)
            else -> None
        }
    }

    // The raw C-import spelling; handles cross as `Int`.
    fn jet(self) -> String Never! {
        if self == {
            .Int | .Handle -> "Int"
            .Float -> "Float"
        }
    }

    // The public spelling; handles become the move-only `Handle`.
    fn public_jet(self) -> String Never! {
        if self == {
            .Handle -> "Handle"
            else -> self.jet()
        }
    }
}

struct GoParam {
    name: String
    scalar: GoScalar
}

// One `//export`ed Go function.
struct GoFunction {
    name: String
    params: [GoParam]
    result: GoScalar?
}

// Build the Go source at `source_path` into one c-archive and bind its exports.
pub fn pkg_go_bind(source_path: String, source: String, lib: String, cache: String) -[FS, Env, Exec, Time.Wait]> ForeignBindResult ForeignBindError! {
    pkg_binder_require_lib_name(lib)
    functions :: pkg_go_parse_exports(source)
    pkg_binder_create_dir_all(cache, "could not create binding cache")
    stem :: "jet_go_{lib}"
    archive :: files.join(cache, "lib{stem}.a")
    header :: files.join(cache, "lib{stem}.h")
    pkg_binder_remove_file_quiet(archive)
    pkg_binder_remove_file_quiet(header)
    uses_handles := false
    loop function in functions {
        loop param in function.params {
            if param.scalar == GoScalar.Handle -> uses_handles = true
        }
        if (function.result ?? GoScalar.Int) == GoScalar.Handle -> uses_handles = true
    }
    if uses_handles && !pkg_binder_host_is_64_bit() -> return Err(ForeignBindError.Source("Go `uintptr` handles need a 64-bit host ABI"))
    output :: pkg_binder_supervise([String]{"go", "build", "-buildmode=c-archive", "-trimpath", "-o", archive, source_path}, None, [(name: String, value: String)]{(name: "CGO_ENABLED", value: "1")}, @BINDER_TOOL_CAPTURE_LIMIT, 60s, "go")
    if output.timed_out -> return Err(ForeignBindError.ToolFailed{tool: @PKG_GO_BUILD_TOOL, action: @PKG_GO_BUILD_ACTION, detail: "the compiler exceeded the 60 second limit"})
    if !output.success -> return Err(ForeignBindError.ToolFailed{tool: @PKG_GO_BUILD_TOOL, action: @PKG_GO_BUILD_ACTION, detail: pkg_go_launder(output.stderr)})
    provenance := "schema=jet-go-bind-v1\n"
    pkg_binder_append_artifact_boundary(&provenance, ForeignLanguage.Go, "Go", lib, source_path, archive, "go={pkg_bridge_tool_identity("go")};cgo=enabled;trimpath;ar")
    bound := [String]{}
    loop function in functions -> &bound.push(function.name)
    Ok(ForeignBindResult{source: pkg_go_render(lib, functions), bound: bound, archive: archive, provenance: provenance})
}

// Each `//export Name` marker must be followed by its one-line scalar `func`.
fn pkg_go_parse_exports(source: String) -> [GoFunction] ForeignBindError! {
    lines :: pkg_binder_lines(source)
    functions := [GoFunction]{}
    loop index in 0..<lines.len() {
        marker :: lines[index].trim()
        if !marker.starts_with("//export ") -> next
        exported :: marker.removeprefix("//export ").trim()
        if !pkg_binder_is_ident(exported) -> return Err(ForeignBindError.Source("`{exported}` is not a bindable Go export name"))
        if index + 1 >= lines.len() -> return Err(ForeignBindError.Source("export `{exported}` has no function declaration"))
        signature :: lines[index + 1].trim()
        if !signature.starts_with("func ") -> return Err(ForeignBindError.Source("export `{exported}` must be followed by its `func` declaration"))
        rest :: signature.removeprefix("func ")
        open :: pkg_binder_find(rest, "(", 0)
        if open < 0 -> return Err(ForeignBindError.Source("function `{exported}` has no parameter list"))
        declared :: pkg_binder_slice(rest, 0, open).trim()
        if declared != exported -> return Err(ForeignBindError.Source("export marker `{exported}` does not match function `{declared}`"))
        close :: pkg_binder_find(rest, ")", open + 1)
        if close < 0 -> return Err(ForeignBindError.Source("function `{exported}` has no closed parameter list"))
        params := [GoParam]{}
        raw_params :: pkg_binder_slice(rest, open + 1, close).trim()
        if raw_params != "" {
            loop raw in raw_params.split(",") {
                pieces :: pkg_binder_words(raw)
                name :: if pieces.len() > 0 -> pieces[0] else -> ""
                ty :: if pieces.len() > 1 -> pieces[1] else -> ""
                if !pkg_binder_is_ident(name) || pieces.len() > 2 -> return Err(ForeignBindError.Source("parameter `{raw.trim()}` in `{exported}` must use `name type`"))
                scalar :: GoScalar.parse(ty) ?? return Err(ForeignBindError.Source("parameter `{name}` in `{exported}` uses unsupported type `{ty}`; use `int64`, `float64`, or `uintptr`"))
                &params.push(GoParam{name: name, scalar: scalar})
            }
        }
        tail :: pkg_binder_tail(rest, close + 1).trim()
        if tail == "" || tail.starts_with("{{") {
            &functions.push(GoFunction{name: exported, params: params, result: None})
            next
        }
        words :: pkg_binder_words(tail)
        ty :: if words.len() > 0 -> words[0] else -> ""
        scalar :: GoScalar.parse(ty) ?? return Err(ForeignBindError.Source("result of `{exported}` uses unsupported type `{ty}`; use `int64`, `float64`, `uintptr`, or no result"))
        &functions.push(GoFunction{name: exported, params: params, result: Val(scalar)})
    }
    if functions.len() == 0 -> return Err(ForeignBindError.Source("no supported `//export Name` Go functions were found"))
    Ok(functions)
}

fn pkg_go_render(lib: String, functions: [GoFunction]) -> String Never! {
    abi :: "jet_go_{lib}"
    out := [String]{"#Import module c.{abi} {{\n"}
    loop function in functions {
        result :: if function.result == {
            .Val(scalar) -> " {scalar.jet()}"
            .None -> ""
        }
        &out.push("    fn {function.name}{pkg_go_params(function.params, false)}{result} = \"{function.name}\"\n")
    }
    &out.push("}}\nuse c.{abi} as abi\n\npub struct Handle {{ value: Int }}\n\n")
    loop function in functions {
        args := [String]{}
        loop param in function.params {
            if param.scalar == {
                .Handle -> &args.push("{param.name}.value")
                else -> &args.push(param.name)
            }
        }
        call :: "abi.{function.name}({args.join(", ")})"
        if function.result == {
            .Val(scalar) -> {
                body :: if scalar == {
                    .Handle -> "Handle{{ value: {call} }}"
                    else -> call
                }
                &out.push("pub fn {function.name}{pkg_go_params(function.params, true)} {scalar.public_jet()} -> {{\n    return {body}\n}}\n\n")
            }
            .None -> &out.push("pub fn {function.name}{pkg_go_params(function.params, true)} {{\n    {call}\n}}\n\n")
        }
    }
    out.join("")
}

// `(name: Type, ...)`; the public form spells handle parameters `Handle`.
fn pkg_go_params(params: [GoParam], public: Bool) -> String Never! {
    parts := [String]{}
    loop param in params {
        ty :: if public -> param.scalar.public_jet() else -> param.scalar.jet()
        &parts.push("{param.name}: {ty}")
    }
    "({parts.join(", ")})"
}

// The first non-comment stderr line's detail after its last `:`.
fn pkg_go_launder(stderr: [U8]) -> String Never! {
    loop line in pkg_binder_lines(String.from_bytes_lossy(stderr)) {
        trimmed :: line.trim()
        if trimmed == "" || trimmed.starts_with("#") -> next
        at :: pkg_binder_rfind(trimmed, ":")
        detail :: if at < 0 -> trimmed else -> pkg_binder_tail(trimmed, at + 1).trim()
        if detail == "" -> return @BINDER_TOOL_FAILURE_DETAIL
        return pkg_binder_take_chars(detail, 160)
    }
    @BINDER_TOOL_FAILURE_DETAIL
}
