// The binder languages: the cases of the `FFI` effect, in source order.
// ForeignLanguage is authored here, the one home of their names; while the
// compiler builds, FOREIGN_LANGUAGE_COUNT checks it (this file's text) and
// `all()` and `debug_name()` against the `FFI.*` leaves the toolchain tree's
// Compiler/Prelude/Effects.jet declares (JetFoundation
// EFFECT_VOCABULARY_LEAVES), and a difference stops the build (E3010) naming
// each missing and extra language.
// The binder table and each language's mount root are in
// Foreign/Bridge/BinderDescriptor.jet.
use {
    jet_foundation.[EFFECT_VOCABULARY_LEAVES]
}

FOREIGN_LANGUAGE_COUNT: comptime { pkg_foreign_language_count(embed_file("ForeignLanguages.jet"), EFFECT_VOCABULARY_LEAVES) }

ForeignLanguage: enum {
    Go
    Java
    DotNet
    Fortran
    Cobol
    Tcl
    Lua
    Ada
    Pascal
    Dart
    PowerShell
    Perl
    Ruby
    Php
    R
    Com
    C
    Cpp
    Asm
    Py
    Octave
    Rust
    JS
    Swift
}

impl ForeignLanguage {
    // Every language in declaration order.
    all: fn() -> [ForeignLanguage] Never! {
        [ForeignLanguage]{
            ForeignLanguage.Go,
            ForeignLanguage.Java,
            ForeignLanguage.DotNet,
            ForeignLanguage.Fortran,
            ForeignLanguage.Cobol,
            ForeignLanguage.Tcl,
            ForeignLanguage.Lua,
            ForeignLanguage.Ada,
            ForeignLanguage.Pascal,
            ForeignLanguage.Dart,
            ForeignLanguage.PowerShell,
            ForeignLanguage.Perl,
            ForeignLanguage.Ruby,
            ForeignLanguage.Php,
            ForeignLanguage.R,
            ForeignLanguage.Com,
            ForeignLanguage.C,
            ForeignLanguage.Cpp,
            ForeignLanguage.Asm,
            ForeignLanguage.Py,
            ForeignLanguage.Octave,
            ForeignLanguage.Rust,
            ForeignLanguage.JS,
            ForeignLanguage.Swift,
        }
    }

    // The case's spelling; descriptor stamps embed it.
    debug_name: fn(self) -> String Never! {
        if self == {
            .Go -> "Go"
            .Java -> "Java"
            .DotNet -> "DotNet"
            .Fortran -> "Fortran"
            .Cobol -> "Cobol"
            .Tcl -> "Tcl"
            .Lua -> "Lua"
            .Ada -> "Ada"
            .Pascal -> "Pascal"
            .Dart -> "Dart"
            .PowerShell -> "PowerShell"
            .Perl -> "Perl"
            .Ruby -> "Ruby"
            .Php -> "Php"
            .R -> "R"
            .Com -> "Com"
            .C -> "C"
            .Cpp -> "Cpp"
            .Asm -> "Asm"
            .Py -> "Py"
            .Octave -> "Octave"
            .Rust -> "Rust"
            .JS -> "JS"
            .Swift -> "Swift"
        }
    }
}

// The number of languages, once ForeignLanguage's cases (in `text`, this
// file), `all()` and `debug_name()` each name the `FFI.*` leaves of `leaves`
// in their order; else the build stops naming the difference.
pkg_foreign_language_count: fn(text: String, leaves: [String]) -> Int {
    named: loop language in ForeignLanguage.all() -> language.debug_name()
    problem: pkg_foreign_language_problem(text, named, leaves)
    if problem != "" -> panic(problem)
    named.len()
}

// What is wrong with the cases of `ForeignLanguage: enum { … }` in `text`
// and with `named` (the names `all()` gives) against the `FFI.*` leaves of
// `leaves`, naming each missing and each extra language, or "".
pkg_foreign_language_problem: fn(text: String, named: [String], leaves: [String]) -> String {
    declared := [String]{}
    loop leaf in leaves {
        if leaf.starts_with("FFI.") -> declared.push(leaf.removeprefix("FFI."))
    }
    cases := [String]{}
    inside := false
    loop line in text.split("\n") {
        if line == "ForeignLanguage: enum {{" {
            inside = true
            next
        }
        if inside && line == "}}" -> break
        if inside && line.trim() != "" -> cases.push(line.trim())
    }
    problem: pkg_foreign_language_difference("the cases of ForeignLanguage", cases, declared)
    if problem != "" -> return problem
    pkg_foreign_language_difference("ForeignLanguage.all()", named, declared)
}

pkg_foreign_language_difference: fn(what: String, found: [String], declared: [String]) -> String {
    if found == declared -> return ""
    missing := [String]{}
    loop name in declared {
        if !found.contains(name) -> missing.push(name.copy())
    }
    extra := [String]{}
    loop name in found {
        if !declared.contains(name) -> extra.push(name.copy())
    }
    "ForeignLanguages.jet: {what} differ from the `FFI` cases of Compiler/Prelude/Effects.jet: missing [{missing.join(", ")}], extra [{extra.join(", ")}] (the order must match too)"
}
