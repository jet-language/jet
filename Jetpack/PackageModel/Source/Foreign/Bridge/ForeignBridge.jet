//RS /// The one consumed boundary row for a binder invocation.
//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub struct ForeignBoundaryContract {
//RS     pub schema: &'static str,
//RS     pub language: crate::AST::ForeignLanguage,
//RS     pub library: String,
//RS     pub descriptor: String,
//RS     pub abi: ForeignAbiContract,
//RS     pub scalar_widths: BTreeMap<String, String>,
//RS     pub alignment: String,
//RS     pub ownership: String,
//RS     pub cleanup: String,
//RS     pub encoding: String,
//RS     pub nullability: String,
//RS     pub errors: String,
//RS     pub exceptions: String,
//RS     pub callbacks: String,
//RS     pub task_thread: String,
//RS     pub target_availability: String,
//RS     pub copy_cost: String,
//RS     /// The descriptor-owned effect root. It is never narrowed from a foreign
//RS     /// effect to purity by an evidence row.
//RS     pub effects: String,
//RS     pub effect_root: String,
//RS     /// Exact loaded artifact and reachable native coverage shared by all rows.
//RS     pub artifact_coverage: ForeignArtifactCoverage,
//RS     pub identity: ForeignBoundaryIdentity,
//RS     pub disposition: ForeignBoundaryDisposition,
//RS     pub source_import: bool,
//RS     pub source_authority: ForeignSourceAuthority,
//RS     /// Receipt of the checked comparison that made a replacement selectable.
//RS     /// It is a projection over the canonical reasoning records, not a second
//RS     /// facts/evidence graph.
//RS     pub source_receipt: Option<ForeignSourceReceipt>,
//RS     pub derivation: Option<jet_foundation::Facts::DerivationRef>,
//RS     pub evidence: Vec<jet_foundation::Evidence::EvidenceIdentity>,
//RS     pub assumptions: Vec<String>,
//RS     pub observations: Vec<ForeignBoundaryObservation>,
//RS     /// One evidence row for every canonical ABI/safety/effect obligation.
//RS     pub obligations: Vec<ForeignObligationEvidence>,
//RS }
