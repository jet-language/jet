// Rust: crates/jet-pkg-model/src/ForeignBridge.rs:2789
// Canonical native cfg bodies already exist; publish the missing selector only.
// GATE #4483: selected target family, never a host/lexical platform proxy.
pub fn pkg_bridge_tool_path(tool: String) -[FS, Env]> OSPath? {
    if target.selected_family() == "windows" {
        pkg_bridge_tool_path_windows_body(tool)
    } else {
        pkg_bridge_tool_path_nonwindows_body(tool)
    }
}

