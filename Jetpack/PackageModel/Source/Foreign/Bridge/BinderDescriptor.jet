// Scalar projection selected by a binder descriptor. `Unsupported` is a
// deliberate fail-closed value, not a request to invent a fallback type.
ForeignScalar: enum {
    Int
    Float
    Bool
    Char
    String
    Unsupported

    debug_name: fn(self) -> String Never! {
        if self == {
            .Int -> "Int"
            .Float -> "Float"
            .Bool -> "Bool"
            .Char -> "Char"
            .String -> "String"
            .Unsupported -> "Unsupported"
        }
    }

    jet_name: fn(self) -> String? Never! {
        if self == {
            .Int -> Val("Int")
            .Float -> Val("Float")
            .Bool -> Val("Bool")
            .Char -> Val("Char")
            .String -> Val("String")
            .Unsupported -> None
        }
    }

    // Rust type emitted at the checked C boundary for the matching Jet
    // scalar. Closed with no placeholder arm.
    c_rust_name: fn(self) -> String? Never! {
        if self == {
            .Int -> Val("std::os::raw::c_longlong")
            .Float -> Val("f64")
            .Bool -> Val("bool")
            .Char -> Val("u32")
            .String -> Val("*const std::os::raw::c_char")
            .Unsupported -> None
        }
    }
}

// `[Int, Float]`: the Rust `Debug` spelling of a scalar list.
pkg_foreign_scalar_list_debug: fn(scalars: [ForeignScalar]) -> String Never! {
    names := [String]{}
    loop scalar in scalars -> names.push(scalar.debug_name())
    "[{names.join(", ")}]"
}

ForeignABIContract: struct {
    version: Int
    calling_convention: ForeignCallingConvention
    layout: ForeignLayoutModel
    ownership: ForeignOwnershipModel
    errors: ForeignErrorModel
    callbacks: ForeignCallbackModel
    async_completion: ForeignAsyncModel
    task_boundary: ForeignTaskBoundary
    safety: ForeignSafety
    integer: ForeignScalar
    floating: ForeignScalar
    boolean: ForeignScalar
    character: ForeignScalar
    string: ForeignScalar

    // `ForeignAbiContract::C`.
    c: fn() -> ForeignABIContract Never! {
        ForeignABIContract{
            version: FOREIGN_ABI_CONTRACT_VERSION,
            calling_convention: ForeignCallingConvention.C,
            layout: ForeignLayoutModel.CABI,
            ownership: ForeignOwnershipModel.SignatureDeclared,
            errors: ForeignErrorModel.JetBoundary,
            callbacks: ForeignCallbackModel.ReentrantThreadSafe,
            async_completion: ForeignAsyncModel.JetTask,
            task_boundary: ForeignTaskBoundary.RejectCapturedState,
            safety: ForeignSafety.GeneratedWrapper,
            integer: ForeignScalar.Int,
            floating: ForeignScalar.Float,
            boolean: ForeignScalar.Bool,
            character: ForeignScalar.Char,
            string: ForeignScalar.String
        }
    }

    // `ForeignAbiContract::CXX`.
    cxx: fn() -> ForeignABIContract Never! {
        contract := ForeignABIContract.c()
        contract.calling_convention = ForeignCallingConvention.Cpp
        contract.layout = ForeignLayoutModel.OpaqueHandle
        contract.ownership = ForeignOwnershipModel.OwnedHandle
        contract
    }

    // `ForeignAbiContract::MESSAGE` (the adapter contract).
    message: fn() -> ForeignABIContract Never! {
        contract := ForeignABIContract.c()
        contract.calling_convention = ForeignCallingConvention.HostMessage
        contract.layout = ForeignLayoutModel.AdapterTyped
        contract.ownership = ForeignOwnershipModel.AdapterOwned
        contract.errors = ForeignErrorModel.AdapterResult
        contract.callbacks = ForeignCallbackModel.AdapterMarshalled
        contract.async_completion = ForeignAsyncModel.AdapterMarshalled
        contract.task_boundary = ForeignTaskBoundary.AdapterMarshalled
        contract.safety = ForeignSafety.GeneratedWrapper
        contract
    }

    // `ForeignAbiContract::NATIVE`.
    native: fn() -> ForeignABIContract Never! {
        contract := ForeignABIContract.message()
        contract.calling_convention = ForeignCallingConvention.Rust
        contract.layout = ForeignLayoutModel.Native
        contract
    }

    // Map a normalized C declaration to the one descriptor-owned Jet scalar.
    // Unsupported pointers and declarations return `None` and are skipped by
    // the binder; no generated fake signature can reach the compiler.
    c_scalar: fn(self, normalized: String) -> ForeignScalar? Never! {
        if self.layout != ForeignLayoutModel.CABI -> return None
        if normalized.ends_with("*") {
            base: normalized.removesuffix("*").trim()
            if base == {
                "char" | "signed char" | "unsigned char" -> return Val(ForeignScalar.String)
                else -> return None
            }
        }
        if normalized == {
            "bool" | "_Bool" -> Val(ForeignScalar.Bool)
            "float" | "double" | "long double" -> Val(ForeignScalar.Float)
            "char" | "signed char" | "unsigned char" | "short" | "unsigned short" | "short int" | "unsigned short int" | "int" | "unsigned" | "unsigned int" | "signed" | "signed int" | "long" | "unsigned long" | "long int" | "unsigned long int" | "long long" | "unsigned long long" | "long long int" | "size_t" | "ssize_t" | "ptrdiff_t" | "intptr_t" | "uintptr_t" | "int8_t" | "int16_t" | "int32_t" | "int64_t" | "uint8_t" | "uint16_t" | "uint32_t" | "uint64_t" -> Val(ForeignScalar.Int)
            else -> None
        }
    }

    // Stable text included in generated stubs, binder output, and cache
    // provenance. A descriptor mutation therefore invalidates every product
    // made from it instead of silently reusing an old ABI.
    stamp: fn(self) -> String Never! {
        "{FOREIGN_DESCRIPTOR_SCHEMA};version={self.version};calling={self.calling_convention.debug_name()};layout={self.layout.debug_name()};ownership={self.ownership.debug_name()};errors={self.errors.debug_name()};callbacks={self.callbacks.debug_name()};async={self.async_completion.debug_name()};tasks={self.task_boundary.debug_name()};safety={self.safety.debug_name()};integer={self.integer.debug_name()};float={self.floating.debug_name()};bool={self.boolean.debug_name()};char={self.character.debug_name()};string={self.string.debug_name()}"
    }

    // Field-for-field equality; the stamp names every field.
    same_as: fn(self, other: ForeignABIContract) -> Bool Never! {
        self.stamp() == other.stamp()
    }
}

