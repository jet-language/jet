    fn debug_name(self) -> String Never! {
        if self == {
            .TypedStub -> "TypedStub"
            .SafeWrapper -> "SafeWrapper"
            .OwnershipConversion -> "OwnershipConversion"
            .LayoutValidation -> "LayoutValidation"
            .ErrorConversion -> "ErrorConversion"
            .CallbackValidation -> "CallbackValidation"
            .CacheProvenance -> "CacheProvenance"
            .PackageProvider -> "PackageProvider"
            .TargetDispatch -> "TargetDispatch"
            .UnsafeRawEscape -> "UnsafeRawEscape"
        }
    }
}

pub enum ForeignProvider {
    System
    Cargo
    Npm
    PyPi
    SwiftPm
    Jetpack

    fn debug_name(self) -> String Never! {
        if self == {
            .System -> "System"
            .Cargo -> "Cargo"
            .Npm -> "Npm"
            .PyPi -> "PyPi"
            .SwiftPm -> "SwiftPm"
            .Jetpack -> "Jetpack"
