// The canonical foreign binder descriptor registry, ported from
// jet_foundation::AST (ffi.rs and program_imports.rs ForeignLanguage).
//
// One descriptor is the contract between a foreign schema,
// generated Jet source, and the checked boundary. Adapters may vary their
// transport, but they do not get a second ABI vocabulary. Every binder, the
// hidden Rust bridge, and the C import stage read this one table.
use {
    jetpack_foundation.[
        ADA_MODULE_ROOT, ASM_MODULE_ROOT, BINDINGS_ROOT_SUBDIR, COBOL_MODULE_ROOT, COM_MODULE_ROOT, CPP_MODULE_ROOT,
        CS_MODULE_ROOT, C_MODULE_ROOT, DART_MODULE_ROOT, FORTRAN_MODULE_ROOT, GO_MODULE_ROOT,
        JAVA_MODULE_ROOT, JS_MODULE_ROOT, KW_RUST, LUA_MODULE_ROOT, OCTAVE_MODULE_ROOT,
        PASCAL_MODULE_ROOT, PERL_MODULE_ROOT, PHP_MODULE_ROOT, PWSH_MODULE_ROOT, PY_MODULE_ROOT,
        RUBY_MODULE_ROOT, R_MODULE_ROOT, SWIFT_MODULE_ROOT, TCL_MODULE_ROOT,
    ]
    jet_foundation.[Namespace]
    jetpack_trust_root.[CacheProvenance]
}

FOREIGN_DESCRIPTOR_SCHEMA: "jet-ffi-descriptor-v1"
FOREIGN_ABI_CONTRACT_VERSION: 1

// The registered foreign languages are ForeignLanguage's cases, written from
// the FFI effect's cases (Foreign/Bridge/ForeignLanguages.jet); each one's
// binder row is in pkg_foreign_binders below.
impl ForeignLanguage {
    // The `<lang>` mount root of `<lang>.<lib>`.
    root: fn(self) -> String Never! {
        if self == {
            .C -> C_MODULE_ROOT
            .Cpp -> CPP_MODULE_ROOT
            .Asm -> ASM_MODULE_ROOT
            .Rust -> KW_RUST
            .Py -> PY_MODULE_ROOT
            .JS -> JS_MODULE_ROOT
            .Swift -> SWIFT_MODULE_ROOT
            .Go -> GO_MODULE_ROOT
            .Java -> JAVA_MODULE_ROOT
            .DotNet -> CS_MODULE_ROOT
            .Tcl -> TCL_MODULE_ROOT
            .Lua -> LUA_MODULE_ROOT
            .Fortran -> FORTRAN_MODULE_ROOT
            .Cobol -> COBOL_MODULE_ROOT
            .Ada -> ADA_MODULE_ROOT
            .Pascal -> PASCAL_MODULE_ROOT
            .Dart -> DART_MODULE_ROOT
            .PowerShell -> PWSH_MODULE_ROOT
            .Perl -> PERL_MODULE_ROOT
            .Ruby -> RUBY_MODULE_ROOT
            .Php -> PHP_MODULE_ROOT
            .R -> R_MODULE_ROOT
            .Octave -> OCTAVE_MODULE_ROOT
            .Com -> COM_MODULE_ROOT
        }
    }

    // The language whose mount root is `root`.
    from_root: fn(root: String) -> ForeignLanguage? Never! {
        loop language in ForeignLanguage.all() {
            if language.root() == root -> return Val(language)
        }
        None
    }

    bindings_subdir: fn(self) -> String Never! {
        "{BINDINGS_ROOT_SUBDIR}/{self.root()}"
    }

    // Prefix used by generated bridge symbols. It lives beside the descriptor
    // table so the loader cannot grow a second language map.
    bridge_prefix: fn(self) -> String Never! {
        if self == {
            .C -> ""
            .Cpp -> "jet_cpp_"
            .Asm -> ""
            .Rust -> "jet_rust_"
            .Py -> "jet_py_"
            .JS -> "jet_js_"
            .Swift -> "jet_swift_"
            .Go -> "jet_go_"
            .Java -> "jet_java_"
            .DotNet -> "jet_cs_"
            .Tcl -> "jet_tcl_"
            .Lua -> "jet_lua_"
            .Fortran -> "jet_fortran_"
            .Cobol -> "jet_cobol_"
            .Ada -> "jet_ada_"
            .Pascal -> "jet_pascal_"
            .Dart -> "jet_dart_"
            .PowerShell -> "jet_pwsh_"
            .Perl -> "jet_perl_"
            .Ruby -> "jet_ruby_"
            .Php -> "jet_php_"
            .R -> "jet_r_"
            .Octave -> "jet_octave_"
            .Com -> "jet_com_"
        }
    }

    abi_contract: fn(self) -> ForeignABIContract Never! {
        if self == {
            .C | .Cpp | .Asm | .Swift | .Go | .Fortran | .Cobol | .Ada | .Pascal -> ForeignABIContract.c()
            .Rust -> ForeignABIContract.native()
            .Py | .JS | .Java | .DotNet | .Tcl | .Lua | .Dart | .PowerShell | .Perl | .Ruby | .Php | .R | .Octave | .Com -> ForeignABIContract.message()
        }
    }
}

