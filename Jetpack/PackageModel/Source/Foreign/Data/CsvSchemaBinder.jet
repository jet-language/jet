// CSV schema inference for the data binder, ported from jet_pkg_model::CBind
// (`parse_csv`, `csv_type`, `bind_csv`). Headers become wire keys; every data
// row takes part in scalar inference; empty cells make a field optional.
// Quoted fields keep commas, doubled quotes, and line breaks; CR, LF, and
// CRLF all end a record.

fn pkg_data_bind_csv(input: String, root_name: String) -> SchemaBuilder DataBindError! {
    rows :: pkg_data_parse_csv(input)
    headers :: rows[0]
    seen := [String]{}
    loop header in headers {
        if header.trim() == "" -> return Err(DataBindError{message: "CSV has a missing header"})
        if seen.contains(header) -> return Err(DataBindError{message: "CSV has a duplicate header {header}"})
        &seen.push(header)
    }
    width :: headers.len()
    columns := [[String]]{}
    loop _ in 0..<width -> &columns.push([String]{})
    loop row_index in 1..<rows.len() {
        row :: rows[row_index]
        if row.len() != width -> return Err(DataBindError{message: "CSV row has {row.len()} fields but header has {width}"})
        loop index in 0..<width -> &columns[index].push(row[index])
    }
    builder := SchemaBuilder.new()
    record :: &builder.begin_record(root_name)
    fields := [FieldSeed]{}
    loop index in 0..<width {
        inferred :: pkg_data_csv_type(columns[index])
        &fields.push(FieldSeed{wire_name: headers[index], ty: inferred.ty, optional: inferred.optional, note: None})
    }
    &builder.set_fields(record.index, fields)
    Ok(builder)
}

// Records of fields; trailing empty records are dropped and at least a header
// and one data row must remain.
fn pkg_data_parse_csv(input: String) -> [[String]] DataBindError! {
    if input == "" -> return Err(DataBindError{message: "CSV input is empty"})
    bytes :: input.bytes()
    rows := [[String]]{}
    row := [String]{}
    field := [U8]{}
    quoted := false
    after_quote := false
    index := 0
    loop index < bytes.len() {
        code :: Int.from_u8(bytes[index])
        if quoted {
            if code == 34 {
                if pkg_bytes_code(bytes, index + 1) == 34 {
                    &field.push(bytes[index])
                    index += 2
                } else {
                    quoted = false
                    after_quote = true
                    index += 1
                }
            } else {
                &field.push(bytes[index])
                index += 1
            }
            next
        }
        if after_quote {
            if code == {
                44 -> {
                    &row.push(pkg_bytes_text(field, 0, field.len()))
                    field = [U8]{}
                    after_quote = false
                    index += 1
                }
                10 | 13 -> {
                    &row.push(pkg_bytes_text(field, 0, field.len()))
                    field = [U8]{}
                    &rows.push(row)
                    row = [String]{}
                    after_quote = false
                    index += 1
                    if code == 13 && pkg_bytes_code(bytes, index) == 10 -> index += 1
                }
                else -> return Err(DataBindError{message: "CSV has characters after a closing quote"})
            }
            next
        }
        if code == {
            34 -> {
                if field.len() != 0 -> return Err(DataBindError{message: "CSV quote must start a field"})
                quoted = true
                index += 1
            }
            44 -> {
                &row.push(pkg_bytes_text(field, 0, field.len()))
                field = [U8]{}
                index += 1
            }
            10 | 13 -> {
                &row.push(pkg_bytes_text(field, 0, field.len()))
                field = [U8]{}
                &rows.push(row)
                row = [String]{}
                index += 1
                if code == 13 && pkg_bytes_code(bytes, index) == 10 -> index += 1
            }
            else -> {
                &field.push(bytes[index])
                index += 1
            }
        }
    }
    if quoted -> return Err(DataBindError{message: "CSV has an unterminated quoted field"})
    if after_quote || row.len() != 0 || field.len() != 0 {
        &row.push(pkg_bytes_text(field, 0, field.len()))
        &rows.push(row)
    }
    loop rows.len() > 0 && rows[rows.len() - 1].len() == 0 {
        _ :: &rows.pop()
    }
    if rows.len() < 2 -> return Err(DataBindError{message: "CSV needs a header and at least one data row"})
    Ok(rows)
}

// Bool, then Int, then Float when every non-empty cell parses as one;
// otherwise String. Any empty cell makes the field optional.
fn pkg_data_csv_type(values: [String]) -> (ty: BoundType, optional: Bool) Never! {
    optional := false
    nonempty := [String]{}
    loop value in values {
        if value == "" {
            optional = true
        } else {
            &nonempty.push(value)
        }
    }
    if nonempty.len() == 0 -> return (ty: BoundType.Scalar("String"), optional: optional)
    all_bool := true
    all_int := true
    all_float := true
    loop value in nonempty {
        if value == {
            "true" | "false" | "TRUE" | "FALSE" | "True" | "False" -> {}
            else -> all_bool = false
        }
        if Int.parse(value) == None -> all_int = false
        if Float.parse(value) == None -> all_float = false
    }
    if all_bool -> return (ty: BoundType.Scalar("Bool"), optional: optional)
    if all_int -> return (ty: BoundType.Scalar("Int"), optional: optional)
    if all_float -> return (ty: BoundType.Scalar("Float"), optional: optional)
    (ty: BoundType.Scalar("String"), optional: optional)
}
