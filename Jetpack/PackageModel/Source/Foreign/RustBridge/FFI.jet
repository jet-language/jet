//RS 
//RS /// Prepare the bridge for the target selected by the driver. Native source,
//RS /// inline asm, cache identity, cargo, and the eventual rustc link must agree on
//RS /// this exact triple.
//RS pub fn prepare_for_target(
//RS     bundle: &ProgramBundle,
//RS     target: &str,
//RS ) -> Result<Option<FfiLink>, Vec<Diagnostic>> {
//RS     prepare_resolving_target(bundle, || target.to_string())
//RS }
//RS 
//RS /// `prepare_for_target` with the target resolved only when the bundle has a
//RS /// foreign declaration, a C link, or a bridge-backed Core surface: resolving
//RS /// the host target runs `rustc -vV`, which a program without any of them (and
//RS /// every Cranelift dev build of one, #3953) must not pay for.
//RS fn prepare_resolving_target(
//RS     bundle: &ProgramBundle,
//RS     target: impl FnOnce() -> String,
//RS ) -> Result<Option<FfiLink>, Vec<Diagnostic>> {
//RS     let record_defs = collect_c_record_definitions(bundle);
//RS     let entries = collect_externs(bundle);
//RS     // The regex runtime is std-only in the generated prelude, so
//RS     // this bridge never asks for a hidden regex dependency.
//RS     let needs_regex = false;
//RS     // Core archive semantics are compiled from the canonical Jet source modules.
//RS     let needs_archive = false;
//RS     let needs_db = bundle
//RS         .used_core
//RS         .iter()
//RS         .any(|u| u == "core.db" || u.starts_with("core.db::"));
//RS     // D-DATA-READER1=A: byte-source loader calls select the hidden
//RS     // Parquet/Arrow provider. Bare module rows also arise from the semantic
//RS     // dependency closure (for example core.sync -> core.data), and must not
//RS     // pull a foreign bridge into a program that never calls a data loader.
