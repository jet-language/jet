//RS /// describe where the artifacts are. A v1 sidecar simply fails verification and
//RS /// the bridge rebuilds.
//RS const BRIDGE_ARTIFACTS_SCHEMA: &str = "jet-ffi-artifacts-v2";
//RS const SHARED_DEPS_SCHEMA: &str = "jet-ffi-shared-deps-v1";
//RS const BRIDGE_PROVENANCE_SCHEMA: &str = crate::ForeignBridge::PROVENANCE_SCHEMA;
