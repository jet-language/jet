// Rust: crates/jet-pkg-model/src/FFI.rs:570-727
// Resolve the selected target only after eligibility; ordinary programs never invoke rustc -vV.
// GATE #4494: native tool/bridge construction; target callback is the driver's selected triple.
fn prepare_resolving_target(program: RustBridgeProgram, target: fn() -> String) -> FFILink? RustBridgeError! {
    record_defs :: pkg_ffi_collect_c_record_definitions(program)
    entries :: pkg_ffi_collect_externs(program)
    needs :: RustBridgeNeeds.from_used_core(program.used_core)
    if entries.is_empty() && !program.cffi.links_c() && !needs.any() { return Ok(None) }
    target_triple :: target()
    if pkg_ffi_inline_asm_target_diagnostic(entries, target_triple) is Some(diagnostic) { return Err(pkg_ffi_single_error(diagnostic)) }
    entries :: if target_triple.split('-').next() == Some("wasm32") {
        entries.into_iter().filter(fn(entry) -> entry.inline.is_none()).collect()
    } else { entries }
    c_link_args :: if program.cffi.links_c() {
        pkg_cffi_rustc_link_args_for_target_with_entry(program.cffi, program.project_root, target_triple,
            program.modules.get(program.entry).map(fn(module) -> module.path))
            .map_err(fn(error) -> RustBridgeError{diagnostics: error.diagnostics})?
    } else { [] }
    if entries.is_empty() && !needs.any() { return Ok(None) }
    native_link_args :: if entries.iter().any(fn(entry) -> entry.c_abi) { c_link_args } else { [] }
    link :: pkg_ffi_build_bridge_full(RustBridgeBuild{entries: entries, needs: needs,
        authority_needs: program.authority_needs, handle_facts: program.cffi.handle_facts,
        record_defs: record_defs, link_closure: program.cffi.link_closure, native_link_args: native_link_args,
        selected_target: target_triple, project_root: Some(program.project_root)})?
    Ok(Some(link))
}
