//RS /// Build (or reuse) the hidden wrapper crate. Returns `Ok(None)` when the
//RS /// program has no foreign declarations and uses no bridge-backed Core surface.
//RS ///
//RS /// Archive containers and stream codecs are compiled from their canonical Jet
//RS /// source modules and do not activate this bridge. `core.db` and the other
//RS /// explicitly bridge-backed Core surfaces are selected below and receive their
//RS /// matching hidden provider. The compiler crate (`Source/`) stays
//RS /// zero-dependency (I6).
//RS pub fn prepare(bundle: &ProgramBundle) -> Result<Option<FfiLink>, Vec<Diagnostic>> {
//RS     prepare_resolving_target(bundle, host_target)
//RS }
//RS 
