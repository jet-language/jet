// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! M7 hidden cargo FFI bridge (S50).
//RS //!
//RS //! When a program declares `extern rust` blocks with crate dependencies, the
//RS //! driver materializes a cached cargo project under `~/.cache/jet/ffi/` and
//RS //! links the built rlib into the user's generated program. `JET_FFI_CACHE_DIR`
//RS //! overrides that root for isolated test or tool invocations. Each bridge key
//RS //! owns its generated sources under `<root>/<key>/`; every key that shares a
//RS //! (toolchain, target, profile, rustflags) build identity shares one Cargo
//RS //! target dir under `<root>/deps/<hash>/`, so the dependency graph is compiled
//RS //! once instead of once per key (#2075, `bridge_paths`).
//RS //! Every foreign entry carries its canonical binder descriptor in the cache
//RS //! identity, generated wrapper, and provenance sidecar.
//RS 
//RS use crate::Diagnostics::Diagnostic;
//RS use crate::AST::{
//RS     AccessConvention, ExternFn, ExternRustBlock, FfiHandleFact, FfiLinkClosure, ForeignLanguage,
//RS     InlineAsmContract, InlineAsmOutput, Item, ProgramBundle, Type,
//RS };
//RS use std::collections::{BTreeMap, BTreeSet, HashSet};
//RS use std::fmt::Write as _;
//RS use std::fs;
//RS use std::path::{Component, Path, PathBuf};
//RS use std::process::Command;
//RS 
//RS // FfiLink struct lives in AST for cross-seam sharing; re-export here.
//RS pub use crate::AST::FfiLink;
