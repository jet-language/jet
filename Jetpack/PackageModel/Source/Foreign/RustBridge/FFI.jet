//RS 
//RS /// Official Arrow Rust reader closure for `core.data` Parquet sources
//RS /// (D-DATA-READER1=A).  These crates live only in the hidden bridge, never in
//RS /// compiler or format-boundary crates (I6).
//RS pub const PARQUET_CRATE_SPEC: (&str, &str) = ("parquet", "59.3.0");
//RS pub const ARROW_ARRAY_CRATE_SPEC: (&str, &str) = ("arrow-array", "59.3.0");
//RS pub const ARROW_DATA_CRATE_SPEC: (&str, &str) = ("arrow-data", "59.3.0");
