//RS         "{native_decl}#[no_mangle]\npub unsafe extern \"C\" fn {cabi}(args: *const JetFfiSlot, argc: usize, out: *mut JetFfiSlot) -> i32 {{\n    match ffi_catch_unwind(|| {{\n{body}    }}) {{\n        Ok(code) => code,\n        Err(_) => {{ ffi_host_fault(); 1 }},\n    }}\n}}\n"
//RS     ))
//RS }
//RS 
//RS fn rust_type(ty: &Type, user_types: &HashSet<String>) -> String {
//RS     match ty {
//RS         Type::Int => "i64".to_string(),
//RS         Type::Float => "f64".to_string(),
//RS         Type::IntN { signed, bits } => format!("{}{}", if *signed { 'i' } else { 'u' }, bits),
//RS         Type::InlineRange { base, .. } => rust_type(base, user_types),
//RS         Type::Float32 => "f32".to_string(),
//RS         Type::Bool => "bool".to_string(),
//RS         Type::String => "String".to_string(),
//RS         Type::Char => "char".to_string(),
//RS         Type::List(inner) => format!("Vec<{}>", rust_type(inner, user_types)),
//RS         Type::Map { key, value, .. } => format!(
//RS             "std::collections::BTreeMap<{}, {}>",
//RS             rust_type(key, user_types),
//RS             rust_type(value, user_types)
//RS         ),
//RS         // D-MEM1 S6: the main codegen path (Codegen/Context.rs) now renders
//RS         // `Type::Shared` as `jet_std::JetShared<T>` (`Arc<RwLock<T>>`), not a
//RS         // bare `Arc<T>` — this C-FFI bridge type table is untested for
//RS         // `Shared<T>` crossing the boundary (no test exercises it; a
//RS         // concurrency handle in a C-ABI signature is not a realistic shape),
//RS         // left as the pre-S6 mapping rather than guessed at.
//RS         Type::Shared(inner) => format!("std::sync::Arc<{}>", rust_type(inner, user_types)),
//RS         Type::Option(inner) => format!("Option<{}>", rust_type(inner, user_types)),
//RS         Type::Result { ok, err } => format!(
//RS             "Result<{}, {}>",
//RS             rust_type(ok, user_types),
//RS             rust_type(err, user_types)
//RS         ),
//RS         Type::Fn { .. } => "Box<dyn std::any::Any>".to_string(),
//RS         Type::Named(name) if name == "Error" => "String".to_string(),
//RS         Type::Named(name) if user_types.contains(name) => crate::AST::mangle_path(name),
//RS         Type::Named(name) => name.clone(),
//RS         Type::Apply { name, args } if user_types.contains(name) => format!(
//RS             "{}<{}>",
//RS             crate::AST::mangle_path(name),
//RS             args.iter()
//RS                 .map(|a| rust_type(a, user_types))
//RS                 .collect::<Vec<_>>()
//RS                 .join(", ")
//RS         ),
//RS         Type::Apply { .. } | Type::TraitObject(_) | Type::Tuple(_) => {
//RS             "Box<dyn std::any::Any>".to_string()
//RS         }
//RS         // D-FIXARR1: [T#N] lowers to a real Rust array [T; N] in FFI too.
//RS         Type::FixedList { elem, len, .. } => format!("[{}; {}]", rust_type(elem, user_types), len),
//RS         Type::Tagged { inner, .. } => rust_type(inner, user_types),
//RS         // D-UNIONTYPE1=A: anonymous unions are not a C-FFI surface type.
//RS         Type::Union(_) => unreachable!("anonymous unions are rejected by FFI sema"),
//RS         // Runtime values carry no dimension metadata (I3): a quantity crosses
//RS         // the C ABI as its erased base numeric type.
//RS         Type::Quantity { base, .. } => rust_type(base, user_types),
//RS         // A compile-time measure only ever appears as a `Vec`/`Matrix`
//RS         // shape arg, never as its own C-FFI-crossing type.
//RS         Type::Measure(_) => unreachable!("type measure is not a C-FFI surface type"),
//RS     }
//RS }
