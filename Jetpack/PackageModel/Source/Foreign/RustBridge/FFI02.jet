//RS 
//RS /// Hand-written database runtime emitted into the bridge crate when `core.db`
//RS /// is used. This is the only code that touches the `rusqlite` crate.
//RS const DB_RUNTIME: &str = include_str!("Prelude/DB.rs");
//RS 
//RS /// The `aes-gcm` crate version backing `core.crypto` envelope (D-DEP-CRYPTO1).
//RS pub const AES_GCM_CRATE_SPEC: (&str, &str) = ("aes-gcm", "=0.10.3");
//RS 
//RS /// The `chacha20poly1305` crate version backing `core.crypto` envelope (D-DEP-CRYPTO1).
