//RS /// Hand-written application plugin-loader runtime emitted into the bridge
//RS /// crate when `core.plugin` is used (D-PLUGIN1 / D-DEP-WASM1=A).
//RS const PLUGIN_RUNTIME: &str = include_str!("Prelude/Plugin.rs");
//RS 
//RS /// Hand-written compiler-extension host runtime (D-DX5-HOOK1=A). Same
//RS /// wasmtime Component Model substrate as `PLUGIN_RUNTIME`, distinct WIT
//RS /// world (`compiler-extension-v1`) and entry points. Compiled only by the
//RS /// isolated `jetpack` binary; kept here beside other prelude runtimes for
//RS /// substrate parity. Not mixed into application `core.plugin` bridges.
//RS pub const COMPILER_EXTENSION_RUNTIME: &str = include_str!("Prelude/CompilerExtension.rs");
//RS 
//RS /// The `age` crate version backing `core.crypto.vault` (U13, D-JPK-SECRETCRYPTO1=A) —
//RS /// the age-style crypto bridge: X25519 recipients, ChaCha20-Poly1305 payload.
//RS /// Lives only here — never in the compiler's Cargo.toml (I6).
//RS pub const AGE_CRATE_SPEC: (&str, &str) = ("age", "0.10");
//RS 
//RS /// Hand-written age-style crypto runtime emitted into the bridge crate when
//RS /// `core.crypto.vault` is used (U13). This is the only place the `age` crate is
//RS /// touched.
