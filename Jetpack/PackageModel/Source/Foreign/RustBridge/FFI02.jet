//RS 
//RS /// The crypto helper binary source (c146). A thin stdin-protocol wrapper around
//RS /// the crate's own `jet_crypto_*_impl` functions (which is the *only* code that
//RS /// touches `ed25519-dalek`, D-DEP-CRYPTO1). `jet` shells out to this exactly as
//RS /// it already shells out to `cargo`/`rustc`, keeping the compiler crate itself
//RS /// zero-dependency (I6). Protocol (one command line on stdin, hex-encoded args):
//RS ///   `keygen`                          → stdout `<seed_hex> <pub_hex>`
//RS ///   `sign <seed_hex> <msg_hex>`       → stdout `<sig_hex>`         (exit 0)
//RS ///   `verify <pub_hex> <msg_hex> <sig_hex>` → exit 0 valid / 2 invalid / 1 error
//RS fn emit_crypto_helper_bin(crate_name: &str) -> String {
