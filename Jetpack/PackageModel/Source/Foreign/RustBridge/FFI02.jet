// Rust: crates/jet-pkg-model/src/FFI.rs:2414
// Crate-root modules retained by the standalone Outcome JSON decoding seam.
pub fn crypto_bridge_root_modules() -> String {
    out := String.new()
    loop (name, source) in [
        ("jet_encoding_errors", FFI_ENCODING_ERRORS_RUNTIME),
        ("jet_json_number", FFI_JSON_NUMBER_RUNTIME),
        ("DataTree", FFI_DATATREE_RUNTIME),
        ("EncodingJson", FFI_ENCODING_JSON_RUNTIME),
        ("RuntimeDiagnosticCore", FFI_RUNTIME_DIAGNOSTIC_CORE)
    ] {
        &out.push_str("mod ")
        &out.push_str(name)
        &out.push_str(" {{\n")
        &out.push_str(source)
        &out.push_str("\n}}\n")
    }
    out
}

// Rust: crates/jet-pkg-model/src/FFI.rs:2435
pub fn crypto_bridge_entropy_runtime() -> String {
    out := pkg_ffi_standalone_outcome_runtime()
    &out.push('\n')
    &out.push_str(FFI_CRYPTO_ENTROPY_RUNTIME)
    &out.push('\n')
    &out.push_str("use jet_crypto_entropy::{{jet_crypto_entropy_fill, JetCryptoEntropyError}};\n")
    out
}

