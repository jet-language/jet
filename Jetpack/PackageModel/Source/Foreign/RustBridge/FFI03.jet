//RS /// Where one bridge cache key lives on disk. The one owner of that layout, so
//RS /// the builder and the health check cannot drift apart (I8).
//RS ///
//RS /// - `target_dir` (`<ffi cache>/deps/<build-identity hash>/`) is the Cargo
//RS ///   target dir shared by every key built with the same toolchain, target,
//RS ///   profile, and rustflags. Compiling the dependency graph (`wasmtime`, `age`,
//RS ///   `rustls`, `ed25519-dalek`, …) is the expensive part of a bridge build and
//RS ///   it is identical across keys, so sharing it turns every key after the first
//RS ///   into a leaf-crate-only build instead of a cold graph per key.
//RS ///
//RS /// Nothing collides in the shared dir: every artifact name embeds the key
//RS /// (`libjet_ffi_<key>.rlib`, `jet-crypto-helper-<key>`), including the helper
//RS /// bin targets, whose fixed names would otherwise have two crypto-bearing keys
//RS /// overwriting each other's blessed binary at Cargo's uplift path.
//RS struct BridgePaths {
//RS     /// Per-key inputs and lock.
//RS     cache_root: PathBuf,
//RS     crate_name: String,
//RS     /// Shared Cargo target dir (`CARGO_TARGET_DIR`).
//RS     target_dir: PathBuf,
//RS     /// `<target_dir>/<triple>/release` — every blessed artifact and the digest
//RS     /// sidecar that blesses it.
//RS     target: PathBuf,
//RS     rlib: PathBuf,
//RS     crypto_helper: PathBuf,
//RS     secrets_helper: PathBuf,
//RS     target_deps_dir: PathBuf,
//RS     host_deps_dir: PathBuf,
//RS     provenance: PathBuf,
//RS }
//RS 
//RS fn bridge_paths(
//RS     key: &str,
//RS     selected_target: &str,
//RS     native_link_args: &[String],
//RS ) -> BridgePaths {
//RS     let cache_root = cache_dir().join(key);
//RS     let crate_name = format!("jet_ffi_{key}");
//RS     let target_dir = shared_target_dir(selected_target, native_link_args);
//RS     let target = target_dir.join(selected_target).join("release");
//RS     BridgePaths {
//RS         rlib: target.join(format!("lib{crate_name}.rlib")),
//RS         target_deps_dir: target.join("deps"),
//RS         host_deps_dir: target_dir.join("release/deps"),
//RS         crypto_helper: target.join(crypto_helper_bin_name(key)),
//RS         secrets_helper: target.join(secrets_helper_bin_name(key)),
