// Rust: crates/jet-pkg-model/src/FFI.rs:3819
fn pkg_ffi_collect_crate_deps(entries: [ExternEntry]) -> [String: String] Never! {
    deps := [String: String]{}
    loop entry in entries {
        if entry.crate_spec == "std" -> next
        if pkg_ffi_parse_crate_spec(entry.crate_spec) == .Val(spec) {
            deps[spec.name] = spec.version
        }
    }
    deps
}

// Rust: crates/jet-pkg-model/src/FFI.rs:3833
pub fn pkg_ffi_parse_crate_spec(spec: String) -> (name: String, version: String)? Never! {
    if spec == "std" -> return None
    parts :: spec.split_once("@") ?? return None
    if parts.before == "" || parts.after == "" -> return None
    Val((name: parts.before, version: parts.after))
}

