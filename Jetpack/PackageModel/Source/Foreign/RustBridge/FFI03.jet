// Rust: crates/jet-pkg-model/src/FFI.rs:4123
// Canonical language-set projection used by boundary rows and verification.
// GATE #4499: ForeignLanguage equality/hash/order as a user-type map key.
fn pkg_ffi_entry_languages(entries: [ExternEntry]) -> [ForeignLanguage] Never! {
    languages := [ForeignLanguage: Bool]{}
    loop entry in entries {
        if pkg_ffi_foreign_language_for_entry(entry) == .Val(language) {
            languages[language] = true
        }
    }
    ordered := languages.keys().to_list()
    &ordered.sort()
    ordered
}

// Rust: crates/jet-pkg-model/src/FFI.rs:4222
// identity_static_link_inputs -> BridgeCache.pkg_ffi_identity_static_link_inputs:169.
// Native OSPath encoded bytes are required (canonical string path drift recorded).

// Rust: crates/jet-pkg-model/src/FFI.rs:4260
fn pkg_ffi_type_key(ty: Type) -> String Never! {
    if ty == {
        .Int -> "Int"
        .Float -> "Float"
        .IntN(signed, bits) -> "{if signed -> "I" else -> "U"}{bits}"
        .InlineRange(base, lo, hi) -> "InlineRange<{pkg_ffi_type_key(base)},{lo}..{hi}>"
        .Float32 -> "F32"
        .Bool -> "Bool"
        .String -> "String"
        .Char -> "Char"
        .List(inner) -> "List<{pkg_ffi_type_key(inner)}>"
        .Map(key, value, _) -> "Map<{pkg_ffi_type_key(key)},{pkg_ffi_type_key(value)}>"
        .Shared(inner) -> "Shared<{pkg_ffi_type_key(inner)}>"
        .Option(inner) -> "{pkg_ffi_type_key(inner)}?"
        .Result(ok, err) -> "Result<{pkg_ffi_type_key(ok)},{pkg_ffi_type_key(err)}>"
        .Fn(params, ret, _, _, _, _) -> {
            rendered := [String]{}
            loop param in params -> &rendered.push(pkg_ffi_type_key(param))
            result :: if ret == { .Val(value) -> pkg_ffi_type_key(value), .None -> "" }
            "fn({rendered.join(",")})->{result}"
        }
        .Named(name) -> name
        .Apply(name, args) -> {
            rendered := [String]{}
            loop arg in args -> &rendered.push(pkg_ffi_type_key(arg))
            "{name}<{rendered.join(",")}>"
        }
        .TraitObject(traits) -> "dyn {traits.join(" + ")}"
        .Tuple(fields) -> {
            rendered := [String]{}
            loop field in fields -> &rendered.push("{field.name}:{pkg_ffi_type_key(field.ty)}")
            "({rendered.join(",")})"
        }
        .FixedList(elem, len) -> "List<{pkg_ffi_type_key(elem)}#{measure_expression(len)}>"
        .Tagged(marker, inner) -> "#{marker}:{pkg_ffi_type_key(inner)}"
        .Union(members) -> {
            rendered := [String]{}
            loop member in members -> &rendered.push(pkg_ffi_type_key(member))
            rendered.join("|")
        }
        .Quantity(base, dimension) -> "Quantity<{pkg_ffi_type_key(base)},{dimension.identity()}>"
        .Measure(measure) -> measure.expression()
    }
}

