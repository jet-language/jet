// cache_key_full -> BridgeCache.RustBridgeKeyInputs.cache_key:38;
// identity_entry115/identity_inline136/identity_crypto_runtimes101 retain
// all ordered input fields, runtime source stamps and helper source identity.
// Static libraries enter the key through identity_static_link_inputs169.
// Handle facts and authority names use sorted_unique158 (integration drift
// recorded: canonical dedup must use a map/set, not linear contains).

// Rust: crates/jet-pkg-model/src/FFI.rs:4059
fn pkg_ffi_foreign_language_for_entry(entry: ExternEntry) -> ForeignLanguage? Never! {
    if entry.c_abi {
        // COM generated symbols retain their descriptor through the C ABI.
        if entry.rust_path.starts_with(ForeignLanguage.Com.bridge_prefix()) -> return Val(ForeignLanguage.Com)
        return Val(ForeignLanguage.C)
    }
    if entry.inline == {
        .Val(inline) -> if inline.lang == {
            "cpp" -> Val(ForeignLanguage.Cpp)
            "c" -> Val(ForeignLanguage.C)
            else -> None
        }
        .None -> Val(ForeignLanguage.Rust)
    }
}

// Rust: crates/jet-pkg-model/src/FFI.rs:4081
fn pkg_ffi_foreign_descriptor_stamp(language: ForeignLanguage) -> String Never! {
    descriptor :: pkg_binder_descriptor(language) ?? panic("missing canonical foreign binder descriptor for {language.debug_name()}")
    descriptor.stamp()
}

// Rust: crates/jet-pkg-model/src/FFI.rs:4087
fn pkg_ffi_foreign_descriptor_stamps(entries: [ExternEntry]) -> [String] Never! {
    stamps := [String: Bool]{}
    loop entry in entries {
        if pkg_ffi_foreign_language_for_entry(entry) == .Val(language) {
            stamps[pkg_ffi_foreign_descriptor_stamp(language)] = true
        }
    }
    keys := stamps.keys().to_list()
    &keys.sort()
    keys
}

// Rust: crates/jet-pkg-model/src/FFI.rs:4099
