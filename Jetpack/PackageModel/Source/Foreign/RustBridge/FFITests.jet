// Rust: crates/jet-pkg-model/src/FFI.rs:1615-1626
// smtp_adapter uses canonical core.email and SHA256 owners instead of including retired Rust Prelude code.
// Rust: crates/jet-pkg-model/src/FFI.rs:1628
SMTP_CANCELLED :: AtomicBool.new(false)
// Rust: crates/jet-pkg-model/src/FFI.rs:1630
SMTP_DEADLINE_MS :: AtomicI64.new(I64.MAX)
// Rust: crates/jet-pkg-model/src/FFI.rs:1632
SMTP_WIPES :: AtomicUsize.new(0)
// Rust: crates/jet-pkg-model/src/FFI.rs:1633
SMTP_ENV_LOCK :: Mutex.new(())
// Rust: crates/jet-pkg-model/src/FFI.rs:1635
fn smtp_now_ms() -> I64 { SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_millis().min(I64.MAX as U128) as I64 }
// Rust: crates/jet-pkg-model/src/FFI.rs:1642
fn smtp_cancelled() -> Bool { SMTP_CANCELLED.load(Ordering.SeqCst) }
// Rust: crates/jet-pkg-model/src/FFI.rs:1645
fn smtp_remaining() -> I64? {
    deadline :: SMTP_DEADLINE_MS.load(Ordering.SeqCst)
    if deadline != I64.MAX { Some(deadline.saturating_sub(smtp_now_ms())) } else { None }
}
// Rust: crates/jet-pkg-model/src/FFI.rs:1649
fn smtp_wipe(bytes: &[U8]) -> { &bytes.fill(0); &bytes.clear() }
// Rust: crates/jet-pkg-model/src/FFI.rs:1653
fn smtp_counting_wipe(bytes: &[U8]) -> { &bytes.fill(0); &bytes.clear(); _ :: SMTP_WIPES.fetch_add(1, Ordering.SeqCst) }
// Rust: crates/jet-pkg-model/src/FFI.rs:1658
fn smtp_sha256(bytes: [U8]) -> [U8; 32] { Sha256.digest(bytes).into() }
// Rust: crates/jet-pkg-model/src/FFI.rs:1662
fn smtp_dkim_sign(key: [U8], message: [U8]) -> [U8] Err! {
    seed :: key.try_into() as Result[[U8; 32], String]
    seed :: seed.map_err(fn(_) -> "DKIM test key length")?
    Ok(SigningKey.from_bytes(seed).sign(message).to_bytes().to_vec())
}
// Rust: crates/jet-pkg-model/src/FFI.rs:1674
fn smtp_runtime() -> smtp_adapter.RuntimeFns {
    smtp_adapter.RuntimeFns{tls_begin: jet_net_tls_begin_impl, tls_begin_ca: jet_net_tls_begin_with_ca_impl,
        tls_handshake_step: jet_net_tls_handshake_step_impl, tls_set_poll_timeout: jet_net_tls_set_poll_timeout_impl,
        tls_read: jet_net_tls_read_bytes_impl, tls_write_all: jet_net_tls_write_all_bytes_impl, tls_close: jet_net_tls_close_impl,
        wipe: smtp_wipe, sha256: smtp_sha256, ed25519_sign: smtp_dkim_sign, cancelled: smtp_cancelled,
        remaining_ms: smtp_remaining, accepted_at: smtp_adapter.runtime_now}
}
// Rust: crates/jet-pkg-model/src/FFI.rs:1691
fn smtp_counting_runtime() -> smtp_adapter.RuntimeFns { runtime := smtp_runtime(); runtime.wipe = smtp_counting_wipe; runtime }
// Rust: crates/jet-pkg-model/src/FFI.rs:1697
fn smtp_server_config() -> Arc[ServerConfig] {
    certs :: jet_net_tls_pem_certificates(include_bytes("../../../tests/fixtures/tls/smtp.server.cert.pem")).unwrap()
    key_text :: std.str.from_utf8(include_bytes("../../../tests/fixtures/tls/smtp.server.key.pem")).unwrap()
    body :: key_text.strip_prefix("-----BEGIN PRIVATE KEY-----").unwrap().strip_suffix("-----END PRIVATE KEY-----\n").unwrap()
    key :: PrivateKeyDer.Pkcs8(PrivatePkcs8KeyDer.from(jet_net_tls_pem_base64(body).unwrap()))
    Arc.new(ServerConfig.builder().with_no_client_auth().with_single_cert(certs, key).unwrap())
}
// Rust: crates/jet-pkg-model/src/FFI.rs:1722
fn smtp_read_line[T: io.Read](input: &T) -> String {
    bytes := [] as [U8]
    loop {
        byte := [0 as U8; 1]
        if &input.read(&byte).unwrap_or(0) == 0 { break }
        &bytes.push(byte[0])
        if bytes.ends_with(b"\r\n") { break }
    }
    String.from_utf8(bytes).unwrap()
}
// Rust: crates/jet-pkg-model/src/FFI.rs:1738
pub enum SMTPFixture { Success, CloseAfterData, RejectAuth, StallGreeting }
// Rust: crates/jet-pkg-model/src/FFI.rs:1745-1816
fn smtp_tls_session[T: io.Read + io.Write](input: &T, greeting: Bool, fixture: SMTPFixture, transcript: Arc[Mutex[[String]]]) -> {
    if greeting {
        if fixture is SMTPFixture.StallGreeting { byte := [0 as U8; 1]; _ :: &input.read(&byte); return }
        &input.write_all(b"220 relay ready\r\n").unwrap(); &input.flush().unwrap()
    }
    ehlo :: smtp_read_line(&input); &transcript.lock().unwrap().push(ehlo)
    assert_eq(ehlo, "EHLO localhost\r\n")
    &input.write_all(b"250-relay\r\n250 AUTH PLAIN LOGIN\r\n").unwrap(); &input.flush().unwrap()
    auth :: smtp_read_line(&input); &transcript.lock().unwrap().push(auth)
    assert(auth.starts_with("AUTH PLAIN "))
    assert(!auth.contains("swordfish"))
    if fixture is SMTPFixture.RejectAuth { &input.write_all(b"535 bad credentials\r\n").unwrap(); &input.flush().unwrap(); return }
    &input.write_all(b"235 authenticated\r\n").unwrap(); &input.flush().unwrap()
    mail :: smtp_read_line(&input); &transcript.lock().unwrap().push(mail)
    assert(mail.starts_with("MAIL FROM:<sender@example.com>"))
    &input.write_all(b"250 sender ok\r\n").unwrap(); &input.flush().unwrap()
    rcpt :: smtp_read_line(&input); &transcript.lock().unwrap().push(rcpt)
    assert(rcpt.starts_with("RCPT TO:<recipient@example.net>"))
    &input.write_all(b"250 recipient ok\r\n").unwrap(); &input.flush().unwrap()
    data :: smtp_read_line(&input); &transcript.lock().unwrap().push(data)
    assert_eq(data, "DATA\r\n")
    &input.write_all(b"354 continue\r\n").unwrap(); &input.flush().unwrap()
    body := [] as [U8]
    loop {
        byte := [0 as U8; 1]
        if &input.read(&byte).unwrap_or(0) == 0 { return }
        &body.push(byte[0])
        if body.ends_with(b"\r\n.\r\n") { break }
    }
    &transcript.lock().unwrap().push(String.from_utf8_lossy(body).into_owned())
    if fixture is SMTPFixture.CloseAfterData { return }
    &input.write_all(b"250 queued q-1\r\n").unwrap(); &input.flush().unwrap()
    quit :: smtp_read_line(&input); &transcript.lock().unwrap().push(quit)
    _ :: &input.write_all(b"221 bye\r\n"); _ :: &input.flush()
}
