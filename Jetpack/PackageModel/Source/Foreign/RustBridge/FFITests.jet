// Rust: crates/jet-pkg-model/src/FFI.rs:904
fn entry() -> ExternEntry {
    ExternEntry{jet_name: "add_one", rust_path: "", wrapper_name: "jet_ffi_add_one",
        params: [(AccessConvention.Read, Type.Int)], param_names: ["value"], return_type: Some(Type.Int),
        crate_spec: "std", line_hint: "`#FFI(asm) fn add_one`",
        inline: Some(InlineEntry{lang: "asm", source: "mov rax, {{value}}; -> return", param_names: ["value"],
            asm_contract: Some(InlineAsmContract{target: "x86_64-unknown-linux-gnu", output: Some(InlineAsmOutput.Register("rax")), clobbers: []})}),
        c_abi: false, generated: false, c_module: false, close: None}
}
// Rust: crates/jet-pkg-model/src/FFI.rs:932
#Test("inline_asm_uses_selected_target_instead_of_host_architecture") {
    entries :: [entry()]
    assert(pkg_ffi_inline_asm_target_diagnostic(entries, "x86_64-unknown-linux-gnu").is_none())
    diagnostic :: pkg_ffi_inline_asm_target_diagnostic(entries, "aarch64-unknown-linux-gnu").expect("x86 register body must be rejected for selected aarch64 target")
    assert_eq(diagnostic.code, "E3223")
    assert(diagnostic.what.contains("aarch64-unknown-linux-gnu"))
}
// Rust: crates/jet-pkg-model/src/FFI.rs:942
#Test("inline_asm_uses_checked_output_and_discarded_clobber_operands") {
    value := entry()
    inline := &value.inline.as_mut().unwrap()
    inline.source = "add {{value}}, 1 ; -> return\n; clobbers rbx, rbx"
    inline.asm_contract = Some(InlineAsmContract{target: "x86_64-unknown-linux-gnu", output: Some(InlineAsmOutput.Parameter(0)), clobbers: ["rbx"]})
    wrapper :: pkg_ffi_emit_asm_wrapper(value, value.inline.unwrap())
    assert(wrapper.contains("value = inout(reg) p0"), wrapper)
    assert(wrapper.contains("out(\"rbx\") _"), wrapper)
    assert(!wrapper.contains("lateout(\"rbx\") _"), wrapper)
    assert_eq(wrapper.matches("out(\"rbx\") _").count(), 1, "duplicate clobbers must normalize to one output operand: {wrapper}")
}
// Rust: crates/jet-pkg-model/src/FFI.rs:964
#Test("inline_asm_fixed_output_is_early_clobber") {
    value :: entry()
    wrapper :: pkg_ffi_emit_asm_wrapper(value, value.inline.unwrap())
    assert(wrapper.contains("out(\"rax\") __jet_result"), wrapper)
    assert(!wrapper.contains("lateout(\"rax\")"), wrapper)
    assert(wrapper.contains("#[no_mangle]"), wrapper)
    assert(wrapper.contains("jet_inline_jet_ffi_add_one"), wrapper)
}
