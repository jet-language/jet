// Rust: crates/jet-pkg-model/src/FFI.rs:1096
fn client(addr: SocketAddr) -> StreamOwned[ClientConnection, TcpStream] {
    _ :: rustls.crypto.ring.default_provider().install_default()
    config :: Arc.new(ClientConfig.builder().dangerous().with_custom_certificate_verifier(Arc.new(AcceptFixture{})).with_no_client_auth())
    name :: ServerName.try_from("localhost").expect("name")
    conn :: ClientConnection.new(config, name).expect("conn")
    sock :: TcpStream.connect(addr).expect("connect")
    sock.set_read_timeout(Some(Duration.from_secs(2))).unwrap()
    sock.set_write_timeout(Some(Duration.from_secs(2))).unwrap()
    StreamOwned.new(conn, sock)
}
// Rust: crates/jet-pkg-model/src/FFI.rs:1159
fn exchange(stream: &StreamOwned[ClientConnection, TcpStream], request: [U8]) -> String {
    &stream.write_all(request).expect("write")
    &stream.flush().expect("flush")
    raw := [] as [U8]
    buf := [0 as U8; 4096]
    loop {
        match &stream.read(&buf) {
            Ok(0) -> break
            Ok(n) -> {
                &raw.extend_from_slice(buf[..n])
                if raw.windows(4).position(fn(window) -> window == b"\r\n\r\n") is Some(header_end) {
                    headers :: std.str.from_utf8(raw[..header_end]).unwrap_or("")
                    length :: headers.lines().skip(1).find_map(fn(line) -> {
                        (name, value) :: line.split_once(':') ?? return None
                        trimmed := value.trim() // #4303
                        if name.eq_ignore_ascii_case("content-length") { trimmed.parse[UInt]().ok() } else { None }
                    })
                    if length is Some(size) { if raw.len() >= header_end + 4 + size { break } } else { break }
                }
            }
            Err(error) if error.kind() is io.ErrorKind.WouldBlock | io.ErrorKind.TimedOut -> { if !raw.is_empty() { break } }
            Err(error) -> panic("read: {error}")
        }
    }
    String.from_utf8_lossy(raw).into_owned()
}
// Rust: crates/jet-pkg-model/src/FFI.rs:1209
#Test("session_keep_alive_reuses_rustls_connection") {
    (cert, key) :: fixture_tls()
    jet_http_server_tls_validate_impl(cert, key).expect("validate")
    listener :: TcpListener.bind("127.0.0.1:0").unwrap()
    addr :: listener.local_addr().unwrap()
    calls :: Arc.new(AtomicUsize.new(0)); server_calls :: calls.clone()
    stop :: Arc.new(AtomicBool.new(false)); server_stop :: stop.clone()
    server :: thread.spawn(fn() -> {
        (stream, _) :: listener.accept().unwrap()
        dispatch_calls :: server_calls.clone()
        jet_http_server_tls_session_impl(cert, key, stream, fn(raw, force_close) -> {
            n :: dispatch_calls.fetch_add(1, Ordering.AcqRel) + 1
            keep :: !force_close && !std.str.from_utf8(raw).unwrap_or("").to_ascii_lowercase().contains("connection: close")
            body :: "pong{n}"
            response :: "HTTP/1.1 200 OK\r\nContent-Length: {body.len()}\r\nConnection: {if keep { "keep-alive" } else { "close" }}\r\n\r\n{body}"
            Ok((response.into_bytes(), keep))
        }, fn(_, _, _, _) -> Err("unexpected HTTP/2 ALPN"), fn() -> server_stop.load(Ordering.Acquire)).expect("tls session")
    })
    peer := client(addr)
    first :: exchange(&peer, b"GET /ping HTTP/1.1\r\nHost: localhost\r\n\r\n")
    second :: exchange(&peer, b"GET /ping HTTP/1.1\r\nHost: localhost\r\n\r\n")
    assert(first.ends_with("\r\n\r\npong1"), first)
    assert(second.ends_with("\r\n\r\npong2"), second)
    assert(first.to_ascii_lowercase().contains("connection: keep-alive"), first)
    assert_eq(calls.load(Ordering.Acquire), 2)
    stop.store(true, Ordering.Release)
    _ :: &peer.write_all(b"GET /ping HTTP/1.1\r\nHost: localhost\r\n\r\n")
    _ :: &peer.flush()
    server.join().unwrap()
    assert_eq(calls.load(Ordering.Acquire), 2, "stop must prevent keep-alive reuse without client Connection: close")
}
// Rust: crates/jet-pkg-model/src/FFI.rs:1282
fn read_one(stream: &StreamOwned[ClientConnection, TcpStream], pending: &[U8]) -> String {
    buf := [0 as U8; 4096]
    loop {
        if pending.windows(4).position(fn(window) -> window == b"\r\n\r\n") is Some(header_end) {
            headers :: std.str.from_utf8(pending[..header_end]).unwrap_or("")
            length :: headers.lines().skip(1).find_map(fn(line) -> {
                (name, value) :: line.split_once(':') ?? return None
                trimmed := value.trim() // #4303
                if name.eq_ignore_ascii_case("content-length") { trimmed.parse[UInt]().ok() } else { None }
            })
            if length is Some(size) {
                response_end :: header_end + 4 + size
                if pending.len() >= response_end {
                    response :: &pending.drain(..response_end).collect()
                    return String.from_utf8_lossy(response).into_owned()
                }
            }
        }
        match &stream.read(&buf) {
            Ok(0) -> break
            Ok(n) -> &pending.extend_from_slice(buf[..n])
            Err(error) if error.kind() is io.ErrorKind.WouldBlock | io.ErrorKind.TimedOut -> { if !pending.is_empty() { break } }
            Err(error) -> panic("read: {error}")
        }
    }
    response :: mem.take(&pending)
    String.from_utf8_lossy(response).into_owned()
}
// Rust: crates/jet-pkg-model/src/FFI.rs:1326
#Test("session_preserves_pipelined_leftover_bytes") {
    (cert, key) :: fixture_tls()
    listener :: TcpListener.bind("127.0.0.1:0").unwrap(); addr :: listener.local_addr().unwrap()
    calls :: Arc.new(AtomicUsize.new(0)); server_calls :: calls.clone()
    server :: thread.spawn(fn() -> {
        (stream, _) :: listener.accept().unwrap(); dispatch_calls :: server_calls.clone()
        jet_http_server_tls_session_impl(cert, key, stream, fn(raw, force_close) -> {
            n :: dispatch_calls.fetch_add(1, Ordering.AcqRel) + 1
            keep :: !force_close && !std.str.from_utf8(raw).unwrap_or("").to_ascii_lowercase().contains("connection: close")
            body :: "pipe{n}"
            response :: "HTTP/1.1 200 OK\r\nContent-Length: {body.len()}\r\nConnection: {if keep { "keep-alive" } else { "close" }}\r\n\r\n{body}"
            Ok((response.into_bytes(), keep))
        }, fn(_, _, _, _) -> Err("unexpected HTTP/2 ALPN"), fn() -> false).expect("tls session")
    })
    peer := client(addr)
    &peer.write_all(b"GET /a HTTP/1.1\r\nHost: localhost\r\n\r\nGET /b HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").unwrap()
    &peer.flush().unwrap()
    pending := [] as [U8]
    first :: read_one(&peer, &pending); second :: read_one(&peer, &pending)
    assert(first.ends_with("\r\n\r\npipe1"), first)
    assert(second.ends_with("\r\n\r\npipe2"), second)
    assert_eq(calls.load(Ordering.Acquire), 2)
    server.join().unwrap()
}
// Rust: crates/jet-pkg-model/src/FFI.rs:1383
#Test("session_forces_connection_close_on_request_cap") {
    (cert, key) :: fixture_tls()
    listener :: TcpListener.bind("127.0.0.1:0").unwrap(); addr :: listener.local_addr().unwrap()
    calls :: Arc.new(AtomicUsize.new(0)); server_calls :: calls.clone()
    server :: thread.spawn(fn() -> {
        (stream, _) :: listener.accept().unwrap(); dispatch_calls :: server_calls.clone()
        jet_http_server_tls_session_limited(cert, key, stream, fn(_raw, force_close) -> {
            n :: dispatch_calls.fetch_add(1, Ordering.AcqRel) + 1; body :: "cap{n}"; keep :: !force_close
            response :: "HTTP/1.1 200 OK\r\nContent-Length: {body.len()}\r\nConnection: {if keep { "keep-alive" } else { "close" }}\r\n\r\n{body}"
            Ok((response.into_bytes(), keep))
        }, fn(_, _, _, _) -> Err("unexpected HTTP/2 ALPN"), fn() -> false, 2).expect("tls session")
    })
    peer := client(addr)
    first :: exchange(&peer, b"GET /one HTTP/1.1\r\nHost: localhost\r\n\r\n")
    second :: exchange(&peer, b"GET /two HTTP/1.1\r\nHost: localhost\r\n\r\n")
    assert(first.ends_with("\r\n\r\ncap1"), first)
    assert(first.to_ascii_lowercase().contains("connection: keep-alive"), "first of cap must stay keep-alive: {first}")
    assert(second.ends_with("\r\n\r\ncap2"), second)
    assert(second.to_ascii_lowercase().contains("connection: close"), "final capped request must force Connection: close: {second}")
    assert_eq(calls.load(Ordering.Acquire), 2)
    server.join().unwrap()
}
