fn key(value: ExternEntry, target: String) -> String {
    RustBridgeKeyInputs{entries: [value], deps: [:], needs: RustBridgeNeeds.none(), authority_needs: [],
        handle_facts: [], record_source: "", link_closure: FfiLinkClosure.default(), selected_target: target,
        rust_toolchain: "", native_toolchain: None, native_link_args: [], foundation_source_digest: None}.cache_key()
}
// Rust: crates/jet-pkg-model/src/FFI.rs:979
#Test("inline_asm_contract_changes_invalidate_bridge_identity") {
    original :: entry()
    changed := original.clone()
    &changed.inline.as_mut().unwrap().source.push_str(" ; body")
    assert_ne(key(original, "x86_64-unknown-linux-gnu"), key(changed, "x86_64-unknown-linux-gnu"))
    assert_ne(key(original, "x86_64-unknown-linux-gnu"), key(original, "aarch64-unknown-linux-gnu"))
    changed_contract := original.clone()
    &changed_contract.inline.as_mut().unwrap().asm_contract.as_mut().unwrap().clobbers.push("rbx")
    assert_ne(key(original, "x86_64-unknown-linux-gnu"), key(changed_contract, "x86_64-unknown-linux-gnu"))
}
