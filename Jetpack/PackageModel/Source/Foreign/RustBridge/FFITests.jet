// Rust: crates/jet-pkg-model/src/FFI.rs:1486
fn tls_fixture() -> (SocketAddr, thread.JoinHandle[Void]) {
    cert_pem :: include_bytes("../../../tests/fixtures/tls/smtp.server.cert.pem")
    key_pem :: include_bytes("../../../tests/fixtures/tls/smtp.server.key.pem")
    certs :: jet_net_tls_pem_certificates(cert_pem).unwrap()
    key_text :: std.str.from_utf8(key_pem).unwrap()
    body :: key_text.strip_prefix("-----BEGIN PRIVATE KEY-----").unwrap().strip_suffix("-----END PRIVATE KEY-----\n").unwrap()
    key :: PrivateKeyDer.Pkcs8(PrivatePkcs8KeyDer.from(jet_net_tls_pem_base64(body).unwrap()))
    config :: Arc.new(ServerConfig.builder().with_no_client_auth().with_single_cert(certs, key).unwrap())
    listener :: TcpListener.bind("127.0.0.1:0").unwrap(); address :: listener.local_addr().unwrap()
    server :: thread.spawn(fn() -> {
        (socket, _) :: listener.accept().unwrap(); conn :: ServerConnection.new(config).unwrap(); tls := StreamOwned.new(conn, socket)
        loop tls.conn.is_handshaking() { if &tls.conn.complete_io(&tls.sock).is_err() { return } }
    })
    (address, server)
}
