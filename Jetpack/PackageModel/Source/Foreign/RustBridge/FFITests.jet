fn connect_with_ca_for_test(socket: TcpStream, server_name: String, pem: [U8]) -> I64 Err! {
    id :: jet_net_tls_begin_with_ca_impl(socket, server_name.to_string(), pem)?
    loop {
        if jet_net_tls_handshake_step_impl(id)? { return Ok(id) }
        thread.sleep(Duration.from_millis(2))
    }
}
