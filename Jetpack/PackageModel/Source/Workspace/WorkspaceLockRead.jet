// Read-only workspace lock access (D-WORKSPACELOCK1=A). IDEs, CI scripts,
// and Canvas load a static workspace index from `.jet/lock` without
// evaluating Jet and without the Jetpack engine. Only the canonical
// `workspace.jet` index may supply member-index facts; package receipt
// references stay package-lock facts, so this projection returns only
// workspace identity and membership. The write path lives with the
// Environment area's project lock.

// The lock file path within the workspace root.
@PKG_WORKSPACE_LOCK :: @UNIFIED_LOCK_FILE

// The digest recorded when a workspace lock has no workspace source.
@PKG_NO_WORKSPACE_SOURCE :: "no-workspace-source"

// Workspace facts from `.jet/lock` in `workspace_root`. None when the file
// is absent, malformed, stale, or missing the identity fields a safe
// workspace index needs; callers must not treat that as an empty workspace.
pub fn pkg_workspace_lock_load(workspace_root: String) -[FS]> ?WorkspacePlan {
    resolver :: AuthorityResolver.open(workspace_root) ?? return None
    pkg_workspace_lock_load_with_resolver(resolver)
}

// Workspace facts through an already-open authority root.
pub fn pkg_workspace_lock_load_with_resolver(resolver: AuthorityResolver) -[FS]> ?WorkspacePlan {
    lock_file :: resolver.checked_file(@PKG_WORKSPACE_LOCK) ?? return None
    pkg_workspace_lock_load_checked_file(resolver, lock_file)
}

// Consume one checked lock file without reopening it by pathname. Every
// authority snapshot is revalidated around each read so a swapped file or
// member cannot supply facts.
pub fn pkg_workspace_lock_load_checked_file(resolver: AuthorityResolver, lock_file: CheckedFile) -[FS]> ?WorkspacePlan {
    raw :: lock_file.text() ?? return None
    resolver.revalidate_file(lock_file) ?? return None
    lock :: pkg_lock_parse(raw) ?? return None
    resolver.revalidate_file(lock_file) ?? return None
    source :: if resolver.resolve_workspace_source() == {
        .Ok(found) -> found
        .Err(_) -> return None
    }
    source :: resolver.resolve_workspace_source() ?? return None
    if source == {
        .Val(present) -> {
            resolver.revalidate_source(present) ?? return None
            if present.role != WorkspaceSourceRole.Index -> return None
        }
        .None -> {}
    }
    is_index :: source != None
    source_digest :: if source == {
        .Val(present) -> pkg_sha256_hex(present.source.bytes())
        .None -> @PKG_NO_WORKSPACE_SOURCE
    }
    if recorded_digest != source_digest -> return None
    if lock.workspace_members.len() > 0 {
        // Only a checked workspace index may persist member-index facts.
        if !is_index -> return None
        present :: source ?? return None
        physical_paths := [String]{}
        names := [String]{}
        checked_members := [CheckedMember]{}
        loop member in lock.workspace_members {
            if member.name == "" || member.path == "" || files.is_abs(member.path) || pkg_workspace_path_has_parent(member.path) -> return None
            if member.source_digest != source_digest -> return None
            resolver.revalidate_source(present) ?? return None
            checked :: resolver.checked_package(member.path) ?? return None
            resolver.revalidate_member(checked.member) ?? return None
            checked_members.push(checked.member)
            physical_path :: checked.member.directory.path
            canonical_relative :: resolver.relative_identity(checked.member.directory) ?? return None
            if canonical_relative != member.canonical_path -> return None
            package :: checked.facts
            if package.name != member.name || package.members.len() > 0 -> return None
            if member.package_digest == "" || package.semantic_digest() != member.package_digest -> return None
            if physical_paths.contains(physical_path) || names.contains(member.name) -> return None
            physical_paths.push(physical_path)
            names.push(member.name)
            resolver.revalidate_source(present) ?? return None
        }
        loop checked_member in checked_members {
            resolver.revalidate_member(checked_member) ?? return None
        }
        resolver.revalidate_source(present) ?? return None
    }
    plan_source_digest :: if lock.workspace_members.len() > 0 -> lock.workspace_members[0].source_digest else -> source_digest
    members := [WorkspacePlanMember]{}
    if is_index {
// Whether a relative member path has a `..` component.
fn pkg_workspace_path_has_parent(path: String) -> Bool !Never {
    loop part in path.split("/") {
        if part == ".." -> return true
    }
    false
}

// Whether a relative member path has a `..` component (either separator).
fn pkg_workspace_path_has_parent(path: String) -> Bool !Never {
    loop part in path.replace("\\", "/").split("/") {
        if part == ".." -> return true
    }
    false
}
