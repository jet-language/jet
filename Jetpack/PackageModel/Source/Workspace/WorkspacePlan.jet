// `WorkspacePlan`, the workspace-source authority, and workspace members:
// the data produced by evaluating a workspace declaration (
// ). They live in the package model so the evaluator
// (EnvModel `WorkspaceFile`) and the read-only lock reader share one
// definition without depending on each other.

// The role of a declaration-resolved workspace source. `workspace.jet` is
// the index; another top-level declaration establishes an
// authority boundary but is not a workspace index.
enum WorkspaceSourceRole {
    Index
    Authority
}

// The one declaration-resolved workspace source every authority lookup
// uses. Consumers revalidate `checked` before authority-sensitive work.
struct WorkspaceSource {
    path: String
    source: String
    role: WorkspaceSourceRole
    checked: CheckedFile
}

// The result of evaluating a workspace declaration.
struct WorkspacePlan {
    // Member packages in source order (the order `members:` produced them).
    members: [WorkspacePlanMember]
    // Tier-1: content-addressed inputs a `members:` expression
    // pulled in during evaluation, recorded so the index is reproducible.
    comptime_inputs: [ComptimeInput]
    // Reviewed overlay/override policy from the workspace
    // declaration; commands may draft this source but never hide override
    // state.
    overlay_policy: OverlayPolicy
    // Digest of the workspace source that produced this plan; a lock is
    // reusable only while the source bytes keep this identity.
    source_digest: String

    fn empty() -> WorkspacePlan Never! {
        WorkspacePlan{members: [WorkspacePlanMember]{}, comptime_inputs: [ComptimeInput]{}, overlay_policy: OverlayPolicy.empty(), source_digest: ""}
    }
}

// One workspace member package (Rust `WorkspacePlan::WorkspaceMember`).
struct WorkspacePlanMember {
    // Package name read from the member's `package.jet` (or its path).
    name: String
    // Package directory relative to the workspace root.
    path: String
    // Checkout-relative canonical directory identity used by the workspace
    // lock, so a committed lock stays portable after a checkout moves.
    canonical_path: String
}

// A workspace source that could not be resolved, as its registered
// diagnostic.
#Error
struct WorkspaceSourceError {
    diagnostic: Diagnostic

    fn message(self) -> String Never! {
        self.diagnostic.what
    }
}

// Resolve the one top-level `.jet` source that declares `module workspace`.
// The filename and declaration jointly select the role: a declared
// `workspace.jet` is the strict index; a workspace module in
// another top-level file is an authority boundary evaluated only for
// policy. Candidates are inspected in filename order; more than one usable
// declaration is E1239, and any discovery I/O failure is an error rather
// than an absent workspace, so callers never fall through to an outer
// authority or a stale lock. A missing directory is no workspace.
// The caller shares `cache` with every other discovery scan in its session.
fn pkg_resolve_workspace_source(cache: &WorkspaceDeclarationCache, dir: String) -[FS, Env]> WorkspaceSource? WorkspaceSourceError! {
    resolver :: AuthorityResolver.open(dir) ?? {
        if err.is_missing() -> return Ok(None)
        return Err(WorkspaceSourceError{diagnostic: err.workspace_diagnostic()})
    }
    if resolver.resolve_workspace_source(&cache) == {
        .Ok(source) -> Ok(source)
        .Err(error) -> Err(WorkspaceSourceError{diagnostic: error.workspace_diagnostic()})
    }
}

// E0995: the canonical workspace source is present but has no workspace
// declaration. Shared so discovery and evaluation cannot drift.
fn pkg_e0995_no_workspace_module() -> Diagnostic Never! {
    diagnostic_from_registry(
        "E0995",
        None,
        "`{WORKSPACE_FILE}` must declare `module {NS_WORKSPACE} {{ … }}`",
        "`{WORKSPACE_FILE}` is the monorepo workspace index; it must contain exactly one `module {NS_WORKSPACE} {{ members: … }}` body",
        "write `module {NS_WORKSPACE} {{ members: find(\"./packages\") }}` in `{WORKSPACE_FILE}`"
    )
}

// What one lex of a workspace candidate source says about its declaration.
struct WorkspaceDeclarationProbe {
    // A top-level `module workspace` declaration is present.
    declares_module: Bool
    // That declaration's source also names the `members:` index field.
    declares_members: Bool
}

// Root discovery shares this owned cache across its workspace-source probes.
// Each distinct source is lexed once per discovery session, keyed by its byte
// length and SHA-256; repeated scans must use the same cache.
struct WorkspaceDeclarationCache {
    priv probes: [String: WorkspaceDeclarationProbe]
    // Lexes actually performed by this session, excluding memo hits.
    lexes: Int{0}

    fn new() -> WorkspaceDeclarationCache Never! {
        WorkspaceDeclarationCache{probes: [String: WorkspaceDeclarationProbe]{}}
    }
}

fn pkg_workspace_declaration_probe(cache: &WorkspaceDeclarationCache, src: String) -> WorkspaceDeclarationProbe Never! {
    bytes :: src.bytes()
    key :: "{bytes.len()}:{pkg_sha256_hex(bytes)}"
    if cache.probes.get(key) == .Val(probe) -> return probe
    cache.lexes += 1
    probe :: pkg_lex_workspace_declaration(bytes)
    cache.probes[key] = probe
    probe
}

// Lex `src` once; both declaration facts come from the same comment-free
// token list.
fn pkg_lex_workspace_declaration(src: [U8]) -> WorkspaceDeclarationProbe Never! {
    lexed :: lex(src)
    tokens := [Token]{}
    loop token in lexed.tokens {
        if token.kind == TOKEN_LINE_COMMENT || token.kind == TOKEN_BLOCK_COMMENT -> next
        &tokens.push(token)
    }
    declares_module :: pkg_workspace_tokens_declare_module(tokens, lexed.tables)
    WorkspaceDeclarationProbe{declares_module: declares_module, declares_members: declares_module && pkg_workspace_tokens_name_members(tokens, lexed.tables)}
}

// A top-level `module workspace` token pair.
fn pkg_workspace_tokens_declare_module(tokens: [Token], tables: TokenTables) -> Bool Never! {
    depth := 0
    loop index in 0..<(tokens.len() - 1) {
        kind :: tokens[index].kind
        if {
            kind == TOKEN_LBRACE -> depth += 1
            kind == TOKEN_RBRACE -> depth -= 1
            kind == TOKEN_KW_MODULE && depth == 0 -> {
                next_token :: tokens[index + 1]
                name :: token_text(tables, next_token)
                if next_token.kind == TOKEN_IDENT && name == NS_WORKSPACE && !name.starts_with(MODULE_INTERNAL_PREFIX) -> return true
            }
            else -> {}
        }
    }
    false
}

// The `members:` field name appears among the tokens.
fn pkg_workspace_tokens_name_members(tokens: [Token], tables: TokenTables) -> Bool Never! {
    loop token in tokens {
        if token.kind == TOKEN_IDENT && token_text(tables, token) == MODULE_FIELD_MEMBERS -> return true
    }
    false
}

// Cheap token probe for a top-level `module workspace` declaration. Full
// parsing stays in the EnvModel workspace evaluator.
fn pkg_declares_workspace_module(cache: &WorkspaceDeclarationCache, src: String) -> Bool Never! {
    pkg_workspace_declaration_probe(&cache, src).declares_module
}

// True when a workspace declaration also supplies a `members:` index field.
// A top-level `.jet` file that lists members is an index, not
// authority-only metadata.
fn pkg_declares_workspace_members(cache: &WorkspaceDeclarationCache, src: String) -> Bool Never! {
    pkg_workspace_declaration_probe(&cache, src).declares_members
}

// E1239: the workspace authority must have one declaration source. Each
// path is shown by its file name.
fn pkg_e1239_ambiguous_workspace(paths: [String]) -> Diagnostic Never! {
    names := [String]{}
    loop path in paths {
        name :: files.basename(path)
        &names.push(if name == "" -> path else -> name)
    }
    diagnostic_from_registry(
        "E1239",
        None,
        "`module workspace` is declared in more than one file: `{names.join("`, `")}`",
        "the workspace authority is discovered by declaration, so exactly one file may declare `module workspace {{ … }}`",
        "keep one declaration and delete the others"
    )
}
