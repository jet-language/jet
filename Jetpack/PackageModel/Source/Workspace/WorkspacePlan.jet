// `WorkspacePlan`, the workspace-source authority, and workspace members:
// the data produced by evaluating a workspace declaration (D-WORKSPACE1=B,
// D-WORKSPACE2=A). They live in the package model so the evaluator
// (EnvModel `WorkspaceFile`) and the read-only lock reader share one
// definition without depending on each other.

// The role of a declaration-resolved workspace source. `workspace.jet` is
// the D-WORKSPACE2 index; another top-level declaration establishes an
// authority boundary but is not a workspace index.
pub enum WorkspaceSourceRole {
    Index
    Authority
}

// The one declaration-resolved workspace source every authority lookup
// uses. Consumers revalidate `checked` before authority-sensitive work.
pub struct WorkspaceSource {
    pub path: String
    pub source: String
    pub role: WorkspaceSourceRole
    pub checked: CheckedFile
}

// The result of evaluating a workspace declaration.
pub struct WorkspacePlan {
    // Member packages in source order (the order `members:` produced them).
    pub members: [WorkspacePlanMember]
    // D-CTEFFECT1 Tier-1: content-addressed inputs a `members:` expression
    // pulled in during evaluation, recorded so the index is reproducible.
    pub comptime_inputs: [ComptimeInput]
    // D-JPK-OVERLAY1=A: reviewed overlay/override policy from the workspace
    // declaration; commands may draft this source but never hide override
    // state.
    pub overlay_policy: OverlayPolicy
    // Digest of the workspace source that produced this plan; a lock is
    // reusable only while the source bytes keep this identity.
    pub source_digest: String

    fn empty() -> WorkspacePlan Never! {
        WorkspacePlan{members: [WorkspacePlanMember]{}, comptime_inputs: [ComptimeInput]{}, overlay_policy: OverlayPolicy.empty(), source_digest: ""}
    }
}

// One workspace member package (Rust `WorkspacePlan::WorkspaceMember`).
pub struct WorkspacePlanMember {
    // Package name read from the member's `package.jet` (or its path).
    pub name: String
    // Package directory relative to the workspace root.
    pub path: String
    // Checkout-relative canonical directory identity used by the workspace
    // lock, so a committed lock stays portable after a checkout moves.
    pub canonical_path: String
}

// A workspace source that could not be resolved, as its registered
// diagnostic.
#Error
pub struct WorkspaceSourceError {
    pub diagnostic: Diagnostic

    fn message(self) -> String Never! {
        self.diagnostic.what
    }
}

// Resolve the one top-level `.jet` source that declares `module workspace`.
// The filename and declaration jointly select the role: a declared
// `workspace.jet` is the strict D-WORKSPACE2 index; a workspace module in
// another top-level file is an authority boundary evaluated only for
// policy. Candidates are inspected in filename order; more than one usable
// declaration is E1239, and any discovery I/O failure is an error rather
// than an absent workspace, so callers never fall through to an outer
// authority or a stale lock. A missing directory is no workspace.
pub fn pkg_resolve_workspace_source(dir: String) -[FS]> WorkspaceSource? WorkspaceSourceError! {
    resolver :: if AuthorityResolver.open(dir) == {
        .Ok(opened) -> opened
        .Err(error) -> {
            if error.is_missing() -> return Ok(None)
            return Err(WorkspaceSourceError{diagnostic: error.workspace_diagnostic()})
        }
    }
    if resolver.resolve_workspace_source() == {
        .Ok(source) -> Ok(source)
        .Err(error) -> Err(WorkspaceSourceError{diagnostic: error.workspace_diagnostic()})
    }
}

// E0995: the canonical workspace source is present but has no workspace
// declaration. Shared so discovery and evaluation cannot drift.
pub fn pkg_e0995_no_workspace_module() -> Diagnostic Never! {
    diagnostic_from_registry(
        "E0995",
        None,
        "`{@WORKSPACE_FILE}` must declare `module {@NS_WORKSPACE} {{ … }}`",
        "`{@WORKSPACE_FILE}` is the monorepo workspace index; it must contain exactly one `module {@NS_WORKSPACE} {{ members: … }}` body",
        "write `module {@NS_WORKSPACE} {{ members: find(\"./packages\") }}` in `{@WORKSPACE_FILE}`"
    )
}

// The lexed tokens of `src` without comments.
fn pkg_workspace_code_tokens(src: String) -> [Token] Never! {
    lexed :: lex(src.bytes())
    tokens := [Token]{}
    loop token in lexed.tokens {
        if token.kind == TOKEN_LINE_COMMENT || token.kind == TOKEN_BLOCK_COMMENT -> next
        &tokens.push(token)
    }
    tokens
}

// Cheap token probe for a top-level `module workspace` declaration. Full
// parsing stays in the EnvModel workspace evaluator.
pub fn pkg_declares_workspace_module(src: String) -> Bool Never! {
    tokens :: pkg_workspace_code_tokens(src)
    depth := 0
    loop index in 0..<(tokens.len() - 1) {
        kind :: tokens[index].kind
        if {
            kind == TOKEN_LBRACE -> depth += 1
            kind == TOKEN_RBRACE -> depth -= 1
            kind == TOKEN_KW_MODULE && depth == 0 -> {
                next_token :: tokens[index + 1]
                name :: next_token.payload.text
                if next_token.kind == TOKEN_IDENT && name == @NS_WORKSPACE && !name.starts_with(@MODULE_INTERNAL_PREFIX) -> return true
            }
            else -> {}
        }
    }
    false
}

// True when a workspace declaration also supplies a `members:` index field.
// A top-level `.jet` file that lists members is an index, not
// authority-only metadata (D-JPK-FILENAME2=B).
pub fn pkg_declares_workspace_members(src: String) -> Bool Never! {
    if !pkg_declares_workspace_module(src) -> return false
    loop token in pkg_workspace_code_tokens(src) {
        if token.kind == TOKEN_IDENT && token.payload.text == @MODULE_FIELD_MEMBERS -> return true
    }
    false
}

// E1239: the workspace authority must have one declaration source. Each
// path is shown by its file name.
pub fn pkg_e1239_ambiguous_workspace(paths: [String]) -> Diagnostic Never! {
    names := [String]{}
    loop path in paths {
        name :: files.basename(path)
        &names.push(if name == "" -> path else -> name)
    }
    diagnostic_from_registry(
        "E1239",
        None,
        "`module workspace` is declared in more than one file: `{names.join("`, `")}`",
        "the workspace authority is discovered by declaration, so exactly one file may declare `module workspace {{ … }}`",
        "keep one declaration and delete the others"
    )
}
