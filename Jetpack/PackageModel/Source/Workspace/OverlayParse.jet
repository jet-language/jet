// `workspace.jet` policy parse and strip (D-JPK-OVERLAY1=A).
//
// Workspace policy (`overlay` blocks, `policy.allowUnfree`, and the build
// `policy: { deny, grants }` record) is read here into `OverlayPolicy` and
// stripped before the ordinary module evaluator runs, so policy facts never
// enter module evaluation.

pub fn pkg_parse_workspace_policy(src: String) -> OverlayPolicy OverlayError! {
    body :: pkg_overlay_workspace_body(src) ?? return Ok(OverlayPolicy.empty())
    policy := OverlayPolicy.empty()
    policy.allow_unfree = pkg_overlay_parse_allow_unfree(body)
    pkg_overlay_reject_unsupported_policy_fields(body)
    policy.build_deny = pkg_overlay_parse_build_deny(body)
    policy.build_grants = pkg_overlay_parse_build_grants(body)
    raw :: body.bytes()
    keyword_len :: WORKSPACE_OVERLAY.bytes().len()
    position := 0
    loop position < raw.len() {
        at :: pkg_overlay_find_word(raw, WORKSPACE_OVERLAY, position) ?? break
        name_at :: pkg_bytes_skip_space(raw, at + keyword_len)
        ident :: pkg_overlay_read_ident(raw, name_at) ?? return Err(OverlayError.Malformed("`overlay` needs a name in `workspace.jet`"))
        open :: pkg_bytes_skip_space(raw, ident.end)
        if pkg_bytes_code(raw, open) != OVERLAY_OPEN_BRACE -> return Err(OverlayError.Malformed("`overlay {ident.ident}` needs a `{{ … }}` body"))
        block :: pkg_overlay_balanced(raw, open + 1)
        parsed :: pkg_overlay_parse_set(ident.ident, block.body)
        if policy.overlay(parsed.name) != None -> return Err(OverlayError.Malformed("overlay `{parsed.name}` is declared more than once"))
        &policy.overlays.push(parsed)
        position = open + 1 + block.consumed
    }
    packages := [String]{}
    loop overlay in policy.overlays {
        loop candidate in overlay.packages -> &packages.push(candidate.package)
    }
    loop package in pkg_overlay_sorted_unique(packages) {
        if policy.resolve_package_override_checked(package) == {
            .Err(error) -> return Err(error)
            .Ok(_) -> {}
        }
    }
    Ok(policy)
}

fn pkg_overlay_parse_set(name: String, body: String) -> OverlaySet OverlayError! {
    overlay := OverlaySet{name: name, provider: None, packages: [PackageOverride]{}}
    saw_overrides := false
    keyed := [PackageOverride]{}
    loop statement in pkg_overlay_top_level_statements(body) {
        line :: pkg_overlay_trim_end_all(statement.trim(), ";").trim()
        if line == "" -> next
        if line.starts_with("provider:") {
            if overlay.provider != None -> return Err(OverlayError.Malformed("overlay declares `provider` more than once"))
            overlay.provider = Val(pkg_overlay_parse_provider(line.removeprefix("provider:").trim()))
            next
        }
        if pkg_overlay_parse_package_line(line) == {
            .Val(package) -> {
                &overlay.merge_package(package)
                next
            }
            .None -> {}
        }
        field :: pkg_overlay_split_colon(line) ?? return Err(OverlayError.Malformed("unknown overlay declaration `{line}`"))
        if field.before.trim() != "overrides" -> return Err(OverlayError.Malformed("unknown overlay field `{field.before.trim()}`"))
        if saw_overrides -> return Err(OverlayError.Malformed("overlay declares `overrides` more than once"))
        saw_overrides = true
        record :: field.after.trim()
        if !record.starts_with("{{") -> return Err(OverlayError.Malformed("`overrides` must be a record"))
        opened :: record.removeprefix("{{")
        if !opened.ends_with("}}") -> return Err(OverlayError.Malformed("`overrides` record is not closed"))
        loop package in pkg_overlay_parse_keyed_overrides(opened.removesuffix("}}")) -> &keyed.push(package)
    }
    loop package in keyed -> &overlay.merge_package(package)
    Ok(overlay)
}

// Parse the ratified keyed override record:
//
// overrides: { mpv: { version: "0.38.0", flags: { vapoursynth: true } } }
//
// This is a source-level parser: `workspace.jet` policy is stripped before
// Jet's normal evaluator runs, so accepting the record here keeps policy
// facts out of module evaluation while giving every consumer one typed
// `PackageOverride` value.
fn pkg_overlay_parse_keyed_overrides(body: String) -> [PackageOverride] OverlayError! {
    packages := [PackageOverride]{}
    names := [String]{}
    loop piece in pkg_overlay_top_level_commas(body) {
        entry :: pkg_overlay_split_colon(piece.trim()) ?? return Err(OverlayError.Malformed("each `overrides` entry needs `<package>: {{ … }}`"))
        package :: pkg_overlay_unquote(entry.before.trim())
        if package == "" -> return Err(OverlayError.Malformed("`overrides` package names cannot be empty"))
        if names.contains(package) -> return Err(OverlayError.Malformed("override `{package}` is declared more than once"))
        &names.push(package)
        record :: entry.after.trim()
        if !record.starts_with("{{") -> return Err(OverlayError.Malformed("override `{package}` must use the standard `{{ … }}` record"))
        opened :: record.removeprefix("{{")
        if !opened.ends_with("}}") -> return Err(OverlayError.Malformed("override `{package}` record is not closed"))
        &packages.push(pkg_overlay_parse_keyed_record(package, opened.removesuffix("}}")))
    }
    Ok(packages)
}

fn pkg_overlay_parse_keyed_record(package: String, body: String) -> PackageOverride OverlayError! {
    result := PackageOverride.new(package)
    seen := [String: String]{}
    loop piece in pkg_overlay_top_level_commas(body) {
        entry :: pkg_overlay_split_colon(piece.trim()) ?? return Err(OverlayError.Malformed("each package override field needs `name: value`"))
        field :: entry.before.trim()
        value :: entry.after.trim()
        if seen.get(field) == {
            .Val(previous) -> {
                if previous != value -> return Err(OverlayError.Malformed("override `{result.package}` has conflicting `{field}` fields"))
                next
            }
            .None -> {}
        }
        seen[~field] = ~value
        &result.apply_field(field, value)
    }
    Ok(result)
}

impl PackageOverride {
    // Apply one keyed-record `field: value` package fact with its priority
    // wrapper. The `package(...)` line spelling shares this table except
    // for `flags`, which it writes as a list.
    fn apply_field(&self, field: String, value: String) OverlayError! {
        if field == {
            "source" -> {
                payload :: pkg_overlay_priority_payload(value)
                self.source = Val(pkg_overlay_unquote(payload.value))
                &self.record_priority("source", payload.priority)
            }
            "version" -> {
                payload :: pkg_overlay_priority_payload(value)
                self.version = Val(pkg_overlay_unquote(payload.value))
                &self.record_priority("version", payload.priority)
            }
            "flags" -> {
                payload :: pkg_overlay_priority_payload(value)
                self.flags = pkg_overlay_parse_flag_record(payload.value)
                &self.record_priority("flags", payload.priority)
            }
            "patches" -> {
                payload :: pkg_overlay_priority_payload(value)
                self.patches = pkg_overlay_parse_patch_list(payload.value)
                &self.record_priority("patches", payload.priority)
            }
            "allowUnfree" -> {
                payload :: pkg_overlay_priority_payload(value)
                self.allow_unfree = pkg_overlay_parse_bool(payload.value)
                &self.record_priority("allowUnfree", payload.priority)
            }
            "env" -> {
                payload :: pkg_overlay_priority_payload(value)
                self.env = pkg_overlay_parse_env_record(payload.value)
                if payload.priority > self.priority -> self.priority = payload.priority
                loop fact in self.env -> self.field_priorities["env.{fact.key}"] = payload.priority
            }
            else -> return Err(OverlayError.Malformed("unknown package override field `{field}`"))
        }
    }
}

// A value with its optional priority wrapper: `Force(v)` is 100,
// `Default(v)` is -100, `Priority(n: v)` is n, and a bare value is 0.
fn pkg_overlay_priority_payload(input: String) -> (value: String, priority: Int) OverlayError! {
    raw :: pkg_overlay_trim_end_all(input.trim(), ",")
    if pkg_overlay_strip_wrapped(raw, "Force(", ")") == {
        .Val(inner) -> return Ok((value: inner.trim(), priority: 100))
        .None -> {}
    }
    if pkg_overlay_strip_wrapped(raw, "Default(", ")") == {
        .Val(inner) -> return Ok((value: inner.trim(), priority: -100))
        .None -> {}
    }
    inner :: pkg_overlay_strip_wrapped(raw, "Priority(", ")") ?? return Ok((value: raw, priority: 0))
    weight := ""
    value := ""
    if pkg_overlay_split_colon(inner) == {
        .Val(parts) -> {
            weight = parts.before.trim()
            value = parts.after.trim()
        }
        .None -> {
            parts :: pkg_overlay_top_level_commas(inner)
            if parts.len() < 2 -> return Err(OverlayError.Malformed("Priority(n) override needs n: value"))
            weight = parts[0].trim()
            value = parts[1..<parts.len()].join(",").trim()
        }
    }
    priority :: pkg_overlay_parse_i32(weight) ?? return Err(OverlayError.Malformed("Priority(n) needs an integer weight"))
    Ok((value: value, priority: priority))
}

// A decimal `i32` with an optional sign, as Rust `str::parse::<i32>`.
fn pkg_overlay_parse_i32(text: String) -> Int? Never! {
    raw :: text.bytes()
    if raw.len() == 0 -> return None
    first :: Int.from_u8(raw[0])
    negative :: first == 45
    start :: if first == 43 || first == 45 -> 1 else -> 0
    if start == raw.len() -> return None
    value := 0
    loop index in start..<raw.len() {
        digit :: Int.from_u8(raw[index]) - 48
        if digit < 0 || digit > 9 -> return None
        value = value * 10 + digit
        if value > 2147483648 -> return None
    }
    if negative -> return Val(0 - value)
    if value > 2147483647 -> return None
    Val(value)
}

fn pkg_overlay_parse_flag_record(input: String) -> [String] OverlayError! {
    inner :: pkg_overlay_strip_wrapped(input.trim(), "{{", "}}") ?? return Err(OverlayError.Malformed("`flags` must be a record like `{{ feature: true }}`"))
    flags := [String]{}
    loop piece in pkg_overlay_top_level_commas(inner) {
        entry :: pkg_overlay_split_colon(piece.trim()) ?? return Err(OverlayError.Malformed("each `flags` entry needs `name: true|false`"))
        if pkg_overlay_parse_bool(entry.after) -> &flags.push(pkg_overlay_unquote(entry.before.trim()))
    }
    Ok(flags)
}

fn pkg_overlay_parse_env_record(input: String) -> [OverrideEnv] OverlayError! {
    inner :: pkg_overlay_strip_wrapped(input.trim(), "{{", "}}") ?? return Err(OverlayError.Malformed("`env` must be a record like `{{ CC: \"clang\" }}`"))
    values := [OverrideEnv]{}
    loop piece in pkg_overlay_top_level_commas(inner) {
        entry :: pkg_overlay_split_colon(piece.trim()) ?? return Err(OverlayError.Malformed("each `env` entry needs `NAME: \"value\"`"))
        key :: pkg_overlay_unquote(entry.before.trim())
        if !pkg_overlay_valid_env_name(key) -> return Err(OverlayError.Malformed("`env` variable name `{key}` is invalid"))
        value :: pkg_overlay_unquote(entry.after)
        if pkg_overlay_env_lookup(values, key) == {
            .Val(previous) -> {
                if previous != value -> return Err(OverlayError.Malformed("`env.{key}` is declared with conflicting values"))
                next
            }
            .None -> {}
        }
        &values.push(OverrideEnv{key: key, value: value})
    }
    Ok(values)
}

// `[A-Za-z_][A-Za-z0-9_]*`
fn pkg_overlay_valid_env_name(name: String) -> Bool Never! {
    raw :: name.bytes()
    if raw.len() == 0 -> return false
    first :: Int.from_u8(raw[0])
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95) -> return false
    loop index in 1..<raw.len() {
        if !pkg_bytes_is_word(Int.from_u8(raw[index])) -> return false
    }
    true
}

fn pkg_overlay_parse_provider(input: String) -> ProviderOverride OverlayError! {
    raw :: pkg_overlay_trim_end_all(input.trim(), ",")
    if !raw.starts_with("Provider.") -> return Err(OverlayError.Malformed("`provider:` must use `Provider.<name>(channel: \"...\")`"))
    rest :: raw.removeprefix("Provider.")
    provider :: (rest.split_once("(")?.before ?? rest).trim()
    channel :: pkg_overlay_provider_channel(rest)
    if provider == "" -> return Err(OverlayError.Malformed("`provider:` needs a provider name"))
    Ok(ProviderOverride{provider: provider, channel: channel})
}

// The `channel:` argument of a `<name>(…)` provider call.
fn pkg_overlay_provider_channel(call: String) -> String? Never! {
    open :: call.split_once("(") ?? return None
    args :: pkg_overlay_trim_end_all(open.after, ")").trim()
    named :: args.split_once("channel:") ?? return None
    Val(pkg_overlay_unquote(pkg_overlay_trim_end_all(named.after.trim(), ",")))
}

// The `package("name").field <op> value` spelling, or None for another
// statement. The operator is `+=`, `:`, or `=`, tried in that order.
fn pkg_overlay_parse_package_line(line: String) -> PackageOverride? OverlayError! {
    if !line.starts_with("package(") -> return Ok(None)
    closed :: line.removeprefix("package(").split_once(")") ?? return Err(OverlayError.Malformed("`package(...)` override needs a closing `)`"))
    result := PackageOverride.new(pkg_overlay_unquote(closed.before))
    rest :: pkg_overlay_trim_end_all(closed.after.trim(), ",")
    if !rest.starts_with(".") -> return Err(OverlayError.Malformed("`package(...)` override needs a field like `.patches`"))
    field_rest :: rest.removeprefix(".")
    operation := field_rest.split_once("+=")
    if operation == None -> operation = field_rest.split_once(":")
    if operation == None -> operation = field_rest.split_once("=")
    parts :: operation ?? return Err(OverlayError.Malformed("`package(...)` override needs `:`, `=`, or `+=`"))
    field :: parts.before.trim()
    value :: parts.after.trim()
    if field == "flags" {
        payload :: pkg_overlay_priority_payload(value)
        result.flags = pkg_overlay_parse_string_list(payload.value)
        &result.record_priority("flags", payload.priority)
        return Ok(Val(result))
    }
    &result.apply_field(field, value)
    Ok(Val(result))
}

fn pkg_overlay_parse_patch_list(input: String) -> [String] OverlayError! {
    patches := [String]{}
    loop entry in pkg_overlay_parse_list(input) {
        item :: entry.trim()
        &patches.push(pkg_overlay_unquote(pkg_overlay_strip_wrapped(item, "patch(", ")") ?? ~item))
    }
    Ok(patches)
}

fn pkg_overlay_parse_string_list(input: String) -> [String] OverlayError! {
    values := [String]{}
    loop entry in pkg_overlay_parse_list(input) -> &values.push(pkg_overlay_unquote(entry.trim()))
    Ok(values)
}

fn pkg_overlay_parse_list(input: String) -> [String] OverlayError! {
    raw :: pkg_overlay_trim_end_all(input.trim(), ",")
    inner :: pkg_overlay_strip_wrapped(raw, "[", "]") ?? return Err(OverlayError.Malformed("expected a list literal"))
    Ok(pkg_overlay_top_level_commas(inner))
}

fn pkg_overlay_parse_bool(input: String) -> Bool OverlayError! {
    value :: pkg_overlay_trim_end_all(input.trim(), ",")
    if value == "true" -> return Ok(true)
    if value != "false" -> return Err(OverlayError.Malformed("`{value}` is not a boolean"))
    Ok(false)
}

fn pkg_overlay_parse_allow_unfree(body: String) -> [String] OverlayError! {
    loop field in pkg_overlay_top_level_policy_fields(body) {
        if field.name == "allowUnfree" -> return Ok(pkg_overlay_parse_string_list(field.value))
    }
    Ok([String]{})
}

fn pkg_overlay_parse_build_deny(body: String) -> [String] OverlayError! {
    policy_body :: pkg_overlay_named_block(body, MANIFEST_BLOCK_POLICY) ?? return Ok([String]{})
    raw :: pkg_overlay_exact_field_value(policy_body, EFFECTS_FIELD_DENY) ?? return Ok([String]{})
    Ok(pkg_overlay_parse_effect_tuple(raw.trim(), "policy.deny"))
}

fn pkg_overlay_reject_unsupported_policy_fields(body: String) OverlayError! {
    loop field in pkg_overlay_top_level_policy_fields(body) {
        if field.name != "allowUnfree" -> return Err(OverlayError.UnsupportedPolicy("workspace `policy.{field.name}` is unsupported; use `policy.allowUnfree`, `policy.deny`, or subject-scoped `policy.grants`"))
    }
    policy_body :: pkg_overlay_named_block(body, MANIFEST_BLOCK_POLICY) ?? return
    if pkg_overlay_exact_field_value(policy_body, EFFECTS_FIELD_ALLOW) != None {
        return Err(OverlayError.UnsupportedPolicy("workspace `policy.allow` is unsupported; use `policy.deny` or subject-scoped `policy.grants`"))
    }
}

// One `policy.<name>: <value>` metadata line at the workspace body's top
// level; the value is the rest of its line.
struct OverlayPolicyField {
    name: String
    value: String
}

fn pkg_overlay_top_level_policy_fields(body: String) -> [OverlayPolicyField] OverlayError! {
    raw :: body.bytes()
    word :: MANIFEST_BLOCK_POLICY
    word_len :: word.bytes().len()
    fields := [OverlayPolicyField]{}
    position := 0
    loop position < raw.len() {
        at :: pkg_overlay_find_word(raw, word, position) ?? break
        after :: at + word_len
        if pkg_overlay_code_depth_at(raw, at) != Val(0) {
            position = after
            next
        }
        dot :: pkg_bytes_skip_space(raw, after)
        if pkg_bytes_code(raw, dot) != 46 {
            position = after
            next
        }
        ident :: pkg_overlay_read_ident(raw, dot + 1) ?? return Err(OverlayError.Malformed("workspace policy metadata needs a field name after `policy.`"))
        loop field in fields {
            if field.name == ident.ident -> return Err(OverlayError.Malformed("workspace `policy.{ident.ident}` appears more than once"))
        }
        colon :: pkg_bytes_skip_space(raw, ident.end)
        if pkg_bytes_code(raw, colon) != OVERLAY_COLON -> return Err(OverlayError.Malformed("`policy.{ident.ident}` needs `:`"))
        line_end := colon + 1
        loop line_end < raw.len() && Int.from_u8(raw[line_end]) != OVERLAY_NEWLINE {
            line_end += 1
        }
        &fields.push(OverlayPolicyField{name: ident.ident, value: pkg_bytes_text(raw, colon + 1, line_end).trim()})
        position = ident.end
    }
    Ok(fields)
}

fn pkg_overlay_parse_build_grants(body: String) -> [BuildGrant] OverlayError! {
    policy_body :: pkg_overlay_named_block(body, MANIFEST_BLOCK_POLICY) ?? return Ok([BuildGrant]{})
    raw :: pkg_overlay_exact_field_value(policy_body, MANIFEST_BLOCK_GRANTS) ?? return Ok([BuildGrant]{})
    inner :: pkg_overlay_strip_wrapped(raw.trim(), "{{", "}}") ?? return Err(OverlayError.Malformed("`policy.grants:` must be a package map like `{{ \"pkg\": #(Net) }}`"))
    grants := [BuildGrant]{}
    loop piece in pkg_overlay_top_level_commas(inner) {
        entry :: pkg_overlay_split_colon(piece.trim()) ?? return Err(OverlayError.Malformed("each `policy.grants` entry needs `\"package\": #(…)`"))
        subject :: pkg_overlay_unquote(entry.before.trim())
        if subject.trim() == "" -> return Err(OverlayError.Malformed("`policy.grants` package names cannot be empty"))
        loop grant in grants {
            if grant.subject == subject -> return Err(OverlayError.Malformed("`policy.grants` package `{subject}` appears more than once"))
        }
        &grants.push(BuildGrant{subject: subject, effects: pkg_overlay_parse_effect_tuple(entry.after.trim(), "policy.grants")})
    }
    Ok(grants)
}

fn pkg_overlay_parse_effect_tuple(raw: String, field: String) -> [String] OverlayError! {
    inner :: pkg_overlay_strip_wrapped(raw, "#(", ")") ?? return Err(OverlayError.Malformed("`{field}:` must contain an effect tuple like `#(Net, Exec)`"))
    effects := [String]{}
    loop piece in pkg_overlay_top_level_commas(inner) {
        written :: pkg_overlay_unquote(piece.trim())
        if written != "" -> &effects.push(written)
    }
    if effects.len() == 0 -> return Err(OverlayError.Malformed("`{field}:` must grant at least one effect"))
    loop written in effects {
        if BuildEffect.parse(written) == None -> return Err(OverlayError.Malformed("`{field}:` names unknown build effect `{written}`"))
    }
    Ok(effects)
}

// The body of the single top-level `name: { … }` record, if any.
fn pkg_overlay_named_block(body: String, name: String) -> String? OverlayError! {
    raw :: body.bytes()
    needle :: name.bytes()
    blocks := [String]{}
    position := 0
    loop position + needle.len() <= raw.len() {
        at := position
        loop at + needle.len() <= raw.len() && !pkg_bytes_starts_with(raw, at, needle) {
            at += 1
        }
        if at + needle.len() > raw.len() -> break
        after :: at + needle.len()
        position = after
        if !pkg_overlay_word_boundary_before(raw, at) || pkg_bytes_is_word(pkg_bytes_code(raw, after)) -> next
        if pkg_overlay_code_depth_at(raw, at) != Val(0) -> next
        colon :: pkg_bytes_skip_space(raw, after)
        if pkg_bytes_code(raw, colon) != OVERLAY_COLON -> next
        open :: pkg_bytes_skip_space(raw, colon + 1)
        if pkg_bytes_code(raw, open) != OVERLAY_OPEN_BRACE -> return Err(OverlayError.Malformed("workspace `{name}` must be a record"))
        block :: pkg_overlay_balanced_policy_body(raw, open + 1)
        if blocks.len() > 0 -> return Err(OverlayError.Malformed("workspace `{name}` block appears more than once"))
        &blocks.push(block)
    }
    Ok(blocks.get(0))
}

// The text up to the `}` closing a policy record opened before `start`.
fn pkg_overlay_balanced_policy_body(raw: [U8], start: Int) -> String OverlayError! {
    depth := 1
    quoted := false
    escaped := false
    comment := false
    cursor := start
    loop cursor < raw.len() {
        index :: ~cursor
        code :: Int.from_u8(raw[index])
        peek :: pkg_bytes_code(raw, index + 1)
        cursor += 1
        if comment {
            if code == OVERLAY_NEWLINE -> comment = false
            next
        }
        if quoted {
            if {
                escaped -> escaped = false
                code == OVERLAY_BACKSLASH -> escaped = true
                code == OVERLAY_QUOTE -> quoted = false
                else -> {}
            }
            next
        }
        if {
            code == OVERLAY_SLASH && peek == OVERLAY_SLASH -> comment = true
            code == OVERLAY_QUOTE -> quoted = true
            code == OVERLAY_OPEN_BRACE -> depth += 1
            code == OVERLAY_CLOSE_BRACE -> {
                depth -= 1
                if depth == 0 -> return Ok(pkg_bytes_text(raw, start, index))
            }
            else -> {}
        }
    }
    Err(OverlayError.Malformed("unclosed `policy: {{ … }}` block"))
}

// The value of `field` in a policy record, validating every entry: only
// `deny`, `grants`, and `allow` are known, each at most once.
fn pkg_overlay_exact_field_value(body: String, field: String) -> String? OverlayError! {
    seen := [String]{}
    values := [String]{}
    loop piece in pkg_overlay_top_level_commas(body) {
        entry :: piece.trim()
        if pkg_overlay_split_colon(entry) == {
            .Val(parts) -> {
                name :: parts.before.trim()
                if name == {
                    EFFECTS_FIELD_DENY | MANIFEST_BLOCK_GRANTS | EFFECTS_FIELD_ALLOW -> {}
                    else -> return Err(OverlayError.UnsupportedPolicy("workspace `policy.{name}` is unsupported; use `policy.deny` or subject-scoped `policy.grants`"))
                }
                if seen.contains(name) -> return Err(OverlayError.Malformed("workspace `policy.{name}` appears more than once"))
                &seen.push(name)
                if name == field -> &values.push(parts.after.trim())
            }
            .None -> {
                name :: pkg_overlay_first_word(entry)
                if name != "" -> return Err(OverlayError.Malformed("`policy.{name}` needs `:`"))
            }
        }
    }
    Ok(values.get(0))
}

// The text before the first White_Space scalar.
fn pkg_overlay_first_word(text: String) -> String Never! {
    raw :: text.bytes()
    end := 0
    loop end < raw.len() && pkg_bytes_space_width(raw, end) == 0 {
        end += 1
    }
    pkg_bytes_text(raw, 0, end)
}

// The source with workspace policy removed: `policy.allowUnfree` lines, the
// build `policy: { … }` record, and every `overlay` block. An empty body stays
// empty so role-aware evaluation can tell a policy-only authority from the
// strict index role.
pub fn pkg_strip_overlay_policy(src: String) -> String Never! {
    body_start :: pkg_overlay_find_workspace_body_start(src) ?? return src
    raw :: src.bytes()
    block :: pkg_overlay_balanced(raw, body_start + 1)
    stripped :: pkg_overlay_strip_overlay_blocks(pkg_overlay_strip_build_policy_blocks(pkg_overlay_strip_allow_unfree_lines(block.body)))
    tail :: pkg_bytes_text(raw, body_start + 1 + block.consumed, raw.len())
    "{pkg_bytes_text(raw, 0, body_start + 1)}{stripped}}}{tail}"
}

fn pkg_overlay_strip_overlay_blocks(body: String) -> String Never! {
    raw :: body.bytes()
    keyword_len :: WORKSPACE_OVERLAY.bytes().len()
    out := [String]{}
    position := 0
    loop position < raw.len() {
        at :: pkg_overlay_find_word(raw, WORKSPACE_OVERLAY, position) ?? break
        &out.push(pkg_bytes_text(raw, position, at))
        open :: pkg_overlay_find_char(raw, at + keyword_len, OVERLAY_OPEN_BRACE) ?? -1
        if open < 0 {
            &out.push(WORKSPACE_OVERLAY)
            position = at + keyword_len
            next
        }
        position = open + 1 + pkg_overlay_balanced(raw, open + 1).consumed
    }
    &out.push(pkg_bytes_text(raw, position, raw.len()))
    out.join("")
}

// Drop lines that start with `policy.allowUnfree`. Lines split at `\n` (a
// `\r\n` ending loses its `\r`), and every kept line ends with `\n`.
fn pkg_overlay_strip_allow_unfree_lines(body: String) -> String Never! {
    raw :: body.bytes()
    out := [String]{}
    start := 0
    loop start < raw.len() {
        end := start
        loop end < raw.len() && Int.from_u8(raw[end]) != OVERLAY_NEWLINE {
            end += 1
        }
        content_end := end
        if end < raw.len() && content_end > start && Int.from_u8(raw[content_end - 1]) == 13 -> content_end -= 1
        line :: pkg_bytes_text(raw, start, content_end)
        if !line.trim_start().starts_with("policy.allowUnfree") -> &out.push("{line}\n")
        start = end + 1
    }
    out.join("")
}

// Remove the source-level build `policy: { … }` record before the ordinary
// module parser runs. Build policy is parsed by `pkg_parse_workspace_policy`;
// it is not a Jet module contribution. A `policy` word that is nested or not
// followed by `: {` is skipped together with the text before it.
fn pkg_overlay_strip_build_policy_blocks(body: String) -> String Never! {
    raw :: body.bytes()
    word_len :: MANIFEST_BLOCK_POLICY.bytes().len()
    out := [String]{}
    position := 0
    loop position < raw.len() {
        at :: pkg_overlay_find_word(raw, MANIFEST_BLOCK_POLICY, position) ?? break
        after :: at + word_len
        if pkg_overlay_code_depth_at(raw, at) != Val(0) {
            position = after
            next
        }
        colon :: pkg_bytes_skip_space(raw, after)
        if pkg_bytes_code(raw, colon) != OVERLAY_COLON {
            position = after
            next
        }
        open :: pkg_bytes_skip_space(raw, colon + 1)
        if pkg_bytes_code(raw, open) != OVERLAY_OPEN_BRACE {
            position = after
            next
        }
        &out.push(pkg_bytes_text(raw, position, at))
        position = open + 1 + pkg_overlay_balanced(raw, open + 1).consumed
    }
    &out.push(pkg_bytes_text(raw, position, raw.len()))
    out.join("")
}
