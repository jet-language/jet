// Rust: crates/jet-pkg-model/src/Package/ReleaseDevtoolsPolicy.rs:277
pub fn pkg_release_policy_development() -> JetReleaseDevtoolsPolicy {
    JetReleaseDevtoolsPolicy{inspect: .None, endpoint: JetReleaseDevtoolsEndpoint.Absent,
        authentication: JetReleaseDevtoolsAuthentication.BearerToken,
        authority: JetReleaseDevtoolsAuthority.LoopbackOrAllowlist,
        publication: JetReleaseDevtoolsPublication.SiteGated,
        local_rail: true, panel_code: true, stream_code: true, deployment: pkg_release_deployment_default()}
}
