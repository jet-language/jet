// Loader.rs:77-91,237-386,3034-3198. Entry and directory views share the
// existing inline extractor, Package parser, Config composer and no-follow
// authority resolver. The caller owns one declaration cache per operation.
use {
    jet_foundation.[Span, diagnostic_from_registry]
    jetpack_foundation.[DEFAULT_ENTRY_FILE]
}

pkg_entry_authority_error: fn(error: AuthorityError) -> ManifestError Never! {
    ManifestError{diagnostic: error.diagnostic()}
}

pkg_entry_workspace_error: fn(error: AuthorityError) -> ManifestError Never! {
    ManifestError{diagnostic: error.workspace_diagnostic()}
}

pkg_inline_body_error: fn(error: PackageParseError, span: Span) -> ManifestError Never! {
    ManifestError{diagnostic: diagnostic_from_registry("E1362", Val(span),
        "the inline Package body is malformed",
        error.message(),
        "fix the inline Package fields, then retry")}
}

pkg_inline_manifest_conflict: fn(span: Span?) -> ManifestError Never! {
    ManifestError{diagnostic: diagnostic_from_registry("E1363", span,
        "an inline Package conflicts with package.jet",
        "one project cannot carry both an inline Package block and a package.jet manifest",
        "remove package.jet or remove the inline Package block")}
}

// E1331's Why is the typed read cause: the native open failure of a missing
// entry, the native read failure, or Core's read-decode cause for bytes that
// are not UTF-8 (the E1334 authority detail keeps the byte position).
pkg_unreadable_entry: fn(entry: String, error: AuthorityError) -> ManifestError Never! {
    detail: if error == {
        .Missing(_, cause) -> cause
        .IO(_, _, detail) -> detail
        .NotText(_, _) -> "stream did not contain valid UTF-8"
        else -> error.message()
    }
    ManifestError{diagnostic: diagnostic_from_registry("E1331", None,
        "entry `{entry}` cannot be read", detail,
        "restore the entry source, then retry")}
}

// Preserve no-follow authority refusals rather than reporting a linked entry
// as ordinary absence. Missing/read/decode failures retain E1331.
pkg_entry_read_error: fn(entry: String, error: AuthorityError) -> ManifestError Never! {
    if error == {
        .Missing(_, _) | .IO(_, _, _) -> pkg_unreadable_entry(entry, error)
        else -> pkg_entry_authority_error(error)
    }
}

// Loader.rs `manifest_path_checked`: only a missing canonical manifest is
// absence; retired, malformed, linked and unreadable metadata stay errors.
pkg_manifest_path_checked: fn(root: String) -[FS, Env]> String? ManifestError! {
    resolver: AuthorityResolver.open(root) ?? {
        if err.is_missing() -> return Ok(None)
        return Err(pkg_entry_authority_error(err))
    }
    if resolver.checked_manifest(".") == {
        .Ok(manifest) -> {
            resolver.revalidate_file(manifest.file) ?? return Err(pkg_entry_authority_error(err))
            Ok(Val(manifest.file.path))
        }
        .Err(error) -> {
            if error.is_missing() -> return Ok(None)
            Err(pkg_entry_authority_error(error))
        }
    }
}

// Only the presence verdict is needed by upward discovery. Keep successful
// None distinct from a workspace resolution error; `??` collapses both.
pkg_entry_has_workspace: fn(resolver: AuthorityResolver, cache: &WorkspaceDeclarationCache) -[FS, Env]> Bool ManifestError! {
    if pkg_workspace_present(cache, resolver) == {
        .Ok(present) -> Ok(present)
        .Err(error) -> Err(pkg_entry_workspace_error(error))
    }
}

// The package carriers above one start: the nearest manifest root, and the
// nearest inline Package carrier root when the walk looks for one.
PkgPackageRoots: struct {
    manifest: String?
    inline: String?
}

// Loader.rs `find_manifest_root_checked` and, when `inline`,
// `find_inline_package_root_checked`, in one climb: both walks visit the same
// directories, so each is opened, and its workspace and manifest resolved,
// once. Declaration-resolved workspaces stop discovery even when their
// filenames are not workspace.jet, and a nearer manifest or a checked
// workspace prevents a parent stock entry from becoming authority. The inline
// walk ends at or below the manifest walk's end; its failure is reported only
// when the manifest walk completes without one, as if it ran second.
pkg_find_package_roots_checked: fn(cache: &WorkspaceDeclarationCache, start: String, inline: Bool) -[FS, Env]> PkgPackageRoots ManifestError! {
    dir := AuthorityResolver.authority_walk_root(start) ?? return Err(pkg_entry_authority_error(err))
    seeking_inline := inline
    inline_root := String?{None}
    inline_error := ManifestError?{None}
    loop {
        authority: if AuthorityResolver.open_for_authority_walk(dir) == {
            .Ok(found) -> found
            .Err(error) -> { return Err(pkg_entry_authority_error(error)) }
        }
        walked: authority != None
        // Explicit shared-directory boundaries are still inspected; upward
        // traversal itself remains pruned by the resolver. Only a walked
        // directory's workspace stops discovery; a boundary's must still
        // resolve wherever it carries a package.
        resolver: if authority.move() == {
            .Val(opened) -> opened
            .None -> AuthorityResolver.open(dir) ?? return Err(pkg_entry_authority_error(err))
        }
        workspace := false
        if walked {
            workspace = pkg_entry_has_workspace(resolver, cache)
        }
        has_manifest: if resolver.checked_manifest(".") == {
            .Ok(manifest) -> {
                if !walked {
                    _: pkg_entry_has_workspace(resolver, cache)
                }
                resolver.revalidate_file(manifest.file) ?? return Err(pkg_entry_authority_error(err))
                true
            }
            .Err(error) -> {
                if !error.is_missing() -> return Err(pkg_entry_authority_error(error))
                false
            }
        }
        if seeking_inline {
            if pkg_checked_inline_package_entry(resolver) == {
                .Ok(entry) -> {
                    if entry == .Val(_) {
                        seeking_inline = false
                        if !walked && !has_manifest && pkg_entry_has_workspace(resolver, cache) == .Err(error) {
                            inline_error = Val(error)
                        } else {
                            inline_root = Val(dir.copy())
                        }
                    } else if workspace || has_manifest {
                        seeking_inline = false
                    }
                }
                .Err(error) -> {
                    seeking_inline = false
                    inline_error = Val(error)
                }
            }
        }
        if has_manifest -> return pkg_package_roots_found(Val(dir), inline_root, inline_error)
        if workspace -> return pkg_package_roots_found(None, inline_root, inline_error)
        parent: AuthorityResolver.authority_walk_parent(dir) ?? return pkg_package_roots_found(None, inline_root, inline_error)
        dir = parent
    }
}

pkg_package_roots_found: fn(manifest: String?, inline: String?, inline_error: ManifestError?) -> PkgPackageRoots ManifestError! {
    if inline_error == .Val(error) -> return Err(error)
    Ok(PkgPackageRoots{manifest: manifest, inline: inline})
}

// Loader.rs `find_manifest_root_checked`.
pkg_find_manifest_root_checked: fn(cache: &WorkspaceDeclarationCache, start: String) -[FS, Env]> String? ManifestError! {
    if pkg_find_package_roots_checked(cache, start, false) == {
        .Ok(roots) -> Ok(roots.manifest)
        .Err(error) -> Err(error)
    }
}

// Loader.rs `checked_inline_package_entry`: run.jet, then src/run.jet. A
// stock entry with no carrier does not hide the second candidate's carrier.
pkg_checked_inline_package_entry: fn(resolver: AuthorityResolver) -[FS, Env]> CheckedFile? ManifestError! {
    candidates: [String]{DEFAULT_ENTRY_FILE, "src/{DEFAULT_ENTRY_FILE}"}
    loop relative in candidates {
        file: resolver.checked_file(relative) ?? {
            if err.is_missing() -> next
            return Err(pkg_entry_authority_error(err))
        }
        source: file.text() ?? return Err(pkg_entry_authority_error(err))
        block: if pkg_extract_inline_package(source) == {
            .Ok(found) -> found
            .Err(error) -> {
                resolver.revalidate_file(file) ?? return Err(pkg_entry_authority_error(err))
                return Err(ManifestError{diagnostic: error.diagnostic()})
            }
        }
        resolver.revalidate_file(file) ?? return Err(pkg_entry_authority_error(err))
        if block != None -> return Ok(Val(file.move()))
    }
    Ok(None)
}

// Both carrier forms complete through PackageLoad's transactional Config
// composition followed by guarantees, defaults and flat member validation.
pkg_entry_load_conventional: fn(root: String) -[FS, Env]> PackageFacts? ManifestError! {
    resolver: AuthorityResolver.open(root) ?? {
        if err.is_missing() -> return Ok(None)
        return Err(pkg_entry_authority_error(err))
    }
    manifest: resolver.checked_manifest(".") ?? {
        if err.is_missing() -> return Ok(None)
        return Err(pkg_entry_authority_error(err))
    }
    resolver.revalidate_file(manifest.file) ?? return Err(pkg_entry_authority_error(err))
    facts := manifest.facts
    compose_error := PackageParseError?{None}
    if pkg_load_compose_and_validate(facts, resolver) == .Err(error) -> compose_error = Val(error)
    resolver.revalidate_file(manifest.file) ?? return Err(pkg_entry_authority_error(err))
    if compose_error == .Val(error) {
        authority_error: if error == {
            .NestedMembers(member_root, member) -> AuthorityError.NestedMembers{root: member_root, member: member}
            else -> AuthorityError.Invalid{path: manifest.file.path, detail: error.message()}
        }
        return Err(pkg_entry_authority_error(authority_error))
    }
    Ok(Val(facts))
}

// Loader.rs `package_facts_from_entry_source` and
// `complete_inline_package_facts`. Never reopen the held entry by pathname.
pkg_package_facts_from_checked_entry: fn(resolver: AuthorityResolver, entry: CheckedFile, origin: String, manifest_root: String?) -[FS, Env]> PackageFacts? ManifestError! {
    resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
    source: entry.text() ?? return Err(pkg_entry_authority_error(err))
    block: if pkg_extract_inline_package(source) == {
        .Ok(found) -> found
        .Err(error) -> {
            resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
            return Err(ManifestError{diagnostic: error.diagnostic()})
        }
    }
    resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
    if block == .Val(inline) {
        if manifest_root != None -> return Err(pkg_inline_manifest_conflict(Val(inline.span)))
        facts := if PackageFacts.parse_uncomposed(inline.body(source), origin) == {
            .Ok(parsed) -> parsed
            .Err(error) -> {
                resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
                return Err(pkg_inline_body_error(error, inline.body_span))
            }
        }
        compose_error := PackageParseError?{None}
        if pkg_load_compose_and_validate(facts, resolver) == .Err(error) -> compose_error = Val(error)
        resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
        if compose_error == .Val(error) -> return Err(pkg_inline_body_error(error, inline.body_span))
        return Ok(Val(facts))
    }
    root: manifest_root ?? return Ok(None)
    loaded: if pkg_entry_load_conventional(root) == {
        .Ok(found) -> found
        .Err(error) -> {
            resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
            return Err(error)
        }
    }
    resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
    Ok(loaded)
}

// Loader.rs `inline_manifest_conflict_loader_error`: retain the stock
// carrier's whole-block span when a different entry exposed the conflict.
pkg_inline_root_conflict: fn(root: String) -[FS, Env]> ManifestError ManifestError! {
    resolver: AuthorityResolver.open(root) ?? return Err(pkg_entry_authority_error(err))
    found: pkg_checked_inline_package_entry(resolver)
    entry: found ?? return Ok(pkg_inline_manifest_conflict(None))
    source: entry.text() ?? return Err(pkg_entry_authority_error(err))
    block: if pkg_extract_inline_package(source) == {
        .Ok(inline) -> inline
        .Err(error) -> {
            resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
            return Err(ManifestError{diagnostic: error.diagnostic()})
        }
    }
    resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
    inline: block ?? return Ok(pkg_inline_manifest_conflict(None))
    Ok(pkg_inline_manifest_conflict(Val(inline.span)))
}

// Loader.rs `package_facts_for_root`. The supplied root is the explicit
// authority boundary; stock inline entry takes precedence only in the
// absence of a discovered conventional carrier.
pkg_package_facts_for_root: fn(cache: &WorkspaceDeclarationCache, root: String) -[FS, Env]> PackageFacts? ManifestError! {
    resolver: AuthorityResolver.open(root) ?? return Err(pkg_entry_authority_error(err))
    manifest_root: pkg_find_manifest_root_checked(cache, resolver.root)
    stock: pkg_checked_inline_package_entry(resolver)
    entry: stock ?? {
        found: manifest_root ?? return Ok(None)
        return pkg_entry_load_conventional(found)
    }
    facts: if pkg_package_facts_from_checked_entry(resolver, entry, entry.path, manifest_root) == {
        .Ok(found) -> found
        .Err(error) -> {
            resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
            return Err(error)
        }
    }
    resolver.revalidate_file(entry) ?? return Err(pkg_entry_authority_error(err))
    Ok(facts)
}

// Loader.rs `package_facts_for_entry`. A non-stock entry may inherit a
// parent's stock inline Package only when it has no carrier of its own.
pkg_package_facts_for_entry: fn(cache: &WorkspaceDeclarationCache, entry: String) -[FS, Env]> PackageFacts? ManifestError! {
    parent: pkg_authority_effective_root(pkg_path_parent(entry))
    resolver: AuthorityResolver.open(parent) ?? return Err(pkg_entry_read_error(entry, err))
    checked: resolver.checked_file(pkg_path_file_name(entry)) ?? return Err(pkg_entry_read_error(entry, err))
    checked.text() ?? return Err(pkg_unreadable_entry(entry, err))
    roots: pkg_find_package_roots_checked(cache, resolver.root, true)
    manifest_root: roots.manifest
    inline_root: roots.inline
    loaded: if pkg_package_facts_from_checked_entry(resolver, checked, entry, manifest_root) == {
        .Ok(found) -> found
        .Err(error) -> {
            resolver.revalidate_file(checked) ?? return Err(pkg_entry_authority_error(err))
            return Err(error)
        }
    }
    resolver.revalidate_file(checked) ?? return Err(pkg_entry_authority_error(err))
    if manifest_root != None && inline_root == .Val(root) {
        return Err(pkg_inline_root_conflict(root))
    }
    if loaded != None || inline_root == None -> return Ok(loaded)
    root: inline_root ?? return Ok(None)
    inherited: if pkg_package_facts_for_root(cache, root) == {
        .Ok(found) -> found
        .Err(error) -> {
            resolver.revalidate_file(checked) ?? return Err(pkg_entry_authority_error(err))
            return Err(error)
        }
    }
    resolver.revalidate_file(checked) ?? return Err(pkg_entry_authority_error(err))
    Ok(inherited)
}
