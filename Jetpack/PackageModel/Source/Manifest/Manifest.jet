// The compiler-facing `Manifest` loaded from `package.jet` (Manifest.rs):
// package identity, dependencies, the toolchain (E1208) and edition (E2001)
// checks, release status and the version banner, the comment-preserving edit
// entry points, and every manifest diagnostic (E12xx).
use {
    manifest_core_files: core.files
    manifest_core_sys: core.sys
    jet_foundation.[
        Diagnostic, AllocatorPolicy, RuntimeLayer, Span, diagnostic_from_registry,
        diagnostic_registry_row, foundation_json_quote,
    ]
    jetpack_foundation.[
        BINARY_NAME, FILE_EXT, LANG_NAME, MANIFEST_BLOCK_AUTHORITY, MANIFEST_FIELD_EDITION,
        PACKAGE_FILE, TARGET_EXAMPLE,
        TARGET_EXECUTABLE, TARGET_FIELD_ENTRY, TARGET_FIELD_NAME, TARGET_LIBRARY, TARGET_SANDBOX,
        TARGET_TEST,
    ]
}

// Jet's own version, `a0.0.N`: the alpha release this source line becomes.
// The commit after a release raises N, and Tools/release `admit` refuses a
// tree whose JET_VERSION is not the release it names. The compiler identity,
// `jet --version`, help, the REPL banner, `jet new`, the engine handshake and
// the E1208 toolchain check all read it; tests/guards/jet_version.jet keeps
// any other self-version spelling out.
JET_VERSION: "a0.0.44"
// The release channel the `a` of JET_VERSION names.
JET_VERSION_CHANNEL: "alpha"
// The stamps a published compiler keeps beside its executable: VERSION
// (`a0.0.N <commit> <YYYY-MM-DD>`, written by Tools/release `admit` and
// shipped in the release) marks a release; COMMIT (the commit, written by
// Tools/agent/Land.jet and Tools/release `build`) marks a dev build of a
// known commit. A build may not read git, so a fresh `jet build` has neither.
JET_VERSION_STAMP: "VERSION"
JET_COMMIT_STAMP: "COMMIT"

// Supported editions, oldest to newest; the last is the newest stable. One
// language edition, 2026, as the compiler loader accepts (7bef65ccd4).
LATEST_EDITION: "2026"
SUPPORTED_EDITIONS: [String]{"2026"}

// The registry-protocol version this toolchain speaks.
REGISTRY_COMPAT: "1"

CURRENT_RELEASE_CHANNEL: "prerelease"
CURRENT_RELEASE_DISPOSITION: "current"
CURRENT_RELEASE_READINESS: "not-ready"
RELEASE_COMPATIBILITY_POLICY: "future-1.0"
RELEASE_COMPATIBILITY_POLICY_DISPOSITION: "planned"
RELEASE_COMPATIBILITY_POLICY_ACTIVE: false

// The current release identity, independent of the package SemVer.
ReleaseStatus: struct {
    channel: String
    disposition: String
    readiness: String
    policy: String
    policy_disposition: String
    policy_active: Bool
}

// One executable source for the current release/readiness projection.
pkg_current_release_status: fn() -> ReleaseStatus Never! {
    ReleaseStatus{
        channel: CURRENT_RELEASE_CHANNEL,
        disposition: CURRENT_RELEASE_DISPOSITION,
        readiness: CURRENT_RELEASE_READINESS,
        policy: RELEASE_COMPATIBILITY_POLICY,
        policy_disposition: RELEASE_COMPATIBILITY_POLICY_DISPOSITION,
        policy_active: RELEASE_COMPATIBILITY_POLICY_ACTIVE,
    }
}

// An edition label's year; unknown labels sort before every edition.
pkg_edition_year: fn(edition: String) -> Int Never! {
    year: pkg_parse_u64(edition.trim()) ?? return 0
    if year > 65535 -> return 0
    year
}

pkg_edition_at_least: fn(edition: String, baseline: String) -> Bool Never! {
    pkg_edition_year(edition) >= pkg_edition_year(baseline)
}

// A manifest's effective edition, defaulting to the newest stable one.
pkg_effective_edition: fn(manifest: Manifest) -> String Never! {
    edition: manifest.package.edition ?? return pkg_latest_edition()
    if edition.trim() == "" -> return pkg_latest_edition()
    edition
}

pkg_latest_edition: fn() -> String Never! {
    LATEST_EDITION
}

pkg_edition_is_supported: fn(edition: String) -> Bool Never! {
    SUPPORTED_EDITIONS.contains(edition.trim())
}

// A manifest asking for an edition this toolchain lacks is E2001.
pkg_check_edition_support: fn(manifest: Manifest, file: String) ManifestError! {
    edition: manifest.package.edition ?? return
    if pkg_edition_is_supported(edition) -> return
    return Err(ManifestError{diagnostic: pkg_e2001(edition)})
}

pkg_e2001: fn(requested: String) -> Diagnostic Never! {
    diagnostic_from_registry("E2001", None,
        "this package needs a newer Jet",
        "editions opt a project into a specific era of Jet syntax. A newer edition can use syntax this compiler does not understand. This toolchain supports editions up to {pkg_latest_edition()}, but `{PACKAGE_FILE}` asks for `{requested}`.",
        "upgrade with `{BINARY_NAME} self upgrade`, or set `{MANIFEST_FIELD_EDITION}: \"{pkg_latest_edition()}\"` in `{PACKAGE_FILE}`.")
}

// The running compiler: JET_VERSION and what its stamps say. `version` is the
// one spelling of this build: `a0.0.43` for the release, `a0.0.43-dev+<the
// commit's first 10 hex digits>` for a dev build, `a0.0.43-dev` for a build of
// an unknown commit. `commit` (40 hex) and `date` are "" when unknown.
JetBuild: struct {
    version: String
    commit: String
    date: String
    released: Bool
}

// The build its stamps describe (None: no such file). A VERSION stamp counts
// only when it names JET_VERSION, a 40-hex commit and a `YYYY-MM-DD` date; a
// COMMIT stamp only when its first line is a 40-hex commit.
pkg_jet_build_from_stamps: fn(version_stamp: String?, commit_stamp: String?) -> JetBuild Never! {
    if version_stamp == .Val(text) {
        words: text.trim().split(" ").to_list()
        if words.len() == 3 && words[0] == JET_VERSION && pkg_is_commit_hex(words[1]) && pkg_is_iso_date(words[2]) {
            return JetBuild{version: JET_VERSION, commit: words[1].copy(), date: words[2].copy(), released: true}
        }
    }
    if commit_stamp == .Val(text) {
        commit: text.trim().split("\n").to_list()[0].trim()
        if pkg_is_commit_hex(commit) -> return JetBuild{version: "{JET_VERSION}-dev+{commit.slice(0..<10)}", commit: commit.copy(), date: "", released: false}
    }
    JetBuild{version: "{JET_VERSION}-dev", commit: "", date: "", released: false}
}

// The running compiler's build, from the stamps beside its executable.
pkg_jet_build: fn() -[FS, Env]> JetBuild Never! {
    dir: manifest_core_files.dirname(manifest_core_sys.executable())
    version_stamp: manifest_core_files.read(manifest_core_files.join(dir, JET_VERSION_STAMP)) ?? ""
    commit_stamp: manifest_core_files.read(manifest_core_files.join(dir, JET_COMMIT_STAMP)) ?? ""
    pkg_jet_build_from_stamps(if version_stamp == "" -> None else -> Val(version_stamp), if commit_stamp == "" -> None else -> Val(commit_stamp))
}

pkg_is_commit_hex: fn(text: String) -> Bool Never! {
    if text.count_bytes() != 40 -> return false
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

pkg_is_iso_date: fn(text: String) -> Bool Never! {
    raw: text.bytes()
    if raw.len() != 10 -> return false
    loop (index, byte) in raw {
        code: Int.from_u8(byte)
        if index == 4 || index == 7 {
            if code != 45 -> return false
        } else if code < 48 || code > 57 {
            return false
        }
    }
    true
}

// The first line of the `jet --version` banner, which bare `jet` also prints:
// `jet a0.0.43 (29517f5447, 2026-11-09, alpha)` for a release, `jet
// a0.0.43-dev+29517f5447` otherwise.
pkg_version_line: fn(build: JetBuild) -> String Never! {
    if build.released -> return "{BINARY_NAME} {build.version} ({build.commit.slice(0..<10)}, {build.date}, {JET_VERSION_CHANNEL})"
    "{BINARY_NAME} {build.version}"
}

// The `jet --version` banner (E2-D1). Each readout line starts with a
// capital; the values are the JSON tokens of pkg_version_json, displayed.
pkg_version_banner: fn(build: JetBuild) -> String Never! {
    release: pkg_current_release_status()
    policy_state: if release.policy_active -> "active" else -> "not active"
    "{pkg_version_line(build)}\nRelease status: {pkg_release_word(release.channel)}\nRelease disposition: {pkg_release_word(release.disposition)}\nRelease readiness: {pkg_release_word(release.readiness)}\nCompatibility policy: {pkg_release_word(release.policy)} ({release.policy_disposition}; {policy_state})\nSupported editions: {SUPPORTED_EDITIONS.join(", ")} (newest: {pkg_latest_edition()})\nRegistry protocol: v{REGISTRY_COMPAT}\n"
}

// A release token as the banner shows it: `not-ready` is `Not ready`,
// `future-1.0` is `Future 1.0`.
pkg_release_word: fn(token: String) -> String Never! {
    if token == "" -> return ""
    words: token.replace("-", " ")
    "{words.slice(0, 1).to_upper()}{words.slice(1, words.len())}"
}

// `jet --version --json`: the banner's facts as one JSON object.
pkg_version_json: fn(build: JetBuild) -> String Never! {
    release: pkg_current_release_status()
    commit: if build.commit == "" -> "null" else -> foundation_json_quote(build.commit)
    date: if build.date == "" -> "null" else -> foundation_json_quote(build.date)
    editions := [String]{}
    loop edition in SUPPORTED_EDITIONS -> editions.push(foundation_json_quote(edition))
    "{{\"version\":{foundation_json_quote(build.version)},\"release\":{foundation_json_quote(JET_VERSION)},\"released\":{build.released},\"commit\":{commit},\"date\":{date},\"channel\":{foundation_json_quote(JET_VERSION_CHANNEL)},\"release_status\":{foundation_json_quote(release.channel)},\"release_disposition\":{foundation_json_quote(release.disposition)},\"release_readiness\":{foundation_json_quote(release.readiness)},\"compatibility_policy\":{foundation_json_quote(release.policy)},\"compatibility_policy_active\":{release.policy_active},\"supported_editions\":[{editions.join(",")}],\"registry_protocol\":{foundation_json_quote(REGISTRY_COMPAT)}}}\n"
}

// The one error carrier of the compiler-facing manifest API: the registered
// diagnostic the load or check stopped on.
#Error
ManifestError: struct {
    diagnostic: Diagnostic
}

Manifest: struct {
    package: PackageMeta
    // Root metadata policy carried into fetch.
    policy: PackagePolicy
    // Package authority policy.
    authority: PackageAuthority
    // Package-owned import boundary policy.
    boundaries: [ImportBoundary]
    // Jet package dependencies.
    dependencies: [String: DepSpec]
    // Rust crate dependencies for `extern rust` blocks; never parsed from
    // `package.jet` (each block pins its own version).
    dependencies_rust: [String: String]
    // Raw `package.jet` text, kept for comment-preserving edits.
    raw: String

    // Parse a `package.jet` manifest from its text.
    parse: fn(path: String, raw: String) -> Manifest ManifestError! {
        pkg_manifest_parse(path, raw)
    }
}

PackageMeta: struct {
    name: String
    version: String
    // `edition: "..."` None tracks the newest stable edition.
    edition: String?
    // Toolchain constraint from `jet: "..."`.
    jet_constraint: String?
    description: String?
    license: String?
    repository: String?
    // Optional runtime ceiling from `runtime:`.
    layer: RuntimeLayer?
    // Selected hosted whole-program allocator.
    allocator: AllocatorPolicy
}

DepSpec: enum {
    // Path dependency: `helpers: ../helpers`.
    Path(path: String)
    // Git dependency with one selector, or an `owner/repo/rev@github` ref.
    Git(url: String, selector: GitSelector)
    // Registry version string.
    Registry(String)
    // This rule project-tier dependency.
    Foreign(language: ForeignLanguage, reference: String)
}

GitSelector: enum {
    Tag(String)
    Branch(String)
    Rev(String)

    is_moving: fn(self) -> Bool Never! {
        if self == {
            .Tag(label) -> label == "@latest"
            .Branch(_) -> true
            .Rev(_) -> false
        }
    }

    // The `package.jet` field spelling of this selector.
    field: fn(self) -> String Never! {
        if self == {
            .Tag(_) -> "tag"
            .Branch(_) -> "branch"
            .Rev(_) -> "rev"
        }
    }

    value: fn(self) -> String Never! {
        if self == {
            .Tag(value) | .Branch(value) | .Rev(value) -> value
        }
    }
}

// Parse a `package.jet` manifest: the package's own declared facts
// (uncomposed), its guarantees, then the compiler-facing conversion.
pkg_manifest_parse: fn(path: String, raw: String) -> Manifest ManifestError! {
    facts: if PackageFacts.parse_uncomposed(raw, path) == {
        .Ok(parsed) -> parsed
        .Err(error) -> {
            return Err(ManifestError{diagnostic: pkg_manifest_parse_diagnostic(path, error)})
        }
    }
    if facts.validate_guarantees() == .Err(error) -> return Err(ManifestError{diagnostic: pkg_manifest_parse_diagnostic(path, error)})
    if pkg_to_manifest(facts, raw) == {
        .Ok(manifest) -> Ok(manifest)
        .Err(error) -> Err(error)
    }
}

// The path to the one package manifest in a project directory.
pkg_manifest_path_in: fn(dir: String) -> String Never! {
    manifest_core_files.join(dir, PACKAGE_FILE)
}

// Validate the `jet:` toolchain constraint (E1208). A channel pin is owned
// by version dispatch only an operator constraint is
// checked here.
pkg_check_toolchain: fn(manifest: Manifest, file: String) ManifestError! {
    constraint: manifest.package.jet_constraint ?? return
    if !pkg_is_range_constraint(constraint) -> return
    if pkg_satisfies_constraint(JET_VERSION, constraint) -> return
    return Err(ManifestError{diagnostic: diagnostic_from_registry("E1208", None,
        "this project requires Jet `{constraint}` but this is Jet {JET_VERSION}",
        "the top-level `jet` field specifies a minimum toolchain version",
        "update Jet to a newer version, or change the `jet` field in `{PACKAGE_FILE}`")})
}

pkg_is_range_constraint: fn(value: String) -> Bool Never! {
    first: pkg_bytes_code(value.trim().bytes(), 0)
    first == 62 || first == 60 || first == 61 || first == 94 || first == 126 || first == 42
}

pkg_satisfies_constraint: fn(version: String, input: String) -> Bool Never! {
    constraint: input.trim()
    if constraint == "*" || constraint == "" -> return true
    if constraint.starts_with(">=") -> return pkg_version_ge(version, constraint.removeprefix(">=").trim())
    if constraint.starts_with("^") -> return pkg_version_ge(version, constraint.removeprefix("^").trim())
    version.trim() == constraint
}

pkg_version_ge: fn(a: String, b: String) -> Bool Never! {
    left: pkg_version_rank(a)
    right: pkg_version_rank(b)
    loop index in 0..<4 {
        if left[index] != right[index] -> return left[index] > right[index]
    }
    true
}

// `[a]major.minor.patch` as major, minor, patch and then 0 for an alpha (the
// `a` prefix Jet's own versions carry) or 1 for a plain version, so an alpha
// sorts just before the plain version of the same numbers. Each missing or
// malformed part reads as 0.
pkg_version_rank: fn(text: String) -> [Int] Never! {
    trimmed: text.trim()
    alpha: trimmed.starts_with("a")
    parts: (if alpha -> trimmed.removeprefix("a") else -> trimmed).split(".").to_list()
    out := [Int]{}
    loop index in 0..<3 {
        if index >= parts.len() {
            out.push(0)
            next
        }
        piece: if index == 2 && parts.len() > 3 -> parts[2..<parts.len()].join(".") else -> parts[index]
        out.push(pkg_parse_u64(piece) ?? 0)
    }
    out.push(if alpha -> 0 else -> 1)
    out
}

// Comment-preserving `jet add`/`jet remove` edits.
pkg_add_dependency: fn(raw: String, name: String, spec: DepSpec) -> String Never! {
    pkg_add_dep(raw, name, spec)
}

pkg_remove_dependency: fn(raw: String, name: String) -> String Never! {
    pkg_remove_dep(raw, name)
}

// Rust `Diagnostic::from_row(code, holes, span)`: fill the registered row's
// `{hole}` templates and project its protocol metadata.
pkg_manifest_diagnostic_from_row: fn(code: String, holes: [ManifestEntry], span: Span?) -> Diagnostic Never! {
    row: diagnostic_registry_row(code) ?? panic("diagnostic `{code}` has no typed row")
    what := row.what
    why := row.why
    fix := row.fix
    loop hole in holes {
        marker: "{{{hole.key}}}"
        what = what.replace(marker, hole.value)
        why = why.replace(marker, hole.value)
        fix = fix.replace(marker, hole.value)
    }
    diagnostic_from_registry(code, span, what, why, fix)
}

// The registered diagnostic for one Package parse failure.
pkg_manifest_parse_diagnostic: fn(path: String, error: PackageParseError) -> Diagnostic Never! {
    if error == {
        .UnknownField(field) -> pkg_e1215_unknown_field(field)
        .MissingName -> pkg_e1215("`{PACKAGE_FILE}` needs a `name` field")
        .MissingRecord(field) -> pkg_e1215("`{field}:` needs a record value")
        .MalformedField(value) -> pkg_e1215("malformed field `{value}`")
        .UnknownOutputKind(kind) -> pkg_e1215("unknown Output kind `{kind}`")
        .RetiredRecordHead -> pkg_e1215("record literals use `{{ … }}`; remove the dot before `{{`")
        .InvalidValue(field, value) -> {
            if field == "runtime" -> return pkg_e1215("`runtime` must be `core`, `alloc`, or `hosted`, not `{value}`")
            pkg_e1215("invalid value for `{field}`: `{value}`")
        }
        .ConfigMembers -> pkg_e1215("a Config file cannot declare `members`")
        .NestedMembers(root, member) -> diagnostic_from_registry("E1323", None,
            "member Package `{member}` declares `members`",
            "Package membership has depth cap one: `{root}` owns the member list, but `{member}` declares another one",
            "remove `members:` from `{member}` and lift its references into `{root}`")
        .LintPolicyCode(code, name) -> pkg_manifest_diagnostic_from_row("E1206", [ManifestEntry]{ManifestEntry{key: "code", value: code}, ManifestEntry{key: "name", value: name}}, None)
        .Composition(detail) -> pkg_e1215(detail)
        .BadTarget(name, value, reserved) -> {
            if reserved -> return pkg_e1210("package `{name}` lists target `{value}`, which has no backend yet (reserved for a future increment)")
            pkg_e1210("package `{name}` lists target `{value}`, which is not a known target")
        }
        .BadTargetField(name, detail) -> pkg_e1216("package `{name}`: {detail}")
        .ReservedSection(section) -> pkg_e1209(path, section)
        .BadEffectsBlock(detail) -> pkg_e1221(detail)
        .RetiredAuthorityField(field, replacement) -> diagnostic_from_registry("E1215", None,
            "`{field}` is not a field",
            "`{field}` moved into `{replacement}` in the one `authority:` block.",
            "write `{replacement}` inside `authority: {{ … }}`")
        .BadMemoryPolicy(detail) -> {
            if detail.contains("is not a memory floor") || detail.contains("memory floors belong in `authority.deny`") {
                return diagnostic_from_registry("E1215", None,
                    "`{PACKAGE_FILE}` names an unknown memory floor",
                    "{detail}; memory floors belong in `authority.deny`.",
                    "write the denial in `authority.deny` inside `authority: {{ deny: […] }}`")
            }
            pkg_e1215("memory policy is malformed: {detail}")
        }
        .RetiredPolicyField(field, replacement) -> diagnostic_from_registry("E1215", None,
            "`{field}` is not a field",
            "Package refusals use the named `policy.lints.deny` surface; `{field}` was a separate boolean and no longer has meaning.",
            "remove `{field}` for the default, or put `auto_derive` in `policy.lints.deny` as `{replacement}` to refuse auto-derive")
        .BadGuaranteePolicy(detail) -> pkg_e1215("package guarantee policy is malformed: {detail}")
        .BadPackagePolicy(detail) -> pkg_e1215("package metadata policy is malformed: {detail}")
        .BadAllocatorPolicy(detail) -> diagnostic_from_registry("E1222", None,
            "invalid hosted program allocator",
            detail,
            "use `allocator: mem.Heap` or wrap it with `allocator: mem.Counting.over(mem.Heap, cap: 2.gb)`")
    }
}

// An unknown top-level manifest field.
pkg_e1215_unknown_field: fn(field: String) -> Diagnostic Never! {
    diagnostic_from_registry("E1215", None,
        "unknown field `{field}:` in `{PACKAGE_FILE}`",
        "`{field}:` is not part of the Package vocabulary. Identity is bare `name:` and `version:` at the top level — there is no `identity:` or `payload:` wrapper.",
        "use `name:`, `version:`, `deps:`, `boundaries:`, `outputs:`, `settings:`, `build:`, `authority:`, `policy:`, or `members:`")
}

// E1221: a malformed `authority:` block.
pkg_e1221: fn(detail: String) -> Diagnostic Never! {
    diagnostic_from_registry("E1221", None,
        "`{PACKAGE_FILE}` has a malformed `{MANIFEST_BLOCK_AUTHORITY}` block",
        detail,
        "`authority: {{ allow: […], deny: […], grants: {{ \"dep\": […] }}, trust: {{ … }}, providers: {{ … }} }}` is the one package authority block; rights use the thirteen grantable roots, `FFI` and its language leaves (`FFI.Go`, `FFI.Py`, `FFI.Octave`), plus deny-only `Panic`/`Mem`")
}

pkg_e1215: fn(detail: String) -> Diagnostic Never! {
    diagnostic_from_registry("E1215", None,
        "`{PACKAGE_FILE}` has a shape error",
        detail,
        "check `{PACKAGE_FILE}` against Docs/spec/syntax-decisions.md (U1)")
}

pkg_e1209: fn(file: String, section: String) -> Diagnostic Never! {
    diagnostic_from_registry("E1209", None,
        "`{section}` is reserved and not yet implemented",
        "this section name is reserved for a future Jet feature — using it now is an error",
        "remove the `{section}` block from `{PACKAGE_FILE}`, or leave it empty")
}

pkg_e1210: fn(detail: String) -> Diagnostic Never! {
    diagnostic_from_registry("E1210", None,
        "`{PACKAGE_FILE}` lists an unknown target",
        detail,
        "use a shipped target: `{TARGET_LIBRARY}`, `{TARGET_EXECUTABLE}`, `{TARGET_TEST}`, `{TARGET_EXAMPLE}`, or `{TARGET_SANDBOX}`")
}

pkg_e1216: fn(detail: String) -> Diagnostic Never! {
    diagnostic_from_registry("E1216", None,
        "`{PACKAGE_FILE}` has an invalid target field",
        detail,
        "a target block accepts `{TARGET_FIELD_ENTRY}: \"…\"` and `{TARGET_FIELD_NAME}: \"…\"`")
}

pkg_e1212: fn(file: String, name: String) -> Diagnostic Never! {
    diagnostic_from_registry("E1212", None,
        "`{PACKAGE_FILE}` declares package `{name}` but no `{name}: module` was found",
        "each `packages:` name must correspond to a `module <name> {{ … }}` declaration in a `.{FILE_EXT}` file in the source tree",
        "add a `.{FILE_EXT}` file containing `{name}: module {{ … }}`, or remove `{name}` from `packages:` in `{PACKAGE_FILE}`")
}

pkg_e1213: fn(file: String, name: String, paths: [String]) -> Diagnostic Never! {
    diagnostic_from_registry("E1213", None,
        "`{PACKAGE_FILE}` declares package `{name}` but `{name}: module` is ambiguous",
        "`{name}: module` was found in multiple files: {paths.join(", ")}; each package name must map to exactly one module",
        "rename one of the conflicting `{name}: module` declarations so each package has a unique name")
}

// `--profile=<name>` names no blessed or declared profile.
pkg_e1219: fn(name: String) -> Diagnostic Never! {
    pkg_manifest_diagnostic_from_row("E1219", [ManifestEntry]{ManifestEntry{key: "name", value: name}}, None)
}
