// The compiler-facing `Manifest` loaded from `package.jet` (Manifest.rs):
// package identity, dependencies, the toolchain (E1208) and edition (E2001)
// checks, release status and the version banner, the comment-preserving edit
// entry points, and every manifest diagnostic (E12xx).

// The compiler's version string for E1208 toolchain checks (CARGO_PKG_VERSION
// of the Rust jet-pkg-model crate).
COMPILER_VERSION :: prep { "0.1.0" }

// D-REL3: supported editions, oldest to newest; the last is the newest stable.
LATEST_EDITION :: prep { "2028" }
SUPPORTED_EDITIONS :: prep { [String]{"2026", "2027", "2028"} }

// D-REL1: the registry-protocol version this toolchain speaks.
REGISTRY_COMPAT :: prep { "1" }

CURRENT_RELEASE_CHANNEL :: prep { "prerelease" }
CURRENT_RELEASE_DISPOSITION :: prep { "current" }
CURRENT_RELEASE_READINESS :: prep { "not-ready" }
RELEASE_COMPATIBILITY_POLICY :: prep { "future-1.0" }
RELEASE_COMPATIBILITY_POLICY_DISPOSITION :: prep { "planned" }
RELEASE_COMPATIBILITY_POLICY_ACTIVE :: prep { false }

// The current release identity, independent of the package SemVer.
pub struct ReleaseStatus {
    pub channel: String
    pub disposition: String
    pub readiness: String
    pub policy: String
    pub policy_disposition: String
    pub policy_active: Bool
}

// One executable source for the current release/readiness projection.
pub fn pkg_current_release_status() -> ReleaseStatus Never! {
    ReleaseStatus{
        channel: CURRENT_RELEASE_CHANNEL,
        disposition: CURRENT_RELEASE_DISPOSITION,
        readiness: CURRENT_RELEASE_READINESS,
        policy: RELEASE_COMPATIBILITY_POLICY,
        policy_disposition: RELEASE_COMPATIBILITY_POLICY_DISPOSITION,
        policy_active: RELEASE_COMPATIBILITY_POLICY_ACTIVE,
    }
}

// An edition label's year; unknown labels sort before every edition.
pub fn pkg_edition_year(edition: String) -> Int Never! {
    year :: pkg_parse_u64(edition.trim()) ?? return 0
    if year > 65535 -> return 0
    year
}

pub fn pkg_edition_at_least(edition: String, baseline: String) -> Bool Never! {
    pkg_edition_year(edition) >= pkg_edition_year(baseline)
}

// A manifest's effective edition, defaulting to the newest stable one.
pub fn pkg_effective_edition(manifest: Manifest) -> String Never! {
    edition :: manifest.package.edition ?? return pkg_latest_edition()
    if edition.trim() == "" -> return pkg_latest_edition()
    edition
}

pub fn pkg_latest_edition() -> String Never! {
    LATEST_EDITION
}

pub fn pkg_edition_is_supported(edition: String) -> Bool Never! {
    SUPPORTED_EDITIONS.contains(edition.trim())
}

// D-REL3: a manifest asking for an edition this toolchain lacks is E2001.
pub fn pkg_check_edition_support(manifest: Manifest, file: String) ManifestError! {
    edition :: manifest.package.edition ?? return
    if pkg_edition_is_supported(edition) -> return
    return Err(ManifestError{diagnostic: pkg_e2001(edition)})
}

pub fn pkg_e2001(requested: String) -> Diagnostic Never! {
    diagnostic_from_registry("E2001", None,
        "this package needs a newer Jet",
        "editions opt a project into a specific era of Jet syntax. A newer edition can use syntax this compiler does not understand. This toolchain supports editions up to {pkg_latest_edition()}, but `{PACKAGE_FILE}` asks for `{requested}`.",
        "upgrade with `{BINARY_NAME} self upgrade`, or set `{MANIFEST_FIELD_EDITION}: \"{pkg_latest_edition()}\"` in `{PACKAGE_FILE}`.")
}

// The `jet --version` banner (E2-D1).
pub fn pkg_version_banner() -> String Never! {
    release :: pkg_current_release_status()
    policy_state :: if release.policy_active -> "active" else -> "not active"
    "{LANG_NAME} {COMPILER_VERSION}\nrelease status: {release.channel}\nrelease disposition: {release.disposition}\nrelease readiness: {release.readiness}\n1.0 compatibility policy: {release.policy} ({release.policy_disposition}; {policy_state})\nsupported editions: {SUPPORTED_EDITIONS.join(", ")} (newest: {pkg_latest_edition()})\nregistry protocol: v{REGISTRY_COMPAT}\n"
}

// The one error carrier of the compiler-facing manifest API: the registered
// diagnostic the load or check stopped on.
#Error
pub struct ManifestError {
    pub diagnostic: Diagnostic
}

pub struct Manifest {
    pub package: PackageMeta
    // D-JPK-POLICYSURFACE1=D: root metadata policy carried into fetch.
    pub policy: PackagePolicy
    // D-AUTHORITY-MANIFEST1=A: package authority policy.
    pub authority: PackageAuthority
    // D-STRUCT-EDGE1=A: package-owned import boundary policy.
    pub boundaries: [ImportBoundary]
    // Jet package dependencies.
    pub dependencies: [String: DepSpec]
    // Rust crate dependencies for `extern rust` blocks; never parsed from
    // `package.jet` (each block pins its own version).
    pub dependencies_rust: [String: String]
    // Raw `package.jet` text, kept for comment-preserving edits.
    pub raw: String

    // Parse a `package.jet` manifest from its text.
    fn parse(path: String, raw: String) -> Manifest ManifestError! {
        pkg_manifest_parse(path, raw)
    }
}

pub struct PackageMeta {
    pub name: String
    pub version: String
    // `edition: "..."` (D-REL3); None tracks the newest stable edition.
    pub edition: String?
    // Toolchain constraint from `jet: "..."`.
    pub jet_constraint: String?
    pub description: String?
    pub license: String?
    pub repository: String?
    // D-RINGLAYER1=A: optional runtime ceiling from `runtime:`.
    pub layer: MIRRuntimeLayer?
    // D-ALLOC-PROGRAM1=A: selected hosted whole-program allocator.
    pub allocator: MIRAllocatorPolicy
}

pub enum DepSpec {
    // Path dependency: `helpers: ../helpers`.
    Path(path: String)
    // Git dependency with one selector, or an `owner/repo/rev@github` ref.
    Git(url: String, selector: GitSelector)
    // Registry version string.
    Registry(String)
    // D-FFI-UNIFY1 project-tier dependency.
    Foreign(language: ForeignLanguage, reference: String)
}


// Parse a `package.jet` manifest: the package's own declared facts
// (uncomposed), its guarantees, then the compiler-facing conversion.
pub fn pkg_manifest_parse(path: String, raw: String) -> Manifest ManifestError! {
    facts :: if PackageFacts.parse_uncomposed(raw, path) == {
        .Ok(parsed) -> parsed
        .Err(error) -> {
            return Err(ManifestError{diagnostic: pkg_manifest_parse_diagnostic(path, error)})
        }
    }
    if facts.validate_guarantees() == .Err(error) -> return Err(ManifestError{diagnostic: pkg_manifest_parse_diagnostic(path, error)})
    if pkg_to_manifest(facts, raw) == {
        .Ok(manifest) -> Ok(manifest)
        .Err(error) -> Err(error)
    }
}

// The path to the one package manifest in a project directory.
pub fn pkg_manifest_path_in(dir: String) -> String Never! {
    files.join(dir, PACKAGE_FILE)
}

// Whether both the canonical manifest and a retired alias exist.
pub fn pkg_has_both_manifests(dir: String) -[FS, Env]> Bool Never! {
    if AuthorityResolver.open(dir) == {
        .Ok(resolver) -> {
            if resolver.checked_manifest(".") == {
                .Ok(_) -> return false
                .Err(error) -> return !error.is_missing()
            }
        }
        .Err(_) -> return true
    }
}

// Load and parse the package manifest in a directory; None when absent.
pub fn pkg_manifest_load(dir: String) -[FS, Env]> Manifest? ManifestError! {
    resolver :: if AuthorityResolver.open(dir) == {
        .Ok(opened) -> opened
        .Err(error) -> {
            if error.is_missing() -> return Ok(None)
            return Err(ManifestError{diagnostic: error.diagnostic()})
        }
    }
    checked :: if resolver.checked_manifest(".") == {
        .Ok(found) -> found
        .Err(error) -> {
            if error.is_missing() -> return Ok(None)
            return Err(ManifestError{diagnostic: error.diagnostic()})
        }
    }
    raw :: if checked.file.text() == {
        .Ok(text) -> text
        .Err(error) -> {
            return Err(ManifestError{diagnostic: error.diagnostic()})
        }
    }
    if resolver.revalidate_file(checked.file) == .Err(error) -> return Err(ManifestError{diagnostic: error.diagnostic()})
    result :: pkg_manifest_parse(checked.file.path, raw)
    if resolver.revalidate_file(checked.file) == .Err(error) -> return Err(ManifestError{diagnostic: error.diagnostic()})
    Ok(Val(result))
}

// Validate the `jet:` toolchain constraint (E1208). A channel pin is owned
// by version dispatch (D-JPK-TOOLCHAIN1); only an operator constraint is
// checked here.
pub fn pkg_check_toolchain(manifest: Manifest, file: String) ManifestError! {
    constraint :: manifest.package.jet_constraint ?? return
    if !pkg_is_range_constraint(constraint) -> return
    if pkg_satisfies_constraint(COMPILER_VERSION, constraint) -> return
    return Err(ManifestError{diagnostic: diagnostic_from_registry("E1208", None,
        "this project requires Jet `{constraint}` but this is Jet {COMPILER_VERSION}",
        "the top-level `jet` field specifies a minimum toolchain version",
        "update Jet to a newer version, or change the `jet` field in `{PACKAGE_FILE}`")})
}

fn pkg_is_range_constraint(value: String) -> Bool Never! {
    first :: pkg_bytes_code(value.trim().bytes(), 0)
    first == 62 || first == 60 || first == 61 || first == 94 || first == 126 || first == 42
}

fn pkg_satisfies_constraint(version: String, input: String) -> Bool Never! {
    constraint :: input.trim()
    if constraint == "*" || constraint == "" -> return true
    if constraint.starts_with(">=") -> return pkg_version_ge(version, constraint.removeprefix(">=").trim())
    if constraint.starts_with("^") -> return pkg_version_ge(version, constraint.removeprefix("^").trim())
    version.trim() == constraint
}

fn pkg_version_ge(a: String, b: String) -> Bool Never! {
    left :: pkg_version_triple(a)
    right :: pkg_version_triple(b)
    loop index in 0..<3 {
        if left[index] != right[index] -> return left[index] > right[index]
    }
    true
}

// `major.minor.patch`, each missing or malformed part reading as 0.
fn pkg_version_triple(text: String) -> [Int] Never! {
    parts :: text.trim().split(".").to_list()
    out := [Int]{}
    loop index in 0..<3 {
        if index >= parts.len() {
            &out.push(0)
            next
        }
        piece :: if index == 2 && parts.len() > 3 -> parts[2..<parts.len()].join(".") else -> parts[index]
        &out.push(pkg_parse_u64(piece) ?? 0)
    }
    out
}

// Comment-preserving `jet add`/`jet remove` edits.
pub fn pkg_add_dependency(raw: String, name: String, spec: DepSpec) -> String Never! {
    pkg_add_dep(raw, name, spec)
}

pub fn pkg_remove_dependency(raw: String, name: String) -> String Never! {
    pkg_remove_dep(raw, name)
}

