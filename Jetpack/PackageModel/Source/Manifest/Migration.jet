// The canonical Package/Config formatter (Package/mod.rs).

// Why a Package/Config source cannot be formatted (Rust `String` errors).
#Error
PackageFormatError: struct {
    message: String
}

// Format one canonical Package or Config source file after validating it
// with the same model that loads it.
// Files with comments fail closed.
pkg_format_source: fn(text: String, origin: String) -> String PackageFormatError! {
    stripped: pkg_strip_comments(text)
    trimmed: stripped.trim()
    if trimmed == "" -> return Err(PackageFormatError{message: "Package or Config source is empty"})
    if stripped != text -> return Err(PackageFormatError{message: "Package or Config formatter cannot safely rewrite comments in `{origin}`"})
    is_config: if pkg_config_wrapper(trimmed) == {
        .Ok(wrapper) -> wrapper != None || trimmed.starts_with("Config")
        .Err(error) -> {
            return Err(PackageFormatError{message: error.message()})
        }
    }
    if is_config {
        if ConfigFacts.parse(text, origin) == .Err(error) -> return Err(PackageFormatError{message: error.message()})
    } else {
        if PackageFacts.parse(text, origin) == .Err(error) -> return Err(PackageFormatError{message: error.message()})
    }
    entries: pkg_top_level_entries(text)
    if entries.len() == 0 -> return Err(PackageFormatError{message: "Package or Config source has no fields"})
    separator: if pkg_package_top_level_comma(text) != None -> ",\n" else -> "\n"
    // A blank line between two top-level fields stays (one at most): it
    // groups the manifest the way its author wrote it (`deps: {}` apart).
    body := ""
    cursor := 0
    loop (index, entry) in entries {
        found: pkg_binder_tail(text, cursor).find(entry)
        start: if found < 0 -> cursor else -> cursor + found
        if index > 0 {
            body = "{body}{separator}"
            if pkg_format_newlines(pkg_binder_slice(text, cursor, start)) > 1 -> body = "{body}\n"
        }
        body = "{body}{pkg_format_package_entry(entry, 0)}"
        if found >= 0 -> cursor = start + entry.bytes().len()
    }
    if pkg_package_has_trailing_top_level_comma(text) -> body = "{body},"
    Ok("{body}\n")
}

pkg_format_newlines: fn(gap: String) -> Int Never! {
    count := 0
    loop byte in gap.bytes() {
        if byte == (U8{10}) -> count += 1
    }
    count
}

pkg_trim_entry_terminators: fn(value: String) -> String Never! {
    pkg_binder_trim_end_matches(pkg_binder_trim_end_matches(value.trim(), ","), ";").trim()
}

pkg_format_package_entry: fn(input: String, indent: Int) -> String Never! {
    entry: pkg_trim_entry_terminators(input)
    binding: pkg_split_package_binding(entry) ?? return pkg_format_package_value(entry, indent)
    left: pkg_binder_words(binding.left).join(" ")
    "{left}: {pkg_format_package_value(binding.right, indent)}"
}

pkg_format_package_value: fn(input: String, indent: Int) -> String Never! {
    value: pkg_trim_entry_terminators(input)
    bounds: pkg_package_record_bounds(value) ?? return value
    prefix: pkg_binder_slice(value, 0, bounds.start).trim_end()
    suffix: pkg_binder_tail(value, bounds.end + 1).trim()
    inner: pkg_binder_slice(value, bounds.start + 1, bounds.end)
    entries: pkg_top_level_entries(inner)
    if entries.len() == 0 -> return "{prefix}{{}}{suffix}"
    lines := [String]{}
    loop entry in entries -> &lines.push("{" ".repeat(indent + 4)}{pkg_format_package_entry(entry, indent + 4)}")
    separator: if pkg_package_top_level_comma(inner) != None -> ",\n" else -> "\n"
    body := lines.join(separator)
    if pkg_package_has_trailing_top_level_comma(inner) -> body = "{body},"
    "{prefix}{{\n{body}\n{" ".repeat(indent)}}}{suffix}"
}

pkg_package_has_trailing_top_level_comma: fn(value: String) -> Bool Never! {
    comma: pkg_package_top_level_comma(value) ?? return false
    pkg_binder_tail(value, comma + 1).trim() == ""
}

// The byte offset of the last top-level comma.
pkg_package_top_level_comma: fn(value: String) -> Int? Never! {
    raw: value.bytes()
    depth := 0
    quoted := false
    escaped := false
    comma := Int?{None}
    loop index in 0..<raw.len() {
        code: Int.from_u8(raw[index])
        if quoted {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
                else -> {}
            }
            next
        }
        if code == {
            34 -> quoted = true
            123 | 91 | 40 -> depth += 1
            125 | 93 | 41 -> depth -= 1
            44 -> {
                if depth == 0 -> comma = Val(index)
            }
            else -> {}
        }
    }
    comma
}

// The outermost `{ … }` of a value that ends at its closing brace.
pkg_package_record_bounds: fn(value: String) -> EditSpan? Never! {
    raw: value.bytes()
    open := -1
    depth := 0
    quoted := false
    escaped := false
    loop index in 0..<raw.len() {
        code: Int.from_u8(raw[index])
        if quoted {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == 34 -> quoted = false
                else -> {}
            }
            next
        }
        if code == 34 {
            quoted = true
        } else if code == 123 {
            if open < 0 -> open = index
            depth += 1
        } else if code == 125 {
            depth -= 1
            if depth == 0 {
                if open < 0 -> return None
                if pkg_bytes_text(raw, index + 1, raw.len()).trim() == "" -> return Val(EditSpan{start: open, end: index})
                return None
            }
        }
    }
    None
}
