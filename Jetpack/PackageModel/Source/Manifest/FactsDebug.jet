// Byte-exact renderings of the Rust `{:?}` (derived `Debug`) spelling of the
// Package facts. `PackageFacts::semantic_digest` hashes this text, and
// conflict diagnostics quote it, so it must match the Rust output exactly:
// structs `Name { field: value }`, tuple variants `V(x)`, maps `{"k": v}`,
// sets `{"a"}`, lists `[a, b]`, and options `Some(x)`/`None`.

pub fn pkg_debug_str(value: String) -> String Never! {
    pkg_cbind_debug_quote(value)
}

pub fn pkg_debug_opt_str(value: String?) -> String Never! {
    if value == {
        .Val(text) -> "Some({pkg_debug_str(text)})"
        .None -> "None"
    }
}

pub fn pkg_debug_bool(value: Bool) -> String Never! {
    if value -> "true" else -> "false"
}

pub fn pkg_debug_opt_bool(value: Bool?) -> String Never! {
    if value == {
        .Val(flag) -> "Some({pkg_debug_bool(flag)})"
        .None -> "None"
    }
}

pub fn pkg_debug_str_list(values: [String]) -> String Never! {
    parts := [String]{}
    loop value in values -> &parts.push(pkg_debug_str(value))
    "[{parts.join(", ")}]"
}

pub fn pkg_debug_opt_str_list(values: [String]?) -> String Never! {
    if values == {
        .Val(list) -> "Some({pkg_debug_str_list(list)})"
        .None -> "None"
    }
}

// A sorted string set (`BTreeSet<String>`).
pub fn pkg_debug_str_set(values: [String]) -> String Never! {
    parts := [String]{}
    loop value in pkg_manifest_sorted(values) -> &parts.push(pkg_debug_str(value))
    "{{{parts.join(", ")}}}"
}

pub fn pkg_debug_str_map(map: [String: String]) -> String Never! {
    parts := [String]{}
    loop key in pkg_manifest_sorted(map.keys().to_list()) -> &parts.push("{pkg_debug_str(key)}: {pkg_debug_str(map[key])}")
    "{{{parts.join(", ")}}}"
}

fn pkg_debug_ref_source(source: RefSource) -> String Never! {
    if source == {
        .Jetpack -> "Jetpack"
        .Nixpkgs -> "Nixpkgs"
        .Github -> "Github"
        .Path -> "Path"
        .Cran -> "Cran"
        .LuaRocks -> "LuaRocks"
        .RubyGems -> "RubyGems"
        .Cpan -> "Cpan"
        .Packagist -> "Packagist"
        .JetRegistry -> "JetRegistry"
        .Npm -> "Npm"
        .Cargo -> "Cargo"
        .PyPI -> "PyPI"
        .SwiftPM -> "SwiftPM"
        .Releases -> "Releases"
        .Named(name) -> "Named({pkg_debug_str(name)})"
    }
}

pub fn pkg_debug_git_selector(selector: GitSelector) -> String Never! {
    if selector == {
        .Tag(value) -> "Tag({pkg_debug_str(value)})"
        .Branch(value) -> "Branch({pkg_debug_str(value)})"
        .Rev(value) -> "Rev({pkg_debug_str(value)})"
    }
}

pub fn pkg_debug_dep_source(source: DepSource) -> String Never! {
    if source == {
        .Version(value) -> "Version({pkg_debug_str(value)})"
        .Provider(provider, target) -> "Provider {{ provider: {pkg_debug_ref_source(provider)}, target: {pkg_debug_str(target)} }}"
        .Git(url, selector) -> "Git {{ url: {pkg_debug_str(url)}, selector: {pkg_debug_git_selector(selector)} }}"
        .CLib(target) -> "CLib {{ target: {pkg_debug_str(target)} }}"
        .Foreign(language, reference) -> "Foreign {{ language: {language.debug_name()}, reference: {pkg_debug_str(reference)} }}"
    }
}

pub fn pkg_debug_deps(deps: [String: DepSource]) -> String Never! {
    parts := [String]{}
    loop key in pkg_manifest_sorted(deps.keys().to_list()) -> &parts.push("{pkg_debug_str(key)}: {pkg_debug_dep_source(deps[key])}")
    "{{{parts.join(", ")}}}"
}

fn pkg_debug_target_identity(identity: TargetProfileIdentity) -> String Never! {
    if identity == {
        .WebBrowser -> "WebBrowser"
        .WebWasiServer -> "WebWasiServer"
        .WebNoOs -> "WebNoOs"
        .Named(value) -> "Named({pkg_debug_str(value)})"
    }
}

fn pkg_debug_targets(targets: PackageTargets) -> String Never! {
    parts := [String]{}
    loop selection in targets.iter() -> &parts.push("{pkg_debug_str(selection.name)}: TargetProfileSelection {{ name: {pkg_debug_str(selection.name)}, profile: {pkg_debug_target_identity(selection.profile)} }}")
    "PackageTargets {{ selections: {{{parts.join(", ")}}} }}"
}

fn pkg_debug_dev(dev: DevPolicy) -> String Never! {
    capture :: if dev.records.capture == {
        .Default -> "Default"
        .On -> "On"
        .Off -> "Off"
    }
    "DevPolicy {{ swap: {pkg_debug_bool(dev.swap)}, records: DevRecordsPolicy {{ capture: {capture}, budget: DevRecordsBudget {{ max_bytes: {dev.records.budget.max_bytes} }} }} }}"
}

fn pkg_debug_boundaries(boundaries: [ImportBoundary]) -> String Never! {
    parts := [String]{}
    loop boundary in boundaries -> &parts.push("ImportBoundary {{ from: {pkg_debug_str(boundary.from)}, to: {pkg_debug_str(boundary.to)} }}")
    "[{parts.join(", ")}]"
}

pub fn pkg_debug_service(service: ServiceFact) -> String Never! {
    ports := [String]{}
    loop port in service.ports -> &ports.push("{port}")
    "ServiceFact {{ enable: {pkg_debug_bool(service.enable)}, ports: [{ports.join(", ")}], ready: {pkg_debug_opt_str(service.ready)}, fields: {pkg_debug_str_map(service.fields)} }}"
}

pub fn pkg_debug_services(services: [String: ServiceFact]) -> String Never! {
    parts := [String]{}
    loop key in pkg_manifest_sorted(services.keys().to_list()) -> &parts.push("{pkg_debug_str(key)}: {pkg_debug_service(services[key])}")
    "{{{parts.join(", ")}}}"
}

pub fn pkg_debug_payload(payload: OutputPayload) -> String Never! {
    if payload == {
        .Null -> "Null"
        .Bool(flag) -> "Bool({pkg_debug_bool(flag)})"
        .Number(text) -> "Number({pkg_debug_str(text)})"
        .String(text) -> "String({pkg_debug_str(text)})"
        .Array(values) -> {
            parts := [String]{}
            loop value in values -> &parts.push(pkg_debug_payload(value))
            "Array([{parts.join(", ")}])"
        }
        .Object(fields) -> {
            parts := [String]{}
            loop key in pkg_manifest_sorted(fields.keys().to_list()) -> &parts.push("{pkg_debug_str(key)}: {pkg_debug_payload(fields[key])}")
            "Object({{{parts.join(", ")}}})"
        }
    }
}

pub fn pkg_debug_output(output: OutputFact) -> String Never! {
    "OutputFact {{ kind: {output.kind.debug_name()}, name: {pkg_debug_str(output.name)}, entry: {pkg_debug_opt_str(output.entry)}, fields: {pkg_debug_str_map(output.fields)}, payload: {pkg_debug_payload(output.payload)} }}"
}

pub fn pkg_debug_outputs(outputs: [String: OutputFact]) -> String Never! {
    parts := [String]{}
    loop key in pkg_manifest_sorted(outputs.keys().to_list()) -> &parts.push("{pkg_debug_str(key)}: {pkg_debug_output(outputs[key])}")
    "{{{parts.join(", ")}}}"
}

pub fn pkg_debug_environments(environments: [String: EnvironmentFact]) -> String Never! {
    parts := [String]{}
    loop key in pkg_manifest_sorted(environments.keys().to_list()) {
        environment :: environments[key]
        &parts.push("{pkg_debug_str(key)}: EnvironmentFact {{ name: {pkg_debug_str(environment.name)}, tools: {pkg_debug_str_list(environment.tools)}, services: {pkg_debug_services(environment.services)}, secrets: {pkg_debug_str_map(environment.secrets)}, fields: {pkg_debug_str_map(environment.fields)} }}")
    }
    "{{{parts.join(", ")}}}"
}

fn pkg_debug_build_profiles(profiles: [BuildProfileDef]) -> String Never! {
    parts := [String]{}
    loop profile in profiles {
        optimize :: if profile.optimize == {
            .Off -> "None"
            .Basic -> "Basic"
            .Full -> "Full"
        }
        panic := "None"
        if profile.panic == .Val(mode) {
            panic = if mode == {
                .Unwind -> "Some(Unwind)"
                .Abort -> "Some(Abort)"
            }
        }
        inspect :: if profile.inspect == {
            .Local -> "Local"
            .ReadOnly -> "ReadOnly"
            .Disabled -> "None"
        }
        &parts.push("BuildProfileDef {{ name: {pkg_debug_str(profile.name)}, optimize: {optimize}, debug_info: {pkg_debug_bool(profile.debug_info)}, small: {pkg_debug_bool(profile.small)}, panic: {panic}, settings: {pkg_debug_str_map(profile.settings)}, inspect: {inspect}, game_development_stripping: {pkg_debug_opt_bool(profile.game_development_stripping)}, game_cook_mode: {pkg_debug_opt_str(profile.game_cook_mode)} }}")
    }
    "[{parts.join(", ")}]"
}

fn pkg_debug_settings(settings: [String: SettingDecl]) -> String Never! {
    parts := [String]{}
    loop key in pkg_manifest_sorted(settings.keys().to_list()) {
        setting :: settings[key]
        &parts.push("{pkg_debug_str(key)}: SettingDecl {{ ty: {pkg_debug_str(setting.ty)}, default: {pkg_debug_str(setting.default)} }}")
    }
    "{{{parts.join(", ")}}}"
}

fn pkg_debug_members(members: [MemberRef]) -> String Never! {
    parts := [String]{}
    loop member in members {
        &parts.push(if member == {
            .Path(path) -> "Path({pkg_debug_str(path)})"
            .Find(path) -> "Find({pkg_debug_str(path)})"
        })
    }
    "[{parts.join(", ")}]"
}

fn pkg_debug_trust_decision(decision: TrustDecision) -> String Never! {
    if decision == {
        .Allow -> "Allow"
        .Prompt -> "Prompt"
        .Deny -> "Deny"
    }
}

fn pkg_debug_opt_trust_decision(decision: TrustDecision?) -> String Never! {
    if decision == {
        .Val(value) -> "Some({pkg_debug_trust_decision(value)})"
        .None -> "None"
    }
}

pub fn pkg_debug_grants(grants: [PackageGrant]) -> String Never! {
    parts := [String]{}
    loop grant in grants -> &parts.push("({pkg_debug_str(grant.package)}, {pkg_debug_str_list(grant.rights)})")
    "[{parts.join(", ")}]"
}

fn pkg_debug_authority(authority: PackageAuthority) -> String Never! {
    trust :: if authority.trust == {
        .Val(policy) -> {
            services := [String]{}
            loop service in policy.services -> &services.push("({pkg_debug_str(service.service)}, {pkg_debug_trust_decision(service.decision)})")
            require := "None"
            if policy.require == .Val(floor) {
                require = if floor == {
                    .Unrequired -> "Some(None)"
                    .Logged -> "Some(Logged)"
                    .Attested -> "Some(Attested)"
                }
            }
            "Some(TrustPolicy {{ default: {pkg_debug_opt_trust_decision(policy.default)}, ci_prompt: {pkg_debug_opt_trust_decision(policy.ci_prompt)}, services: [{services.join(", ")}], require: {require} }})"
        }
        .None -> "None"
    }
    providers := [String]{}
    loop provider in authority.providers -> &providers.push("ProviderAuthority {{ provider: {pkg_debug_str(provider.provider)}, registry: {pkg_debug_str(provider.registry)}, allow: {pkg_debug_str_list(provider.allow)}, deny: {pkg_debug_str_list(provider.deny)} }}")
    "PackageAuthority {{ holds: AuthorityHolds {{ allow: {pkg_debug_opt_str_list(authority.holds.allow)}, deny: {pkg_debug_opt_str_list(authority.holds.deny)} }}, needs: {pkg_debug_str_list(authority.needs)}, grants: {pkg_debug_grants(authority.grants)}, trust: {trust}, providers: [{providers.join(", ")}] }}"
}

fn pkg_debug_policy_effects(effects: [String: [String]]) -> String Never! {
    parts := [String]{}
    loop key in pkg_manifest_sorted(effects.keys().to_list()) -> &parts.push("{pkg_debug_str(key)}: {pkg_debug_str_set(effects[key])}")
    "{{{parts.join(", ")}}}"
}

fn pkg_debug_claims(grade: ClaimsGrade?) -> String Never! {
    if grade == {
        .Val(value) -> "Some({value.debug()})"
        .None -> "None"
    }
}

fn pkg_debug_source_maps(maps: [PolicySourceMap]) -> String Never! {
    parts := [String]{}
    loop map in maps -> &parts.push("({pkg_debug_str(map.pattern)}, {pkg_debug_str_list(map.sources)})")
    "[{parts.join(", ")}]"
}

fn pkg_debug_exceptions(exceptions: [PackagePolicyException]) -> String Never! {
    parts := [String]{}
    loop exception in exceptions -> &parts.push("PackagePolicyException {{ id: {pkg_debug_str(exception.id)}, scope: {pkg_debug_str(exception.scope)}, reason: {pkg_debug_str(exception.reason)}, expires_at: {exception.expires_at} }}")
    "[{parts.join(", ")}]"
}

// The exact preimage of `PackageFacts::semantic_digest`.
pub fn pkg_facts_semantic_text(facts: PackageFacts) -> String Never! {
    policy :: facts.policy
    lines := [String]{
        "name={pkg_debug_str(facts.name)};version={pkg_debug_opt_str(facts.version)};jet={pkg_debug_opt_str(facts.jet)};source={pkg_debug_opt_str(facts.source)};",
        "targets={pkg_debug_targets(facts.targets)};dev={pkg_debug_dev(facts.dev)};deps={pkg_debug_deps(facts.deps)};boundaries={pkg_debug_boundaries(facts.boundaries)};",
        "services={pkg_debug_services(facts.services)};outputs={pkg_debug_outputs(facts.outputs)};environments={pkg_debug_environments(facts.environments)};defaults={pkg_debug_str_map(facts.defaults)};",
        "build_profiles={pkg_debug_build_profiles(facts.build_profiles)};settings={pkg_debug_settings(facts.settings)};configs={pkg_debug_str_list(facts.configs)};members={pkg_debug_members(facts.members)};",
        "authority={pkg_debug_authority(facts.authority)};effects_enabled={pkg_debug_bool(facts.effects_enabled)};effects_allow={pkg_debug_opt_str_list(facts.effects_allow)};effects_deny={pkg_debug_opt_str_list(facts.effects_deny)};",
        "policy_lints_deny={pkg_debug_opt_str_list(policy.lints_deny)};policy_effects={pkg_debug_policy_effects(policy.effects)};policy_unsafe_paths={pkg_debug_opt_str_list(policy.unsafe_paths)};policy_expert={pkg_debug_opt_bool(policy.expert)};",
        "policy_deps={pkg_debug_opt_str_list(policy.deps)};policy_claims_min={pkg_debug_claims(policy.claims_min)};policy_contain={pkg_debug_str_set(policy.contain)};policy_harden={pkg_debug_bool(policy.harden)};",
        "policy_licenses={pkg_debug_opt_str_list(policy.licenses)};policy_source_maps={pkg_debug_source_maps(policy.source_maps)};policy_exceptions={pkg_debug_exceptions(policy.exceptions)};",
    }
    loop name in pkg_manifest_sorted(facts.inline_configs.keys().to_list()) {
        config :: facts.inline_configs[name]
        &lines.push("inline_config={pkg_debug_str(name)};name={pkg_debug_opt_str(config.name)};version={pkg_debug_opt_str(config.version)};source={pkg_debug_opt_str(config.source)};deps={pkg_debug_deps(config.deps)};services={pkg_debug_services(config.services)};outputs={pkg_debug_outputs(config.outputs)};environments={pkg_debug_environments(config.environments)};defaults={pkg_debug_str_map(config.defaults)};")
    }
    lines.join("")
}
