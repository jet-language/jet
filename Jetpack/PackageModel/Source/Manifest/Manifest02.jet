//RS //! `package.jet` package-manifest loading (M12.1, S52, U1/U10, D-JPK23).
//RS //!
//RS //! The on-disk format is Jet syntax, not TOML — `src/jetpack/packmanifest.rs`
//RS //! is the structural parser for `package.jet`'s bare identity and typed
//RS //! `deps:`/`outputs:` shape; this module owns the compiler-facing `Manifest` type that
//RS //! `loader.rs`/`fetch.rs`/`lock.rs`/`store.rs` operate on, the toolchain
//RS //! check (E1208), and the comment-preserving `jet add`/`jet remove` edits.
//RS //! `package.jet` replaces the old TOML `jet.toml` as a clean break (U1/U10) —
//RS //! no back-compat alias.
//RS 
//RS use crate::Authority::AuthorityResolver;
//RS use crate::Diagnostics::Diagnostic;
//RS use crate::Package::{self, PackageParseError};
//RS use crate::Syntax;
//RS use std::collections::BTreeMap;
//RS use std::path::Path;
