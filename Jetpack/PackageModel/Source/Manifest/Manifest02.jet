//RS /// The editions this toolchain understands (D-REL3). An edition opts a project
//RS /// into a specific era of Jet syntax (Docs/spec/release-policy.md). The list is
//RS /// ordered oldest→newest; the last entry is the newest stable edition, used by
//RS /// single-file `jet run file.jet` which carries no edition marker (E2-V4).
//RS const LATEST_EDITION: &str = "2028";
//RS pub const SUPPORTED_EDITIONS: &[&str] = &["2026", "2027", "2028"];
//RS 
//RS /// Parse an edition label like `"2027"` into its year. Unknown labels sort before
//RS /// every supported edition so comparisons fail closed.
//RS pub fn edition_year(edition: &str) -> u16 {
//RS     edition.trim().parse().unwrap_or(0)
//RS }
//RS 
//RS /// `true` when `edition` is at least as new as `baseline` under numeric ordering.
//RS pub fn edition_at_least(edition: &str, baseline: &str) -> bool {
//RS     edition_year(edition) >= edition_year(baseline)
//RS }
