// Package facts over the checked authority snapshot (Package/mod.rs): the
// one Package root load, Config composition from files, runnable/build/
// command entry resolution, member validation, and the retired-entry
// migration. Every file read goes through `AuthorityResolver` and is
// revalidated before and after use.

// A resolver failure seen through the Package parse carrier.
fn pkg_authority_package_error(error: AuthorityError) -> PackageParseError Never! {
    if error == {
        .NestedMembers(root, member) -> PackageParseError.NestedMembers{root: root, member: member}
        else -> PackageParseError.Composition(error.message())
    }
}

// `origin: error`, or the bare error when there is no origin.
fn pkg_format_entry_error(origin: String, error: String) -> String Never! {
    if origin == "" -> return error
    "{origin}: {error}"
}

// Why an entry-resolution command failed (Rust `String` errors).
#Error
pub struct PackageEntryError {
    pub message: String
}

fn pkg_entry_error(origin: String, detail: String) -> PackageEntryError Never! {
    PackageEntryError{message: "{origin}: {detail}"}
}

impl PackageFacts {
    // Load the one canonical Package root with its Configs composed; None
    // when no root exists. A retired manifest beside it is an error.
    fn load(dir: String) -[FS, Env]> PackageFacts? PackageParseError! {
        resolver :: if AuthorityResolver.open(dir) == {
            .Ok(opened) -> opened
            .Err(error) -> {
                if error.is_missing() -> return Ok(None)
                return Err(pkg_authority_package_error(error))
            }
        }
        checked :: if resolver.checked_manifest(".") == {
            .Ok(found) -> found
            .Err(error) -> {
                if error.is_missing() -> return Ok(None)
                return Err(pkg_authority_package_error(error))
            }
        }
        if resolver.revalidate_file(checked.file) == .Err(error) -> return Err(pkg_authority_package_error(error))
        facts := checked.facts
        result :: pkg_load_compose_and_validate(&facts, resolver)
        if resolver.revalidate_file(checked.file) == .Err(error) -> return Err(pkg_authority_package_error(error))
        if result == .Err(error) -> return Err(error)
        Ok(Val(facts))
    }

    // Load one complete Package preserving authority failures; only a
    // missing root is absent.
    fn load_checked(dir: String) -[FS, Env]> PackageFacts? AuthorityError! {
        resolver :: if AuthorityResolver.open(dir) == {
            .Ok(opened) -> opened
            .Err(error) -> {
                if error.is_missing() -> return Ok(None)
                return Err(error)
            }
        }
        if resolver.checked_package(".") == {
            .Ok(package) -> Ok(Val(package.facts))
            .Err(error) -> {
                if error.is_missing() -> return Ok(None)
                Err(error)
            }
        }
    }

    // Load and merge the root's declared Config files.
    fn compose_configs(&self, dir: String) PackageParseError! -[FS, Env]> {
        resolver :: if AuthorityResolver.open(dir) == {
            .Ok(opened) -> opened
            .Err(error) -> {
                return Err(pkg_authority_package_error(error))
            }
        }
        self.compose_configs_checked(resolver)
    }

    // Resolve every declared Config before changing any fact; a failure
    // leaves the facts (and `resolved_config_paths`) untouched.
    fn compose_configs_checked(&self, resolver: AuthorityResolver) PackageParseError! -[FS, Env]> {
        parsed := [ConfigFacts]{}
        resolved_config_paths := self.resolved_config_paths
        loop relative in self.configs {
            if self.inline_configs.has_key(relative) -> next
            if relative.starts_with("/") || pkg_path_has_parent_component(relative) -> return Err(PackageParseError.InvalidValue{field: "configs", value: relative})
            checked :: pkg_checked_config_file(resolver, relative)
            relative_path :: checked.relative.replace("\\", "/")
            if !resolved_config_paths.contains(relative_path) -> &resolved_config_paths.push(relative_path)
            text :: if checked.text() == {
                .Ok(read) -> read
                .Err(error) -> {
                    return Err(pkg_authority_package_error(error))
                }
            }
            if resolver.revalidate_file(checked) == .Err(error) -> return Err(pkg_authority_package_error(error))
            config :: ConfigFacts.parse(text, checked.path)
            if resolver.revalidate_file(checked) == .Err(error) -> return Err(pkg_authority_package_error(error))
            &parsed.push(config)
        }
        if self.compose(parsed) == .Err(error) -> return Err(PackageParseError.Composition(error.message()))
        self.resolved_config_paths = resolved_config_paths
    }

    // Validate member paths against the physical Package root.
    fn validate_members_in(self, dir: String) PackageParseError! -[FS, Env]> {
        self.member_names_in(dir)
    }

    fn validate_members_in_checked(self, resolver: AuthorityResolver) PackageParseError! -[FS, Env]> {
        self.member_names_in_checked(resolver)
    }

    // Resolve the flat member references from the same checked authority
    // used by `load`.
    fn checked_members_in(self, resolver: AuthorityResolver) -[FS, Env]> [CheckedPackage] AuthorityError! {
        if self.validate_members() == .Err(error) -> return Err(AuthorityError.Invalid{path: self.origin, detail: error.message()})
        physical := [String]{}
        names := [String]{}
        packages := [CheckedPackage]{}
        loop member in self.members {
            relative :: member.path()
            candidates :: if member == {
                .Find(_) -> resolver.discover_members(relative)
                .Path(_) -> [CheckedMember]{resolver.checked_member(relative)}
            }
            loop candidate in candidates {
                if candidate.manifest.facts.members.len() > 0 -> return Err(AuthorityError.NestedMembers{root: self.origin, member: candidate.manifest.file.path})
                package :: resolver.complete_checked_package(candidate)
                canonical :: resolver.relative_identity(package.member.directory)
                manifest_path :: package.member.manifest.file.path
                if canonical == "." -> return Err(AuthorityError.Invalid{path: manifest_path, detail: "member reference `{relative}` resolves to its Package root"})
                if physical.contains(canonical) -> return Err(AuthorityError.Invalid{path: manifest_path, detail: "member reference `{relative}` has the same physical identity as another member"})
                if names.contains(package.facts.name) -> return Err(AuthorityError.Invalid{path: manifest_path, detail: "member Package name `{package.facts.name}` is declared more than once"})
                &physical.push(canonical)
                &names.push(package.facts.name)
                &packages.push(package)
            }
        }
        resolver.revalidate_root()
        Ok(packages)
    }

    // The canonical member names discovered in the physical Package root.
    fn member_names_in(self, dir: String) -[FS, Env]> [String] PackageParseError! {
        resolver :: if AuthorityResolver.open(dir) == {
            .Ok(opened) -> opened
            .Err(error) -> {
                return Err(pkg_authority_package_error(error))
            }
        }
        self.member_names_in_checked(resolver)
    }

    fn member_names_in_checked(self, resolver: AuthorityResolver) -[FS, Env]> [String] PackageParseError! {
        if self.checked_members_in(resolver) == {
            .Ok(packages) -> {
                names := [String]{}
                loop package in packages -> &names.push(package.facts.name)
                Ok(names)
            }
            .Err(error) -> Err(pkg_authority_package_error(error))
        }
    }

    // Resolve the stock runnable output's file.
    fn resolve_run_entry(self, root: String) -[FS, Env]> String? PackageEntryError! {
        resolver :: if AuthorityResolver.open(root) == {
            .Ok(opened) -> opened
            .Err(error) -> {
                return Err(pkg_entry_error(self.origin, error.message()))
            }
        }
        entry :: self.resolve_run_entry_checked(resolver) ?? return Ok(None)
        Ok(Val(entry.file.path))
    }

    // The canonical `run.jet` (root, then `src/`) wins; retired `main.jet`
    // is migrated once first and refused afterwards; otherwise the selected
    // runnable output's entry.
    fn resolve_run_entry_checked(self, resolver: AuthorityResolver) -[FS, Env]> CheckedPackageEntry? PackageEntryError! {
        if self.validate_defaults() == .Err(error) -> return Err(pkg_entry_error(self.origin, error.message()))
        if pkg_migrate_retired_entry(resolver.root(), self.origin, self.name) {
            fresh :: if AuthorityResolver.open(resolver.root()) == {
                .Ok(opened) -> opened
                .Err(error) -> {
                    return Err(pkg_entry_error(self.origin, error.message()))
                }
            }
            return self.resolve_run_entry_checked(fresh)
        }
        run_name :: @DEFAULT_ENTRY_FILE.removesuffix(".jet")
        candidates :: [String]{@DEFAULT_ENTRY_FILE, "src/{@DEFAULT_ENTRY_FILE}"}
        loop relative in candidates {
            if resolver.checked_file(relative) == {
                .Ok(file) -> {
                    if resolver.revalidate_file(file) == .Err(error) -> return Err(pkg_entry_error(self.origin, error.message()))
                    return Ok(Val(CheckedPackageEntry{file: file, callable: run_name}))
                }
                .Err(error) -> {
                    if !error.is_missing() -> return Err(pkg_entry_error(self.origin, error.message()))
                }
            }
        }
        if resolver.checked_file(@LEGACY_ENTRY_FILE) == {
            .Ok(main) -> {
                if resolver.revalidate_file(main) == .Err(error) -> return Err(pkg_entry_error(self.origin, error.message()))
                return Err(pkg_entry_error(self.origin, "package entry requires canonical `{@DEFAULT_ENTRY_FILE}`; retired `{pkg_path_file_name(main.path)}` is not accepted"))
            }
            .Err(error) -> {
                if !error.is_missing() -> return Err(pkg_entry_error(self.origin, error.message()))
            }
        }
        runnable := false
        loop name in self.outputs.keys().to_list() {
            if pkg_intent_accepts_kind("run", self.outputs[name].kind) -> runnable = true
        }
        if !runnable -> return Ok(None)
        output :: if self.select_output("run", None, None) == {
            .Ok(selected) -> selected
            .Err(error) -> {
                return Err(pkg_entry_error(self.origin, error.message()))
            }
        }
        entry :: if self.entry_file_checked(resolver, output) == {
            .Ok(found) -> found
            .Err(error) -> {
                return Err(pkg_entry_error(self.origin, error.message()))
            }
        }
        found :: entry ?? return Err(pkg_entry_error(self.origin, "typed output `{output.name}` has no unique source entry for `{output.entry ?? "<missing>"}`"))
        Ok(Val(found))
    }

    // The package's optional `fn build` from the checked source tree.
    fn resolve_build_entry(self, root: String) -[FS, Env]> String? PackageEntryError! {
        resolver :: if AuthorityResolver.open(root) == {
            .Ok(opened) -> opened
            .Err(error) -> {
                return Err(pkg_entry_error(self.origin, error.message()))
            }
        }
        file :: self.resolve_build_entry_checked(resolver) ?? return Ok(None)
        Ok(Val(file.path))
    }

    // The one package-wide build selection seam: an unimported source file
    // or the manifest, never an imported module's hook.
    fn resolve_build_entry_checked(self, resolver: AuthorityResolver) -[FS, Env]> CheckedFile? PackageEntryError! {
        if self.validate_defaults() == .Err(error) -> return Err(pkg_entry_error(self.origin, error.message()))
        listed :: if self.source_files_checked(resolver) == {
            .Ok(found) -> found
            .Err(error) -> {
                return Err(pkg_entry_error(self.origin, error.message()))
            }
        }
        candidates := [CheckedFile]{}
        loop file in listed {
            is_role_file :: @COMMAND_ROLE_FILES.contains(pkg_path_file_name(file.relative))
            parent :: pkg_path_parent(file.relative)
            if !is_role_file || parent == "" || parent == "." -> &candidates.push(file)
        }
        entries :: if self.discover_function_entries_from_files(resolver, candidates, @BUILD_ENTRY_FN, true, true) == {
            .Ok(found) -> found
            .Err(error) -> {
                return Err(pkg_entry_error(self.origin, error.message()))
            }
        }
        if entries.len() > 1 {
            locations := [String]{}
            loop entry in entries -> &locations.push("{entry.file.path}:{entry.line}")
            return Err(PackageEntryError{message: "two build entries for the package: {locations.join(" and ")}"})
        }
        if entries.len() == 0 -> return Ok(None)
        Ok(Val(entries[0].file))
    }

    // One optional command-function override (D-CMDOVERRIDE1=A): a matching
    // package-root role home, then one root file, then one `src/` file.
    fn resolve_command_entry(self, root: String, command: String) -[FS, Env]> String? PackageEntryError! {
        resolver :: if AuthorityResolver.open(root) == {
            .Ok(opened) -> opened
            .Err(error) -> {
                return Err(pkg_entry_error(self.origin, error.message()))
            }
        }
        file :: self.resolve_command_entry_checked(resolver, command) ?? return Ok(None)
        Ok(Val(file.path))
    }

    fn resolve_command_entry_checked(self, resolver: AuthorityResolver, command: String) -[FS, Env]> CheckedFile? PackageEntryError! {
        listed :: if self.source_files_checked(resolver) == {
            .Ok(found) -> found
            .Err(error) -> {
                return Err(pkg_entry_error(self.origin, error.message()))
            }
        }
        requested_role :: syntax_command_role_file(command)
        role_files := [CheckedFile]{}
        root_files := [CheckedFile]{}
        src_files := [CheckedFile]{}
        loop file in listed {
            parent :: pkg_path_parent(file.relative)
            name :: pkg_path_file_name(file.relative)
            is_role_file :: @COMMAND_ROLE_FILES.contains(name)
            if parent == "" || parent == "." {
                if requested_role != None && (requested_role ?? "") == name {
                    &role_files.push(file)
                } else if !is_role_file {
                    &root_files.push(file)
                }
            } else if parent == "src" && !is_role_file {
                &src_files.push(file)
            }
        }
        role_entries :: self.command_entries(resolver, role_files, command)
        if role_entries.len() > 0 -> return Ok(Val(role_entries[0].file))
        root_entries :: self.command_entries(resolver, root_files, command)
        entries :: if root_entries.len() == 0 -> self.command_entries(resolver, src_files, command) else -> root_entries
        if entries.len() > 1 {
            locations := [String]{}
            loop entry in entries -> &locations.push("{entry.file.path}:{entry.line}")
            return Err(PackageEntryError{message: "two `{command}` command overrides for the package: {locations.join(" and ")}"})
        }
        if entries.len() == 0 -> return Ok(None)
        Ok(Val(entries[0].file))
    }

    fn command_entries(self, resolver: AuthorityResolver, candidates: [CheckedFile], command: String) -[FS, Env]> [PackageFunctionEntry] PackageEntryError! {
        if self.discover_function_entries_from_files(resolver, candidates, command, false, false) == {
            .Ok(found) -> Ok(found)
            .Err(error) -> Err(pkg_entry_error(self.origin, error.message()))
        }
    }

    // Resolve a runnable Output's reference to a source file.
    fn entry_path(self, root: String, output: OutputFact) -[FS, Env]> String? PackageEntryError! {
        resolver :: if AuthorityResolver.open(root) == {
            .Ok(opened) -> opened
            .Err(error) -> {
                return Err(pkg_entry_error(self.origin, error.message()))
            }
        }
        if self.entry_file_checked(resolver, output) == {
            .Ok(found) -> {
                entry :: found ?? return Ok(None)
                Ok(Val(entry.file.path))
            }
            .Err(error) -> Err(pkg_entry_error(self.origin, error.message()))
        }
    }

    // `run` names the canonical entry file; a bare name names the unique
    // top-level function; `alias.function` follows the import graph.
    fn entry_file_checked(self, resolver: AuthorityResolver, output: OutputFact) -[FS, Env]> CheckedPackageEntry? AuthorityError! {
        entry :: output.entry ?? return Ok(None)
        parts :: entry.split(".").to_list()
        if parts.len() != 1 && parts.len() != 2 -> return Ok(None)
        loop part in parts {
            if !pkg_is_ascii_identifier(part) -> return Ok(None)
        }
        run_name :: @DEFAULT_ENTRY_FILE.removesuffix(".jet")
        if parts.len() == 1 && parts[0] == run_name {
            candidates :: [String]{@DEFAULT_ENTRY_FILE, "src/{@DEFAULT_ENTRY_FILE}"}
            loop relative in candidates {
                if resolver.checked_file(relative) == {
                    .Ok(file) -> {
                        resolver.revalidate_file(file)
                        return Ok(Val(CheckedPackageEntry{file: file, callable: run_name}))
                    }
                    .Err(error) -> {
                        if !error.is_missing() -> return Err(error)
                    }
                }
            }
            return Ok(None)
        }
        if parts.len() == 1 {
            matches :: self.discover_function_entries_checked(resolver, parts[0], false, false)
            if matches.len() != 1 -> return Ok(None)
            return Ok(Val(CheckedPackageEntry{file: matches[0].file, callable: parts[0]}))
        }
        listed :: self.source_files_checked(resolver)
        selected := None
        if pkg_parse_sources(listed) == .Val(sources) {
            targets :: pkg_reachable_import_module_targets(resolver.root(), parts[0], sources)
            if targets.len() == 1 {
                matched := [String]{}
                loop source in sources {
                    if source.path != targets[0] -> next
                    if pkg_unique_top_level_function(source.program, parts[1]) == .Val(function) {
                        if function.is_pub -> &matched.push(source.path)
                    }
                }
                if matched.len() == 1 -> selected = Val(matched[0])
            }
        }
        loop file in listed -> resolver.revalidate_file(file)
        resolver.revalidate_root()
        path :: selected ?? return Ok(None)
        loop file in listed {
            if file.path == path -> return Ok(Val(CheckedPackageEntry{file: file, callable: parts[1]}))
        }
        Ok(None)
    }

    fn discover_function_entries_checked(self, resolver: AuthorityResolver, wanted: String, exclude_imported: Bool, include_manifest: Bool) -[FS, Env]> [PackageFunctionEntry] AuthorityError! {
        listed :: self.source_files_checked(resolver)
        self.discover_function_entries_from_files(resolver, listed, wanted, exclude_imported, include_manifest)
    }

    // Top-level functions from one checked listing; output references and
    // `fn build` share the file set, scanner, and revalidation boundary.
    fn discover_function_entries_from_files(self, resolver: AuthorityResolver, source_files: [CheckedFile], wanted: String, exclude_imported: Bool, include_manifest: Bool) -[FS, Env]> [PackageFunctionEntry] AuthorityError! {
        candidates := source_files
        if include_manifest {
            if resolver.checked_manifest(".") == {
                .Ok(manifest) -> {
                    &candidates.push(manifest.file)
                }
                .Err(error) -> {
                    if !error.is_missing() -> return Err(error)
                }
            }
        }
        imported := [String]{}
        if exclude_imported {
            sources_only := [CheckedFile]{}
            loop file in candidates {
                if pkg_path_file_name(file.relative) != @PACKAGE_FILE -> &sources_only.push(file)
            }
            if pkg_parse_sources(sources_only) == .Val(sources) {
                loop source in sources {
                    loop path in pkg_imported_source_paths(resolver.root(), source, sources) {
                        normalized :: pkg_normalize_discovery_path(path)
                        if !imported.contains(normalized) -> &imported.push(normalized)
                    }
                }
            }
        }
        entries := [PackageFunctionEntry]{}
        loop file in candidates {
            is_manifest :: pkg_path_file_name(file.relative) == @PACKAGE_FILE
            if exclude_imported && !is_manifest && imported.contains(pkg_normalize_discovery_path(file.path)) -> next
            text :: file.text()
            source :: if is_manifest -> pkg_build_entry_source(text) ?? "" else -> text
            structural :: pkg_top_level_function_lines(source, wanted)
            lines :: if wanted == @BUILD_ENTRY_FN -> pkg_real_build_entry_lines(source, structural) ?? structural else -> structural
            loop line in lines -> &entries.push(PackageFunctionEntry{file: file, line: line})
        }
        loop file in candidates -> resolver.revalidate_file(file)
        resolver.revalidate_root()
        Ok(entries)
    }

    // The package's own checked source files: nested packages, reserved
    // metadata files, the root/`src` retired entry, and Config files are
    // excluded; sorted by relative path.
    fn source_files_checked(self, resolver: AuthorityResolver) -[FS, Env]> [CheckedFile] AuthorityError! {
        listed :: resolver.discover_source_files()
        nested_packages := [String]{}
        loop file in listed {
            if pkg_path_file_name(file.relative) != @PACKAGE_FILE -> next
            parent :: pkg_path_parent(file.relative)
            if parent != "" && parent != "." -> &nested_packages.push(parent)
        }
        kept := [CheckedFile]{}
        loop file in listed {
            if pkg_path_under_any(file.relative, nested_packages) -> next
            name :: pkg_path_file_name(file.relative)
            reserved :: name == @PACKAGE_FILE || name == @PAYLOAD_FILE || name == @ENV_FILE || name == @CONFIG_FILE || name == @WORKSPACE_FILE || (name == @LEGACY_ENTRY_FILE && (file.relative == @LEGACY_ENTRY_FILE || file.relative == "src/{@LEGACY_ENTRY_FILE}"))
            if reserved || self.is_config_file(file.relative) -> next
            &kept.push(file)
        }
        Ok(pkg_sorted_checked_files(kept))
    }

    fn is_config_file(self, relative: String) -> Bool Never! {
        names := self.resolved_config_paths
        loop name in self.configs -> &names.push(name)
        loop name in names {
            if relative == name -> return true
            if !pkg_path_file_name(name).contains(".") && relative == "{name}.jet" -> return true
        }
        false
    }
}

// One discovered top-level function: its file and 1-based line.
pub struct PackageFunctionEntry {
    pub file: CheckedFile
    pub line: Int
}

// Whether `relative` lies under any of `directories` (component-wise).
fn pkg_path_under_any(relative: String, directories: [String]) -> Bool Never! {
    loop directory in directories {
        if relative == directory || relative.starts_with("{directory}/") -> return true
    }
    false
}

pub fn pkg_sorted_checked_files(input: [CheckedFile]) -> [CheckedFile] Never! {
    keys := [String]{}
    loop file in input -> &keys.push(file.relative)
    out := [CheckedFile]{}
    loop key in pkg_manifest_sorted(keys) {
        loop file in input {
            if file.relative == key && !out.contains(file) -> &out.push(file)
        }
    }
    out
}

// Open a declared Config: the exact path, then `<name>.jet`, then a unique
// `pub <name> :: Config{…}` declaration found under the root.
fn pkg_checked_config_file(resolver: AuthorityResolver, relative: String) -[FS, Env]> CheckedFile PackageParseError! {
    if resolver.checked_file(relative) == {
        .Ok(file) -> return Ok(file)
        .Err(error) -> {
            if !error.is_missing() -> return Err(pkg_authority_package_error(error))
        }
    }
    if !pkg_path_file_name(relative).contains(".") {
        if resolver.checked_file("{relative}.jet") == {
            .Ok(file) -> return Ok(file)
            .Err(error) -> {
                if !error.is_missing() -> return Err(pkg_authority_package_error(error))
            }
        }
    }
    pkg_discover_config_path(resolver, relative)
}

fn pkg_discover_config_path(resolver: AuthorityResolver, name: String) -[FS, Env]> CheckedFile PackageParseError! {
    listed :: if resolver.discover_files(".", Val(@FILE_EXT)) == {
        .Ok(found) -> found
        .Err(error) -> {
            return Err(pkg_authority_package_error(error))
        }
    }
    matches := [CheckedFile]{}
    loop file in listed {
        if pkg_path_file_name(file.relative).starts_with("_") -> next
        text :: if file.text() == {
            .Ok(read) -> read
            .Err(error) -> {
                return Err(pkg_authority_package_error(error))
            }
        }
        if ConfigFacts.parse(text, file.path) == {
            .Ok(facts) -> {
                if facts.name != None && (facts.name ?? "") == name -> &matches.push(file)
            }
            .Err(error) -> {
                if text.contains("Config") -> return Err(error)
            }
        }
    }
    sorted :: pkg_sorted_checked_files(matches)
    if sorted.len() == {
        1 -> Ok(sorted[0])
        0 -> Err(PackageParseError.Composition("Config `{name}` was not found under `{resolver.root()}`"))
        else -> Err(PackageParseError.Composition("Config `{name}` is ambiguous under `{resolver.root()}`"))
    }
}

// Compose Configs, then guarantees, defaults, and members (the `load` path).
fn pkg_load_compose_and_validate(facts: &PackageFacts, resolver: AuthorityResolver) PackageParseError! -[FS, Env]> {
    facts.compose_configs_checked(resolver)
    facts.validate_guarantees()
    if facts.validate_defaults() == .Err(error) -> return Err(PackageParseError.Composition(error.message()))
    facts.validate_members_in_checked(resolver)
}

// D-ONCE-RETIRE1=C / D-VERDICT-678-1: migrate one retired entry (`main.jet`,
// `src/main.jet`, `.jet/main.jet`) to its canonical `run.jet` home before a
// default run resolves its authority snapshot. True when a file moved.
fn pkg_migrate_retired_entry(root: String, origin: String, package_name: String) -[FS, Env]> Bool PackageEntryError! {
    resolver :: if AuthorityResolver.open(root) == {
        .Ok(opened) -> opened
        .Err(error) -> {
            return Err(PackageEntryError{message: pkg_format_entry_error(origin, error.message())})
        }
    }
    olds :: [String]{@LEGACY_ENTRY_FILE, "src/{@LEGACY_ENTRY_FILE}", "{@SOURCE_ROOT_DIR}/{@LEGACY_ENTRY_FILE}"}
    news :: [String]{@DEFAULT_ENTRY_FILE, "src/{@DEFAULT_ENTRY_FILE}", @DEFAULT_ENTRY_FILE}
    canonical_paths := [String]{@DEFAULT_ENTRY_FILE, "src/{@DEFAULT_ENTRY_FILE}"}
    if package_name != "" {
        named :: "{package_name}.{@FILE_EXT}"
        if !canonical_paths.contains(named) -> &canonical_paths.push(named)
    }
    canonical := [String]{}
    loop path in canonical_paths {
        if resolver.checked_file(path) == {
            .Ok(_) -> {
                &canonical.push(path)
            }
            .Err(error) -> {
                if !error.is_missing() -> return Err(PackageEntryError{message: pkg_format_entry_error(origin, error.message())})
            }
        }
    }
    retired_files := [CheckedFile]{}
    retired_index := [Int]{}
    loop index in 0..<olds.len() {
        if resolver.checked_file(olds[index]) == {
            .Ok(file) -> {
                &retired_files.push(file)
                &retired_index.push(index)
            }
            .Err(error) -> {
                if !error.is_missing() -> return Err(PackageEntryError{message: pkg_format_entry_error(origin, error.message())})
            }
        }
    }
    if retired_files.len() == 0 -> return Ok(false)
    if retired_files.len() != 1 || canonical.len() > 0 {
        old_names := [String]{}
        loop index in retired_index -> &old_names.push("`{olds[index]}`")
        current :: if canonical.len() == 0 -> "no canonical entry" else -> {
            quoted := [String]{}
            loop path in canonical -> &quoted.push("`{path}`")
            quoted.join(", ")
        }
        return Err(PackageEntryError{message: pkg_format_entry_error(origin, "ambiguous project entry: retired {old_names.join(", ")} and {current} both identify this project; keep one entry and run again")})
    }
    file :: retired_files[0]
    old :: olds[retired_index[0]]
    target :: news[retired_index[0]]
    if resolver.revalidate_file(file) == .Err(error) -> return Err(PackageEntryError{message: pkg_format_entry_error(origin, error.message())})
    destination :: files.join(resolver.root(), target)
    if files.rename(file.path, destination) == .Err(error) -> return Err(PackageEntryError{message: pkg_format_entry_error(origin, "could not migrate `{old}` to `{target}`: {error}")})
    eprint("notice: migrated retired entry `{old}` to `{target}` (D-VERDICT-678-1)")
    Ok(true)
}
