//RS // ── `fn build` co-location (D-BUILDSCOPE1) ──────────────────────────────────
//RS 
//RS /// Return the Jet declarations that live beside the manifest blocks in
//RS /// `package.jet`, preserving their original byte offsets. D-BUILDSCOPE1 makes
//RS /// `package.jet` a valid home for the package's single `fn build`; the
//RS /// manifest reader must therefore expose that source without teaching the
//RS /// manifest grammar how to parse ordinary Jet items.
//RS ///
//RS /// Known manifest blocks are blanked with spaces (newlines are retained), so
//RS /// diagnostics from the later compiler parse still point at `package.jet`.
//RS /// The result is `None` when the remaining top-level source has no `fn build`.
//RS pub fn build_entry_source(text: &str) -> Option<String> {
//RS     let mut masked = text.as_bytes().to_vec();
