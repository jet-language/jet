// `packages:` (U10) and `targets:` target-profile
// selections (Package/Blocks.rs).
use jetpack_foundation.[
    PACKAGE_FIELD_TARGETS, TARGET_EXAMPLE, TARGET_EXECUTABLE,
    TARGET_FIELD_ENTRY, TARGET_FIELD_EXPORT, TARGET_FIELD_NAME, TARGET_LIBRARY, TARGET_RESERVED,
    TARGET_SANDBOX, TARGET_TEST,
]

// The realize axis for a package (U10).
PackageKind: enum {
    Library
    Executable
}

// One build target of a package (Rust `Blocks::Target`).
PackageTarget: enum {
    Library
    Executable
    Test
    Example
    Plugin(export: String?)
}

// One entry in the `packages: { … }` block.
PackageEntry: struct {
    name: String
    targets: [PackageTarget]
}

// Why a target-profile identity or selection set was refused.
#Error
TargetProfileError: struct {
    detail: String

    message: fn(self) -> String Never! { self.detail }
}

TARGET_PROFILE_WEB_BROWSER: "web.browser"
TARGET_PROFILE_WEB_WASI_SERVER: "web.wasi_server"
TARGET_PROFILE_WEB_NO_OS: "web.no_os"

// The exact identity selected for a package target. Built-in web identities
// are closed; any other identity names a typed target-profile declaration.
TargetProfileIdentity: enum {
    WebBrowser
    WebWasiServer
    WebNoOS
    Named(String)

    // Parse one exact target-profile identity.
    parse: fn(input: String) -> TargetProfileIdentity TargetProfileError! {
        value: input.trim()
        if value == "" -> return Err(TargetProfileError{detail: "target profile identity must not be empty"})
        loop byte in value.bytes() {
            code: Int.from_u8(byte)
            if !(pkg_bytes_is_word(code) || code == 46 || code == 45) {
                return Err(TargetProfileError{detail: "target profile identity `{value}` contains characters outside `[A-Za-z0-9_.-]`"})
            }
        }
        if value.starts_with(".") || value.ends_with(".") || value.contains("..") {
            return Err(TargetProfileError{detail: "target profile identity `{value}` must use non-empty dotted components"})
        }
        if value == {
            TARGET_PROFILE_WEB_BROWSER -> return Ok(TargetProfileIdentity.WebBrowser)
            TARGET_PROFILE_WEB_WASI_SERVER -> return Ok(TargetProfileIdentity.WebWasiServer)
            TARGET_PROFILE_WEB_NO_OS -> return Ok(TargetProfileIdentity.WebNoOS)
            else -> {}
        }
        lower: pkg_ascii_lower(value)
        if lower == "web" || lower.starts_with("web.") {
            return Err(TargetProfileError{detail: "unknown web target profile `{value}`; allowed identities are `{TARGET_PROFILE_WEB_BROWSER}`, `{TARGET_PROFILE_WEB_WASI_SERVER}`, and `{TARGET_PROFILE_WEB_NO_OS}`"})
        }
        if lower == "wasm" || lower.starts_with("wasm.") || lower.starts_with("wasm32-") || lower == "no_os" || lower.starts_with("no_os.") || lower == "no-os" || lower.starts_with("no-os.") || lower == "freestanding" {
            return Err(TargetProfileError{detail: "generic Wasm/no-OS target profile `{value}` is not selectable; use an exact typed profile identity"})
        }
        Ok(TargetProfileIdentity.Named(value))
    }

    as_str: fn(self) -> String Never! {
        if self == {
            .WebBrowser -> TARGET_PROFILE_WEB_BROWSER
            .WebWasiServer -> TARGET_PROFILE_WEB_WASI_SERVER
            .WebNoOS -> TARGET_PROFILE_WEB_NO_OS
            .Named(value) -> value
        }
    }

    is_web_builtin: fn(self) -> Bool Never! {
        if self == {
            .WebBrowser | .WebWasiServer | .WebNoOS -> true
            .Named(_) -> false
        }
    }

    validate: fn(self) TargetProfileError! {
        parsed: TargetProfileIdentity.parse(self.as_str())
        if parsed != self -> return Err(TargetProfileError{detail: "target profile identity `{self.as_str()}` does not match its typed identity"})
    }
}

// One named package target and the exact profile it selects.
TargetProfileSelection: struct {
    name: String
    profile: TargetProfileIdentity
}

// Target-profile selections keyed by target name.
PackageTargets: struct {
    priv selections: [String: TargetProfileSelection]

    empty: fn() -> PackageTargets Never! {
        PackageTargets{selections: [String: TargetProfileSelection]{}}
    }

    from_selections: fn(selections: [TargetProfileSelection]) -> PackageTargets TargetProfileError! {
        by_name := [String: TargetProfileSelection]{}
        profiles := [String]{}
        loop selection in selections {
            name: selection.name.trim()
            if name == "" -> return Err(TargetProfileError{detail: "target name must not be empty"})
            if pkg_text_has_space(name) -> return Err(TargetProfileError{detail: "target name `{name}` must not contain whitespace"})
            if by_name.has_key(name) -> return Err(TargetProfileError{detail: "target `{name}` is declared more than once"})
            selection.profile.validate()
            if profiles.contains(selection.profile.as_str()) -> return Err(TargetProfileError{detail: "target profile `{selection.profile.as_str()}` is selected more than once"})
            profiles.push(selection.profile.as_str())
            by_name[name] = TargetProfileSelection{name: name, profile: selection.profile}
        }
        Ok(PackageTargets{selections: by_name})
    }

    get: fn(self, target_name: String) -> TargetProfileSelection? Never! {
        self.selections.get(target_name)
    }

    profile: fn(self, target_name: String) -> TargetProfileIdentity? Never! {
        selection: self.selections.get(target_name) ?? return None
        Val(selection.profile)
    }

    // Selections in target-name order.
    iter: fn(self) -> [TargetProfileSelection] Never! {
        out := [TargetProfileSelection]{}
        loop name in pkg_manifest_sorted(self.selections.keys().to_list()) -> out.push(self.selections[name])
        out
    }

    as_map: fn(self) -> [String: TargetProfileSelection] Never! {
        self.selections
    }

    len: fn(self) -> Int Never! {
        self.selections.len()
    }

    is_empty: fn(self) -> Bool Never! {
        self.selections.len() == 0
    }
}

pkg_target_profile_entries: fn(body: String) -> [ManifestEntry] PackageParseError! {
    entries := [ManifestEntry]{}
    loop piece in pkg_top_level_lines_or_commas(body) {
        entry: piece.trim()
        if entry == "" -> next
        parts: entry.split_once(":") ?? return Err(PackageParseError.Composition("malformed target profile field `{entry}`"))
        entries.push(ManifestEntry{key: parts.before.trim(), value: parts.after.trim()})
    }
    Ok(entries)
}

// Parse the body of `targets: { web: { profile: "web.browser" }, … }`.
pkg_parse_target_profiles: fn(body: String) -> PackageTargets PackageParseError! {
    entries: pkg_target_profile_entries(body)
    if entries.len() == 0 -> return Err(PackageParseError.BadTargetField{name: "targets", detail: "the `targets` block must declare at least one target"})
    selections := [TargetProfileSelection]{}
    loop entry in entries {
        name: pkg_unquote(entry.key)
        if name == "" -> return Err(PackageParseError.BadTargetField{name: "targets", detail: "target names must not be empty"})
        inner: (pkg_strip_wrapped(entry.value.trim(), "{{", "}}") ?? return Err(PackageParseError.BadTargetField{name: name, detail: "target selection must be a record containing only `profile`"})).trim()
        profile := TargetProfileIdentity?{None}
        seen := [String]{}
        loop field in pkg_target_profile_entries(inner) {
            if seen.contains(field.key) -> return Err(PackageParseError.BadTargetField{name: name, detail: "target field `{field.key}` is declared more than once"})
            seen.push(field.key)
            if field.key != "profile" -> return Err(PackageParseError.BadTargetField{name: name, detail: "unknown target selection field `{field.key}` (allowed: `profile`)"})
            if TargetProfileIdentity.parse(pkg_unquote(field.value)) == {
                .Ok(identity) -> profile = Val(identity)
                .Err(error) -> return Err(PackageParseError.BadTargetField{name: name, detail: error.detail})
            }
        }
        selected: profile ?? return Err(PackageParseError.BadTargetField{name: name, detail: "target selection must declare `profile`"})
        selections.push(TargetProfileSelection{name: name, profile: selected})
    }
    if PackageTargets.from_selections(selections) == {
        .Ok(targets) -> Ok(targets)
        .Err(error) -> Err(PackageParseError.BadTargetField{name: "targets", detail: error.detail})
    }
}

// Parse the body of `packages: { name: executable, lib: { targets: [...] } }`.
pkg_parse_packages: fn(body: String) -> [PackageEntry] PackageParseError! {
    packages := [PackageEntry]{}
    loop piece in pkg_top_level_commas(body) {
        entry: piece.trim()
        if entry == "" -> next
        if entry.split_once(":") == {
            .Val(parts) -> {
                name: parts.before.trim()
                value: parts.after.trim()
                if value.starts_with("{{") {
                    rest: value.removeprefix("{{").trim_end()
                    inner: if rest.ends_with("}}") -> rest.removesuffix("}}") else -> rest
                    packages.push(PackageEntry{name: name, targets: pkg_parse_package_entry_block(name, inner)})
                } else {
                    packages.push(PackageEntry{name: name, targets: [PackageTarget]{pkg_parse_target(name, value)}})
                }
            }
            .None -> {
                packages.push(PackageEntry{name: entry, targets: [PackageTarget]{}})
            }
        }
    }
    Ok(packages)
}

pkg_parse_target: fn(name: String, value: String) -> PackageTarget PackageParseError! {
    keyword := value.trim()
    block := String?{None}
    if value.split_once("{{") == {
        .Val(parts) -> {
            keyword = parts.before.trim()
            rest: parts.after.trim_end()
            block = Val(if rest.ends_with("}}") -> rest.removesuffix("}}") else -> rest)
        }
        .None -> {}
    }
    if keyword == TARGET_SANDBOX {
        export: if block == {
            .Val(body) -> pkg_validate_plugin_block(name, body)
            .None -> None
        }
        return Ok(PackageTarget.Plugin{export: export})
    }
    target: if keyword == {
        TARGET_LIBRARY -> PackageTarget.Library
        TARGET_EXECUTABLE -> PackageTarget.Executable
        TARGET_TEST -> PackageTarget.Test
        TARGET_EXAMPLE -> PackageTarget.Example
        else -> {
            return Err(PackageParseError.BadTarget{name: name, value: keyword, reserved: TARGET_RESERVED.contains(keyword)})
        }
    }
    if block == .Val(body) -> pkg_validate_target_block(name, body)
    Ok(target)
}

pkg_validate_target_block: fn(name: String, body: String) PackageParseError! {
    seen := [String]{}
    loop entry in pkg_key_value_entries(body) {
        if seen.contains(entry.key) -> return Err(PackageParseError.BadTargetField{name: name, detail: "target field `{entry.key}` is declared more than once"})
        seen.push(entry.key)
        if entry.key != TARGET_FIELD_ENTRY && entry.key != TARGET_FIELD_NAME {
            return Err(PackageParseError.BadTargetField{name: name, detail: "unknown target field `{entry.key}` (allowed: `{TARGET_FIELD_ENTRY}`, `{TARGET_FIELD_NAME}`)"})
        }
    }
}

pkg_validate_plugin_block: fn(name: String, body: String) -> String? PackageParseError! {
    export := String?{None}
    seen := [String]{}
    loop entry in pkg_key_value_entries(body) {
        if seen.contains(entry.key) -> return Err(PackageParseError.BadTargetField{name: name, detail: "sandbox field `{entry.key}` is declared more than once"})
        seen.push(entry.key)
        if entry.key == {
            TARGET_FIELD_ENTRY | TARGET_FIELD_NAME -> {}
            TARGET_FIELD_EXPORT -> export = Val(pkg_unquote(entry.value))
            else -> return Err(PackageParseError.BadTargetField{name: name, detail: "unknown field `{entry.key}` on `sandbox` (allowed: `{TARGET_FIELD_ENTRY}`, `{TARGET_FIELD_NAME}`, `{TARGET_FIELD_EXPORT}`)"})
        }
    }
    Ok(export)
}

pkg_parse_package_entry_block: fn(name: String, body: String) -> [PackageTarget] PackageParseError! {
    loop entry in pkg_key_value_entries(body) {
        if entry.key == PACKAGE_FIELD_TARGETS -> return pkg_parse_targets_list(name, entry.value.trim())
        return Err(PackageParseError.BadTargetField{name: name, detail: "unknown package field `{entry.key}`"})
    }
    Ok([PackageTarget]{})
}

pkg_parse_targets_list: fn(name: String, value: String) -> [PackageTarget] PackageParseError! {
    inner: pkg_strip_wrapped(value, "[", "]") ?? value
    targets := [PackageTarget]{}
    loop piece in pkg_top_level_commas(inner) {
        entry: piece.trim()
        if entry == "" -> next
        targets.push(pkg_parse_target(name, entry))
    }
    Ok(targets)
}
