// `policy: { … }` (D-POLICY-WORD1, D-TEAMPOLICY1, D-LINTPOLICY1,
// D-PACKAGE-POLICY-SCOPE1, D-ONCE-AUTODERIVE1, D-MEM-GUARANTEE1,
// D-JPK-POLICYSURFACE1, D-JPK-FRESHNESS1, D-GRADE-POLICY1) and the standalone
// organization policy document (Package/Blocks.rs).

fn pkg_bad_mem(detail: String) -> PackageParseError Never! {
    PackageParseError.BadMemoryPolicy{detail: detail}
}

fn pkg_bad_guarantee(detail: String) -> PackageParseError Never! {
    PackageParseError.BadGuaranteePolicy{detail: detail}
}

fn pkg_bad_policy(detail: String) -> PackageParseError Never! {
    PackageParseError.BadPackagePolicy{detail: detail}
}

// `policy.lints.deny` (D-LINTPOLICY1). `None` means no `lints:` block.
pub fn pkg_parse_lints_policy(body: String) -> [String]? PackageParseError! {
    if lint_parse_policy_lints(body) == {
        .Ok(lints) -> Ok(lints)
        .Err(error) -> {
            if error.code == .Val(code) && error.name == .Val(name) -> return Err(PackageParseError.LintPolicyCode{code: code, name: name})
            Err(PackageParseError.Composition(error.detail))
        }
    }
}

// The source-level policy declarations of a `policy:` body. Package-only
// fields are skipped when `package_only_fields` is set.
pub fn pkg_parse_policy(body: String, package_only_fields: Bool) -> [PolicyDeclaration] PackageParseError! {
    out := [PolicyDeclaration]{}
    seen := [PolicyKey]{}
    loop entry in pkg_key_value_entries(body) {
        name :: entry.key
        raw :: entry.value
        if name == "trust" || name == "providers" -> return Err(PackageParseError.RetiredAuthorityField{field: "policy.{name}", replacement: "authority.{name}"})
        if package_only_fields && (name == POLICY_FIELD_EFFECTS || name == POLICY_FIELD_UNSAFE || name == POLICY_FIELD_EXPERT || name == POLICY_FIELD_DEPS || name == POLICY_FIELD_CLAIMS) -> next
        if policy_key_parse(name) == None {
            pkg_policy_unknown_key(name, raw, package_only_fields)
            next
        }
        key :: policy_key_parse(name) ?? next
        if seen.contains(key) -> return Err(pkg_bad_mem("package policy `{name}` is declared more than once"))
        &seen.push(key)
        value :: if policy_parse_value(key, raw) == {
            .Ok(parsed) -> parsed
            .Err(error) -> {
                return Err(pkg_bad_mem(error.message()))
            }
        }
        &out.push(PolicyDeclaration{key: key, value: value, scope: PolicyScope.Package, span: Span{start: 0, end: 0}, target: None, source: "package.jet"})
    }
    loop rule in POLICY_RULES {
        if policy_resolve(rule.key, out) == .Err(error) -> return Err(pkg_bad_mem("conflicting `{policy_key_name(rule.key)}` declarations: {error.debug()}"))
    }
    Ok(out)
}

// A `policy:` name outside the source PolicyKey ladder: a retired memory
// floor, a package-only field (accepted elsewhere), the retired
// auto-derive switch, or an unregistered policy.
fn pkg_policy_unknown_key(name: String, raw: String, package_only_fields: Bool) PackageParseError! {
    replacement :: if name == {
        "no_alloc" -> Val("`authority: {{ holds: {{ deny: [Mem.Alloc] }} }}`")
        "zero_rc" -> Val("`authority: {{ holds: {{ deny: [Mem.Rc] }} }}`")
        "arena_bounded" -> {
            if pkg_parse_u64(raw) == .Val(bytes) && bytes > 0 -> Val("`authority: {{ holds: {{ deny: [Mem.Alloc(above: {bytes})] }} }}`") else -> None
        }
        else -> None
    }
    if replacement == .Val(text) -> return Err(pkg_bad_mem("`{name}` is a retired memory floor; write the denial {text}"))
    if name == POLICY_FIELD_LINTS -> return
    if package_only_fields && (name == POLICY_FIELD_CONTAIN || name == POLICY_FIELD_HARDEN || name == POLICY_FIELD_LICENSES || name == POLICY_FIELD_SOURCES || name == POLICY_FIELD_EXCEPTIONS || name == POLICY_FIELD_CLAIMS) -> return
    auto_derive :: lint_auto_derive_name()
    if name == auto_derive -> return Err(PackageParseError.RetiredPolicyField{field: "policy.{name}", replacement: "policy: {{ lints: {{ deny: [{auto_derive}] }} }}"})
    return Err(pkg_bad_mem("`{name}` is not a registered package policy; memory floors belong in `authority.holds.deny`"))
}

// One `policy.sources` rule: a package pattern and its allowed sources.
pub struct PolicySourceMap {
    pub pattern: String
    pub sources: [String]
}

// The package-policy fields that govern package metadata and team
// ceilings (Rust returns them as one tuple).
pub struct PackagePolicySurface {
    pub licenses: [String]?
    pub source_maps: [PolicySourceMap]
    pub exceptions: [PackagePolicyException]
    pub effects: [String: [String]]
    pub unsafe_paths: [String]?
    pub expert: Bool?
    pub deps: [String]?
    pub claims_min: ClaimsGrade?
}

pub fn pkg_parse_package_policy_surface(body: String) -> PackagePolicySurface PackageParseError! {
    surface := PackagePolicySurface{licenses: None, source_maps: [PolicySourceMap]{}, exceptions: [PackagePolicyException]{}, effects: [String: [String]]{}, unsafe_paths: None, expert: None, deps: None, claims_min: None}
    seen_sources := [String]{}
    sources_seen := false
    exceptions_seen := false
    effects_seen := false
    unsafe_seen := false
    expert_seen := false
    deps_seen := false
    claims_seen := false
    loop entry in pkg_key_value_entries(body) {
        raw :: entry.value
        if entry.key == {
            POLICY_FIELD_EFFECTS -> {
                if effects_seen -> return Err(pkg_bad_policy("`policy.effects` is declared more than once"))
                effects_seen = true
                paths_seen := [String]{}
                loop ceiling in pkg_key_value_entries(pkg_record_value_body(raw, "policy.effects")) {
                    path :: pkg_parse_policy_path(ceiling.key, "policy.effects")
                    if paths_seen.contains(path) -> return Err(pkg_bad_policy("`policy.effects.{path}` is declared more than once"))
                    &paths_seen.push(path)
                    surface.effects[path] = pkg_parse_effect_ceiling(ceiling.value, "policy.effects.{path}")
                }
            }
            POLICY_FIELD_UNSAFE -> {
                if unsafe_seen -> return Err(pkg_bad_policy("`policy.unsafe` is declared more than once"))
                unsafe_seen = true
                value :: raw.trim()
                if value == ".Deny" {
                    surface.unsafe_paths = Val([String]{})
                } else {
                    list :: pkg_strip_wrapped(value, ".Paths(", ")") ?? return Err(pkg_bad_policy("`policy.unsafe` must be `.Deny` or `.Paths([\"src/audited\"])`"))
                    surface.unsafe_paths = Val(pkg_parse_policy_path_list(list, "policy.unsafe"))
                }
            }
            POLICY_FIELD_EXPERT -> {
                if expert_seen -> return Err(pkg_bad_policy("`policy.expert` is declared more than once"))
                expert_seen = true
                if raw.trim() == {
                    ".Deny" -> surface.expert = Val(false)
                    ".Allow" -> surface.expert = Val(true)
                    else -> return Err(pkg_bad_policy("`policy.expert` must be `.Deny` or `.Allow`"))
                }
            }
            POLICY_FIELD_DEPS -> {
                if deps_seen -> return Err(pkg_bad_policy("`policy.deps` is declared more than once"))
                deps_seen = true
                list :: pkg_strip_wrapped(raw.trim(), ".List(", ")") ?? return Err(pkg_bad_policy("`policy.deps` must use the canonical `.List([\"dependency\"])` allow-list"))
                surface.deps = Val(pkg_parse_dependency_policy_list(list))
            }
            POLICY_FIELD_CLAIMS -> {
                if claims_seen -> return Err(pkg_bad_policy("`policy.claims` is declared more than once"))
                claims_seen = true
                min_seen := false
                loop field in pkg_key_value_entries(pkg_record_value_body(raw, "policy.claims")) {
                    if field.key != "min" -> return Err(pkg_bad_policy("`policy.claims` has unknown field `{field.key}`; use `min`"))
                    if min_seen -> return Err(pkg_bad_policy("`policy.claims.min` is declared more than once"))
                    min_seen = true
                    surface.claims_min = Val(ClaimsGrade.parse(field.value) ?? return Err(pkg_bad_policy("`policy.claims.min` must be `.Unchecked`, `.Checked`, `examples(n)`, `generated(n)`, or `.Proved`")))
                }
                if !min_seen -> return Err(pkg_bad_policy("`policy.claims` requires `min`"))
            }
            POLICY_FIELD_LICENSES -> {
                if surface.licenses != None -> return Err(pkg_bad_policy("`policy.licenses` is declared more than once"))
                list :: pkg_strip_wrapped(raw.trim(), ".Allow(", ")") ?? return Err(pkg_bad_policy("`policy.licenses` must use `.Allow([\"MIT\", \"Apache-2.0\"])`"))
                values :: pkg_parse_string_list(list) ?? return Err(pkg_bad_policy("`policy.licenses` must contain a non-empty string list"))
                if values.len() == 0 || pkg_policy_any_blank(values) -> return Err(pkg_bad_policy("`policy.licenses` must contain a non-empty string list"))
                if pkg_policy_has_repeat(values) -> return Err(pkg_bad_policy("`policy.licenses` cannot repeat an SPDX identifier"))
                surface.licenses = Val(values)
            }
            POLICY_FIELD_SOURCES -> {
                if sources_seen -> return Err(pkg_bad_policy("`policy.sources` is declared more than once"))
                sources_seen = true
                source_body :: pkg_strip_wrapped(raw.trim(), "{{", "}}") ?? return Err(pkg_bad_policy("`policy.sources` must be a record"))
                loop rule in pkg_key_value_entries(source_body) {
                    pattern :: pkg_unquote(rule.key)
                    stars :: pkg_text_count(pattern, "*")
                    if pattern.trim() == "" || (pattern.contains("*") && !pattern.ends_with("*")) || stars > 1 -> return Err(pkg_bad_policy("`policy.sources` patterns must be exact names or one trailing `*`"))
                    if seen_sources.contains(pattern) -> return Err(pkg_bad_policy("`policy.sources.{pattern}` is declared more than once"))
                    &seen_sources.push(pattern)
                    sources :: pkg_parse_string_list(rule.value.trim()) ?? return Err(pkg_bad_policy("`policy.sources.{pattern}` must contain a non-empty source list"))
                    if sources.len() == 0 || pkg_policy_any_blank(sources) -> return Err(pkg_bad_policy("`policy.sources.{pattern}` must contain a non-empty source list"))
                    if pkg_policy_has_repeat(sources) -> return Err(pkg_bad_policy("`policy.sources.{pattern}` cannot repeat a source authority"))
                    &surface.source_maps.push(PolicySourceMap{pattern: pattern, sources: sources})
                }
            }
            POLICY_FIELD_EXCEPTIONS -> {
                if exceptions_seen -> return Err(pkg_bad_policy("`policy.exceptions` is declared more than once"))
                exceptions_seen = true
                surface.exceptions = pkg_parse_policy_exceptions(raw)
            }
            else -> {}
        }
    }
    Ok(surface)
}

fn pkg_policy_any_blank(values: [String]) -> Bool Never! {
    loop value in values {
        if value.trim() == "" -> return true
    }
    false
}

fn pkg_policy_has_repeat(values: [String]) -> Bool Never! {
    unique := [String]{}
    loop value in values {
        if unique.contains(value) -> return true
        &unique.push(value)
    }
    false
}

// The body of a `{ … }` or `.{ … }` record value with nothing after it.
fn pkg_record_value_body(raw: String, field: String) -> String PackageParseError! {
    value :: raw.trim()
    open :: pkg_text_find_byte(value, 123) ?? return Err(pkg_bad_policy("`{field}` must be a record"))
    close :: pkg_text_rfind_byte(value, 125) ?? return Err(pkg_bad_policy("`{field}` is missing `}}`"))
    head :: pkg_binder_slice(value, 0, open).trim()
    if head != "" && head != "." -> return Err(pkg_bad_policy("`{field}` must be a record"))
    if pkg_binder_tail(value, close + 1).trim() != "" -> return Err(pkg_bad_policy("`{field}` has trailing content"))
    Ok(pkg_binder_slice(value, open + 1, close))
}

// A quoted project-relative path normalized to `/`-joined components (`.`
// for the root); `..`, absolute paths, and control characters are refused.
fn pkg_parse_policy_path(input: String, field: String) -> String PackageParseError! {
    raw :: input.trim()
    if raw.bytes().len() < 2 || !raw.starts_with("\"") || !raw.ends_with("\"") -> return Err(pkg_bad_policy("`{field}` paths must be quoted project-relative paths"))
    value :: pkg_unquote(raw)
    if value == "" || value.contains("\\") || value.contains("*") || value.contains("?") -> return Err(pkg_bad_policy("`{field}` contains an invalid project-relative path"))
    if value.starts_with("/") -> return Err(pkg_bad_policy("`{field}` must stay within the project root"))
    components := [String]{}
    loop component in value.split("/") {
        if component == "" || component == "." -> next
        if component == ".." -> return Err(pkg_bad_policy("`{field}` must stay within the project root"))
        if pkg_text_has_control(component) -> return Err(pkg_bad_policy("`{field}` contains an invalid project-relative path"))
        &components.push(component)
    }
    if components.len() == 0 -> return Ok(".")
    Ok(components.join("/"))
}

fn pkg_parse_policy_path_list(raw: String, field: String) -> [String] PackageParseError! {
    inner :: pkg_strip_wrapped(raw.trim(), "[", "]") ?? return Err(pkg_bad_policy("`{field}` must contain a path list"))
    paths := [String]{}
    loop piece in pkg_top_level_commas(inner) {
        entry :: piece.trim()
        if entry == "" -> return Err(pkg_bad_policy("`{field}` cannot contain an empty path"))
        path :: pkg_parse_policy_path(entry, field)
        if !paths.contains(path) -> &paths.push(path)
    }
    Ok(pkg_manifest_sorted(paths))
}

// An effect ceiling `-[]>` / `-[IO, Net]>` as a sorted set of positive names.
fn pkg_parse_effect_ceiling(raw: String, field: String) -> [String] PackageParseError! {
    inner :: pkg_strip_wrapped(raw.trim(), "-[", "]>") ?? return Err(pkg_bad_policy("`{field}` must be an effect ceiling such as `-[]>` or `-[IO.Net]>`"))
    effects := [String]{}
    loop piece in pkg_top_level_commas(inner) {
        entry :: piece.trim()
        if entry == "" -> return Err(pkg_bad_policy("`{field}` cannot contain an empty effect"))
        if entry.contains("(") -> return Err(pkg_bad_policy("`{field}` accepts only positive effect names, not parameterized rights"))
        right :: authority_parse_right(entry) ?? return Err(pkg_bad_policy("`{entry}` is not a registered effect name for `{field}`"))
        if !effects.contains(right) -> &effects.push(right)
        if right == "Panic" -> return Err(pkg_bad_policy("`Panic` is deny-only and cannot appear in a positive effect ceiling"))
    }
    Ok(pkg_manifest_sorted(effects))
}

fn pkg_parse_dependency_policy_list(raw: String) -> [String] PackageParseError! {
    inner :: pkg_strip_wrapped(raw.trim(), "[", "]") ?? return Err(pkg_bad_policy("`policy.deps` must contain a dependency-name list"))
    dependencies := [String]{}
    loop piece in pkg_top_level_commas(inner) {
        entry :: piece.trim()
        if entry == "" -> return Err(pkg_bad_policy("`policy.deps` cannot contain an empty dependency"))
        dependency :: pkg_unquote(entry)
        if !pkg_validate_dependency_name(dependency) -> return Err(pkg_bad_policy("`policy.deps` name `{dependency}` must be one safe path component"))
        if !dependencies.contains(dependency) -> &dependencies.push(dependency)
    }
    Ok(pkg_manifest_sorted(dependencies))
}

fn pkg_parse_policy_exceptions(raw: String) -> [PackagePolicyException] PackageParseError! {
    inner :: pkg_strip_wrapped(raw.trim(), "[", "]") ?? return Err(pkg_bad_policy("`policy.exceptions` must be a list of PolicyException records"))
    exceptions := [PackagePolicyException]{}
    seen_ids := [String]{}
    seen_scopes := [String]{}
    loop piece in pkg_top_level_commas(inner) {
        entry :: piece.trim()
        if entry == "" -> next
        body :: pkg_strip_wrapped(entry, "{POLICY_EXCEPTION_TYPE}{{", "}}") ?? return Err(pkg_bad_policy("`policy.exceptions` entries must use `PolicyException{{ id: \"…\", scope: \"package#version\", reason: \"…\", expires: … }}`"))
        id_value := String?{None}
        scope_value := String?{None}
        reason_value := String?{None}
        expires_value := String?{None}
        loop field in pkg_key_value_entries(body) {
            duplicate :: if field.key == {
                POLICY_EXCEPTION_FIELD_ID -> id_value != None
                POLICY_EXCEPTION_FIELD_SCOPE -> scope_value != None
                POLICY_EXCEPTION_FIELD_REASON -> reason_value != None
                POLICY_EXCEPTION_FIELD_EXPIRES -> expires_value != None
                else -> {
                    return Err(pkg_bad_policy("unknown `PolicyException` field `{field.key}`"))
                }
            }
            if duplicate -> return Err(pkg_bad_policy("`PolicyException.{field.key}` is declared more than once"))
            if field.key == {
                POLICY_EXCEPTION_FIELD_ID -> id_value = Val(field.value)
                POLICY_EXCEPTION_FIELD_SCOPE -> scope_value = Val(field.value)
                POLICY_EXCEPTION_FIELD_REASON -> reason_value = Val(field.value)
                else -> expires_value = Val(field.value)
            }
        }
        id :: pkg_exception_string(id_value, POLICY_EXCEPTION_FIELD_ID)
        scope :: pkg_exception_string(scope_value, POLICY_EXCEPTION_FIELD_SCOPE)
        reason :: pkg_exception_string(reason_value, POLICY_EXCEPTION_FIELD_REASON)
        expires_raw :: expires_value ?? return Err(pkg_bad_policy("`PolicyException.expires` is required"))
        expires :: pkg_parse_policy_expiry(expires_raw)
        pkg_validate_exception_text("id", id)
        pkg_validate_exception_text("scope", scope)
        pkg_validate_exception_text("reason", reason)
        if !pkg_is_exact_exception_scope(scope) -> return Err(pkg_bad_policy("`PolicyException.scope` must be an exact `package#version` target; wildcards, `@`, and ranges are not allowed"))
        if seen_ids.contains(id) -> return Err(pkg_bad_policy("`policy.exceptions` repeats exception id `{id}`"))
        &seen_ids.push(id)
        if seen_scopes.contains(scope) -> return Err(pkg_bad_policy("`policy.exceptions` repeats exact scope `{scope}`"))
        &seen_scopes.push(scope)
        &exceptions.push(PackagePolicyException{id: id, scope: scope, reason: reason, expires_at: expires})
    }
    Ok(exceptions)
}

fn pkg_exception_string(value: String?, field: String) -> String PackageParseError! {
    raw :: value ?? return Err(pkg_bad_policy("`PolicyException.{field}` is required"))
    text :: pkg_unquote(raw)
    if text.trim() == "" -> return Err(pkg_bad_policy("`PolicyException.{field}` must not be empty"))
    Ok(text)
}

fn pkg_validate_exception_text(field: String, value: String) PackageParseError! {
    if pkg_text_has_control(value) || value.contains(";") || value.contains("|") {
        return Err(pkg_bad_policy("`PolicyException.{field}` cannot contain control, `;`, or `|` characters"))
    }
}

fn pkg_is_exact_exception_scope(scope: String) -> Bool Never! {
    parts :: scope.split_once("#") ?? return false
    if parts.before == "" || parts.after == "" || scope.contains("@") || pkg_text_count(scope, "#") != 1 -> return false
    if pkg_text_has_space(parts.before) || pkg_text_has_space(parts.after) -> return false
    loop byte in parts.after.bytes() {
        if Int.from_u8(byte) == {
            42 | 94 | 60 | 62 | 61 | 126 | 124 | 44 -> return false
            else -> {}
        }
    }
    true
}

// A Unix timestamp, or `Date.parse("YYYY-MM-DD")?` / a quoted date, as
// seconds since 1970-01-01.
fn pkg_parse_policy_expiry(raw: String) -> Int PackageParseError! {
    value :: raw.trim()
    if pkg_parse_u64(value) == .Val(timestamp) -> return Ok(timestamp)
    date := String?{None}
    if pkg_strip_wrapped(value, "Date.parse(\"", "\")?") == .Val(inner) {
        date = Val(inner)
    } else {
        unquoted :: pkg_unquote(value)
        if unquoted != value -> date = Val(unquoted)
    }
    text :: date ?? return Err(pkg_bad_policy("`PolicyException.expires` must be a Unix timestamp or `Date.parse(\"YYYY-MM-DD\")?`"))
    parts :: text.split("-").to_list()
    if parts.len() > 3 -> return Err(pkg_bad_policy("`PolicyException.expires` has an invalid calendar date"))
    if parts.len() < 3 -> return Err(pkg_bad_policy("`PolicyException.expires` has an invalid calendar date"))
    year :: pkg_parse_i64(parts[0]) ?? return Err(pkg_bad_policy("`PolicyException.expires` has an invalid calendar date"))
    month :: pkg_parse_i64(parts[1]) ?? return Err(pkg_bad_policy("`PolicyException.expires` has an invalid calendar date"))
    day :: pkg_parse_i64(parts[2]) ?? return Err(pkg_bad_policy("`PolicyException.expires` has an invalid calendar date"))
    if month < 1 || month > 12 || day < 1 || day > pkg_days_in_month(year, month) -> return Err(pkg_bad_policy("`PolicyException.expires` has an invalid calendar date"))
    days :: pkg_days_from_civil(year, month, day)
    if days < 0 || days > PKG_MAX_U64_IN_INT /% 86400 -> return Err(pkg_bad_policy("`PolicyException.expires` is outside the supported date range"))
    Ok(days * 86400)
}

fn pkg_days_in_month(year: Int, month: Int) -> Int Never! {
    if month == {
        2 -> if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) -> 29 else -> 28
        4 | 6 | 9 | 11 -> 30
        else -> 31
    }
}

// Proleptic Gregorian days since 1970-01-01 (Hinnant's civil-date
// conversion).
fn pkg_days_from_civil(input_year: Int, input_month: Int, day: Int) -> Int Never! {
    year :: if input_month <= 2 -> input_year - 1 else -> input_year
    era :: math.div_rem(if year >= 0 -> year else -> year - 399, 400).quot
    year_of_era :: year - era * 400
    month :: if input_month > 2 -> input_month - 3 else -> input_month + 9
    day_of_year :: (153 * month + 2) /% 5 + day - 1
    day_of_era :: year_of_era * 365 + year_of_era /% 4 - year_of_era /% 100 + day_of_year
    era * 146097 + day_of_era - 719468
}

// The package-only dependency guarantee dial (D-MEM-GUARANTEE1=A).
pub struct GuaranteePolicy {
    pub contain: [String]
    pub harden: Bool
}

pub fn pkg_parse_guarantee_policy(body: String) -> GuaranteePolicy PackageParseError! {
    contain := [String]{}
    contain_seen := false
    harden_seen := false
    harden := false
    loop entry in pkg_key_value_entries(body) {
        if entry.key == POLICY_FIELD_CONTAIN {
            if contain_seen -> return Err(pkg_bad_guarantee("`policy.contain` may be declared once"))
            contain_seen = true
            values :: pkg_parse_string_list(entry.value.trim()) ?? return Err(pkg_bad_guarantee("`policy.contain` must be a list like `[\"libxml\"]`"))
            loop dependency in values {
                if dependency.trim() == "" -> return Err(pkg_bad_guarantee("`policy.contain` cannot name an empty dependency"))
                if contain.contains(dependency) -> return Err(pkg_bad_guarantee("`policy.contain` cannot name one dependency more than once"))
                &contain.push(dependency)
            }
        } else if entry.key == POLICY_FIELD_HARDEN {
            if harden_seen -> return Err(pkg_bad_guarantee("`policy.harden` may be declared once"))
            harden_seen = true
            if entry.value.trim() == {
                "true" -> harden = true
                "false" -> return Err(pkg_bad_guarantee("`policy.harden` only tightens; omit it instead of writing `false`"))
                else -> return Err(pkg_bad_guarantee("`policy.harden` must be `true`; the package guarantee dial only tightens"))
            }
        }
    }
    Ok(GuaranteePolicy{contain: pkg_manifest_sorted(contain), harden: harden})
}

// Parse a standalone organization policy file whose entire content is one
// `policy: { … }` block (`JET_ORG_UNSAFE_POLICY`).
pub fn pkg_parse_policy_document(text: String) -> [PolicyDeclaration] PackageParseError! {
    stripped :: pkg_strip_comments(text).trim()
    if !stripped.starts_with(MANIFEST_BLOCK_POLICY) -> return Err(pkg_bad_mem("expected only `policy: {{ … }}`"))
    rest := stripped.removeprefix(MANIFEST_BLOCK_POLICY).trim_start()
    if !rest.starts_with(":") -> return Err(pkg_bad_mem("expected `:` after `policy`"))
    rest = rest.removeprefix(":").trim_start()
    if rest.starts_with(".") -> rest = rest.removeprefix(".").trim_start()
    if !rest.starts_with("{{") -> return Err(pkg_bad_mem("expected `.{{` after `policy:`"))
    rest = rest.removeprefix("{{")
    close :: pkg_text_find_byte(rest, 125) ?? return Err(pkg_bad_mem("missing `}}` after organization policy"))
    if pkg_binder_tail(rest, close + 1).trim() != "" -> return Err(pkg_bad_mem("organization policy file may contain only the `policy` block"))
    pkg_parse_policy(pkg_binder_slice(rest, 0, close), false)
}
