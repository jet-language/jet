// `deps: { … }` (S59): the typed dependency source of each entry, its
// display/audit spelling, and the one dependency-name path boundary.
use jetpack_foundation.[C_MODULE_ROOT, DEP_PROVIDER_C, REF_PROVIDER_AT]

// Where a dependency resolves from.
DepSource: enum {
    Version(String),
    Provider(provider: RefSource, target: String),
    Git(url: String, selector: GitSelector),
    CLib(target: String),
    // `language` is the binder's mount root.
    Foreign(language: String, reference: String),
}

// The selector from a `name#version` registry ref (or a quoted selector).
// A bare path or `target@provider` source ref.
// An inline git dependency with exactly one selector.
// A native C-library link dependency: `c@system` or `c@"vendor/path"`.
// A package-backed foreign namespace dependency.

// Render one `DepSource` back to its display/audit string form.
pkg_dep_display: fn(source: DepSource) -> String Never! {
    if source == {
        .Version(value) -> value
        .Provider(provider, target) -> if provider == {
            .Path -> target
            .Jetpack | .Nixpkgs | .Github | .Cran | .LuaRocks | .RubyGems | .Cpan | .Packagist | .JetRegistry | .Npm | .Cargo | .PyPI | .SwiftPM | .Maven | .NuGet | .Conan | .Vcpkg | .Homebrew | .Binary | .Releases | .Named(_) -> "{target}{REF_PROVIDER_AT}{provider.label()}"
        }
        .Git(url, selector) -> "{{ git: {pkg_debug_str(url)}, {selector.field()}: {pkg_debug_str(selector.value())} }}"
        .CLib(target) -> "lib: {target}"
        .Foreign(language, reference) -> "{language}{REF_PROVIDER_AT}{pkg_debug_str(reference)}"
    }
}

// Render one `DepSource` for a public package view: git URL user
// information and query/fragment text never cross the projection.
pkg_dep_display_redacted: fn(source: DepSource) -> String Never! {
    if source == {
        .Git(url, selector) -> "{{ git: {pkg_debug_str(pkg_redact_dependency_url(url))}, {selector.field()}: {pkg_debug_str(selector.value())} }}"
        .Version(_) | .Provider(_, _) | .CLib(_) | .Foreign(_, _) -> pkg_dep_display(source)
    }
}

pkg_redact_dependency_url: fn(input: String) -> String Never! {
    raw: input.bytes()
    cut := raw.len()
    loop index in 0..<raw.len() {
        code: Int{raw[index]}
        if code == 63 || code == 35 {
            cut = index
            break
        }
    }
    value: pkg_bytes_text(raw, 0, cut)
    separator: pkg_binder_find(value, "://", 0)
    if separator < 0 -> return value
    bytes: value.bytes()
    authority_start: separator + 3
    authority_end := bytes.len()
    loop index in authority_start..<bytes.len() {
        code: Int{bytes[index]}
        if code == 47 || code == 63 || code == 35 {
            authority_end = index
            break
        }
    }
    authority: pkg_bytes_text(bytes, authority_start, authority_end)
    at: pkg_text_rfind_byte(authority, 64) ?? return value
    "{pkg_bytes_text(bytes, 0, authority_start)}{pkg_binder_tail(authority, at + 1)}{pkg_bytes_text(bytes, authority_end, bytes.len())}"
}

pkg_bad_dep_value: fn(name: String, value: String) -> PackageParseError Never! {
    PackageParseError.Composition("dependency `{name}` has value `{value}`, which is not a `name#version`, bare path, `target@provider` ref, foreign `lang@\"ref\"`, or inline git struct")
}

pkg_dep_ref_error: fn(name: String, error: RefError) -> PackageParseError Never! {
    PackageParseError.Composition("dependency `{name}`'s ref is invalid: {pkg_ref_error_debug(error)}")
}

// The derived `Debug` spelling of a `RefError`.
pkg_ref_error_debug: fn(error: RefError) -> String Never! {
    if error == {
        .MissingSeparator(raw) -> "MissingSeparator({pkg_debug_str(raw)})"
        .EmptyHalf(raw) -> "EmptyHalf({pkg_debug_str(raw)})"
        .Malformed(raw) -> "Malformed({pkg_debug_str(raw)})"
        .UnknownSource(source, raw, declared) -> "UnknownSource {{ source: {pkg_debug_str(source)}, raw: {pkg_debug_str(raw)}, declared: {pkg_debug_str_list(declared)} }}"
        .AmbiguousBare(raw) -> "AmbiguousBare({pkg_debug_str(raw)})"
        .AmbiguousMember(query, candidates) -> "AmbiguousMember {{ query: {pkg_debug_str(query)}, candidates: {pkg_debug_str_list(candidates)} }}"
        .UnknownMember(query, suggestions) -> "UnknownMember {{ query: {pkg_debug_str(query)}, suggestions: {pkg_debug_str_list(suggestions)} }}"
    }
}

// One `deps: { … }` block: each entry's source, and the settings a record
// entry gives the dependency (`tool: { path: ../tool, settings: { loud: true } }`),
// by dependency name. An entry without `settings:` has no row.
ParsedDeps: struct {
    sources: [String:DepSource],
    settings: [String:[ManifestEntry]],
}

// One record entry: its source and the settings it gives the dependency.
DepRecord: struct {
    source: DepSource,
    settings: [ManifestEntry],
}

pkg_parse_deps: fn(body: String) -> ParsedDeps PackageParseError! {
    deps := [String:DepSource]{}
    settings := [String:[ManifestEntry]]{}
    loop entry in pkg_key_value_entries(body) {
        name: entry.key
        if !pkg_validate_dependency_name(name) {
            return Err(PackageParseError.Composition("dependency name `{name}` must be one safe path component"))
        }
        if deps.has_key(name) {
            return Err(PackageParseError.Composition("dependency `{name}` is declared more than once"))
        }
        trimmed: entry.value.trim()
        if trimmed.starts_with("{{") {
            record: pkg_parse_dep_record(name, pkg_record_body(trimmed, "deps.{name}"))
            deps[name] = record.source
            if record.settings.len() > 0 -> settings[name] = record.settings
            next
        }
        deps[name] = pkg_parse_dep_value(name, trimmed)
    }
    Ok(ParsedDeps{sources: deps, settings: settings})
}

// Classify one non-record dependency value: native C link, foreign
// namespace, source ref or bare path, `name#selector`, or quoted selector.
pkg_parse_dep_value: fn(name: String, trimmed: String) -> DepSource PackageParseError! {
    if pkg_parse_c_lib_ref(trimmed) == {
        .Val(target) -> return Ok(DepSource.CLib{target: target})
        .None -> {}
    }
    if pkg_parse_foreign_ref(name, trimmed) == {
        .Val(foreign) -> return Ok(foreign)
        .None -> {}
    }
    // Bare legacy tokens and the ratified quoted spelling read the same.
    unquoted: pkg_unquote(trimmed)
    if pkg_is_bare_path(unquoted) || unquoted.contains(REF_PROVIDER_AT) {
        if ProviderRef.classify(unquoted) == {
            .Ok(parsed) -> return Ok(DepSource.Provider{provider: parsed.provider, target: parsed.target})
            .Err(error) -> return Err(pkg_dep_ref_error(name, error))
        }
    }
    if unquoted.split_once("#") == {
        .Val(parts) -> {
            if parts.before == name && parts.after != "" {
                return Ok(DepSource.Version(parts.after))
            }
            return Err(pkg_bad_dep_value(name, trimmed))
        }
        .None -> {}
    }
    // A bare quoted string with no `#`/`@`/path shape is a plain version
    // selector (`deps: { httpkit: "^2" }`).
    if trimmed.starts_with("\"") -> return Ok(DepSource.Version(unquoted))
    Err(pkg_bad_dep_value(name, trimmed))
}

// Dependency names become directory names in the store and build tree, so
// the package model keeps them one safe path component.
pkg_validate_dependency_name: fn(name: String) -> Bool Never! {
    name != "" && name != "." && name != ".." && !name.contains("/") && !name.contains("\\") && !name.contains(":") && !pkg_text_has_control(name)
}

// A native C-library link ref: `c@system` or `c@"vendor/path"`.
pkg_parse_c_lib_ref: fn(value: String) -> String? Never! {
    parts: value.split_once(REF_PROVIDER_AT) ?? return None
    if parts.before.trim() != DEP_PROVIDER_C -> return None
    Val(pkg_unquote(parts.after))
}

// The project-tier shape `lang@"provider ref"`; C stays owned by
// the native `c@target` form.
pkg_parse_foreign_ref: fn(name: String, value: String) -> DepSource? PackageParseError! {
    parts: value.split_once(REF_PROVIDER_AT) ?? return Ok(None)
    language: pkg_foreign_language(parts.before.trim()) ?? return Ok(None)
    if language == C_MODULE_ROOT -> return Ok(None)
    reference: parts.after.trim()
    if !reference.starts_with("\"") || !reference.ends_with("\"") {
        return Err(PackageParseError.Composition("foreign dependency `{name}` must quote its provider ref as `{language}@\"ref\"`"))
    }
    unquoted: pkg_unquote(reference)
    if unquoted.trim() == "" {
        return Err(PackageParseError.Composition("foreign dependency `{name}` has an empty provider ref"))
    }
    Ok(Val(DepSource.Foreign{language: language, reference: unquoted}))
}

// A record entry: exactly one source, `path: ../tool`, `git: "<url>"` with
// exactly one of `tag`/`branch`/`rev`, or `version: "^2"`, and an optional
// `settings: { name: value }` giving the dependency's declared settings
// values. Any other field is refused, so a misspelled one is never dropped.
pkg_parse_dep_record: fn(name: String, body: String) -> DepRecord PackageParseError! {
    path := String?{None}
    url := String?{None}
    version := String?{None}
    tag_value := String?{None}
    branch_value := String?{None}
    rev_value := String?{None}
    settings := [ManifestEntry]{}
    seen := [String]{}
    loop entry in pkg_key_value_entries(body) {
        if seen.contains(entry.key) {
            return Err(PackageParseError.Composition("dependency `{name}.{entry.key}` is declared more than once"))
        }
        seen.push(entry.key)
        value: pkg_unquote(entry.value)
        if entry.key == {
            "path" -> path = Val(value)
            "git" -> url = Val(value)
            "version" -> version = Val(value)
            "tag" -> tag_value = Val(value)
            "branch" -> branch_value = Val(value)
            "rev" -> rev_value = Val(value)
            "settings" -> settings = pkg_parse_dep_settings(name, entry.value)
            else -> {
                return Err(PackageParseError.Composition("dependency `{name}` has unknown field `{entry.key}`; a dependency record takes `path`, `git` with `tag`, `branch` or `rev`, `version`, and `settings`"))
            }
        }
    }
    sources: (if path == None -> 0 else -> 1) + (if url == None -> 0 else -> 1) + (if version == None -> 0 else -> 1)
    if sources != 1 {
        return Err(PackageParseError.Composition("dependency `{name}` needs exactly one of `path`, `git`, `version`"))
    }
    selectors := [GitSelector]{}
    if tag_value == .Val(value) -> selectors.push(GitSelector.Tag(value))
    if branch_value == .Val(value) -> selectors.push(GitSelector.Branch(value))
    if rev_value == .Val(value) -> selectors.push(GitSelector.Rev(value))
    if url == .Val(found_url) {
        if selectors.len() != 1 {
            return Err(PackageParseError.Composition("git dependency `{name}` must have exactly one of `tag`, `branch`, `rev`"))
        }
        return Ok(DepRecord{source: DepSource.Git{url: found_url, selector: selectors[0]}, settings: settings})
    }
    if selectors.len() > 0 {
        return Err(PackageParseError.Composition("dependency `{name}` gives `tag`, `branch` or `rev` without `git:`"))
    }
    if version == .Val(selector) {
        if selector.trim() == "" {
            return Err(PackageParseError.Composition("dependency `{name}` has an empty `version:`"))
        }
        return Ok(DepRecord{source: DepSource.Version(selector), settings: settings})
    }
    target: path ?? ""
    if !pkg_is_bare_path(target) {
        return Err(PackageParseError.Composition("dependency `{name}` has `path: {target}`, which must start with `./`, `../` or `/`"))
    }
    if ProviderRef.classify(target) == {
        .Ok(parsed) -> Ok(DepRecord{source: DepSource.Provider{provider: parsed.provider, target: parsed.target}, settings: settings})
        .Err(error) -> Err(pkg_dep_ref_error(name, error))
    }
}

// `settings: { loud: true }` on a dependency entry: each setting's name and
// its value as written. The compiler checks them against the settings the
// dependency declares.
pkg_parse_dep_settings: fn(name: String, value: String) -> [ManifestEntry] PackageParseError! {
    settings := [ManifestEntry]{}
    loop entry in pkg_key_value_entries(pkg_record_body(value, "deps.{name}.settings")) {
        if !pkg_is_ascii_identifier(entry.key) {
            return Err(PackageParseError.Composition("dependency `{name}` gives setting `{entry.key}`, which is not a setting name"))
        }
        if entry.value == "" {
            return Err(PackageParseError.Composition("dependency `{name}`'s setting `{entry.key}` needs a value"))
        }
        loop known in settings {
            if known.key == entry.key {
                return Err(PackageParseError.Composition("dependency `{name}`'s setting `{entry.key}` is given more than once"))
            }
        }
        settings.push(entry)
    }
    Ok(settings)
}
