// `test: { … }` named test profiles and `suites: { … }` stock test suites:
// `quick: TestProfile{ suites: [tests], time_limit: 60s }`
// and `golden: TestSuite{ golden_corpus: "tests/golden" }`. `tests`, every
// #Test of the package, is the built-in suite; a stock suite is a golden, ui
// or cases corpus (`golden_corpus`, `ui_corpus`, `cases_corpus`). A profile
// carries `baseline`, the `ID<TAB>card<TAB>reason` ledger of rows accepted as
// failing, and any `jet test` setting by its row name (jet_foundation
// Registry/TestSettings.jet: `shard: 2/4`, `optimize: [none, full]`,
// `filter: "E01"`, `jobs: 8`, `memory: 16gib`, …), its lowest layer. Test and
// build profile names share one namespace, and `defaults: { test: <profile> }`
// picks the profile a bare `jet test` runs.
use {
    jet_foundation.[JET_TEST_SETTINGS, TestSetting, TestSettingKind, test_setting_hint, test_setting_row, test_setting_value, test_settings_get]
    jet_lexer.[TOKEN_COLON, TOKEN_DOT, TOKEN_IDENT, TOKEN_LPAREN, TOKEN_STRING, lex]
}

TEST_PROFILE_CTOR: "TestProfile"
TEST_SUITE_CTOR: "TestSuite"
// The built-in suite: every #Test of the package.
TEST_SUITE_TESTS: "tests"
// The file whose `test: fn` declares the package's code suites.
TEST_CODE_SUITES_FILE: "test.jet"
// The build profiles every package has without declaring them.
TEST_STOCK_BUILD_PROFILES: [String]{"debug", "release", "ci", "hardened"}

// One named test profile declared in `test: { … }`.
TestProfileDef: struct {
    name: String
    // The suites it runs, in order.
    suites: [String]
    // The accepted-failing ledger, relative to package.jet; None is none.
    baseline: String?{None}
    // The `jet test` settings it writes, each from `profile `<name>``.
    settings: [TestSetting]{[TestSetting]{}}
}

// What a stock suite's corpus holds.
TestSuiteKind: enum {
    Golden
    UI
    Cases
}

impl TestSuiteKind {
    // The suite's name in its rows: golden, ui or cases.
    as_str: fn(self) -> String Never! {
        if self == {
            .Golden -> "golden"
            .UI -> "ui"
            .Cases -> "cases"
        }
    }
}

// One stock suite declared in `suites: { … }`: a corpus directory, relative
// to package.jet, and what it holds.
TestSuiteDef: struct {
    name: String
    kind: TestSuiteKind
    corpus: String
}

// The `{ … }` body of `Ctor{ … }` or of a bare `{ … }`.
pkg_test_record: fn(value: String, ctor: String, site: String) -> String PackageParseError! {
    text: value.trim()
    rest: if text.starts_with(ctor) -> text.removeprefix(ctor).trim() else -> text
    body: pkg_strip_wrapped(rest, "{{", "}}") ?? return Err(PackageParseError.Composition("{site} needs a `{ctor}{{ … }}` value"))
    Ok(body)
}

// Every profile of a `test: { … }` body, in declaration order.
pkg_parse_test_profiles: fn(body: String) -> [TestProfileDef] PackageParseError! {
    profiles := [TestProfileDef]{}
    loop entry in pkg_key_value_entries(body) {
        repeated: entry.key.copy()
        if profiles.any(profile -> profile.name == repeated) -> return Err(PackageParseError.Composition("test profile `{entry.key}` is declared more than once"))
        profiles.push(pkg_parse_test_profile(entry.key, entry.value))
    }
    Ok(profiles)
}

pkg_parse_test_profile: fn(name: String, value: String) -> TestProfileDef PackageParseError! {
    site: "test profile `{name}`"
    source: "profile `{name}`"
    profile := TestProfileDef{name: name, suites: [String]{}}
    seen := [String]{}
    loop field in pkg_key_value_entries(pkg_test_record(value, TEST_PROFILE_CTOR, site)) {
        if seen.contains(field.key) -> return Err(PackageParseError.Composition("{site} declares `{field.key}` more than once"))
        seen.push(field.key)
        if field.key == {
            "suites" -> profile.suites = pkg_test_names(field.value, "{site} field `suites`")
            "baseline" -> {
                path: pkg_unquote(field.value)
                if path == "" -> return Err(PackageParseError.Composition("{site} needs `baseline:` as a quoted ledger path"))
                profile.baseline = Val(path)
            }
            else -> {
                row: test_setting_row(field.key) ?? return Err(PackageParseError.Composition("{site} has an unknown field `{field.key}` (allowed: {pkg_test_profile_fields()})"))
                if !row.ported -> return Err(PackageParseError.Composition("{site} field `{field.key}` is not ported to the Jet test runner yet"))
                raw: if row.kind == TestSettingKind.Text || row.kind == TestSettingKind.Path -> pkg_unquote(field.value) else -> field.value.trim()
                setting: test_setting_value(row, raw) ?? return Err(PackageParseError.Composition("{site} needs `{field.key}:` as {test_setting_hint(row)}"))
                profile.settings.push(TestSetting{name: row.name.copy(), value: setting, source: source.copy()})
            }
        }
    }
    if profile.suites.len() == 0 -> return Err(PackageParseError.Composition("{site} needs `suites: [ … ]` naming at least one suite"))
    Ok(profile)
}

// The fields a `TestProfile{ … }` takes: its own, then each ported setting row.
pkg_test_profile_fields: fn() -> String Never! {
    names := [String]{"suites", "baseline"}
    loop row in JET_TEST_SETTINGS {
        if row.ported -> names.push(row.name.copy())
    }
    names.join(", ")
}

// The bare names of a `[a, b]` list, each at most once; at least one.
pkg_test_names: fn(value: String, site: String) -> [String] PackageParseError! {
    text: value.trim()
    if !text.starts_with("[") || !text.ends_with("]") -> return Err(PackageParseError.Composition("{site} needs a list such as `[tests]`"))
    names := [String]{}
    loop name in pkg_parse_list(text) {
        if names.contains(name) -> return Err(PackageParseError.Composition("{site} lists `{name}` more than once"))
        names.push(name)
    }
    if names.len() == 0 -> return Err(PackageParseError.Composition("{site} needs a list such as `[tests]`"))
    Ok(names)
}

// Every suite of a `suites: { … }` body, in declaration order.
pkg_parse_test_suites: fn(body: String) -> [TestSuiteDef] PackageParseError! {
    suites := [TestSuiteDef]{}
    loop entry in pkg_key_value_entries(body) {
        site: "test suite `{entry.key}`"
        if entry.key == TEST_SUITE_TESTS -> return Err(PackageParseError.Composition("{site} is built in: it is every #Test of the package, so `suites:` can't declare it"))
        repeated: entry.key.copy()
        if suites.any(suite -> suite.name == repeated) -> return Err(PackageParseError.Composition("{site} is declared more than once"))
        found := TestSuiteDef?{None}
        loop field in pkg_key_value_entries(pkg_test_record(entry.value, TEST_SUITE_CTOR, site)) {
            kind: pkg_test_suite_kind(field.key) ?? return Err(PackageParseError.Composition("{site} has an unknown field `{field.key}` (allowed: golden_corpus, ui_corpus, cases_corpus)"))
            if found != None -> return Err(PackageParseError.Composition("{site} declares more than one corpus; a suite is one golden_corpus, ui_corpus or cases_corpus"))
            path: pkg_unquote(field.value)
            if path == "" -> return Err(PackageParseError.Composition("{site} needs `{field.key}:` as a directory path"))
            found = Val(TestSuiteDef{name: entry.key.copy(), kind: kind, corpus: path})
        }
        suites.push(found ?? return Err(PackageParseError.Composition("{site} needs `golden_corpus:`, `ui_corpus:` or `cases_corpus:` naming its directory")))
    }
    Ok(suites)
}

// The suite kind a corpus field names: `golden_corpus`, `ui_corpus` or `cases_corpus`.
pkg_test_suite_kind: fn(key: String) -> TestSuiteKind? {
    if key == {
        "golden_corpus" -> Val(TestSuiteKind.Golden)
        "ui_corpus" -> Val(TestSuiteKind.UI)
        "cases_corpus" -> Val(TestSuiteKind.Cases)
        else -> None
    }
}

impl PackageFacts {
    // No test profile shares a name with a build profile. The suites a
    // profile names are checked by `test_suites_refusal`, which also needs
    // the code suites `test: fn` declares in test.jet.
    validate_test_profiles: fn(self) PackageParseError! {
        loop profile in self.test_profiles {
            clash: profile.name.copy()
            if TEST_STOCK_BUILD_PROFILES.contains(profile.name) || self.build_profiles.any(build -> build.name == clash) {
                return Err(PackageParseError.Composition("test profile `{profile.name}` has the name of a build profile; test and build profiles share one namespace, so rename one"))
            }
        }
    }

    // Why the suites don't line up, None when they do: a code suite
    // (`t.suite("perf", …)` in test.jet's `test: fn`, listed in `code_suites`)
    // shares a name with `tests` or a `suites:` entry, or a profile names a
    // suite neither declares.
    test_suites_refusal: fn(self, code_suites: [String]) -> String? Never! {
        known := [String]{TEST_SUITE_TESTS}
        loop suite in self.test_suites -> known.push(suite.name)
        loop code in code_suites {
            if known.contains(code) {
                where: if code == TEST_SUITE_TESTS -> "as the built-in suite of every #Test" else -> "in `suites:` of package.jet"
                return Val("test suite `{code}` is declared twice: {where}, and by `t.suite(\"{code}\", …)` in test.jet; a suite has one name")
            }
        }
        loop code in code_suites -> known.push(code.copy())
        loop profile in self.test_profiles {
            loop suite in profile.suites {
                if !known.contains(suite) -> return Val("test profile `{profile.name}` names unknown suite `{suite}` (known: {known.join(", ")})")
            }
        }
        None
    }

    // The test profile `name`, if this package declares one.
    test_profile: fn(self, name: String) -> TestProfileDef? Never! {
        loop profile in self.test_profiles {
            if profile.name == name -> return Val(profile)
        }
        None
    }

    // The stock suite `name`, if this package declares one.
    test_suite: fn(self, name: String) -> TestSuiteDef? Never! {
        loop suite in self.test_suites {
            if suite.name == name -> return Val(suite)
        }
        None
    }
}

// The code suites a test.jet declares: the literal name of each
// `.suite("name", …)` call, in source order. Sema refuses a computed name
// (E0635), so the tokens hold every one without running code.
pkg_test_code_suites: fn(source: String) -> [String] Never! {
    lexed: lex(source.bytes())
    names := [String]{}
    if lexed.tokens.len() < 4 -> return names
    loop index in 1..<lexed.tokens.len() {
        if index + 2 >= lexed.tokens.len() -> break
        method: lexed.tokens[index]
        literal: lexed.tokens[index + 2]
        if method.kind != TOKEN_IDENT || lexed.tokens[index - 1].kind != TOKEN_DOT || lexed.tokens[index + 1].kind != TOKEN_LPAREN || literal.kind != TOKEN_STRING -> next
        if pkg_test_source_bytes(source, method.span.start, method.span.end) != "suite" -> next
        name: pkg_test_source_bytes(source, literal.span.start + 1, literal.span.end - 1)
        if name != "" && !names.contains(name) -> names.push(name)
    }
    names
}

// Whether a test.jet sets a `jet test` setting: a `<t>.<setting>(` call on
// a `<t>: Test` parameter, whose name is a setting row. Only such a test.jet
// runs `jet test`'s plan step (JetCli TestSettingLayers.jet).
pkg_test_sets_settings: fn(source: String) -> Bool Never! {
    lexed: lex(source.bytes())
    tokens: lexed.tokens
    params := [String]{}
    loop index in 0..<tokens.len() {
        if index + 2 >= tokens.len() -> break
        if tokens[index].kind != TOKEN_IDENT || tokens[index + 1].kind != TOKEN_COLON || tokens[index + 2].kind != TOKEN_IDENT -> next
        if pkg_test_source_bytes(source, tokens[index + 2].span.start, tokens[index + 2].span.end) != "Test" -> next
        params.push(pkg_test_source_bytes(source, tokens[index].span.start, tokens[index].span.end))
    }
    if params.len() == 0 -> return false
    loop index in 0..<tokens.len() {
        if index + 3 >= tokens.len() -> break
        if tokens[index].kind != TOKEN_IDENT || tokens[index + 1].kind != TOKEN_DOT || tokens[index + 2].kind != TOKEN_IDENT || tokens[index + 3].kind != TOKEN_LPAREN -> next
        if !params.contains(pkg_test_source_bytes(source, tokens[index].span.start, tokens[index].span.end)) -> next
        if test_setting_row(pkg_test_source_bytes(source, tokens[index + 2].span.start, tokens[index + 2].span.end)) != None -> return true
    }
    false
}

pkg_test_source_bytes: fn(source: String, start: Int, end: Int) -> String Never! {
    if start < 0 || end < start || end > source.count_bytes() -> return ""
    String.from_bytes(source.bytes().slice(start, end)) ?? ""
}

// The refusal of a `test:` body, "" when it parses.
pkg_test_profiles_refusal: fn(body: String) -> String Never! {
    if pkg_parse_test_profiles(body) == {
        .Ok(_) -> ""
        .Err(error) -> error.message()
    }
}

// The refusal of a `suites:` body, "" when it parses.
pkg_test_suites_refusal: fn(body: String) -> String Never! {
    if pkg_parse_test_suites(body) == {
        .Ok(_) -> ""
        .Err(error) -> error.message()
    }
}

#Test("test profiles parse suites and their settings in order") {
    profiles: pkg_parse_test_profiles(`quick: TestProfile{ suites: [tests], time_limit: 60s }, full: TestProfile{ suites: [tests, golden], optimize: [none, full] }`) ?? panic(err.message())
    assert_eq(profiles.len(), 2)
    assert_eq(profiles[0].name, "quick")
    assert_eq(profiles[0].suites, [String]{"tests"})
    assert_eq(test_settings_get(profiles[0].settings, "time_limit") ?? "", "60000ms")
    assert_eq(profiles[0].settings[0].source, "profile `quick`")
    assert(test_settings_get(profiles[0].settings, "optimize") == None)
    assert_eq(profiles[1].suites, [String]{"tests", "golden"})
    assert_eq(test_settings_get(profiles[1].settings, "optimize") ?? "", "none,full")
}

#Test("test profile fields refuse unknown fields, bad values and empty suites") {
    assert_eq(pkg_test_profiles_refusal(`quick: TestProfile{ suites: [tests], workers: 4 }`), "test profile `quick` has an unknown field `workers` (allowed: suites, baseline, fresh, docs, filter, capture, update_snapshots, shuffle, serial, measure, trace_tiers, optimize, time_limit, opt_in, shard, list, cases, jobs, memory, allow_shrink, diagnostic_coverage, results, compiler, jetpack)")
    assert_eq(pkg_test_profiles_refusal(`quick: TestProfile{ suites: [tests], coverage: true }`), "test profile `quick` field `coverage` is not ported to the Jet test runner yet")
    assert_eq(pkg_test_profiles_refusal(`quick: TestProfile{ suites: [tests], jobs: 0 }`), "test profile `quick` needs `jobs:` as a whole number of at least 1")
    assert_eq(pkg_test_profiles_refusal(`quick: TestProfile{ suites: [tests], memory: lots }`), "test profile `quick` needs `memory:` as a positive size such as `16G`, `8gib` or `512mib`")
    assert_eq(pkg_test_profiles_refusal(`quick: TestProfile{ suites: [tests], shard: 3/2 }`), "test profile `quick` needs `shard:` as I/N with 1 <= I <= N, such as `2/4`")
    assert_eq(pkg_test_profiles_refusal(`quick: TestProfile{ suites: [tests], opt_in: yes }`), "test profile `quick` needs `opt_in:` as true or false")
    assert_eq(pkg_test_profiles_refusal(`quick: TestProfile{ suites: [tests], optimize: [fast] }`), "test profile `quick` needs `optimize:` as optimize levels from none, basic and full, each at most once")
    assert_eq(pkg_test_profiles_refusal(`quick: TestProfile{ suites: [tests], time_limit: 0s }`), "test profile `quick` needs `time_limit:` as a positive duration such as `60s`, `1500ms` or `2m`")
    assert_eq(pkg_test_profiles_refusal(`quick: TestProfile{ time_limit: 60s }`), "test profile `quick` needs `suites: [ … ]` naming at least one suite")
    assert_eq(pkg_test_profiles_refusal(`quick: TestProfile{ suites: tests }`), "test profile `quick` field `suites` needs a list such as `[tests]`")
}

#Test("test profiles carry a baseline and any setting row") {
    profiles: pkg_parse_test_profiles(`ui: TestProfile{ suites: [ui], jobs: 8, memory: 12gib, filter: "tests/ui/E01", shard: 2/4, opt_in: true, results: "ui.json", list: true, baseline: "baseline.tsv" }`) ?? panic(err.message())
    profile: profiles[0]
    assert_eq(test_settings_get(profile.settings, "jobs") ?? "", "8")
    assert_eq(test_settings_get(profile.settings, "memory") ?? "", "{12 * 1073741824}")
    assert_eq(test_settings_get(profile.settings, "filter") ?? "", "tests/ui/E01")
    assert_eq(test_settings_get(profile.settings, "shard") ?? "", "2/4")
    assert_eq(test_settings_get(profile.settings, "opt_in") ?? "", "true")
    assert_eq(test_settings_get(profile.settings, "results") ?? "", "ui.json")
    assert_eq(test_settings_get(profile.settings, "list") ?? "", "true")
    assert_eq(profile.baseline ?? "", "baseline.tsv")
    plain: (pkg_parse_test_profiles(`quick: TestProfile{ suites: [tests] }`) ?? panic(err.message()))[0]
    assert_eq(plain.settings.len(), 0)
    assert(plain.baseline == None)
}

#Test("stock suites name a golden, ui or cases corpus, and tests is built in") {
    suites: pkg_parse_test_suites(`golden: TestSuite{ golden_corpus: "tests/golden" }, ui: TestSuite{ ui_corpus: "tests/ui" }, cases: TestSuite{ cases_corpus: "tests/cases" }`) ?? panic(err.message())
    assert_eq(suites.len(), 3)
    assert_eq(suites[0].name, "golden")
    assert_eq(suites[0].corpus, "tests/golden")
    assert_eq(suites[0].kind.as_str(), "golden")
    assert_eq(suites[1].kind.as_str(), "ui")
    assert_eq(suites[2].kind.as_str(), "cases")
    assert_eq(suites[2].corpus, "tests/cases")
    assert_eq(pkg_test_suites_refusal(`ui: TestSuite{ lint_corpus: "tests/ui" }`), "test suite `ui` has an unknown field `lint_corpus` (allowed: golden_corpus, ui_corpus, cases_corpus)")
    assert_eq(pkg_test_suites_refusal(`ui: TestSuite{ ui_corpus: "tests/ui", cases_corpus: "tests/cases" }`), "test suite `ui` declares more than one corpus; a suite is one golden_corpus, ui_corpus or cases_corpus")
    assert_eq(pkg_test_suites_refusal(`ui: TestSuite{ }`), "test suite `ui` needs `golden_corpus:`, `ui_corpus:` or `cases_corpus:` naming its directory")
    assert_eq(pkg_test_suites_refusal(`tests: TestSuite{ golden_corpus: "t" }`), "test suite `tests` is built in: it is every #Test of the package, so `suites:` can't declare it")
}

#Test("a profile's suites are tests, stock suites or the code suites of test.jet, each named once") {
    facts: PackageFacts.parse("name: \"demo\"\nsuites: {{ golden: TestSuite{{ golden_corpus: \"g\" }} }}\ntest: {{ full: TestProfile{{ suites: [tests, golden, perf] }} }}\n", "package.jet") ?? panic(err.message())
    assert(facts.test_suites_refusal([String]{"perf"}) == None)
    assert_eq(facts.test_suites_refusal([String]{}) ?? "", "test profile `full` names unknown suite `perf` (known: tests, golden)")
    assert_eq(facts.test_suites_refusal([String]{"golden", "perf"}) ?? "", "test suite `golden` is declared twice: in `suites:` of package.jet, and by `t.suite(\"golden\", …)` in test.jet; a suite has one name")
    assert_eq(facts.test_suites_refusal([String]{"tests"}) ?? "", "test suite `tests` is declared twice: as the built-in suite of every #Test, and by `t.suite(\"tests\", …)` in test.jet; a suite has one name")
}

#Test("code suites are the literal names of `.suite(` calls") {
    source: "test: fn(t: Test) -> Int {{\n    t.suite(\"perf\", perf_rows)\n    t.suite(\"selfhost\", rows -> rows.pass(\"x\"))\n    suite(\"no\")\n    t.run()\n}}\n"
    assert_eq(pkg_test_code_suites(source), [String]{"perf", "selfhost"})
    assert_eq(pkg_test_code_suites(""), [String]{})
}

#Test("test.jet sets settings only through calls on its Test parameter") {
    assert(pkg_test_sets_settings("test: fn(t: Test) -> Int {{\n    t.shard(3, 8)\n    t.run()\n}}\n"))
    assert(pkg_test_sets_settings("test: fn(suite: Test) -> Int {{\n    suite.results(\"r.json\")\n    suite.run()\n}}\n"))
    assert(!pkg_test_sets_settings("test: fn(t: Test) -> Int {{\n    xs.filter(x -> x > 1)\n    t.suite(\"perf\", rows)\n    t.run()\n}}\n"))
    assert(!pkg_test_sets_settings(""))
}
