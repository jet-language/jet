// Package discovery (U10) (Package/Discovery.rs):
// resolve a package name to the directory of the unique `.jet` file that
// declares `<name>: module` at the top level, and project `#Job` declarations
// into the shared job registry.
use {
    jetpack_foundation.[KW_MODULE, PACKAGE_FILE]
    jet_foundation.[Diagnostic, Item, JobRegistry]
    jet_lexer.[lex]
    jet_parser.[parse_lexed]
}

// Why discovering a package's module failed (U10).
#Error
DiscoveryError: enum {
    // No source file declares `module <name>`.
    NotFound(name: String)
    // Several files declare `module <name>` (paths relative to the root).
    Ambiguous(name: String, paths: [String])
}

// The directory holding the one file declaring `module <name>`. An explicit
// named lookup, so does not filter `_name`.
pkg_discover_module_in: fn(root: String, name: String) -[FS, Env]> String DiscoveryError! {
    resolver: AuthorityResolver.open(root) ?? return Err(DiscoveryError.NotFound{name: name})
    listed: resolver.discover_source_files() ?? return Err(DiscoveryError.NotFound{name: name})
    matches := [String]{}
    loop file in listed {
        file_name: pkg_path_file_name(file.relative)
        if file_name == PACKAGE_FILE -> next
        text: file.text() ?? next
        if pkg_file_declares_module(text, name) {
            if resolver.revalidate_file(file) == .Err(_) -> return Err(DiscoveryError.NotFound{name: name})
            matches.push(file.path)
        }
    }
    if resolver.revalidate_root() == .Err(_) -> return Err(DiscoveryError.NotFound{name: name})
    if matches.len() == {
        0 -> Err(DiscoveryError.NotFound{name: name})
        1 -> {
            parent: pkg_path_parent(matches[0])
            Ok(if parent == "" -> root else -> parent)
        }
        else -> {
            prefix: "{resolver.root}/"
            relative := [String]{}
            loop path in matches -> relative.push(if path.starts_with(prefix) -> path.removeprefix(prefix) else -> path)
            Err(DiscoveryError.Ambiguous{name: name, paths: relative})
        }
    }
}

// Why the job registry could not be projected (Rust `String` errors).
#Error
JobDiscoveryError: struct {
    message: String
}

// Parse every checked source file below `root` and project its `#Job`
// declarations, in sorted relative-path order; metadata files are skipped.
pkg_discover_jobs_in: fn(root: String) -[FS, Env]> JobRegistry JobDiscoveryError! {
    resolver: if AuthorityResolver.open(root) == {
        .Ok(opened) -> opened
        .Err(error) -> {
            return Err(JobDiscoveryError{message: error.message()})
        }
    }
    listed: if resolver.discover_source_files() == {
        .Ok(found) -> found
        .Err(error) -> {
            return Err(JobDiscoveryError{message: error.message()})
        }
    }
    job_items := [Item]{}
    loop file in listed {
        file_name: pkg_path_file_name(file.relative)
        if file_name == PACKAGE_FILE -> next
        text: if file.text() == {
            .Ok(read) -> read
            .Err(error) -> {
                return Err(JobDiscoveryError{message: error.message()})
            }
        }
        masked: if pkg_mask_inline_package_source(text) == {
            .Ok(result) -> result.source
            .Err(error) -> {
                return Err(JobDiscoveryError{message: error.message()})
            }
        }
        lexed: lex(masked.bytes())
        if lexed.diagnostics.len() > 0 -> return Err(JobDiscoveryError{message: "{file.path}: lexer diagnostics: {pkg_diagnostic_codes(lexed.diagnostics)}"})
        parsed: parse_lexed(lexed)
        if parsed.diagnostics.len() > 0 -> return Err(JobDiscoveryError{message: "{file.path}: parser diagnostics: {pkg_diagnostic_codes(parsed.diagnostics)}"})
        loop item in parsed.program.items {
            if item == .Func(function) {
                if function.is_job -> job_items.push(item)
            }
        }
        if resolver.revalidate_file(file) == .Err(error) -> return Err(JobDiscoveryError{message: error.message()})
    }
    if resolver.revalidate_root() == .Err(error) -> return Err(JobDiscoveryError{message: error.message()})
    Ok(JobRegistry.from_items(job_items))
}

// `code: what` of each diagnostic, one per line.
pkg_diagnostic_codes: fn(diagnostics: [Diagnostic]) -> String Never! {
    lines := [String]{}
    loop diagnostic in diagnostics -> lines.push("{diagnostic.code}: {diagnostic.what}")
    lines.join("\n")
}

// Whether `text` declares `<name>: module` at brace depth 0 (line comments
// stripped; not a dotted `owner.<name>` head).
pkg_file_declares_module: fn(input: String, name: String) -> Bool Never! {
    bytes: pkg_strip_comments(input).bytes()
    keyword: KW_MODULE.bytes()
    wanted: name.bytes()
    depth := 0
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if code == 123 {
            depth += 1
            next
        }
        if code == 125 {
            if depth > 0 -> depth -= 1
            next
        }
        if depth != 0 || !pkg_bytes_starts_with(bytes, index, wanted) || pkg_bytes_is_word(pkg_bytes_code(bytes, index - 1)) || pkg_bytes_code(bytes, index - 1) == 46 -> next
        if pkg_bytes_colon_keyword_end(bytes, index + wanted.len(), keyword) >= 0 -> return true
    }
    false
}
