// The application-boundary effect projection (jet-pkg-model EffectBudget.rs
// `EffectProjection`, `project_*`, `application_policy_diagnostic`, and the
// summary renderers).
//
// Keep the four roles separate: `required_effects` is a sema fact;
// `granted_effects` and `denied_effects` are policy facts; `authority` names
// the policy source. Consumers never infer one role from another. Effect sets
// are sorted, duplicate-free `[String]` (Foundation `authority_holds`).
use {
    jet_foundation.[ApplicationAuthority, Diagnostic, authority_holds, diagnostic_from_registry, diagnostic_with_detail, diagnostic_with_rights]
    jetpack_foundation.[ReportError, StatusEnvelope]
}

EFFECT_AUTHORITY_PACKAGE: "package.jet authority"
EFFECT_AUTHORITY_PACKAGE_GRANTS: "package.jet authority.grants"
EFFECT_STATUS_ACTION: "build.effects"

// One checked program's application-boundary view.
EffectProjection: struct {
    required_effects: [String]
    granted_effects: [String]
    denied_effects: [String]
    authority: String

    // The beginner basics with no sema requirement yet (Rust `Default`).
    default: fn() -> EffectProjection Never! {
        basics: ApplicationAuthority.ambient_basics()
        EffectProjection{required_effects: [String]{}, granted_effects: basics.granted_effects, denied_effects: basics.denied_effects, authority: basics.authority}
    }

    // This checked application decision, carried into the execution bundle.
    application_authority: fn(self) -> ApplicationAuthority Never! {
        ApplicationAuthority{
            required_effects: self.required_effects,
            granted_effects: self.granted_effects,
            denied_effects: self.denied_effects,
            authority: self.authority
        }
    }

    // Required effects with no policy verdict at the application boundary.
    undecided: fn(self) -> [String] Never! {
        self.application_authority().undecided_effects()
    }

    is_allowed: fn(self) -> Bool Never! {
        self.application_authority().is_allowed()
    }
}

// The entry file of a program run without any Package manifest: its E1803
// Fix names the exact `--allow` invocation.
ScriptEntry: struct {
    path: String
    source: String
    // The `jet` command that ran the script (`run`, `build`).
    command: String
}

// Project the application policy without changing the sema effect fact. A
// manifest-less program, and a manifest that writes no `authority`
// (#3718), receive the beginner floor; a written allow row adds to that
// floor and a written deny row removes from it.
pkg_project_application_effects: fn(required_effects: [String], manifest: PackageFacts?) -> EffectProjection Never! {
    facts: manifest ?? return pkg_effect_floor_projection(required_effects, ApplicationAuthority.ambient_basics())
    if facts.authority.allow == None && facts.authority.deny == None {
        return pkg_effect_floor_projection(required_effects, ApplicationAuthority.package_default())
    }
    pkg_effect_floor_projection(required_effects, ApplicationAuthority.from_policy(facts.authority.allow, facts.authority.deny, EFFECT_AUTHORITY_PACKAGE))
}

pkg_effect_floor_projection: fn(required_effects: [String], floor: ApplicationAuthority) -> EffectProjection Never! {
    EffectProjection{required_effects: required_effects, granted_effects: floor.granted_effects, denied_effects: floor.denied_effects, authority: floor.authority}
}

// The projection of the exact selected entry, not the per-package aggregate.
pkg_project_program_effects: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String, manifest: PackageFacts?) -> EffectProjection Never! {
    pkg_project_application_effects(pkg_program_effects(program, summaries, default_entry), manifest)
}

// `Sema::show_set`: a set as `Net, FS.Read` in canonical order.
pkg_effect_show_set: fn(effects: [String]) -> String Never! {
    effects.join(", ")
}

pkg_effect_names_or_none: fn(effects: [String]) -> String Never! {
    if effects.len() == 0 -> return "none"
    pkg_effect_show_set(effects)
}

// E1803: the structured authority failure for JSON, redirected, and
// non-interactive invocations. The Why is one plain sentence; the role rows
// ride in structured detail for `--json`. A manifest-less `script` with
// undecided effects leads its Fix with the exact `--allow` command and its
// `-A` form. E1803 carries no edit: its registry row names no fix channel,
// and a denial is never repaired by a grant.
pkg_application_policy_diagnostic: fn(projection: EffectProjection, denied: [String], script: ScriptEntry?) -> Diagnostic Never! {
    missing: projection.undecided()
    authority: projection.application_authority()
    denied_required: authority.denied_required_effects()
    what: if denied_required.len() == 0 -> "application authority is undecided for `{pkg_effect_show_set(missing)}`" else -> "application authority denies `{pkg_effect_show_set(denied_required)}`"
    repair: script ?? {
        base: diagnostic_from_registry("E1803", None, what, authority.policy_why(), authority.policy_fix(""))
        return diagnostic_with_rights(diagnostic_with_detail(base, authority.policy_facts()), "authority", [String]{}, [String]{projection.authority}, None)
    }
    scripted: denied.len() == 0 && missing.len() > 0 && authority.is_application_default()
    fix: if scripted -> "run `jet {repair.command} --allow={missing.join(",")} {repair.path}` (or `-A`/`--allow-all` for every effect) to allow it for this run, or {authority.policy_fix(repair.path)}" else -> authority.policy_fix(repair.path)
    base: diagnostic_from_registry("E1803", None, what, authority.policy_why(), fix)
    diagnostic_with_rights(diagnostic_with_detail(base, authority.policy_facts()), "authority", [String]{}, [String]{projection.authority}, None)
}

// Every effect reachable from `entry` through statically known calls.
pkg_entry_effects: fn(summaries: [String: PackageEffectSummary], entry: String) -> [String] Never! {
    effects := [String]{}
    seen := [String: Bool]{}
    pending := [String]{entry}
    loop pending.len() > 0 {
        key: pending.pop() ?? break
        if seen.has_key(key) -> next
        seen[key] = true
        summary: summaries.get(key) ?? next
        loop effect_name in summary.direct -> effects.push(effect_name)
        loop edge in summary.edges -> pending.push(edge)
    }
    authority_holds(effects)
}

pkg_program_effects: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> [String] Never! {
    candidates: pkg_effect_entry_candidates(program, summaries, default_entry)
    if candidates.len() == 0 -> return [String]{}
    pkg_entry_effects(summaries, candidates[0])
}

pkg_render_effect_line: fn(effects: [String]) -> String Never! {
    if effects.len() == 0 -> return "effects: none"
    "effects: {effects.join(", ")}"
}

pkg_effect_texts: fn(effects: [String]) -> Dyn Never! {
    items := [Dyn]{}
    loop effect_name in effects -> items.push(Dyn.Text(effect_name))
    Dyn.Array(items)
}

pkg_render_effect_json: fn(effects: [String]) -> String ReportError! {
    StatusEnvelope.new(EFFECT_STATUS_ACTION, true).with_field("effects", pkg_effect_texts(effects)).json()
}

pkg_effect_summary_line_for_program: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> String Never! {
    pkg_render_effect_line(pkg_program_effects(program, summaries, default_entry))
}

pkg_effect_summary_json_for_program: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> String ReportError! {
    pkg_render_effect_json(pkg_program_effects(program, summaries, default_entry))
}

// Human application-boundary summary with explicit policy roles.
pkg_effect_summary_line_for_program_with_authority: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String, manifest: PackageFacts?) -> String Never! {
    pkg_render_effect_projection_line(pkg_project_program_effects(program, summaries, default_entry, manifest))
}

pkg_render_effect_projection_line: fn(projection: EffectProjection) -> String Never! {
    "required effects: {pkg_effect_names_or_none(projection.required_effects)}; granted effects: {pkg_effect_names_or_none(projection.granted_effects)}; denied effects: {pkg_effect_names_or_none(projection.denied_effects)}; authority: {projection.authority}"
}

// The JSON object embedded in semantic-index, dossier, and Canvas documents,
// so the four roles stay one shared projection.
pkg_render_effect_projection_object: fn(projection: EffectProjection) -> String Never! {
    required: pkg_render_quoted_list(projection.required_effects)
    granted: pkg_render_quoted_list(projection.granted_effects)
    denied: pkg_render_quoted_list(projection.denied_effects)
    "{{\"required_effects\":[{required}],\"granted_effects\":[{granted}],\"denied_effects\":[{denied}],\"authority\":{pkg_json_quote(projection.authority)}}}"
}

pkg_render_quoted_list: fn(values: [String]) -> String Never! {
    quoted := [String]{}
    loop value in values -> quoted.push(pkg_json_quote(value))
    quoted.join(",")
}

// Machine application-boundary summary. The legacy `effects` field stays for
// existing consumers; the role fields are the canonical view.
pkg_effect_summary_json_for_program_with_authority: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String, manifest: PackageFacts?) -> String ReportError! {
    pkg_render_effect_projection_json(pkg_project_program_effects(program, summaries, default_entry, manifest))
}

pkg_render_effect_projection_json: fn(projection: EffectProjection) -> String ReportError! {
    required: pkg_effect_texts(projection.required_effects)
    StatusEnvelope.new(EFFECT_STATUS_ACTION, true)
        .with_field("effects", required)
        .with_field("required_effects", required)
        .with_field("granted_effects", pkg_effect_texts(projection.granted_effects))
        .with_field("denied_effects", pkg_effect_texts(projection.denied_effects))
        .with_field("authority", Dyn.Text(projection.authority.copy()))
        .json()
}

// Human build status: effects reachable through statically known calls from
// the selected entry. Open function values stay conservative in enforcement
// but do not invent every ambient effect here.
pkg_effect_summary_line_for_entry: fn(summaries: [String: PackageEffectSummary], entry: String) -> String Never! {
    pkg_render_effect_line(pkg_entry_effects(summaries, entry))
}

pkg_effect_summary_json_for_entry: fn(summaries: [String: PackageEffectSummary], entry: String) -> String ReportError! {
    pkg_render_effect_json(pkg_entry_effects(summaries, entry))
}
