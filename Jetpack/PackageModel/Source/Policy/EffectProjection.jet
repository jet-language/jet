// The application-boundary effect projection (jet-pkg-model EffectBudget.rs
// `EffectProjection` and the summary renderers).
//
// Keep the four roles separate: `required_effects` is a sema fact;
// `granted_effects` and `denied_effects` are policy facts; `authority` names
// the policy source. Consumers never infer one role from another. Effect sets
// are sorted, duplicate-free `[String]` (Foundation `authority_holds`).
use {
    jet_foundation.[authority_holds]
    jetpack_foundation.[ReportError, StatusEnvelope]
}

EFFECT_AUTHORITY_PACKAGE: "package.jet authority"
EFFECT_AUTHORITY_PACKAGE_GRANTS: "package.jet authority.grants"
EFFECT_STATUS_ACTION: "build.effects"

// One checked program's application-boundary view.
EffectProjection: struct {
    required_effects: [String]
    granted_effects: [String]
    denied_effects: [String]
    authority: String
}

pkg_effect_names_or_none: fn(effects: [String]) -> String Never! {
    if effects.len() == 0 -> return "none"
    effects.join(", ")
}

// Every effect reachable from `entry` through statically known calls.
pkg_entry_effects: fn(summaries: [String: PackageEffectSummary], entry: String) -> [String] Never! {
    effects := [String]{}
    seen := [String: Bool]{}
    pending := [String]{entry}
    loop pending.len() > 0 {
        key: pending.pop() ?? break
        if seen.has_key(key) -> next
        seen[key] = true
        summary: summaries.get(key) ?? next
        loop effect_name in summary.direct -> effects.push(effect_name)
        loop edge in summary.edges -> pending.push(edge)
    }
    authority_holds(effects)
}

pkg_program_effects: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> [String] Never! {
    candidates: pkg_effect_entry_candidates(program, summaries, default_entry)
    if candidates.len() == 0 -> return [String]{}
    pkg_entry_effects(summaries, candidates[0])
}

pkg_render_effect_line: fn(effects: [String]) -> String Never! {
    if effects.len() == 0 -> return "effects: none"
    "effects: {effects.join(", ")}"
}

pkg_effect_texts: fn(effects: [String]) -> Dyn Never! {
    items := [Dyn]{}
    loop effect_name in effects -> items.push(Dyn.Text(effect_name))
    Dyn.Array(items)
}

pkg_render_effect_json: fn(effects: [String]) -> String ReportError! {
    StatusEnvelope.new(EFFECT_STATUS_ACTION, true).with_field("effects", pkg_effect_texts(effects)).json()
}

pkg_effect_summary_line_for_program: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> String Never! {
    pkg_render_effect_line(pkg_program_effects(program, summaries, default_entry))
}

pkg_effect_summary_json_for_program: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> String ReportError! {
    pkg_render_effect_json(pkg_program_effects(program, summaries, default_entry))
}

// Human application-boundary summary with explicit policy roles.
pkg_render_effect_projection_line: fn(projection: EffectProjection) -> String Never! {
    "required effects: {pkg_effect_names_or_none(projection.required_effects)}; granted effects: {pkg_effect_names_or_none(projection.granted_effects)}; denied effects: {pkg_effect_names_or_none(projection.denied_effects)}; authority: {projection.authority}"
}

// The JSON object embedded in semantic-index, dossier, and Canvas documents,
// so the four roles stay one shared projection.
pkg_render_effect_projection_object: fn(projection: EffectProjection) -> String Never! {
    pkg_json_render(Dyn.Object([
        "required_effects": pkg_json_texts(projection.required_effects),
        "granted_effects": pkg_json_texts(projection.granted_effects),
        "denied_effects": pkg_json_texts(projection.denied_effects),
        "authority": Dyn.Text(projection.authority.copy()),
    ]))
}

// Machine application-boundary summary. The legacy `effects` field stays for
// existing consumers; the role fields are the canonical view.
pkg_render_effect_projection_json: fn(projection: EffectProjection) -> String ReportError! {
    required: pkg_effect_texts(projection.required_effects)
    StatusEnvelope.new(EFFECT_STATUS_ACTION, true)
        .with_field("effects", required)
        .with_field("required_effects", required)
        .with_field("granted_effects", pkg_effect_texts(projection.granted_effects))
        .with_field("denied_effects", pkg_effect_texts(projection.denied_effects))
        .with_field("authority", Dyn.Text(projection.authority.copy()))
        .json()
}

// Human build status: effects reachable through statically known calls from
// the selected entry. Open function values stay conservative in enforcement
// but do not invent every ambient effect here.
pkg_effect_summary_line_for_entry: fn(summaries: [String: PackageEffectSummary], entry: String) -> String Never! {
    pkg_render_effect_line(pkg_entry_effects(summaries, entry))
}

pkg_effect_summary_json_for_entry: fn(summaries: [String: PackageEffectSummary], entry: String) -> String ReportError! {
    pkg_render_effect_json(pkg_entry_effects(summaries, entry))
}
