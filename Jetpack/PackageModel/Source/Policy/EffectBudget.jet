// (ratified 2026-07-01): the package effect budget
// (jet-pkg-model EffectBudget.rs).
//
// Zero-config: every `jet build` prints a one-line summary of the effects the
// dependency graph uses, and per-dependency provenance is recorded in the
// lockfile. An `authority: { allow: […], deny: […] }` block enforces
// the whole graph: a dependency outside it is E1220, and the root package's
// own code outside its written `allow` row is E0749, the ceiling a written
// row is (spec.md "Application authority"). `authority.grants` is the audited
// per-dependency escape, also recorded in the lockfile.
//
// Attribution walks sema's solved per-function effect fixpoint from the
// driver's selected entry, then attributes only reached functions to the
// package (root or a dependency) whose module defines them, matching each
// module's on-disk path against the loader's dependency roots.
use jet_foundation.[
    AUTHORITY_PANIC_ROOT, AuthorityVerdict, Diagnostic, Span, authority_answer,
    authority_covers, authority_covers_any, authority_holds, authority_is_deny_only, authority_parse_rights,
    authority_root, diagnostic_from_registry, diagnostic_with_rights, diagnostic_with_source_path, effect_scope_is_scoped,
]

EFFECT_ROOT_PACKAGE: "root"
EFFECT_PANIC_EDGE: "__jet_panic__"
EFFECT_BUILD_ENTRY: "build"

// Sema's per-function effect summary (Rust `Sema::EffectSummary`): the
// directly performed effects, the static call edges, and whether an open
// callee makes the function conservatively maximal.
PackageEffectSummary: struct {
    direct: [String]
    edges: [String]
    maximal: Bool
}

// A dependency import of the entry module and the root-side span where it
// crosses the budget boundary (`ImportKind::Module` name span, or the
// module-alias span of an unqualified import).
EffectBudgetImport: struct {
    name: String
    span: Span
}

// The selected runnable output of the entry module (`ConstDef.resolved_output`
// with `selected`): its defining module and semantic name.
EffectBudgetOutput: struct {
    module_index: Int
    semantic_name: String
}

// One loaded module as the budget reads it (Rust `LoadedModule`).
EffectBudgetModule: struct {
    path: String
    alias: String
    // `Sema::effect_key` of every function, method, and trait-impl method the
    // module defines, in item order.
    function_keys: [String]
    function_spans: [String: Span]
    imports: [EffectBudgetImport]
    // Whether the module declares the `build(Build)` entry.
    has_build_entry: Bool
}

// The checked program as the budget reads it (Rust `ProgramBundle`).
EffectBudgetProgram: struct {
    entry: Int
    modules: [EffectBudgetModule]
    // Dependency name -> its source root (`deps:` and hangar-realized `use`).
    dep_roots: [String: String]
    selected_output: EffectBudgetOutput?
}

EffectBudgetWitness: struct {
    path: String
    span: Span
}

// One package's (root, or a dependency) aggregated effects.
PackageEffects: struct {
    // `root` for the building package itself, else the dependency name.
    name: String
    effects: [String]
    // For each effect, one deterministic static call path from the first
    // reached function that reaches it down to the function that performs
    // it; the last entry is the effect's site (E1220, E0749).
    effect_chains: [String: [String]]
    effect_witnesses: [String: EffectBudgetWitness]
    // Function identities where a deniable Panic stop enters the graph.
    panic_sites: [String]
    // Root-side source location where a dependency crosses the boundary.
    boundary_span: Span?
}

// `Sema::effect_key`: `Type::name` for methods, the bare name otherwise.
pkg_effect_key: fn(owner_type: String?, name: String) -> String Never! {
    owner: owner_type ?? return name
    "{owner}::{name}"
}

// `Sema::memory_allocation_bound(name).is_some()` or `Mem.Rc`: memory rights
// are governed elsewhere and never budgeted here.
pkg_effect_is_memory_right: fn(name: String) -> Bool Never! {
    if name == "Mem.Rc" || name == "Mem.Alloc" -> return true
    if !name.starts_with("Mem.Alloc(") || !name.ends_with(")") -> return false
    args: name.removeprefix("Mem.Alloc(").removesuffix(")").trim()
    if !args.starts_with("above:") -> return false
    digits: args.removeprefix("above:").trim()
    if digits == "" -> return false
    loop byte in digits.bytes() {
        code: Int.from_u8(byte)
        if code < 48 || code > 57 -> return false
    }
    bytes: Int.parse(digits) ?? return false
    bytes > 0
}

pkg_dependency_boundary_span: fn(program: EffectBudgetProgram, dependency: String) -> Span? Never! {
    if program.entry < 0 || program.entry >= program.modules.len() -> return None
    loop import in program.modules[program.entry].imports {
        if import.name == dependency -> return Val(import.span)
    }
    None
}

// The package owning a module path: the first dependency (in name order)
// whose source root contains it, else `root`.
pkg_effect_module_owner: fn(program: EffectBudgetProgram, path: String) -> String Never! {
    names := program.dep_roots.keys().to_list()
    names.sort()
    loop name in names {
        if pkg_authority_path_within(path, program.dep_roots[name]) -> return name
    }
    EFFECT_ROOT_PACKAGE
}

// Attribute only functions reachable from the selected entry to the package
// whose module defines them. Loaded helpers the selected driver never calls
// must not become application provenance; functions with no solved entry
// contribute nothing. An effect's chain stays inside the package it is
// attributed to: a call into another package leaves that package's effects
// with it.
pkg_compute_package_effects: fn(program: EffectBudgetProgram, solved: [String: [String]], summaries: [String: PackageEffectSummary]) -> [PackageEffects] Never! {
    reachable: pkg_effect_entry_reachable_keys(program, summaries, "run")
    module_owners: loop loaded in program.modules -> pkg_effect_module_owner(program, loaded.path)
    // Each program function's package, by its key.
    owners := [String: String]{}
    loop (index, loaded) in program.modules {
        loop function_key in loaded.function_keys -> owners["{loaded.alias}::{function_key}"] = module_owners[index]
    }
    by_package := [String: PackageEffects]{}
    loop (index, loaded) in program.modules {
        owner: module_owners[index]
        aggregate := by_package.get(owner) ?? PackageEffects{name: owner.copy(), effects: [String]{}, effect_chains: [String: [String]]{}, effect_witnesses: [String: EffectBudgetWitness]{}, panic_sites: [String]{}, boundary_span: None}
        if aggregate.boundary_span == None && owner != EFFECT_ROOT_PACKAGE {
            aggregate.boundary_span = pkg_dependency_boundary_span(program, owner)
        }
        loop function_key in loaded.function_keys {
            pkg_collect_effects_for_key("{loaded.alias}::{function_key}", reachable, solved, summaries, owners, aggregate)
        }
        by_package[owner] = aggregate
    }
    names := by_package.keys().to_list()
    names.sort()
    out := [PackageEffects]{}
    loop name in names {
        entry := by_package[name]
        entry.effects = authority_holds(entry.effects)
        entry.panic_sites = authority_holds(entry.panic_sites)
        loop chain in entry.effect_chains.values() {
            if chain.len() == 0 -> next
            site: chain[chain.len() - 1]
            if entry.effect_witnesses.has_key(site) -> next
            witness: pkg_effect_witness(program, site) ?? next
            entry.effect_witnesses[site] = witness
        }
        out.push(entry)
    }
    out
}

pkg_effect_witness: fn(program: EffectBudgetProgram, site: String) -> EffectBudgetWitness? Never! {
    loop loaded in program.modules {
        prefix: "{loaded.alias}::"
        if !site.starts_with(prefix) -> next
        key: site.removeprefix(prefix)
        span: loaded.function_spans.get(key) ?? next
        return Val(EffectBudgetWitness{path: loaded.path, span: span})
    }
    None
}

// The semantic roots the driver can select: a selected runnable output, else
// the canonical `run` wrapper, else (for `run` only) the compiler-host
// `build` entry so its pre-runtime budget is not silently dropped. The
// qualified spelling wins over the short one.
pkg_effect_entry_candidates: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> [String] Never! {
    if program.selected_output == {
        .Val(output) -> {
            if output.module_index >= 0 && output.module_index < program.modules.len() {
                alias: program.modules[output.module_index].alias
                candidate_values: [String]{"{alias}::{output.semantic_name}", output.semantic_name}
                loop candidate in candidate_values {
                    if summaries.has_key(candidate) -> return [String]{candidate}
                }
                return [String]{}
            }
        }
        .None -> {}
    }
    if program.entry < 0 || program.entry >= program.modules.len() {
        if summaries.has_key(default_entry) -> return [String]{default_entry}
        return [String]{}
    }
    entry_module: program.modules[program.entry]
    candidates := [String]{"{entry_module.alias}::{default_entry}", default_entry}
    if default_entry == "run" && entry_module.has_build_entry {
        candidates.push("{entry_module.alias}::{EFFECT_BUILD_ENTRY}")
        candidates.push(EFFECT_BUILD_ENTRY)
    }
    loop candidate in candidates {
        if summaries.has_key(candidate) -> return [String]{candidate}
    }
    [String]{}
}

pkg_effect_entry_reachable_keys: fn(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> [String: Bool] Never! {
    pending := pkg_effect_entry_candidates(program, summaries, default_entry)
    reachable := [String: Bool]{}
    loop pending.len() > 0 {
        key: pending.pop() ?? break
        summary: summaries.get(key) ?? next
        if reachable.has_key(key) -> next
        reachable[key] = true
        loop edge in summary.edges -> pending.push(edge)
    }
    reachable
}

pkg_effect_key_is_reachable: fn(key: String, reachable: [String: Bool]) -> Bool Never! {
    if reachable.has_key(key) -> return true
    parts: key.split("::").to_list()
    if parts.len() < 2 -> return false
    reachable.has_key(parts[parts.len() - 1])
}

pkg_collect_effects_for_key: fn(key: String, reachable: [String: Bool], solved: [String: [String]], summaries: [String: PackageEffectSummary], owners: [String: String], aggregate: &PackageEffects) {
    if !pkg_effect_key_is_reachable(key, reachable) -> return
    set: solved.get(key) ?? return
    loop effect_name in set {
        aggregate.effects.push(effect_name.copy())
        if !aggregate.effect_chains.has_key(effect_name) {
            seen := [String: Bool]{}
            chain := [String]{}
            pkg_effect_chain(key, effect_name, solved, summaries, owners, seen, chain)
            aggregate.effect_chains[effect_name] = chain.move()
        }
    }
    seen := [String: Bool]{}
    site: pkg_panic_site(key, summaries, seen) ?? return
    aggregate.panic_sites.push(site)
}

// Append to `chain` the static path from `key` down to the deepest function
// of `key`'s package that directly performs (or maximally may perform)
// `effect`.
pkg_effect_chain: fn(key: String, effect_name: String, solved: [String: [String]], summaries: [String: PackageEffectSummary], owners: [String: String], seen: &[String: Bool], chain: &[String]) {
    if seen.has_key(key) -> return
    seen[key] = true
    chain.push(key.copy())
    summary: summaries.get(key) ?? return
    if summary.maximal -> return
    loop direct in summary.direct {
        if authority_covers(direct, effect_name) -> return
    }
    owner: owners.get(key)
    loop callee in authority_holds(summary.edges) {
        if owners.get(callee) != owner -> next
        effects: solved.get(callee) ?? next
        if authority_covers_any(effects, effect_name) || pkg_effect_any_covers(effects, effect_name) {
            pkg_effect_chain(callee, effect_name, solved, summaries, owners, seen, chain)
            return
        }
    }
}

// Whether any candidate effect covers `effect` (`effect_covers(candidate, effect)`).
pkg_effect_any_covers: fn(candidates: [String], effect_name: String) -> Bool Never! {
    loop candidate in candidates {
        if authority_covers(candidate, effect_name) -> return true
    }
    false
}

// The first function on a static path from `key` where a deniable Panic stop
// enters the graph.
pkg_panic_site: fn(key: String, summaries: [String: PackageEffectSummary], seen: &[String: Bool]) -> String? Never! {
    if seen.has_key(key) -> return None
    seen[key] = true
    summary: summaries.get(key) ?? return None
    if summary.maximal || summary.edges.contains(EFFECT_PANIC_EDGE) -> return Val(key)
    loop direct in summary.direct {
        if authority_root(direct) == AUTHORITY_PANIC_ROOT -> return Val(key)
    }
    loop callee in authority_holds(summary.edges) {
        site: pkg_panic_site(callee, summaries, seen) ?? next
        return Val(site)
    }
    None
}

// The always-on one-line `jet build` summary.
pkg_effect_summary_line: fn(entries: [PackageEffects]) -> String Never! {
    all := [String]{}
    loop entry in entries {
        loop effect_name in entry.effects -> all.push(effect_name.copy())
    }
    all = authority_holds(all)
    if all.len() == 0 -> return "effects: none"
    dependency_count := 0
    loop entry in entries {
        if entry.name != EFFECT_ROOT_PACKAGE && entry.effects.len() > 0 -> dependency_count += 1
    }
    if dependency_count == 0 -> return "effects: {all.join(", ")}"
    suffix: if dependency_count == 1 -> "y" else -> "ies"
    "effects: {all.join(", ")} (across root + {dependency_count} dependenc{suffix})"
}

// The aggregated effects of the package named `name`; None when the build
// loads none of its modules.
pkg_effect_entry_for: fn(entries: [PackageEffects], name: String) -> PackageEffects? Never! {
    loop entry in entries {
        if entry.name == name -> return Val(entry.copy())
    }
    None
}

// Budget rows share the authority parser; deny-only rights remain enforceable.
pkg_effect_budget_rights: fn(names: [String]) -> [String] Never! {
    authority_parse_rights(names)
}

// Whole-graph enforcement: with `authority` declared, a dependency reaching
// an effect outside its limit or inside `deny` fails with E1220, naming the
// call path. A dependency's limit is its `authority.grants` line when it has
// one, which replaces `allow` for it (a line may pin a dependency below
// `allow`), and `allow` otherwise; what its line grants also passes `deny`.
// The root package's own code reaching an effect outside a written `allow`
// row is E0749: the row is a ceiling, as a function's `-[…]>` row is. A
// `deny` over the root's code is sema's E0749, checked at every function of
// the package, so it is not repeated here. Rows may be ancestor roots; the
// substrate verdict decides. Panic is deny-only, so no line grants it. A
// library grant (`FFI.C("c")`) names its library by a key of the package
// that writes it, and equal keys in two packages need not name one locked
// library, so `allow` lends a dependency none of its library grants; the
// dependency's own grant line names its own keys.
pkg_effect_enforce: fn(entries: [PackageEffects], manifest: PackageFacts) -> [Diagnostic] Never! {
    if !manifest.effects_enabled -> return [Diagnostic]{}
    allow: if manifest.authority.allow == {
        .Val(names) -> Val(pkg_effect_budget_rights(names))
        .None -> None
    }
    dependency_allow: if allow == {
        .Val(rights) -> Val(pkg_effect_without_library_grants(rights))
        .None -> None
    }
    deny: pkg_effect_budget_rights(manifest.authority.deny ?? [String]{})
    empty: [String]{}
    diagnostics := [Diagnostic]{}
    loop package in entries {
        root: package.name == EFFECT_ROOT_PACKAGE
        granted: if root -> None else -> pkg_effect_grant_for(manifest, package.name)
        limit: if granted == {
            .Val(line) -> Val(line)
            .None -> if root -> allow else -> dependency_allow
        }
        loop effect_name in package.effects {
            is_panic: authority_root(effect_name) == AUTHORITY_PANIC_ROOT
            deny_only: authority_is_deny_only(effect_name)
            if !deny_only && granted != None {
                if authority_answer(granted, empty, effect_name) == AuthorityVerdict.Allowed -> next
            }
            outside_limit: if limit == {
                .Val(rights) -> !deny_only && authority_answer(rights, empty, effect_name) != AuthorityVerdict.Allowed
                .None -> false
            }
            inside_deny: !root && authority_answer(empty, deny, effect_name) == AuthorityVerdict.Denied
            if !outside_limit && !inside_deny -> next
            if is_panic {
                site: if package.panic_sites.len() > 0 -> package.panic_sites[0] else -> "a reachable dependency function"
                diagnostics.push(pkg_e1220_panic(package.name, site, package.boundary_span))
                next
            }
            chain: package.effect_chains.get(effect_name) ?? [String]{}
            site := String?{None}
            if chain.len() > 0 -> site = Val(chain[chain.len() - 1].copy())
            diagnostic := if root -> pkg_e0749_outside_allow(effect_name, chain) else if granted != None -> pkg_e1220_grant(package.name, effect_name, site, chain) else -> pkg_e1220_path(package.name, effect_name, site, chain)
            if site == .Val(function) {
                if package.effect_witnesses.get(function) == .Val(witness) {
                    diagnostic.span = Val(witness.span)
                    diagnostic = diagnostic_with_source_path(diagnostic, witness.path, 0)
                }
            }
            diagnostics.push(diagnostic)
        }
    }
    diagnostics
}

// `rights` without its library grants (`FFI.C("c")`): the rights the root's
// `allow` row lends a dependency, whose library keys are its own.
pkg_effect_without_library_grants: fn(rights: [String]) -> [String] Never! {
    out := [String]{}
    loop right in rights {
        if authority_root(right) == "FFI" && effect_scope_is_scoped(right) -> next
        // copy: the borrowed manifest row stays the root's limit.
        out.push(right.copy())
    }
    out
}

// The parsed `authority.grants` row of one dependency, if any.
pkg_effect_grant_for: fn(manifest: PackageFacts, dependency: String) -> [String]? Never! {
    loop grant in manifest.authority.grants {
        if grant.package == dependency -> return Val(pkg_effect_budget_rights(grant.rights))
    }
    None
}

// One effect a dependency's inferred row newly reaches, with the static call
// path from the first reached function down to the function that performs it
// (empty when the build saw no path), and that function's source location.
PackageEffectReach: struct {
    effect_name: String
    chain: [String]
    witness: EffectBudgetWitness?
}

// A dependency whose inferred effect row reaches effects the row the project
// lock recorded for it doesn't cover: what a dependency update widened.
PackageEffectGain: struct {
    name: String
    reaches: [PackageEffectReach]
}

// Record each dependency's inferred effect row (`entries`, one build's
// pkg_compute_package_effects) in the project lock at `project_root`, and
// return the effects each dependency gained over the row recorded before, in
// lock order. A recorded row only widens: it holds every effect a build of
// the project saw the dependency's own code reach, so two entries that reach
// different parts of one dependency don't undo each other's row. A
// dependency's first row is recorded, not reported; one the build loads no
// module of keeps its row. `locked` writes nothing, and the caller refuses
// each gain (pkg_lock_e3513). A project without a readable lock records
// nothing: `jet fetch` writes the lock, and `jet fetch --locked` refuses one
// it can't read.
pkg_lock_record_effect_rows: fn(project_root: String, entries: [PackageEffects], locked: Bool) -[FS, Env, Time]> [PackageEffectGain] LockError! {
    lock := pkg_lock_load(project_root) ?? return Ok([PackageEffectGain]{})
    grants: if lock.authority == {
        .Val(authority) -> authority.grants.copy()
        .None -> [PackageGrant]{}
    }
    gains := [PackageEffectGain]{}
    changed := false
    loop index in 0..<lock.packages.len() {
        package := lock.packages[index]
        if package.is_root() -> next
        entry: pkg_effect_entry_for(entries, package.name) ?? next
        recorded: package.required_effect_roles()
        gained := [String]{}
        reaches := [PackageEffectReach]{}
        loop effect_name in entry.effects {
            // A deny-only right (`Panic`, `Mem`, `Time.Wait`) is never
            // granted, so the lock records none: a stop is refused by a
            // budget's `deny` (E1220), not recorded as a widening.
            if authority_is_deny_only(effect_name) -> next
            if authority_covers_any(recorded, effect_name) -> next
            gained.push(effect_name.copy())
            chain: entry.effect_chains.get(effect_name) ?? [String]{}
            witness := EffectBudgetWitness?{None}
            if chain.len() > 0 -> witness = entry.effect_witnesses.get(chain[chain.len() - 1])
            reaches.push(PackageEffectReach{effect_name: effect_name.copy(), chain: chain, witness: witness})
        }
        first: package.effect_authority == None
        if !first && gained.len() == 0 -> next
        if !first -> gains.push(PackageEffectGain{name: package.name.copy(), reaches: reaches})
        row := recorded.copy()
        loop effect_name in gained -> row.push(effect_name)
        granted := [String]{}
        loop grant in grants {
            if grant.package == package.name -> granted = grant.rights.copy()
        }
        package.effect_authority = Val(if granted.len() == 0 -> EFFECT_AUTHORITY_PACKAGE else -> EFFECT_AUTHORITY_PACKAGE_GRANTS)
        package.effects = authority_holds(row)
        package.required_effects = package.effects.copy()
        package.granted_effects = granted.copy()
        package.effect_grants = granted
        lock.packages[index] = package
        changed = true
    }
    if locked || !changed -> return Ok(gains)
    pkg_lock_write_atomically(project_root, pkg_lock_write(lock).bytes()) ?? return Err(LockError.Reported(diagnostic_from_registry("E3502", None,
        "the dependency effect rows could not update `{pkg_lock_file_path(project_root)}`",
        "the project lock update is transactional and the filesystem rejected it: {err.message()}",
        "make the project lock directory writable and rerun the build")))
    Ok(gains)
}

// E3513: `--locked` refuses a dependency whose inferred effect row gained an
// effect the project lock doesn't record for it, at the function that
// performs it, with the call path into the dependency.
pkg_lock_e3513: fn(dependency: String, reach: PackageEffectReach) -> Diagnostic Never! {
    diagnostic := diagnostic_from_registry("E3513", None,
        "dependency `{dependency}` now reaches `{reach.effect_name}`, which `.jet/lock` doesn't record for it",
        "`--locked` requires each dependency's inferred effect row to stay within the row the project lock records",
        "review the change to `{dependency}`, then rerun without `--locked` to record its wider row")
    diagnostic = diagnostic_with_rights(diagnostic, "invocation", reach.chain, [String]{}, None)
    if reach.witness == .Val(witness) {
        diagnostic.span = Val(witness.span)
        diagnostic = diagnostic_with_source_path(diagnostic, witness.path, 0)
    }
    diagnostic
}

// The note a plain build prints for one widened effect: the dependency, the
// effect, and the call path to it.
pkg_lock_widened_note: fn(dependency: String, reach: PackageEffectReach) -> String Never! {
    path: if reach.chain.len() > 0 -> " through {reach.chain.join(" → ")}" else -> ""
    "note: `{dependency}` now reaches `{reach.effect_name}`{path}; `.jet/lock` records its wider effect row\n"
}

// E1220: a dependency reaches an effect outside this package's budget.
// `chain` is the call path into the dependency, down to the function that
// performs the effect (`site`). A library effect names the dependency's own
// library key, which only its grant line can name.
pkg_e1220_path: fn(dependency: String, effect_name: String, site: String?, chain: [String]) -> Diagnostic Never! {
    fix: if authority_root(effect_name) == "FFI" && effect_scope_is_scoped(effect_name) -> "grant `{effect_name}` to `{dependency}` in `authority.grants` (the key names `{dependency}`'s own library), or drop the dependency" else -> "add `{effect_name}` to `authority.allow`, grant it to `{dependency}` in `authority.grants`, or drop the dependency"
    diagnostic: diagnostic_from_registry("E1220", None,
        "`{dependency}`{pkg_e1220_location(site)} uses the `{effect_name}` effect, which this package's budget doesn't allow",
        "an `authority` budget fails the build when package code or any dependency reaches an effect you didn't list — supply-chain review as a compile error",
        fix)
    diagnostic_with_rights(diagnostic, "invocation", chain, [String]{}, None)
}

// E1220 under a grant line: the line is the dependency's whole limit, so an
// effect it leaves out fails even when `allow` lists it. This is what an
// update that widens a dependency's reach meets.
pkg_e1220_grant: fn(dependency: String, effect_name: String, site: String?, chain: [String]) -> Diagnostic Never! {
    diagnostic: diagnostic_from_registry("E1220", None,
        "`{dependency}`{pkg_e1220_location(site)} uses the `{effect_name}` effect, which its `authority.grants` line doesn't grant",
        "a dependency's grant line is its whole limit, in place of `allow`, so a version that reaches further stops the build",
        "keep the version that fits its line, add `{effect_name}` to `{dependency}`'s line in `authority.grants`, or drop the dependency")
    diagnostic_with_rights(diagnostic, "invocation", chain, [String]{}, None)
}

pkg_e1220_location: fn(site: String?) -> String Never! {
    if site == .Val(function) -> return " function `{function}`"
    ""
}

// E0749: the root package's own code reaches an effect its written `allow`
// row leaves out. `chain` runs from the first reached function that reaches
// it down to the one that performs it, which the report names.
pkg_e0749_outside_allow: fn(effect_name: String, chain: [String]) -> Diagnostic Never! {
    site: if chain.len() > 0 -> chain[chain.len() - 1] else -> "the package's code"
    diagnostic: diagnostic_from_registry("E0749", None,
        "`{site}` reaches the `{effect_name}` effect, which the package's `authority: {{ allow: […] }}` row doesn't list",
        "a written `allow` row is a ceiling: the package's code and every call it makes may use only the listed effects and the floor every program holds (`IO`, `Mem.Alloc`, `Exec.Args`)",
        "add `{effect_name}` to `authority.allow`, or remove the call that reaches it")
    diagnostic_with_rights(diagnostic, "invocation", chain, [String]{}, None)
}

// E1220 a package denial keeps the panic provenance visible
// and offers the same exits as function-scope prohibition.
pkg_e1220_panic: fn(dependency: String, panic_site: String, span: Span?) -> Diagnostic Never! {
    diagnostic_from_registry("E1220", span,
        "`{dependency}` uses the `Panic` effect at `{panic_site}`, which this package's budget doesn't allow",
        "the package denies stops from `{panic_site}`; a dependency that can stop cannot cross this budget boundary",
        "return a fallible result for expected failure, or add facts or a `#Pre`/refinement proof for a programmer-error stop; `Panic` is deny-only and cannot be allowed or granted")
}
