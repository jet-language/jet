
// Write per-package effect provenance (and configured `authority.grants`)
// into an existing lockfile's package entries in place. A package the lock
// does not list yet is left for `jet store fetch` to add.
pub fn pkg_update_lock_provenance(lock: &LockFile, entries: [PackageEffects], manifest: PackageFacts) {
    lock.authority = if manifest.authority != PackageAuthority.default() -> Val(manifest.authority) else -> None
    loop index in 0..<lock.packages.len() {
        package := lock.packages[index]
        is_root :: package.source == LockSource.Root
        key :: if is_root -> EFFECT_ROOT_PACKAGE else -> package.name
        package.required_effects = pkg_effect_provenance_for(entries, key)
        package.effects = package.required_effects
        granted := [String]{}
        loop grant in manifest.authority.grants {
            if grant.package == package.name {
                granted = grant.rights
                break
            }
        }
        package.granted_effects = granted
        package.effect_grants = granted
        package.denied_effects = manifest.authority.holds.deny ?? [String]{}
        package.effect_authority = Val(if is_root || granted.len() == 0 -> EFFECT_AUTHORITY_PACKAGE_HOLDS else -> EFFECT_AUTHORITY_PACKAGE_GRANTS)
        lock.packages[index] = package
    }
}

