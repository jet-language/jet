// Jetpack integrations with outside tools: the C++, Dart, Lua, Perl, PHP, PowerShell, R, Ruby
// and Octave binders, C binding metadata and import assembly, the Rust bridge build, MCP and
// compiler extensions. They read bounded JSON with json.parse_with_limits. `jet inspect bind`
// runs the binders in process.
name: "jetpack_integrations"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../../Compiler/JetFoundation,
    jet_parser: ../../Compiler/JetParser,
    jetpack_foundation: ../Foundation,
    jet_pkg_model: ../PackageModel,
}
