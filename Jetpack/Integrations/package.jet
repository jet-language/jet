// Jetpack integrations with outside tools: C++ and Dart binders, the Rust bridge build, MCP,
// compiler extensions and provider facts. They read bounded JSON (json.parse with caller
// limits), so this package waits on that Core API; the compiler does not depend on it.
name: "jetpack_integrations"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../../Compiler/JetFoundation,
    jet_parser: ../../Compiler/JetParser,
    jetpack_foundation: ../Foundation,
    jet_pkg_model: ../PackageModel,
}
