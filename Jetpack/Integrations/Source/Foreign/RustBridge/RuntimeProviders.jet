// Core runtime providers carried by the hidden cargo FFI bridge, ported from
// jet_pkg_model::FFI.
//
// Some Core surfaces (core.db, core.data Parquet readers, the native HTTP
// client, server and client TLS, core.crypto, core.plugin, and the vault
// secrets bridge) are backed by hand-written Rust runtimes that live only in
// the generated bridge crate (I6: never in the compiler). This file decides
// which providers a program needs, pins the crates they use, embeds the
// runtime sources, and renders the helper binaries the CLI shells out to.

use jetpack_foundation.[
    FFI_JET_FOUNDATION_CRATE_PATH, FFI_JET_UNICODE_CRATE_PATH, NativeSandboxMount,
    foundation_jet_source_root, foundation_try_tree_hash,
]
use core.files as files
use core.sys as sys

// One pinned crate: name and Cargo version requirement.
struct FFICrateSpec {
    name: String
    version: String
}

// The `rusqlite` crate that backs `core.db`.
FFI_DB_CRATE_SPEC :: prep { FFICrateSpec{name: "rusqlite", version: "0.31"} }
// Official Arrow Rust reader closure for `core.data` Parquet sources
FFI_PARQUET_CRATE_SPEC :: prep { FFICrateSpec{name: "parquet", version: "59.3.0"} }
FFI_ARROW_ARRAY_CRATE_SPEC :: prep { FFICrateSpec{name: "arrow-array", version: "59.3.0"} }
FFI_ARROW_DATA_CRATE_SPEC :: prep { FFICrateSpec{name: "arrow-data", version: "59.3.0"} }
FFI_ARROW_SCHEMA_CRATE_SPEC :: prep { FFICrateSpec{name: "arrow-schema", version: "59.3.0"} }
FFI_ARROW_SELECT_CRATE_SPEC :: prep { FFICrateSpec{name: "arrow-select", version: "59.3.0"} }
FFI_BYTES_CRATE_SPEC :: prep { FFICrateSpec{name: "bytes", version: "1"} }
// `rustls` backs `core.http.server` TLS.
FFI_HTTP_SERVER_TLS_CRATE_SPEC :: prep { FFICrateSpec{name: "rustls", version: "0.23"} }
// PEM parser used by the server TLS bridge.
FFI_HTTP_SERVER_TLS_PEMFILE_CRATE_SPEC :: prep { FFICrateSpec{name: "rustls-pemfile", version: "2"} }
// System root loader used by `core.net.tls_connect`.
FFI_RUSTLS_NATIVE_CERTS_CRATE_SPEC :: prep { FFICrateSpec{name: "rustls-native-certs", version: "0.7"} }
// This rule crypto closure.
FFI_AES_GCM_CRATE_SPEC :: prep { FFICrateSpec{name: "aes-gcm", version: "=0.10.3"} }
FFI_CHACHA_POLY_CRATE_SPEC :: prep { FFICrateSpec{name: "chacha20poly1305", version: "=0.10.1"} }
FFI_ED25519_CRATE_SPEC :: prep { FFICrateSpec{name: "ed25519-dalek", version: "=2.2.0"} }
FFI_ARGON2_CRATE_SPEC :: prep { FFICrateSpec{name: "argon2", version: "=0.5.3"} }
FFI_SHA2_CRATE_SPEC :: prep { FFICrateSpec{name: "sha2", version: "=0.10.9"} }
FFI_BLAKE3_CRATE_SPEC :: prep { FFICrateSpec{name: "blake3", version: "=1.8.2"} }
FFI_HKDF_CRATE_SPEC :: prep { FFICrateSpec{name: "hkdf", version: "=0.12.4"} }
FFI_X25519_CRATE_SPEC :: prep { FFICrateSpec{name: "x25519-dalek", version: "=2.0.1"} }
FFI_SUBTLE_CRATE_SPEC :: prep { FFICrateSpec{name: "subtle", version: "=2.6.1"} }
// `wasmtime` backs sandboxed Component Model hosts (
// ); the pin matches the approved Cranelift generation.
FFI_WASMTIME_CRATE_SPEC :: prep { FFICrateSpec{name: "wasmtime", version: "25"} }
// The `age` crate backs `core.crypto.vault` (U13).
FFI_AGE_CRATE_SPEC :: prep { FFICrateSpec{name: "age", version: "0.10"} }

// Crate dependencies whose Cargo value needs a full TOML table (feature
// flags); emitted verbatim as the right-hand side of `name = …`.
struct FFIFeaturedDep {
    name: String
    toml: String
}

FFI_FEATURED_DEPS :: prep { [FFIFeaturedDep]{
    {name: "arrow-array", toml: "{{ version = \"=59.3.0\", default-features = false }}"},
    {name: "arrow-data", toml: "{{ version = \"=59.3.0\", default-features = false }}"},
    {name: "arrow-schema", toml: "{{ version = \"=59.3.0\", default-features = false }}"},
    {name: "arrow-select", toml: "{{ version = \"=59.3.0\", default-features = false }}"},
    {name: "bytes", toml: "{{ version = \"1\", default-features = false }}"},
    {name: "parquet", toml: "{{ version = \"=59.3.0\", default-features = false, features = [\"arrow\", \"brotli\", \"flate2-zlib-rs\", \"lz4\", \"simdutf8\", \"snap\", \"zstd\"] }}"},
    {name: "aes-gcm", toml: "{{ version = \"=0.10.3\", default-features = false, features = [\"aes\", \"alloc\"] }}"},
    {name: "age", toml: "{{ version = \"0.10\" }}"},
    {name: "argon2", toml: "{{ version = \"=0.5.3\", default-features = false, features = [\"alloc\", \"password-hash\"] }}"},
    {name: "blake3", toml: "{{ version = \"=1.8.2\", default-features = false, features = [\"std\", \"pure\"] }}"},
    {name: "chacha20poly1305", toml: "{{ version = \"=0.10.1\", default-features = false, features = [\"alloc\"] }}"},
    {name: "ed25519-dalek", toml: "{{ version = \"=2.2.0\", default-features = false, features = [\"alloc\", \"zeroize\"] }}"},
    {name: "hkdf", toml: "{{ version = \"=0.12.4\", default-features = false, features = [] }}"},
    {name: "rusqlite", toml: "{{ version = \"0.31\", features = [\"bundled\", \"hooks\"] }}"},
    {name: "rustls", toml: "{{ version = \"0.23\", default-features = false, features = [\"ring\", \"std\", \"tls12\"] }}"},
    {name: "sha2", toml: "{{ version = \"=0.10.9\", default-features = false, features = [] }}"},
    {name: "subtle", toml: "{{ version = \"=2.6.1\", default-features = false, features = [] }}"},
    {name: "wasmtime", toml: "{{ version = \"25\", features = [\"component-model\"] }}"},
    {name: "x25519-dalek", toml: "{{ version = \"=2.0.1\", default-features = false, features = [\"precomputed-tables\", \"zeroize\"] }}"}
} }

// The hand-written Rust runtimes emitted into the bridge crate. Each is the
// only code that touches its pinned crates.
FFI_DB_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/DB.rs") }
FFI_PARQUET_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/Parquet.rs") }
FFI_HTTP_CLIENT_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/HTTP.rs") }
// Mozilla Public Suffix List snapshot, IDNA-ToASCII and whitespace compacted
// (https://publicsuffix.org/list/public_suffix_list.dat, MPL-2.0).
FFI_HTTP_PUBLIC_SUFFIX_LIST :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/public_suffix_list.dat") }
FFI_HTTP_SERVER_TLS_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/HTTPServerTLS.rs") }
FFI_NET_TLS_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/NetTls.rs") }
FFI_CRYPTO_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/Crypto.rs") }
FFI_OUTCOME_RUNTIME :: prep { embed_file("../../../../../crates/jet-foundation/src/Outcome.rs") }
FFI_RUNTIME_DIAGNOSTIC_CORE :: prep { embed_file("../../../../../crates/jet-foundation/src/RuntimeDiagnosticCore.rs") }
FFI_ENCODING_ERRORS_RUNTIME :: prep { embed_file("../../../../../crates/jet-foundation/src/EncodingErrors.rs") }
FFI_DYN_RUNTIME :: prep { embed_file("../../../../../crates/jet-foundation/src/Dyn.rs") }
FFI_ENCODING_JSON_RUNTIME :: prep { embed_file("../../../../../crates/jet-foundation/src/EncodingJson.rs") }
// EncodingJson's two `include!` inputs, spliced in place by the emitter: the
// embedded text lives in the generated bridge crate, not beside these files.
FFI_ENCODING_TYPES_INCLUDE :: prep { "include!(\"../../jet-codegen/src/Prelude/CoreLib/JetStd/EncodingTypes.rs\");" }
FFI_ENCODING_TYPES_RUNTIME :: prep { embed_file("../../../../../crates/jet-codegen/src/Prelude/CoreLib/JetStd/EncodingTypes.rs") }
FFI_ENCODING_ERROR_INCLUDE :: prep { "include!(\"../../jet-codegen/src/Prelude/Core/EncodingError.rs\");" }
FFI_ENCODING_ERROR_RUNTIME :: prep { embed_file("../../../../../crates/jet-codegen/src/Prelude/Core/EncodingError.rs") }
FFI_JSON_NUMBER_RUNTIME :: prep { embed_file("../../../../../crates/jet-foundation/src/JSONNumber.rs") }
FFI_CRYPTO_ENTROPY_RUNTIME :: prep { embed_file("../../../../../crates/jet-codegen/src/Prelude/CoreLib/Top/CryptoEntropy.rs") }
// Application plugin loader.
FFI_PLUGIN_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/Plugin.rs") }
// Compiler-extension host runtime same wasmtime substrate,
// distinct `compiler-extension-v1` world; compiled only by the isolated
// jetpack binary, never mixed into application `core.plugin` bridges.
FFI_COMPILER_EXTENSION_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/CompilerExtension.rs") }
FFI_SECRETS_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/SecretsCrypto.rs") }
FFI_VAULT_KEY_WRAP_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/VaultKeyWrap.rs") }
FFI_VAULT_NFC_RUNTIME :: prep { embed_file("../../../../../crates/jet-pkg-model/src/Prelude/VaultNfc.rs") }
FFI_UNICODE_TABLES_RUNTIME :: prep { embed_file("../../../../../crates/jet-codegen/src/Prelude/CoreLib/Top/UnicodeTables.rs") }

FFI_HOST_RUNTIME_STOP_BEGIN :: prep { "// JET_HOST_RUNTIME_STOP_BEGIN" }
FFI_HOST_RUNTIME_STOP_END :: prep { "// JET_HOST_RUNTIME_STOP_END" }
FFI_HOST_RUNTIME_SENTRY_BEGIN :: prep { "// JET_HOST_RUNTIME_SENTRY_BEGIN" }
FFI_HOST_RUNTIME_SENTRY_END :: prep { "// JET_HOST_RUNTIME_SENTRY_END" }
FFI_HOST_RUNTIME_DIAGNOSTIC_LOOKUP_BEGIN :: prep { "// JET_HOST_RUNTIME_DIAGNOSTIC_LOOKUP_BEGIN" }
FFI_HOST_RUNTIME_DIAGNOSTIC_LOOKUP_END :: prep { "// JET_HOST_RUNTIME_DIAGNOSTIC_LOOKUP_END" }

// Remove one `begin … end` host-only span, markers included.
fn pkg_ffi_strip_outcome_host_wrapper(source: String, begin: String, end: String) -> String Never! {
    head :: source.split_once(begin) ?? panic("Outcome host wrapper marker missing")
    tail :: head.after.split_once(end) ?? panic("Outcome host wrapper end marker missing")
    "{head.before}{tail.after}"
}

// The shared entry-error formatter still needs Foundation's canonical lookup,
// but the bridge's dependency is jet_foundation, not crate::Registry.
fn pkg_ffi_standalone_outcome_runtime() -> String Never! {
    projected :: pkg_ffi_strip_outcome_host_wrapper(FFI_OUTCOME_RUNTIME, FFI_HOST_RUNTIME_STOP_BEGIN, FFI_HOST_RUNTIME_STOP_END)
    standalone :: pkg_ffi_strip_outcome_host_wrapper(projected, FFI_HOST_RUNTIME_SENTRY_BEGIN, FFI_HOST_RUNTIME_SENTRY_END)
    head :: FFI_OUTCOME_RUNTIME.split_once(FFI_HOST_RUNTIME_DIAGNOSTIC_LOOKUP_BEGIN) ?? panic("Outcome diagnostic lookup marker missing")
    tail :: head.after.split_once(FFI_HOST_RUNTIME_DIAGNOSTIC_LOOKUP_END) ?? panic("Outcome diagnostic lookup end marker missing")
    lookup :: tail.before.replace("crate::Registry::", "jet_foundation::Registry::")
    "{standalone}{lookup}"
}

// Which bridge-backed Core providers one bridge carries. The regex, archive,
// and stream-codec surfaces are compiled from their canonical Jet source
// modules, so those three are always false for a prepared program.
struct RustBridgeNeeds {
    regex: Bool
    archive: Bool
    db: Bool
    parquet: Bool
    http_client: Bool
    http_server_tls: Bool
    net_tls: Bool
    crypto: Bool
    compress: Bool
    plugin: Bool
    secrets: Bool

    fn none() -> RustBridgeNeeds Never! {
        RustBridgeNeeds{regex: false, archive: false, db: false, parquet: false, http_client: false, http_server_tls: false, net_tls: false, crypto: false, compress: false, plugin: false, secrets: false}
    }

    // The providers the program's reached Core surfaces select.
    fn from_used_core(used_core: [String]) -> RustBridgeNeeds Never! {
        needs := RustBridgeNeeds.none()
        loop usage in used_core {
            if usage == "core.db" || usage.starts_with("core.db::") -> needs.db = true
            // Byte-source loader calls select the Parquet
            // provider; bare dependency-closure module rows do not.
            if pkg_ffi_needs_parquet_provider(usage) -> needs.parquet = true
            if pkg_ffi_is_http_client_usage(usage) -> needs.http_client = true
            // Only when the named `tls:` option is constructed.
            if usage == "core.http.server::tls" -> needs.http_server_tls = true
            if pkg_ffi_needs_net_tls_provider(usage) -> needs.net_tls = true
            if pkg_ffi_is_crypto_usage(usage) -> needs.crypto = true
            // (c81): the sandboxed plugin loader.
            if usage == "core.plugin" || usage.starts_with("core.plugin::") || usage.starts_with("core.plugin.") -> needs.plugin = true
            // U13 decrypted repo-secret reads.
            if usage == "core.crypto.vault" || usage.starts_with("core.crypto.vault::") -> needs.secrets = true
        }
        needs
    }

    fn any(self) -> Bool Never! {
        self.regex || self.archive || self.db || self.parquet || self.http_client || self.http_server_tls || self.net_tls || self.crypto || self.compress || self.plugin || self.secrets
    }
}

// A direct `core.data` loader call (not a bare module row).
fn pkg_ffi_needs_parquet_provider(usage: String) -> Bool Never! {
    parts :: usage.split_once("::") ?? return false
    parts.before == "core.data" || parts.before.starts_with("core.data.")
}

fn pkg_ffi_needs_net_tls_provider(usage: String) -> Bool Never! {
    bare := usage
    if usage.starts_with("__core_source::") {
        bare = usage.removeprefix("__core_source::")
    } else if usage.starts_with("__core_intrinsic::") {
        bare = usage.removeprefix("__core_intrinsic::")
    }
    bare == "core.net::tls_connect" || bare == "core.net.tls" || bare.starts_with("core.net.tls::") || bare == "core.email" || bare.starts_with("core.email::")
}

fn pkg_ffi_is_http_client_usage(usage: String) -> Bool Never! {
    if usage == {
        "core.http::get" | "core.http::post" | "core.http::request" -> true
        else -> usage == "core.http.client" || usage.starts_with("core.http.client::")
    }
}

fn pkg_ffi_is_crypto_usage(usage: String) -> Bool Never! {
    roots :: [String]{"core.crypto", "core.crypto.expert", "core.auth", "core.email", "core.crypto.vault"}
    loop root in roots {
        if usage == root || usage.starts_with("{root}::") -> return true
    }
    false
}

// Whether the native whole-program cache can skip Rust code generation for
// this program. FFI and C-linked programs stay on the ordinary path because
// their artifacts depend on bridge and link inputs outside the AST key.
fn pkg_ffi_native_cacheable(program: RustBridgeProgram) -> Bool Never! {
    // Whether a program has foreign rows does not depend on the target triple.
    if program.cffi.links_c() || pkg_ffi_collect_externs(program, "").len() > 0 -> return false
    loop usage in program.used_core {
        if usage == "core.db" || usage.starts_with("core.db::") || pkg_ffi_needs_parquet_provider(usage) || pkg_ffi_is_http_client_usage(usage) || usage == "core.http.server::tls" || pkg_ffi_needs_net_tls_provider(usage) -> return false
        if usage == "core.crypto" || usage.starts_with("core.crypto::") || usage == "core.crypto.expert" || usage.starts_with("core.crypto.expert::") || usage == "core.auth" || usage.starts_with("core.auth::") -> return false
        if usage == "core.plugin" || usage.starts_with("core.plugin::") || usage.starts_with("core.plugin.") -> return false
    }
    true
}

// The crypto helper binary source (c146): a thin stdin-protocol wrapper
// around the crate's own `jet_crypto_*_impl` functions, the only code that
// touches `ed25519-dalek`. Protocol (one command line on
// stdin, hex-encoded args):
//   `keygen`                               -> stdout `<seed_hex> <pub_hex>`
//   `sign <seed_hex> <msg_hex>`            -> stdout `<sig_hex>` (exit 0)
//   `verify <pub_hex> <msg_hex> <sig_hex>` -> exit 0 valid / 2 invalid / 1 error
fn pkg_ffi_emit_crypto_helper_bin(crate_name: String) -> String Never! {
    """
// Auto-generated Ed25519 signing helper (card c146) — do not edit.
#![allow(warnings)]
use std::io::{{Read, Write}};
use std::process::exit;

const ENTROPY_UNAVAILABLE: i32 = 75;

fn volatile_zeroize(bytes: &mut [u8]) {{
    for byte in bytes {{
        unsafe {{ std::ptr::write_volatile(byte, 0) }};
    }}
    std::sync::atomic::compiler_fence(std::sync::atomic::Ordering::SeqCst);
}}

fn write_hex(out: &mut impl Write, bytes: &[u8]) -> std::io::Result<()> {{
    for byte in bytes {{
        write!(out, "{{:02x}}", byte)?;
    }}
    Ok(())
}}

fn hex_encode(bytes: &[u8]) -> String {{
    let mut s = String::with_capacity(bytes.len() * 2);
    for b in bytes {{
        s.push_str(&format!("{{:02x}}", b));
    }}
    s
}}

fn hex_decode(s: &str) -> Result<Vec<u8>, String> {{
    let s = s.trim();
    if s.len() % 2 != 0 {{
        return Err("odd-length hex".to_string());
    }}
    let mut out = Vec::with_capacity(s.len() / 2);
    let bytes = s.as_bytes();
    let mut i = 0;
    while i < bytes.len() {{
        let hi = (bytes[i] as char).to_digit(16).ok_or("bad hex digit")?;
        let lo = (bytes[i + 1] as char).to_digit(16).ok_or("bad hex digit")?;
        out.push(((hi << 4) | lo) as u8);
        i += 2;
    }}
    Ok(out)
}}

fn fail(msg: &str) -> ! {{
    eprintln!("error: {{}}", msg);
    exit(1);
}}

fn main() {{
    let mut input = String::new();
    if std::io::stdin().read_to_string(&mut input).is_err() {{
        fail("couldn't read stdin");
    }}
    let mut parts = input.split_whitespace();
    let cmd = parts.next().unwrap_or("");
    match cmd {{
        "keygen" => {{
            match {crate_name}::jet_crypto_keygen_impl() {{
                Ok((mut seed, public)) => {{
                    let result = (|| -> std::io::Result<()> {{
                        let stdout = std::io::stdout();
                        let mut out = stdout.lock();
                        write_hex(&mut out, &seed)?;
                        out.write_all(b" ")?;
                        write_hex(&mut out, &public)?;
                        out.write_all(b"\\n")?;
                        out.flush()
                    }})();
                    volatile_zeroize(&mut seed);
                    if result.is_err() {{ exit(1); }}
                }}
                Err(_) => exit(ENTROPY_UNAVAILABLE),
            }}
        }}
        "sign" => {{
            let seed = parts.next().unwrap_or_else(|| fail("sign: missing key"));
            let msg = parts.next().unwrap_or_else(|| fail("sign: missing message"));
            let seed = hex_decode(seed).unwrap_or_else(|e| fail(&e));
            let msg = hex_decode(msg).unwrap_or_else(|e| fail(&e));
            match {crate_name}::jet_crypto_sign_impl(&seed, &msg) {{
                Ok(sig) => println!("{{}}", hex_encode(&sig)),
                Err(e) => fail(&e),
            }}
        }}
        "verify" => {{
            let pk = parts.next().unwrap_or_else(|| fail("verify: missing public key"));
            let msg = parts.next().unwrap_or_else(|| fail("verify: missing message"));
            let sig = parts.next().unwrap_or_else(|| fail("verify: missing signature"));
            let pk = hex_decode(pk).unwrap_or_else(|e| fail(&e));
            let msg = hex_decode(msg).unwrap_or_else(|e| fail(&e));
            let sig = hex_decode(sig).unwrap_or_else(|e| fail(&e));
            match {crate_name}::jet_crypto_verify_impl(&pk, &msg, &sig) {{
                Ok(()) => exit(0),
                Err(_) => exit(2),
            }}
        }}
        other => fail(&format!("unknown command `{{}}`", other)),
    }}
}}

"""
}

// The secrets helper binary source (U13): a thin
// stdin-protocol wrapper around the crate's own `jet_vault_*_impl`
// functions, the only code that touches the `age` crate.
//   `keygen`                                  -> stdout `<identity> <recipient>`
//   `encrypt <recipients_csv> <plaintext_hex>` -> stdout `<ciphertext_hex>` / exit 1
//   `decrypt <identity> <ciphertext_hex>`      -> stdout `<plaintext_hex>` / exit 1
//   `strings <plaintext_hex>`                  -> stdout historical pair bytes as hex
//   `replace-strings <pairs_hex>`              -> updates only v2 String rows
fn pkg_ffi_emit_secrets_helper_bin(crate_name: String) -> String Never! {
    """
// Auto-generated age-style secrets helper (U13) — do not edit.
#![allow(warnings)]
use std::io::Read;
use std::process::exit;
use jet_pkg_model.[
    ForeignBridgeError, ForeignIdentityBuilder, pkg_bridge_error, pkg_bridge_sha_file,
]

fn hex_encode(bytes: &[u8]) -> String {{
    let mut s = String::with_capacity(bytes.len() * 2);
    for b in bytes {{
        s.push_str(&format!("{{:02x}}", b));
    }}
    s
}}

fn hex_decode(s: &str) -> Result<Vec<u8>, String> {{
    let s = s.trim();
    if s.len() % 2 != 0 {{
        return Err("odd-length hex".to_string());
    }}
    let mut out = Vec::with_capacity(s.len() / 2);
    let bytes = s.as_bytes();
    let mut i = 0;
    while i < bytes.len() {{
        let hi = (bytes[i] as char).to_digit(16).ok_or("bad hex digit")?;
        let lo = (bytes[i + 1] as char).to_digit(16).ok_or("bad hex digit")?;
        out.push(((hi << 4) | lo) as u8);
        i += 2;
    }}
    Ok(out)
}}

fn fail(msg: &str) -> ! {{
    eprintln!("error: {{}}", msg);
    exit(1);
}}

fn main() {{
    let mut input = String::new();
    if std::io::stdin().read_to_string(&mut input).is_err() {{
        fail("couldn't read stdin");
    }}
    let mut parts = input.split_whitespace();
    let cmd = parts.next().unwrap_or("");
    match cmd {{
        "keygen" => {{
            let (identity, recipient) = {crate_name}::jet_vault_keygen_impl();
            println!("{{}} {{}}", identity, recipient);
        }}
        "encrypt" => {{
            let recipients_csv = parts.next().unwrap_or_else(|| fail("encrypt: missing recipients"));
            let plaintext_hex = parts.next().unwrap_or_else(|| fail("encrypt: missing plaintext"));
            let recipients: Vec<String> = recipients_csv.split(',').map(|s| s.to_string()).collect();
            let plaintext = hex_decode(plaintext_hex).unwrap_or_else(|e| fail(&e));
            match {crate_name}::jet_vault_encrypt_impl(&recipients, &plaintext) {{
                Ok(ciphertext) => println!("{{}}", hex_encode(&ciphertext)),
                Err(e) => fail(&e),
            }}
        }}
        "decrypt" => {{
            let identity = parts.next().unwrap_or_else(|| fail("decrypt: missing identity")).to_string();
            let ciphertext_hex = parts.next().unwrap_or_else(|| fail("decrypt: missing ciphertext"));
            let ciphertext = hex_decode(ciphertext_hex).unwrap_or_else(|e| fail(&e));
            match {crate_name}::jet_vault_decrypt_impl(&identity, &ciphertext) {{
                Ok(plaintext) => println!("{{}}", hex_encode(&plaintext)),
                Err(e) => fail(&e),
            }}
        }}
        "strings" => {{
            let plaintext_hex = parts.next().unwrap_or_else(|| fail("strings: missing plaintext"));
            let plaintext = hex_decode(plaintext_hex).unwrap_or_else(|e| fail(&e));
            match {crate_name}::jet_vault_strings_from_plaintext(&plaintext) {{
                Ok(pairs) => println!("{{}}", hex_encode(&{crate_name}::jet_vault_encode_pairs(&pairs))),
                Err(e) => fail(&e.to_string()),
            }}
        }}
        "replace-strings" => {{
            let pairs_hex = parts.next().unwrap_or_else(|| fail("replace-strings: missing pairs"));
            let bytes = hex_decode(pairs_hex).unwrap_or_else(|e| fail(&e));
            let pairs = {crate_name}::jet_vault_decode_pairs(&bytes).unwrap_or_else(|| fail("replace-strings: invalid pairs"));
            match {crate_name}::jet_vault_replace_strings_impl(pairs) {{
                Ok(()) => println!("ok"),
                Err(e) => fail(&e.to_string()),
            }}
        }}
        other => fail(&format!("unknown command `{{}}`", other)),
    }}
}}

"""
}

// Fingerprint and project the transitive Rust include closure, not a second
// manually maintained list of Prelude inputs.
FFI_JET_FOUNDATION_SOURCE_SCHEMA :: prep { "jet-ffi-foundation-source-v4" }

struct JetFoundationSources {
    root: String
    foundation: String
    unicode: String
    inputs: [String]
    digest: String
}

// Literal tokens carry a quote prefix, so text inside comments and strings
// cannot manufacture an include. Rust lifetimes are not character literals.
fn pkg_ffi_include_tokens(source: String) -> [String] Never! {
    raw :: source.bytes()
    tokens := [String]{}
    i := 0
    loop i < raw.len() {
        byte :: Int.from_u8(raw[i])
        if byte <= 32 {
            i += 1
            next
        }
        if i + 1 < raw.len() && Int.from_u8(raw[i]) == 47 && Int.from_u8(raw[i + 1]) == 47 {
            loop i < raw.len() && Int.from_u8(raw[i]) != 10 -> i += 1
            next
        }
        if i + 1 < raw.len() && Int.from_u8(raw[i]) == 47 && Int.from_u8(raw[i + 1]) == 42 {
            i += 2
            depth := 1
            loop i < raw.len() && depth > 0 {
                if {
                    i + 1 < raw.len() && Int.from_u8(raw[i]) == 47 && Int.from_u8(raw[i + 1]) == 42 -> {
                        depth += 1
                        i += 2
                    }
                    i + 1 < raw.len() && Int.from_u8(raw[i]) == 42 && Int.from_u8(raw[i + 1]) == 47 -> {
                        depth -= 1
                        i += 2
                    }
                    else -> i += 1
                }
            }
            next
        }
        // Raw strings can have any number of delimiter hashes.
        quote := i
        hashes := 0
        if byte == 114 {
            quote += 1
            loop quote < raw.len() && Int.from_u8(raw[quote]) == 35 {
                hashes += 1
                quote += 1
            }
        }
        if quote < raw.len() && Int.from_u8(raw[quote]) == 34 && (quote == i || byte == 114) {
            value := [U8]{}
            i = quote + 1
            loop i < raw.len() {
                if Int.from_u8(raw[i]) == 34 {
                    end := i + 1
                    loop end < raw.len() && end < i + 1 + hashes && Int.from_u8(raw[end]) == 35 -> end += 1
                    if end == i + 1 + hashes {
                        i = end
                        break
                    }
                }
                if {
                    byte == 34 && Int.from_u8(raw[i]) == 92 && i + 1 < raw.len() -> {
                        i += 1
                        escaped :: raw[i]
                        &value.push(if {
                            Int.from_u8(escaped) == 110 -> U8{10}
                            Int.from_u8(escaped) == 114 -> U8{13}
                            Int.from_u8(escaped) == 116 -> U8{9}
                            else -> escaped
                        })
                    }
                    else -> &value.push(raw[i])
                }
                i += 1
            }
            &tokens.push("\"{String.from_bytes(value) ?? ""}")
            next
        }
        if byte == 39 {
            end := i + 1
            if {
                end < raw.len() && Int.from_u8(raw[end]) == 92 -> end += 2
                else -> end += 1
            }
            if end < raw.len() && Int.from_u8(raw[end]) == 39 {
                i = end + 1
                next
            }
        }
        if {
            (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 -> {
                word := [U8]{}
                loop i < raw.len() {
                    code :: Int.from_u8(raw[i])
                    if !((code >= 65 && code <= 90) || (code >= 97 && code <= 122) || (code >= 48 && code <= 57) || code == 95) -> break
                    &word.push(raw[i])
                    i += 1
                }
                &tokens.push(String.from_bytes(word) ?? "")
            }
            else -> {
                &tokens.push(String.from_bytes([U8]{raw[i]}) ?? "")
                i += 1
            }
        }
    }
    tokens
}

fn pkg_ffi_rust_include_paths(source: String, manifest: String) -> [String] ForeignBridgeError! {
    tokens :: pkg_ffi_include_tokens(source)
    paths := [String]{}
    i := 0
    loop i + 2 < tokens.len() {
        name :: tokens[i]
        if (name != "include" && name != "include_str" && name != "include_bytes") || tokens[i + 1] != "!" || tokens[i + 2] != "(" {
            i += 1
            next
        }
        i += 3
        path := ""
        generated := false
        depth := 1
        loop i < tokens.len() && depth > 0 {
            token :: tokens[i]
            if token == "env" && i + 4 < tokens.len() && tokens[i + 1] == "!" && tokens[i + 2] == "(" && tokens[i + 4] == ")" {
                variable :: tokens[i + 3].removeprefix("\"")
                if {
                    variable == "CARGO_MANIFEST_DIR" -> path = "{path}{manifest}"
                    variable == "OUT_DIR" -> generated = true
                    else -> return Err(pkg_bridge_error("unsupported Rust include environment `{variable}`"))
                }
                i += 5
                next
            }
            if {
                token.starts_with("\"") -> path = "{path}{token.removeprefix("\"")}"
                token == "(" -> depth += 1
                token == ")" -> depth -= 1
                token != "concat" && token != "!" && token != "," -> return Err(pkg_bridge_error("unsupported Rust include expression `{token}`"))
                else -> {}
            }
            i += 1
        }
        if depth != 0 || path == "" -> return Err(pkg_bridge_error("incomplete Rust include expression"))
        // Build-script output is generated inside Cargo's writable target.
        if !generated -> &paths.push(path)
    }
    paths
}

fn pkg_ffi_foundation_rust_sources(directory: String) -[FS]> [String] ForeignBridgeError! {
    paths := [String]{}
    entries :: files.list_dir(directory) ?? return Err(pkg_bridge_error("read foundation sources `{directory}`: {err}"))
    loop entry in entries {
        if entry.name.starts_with(".") || entry.name == "target" -> next
        if {
            entry.is_dir -> {
                loop path in pkg_ffi_foundation_rust_sources(entry.path) -> &paths.push(path)
            }
            entry.name.ends_with(".rs") -> &paths.push(entry.path)
            else -> {}
        }
    }
    &paths.sort()
    paths
}

fn pkg_ffi_foundation_include_closure(root: String, foundation: String, unicode: String) -[FS]> [String] ForeignBridgeError! {
    pending := [(source: String, manifest: String)]{}
    loop path in pkg_ffi_foundation_rust_sources(foundation) -> &pending.push((source: path, manifest: foundation))
    loop path in pkg_ffi_foundation_rust_sources(unicode) -> &pending.push((source: path, manifest: unicode))
    seen := [(source: String, manifest: String)]{}
    external := [String]{}
    index := 0
    loop index < pending.len() {
        item :: pending[index]
        index += 1
        if seen.contains(item) -> next
        &seen.push(item)
        source :: item.source
        manifest :: item.manifest
        if !source.ends_with(".rs") -> next
        text :: files.read(source) ?? return Err(pkg_bridge_error("read Rust include source `{source}`: {err}"))
        loop include in pkg_ffi_rust_include_paths(text, manifest) {
            candidate :: if include.starts_with("/") -> include else -> files.join(files.dirname(source), include)
            stat :: files.stat(candidate) ?? return Err(pkg_bridge_error("Rust include `{candidate}` is unavailable: {err}"))
            if stat.is_symlink || !stat.is_file -> return Err(pkg_bridge_error("Rust include `{candidate}` is not a regular file"))
            path :: files.canonicalize(candidate) ?? return Err(pkg_bridge_error("canonicalize Rust include `{candidate}`: {err}"))
            if !path.starts_with("{root}/") -> return Err(pkg_bridge_error("Rust include `{path}` escapes the source root"))
            if !path.starts_with("{foundation}/") && !path.starts_with("{unicode}/") && !external.contains(path) -> &external.push(path)
            next_item :: (source: path, manifest: manifest)
            if !seen.contains(next_item) -> &pending.push(next_item)
        }
    }
    &external.sort()
    external
}

// The absolute path of the bridge's jet-foundation path dependency.
fn pkg_ffi_jet_foundation_crate_path() -[FS, Env]> String ForeignBridgeError! {
    root :: foundation_jet_source_root() ?? return Err(pkg_bridge_error("{err}"))
    Ok(files.join(root, FFI_JET_FOUNDATION_CRATE_PATH))
}

// A real (non-symlink) directory, canonicalized.
fn pkg_ffi_verified_source_directory(path: String, label: String) -[FS, Env]> String ForeignBridgeError! {
    stat :: files.stat(path) ?? return Err(pkg_bridge_error("jet-foundation {label} source `{path}` is unavailable: {err}"))
    if stat.is_symlink || !stat.is_dir -> return Err(pkg_bridge_error("jet-foundation {label} source `{path}` is not a real directory"))
    canonical :: files.canonicalize(path) ?? return Err(pkg_bridge_error("could not canonicalize jet-foundation {label} source `{path}`: {err}"))
    Ok(canonical)
}

fn pkg_ffi_foundation_input_digest(root: String, relative: String, label: String) -[FS]> String ForeignBridgeError! {
    path :: files.join(root, relative)
    stat :: files.stat(path) ?? return Err(pkg_bridge_error("jet-foundation {label} input `{path}` is unavailable: {err}"))
    if stat.is_symlink || !stat.is_file -> return Err(pkg_bridge_error("jet-foundation {label} input `{path}` is not a regular file"))
    pkg_bridge_sha_file(path)
}

// `<relative>\0<digest>`: one fingerprinted foundation input.
fn pkg_ffi_nul_joined(relative: String, digest: String) -> [U8] Never! {
    bytes := relative.bytes()
    &bytes.push(U8{0})
    loop byte in digest.bytes() -> &bytes.push(byte)
    bytes
}

fn pkg_ffi_jet_foundation_sources() -[FS, Env]> JetFoundationSources ForeignBridgeError! {
    root :: foundation_jet_source_root() ?? return Err(pkg_bridge_error("{err}"))
    foundation :: pkg_ffi_verified_source_directory(files.join(root, FFI_JET_FOUNDATION_CRATE_PATH), "crate")
    unicode :: pkg_ffi_verified_source_directory(files.join(root, FFI_JET_UNICODE_CRATE_PATH), "unicode crate")
    canonical_root :: files.canonicalize(root) ?? return Err(pkg_bridge_error("canonicalize foundation root: {err}"))
    inputs :: pkg_ffi_foundation_include_closure(canonical_root, foundation, unicode)
    foundation_tree :: foundation_try_tree_hash(foundation) ?? return Err(pkg_bridge_error("could not fingerprint jet-foundation source: {err.message()}"))
    unicode_tree :: foundation_try_tree_hash(unicode) ?? return Err(pkg_bridge_error("could not fingerprint jet-unicode source: {err.message()}"))
    identity := ForeignIdentityBuilder.new(FFI_JET_FOUNDATION_SOURCE_SCHEMA)
    &identity.field("foundation-tree", foundation_tree.bytes())
    &identity.field("unicode-tree", unicode_tree.bytes())
    loop path in inputs {
        relative :: path.removeprefix("{canonical_root}/")
        digest :: pkg_ffi_foundation_input_digest(canonical_root, relative, "include")
        &identity.field("include-input", pkg_ffi_nul_joined(relative, digest))
    }
    Ok(JetFoundationSources{root: canonical_root, foundation: foundation, unicode: unicode, inputs: inputs, digest: identity.finish()})
}

// Copy one included foundation input into the Linux source-closure stage.
fn pkg_ffi_stage_foundation_input(source_root: String, relative: String, destination_root: String, label: String) ForeignBridgeError! -[FS]> {
    source :: files.join(source_root, relative)
    destination :: files.join(destination_root, relative)
    parent :: files.dirname(destination)
    if parent == "" -> return Err(pkg_bridge_error("jet-foundation {label} input destination `{destination}` has no parent"))
    files.create_dir_all(parent) ?? return Err(pkg_bridge_error("could not stage jet-foundation {label} input directory `{parent}`: {err}"))
    files.copy(source, destination) ?? return Err(pkg_bridge_error("could not stage jet-foundation {label} input `{source}`: {err}"))
}

// Linux projects only discovered external inputs at their original root,
// followed by the two complete path crates. Other adapters cannot remap paths.
fn pkg_ffi_jet_foundation_mounts(cache_root: String, sources: JetFoundationSources) -[FS, Env]> [NativeSandboxMount] ForeignBridgeError! {
    mounts := [NativeSandboxMount]{}
    if {
        sys.is_linux() -> {
            closure_root :: files.join(cache_root, ".jet-foundation-source-closure")
            if files.lexists(closure_root) {
                files.remove_all(closure_root) ?? return Err(pkg_bridge_error("could not clear jet-foundation source closure `{closure_root}`: {err}"))
            }
            files.create_dir_all(closure_root) ?? return Err(pkg_bridge_error("create foundation source closure: {err}"))
            loop path in sources.inputs {
                pkg_ffi_stage_foundation_input(sources.root, path.removeprefix("{sources.root}/"), closure_root, "include")
            }
            // Parent is read-only before the two crate binds: precreate only
            // their empty destinations, never copy or expose unrelated inputs.
            files.create_dir_all(files.join(closure_root, sources.foundation.removeprefix("{sources.root}/"))) ?? return Err(pkg_bridge_error("create foundation crate mount point: {err}"))
            files.create_dir_all(files.join(closure_root, sources.unicode.removeprefix("{sources.root}/"))) ?? return Err(pkg_bridge_error("create unicode crate mount point: {err}"))
            &mounts.push(NativeSandboxMount{source: closure_root, destination: sources.root})
        }
        else -> {
            parents := [String]{}
            loop path in sources.inputs {
                parent :: files.dirname(path)
                if !parents.contains(parent) {
                    &parents.push(parent)
                    &mounts.push(NativeSandboxMount{source: parent, destination: parent})
                }
            }
        }
    }
    &mounts.push(NativeSandboxMount{source: sources.foundation, destination: sources.foundation})
    &mounts.push(NativeSandboxMount{source: sources.unicode, destination: sources.unicode})
    Ok(mounts)
}
