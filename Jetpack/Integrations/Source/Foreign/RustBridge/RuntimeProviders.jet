// Core runtime providers carried by the hidden cargo FFI bridge, ported from
// jet_pkg_model::FFI.
//
// `core.plugin` is backed by a hand-written Rust runtime that lives only
// in the generated bridge crate (I6: never in the compiler). This file
// decides whether a program needs it, pins the crates it uses and embeds
// the runtime sources.

use jetpack_foundation.[
    FFI_JET_FOUNDATION_CRATE_PATH, NativeSandboxMount,
    foundation_jet_source_root, foundation_try_tree_hash,
]
use core.files as files
use core.sys as sys
use jet_pkg_model.[
    ForeignBridgeError, ForeignIdentityBuilder, pkg_bridge_error, pkg_bridge_sha_file,
]

// One pinned crate: name and Cargo version requirement.
struct FFICrateSpec {
    name: String
    version: String
}

// `wasmtime` backs sandboxed Component Model hosts (
// ); the pin matches the approved Cranelift generation.
FFI_WASMTIME_CRATE_SPEC :: FFICrateSpec{name: "wasmtime", version: "25"}

// Crate dependencies whose Cargo value needs a full TOML table (feature
// flags); emitted verbatim as the right-hand side of `name = …`.
struct FFIFeaturedDep {
    name: String
    toml: String
}

FFI_FEATURED_DEPS :: comptime { [FFIFeaturedDep]{
    {name: "wasmtime", toml: "{{ version = \"25\", features = [\"component-model\"] }}"}
} }

// The hand-written Rust runtimes emitted into the bridge crate. Each is the
// only code that touches its pinned crates.
// Application plugin loader.
FFI_PLUGIN_RUNTIME :: comptime { embed_file("Runtime/Plugin.rs") }
// Compiler-extension host runtime same wasmtime substrate,
// distinct `compiler-extension-v1` world; compiled only by the isolated
// jetpack binary, never mixed into application `core.plugin` bridges.
FFI_COMPILER_EXTENSION_RUNTIME :: comptime { embed_file("Runtime/CompilerExtension.rs") }

// Which bridge-backed Core providers one bridge carries. The regex, archive,
// and stream-codec surfaces are compiled from their canonical Jet source
// modules, so those three are always false for a prepared program.
struct RustBridgeNeeds {
    regex: Bool
    archive: Bool
    compress: Bool
    plugin: Bool

    fn none() -> RustBridgeNeeds Never! {
        RustBridgeNeeds{regex: false, archive: false, compress: false, plugin: false}
    }

    // The providers the program's reached Core surfaces select.
    fn from_used_core(used_core: [String]) -> RustBridgeNeeds Never! {
        needs := RustBridgeNeeds.none()
        loop usage in used_core {
            // (c81): the sandboxed plugin loader.
            if usage == "core.plugin" || usage.starts_with("core.plugin::") || usage.starts_with("core.plugin.") -> needs.plugin = true
        }
        needs
    }

    fn any(self) -> Bool Never! {
        self.regex || self.archive || self.compress || self.plugin
    }
}

// Fingerprint and project the transitive Rust include closure, not a second
// manually maintained list of Prelude inputs.
FFI_JET_FOUNDATION_SOURCE_SCHEMA :: "jet-ffi-foundation-source-v5"

struct JetFoundationSources {
    root: String
    foundation: String
    inputs: [String]
    digest: String
}

// Literal tokens carry a quote prefix, so text inside comments and strings
// cannot manufacture an include. Rust lifetimes are not character literals.
fn pkg_ffi_include_tokens(source: String) -> [String] Never! {
    raw :: source.bytes()
    tokens := [String]{}
    i := 0
    loop i < raw.len() {
        byte :: Int.from_u8(raw[i])
        if byte <= 32 {
            i += 1
            next
        }
        if i + 1 < raw.len() && Int.from_u8(raw[i]) == 47 && Int.from_u8(raw[i + 1]) == 47 {
            loop i < raw.len() && Int.from_u8(raw[i]) != 10 -> i += 1
            next
        }
        if i + 1 < raw.len() && Int.from_u8(raw[i]) == 47 && Int.from_u8(raw[i + 1]) == 42 {
            i += 2
            depth := 1
            loop i < raw.len() && depth > 0 {
                if {
                    i + 1 < raw.len() && Int.from_u8(raw[i]) == 47 && Int.from_u8(raw[i + 1]) == 42 -> {
                        depth += 1
                        i += 2
                    }
                    i + 1 < raw.len() && Int.from_u8(raw[i]) == 42 && Int.from_u8(raw[i + 1]) == 47 -> {
                        depth -= 1
                        i += 2
                    }
                    else -> i += 1
                }
            }
            next
        }
        // Raw strings can have any number of delimiter hashes.
        quote := i
        hashes := 0
        if byte == 114 {
            quote += 1
            loop quote < raw.len() && Int.from_u8(raw[quote]) == 35 {
                hashes += 1
                quote += 1
            }
        }
        if quote < raw.len() && Int.from_u8(raw[quote]) == 34 && (quote == i || byte == 114) {
            value := [U8]{}
            i = quote + 1
            loop i < raw.len() {
                if Int.from_u8(raw[i]) == 34 {
                    end := i + 1
                    loop end < raw.len() && end < i + 1 + hashes && Int.from_u8(raw[end]) == 35 -> end += 1
                    if end == i + 1 + hashes {
                        i = end
                        break
                    }
                }
                if {
                    byte == 34 && Int.from_u8(raw[i]) == 92 && i + 1 < raw.len() -> {
                        i += 1
                        escaped :: raw[i]
                        &value.push(if {
                            Int.from_u8(escaped) == 110 -> U8{10}
                            Int.from_u8(escaped) == 114 -> U8{13}
                            Int.from_u8(escaped) == 116 -> U8{9}
                            else -> escaped
                        })
                    }
                    else -> &value.push(raw[i])
                }
                i += 1
            }
            &tokens.push("\"{String.from_bytes(value) ?? ""}")
            next
        }
        if byte == 39 {
            end := i + 1
            if {
                end < raw.len() && Int.from_u8(raw[end]) == 92 -> end += 2
                else -> end += 1
            }
            if end < raw.len() && Int.from_u8(raw[end]) == 39 {
                i = end + 1
                next
            }
        }
        if {
            (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 -> {
                word := [U8]{}
                loop i < raw.len() {
                    code :: Int.from_u8(raw[i])
                    if !((code >= 65 && code <= 90) || (code >= 97 && code <= 122) || (code >= 48 && code <= 57) || code == 95) -> break
                    &word.push(raw[i])
                    i += 1
                }
                &tokens.push(String.from_bytes(word) ?? "")
            }
            else -> {
                &tokens.push(String.from_bytes([U8]{raw[i]}) ?? "")
                i += 1
            }
        }
    }
    tokens
}

fn pkg_ffi_rust_include_paths(source: String, manifest: String) -> [String] ForeignBridgeError! {
    tokens :: pkg_ffi_include_tokens(source)
    paths := [String]{}
    i := 0
    loop i + 2 < tokens.len() {
        name :: tokens[i]
        if (name != "include" && name != "include_str" && name != "include_bytes") || tokens[i + 1] != "!" || tokens[i + 2] != "(" {
            i += 1
            next
        }
        i += 3
        path := ""
        generated := false
        depth := 1
        loop i < tokens.len() && depth > 0 {
            token :: tokens[i]
            if token == "env" && i + 4 < tokens.len() && tokens[i + 1] == "!" && tokens[i + 2] == "(" && tokens[i + 4] == ")" {
                variable :: tokens[i + 3].removeprefix("\"")
                if {
                    variable == "CARGO_MANIFEST_DIR" -> path = "{path}{manifest}"
                    variable == "OUT_DIR" -> generated = true
                    else -> return Err(pkg_bridge_error("unsupported Rust include environment `{variable}`"))
                }
                i += 5
                next
            }
            if {
                token.starts_with("\"") -> path = "{path}{token.removeprefix("\"")}"
                token == "(" -> depth += 1
                token == ")" -> depth -= 1
                token != "concat" && token != "!" && token != "," -> return Err(pkg_bridge_error("unsupported Rust include expression `{token}`"))
                else -> {}
            }
            i += 1
        }
        if depth != 0 || path == "" -> return Err(pkg_bridge_error("incomplete Rust include expression"))
        // Build-script output is generated inside Cargo's writable target.
        if !generated -> &paths.push(path)
    }
    paths
}

fn pkg_ffi_foundation_rust_sources(directory: String) -[FS]> [String] ForeignBridgeError! {
    paths := [String]{}
    entries :: files.list_dir(directory) ?? return Err(pkg_bridge_error("read foundation sources `{directory}`: {err}"))
    loop entry in entries {
        if entry.name.starts_with(".") || entry.name == "target" -> next
        if {
            entry.is_dir -> {
                loop path in pkg_ffi_foundation_rust_sources(entry.path) -> &paths.push(path)
            }
            entry.name.ends_with(".rs") -> &paths.push(entry.path)
            else -> {}
        }
    }
    &paths.sort()
    paths
}

fn pkg_ffi_foundation_include_closure(root: String, foundation: String) -[FS]> [String] ForeignBridgeError! {
    pending := [(source: String, manifest: String)]{}
    loop path in pkg_ffi_foundation_rust_sources(foundation) -> &pending.push((source: path, manifest: foundation))
    seen := [(source: String, manifest: String)]{}
    external := [String]{}
    index := 0
    loop index < pending.len() {
        item :: pending[index]
        index += 1
        if seen.contains(item) -> next
        &seen.push(item)
        source :: item.source
        manifest :: item.manifest
        if !source.ends_with(".rs") -> next
        text :: files.read(source) ?? return Err(pkg_bridge_error("read Rust include source `{source}`: {err}"))
        loop include in pkg_ffi_rust_include_paths(text, manifest) {
            candidate :: if include.starts_with("/") -> include else -> files.join(files.dirname(source), include)
            stat :: files.stat(candidate) ?? return Err(pkg_bridge_error("Rust include `{candidate}` is unavailable: {err}"))
            if stat.is_symlink || !stat.is_file -> return Err(pkg_bridge_error("Rust include `{candidate}` is not a regular file"))
            path :: files.canonicalize(candidate) ?? return Err(pkg_bridge_error("canonicalize Rust include `{candidate}`: {err}"))
            if !path.starts_with("{root}/") -> return Err(pkg_bridge_error("Rust include `{path}` escapes the source root"))
            if !path.starts_with("{foundation}/") && !external.contains(path) -> &external.push(path)
            next_item :: (source: path, manifest: manifest)
            if !seen.contains(next_item) -> &pending.push(next_item)
        }
    }
    &external.sort()
    external
}

// The absolute path of the bridge's jet-foundation path dependency.
fn pkg_ffi_jet_foundation_crate_path() -[FS, Env]> String ForeignBridgeError! {
    root :: foundation_jet_source_root() ?? return Err(pkg_bridge_error("{err}"))
    Ok(files.join(root, FFI_JET_FOUNDATION_CRATE_PATH))
}

// A real (non-symlink) directory, canonicalized.
fn pkg_ffi_verified_source_directory(path: String, label: String) -[FS, Env]> String ForeignBridgeError! {
    stat :: files.stat(path) ?? return Err(pkg_bridge_error("jet-foundation {label} source `{path}` is unavailable: {err}"))
    if stat.is_symlink || !stat.is_dir -> return Err(pkg_bridge_error("jet-foundation {label} source `{path}` is not a real directory"))
    canonical :: files.canonicalize(path) ?? return Err(pkg_bridge_error("could not canonicalize jet-foundation {label} source `{path}`: {err}"))
    Ok(canonical)
}

fn pkg_ffi_foundation_input_digest(root: String, relative: String, label: String) -[FS]> String ForeignBridgeError! {
    path :: files.join(root, relative)
    stat :: files.stat(path) ?? return Err(pkg_bridge_error("jet-foundation {label} input `{path}` is unavailable: {err}"))
    if stat.is_symlink || !stat.is_file -> return Err(pkg_bridge_error("jet-foundation {label} input `{path}` is not a regular file"))
    pkg_bridge_sha_file(path)
}

// `<relative>\0<digest>`: one fingerprinted foundation input.
fn pkg_ffi_nul_joined(relative: String, digest: String) -> [U8] Never! {
    bytes := relative.bytes()
    &bytes.push(U8{0})
    loop byte in digest.bytes() -> &bytes.push(byte)
    bytes
}

fn pkg_ffi_jet_foundation_sources() -[FS, Env]> JetFoundationSources ForeignBridgeError! {
    root :: foundation_jet_source_root() ?? return Err(pkg_bridge_error("{err}"))
    foundation :: pkg_ffi_verified_source_directory(files.join(root, FFI_JET_FOUNDATION_CRATE_PATH), "crate")
    canonical_root :: files.canonicalize(root) ?? return Err(pkg_bridge_error("canonicalize foundation root: {err}"))
    inputs :: pkg_ffi_foundation_include_closure(canonical_root, foundation)
    foundation_tree :: foundation_try_tree_hash(foundation) ?? return Err(pkg_bridge_error("could not fingerprint jet-foundation source: {err.message()}"))
    identity := ForeignIdentityBuilder.new(FFI_JET_FOUNDATION_SOURCE_SCHEMA)
    &identity.field("foundation-tree", foundation_tree.bytes())
    loop path in inputs {
        relative :: path.removeprefix("{canonical_root}/")
        digest :: pkg_ffi_foundation_input_digest(canonical_root, relative, "include")
        &identity.field("include-input", pkg_ffi_nul_joined(relative, digest))
    }
    Ok(JetFoundationSources{root: canonical_root, foundation: foundation, inputs: inputs, digest: identity.finish()})
}

// Copy one included foundation input into the Linux source-closure stage.
fn pkg_ffi_stage_foundation_input(source_root: String, relative: String, destination_root: String, label: String) ForeignBridgeError! -[FS]> {
    source :: files.join(source_root, relative)
    destination :: files.join(destination_root, relative)
    parent :: files.dirname(destination)
    if parent == "" -> return Err(pkg_bridge_error("jet-foundation {label} input destination `{destination}` has no parent"))
    files.create_dir_all(parent) ?? return Err(pkg_bridge_error("could not stage jet-foundation {label} input directory `{parent}`: {err}"))
    files.copy(source, destination) ?? return Err(pkg_bridge_error("could not stage jet-foundation {label} input `{source}`: {err}"))
}

// Linux projects only discovered external inputs at their original root,
// followed by the complete path crate. Other adapters cannot remap paths.
fn pkg_ffi_jet_foundation_mounts(cache_root: String, sources: JetFoundationSources) -[FS, Env]> [NativeSandboxMount] ForeignBridgeError! {
    mounts := [NativeSandboxMount]{}
    if {
        sys.is_linux() -> {
            closure_root :: files.join(cache_root, ".jet-foundation-source-closure")
            if files.lexists(closure_root) {
                files.remove_all(closure_root) ?? return Err(pkg_bridge_error("could not clear jet-foundation source closure `{closure_root}`: {err}"))
            }
            files.create_dir_all(closure_root) ?? return Err(pkg_bridge_error("create foundation source closure: {err}"))
            loop path in sources.inputs {
                pkg_ffi_stage_foundation_input(sources.root, path.removeprefix("{sources.root}/"), closure_root, "include")
            }
            // Parent is read-only before the crate bind: precreate only its
            // empty destination, never copy or expose unrelated inputs.
            files.create_dir_all(files.join(closure_root, sources.foundation.removeprefix("{sources.root}/"))) ?? return Err(pkg_bridge_error("create foundation crate mount point: {err}"))
            &mounts.push(NativeSandboxMount{source: closure_root, destination: sources.root})
        }
        else -> {
            parents := [String]{}
            loop path in sources.inputs {
                parent :: files.dirname(path)
                if !parents.contains(parent) {
                    &parents.push(parent)
                    &mounts.push(NativeSandboxMount{source: parent, destination: parent})
                }
            }
        }
    }
    &mounts.push(NativeSandboxMount{source: sources.foundation, destination: sources.foundation})
    Ok(mounts)
}
