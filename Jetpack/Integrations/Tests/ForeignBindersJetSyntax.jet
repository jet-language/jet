// The Jet source each worker binder renders must parse under the current
// grammar: retired spellings such as `pub fn` or a prefix `!Error` result are
// parse errors.
use {
    jetpack_integrations.[
        pkg_lua_render_probe, pkg_octave_render_probe, pkg_perl_parse_function_names,
        pkg_perl_render_jet, pkg_php_render_probe, pkg_powershell_parse_function_names,
        pkg_powershell_render_jet, pkg_r_render_probe, pkg_ruby_render_probe,
    ]
    jet_pkg_model.[pkg_com_parse_schema, pkg_com_render_jet]
    jet_lexer.[lex_generated]
    jet_parser.[parse_lexed]
}

// Every lexer and parser error in `source`, one line each.
pkg_test_binder_syntax_errors: fn(source: String) -> [String] Never! {
    errors := [String]{}
    lexed: lex_generated(source.bytes())
    loop diagnostic in lexed.diagnostics {
        errors.push("lex {diagnostic.code}: {diagnostic.what}")
    }
    if errors.len() != 0 -> return errors
    parsed: parse_lexed(lexed)
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == 1 -> errors.push("parse {diagnostic.code}: {diagnostic.what}")
    }
    errors
}

#Test("worker binders render jet that parses under the current grammar") {
    perl: pkg_perl_parse_function_names("sub Transform {{ }}\n".bytes()) ?? panic("Perl subs parse")
    pwsh: pkg_powershell_parse_function_names("Get-Stateful\n".bytes()) ?? panic("PowerShell names parse")
    com: pkg_com_parse_schema("LIB\tOffice Fixture\t{{00000000-0000-0000-0000-000000000001}}\nCLASS\t{{00000000-0000-0000-0000-000000000002}}\tApplication\nMETHOD\tApplication\tWorkbooks\t41\t2\tobject=Workbooks\n".bytes()) ?? panic("COM schema parses")
    rendered: [(name: String, source: String)]{
        (name: "lua", source: pkg_lua_render_probe()),
        (name: "octave", source: pkg_octave_render_probe()),
        (name: "perl", source: pkg_perl_render_jet("ops", perl)),
        (name: "php", source: pkg_php_render_probe()),
        (name: "powershell", source: pkg_powershell_render_jet("ops", pwsh)),
        (name: "r", source: pkg_r_render_probe()),
        (name: "ruby", source: pkg_ruby_render_probe()),
        (name: "com", source: pkg_com_render_jet("office", com)),
    }
    // Report every binder that fails, not only the first.
    failures := [String]{}
    loop binder in rendered {
        errors: pkg_test_binder_syntax_errors(binder.source)
        if errors.len() != 0 -> failures.push("{binder.name} binder output does not parse:\n{errors.join("\n")}\n{binder.source}")
    }
    if failures.len() != 0 -> panic(failures.join("\n\n"))
}
