// Hosted recipe refusal tests. Core/build producer/fingerprint admission is
// owner-gated; refusal must precede validation reads, execution and publication.
// Independent trust and retained-directory publication tests remain below.

fn recipe_test_scratch(label: String) -[FS, Env, Rand]> String {
    token :: random.token_hex(8) ?? panic("draw a recipe test name")
    path :: files.join(sys.temp_dir(), "recipe-{label}-{sys.pid()}-{token}")
    files.create_dir_all(path) ?? panic("create recipe test scratch")
    path
}

fn recipe_test_ctx(src: String, out: String, cache: String, offline: Bool) -> RecipeBuildContext {
    RecipeBuildContext{source_dir: src, output_root: out, tools: [String: String]{}, fetch_cache: cache, offline}
}

fn recipe_test_run_error(recipe: BuildRecipe, ctx: RecipeBuildContext) -[FS, Env, Exec, Net, Rand, Time.Wait]> RecipeDiagnostic {
    if recipe_run(recipe, ctx, None) == {
        .Ok(_) -> panic("the recipe run must fail")
        .Err(error) -> error
    }
}


fn recipe_test_has_stage_leftover(base: String) -[FS]> Bool {
    entries :: files.list_dir(base) ?? panic("list the recipe test base")
    loop entry in entries {
        if entry.name.starts_with("jet-recipe-stage-") -> return true
    }
    false
}

#Test("recipe build denies ambient network") {
    // Ported from build_sandbox.rs:108-130; same invalid locked fetch and E1236 oracle.
    // A fetch with no locked sha256 is ungranted ambient network: E1236.
    base :: recipe_test_scratch("net")
    src :: files.join(base, "src")
    files.create_dir_all(src) ?? panic("src")
    recipe :: BuildRecipe{steps: [BuildStep]{BuildStep.Fetch{url: "https://example.invalid/x.tar", sha256: ""}}}
    error :: recipe_test_run_error(recipe, recipe_test_ctx(src, files.join(base, "out"), files.join(base, "cache"), false))
    assert_eq(error.code, "E1236")
    files.remove_all(base).drop("test cleanup")
}

#Test("recipe build rejects fetch url credentials without echoing them") {
    base :: recipe_test_scratch("fetch-credentials")
    src :: files.join(base, "src")
    out :: files.join(base, "out")
    files.create_dir_all(src) ?? panic("src")
    secret :: "do-not-log-this-token"
    recipe :: BuildRecipe{steps: [BuildStep]{BuildStep.Fetch{url: "https://builder:{secret}@example.invalid/source.tar", sha256: "0".repeat(64)}}}
    error :: recipe_test_run_error(recipe, recipe_test_ctx(src, out, files.join(base, "cache"), false))
    assert_eq(error.code, "E1236")
    assert(!error.what.contains(secret) && !error.why.contains(secret) && !error.fix.contains(secret))
    assert(!files.exists(out))
    assert(recipe_credentialed_fetch_url("https://example.invalid/source.tar?token=hidden"))
    assert(recipe_credentialed_fetch_url("https://example.invalid/source.tar?download=1#token=hidden"))
    assert(recipe_credentialed_fetch_url("https://example.invalid/source.tar?%74oken=hidden"))
    assert(recipe_credentialed_fetch_url("https://example.invalid/source.tar?X-Amz-Credential=hidden"))
    assert(!recipe_credentialed_fetch_url("https://example.invalid/source.tar?download=1"))
    files.remove_all(base).drop("test cleanup")
}

#Test("recipe build output is confined") {
    // Ported from build_sandbox.rs:132-155; dest "../escape" must return E1237.
    // An install targeting a path outside the output root: E1237.
    base :: recipe_test_scratch("confine")
    src :: files.join(base, "src")
    out :: files.join(base, "out")
    files.create_dir_all(src) ?? panic("src")
    files.write(files.join(src, "f"), "hi") ?? panic("source file")
    ctx :: recipe_test_ctx(src, out, files.join(base, "cache"), false)
    escape :: BuildRecipe{steps: [BuildStep]{BuildStep.Install{src: "f", dest: "../escape"}}}
    assert_eq(recipe_test_run_error(escape, ctx).code, "E1237")
    // A confined install succeeds and lands under the output root.
    confined :: BuildRecipe{steps: [BuildStep]{BuildStep.Install{src: "f", dest: "bin/f"}}}
    recipe_run(confined, ctx, None) ?? panic("confined install runs")
    assert(files.is_file(files.join(out, "bin/f")))
    files.remove_all(base).drop("test cleanup")
}

#Test("recipe build tool must be a realized dependency") {
    // Ported from build_sandbox.rs:157-180; validate must reject without executing.
    // An exec naming a tool that is not a realized dep: E1238.
    base :: recipe_test_scratch("tool")
    src :: files.join(base, "src")
    files.create_dir_all(src) ?? panic("src")
    recipe :: BuildRecipe{steps: [BuildStep]{BuildStep.Exec{tool: "gcc", args: [String]{}}}}
    if recipe_validate(recipe, recipe_test_ctx(src, files.join(base, "out"), files.join(base, "cache"), false)) == {
        .Ok(_) -> panic("gcc without a realized dependency must not validate")
        .Err(error) -> assert_eq(error.code, "E1238")
    }
    assert_eq(recipe_test_run_error(recipe, recipe_test_ctx(src, files.join(base, "out"), files.join(base, "cache"), false)).code, "E1238")
    files.remove_all(base).drop("test cleanup")
}

// Ported from build_sandbox.rs:182-206; a declared relative path is not a realized tool.
#Test("recipe validate rejects a relative realized tool path") {
    base :: recipe_test_scratch("relative-tool")
    src :: files.join(base, "src")
    files.create_dir_all(src) ?? panic("src")
    ctx :: RecipeBuildContext{source_dir: src, output_root: files.join(base, "out"), tools: [String: String]{"cc": "cc"}, fetch_cache: files.join(base, "cache"), offline: false}
    recipe :: BuildRecipe{steps: [BuildStep]{BuildStep.Exec{tool: "cc", args: [String]{}}}}
    if recipe_validate(recipe, ctx) == {
        .Ok(_) -> panic("a relative tool path must not validate")
        .Err(error) -> assert_eq(error.code, "E1238")
    }
    files.remove_all(base).drop("test cleanup")
}

#Test("recipe native path succeeds or refuses before launch") {
    if !sys.is_linux() && !sys.is_macos() -> return
    base :: recipe_test_scratch("native-sandbox")
    src :: files.join(base, "src")
    out :: files.join(base, "out")
    marker :: files.join(base, "host-marker")
    files.create_dir_all(src) ?? panic("src")
    shell :: process.which("sh") ?? panic("a shell is required for the native recipe path")
    quoted_marker :: marker.replace("'", "'\\''")
    ctx :: RecipeBuildContext{source_dir: src, output_root: out, tools: [String: String]{"sh": shell}, fetch_cache: files.join(base, "cache"), offline: false}
    recipe :: BuildRecipe{steps: [BuildStep]{BuildStep.Exec{tool: "sh", args: [String]{"-c", "printf ok > \"$JET_BUILD_OUTPUT/ok\"; printf escaped > '{quoted_marker}' || :"}}}}
    result :: recipe_run(recipe, ctx, None)
    status :: foundation_native_sandbox_status()
    if status.available {
        report :: result ?? panic("native recipe sandbox should run")
        expected :: if sys.is_linux() -> "linux-bwrap" else -> "macos-seatbelt"
        assert_eq(report.sandbox_class, expected)
        assert_eq(files.read(files.join(out, "ok")) ?? panic("sandbox output"), "ok")
    } else {
        if result == {
            .Ok(_) -> panic("an unavailable sandbox must refuse")
            .Err(error) -> assert_eq(error.code, "E1275")
        }
    }
    assert(!files.exists(marker))
    files.remove_all(base).drop("test cleanup")
}

#Test("recipe locked fetch roundtrips and is offline satisfiable") {
    // A locked file:// fetch caches by hash, records provenance, and is
    // offline-satisfiable on a second run after the source vanishes.
    base :: recipe_test_scratch("fetch")
    src :: files.join(base, "src")
    out :: files.join(base, "out")
    cache :: files.join(base, "cache")
    files.create_dir_all(out) ?? panic("existing output")
    files.write(files.join(out, "sentinel"), "keep") ?? panic("sentinel")
    secret :: "do-not-log-this-token"
    steps :: [BuildStep]{
        BuildStep.Fetch{url: "https://builder:{secret}@example.invalid/source.tar", sha256: ""},
        BuildStep.Exec{tool: "missing-tool", args: [String]{secret}},
        BuildStep.Install{src: "missing", dest: "../escape"},
        BuildStep.InstallTree{src: "missing", dest: "."}
    }
    loop step in steps {
        error :: recipe_test_run_error(BuildRecipe{steps: [BuildStep]{step}}, recipe_test_ctx(src, out, cache, false))
        assert_eq(error.code, "E1238")
        assert(error.what.contains("not available"))
        assert(error.why.contains("Core/build"))
        assert(!error.what.contains(secret) && !error.why.contains(secret) && !error.fix.contains(secret))
    }
    assert_eq(files.read(files.join(out, "sentinel")) ?? panic("unchanged output"), "keep")
    assert(!files.exists(cache))
    assert(!files.exists(src))
    assert(recipe_test_has_stage_leftover(base) == false)
    files.remove_all(base).drop("test cleanup")
}

#Test("recipe and trust consumers share one hash grant") {
    base :: recipe_test_scratch("trust")
    trust :: files.join(base, "trust")
    recipe :: BuildRecipe{steps: [BuildStep]{BuildStep.Install{src: "a", dest: "a"}}}
    hash :: recipe.recipe_hash()
    assert(recipe_trust_first_build(hash, trust, base) ?? panic("recipe trust grant"))
    assert(trust_is_trusted(trust, base, hash))
    assert_eq(trust_list_entries(trust), [String]{"hash:{hash}"})
    assert(!(recipe_trust_first_build(hash, trust, base) ?? panic("recipe trust idempotent")))
    files.remove_all(base).drop("test cleanup")
}

#Test("hosted recipe validation and logged run refuse before side effects") {
    base :: recipe_test_scratch("validate-refused")
    recipe :: BuildRecipe{steps: [BuildStep]{}}
    ctx :: recipe_test_ctx(files.join(base, "missing"), files.join(base, "out"), files.join(base, "cache"), false)
    if recipe_validate(recipe, ctx) == {
        .Ok(_) -> panic("hosted validation must refuse")
        .Err(error) -> assert_eq(error.code, "E1238")
    }
    attempt := BuildAttempt.new("pkg", "path:missing", "adapter", "", "")
    if recipe_run_logged(recipe, ctx, None, &attempt) == {
        .Ok(_) -> panic("hosted logged execution must refuse")
        .Err(error) -> assert_eq(error.code, "E1238")
    }
    assert_eq(attempt.steps.len(), 0)
    assert(!files.exists(ctx.output_root))
    assert(!files.exists(ctx.fetch_cache))
    files.remove_all(base).drop("test cleanup")
}

fn recipe_test_forbidden_emit(_sandbox: PlanSandbox) -[FS, Env]> BuildPlanFragment StagedPlanActionError! {
    panic("a refused staged-plan callback must not run")
}

#Test("hosted staged plan refuses before callback and artifact publication") {
    base :: recipe_test_scratch("staged-refused")
    artifact :: files.join(base, "artifacts")
    action :: StagedPlanAction.new("discover", 0, 1, [PlanInput]{PlanInput.new("missing", "sha256-input")}, PlanAuthority{tools: [String]{}, effects: [BuildEffect]{}, platform: "linux-x86_64"})
    ctx :: StagedPlanContext{source_dir: files.join(base, "missing"), artifact_root: artifact}
    if recipe_run_staged_plan_action(action, ctx, [String: String]{}, StagedPlanEmitter{emit: recipe_test_forbidden_emit}) == {
        .Ok(_) -> panic("hosted staged-plan execution must refuse")
        .Err(error) -> assert_eq(error.code, "E1238")
    }
    assert(!files.exists(artifact))
    files.remove_all(base).drop("test cleanup")
}

#Test("hosted recipe refusal preserves existing output without creating a stage") {
    base :: recipe_test_scratch("partial-stage")
    src :: files.join(base, "src")
    out :: files.join(base, "out")
    files.create_dir_all(src) ?? panic("src")
    files.write(files.join(src, "tool"), "new") ?? panic("new tool")
    files.create_dir_all(files.join(out, "bin")) ?? panic("out bin")
    files.write(files.join(out, "bin/tool"), "old") ?? panic("old tool")
    recipe :: BuildRecipe{steps: [BuildStep]{
        BuildStep.Install{src: "tool", dest: "bin/tool"},
        BuildStep.Fetch{url: "https://example.invalid/source.tar", sha256: "0".repeat(64)}
    }}
    assert_eq(recipe_test_run_error(recipe, recipe_test_ctx(src, out, files.join(base, "cache"), false)).code, "E1238")
    assert_eq(files.read(files.join(out, "bin/tool")) ?? panic("previous output"), "old")
    assert(!recipe_test_has_stage_leftover(base))
    files.remove_all(base).drop("test cleanup")
}

#Test("recipe publication rejects an output root swap") {
    if sys.is_windows() -> return
    base :: recipe_test_scratch("output-swap")
    outside :: files.join(base, "outside")
    output :: files.join(base, "out")
    files.create_dir_all(outside) ?? panic("outside")
    files.write(files.join(outside, "sentinel"), "keep") ?? panic("sentinel")
    files.symlink(outside, output) ?? panic("symlink output")
    parent :: PinnedRecipeDirectory.open_or_create(base) ?? panic("hold base")
    stage :: parent.exclusive_child("jet-recipe-stage") ?? panic("stage")
    files.write(files.join(stage.path, "new"), "new") ?? panic("staged file")
    if recipe_commit_staged_output(parent, stage.name, output) == {
        .Ok(_) -> panic("a swapped output root must fail closed")
        .Err(error) -> assert_eq(error.code, "E1238")
    }
    assert_eq(files.read(files.join(outside, "sentinel")) ?? panic("sentinel"), "keep")
    assert(!files.exists(files.join(outside, "new")))
    parent.remove_name(stage.name) ?? panic("remove stage")
    files.remove_all(base).drop("test cleanup")
}

#Test("recipe publication stays on the held parent after a path swap") {
    if sys.is_windows() -> return
    base :: recipe_test_scratch("parent-swap")
    parent_path :: files.join(base, "parent")
    replacement :: files.join(base, "replacement")
    moved :: files.join(base, "moved")
    output :: files.join(parent_path, "out")
    files.create_dir_all(parent_path) ?? panic("parent")
    files.create_dir_all(replacement) ?? panic("replacement")
    files.write(files.join(replacement, "sentinel"), "keep") ?? panic("sentinel")
    parent :: PinnedRecipeDirectory.open_or_create(parent_path) ?? panic("hold parent")
    stage :: parent.exclusive_child("jet-recipe-stage") ?? panic("stage")
    files.write(files.join(stage.path, "new"), "new") ?? panic("staged file")
    files.rename(parent_path, moved) ?? panic("move parent")
    files.symlink(replacement, parent_path) ?? panic("replace parent")
    recipe_commit_staged_output(parent, stage.name, output) ?? panic("publish through the held parent")
    assert_eq(files.read(files.join(moved, "out/new")) ?? panic("published"), "new")
    assert(!files.exists(files.join(replacement, "out")))
    assert_eq(files.read(files.join(replacement, "sentinel")) ?? panic("sentinel"), "keep")
    files.remove_all(base).drop("test cleanup")
}

#Test("recipe publication replaces only the complete staged tree") {
    base :: recipe_test_scratch("complete-output")
    output :: files.join(base, "out")
    files.create_dir_all(files.join(output, "old")) ?? panic("old tree")
    files.write(files.join(output, "old/value"), "old") ?? panic("old value")
    parent :: PinnedRecipeDirectory.open_or_create(base) ?? panic("hold base")
    stage :: parent.exclusive_child("jet-recipe-stage") ?? panic("stage")
    files.create_dir_all(files.join(stage.path, "new")) ?? panic("new tree")
    files.write(files.join(stage.path, "new/value"), "new") ?? panic("new value")
    recipe_commit_staged_output(parent, stage.name, output) ?? panic("publish")
    assert_eq(files.read(files.join(output, "new/value")) ?? panic("published"), "new")
    assert(!files.exists(files.join(output, "old")))
    assert(!(parent.existing_directory(stage.name) ?? panic("inspect stage")))
    files.remove_all(base).drop("test cleanup")
}
