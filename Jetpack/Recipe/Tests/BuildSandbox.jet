    recipe_sandbox_test_macos_attack("macos-sibling-write", "if printf escape > \"{{OUTSIDE}}\"; then exit 0; else exit 77; fi")
}

// Ported from build_sandbox.rs:1102-1139.
#Test("macOS native sandbox blocks source symlink escape") {
    if !sys.is_macos() -> return
    base :: recipe_test_scratch("macos-symlink")
    ctx :: recipe_sandbox_test_ctx(base, "bash", "/bin/bash")
    host :: files.join(base, "host-secret")
    outside :: files.join(base, "symlink-result")
    files.write(host, "host-only") ?? panic("host secret")
    files.symlink(host, files.join(ctx.source_dir, "link")) ?? panic("source symlink")
    command :: "if IFS= read -r value < \"{ctx.source_dir}/link\"; then printf '%s' \"$value\" > \"{outside}\"; exit 0; else exit 77; fi"
    error :: recipe_test_run_error(recipe_sandbox_test_exec("bash", [String]{"-c", command}), ctx)
    assert(error.code == "E1237" || error.code == "E1238")
    assert(!files.exists(outside))
    files.remove_all(base).drop("test cleanup")
}

// Ported from build_sandbox.rs:1142-1160; each attack is a separate recipe invocation.
#Test("macOS native sandbox blocks undeclared process network and device") {
    if !sys.is_macos() -> return
    recipe_sandbox_test_macos_attack("macos-process", "if /bin/echo escaped >/dev/null; then exit 0; else exit 77; fi")
    recipe_sandbox_test_macos_attack("macos-network", "if exec 3<>/dev/tcp/127.0.0.1/9; then exit 0; else exit 77; fi")
    recipe_sandbox_test_macos_attack("macos-device", "if test -r /dev/zero; then exit 0; else exit 77; fi")
}

// Ported from build_sandbox.rs:33-52; retain the original manifest bytes and rewrite count.
#Test("sandbox target manifest runs") {
    source :: "\nname: \"mathkit\"\nversion: \"0.1.0\"\npackages: {{\n    mathkit: sandbox {{ export: \"mathkit\" }},\n}}\n"
    facts :: PackageFacts.parse(source, "package.jet") ?? panic("sandbox target manifest should parse")
    assert(facts.packages.len() >= 1)
    assert_eq(facts.packages[0].targets.len(), 1)
    if facts.packages[0].targets[0] == {
        .Plugin(export) -> assert_eq(export, Val("mathkit"))
        else -> panic("sandbox target must be Plugin with mathkit export")
    }
}
