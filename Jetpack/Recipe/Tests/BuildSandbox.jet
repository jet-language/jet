// Ported from build_sandbox.rs:961-996 (shared attack helper).
fn recipe_sandbox_test_macos_attack(label: String, template: String) -[FS, Env, Exec, Net, Rand, Time.Wait]> {
    base :: recipe_test_scratch(label)
    ctx :: recipe_sandbox_test_ctx(base, "bash", "/bin/bash")
    host :: files.join(base, "host-secret")
    outside :: files.join(base, "escape")
    files.write(host, "host-only") ?? panic("host secret")
    command :: template.replace("{{HOST}}", host).replace("{{OUTSIDE}}", outside)
    error :: recipe_test_run_error(recipe_sandbox_test_exec("bash", [String]{"-c", command}), ctx)
    assert(error.code == "E1237" || error.code == "E1238")
    assert(!files.exists(outside))
    files.remove_all(base).drop("test cleanup")
}

// Ported from build_sandbox.rs:1084-1091.
#Test("macOS native sandbox blocks host read") {
    if !sys.is_macos() -> return
    recipe_sandbox_test_macos_attack("macos-host-read", "if IFS= read -r value < \"{{HOST}}\"; then printf '%s' \"$value\" > \"{{OUTSIDE}}\"; exit 0; else exit 77; fi")
}

