// Ported from tests/build_sandbox.rs:1496-1658 via the public Store boundary.
// PENDING-SEAM(package-tests): Jetpack/Recipe has no package.jet.

fn recipe_sandbox_store_ctx(roots: HangarRoots) -> ProviderCtx {
    ProviderCtx{fixtures: None, store_dir: roots.hangar_dir(), offline: false, project_dir: None, nix_index: None, nix_roots: None, allow_local_nix_catalog: false}
}

// Ported from build_sandbox.rs:1496-1569. The build.rs marker must never be written.
#Test("Core Cargo refuses before unavailable sandbox can run build script") {
    base :: recipe_test_scratch("core-cargo-unavailable")
    repo :: files.join(base, "repo")
    marker :: files.join(base, "host-marker")
    files.create_dir_all(repo) ?? panic("repo")
    files.write(files.join(repo, "package.jet"), "name: \"escape\"\nversion: \"0.1.0\"\npackages: {{ escape: library }}\n") ?? panic("manifest")
    files.write(files.join(repo, "lib.rs"), "pub fn value() -> u8 {{ 1 }}\n") ?? panic("lib")
    files.write(files.join(repo, "Cargo.toml"), "[package]\nname = \"escape\"\nversion = \"0.1.0\"\nbuild = \"build.rs\"\n[lib]\npath = \"lib.rs\"\n") ?? panic("Cargo manifest")
    files.write(files.join(repo, "Cargo.lock"), "# This file is automatically @generated by Cargo.\nversion = 3\n\n[[package]]\nname = \"escape\"\nversion = \"0.1.0\"\n\n") ?? panic("Cargo lock")
    // json string spelling is the Rust Debug string spelling for this ASCII scratch path.
    literal :: json.to_string(marker)
    files.write(files.join(repo, "build.rs"), "fn main() {{ let _ = std::fs::write({literal}, \"escaped\"); }}\n") ?? panic("build script")
    table :: SourceTable.from_decls([NamedSourceDecl]{NamedSourceDecl{name: "mine", upstream: "path:{repo}", via: ProviderKind.Core}})
    spec :: RefSpec.classify_in("escape@mine", table) ?? panic("classify")
    roots :: HangarRoots.at(files.join(base, "root"))
    verification := StoreVerification.new()
    previous :: sys.get("JETPACK_FAKE_SANDBOX")
    sys.set("JETPACK_FAKE_SANDBOX", "unavailable")
    result :: store_realize_verified(&verification, roots, recipe_sandbox_store_ctx(roots), RealizeRequest.Package{spec, table})
    recipe_sandbox_test_restore_env("JETPACK_FAKE_SANDBOX", previous)
    if result == {
        .Ok(_) -> panic("an unavailable build sandbox must refuse Core Cargo")
        .Err(error) -> assert("{error}".contains("SandboxUnavailable"))
    }
    assert(!files.exists(marker))
    assert(store_list(&verification, roots).is_empty())
    files.remove_all(base).drop("test cleanup")
}

// Ported from build_sandbox.rs:1572-1658. A successful build has a private consumable lease.
#Test("Core Cargo build is private and not published to shared cache") {
    if !sys.is_linux() -> return
    base :: recipe_test_scratch("core-cargo-private")
    repo :: files.join(base, "repo")
    mirror :: files.join(base, "mirror")
    files.create_dir_all(repo) ?? panic("repo")
    files.create_dir_all(mirror) ?? panic("mirror")
    files.write(files.join(repo, "package.jet"), "name: \"private\"\nversion: \"0.1.0\"\npackages: {{ private: library }}\n") ?? panic("manifest")
    files.write(files.join(repo, "lib.rs"), "pub fn value() -> u8 {{ 1 }}\n") ?? panic("lib")
    files.write(files.join(repo, "Cargo.toml"), "[package]\nname = \"private\"\nversion = \"0.1.0\"\n[lib]\npath = \"lib.rs\"\n") ?? panic("Cargo manifest")
    files.write(files.join(repo, "Cargo.lock"), "# This file is automatically @generated by Cargo.\nversion = 3\n\n[[package]]\nname = \"private\"\nversion = \"0.1.0\"\n\n") ?? panic("Cargo lock")
    table :: SourceTable.from_decls([NamedSourceDecl]{NamedSourceDecl{name: "mine", upstream: "path:{repo}", via: ProviderKind.Core}})
    spec :: RefSpec.classify_in("private@mine", table) ?? panic("classify")
    roots :: HangarRoots.at(files.join(base, "root"))
    store_bind_cache(roots, "public", [String]{mirror}, None, None, true) ?? panic("bind cache")
    verification := StoreVerification.new()
    realized :: store_realize_verified(&verification, roots, recipe_sandbox_store_ctx(roots), RealizeRequest.Package{spec, table}) ?? panic("native Core Cargo build should produce a private lease")
    assert_eq(realized.source_state(), SourceState.Built)
    assert_eq(realized.consumption_status(), ConsumptionStatus.Consumable)
    producer :: ProducerRecord.decode(realized.metadata().producer_record) ?? panic("producer")
    assert_eq(producer.facts.get("build.trust"), Val("private-untrusted"))
    assert_eq(producer.plan.facts().get("build.trust"), Val("private-untrusted"))
    loop item in files.list_dir(mirror) ?? panic("mirror listing") {
        assert(!item.name.ends_with(".narinfo"))
    }
    realized.into_parts().lease.release()
    files.remove_all(base).drop("test cleanup")
}
