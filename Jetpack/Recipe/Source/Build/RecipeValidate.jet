// Recipe carriers and the explicit hosted refusal. Graph admission and its
// fingerprint need the canonical Core/Build producer seam, which is owner-
// gated. No recipe validation or execution is reported as successful without
// that seam; no never-defined Rust-derived plan types remain in this unit.

// What a recipe run needs, and where its confinement boundaries are.
RecipeBuildContext: struct {
    // The staged source tree (read-only by contract).
    source_dir: String
    // The single writable install target; every install destination resolves here.
    output_root: String
    // Realized `Pkg` build-tool deps: tool name -> absolute executable path.
    // An `exec` step may only name a tool present here (E1238).
    tools: [String: String]
    // Where locked fetches cache their bytes (keyed by sha256).
    fetch_cache: String
    // `--offline`: no would-be network fetch may touch the wire.
    offline: Bool
}

// The provenance a recipe run produced: locked fetches plus the effect
// vocabulary the build exercised. Both flow into `.jet/lock`.
RunReport: struct {
    fetches: [FetchRecord]
    // Sorted, de-duplicated effect names (`net.fetch`, `exec:<tool>`, `write`).
    effects: [String]
    // Fingerprint of the canonical finite action graph that admitted the run.
    plan_fingerprint: String
    // The child backend executable steps used, or `non-executing`.
    sandbox_class: String
    // The backend-owned filesystem/process/network/environment/device/resource
    // policy receipt.
    sandbox_policy: String
}

// One refusal shared by recipe validation, execution and staged-plan entry.
recipe_plan_refusal: fn() -> RecipeDiagnostic Never! {
    RecipeDiagnostic.new(
        "E1238",
        "recipe graph admission is not available in the Jet-hosted engine",
        "the canonical Core/Build recipe producer and complete-plan fingerprint seam is not admitted; no recipe step or staged-plan callback was launched.",
        "use an admitted provider without a build recipe; recipe support requires the owner-approved Core/Build seam."
    )
}

recipe_validate: fn(_recipe: BuildRecipe, _ctx: RecipeBuildContext) RecipeDiagnostic! -[FS, Env]> {
    Err(recipe_plan_refusal())
}

// Rust `str::parse::<usize>`: ASCII digits only.
recipe_parse_count: fn(text: String) -> Int? Never! {
    if text == "" -> return None
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if code < 48 || code > 57 -> return None
    }
    parsed: Int.parse(text) ?? return None
    Val(parsed)
}
