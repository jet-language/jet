// Recipe validation, graph admission and lowering into the one executable
// BuildPlan IR (jetpack_build: HermeticBuildContext, ActionSpec, TargetSpec,
// HermeticBuildPlan and its canonical action key), ported from
// jetpack::Recipe (`validate`, `lower_to_plan`, `validate_finite_recipe`,
// `plan_recipe_fingerprint`, `admitted_step_order`).
//
// A recipe graph is admitted (the E1238 registry row) only when
// every tool is a realized dep, every source and destination is confined,
// every fetch is locked and credential-free, the package is one safe path
// segment, there is at least one step, no two install outputs overlap, the
// lowered BuildPlan validates, its execution model is finite and acyclic with
// exactly one recipe action per stage covering every step once, and the
// complete plan fingerprint exists. Anything else is refused with E1236,
// E1237 or E1238 before a step runs.

// The helper version recipe actions pin (Rust `env!("CARGO_PKG_VERSION")` of
// the jetpack crate).
RECIPE_HELPER_VERSION: "0.1.0"

// What a recipe run needs, and where its confinement boundaries are.
RecipeBuildContext: struct {
    // The staged source tree (read-only by contract).
    source_dir: String
    // The single writable install target; every install destination resolves here.
    output_root: String
    // Realized `Pkg` build-tool deps: tool name -> absolute executable path.
    // An `exec` step may only name a tool present here (E1238).
    tools: [String: String]
    // Where locked fetches cache their bytes (keyed by sha256).
    fetch_cache: String
    // `--offline`: no would-be network fetch may touch the wire.
    offline: Bool
}

// The provenance a recipe run produced: locked fetches plus the effect
// vocabulary the build exercised. Both flow into `.jet/lock`.
RunReport: struct {
    fetches: [FetchRecord]
    // Sorted, de-duplicated effect names (`net.fetch`, `exec:<tool>`, `write`).
    effects: [String]
    // Fingerprint of the canonical finite action graph that admitted the run.
    plan_fingerprint: String
    // The child backend executable steps used, or `non-executing`.
    sandbox_class: String
    // The backend-owned filesystem/process/network/environment/device/resource
    // policy receipt.
    sandbox_policy: String

    // Rust `run_report()`: no child launched yet.
    new: fn() -> RunReport Never! {
        RunReport{fetches: [FetchRecord]{}, effects: [String]{}, plan_fingerprint: "", sandbox_class: "non-executing", sandbox_policy: "no child launched"}
    }

    add_effect: fn(&self, name: String) Never! {
        if self.effects.contains(name) -> return
        self.effects.push(name.copy())
        self.effects.sort()
    }

    // The first executed child fixes the run's sandbox class and policy.
    record_sandbox: fn(&self, class: String, policy: String) Never! {
        if self.sandbox_class == "non-executing" {
            self.sandbox_class = class.copy()
            self.sandbox_policy = policy.copy()
        }
    }
}

// Validate a recipe against the safety contract without running it: the read
// path `jet inspect audit` uses (audit never executes). The first violation
// is the error.
recipe_validate: fn(recipe: BuildRecipe, ctx: RecipeBuildContext) RecipeDiagnostic! -[FS, Env]> {
    recipe_validate_finite(recipe, "pkg")
    loop step in recipe.steps {
        if step == {
            .Fetch(url, sha256) -> {
                if recipe_credentialed_fetch_url(url) -> return Err(RecipeDiagnostic.e1236_credentialed_url())
                if !recipe_valid_sha256(sha256) -> return Err(RecipeDiagnostic.e1236_invalid_hash(url, sha256))
            }
            .Exec(tool, _) -> recipe_realized_tool(ctx.tools, tool)
            .Install(src, dest) -> {
                recipe_confined_source(ctx.source_dir, src, false)
                recipe_confined_dest(ctx.output_root, dest)
            }
            .InstallTree(src, dest) -> {
                recipe_confined_source(ctx.source_dir, src, true)
                recipe_confined_dest(ctx.output_root, dest)
            }
        }
    }
}

// Lower a recipe into the one executable BuildPlan IR (E4-JP2 / #419). Each
// step becomes a typed action under one package target; toolchain,
// capability and environment allowlists are declared on each action so the
// action key is the complete cache identity.
recipe_lower_to_plan: fn(recipe: BuildRecipe, package: String, tools: [String: String]) -[FS, Env, Rand]> HermeticBuildPlan RecipeDiagnostic! {
    recipe_validate_finite(recipe, package)
    host: PlatformKey.host()
    plan_ctx := HermeticBuildContext.new()
    action_handles := [HermeticActionHandle]{}
    step_count: recipe.steps.len()
    loop index in 0..<step_count {
        step: recipe.steps[index]
        spec := if step == {
            .Fetch(url, sha256) -> {
                if recipe_credentialed_fetch_url(url) -> return Err(RecipeDiagnostic.e1236_credentialed_url())
                ActionSpec.new([String]{"jet-fetch", url, sha256})
                    .with_kind(.Generic)
                    .with_inputs([String]{"."})
                    .with_cap(.Net)
                    .with_env("SOURCE_DATE_EPOCH", "0")
                    .with_env_allowlist([String]{"SOURCE_DATE_EPOCH"})
                    .with_helper_version("jet-fetch", RECIPE_HELPER_VERSION)
                    .with_label("recipe.step", "fetch")
                    .with_label("fetch.url", url)
                    .with_label("fetch.sha256", sha256)
            }
            .Exec(tool, args) -> {
                tool_path: recipe_realized_tool(tools, tool)
                argv := [String]{tool_path}
                loop arg in args -> argv.push(arg.copy())
                ActionSpec.new(argv)
                    .with_kind(.Compile)
                    .with_inputs([String]{"."})
                    .with_cap(.Exec)
                    .with_env("SOURCE_DATE_EPOCH", "0")
                    .with_env("JET_PROFILE", "default")
                    .with_env_allowlist([String]{"SOURCE_DATE_EPOCH", "JET_PROFILE"})
                    .with_helper_version(tool, "declared")
                    .with_label("recipe.step", "exec")
                    .with_label("recipe.tool", tool)
            }
            .Install(src, dest) -> {
                ActionSpec.new([String]{"jet-install", src, dest})
                    .with_kind(.SourceArchive)
                    .with_inputs([String]{src})
                    .with_cap(.FS)
                    .with_env("SOURCE_DATE_EPOCH", "0")
                    .with_env_allowlist([String]{"SOURCE_DATE_EPOCH"})
                    .with_helper_version("jet-install", RECIPE_HELPER_VERSION)
                    .with_label("recipe.step", "install")
                    .with_label("install.dest", dest)
            }
            .InstallTree(src, dest) -> {
                ActionSpec.new([String]{"jet-install-tree", src, dest})
                    .with_kind(.SourceArchive)
                    .with_inputs([String]{src})
                    .with_cap(.FS)
                    .with_env("SOURCE_DATE_EPOCH", "0")
                    .with_env_allowlist([String]{"SOURCE_DATE_EPOCH"})
                    .with_helper_version("jet-install-tree", RECIPE_HELPER_VERSION)
                    .with_label("recipe.step", "install-tree")
                    .with_label("install.dest", dest)
            }
        }
        outputs := [String]{recipe_step_marker(package, index)}
        if step == {
            .Install(_, dest) -> outputs.push(recipe_declared_output_path(package, dest))
            .InstallTree(_, dest) -> outputs.push(recipe_declared_output_path(package, dest))
            else -> {}
        }
        spec = spec.with_outputs(outputs)
        if index > 0 -> spec = spec.with_inputs([String]{recipe_step_marker(package, index - 1)})
        spec = spec
            .with_label("stage.index", "{index}")
            .with_label("stage.bound", "{step_count}")
            .with_label("authority.effect", step.capability())
            .with_label("platform.os", host.os)
            .with_label("platform.arch", host.arch)
        handle: plan_ctx.action("recipe-{package}-{index}", spec) ?? return Err(RecipeDiagnostic.new("E1238", "recipe step could not lower into BuildPlan", err.debug_text(), "fix the recipe step so it declares a valid action."))
        action_handles.push(handle)
    }
    package_spec := TargetSpec.new().with_metadata("profile", "default")
    loop handle in action_handles -> package_spec = package_spec.with_action(handle)
    package_target: plan_ctx.add_package(package, package_spec) ?? return Err(RecipeDiagnostic.new("E1238", "recipe package `{package}` could not lower into BuildPlan", err.debug_text(), "choose a unique package name for the recipe target."))
    plan: plan_ctx.plan_with_default(package_target) ?? return Err(RecipeDiagnostic.new("E1238", "recipe BuildPlan failed validation", err.debug_text(), "resolve duplicate outputs or empty steps before caching."))
    Ok(plan)
}

// `.jet/recipe/<package>/step-<index>.stamp`.
recipe_step_marker: fn(package: String, index: Int) -> String Never! {
    ".jet/recipe/{package}/step-{index}.stamp"
}

// A recipe is finite and staged: a safe one-segment package name, at least
// one step, and install outputs that never overlap one another.
recipe_validate_finite: fn(recipe: BuildRecipe, package: String) RecipeDiagnostic! {
    if package == "" || package == "." || package == ".." || pkg_text_has_control(package) || package.contains("/") || package.contains("\\") {
        return Err(RecipeDiagnostic.e1238_plan("recipe package name is not one safe path segment"))
    }
    if recipe.steps.len() == 0 -> return Err(RecipeDiagnostic.e1238_plan("recipe must declare at least one finite staged action"))
    root: recipe_normalize(".jet/recipe/{package}/outputs")
    declared := [RecipeDeclaredOutput]{}
    loop index in 0..<recipe.steps.len() {
        target: if recipe.steps[index] == {
            .Install(_, dest) -> RecipeOutputTarget{dest, is_tree: false}
            .InstallTree(_, dest) -> RecipeOutputTarget{dest, is_tree: true}
            else -> next
        }
        output: recipe_declared_output_path(package, target.dest)
        if !target.is_tree && output == root {
            return Err(RecipeDiagnostic.e1238_plan("file install at recipe step {index} must declare a file below the output root"))
        }
        step_name: "recipe-{package}-{index}"
        loop previous in declared {
            if recipe_output_paths_overlap(previous.output, output) {
                return Err(RecipeDiagnostic.e1238_output_conflict(previous.output, previous.step, output, step_name))
            }
        }
        declared.push(RecipeDeclaredOutput{output, step: step_name})
    }
}

// One install destination and whether it is a whole tree.
RecipeOutputTarget: struct {
    dest: String
    is_tree: Bool
}

// A declared staged output and the step that owns it.
RecipeDeclaredOutput: struct {
    output: String
    step: String
}

// The staged output path an install destination declares under
// `.jet/recipe/<package>/outputs` (E1237 on escape).
recipe_declared_output_path: fn(package: String, dest: String) -> String RecipeDiagnostic! {
    if dest == "" || pkg_text_has_control(dest) || files.is_abs(dest) || recipe_has_parent_component(dest) {
        return Err(RecipeDiagnostic.e1237(dest))
    }
    root: ".jet/recipe/{package}/outputs"
    normalized: recipe_normalize("{root}/{dest}")
    if !recipe_path_within(normalized, recipe_normalize(root)) -> return Err(RecipeDiagnostic.e1237(dest))
    Ok(normalized)
}

// Equal paths, or one nested below the other at a separator boundary.
recipe_output_paths_overlap: fn(left: String, right: String) -> Bool Never! {
    recipe_path_within(left, right) || recipe_path_within(right, left)
}

// Hangar cache-identity hook: the recipe fingerprint is the complete plan
// key (E4-JP2), written into `CacheIdentity.recipe_fingerprint`.
recipe_plan_fingerprint: fn(plan: HermeticBuildPlan) -> String RecipeDiagnostic! {
    if plan.execution_model() == {
        .Ok(_) -> {}
        .Err(error) -> { return Err(RecipeDiagnostic.new("E1238", "could not admit lowered BuildPlan execution graph", error.debug_text(), "remove cyclic or incomplete stage dependencies before caching.")) }
    }
    Ok(build_complete_recipe_fingerprint(plan))
}

// The recipe step indexes in the order the admitted execution model runs
// them: exactly one action per finite stage, every step exactly once.
recipe_admitted_step_order: fn(plan: HermeticBuildPlan, step_count: Int) -> [Int] RecipeDiagnostic! {
    model: plan.execution_model() ?? return Err(RecipeDiagnostic.new("E1238", "recipe action graph is not finite and acyclic", err.debug_text(), "remove cyclic or incomplete stage dependencies before execution."))
    seen := [Bool]{}
    loop _ in 0..<step_count -> seen.push(false)
    order := [Int]{}
    loop stage in model.stages {
        if stage.actions.len() != 1 -> return Err(RecipeDiagnostic.e1238_plan("recipe stage graph must admit exactly one action per finite stage"))
        action_id: stage.actions[0]
        if action_id < 0 || action_id >= plan.actions.len() -> return Err(RecipeDiagnostic.e1238_plan("recipe stage graph refers to an unknown action"))
        action: plan.actions[action_id]
        index_text: action.labels.get("stage.index") ?? return Err(RecipeDiagnostic.e1238_plan("recipe action is missing its finite stage index"))
        index: recipe_parse_count(index_text) ?? return Err(RecipeDiagnostic.e1238_plan("recipe action is missing its finite stage index"))
        bound_text: action.labels.get("stage.bound") ?? return Err(RecipeDiagnostic.e1238_plan("recipe action is missing its finite stage bound"))
        bound: recipe_parse_count(bound_text) ?? return Err(RecipeDiagnostic.e1238_plan("recipe action is missing its finite stage bound"))
        if bound != step_count || index != stage.index || index >= step_count {
            return Err(RecipeDiagnostic.e1238_plan("recipe action stage facts do not match the finite recipe bound"))
        }
        if seen[index] -> return Err(RecipeDiagnostic.e1238_plan("recipe stage graph repeats one action identity"))
        seen[index] = true
        order.push(index)
    }
    if order.len() != step_count || seen.contains(false) {
        return Err(RecipeDiagnostic.e1238_plan("recipe stage graph does not cover every declared recipe action"))
    }
    Ok(order)
}

// Rust `str::parse::<usize>`: ASCII digits only.
recipe_parse_count: fn(text: String) -> Int? Never! {
    if text == "" -> return None
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if code < 48 || code > 57 -> return None
    }
    parsed: Int.parse(text) ?? return None
    Val(parsed)
}
