// Local Nix fallback identity claims. Each claim works in its own scratch
// directory and removes it.
use {
    files: core.files
    sys: core.sys
    jetpack_foundation.[SOURCE_ROOT_DIR]
    jetpack_nix.[NIX_LOCKED_NIXPKGS_PREFIX, NixFallbackIdentity]
    jet_pkg_model.[pkg_sha256_hex]
}

NIX_TEST_FALLBACK_REVISION: "b5aa0fbd538984f6e3d201be0005b4463d8b09f8"

nix_test_fallback_root: fn(label: String) -[FS]> String {
    files.tmpdir("jetpack-nix-fallback-{label}-") ?? panic("scratch directory")
}

nix_test_write_project: fn(root: String, exact: String) -[FS]> {
    managed: files.join(root, SOURCE_ROOT_DIR)
    files.create_dir_all(managed) ?? panic("managed directory")
    files.write(files.join(managed, "lock"), "version = 1\n\n[[source_channel]]\nname = \"nixpkgs\"\nchannel = \"nixpkgs-unstable\"\nexact = \"{exact}\"\n\n[root]\ndependencies = []\n") ?? panic("project lock")
}

nix_test_fallback_observed: fn(root: String) -[FS, Env]> NixFallbackIdentity {
    executable: files.join(root, "nix")
    files.write(executable, "nix-test-binary") ?? panic("test executable")
    files.set_mode(executable, 0o755) ?? panic("executable mode")
    canonical: files.canonicalize(executable) ?? panic("canonical executable")
    NixFallbackIdentity.from_observed(canonical, pkg_sha256_hex("nix-test-binary".bytes()), "2.35.2", NIX_TEST_FALLBACK_REVISION, "x86_64-linux", [String]{"ripgrep"}, nix_test_repeat("a", 64)) ?? panic("observed identity")
}

nix_test_repeat: fn(text: String, count: Int) -> String {
    parts := [String]{}
    loop _ in 0..<count -> parts.push(text.copy())
    parts.join("")
}

nix_test_request_refused: fn(identity: NixFallbackIdentity, input: String, system: String, attr: [String], lock_sha256: String) -> Bool {
    if identity.validate_request(input, system, attr, lock_sha256) == {
        .Ok(_) -> false
        .Err(_) -> true
    }
}

#Test("nix fallback identity contains every exact input") {
    root: nix_test_fallback_root("identity")
    identity: nix_test_fallback_observed(root)
    assert_eq(identity.locked_nixpkgs_input(), "{NIX_LOCKED_NIXPKGS_PREFIX}{NIX_TEST_FALLBACK_REVISION}")
    assert_eq(identity.attrpath(), "ripgrep")
    provenance: identity.provenance()
    round_trip: NixFallbackIdentity.from_provenance(provenance) ?? panic("provenance round trip")
    assert_eq(round_trip, identity)
    assert(provenance.contains("\"executable_sha256\""))
    assert(provenance.contains("\"nixpkgs_revision\""))
    assert(provenance.contains("\"lock_sha256\""))
    with_unknown: provenance.replace(",\"lock_sha256\"", ",\"unexpected\":\"value\",\"lock_sha256\"")
    if NixFallbackIdentity.from_provenance(with_unknown) == {
        .Ok(_) -> panic("an unknown provenance field must be rejected")
        .Err(_) -> {}
    }
    files.remove_all(root) ?? panic("scratch cleanup")
}

#Test("nix fallback identity rejects ambient nixpkgs and drift") {
    root: nix_test_fallback_root("request")
    identity: nix_test_fallback_observed(root)
    locked: identity.locked_nixpkgs_input()
    ripgrep: [String]{"ripgrep"}
    digest: nix_test_repeat("a", 64)
    assert(nix_test_request_refused(identity, "nixpkgs#ripgrep", "x86_64-linux", ripgrep, digest))
    assert(nix_test_request_refused(identity, locked, "aarch64-linux", ripgrep, digest))
    assert(nix_test_request_refused(identity, locked, "x86_64-linux", [String]{"jq"}, digest))
    assert(nix_test_request_refused(identity, locked, "x86_64-linux", ripgrep, nix_test_repeat("b", 64)))
    identity.validate_request(locked, "x86_64-linux", ripgrep, digest) ?? panic("the exact request is accepted")
    files.remove_all(root) ?? panic("scratch cleanup")
}

#Test("nix project binding rejects unpinned lock input") {
    root: nix_test_fallback_root("lock")
    nix_test_write_project(root, "nixpkgs#nixos-unstable")
    executable: files.join(root, "missing-nix")
    if NixFallbackIdentity.project_lock_sha256(root, "nixpkgs") == {
        .Ok(_) -> panic("an unpinned lock input must be rejected")
        .Err(error) -> assert(error.message().contains("ambient or unpinned"))
    }
    assert(!files.exists(executable))
    files.remove_all(root) ?? panic("scratch cleanup")
}

#Test("nix project binding reads version from the bound executable") {
    if sys.family() == "windows" -> return
    root: nix_test_fallback_root("bound")
    nix_test_write_project(root, "{NIX_LOCKED_NIXPKGS_PREFIX}{NIX_TEST_FALLBACK_REVISION}")
    executable: files.join(root, "nix")
    files.write(executable, "#!/bin/sh\nprintf 'nix (Nix) 2.35.2\\n'") ?? panic("test executable")
    files.set_mode(executable, 0o755) ?? panic("executable mode")
    identity: NixFallbackIdentity.from_project(root, "nixpkgs", executable, "x86_64-linux", [String]{"ripgrep"}) ?? panic("bound identity")
    assert_eq(identity.version, "2.35.2")
    assert_eq(identity.nixpkgs_revision, NIX_TEST_FALLBACK_REVISION)
    assert_eq(identity.attrpath(), "ripgrep")
    assert_eq(identity.locked_nixpkgs_input(), "{NIX_LOCKED_NIXPKGS_PREFIX}{NIX_TEST_FALLBACK_REVISION}")
    files.remove_all(root) ?? panic("scratch cleanup")
}
