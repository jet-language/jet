// Rust: crates/jetpack/src/NixIndex.rs:4072
fn collect_text_files(path: OSPath, result: &[OSPath]) -> {
    // GATE #4494: std directory-entry type queries must not follow symlinks.
    loop entry in std.fs.read_dir(path) ?? panic("read directory") {
        item :: entry ?? panic("directory entry")
        kind :: item.file_type() ?? panic("entry type")
        if kind.is_dir() {
            collect_text_files(item.path(), &result)
        } else if kind.is_file() {
            &result.push(item.path())
        }
    }
}

// Rust: crates/jetpack/src/NixIndex.rs:4084
fn branded_host(token: String) -> String? {
    trimmed := token.trim_matches((character: Char) -> "`!#$%&*+,;<>?\\][}{)(".contains(character)) // #4303
    value :: if trimmed.starts_with("https://") -> trimmed.removeprefix("https://") else if trimmed.starts_with("http://") -> trimmed.removeprefix("http://") else -> trimmed
    authority :: value.split((character: Char) -> character == '/' || character == '?' || character == '#').next() ?? return None
    hostpart :: authority.rsplit("@").next() ?? return None
    hostview :: hostpart.split(":").next() ?? return None
    host := hostview.trim_end_matches('.') // #4303
    is_jet_domain := false
    loop label in host.split(".") {
        if label == "jet" || label == "jet-lang" -> is_jet_domain = true
    }
    is_owned :: host == "jet-lang.dev" || host.ends_with(".jet-lang.dev")
    if is_jet_domain && !is_owned -> Val(host) else -> None
}

// Rust: crates/jetpack/src/NixIndex.rs:4133
#Test("shipped_jet_domains_use_owned_domain") {
    // GATE #4494: package-root environment and native UTF-8 filesystem reads.
    repo :: OSPath.from_text(env!("CARGO_MANIFEST_DIR")).join("../..")
    paths := [OSPath]{}
    loop relative in [String]{"crates", "Source", "Docs"} -> collect_text_files(repo.join(relative), &paths)
    violations := [String]{}
    loop path in paths {
        text := ""
        if std.fs.read_to_string(path) == {
            .Ok(value) -> text = value
            .Err(_) -> continue
        }
        line_number := 0
        loop line in text.lines() {
            line_number += 1
            loop token in line.split((character: Char) -> character.is_whitespace() || character == '"' || character == '\'' || character == '`' || character == '<' || character == '>') {
                if branded_host(token) == {
                    .Val(host) -> &violations.push("{path.display()}:{line_number} ({host})")
                    else -> {}
                }
            }
        }
    }
    assert(violations.is_empty(), "unowned Jet-branded host(s) in shipped surfaces:\n{violations.join("\n")}")
}
