// Rust: crates/jetpack/src/NixIndex.rs:3873
#Test("nix_index_rejects_forged_stale_cross_system_duplicate_and_ambiguous_input") {
    if NixIndexDocument.parse(`{"schema":1,"schema":1}`.bytes()) == {
        .Ok(_) -> panic("duplicate keys must be rejected")
        else -> {}
    }
    ripgrep :: NixIndexRecordWire.from_record(nix_test_ripgrep_record())
    duplicate_records := nix_test_document_for(ripgrep)
    &duplicate_records.records.push(ripgrep)
    assert(nix_test_document_rejected(duplicate_records))
    duplicate_names := ~ripgrep
    &duplicate_names.outputs.push(NixIndexOutputWire{name: "out", store_path: NIX_TEST_AUX_OUT})
    assert(nix_test_document_rejected(nix_test_document_for(duplicate_names)))
    duplicate_paths :: NixIndexRecordWire{attrpath: [String]{"ripgrep"}, version: "15.2.0", drv_path: NIX_TEST_RIPGREP_DRV, outputs: [NixIndexOutputWire]{NixIndexOutputWire{name: "out", store_path: NIX_TEST_RIPGREP_OUT}, NixIndexOutputWire{name: "bin", store_path: NIX_TEST_RIPGREP_OUT}}}
    assert(nix_test_document_rejected(nix_test_document_for(duplicate_paths)))
    empty_version := ~ripgrep
    empty_version.version = ""
    assert(nix_test_document_rejected(nix_test_document_for(empty_version)))
    no_outputs := ~ripgrep
    no_outputs.outputs = [NixIndexOutputWire]{}
    assert(nix_test_document_rejected(nix_test_document_for(no_outputs)))
    no_primary :: NixIndexRecordWire{attrpath: [String]{"ripgrep"}, version: "15.2.0", drv_path: NIX_TEST_RIPGREP_DRV, outputs: [NixIndexOutputWire]{NixIndexOutputWire{name: "dev", store_path: NIX_TEST_RIPGREP_OUT}}}
    assert(nix_test_document_rejected(nix_test_document_for(no_primary)))
    if nix_index_validate_store_path("/nix/store/not-a-store-path", false) == {
        .Ok(_) -> panic("a malformed store path must be rejected")
        else -> {}
    }
    fixture :: nix_test_signed_fixture_at(NIX_TEST_LOOPBACK_ENDPOINT)
    client :: nix_test_signed_client(fixture, NIX_TEST_LOOPBACK_ENDPOINT, fixture.responses, NixIndexClock.Fixed(NIX_TEST_FIXTURE_NOW), false)
    key := nix_test_ripgrep_key()
    _ :: client.resolve(key) ?? panic("signed resolution")
    assert(nix_test_generation_rejected(client, 0, 1723000000, "stale"))
    assert(nix_test_generation_rejected(client, 1, 1724000000, "same-generation-fork"))
    key.attrpath = [String]{"not-the-requested-attr"}
    missing :: nix_test_resolve_error(client, key)
    if missing == {
        .NotIndexed(_, _, _, _, _) -> {}
        else -> panic("missing attribute must be NotIndexed")
    }
    key.system = "aarch64-linux"
    assert(nix_test_is_invalid(nix_test_resolve_error(client, key)))
    files.remove_all(fixture.root) ?? panic("scratch cleanup")
}

