// Nix store-path calculus: Nix32, `compressHash`, and the store, output,
// fixed-output and text paths of the Nix 2.34 `store-path.md` and `nix32.md`
// protocols. SHA-256 is the unit's shared implementation.

@NIX_DEFAULT_STORE_DIR :: "/nix/store"
@NIX_NIX32_ALPHABET :: "0123456789abcdfghijklmnpqrsvwxyz"
@NIX_STORE_PATH_DIGEST_CHARS :: 32
@NIX_COMPRESSED_HASH_BYTES :: 20

fn nix_sha256_digest(bytes: [U8]) -> [U8] !Never {
    mir_sha256_bytes(bytes) ?? panic("SHA-256 indexed outside its padded blocks")
}

fn nix_hex(bytes: [U8]) -> String !Never {
    mir_sha256_hex_bytes(bytes) ?? panic("hex rendering failed")
}

// Nix32 of `bytes`, emitted from the most significant 5-bit group down.
pub fn nix_nix32_encode(bytes: [U8]) -> String !Never {
    if bytes.len() == 0 -> return ""
    alphabet :: @NIX_NIX32_ALPHABET.bytes()
    length :: (bytes.len() * 8 - 1) /% 5 + 1
    out := [U8]{}
    group := length - 1
    loop group >= 0 {
        bit :: group * 5
        index :: bit /% 8
        shift :: bit % 8
        value := Int.from_u8(bytes[index]) >> shift
        if index < bytes.len() - 1 -> value |= Int.from_u8(bytes[index + 1]) << (8 - shift)
        out.push(alphabet[value & 31])
        group -= 1
    }
    String.from_bytes(out) ?? panic("Nix32 alphabet is ASCII")
}

// Raw bytes of Nix32 `text` (length ceil(chars * 5 / 8); a high group that
// carries no bits past the last byte adds no padding byte, as in Nix).
pub fn nix_nix32_decode(text: String) -> [U8] !NixError {
    scalars := [String]{}
    loop scalar in text.chars() -> scalars.push("{scalar}")
    folded := [Int]{}
    count :: scalars.len()
    loop group in 0..<count {
        scalar :: scalars[count - 1 - group]
        digit :: nix_nix32_digit(scalar)
        if digit < 0 -> return Err(NixError.DrvParse("invalid Nix32 character: {nix_debug_scalar(scalar)}"))
        bit :: group * 5
        index :: bit /% 8
        shift :: bit % 8
        loop folded.len() <= index -> folded.push(0)
        folded[index] = folded[index] | ((digit << shift) & 255)
        carry :: digit >> (8 - shift)
        if carry != 0 {
            loop folded.len() <= index + 1 -> folded.push(0)
            folded[index + 1] = folded[index + 1] | carry
        }
    }
    out := [U8]{}
    loop value in folded -> out.push(U8{value})
    Ok(out)
}

fn nix_nix32_digit(scalar: String) -> Int !Never {
    alphabet :: @NIX_NIX32_ALPHABET.bytes()
    bytes :: scalar.bytes()
    if bytes.len() != 1 -> return -1
    loop index in 0..<alphabet.len() {
        if alphabet[index] == bytes[0] -> return index
    }
    -1
}

fn nix_is_nix32_byte(byte: U8) -> Bool !Never {
    loop candidate in @NIX_NIX32_ALPHABET.bytes() {
        if candidate == byte -> return true
    }
    false
}

// XOR-fold `hash` down to `size` bytes (Nix `compressHash`).
pub fn nix_compress_hash(hash: [U8], size: Int) -> [U8] !Never {
    folded := [Int]{}
    loop _ in 0..<size -> folded.push(0)
    loop index in 0..<hash.len() {
        slot :: index % size
        folded[slot] = folded[slot] ~| Int.from_u8(hash[index])
    }
    out := [U8]{}
    loop value in folded -> out.push(U8{value})
    out
}

// `makeStorePath(type, "sha256:"+hex, name)`:
// `{store}/{nix32(compress(sha256(fingerprint), 20))}-{name}`.
pub fn nix_make_store_path(store_dir: String, type_text: String, hash_with_algo: String, name: String) -> String !Never {
    fingerprint :: "{type_text}:{hash_with_algo}:{store_dir}:{name}"
    digest :: nix_compress_hash(nix_sha256_digest(fingerprint.bytes()), @NIX_COMPRESSED_HASH_BYTES)
    "{store_dir}/{nix_nix32_encode(digest)}-{name}"
}

// `drvName`, or `drvName-output` when the output is not `out`.
pub fn nix_output_path_name(drv_name: String, output_name: String) -> String !Never {
    if output_name == "out" -> return ~drv_name
    "{drv_name}-{output_name}"
}

// Input-addressed output path from a `hashDerivationModulo` digest.
pub fn nix_make_output_path(store_dir: String, output_id: String, modulo_hash: [U8], drv_name: String) -> String !Never {
    nix_make_store_path(store_dir, "output:{output_id}", "sha256:{nix_hex(modulo_hash)}", nix_output_path_name(drv_name, output_id))
}

// Fixed-output path (`makeFixedOutputPath`); `method_algo` is the ATerm form
// (`sha256`, `r:sha256`, `sha512`, `r:sha512`, ...).
pub fn nix_make_fixed_output_path(store_dir: String, name: String, method_algo: String, hash_hex: String) -> String !Never {
    if method_algo == "r:sha256" -> return nix_make_store_path(store_dir, "source", "sha256:{hash_hex}", name)
    // flat, non-SHA-256 NAR and git: sha256("fixed:out:" + methodAlgo + ":" + hex + ":")
    digest :: nix_sha256_digest("fixed:out:{method_algo}:{hash_hex}:".bytes())
    nix_make_store_path(store_dir, "output:out", "sha256:{nix_hex(digest)}", name)
}

// Text-method content-addressed path (derivations): type `text{:ref}*` over
// the sorted references.
pub fn nix_make_text_path(store_dir: String, name: String, contents: [U8], references: [String]) -> String !Never {
    sorted := ~references
    sorted.sort()
    type_text := "text"
    loop reference in sorted -> type_text = "{type_text}:{reference}"
    nix_make_store_path(store_dir, type_text, "sha256:{nix_hex(nix_sha256_digest(contents))}", name)
}

// The name after `<digest>-` in a store path's basename (keeps `.drv`).
pub fn nix_store_path_name(store_path: String) -> String !NixError {
    base :: store_path.cut_last("/")?.after ?? store_path
    parts :: base.split_once("-") ?? return Err(NixError.DrvPath("not a store path basename: {base}"))
    Ok(parts.after)
}

// A derivation's name: its store path name without the `.drv` suffix.
pub fn nix_drv_name_from_path(drv_path: String) -> String !NixError {
    name :: nix_store_path_name(drv_path)
    Ok(name.removesuffix(".drv"))
}

// Sorted, unique `{store_dir}/{nix32 digest}-{name}` references found in
// `bytes`; the name runs over printable bytes other than quotes.
pub fn nix_scan_store_path_digests(store_dir: String, bytes: [U8]) -> [String] !Never {
    prefix :: "{store_dir}/".bytes()
    found := [String]{}
    index := 0
    loop index + prefix.len() + @NIX_STORE_PATH_DIGEST_CHARS <= bytes.len() {
        if pkg_bytes_starts_with(bytes, index, prefix) && nix_is_digest_at(bytes, index + prefix.len()) {
            end := index + prefix.len() + @NIX_STORE_PATH_DIGEST_CHARS
            if end < bytes.len() && Int.from_u8(bytes[end]) == 45 {
                end += 1
                loop end < bytes.len() && nix_is_store_name_byte(Int.from_u8(bytes[end])) -> end += 1
                // The store directory is text and the digest and name are ASCII.
                found.push(pkg_bytes_text(bytes, index, end))
            }
        }
        index += 1
    }
    nixeval_sorted_unique(found)
}

fn nix_is_digest_at(bytes: [U8], start: Int) -> Bool !Never {
    loop offset in 0..<@NIX_STORE_PATH_DIGEST_CHARS {
        if !nix_is_nix32_byte(bytes[start + offset]) -> return false
    }
    true
}

// ASCII graphic bytes other than `"` and `'`.
fn nix_is_store_name_byte(code: Int) -> Bool !Never {
    code >= 33 && code <= 126 && code != 34 && code != 39
}

// Rust `{:?}` rendering of one `char`.
fn nix_debug_scalar(scalar: String) -> String !Never {
    bytes :: scalar.bytes()
    code :: if bytes.len() == 1 -> Int.from_u8(bytes[0]) else -> 128
    escaped :: if code == {
        39 -> "\\'"
        92 -> "\\\\"
        10 -> "\\n"
        13 -> "\\r"
        9 -> "\\t"
        0 -> "\\0"
        else -> nix_debug_control(scalar, code)
    }
    "'{escaped}'"
}

fn nix_debug_control(scalar: String, code: Int) -> String !Never {
    if code >= 32 && code != 127 -> return ~scalar
    digits :: "0123456789abcdef".bytes()
    out := [U8]{}
    if code >= 16 -> out.push(digits[code /% 16])
    out.push(digits[code % 16])
    hex :: String.from_bytes(out) ?? panic("hex digits are ASCII")
    open :: "{{"
    close :: "}}"
    "\\u{open}{hex}{close}"
}

// Rust `{:?}` rendering of an `Option<char>`.
fn nix_debug_optional_scalar(scalar: ?String) -> String !Never {
    if scalar == {
        .Val(value) -> "Some({nix_debug_scalar(value)})"
        else -> "None"
    }
}
