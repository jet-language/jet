// `hashDerivationModulo` and the fail-closed path verifiers of Nix's
// `derivations.cc`. Input derivations are read from an in-memory store; a
// host `/nix/store` reader fills the same map at the effect boundary.

pub struct NixDerivationStore {
    pub derivations: [String: NixDerivation]
    // Modulo digests by mask and derivation path.
    memo: [String: [String: [U8]]]

    fn read(self, drv_path: String) -> NixDerivation NixError! {
        derivation :: self.derivations.get(drv_path) ?? return Err(NixError.DrvIO("missing drv in map store: {drv_path}"))
        Ok(derivation)
    }

    // Output name -> SHA-256 modulo digest. `mask_outputs` is true for the
    // derivation's own output paths (`staticOutputHashes`) and false for the
    // digests substituted into a parent's inputs (`pathDerivationModulo`).
    fn hash_modulo(&self, drv_path: String, drv: NixDerivation, mask_outputs: Bool) -> [String: [U8]] NixError! {
        key :: "{mask_outputs}:{drv_path}"
        if self.memo.get(key) == {
            .Val(cached) -> return Ok(cached)
            else -> {}
        }
        loop name in drv.output_names() {
            output :: drv.outputs[name]
            if output.is_floating() || output.is_impure() -> return Err(NixError.DrvUnsupported("floating/impure derivation outputs (staged / trust-gated)"))
        }

        hashes :: if drv.is_fixed() -> nix_fixed_modulo_hashes(drv) else -> &self.input_modulo_hashes(drv, mask_outputs)
        self.memo[key] = ~hashes
        Ok(hashes)
    }

    // One digest shared by every output, over the ATerm whose input
    // derivations are replaced by their own modulo digests.
    fn input_modulo_hashes(&self, drv: NixDerivation, mask_outputs: Bool) -> [String: [U8]] NixError! {
        inputs := [String: [String]]{}
        loop input in drv.input_drvs {
            child :: self.read(input.path)
            child_hashes :: &self.hash_modulo(input.path, child, false)
            loop output_name in input.outputs {
                digest :: child_hashes.get(output_name) ?? return Err(NixError.DrvPath("no hash for output `{output_name}` of `{input.path}`"))
                hex :: nix_hex(digest)
                names := inputs.get(hex) ?? [String]{}
                &names.push(output_name)
                inputs[hex] = nixeval_sorted_unique(names)
            }
        }
        digest :: nix_sha256_digest(drv.unparse(mask_outputs, Val(inputs)).bytes())
        hashes := [String: [U8]]{}
        loop name in drv.output_names() -> hashes[name] = ~digest
        Ok(hashes)
    }

    // Recompute every output path of `drv` at `drv_path`; a mismatch with the
    // embedded path is a divergence.
    fn verify_output_paths(&self, store_dir: String, drv_path: String, drv: NixDerivation) NixError! {
        drv_name :: nix_drv_name_from_path(drv_path)
        if drv.is_fixed() {
            loop name in drv.output_names() {
                output :: drv.outputs[name]
                expected :: nix_make_fixed_output_path(store_dir, nix_output_path_name(drv_name, name), output.method_algo, output.hash_hex)
                if expected != output.path -> return Err(NixError.Divergence{what: "fixed-output `{name}`", expected, actual: output.path})
            }
            return
        }
        hashes :: &self.hash_modulo(drv_path, drv, true)
        loop name in drv.output_names() {
            output :: drv.outputs[name]
            if hashes.get(name) == {
                .Val(digest) -> {
                    expected :: nix_make_output_path(store_dir, name, digest, drv_name)
                    if expected != output.path -> return Err(NixError.Divergence{what: "input-addressed output `{name}`", expected, actual: output.path})
                }
                else -> return Err(NixError.DrvPath("missing modulo hash for output `{name}`"))
            }
        }
    }
}

// A store over `derivations` with an empty modulo memo.
pub fn nix_derivation_store(derivations: [String: NixDerivation]) -> NixDerivationStore Never! {
    NixDerivationStore{derivations, memo: [String: [String: [U8]]]{}}
}

// A fixed-output derivation's digests: every output must be fixed and hashes
// only its own method, content hash and path.
fn nix_fixed_modulo_hashes(drv: NixDerivation) -> [String: [U8]] NixError! {
    hashes := [String: [U8]]{}
    loop name in drv.output_names() {
        output :: drv.outputs[name]
        if !output.is_fixed() -> return Err(NixError.DrvUnsupported("mixed fixed/non-fixed outputs"))
        hashes[name] = nix_sha256_digest("fixed:out:{output.method_algo}:{output.hash_hex}:{output.path}".bytes())
    }
    Ok(hashes)
}

// Recompute the derivation's own store path (text method); fail closed on a
// mismatch.
pub fn nix_verify_drv_path(store_dir: String, drv_path: String, aterm: [U8], drv: NixDerivation) NixError! {
    expected :: nix_make_text_path(store_dir, nix_store_path_name(drv_path), aterm, drv.references_for_drv_path())
    if expected != drv_path -> return Err(NixError.Divergence{what: "drvPath", expected, actual: drv_path})
}

// Re-encode `drv`; any byte divergence from `aterm` fails closed, reporting
// the first 120 scalars of each side.
pub fn nix_verify_aterm_roundtrip(aterm: String, drv: NixDerivation) NixError! {
    encoded :: drv.unparse(false, None)
    if encoded != aterm -> return Err(NixError.Divergence{what: "ATerm roundtrip", expected: nix_leading_scalars(aterm, 120), actual: nix_leading_scalars(encoded, 120)})
}

fn nix_leading_scalars(text: String, limit: Int) -> String Never! {
    out := [String]{}
    loop scalar in text.chars() {
        if out.len() == limit -> break
        &out.push("{scalar}")
    }
    out.join("")
}
