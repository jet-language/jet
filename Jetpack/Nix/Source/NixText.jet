// Small text predicates shared by the Nix area's identity, index and builder
// validators (Rust `char`/byte predicates over `&str`).
use {
    jetpack_nix_eval.[nixeval_is_ascii_digit]
    jet_pkg_model.[pkg_bytes_space_width, pkg_bytes_text, pkg_text_has_control]
}

// Exactly `length` bytes of lowercase hexadecimal.
nix_is_lower_hex: fn(text: String, length: Int) -> Bool Never! {
    raw: text.bytes()
    if raw.len() != length -> return false
    loop byte in raw {
        code: Int.from_u8(byte)
        if !nixeval_is_ascii_digit(code) && !(code >= 97 && code <= 102) -> return false
    }
    true
}

// Rust `text.chars().any(char::is_whitespace)`.
nix_text_has_whitespace: fn(text: String) -> Bool Never! {
    raw: text.bytes()
    loop index in 0..<raw.len() {
        if pkg_bytes_space_width(raw, index) > 0 -> return true
    }
    false
}

// Rust `text.chars().any(|c| c.is_control() || c.is_whitespace())`.
nix_text_has_control_or_space: fn(text: String) -> Bool Never! {
    pkg_text_has_control(text) || nix_text_has_whitespace(text)
}

// Rust `text.rsplit('/').next()`: the text after the last `/`.
nix_path_basename: fn(path: String) -> String Never! {
    parts: path.cut_last("/") ?? return path.copy()
    parts.after
}

// Rust `str::lines`: split at `\n`, drop the carriage return of a `\r\n`
// ending; a final newline ends the last line rather than starting one.
nix_text_lines: fn(text: String) -> [String] Never! {
    raw: text.bytes()
    lines := [String]{}
    start := 0
    loop index in 0..<raw.len() {
        if Int.from_u8(raw[index]) == 10 {
            end: if index > start && Int.from_u8(raw[index - 1]) == 13 -> index - 1 else -> index
            &lines.push(pkg_bytes_text(raw, start, end))
            start = index + 1
        }
    }
    if start < raw.len() -> &lines.push(pkg_bytes_text(raw, start, raw.len()))
    lines
}
