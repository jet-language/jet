// Private fragment of Jetpack.Nix.Index.IndexClient; use the canonical
// IndexWire, IndexCodec, IndexProducer and IndexSignatures owners in this module.
// Original tests live in Jetpack/Nix/Tests/Index/IndexClient02.jet.
use jet_foundation.[json_escape]

// Rust: crates/jetpack/src/NixIndex.rs:1791
fn encode_record(output: &String, record: NixIndexRecordWire) -> {
    &output.push_str("{{\"attrpath\":")
    encode_attrpath(&output, record.attrpath)
    &output.push_str(",\"version\":\"")
    &output.push_str(json_escape(record.version))
    &output.push_str("\",\"drvPath\":\"")
    &output.push_str(json_escape(record.drv_path))
    &output.push_str("\",\"outputs\":[")
    loop index in 0..<record.outputs.len() {
        if index != 0 -> &output.push_str(",")
        wire :: record.outputs[index]
        &output.push_str("{{\"name\":\"")
        &output.push_str(json_escape(wire.name))
        &output.push_str("\",\"storePath\":\"")
        &output.push_str(json_escape(wire.store_path))
        &output.push_str("\"}}")
    }
    &output.push_str("]}}")
}

// Rust: crates/jetpack/src/NixIndex.rs:1812
fn encode_attrpath(output: &String, attrpath: [String]) -> {
    &output.push_str("[")
    loop index in 0..<attrpath.len() {
        if index != 0 -> &output.push_str(",")
        &output.push_str("\"")
        &output.push_str(json_escape(attrpath[index]))
        &output.push_str("\"")
    }
    &output.push_str("]")
}

