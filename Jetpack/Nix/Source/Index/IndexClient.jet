// Client side of the signed nixpkgs channel index: resolve one attribute path
// against a signed, unexpired, non-rolled-back channel manifest and its
// content-addressed index target, caching both under the Hangar root, or
// against an explicit local (unsigned) catalog directory.

NIX_INDEX_TEST_KEY_ID :: prep { "jet-test-index-v1" }
NIX_INDEX_ROOT :: prep { "hangar/nix-index/v1" }
NIX_INDEX_LOCAL_INDEX_ROOT :: prep { "index-v1" }
NIX_INDEX_LOCAL_NATIVE_RECIPE_ROOT :: prep { "recipes-v1.json" }
NIX_INDEX_TRUST_CONFIG :: prep { "trust/nix-index-v1.ed25519.pub" }
NIX_INDEX_ENDPOINT_CONFIG :: prep { "config/nix-index-v1.endpoint" }
NIX_INDEX_TRANSPORT_TIMEOUT_MS :: prep { 120000 }
NIX_INDEX_MAX_LOCAL_REVISIONS :: prep { 128 }

nix_index_temp_sequence := 0

// Bounded GET of one index URL. The native transport holds one HTTP client
// whose destination rule pins every host's checked addresses for the
// client's lifetime; tests supply fixed responses.
pub struct NixIndexTransport {
    pub get_bounded: fn(String, Int) -[Net, Time.Wait]> [U8] NixIndexError!
}

pub enum NixIndexClock {
    System
    Fixed(Int)

    fn now_unix(self) -[Time]> Int Never! {
        if self == {
            .System -> time.instant().unix_ns /% 1000000000
            .Fixed(unix) -> unix
        }
    }
}

pub struct NixIndexClient {
    endpoint: String
    root: String
    key_id: String
    public_key: crypto.VerifyKey?
    local_catalog: Bool
    offline: Bool
    clock: NixIndexClock
    transport: NixIndexTransport

    fn from_roots(roots: HangarRoots) -[FS, Env, Net]> NixIndexClient NixIndexError! {
        NixIndexClient.from_roots_with_mode(roots, false)
    }

    // The configured official index: an explicit endpoint and trust key must
    // both be installed under the Hangar root, and the test key is refused.
    fn from_roots_with_mode(roots: HangarRoots, offline: Bool) -[FS, Env, Net]> NixIndexClient NixIndexError! {
        nix_index_ensure_real_directory(roots.root)
        trust_path :: files.join(roots.root, NIX_INDEX_TRUST_CONFIG)
        endpoint_path :: files.join(roots.root, NIX_INDEX_ENDPOINT_CONFIG)
        parents :: [String]{files.dirname(trust_path), files.dirname(endpoint_path)}
        loop parent in parents {
            if nix_index_path_exists(parent) -> nix_index_ensure_real_directory(parent)
        }
        trust_exists :: nix_index_path_exists(trust_path)
        endpoint_exists :: nix_index_path_exists(endpoint_path)
        if !trust_exists && !endpoint_exists -> return Err(NixIndexError.Invalid("signed nixpkgs index endpoint and public key must be configured explicitly"))
        if !trust_exists || !endpoint_exists -> return Err(NixIndexError.Invalid("nix index endpoint and public-key overrides must be installed together"))
        trust :: nix_index_read_regular(trust_path, 4096)
        text :: String.from_bytes(trust) ?? return Err(NixIndexError.Invalid("nix index public key is not UTF-8"))
        parts :: text.trim().split_once(":") ?? return Err(NixIndexError.Invalid("nix index public key must be key-id:base64-public-key"))
        key_id :: nix_index_nonempty_text(parts.before, "nix index key id")
        if key_id == NIX_INDEX_TEST_KEY_ID {
            return Err(NixIndexError.Invalid("nix index trust root `{NIX_INDEX_TEST_KEY_ID}` is test-only and cannot be used for official signed indexes"))
        }
        key_bytes :: base64.decode(parts.after) ?? return Err(NixIndexError.Invalid("nix index public key is not base64"))
        if key_bytes.len() != 32 -> return Err(NixIndexError.Invalid("nix index public key must be 32 bytes"))
        endpoint_bytes :: nix_index_read_regular(endpoint_path, 4096)
        endpoint_text :: String.from_bytes(endpoint_bytes) ?? return Err(NixIndexError.Invalid("nix index endpoint is not UTF-8"))
        endpoint :: nix_index_parse_endpoint(endpoint_text.trim())
        public_key :: crypto.VerifyKey.from_bytes(key_bytes) ?? return Err(NixIndexError.Invalid("nix index public key is invalid"))
        transport :: nix_index_native_transport(endpoint)
        Ok(NixIndexClient{endpoint, root: roots.root, key_id, public_key: Val(public_key), local_catalog: false, offline, clock: NixIndexClock.System, transport})
    }

    // An explicit local, unsigned catalog directory.
    fn from_local_catalog(catalog: String, offline: Bool) -[FS]> NixIndexClient NixIndexError! {
        if !nix_index_path_exists(catalog) -> return Err(NixIndexError.Invalid("local unofficial nixpkgs catalog `{catalog}` does not exist"))
        nix_index_ensure_real_directory(catalog)
        transport :: NixIndexTransport{get_bounded: (url: String, max_bytes: Int) -[Net, Time.Wait]> {
            Err(NixIndexError.Transport("native index transport has no configured endpoint"))
        }}
        Ok(NixIndexClient{endpoint: "", root: catalog, key_id: "", public_key: None, local_catalog: true, offline, clock: NixIndexClock.System, transport})
    }

    // A signed client over an explicit transport and clock (the Rust test
    // seam `for_test`).
    fn with_transport(root: String, endpoint: String, key_id: String, public_key: [U8], transport: NixIndexTransport, clock: NixIndexClock, offline: Bool) -> NixIndexClient NixIndexError! {
        parsed :: nix_index_parse_endpoint(endpoint)
        key :: crypto.VerifyKey.from_bytes(public_key) ?? return Err(NixIndexError.Invalid("test index public key is invalid"))
        Ok(NixIndexClient{endpoint: parsed, root, key_id, public_key: Val(key), local_catalog: false, offline, clock, transport})
    }

    fn resolve(self, key: NixIndexKey) -[FS, Env, Net, Time, Time.Wait]> NixVerifiedIndexRecord NixIndexError! {
        nix_index_validate_key(key)
        if self.local_catalog -> return self.resolve_local_catalog(key)
        now :: self.clock.now_unix()
        manifest :: self.current_manifest(key.channel, now)
        if manifest.manifest.issued_unix > now + NIX_INDEX_MAX_MANIFEST_FUTURE_SKEW_SECONDS {
            return Err(NixIndexError.Invalid("signed nixpkgs channel manifest is too far in the future"))
        }
        if manifest.manifest.expires_unix <= now -> return Err(NixIndexError.Invalid("signed nixpkgs channel manifest is expired"))
        target :: manifest.manifest.target_for(key.revision, key.system) ?? return Err(NixIndexError.Invalid("manifest has no target for {key.channel}@{key.revision} on {key.system}"))
        cached :: self.load_target(key, target)
        compressed := [U8]{}
        signature_bytes := [U8]{}
        if cached == {
            .Val(pair) -> {
                compressed = pair.compressed
                signature_bytes = pair.signature
            }
            else -> {
                if self.offline -> return Err(NixIndexError.Offline("signed nixpkgs index target is not cached for {key.revision} on {key.system}"))
                compressed = self.transport.get_bounded(target.url, target.compressed_length)
                nix_index_verify_digest_and_length(compressed, target.compressed_length, target.sha256, "nix index target")
                signature_bytes = self.transport.get_bounded(target.signature_url, NIX_INDEX_MAX_SIGNATURE_BYTES)
                if pkg_sha256_hex(signature_bytes) != target.signature_sha256 {
                    return Err(NixIndexError.Invalid("nix index signature sidecar digest disagrees with manifest"))
                }
            }
        }
        decoded :: nix_index_zstd_decode_bounded(compressed, NIX_INDEX_MAX_DECODED_BYTES)
        if decoded.len() != target.decoded_length -> return Err(NixIndexError.Invalid("nix index decoded length disagrees with manifest"))
        signature :: NixIndexSignature.parse(signature_bytes)
        public_key :: self.public_key ?? return Err(NixIndexError.Invalid("signed index has no verifier"))
        nix_index_verify_index_signature(public_key, self.key_id, signature, decoded)
        document :: NixIndexDocument.parse(decoded)
        document.validate()
        if document.channel != key.channel || document.revision != key.revision || document.system != key.system {
            return Err(NixIndexError.Invalid("signed nixpkgs index target disagrees with its requested key"))
        }
        if document.records.len() != target.record_count -> return Err(NixIndexError.Invalid("nix index record count disagrees with manifest"))
        if cached == None -> self.cache_target_atomically(key, target, compressed, signature_bytes)
        self.cache_manifest_atomically(key.channel, manifest)
        record :: document.record_for(key.attrpath) ?? return Err(document.not_indexed(key))
        proof :: NixIndexProof{
            schema: NIX_INDEX_SCHEMA,
            channel: key.channel,
            revision: key.revision,
            system: key.system,
            attrpath: key.attrpath,
            manifest_generation: manifest.manifest.generation,
            manifest_sha256: pkg_sha256_hex(manifest.bytes),
            index_sha256: pkg_sha256_hex(compressed),
            record_sha256: pkg_sha256_hex(record.canonical_json().bytes()),
            jet_key_id: self.key_id,
            jet_signature: signature.signature,
        }
        Ok(NixVerifiedIndexRecord{record, proof, trust: NixIndexTrustTier.OfficialSigned})
    }

    // A cached manifest while it is unexpired; otherwise a fresh signed one.
    // Offline, a missing or expired manifest is an offline refusal.
    fn current_manifest(self, channel: String, now: Int) -[FS, Env, Net, Time.Wait]> NixIndexCachedManifest NixIndexError! {
        if self.load_manifest(channel) == {
            .Ok(found) -> {
                if found == {
                    .Val(cached) -> {
                        if cached.manifest.expires_unix > now -> return Ok(cached)
                        if self.offline -> return Err(NixIndexError.Offline("signed nixpkgs channel manifest expired; refresh required"))
                    }
                    else -> {
                        if self.offline -> return Err(NixIndexError.Offline("signed nixpkgs channel manifest is not cached"))
                    }
                }
            }
            .Err(error) -> {
                if self.offline -> return Err(error)
            }
        }
        self.fetch_manifest(channel)
    }

    // Resolve a local channel's revision from its explicit manifest, or from
    // its single immutable index target. More than one matching revision
    // requires a manifest.
    fn local_channel_revision(self, channel: String, system: String) -[FS]> String NixIndexError! {
        if !self.local_catalog -> return Err(NixIndexError.Invalid("channel revision lookup requires a local nixpkgs catalog"))
        nix_index_validate_channel(channel)
        nix_index_validate_system(system)
        path :: files.join(files.join(files.join(self.root, "v1"), channel), "manifest.json")
        if nix_index_path_exists(path) {
            bytes :: nix_index_read_regular(path, NIX_INDEX_MAX_MANIFEST_BYTES)
            manifest :: NixIndexChannelManifest.parse(bytes)
            if manifest.channel != channel -> return Err(NixIndexError.Invalid("local nixpkgs channel manifest disagrees with its requested channel"))
            loop target in manifest.targets {
                if target.system == system -> return Ok(target.revision)
            }
            return Err(NixIndexError.Invalid("local nixpkgs channel manifest has no target for {channel} on {system}"))
        }
        index_root :: files.join(self.root, NIX_INDEX_LOCAL_INDEX_ROOT)
        nix_index_ensure_real_directory(index_root)
        entries :: files.list_dir(index_root) ?? return Err(NixIndexError.Transport("read local index: {err}"))
        revision := String?{None}
        loop index in 0..<entries.len() {
            if index >= NIX_INDEX_MAX_LOCAL_REVISIONS -> return Err(NixIndexError.Invalid("local catalog has too many revisions"))
            candidate :: entries[index].name
            nix_index_validate_revision(candidate)
            nix_index_ensure_real_directory(entries[index].path)
            if !nix_index_path_exists(files.join(entries[index].path, system)) -> next
            _ :: self.load_local_index(NixIndexKey{channel, revision: candidate, system, attrpath: [String]{}})
            if revision != None -> return Err(NixIndexError.Invalid("local catalog has multiple revisions; provide an explicit channel manifest"))
            revision = Val(candidate)
        }
        found :: revision ?? return Err(NixIndexError.Invalid("local catalog has no index for {channel} on {system}"))
        Ok(found)
    }

    // A native recipe from the explicit local catalog. Signed sources never
    // consult it, so a bad signed index cannot become an unsigned source.
    // `package` may pin a version as `name#version=<version>`.
    fn resolve_native_recipe(self, package: String) -[FS]> NixNativeRecipe? NixIndexError! {
        if !self.local_catalog -> return Ok(None)
        path :: files.join(self.root, NIX_INDEX_LOCAL_NATIVE_RECIPE_ROOT)
        if !nix_index_path_exists(path) -> return Ok(None)
        recipes :: nix_index_parse_local_native_recipes(nix_index_read_regular(path, NIX_INDEX_MAX_NATIVE_RECIPE_BYTES))
        name := package
        requested := String?{None}
        if package.split_once("#version=") == {
            .Val(parts) -> {
                name = parts.before
                requested = Val(parts.after)
            }
            else -> {}
        }
        if nix_index_valid_native_token(name, "native recipe name") == {
            .Err(_) -> return Ok(None)
            else -> {}
        }
        if requested == {
            .Val(version) -> {
                if nix_index_valid_native_token(version, "native recipe version") == {
                    .Err(_) -> return Ok(None)
                    else -> {}
                }
            }
            else -> {}
        }
        matches := [NixNativeRecipe]{}
        loop recipe in recipes {
            if recipe.name == name && (requested ?? recipe.version) == recipe.version -> &matches.push(recipe)
        }
        if matches.len() > 1 -> return Err(NixIndexError.Invalid("local unofficial native catalog has ambiguous recipes for `{package}`"))
        if matches.len() == 0 -> return Ok(None)
        Ok(Val(matches[0]))
    }

    // The one intact target of a local catalog revision/system directory and
    // its digest.
    fn load_local_index(self, key: NixIndexKey) -[FS]> (digest: String, document: NixIndexDocument) NixIndexError! {
        target_dir :: files.join(files.join(files.join(self.root, NIX_INDEX_LOCAL_INDEX_ROOT), key.revision), key.system)
        if !nix_index_path_exists(target_dir) -> return Err(NixIndexError.Invalid("local unofficial nixpkgs catalog has no target for {key.revision} on {key.system}"))
        nix_index_ensure_real_directory(target_dir)
        entries :: files.list_dir(target_dir) ?? return Err(NixIndexError.Transport("read local unofficial nixpkgs catalog target directory {target_dir}: {err}"))
        found_digest := String?{None}
        found_document := NixIndexDocument?{None}
        loop entry in entries {
            info :: files.stat(entry.path) ?? return Err(NixIndexError.Transport("inspect local catalog entry: {err}"))
            if info.is_symlink -> return Err(NixIndexError.Invalid("local unofficial nixpkgs catalog contains a symlink"))
            if !entry.name.ends_with(".json.zst") -> next
            digest :: entry.name.removesuffix(".json.zst")
            if !nix_is_lower_hex(digest, 64) -> return Err(NixIndexError.Invalid("local unofficial nixpkgs catalog target digest is malformed"))
            compressed :: nix_index_read_regular(entry.path, NIX_INDEX_MAX_COMPRESSED_BYTES)
            nix_index_verify_digest_and_length(compressed, compressed.len(), digest, "local unofficial nixpkgs catalog target")
            decoded :: nix_index_zstd_decode_bounded(compressed, NIX_INDEX_MAX_DECODED_BYTES)
            document :: NixIndexDocument.parse(decoded)
            document.validate()
            if document.channel != key.channel || document.revision != key.revision || document.system != key.system {
                return Err(NixIndexError.Invalid("local unofficial nixpkgs catalog target disagrees with its requested key"))
            }
            if found_document != None -> return Err(NixIndexError.Invalid("local unofficial nixpkgs catalog has multiple target records"))
            found_digest = Val(digest)
            found_document = Val(document)
        }
        digest :: found_digest ?? return Err(NixIndexError.Invalid("local unofficial nixpkgs catalog has no target file in {target_dir}"))
        document :: found_document ?? return Err(NixIndexError.Invalid("local unofficial nixpkgs catalog has no target file in {target_dir}"))
        Ok((digest: digest, document: document))
    }

    fn resolve_local_catalog(self, key: NixIndexKey) -[FS]> NixVerifiedIndexRecord NixIndexError! {
        target :: self.load_local_index(key)
        record :: target.document.record_for(key.attrpath) ?? return Err(target.document.not_indexed(key))
        proof :: NixIndexProof{
            schema: NIX_INDEX_SCHEMA,
            channel: key.channel,
            revision: key.revision,
            system: key.system,
            attrpath: key.attrpath,
            manifest_generation: 0,
            manifest_sha256: "",
            index_sha256: target.digest,
            record_sha256: pkg_sha256_hex(record.canonical_json().bytes()),
            jet_key_id: "",
            jet_signature: "",
        }
        Ok(NixVerifiedIndexRecord{record, proof, trust: NixIndexTrustTier.LocalUnofficial})
    }

    fn load_manifest(self, channel: String) -[FS]> NixIndexCachedManifest? NixIndexError! {
        directory :: self.manifest_dir(channel)
        bytes_path :: files.join(directory, "current.json")
        signature_path :: files.join(directory, "current.sig.json")
        bytes_exists :: nix_index_path_exists(bytes_path)
        signature_exists :: nix_index_path_exists(signature_path)
        if !bytes_exists && !signature_exists -> return Ok(None)
        if !bytes_exists || !signature_exists -> return Err(NixIndexError.Invalid("cached nix index manifest is missing its signature pair"))
        bytes :: nix_index_read_regular(bytes_path, NIX_INDEX_MAX_MANIFEST_BYTES)
        signature_bytes :: nix_index_read_regular(signature_path, NIX_INDEX_MAX_SIGNATURE_BYTES)
        manifest :: NixIndexChannelManifest.parse(bytes)
        manifest.validate()
        if manifest.channel != channel -> return Err(NixIndexError.Invalid("cached nixpkgs channel manifest disagrees with requested channel"))
        public_key :: self.public_key ?? return Err(NixIndexError.Invalid("signed index has no verifier"))
        nix_index_verify_manifest_signature(public_key, self.key_id, signature_bytes, bytes)
        self.check_generation(channel, manifest, bytes)
        Ok(Val(NixIndexCachedManifest{manifest, bytes, signature_bytes}))
    }

    fn fetch_manifest(self, channel: String) -[FS, Net, Time.Wait]> NixIndexCachedManifest NixIndexError! {
        base :: "{self.endpoint}/v1/{channel}/manifest.json"
        bytes :: self.transport.get_bounded(base, NIX_INDEX_MAX_MANIFEST_BYTES)
        signature_bytes :: self.transport.get_bounded("{base}.sig.json", NIX_INDEX_MAX_SIGNATURE_BYTES)
        manifest :: NixIndexChannelManifest.parse(bytes)
        manifest.validate()
        if manifest.channel != channel -> return Err(NixIndexError.Invalid("signed nixpkgs channel manifest disagrees with requested channel"))
        public_key :: self.public_key ?? return Err(NixIndexError.Invalid("signed index has no verifier"))
        nix_index_verify_manifest_signature(public_key, self.key_id, signature_bytes, bytes)
        self.check_generation(channel, manifest, bytes)
        Ok(NixIndexCachedManifest{manifest, bytes, signature_bytes})
    }

    // Refuse a manifest older than the recorded highest generation, or a
    // different manifest at that same generation.
    fn check_generation(self, channel: String, manifest: NixIndexChannelManifest, bytes: [U8]) NixIndexError! -[FS]> {
        found :: self.load_highest_generation(channel)
        highest :: found ?? return
        if manifest.generation < highest.generation || (manifest.generation == highest.generation && pkg_sha256_hex(bytes) != highest.digest) {
            return Err(NixIndexError.Invalid("signed nixpkgs channel manifest rolled back or forked"))
        }
    }

    fn load_target(self, key: NixIndexKey, target: NixIndexManifestTarget) -[FS]> (compressed: [U8], signature: [U8])? NixIndexError! {
        bytes_path :: self.target_path(key, target.sha256)
        signature_path :: "{bytes_path}.sig.json"
        bytes_exists :: nix_index_path_exists(bytes_path)
        signature_exists :: nix_index_path_exists(signature_path)
        if !bytes_exists && !signature_exists -> return Ok(None)
        if !bytes_exists || !signature_exists -> return Err(NixIndexError.Invalid("cached nix index target is missing its signature pair"))
        bytes :: nix_index_read_regular(bytes_path, NIX_INDEX_MAX_COMPRESSED_BYTES)
        nix_index_verify_digest_and_length(bytes, target.compressed_length, target.sha256, "cached nix index target")
        signature :: nix_index_read_regular(signature_path, NIX_INDEX_MAX_SIGNATURE_BYTES)
        if pkg_sha256_hex(signature) != target.signature_sha256 {
            return Err(NixIndexError.Invalid("cached nix index signature sidecar digest disagrees with manifest"))
        }
        Ok(Val((compressed: bytes, signature: signature)))
    }

    fn cache_manifest_atomically(self, channel: String, manifest: NixIndexCachedManifest) NixIndexError! -[FS, Env]> {
        directory :: self.manifest_dir(channel)
        nix_index_ensure_real_directory(directory)
        generation :: manifest.manifest.generation
        nix_index_write_atomic(files.join(directory, "{generation}.json"), manifest.bytes, false)
        nix_index_write_atomic(files.join(directory, "{generation}.sig.json"), manifest.signature_bytes, false)
        // Advance the monotonic replay floor before exposing the new current
        // pair: a crash can leave an old current pair, never make it
        // authoritative again.
        self.record_highest_generation_atomically(channel, manifest.manifest, manifest.bytes)
        nix_index_write_atomic(files.join(directory, "current.json"), manifest.bytes, true)
        nix_index_write_atomic(files.join(directory, "current.sig.json"), manifest.signature_bytes, true)
    }

    fn cache_target_atomically(self, key: NixIndexKey, target: NixIndexManifestTarget, bytes: [U8], signature: [U8]) NixIndexError! -[FS, Env]> {
        path :: self.target_path(key, target.sha256)
        nix_index_ensure_real_directory(files.dirname(path))
        nix_index_write_atomic(path, bytes, false)
        nix_index_write_atomic("{path}.sig.json", signature, false)
    }

    fn record_highest_generation_atomically(self, channel: String, manifest: NixIndexChannelManifest, bytes: [U8]) NixIndexError! -[FS, Env]> {
        directory :: self.generation_dir(channel)
        nix_index_ensure_real_directory(directory)
        state :: "{manifest.generation}\n{pkg_sha256_hex(bytes)}\n"
        nix_index_write_atomic(files.join(directory, "highest"), state.bytes(), true)
    }

    fn load_highest_generation(self, channel: String) -[FS]> (generation: Int, digest: String)? NixIndexError! {
        path :: files.join(self.generation_dir(channel), "highest")
        if !nix_index_path_exists(path) -> return Ok(None)
        bytes :: nix_index_read_regular(path, 256)
        text :: String.from_bytes(bytes) ?? return Err(NixIndexError.Invalid("nix index rollback state is not UTF-8"))
        lines :: nix_text_lines(text)
        if lines.len() == 0 -> return Err(NixIndexError.Invalid("nix index rollback generation is malformed"))
        generation :: nix_index_parse_generation(lines[0]) ?? return Err(NixIndexError.Invalid("nix index rollback generation is malformed"))
        if lines.len() < 2 || lines[1].bytes().len() != 64 || !nix_index_is_hex(lines[1]) {
            return Err(NixIndexError.Invalid("nix index rollback digest is malformed"))
        }
        if lines.len() > 2 -> return Err(NixIndexError.Invalid("nix index rollback state has trailing data"))
        Ok(Val((generation: generation, digest: lines[1])))
    }

    fn manifest_dir(self, channel: String) -> String NixIndexError! {
        nix_index_validate_channel(channel)
        Ok(files.join(files.join(files.join(self.root, NIX_INDEX_ROOT), "manifests"), channel))
    }

    fn generation_dir(self, channel: String) -> String NixIndexError! {
        nix_index_validate_channel(channel)
        Ok(files.join(files.join(files.join(self.root, NIX_INDEX_ROOT), "generations"), channel))
    }

    fn target_path(self, key: NixIndexKey, digest: String) -> String NixIndexError! {
        nix_index_validate_key(key)
        if !nix_is_lower_hex(digest, 64) -> return Err(NixIndexError.Invalid("nix index target digest is malformed"))
        targets :: files.join(files.join(self.root, NIX_INDEX_ROOT), "targets")
        Ok(files.join(files.join(files.join(targets, key.revision), key.system), "{digest}.json.zst"))
    }
}

// A manifest with the exact bytes and signature sidecar it was verified from.
pub struct NixIndexCachedManifest {
    pub manifest: NixIndexChannelManifest
    pub bytes: [U8]
    pub signature_bytes: [U8]
}

// The native transport: HTTPS to checked public addresses, plain HTTP only to
// loopback, both pinned per host for this client, never following redirects,
// and never changing the configured scheme.
fn nix_index_native_transport(endpoint: String) -> NixIndexTransport NixIndexError! {
    configured :: nix_index_parse_network_url(endpoint)
    destinations :: if configured.scheme == "https" -> HTTPDestinations.Public else -> HTTPDestinations.Loopback
    client :: http_client.Client.new()
        .destinations(destinations)
        .redirects(.Disabled)
        .timeouts(total: time.duration_ms(NIX_INDEX_TRANSPORT_TIMEOUT_MS))
    scheme :: configured.scheme
    Ok(NixIndexTransport{get_bounded: (url: String, max_bytes: Int) -[Net, Time.Wait]> {
        nix_index_native_get(client, scheme, url, max_bytes)
    }})
}

fn nix_index_native_get(client: HTTPClient, scheme: String, url: String, max_bytes: Int) -[Net, Time.Wait]> [U8] NixIndexError! {
    requested :: nix_index_parse_network_url(url)
    if requested.scheme != scheme -> return Err(NixIndexError.Transport("signed nix index target changes the endpoint scheme"))
    response :: client.send(http_client.request("GET", url)) ?? return Err(NixIndexError.Transport("{err}"))
    status :: response.status()
    if status != 200 -> return Err(NixIndexError.Transport("index endpoint returned HTTP {status}"))
    declared :: nix_index_content_length(response)
    if (declared ?? 0) > max_bytes -> return Err(NixIndexError.Invalid("index response exceeds its bound"))
    body := response.body(limit: max_bytes + 1)
    bytes := [U8]{}
    loop {
        chunk :: &body.read(65536) ?? return Err(NixIndexError.Transport("read index endpoint: {err}"))
        if chunk.len() == 0 -> break
        loop byte in chunk -> &bytes.push(byte)
        if bytes.len() > max_bytes -> return Err(NixIndexError.Invalid("index response exceeds its bound"))
    }
    if declared != None && (declared ?? 0) != bytes.len() -> return Err(NixIndexError.Transport("index response Content-Length disagrees"))
    Ok(bytes)
}

fn nix_index_content_length(response: HTTPResponse) -> Int? Never! {
    text :: response.header("content-length") ?? return None
    Int.parse(text.trim()) ? value -> Val(value) ! failed -> None
}

// The scheme, host and port of an index URL.
fn nix_index_parse_network_url(url: String) -> (scheme: String, host: String, port: Int) NixIndexError! {
    parts :: url.split_once("://") ?? return Err(NixIndexError.Invalid("nix index URL has no scheme"))
    scheme :: pkg_ascii_lower(parts.before)
    if scheme != "http" && scheme != "https" -> return Err(NixIndexError.Invalid("nix index URL must use HTTP or HTTPS"))
    authority := parts.after
    separators :: [String]{"/", "?", "#"}
    loop separator in separators {
        authority = authority.split(separator).to_list()[0]
    }
    if authority == "" || authority.contains("@") -> return Err(NixIndexError.Invalid("nix index URL authority is malformed"))
    default_port :: if scheme == "https" -> 443 else -> 80
    host := ""
    port := default_port
    bracketed :: authority.starts_with("[")
    if bracketed {
        inner :: authority.removeprefix("[").split_once("]") ?? return Err(NixIndexError.Invalid("nix index IPv6 host is malformed"))
        host = inner.before
        if inner.after.starts_with(":") -> port = nix_index_parse_index_port(inner.after.removeprefix(":"))
    } else {
        if authority.cut_last(":") == {
            .Val(pieces) -> {
                host = pieces.before
                port = nix_index_parse_index_port(pieces.after)
            }
            else -> host = authority
        }
    }
    if host == "" || (!bracketed && host.contains(":")) || nix_text_has_whitespace(host) -> return Err(NixIndexError.Invalid("nix index host is malformed"))
    Ok((scheme: scheme, host: host, port: port))
}

fn nix_index_parse_index_port(text: String) -> Int NixIndexError! {
    port :: nix_index_parse_decimal(text) ?? return Err(NixIndexError.Invalid("nix index port is malformed"))
    if port > 65535 -> return Err(NixIndexError.Invalid("nix index port is malformed"))
    if port == 0 -> return Err(NixIndexError.Invalid("nix index port must not be zero"))
    Ok(port)
}

// Rust `str::parse::<u64>`: ASCII digits with an optional leading `+`.
fn nix_index_parse_decimal(text: String) -> Int? Never! {
    digits :: text.removeprefix("+").bytes()
    if digits.len() == 0 -> return None
    value := 0
    loop byte in digits {
        code :: Int.from_u8(byte)
        if !nixeval_is_ascii_digit(code) -> return None
        value = value * 10 + code - 48
    }
    if value > NIX_INDEX_U64_MAX -> return None
    Val(value)
}

fn nix_index_parse_generation(line: String) -> Int? Never! {
    nix_index_parse_decimal(line)
}

fn nix_index_is_hex(text: String) -> Bool Never! {
    loop byte in text.bytes() {
        if !nixeval_is_ascii_hexdigit(Int.from_u8(byte)) -> return false
    }
    true
}

fn nix_io_is_not_found(error: IOError) -> Bool Never! {
    if error == {
        .NotFound(_) -> true
        else -> false
    }
}

fn nix_io_is_already_exists(error: IOError) -> Bool Never! {
    if error == {
        .AlreadyExists(_) -> true
        else -> false
    }
}

fn nix_index_path_exists(path: String) -[FS]> Bool NixIndexError! {
    if files.stat(path) == {
        .Ok(_) -> return Ok(true)
        .Err(error) -> {
            if nix_io_is_not_found(error) -> return Ok(false)
            return Err(NixIndexError.Transport("inspect {path}: {error}"))
        }
    }
}

// Every existing component of `path` must be a real directory; missing ones
// are created one at a time.
fn nix_index_ensure_real_directory(path: String) NixIndexError! -[FS]> {
    current := if path.starts_with("/") -> "/" else -> ""
    segments :: path.split("/").to_list()
    loop segment in segments {
        if segment == "" -> next
        current = if current == "" -> segment else -> files.join(current, segment)
        if files.stat(current) == {
            .Ok(info) -> {
                if info.is_symlink || !info.is_dir -> return Err(NixIndexError.Invalid("nix index state path `{current}` is not a real directory"))
            }
            .Err(error) -> {
                if !nix_io_is_not_found(error) -> return Err(NixIndexError.Transport("inspect {current}: {error}"))
                files.create_dir(current) ?? return Err(NixIndexError.Transport("create {current}: {err}"))
            }
        }
    }
}

// A bounded no-follow read of one regular file whose identity is unchanged
// from before the open to after the read.
fn nix_index_read_regular(path: String, limit: Int) -[FS]> [U8] NixIndexError! {
    expected :: files.stat(path) ?? return Err(NixIndexError.Transport("read {path}: {err}"))
    if expected.is_symlink || !expected.is_file -> return Err(NixIndexError.Invalid("read {path}: file is not a regular file"))
    if expected.size > limit -> return Err(NixIndexError.Invalid("read {path}: file exceeds its read bound"))
    reader := files.open(path, links: .Refuse) ?? return Err(NixIndexError.Transport("read {path}: {err}"))
    opened :: reader.stat() ?? return Err(NixIndexError.Transport("read {path}: {err}"))
    if !opened.is_file || opened.id != expected.id -> return Err(NixIndexError.Transport("read {path}: file changed before reading"))
    bytes := [U8]{}
    loop {
        chunk :: &reader.read(65536) ?? return Err(NixIndexError.Transport("read {path}: {err}"))
        if chunk.len() == 0 -> break
        loop byte in chunk -> &bytes.push(byte)
        if bytes.len() > limit -> return Err(NixIndexError.Invalid("read {path}: file exceeds its read bound"))
    }
    after :: files.stat(path) ?? return Err(NixIndexError.Transport("read {path}: {err}"))
    if bytes.len() != expected.size || after.id != expected.id -> return Err(NixIndexError.Transport("read {path}: file changed while reading"))
    Ok(bytes)
}

// Publish `bytes` at `path` through a private, fsynced, no-follow temporary:
// a rename for replaceable state, a hard link for an immutable object (an
// existing object must already hold exactly these bytes).
fn nix_index_write_atomic(path: String, bytes: [U8], replace: Bool) NixIndexError! -[FS, Env]> {
    parent :: files.dirname(path)
    if parent == "" -> return Err(NixIndexError.Invalid("nix index state file has no parent"))
    nix_index_ensure_real_directory(parent)
    if files.stat(path) == {
        .Ok(info) -> {
            if info.is_symlink || !info.is_file -> return Err(NixIndexError.Invalid("nix index state file `{path}` is not regular"))
            if !replace {
                current :: nix_index_read_regular(path, bytes.len())
                if current == bytes -> return
                return Err(NixIndexError.Invalid("immutable nix index object `{path}` changed"))
            }
        }
        else -> {}
    }
    nix_index_temp_sequence += 1
    basename :: files.basename(path)
    name :: if basename == "" -> "index" else -> basename
    temporary :: files.join(parent, ".{name}.partial-{process.current_pid()}-{nix_index_temp_sequence}")
    if nix_index_publish(temporary, path, parent, bytes, replace) == {
        .Ok(_) -> return
        .Err(error) -> {
            files.remove(temporary).drop("the unpublished temporary may never have been created")
            return Err(error)
        }
    }
}

fn nix_index_publish(temporary: String, path: String, parent: String, bytes: [U8], replace: Bool) NixIndexError! -[FS]> {
    out := files.create(temporary, if_exists: .Refuse, mode: 0o600, links: .Refuse) ?? return Err(NixIndexError.Transport("write {path}: {err}"))
    &out.write_all(bytes) ?? return Err(NixIndexError.Transport("write {path}: {err}"))
    &out.fsync() ?? return Err(NixIndexError.Transport("write {path}: {err}"))
    if replace {
        files.rename(temporary, path) ?? return Err(NixIndexError.Transport("write {path}: {err}"))
        files.fsync(parent) ?? return Err(NixIndexError.Transport("write {path}: {err}"))
        return
    }
    if files.hard_link(temporary, path) == {
        .Ok(_) -> {
            files.remove(temporary) ?? return Err(NixIndexError.Transport("write {path}: {err}"))
            files.fsync(parent) ?? return Err(NixIndexError.Transport("write {path}: {err}"))
        }
        .Err(error) -> {
            if !nix_io_is_already_exists(error) -> return Err(NixIndexError.Transport("write {path}: {error}"))
            info :: files.stat(path) ?? return Err(NixIndexError.Transport("write {path}: {err}"))
            if info.is_symlink || !info.is_file -> return Err(NixIndexError.Transport("write {path}: immutable nix index object is not a regular file"))
            current :: nix_index_read_regular(path, bytes.len()) ?? return Err(NixIndexError.Transport("write {path}: {err.message()}"))
            if current != bytes -> return Err(NixIndexError.Transport("write {path}: immutable nix index object changed"))
            files.remove(temporary).drop("the published object already holds these bytes")
        }
    }
}
