// Jetpack's native Nix evaluation entry points. Each call re-validates the
// embedded, product-ready oracle manifest before evaluating; filesystem
// imports reach the evaluator only through an explicit `NixEvalAuthority`.
use jetpack_nix_eval.[NixEvalAuthority, NixEvalDevShell, NixEvalError, NixEvalInventoryEntry]

nix_evaluate_devshell_with_import_authority: fn(source: String, system: String, authority: ^NixEvalAuthority?) -> NixEvalDevShell NixEvalError! {
    boundary: NixNativeBoundary.embedded()
    boundary.evaluate_devshell_with_import_authority(source, system, ^authority)
}

nix_evaluate_devshell_output_with_import_authority: fn(source: String, system: String, output: String, authority: ^NixEvalAuthority?) -> NixEvalDevShell NixEvalError! {
    boundary: NixNativeBoundary.embedded()
    boundary.evaluate_devshell_output_with_import_authority(source, system, output, ^authority)
}

nix_evaluator_identity: fn(system: String) -> String NixEvalError! {
    boundary: NixNativeBoundary.embedded()
    boundary.evaluator_identity(system)
}

nix_pinned_inventory: fn() -> [NixEvalInventoryEntry] NixEvalError! {
    boundary: NixNativeBoundary.embedded()
    Ok(boundary.pinned_inventory())
}

nix_evaluate_derivation: fn(source: String, system: String) -> NixNativeDerivation NixEvalError! {
    boundary: NixNativeBoundary.embedded()
    boundary.evaluate_derivation(source, system)
}

nix_evaluate_derivation_with_import_authority: fn(source: String, system: String, authority: ^NixEvalAuthority?) -> NixNativeDerivation NixEvalError! {
    boundary: NixNativeBoundary.embedded()
    boundary.evaluate_derivation_with_import_authority(source, system, ^authority)
}

nix_evaluate_derivation_output: fn(source: String, system: String, attribute: String) -> NixNativeDerivation NixEvalError! {
    boundary: NixNativeBoundary.embedded()
    boundary.evaluate_derivation_output(source, system, attribute)
}

nix_evaluate_derivation_output_with_import_authority: fn(source: String, system: String, attribute: String, authority: ^NixEvalAuthority?) -> NixNativeDerivation NixEvalError! {
    boundary: NixNativeBoundary.embedded()
    boundary.evaluate_derivation_output_with_import_authority(source, system, attribute, ^authority)
}
