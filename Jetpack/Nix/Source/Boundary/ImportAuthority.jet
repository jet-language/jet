// Pure policy of the pinned, read-only project-root authority for bounded
// project-relative Nix imports (Rust `ProjectImportAuthority`). The host half
// opens the project root once and walks `nix_import_path_components` one
// component at a time with no-follow, handle-relative opens, then admits the
// opened file through `NixImportMetadata.admit` and its text through
// `nix_import_admit_source`.

@NIX_IMPORT_MAX_BYTES :: 1048576

// The normal components of a project-relative import path, with the
// normalization of Rust `Path::components`: repeated and trailing `/` and
// interior `.` vanish; empty, absolute, backslash or NUL paths, a leading
// `.`, and any `..` are refused.
pub fn nix_import_path_components(relative: String) -> [String] NixError! {
    if relative == "" || relative.starts_with("/") || nixeval_contains_byte(relative, 92) || nixeval_contains_byte(relative, 0) {
        return Err(NixError.ImportPath)
    }
    components := [String]{}
    segments :: relative.split("/").to_list()
    loop index in 0..<segments.len() {
        segment :: segments[index]
        if segment == {
            "" -> next
            "." -> {
                if index == 0 -> return Err(NixError.ImportPath)
            }
            ".." -> return Err(NixError.ImportPath)
            else -> &components.push(segment)
        }
    }
    Ok(components)
}

// What the host observed about the opened import handle.
pub struct NixImportMetadata {
    pub regular_file: Bool
    pub length: Int

    // The opened import must be a regular file within the evaluator byte
    // limit.
    fn admit(self) NixError! {
        if !self.regular_file -> return Err(NixError.ImportNotRegularFile)
        if self.length > @NIX_IMPORT_MAX_BYTES -> return Err(NixError.ImportTooLarge)
    }
}

// The text read through the handle (at most one byte past the limit) must
// still fit: the file may have grown after its metadata was read.
pub fn nix_import_admit_source(source: String) -> String NixError! {
    if source.bytes().len() > @NIX_IMPORT_MAX_BYTES -> return Err(NixError.ImportTooLarge)
    Ok(source)
}
