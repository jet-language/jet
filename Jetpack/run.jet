// Standalone Jet-hosted engine entry. Protocol and sandbox dispatch belong to
// cli_jetpack_main; this wrapper supplies the start path first (a release
// hard link named jetpack-nix-index or jetpack-trust-root selects that
// personality) and then the program's words, and exits with its status.
use {
    jetpack_process :: core.process
    jetpack_sys :: core.sys
}

fn run() {
    words := [String]{jetpack_sys.executable()}
    loop word in jetpack_process.args() -> &words.push(word)
    jetpack_process.exit(cli_jetpack_main(words))
}
