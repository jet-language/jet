// Standalone Jet-hosted engine entry. Protocol and sandbox dispatch belong to
// cli_jetpack_main; this wrapper only supplies the full argv (program name
// first, which selects the jetpack-nix-index/jetpack-trust-root personalities)
// and exits with its status.
use core.process as jetpack_process

fn run() {
    jetpack_process.exit(cli_jetpack_main(jetpack_process.argv()))
}
