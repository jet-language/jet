// TUF-shaped role metadata: roles and thresholds, path-bounded delegations,
// root/targets/snapshot/timestamp documents, the offline keyring, the
// persistent trusted-root bootstrap pin, and the publication-safe public
// trust keys.
// Public-manifest encoding uses the existing InvalidPublisher error channel;
// a serialization failure never hands partial JSON to the publisher.
use {
    hex: core.encoding.hex
    crypto: core.crypto
    files: core.files
    base64: core.encoding.base64
    json: core.encoding.json
}


MetadataRole: enum {
    Root
    Targets
    Snapshot
    Timestamp

    label: fn(self) -> String Never! {
        if self == {
            .Root -> "root"
            .Targets -> "targets"
            .Snapshot -> "snapshot"
            .Timestamp -> "timestamp"
        }
    }

    // Declaration order, the order Rust's derived `Ord` walks role maps.
    all: fn() -> [MetadataRole] Never! {
        [MetadataRole]{MetadataRole.Root, MetadataRole.Targets, MetadataRole.Snapshot, MetadataRole.Timestamp}
    }
}

RoleKeys: struct {
    key_ids: [String]
    threshold: Int

    new: fn(key_ids: [String], threshold: Int) -> RoleKeys TrustRootError! {
        if threshold == 0 -> return Err(TrustRootError.InvalidThreshold{detail: "threshold must be >= 1"})
        if threshold > key_ids.len() -> return Err(TrustRootError.InvalidThreshold{detail: "threshold {threshold} exceeds key count {key_ids.len()}"})
        seen := [String]{}
        loop id in key_ids {
            if seen.contains(id) -> return Err(TrustRootError.InvalidThreshold{detail: "duplicate key id `{id}` in role"})
            seen.push(id.copy())
        }
        Ok(RoleKeys{key_ids, threshold})
    }
}

Delegation: struct {
    name: String
    role: RoleKeys
    // Path prefixes this delegation may sign (TUF path bounds).
    path_prefixes: [String]
    terminating: Bool

    allows_path: fn(self, path: String) -> Bool Never! {
        loop prefix in self.path_prefixes {
            if path.starts_with(prefix) -> return true
        }
        false
    }
}

// Root metadata. `roles` is keyed by role label; `public_key_ids` maps each
// public key id to its algorithm (secret material stays offline).
TUFRootMetadata: struct {
    version: Int
    expires_unix: Int
    consistent_snapshot: Bool
    roles: [String: RoleKeys]
    delegations: [Delegation]
    public_key_ids: [String: String]

    role: fn(self, role: MetadataRole) -> RoleKeys? Never! {
        self.roles.get(role.label())
    }
}

TargetMeta: struct {
    length: Int
    hashes: [String: String]
    custom: [String: String]
}

TargetsMetadata: struct {
    version: Int
    expires_unix: Int
    targets: [String: TargetMeta]
}

SnapshotMetaEntry: struct {
    version: Int
    length: Int
    hashes: [String: String]
}

SnapshotMetadata: struct {
    version: Int
    expires_unix: Int
    // role name -> version, length, and hashes of that role's signed bytes.
    meta: [String: SnapshotMetaEntry]
}

TimestampMetadata: struct {
    version: Int
    expires_unix: Int
    snapshot: SnapshotMetaEntry
}

SignedMetadata: struct<T> {
    signed: T
    signatures: [TrustSignature]
}

TrustRootPolicy: struct {
    max_metadata_bytes: Int
    max_clock_skew_secs: Int
    // When set, the local clock must stay within skew of this trusted time.
    trusted_unix: Int?

    default: fn() -> TrustRootPolicy Never! {
        TrustRootPolicy{max_metadata_bytes: TRUST_DEFAULT_MAX_METADATA_BYTES, max_clock_skew_secs: TRUST_DEFAULT_MAX_CLOCK_SKEW_SECS, trusted_unix: None}
    }
}

// Offline keyring for role signing and verification (never a helper).
Keyring: struct {
    priv keys: [String: TrustKey]

    empty: fn() -> Keyring Never! {
        Keyring{keys: [String: TrustKey]{}}
    }

    insert: fn(&self, key: TrustKey) Never! {
        self.keys[key.key_id] = key
    }

    get: fn(self, key_id: String) -> TrustKey? Never! {
        self.keys.get(key_id)
    }

    verify: fn(self, key_id: String, message: [U8], signature: TrustSignature) TrustRootError! {
        key: self.keys.get(key_id) ?? return Err(TrustRootError.UnknownKey{key_id: key_id})
        if signature.algorithm != TRUST_ALG_HMAC_SHA256 && signature.algorithm != key.algorithm {
            return Err(TrustRootError.SignatureInvalid{role: MetadataRole.Root, detail: "unsupported algorithm `{signature.algorithm}`"})
        }
        expected: hex.encode(crypto.hmac_sha256(key.secret, message))
        if !crypto.constant_time_equal_bytes(expected.bytes(), signature.sig_hex.bytes()) {
            return Err(TrustRootError.SignatureInvalid{role: MetadataRole.Root, detail: "signature for key `{key_id}` does not verify"})
        }
    }
}

// The persistent trusted-root bootstrap pin under a Jetpack root.
RootBootstrap: struct {
    pin_digest: String
    root_version: Int
    consistent_snapshot: Bool

    path: fn(roots_dir: String) -> String Never! {
        files.join(files.join(roots_dir, "trust"), "root.bootstrap")
    }

    write: fn(self, roots_dir: String) TrustRootError! -[FS]> {
        trust_ensure_trust_dir(roots_dir)
        body: "digest={self.pin_digest}\nversion={self.root_version}\nconsistent_snapshot={self.consistent_snapshot}\n"
        trust_atomic_write(RootBootstrap.path(roots_dir), body.bytes())
    }

    load: fn(roots_dir: String) -[FS]> RootBootstrap TrustRootError! {
        path: RootBootstrap.path(roots_dir)
        metadata: if files.stat(path) == {
            .Ok(found) -> found
            .Err(error) -> {
                if error == {
                    .NotFound(_) -> return Err(TrustRootError.BootstrapMissing)
                    .InvalidInput(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> return Err(TrustRootError.IO{detail: "{error}"})
                }
            }
        }
        if metadata.is_symlink || !metadata.is_file -> return Err(TrustRootError.IO{detail: "trusted-root bootstrap is not a regular file"})
        if metadata.size > TRUST_BOOTSTRAP_MAX_BYTES -> return Err(TrustRootError.IO{detail: "trusted-root bootstrap is too large"})
        digest := String?{None}
        version := Int?{None}
        consistent := Bool?{None}
        loop line in trust_root_lines(files.read(path)) {
            if {
                line.starts_with("digest=") -> digest = Val(line.removeprefix("digest="))
                line.starts_with("version=") -> version = trust_parse_u64(line.removeprefix("version="))
                line.starts_with("consistent_snapshot=") -> consistent = Val(line.removeprefix("consistent_snapshot=") == "true")
                else -> {}
            }
        }
        pin_digest: digest ?? return Err(TrustRootError.BootstrapMissing)
        if !trust_root_is_hex64(pin_digest) -> return Err(TrustRootError.BootstrapMissing)
        root_version: version ?? return Err(TrustRootError.BootstrapMissing)
        consistent_snapshot: consistent ?? return Err(TrustRootError.BootstrapMissing)
        Ok(RootBootstrap{pin_digest, root_version, consistent_snapshot})
    }
}

// A public endpoint key in the exact NixIndex trust-file format. Distinct
// from `TrustKey`, which holds an HMAC secret and is never published.
PublicTrustKey: struct {
    role: String
    key_id: String
    algorithm: String
    public_key: String

    // One `key-id:base64-public-key` line; the key decodes to 32 bytes.
    from_nix_line: fn(role: String, value: String) -> PublicTrustKey TrustRootError! {
        known: [String]{"index", "cache", "toolchain"}
        if !known.contains(role) -> return Err(TrustRootError.InvalidKey{detail: "unknown public trust role `{role}`"})
        parts: value.trim().split_once(":") ?? return Err(TrustRootError.InvalidKey{detail: "public trust key must be key-id:base64-public-key"})
        key_id: parts.before
        encoded: parts.after
        if key_id == "" || encoded == "" || trust_has_control(key_id) || trust_has_control(encoded) || trust_has_inner_space(encoded) {
            return Err(TrustRootError.InvalidKey{detail: "public trust key has invalid key id or encoding"})
        }
        if trust_is_test_public_key_id(key_id) -> return Err(TrustRootError.InvalidKey{detail: "test public trust key `{key_id}` cannot be published"})
        decoded: base64.decode(encoded) ?? return Err(TrustRootError.InvalidKey{detail: "public trust key is not padded base64"})
        if decoded.len() != 32 -> return Err(TrustRootError.InvalidKey{detail: "public trust key must decode to 32 bytes"})
        Ok(PublicTrustKey{role, key_id, algorithm: "ed25519", public_key: encoded})
    }

    path_for_publication: fn(self) -> String Never! {
        if self.role == {
            "index" -> "nix-index-v1.ed25519.pub"
            "cache" -> "nix-cache-v1.ed25519.pub"
            "toolchain" -> "toolchain-v1.ed25519.pub"
            else -> panic("PublicTrustKey validates its role on construction")
        }
    }
}

// Any Unicode whitespace scalar within the text.
trust_has_inner_space: fn(value: String) -> Bool Never! {
    loop scalar in value.chars() {
        if "{scalar}".trim() == "" -> return true
    }
    false
}

trust_is_test_public_key_id: fn(key_id: String) -> Bool Never! {
    key_id == "jet-test-index-v1" || key_id == "repo-dogfood-index-v1" || key_id.starts_with("test-") || key_id.ends_with("-test")
}

// The public trust-root manifest the site publishes. It records the local
// bootstrap pin when one exists but never a `TrustKey` secret; an empty key
// list is intentional while the production key ceremony is pending. Objects
// are built with `Dyn.object()` so the wire keeps the declared field order;
// a `[String: Dyn]` map would iterate its keys sorted.
trust_public_trust_manifest: fn(domain: String, bootstrap: RootBootstrap?, keys: [PublicTrustKey]) -> String TrustRootError! {
    if domain == "" || trust_has_control(domain) || trust_has_inner_space(domain) -> return Err(TrustRootError.InvalidKey{detail: "public trust manifest domain is empty or contains whitespace"})
    sorted := keys
    sorted.sort_by(fn(key) { key.role })
    loop index in 1..<sorted.len() {
        if sorted[index - 1].role == sorted[index].role -> return Err(TrustRootError.InvalidKey{detail: "public trust role `{sorted[index].role}` is duplicated"})
    }
    status: if sorted.len() == 0 -> "awaiting-key-ceremony" else -> "prepared"
    root: if bootstrap == {
        .Val(pin) -> {
            fields := Dyn.object()
            fields["protocol"] = Dyn.Text("jet-tuf-root-v1")
            fields["digest"] = Dyn.Text(pin.pin_digest)
            fields["version"] = Dyn.Int(pin.root_version)
            fields["consistent_snapshot"] = Dyn.Bool(pin.consistent_snapshot)
            fields
        }
        .None -> Dyn.Null
    }
    rendered := [Dyn]{}
    loop key in sorted {
        fields := Dyn.object()
        fields["role"] = Dyn.Text(key.role)
        fields["path"] = Dyn.Text(key.path_for_publication())
        fields["key_id"] = Dyn.Text(key.key_id)
        fields["algorithm"] = Dyn.Text(key.algorithm)
        fields["public_key"] = Dyn.Text(key.public_key)
        rendered.push(fields)
    }
    manifest := Dyn.object()
    manifest["schema"] = Dyn.Int(1)
    manifest["domain"] = Dyn.Text(domain.copy())
    manifest["status"] = Dyn.Text(status)
    manifest["root"] = root
    manifest["keys"] = Dyn.Array(rendered)
    manifest["rotation"] = Dyn.Text("offline threshold root rotation; publish a new manifest only after the old root verifies the new root")
    text: json.to_string(manifest) ?? return Err(TrustRootError.InvalidPublisher{detail: err.reason})
    Ok("{text}\n")
}

// Rust `str::parse::<u64>`: ASCII digits only, no sign.
trust_parse_u64: fn(text: String) -> Int? Never! {
    raw: text.bytes()
    if raw.len() == 0 -> return None
    value := 0
    loop byte in raw {
        code: Int.from_u8(byte)
        if code < 48 || code > 57 -> return None
        value = value * 10 + (code - 48)
    }
    Val(value)
}
