// Rust crates/jetpack/src/JetOS/installer_media.rs:131-172 and :481-506, with
// the payload copiers they call: root_projection.rs:126-191
// (copy_dir_recursive_deref) and generation_files.rs:1263-1270
// (copy_runtime_symlink). Rust copy_runtime_file_filtered is exactly
// copy_file_replace, so the payload copies call jetos_copy_file_replace.
jetos_render_installed_limine_conf: fn(system: SystemPlan, generation: JetOSGeneration) -> String Never! {
    "timeout: 1\nserial: yes\ngraphics: no\nverbose: yes\n/{jetos_release_label(false)} — {system.name} verify\n    protocol: linux\n    kernel_path: boot():/boot/kernel\n    module_path: boot():/boot/initrd\n    textmode: yes\n    cmdline: console=ttyS0 rdinit=/jetos/init init=/jetos/init jetos.mode=verify jetos.host={system.name} jetos.generation={generation.name} root=LABEL=jetos-root rw\n"
}

jetos_render_installer_limine_conf: fn(system: SystemPlan, generation: JetOSGeneration, disk: String) -> String Never! {
    target: if disk.starts_with("/dev/") -> disk else -> "/dev/sda"
    "timeout: 5\nserial: yes\ngraphics: no\nverbose: yes\n/Install {jetos_release_label(false)} — {system.name}\n    protocol: linux\n    kernel_path: boot():/boot/kernel\n    module_path: boot():/boot/initrd\n    textmode: yes\n    cmdline: console=ttyS0 rdinit=/jetos/init init=/jetos/init jetos.mode=install jetos.host={system.name} jetos.generation={generation.name} jetos.disk={target}\n"
}

// Every generation entry except `root`, in name order: directories copy with
// links dereferenced, anything else (a link included, never followed for the
// choice) as one replaced file; then sw/bin store links become real files.
jetos_copy_generation_payload_deref: fn(source: String, destination: String) IOError! -[FS]> {
    files.create_dir_all(destination)
    entries := files.list_dir(source)
    &entries.sort_by(entry -> entry.name)
    loop entry in entries {
        if entry.name == "root" -> next
        target: files.join(destination, entry.name)
        if files.stat(entry.path).is_dir {
            jetos_copy_dir_recursive_deref(entry.path, target)
        } else {
            jetos_copy_file_replace(entry.path, target)
        }
    }
    jetos_deref_profile_bin_symlinks(destination)
}

// A missing sw/bin is no profile to dereference.
jetos_deref_profile_bin_symlinks: fn(system: String) IOError! -[FS]> {
    entries: if files.list_dir(files.join(system, "sw/bin")) == {
        .Ok(listed) -> listed
        .Err(_) -> { return }
    }
    loop entry in entries {
        if !files.stat(entry.path).is_symlink -> next
        link: files.read_link(entry.path)
        if !jetos_is_store_path(link) -> next
        if files.remove(entry.path) == {
            .Ok(_) -> {}
            .Err(_) -> {}
        }
        jetos_copy_file_replace(link, entry.path)
    }
}

// Store and relative links stay links; any other link is copied through, and
// a dangling one that is neither is skipped.
jetos_copy_dir_recursive_deref: fn(source: String, destination: String) IOError! -[FS]> {
    files.create_dir_all(destination)
    entries := files.list_dir(source)
    &entries.sort_by(entry -> entry.name)
    loop entry in entries {
        path: entry.path
        target: files.join(destination, entry.name)
        is_link: files.stat(path).is_symlink
        if is_link && jetos_should_preserve_staged_symlink(files.read_link(path)) {
            jetos_copy_runtime_symlink(path, target)
            next
        }
        if files.stat(path, links: .Follow) == {
            .Ok(meta) -> {
                if meta.is_dir {
                    jetos_copy_dir_recursive_deref(path, target) ?? return Err(foundation_io_error_with_cause(err, "copying directory `{path}` to `{target}` failed: {err}"))
                } else if meta.is_file {
                    jetos_copy_file_replace(path, target) ?? return Err(foundation_io_error_with_cause(err, "copying file `{path}` to `{target}` failed: {err}"))
                }
            }
            .Err(error) -> {
                if !is_link -> return Err(foundation_io_error_with_cause(error, "reading `{path}` while copying to `{target}` failed: {error}"))
            }
        }
    }
}

jetos_should_preserve_staged_symlink: fn(target: String) -> Bool Never! {
    jetos_is_store_path(target) || !target.starts_with("/")
}

// Rust Path::starts_with("/nix/store"): whole components, not a byte prefix.
jetos_is_store_path: fn(path: String) -> Bool Never! {
    path == "/nix/store" || path.starts_with("/nix/store/")
}

// The parent is created, a destination is removed best-effort, and the
// source link's own target is linked again unchanged.
jetos_copy_runtime_symlink: fn(source: String, destination: String) IOError! -[FS]> {
    files.create_dir_all(files.dirname(destination))
    if files.remove(destination) == {
        .Ok(_) -> {}
        .Err(_) -> {}
    }
    files.symlink(files.read_link(source), destination)
}
