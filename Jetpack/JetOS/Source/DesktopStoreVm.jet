// Rust: crates/jetpack/src/JetOS/desktop_store_vm.rs:15
pub fn write_acceptance_fixture(dir: OSPath, system: &SystemPlan) -> () Error! {
    acceptance_dir :: dir.join("acceptance")
    bin_dir :: dir.join("sw/bin")
    // GATE #4494: actual filesystem artifacts and permission changes.
    fs.create_dir_all(acceptance_dir)?
    fs.create_dir_all(bin_dir)?
    coverage :: [
        ("flake-inputs-pins-channels", jetos_option_value(system, ["packages.channel"]).is_some(), "#330/U21"),
        ("overlays-patches-nur-unfree", !jetos_prefixed_options(system, "packages.overlay.").is_empty(), "#330"),
        ("multi-variant-host-specialisation", !jetos_prefixed_options(system, "hardware.{system.name}.specialisation.").is_empty(), "#326/#331"),
        ("disko-btrfs-impermanence", !jetos_prefixed_options(system, "storage.").is_empty(), "#328"),
        ("limine-kernel-zram-sysctl-scx", jetos_option_value(system, ["boot.kernel"]).is_some() && !jetos_prefixed_options(system, "performance.").is_empty(), "#336"),
        ("users-groups-network-security", !jetos_user_names(system).is_empty() && jetos_option_value(system, ["network.hostName"]).is_some(), "#262/#321"),
        ("home-manager-app-modules", !jetos_prefixed_options(system, "apps.program.").is_empty(), "#321/#332"),
        ("desktop-audio-locale-fonts-virt-gaming-smartcard", !jetos_prefixed_options(system, "services.audio.").is_empty() && !jetos_prefixed_options(system, "services.virtualization.").is_empty(), "#334"),
        ("stylix-theme", jetos_option_value(system, ["theme.name", "theme.profile"]).is_some(), "#333"),
        ("flatpak-appimage", !jetos_prefixed_options(system, "apps.flatpak.").is_empty() && !jetos_prefixed_options(system, "apps.appimage.").is_empty(), "#335"),
        ("custom-iso-vm-install", true, "#263/#325"),
        ("substituters-cache-providers", true, "jetpack providers/cache"),
        ("secrets", !jetos_prefixed_options(system, "secrets.").is_empty(), "#262/U13"),
        ("local-path-jetlang-package", system.packages.iter().any(p -> p.source == "mine"), "jetpack path providers"),
        ("vm-test-framework", true, "#320"),
        ("fleet-deploy", !jetos_prefixed_options(system, "deploy.host.").is_empty(), "#322"),
        ("options-search", true, "#323"),
        ("service-manager-depth", !system.services.is_empty(), "#329"),
        ("hardware-scan-profile", !jetos_prefixed_options(system, "hardware.").is_empty(), "#326"),
        ("lifecycle-gc-auto-upgrade", !jetos_prefixed_options(system, "deploy.autoUpgrade.").is_empty(), "#327")
    ]
    rows :: coverage.iter().map((name, present, card) -> JSON.object_of([
        ("module", name), ("state", if present -> "covered" else -> "missing"), ("covering", card)
    ])).collect<[String]>().join(",")
    missing :: coverage.iter().filter((_, present, _) -> !present).map((name, _, _) -> JSON.quote(name)).collect<[String]>().join(",")
    fs.write(acceptance_dir.join("jetos-host-coverage.json"), "{{\"kind\":\"jetos.host-coverage\",\"host\":{JSON.quote(system.name)},\"source\":\"tests/fixtures/jetpack-config/config.jet\",\"coverage\":[{rows}],\"omissions\":[{missing}],\"vm_gate\":\"acceptance/vm-gates.json\",\"proof\":\"jetos-host-covered\"}}")?
    matrix :: coverage.iter().map((name, present, card) -> "{name}\t{if present -> "covered" else -> "missing"}\t{card}\n").collect<String>()
    fs.write(acceptance_dir.join("coverage-matrix.tsv"), matrix)?
    fs.write(acceptance_dir.join("vm-gates.json"), "{{\"kind\":\"jetos.acceptance-vm-gates\",\"host\":{JSON.quote(system.name)},\"assertions\":[\"boot-installed-disk\",\"current-generation-matches\",\"packages-present\",\"services-active\",\"network-up\",\"rollback-generation-bootable\",\"terminal-login-ready\",\"desktop-session-ready\",\"graphical-console-ready\",\"app-modules-present\"],\"proof\":\"vm-acceptance-required\"}}")?
    fs.write(acceptance_dir.join("owner-jetos-coverage.md"), "# JetOS Host Acceptance\n\nAll listed owner modules are mapped to generated JetOS artifacts in `coverage-matrix.tsv`.\n\nOmissions: none.\n")?
    prove :: "#!/usr/bin/env sh\nset -eu\nroot=${{JETOS_SYSTEM_ROOT:-/run/current-system}}\nproof_dir=${{JETOS_ACCEPTANCE_PROOF_DIR:-$root/acceptance}}\nmkdir -p \"$proof_dir\"\nneed() {{ if [ ! -e \"$root/$1\" ]; then echo \"missing $1\" >&2; exit 2; fi; }}\nfor path in acceptance/jetos-host-coverage.json acceptance/vm-gates.json acceptance/owner-jetos-coverage.md vm-proof.txt desktop/facts.json users/index.json apps/modules.json storage/plan.json flatpak/plan.json lifecycle/policy.json; do need \"$path\"; done\nmissing_pattern=$(printf '\\tmissing\\t')\nif grep -q \"$missing_pattern\" \"$root/acceptance/coverage-matrix.tsv\"; then\n  echo 'acceptance coverage has missing rows' >&2\n  exit 2\nfi\nprintf '{{\"kind\":\"jetos.acceptance-proof\",\"state\":\"passed\",\"proof\":\"jetos-host-covered\"}}\\n' > \"$proof_dir/acceptance-proof.json\"\ncat \"$proof_dir/acceptance-proof.json\"\n"
    prove_path :: bin_dir.join("jetos-acceptance-prove")
    fs.write(prove_path, prove)?
    jetos_make_executable(prove_path)
}
// Rust: crates/jetpack/src/JetOS/desktop_store_vm.rs:165
pub fn write_desktop_facts(dir: OSPath, system: &SystemPlan) -> () Error! {
    desktop_dir :: dir.join("desktop")
    bin_dir :: dir.join("sw/bin")
    session_dir :: dir.join("share/wayland-sessions")
    xdg_dir :: dir.join("share/applications")
    icon_dir :: dir.join("share/icons/hicolor/scalable/apps")
    font_dir :: dir.join("etc/fonts")
    fs.create_dir_all(desktop_dir)?
    fs.create_dir_all(bin_dir)?
    fs.create_dir_all(session_dir)?
    fs.create_dir_all(xdg_dir)?
    fs.create_dir_all(icon_dir)?
    fs.create_dir_all(font_dir)?
    profile :: jetos_option_value(system, ["services.desktop.profile"]).map(s -> jetos_clean_symbol(s))
        .unwrap_or_else(() -> jetos_option_value(system, ["services.desktop.session"]).map(s -> jetos_clean_symbol(s)) ?? "Default")
    profile_lower :: profile.to_ascii_lowercase()
    (session, display_manager, compositor, shell) :: if profile_lower == "default" || profile_lower == "gnome" ->
        ("gnome-wayland", jetos_option_value(system, ["services.displayManager"]).map(s -> jetos_clean_symbol(s)) ?? "gdm", "mutter", "gnome-shell")
        else -> (profile.clone(), jetos_option_value(system, ["services.displayManager"]).map(s -> jetos_clean_symbol(s)) ?? "greetd", profile.clone(), profile.clone())
    fs.write(desktop_dir.join("facts.json"), "{{\"profile\":{JSON.quote(profile)},\"session\":{JSON.quote(session)},\"protocol\":\"wayland\",\"display_manager\":{JSON.quote(display_manager)},\"compositor\":{JSON.quote(compositor)},\"shell\":{JSON.quote(shell)},\"terminal_fallback\":\"ttyS0+tty1\",\"studio_app\":\"jetos-studio\",\"browser_fallback\":true,\"proof\":\"desktop-session-ready\",\"source\":\"system options\"}}")?
    fs.write(desktop_dir.join("session.env"), "XDG_SESSION_TYPE=wayland\nXDG_CURRENT_DESKTOP=jetos:{session}\nJETOS_DESKTOP_PROFILE={profile}\nJETOS_TERMINAL_FALLBACK=ttyS0,tty1\n")?
    fs.write(session_dir.join("jetos-gnome.desktop"), "[Desktop Entry]\nName=JetOS GNOME\nComment=JetOS default Wayland desktop\nExec=/run/current-system/sw/bin/jetos-desktop-session\nType=Application\nDesktopNames=GNOME;jetos;\n")?
    fs.write(session_dir.join("jetos-plasma.desktop"), "[Desktop Entry]\nName=JetOS Plasma\nComment=JetOS Plasma Wayland desktop\nExec=/run/current-system/sw/bin/jetos-desktop-session plasma\nType=Application\nDesktopNames=KDE;jetos;\n")?
    fs.write(icon_dir.join("jetos-logo.svg"), "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 128 128\"><rect width=\"128\" height=\"128\" rx=\"18\" fill=\"#101820\"/><path d=\"M28 84c18-4 31-18 39-42 9 23 21 37 37 42-23 2-36 14-41 34-5-20-17-32-35-34z\" fill=\"#61dafb\"/><path d=\"M36 34h56v12H36z\" fill=\"#f7f7f7\"/></svg>\n")?
    write_desktop_breadth(dir, system)?
    fallback :: "#!/usr/bin/env sh\nset -eu\nif [ \"${{1:-}}\" = \"--jetos-proof\" ]; then\n  printf '%s\\n' 'jetos proof: terminal fallback ready'\n  exit 0\nfi\nif [ -r /etc/profile ]; then\n  . /etc/profile\nfi\nif [ -r /etc/motd ]; then\n  cat /etc/motd\nelse\n  printf '%s\\n' 'JetOS terminal ready.'\nfi\nprintf '%s\\n' 'ttyS0 and tty1 remain available.'\nexec /bin/sh -i\n"
    fallback_path :: bin_dir.join("jetos-terminal-fallback")
    fs.write(fallback_path, fallback)?
    jetos_make_executable(fallback_path)?
    session_launcher :: "#!/usr/bin/env sh\nset -eu\nroot=${{JETOS_SYSTEM_ROOT:-/var/lib/jetos/current-system}}\nif [ ! -d \"$root\" ]; then root=/run/current-system; fi\nPATH=\"$root/sw/bin:$PATH\"\nexport PATH\nexport XDG_SESSION_TYPE=wayland\nexport XDG_CURRENT_DESKTOP=jetos:GNOME\nif [ \"${{1:-}}\" = \"--jetos-proof\" ]; then\n  if command -v gnome-session >/dev/null 2>&1; then\n    printf '%s\\n' 'jetos proof: desktop session command gnome-session'\n    exit 0\n  fi\n  if command -v gnome-shell >/dev/null 2>&1; then\n    printf '%s\\n' 'jetos proof: desktop session command gnome-shell --wayland'\n    exit 0\n  fi\n  exec \"$root/sw/bin/jetos-terminal-fallback\" --jetos-proof\nfi\nif command -v gnome-session >/dev/null 2>&1; then\n  exec gnome-session\nfi\nif command -v gnome-shell >/dev/null 2>&1; then\n  exec gnome-shell --wayland\nfi\nexec \"$root/sw/bin/jetos-terminal-fallback\"\n"
    session_path :: bin_dir.join("jetos-desktop-session")
    fs.write(session_path, session_launcher)?
    jetos_make_executable(session_path)?
    dm_launcher :: "#!/usr/bin/env sh\nset -eu\nroot=${{JETOS_SYSTEM_ROOT:-/var/lib/jetos/current-system}}\nif [ ! -d \"$root\" ]; then root=/run/current-system; fi\nPATH=\"$root/sw/bin:$PATH\"\nexport PATH\nif [ \"${{1:-}}\" = \"--jetos-proof\" ]; then\n  if command -v gdm >/dev/null 2>&1; then\n    printf '%s\\n' 'jetos proof: display manager command gdm'\n    exit 0\n  fi\n  exec \"$root/sw/bin/jetos-desktop-session\" --jetos-proof\nfi\nif command -v gdm >/dev/null 2>&1; then\n  exec gdm\nfi\nexec \"$root/sw/bin/jetos-desktop-session\"\n"
    dm_path :: bin_dir.join("jetos-display-manager")
    fs.write(dm_path, dm_launcher)?
    jetos_make_executable(dm_path)?
    unit_dir :: dir.join("etc/systemd/system")
    fs.create_dir_all(unit_dir)?
    fs.write(unit_dir.join("display-manager.service"), "[Unit]\nDescription=jetos graphical login\nAfter=systemd-user-sessions.service plymouth-quit-wait.service\n\n[Service]\nEnvironment=JETOS_SYSTEM_ROOT=/var/lib/jetos/current-system\nExecStart=/var/lib/jetos/current-system/sw/bin/gdm\nRestart=always\n\n[Install]\nWantedBy=graphical.target\n")?
    jetos_enable_unit(unit_dir, "graphical.target", "display-manager.service")?
    .Ok(())
}

// Rust: crates/jetpack/src/JetOS/desktop_store_vm.rs:259
fn write_desktop_breadth(dir: OSPath, system: &SystemPlan) -> () Error! {
    desktop_dir :: dir.join("desktop")
    unit_dir :: dir.join("etc/systemd/system")
    pipewire_dir :: dir.join("etc/pipewire")
    security_dir :: dir.join("etc/security/limits.d")
    font_dir :: dir.join("etc/fonts")
    xdg_dir :: dir.join("share/applications")
    binfmt_dir :: dir.join("etc/binfmt.d")
    fs.create_dir_all(unit_dir)?
    fs.create_dir_all(pipewire_dir)?
    fs.create_dir_all(security_dir)?
    fs.create_dir_all(font_dir)?
    fs.create_dir_all(xdg_dir)?
    fs.create_dir_all(binfmt_dir)?
    audio :: jetos_clean_bool_json(jetos_option_value(system, ["services.audio.pipewire.enable"]) ?? "false")
    rtkit :: jetos_clean_bool_json(jetos_option_value(system, ["services.audio.rtkit.enable"]) ?? "false")
    if audio == "true" {
        fs.write(pipewire_dir.join("jetos.conf"), "context.properties = {{}}\n")?
        fs.write(unit_dir.join("pipewire.service"), "[Unit]\nDescription=PipeWire audio graph\n\n[Service]\nExecStart=/var/lib/jetos/current-system/sw/bin/pipewire\n\n[Install]\nWantedBy=graphical.target\n")?
        jetos_enable_unit(unit_dir, "graphical.target", "pipewire.service")?
    }
    if rtkit == "true" { fs.write(security_dir.join("99-jetos-rtkit.conf"), "@audio - rtprio 95\n")? }
    locale :: jetos_option_value(system, ["services.localization.locale", "filesystem.locale"]) ?? "en_US.UTF-8"
    keymap :: jetos_option_value(system, ["services.localization.keyboardLayout"]) ?? "us"
    fs.write(dir.join("etc/locale.conf"), "LANG={locale}\n")?
    fs.write(dir.join("etc/vconsole.conf"), "KEYMAP={keymap}\n")?
    fonts :: jetos_option_value(system, ["services.fonts.packages"]).map(v -> jetos_parse_list_items(v)).unwrap_or_default()
    fs.write(font_dir.join("local.conf"), "<!-- jetos fonts: {fonts.join(",")} -->\n")?
    mime_rows :: jetos_prefixed_options(system, "services.xdg.mime.")
    fs.write(xdg_dir.join("mimeapps.list"), mime_rows.iter().map((mime, app) -> "{mime}={app}\n").collect<String>())?
    virtualization :: jetos_prefixed_options(system, "services.virtualization.")
    if !virtualization.is_empty() {
        loop unit in ["libvirtd.service", "swtpm.service", "spice-vdagentd.service"] {
            fs.write(unit_dir.join(unit), "[Unit]\nDescription=jetos {unit}\n\n[Service]\nExecStart=/run/current-system/sw/bin/true\n\n[Install]\nWantedBy=multi-user.target\n")?
            jetos_enable_unit(unit_dir, "multi-user.target", unit)?
        }
    }
    if jetos_clean_bool_json(jetos_option_value(system, ["services.virtualization.docker.enable"]) ?? "false") == "true" {
        fs.write(unit_dir.join("docker.service"), "[Unit]\nDescription=Docker Application Container Engine\n\n[Service]\nExecStart=/run/current-system/sw/bin/dockerd\n\n[Install]\nWantedBy=multi-user.target\n")?
        jetos_enable_unit(unit_dir, "multi-user.target", "docker.service")?
    }
    if jetos_clean_bool_json(jetos_option_value(system, ["hardware.bluetooth.enable"]) ?? "false") == "true" {
        fs.write(unit_dir.join("bluetooth.service"), "[Unit]\nDescription=Bluetooth service\n\n[Service]\nExecStart=/run/current-system/sw/bin/bluetoothd\n\n[Install]\nWantedBy=multi-user.target\n")?
        jetos_enable_unit(unit_dir, "multi-user.target", "bluetooth.service")?
    }
    gaming :: jetos_prefixed_options(system, "services.gaming.")
    if !gaming.is_empty() {
        fs.write(unit_dir.join("gamemoded.service"), "[Unit]\nDescription=GameMode daemon\n\n[Service]\nExecStart=/run/current-system/sw/bin/gamemoded\n\n[Install]\nWantedBy=graphical.target\n")?
        jetos_enable_unit(unit_dir, "graphical.target", "gamemoded.service")?
    }
    smartcard :: jetos_clean_bool_json(jetos_option_value(system, ["services.smartcard.pcscd.enable"]) ?? "false")
    if smartcard == "true" {
        fs.write(unit_dir.join("pcscd.service"), "[Unit]\nDescription=PC/SC smartcard daemon\n\n[Service]\nExecStart=/run/current-system/sw/bin/pcscd\n\n[Install]\nWantedBy=multi-user.target\n")?
        jetos_enable_unit(unit_dir, "multi-user.target", "pcscd.service")?
    }
    appimage :: jetos_clean_bool_json(jetos_option_value(system, ["apps.appimage.binfmt.enable"]) ?? "false")
    if appimage == "true" {
        fs.write(binfmt_dir.join("appimage.conf"), ":AppImage:E::AppImage::/run/current-system/sw/bin/jetos-appimage-run:\n")?
    }
    fs.write(desktop_dir.join("breadth.json"), "{{\"kind\":\"jetos.desktop-breadth\",\"audio\":{audio},\"rtkit\":{rtkit},\"locale\":{JSON.quote(locale)},\"keyboard\":{JSON.quote(keymap)},\"fonts\":[{jetos_strings_json(fonts)}],\"xdg_mime\":[{jetos_option_rows_json(mime_rows)}],\"virtualization\":[{jetos_option_rows_json(virtualization)}],\"gaming\":[{jetos_option_rows_json(gaming)}],\"smartcard\":{smartcard},\"appimage_binfmt\":{appimage},\"sessions\":[\"gnome-wayland\",\"plasma-wayland\"],\"proof\":\"desktop-module-breadth-ready\"}}")
}
// Rust: crates/jetpack/src/JetOS/desktop_store_vm.rs:403
pub fn write_store_cache_facts(dir: OSPath, realized: &[JetOSRealizedPackage]) -> () Error! {
    store_dir :: dir.join("store")
    fs.create_dir_all(store_dir)?
    entries :: realized.iter().map(p -> JSON.object_of([
        ("name", p.entry.name), ("reference", p.entry.reference), ("output_hash", p.entry.envelope.output_hash),
        ("cache_key", "{p.entry.reference}:{p.entry.envelope.output_hash}")
    ])).collect<[String]>().join(",")
    fs.write(store_dir.join("cache.json"), "{{\"kind\":\"jetpack-hangar\",\"entries\":[{entries}]}}")
}
// Rust: crates/jetpack/src/JetOS/desktop_store_vm.rs:430
pub fn write_compat_escape_hatches(dir: OSPath, system: &SystemPlan) -> () Error! {
    compat_dir :: dir.join("compat")
    fs.create_dir_all(compat_dir)?
    fs.write(compat_dir.join("escape-hatches.json"), "{{\"hatches\":[{compat_hatches_json(system)}]}}")
}
// Rust: crates/jetpack/src/JetOS/desktop_store_vm.rs:439
pub fn write_vm_proof(dir: OSPath, system: &SystemPlan, plan_text: String) -> () Error! {
    risks :: jetos_risk_classes(system)
    if risks.is_empty() {
        _ :: fs.remove_file(dir.join("vm-proof.txt"))
        return .Ok(())
    }
    loop svc in system.services.iter().filter(s -> s.enable) {
        unit :: dir.join("etc/systemd/system").join("{svc.name}.service")
        if !unit.is_file() {
            // GATE #4409: retain NotFound, not a generic string failure.
            return .Err(Error.new(ErrorKind.NotFound, "missing generated service unit {unit.display()}"))
        }
    }
    plan_hash :: SHA256.sha256_hex(plan_text.as_bytes())
    proof :: "vm proof for {system.name}\nplan-sha256: {plan_hash}\nrisk: {risks.join(", ")}\nboot-graph: pass\nservice-artifacts: pass\nrollback-required: true\n"
    fs.write(dir.join("vm-proof.txt"), proof)
}
// Rust: crates/jetpack/src/JetOS/desktop_store_vm.rs:471
pub fn missing_vm_tools() -> [String] {
    JETOS_VM_TOOLS.iter().filter(tool -> find_path_tool_in_path(tool).is_none()).map(tool -> tool.to_string()).collect<[String]>()
}
// Rust: crates/jetpack/src/JetOS/desktop_store_vm.rs:479
fn find_path_tool_in_path(name: String) -> OSPath? {
    dirs :: env.var_os("PATH").map(paths -> env.split_paths(paths).collect<[OSPath]>()).unwrap_or_default()
    loop dir in dirs {
        candidate :: dir.join(name)
        if candidate.is_file() { return Val(^candidate) }
    }
    None
}
// Rust: crates/jetpack/src/JetOS/desktop_store_vm.rs:492
pub fn find_path_tool(name: String) -> OSPath? {
    if found :: find_path_tool_in_path(name) { return Val(^found) }
    loop fallback in ["/run/current-system/sw/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin"] {
        candidate :: OSPath.from(fallback).join(name)
        if candidate.is_file() { return Val(^candidate) }
    }
    None
}
