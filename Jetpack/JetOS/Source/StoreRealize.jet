use jetpack.JetOS.OptionsRendering.[clean_symbol, option_value]
use jetpack.JetOS.Types.[JetOSFlags, JetOSRealizedPackage, JETOS_GNOME_DESKTOP_PACKAGES]
use jetpack.Output.[Theme, LiveRegion]
use jetpack.[Provider, RefSpec, Store, Trust, RuntimePolicy]
use jet_env_model.ModuleEval.[SystemPlan]

// Rust: crates/jetpack/src/JetOS/store_realize.rs:11
// Carrier and consumption_path/original_output/original_reference remain owned by Types.
impl JetOSRealizedPackage {
    // Rust: crates/jetpack/src/JetOS/store_realize.rs:22
    fn deref(self: &JetOSRealizedPackage) -> &Store.StoreEntry { &self.entry }

    // Rust: crates/jetpack/src/JetOS/store_realize.rs:28
    fn from_verified(realized: Store.VerifiedRealization) -> JetOSRealizedPackage {
        original_out :: realized.original_output().to_path_buf()
        original_reference :: realized.original_reference().to_string()
        (entry, _source_state, lease) :: realized.into_parts()
        JetOSRealizedPackage{entry: ^entry, lease: ^lease, original_out: ^original_out, original_reference_text: ^original_reference, consumption_override: None}
    }

    // Rust: crates/jetpack/src/JetOS/store_realize.rs:51
    pub fn set_consumption_override(self: &JetOSRealizedPackage, path: OSPath) -> {
        self.consumption_override = Val(^path)
    }

    // Rust: crates/jetpack/src/JetOS/store_realize.rs:65
    // Provider-native roots never enter Hangar lifecycle target sets.
    pub fn output_digests(self: &JetOSRealizedPackage, roots: &Store.Roots) -> [String] {
        objects :: roots.hangar_dir().join("objects")
        digests := self.entry.named_outputs.values().filter(digest -> canonical_hangar_digest(digest) && objects.join(digest).is_dir()).cloned().collect::<[String]>()
        if digests.is_empty() && !self.entry.envelope.output_hash.is_empty() && canonical_hangar_digest(self.entry.envelope.output_hash) && objects.join(self.entry.envelope.output_hash).is_dir() {
            digests.push(self.entry.envelope.output_hash.clone())
        }
        digests.sort()
        digests.dedup()
        ^digests
    }
}

// Rust: crates/jetpack/src/JetOS/store_realize.rs:88
#Error
pub enum RealizeRefError { Provider(String), BuildRejected }

// Rust: crates/jetpack/src/JetOS/store_realize.rs:94
#Error
enum CoreBuildAuthorizationError { Identity(String), Denied }

// Rust: crates/jetpack/src/JetOS/store_realize.rs:102
fn authorize_core_build(theme: &Theme, trust_store: &OSPath, spec: &RefSpec.RefSpec, table: &RefSpec.SourceTable, ctx: &Provider.Ctx, bypass: Bool) -> Unit CoreBuildAuthorizationError! {
    if Provider.approval_facts(spec, table, ctx) == {
        .Ok(.Val(identity)) -> {
            RuntimePolicy.warn_sandbox_fallback(theme)
            Trust.gate_build_identity(theme, trust_store, &identity, bypass).map_err(_ -> CoreBuildAuthorizationError.Denied)
        }
        .Ok(.None) -> Ok(())
        .Err(reason) -> Err(CoreBuildAuthorizationError.Identity(^reason))
    }
}

// Rust: crates/jetpack/src/JetOS/store_realize.rs:121
fn report_core_build_identity_error(theme: &Theme, reason: String) -> {
    theme.error_coded("E1275", "build sandboxing is required but unavailable", "could not establish the exact Core Cargo build identity: {reason}", "provide a trusted substitute or approved remote builder, or enable the native sandbox, then retry.")
}

// Rust: crates/jetpack/src/JetOS/store_realize.rs:130
fn canonical_hangar_digest(digest: String) -> Bool {
    digest.len() == 71 && digest.starts_with("sha256-") && digest.bytes().skip(7).all(byte -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
}

// Rust: crates/jetpack/src/JetOS/store_realize.rs:138
pub fn first_party_package_ref(table: &RefSpec.SourceTable, package: String) -> String? {
    table.declarations().into_iter().find((_, _, via) -> via == RefSpec.ProviderKind.Core).map((name, _, _) -> "{package}@{name}")
}

// Rust: crates/jetpack/src/JetOS/store_realize.rs:149
pub fn jetos_runtime_package_ref(table: &RefSpec.SourceTable, package: String, offline: Bool) -> String? {
    if offline -> first_party_package_ref(table, package) else -> Val("{package}@nixpkgs")
}

// Rust: crates/jetpack/src/JetOS/store_realize.rs:161
pub fn desktop_default_required_packages(system: &SystemPlan) -> &[String] {
    requested :: option_value(system, &["services.desktop.profile", "services.desktop.session"]).is_some()
        || option_value(system, &["services.displayManager"]).is_some()
        || option_value(system, &["init.defaultTarget"]).as_deref() == Val("graphical.target")
    if !requested { return &[] }
    profile :: option_value(system, &["services.desktop.profile"]).map(s -> clean_symbol(s))
        .or_else(() -> option_value(system, &["services.desktop.session"]).map(s -> clean_symbol(s))).unwrap_or_else(() -> "Default")
    profile :: profile.to_ascii_lowercase()
    if profile == "default" || profile == "gnome" -> &JETOS_GNOME_DESKTOP_PACKAGES else -> &[]
}

// Rust: crates/jetpack/src/JetOS/store_realize.rs:184
pub fn realize_ref(theme: &Theme, roots: &Store.Roots, flags: &JetOSFlags, table: &RefSpec.SourceTable, spec: &RefSpec.RefSpec, project_dir: &OSPath, name_w: USize, progress: (&LiveRegion, USize, USize)?) -> JetOSRealizedPackage? {
    if (live, step, total) :: progress.as_mut() {
        live.set_dependency_status("Building System", step, total, spec.source.label(), spec.package, "Resolving")
    } else { theme.status("Resolving {theme.bold(spec.raw)} ...") }
    store_dir :: roots.hangar_dir()
    fixtures :: if flags.offline && Provider.uses_nix_provider(spec, table, flags.offline, &store_dir) -> Provider.fixtures_from_env(flags.fixtures.clone()) else -> flags.fixtures.clone()
    ctx :: Provider.Ctx{fixtures: fixtures.as_deref(), store_dir: &store_dir, offline: flags.offline, project_dir: Val(project_dir), nix_index: None, nix_roots: None, allow_local_nix_catalog: false}
    trust_store :: Trust.store_path()
    if authorize_core_build(theme, &trust_store, spec, table, &ctx, flags.trust) == {
        .Ok(()) -> {}
        .Err(.Denied) -> {
            if (live, _, _) :: progress.as_mut() { live.clear() }
            return None
        }
        .Err(.Identity(reason)) -> {
            if (live, _, _) :: progress.as_mut() { live.clear() }
            report_core_build_identity_error(theme, reason)
            return None
        }
    }
    if Store.realize_verified(roots, &ctx, Store.RealizeRequest.Package{spec: spec, table: table}) == {
        .Ok(realized) -> {
            if (live, _, _) :: progress.as_mut() { live.clear() }
            entry :: realized.metadata()
            theme.row(entry.name, name_w, entry.version, realized.source_state().label())
            theme.detail(theme.gray(entry.out))
            Val(JetOSRealizedPackage.from_verified(^realized))
        }
        .Err(Store.RealizeError.Integrity(failure)) -> {
            if (live, _, _) :: progress.as_mut() { live.clear() }
            Store.report_integrity(theme, &failure)
            None
        }
        .Err(e) -> {
            if (live, _, _) :: progress.as_mut() { live.clear() }
            theme.error("could not realize a jetos package", "provider failed for `{spec.raw}`: {e.debug()}", "check the source ref, or rerun without --offline if this source needs fetching.")
            None
        }
    }
}

// Rust: crates/jetpack/src/JetOS/store_realize.rs:282
pub fn try_realize_ref(theme: &Theme, roots: &Store.Roots, flags: &JetOSFlags, table: &RefSpec.SourceTable, spec: &RefSpec.RefSpec, project_dir: &OSPath, name_w: USize, progress: (&LiveRegion, USize, USize)?) -> JetOSRealizedPackage RealizeRefError! {
    if (live, step, total) :: progress.as_mut() {
        live.set_dependency_status("Building System", step, total, spec.source.label(), spec.package, "Resolving")
    } else { theme.status("Resolving {theme.bold(spec.raw)} ...") }
    store_dir :: roots.hangar_dir()
    fixtures :: if flags.offline && Provider.uses_nix_provider(spec, table, flags.offline, &store_dir) -> Provider.fixtures_from_env(flags.fixtures.clone()) else -> flags.fixtures.clone()
    ctx :: Provider.Ctx{fixtures: fixtures.as_deref(), store_dir: &store_dir, offline: flags.offline, project_dir: Val(project_dir), nix_index: None, nix_roots: None, allow_local_nix_catalog: false}
    trust_store :: Trust.store_path()
    if authorize_core_build(theme, &trust_store, spec, table, &ctx, flags.trust) == {
        .Ok(()) -> {}
        .Err(.Denied) -> {
            if (live, _, _) :: progress.as_mut() { live.clear() }
            return Err(RealizeRefError.BuildRejected)
        }
        .Err(.Identity(reason)) -> {
            if (live, _, _) :: progress.as_mut() { live.clear() }
            report_core_build_identity_error(theme, reason)
            return Err(RealizeRefError.BuildRejected)
        }
    }
    realized :: Store.realize_verified(roots, &ctx, Store.RealizeRequest.Package{spec: spec, table: table}).map_err(e -> {
        if (live, _, _) :: progress.as_mut() { live.clear() }
        RealizeRefError.Provider("verified realization failed for `{spec.raw}`: {e.debug()}")
    })?
    if (live, _, _) :: progress.as_mut() { live.clear() }
    entry :: realized.metadata()
    theme.row(entry.name, name_w, entry.version, realized.source_state().label())
    theme.detail(theme.gray(entry.out))
    Ok(JetOSRealizedPackage.from_verified(^realized))
}
