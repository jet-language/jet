use jetpack.JetOS.DesktopStoreVm.[missing_vm_tools]
use jetpack.JetOS.Generation.[build_generation]
use jetpack.JetOS.GenerationFiles.[systems_dir]
use jetpack.JetOS.GenerationsActivation.[latest_generation_for]
use jetpack.JetOS.InstallerMedia.[write_installer_media]
use jetpack.JetOS.LoadValidate.[load_plan, load_target, parse_target_or_report]
use jetpack.JetOS.Types.[JetOSFlags, JetOSTarget]
use jetpack.JetOS.VmProof.[prove_vm_guest, qemu_has_local_display, qemu_interactive_run_command, qemu_vnc_endpoint, require_vm_run_proof, run_interactive_vm_command, run_vmtest, write_vm_install_plan]
use jetpack.Output.[Theme]
use jetpack.[Syntax]
use jet_env_model.ModuleEval.[SystemPlan]

// Rust: crates/jetpack/src/JetOS/vm_commands.rs:16
pub fn cmd_vm(theme: &Theme, args: &[String], flags: &JetOSFlags) -> I32 {
    (action, rest) :: args.split_first().map((a, r) -> (a.as_str(), r)) ?? {
        theme.error("vm needs an action", "D-JOS-VMCOMMAND1=A, D-JOS-VMRUN1=A, and D-JOS-VMTEST1=A: the active VM actions are `prove`, `run`, and `test`.", "run `jet os vm prove <host> --disk <path>`, `jet os vm run <host> --disk <path>`, or `jet os vm test <scenario> --disk <path>`.")
        return 2
    }
    if action != Syntax.OS_VM_ACTION_PROVE && action != Syntax.OS_VM_ACTION_RUN && action != Syntax.OS_VM_ACTION_TEST {
        theme.error("`{action}` is not a jetos VM action", "D-JOS-VMCOMMAND1=A, D-JOS-VMRUN1=A, and D-JOS-VMTEST1=A: the active VM actions are `prove`, `run`, and `test`.", "run `jet os vm prove <host> --disk <path>`, `jet os vm run <host> --disk <path>`, or `jet os vm test <scenario> --disk <path>`.")
        return 2
    }
    if rest.iter().any(arg -> arg == Syntax.OS_VM_FLAG_REAL) {
        theme.error("`--real` is not a jetos VM option", "D-JOS-NATIVE1=A forbids the NixOS backend on product VM commands.", "run `jet os migrate compare-nixos <host> --out <dir>` for a labeled NixOS comparison.")
        return 2
    }
    if action == Syntax.OS_VM_ACTION_TEST {
        target :: parse_target_or_report(theme, rest.first().map(s -> s.as_str())) ?? return 2
        disk :: flags.disk.as_deref().or(flags.manual_disk.as_deref()).unwrap_or("")
        if disk.is_empty() {
            theme.error("vm test needs a target disk", "`jet os vm test` installs each declared host into a proved virtual disk and records scenario proof facts.", "pass `--disk ./scenario.qcow2`.")
            return 2
        }
        return cmd_vm_test(theme, &target, disk, flags)
    }
    target :: parse_target_or_report(theme, rest.first().map(s -> s.as_str())) ?? return 2
    disk :: flags.disk.as_deref().or(flags.manual_disk.as_deref()).unwrap_or("")
    if disk.is_empty() {
        theme.error("vm needs a target disk", "`jet os vm prove` installs into a virtual disk; `jet os vm run` opens that proved disk for human use.", "pass `--disk ./host.qcow2`.")
        return 2
    }
    (plan, system) :: load_target(theme, &target) ?? return 2
    if action == Syntax.OS_VM_ACTION_RUN { return cmd_vm_run(theme, &system, disk, flags) }
    missing :: missing_vm_tools()
    if !missing.is_empty() {
        theme.error_coded("E1279", "jetos VM proof tools are missing", "D-JOS-VMDEPS1=A requires pinned VM/media tools before installer proof can run; missing: {missing.join(", ")}.", "realize or expose qemu-system-x86_64, qemu-img, xorriso, limine, sfdisk, blockdev, mkfs.ext4, mkfs.vfat, mmd, mcopy, and zstd, then rerun `jet os vm prove`.")
        return 2
    }
    gen :: build_generation(theme, &plan, &system, flags, &target.config) ?? return 2
    media :: if write_installer_media(&gen, &system, "guided-ext4") == {
        .Ok(path) -> path
        .Err(e) -> {
            theme.error("could not write the jetos installer media", "writing installer media artifacts failed: {e}", "check permissions on the Jetpack root, or set JETPACK_ROOT.")
            return 2
        }
    }
    installer_iso :: systems_dir().join("images").join("jetos-installer-{system.name}.iso")
    if !installer_iso.is_file() {
        theme.error("jetos installer ISO was not built", "VM proof needs `{installer_iso.display()}`; media staging did not produce a bootable ISO.", "inspect the media staging `iso-error.txt`, fix the ISO build failure, then rerun `jet os vm prove`.")
        return 2
    }
    if write_vm_install_plan(&gen, &system, disk, &media, false) == {
        .Ok(path) -> {
            if prove_vm_guest(&gen, &system, disk, &media, &path, false) == {
                .Ok(.Val(final_path)) -> { theme.ok("proved jetos VM install/reboot {final_path.display()}"); 0 }
                .Ok(.None) -> {
                    theme.error_coded("E1285", "jetos VM guest proof has not run", "the QEMU install/reboot harness was written to `{path.display()}`, but no guest boot proof was recorded.", "inspect the VM run logs, fix the boot/install path, then rerun `jet os vm prove` to capture a guest proof marker.")
                    2
                }
                .Err(e) -> {
                    theme.error_coded("E1285", "jetos VM guest proof has not run", "the guest proof for `{path.display()}` is stale or incomplete: {e}.", "rerun the recorded QEMU install/reboot phases and write a matching guest proof artifact.")
                    2
                }
            }
        }
        .Err(e) -> {
            theme.error("could not write the jetos VM proof plan", "writing VM proof artifacts failed: {e}", "check permissions on the Jetpack root, or set JETPACK_ROOT.")
            2
        }
    }
}

// Rust: crates/jetpack/src/JetOS/vm_commands.rs:171
fn cmd_vm_test(theme: &Theme, target: &JetOSTarget, disk: String, flags: &JetOSFlags) -> I32 {
    plan :: load_plan(theme, target) ?? return 2
    vmtest :: plan.vmtests.iter().find(t -> t.name == target.host).cloned() ?? {
        names := plan.vmtests.iter().map(t -> t.name.clone()).collect::<[String]>()
        names.sort()
        known :: if names.is_empty() -> "this config defines no vmtests" else -> "available vmtests: {names.join(", ")}"
        theme.error_coded("E0980", "`{target.host}` is not a vmtest in this config", known, "define `module vmtest.<name> { hosts: { node: system.<host> }, run: test { ... } }`, or select one of the vmtests above.")
        return 2
    }
    missing :: missing_vm_tools()
    if !missing.is_empty() {
        theme.error_coded("E1279", "jetos VM proof tools are missing", "D-JOS-VMTEST1=A runs the same pinned VM/media harness as `jet os vm prove`; missing: {missing.join(", ")}.", "realize or expose qemu-system-x86_64, qemu-img, xorriso, limine, sfdisk, blockdev, mkfs.ext4, mkfs.vfat, mmd, mcopy, and zstd, then rerun `jet os vm test`.")
        return 2
    }
    if run_vmtest(theme, &plan, &vmtest, disk, flags, &target.config) == {
        .Ok(path) -> { theme.ok("proved jetos VM test {path.display()}"); 0 }
        .Err(e) -> {
            theme.error_coded("E1285", "jetos VM test proof has not run", "the VM test `{vmtest.name}` did not produce a passing proof: {e}.", "inspect the VM test artifacts, fix the failing host/assertion, then rerun `jet os vm test`.")
            2
        }
    }
}

// Rust: crates/jetpack/src/JetOS/vm_commands.rs:221
fn cmd_vm_run(theme: &Theme, system: &SystemPlan, disk: String, _flags: &JetOSFlags) -> I32 {
    missing :: missing_vm_tools().into_iter().filter(tool -> tool == "qemu-system-x86_64").collect::<[String]>()
    if !missing.is_empty() {
        theme.error_coded("E1279", "jetos VM proof tools are missing", "D-JOS-VMDEPS1=A requires pinned VM/media tools before a VM can run; missing: {missing.join(", ")}.", "realize or expose qemu-system-x86_64, then rerun `jet os vm run`.")
        return 2
    }
    gen :: latest_generation_for(system.name) ?? {
        theme.error_coded("E1287", "jetos VM run needs a proved installed disk", "no built generation exists for `{system.name}`; VM launch follows the latest proven generation.", "run `jet os vm prove <host> --disk <path>` first.")
        return 2
    }
    proof :: systems_dir().join("vm-proofs").join("{system.name}-{gen.name}-vm-proof.json")
    media_proof :: systems_dir().join("images").join("jetos-installer-{system.name}.iso.proof.json")
    if require_vm_run_proof(&gen, system, disk, &media_proof, &proof) == {
        .Ok(()) -> {}
        .Err(e) -> {
            theme.error_coded("E1287", "jetos VM run needs a proved installed disk", "the installed disk `{disk}` is not tied to a passing VM proof: {e}.", "run `jet os vm prove <host> --disk <path>` first, then rerun `jet os vm run`.")
            return 2
        }
    }
    boot_dir :: systems_dir().join("images").join("jetos-installer-{system.name}.iso.d/boot")
    boot_dir :: if boot_dir.join("initrd").is_file() -> boot_dir else -> gen.path.join("boot")
    command :: qemu_interactive_run_command(&boot_dir, disk, system.name, gen.name)
    theme.ok("booting jetos VM {theme.bold(system.name)} generation {theme.bold(gen.name)}")
    if qemu_has_local_display() { theme.detail("graphical console is open in a local QEMU window") } else {
        theme.detail("graphical console is exposed over VNC at {qemu_vnc_endpoint()}; serial output is attached here")
    }
    if run_interactive_vm_command(&command) == {
        .Ok(code) -> code
        .Err(e) -> {
            theme.error("could not run the jetos VM", "starting interactive QEMU failed: {e}", "check the VM proof artifacts and rerun `jet os vm prove` if the disk changed.")
            2
        }
    }
}
