// Live semantic import: broken flake evaluation never silently degrades into scanning.
use jetpack.JetOS.NixosImport.[import_is_ident, import_json_array, import_json_string, import_json_string_array, import_json_value, import_package_list, import_render_string, scan_first_nixos_host, NixosImportArgs, NixosImportPlan, NixosImportUser]
use jetpack.[JSON]
use jet_foundation.DataTree.[DataTree]
use std.[fs]
use std.process.[Command]
use std.collections.[BTreeSet]

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:22
const NIXOS_LIVE_EXTRACTOR: String = """c: {
  host = c.networking.hostName;
  stateVersion = c.system.stateVersion;
  tz = c.time.timeZone;
  locale = c.i18n.defaultLocale;
  keyboard = c.services.xserver.xkb.layout or "us";
  desktopGnome = c.services.desktopManager.gnome.enable or false;
  desktopPlasma = c.services.desktopManager.plasma6.enable or false;
  dmGdm = c.services.displayManager.gdm.enable or false;
  dmSddm = c.services.displayManager.sddm.enable or false;
  loaderLimine = c.boot.loader.limine.enable or false;
  loaderSystemdBoot = c.boot.loader.systemd-boot.enable or false;
  efiTouch = c.boot.loader.efi.canTouchEfiVariables or false;
  kernelName = c.boot.kernelPackages.kernel.pname or "?";
  kernelParams = c.boot.kernelParams or [];
  sysctl = c.boot.kernel.sysctl or {};
  firewallTcp = c.networking.firewall.allowedTCPPorts or [];
  firewallUdp = c.networking.firewall.allowedUDPPorts or [];
  nameservers = c.networking.nameservers or [];
  networkmanager = c.networking.networkmanager.enable or false;
  zramEnable = c.zramSwap.enable or false;
  zramPercent = c.zramSwap.memoryPercent or 50;
  svcOpenssh = c.services.openssh.enable or false;
  svcPipewire = c.services.pipewire.enable or false;
  svcRtkit = c.security.rtkit.enable or false;
  svcTailscale = c.services.tailscale.enable or false;
  svcLibvirtd = c.virtualisation.libvirtd.enable or false;
  svcDocker = c.virtualisation.docker.enable or false;
  svcFlatpak = c.services.flatpak.enable or false;
  svcSteam = c.programs.steam.enable or false;
  svcGamemode = c.programs.gamemode.enable or false;
  svcPcscd = c.services.pcscd.enable or false;
  svcBluetooth = c.hardware.bluetooth.enable or false;
  stylix = c.stylix.enable or false;
  packages = map (p: p.pname or p.name or "?") c.environment.systemPackages;
  users = map (n: {
    name = n;
    home = c.users.users.${n}.home or "/home/${n}";
    groups = c.users.users.${n}.extraGroups or [];
    shell = c.users.users.${n}.shell.pname or "";
  }) (builtins.filter (n: (c.users.users.${n}.isNormalUser or false))
       (builtins.attrNames c.users.users));
  hm = map (n: {
    name = n;
    packages = map (p: p.pname or p.name or "?")
      (c.home-manager.users.${n}.home.packages or []);
    programs = builtins.filter
      (p: (c.home-manager.users.${n}.programs.${p}.enable or false))
      ["git" "fish" "starship" "helix" "ghostty" "vscode"];
  }) (builtins.attrNames (c.home-manager.users or {}));
}"""

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:78
pub fn live_import_plan(args: &NixosImportArgs) -> NixosImportPlan? String! {
    if !args.source.is_dir() || !args.source.join("flake.nix").is_file() { return Ok(.None) }
    flake_text :: fs.read_to_string(args.source.join("flake.nix")).unwrap_or_default()
    host :: args.host.clone().or_else(() -> scan_first_nixos_host(&flake_text)) ?? return Err("the flake declares no discoverable nixosConfigurations host; pass `--host <name>`.")
    facts :: run_live_extractor(&args.source, &host)?
    root :: facts.as_object().map_err(e -> "live eval result: {e}")?
    Ok(.Val(plan_from_live_facts(args, &host, root)?))
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:100
fn run_live_extractor(source: &OSPath, host: &String) -> DataTree String! {
    // GATE #4494 native process execution.
    attr :: "{source.display()}#nixosConfigurations.{host}.config"
    output :: Command.new("nix").args(["eval", "--json", &attr, "--apply", NIXOS_LIVE_EXTRACTOR]).output().map_err(e -> "running `nix eval` failed: {e}; is `nix` on PATH?")?
    if !output.status.success() {
        stderr :: String.from_utf8_lossy(&output.stderr)
        decisive := stderr.lines().rev().map(line -> line.trim()).find(line -> !line.is_empty()).unwrap_or("nix eval failed with no diagnostic output") // #4303
        excerpt :: decisive.chars().take(240).collect::<String>()
        return Err("evaluating `nixosConfigurations.{host}` failed: {excerpt}")
    }
    text :: String.from_utf8_lossy(&output.stdout)
    JSON.parse(&text).map_err(e -> "parsing `nix eval` output failed: {e}")
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:123
fn live_str(root: &[(String, DataTree)], key: &String) -> String { import_json_string(root, key).unwrap_or_default() }

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:127
fn live_bool(root: &[(String, DataTree)], key: &String) -> Bool {
    if import_json_value(root, key) == { .Val(.Bool(true)) -> true; _ -> false }
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:131
fn live_num(root: &[(String, DataTree)], key: &String) -> F64? {
    if import_json_value(root, key) == { .Val(.Int(n)) -> .Val(n as F64); .Val(.Float(n)) -> .Val(n); .Val(.Number(n)) -> n.parse::<F64>().ok(); _ -> .None }
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:140
fn live_num_list(root: &[(String, DataTree)], key: &String) -> [I64] {
    import_json_value(root, key).and_then(value -> value.as_array().ok()).map(values -> values.iter().filter_map(value -> if value == { .Int(n) -> .Val(n); .Float(n) -> .Val(n as I64); .Number(n) -> n.parse::<I64>().ok(); _ -> .None }).collect::<[I64]>()).unwrap_or_default()
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:157
fn dedup_preserving_order(values: [String]) -> [String] {
    seen := BTreeSet.new()
    values.into_iter().filter(value -> seen.insert(value.clone())).collect()
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:170
fn probe_unresolvable_packages(nixpkgs_ref: &String, names: &[String]) -> [String] String! {
    if names.is_empty() { return Ok([]) }
    flake_ref :: nixpkgs_ref.strip_suffix("@github").map(rest -> "github:{rest}").ok_or_else(() -> "nixpkgs ref `{nixpkgs_ref}` is not a github pin")?
    name_list :: names.iter().map(n -> JSON.quote(n)).collect::<[String]>().join(" ")
    expr :: """let
  flake = builtins.getFlake "{flake_ref}";
  pkgs = import flake {{ system = "x86_64-linux"; config.allowUnfree = true; }};
  resolves = name: let
    underscored = builtins.replaceStrings ["-"] ["_"] name;
    extension = if builtins.substring 0 22 name == "gnome-shell-extension-"
      then builtins.substring 22 (builtins.stringLength name) name else name;
    ok = attrs: n: (attrs ? ${{n}}) && (builtins.tryEval attrs.${{n}}).success;
  in (ok pkgs name) || (ok pkgs underscored)
    || (ok (pkgs.kdePackages or {{}}) name)
    || (ok (pkgs.gnomeExtensions or {{}}) extension);
in builtins.filter (n: !(resolves n)) [ {name_list} ]"""
    output :: Command.new("nix").args(["eval", "--json", "--expr", &expr]).output().map_err(e -> "running the package resolvability probe failed: {e}")?
    if !output.status.success() {
        stderr :: String.from_utf8_lossy(&output.stderr)
        line := stderr.lines().rev().map(line -> line.trim()).find(l -> !l.is_empty()).unwrap_or("no diagnostic output") // #4303
        excerpt :: line.chars().take(240).collect::<String>()
        return Err("package resolvability probe failed: {excerpt}")
    }
    json :: JSON.parse(&String.from_utf8_lossy(&output.stdout)).map_err(e -> "parsing probe output failed: {e}")?
    Ok(json.as_array().map_err(e -> "probe output: {e}")?.iter().filter_map(v -> v.as_str().ok().map(s -> s.to_string())).collect())
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:228
fn is_hm_plumbing_package(name: &String) -> Bool {
    name == "?" || name.starts_with("dummy-") || name.starts_with("hm-session-vars") || name.ends_with(".desktop") || name.ends_with("-manpage")
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:236
fn render_live_number(n: F64) -> String { if n.fract() == 0.0 { "{n as I64}" } else { "{n}" } }

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:244
fn render_live_int_list(values: &[I64]) -> String { "[{values.iter().map(v -> v.to_string()).collect::<[String]>().join(", ")}]" }

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:257
fn live_nixpkgs_ref(source: &OSPath) -> String? {
    text :: fs.read_to_string(source.join("flake.lock")).ok() ?? return .None
    lock :: JSON.parse(&text).ok() ?? return .None
    locked :: lock.get("nodes").ok()?.get("nixpkgs").ok()?.get("locked").ok()?.as_object().ok()?
    rev :: import_json_string(locked, "rev") ?? return .None
    owner :: import_json_string(locked, "owner").unwrap_or_else(() -> "NixOS")
    repo :: import_json_string(locked, "repo").unwrap_or_else(() -> "nixpkgs")
    .Val("{owner}/{repo}/{rev}@github")
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:276
fn live_locked_github_ref(source: &OSPath, node: &String) -> String? {
    text :: fs.read_to_string(source.join("flake.lock")).ok() ?? return .None
    lock :: JSON.parse(&text).ok() ?? return .None
    locked :: lock.get("nodes").ok()?.get(node).ok()?.get("locked").ok()?.as_object().ok()?
    owner :: import_json_string(locked, "owner") ?? return .None
    repo :: import_json_string(locked, "repo") ?? return .None
    rev :: import_json_string(locked, "rev") ?? return .None
    .Val("{owner}/{repo}/{rev}@github")
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:290
fn live_external_github_inputs(source: &OSPath) -> [(String, String)] {
    text :: fs.read_to_string(source.join("flake.lock")).ok() ?? return []
    lock :: JSON.parse(&text).ok() ?? return []
    nodes_json :: lock.get("nodes").ok() ?? return []
    nodes :: nodes_json.as_object().ok() ?? return []
    out := [] as [(String, String)]
    seen_labels := BTreeSet.new()
    loop (node, value) in nodes {
        if node == "root" || node == "nixpkgs" { continue }
        obj :: value.as_object().ok() ?? continue
        locked :: import_json_value(obj, "locked").and_then(v -> v.as_object().ok()) ?? continue
        owner :: import_json_string(locked, "owner") ?? continue
        repo :: import_json_string(locked, "repo") ?? continue
        rev :: import_json_string(locked, "rev") ?? continue
        label :: sanitize_source_label(node)
        if !seen_labels.insert(label.clone()) { continue }
        out.push((label, "{owner}/{repo}/{rev}@github"))
    }
    out.sort_by((a, b) -> a.0.cmp(&b.0))
    out
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:334
fn sanitize_source_label(raw: &String) -> String {
    out := ""
    loop ch in raw.chars() {
        if ch.is_ascii_alphanumeric() || ch == '_' { out.push(ch) } else if ch == '-' { out.push('_') }
    }
    if out.is_empty() || out.chars().next().is_some_and(c -> c.is_ascii_digit()) { "src_{out}" } else { out }
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:352
fn recover_package_provenance(source: &OSPath, missing: &[String]) -> ([(String, [String])], [String]) String! {
    if missing.is_empty() { return Ok(([], [])) }
    inputs :: live_external_github_inputs(source)
    if inputs.is_empty() { return Ok(([], missing.to_vec())) }
    remaining := missing.iter().cloned().collect::<BTreeSet<String>>()
    recovered := [] as [(String, [String])]
    loop (label, github_ref) in inputs {
        if remaining.is_empty() { break }
        candidates :: remaining.iter().cloned().collect::<[String]>()
        if probe_unresolvable_packages(&github_ref, &candidates) == {
            .Ok(still_bad) -> {
                still_bad :: still_bad.into_iter().collect::<BTreeSet<String>>()
                found :: candidates.into_iter().filter(n -> !still_bad.contains(n)).collect::<[String]>()
                if !found.is_empty() {
                    loop name in &found { _ :: remaining.remove(name) }
                    recovered.push((label, found))
                }
            }
            .Err(_) -> continue
        }
    }
    Ok((recovered, remaining.into_iter().collect()))
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:395
fn merge_sourced_packages(existing: &[(String, [String])], incoming: [(String, [String])]) -> Unit {
    loop (label, pkgs) in incoming {
        if (_, slot) :: existing.iter_mut().find((l, _) -> l == &label) {
            loop p in pkgs { if !slot.contains(&p) { slot.push(p) } }
        } else { existing.push((label, pkgs)) }
    }
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:412
fn plan_from_live_facts(args: &NixosImportArgs, host: &String, root: &[(String, DataTree)]) -> NixosImportPlan String! {
    options := [] as [(String, String)]
    services := [] as [String]
    omissions := [] as [String]
    host_fact :: import_json_string(root, "host").unwrap_or_else(() -> host.to_string())
    options.push(("network.hostName", import_render_string(&host_fact)))
    if live_bool(root, "networkmanager") { options.push(("network.networkmanager.enable", "true")) }
    tcp :: live_num_list(root, "firewallTcp")
    if !tcp.is_empty() { options.push(("network.firewall.allowedTcpPorts", render_live_int_list(&tcp))) }
    udp :: live_num_list(root, "firewallUdp")
    if !udp.is_empty() { options.push(("network.firewall.allowedUdpPorts", render_live_int_list(&udp))) }
    dns :: import_json_string_array(root, "nameservers")
    if !dns.is_empty() { options.push(("network.dns", import_json_array(&dns))) }
    loop (fact, option) in [("tz", "filesystem.timeZone"), ("locale", "services.localization.locale"), ("keyboard", "services.localization.keyboardLayout")] {
        value :: live_str(root, fact)
        if !value.is_empty() { options.push((option.to_string(), import_render_string(&value))) }
    }
    if live_bool(root, "loaderLimine") { options.push(("boot.loader", ".Limine")) } else if live_bool(root, "loaderSystemdBoot") { options.push(("boot.loader", ".SystemdBoot")) }
    options.push(("boot.loader.efi.canTouchVariables", live_bool(root, "efiTouch").to_string()))
    params :: import_json_string_array(root, "kernelParams")
    if !params.is_empty() { options.push(("boot.kernel.params", import_json_array(&params))) }
    kernel :: live_str(root, "kernelName")
    extra_sources := [] as [(String, String)]
    if kernel.to_ascii_lowercase().contains("cachyos") {
        options.push(("boot.kernel", ".CachyOS"))
        if live_locked_github_ref(&args.source, "nix-cachyos-kernel") == {
            .Val(pin) -> extra_sources.push(("cachyos", pin))
            .None -> omissions.push("boot.kernel .CachyOS: the source flake.lock has no `nix-cachyos-kernel` pin; declare an `<owner>/nix-cachyos-kernel/<rev>@github` source before the real tier can build")
        }
    }
    if live_bool(root, "stylix") { omissions.push("stylix theming is enabled upstream and has no jetos realization yet (theme.* options are declarative only)") }
    if .Val(.Object(sysctl)) :: import_json_value(root, "sysctl") {
        loop (key, value) in sysctl {
            if value == { .Text(s) | .TypedText(s) if s.contains("/nix/store/") -> continue; _ -> {} }
            rendered :: if value == {
                .Int(n) -> render_live_number(n as F64)
                .Float(n) -> render_live_number(n)
                .Number(n) -> n.clone()
                .Bool(b) -> b.to_string()
                .Text(s) | .TypedText(s) -> import_render_string(s)
                other -> { omissions.push("boot.kernel.sysctl.{key} has a shape jetos cannot encode yet: {other:?}"); continue }
            }
            options.push(("performance.sysctl.{key}", rendered))
        }
    }
    if live_bool(root, "zramEnable") { options.push(("performance.zram.memoryPercent", render_live_number(live_num(root, "zramPercent").unwrap_or(50.0)))) }
    gnome :: live_bool(root, "desktopGnome") || live_bool(root, "dmGdm")
    plasma :: live_bool(root, "desktopPlasma") || live_bool(root, "dmSddm")
    if gnome { options.extend([("services.desktop.profile", ".Default"), ("services.displayManager", "\"gdm\"")]) } else if plasma { options.extend([("services.desktop.plasma.enable", "true"), ("services.displayManager", "\"sddm\"")]) }
    loop (fact, option) in [("svcPipewire", "services.audio.pipewire.enable"), ("svcRtkit", "services.audio.rtkit.enable"), ("svcLibvirtd", "services.virtualization.libvirtd.enable"), ("svcSteam", "services.gaming.steam.enable"), ("svcGamemode", "services.gaming.gamemode.enable"), ("svcPcscd", "services.smartcard.pcscd.enable")] {
        if live_bool(root, fact) { options.push((option.to_string(), "true")) }
    }
    loop (fact, service) in [("svcOpenssh", "openssh"), ("svcTailscale", "tailscale")] { if live_bool(root, fact) { services.push(service.to_string()) } }
    loop (fact, option) in [("svcDocker", "services.virtualization.docker.enable"), ("svcFlatpak", "apps.flatpak.enable"), ("svcBluetooth", "hardware.bluetooth.enable")] {
        if live_bool(root, fact) { options.push((option.to_string(), "true")) }
    }
    (kept, omitted) :: import_package_list(root, "packages")
    packages := dedup_preserving_order(kept)
    omitted_packages :: dedup_preserving_order(omitted)
    hm_by_user := [:] as [String: ([String], [String], [String])]
    if hm_json :: import_json_value(root, "hm") {
        loop entry in hm_json.as_array().map_err(e -> "hm: {e}")? {
            entry :: entry.as_object().map_err(e -> "hm entry: {e}")?
            name :: import_json_string(entry, "name") ?? continue
            (kept, omitted) :: import_package_list(entry, "packages")
            programs :: import_json_string_array(entry, "programs")
            hm_by_user.insert(name, (kept, omitted, programs))
        }
    }
    users := [] as [NixosImportUser]
    if users_json :: import_json_value(root, "users") {
        loop user_json in users_json.as_array().map_err(e -> "users: {e}")? {
            user :: user_json.as_object().map_err(e -> "user entry: {e}")?
            name :: import_json_string(user, "name") ?? continue
            if !args.users.is_empty() && !args.users.iter().any(wanted -> wanted == &name) { continue }
            shell :: live_str(user, "shell")
            if !shell.is_empty() && import_is_ident(&shell) { options.push(("users.{name}.shell", "nixpkgs.{shell}")) }
            has_home_manager :: hm_by_user.contains_key(&name)
            (hm_packages, hm_omitted, hm_programs) :: hm_by_user.remove(&name).unwrap_or_default()
            hm_packages :: dedup_preserving_order(hm_packages).into_iter().filter(p -> !is_hm_plumbing_package(p)).collect::<[String]>()
            hm_omitted :: dedup_preserving_order(hm_omitted).into_iter().filter(p -> !is_hm_plumbing_package(p)).collect::<[String]>()
            loop program in &hm_programs {
                if importable_hm_program(program) == {
                    .Val(key) -> options.push((key, "true"))
                    .None -> omissions.push("Home Manager program `{program}` for user `{name}` needs manual conversion")
                }
            }
            if has_home_manager { options.push(("user.{name}.homeManager", "true")) }
            users.push(NixosImportUser(name: name.clone(), home: import_json_string(user, "home"), groups: import_json_string_array(user, "groups"), packages: hm_packages, sourced_packages: [], omitted_packages: hm_omitted, home_manager: has_home_manager))
        }
    }
    omissions.extend(omitted_packages.iter().map(p -> "package `{p}` uses a Nix attr path JetOS cannot encode yet"))
    loop user in &users { omissions.extend(user.omitted_packages.iter().map(p -> "Home Manager package `{p}` for user `{user.name}` uses a Nix attr path JetOS cannot encode yet")) }
    nixpkgs_ref :: live_nixpkgs_ref(&args.source).unwrap_or_else(() -> "nixpkgs-unstable@nixpkgs")
    system_before :: packages.iter().cloned().collect::<BTreeSet<String>>()
    user_before :: users.iter().map(u -> (u.name.clone(), u.packages.iter().cloned().collect::<BTreeSet<String>>())).collect::<[(String, BTreeSet<String>)]>()
    probe_names := packages.clone()
    loop user in &users { probe_names.extend(user.packages.iter().cloned()) }
    probe_names = dedup_preserving_order(probe_names)
    sourced_packages := [] as [(String, [String])]
    if probe_unresolvable_packages(&nixpkgs_ref, &probe_names) == {
        .Ok(unresolvable) if !unresolvable.is_empty() -> {
            external :: unresolvable.into_iter().collect::<BTreeSet<String>>()
            packages.retain(p -> !external.contains(p))
            loop user in &users { user.packages.retain(p -> !external.contains(p)) }
            missing :: external.into_iter().collect::<[String]>()
            input_pins :: live_external_github_inputs(&args.source)
            if recover_package_provenance(&args.source, &missing) == {
                .Ok((recovered, still_missing)) -> {
                    loop (label, pkgs) in recovered {
                        if (_, pin) :: input_pins.iter().find((l, _) -> l == &label) {
                            if !extra_sources.iter().any((n, _) -> n == &label) { extra_sources.push((label.clone(), pin.clone())) }
                        }
                        system_pkgs := [] as [String]
                        loop pkg in &pkgs {
                            if system_before.contains(pkg) { system_pkgs.push(pkg.clone()) }
                            loop (uname, upkgs) in &user_before {
                                if upkgs.contains(pkg) {
                                    if user :: users.iter_mut().find(u -> u.name == uname) { merge_sourced_packages(&user.sourced_packages, [(label.clone(), [pkg.clone()])]) }
                                }
                            }
                        }
                        if !system_pkgs.is_empty() { merge_sourced_packages(&sourced_packages, [(label, system_pkgs)]) }
                    }
                    loop name in still_missing { omissions.push("package `{name}` comes from another flake input (not the pinned nixpkgs) and no locked github input resolves it") }
                }
                .Err(e) -> { loop name in missing { omissions.push("package `{name}` comes from another flake input (not the pinned nixpkgs); provenance recovery failed ({e})") } }
            }
        }
        .Ok(_) -> {}
        .Err(e) -> omissions.push("package resolvability probe failed ({e}); non-nixpkgs packages may break the real-tier build")
    }
    Ok(NixosImportPlan(source: args.source.clone(), mode: "semantic-eval", host: host.to_string(), target: "linux.x64", nixpkgs_ref: nixpkgs_ref, extra_sources: extra_sources, packages: packages, sourced_packages: sourced_packages, omitted_packages: omitted_packages, services: services, options: options, users: users, modules: [], home_modules: [], omissions: omissions))
}

// Rust: crates/jetpack/src/JetOS/nixos_import_live.rs:799
fn importable_hm_program(program: &String) -> String? {
    if program == { "git" | "fish" | "starship" | "helix" | "ghostty" | "vscode" -> .Val("apps.program.{program}.enable"); _ -> .None }
}
