// Whole pure functions from crates/jetpack/src/JetOS/nixos_import.rs.
// These are audited draft artifacts, not a Nix evaluator or a service migration.
pub struct JetOSNixosImportPlan {
    pub source: String
    pub mode: String
    pub host: String
    pub target: String
    pub nixpkgs_ref: String
    pub extra_sources: [(label: String, upstream: String)]
    pub packages: [String]
    pub sourced_packages: [(label: String, packages: [String])]
    pub omitted_packages: [String]
    pub services: [String]
    pub options: [(key: String, value: String)]
    pub users: [JetOSNixosImportUser]
    pub modules: [String]
    pub home_modules: [String]
    pub omissions: [String]
}

pub struct JetOSNixosImportUser {
    pub name: String
    pub home: String?
    pub groups: [String]
    pub packages: [String]
    pub sourced_packages: [(label: String, packages: [String])]
    pub omitted_packages: [String]
    pub home_manager: Bool
}

// Rust :474-491: only the first occurrence of each marker is considered;
// dotted syntax wins even when the record-form marker appears earlier.
pub fn jetos_nixos_import_scan_first_host(text: String) -> String? Never! {
    loop marker in ([String]{"nixosConfigurations.", "nixosConfigurations = {{"}) {
        if text.split_once(marker) == .Val(parts) {
            rest := parts.after.trim_start() // #4303
            rest = pkg_trim_start_matches(rest, "{{").trim_start()
            raw :: rest.bytes()
            end := 0
            loop end < raw.len() {
                code :: Int.from_u8(raw[end])
                if !((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 || code == 45) -> break
                end += 1
            }
            if end > 0 {
                // The scanned prefix is ASCII: this byte slice is valid UTF-8.
                candidate :: String.from_bytes(raw.slice(0, end)) ?? panic("ASCII host candidate")
                return Val(candidate.replace("-", "_"))
            }
        }
    }
    None
}

// Rust :744-751; validation belongs to the canonical PackageModel predicate.
pub fn jetos_nixos_import_ident_or_host(value: String) -> String Never! {
    candidate :: value.replace("-", "_")
    if pkg_is_ascii_identifier(candidate) -> candidate else -> "host"
}

// Rust :562-573: the ordered tuple list retains duplicate source labels/packages.
pub fn jetos_nixos_import_render_package_groups(nixpkgs: [String], sourced: [(label: String, packages: [String])]) -> String Never! {
    refs := [String]{}
    loop package in nixpkgs -> &refs.push("nixpkgs.{package}")
    loop source in sourced {
        loop package in source.packages -> &refs.push("{source.label}.{package}")
    }
    "[{refs.join(", ")}]"
}

// Rust :493-560. Source/option text is already lowered by the upstream reader;
// only host, service and group identifiers are treated as in the Rust renderer.
pub fn jetos_nixos_import_render_config(plan: JetOSNixosImportPlan) -> String Never! {
    host :: jetos_nixos_import_ident_or_host(plan.host)
    parts := [String]{"// Generated by `jet os import` from {plan.source}\n", "// Review jetos-import-audit.json before switching this host.\n", "module {host} {{\n", "    sources: {{\n", "        nixpkgs: {plan.nixpkgs_ref},\n"}
    loop source in plan.extra_sources -> &parts.push("        {source.label}: {source.upstream},\n")
    &parts.push("    }}\n")
    &parts.push("    system.{host}: {{\n")
    &parts.push("        target: {plan.target},\n")
    &parts.push("        packages: {jetos_nixos_import_render_package_groups(plan.packages, plan.sourced_packages)},\n")
    &parts.push("        services: {{\n")
    loop service in plan.services {
        if pkg_is_ascii_identifier(service) {
            // Literal audited draft content; not an implemented service exec.
            &parts.push("            {service}: {{ enable: true, exec: \"/usr/bin/env true\" }},\n")
        }
    }
    &parts.push("        }},\n")
    &parts.push("        options: [\n")
    loop option in plan.options -> &parts.push("            {option.key}: {option.value},\n")
    loop user in plan.users {
        &parts.push("            users.{user.name}.normal: true,\n")
        if user.home == .Val(home) -> &parts.push("            users.{user.name}.home: {foundation_json_quote(home)},\n")
        loop group in user.groups {
            if pkg_is_ascii_identifier(group) -> &parts.push("            groups.{group}.members: [users.{user.name}],\n")
        }
        if user.packages.len() > 0 || user.sourced_packages.len() > 0 {
            &parts.push("            user.{user.name}.packages: {jetos_nixos_import_render_package_groups(user.packages, user.sourced_packages)},\n")
        }
    }
    &parts.push("        ],\n")
    &parts.push("    }}\n")
    &parts.push("}}\n")
    parts.join("")
}

// Rust :575-605. Flatten directly into quoted fragments, without cloning the
// complete package table merely to feed the JSON string-array projection.
pub fn jetos_nixos_import_render_audit(plan: JetOSNixosImportPlan) -> String Never! {
    quoted_packages := [String]{}
    if plan.packages.len() > 0 -> &quoted_packages.push(jetos_strings_json(plan.packages))
    sourced_labels := [String]{}
    loop source in plan.sourced_packages {
        if source.packages.len() > 0 -> &quoted_packages.push(jetos_strings_json(source.packages))
        &sourced_labels.push(source.label)
    }
    users := [String]{}
    loop user in plan.users -> &users.push(user.name)
    "{{\n  \"kind\":\"jetos.import.audit\",\n  \"mode\":{foundation_json_quote(plan.mode)},\n  \"source\":{foundation_json_quote(plan.source)},\n  \"host\":{foundation_json_quote(plan.host)},\n  \"packages\":[{quoted_packages.join(",")}],\n  \"sourced_package_inputs\":[{jetos_strings_json(sourced_labels)}],\n  \"omitted_packages\":[{jetos_strings_json(plan.omitted_packages)}],\n  \"services\":[{jetos_strings_json(plan.services)}],\n  \"users\":[{jetos_strings_json(users)}],\n  \"flake_parts_modules\":[{jetos_strings_json(plan.modules)}],\n  \"home_manager_modules\":[{jetos_strings_json(plan.home_modules)}],\n  \"omissions\":[{jetos_strings_json(plan.omissions)}]\n}}\n"
}
