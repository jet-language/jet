use jetpack.JetOS.EtcBootFacts.[jetos_cachyos_kernel_entry, jetos_kernel_package_json]
use jetpack.JetOS.OptionsRendering.[jetos_clean_value, jetos_collect_names, jetos_option_value, jetos_package_path_or_literal, jetos_service_extra, jetos_shell_single_quote]
use jetpack.JetOS.RootProjection.[jetos_enable_unit]
use jetpack.JetOS.Types.[JetOSRealizedPackage]
use jetpack.[JSON]
use jet_env_model.ModuleEval.[SystemPlan]
use std.[fs]
use std.io.[Error]

// Rust: crates/jetpack/src/JetOS/activation_provenance.rs:13
pub fn write_activation_diff(dir: OSPath, published_dir: OSPath, system: &SystemPlan, realized: &[JetOSRealizedPackage]) -> () Error! {
    enabled_services :: system.services.iter().filter(s -> s.enable).count()
    diff := "host: {system.name}\nprevious: <activation-time>\nnext: {published_dir.display()}\npackages: {realized.len()}\nservices: {enabled_services}\noptions: {system.options.len()}\n"
    loop pkg in realized { &diff.push_str("  package {pkg.entry.reference} -> {pkg.entry.out}\n") }
    loop svc in system.services.iter().filter(s -> s.enable) { &diff.push_str("  service {svc.name} enable=true\n") }
    loop option in system.options { &diff.push_str("  option {option.key} = {option.value}\n") }
    // GATE #4494: native filesystem write; exact source artifact bytes.
    fs.write(dir.join("activation-diff.txt"), diff)
}
// Rust: crates/jetpack/src/JetOS/activation_provenance.rs:39
pub fn write_health_checks(dir: OSPath, system: &SystemPlan) -> () Error! {
    out := "jetos health checks\n"
    loop svc in system.services.iter().filter(s -> s.enable) {
        check :: jetos_service_extra(svc, ["health", "ready"]) ?? "systemctl is-active {svc.name}"
        &out.push_str("service {svc.name}: {check}\n")
    }
    host :: jetos_option_value(system, ["network.hostName", "network.hostname"]) ?? system.name.clone()
    &out.push_str("network hostname: {host}\n")
    loop name in jetos_collect_names(system, "health") {
        if command :: jetos_option_value(system, ["health.{name}.command"]) { &out.push_str("check {name}: {command}\n") }
    }
    fs.write(dir.join("health-checks.txt"), out)
}
// Rust: crates/jetpack/src/JetOS/activation_provenance.rs:58
pub fn write_provenance(dir: OSPath, system: &SystemPlan, realized: &[JetOSRealizedPackage]) -> () Error! {
    packages :: realized.iter().map(p -> JSON.object_of([
        ("name", p.entry.name), ("reference", p.entry.reference), ("out", p.entry.out),
        ("bin", p.entry.bin), ("output_hash", p.entry.envelope.output_hash), ("provenance", p.entry.envelope.provenance)
    ])).collect<[String]>().join(",")
    kernel :: jetos_cachyos_kernel_entry(realized).map(entry -> jetos_kernel_package_json(entry)) ?? "null"
    text :: "{{\"host\":{JSON.quote(system.name)},\"target\":{JSON.quote(system.target)},\"kernel\":{kernel},\"packages\":[{packages}],\"compat_escape_hatches\":[{compat_hatches_json(system)}]}}"
    fs.write(dir.join("provenance.json"), text)
}
// Rust: crates/jetpack/src/JetOS/activation_provenance.rs:91
pub fn compat_hatches_json(system: &SystemPlan) -> String {
    hatches := [String]{}
    loop option in system.options {
        if option.key.starts_with("packages.overlay.") || option.key.starts_with("packages.specialArgs.") || option.key.starts_with("packages.nixModule.") {
            &hatches.push(JSON.object_of([
                ("key", option.key), ("value", jetos_clean_value(option.value)), ("audit", "compatibility escape hatch"),
                ("provenance_visible", "true"), ("studio_visible", "true"), ("native_replacement", "tracked")
            ]))
        }
    }
    hatches.join(",")
}
// Rust: crates/jetpack/src/JetOS/activation_provenance.rs:111
pub fn write_systemd_units(dir: OSPath, system: &SystemPlan) -> () Error! {
    unit_dir :: dir.join("etc/systemd/system")
    fs.create_dir_all(unit_dir)?
    loop svc in system.services {
        if !svc.enable { continue }
        exec :: svc.extra.iter().find(field -> field.key == "exec" || field.key == "command")
            .map(field -> field.value.trim_matches('"').to_string()) ?? "/usr/bin/env true"
        fs.write(unit_dir.join("{svc.name}.service"), "[Unit]\nDescription=jetos service {svc.name}\n\n[Service]\nExecStart={exec}\nRestart=on-failure\n\n[Install]\nWantedBy=multi-user.target\n")?
        jetos_enable_unit(unit_dir, "multi-user.target", "{svc.name}.service")?
    }
    .Ok(())
}
// Rust: crates/jetpack/src/JetOS/activation_provenance.rs:140
pub fn write_terminal_environment(dir: OSPath, system: &SystemPlan) -> () Error! {
    terminal_dir :: dir.join("terminal")
    etc :: dir.join("etc")
    unit_dir :: etc.join("systemd/system")
    fs.create_dir_all(terminal_dir)?
    fs.create_dir_all(etc)?
    fs.create_dir_all(unit_dir)?
    users :: jetos_collect_names(system, "users")
    login_user :: users.first().cloned() ?? "root"
    shell :: if login_user == "root" -> "/bin/sh"
        else -> jetos_option_value(system, ["users.{login_user}.shell"]).map(s -> jetos_package_path_or_literal(s)) ?? "/run/current-system/sw/bin/sh"
    shells := "/bin/sh\n/run/current-system/sw/bin/sh\n"
    if !shells.lines().any(line -> line == shell) { &shells.push_str("{shell}\n") }
    fs.write(etc.join("shells"), shells)?
    prompt_label :: "JetOS {system.name}"
    prompt_bash :: "\\[\\033[1;36m\\]JetOS\\[\\033[0m\\] \\[\\033[2m\\]{system.name}\\[\\033[0m\\] \\w \\$ "
    prompt_plain :: "JetOS {system.name} $ "
    fs.write(etc.join("profile"), "export PATH=/run/current-system/sw/bin:/bin:/sbin:/usr/bin:/usr/sbin\nexport JETOS_GENERATION=/run/current-system\nexport JETOS_HOST={jetos_shell_single_quote(system.name)}\nexport JETOS_BRAND=JetOS\nexport JETOS_PROMPT={jetos_shell_single_quote(prompt_label)}\nif [ -n \"${{BASH_VERSION:-}}\" ]; then\n    PS1={jetos_shell_single_quote(prompt_bash)}\nelse\n    PS1={jetos_shell_single_quote(prompt_plain)}\nfi\nexport PS1\n")?
    fs.write(etc.join("issue"), "JetOS {system.name}\nproof-backed system shell\n\\n \\l\n")?
    fs.write(etc.join("motd"), "JetOS {system.name}\n/run/current-system is live\nsource-owned, proof-backed\n")?
    fs.write(etc.join("securetty"), "ttyS0\ntty1\n")?
    home_root :: dir.join("home")
    loop user in users {
        home :: jetos_option_value(system, ["users.{user}.home"]) ?? "/home/{user}"
        if rel :: home.strip_prefix('/') {
            fs.create_dir_all(dir.join(rel))?
            fs.write(dir.join(rel).join(".profile"), ". /etc/profile\ncd \"$HOME\" 2>/dev/null || true\n")?
        } else {
            fs.create_dir_all(home_root.join(user))?
        }
    }
    fs.write(unit_dir.join("serial-getty@ttyS0.service"), "[Unit]\nDescription=jetos serial login on %I\nAfter=systemd-user-sessions.service plymouth-quit-wait.service\n\n[Service]\nExecStart=/run/current-system/sw/bin/agetty --autologin {login_user} --noclear %I 115200 linux\nType=idle\nRestart=always\n\n[Install]\nWantedBy=getty.target\n")?
    jetos_enable_unit(unit_dir, "getty.target", "serial-getty@ttyS0.service")?
    fs.write(unit_dir.join("getty@tty1.service"), "[Unit]\nDescription=jetos virtual-console login on %I\nAfter=systemd-user-sessions.service plymouth-quit-wait.service\n\n[Service]\nExecStart=/run/current-system/sw/bin/agetty --autologin {login_user} --noclear %I linux\nType=idle\nRestart=always\n\n[Install]\nWantedBy=getty.target\n")?
    jetos_enable_unit(unit_dir, "getty.target", "getty@tty1.service")?
    fs.write(terminal_dir.join("facts.json"), "{{\"login_user\":{JSON.quote(login_user)},\"shell\":{JSON.quote(shell)},\"serial_tty\":\"ttyS0\",\"virtual_tty\":\"tty1\",\"profile\":\"/etc/profile\",\"prompt\":{JSON.quote(prompt_plain)},\"motd\":\"/etc/motd\",\"unit_dir\":\"etc/systemd/system\",\"proof\":\"terminal-login-ready\"}}")
}
