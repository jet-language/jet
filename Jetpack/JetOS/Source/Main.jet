// The `jetos` binary — direct front door for JetOS system tools.
// Card #367 / D-PRODUCT-SPLIT1=C: JetOS owns this entry point while
// realization continues through Jetpack's `os` verb.
use jetpack.Codegen.MIREval.[install_mir_bridge]
use jetpack.[run]
use std.[env, process]

// Rust: crates/jetos/src/main.rs:13
fn main() -> {
    install_mir_bridge()
    // GATE #4494: native process arguments and exit.
    args: [String] := env.args().skip(1).collect()
    args.insert(0, "os")
    process.exit(run(args))
}

