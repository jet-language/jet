use jetpack.JetOS.GenerationFiles.[generations_log, systems_dir]
use jetpack.JetOS.OptionsRendering.[risk_classes]
use jetpack.JetOS.Types.[JetOSGeneration]
use jetpack.Output.[Theme]
use jetpack.[Store, JSON, SHA256, RuntimePolicy]
use jet_env_model.ModuleEval.[SystemPlan]
use std.[fs, env, io]
use std.time.[SystemTime, UNIX_EPOCH]
use core.sys.target.[selected_family]

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:12
pub fn prove_activation(theme: &Theme, gen: &JetOSGeneration, system: &SystemPlan) -> Bool {
    risks :: risk_classes(system)
    plan :: gen.path.join("plan.json")
    proof :: gen.path.join("proof.txt")
    if !plan.is_file() || !proof.is_file() {
        theme.error_coded("E1278", "jetos activation proof is incomplete", "D-WD8 requires a plan and proof artifact before `jet os switch` can activate a generation.", "run `jet os build <host>` again; if the generation is hand-edited, discard it.")
        return false
    }
    loop svc in system.services.iter().filter(s -> s.enable) {
        unit :: gen.path.join("etc/systemd/system").join("{svc.name}.service")
        if !unit.is_file() {
            theme.error_coded("E1278", "jetos service proof is incomplete", "`{svc.name}` is enabled, but its generated systemd unit is missing.", "rebuild the generation so service artifacts and proof are regenerated together.")
            return false
        }
    }
    plan_text :: if fs.read_to_string(&plan) == {
        .Ok(text) -> text
        .Err(e) -> {
            theme.error_coded("E1278", "jetos activation proof is incomplete", "reading the plan artifact failed: {e}", "rebuild the generation so plan and proof artifacts are regenerated together.")
            return false
        }
    }
    plan_hash :: SHA256.sha256_hex(plan_text.as_bytes())
    if !risks.is_empty() {
        vm_proof :: gen.path.join("vm-proof.txt")
        vm_text :: if fs.read_to_string(&vm_proof) == {
            .Ok(text) -> text
            .Err(_) -> {
                theme.error_coded("E1278", "jetos VM proof is missing", "D-WD8 requires a plan-bound VM/service proof artifact for boot, kernel, filesystem, or service-risk changes.", "run `jet os build <host>` again; if the generation is hand-edited, discard it.")
                return false
            }
        }
        if !vm_text.contains("plan-sha256: {plan_hash}") || !vm_text.contains("service-artifacts: pass") {
            theme.error_coded("E1278", "jetos VM proof is stale", "the VM/service proof does not match the generation plan artifact.", "rebuild the generation so proof and plan are regenerated together.")
            return false
        }
    }
    rollback :: rollback_proof_for(gen.host, &gen.path)
    if rollback.starts_with("warning") {
        theme.error_coded("E1278", "jetos rollback proof is incomplete", rollback, "remove stale generation ledger entries or rebuild the previous generation.")
        return false
    }
    activation := String.new()
    activation.push_str("activation proof for {gen.host}\n")
    activation.push_str("generation: {gen.name}\n")
    activation.push_str("risk: {if risks.is_empty() -> "low" else -> risks.join(", ")}\n")
    activation.push_str("plan-diff: pass\n")
    if risks.is_empty() { activation.push_str("vm-proof: not required for low-risk change\n") } else { activation.push_str("vm-proof: pass plan-sha256={plan_hash}\n") }
    activation.push_str("rollback-proof: {rollback}\n")
    activation_path :: systems_dir().join("activation-proofs").join(gen.host).join("{gen.name}.txt")
    activation_parent :: activation_path.parent().unwrap_or_else(() -> OSPath.from("."))
    write_activation :: () -> Unit io.Error! {
        fs.create_dir_all(activation_parent)?
        fs.write(&activation_path, activation.as_bytes())?
        fs.File.open(&activation_path)?.sync_all()?
        Store.sync_store_node(activation_parent, true)
    }
    if write_activation() == {
        .Ok(()) -> {}
        .Err(e) -> {
            theme.error_coded("E1278", "jetos activation proof could not be recorded", "writing activation proof failed: {e}", "check permissions on the Jetpack root, or set JETPACK_ROOT.")
            return false
        }
    }
    theme.detail("activation proof: pass")
    true
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:134
fn rollback_proof_for(host: String, current: &OSPath) -> String {
    current :: current.canonicalize().unwrap_or_else(_ -> current.to_path_buf())
    gens := read_generations().into_iter().filter(g -> g.host == host).filter(g -> g.path.is_dir()).filter(g -> g.path.canonicalize().map(p -> p != current).unwrap_or(true)).collect::<[JetOSGeneration]>()
    gens.sort_by((a, b) -> b.created_at.cmp(a.created_at).then_with(() -> b.name.cmp(a.name)))
    if gens.into_iter().next() == {
        .Val(prev) -> "pass previous={prev.name}"
        .None -> "pass initial-activation"
    }
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:155
pub fn append_generation(gen: &JetOSGeneration, witness: String) -> U64 io.Error! {
    roots :: Store.resolve()
    // GATE #4494: native lock, file truncation, append and durable sync.
    RuntimePolicy.with_lock(&roots.root, "jetos-generations", () -> {
        log :: generations_log()
        parent :: log.parent().ok_or_else(() -> io.Error.other("generation ledger has no parent"))?
        fs.create_dir_all(parent)?
        existing := if fs.read(&log) == {
            .Ok(bytes) -> bytes
            .Err(error) if error.kind() == io.ErrorKind.NotFound -> [U8]{}
            .Err(error) -> return Err(^error)
        }
        if !existing.is_empty() && !existing.ends_with(&[10]) {
            recovered_len :: existing.iter().rposition(byte -> byte == 10).map(offset -> offset + 1).unwrap_or(0)
            file :: fs.OpenOptions.new().write(true).open(&log)?
            file.set_len(recovered_len as U64)?
            file.sync_all()?
            existing.truncate(recovered_len)
        }
        if created_at :: ledger_timestamp_in(&existing, gen, witness)? {
            file :: fs.OpenOptions.new().read(true).open(&log)?
            file.sync_all()?
            if generation_failpoint("after-ledger-durable") { return Err(io.Error.other("generation ledger durability failpoint")) }
            Store.sync_store_node(parent, true)?
            return Ok(created_at)
        }
        line :: "{gen.created_at}\t{gen.host}\t{gen.name}\t{gen.path.display()}\t{witness}\n"
        file := fs.OpenOptions.new().create(true).append(true).open(&log)?
        if generation_failpoint("after-ledger-partial") {
            file.write_all(&line.as_bytes()[0..line.len() / 2])?
            file.sync_all()?
            return Err(io.Error.other("generation ledger partial-write failpoint"))
        }
        file.write_all(line.as_bytes())?
        if generation_failpoint("after-ledger-append") { return Err(io.Error.other("generation ledger append failpoint")) }
        file.sync_all()?
        if generation_failpoint("after-ledger-durable") { return Err(io.Error.other("generation ledger durability failpoint")) }
        Store.sync_store_node(parent, true)?
        Ok(gen.created_at)
    })
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:225
pub fn generation_ledger_timestamp(gen: &JetOSGeneration, witness: String) -> U64? io.Error! {
    bytes :: if fs.read(generations_log()) == {
        .Ok(bytes) -> bytes
        .Err(error) if error.kind() == io.ErrorKind.NotFound -> [U8]{}
        .Err(error) -> return Err(^error)
    }
    complete :: if bytes.ends_with(&[10]) -> bytes.as_slice() else -> {
        len :: bytes.iter().rposition(byte -> byte == 10).map(offset -> offset + 1).unwrap_or(0)
        &bytes[0..len]
    }
    ledger_timestamp_in(complete, gen, witness)
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:247
fn ledger_timestamp_in(bytes: &[U8], gen: &JetOSGeneration, witness: String) -> U64? io.Error! {
    text :: std.str.from_utf8(bytes).map_err(_ -> io.Error.other("generation ledger is not UTF-8"))?
    loop line in text.lines() {
        parts :: line.split('\t').collect::<[String]>()
        if parts.len() < 3 || parts[1] != gen.host || parts[2] != gen.name { continue }
        if parts.len() != 5 || OSPath.from(parts[3]) != gen.path || parts[4] != witness { return Err(io.Error.other("generation ledger cannot replace an immutable publication")) }
        created_at :: parts[0].parse::<U64>().map_err(_ -> io.Error.other("generation ledger timestamp is invalid"))?
        return Ok(Val(created_at))
    }
    Ok(None)
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:272
fn generation_failpoint(name: String) -> Bool {
    core.sys.target.debug_assertions() && env.var("JET_TEST_GENERATION_FAILPOINT").as_deref() == Ok(name)
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:276
pub fn read_generations() -> [JetOSGeneration] {
    text :: fs.read_to_string(generations_log()).ok() ?? return []
    out := [JetOSGeneration]{}
    loop line in text.lines() {
        parts :: line.split('\t').collect::<[String]>()
        if parts.len() != 4 && parts.len() != 5 { continue }
        created_at :: parts[0].parse::<U64>().ok() ?? continue
        out.push(JetOSGeneration{created_at: created_at, host: parts[1].to_string(), name: parts[2].to_string(), path: OSPath.from(parts[3])})
    }
    ^out
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:299
pub fn latest_generation_for(host: String) -> JetOSGeneration? {
    gens := read_generations().into_iter().filter(g -> g.host == host).filter(g -> g.path.is_dir()).collect::<[JetOSGeneration]>()
    gens.sort_by((a, b) -> b.created_at.cmp(a.created_at).then_with(() -> b.name.cmp(a.name)))
    gens.into_iter().next()
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:313
pub fn generation_named(host: String, name: String) -> JetOSGeneration? {
    read_generations().into_iter().find(generation -> generation.host == host && generation.name == name && generation.path.is_dir())
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:319
pub fn render_generation_proof_json(gen: &JetOSGeneration) -> String io.Error! {
    plan :: fs.read_to_string(gen.path.join("plan.json"))?
    proof :: fs.read_to_string(gen.path.join("proof.txt"))?
    activation_diff :: fs.read_to_string(gen.path.join("activation-diff.txt"))?
    health :: fs.read_to_string(gen.path.join("health-checks.txt"))?
    provenance :: fs.read_to_string(gen.path.join("provenance.json"))?
    boot :: fs.read_to_string(gen.path.join("boot/facts.json"))?
    init :: fs.read_to_string(gen.path.join("init/systemd.json"))?
    secrets :: fs.read_to_string(gen.path.join("secrets.tmpfs.manifest"))?
    vm_proof :: fs.read_to_string(gen.path.join("vm-proof.txt")).unwrap_or_default()
    source_proof :: fs.read_to_string(gen.path.join("source-proof.json"))?
    Ok("{{\"host\":{JSON.quote(gen.host)},\"generation\":{JSON.quote(gen.name)},\"path\":{JSON.quote(gen.path.display().to_string())},\"created_at\":{gen.created_at},\"source_proof\":{source_proof},\"plan\":{JSON.quote(plan)},\"proof\":{JSON.quote(proof)},\"activation_diff\":{JSON.quote(activation_diff)},\"health\":{JSON.quote(health)},\"provenance\":{provenance},\"boot\":{boot},\"init\":{init},\"secrets\":{JSON.quote(secrets)},\"vm_proof\":{JSON.quote(vm_proof)}}}")
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:349
pub fn find_rollback_generation(host: String, requested: String?) -> JetOSGeneration? {
    current :: current_generation_path()
    gens := read_generations().into_iter().filter(g -> g.host == host).filter(g -> g.path.is_dir()).filter(g -> current.as_ref().map(c -> g.path.canonicalize().map(p -> p != c).unwrap_or(true)).unwrap_or(true)).collect::<[JetOSGeneration]>()
    gens.sort_by((a, b) -> b.created_at.cmp(a.created_at))
    if name :: requested { return gens.into_iter().find(g -> g.name == name) }
    gens.into_iter().next()
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:369
pub fn activate_generation(gen: &JetOSGeneration) -> Unit io.Error! {
    dir :: systems_dir()
    fs.create_dir_all(&dir)?
    write_pointer(&dir.join("current"), &gen.path)?
    write_pointer(&dir.join("default"), &gen.path)?
    Ok(())
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:378
// Rust: crates/jetpack/src/JetOS/generations_activation.rs:386
fn write_pointer(link: &OSPath, target: &OSPath) -> Unit io.Error! {
    tmp :: link.with_extension("tmp")
    // GATE #4494 native symlink; #4483 selected Unix/nonUnix dispatch.
    if selected_family() == .Unix {
        _ :: fs.remove_file(&tmp)
        std.os.unix.fs.symlink(target, &tmp)?
    } else { fs.write(&tmp, target.display().to_string())? }
    fs.rename(^tmp, link)
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:392
pub fn current_generation_path() -> OSPath? {
    link :: systems_dir().join("current")
    if selected_family() == .Unix {
        fs.read_link(&link).ok().and_then(p -> p.canonicalize().ok())
    } else {
        fs.read_to_string(&link).ok().and_then(s -> {
            trimmed := s.trim() // #4303
            OSPath.from(trimmed).canonicalize().ok()
        })
    }
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:408
pub fn now_secs() -> U64 {
    // GATE #4494 native epoch clock.
    SystemTime.now().duration_since(UNIX_EPOCH).map(d -> d.as_secs()).unwrap_or(0)
}

// Rust: crates/jetpack/src/JetOS/generations_activation.rs:415
pub fn print_help() -> {
    println("jet os check|init|plan|proof|build|switch|rollback|generations|lift|import|image|vm <host>|host@root")
}
