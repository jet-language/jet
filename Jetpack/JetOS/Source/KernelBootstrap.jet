use jetpack.JetOS.EtcBootFacts.[boot_artifact, cachyos_kernel_entry, is_initrd_image, is_linux_kernel_image, missing_kernel_source_files]
use jetpack.JetOS.GenerationFiles.[copy_profile_tree]
use jetpack.JetOS.Types.[JetOSRealizedPackage, JetOSBootProfile, JETOS_CACHYOS_KERNEL_PACKAGE, JETOS_SYSTEMD_INIT_PACKAGE]
use jetpack.Output.[Theme]
use std.[fs, env, io]
use std.process.[Command]

// Rust: crates/jetpack/src/JetOS/kernel_bootstrap.rs:13
pub fn run_kernel_bootstrap_builder(theme: &Theme, boot: &JetOSBootProfile, realized: &[JetOSRealizedPackage], use_host_defaults: Bool, generation_dir: &OSPath) -> Bool {
    if boot.kernel != "CachyOS" { return true }
    index :: realized.iter().position(entry -> entry.entry.name == JETOS_CACHYOS_KERNEL_PACKAGE) ?? return true
    entry :: &realized[index]
    if missing_kernel_source_files(entry).is_some() { return true }
    source_out :: entry.consumption_path(entry.entry.out).ok() ?? return false
    out :: generation_dir.join("kernel-build").join(entry.entry.name)
    if out.exists() { _ :: fs.remove_dir_all(&out) }
    if copy_profile_tree(&source_out, &out) == {
        .Ok(()) -> {}
        .Err(error) -> {
            theme.error_coded("E1286", "jetos CachyOS source build failed", "copying the leased kernel package into generation scratch failed: {error}.", "check the first-party cachyos-kernel source recipe and rerun `jet os build`.")
            return false
        }
    }
    realized[index].set_consumption_override(out.clone())
    script :: out.join("source/build.sh")
    if !script.is_file() { return true }
    boot_dir :: out.join("boot")
    if fs.create_dir_all(&boot_dir).and_then(_ -> make_tree_writable(&boot_dir)) == {
        .Ok(()) -> {}
        .Err(e) -> {
            theme.error_coded("E1286", "jetos CachyOS source build failed", "could not create the cachyos-kernel boot artifact directory: {e}.", "check the first-party cachyos-kernel source recipe and rerun `jet os build`.")
            return false
        }
    }
    // GATE #4494 native environment and subprocess execution.
    output :: if Command.new(&script).current_dir(&out).env("PATH", jetos_bootstrap_path()).env("JETOS_KERNEL_OUT", out.join("boot")).env("JETOS_KERNEL_SOURCE", out.join("source")).env("JETOS_KERNEL_PACKAGE", ^out).envs(default_cachyos_kernel_env(use_host_defaults)).output() == {
        .Ok(output) -> output
        .Err(e) -> {
            theme.error_coded("E1286", "jetos CachyOS source build failed", "running `source/build.sh` failed: {e}.", "check the first-party cachyos-kernel source recipe and rerun `jet os build`.")
            return false
        }
    }
    if !output.status.success() {
        stderr := String.from_utf8_lossy(&output.stderr).trim() // #4303
        theme.error_coded("E1286", "jetos CachyOS source build failed", "`source/build.sh` exited with {output.status}; stderr: {stderr}", "check the first-party cachyos-kernel source recipe and rerun `jet os build`.")
        return false
    }
    true
}

// Rust: crates/jetpack/src/JetOS/kernel_bootstrap.rs:101
fn make_tree_writable(path: &OSPath) -> Unit io.Error! {
    perms := fs.metadata(path)?.permissions()
    perms.set_readonly(false)
    fs.set_permissions(path, ^perms)?
    if path.is_dir() {
        loop entry in fs.read_dir(path)? {
            entry :: entry?
            make_tree_writable(&entry.path())?
        }
    }
    Ok(())
}

// Rust: crates/jetpack/src/JetOS/kernel_bootstrap.rs:114
fn jetos_bootstrap_path() -> String {
    existing :: env.var("PATH").unwrap_or_default()
    defaults :: "/run/current-system/sw/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    if existing.is_empty() -> defaults.to_string() else -> "{defaults}:{existing}"
}

// Rust: crates/jetpack/src/JetOS/kernel_bootstrap.rs:124
fn default_cachyos_kernel_env(use_host_defaults: Bool) -> [(String, OSPath)] {
    overrides := [(String, OSPath)]{}
    if !use_host_defaults { return ^overrides }
    if env.var_os("JETOS_CACHYOS_KERNEL").is_none() {
        if kernel :: first_existing_path(&["/run/booted-system/kernel", "/run/current-system/kernel"]) { overrides.push(("JETOS_CACHYOS_KERNEL", ^kernel)) }
    }
    if env.var_os("JETOS_CACHYOS_INITRD").is_none() {
        if initrd :: first_existing_path(&["/run/booted-system/initrd", "/run/current-system/initrd"]) { overrides.push(("JETOS_CACHYOS_INITRD", ^initrd)) }
    }
    if env.var_os("JETOS_CACHYOS_MODULES").is_none() {
        if modules :: first_existing_path(&["/run/booted-system/kernel-modules", "/run/current-system/kernel-modules"]) { overrides.push(("JETOS_CACHYOS_MODULES", kernel_module_tree(&modules).unwrap_or(^modules))) }
    }
    ^overrides
}

// Rust: crates/jetpack/src/JetOS/kernel_bootstrap.rs:157
fn kernel_module_tree(modules: &OSPath) -> OSPath? {
    lib_modules :: modules.join("lib/modules")
    fs.read_dir(lib_modules).ok()?.filter_map(result -> result.ok()).map(entry -> entry.path()).find(path -> path.join("kernel").is_dir())
}

// Rust: crates/jetpack/src/JetOS/kernel_bootstrap.rs:166
fn first_existing_path(paths: &[String]) -> OSPath? {
    paths.iter().map(OSPath.from).find(path -> path.exists())
}

// Rust: crates/jetpack/src/JetOS/kernel_bootstrap.rs:170
pub fn validate_boot_payloads(theme: &Theme, boot: &JetOSBootProfile, realized: &[JetOSRealizedPackage]) -> Bool {
    if boot.kernel == "CachyOS" {
        entry :: cachyos_kernel_entry(realized) ?? return true
        kernel :: boot_artifact(entry, &["boot/vmlinuz-cachyos", "bzImage", "vmlinuz"])
        initrd :: boot_artifact(entry, &["boot/initrd-cachyos", "initrd", "initrd.img"])
        kernel_ok :: kernel.as_ref().map(is_linux_kernel_image).unwrap_or(false)
        initrd_ok :: initrd.as_ref().map(is_initrd_image).unwrap_or(false)
        if !kernel_ok || !initrd_ok {
            theme.error_coded("E1282", "jetos CachyOS boot artifacts are missing", "D-JOS-KERNELSRC1=A: the first-party `cachyos-kernel` package must provide a Linux kernel image and initrd with bootable file headers so the generation and installer can boot the same payload.", "add boot/vmlinuz-cachyos and boot/initrd-cachyos with real boot payloads, or select a different ratified kernel.")
            return false
        }
        if missing_kernel_source_files(entry).is_some() {
            theme.error_coded("E1284", "jetos CachyOS source recipe is missing", "D-JOS-KERNELBOOTSTRAP1=A: the first-party `cachyos-kernel` package must carry source-built recipe, builder, config, patch, and initrd-input provenance beside the boot artifacts.", "add source/recipe.jet, source/build.sh, source/config, source/patches.manifest, and source/initrd-inputs.manifest to the package output.")
            return false
        }
    }
    if boot.init == "/sbin/init" {
        entry :: realized.iter().find(entry -> entry.entry.name == JETOS_SYSTEMD_INIT_PACKAGE) ?? return true
        if boot_artifact(entry, &["bin/systemd", "lib/systemd/systemd", "sbin/init"]).is_none() {
            theme.error_coded("E1283", "jetos systemd init artifact is missing", "D-JPK-OSINIT1=A: the first-party `systemd` package must provide a bootable init binary for `/sbin/init`.", "add bin/systemd, lib/systemd/systemd, or sbin/init to the package output, or select a ratified init override.")
            return false
        }
    }
    true
}
