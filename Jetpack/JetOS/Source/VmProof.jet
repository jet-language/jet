// Rust: crates/jetpack/src/JetOS/vm_proof.rs:15
pub fn write_vm_install_plan(gen: &JetOSGeneration, system: &SystemPlan, disk: &String, media_proof: &OSPath, real_guest: Bool) -> OSPath io.Error! {
    // GATE #4494 native filesystem.
    proof_dir :: systems_dir().join("vm-proofs")
    fs.create_dir_all(&proof_dir)?
    proof :: proof_dir.join("{system.name}-{gen.name}-vm-proof.json")
    tools :: vm_tools_json()
    iso :: systems_dir().join("images").join("jetos-installer-{system.name}.iso")
    staging_boot :: systems_dir().join("images").join("jetos-installer-{system.name}.iso.d/boot")
    commands :: qemu_proof_commands_json(&staging_boot, disk, &iso, &system.name, &gen.name)
    guest :: guest_proof_path(&proof)
    proof_tier :: if real_guest { "real-guest" } else { "plumbing" }
    media_proof_sha256 :: file_sha256(media_proof).map_err(io.Error.other)?
    iso_fingerprint :: file_fingerprint(&iso).map_err(io.Error.other)?
    text :: "{{\"host\":{JSON.quote(&system.name)},\"generation\":{JSON.quote(&gen.name)},\"state\":\"harness-ready\",\"proof_tier\":{JSON.quote(proof_tier)},\"disk\":{JSON.quote(disk)},\"installer_media\":{JSON.quote("jetos-installer-{system.name}.iso")},\"media_proof\":{JSON.quote(media_proof.display().to_string())},\"media_proof_sha256\":{JSON.quote(&media_proof_sha256)},\"installer_iso_fingerprint\":{JSON.quote(&iso_fingerprint)},\"expected_guest_proof\":{JSON.quote(guest.display().to_string())},\"tools\":[{tools}],\"commands\":[{commands}],\"steps\":[\"build-generation\",\"create-hybrid-iso\",\"boot-installer-qemu\",\"install-to-disk\",\"reboot-installed-disk\",\"verify-guest-proof\",\"boot-graphical-desktop\"],\"guest_assertions\":[{guest_assertions_json()}]}}"
    fs.write(&proof, text)?
    Ok(proof)
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:56
pub fn prove_vm_guest(gen: &JetOSGeneration, system: &SystemPlan, disk: &String, media_proof: &OSPath, harness: &OSPath, real_guest: Bool) -> OSPath? String! {
    if final_path :: finalize_vm_guest_proof(gen, system, disk, media_proof, harness)? { return Ok(.Val(final_path)) }
    if !run_vm_install_harness(gen, system, disk, media_proof, harness, real_guest)? { return Ok(.None) }
    finalize_vm_guest_proof(gen, system, disk, media_proof, harness)
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:73
fn run_vm_install_harness(gen: &JetOSGeneration, system: &SystemPlan, disk: &String, media_proof: &OSPath, harness: &OSPath, real_guest: Bool) -> Bool String! {
    iso :: systems_dir().join("images").join("jetos-installer-{system.name}.iso")
    staging_boot :: systems_dir().join("images").join("jetos-installer-{system.name}.iso.d/boot")
    log_dir :: vm_run_log_dir(harness)
    if log_dir.exists() { fs.remove_dir_all(&log_dir).map_err(e -> "clearing `{log_dir.display()}` failed: {e}")? }
    fs.create_dir_all(&log_dir).map_err(e -> "creating `{log_dir.display()}` failed: {e}")?
    graphical_output := ""
    loop command in qemu_proof_commands(&staging_boot, disk, &iso, &system.name, &gen.name) {
        output :: run_vm_command(&command, &log_dir)?
        if command.phase == "boot-graphical-desktop" { graphical_output = output }
    }
    report :: extract_guest_proof_report(&graphical_output) ?? return Ok(false)
    write_runner_guest_proof(gen, system, disk, media_proof, harness, &report, real_guest)?
    Ok(true)
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:108
fn vm_run_log_dir(harness: &OSPath) -> OSPath {
    stem :: harness.file_stem().and_then(s -> s.to_str()).unwrap_or("vm-proof")
    harness.with_file_name("{stem}.run")
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:116
fn run_vm_command(command: &VmCommand, log_dir: &OSPath) -> String String! {
    // GATE #4494 native process, child polling, thread sleep, monotonic clock.
    program :: command.argv.first() ?? return Err("VM phase `{command.phase}` has no executable")
    stdout_path :: log_dir.join("{command.phase}.stdout")
    stderr_path :: log_dir.join("{command.phase}.stderr")
    stdout :: fs.File.create(&stdout_path).map_err(e -> "creating `{stdout_path.display()}` failed: {e}")?
    stderr :: fs.File.create(&stderr_path).map_err(e -> "creating `{stderr_path.display()}` failed: {e}")?
    child := Command.new(program).args(command.argv.iter().skip(1)).stdout(Stdio.from(stdout)).stderr(Stdio.from(stderr)).spawn().map_err(e -> "starting VM phase `{command.phase}` failed: {e}")?
    start :: Instant.now()
    timeout :: vm_proof_timeout()
    status :: loop {
        if status :: child.try_wait().map_err(e -> "waiting for VM phase `{command.phase}` failed: {e}")? { break status }
        if start.elapsed() > timeout {
            _ :: child.kill()
            _ :: child.wait()
            stdout :: fs.read_to_string(&stdout_path).unwrap_or_default()
            stderr :: fs.read_to_string(&stderr_path).unwrap_or_default()
            return Err("VM phase `{command.phase}` timed out after {timeout.as_millis()}ms; stdout `{stdout_path.display()}`, stderr `{stderr_path.display()}`{log_excerpt("stdout", &stdout)}{log_excerpt("stderr", &stderr)}")
        }
        thread.sleep(Duration.from_millis(50))
    }
    stdout :: fs.read_to_string(&stdout_path).unwrap_or_default()
    stderr :: fs.read_to_string(&stderr_path).unwrap_or_default()
    if !status.success() { return Err("VM phase `{command.phase}` exited with {status}; stdout `{stdout_path.display()}`, stderr `{stderr_path.display()}`{log_excerpt("stdout", &stdout)}{log_excerpt("stderr", &stderr)}") }
    Ok("{stdout}\n{stderr}")
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:174
pub fn run_interactive_vm_command(command: &VmCommand) -> I32 String! {
    program :: command.argv.first() ?? return Err("VM phase `{command.phase}` has no executable")
    status :: Command.new(program).args(command.argv.iter().skip(1)).status().map_err(e -> "starting VM phase `{command.phase}` failed: {e}")?
    Ok(status.code().unwrap_or(if status.success() { 0 } else { 1 }))
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:187
fn log_excerpt(label: &String, text: &String) -> String {
    line := text.lines().map(line -> line.trim()).find(line -> !line.is_empty()).unwrap_or("") // #4303
    if line.is_empty() { "" } else { excerpt :: line.chars().take(240).collect::<String>(); "; {label}: {excerpt}" }
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:201
fn vm_proof_timeout() -> Duration {
    env.var("JETOS_VM_PROOF_TIMEOUT_MS").ok().and_then(raw -> raw.parse::<U64>().ok()).map(Duration.from_millis).unwrap_or_else(() -> Duration.from_millis(JETOS_VM_PROOF_TIMEOUT_MS))
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:209
pub fn extract_guest_proof_report(output: &String) -> String? {
    output.lines().find_map(line -> line.split_once(JETOS_VM_GUEST_PROOF_MARKER).map((_, rest) -> { value := rest.trim() // #4303
        value.to_string() }))
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:216
fn write_runner_guest_proof(gen: &JetOSGeneration, system: &SystemPlan, disk: &String, media_proof: &OSPath, harness: &OSPath, report: &String, real_guest: Bool) -> Unit String! {
    require_guest_report(report, system, gen)?
    guest :: guest_proof_path(harness)
    proof_tier :: if real_guest { "real-guest" } else { "plumbing" }
    installer_iso :: systems_dir().join("images").join("jetos-installer-{system.name}.iso")
    text :: "{{\"state\":\"guest-passed\",\"proof_tier\":{JSON.quote(proof_tier)},\"host\":{JSON.quote(&system.name)},\"generation\":{JSON.quote(&gen.name)},\"disk\":{JSON.quote(disk)},\"media_proof\":{JSON.quote(media_proof.display().to_string())},\"media_proof_sha256\":{JSON.quote(file_sha256(media_proof)?)},\"installer_iso_fingerprint\":{JSON.quote(file_fingerprint(&installer_iso)?)},\"assertions\":[{guest_assertions_json()}],\"tools\":[{vm_tools_json()}],\"serial_report\":{JSON.quote(report)}}}\n"
    fs.write(&guest, text).map_err(e -> "writing `{guest.display()}` failed: {e}")
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:247
fn require_guest_report(report: &String, system: &SystemPlan, gen: &JetOSGeneration) -> Unit String! {
    if !report.contains("\"state\":\"guest-passed\"") { return Err("guest serial proof did not report state=guest-passed") }
    require_json_field(report, "host", &system.name)?
    require_json_field(report, "generation", &gen.name)?
    require_guest_assertions(report)
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:256
fn finalize_vm_guest_proof(gen: &JetOSGeneration, system: &SystemPlan, disk: &String, media_proof: &OSPath, harness: &OSPath) -> OSPath? String! {
    guest :: guest_proof_path(harness)
    if !guest.is_file() { return Ok(.None) }
    text :: fs.read_to_string(&guest).map_err(e -> "reading `{guest.display()}` failed: {e}")?
    if .Err(e) :: validate_cached_guest_proof(&text, system, gen, disk, media_proof) { _ :: fs.remove_file(&guest); return Err(e) }
    loop (name, _path, sha) in vm_tool_facts() {
        if !text.contains(&name) || !text.contains(&sha) { return Err("missing tool proof for `{name}`") }
    }
    guest_sha :: fs.read(&guest).map(bytes -> SHA256.sha256_hex(&bytes)).map_err(e -> "hashing `{guest.display()}` failed: {e}")?
    harness_text :: fs.read_to_string(harness).map_err(e -> "reading `{harness.display()}` failed: {e}")?
    final_text :: harness_text.replacen("\"state\":\"harness-ready\"", "\"state\":\"guest-passed\",\"guest_proof\":{JSON.quote(guest.display().to_string())},\"guest_proof_sha256\":{JSON.quote(&guest_sha)}", 1)
    fs.write(harness, final_text).map_err(e -> "writing `{harness.display()}` failed: {e}")?
    Ok(.Val(harness.to_path_buf()))
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:299
fn validate_cached_guest_proof(text: &String, system: &SystemPlan, gen: &JetOSGeneration, disk: &String, media_proof: &OSPath) -> Unit String! {
    require_json_field(text, "state", "guest-passed")?
    require_json_field(text, "host", &system.name)?
    require_json_field(text, "generation", &gen.name)?
    require_json_field(text, "disk", disk)?
    require_json_field(text, "media_proof", &media_proof.display().to_string())?
    require_json_field(text, "media_proof_sha256", &file_sha256(media_proof)?)?
    installer_iso :: systems_dir().join("images").join("jetos-installer-{system.name}.iso")
    require_json_field(text, "installer_iso_fingerprint", &file_fingerprint(&installer_iso)?)?
    require_guest_assertions(text)
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:323
pub fn require_vm_run_proof(gen: &JetOSGeneration, system: &SystemPlan, disk: &String, media_proof: &OSPath, harness: &OSPath) -> Unit String! {
    if !harness.is_file() { return Err("missing VM proof `{harness.display()}`") }
    harness_text :: fs.read_to_string(harness).map_err(e -> "reading `{harness.display()}` failed: {e}")?
    require_json_field(&harness_text, "state", "guest-passed")?
    require_json_field(&harness_text, "host", &system.name)?
    require_json_field(&harness_text, "generation", &gen.name)?
    require_json_field(&harness_text, "disk", disk)?
    require_json_field(&harness_text, "media_proof", &media_proof.display().to_string())?
    Ok(())
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:347
pub fn file_sha256(path: &OSPath) -> String String! {
    fs.read(path).map(bytes -> SHA256.sha256_hex(&bytes)).map_err(e -> "hashing `{path.display()}` failed: {e}")
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:353
fn file_fingerprint(path: &OSPath) -> String String! { Ok("sha256={file_sha256(path)?}") }

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:359
fn guest_proof_path(harness: &OSPath) -> OSPath {
    stem :: harness.file_stem().and_then(s -> s.to_str()).unwrap_or("vm-proof")
    harness.with_file_name("{stem}-guest-proof.json")
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:367
fn require_json_field(text: &String, key: &String, expected: &String) -> Unit String! {
    needle :: "\"{key}\""
    rest := text.split_once(&needle).map((_, r) -> r.trim_start()) ?? return Err("missing `{key}`") // #4303
    if after :: rest.strip_prefix(':') { rest = after.trim_start() } else { return Err("missing `:` after `{key}`") }
    rest :: rest.strip_prefix('"') ?? return Err("`{key}` is not a string")
    end :: rest.find('"') ?? return Err("`{key}` is not closed")
    found := rest[..end] // #4303
    if found == expected { Ok(()) } else { Err("`{key}` expected `{expected}`, found `{found}`") }
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:391
fn require_guest_assertions(text: &String) -> Unit String! {
    expected :: "\"assertions\":[{guest_assertions_json()}]"
    if text.contains(&expected) { Ok(()) } else { Err("guest assertions did not match the required install/reboot proof set") }
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:400
pub fn require_real_vm_tools() -> Unit String! {
    rejected := [] as [String]
    loop name in ["qemu-system-x86_64", "qemu-img", "nix"] {
        path :: find_on_path(name) ?? { rejected.push("{name}: missing"); continue }
        bytes :: fs.read(&path).unwrap_or_default()
        is_native_executable :: bytes.starts_with(b"\x7fELF")
        if !is_native_executable { rejected.push("{name}: {path.display()}") }
    }
    if rejected.is_empty() { Ok(()) } else { Err("D-JOS-REALGUEST1=C forbids script/fake VM toolchains for replacement acceptance; rejected {rejected.join(", ")}.") }
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:428
fn find_on_path(name: &String) -> OSPath? {
    env.var_os("PATH").and_then(paths -> env.split_paths(&paths).map(dir -> dir.join(name)).find(path -> path.is_file()))
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:436
const GUEST_ASSERTIONS: [String] = ["current-generation-matches", "packages-present", "services-active", "network-up", "rollback-generation-bootable", "terminal-login-ready", "desktop-session-ready", "graphical-console-ready", "desktop-launchers-run"]

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:448
pub struct VmCommand { pub phase: String, pub argv: [String] }

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:453
fn ovmf_code_path() -> OSPath? { env.var_os("JETOS_OVMF_CODE").map(OSPath.from).filter(path -> path.is_file()) }

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:459
fn qemu_proof_commands(boot_dir: &OSPath, disk: &String, iso: &OSPath, host: &String, generation: &String) -> [VmCommand] {
    iso_path :: iso.display().to_string()
    kernel :: boot_dir.join("kernel").display().to_string()
    initrd :: boot_dir.join("initrd").display().to_string()
    boot_installer := ["qemu-system-x86_64", "-m", "2048", "-nographic", "-monitor", "none"]
    if ovmf :: ovmf_code_path() { boot_installer.extend(["-drive", "if=pflash,format=raw,readonly=on,file={ovmf.display()}"]) }
    boot_installer.extend(["-cdrom", iso_path, "-drive", "file={disk},format=qcow2,if=ide", "-netdev", "user,id=net0,hostname={host}", "-device", "virtio-net-pci,netdev=net0", "-boot", "d"])
    graphical_cmdline :: "console=ttyS0 rdinit=/jetos/init init=/jetos/init jetos.mode=desktop-verify jetos.host={host} jetos.generation={generation} root=LABEL=jetos-root rw"
    boot_installed_disk := ["qemu-system-x86_64", "-m", "2048", "-nographic", "-monitor", "none"]
    if ovmf :: ovmf_code_path() { boot_installed_disk.extend(["-drive", "if=pflash,format=raw,readonly=on,file={ovmf.display()}"]) }
    boot_installed_disk.extend(["-drive", "file={disk},format=qcow2,if=ide", "-netdev", "user,id=net0,hostname={host}", "-device", "virtio-net-pci,netdev=net0", "-boot", "c"])
    [VmCommand(phase: "create-disk", argv: ["qemu-img", "create", "-f", "qcow2", disk.to_string(), "16G"]), VmCommand(phase: "boot-installer", argv: boot_installer), VmCommand(phase: "boot-installed-disk", argv: boot_installed_disk), VmCommand(phase: "boot-graphical-desktop", argv: ["qemu-system-x86_64", "-m", "2048", "-display", qemu_vnc_display().to_string(), "-serial", "stdio", "-monitor", "none", "-vga", "std", "-device", "qemu-xhci,id=xhci", "-device", "usb-kbd,bus=xhci.0", "-device", "usb-tablet,bus=xhci.0", "-kernel", kernel, "-initrd", initrd, "-append", graphical_cmdline, "-drive", "file={disk},format=qcow2,if=ide", "-netdev", "user,id=net0,hostname={host}", "-device", "virtio-net-pci,netdev=net0", "-boot", "c"])]
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:581
pub fn qemu_interactive_run_command(boot_dir: &OSPath, disk: &String, host: &String, generation: &String) -> VmCommand {
    kernel :: boot_dir.join("kernel").display().to_string()
    initrd :: boot_dir.join("initrd").display().to_string()
    console :: "tty0"
    cmdline :: "console={console} rdinit=/jetos/init init=/jetos/init jetos.mode=run jetos.host={host} jetos.generation={generation} root=LABEL=jetos-root rw systemd.unit=graphical.target"
    argv := ["qemu-system-x86_64", "-m", "2048", "-cpu", "max"]
    if qemu_has_local_display() { argv.extend(["-display", "gtk,gl=off", "-serial", "none"]) } else { argv.extend(["-display", qemu_vnc_display().to_string(), "-serial", "none"]) }
    argv.extend(["-monitor", "none", "-vga", "std", "-device", "qemu-xhci,id=xhci", "-device", "usb-kbd,bus=xhci.0", "-device", "usb-tablet,bus=xhci.0", "-kernel", kernel, "-initrd", initrd, "-append", cmdline, "-drive", "file={disk},format=qcow2,if=ide", "-netdev", "user,id=net0,hostname={host}", "-device", "virtio-net-pci,netdev=net0", "-boot", "c"])
    VmCommand(phase: "run-installed-disk", argv: argv)
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:647
fn qemu_vnc_display() -> String { "vnc=127.0.0.1:0" }

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:651
pub fn qemu_vnc_endpoint() -> String { "127.0.0.1:5900" }

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:655
pub fn qemu_has_local_display() -> Bool {
    if env.var_os("JETOS_QEMU_VNC").is_some() { return false }
    env.var_os("DISPLAY").is_some() || env.var_os("WAYLAND_DISPLAY").is_some()
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:662
fn qemu_proof_commands_json(boot_dir: &OSPath, disk: &String, iso: &OSPath, host: &String, generation: &String) -> String {
    qemu_proof_commands(boot_dir, disk, iso, host, generation).into_iter().map(command -> {
        argv_json :: command.argv.iter().map(arg -> JSON.quote(arg)).collect::<[String]>().join(",")
        "{{\"phase\":{JSON.quote(command.phase)},\"argv\":[{argv_json}]}}"
    }).collect::<[String]>().join(",")
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:688
pub fn run_vmtest(theme: &Theme, plan: &EnvPlan, vmtest: &VmTestPlan, disk: &String, flags: &JetOSFlags, source_config: &OSPath) -> OSPath String! {
    proof_dir :: systems_dir().join("vm-tests")
    fs.create_dir_all(&proof_dir).map_err(e -> "creating `{proof_dir.display()}` failed: {e}")?
    host_facts := [] as [VmTestHostFact]
    loop host in &vmtest.hosts {
        system :: plan.systems.iter().find(s -> s.name == host.system).cloned() ?? return Err("host `{host.name}` names unknown system `{host.system}`")
        if !validate_system_options(theme, &system) { return Err("system `{system.name}` failed option validation") }
        host_disk :: vmtest_host_disk(disk, &host.name, vmtest.hosts.len())
        gen :: build_generation(theme, plan, &system, flags, source_config) ?? return Err("building system `{system.name}` failed")
        media :: write_installer_media(&gen, &system, "guided-ext4").map_err(e -> "writing installer media for `{system.name}` failed: {e}")?
        harness :: write_vm_install_plan(&gen, &system, &host_disk, &media, false).map_err(e -> "writing VM proof plan for `{system.name}` failed: {e}")?
        final_path :: prove_vm_guest(&gen, &system, &host_disk, &media, &harness, false).map_err(e -> "guest proof for `{system.name}` failed: {e}")?.ok_or_else(() -> "guest proof for `{system.name}` was not recorded")?
        host_facts.push(VmTestHostFact(name: host.name.clone(), system: system.name, generation: gen.name, disk: host_disk, proof: final_path.display().to_string()))
    }
    proof :: proof_dir.join("{vmtest.name}-vmtest-proof.json")
    fs.write(&proof, vmtest_proof_json(vmtest, &host_facts)).map_err(e -> "writing `{proof.display()}` failed: {e}")?
    Ok(proof)
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:735
struct VmTestHostFact { name: String, system: String, generation: String, disk: String, proof: String }

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:743
fn vmtest_host_disk(disk: &String, host: &String, host_count: USize) -> String {
    if host_count <= 1 { return disk.to_string() }
    path :: OSPath.new(disk)
    stem :: path.file_stem().and_then(s -> s.to_str()).unwrap_or(disk)
    ext :: path.extension().and_then(s -> s.to_str()).unwrap_or("qcow2")
    file :: "{stem}-{host}.{ext}"
    path.parent().filter(p -> !p.as_os_str().is_empty()).map(p -> p.join(&file).display().to_string()).unwrap_or(file)
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:757
fn vmtest_proof_json(vmtest: &VmTestPlan, hosts: &[VmTestHostFact]) -> String {
    host_json :: hosts.iter().map(host -> JSON.object_of(&[("name", &host.name), ("system", &host.system), ("generation", &host.generation), ("disk", &host.disk), ("proof", &host.proof)])).collect::<[String]>().join(",")
    assertions :: vmtest.assertions.iter().map(a -> JSON.quote(a)).collect::<[String]>().join(",")
    "{{\"kind\":\"jetos.vmtest.proof\",\"schema_version\":1,\"state\":\"passed\",\"name\":{JSON.quote(&vmtest.name)},\"hosts\":[{host_json}],\"assertions\":[{assertions}],\"run\":{JSON.quote(&vmtest.run)},\"proofs\":[\"build-generation\",\"install-reboot-proof\",\"typed-assertion-record\"]}}\n"
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:786
fn guest_assertions_json() -> String { GUEST_ASSERTIONS.iter().map(assertion -> JSON.quote(assertion)).collect::<[String]>().join(",") }

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:794
pub fn vm_tools_json() -> String {
    vm_tool_facts().into_iter().map((name, path, sha) -> JSON.object_of(&[("name", &name), ("path", &path), ("sha256", &sha)])).collect::<[String]>().join(",")
}

// Rust: crates/jetpack/src/JetOS/vm_proof.rs:804
fn vm_tool_facts() -> [(String, String, String)] {
    JETOS_VM_TOOLS.iter().map(tool -> {
        path :: find_path_tool(tool) ?? return (tool.to_string(), "<missing>", "<missing>")
        path_text :: path.display().to_string()
        sha :: fs.read(&path).map(bytes -> SHA256.sha256_hex(&bytes)).unwrap_or_else(_ -> "<unreadable>")
        (tool.to_string(), path_text, sha)
    }).collect()
}
