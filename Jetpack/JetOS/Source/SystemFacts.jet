// Rust crates/jetpack/src/JetOS/system_facts.rs:252-413 (write_hardware_facts)
// and studio_projection.rs:832-837 (make_executable). Byte-exact Rust output.
jetos_write_hardware_facts: fn(dir: String, system: SystemPlan) IOError! -[FS]> {
    hw_dir: files.join(dir, "hardware")
    bin_dir: files.join(dir, "sw/bin")
    boot_spec_dir: files.join(dir, "boot/specialisations")
    files.create_dir_all(hw_dir)
    files.create_dir_all(bin_dir)
    files.create_dir_all(boot_spec_dir)
    firmware: if jetos_option_value(system, [String]{"kernel.firmware"}) == {
        .Val(value) -> jetos_parse_list_items(value)
        .None -> [String]{}
    }
    drivers: if jetos_option_value(system, [String]{"kernel.drivers"}) == {
        .Val(value) -> jetos_parse_list_items(value)
        .None -> [String]{}
    }
    firmware_json: jetos_strings_json(firmware)
    drivers_json: jetos_strings_json(drivers)
    hardware_options: jetos_prefixed_options(system, "hardware.")
    declared_profiles: if jetos_option_value(system, [String]{"hardware.{system.name}.profile", "hardware.profile"}) == {
        .Val(value) -> jetos_parse_list_items(value)
        .None -> [String]{}
    }
    profiles: if declared_profiles.len() == 0 -> [String]{"generic-pc"} else -> declared_profiles
    profiles_json: jetos_strings_json(profiles)
    specialisations: jetos_prefixed_options(system, "hardware.{system.name}.specialisation.")
    specialisation_items := [String]{}
    // Rust JSON::object_of emits its ordered fields with these newlines.
    loop item in specialisations -> specialisation_items.push("{{\n  \"name\": {foundation_json_quote(item.key)},\n  \"enabled\": {foundation_json_quote(item.value)},\n  \"boot_entry\": {foundation_json_quote("boot/specialisations/{item.key}.conf")}\n}}")
    specialisations_json: specialisation_items.join(",")
    host_json: foundation_json_quote(system.name)
    files.write(files.join(hw_dir, "facts.json"), "{{\"kind\":\"jetos.hardware\",\"host\":{host_json},\"firmware\":[{firmware_json}],\"drivers\":[{drivers_json}],\"profiles\":[{profiles_json}],\"specialisations\":[{specialisations_json}],\"scan_source\":\"hardware/{system.name}.jet\",\"doctor\":\"sw/bin/jetos-hardware-doctor\",\"audit\":\"declared hardware facts enter generation proof before activation\"}}")
    files.write(files.join(hw_dir, "firmware.manifest"), jetos_declared_manifest(firmware))
    files.write(files.join(hw_dir, "drivers.manifest"), jetos_declared_manifest(drivers))
    files.write(files.join(hw_dir, "profiles.manifest"), jetos_declared_manifest(profiles))
    loop profile in profiles {
        files.write(files.join(hw_dir, "profile-{jetos_safe_filename(profile)}.json"), "{{\"kind\":\"jetos.hardware-profile\",\"name\":{foundation_json_quote(profile)},\"source\":\"first-party hardware profile\",\"applies_to\":{host_json},\"drivers\":[{drivers_json}],\"firmware\":[{firmware_json}],\"proof\":\"profile-applied\"}}")
    }
    source := [String]{"// generated by jetos-hardware-scan; canonical source may be copied into config.jet\nhardware_{jetos_safe_identifier(system.name)}: module {{\n", "    hardware.{system.name}.scan.generated: true\n"}
    loop driver in drivers -> source.push("    hardware.{system.name}.driver.{jetos_safe_identifier(driver)}: true\n")
    loop item in firmware -> source.push("    hardware.{system.name}.firmware.{jetos_safe_identifier(item)}: true\n")
    loop profile in profiles -> source.push("    hardware.{system.name}.profile: \"{profile}\"\n")
    source.push("}}\n")
    files.write(files.join(hw_dir, "{system.name}.jet"), source.join(""))
    files.write(files.join(hw_dir, "declared-options.json"), "{{\"kind\":\"jetos.hardware-options\",\"options\":[{jetos_option_rows_json(hardware_options)}]}}")
    files.write(files.join(hw_dir, "specialisations.json"), "{{\"kind\":\"jetos.hardware-specialisations\",\"host\":{host_json},\"items\":[{specialisations_json}],\"proof\":\"boot-selectable-variants\"}}")
    loop item in specialisations {
        files.write(files.join(boot_spec_dir, "{item.key}.conf"), "title {jetos_release_label(false)} — {system.name} ({item.key})\nhost {system.name}\nenabled {item.value}\ngeneration /run/current-system\nproof hardware-specialisation\n")
    }
    host: jetos_shell_single_quote(system.name)
    scanner: "#!/usr/bin/env sh\nset -eu\nhost=${{1:-{host}}}\nscan_root=${{JETOS_HW_ROOT:-/}}\nout=${{JETOS_HARDWARE_OUT:-$PWD/hardware-$host.jet}}\nmkdir -p \"$(dirname \"$out\")\"\nmods=''\nif [ -r \"$scan_root/proc/modules\" ]; then\n  mods=$(awk '{{print $1}}' \"$scan_root/proc/modules\" | sort -u | paste -sd, -)\nfi\nblocks=''\nif [ -d \"$scan_root/sys/class/block\" ]; then\n  blocks=$(find \"$scan_root/sys/class/block\" -mindepth 1 -maxdepth 1 -printf '%f\\n' | sort | paste -sd, -)\nfi\ngpus=''\nif [ -d \"$scan_root/sys/class/drm\" ]; then\n  gpus=$(find \"$scan_root/sys/class/drm\" -mindepth 1 -maxdepth 1 -name 'card*' -printf '%f\\n' | sort | paste -sd, -)\nfi\n{{\n  printf '%s\\n' \"// generated by jetos-hardware-scan\"\n  printf '%s\\n' \"hardware_$host: module {{\"\n  printf '    hardware.%s.scan.modules: \"%s\"\\n' \"$host\" \"$mods\"\n  printf '    hardware.%s.scan.blockDevices: \"%s\"\\n' \"$host\" \"$blocks\"\n  printf '    hardware.%s.scan.gpus: \"%s\"\\n' \"$host\" \"$gpus\"\n  printf '%s\\n' \"}}\"\n}} > \"$out\"\nprintf '{{\"kind\":\"jetos.hardware-scan\",\"host\":\"%s\",\"out\":\"%s\",\"modules\":\"%s\",\"block_devices\":\"%s\",\"gpus\":\"%s\"}}\\n' \"$host\" \"$out\" \"$mods\" \"$blocks\" \"$gpus\"\n"
    scanner_path: files.join(bin_dir, "jetos-hardware-scan")
    files.write(scanner_path, scanner)
    jetos_make_executable(scanner_path)
    doctor: "#!/usr/bin/env sh\nset -eu\nroot=${{JETOS_SYSTEM_ROOT:-/run/current-system}}\nscan_root=${{JETOS_HW_ROOT:-/}}\nreport=${{JETOS_HARDWARE_REPORT:-$root/hardware/drift-report.json}}\nmkdir -p \"$(dirname \"$report\")\"\nmissing=''\nif [ -f \"$root/hardware/drivers.manifest\" ]; then\n  while IFS='\t' read -r driver _state; do\n    [ -n \"$driver\" ] || continue\n    if [ -r \"$scan_root/proc/modules\" ]; then\n      if ! awk '{{print $1}}' \"$scan_root/proc/modules\" | grep -qx \"$driver\"; then\n        missing=\"$missing $driver\"\n      fi\n    fi\n  done < \"$root/hardware/drivers.manifest\"\nfi\nstate=match\nif [ -n \"$missing\" ]; then state=drift; fi\nprintf '{{\"kind\":\"jetos.hardware-doctor\",\"state\":\"%s\",\"missing_drivers\":\"%s\",\"proof\":\"hardware-drift-checked\"}}\\n' \"$state\" \"${{missing# }}\" > \"$report\"\ncat \"$report\"\n"
    doctor_path: files.join(bin_dir, "jetos-hardware-doctor")
    files.write(doctor_path, doctor)
    jetos_make_executable(doctor_path)
}

// Rust's `{x}\tdeclared\n` manifest rows, in declaration order.
jetos_declared_manifest: fn(items: [String]) -> String Never! {
    rows := [String]{}
    loop item in items -> rows.push("{item}\tdeclared\n")
    rows.join("")
}

// Rust make_executable: the followed file's mode with every execute bit set.
jetos_make_executable: fn(path: String) IOError! -[FS]> {
    stat: files.stat(path, links: .Follow)
    files.set_mode(path, (stat.mode).bit_and(0o7777).bit_or(0o111))
}
