// Rust crates/jetpack/src/JetOS/system_facts.rs:252-413 (write_hardware_facts)
// and studio_projection.rs:832-837 (make_executable). Fact files render
// through Core JSON in the Rust field order.
jetos_write_hardware_facts: fn(dir: String, system: SystemPlan) IOError! -[FS]> {
    hw_dir: files.join(dir, "hardware")
    bin_dir: files.join(dir, "sw/bin")
    boot_spec_dir: files.join(dir, "boot/specialisations")
    files.create_dir_all(hw_dir)
    files.create_dir_all(bin_dir)
    files.create_dir_all(boot_spec_dir)
    firmware: if jetos_option_value(system, [String]{"kernel.firmware"}) == {
        .Val(value) -> jetos_parse_list_items(value)
        .None -> [String]{}
    }
    drivers: if jetos_option_value(system, [String]{"kernel.drivers"}) == {
        .Val(value) -> jetos_parse_list_items(value)
        .None -> [String]{}
    }
    hardware_options: jetos_prefixed_options(system, "hardware.")
    declared_profiles: if jetos_option_value(system, [String]{"hardware.{system.name}.profile", "hardware.profile"}) == {
        .Val(value) -> jetos_parse_list_items(value)
        .None -> [String]{}
    }
    profiles: if declared_profiles.len() == 0 -> [String]{"generic-pc"} else -> declared_profiles
    specialisations: jetos_prefixed_options(system, "hardware.{system.name}.specialisation.")
    files.write(files.join(hw_dir, "facts.json"), pkg_json_render(Dyn.Object([
        "kind": Dyn.Text("jetos.hardware"),
        "host": Dyn.Text(system.name.copy()),
        "firmware": pkg_json_texts(firmware),
        "drivers": pkg_json_texts(drivers),
        "profiles": pkg_json_texts(profiles),
        "specialisations": jetos_specialisation_items(specialisations),
        "scan_source": Dyn.Text("hardware/{system.name}.jet"),
        "doctor": Dyn.Text("sw/bin/jetos-hardware-doctor"),
        "audit": Dyn.Text("declared hardware facts enter generation proof before activation"),
    ])))
    files.write(files.join(hw_dir, "firmware.manifest"), jetos_declared_manifest(firmware))
    files.write(files.join(hw_dir, "drivers.manifest"), jetos_declared_manifest(drivers))
    files.write(files.join(hw_dir, "profiles.manifest"), jetos_declared_manifest(profiles))
    loop profile in profiles {
        files.write(files.join(hw_dir, "profile-{jetos_safe_filename(profile)}.json"), pkg_json_render(Dyn.Object([
            "kind": Dyn.Text("jetos.hardware-profile"),
            "name": Dyn.Text(profile.copy()),
            "source": Dyn.Text("first-party hardware profile"),
            "applies_to": Dyn.Text(system.name.copy()),
            "drivers": pkg_json_texts(drivers),
            "firmware": pkg_json_texts(firmware),
            "proof": Dyn.Text("profile-applied"),
        ])))
    }
    source := [String]{"// generated by jetos-hardware-scan; canonical source may be copied into config.jet\nhardware_{jetos_safe_identifier(system.name)}: module {{\n", "    hardware.{system.name}.scan.generated: true\n"}
    loop driver in drivers -> source.push("    hardware.{system.name}.driver.{jetos_safe_identifier(driver)}: true\n")
    loop item in firmware -> source.push("    hardware.{system.name}.firmware.{jetos_safe_identifier(item)}: true\n")
    loop profile in profiles -> source.push("    hardware.{system.name}.profile: \"{profile}\"\n")
    source.push("}}\n")
    files.write(files.join(hw_dir, "{system.name}.jet"), source.join(""))
    files.write(files.join(hw_dir, "declared-options.json"), pkg_json_render(Dyn.Object(["kind": Dyn.Text("jetos.hardware-options"), "options": jetos_option_rows_dyn(hardware_options)])))
    files.write(files.join(hw_dir, "specialisations.json"), pkg_json_render(Dyn.Object([
        "kind": Dyn.Text("jetos.hardware-specialisations"),
        "host": Dyn.Text(system.name.copy()),
        "items": jetos_specialisation_items(specialisations),
        "proof": Dyn.Text("boot-selectable-variants"),
    ])))
    loop item in specialisations {
        files.write(files.join(boot_spec_dir, "{item.key}.conf"), "title {jetos_release_label(false)} — {system.name} ({item.key})\nhost {system.name}\nenabled {item.value}\ngeneration /run/current-system\nproof hardware-specialisation\n")
    }
    host: jetos_shell_single_quote(system.name)
    // The scan report's JSON object is the printf format; the shell fills each `%s`.
    report_format: pkg_json_render(Dyn.Object(["kind": Dyn.Text("jetos.hardware-scan"), "host": Dyn.Text("%s"), "out": Dyn.Text("%s"), "modules": Dyn.Text("%s"), "block_devices": Dyn.Text("%s"), "gpus": Dyn.Text("%s")]))
    scan_report: jetos_shell_single_quote("{report_format}\\n")
    scanner: "#!/usr/bin/env sh\nset -eu\nhost=${{1:-{host}}}\nscan_root=${{JETOS_HW_ROOT:-/}}\nout=${{JETOS_HARDWARE_OUT:-$PWD/hardware-$host.jet}}\nmkdir -p \"$(dirname \"$out\")\"\nmods=''\nif [ -r \"$scan_root/proc/modules\" ]; then\n  mods=$(awk '{{print $1}}' \"$scan_root/proc/modules\" | sort -u | paste -sd, -)\nfi\nblocks=''\nif [ -d \"$scan_root/sys/class/block\" ]; then\n  blocks=$(find \"$scan_root/sys/class/block\" -mindepth 1 -maxdepth 1 -printf '%f\\n' | sort | paste -sd, -)\nfi\ngpus=''\nif [ -d \"$scan_root/sys/class/drm\" ]; then\n  gpus=$(find \"$scan_root/sys/class/drm\" -mindepth 1 -maxdepth 1 -name 'card*' -printf '%f\\n' | sort | paste -sd, -)\nfi\n{{\n  printf '%s\\n' \"// generated by jetos-hardware-scan\"\n  printf '%s\\n' \"hardware_$host: module {{\"\n  printf '    hardware.%s.scan.modules: \"%s\"\\n' \"$host\" \"$mods\"\n  printf '    hardware.%s.scan.blockDevices: \"%s\"\\n' \"$host\" \"$blocks\"\n  printf '    hardware.%s.scan.gpus: \"%s\"\\n' \"$host\" \"$gpus\"\n  printf '%s\\n' \"}}\"\n}} > \"$out\"\nprintf {scan_report} \"$host\" \"$out\" \"$mods\" \"$blocks\" \"$gpus\"\n"
    scanner_path: files.join(bin_dir, "jetos-hardware-scan")
    files.write(scanner_path, scanner)
    jetos_make_executable(scanner_path)
    doctor_format: pkg_json_render(Dyn.Object(["kind": Dyn.Text("jetos.hardware-doctor"), "state": Dyn.Text("%s"), "missing_drivers": Dyn.Text("%s"), "proof": Dyn.Text("hardware-drift-checked")]))
    doctor_report: jetos_shell_single_quote("{doctor_format}\\n")
    doctor: "#!/usr/bin/env sh\nset -eu\nroot=${{JETOS_SYSTEM_ROOT:-/run/current-system}}\nscan_root=${{JETOS_HW_ROOT:-/}}\nreport=${{JETOS_HARDWARE_REPORT:-$root/hardware/drift-report.json}}\nmkdir -p \"$(dirname \"$report\")\"\nmissing=''\nif [ -f \"$root/hardware/drivers.manifest\" ]; then\n  while IFS='\t' read -r driver _state; do\n    [ -n \"$driver\" ] || continue\n    if [ -r \"$scan_root/proc/modules\" ]; then\n      if ! awk '{{print $1}}' \"$scan_root/proc/modules\" | grep -qx \"$driver\"; then\n        missing=\"$missing $driver\"\n      fi\n    fi\n  done < \"$root/hardware/drivers.manifest\"\nfi\nstate=match\nif [ -n \"$missing\" ]; then state=drift; fi\nprintf {doctor_report} \"$state\" \"${{missing# }}\" > \"$report\"\ncat \"$report\"\n"
    doctor_path: files.join(bin_dir, "jetos-hardware-doctor")
    files.write(doctor_path, doctor)
    jetos_make_executable(doctor_path)
}

// `{"name": .., "enabled": .., "boot_entry": ..}` per declared specialisation.
jetos_specialisation_items: fn(specialisations: [(key: String, value: String)]) -> Dyn Never! {
    items := [Dyn]{}
    loop item in specialisations {
        items.push(Dyn.Object([
            "name": Dyn.Text(item.key.copy()),
            "enabled": Dyn.Text(item.value.copy()),
            "boot_entry": Dyn.Text("boot/specialisations/{item.key}.conf"),
        ]))
    }
    Dyn.Array(items)
}

// Rust's `{x}\tdeclared\n` manifest rows, in declaration order.
jetos_declared_manifest: fn(items: [String]) -> String Never! {
    rows := [String]{}
    loop item in items -> rows.push("{item}\tdeclared\n")
    rows.join("")
}

// Rust make_executable: the followed file's mode with every execute bit set.
jetos_make_executable: fn(path: String) IOError! -[FS]> {
    stat: files.stat(path, links: .Follow)
    files.set_mode(path, (stat.mode).bit_and(0o7777).bit_or(0o111))
}
