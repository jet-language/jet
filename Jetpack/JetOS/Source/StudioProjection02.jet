// Rust: crates/jetpack/src/JetOS/studio_projection.rs:831
// Rust: crates/jetpack/src/JetOS/studio_projection.rs:839
fn jetos_make_executable(path: studio_path.OsPath) -[FS]> Unit IOError! {
    // GATE #4483: selected native family, never the path's lexical platform.
    // GATE #4494: followed metadata and native permission setter, preserving
    // all bits and surfacing metadata errors before setter errors on Unix.
    if target.selected_family() == "unix" {
        jetos_make_executable_unix_body(path)
    } else {
        // Original non-Unix cfg is an IO-free success, not a native fallback.
        jetos_make_executable_nonunix_body(path)
    }
}
