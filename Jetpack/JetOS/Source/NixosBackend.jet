//RS const FLAKE_TEMPLATE: &str = r#"{
//RS   description = "NixOS comparison for @@HOST@@ (generated by `jet os migrate compare-nixos`; do not hand-edit)";
//RS 
//RS   inputs.nixpkgs.url = "github:@@OWNER@@/@@REPO@@/@@REV@@";
//RS @@EXTRA_INPUTS@@
//RS   outputs = { self, nixpkgs, ... }@inputs:
//RS     let
//RS       system = "x86_64-linux";
//RS       pkgs = nixpkgs.legacyPackages.${system};
//RS       lib = nixpkgs.lib;
//RS     in {
//RS       nixosConfigurations.@@HOST@@ = lib.nixosSystem {
//RS         inherit system;
//RS         modules = [ ./configuration.nix@@EXTRA_MODULES@@ ];
//RS       };
//RS 
//RS       packages.${system} = {
//RS         disk = import (nixpkgs + "/nixos/lib/make-disk-image.nix") {
//RS           inherit lib pkgs;
//RS           config = self.nixosConfigurations.@@HOST@@.config;
//RS           format = "qcow2";
//RS           diskSize = "auto";
//RS           additionalSpace = "12G";
//RS           partitionTableType = "efi";
//RS         };
//RS         firmware = pkgs.OVMF.fd;
//RS       };
//RS     };
//RS }
//RS "#;
//RS 
//RS fn render_flake_nix(host: &str, mapping: &NixosMapping) -> String {
//RS     let (extra_inputs, extra_modules) = match &mapping.kernel_input {
//RS         Some((owner, repo, rev)) => (
//RS             format!(
//RS                 "  inputs.cachyos.url = \"github:{owner}/{repo}/{rev}\";\n  inputs.cachyos.inputs.nixpkgs.follows = \"nixpkgs\";\n"
//RS             ),
//RS             " { nixpkgs.overlays = [ inputs.cachyos.overlays.default ]; }".to_string(),
//RS         ),
//RS         None => (String::new(), String::new()),
//RS     };
//RS     FLAKE_TEMPLATE
//RS         .replace("@@HOST@@", host)
//RS         .replace("@@OWNER@@", &mapping.nixpkgs_owner)
//RS         .replace("@@REPO@@", &mapping.nixpkgs_repo)
//RS         .replace("@@REV@@", &mapping.nixpkgs_rev)
//RS         .replace("@@EXTRA_INPUTS@@", &extra_inputs)
//RS         .replace("@@EXTRA_MODULES@@", &extra_modules)
//RS }
//RS 
//RS const CONFIGURATION_HEAD: &str = r#"{ config, pkgs, lib, ... }:
//RS let
//RS   # jetos package resolver: names come from imported package sets whose
//RS   # attribute may live under a package group (KDE apps live in
//RS   # `kdePackages.*`). A miss is a hard eval error, never a silent drop.
//RS   jetosPkg = name:
//RS     let
//RS       # `gnome-shell-extension-user-themes` (pname) lives at
//RS       # `gnomeExtensions.user-themes`; `dejavu-fonts` at `dejavu_fonts`.
//RS       extension = lib.removePrefix "gnome-shell-extension-" name;
//RS       underscored = builtins.replaceStrings ["-"] ["_"] name;
//RS       # Removed-alias attrs exist but throw on access — tryEval skips them
//RS       # so lookup falls through to the real location (e.g. kdePackages).
//RS       tryAttr = attrs: n:
//RS         if attrs ? ${n} then
//RS           let r = builtins.tryEval attrs.${n}; in
//RS           if r.success then [ r.value ] else [ ]
//RS         else [ ];
//RS       found = (tryAttr pkgs name) ++ (tryAttr pkgs underscored)
//RS         ++ (tryAttr (pkgs.kdePackages or { }) name)
//RS         ++ (tryAttr (pkgs.gnomeExtensions or { }) extension);
//RS     in
//RS     if builtins.length found > 0 then builtins.head found
//RS     else throw "jetos: package `${name}` is not in nixpkgs, kdePackages, or gnomeExtensions at the pinned revision";
//RS in
//RS {
//RS   system.stateVersion = "@@STATEVERSION@@";
//RS   # Imported package sets routinely include unfree software (steam, discord,
//RS   # editors); nixpkgs' license gate is a nixpkgs-ism, not a jetos policy.
//RS   nixpkgs.config.allowUnfree = true;
//RS 
//RS   boot.loader.timeout = 1;
//RS   boot.growPartition = true;
//RS   boot.initrd.availableKernelModules = [
//RS     "virtio_pci" "virtio_blk" "virtio_scsi" "virtio_net"
//RS     "ahci" "xhci_pci" "nvme" "sd_mod" "sr_mod"
//RS   ];
//RS 
//RS   fileSystems."/" = {
//RS     device = "/dev/disk/by-label/nixos";
//RS     fsType = "ext4";
//RS     autoResize = true;
//RS   };
//RS   fileSystems."/boot" = {
//RS     device = "/dev/disk/by-label/ESP";
//RS     fsType = "vfat";
//RS   };
//RS 
//RS   environment.variables.NIXOS_COMPARISON = "1";
//RS   programs.bash.promptInit = lib.mkAfter ''
//RS     PS1='NixOS comparison $ '
//RS     export PS1
//RS   '';
//RS   environment.etc.issue.text = "NixOS comparison guest\n";
//RS   environment.etc.motd.text = "NixOS comparison guest for A/B migration checks\n";
//RS "#;
//RS 
//RS const CONFIGURATION_PROOF_SERVICE: &str = r#"
//RS   # NixOS comparison proof: emit one fact only after identity and desktop checks.
//RS   systemd.services.nixos-comparison-proof = {
//RS     description = "NixOS comparison guest proof emitter";
//RS     wantedBy = [ "multi-user.target" ];
//RS     after = [ "multi-user.target" ];
//RS     serviceConfig = {
//RS       Type = "oneshot";
//RS       RemainAfterExit = true;
//RS     };
//RS     path = [ pkgs.bash pkgs.util-linux pkgs.systemd pkgs.procps pkgs.jq pkgs.gawk pkgs.gnused pkgs.coreutils ];
//RS     script = ''
//RS       deadline=$((SECONDS + 300))
//RS       while [ "$SECONDS" -lt "$deadline" ]; do
//RS         dm=$(systemctl is-active display-manager.service || true)
//RS         # NixOS wraps gnome-shell (comm = ".gnome-shell-wr…"), so match the
//RS         # full command line rather than the truncated process name.
//RS         shell_pid=$(pgrep -u @@USER@@ -f @@DESKTOP_SHELL_PROCESS@@ | head -n1 || true)
//RS         session=$(loginctl list-sessions --no-legend | awk '$3=="@@USER@@" {print $1; exit}')
//RS         stype=""
//RS         if [ -n "$session" ]; then
//RS           stype=$(loginctl show-session "$session" -p Type --value || true)
//RS         fi
//RS         echo "NIXOS_COMPARISON_DEBUG dm=$dm shell=$shell_pid session=$session stype=$stype" > /dev/ttyS0 || true
//RS         if [ "$dm" = "active" ] && [ -n "$shell_pid" ] && [ "$stype" = "wayland" ]; then
//RS           os_name=$(. /etc/os-release; printf '%s' "$NAME")
//RS           prompt=$(runuser -u @@USER@@ -- bash --noprofile --rcfile /etc/bashrc -i -c 'printf "%s" "$PS1"' </dev/null 2>/dev/null)
//RS           banner=$(head -n1 /etc/issue)
//RS           jq -cn \
//RS             --arg host "$(cat /proc/sys/kernel/hostname)" \
//RS             --arg kernel "$(uname -r)" \
//RS             --arg dm "$dm" \
//RS             --arg session_type "$stype" \
//RS             --arg shell_pid "$shell_pid" \
//RS             --arg user "@@USER@@" \
//RS             --arg os_release "$os_name" \
//RS             --arg prompt "$prompt" \
//RS             --arg banner "$banner" \
//RS             '{host:$host,kernel:$kernel,display_manager:$dm,session_type:$session_type,shell_pid:$shell_pid,user:$user,desktop:"@@DESKTOP_NAME@@",os_release:$os_release,prompt:$prompt,banner:$banner,proof:"live-desktop"}' \
//RS             | sed 's/^/NIXOS_COMPARISON_PROOF:/' > /dev/ttyS0
//RS           exit 0
//RS         fi
//RS         sleep 2
//RS       done
//RS       echo 'NIXOS_COMPARISON_PROOF:{"proof":"failed","reason":"desktop-not-live-within-300s"}' > /dev/ttyS0
//RS       exit 1
//RS     '';
//RS   };
//RS }
//RS "#;
