// Migration-only NixOS comparison backend: explicit compare-nixos publication only.
use jetpack.JetOS.OptionsRendering.[clean_bool_json, clean_symbol, clean_value, collect_names, is_option_priority_metadata, parse_list_items, resolved_option_value, service_extra]
use jetpack.JetOS.Types.[OSFlags]
use jetpack.JetOS.VmProof.[file_sha256, require_real_vm_tools]
use jetpack.Output.[Theme]
use jetpack.[RefSpec, JSON]
use jet_env_model.ModuleEval.[SystemPlan]
use std.[fs, io, env, process, thread]
use std.process.[Command, Stdio, Child]
use std.time.[Duration, Instant]
use std.io.[BufReader]
use std.os.unix.net.[UnixStream]
use core.sys.target.[selected_family]

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:26
const NIXOS_STATE_VERSION: String = "26.05"
// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:27
const MIGRATION_TIMEOUT_MS: U64 = 1_200_000
// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:28
const MIGRATION_GUEST_PROOF_MARKER: String = "NIXOS_COMPARISON_PROOF:"

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:32
struct NixosMapping {
    nixpkgs_owner: String
    nixpkgs_repo: String
    nixpkgs_rev: String
    body_lines: [String]
    system_packages: [String]
    kernel_input: (String, String, String)?
    desktop_shell_process: String
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:45
fn locked_inputs(mapping: &NixosMapping) -> [String] {
    inputs := ["github:{mapping.nixpkgs_owner}/{mapping.nixpkgs_repo}/{mapping.nixpkgs_rev}"]
    if (owner, repo, rev) :: mapping.kernel_input { inputs.push("github:{owner}/{repo}/{rev}") }
    inputs
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:56
#Error enum OfflineInputError { Missing(String), Tool(String) }

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:61
fn require_offline_inputs(dir: &OSPath, mapping: &NixosMapping) -> Unit OfflineInputError! {
    // GATE #4494 real native process output.
    result :: Command.new("nix").args(["flake", "metadata", "--offline", "--json", "path:."]).current_dir(dir).output().map_err(error -> OfflineInputError.Tool("checking the composed comparison inputs with `nix flake metadata --offline` failed: {error}"))?
    if result.status.success() { return Ok(()) }
    stderr :: String.from_utf8_lossy(&result.stderr)
    if input :: locked_inputs(mapping).into_iter().find(input -> stderr.contains(input)) { return Err(.Missing(input)) }
    Err(.Tool("`nix flake metadata --offline path:.` exited {result.status}; private resolver output was suppressed"))
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:87
fn nix_string(value: &String) -> String {
    out := "\""
    loop ch in value.chars() {
        if ch == {
            '\\' -> out.push_str("\\\\")
            '"' -> out.push_str("\\\"")
            '$' -> out.push_str("\\$")
            _ -> out.push(ch)
        }
    }
    out.push('"')
    out
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:101
fn nix_string_list(values: &[String]) -> String {
    if values.is_empty() { "[ ]" } else { "[ {values.iter().map(v -> nix_string(v)).collect::<[String]>().join(" ")} ]" }
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:116
fn nix_int_list(values: &[I64]) -> String {
    if values.is_empty() { "[ ]" } else { "[ {values.iter().map(v -> v.to_string()).collect::<[String]>().join(" ")} ]" }
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:131
fn parse_int_list(value: &String) -> [I64] {
    parse_list_items(value).iter().filter_map(s -> s.parse::<I64>().ok()).collect()
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:141
fn nixpkgs_owner_repo_rev(upstream: &String) -> (String, String, String)? {
    rest :: upstream.strip_prefix("github:") ?? return .None
    parts := rest.splitn(3, '/')
    owner :: parts.next() ?? return .None
    repo :: parts.next() ?? return .None
    rev :: parts.next() ?? return .None
    if repo.eq_ignore_ascii_case("nixpkgs") { .Val((owner.to_string(), repo.to_string(), rev.to_string())) } else { .None }
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:156
fn nixpkgs_pin(table: &RefSpec.SourceTable) -> (String, String, String)? {
    table.declarations().into_iter().find_map((_, upstream, _) -> nixpkgs_owner_repo_rev(&upstream))
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:163
fn is_nixpkgs_source(source: &RefSpec.Source, table: &RefSpec.SourceTable) -> Bool {
    if source == {
        .Jetpack | .Nixpkgs -> true
        .Named(name) -> table.upstream(name).and_then(nixpkgs_owner_repo_rev).is_some()
        _ -> false
    }
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:176
fn is_known_option_key(key: &String) -> Bool {
    if is_option_priority_metadata(key) { return true }
    if rest :: key.strip_prefix("users.") {
        if (_, field) :: rest.split_once('.') { return ["normal", "home", "groups", "initialPassword", "shell"].contains(field) }
        return false
    }
    if rest :: key.strip_prefix("user.") {
        if (_, field) :: rest.split_once('.') { return ["packages", "homeManager"].contains(field) }
        return false
    }
    if rest :: key.strip_prefix("apps.program.") { return rest.split('.').count() >= 2 }
    if rest :: key.strip_prefix("groups.") { return rest.split_once('.').map((_, f) -> f == "members") ?? false }
    if key.strip_prefix("performance.sysctl.").is_some() { return true }
    ["network.hostName", "network.networkmanager.enable", "network.firewall.allowedTcpPorts", "network.firewall.allowedUdpPorts", "network.dns", "filesystem.timeZone", "services.localization.locale", "services.localization.keyboardLayout", "boot.loader", "boot.loader.efi.canTouchVariables", "boot.kernel", "boot.kernel.profile", "boot.kernel.params", "init.defaultTarget", "performance.zram.memoryPercent", "services.desktop.profile", "services.desktop.plasma.enable", "services.displayManager", "services.desktop.autoLogin.user", "services.audio.pipewire.enable", "services.audio.rtkit.enable", "services.virtualization.libvirtd.enable", "services.virtualization.docker.enable", "services.gaming.steam.enable", "services.gaming.gamemode.enable", "services.smartcard.pcscd.enable", "hardware.bluetooth.enable", "apps.flatpak.enable"].contains(key)
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:241
fn shell_package_attr(value: &String) -> String {
    clean_value(value).rsplit('.').next().unwrap_or(value).to_string()
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:252
fn parse_package_ref_names(value: &String) -> [String] {
    value.split(c -> c == '[' || c == ']' || c == ',').map(part -> part.trim()).filter(part -> !part.is_empty()).map(part -> { name := part.rsplit('.').next().unwrap_or(part).trim() // #4303
        name.to_string() }).filter(name -> !name.is_empty() && name != "nixpkgs").collect()
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:262
const MISSING_NIXPKGS_PIN: String = "no declared source resolves to `NixOS/nixpkgs/<rev-or-ref>@github` (the real tier needs exactly one nixpkgs pin)"

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:269
fn map_system_to_nixos(system: &SystemPlan, table: &RefSpec.SourceTable) -> NixosMapping [String]! {
    unmapped := [] as [String]
    loop option in &system.options {
        if !is_known_option_key(&option.key) { unmapped.push("option `{option.key}`") }
    }
    pin :: nixpkgs_pin(table)
    if pin.is_none() { unmapped.push(MISSING_NIXPKGS_PIN.to_string()) }
    system_packages := [] as [String]
    loop pkg in &system.packages {
        raw :: if pkg.source.is_empty() { pkg.name.clone() } else { "{pkg.name}@{pkg.source}" }
        is_nixpkgs :: if RefSpec.classify_in(&raw, table) == { .Ok(spec) -> is_nixpkgs_source(&spec.source, table); .Err(_) -> false }
        if is_nixpkgs { system_packages.push(pkg.name.clone()) } else {
            label :: if pkg.source.is_empty() { pkg.name.clone() } else { "{pkg.source}.{pkg.name}" }
            unmapped.push("package `{label}` (non-nixpkgs source in real tier)")
        }
    }
    body_lines := [] as [String]
    if v :: resolved_option_value(system, "network.hostName") { body_lines.push("  networking.hostName = {nix_string(&v)};") }
    if v :: resolved_option_value(system, "network.networkmanager.enable") { body_lines.push("  networking.networkmanager.enable = {clean_bool_json(&v)};") }
    if v :: resolved_option_value(system, "network.firewall.allowedTcpPorts") { body_lines.push("  networking.firewall.allowedTCPPorts = {nix_int_list(&parse_int_list(&v))};") }
    if v :: resolved_option_value(system, "network.dns") { body_lines.push("  networking.nameservers = {nix_string_list(&parse_list_items(&v))};") }
    if v :: resolved_option_value(system, "filesystem.timeZone") { body_lines.push("  time.timeZone = {nix_string(&v)};") }
    if v :: resolved_option_value(system, "services.localization.locale") { body_lines.push("  i18n.defaultLocale = {nix_string(&v)};") }
    if v :: resolved_option_value(system, "services.localization.keyboardLayout") { body_lines.push("  services.xserver.xkb.layout = {nix_string(&v)};") }
    if v :: resolved_option_value(system, "boot.loader") {
        if clean_symbol(&v).as_str() == {
            "SystemdBoot" -> body_lines.push("  boot.loader.systemd-boot.enable = true;")
            "Limine" -> body_lines.push("  boot.loader.limine.enable = true;")
            other -> unmapped.push("option `boot.loader` value `.{other}` has no NixOS mapping (supported: .SystemdBoot, .Limine)")
        }
    }
    if v :: resolved_option_value(system, "boot.loader.efi.canTouchVariables") { body_lines.push("  boot.loader.efi.canTouchEfiVariables = {clean_bool_json(&v)};") }
    params := resolved_option_value(system, "boot.kernel.params").map(v -> parse_list_items(&v)).unwrap_or_default()
    params.push("console=ttyS0,115200")
    params.push("console=tty0")
    body_lines.push("  boot.kernelParams = {nix_string_list(&params)};")
    kernel_input := .None as (String, String, String)?
    if v :: resolved_option_value(system, "boot.kernel") {
        if clean_symbol(&v).as_str() == {
            "CachyOS" -> {
                declared :: table.declarations().into_iter().find_map((_, upstream, _) -> {
                    rest :: upstream.strip_prefix("github:") ?? return .None
                    parts := rest.splitn(3, '/')
                    owner :: (parts.next() ?? return .None).to_string()
                    repo :: (parts.next() ?? return .None).to_string()
                    rev :: parts.next().unwrap_or("release").to_string()
                    if repo.eq_ignore_ascii_case("nix-cachyos-kernel") { .Val((owner, repo, rev)) } else { .None }
                })
                if declared == {
                    .Val(input) -> {
                        attr :: if resolved_option_value(system, "boot.kernel.profile").map(p -> clean_symbol(&p)).as_deref() == { .Val("CachyOSLts") -> "linuxPackages-cachyos-lts"; _ -> "linuxPackages-cachyos-latest" }
                        body_lines.push("  boot.kernelPackages = pkgs.cachyosKernels.{attr};")
                        kernel_input = .Val(input)
                    }
                    .None -> unmapped.push("option `boot.kernel` `.CachyOS` needs a declared `<owner>/nix-cachyos-kernel/<rev>@github` source for the kernel overlay")
                }
            }
            other -> unmapped.push("option `boot.kernel` value `.{other}` has no NixOS mapping (supported: .CachyOS)")
        }
    }
    if v :: resolved_option_value(system, "network.firewall.allowedUdpPorts") { body_lines.push("  networking.firewall.allowedUDPPorts = {nix_int_list(&parse_int_list(&v))};") }
    sysctl_entries :: system.options.iter().filter_map(option -> option.key.strip_prefix("performance.sysctl.").map(rest -> (rest.to_string(), option.value.clone()))).collect::<[(String, String)]>()
    if !sysctl_entries.is_empty() {
        body_lines.push("  boot.kernel.sysctl = {{")
        loop (key, value) in sysctl_entries {
            cleaned :: clean_value(&value)
            rendered :: if cleaned == "true" || cleaned == "false" || cleaned.parse::<F64>().is_ok() { cleaned.clone() } else { nix_string(&cleaned) }
            body_lines.push("    \"{key}\" = lib.mkForce {rendered};")
        }
        body_lines.push("  };")
    }
    if v :: resolved_option_value(system, "performance.zram.memoryPercent") {
        body_lines.extend(["  zramSwap = {{", "    enable = true;", "    memoryPercent = {clean_value(&v)};", "  };"])
    }
    loop (key, nixos) in [("services.virtualization.libvirtd.enable", "virtualisation.libvirtd.enable"), ("services.virtualization.docker.enable", "virtualisation.docker.enable"), ("services.gaming.steam.enable", "programs.steam.enable"), ("services.gaming.gamemode.enable", "programs.gamemode.enable"), ("services.smartcard.pcscd.enable", "services.pcscd.enable"), ("hardware.bluetooth.enable", "hardware.bluetooth.enable"), ("apps.flatpak.enable", "services.flatpak.enable")] {
        if v :: resolved_option_value(system, key) { body_lines.push("  {nixos} = {clean_bool_json(&v)};") }
    }
    loop group in collect_names(system, "groups") {
        if v :: resolved_option_value(system, "groups.{group}.members") {
            members :: parse_list_items(&v).iter().map(m -> m.strip_prefix("users.").unwrap_or(m).to_string()).collect::<[String]>()
            body_lines.push("  users.groups.{group}.members = {nix_string_list(&members)};")
        }
    }
    desktop_default :: resolved_option_value(system, "services.desktop.profile").map(v -> clean_symbol(&v) == "Default") ?? false
    if v :: resolved_option_value(system, "services.desktop.profile") {
        if clean_symbol(&v) != "Default" { unmapped.push("option `services.desktop.profile` value `.{clean_symbol(&v)}` has no NixOS mapping (supported: .Default)") }
    }
    plasma_enabled :: resolved_option_value(system, "services.desktop.plasma.enable").map(v -> clean_bool_json(&v) == "true") ?? false
    display_manager :: resolved_option_value(system, "services.displayManager").map(v -> clean_value(&v)).or_else(() -> if desktop_default { .Val("gdm") } else { .None }).or_else(() -> if plasma_enabled { .Val("sddm") } else { .None })
    if desktop_default { body_lines.push("  services.desktopManager.gnome.enable = true;") }
    if plasma_enabled { body_lines.push("  services.desktopManager.plasma6.enable = true;") }
    if display_manager.as_deref() == {
        .Val("gdm") -> body_lines.push("  services.displayManager.gdm.enable = true;")
        .Val("sddm") -> body_lines.push("  services.displayManager.sddm.enable = true;")
        .Val(other) -> unmapped.push("option `services.displayManager` value `{other}` has no NixOS mapping (supported: gdm, sddm)")
        .None -> {}
    }
    if user :: resolved_option_value(system, "services.desktop.autoLogin.user") {
        body_lines.extend(["  services.displayManager.autoLogin = {{", "    enable = true;", "    user = {nix_string(&user)};", "  };", "  systemd.services.\"getty@tty1\".enable = false;", "  systemd.services.\"autovt@tty1\".enable = false;"])
    }
    if v :: resolved_option_value(system, "services.audio.pipewire.enable") {
        body_lines.extend(["  services.pipewire = {{", "    enable = {clean_bool_json(&v)};", "    alsa.enable = {clean_bool_json(&v)};", "    pulse.enable = {clean_bool_json(&v)};", "  };"])
    }
    if v :: resolved_option_value(system, "services.audio.rtkit.enable") { body_lines.push("  security.rtkit.enable = {clean_bool_json(&v)};") }
    fish_enabled := false
    loop name in collect_names(system, "users") {
        user_lines := [] as [String]
        if v :: resolved_option_value(system, "users.{name}.normal") { user_lines.push("    isNormalUser = {clean_bool_json(&v)};") }
        if v :: resolved_option_value(system, "users.{name}.home") { user_lines.push("    home = {nix_string(&v)};") }
        if v :: resolved_option_value(system, "users.{name}.groups") { user_lines.push("    extraGroups = {nix_string_list(&parse_list_items(&v))};") }
        if v :: resolved_option_value(system, "users.{name}.initialPassword") { user_lines.push("    initialPassword = {nix_string(&v)};") }
        if v :: resolved_option_value(system, "users.{name}.shell") {
            attr :: shell_package_attr(&v)
            user_lines.push("    shell = pkgs.{attr};")
            if attr == "fish" { fish_enabled = true }
        }
        if v :: resolved_option_value(system, "user.{name}.packages") {
            attrs :: parse_package_ref_names(&v)
            if !attrs.is_empty() { user_lines.push("    packages = map jetosPkg [ {attrs.iter().map(p -> nix_string(p)).collect::<[String]>().join(" ")} ];") }
        }
        body_lines.push("  users.users.{name} = {{")
        body_lines.extend(user_lines)
        body_lines.push("  };")
    }
    loop option in &system.options {
        rest :: option.key.strip_prefix("apps.program.") ?? continue
        (module, field) :: rest.split_once('.') ?? continue
        if field != "enable" || clean_bool_json(&option.value) != "true" { continue }
        if module == {
            "git" -> body_lines.push("  programs.git.enable = true;")
            "fish" -> { fish_enabled = true }
            "starship" | "helix" | "ghostty" | "vscode" | "yazi" | "btop" | "bat" | "eza" | "fzf" | "zoxide" | "ripgrep" | "tealdeer" | "fastfetch" | "cursor" | "discord" | "spicetify" | "browser" | "ssh" -> {
                if !system_packages.iter().any(p -> p == module) { system_packages.push(module.to_string()) }
            }
            other -> unmapped.push("option `apps.program.{other}.enable` has no NixOS mapping yet")
        }
    }
    if fish_enabled { body_lines.push("  programs.fish.enable = true;") }
    loop service in &system.services {
        enabled :: if service.enable { "true" } else { "false" }
        if service.name.as_str() == {
            "openssh" -> {
                body_lines.push("  services.openssh.enable = {enabled};")
                if ports :: service_extra(service, &["ports"]) {
                    ports :: parse_int_list(&ports)
                    if !ports.is_empty() { body_lines.push("  services.openssh.ports = {nix_int_list(&ports)};") }
                }
            }
            "tailscale" -> body_lines.push("  services.tailscale.enable = {enabled};")
            other -> {
                if exec :: service_extra(service, &["exec"]) {
                    attr :: nix_string(other)
                    body_lines.extend(["  systemd.services.{attr} = {{", "    enable = {enabled};", "    serviceConfig.ExecStart = {nix_string(&exec)};", "  };"])
                    if timer :: service_extra(service, &["timer"]) {
                        body_lines.extend(["  systemd.timers.{attr} = {{", "    wantedBy = [ \"timers.target\" ];", "    timerConfig.OnCalendar = {nix_string(&timer)};", "  };"])
                    }
                } else { unmapped.push("service `{service.name}` (unknown service with no `exec:` field)") }
            }
        }
    }
    if !unmapped.is_empty() { unmapped.sort(); unmapped.dedup(); return Err(unmapped) }
    (nixpkgs_owner, nixpkgs_repo, nixpkgs_rev) :: pin ?? return Err([MISSING_NIXPKGS_PIN.to_string()])
    Ok(NixosMapping(nixpkgs_owner: nixpkgs_owner, nixpkgs_repo: nixpkgs_repo, nixpkgs_rev: nixpkgs_rev, body_lines: body_lines, system_packages: system_packages, kernel_input: kernel_input, desktop_shell_process: if plasma_enabled { "plasmashell" } else { "gnome-shell" }))
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:700
const FLAKE_TEMPLATE: String = """{
  description = "NixOS comparison for @@HOST@@ (generated by `jet os migrate compare-nixos`; do not hand-edit)";

  inputs.nixpkgs.url = "github:@@OWNER@@/@@REPO@@/@@REV@@";
@@EXTRA_INPUTS@@
  outputs = { self, nixpkgs, ... }@inputs:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};
      lib = nixpkgs.lib;
    in {
      nixosConfigurations.@@HOST@@ = lib.nixosSystem {
        inherit system;
        modules = [ ./configuration.nix@@EXTRA_MODULES@@ ];
      };

      packages.${system} = {
        disk = import (nixpkgs + "/nixos/lib/make-disk-image.nix") {
          inherit lib pkgs;
          config = self.nixosConfigurations.@@HOST@@.config;
          format = "qcow2";
          diskSize = "auto";
          additionalSpace = "12G";
          partitionTableType = "efi";
        };
        firmware = pkgs.OVMF.fd;
      };
    };
}
"""

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:731
fn render_flake_nix(host: &String, mapping: &NixosMapping) -> String {
    (extra_inputs, extra_modules) :: if mapping.kernel_input == {
        .Val((owner, repo, rev)) -> ("  inputs.cachyos.url = \"github:{owner}/{repo}/{rev}\";\n  inputs.cachyos.inputs.nixpkgs.follows = \"nixpkgs\";\n", " { nixpkgs.overlays = [ inputs.cachyos.overlays.default ]; }")
        .None -> ("", "")
    }
    FLAKE_TEMPLATE.replace("@@HOST@@", host).replace("@@OWNER@@", &mapping.nixpkgs_owner).replace("@@REPO@@", &mapping.nixpkgs_repo).replace("@@REV@@", &mapping.nixpkgs_rev).replace("@@EXTRA_INPUTS@@", &extra_inputs).replace("@@EXTRA_MODULES@@", &extra_modules)
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:750
const CONFIGURATION_HEAD: String = """{ config, pkgs, lib, ... }:
let
  # jetos package resolver: names come from imported package sets whose
  # attribute may live under a package group (KDE apps live in
  # `kdePackages.*`). A miss is a hard eval error, never a silent drop.
  jetosPkg = name:
    let
      # `gnome-shell-extension-user-themes` (pname) lives at
      # `gnomeExtensions.user-themes`; `dejavu-fonts` at `dejavu_fonts`.
      extension = lib.removePrefix "gnome-shell-extension-" name;
      underscored = builtins.replaceStrings ["-"] ["_"] name;
      # Removed-alias attrs exist but throw on access — tryEval skips them
      # so lookup falls through to the real location (e.g. kdePackages).
      tryAttr = attrs: n:
        if attrs ? ${n} then
          let r = builtins.tryEval attrs.${n}; in
          if r.success then [ r.value ] else [ ]
        else [ ];
      found = (tryAttr pkgs name) ++ (tryAttr pkgs underscored)
        ++ (tryAttr (pkgs.kdePackages or { }) name)
        ++ (tryAttr (pkgs.gnomeExtensions or { }) extension);
    in
    if builtins.length found > 0 then builtins.head found
    else throw "jetos: package `${name}` is not in nixpkgs, kdePackages, or gnomeExtensions at the pinned revision";
in
{
  system.stateVersion = "@@STATEVERSION@@";
  # Imported package sets routinely include unfree software (steam, discord,
  # editors); nixpkgs' license gate is a nixpkgs-ism, not a jetos policy.
  nixpkgs.config.allowUnfree = true;

  boot.loader.timeout = 1;
  boot.growPartition = true;
  boot.initrd.availableKernelModules = [
    "virtio_pci" "virtio_blk" "virtio_scsi" "virtio_net"
    "ahci" "xhci_pci" "nvme" "sd_mod" "sr_mod"
  ];

  fileSystems."/" = {
    device = "/dev/disk/by-label/nixos";
    fsType = "ext4";
    autoResize = true;
  };
  fileSystems."/boot" = {
    device = "/dev/disk/by-label/ESP";
    fsType = "vfat";
  };

  environment.variables.NIXOS_COMPARISON = "1";
  programs.bash.promptInit = lib.mkAfter ''
    PS1='NixOS comparison $ '
    export PS1
  '';
  environment.etc.issue.text = "NixOS comparison guest\n";
  environment.etc.motd.text = "NixOS comparison guest for A/B migration checks\n";
"""

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:807
const CONFIGURATION_PROOF_SERVICE: String = """
  # NixOS comparison proof: emit one fact only after identity and desktop checks.
  systemd.services.nixos-comparison-proof = {
    description = "NixOS comparison guest proof emitter";
    wantedBy = [ "multi-user.target" ];
    after = [ "multi-user.target" ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    path = [ pkgs.bash pkgs.util-linux pkgs.systemd pkgs.procps pkgs.jq pkgs.gawk pkgs.gnused pkgs.coreutils ];
    script = ''
      deadline=$((SECONDS + 300))
      while [ "$SECONDS" -lt "$deadline" ]; do
        dm=$(systemctl is-active display-manager.service || true)
        # NixOS wraps gnome-shell (comm = ".gnome-shell-wr…"), so match the
        # full command line rather than the truncated process name.
        shell_pid=$(pgrep -u @@USER@@ -f @@DESKTOP_SHELL_PROCESS@@ | head -n1 || true)
        session=$(loginctl list-sessions --no-legend | awk '$3=="@@USER@@" {print $1; exit}')
        stype=""
        if [ -n "$session" ]; then
          stype=$(loginctl show-session "$session" -p Type --value || true)
        fi
        echo "NIXOS_COMPARISON_DEBUG dm=$dm shell=$shell_pid session=$session stype=$stype" > /dev/ttyS0 || true
        if [ "$dm" = "active" ] && [ -n "$shell_pid" ] && [ "$stype" = "wayland" ]; then
          os_name=$(. /etc/os-release; printf '%s' "$NAME")
          prompt=$(runuser -u @@USER@@ -- bash --noprofile --rcfile /etc/bashrc -i -c 'printf "%s" "$PS1"' </dev/null 2>/dev/null)
          banner=$(head -n1 /etc/issue)
          jq -cn \
            --arg host "$(cat /proc/sys/kernel/hostname)" \
            --arg kernel "$(uname -r)" \
            --arg dm "$dm" \
            --arg session_type "$stype" \
            --arg shell_pid "$shell_pid" \
            --arg user "@@USER@@" \
            --arg os_release "$os_name" \
            --arg prompt "$prompt" \
            --arg banner "$banner" \
            '{host:$host,kernel:$kernel,display_manager:$dm,session_type:$session_type,shell_pid:$shell_pid,user:$user,desktop:"@@DESKTOP_NAME@@",os_release:$os_release,prompt:$prompt,banner:$banner,proof:"live-desktop"}' \
            | sed 's/^/NIXOS_COMPARISON_PROOF:/' > /dev/ttyS0
          exit 0
        fi
        sleep 2
      done
      echo 'NIXOS_COMPARISON_PROOF:{"proof":"failed","reason":"desktop-not-live-within-300s"}' > /dev/ttyS0
      exit 1
    '';
  };
}
"""

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:858
fn render_configuration_nix(system: &SystemPlan, mapping: &NixosMapping) -> String {
    out := CONFIGURATION_HEAD.replace("@@STATEVERSION@@", NIXOS_STATE_VERSION)
    out.push('\n')
    loop line in &mapping.body_lines { out.push_str(line); out.push('\n') }
    out.push('\n')
    out.push_str("  environment.systemPackages = map jetosPkg [ {mapping.system_packages.iter().map(p -> nix_string(p)).collect::<[String]>().join(" ")} ];\n")
    proof_user :: resolved_option_value(system, "services.desktop.autoLogin.user").unwrap_or_else(() -> collect_names(system, "users").into_iter().next().unwrap_or_else(() -> "root"))
    desktop_name :: if mapping.desktop_shell_process == "plasmashell" { "plasma" } else { "gnome" }
    out.push_str(&CONFIGURATION_PROOF_SERVICE.replace("@@USER@@", &proof_user).replace("@@DESKTOP_SHELL_PROCESS@@", &mapping.desktop_shell_process).replace("@@DESKTOP_NAME@@", desktop_name).replace("@@HOST@@", &system.name))
    out
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:899
fn write_nixos_backend(dir: &OSPath, system: &SystemPlan, mapping: &NixosMapping) -> Unit io.Error! {
    verify_private_stage(dir)?
    fs.write(dir.join("flake.nix"), render_flake_nix(&system.name, mapping))?
    fs.write(dir.join("configuration.nix"), render_configuration_nix(system, mapping))?
    facts :: "{{\"kind\":\"nixos.migration.input-facts\",\"host\":{JSON.quote(&system.name)},\"nixpkgs\":{JSON.quote("github:{mapping.nixpkgs_owner}/{mapping.nixpkgs_repo}/{mapping.nixpkgs_rev}")},\"packages\":[{mapping.system_packages.iter().map(p -> JSON.quote(p)).collect::<[String]>().join(",")}]}}\n"
    fs.write(dir.join("nixos-input-facts.json"), facts)
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:930
fn migration_timeout() -> Duration {
    env.var("JETOS_VM_TIMEOUT_MS").ok().and_then(raw -> raw.parse::<U64>().ok()).map(Duration.from_millis).unwrap_or_else(() -> Duration.from_millis(MIGRATION_TIMEOUT_MS))
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:938
fn real_qemu_prove_argv(disk: &String, ovmf_code: &OSPath, ovmf_vars: &OSPath, log_path: &OSPath, sock_path: &OSPath) -> [String] {
    ["qemu-system-x86_64", "-enable-kvm", "-cpu", "host", "-m", "4096", "-smp", "4", "-drive", "if=pflash,format=raw,readonly=on,file={ovmf_code.display()}", "-drive", "if=pflash,format=raw,file={ovmf_vars.display()}", "-drive", "file={disk},format=qcow2,if=virtio", "-device", "virtio-gpu-pci", "-display", "none", "-serial", "file:{log_path.display()}", "-qmp", "unix:{sock_path.display()},server,nowait"]
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:976
fn write_migration_plan(dir: &OSPath, system: &SystemPlan, disk: &String, offline: Bool) -> OSPath io.Error! {
    log_path :: dir.join("nixos-comparison.serial.log")
    sock_path :: dir.join("nixos-comparison.qmp.sock")
    ovmf_code :: dir.join("firmware/FV/OVMF_CODE.fd")
    ovmf_vars :: dir.join("OVMF_VARS.fd")
    build_commands :: [("nix-build-disk", nix_build_argv("disk", offline)), ("nix-build-firmware", nix_build_argv("firmware", offline))]
    commands_json := build_commands.iter().map((phase, argv) -> "{{\"phase\":{JSON.quote(phase)},\"cwd\":{JSON.quote(dir.display().to_string())},\"argv\":[{argv.iter().map(a -> JSON.quote(a)).collect::<[String]>().join(",")}]}}").collect::<[String]>()
    boot_argv :: real_qemu_prove_argv(disk, &ovmf_code, &ovmf_vars, &log_path, &sock_path)
    commands_json.push("{{\"phase\":{JSON.quote("boot-real-guest")},\"cwd\":null,\"argv\":[{boot_argv.iter().map(a -> JSON.quote(a)).collect::<[String]>().join(",")}]}}")
    text :: "{{\"kind\":\"nixos.migration.plan\",\"host\":{JSON.quote(&system.name)},\"disk\":{JSON.quote(disk)},\"commands\":[{commands_json.join(",")}]}}\n"
    path :: dir.join("nixos-comparison-plan.json")
    fs.write(&path, text)?
    Ok(path)
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1025
pub fn cmd_migrate_compare_nixos(theme: &Theme, table: &RefSpec.SourceTable, system: &SystemPlan, out: &OSPath, flags: &OSFlags) -> I32 {
    if out.exists() {
        theme.error("NixOS comparison output already exists", "`{out.display()}` must not exist before publication.", "choose a new `--out <dir>` path.")
        return 2
    }
    mapping :: if map_system_to_nixos(system, table) == {
        .Ok(mapping) -> mapping
        .Err(unmapped) -> {
            theme.error_coded("E1291", "NixOS comparison could not map every system declaration", "The migration-only NixOS backend cannot drop declarations; unmapped: {unmapped.join("; ")}.", "map or remove each listed declaration, then run the explicit migration command again.")
            return 2
        }
    }
    if .Err(error) :: require_real_vm_tools() {
        theme.error_coded("E1290", "NixOS comparison needs real migration tools", &error, "put real `nix` and QEMU tools on PATH, then run the migration command again.")
        return 2
    }
    parent :: out.parent().filter(path -> !path.as_os_str().is_empty()).unwrap_or(OSPath.new("."))
    if .Err(error) :: fs.create_dir_all(parent) {
        theme.error("could not prepare the NixOS comparison output", "creating `{parent.display()}` failed: {error}.", "choose a writable `--out <dir>` path.")
        return 2
    }
    stage :: parent.join(".nixos-comparison-{system.name}-{process.id()}")
    if .Err(error) :: create_private_stage(&stage) {
        theme.error("could not protect the NixOS comparison staging path", "creating private `{stage.display()}` failed: {error}.", "choose a private writable output parent and remove any stale staging path.")
        return 2
    }
    disk :: stage.join("nixos-{system.name}.qcow2")
    if .Err(error) :: write_nixos_backend(&stage, system, &mapping) {
        error :: finish_private_stage(&stage, Err("writing private NixOS inputs failed: {error}")).unwrap_err()
        return report_migration_failure(theme, system, &error)
    }
    if flags.offline {
        if .Err(error) :: require_offline_inputs(&stage, &mapping) {
            if .Err(cleanup) :: finish_private_stage(&stage, Ok(())) { return report_migration_failure(theme, system, &cleanup) }
            if error == {
                .Missing(input) -> theme.error_coded("E1276", "migration comparison unavailable offline: {input}", "The locked Nix input is not present in the local Nix store.", "run the migration once online to fetch the locked input, then retry with `--offline`.")
                .Tool(error) -> theme.error_coded("E1290", "NixOS comparison needs real migration tools", &error, "put real `nix` and QEMU tools on PATH, then run the migration command again.")
            }
            return 2
        }
    }
    result :: (() -> {
        plan :: write_migration_plan(&stage, system, &disk.display().to_string(), flags.offline).map_err(error -> "writing migration plan failed: {error}")?
        run :: run_migration_build_and_boot(&stage, &disk, flags.offline)?
        publish_migration_bundle(out, system, &mapping, &disk, &plan, &run)
    })()
    if finish_private_stage(&stage, result) == {
        .Ok(()) -> {
            host :: out.join("nixos").join(&system.name)
            image :: host.join("system.qcow2")
            proof :: host.join("proof.json")
            receipt :: host.join("receipt.json")
            if flags.json {
                println("{{\"kind\":\"nixos.migration.comparison\",\"state\":\"proved\",\"host\":{JSON.quote(&system.name)},\"image\":{JSON.quote(image.display().to_string())},\"proof\":{JSON.quote(proof.display().to_string())},\"receipt\":{JSON.quote(receipt.display().to_string())}}}")
            } else {
                println("built NixOS comparison: {image.display()}")
                println("boot proof: {proof.display()}")
                println("receipt: {receipt.display()}")
            }
            0
        }
        .Err(error) -> report_migration_failure(theme, system, &error)
    }
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1155
fn report_migration_failure(theme: &Theme, system: &SystemPlan, error: &String) -> I32 {
    theme.error_coded("E1285", "NixOS comparison guest proof has not run", "the NixOS build and boot for `{system.name}` failed: {error}.", "fix the build or guest failure, then run the explicit migration command again.")
    2
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1168
fn create_private_stage(stage: &OSPath) -> Unit io.Error! {
    // GATE #4494 native no-follow mkdir; #4483 selected target family.
    builder := fs.DirBuilder.new()
    if selected_family() == "unix" { builder.mode(0o700) }
    builder.create(stage)?
    verify_private_stage(stage)
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1182
fn verify_private_stage(stage: &OSPath) -> Unit io.Error! {
    metadata :: fs.symlink_metadata(stage)?
    if !metadata.file_type().is_dir() || metadata.file_type().is_symlink() { return Err(io.Error.other("private staging path is not a no-follow directory")) }
    if selected_family() == "unix" {
        mode :: metadata.permissions().mode() & 0o777
        // GATE #4409 preserve PermissionDenied.
        if mode != 0o700 { return Err(io.Error.new(.PermissionDenied, "private staging mode is {mode:o}, expected 700")) }
    }
    Ok(())
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1203
fn finish_private_stage(stage: &OSPath, result: Unit String!) -> Unit String! {
    finish_private_stage_with(stage, result, path -> fs.remove_dir_all(path))
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1207
fn finish_private_stage_with(stage: &OSPath, result: Unit String!, cleanup: fn(&OSPath) -> Unit io.Error!) -> Unit String! {
    cleanup :: if cleanup(stage) == {
        .Ok(()) -> Ok(())
        .Err(error) if error.kind() == .NotFound -> Ok(())
        .Err(error) -> Err("removing private staging directory `{stage.display()}` failed: {error}")
    }
    if (result, cleanup) == {
        (.Ok(()), .Ok(())) -> Ok(())
        (.Err(root), .Ok(())) -> Err(root)
        (.Ok(()), .Err(cleanup)) -> Err(cleanup)
        (.Err(root), .Err(cleanup)) -> Err("{root}; cleanup also failed: {cleanup}")
    }
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1228
struct MigrationRun { report: String, screenshot: OSPath, argv: [String] }

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1234
fn run_migration_build_and_boot(dir: &OSPath, disk: &OSPath, offline: Bool) -> MigrationRun String! {
    // GATE #4494 real native process and filesystem providers.
    disk_out :: nix_build(dir, "disk", offline)?
    firmware_out :: nix_build(dir, "firmware", offline)?
    built_qcow2 :: find_qcow2(&disk_out)?
    if parent :: disk.parent() {
        if !parent.as_os_str().is_empty() { fs.create_dir_all(parent).map_err(e -> "creating `{parent.display()}` failed: {e}")? }
    }
    _ :: fs.remove_file(disk)
    _ :: fs.copy(&built_qcow2, disk).map_err(e -> "copying `{built_qcow2.display()}` to `{disk.display()}` failed: {e}")?
    make_writable(disk)?
    ovmf_code :: firmware_out.join("FV/OVMF_CODE.fd")
    ovmf_vars_src :: firmware_out.join("FV/OVMF_VARS.fd")
    ovmf_vars :: dir.join("OVMF_VARS.fd")
    _ :: fs.copy(&ovmf_vars_src, &ovmf_vars).map_err(e -> "copying `{ovmf_vars_src.display()}` failed: {e}")?
    make_writable(&ovmf_vars)?
    log_path :: dir.join("nixos-comparison.serial.log")
    _ :: fs.remove_file(&log_path)
    sock_path :: env.temp_dir().join("nixos-comparison-qmp-{process.id()}.sock")
    _ :: fs.remove_file(&sock_path)
    screenshot_path :: dir.join("nixos-comparison-boot.png")
    stderr_path :: dir.join("nixos-comparison.qemu.stderr")
    stderr_file :: fs.File.create(&stderr_path).map_err(e -> "creating `{stderr_path.display()}` failed: {e}")?
    disk_abs :: fs.canonicalize(disk).map_err(e -> "resolving `{disk.display()}` failed: {e}")?.display().to_string()
    argv :: real_qemu_prove_argv(&disk_abs, &ovmf_code, &ovmf_vars, &log_path, &sock_path)
    child := Command.new(&argv[0]).args(&argv[1..]).stdout(Stdio.null()).stderr(Stdio.from(stderr_file)).spawn().map_err(e -> "starting real QEMU proof failed: {e}")?
    report :: poll_for_guest_proof(&child, &log_path, migration_timeout())
    qmp_result :: qmp_screendump_and_powerdown(&sock_path, &screenshot_path)
    _ :: wait_child_with_timeout(&child, Duration.from_secs(30))
    _ :: fs.remove_file(&sock_path)
    report :: report?
    _ :: require_nixos_guest_fact(&report)?
    qmp_result?
    Ok(MigrationRun(report: report, screenshot: screenshot_path, argv: argv))
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1302
fn nix_build_argv(target: &String, offline: Bool) -> [String] {
    argv := ["nix", "build", "path:.#{target}", "--no-link", "--print-out-paths"]
    if offline { argv.push("--offline") }
    argv
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1316
fn nix_build(dir: &OSPath, target: &String, offline: Bool) -> OSPath String! {
    argv :: nix_build_argv(target, offline)
    out :: Command.new(&argv[0]).args(&argv[1..]).current_dir(dir).output().map_err(e -> "starting `nix build path:.#{target}` failed: {e}")?
    log :: dir.join("nix-build-{target}.log")
    _ :: fs.write(&log, "stdout:\n{String.from_utf8_lossy(&out.stdout)}\nstderr:\n{String.from_utf8_lossy(&out.stderr)}")
    if !out.status.success() { return Err("`nix build .#{target}` exited {out.status}; private build output was suppressed") }
    stdout :: String.from_utf8_lossy(&out.stdout)
    path := (stdout.lines().next().ok_or_else(() -> "`nix build .#{target}` produced no output path")?).trim() // #4303
    Ok(OSPath.from(path))
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1349
fn find_qcow2(disk_out: &OSPath) -> OSPath String! {
    if disk_out.extension().and_then(e -> e.to_str()) == .Val("qcow2") { return Ok(disk_out.to_path_buf()) }
    // Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1353
    fn walk(dir: &OSPath, found: &OSPath?) -> Unit {
        entries :: fs.read_dir(dir).ok() ?? return
        loop entry in entries.flatten() {
            if found.is_some() { return }
            path :: entry.path()
            if path.is_dir() { walk(&path, found) } else if path.extension().and_then(e -> e.to_str()) == .Val("qcow2") { found = .Val(path) }
        }
    }
    found := .None as OSPath?
    walk(disk_out, &found)
    found.ok_or_else(() -> "no `.qcow2` file found under `{disk_out.display()}`")
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1374
fn make_writable(path: &OSPath) -> Unit String! {
    meta :: fs.metadata(path).map_err(e -> "reading `{path.display()}` failed: {e}")?
    perms := meta.permissions()
    if selected_family() == "unix" { perms.set_mode(0o644) }
    perms.set_readonly(false)
    fs.set_permissions(path, perms).map_err(e -> "chmod `{path.display()}` failed: {e}")
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1388
fn wait_child_with_timeout(child: &Child, timeout: Duration) -> Unit io.Error! {
    // GATE #4494 native child polling and thread sleep.
    start :: Instant.now()
    loop {
        if child.try_wait()?.is_some() { return Ok(()) }
        if start.elapsed() > timeout { _ :: child.kill(); _ :: child.wait(); return Ok(()) }
        thread.sleep(Duration.from_millis(100))
    }
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1406
fn poll_for_guest_proof(child: &Child, log_path: &OSPath, timeout: Duration) -> String String! {
    start :: Instant.now()
    loop {
        if .Ok(text) :: fs.read_to_string(log_path) {
            if report :: text.lines().find_map(line -> line.split_once(MIGRATION_GUEST_PROOF_MARKER).map((_, rest) -> { value := rest.trim() // #4303
                value.to_string() })) { return Ok(report) }
        }
        if .Ok(.Val(status)) :: child.try_wait() { return Err("QEMU exited ({status}) before the guest proof marker; private VM output was suppressed") }
        if start.elapsed() > timeout { return Err("no `{MIGRATION_GUEST_PROOF_MARKER}` line appeared within {timeout.as_millis()}ms; private VM output was suppressed") }
        thread.sleep(Duration.from_millis(200))
    }
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1439
struct ObservedGuestIdentity { os_release: String, prompt: String, banner: String }

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1445
fn require_nixos_guest_fact(report: &String) -> ObservedGuestIdentity String! {
    fact :: JSON.parse(report).map_err(_ -> "invalid guest fact JSON; guest payload was suppressed")?
    field :: name -> fact.get(name).and_then(value -> value.as_str()).map(value -> value.to_string()).map_err(_ -> "guest fact omitted a required identity field; guest payload was suppressed")
    proof :: field("proof")?
    os_release :: field("os_release")?
    prompt :: field("prompt")?
    banner :: field("banner")?
    honest :: proof == "live-desktop" && os_release == "NixOS" && prompt.starts_with("NixOS ") && banner == "NixOS comparison guest" && !report.to_ascii_lowercase().contains("jetos")
    if !honest { return Err("guest fact did not prove honest NixOS os-release, observed prompt, banner, and live desktop; guest payload was suppressed") }
    Ok(ObservedGuestIdentity(os_release: os_release, prompt: prompt, banner: banner))
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1480
// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1488
fn qmp_screendump_and_powerdown(sock_path: &OSPath, screenshot: &OSPath) -> Unit String! {
    // GATE #4483 selected target family; #4494 Unix socket/IO providers.
    if selected_family() != "unix" { return Err("QMP control socket `{sock_path.display()}` needs Unix domain sockets, unavailable on this platform") }
    stream :: UnixStream.connect(sock_path).map_err(e -> "connecting QMP socket `{sock_path.display()}` failed: {e}")?
    stream.set_read_timeout(.Val(Duration.from_secs(10))).map_err(e -> "setting QMP read timeout failed: {e}")?
    reader := BufReader.new(stream.try_clone().map_err(e -> "cloning QMP socket failed: {e}")?)
    writer := stream
    greeting := ""
    _ :: reader.read_line(&greeting).map_err(e -> "reading QMP greeting failed: {e}")?
    writer.write_all(b"{\"execute\":\"qmp_capabilities\"}\n").map_err(e -> "QMP capabilities negotiation failed: {e}")?
    capabilities_response := ""
    _ :: reader.read_line(&capabilities_response).map_err(e -> "reading QMP capabilities response failed: {e}")?
    screendump :: "{{\"execute\":\"screendump\",\"arguments\":{{\"filename\":{JSON.quote(screenshot.display().to_string())}}}}}\n"
    writer.write_all(screendump.as_bytes()).map_err(e -> "QMP screendump command failed: {e}")?
    screendump_response := ""
    _ :: reader.read_line(&screendump_response).map_err(e -> "reading QMP screendump response failed: {e}")?
    writer.write_all(b"{\"execute\":\"system_powerdown\"}\n").map_err(e -> "QMP system_powerdown command failed: {e}")?
    Ok(())
}

// Rust: crates/jetpack/src/JetOS/nixos_backend.rs:1534
fn publish_migration_bundle(out: &OSPath, system: &SystemPlan, mapping: &NixosMapping, disk: &OSPath, plan_path: &OSPath, run: &MigrationRun) -> Unit String! {
    observed :: require_nixos_guest_fact(&run.report)?
    parent :: out.parent().filter(path -> !path.as_os_str().is_empty()).unwrap_or(OSPath.new("."))
    publish :: parent.join(".nixos-comparison-publish-{system.name}-{process.id()}")
    create_private_stage(&publish).map_err(error -> "creating `{publish.display()}` failed: {error}")?
    result :: (() -> {
        nixos :: publish.join("nixos")
        create_private_stage(&nixos).map_err(error -> "creating `{nixos.display()}` failed: {error}")?
        host :: nixos.join(&system.name)
        create_private_stage(&host).map_err(error -> "creating `{host.display()}` failed: {error}")?
        image :: host.join("system.qcow2")
        screenshot :: host.join("boot.png")
        plan :: host.join("build-boot-plan.json")
        _ :: fs.copy(disk, &image).map_err(error -> "publishing system image failed: {error}")?
        make_writable(&image)?
        _ :: fs.copy(&run.screenshot, &screenshot).map_err(error -> "publishing boot screenshot failed: {error}")?
        _ :: fs.copy(plan_path, &plan).map_err(error -> "publishing build/boot plan failed: {error}")?
        disk_sha :: file_sha256(&image)?
        guest_fact :: "{{\"kind\":\"nixos.migration.vmtest.guest-fact\",\"host\":{JSON.quote(&system.name)},\"os_release\":{JSON.quote(&observed.os_release)},\"prompt\":{JSON.quote(&observed.prompt)},\"banner\":{JSON.quote(&observed.banner)},\"report\":{run.report.trim()}}}\n"
        fs.write(host.join("guest-fact.json"), &guest_fact).map_err(error -> "writing guest fact failed: {error}")?
        proof :: "{{\"kind\":\"nixos.migration.boot-proof\",\"state\":\"passed\",\"host\":{JSON.quote(&system.name)},\"image\":\"system.qcow2\",\"disk_sha256\":{JSON.quote(&disk_sha)},\"screenshot\":\"boot.png\",\"guest_fact\":\"guest-fact.json\",\"qemu_argv\":[{run.argv.iter().map(arg -> JSON.quote(arg)).collect::<[String]>().join(",")}]}}\n"
        fs.write(host.join("proof.json"), proof).map_err(error -> "writing boot proof failed: {error}")?
        receipt :: "{{\"kind\":\"nixos.migration.receipt\",\"state\":\"proved\",\"command\":\"jet os migrate compare-nixos\",\"host\":{JSON.quote(&system.name)},\"nixpkgs\":{JSON.quote("github:{mapping.nixpkgs_owner}/{mapping.nixpkgs_repo}/{mapping.nixpkgs_rev}")},\"image\":\"system.qcow2\",\"boot_proof\":\"proof.json\",\"guest_fact\":\"guest-fact.json\"}}\n"
        fs.write(host.join("receipt.json"), receipt).map_err(error -> "writing migration receipt failed: {error}")?
        fs.rename(&publish, out).map_err(error -> "publishing `{out.display()}` failed: {error}")
    })()
    finish_private_stage(&publish, result)
}
