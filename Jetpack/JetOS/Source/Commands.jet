// Rust: crates/jetpack/src/JetOS/commands.rs:20
pub fn cmd_check(theme: &Theme, args: &[String]) -> I32 {
    target :: parse_target_or_report(theme, args.first().map(s -> s.as_str())) ?? return 2
    if load_target(theme, &target) == {
        .Val((_, system)) -> {
            theme.ok("jetos {theme.bold(system.name)} checked ({system.target})")
            0
        }
        .None -> 2
    }
}
// Rust: crates/jetpack/src/JetOS/commands.rs:37
pub fn cmd_plan(theme: &Theme, args: &[String], flags: &JetOSFlags) -> I32 {
    target :: parse_target_or_report(theme, args.first().map(s -> s.as_str())) ?? return 2
    (plan_data, system) :: load_target(theme, &target) ?? return 2
    plan :: render_plan_json(&system, [], None, plan_data.graph_identity.as_deref())
    if flags.json { println(plan) } else {
        if identity :: plan_data.graph_identity.as_deref() { theme.graph_identity(identity) }
        theme.ok("jetos plan for {theme.bold(system.name)}")
        println(plan)
    }
    0
}
// Rust: crates/jetpack/src/JetOS/commands.rs:57
pub fn cmd_proof(theme: &Theme, args: &[String], flags: &JetOSFlags) -> I32 {
    target :: parse_target_or_report(theme, args.first().map(s -> s.as_str())) ?? return 2
    if load_target(theme, &target).is_none() { return 2 }
    generation :: flags.name.as_deref().and_then(name -> generation_named(target.host, name))
        .or_else(() -> if flags.name.is_none() -> latest_generation_for(target.host) else -> None)
    gen :: generation ?? {
        theme.error_coded("E1278", "jetos proof is missing",
            "no built generation exists for `{target.host}`; proof is read from generation artifacts.",
            "run `jet os build <host>` first, using the same `--name` when selecting an exact generation.")
        return 2
    }
    if render_generation_proof_json(&gen) == {
        .Ok(proof) -> {
            if flags.json { println(proof) } else {
                theme.ok("jetos proof for {theme.bold(gen.host)} generation {theme.bold(gen.name)}")
                println(proof)
            }
            0
        }
        .Err(error) -> {
            theme.error_coded("E1278", "jetos proof is incomplete",
                "reading proof artifacts for `{gen.name}` failed: {error}",
                "run `jet os build <host>` again so plan, proof, provenance, health, and rollback facts are regenerated.")
            2
        }
    }
}
// Rust: crates/jetpack/src/JetOS/commands.rs:113
pub fn cmd_build(theme: &Theme, args: &[String], flags: &JetOSFlags, activate: Bool) -> I32 {
    target :: parse_target_or_report(theme, args.first().map(s -> s.as_str())) ?? return 2
    (plan, system) :: load_target(theme, &target) ?? return 2
    if activate {
        if existing :: flags.name.as_deref().and_then(name -> generation_named(system.name, name)) {
            if !prove_activation(theme, &existing, &system) { return 2 }
            return if activate_generation(&existing) == {
                .Ok(()) -> {
                    theme.ok("jetos generation {theme.bold(existing.name)} activated")
                    0
                }
                .Err(error) -> {
                    theme.error("could not activate the generation", "updating the current/default pointers failed: {error}", "check permissions on the Jetpack root, or set JETPACK_ROOT.")
                    2
                }
            }
        }
    }
    // switch is the mutation. A plain build neither computes a diff nor activates.
    outgoing_ordinal :: generation_ordinal(system.name)
    outgoing_packages :: if activate -> latest_generation_for(system.name).map(g -> read_generation_packages(g.path)).unwrap_or_default() else -> []
    gen :: build_generation(theme, &plan, &system, flags, &target.config) ?? return 2
    theme.ok("jetos generation {theme.bold(gen.name)} built for {theme.bold(system.name)}")
    theme.detail(gen.path.display().to_string())
    if activate {
        if !prove_activation(theme, &gen, &system) { return 2 }
        diff :: diff_packages(&outgoing_packages, &read_generation_packages(gen.path))
        if !diff.is_empty() {
            incoming_ordinal :: outgoing_ordinal + 1
            theme.plan_gen_header(outgoing_ordinal, incoming_ordinal)
            name_w :: diff.iter().map(d -> d.name.len()).max().unwrap_or(0).max(8)
            loop row in diff { theme.plan_row(row.mark, row.name, name_w, row.from, row.to) }
            download_bytes: U64 :: diff.iter().filter_map(d -> d.out.as_deref()).map(out -> dir_size_bytes(OSPath.from(out))).sum()
            if download_bytes > 0 { theme.download_line(download_bytes) }
            if !theme.confirm_apply(flags.assume_yes) { return 0 }
            theme.applied_header(incoming_ordinal)
            loop row in diff {
                if row.mark != PlanMark.Remove { theme.ready_row(row.name, name_w, row.to) }
            }
        }
        if activate_generation(&gen) == {
            .Ok(()) -> theme.ok("jetos generation {theme.bold(gen.name)} activated")
            .Err(error) -> {
                theme.error("could not activate the generation", "updating the current/default pointers failed: {error}", "check permissions on the Jetpack root, or set JETPACK_ROOT.")
                return 2
            }
        }
    }
    0
}
// Rust: crates/jetpack/src/JetOS/commands.rs:222
pub fn cmd_rollback(theme: &Theme, args: &[String]) -> I32 {
    host :: args.first().map(s -> s.as_str()) ?? ""
    if host.is_empty() {
        theme.error("rollback needs a host", "`jet os rollback` activates a recorded generation for one host.", "run `jet os generations`, then `jet os rollback <host> [<name>]`.")
        return 2
    }
    requested :: args.get(1).map(s -> s.as_str())
    gen :: find_rollback_generation(host, requested) ?? {
        theme.error("no generation is available for rollback", "no recorded jetos generation matches host `{host}`.", "run `jet os build <host>` or `jet os generations`.")
        return 2
    }
    if activate_generation(&gen) == {
        .Ok(()) -> {
            theme.ok("rolled back {host} to {theme.bold(gen.name)}")
            0
        }
        .Err(error) -> {
            theme.error("could not activate the rollback generation", "updating the current/default pointers failed: {error}", "check permissions on the Jetpack root, or set JETPACK_ROOT.")
            2
        }
    }
}
// Rust: crates/jetpack/src/JetOS/commands.rs:261
pub fn cmd_generations(args: &[String]) -> I32 {
    host :: args.first().map(s -> s.as_str())
    gens := read_generations()
    if host :: host { &gens.retain(g -> g.host == host) }
    &gens.sort_by((a, b) -> (b.created_at <=> a.created_at).then(b.name <=> a.name))
    loop gen in gens { println("{gen.created_at}\t{gen.host}\t{gen.name}\t{gen.path.display()}") }
    0
}
// Rust: crates/jetpack/src/JetOS/commands.rs:284
pub fn cmd_init(theme: &Theme, args: &[String], flags: &JetOSFlags) -> I32 {
    host :: args.first().map(s -> s.as_str()) ?? "host"
    path :: default_config_path()
    if path.exists() {
        theme.error("config.jet already exists", "`jet os init` never overwrites a repo's OS config.", "edit config.jet, or move it aside and run init again.")
        return 2
    }
    // GATE #4494: native path creation and writes, not a Rust callback.
    if parent :: path.parent() {
        if fs.create_dir_all(parent) == {
            .Ok(()) -> {}
            .Err(error) -> {
                theme.error("could not create the jetos config directory", "creating `{parent.display()}` failed: {error}", "check permissions, or create the directory yourself.")
                return 2
            }
        }
    }
    disk :: flags.manual_disk.as_deref().map(d -> "            filesystem.root.device: \"{d.replace("\"", "\\\"")}\",\n")
        ?? "            filesystem.layout: \"guided-ext4\",\n"
    contents :: "module {host} {{\n    system.{host}: {{\n        target: linux.x64,\n        packages: [],\n        services: {{\n            systemd: {{ enable: true, exec: \"/usr/bin/env true\" }},\n        }},\n        options: [\n{disk}            network.hostName: {host},\n            packages.base: true,\n        ],\n    }}\n}}\n"
    if fs.write(path, contents) == {
        .Ok(()) -> {
            theme.ok("wrote jetos config {path.display()}")
            theme.detail("generated systemd-ready system skeleton")
            0
        }
        .Err(error) -> {
            theme.error("could not write the jetos config", "writing `{path.display()}` failed: {error}", "check permissions, or pass a writable HOME.")
            2
        }
    }
}
// Rust: crates/jetpack/src/JetOS/commands.rs:335
pub fn cmd_lift(theme: &Theme, args: &[String], flags: &JetOSFlags) -> I32 {
    host :: args.first().map(s -> s.as_str()) ?? "host"
    root :: args.get(1).map(s -> s.as_str()) ?? "/"
    import_args :: [root.to_string(), Syntax.OS_IMPORT_FLAG_HOST.to_string(), host.to_string(), Syntax.OS_IMPORT_FLAG_FACTS_ONLY.to_string()]
    cmd_import(theme, &import_args, flags)
}
// Rust: crates/jetpack/src/JetOS/commands.rs:347
pub fn cmd_migrate(theme: &Theme, args: &[String], flags: &JetOSFlags) -> I32 {
    if !invoked_by_root_jet() {
        theme.error("NixOS comparison is available only through root `jet`",
            "D-JOS-MIGRATIONVERB1=A authorizes only `jet os migrate compare-nixos`; direct engine front doors cannot reach the migration backend.",
            "run `jet os migrate compare-nixos <host> --out <dir>`.")
        return 2
    }
    (action, rest) :: args.split_first() ?? {
        theme.error("migration needs an action", "D-JOS-MIGRATIONVERB1=A permits only an explicit NixOS comparison migration.", "run `jet os migrate compare-nixos <host> --out <dir>`.")
        return 2
    }
    if action != Syntax.OS_MIGRATION_COMPARE_NIXOS {
        theme.error("`{action}` is not a jetos migration action", "The only migration action is `compare-nixos`.", "run `jet os migrate compare-nixos <host> --out <dir>`.")
        return 2
    }
    target :: parse_target_or_report(theme, rest.first().map(s -> s.as_str())) ?? return 2
    out_index :: rest.iter().position(arg -> arg == Syntax.OS_MIGRATION_FLAG_OUT) ?? {
        theme.error("NixOS comparison needs an output directory", "`--out <dir>` receives the proved NixOS image, boot proof, guest fact, and receipt.", "run `jet os migrate compare-nixos <host> --out <dir>`.")
        return 2
    }
    out :: rest.get(out_index + 1).filter(value -> !value.starts_with('-')) ?? {
        theme.error("NixOS comparison output directory is missing", "`--out` must be followed by one directory.", "run `jet os migrate compare-nixos <host> --out <dir>`.")
        return 2
    }
    if out_index != 1 || rest.len() != 3 {
        theme.error("NixOS comparison has unsupported arguments", "The migration action accepts one host and one `--out <dir>` argument.", "run `jet os migrate compare-nixos <host> --out <dir>`.")
        return 2
    }
    (plan, system) :: load_target(theme, &target) ?? return 2
    cmd_migrate_compare_nixos(theme, &plan.table, &system, OSPath.from(out), flags)
}
// Rust: crates/jetpack/src/JetOS/commands.rs:412
// Rust: crates/jetpack/src/JetOS/commands.rs:439
fn invoked_by_root_jet() -> Bool {
    // GATE #4483: nonLinux false is the original source arm, not a native fallback.
    if selected_os() != "linux" { return false }
    // GATE #4494: real env, procfs status and parent executable link.
    parent :: env.var(Syntax.ROOT_ENGINE_DISPATCH_PID_ENV) ?? return false
    parent :: parent.parse<U32>() ?? return false
    status :: fs.read_to_string(OSPath.from("/proc/self/status")) ?? return false
    actual_parent :: status.lines().find_map(line -> line.strip_prefix("PPid:")).and_then(value -> {
        trimmed := value.trim() // #4303
        trimmed.parse<U32>().ok()
    }) ?? return false
    if parent != actual_parent { return false }
    fs.read_link(OSPath.from("/proc/{parent}/exe")).ok()
        .and_then(path -> path.file_stem().map(name -> name == Syntax.BINARY_NAME)).unwrap_or(false)
}
// Rust: crates/jetpack/src/JetOS/commands.rs:443
pub fn cmd_image(theme: &Theme, args: &[String], flags: &JetOSFlags) -> I32 {
    target :: parse_target_or_report(theme, args.first().map(s -> s.as_str())) ?? return 2
    (plan, system) :: load_target(theme, &target) ?? return 2
    gen :: build_generation(theme, &plan, &system, flags, &target.config) ?? return 2
    disk :: flags.manual_disk.as_deref() ?? "guided-ext4"
    if write_installer_media(&gen, &system, disk) == {
        .Ok(path) -> if write_image_variant_artifacts(&gen, &system) == {
            .Ok(variant_proof) -> {
                theme.detail("wrote image variant proof {variant_proof.display()}")
                theme.ok("wrote jetos installer media proof {path.display()}")
                0
            }
            .Err(error) -> {
                theme.error("could not write jetos image variants", "writing image variant artifacts failed: {error}", "check permissions on the Jetpack root, or set JETPACK_ROOT.")
                2
            }
        }
        .Err(error) -> {
            theme.error("could not write the jetos installer media", "writing installer media artifacts failed: {error}", "check permissions on the Jetpack root, or set JETPACK_ROOT.")
            2
        }
    }
}
