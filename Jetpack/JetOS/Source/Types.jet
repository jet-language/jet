// JetOS owns these carriers; system/service/option plans remain the canonical
// EnvModel carriers.
JETOS_CACHYOS_KERNEL_PACKAGE: "cachyos-kernel"
JETOS_SYSTEMD_INIT_PACKAGE: "systemd"
JETOS_GNOME_DESKTOP_PACKAGES: [String]{"gdm", "gnome-session", "gnome-shell"}
JETOS_VM_TOOLS: [String]{"qemu-system-x86_64", "qemu-img", "xorriso", "limine", "sfdisk", "blockdev", "mkfs.ext4", "mkfs.vfat", "mmd", "mcopy", "zstd"}
JETOS_VM_GUEST_PROOF_MARKER: "JETOS_GUEST_PROOF:"
JETOS_VM_PROOF_TIMEOUT_MS: 300000

JetOSFlags: struct {
    fixtures: String?
    offline: Bool
    name: String?
    manual_disk: String?
    disk: String?
    json: Bool
    assume_yes: Bool
    // Exact Core Cargo build identity's one-shot trust approval.
    trust: Bool
    // Shared global --host selection, also consumed by import.
    host: String?
    // The real VM backend supplies default boot packages itself.
    real_tier: Bool
}

JetOSTarget: struct {
    config: String
    host: String
}

JetOSGeneration: struct {
    name: String
    host: String
    path: String
    created_at: Int
}

// The held lease and original identity are not flattened into metadata;
// realization/consumption owns their lifecycle.
JetOSRealizedPackage: struct {
    entry: StoreEntry
    lease: CacheLease
    original_out: String
    original_reference_text: String
    consumption_override: String?

    // The held lease remains authoritative: a durable member is consumed only
    // after the lease revalidates it.
    consumption_path: fn(self, path: String) -[FS, Env, Rand]> String IOError! {
        if self.consumption_override == .Val(root) {
            relative: store_path_strip_prefix(path, self.entry.out) ?? return Err(IOError.Other(IOContext{operation: .Read, resource: None, os_code: None, cause: Val("package member escapes realized output")}))
            return Ok(files.join(root, relative))
        }
        self.lease.validate()
        self.lease.output_relative(path)
        Ok(path)
    }

    // Provenance names durable provider output, never a process-scoped
    // consumption projection.
    original_output: fn(self) -> String Never! { self.original_out }
    original_reference: fn(self) -> String Never! { self.original_reference_text }
}

JetOSBootProfile: struct {
    loader: String
    kernel: String
    init: String
    initrd_modules: [String]

    to_dyn: fn(self) -> Dyn Never! {
        Dyn.Object([
            "loader": Dyn.Text(self.loader.copy()),
            "kernel": Dyn.Text(self.kernel.copy()),
            "init": Dyn.Text(self.init.copy()),
            "initrd_modules": pkg_json_texts(self.initrd_modules),
        ])
    }

    to_json: fn(self) -> String Never! { pkg_json_render(self.to_dyn()) }
}

JetOSOptionContender: struct {
    value: String
    tier: String
    priority: Int
    source_order: Int
    winner: Bool
}

JetOSResolvedOption: struct {
    key: String
    value: String
    tier: String
    priority: Int
    contenders: [JetOSOptionContender]

    // Field and contender order are stable.
    to_json: fn(self) -> String Never! {
        rows := [Dyn]{}
        loop contender in self.contenders {
            rows.push(Dyn.Object([
                "value": Dyn.Text(contender.value.copy()),
                "tier": Dyn.Text(contender.tier.copy()),
                "priority": Dyn.Int(contender.priority),
                "source_order": Dyn.Int(contender.source_order),
                "winner": Dyn.Bool(contender.winner),
            ]))
        }
        pkg_json_render(Dyn.Object([
            "key": Dyn.Text(self.key.copy()),
            "value": Dyn.Text(self.value.copy()),
            "tier": Dyn.Text(self.tier.copy()),
            "priority": Dyn.Int(self.priority),
            "contenders": Dyn.Array(rows),
        ]))
    }
}
