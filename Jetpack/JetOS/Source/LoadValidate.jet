// Resolve a `jet os` target to its Package, project the Package outputs, and
// select one checked System.
// The file-backed `config.jet` surface is retired, so a target always names
// a `package.jet`.

// The checked System outputs of one Package and that Package's semantic
// graph identity.
JetOSLoadedPlan: struct {
    graph_identity: String
    systems: [SystemPlan]
}

// `host` selects `system.<host>` in the current Package; `host@root` selects
// it in the Package at `root` (a directory or its `package.jet`).
jetos_parse_target: fn(theme: Theme, raw: String) -[IO, FS, Env, Time.Wait]> JetOSTarget? Never! {
    fix: "write `jet os plan laptop` or `jet os plan laptop@../machines`."
    if raw.trim() == "" {
        theme.error_coded("E0979", "`jet os` needs a host to apply", "a bare host selects `system.<host>` in ./package.jet; `host@root` selects an exact external root.", fix)
        return None
    }
    if raw.split_once(OS_HOST_SELECTOR) == .Val(halves) {
        if halves.before.trim() == "" {
            theme.error_coded("E0979", "`jet os` needs a host to apply", "`host@root` uses the text before `@` as the host name.", fix)
            return None
        }
        if halves.after.trim() == "" {
            theme.error_coded("E0979", "`jet os` target `{raw}` needs a root after `@`", "`host@root` uses the text after `@` as the external Package root.", fix)
            return None
        }
        config: if files.is_dir(halves.after) -> files.join(halves.after, PACKAGE_FILE) else -> halves.after
        return Val(JetOSTarget{config: config, host: halves.before})
    }
    Val(JetOSTarget{config: files.join(sys.current_dir() ?? ".", PACKAGE_FILE), host: raw})
}

// The target Package's projection and its System named by the target host.
jetos_load_target: fn(theme: Theme, target: JetOSTarget) -[IO, FS, Env, Time.Wait]> (plan: JetOSLoadedPlan, system: SystemPlan)? Never! {
    plan: jetos_load_plan(theme, target) ?? return None
    loop system in plan.systems {
        if system.name == target.host -> return Val((plan: plan, system: system))
    }
    names := loop system in plan.systems -> system.name
    names.sort()
    known: if names.len() == 0 -> "this Package defines no systems" else -> "available systems: {names.join(", ")}"
    theme.error_coded("E0980", "`{target.host}` is not a system in this Package", known, "declare a `System` output named `{target.host}`, or select one of the systems above.")
    None
}

jetos_load_plan: fn(theme: Theme, target: JetOSTarget) -[IO, FS, Env, Time.Wait]> JetOSLoadedPlan? Never! {
    missing_why: "`jet os` tried to load `{target.config}` for host `{target.host}`."
    missing_fix: "create package.jet, or pass an explicit root after the @."
    if files.basename(target.config) != PACKAGE_FILE || !files.is_file(target.config) {
        theme.error_coded("E0981", "the jetos package file does not exist", missing_why, missing_fix)
        return None
    }
    root: files.dirname(target.config)
    loaded: if PackageFacts.load(if root == "" -> "." else -> root) == {
        .Ok(found) -> found
        .Err(error) -> {
            theme.error("the Package graph is invalid", "{target.config} could not load package.jet: {error.message()}", "repair package.jet or its composed Config files, then run the command again.")
            return None
        }
    }
    facts: loaded ?? {
        theme.error_coded("E0981", "the jetos package file does not exist", missing_why, missing_fix)
        return None
    }
    projection: envmodel_project_package_outputs(facts) ?? {
        theme.error("the Package graph cannot project to JetOS", "package output projection failed: {err.text()}", "repair the named System or Fleet output, then run the command again.")
        return None
    }
    Val(JetOSLoadedPlan{graph_identity: projection.graph_identity, systems: projection.systems})
}
