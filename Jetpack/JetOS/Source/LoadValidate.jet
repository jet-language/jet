use jetpack.JetOS.Entry.[default_config_path]
use jetpack.JetOS.OptionsRendering.[user_names]
use jetpack.JetOS.Types.[JetOSTarget]
use jetpack.Output.[Theme]
use jetpack.Package.[PackageFacts]
use jetpack.[Syntax, Diagnostics]
use jet_env_model.ModuleEval.[evaluate_env, env_plan_from_package_outputs, project_package_outputs, EnvPlan, SystemPlan]
use std.[fs, env]

// Rust: crates/jetpack/src/JetOS/load_validate.rs:13
pub fn parse_target_or_report(theme: &Theme, raw: String?) -> JetOSTarget? {
    raw :: raw.unwrap_or("")
    trimmed := raw.trim() // #4303
    if trimmed.is_empty() {
        theme.error_coded("E0979", "`jet os` needs a host to apply", "D-JPK-REF1: a bare host selects `system.<host>` in ./config.jet; `host@root` selects an exact external root.", "write `jet os switch laptop` or `jet os switch laptop@../machines`.")
        return None
    }
    (host, root) :: raw.split_once(Syntax.OS_HOST_SELECTOR) ?? {
        return Val(JetOSTarget{config: config_for_root(default_config_path().parent().unwrap_or_else(() -> OSPath.from("."))), host: raw.to_string()})
    }
    host_trimmed := host.trim() // #4303
    if host_trimmed.is_empty() {
        theme.error_coded("E0979", "`jet os` needs a host to apply", "D-JPK-REF1: `host@root` uses the text before `@` as the host name.", "write `jet os switch laptop` or `jet os switch laptop@../machines`.")
        return None
    }
    root_trimmed := root.trim() // #4303
    if root_trimmed.is_empty() {
        theme.error_coded("E0979", "`jet os` target `{raw}` needs a root after `@`", "D-JPK-REF1: `host@root` uses the text after `@` as the external config root.", "write `jet os switch laptop` or `jet os switch laptop@../machines`.")
        return None
    }
    path :: OSPath.from(root)
    config :: if path.is_dir() -> config_for_root(&path) else -> path
    Val(JetOSTarget{config: config, host: host.to_string()})
}

// Rust: crates/jetpack/src/JetOS/load_validate.rs:64
fn config_for_root(root: &OSPath) -> OSPath {
    package :: root.join(Syntax.PACKAGE_FILE)
    if package.is_file() -> package else -> root.join(Syntax.CONFIG_FILE)
}

// Rust: crates/jetpack/src/JetOS/load_validate.rs:73
pub fn load_target(theme: &Theme, target: &JetOSTarget) -> (EnvPlan, SystemPlan)? {
    plan :: load_plan(theme, target) ?? return None
    system :: plan.systems.iter().find(s -> s.name == target.host).cloned() ?? {
        systems := plan.systems.iter().map(s -> s.name.clone()).collect::<[String]>()
        systems.sort()
        known :: if systems.is_empty() -> "this config defines no systems" else -> "available systems: {systems.join(", ")}"
        theme.error_coded("E0980", "`{target.host}` is not a system in this config", known, "define `system.<host>: { ... }`, or select one of the systems above.")
        return None
    }
    if !validate_system_options(theme, &system) { return None }
    Val((^plan, ^system))
}

// Rust: crates/jetpack/src/JetOS/load_validate.rs:97
pub fn load_user_generation_target(theme: &Theme, target: &JetOSTarget, user: String) -> (EnvPlan, SystemPlan)? {
    plan :: load_plan(theme, target) ?? return None
    system :: plan.systems.iter().find(s -> user_names(s).iter().any(name -> name == user)).cloned() ?? {
        users := plan.systems.iter().flat_map(user_names).collect::<[String]>()
        users.sort()
        users.dedup()
        known :: if users.is_empty() -> "this config defines no user generations" else -> "available users: {users.join(", ")}"
        theme.error("`{user}` is not a user generation in this config", known, "define `user.<name>.*` or `users.<name>.*` options on a system, then rerun `jetos user plan <name>`.")
        return None
    }
    if !validate_system_options(theme, &system) { return None }
    Val((^plan, ^system))
}

// Rust: crates/jetpack/src/JetOS/load_validate.rs:130
pub fn load_plan(theme: &Theme, target: &JetOSTarget) -> EnvPlan? {
    if target.config.file_name().and_then(name -> name.to_str()) == Val(Syntax.PACKAGE_FILE) { return load_package_plan(theme, target) }
    src :: if fs.read_to_string(&target.config) == {
        .Ok(src) -> src
        .Err(_) -> {
            theme.error_coded("E0981", "the jetos config file does not exist", "`jet os` tried to load `{target.config.display()}` for host `{target.host}`.", "create the config file, or pass an explicit root after the `@`.")
            return None
        }
    }
    source_base :: env.var_os("JETOS_STUDIO_SOURCE_BASE").map(OSPath.from)
    base :: source_base.as_deref().unwrap_or_else(() -> target.config.parent().unwrap_or_else(() -> OSPath.from(".")))
    plan :: if evaluate_env(src, base) == {
        .Ok(plan) -> plan
        .Err(d) -> {
            eprint(Diagnostics.render_all(target.config.to_string_lossy(), src, &[d]))
            return None
        }
    }
    Val(^plan)
}

// Rust: crates/jetpack/src/JetOS/load_validate.rs:171
fn load_package_plan(theme: &Theme, target: &JetOSTarget) -> EnvPlan? {
    root :: target.config.parent().filter(path -> !path.as_os_str().is_empty()).unwrap_or_else(() -> OSPath.from("."))
    facts :: if PackageFacts.load(root) == {
        .Val(.Ok(facts)) -> facts
        .Val(.Err(error)) -> {
            theme.error("the Package graph is invalid", "{target.config.display()} could not load package.jet: {error}", "repair package.jet or its composed Config files, then run the command again.")
            return None
        }
        .None -> {
            theme.error_coded("E0981", "the jetos package file does not exist", "jet os tried to load {target.config.display()} for host {target.host}.", "create package.jet, or pass an explicit root after the @.")
            return None
        }
    }
    projection :: if project_package_outputs(&facts) == {
        .Ok(projection) -> projection
        .Err(error) -> {
            theme.error("the Package graph cannot project to JetOS", "package output projection failed: {error}", "repair the named System or Fleet output, then run the command again.")
            return None
        }
    }
    Val(env_plan_from_package_outputs(Syntax.PACKAGE_FILE, ^projection))
}

// Rust: crates/jetpack/src/JetOS/load_validate.rs:221
pub fn validate_system_options(theme: &Theme, system: &SystemPlan) -> Bool {
    if bad :: system.options.iter().find(o -> {
        ns :: o.key.split('.').next().unwrap_or("")
        !Syntax.OS_OPTION_NAMESPACES.contains(ns)
    }) {
        theme.error_coded("E1277", "`{bad.key}` uses a retired jetos option namespace", "D-JPK-OSNS1=B, D-JOS-SYSTEMTREE1=A, and Epoch 7 jetos surface decisions: jetos option keys start with full-word namespaces such as `filesystem`, `network`, `packages`, `services`, `users`, `user`, `apps`, `performance`, `storage`, `theme`, `workload`, `hardware`, `groups`, `secrets`, `boot`, `kernel`, `init`, `health`, or `deploy`.", "rename the option namespace, for example `net.hostName` becomes `network.hostName`.")
        return false
    }
    true
}
