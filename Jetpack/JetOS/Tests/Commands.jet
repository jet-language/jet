// The `jet os plan` JSON: the plan and service projections before
// realization, as `jet os plan` prints it.

#Test("JetOS plan JSON keeps package refs, services, options and the graph identity") {
    system: SystemPlan{
        name: "devhost",
        target: "linux.x64",
        packages: [Pkg]{Pkg.new("jetpack", "ripgrep"), Pkg.new("", "./tools/x")},
        services: [ServicePlan]{ServicePlan{name: "ssh", enable: true, extra: [ServicePlanExtra]{ServicePlanExtra{key: "ports", value: "[22]"}}}},
        options: [OptionPlan]{OptionPlan{key: "network.hostName", value: "devhost"}},
    }
    assert_eq(jetos_render_plan_json(system, "abc"), "{{\"host\":\"devhost\",\"target\":\"linux.x64\",\"graph_identity\":\"abc\",\"boot\":{{\"loader\":\"Limine\",\"kernel\":\"CachyOS\",\"init\":\"/sbin/init\",\"initrd_modules\":[\"virtio_blk\",\"ext4\"]}},\"packages\":[{{\"name\":\"ripgrep\",\"source\":\"jetpack\",\"ref\":\"ripgrep@jetpack\"}},{{\"name\":\"./tools/x\",\"source\":\"\",\"ref\":\"./tools/x\"}}],\"closure\":[],\"services\":[{{\"name\":\"ssh\",\"enable\":true,\"fields\":[{{\"key\":\"ports\",\"value\":\"[22]\"}}]}}],\"options\":[{{\"key\":\"network.hostName\",\"value\":\"devhost\"}}]}}")
}

#Test("JetOS usage names exactly the built verbs") {
    assert_eq(jetos_usage(), "jet os check|plan <host>|host@root")
    loop verb in OS_BUILT_VERBS -> assert(OS_VERBS.contains(verb), verb)
}
