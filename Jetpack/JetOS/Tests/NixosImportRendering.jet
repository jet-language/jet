// Pure renderer/scanner acceptance for nixos_import.rs:19-50,474-605,744-751.
// Fixtures are EXPECTED PLAN facts, not replacement JSON/flake/provenance readers.
// Integration gates intentionally unchanged outside this leaf:
// tests/jetpack_jetos.rs:113-185 real CLI/facts reader/output writer journey;
// :189-264 real live evaluator/flake.lock provenance journey; :451-484 lift CLI
// and its stderr facts-only assertion. Draft exec text proves no service migration.

fn jetos_nixos_import_test_empty() -> JetOSNixosImportPlan Never! {
    JetOSNixosImportPlan{
        source: "", mode: "facts-only-scan", host: "", target: "linux.x64",
        nixpkgs_ref: "nixpkgs-unstable@nixpkgs",
        extra_sources: [(label: String, upstream: String)]{}, packages: [String]{},
        sourced_packages: [(label: String, packages: [String])]{},
        omitted_packages: [String]{}, services: [String]{},
        options: [(key: String, value: String)]{}, users: [JetOSNixosImportUser]{},
        modules: [String]{}, home_modules: [String]{}, omissions: [String]{}
    }
}

// tests/jetpack_jetos.rs:117-140 after import_plan_from_json:238-303.
// Dotted package is omitted by that reader; homeManager becomes an OPTION.
fn jetos_nixos_import_test_semantic() -> JetOSNixosImportPlan Never! {
    plan := jetos_nixos_import_test_empty()
    plan.source = "/imports/semantic"
    plan.mode = "semantic-facts"
    plan.host = "halcyon"
    plan.nixpkgs_ref = "NixOS/nixpkgs/nixos-24.05@github"
    plan.packages = [String]{"git", "ripgrep"}
    plan.omitted_packages = [String]{"jetbrains.idea-ultimate"}
    plan.services = [String]{"openssh", "pipewire"}
    plan.options = [(key: String, value: String)]{
        (key: "network.hostName", value: "\"halcyon\""),
        (key: "services.openssh.enable", value: "true"),
        (key: "boot.loader", value: "\".Limine\""),
        (key: "user.nate.homeManager", value: "true")
    }
    plan.users = [JetOSNixosImportUser]{JetOSNixosImportUser{
        name: "nate", home: Val("/home/nate"), groups: [String]{"wheel"},
        packages: [String]{"neovim", "ghostty"},
        sourced_packages: [(label: String, packages: [String])]{},
        omitted_packages: [String]{}, home_manager: true
    }}
    plan.modules = [String]{"./nix/hosts/halcyon.nix"}
    plan.home_modules = [String]{"./home/nate.nix"}
    plan.omissions = [String]{
        "programs.firefox.profiles need profile-specific Canvas editing",
        "package `jetbrains.idea-ultimate` uses a Nix attr path JetOS cannot encode yet"
    }
    plan
}

#Test("Nixos import semantic facts original assertions and complete artifact bytes") {
    plan :: jetos_nixos_import_test_semantic()
    config :: jetos_nixos_import_render_config(plan)
    // Every original renderer-relevant assertion :166-184 remains intact.
    assert(config.contains("system.halcyon"))
    assert(config.contains("nixpkgs: NixOS/nixpkgs/nixos-24.05@github"))
    assert(config.contains("packages: [nixpkgs.git, nixpkgs.ripgrep]"))
    assert(config.contains("openssh: {{ enable: true"))
    assert(config.contains("user.nate.packages: [nixpkgs.neovim, nixpkgs.ghostty]"))
    assert(config.contains("user.nate.homeManager: true"))
    audit :: jetos_nixos_import_render_audit(plan)
    assert(audit.contains("\"mode\":\"semantic-facts\""))
    assert(audit.contains("jetbrains.idea-ultimate"))
    assert(audit.contains("programs.firefox.profiles"))
    assert_eq(config, "// Generated by `jet os import` from /imports/semantic\n// Review jetos-import-audit.json before switching this host.\nmodule halcyon {{\n    sources: {{\n        nixpkgs: NixOS/nixpkgs/nixos-24.05@github,\n    }}\n    system.halcyon: {{\n        target: linux.x64,\n        packages: [nixpkgs.git, nixpkgs.ripgrep],\n        services: {{\n            openssh: {{ enable: true, exec: \"/usr/bin/env true\" }},\n            pipewire: {{ enable: true, exec: \"/usr/bin/env true\" }},\n        }},\n        options: [\n            network.hostName: \"halcyon\",\n            services.openssh.enable: true,\n            boot.loader: \".Limine\",\n            user.nate.homeManager: true,\n            users.nate.normal: true,\n            users.nate.home: \"/home/nate\",\n            groups.wheel.members: [users.nate],\n            user.nate.packages: [nixpkgs.neovim, nixpkgs.ghostty],\n        ],\n    }}\n}}\n")
    assert_eq(audit, "{{\n  \"kind\":\"jetos.import.audit\",\n  \"mode\":\"semantic-facts\",\n  \"source\":\"/imports/semantic\",\n  \"host\":\"halcyon\",\n  \"packages\":[\"git\",\"ripgrep\"],\n  \"sourced_package_inputs\":[],\n  \"omitted_packages\":[\"jetbrains.idea-ultimate\"],\n  \"services\":[\"openssh\",\"pipewire\"],\n  \"users\":[\"nate\"],\n  \"flake_parts_modules\":[\"./nix/hosts/halcyon.nix\"],\n  \"home_manager_modules\":[\"./home/nate.nix\"],\n  \"omissions\":[\"programs.firefox.profiles need profile-specific Canvas editing\",\"package `jetbrains.idea-ultimate` uses a Nix attr path JetOS cannot encode yet\"]\n}}\n")
}

#Test("Nixos import empty artifact bytes and host fallback") {
    plan :: jetos_nixos_import_test_empty()
    assert_eq(jetos_nixos_import_render_config(plan), "// Generated by `jet os import` from \n// Review jetos-import-audit.json before switching this host.\nmodule host {{\n    sources: {{\n        nixpkgs: nixpkgs-unstable@nixpkgs,\n    }}\n    system.host: {{\n        target: linux.x64,\n        packages: [],\n        services: {{\n        }},\n        options: [\n        ],\n    }}\n}}\n")
    assert_eq(jetos_nixos_import_render_audit(plan), "{{\n  \"kind\":\"jetos.import.audit\",\n  \"mode\":\"facts-only-scan\",\n  \"source\":\"\",\n  \"host\":\"\",\n  \"packages\":[],\n  \"sourced_package_inputs\":[],\n  \"omitted_packages\":[],\n  \"services\":[],\n  \"users\":[],\n  \"flake_parts_modules\":[],\n  \"home_manager_modules\":[],\n  \"omissions\":[]\n}}\n")
    loop invalid in ([String]{"", "9host", "雪", "a.b", "a b", "a/b"}) -> assert_eq(jetos_nixos_import_ident_or_host(invalid), "host")
    assert_eq(jetos_nixos_import_ident_or_host("work-station"), "work_station")
    assert_eq(jetos_nixos_import_ident_or_host("-"), "_")
    assert_eq(jetos_nixos_import_ident_or_host("_A9"), "_A9")
}

#Test("Nixos import host scanner exact marker precedence and first occurrence") {
    cases :: [(text: String, expected: String?)]{
        (text: "", expected: None),
        (text: "nixosConfigurations", expected: None),
        (text: "nixosConfigurations={{ laptop = {{}}; }};", expected: None),
        (text: "nixosConfigurations = {{ laptop = {{}}; }};", expected: Val("laptop")),
        (text: "雪 nixosConfigurations.work-station = {{}};", expected: Val("work_station")),
        (text: "nixosConfigurations.\n\t{{{{{{_A09-x.foo", expected: Val("_A09_x")),
        (text: "nixosConfigurations.9host = {{}};", expected: Val("9host")),
        (text: "nixosConfigurations.- = {{}};", expected: Val("_")),
        (text: "nixosConfigurations.höst", expected: Val("h")),
        (text: "nixosConfigurations.雪", expected: None),
        (text: "nixosConfigurations. = {{}}", expected: None),
        (text: "nixosConfigurations.", expected: None),
        (text: "nixosConfigurations = {{", expected: None),
        (text: "nixosConfigurations.{{{{ {{host", expected: None),
        (text: "nixosConfigurations = {{ first = {{}}; }}; nixosConfigurations.second = {{}};", expected: Val("second")),
        (text: "nixosConfigurations.雪 nixosConfigurations.good nixosConfigurations = {{ fallback = {{}}; }};", expected: Val("fallback")),
        (text: "nixosConfigurations.雪 nixosConfigurations.good", expected: None),
        (text: "nixosConfigurations = {{ 雪 nixosConfigurations = {{ later = {{}}; }};", expected: None),
        (text: "nixosConfigurations. {{{{{{ unicode-space", expected: Val("unicode_space"))
    }
    loop case in cases -> assert_eq(jetos_nixos_import_scan_first_host(case.text), case.expected)
}

#Test("Nixos import lift original header and system assertions remain leaf checks") {
    // Original flake :455-461 yields laptop through the real scanner.
    text :: "{{\n  inputs.flake-parts.url = \"github:hercules-ci/flake-parts\";\n  inputs.home-manager.url = \"github:nix-community/home-manager\";\n  outputs = {{ self, nixpkgs, ... }}: {{\n    nixosConfigurations = {{ laptop = nixpkgs.lib.nixosSystem {{}}; }};\n  }};\n}}"
    plan := jetos_nixos_import_test_empty()
    plan.source = "/imports/lift"
    plan.host = jetos_nixos_import_scan_first_host(text) ?? panic("original lift host")
    plan.options = [(key: String, value: String)]{(key: "network.hostName", value: "\"host\"")}
    config :: jetos_nixos_import_render_config(plan)
    assert(config.contains("Generated by `jet os import`")) // original :481
    assert(config.contains("system.laptop")) // original :482
    // Original :483 is a CLI stderr facts-only gate, not a renderer output.
}

#Test("Nixos import original live provenance output assertions use recovered plan facts") {
    // Expected recovered package/source facts from :189-264, not a producer.
    plan := jetos_nixos_import_test_empty()
    plan.source = "/imports/provenance"
    plan.mode = "semantic-eval"
    plan.host = "halcyon"
    plan.nixpkgs_ref = "NixOS/nixpkgs/fef9403a3e4d31b0a23f0bacebbec52c248fbb51@github"
    plan.extra_sources = [(label: String, upstream: String)]{(label: "zen_beta", upstream: "0xc000022070/zen-browser-flake/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@github")}
    plan.packages = [String]{"git"}
    plan.sourced_packages = [(label: String, packages: [String])]{(label: "zen_beta", packages: [String]{"zen-browser"})}
    config :: jetos_nixos_import_render_config(plan)
    assert(config.contains("zen_beta: 0xc000022070/zen-browser-flake/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@github"))
    assert(config.contains("zen_beta.zen-browser") || config.contains("packages: [nixpkgs.git, zen_beta.zen-browser]"))
    assert(!config.contains("package-provenance import will recover it"))
    assert_eq(jetos_nixos_import_render_package_groups(plan.packages, plan.sourced_packages), "[nixpkgs.git, zen_beta.zen-browser]")
}

#Test("Nixos import package groups preserve all order duplicates and source text") {
    sourced :: [(label: String, packages: [String])]{
        (label: "z", packages: [String]{"b", "a", "b"}),
        (label: "z", packages: [String]{}),
        (label: "a.raw", packages: [String]{"x.y"}),
        (label: "z", packages: [String]{"c"})
    }
    assert_eq(jetos_nixos_import_render_package_groups([String]{"git", "git", "_x"}, sourced), "[nixpkgs.git, nixpkgs.git, nixpkgs._x, z.b, z.a, z.b, a.raw.x.y, z.c]")
    assert_eq(jetos_nixos_import_render_package_groups([String]{}, sourced), "[z.b, z.a, z.b, a.raw.x.y, z.c]")
    assert_eq(jetos_nixos_import_render_package_groups([String]{}, [(label: String, packages: [String])]{(label: "empty", packages: [String]{})}), "[]")
}

#Test("Nixos import exact edge config preserves raw options sources and user provenance") {
    plan := jetos_nixos_import_test_empty()
    plan.source = "draft\nsource"
    plan.host = "edge-host"
    plan.target = "target.raw"
    plan.nixpkgs_ref = "raw@source"
    plan.extra_sources = [(label: String, upstream: String)]{
        (label: "z.raw", upstream: "first@github"), (label: "z.raw", upstream: "second@github")
    }
    plan.packages = [String]{"git", "git"}
    plan.sourced_packages = [(label: String, packages: [String])]{(label: "z.raw", packages: [String]{"x-y", "x-y"})}
    plan.services = [String]{"_svc9", "9bad", "bad-name", "bad.dot", "é", "", "_svc9"}
    plan.options = [(key: String, value: String)]{
        (key: "raw.key", value: "[.Raw, \"x\"]"), (key: "raw.key", value: "false")
    }
    plan.users = [JetOSNixosImportUser]{
        JetOSNixosImportUser{name: "nate", home: Val("/home/\"nate\"\n雪"), groups: [String]{"wheel", "bad-group", "9bad", "", "雪", "wheel", "_g9"}, packages: [String]{}, sourced_packages: [(label: String, packages: [String])]{(label: "z", packages: [String]{"only", "only"})}, omitted_packages: [String]{"unrendered"}, home_manager: true},
        JetOSNixosImportUser{name: "raw.name", home: None, groups: [String]{}, packages: [String]{}, sourced_packages: [(label: String, packages: [String])]{}, omitted_packages: [String]{}, home_manager: false},
        JetOSNixosImportUser{name: "empty", home: Val(""), groups: [String]{}, packages: [String]{}, sourced_packages: [(label: String, packages: [String])]{(label: "z", packages: [String]{})}, omitted_packages: [String]{}, home_manager: false}
    }
    assert_eq(jetos_nixos_import_render_config(plan), "// Generated by `jet os import` from draft\nsource\n// Review jetos-import-audit.json before switching this host.\nmodule edge_host {{\n    sources: {{\n        nixpkgs: raw@source,\n        z.raw: first@github,\n        z.raw: second@github,\n    }}\n    system.edge_host: {{\n        target: target.raw,\n        packages: [nixpkgs.git, nixpkgs.git, z.raw.x-y, z.raw.x-y],\n        services: {{\n            _svc9: {{ enable: true, exec: \"/usr/bin/env true\" }},\n            _svc9: {{ enable: true, exec: \"/usr/bin/env true\" }},\n        }},\n        options: [\n            raw.key: [.Raw, \"x\"],\n            raw.key: false,\n            users.nate.normal: true,\n            users.nate.home: \"/home/\\\"nate\\\"\\n雪\",\n            groups.wheel.members: [users.nate],\n            groups.wheel.members: [users.nate],\n            groups._g9.members: [users.nate],\n            user.nate.packages: [z.only, z.only],\n            users.raw.name.normal: true,\n            users.empty.normal: true,\n            users.empty.home: \"\",\n            user.empty.packages: [],\n        ],\n    }}\n}}\n")
}

#Test("Nixos import exact audit fields escaping repeated source labels and system-only packages") {
    plan := jetos_nixos_import_test_empty()
    plan.source = "p\"\\\n\t雪"
    plan.mode = "m\n"
    plan.host = "bad-host\""
    plan.packages = [String]{"git", "git"}
    plan.sourced_packages = [(label: String, packages: [String])]{
        (label: "z\"", packages: [String]{"p\n", "p\n"}),
        (label: "empty", packages: [String]{}),
        (label: "z\"", packages: [String]{"tail"})
    }
    plan.omitted_packages = [String]{"omit\t", "omit\t"}
    plan.services = [String]{"bad-name", "é"}
    plan.users = [JetOSNixosImportUser]{
        JetOSNixosImportUser{name: "u\"", home: None, groups: [String]{}, packages: [String]{"USER-NOT-SYSTEM"}, sourced_packages: [(label: String, packages: [String])]{(label: "user-source", packages: [String]{"USER-SOURCE-NOT-SYSTEM"})}, omitted_packages: [String]{"USER-OMISSION-NOT-SYSTEM"}, home_manager: true},
        JetOSNixosImportUser{name: "u\"", home: Val("unused"), groups: [String]{}, packages: [String]{}, sourced_packages: [(label: String, packages: [String])]{}, omitted_packages: [String]{}, home_manager: false}
    }
    plan.modules = [String]{"./m\\", "./m\\"}
    plan.home_modules = [String]{"./h\n"}
    plan.omissions = [String]{"line\n\"quoted\""}
    assert_eq(jetos_nixos_import_render_audit(plan), "{{\n  \"kind\":\"jetos.import.audit\",\n  \"mode\":\"m\\n\",\n  \"source\":\"p\\\"\\\\\\n\\t雪\",\n  \"host\":\"bad-host\\\"\",\n  \"packages\":[\"git\",\"git\",\"p\\n\",\"p\\n\",\"tail\"],\n  \"sourced_package_inputs\":[\"z\\\"\",\"empty\",\"z\\\"\"],\n  \"omitted_packages\":[\"omit\\t\",\"omit\\t\"],\n  \"services\":[\"bad-name\",\"é\"],\n  \"users\":[\"u\\\"\",\"u\\\"\"],\n  \"flake_parts_modules\":[\"./m\\\\\",\"./m\\\\\"],\n  \"home_manager_modules\":[\"./h\\n\"],\n  \"omissions\":[\"line\\n\\\"quoted\\\"\"]\n}}\n")
    // No leading comma with only sourced packages; labels from empty groups stay.
    plan.packages = [String]{}
    audit :: jetos_nixos_import_render_audit(plan)
    assert(audit.contains("\"packages\":[\"p\\n\",\"p\\n\",\"tail\"]"))
    assert(audit.contains("\"sourced_package_inputs\":[\"z\\\"\",\"empty\",\"z\\\"\"]"))
}
