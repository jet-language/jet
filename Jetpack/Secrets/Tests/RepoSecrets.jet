// Claims ported from crates/jetpack/src/Secrets.rs #[cfg(test)] for the
// local age v1 port. Claims that run the real age tools check the
// fail-closed "not installed" error instead when `age`/`age-keygen` are not
// on PATH; the U7 proof runs them with nixpkgs#age on PATH. The Rust
// bridge-helper hex claims have no counterpart (there is no helper), and
// the Windows replacement claim has no Jet platform here.
use jetpack_trust.[TrustError]
use jetpack_secrets.[
    TrustSecretPair, trust_secrets_add_recipient, trust_secrets_decode_pairs,
    trust_secrets_encode_pairs, trust_secrets_get, trust_secrets_identity_path,
    trust_secrets_import_dotenv, trust_secrets_keygen, trust_secrets_list,
    trust_secrets_list_recipients, trust_secrets_parse_dotenv, trust_secrets_recipients_path,
    trust_secrets_runtime_plan_path, trust_secrets_set, trust_secrets_store_age,
    trust_secrets_store_path, trust_secrets_unset, trust_secrets_validation_identity,
    trust_secrets_write_private, trust_secrets_write_public, trust_secrets_write_runtime_plan,
]
use jet_env_model.[SecretDeclaration, SecretSpec]
use core.files as files
use core.process as process
use core.sys as sys

// The age specification's example recipient; recipient bookkeeping never
// parses it.
SECRETS_TEST_RECIPIENT :: "age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9aqmcac8p"

// A fresh scratch directory that outlives this call (a TempDir would be
// removed when it drops here). Labels are unique per claim.
fn trust_secrets_test_dir(label: String) -> String {
    dir :: files.join(sys.temp_dir(), "jet_secrets_{label}_{sys.pid()}")
    if files.exists(dir) -> files.remove_all(dir) ?? panic("clear scratch directory: {err}")
    files.create_dir_all(dir) ?? panic("scratch directory: {err}")
    dir
}

// A scratch project with its own keys directory.
fn trust_secrets_test_enter(label: String) -> String {
    dir :: trust_secrets_test_dir(label)
    keys :: files.join(dir, "keys")
    files.create_dir_all(keys) ?? panic("keys directory")
    sys.set("JET_KEYS_DIR", keys)
    dir
}

fn trust_secrets_test_leave() {
    _ :: sys.unset("JET_KEYS_DIR") ?? panic("unset JET_KEYS_DIR")
}

// A proof run sets JETPACK_TEST_REQUIRE_AGE=1 so the crypto claims cannot
// quietly take the absent-tool branch.
fn trust_secrets_test_has_age() -> Bool {
    found :: process.which("age") != None && process.which("age-keygen") != None
    if !found && (sys.get("JETPACK_TEST_REQUIRE_AGE") ?? "") == "1" -> panic("JETPACK_TEST_REQUIRE_AGE=1 but `age` and `age-keygen` are not both on PATH")
    found
}

fn trust_secrets_test_error(result: Bool TrustError!) -> String {
    if result == {
        .Ok(_) -> panic("expected a secrets error")
        .Err(error) -> error.message()
    }
}

fn trust_secrets_test_unit_error(result: TrustError!) -> String {
    if result == {
        .Ok(_) -> panic("expected a secrets error")
        .Err(error) -> error.message()
    }
}

// No `.{store}.*.stage` file is left beside the store.
fn trust_secrets_test_no_stage(dir: String) {
    entries :: files.list_dir(files.join(dir, ".jet")) ?? panic("list .jet")
    loop entry in entries {
        assert(!entry.name.ends_with(".stage"), "a ciphertext stage was left behind: {entry.name}")
    }
}

#Test("identity path honors the keys directory override") {
    dir :: files.join(trust_secrets_test_dir("keys_override"), "jet_secrets_test_keys_dir")
    sys.set("JET_KEYS_DIR", dir)
    assert_eq(trust_secrets_identity_path(), files.join(dir, "secrets.identity"))
    trust_secrets_test_leave()
}

#Test("pairs wire format round trips and decodes exactly") {
    pairs :: [TrustSecretPair]{TrustSecretPair{name: "a", value: "1"}, TrustSecretPair{name: "db_password", value: "hunter2 ü"}, TrustSecretPair{name: "empty", value: ""}}
    encoded :: trust_secrets_encode_pairs(pairs) ?? panic("encode")
    assert_eq(encoded[0..<4], [U8]{U8{3}, U8{0}, U8{0}, U8{0}})
    decoded :: trust_secrets_decode_pairs(encoded) ?? panic("decode")
    assert_eq(decoded, pairs)
    assert_eq(trust_secrets_decode_pairs(trust_secrets_encode_pairs([TrustSecretPair]{}) ?? panic("encode empty")) ?? panic("decode empty"), [TrustSecretPair]{})
    trailing := encoded.copy()
    &trailing.push(U8{0})
    assert(trust_secrets_decode_pairs(trailing) == None, "trailing bytes are corrupt")
    assert(trust_secrets_decode_pairs(encoded[0..<(encoded.len() - 1)]) == None, "a truncated value is corrupt")
    assert(trust_secrets_decode_pairs([U8]{U8{1}, U8{0}}) == None, "a truncated count is corrupt")
}

#Test("private atomic write creates the identity with restricted mode") {
    dir :: trust_secrets_test_dir("private_write")
    path :: files.join(dir, "secrets.identity")
    trust_secrets_write_private(path, "AGE-SECRET-KEY-1TEST".bytes()) ?? panic("private write: {err.message()}")
    assert_eq(files.read(path) ?? panic("read identity"), "AGE-SECRET-KEY-1TEST")
    if sys.is_unix() {
        info :: files.stat(path) ?? panic("stat identity")
        assert((info.mode).bit_and(0o777) == 0o600, "private identity must be created with restrictive permissions")
    }
    trust_secrets_write_private(path, "AGE-SECRET-KEY-1NEXT".bytes()) ?? panic("private replace: {err.message()}")
    assert_eq(files.read(path) ?? panic("read replaced identity"), "AGE-SECRET-KEY-1NEXT")
}

#Test("atomic write replaces an existing target repeatedly") {
    dir :: trust_secrets_test_dir("atomic_replace")
    path :: files.join(files.join(dir, ".jet"), "secrets.age")
    loop index in 0..<5 {
        trust_secrets_write_public(path, "generation {index}".bytes()) ?? panic("atomic write {index}")
        assert_eq(files.read(path) ?? panic("read {index}"), "generation {index}")
    }
    entries :: files.list_dir(files.join(dir, ".jet")) ?? panic("list .jet")
    assert_eq(entries.len(), 1)
    assert_eq(entries[0].name, "secrets.age")
}

#Test("a missing age tool fails closed and names the tool") {
    dir :: trust_secrets_test_enter("missing_tool")
    previous :: sys.get("PATH") ?? ""
    empty :: files.join(dir, "empty-path")
    files.create_dir_all(empty) ?? panic("empty PATH directory")
    sys.set("PATH", empty)
    keygen_error :: if trust_secrets_keygen(false) == {
        .Ok(_) -> ""
        .Err(error) -> error.message()
    }
    assert(trust_secrets_add_recipient(dir, SECRETS_TEST_RECIPIENT) ?? panic("add recipient: {err.message()}"))
    set_error :: trust_secrets_test_unit_error(trust_secrets_set(dir, "db_password", "hunter2"))
    sys.set("PATH", previous)
    assert(keygen_error.contains("`age-keygen` is not installed"), "keygen without age-keygen must fail: {keygen_error}")
    assert(!files.exists(trust_secrets_identity_path()), "no identity without the tool")
    assert(set_error.contains("`age` is not installed"), "set without age must fail: {set_error}")
    assert(!files.exists(trust_secrets_store_path(dir)), "no store without the tool")
    trust_secrets_test_no_stage(dir)
    trust_secrets_test_leave()
}

#Test("keygen writes a private identity and refuses to overwrite it") {
    _ :: trust_secrets_test_enter("keygen")
    if !trust_secrets_test_has_age() {
        if trust_secrets_keygen(false) == {
            .Ok(_) -> panic("keygen without age-keygen must fail")
            .Err(error) -> assert(error.message().contains("not installed"), error.message())
        }
        trust_secrets_test_leave()
        return
    }
    generated :: trust_secrets_keygen(false) ?? panic("keygen: {err.message()}")
    assert(generated.recipient.starts_with("age1"), generated.recipient)
    assert_eq(generated.path, trust_secrets_identity_path())
    identity :: files.read(generated.path) ?? panic("read identity")
    assert(identity.starts_with("AGE-SECRET-KEY-1"), "the identity file holds only the secret key")
    if sys.is_unix() {
        info :: files.stat(generated.path) ?? panic("stat identity")
        assert((info.mode).bit_and(0o777) == 0o600, "private identity must be created with restrictive permissions")
    }
    if trust_secrets_keygen(false) == {
        .Ok(_) -> panic("a second keygen without --force must refuse")
        .Err(error) -> assert(error.message().contains("already exists"), error.message())
    }
    forced :: trust_secrets_keygen(true) ?? panic("forced keygen")
    assert(forced.recipient != generated.recipient, "--force generates a new key")
    trust_secrets_test_leave()
}

#Test("recipients add is idempotent and lists") {
    dir :: trust_secrets_test_enter("recipients")
    assert(trust_secrets_add_recipient(dir, "  {SECRETS_TEST_RECIPIENT}\n") ?? panic("add: {err.message()}"))
    assert(!(trust_secrets_add_recipient(dir, SECRETS_TEST_RECIPIENT) ?? panic("add again: {err.message()}")), "idempotent")
    assert_eq(trust_secrets_list_recipients(dir) ?? panic("list: {err.message()}"), [String]{SECRETS_TEST_RECIPIENT})
    // Comments and blank lines are skipped; a file without a final newline gains one.
    files.write(trust_secrets_recipients_path(dir), "# team\n\n{SECRETS_TEST_RECIPIENT}") ?? panic("hand-edit recipients")
    assert(trust_secrets_add_recipient(dir, "age1second") ?? panic("add second: {err.message()}"))
    assert_eq(files.read(trust_secrets_recipients_path(dir)) ?? panic("read recipients"), "# team\n\n{SECRETS_TEST_RECIPIENT}\nage1second\n")
    assert_eq(trust_secrets_list_recipients(dir) ?? panic("list two: {err.message()}"), [String]{SECRETS_TEST_RECIPIENT, "age1second"})
    trust_secrets_test_leave()
}

#Test("recipient lock failure is not already present") {
    dir :: trust_secrets_test_enter("lock_failure")
    files.create_dir_all(files.join(dir, ".jet")) ?? panic(".jet directory")
    files.write(files.join(dir, ".jet/.locks"), "not a directory") ?? panic("block the lock directory")
    error :: trust_secrets_test_error(trust_secrets_add_recipient(dir, SECRETS_TEST_RECIPIENT))
    assert(error.contains("couldn't lock"), error)
    assert(!files.exists(trust_secrets_recipients_path(dir)))
    store_error :: trust_secrets_test_unit_error(trust_secrets_set(dir, "db_password", "hunter2"))
    assert(store_error.contains("couldn't lock secrets store"), store_error)
    trust_secrets_test_leave()
}

#Test("recipient write failure is not success") {
    dir :: trust_secrets_test_enter("write_failure")
    files.create_dir_all(trust_secrets_recipients_path(dir)) ?? panic("recipients directory")
    assert(trust_secrets_add_recipient(dir, SECRETS_TEST_RECIPIENT) == .Err(_))
    trust_secrets_test_leave()
}

#Test("non-file secret inputs are errors not absence") {
    dir :: trust_secrets_test_enter("nonfile")
    files.create_dir_all(trust_secrets_recipients_path(dir)) ?? panic("recipients directory")
    if trust_secrets_list_recipients(dir) == {
        .Ok(_) -> panic("a directory recipients file must be an error")
        .Err(error) -> assert(error.message().contains("is not a regular file"), error.message())
    }
    files.remove_dir(trust_secrets_recipients_path(dir)) ?? panic("remove recipients directory")
    files.create_dir_all(trust_secrets_store_path(dir)) ?? panic("store directory")
    if trust_secrets_validation_identity(dir, [SecretSpec]{}, None) == {
        .Ok(_) -> panic("a directory store must be an error")
        .Err(error) -> assert(error.message().contains("not a regular file"), error.message())
    }
    if trust_secrets_list(dir) == {
        .Ok(_) -> panic("a directory store must not list as empty")
        .Err(error) -> assert(error.message().contains("is not a regular file"), error.message())
    }
    trust_secrets_test_leave()
}

#Test("writes need a recipient and reads need the local identity") {
    dir :: trust_secrets_test_enter("preconditions")
    message :: trust_secrets_test_unit_error(trust_secrets_set(dir, "db_password", "hunter2"))
    assert(message.contains("no recipients declared"), message)
    assert(!files.exists(trust_secrets_store_path(dir)))
    files.create_dir_all(files.join(dir, ".jet")) ?? panic(".jet directory")
    files.write(trust_secrets_store_path(dir), "ciphertext") ?? panic("write store")
    if trust_secrets_get(dir, "db_password") == {
        .Ok(_) -> panic("a store without a local identity must not read")
        .Err(error) -> assert(error.message().contains("no local secrets identity"), error.message())
    }
    trust_secrets_test_leave()
}

#Test("crypto round trip through the age tools") {
    dir :: trust_secrets_test_enter("round_trip")
    if !trust_secrets_test_has_age() {
        assert(trust_secrets_add_recipient(dir, SECRETS_TEST_RECIPIENT) ?? panic("add: {err.message()}"))
        message :: trust_secrets_test_unit_error(trust_secrets_set(dir, "db_password", "hunter2"))
        assert(message.contains("`age` is not installed"), message)
        trust_secrets_test_leave()
        return
    }
    recipient :: (trust_secrets_keygen(true) ?? panic("keygen: {err.message()}")).recipient
    assert(trust_secrets_add_recipient(dir, recipient) ?? panic("add: {err.message()}"))
    trust_secrets_set(dir, "db_password", "hunter2") ?? panic("set: {err.message()}")
    trust_secrets_set(dir, "api_key", "abc 123") ?? panic("set second")
    assert_eq(trust_secrets_get(dir, "db_password") ?? panic("get"), "hunter2")
    ciphertext :: files.read_bytes(trust_secrets_store_path(dir)) ?? panic("read ciphertext")
    assert((String.from_bytes(ciphertext[0..<21]) ?? panic("age header")) == "age-encryption.org/v1", "the committed store is age v1 ciphertext")
    trust_secrets_test_no_stage(dir)
    // An update keeps the order; a missing entry is None, not an error.
    trust_secrets_set(dir, "db_password", "correct horse") ?? panic("update")
    assert_eq(trust_secrets_list(dir) ?? panic("list: {err.message()}"), [String]{"db_password", "api_key"})
    assert_eq(trust_secrets_get(dir, "db_password") ?? panic("get updated"), "correct horse")
    if trust_secrets_get(dir, "no_such_key") == {
        .Val(_) -> panic("a missing entry must be None")
        .None -> {}
        .Err(error) -> panic("get missing: {error.message()}")
    }
    assert(trust_secrets_unset(dir, "db_password") ?? panic("unset"))
    assert(!(trust_secrets_unset(dir, "db_password") ?? panic("unset again")))
    assert_eq(trust_secrets_list(dir) ?? panic("list after unset"), [String]{"api_key"})
    _ :: trust_secrets_store_age(dir) ?? panic("a present store has an age")
    source :: files.join(dir, "import.env")
    files.write(source, "B_TOKEN=two\nA_TOKEN='one'\napi_key=replaced\n") ?? panic("write .env")
    assert_eq(trust_secrets_import_dotenv(dir, source) ?? panic("import"), [String]{"A_TOKEN", "B_TOKEN", "api_key"})
    assert_eq(trust_secrets_list(dir) ?? panic("list after import"), [String]{"api_key", "A_TOKEN", "B_TOKEN"})
    assert_eq(trust_secrets_get(dir, "api_key") ?? panic("get imported"), "replaced")
    trust_secrets_test_no_stage(dir)
    // Another identity cannot decrypt the store.
    _ :: trust_secrets_keygen(true) ?? panic("replace identity")
    assert(trust_secrets_get(dir, "api_key") == .Err(_), "a foreign identity must not decrypt")
    trust_secrets_test_leave()
}

#Test("an absent store lists empty, not an error") {
    dir :: trust_secrets_test_enter("absent")
    assert_eq(trust_secrets_list(dir) ?? panic("list: {err.message()}"), [String]{})
    if trust_secrets_get(dir, "db_password") == {
        .Val(_) -> panic("an absent store has no entries")
        .None -> {}
        .Err(error) -> panic("get: {error.message()}")
    }
    if trust_secrets_store_age(dir) == {
        .Val(_) -> panic("an absent store has no age")
        .None -> {}
        .Err(error) -> panic("store age: {error.message()}")
    }
    trust_secrets_test_leave()
}

#Test("validation identity binds the declarations and is secret free") {
    dir :: trust_secrets_test_dir("validation")
    sys.set("JET_KEYS_DIR", files.join(dir, "keys"))
    stored :: [SecretSpec]{SecretSpec.stored("db_password")}
    absent :: trust_secrets_validation_identity(dir, stored, Val("dev")) ?? panic("identity without a store")
    again :: trust_secrets_validation_identity(dir, stored, Val("dev")) ?? panic("identity again")
    other_environment :: trust_secrets_validation_identity(dir, stored, Val("prod")) ?? panic("identity for prod")
    // `??` already panics if any of the three is None.
    assert_eq(absent, again)
    assert(absent != other_environment)
    // A present store without a local identity has nothing to validate with.
    files.create_dir_all(files.join(dir, ".jet")) ?? panic(".jet directory")
    files.write(trust_secrets_store_path(dir), "ciphertext") ?? panic("write store")
    if trust_secrets_validation_identity(dir, stored, Val("dev")) == {
        .Val(_) -> panic("a store without a local key has no validation identity")
        .None -> {}
        .Err(error) -> panic("identity without a key: {error.message()}")
    }
    trust_secrets_test_leave()
}

#Test("runtime plan records only compositions and rejects control characters") {
    dir :: trust_secrets_test_dir("runtime_plan")
    compose :: SecretSpec{name: "database_url", declaration: SecretDeclaration.Compose{template: "postgres://{{user}}:{{password}}@db", from: [String]{"password", "user", "password"}}}
    trust_secrets_write_runtime_plan(dir, [SecretSpec]{SecretSpec.stored("token"), compose}) ?? panic("write plan")
    text :: files.read(trust_secrets_runtime_plan_path(dir)) ?? panic("read plan")
    assert_eq(text, "JSEC1\ndatabase_url\tpassword,user\tpostgres://{{user}}:{{password}}@db\n")
    tabbed :: SecretSpec{name: "bad\tname", declaration: SecretDeclaration.Compose{template: "x", from: [String]{"a"}}}
    if trust_secrets_write_runtime_plan(dir, [SecretSpec]{tabbed}) == {
        .Ok(_) -> panic("a control character must be refused")
        .Err(error) -> assert(error.message().contains("contains a control character"), error.message())
    }
}

#Test("dotenv import parsing accepts exports and quotes and rejects bad lines") {
    dir :: trust_secrets_test_dir("dotenv")
    source :: files.join(dir, ".env")
    files.write(source, "# comment\n\nexport API_KEY=\"abc 123\"\nDB_PASSWORD='hunter2'\nPLAIN = value \n") ?? panic("write .env")
    values :: trust_secrets_parse_dotenv(source) ?? panic("parse: {err.message()}")
    assert_eq(values["API_KEY"], "abc 123")
    assert_eq(values["DB_PASSWORD"], "hunter2")
    assert_eq(values["PLAIN"], "value")
    files.write(source, "OK=1\nnot an assignment\n") ?? panic("write bad .env")
    if trust_secrets_parse_dotenv(source) == {
        .Ok(_) -> panic("a line without = must be refused")
        .Err(error) -> assert_eq(error.message(), "line 2 has no '='")
    }
    files.write(source, "1BAD=x\n") ?? panic("write bad name")
    if trust_secrets_parse_dotenv(source) == {
        .Ok(_) -> panic("an invalid name must be refused")
        .Err(error) -> assert_eq(error.message(), "line 1 has an invalid variable name")
    }
}
