// Repository secrets: a local age v1 port over the `age`/`age-keygen` tools until core.crypto.vault
// owns the store (#3668); the compiler does not depend on it.
name: "jetpack_secrets"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../../Compiler/JetFoundation,
    jetpack_foundation: ../Foundation,
    jet_pkg_model: ../PackageModel,
    jet_env_model: ../EnvModel,
    jetpack_trust: ../Trust,
}
