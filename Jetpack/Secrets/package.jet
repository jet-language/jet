// Repository secrets (age-style vault recipients and values). It waits on the core.crypto.vault
// recipient API; the compiler does not depend on it.
name: "jetpack_secrets"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../../Compiler/JetFoundation,
    jetpack_foundation: ../Foundation,
    jet_pkg_model: ../PackageModel,
    jet_env_model: ../EnvModel,
    jetpack_trust: ../Trust,
}
