// U13 encrypted repository secrets, ported from jetpack Secrets.rs as a
// local age v1 port until `core.crypto.vault`
// owns the repository store (#3668, which deletes this port).
//
// The store layout is the Rust one: `.jet/secrets.age` (age v1 ciphertext,
// committed), `.jet/secrets-recipients` (committed plaintext, one `age1...`
// key per line), and the local identity `$JET_KEYS_DIR/secrets.identity` or
// `~/.jet/keys/secrets.identity` (mode 0600, never committed). The
// plaintext is the Rust pairs codec. The Rust bridge helper is replaced by
// the real `age`/`age-keygen` tools on PATH; a missing tool is a
// TrustError naming it. Plaintext only crosses pipes: decryption streams
// `age` stdout, encryption feeds stdin and lets `age -o` write ciphertext to
// a stage beside the store, which is then published atomically. A typed
// vault store (`JVLT` plaintext) fails closed: only the vault can read it.
//
// Store read-modify-write commands hold the Jetpack `secrets` lock scope.
use jetpack_foundation.[CONFIG_DEFAULT_DIR, env_runtime_project_lock, foundation_write_file_nofollow_at_root]
use jet_env_model.[SecretSpec, envmodel_sorted_keys]
use jet_pkg_model.[pkg_bytes_text, pkg_sha256_hex]
use core.files as files
use core.process as process
use core.sys as sys
use core.time as time
use jetpack_trust.[
    TRUST_APOSTROPHE, TRUST_CARRIAGE_RETURN, TRUST_EQUALS, TRUST_NEWLINE, TRUST_QUOTE, TRUST_TAB,
    TRUST_UNDERSCORE, TrustError, trust_text_is_alphanumeric, trust_text_lines,
    trust_text_split_first,
]

SECRETS_STORE_FILE :: "secrets.age"
SECRETS_RECIPIENTS_FILE :: "secrets-recipients"
SECRETS_IDENTITY_FILE :: "secrets.identity"
SECRETS_RUNTIME_PLAN_FILE :: "secrets-plan"
SECRETS_RUNTIME_PLAN_MAGIC :: "JSEC1"
SECRETS_LOCK_SCOPE :: "secrets"
SECRETS_VALIDATION_DOMAIN :: "jetpack-secret-validation-v1"
SECRETS_AGE_TOOL :: "age"
SECRETS_AGE_KEYGEN_TOOL :: "age-keygen"
SECRETS_IDENTITY_PREFIX :: "AGE-SECRET-KEY-1"
SECRETS_PUBLIC_KEY_COMMENT :: "# public key: "
SECRETS_TYPED_VAULT_MAGIC :: "JVLT"
SECRETS_U32_MAX :: 4294967295

// One decrypted store entry; the store keeps insertion order.
struct TrustSecretPair {
    name: String
    value: String
}

// `.jet/secrets.age`: the encrypted store, project-relative and committed.
fn trust_secrets_store_path(project: String) -> String Never! {
    files.join(files.join(project, CONFIG_DEFAULT_DIR), SECRETS_STORE_FILE)
}

// `.jet/secrets-recipients`: one `age1...` public key per line.
fn trust_secrets_recipients_path(project: String) -> String Never! {
    files.join(files.join(project, CONFIG_DEFAULT_DIR), SECRETS_RECIPIENTS_FILE)
}

// The non-secret runtime composition plan: output names, sorted input names,
// and the declared template. Composed values are never written here.
fn trust_secrets_runtime_plan_path(project: String) -> String Never! {
    files.join(files.join(project, CONFIG_DEFAULT_DIR), SECRETS_RUNTIME_PLAN_FILE)
}

// The local decrypt identity: `$JET_KEYS_DIR/secrets.identity` when set and
// non-empty, else `~/.jet/keys/secrets.identity`. Never project-relative.
fn trust_secrets_identity_path() -[Env]> String {
    override :: sys.get("JET_KEYS_DIR") ?? ""
    dir :: if override != "" -> override else -> trust_secrets_default_keys_dir()
    files.join(dir, SECRETS_IDENTITY_FILE)
}

fn trust_secrets_default_keys_dir() -[Env]> String {
    home :: sys.get("HOME") ?? sys.get("USERPROFILE") ?? "."
    files.join(files.join(home, ".jet"), "keys")
}

fn trust_secrets_write_runtime_plan(project: String, specs: [SecretSpec]) TrustError! -[FS]> {
    lines := [String]{"{SECRETS_RUNTIME_PLAN_MAGIC}\n"}
    loop spec in specs {
        if spec.declaration == {
            .Compose(template, from) -> {
                inputs :: trust_secrets_sorted_unique(from)
                controlled := trust_secrets_has_plan_control(spec.name) || trust_secrets_has_plan_control(template)
                loop input in inputs {
                    if trust_secrets_has_plan_control(input) -> controlled = true
                }
                if controlled -> return Err(TrustError.Secret("secret composition plan for {spec.name} contains a control character"))
                &lines.push("{spec.name}\t{inputs.join(",")}\t{template}\n")
            }
            .Stored -> {}
        }
    }
    body :: lines.join("").bytes()
    path :: trust_secrets_runtime_plan_path(project)
    if files.read_bytes(path) == .Ok(existing) {
        if existing == body -> return
    }
    parent :: files.dirname(path)
    files.create_dir_all(parent) ?? return Err(TrustError.Secret("couldn't create `{parent}`: {err}"))
    files.write_atomic(path, body) ?? return Err(TrustError.Secret("couldn't finalize `{path}`: {err}"))
}

// A `\n`, `\r`, or `\t` would break the tab-separated plan line.
fn trust_secrets_has_plan_control(value: String) -> Bool Never! {
    loop byte in value.bytes() {
        code :: Int.from_u8(byte)
        if code == TRUST_NEWLINE || code == TRUST_CARRIAGE_RETURN || code == TRUST_TAB -> return true
    }
    false
}

// A secret-free identity for validation inputs: the declaration shape, the
// active environment, the ciphertext, the recipient file, and the local
// identity. It never decrypts, so activation can reuse a successful
// validation when none of those changed. None when there is no local
// identity to validate with.
fn trust_secrets_validation_identity(project: String, specs: [SecretSpec], active_environment: String?) -[FS, Env]> String? TrustError! {
    canonical := [U8]{}
    &canonical.extend(SECRETS_VALIDATION_DOMAIN.bytes())
    &canonical.push(U8{0})
    trust_secrets_append_field(&canonical, active_environment ?? "dynamic")
    fingerprints := [String]{}
    loop spec in specs {
        template :: if spec.declaration == {
            .Compose(text, _) -> pkg_sha256_hex(text.bytes())
            .Stored -> ""
        }
        &fingerprints.push("{spec.trust_fingerprint()}|{template}")
    }
    unique :: trust_secrets_sorted_unique(fingerprints)
    loop fingerprint in unique -> trust_secrets_append_field(&canonical, fingerprint)

    store :: trust_secrets_store_path(project)
    store_info :: if files.stat(store) == {
        .Ok(info) -> info
        .Err(error) -> {
            if error == {
                .NotFound(_) -> {
                    trust_secrets_append_field(&canonical, "store-absent")
                    return Ok(Val(pkg_sha256_hex(canonical)))
                }
                else -> return Err(TrustError.Secret("couldn't inspect `{store}`: {error}"))
            }
        }
    }
    if !store_info.is_file || store_info.is_symlink -> return Err(TrustError.Secret("secrets store `{store}` is not a regular file"))
    ciphertext :: files.read_bytes(store) ?? return Err(TrustError.Secret("couldn't read `{store}`: {err}"))
    trust_secrets_append_field(&canonical, "store-present")
    trust_secrets_append_field(&canonical, "{store_info.size}")
    trust_secrets_append_field(&canonical, pkg_sha256_hex(ciphertext))

    identity :: trust_secrets_identity_path()
    identity_bytes :: if files.read_bytes(identity) == {
        .Ok(bytes) -> bytes
        .Err(error) -> {
            if error == {
                .NotFound(_) -> return Ok(None)
                else -> return Err(TrustError.Secret("couldn't read secrets identity `{identity}`: {error}"))
            }
        }
    }
    trust_secrets_append_field(&canonical, pkg_sha256_hex(identity_bytes))
    recipients :: trust_secrets_recipients_path(project)
    if files.read_bytes(recipients) == {
        .Ok(bytes) -> trust_secrets_append_field(&canonical, pkg_sha256_hex(bytes))
        .Err(error) -> {
            if error == {
                .NotFound(_) -> trust_secrets_append_field(&canonical, "recipients-absent")
                else -> return Err(TrustError.Secret("couldn't read `{recipients}`: {error}"))
            }
        }
    }
    Ok(Val(pkg_sha256_hex(canonical)))
}

// One length-prefixed field: the byte length as a little-endian u64, then
// the bytes.
fn trust_secrets_append_field(canonical: &[U8], field: String) {
    raw :: field.bytes()
    length := raw.len()
    loop _ in 0..<8 {
        &canonical.push(U8.from_int(length % 256) ?? U8{0})
        length = length /% 256
    }
    &canonical.extend(raw)
}

// Rust `sort` then `dedup`.
fn trust_secrets_sorted_unique(values: [String]) -> [String] Never! {
    sorted := values
    &sorted.sort()
    unique := [String]{}
    loop value in sorted {
        if unique.len() > 0 && unique[unique.len() - 1] == value -> next
        &unique.push(value)
    }
    unique
}

// How long ago the store was last written; None when there is no store.
fn trust_secrets_store_age(project: String) -[FS, Time]> Duration? TrustError! {
    path :: trust_secrets_store_path(project)
    info :: if files.stat(path) == {
        .Ok(found) -> found
        .Err(error) -> {
            if error == {
                .NotFound(_) -> return Ok(None)
                else -> return Err(TrustError.Secret("couldn't inspect `{path}`: {error}"))
            }
        }
    }
    now_ms :: time.unix_ns() /% 1000000
    modified_ms :: info.modified.to_unix_ms()
    age_ms :: if now_ms > modified_ms -> now_ms - modified_ms else -> 0
    Ok(Val(time.duration_ms(age_ms)))
}

// Generate a fresh identity/recipient pair: where the identity was written
// and the public recipient teammates add. Refuses to overwrite an existing
// identity unless `force`: that would orphan everything encrypted to it.
fn trust_secrets_keygen(force: Bool) -[FS, Env, Exec, Time, Time.Wait]> (path: String, recipient: String) TrustError! {
    path :: trust_secrets_identity_path()
    if files.is_file(path) && !force {
        return Err(TrustError.Secret("a secrets identity already exists at `{path}` — pass `--force` if you're sure (this orphans anything encrypted to the old key)"))
    }
    output :: trust_secrets_run_age(SECRETS_AGE_KEYGEN_TOOL, [String]{}, None)
    text :: String.from_bytes(output) ?? return Err(TrustError.Secret("keygen produced no identity"))
    identity := ""
    recipient := ""
    loop line in trust_text_lines(text) {
        trimmed :: line.trim()
        if trimmed.starts_with(SECRETS_IDENTITY_PREFIX) && identity == "" -> identity = trimmed
        if trimmed.starts_with(SECRETS_PUBLIC_KEY_COMMENT) && recipient == "" -> recipient = trimmed.removeprefix(SECRETS_PUBLIC_KEY_COMMENT).trim()
    }
    if identity == "" -> return Err(TrustError.Secret("keygen produced no identity"))
    if recipient == "" -> return Err(TrustError.Secret("keygen produced no recipient"))
    parent :: files.dirname(path)
    if parent != "" {
        files.create_dir_all(parent) ?? return Err(TrustError.Secret("couldn't create keys directory: {err}"))
    }
    trust_secrets_write_private(path, identity.bytes()) ?? return Err(TrustError.Secret("couldn't write identity: {err.message()}"))
    Ok((path: path, recipient: recipient))
}

// Rust atomic_write_private: an owner-only (0o600) stage, fsync, rename,
// and parent fsync, never following a link at the destination.
fn trust_secrets_write_private(path: String, bytes: [U8]) TrustError! -[FS, Env, Time]> {
    parent :: files.dirname(path)
    root :: if parent == "" -> "." else -> parent
    foundation_write_file_nofollow_at_root(root, files.basename(path), bytes, None) ?? return Err(TrustError.Secret("{err.error}"))
}

// Rust atomic_write: stage, fsync, rename, parent fsync.
fn trust_secrets_write_public(path: String, bytes: [U8]) TrustError! -[FS]> {
    parent :: files.dirname(path)
    if parent != "" {
        files.create_dir_all(parent) ?? return Err(TrustError.Secret("couldn't create `{parent}`: {err}"))
    }
    files.write_atomic(path, bytes) ?? return Err(TrustError.Secret("couldn't finalize `{path}`: {err}"))
}

// `jetpack secrets recipients add <age1...>`: false when already present;
// lock and store failures stay errors.
fn trust_secrets_add_recipient(project: String, recipient: String) -[FS, Env, Time]> Bool TrustError! {
    _guard :: env_runtime_project_lock(project, SECRETS_LOCK_SCOPE) ?? return Err(TrustError.Secret("couldn't lock secrets recipients: {err}"))
    path :: trust_secrets_recipients_path(project)
    wanted :: recipient.trim()
    existing := trust_secrets_read_text_or_absent(path)
    loop line in trust_text_lines(existing) {
        trimmed :: line.trim()
        if !trimmed.starts_with("#") && trimmed == wanted -> return Ok(false)
    }
    if existing != "" && !existing.ends_with("\n") -> existing = "{existing}\n"
    trust_secrets_write_public(path, "{existing}{wanted}\n".bytes())
    Ok(true)
}

// `jetpack secrets recipients list`: every recipient, `#` and blank lines
// skipped.
fn trust_secrets_list_recipients(project: String) -[FS]> [String] TrustError! {
    contents :: trust_secrets_read_text_or_absent(trust_secrets_recipients_path(project))
    recipients := [String]{}
    loop line in trust_text_lines(contents) {
        trimmed :: line.trim()
        if trimmed == "" || trimmed.starts_with("#") -> next
        &recipients.push(trimmed)
    }
    Ok(recipients)
}

// An absent file is empty; anything but a regular file is an error.
fn trust_secrets_read_text_or_absent(path: String) -[FS]> String TrustError! {
    info :: if files.stat(path) == {
        .Ok(found) -> found
        .Err(error) -> {
            if error == {
                .NotFound(_) -> return Ok("")
                else -> return Err(TrustError.Secret("couldn't inspect `{path}`: {error}"))
            }
        }
    }
    if info.is_symlink || !info.is_file -> return Err(TrustError.Secret("`{path}` is not a regular file"))
    text :: files.read(path) ?? return Err(TrustError.Secret("couldn't read `{path}`: {err}"))
    Ok(text)
}

// Read and decrypt the whole store. An absent store is an empty one (a
// fresh project); the first `set` creates it. A present store with no local
// identity, or one that fails to decrypt, is an error.
fn trust_secrets_read_store(project: String) -[FS, Env, Exec, Time.Wait]> [TrustSecretPair] TrustError! {
    path :: trust_secrets_store_path(project)
    info :: if files.stat(path) == {
        .Ok(found) -> found
        .Err(error) -> {
            if error == {
                .NotFound(_) -> return Ok([TrustSecretPair]{})
                else -> return Err(TrustError.Secret("couldn't inspect `{path}`: {error}"))
            }
        }
    }
    if info.is_symlink || !info.is_file -> return Err(TrustError.Secret("secrets store `{path}` is not a regular file"))
    identity :: trust_secrets_identity_path()
    if files.stat(identity) == .Err(error) {
        if error == {
            .NotFound(_) -> return Err(TrustError.Secret("no local secrets identity at `{identity}` — run `jetpack secrets keygen`"))
            else -> return Err(TrustError.Secret("couldn't read secrets identity `{identity}`: {error}"))
        }
    }
    plaintext :: trust_secrets_run_age(SECRETS_AGE_TOOL, [String]{"--decrypt", "--identity", identity, "--", path}, None)
    magic :: SECRETS_TYPED_VAULT_MAGIC.bytes()
    if plaintext.len() >= magic.len() && plaintext[0..<magic.len()] == magic {
        return Err(TrustError.Secret("secrets store `{path}` is a typed vault store, which only `core.crypto.vault` can open"))
    }
    pairs :: trust_secrets_decode_pairs(plaintext) ?? return Err(TrustError.Secret("the decrypted store is corrupt"))
    Ok(pairs)
}

// Encrypt `pairs` to every declared recipient and publish the store
// atomically. The caller holds the `secrets` lock.
fn trust_secrets_write_store(project: String, pairs: [TrustSecretPair]) TrustError! -[FS, Env, Exec, Time, Time.Wait]> {
    recipients :: trust_secrets_list_recipients(project)
    if recipients.len() == 0 -> return Err(TrustError.Secret("no recipients declared — run `jetpack secrets recipients add <age1...>` first (generate one with `jetpack secrets keygen`)"))
    plaintext :: trust_secrets_encode_pairs(pairs)
    path :: trust_secrets_store_path(project)
    parent :: files.dirname(path)
    files.create_dir_all(parent) ?? return Err(TrustError.Secret("couldn't create `.jet`: {err}"))
    stage :: files.join(parent, ".{SECRETS_STORE_FILE}.{sys.pid()}-{time.unix_ns()}.stage")
    args := [String]{"--encrypt"}
    loop recipient in recipients {
        &args.push("--recipient")
        &args.push(recipient)
    }
    &args.push("--output")
    &args.push(stage)
    if trust_secrets_run_age(SECRETS_AGE_TOOL, args, Val(plaintext)) == .Err(error) {
        files.remove(stage).drop("a failed encryption may leave no stage")
        return Err(error)
    }
    if trust_secrets_publish_stage(stage, path) == .Err(error) {
        files.remove(stage).drop("the stage holds ciphertext only; removal is best-effort")
        return Err(error)
    }
    files.remove(stage).drop("the stage holds ciphertext only; removal is best-effort")
}

fn trust_secrets_publish_stage(stage: String, path: String) TrustError! -[FS]> {
    ciphertext :: files.read_bytes(stage) ?? return Err(TrustError.Secret("couldn't read the encrypted stage `{stage}`: {err}"))
    trust_secrets_write_public(path, ciphertext)
}

// `jetpack secrets set <name> <value>`: upsert one entry and re-encrypt the
// store to every recipient.
fn trust_secrets_set(project: String, name: String, value: String) TrustError! -[FS, Env, Exec, Time, Time.Wait]> {
    _guard :: env_runtime_project_lock(project, SECRETS_LOCK_SCOPE) ?? return Err(TrustError.Secret("couldn't lock secrets store: {err}"))
    pairs := trust_secrets_read_store(project)
    trust_secrets_upsert(&pairs, name, value)
    trust_secrets_write_store(project, pairs)
}

fn trust_secrets_upsert(pairs: &[TrustSecretPair], name: String, value: String) {
    loop index in 0..<pairs.len() {
        if pairs[index].name == name {
            pairs[index].value = value
            return
        }
    }
    &pairs.push(TrustSecretPair{name, value})
}

// `jetpack secrets unset <name>`: false is "no such entry" (E1263 at the CLI).
fn trust_secrets_unset(project: String, name: String) -[FS, Env, Exec, Time, Time.Wait]> Bool TrustError! {
    _guard :: env_runtime_project_lock(project, SECRETS_LOCK_SCOPE) ?? return Err(TrustError.Secret("couldn't lock secrets store: {err}"))
    pairs :: trust_secrets_read_store(project)
    kept := [TrustSecretPair]{}
    loop pair in pairs {
        if pair.name != name -> &kept.push(pair)
    }
    if kept.len() == pairs.len() -> return Ok(false)
    trust_secrets_write_store(project, kept)
    Ok(true)
}

// `jetpack secrets list`: declared names in store order, never values. An
// absent store is an empty one.
fn trust_secrets_list(project: String) -[FS, Env, Exec, Time.Wait]> [String] TrustError! {
    pairs :: trust_secrets_read_store(project)
    names := [String]{}
    loop pair in pairs -> &names.push(pair.name)
    Ok(names)
}

// `jetpack secrets get <name>`: None is "no such entry" (E1263 at the CLI).
fn trust_secrets_get(project: String, name: String) -[FS, Env, Exec, Time.Wait]> String? TrustError! {
    pairs :: trust_secrets_read_store(project)
    loop pair in pairs {
        if pair.name == name -> return Ok(Val(pair.value))
    }
    Ok(None)
}

// `jetpack secrets import <.env>`: upsert every assignment of a dotenv file
// under one lock and one re-encryption. The source is only read; the caller
// prints the cleanup advice after the encrypted write succeeds. Returns the
// imported names in byte order.
fn trust_secrets_import_dotenv(project: String, source: String) -[FS, Env, Exec, Time, Time.Wait]> [String] TrustError! {
    values :: trust_secrets_parse_dotenv(source)
    names :: envmodel_sorted_keys(values)
    if names.len() == 0 -> return Ok(names)
    _guard :: env_runtime_project_lock(project, SECRETS_LOCK_SCOPE) ?? return Err(TrustError.Secret("couldn't lock secrets store: {err}"))
    pairs := trust_secrets_read_store(project)
    loop name in names -> trust_secrets_upsert(&pairs, name, values[name])
    trust_secrets_write_store(project, pairs)
    Ok(names)
}

// Rust ensure_bridge_helper, for the age v1 tools: the tool on PATH, or a
// TrustError naming it.
fn trust_secrets_age_tool(tool: String) -[FS, Env]> String TrustError! {
    found :: process.which(tool) ?? return Err(TrustError.Secret("`{tool}` is not installed or not on PATH; repository secrets need the age v1 tools (https://age-encryption.org)"))
    Ok(found)
}

// One age tool run: its stdout bytes, or a TrustError carrying its stderr.
// `input` is written and closed before stdout is drained, so a run with
// input must send its real output elsewhere (`--output`).
fn trust_secrets_run_age(tool: String, args: [String], input: [U8]?) -[FS, Env, Exec, Time.Wait]> [U8] TrustError! {
    executable :: trust_secrets_age_tool(tool)
    argv := [String]{executable}
    &argv.extend(args)
    spec := process.cmd(argv).stdout(.Stream).stderr(.Capture)
    if input != None -> spec = spec.stdin(.Stream)
    child := spec.spawn() ?? return Err(TrustError.Secret("couldn't run `{tool}`: {err}"))
    if input == .Val(bytes) {
        if child.stdin.write_all(bytes) == .Err(error) {
            trust_secrets_abandon_age(&child)
            return Err(TrustError.Secret("couldn't write to `{tool}`: {error}"))
        }
        child.stdin.close()
    }
    output := [U8]{}
    loop {
        chunk :: child.stdout.read(65536) ?? {
            trust_secrets_abandon_age(&child)
            return Err(TrustError.Secret("couldn't read from `{tool}`: {err}"))
        }
        if chunk.len() == 0 -> break
        &output.extend(chunk)
    }
    receipt :: child.wait() ?? return Err(TrustError.Secret("couldn't wait for `{tool}`: {err}"))
    if !receipt.success -> return Err(TrustError.Secret("`{tool}` failed: {receipt.errors.trim()}"))
    Ok(output)
}

// Rust `child.kill(); child.wait()` after an abandoned exchange.
fn trust_secrets_abandon_age(child: &ProcessChild) -[Exec, Time.Wait]> {
    child.kill().drop("the abandoned age child may already have exited")
    _ :: child.wait() ?? return
}

// The Rust pairs codec: a u32 LE count, then per pair a u32 LE length and
// the name bytes, a u32 LE length and the value bytes.
fn trust_secrets_encode_pairs(pairs: [TrustSecretPair]) -> [U8] TrustError! {
    out := [U8]{}
    trust_secrets_push_u32(&out, pairs.len())
    loop pair in pairs {
        name :: pair.name.bytes()
        value :: pair.value.bytes()
        if name.len() > SECRETS_U32_MAX || value.len() > SECRETS_U32_MAX -> return Err(TrustError.Secret("secret `{pair.name}` is too large for the store"))
        trust_secrets_push_u32(&out, name.len())
        &out.extend(name)
        trust_secrets_push_u32(&out, value.len())
        &out.extend(value)
    }
    Ok(out)
}

fn trust_secrets_push_u32(out: &[U8], value: Int) {
    remaining := value
    loop _ in 0..<4 {
        &out.push(U8.from_int(remaining % 256) ?? U8{0})
        remaining = remaining /% 256
    }
}

// Exact decoding: a truncated field, invalid UTF-8 or trailing bytes is None.
fn trust_secrets_decode_pairs(bytes: [U8]) -> [TrustSecretPair]? Never! {
    at := 0
    count :: trust_secrets_u32_at(bytes, at) ?? return None
    at += 4
    pairs := [TrustSecretPair]{}
    loop _ in 0..<count {
        name_len :: trust_secrets_u32_at(bytes, at) ?? return None
        at += 4
        if bytes.len() - at < name_len -> return None
        name :: String.from_bytes(bytes[at..<(at + name_len)]) ?? return None
        at += name_len
        value_len :: trust_secrets_u32_at(bytes, at) ?? return None
        at += 4
        if bytes.len() - at < value_len -> return None
        value :: String.from_bytes(bytes[at..<(at + value_len)]) ?? return None
        at += value_len
        &pairs.push(TrustSecretPair{name, value})
    }
    if at != bytes.len() -> return None
    Val(pairs)
}

fn trust_secrets_u32_at(bytes: [U8], at: Int) -> Int? Never! {
    if bytes.len() - at < 4 -> return None
    value := 0
    loop index in 0..<4 -> value = value * 256 + Int.from_u8(bytes[at + 3 - index])
    Val(value)
}

// Dotenv assignments: blank and `#` lines skipped, an `export ` prefix
// accepted, one matching pair of surrounding quotes removed. A later
// assignment of the same name wins.
fn trust_secrets_parse_dotenv(path: String) -[FS]> [String: String] TrustError! {
    text :: files.read(path) ?? return Err(TrustError.Secret("{err}"))
    values := [String: String]{}
    number := 0
    loop raw_line in trust_text_lines(text) {
        number += 1
        trimmed :: raw_line.trim()
        if trimmed == "" || trimmed.starts_with("#") -> next
        line :: if trimmed.starts_with("export ") -> trimmed.removeprefix("export ") else -> trimmed
        parts :: trust_text_split_first(line, TRUST_EQUALS) ?? return Err(TrustError.Secret("line {number} has no '='"))
        name :: parts.before.trim()
        if !trust_secrets_is_variable_name(name) -> return Err(TrustError.Secret("line {number} has an invalid variable name"))
        value := parts.after.trim()
        raw :: value.bytes()
        if raw.len() >= 2 {
            first :: Int.from_u8(raw[0])
            last :: Int.from_u8(raw[raw.len() - 1])
            if first == last && (first == TRUST_QUOTE || first == TRUST_APOSTROPHE) -> value = pkg_bytes_text(raw, 1, raw.len() - 1)
        }
        values[name] = value
    }
    Ok(values)
}

// `[A-Za-z_][A-Za-z0-9_]*`.
fn trust_secrets_is_variable_name(name: String) -> Bool Never! {
    raw :: name.bytes()
    if raw.len() == 0 -> return false
    first :: Int.from_u8(raw[0])
    if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == TRUST_UNDERSCORE) -> return false
    loop byte in raw {
        code :: Int.from_u8(byte)
        if !(trust_text_is_alphanumeric(code) || code == TRUST_UNDERSCORE) -> return false
    }
    true
}
