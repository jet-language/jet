// Durable per-service runtime state under `.jet/services/<canonical-name>/`:
// the verified process identity (`pid`), the lifecycle facts (`lifecycle`),
// allocated ports, the shutdown marker, supervisor errors, and captured logs.
// Every state file is replaced whole, so a reader never sees half a record.

SERVICES_MAX_SERVICE_NAME_BYTES :: prep { 256 }
SERVICES_MAX_STATE_BYTES :: prep { 4096 }
SERVICES_MAX_LIFECYCLE_BYTES :: prep { 16384 }
SERVICES_SUPERVISOR_ENV :: prep { "JETPACK_SERVICE_SUPERVISOR" }

// A service process's saved identity: the PID plus the platform-tagged start
// token and optional containment name (D-CORE-PROCIDENT1), so a reused PID
// can never authorize a liveness claim or a signal.
struct ServiceProcessState {
    pid: Int
    start_identity: String
    containment: String?

    fn identity(self) -> ProcessIdentity Never! {
        ProcessIdentity{pid: self.pid, start: self.start_identity, containment: self.containment}
    }

    fn encode(self) -> String Never! {
        text := "version=1\npid={self.pid}\nstart={self.start_identity}\n"
        if self.containment == .Val(name) -> text = "{text}containment={name}\n"
        text
    }
}

// The `pid` record as found on disk.
enum PersistedProcessState {
    Verified(ServiceProcessState)
    // Written by Jetpack versions that persisted only a PID. It may be
    // removed but never authorizes a liveness claim or a signal.
    LegacyPID(Int)
}

// The verified identity of a record; a legacy PID authorizes nothing.
fn services_verified_state(record: PersistedProcessState) -> ServiceProcessState? Never! {
    if record == {
        .Verified(verified) -> Val(verified)
        .LegacyPID(_) -> None
    }
}

// The lifecycle phase of one supervised generation.
enum ServicePhase {
    Starting
    Running
    Ready
    Failed
    Stopped

    fn as_str(self) -> String Never! {
        if self == {
            .Starting -> "starting"
            .Running -> "running"
            .Ready -> "ready"
            .Failed -> "failed"
            .Stopped -> "stopped"
        }
    }

    fn parse(text: String) -> ServicePhase? Never! {
        if text == {
            "starting" -> Val(ServicePhase.Starting)
            "running" -> Val(ServicePhase.Running)
            "ready" -> Val(ServicePhase.Ready)
            "failed" -> Val(ServicePhase.Failed)
            "stopped" -> Val(ServicePhase.Stopped)
            else -> None
        }
    }

    // Starting, running, and ready generations may still own processes.
    fn is_live(self) -> Bool Never! {
        if self == {
            .Starting | .Running | .Ready -> true
            else -> false
        }
    }
}

// Durable facts for one supervised generation: the authority, containment,
// phase, and recovery reason keep a record explainable after the supervisor
// or the service has exited.
struct LifecycleFacts {
    backend: String
    generation: Int
    phase: ServicePhase
    containment: String
    recovery: String
    pid: Int?
    unit: String?
    guardian: String?
    dependencies: [String]
}

// Which platform authority contains a service generation.
enum ServiceAuthority {
    // The service's own process group (the in-process host).
    TestProcessGroup
    // A delegated `systemd-run --user --scope` unit on Linux.
    LinuxSystemdUser(unit: String)
    // A named Windows Job Object held by the Core process identity.
    WindowsGuardianJobObject(guardian: String)
    Unsupported

    fn backend(self) -> String Never! {
        if self == {
            .TestProcessGroup -> "test-process-group"
            .LinuxSystemdUser(_) -> "linux-systemd-user"
            .WindowsGuardianJobObject(_) -> "windows-guardian-job-object"
            .Unsupported -> "unsupported"
        }
    }

    fn containment(self) -> String Never! {
        if self == {
            .TestProcessGroup -> "process-group"
            .LinuxSystemdUser(_) -> "delegated-cgroup"
            .WindowsGuardianJobObject(_) -> "job-object"
            .Unsupported -> "none"
        }
    }

    fn unit(self) -> String? Never! {
        if self == {
            .LinuxSystemdUser(unit) -> Val(unit)
            else -> None
        }
    }

    fn guardian(self) -> String? Never! {
        if self == {
            .WindowsGuardianJobObject(guardian) -> Val(guardian)
            else -> None
        }
    }

    fn uses_platform_authority(self) -> Bool Never! {
        if self == {
            .LinuxSystemdUser(_) | .WindowsGuardianJobObject(_) -> true
            else -> false
        }
    }
}

// The `.jet/services/<canonical-name>/` directory for `name`.
fn services_service_dir(project_dir: String, name: String) -> String Never! {
    root :: files.join(files.join(project_dir, CONFIG_DEFAULT_DIR), SERVICES_STATE_DIR)
    canonical :: services_canonical_service_name(name)
    if canonical == "" -> return root
    files.join(root, canonical)
}

fn services_pid_path(dir: String) -> String Never! { files.join(dir, "pid") }

fn services_stopping_path(dir: String) -> String Never! { files.join(dir, ".stopping") }

fn services_supervisor_error_path(dir: String) -> String Never! { files.join(dir, "supervisor.error") }

fn services_ports_path(dir: String) -> String Never! { files.join(dir, "ports") }

fn services_lifecycle_path(dir: String) -> String Never! { files.join(dir, "lifecycle") }

fn services_stdout_path(dir: String) -> String Never! { files.join(dir, "stdout.log") }

fn services_stderr_path(dir: String) -> String Never! { files.join(dir, "stderr.log") }

// The recorded supervisor failure for `plan`, if any.
fn services_supervisor_failure(project_dir: String, plan: DevServicePlan) -[FS]> String? Never! {
    text :: services_read_text_bounded(services_supervisor_error_path(services_service_dir(project_dir, plan.name)), SERVICES_MAX_STATE_BYTES) ?? return None
    error :: text.trim()
    if error == "" -> return None
    Val(error)
}

// Publish a small state file as one complete replacement through a
// create-new temporary beside it.
fn services_write_atomic(path: String, contents: [U8]) IOError! -[FS, Env]> {
    parent :: files.dirname(path)
    directory :: if parent == "" -> "." else -> parent
    files.create_dir_all(directory)
    name :: files.basename(path)
    temporary :: files.join(directory, ".{if name == "" -> "state" else -> name}.tmp-{sys.pid()}")
    if services_replace_through(temporary, path, contents) == .Err(error) {
        files.remove(temporary).drop("the temporary is abandoned after a failed publish")
        return Err(error)
    }
}

fn services_replace_through(temporary: String, path: String, contents: [U8]) IOError! -[FS]> {
    writer := files.create(temporary, if_exists: .Refuse)
    &writer.write_all(contents)
    &writer.fsync()
    close(^writer)
    files.rename(temporary, path)
}

// Remove a state file; a missing file is fine and other failures are ignored
// (Rust `let _ = fs::remove_file(..)`).
fn services_remove_quiet(path: String) -[FS]> {
    files.remove(path).drop("state cleanup is best-effort")
}

// Remove a state file, treating only a missing file as success.
fn services_remove_existing(path: String) IOError! -[FS]> {
    if files.remove(path) == .Err(error) {
        if !services_is_not_found(error) -> return Err(error)
    }
}

fn services_is_not_found(error: IOError) -> Bool Never! {
    if error == {
        .NotFound(_) -> true
        else -> false
    }
}

fn services_state_error(path: String, cause: String) -> IOError Never! {
    IOError.InvalidInput(IOContext{operation: .Read, resource: Val(path), os_code: None, cause: Val(cause)})
}

// Read a bounded regular state file (never through a final link) as UTF-8.
fn services_read_text_bounded(path: String, limit: Int) -[FS]> String IOError! {
    info :: files.stat(path)
    if info.is_symlink || !info.is_file || info.size > limit {
        return Err(services_state_error(path, "service state is not a bounded regular file"))
    }
    bytes :: files.read_bytes(path)
    if bytes.len() > limit -> return Err(services_state_error(path, "service state exceeded its bound while being read"))
    String.from_bytes(bytes) ?? return Err(services_state_error(path, "service state is not UTF-8"))
}

// Rust `str::lines`: split at LF and drop one trailing CR per line.
fn services_lines(text: String) -> [String] Never! {
    lines := [String]{}
    if text == "" -> return lines
    pieces :: text.split("\n").to_list()
    count :: if text.ends_with("\n") -> pieces.len() - 1 else -> pieces.len()
    carriage_return :: env_shell_control(13)
    loop index in 0..<count -> &lines.push(pieces[index].removesuffix(carriage_return))
    lines
}

// A PID is a non-zero `u32`.
fn services_parse_pid(text: String) -> Int? Never! {
    value :: Int.parse(text) ?? return None
    if value <= 0 || value > 4294967295 -> return None
    Val(value)
}

// The saved process identity, a legacy PID-only record, or None.
fn services_read_process_state(dir: String) -[FS]> PersistedProcessState? ServicesError! {
    path :: services_pid_path(dir)
    invalid :: ServicesError.new("service process state `{path}` is invalid")
    text :: if services_read_text_bounded(path, SERVICES_MAX_STATE_BYTES) == {
        .Ok(text) -> text
        .Err(error) -> {
            if services_is_not_found(error) -> return Ok(None)
            return Err(ServicesError.new("couldn't read service process state `{path}`: {error}"))
        }
    }
    trimmed :: text.trim()
    if Int.parse(trimmed) == .Val(legacy) {
        if legacy <= 0 || legacy > 4294967295 -> return Err(invalid)
        return Ok(Val(PersistedProcessState.LegacyPID(legacy)))
    }
    if trimmed == "" -> return Err(invalid)
    version := false
    pid := Int?{None}
    start := String?{None}
    containment := String?{None}
    seen := [String]{}
    lines :: services_lines(trimmed)
    loop raw in lines {
        pair :: raw.trim().split_once("=") ?? return Err(invalid)
        if seen.contains(pair.before) -> return Err(invalid)
        &seen.push(pair.before)
        if pair.before == {
            "version" -> {
                if pair.after != "1" -> return Err(invalid)
                version = true
            }
            "pid" -> pid = Val(services_parse_pid(pair.after) ?? return Err(invalid))
            "start" -> {
                if pair.after == "" -> return Err(invalid)
                start = Val(pair.after)
            }
            "containment" -> {
                if pair.after == "" -> return Err(invalid)
                containment = Val(pair.after)
            }
            else -> return Err(invalid)
        }
    }
    if !version -> return Err(invalid)
    found_pid :: pid ?? return Err(invalid)
    found_start :: start ?? return Err(invalid)
    Ok(Val(PersistedProcessState.Verified(ServiceProcessState{pid: found_pid, start_identity: found_start, containment})))
}

// The authority a lifecycle record names.
fn services_authority_from_lifecycle(facts: LifecycleFacts) -> ServiceAuthority ServicesError! {
    if facts.backend == {
        "test-process-group" -> Ok(ServiceAuthority.TestProcessGroup)
        "linux-systemd-user" -> {
            unit :: facts.unit ?? return Err(ServicesError.new("service lifecycle state is missing its systemd unit"))
            Ok(ServiceAuthority.LinuxSystemdUser{unit: unit})
        }
        "windows-guardian-job-object" -> {
            guardian :: facts.guardian ?? return Err(ServicesError.new("service lifecycle state is missing its guardian"))
            Ok(ServiceAuthority.WindowsGuardianJobObject{guardian: guardian})
        }
        "unsupported" -> Ok(ServiceAuthority.Unsupported)
        else -> Err(ServicesError.new("service lifecycle state has unknown authority `{facts.backend}`"))
    }
}

fn services_lifecycle_for(authority: ServiceAuthority, generation: Int, phase: ServicePhase, recovery: String, pid: Int?, dependencies: [String]) -> LifecycleFacts Never! {
    LifecycleFacts{
        backend: authority.backend(),
        generation,
        phase,
        containment: authority.containment(),
        recovery,
        pid,
        unit: authority.unit(),
        guardian: authority.guardian(),
        dependencies
    }
}

fn services_write_lifecycle(dir: String, facts: LifecycleFacts) IOError! -[FS, Env]> {
    encoded := "version=1\nbackend={facts.backend}\ngeneration={facts.generation}\nphase={facts.phase.as_str()}\ncontainment={facts.containment}\nrecovery={facts.recovery}\n"
    if facts.pid == .Val(pid) -> encoded = "{encoded}pid={pid}\n"
    if facts.unit == .Val(unit) -> encoded = "{encoded}unit={unit}\n"
    if facts.guardian == .Val(guardian) -> encoded = "{encoded}guardian={guardian}\n"
    loop dependency in facts.dependencies -> encoded = "{encoded}dependency={dependency}\n"
    services_write_atomic(services_lifecycle_path(dir), encoded.bytes())
}

// Best-effort lifecycle publication (Rust `let _ = write_lifecycle(..)`).
fn services_write_lifecycle_quiet(dir: String, facts: LifecycleFacts) -[FS, Env]> {
    services_write_lifecycle(dir, facts).drop("lifecycle evidence is best-effort here")
}

// The lifecycle record in `dir`, validated against its authority.
fn services_read_lifecycle(dir: String) -[FS]> LifecycleFacts? ServicesError! {
    path :: services_lifecycle_path(dir)
    invalid :: ServicesError.new("service lifecycle state `{path}` is invalid")
    text :: if services_read_text_bounded(path, SERVICES_MAX_LIFECYCLE_BYTES) == {
        .Ok(text) -> text
        .Err(error) -> {
            if services_is_not_found(error) -> return Ok(None)
            return Err(ServicesError.new("couldn't read service lifecycle state `{path}`: {error}"))
        }
    }
    version := false
    backend := String?{None}
    generation := Int?{None}
    phase := ServicePhase?{None}
    containment := String?{None}
    recovery := String?{None}
    pid := Int?{None}
    unit := String?{None}
    guardian := String?{None}
    dependencies := [String]{}
    seen := [String]{}
    lines :: services_lines(text)
    loop line in lines {
        pair :: line.split_once("=") ?? return Err(invalid)
        key :: pair.before
        value :: pair.after
        if key != "dependency" {
            if seen.contains(key) -> return Err(invalid)
            &seen.push(key)
        }
        if key == {
            "version" -> {
                if value != "1" -> return Err(invalid)
                version = true
            }
            "generation" -> generation = services_parse_generation(value)
            "pid" -> pid = services_parse_pid(value)
            "phase" -> {
                if value == "" -> return Err(invalid)
                phase = Val(ServicePhase.parse(value) ?? return Err(invalid))
            }
            "backend" | "containment" | "recovery" | "unit" | "guardian" | "dependency" -> {
                if value == "" -> return Err(invalid)
                if key == {
                    "backend" -> backend = Val(value)
                    "containment" -> containment = Val(value)
                    "recovery" -> recovery = Val(value)
                    "unit" -> unit = Val(value)
                    "guardian" -> guardian = Val(value)
                    else -> &dependencies.push(value)
                }
            }
            else -> return Err(invalid)
        }
    }
    if !version -> return Err(invalid)
    facts :: LifecycleFacts{
        backend: backend ?? return Err(invalid),
        generation: generation ?? return Err(invalid),
        phase: phase ?? return Err(invalid),
        containment: containment ?? return Err(invalid),
        recovery: recovery ?? return Err(invalid),
        pid,
        unit,
        guardian,
        dependencies
    }
    services_validate_lifecycle_authority(facts, path)
    Ok(Val(facts))
}

fn services_parse_generation(text: String) -> Int? Never! {
    value :: Int.parse(text) ?? return None
    if value < 0 -> return None
    Val(value)
}

// The persisted backend, containment, unit, and guardian must be exactly the
// facts their authority derives.
fn services_validate_lifecycle_authority(facts: LifecycleFacts, path: String) ServicesError! {
    authority :: services_authority_from_lifecycle(facts) ?? return Err(ServicesError.new("service lifecycle state `{path}` is invalid: {err.message}"))
    if facts.backend != authority.backend() || facts.containment != authority.containment() || facts.unit != authority.unit() || facts.guardian != authority.guardian() {
        return Err(ServicesError.new("service lifecycle state `{path}` has inconsistent authority facts"))
    }
}

// E1262: the first unrecognized `services:` field. `extra` holds every
// unknown key and every known key with the wrong shape.
pub fn services_unknown_field(plan: DevServicePlan) -> String? Never! {
    if plan.extra.len() == 0 -> return None
    Val(plan.extra[0].name)
}
