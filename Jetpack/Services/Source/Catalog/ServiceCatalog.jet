// U12: dev-supervised services (jetpack Services.rs). `env.<name>`'s
// `services:` map declares processes Jetpack supervises for the dev loop,
// distinct from the JetOS `system.*.services` tier. This file holds the
// documented presets: each preset's default package, executable, port, start
// command, readiness probe, and first-start state setup. They apply only when
// the author's `services:` entry leaves `run`/`ready`/`ports` unset; a name
// with no preset and no `run:` is a plain "don't know how to start this".

// Every Services failure is final diagnostic text (Rust `Result<_, String>`).
#Error
pub struct ServicesError {
    pub message: String

    fn new(message: String) -> ServicesError Never! {
        ServicesError{message}
    }
}

impl IOError -> ServicesError { return ServicesError{message: "{self}"} }

// Typed metadata exposed by the shared preset registry. A source-only
// owner-gated row stays discovery metadata until its runtime projection is
// ratified; it is never treated as a runnable service.
pub struct ServicePreset {
    pub name: String
    pub package: String
    pub default_port: Int
}

// One documented dev service. Declaration order is the catalog order.
enum ServicePresetKind {
    Redis
    Postgres
    Mysql
    Mariadb
    Nginx
    Minio
    Mailpit
    Adminer
    Blackfire
    Caddy
    Cassandra
    Clickhouse
    Cockroachdb
    Couchdb
    DynamodbLocal
    Elasticmq
    Elasticsearch
    Garage
    Httpbin
    Influxdb
    KafkaConnect
    Kafka
    Keycloak
    Mailhog
    Meilisearch
    Memcached
    Mongodb
    Mosquitto
    Nats
    Nixseparatedebuginfod
    Opensearch
    OpentelemetryCollector
    Prometheus
    Rabbitmq
    Rustfs
    Sqld
    Tailscale
    Temporal
    Tideways
    Typesense
    Varnish
    Vault
    Wiremock

    // Canonical name first; the rest are accepted aliases.
    fn names(self) -> [String] Never! {
        if self == {
            .Redis -> [String]{"redis"}
            .Postgres -> [String]{"postgres", "postgresql"}
            .Mysql -> [String]{"mysql"}
            .Mariadb -> [String]{"mariadb"}
            .Nginx -> [String]{"nginx"}
            .Minio -> [String]{"minio"}
            .Mailpit -> [String]{"mailpit", "mail"}
            .Adminer -> [String]{"adminer"}
            .Blackfire -> [String]{"blackfire"}
            .Caddy -> [String]{"caddy"}
            .Cassandra -> [String]{"cassandra"}
            .Clickhouse -> [String]{"clickhouse"}
            .Cockroachdb -> [String]{"cockroachdb"}
            .Couchdb -> [String]{"couchdb"}
            .DynamodbLocal -> [String]{"dynamodb-local"}
            .Elasticmq -> [String]{"elasticmq"}
            .Elasticsearch -> [String]{"elasticsearch"}
            .Garage -> [String]{"garage"}
            .Httpbin -> [String]{"httpbin"}
            .Influxdb -> [String]{"influxdb"}
            .KafkaConnect -> [String]{"kafka-connect"}
            .Kafka -> [String]{"kafka"}
            .Keycloak -> [String]{"keycloak"}
            .Mailhog -> [String]{"mailhog"}
            .Meilisearch -> [String]{"meilisearch"}
            .Memcached -> [String]{"memcached"}
            .Mongodb -> [String]{"mongodb"}
            .Mosquitto -> [String]{"mosquitto"}
            .Nats -> [String]{"nats"}
            .Nixseparatedebuginfod -> [String]{"nixseparatedebuginfod"}
            .Opensearch -> [String]{"opensearch"}
            .OpentelemetryCollector -> [String]{"opentelemetry-collector"}
            .Prometheus -> [String]{"prometheus"}
            .Rabbitmq -> [String]{"rabbitmq"}
            .Rustfs -> [String]{"rustfs"}
            .Sqld -> [String]{"sqld"}
            .Tailscale -> [String]{"tailscale"}
            .Temporal -> [String]{"temporal"}
            .Tideways -> [String]{"tideways"}
            .Typesense -> [String]{"typesense"}
            .Varnish -> [String]{"varnish"}
            .Vault -> [String]{"vault"}
            .Wiremock -> [String]{"wiremock"}
        }
    }

    fn canonical_name(self) -> String Never! {
        self.names()[0]
    }

    // The `<package>@<source>` ref realized before spawning (D-JPK-REF1).
    fn pkg_ref(self) -> String Never! {
        if self == {
            .Redis -> "redis@nixpkgs"
            .Postgres -> "postgresql@nixpkgs"
            .Mysql -> "mysql@nixpkgs"
            .Mariadb -> "mariadb@nixpkgs"
            .Nginx -> "nginx@nixpkgs"
            .Minio -> "minio@nixpkgs"
            .Mailpit -> "mailpit@nixpkgs"
            .Adminer -> "adminer@nixpkgs"
            .Blackfire -> "blackfire@nixpkgs"
            .Caddy -> "caddy@nixpkgs"
            .Cassandra -> "cassandra_4@nixpkgs"
            .Clickhouse -> "clickhouse@nixpkgs"
            .Cockroachdb -> "cockroachdb@nixpkgs"
            .Couchdb -> "couchdb3@nixpkgs"
            .DynamodbLocal -> "dynamodb-local@nixpkgs"
            .Elasticmq -> "elasticmq-server-bin@nixpkgs"
            .Elasticsearch -> "elasticsearch7@nixpkgs"
            .Garage -> "garage_2@nixpkgs"
            .Httpbin -> "httpbin@nixpkgs"
            .Influxdb -> "influxdb2-server@nixpkgs"
            .KafkaConnect | .Kafka -> "apacheKafka@nixpkgs"
            .Keycloak -> "keycloak@nixpkgs"
            .Mailhog -> "mailhog@nixpkgs"
            .Meilisearch -> "meilisearch@nixpkgs"
            .Memcached -> "memcached@nixpkgs"
            .Mongodb -> "mongodb-ce@nixpkgs"
            .Mosquitto -> "mosquitto@nixpkgs"
            .Nats -> "nats-server@nixpkgs"
            .Nixseparatedebuginfod -> "nixseparatedebuginfod2@nixpkgs"
            .Opensearch -> "opensearch@nixpkgs"
            .OpentelemetryCollector -> "opentelemetry-collector-contrib@nixpkgs"
            .Prometheus -> "prometheus@nixpkgs"
            .Rabbitmq -> "rabbitmq-server@nixpkgs"
            .Rustfs -> "rustfs@nixpkgs"
            .Sqld -> "sqld@nixpkgs"
            .Tailscale -> "tailscale@nixpkgs"
            .Temporal -> "temporal-cli@nixpkgs"
            .Tideways -> "tideways-daemon@nixpkgs"
            .Typesense -> "typesense@nixpkgs"
            .Varnish -> "varnish@nixpkgs"
            .Vault -> "vault-bin@nixpkgs"
            .Wiremock -> "wiremock@nixpkgs"
        }
    }

    // The executable the package exposes; package and executable names are
    // not assumed to match. Empty means source-only and owner-gated
    // (Nixpkgs ships Adminer as PHP source, not a runnable executable).
    fn executable(self) -> String Never! {
        if self == {
            .Redis -> "redis-server"
            .Postgres -> "postgres"
            .Mysql -> "mysqld"
            .Mariadb -> "mariadbd"
            .Nginx -> "nginx"
            .Minio -> "minio"
            .Mailpit -> "mailpit"
            .Adminer -> ""
            .Blackfire -> "blackfire"
            .Caddy -> "caddy"
            .Cassandra -> "cassandra"
            .Clickhouse -> "clickhouse-server"
            .Cockroachdb -> "cockroachdb"
            .Couchdb -> "couchdb"
            .DynamodbLocal -> "dynamodb-local"
            .Elasticmq -> "elasticmq-server"
            .Elasticsearch -> "elasticsearch"
            .Garage -> "garage"
            .Httpbin -> "gunicorn"
            .Influxdb -> "influxd"
            .KafkaConnect -> "connect-standalone.sh"
            .Kafka -> "kafka-server-start.sh"
            .Keycloak -> "kc.sh"
            .Mailhog -> "MailHog"
            .Meilisearch -> "meilisearch"
            .Memcached -> "memcached"
            .Mongodb -> "mongod"
            .Mosquitto -> "mosquitto"
            .Nats -> "nats-server"
            .Nixseparatedebuginfod -> "nixseparatedebuginfod"
            .Opensearch -> "opensearch"
            .OpentelemetryCollector -> "otelcol-contrib"
            .Prometheus -> "prometheus"
            .Rabbitmq -> "rabbitmq-server"
            .Rustfs -> "rustfs"
            .Sqld -> "sqld"
            .Tailscale -> "tailscale"
            .Temporal -> "temporal"
            .Tideways -> "tideways-daemon"
            .Typesense -> "typesense-server"
            .Varnish -> "varnishd"
            .Vault -> "vault"
            .Wiremock -> "wiremock"
        }
    }

    fn port(self) -> Int Never! {
        if self == {
            .Redis -> 6379
            .Postgres -> 5432
            .Mysql | .Mariadb -> 3306
            .Nginx | .Caddy | .Httpbin | .Keycloak | .Sqld | .Wiremock -> 8080
            .Minio | .Clickhouse | .Rustfs -> 9000
            .Mailpit | .Mailhog -> 8025
            .Adminer -> 8081
            .Blackfire -> 8307
            .Cassandra -> 9042
            .Cockroachdb -> 26257
            .Couchdb -> 5984
            .DynamodbLocal | .Nixseparatedebuginfod -> 8000
            .Elasticmq -> 9324
            .Elasticsearch | .Opensearch -> 9200
            .Garage -> 3900
            .Influxdb -> 8086
            .KafkaConnect -> 8083
            .Kafka -> 9092
            .Meilisearch -> 7700
            .Memcached -> 11211
            .Mongodb -> 27017
            .Mosquitto -> 1883
            .Nats -> 4222
            .OpentelemetryCollector -> 13133
            .Prometheus -> 9090
            .Rabbitmq -> 5672
            .Tailscale -> 41641
            .Temporal -> 7233
            .Tideways -> 9135
            .Typesense -> 8108
            .Varnish -> 6081
            .Vault -> 8200
        }
    }

    fn executable_name(self) -> String? Never! {
        executable :: self.executable()
        if executable == "" -> return None
        Val(executable)
    }

    fn require_runtime(self, name: String) ServicesError! {
        if self.executable_name() == None {
            return Err(ServicesError.new("service preset `{name}` is owner-gated until a PHP runtime/source projection is ratified"))
        }
    }

    // The foreground start command for `port`, keeping state in `data_dir`.
    fn run(self, port: Int, data_dir: String) -> [String] Never! {
        data :: data_dir
        if self == {
            .Redis -> [String]{"redis-server", "--bind", "127.0.0.1", "--port", "{port}", "--daemonize", "no", "--dir", data}
            .Postgres -> [String]{"postgres", "-D", data, "-h", "127.0.0.1", "-p", "{port}"}
            .Mysql -> [String]{"mysqld", "--datadir={data}", "--port={port}", "--bind-address=127.0.0.1", "--skip-networking=0"}
            .Mariadb -> [String]{"mariadbd", "--datadir={data}", "--port={port}", "--bind-address=127.0.0.1", "--skip-networking=0"}
            .Nginx -> {
                prefix :: services_nginx_prefix(port, data)
                return [String]{"nginx", "-p", prefix, "-c", files.join(prefix, "conf/nginx.conf"), "-g", "daemon off;"}
            }
            .Minio -> [String]{"minio", "server", data, "--address", "127.0.0.1:{port}"}
            .Mailpit -> [String]{"mailpit", "--database", files.join(data, "mailpit.db"), "--listen", "127.0.0.1:{port}", "--smtp", "127.0.0.1:1025"}
            .Adminer -> [String]{"adminer", "--port", "{port}", "--root", data}
            .Blackfire -> [String]{"blackfire", "agent:start"}
            .Caddy -> [String]{"caddy", "file-server", "--root", data, "--listen", "127.0.0.1:{port}"}
            .Cassandra -> [String]{"cassandra", "-f"}
            .Clickhouse -> [String]{"clickhouse-server", "--path", data, "--listen_host", "127.0.0.1", "--tcp_port", "{port}"}
            .Cockroachdb -> [String]{"cockroachdb", "start-single-node", "--insecure", "--listen-addr=127.0.0.1:{port}", "--http-addr=127.0.0.1:{services_saturating_add(port, 1)}", "--store=path={data}"}
            .Couchdb -> [String]{"couchdb"}
            .DynamodbLocal -> [String]{"dynamodb-local", "-port", "{port}", "-dbPath", data, "-disableTelemetry"}
            .Elasticmq -> [String]{"elasticmq-server"}
            .Elasticsearch -> [String]{"elasticsearch", "-Epath.data={data}", "-Enetwork.host=127.0.0.1", "-Ehttp.port={port}", "-Ediscovery.type=single-node"}
            .Garage -> [String]{"garage", "-c", files.join(data, "garage.toml"), "server"}
            .Httpbin -> [String]{"gunicorn", "httpbin:app", "-b", "127.0.0.1:{port}"}
            .Influxdb -> [String]{"influxd", "--bolt-path={files.join(data, "influxd.bolt")}", "--engine-path={files.join(data, "engine")}", "--http-bind-address=127.0.0.1:{port}"}
            .KafkaConnect -> [String]{"connect-standalone.sh", files.join(data, "connect-standalone.properties"), files.join(data, "connector.properties")}
            .Kafka -> [String]{"kafka-server-start.sh", files.join(data, "server.properties")}
            .Keycloak -> [String]{"kc.sh", "start-dev", "--http-port={port}"}
            .Mailhog -> [String]{"MailHog", "-ui-bind-addr", "127.0.0.1:{port}", "-api-bind-addr", "127.0.0.1:{port}", "-smtp-bind-addr", "127.0.0.1:1025"}
            .Meilisearch -> [String]{"meilisearch", "--db-path", data, "--http-addr", "127.0.0.1:{port}", "--no-analytics"}
            .Memcached -> [String]{"memcached", "-l", "127.0.0.1", "-p", "{port}"}
            .Mongodb -> [String]{"mongod", "--dbpath", data, "--bind_ip", "127.0.0.1", "--port", "{port}"}
            .Mosquitto -> [String]{"mosquitto", "-c", files.join(data, "mosquitto.conf")}
            .Nats -> [String]{"nats-server", "--port", "{port}", "--http_port", "{services_saturating_add(port, 4000)}", "--store_dir", data}
            .Nixseparatedebuginfod -> [String]{"nixseparatedebuginfod", "--listen-address", "127.0.0.1:{port}"}
            .Opensearch -> [String]{"opensearch", "-Epath.data={data}", "-Enetwork.host=127.0.0.1", "-Ehttp.port={port}", "-Ediscovery.type=single-node"}
            .OpentelemetryCollector -> [String]{"otelcol-contrib", "--config", files.join(data, "otel-collector.yaml")}
            .Prometheus -> [String]{"prometheus", "--config.file={files.join(data, "prometheus.yml")}", "--storage.tsdb.path={data}", "--web.listen-address=127.0.0.1:{port}"}
            .Rabbitmq -> [String]{"rabbitmq-server"}
            .Rustfs -> [String]{"rustfs", data, "--address", "127.0.0.1:{port}"}
            .Sqld -> [String]{"sqld", "--http-listen-addr", "127.0.0.1:{port}"}
            .Tailscale -> [String]{"tailscale", "funnel", "--yes"}
            .Temporal -> [String]{"temporal", "server", "start-dev", "--ip", "127.0.0.1", "--port={port}", "--ui-port={services_saturating_add(port, 1000)}"}
            .Tideways -> [String]{"tideways-daemon", "-address", "tcp://127.0.0.1:{port}", "--env", "dev"}
            .Typesense -> [String]{"typesense-server", "--data-dir", data, "--api-address", "127.0.0.1", "--api-port", "{port}", "--api-key", "jet-dev"}
            .Varnish -> [String]{"varnishd", "-n", data, "-F", "-f", files.join(data, "default.vcl"), "-s", "malloc,100m", "-a", "127.0.0.1:{port}"}
            .Vault -> [String]{"vault", "server", "-dev", "-dev-root-token-id=root", "-dev-listen-address=127.0.0.1:{port}"}
            .Wiremock -> [String]{"wiremock", "--port", "{port}", "--root-dir", data}
        }
    }

    // The typed readiness probe for `port`.
    fn readiness(self, port: Int) -> ReadyProbe Never! {
        if self == {
            .Redis -> ReadyProbe.Exec{command: "redis-cli -p {port} ping"}
            .Postgres -> ReadyProbe.Exec{command: "pg_isready -h 127.0.0.1 -p {port}"}
            .Mysql -> ReadyProbe.Exec{command: "mysqladmin ping -h 127.0.0.1 -P {port} -u root"}
            .Mariadb -> ReadyProbe.Exec{command: "mariadb-admin ping -h 127.0.0.1 -P {port} -u root"}
            .Nginx | .Adminer -> ReadyProbe.Exec{command: "curl -fsS http://127.0.0.1:{port}/"}
            .Minio -> ReadyProbe.Exec{command: "curl -fsS http://127.0.0.1:{port}/minio/health/live"}
            .Mailpit -> ReadyProbe.Exec{command: "curl -fsS http://127.0.0.1:{port}/api/v1/info"}
            .Mailhog -> ReadyProbe.Exec{command: "curl -fsS http://127.0.0.1:{port}/api/v2/messages"}
            .Blackfire | .Tailscale -> ReadyProbe.Exec{command: "true"}
            else -> services_tcp_readiness(port)
        }
    }

    // First-start state setup inside `data_dir`, run through `env`'s PATH.
    fn prepare(self, port: Int, data_dir: String, env: ShellEnv) ServicesError! -[FS, Env, Exec, Time.Wait]> {
        if self == {
            .Postgres -> services_prepare_database(port, data_dir, env, "initdb", [String]{"--no-locale", "--encoding=UTF8", "--pgdata", data_dir})
            .Mysql -> services_prepare_database(port, data_dir, env, "mysqld", [String]{"--initialize-insecure", "--datadir={data_dir}"})
            .Mariadb -> services_prepare_database(port, data_dir, env, "mariadb-install-db", [String]{"--auth-root-authentication-method=normal", "--skip-test-db", "--datadir={data_dir}"})
            .Nginx -> services_prepare_nginx(port, data_dir)
            .Garage -> services_prepare_config(files.join(data_dir, "garage.toml"), "metadata_dir = \"{data_dir}/meta\"\ndata_dir = \"{data_dir}/data\"\nrpc_bind_addr = \"127.0.0.1:{services_saturating_add(port, 1)}\"\n[s3_api]\napi_bind_addr = \"127.0.0.1:{port}\"\n", "Garage")
            .Kafka -> {
                controller_port :: services_saturating_add(port, 1)
                services_prepare_config(files.join(data_dir, "server.properties"), "process.roles=broker,controller\nnode.id=1\ncontroller.quorum.voters=1@127.0.0.1:{controller_port}\nlisteners=PLAINTEXT://127.0.0.1:{port},CONTROLLER://127.0.0.1:{controller_port}\nadvertised.listeners=PLAINTEXT://127.0.0.1:{port}\nlistener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT\ncontroller.listener.names=CONTROLLER\ninter.broker.listener.name=PLAINTEXT\nlog.dirs={data_dir}/logs\n", "Kafka")
            }
            .KafkaConnect -> {
                worker :: "bootstrap.servers=127.0.0.1:9092\ngroup.id=jet\nkey.converter=org.apache.kafka.connect.storage.StringConverter\nvalue.converter=org.apache.kafka.connect.storage.StringConverter\nrest.port={port}\n"
                connector :: "name=jet-file-source\nconnector.class=FileStreamSource\ntasks.max=1\nfile=/dev/null\ntopic=jet\n"
                if services_write_atomic(files.join(data_dir, "connect-standalone.properties"), worker.bytes()) == .Err(error) {
                    return Err(ServicesError.new("couldn't write Kafka Connect preset config: {error}"))
                }
                services_prepare_config(files.join(data_dir, "connector.properties"), connector, "Kafka Connect")
            }
            .Mosquitto -> services_prepare_config(files.join(data_dir, "mosquitto.conf"), "listener {port} 127.0.0.1\nallow_anonymous true\npersistence true\npersistence_location {data_dir}/\n", "Mosquitto")
            .OpentelemetryCollector -> services_prepare_config(files.join(data_dir, "otel-collector.yaml"), "receivers: {{}}\nprocessors: {{}}\nexporters: {{}}\nservice:\n  pipelines: {{}}\n", "OpenTelemetry")
            .Prometheus -> services_prepare_config(files.join(data_dir, "prometheus.yml"), "global:\n  scrape_interval: 15s\n", "Prometheus")
            .Varnish -> services_prepare_config(files.join(data_dir, "default.vcl"), "vcl 4.1;\nbackend default {{\n  .host = \"127.0.0.1\";\n  .port = \"8080\";\n}}\n", "Varnish")
            else -> {}
        }
    }
}

// Every preset in catalog order.
fn services_catalog_kinds() -> [ServicePresetKind] Never! {
    [ServicePresetKind]{
        .Redis, .Postgres, .Mysql, .Mariadb, .Nginx, .Minio, .Mailpit, .Adminer, .Blackfire, .Caddy,
        .Cassandra, .Clickhouse, .Cockroachdb, .Couchdb, .DynamodbLocal, .Elasticmq, .Elasticsearch,
        .Garage, .Httpbin, .Influxdb, .KafkaConnect, .Kafka, .Keycloak, .Mailhog, .Meilisearch,
        .Memcached, .Mongodb, .Mosquitto, .Nats, .Nixseparatedebuginfod, .Opensearch,
        .OpentelemetryCollector, .Prometheus, .Rabbitmq, .Rustfs, .Sqld, .Tailscale, .Temporal,
        .Tideways, .Typesense, .Varnish, .Vault, .Wiremock
    }
}

// The preset a name or alias selects.
fn services_catalog(name: String) -> ServicePresetKind? Never! {
    kinds :: services_catalog_kinds()
    loop kind in kinds {
        if kind.names().contains(name) -> return Val(kind)
    }
    None
}

fn services_canonical_service_name(name: String) -> String Never! {
    kind :: services_catalog(name) ?? return name
    kind.canonical_name()
}

// The catalog package ref for `name`, folded into the project's realized
// packages so a bare `redis: { enable: true }` has `redis-server` on PATH.
pub fn services_catalog_pkg_ref(name: String) -> String? Never! {
    kind :: services_catalog(name) ?? return None
    Val(kind.pkg_ref())
}

// The executable a catalog package contributes to an environment image.
pub fn services_catalog_executable(name: String) -> String? Never! {
    kind :: services_catalog(name) ?? return None
    kind.executable_name()
}

// Built-in presets for the typed contribution path, from the same catalog.
pub fn services_catalog_presets() -> [ServicePreset] Never! {
    presets := [ServicePreset]{}
    kinds :: services_catalog_kinds()
    loop kind in kinds -> &presets.push(ServicePreset{name: kind.canonical_name(), package: kind.pkg_ref(), default_port: kind.port()})
    presets
}

// The executable vector for a service projected into an environment image.
// Image state lives below /var/lib/jet/services, so a generated image
// supervisor never keeps a build-machine path.
pub fn services_image_run_command(plan: DevServicePlan) -> [String] ServicesError! {
    if !plan.enable -> return Err(ServicesError.new("service {plan.name} is disabled"))
    if plan.run == .Val(run) {
        if run.len() == 0 || services_any_contains_nul(run) {
            return Err(ServicesError.new("service {plan.name} has an invalid empty run command"))
        }
        return Ok(run)
    }
    kind :: services_catalog(plan.name) ?? return Err(ServicesError.new("service {plan.name} has no run command and is not a built-in service"))
    kind.require_runtime(plan.name)
    port :: if plan.ports.len() > 0 -> plan.ports[0] else -> kind.port()
    if port < 1 || port > 65535 -> return Err(ServicesError.new("service {plan.name} has an invalid port"))
    Ok(kind.run(port, "/var/lib/jet/services/{services_canonical_service_name(plan.name)}"))
}

fn services_any_contains_nul(values: [String]) -> Bool Never! {
    loop value in values {
        loop byte in value.bytes() {
            if Int.from_u8(byte) == 0 -> return true
        }
    }
    false
}

fn services_tcp_readiness(port: Int) -> ReadyProbe Never! {
    ReadyProbe.TCP{host: "127.0.0.1", port: if port >= 0 && port <= 65535 -> port else -> 0}
}

// Rust `i64::saturating_add` for the few derived preset ports.
fn services_saturating_add(value: Int, delta: Int) -> Int Never! {
    if value > 9223372036854775807 - delta -> return 9223372036854775807
    value + delta
}

fn services_nginx_prefix(port: Int, data_dir: String) -> String Never! {
    files.join(data_dir, "nginx-{port}")
}

fn services_catalog_marker(data_dir: String) -> String Never! {
    files.join(data_dir, ".jet-preset-initialized")
}

fn services_prepare_config(path: String, contents: String, label: String) ServicesError! -[FS, Env]> {
    if services_write_atomic(path, contents.bytes()) == .Err(error) {
        return Err(ServicesError.new("couldn't write {label} preset config: {error}"))
    }
}

fn services_prepare_nginx(port: Int, data_dir: String) ServicesError! -[FS, Env]> {
    prefix :: services_nginx_prefix(port, data_dir)
    config_dir :: files.join(prefix, "conf")
    if files.create_dir_all(config_dir) == .Err(error) {
        return Err(ServicesError.new("couldn't create Nginx preset config directory: {error}"))
    }
    config :: "worker_processes 1;\npid {prefix}/nginx.pid;\nerror_log stderr notice;\nevents {{ worker_connections 64; }}\nhttp {{\n    access_log off;\n    server {{\n        listen 127.0.0.1:{port};\n        location / {{ return 200 \"jet nginx preset\"; }}\n    }}\n}}\n"
    services_prepare_config(files.join(config_dir, "nginx.conf"), config, "Nginx")
}

// Initialize a database directory once; an existing initialized directory
// only gains the marker.
fn services_prepare_database(port: Int, data_dir: String, env: ShellEnv, tool: String, args: [String]) ServicesError! -[FS, Env, Exec, Time.Wait]> {
    marker :: services_catalog_marker(data_dir)
    if files.is_file(marker) -> return
    initialized :: files.is_file(files.join(data_dir, "PG_VERSION")) || files.is_dir(files.join(data_dir, "mysql"))
    if !initialized -> services_run_catalog_tool(env, tool, args, data_dir)
    if services_write_atomic(marker, "port={port}\n".bytes()) == .Err(error) {
        return Err(ServicesError.new("couldn't record service preset initialization: {error}"))
    }
}

fn services_run_catalog_tool(env: ShellEnv, tool: String, args: [String], data_dir: String) ServicesError! -[FS, Env, Exec, Time.Wait]> {
    argv := [String]{tool}
    loop arg in args -> &argv.push(arg)
    spec := process.cmd(argv).cwd(data_dir).stdout(.Capture).stderr(.Capture)
    shell_env := env
    spec = &shell_env.apply_to(spec)
    receipt :: spec.run() ?? return Err(ServicesError.new("couldn't initialize service preset with `{tool}`: {err}"))
    if receipt.success -> return
    detail :: receipt.errors.trim()
    if detail == "" -> return Err(ServicesError.new("service preset initializer `{tool}` exited with {env_shell_exit_status_text(receipt)}"))
    Err(ServicesError.new("service preset initializer `{tool}` failed: {detail}"))
}
