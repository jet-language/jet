// Shared helpers for the ModuleEval claims (no #Test claims here).
use {
    jetpack_foundation.[PACKAGE_FILE]
    jet_pkg_model.[EntryContribution, FactValue]
    jet_env_model.[
        EnvModelEvalError, EnvPlan, EnvironmentIntegration, EvaluatedModule, FleetPlan, IntegrationKind,
        PackageProfilePlan, envmodel_evaluate_env, envmodel_evaluate_source,
    ]
    jet_foundation.[Diagnostic, diagnostic_display_name, diagnostic_render_all]
    files: core.files
    sys: core.sys
}

// Rust `std::env::temp_dir()`: the evaluation base for sources that read no
// files.
envmodel_test_base_dir: fn() -[Env]> String {
    sys.temp_dir()
}

// The repository root the committed fixtures are read from (Rust
// `CARGO_MANIFEST_DIR/../..`): JETPACK_TEST_REPO_ROOT, which
// Compiler/test.jet's packages suite sets to the checkout. The claims may run
// inside an assembled scratch project, so the working directory is never
// that tree.
envmodel_test_repo_root: fn() -[Env]> String {
    sys.get("JETPACK_TEST_REPO_ROOT") ?? panic("JETPACK_TEST_REPO_ROOT must name the Jet repository whose committed fixtures the claims read")
}

// A fresh, empty directory under the system temp dir, unique per call.
envmodel_test_fresh_dir: fn(slug: String) -[FS]> String {
    files.tmpdir("modeval-{slug}-") ?? panic("create a fresh temp dir")
}

// A fresh temp dir with a package manifest declaring `app: executable` — the
// package an `.Oci` image's `from: packages.app` cross-checks against (E1267).
envmodel_test_oci_base_dir: fn(slug: String) -[FS]> String {
    dir: files.tmpdir("jet-oci-modeval-{slug}-") ?? panic("create a fresh temp dir")
    files.write(files.join(dir, PACKAGE_FILE), "name: \"t\"\nversion: \"0.1.0\"\npackages: {{ app: executable }}\n") ?? panic("write the package manifest")
    dir
}

// The first writer's value of one setting in a module's entry contribution.
envmodel_test_setting_value: fn(entry: EntryContribution, key: String) -> FactValue? {
    writers: entry.settings.get(key) ?? return None
    if writers.len() == 0 -> return None
    Val(writers[0].value)
}

// The one lowered integration of `kind` in a plan.
envmodel_test_integration: fn(plan: EnvPlan, kind: IntegrationKind) -> EnvironmentIntegration {
    loop integration in plan.integrations {
        if integration.kind == kind -> return integration
    }
    panic("the plan has no {kind.as_str()} integration")
}

envmodel_test_env_error: fn(result: EnvPlan EnvModelEvalError!) -> Diagnostic {
    if result == {
        .Ok(_) -> panic("expected the environment to be rejected")
        .Err(error) -> error.diagnostic
    }
}

envmodel_test_source_error: fn(result: [EvaluatedModule] EnvModelEvalError!) -> Diagnostic {
    if result == {
        .Ok(_) -> panic("expected the source to be rejected")
        .Err(error) -> error.diagnostic
    }
}

envmodel_test_profile_error: fn(result: PackageProfilePlan EnvModelEvalError!) -> Diagnostic {
    if result == {
        .Ok(_) -> panic("expected the package generation to be rejected")
        .Err(error) -> error.diagnostic
    }
}

// Rust `Diagnostics::render_all(file, src, &[diagnostic])`.
envmodel_test_render: fn(file: String, src: String, diagnostic: Diagnostic) -> String {
    diagnostic_render_all(file, src, [Diagnostic]{diagnostic}, false)
}

// `rendered` with the fresh directory `dir` (envmodel_test_fresh_dir(slug))
// spelled `<TMP>/modeval-<slug>`, so the pinned snapshot does not depend on
// the generated directory name.
envmodel_test_redact_dir: fn(rendered: String, dir: String, slug: String) -> String {
    rendered.replace(dir, "<TMP>/modeval-{slug}")
}

// Compare a rendered diagnostic with its pinned snapshot; `UPDATE_EXPECT`
// rewrites the snapshot first.
envmodel_test_check_snapshot: fn(code: String, rendered: String) -[FS, Env]> {
    assert(rendered.starts_with("Error [{diagnostic_display_name(code)}]:"))
    assert(rendered.contains("\n Why: "))
    assert(rendered.contains("\n Fix: "))
    path: files.join(envmodel_test_repo_root(), "tests/fixtures/module-eval-diagnostics/{code}.stderr")
    if sys.get("UPDATE_EXPECT") != None {
        files.create_dir_all(files.dirname(path)) ?? panic("create the snapshot directory")
        files.write(path, rendered) ?? panic("write the snapshot")
    }
    expected: files.read(path) ?? panic("missing diagnostic snapshot {path}")
    assert_eq(rendered, expected)
}

// EnvPlan carries no fleet or vmtest captures: `envmodel_evaluate_env`
// cross-checks each host's system, and the evaluated modules keep the groups.
envmodel_test_host_groups: fn(source: String, vmtests: Bool) -[Env, Exec, FS]> [FleetPlan] {
    base: envmodel_test_base_dir()
    _: envmodel_evaluate_env(source, base) ?? panic("the host environment evaluates")
    modules: envmodel_evaluate_source(source, base) ?? panic("the host source evaluates")
    groups := [FleetPlan]{}
    loop evaluated in modules {
        captured: if vmtests -> evaluated.vmtests else -> evaluated.fleets
        loop group in captured -> groups.push(group)
    }
    groups
}
