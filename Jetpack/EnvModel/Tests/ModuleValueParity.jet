// One source revision, every module-value consumer: environment fields,
// image fields and fleet host overrides read the same top-level value through
// the one evaluator, in the same dependency order with the same provenance,
// and a permuted copy of the revision plans identically (#4276 c39).
use {
    jet_env_model.[
        ENVMODEL_ENVIRONMENT_SCHEMA,
        FleetPlan,
        OptionPlan,
        PromptPathMode,
        ReloadPolicy,
        SecretGenerator,
        SecretRotationPolicy,
        envmodel_evaluate_env,
        envmodel_evaluate_source,
        envmodel_find_jet_binary,
        envmodel_parse_program,
        module_values_evaluate,
        module_values_program,
    ]
    jet_foundation.[CtValue, ast_comptime_value_show]
    jet_pkg_model.[EntryContribution, FactValue]
    files: core.files
    process: core.process
}

// `PORT` comes from a pure helper and feeds every consumer; `label` and
// `region` are sibling chains on top of it.
MODULE_VALUE_SOURCE: `
base_port: fn() -> Int { 8000 }

PORT: #run { base_port() + 1 }

dev: module {
    env.dev: Env{
        port: PORT,
        label: if port > 8000 -> "ready" else -> "waiting",
    }
}

image.server: module {
    from: packages.app,
    expose: [PORT],
}

system.web: module { target: linux.x64, options: [tuning.port: PORT + 1, network.hostName: web-east, services.desktop.profile: .Default] }

fleet.prod: module {
    hosts: {
        web1: system.web{ port: PORT, region: port + 1, options: [tuning.port: PORT + 1, network.hostName: web1] }
    }
}
`

// The same revision with its declarations and sibling fields reordered: the
// value is declared after its readers and every chain is written backwards.
MODULE_VALUE_SOURCE_PERMUTED: `
fleet.prod: module {
    hosts: {
        web1: system.web{ options: [tuning.port: PORT + 1, network.hostName: web1], region: port + 1, port: PORT }
    }
}

system.web: module { target: linux.x64, options: [tuning.port: PORT + 1, network.hostName: web-east, services.desktop.profile: .Default] }

image.server: module {
    expose: [PORT],
    from: packages.app,
}

dev: module {
    env.dev: Env{
        label: if port > 8000 -> "ready" else -> "waiting",
        port: PORT,
    }
}

PORT: #run { base_port() + 1 }

base_port: fn() -> Int { 8000 }
`

// Module values with and without `#run`, as a program and an environment
// both declare them. The compiler computes every immutable module value
// while building, so the environment reads the same ones.
MODULE_VALUES_PLAIN_AND_RUN: `
base_port: fn() -> Int { 8000 }

BASE: base_port()
STEP: 2
PORT: #run { BASE + STEP }
LABEL: "web-{PORT}"
`

// The program that prints them, and the environment fields and image that
// read them.
MODULE_VALUES_PRINTED: `
run: fn() { print("{BASE} {STEP} {PORT} {LABEL}") }
`

MODULE_VALUES_CONSUMED: `
dev: module { env.dev: Env{ base: BASE, step: STEP, port: PORT, label: LABEL } }

image.server: module { from: packages.app, expose: [STEP, BASE, PORT] }
`

// What `run` prints when `jet run` builds `source` as a program.
module_values_as_the_program_prints_them: fn(source: String) -[FS, Env, Exec, Time.Wait]> String {
    dir: envmodel_test_fresh_dir("module-value-program")
    program: files.join(dir, "main.jet")
    files.write(program, source) ?? panic("write the program")
    child: process.cmd([String]{envmodel_find_jet_binary(), "run", program}).stdout(.Capture).stderr(.Capture).spawn() ?? panic("start jet run: {err}")
    receipt: child.wait() ?? panic("await jet run: {err}")
    assert(receipt.code == 0, receipt.errors)
    files.remove_all(dir) ?? panic("remove the program")
    receipt.output.trim()
}

#Test("module_values_with_and_without_run_match_the_program") {
    assert_eq(module_values_as_the_program_prints_them("{MODULE_VALUES_PLAIN_AND_RUN}{MODULE_VALUES_PRINTED}"), "8000 2 8002 web-8002")
    dir: envmodel_test_oci_base_dir("module-value-plain")
    source: "{MODULE_VALUES_PLAIN_AND_RUN}{MODULE_VALUES_CONSUMED}"
    plan: envmodel_evaluate_env(source, dir) ?? panic("the revision plans: {err.diagnostic.what}")
    assert_eq(plan.images[0].expose, [Int]{2, 8000, 8002})
    modules: envmodel_evaluate_source(source, dir) ?? panic("the revision evaluates")
    entry: modules[0].entries[0].entry
    assert_eq(envmodel_test_setting_value(entry, "base"), Val(FactValue.Text{value: "8000"}))
    assert_eq(envmodel_test_setting_value(entry, "step"), Val(FactValue.Text{value: "2"}))
    assert_eq(envmodel_test_setting_value(entry, "port"), Val(FactValue.Text{value: "8002"}))
    assert_eq(envmodel_test_setting_value(entry, "label"), Val(FactValue.Text{value: "web-8002"}))
    files.remove_all(dir) ?? return
}

#Test("module_value_consumers_read_one_value_in_one_order") {
    dir: envmodel_test_oci_base_dir("module-value-parity")
    plan: envmodel_evaluate_env(MODULE_VALUE_SOURCE, dir) ?? panic("the revision plans")
    modules: envmodel_evaluate_source(MODULE_VALUE_SOURCE, dir) ?? panic("the revision evaluates")
    env_entry := EntryContribution?{None}
    loop evaluated in modules {
        if evaluated.name == "dev" -> env_entry = Val(evaluated.entries[0].entry)
    }
    entry: env_entry ?? panic("the dev module has an environment entry")
    assert_eq(envmodel_test_setting_value(entry, "port"), Val(FactValue.Text{value: "8001"}))
    assert_eq(envmodel_test_setting_value(entry, "label"), Val(FactValue.Text{value: "ready"}))
    assert_eq(plan.images[0].expose, [Int]{8001})
    // A system option reading the value is evaluated; literal atoms keep their spelling.
    assert_eq(
        plan.systems[0].options,
        [OptionPlan]{
            OptionPlan{key: "tuning.port", value: "8002"},
            OptionPlan{key: "network.hostName", value: "web-east"},
            OptionPlan{key: "services.desktop.profile", value: ".Default"},
        },
    )
    fleets := [FleetPlan]{}
    loop evaluated in modules {
        loop fleet in evaluated.fleets -> fleets.push(fleet)
    }
    assert_eq(fleets.len(), 1)
    overrides: fleets[0].hosts[0].overrides ?? panic("web1 has an override")
    values := [String:CtValue]{}
    host_options := [OptionPlan]{}
    loop field in overrides.fields {
        if field.value == {
            .Value(value) -> { values[field.name] = value }
            .Options(options) -> host_options = options
            .Platform(_) | .Packages(_) | .Services(_) -> {}
        }
    }
    // The host override evaluates the same option the same way the system does.
    assert_eq(host_options, [OptionPlan]{OptionPlan{key: "tuning.port", value: "8002"}, OptionPlan{key: "network.hostName", value: "web1"}})
    assert_eq(values.get("port"), Val(CtValue.Int{value: 8001}))
    assert_eq(values.get("region"), Val(CtValue.Int{value: 8002}))
    found := false
    loop row in overrides.provenance {
        if row.field == "region" {
            assert_eq(row.dependencies, [String]{"port"})
            assert(row.pure)
            found = true
        }
        if row.field == "port" -> assert_eq(row.dependencies, [String]{})
    }
    assert(found, "region provenance names its sibling")
    files.remove_all(dir) ?? return
}

#Test("module_value_consumers_plan_a_permuted_revision_identically") {
    dir: envmodel_test_oci_base_dir("module-value-permuted")
    written: envmodel_evaluate_env(MODULE_VALUE_SOURCE, dir) ?? panic("the revision plans")
    permuted: envmodel_evaluate_env(MODULE_VALUE_SOURCE_PERMUTED, dir) ?? panic("the permuted revision plans")
    again: envmodel_evaluate_env(MODULE_VALUE_SOURCE, dir) ?? panic("the revision plans again")
    assert_eq(written.images, permuted.images)
    assert_eq(written.prompt, permuted.prompt)
    assert_eq(written, again)
    changed: envmodel_evaluate_env(MODULE_VALUE_SOURCE.replace("8000", "9000"), dir) ?? panic("the changed revision plans")
    assert_eq(changed.images[0].expose, [Int]{9001})
    assert(changed.images != written.images, "a changed value changes the plan")
    files.remove_all(dir) ?? return
}

#Test("module_value_self_cycle_is_reported_before_any_consumer") {
    source: "PORT: #run {{ PORT + 1 }}\nimage.server: module {{ from: packages.app, expose: [PORT] }}\n"
    dir: envmodel_test_oci_base_dir("module-value-self-cycle")
    error: envmodel_test_env_error(envmodel_evaluate_env(source, dir))
    assert_eq(error.code, "E0338")
    assert(error.what.contains("PORT -> PORT"), error.what)
    files.remove_all(dir) ?? return
}

#Test("module_value_multi_node_cycle_is_reported_before_any_consumer") {
    source: "FIRST: #run {{ SECOND + 1 }}\nSECOND: #run {{ FIRST + 1 }}\nsystem.web: module {{ target: linux.x64, options: [tuning.port: FIRST] }}\n"
    error: envmodel_test_env_error(envmodel_evaluate_env(source, envmodel_test_base_dir()))
    assert_eq(error.code, "E0338")
    assert(error.what.contains("FIRST -> SECOND -> FIRST"), error.what)
}

// The headline and the `file:line:col` of a rendered refusal, the
// directory of its file left out.
module_value_refusal_head: fn(rendered: String) -> String {
    head := [String]{}
    loop line in rendered.split("\n") {
        trimmed: line.trim()
        if trimmed.starts_with("Error") -> head.push(trimmed)
        if trimmed.starts_with("-->") {
            parts: trimmed.split("/").to_list()
            head.push("--> {parts[parts.len() - 1].removeprefix("--> ")}")
        }
        if head.len() == 2 -> break
    }
    head.join("\n")
}

// What `jet run` refuses `program` with.
module_values_as_the_program_refuses_them: fn(program: String) -[FS, Env, Exec, Time.Wait]> String {
    dir: envmodel_test_fresh_dir("module-value-refusal")
    path: files.join(dir, "main.jet")
    files.write(path, program) ?? panic("write the program")
    child: process.cmd([String]{envmodel_find_jet_binary(), "run", path}).stdout(.Capture).stderr(.Capture).spawn() ?? panic("start jet run: {err}")
    receipt: child.wait() ?? panic("await jet run: {err}")
    assert(receipt.code != 0, receipt.output)
    files.remove_all(dir) ?? panic("remove the program")
    module_value_refusal_head(receipt.errors)
}

// `declarations` as a program that prints `TOTAL`, refused by `jet run`,
// and as an environment whose image exposes `TOTAL`: the environment is
// refused with the program's diagnostic at the program's place.
module_value_refusal_matches_the_program: fn(declarations: String, slug: String) -[FS, Env, Exec, Time.Wait]> String {
    program: "{declarations}\nrun: fn() {{ print(TOTAL) }}\n"
    expected: module_values_as_the_program_refuses_them(program)
    source: "{program}\nimage.server: module {{ from: packages.app, expose: [TOTAL] }}\n"
    dir: envmodel_test_oci_base_dir(slug)
    error: envmodel_test_env_error(envmodel_evaluate_env(source, dir))
    files.remove_all(dir) ?? panic("remove the environment")
    assert_eq(module_value_refusal_head(envmodel_test_render("main.jet", source, error)), expected)
    expected
}

#Test("module_value_typed_struct_with_field_defaults_matches_the_program") {
    declarations: "Server: struct {{\n    port: Int{{80}}\n    host: String{{\"web\"}}\n}}\n\nSERVER: Server{{}}\n\nTOTAL: #run {{ SERVER.port + 1 }}\nLABEL: \"{{SERVER.host}}-{{TOTAL}}\"\n"
    assert_eq(module_values_as_the_program_prints_them("{declarations}\nrun: fn() {{ print(\"{{TOTAL}} {{LABEL}}\") }}\n"), "81 web-81")
    dir: envmodel_test_oci_base_dir("module-value-typed")
    source: "{declarations}\ndev: module {{ env.dev: Env{{ label: LABEL }} }}\n\nimage.server: module {{ from: packages.app, expose: [TOTAL] }}\n"
    plan: envmodel_evaluate_env(source, dir) ?? panic("the revision plans: {err.diagnostic.what}")
    assert_eq(plan.images[0].expose, [Int]{81})
    modules: envmodel_evaluate_source(source, dir) ?? panic("the revision evaluates")
    assert_eq(envmodel_test_setting_value(modules[0].entries[0].entry, "label"), Val(FactValue.Text{value: "web-81"}))
    files.remove_all(dir) ?? return
}

#Test("module_value_cycle_is_the_programs_cycle_at_the_value") {
    head: module_value_refusal_matches_the_program("TOTAL: #run {{ TOTAL + 1 }}\n", "module-value-cycle-parity")
    assert(head.contains("jet.ComputedFieldCycle"), head)
    assert(head.contains("TOTAL -> TOTAL"), head)
    assert(head.contains("--> main.jet:1:15"), head)
}

#Test("module_value_effect_without_gate_is_the_programs_refusal") {
    head: module_value_refusal_matches_the_program("noisy: fn() -> Int {{\n    print(\"hi\")\n    3\n}}\n\nTOTAL: #run noisy()\n", "module-value-effect-parity")
    assert(head.contains("jet.ComptimeEffectWithoutImpure"), head)
    assert(head.contains("--> main.jet:6:13"), head)
}

#Test("module_value_not_built_is_the_programs_refusal") {
    head: module_value_refusal_matches_the_program("counted: fn() -> Int {{\n    print(\"counting\")\n    3\n}}\n\nTOTAL: counted()\n", "module-value-not-built-parity")
    assert(head.contains("jet.ModuleValueNotBuilt"), head)
    assert(head.contains("--> main.jet:6:8"), head)
}

// The field names of a checked record, in order.
module_value_field_names: fn(value: CtValue) -> [String] {
    if value == .Struct(_, fields) -> return loop field in fields -> field.name
    panic("not a record: {ast_comptime_value_show(value)}")
}

SCHEMA_VALUES: "PROMPT: Prompt{{ label: \"x\", path: .Short }}\nLANGS: [\"rust\": Lang{{ enable: true, channel: .Stable }}]\n"

#Test("environment_schema_types_the_programs_values") {
    printed: module_values_as_the_program_prints_them("{SCHEMA_VALUES}\nrun: fn() {{ print(\"{{PROMPT.label ?? \"\"}} {{LANGS.len()}} {{PROMPT.strip == None}}\") }}\n\n{ENVMODEL_ENVIRONMENT_SCHEMA}")
    assert_eq(printed, "x 1 true")
}

#Test("module_value_of_a_schema_type_is_its_written_fields") {
    dir: envmodel_test_oci_base_dir("module-value-schema")
    program: envmodel_parse_program(SCHEMA_VALUES) ?? panic("the values parse: {err.diagnostic.what}")
    values_program: module_values_program(program.items, SCHEMA_VALUES, [String:CtValue]{}, "") ?? panic("the program builds: {err.diagnostic.what}")
    outcome: module_values_evaluate(values_program.text, dir) ?? panic("the compiler answers: {err.detail}")
    files.remove_all(dir) ?? panic("remove the directory")
    computed := [String:CtValue]{}
    if outcome == {
        .Values(values, unreadable) -> {
            assert_eq(unreadable, [String]{})
            loop named in values -> computed[named.name] = named.value
        }
        .Refused(diagnostic) -> panic("the values are refused: {diagnostic.what}")
    }
    prompt: computed.get("PROMPT") ?? panic("PROMPT is computed")
    assert_eq(module_value_field_names(prompt), [String]{"label", "path"})
    assert(ast_comptime_value_show(prompt).contains("Short"), ast_comptime_value_show(prompt))
    languages: computed.get("LANGS") ?? panic("LANGS is computed")
    if languages == .Map(entries) {
        assert_eq(entries.len(), 1)
        assert_eq(module_value_field_names(entries[0].value), [String]{"enable", "channel"})
        assert(ast_comptime_value_show(entries[0].value).contains("Stable"), ast_comptime_value_show(entries[0].value))
    } else { panic("LANGS is a map: {ast_comptime_value_show(languages)}") }
}

#Test("module_value_of_a_schema_type_is_refused_at_the_value_as_the_program_is") {
    declarations: "PROMPT: Prompt{{ label: 5 }}\n"
    expected: module_values_as_the_program_refuses_them("{declarations}\nrun: fn() {{}}\n\n{ENVMODEL_ENVIRONMENT_SCHEMA}")
    source: "{declarations}\nimage.server: module {{ from: packages.app }}\n"
    dir: envmodel_test_oci_base_dir("module-value-schema-refusal")
    error: envmodel_test_env_error(envmodel_evaluate_env(source, dir))
    files.remove_all(dir) ?? panic("remove the environment")
    head: module_value_refusal_head(envmodel_test_render("main.jet", source, error))
    assert_eq(head, expected)
    assert(head.contains("--> main.jet:1:"), head)
}

// Environment fields the compiler computes: a sibling read before its field,
// a headless prompt record typed as a `Prompt`, and a map of headless preset
// records typed as `Preset`s.
ENV_FIELD_VALUES: `
BASE: 8000

dev: module {
    env.dev: Env{
        url: "http://localhost:{port}",
        port: BASE + 1,
        prompt: { label: "dev-{port}", path: .Full },
        presets: ["ambient": { hostname: "host-{port}", extends: ["base"] }, "base": { variables: ["MODE": "dev"] }],
    }
}
`

#Test("env_field_values_are_the_compilers_in_any_order") {
    dir: envmodel_test_oci_base_dir("env-field-values")
    plan: envmodel_evaluate_env(ENV_FIELD_VALUES, dir) ?? panic("the revision plans: {err.diagnostic.what}")
    assert_eq(plan.prompt, Val("dev-8001"))
    assert_eq(plan.prompt_path, PromptPathMode.Full)
    assert_eq(plan.presets.len(), 2)
    loop preset in plan.presets {
        if preset.name == "ambient" {
            assert_eq(preset.hostname, Val("host-8001"))
            assert_eq(preset.extends, [String]{"base"})
        }
        if preset.name == "base" -> assert_eq(preset.variables.get("MODE"), Val("dev"))
    }
    modules: envmodel_evaluate_source(ENV_FIELD_VALUES, dir) ?? panic("the revision evaluates")
    entry: modules[0].entries[0].entry
    assert_eq(envmodel_test_setting_value(entry, "url"), Val(FactValue.Text{value: "http://localhost:8001"}))
    assert_eq(envmodel_test_setting_value(entry, "port"), Val(FactValue.Text{value: "8001"}))
    files.remove_all(dir) ?? return
}

// A call and a method call are computed whole: the syntax tree spans each by
// its name, but the value is the name with its receiver and arguments.
ENV_FIELD_CALLS: `
BASE: 8000

port_of: fn(base: Int) -> Int { base + 2 }

dev: module {
    env.dev: Env{
        port: port_of(BASE),
        size: "dev-{port}".len(),
    }
}
`

#Test("env_field_calls_are_computed_whole") {
    dir: envmodel_test_oci_base_dir("env-field-calls")
    modules: envmodel_evaluate_source(ENV_FIELD_CALLS, dir) ?? panic("the revision evaluates")
    files.remove_all(dir) ?? panic("remove the environment")
    entry: modules[0].entries[0].entry
    assert_eq(envmodel_test_setting_value(entry, "port"), Val(FactValue.Text{value: "8002"}))
    assert_eq(envmodel_test_setting_value(entry, "size"), Val(FactValue.Text{value: "8"}))
}

#Test("env_field_cycle_names_the_fields_at_the_field") {
    source: "dev: module {{\n    env.dev: Env{{\n        port: label.len(),\n        label: \"x{{port}}\",\n    }}\n}}\n"
    dir: envmodel_test_oci_base_dir("env-field-cycle")
    error: envmodel_test_env_error(envmodel_evaluate_env(source, dir))
    files.remove_all(dir) ?? panic("remove the environment")
    head: module_value_refusal_head(envmodel_test_render("main.jet", source, error))
    assert_eq(error.code, "E0338")
    assert(error.what.contains("port -> label -> port") || error.what.contains("label -> port -> label"), error.what)
    assert(!error.what.contains("ENVMODEL_VALUE"), error.what)
    assert(head.contains("--> main.jet:3:") || head.contains("--> main.jet:4:"), head)
}

#Test("env_field_error_inside_a_nested_record_is_at_its_line") {
    source: "dev: module {{\n    env.dev: Env{{\n        presets: [\n            \"ambient\": {{ user: \"me\" }},\n            \"web\": {{ hostname: 5 }},\n        ],\n    }}\n}}\n"
    dir: envmodel_test_oci_base_dir("env-field-nested-error")
    error: envmodel_test_env_error(envmodel_evaluate_env(source, dir))
    files.remove_all(dir) ?? panic("remove the environment")
    head: module_value_refusal_head(envmodel_test_render("main.jet", source, error))
    assert(head.contains("jet.BindingTypeMismatch"), head)
    assert(head.contains("--> main.jet:5:32"), head)
    assert(!error.what.contains("ENVMODEL_VALUE"), error.what)
}

// Lifecycle and secret values the compiler computes, inside the EnvModel
// syntax (job names, `.Watch{ … }`, `random(…)`, the secret map) that stays
// around them.
ENV_LIFECYCLE_SECRET_VALUES: `
HOOKS: "scripts"
LENGTH: 16
APP: "app"
TOKEN: "TOKEN"

dev: module {
    env.dev: Env{
        git_hooks_path: "{HOOKS}/githooks",
        unset: ["OLD_{TOKEN}"],
        reload: .Watch{ watch: ["src/{APP}"], debounce: 100 * 2 },
        secrets: {
            API_KEY: { required: false, description: "key for {HOOKS}", generate: random(length: LENGTH * 2) },
        },
    }
}
`

#Test("lifecycle_and_secret_values_are_the_compilers") {
    dir: envmodel_test_oci_base_dir("env-lifecycle-secret-values")
    plan: envmodel_evaluate_env(ENV_LIFECYCLE_SECRET_VALUES, dir) ?? panic("the revision plans: {err.diagnostic.what}")
    files.remove_all(dir) ?? panic("remove the environment")
    assert_eq(plan.lifecycle.git_hooks_path, Val("scripts/githooks"))
    assert_eq(plan.lifecycle.unset, [String]{"OLD_TOKEN"})
    assert_eq(plan.lifecycle.reload, ReloadPolicy.Watch{paths: [String]{"src/app"}, debounce_ms: 200})
    assert_eq(plan.secrets.len(), 1)
    assert_eq(plan.secrets[0].description, Val("key for scripts"))
    assert(!plan.secrets[0].required)
    assert_eq(plan.secrets[0].generate, SecretGenerator.Random{length: 32})
}

#Test("lifecycle_and_secret_value_errors_are_at_their_line") {
    lifecycle: "dev: module {{\n    env.dev: Env{{\n        unset: [\"A\"],\n        git_hooks_path: \"a\" + 1,\n    }}\n}}\n"
    secret: "dev: module {{\n    env.dev: Env{{\n        secrets: {{\n            API_KEY: {{ required: false, generate: random(length: \"x\" * 2) }},\n        }},\n    }}\n}}\n"
    sources: [String]{lifecycle, secret}
    loop source in sources {
        dir: envmodel_test_oci_base_dir("env-lifecycle-secret-error")
        error: envmodel_test_env_error(envmodel_evaluate_env(source, dir))
        files.remove_all(dir) ?? panic("remove the environment")
        head: module_value_refusal_head(envmodel_test_render("main.jet", source, error))
        assert(head.contains("--> main.jet:4:"), head)
        assert(!error.what.contains("ENVMODEL_VALUE"), error.what)
    }
}

// `max_age(…)` and `random(…)` are the schema's functions: the compiler
// computes the age in seconds from the duration as written, saturating at
// Int's largest, and the generator's length.
ENV_SECRET_POLICY_CALLS: `
DAYS: 45

dev: module {
    env.dev: Env{
        secrets: {
            DAILY: { required: false, rotation: max_age(90d), generate: random(length: DAYS - 13) },
            HOURLY: { required: false, rotation: max_age(2hours) },
            MINUTELY: { required: false, rotation: max_age(30m) },
            SECONDLY: { required: false, rotation: max_age(45sec) },
            FOREVER: { required: false, rotation: max_age(9223372036854775807d) },
        },
    }
}
`

#Test("secret_policy_calls_are_the_schemas") {
    dir: envmodel_test_oci_base_dir("env-secret-policy-calls")
    plan: envmodel_evaluate_env(ENV_SECRET_POLICY_CALLS, dir) ?? panic("the revision plans: {err.diagnostic.what}")
    files.remove_all(dir) ?? panic("remove the environment")
    ages := [String:SecretRotationPolicy]{}
    loop secret in plan.secrets {
        ages[secret.name] = secret.rotation
        if secret.name == "DAILY" -> assert_eq(secret.generate, SecretGenerator.Random{length: 32})
    }
    assert_eq(ages.get("DAILY"), Val(SecretRotationPolicy.MaxAge{seconds: 7776000}))
    assert_eq(ages.get("HOURLY"), Val(SecretRotationPolicy.MaxAge{seconds: 7200}))
    assert_eq(ages.get("MINUTELY"), Val(SecretRotationPolicy.MaxAge{seconds: 1800}))
    assert_eq(ages.get("SECONDLY"), Val(SecretRotationPolicy.MaxAge{seconds: 45}))
    assert_eq(ages.get("FOREVER"), Val(SecretRotationPolicy.MaxAge{seconds: 9223372036854775807}))
}

#Test("secret_policy_call_errors_are_at_their_line") {
    age: "dev: module {{\n    env.dev: Env{{\n        secrets: {{\n            API_KEY: {{ required: false, rotation: max_age(90, 1) }},\n        }},\n    }}\n}}\n"
    length: "dev: module {{\n    env.dev: Env{{\n        secrets: {{\n            API_KEY: {{ required: false, generate: random(size: 32) }},\n        }},\n    }}\n}}\n"
    sources: [String]{age, length}
    loop source in sources {
        dir: envmodel_test_oci_base_dir("env-secret-policy-error")
        error: envmodel_test_env_error(envmodel_evaluate_env(source, dir))
        files.remove_all(dir) ?? panic("remove the environment")
        head: module_value_refusal_head(envmodel_test_render("main.jet", source, error))
        assert(head.contains("--> main.jet:4:"), head)
        assert(!error.what.contains("ENVMODEL_VALUE"), error.what)
    }
}
