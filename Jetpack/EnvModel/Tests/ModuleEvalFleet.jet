#Test("fleet override computes dependencies before typed fields") {
    src :: "module system.web {{ target: linux.x64 }}\nmodule fleet.prod {{ hosts: {{ edge: system.web.{{ services: {{ ssh: {{ enable: enabled, ports: [port] }} }}, options: [network.port: port, packages.shell: default.fish, network.hostName: laptop, timezone: \"UTC\"], target: linux.arm64, packages: [default.fd], port: base + 2, enabled: true, base: 20 }} }} }}"
    plan :: envmodel_evaluate_env(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    override :: plan.fleets[0].hosts[0].overrides ?? panic("typed override")
    assert_eq(override.fields[0].value, HostOverrideValue.Services{values: [ServicePlan]{ServicePlan{name: "ssh", enable: true, extra: [ServicePlanExtra]{ServicePlanExtra{key: "ports", value: "[22]"}}}}})
    assert_eq(override.fields[1].value, HostOverrideValue.Options{values: [OptionPlan]{OptionPlan{key: "network.port", value: "22"}, OptionPlan{key: "packages.shell", value: "default.fish"}, OptionPlan{key: "network.hostName", value: "laptop"}, OptionPlan{key: "timezone", value: "\"UTC\""}}})
    assert_eq(override.fields[2].value, HostOverrideValue.Platform{value: "linux.arm64"})
    assert_eq(override.fields[3].value, HostOverrideValue.Packages{values: [Pkg]{Pkg.new("default", "fd")}})
    assert_eq(override.provenance[0].dependencies, [String]{"enabled", "port"})
    assert_eq(override.provenance[1].dependencies, [String]{"port"})
    assert_eq(override.provenance[4].dependencies, [String]{"base"})
    assert(override.provenance[4].source.contains("port: base + 2"))
    loop fact in override.provenance -> assert(fact.pure)
}

#Test("fleet override cycles and ambient effects use canonical controls") {
    cycle :: "module system.web {{ target: linux.x64 }} module fleet.prod {{ hosts: {{ edge: system.web.{{ first: second, second: first }} }} }}"
    assert_eq(envmodel_test_env_error(envmodel_evaluate_env(cycle, envmodel_test_base_dir())).code, "E0338")
    impure :: "module system.web {{ target: linux.x64 }} module fleet.prod {{ hosts: {{ edge: system.web.{{ region: read_file(\"region\") }} }} }}"
    assert_eq(envmodel_test_env_error(envmodel_evaluate_env(impure, envmodel_test_base_dir())).code, "E3402")
}

#Test("fleet assembly retains multiple modules and import order") {
    dir :: envmodel_test_fresh_dir("fleet-import-order")
    modules :: files.join(dir, "modules")
    files.create_dir_all(modules) ?? panic("create module directory")
    files.write(files.join(modules, "a.jet"), "module system.imported {{ target: linux.arm64 }} module fleet.imported {{ hosts: {{ second: system.root }} }}") ?? panic("write first import")
    files.write(files.join(modules, "b.jet"), "module system.last {{ target: linux.x64 }}") ?? panic("write second import")
    src :: "module root {{ imports: find(\"./modules\") system.root: {{ target: linux.x64 }} fleet.root: {{ hosts: {{ first: system.imported }} }} }}"
    plan :: envmodel_evaluate_env(src, dir) ?? panic(err.diagnostic.what)
    assert_eq(plan.systems.len(), 3)
    assert_eq(plan.systems[0].name, "root")
    assert_eq(plan.systems[1].name, "imported")
    assert_eq(plan.systems[2].name, "last")
    assert_eq(plan.fleets[0].name, "root")
    assert_eq(plan.fleets[1].name, "imported")
    assert_eq(plan.source_files, [String]{"env.jet", "modules/a.jet", "modules/b.jet"})
    assert_eq(plan.graph_identity, None)
    files.remove_all(dir) ?? panic("remove fixture")
}

#Test("fleet source producer captures before environment selection") {
    src :: "module env.dev {{ packages: [] }} module env.other {{ packages: [] }} module system.web {{ target: linux.x64 }} module fleet.prod {{ hosts: {{ only: system.web }} }}"
    modules :: envmodel_evaluate_source(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    assert_eq(modules[2].systems[0].name, "web")
    assert_eq(modules[3].fleets[0].name, "prod")
    plan :: envmodel_evaluate_env_with_environment(src, envmodel_test_base_dir(), Val("other")) ?? panic(err.diagnostic.what)
    assert_eq(plan.active_environment, Val("other"))
    assert_eq(plan.systems[0], modules[2].systems[0])
    assert_eq(plan.fleets[0], modules[3].fleets[0])
}

#Test("bad image format is e0976") {
    src :: "module m {{ system.s: {{ target: linux.x64 }} image.i: {{ from: system.s, format: dmg }} }}"
    error :: envmodel_test_env_error(envmodel_evaluate_env(src, envmodel_test_base_dir()))
    assert_eq(error.code, "E0976")
    rendered :: envmodel_test_render("config.jet", src, error)
    assert(rendered.contains("`dmg` isn't a disk-image format"))
    envmodel_test_check_snapshot("E0976", rendered)
}

#Test("image cross compile target is allowed") {
    src :: "module m {{ system.s: {{ target: linux.x64 }} image.i: {{ from: system.s, target: linux.arm64 }} }}"
    plan :: envmodel_evaluate_env(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    assert_eq(plan.images[0].target, Val("linux.arm64"))
}

#Test("image from unknown system is e0978") {
    src :: "module m {{ image.i: {{ from: system.nope }} }}"
    error :: envmodel_test_env_error(envmodel_evaluate_env(src, envmodel_test_base_dir()))
    assert_eq(error.code, "E0978")
    rendered :: envmodel_test_render("config.jet", src, error)
    assert(rendered.contains("unknown system `nope`"))
    envmodel_test_check_snapshot("E0978", rendered)
}

#Test("iso image keeps format and validates known systems before fleets") {
    src :: "module system.web {{ target: linux.x64 }} module image.disk {{ from: system.web, kind: .Iso, format: qcow, target: linux.arm64 }} module image.rawdisk {{ from: system.web, format: raw }}"
    plan :: envmodel_evaluate_env(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    assert_eq(plan.images[0].kind, ImageKind.Iso)
    assert_eq(plan.images[0].format, "qcow")
    assert_eq(plan.images[0].target, Val("linux.arm64"))
    assert_eq(plan.images[1].format, "raw")
    mismatch :: "module system.web {{ target: linux.x64 }} module image.disk {{ from: system.web, kind: .Oci }}"
    assert_eq(envmodel_test_env_error(envmodel_evaluate_env(mismatch, envmodel_test_base_dir())).code, "E1266")
    oci_fields :: "module system.web {{ target: linux.x64 }} module image.disk {{ from: system.web, expose: [22] }}"
    assert_eq(envmodel_test_env_error(envmodel_evaluate_env(oci_fields, envmodel_test_base_dir())).code, "E0977")
    unknown :: "module image.disk {{ from: system.missing }} module fleet.prod {{ hosts: {{ edge: system.missing }} }}"
    assert_eq(envmodel_test_env_error(envmodel_evaluate_env(unknown, envmodel_test_base_dir())).code, "E0978")
}

#Test("host source uses saturating byte offsets and invalid slice fallback") {
    source :: "  {{ region: \"é\" }}  "
    assert_eq(envmodel_host_field_source(source, Span{start: 1, end: 200}, 32), "{{ region: \"é\" }}")
    assert_eq(envmodel_host_field_source("é", Span{start: 0, end: 1}, 0), "é")
    assert_eq(envmodel_host_field_source(" abc ", Span{start: 33, end: 36}, 32), "abc")
    assert_eq(envmodel_host_field_source(" abc ", Span{start: 1, end: 1}, 32), "")
}
