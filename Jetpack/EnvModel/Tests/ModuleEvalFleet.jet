// Original ModuleEval/mod.rs System dependency and all five Fleet claims.
// ISO-dependent originals remain intact: ImageEval is the canonical provider.
#Test("fleet captures hosts and cross checks") {
    src :: "\nmodule system.web {{ target: linux.x64 }}\nmodule fleet.prod {{\n    hosts: {{\n        web1: system.web.{{ region: \"us-east\" }},\n        web2: system.web.{{ region: \"eu-west\" }},\n    }}\n}}\n"
    plan :: envmodel_evaluate_env(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    assert_eq(plan.systems.len(), 1)
    assert_eq(plan.fleets.len(), 1)
    fleet :: plan.fleets[0]
    assert_eq(fleet.name, "prod")
    assert_eq(fleet.hosts.len(), 2)
    assert_eq(fleet.hosts[0].name, "web1")
    assert_eq(fleet.hosts[0].system, "web")
    assert_eq(fleet.hosts[0].override_source, Val("{{ region: \"us-east\" }}"))
    override :: fleet.hosts[0].overrides ?? panic("typed override")
    assert_eq(override.fields[0].name, "region")
    assert_eq(override.fields[0].value, HostOverrideValue.Value{value: CtValue.Str{value: "us-east"}})
    assert_eq(fleet.hosts[1].name, "web2")
    assert_eq(fleet.hosts[1].system, "web")
}

#Test("fleet bare host ref has no overrides") {
    src :: "\nmodule system.web {{ target: linux.x64 }}\nmodule fleet.prod {{ hosts: {{ only: system.web }} }}\n"
    plan :: envmodel_evaluate_env(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    assert_eq(plan.fleets[0].hosts[0].overrides, None)
    assert_eq(plan.fleets[0].hosts[0].override_source, None)
}

#Test("fleet host unknown system is e1242") {
    src :: "module fleet.prod {{ hosts: {{ web1: system.nope }} }}"
    error :: envmodel_test_env_error(envmodel_evaluate_env(src, envmodel_test_base_dir()))
    assert_eq(error.code, "E1242")
    assert(envmodel_test_render("config.jet", src, error).contains("host `web1` names an unknown system `nope`"))
}

