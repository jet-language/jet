    src :: "module fleet.prod {{ region: \"us\" }}"
    assert_eq(envmodel_test_env_error(envmodel_evaluate_env(src, envmodel_test_base_dir())).code, "E1244")
}

#Test("fleet missing hosts is e1245") {
    src :: "module fleet.prod {{ }}"
    assert_eq(envmodel_test_env_error(envmodel_evaluate_env(src, envmodel_test_base_dir())).code, "E1245")
}

#Test("worked example captures system and image") {
    src :: "\nmodule halcyon {{\n    sources: {{ default: NixOS/nixpkgs/nixos-24.05@github }}\n    system.halcyon: {{\n        target: linux.x64,\n        packages: [default.firefox, default.btop, default.ripgrep],\n        services: {{\n            pipewire: {{ enable: true }},\n            openssh: {{ enable: true, ports: [22] }},\n        }},\n        options: [\n            network.hostName: halcyon,\n            filesystem.timeZone: \"Europe/London\",\n            packages.shell: default.fish,\n        ],\n    }}\n}}\nmodule installer {{\n    image.halcyon-iso: {{ from: system.halcyon, format: iso }}\n}}\n"
    plan :: envmodel_evaluate_env(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    assert_eq(plan.systems.len(), 1)
    system :: plan.systems[0]
    assert_eq(system.name, "halcyon")
    assert_eq(system.target, "linux.x64")
    assert_eq(system.packages, [Pkg]{Pkg.new("default", "firefox"), Pkg.new("default", "btop"), Pkg.new("default", "ripgrep")})
    assert_eq(system.services.len(), 2)
    assert_eq(system.services[0].name, "pipewire")
    assert(system.services[0].enable)
    assert_eq(system.services[1].name, "openssh")
    assert_eq(system.services[1].extra, [ServicePlanExtra]{ServicePlanExtra{key: "ports", value: "[22]"}})
    assert_eq(system.options, [OptionPlan]{OptionPlan{key: "network.hostName", value: "halcyon"}, OptionPlan{key: "filesystem.timeZone", value: "\"Europe/London\""}, OptionPlan{key: "packages.shell", value: "default.fish"}})
    assert_eq(plan.images.len(), 1)
    assert_eq(plan.images[0].name, "halcyon-iso")
    assert_eq(plan.images[0].from, "halcyon")
    assert_eq(plan.images[0].format, "iso")
    assert_eq(plan.images[0].target, None)
}

#Test("computed system service fields consume top level known values") {
    src :: "\nENABLED :: prep {{ true }}\nmodule system.host {{\n    target: linux.x64,\n    services: {{ ssh: {{ enable: ENABLED }} }},\n}}\n"
    plan :: envmodel_evaluate_env(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    assert_eq(plan.systems.len(), 1)
    assert_eq(plan.systems[0].services[0].name, "ssh")
    assert(plan.systems[0].services[0].enable)
}

#Test("s61 hyphenated system and image names") {
    src :: "\nmodule net {{\n    system.my-host: {{\n        target: linux.x64,\n    }}\n    image.halcyon-iso: {{ from: system.my-host, format: iso }}\n}}\n"
    plan :: envmodel_evaluate_env(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    assert_eq(plan.systems.len(), 1)
    assert_eq(plan.systems[0].name, "my-host")
    assert_eq(plan.images.len(), 1)
    assert_eq(plan.images[0].name, "halcyon-iso")
    assert_eq(plan.images[0].from, "my-host")
    assert_eq(plan.images[0].format, "iso")
}

#Test("committed system example field checks clean") {
    path :: files.join(envmodel_test_repo_root(), "tests/fixtures/jetpack-typed/system.jet")
    src :: files.read(path) ?? panic("read committed system fixture")
    plan :: envmodel_evaluate_env(src, files.dirname(path)) ?? panic(err.diagnostic.what)
    assert_eq(plan.systems.len(), 1)
    assert_eq(plan.systems[0].name, "my-host")
    assert_eq(plan.images.len(), 1)
    assert_eq(plan.images[0].name, "halcyon-iso")
    assert_eq(plan.images[0].from, "my-host")
}

#Test("explicit system service image type names still parse") {
    src :: "\nmodule m {{\n    system.box: System{{\n        target: linux.arm64,\n        services: {{ sshd: Service{{ enable: false }} }},\n    }}\n    image.box_iso: Image{{ from: system.box }}\n}}\n"
    plan :: envmodel_evaluate_env(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    assert_eq(plan.systems[0].target, "linux.arm64")
    assert(!plan.systems[0].services[0].enable)
    assert_eq(plan.images[0].format, "iso")
}

