// PORT tests/env_dev_trust.rs159-223; public EnvModel typed secret metadata API, all original assertions.
use jet_env_model.[SecretDeclaration, envmodel_evaluate_env_with_environment]

#Test("integration typed secret map keeps metadata and redacts plan Debug") {
    source :: "\n        module env.ci {{\n            secrets: {{\n                API_KEY: {{\n                    required: true\n                    description: \"CI credential\"\n                    allowed_environments: [\"ci\", \"prod\"]\n                    rotation: max_age(90d)\n                    default: none\n                    generate: none\n                }}\n                DB_URL: compose(\n                    template: postgres://{{DB_USER}}:{{DB_PASSWORD}}@{{DB_HOST}}/app\n                    from: [DB_HOST, DB_USER, DB_PASSWORD]\n                )\n            }}\n        }}\n        module env.prod {{ }}\n    "
    plan :: envmodel_evaluate_env_with_environment(source, envmodel_test_base_dir(), Val("ci")) ?? panic("typed secret plan")
    names := [String]{}
    loop secret in plan.secrets -> &names.push(secret.name)
    assert_eq(names, [String]{"API_KEY", "DB_URL"})
    assert(plan.secrets[0].required)
    assert_eq(plan.secrets[0].allowed_environments, [String]{"ci", "prod"})
    assert_eq(plan.secrets[1].declaration, SecretDeclaration.Compose{template: "postgres://{{DB_USER}}:{{DB_PASSWORD}}@{{DB_HOST}}/app", from: [String]{"DB_HOST", "DB_PASSWORD", "DB_USER"}})
    shown :: "{plan:Debug}"
    assert(shown.contains("API_KEY"))
    assert(shown.contains("DB_URL"))
    assert(!shown.contains("CI credential"))
    assert(!shown.contains("postgres://"))
}
