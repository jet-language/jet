// Rust: crates/jet-env-model/src/ModuleEval/mod.rs:1696
#Test("dev_services_and_jetos_services_are_independent") {
    src :: "\nmodule env.dev {{\n    services: {{ redis: {{ enable: true }} }}\n}}\nmodule system.box {{\n    target: linux.x64,\n    services: {{ openssh: {{ enable: true }} }}\n}}\n"
    plan :: envmodel_evaluate_env(src, envmodel_test_base_dir()) ?? panic(err.diagnostic.what)
    assert_eq(plan.dev_services.len(), 1)
    assert_eq(plan.dev_services[0].name, "redis")
    assert_eq(plan.systems[0].services.len(), 1)
    assert_eq(plan.systems[0].services[0].name, "openssh")
}

