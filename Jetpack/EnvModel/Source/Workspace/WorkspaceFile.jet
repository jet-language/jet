// Declaration-resolved workspace evaluator (D-WORKSPACE1=B, D-WORKSPACE2=A).
//
// Loads Package membership from the canonical `package.jet` root. During the
// reversible split/fold migration, roots that have not yet folded membership
// still evaluate the old declaration-resolved `workspace.jet` index
// `module workspace { members: <expr> }`. Arbitrary top-level authority
// declarations are resolved separately for policy and boundary purposes; they
// never supply members. The migration index `members:` expression may be:
//   - `find("./packages")`: discovers package directories under the path
//   - a list literal of strings: `["./pkg/a", "./pkg/b"]`
//   - any comptime expression that evaluates to a `[String]`
//
// The result is a `WorkspacePlan` listing the member packages with names read
// from checked canonical `package.jet` manifests and their relative paths.
//
// Diagnostics:
//   E0995: the file has no `module workspace { … }` body
//   E0996: `members:` evaluated to something other than a list of strings
//   E0997: `find("…")` in `members:` points at a missing directory

// A workspace source and the plan evaluated from its still-open snapshot.
pub struct WorkspaceSnapshot {
    pub source: WorkspaceSource
    pub plan: WorkspacePlan
}

// Authority failures surface as their own diagnostic.
impl AuthorityError -> EnvModelEvalError { EnvModelEvalError{diagnostic: self.diagnostic()} }

// ── Load / evaluate ──

// Load and evaluate the canonical workspace index from `dir`. None when no
// file declares an index (an authority-only source is not an index); an error
// when a declaring file exists but is malformed.
//
// D-JPK-FILENAME2=B (A2): `module workspace { … }` is discovered by
// declaration and may live in any top-level `.jet` file. The shared resolver
// owns candidate scanning, ambiguity, and source I/O diagnostics.
pub fn envmodel_workspace_load(dir: String) -[FS]> WorkspacePlan? EnvModelEvalError! {
    loaded :: envmodel_workspace_load_checked(dir)
    snapshot :: loaded ?? return Ok(None)
    Ok(Val(snapshot.plan))
}

// Load the source and retain the checked authority snapshot through
// evaluation. This is the only workspace read path that may produce a plan.
pub fn envmodel_workspace_load_checked(dir: String) -[FS]> WorkspaceSnapshot? EnvModelEvalError! {
    resolver :: if AuthorityResolver.open(dir) == {
        .Ok(opened) -> opened
        .Err(error) -> {
            if error.is_missing() -> return Ok(None)
            return Err(EnvModelEvalError{diagnostic: error.workspace_diagnostic()})
        }
    }
    envmodel_workspace_load_checked_with_resolver(resolver)
}

// Load and evaluate the index selected by an already-open authority root. The
// resolver and source snapshot cross the evaluation boundary together; this
// never reopens the selected source by pathname.
pub fn envmodel_workspace_load_checked_with_resolver(resolver: AuthorityResolver) -[FS]> WorkspaceSnapshot? EnvModelEvalError! {
    resolved :: if resolver.resolve_workspace_source() == {
        .Ok(found) -> found
        .Err(error) -> { return Err(EnvModelEvalError{diagnostic: error.workspace_diagnostic()}) }
    }
    source :: resolved ?? return Ok(None)
    resolver.revalidate_source(source)
    if source.role != WorkspaceSourceRole.Index -> return Ok(None)
    Ok(Val(envmodel_workspace_load_checked_source(resolver, source)))
}

// Evaluate an index from the same checked source snapshot selected by a
// caller. The caller transfers the snapshot after selecting it; no second
// authority read can silently replace its path, bytes, role, or identity.
pub fn envmodel_workspace_load_checked_source(resolver: AuthorityResolver, expected: ^WorkspaceSource) -[FS]> WorkspaceSnapshot EnvModelEvalError! {
    if expected.role != WorkspaceSourceRole.Index {
        return Err(EnvModelEvalError{diagnostic: envmodel_changed_workspace_source_diagnostic(resolver.root())})
    }
    resolver.revalidate_source(expected)
    plan :: envmodel_workspace_evaluate_checked_source(expected, resolver)
    resolver.revalidate_source(expected)
    Ok(WorkspaceSnapshot{source: expected, plan: plan})
}

// Project Package membership into the historical workspace-plan read model.
// The Package parser and checked member resolver remain the sole authority;
// this is a view for callers that still need member ordering/selection.
fn envmodel_workspace_evaluate_package_source(source: WorkspaceSource, resolver: AuthorityResolver) -[FS]> WorkspacePlan EnvModelEvalError! {
    package :: resolver.checked_package(".")
    checked_members :: package.facts.checked_members_in(resolver)
    members := [WorkspacePlanMember]{}
    loop member in checked_members {
        resolver.revalidate_member(member.member)
        canonical_path :: resolver.relative_identity(member.member.directory)
        &members.push(WorkspacePlanMember{name: member.facts.name, path: canonical_path, canonical_path: canonical_path})
    }
    resolver.revalidate_source(source)
    Ok(WorkspacePlan{members: members, comptime_inputs: [ComptimeInput]{}, overlay_policy: OverlayPolicy.empty(), source_digest: pkg_sha256_hex(source.source.bytes())})
}

pub fn envmodel_changed_workspace_source_diagnostic(dir: String) -> Diagnostic Never! {
    diagnostic_from_registry(
        "E1334",
        None,
        "workspace authority changed during resolution",
        "the checked workspace source at `{dir}` changed identity or role before its plan was used",
        "restore one stable workspace source and retry"
    )
}

// Whether a workspace source declares the optional top-level build authority.
// This is a discovery helper for the CLI; full diagnostics and execution still
// go through the normal Driver loader and sema pass.
pub fn envmodel_workspace_has_build_entry(src: String) -> Bool Never! {
    // Workspace policy is an evaluated overlay, not a Jet item. Keep this
    // probe on the same source shape as `evaluate`, otherwise a valid
    // workspace build entry disappears as soon as policy is present.
    source :: pkg_strip_overlay_policy(src)
    lexed :: lex(source.bytes())
    if lexed.diagnostics.len() > 0 -> return false
    parsed :: parse_with_source(lexed, source.bytes())
    if parsed.diagnostics.len() > 0 -> return false
    loop item in parsed.program.items {
        if item == {
            .Func(func) && func.name == "build" -> { return true }
            else -> {}
        }
    }
    false
}

// Evaluate a resolved workspace source string to a `WorkspacePlan`.
pub fn envmodel_workspace_evaluate(src: String, base_dir: String) -[FS]> WorkspacePlan EnvModelEvalError! {
    envmodel_workspace_evaluate_source(src, base_dir, WorkspaceSourceRole.Index)
}

// Evaluate a resolved source according to its classified role. Arbitrary
// authority modules contribute policy and a boundary only; they never become
// the D-WORKSPACE2 member index.
pub fn envmodel_workspace_evaluate_source(src: String, base_dir: String, role: WorkspaceSourceRole) -[FS]> WorkspacePlan EnvModelEvalError! {
    resolver :: AuthorityResolver.open(base_dir)
    envmodel_workspace_evaluate_with_resolver(src, base_dir, role, resolver)
}

// Evaluate an already-resolved source without reopening it by pathname.
pub fn envmodel_workspace_evaluate_checked_source(source: WorkspaceSource, resolver: AuthorityResolver) -[FS]> WorkspacePlan EnvModelEvalError! {
    resolver.revalidate_source(source)
    plan :: if envmodel_workspace_file_name(source.path) == @PACKAGE_FILE -> envmodel_workspace_evaluate_package_source(source, resolver) else -> envmodel_workspace_evaluate_with_resolver(source.source, resolver.root(), source.role, resolver)
    resolver.revalidate_source(source)
    Ok(plan)
}

// The final component of a path (`Path::file_name`).
fn envmodel_workspace_file_name(path: String) -> String Never! {
    trimmed := path
    loop trimmed.ends_with("/") -> trimmed = trimmed.removesuffix("/")
    parts :: trimmed.cut_last("/") ?? return trimmed
    parts.after
}

fn envmodel_workspace_evaluate_with_resolver(src: String, base_dir: String, role: WorkspaceSourceRole, resolver: AuthorityResolver) -[FS]> WorkspacePlan EnvModelEvalError! {
    overlay_policy :: if pkg_parse_workspace_policy(src) == {
        .Ok(policy) -> policy
        .Err(error) -> { return Err(EnvModelEvalError{diagnostic: envmodel_workspace_policy_diagnostic(error)}) }
    }
    eval_src :: pkg_strip_overlay_policy(src)
    lexed :: lex(eval_src.bytes())
    if lexed.diagnostics.len() > 0 -> return Err(EnvModelEvalError{diagnostic: lexed.diagnostics[0]})
    parsed :: parse_with_source(lexed, eval_src.bytes())
    if parsed.diagnostics.len() > 0 -> return Err(EnvModelEvalError{diagnostic: parsed.diagnostics[parsed.diagnostics.len() - 1]})
    program :: parsed.program

    // Find `module workspace { … }`. An authority-only source has no required
    // `members:` field, so policy stripping may leave it as an ordinary code
    // module (`module workspace {}`); that still proves the declaration was
    // syntactically present without turning it into an index.
    ws_module :: envmodel_workspace_module(program.items)
    code_workspace := false
    workspace_declarations := 0
    loop item in program.items {
        if item == {
            .Module(declaration) && declaration.name == @NS_WORKSPACE && declaration.auto_discovered -> workspace_declarations += 1
            .CodeModule(declaration) && declaration.name == @NS_WORKSPACE -> {
                workspace_declarations += 1
                if declaration.body != None -> code_workspace = true
            }
            else -> {}
        }
    }

    if role == WorkspaceSourceRole.Authority {
        if workspace_declarations != 1 || (ws_module == None && !code_workspace) {
            return Err(EnvModelEvalError{diagnostic: pkg_e0995_no_workspace_module()})
        }
        return Ok(WorkspacePlan{members: [WorkspacePlanMember]{}, comptime_inputs: [ComptimeInput]{}, overlay_policy: overlay_policy, source_digest: pkg_sha256_hex(src.bytes())})
    }

    if workspace_declarations != 1 -> return Err(EnvModelEvalError{diagnostic: pkg_e0995_no_workspace_module()})
    workspace_module :: ws_module ?? return Err(EnvModelEvalError{diagnostic: pkg_e0995_no_workspace_module()})
    if workspace_module.members.len() == 0 -> return Err(EnvModelEvalError{diagnostic: pkg_e0995_no_workspace_module()})

    // The comptime context a `members:` expression evaluates against: every
    // top-level `fn` (callable) and every top-level `const`/`comptime`
    // binding (referenceable), evaluated in source order so a later binding
    // can build on an earlier one. This lets `members:` compose a sibling
    // `@packages :: […]` or call a local helper `fn`, not only inline
    // literals and the `find("./dir")` fast path.
    funcs := [String: Func]{}
    loop item in program.items {
        if item == {
            .Func(func) -> funcs[func.name] = func
            else -> {}
        }
    }
    extern_names :: [String]{}
    globals := [String: CtValue]{}
    loop item in program.items {
        if item == {
            .Const(constant) -> globals[constant.name] = comptime_evaluate(constant.value, funcs, extern_names, base_dir, globals)
            else -> {}
        }
    }

    // Evaluate each `members:` expression (typically just one).
    members := [WorkspacePlanMember]{}
    comptime_inputs := [ComptimeInput]{}
    loop expr in workspace_module.members {
        evaluated :: envmodel_workspace_eval_members_expr(expr, base_dir, resolver, funcs, extern_names, globals)
        &comptime_inputs.extend(evaluated.inputs)
        loop member_path in evaluated.paths {
            identity :: envmodel_workspace_validate_member_path(member_path.path, resolver, members, Val(member_path.span))
            &members.push(WorkspacePlanMember{name: identity.name, path: member_path.path, canonical_path: identity.canonical_path})
        }
    }

    Ok(WorkspacePlan{members: members, comptime_inputs: comptime_inputs, overlay_policy: overlay_policy, source_digest: pkg_sha256_hex(src.bytes())})
}

// The first auto-discovered `module workspace { … }` declaration.
fn envmodel_workspace_module(items: [Item]) -> ModuleDecl? Never! {
    loop item in items {
        if item == {
            .Module(declaration) && declaration.name == @NS_WORKSPACE && declaration.auto_discovered -> { return Val(declaration) }
            else -> {}
        }
    }
    None
}

// Workspace policy failures: an unsupported field or a malformed `policy.deny`
// is the E3503 build-authority diagnostic; any other overlay fault is E0998.
fn envmodel_workspace_policy_diagnostic(error: OverlayError) -> Diagnostic Never! {
    unsupported_policy :: if error == {
        .UnsupportedPolicy(_) -> true
        else -> false
    }
    malformed_build_policy :: if error == {
        .Malformed(detail) -> detail.contains("policy.deny")
        else -> false
    }
    if {
        malformed_build_policy -> diagnostic_from_registry(
            "E3503",
            None,
            "This root build asks for authority missing from its declaration, `#Impure` gate, or effective policy.",
            error.message(),
            "Declare the effect, gate the ambient operation with `#Impure(\"reason\")`, and grant the effect through CLI/package/workspace policy."
        )
        unsupported_policy -> diagnostic_from_registry(
            "E3503",
            None,
            "workspace build policy contains an unsupported field",
            error.message(),
            "use `policy: {{ deny: #(…) }}` or subject-scoped `policy: {{ grants: {{ \"package\": #(…) }} }}`"
        )
        else -> diagnostic_from_registry(
            "E0998",
            None,
            "workspace overlay policy is malformed",
            error.message(),
            "write `overlay <name> {{ provider: Provider.nixpkgs(channel: \"...\"); package(\"pkg\").patches += [patch(\"path.patch\")] }}`"
        )
    }
}

// A member's validated physical identity.
struct WorkspaceMemberIdentity {
    name: String
    canonical_path: String
}

// D-ECO membership law: member paths are physical identities inside the root,
// names are unique, and a member cannot introduce another member list.
fn envmodel_workspace_validate_member_path(rel_path: String, resolver: AuthorityResolver, members: [WorkspacePlanMember], span: Span?) -[FS]> WorkspaceMemberIdentity EnvModelEvalError! {
    if envmodel_workspace_escapes_root(rel_path) {
        return Err(envmodel_error(
            "E1322",
            "workspace member `{rel_path}` escapes the workspace root",
            "Package membership is rooted in the workspace and cannot follow an absolute or `..` path",
            "use a relative member path below the workspace root, or use `find(\"./packages\")`",
            span
        ))
    }
    member :: if resolver.checked_member(rel_path) == {
        .Ok(checked) -> checked
        .Err(error) -> { return Err(envmodel_workspace_authority_error(error, span)) }
    }
    if resolver.revalidate_member(member) == .Err(error) -> return Err(envmodel_workspace_authority_error(error, span))
    path :: member.manifest.file.path
    has_members :: member.manifest.facts.members.len() > 0
    name :: member.manifest.facts.name
    canonical_path :: if resolver.relative_identity(member.directory) == {
        .Ok(identity) -> identity
        .Err(error) -> { return Err(envmodel_workspace_authority_error(error, span)) }
    }
    loop existing in members {
        if existing.canonical_path == canonical_path {
            return Err(envmodel_error(
                "E1324",
                "workspace member `{rel_path}` has the same physical identity as another member",
                "a workspace member is identified by its real directory, not by two spelling variants",
                "keep one member path for this directory",
                span
            ))
        }
    }
    if has_members {
        return Err(envmodel_error(
            "E1323",
            "member package `{rel_path}` at `{path}` declares `members`",
            "Package membership has depth cap one: only the workspace root may list members; the declaration comes from `{path}`",
            "remove the inner `members:` field from `{path}` and lift its references into the workspace root",
            span
        ))
    }
    loop existing in members {
        if existing.name == name {
            return Err(envmodel_error(
                "E1325",
                "workspace member name `{name}` is declared more than once",
                "Package references use a stable name; two physical members cannot claim the same name",
                "rename one package or remove the duplicate member reference",
                span
            ))
        }
    }
    Ok(WorkspaceMemberIdentity{name: name, canonical_path: canonical_path})
}

// An absolute path, or one with a `..` component.
fn envmodel_workspace_escapes_root(path: String) -> Bool Never! {
    if path.starts_with("/") -> return true
    loop component in envmodel_path_components(path) {
        if component == .ParentDir -> return true
    }
    false
}

// The authority diagnostic re-anchored at the `members:` span.
fn envmodel_workspace_authority_error(error: AuthorityError, span: Span?) -> EnvModelEvalError Never! {
    diagnostic := error.diagnostic()
    diagnostic.span = span
    EnvModelEvalError{diagnostic: diagnostic}
}

// ── Expression evaluation ──

// One member path and the source span that produced it.
struct WorkspaceMemberPath {
    path: String
    span: Span
}

struct WorkspaceMembersValue {
    paths: [WorkspaceMemberPath]
    inputs: [ComptimeInput]
}

// Evaluate one `members:` expression to relative package directory paths plus
// any Tier-1 comptime inputs it recorded. `find("./dir")` is the fast path (no
// comptime inputs); anything else evaluates through comptime against the
// workspace file's top-level `fn`s and `const`s.
fn envmodel_workspace_eval_members_expr(expr: Expr, base_dir: String, resolver: AuthorityResolver, funcs: [String: Func], extern_names: [String], globals: [String: CtValue]) -[FS]> WorkspaceMembersValue EnvModelEvalError! {
    // Fast path: workspace `find("./dir")` scans for package directories. This
    // manifest helper is separate from comptime `find(glob) -> [String]`,
    // which records matched file hashes for ordinary Jet comptime bindings.
    if expr == {
        .Call(call) && call.name == @BUILTIN_FIND -> {
            span :: call.name_span
            if call.args.len() == 0 {
                return Err(envmodel_error(
                    "E0996",
                    "`find` in `members:` needs a path argument",
                    "Write `find(\"./packages\")` to discover all packages under that directory",
                    "Example: `members: find(\"./packages\")`",
                    Val(span)
                ))
            }
            arg :: call.args[0]
            // A non-literal `find` argument (e.g. `find(base + "/pkgs")`) is a
            // computed path: it falls through to the comptime evaluator, which
            // resolves the argument against `globals`/`funcs` before scanning.
            if envmodel_workspace_literal_string(arg.expr) == .Val(dir) {
                scan_dir :: envmodel_workspace_validate_find_scan_dir(dir, resolver, span)
                arg_span :: expr_span(arg.expr)
                paths := [WorkspaceMemberPath]{}
                loop found in envmodel_workspace_find_package_dirs(scan_dir, resolver, span) -> &paths.push(WorkspaceMemberPath{path: found, span: arg_span})
                return Ok(WorkspaceMembersValue{paths: paths, inputs: [ComptimeInput]{}})
            }
        }
        else -> {}
    }

    // General case: evaluate through comptime, expect a list of strings, and
    // capture any Tier-1 inputs (`@embed`, `fetch`) the expression pulled in
    // so the workspace lock can record them (D-CTEFFECT1).
    collected :: comptime_evaluate_collecting(expr, funcs, extern_names, base_dir, globals)
    span :: expr_span(expr)
    paths := [WorkspaceMemberPath]{}
    loop path in envmodel_workspace_string_list(collected.value, span) -> &paths.push(WorkspaceMemberPath{path: path, span: span})
    Ok(WorkspaceMembersValue{paths: paths, inputs: collected.inputs})
}

fn envmodel_workspace_member_path_string(value: CtValue) -> String? Never! {
    if value == {
        .Str(text) -> Val(text)
        .Present(inner) -> envmodel_workspace_member_path_string(inner)
        .Bytes(bytes) -> String.from_bytes(bytes)
        else -> None
    }
}

// A plain string literal with no interpolation.
fn envmodel_workspace_literal_string(expr: Expr) -> String? Never! {
    parts :: if expr == {
        .Str(literal_parts, _) -> literal_parts
        else -> { return None }
    }
    text := [String]{}
    loop part in parts {
        if part == {
            .Lit(literal) -> { &text.push(literal) }
            else -> { return None }
        }
    }
    Val(text.join(""))
}

// `[String]` from a comptime list of strings; any other value is E0996.
fn envmodel_workspace_string_list(value: CtValue, span: Span) -> [String] EnvModelEvalError! {
    items :: if value == {
        .List(values) -> values
        else -> {
            return Err(envmodel_error(
                "E0996",
                "`members:` must evaluate to a list of package paths",
                "The `members:` value must evaluate to a `[String]` — a list of relative package directory paths",
                "Example: `members: find(\"./packages\")` or `members: [\"./pkg/hello\"]`",
                Val(span)
            ))
        }
    }
    out := [String]{}
    loop item in items {
        path :: envmodel_workspace_member_path_string(item) ?? return Err(envmodel_error(
            "E0996",
            "`members:` list must contain strings (package paths)",
            "Each element should be a relative path to a package directory",
            "Example: `members: [\"./packages/hello\", \"./packages/ranker\"]`",
            Val(span)
        ))
        &out.push(path)
    }
    Ok(out)
}

// ── find("./dir"): package discovery ──

fn envmodel_workspace_validate_find_scan_dir(raw: String, resolver: AuthorityResolver, span: Span) -[FS]> String EnvModelEvalError! {
    if raw == "" || envmodel_workspace_escapes_root(raw) {
        return Err(envmodel_error(
            "E1322",
            "`find` path `{raw}` escapes the workspace root",
            "workspace discovery follows only relative paths below the workspace root; absolute and `..` paths are rejected",
            "use a relative path such as `find(\"./packages\")`",
            Val(span)
        ))
    }
    relative :: envmodel_workspace_strip_cur_dir(raw)
    if resolver.checked_directory(relative) == {
        .Ok(directory) -> Ok(directory.path)
        .Err(error) -> {
            if error.is_missing() -> return Err(EnvModelEvalError{diagnostic: envmodel_workspace_e0997_find_dir_missing(files.join(resolver.root(), relative), span)})
            Err(envmodel_workspace_authority_error(error, Val(span)))
        }
    }
}

// `Path::strip_prefix("./")`: drop one leading `.` component, else unchanged.
fn envmodel_workspace_strip_cur_dir(raw: String) -> String Never! {
    components :: envmodel_path_components(raw)
    if components.len() == 0 || components[0] != EnvPathComponent.CurDir -> return raw
    rest := [String]{}
    loop component in components {
        if component == .Normal(segment) -> &rest.push(segment)
    }
    rest.join("/")
}

// Immediate subdirectories of `scan_dir` holding a canonical `package.jet`,
// as workspace-relative paths in the resolver's deterministic order.
fn envmodel_workspace_find_package_dirs(scan_dir: String, resolver: AuthorityResolver, span: Span) -[FS]> [String] EnvModelEvalError! {
    discovered :: if resolver.discover_members(scan_dir) == {
        .Ok(found) -> found
        .Err(error) -> { return Err(envmodel_workspace_authority_error(error, Val(span))) }
    }
    paths := [String]{}
    loop member in discovered -> &paths.push(member.directory.relative)
    Ok(paths)
}

// ── Diagnostics ──

// E0997: `find("…")` in `members:` points at a directory that doesn't exist.
fn envmodel_workspace_e0997_find_dir_missing(dir: String, span: Span) -> Diagnostic Never! {
    diagnostic_from_registry(
        "E0997",
        Val(span),
        "`find` can't read the directory `{dir}`",
        "`find` scans that directory for subdirectories containing `package.jet`; the directory must exist relative to `workspace.jet`",
        "Create the directory, or fix the path so it points at your packages folder"
    )
}
