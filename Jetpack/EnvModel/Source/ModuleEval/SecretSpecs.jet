// D-JPK-SECRETMETA1=B / D-JPK-SECRETCOMPOSE1=D: the one typed `secrets:` map.
// Both declaration shapes (a metadata record or `compose(template:, from:)`)
// enter through one parser; the dispatch is on the value after the map key,
// never on a second grammar.

// One `name: declaration` entry of a `secrets:` map.
struct SecretMapEntry {
    name: String
    span: Span
    declaration: Expr
}

// The closed metadata-record fields of a stored secret.
enum SecretMetaField {
    Description
    Required
    AllowedEnvironments
    Rotation
    Default
    Generate

    fn parse(name: String) -> SecretMetaField? Never! {
        if name == {
            @SECRET_META_FIELD_DESCRIPTION -> Val(SecretMetaField.Description)
            @SECRET_META_FIELD_REQUIRED -> Val(SecretMetaField.Required)
            @SECRET_META_FIELD_ALLOWED_ENVIRONMENTS -> Val(SecretMetaField.AllowedEnvironments)
            @SECRET_META_FIELD_ROTATION -> Val(SecretMetaField.Rotation)
            @SECRET_META_FIELD_DEFAULT -> Val(SecretMetaField.Default)
            @SECRET_META_FIELD_GENERATE -> Val(SecretMetaField.Generate)
            else -> None
        }
    }
}

// One evaluated metadata field and the span that wrote it.
struct SecretMetaValue {
    span: Span
    value: CtValue
}

fn envmodel_secret_decl_error(message: String, span: Span) -> EnvModelEvalError Never! {
    envmodel_error("E1333", "secret declaration is invalid: {message}", "`secrets:` is one typed map from a secret name to either a metadata record or a `compose(template:, from:)` declaration", "fix the named secret declaration without putting a secret value in the configuration", Val(span))
}

fn envmodel_secret_name_error(name: String, span: Span) -> EnvModelEvalError Never! {
    envmodel_secret_decl_error("secret name `{name}` is not a valid name", span)
}

// Lower one `secrets:` map into its typed declarations, in source order.
pub fn envmodel_parse_secret_specs(value: Expr, scope: ModuleEvalScope, globals: [String: CtValue]) -> [SecretSpec] EnvModelEvalError! {
    entries := [SecretMapEntry]{}
    if envmodel_unparen(value) == {
        .StructLit(type_name, _, _, _, fields, _, _) -> {
            if type_name != "" -> return Err(envmodel_secret_decl_error("the secret declaration map must be an inferred `{{ … }}` record", expr_span(value)))
            loop field in fields -> { &entries.push(SecretMapEntry{name: field.name, span: field.name_span, declaration: field.value}) }
        }
        .MapLit(pairs, _) -> {
            loop pair in pairs {
                key :: envmodel_secret_eval_value(pair.key, scope, globals) ?? return Err(envmodel_secret_decl_error("secret map keys must be strings or bare names", expr_span(pair.key)))
                // Keys have no independent span after comptime lowering. Keep
                // the error anchored to the value, and never render the
                // rejected key's contents.
                name :: if key == {
                    .Str(text) -> text
                    else -> { return Err(envmodel_secret_decl_error("secret map keys must be strings or bare names", expr_span(pair.value))) }
                }
                &entries.push(SecretMapEntry{name: name, span: expr_span(pair.value), declaration: pair.value})
            }
        }
        else -> { return Err(envmodel_secret_decl_error("`secrets:` must be a map from names to declarations", expr_span(value))) }
    }
    seen := [String]{}
    specs := [SecretSpec]{}
    loop entry in entries {
        if !envmodel_valid_env_name(entry.name) -> return Err(envmodel_secret_name_error(entry.name, entry.span))
        if seen.contains(entry.name) -> return Err(envmodel_secret_decl_error("secret name `{entry.name}` is declared more than once", entry.span))
        &seen.push(entry.name)
        declaration :: envmodel_unparen(entry.declaration)
        spec :: if declaration == {
            .Call(call) -> {
                if call.name != @SECRET_COMPOSE -> return Err(envmodel_secret_decl_error("secret `{entry.name}` must use a metadata record or `compose(...)`", expr_span(entry.declaration)))
                envmodel_parse_secret_compose(entry.name, call, scope, globals)
            }
            .StructLit(type_name, _, _, _, fields, _, _) -> envmodel_parse_secret_metadata(entry.name, type_name, fields, expr_span(entry.declaration), scope, globals)
            else -> { return Err(envmodel_secret_decl_error("secret `{entry.name}` must use a metadata record or `compose(...)`", expr_span(entry.declaration))) }
        }
        &specs.push(spec)
    }
    envmodel_validate_secret_graph(specs, expr_span(value))
    Ok(specs)
}

fn envmodel_parse_secret_metadata(name: String, type_name: String, fields: [ExprField], span: Span, scope: ModuleEvalScope, globals: [String: CtValue]) -> SecretSpec EnvModelEvalError! {
    if type_name != "" -> return Err(envmodel_secret_decl_error("secret `{name}` metadata must be an inferred record", span))
    values := [String: SecretMetaValue]{}
    loop field in fields {
        if SecretMetaField.parse(field.name) == None -> return Err(envmodel_secret_decl_error("secret `{name}` has unknown field `{field.name}`", field.name_span))
        if values.has_key(field.name) -> return Err(envmodel_secret_decl_error("secret `{name}` repeats field `{field.name}`", field.name_span))
        lowered :: envmodel_secret_eval_value(field.value, scope, globals) ?? return Err(envmodel_secret_decl_error("secret `{name}` field `{field.name}` is not a deterministic value", field.name_span))
        values[field.name] = SecretMetaValue{span: field.name_span, value: lowered}
    }
    description := None
    if values.get(@SECRET_META_FIELD_DESCRIPTION) == {
        .Val(written) -> {
            if written.value == {
                .Str(text) -> description = Val(text)
                else -> { return Err(envmodel_secret_decl_error("secret `{name}` field `{@SECRET_META_FIELD_DESCRIPTION}` must be a string", written.span)) }
            }
        }
        .None -> {}
    }
    required := true
    if values.get(@SECRET_META_FIELD_REQUIRED) == {
        .Val(written) -> {
            if written.value == {
                .Bool(flag) -> required = flag
                else -> { return Err(envmodel_secret_decl_error("secret `{name}` field `{@SECRET_META_FIELD_REQUIRED}` must be a boolean", written.span)) }
            }
        }
        .None -> {}
    }
    allowed_environments := [String]{}
    if values.get(@SECRET_META_FIELD_ALLOWED_ENVIRONMENTS) == {
        .Val(written) -> allowed_environments = envmodel_secret_environment_list(name, written.value, written.span)
        .None -> {}
    }
    rotation := SecretRotationPolicy.Unset
    if values.get(@SECRET_META_FIELD_ROTATION) == {
        .Val(written) -> rotation = envmodel_secret_rotation(name, written.value, written.span)
        .None -> {}
    }
    default := SecretDefault.Unset
    if values.get(@SECRET_META_FIELD_DEFAULT) == {
        .Val(written) -> default = envmodel_secret_default(name, written.value, written.span)
        .None -> {}
    }
    generate := SecretGenerator.Unset
    if values.get(@SECRET_META_FIELD_GENERATE) == {
        .Val(written) -> generate = envmodel_secret_generator(name, written.value, written.span)
        .None -> {}
    }
    envmodel_validate_secret_policies(name, required, allowed_environments, default, generate, span)
    Ok(SecretSpec{
        name: name,
        description: description,
        required: required,
        allowed_environments: allowed_environments,
        rotation: rotation,
        default: default,
        generate: generate,
        declaration: SecretDeclaration.Stored,
        implicit: false,
    })
}

fn envmodel_validate_secret_policies(name: String, required: Bool, allowed_environments: [String], default: SecretDefault, generate: SecretGenerator, span: Span) EnvModelEvalError! {
    has_default :: if default == {
        .PerProfile(values) -> values.len() > 0
        .Unset -> false
    }
    has_generator :: generate != SecretGenerator.Unset
    if has_default && has_generator {
        return Err(envmodel_secret_decl_error("secret `{name}` cannot declare both `{@SECRET_META_FIELD_DEFAULT}` and `{@SECRET_META_FIELD_GENERATE}`", span))
    }
    if required && (has_default || has_generator) {
        return Err(envmodel_secret_decl_error("secret `{name}` is required and cannot declare `{@SECRET_META_FIELD_DEFAULT}` or `{@SECRET_META_FIELD_GENERATE}`", span))
    }
    if allowed_environments.len() > 0 {
        if default == {
            .PerProfile(values) -> {
                loop profile in envmodel_sorted_keys_of(values) {
                    if !allowed_environments.contains(profile) {
                        return Err(envmodel_secret_decl_error("secret `{name}` default profile `{profile}` is outside `{@SECRET_META_FIELD_ALLOWED_ENVIRONMENTS}`", span))
                    }
                }
            }
            .Unset -> {}
        }
    }
}

fn envmodel_parse_secret_compose(name: String, call: Call, scope: ModuleEvalScope, globals: [String: CtValue]) -> SecretSpec EnvModelEvalError! {
    template := None
    template_span := call.name_span
    from_value := None
    from_span := call.name_span
    seen := [String]{}
    loop argument in call.args {
        label :: argument.label ?? return Err(envmodel_secret_decl_error("secret `{name}` compose arguments must be labeled", argument.span))
        if seen.contains(label.name) -> return Err(envmodel_secret_decl_error("secret `{name}` compose repeats field `{label.name}`", label.span))
        &seen.push(label.name)
        if label.name == {
            @SECRET_COMPOSE_FIELD_TEMPLATE -> {
                text :: envmodel_secret_template_value(argument.expr, scope, globals) ?? return Err(envmodel_secret_decl_error("secret `{name}` compose `template` must be text", expr_span(argument.expr)))
                template = Val(text)
                template_span = expr_span(argument.expr)
            }
            @SECRET_COMPOSE_FIELD_FROM -> {
                value :: envmodel_secret_eval_value(argument.expr, scope, globals) ?? return Err(envmodel_secret_decl_error("secret `{name}` compose `from` must be a list of names", expr_span(argument.expr)))
                from_value = Val(value)
                from_span = expr_span(argument.expr)
            }
            else -> { return Err(envmodel_secret_decl_error("secret `{name}` compose has unknown field `{label.name}`", label.span)) }
        }
    }
    template_text :: template ?? return Err(envmodel_secret_decl_error("secret `{name}` compose needs `template`", call.name_span))
    from_written :: from_value ?? return Err(envmodel_secret_decl_error("secret `{name}` compose needs `from`", call.name_span))
    inputs := envmodel_secret_string_list(from_written, "secret `{name}` compose `from`", from_span)
    if inputs.len() == 0 -> return Err(envmodel_secret_decl_error("secret `{name}` compose `from` must not be empty", from_span))
    seen_inputs := [String]{}
    loop input in inputs {
        if !envmodel_valid_env_name(input) -> return Err(envmodel_secret_name_error(input, from_span))
        if seen_inputs.contains(input) -> return Err(envmodel_secret_decl_error("secret `{name}` compose repeats input `{input}`", from_span))
        &seen_inputs.push(input)
    }
    envmodel_validate_secret_template(name, template_text, inputs, template_span)
    &inputs.sort()
    Ok(SecretSpec{name: name, declaration: SecretDeclaration.Compose{template: template_text, from: inputs}})
}

fn envmodel_secret_environment_list(name: String, value: CtValue, span: Span) -> [String] EnvModelEvalError! {
    values :: envmodel_secret_string_list(value, "secret `{name}` field `{@SECRET_META_FIELD_ALLOWED_ENVIRONMENTS}`", span)
    seen := [String]{}
    loop environment in values {
        if !envmodel_valid_env_name(environment) -> return Err(envmodel_secret_decl_error("secret `{name}` names invalid environment label `{environment}`", span))
        if seen.contains(environment) -> return Err(envmodel_secret_decl_error("secret `{name}` repeats allowed environment `{environment}`", span))
        &seen.push(environment)
    }
    Ok(values)
}

// The positive integer stored in `field` of a lowered policy record.
fn envmodel_positive_record_field(fields: [NamedCtValue], field: String) -> Int? Never! {
    loop entry in fields {
        if entry.name == field {
            if entry.value == {
                .Int(number) -> { return if number > 0 -> Val(number) else -> None }
                else -> { return None }
            }
        }
    }
    None
}

fn envmodel_secret_rotation(name: String, value: CtValue, span: Span) -> SecretRotationPolicy EnvModelEvalError! {
    if value == {
        .Str(text) -> {
            if text == @SECRET_NONE -> return Ok(SecretRotationPolicy.Unset)
        }
        .Struct(type_name, fields) -> {
            if type_name == "SecretMaxAge" {
                seconds :: envmodel_positive_record_field(fields, "seconds") ?? return Err(envmodel_secret_decl_error("secret `{name}` rotation max age must be positive", span))
                return Ok(SecretRotationPolicy.MaxAge{seconds: seconds})
            }
        }
        else -> {}
    }
    Err(envmodel_secret_decl_error("secret `{name}` field `{@SECRET_META_FIELD_ROTATION}` must be `{@SECRET_NONE}` or `{@SECRET_ROTATION_MAX_AGE}`(…)", span))
}

fn envmodel_secret_default(name: String, value: CtValue, span: Span) -> SecretDefault EnvModelEvalError! {
    profiles := [NamedCtValue]{}
    if value == {
        .Str(text) -> {
            if text != @SECRET_NONE -> return Err(envmodel_secret_decl_error("secret `{name}` field `default` must be `none` or a profile map", span))
            return Ok(SecretDefault.Unset)
        }
        .Struct(_, fields) -> profiles = fields
        .Map(entries) -> {
            loop entry in entries {
                profile :: if entry.key == {
                    .Str(text) -> text
                    else -> { return Err(envmodel_secret_decl_error("secret `{name}` default profiles must be named strings", span)) }
                }
                &profiles.push(NamedCtValue{name: profile, value: entry.value})
            }
        }
        else -> { return Err(envmodel_secret_decl_error("secret `{name}` field `default` must be `none` or a profile map", span)) }
    }
    result := [String: String]{}
    loop entry in profiles {
        if !envmodel_valid_env_name(entry.name) -> return Err(envmodel_secret_decl_error("secret `{name}` default uses invalid profile `{entry.name}`", span))
        text :: if entry.value == {
            .Str(text) -> text
            else -> { return Err(envmodel_secret_decl_error("secret `{name}` default values must be strings", span)) }
        }
        if result.has_key(entry.name) -> return Err(envmodel_secret_decl_error("secret `{name}` repeats default profile `{entry.name}`", span))
        result[entry.name] = text
    }
    Ok(SecretDefault.PerProfile(result))
}

fn envmodel_secret_generator(name: String, value: CtValue, span: Span) -> SecretGenerator EnvModelEvalError! {
    if value == {
        .Str(text) -> {
            if text == @SECRET_NONE -> return Ok(SecretGenerator.Unset)
        }
        .Struct(type_name, fields) -> {
            if type_name == "SecretRandom" {
                length :: envmodel_positive_record_field(fields, @SECRET_GENERATOR_FIELD_LENGTH) ?? return Err(envmodel_secret_decl_error("secret `{name}` random generator length must be positive", span))
                return Ok(SecretGenerator.Random{length: length})
            }
        }
        else -> {}
    }
    Err(envmodel_secret_decl_error("secret `{name}` field `{@SECRET_META_FIELD_GENERATE}` must be `{@SECRET_NONE}` or `{@SECRET_GENERATOR_RANDOM}`({@SECRET_GENERATOR_FIELD_LENGTH}: …)", span))
}

fn envmodel_secret_string_list(value: CtValue, scope_label: String, span: Span) -> [String] EnvModelEvalError! {
    items :: if value == {
        .List(items) -> items
        else -> { return Err(envmodel_secret_decl_error("{scope_label} must be a list of strings", span)) }
    }
    strings := [String]{}
    loop item in items {
        if item == {
            .Str(text) -> { &strings.push(text) }
            else -> { return Err(envmodel_secret_decl_error("{scope_label} must contain only strings", span)) }
        }
    }
    Ok(strings)
}

// A compose template: a string literal whose interpolations name secrets
// (rendered as `{name}` placeholders), a bare reference, or a comptime string.
fn envmodel_secret_template_value(value: Expr, scope: ModuleEvalScope, globals: [String: CtValue]) -> String EnvModelEvalError! {
    unwrapped :: envmodel_unparen(value)
    if unwrapped == {
        .Str(parts, _) -> {
            template := ""
            loop part in parts {
                if part == {
                    .Lit(text) -> template = "{template}{text}"
                    .Interp(expression, _) -> {
                        name :: envmodel_secret_reference_name(expression) ?? return Err(envmodel_secret_decl_error("compose template interpolations must name secrets", expr_span(expression)))
                        template = "{template}{{{name}}}"
                    }
                    .Byte(byte) -> template = "{template}{String.from_bytes([U8]{byte}) ?? ""}"
                }
            }
            Ok(template)
        }
        .Ident(name, _) -> Ok(name)
        .Field(_, _, _) -> Ok(envmodel_expression_name(unwrapped))
        else -> {
            if envmodel_secret_eval_value(value, scope, globals) == {
                .Str(text) -> Ok(text)
                else -> Err(envmodel_secret_decl_error("compose `template` must be a string", expr_span(value)))
            }
        }
    }
}

fn envmodel_secret_reference_name(value: Expr) -> String? Never! {
    unwrapped :: envmodel_unparen(value)
    if unwrapped == {
        .Ident(_, _) | .Field(_, _, _) -> Val(envmodel_expression_name(unwrapped))
        else -> None
    }
}

// A template is non-empty control-free text whose `{name}` placeholders are
// exactly the `from` inputs.
fn envmodel_validate_secret_template(name: String, template: String, from: [String], span: Span) EnvModelEvalError! {
    if template == "" -> return Err(envmodel_secret_decl_error("secret `{name}` compose template must be non-empty text", span))
    loop character in template.chars() {
        if character.is_control() -> return Err(envmodel_secret_decl_error("secret `{name}` compose template must be non-empty text", span))
    }
    placeholders := [String]{}
    characters :: template.chars().to_list()
    index := 0
    loop index < characters.len() {
        character :: characters[index]
        index += 1
        if character == '{' {
            placeholder := ""
            closed := false
            loop index < characters.len() {
                next_character :: characters[index]
                index += 1
                if next_character == '}' {
                    closed = true
                    break
                }
                if next_character == '{' || next_character.is_whitespace() {
                    return Err(envmodel_secret_decl_error("secret `{name}` compose template has an invalid placeholder", span))
                }
                placeholder = "{placeholder}{next_character}"
            }
            if !closed || !envmodel_valid_env_name(placeholder) {
                return Err(envmodel_secret_decl_error("secret `{name}` compose template has an invalid placeholder", span))
            }
            if !placeholders.contains(placeholder) { &placeholders.push(placeholder) }
        } else if character == '}' {
            return Err(envmodel_secret_decl_error("secret `{name}` compose template has an unmatched brace", span))
        }
    }
    inputs := [String]{}
    loop input in from {
        if !inputs.contains(input) { &inputs.push(input) }
    }
    &placeholders.sort()
    &inputs.sort()
    if placeholders != inputs {
        return Err(envmodel_secret_decl_error("secret `{name}` compose template placeholders must match `from`", span))
    }
}

// Graph-walk state of one composed secret.
enum SecretGraphState {
    Visiting
    Done
}

// A graph check shared by each map parser and the selected-environment merge.
// Unknown input names are allowed here; activation is the tier that checks
// whether each source exists in the encrypted store.
pub fn envmodel_validate_secret_graph(specs: [SecretSpec], span: Span) EnvModelEvalError! {
    composed := [String: [String]]{}
    loop spec in specs {
        if spec.declaration == {
            .Compose(_, from) -> composed[spec.name] = from
            .Stored -> {}
        }
    }
    states := [String: SecretGraphState]{}
    loop name in envmodel_sorted_names_of(composed) -> envmodel_secret_graph_visit(name, composed, &states, span)
}

fn envmodel_sorted_names_of(composed: [String: [String]]) -> [String] Never! {
    names := composed.keys().to_list()
    &names.sort()
    names
}

fn envmodel_secret_graph_visit(name: String, composed: [String: [String]], states: &[String: SecretGraphState], span: Span) EnvModelEvalError! {
    if states.get(name) == {
        .Val(state_now) -> {
            if state_now == {
                .Visiting -> { return Err(envmodel_secret_decl_error("secret composition cycle includes `{name}`", span)) }
                .Done -> return
            }
        }
        .None -> {}
    }
    states[name] = SecretGraphState.Visiting
    if composed.get(name) == {
        .Val(inputs) -> {
            loop input in inputs {
                if composed.has_key(input) -> envmodel_secret_graph_visit(input, composed, &states, span)
            }
        }
        .None -> {}
    }
    states[name] = SecretGraphState.Done
}

// Lower a secret-declaration expression. Bare names and field paths are
// references (text), `max_age(<duration>)` and `random(length:)` are typed
// policy records, and anything else is an ordinary comptime value.
fn envmodel_secret_eval_value(value: Expr, scope: ModuleEvalScope, globals: [String: CtValue]) -> CtValue EnvModelEvalError! {
    unwrapped :: envmodel_unparen(value)
    if unwrapped == {
        .Ident(name, _) -> Ok(globals.get(name) ?? CtValue.Str(name))
        .Field(_, _, _) -> Ok(CtValue.Str(envmodel_expression_name(unwrapped)))
        .ListLit(values, _) -> {
            items := [CtValue]{}
            loop item in values -> { &items.push(envmodel_secret_eval_value(item, scope, globals)) }
            Ok(CtValue.List(items))
        }
        .MapLit(pairs, _) -> {
            lowered := [CtMapEntry]{}
            loop pair in pairs {
                key :: ast_comptime_key_from_value(envmodel_secret_eval_value(pair.key, scope, globals)) ?? return Err(envmodel_secret_decl_error("secret map keys must be scalar values", expr_span(pair.key)))
                lowered_value :: envmodel_secret_eval_value(pair.value, scope, globals)
                if !envmodel_ct_map_insert(&lowered, key, lowered_value) -> return Err(envmodel_secret_decl_error("secret map contains a duplicate key", expr_span(pair.value)))
            }
            Ok(CtValue.Map(lowered))
        }
        .StructLit(type_name, _, _, _, fields, _, _) -> {
            lowered := [NamedCtValue]{}
            loop field in fields -> { &lowered.push(NamedCtValue{name: field.name, value: envmodel_secret_eval_value(field.value, scope, globals)}) }
            Ok(CtValue.Struct{type_name: type_name, fields: lowered})
        }
        .UnitLit(_, int, _, suffix, _, _) -> {
            amount :: int ?? return Err(envmodel_secret_decl_error("secret duration policies need an integer unit literal", expr_span(value)))
            Ok(CtValue.Struct{type_name: suffix, fields: [NamedCtValue]{NamedCtValue{name: "value", value: CtValue.Int(amount)}}})
        }
        .Call(call) -> {
            if call.name == {
                @SECRET_ROTATION_MAX_AGE -> {
                    if call.args.len() != 1 || call.args[0].label != None -> return Err(envmodel_secret_decl_error("`max_age` needs one duration argument", call.name_span))
                    duration :: envmodel_secret_eval_value(call.args[0].expr, scope, globals)
                    seconds :: envmodel_secret_duration_seconds(duration) ?? return Err(envmodel_secret_decl_error("`max_age` needs a positive duration", expr_span(call.args[0].expr)))
                    Ok(CtValue.Struct{type_name: "SecretMaxAge", fields: [NamedCtValue]{NamedCtValue{name: "seconds", value: CtValue.Int(seconds)}}})
                }
                @SECRET_GENERATOR_RANDOM -> {
                    length := None
                    loop argument in call.args {
                        label :: argument.label?.name ?? ""
                        if label != @SECRET_GENERATOR_FIELD_LENGTH -> return Err(envmodel_secret_decl_error("`random` needs a labeled `length` argument", argument.span))
                        if length != None -> return Err(envmodel_secret_decl_error("`random` repeats `length`", argument.span))
                        written :: envmodel_secret_eval_value(argument.expr, scope, globals)
                        if written == {
                            .Int(number) -> length = Val(number)
                            else -> { return Err(envmodel_secret_decl_error("`random` length must be an integer", expr_span(argument.expr))) }
                        }
                    }
                    positive :: length ?? 0
                    if positive <= 0 -> return Err(envmodel_secret_decl_error("`random` length must be positive", call.name_span))
                    Ok(CtValue.Struct{type_name: "SecretRandom", fields: [NamedCtValue]{NamedCtValue{name: @SECRET_GENERATOR_FIELD_LENGTH, value: CtValue.Int(positive)}}})
                }
                else -> Ok(envmodel_comptime_evaluate(value, globals, scope))
            }
        }
        else -> Ok(envmodel_comptime_evaluate(value, globals, scope))
    }
}

// Seconds in a positive `<amount><unit>` duration record (days, hours,
// minutes, or seconds), saturating like Rust `i64::saturating_mul`.
fn envmodel_secret_duration_seconds(value: CtValue) -> Int? Never! {
    record :: if value == {
        .Struct(type_name, fields) -> (unit: envmodel_variant_leaf(type_name), fields: fields)
        else -> { return None }
    }
    amount :: envmodel_positive_record_field(record.fields, "value") ?? return None
    factor :: if record.unit == {
        "d" | "day" | "days" -> 86400
        "h" | "hour" | "hours" -> 3600
        "m" | "min" | "minute" | "minutes" -> 60
        "s" | "sec" | "second" | "seconds" -> 1
        else -> { return None }
    }
    Val(envmodel_saturating_mul(amount, factor))
}

fn envmodel_saturating_mul(amount: Int, factor: Int) -> Int Never! {
    if amount > 9223372036854775807 / factor -> return 9223372036854775807
    amount * factor
}
