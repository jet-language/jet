// Project the canonical Package output facts into the shared JetOS plan
// carriers. Package facts are the only authority here: this lowers checked
// System and Fleet payloads and never resolves packages, reads the store, or
// performs rollout work.
use {
    jet_foundation.[CtFloat, CtKey, CtMapEntry, CtValue]
    jet_pkg_model.[OutputFact, OutputPayload, PackageFacts, PackageOutputKind, Pkg, pkg_parse_i64]
    jetpack_foundation.[REF_SOURCE_JETPACK, SERVICE_FIELD_ENABLE, SYSTEM_FIELD_PACKAGES, SYSTEM_FIELD_TARGET]
}

ENVMODEL_OUTPUT_FIELD_NAME: "name"
ENVMODEL_SYSTEM_FIELD_SERVICES: "services"
ENVMODEL_SYSTEM_FIELD_OPTIONS: "options"
ENVMODEL_FLEET_FIELD_HOSTS: "hosts"
ENVMODEL_HOST_FIELD_SYSTEM: "system"
ENVMODEL_SYSTEM_TARGETS: [String]{"linux.x64", "linux.arm64"}

// A projection failure at one output path, e.g.
// `outputs.host.services.ssh.enable: is required`.
#Error
PackageOutputError: struct {
    path: String
    message: String

    text: fn(self) -> String Never! {
        "{self.path}: {self.message}"
    }
}

// The immutable Package graph facts the JetOS plan path needs.
PackageOutputPlan: struct {
    package_name: String
    graph_identity: String
    systems: [SystemPlan]
    fleets: [FleetPlan]
}

envmodel_output_error: fn(path: String, message: String) -> PackageOutputError Never! {
    PackageOutputError{path: path, message: message}
}

// Byte-ordered keys (Rust BTreeMap order), so repeated reads project the same
// plan; arrays keep the author's order.
envmodel_sorted_output_keys: fn(outputs: [String: OutputFact]) -> [String] Never! {
    keys := outputs.keys().to_list()
    keys.sort()
    keys
}

envmodel_sorted_payload_keys: fn(fields: [String: OutputPayload]) -> [String] Never! {
    keys := fields.keys().to_list()
    keys.sort()
    keys
}

// Lower every JetOS output of one Package.
envmodel_project_package_outputs: fn(facts: PackageFacts) -> PackageOutputPlan PackageOutputError! {
    systems := [SystemPlan]{}
    system_names := [String]{}
    keys: envmodel_sorted_output_keys(facts.outputs)
    loop key in keys {
        output: facts.outputs[key]
        if output.kind != PackageOutputKind.System -> next
        path: "outputs.{key}"
        system: envmodel_project_system(path, output)
        if system_names.contains(system.name) -> return Err(envmodel_output_error(path, "system {system.name} is declared more than once"))
        system_names.push(system.name)
        systems.push(system)
    }
    // Fleet deploy scripts are stored as fleet/deploy-{host}.sh, so host names
    // must be unique across the complete Package projection.
    fleets := [FleetPlan]{}
    fleet_names := [String]{}
    host_paths := [String: String]{}
    loop key in keys {
        output: facts.outputs[key]
        if output.kind != PackageOutputKind.Fleet -> next
        path: "outputs.{key}"
        fleet: envmodel_project_fleet(path, output, system_names)
        if fleet_names.contains(fleet.name) -> return Err(envmodel_output_error(path, "fleet {fleet.name} is declared more than once"))
        fleet_names.push(fleet.name)
        loop host in fleet.hosts {
            host_path: "{path}.hosts.{host.name}"
            if host_paths.get(host.name) == .Val(previous) -> return Err(envmodel_output_error(host_path, "host `{host.name}` for system `{host.system}` collides with Fleet host at {previous}"))
            host_paths[host.name] = host_path
        }
        fleets.push(fleet)
    }
    Ok(PackageOutputPlan{package_name: facts.name, graph_identity: facts.semantic_digest(), systems: systems, fleets: fleets})
}

envmodel_output_object: fn(path: String, output: OutputFact) -> [String: OutputPayload] PackageOutputError! {
    if output.payload == {
        .Object(fields) -> Ok(fields)
        .Null | .Bool(_) | .Number(_) | .String(_) | .Array(_) -> Err(envmodel_output_error(path, "must be an output object"))
    }
}

envmodel_output_name: fn(path: String, output: OutputFact, fields: [String: OutputPayload], kind: String) -> String PackageOutputError! {
    name: if fields.get(ENVMODEL_OUTPUT_FIELD_NAME) == {
        .Val(value) -> envmodel_output_text(Val(value), "{path}.name")
        .None -> output.name
    }
    if name.trim() == "" -> return Err(envmodel_output_error("{path}.name", "must not be empty"))
    envmodel_validate_projection_name("{path}.name", name, kind)
    Ok(name)
}

envmodel_project_target: fn(value: OutputPayload?, path: String) -> String PackageOutputError! {
    target: envmodel_output_text(value, path)
    if !ENVMODEL_SYSTEM_TARGETS.contains(target) -> return Err(envmodel_output_error(path, "unknown target {target}; use linux.x64 or linux.arm64"))
    Ok(target)
}

envmodel_project_system: fn(path: String, output: OutputFact) -> SystemPlan PackageOutputError! {
    fields: envmodel_output_object(path, output)
    name: envmodel_output_name(path, output, fields, "system")
    Ok(SystemPlan{
        name: name,
        target: envmodel_project_target(fields.get(SYSTEM_FIELD_TARGET), "{path}.target"),
        packages: envmodel_project_packages(fields.get(SYSTEM_FIELD_PACKAGES), "{path}.packages"),
        services: envmodel_project_services(fields.get(ENVMODEL_SYSTEM_FIELD_SERVICES), "{path}.services"),
        options: envmodel_project_options(fields.get(ENVMODEL_SYSTEM_FIELD_OPTIONS), "{path}.options"),
    })
}

envmodel_project_fleet: fn(path: String, output: OutputFact, systems: [String]) -> FleetPlan PackageOutputError! {
    fields: envmodel_output_object(path, output)
    name: envmodel_output_name(path, output, fields, "fleet")
    hosts_path: "{path}.hosts"
    hosts: if fields.get(ENVMODEL_FLEET_FIELD_HOSTS) == {
        .Val(value) -> if value == {
            .Object(entries) -> entries
            .Null | .Bool(_) | .Number(_) | .String(_) | .Array(_) -> { return Err(envmodel_output_error(hosts_path, "must be an object of host names to systems")) }
        }
        .None -> { return Err(envmodel_output_error(hosts_path, "is required")) }
    }
    projected := [HostPlan]{}
    loop host_name in envmodel_sorted_payload_keys(hosts) {
        host_path: "{path}.hosts.{host_name}"
        envmodel_validate_projection_name(host_path, host_name, "host")
        host: envmodel_project_host(host_path, host_name, hosts[host_name])
        if !systems.contains(host.system) -> return Err(envmodel_output_error(host_path, "unknown system {host.system}"))
        projected.push(host)
    }
    Ok(FleetPlan{name: name, hosts: projected})
}

// A host is `system.<name>` text or a record naming `system:` plus typed
// copy-with-update overrides of the System fields.
envmodel_project_host: fn(path: String, name: String, value: OutputPayload) -> HostPlan PackageOutputError! {
    fields: if value == {
        .Object(entries) -> entries
        .Null | .Bool(_) | .Number(_) | .String(_) | .Array(_) -> {
            system: envmodel_output_text(Val(value), path)
            return Ok(HostPlan{name: name, system: envmodel_normalize_system_name(system), overrides: None, override_source: None})
        }
    }
    named: if fields.get(ENVMODEL_HOST_FIELD_SYSTEM) == {
        .Val(written) -> Val(written)
        .None -> fields.get(ENVMODEL_OUTPUT_FIELD_NAME)
    }
    system: envmodel_normalize_system_name(envmodel_output_text(named, "{path}.system"))
    overrides := [(name: String, value: HostOverrideValue)]{}
    provenance := [HostOverrideProvenance]{}
    loop field in envmodel_sorted_payload_keys(fields) {
        if field == ENVMODEL_HOST_FIELD_SYSTEM || field == ENVMODEL_OUTPUT_FIELD_NAME -> next
        field_value: fields[field]
        field_path: "{path}.{field}"
        projected: if field == {
            SYSTEM_FIELD_TARGET -> HostOverrideValue.Platform{value: envmodel_project_target(Val(field_value), field_path)}
            SYSTEM_FIELD_PACKAGES -> HostOverrideValue.Packages{values: envmodel_project_packages(Val(field_value), field_path)}
            ENVMODEL_SYSTEM_FIELD_SERVICES -> HostOverrideValue.Services{values: envmodel_project_services(Val(field_value), field_path)}
            ENVMODEL_SYSTEM_FIELD_OPTIONS -> HostOverrideValue.Options{values: envmodel_project_options(Val(field_value), field_path)}
            else -> HostOverrideValue.Value{value: envmodel_payload_ct_value(field_value)}
        }
        overrides.push((name: field, value: projected))
        provenance.push(HostOverrideProvenance{field: field, dependencies: [String]{}, pure: true, source: envmodel_payload_display(field_value)})
    }
    if overrides.len() == 0 -> return Ok(HostPlan{name: name, system: system, overrides: None, override_source: None})
    source: envmodel_payload_display(value)
    Ok(HostPlan{name: name, system: system, overrides: Val(HostOverride{fields: overrides, source: source, provenance: provenance}), override_source: Val(source)})
}

envmodel_project_packages: fn(value: OutputPayload?, path: String) -> [Pkg] PackageOutputError! {
    packages := [Pkg]{}
    payload: value ?? return Ok(packages)
    items: if payload == {
        .Array(entries) -> entries
        .Null | .Bool(_) | .Number(_) | .String(_) | .Object(_) -> { return Err(envmodel_output_error(path, "must be an array of package refs")) }
    }
    loop index in 0..<items.len() {
        item_path: "{path}[{index}]"
        raw: envmodel_output_text(Val(items[index]), item_path)
        parts: raw.split("@").to_list()
        package: if {
            parts.len() > 1 -> {
                head := [String]{}
                loop part in 0..<parts.len() - 1 -> head.push(parts[part])
                name: head.join("@").trim()
                source: parts[parts.len() - 1].trim()
                if name == "" || source == "" -> return Err(envmodel_output_error(item_path, "package refs need both a name and a source"))
                Pkg.new(source, name)
            }
            raw.starts_with("./") || raw.starts_with("../") || raw.starts_with("/") -> Pkg.new("", raw)
            // Package outputs have no second source table: bare names use the
            // canonical built-in provider so the same plan is buildable.
            else -> Pkg.new(REF_SOURCE_JETPACK, raw)
        }
        if !packages.contains(package) -> packages.push(package)
    }
    Ok(packages)
}

envmodel_project_services: fn(value: OutputPayload?, path: String) -> [ServicePlan] PackageOutputError! {
    projected := [ServicePlan]{}
    payload: value ?? return Ok(projected)
    services: if payload == {
        .Object(entries) -> entries
        .Null | .Bool(_) | .Number(_) | .String(_) | .Array(_) -> { return Err(envmodel_output_error(path, "must be an object of services")) }
    }
    loop name in envmodel_sorted_payload_keys(services) {
        service_path: "{path}.{name}"
        fields: if services[name] == {
            .Object(entries) -> entries
            .Null | .Bool(_) | .Number(_) | .String(_) | .Array(_) -> { return Err(envmodel_output_error(service_path, "must be an object with enable: true|false")) }
        }
        enable: if fields.get(SERVICE_FIELD_ENABLE) == {
            .Val(flag) -> if flag == {
                .Bool(on) -> on
                .Null | .Number(_) | .String(_) | .Array(_) | .Object(_) -> { return Err(envmodel_output_error("{service_path}.enable", "must be a boolean")) }
            }
            .None -> { return Err(envmodel_output_error("{service_path}.enable", "is required")) }
        }
        extra := [ServicePlanExtra]{}
        loop field in envmodel_sorted_payload_keys(fields) {
            if field != SERVICE_FIELD_ENABLE -> extra.push(ServicePlanExtra{key: field, value: envmodel_payload_display(fields[field])})
        }
        projected.push(ServicePlan{name: name, enable: enable, extra: extra})
    }
    Ok(projected)
}

envmodel_project_options: fn(value: OutputPayload?, path: String) -> [OptionPlan] PackageOutputError! {
    options := [OptionPlan]{}
    payload: value ?? return Ok(options)
    fields: if payload == {
        .Object(entries) -> entries
        .Null | .Bool(_) | .Number(_) | .String(_) | .Array(_) -> { return Err(envmodel_output_error(path, "must be an object of option values")) }
    }
    loop field in envmodel_sorted_payload_keys(fields) -> envmodel_flatten_option(field, fields[field], path, options)
    Ok(options)
}

envmodel_flatten_option: fn(field: String, value: OutputPayload, path: String, options: &[OptionPlan]) PackageOutputError! {
    if value == {
        .Object(fields) -> {
            loop nested in envmodel_sorted_payload_keys(fields) -> envmodel_flatten_option("{field}.{nested}", fields[nested], "{path}.{field}", options)
        }
        .Array(_) -> { return Err(envmodel_output_error("{path}.{field}", "must be a scalar or nested object")) }
        .Null | .Bool(_) | .Number(_) | .String(_) -> options.push(OptionPlan{key: field, value: envmodel_payload_display(value)})
    }
}

envmodel_output_text: fn(value: OutputPayload?, path: String) -> String PackageOutputError! {
    payload: value ?? return Err(envmodel_output_error(path, "is required"))
    if payload == {
        .String(text) -> Ok(text)
        .Null | .Bool(_) | .Number(_) | .Array(_) | .Object(_) -> Err(envmodel_output_error(path, "must be a string or dotted name"))
    }
}

envmodel_normalize_system_name: fn(value: String) -> String Never! {
    if value.starts_with("system.") -> return value.removeprefix("system.")
    if value.starts_with("systems.") -> return value.removeprefix("systems.")
    value.copy()
}

// A projected name becomes a generation path component, so it may hold only
// ASCII letters, digits, `_`, `-`, and `.`, and is never `.` or `..`.
envmodel_validate_projection_name: fn(path: String, value: String, kind: String) PackageOutputError! {
    safe := value != "" && value != "." && value != ".."
    loop byte in value.bytes() {
        code: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 || code == 45 || code == 46) -> safe = false
    }
    if !safe -> return Err(envmodel_output_error(path, "{kind} name `{value}` is not a safe path component"))
}

envmodel_payload_ct_value: fn(value: OutputPayload) -> CtValue Never! {
    if value == {
        .Null -> CtValue.Unit
        .Bool(flag) -> CtValue.Bool{value: flag}
        .Number(text) -> {
            if pkg_parse_i64(text) == .Val(whole) -> return CtValue.Int{value: whole}
            if Float.parse(text) == .Ok(number) -> return CtValue.Float{value: CtFloat.F64{value: number}}
            CtValue.Str{value: text}
        }
        .String(text) -> CtValue.Str{value: text}
        .Array(items) -> CtValue.List{values: loop item in items -> envmodel_payload_ct_value(item)}
        .Object(fields) -> CtValue.Map{entries: loop key in envmodel_sorted_payload_keys(fields) -> CtMapEntry{key: CtKey.Str{value: key}, value: envmodel_payload_ct_value(fields[key])}}
    }
}

envmodel_payload_display: fn(value: OutputPayload) -> String Never! {
    if value == {
        .Null -> "null"
        .Bool(flag) -> if flag -> "true" else -> "false"
        .Number(text) -> text
        .String(text) -> text
        .Array(items) -> {
            parts: loop item in items -> envmodel_payload_display(item)
            "[{parts.join(", ")}]"
        }
        .Object(fields) -> {
            parts: loop key in envmodel_sorted_payload_keys(fields) -> "{key}: {envmodel_payload_display(fields[key])}"
            "{{{parts.join(", ")}}}"
        }
    }
}
