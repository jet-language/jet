// What module evaluation shares: the scope every computed value is read
// from, and the expression helpers the record sites use to match the shape
// a value was written in.
use jet_foundation.[
    CtKey,
    CtMapEntry,
    CtValue,
    Expr,
    ExprField,
    Type,
    ast_comptime_key_compare,
    comptime_walk_identifiers,
]

// What every module value read needs besides its own expression: the
// directory the compiler resolves `embed_file` against, the source text the
// values are spelled in, and the value of each expression the compiler
// computed, by its start in the source (envmodel_value_of).
ModuleEvalScope: struct {
    base_dir: String,
    source: String,
    values: [Int:CtValue],
}

// `expr` with every enclosing parenthesis removed (Rust `Expr::without_parens`).
envmodel_unparen: fn(expr: Expr) -> Expr Never! {
    current := expr
    loop {
        if current == {
            .Paren(inner, _, _) -> current = inner
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
                return current
            }
        }
    }
}

// A headed record literal in the one shape the record sites match. The
// parser gives a bare `{ … }` as Expr.StructLit with an empty type name, and
// a headed `Env{ … }` or `Env{}` as Expr.TypedLit with a named head; the
// headed form comes back as the StructLit Rust's parser gave it (its written
// type name and fields). Any other expression is None, so a site matches it
// as written.
envmodel_record_literal: fn(expr: Expr) -> Expr? Never! {
    if expr == {
        .TypedLit(head, body, span, id) -> {
            if head == .Val(.Named(name)) {
                if body == {
                    .Fields(fields) -> return Val(Expr.StructLit{type_name: name, type_args: [Type]{}, import_ns: None, as_trait: None, fields: fields, inferred: false, span: span, id: id})
                    .Empty -> return Val(Expr.StructLit{type_name: name, type_args: [Type]{}, import_ns: None, as_trait: None, fields: [ExprField]{}, inferred: false, span: span, id: id})
                    .Elements(_) | .Entries(_) | .Value(_) | .ByteText(_) -> {}
                }
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    None
}

// envmodel_unparen, with a headed record literal as envmodel_record_literal
// gives it.
envmodel_unparen_record: fn(expr: Expr) -> Expr Never! {
    current: envmodel_unparen(expr)
    if envmodel_record_literal(current) == .Val(record) -> return record
    current
}

// The sibling field names `expr` reads, sorted and de-duplicated.
envmodel_dependencies_for_expression: fn(expr: Expr, field_names: [String]) -> [String] Never! {
    dependencies := [String]{}
    loop site in comptime_walk_identifiers(expr) {
        if field_names.contains(site.name) && !dependencies.contains(site.name) {
            dependencies.push(site.name)
        }
    }
    dependencies.sort()
    dependencies
}

// Insert into a key-ordered comptime map (Rust `BTreeMap::insert`); false when
// the key was already present, in which case the map is unchanged.
envmodel_ct_map_insert: fn(entries: ^[CtMapEntry], key: CtKey, value: CtValue) -> Bool Never! {
    index := 0
    loop index < entries.len() {
        order: ast_comptime_key_compare(entries[index].key, key)
        if order == 0 -> return false
        if order > 0 -> break
        index += 1
    }
    entries.insert(index, CtMapEntry{key: key, value: value})
    true
}
