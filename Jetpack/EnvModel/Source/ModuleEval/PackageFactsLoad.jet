// Rust `PackageFacts::load(root)` as the environment loader sees it. It reads
// the package root through the authority resolver (D-CORE-FILEDIR1). Both
// Jetpack and the hosted compiler environment evaluator use this sole reader.
pub fn envmodel_load_package_root(root: String) -[FS, Env]> EnvModelPackageRoot EnvModelEvalError! {
    loaded :: PackageFacts.load(root) ?? return Ok(EnvModelPackageRoot.Absent)
    if loaded == {
        .Ok(facts) -> Ok(EnvModelPackageRoot.Loaded(facts))
        .Err(_) -> Ok(EnvModelPackageRoot.Malformed)
    }
}
