// Rust `PackageFacts::load(root)` as the environment loader sees it. It reads
// the package root through the authority resolver. Both
// Jetpack and the hosted compiler environment evaluator use this sole reader.
fn envmodel_load_package_root(root: String) -[FS, Env]> EnvModelPackageRoot EnvModelEvalError! {
    if PackageFacts.load(root) == {
        .None -> Ok(EnvModelPackageRoot.Absent)
        .Val(facts) -> Ok(EnvModelPackageRoot.Loaded{facts: facts})
        .Err(_) -> Ok(EnvModelPackageRoot.Malformed)
    }
}
