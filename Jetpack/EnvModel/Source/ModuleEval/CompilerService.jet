// The jetpack side of the first-party compiler service (JetFoundation
// CompilerService.jet): jetpack links only the front end, so a source's
// module values, or a project entry that needs the checker, are answered by
// the sibling `jet` through `jet __jetpack <op>` (one evaluator, one checker;
// I8).
use {
    jetpack_foundation.[BINARY_NAME]
    jet_foundation.[
        ComptimeEvalError,
        CtValue,
        Item,
        JET_COMPILER_SERVICE_MODULE_VALUES,
        JET_COMPILER_SERVICE_VERB,
        JetModuleValuesOutcome,
        compiler_service_comptime_request,
        compiler_service_module_values_outcome,
        foundation_parse_protocol_json,
    ]
    jet_parser.[jet_config_module_values_program]
    sys: core.sys
    files: core.files
    process: core.process
}

// The service could not answer: the compiler was not found or failed, or its
// response was not one the protocol defines.
#Error
CompilerServiceError: struct {
    detail: String
}

// The `jet` a harness names for the run (the jetpack profile, check.sh and the
// case runner set it to the compiler under test).
ENV_JET_COMPILER: "JET"

// The compiler that answers the service: the one `JET` names, else the
// sibling `jet` next to the running `jetpack` process, else a bare PATH
// lookup as the last resort (the reverse of the compiler's
// same-directory-then-PATH engine search).
envmodel_find_jet_binary: fn() -[FS, Env]> String Never! {
    if sys.get(ENV_JET_COMPILER) == .Val(named) && named != "" && files.is_file(named) {
        return named
    }
    exe: sys.executable()
    if exe != "" {
        name: if sys.is_windows() -> "jet.exe" else -> "jet"
        candidate: files.join(files.dirname(exe), name)
        if files.is_file(candidate) -> return candidate
    }
    BINARY_NAME
}

// One request to `jet __jetpack <op>` and its parsed response.
envmodel_compiler_service: fn(op: String, request: String) -[FS, Env, Exec, Time.Wait]> Dyn CompilerServiceError! {
    jet: envmodel_find_jet_binary()
    child: process.cmd([String]{jet, JET_COMPILER_SERVICE_VERB, op}).stdin(.Stream).stdout(.Capture).stderr(.Capture).spawn() ?? return Err(CompilerServiceError{detail: "`{jet}` could not be started: {err}"})
    child.stdin.write_bytes(request.bytes()) ?? return Err(CompilerServiceError{detail: "the request could not be sent to `{jet}`: {err}"})
    child.stdin.close()
    receipt: child.wait() ?? return Err(CompilerServiceError{detail: "`{jet}` could not be awaited: {err}"})
    if receipt.signal != None || receipt.code != 0 {
        status: if receipt.signal != None -> "ended by a signal" else -> "exited with status {receipt.code}"
        reported: receipt.errors.trim()
        return Err(CompilerServiceError{detail: if reported == "" -> "`{jet} {JET_COMPILER_SERVICE_VERB} {op}` {status}" else -> "`{jet} {JET_COMPILER_SERVICE_VERB} {op}` {status}: {reported}"})
    }
    response: foundation_parse_protocol_json(receipt.output) ?? return Err(CompilerServiceError{detail: "`{jet} {JET_COMPILER_SERVICE_VERB} {op}` answered with a response that is not protocol JSON"})
    Ok(response)
}

// The typed records of the environment surface, as Jet declarations
// (`Prompt`, `Lang`, `Reload`, …). Every module-values program ends with
// them, so the source's values are typed against them.
ENVMODEL_ENVIRONMENT_SCHEMA: #run embed_file("Schema/Environment.jet.schema")

// The module-values program for `source` (parsed as `items`): the source's
// own declarations, kept at their offsets so a span inside the source is a
// span of `source`; then `generated`, the values EnvModel spells itself
// (ValueProgram.jet), from offset `generated_at`; then the environment
// schema. `environment` holds the value of each `$NAME` the source reads.
ModuleValuesProgram: struct {
    text: String
    generated_at: Int
}

module_values_program: fn(items: [Item], source: String, environment: [String:CtValue], generated: String) -> ModuleValuesProgram ComptimeEvalError! {
    values: jet_config_module_values_program(items, source, environment) ?? return Err(err)
    Ok(ModuleValuesProgram{text: "{values}\n{generated}\n{ENVMODEL_ENVIRONMENT_SCHEMA}", generated_at: values.count_bytes() + 1})
}

// Every module value of `program`, computed by the sibling compiler in one
// request (JetCli `jet_config_module_values`), or the first diagnostic of
// its check, at its span in the program.
module_values_evaluate: fn(program: &&String, base_dir: String) -[FS, Env, Exec, Time.Wait]> JetModuleValuesOutcome CompilerServiceError! {
    // copy: the request owns its base directory; `base_dir` is a read parameter the caller keeps.
    response: envmodel_compiler_service(JET_COMPILER_SERVICE_MODULE_VALUES, compiler_service_comptime_request(program, base_dir.copy())) ?? return Err(err)
    outcome: compiler_service_module_values_outcome(response) ?? return Err(CompilerServiceError{detail: "the compiler's answer is not a module-values response"})
    Ok(outcome)
}
