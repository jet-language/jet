//RS /// U9: infer whether a source is realized by the first-party `core` provider or
//RS /// the `nix` compatibility provider from its *resolved target* — no marker is
//RS /// declared. The rule (see syntax-decisions.md U9, unified-ecosystem.md §6): a
//RS /// target carrying a `pkg.jet` is a Jet package repo (→ `core`); otherwise it
//RS /// is a nix flake (→ `nix`).
//RS ///
//RS /// The probe must never clone a nixpkgs-sized repo just to classify it:
//RS /// - a bare path stats the directory locally (offline, free) — resolved here to a
//RS ///   concrete `Core`/`Nix`;
//RS /// - `…@nixpkgs` is unconditionally `nix` — never probed;
//RS /// - `…@github` is left **`Infer`**: its kind depends on whether the remote
//RS ///   repo carries a `pkg.jet`, which only a realize-time probe can answer
//RS ///   (this pure pass has no offline flag or source cache). `Provider::
//RS ///   resolve_kind` does the lightweight git peek when realization runs.
//RS fn infer_provider_kind(pref: &RefSpec::ProviderRef, base_dir: &Path) -> ProviderKind {
//RS     use super::super::RefSpec::Source;
//RS     match pref.provider {
//RS         Source::Path => {
//RS             let (target, _) = RefSpec::split_channel_ref(&pref.target);
//RS             let target = Path::new(target);
//RS             let dir = if target.is_absolute() {
//RS                 target.to_path_buf()
//RS             } else {
//RS                 base_dir.join(target)
//RS             };
//RS             if dir.join(Syntax::PACKAGE_FILE).is_file() || dir.join(Syntax::PAYLOAD_FILE).is_file()
//RS             {
//RS                 ProviderKind::Core
//RS             } else {
//RS                 ProviderKind::Nix
//RS             }
//RS         }
//RS         // `…@github` can't be classified offline-and-free; defer to a realize-time
//RS         // `pkg.jet` peek (U9).
//RS         Source::Github => ProviderKind::Infer,
//RS         Source::Cran => ProviderKind::Cran,
//RS         Source::LuaRocks => ProviderKind::LuaRocks,
//RS         Source::RubyGems => ProviderKind::RubyGems,
//RS         Source::Cpan => ProviderKind::Cpan,
//RS         Source::Packagist => ProviderKind::Packagist,
//RS         Source::Releases => ProviderKind::JetPackage,
//RS         Source::JetRegistry => ProviderKind::JetRegistry,
//RS         Source::Npm => ProviderKind::Npm,
//RS         Source::Cargo => ProviderKind::Cargo,
//RS         // `…@nixpkgs` is always the nix collection; never probed. (`Named` can't
//RS         // appear in a `target@provider` ref.)
//RS         _ => ProviderKind::Nix,
//RS     }
