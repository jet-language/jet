// The env-namespace evaluation core: parse a source to a `Program`, evaluate
// every enabled `Item.Module`, run each `env.*` field through comptime (or
// the text-level Pkg-sugar parser for `packages:`), and merge the resulting
// contributions through the §6 engine.
use {
    envmodel_module_sys: core.sys
    jet_foundation.[
        CtValue,
        DIAGNOSTIC_ERROR,
        Diagnostic,
        Expr,
        Func,
        HostEntry,
        Item,
        ModuleDecl,
        Program,
        Span,
        SystemFieldValue,
        SystemLit,
        ast_comptime_value_show,
        jet_config_eval_diagnostic,
        jet_config_plain_literal,
    ]
    jet_lexer.[
        STRING_PART_INTERPOLATION,
        TOKEN_IDENT,
        TOKEN_STRING,
        Token,
        TokenTables,
        lex,
        lex_config,
        lexer_without_comments,
        token_decoded,
        token_string_parts,
    ]
    jet_parser.[parse_config_with_source]
    jetpack_foundation.[COMPTIME_MARK, DEFAULT_SOURCE, REF_PROVIDER_AT, TYPE_STRING]
    jet_pkg_model.[EntryContribution, MergeError, MergedEntry, Pkg, pkg_bytes_text, pkg_merge_entry]
}

// Parse `src` and evaluate every enabled module it declares. `base_dir`
// resolves `embed_file` inside contribution expressions, same as ordinary
// comptime evaluation. Module values run through the Compiler's comptime
// path, whose driver makes dynamic host calls, so the evaluation chain
// declares no effect row.
envmodel_evaluate_source: fn(src: String, base_dir: String) -> [EvaluatedModule] EnvModelEvalError! {
    program: envmodel_parse_program(src)
    Ok(envmodel_evaluate_modules(program.items, src, base_dir))
}

// The first error-severity diagnostic in `diagnostics`, if any.
envmodel_first_error: fn(diagnostics: [Diagnostic]) -> Diagnostic? Never! {
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> return Val(diagnostic)
    }
    None
}

// The last error-severity diagnostic in `diagnostics`, if any.
envmodel_last_error: fn(diagnostics: [Diagnostic]) -> Diagnostic? Never! {
    found := Diagnostic?{None}
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> found = Val(diagnostic)
    }
    found
}

// Lex + parse `src` to a `Program`, collapsing any lex/parse failure to a
// single diagnostic. The module surface is evaluated, not type-checked, here,
// so the first lexer error (or the parser's final error) is enough to stop.
envmodel_parse_program: fn(src: String) -> Program EnvModelEvalError! {
    source: src.bytes()
    lexed: lex_config(source)
    if envmodel_first_error(lexed.diagnostics) == {
        .Val(diagnostic) -> { return Err(EnvModelEvalError{diagnostic: diagnostic}) }
        .None -> {}
    }
    parsed: parse_config_with_source(lexed, source)
    if envmodel_last_error(parsed.diagnostics) == {
        .Val(diagnostic) -> { return Err(EnvModelEvalError{diagnostic: diagnostic}) }
        .None -> {}
    }
    Ok(parsed.program)
}

// Read the one config-surface spelling of environment access. The lexer has
// already separated `$` from the following identifier, so quoted shell text
// such as `"echo $HOME"` is not mistaken for a Jet environment read. String
// interpolation token streams are walked recursively because they are parsed
// as expressions by the config parser.
envmodel_environment_reads: fn(src: String) -> [EnvironmentRead] EnvModelEvalError! {
    lexed: lex(src.bytes())
    if lexed.diagnostics.len() > 0 {
        return Err(EnvModelEvalError{diagnostic: lexed.diagnostics[0]})
    }
    reads := [EnvironmentRead]{}
    envmodel_collect_environment_reads(lexed.tokens, lexed.tables, reads)
    Ok(reads)
}

envmodel_collect_environment_reads: fn(all_tokens: [Token], tables: TokenTables, reads: &[EnvironmentRead]) Never! {
    tokens: lexer_without_comments(all_tokens)
    loop token in tokens {
        // The lexer reads `$NAME` as one identifier word.
        if token.kind == TOKEN_IDENT && token_decoded(tables, token).starts_with(COMPTIME_MARK) {
            name: token_decoded(tables, token)
            seen := false
            loop read in reads {
                if read.name == name -> seen = true
            }
            if !seen -> reads.push(EnvironmentRead{name: name, ty: TYPE_STRING})
        }
        if token.kind == TOKEN_STRING {
            loop part in token_string_parts(tables, token) {
                if part.kind == STRING_PART_INTERPOLATION {
                    envmodel_collect_environment_reads(part.tokens, tables, reads)
                }
            }
        }
    }
}

// Each read's current process value (empty when unset), keyed by its `$NAME`.
envmodel_environment_globals: fn(reads: [EnvironmentRead]) -[Env]> [String:CtValue] Never! {
    globals := [String:CtValue]{}
    loop read in reads {
        name: read.name.removeprefix("$")
        globals[read.name] = CtValue.Str{value: envmodel_module_sys.get(name) ?? ""}
    }
    globals
}

// Evaluate every enabled `Item.Module` in `items` (already parsed).
envmodel_evaluate_modules: fn(items: [Item], src: String, base_dir: String) -> [EvaluatedModule] EnvModelEvalError! {
    scope := ModuleEvalScope{base_dir: base_dir, source: src, funcs: envmodel_collect_funcs(items), values: [Int:CtValue]{}}
    reads: envmodel_environment_reads(src)
    computed: envmodel_collect_comptime_globals(items, scope, envmodel_environment_globals(reads))
    globals: computed.globals
    scope.values = computed.values
    out := [EvaluatedModule]{}
    loop item in items {
        if item == {
            .Module(decl) -> {
                if decl.auto_discovered {
                    out.push(envmodel_evaluate_module(decl, src, scope, globals))
                }
            }
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    Ok(out)
}

envmodel_collect_funcs: fn(items: [Item]) -> [String:Func] Never! {
    funcs := [String:Func]{}
    loop item in items {
        if item == {
            .Func(function) -> funcs[function.name] = function
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    funcs
}

// The module values and the environment fields' values, computed once.
ComputedValues: struct {
    globals: [String:CtValue]
    values: [Int:CtValue]
}

// The source's module values: every immutable `NAME: value`, with or without
// `#run`, its name and span, and the values of those written as plain
// literals, beside the environment reads.
ModuleConstants: struct {
    names: [String]
    spans: [Span]
    globals: [String:CtValue]
    all_plain: Bool
}

envmodel_module_constants: fn(items: [Item], environment_globals: [String:CtValue]) -> ModuleConstants Never! {
    constants := ModuleConstants{names: [String]{}, spans: [Span]{}, globals: environment_globals, all_plain: true}
    loop item in items {
        if item == .Const(definition) {
            if !definition.mutable {
                name: definition.name.removeprefix(COMPTIME_MARK)
                constants.spans.push(definition.name_span)
                if jet_config_plain_literal(definition.value) == {
                    .Val(value) -> { constants.globals[name] = value }
                    .None -> { constants.all_plain = false }
                }
                constants.names.push(name)
            }
        }
    }
    constants
}

// Resolve the module values and every value written in an environment field
// before any namespace field runs, as envmodel_compute_values does.
envmodel_collect_comptime_globals: fn(items: [Item], scope: ModuleEvalScope, environment_globals: [String:CtValue]) -> ComputedValues EnvModelEvalError! {
    constants: envmodel_module_constants(items, environment_globals)
    plan := envmodel_value_program(scope.source, environment_globals)
    loop item in items {
        if item == .Module(decl) {
            if decl.auto_discovered {
                envmodel_plan_module_values(plan, decl, constants.globals, constants.names)
            }
        }
    }
    Ok(envmodel_compute_values(items, scope, environment_globals, plan, constants))
}

// Compute the module values of `items` and every value `plan` generated:
// every module value, as the compiler computes every one while building, and
// each planned value as a generated module value (ValueProgram.jet). A plain
// literal is its own value. Otherwise the sibling compiler checks the
// source's own declarations, the generated values and the environment
// schema's types (`Prompt`, `Lang`, …) as one program and computes every
// value at once (module_values_evaluate): a typed value, a cycle, an impure
// `#run` or any other refusal is the compiler's own, at its span in this
// source. A value the environment can't read as data (a function, say) is
// refused at its name. The environment reads stay readable beside the module
// values.
envmodel_compute_values: fn(items: [Item], scope: ModuleEvalScope, environment_globals: [String:CtValue], plan: EnvValueProgram, constants: ModuleConstants) -> ComputedValues EnvModelEvalError! {
    names: constants.names
    name_spans: constants.spans
    globals := constants.globals
    if constants.all_plain && !plan.needed {
        return Ok(ComputedValues{globals: globals, values: plan.known})
    }
    first: if name_spans.len() > 0 -> name_spans[0] else -> plan.first ?? Span{start: 0, end: 0}
    program: module_values_program(items, scope.source, environment_globals, plan.parts.join("")) ?? return Err(EnvModelEvalError{diagnostic: err.diagnostic})
    outcome: module_values_evaluate(program.text, scope.base_dir) ?? return Err(EnvModelEvalError{diagnostic: jet_config_eval_diagnostic(Val(first), "the module values could not be evaluated: {err.detail}")})
    if outcome == {
        .Refused(diagnostic) -> {
            // A span in the generated values stands for the source text it
            // was spelled from; one past them lies in the schema or the
            // program's own lines: the first value.
            span := first
            if diagnostic.span == .Val(at) {
                if {
                    at.end <= scope.source.count_bytes() -> { span = at }
                    at.start >= program.generated_at -> {
                        span = envmodel_value_place(plan, Span{start: at.start - program.generated_at, end: at.end - program.generated_at}) ?? first
                    }
                }
            }
            return Err(EnvModelEvalError{diagnostic: envmodel_value_diagnostic(plan, diagnostic, span)})
        }
        .Values(values, _) -> {
            computed := [String:CtValue]{}
            loop named in values -> computed[named.name] = named.value
            // Every name is read back from the compiler, literals included.
            loop (index, name) in names {
                value: computed.get(name) ?? return Err(EnvModelEvalError{diagnostic: jet_config_eval_diagnostic(Val(name_spans[index]), "the module value `{name}` holds a value an environment can't read as data, such as a function")})
                globals[name] = value
            }
            fields := plan.known
            loop (start, generated) in plan.leaves {
                if fields.get(start) != None -> next
                value: computed.get(generated) ?? return Err(EnvModelEvalError{diagnostic: jet_config_eval_diagnostic(Val(Span{start: start, end: start}), "this value holds a value an environment can't read as data, such as a function")})
                fields[start] = value
            }
            return Ok(ComputedValues{globals: globals, values: fields})
        }
    }
}

// Plan the values written in the integration imports and the environment,
// dev service, package profile, image, system and host override fields of
// `decl`. `names` are the source's module values.
envmodel_plan_module_values: fn(plan: &EnvValueProgram, decl: ModuleDecl, globals: [String:CtValue], names: [String]) EnvModelEvalError! {
    envmodel_plan_integration_imports(plan, decl.imports, globals)
    loop contribution in decl.contributions {
        if contribution.value == {
            .Expr(value) -> {
                if contribution.namespace == {
                    .Env -> { envmodel_plan_env_contribution(plan, value, globals) }
                    .Profile -> envmodel_plan_package_profile_expr(plan, value, globals)
                    .System | .Image | .Fleet | .VMTest | .Perf -> {}
                }
            }
            .Env(lit) -> {
                envmodel_plan_env_fields(plan, lit.fields, globals)
                loop service in lit.services -> envmodel_plan_dev_service(plan, service, globals)
            }
            .Image(lit) -> { envmodel_plan_image(plan, lit, globals) }
            .System(lit) -> { envmodel_plan_system(plan, lit, globals, names) }
            .Fleet(lit) -> {
                loop field in lit.fields {
                    if field.value == .Hosts(entries) {
                        envmodel_plan_hosts(plan, entries, globals, names)
                    }
                }
            }
            .VMTest(lit) -> {
                loop field in lit.fields {
                    if field.value == .Hosts(entries) {
                        envmodel_plan_hosts(plan, entries, globals, names)
                    }
                }
            }
            .Profile(lit) -> { envmodel_plan_package_profile_fields(plan, lit.fields, globals) }
            .Perf(_) -> {}
        }
    }
}

envmodel_evaluate_module: fn(decl: ModuleDecl, src: String, scope: ModuleEvalScope, globals: [String:CtValue]) -> EvaluatedModule EnvModelEvalError! {
    entries := [ModuleEntry]{}
    images := [ImagePlan]{}
    environment_contributions := [EnvironmentContribution]{}
    package_profiles := [PackageProfileSpec]{}
    systems := [SystemPlan]{}
    fleets := [FleetPlan]{}
    vmtests := [FleetPlan]{}
    integrations: envmodel_evaluate_integration_imports(decl.imports, scope)
    source_bytes: src.bytes()
    loop contribution in decl.contributions {
        source: "{decl.name}.{contribution.path}"
        if contribution.value == {
            .Expr(value) -> {
                if contribution.namespace == {
                    .Env -> {
                        capture: envmodel_evaluate_env_contribution(value, src, scope, globals, source)
                        reads: envmodel_environment_reads(pkg_bytes_text(source_bytes, contribution.span.start, contribution.span.end))
                        envmodel_file_env_capture(capture, contribution.path, reads, [DevServicePlan]{}, environment_contributions, entries)
                    }
                    .Profile -> {
                        package_profiles.push(envmodel_evaluate_package_profile_expr(contribution.path, value, src, scope, decl.name))
                    }
                    .System | .Image | .Fleet | .VMTest | .Perf -> {
                        panic("contribution namespace/value shape mismatch")
                    }
                }
            }
            .Env(lit) -> {
                capture: envmodel_evaluate_env_fields(lit.fields, src, scope, globals, source)
                services := [DevServicePlan]{}
                loop service in lit.services {
                    services.push(envmodel_evaluate_dev_service(service, scope))
                }
                reads: envmodel_environment_reads(pkg_bytes_text(source_bytes, contribution.span.start, contribution.span.end))
                envmodel_file_env_capture(capture, contribution.path, reads, services, environment_contributions, entries)
            }
            .Image(lit) -> { images.push(envmodel_evaluate_image(contribution.path, lit, scope)) }
            .Profile(lit) -> {
                package_profiles.push(envmodel_evaluate_package_profile_fields(contribution.path, lit.fields, src, scope, decl.name))
            }
            // Fleets and vmtests capture their hosts (E1244/E1245 here, E1242
            // at plan assembly).
            .System(lit) -> {
                systems.push(envmodel_evaluate_system(contribution.path, lit, src, scope, globals))
            }
            .Fleet(lit) -> {
                hosts := [HostPlan]?{None}
                loop field in lit.fields {
                    if field.value == {
                        .Hosts(host_entries) -> hosts = Val(envmodel_evaluate_hosts(host_entries, src, scope, globals))
                        .Other(_) -> return Err(envmodel_error("E1244", "`{field.name}` isn't a field of `Fleet`", "fleet deployment remains frozen jetos research; only `hosts` is captured for planning", "remove `{field.name}`; captured fleets use `hosts: {{ … }}`", Val(field.name_span)))
                    }
                }
                captured: hosts ?? return Err(envmodel_error("E1245", "this `Fleet` has no `hosts`", "fleet deployment is frozen jetos research, but captured fleets still name hosts for later planning", "add `hosts: {{ web1: system.<name> }}` if this is research capture", Val(lit.span)))
                fleets.push(FleetPlan{name: contribution.path, hosts: captured})
            }
            .VMTest(lit) -> {
                hosts := [HostPlan]?{None}
                loop field in lit.fields {
                    if field.value == {
                        // VM hosts use the same override evaluator as fleet
                        // hosts.
                        .Hosts(host_entries) -> hosts = Val(envmodel_evaluate_hosts(host_entries, src, scope, globals))
                        .Run(_) -> {}
                        .Other(_) -> return Err(envmodel_error("E1244", "`{field.name}` isn't a field of `Fleet`", "fleet deployment remains frozen jetos research; only `hosts` is captured for planning", "remove `{field.name}`; captured fleets use `hosts: {{ … }}`", Val(field.name_span)))
                    }
                }
                captured: hosts ?? return Err(envmodel_error("E1245", "this `Fleet` has no `hosts`", "fleet deployment is frozen jetos research, but captured fleets still name hosts for later planning", "add `hosts: {{ web1: system.<name> }}` if this is research capture", Val(lit.span)))
                vmtests.push(FleetPlan{name: contribution.path, hosts: captured})
            }
            // Performance budgets belong to the performance gate.
            .Perf(_) -> {}
        }
    }
    Ok(
        EvaluatedModule{
            name: decl.name,
            entries: entries,
            systems: systems,
            fleets: fleets,
            vmtests: vmtests,
            images: images,
            environment_contributions: environment_contributions,
            integrations: integrations,
            package_profiles: package_profiles,
        },
    )
}

// Merge every evaluated module's contributions through the §6 engine,
// grouping by `(namespace, path)` first, in first-seen key order.
envmodel_merge_all: fn(modules: [EvaluatedModule]) -> [MergedModuleEntry] MergeError! {
    keys := [ModuleEntryKey]{}
    grouped := [[EntryContribution]]{}
    loop evaluated in modules {
        loop keyed in evaluated.entries {
            index := -1
            loop position in 0..<keys.len() {
                if keys[position] == keyed.key {
                    index = position
                    break
                }
            }
            if index < 0 {
                keys.push(keyed.key)
                grouped.push([EntryContribution]{keyed.entry})
            } else {
                group := grouped[index]
                group.push(keyed.entry)
                grouped[index] = group
            }
        }
    }
    out := [MergedModuleEntry]{}
    loop position in 0..<keys.len() {
        out.push(MergedModuleEntry{key: keys[position], entry: pkg_merge_entry(grouped[position])})
    }
    Ok(out)
}

// One merged `(namespace, path)` entry.
MergedModuleEntry: struct {
    key: ModuleEntryKey
    entry: MergedEntry
}

// The merged entry for `key`, if any module contributed to it.
envmodel_merged_entry: fn(merged: [MergedModuleEntry], key: ModuleEntryKey) -> MergedEntry? Never! {
    loop item in merged {
        if item.key == key -> return Val(item.entry)
    }
    None
}

// Render one merged `Pkg` as a `<package>@<source>` ref. A bare package (the
// sugar's empty source) resolves against the conventional `default` source.
envmodel_pkg_ref: fn(pkg: Pkg) -> String Never! {
    if pkg.source == "" && pkg.name.contains(REF_PROVIDER_AT) -> return pkg.name
    source: if pkg.source == "" -> DEFAULT_SOURCE else -> pkg.source
    "{pkg.name}{REF_PROVIDER_AT}{source}"
}

// Both host namespaces evaluate overrides before capture; an absent tail stays
// absent, not an empty record.
envmodel_evaluate_hosts: fn(entries: [HostEntry], src: String, scope: ModuleEvalScope, globals: [String:CtValue]) -> [HostPlan] EnvModelEvalError! {
    captured := [HostPlan]{}
    bytes: src.bytes()
    loop entry in entries {
        overrides := HostOverride?{None}
        override_source := String?{None}
        if entry.overrides == {
            .Val(span) -> {
                record: envmodel_host_override_record(bytes, span)
                overrides = Val(envmodel_evaluate_host_override(record, scope, globals))
                override_source = Val(record.source)
            }
            .None -> {}
        }
        captured.push(HostPlan{name: entry.name, system: entry.system, overrides: overrides, override_source: override_source})
    }
    Ok(captured)
}

// A host override record (`source`, the trimmed `{ … }` after a system
// reference) parsed as the `System` record of a synthetic module, `wrapped`,
// padded so the record keeps its own offsets: its expressions are spans of the
// module source, computed with the module's values as module fields are.
// Port reused from 45acf6f8f SystemFleetEval.jet, matched to the current oracle.
HostOverrideRecord: struct {
    source: String
    wrapped: String
    lit: SystemLit
}

envmodel_host_override_record: fn(bytes: [U8], span: Span) -> HostOverrideRecord EnvModelEvalError! {
    raw: pkg_bytes_text(bytes, span.start, span.end)
    source: raw.trim()
    at: span.start + raw.bytes().len() - raw.trim_start().bytes().len()
    head: "system.fleet_override: module "
    if at < head.bytes().len() {
        return Err(envmodel_error("E0003", "host override is not a record", "fleet overrides use the same record evaluator as system fields", "write `{{ field: value }}` right after the system reference: `system.web{{ field: value }}`", Val(span)))
    }
    pad: " ".repeat(at - head.bytes().len())
    wrapped: "{pad}{head}{source}"
    program: envmodel_parse_program(wrapped) ?? {
        diagnostic := err.diagnostic
        diagnostic.span = Val(span)
        return Err(EnvModelEvalError{diagnostic: diagnostic})
    }
    found := ModuleDecl?{None}
    loop item in program.items {
        if item == {
            .Module(decl) -> {
                found = Val(decl)
                break
            }
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    decl: found ?? return Err(envmodel_error("E0003", "host override is not a record", "fleet overrides use the same record evaluator as system fields", "write `{{ field: value }}` right after the system reference: `system.web{{ field: value }}`", Val(span)))
    if decl.contributions.len() == 0 {
        return Err(envmodel_error("E0003", "host override is empty", "a host override must contain at least one typed field", "add a field inside the override record", Val(span)))
    }
    lit: if decl.contributions[0].value == {
        .System(lit) -> lit
        .Expr(_) | .Env(_) | .Image(_) | .Fleet(_) | .VMTest(_) | .Profile(_) | .Perf(_) -> {
            return Err(envmodel_error("E0003", "host override is not a system record", "fleet overrides use System field semantics", "write named fields inside `system.<name>{{ … }}`", Val(span)))
        }
    }
    Ok(HostOverrideRecord{source: source, wrapped: wrapped, lit: lit})
}

// Plan the values in each host's override record: each generic field is one
// generated value its sibling fields read by name, in any order, and the
// services and options are planned as a system's are. A record that doesn't
// parse is refused when its host is read (envmodel_evaluate_hosts).
envmodel_plan_hosts: fn(plan: &EnvValueProgram, entries: [HostEntry], globals: [String:CtValue], names: [String]) EnvModelEvalError! {
    loop entry in entries {
        span: entry.overrides ?? next
        record: envmodel_host_override_record(plan.source, span) ?? next
        siblings := [String:String]{}
        readable := envmodel_value_readable(plan, names)
        loop field in record.lit.fields {
            if field.value == .Other(expr) {
                if siblings.get(field.name) != None -> next
                siblings[field.name] = if envmodel_value_structural(expr) -> "" else -> envmodel_value_name(plan)
                if !readable.contains(field.name) -> readable.push(field.name)
            }
        }
        planned := [String:Bool]{}
        loop field in record.lit.fields {
            if field.value == .Other(expr) {
                generated: if planned.get(field.name) == None -> siblings.get(field.name) ?? "" else -> ""
                planned[field.name] = true
                if generated == "" -> envmodel_value_plan(plan, expr, siblings, globals) else {
                    envmodel_value_leaf(plan, envmodel_unparen(expr), "", generated, field.name_span, siblings, globals)
                }
            }
        }
        envmodel_plan_system_fields(plan, record.lit.fields, siblings, readable, globals)
    }
}

// A host override's fields in order, each value the one the compiler computed
// (envmodel_plan_hosts), with each field's dependencies on the record's
// generic fields and its source text.
envmodel_evaluate_host_override: fn(record: HostOverrideRecord, scope: ModuleEvalScope, globals: [String:CtValue]) -> HostOverride EnvModelEvalError! {
    source: record.source
    field_names := [String]{}
    loop field in record.lit.fields {
        if field.value == .Other(_) && !field_names.contains(field.name) {
            field_names.push(field.name)
        }
    }
    readable := globals.keys().to_list()
    loop name in field_names {
        if !readable.contains(name) -> readable.push(name)
    }
    prefix_len: record.wrapped.bytes().len() - source.bytes().len()
    fields := [(name: String, value: HostOverrideValue)]{}
    provenance := [HostOverrideProvenance]{}
    loop field in record.lit.fields {
        value: if field.value == {
            .Platform(os, arch, span) -> HostOverrideValue.Platform{value: envmodel_check_platform(os, arch, span)}
            .Packages(expr) -> HostOverrideValue.Packages{values: envmodel_extract_packages(expr, record.wrapped).packages}
            .Services(entries) -> {
                services := [ServicePlan]{}
                loop entry in entries {
                    services.push(envmodel_evaluate_system_service(entry, scope))
                }
                HostOverrideValue.Services{values: services}
            }
            .Options(entries) -> {
                options := [OptionPlan]{}
                loop entry in entries {
                    options.push(OptionPlan{key: entry.key, value: envmodel_evaluate_option_value(entry.value, envmodel_host_field_source(source, entry.value_span, prefix_len), scope, readable)})
                }
                HostOverrideValue.Options{values: options}
            }
            .Other(expr) -> HostOverrideValue.Value{value: envmodel_value_of(expr, scope)}
        }
        fields.push((name: field.name, value: value))
        provenance.push(HostOverrideProvenance{field: field.name, dependencies: envmodel_typed_field_dependencies(field.value, field_names), pure: true, source: envmodel_host_field_source(source, field.span, prefix_len)})
    }
    Ok(HostOverride{fields: fields, source: source, provenance: provenance})
}

// One `options:` value, the same for system records and host overrides. A
// value that reads one of `readable` (a module value, an environment read or
// a host override's own field) is the value the compiler computed; every
// other value (`laptop`, `devhost-gnome`, `"UTC"`, `.Default`, `[22, 443]`)
// keeps its exact spelling `text`.
envmodel_evaluate_option_value: fn(expr: Expr, text: String, scope: ModuleEvalScope, readable: [String]) -> String EnvModelEvalError! {
    if envmodel_dependencies_for_expression(expr, readable).len() == 0 -> return Ok(text)
    Ok(ast_comptime_value_show(envmodel_value_of(expr, scope)))
}

// Parser spans belong to the synthetic module; provenance belongs to the
// original override record's UTF-8 bytes.
envmodel_host_field_source: fn(source: String, span: Span, prefix_len: Int) -> String Never! {
    start: if span.start < prefix_len -> 0 else -> span.start - prefix_len
    end: if span.end < prefix_len -> 0 else -> span.end - prefix_len
    bytes: source.bytes()
    text: if start <= end && end <= bytes.len() -> String.from_bytes(bytes[start..<end]) ?? source else -> source
    text.trim()
}

// Dependencies of typed fields only name generic sibling fields, de-duplicated
// and sorted regardless of source order.
envmodel_typed_field_dependencies: fn(value: SystemFieldValue, field_names: [String]) -> [String] Never! {
    dependencies := [String]{}
    if value == {
        .Packages(expr) | .Other(expr) -> {
            dependencies = envmodel_dependencies_for_expression(expr, field_names)
        }
        .Services(entries) -> {
            loop entry in entries {
                loop field in entry.fields {
                    loop dependency in envmodel_dependencies_for_expression(field.value, field_names) {
                        if !dependencies.contains(dependency) -> dependencies.push(dependency)
                    }
                }
            }
        }
        .Options(entries) -> {
            loop entry in entries {
                loop dependency in envmodel_dependencies_for_expression(entry.value, field_names) {
                    if !dependencies.contains(dependency) -> dependencies.push(dependency)
                }
            }
        }
        .Platform(_, _, _) -> {}
    }
    dependencies.sort()
    dependencies
}
