// U14/U18/D-JPK-IMAGE1: field-check an `image.<name>: { … }` contribution and
// capture it as an ISO or OCI `ImagePlan`. Realization consumes typed facts.

// The fields an `Image` record may carry besides `from:`/`format:`/`target:`.
enum EnvModelImageField {
    Kind
    Expose
    EnvVars
    Files
    Base
    Services
    Health
    Entrypoint
    User

    fn parse(name: String) -> EnvModelImageField? Never! {
        if name == {
            IMAGE_FIELD_KIND -> Val(EnvModelImageField.Kind)
            IMAGE_FIELD_EXPOSE -> Val(EnvModelImageField.Expose)
            IMAGE_FIELD_ENV_VARS -> Val(EnvModelImageField.EnvVars)
            IMAGE_FIELD_FILES -> Val(EnvModelImageField.Files)
            IMAGE_FIELD_BASE -> Val(EnvModelImageField.Base)
            IMAGE_FIELD_SERVICES -> Val(EnvModelImageField.Services)
            IMAGE_FIELD_HEALTH -> Val(EnvModelImageField.Health)
            IMAGE_FIELD_ENTRYPOINT -> Val(EnvModelImageField.Entrypoint)
            IMAGE_FIELD_USER -> Val(EnvModelImageField.User)
            else -> None
        }
    }
}

// U13: an image `target:` must name a known OS+arch pair.
fn envmodel_check_platform(os: String, arch: String, span: Span) -> String EnvModelEvalError! {
    known_arch :: arch == PLATFORM_ARCH_X64 || arch == PLATFORM_ARCH_ARM64
    if os != PLATFORM_OS_LINUX || !known_arch -> return Err(envmodel_unknown_platform(os, arch, span))
    Ok("{os}.{arch}")
}

// `from:` selects the System/Package/Environment tier. An explicit kind must
// agree with that referent; ISO and OCI retain their original field checks.
pub fn envmodel_evaluate_image(path: String, lit: ImageLit, scope: ModuleEvalScope, globals: [String: CtValue]) -> ImagePlan EnvModelEvalError! {
    from_name := String?{None}
    from_system := false
    from_environment := false
    from_span := lit.span
    format := String?{None}
    target := String?{None}
    kind_word := String?{None}
    kind_span := lit.span
    expose := [Int]{}
    env_vars := [ImageEnvVar]{}
    image_files := [String]{}
    base := String?{None}
    services := [String]{}
    health := String?{None}
    entrypoint := String?{None}
    user := Int?{None}
    loop field in lit.fields {
        if field.value == {
            .From(source, span) -> {
                from_span = span
                if source == {
                    .Package(name) -> {
                        from_name = Val(name)
                        from_system = false
                        from_environment = false
                    }
                    .Environment(name) -> {
                        from_name = Val(name)
                        from_system = false
                        from_environment = true
                    }
                    .System(name) -> {
                        from_name = Val(name)
                        from_system = true
                        from_environment = false
                    }
                }
            }
            .Format(word, span) -> format = Val(envmodel_check_image_format(word, span))
            .Platform(os, arch, span) -> target = Val(envmodel_check_platform(os, arch, span))
            .Other(expr) -> {
                known :: EnvModelImageField.parse(field.name) ?? return Err(envmodel_image_restated_field(field.name, field.name_span))
                if known == {
                    .Kind -> {
                        kind_word = Val(envmodel_bare_enum_word(expr, field.name_span))
                        kind_span = field.name_span
                    }
                    .Expose -> expose = envmodel_eval_expose(expr, scope, globals, field.name_span)
                    .EnvVars -> env_vars = envmodel_eval_env_vars(expr, scope, globals, field.name_span)
                    .Files -> image_files = envmodel_eval_files(expr, scope, globals, field.name_span)
                    .Base -> base = Val(envmodel_eval_base(expr, scope, globals, field.name_span))
                    .Services -> services = envmodel_eval_names(expr, IMAGE_FIELD_SERVICES, scope, globals, field.name_span)
                    .Health -> health = Val(envmodel_eval_string(expr, IMAGE_FIELD_HEALTH, scope, globals, field.name_span))
                    .Entrypoint -> entrypoint = Val(envmodel_eval_string(expr, IMAGE_FIELD_ENTRYPOINT, scope, globals, field.name_span))
                    .User -> user = Val(envmodel_eval_user(expr, scope, globals, field.name_span))
                }
            }
        }
    }
    from :: from_name ?? return Err(envmodel_image_missing_from(lit.span))
    kind :: if from_system -> ImageKind.Iso else -> ImageKind.OCI
    if kind_word == {
        .Val(written) -> {
            if written == IMAGE_KIND_ISO {
                if kind != ImageKind.Iso -> return Err(envmodel_image_kind_from_mismatch(IMAGE_KIND_ISO, kind_span))
            } else if written == IMAGE_KIND_OCI {
                if kind != ImageKind.OCI -> return Err(envmodel_image_kind_from_mismatch(IMAGE_KIND_OCI, kind_span))
            } else {
                return Err(envmodel_image_unknown_kind(written, kind_span))
            }
        }
        .None -> {}
    }
    if kind == ImageKind.OCI {
        if format != None -> return Err(envmodel_image_restated_field(IMAGE_FIELD_FORMAT, from_span))
        if target != None && !from_environment -> return Err(envmodel_image_restated_field(SYSTEM_FIELD_TARGET, from_span))
    } else if expose.len() > 0 || env_vars.len() > 0 || image_files.len() > 0 || base != None {
        return Err(envmodel_image_restated_field(IMAGE_FIELD_EXPOSE, from_span))
    }
    Ok(ImagePlan{
        name: path,
        kind: kind,
        from: from,
        from_environment: from_environment,
        format: format ?? "iso",
        target: target,
        expose: expose,
        env_vars: env_vars,
        files: image_files,
        base: base,
        services: services,
        health: health,
        entrypoint: entrypoint,
        user: user,
    })
}

fn envmodel_eval_string(expr: Expr, field: String, scope: ModuleEvalScope, globals: [String: CtValue], span: Span) -> String EnvModelEvalError! {
    if envmodel_evaluate_expression(expr, globals, scope) == {
        .Str(text) -> Ok(text)
        else -> Err(envmodel_image_field_shape(field, "a string", span))
    }
}

fn envmodel_eval_names(expr: Expr, field: String, scope: ModuleEvalScope, globals: [String: CtValue], span: Span) -> [String] EnvModelEvalError! {
    items :: if envmodel_evaluate_expression(expr, globals, scope) == {
        .List(items) -> items
        else -> { return Err(envmodel_image_field_shape(field, "a list of strings", span)) }
    }
    names := [String]{}
    loop item in items {
        if item == {
            .Str(text) -> { &names.push(text) }
            else -> { return Err(envmodel_image_field_shape(field, "a list of strings", span)) }
        }
    }
    Ok(names)
}

fn envmodel_eval_user(expr: Expr, scope: ModuleEvalScope, globals: [String: CtValue], span: Span) -> Int EnvModelEvalError! {
    if envmodel_evaluate_expression(expr, globals, scope) == {
        .Int(number) -> {
            if number < 0 || number > 4294967295 -> return Err(envmodel_image_field_shape(IMAGE_FIELD_USER, "a non-negative integer", span))
            Ok(number)
        }
        else -> Err(envmodel_image_field_shape(IMAGE_FIELD_USER, "a non-negative integer", span))
    }
}

// Bare leading-dot `.Oci` / `.Iso`, without arguments.
fn envmodel_bare_enum_word(expr: Expr, span: Span) -> String EnvModelEvalError! {
    if expr == {
        .EnumLit(_, variant, _, args, _, _) -> {
            if args.len() == 0 -> return Ok(variant)
        }
        else -> {}
    }
    Err(envmodel_image_field_shape(IMAGE_FIELD_KIND, "a bare leading-dot value, e.g. `kind: .Oci`", span))
}

// D-JPK-IMAGE1: `expose: [Int]` — TCP ports, sorted + deduped so the OCI
// config's `ExposedPorts` (and so the built image's digest) don't depend on
// declaration order.
fn envmodel_eval_expose(expr: Expr, scope: ModuleEvalScope, globals: [String: CtValue], span: Span) -> [Int] EnvModelEvalError! {
    items :: if envmodel_evaluate_expression(expr, globals, scope) == {
        .List(items) -> items
        else -> { return Err(envmodel_image_field_shape(IMAGE_FIELD_EXPOSE, "a list of ports, e.g. `expose: [8080, 443]`", span)) }
    }
    ports := [Int]{}
    loop item in items {
        port :: if item == {
            .Int(number) -> number
            else -> { return Err(envmodel_image_field_shape(IMAGE_FIELD_EXPOSE, "a list of ports, e.g. `expose: [8080, 443]`", span)) }
        }
        if port < 1 || port > 65535 -> return Err(envmodel_image_field_shape(IMAGE_FIELD_EXPOSE, "a list of TCP ports from 1 through 65535", span))
        &ports.push(port)
    }
    &ports.sort()
    unique := [Int]{}
    loop port in ports {
        if unique.len() == 0 || unique[unique.len() - 1] != port { &unique.push(port) }
    }
    Ok(unique)
}

// D-JPK-IMAGE1: `env_vars: [KEY: "value"]` — a map literal; the comptime map
// is key-ordered, so the result is already sorted by key.
fn envmodel_eval_env_vars(expr: Expr, scope: ModuleEvalScope, globals: [String: CtValue], span: Span) -> [ImageEnvVar] EnvModelEvalError! {
    entries :: if envmodel_evaluate_expression(expr, globals, scope) == {
        .Map(entries) -> entries
        else -> { return Err(envmodel_image_field_shape(IMAGE_FIELD_ENV_VARS, "a map, e.g. `env_vars: [RUST_LOG: \"info\"]`", span)) }
    }
    out := [ImageEnvVar]{}
    loop entry in entries {
        key :: if entry.key == {
            .Str(text) -> text
            else -> { return Err(envmodel_image_field_shape(IMAGE_FIELD_ENV_VARS, "a map with string keys, e.g. `env_vars: [RUST_LOG: \"info\"]`", span)) }
        }
        value :: if entry.value == {
            .Str(text) -> text
            else -> { return Err(envmodel_image_field_shape(IMAGE_FIELD_ENV_VARS, "a map of string values, e.g. `env_vars: [RUST_LOG: \"info\"]`", span)) }
        }
        &out.push(ImageEnvVar{key: key, value: value})
    }
    Ok(out)
}

// D-JPK-IMAGE1: `files: [String]` — extra project-relative paths, sorted so
// the tar layer is byte-identical regardless of declaration order.
fn envmodel_eval_files(expr: Expr, scope: ModuleEvalScope, globals: [String: CtValue], span: Span) -> [String] EnvModelEvalError! {
    items :: if envmodel_evaluate_expression(expr, globals, scope) == {
        .List(items) -> items
        else -> { return Err(envmodel_image_field_shape(IMAGE_FIELD_FILES, "a list of paths, e.g. `files: [\"config/app.toml\"]`", span)) }
    }
    out := [String]{}
    loop item in items {
        if item == {
            .Str(text) -> { &out.push(text) }
            else -> { return Err(envmodel_image_field_shape(IMAGE_FIELD_FILES, "a list of paths, e.g. `files: [\"config/app.toml\"]`", span)) }
        }
    }
    &out.sort()
    Ok(out)
}

// D-JPK-IMAGE1: `base: oci("<ref>")` — captured as one image fact. The
// realization tier accepts verified local `file://` OCI layouts and reports a
// transport diagnostic for remote refs rather than changing the requested
// base or silently building from scratch.
fn envmodel_eval_base(expr: Expr, scope: ModuleEvalScope, globals: [String: CtValue], span: Span) -> String EnvModelEvalError! {
    shape :: envmodel_image_field_shape(IMAGE_FIELD_BASE, "`oci(\"<ref>\")`, e.g. `base: oci(\"debian:12\")`", span)
    call :: if expr == {
        .Call(call) -> call
        else -> { return Err(shape) }
    }
    if call.name != IMAGE_BASE_FN || call.args.len() != 1 -> return Err(shape)
    if envmodel_evaluate_expression(call.args[0].expr, globals, scope) == {
        .Str(text) -> Ok(text)
        else -> Err(shape)
    }
}

fn envmodel_check_image_format(word: String, span: Span) -> String EnvModelEvalError! {
    if word != "iso" && word != "qcow" && word != "raw" -> return Err(envmodel_image_bad_format(word, span))
    Ok(word)
}
