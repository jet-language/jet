// U11–U14/U18: field-check `image.<name>: { … }` contributions and capture
// them as `ImagePlan`. OCI realization consumes the typed image plan.
use {
    jetpack_foundation.[
        IMAGE_BASE_FN,
        IMAGE_FIELD_BASE,
        IMAGE_FIELD_ENTRYPOINT,
        IMAGE_FIELD_ENV_VARS,
        IMAGE_FIELD_EXPOSE,
        IMAGE_FIELD_FILES,
        IMAGE_FIELD_HEALTH,
        IMAGE_FIELD_KIND,
        IMAGE_FIELD_SERVICES,
        IMAGE_FIELD_TARGET,
        IMAGE_FIELD_USER,
        IMAGE_KIND_OCI,
        PLATFORM_ARCH_ARM64,
        PLATFORM_ARCH_X64,
        PLATFORM_OS_LINUX,
    ]
    jet_foundation.[CtValue, Expr, ImageLit, Span]
}

// The fields an `Image` record may carry besides `from:`/`target:`.
EnvModelImageField: enum {
    Kind,
    Expose,
    EnvVars,
    Files,
    Base,
    Services,
    Health,
    Entrypoint,
    User,

    parse: fn(name: String) -> EnvModelImageField? Never! {
        if name == {
            IMAGE_FIELD_KIND -> Val(EnvModelImageField.Kind)
            IMAGE_FIELD_EXPOSE -> Val(EnvModelImageField.Expose)
            IMAGE_FIELD_ENV_VARS -> Val(EnvModelImageField.EnvVars)
            IMAGE_FIELD_FILES -> Val(EnvModelImageField.Files)
            IMAGE_FIELD_BASE -> Val(EnvModelImageField.Base)
            IMAGE_FIELD_SERVICES -> Val(EnvModelImageField.Services)
            IMAGE_FIELD_HEALTH -> Val(EnvModelImageField.Health)
            IMAGE_FIELD_ENTRYPOINT -> Val(EnvModelImageField.Entrypoint)
            IMAGE_FIELD_USER -> Val(EnvModelImageField.User)
            else -> None
        }
    }
}

// U13: an image `target:` must name a known OS+arch pair.
envmodel_check_platform: fn(os: String, arch: String, span: Span) -> String EnvModelEvalError! {
    known_arch: arch == PLATFORM_ARCH_X64 || arch == PLATFORM_ARCH_ARM64
    if os != PLATFORM_OS_LINUX || !known_arch {
        return Err(envmodel_unknown_platform(os, arch, span))
    }
    Ok("{os}.{arch}")
}

// Plan the values written in an image's fields. `kind:` is a bare enum word
// and `base:`'s `oci(…)` a reference, so only the reference's argument is
// computed; every other known field's value is computed whole. `from:` and
// `target:` are names, and an unknown field is refused when the image is read.
envmodel_plan_image: fn(plan: ^EnvValueProgram, lit: ImageLit, globals: [String:CtValue]) EnvModelEvalError! {
    siblings: [String:String]{}
    loop field in lit.fields {
        if field.value == .Other(expr) {
            if EnvModelImageField.parse(field.name) == .Val(known) {
                if known == {
                    .Kind -> {}
                    .Base -> {
                        if expr == .Call(call, _) {
                            if call.name == IMAGE_BASE_FN && call.args.len() == 1 {
                                envmodel_value_plan(plan, call.args[0].expr, siblings, globals)
                            }
                        }
                    }
                    .Expose | .EnvVars | .Files | .Services | .Health | .Entrypoint | .User -> {
                        envmodel_value_plan(plan, expr, siblings, globals)
                    }
                }
            }
        }
    }
}

// `from:` is required and names a `Package` or an `Environment`; `kind:` is
// optional and, when written, must be `.Oci`. `target:` is admitted only for
// environment images. Every other field is rejected — `Image` stays a closed
// record (unlike the open `Service`). The fields' values are the ones the
// compiler computed (envmodel_plan_image).
envmodel_evaluate_image: fn(path: String, lit: ImageLit, scope: ModuleEvalScope) -> ImagePlan EnvModelEvalError! {
    ^from_name: String?{None}
    ^from_environment: false
    ^from_span: lit.span
    ^target: String?{None}
    ^kind_word: String?{None}
    ^kind_span: lit.span
    ^expose: [Int]{}
    ^env_vars: [ImageEnvVar]{}
    ^image_files: [String]{}
    ^base: String?{None}
    ^services: [String]{}
    ^health: String?{None}
    ^entrypoint: String?{None}
    ^user: Int?{None}
    loop field in lit.fields {
        if field.value == {
            .From(source, span) -> {
                from_span = span
                if source == {
                    .Package(name) -> {
                        from_name = Val(name)
                        from_environment = false
                    }
                    .Environment(name) -> {
                        from_name = Val(name)
                        from_environment = true
                    }
                }
            }
            .Platform(os, arch, span) -> { target = Val(envmodel_check_platform(os, arch, span)) }
            .Other(expr) -> {
                known: EnvModelImageField.parse(field.name) ?? return Err(envmodel_image_bad_field(field.name, field.name_span))
                if known == {
                    .Kind -> {
                        kind_word = Val(envmodel_bare_enum_word(expr, field.name_span))
                        kind_span = field.name_span
                    }
                    .Expose -> { expose = envmodel_eval_expose(expr, scope, field.name_span) }
                    .EnvVars -> { env_vars = envmodel_eval_env_vars(expr, scope, field.name_span) }
                    .Files -> { image_files = envmodel_eval_files(expr, scope, field.name_span) }
                    .Base -> { base = Val(envmodel_eval_base(expr, scope, field.name_span)) }
                    .Services -> {
                        services = envmodel_eval_names(expr, IMAGE_FIELD_SERVICES, scope, field.name_span)
                    }
                    .Health -> {
                        health = Val(envmodel_eval_string(expr, IMAGE_FIELD_HEALTH, scope, field.name_span))
                    }
                    .Entrypoint -> {
                        entrypoint = Val(envmodel_eval_string(expr, IMAGE_FIELD_ENTRYPOINT, scope, field.name_span))
                    }
                    .User -> user = Val(envmodel_eval_user(expr, scope, field.name_span))
                }
            }
        }
    }
    from: from_name ?? return Err(envmodel_image_missing_from(lit.span))
    if kind_word == .Val(written) {
        if written != IMAGE_KIND_OCI -> return Err(envmodel_image_unknown_kind(written, kind_span))
    }
    // A package image has no environment to cross-compile for.
    if target != None && !from_environment {
        return Err(envmodel_image_bad_field(IMAGE_FIELD_TARGET, from_span))
    }
    Ok(
        ImagePlan{
            name: path,
            from: from,
            from_environment: from_environment,
            target: target,
            expose: expose,
            env_vars: env_vars,
            files: image_files,
            base: base,
            services: services,
            health: health,
            entrypoint: entrypoint,
            user: user,
        },
    )
}

envmodel_eval_string: fn(expr: Expr, field: String, scope: ModuleEvalScope, span: Span) -> String EnvModelEvalError! {
    if envmodel_value_of(expr, scope) == {
        .Str(text) -> Ok(text)
        .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> Err(envmodel_image_field_shape(field, "a string", span))
    }
}

envmodel_eval_names: fn(expr: Expr, field: String, scope: ModuleEvalScope, span: Span) -> [String] EnvModelEvalError! {
    items: if envmodel_value_of(expr, scope) == {
        .List(items) -> items
        .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {
            return Err(envmodel_image_field_shape(field, "a list of strings", span))
        }
    }
    ^names: [String]{}
    loop item in items {
        if item == {
            .Str(text) -> { names.push(text) }
            .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {
                return Err(envmodel_image_field_shape(field, "a list of strings", span))
            }
        }
    }
    Ok(names)
}

envmodel_eval_user: fn(expr: Expr, scope: ModuleEvalScope, span: Span) -> Int EnvModelEvalError! {
    if envmodel_value_of(expr, scope) == {
        .Int(number) -> {
            if number < 0 || number > 4294967295 {
                return Err(envmodel_image_field_shape(IMAGE_FIELD_USER, "a non-negative integer", span))
            }
            Ok(number)
        }
        .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> Err(envmodel_image_field_shape(IMAGE_FIELD_USER, "a non-negative integer", span))
    }
}

// `kind: .Oci` — a bare leading-dot enum literal
// with no arguments. Anything else (a call, a string, `.Foo(x)`) is a shape
// error, not a semantic one — `envmodel_image_unknown_kind` covers a bare
// word that just isn't `Oci`.
envmodel_bare_enum_word: fn(expr: Expr, span: Span) -> String EnvModelEvalError! {
    if expr == {
        .EnumLit(_, variant, _, args, _, _, _) -> {
            if args.len() == 0 -> return Ok(variant)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    Err(envmodel_image_field_shape(IMAGE_FIELD_KIND, "a bare leading-dot value, e.g. `kind: .Oci`", span))
}

// `expose: [Int]` — TCP ports, sorted + deduped so the OCI
// config's `ExposedPorts` (and so the built image's digest) don't depend on
// declaration order.
envmodel_eval_expose: fn(expr: Expr, scope: ModuleEvalScope, span: Span) -> [Int] EnvModelEvalError! {
    items: if envmodel_value_of(expr, scope) == {
        .List(items) -> items
        .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {
            return Err(envmodel_image_field_shape(IMAGE_FIELD_EXPOSE, "a list of ports, e.g. `expose: [8080, 443]`", span))
        }
    }
    ^ports: [Int]{}
    loop item in items {
        port: if item == {
            .Int(number) -> number
            .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {
                return Err(envmodel_image_field_shape(IMAGE_FIELD_EXPOSE, "a list of ports, e.g. `expose: [8080, 443]`", span))
            }
        }
        if port < 1 || port > 65535 {
            return Err(envmodel_image_field_shape(IMAGE_FIELD_EXPOSE, "a list of TCP ports from 1 through 65535", span))
        }
        ports.push(port)
    }
    ports.sort()
    ^unique: [Int]{}
    loop port in ports {
        if unique.len() == 0 || unique[unique.len() - 1] != port -> unique.push(port)
    }
    Ok(unique)
}

// `env_vars: [KEY: "value"]` — a map literal, sorted by key so the OCI
// config doesn't depend on declaration order.
envmodel_eval_env_vars: fn(expr: Expr, scope: ModuleEvalScope, span: Span) -> [ImageEnvVar] EnvModelEvalError! {
    entries: if envmodel_value_of(expr, scope) == {
        .Map(entries) -> entries
        .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {
            return Err(envmodel_image_field_shape(IMAGE_FIELD_ENV_VARS, "a map, e.g. `env_vars: [RUST_LOG: \"info\"]`", span))
        }
    }
    ^out: [ImageEnvVar]{}
    loop entry in entries {
        key: if entry.key == {
            .Str(text) -> text
            .Int(_) | .BigInt(_) | .Bool(_) | .Char(_) | .Tuple(_) | .Struct(_, _) | .Enum(_, _) -> {
                return Err(envmodel_image_field_shape(IMAGE_FIELD_ENV_VARS, "a map with string keys, e.g. `env_vars: [RUST_LOG: \"info\"]`", span))
            }
        }
        value: if entry.value == {
            .Str(text) -> text
            .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {
                return Err(envmodel_image_field_shape(IMAGE_FIELD_ENV_VARS, "a map of string values, e.g. `env_vars: [RUST_LOG: \"info\"]`", span))
            }
        }
        out.push(ImageEnvVar{key: key, value: value})
    }
    out.sort_by(fn(variable) { variable.key })
    Ok(out)
}

// `files: [String]` — extra project-relative paths, sorted so
// the tar layer is byte-identical regardless of declaration order.
envmodel_eval_files: fn(expr: Expr, scope: ModuleEvalScope, span: Span) -> [String] EnvModelEvalError! {
    items: if envmodel_value_of(expr, scope) == {
        .List(items) -> items
        .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {
            return Err(envmodel_image_field_shape(IMAGE_FIELD_FILES, "a list of paths, e.g. `files: [\"config/app.toml\"]`", span))
        }
    }
    ^out: [String]{}
    loop item in items {
        if item == {
            .Str(text) -> { out.push(text) }
            .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {
                return Err(envmodel_image_field_shape(IMAGE_FIELD_FILES, "a list of paths, e.g. `files: [\"config/app.toml\"]`", span))
            }
        }
    }
    out.sort()
    Ok(out)
}

// `base: oci("<ref>")` — captured as one image fact. The
// realization tier accepts verified local `file://` OCI layouts and reports a
// transport diagnostic for remote refs rather than changing the requested
// base or silently building from scratch.
envmodel_eval_base: fn(expr: Expr, scope: ModuleEvalScope, span: Span) -> String EnvModelEvalError! {
    shape: envmodel_image_field_shape(IMAGE_FIELD_BASE, "`oci(\"<ref>\")`, e.g. `base: oci(\"debian:12\")`", span)
    call: if expr == {
        // copy: `call` is a payload of read parameter `expr`, which keeps the original; the assigned `call` owns this one
        .Call(call, _) -> call.copy()
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            return Err(shape)
        }
    }
    if call.name != IMAGE_BASE_FN || call.args.len() != 1 -> return Err(shape)
    if envmodel_value_of(call.args[0].expr, scope) == {
        .Str(text) -> Ok(text)
        .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> Err(shape)
    }
}
