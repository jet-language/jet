// Rust: crates/jet-env-model/src/ModuleEval/System.rs:556
pub fn evaluate_vmtest(path: String, lit: VmTestLit, src: String, scope: ModuleEvalScope, globals: [String: CtValue]) -> VmTestPlan EnvModelEvalError! {
    hosts := [HostPlan]?{None}
    run := String?{None}
    bytes :: src.bytes()
    loop field in lit.fields {
        if field.value == {
            .Hosts(entries) -> {
                captured := [HostPlan]{}
                loop entry in entries {
                    overrides := HostOverride?{None}
                    override_source := String?{None}
                    if entry.overrides == {
                        .Val(span) -> {
                            source := pkg_bytes_text(bytes, span.start, span.end).trim() // #4303
                            overrides = Val(envmodel_evaluate_host_override(source, span, scope, globals))
                            override_source = Val(source)
                        }
                        .None -> {}
                    }
                    &captured.push(HostPlan{name: entry.name, system: entry.system, overrides: overrides, override_source: override_source})
                }
                hosts = Val(captured)
            }
            .Run(span) -> {
                source := pkg_bytes_text(bytes, span.start, span.end).trim() // #4303
                run = Val(source)
            }
            .Other(_) -> { return Err(envmodel_fleet_unknown_field(field.name, field.name_span)) }
        }
    }
    captured :: hosts ?? return Err(envmodel_fleet_missing_hosts(lit.span))
    script :: run ?? "test {}"
    assertions :: vmtest_assertions(script)
    Ok(VmTestPlan{name: path, hosts: captured, run: script, assertions: assertions})
}

