// Rust: crates/jet-env-model/src/ModuleEval/System.rs:819
fn vmtest_assertions(run: String) -> [String] Never! {
    out := [String]{}
    loop assertion in [String]{"wait_for_boot", "assert_unit_active", "assert_port_open", "assert_file_contains", "assert_command_output"} {
        if run.contains(assertion) { &out.push(assertion) }
    }
    out
}
