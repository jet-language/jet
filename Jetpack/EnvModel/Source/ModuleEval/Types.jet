//RS     pub source_files: Vec<String>,
//RS     /// The semantic identity of the Package graph that produced this plan.
//RS     /// Legacy environment plans have no Package authority and keep this None.
//RS     pub graph_identity: Option<String>,
//RS     /// Every typed environment read in the selected environment's root and
//RS     /// discovered module contributions, in source/discovery order.
//RS     pub environment_reads: Vec<EnvironmentRead>,
