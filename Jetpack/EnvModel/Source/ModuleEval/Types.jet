//RS /// U13: one captured `options:` entry — a dotted key path and its value, rendered
//RS /// to a display string.
//RS #[derive(Debug, Clone, PartialEq)]
//RS pub struct OptionPlan {
//RS     pub key: String,
//RS     pub value: String,
//RS }
