//RS     pub adapters: Vec<AdapterPlan>,
//RS     pub prompt: Option<String>,
//RS     pub prompt_path: PromptPathMode,
//RS     pub prompt_strip: PromptStripMode,
//RS     /// U11: every captured `System` across all evaluated modules, in source order.
//RS     /// The jetos tier (gap #4) realizes these; the dev-shell path ignores them.
//RS     pub systems: Vec<SystemPlan>,
//RS     /// U14: every captured `Image`, validated so each `from` names a known system.
//RS     pub images: Vec<ImagePlan>,
//RS     /// U15: every captured `Fleet`, validated so each host names a known system.
//RS     pub fleets: Vec<FleetPlan>,
//RS     /// D-JOS-VMTEST1: every captured VM scenario, validated so each host names a
