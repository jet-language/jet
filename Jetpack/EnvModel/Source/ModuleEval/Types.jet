//RS /// U11: a field-checked `system.<name>: { … }` contribution, captured so the
//RS /// jetos tier (gap #4) can realize it. Pure data — no realize logic here.
//RS #[derive(Debug, Clone, PartialEq)]
//RS pub struct SystemPlan {
//RS     /// The contribution path — the `<name>` in `system.<name>`.
//RS     pub name: String,
//RS     /// U13: the typed target platform, e.g. `linux.x64`.
//RS     pub target: String,
//RS     /// U6: the packages to install, as `Pkg`s (source-qualified).
//RS     pub packages: Vec<Merge::Pkg>,
//RS     /// U12: the enabled/typed services, in source order.
//RS     pub services: Vec<ServicePlan>,
//RS     /// U13: the ordered option entries (`network.hostName: laptop`), in source order.
//RS     pub options: Vec<OptionPlan>,
//RS }
//RS 
//RS /// U12: one captured `Service` record under a `System`'s `services:` map.
//RS #[derive(Debug, Clone, PartialEq)]
//RS pub struct ServicePlan {
//RS     /// The service name (the map key), e.g. `openssh`.
//RS     pub name: String,
//RS     /// The required `enable` flag (U12).
//RS     pub enable: bool,
//RS     /// Any further open-record fields, rendered to display strings, in source
//RS     /// order. (e.g. `ports: [22]`.)
//RS     pub extra: Vec<(String, String)>,
//RS }
//RS 
//RS /// U12: one captured dev-supervised `Service` record under an `env.<name>`
//RS /// role-module's `services:` map (`ContribValue::Env`/`EnvLit::services`).
//RS /// Distinct from `ServicePlan` (the jetos `system.*.services` capture): same
//RS /// ratified `Service` grammar (open record, required `enable`), but jetpack's
//RS /// dev-runtime tier (`Jetpack::Services`) owns and interprets every field
//RS /// here — there is no downstream Nix-option consumer the way jetos services
//RS /// have (Phase D), so an unrecognized `extra` key is a supervision-time
//RS /// error (E1262), not silently-forwarded metadata.
//RS #[derive(Debug, Clone, PartialEq, Eq, Default)]
//RS pub struct DevServicePlan {
//RS     /// The service name (the map key), e.g. `redis`.
//RS     pub name: String,
//RS     /// The required `enable` flag (U12) — `false` captures the service
//RS     /// (so `jet services logs` etc still knows its name) without supervising it.
//RS     pub enable: bool,
//RS     /// `ports: [Int]` — TCP ports the service listens on. The first port is
//RS     /// the default readiness probe target when no explicit `ready:` is given.
//RS     pub ports: Vec<i64>,
//RS     /// `run: ["program", "arg", …]` — the executable and argv that start the
//RS     /// service. Falls back to the built-in catalog when the name matches a
//RS     /// known service and this is unset.
//RS     pub run: Option<Vec<String>>,
//RS     /// `shutdown: .Term(...)`/`.Kill` — typed process shutdown policy. Falls
//RS     /// back to a bounded TERM-then-KILL sequence when unset.
//RS     pub shutdown: Option<ShutdownPolicy>,
//RS     /// `data_dir: "…"` — override for the persisted-state directory, which
//RS     /// otherwise defaults to `.jet/services/<name>/data`.
//RS     pub data_dir: Option<String>,
//RS     /// `ready: "…"` — a shell command polled until it exits 0; the readiness
//RS     /// contract. Falls back to a TCP connect on `ports[0]` when unset and
//RS     /// `ports` is non-empty, else to a bare process-alive check.
//RS     pub ready: Option<String>,
//RS     /// D-JPK-SERVICEDEPTH1: typed readiness without shell-command parsing.
//RS     pub ready_probe: Option<ReadyProbe>,
//RS     /// D-JPK-SERVICEDEPTH1: bounded restart behavior.
//RS     pub restart: Option<RestartPolicy>,
//RS     /// Files whose changes may trigger a bounded restart.
//RS     pub watch: Vec<String>,
//RS     /// Service names that must be healthy before this service starts.
//RS     pub after: Vec<String>,
//RS     /// Ordinary `#Job` names to run successfully immediately before start.
//RS     pub before_start: Vec<String>,
//RS     /// Named sockets reserved by the service.
//RS     pub sockets: Vec<String>,
//RS     /// Any further field, captured verbatim as a display string (open record,
//RS     /// U12) — checked against the known keys above at supervision time, not
//RS     /// at field-check time (E1262). This includes retired spellings such as
//RS     /// `depends_on`; `after` is the only dependency field.
//RS     pub extra: Vec<(String, String)>,
//RS }
//RS 
//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub enum ReadyProbe {
//RS     Exec(String),
//RS     Http { url: String, status: Option<u16> },
//RS     Notify { path: String },
//RS     Tcp { host: String, port: u16 },
//RS }
//RS 
//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub enum RestartPolicy {
//RS     Never,
//RS     OnFailure {
//RS         max: u32,
//RS         backoff_ms: u64,
//RS         exponential: bool,
//RS     },
//RS     Always {
//RS         max: u32,
//RS         backoff_ms: u64,
//RS         exponential: bool,
//RS     },
//RS }
//RS 
//RS #[derive(Debug, Clone, PartialEq, Eq)]
//RS pub enum ShutdownPolicy {
//RS     /// Send TERM, wait up to `grace_ms`, then use the bounded KILL fallback.
//RS     Term { grace_ms: u64 },
//RS     /// Skip the graceful signal and terminate the verified process group.
//RS     Kill,
//RS }
