//RS /// One environment's non-entry facts from one source module. Keeping these
//RS /// facts beside the environment name prevents sibling `env.<name>` modules
//RS /// from leaking services, lifecycle, files, or variable reads into the one
//RS /// selected runtime plan.
//RS #[derive(Debug, Clone)]
//RS pub(super) struct EnvironmentContribution {
//RS     pub(super) name: String,
//RS     pub(super) environment_reads: Vec<EnvironmentRead>,
//RS     pub(super) dev_services: Vec<DevServicePlan>,
//RS     pub(super) secrets: Vec<SecretSpec>,
//RS     pub(super) adapters: Vec<AdapterPlan>,
//RS     pub(super) lifecycle: EnvironmentLifecycle,
//RS     pub(super) presets: Vec<PresetSpec>,
//RS     pub(super) languages: Vec<LanguageSpec>,
//RS     pub(super) files: Vec<super::Environment::ManagedFile>,
//RS }
//RS 
//RS /// One module's contributions, keyed by `(namespace, path)` so `merge_all`
//RS /// can combine same-keyed contributions from different modules.
//RS #[derive(Debug)]
//RS pub struct EvaluatedModule {
//RS     pub name: String,
//RS     pub entries: Vec<((Namespace, String), EntryContribution)>,
//RS     /// U11: `system.<name>:` contributions, captured for the jetos tier (gap #4
//RS     /// realizes them; gap #5 only field-checks + captures).
//RS     pub systems: Vec<SystemPlan>,
//RS     /// U14: `image.<name>:` contributions, captured for the jetos tier.
//RS     pub images: Vec<ImagePlan>,
//RS     /// U15: `fleet.<name>:` contributions, captured (parse/cross-check now;
//RS     /// ssh realization rides single-host jetos, Phase D).
//RS     pub fleets: Vec<FleetPlan>,
//RS     /// D-JOS-VMTEST1: `vmtest.<name>:` contributions, captured as runnable VM
//RS     /// scenarios over known systems.
//RS     pub vmtests: Vec<VmTestPlan>,
//RS     /// Environment-scoped facts. Source evaluation selects one name before
//RS     /// projecting these into `EnvPlan`.
//RS     pub(super) environment_contributions: Vec<EnvironmentContribution>,
//RS     /// D-ENV-INTEGRATIONS1: typed first-party integrations imported by this
//RS     /// module and lowered into ordinary environment facts.
//RS     pub integrations: Vec<EnvironmentIntegration>,
//RS     /// D-JPK-PROFILE1=D: source-backed package generation declarations. These
//RS     /// are not environment presets and never affect shell selection.
//RS     pub package_profiles: Vec<PackageProfileSpec>,
//RS }
