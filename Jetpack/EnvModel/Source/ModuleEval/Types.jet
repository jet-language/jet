//RS /// D-JPK-IMAGE1 (=A, ratified 2026-07-01): which referent an `Image`'s `from:`
//RS /// names, and so which realize tier owns it. `Iso` is the original U14 shape
//RS /// (disk images from a `System`, Phase D jetos installer tier, owner-gated,
//RS /// untouched by this slice). `Oci` is the new container tier (built from a
//RS /// `Package`, native — no jetos/Phase D gate).
//RS #[derive(Debug, Clone, Copy, PartialEq, Eq)]
//RS pub enum ImageKind {
//RS     Iso,
//RS     Oci,
//RS }
//RS 
//RS /// U14/D-JPK-IMAGE1: a field-checked `image.<name>: { … }` contribution.
//RS /// `Iso`: `target`/`packages`/`services`/`options` are inherited from the
//RS /// referenced `System` at realize time (Phase D, gap #4), so they are not
//RS /// stored here. `Oci`: built natively now (no jetos tier involved) from the
//RS /// referenced `Package` or `Environment`'s realized Hangar output plus
//RS /// `expose`/`env_vars`/`files`/`base`.
//RS #[derive(Debug, Clone, PartialEq)]
//RS pub struct ImagePlan {
//RS     /// The contribution path — the `<name>` in `image.<name>`.
//RS     pub name: String,
//RS     /// Which referent `from:` names, and which tier realizes this image.
//RS     pub kind: ImageKind,
//RS     /// `Iso`: the source system's name (`from: system.<name>`).
//RS     /// `Oci`: the source package's name (`from: packages.<name>`).
//RS     pub from: String,
//RS     /// D-ENV-IMAGE1: true when `from:` projects an `env.<name>` into an OCI
//RS     /// shell image. The source kind stays explicit in the plan so realization
//RS     /// cannot confuse an environment with an executable package.
//RS     pub from_environment: bool,
//RS     /// `Iso` only: the disk-image format (`iso` default / `qcow` / `raw`).
//RS     /// Empty for `Oci`.
//RS     pub format: String,
//RS     /// An explicit target platform, if any. ISO realizes it through its
//RS     /// referenced system; OCI records it for the image realization path.
//RS     pub target: Option<String>,
//RS     /// `Oci` only: `expose: [Int]` — TCP ports recorded as `ExposedPorts` in
//RS     /// the OCI image config. Sorted + deduped for reproducibility.
//RS     pub expose: Vec<i64>,
//RS     /// `Oci` only: `env_vars: [KEY: "value"]` — baked into the OCI image
//RS     /// config's `Env` list. Source order follows the map's key order
//RS     /// (`CtValue::Map` is a `BTreeMap`, so this is already sorted by key).
//RS     pub env_vars: Vec<(String, String)>,
//RS     /// `Oci` only: `files: ["path", …]` — extra project-relative paths layered
//RS     /// into the image alongside the package binary. Sorted before layering so
//RS     /// the tar layer is byte-identical regardless of declaration order.
//RS     pub files: Vec<String>,
//RS     /// `Oci` only: `base: oci("<ref>")` — a base-image escape hatch (D-JPK-
//RS     /// IMAGE1 option A). Local `file://` layouts are admitted by digest; remote
//RS     /// refs stay explicit until a verified registry transport is configured.
//RS     pub base: Option<String>,
//RS     /// D-ENV-IMAGE1 expert projection fields. Empty/None uses the safe shell
//RS     /// default for an environment image. Cache, signing, and provenance stay
//RS     /// on Hangar and `.jet/lock`; this record does not duplicate those stores.
//RS     pub services: Vec<String>,
//RS     pub health: Option<String>,
//RS     pub entrypoint: Option<String>,
//RS     pub user: Option<u32>,
//RS }
//RS 
