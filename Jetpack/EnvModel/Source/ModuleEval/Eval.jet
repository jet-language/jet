//RS /// E3402: builtins that perform ambient I/O or network access. A sandboxed
//RS /// package build / module-field evaluation must reach none of them. The fs/net
//RS /// names are future-proofing for the build-from-source path; print/eprint/input
//RS /// are reachable today, so the diagnostic is live (I4).
//RS fn is_ambient_io_builtin(name: &str) -> bool {
//RS     matches!(
//RS         name,
//RS         "read_file"
//RS             | "write_file"
//RS             | "fetch"
//RS             | "http_get"
//RS             | "env_var"
//RS             | "print"
//RS             | "eprint"
//RS             | "input"
//RS             | "read_all_input"
//RS     )
//RS }
//RS 
//RS /// Scan a field expression for an ambient-I/O call; the first one fires E3402.
//RS pub(super) fn check_build_io(value: &Expr) -> Result<(), Diagnostic> {
//RS     let mut found: Option<(String, crate::Diagnostics::Span)> = None;
//RS     crate::Comptime::walk_calls(value, &mut |name, span| {
//RS         if found.is_none() && is_ambient_io_builtin(name) {
//RS             found = Some((name.to_string(), span));
//RS         }
//RS     });
//RS     match found {
//RS         Some((name, span)) => Err(crate::Sema::e3402(&name, Some(span))),
//RS         None => Ok(()),
//RS     }
//RS }
