// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:43
pub fn evaluate_source(src: String, base_dir: OSPath) -> [EvaluatedModule] Diagnostic! {
    program :: parse_program(src)
    evaluate_modules(program.items, src, base_dir)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:51
fn parse_program(src: String) -> Program Diagnostic! {
    (tokens, diagnostics) :: lex_config(src)
    if diagnostics.first() == .Val(d) -> return Err(d)
    parse_config_with_source(tokens, src) catch diags {
        return Err(diags.pop() ?? Diagnostic.error("E0000", "parse failed", "", "", None))
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:74
fn environment_reads(src: String) -> [EnvironmentRead] Diagnostic! {
    (tokens, diagnostics) :: lex(src)
    if diagnostics.first() == .Val(d) -> return Err(d)
    reads := [EnvironmentRead]{}
    collect_environment_reads(tokens, &reads)
    reads
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:84
fn collect_environment_reads(tokens: [Token], reads: &[EnvironmentRead]) -> {
    filtered :: without_comments(tokens)
    loop token in filtered {
        if token.kind == .Ident(name) {
            if Syntax.is_comptime_name(name) && !reads.any(read -> read.name == name) {
                &reads.push(EnvironmentRead{name: name, ty: Syntax.TYPE_STRING})
            }
        }
        if token.kind == .Str(parts) {
            loop part in parts {
                if part == .Interp(interpolation) -> collect_environment_reads(interpolation, &reads)
            }
        }
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:107
fn environment_globals(reads: [EnvironmentRead]) -[Env]> [String: CtValue] {
    globals := [String: CtValue]{}
    loop read in reads {
        name :: read.name.strip_prefix("$") ?? read.name
        // GATE #4494: native process environment and lossless OS-string boundary.
        value :: std.env.var_os(name).map(value -> value.to_string_lossy().into_owned()) ?? ""
        globals[read.name] = CtValue.Str(value)
    }
    globals
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:121
pub fn evaluate_modules(items: [Item], src: String, base_dir: OSPath) -[Env]> [EvaluatedModule] Diagnostic! {
    // GATE #4409: canonical comptime/MIR evaluator bridge.
    jet_codegen.Codegen.MIREval.install_mir_bridge()
    funcs :: collect_funcs(items)
    reads :: environment_reads(src)
    globals :: collect_comptime_globals(items, funcs, base_dir, environment_globals(reads))
    out := [EvaluatedModule]{}
    loop item in items {
        if item == {
            .Module(m) -> {
                if !m.is_auto_discovered() -> next
                &out.push(evaluate_module(m, src, base_dir, funcs, globals))
            }
            else -> {}
        }
    }
    out
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:144
fn collect_funcs(items: [Item]) -> [String: Func] {
    funcs := [String: Func]{}
    loop item in items {
        if item == .Func(f) -> funcs[f.name] = f
    }
    funcs
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:159
fn collect_comptime_globals(items: [Item], funcs: [String: Func], base_dir: OSPath, globals: [String: CtValue]) -> [String: CtValue] Diagnostic! {
    definitions := [String: (Span, Expr)]{}
    loop item in items {
        if item == .Const(def) {
            if def.is_comptime {
                name :: def.name.strip_prefix(Syntax.COMPTIME_MARK) ?? def.name
                definitions[name] = (def.name_span, def.value)
            }
        }
    }
    computed :: evaluate_named_fields(definitions, globals, funcs, Set[String]{}, base_dir, None,
        "module-level comptime values must have a deterministic dependency order",
        "break the cycle by making one value independent or by moving the shared computation into a pure function")
    computed.values
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:192
fn evaluate_module(m: ModuleDecl, src: String, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue]) -> EvaluatedModule Diagnostic! {
    entries := [((Namespace, String), EntryContribution)]{}
    systems := []
    images := []
    fleets := []
    vmtests := []
    environment_contributions := [EnvironmentContribution]{}
    package_profiles := [PackageProfileSpec]{}
    integrations :: evaluate_integration_imports(m.imports, base_dir, funcs, globals)
    loop c in m.contributions {
        if (c.namespace, c.value) == {
            (.Env, .Expr(_)) -> {
                source :: "{m.name}.{c.path}"
                capture :: evaluate_env_contribution(c, src, base_dir, funcs, globals, source)
                reads :: environment_reads(src[c.span.start..<c.span.end])
                &environment_contributions.push(EnvironmentContribution{
                    name: c.path, environment_reads: reads, dev_services: [],
                    secrets: capture.secrets, adapters: capture.adapters, lifecycle: capture.lifecycle,
                    presets: capture.presets, languages: capture.languages, files: capture.files
                })
                &entries.push(((c.namespace, c.path), capture.entry))
            }
            (.Env, .Env(lit)) -> {
                source :: "{m.name}.{c.path}"
                (capture, services) :: evaluate_env_role(lit, src, base_dir, funcs, globals, source)
                reads :: environment_reads(src[c.span.start..<c.span.end])
                &environment_contributions.push(EnvironmentContribution{
                    name: c.path, environment_reads: reads, dev_services: services,
                    secrets: capture.secrets, adapters: capture.adapters, lifecycle: capture.lifecycle,
                    presets: capture.presets, languages: capture.languages, files: capture.files
                })
                &entries.push(((c.namespace, c.path), capture.entry))
            }
            (.System, .System(lit)) -> { &systems.push(evaluate_system(c.path, lit, src, base_dir, funcs, globals)) }
            (.Image, .Image(lit)) -> { &images.push(evaluate_image(c.path, lit, src, base_dir, funcs, globals)) }
            (.Fleet, .Fleet(lit)) -> { &fleets.push(evaluate_fleet(c.path, lit, src, base_dir, funcs, globals)) }
            (.VmTest, .VmTest(lit)) -> { &vmtests.push(evaluate_vmtest(c.path, lit, src, base_dir, funcs, globals)) }
            (.Profile, .Profile(lit)) -> {
                &package_profiles.push(evaluate_package_profile_fields(c.path, lit.fields, src, base_dir, funcs, globals, m.name))
            }
            (.Profile, .Expr(value)) -> {
                &package_profiles.push(evaluate_package_profile_expr(c.path, value, src, base_dir, funcs, globals, m.name))
            }
            else -> panic("contribution namespace/value shape mismatch")
        }
    }
    EvaluatedModule{name: m.name, entries: entries, systems: systems, images: images, fleets: fleets,
        vmtests: vmtests, environment_contributions: environment_contributions,
        integrations: integrations, package_profiles: package_profiles}
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:312
fn push_unique_string(values: &[String], value: String) -> {
    if !values.any(existing -> existing == value) -> &values.push(value)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:322
fn evaluate_integration_imports(imports: [Expr], base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue]) -> [EnvironmentIntegration] Diagnostic! {
    leaves := [Expr]{}
    loop import in imports -> collect_import_leaves(import, &leaves)
    integrations := [EnvironmentIntegration]{}
    loop import in leaves {
        name :: qualified_call_name(import) ?? next
        if name == Syntax.BUILTIN_FIND -> next
        kind :: IntegrationKind.from_call(name) ?? return Err(bad_import_directive(import.span()))
        (args, name_span) :: if import == {
            .Call(call) -> (call.args, call.name_span)
            .MethodCall{args: args, method_span: method_span, ..} -> (args, method_span)
            else -> next
        }
        integration :: evaluate_integration_call(name, args, kind, base_dir, funcs, globals)
        if integrations.find(item -> item.name == integration.name) == {
            .Val(existing) -> {
                if existing != integration {
                    return Err(Diagnostic.error("E1335", "integration `{integration.name}` has conflicting declarations",
                        "one environment graph cannot silently choose different SDK, host, credential, or grant facts",
                        "merge the integration options so they agree, or keep one declaration", Val(name_span)))
                }
            }
            .None -> { &integrations.push(integration) }
        }
    }
    integrations
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:371
fn collect_import_leaves(expr: Expr, out: &[Expr]) -> {
    if expr == {
        .ListLit(items, _) -> { loop item in items -> collect_import_leaves(item, &out) }
        else -> { &out.push(expr) }
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:382
fn evaluate_integration_call(name: String, args: [CallArg], kind: IntegrationKind, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue]) -> EnvironmentIntegration Diagnostic! {
    integration := EnvironmentIntegration{kind: kind, name: name, preset: kind.as_str(), ..EnvironmentIntegration.default()}
    if kind == {
        .Android -> {
            integration.options["api"] = "34"
            integration.options["build_tools"] = "34.0.0"
            integration.options["ndk"] = "26.3"
            integration.options["license"] = "policy-required"
            integration.packages = ["android-tools@nixpkgs", "android-sdk@nixpkgs"]
            &integration.tasks.push("android-sdk-check")
            &integration.providers.push("nixpkgs")
            &integration.host_checks.push("target:linux-or-android")
        }
        .Apple -> {
            integration.options["targets"] = "IOS"
            integration.options["license"] = "policy-required"
            &integration.packages.push("apple-sdk@nixpkgs")
            &integration.tasks.push("apple-sdk-check")
            &integration.providers.push("nixpkgs")
            &integration.host_checks.push("target:darwin-or-macos")
        }
        .Certificates -> {
            integration.preset = "certificate-store"
            &integration.tasks.push("certificate-store-check")
            &integration.providers.push("vault")
            &integration.grants.push("certificate.read")
        }
        .Hosts -> {
            integration.preset = "project-hosts"
            &integration.tasks.push("host-binding-check")
            &integration.providers.push("host-binding")
        }
        .CodexAgent -> {
            integration.preset = "codex"
            &integration.tasks.push("mcp-agent-check")
            &integration.providers.push("mcp")
            &integration.grants.push("mcp.read")
        }
        .Editor -> {
            integration.preset = "vscode"
            &integration.packages.push("vscode@nixpkgs")
            &integration.providers.push("nixpkgs")
        }
        .CloudCredentials -> {
            integration.preset = "cloud-credentials"
            &integration.tasks.push("credential-store-check")
            &integration.providers.push("credential-store")
            &integration.grants.push("credential.read")
        }
        .Vault -> {
            integration.preset = "vault"
            &integration.tasks.push("vault-check")
            &integration.providers.push("vault")
            &integration.grants.push("vault.read")
        }
    }
    loop (index, arg) in args.enumerate() {
        key :: arg.label.map(label -> label.0) ?? "arg{index}"
        secret_reference :: if kind == {
            .Certificates | .CloudCredentials | .Vault -> integration_reference_names(arg.expr)
            else -> Val([String]{})
        }
        // Invalid secret ASTs must never be evaluated into caller plaintext.
        value :: if secret_reference == {
            .None -> CtValue.Int(0)
            .Val(_) -> integration_arg_value(arg.expr, base_dir, funcs, globals)
        }
        lower_integration_arg(&integration, key, arg.expr, value)
    }
    integration
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:486
fn integration_arg_value(expr: Expr, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue]) -> CtValue Diagnostic! {
    if expr == {
        .Ident(name, _) -> CtValue.Str(name)
        .Field(base, member, _) -> CtValue.Str("{expression_name(base)}.{member}")
        .ListLit(values, _) -> {
            lowered := [CtValue]{}
            loop value in values -> &lowered.push(integration_arg_value(value, base_dir, funcs, globals))
            CtValue.List(lowered)
        }
        .MapLit(values, _) -> {
            lowered := [CtKey: CtValue]{}
            loop (key_expr, value_expr) in values {
                key_value :: integration_arg_value(key_expr, base_dir, funcs, globals)
                value :: integration_arg_value(value_expr, base_dir, funcs, globals)
                key :: integration_ct_key(key_value) ?? return Err(Diagnostic.error("E1335",
                    "integration map keys must be deterministic scalar values",
                    "host mappings and integration selections become named graph facts; arbitrary values cannot be used as stable keys",
                    "use a string, integer, boolean, or character key", Val(expr.span())))
                if lowered.contains_key(key) {
                    return Err(Diagnostic.error("E1335", "integration map contains a duplicate key",
                        "one integration fact graph cannot silently choose between two values for the same host or secret name",
                        "remove the duplicate key or merge its values", Val(expr.span())))
                }
                lowered[key] = value
            }
            CtValue.Map(lowered)
        }
        .StructLit{type_name: type_name, fields: fields, ..} -> {
            lowered := [(String, CtValue)]{}
            loop (name, _, value) in fields -> &lowered.push((name, integration_arg_value(value, base_dir, funcs, globals)))
            CtValue.Struct{type_name: type_name, fields: lowered}
        }
        .EnumLit{type_name: type_name, variant: variant, args: args, ..} -> {
            lowered := [(String?, CtValue)]{}
            loop arg in args {
                (name, value) :: if arg == {
                    .Positional(value) -> (None, value)
                    .Named{label: label, expr: value} -> (Val(label), value)
                }
                &lowered.push((name, integration_arg_value(value, base_dir, funcs, globals)))
            }
            CtValue.Enum{type_name: type_name, variant: variant, args: lowered}
        }
        else -> {
            check_build_io(expr)
            evaluate(expr, funcs, Set[String]{}, base_dir, globals)
        }
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:576
fn integration_ct_key(value: CtValue) -> CtKey? {
    if value == {
        .Str(v) -> Val(CtKey.Str(v))
        .Int(v) -> Val(CtKey.Int(v))
        .Bool(v) -> Val(CtKey.Bool(v))
        .Char(v) -> Val(CtKey.Char(v))
        else -> None
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:586
fn expression_name(expr: Expr) -> String {
    if expr == {
        .Ident(name, _) -> name
        .Field(base, member, _) -> "{expression_name(base)}.{member}"
        else -> expr.span().start.to_string()
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:594
fn lower_integration_arg(integration: &EnvironmentIntegration, key: String, expr: Expr, value: CtValue) -> {
    display :: integration_value_text(value)
    if integration.kind == {
        .Certificates | .CloudCredentials | .Vault -> {
            names :: integration_reference_names(expr) ?? []
            if names.is_empty() {
                &integration.losses.push("{key}: secret input must be a named reference; value was redacted")
            } else {
                loop name in names -> push_unique_string(&integration.secrets, name)
            }
            integration.options[key] = "<redacted-names>"
        }
        .Hosts -> {
            if value == {
                .Map(entries) -> {
                    keys := entries.keys()
                    &keys.sort()
                    loop map_key in keys {
                        if map_key == .Str(host) -> integration.options["host.{host}"] = integration_value_text(entries[map_key])
                    }
                }
                else -> integration.options[key] = display
            }
        }
        else -> integration.options[key] = display
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:637
// Rust's unit error means the expression is not a named reference.
fn integration_reference_names(expr: Expr) -> [String]? {
    if expr.without_parens() == {
        .Ident(name, _) -> Val([name])
        .Field(_, _, _) -> integration_reference_path(expr).map(name -> [name])
        .ListLit(values, _) -> {
            names := [String]{}
            loop value in values {
                found :: integration_reference_names(value) ?? return None
                &names.extend(found)
            }
            Val(names)
        }
        else -> None
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:654
fn integration_reference_path(expr: Expr) -> String? {
    if expr.without_parens() == {
        .Ident(name, _) -> Val(name)
        .Field(base, member, _) -> {
            name :: integration_reference_path(base) ?? return None
            Val("{name}.{member}")
        }
        else -> None
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:664
fn integration_value_text(value: CtValue) -> String {
    if value == {
        .Str(v) -> v
        .Int(v) -> v.to_string()
        .Bool(v) -> v.to_string()
        .Char(v) -> v.to_string()
        .Enum{variant: variant, args: args, ..} if args.is_empty() -> variant.rsplit(".").next() ?? variant
        .List(values) -> values.map(integration_value_text).join(",")
        .Map(values) -> {
            keys := values.keys()
            &keys.sort()
            keys.map(key -> "{integration_key_text(key)}={integration_value_text(values[key])}").join(",")
        }
        .Struct{fields: fields, ..} -> fields.map(field -> "{field.0}={integration_value_text(field.1)}").join(",")
        else -> value.jet_show()
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:698
fn integration_key_text(key: CtKey) -> String {
    if key == {
        .Int(v) -> v.to_string()
        .Str(v) -> v
        .Bool(v) -> v.to_string()
        .Char(v) -> v.to_string()
        // Composite keys use the single value-semantic rendering rule.
        .Tuple(_) | .Struct{..} | .Enum{..} -> key.to_value().jet_show()
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:712
pub fn lifecycle_merge(target: &EnvironmentLifecycle, incoming: EnvironmentLifecycle, module_name: String) -> Diagnostic! {
    &target.dotenv.extend(incoming.dotenv)
    &target.unset.extend(incoming.unset)
    &target.on_enter.extend(incoming.on_enter)
    &target.checks.extend(incoming.checks)
    if incoming.git_hooks_path == .Val(path) {
        if target.git_hooks_path == {
            .Val(existing) -> {
                if existing != path -> return Err(Diagnostic.error("E1333",
                    "git hook path is declared more than once with conflicting values in module `{module_name}`",
                    "one environment cannot silently choose between different Git hook directories",
                    "merge the git_hooks_path declarations so they agree, or keep one path owner", None))
            }
            .None -> target.git_hooks_path = Val(path)
        }
    }
    if incoming.reload_explicit {
        if target.reload_explicit && target.reload != incoming.reload -> return Err(Diagnostic.error("E1333",
            "reload policy is declared more than once in module `{module_name}`",
            "one module cannot silently choose between different reload policies",
            "merge the reload declarations so they agree, or keep one policy owner", None))
        target.reload = incoming.reload
        target.reload_explicit = true
    }
    if incoming.formatter == .Val(formatter) {
        if target.formatter == {
            .Val(existing) -> {
                if existing != formatter -> return Err(Diagnostic.error("E1333",
                    "formatter is declared more than once with conflicting packages in module `{module_name}`",
                    "one environment cannot silently choose between different external formatters",
                    "merge the formatter declarations so they agree, or keep one formatter owner", None))
            }
            .None -> target.formatter = Val(formatter)
        }
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:769
type EnvCapture {
    entry: EntryContribution
    secrets: [SecretSpec]
    adapters: [AdapterPlan]
    lifecycle: EnvironmentLifecycle
    presets: [PresetSpec]
    languages: [LanguageSpec]
    files: [ManagedFile]
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:779
fn namespace_type(ns: Namespace) -> String {
    if ns == {
        .Env -> Syntax.TYPE_ENV
        .System -> Syntax.TYPE_SYSTEM
        .Image -> Syntax.TYPE_IMAGE
        .Fleet -> Syntax.TYPE_FLEET
        .VmTest -> Syntax.TYPE_VMTEST
        .Profile -> Syntax.TYPE_PROFILE
        .Perf -> Syntax.TYPE_BUDGET
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:791
fn evaluate_package_profile_expr(name: String, value: Expr, src: String, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue], module_name: String) -> PackageProfileSpec Diagnostic! {
    (type_name, fields) :: if value == {
        .StructLit{type_name: type_name, fields: fields, ..} -> (type_name, fields)
        else -> return Err(not_a_namespace_literal(Syntax.TYPE_PROFILE, value.span()))
    }
    if !type_name.is_empty() && type_name != Syntax.TYPE_PROFILE {
        return Err(wrong_namespace_type(Syntax.TYPE_PROFILE, type_name, value.span()))
    }
    evaluate_package_profile_fields(name, fields, src, base_dir, funcs, globals, module_name)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:816
fn evaluate_package_profile_fields(name: String, fields: [(String, Span, Expr)], src: String, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue], module_name: String) -> PackageProfileSpec Diagnostic! {
    allowed :: [Syntax.PROFILE_FIELD_EXTENDS, Syntax.PROFILE_FIELD_PACKAGES, Syntax.PROFILE_FIELD_COLLISIONS]
    seen := Set[String]{}
    loop (field, span, _) in fields {
        if !allowed.contains(field) -> return Err(Diagnostic.error("E1333",
            "package generation `{name}` has unknown field `{field}`",
            "a source-backed package generation has only `extends`, `packages`, and `collisions` facts",
            "remove the field or move user/environment settings into a declared `user.<name>` generation", Val(span)))
        if !&seen.insert(field) -> return Err(Diagnostic.error("E1332",
            "package generation `{name}` repeats field `{field}`",
            "one package generation must have one value for each typed fact",
            "keep one declaration for the field, or split the generations and compose them with `extends`", Val(span)))
    }
    field_map := [String: (Span, Expr)]{}
    loop (field, span, value) in fields {
        if field != Syntax.PROFILE_FIELD_PACKAGES && field != Syntax.PROFILE_FIELD_COLLISIONS -> field_map[field] = (span, value)
    }
    computed :: evaluate_named_fields(field_map, globals, funcs, Set[String]{}, base_dir, Val(src),
        "package generation fields are pure computed values; a cycle has no deterministic evaluation order",
        "break the cycle by making one generation field a literal or by moving the shared computation into a pure function")
    resolved :: computed.values
    packages := [String]{}
    loop (field, _, value) in fields {
        if field != Syntax.PROFILE_FIELD_PACKAGES -> next
        extracted :: extract_packages(value, src)
        loop package in extracted.packages -> push_unique_string(&packages, pkg_ref(package))
        if !extracted.adapters.is_empty() -> return Err(Diagnostic.error("E1335",
            "package generation `{name}` contains an adapter package",
            "generation packages must retain provider identity and cannot hide a build recipe inside the generation declaration",
            "realize the adapter as a named package, then reference its exact package identity", Val(value.span())))
    }
    extends :: if resolved.get(Syntax.PROFILE_FIELD_EXTENDS) == {
        .None -> [String]{}
        .Val(value) -> string_names_from(value) ?? return Err(Diagnostic.error("E1333",
            "package generation `{name}` has invalid `extends`",
            "generation inheritance is a deterministic list of generation names",
            "write `extends: [\"base\"]`", Val(value_span(fields, Syntax.PROFILE_FIELD_EXTENDS))))
    }
    collisions := [String: String]{}
    if fields.find(field -> field.0 == Syntax.PROFILE_FIELD_COLLISIONS) == .Val(field) {
        collisions = package_profile_collisions_source(src, name, field.2.span())
    }
    PackageProfileSpec{name: name, extends: extends, packages: packages, collisions: collisions, sources: [module_name]}
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:918
fn value_span(fields: [(String, Span, Expr)], name: String) -> Span {
    fields.find(field -> field.0 == name).map(field -> field.1) ?? Span.new(0, 0)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:929
fn package_profile_collisions_source(src: String, name: String, span: Span) -> [String: String] Diagnostic! {
    fragment :: src.get(span.start..<span.end) ?? return Err(Diagnostic.error("E1333",
        "package generation `{name}` has invalid `collisions`", "collision policy is an exact string path-to-provider map",
        "write `collisions: { \"bin/editor\": \"editor@nixpkgs\" }`", Val(span)))
    values :: quoted_collision_values(fragment)
    if values.is_empty() || values.len() % 2 != 0 -> return Err(Diagnostic.error("E1333",
        "package generation `{name}` has invalid `collisions`", "collision policy is an exact string path-to-provider map",
        "write `collisions: { \"bin/editor\": \"editor@nixpkgs\" }`", Val(span)))
    out := [String: String]{}
    loop pair in values.chunks_exact(2) {
        path :: pair[0]
        provider :: pair[1]
        if path.trim().is_empty() || provider.trim().is_empty() || path.contains(TEXT_NUL) {
            return Err(Diagnostic.error("E1333", "package generation `{name}` has an invalid collision entry",
                "exact collision paths and provider identities cannot be empty or contain NUL",
                "name the path and the exact package provider", Val(span)))
        }
        if out.contains_key(path) -> return Err(Diagnostic.error("E1332",
            "package generation `{name}` repeats collision path `{path}`",
            "one generation cannot choose two providers for one exact path",
            "keep one collision selection for the path", Val(span)))
        out[path] = provider
    }
    out
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:980
fn quoted_collision_values(fragment: String) -> [String] {
    values := [String]{}
    chars := fragment.chars()
    loop {
        character :: &chars.next() ?? break
        if character != '"' -> next
        value := ""
        escaped := false
        closed := false
        loop {
            character :: &chars.next() ?? break
            if escaped {
                &value.push(if character == {
                    'n' -> '\n'
                    'r' -> '\r'
                    't' -> '\t'
                    '\\' -> '\\'
                    '"' -> '"'
                    other -> other
                })
                escaped = false
            } else if character == '\\' {
                escaped = true
            } else if character == '"' {
                closed = true
                break
            } else {
                &value.push(character)
            }
        }
        if !closed -> return []
        &values.push(value)
    }
    values
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1022
fn is_ambient_io_builtin(name: String) -> Bool {
    if name == {
        "read_file" | "write_file" | "fetch" | "http_get" | "env_var" |
        "print" | "eprint" | "input" | "read_all_input" -> true
        else -> false
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1038
pub fn check_build_io(value: Expr) -> Diagnostic! {
    found := (String, Span)?{None}
    walk_calls(value, (name, span) -> {
        if found.is_none() && is_ambient_io_builtin(name) -> found = Val((name, span))
    })
    if found == .Val((name, span)) -> return Err(jet_sema.e3402(name, Val(span)))
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1051
fn evaluate_env_contribution(c: Contribution, src: String, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue], source: String) -> EnvCapture Diagnostic! {
    expected :: namespace_type(c.namespace)
    value :: if c.value == {
        .Expr(value) -> value
        else -> panic("evaluate_env_contribution called on a non-env contribution")
    }
    (type_name, fields) :: if value == {
        .StructLit{type_name: type_name, fields: fields, ..} -> (type_name, fields)
        else -> return Err(not_a_namespace_literal(expected, value.span()))
    }
    if !type_name.is_empty() && type_name != expected -> return Err(wrong_namespace_type(expected, type_name, value.span()))
    evaluate_env_fields(fields, src, base_dir, funcs, globals, source)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1085
// Packages retain their text-level syntax; all sibling facts resolve as a pure graph.
fn evaluate_env_fields(fields: [(String, Span, Expr)], src: String, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue], source: String) -> EnvCapture Diagnostic! {
    entry := EntryContribution.default()
    secrets := [SecretSpec]{}
    adapters := [AdapterPlan]{}
    lifecycle := EnvironmentLifecycle.default()
    presets := [PresetSpec]{}
    languages := [LanguageSpec]{}
    files := [ManagedFile]{}
    extern_names :: Set[String]{}
    field_map := [String: (Span, Expr)]{}
    loop (name, span, value) in fields {
        if name != Syntax.SYSTEM_FIELD_PACKAGES && name != Syntax.ENV_FIELD_SECRETS && !is_lifecycle_field(name) {
            field_map[name] = (span, value)
        }
    }
    loop (name, _, value) in fields {
        if name == Syntax.SYSTEM_FIELD_PACKAGES {
            extracted :: extract_packages(value, src)
            &entry.packages.extend(extracted.packages)
            &adapters.extend(extracted.adapters)
        }
    }
    computed :: evaluate_named_fields(field_map, globals, funcs, extern_names, base_dir, Val(src),
        "module fields are pure computed values; a cycle has no deterministic evaluation order",
        "break the cycle by making one field a literal or by moving the shared computation into a pure function")
    resolved :: computed.values
    loop (name, span, value) in fields {
        if name == Syntax.SYSTEM_FIELD_PACKAGES {
            next
        } else if name == Syntax.ENV_FIELD_PROMPT {
            capture_prompt_setting(&entry, value, base_dir, funcs, resolved, source)
        } else if name == Syntax.ENV_FIELD_SECRETS {
            &secrets.extend(parse_secret_specs(value, base_dir, funcs, globals))
        } else if name == Syntax.ENV_FIELD_PRESETS {
            if resolved.get(name) == .Val(value) {
                lowered :: presets_from_value(value) catch error {
                    return Err(Diagnostic.error("E1332", "environment preset declaration is invalid: {error}",
                        "presets are named typed records with string package, variable, and inheritance facts",
                        "use `presets: { dev: .{ packages: [\"tool@nixpkgs\"] } }`", Val(span)))
                }
                &presets.extend(lowered)
            }
        } else if name == Syntax.ENV_FIELD_LANGUAGES {
            if resolved.get(name) == .Val(value) {
                lowered :: languages_from_value(value) catch error {
                    return Err(Diagnostic.error("E1333", "language-pack declaration is invalid: {error}",
                        "languages is a typed map of Lang records that expands through Jet's catalog",
                        "use `languages: { rust: Lang.{ enable: true } }` or another name from `jet env info`", Val(span)))
                }
                &languages.extend(lowered)
            }
        } else if name == Syntax.ENV_FIELD_FILES {
            if resolved.get(name) == .Val(value) {
                lowered :: files_from_value(value) catch error {
                    return Err(Diagnostic.error("E1326", "environment file declaration is invalid: {error}",
                        "managed files use project-relative destinations and typed Symlink, Seed, or Copy records",
                        "fix the file destination and source/content shape before running `jet env sync`", Val(span)))
                }
                &files.extend(lowered)
            }
        } else if is_lifecycle_field(name) {
            lowered :: evaluate_lifecycle_value(value, base_dir, funcs, globals)
            lifecycle_from_field(&lifecycle, name, lowered) catch error {
                return Err(Diagnostic.error("E1333", "environment lifecycle declaration is invalid: {error}",
                    "lifecycle fields use typed dotenv, unset, job names, hook records, and Git hook paths",
                    "fix the field shape, for example `on_enter: [prepare]`, `dotenv: [\".env\"]`, `git_hooks_path: \"scripts/githooks\"`, or `reload: .Prompt`", Val(span)))
            }
        } else {
            v :: resolved.get(name) ?? return Err(field_missing_value(name, value.span()))
            record_setting(&entry, name, v.jet_show(), span, source)
        }
    }
    EnvCapture{entry: entry, secrets: secrets, adapters: adapters, lifecycle: lifecycle, presets: presets, languages: languages, files: files}
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1207
fn is_lifecycle_field(name: String) -> Bool {
    [Syntax.ENV_FIELD_DOTENV, Syntax.ENV_FIELD_UNSET, Syntax.ENV_FIELD_ON_ENTER,
        Syntax.ENV_FIELD_CHECKS, Syntax.ENV_FIELD_GIT_HOOKS_PATH, Syntax.ENV_FIELD_FORMATTER,
        Syntax.ENV_FIELD_RELOAD].contains(name)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1223
// Lifecycle identifiers are references, not comptime variable reads.
fn evaluate_lifecycle_value(expr: Expr, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue]) -> CtValue Diagnostic! {
    if expr == {
        .Ident(name, _) -> CtValue.Str(name)
        .Field{..} -> CtValue.Str(expression_name(expr))
        .ListLit(values, _) -> {
            lowered := [CtValue]{}
            loop value in values -> &lowered.push(evaluate_lifecycle_value(value, base_dir, funcs, globals))
            CtValue.List(lowered)
        }
        .StructLit{type_name: type_name, fields: fields, ..} -> {
            lowered := [(String, CtValue)]{}
            loop (name, _, value) in fields -> &lowered.push((name, evaluate_lifecycle_value(value, base_dir, funcs, globals)))
            CtValue.Struct{type_name: type_name, fields: lowered}
        }
        .EnumLit{type_name: type_name, variant: variant, args: args, ..} -> {
            lowered := [(String?, CtValue)]{}
            loop arg in args {
                (name, value) :: if arg == {
                    .Positional(value) -> (None, value)
                    .Named{label: label, expr: value} -> (Val(label), value)
                }
                &lowered.push((name, evaluate_lifecycle_value(value, base_dir, funcs, globals)))
            }
            CtValue.Enum{type_name: type_name, variant: variant, args: lowered}
        }
        .MapLit(entries, _) -> {
            lowered := [CtKey: CtValue]{}
            loop (key, value) in entries {
                key_value :: evaluate_lifecycle_value(key, base_dir, funcs, globals)
                key :: integration_ct_key(key_value) ?? return Err(Diagnostic.error("E1333",
                    "lifecycle map keys must be deterministic scalar values",
                    "lifecycle records are captured as stable plan facts",
                    "use a string, integer, boolean, or character key", Val(expr.span())))
                lowered[key] = evaluate_lifecycle_value(value, base_dir, funcs, globals)
            }
            CtValue.Map(lowered)
        }
        else -> {
            check_build_io(expr)
            evaluate(expr, funcs, Set[String]{}, base_dir, globals)
        }
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1302
fn field_missing_value(name: String, span: Span) -> Diagnostic {
    Diagnostic.error("E3403", "computed module field `{name}` did not produce a value",
        "a pure module field must evaluate to one deterministic value before the module is merged",
        "return a value from the field expression", Val(span))
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1313
fn capture_prompt_setting(entry: &EntryContribution, value: Expr, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue], source: String) -> Diagnostic! {
    if value == .StructLit{type_name: type_name, fields: fields, ..} {
        if type_name == Syntax.TYPE_PROMPT {
            extern_names :: Set[String]{}
            loop (field, span, expr) in fields {
                v :: evaluate_expression(expr, globals, funcs, extern_names, base_dir)
                if field == {
                    Syntax.PROMPT_FIELD_LABEL -> {
                        label :: string_value(v) ?? return Err(prompt_bad_value(field, "a quoted label", span))
                        record_setting(&entry, Syntax.ENV_FIELD_PROMPT, label, span, source)
                    }
                    Syntax.PROMPT_FIELD_PATH -> {
                        word :: prompt_word(v) ?? return Err(prompt_bad_value(field, ".Short or .Full", span))
                        if word != Syntax.PROMPT_PATH_SHORT && word != Syntax.PROMPT_PATH_FULL {
                            return Err(prompt_bad_value(field, ".Short or .Full", span))
                        }
                        record_setting(&entry, Syntax.PROMPT_SETTING_PATH, word, span, source)
                    }
                    Syntax.PROMPT_FIELD_STRIP -> {
                        word :: prompt_word(v) ?? return Err(prompt_bad_value(field, ".On or .Off", span))
                        if word != Syntax.PROMPT_STRIP_ON && word != Syntax.PROMPT_STRIP_OFF {
                            return Err(prompt_bad_value(field, ".On or .Off", span))
                        }
                        record_setting(&entry, Syntax.PROMPT_SETTING_STRIP, word, span, source)
                    }
                    else -> return Err(prompt_bad_field(field, span))
                }
            }
            return
        }
    }
    v :: evaluate_expression(value, globals, funcs, Set[String]{}, base_dir)
    record_setting(&entry, Syntax.ENV_FIELD_PROMPT, v.jet_show(), value.span(), source)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1373
fn record_setting(entry: &EntryContribution, key: String, value: String, span: Span, source: String) -> {
    fact :: FactContribution.new(key, FactValue.Text(value), SourceScope.Item,
        ContributionLayer.Environment, "{source}.{key}").at(span)
    &entry.settings.entry(key).or_default().push(fact)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1392
fn string_value(v: CtValue) -> String? {
    if v == {
        .Str(s) -> Val(s)
        else -> None
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1399
fn prompt_word(v: CtValue) -> String? {
    if v == {
        .Enum{variant: variant, ..} -> variant.rsplit(".").next()
        .Str(s) -> Val(s)
        else -> None
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1411
fn string_names_from(v: CtValue) -> [String]? {
    xs :: if v == {
        .List(xs) -> xs
        else -> return None
    }
    names := [String]{}
    loop x in xs {
        name :: string_value(x) ?? return None
        &names.push(name)
    }
    Val(names)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1423
fn secret_decl_error(message: String, span: Span) -> Diagnostic {
    Diagnostic.error("E1333", "secret declaration is invalid: {message}",
        "`secrets:` is one typed map from a secret name to either a metadata record or a `compose(template:, from:)` declaration",
        "fix the named secret declaration without putting a secret value in the configuration", Val(span))
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1433
fn secret_name_error(name: String, span: Span) -> Diagnostic {
    secret_decl_error("secret name `{name}` is not a valid name", span)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1440
fn parse_secret_specs(value: Expr, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue]) -> [SecretSpec] Diagnostic! {
    entries := [(String, Span, Expr)]{}
    if value.without_parens() == {
        .StructLit{type_name: type_name, fields: fields, ..} -> {
            if !type_name.is_empty() -> return Err(secret_decl_error(
                "the secret declaration map must be an inferred `{ … }` record", value.span()))
            &entries.extend(fields)
        }
        .MapLit(fields, _) -> {
            loop (key_expr, value_expr) in fields {
                key :: secret_eval_value(key_expr, base_dir, funcs, globals) catch _ {
                    return Err(secret_decl_error("secret map keys must be strings or bare names", key_expr.span()))
                }
                name :: if key == {
                    .Str(name) -> name
                    else -> return Err(secret_decl_error("secret map keys must be strings or bare names", key_span(key, value_expr.span())))
                }
                &entries.push((name, value_expr.span(), value_expr))
            }
        }
        else -> return Err(secret_decl_error("`secrets:` must be a map from names to declarations", value.span()))
    }
    seen := Set[String]{}
    specs := [SecretSpec].with_capacity(entries.len())
    loop (name, span, declaration) in entries {
        if !valid_env_name(name) -> return Err(secret_name_error(name, span))
        if !&seen.insert(name) -> return Err(secret_decl_error("secret name `{name}` is declared more than once", span))
        spec :: if declaration.without_parens() == {
            .Call(call) if call.name == Syntax.SECRET_COMPOSE -> parse_secret_compose(name, call, base_dir, funcs, globals)
            .StructLit{..} -> parse_secret_metadata(name, declaration, base_dir, funcs, globals)
            else -> return Err(secret_decl_error("secret `{name}` must use a metadata record or `compose(...)`", declaration.span()))
        }
        &specs.push(spec)
    }
    validate_secret_graph(specs, value.span())
    specs
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1517
fn key_span(_key: CtValue, fallback: Span) -> Span {
    // Lowered keys have no independent span; never render rejected key contents.
    fallback
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1523
fn parse_secret_metadata(name: String, value: Expr, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue]) -> SecretSpec Diagnostic! {
    (type_name, fields) :: if value.without_parens() == {
        .StructLit{type_name: type_name, fields: fields, ..} -> (type_name, fields)
        else -> panic("secret metadata dispatch validates the record shape")
    }
    if !type_name.is_empty() -> return Err(secret_decl_error("secret `{name}` metadata must be an inferred record", value.span()))
    allowed :: [Syntax.SECRET_META_FIELD_DESCRIPTION, Syntax.SECRET_META_FIELD_REQUIRED,
        Syntax.SECRET_META_FIELD_ALLOWED_ENVIRONMENTS, Syntax.SECRET_META_FIELD_ROTATION,
        Syntax.SECRET_META_FIELD_DEFAULT, Syntax.SECRET_META_FIELD_GENERATE]
    values := [String: (Span, CtValue)]{}
    loop (field, span, expression) in fields {
        if !allowed.contains(field) -> return Err(secret_decl_error("secret `{name}` has unknown field `{field}`", span))
        if values.contains_key(field) -> return Err(secret_decl_error("secret `{name}` repeats field `{field}`", span))
        lowered :: secret_eval_value(expression, base_dir, funcs, globals) catch _ {
            return Err(secret_decl_error("secret `{name}` field `{field}` is not a deterministic value", span))
        }
        values[field] = (span, lowered)
    }
    description :: if values.get(Syntax.SECRET_META_FIELD_DESCRIPTION) == {
        .None -> None
        .Val((span, value)) -> if value == {
            .Str(text) -> Val(text)
            else -> return Err(secret_decl_error("secret `{name}` field `{Syntax.SECRET_META_FIELD_DESCRIPTION}` must be a string", span))
        }
    }
    required :: if values.get(Syntax.SECRET_META_FIELD_REQUIRED) == {
        .None -> true
        .Val((_, .Bool(value))) -> value
        .Val((span, _)) -> return Err(secret_decl_error("secret `{name}` field `{Syntax.SECRET_META_FIELD_REQUIRED}` must be a boolean", span))
    }
    allowed_environments :: if values.get(Syntax.SECRET_META_FIELD_ALLOWED_ENVIRONMENTS) == {
        .None -> [String]{}
        .Val((span, value)) -> secret_environment_list(name, value, span)
    }
    rotation :: if values.get(Syntax.SECRET_META_FIELD_ROTATION) == {
        .None -> SecretRotationPolicy.None
        .Val((span, value)) -> secret_rotation(name, value, span)
    }
    default :: if values.get(Syntax.SECRET_META_FIELD_DEFAULT) == {
        .None -> SecretDefault.None
        .Val((span, value)) -> secret_default(name, value, span)
    }
    generate :: if values.get(Syntax.SECRET_META_FIELD_GENERATE) == {
        .None -> SecretGenerator.None
        .Val((span, value)) -> secret_generator(name, value, span)
    }
    validate_secret_policies(name, required, allowed_environments, default, generate, value.span())
    SecretSpec{name: name, description: description, required: required,
        allowed_environments: allowed_environments, rotation: rotation, default: default,
        generate: generate, declaration: SecretDeclaration.Stored, implicit: false}
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1636
fn validate_secret_policies(name: String, required: Bool, allowed_environments: [String], default: SecretDefault, generate: SecretGenerator, span: Span) -> Diagnostic! {
    has_default :: if default == {
        .PerProfile(values) -> !values.is_empty()
        else -> false
    }
    has_generator :: generate != SecretGenerator.None
    if has_default && has_generator -> return Err(secret_decl_error(
        "secret `{name}` cannot declare both `{Syntax.SECRET_META_FIELD_DEFAULT}` and `{Syntax.SECRET_META_FIELD_GENERATE}`", span))
    if required && (has_default || has_generator) -> return Err(secret_decl_error(
        "secret `{name}` is required and cannot declare `{Syntax.SECRET_META_FIELD_DEFAULT}` or `{Syntax.SECRET_META_FIELD_GENERATE}`", span))
    if !allowed_environments.is_empty() {
        if default == .PerProfile(values) {
            profiles := values.keys()
            &profiles.sort()
            loop profile in profiles {
                if !allowed_environments.contains(profile) -> return Err(secret_decl_error(
                    "secret `{name}` default profile `{profile}` is outside `{Syntax.SECRET_META_FIELD_ALLOWED_ENVIRONMENTS}`", span))
            }
        }
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1688
fn parse_secret_compose(name: String, call: Call, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue]) -> SecretSpec Diagnostic! {
    template := (String, Span)?{None}
    from := (CtValue, Span)?{None}
    seen := Set[String]{}
    loop argument in call.args {
        (label, label_span) :: argument.label ?? return Err(secret_decl_error(
            "secret `{name}` compose arguments must be labeled", argument.span))
        if !&seen.insert(label) -> return Err(secret_decl_error("secret `{name}` compose repeats field `{label}`", label_span))
        if label == {
            Syntax.SECRET_COMPOSE_FIELD_TEMPLATE -> {
                text :: secret_template_value(argument.expr, base_dir, funcs, globals) catch _ {
                    return Err(secret_decl_error("secret `{name}` compose `template` must be text", argument.expr.span()))
                }
                template = Val((text, argument.expr.span()))
            }
            Syntax.SECRET_COMPOSE_FIELD_FROM -> {
                value :: secret_eval_value(argument.expr, base_dir, funcs, globals) catch _ {
                    return Err(secret_decl_error("secret `{name}` compose `from` must be a list of names", argument.expr.span()))
                }
                from = Val((value, argument.expr.span()))
            }
            else -> return Err(secret_decl_error("secret `{name}` compose has unknown field `{label}`", label_span))
        }
    }
    (template, template_span) :: template ?? return Err(secret_decl_error("secret `{name}` compose needs `template`", call.name_span))
    (from_value, from_span) :: from ?? return Err(secret_decl_error("secret `{name}` compose needs `from`", call.name_span))
    inputs := secret_string_list(from_value, "secret `{name}` compose `from`", from_span)
    if inputs.is_empty() -> return Err(secret_decl_error("secret `{name}` compose `from` must not be empty", from_span))
    seen_inputs := Set[String]{}
    loop input in inputs {
        if !valid_env_name(input) -> return Err(secret_name_error(input, from_span))
        if !&seen_inputs.insert(input) -> return Err(secret_decl_error("secret `{name}` compose repeats input `{input}`", from_span))
    }
    validate_secret_template(name, template, inputs, template_span)
    &inputs.sort()
    SecretSpec{name: name, description: None, required: true, allowed_environments: [],
        rotation: SecretRotationPolicy.None, default: SecretDefault.None, generate: SecretGenerator.None,
        declaration: SecretDeclaration.Compose{template: template, from: inputs}, implicit: false}
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1786
fn secret_environment_list(name: String, value: CtValue, span: Span) -> [String] Diagnostic! {
    values :: secret_string_list(value, "secret `{name}` field `{Syntax.SECRET_META_FIELD_ALLOWED_ENVIRONMENTS}`", span)
    seen := Set[String]{}
    loop environment in values {
        if !valid_env_name(environment) -> return Err(secret_decl_error(
            "secret `{name}` names invalid environment label `{environment}`", span))
        if !&seen.insert(environment) -> return Err(secret_decl_error(
            "secret `{name}` repeats allowed environment `{environment}`", span))
    }
    values
}
