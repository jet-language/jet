//RS fn integration_key_text(key: &CtKey) -> String {
//RS     match key {
//RS         CtKey::Int(value) => value.to_string(),
//RS         CtKey::Str(value) => value.clone(),
//RS         CtKey::Bool(value) => value.to_string(),
//RS         CtKey::Char(value) => value.to_string(),
//RS         // D-MAP-KEY1: a composite key is value-semantic, so its text is the
//RS         // rendering of the value it holds. An integration key is a display
//RS         // string, not an identity, so deferring to jet_show keeps one
//RS         // rendering rule rather than a second one written here.
//RS         CtKey::Tuple(_) | CtKey::Struct { .. } | CtKey::Enum { .. } => key.to_value().jet_show(),
//RS     }
//RS }
