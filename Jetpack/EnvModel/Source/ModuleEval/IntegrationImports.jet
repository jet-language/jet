// D-ENV-INTEGRATIONS1: lower first-party integration imports into the same
// typed facts consumed by package realization, environment files, trust, and
// disclosure. Unknown calls remain the E0969 import diagnostic; there is no
// stringly escape hatch here.

pub fn envmodel_evaluate_integration_imports(imports: [Expr], scope: ModuleEvalScope, globals: [String: CtValue]) -> [EnvironmentIntegration] EnvModelEvalError! {
    leaves := [Expr]{}
    loop import in imports -> envmodel_collect_import_leaves(import, &leaves)
    integrations := [EnvironmentIntegration]{}
    loop import in leaves {
        name :: envmodel_qualified_call_name(import) ?? next
        if name == BUILTIN_FIND -> next
        kind :: IntegrationKind.from_call(name) ?? return Err(envmodel_bad_import_directive(expr_span(import)))
        call :: if import == {
            .Call(call) -> (args: call.args, name_span: call.name_span)
            .MethodCall(_, _, method_span, _, _, args, _, _, _, _) -> (args: args, name_span: method_span)
            else -> next
        }
        integration :: envmodel_evaluate_integration_call(name, call.args, kind, scope, globals)
        existing := EnvironmentIntegration?{None}
        loop item in integrations {
            if item.name == integration.name -> existing = Val(item)
        }
        if existing == {
            .Val(item) -> {
                if item != integration -> return Err(envmodel_error("E1335", "integration `{integration.name}` has conflicting declarations", "one environment graph cannot silently choose different SDK, host, credential, or grant facts", "merge the integration options so they agree, or keep one declaration", Val(call.name_span)))
            }
            .None -> { &integrations.push(integration) }
        }
    }
    Ok(integrations)
}

// `imports: [a, [b, c]]` flattens to its non-list leaves in source order.
fn envmodel_collect_import_leaves(expr: Expr, out: &[Expr]) Never! {
    if expr == {
        .ListLit(items, _) -> {
            loop item in items -> envmodel_collect_import_leaves(item, &out)
        }
        else -> { &out.push(expr) }
    }
}

// The secret-bearing integrations whose inputs must be named references.
fn envmodel_integration_takes_secrets(kind: IntegrationKind) -> Bool Never! {
    if kind == {
        .Certificates | .CloudCredentials | .Vault -> true
        else -> false
    }
}

fn envmodel_evaluate_integration_call(name: String, args: [CallArg], kind: IntegrationKind, scope: ModuleEvalScope, globals: [String: CtValue]) -> EnvironmentIntegration EnvModelEvalError! {
    integration := EnvironmentIntegration{kind: kind, name: name, preset: kind.as_str()}
    if kind == {
        .Android -> {
            integration.options["api"] = "34"
            integration.options["build_tools"] = "34.0.0"
            integration.options["ndk"] = "26.3"
            integration.options["license"] = "policy-required"
            integration.packages = [String]{"android-tools@nixpkgs", "android-sdk@nixpkgs"}
            &integration.tasks.push("android-sdk-check")
            &integration.providers.push("nixpkgs")
            &integration.host_checks.push("target:linux-or-android")
        }
        .Apple -> {
            integration.options["targets"] = "IOS"
            integration.options["license"] = "policy-required"
            &integration.packages.push("apple-sdk@nixpkgs")
            &integration.tasks.push("apple-sdk-check")
            &integration.providers.push("nixpkgs")
            &integration.host_checks.push("target:darwin-or-macos")
        }
        .Certificates -> {
            integration.preset = "certificate-store"
            &integration.tasks.push("certificate-store-check")
            &integration.providers.push("vault")
            &integration.grants.push("certificate.read")
        }
        .Hosts -> {
            integration.preset = "project-hosts"
            &integration.tasks.push("host-binding-check")
            &integration.providers.push("host-binding")
        }
        .CodexAgent -> {
            integration.preset = "codex"
            &integration.tasks.push("mcp-agent-check")
            &integration.providers.push("mcp")
            &integration.grants.push("mcp.read")
        }
        .Editor -> {
            integration.preset = "vscode"
            &integration.packages.push("vscode@nixpkgs")
            &integration.providers.push("nixpkgs")
        }
        .CloudCredentials -> {
            integration.preset = "cloud-credentials"
            &integration.tasks.push("credential-store-check")
            &integration.providers.push("credential-store")
            &integration.grants.push("credential.read")
        }
        .Vault -> {
            integration.preset = "vault"
            &integration.tasks.push("vault-check")
            &integration.providers.push("vault")
            &integration.grants.push("vault.read")
        }
    }
    loop index in 0..<args.len() {
        arg :: args[index]
        key :: arg.label?.name ?? "arg{index}"
        // Do not evaluate an invalid secret expression. Comptime values can
        // contain the caller's plaintext, while the only accepted secret
        // shape is a named reference already visible in the AST.
        skip_value :: envmodel_integration_takes_secrets(kind) && envmodel_integration_reference_names(arg.expr) == None
        value :: if skip_value -> CtValue.Int{value: 0} else -> envmodel_integration_arg_value(arg.expr, scope, globals)
        envmodel_lower_integration_arg(&integration, key, arg.expr, value)
    }
    Ok(integration)
}

fn envmodel_integration_arg_value(expr: Expr, scope: ModuleEvalScope, globals: [String: CtValue]) -> CtValue EnvModelEvalError! {
    if expr == {
        .Ident(name, _) -> Ok(CtValue.Str{value: name})
        .Field(base, member, _) -> Ok(CtValue.Str{value: "{envmodel_expression_name(base)}.{member}"})
        .ListLit(values, _) -> {
            items := [CtValue]{}
            loop value in values -> { &items.push(envmodel_integration_arg_value(value, scope, globals)) }
            Ok(CtValue.List{values: items})
        }
        .MapLit(pairs, _) -> {
            lowered := [CtMapEntry]{}
            loop pair in pairs {
                key_value :: envmodel_integration_arg_value(pair.key, scope, globals)
                value :: envmodel_integration_arg_value(pair.value, scope, globals)
                key :: envmodel_scalar_ct_key(key_value) ?? return Err(envmodel_error("E1335", "integration map keys must be deterministic scalar values", "host mappings and integration selections become named graph facts; arbitrary values cannot be used as stable keys", "use a string, integer, boolean, or character key", Val(expr_span(expr))))
                if !envmodel_ct_map_insert(&lowered, key, value) {
                    return Err(envmodel_error("E1335", "integration map contains a duplicate key", "one integration fact graph cannot silently choose between two values for the same host or secret name", "remove the duplicate key or merge its values", Val(expr_span(expr))))
                }
            }
            Ok(CtValue.Map{entries: lowered})
        }
        .StructLit(type_name, _, _, _, fields, _, _) -> {
            lowered := [NamedCtValue]{}
            loop field in fields -> { &lowered.push(NamedCtValue{name: field.name, value: envmodel_integration_arg_value(field.value, scope, globals)}) }
            Ok(CtValue.Struct{type_name: type_name, fields: lowered})
        }
        .EnumLit(type_name, variant, _, args, _, _) -> {
            lowered := [CtEnumArg]{}
            loop arg in args {
                if arg == {
                    .Positional(value) -> { &lowered.push(CtEnumArg{label: None, value: envmodel_integration_arg_value(value, scope, globals)}) }
                    .Named(label, value) -> { &lowered.push(CtEnumArg{label: Val(label), value: envmodel_integration_arg_value(value, scope, globals)}) }
                }
            }
            Ok(CtValue.Enum{type_name: type_name, variant: variant, args: lowered})
        }
        else -> {
            envmodel_check_build_io(expr)
            Ok(envmodel_comptime_evaluate(expr, globals, scope))
        }
    }
}

fn envmodel_lower_integration_arg(integration: &EnvironmentIntegration, key: String, expr: Expr, value: CtValue) Never! {
    display :: envmodel_integration_value_text(value)
    if integration.kind == {
        .Certificates | .CloudCredentials | .Vault -> {
            names :: envmodel_integration_reference_names(expr) ?? [String]{}
            if names.len() == 0 {
                &integration.losses.push("{key}: secret input must be a named reference; value was redacted")
            } else {
                loop name in names {
                    if !integration.secrets.contains(name) { &integration.secrets.push(name) }
                }
            }
            integration.options[key] = "<redacted-names>"
        }
        .Hosts -> {
            if value == {
                .Map(entries) -> {
                    loop entry in entries {
                        if entry.key == {
                            .Str(host) -> integration.options["host.{host}"] = envmodel_integration_value_text(entry.value)
                            else -> {}
                        }
                    }
                }
                else -> integration.options[key] = display
            }
        }
        else -> integration.options[key] = display
    }
}

// The named references a secret input spells (a name, a field path, or a
// list of them), or None when any element is not a reference.
fn envmodel_integration_reference_names(expr: Expr) -> [String]? Never! {
    unwrapped :: envmodel_unparen(expr)
    if unwrapped == {
        .Ident(name, _) -> Val([String]{name})
        .Field(_, _, _) -> {
            path :: envmodel_integration_reference_path(unwrapped) ?? return None
            Val([String]{path})
        }
        .ListLit(values, _) -> {
            names := [String]{}
            loop value in values {
                loop name in envmodel_integration_reference_names(value) ?? return None -> { &names.push(name) }
            }
            Val(names)
        }
        else -> None
    }
}

fn envmodel_integration_reference_path(expr: Expr) -> String? Never! {
    unwrapped :: envmodel_unparen(expr)
    if unwrapped == {
        .Ident(name, _) -> Val(name)
        .Field(base, member, _) -> {
            prefix :: envmodel_integration_reference_path(base) ?? return None
            Val("{prefix}.{member}")
        }
        else -> None
    }
}

fn envmodel_integration_value_text(value: CtValue) -> String Never! {
    if value == {
        .Str(text) -> text
        .Int(number) -> "{number}"
        .Bool(flag) -> "{flag}"
        .Char(character) -> "{character}"
        .Enum(_, variant, args) -> {
            if args.len() == 0 -> return envmodel_variant_leaf(variant)
            ast_comptime_value_show(value)
        }
        .List(items) -> {
            parts := [String]{}
            loop item in items -> { &parts.push(envmodel_integration_value_text(item)) }
            parts.join(",")
        }
        .Map(entries) -> {
            parts := [String]{}
            loop entry in entries -> { &parts.push("{envmodel_integration_key_text(entry.key)}={envmodel_integration_value_text(entry.value)}") }
            parts.join(",")
        }
        .Struct(_, fields) -> {
            parts := [String]{}
            loop field in fields -> { &parts.push("{field.name}={envmodel_integration_value_text(field.value)}") }
            parts.join(",")
        }
        else -> ast_comptime_value_show(value)
    }
}

fn envmodel_integration_key_text(key: CtKey) -> String Never! {
    if key == {
        .Int(number) -> "{number}"
        .Str(text) -> text
        .Bool(flag) -> "{flag}"
        .Char(character) -> "{character}"
        // D-MAP-KEY1: a composite key is value-semantic, so its text is the
        // rendering of the value it holds; one rendering rule, not a second.
        .Tuple(_) | .Struct(_, _) | .Enum(_, _) -> ast_comptime_value_show(ast_comptime_key_to_value(key))
    }
}
