// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1817
fn secret_rotation(name: String, value: CtValue, span: Span) -> SecretRotationPolicy Diagnostic! {
    if value == {
        .Str(text) -> { if text == Syntax.SECRET_NONE -> return Ok(SecretRotationPolicy.None) }
        .Struct(type_name, fields) -> {
            if type_name == "SecretMaxAge" {
                seconds := U64?{None}
                loop (field, item) in fields {
                    if field == "seconds" {
                        if item == {
                            .Int(amount) -> { if amount > 0 { seconds = U64.try_from(amount).ok() } }
                            else -> {}
                        }
                        break
                    }
                }
                amount :: seconds ?? return Err(secret_decl_error("secret `{name}` rotation max age must be positive", span))
                return Ok(SecretRotationPolicy.MaxAge{seconds: amount})
            }
        }
        else -> {}
    }
    Err(secret_decl_error("secret `{name}` field `{Syntax.SECRET_META_FIELD_ROTATION}` must be `{Syntax.SECRET_NONE}` or `{Syntax.SECRET_ROTATION_MAX_AGE}`(…)", span))
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1852
fn secret_default(name: String, value: CtValue, span: Span) -> SecretDefault Diagnostic! {
    fields := [(String, CtValue)]{}
    if value == {
        .Str(text) -> {
            if text == Syntax.SECRET_NONE -> return Ok(SecretDefault.None)
            return Err(secret_decl_error("secret `{name}` field `default` must be `none` or a profile map", span))
        }
        .Struct(_, entries) -> fields = entries
        .Map(entries) -> {
            keys := entries.keys().collect()
            &keys.sort()
            loop key in keys {
                profile :: if key == {
                    .Str(text) -> text
                    else -> { return Err(secret_decl_error("secret `{name}` default profiles must be named strings", span)) }
                }
                &fields.push((profile, entries[key]))
            }
        }
        else -> { return Err(secret_decl_error("secret `{name}` field `default` must be `none` or a profile map", span)) }
    }
    result := [String: String]{}
    loop (profile, item) in fields {
        if !valid_env_name(profile) -> return Err(secret_decl_error("secret `{name}` default uses invalid profile `{profile}`", span))
        text :: if item == {
            .Str(text) -> text
            else -> { return Err(secret_decl_error("secret `{name}` default values must be strings", span)) }
        }
        if result.has_key(profile) -> return Err(secret_decl_error("secret `{name}` repeats default profile `{profile}`", span))
        result[profile] = text
    }
    Ok(SecretDefault.PerProfile(result))
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1909
fn secret_generator(name: String, value: CtValue, span: Span) -> SecretGenerator Diagnostic! {
    if value == {
        .Str(text) -> { if text == Syntax.SECRET_NONE -> return Ok(SecretGenerator.None) }
        .Struct(type_name, fields) -> {
            if type_name == "SecretRandom" {
                length := U64?{None}
                loop (field, item) in fields {
                    if field == Syntax.SECRET_GENERATOR_FIELD_LENGTH {
                        if item == {
                            .Int(amount) -> { if amount > 0 { length = U64.try_from(amount).ok() } }
                            else -> {}
                        }
                        break
                    }
                }
                amount :: length ?? return Err(secret_decl_error("secret `{name}` random generator length must be positive", span))
                return Ok(SecretGenerator.Random{length: amount})
            }
        }
        else -> {}
    }
    Err(secret_decl_error("secret `{name}` field `{Syntax.SECRET_META_FIELD_GENERATE}` must be `{Syntax.SECRET_NONE}` or `{Syntax.SECRET_GENERATOR_RANDOM}`({Syntax.SECRET_GENERATOR_FIELD_LENGTH}: …)", span))
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1949
fn secret_string_list(value: CtValue, scope: String, span: Span) -> [String] Diagnostic! {
    values :: if value == {
        .List(items) -> items
        else -> { return Err(secret_decl_error("{scope} must be a list of strings", span)) }
    }
    out := [String]{}
    loop item in values {
        if item == {
            .Str(text) -> &out.push(text)
            else -> { return Err(secret_decl_error("{scope} must contain only strings", span)) }
        }
    }
    Ok(out)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:1972
fn secret_template_value(value: Expr, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue]) -> String Diagnostic! {
    if value.without_parens() == {
        .Str(parts, _) -> {
            template := String.new()
            loop part in parts {
                if part == {
                    .Lit(text) -> &template.push_str(text)
                    .Interp(expression, _) -> {
                        name :: secret_reference_name(expression) ?? return Err(secret_decl_error("compose template interpolations must name secrets", expression.span()))
                        &template.push('{')
                        &template.push_str(name)
                        &template.push('}')
                    }
                }
            }
            Ok(template)
        }
        .Ident(name, _) -> Ok(name)
        .Field(_, _, _) -> Ok(expression_name(value))
        else -> {
            lowered :: secret_eval_value(value, base_dir, funcs, globals)
            if lowered == {
                .Str(text) -> Ok(text)
                else -> Err(secret_decl_error("compose `template` must be a string", value.span()))
            }
        }
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2011
fn secret_reference_name(value: Expr) -> String? {
    if value.without_parens() == {
        .Ident(_, _) | .Field(_, _, _) -> Val(expression_name(value))
        else -> None
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2018
fn validate_secret_template(name: String, template: String, from: [String], span: Span) -> Unit Diagnostic! {
    if template.is_empty() || template.chars().any(char -> char.is_control()) -> return Err(secret_decl_error("secret `{name}` compose template must be non-empty text", span))
    placeholders := [String: Bool]{}
    chars := template.chars()
    loop {
        character :: &chars.next() ?? break
        if character == {
            '{' -> {
                placeholder := String.new()
                closed := false
                loop {
                    following :: &chars.next() ?? break
                    if following == '}' { closed = true; break }
                    if following == '{' || following.is_whitespace() -> return Err(secret_decl_error("secret `{name}` compose template has an invalid placeholder", span))
                    &placeholder.push(following)
                }
                if !closed || !valid_env_name(placeholder) -> return Err(secret_decl_error("secret `{name}` compose template has an invalid placeholder", span))
                placeholders[placeholder] = true
            }
            '}' -> { return Err(secret_decl_error("secret `{name}` compose template has an unmatched brace", span)) }
            else -> {}
        }
    }
    inputs := [String: Bool]{}
    loop input in from { inputs[input] = true }
    if placeholders != inputs -> return Err(secret_decl_error("secret `{name}` compose template placeholders must match `from`", span))
    Ok(())
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2077
// Unknown inputs are allowed here; activation checks the encrypted store.
pub fn validate_secret_graph(specs: [SecretSpec], span: Span) -> Unit Diagnostic! {
    composed := [String: [String]]{}
    loop spec in specs {
        if spec.declaration == {
            .Compose(_, from) -> composed[spec.name] = from
            .Stored -> {}
        }
    }
    states := [String: U8]{}
    names := composed.keys().collect()
    &names.sort()
    loop name in names { secret_graph_visit(name, composed, &states, span) }
    Ok(())
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2098
fn secret_graph_visit(name: String, composed: [String: [String]], states: &[String: U8], span: Span) -> Unit Diagnostic! {
    if states.get(name) == {
        .Val(1) -> { return Err(secret_decl_error("secret composition cycle includes `{name}`", span)) }
        .Val(2) -> { return Ok(()) }
        else -> {}
    }
    states[name] = 1
    if composed.get(name) == {
        .Val(inputs) -> {
            loop input in inputs {
                if composed.has_key(input) { secret_graph_visit(input, composed, &states, span) }
            }
        }
        .None -> {}
    }
    states[name] = 2
    Ok(())
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2126
fn secret_eval_value(value: Expr, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue]) -> CtValue Diagnostic! {
    if value.without_parens() == {
        .Ident(name, _) -> Ok(globals.get(name) ?? CtValue.Str(name))
        .Field(_, _, _) -> Ok(CtValue.Str(expression_name(value)))
        .ListLit(values, _) -> {
            lowered := [CtValue]{}
            loop item in values { &lowered.push(secret_eval_value(item, base_dir, funcs, globals)) }
            Ok(CtValue.List(lowered))
        }
        .MapLit(values, _) -> {
            lowered := [CtKey: CtValue]{}
            loop (key_expr, value_expr) in values {
                key :: CtKey.from_value(secret_eval_value(key_expr, base_dir, funcs, globals)) ?? return Err(secret_decl_error("secret map keys must be scalar values", key_expr.span()))
                lowered_value :: secret_eval_value(value_expr, base_dir, funcs, globals)
                if lowered.has_key(key) -> return Err(secret_decl_error("secret map contains a duplicate key", value_expr.span()))
                lowered[key] = lowered_value
            }
            Ok(CtValue.Map(lowered))
        }
        .StructLit(type_name, _, _, _, fields, _, _) -> {
            lowered := [(String, CtValue)]{}
            loop (name, _, item) in fields { &lowered.push((name, secret_eval_value(item, base_dir, funcs, globals))) }
            Ok(CtValue.Struct{type_name: type_name, fields: lowered})
        }
        .UnitLit(raw, int, suffix, _) -> {
            amount :: int ?? return Err(secret_decl_error("secret duration policies need an integer unit literal", value.span()))
            Ok(CtValue.Struct{type_name: suffix, fields: [("value", CtValue.Int(amount))]})
        }
        .Call(call) -> {
            if call.name == Syntax.SECRET_ROTATION_MAX_AGE {
                if call.args.len() != 1 || call.args[0].label != None -> return Err(secret_decl_error("`max_age` needs one duration argument", call.name_span))
                duration :: secret_eval_value(call.args[0].expr, base_dir, funcs, globals)
                seconds :: secret_duration_seconds(duration) ?? return Err(secret_decl_error("`max_age` needs a positive duration", call.args[0].expr.span()))
                return Ok(CtValue.Struct{type_name: "SecretMaxAge", fields: [("seconds", CtValue.Int(seconds))]})
            }
            if call.name == Syntax.SECRET_GENERATOR_RANDOM {
                length := I64?{None}
                loop argument in call.args {
                    label :: argument.label.map(pair -> pair.0)
                    if label != Val(Syntax.SECRET_GENERATOR_FIELD_LENGTH) -> return Err(secret_decl_error("`random` needs a labeled `length` argument", argument.span))
                    if length != None -> return Err(secret_decl_error("`random` repeats `length`", argument.span))
                    lowered :: secret_eval_value(argument.expr, base_dir, funcs, globals)
                    if lowered == {
                        .Int(amount) -> length = Val(amount)
                        else -> { return Err(secret_decl_error("`random` length must be an integer", argument.expr.span())) }
                    }
                }
                amount :: length.filter(item -> item > 0) ?? return Err(secret_decl_error("`random` length must be positive", call.name_span))
                return Ok(CtValue.Struct{type_name: "SecretRandom", fields: [(Syntax.SECRET_GENERATOR_FIELD_LENGTH, CtValue.Int(amount))]})
            }
            Comptime.evaluate(value, funcs, [String: Bool]{}, base_dir, globals)
        }
        .Paren(inner, _) -> secret_eval_value(inner, base_dir, funcs, globals)
        else -> Comptime.evaluate(value, funcs, [String: Bool]{}, base_dir, globals)
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2254
fn secret_duration_seconds(value: CtValue) -> I64? {
    if value == {
        .Struct(type_name, fields) -> {
            amount := I64?{None}
            loop (field, item) in fields {
                if field == "value" {
                    if item == {
                        .Int(number) -> { if number > 0 { amount = Val(number) } }
                        else -> {}
                    }
                    if amount != None -> break
                }
            }
            number :: amount ?? return None
            unit :: type_name.rsplit('.').next() ?? type_name
            Val(if unit == {
                "d" | "day" | "days" -> number.saturating_mul(86400)
                "h" | "hour" | "hours" -> number.saturating_mul(3600)
                "m" | "min" | "minute" | "minutes" -> number.saturating_mul(60)
                "s" | "sec" | "second" | "seconds" -> number
                else -> { return None }
            })
        }
        else -> None
    }
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2280
// Canonical env role body, including dev-supervised services.
fn evaluate_env_role(lit: EnvLit, src: String, base_dir: OSPath, funcs: [String: Func], globals: [String: CtValue], source: String) -> (EnvCapture, [DevServicePlan]) Diagnostic! {
    capture :: evaluate_env_fields(lit.fields, src, base_dir, funcs, globals, source)
    services := [DevServicePlan]{}
    loop service in lit.services { &services.push(evaluate_dev_service(service, base_dir, funcs, globals)) }
    Ok((capture, services))
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2300
pub struct ExtractedPackages {
    pub packages: [Merge.Pkg]
    pub adapters: [AdapterPlan]
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2304
pub fn extract_packages(value: Expr, src: String) -> ExtractedPackages Diagnostic! {
    span :: if value == {
        .ListLit(_, span) -> span
        else -> { return Err(packages_not_a_list(value.span())) }
    }
    text :: src[span.start..<span.end]
    body :: text.strip_prefix('[').and_then(item -> item.strip_suffix(']')) ?? text
    out := ExtractedPackages{packages: [], adapters: []}
    plain := [String]{}
    loop piece in split_top_level(body) {
        item := piece.trim() // #4303
        if item.is_empty() -> next
        if item.starts_with(Syntax.PKG_ADAPT) { &out.adapters.push(parse_adapter(item)) }
        else { &plain.push(item) }
    }
    out.packages = Merge.parse_package_list(plain.join(", "))
    Ok(out)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2330
fn split_top_level(body: String) -> [String] {
    out := [String]{}
    depth := 0
    start := 0
    in_string := false
    escape := false
    loop (index, character) in body.char_indices() {
        if in_string {
            escape = character == '\\' && !escape
            if character == '"' && !escape { in_string = false }
            else if character != '\\' { escape = false }
            next
        }
        if character == {
            '"' -> in_string = true
            '(' | '[' | '{' -> depth += 1
            ')' | ']' | '}' -> depth -= 1
            ',' -> {
                if depth == 0 {
                    &out.push(body[start..<index])
                    start = index + 1
                }
            }
            else -> {}
        }
    }
    if start < body.len() { &out.push(body[start..<body.len()]) }
    out
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2363
fn parse_adapter(item: String) -> AdapterPlan Diagnostic! {
    args :: call_args(item, Syntax.PKG_ADAPT) ?? return Err(adapter_shape(item))
    validate_fields(args, [Syntax.ADAPTER_FIELD_NAME, Syntax.ADAPTER_FIELD_SOURCE, Syntax.ADAPTER_FIELD_DEPS, Syntax.ADAPTER_FIELD_RECIPE])
    name :: named_string(args, Syntax.ADAPTER_FIELD_NAME) ?? return Err(adapter_shape(item))
    written_source :: named_raw(args, Syntax.ADAPTER_FIELD_SOURCE) ?? return Err(adapter_shape(item))
    trimmed := written_source.trim() // #4303
    source :: unquote(trimmed) ?? written_source
    classify_provider_ref(source) ?? return Err(adapter_shape(item))
    deps := [Merge.Pkg]{}
    if named_raw(args, Syntax.ADAPTER_FIELD_DEPS) == {
        .Val(raw) -> {
            trimmed := raw.trim() // #4303
            body :: trimmed.strip_prefix('[').and_then(text -> text.strip_suffix(']')) ?? trimmed
            deps = Merge.parse_package_list(body)
        }
        .None -> {}
    }
    recipe_raw :: named_raw(args, Syntax.ADAPTER_FIELD_RECIPE) ?? return Err(adapter_shape(item))
    recipe :: parse_recipe(recipe_raw)
    Ok(AdapterPlan{name: name, source: source, deps: deps, recipe: recipe})
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2400
fn parse_recipe(input: String) -> AdapterRecipe Diagnostic! {
    raw := input.trim() // #4303
    if call_args(raw, Syntax.RECIPE_BUILD) == {
        .Val(args) -> {
            validate_fields(args, [Syntax.RECIPE_FIELD_STEPS])
            return Ok(AdapterRecipe.Build(BuildRecipe{steps: parse_build_steps(args)}))
        }
        .None -> {}
    }
    if call_args(raw, Syntax.RECIPE_COPY) == {
        .Val(args) -> {
            trimmed := args.trim() // #4303
            if trimmed.is_empty() -> return Ok(AdapterRecipe.Copy)
            return Err(adapter_shape(raw))
        }
        .None -> {}
    }
    if call_args(raw, Syntax.RECIPE_PREBUILT) == {
        .Val(args) -> {
            trimmed := args.trim() // #4303
            if trimmed.is_empty() -> return Err(adapter_shape(raw))
            validate_fields(args, [Syntax.RECIPE_FIELD_BIN, Syntax.RECIPE_FIELD_AS, Syntax.RECIPE_FIELD_AS_NAME])
            bin :: named_string(args, Syntax.RECIPE_FIELD_BIN) ?? return Err(adapter_shape(raw))
            as_name :: named_string(args, Syntax.RECIPE_FIELD_AS) ?? named_string(args, Syntax.RECIPE_FIELD_AS_NAME) ?? OSPath.new(bin).file_name().and_then(name -> name.to_str()).unwrap_or(bin)
            return Ok(AdapterRecipe.Prebuilt{bin: bin, as_name: as_name})
        }
        .None -> {}
    }
    Err(adapter_shape(raw))
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2442
fn parse_build_steps(args: String) -> [BuildStep] Diagnostic! {
    raw :: named_field(args, Syntax.RECIPE_FIELD_STEPS) ?? return Err(adapter_shape(args))
    trimmed := raw.trim() // #4303
    body :: trimmed.strip_prefix('[').and_then(value -> value.strip_suffix(']')) ?? return Err(adapter_shape(args))
    steps := [BuildStep]{}
    loop piece in split_top_level(body) {
        item := piece.trim() // #4303
        if item.is_empty() -> next
        &steps.push(parse_build_step(item))
    }
    if steps.is_empty() -> return Err(adapter_shape(args))
    Ok(steps)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2463
fn parse_build_step(raw: String) -> BuildStep Diagnostic! {
    if call_args(raw, Syntax.RECIPE_STEP_FETCH) == {
        .Val(args) -> {
            validate_fields(args, [Syntax.RECIPE_STEP_FIELD_URL, Syntax.RECIPE_STEP_FIELD_SHA256])
            return Ok(BuildStep.Fetch{url: required_field_string(args, Syntax.RECIPE_STEP_FIELD_URL), sha256: required_field_string(args, Syntax.RECIPE_STEP_FIELD_SHA256)})
        }
        .None -> {}
    }
    if call_args(raw, Syntax.RECIPE_STEP_EXEC) == {
        .Val(args) -> {
            validate_fields(args, [Syntax.RECIPE_STEP_FIELD_TOOL, Syntax.RECIPE_STEP_FIELD_ARGS])
            return Ok(BuildStep.Exec{tool: required_field_string(args, Syntax.RECIPE_STEP_FIELD_TOOL), args: required_field_strings(args, Syntax.RECIPE_STEP_FIELD_ARGS)})
        }
        .None -> {}
    }
    if call_args(raw, Syntax.RECIPE_STEP_INSTALL) == {
        .Val(args) -> {
            validate_fields(args, [Syntax.RECIPE_STEP_FIELD_SRC, Syntax.RECIPE_STEP_FIELD_DEST])
            return Ok(BuildStep.Install{src: required_field_string(args, Syntax.RECIPE_STEP_FIELD_SRC), dest: required_field_string(args, Syntax.RECIPE_STEP_FIELD_DEST)})
        }
        .None -> {}
    }
    if call_args(raw, Syntax.RECIPE_STEP_INSTALL_TREE) == {
        .Val(args) -> {
            validate_fields(args, [Syntax.RECIPE_STEP_FIELD_SRC, Syntax.RECIPE_STEP_FIELD_DEST])
            return Ok(BuildStep.InstallTree{src: required_field_string(args, Syntax.RECIPE_STEP_FIELD_SRC), dest: required_field_string(args, Syntax.RECIPE_STEP_FIELD_DEST)})
        }
        .None -> {}
    }
    Err(adapter_shape(raw))
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2521
fn named_field(args: String, key: String) -> String? {
    fields :: named_fields(args) ?? return None
    found := String?{None}
    loop (name, value) in fields {
        if name == key {
            if found != None -> return None
            found = Val(value)
        }
    }
    found
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2535
fn named_fields(args: String) -> [(String, String)]? {
    fields := [(String, String)]{}
    loop piece in split_top_level(args) {
        item := piece.trim() // #4303
        if item.is_empty() -> next
        (raw_name, raw_value) :: item.split_once(':') ?? return None
        name := raw_name.trim() // #4303
        value := raw_value.trim() // #4303
        if name.is_empty() || value.is_empty() -> return None
        &fields.push((name, value))
    }
    Val(fields)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2548
fn validate_fields(args: String, allowed: [String]) -> Unit Diagnostic! {
    fields :: named_fields(args) ?? return Err(adapter_shape(args))
    seen := [String: Bool]{}
    loop (name, _) in fields {
        if !allowed.contains(name) || seen.has_key(name) -> return Err(adapter_shape(args))
        seen[name] = true
    }
    Ok(())
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2560
fn required_field_string(args: String, key: String) -> String Diagnostic! {
    raw :: named_field(args, key) ?? return Err(adapter_shape(args))
    value := raw.trim() // #4303
    Ok(unquote(value) ?? return Err(adapter_shape(args)))
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2565
fn required_field_strings(args: String, key: String) -> [String] Diagnostic! {
    value :: named_field(args, key) ?? return Err(adapter_shape(args))
    trimmed := value.trim() // #4303
    body :: trimmed.strip_prefix('[').and_then(item -> item.strip_suffix(']')) ?? return Err(adapter_shape(args))
    out := [String]{}
    loop piece in split_top_level(body) {
        item := piece.trim() // #4303
        &out.push(unquote(item) ?? return Err(adapter_shape(args)))
    }
    Ok(out)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2578
fn call_args(input: String, prefix: String) -> String? {
    raw := input.trim() // #4303
    remainder :: raw.strip_prefix(prefix) ?? return None
    rest := remainder.trim_start() // #4303
    body :: rest.strip_prefix('(') ?? return None
    body.strip_suffix(')')
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2584
fn named_raw(args: String, key: String) -> String? {
    needle :: "{key}:"
    loop piece in split_top_level(args) {
        item := piece.trim() // #4303
        if item.strip_prefix(needle) == {
            .Val(rest) -> {
                trimmed := rest.trim() // #4303
                value := trimmed.trim_end_matches(',') // #4303
