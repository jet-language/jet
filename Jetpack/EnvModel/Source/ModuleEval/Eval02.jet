// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2600
fn unquote(raw: String) -> String? {
    text :: raw.strip_prefix('"').and_then(item -> item.strip_suffix('"')) ?? return None
    out := String.new()
    chars := text.chars().peekable()
    loop {
        character :: &chars.next() ?? break
        if character == {
            '\\' -> {
                escaped :: &chars.next() ?? return None
                decoded :: Syntax.ESCAPES.iter().find(pair -> pair.0 == escaped) ?? return None
                &out.push(decoded.1)
            }
            '{' -> {
                if chars.peek() == Val('{') { _ :: &chars.next() }
                &out.push('{')
            }
            '}' -> {
                if chars.peek() == Val('}') { _ :: &chars.next() }
                &out.push('}')
            }
            else -> &out.push(character)
        }
    }
    Val(out)
}

