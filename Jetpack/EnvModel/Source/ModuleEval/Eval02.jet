// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2639
// Group every evaluated module contribution by namespace and path before merging.
pub fn merge_all(modules: [EvaluatedModule]) -> [(Namespace, String): MergedEntry] MergeError! {
    by_key := [(Namespace, String): [EntryContribution]]{}
    loop module in modules {
        loop (key, entry) in module.entries {
            if !by_key.has_key(key) { by_key[key] = [] }
            &by_key[key].push(entry)
        }
    }
    out := [(Namespace, String): MergedEntry]{}
    loop (key, contributions) in by_key { out[key] = Merge.merge_entry(contributions) }
    Ok(out)
}

// Rust: crates/jet-env-model/src/ModuleEval/Eval.rs:2657
pub fn pkg_ref(pkg: Merge.Pkg) -> String {
    if pkg.source.is_empty() && pkg.name.contains(Syntax.REF_PROVIDER_AT) -> return pkg.name
    source :: if pkg.source.is_empty() -> Syntax.DEFAULT_SOURCE else -> pkg.source
    "{pkg.name}{Syntax.REF_PROVIDER_AT}{source}"
}
