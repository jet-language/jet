// Typed environment facts shared by the evaluator and the Jetpack runtime.
//
// These are deliberately small closed records. The evaluator turns Jet values
// into these facts; Jetpack consumes them without reparsing source or
// inventing a second policy language. This file holds the first-party
// integration vocabulary.
use {
    jet_foundation.[Expr]
    jetpack_foundation.[
        ENV_INTEGRATION_ANDROID, ENV_INTEGRATION_APPLE, ENV_INTEGRATION_CERTIFICATES,
        ENV_INTEGRATION_CLOUD, ENV_INTEGRATION_CODEX, ENV_INTEGRATION_EDITOR, ENV_INTEGRATION_HOSTS,
        ENV_INTEGRATION_VAULT,
    ]
    jet_pkg_model.[pkg_ascii_lower]
}

// The fully-qualified name of a first-party integration call. The parser
// represents `env.platform.android(...)` as a method call on the field path
// `env.platform`, while bare calls are `Expr.Call`. Both spellings are the same
// integration surface and share one lowering path.
envmodel_qualified_call_name: fn(expr: Expr) -> String? Never! {
    if expr == {
        .Call(call, _) -> Val(call.name)
        .MethodCall(receiver, method, _, _, _, _, _) -> {
            path: envmodel_expression_path(receiver) ?? return None
            Val("{path}.{method}")
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

envmodel_expression_path: fn(expr: Expr) -> String? Never! {
    if expr == {
        .Ident(name, _, _) -> Val(name)
        .Field(base, member, _, _) -> {
            path: envmodel_expression_path(base) ?? return None
            Val("{path}.{member}")
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// The closed first-party integration vocabulary. An
// integration is a typed projection into ordinary environment facts, not a
// second package resolver, lock, effect system, or activation engine.
#Comparable
IntegrationKind: enum {
    Android
    Apple
    Certificates
    Hosts
    CodexAgent
    Editor
    CloudCredentials
    Vault

    as_str: fn(self) -> String Never! {
        if self == {
            .Android -> "android"
            .Apple -> "apple"
            .Certificates -> "certificates"
            .Hosts -> "hosts"
            .CodexAgent -> "codex-agent"
            .Editor -> "editor"
            .CloudCredentials -> "cloud-credentials"
            .Vault -> "vault"
        }
    }

    from_call: fn(name: String) -> IntegrationKind? Never! {
        if name == {
            ENV_INTEGRATION_ANDROID -> Val(IntegrationKind.Android)
            ENV_INTEGRATION_APPLE -> Val(IntegrationKind.Apple)
            ENV_INTEGRATION_CERTIFICATES -> Val(IntegrationKind.Certificates)
            ENV_INTEGRATION_HOSTS -> Val(IntegrationKind.Hosts)
            ENV_INTEGRATION_CODEX -> Val(IntegrationKind.CodexAgent)
            ENV_INTEGRATION_EDITOR -> Val(IntegrationKind.Editor)
            ENV_INTEGRATION_CLOUD -> Val(IntegrationKind.CloudCredentials)
            ENV_INTEGRATION_VAULT -> Val(IntegrationKind.Vault)
            else -> None
        }
    }

    // The executable task contract a secret-bearing integration must satisfy:
    // its one task name, provider authority, and grant.
    task_contract: fn(self) -> IntegrationTaskContract? Never! {
        if self == {
            .CloudCredentials -> Val(IntegrationTaskContract{job: "credential-store-check", provider: "credential-store", grant: "credential.read"})
            .Vault -> Val(IntegrationTaskContract{job: "vault-check", provider: "vault", grant: "vault.read"})
            .Android | .Apple | .Certificates | .Hosts | .CodexAgent | .Editor -> None
        }
    }

    // Whether this integration can realize on `target` (already lowercased).
    supports_target: fn(self, target: String) -> Bool Never! {
        if self == {
            .Android -> target.contains("linux") || target.contains("android")
            .Apple -> target.contains("darwin") || target.contains("macos") || target.contains("ios")
            .Certificates | .Hosts | .CodexAgent | .Editor | .CloudCredentials | .Vault -> true
        }
    }
}

IntegrationTaskContract: struct {
    job: String
    provider: String
    grant: String
}

// One lowered integration import. Secret-bearing inputs are represented by
// names only; values never enter this record, fingerprints, dossiers, image
// layers, or logs.
EnvironmentIntegration: struct {
    kind: IntegrationKind{IntegrationKind.Android}
    name: String{""}
    preset: String{""}
    options: [String: String]{[String: String]{}}
    packages: [String]{[String]{}}
    files: [ManagedFile]{[ManagedFile]{}}
    // Existing lifecycle/job facts selected by the preset. These are names
    // only; activation still belongs to the ordinary environment lifecycle.
    tasks: [String]{[String]{}}
    // Provider authorities used by package and host facts. This is metadata,
    // not a second resolver.
    providers: [String]{[String]{}}
    host_checks: [String]{[String]{}}
    secrets: [String]{[String]{}}
    grants: [String]{[String]{}}
    losses: [String]{[String]{}}

    fingerprint: fn(self) -> String Never! {
        lines := [String]{"jet-environment-integration-v1\nkind={self.kind.as_str()}\nname={self.name}\npreset={self.preset}\n"}
        loop key in envmodel_sorted_keys(self.options) -> lines.push("option={key}={self.options[key]}\n")
        envmodel_push_labeled(lines, "package", self.packages)
        loop file in self.files -> lines.push("file={file.fingerprint()}\n")
        envmodel_push_labeled(lines, "host-check", self.host_checks)
        envmodel_push_labeled(lines, "task", self.tasks)
        envmodel_push_labeled(lines, "provider", self.providers)
        envmodel_push_labeled(lines, "secret-name", self.secrets)
        envmodel_push_labeled(lines, "grant", self.grants)
        envmodel_push_labeled(lines, "loss", self.losses)
        lines.join("")
    }

    // Validate a target at the host/realization boundary. Graph evaluation
    // keeps cross-platform modules composable, while an activation path can
    // fail with the exact unsupported-host fact instead of silently omitting
    // an SDK.
    validate_target: fn(self, target: String) EnvironmentFactError! {
        lowered: pkg_ascii_lower(target)
        if !self.kind.supports_target(lowered) {
            return Err(EnvironmentFactError.new("{self.kind.as_str()} integration `{self.name}` is not supported on target `{lowered}`"))
        }
    }
}

// The non-package portion of integration lowering. These facts stay in the
// ordinary environment plan so trust, inspection, and activation all consume
// one projection instead of treating integrations as report-only annotations.
IntegrationTaskFact: struct {
    name: String
    integration: IntegrationKind
    packages: [String]{[String]{}}
    secrets: [String]{[String]{}}
    providers: [String]{[String]{}}
    host_checks: [String]{[String]{}}
    grants: [String]{[String]{}}

    has_empty_field: fn(self) -> Bool Never! {
        self.name.trim() == "" || envmodel_any_blank(self.providers) || envmodel_any_blank(self.secrets) || envmodel_any_blank(self.host_checks) || envmodel_any_blank(self.grants)
    }
}

IntegrationFactProjection: struct {
    tasks: [String]{[String]{}}
    // Typed task contracts. `tasks` is only the stable disclosure projection;
    // realization consumes these records and their ordinary package,
    // provider, host, and grant facts.
    task_facts: [IntegrationTaskFact]{[IntegrationTaskFact]{}}
    providers: [String]{[String]{}}
    host_checks: [String]{[String]{}}
    grants: [String]{[String]{}}
    losses: [String]{[String]{}}

    fingerprint: fn(self) -> String Never! {
        lines := [String]{}
        loop fact in self.task_facts {
            lines.push("task-fact={fact.integration.as_str()}\t{fact.name}\t{fact.packages.join(",")}\t{fact.secrets.join(",")}\t{fact.providers.join(",")}\t{fact.host_checks.join(",")}\t{fact.grants.join(",")}\n")
        }
        envmodel_push_labeled(lines, "task", self.tasks)
        envmodel_push_labeled(lines, "provider", self.providers)
        envmodel_push_labeled(lines, "host-check", self.host_checks)
        envmodel_push_labeled(lines, "grant", self.grants)
        envmodel_push_labeled(lines, "loss", self.losses)
        lines.join("")
    }

    validate: fn(self) EnvironmentFactError! {
        if self.losses.len() > 0 {
            return Err(EnvironmentFactError.new("integration lowering lost declared facts: {self.losses.join("; ")}"))
        }
        loop fact in self.task_facts {
            if fact.has_empty_field() -> return Err(EnvironmentFactError.new("integration task facts contain an empty executable field"))
        }
        loop fact in self.task_facts {
            contract: fact.integration.task_contract() ?? next
            kind: fact.integration.as_str()
            if fact.name != contract.job {
                return Err(EnvironmentFactError.new("{kind} integration task must be `{contract.job}`"))
            }
            if !self.tasks.contains(contract.job) {
                return Err(EnvironmentFactError.new("integration task `{contract.job}` is not disclosed by its fact projection"))
            }
            if !fact.providers.contains(contract.provider) || !self.providers.contains(contract.provider) {
                return Err(EnvironmentFactError.new("{kind} integration task is missing provider `{contract.provider}`"))
            }
            if !fact.grants.contains(contract.grant) || !self.grants.contains(contract.grant) {
                return Err(EnvironmentFactError.new("{kind} integration task is missing grant `{contract.grant}`"))
            }
            if fact.secrets.len() == 0 {
                return Err(EnvironmentFactError.new("{kind} integration task needs at least one named secret reference"))
            }
        }
    }
}
