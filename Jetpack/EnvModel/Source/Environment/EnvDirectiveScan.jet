// The tolerant scanner for the Phase-1 `pkg.*` directive surface of `env.jet`
// (`pkg.source(...)`, `pkg.packages([...])`, `pkg.prompt(...)`). Jetpack's
// EnvFile parses and edits that surface with these helpers; `jet` uses
// env_file_declares_environment to see whether a project declares an
// environment without evaluating or realizing it.
use jetpack_foundation.[PACK_DIRECTIVE_PACKAGES, PACK_DIRECTIVE_SOURCE]

// Whether directive text declares an environment: a default or named source,
// or at least one package (EnvFile.parse reads the same calls).
env_file_declares_environment: fn(text: String) -> Bool Never! {
    loop call in env_file_all_call_args(text, PACK_DIRECTIVE_SOURCE) {
        if env_file_quoted_strings(call).len() > 0 -> return true
    }
    env_file_list_arg(text, PACK_DIRECTIVE_PACKAGES).len() > 0
}

// `name("...")`: the first quoted string argument.
env_file_string_arg: fn(text: String, name: String) -> String? Never! {
    inside: env_file_call_args(text, name) ?? return None
    strings: env_file_quoted_strings(inside)
    if strings.len() == 0 -> return None
    Val(strings[0])
}

// `name([...])`: every quoted string in the list.
env_file_list_arg: fn(text: String, name: String) -> [String] Never! {
    inside: env_file_call_args(text, name) ?? return [String]{}
    env_file_quoted_strings(inside)
}

// The inner arguments of every `name(...)` call in `text`, in order.
env_file_all_call_args: fn(text: String, name: String) -> [String] Never! {
    out := [String]{}
    rest := text
    loop {
        parts: rest.split_once(name) ?? break
        if env_file_call_args_after(parts.after) == .Val(args) -> out.push(args)
        rest = parts.after
    }
    out
}

// The text between the matched `(` and its closing `)` of the first
// `name(...)` call.
env_file_call_args: fn(text: String, name: String) -> String? Never! {
    parts: text.split_once(name) ?? return None
    env_file_call_args_after(parts.after)
}

env_file_call_args_after: fn(after: String) -> String? Never! {
    rest: after.trim_start()
    if !rest.starts_with("(") -> return None
    scalars := [String]{}
    loop scalar in rest.chars() -> scalars.push("{scalar}")
    depth := 1
    out := [String]{}
    in_quote := false
    escaped := false
    loop index in 1..<scalars.len() {
        current: scalars[index]
        if in_quote {
            out.push(current)
            if escaped {
                escaped = false
            } else if current == "\\" {
                escaped = true
            } else if current == "\"" {
                in_quote = false
            }
            next
        }
        if current == {
            "\"" -> {
                in_quote = true
                out.push(current)
            }
            "(" -> {
                depth += 1
                out.push(current)
            }
            ")" -> {
                depth -= 1
                if depth == 0 -> return Val(out.join(""))
                out.push(current)
            }
            else -> out.push(current)
        }
    }
    None
}

// Every `"..."` string literal in a fragment, in order, with Jet string
// escapes and doubled braces decoded.
env_file_quoted_strings: fn(fragment: String) -> [String] Never! {
    scalars := [String]{}
    loop scalar in fragment.chars() -> scalars.push("{scalar}")
    out := [String]{}
    index := 0
    loop index < scalars.len() {
        if scalars[index] != "\"" {
            index += 1
            next
        }
        index += 1
        value := [String]{}
        loop index < scalars.len() {
            current: scalars[index]
            index += 1
            if current == "\"" -> break
            if current == "\\" {
                if index >= scalars.len() {
                    value.push("\\")
                    break
                }
                escaped: scalars[index]
                index += 1
                if escaped == {
                    "n" -> value.push("\n")
                    "t" -> value.push("\t")
                    "\"" -> value.push("\"")
                    "\\" -> value.push("\\")
                    else -> {
                        value.push("\\")
                        value.push(escaped)
                    }
                }
                next
            }
            doubled: (current == "{{" || current == "}}") && index < scalars.len() && scalars[index] == current
            if doubled -> index += 1
            value.push(current)
        }
        out.push(value.join(""))
    }
    out
}
