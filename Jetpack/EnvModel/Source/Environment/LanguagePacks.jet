// Language packs the catalog of language toolchains and
// the typed `languages` selections that expand into ordinary package refs.
use {
    jet_pkg_model.[pkg_ascii_lower, pkg_bytes_is_word, pkg_host_key, pkg_sha256_hex]
    jetpack_foundation.[REF_CHANNEL_MARKER, REF_PROVIDER_AT]
}

// The tier-one host platforms every built-in pack supports.
ENVMODEL_LANGUAGE_PLATFORMS: [String]{"aarch64-macos", "aarch64-linux", "x86_64-macos", "x86_64-linux"}

LanguagePack: struct {
    name: String{""}
    packages: [String]{[String]{}}
    venv_packages: [String]{[String]{}}
    variables: [String: String]{[String: String]{}}
    commands: [String: String]{[String: String]{}}
    // Execution authority for the pack. `native` means the pack is selected
    // for the host platform recorded in `platforms`.
    host: String{""}
    platforms: [String]{[String]{}}
    // Union of the licenses declared by the catalog entries in this pack.
    license: String{""}
    // Command names the pack promises to expose. A missing mapping is a
    // catalog error, never an empty PATH entry.
    required_tools: [String]{[String]{}}

    // Stable identity for one catalog entry. Pack metadata is environment
    // policy, not presentation: variables and commands must invalidate trust
    // even when its package list is unchanged.
    fingerprint: fn(self) -> String Never! {
        lines := [String]{"jet-language-pack-v1\n", "name={self.name}\n"}
        envmodel_push_labeled(lines, "package", self.packages)
        envmodel_push_labeled(lines, "venv-package", self.venv_packages)
        loop name in envmodel_sorted_keys(self.variables) -> lines.push("var={name}={self.variables[name]}\n")
        loop name in envmodel_sorted_keys(self.commands) -> lines.push("command={name}={self.commands[name]}\n")
        lines.push("host={self.host}\n")
        envmodel_push_labeled(lines, "platform", self.platforms)
        lines.push("license={self.license}\n")
        envmodel_push_labeled(lines, "required-tool", self.required_tools)
        lines.join("")
    }

    validate: fn(self) EnvironmentFactError! {
        if self.packages.len() == 0 || envmodel_any_blank(self.packages) {
            return Err(EnvironmentFactError.new("language pack '{self.name}' must declare at least one non-empty package"))
        }
        if envmodel_any_blank(self.venv_packages) {
            return Err(EnvironmentFactError.new("language pack '{self.name}' has an empty venv package"))
        }
        loop name in envmodel_sorted_keys(self.variables) {
            if !envmodel_valid_env_name(name) -> return Err(EnvironmentFactError.new("language pack '{self.name}' has an invalid environment variable name"))
        }
        if self.host.trim() == "" {
            return Err(EnvironmentFactError.new("language pack '{self.name}' must declare a host"))
        }
        if self.platforms.len() == 0 || envmodel_any_blank(self.platforms) {
            return Err(EnvironmentFactError.new("language pack '{self.name}' must declare at least one non-empty platform"))
        }
        if self.license.trim() == "" {
            return Err(EnvironmentFactError.new("language pack '{self.name}' must declare a license"))
        }
        if self.commands.len() == 0 {
            return Err(EnvironmentFactError.new("language pack '{self.name}' must declare at least one command"))
        }
        loop name in envmodel_sorted_keys(self.commands) {
            if name.trim() == "" || self.commands[name].trim() == "" {
                return Err(EnvironmentFactError.new("language pack '{self.name}' has an empty command name or mapping"))
            }
        }
        if self.required_tools.len() == 0 || envmodel_any_blank(self.required_tools) {
            return Err(EnvironmentFactError.new("language pack '{self.name}' must declare non-empty required tools"))
        }
        loop tool in self.required_tools {
            if self.commands.get(tool) == None {
                return Err(EnvironmentFactError.new("language pack '{self.name}' required tool '{tool}' has no command mapping"))
            }
        }
    }
}

// One user selection from `languages`. Expansion turns enabled selections
// into ordinary package refs; the typed selection remains in the plan for
// trust, cache, and user-facing disclosure.
LanguageSpec: struct {
    name: String{""}
    enable: Bool{false}
    version: String?{None}
    channel: String?{None}
    venv: Bool{false}
    extra_packages: [String]{[String]{}}

    key: fn(self) -> String Never! {
        envmodel_language_key(self.name)
    }

    fingerprint: fn(self) -> String Never! {
        version: self.version ?? ""
        channel: self.channel ?? ""
        "{self.name}\tenable={self.enable}\tversion={version}\tchannel={channel}\tvenv={self.venv}\textra={self.extra_packages.join(",")}"
    }

    same_selection: fn(self, other: LanguageSpec) -> Bool Never! {
        self.key() == other.key() && self.enable == other.enable && self.version == other.version && self.channel == other.channel && self.venv == other.venv && self.extra_packages == other.extra_packages
    }
}

// One typed language selection projected through its catalog entry. The
// selection preserves author facts; `included` and `omitted` make the package
// projection explicit for trust, image, and diagnostics consumers.
LanguageProjection: struct {
    selection: LanguageSpec{LanguageSpec{}}
    pack: LanguagePack{LanguagePack{}}
    included: [String]{[String]{}}
    omitted: [String]{[String]{}}
    changed: [String]{[String]{}}
    host: String{""}
    platform: String{""}
    license: String{""}
    missing_tools: [String]{[String]{}}

    fingerprint: fn(self) -> String Never! {
        "selection={self.selection.fingerprint()}\npack={self.pack.fingerprint()}included={self.included.join(",")}\nomitted={self.omitted.join(",")}\nchanged={self.changed.join(",")}\nhost={self.host}\nplatform={self.platform}\nlicense={self.license}\nmissing-tools={self.missing_tools.join(",")}\n"
    }
}

LanguageExpansion: struct {
    applied: [String]{[String]{}}
    // The exact catalog entries used by this expansion. Keeping these with the
    // derived package list makes the expansion the one runtime fact shared by
    // planning, trust, activation, and disclosure.
    packs: [LanguagePack]{[LanguagePack]{}}
    selections: [LanguageSpec]{[LanguageSpec]{}}
    packages: [String]{[String]{}}
    variables: [String: String]{[String: String]{}}
    commands: [String: String]{[String: String]{}}
    projections: [LanguageProjection]{[LanguageProjection]{}}

    fingerprint: fn(self) -> String Never! {
        lines := [String]{"jet-language-expansion-v1\n"}
        loop selection in self.selections -> lines.push("selection={selection.fingerprint()}\n")
        loop pack in self.packs -> lines.push("pack={pack.fingerprint()}")
        envmodel_push_labeled(lines, "expanded-package", self.packages)
        loop name in envmodel_sorted_keys(self.variables) -> lines.push("expanded-var={name}={self.variables[name]}\n")
        loop name in envmodel_sorted_keys(self.commands) -> lines.push("expanded-command={name}={self.commands[name]}\n")
        loop projection in self.projections -> lines.push("projection={projection.fingerprint()}")
        lines.join("")
    }

    // Add `package` to the expanded package list once.
    add_package: fn(&self, package: String) Never! {
        if !self.packages.contains(package) -> self.packages.push(package)
    }
}

LanguagePackCatalog: struct {
    priv packs: [String: LanguagePack]{[String: LanguagePack]{}}

    empty: fn() -> LanguagePackCatalog Never! {
        LanguagePackCatalog{}
    }

    builtin: fn() -> LanguagePackCatalog Never! {
        catalog := LanguagePackCatalog{}
        loop pack in envmodel_core_language_packs() {
            if catalog.register(pack) == .Err(_) -> panic("built-in language pack names are unique")
        }
        loop row in envmodel_extended_language_rows() {
            if catalog.register(row.pack()) == .Err(_) -> panic("extended built-in language pack names are unique")
        }
        catalog
    }

    register: fn(&self, pack: LanguagePack) EnvironmentFactError! {
        if pack.name.trim() == "" -> return Err(EnvironmentFactError.new("language pack name cannot be empty"))
        key: envmodel_language_key(pack.name)
        loop name in envmodel_sorted_keys(self.packs) {
            if envmodel_language_key(name) == key -> return Err(EnvironmentFactError.new("language pack '{pack.name}' is already registered"))
        }
        pack.validate()
        self.packs[pack.name] = pack
    }

    // Exact name first, then the same language key (case and punctuation
    // insensitive) in catalog order.
    get: fn(self, name: String) -> LanguagePack? Never! {
        if self.packs.get(name) == .Val(pack) -> return Val(pack)
        key: envmodel_language_key(name)
        loop pack_name in envmodel_sorted_keys(self.packs) {
            if envmodel_language_key(pack_name) == key -> return Val(self.packs[pack_name])
        }
        None
    }

    names: fn(self) -> [String] Never! {
        envmodel_sorted_keys(self.packs)
    }

    // Stable catalog identity disclosed by `jet env info`; changing a pack's
    // packages or host variables changes this fingerprint.
    fingerprint: fn(self) -> String Never! {
        lines := [String]{"jet-language-catalog-v1\n"}
        loop name in envmodel_sorted_keys(self.packs) -> lines.push("{self.packs[name].fingerprint()}\n")
        pkg_sha256_hex(lines.join("").bytes())
    }

    expand: fn(self, selections: [LanguageSpec]) -[Env]> LanguageExpansion EnvironmentFactError! {
        self.expand_for_platform(selections, pkg_host_key())
    }

    // Expand selections for one explicit host platform. Keeping the target
    // parameter here makes unsupported-host behavior testable without
    // pretending the host is something it is not.
    expand_for_platform: fn(self, selections: [LanguageSpec], platform: String) -> LanguageExpansion EnvironmentFactError! {
        expansion := LanguageExpansion{}
        loop selection in selections {
            pack: self.get(selection.name) ?? return Err(EnvironmentFactError.new("language pack '{selection.name}' is not in the catalog"))
            normalized := selection
            normalized.name = pack.name
            duplicate := false
            loop existing in expansion.selections {
                if existing.key() == normalized.key() {
                    if !existing.same_selection(normalized) {
                        return Err(EnvironmentFactError.new("language pack `{normalized.name}` is declared with conflicting selection facts"))
                    }
                    duplicate = true
                    break
                }
            }
            if duplicate -> next
            expansion.selections.push(normalized)
            projection := LanguageProjection{selection: normalized, pack: pack, host: pack.host, platform: platform, license: pack.license}
            if selection.enable && pack.license.trim() == "" {
                return Err(EnvironmentFactError.new("language pack `{pack.name}` has no license fact"))
            }
            if selection.enable && pack.platforms.len() > 0 && !pack.platforms.contains(platform) {
                return Err(EnvironmentFactError.new("language pack `{pack.name}` does not support host platform `{platform}`"))
            }
            missing_tools := [String]{}
            loop tool in pack.required_tools {
                if pack.commands.get(tool) == None -> missing_tools.push(tool)
            }
            if selection.enable && missing_tools.len() > 0 {
                return Err(EnvironmentFactError.new("language pack `{pack.name}` is missing catalog tools: {missing_tools.join(", ")}"))
            }
            projection.missing_tools = missing_tools
            projection.changed.push("host={pack.host}")
            projection.changed.push("platform={platform}")
            projection.changed.push("license={pack.license}")
            if selection.version == .Val(version) -> projection.changed.push("version={version}")
            if selection.channel == .Val(channel) -> projection.changed.push("channel={channel}")
            if selection.venv -> projection.changed.push("venv=true")
            if selection.extra_packages.len() > 0 -> projection.changed.push("extra={selection.extra_packages.join(",")}")
            if !selection.enable {
                projection.omitted.extend(pack.packages)
                projection.omitted.extend(pack.venv_packages)
                projection.omitted.extend(selection.extra_packages)
                projection.changed.push("enable=false")
                expansion.projections.push(projection)
                next
            }
            if !expansion.applied.contains(pack.name) {
                expansion.applied.push(pack.name)
                expansion.packs.push(pack)
            }
            loop package in pack.packages {
                versioned: envmodel_versioned_package(package, selection.version)
                expansion.add_package(versioned)
                projection.included.push(versioned)
            }
            loop package in selection.extra_packages {
                expansion.add_package(package)
                projection.included.push(package)
            }
            if {
                selection.venv -> {
                    loop package in pack.venv_packages {
                        versioned: envmodel_versioned_package(package, selection.version)
                        expansion.add_package(versioned)
                        projection.included.push(versioned)
                    }
                }
                else -> { projection.omitted.extend(pack.venv_packages) }
            }
            loop key in envmodel_sorted_keys(pack.variables) -> envmodel_merge_language_fact(expansion.variables, pack.name, "variable", key, pack.variables[key])
            loop key in envmodel_sorted_keys(pack.commands) -> envmodel_merge_language_fact(expansion.commands, pack.name, "command", key, pack.commands[key])
            expansion.projections.push(projection)
        }
        Ok(expansion)
    }

    expand_names: fn(self, names: [String]) -[Env]> LanguageExpansion EnvironmentFactError! {
        selections := [LanguageSpec]{}
        loop name in names -> selections.push(LanguageSpec{name: name, enable: true})
        self.expand(selections)
    }
}

// The case- and punctuation-insensitive identity of a language name: its
// ASCII letters and digits, lowercased.
envmodel_language_key: fn(name: String) -> String Never! {
    out := [U8]{}
    loop byte in name.bytes() {
        if pkg_bytes_is_word(Int.from_u8(byte)) && Int.from_u8(byte) != 95 -> out.push(byte)
    }
    pkg_ascii_lower(String.from_bytes(out) ?? "")
}

envmodel_merge_language_fact: fn(facts: &[String: String], pack_name: String, kind: String, key: String, value: String) EnvironmentFactError! {
    if facts.get(key) == {
        .Val(existing) -> {
            if existing != value -> return Err(EnvironmentFactError.new("language pack '{pack_name}' conflicts with existing {kind} '{key}'"))
        }
        .None -> facts[key] = value
    }
}

// Pin a catalog package to the selected version unless it already carries a
// version or channel marker.
envmodel_versioned_package: fn(package: String, version: String?) -> String Never! {
    selected: version ?? return package.copy()
    parts: package.cut_last(REF_PROVIDER_AT) ?? return package.copy()
    if parts.before.contains("#version=") || parts.after.contains(REF_CHANNEL_MARKER) -> return package.copy()
    "{parts.before}{REF_PROVIDER_AT}{parts.after}{REF_CHANNEL_MARKER}version={selected}"
}

// The four core language families with their curated command maps.
envmodel_core_language_packs: fn() -> [LanguagePack] Never! {
    [LanguagePack]{
        {
            name: "Rust",
            packages: [String]{"rustc@jetpack", "cargo@jetpack", "rust-analyzer@jetpack", "rustfmt@jetpack", "clippy@jetpack"},
            commands: [String: String]{"rustc": "rustc", "cargo": "cargo", "rust-analyzer": "rust-analyzer", "rustfmt": "rustfmt", "clippy": "clippy-driver"},
            host: "native",
            platforms: ENVMODEL_LANGUAGE_PLATFORMS,
            license: "Apache-2.0 OR MIT",
            required_tools: [String]{"rustc", "cargo", "rust-analyzer", "rustfmt", "clippy"}
        },
        {
            name: "Python",
            packages: [String]{"python@jetpack", "pip@jetpack"},
            venv_packages: [String]{"pythonPackages.virtualenv@jetpack"},
            commands: [String: String]{"python": "python3", "pip": "pip"},
            host: "native",
            platforms: ENVMODEL_LANGUAGE_PLATFORMS,
            license: "MIT OR PSF-2.0",
            required_tools: [String]{"python", "pip"}
        },
        {
            name: "Go",
            packages: [String]{"go@jetpack", "gopls@jetpack"},
            commands: [String: String]{"go": "go", "gofmt": "gofmt", "gopls": "gopls"},
            host: "native",
            platforms: ENVMODEL_LANGUAGE_PLATFORMS,
            license: "BSD-3-Clause",
            required_tools: [String]{"go", "gofmt", "gopls"}
        },
        {
            name: "JavaScript",
            packages: [String]{"nodejs@jetpack"},
            commands: [String: String]{"node": "node", "npm": "npm", "npx": "npx"},
            host: "native",
            platforms: ENVMODEL_LANGUAGE_PLATFORMS,
            license: "MIT",
            required_tools: [String]{"node", "npm", "npx"}
        }
    }
}

// One extended catalog row: every tool is both a command and a required tool.
LanguageCatalogRow: struct {
    name: String
    packages: [String]
    tools: [String]
    license: String

    pack: fn(self) -> LanguagePack Never! {
        commands := [String: String]{}
        loop tool in self.tools -> commands[tool] = tool
        LanguagePack{name: self.name, packages: self.packages, commands: commands, host: "native", platforms: ENVMODEL_LANGUAGE_PLATFORMS, license: self.license, required_tools: self.tools}
    }
}

envmodel_extended_language_names: fn() -> [String] Never! {
    names := [String]{}
    loop row in envmodel_extended_language_rows() -> names.push(row.name)
    names
}

envmodel_extended_language_pack: fn(name: String) -> LanguagePack Never! {
    loop row in envmodel_extended_language_rows() {
        if row.name == name -> return row.pack()
    }
    panic("unknown extended language pack: {name}")
}

envmodel_language_row: fn(name: String, packages: [String], tools: [String], license: String) -> LanguageCatalogRow Never! {
    LanguageCatalogRow{name: name, packages: packages, tools: tools, license: license}
}

envmodel_extended_language_rows: fn() -> [LanguageCatalogRow] Never! {
