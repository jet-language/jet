// The first-party font battery: one face/run model across native and
// headless tiers.
//
// `shape` validates the face and returns the canonical run every tier
// produces today: approximate, deterministic advances from the face size.
// `shape_with` is the same portable run without the validation, for callers
// that build faces they already trust.
FontStyle: enum {
    Body
    Title
    Monospace
}

GlyphShaper: enum {
    HarfBuzz
    HeadlessFallback
}

FontFace: struct {
    family: String
    size: Float
    style: FontStyle
}

Glyph: struct {
    id: Int
    cluster: Int
    x: Float
    y: Float
    advance_x: Float
    advance_y: Float
}

GlyphRun: struct {
    glyphs: [Glyph]
    advance_x: Float
    advance_y: Float
    shaper: GlyphShaper
    deterministic: Bool
    approximate: Bool
}

system: fn(style: FontStyle) -> FontFace Never! {
    if style == FontStyle.Monospace -> return FontFace{family: "monospace", size: 14.0, style: style}
    if style == FontStyle.Title -> return FontFace{family: "system-ui", size: 24.0, style: style}
    FontFace{family: "system-ui", size: 14.0, style: style}
}

shape_with: fn(face: FontFace, text: String) -> GlyphRun Never! {
    shape_fallback(face, text)
}

shape: fn(text: String, face: FontFace) -> GlyphRun Never! {
    if !(face.size > 0.0 && face.size - face.size == 0.0) -> panic("font shaping contract failure: font size must be finite and positive")
    shape_fallback(face, text)
}

shape_fallback: fn(face: FontFace, text: String) -> GlyphRun {
    glyphs := [Glyph]{}
    advance := Float{0.0}
    raw: text.bytes()
    i := 0
    loop i < raw.len() {
        pair: decode_cp(raw, i)
        width: glyph_advance(face, pair.cp)
        glyphs.push(Glyph{
            id: pair.cp,
            cluster: i,
            x: advance,
            y: 0.0,
            advance_x: width,
            advance_y: 0.0,
        })
        advance += width
        i = pair.next
    }
    GlyphRun{
        glyphs: glyphs,
        advance_x: advance,
        advance_y: 0.0,
        shaper: GlyphShaper.HeadlessFallback,
        deterministic: true,
        approximate: true,
    }
}

glyph_advance: fn(face: FontFace, cp: Int) -> Float {
    if cp == 10 -> return 0.0
    if cp < 128 -> return face.size * 0.6
    face.size
}

DecodePair: struct {
    cp: Int
    next: Int
}

decode_cp: fn(raw: [U8], i: Int) -> DecodePair {
    if i >= raw.len() -> return DecodePair{cp: 0, next: i}
    first: Int{raw[i]}
    if first < 128 -> return DecodePair{cp: first, next: i + 1}

    width := 0
    cp := 0
    if first >= 194 && first <= 223 {
        width = 2
        cp = (first).bit_and(31)
    }
    if first >= 224 && first <= 239 {
        width = 3
        cp = (first).bit_and(15)
    }
    if first >= 240 && first <= 244 {
        width = 4
        cp = (first).bit_and(7)
    }
    if width == 0 || i + width > raw.len() -> return DecodePair{cp: 65533, next: i + 1}

    second: Int{raw[i + 1]}
    // Reject overlong encodings and UTF-16 surrogate prefixes before the
    // continuation loop so malformed bytes consume one byte at a time.
    if (first == 224 && second < 160) || (first == 237 && second >= 160) {
        return DecodePair{cp: 65533, next: i + 1}
    }
    if (first == 240 && second < 144) || (first == 244 && second >= 144) {
        return DecodePair{cp: 65533, next: i + 1}
    }

    k := 1
    loop k < width {
        byte: Int{raw[i + k]}
        if byte < 128 || byte >= 192 -> return DecodePair{cp: 65533, next: i + 1}
        cp = ((cp << 6)).bit_or(((byte).bit_and(63)))
        k += 1
    }
    if cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
        return DecodePair{cp: 65533, next: i + 1}
    }
    DecodePair{cp: cp, next: i + width}
}


#Test("system font styles have canonical family and size defaults") {
    body: system(.Body)
    title: system(.Title)
    mono: system(.Monospace)
    assert_eq(body.family, "system-ui")
    assert_eq(body.size, 14.0)
    assert_eq(title.family, "system-ui")
    assert_eq(title.size, 24.0)
    assert_eq(mono.family, "monospace")
    assert_eq(mono.size, 14.0)
}

#Test("shape returns one approximate glyph per scalar at its byte cluster") {
    face: system(.Body)
    run: shape("aé\n", face)
    assert_eq(run.advance_x, shape_with(face, "aé\n").advance_x)
    assert_eq(run.glyphs.len(), 3)
    assert_eq(run.glyphs[0].id, 97)
    assert_eq(run.glyphs[1].id, 233)
    assert_eq(run.glyphs[1].cluster, 1)
    assert_eq(run.glyphs[2].cluster, 3)
    assert_eq(run.glyphs[1].advance_x, 14.0)
    assert_eq(run.glyphs[2].advance_x, 0.0)
    assert(run.shaper == GlyphShaper.HeadlessFallback && run.deterministic && run.approximate)
}
