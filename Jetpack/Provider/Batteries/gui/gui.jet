// D-FOUND-PLATFORM1 / #2815: the first-party GUI battery keeps editor state,
// Unicode-safe editing, persistence policy, and view composition in ordinary Jet
// code. Host boundaries remain the canonical core.ui.host/core.font calls.
use {
    font: core.font
    text: core.text
    ui: core.ui
    host: core.ui.host
    clipboard: core.ui.host.clipboard
    ime: core.ui.host.ime
    drag_drop: core.ui.host.drag_drop
    shortcuts: core.ui.host.shortcuts
    accessibility: core.ui.host.accessibility
}

// The library output names this module; its public helpers belong to the
// package namespace (`gui.new_editor`), not a nested `gui.gui` namespace.
TextSelection: struct {
    anchor: Int
    active: Int
}

TextEdit: struct {
    text: String
    selection: TextSelection
}

EditorState: struct {
    body: String
    title: String
    theme: String
    settings_open: Bool
    selection: TextSelection
    composition: String
    undo: [String]
    redo: [String]
    revision: Int
    status: String
}

SessionSettings: struct {
    theme: String
    settings_open: Bool
}

clamp_offset: fn(value: String, offset: Int) -> Int {
    limit: text.scalar_count(value)
    if offset < 0 -> return 0
    if offset > limit -> return limit
    return offset
}

snap_boundary: fn(value: String, offset: Int) -> Int {
    bounded: clamp_offset(value, offset)
    clusters: text.graphemes(value)
    cursor := 0
    loop cluster in clusters {
        next: cursor + text.scalar_count(cluster)
        if bounded <= cursor -> return cursor
        if bounded < next -> return cursor
        cursor = next
    }
    cursor
}

grapheme_boundary: fn(value: String, grapheme_index: Int) -> Int {
    clusters: text.graphemes(value)
    bounded: if grapheme_index < 0 -> 0 else -> grapheme_index
    offset := 0
    position := 0
    loop cluster in clusters {
        if position >= bounded -> break
        offset += text.scalar_count(cluster)
        position += 1
    }
    offset
}

grapheme_index: fn(value: String, offset: Int) -> Int {
    boundary: snap_boundary(value, offset)
    clusters: text.graphemes(value)
    cursor := 0
    index := 0
    loop cluster in clusters {
        if cursor >= boundary -> break
        cursor += text.scalar_count(cluster)
        index += 1
    }
    index
}

selection: fn(anchor: Int, active: Int) -> TextSelection {
    TextSelection{anchor: anchor, active: active}
}

normalize_selection: fn(value: String, current: TextSelection) -> TextSelection {
    anchor: snap_boundary(value, current.anchor)
    active: snap_boundary(value, current.active)
    TextSelection{anchor: anchor, active: active}
}

selection_start: fn(value: String, current: TextSelection) -> Int {
    normalized: normalize_selection(value, current)
    if normalized.anchor < normalized.active -> normalized.anchor
    normalized.active
}

selection_end: fn(value: String, current: TextSelection) -> Int {
    normalized: normalize_selection(value, current)
    if normalized.anchor > normalized.active -> normalized.anchor
    normalized.active
}

selected_text: fn(value: String, current: TextSelection) -> String {
    start: selection_start(value, current)
    end: selection_end(value, current)
    text.scalars(value).slice(start, end).join("")
}

// Text offsets are stored at Unicode grapheme boundaries. The host editor
// can add platform-specific cursor, IME, and selection events unchanged.
replace_selection: fn(value: String, current: TextSelection, replacement: String) -> TextEdit {
    start: selection_start(value, current)
    end: selection_end(value, current)
    scalars: text.scalars(value)
    prefix: scalars.slice(0, start).join("")
    suffix: scalars.slice(end, scalars.len()).join("")
    next: "{prefix}{replacement}{suffix}"
    cursor: start + text.scalar_count(replacement)
    TextEdit{
        text: next.copy(),
        selection: TextSelection{anchor: cursor, active: cursor},
    }
}

move_cursor: fn(value: String, current: TextSelection, delta: Int) -> TextSelection {
    normalized: normalize_selection(value, current)
    base: if {
        normalized.anchor == normalized.active -> normalized.active
        delta < 0 -> selection_start(value, normalized)
        else -> selection_end(value, normalized)
    }
    base_index: grapheme_index(value, base)
    clusters: text.graphemes(value)
    target_index := base_index + delta
    if target_index < 0 -> target_index = 0
    if target_index > clusters.len() -> target_index = clusters.len()
    target: grapheme_boundary(value, target_index)
    TextSelection{anchor: target, active: target}
}

grapheme_cursor_boundary: fn(value: String, grapheme_index: Int) -> Int {
    grapheme_boundary(value, grapheme_index)
}

new_editor: fn(body: String, title: String) -> EditorState {
    cursor: text.scalar_count(body)
    EditorState{
        body: body.copy(),
        title: title.copy(),
        theme: "dark",
        settings_open: false,
        selection: TextSelection{anchor: cursor, active: cursor},
        composition: "",
        undo: [String]{},
        redo: [String]{},
        revision: 0,
        status: "new",
    }
}

body_of: fn(state: EditorState) -> String { state.body.copy() }

title_of: fn(state: EditorState) -> String { state.title.copy() }

theme_of: fn(state: EditorState) -> String { state.theme.copy() }

settings_open_of: fn(state: EditorState) -> Bool { state.settings_open }

selection_of: fn(state: EditorState) -> TextSelection { state.selection.copy() }

composition_of: fn(state: EditorState) -> String { state.composition.copy() }

revision_of: fn(state: EditorState) -> Int { state.revision }

status_of: fn(state: EditorState) -> String { state.status.copy() }

commit_edit: fn(state: EditorState, next: String, next_selection: TextSelection, status: String) -> EditorState {
    if state.body == next -> return state.copy()
    history := state.undo
    &history.push(state.body)
    EditorState{
        body: next.copy(),
        title: state.title.copy(),
        theme: state.theme.copy(),
        settings_open: state.settings_open,
        selection: next_selection,
        composition: "",
        undo: history.copy(),
        redo: [String]{},
        revision: state.revision + 1,
        status: status.copy(),
    }
}

with_selection: fn(state: EditorState, next: TextSelection) -> EditorState {
    normalized: normalize_selection(state.body, next)
    EditorState{
        body: state.body.copy(),
        title: state.title.copy(),
        theme: state.theme.copy(),
        settings_open: state.settings_open,
        selection: normalized,
        composition: state.composition.copy(),
        undo: state.undo.copy(),
        redo: state.redo.copy(),
        revision: state.revision,
        status: state.status.copy(),
    }
}

apply_text: fn(state: EditorState, replacement: String) -> EditorState {
    edit: replace_selection(state.body, state.selection, replacement)
    commit_edit(state, edit.text.copy(), edit.selection, "edited")
}

start_composition: fn(state: EditorState) -> EditorState {
    EditorState{
        body: state.body.copy(),
        title: state.title.copy(),
        theme: state.theme.copy(),
        settings_open: state.settings_open,
        selection: state.selection,
        composition: "",
        undo: state.undo.copy(),
        redo: state.redo.copy(),
        revision: state.revision,
        status: "composing",
    }
}

update_composition: fn(state: EditorState, composition: String) -> EditorState {
    EditorState{
        body: state.body.copy(),
        title: state.title.copy(),
        theme: state.theme.copy(),
        settings_open: state.settings_open,
        selection: state.selection,
        composition: composition.copy(),
        undo: state.undo.copy(),
        redo: state.redo.copy(),
        revision: state.revision,
        status: "composing",
    }
}

commit_composition: fn(state: EditorState, composition: String) -> EditorState {
    committed: if composition == "" -> state.composition.copy() else -> composition.copy()
    apply_text(state, committed.copy())
}

cancel_composition: fn(state: EditorState) -> EditorState {
    EditorState{
        body: state.body.copy(),
        title: state.title.copy(),
        theme: state.theme.copy(),
        settings_open: state.settings_open,
        selection: state.selection,
        composition: "",
        undo: state.undo.copy(),
        redo: state.redo.copy(),
        revision: state.revision,
        status: "composition-cancelled",
    }
}

drop_text: fn(state: EditorState, dropped: String) -> EditorState { apply_text(state, dropped) }

undo: fn(state: EditorState) -> EditorState {
    history := state.undo
    previous: &history.pop() ?? return state
    forward := state.redo
    &forward.push(state.body)
    cursor: text.scalar_count(previous)
    EditorState{
        body: previous.copy(),
        title: state.title.copy(),
        theme: state.theme.copy(),
        settings_open: state.settings_open,
        selection: TextSelection{anchor: cursor, active: cursor},
        composition: "",
        undo: history.copy(),
        redo: forward.copy(),
        revision: state.revision + 1,
        status: "undo",
    }
}

redo: fn(state: EditorState) -> EditorState {
    forward := state.redo
    next: &forward.pop() ?? return state
    history := state.undo
    &history.push(state.body)
    cursor: text.scalar_count(next)
    EditorState{
        body: next.copy(),
        title: state.title.copy(),
        theme: state.theme.copy(),
        settings_open: state.settings_open,
        selection: TextSelection{anchor: cursor, active: cursor},
        composition: "",
        undo: history.copy(),
        redo: forward.copy(),
        revision: state.revision + 1,
        status: "redo",
    }
}

set_theme: fn(state: EditorState, theme: String) -> EditorState {
    EditorState{
        body: state.body.copy(),
        title: state.title.copy(),
        theme: theme.copy(),
        settings_open: state.settings_open,
        selection: state.selection,
        composition: state.composition.copy(),
        undo: state.undo.copy(),
        redo: state.redo.copy(),
        revision: state.revision,
        status: state.status.copy(),
    }
}

set_settings_open: fn(state: EditorState, open: Bool) -> EditorState {
    EditorState{
        body: state.body.copy(),
        title: state.title.copy(),
        theme: state.theme.copy(),
        settings_open: open,
        selection: state.selection,
        composition: state.composition.copy(),
        undo: state.undo.copy(),
        redo: state.redo.copy(),
        revision: state.revision,
        status: state.status.copy(),
    }
}

mark_saved: fn(state: EditorState) -> EditorState {
    EditorState{
        body: state.body.copy(),
        title: state.title.copy(),
        theme: state.theme.copy(),
        settings_open: state.settings_open,
        selection: state.selection,
        composition: state.composition.copy(),
        undo: state.undo.copy(),
        redo: state.redo.copy(),
        revision: state.revision,
        status: "saved",
    }
}

mark_error: fn(state: EditorState, message: String) -> EditorState {
    EditorState{
        body: state.body.copy(),
        title: state.title.copy(),
        theme: state.theme.copy(),
        settings_open: state.settings_open,
        selection: state.selection,
        composition: state.composition.copy(),
        undo: state.undo.copy(),
        redo: state.redo.copy(),
        revision: state.revision,
        status: message.copy(),
    }
}

// Keep body and UI settings as separate records. This lets a reload recover
// the Unicode document even when a host cancels its settings transaction.
persisted_body: fn(state: EditorState) -> String { state.body.copy() }

persisted_session: fn(state: EditorState) -> String {
    mode: if state.settings_open -> "open" else -> "closed"
    "JET-GUI-SESSION-1|{state.theme}|{mode}"
}

restore_session: fn(raw: String) -> SessionSettings {
    parts: text.splitn(raw, "|", 3)
    version: parts.get(0) ?? ""
    if version != "JET-GUI-SESSION-1" -> return SessionSettings{theme: "dark", settings_open: false}
    theme := parts.get(1) ?? "dark"
    if theme == "" -> theme = "dark"
    mode: parts.get(2) ?? "closed"
    SessionSettings{theme: theme.copy(), settings_open: mode == "open"}
}

recover: fn(body: String, raw_session: String, title: String) -> EditorState {
    session: restore_session(raw_session)
    base: new_editor(body, title)
    themed: set_theme(base, session.theme.copy())
    set_settings_open(themed, session.settings_open)
}

status_label: fn(state: EditorState) -> String {
    if state.status == "saved" -> return "Saved"
    "{state.status} — revision {state.revision}"
}

settings_view: fn(theme: String, open: Bool) -> UINode {
    if open {
        return ui.box(
        [
            ui.text("SETTINGS"),
            ui.text("Theme: {theme}"),
            ui.text("Recovery: enabled"),
            ui.text("Accessibility: named controls"),
        ],
        )
    }
    ui.text("SETTINGS (closed)")
}

sidebar_view: fn(selected: Int) -> UINode {
    meeting: if selected == 0 -> "* Meeting" else -> "  Meeting"
    ideas: if selected == 1 -> "* Ideas" else -> "  Ideas"
    ui.box(
    [
        ui.text("NOTES"),
        ui.node_role(meeting, 24.0, 1.0, ui.aria_role_button()),
        ui.node_role(ideas, 24.0, 1.0, ui.aria_role_button()),
    ],
    )
}

command_bar: fn() -> UINode {
    ui.box(
    [
        ui.node_shortcut(ui.button("Save"), UIShortcut.cmd("s")),
        ui.node_shortcut(ui.button("Undo"), UIShortcut.cmd("z")),
        ui.node_shortcut(ui.button("Redo"), UIShortcut.cmd("r")),
        ui.node_shortcut(ui.button("Toggle theme"), UIShortcut.cmd("t")),
        ui.node_shortcut(ui.button("Settings"), UIShortcut.cmd(",")),
    ],
    )
}

menu_view: fn() -> UINode {
    ui.box(
    [
        ui.text("FILE"),
        ui.text("Open   Save   Quit"),
        ui.text("Tray fallback: host window lifecycle"),
    ],
    )
}

// Fixed child order is the identity policy for the portable tree. Hosts can
// reconcile this same order while a future keyed-node core gate is pending.
editor_view: fn(body: String, selected: Int, theme: String, settings_open: Bool) -> UINode {
    background: if theme == "dark" -> "#15181d" else -> "#f8f4ea"
    input: ui.text_input(body, .Native)
    ui.box(
    [
        ui.node_color("JET NOTES — {theme} mode", 80.0, 1.0, background),
        sidebar_view(selected),
        ui.node_role("EDITOR — selected {selected}", 80.0, 1.0, ui.aria_role_label()),
        input,
        menu_view(),
        command_bar(),
        settings_view(theme, settings_open),
        ui.text("Ctrl+S Save   Ctrl+Z Undo   Ctrl+Shift+Z Redo"),
        ui.text("Focus order: Save → Editor → Toggle theme"),
    ],
    )
}

focus_group: fn() -> [UINode] {
    [
        ui.node_role("Save", 12.0, 1.0, ui.aria_role_button()),
        ui.node_role("Editor", 60.0, 4.0, ui.aria_role_text_input()),
        ui.node_role("Toggle theme", 18.0, 1.0, ui.aria_role_button()),
    ]
}

save_button: fn() -> UINode { ui.node_shortcut(ui.button("Save"), UIShortcut.cmd("s")) }

system_font: fn(style: FontStyle) -> FontFace { font.system(style) }

shape_text: fn(value: String, face: FontFace) -> GlyphRun { font.shape(value, face) }

host_capabilities: fn() -> UICapabilityFacts { host.capabilities() }

text_filter: fn() -> UIFileFilter { host.file_filter_text() }

file_filter: fn(label: String, extensions: [String], mime_types: [String]) -> UIFileFilter UIHostError! {
    host.file_filter(label, extensions, mime_types)
}

fs_rights: fn() -> UIFSRights { host.fs_rights_read_write() }

request_grant: fn(root: String) -> UIFSGrant UIHostError! {
    host.fs_grant(root, host.fs_rights_read_write())
}

open_request: fn(grant: UIFSGrant) -> UIFileDialogRequest { host.open_request(grant) }

save_request: fn(grant: UIFSGrant) -> UIFileDialogRequest { host.save_request(grant) }

open_file: fn(request: UIFileDialogRequest) -> UIFileDialogSelection UIHostError! {
    host.open_file(request)
}

save_file: fn(request: UIFileDialogRequest) -> UIFileDialogSelection UIHostError! {
    host.save_file(request)
}

read_clipboard: fn() -> UIClipboardText UIHostError! { clipboard.read_text() }

write_clipboard: fn(value: String) -> UIClipboardWrite UIHostError! { clipboard.write_text(value) }

poll_ime: fn() -> UIIMEEvent? UIHostError! { ime.poll() }

poll_drag_drop: fn() -> UIDragEvent? UIHostError! { drag_drop.poll() }

save_shortcut: fn() -> UIShortcut { UIShortcut.cmd("s") }

host_shortcut: fn() -> UIShortcut UIHostError! { host.shortcut("s", save_shortcut().modifiers) }

bind_shortcut: fn(shortcut: UIShortcut, action: String) -> UIShortcutBinding UIHostError! {
    shortcuts.binding(shortcut, action)
}

register_shortcut: fn(binding: UIShortcutBinding) -> UIShortcutBinding UIHostError! {
    shortcuts.register(binding)
}

dispatch_shortcut: fn(shortcut: UIShortcut) -> UIShortcutDispatch UIHostError! {
    shortcuts.dispatch(shortcut)
}

accessibility_metadata: fn(name: String, description: String) -> UIAccessibility UIHostError! {
    host.accessibility(name, description)
}

attach_accessibility: fn(node: UINode, metadata: UIAccessibility) -> UINode UIHostError! {
    accessibility.attach(node, metadata)
}

future_commands: fn() -> [String] {
    [
        "JET_UI_HEADLESS=1 Tools/agent/jet-env jet run Examples/features/ui/battery/run.jet",
        "Tools/agent/jet-env jet run --target=native Examples/features/ui/battery/run.jet",
        "Tools/agent/jet-env jet dev --target=web Examples/features/ui/battery/run.jet",
        "Tools/agent/jet-env jet build Examples/features/ui/battery/run.jet",
        "Tools/agent/jet-env jet package --kind desktop --target linux-appimage --package gui-battery-example --name gui-battery-example --version 0.1.0 --executable build/run --output build/gui-battery-example.AppImage",
    ]
}

open_core_gates: fn() -> [String] {
    [
        "#2771: reactive render ICEs in two compositions",
        "Typography/mobile: native glyph hit-testing plus Android/iOS adapters remain core work",
    ]
}
