// The single Hangar-backed C/C++ toolchain descriptor, ported from
// jetpack::Provider::cc_toolchain.
//
// A C driver never discovers a compiler from the host. It consumes one
// verified Hangar object whose producer record names the compiler, C++
// compiler, linker, sysroot, host, target, ABI, and every content digest.
// The optional fixture manifest is only an acquisition input for tests and
// offline bundles; the release toolchain comes from the C toolchain pack
// (CcToolchainPack.jet). Either way the resulting object is still verified
// and recorded by the ordinary Jetpack Store boundary.
//
// This file holds the descriptor model and every pure rule: target
// selection, text/path/digest validation, the source fingerprint, and the
// fixture producer facts. Hangar verification lives in CcToolchainHangar.jet,
// acquisition in CcToolchainAcquisition.jet and the pack in
// CcToolchainPack.jet.

CC_TOOLCHAIN_PACKAGE: "cc-toolchain"
CC_TOOLCHAIN_SOURCE: "jetpack"
CC_TOOLCHAIN_RECIPE_ID: "jet-cc-toolchain-v1"
CC_TOOLCHAIN_PRODUCER: "jet-cc"
CC_TOOLCHAIN_SCHEMA: "1"
CC_TOOLCHAIN_FIXTURE_MANIFEST: "jet-cc-toolchain"
CC_TOOLCHAIN_FIXTURE_LAYOUT: "fixture-v1"
CC_TOOLCHAIN_VIRTUAL_BASE: "/jet/toolchains"
CC_TOOLCHAIN_MAX_MANIFEST_BYTES: 1048576
CC_TOOLCHAIN_MAX_BUNDLE_NODES: 250000
CC_TOOLCHAIN_MAX_BUNDLE_BYTES: 8589934592
CC_TOOLCHAIN_MAX_TARGET_BYTES: 128

// How a descriptor's bytes are laid out in Hangar: one fixture bundle
// directory, or a target entry holding the sysroot whose tools live in the
// C toolchain pack object.
CcToolchainLayout: enum {
    Fixture
    Pack

    label: fn(self) -> String Never! {
        if self == {
            .Fixture -> CC_TOOLCHAIN_FIXTURE_LAYOUT
            .Pack -> CC_TOOLCHAIN_PACK_LAYOUT
        }
    }

    parse: fn(text: String) -> CcToolchainLayout? Never! {
        if text == {
            CC_TOOLCHAIN_FIXTURE_LAYOUT -> Val(CcToolchainLayout.Fixture)
            CC_TOOLCHAIN_PACK_LAYOUT -> Val(CcToolchainLayout.Pack)
            else -> None
        }
    }
}

// The mounted role roots of a pack-layout toolchain under its virtual root:
// the pack (compiler, linker and their resources) and the target sysroot.
CcToolchainRole: enum {
    Compiler
    Sysroot

    label: fn(self) -> String Never! {
        if self == {
            .Compiler -> "compiler"
            .Sysroot -> "sysroot"
        }
    }
}

// The C toolchain failure carrier. `MissingDescriptor` is the one expected
// miss: Hangar has no verified descriptor yet, so acquisition may proceed.
// `UncoveredTarget` names a target no pack covers; `PackHashMismatch` is a
// pack copy (origin, expected, actual) that was refused and deleted.
#Error
CcToolchainError: enum {
    MissingDescriptor(String)
    Invalid(String)
    UncoveredTarget(String)
    PackHashMismatch(origin: String, expected: String, actual: String)

    message: fn(self) -> String Never! {
        if self == {
            .MissingDescriptor(target) -> "Hangar has no verified C/C++ toolchain descriptor for target `{target}`"
            .Invalid(text) -> text
            .UncoveredTarget(target) -> "jet's C toolchain does not cover target `{target}`; covered targets: {provider_cc_pack_covered_targets()}"
            .PackHashMismatch(origin, expected, actual) -> "the C toolchain pack from {origin} has SHA-256 {actual}, but this jet expects {expected}; the copy was refused and deleted"
        }
    }

    // Whether this is the miss for `target` (and not a corrupt record).
    is_missing_descriptor: fn(self, target: String) -> Bool Never! {
        if self == {
            .MissingDescriptor(missing) -> missing == target
            .Invalid(_) | .UncoveredTarget(_) | .PackHashMismatch(_, _, _) -> false
        }
    }
}

CcMount: struct {
    store_path: String
    digest: String
    source: String
    destination: String
}

CcToolchainDescriptor: struct {
    entry_id: String
    root: String
    host: String
    target: String
    version: String
    abi: String
    compiler: String
    compiler_sha256: String
    cxx: String
    cxx_sha256: String
    linker: String
    linker_sha256: String
    sysroot: String
    sysroot_sha256: String
    bundle_sha256: String
    layout: CcToolchainLayout
    compiler_root: String
    cxx_root: String
    linker_root: String
    sysroot_root: String
    mounts: [CcMount]
    references: [String]
    envelope: Envelope
    producer: ProducerRecord

    virtual_root: fn(self) -> String Never! {
        files.join(CC_TOOLCHAIN_VIRTUAL_BASE, self.bundle_sha256)
    }

    virtual_bin: fn(self) -> String Never! {
        if self.is_pack_layout() -> return files.join(self.role_virtual_root(CcToolchainRole.Compiler), "bin")
        files.join(self.virtual_root(), "bin")
    }

    sysroot_path: fn(self) -> String Never! {
        if self.is_pack_layout() -> return self.role_virtual_root(CcToolchainRole.Sysroot)
        files.join(self.virtual_root(), self.sysroot)
    }

    // The pack clang's resource directory (builtin headers, compiler-rt and
    // crtbegin/crtend); the binary's built-in default names its build tree.
    resource_dir_path: fn(self) -> String Never! {
        files.join(self.role_virtual_root(CcToolchainRole.Compiler), CC_PACK_RESOURCE_DIR)
    }

    identity: fn(self) -> String Never! {
        "{CC_TOOLCHAIN_RECIPE_ID}\n{self.source_fingerprint()}"
    }

    cache_identity: fn(self, ctx: ProviderCtx) -[FS, Env]> CacheIdentity Never! {
        provider_plain_cache_identity(self.source_fingerprint(), CC_TOOLCHAIN_RECIPE_ID, ctx)
    }

    is_pack_layout: fn(self) -> Bool Never! {
        self.layout == CcToolchainLayout.Pack
    }

    role_virtual_root: fn(self, role: CcToolchainRole) -> String Never! {
        files.join(self.virtual_root(), role.label())
    }

    compiler_virtual_path: fn(self) -> String Never! {
        if self.is_pack_layout() -> return files.join(self.role_virtual_root(CcToolchainRole.Compiler), self.compiler)
        files.join(self.virtual_root(), self.compiler)
    }

    cxx_virtual_path: fn(self) -> String Never! {
        if self.is_pack_layout() -> return files.join(self.role_virtual_root(CcToolchainRole.Compiler), self.cxx)
        files.join(self.virtual_root(), self.cxx)
    }

    linker_virtual_path: fn(self) -> String Never! {
        if self.is_pack_layout() -> return files.join(self.role_virtual_root(CcToolchainRole.Compiler), self.linker)
        files.join(self.virtual_root(), self.linker)
    }

    // The cache source identity: every field that names the toolchain bytes.
    source_fingerprint: fn(self) -> String Never! {
        mounts := [String]{}
        loop mount in self.mounts -> mounts.push("{mount.store_path}={mount.digest}")
        lines: [String]{
            CC_TOOLCHAIN_RECIPE_ID,
            "layout={self.layout.label()}",
            "source={self.producer.immutable_source}",
            "host={self.host}",
            "target={self.target}",
            "version={self.version}",
            "abi={self.abi}",
            "compiler={self.compiler}",
            "compiler.sha256={self.compiler_sha256}",
            "cxx={self.cxx}",
            "cxx.sha256={self.cxx_sha256}",
            "linker={self.linker}",
            "linker.sha256={self.linker_sha256}",
            "sysroot={self.sysroot}",
            "sysroot.sha256={self.sysroot_sha256}",
            "bundle.sha256={self.bundle_sha256}",
            "mounts={mounts.join(",")}",
            "references={self.references.join(",")}"
        }
        "{lines.join("\n")}\n"
    }
}

// A fixture bundle manifest (`jet-cc-toolchain[-<target>].json`), already
// shape-checked by `parse`.
CcBundleManifest: struct {
    host: String
    target: String
    version: String
    abi: String
    bundle: String
    compiler: String
    compiler_sha256: String
    cxx: String
    cxx_sha256: String
    linker: String
    linker_sha256: String
    sysroot: String
    sysroot_sha256: String
    bundle_sha256: String
    source: String

    // Parse and validate manifest text read from `file_name` for the
    // normalized `target`. `host` is this machine's target triple.
    parse: fn(text: String, file_name: String, target: String, host: String) -[Env]> CcBundleManifest CcToolchainError! {
        value: json.parse(text) ?? {
            return Err(CcToolchainError.Invalid("parse C toolchain manifest: {err.reason}"))
        }
        object: provider_cc_manifest_object(value) ?? return Err(CcToolchainError.Invalid("C toolchain manifest: expected a Dyn object"))
        schema: provider_cc_manifest_number(object, "schema")
        if schema != 1 -> return Err(CcToolchainError.Invalid("unsupported C toolchain manifest schema"))
        manifest: CcBundleManifest{
            host: provider_cc_manifest_string(object, "host"),
            target: provider_cc_normalize_target(provider_cc_manifest_string(object, "target")),
            version: provider_cc_manifest_string(object, "version"),
            abi: provider_cc_manifest_string(object, "abi"),
            bundle: provider_cc_manifest_string(object, "bundle"),
            compiler: provider_cc_manifest_string(object, "compiler"),
            compiler_sha256: provider_cc_manifest_string(object, "compiler_sha256"),
            cxx: provider_cc_manifest_string(object, "cxx"),
            cxx_sha256: provider_cc_manifest_string(object, "cxx_sha256"),
            linker: provider_cc_manifest_string(object, "linker"),
            linker_sha256: provider_cc_manifest_string(object, "linker_sha256"),
            sysroot: provider_cc_manifest_string(object, "sysroot"),
            sysroot_sha256: provider_cc_manifest_string(object, "sysroot_sha256"),
            bundle_sha256: provider_cc_manifest_string(object, "bundle_sha256"),
            source: "fixture://{file_name}"
        }
        if manifest.target != target {
            return Err(CcToolchainError.Invalid("C toolchain manifest target `{manifest.target}` does not match requested `{target}`"))
        }
        if manifest.host != host {
            return Err(CcToolchainError.Invalid("C toolchain manifest host `{manifest.host}` does not match this machine `{host}`"))
        }
        manifest.validate_shape()
        Ok(manifest)
    }

    validate_shape: fn(self) CcToolchainError! {
        provider_cc_validate_relative_path(self.bundle)
        relative_paths: [String]{self.compiler, self.cxx, self.linker, self.sysroot}
        loop path in relative_paths {
            provider_cc_validate_relative_path(path)
        }
        provider_cc_validate_sha256(self.compiler_sha256, "compiler digest")
        provider_cc_validate_sha256(self.cxx_sha256, "C++ compiler digest")
        provider_cc_validate_sha256(self.linker_sha256, "linker digest")
        provider_cc_validate_tree_digest(self.sysroot_sha256, "sysroot digest")
        provider_cc_validate_tree_digest(self.bundle_sha256, "bundle digest")
        provider_cc_validate_text_field(self.version, "version")
        provider_cc_validate_text_field(self.abi, "ABI")
    }

    // The fixture-layout producer facts.
    facts: fn(self) -> [String: String] Never! {
        [String: String]{
            "cc.schema": CC_TOOLCHAIN_SCHEMA,
            "cc.producer": CC_TOOLCHAIN_PRODUCER,
            "cc.layout": CC_TOOLCHAIN_FIXTURE_LAYOUT,
            "cc.host": self.host,
            "cc.target": self.target,
            "cc.version": self.version,
            "cc.abi": self.abi,
            "cc.compiler": self.compiler,
            "cc.compiler.sha256": self.compiler_sha256,
            "cc.cxx": self.cxx,
            "cc.cxx.sha256": self.cxx_sha256,
            "cc.linker": self.linker,
            "cc.linker.sha256": self.linker_sha256,
            "cc.sysroot": self.sysroot,
            "cc.sysroot.sha256": self.sysroot_sha256,
            "cc.bundle.sha256": self.bundle_sha256,
            "cc.compiler.root.sha256": self.bundle_sha256,
            "cc.cxx.root.sha256": self.bundle_sha256,
            "cc.linker.root.sha256": self.bundle_sha256,
            "cc.sysroot.root.sha256": self.bundle_sha256,
            "cc.mount.count": "1",
            "cc.mount.0.digest": self.bundle_sha256,
            "cc.manifest": self.source
        }
    }

    // The fixture descriptor rooted at the published bundle directory.
    descriptor: fn(self, root: String, entry_id: String) -> CcToolchainDescriptor Never! {
        plan: ProviderPlanFacts.from_facts([String: String]{
            "action.kind": "cc-toolchain-provision",
            "action.recipe": CC_TOOLCHAIN_RECIPE_ID
        }) ?? panic("static C toolchain plan facts are valid")
        producer: ProducerRecord.new(CC_TOOLCHAIN_PRODUCER, self.source, self.bundle_sha256, plan, CC_TOOLCHAIN_RECIPE_ID, "policy=content-addressed\nplatform=host", self.facts()) ?? panic("validated C toolchain manifest facts are valid")
        CcToolchainDescriptor{
            entry_id: entry_id,
            root: root,
            host: self.host,
            target: self.target,
            version: self.version,
            abi: self.abi,
            compiler: self.compiler,
            compiler_sha256: self.compiler_sha256,
            cxx: self.cxx,
            cxx_sha256: self.cxx_sha256,
            linker: self.linker,
            linker_sha256: self.linker_sha256,
            sysroot: self.sysroot,
            sysroot_sha256: self.sysroot_sha256,
            bundle_sha256: self.bundle_sha256,
            layout: CcToolchainLayout.Fixture,
            compiler_root: root,
            cxx_root: root,
            linker_root: root,
            sysroot_root: root,
            mounts: [CcMount]{provider_cc_fixture_mount(root, self.bundle_sha256)},
            references: [String]{},
            envelope: Envelope.empty(),
            producer: producer
        }
    }
}

// The single mount of a fixture bundle: its root at the virtual root.
provider_cc_fixture_mount: fn(root: String, bundle_sha256: String) -> CcMount Never! {
    CcMount{store_path: "", digest: bundle_sha256, source: root, destination: files.join(CC_TOOLCHAIN_VIRTUAL_BASE, bundle_sha256)}
}

// Whether a package ref names the one C/C++ toolchain package. It stays in
// the existing native provider rather than adding a second ProviderKind.
provider_cc_toolchain_is_reference: fn(spec: RefSpec) -> Bool Never! {
    package: spec.package.split_once("#")?.before ?? spec.package
    if package != CC_TOOLCHAIN_PACKAGE -> return false
    if spec.source == {
        .Jetpack -> true
        .Named(name) -> name == CC_TOOLCHAIN_SOURCE
        .Nixpkgs | .Github | .Path | .Cran | .LuaRocks | .RubyGems | .Cpan | .Packagist | .JetRegistry | .Npm | .Cargo | .PyPI | .SwiftPM | .Maven | .NuGet | .Conan | .Vcpkg | .Homebrew | .Binary | .Releases -> false
    }
}

// The normalized target a ref selects: the host without a selector, or the
// explicit `#target=<target-triple>`.
provider_cc_toolchain_requested_target: fn(spec: RefSpec) -[Env]> String CcToolchainError! {
    selector: spec.package.split_once("#")?.after ?? ""
    if selector == "" -> return provider_cc_normalize_target(provider_cc_toolchain_host_target_triple())
    if !selector.starts_with("target=") || selector == "target=" {
        return Err(CcToolchainError.Invalid("C toolchain selectors must use `#target=<target-triple>`"))
    }
    provider_cc_normalize_target(selector.removeprefix("target="))
}

provider_cc_toolchain_host_target_triple: fn() -[Env]> String Never! {
    provider_cc_target_triple_for(PlatformKey.host())
}

// The target triple Rust spells for an `arch`/`os` host key.
provider_cc_target_triple_for: fn(host: PlatformKey) -> String Never! {
    if host.os == {
        OS_LINUX -> "{host.arch}-unknown-linux-gnu"
        OS_MACOS -> "{host.arch}-apple-darwin"
        OS_WINDOWS -> "{host.arch}-pc-windows-msvc"
        else -> "{host.arch}-{host.os}"
    }
}

// `native`/`host` select the host and a covered target's short spelling
// (`aarch64-linux-musl`) selects its canonical triple; any other target must
// be a short token of ASCII letters, digits, `.`, `_`, and `-`.
provider_cc_normalize_target: fn(target: String) -[Env]> String CcToolchainError! {
    normalized: if target == {
        "native" | "host" -> provider_cc_toolchain_host_target_triple()
        else -> target
    }
    if !provider_cc_is_target_token(normalized) -> return Err(CcToolchainError.Invalid("invalid C toolchain target `{normalized}`"))
    if provider_cc_pack_target(normalized) == .Val(covered) -> return Ok(covered.triple)
    Ok(normalized)
}

provider_cc_is_target_token: fn(target: String) -> Bool Never! {
    raw: target.bytes()
    if raw.len() == 0 || raw.len() > CC_TOOLCHAIN_MAX_TARGET_BYTES -> return false
    loop byte in raw {
        code: Int.from_u8(byte)
        if !provider_cc_is_ascii_alnum(code) && code != 46 && code != 95 && code != 45 -> return false
    }
    true
}

provider_cc_is_ascii_alnum: fn(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
}

// Whether a Hangar producer record was written by this provider, in either
// layout.
provider_cc_is_cc_record: fn(producer: ProducerRecord) -> Bool Never! {
    layout: producer.facts.get("cc.layout") ?? ""
    producer.provider == CC_TOOLCHAIN_PRODUCER && (layout == CC_TOOLCHAIN_FIXTURE_LAYOUT || layout == CC_TOOLCHAIN_PACK_LAYOUT)
}

// `Path::components` over a validated relative path: its normal parts, with
// empty and `.` segments dropped.
provider_cc_path_parts: fn(path: String) -> [String] Never! {
    parts := [String]{}
    segments: path.split("/").to_list()
    loop part in segments {
        if part == "" || part == "." -> next
        parts.push(part)
    }
    parts
}

provider_cc_validate_relative_path: fn(path: String) CcToolchainError! {
    if provider_cc_is_relative_path(path) -> return
    Err(CcToolchainError.Invalid("`{path}` is not a normalized relative path"))
}

// Non-empty, not absolute, no leading `.` component, no `..` component, and
// no NUL byte.
provider_cc_is_relative_path: fn(path: String) -> Bool Never! {
    if path == "" || path.starts_with("/") -> return false
    raw: path.bytes()
    loop byte in raw {
        if Int.from_u8(byte) == 0 -> return false
    }
    segments: path.split("/").to_list()
    if segments[0] == "." -> return false
    loop segment in segments {
        if segment == ".." -> return false
    }
    true
}

// Version and ABI text: non-blank, with no control byte or path separator,
// so it can never escape a publication path.
provider_cc_validate_text_field: fn(value: String, label: String) CcToolchainError! {
    if value.trim() == "" -> return Err(CcToolchainError.Invalid("{label}: value is empty"))
    raw: value.bytes()
    loop byte in raw {
        code: Int.from_u8(byte)
        if code < 32 || code == 127 || code == 47 || code == 92 {
            return Err(CcToolchainError.Invalid("{label}: value contains a control character or path separator"))
        }
    }
}

provider_cc_validate_sha256: fn(value: String, label: String) CcToolchainError! {
    raw: value.bytes()
    if raw.len() != 64 -> return Err(CcToolchainError.Invalid("{label} is not a lowercase SHA-256 digest"))
    loop byte in raw {
        code: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102)) {
            return Err(CcToolchainError.Invalid("{label} is not a lowercase SHA-256 digest"))
        }
    }
}

provider_cc_validate_tree_digest: fn(value: String, label: String) CcToolchainError! {
    if !value.starts_with("sha256-") -> return Err(CcToolchainError.Invalid("{label} is not a Hangar SHA-256 digest"))
    provider_cc_validate_sha256(value.removeprefix("sha256-"), label)
}

provider_cc_manifest_string: fn(object: [String: Dyn], field: String) -> String CcToolchainError! {
    value: object.get(field) ?? return Err(CcToolchainError.Invalid("C toolchain manifest misses `{field}`"))
    if value == {
        .Text(text) -> Ok(text)
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> Err(CcToolchainError.Invalid("C toolchain manifest field `{field}`: expected a Dyn string"))
    }
}

provider_cc_manifest_number: fn(object: [String: Dyn], field: String) -> Int CcToolchainError! {
    number: foundation_json_integer(object.get(field) ?? Dyn.Null) ?? return Err(CcToolchainError.Invalid("C toolchain manifest field `{field}` is not a number"))
    Ok(number)
}

provider_cc_manifest_object: fn(value: Dyn) -> [String: Dyn]? Never! {
    if value == {
        // The object's ordered pairs, indexed by name.
        .Object(fields) -> {
            members := [String: Dyn]{}
            loop pair in fields -> members[pair.key] = pair.value
            Val(members)
        }
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) -> None
    }
}
