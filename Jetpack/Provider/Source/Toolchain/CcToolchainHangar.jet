// Resolve and verify a C/C++ toolchain descriptor from a committed,
// receipt-checked Hangar projection (jetpack::Provider::cc_toolchain). Store
// registration remains the single write/recording boundary; this file only
// reads Hangar and re-proves every digest, including the toolchain pack a
// pack-layout target entry mounts.

provider_cc_toolchain_resolve_for_target: fn(verification: &StoreVerification, hangar_root: String, target: String, allow_fixture: Bool) -[FS, Env, Time]> CcToolchainDescriptor CcToolchainError! {
    normalized: provider_cc_normalize_target(target)
    roots: provider_cc_roots_for_hangar(hangar_root)
    entries: store_list_checked(verification, roots) ?? {
        return Err(CcToolchainError.Invalid("could not inspect Hangar C toolchain records: {err.message()}"))
    }
    // The last corrupt candidate wins over "missing" so a damaged record is
    // never silently re-acquired.
    corrupt := ""
    loop entry in entries {
        if entry.name != CC_TOOLCHAIN_PACKAGE -> next
        producer: ProducerRecord.decode(entry.producer_record) ?? {
            corrupt = "Hangar C toolchain `{entry.id}` has an invalid producer record: {err.message()}"
            next
        }
        if !provider_cc_is_cc_record(producer) {
            corrupt = "Hangar entry `{entry.id}` is named `{CC_TOOLCHAIN_PACKAGE}` but was not produced by the C/C++ provider"
            next
        }
        layout: producer.facts.get("cc.layout") ?? ""
        if !allow_fixture && layout == CC_TOOLCHAIN_FIXTURE_LAYOUT -> next
        if producer.facts.get("cc.target") != Val(normalized) -> next
        // An entry built from another jet's pack is not this jet's toolchain.
        if layout == CC_TOOLCHAIN_PACK_LAYOUT && !provider_cc_pack_is_current(producer) -> next
        if provider_cc_descriptor_from_entry(roots, entry, producer) == {
            .Ok(descriptor) -> return Ok(descriptor)
            .Err(error) -> corrupt = error.message()
        }
    }
    if corrupt != "" -> return Err(CcToolchainError.Invalid(corrupt))
    Err(CcToolchainError.MissingDescriptor(normalized))
}

// The Hangar roots whose `hangar_dir()` is exactly `hangar`.
provider_cc_roots_for_hangar: fn(hangar: String) -> HangarRoots CcToolchainError! {
    if hangar == "" || hangar == "/" -> return Err(CcToolchainError.Invalid("Hangar root has no parent"))
    roots: HangarRoots{root: files.dirname(hangar), dev_mode: files.basename(hangar) == "Hangar"}
    if roots.hangar_dir() != hangar -> return Err(CcToolchainError.Invalid("unsupported Hangar layout `{hangar}`"))
    Ok(roots)
}

// One required producer fact of a Hangar entry.
provider_cc_fact: fn(producer: ProducerRecord, entry_id: String, key: String) -> String CcToolchainError! {
    producer.facts.get(key) ?? return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry_id}` is missing fact `{key}`"))
}

provider_cc_descriptor_from_entry: fn(roots: HangarRoots, entry: StoreEntry, producer: ProducerRecord) -[FS, Env]> CcToolchainDescriptor CcToolchainError! {
    schema: provider_cc_fact(producer, entry.id, "cc.schema")
    if schema != CC_TOOLCHAIN_SCHEMA -> return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` has an unsupported descriptor schema"))
    hangar: roots.hangar_dir()
    root: provider_cc_checked_entry_root(hangar, entry)
    layout_text: provider_cc_fact(producer, entry.id, "cc.layout")
    bundle_sha256: provider_cc_fact(producer, entry.id, "cc.bundle.sha256")
    layout: CcToolchainLayout.parse(layout_text) ?? return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` has unsupported layout `{layout_text}`"))
    descriptor := CcToolchainDescriptor{
        entry_id: entry.id,
        root: root,
        host: provider_cc_fact(producer, entry.id, "cc.host"),
        target: provider_cc_fact(producer, entry.id, "cc.target"),
        version: provider_cc_fact(producer, entry.id, "cc.version"),
        abi: provider_cc_fact(producer, entry.id, "cc.abi"),
        compiler: provider_cc_fact(producer, entry.id, "cc.compiler"),
        compiler_sha256: provider_cc_fact(producer, entry.id, "cc.compiler.sha256"),
        cxx: provider_cc_fact(producer, entry.id, "cc.cxx"),
        cxx_sha256: provider_cc_fact(producer, entry.id, "cc.cxx.sha256"),
        linker: provider_cc_fact(producer, entry.id, "cc.linker"),
        linker_sha256: provider_cc_fact(producer, entry.id, "cc.linker.sha256"),
        sysroot: provider_cc_fact(producer, entry.id, "cc.sysroot"),
        sysroot_sha256: provider_cc_fact(producer, entry.id, "cc.sysroot.sha256"),
        bundle_sha256: bundle_sha256,
        layout: layout,
        compiler_root: root,
        cxx_root: root,
        linker_root: root,
        sysroot_root: root,
        mounts: [CcMount]{provider_cc_fixture_mount(root, bundle_sha256)},
        references: entry.references,
        envelope: entry.envelope,
        producer: producer
    }
    if layout == CcToolchainLayout.Pack {
        pack_root: provider_cc_checked_object_digest_path(hangar, provider_cc_fact(producer, entry.id, "cc.compiler.root.sha256"), "C toolchain pack")
        descriptor = provider_cc_pack_descriptor(entry.id, root, pack_root, entry.references, entry.envelope, producer)
    }
    provider_cc_validate_descriptor(descriptor, entry, hangar)
    if entry.cache_identity.source_fingerprint != descriptor.source_fingerprint() {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` has a cache source identity mismatch"))
    }
    if entry.cache_identity.recipe_fingerprint != pkg_sha256_hex(CC_TOOLCHAIN_RECIPE_ID.bytes()) {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` has a cache recipe identity mismatch"))
    }
    if descriptor.producer.source_digest != descriptor.bundle_sha256 {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` has a source digest mismatch"))
    }
    descriptor.producer = ProducerRecord.decode(entry.producer_record) ?? {
        return Err(CcToolchainError.Invalid("could not re-read C toolchain producer record: {err.message()}"))
    }
    Ok(descriptor)
}

// `<hangar>/objects/<digest>`: a real file or directory that canonicalizes
// inside the object pool under its own digest name.
provider_cc_checked_object_digest_path: fn(hangar_root: String, digest: String, label: String) -[FS, Env]> String CcToolchainError! {
    provider_cc_validate_tree_digest(digest, "{label} digest")
    hangar: files.canonicalize(hangar_root) ?? {
        return Err(CcToolchainError.Invalid("canonicalize Hangar root: {err}"))
    }
    objects: files.join(hangar, "objects")
    path: files.join(objects, digest)
    metadata: files.stat(path) ?? {
        return Err(CcToolchainError.Invalid("Hangar C toolchain {label} is unavailable: {err}"))
    }
    if metadata.is_symlink || (!metadata.is_file && !metadata.is_dir) {
        return Err(CcToolchainError.Invalid("Hangar C toolchain {label} is not a regular object"))
    }
    canonical: files.canonicalize(path) ?? {
        return Err(CcToolchainError.Invalid("canonicalize Hangar C toolchain {label}: {err}"))
    }
    if !provider_cc_path_within(canonical, objects) || files.basename(canonical) != digest {
        return Err(CcToolchainError.Invalid("Hangar C toolchain {label} escapes the object pool"))
    }
    Ok(canonical)
}

// `Path::starts_with`: `path` is `base` or lies below it.
provider_cc_path_within: fn(path: String, base: String) -> Bool Never! {
    if path == base -> return true
    prefix: if base.ends_with("/") -> base else -> "{base}/"
    path.starts_with(prefix)
}

// Every descriptor field, digest, envelope, and payload byte is re-proved
// before a Hangar descriptor is used.
provider_cc_validate_descriptor: fn(descriptor: CcToolchainDescriptor, entry: StoreEntry, hangar_root: String) CcToolchainError! -[FS, Env]> {
    host: provider_cc_toolchain_host_target_triple()
    if descriptor.host != host {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` targets host `{descriptor.host}`, but this machine is `{host}`"))
    }
    provider_cc_normalize_target(descriptor.target)
    provider_cc_validate_text_field(descriptor.version, "version") ?? {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` has an invalid {err.message()}"))
    }
    provider_cc_validate_text_field(descriptor.abi, "ABI") ?? {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` has an invalid {err.message()}"))
    }
    paths: [(name: String, path: String)]{
        (name: "compiler", path: descriptor.compiler),
        (name: "c++ compiler", path: descriptor.cxx),
        (name: "linker", path: descriptor.linker),
        (name: "sysroot", path: descriptor.sysroot)
    }
    loop item in paths {
        provider_cc_validate_relative_path(item.path) ?? {
            return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` {item.name}: {err.message()}"))
        }
    }
    provider_cc_validate_sha256(descriptor.compiler_sha256, "compiler digest")
    provider_cc_validate_sha256(descriptor.cxx_sha256, "C++ compiler digest")
    provider_cc_validate_sha256(descriptor.linker_sha256, "linker digest")
    provider_cc_validate_tree_digest(descriptor.sysroot_sha256, "sysroot digest")
    provider_cc_validate_tree_digest(descriptor.bundle_sha256, "bundle digest")
    platform: pkg_host_platform()
    if entry.envelope.output_hash != descriptor.bundle_sha256 || entry.envelope.platform != platform || entry.cache_identity.platform != platform {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` has an envelope/platform identity mismatch"))
    }
    actual_bundle: pkg_try_output_hash_of_in_hangar(entry.out, hangar_root, false) ?? {
        return Err(CcToolchainError.Invalid(err.message()))
    }
    if actual_bundle != descriptor.bundle_sha256 {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` bundle digest changed: expected {descriptor.bundle_sha256}, got {actual_bundle}"))
    }
    if descriptor.layout == {
        .Fixture -> provider_cc_validate_fixture_roots(descriptor, entry.id)
        .Pack -> provider_cc_validate_pack_roots(descriptor, entry.id, hangar_root)
    }
}

// A fixture bundle is one directory: every role root is the descriptor root
// and its single mount carries the bundle digest.
provider_cc_validate_fixture_roots: fn(descriptor: CcToolchainDescriptor, entry_id: String) CcToolchainError! -[FS, Env]> {
    root: descriptor.root
    if descriptor.compiler_root != root || descriptor.cxx_root != root || descriptor.linker_root != root || descriptor.sysroot_root != root {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry_id}` has inconsistent fixture roots"))
    }
    if descriptor.mounts.len() != 1 || descriptor.mounts[0].source != root || descriptor.mounts[0].digest != descriptor.bundle_sha256 {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry_id}` has an invalid fixture mount"))
    }
    provider_cc_verify_file(root, descriptor.compiler, descriptor.compiler_sha256, "compiler")
    provider_cc_verify_file(root, descriptor.cxx, descriptor.cxx_sha256, "C++ compiler")
    provider_cc_verify_file(root, descriptor.linker, descriptor.linker_sha256, "linker")
    provider_cc_verify_tree(root, descriptor.sysroot, descriptor.sysroot_sha256, "sysroot")
}

// A pack-layout toolchain mounts its pack object (compiler, C++ driver,
// linker and their resources) as the compiler role and its own sysroot as the
// sysroot role; the entry must reference the pack so it stays alive.
provider_cc_validate_pack_roots: fn(descriptor: CcToolchainDescriptor, entry_id: String, hangar_root: String) CcToolchainError! -[FS, Env]> {
    if descriptor.mounts.len() != 2 || descriptor.cxx_root != descriptor.compiler_root || descriptor.linker_root != descriptor.compiler_root {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry_id}` has inconsistent pack roots"))
    }
    pack: descriptor.mounts[0]
    sysroot: descriptor.mounts[1]
    expected_pack: provider_cc_checked_object_digest_path(hangar_root, pack.digest, "C toolchain pack")
    if expected_pack != descriptor.compiler_root || pack.source != expected_pack || pack.destination != descriptor.role_virtual_root(CcToolchainRole.Compiler) {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry_id}` has an invalid pack mount"))
    }
    if !descriptor.references.contains(pack.digest) {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry_id}` does not reference its toolchain pack"))
    }
    if descriptor.sysroot_root != files.join(descriptor.root, descriptor.sysroot) || sysroot.source != descriptor.sysroot_root || sysroot.digest != descriptor.sysroot_sha256 || sysroot.destination != descriptor.role_virtual_root(CcToolchainRole.Sysroot) {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry_id}` has an invalid sysroot mount"))
    }
    provider_cc_verify_file(descriptor.compiler_root, descriptor.compiler, descriptor.compiler_sha256, "compiler")
    if descriptor.cxx != descriptor.compiler || descriptor.cxx_sha256 != descriptor.compiler_sha256 {
        provider_cc_verify_file(descriptor.cxx_root, descriptor.cxx, descriptor.cxx_sha256, "C++ compiler")
    }
    provider_cc_verify_file(descriptor.linker_root, descriptor.linker, descriptor.linker_sha256, "linker")
    sysroot_metadata: files.stat(descriptor.sysroot_root) ?? {
        return Err(CcToolchainError.Invalid("C toolchain sysroot is unavailable: {err}"))
    }
    if sysroot_metadata.is_symlink || !sysroot_metadata.is_dir {
        return Err(CcToolchainError.Invalid("C toolchain sysroot is not a real directory"))
    }
    actual_sysroot: pkg_try_output_hash_of_in_hangar(descriptor.sysroot_root, hangar_root, false) ?? {
        return Err(CcToolchainError.Invalid(err.message()))
    }
    if actual_sysroot != descriptor.sysroot_sha256 {
        return Err(CcToolchainError.Invalid("C toolchain sysroot digest mismatch: expected {descriptor.sysroot_sha256}, got {actual_sysroot}"))
    }
}

// The entry output: a real directory that canonicalizes strictly inside the
// Hangar root.
provider_cc_checked_entry_root: fn(hangar_root: String, entry: StoreEntry) -[FS, Env]> String CcToolchainError! {
    metadata: files.stat(entry.out) ?? {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` output is unavailable: {err}"))
    }
    if metadata.is_symlink || !metadata.is_dir {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` output is not a real directory"))
    }
    hangar: files.canonicalize(hangar_root) ?? {
        return Err(CcToolchainError.Invalid("could not canonicalize Hangar root: {err}"))
    }
    root: files.canonicalize(entry.out) ?? {
        return Err(CcToolchainError.Invalid("could not canonicalize C toolchain output: {err}"))
    }
    if !provider_cc_path_within(root, hangar) || root == hangar {
        return Err(CcToolchainError.Invalid("Hangar C toolchain `{entry.id}` output escapes the Hangar root"))
    }
    Ok(root)
}

// A non-empty regular file under `root` (no symlink on the way) whose
// SHA-256 is `expected`.
provider_cc_verify_file: fn(root: String, relative: String, expected: String, label: String) CcToolchainError! -[FS]> {
    path: provider_cc_checked_relative_path(root, relative, label)
    metadata: files.stat(path) ?? {
        return Err(CcToolchainError.Invalid("C toolchain {label} is unavailable: {err}"))
    }
    if metadata.is_symlink || !metadata.is_file || metadata.size == 0 {
        return Err(CcToolchainError.Invalid("C toolchain {label} is not a non-empty regular file"))
    }
    actual: foundation_sha256_file_hex(path) ?? {
        return Err(CcToolchainError.Invalid("could not hash C toolchain {label}: {err}"))
    }
    if actual != expected {
        return Err(CcToolchainError.Invalid("C toolchain {label} digest mismatch: expected {expected}, got {actual}"))
    }
}

// A real directory under `root` whose Hangar tree digest is `expected`.
provider_cc_verify_tree: fn(root: String, relative: String, expected: String, label: String) CcToolchainError! -[FS, Env]> {
    path: provider_cc_checked_relative_path(root, relative, label)
    metadata: files.stat(path) ?? {
        return Err(CcToolchainError.Invalid("C toolchain {label} is unavailable: {err}"))
    }
    if metadata.is_symlink || !metadata.is_dir {
        return Err(CcToolchainError.Invalid("C toolchain {label} is not a real directory"))
    }
    actual: pkg_try_output_hash_of(path) ?? {
        return Err(CcToolchainError.Invalid("could not hash C toolchain {label}: {err.message()}"))
    }
    if actual != expected {
        return Err(CcToolchainError.Invalid("C toolchain {label} digest mismatch: expected {expected}, got {actual}"))
    }
}

// `root` joined with a normalized relative path, refusing any symlink on the
// way down.
provider_cc_checked_relative_path: fn(root: String, relative: String, label: String) -[FS]> String CcToolchainError! {
    provider_cc_validate_relative_path(relative) ?? {
        return Err(CcToolchainError.Invalid("C toolchain {label} path: {err.message()}"))
    }
    current := root
    parts: provider_cc_path_parts(relative)
    loop part in parts {
        current = files.join(current, part)
        metadata: files.stat(current) ?? {
            return Err(CcToolchainError.Invalid("C toolchain {label} path is unavailable: {err}"))
        }
        if metadata.is_symlink -> return Err(CcToolchainError.Invalid("C toolchain {label} path traverses a symlink"))
    }
    Ok(current)
}

// A regular (non-symlink) file of at most `limit` bytes, read through a
// bounded reader so a growing file cannot exceed the limit in memory.
provider_cc_read_bounded_file: fn(path: String, limit: Int, label: String) -[FS]> [U8] CcToolchainError! {
    metadata: files.stat(path) ?? {
        return Err(CcToolchainError.Invalid("read {label}: {err}"))
    }
    if metadata.is_symlink || !metadata.is_file -> return Err(CcToolchainError.Invalid("{label} is not a regular file"))
    if metadata.size > limit -> return Err(CcToolchainError.Invalid("{label} exceeds its size limit"))
    reader := files.open(path, links: .Refuse) ?? {
        return Err(CcToolchainError.Invalid("read {label}: {err}"))
    }
    bytes := [U8]{}
    loop {
        chunk: reader.read(limit + 1 - bytes.len()) ?? {
            return Err(CcToolchainError.Invalid("read {label}: {err}"))
        }
        if chunk.len() == 0 -> break
        loop byte in chunk -> bytes.push(byte)
        if bytes.len() > limit -> return Err(CcToolchainError.Invalid("{label} exceeds its size limit"))
    }
    Ok(bytes)
}
