// The C toolchain pack. Each jet release publishes
// one pack per host: static clang, lld and llvm-ar, compiler-rt for every
// covered target, the musl sources and headers, and glibc headers with link
// stubs. Tools/agent/cc-pack.nix builds it reproducibly from pinned sources
// and Tools/release `admit` checks its SHA-256 against CC_PACK_ASSETS below,
// so the hash lives in jet and updating jet updates the pack.
//
// `jet cc` takes the pack from the Hangar when it is there (no network),
// else from beside the running jetpack (the combined jet+pack archive), else
// from `JET_CC_PACK_URL` when it is set, else from this jet's release. Every
// copy is hashed before use; a wrong hash is refused and deleted. Per-target
// libc is built lazily: glibc targets copy the pack's headers and stubs, musl
// targets compile libc.a with the pack's own clang the first time they are
// used. A library beyond libc, including the C++ standard library, is a
// package dependency, never part of the pack.

CC_PACK_PACKAGE: "cc-toolchain-pack"
CC_PACK_LAYOUT: "pack-tools-v1"
CC_TOOLCHAIN_PACK_LAYOUT: "pack-v1"
CC_PACK_RECIPE_ID: "jet-cc-pack-v1"
CC_PACK_MANIFEST: "jet-cc-pack.json"
CC_PACK_RELEASE_FILE: "RELEASE"
CC_PACK_RELEASE_BASE: "https://github.com/jet-language/jet/releases/download"
CC_PACK_URL_ENV: "JET_CC_PACK_URL"
CC_PACK_CLANG: "bin/clang"
CC_PACK_LLD: "bin/ld.lld"
CC_PACK_AR: "bin/llvm-ar"
CC_PACK_RESOURCE_DIR: "lib/clang/21"
CC_PACK_MAX_ENTRIES: 100000
CC_PACK_MAX_UNPACKED_BYTES: 4294967296
CC_PACK_MAX_MANIFEST_BYTES: 65536
CC_PACK_MAX_RELEASE_BYTES: 256
CC_PACK_MAX_SOURCE_LIST_BYTES: 1048576
CC_PACK_MAX_REPORTED_BYTES: 4096
CC_PACK_FETCH_TIMEOUT_MS: 3600000
CC_PACK_READ_CHUNK: 1048576
CC_PACK_EMPTY_ARCHIVE: "!<arch>\n"
CC_PACK_MUSL_CRT: [String]{"crt1", "Scrt1", "rcrt1", "crti", "crtn"}
CC_PACK_MUSL_EMPTY_LIBS: [String]{"m", "rt", "pthread", "crypt", "util", "xnet", "resolv", "dl"}

// One published pack: the host it runs on (target triple and Nix system),
// its release asset name, and the exact bytes jet accepts. `platform` is the
// `<os>-<arch>` spelling of the release archives.
CcPackAsset: struct {
    host: String
    system: String
    platform: String
    file: String
    sha256: String
    size: Int
}

CC_PACK_ASSETS: comptime { [CcPackAsset]{
    {
        host: "x86_64-unknown-linux-gnu",
        system: "x86_64-linux",
        platform: "linux-x64",
        file: "jet-cc-pack-x86_64-linux.tar.zst",
        sha256: "7c991b6c41e2ed9b41b34bfe84c0a241df60b25d91f73c58b3ad70494e3ecef3",
        size: 111338169
    }
} }

// One target every pack covers: its canonical triple, the short spelling
// `--target` also accepts, its architecture, its libc, and the dynamic
// loader a glibc program names (musl programs link statically, so none).
// The pack's clang is Nix's, which adds no loader of its own.
CcPackTarget: struct {
    triple: String
    short: String
    arch: String
    libc: String
    loader: String

    abi: fn(self) -> String Never! {
        if self.libc == "glibc" -> return "gnu"
        "musl"
    }
}

CC_PACK_TARGETS: comptime { [CcPackTarget]{
    {triple: "x86_64-unknown-linux-gnu", short: "x86_64-linux-gnu", arch: "x86_64", libc: "glibc", loader: "/lib64/ld-linux-x86-64.so.2"},
    {triple: "aarch64-unknown-linux-gnu", short: "aarch64-linux-gnu", arch: "aarch64", libc: "glibc", loader: "/lib/ld-linux-aarch64.so.1"},
    {triple: "x86_64-unknown-linux-musl", short: "x86_64-linux-musl", arch: "x86_64", libc: "musl", loader: ""},
    {triple: "aarch64-unknown-linux-musl", short: "aarch64-linux-musl", arch: "aarch64", libc: "musl", loader: ""}
} }

// The versions a pack manifest records.
CcPackManifest: struct {
    llvm: String
    musl: String
    glibc: String
}

// A verified pack in the Hangar: its object digest and root, the asset it
// came from, and the digests of the tools the target entries mount.
CcPackTools: struct {
    digest: String
    root: String
    asset: CcPackAsset
    manifest: CcPackManifest
    clang_sha256: String
    lld_sha256: String
    ar_sha256: String
}

// Where a missing pack may come from: the directory of the running jetpack
// (a combined archive puts the pack there, and the seed's RELEASE file names
// the release), the pack URL `JET_CC_PACK_URL` names (`https://` or
// `file://`), and the base URL of release downloads.
CcPackSources: struct {
    beside: String?
    url: String?
    release_base: String
}

// The covered target spelled `target` (canonical or short), if any.
provider_cc_pack_target: fn(target: String) -> CcPackTarget? Never! {
    loop entry in CC_PACK_TARGETS {
        if entry.triple == target || entry.short == target -> return Val(entry)
    }
    None
}

// Every covered target, short spelling first.
provider_cc_pack_covered_targets: fn() -> String Never! {
    names := [String]{}
    loop entry in CC_PACK_TARGETS -> names.push("{entry.short} ({entry.triple})")
    names.join(", ")
}

// The covered target `target` selects, or the typed miss naming the
// covered targets.
provider_cc_pack_covered_target: fn(target: String) -[Env]> CcPackTarget CcToolchainError! {
    normalized: provider_cc_normalize_target(target)
    provider_cc_pack_target(normalized) ?? return Err(CcToolchainError.UncoveredTarget(normalized))
}

// The pack this jet embeds for the machine it runs on.
provider_cc_pack_asset_for_host: fn() -[Env]> CcPackAsset CcToolchainError! {
    host: provider_cc_toolchain_host_target_triple()
    hosts := [String]{}
    loop asset in CC_PACK_ASSETS {
        if asset.host == host -> return Ok(asset)
        hosts.push(asset.host)
    }
    Err(CcToolchainError.Invalid("jet ships no C toolchain pack for host `{host}`; packs exist for {hosts.join(", ")}"))
}

// Whether a target entry was built from the pack this jet embeds.
provider_cc_pack_is_current: fn(producer: ProducerRecord) -[Env]> Bool Never! {
    asset: provider_cc_pack_asset_for_host() ?? return false
    (producer.facts.get("cc.pack.sha256") ?? "") == asset.sha256
}

provider_cc_pack_immutable_source: fn(asset: CcPackAsset) -> String Never! {
    "jet-release:{asset.file}#sha256={asset.sha256}"
}

// The running jetpack's directory, `JET_CC_PACK_URL`, and the public
// release downloads.
provider_cc_pack_default_sources: fn() -[Env]> CcPackSources Never! {
    executable: sys.executable()
    beside: if executable == "" -> String?{None} else -> Val(files.dirname(executable))
    configured: sys.get(CC_PACK_URL_ENV) ?? ""
    url: if configured == "" -> String?{None} else -> Val(configured)
    CcPackSources{beside: beside, url: url, release_base: CC_PACK_RELEASE_BASE}
}

// The release this jet came from: the seed's one-line RELEASE file.
provider_cc_pack_release_name: fn(sources: CcPackSources) -[FS]> String? Never! {
    dir: sources.beside ?? return None
    bytes: provider_cc_read_bounded_file(files.join(dir, CC_PACK_RELEASE_FILE), CC_PACK_MAX_RELEASE_BYTES, "jet release name") ?? return None
    text: String.from_bytes(bytes) ?? return None
    name: text.trim()
    if !provider_cc_is_target_token(name) -> return None
    Val(name)
}

// The two ways to get a pack without downloading it now.
provider_cc_pack_fixes: fn(asset: CcPackAsset, release: String?) -> String Never! {
    combined: if release == {
        .Val(name) -> "`jet-{name}-{asset.platform}-cc.tar.gz`"
        .None -> "the release archive ending in `-{asset.platform}-cc.tar.gz`"
    }
    "run `jet env fetch-toolchain` while online, or install jet from {combined}, the release archive that carries jet and the pack together"
}

// The verified pack in the Hangar; a missing pack is fetched, verified,
// unpacked and recorded first. A Hangar hit never touches the network.
provider_cc_pack_ensure: fn(verification: &StoreVerification, roots: HangarRoots, asset: CcPackAsset, sources: CcPackSources, offline: Bool) -[IO, FS, Env, Net, Time, Time.Wait]> CcPackTools ProviderError! {
    found := CcPackTools?{None}
    if provider_cc_pack_lookup(verification, roots, asset) == {
        .Ok(value) -> found = value
        .Err(error) -> return Err(ProviderError.BadOutput(error.message()))
    }
    if found == .Val(tools) -> return Ok(tools)
    hangar: roots.hangar_dir()
    provider_cc_ensure_real_directory(hangar) ?? return Err(ProviderError.BadOutput(err.message()))
    stem: ".{CC_PACK_PACKAGE}-{provider_cc_pack_short(asset.sha256)}-{process.current_pid()}"
    archive: files.join(hangar, "{stem}.tar.zst.partial")
    staging: files.join(hangar, "{stem}.partial")
    provider_cc_remove_tree(archive)
    provider_cc_remove_tree(staging)
    unpack := CcPackArchive{path: "", origin: ""}
    if provider_cc_pack_obtain(asset, sources, offline, archive) == {
        .Ok(obtained) -> unpack = obtained
        .Err(error) -> {
            provider_cc_remove_tree(archive)
            return Err(error)
        }
    }
    term.eprint("first use: unpacking the C toolchain into the Hangar (first time only)")
    if provider_cc_pack_install(verification, roots, asset, unpack, staging) == {
        .Ok(tools) -> {
            provider_cc_remove_tree(archive)
            Ok(tools)
        }
        .Err(error) -> {
            provider_cc_remove_tree(archive)
            provider_cc_remove_tree(staging)
            Err(ProviderError.BadOutput(error.message()))
        }
    }
}

// The first twelve hex digits of a digest, for private staging names.
provider_cc_pack_short: fn(digest: String) -> String Never! {
    raw: digest.removeprefix("sha256-").bytes()
    pkg_bytes_text(raw, 0, if raw.len() < 12 -> raw.len() else -> 12)
}

// One pack archive to unpack, and where it came from.
CcPackArchive: struct {
    path: String
    origin: String
}

// The pack archive to unpack: the copy beside jetpack, else the
// `JET_CC_PACK_URL` pack, else the release download. A local pack is read
// where it lies; a download lands at `destination`. Install verifies it.
provider_cc_pack_obtain: fn(asset: CcPackAsset, sources: CcPackSources, offline: Bool, destination: String) -[IO, FS, Env, Net, Time.Wait]> CcPackArchive ProviderError! {
    release: provider_cc_pack_release_name(sources)
    if sources.beside == .Val(dir) {
        local: files.join(dir, asset.file)
        if provider_cc_is_regular_file(local) -> return Ok(CcPackArchive{path: local, origin: "`{local}`"})
    }
    if sources.url == .Val(url) -> return provider_cc_pack_fetch(url, asset, release, offline, destination)
    name: release ?? {
        return Err(ProviderError.Unsupported("this jet does not name the release it came from, so its C toolchain pack `{asset.file}` cannot be downloaded; put the pack beside jet, set `{CC_PACK_URL_ENV}` to its URL, or install a released jet from the archive ending in `-{asset.platform}-cc.tar.gz`"))
    }
    provider_cc_pack_fetch("{sources.release_base}/{name}/{asset.file}", asset, release, offline, destination)
}

// The pack at `url`. A `file://` URL is a local file, so it works offline;
// any other URL is downloaded into `destination`.
provider_cc_pack_fetch: fn(url: String, asset: CcPackAsset, release: String?, offline: Bool, destination: String) -[IO, FS, Env, Net, Time.Wait]> CcPackArchive ProviderError! {
    label: if release == {
        .Val(name) -> "jet {name}"
        .None -> "this jet"
    }
    local: url.starts_with("file://")
    if !local && (offline || provider_network_denied()) {
        return Err(ProviderError.Offline("the C toolchain pack for {label} is not in the Hangar and cannot be downloaded offline; {provider_cc_pack_fixes(asset, release)}"))
    }
    term.eprint("first use: fetching the C toolchain for {label} ({terminal_human_size(asset.size)})")
    if local -> return Ok(CcPackArchive{path: url.removeprefix("file://"), origin: url})
    provider_cc_pack_download(url, destination, asset) ?? return Err(ProviderError.BadOutput(err.message()))
    Ok(CcPackArchive{path: destination, origin: url})
}

// Download the pack through the native release client. The file is scratch
// that install verifies and deletes, so it is never flushed.
provider_cc_pack_download: fn(url: String, destination: String, asset: CcPackAsset) CcToolchainError! -[FS, Env, Net, Time.Wait]> {
    response: provider_native_get_within(url, "C toolchain pack", CC_PACK_FETCH_TIMEOUT_MS) ?? return Err(CcToolchainError.Invalid(err.message()))
    output := files.create(destination, if_exists: .Refuse) ?? return Err(CcToolchainError.Invalid("create C toolchain pack staging file: {err}"))
    total := 0
    loop part in response.body().chunks(CC_PACK_READ_CHUNK) {
        chunk: part ?? return Err(CcToolchainError.Invalid("download C toolchain pack: {err}"))
        total += chunk.len()
        if total > asset.size -> return Err(CcToolchainError.Invalid("C toolchain pack at {url} is larger than the {asset.size} bytes this jet expects"))
        output.write_all(chunk) ?? return Err(CcToolchainError.Invalid("write C toolchain pack staging file: {err}"))
    }
}

// The open archive must hash to the embedded SHA-256 within the expected
// size; it is then rewound so the same handle is unpacked.
provider_cc_pack_verify_archive: fn(file: &files.FileReader, asset: CcPackAsset, origin: String) CcToolchainError! -[FS]> {
    hasher := StreamingSHA256.new()
    total := 0
    loop {
        chunk: file.read(CC_PACK_READ_CHUNK) ?? return Err(CcToolchainError.Invalid("read C toolchain pack from {origin}: {err}"))
        if chunk.len() == 0 -> break
        total += chunk.len()
        if total > asset.size -> return Err(CcToolchainError.Invalid("C toolchain pack from {origin} is larger than the {asset.size} bytes this jet expects"))
        hasher.update(chunk)
    }
    actual: hasher.finalize_hex()
    if actual != asset.sha256 {
        return Err(CcToolchainError.PackHashMismatch{origin: origin, expected: asset.sha256, actual: actual})
    }
    file.seek(0) ?? return Err(CcToolchainError.Invalid("rewind C toolchain pack from {origin}: {err}"))
}

// Verify, unpack, seal and record a pack archive as the pack entry. One
// open handle is hashed and then unpacked, so the bytes unpacked are the
// bytes verified.
provider_cc_pack_install: fn(verification: &StoreVerification, roots: HangarRoots, asset: CcPackAsset, archive: CcPackArchive, staging: String) -[FS, Env, Time]> CcPackTools CcToolchainError! {
    file := files.open(archive.path, links: .Refuse) ?? return Err(CcToolchainError.Invalid("open C toolchain pack from {archive.origin}: {err}"))
    provider_cc_pack_verify_archive(file, asset, archive.origin)
    files.create_dir_all(staging) ?? return Err(CcToolchainError.Invalid("create C toolchain pack staging directory: {err}"))
    provider_cc_pack_untar(file, staging)
    manifest: provider_cc_pack_read_manifest(staging, asset)
    // Untar creates only fresh regular files and directories in private
    // staging, so no hardlink lets the seal reach outside it, and the tree
    // is sealed before its one canonical hash.
    store_seal_node(staging) ?? return Err(CcToolchainError.Invalid("seal C toolchain pack: {err.message()}"))
    digests: provider_cc_pack_digests(staging)
    digest: digests.tree
    clang_sha256: provider_cc_pack_tool_sha256(staging, CC_PACK_CLANG, digests.files)
    lld_sha256: provider_cc_pack_tool_sha256(staging, CC_PACK_LLD, digests.files)
    ar_sha256: provider_cc_pack_tool_sha256(staging, CC_PACK_AR, digests.files)
    // Store registration and publication reuse these digests instead of
    // reading the tree again.
    store_remember_output_digest(verification, staging, None, false, digest) ?? return Err(CcToolchainError.Invalid("remember C toolchain pack digest: {err.message()}"))
    loop path in digests.files.keys() {
        store_remember_content_digest(verification, path, digests.files[path]) ?? return Err(CcToolchainError.Invalid("remember C toolchain pack file digest: {err.message()}"))
    }
    facts: [String: String]{
        "cc.schema": CC_TOOLCHAIN_SCHEMA,
        "cc.producer": CC_TOOLCHAIN_PRODUCER,
        "cc.layout": CC_PACK_LAYOUT,
        "cc.host": asset.host,
        "cc.pack.file": asset.file,
        "cc.pack.sha256": asset.sha256,
        "cc.pack.llvm": manifest.llvm,
        "cc.pack.musl": manifest.musl,
        "cc.pack.glibc": manifest.glibc,
        "cc.pack.clang.sha256": clang_sha256,
        "cc.pack.lld.sha256": lld_sha256,
        "cc.pack.ar.sha256": ar_sha256,
        "cache.output": digest
    }
    plan: ProviderPlanFacts.from_facts([String: String]{
        "action.kind": "cc-toolchain-pack-install",
        "action.recipe": CC_PACK_RECIPE_ID
    }) ?? return Err(CcToolchainError.Invalid(err.message()))
    source: provider_cc_pack_immutable_source(asset)
    producer: ProducerRecord.new(CC_TOOLCHAIN_PRODUCER, source, digest, plan, CC_PACK_RECIPE_ID, "policy=content-addressed\nplatform=host", facts) ?? return Err(CcToolchainError.Invalid(err.message()))
    reference: "{CC_PACK_PACKAGE}@{CC_TOOLCHAIN_SOURCE}"
    realized := Realized{
        name: CC_PACK_PACKAGE,
        version: manifest.llvm,
        reference: reference,
        out: staging,
        bin: files.join(staging, "bin"),
        rlib: "",
        envelope: Envelope{output_hash: digest, platform: pkg_host_platform(), signature: "", provenance: "{reference} via {CC_PACK_RECIPE_ID}"},
        cache_identity: CacheIdentity{
            source_fingerprint: source,
            recipe_fingerprint: pkg_sha256_hex(CC_PACK_RECIPE_ID.bytes()),
            policy_fingerprint: env_cache_policy_fingerprint(false),
            platform: pkg_host_platform()
        },
        source_state: SourceState.Downloaded,
        named_outputs: [String: String]{"out": staging},
        references: [String]{},
        producer: producer
    }
    provider_refresh_provider_facts(realized.producer, reference) ?? return Err(CcToolchainError.Invalid(err.message()))
    store_record_realized_mode(verification, roots, realized) ?? return Err(CcToolchainError.Invalid("record C toolchain pack in the Hangar: {err.message()}"))
    root: provider_cc_checked_object_digest_path(roots.hangar_dir(), digest, "C toolchain pack")
    Ok(CcPackTools{digest: digest, root: root, asset: asset, manifest: manifest, clang_sha256: clang_sha256, lld_sha256: lld_sha256, ar_sha256: ar_sha256})
}

// The pack tree's canonical digest and every file's content SHA-256.
CcPackDigests: struct {
    tree: String
    files: [String: String]
}

// Hash the pack tree and each of its files on worker tasks at once.
provider_cc_pack_digests: fn(staging: String) -[FS, Env]> CcPackDigests CcToolchainError! {
    paths := [String]{}
    sizes := [Int]{}
    provider_cc_pack_collect_files(staging, paths, sizes)
    hashed: store_hash_tree_and_files(staging, paths, sizes) ?? return Err(CcToolchainError.Invalid("hash C toolchain pack: {err.message()}"))
    file_digests := [String: String]{}
    loop index in 0..<paths.len() -> file_digests[paths[index]] = hashed.files[index]
    Ok(CcPackDigests{tree: hashed.tree, files: file_digests})
}

// Every regular file below `path`, with its size.
provider_cc_pack_collect_files: fn(path: String, paths: &[String], sizes: &[Int]) CcToolchainError! -[FS]> {
    entries: files.list_dir(path) ?? return Err(CcToolchainError.Invalid("list C toolchain pack directory `{path}`: {err}"))
    loop entry in entries {
        info: files.stat(entry.path) ?? return Err(CcToolchainError.Invalid("inspect C toolchain pack entry `{entry.path}`: {err}"))
        if info.is_symlink -> next
        if info.is_dir {
            provider_cc_pack_collect_files(entry.path, paths, sizes)
        } else if info.is_file {
            paths.push(entry.path)
            sizes.push(info.size)
        }
    }
}

// The SHA-256 of one non-empty pack tool, taken from the pack's file digests.
provider_cc_pack_tool_sha256: fn(root: String, relative: String, digests: [String: String]) -[FS]> String CcToolchainError! {
    path: provider_cc_checked_relative_path(root, relative, "pack tool `{relative}`")
    metadata: files.stat(path) ?? return Err(CcToolchainError.Invalid("C toolchain pack tool `{relative}` is unavailable: {err}"))
    if metadata.is_symlink || !metadata.is_file || metadata.size == 0 {
        return Err(CcToolchainError.Invalid("C toolchain pack tool `{relative}` is not a non-empty regular file"))
    }
    digests.get(path) ?? return Err(CcToolchainError.Invalid("C toolchain pack tool `{relative}` was not hashed"))
}

// The recorded pack for `asset`, re-proved, or None when the Hangar has none.
provider_cc_pack_lookup: fn(verification: &StoreVerification, roots: HangarRoots, asset: CcPackAsset) -[FS, Env, Time]> CcPackTools? CcToolchainError! {
    if !provider_cc_node_exists(roots.hangar_dir()) -> return Ok(None)
    entries: store_list_checked(verification, roots) ?? return Err(CcToolchainError.Invalid("could not inspect Hangar C toolchain packs: {err.message()}"))
    loop entry in entries {
        if entry.name != CC_PACK_PACKAGE -> next
        producer: ProducerRecord.decode(entry.producer_record) ?? {
            return Err(CcToolchainError.Invalid("Hangar C toolchain pack `{entry.id}` has an invalid producer record: {err.message()}"))
        }
        if producer.provider != CC_TOOLCHAIN_PRODUCER || (producer.facts.get("cc.layout") ?? "") != CC_PACK_LAYOUT -> next
        if (producer.facts.get("cc.pack.sha256") ?? "") != asset.sha256 -> next
        return Ok(Val(provider_cc_pack_tools_from_entry(roots, entry, producer, asset)))
    }
    Ok(None)
}

// A recorded pack's tools, each re-hashed against its producer fact.
provider_cc_pack_tools_from_entry: fn(roots: HangarRoots, entry: StoreEntry, producer: ProducerRecord, asset: CcPackAsset) -[FS, Env]> CcPackTools CcToolchainError! {
    hangar: roots.hangar_dir()
    digest: entry.envelope.output_hash
    root: provider_cc_checked_object_digest_path(hangar, digest, "C toolchain pack")
    if provider_cc_checked_entry_root(hangar, entry) != root {
        return Err(CcToolchainError.Invalid("Hangar C toolchain pack `{entry.id}` is not its content-addressed object"))
    }
    if producer.source_digest != digest || producer.immutable_source != provider_cc_pack_immutable_source(asset) {
        return Err(CcToolchainError.Invalid("Hangar C toolchain pack `{entry.id}` has a source identity mismatch"))
    }
    manifest: CcPackManifest{
        llvm: provider_cc_fact(producer, entry.id, "cc.pack.llvm"),
        musl: provider_cc_fact(producer, entry.id, "cc.pack.musl"),
        glibc: provider_cc_fact(producer, entry.id, "cc.pack.glibc")
    }
    clang_sha256: provider_cc_fact(producer, entry.id, "cc.pack.clang.sha256")
    lld_sha256: provider_cc_fact(producer, entry.id, "cc.pack.lld.sha256")
    ar_sha256: provider_cc_fact(producer, entry.id, "cc.pack.ar.sha256")
    provider_cc_verify_file(root, CC_PACK_CLANG, clang_sha256, "pack clang")
    provider_cc_verify_file(root, CC_PACK_LLD, lld_sha256, "pack lld")
    provider_cc_verify_file(root, CC_PACK_AR, ar_sha256, "pack llvm-ar")
    Ok(CcPackTools{digest: digest, root: root, asset: asset, manifest: manifest, clang_sha256: clang_sha256, lld_sha256: lld_sha256, ar_sha256: ar_sha256})
}

// The pack manifest: schema 1, this asset's host, and every covered target.
provider_cc_pack_read_manifest: fn(root: String, asset: CcPackAsset) -[FS, Env]> CcPackManifest CcToolchainError! {
    bytes: provider_cc_read_bounded_file(files.join(root, CC_PACK_MANIFEST), CC_PACK_MAX_MANIFEST_BYTES, "C toolchain pack manifest")
    text: String.from_bytes(bytes) ?? return Err(CcToolchainError.Invalid("C toolchain pack manifest is not UTF-8"))
    value: json.parse(text) ?? return Err(CcToolchainError.Invalid("parse C toolchain pack manifest: {err.reason}"))
    object: provider_cc_manifest_object(value) ?? return Err(CcToolchainError.Invalid("C toolchain pack manifest: expected a Dyn object"))
    if provider_cc_manifest_number(object, "schema") != 1 -> return Err(CcToolchainError.Invalid("C toolchain pack manifest has an unsupported schema"))
    host: provider_cc_manifest_string(object, "host")
    if host != asset.system -> return Err(CcToolchainError.Invalid("C toolchain pack is for `{host}`, but this jet expects `{asset.system}`"))
    manifest: CcPackManifest{
        llvm: provider_cc_manifest_string(object, "llvm"),
        musl: provider_cc_manifest_string(object, "musl"),
        glibc: provider_cc_manifest_string(object, "glibc")
    }
    provider_cc_validate_text_field(manifest.llvm, "pack LLVM version")
    provider_cc_validate_text_field(manifest.musl, "pack musl version")
    provider_cc_validate_text_field(manifest.glibc, "pack glibc version")
    listed := [String]{}
    targets: object.get("targets") ?? return Err(CcToolchainError.Invalid("C toolchain pack manifest misses `targets`"))
    if targets == {
        .Array(items) -> {
            loop item in items {
                fields: provider_cc_manifest_object(item) ?? return Err(CcToolchainError.Invalid("C toolchain pack manifest target: expected a Dyn object"))
                listed.push(provider_cc_manifest_string(fields, "triple"))
            }
        }
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> return Err(CcToolchainError.Invalid("C toolchain pack manifest field `targets`: expected a Dyn array"))
    }
    loop target in CC_PACK_TARGETS {
        if !listed.contains(target.triple) -> return Err(CcToolchainError.Invalid("C toolchain pack does not cover `{target.triple}`"))
    }
    Ok(manifest)
}

// The decompressed tar stream of a pack, buffered one chunk at a time.
CcPackTarStream: struct {
    reader: zstd.ZstdReader
    buffer: [U8]
    at: Int

    // At least `need` unread bytes buffered; false at the end of the stream.
    fill: fn(&self, need: Int) -[FS.Read]> Bool CcToolchainError! {
        loop self.buffer.len() - self.at < need {
            chunk: self.reader.read(CC_PACK_READ_CHUNK) ?? return Err(CcToolchainError.Invalid("decompress C toolchain pack: {err}"))
            if chunk.len() == 0 -> return Ok(false)
            rest := self.buffer.slice(self.at, self.buffer.len())
            rest.extend(chunk)
            self.buffer = rest
            self.at = 0
        }
        Ok(true)
    }

    // The next `count` bytes.
    next_bytes: fn(&self, count: Int) -[FS.Read]> [U8] CcToolchainError! {
        if !(self.fill(count)) -> return Err(CcToolchainError.Invalid("C toolchain pack archive is truncated"))
        out: self.buffer.slice(self.at, self.at + count)
        self.at += count
        Ok(out)
    }

    // Drop the next `count` bytes.
    skip: fn(&self, count: Int) CcToolchainError! -[FS.Read]> {
        remaining := count
        loop remaining > 0 {
            if !(self.fill(1)) -> return Err(CcToolchainError.Invalid("C toolchain pack archive is truncated"))
            available: self.buffer.len() - self.at
            step: if available < remaining -> available else -> remaining
            self.at += step
            remaining -= step
        }
    }

    // Write the next `count` bytes to a new file at `path`.
    copy_to: fn(&self, path: String, count: Int) CcToolchainError! -[FS]> {
        output := files.create(path, if_exists: .Refuse) ?? return Err(CcToolchainError.Invalid("create `{path}`: {err}"))
        remaining := count
        loop remaining > 0 {
            if !(self.fill(1)) -> return Err(CcToolchainError.Invalid("C toolchain pack archive is truncated"))
            available: self.buffer.len() - self.at
            step: if available < remaining -> available else -> remaining
            output.write_all(self.buffer.slice(self.at, self.at + step)) ?? return Err(CcToolchainError.Invalid("write `{path}`: {err}"))
            self.at += step
            remaining -= step
        }
    }
}

// Unpack the regular files and directories of a pack archive below
// `destination`, within the entry and byte limits.
provider_cc_pack_untar: fn(&&file: files.FileReader, destination: String) CcToolchainError! -[FS]> {
    stream := CcPackTarStream{reader: zstd.reader(file), buffer: [U8]{}, at: 0}
    entries := 0
    unpacked := 0
    loop {
        header: stream.next_bytes(PROVIDER_TAR_BLOCK)
        if provider_registry_tar_zero(header) -> break
        if !provider_registry_tar_checksum_valid(header) -> return Err(CcToolchainError.Invalid("C toolchain pack has a damaged tar header"))
        raw_name: provider_registry_tar_header_name(header) ?? return Err(CcToolchainError.Invalid(err.message()))
        size: provider_registry_tar_number(header[124..<136]) ?? return Err(CcToolchainError.Invalid(err.message()))
        mode: provider_registry_tar_number(header[100..<108]) ?? return Err(CcToolchainError.Invalid(err.message()))
        kind: provider_registry_tar_kind(Int.from_u8(header[156]), raw_name)
        padding: (PROVIDER_TAR_BLOCK - size % PROVIDER_TAR_BLOCK) % PROVIDER_TAR_BLOCK
        name: raw_name.removeprefix("./")
        if name == "" || name == "." {
            stream.skip(size + padding)
            next
        }
        entries += 1
        if entries > CC_PACK_MAX_ENTRIES -> return Err(CcToolchainError.Invalid("C toolchain pack has more than {CC_PACK_MAX_ENTRIES} entries"))
        if kind != RegistryTarKind.File && kind != RegistryTarKind.Directory {
            return Err(CcToolchainError.Invalid("C toolchain pack entry `{name}` is not a regular file or directory"))
        }
        unpacked += size
        if unpacked > CC_PACK_MAX_UNPACKED_BYTES -> return Err(CcToolchainError.Invalid("C toolchain pack unpacks to more than {CC_PACK_MAX_UNPACKED_BYTES} bytes"))
        target := String?{None}
        if provider_registry_prepare_entry(name, kind, destination) == {
            .Ok(value) -> target = value
            .Err(error) -> return Err(CcToolchainError.Invalid(error.message()))
        }
        if target == {
            .Val(path) -> {
                stream.copy_to(path, size)
                files.set_mode(path, mode.bit_and(0o755)) ?? return Err(CcToolchainError.Invalid("set the mode of `{name}`: {err}"))
            }
            .None -> stream.skip(size)
        }
        stream.skip(padding)
    }
}

// Realize the target entry for `target` from the pack: fetch the pack on
// first use, then lay out the target's sysroot (building musl if needed).
provider_cc_realize_pack: fn(verification: &StoreVerification, spec: RefSpec, ctx: ProviderCtx, target: String) -[IO, FS, Env, Exec, Net, Time, Time.Wait]> Realized ProviderError! {
    covered: provider_cc_pack_covered_target(target) ?? return Err(ProviderError.Unsupported(err.message()))
    asset: provider_cc_pack_asset_for_host() ?? return Err(ProviderError.Unsupported(err.message()))
    roots: ctx.nix_roots ?? return Err(ProviderError.BadOutput("C toolchain realization has no Hangar roots"))
    tools: provider_cc_pack_ensure(verification, roots, asset, provider_cc_pack_default_sources(), ctx.offline)
    provider_cc_ensure_real_directory(ctx.store_dir) ?? return Err(ProviderError.BadOutput(err.message()))
    stem: "{CC_TOOLCHAIN_PACKAGE}-{covered.triple}-{provider_cc_pack_short(tools.digest)}-{process.current_pid()}"
    staging: files.join(ctx.store_dir, ".{stem}.partial")
    scratch: files.join(ctx.store_dir, ".{stem}.build")
    output: files.join(ctx.store_dir, stem)
    provider_cc_remove_tree(staging)
    provider_cc_remove_tree(scratch)
    provider_cc_remove_tree(output)
    if provider_cc_pack_publish_target(spec, ctx, tools, covered, staging, scratch, output) == {
        .Ok(realized) -> {
            provider_cc_remove_tree(scratch)
            Ok(realized)
        }
        .Err(error) -> {
            provider_cc_remove_tree(scratch)
            provider_cc_remove_tree(staging)
            provider_cc_remove_tree(output)
            Err(ProviderError.BadOutput(error.message()))
        }
    }
}

provider_cc_pack_publish_target: fn(spec: RefSpec, ctx: ProviderCtx, tools: CcPackTools, target: CcPackTarget, staging: String, scratch: String, output: String) -[IO, FS, Env, Exec, Time.Wait]> Realized CcToolchainError! {
    usr: files.join(staging, "sysroot/usr")
    if target.libc == "glibc" {
        provider_cc_pack_copy_tree(files.join(tools.root, "glibc/{target.triple}/usr"), usr)
    } else {
        provider_cc_pack_copy_tree(files.join(tools.root, "musl/{target.arch}/include"), files.join(usr, "include"))
        provider_cc_pack_build_musl(tools, target, usr, scratch)
    }
    store_seal_local_output(staging) ?? return Err(CcToolchainError.Invalid("seal C toolchain target `{target.triple}`: {err.message()}"))
    files.rename(staging, output) ?? return Err(CcToolchainError.Invalid("publish C toolchain target `{target.triple}`: {err}"))
    bundle_sha256: pkg_try_output_hash_of(output) ?? return Err(CcToolchainError.Invalid("hash C toolchain target: {err.message()}"))
    sysroot_sha256: pkg_try_output_hash_of(files.join(output, "sysroot")) ?? return Err(CcToolchainError.Invalid("hash C toolchain sysroot: {err.message()}"))
    libc_version: if target.libc == "glibc" -> tools.manifest.glibc else -> tools.manifest.musl
    facts: [String: String]{
        "cc.schema": CC_TOOLCHAIN_SCHEMA,
        "cc.producer": CC_TOOLCHAIN_PRODUCER,
        "cc.layout": CC_TOOLCHAIN_PACK_LAYOUT,
        "cc.host": tools.asset.host,
        "cc.target": target.triple,
        "cc.version": "clang-{tools.manifest.llvm}+lld-{tools.manifest.llvm}",
        "cc.abi": target.abi(),
        "cc.libc": "{target.libc}-{libc_version}",
        "cc.compiler": CC_PACK_CLANG,
        "cc.compiler.sha256": tools.clang_sha256,
        "cc.cxx": CC_PACK_CLANG,
        "cc.cxx.sha256": tools.clang_sha256,
        "cc.linker": CC_PACK_LLD,
        "cc.linker.sha256": tools.lld_sha256,
        "cc.sysroot": "sysroot",
        "cc.sysroot.sha256": sysroot_sha256,
        "cc.bundle.sha256": bundle_sha256,
        "cc.compiler.root.sha256": tools.digest,
        "cc.manifest": "pack:{tools.asset.file}",
        "cc.pack.sha256": tools.asset.sha256,
        "cache.output": bundle_sha256
    }
    plan: ProviderPlanFacts.from_facts([String: String]{
        "action.kind": "cc-toolchain-provision",
        "action.recipe": CC_TOOLCHAIN_RECIPE_ID
    }) ?? return Err(CcToolchainError.Invalid(err.message()))
    producer: ProducerRecord.new(CC_TOOLCHAIN_PRODUCER, provider_cc_pack_immutable_source(tools.asset), bundle_sha256, plan, CC_TOOLCHAIN_RECIPE_ID, "policy=content-addressed\nplatform=host", facts) ?? return Err(CcToolchainError.Invalid(err.message()))
    references: [String]{tools.digest}
    envelope: Envelope.for_output(output, spec.raw, CC_TOOLCHAIN_RECIPE_ID)
    descriptor: provider_cc_pack_descriptor(output, output, tools.root, references, envelope, producer)
    Ok(Realized{
        name: CC_TOOLCHAIN_PACKAGE,
        version: descriptor.version,
        reference: spec.raw,
        out: output,
        bin: files.join(output, "bin"),
        rlib: "",
        envelope: envelope,
        cache_identity: descriptor.cache_identity(ctx),
        source_state: SourceState.Downloaded,
        named_outputs: [String: String]{"out": output},
        references: references,
        producer: producer
    })
}

// The pack-layout descriptor of a target entry rooted at `root` whose tools
// live in the pack object at `pack_root`. The pack mounts as the compiler
// role and the entry's sysroot as the sysroot role.
provider_cc_pack_descriptor: fn(entry_id: String, root: String, pack_root: String, references: [String], envelope: Envelope, producer: ProducerRecord) -> CcToolchainDescriptor CcToolchainError! {
    bundle_sha256: provider_cc_fact(producer, entry_id, "cc.bundle.sha256")
    pack_digest: provider_cc_fact(producer, entry_id, "cc.compiler.root.sha256")
    sysroot: provider_cc_fact(producer, entry_id, "cc.sysroot")
    sysroot_sha256: provider_cc_fact(producer, entry_id, "cc.sysroot.sha256")
    sysroot_root: files.join(root, sysroot)
    virtual: files.join(CC_TOOLCHAIN_VIRTUAL_BASE, bundle_sha256)
    Ok(CcToolchainDescriptor{
        entry_id: entry_id,
        root: root,
        host: provider_cc_fact(producer, entry_id, "cc.host"),
        target: provider_cc_fact(producer, entry_id, "cc.target"),
        version: provider_cc_fact(producer, entry_id, "cc.version"),
        abi: provider_cc_fact(producer, entry_id, "cc.abi"),
        compiler: provider_cc_fact(producer, entry_id, "cc.compiler"),
        compiler_sha256: provider_cc_fact(producer, entry_id, "cc.compiler.sha256"),
        cxx: provider_cc_fact(producer, entry_id, "cc.cxx"),
        cxx_sha256: provider_cc_fact(producer, entry_id, "cc.cxx.sha256"),
        linker: provider_cc_fact(producer, entry_id, "cc.linker"),
        linker_sha256: provider_cc_fact(producer, entry_id, "cc.linker.sha256"),
        sysroot: sysroot,
        sysroot_sha256: sysroot_sha256,
        bundle_sha256: bundle_sha256,
        layout: CcToolchainLayout.Pack,
        compiler_root: pack_root,
        cxx_root: pack_root,
        linker_root: pack_root,
        sysroot_root: sysroot_root,
        mounts: [CcMount]{
            CcMount{store_path: "", digest: pack_digest, source: pack_root, destination: files.join(virtual, CcToolchainRole.Compiler.label())},
            CcMount{store_path: "", digest: sysroot_sha256, source: sysroot_root, destination: files.join(virtual, CcToolchainRole.Sysroot.label())}
        },
        references: references,
        envelope: envelope,
        producer: producer
    })
}

// Copy a pack subtree into a writable staging tree, refusing symlinks and
// special files.
provider_cc_pack_copy_tree: fn(source: String, destination: String) CcToolchainError! -[FS]> {
    metadata: files.stat(source) ?? return Err(CcToolchainError.Invalid("read C toolchain pack `{source}`: {err}"))
    if metadata.is_symlink -> return Err(CcToolchainError.Invalid("C toolchain pack contains symlink `{source}`"))
    if metadata.is_dir {
        files.create_dir_all(destination) ?? return Err(CcToolchainError.Invalid("create `{destination}`: {err}"))
        children: files.list_dir(source) ?? return Err(CcToolchainError.Invalid("read C toolchain pack directory `{source}`: {err}"))
        loop child in children -> provider_cc_pack_copy_tree(files.join(source, child.name), files.join(destination, child.name))
        return
    }
    if !metadata.is_file -> return Err(CcToolchainError.Invalid("C toolchain pack contains unsupported node `{source}`"))
    files.copy2(source, destination) ?? return Err(CcToolchainError.Invalid("copy C toolchain pack file `{source}`: {err}"))
    files.set_mode(destination, (metadata.mode).bit_or(0o200).bit_and(0o755)) ?? return Err(CcToolchainError.Invalid("set the mode of `{destination}`: {err}"))
}

// Build musl's libc.a and crt objects for `target` into `usr/lib` with the
// pack's own clang and llvm-ar; the other libc archives are empty, as in a
// musl install. Objects are compiled in `scratch`.
provider_cc_pack_build_musl: fn(tools: CcPackTools, target: CcPackTarget, usr: String, scratch: String) CcToolchainError! -[IO, FS, Env, Exec, Time.Wait]> {
    term.eprint("building musl for {target.short} (first time only)")
    source_root: files.join(tools.root, "musl/src")
    internal: files.join(scratch, "internal")
    lib: files.join(usr, "lib")
    files.create_dir_all(internal) ?? return Err(CcToolchainError.Invalid("create musl build directory: {err}"))
    files.create_dir_all(lib) ?? return Err(CcToolchainError.Invalid("create musl library directory: {err}"))
    files.write(files.join(internal, "version.h"), "#define VERSION \"{tools.manifest.musl}\"\n") ?? return Err(CcToolchainError.Invalid("write musl version header: {err}"))
    clang: files.join(tools.root, CC_PACK_CLANG)
    flags: [String]{
        "--target={target.triple}", "-resource-dir={files.join(tools.root, CC_PACK_RESOURCE_DIR)}",
        "-std=c99", "-ffreestanding", "-nostdinc", "-D_XOPEN_SOURCE=700",
        "-I{files.join(source_root, "arch/{target.arch}")}", "-I{files.join(source_root, "arch/generic")}", "-I{internal}",
        "-I{files.join(source_root, "src/include")}", "-I{files.join(source_root, "src/internal")}", "-I{files.join(usr, "include")}",
        "-Os", "-pipe", "-fomit-frame-pointer", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables",
        "-ffunction-sections", "-fdata-sections", "-fno-stack-protector", "-w", "-Qunused-arguments"
    }
    listing: provider_cc_read_bounded_file(files.join(tools.root, "musl/{target.arch}/sources"), CC_PACK_MAX_SOURCE_LIST_BYTES, "musl source list")
    text: String.from_bytes(listing) ?? return Err(CcToolchainError.Invalid("musl source list is not UTF-8"))
    specs := [ProcessSpec]{}
    objects := [String]{}
    loop line in text.split("\n").to_list() {
        source: line.trim()
        if source == "" -> next
        provider_cc_validate_relative_path(source)
        object: "{source.replace("/", "_")}.o"
        objects.push(object.copy())
        specs.push(provider_cc_pack_compile(clang, flags, files.join(source_root, source), files.join(scratch, object), false))
    }
    if objects.len() == 0 -> return Err(CcToolchainError.Invalid("musl source list for {target.arch} is empty"))
    loop name in CC_PACK_MUSL_CRT {
        arch_source: files.join(source_root, "crt/{target.arch}/{name}.s")
        source: if provider_cc_is_regular_file(arch_source) -> arch_source else -> files.join(source_root, "crt/{name}.c")
        specs.push(provider_cc_pack_compile(clang, flags, source, files.join(lib, "{name}.o"), name == "Scrt1" || name == "rcrt1"))
    }
    receipts: process.run_all(specs, sys.cpu_count()) ?? return Err(CcToolchainError.Invalid("run the pack compiler: {err}"))
    loop result in receipts {
        receipt: result ?? return Err(CcToolchainError.Invalid("run the pack compiler: {err}"))
        if !receipt.success -> return Err(CcToolchainError.Invalid("building musl for {target.triple} failed: {provider_cc_pack_clip(receipt.errors)}"))
    }
    archive := [String]{files.join(tools.root, CC_PACK_AR), "rcs", files.join(lib, "libc.a")}
    archive.extend(objects)
    linked: process.cmd(archive).cwd(scratch).env_clear().stdout(.Capture).stderr(.Capture).run() ?? return Err(CcToolchainError.Invalid("run the pack archiver: {err}"))
    if !linked.success -> return Err(CcToolchainError.Invalid("archiving musl for {target.triple} failed: {provider_cc_pack_clip(linked.errors)}"))
    loop name in CC_PACK_MUSL_EMPTY_LIBS {
        files.write(files.join(lib, "lib{name}.a"), CC_PACK_EMPTY_ARCHIVE) ?? return Err(CcToolchainError.Invalid("write empty musl archive `lib{name}.a`: {err}"))
    }
}

provider_cc_pack_compile: fn(clang: String, flags: [String], source: String, object: String, pic: Bool) -[Exec]> ProcessSpec Never! {
    argv := [String]{clang}
    argv.extend(flags.copy())
    if pic -> argv.push("-fPIC")
    argv.extend([String]{"-c", source, "-o", object})
    process.cmd(argv).env_clear().stdout(.Capture).stderr(.Capture)
}

// Compiler output trimmed to a bounded report.
provider_cc_pack_clip: fn(text: String) -> String Never! {
    raw: text.trim().bytes()
    if raw.len() <= CC_PACK_MAX_REPORTED_BYTES -> return text.trim()
    "{pkg_bytes_text(raw, 0, CC_PACK_MAX_REPORTED_BYTES)}…"
}
