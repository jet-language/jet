// Compatibility-proved native replacement overlays (D-WD15), ported from
// jetpack::Replacement.
//
// This is an internal data/proof layer. User-facing policy and proof source
// is ratified separately as `policy.replacements` and `replacementProof:`.

// A provider-qualified package identity.
pub struct PackageIdentity {
    pub provider: String
    pub name: String
    pub version: String

    fn new(provider: String, name: String, version: String) -> PackageIdentity !Never {
        PackageIdentity{provider: provider, name: name, version: version}
    }

    // `provider:name`, or `provider:name@version` when versioned.
    fn ref_string(self) -> String !Never {
        if self.version == "" -> return "{self.provider}:{self.name}"
        "{self.provider}:{self.name}@{self.version}"
    }
}

pub enum ProofStatus {
    Missing
    Failed
    Passed
}

// A native package offered in place of a foreign one, with the proof that
// makes it eligible.
pub struct ReplacementCandidate {
    pub foreign_identity: PackageIdentity
    pub native_identity: PackageIdentity
    pub covered_public_symbols: [String]
    pub unsupported_symbols: [String]
    pub license: String
    pub platforms: [String]
    pub proof_status: ProofStatus
    pub proof_digest: String
    pub proof_inputs: [String]

    // A candidate that is listed but has no proof yet.
    fn visible_but_inactive(foreign_identity: PackageIdentity, native_identity: PackageIdentity) -> ReplacementCandidate !Never {
        ReplacementCandidate{foreign_identity: foreign_identity, native_identity: native_identity, covered_public_symbols: [String]{}, unsupported_symbols: [String]{}, license: "", platforms: [String]{}, proof_status: ProofStatus.Missing, proof_digest: "", proof_inputs: [String]{}}
    }

    // Activate this candidate for `owner_package` on `platform` when its proof
    // passed, it covers the platform, and policy allows or prefers it.
    fn resolve(self, policy: ReplacementPolicy, owner_package: String, platform: String) -> ReplacementDecision !Never {
        if self.proof_status != ProofStatus.Passed -> return ReplacementDecision.Inactive{reason: "compatibility proof has not passed"}
        if self.platforms.len() > 0 && !self.platforms.contains(platform) -> return ReplacementDecision.Inactive{reason: "replacement proof does not cover platform `{platform}`"}
        rule :: policy.rule_for(self)
        mode :: rule?.mode ?? policy.default_mode
        if mode == ReplacementPolicyMode.Deny -> return ReplacementDecision.Denied{reason: "policy.replacements denies this native replacement"}
        policy_fingerprint :: rule?.fingerprint ?? "policy.replacements:default"
        owner :: rule?.owner_package ?? owner_package
        ReplacementDecision.Active(ActiveReplacement{
            foreign_call_site: self.foreign_identity.ref_string(),
            native_identity: self.native_identity,
            policy_mode: mode,
            lock_record: self.lock_record(owner, platform, policy_fingerprint)
        })
    }

    // The semantic-lock record for this overlay; the proof inputs and covered
    // symbols ride along as future fields.
    fn lock_record(self, owner_package: String, platform: String, policy_fingerprint: String) -> SemanticRecord !Never {
        foreign :: self.foreign_identity.ref_string()
        native :: self.native_identity.ref_string()
        identity :: LockIdentity{kind: LockRecordKind.ReplacementOverlay, key: "{foreign}@{platform}", exact: ~native, hash: self.proof_digest, platform: platform}
        rationale := LockRationale.empty()
        rationale.owner_package = owner_package
        rationale.reason = "native replacement overlay with passed compatibility proof"
        rationale.source_ref = ~foreign
        rationale.provider = self.native_identity.provider
        rationale.exact_output = ~native
        rationale.policy_fingerprint = policy_fingerprint
        rationale.adapter_id = "replacement-overlay"
        rationale.signature = self.proof_digest
        rationale.cache_provenance = "compatibility proof inputs"
        rationale.update_command = "policy.replacements"
        record := SemanticRecord.new(identity, rationale)
        record.future_fields["replacement-foreign"] = foreign
        record.future_fields["replacement-native"] = native
        record.future_fields["replacement-proof-digest"] = self.proof_digest
        record.future_fields["replacement-proof-inputs"] = self.proof_inputs.join("\n")
        record.future_fields["replacement-covered-symbols"] = self.covered_public_symbols.join(",")
        record
    }
}

// One public API symbol with its effect and error shape.
pub struct PublicSymbol {
    pub name: String
    pub signature: String
    pub effects: [String]
    pub errors: [String]

    fn new(name: String, signature: String) -> PublicSymbol !Never {
        PublicSymbol{name: name, signature: signature, effects: [String]{}, errors: [String]{}}
    }

    fn with_effects(self, effects: [String]) -> PublicSymbol !Never {
        out := self
        out.effects = effects
        out
    }

    fn with_errors(self, errors: [String]) -> PublicSymbol !Never {
        out := self
        out.errors = errors
        out
    }
}

// Observed behavior of one example run.
pub struct GoldenFixture {
    pub name: String
    pub stdout: String
    pub stderr: String
    pub exit_code: Int
    pub files: [(path: String, content: String)]
    pub side_effects: [String]

    fn new(name: String, stdout: String) -> GoldenFixture !Never {
        GoldenFixture{name: name, stdout: stdout, stderr: "", exit_code: 0, files: [(path: String, content: String)]{}, side_effects: [String]{}}
    }

    // Digest of every observed output.
    fn fingerprint(self) -> String !Never {
        parts := [String]{self.stdout, self.stderr, "{self.exit_code}"}
        loop file in self.files -> parts.push("{file.path}={file.content}")
        loop side_effect in self.side_effects -> parts.push("effect={side_effect}")
        provider_replacement_digest(parts)
    }
}

// The public surface of one package on which compatibility is proved.
pub struct CompatibilitySurface {
    pub identity: PackageIdentity
    pub public_symbols: [PublicSymbol]
    pub examples: [String]
    pub goldens: [GoldenFixture]
    pub platforms: [String]

    fn new(identity: PackageIdentity) -> CompatibilitySurface !Never {
        CompatibilitySurface{identity: identity, public_symbols: [PublicSymbol]{}, examples: [String]{}, goldens: [GoldenFixture]{}, platforms: [String]{}}
    }

    // Prove this native surface against `foreign` on `platform`: platform
    // availability, then every foreign public symbol by signature, effects,
    // and errors, then every foreign golden fixture.
    fn prove_against(self, foreign: CompatibilitySurface, platform: String) -> ProofReport !Never {
        failures := [ProofFailure]{}
        if foreign.platforms.len() > 0 && !foreign.platforms.contains(platform) {
            failures.push(ProofFailure{kind: ProofFailureKind.PlatformMismatch, name: ~platform, expected: foreign.platforms.join(","), found: "foreign surface unavailable"})
        }
        if self.platforms.len() > 0 && !self.platforms.contains(platform) {
            failures.push(ProofFailure{kind: ProofFailureKind.PlatformMismatch, name: ~platform, expected: self.platforms.join(","), found: "native surface unavailable"})
        }
        covered := [String]{}
        foreign_symbols :: provider_replacement_by_name(foreign.public_symbols)
        native_symbols :: provider_replacement_by_name(self.public_symbols)
        foreign_names := foreign_symbols.keys().to_list()
        foreign_names.sort()
        loop name in foreign_names {
            expected :: foreign_symbols[name]
            found :: native_symbols.get(name) ?? {
                failures.push(ProofFailure{kind: ProofFailureKind.MissingPublicSymbol, name: ~name, expected: expected.signature, found: "missing"})
                next
            }
            if expected.signature != found.signature {
                failures.push(ProofFailure{kind: ProofFailureKind.SignatureMismatch, name: ~name, expected: expected.signature, found: found.signature})
                next
            }
            expected_effects :: provider_replacement_sorted_set(expected.effects)
            found_effects :: provider_replacement_sorted_set(found.effects)
            if expected_effects != found_effects {
                failures.push(ProofFailure{kind: ProofFailureKind.EffectMismatch, name: ~name, expected: expected_effects.join(","), found: found_effects.join(",")})
                next
            }
            expected_errors :: provider_replacement_sorted_set(expected.errors)
            found_errors :: provider_replacement_sorted_set(found.errors)
            if expected_errors != found_errors {
                failures.push(ProofFailure{kind: ProofFailureKind.ErrorShapeMismatch, name: ~name, expected: expected_errors.join(","), found: found_errors.join(",")})
                next
            }
            covered.push(name)
        }
        native_goldens :: provider_replacement_goldens_by_name(self.goldens)
        loop golden in foreign.goldens {
            if native_goldens.get(golden.name) == {
                .Val(native) -> {
                    if native != golden -> failures.push(ProofFailure{kind: ProofFailureKind.GoldenOutputDiff, name: ~golden.name, expected: golden.fingerprint(), found: native.fingerprint()})
                }
                .None -> failures.push(ProofFailure{kind: ProofFailureKind.GoldenOutputDiff, name: ~golden.name, expected: golden.fingerprint(), found: "missing"})
            }
        }
        covered.sort()
        inputs :: provider_replacement_proof_inputs(foreign, self, platform)
        digest :: provider_replacement_digest(inputs)
        ProofReport{foreign_identity: foreign.identity, native_identity: self.identity, platform: platform, inputs: inputs, covered_public_symbols: covered, failures: failures, digest: digest}
    }
}

pub enum ProofFailureKind {
    MissingPublicSymbol
    SignatureMismatch
    EffectMismatch
    ErrorShapeMismatch
    GoldenOutputDiff
    PlatformMismatch
}

pub struct ProofFailure {
    pub kind: ProofFailureKind
    pub name: String
    pub expected: String
    pub found: String
}

pub struct ProofReport {
    pub foreign_identity: PackageIdentity
    pub native_identity: PackageIdentity
    pub platform: String
    pub inputs: [String]
    pub covered_public_symbols: [String]
    pub failures: [ProofFailure]
    pub digest: String

    fn passed(self) -> Bool !Never {
        self.failures.len() == 0
    }

    fn status(self) -> ProofStatus !Never {
        if self.passed() -> return ProofStatus.Passed
        ProofStatus.Failed
    }

    // The candidate this proof yields; missing public symbols become its
    // unsupported symbols.
    fn candidate(self, license: String, platforms: [String]) -> ReplacementCandidate !Never {
        unsupported := [String]{}
        loop failure in self.failures {
            if failure.kind == ProofFailureKind.MissingPublicSymbol -> unsupported.push(failure.name)
        }
        ReplacementCandidate{
            foreign_identity: self.foreign_identity,
            native_identity: self.native_identity,
            covered_public_symbols: self.covered_public_symbols,
            unsupported_symbols: unsupported,
            license: license,
            platforms: platforms,
            proof_status: self.status(),
            proof_digest: self.digest,
            proof_inputs: self.inputs
        }
    }
}

pub enum ReplacementPolicyMode {
    Allow
    Deny
    Prefer

    fn label(self) -> String !Never {
        if self == {
            .Allow -> "allow"
            .Deny -> "deny"
            .Prefer -> "prefer"
        }
    }
}

pub struct ReplacementPolicyRule {
    pub foreign_identity: String
    pub native_identity: String
    pub mode: ReplacementPolicyMode
    pub owner_package: String
    pub fingerprint: String
}

// `policy.replacements`: per-pair rules over a default mode.
pub struct ReplacementPolicy {
    pub default_mode: ReplacementPolicyMode
    pub rules: [ReplacementPolicyRule]

    // Deny everything.
    fn deny_all() -> ReplacementPolicy !Never {
        ReplacementPolicy{default_mode: ReplacementPolicyMode.Deny, rules: [ReplacementPolicyRule]{}}
    }

    fn allow(foreign: PackageIdentity, native: PackageIdentity, owner_package: String) -> ReplacementPolicy !Never {
        ReplacementPolicy.single(foreign, native, owner_package, ReplacementPolicyMode.Allow)
    }

    fn prefer(foreign: PackageIdentity, native: PackageIdentity, owner_package: String) -> ReplacementPolicy !Never {
        ReplacementPolicy.single(foreign, native, owner_package, ReplacementPolicyMode.Prefer)
    }

    fn single(foreign: PackageIdentity, native: PackageIdentity, owner_package: String, mode: ReplacementPolicyMode) -> ReplacementPolicy !Never {
        fingerprint :: "policy.replacements:{foreign.ref_string()}=>{native.ref_string()}:{mode.label()}"
        rule :: ReplacementPolicyRule{foreign_identity: foreign.ref_string(), native_identity: native.ref_string(), mode: mode, owner_package: owner_package, fingerprint: fingerprint}
        ReplacementPolicy{default_mode: ReplacementPolicyMode.Deny, rules: [ReplacementPolicyRule]{rule}}
    }

    // The rule for the candidate's exact foreign/native pair.
    fn rule_for(self, candidate: ReplacementCandidate) -> ?ReplacementPolicyRule !Never {
        foreign :: candidate.foreign_identity.ref_string()
        native :: candidate.native_identity.ref_string()
        loop rule in self.rules {
            if rule.foreign_identity == foreign && rule.native_identity == native -> return Val(rule)
        }
        None
    }
}

pub enum ReplacementDecision {
    Inactive(reason: String)
    Denied(reason: String)
    Active(ActiveReplacement)
}

pub struct ActiveReplacement {
    pub foreign_call_site: String
    pub native_identity: PackageIdentity
    pub policy_mode: ReplacementPolicyMode
    pub lock_record: SemanticRecord
}

pub enum ImporterReplacementStatus {
    NoCandidate
    CandidateFound
    ProofFailed
    ProofPassed
    ReplacementActive
}

// One importer progress line about a package's native replacement.
pub struct ImporterProgressFact {
    pub foreign_identity: PackageIdentity
    pub native_identity: ?PackageIdentity
    pub status: ImporterReplacementStatus
    pub proof_digest: String
    pub detail: String

    fn no_candidate(foreign_identity: PackageIdentity) -> ImporterProgressFact !Never {
        ImporterProgressFact{foreign_identity: foreign_identity, native_identity: None, status: ImporterReplacementStatus.NoCandidate, proof_digest: "", detail: "no native replacement candidate found"}
    }

    fn from_candidate(candidate: ReplacementCandidate) -> ImporterProgressFact !Never {
        status :: if candidate.proof_status == {
            .Missing -> ImporterReplacementStatus.CandidateFound
            .Failed -> ImporterReplacementStatus.ProofFailed
            .Passed -> ImporterReplacementStatus.ProofPassed
        }
        ImporterProgressFact{foreign_identity: candidate.foreign_identity, native_identity: Val(candidate.native_identity), status: status, proof_digest: candidate.proof_digest, detail: candidate.covered_public_symbols.join(",")}
    }

    fn active(candidate: ReplacementCandidate) -> ImporterProgressFact !Never {
        ImporterProgressFact{foreign_identity: candidate.foreign_identity, native_identity: Val(candidate.native_identity), status: ImporterReplacementStatus.ReplacementActive, proof_digest: candidate.proof_digest, detail: "policy enabled replacement"}
    }
}

// Symbols by name; a later symbol with the same name wins.
fn provider_replacement_by_name(symbols: [PublicSymbol]) -> [String: PublicSymbol] !Never {
    out := [String: PublicSymbol]{}
    loop symbol in symbols {
        name :: ~symbol.name
        out[name] = symbol
    }
    out
}

fn provider_replacement_goldens_by_name(goldens: [GoldenFixture]) -> [String: GoldenFixture] !Never {
    out := [String: GoldenFixture]{}
    loop golden in goldens {
        name :: ~golden.name
        out[name] = golden
    }
    out
}

// The values sorted without repeats.
fn provider_replacement_sorted_set(values: [String]) -> [String] !Never {
    out := [String]{}
    loop value in values {
        if !out.contains(value) -> out.push(value)
    }
    out.sort()
    out
}

// Every fact the proof read, sorted: identities, platform, symbols,
// examples, and golden fixture fingerprints of both surfaces.
fn provider_replacement_proof_inputs(foreign: CompatibilitySurface, native: CompatibilitySurface, platform: String) -> [String] !Never {
    inputs := [String]{"foreign={foreign.identity.ref_string()}", "native={native.identity.ref_string()}", "platform={platform}"}
    surfaces :: [CompatibilitySurface]{foreign, native}
    loop surface in surfaces {
        loop symbol in surface.public_symbols {
            inputs.push("symbol={symbol.name}:{symbol.signature}:{provider_replacement_sorted_set(symbol.effects).join(",")}:{provider_replacement_sorted_set(symbol.errors).join(",")}")
        }
    }
    loop surface in surfaces {
        loop example in surface.examples -> inputs.push("example={example}")
    }
    loop surface in surfaces {
        loop golden in surface.goldens -> inputs.push("golden={golden.name}:{golden.fingerprint()}")
    }
    inputs.sort()
    inputs
}

// `proof-fnv64-<16 hex>`: FNV-1a 64 over each part's bytes followed by LF.
fn provider_replacement_digest(parts: [String]) -> String !Never {
    prime :: U64{0x100000001b3}
    hash := U64{0xcbf29ce484222325}
    loop part in parts {
        loop byte in part.bytes() {
            hash ~|= U64{byte}
            hash = wrapping(hash * prime)
        }
        hash ~|= U64{10}
        hash = wrapping(hash * prime)
    }
    digits :: "0123456789abcdef".bytes()
    out := [U8]{}
    shift := 60
    loop shift >= 0 {
        out.push(digits[Int{(hash >> shift) & U64{15}}])
        shift -= 4
    }
    "proof-fnv64-{pkg_bytes_text(out, 0, out.len())}"
}
