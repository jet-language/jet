// The first-party Jet library battery catalog. Text sources are embedded from
// Jetpack/Provider/Batteries/, so the catalog stays byte-identical to the
// bundled batteries; the two binary game assets (not UTF-8, so not
// `embed_file` text) are carried as their exact bytes. Packages are in slug
// order and files in relative-path order.

// The named source and upstream the embedded batteries resolve through.
BATTERIES_SOURCE_NAME :: prep { "batteries" }
BATTERIES_UPSTREAM :: prep { "embedded:batteries" }
BATTERIES_FILE_MODE :: prep { 0o644 }

// One bundled battery file: its package-relative path, mode, and bytes.
struct BatteryFile {
    path: String
    mode: Int
    bytes: [U8]
}

// One bundled battery package.
struct BatteryPackage {
    slug: String
    files: [BatteryFile]
}

fn env_battery_text(path: String, text: String) -> BatteryFile Never! {
    BatteryFile{path, mode: BATTERIES_FILE_MODE, bytes: text.bytes()}
}

// Every bundled battery package.
fn env_battery_packages() -> [BatteryPackage] Never! {
    [BatteryPackage]{
        {slug: "backend", files: [BatteryFile]{
            env_battery_text("backend.jet", embed_file("../../Batteries/backend/backend.jet")),
            env_battery_text("package.jet", embed_file("../../Batteries/backend/package.jet")),
        }},
        {slug: "cli", files: [BatteryFile]{
            env_battery_text("cli.jet", embed_file("../../Batteries/cli/cli.jet")),
            env_battery_text("package.jet", embed_file("../../Batteries/cli/package.jet")),
        }},
        {slug: "data", files: [BatteryFile]{
            env_battery_text("data.jet", embed_file("../../Batteries/data/data.jet")),
            env_battery_text("package.jet", embed_file("../../Batteries/data/package.jet")),
        }},
        {slug: "embedded", files: [BatteryFile]{
            env_battery_text("embedded.jet", embed_file("../../Batteries/embedded/embedded.jet")),
            env_battery_text("package.jet", embed_file("../../Batteries/embedded/package.jet")),
        }},
        {slug: "games", files: [BatteryFile]{
            env_battery_text("assets/demo.jetreplay", embed_file("../../Batteries/games/assets/demo.jetreplay")),
            BatteryFile{path: "assets/jump.wav", mode: BATTERIES_FILE_MODE, bytes: env_battery_jump_wav()},
            env_battery_text("assets/player.atlas", embed_file("../../Batteries/games/assets/player.atlas")),
            BatteryFile{path: "assets/player.png", mode: BATTERIES_FILE_MODE, bytes: env_battery_player_png()},
            env_battery_text("games.jet", embed_file("../../Batteries/games/games.jet")),
            env_battery_text("package.jet", embed_file("../../Batteries/games/package.jet")),
        }},
        {slug: "gui", files: [BatteryFile]{
            env_battery_text("gui.jet", embed_file("../../Batteries/gui/gui.jet")),
            env_battery_text("package.jet", embed_file("../../Batteries/gui/package.jet")),
        }},
        {slug: "web", files: [BatteryFile]{
            env_battery_text("package.jet", embed_file("../../Batteries/web/package.jet")),
            env_battery_text("web.jet", embed_file("../../Batteries/web/web.jet")),
        }},
    }
}

// Jetpack/Provider/Batteries/games/assets/jump.wav (45 bytes).
fn env_battery_jump_wav() -> [U8] Never! {
    [U8]{
        {82}, U8{73}, U8{70}, U8{70}, U8{37}, U8{0}, U8{0}, U8{0}, U8{87}, U8{65}, U8{86}, U8{69}, U8{102}, U8{109}, U8{116}, U8{32},
        {16}, U8{0}, U8{0}, U8{0}, U8{1}, U8{0}, U8{1}, U8{0}, U8{64}, U8{31}, U8{0}, U8{0}, U8{64}, U8{31}, U8{0}, U8{0},
        {1}, U8{0}, U8{8}, U8{0}, U8{100}, U8{97}, U8{116}, U8{97}, U8{1}, U8{0}, U8{0}, U8{0}, U8{128},
    }
}

