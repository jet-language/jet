//RS /// Peek whether `remote` has a package marker at its root, without a full clone.
//RS ///
//RS /// Fetches **only the named rev** into a throwaway repo, shallow (`--depth 1`)
//RS /// and partial (`--filter=tree:0`, so trees/blobs are deferred), then reads the
//RS /// root tree with `git ls-tree FETCH_HEAD`. Even a nixpkgs-sized repo transfers
//RS /// just the one commit object plus the lazily-fetched root tree. `git fetch`
//RS /// resolves a branch, tag, **or** commit SHA uniformly, so the rev's exact
//RS /// The canonical `package.jet` marker is preferred, with `pkg.jet` retained for
//RS /// migration-era sources. Any failure (no `git`, network error, unfetchable
//RS /// rev) is treated as "no package marker" by the caller (→ nix), the safe
//RS /// default.
//RS fn remote_has_pack_jet(remote: &RemoteSource) -> bool {
//RS     if network_denied() {
//RS         return false;
//RS     }
//RS     if hardened_git_command().arg("--version").output().is_err() {
//RS         return false;
//RS     }
//RS     let tmp = match exclusive_temp_dir(&std::env::temp_dir(), "jetpack-peek") {
//RS         Ok(path) => path,
//RS         Err(_) => return false,
//RS     };
//RS     let _guard = TempDirGuard(tmp.clone());
//RS 
//RS     let git = |args: &[&str]| {
//RS         hardened_git_command()
//RS             .arg("-C")
//RS             .arg(&tmp)
//RS             .args(args)
//RS             .output()
//RS             .map(|o| o.status.success())
//RS             .unwrap_or(false)
//RS     };
//RS     // A configured `origin` makes the partial fetch register a promisor remote,
//RS     // so the deferred root tree can be lazily fetched on `ls-tree`.
//RS     let rev = remote.rev.as_deref().unwrap_or("HEAD");
//RS     if !remote_revision_is_safe(remote.rev.as_deref()) {
//RS         return false;
//RS     }
//RS     let set_up = git(&["init", "--quiet"]) && git(&["remote", "add", "origin", &remote.url]);
//RS     let fetched = set_up
//RS         && git(&[
//RS             "fetch",
//RS             "--quiet",
//RS             "--depth",
//RS             "1",
//RS             "--filter=tree:0",
//RS             "origin",
//RS             rev,
//RS         ]);
//RS     let has_pack = fetched
//RS         && hardened_git_command()
//RS             .arg("-C")
//RS             .arg(&tmp)
//RS             .args([
//RS                 "ls-tree",
//RS                 "FETCH_HEAD",
//RS                 crate::Syntax::PACKAGE_FILE,
//RS                 crate::Syntax::PAYLOAD_FILE,
//RS             ])
//RS             .output()
//RS             .map(|o| o.status.success() && !o.stdout.is_empty())
//RS             .unwrap_or(false);
//RS 
//RS     has_pack
//RS }
//RS 
