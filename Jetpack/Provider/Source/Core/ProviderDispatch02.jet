//RS /// Recover a package version from a Nix store path basename, which by
//RS /// convention is `<32-char-hash>-<pname>-<version>[-<output>]`. We strip the
//RS /// fixed-width hash, the known `<name>-` prefix, and any trailing output
//RS /// segment, then accept the remainder only if it looks like a version (leads
//RS /// with a digit). Anything we can't confidently parse yields an empty version,
//RS /// so the hangar id falls back to `<name>-<fp>` rather than guessing wrong.
//RS fn nix_store_version(out: &str, name: &str) -> String {
//RS     const HASH_LEN: usize = 32;
//RS     const OUTPUT_SUFFIXES: &[&str] = &["-bin", "-dev", "-lib", "-doc", "-man", "-info", "-out"];
//RS 
//RS     let base = out.trim_end_matches('/').rsplit('/').next().unwrap_or("");
//RS     let Some(rest) = base.get(HASH_LEN..) else {
//RS         return String::new();
//RS     };
//RS     let rest = rest.strip_prefix('-').unwrap_or(rest);
//RS     let Some(mut version) = rest.strip_prefix(name).and_then(|s| s.strip_prefix('-')) else {
//RS         return String::new();
//RS     };
//RS     for suffix in OUTPUT_SUFFIXES {
//RS         if let Some(stripped) = version.strip_suffix(suffix) {
//RS             version = stripped;
//RS             break;
//RS         }
//RS     }
//RS     if version.starts_with(|c: char| c.is_ascii_digit()) {
//RS         version.to_string()
//RS     } else {
//RS         String::new()
//RS     }
//RS }
