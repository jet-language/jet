//RS     fn top_level_run_drives_kind_inference() {
//RS         // D-ILE1: a top-level `fn run` means executable.
//RS         assert!(file_has_top_level_run("fn run() {}\n"));
//RS         assert!(file_has_top_level_run(
//RS             "fn helper() -> Int { return 1 }\nfn run() { print(\"hi\") }\n"
//RS         ));
//RS         // A `run` nested in a module/impl block is not the entry point.
//RS         assert!(!file_has_top_level_run("module m { fn run() {} }\n"));
//RS         // A library: no top-level `fn run`.
//RS         assert!(!file_has_top_level_run(
//RS             "fn add(a: Int, b: Int) -> Int { return a + b }\n"
//RS         ));
//RS         // `fn run` inside a comment or string never counts.
//RS         assert!(!file_has_top_level_run("// fn run()\nfn lib() {}\n"));
//RS         assert!(!file_has_top_level_run(
//RS             "fn lib() { s :: \"fn run()\" }\n"
//RS         ));
//RS     }
