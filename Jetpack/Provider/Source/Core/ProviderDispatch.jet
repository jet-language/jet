// The provider boundary (Rust Provider.rs `Provider` trait, R0). Each provider
// owns acquisition and realization; source classification happens once here,
// so every caller shares the same dispatch and evidence. `core` realizes
// first-party Jet packages, `nix` leverages nixpkgs, and direct ecosystem
// roots without a native realization path fail closed instead of falling
// through to Nix.

// The one realize-time classification memo per process: an exact commit's
// classification is also durable on disk; anything else is stable for one
// process. Without it a warm 28-package env re-peeked the same pinned
// nixpkgs revision 28 times.
provider_remote_kind_memo := [String: ProviderKind]{}

// The adapter behind a resolved provider kind.
pub enum ProviderAdapter {
    Nix
    Core
    Cran
    LuaRocks
    ScriptRegistry(ScriptRegistryKind)
    Native
    // A direct external root with no native realization path yet.
    Unsupported(String)

    // Validate that the current provider authority still matches a recorded
    // cache binding.
    fn validate_cache_authority(self, spec: RefSpec, table: SourceTable, ctx: ProviderCtx) ProviderError! -[FS, Env, Net, Time.Wait]> {
        if self == {
            .Nix -> NixProvider{}.validate_cache_authority(spec, table, ctx)
            .Cran -> CranProvider{}.validate_cache_authority(spec, table, ctx)
            .LuaRocks -> LuaRocksProvider{}.validate_cache_authority(spec, table, ctx)
            .ScriptRegistry(kind) -> ScriptRegistryProvider{kind}.validate_cache_authority(spec, table, ctx)
            else -> {}
        }
    }

    // The exact current identity required to trust a cached output. A
    // provider that cannot derive it gets no early cache path.
    fn cache_expectation(self, verification: &StoreVerification, spec: RefSpec, table: SourceTable, ctx: ProviderCtx) -[FS, Env, Exec, Net, Time, Time.Wait, Rand]> CacheExpectation? Never! {
        if self == {
            .Nix -> NixProvider{}.cache_expectation(&verification, spec, table, ctx)
            .Core -> CoreProvider{}.cache_expectation(&verification, spec, table, ctx)
            .Cran -> CranProvider{}.cache_expectation(&verification, spec, table, ctx)
            .LuaRocks -> LuaRocksProvider{}.cache_expectation(&verification, spec, table, ctx)
            .ScriptRegistry(kind) -> ScriptRegistryProvider{kind}.cache_expectation(&verification, spec, table, ctx)
            .Native -> NativeReleaseProvider{}.cache_expectation(&verification, spec, table, ctx)
            .Unsupported(_) -> None
        }
    }

    // The exact external approval subject of an executable provider action.
    fn approval_facts(self, spec: RefSpec, table: SourceTable, ctx: ProviderCtx) -[FS, Env, Exec, Net, Time, Time.Wait, Rand]> String? ProviderReason! {
        if self == {
            .Core -> CoreProvider{}.approval_facts(spec, table, ctx)
            else -> Ok(None)
        }
    }

    // Plan acquisition for this adapter's refs; the caller groups refs by
    // adapter so Nix can plan one shared closure.
    fn plan_downloads(self, verification: &StoreVerification, specs: [RefSpec], table: SourceTable, ctx: ProviderCtx) -[IO, FS, Env, Net, Time, Time.Wait]> DownloadPlan ProviderError! {
        if self == {
            .Nix -> NixProvider{}.plan_downloads(&verification, specs, table, ctx)
            .Core -> CoreProvider{}.plan_downloads(&verification, specs, table, ctx)
            .Cran -> CranProvider{}.plan_downloads(&verification, specs, table, ctx)
            .LuaRocks -> LuaRocksProvider{}.plan_downloads(&verification, specs, table, ctx)
            .ScriptRegistry(kind) -> ScriptRegistryProvider{kind}.plan_downloads(&verification, specs, table, ctx)
            .Native -> NativeReleaseProvider{}.plan_downloads(&verification, specs, table, ctx)
            .Unsupported(_) -> Ok(DownloadPlan.empty())
        }
    }

    // Whether this adapter may repair an invalid indexed cache candidate.
    fn can_repair(self, spec: RefSpec, table: SourceTable, ctx: ProviderCtx) -[FS, Env]> Bool Never! {
        if self == {
            .Nix -> NixProvider{}.can_repair(spec, table, ctx)
            else -> false
        }
    }

    // Whether this adapter has acquisition work to show; local Core paths are
    // already present.
    fn requires_acquisition(self, spec: RefSpec, table: SourceTable) -> Bool Never! {
        if self == {
            .Core -> CoreProvider{}.requires_acquisition(spec, table)
            else -> true
        }
    }

    fn realize(self, verification: &StoreVerification, spec: RefSpec, table: SourceTable, ctx: ProviderCtx) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Realized ProviderError! {
        if self == {
            .Nix -> NixProvider{}.realize(&verification, spec, table, ctx)
            .Core -> CoreProvider{}.realize(&verification, spec, table, ctx)
            .Cran -> CranProvider{}.realize(&verification, spec, table, ctx)
            .LuaRocks -> LuaRocksProvider{}.realize(&verification, spec, table, ctx)
            .ScriptRegistry(kind) -> ScriptRegistryProvider{kind}.realize(&verification, spec, table, ctx)
            .Native -> NativeReleaseProvider{}.realize(&verification, spec, table, ctx)
            .Unsupported(label) -> Err(ProviderError.Unsupported("provider `{label}` has no realization path for `{spec.raw}`; import and lock its native facts first"))
        }
    }
}

// The provider for an already-resolved kind.
pub fn provider_for(kind: ProviderKind) -> ProviderAdapter Never! {
    if kind == {
        .Nix | .Infer -> ProviderAdapter.Nix
        .Core -> ProviderAdapter.Core
        .Cran -> ProviderAdapter.Cran
        .LuaRocks -> ProviderAdapter.LuaRocks
        .RubyGems -> ProviderAdapter.ScriptRegistry(ScriptRegistryKind.RubyGems)
        .Cpan -> ProviderAdapter.ScriptRegistry(ScriptRegistryKind.Cpan)
        .Packagist -> ProviderAdapter.ScriptRegistry(ScriptRegistryKind.Packagist)
        .JetPackage -> ProviderAdapter.Native
        .JetRegistry -> ProviderAdapter.Unsupported("jet-registry")
        .Npm -> ProviderAdapter.Unsupported("npm")
        .Cargo -> ProviderAdapter.Unsupported("cargo")
        .PyPI -> ProviderAdapter.Unsupported("pypi")
        .SwiftPM -> ProviderAdapter.Unsupported("swiftpm")
    }
}

fn provider_for_ref(spec: RefSpec, table: SourceTable, ctx: ProviderCtx) -[FS, Env, Exec, Net, Time.Wait, Rand]> ProviderAdapter Never! {
    provider_for(provider_resolve_kind_in_context(spec, table, ctx))
}

// Check the provider authority recorded for a project cache binding.
pub fn provider_validate_cache_authority(spec: RefSpec, table: SourceTable, ctx: ProviderCtx) ProviderError! -[FS, Env, Exec, Net, Time.Wait, Rand]> {
    if ctx.project_dir == None -> return
    provider_for_ref(spec, table, ctx).validate_cache_authority(spec, table, ctx)
}

// Independently derive every fact required to trust an existing cache record.
pub fn provider_cache_expectation(verification: &StoreVerification, spec: RefSpec, table: SourceTable, ctx: ProviderCtx) -[FS, Env, Exec, Net, Time, Time.Wait, Rand]> CacheExpectation? Never! {
    provider_for_ref(spec, table, ctx).cache_expectation(&verification, spec, table, ctx)
}

// The exact external approval subject for a provider action, without
// executing package code.
pub fn provider_approval_facts(spec: RefSpec, table: SourceTable, ctx: ProviderCtx) -[FS, Env, Exec, Net, Time, Time.Wait, Rand]> String? ProviderReason! {
    provider_for_ref(spec, table, ctx).approval_facts(spec, table, ctx)
}

// The concrete source kind of a direct ecosystem root, if the ref names one.
fn provider_direct_kind(source: RefSource) -> ProviderKind? Never! {
    if source == {
        .Cran -> Val(ProviderKind.Cran)
        .LuaRocks -> Val(ProviderKind.LuaRocks)
        .RubyGems -> Val(ProviderKind.RubyGems)
        .Cpan -> Val(ProviderKind.Cpan)
        .Packagist -> Val(ProviderKind.Packagist)
        .JetRegistry -> Val(ProviderKind.JetRegistry)
        .Npm -> Val(ProviderKind.Npm)
        .Cargo -> Val(ProviderKind.Cargo)
        .PyPI -> Val(ProviderKind.PyPI)
        .SwiftPM -> Val(ProviderKind.SwiftPM)
        .Releases -> Val(ProviderKind.JetPackage)
        else -> None
    }
}

// Resolve a ref's concrete provider kind, running the U9 realize-time probe
// when the source table left the kind to inference (a typed `…@github`
// source). Offline never hits the network: it reuses a cached checkout if
// present, else falls back to `nix`. Built-in sources, bare paths, and
// `…@nixpkgs` named sources are concrete in the table and never probe.
pub fn provider_resolve_kind(spec: RefSpec, table: SourceTable, offline: Bool, cache_dir: String) -[FS, Env, Exec, Time.Wait, Rand]> ProviderKind Never! {
    if provider_direct_kind(spec.source) == {
        .Val(kind) -> return kind
        .None -> {}
    }
    if provider_cc_toolchain_is_reference(spec) -> return ProviderKind.JetPackage
    name :: if spec.source == {
        .Named(name) -> name
        else -> { return ProviderKind.Nix }
    }
    kind :: table.provider(name)
    if kind != ProviderKind.Infer -> return kind
    // U9: peek the remote's package marker to choose core or nix.
    upstream :: table.upstream(name) ?? return ProviderKind.Nix
    provider_infer_remote_kind(upstream, offline, cache_dir)
}

// True when realizing this ref goes through the Nix compatibility provider.
pub fn provider_uses_nix_provider(spec: RefSpec, table: SourceTable, offline: Bool, cache_dir: String) -[FS, Env, Exec, Time.Wait, Rand]> Bool Never! {
    kind :: provider_resolve_kind(spec, table, offline, cache_dir)
    kind == ProviderKind.Nix || kind == ProviderKind.Infer
}

// Resolve an inferred project source without probing its remote when the
// checked-in lock already proves the source is indexed nixpkgs.
pub fn provider_uses_nix_provider_for_project(spec: RefSpec, table: SourceTable, offline: Bool, cache_dir: String, project_dir: String?) -[FS, Env, Exec, Time.Wait, Rand]> Bool Never! {
    if provider_cc_toolchain_is_reference(spec) -> return false
    provider_has_locked_nix_index_key(spec, table, project_dir, provider_host_nix_system()) || provider_uses_nix_provider(spec, table, offline, cache_dir)
}

fn provider_resolve_kind_in_context(spec: RefSpec, table: SourceTable, ctx: ProviderCtx) -[FS, Env, Exec, Time.Wait, Rand]> ProviderKind Never! {
    if provider_cc_toolchain_is_reference(spec) -> return ProviderKind.JetPackage
    if provider_has_locked_nix_index_key(spec, table, ctx.project_dir, provider_host_nix_system()) -> return ProviderKind.Nix
    provider_resolve_kind(spec, table, ctx.offline, ctx.store_dir)
}

// Acquisition metadata without realizing a provider, grouped by resolved kind
// in first-seen order. Nix uses the signed index plus narinfo closure; native
// release fixtures contribute their exact artifact length. Providers without
// a byte-bearing metadata seam keep the total unknown instead of inventing it.
pub fn provider_plan_downloads(verification: &StoreVerification, specs: [RefSpec], table: SourceTable, ctx: ProviderCtx) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> DownloadPlan ProviderError! {
    kinds := [ProviderKind]{}
    grouped := [[RefSpec]]{}
    loop spec in specs {
        kind :: provider_resolve_kind_in_context(spec, table, ctx)
        position := -1
        loop index in 0..<kinds.len() {
            if kinds[index] == kind -> position = index
        }
        if position < 0 {
            &kinds.push(kind)
            &grouped.push([RefSpec]{spec})
        } else {
            &grouped[position].push(spec)
        }
    }
    plan := DownloadPlan.empty()
    loop index in 0..<kinds.len() {
        &plan.extend(provider_for(kinds[index]).plan_downloads(&verification, grouped[index], table, ctx))
    }
    Ok(plan)
}

// U23 / D-JPK-NIXSTORE1=D: a ref resolving through the Nix provider needs an
// explicit compatibility output unless a locked nixpkgs ref is representable
// by the signed index. Computed before dispatch, so a genuine v1 hole gets one
// package-focused diagnostic without probing Nix.
pub fn provider_needs_nix_bridge(spec: RefSpec, table: SourceTable, offline: Bool, cache_dir: String, project_dir: String?) -[FS, Env, Exec, Time.Wait, Rand]> NixBridgeNeed? Never! {
    if !provider_uses_nix_provider_for_project(spec, table, offline, cache_dir, project_dir) -> return None
    if provider_has_locked_nix_index_key(spec, table, project_dir, provider_host_nix_system()) -> return None
    Val(NixBridgeNeed{reference: spec.raw, package: spec.short_name()})
}

// An invalid indexed-Nix cache entry may be repaired by the path that created
// it; other providers keep the Store's fail-closed integrity behavior.
pub fn provider_can_repair_indexed_nix(spec: RefSpec, table: SourceTable, ctx: ProviderCtx) -[FS, Env, Exec, Time.Wait, Rand]> Bool Never! {
    provider_for_ref(spec, table, ctx).can_repair(spec, table, ctx)
}

pub fn provider_requires_acquisition(spec: RefSpec, table: SourceTable, offline: Bool, cache_dir: String) -[FS, Env, Exec, Time.Wait, Rand]> Bool Never! {
    provider_for(provider_resolve_kind(spec, table, offline, cache_dir)).requires_acquisition(spec, table)
}

// Realize a ref through its provider. The resolver never knows which backend
// runs; every result carries the refreshed shared provider facts.
pub fn provider_realize(verification: &StoreVerification, spec: RefSpec, table: SourceTable, ctx: ProviderCtx) -[IO, FS, Env, Exec, Net, Time, Time.Wait, Rand]> Realized ProviderError! {
    realized := provider_for_ref(spec, table, ctx).realize(&verification, spec, table, ctx)
    provider_refresh_provider_facts(&realized.producer, realized.reference)
    Ok(realized)
}

fn provider_pack_kind(has_pack: Bool) -> ProviderKind Never! {
    if has_pack -> ProviderKind.Core else -> ProviderKind.Nix
}

// U9 remote probe: classify an `…@github`/git upstream as `Core` (it carries
// `package.jet` or migration-era `pkg.jet`) or `Nix`, peeking only the root
// package marker — never cloning a nixpkgs-sized repo to classify it.
//  1. An existing source-cache checkout classifies from the local tree.
//  2. A prior classification is reused (durable for an exact commit).
//  3. Offline with no cache defaults to `nix`.
//  4. Online: a depth-1, tree-filtered peek; any failure is `nix`.
fn provider_infer_remote_kind(upstream: String, offline: Bool, cache_dir: String) -[FS, Env, Exec, Time.Wait, Rand]> ProviderKind Never! {
    remote :: RemoteSource.parse(upstream) ?? return ProviderKind.Nix
    cache :: provider_source_cache_dir(cache_dir, remote)
    if files.is_dir(cache) {
        return provider_pack_kind(files.is_file(files.join(cache, PACKAGE_FILE)) || files.is_file(files.join(cache, PAYLOAD_FILE)))
    }
    exact :: if remote.rev == {
        .Val(rev) -> rev.bytes().len() == 40 && provider_is_ascii_hex(rev)
        .None -> false
    }
    memo_key :: "{cache_dir}\n{upstream}"
    if provider_remote_kind_memo.get(memo_key) == {
        .Val(kind) -> return kind
        .None -> {}
    }
    parent :: files.dirname(cache_dir)
    durable :: files.join(files.join(if parent == "" -> cache_dir else -> parent, "source-kinds"), pkg_sha256_hex(upstream.bytes()))
    if exact {
        if files.read(durable) == {
            .Ok(text) -> {
                kind :: provider_pack_kind(text.trim() == "core")
                provider_remote_kind_memo[memo_key] = kind
                return kind
            }
            .Err(_) -> {}
        }
    }
    if offline -> return ProviderKind.Nix
    has_pack :: provider_remote_has_pack_jet(remote)
    kind :: provider_pack_kind(has_pack)
    provider_remote_kind_memo[memo_key] = kind
    if exact {
        files.create_dir_all(files.dirname(durable)).drop("the durable classification is a cache")
        files.write(durable, if has_pack -> "core" else -> "nix").drop("the durable classification is a cache")
    }
    kind
}

// ASCII hexadecimal digits in either case.
fn provider_is_ascii_hex(value: String) -> Bool Never! {
    loop byte in value.bytes() {
        code :: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 65 && code <= 70) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

// Peek whether `remote` has a package marker at its root without a full
// clone: fetch only the named rev, shallow and tree-filtered, into a
// throwaway repo, then `git ls-tree FETCH_HEAD` for the markers. A configured
// `origin` registers the promisor remote so the deferred root tree is lazily
// fetched. Any failure is "no package marker".
fn provider_remote_has_pack_jet(remote: RemoteSource) -[FS, Env, Exec, Time.Wait, Rand]> Bool Never! {
    if provider_network_denied() -> return false
    if !provider_git_available() -> return false
    if !provider_remote_revision_is_safe(remote.rev) -> return false
    tmp :: provider_exclusive_temp_dir(sys.temp_dir(), "jetpack-peek") ?? return false
    has_pack :: provider_peek_pack_markers(tmp, remote)
    provider_remove_tree_quiet(tmp)
    has_pack
}

// The peek itself, inside the throwaway repo `tmp`.
fn provider_peek_pack_markers(tmp: String, remote: RemoteSource) -[Env, Exec, Time.Wait]> Bool Never! {
    rev :: remote.rev ?? "HEAD"
    set_up :: provider_git_in(tmp, [String]{"init", "--quiet"}) && provider_git_in(tmp, [String]{"remote", "add", "origin", remote.url})
    fetched :: set_up && provider_git_in(tmp, [String]{"fetch", "--quiet", "--depth", "1", "--filter=tree:0", "origin", rev})
    if !fetched -> return false
    listing :: provider_git_output_in(tmp, [String]{"ls-tree", "FETCH_HEAD", PACKAGE_FILE, PAYLOAD_FILE}) ?? return false
    listing != ""
}

// Run one hardened Git command inside `dir`; true on success.
fn provider_git_in(dir: String, args: [String]) -[Env, Exec, Time.Wait]> Bool Never! {
    if provider_hardened_git_command().arg("-C").arg(dir).args_extend(args).run() == {
        .Ok(receipt) -> receipt.success
        .Err(_) -> false
    }
}

// The standard output of one successful hardened Git command inside `dir`.
fn provider_git_output_in(dir: String, args: [String]) -[Env, Exec, Time.Wait]> String? Never! {
    if provider_hardened_git_command().arg("-C").arg(dir).args_extend(args).run() == {
        .Ok(receipt) -> if receipt.success -> Val(receipt.output) else -> None
        .Err(_) -> None
    }
}
