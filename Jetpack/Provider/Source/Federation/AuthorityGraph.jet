// Locked provider objects and the fetch authority they grant, ported from
// jetpack::ProviderGraph.

pub struct ProviderObject {
    pub family: ProviderFamily
    pub ref_key: String
    pub exact_identity: String
    pub hash: String
    pub platform: String
    pub signature: String
    pub audit: [String]
    pub sandbox_effects: [String]
    pub build_effects: [String]

    // A binary artifact: its hash and platform are its identity, and it runs
    // no build.
    fn binary(name: String, hash: String, platform: String, signature: String) -> ProviderObject !ProviderGraphError {
        if hash.trim() == "" -> return Err(ProviderGraphError{message: "binary provider requires a hash"})
        if platform.trim() == "" -> return Err(ProviderGraphError{message: "binary provider requires a platform"})
        exact_identity :: "binary:{name}:{platform}:{hash}"
        Ok(ProviderObject{
            family: ProviderFamily.Binary,
            ref_key: name,
            exact_identity: exact_identity,
            hash: hash,
            platform: platform,
            signature: signature,
            audit: [String]{"hash verified before realization"},
            sandbox_effects: [String]{"no build execution"},
            build_effects: [String]{}
        })
    }
}

pub struct ProviderRequest {
    pub family: ProviderFamily
    pub ref_key: String
    pub exact_identity: String
    pub hash: String
    pub platform: String
    pub offline: Bool
}

pub enum FetchDecision {
    AllowedOfflineSatisfied
    AllowedNetworkWithGrant(authority: String)
    DeniedOfflineMissingLock
}

// Why a provider object or report cannot be formed.
#Error
pub struct ProviderGraphError {
    pub message: String
}

pub struct AuthorityGraph {
    pub locked_objects: [ProviderObject]

    fn empty() -> AuthorityGraph !Never {
        AuthorityGraph{locked_objects: [ProviderObject]{}}
    }

    fn add_locked(&self, object: ProviderObject) !Never {
        self.locked_objects.push(object)
    }

    // Offline, a request is satisfied only by a locked object with the same
    // family, ref, identity, hash, and platform; online it needs the family's
    // fetch grant.
    fn fetch_allowed(self, request: ProviderRequest) -> FetchDecision !Never {
        if !request.offline -> return FetchDecision.AllowedNetworkWithGrant{authority: "provider.fetch.{request.family.label()}"}
        loop object in self.locked_objects {
            if object.family == request.family && object.ref_key == request.ref_key && object.exact_identity == request.exact_identity && object.hash == request.hash && object.platform == request.platform {
                return FetchDecision.AllowedOfflineSatisfied
            }
        }
        FetchDecision.DeniedOfflineMissingLock
    }
}
