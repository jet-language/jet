// NuGet XML documents (`.nuspec`, `packages.config`, SDK-style project
// `PackageReference`s), ported from the XML branch of
// jetpack::ProviderGraph's `nuget_report`. The JSON lock and assets shapes
// need Core's JSON reader.

// One package named by a `PackageReference` or `packages.config` tag.
struct NuGetReference {
    name: String
    version: String
    opening: String
}

impl ProviderFactReport {
    // A NuGet XML document: the root `<id>`/`<version>` identity, else a
    // single referenced package, else a `nuget-lock` set; licenses, target
    // frameworks, dependencies, repository, signatures, advisories, and
    // `tools/` files as hooks. Inexact versions and namespaced XML are losses.
    fn nuget_xml_document(document: String) -> ProviderFactReport Never! {
        if provider_xml_has_namespace(document) {
            return ProviderFactReport.unreadable(ProviderFamily.NuGet, "nuget", "NuGet XML uses a namespaced vocabulary that this provider cannot normalize").retaining("xml", document)
        }
        facts := MetadataFacts.empty(ProviderFamily.NuGet, "")
        root_name :: provider_xml_first_tag(document, [String]{"id", "Id"})
        root_version :: provider_xml_first_tag(document, [String]{"version", "Version"})
        has_root :: root_name != None && root_version != None
        references := [NuGetReference]{}
        losses := [String]{}
        loop opening in provider_xml_opening_tags(document, "PackageReference") {
            version :: provider_xml_attribute(opening, "Version") ?? ""
            name :: provider_xml_first_attribute(opening, [String]{"Include", "Update"}) ?? {
                &losses.push("NuGet `PackageReference` has no Include or Update identity")
                next
            }
            if version == "" || !provider_exact_version(version) -> &losses.push("NuGet PackageReference `{name}` has no resolved exact version")
            &references.push(NuGetReference{name: name, version: version, opening: opening})
        }
        loop opening in provider_xml_opening_tags(document, "package") {
            name :: provider_xml_attribute(opening, "id") ?? next
            version :: provider_xml_attribute(opening, "version") ?? ""
            if version == "" || !provider_exact_version(version) -> &losses.push("NuGet package `{name}` has no resolved exact version")
            &references.push(NuGetReference{name: name, version: version, opening: opening})
        }
        dependency_tags :: provider_xml_opening_tags(document, "dependency")
        dependency_values := [String]{}
        loop opening in dependency_tags {
            name :: provider_xml_first_attribute(opening, [String]{"id", "name"}) ?? {
                &losses.push("NuGet dependency has no id or name")
                next
            }
            version :: provider_xml_attribute(opening, "version") ?? ""
            &dependency_values.push(provider_format_dependency(name, version))
            if version == "" || !provider_exact_version(version) -> &losses.push("NuGet dependency `{name}` has no resolved exact version")
        }
        reference_values := [String]{}
        loop reference in references -> &reference_values.push(provider_format_dependency(reference.name, reference.version))
        if {
            has_root -> {
                facts.name = root_name ?? ""
                facts.version = root_version ?? ""
            }
            references.len() == 1 -> {
                facts.name = ~references[0].name
                facts.version = ~references[0].version
            }
            else -> {
                facts.name = "nuget-lock"
                facts.version = "set"
                if references.len() == 0 -> &losses.push("NuGet metadata has no package identity")
            }
        }
        facts.license = provider_xml_first_tag(document, [String]{"license", "licenseExpression", "licenseUrl"}) ?? ""
        group_tags :: provider_xml_opening_tags(document, "group")
        loop opening in group_tags {
            if provider_xml_attribute(opening, "targetFramework") == {
                .Val(target) -> &facts.platforms.push(target)
                .None -> {}
            }
        }
        loop reference in references {
            if provider_xml_attribute(reference.opening, "targetFramework") == {
                .Val(target) -> &facts.platforms.push(target)
                .None -> {}
            }
        }
        facts.platforms = provider_sorted_unique(facts.platforms)
        multiple_references :: !has_root && references.len() > 1
        facts.dependencies = if {
            dependency_values.len() > 0 -> dependency_values
            multiple_references -> ~reference_values
            else -> [String]{}
        }
        reference_keys :: [String]{"Condition", "PrivateAssets", "IncludeAssets", "ExcludeAssets"}
        loop index in 0..<references.len() {
            &facts.add_typed_text("provider.nuget.dependency.reference.{index}", reference_values[index])
            loop key in reference_keys {
                if provider_xml_attribute(references[index].opening, key) == {
                    .Val(value) -> &facts.add_typed_text("provider.nuget.dependency.reference.{index}.{key}", value)
                    .None -> {}
                }
            }
        }
        dependency_keys :: [String]{"id", "name", "version", "exclude"}
        loop index in 0..<dependency_tags.len() {
            loop key in dependency_keys {
                if provider_xml_attribute(dependency_tags[index], key) == {
                    .Val(value) -> &facts.add_typed_text("provider.nuget.dependency.nuspec.{index}.{key}", value)
                    .None -> {}
                }
            }
        }
        metadata_elements :: [(element: String, key: String)]{
            (element: "authors", key: "authors"), (element: "owners", key: "owners"), (element: "license", key: "license"),
            (element: "licenseExpression", key: "license_expression"), (element: "licenseUrl", key: "license_url"),
            (element: "projectUrl", key: "project_url"), (element: "repositoryUrl", key: "repository_url"),
            (element: "description", key: "description"), (element: "summary", key: "summary"),
            (element: "releaseNotes", key: "release_notes"), (element: "copyright", key: "copyright"), (element: "tags", key: "tags"),
            (element: "contentHash", key: "content_hash"), (element: "signature", key: "signature"), (element: "signatures", key: "signatures"),
            (element: "signatureValidation", key: "signature_validation"), (element: "deprecated", key: "deprecated"),
            (element: "deprecation", key: "deprecation"), (element: "vulnerability", key: "vulnerability"),
            (element: "vulnerabilities", key: "vulnerabilities"), (element: "advisory", key: "advisory"), (element: "advisories", key: "advisories")
        }
        loop entry in metadata_elements {
            values :: provider_xml_tag_values(document, entry.element)
            loop index in 0..<values.len() -> &facts.add_typed_text("provider.nuget.metadata.{entry.key}.{index}", values[index])
        }
        loop index in 0..<group_tags.len() {
            if provider_xml_attribute(group_tags[index], "targetFramework") == {
                .Val(target) -> &facts.add_typed_text("provider.nuget.platform.group.{index}", target)
                .None -> {}
            }
        }
        repository_tags :: provider_xml_opening_tags(document, "repository")
        repository_keys :: [String]{"type", "url", "commit"}
        loop index in 0..<repository_tags.len() {
            loop key in repository_keys {
                if provider_xml_attribute(repository_tags[index], key) == {
                    .Val(value) -> &facts.add_typed_text("provider.nuget.source.repository.{index}.{key}", value)
                    .None -> {}
                }
            }
        }
        opening_facts :: [String]{"signature", "signatures", "deprecation", "vulnerability", "advisory"}
        loop fact_name in opening_facts {
            openings :: provider_xml_opening_tags(document, fact_name)
            loop index in 0..<openings.len() -> &facts.add_typed_text("provider.nuget.metadata.{fact_name}.opening.{index}", openings[index])
        }
        file_tags :: provider_xml_opening_tags(document, "file")
        loop index in 0..<file_tags.len() {
            if provider_xml_attribute(file_tags[index], "src") == {
                .Val(source) -> {
                    &facts.add_typed_text("provider.nuget.hook.file.{index}", source)
                    if source.contains("tools/") || source.contains("tools\\") -> &facts.scripts.push(source)
                }
                .None -> {}
            }
        }
        loop opening in repository_tags {
            if provider_xml_attribute(opening, "url") == {
                .Val(url) -> {
                    &facts.add_typed_text("provider.repository", url)
                    break
                }
                .None -> {}
            }
        }
        facts.integrity_hash = provider_xml_tag(document, "contentHash") ?? ""
        facts.source_identity = "nuget:{facts.name}@{facts.version}"
        report := ProviderFactReport.with_identity(facts)
        loop loss in losses -> &report.losses.push(loss)
        if multiple_references -> &report.losses.push("NuGet metadata contains multiple packages; lock each package identity separately")
        if report.facts.version != "set" && report.facts.version != "" && !provider_exact_version(report.facts.version) {
            &report.losses.push("NuGet package version is a range or mutable selector, not an exact identity")
        }
        report.retaining("xml", document)
    }
}

// The first of `elements` present as a tag, in order.
fn provider_xml_first_tag(document: String, elements: [String]) -> String? Never! {
    loop element in elements {
        value :: provider_xml_tag(document, element) ?? next
        return Val(value)
    }
    None
}

// The first of `keys` present as an attribute of `opening`, in order.
fn provider_xml_first_attribute(opening: String, keys: [String]) -> String? Never! {
    loop key in keys {
        value :: provider_xml_attribute(opening, key) ?? next
        return Val(value)
    }
    None
}

// Each `<element …>` opening tag's text.
fn provider_xml_opening_tags(document: String, element: String) -> [String] Never! {
    tags := [String]{}
    loop opening in provider_xml_openings(document, element) -> &tags.push(opening.text)
    tags
}

// Whether any namespace declaration or `prefix:name` element appears.
fn provider_xml_has_namespace(document: String) -> Bool Never! {
    if document.contains("xmlns:") || document.contains("xmlns=") -> return true
    bytes :: document.bytes()
    cursor := 0
    loop cursor < bytes.len() {
        start :: provider_find(bytes, "<".bytes(), cursor, bytes.len())
        if start < 0 -> break
        end :: provider_xml_opening_end(bytes, start, bytes.len())
        if end < 0 -> break
        opening :: pkg_bytes_text(bytes, start, end + 1)
        if !opening.starts_with("<!") && !opening.starts_with("<?") && provider_xml_opening_name(opening).contains(":") -> return true
        cursor = end + 1
    }
    false
}
