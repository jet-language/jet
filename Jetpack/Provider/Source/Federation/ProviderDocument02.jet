// Rust: crates/jetpack/src/ProviderGraph.rs:5260
// Replace JsonFacts.provider_graph_json_array_strings on integration: retain
// TypedText array items as well as Text, and untrimmed object names.
fn json_array_strings(object: [String: DataTree], key: String) -> [String] Never! {
    value :: object.get(key) ?? return [String]{}
    items :: pkg_json_array(value) ?? return [String]{}
    out := [String]{}
    loop item in items {
        if item == {
            .Text(text) | .TypedText(text) -> &out.push(text)
            .Object(fields) -> {
                name :: fields.get("name") ?? next
                if name == {
                    .Text(text) | .TypedText(text) -> &out.push(text)
                    else -> {}
                }
            }
            else -> {}
        }
    }
    out
}

