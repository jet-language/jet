// Rust: crates/jetpack/src/ProviderGraph.rs:5352
// Replace JsonFacts.provider_graph_json_value_text on integration: TypedText
// and Number retain their exact spelling; containers use the renderer below.
fn json_value_text(value: DataTree) -> String Never! {
    if value == {
        .Null -> "null"
        .Bool(flag) -> flag.to_string()
        .Int(number) -> number.to_string()
        .Float(number) -> number.to_string()
        .Number(text) -> text
        .Text(text) | .TypedText(text) -> text
        .Bytes(_) | .Array(_) | .Object(_) -> json_value_json(value)
    }
}

// Rust: crates/jetpack/src/ProviderGraph.rs:5364
// Rust renders Number verbatim, TypedText as quoted text, Bytes as decimal
// arrays and Object in native insertion order, without a Core serializer's
// normalization of any of those representations.
fn json_value_json(value: DataTree) -> String Never! {
    if value == {
        .Null -> "null"
        .Bool(flag) -> flag.to_string()
        .Int(number) -> number.to_string()
        .Float(number) -> number.to_string()
        .Number(text) -> text
        .Text(text) | .TypedText(text) -> pkg_json_render(DataTree.Text(text))
        .Bytes(values) -> {
            parts := [String]{}
            loop byte in values -> &parts.push(byte.to_string())
            "[{parts.join(",")}]"
        }
        .Array(values) -> {
            parts := [String]{}
            loop item in values -> &parts.push(json_value_json(item))
            "[{parts.join(",")}]"
        }
        .Object(fields) -> {
            parts := [String]{}
            loop key in fields.keys().to_list() {
                &parts.push("{pkg_json_render(DataTree.Text(key))}:{json_value_json(fields[key])}")
            }
            "{{{parts.join(",")}}}"
        }
    }
}

// Rust: crates/jetpack/src/ProviderGraph.rs:5402
// Bounded tag/attribute scan, reusing the canonical Maven XML scanner.
// Replace MavenReport.provider_xml_blocks: the byte offset is part of Rust's
// result and is consumed by position-sensitive callers.
fn xml_blocks(document: String, tag: String) -> [(start: Int, text: String)] Never! {
    bytes :: document.bytes()
    closing :: "</{tag}>".bytes()
    blocks := [(start: Int, text: String)]{}
    loop opening in provider_xml_openings(document, tag) {
        trimmed := opening.text.trim_end() // #4303
        if trimmed.ends_with("/>") -> next
        body_start :: opening.end + 1
        close :: provider_find(bytes, closing, body_start, bytes.len())
        if close < 0 -> next
        body_end :: close + closing.len()
        &blocks.push((start: opening.start, text: pkg_bytes_text(bytes, opening.start, body_end)))
    }
    blocks
}
