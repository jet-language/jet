// Federated provider family contracts under Jetpack authority, ported from
// jetpack::ProviderGraph. The families themselves are provider rows in
// PackageModel/Source/Provider/ProviderRows.jet.
//
// External provider prefixes and trust-root configuration remain
// owner-gated. A contract records the surface this build actually owns.

impl ProviderFamily {
    // Core, Nix, Path, and the Jet registry are local or first party.
    is_local_or_first_party: fn(self) -> Bool Never! {
        if self == {
            .Core | .Nix | .Path | .JetRegistry -> true
            else -> false
        }
    }
}

ProviderFamilyContract: struct {
    family: ProviderFamily
    parses_refs: Bool
    probes_metadata: Bool
    resolves_channels: Bool
    fetches_bytes: Bool
    verifies_hash_signature: Bool
    exposes_audit_facts: Bool
    reports_offline_satisfiability: Bool

    // The surface this build owns for `family`. Metadata normalization does
    // not imply Jet can fetch or lock bytes from a foreign ecosystem, so those
    // capabilities stay false until a real provider adapter supplies them.
    for_family: fn(family: ProviderFamily) -> ProviderFamilyContract Never! {
        first_party: family.is_local_or_first_party()
        byte_owner: first_party || family == ProviderFamily.Binary
        ProviderFamilyContract{
            family: family,
            parses_refs: true,
            probes_metadata: true,
            resolves_channels: first_party,
            fetches_bytes: byte_owner,
            verifies_hash_signature: byte_owner,
            exposes_audit_facts: true,
            reports_offline_satisfiability: byte_owner
        }
    }

    // The contract of every built-in family, in provider-row order.
    built_in: fn() -> [ProviderFamilyContract] Never! {
        contracts := [ProviderFamilyContract]{}
        loop family in ProviderFamily.all() -> contracts.push(ProviderFamilyContract.for_family(family))
        contracts
    }
}
