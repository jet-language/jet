// Provider-native metadata facts and the per-document report, ported from
// jetpack::ProviderGraph.
//
// A report keeps unsupported or ambiguous fields visible as losses and
// conflicts instead of silent defaults.

MetadataFacts: struct {
    family: ProviderFamily
    name: String
    version: String
    source_identity: String
    integrity_hash: String
    dependencies: [String]
    dev_dependencies: [String]
    build_dependencies: [String]
    scripts: [String]
    platforms: [String]
    license: String
    bins: [String]
    trust_roots: [String]
    todos: [String]
    // Typed projection of native fields, by fact key.
    typed: [String: [String]]
    replacement_candidates: [ReplacementCandidate]
    conflicts: [String]

    empty: fn(family: ProviderFamily, name: String) -> MetadataFacts Never! {
        MetadataFacts{
            family: family,
            name: name,
            version: "",
            source_identity: "",
            integrity_hash: "",
            dependencies: [String]{},
            dev_dependencies: [String]{},
            build_dependencies: [String]{},
            scripts: [String]{},
            platforms: [String]{},
            license: "",
            bins: [String]{},
            trust_roots: [String]{},
            todos: [String]{},
            typed: [String: [String]]{},
            replacement_candidates: [ReplacementCandidate]{},
            conflicts: [String]{}
        }
    }

    // Name, version, license, and dependency keys from a flat Cargo.toml read
    // (`normalize_cargo`); a `build =` line records a build script.
    from_cargo_manifest: fn(cargo_toml: String) -> MetadataFacts Never! {
        facts := MetadataFacts.empty(ProviderFamily.Cargo, provider_toml_string(cargo_toml, "name") ?? "")
        facts.version = provider_toml_string(cargo_toml, "version") ?? ""
        facts.license = provider_toml_string(cargo_toml, "license") ?? ""
        facts.dependencies = provider_toml_dependency_keys(cargo_toml, "[dependencies]")
        facts.build_dependencies = provider_toml_dependency_keys(cargo_toml, "[build-dependencies]")
        if cargo_toml.contains("build =") -> facts.scripts.push("build.rs")
        facts.source_identity = "cargo:{facts.name}@{facts.version}"
        facts
    }

    // A PyPI distribution (`normalize_pypi`); dynamic metadata is a todo.
    from_pypi: fn(name: String, version: String, dynamic_metadata: Bool) -> MetadataFacts Never! {
        facts := MetadataFacts.empty(ProviderFamily.PyPI, name)
        facts.version = version
        facts.source_identity = "pypi:{name}@{version}"
        if dynamic_metadata -> facts.todos.push("dynamic metadata must be resolved before build execution")
        facts
    }

    // A SwiftPM package pinned by revision (`normalize_swiftpm`).
    from_swiftpm: fn(name: String, revision: String) -> MetadataFacts Never! {
        facts := MetadataFacts.empty(ProviderFamily.SwiftPM, name)
        facts.version = revision
        facts.source_identity = "swiftpm:{name}@{revision}"
        facts.integrity_hash = revision
        facts.typed["provider.revision"] = [String]{revision}
        facts
    }

    // Record one typed text fact, replacing any earlier value.
    add_typed_text: fn(&self, key: String, value: String) Never! {
        self.typed[key] = [String]{value}
    }

    first_typed: fn(self, key: String) -> String? Never! {
        values: self.typed.get(key) ?? return None
        values.get(0)
    }

    // The selector key and value that identify this package exactly: a
    // binary's digest, a SwiftPM revision, a GitHub release revision when
    // unversioned, else the version, else the digest. Empty when none.
    identity_selector: fn(self) -> (key: String, value: String) Never! {
        if self.family == ProviderFamily.Binary -> return (key: "digest", value: self.integrity_hash)
        if self.family == ProviderFamily.SwiftPM {
            if self.first_typed("provider.revision") == {
                .Val(revision) -> {
                    if revision != "" -> return (key: "revision", value: revision)
                }
                .None -> {}
            }
        }
        if self.family == ProviderFamily.Github && self.version == "" {
            if self.first_typed("provider.github.revision") == {
                .Val(revision) -> {
                    if ProviderSelector.parse("#revision={revision}").is_exact() -> return (key: "revision", value: revision)
                }
                .None -> {}
            }
        }
        if self.version != "" -> return (key: "version", value: self.version)
        if self.integrity_hash != "" -> return (key: "digest", value: self.integrity_hash)
        (key: "version", value: "")
    }
}

// One provider-native document normalized into shared facts plus what could
// not be carried losslessly.
ProviderFactReport: struct {
    facts: MetadataFacts
    losses: [String]
    conflicts: [String]
    native_format: String
    native_document: String

    // A report over `facts` that loses the package name or exact identity
    // when either is missing; the facts' conflicts carry over.
    with_identity: fn(facts: MetadataFacts) -> ProviderFactReport Never! {
        losses := [String]{}
        if facts.name == "" -> losses.push("provider metadata has no package name")
        if facts.identity_selector().value == "" -> losses.push("provider metadata has no exact version, revision, or digest")
        conflicts: facts.conflicts
        ProviderFactReport{facts: facts, losses: losses, conflicts: conflicts, native_format: "", native_document: ""}
    }

    // A report that could not read the document at all.
    unreadable: fn(family: ProviderFamily, name: String, loss: String) -> ProviderFactReport Never! {
        ProviderFactReport{facts: MetadataFacts.empty(family, name), losses: [String]{loss}, conflicts: [String]{}, native_format: "", native_document: ""}
    }

    // Keep the native document and its format beside the typed facts.
    retaining: fn(self, native_format: String, document: String) -> ProviderFactReport Never! {
        out := self
        out.native_format = native_format
        out.native_document = document
        out
    }
}

// The first `key = value` line's value with its quotes trimmed.
provider_toml_string: fn(raw: String, key: String) -> String? Never! {
    loop line in provider_lines(raw) {
        pair: line.trim().split_once("=") ?? next
        if pair.before.trim() == key -> return Val(provider_trim_quotes(pair.after.trim()))
    }
    None
}

// Every leading `"` trimmed from both ends (`trim_matches('"')`).
provider_trim_quotes: fn(value: String) -> String Never! {
    out := value
    loop out.starts_with("\"") -> out = out.removeprefix("\"")
    loop out.ends_with("\"") -> out = out.removesuffix("\"")
    out
}

// Keys assigned under the exact `section` header.
provider_toml_dependency_keys: fn(raw: String, section: String) -> [String] Never! {
    keys := [String]{}
    inside := false
    loop raw_line in provider_lines(raw) {
        line: raw_line.trim()
        if line.starts_with("[") {
            inside = line == section
            next
        }
        if !inside -> next
        pair: line.split_once("=") ?? next
        keys.push(pair.before.trim())
    }
    keys
}

// Values in first-seen order without repeats.
provider_distinct_values: fn(values: [String]) -> [String] Never! {
    distinct := [String]{}
    loop value in values {
        if !distinct.contains(value) -> distinct.push(value)
    }
    distinct
}

// `name@version`, or whichever half is present.
provider_format_dependency: fn(raw_name: String, raw_version: String) -> String Never! {
    name: raw_name.trim()
    version: raw_version.trim()
    if name == "" -> return version
    if version == "" -> return name
    "{name}@{version}"
}

// Sorted without repeats (`sort` then `dedup`).
provider_sorted_unique: fn(values: [String]) -> [String] Never! {
    out := provider_distinct_values(values)
    out.sort()
    out
}
