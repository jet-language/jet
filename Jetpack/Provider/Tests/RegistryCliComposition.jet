// JP-PUB-TUF composed CLI claims (tests/pkg.rs:6781-6872,6874-6979,6981-7272):
// publish through the real rebuilt engine, then fetch into Hangar. They read
// the Store, so they prove in the Engine unit, not the Publication package.
use core.process as publication_tuf_test_process

fn registry_cli_test_root(label: String) -[FS, Env]> String Never! {
    root :: files.join(sys.get("HOME") ?? panic("HOME"), ".cache/jet-dev/scratch/publication-tuf-{label}-{sys.pid()}")
    files.remove_all(root).drop("a stale fixture may be absent")
    files.create_dir_all(root) ?? panic("create TUF fixture")
    root
}

// Original CLI claims use the real rebuilt engine named by JET_BIN, never a
// helper/mock binary. Core process/provider #3593/#3594 and composition #4262.
fn publication_tuf_test_git(cwd: String, args: [String]) -[Exec, Time]> ProcessReceipt Never! {
    argv := [String]{"git"}
    &argv.extend(args)
    receipt :: publication_tuf_test_process.cmd(argv).cwd(cwd).stdout(.Capture).stderr(.Capture).run() ?? panic("git fixture")
    assert(receipt.success, "git fixture failed: {receipt.errors}")
    receipt
}
fn publication_tuf_test_manifest(name: String, version: String) -> String Never! {
    "name: \"{name}\"\nversion: \"{version}\"\njet: \">=0.1.0\"\ndescription: \"\"\nlicense: \"MIT\"\nrepository: \"\"\n"
}
fn publication_tuf_test_project(root: String, name: String, version: String) Never! -[FS, Exec, Time]> {
    files.create_dir_all(root) ?? panic("create project")
    files.write(files.join(root, "package.jet"), publication_tuf_test_manifest(name, version)) ?? panic("manifest")
    files.write(files.join(root, "run.jet"), "#Test(\"smoke\") {{ assert(1 == 1) }}\nfn run() {{ print(\"hi\") }}\n") ?? panic("entry")
    loop args in ([[String]]{[String]{"init", "-b", "main"}, [String]{"config", "user.email", "test@jet.test"}, [String]{"config", "user.name", "Jet Test"}, [String]{"add", "."}, [String]{"commit", "-m", "init"}}) -> _ :: publication_tuf_test_git(root, args)
}
fn publication_tuf_test_registry(root: String, name: String, version: String) -[FS, Exec, Time]> String Never! {
    bare :: files.join(root, "registry.git")
    _ :: publication_tuf_test_git(root, [String]{"init", "--bare", bare})
    _ :: publication_tuf_test_git(root, [String]{"--git-dir", bare, "symbolic-ref", "HEAD", "refs/heads/main"})
    work :: files.join(root, "review")
    _ :: publication_tuf_test_git(root, [String]{"clone", "file://{bare}", work})
    review :: files.join(files.join(files.join(work, "reviews"), name), "{version}.review")
    files.create_dir_all(files.dirname(review)) ?? panic("review parent")
    files.write(review, "jet-registry-core-review-v1\npackage={name}\nversion={version}\nreviewer=test-maintainer\ndecision=approved\n") ?? panic("review receipt")
    loop args in ([[String]]{[String]{"config", "user.email", "test@jet.test"}, [String]{"config", "user.name", "Jet Test"}, [String]{"add", "."}, [String]{"commit", "-m", "approve core package"}, [String]{"push", "origin", "HEAD:main"}}) -> _ :: publication_tuf_test_git(work, args)
    files.remove_all(work) ?? panic("cleanup review")
    bare
}
fn publication_tuf_test_command(root: String, project: String, bare: String, store: String, args: [String]) -[Env, Exec]> ProcessSpec Never! {
    argv := [String]{sys.get("JET_BIN") ?? panic("JET_BIN must name the real rebuilt Jet publication/fetch engine (#4262)")}
    &argv.extend(args)
    publication_tuf_test_process.cmd(argv).cwd(project).stdout(.Capture).stderr(.Capture)
        .env("JET_REGISTRY_URL", "file://{bare}").env("JET_REGISTRY_CACHE_DIR", files.join(root, "cache"))
        .env("JET_PACKAGE_STORE_DIR", store).env("JET_KEYS_DIR", files.join(root, "keys"))
        .env("JETPACK_ROOT", files.join(root, "jetpack-root"))
}
#Test("publication tuf original cli_publish_pushes_index_and_enforces_immutability_e1234") {
    root :: registry_cli_test_root("pub-push")
    project :: files.join(root, "project")
    publication_tuf_test_project(project, "textkit", "1.2.0")
    bare :: publication_tuf_test_registry(root, "textkit", "1.2.0")
    store :: files.join(root, "store")
    files.create_dir_all(store) ?? panic("store")
    output :: publication_tuf_test_command(root, project, bare, store, [String]{"registry", "publish"}).run() ?? panic("publish")
    assert(output.success, "publish failed: {output.errors}")
    index :: publication_tuf_test_git(root, [String]{"--git-dir", bare, "show", "HEAD:index/textkit/textkit.jsonl"}).output
    assert(index.contains("\"name\":\"textkit\""))
    assert(index.contains("\"version\":\"1.2.0\""))
    assert(index.contains("\"yanked\":false"))
    entry :: publication_index_parse_line(index.lines()[0]) ?? panic("published index")
    _ :: publication_tuf_test_git(root, [String]{"--git-dir", bare, "cat-file", "-e", "HEAD:referrers/{entry.content_hash}/index.json"})
    _ :: publication_tuf_test_git(project, [String]{"add", "."})
    _ :: publication_tuf_test_git(project, [String]{"commit", "-m", "snapshot api"})
    duplicate :: publication_tuf_test_command(root, project, bare, store, [String]{"registry", "publish"}).run() ?? panic("republish")
    assert(!duplicate.success)
    assert(duplicate.errors.contains("E1234"))
    files.remove_all(root) ?? panic("cleanup")
}
#Test("publication tuf original cli_concurrent_publish_keeps_one_immutable_version") {
    root :: registry_cli_test_root("concurrent")
    left :: files.join(root, "left")
    right :: files.join(root, "right")
    publication_tuf_test_project(left, "racekit", "1.0.0")
    publication_tuf_test_project(right, "racekit", "1.0.0")
    files.write(files.join(right, "run.jet"), "#Test(\"smoke\") {{ assert(1 == 1) }}\nfn run() {{ print(\"different bytes\") }}\n") ?? panic("different source")
    _ :: publication_tuf_test_git(right, [String]{"add", "."})
    _ :: publication_tuf_test_git(right, [String]{"commit", "-m", "different source"})
    bare :: publication_tuf_test_registry(root, "racekit", "1.0.0")
    keygen :: publication_tuf_test_command(root, left, bare, files.join(root, "left-store"), [String]{"registry", "keygen"}).run() ?? panic("keygen")
    assert(keygen.success, "shared publish keygen failed: {keygen.errors}")
    left_child :: publication_tuf_test_command(root, left, bare, files.join(root, "left-store"), [String]{"registry", "publish"}).spawn() ?? panic("spawn left")
    right_child :: publication_tuf_test_command(root, right, bare, files.join(root, "right-store"), [String]{"registry", "publish"}).spawn() ?? panic("spawn right")
    a :: left_child.wait() ?? panic("wait left")
    b :: right_child.wait() ?? panic("wait right")
    assert(a.success != b.success, "exactly one concurrent immutable publish must win")
    loser :: if a.success -> b else -> a
    assert(loser.errors.contains("E1234"))
    index :: publication_tuf_test_git(root, [String]{"--git-dir", bare, "show", "HEAD:index/racekit/racekit.jsonl"}).output
    count := 0
    loop line in index.lines() {
        if line.contains("\"version\":\"1.0.0\"") -> count += 1
    }
    assert_eq(count, 1)
    loop path in ([String]{"artifacts/racekit/1.0.0/package.jet", "metadata/racekit.json", "transparency/log", "transparency/checkpoint"}) -> _ :: publication_tuf_test_git(root, [String]{"--git-dir", bare, "cat-file", "-e", "HEAD:{path}"})
    files.remove_all(root) ?? panic("cleanup")
}
#Test("publication tuf original registry_fetch_rejects_tampered_referrer_index_before_hangar_ingest") {
    verification := StoreVerification.new()
    root :: registry_cli_test_root("referrer-tamper")
    publisher :: files.join(root, "publisher")
    consumer :: files.join(root, "consumer")
    publication_tuf_test_project(publisher, "refkit", "1.2.0")
    bare :: publication_tuf_test_registry(root, "refkit", "1.2.0")
    store :: files.join(root, "store")
    files.create_dir_all(store) ?? panic("store")
    publish :: publication_tuf_test_command(root, publisher, bare, store, [String]{"registry", "publish"}).run() ?? panic("publish")
    assert(publish.success, "publish failed: {publish.errors}")
    index :: publication_tuf_test_git(root, [String]{"--git-dir", bare, "show", "HEAD:index/refkit/refkit.jsonl"}).output
    entry :: publication_index_parse_line(index.lines()[0]) ?? panic("published index")
    tamper :: files.join(root, "tamper")
    _ :: publication_tuf_test_git(root, [String]{"clone", "file://{bare}", tamper})
    referrer_index :: files.join(files.join(files.join(tamper, "referrers"), entry.content_hash), "index.json")
    bytes := files.read_bytes(referrer_index) ?? panic("read referrer")
    &bytes.push(U8{10})
    files.write_bytes(referrer_index, bytes) ?? panic("tamper referrer")
    loop args in ([[String]]{[String]{"config", "user.email", "test@jet.test"}, [String]{"config", "user.name", "Jet Test"}, [String]{"add", "."}, [String]{"commit", "-m", "tamper referrer index"}, [String]{"push", "origin", "HEAD:main"}}) -> _ :: publication_tuf_test_git(tamper, args)
    files.create_dir_all(consumer) ?? panic("consumer")
    files.write(files.join(consumer, "package.jet"), "{publication_tuf_test_manifest("ref-consumer", "0.1.0")}\ndeps: {{\n    refkit: refkit#1.2.0,\n}}\n") ?? panic("consumer manifest")
    denied :: publication_tuf_test_command(root, consumer, bare, store, [String]{"fetch"}).run() ?? panic("fetch")
    assert(!denied.success)
    assert(denied.errors.contains("E1207"))
    assert(denied.errors.contains("restore the immutable OCI referrer set") || denied.errors.contains("OCI referrer index digest"))
    roots :: HangarRoots.at(files.join(root, "jetpack-root"))
    loop stored in store_list(&verification, roots) -> assert(!(stored.name == "refkit" && stored.version == "1.2.0"), "tampered registry evidence must not reach Hangar")
    files.remove_all(root) ?? panic("cleanup")
}

// tests/pkg.rs:6981-7272. Compose through the real CLI, and inspect the SAME
// canonical lock/Hangar models as Rust rather than accept a second cache path.
#Test("publication tuf original registry_fetch_installs_verified_artifact_in_hangar_and_locked_reuses_it") {
    verification := StoreVerification.new()
    root :: registry_cli_test_root("locked-reuse")
    publisher :: files.join(root, "publisher")
    consumer :: files.join(root, "consumer")
    publication_tuf_test_project(publisher, "textkit", "1.2.0")
    bare :: publication_tuf_test_registry(root, "textkit", "1.2.0")
    store :: files.join(root, "legacy-store")
    files.create_dir_all(store) ?? panic("legacy store")
    published :: publication_tuf_test_command(root, publisher, bare, store, [String]{"registry", "publish"}).run() ?? panic("publish")
    assert(published.success, published.errors)
    files.create_dir_all(consumer) ?? panic("consumer")
    manifest_path :: files.join(consumer, "package.jet")
    dependencies :: "{publication_tuf_test_manifest("consumer", "0.1.0")}\ndeps: {{\n    textkit: textkit#1.2.0,\n}}\n"
    allowed :: "{dependencies}\npolicy: {{ licenses: .Allow([\"MIT\"]), sources: {{ \"textkit\": [\"jet\"] }} }}\n"
    denied_manifest :: "{dependencies}\npolicy: {{ licenses: .Allow([\"MIT\"]), sources: {{ \"textkit\": [\"other\"] }} }}\n"
    files.write(manifest_path, denied_manifest) ?? panic("denied manifest")
    denied :: publication_tuf_test_command(root, consumer, bare, store, [String]{"fetch"}).run() ?? panic("denied fetch")
    assert(!denied.success)
    loop detail in ([String]{"E1207", "source authority", "consumer -> textkit#1.2.0", "package `consumer`", "use an allowed source"}) -> assert(denied.errors.contains(detail))
    roots :: HangarRoots.at(files.join(root, "jetpack-root"))
    loop stored in store_list(&verification, roots) -> assert(!(stored.name == "textkit" && stored.version == "1.2.0"))
    files.write(manifest_path, allowed) ?? panic("allowed manifest")
    fetched :: publication_tuf_test_command(root, consumer, bare, store, [String]{"fetch"}).run() ?? panic("fetch")
    assert(fetched.success, fetched.errors)
    installed := StoreEntry?{None}
    loop stored in store_list(&verification, roots) {
        if stored.name == "textkit" && stored.version == "1.2.0" -> installed = Val(stored)
    }
    entry :: installed ?? panic("registry fetch must register immutable Hangar metadata")
    assert(entry.out.starts_with(files.join(files.join(roots.root, "hangar"), "objects")))
    assert(files.is_file(files.join(entry.out, "package.jet")))
    assert(!entry.out.starts_with(store))
    lock_path :: files.join(files.join(consumer, ".jet"), "lock")
    lock :: pkg_lock_parse(files.read(lock_path) ?? panic("read lock")) ?? panic("parse canonical lock")
    locked_package := LockedPackage?{None}
    loop package in lock.packages {
        if package.name == "textkit" -> locked_package = Val(package)
    }
    package :: locked_package ?? panic("registry package must be locked")
    if package.source == {
        .Registry(_, _, _, _, _, _, _, _) -> {}
        else -> panic("registry dependency must retain registry lock identity")
    }
    assert_eq(entry.cache_identity.source_fingerprint, package.content_hash ?? panic("registry source hash"))
    assert(entry.envelope.provenance.contains("package=textkit#1.2.0"))
    assert(entry.envelope.provenance.contains("package-policy=package=textkit#1.2.0;license=MIT;source=jet;source-rule=textkit => [jet];fingerprint=sha256-"))
    assert(entry.cache_identity.policy_fingerprint.starts_with("sha256-"))
    facts :: PackageFacts.parse(allowed, manifest_path) ?? panic("canonical policy")
    // Mandatory JP-PUB-POLICY dependency (#4262), not a local encoder.
    assert_eq(entry.cache_identity.policy_fingerprint, publication_policy_fingerprint(facts.policy))
    assert(entry.envelope.provenance.contains("oci-referrers=subject="))
    updated :: publication_tuf_test_command(root, consumer, bare, store, [String]{"update", "textkit"}).run() ?? panic("targeted update")
    assert(updated.success, updated.errors)
    semantic_lock :: files.read(lock_path) ?? panic("semantic lock")
    loop field in ([String]{"adapter-id = \"registry.pubgrub\"", "update-command = \"jet update textkit\"", "exact = \"textkit#1.2.0\"", "package-policy=package=textkit#1.2.0;license=MIT;source=jet;source-rule=textkit => [jet];fingerprint=sha256-", "pattern = \"textkit\"", "sources = [\"jet\"]"}) -> assert(semantic_lock.contains(field))
    locked :: publication_tuf_test_command(root, consumer, bare, store, [String]{"fetch", "--locked"}).run() ?? panic("locked fetch")
    assert(locked.success, locked.errors)
    same := String?{None}
    loop stored in store_list(&verification, roots) {
        if stored.name == "textkit" && stored.version == "1.2.0" -> same = Val(stored.out)
    }
    if same == {
        .Val(out) -> assert(out == entry.out, "locked consumption must reuse the same immutable Hangar object")
        .None -> panic("locked consumption must reuse the same immutable Hangar object")
    }
    offline :: publication_tuf_test_command(root, consumer, bare, store, [String]{"fetch", "--offline"}).env("JET_REGISTRY_URL", "file://{root}/must-not-be-read.git").run() ?? panic("offline fetch")
    assert(offline.success, offline.errors)
    files.remove_all(root) ?? panic("cleanup")
}
