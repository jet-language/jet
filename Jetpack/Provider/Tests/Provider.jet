#Test("provider core builds local package") {
    verification := StoreVerification.new()
    base :: provider_core_test_dir("jpk-core")
    repo :: files.join(base, "jet-pkgs")
    store :: files.join(base, "store")
    provider_core_test_write(files.join(repo, "pkgs/hello/hello.jet"), "module hello {{ }}\n")
    provider_core_test_write(files.join(repo, "pkgs/hello/bin/hello"), "#!/bin/sh\necho hi\n")
    files.create_dir_all(store) ?? panic("store")
    table :: provider_core_test_table("mine", "path:{repo}", ProviderKind.Core)
    spec :: provider_core_test_spec_in("hello@mine", table)
    ctx :: provider_core_test_ctx(store, false, None, None)
    assert_eq(provider_resolve_kind(spec, table, false, store), ProviderKind.Core)
    realized :: provider_realize(&verification, spec, table, ctx) ?? panic("core realization")
    assert_eq(realized.name, "hello")
    assert(files.is_file(files.join(realized.bin, "hello")))
    expectation :: provider_cache_expectation(&verification, spec, table, ctx) ?? panic("core cache identity")
    assert_eq(expectation.identity, realized.cache_identity)
    shared :: ProviderFacts.from_json(realized.producer.facts.get(PROVIDER_SHARED_FACTS) ?? panic("production provider embeds shared facts")) ?? panic("production provider emits provider-facts JSON")
    shared.validate() ?? panic("production provider facts are lossless")
    assert_eq(shared.reference, realized.reference)
    assert_eq(shared.resolved_source, realized.producer.immutable_source)
    assert(shared.native_document != "")
    assert_eq(realized.producer.facts.get(PROVIDER_SHARED_FACTS_DIGEST), Val(shared.digest()))
    files.remove_all(base) ?? panic("cleanup")
}

// U10 Chunk 4: the repo manifest's `packages:` index decides what a realized
// core package puts on PATH.
#Test("provider core kind decides path entry") {
    verification := StoreVerification.new()
    base :: provider_core_test_dir("jpk-core-kind")
    repo :: files.join(base, "jet-pkgs")
    store :: files.join(base, "store")
    files.create_dir_all(store) ?? panic("store")
    provider_core_test_write(files.join(repo, "package.jet"), "name: \"p\"\nversion: \"0.1.0\"\npackages: {{ hello: executable, mathlib: library }}\n")
    provider_core_test_write(files.join(repo, "pkgs/hello/hello.jet"), "module hello {{ }}\n")
    provider_core_test_write(files.join(repo, "pkgs/hello/bin/hello"), "#!/bin/sh\necho hi\n")
    provider_core_test_write(files.join(repo, "lib/mathlib/mathlib.jet"), "module mathlib {{ }}\n")
    table :: provider_core_test_table("mine", "path:{repo}", ProviderKind.Core)
    ctx :: provider_core_test_ctx(store, false, None, None)
    executable :: provider_realize(&verification, provider_core_test_spec_in("hello@mine", table), table, ctx) ?? panic("executable")
    assert(executable.bin != "" && files.is_file(files.join(executable.bin, "hello")))
    library :: provider_realize(&verification, provider_core_test_spec_in("mathlib@mine", table), table, ctx) ?? panic("library")
    assert_eq(library.bin, "")
    assert(files.is_file(files.join(library.out, "mathlib.jet")))
    files.remove_all(base) ?? panic("cleanup")
}

#Test("provider core fetches remote git package") {
    verification := StoreVerification.new()
    base :: provider_core_test_dir("jpk-core-remote")
    repo :: files.join(base, "remote")
    store :: files.join(base, "store")
    files.create_dir_all(store) ?? panic("store")
    written :: [(path: String, text: String)]{(path: "pkgs/hello/hello.jet", text: "module hello {{ }}\n"), (path: "pkgs/hello/bin/hello", text: "#!/bin/sh\necho remote\n")}
    if !provider_core_test_git_repo(repo, written) {
        print("note: skipping remote core provider test (git not found)")
        return
    }
    table :: provider_core_test_table("mine", "file://{repo}#HEAD", ProviderKind.Core)
    realized :: provider_realize(&verification, provider_core_test_spec_in("hello@mine", table), table, provider_core_test_ctx(store, false, None, None)) ?? panic("remote realization")
    assert_eq(realized.name, "hello")
    assert(files.is_file(files.join(realized.bin, "hello")))
    files.remove_all(base) ?? panic("cleanup")
}

#Test("provider resolve kind probes remote package marker") {
    base :: provider_core_test_dir("jpk-probe")
    store :: files.join(base, "store")
    files.create_dir_all(store) ?? panic("store")
    with :: files.join(base, "with-pack")
    marker :: [(path: String, text: String)]{(path: "package.jet", text: "name: \"p\"\nversion: \"0.1.0\"\n")}
    if !provider_core_test_git_repo(with, marker) {
        print("note: skipping remote probe test (git not found)")
        return
    }
    with_table :: provider_core_test_table("mine", "file://{with}", ProviderKind.Infer)
    with_spec :: provider_core_test_spec_in("hello@mine", with_table)
    assert_eq(provider_resolve_kind(with_spec, with_table, false, store), ProviderKind.Core)
    without :: files.join(base, "no-pack")
    provider_core_test_git_repo(without, [(path: String, text: String)]{(path: "flake.nix", text: "{{}}\n")})
    without_table :: provider_core_test_table("plain", "file://{without}", ProviderKind.Infer)
    assert_eq(provider_resolve_kind(provider_core_test_spec_in("fd@plain", without_table), without_table, false, store), ProviderKind.Nix)
    // Offline with no cached checkout cannot probe.
    cold :: files.join(base, "cold-store")
    files.create_dir_all(cold) ?? panic("cold store")
    assert_eq(provider_resolve_kind(with_spec, with_table, true, cold), ProviderKind.Nix)
    files.remove_all(base) ?? panic("cleanup")
}

