#Test("provider canonical monorepo realization uses the requested member root") {
    verification := StoreVerification.new()
    base :: provider_core_test_dir("jpk-canonical-mono")
    repo :: files.join(base, "mono")
    store :: files.join(base, "store")
    source :: files.join(repo, "packages/hello/src")
    files.create_dir_all(store) ?? panic("store")
    provider_core_test_write(files.join(repo, "package.jet"), "name: \"workspace\"\nmembers: find(\"./packages\")\n")
    provider_core_test_write(files.join(repo, "packages/hello/package.jet"), "name: \"hello\"\nversion: \"0.1.0\"\nsource: \"src\"\noutputs: {{ hello: .Executable{{ entry: run }} }}\ndefaults: {{ run: hello }}\n")
    provider_core_test_write(files.join(source, "main.jet"), "fn run() {{ print(\"hello\") }}\n")
    provider_core_test_write(files.join(repo, "stray/package.jet"), "name: \"stray\"\nversion: \"0.1.0\"\n")
    found :: provider_find_canonical_package(repo, "hello") ?? panic("canonical lookup")
    package :: found ?? panic("member Package must be discoverable")
    assert_eq(package.root, files.join(repo, "packages/hello"))
    assert_eq(package.facts.name, "hello")
    if provider_find_canonical_package(repo, "stray") == {
        .Ok(_) -> panic("a non-member Package must not be found")
        .Err(_) -> {}
    }
    table :: provider_core_test_table("mine", "path:{repo}", ProviderKind.Core)
    spec :: provider_core_test_spec_in("hello@mine", table)
    ctx :: provider_core_test_ctx(store, true, None, None)
    realized :: provider_realize(&verification, spec, table, ctx) ?? panic("canonical realization")
    assert(files.is_file(files.join(realized.out, "main.jet")))
    assert(!files.is_file(files.join(realized.out, "package.jet")))
    assert_eq(realized.version, "0.1.0")
    before :: provider_cache_expectation(&verification, spec, table, ctx) ?? panic("canonical cache identity")
    assert_eq(before.identity, realized.cache_identity)
    files.write(files.join(source, "extra.jet"), "fn extra() {{}}\n") ?? panic("extra source")
    after :: provider_cache_expectation(&verification, spec, table, ctx) ?? panic("changed cache identity")
    assert(before.identity.source_fingerprint != after.identity.source_fingerprint)
    assert(before.owned_output != after.owned_output)
    files.remove_all(base) ?? panic("cleanup")
}

// T0 (D-JPK-CACHE1=A): a first-party library realization carries the full A4
// envelope, and it round-trips through the store record.
#Test("provider core build writes envelope") {
    verification := StoreVerification.new()
    base :: provider_core_test_dir("jpk-envelope")
    repo :: files.join(base, "jet-pkgs")
    store :: files.join(base, "hangar")
    files.create_dir_all(store) ?? panic("store")
    provider_core_test_write(files.join(repo, "package.jet"), "name: \"p\"\nversion: \"0.1.0\"\npackages: {{ mathlib: library }}\n")
    provider_core_test_write(files.join(repo, "lib/mathlib/mathlib.jet"), "module mathlib {{ }}\n")
    table :: provider_core_test_table("mine", "path:{repo}", ProviderKind.Core)
    realized :: provider_realize(&verification, provider_core_test_spec_in("mathlib@mine", table), table, provider_core_test_ctx(store, false, None, None)) ?? panic("library realization")
    assert(!realized.envelope.is_empty())
    assert(realized.envelope.output_hash.starts_with("sha256-"))
    assert(realized.envelope.platform != "")
    assert(realized.envelope.provenance.contains("mathlib@mine"))
    assert_eq(realized.envelope.signature, "")
    roots :: HangarRoots{root: base, dev_mode: true}
    entry :: store_record_realized_mode(&verification, roots, realized) ?? panic("record")
    assert_eq(entry.envelope, realized.envelope)
    listed :: store_list(&verification, roots)
    found := StoreEntry?{None}
    loop candidate in listed {
        if candidate.id == entry.id -> found = Val(candidate)
    }
    stored :: found ?? panic("recorded entry is listed")
    assert_eq(stored.envelope.output_hash, realized.envelope.output_hash)
    assert_eq(stored.envelope.platform, realized.envelope.platform)
    assert_eq(stored.envelope.provenance, realized.envelope.provenance)
    assert_eq((ProducerRecord.decode(stored.producer_record) ?? panic("producer")).provider, "core")
    files.remove_all(base) ?? panic("cleanup")
}

// D-JPK-SANDBOX2=D: a pinned-looking cargo outside the immutable closure never
// runs, and build scratch is swept after the refusal.
#Test("provider bridge build rejects untrusted toolchain outside native closure") {
    if sys.name() != "linux" -> return
    base :: provider_core_test_dir("jpk-bridge")
    cargo :: files.join(base, "toolchain/cargo")
    provider_core_test_write(cargo, "#!/bin/sh\nmkdir -p \"$CARGO_TARGET_DIR/release\"\nprintf 'PINNED-RLIB-BYTES' > \"$CARGO_TARGET_DIR/release/libmath.rlib\"\nexit 0\n")
    files.set_mode(cargo, 0o755) ?? panic("executable cargo")
    toolchain :: BuildToolchain{cargo, id: "toolchain-test", version: "9.9.9", pinned: true, ring_artifacts: [String: String]{}}
    hangar :: files.join(base, "hangar")
    files.create_dir_all(hangar) ?? panic("hangar")
    pkg :: files.join(base, "pkg")
    provider_core_test_write(files.join(pkg, "Cargo.toml"), "[package]\nname=\"math\"\n")
    if provider_build_rlib_from_cargo(pkg, hangar, toolchain, false) == {
        .Ok(_) -> panic("a tool outside the immutable closure must not run")
        .Err(error) -> assert(error.message().contains("outside the immutable tool closure") || error.message().contains("native sandbox"))
    }
    assert(!files.exists(files.join(pkg, "libmath.rlib")))
    scratch :: files.join(hangar, STORE_BUILD_SCRATCH_DIR)
    if files.list_dir(scratch) == {
        .Ok(entries) -> assert_eq(entries.len(), 0)
        .Err(_) -> {}
    }
    files.remove_all(base) ?? panic("cleanup")
}

// Distinct package trees hash differently; identical trees hash the same.
#Test("provider tree fingerprint reflects contents") {
    base :: provider_core_test_dir("jpk-fp")
    cases :: [(name: String, body: String)]{(name: "a", body: "one"), (name: "b", body: "two"), (name: "c", body: "one")}
    loop case in cases -> provider_core_test_write(files.join(base, "{case.name}/bin/x"), case.body)
    a :: provider_tree_fingerprint(files.join(base, "a")) ?? panic("a")
    b :: provider_tree_fingerprint(files.join(base, "b")) ?? panic("b")
    c :: provider_tree_fingerprint(files.join(base, "c")) ?? panic("c")
    assert(a != b)
    assert_eq(a, c)
    files.remove_all(base) ?? panic("cleanup")
}
