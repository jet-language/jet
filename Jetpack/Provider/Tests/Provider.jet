}

#Test("provider sparse fetch materializes only addressed member") {
    verification := StoreVerification.new()
    base :: provider_core_test_dir("jpk-sparse-one")
    repo :: files.join(base, "mono")
    store :: files.join(base, "store")
    files.create_dir_all(store) ?? panic("store")
    written :: [(path: String, text: String)]{
        (path: "workspace.jet", text: "module workspace {{ members: find(\"./packages\") }}\n"),
        (path: "packages/hello/package.jet", text: "name: \"hello\"\nversion: \"0.1.0\"\n"),
        (path: "packages/hello/hello.jet", text: "module hello {{ }}\n"),
        (path: "packages/hello/bin/hello", text: "#!/bin/sh\necho hi\n"),
        (path: "packages/world/package.jet", text: "name: \"world\"\nversion: \"0.1.0\"\n"),
        (path: "packages/world/world.jet", text: "module world {{ }}\n"),
    }
    if !provider_core_test_git_repo(repo, written) {
        print("note: skipping sparse fetch test (git not found)")
        return
    }
    upstream :: "file://{repo}"
    table :: provider_core_test_table("mine", upstream, ProviderKind.Core)
    realized :: provider_realize(&verification, provider_core_test_spec_in("hello@mine", table), table, provider_core_test_ctx(store, false, None, None)) ?? panic("sparse realization")
    assert_eq(realized.name, "hello")
    cache :: provider_source_cache_dir(store, RemoteSource.parse(upstream) ?? panic("remote"))
    assert(files.is_file(files.join(cache, "packages/hello/package.jet")))
    assert(!files.exists(files.join(cache, "packages/world")))
    assert(files.is_file(files.join(cache, "workspace.jet")))
    files.remove_all(base) ?? panic("cleanup")
}

#Test("provider sparse fetch includes in repo dependency") {
    verification := StoreVerification.new()
    base :: provider_core_test_dir("jpk-sparse-dep")
    repo :: files.join(base, "mono")
    store :: files.join(base, "store")
    files.create_dir_all(store) ?? panic("store")
    // `app` depends on the in-repo `logging` member through an alias (`log`)
    // that differs from the member name: resolution is by path target.
    written :: [(path: String, text: String)]{
        (path: "workspace.jet", text: "module workspace {{ members: find(\"./packages\") }}\n"),
        (path: "packages/app/package.jet", text: "name: \"app\"\nversion: \"0.1.0\"\ndeps: {{ log: ../logging }}\n"),
        (path: "packages/app/app.jet", text: "module app {{ }}\n"),
        (path: "packages/logging/package.jet", text: "name: \"logging\"\nversion: \"0.1.0\"\n"),
        (path: "packages/logging/logging.jet", text: "module logging {{ }}\n"),
        (path: "packages/unrelated/package.jet", text: "name: \"unrelated\"\nversion: \"0.1.0\"\n"),
        (path: "packages/unrelated/unrelated.jet", text: "module unrelated {{ }}\n"),
    }
    if !provider_core_test_git_repo(repo, written) {
        print("note: skipping sparse dep test (git not found)")
        return
    }
    upstream :: "file://{repo}"
    table :: provider_core_test_table("mine", upstream, ProviderKind.Core)
    provider_realize(&verification, provider_core_test_spec_in("app@mine", table), table, provider_core_test_ctx(store, false, None, None)) ?? panic("sparse dependency realization")
    cache :: provider_source_cache_dir(store, RemoteSource.parse(upstream) ?? panic("remote"))
    assert(files.is_file(files.join(cache, "packages/app/package.jet")))
    assert(files.is_file(files.join(cache, "packages/logging/package.jet")))
    assert(!files.exists(files.join(cache, "packages/unrelated")))
    files.remove_all(base) ?? panic("cleanup")
}

