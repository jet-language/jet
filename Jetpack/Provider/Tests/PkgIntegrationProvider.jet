// Ported from pkg.rs:1263-1269.
#Test("pkg integration binary_provider_requires_hash_and_platform") {
    if ProviderObject.binary("tool", "", "linux", "") == {
        .Ok(_) -> panic("empty hash must fail")
        .Err(_) -> {}
    }
    if ProviderObject.binary("tool", "sha256-aa", "", "") == {
        .Ok(_) -> panic("empty platform must fail")
        .Err(_) -> {}
    }
    object :: ProviderObject.binary("tool", "sha256-aa", "linux", "") ?? panic("hash + platform ok")
    assert_eq(object.exact_identity, "binary:tool:linux:sha256-aa")
}

// Ported from pkg.rs:1272-1283.
#Test("pkg integration provider_fetch_denied_under_offline_without_lock") {
    decision :: AuthorityGraph.empty().fetch_allowed(ProviderRequest{family: ProviderFamily.Cargo, ref_key: "serde", exact_identity: "cargo:serde@1", hash: "sha256-aa", platform: "any", offline: true})
    assert_eq(decision, FetchDecision.DeniedOfflineMissingLock)
}

// Ported from pkg.rs:1286-1311.
#Test("pkg integration provider_fetch_allowed_offline_with_satisfied_lock") {
    graph := AuthorityGraph.empty()
    &graph.add_locked(ProviderObject{family: ProviderFamily.Cargo, ref_key: "serde", exact_identity: "cargo:serde@1", hash: "sha256-aa", platform: "any", signature: "", audit: [String]{}, sandbox_effects: [String]{}, build_effects: [String]{}})
    decision :: graph.fetch_allowed(ProviderRequest{family: ProviderFamily.Cargo, ref_key: "serde", exact_identity: "cargo:serde@1", hash: "sha256-aa", platform: "any", offline: true})
    assert_eq(decision, FetchDecision.AllowedOfflineSatisfied)
}

// Ported from pkg.rs:660-686.
#Test("pkg integration lock_satisfied_offline_verbs_do_not_touch_network") {
    graph := AuthorityGraph.empty()
    &graph.add_locked(ProviderObject{family: ProviderFamily.Npm, ref_key: "left-pad", exact_identity: "npm:left-pad@1.0.0", hash: "sha256-aa", platform: "any", signature: "", audit: [String]{}, sandbox_effects: [String]{}, build_effects: [String]{}})
    decision :: graph.fetch_allowed(ProviderRequest{family: ProviderFamily.Npm, ref_key: "left-pad", exact_identity: "npm:left-pad@1.0.0", hash: "sha256-aa", platform: "any", offline: true})
    assert_eq(decision, FetchDecision.AllowedOfflineSatisfied)
}
