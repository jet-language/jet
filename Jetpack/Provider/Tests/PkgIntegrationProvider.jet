// Ported from pkg.rs:1167-1187.
#Test("pkg integration binary_conformance_retains_platform_signature_and_provenance") {
    native :: "{{\"name\":\"tool\",\"version\":\"2.0.0\",\"hash\":\"sha256-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"platforms\":[\"x86_64-linux\"],\"license\":\"MIT\",\"url\":\"https://example.invalid/tool\",\"signature\":{{\"key\":\"pk\",\"value\":\"sig\"}},\"provenance\":{{\"builder\":\"ci\"}},\"sbom\":{{\"format\":\"spdx\"}},\"variants\":{{\"debug\":{{\"features\":[\"trace\"]}}}}}}"
    report :: provider_normalize_document(ProviderFamily.Binary, native)
    provider_test_valid(report, "binary provider facts are lossless")
    assert_eq(report.shared_facts().selector.digest, "sha256-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    assert(report.shared_facts().facts.has_key("provider.binary.signature"))
    assert(report.shared_facts().facts.has_key("provider.binary.provenance"))
    assert_eq(report.shared_facts().native_document, native)
}

