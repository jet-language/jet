// Exact reviewed provider predicates from tests/pkg.rs; package-tests seam.
// Native document bytes are copied from the originals; only Jet interpolation
// braces are escaped. No reference outputs or expectations are fabricated.

fn provider_pkg_integration_contract(contracts: [ProviderFamilyContract], family: ProviderFamily) -> ProviderFamilyContract Never! {
    loop contract in contracts {
        if contract.family == family -> return contract
    }
    panic("original contract find must succeed")
}

fn provider_pkg_integration_report_error(report: ProviderFactReport) -> ProviderGraphError Never! {
    if report.validate() == {
        .Err(error) -> error
        .Ok(_) -> panic("original report validation must fail")
    }
}

// Ported from pkg.rs:919-948.
#Test("pkg integration provider_contract_covers_core_nix_path_github") {
    contracts :: ProviderFamilyContract.built_in()
    families := [ProviderFamily]{}
    loop contract in contracts -> &families.push(contract.family)
    assert(families.contains(ProviderFamily.Core))
    assert(families.contains(ProviderFamily.Nix))
    assert(families.contains(ProviderFamily.Path))
    assert(families.contains(ProviderFamily.Github))
    assert(!provider_pkg_integration_contract(contracts, ProviderFamily.Homebrew).fetches_bytes)
    assert(!provider_pkg_integration_contract(contracts, ProviderFamily.Github).fetches_bytes)
    assert(provider_pkg_integration_contract(contracts, ProviderFamily.Binary).fetches_bytes)
}

// Ported from pkg.rs:951-958.
#Test("pkg integration npm_metadata_normalizes_deps_scripts_bins") {
    facts :: MetadataFacts.from_npm("{{\"name\":\"web\",\"version\":\"1.0.0\",\"license\":\"MIT\",\"dependencies\":{{\"vite\":\"5\"}},\"scripts\":{{\"build\":\"vite build\"}},\"bin\":{{\"web\":\"cli.js\"}}}}")
    assert_eq(facts.dependencies, [String]{"vite"})
    assert_eq(facts.scripts, [String]{"build"})
    assert_eq(facts.bins, [String]{"web"})
}

// Ported from pkg.rs:961-985.
#Test("pkg integration provider_report_round_trips_through_lock_and_explain") {
    native :: "{{\"name\":\"web\",\"version\":\"1.0.0\",\"license\":\"MIT\",\"dependencies\":{{\"vite\":\"5\"}}}}"
    report :: provider_normalize_document(ProviderFamily.Npm, native)
    provider_test_valid(report, "lossless npm report")
    shared :: report.shared_facts()
    assert_eq(shared.qualified_reference(), "web#version=1.0.0@npm")
    assert_eq(shared.native_document, native)
    assert(shared.explain_lines().contains("native json: retained"))
    assert_eq(ProviderFacts.from_json(report.export_json()) ?? panic("shared provider facts JSON"), shared)
    lock :: report.lock_record("app", "web@npm#1.0.0", "any") ?? panic("provider semantic lock")
    assert_eq(lock.identity.exact, "web#version=1.0.0@npm")
    assert_eq(lock.future_fields.get("provider-facts-digest"), Val(shared.digest()))
}

// Ported from pkg.rs:988-1002.
#Test("pkg integration provider_report_surfaces_missing_identity_as_loss") {
    native :: "{{\"name\":\"web\"}}"
    report :: provider_normalize_document(ProviderFamily.Npm, native)
    assert(!report.is_lossless())
    error :: provider_pkg_integration_report_error(report)
    assert(error.message.contains("lossy") || error.message.contains("exact"))
    found := false
    loop loss in report.shared_facts_for("web@npm").losses {
        if loss.reason.contains("exact version") -> found = true
    }
    assert(found)
}

// Ported from pkg.rs:1005-1037.
#Test("pkg integration provider_report_preserves_alias_resolution_and_typed_native_facts") {
    native :: "{{\"name\":\"web\",\"version\":\"1.0.0\",\"yanked\":false}}"
    report :: provider_normalize_document(ProviderFamily.Npm, native)
    shared :: report.shared_facts_for("web@catalog")
    shared.validate() ?? panic("catalog alias remains lossless")
    assert_eq(shared.qualified_reference(), "web#version=1.0.0@catalog")
    assert_eq(shared.native_document, native)
    assert_eq(shared.facts.get("provider.resolved_selector"), Val(ProviderFactValue.Text("#version=1.0.0")))
    assert_eq(shared.facts.get("provider.npm.native.yanked"), Val(ProviderFactValue.List([ProviderFactValue]{ProviderFactValue.Bool(false)})))
    lock :: report.lock_record("app", "web@catalog", "any") ?? panic("alias lock retains source authority")
    assert_eq(lock.identity.exact, "web#version=1.0.0@catalog")
    locked :: provider_test_locked_facts(lock)
    locked.validate() ?? panic("locked alias facts")
    assert_eq(locked.reference, "web@catalog")
}

// Ported from pkg.rs:1040-1058.
#Test("pkg integration swiftpm_v2_report_keeps_revision_and_native_bytes") {
    revision :: "0123456789abcdef0123456789abcdef01234567"
    native :: "{{\"pins\":[{{\"identity\":\"swift-log\",\"state\":{{\"revision\":\"{revision}\",\"version\":\"1.5.4\"}}}}]}}"
    report :: provider_normalize_document(ProviderFamily.SwiftPM, native)
    provider_test_valid(report, "SwiftPM v2 pin is lossless")
    shared :: report.shared_facts()
    assert_eq(shared.qualified_reference(), "swift-log#revision={revision}@swiftpm")
    assert_eq(shared.native_document, native)
    value :: shared.facts.get("provider.revision") ?? panic("revision fact")
    assert(value.debug().contains(revision))
}

// Ported from pkg.rs:1061-1071.
#Test("pkg integration homebrew_report_reads_stable_version_and_dependencies") {
    native :: "{{\"name\":\"jq\",\"versions\":{{\"stable\":\"1.7.1\"}},\"license\":\"MIT\",\"dependencies\":[\"oniguruma\"]}}"
    report :: provider_normalize_document(ProviderFamily.Homebrew, native)
    provider_test_valid(report, "Homebrew formula identity is lossless")
    assert_eq(report.facts.version, "1.7.1")
    assert_eq(report.facts.dependencies, [String]{"oniguruma"})
    assert_eq(report.shared_facts().native_document, native)
}

// Ported from pkg.rs:1074-1105.
#Test("pkg integration homebrew_conformance_retains_bottle_source_and_hook_facts") {
    native :: "{{\"name\":\"jq\",\"full_name\":\"jq\",\"version\":\"1.7.1\",\"versions\":{{\"stable\":\"1.7.1\",\"head\":\"HEAD\"}},\"license\":\"MIT\",\"tap\":\"homebrew/core\",\"dependencies\":[\"oniguruma\"],\"build_dependencies\":[\"pkg-config\"],\"test_dependencies\":[\"bats-core\"],\"recommended_dependencies\":[{{\"name\":\"less\",\"version\":\"1.0\"}}],\"source\":{{\"url\":\"https://example.invalid/jq.tar.gz\",\"sha256\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"}},\"bottle\":{{\"stable\":{{\"files\":{{\"arm64_sonoma\":{{\"url\":\"https://example.invalid/jq.arm64.bottle.tar.gz\",\"sha256\":\"abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789\"}}}}}}}},\"relocatable\":true,\"test\":\"system \\\"#{{bin}}/jq\\\", \\\"--version\\\"\",\"deprecated\":false}}"
    report :: provider_normalize_document(ProviderFamily.Homebrew, native)
    provider_test_valid(report, "Homebrew formula is lossless")
    assert_eq(report.facts.dependencies, [String]{"oniguruma"})
    assert_eq(report.facts.build_dependencies, [String]{"pkg-config"})
    assert_eq(report.facts.dev_dependencies, [String]{"bats-core"})
    assert(report.facts.typed.has_key("provider.homebrew.bottle.arm64_sonoma.sha256"))
    assert(report.shared_facts().facts.has_key("provider.homebrew.hook.test"))
    shared :: report.shared_facts()
    lock :: report.lock_record("app", "jq@homebrew#1.7.1", "x86_64-linux") ?? panic("Homebrew provider lock")
    locked :: provider_test_locked_facts(lock)
    assert_eq(locked, shared)
    assert_eq(locked.native_document, native)
}

