// Ported from pkg.rs:1122-1150.
#Test("pkg integration github_conformance_retains_release_assets_source_and_status") {
    native :: "{{\"name\":\"tool\",\"tag_name\":\"v1.2.3\",\"target_commitish\":\"0123456789abcdef0123456789abcdef01234567\",\"license\":\"MIT\",\"repository\":{{\"full_name\":\"acme/tool\"}},\"draft\":false,\"prerelease\":false,\"assets\":[{{\"name\":\"tool-linux\",\"platform\":\"x86_64-linux\",\"digest\":\"sha256-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"browser_download_url\":\"https://example.invalid/tool\"}}],\"signature\":{{\"key\":\"pk\",\"value\":\"sig\"}},\"advisories\":[\"CVE-0000-0000\"],\"hooks\":{{\"build\":\"reviewed\"}}}}"
    report :: provider_normalize_document(ProviderFamily.Github, native)
    provider_test_valid(report, "GitHub release is lossless")
    assert_eq(report.facts.version, "v1.2.3")
    assert(report.facts.platforms.contains("x86_64-linux"))
    assert(report.facts.typed.has_key("provider.github.revision"))
    assert(report.shared_facts().facts.has_key("provider.github.asset.tool-linux.browser_download_url"))
    shared :: report.shared_facts()
    lock :: report.lock_record("app", "tool@github#v1.2.3", "x86_64-linux") ?? panic("GitHub provider lock")
    locked :: provider_test_locked_facts(lock)
    assert_eq(locked, shared)
    assert_eq(locked.native_document, native)
}

