// Rust: crates/jetpack/src/Provider.rs:2681
#Test("provider_module_stays_split_by_source_ownership") {
    max_module_lines :: 2500
    root :: files.read("Jetpack/Provider/Source/Core/ProviderDispatch.jet") ?? panic("dispatch source")
    remote :: files.read("Jetpack/Provider/Source/Remote/RemoteCheckout.jet") ?? panic("remote source")
    assert(root.lines().len() < max_module_lines)
    assert(remote.lines().len() < max_module_lines)
    // Jet package source ownership replaces Rust's private `mod remote`.
    assert(root.contains("fn provider_resolve_kind("))
    assert(remote.contains("fn provider_fetch_remote_repo("))
    assert(!root.contains("fn provider_fetch_remote_repo("))
    assert(!root.contains("include!("))
    assert(!remote.contains("include!("))
}

