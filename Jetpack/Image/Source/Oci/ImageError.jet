// The Image area's one error carrier. Rust `io::Error` values keep their kind:
// file-system failures travel as `Io`, the builder's `invalid(...)` refusals
// are `InvalidData`, a base that is not an OCI layout is `InvalidInput`, and a
// destination holding different bytes is `AlreadyExists`. JSON failures keep
// the parser's reason (Rust `io::Error::other(error)`).

#Error
ImageError: enum {
    IO(IOError)
    InvalidData(String)
    InvalidInput(String)
    AlreadyExists(String)
    Other(String)

    message: fn(self) -> String Never! {
        if self == {
            .IO(error) -> "{error}"
            .InvalidData(text) -> text
            .InvalidInput(text) -> text
            .AlreadyExists(text) -> text
            .Other(text) -> text
        }
    }

    // Rust `error.kind() == ErrorKind::NotFound`.
    is_not_found: fn(self) -> Bool Never! {
        if self == {
            .IO(error) -> {
                if error == {
                    .NotFound(_) -> true
                    .InvalidInput(_) | .PermissionDenied(_) | .TimedOut(_) | .Cancelled(_) | .Closed(_) | .Protocol(_) | .Other(_) | .ResourceLimit(_) | .AlreadyExists(_) | .Unsupported(_) -> false
                }
            }
            .InvalidData(_) | .InvalidInput(_) | .AlreadyExists(_) | .Other(_) -> false
        }
    }
}

impl IOError -> ImageError { ImageError.IO(self) }

impl EncodingError -> ImageError { ImageError.Other(self.reason) }

// Rust `invalid(message)`: an `InvalidData` refusal with final text.
image_invalid: fn(message: String) -> ImageError Never! {
    ImageError.InvalidData(message)
}
