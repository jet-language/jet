// The deterministic uncompressed layer tar (Rust `build_tar`). Every entry is
// a regular file with mtime 0 (the Unix epoch), uid/gid 0, and no owner names,
// written in the caller's (already path-sorted) order, then the two zero
// end-of-archive blocks. Core's tar writer (D-CORE-TARSTREAM1) owns the ustar
// header encoding and checksum; the layer streams through a stage file beside
// the layout because Core has no in-memory byte writer.

// Build one layer tar from `layer_files` through the stage file `stage`, which
// never outlives the call.
fn image_build_tar(layer_files: [LayerFile], stage: String) -[FS]> [U8] ImageError! {
    image_remove_stale_temporary(stage)
    bytes :: image_write_tar_stage(layer_files, stage) ?? {
        image_remove_quiet(stage)
        return Err(err)
    }
    image_remove_quiet(stage)
    Ok(bytes)
}

fn image_write_tar_stage(layer_files: [LayerFile], stage: String) -[FS]> [U8] ImageError! {
    writer := files.create(stage, if_exists: .Refuse, links: .Refuse)
    layer := archive.tar_writer(&writer)
    loop file in layer_files -> &layer.add_file(file.path, file.data, mode: file.mode)
    &layer.finish()
    &writer.fsync()
    Ok(files.read_bytes(stage))
}
