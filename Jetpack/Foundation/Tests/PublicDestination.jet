// crates/jet-net/src/lib.rs:1079-1100 and strict range/mapped-v6 boundaries,
// asserted against Core's public-destination tables.
use jetpack_foundation.[
    FoundationFetchError, foundation_addresses_are_public, foundation_resolve_public_addresses,
]
use core.net as net
use core.net.ip as ip
use core.http.client as http_client

fn foundation_test_public_v4(a: Int, b: Int, c: Int, d: Int) -> Bool Never! {
    ip.is_public_destination(IPv4{a: a, b: b, c: c, d: d})
}
fn foundation_test_public_v6(words: [Int]) -> Bool Never! {
    ip.ipv6_is_public_destination(IPv6{words: words})
}

#Test("foundation public_destination_policy_rejects_reserved_ipv4_space") {
    loop last in ([Int]{1, 9, 255}) -> assert(!foundation_test_public_v4(192, 0, 0, last))
    assert(foundation_test_public_v4(8, 8, 8, 8))
}
#Test("foundation strict outbound IPv4 refuses every reserved range") {
    assert(!foundation_test_public_v4(0, 1, 2, 3))
    assert(!foundation_test_public_v4(10, 1, 2, 3))
    assert(!foundation_test_public_v4(100, 64, 0, 0))
    assert(!foundation_test_public_v4(100, 127, 255, 255))
    assert(!foundation_test_public_v4(127, 1, 2, 3))
    assert(!foundation_test_public_v4(169, 254, 1, 2))
    assert(!foundation_test_public_v4(172, 16, 0, 0))
    assert(!foundation_test_public_v4(172, 31, 255, 255))
    assert(!foundation_test_public_v4(192, 0, 2, 1))
    assert(!foundation_test_public_v4(192, 88, 99, 2))
    assert(!foundation_test_public_v4(192, 168, 255, 255))
    assert(!foundation_test_public_v4(198, 18, 0, 0))
    assert(!foundation_test_public_v4(198, 19, 255, 255))
    assert(!foundation_test_public_v4(198, 51, 100, 1))
    assert(!foundation_test_public_v4(203, 0, 113, 1))
    assert(!foundation_test_public_v4(224, 0, 0, 1))
    assert(!foundation_test_public_v4(239, 255, 255, 255))
    assert(!foundation_test_public_v4(240, 1, 2, 3))
    assert(!foundation_test_public_v4(255, 255, 255, 255))
}
#Test("foundation strict outbound IPv4 accepted adjacent boundaries") {
    assert(foundation_test_public_v4(1, 0, 0, 0))
    assert(foundation_test_public_v4(100, 63, 255, 255))
    assert(foundation_test_public_v4(100, 128, 0, 0))
    assert(foundation_test_public_v4(169, 253, 255, 255))
    assert(foundation_test_public_v4(169, 255, 0, 0))
    assert(foundation_test_public_v4(172, 15, 255, 255))
    assert(foundation_test_public_v4(172, 32, 0, 0))
    assert(foundation_test_public_v4(192, 0, 1, 255))
    assert(foundation_test_public_v4(192, 0, 3, 0))
    assert(foundation_test_public_v4(192, 167, 255, 255))
    assert(foundation_test_public_v4(192, 169, 0, 0))
    assert(foundation_test_public_v4(198, 17, 255, 255))
    assert(foundation_test_public_v4(198, 20, 0, 0))
    assert(foundation_test_public_v4(198, 51, 99, 255))
    assert(foundation_test_public_v4(198, 51, 101, 0))
    assert(foundation_test_public_v4(203, 0, 112, 255))
    assert(foundation_test_public_v4(203, 0, 114, 0))
    assert(foundation_test_public_v4(223, 255, 255, 255))
}
#Test("foundation strict outbound IPv6 global unicast only") {
    assert(foundation_test_public_v6([Int]{8193, 18528, 18528, 0, 0, 0, 0, 34952}))
    assert(foundation_test_public_v6([Int]{8192, 0, 0, 0, 0, 0, 0, 0}))
    assert(foundation_test_public_v6([Int]{16383, 65535, 65535, 65535, 65535, 65535, 65535, 65535}))
    assert(!foundation_test_public_v6([Int]{8191, 65535, 0, 0, 0, 0, 0, 0}))
    assert(!foundation_test_public_v6([Int]{16384, 0, 0, 0, 0, 0, 0, 0}))
    assert(!foundation_test_public_v6([Int]{0, 0, 0, 0, 0, 0, 0, 0}))
    assert(!foundation_test_public_v6([Int]{0, 0, 0, 0, 0, 0, 0, 1}))
    assert(!foundation_test_public_v6([Int]{65280, 0, 0, 0, 0, 0, 0, 1}))
    assert(!foundation_test_public_v6([Int]{64512, 0, 0, 0, 0, 0, 0, 1}))
    assert(!foundation_test_public_v6([Int]{64768, 0, 0, 0, 0, 0, 0, 1}))
    assert(!foundation_test_public_v6([Int]{65152, 0, 0, 0, 0, 0, 0, 1}))
}
#Test("foundation strict outbound IPv6 documentation exception and adjacent words") {
    assert(!foundation_test_public_v6([Int]{8193, 3512, 0, 0, 0, 0, 0, 0}))
    assert(!foundation_test_public_v6([Int]{8193, 3512, 65535, 65535, 65535, 65535, 65535, 65535}))
    assert(foundation_test_public_v6([Int]{8193, 3511, 0, 0, 0, 0, 0, 0}))
    assert(foundation_test_public_v6([Int]{8193, 3513, 0, 0, 0, 0, 0, 0}))
    assert(foundation_test_public_v6([Int]{8195, 3512, 0, 0, 0, 0, 0, 0}))
    assert(!foundation_test_public_v6([Int]{16383, 0, 0, 0, 0, 0, 0, 1}))
    assert(!foundation_test_public_v6([Int]{16383, 4095, 65535, 65535, 65535, 65535, 65535, 65535}))
    assert(foundation_test_public_v6([Int]{16383, 4096, 0, 0, 0, 0, 0, 0}))
}
#Test("foundation strict outbound IPv6 refuses tunnels and translation prefixes") {
    assert(!foundation_test_public_v6([Int]{8194, 3512, 0, 0, 0, 0, 0, 0}))
    assert(!foundation_test_public_v6([Int]{8194, 2056, 2056, 0, 0, 0, 0, 1}))
    assert(!foundation_test_public_v6([Int]{8193, 0, 0, 0, 0, 0, 0, 1}))
    assert(!foundation_test_public_v6([Int]{100, 65435, 0, 0, 0, 0, 2056, 2056}))
    assert(!foundation_test_public_v6([Int]{100, 65435, 1, 0, 0, 0, 2056, 2056}))
}
#Test("foundation strict outbound IPv4 mapped IPv6 shares exact IPv4 policy") {
    assert(foundation_test_public_v6([Int]{0, 0, 0, 0, 0, 65535, 2056, 2056}))
    assert(!foundation_test_public_v6([Int]{0, 0, 0, 0, 0, 65535, 32512, 1}))
    assert(!foundation_test_public_v6([Int]{0, 0, 0, 0, 0, 65535, 25664, 1}))
    assert(!foundation_test_public_v6([Int]{0, 0, 0, 0, 0, 65535, 49152, 9}))
    assert(!foundation_test_public_v6([Int]{0, 0, 0, 0, 0, 65535, 49152, 513}))
    assert(!foundation_test_public_v6([Int]{0, 0, 0, 0, 0, 65535, 65535, 65535}))
    assert(!foundation_test_public_v6([Int]{0, 0, 0, 0, 1, 65535, 2056, 2056}))
    assert(!foundation_test_public_v6([Int]{0, 0, 0, 0, 0, 65534, 2056, 2056}))
}

#Test("foundation all DNS answers must be public including mapped IPv6") {
    public :: net.socket_addr("8.8.8.8", 443) ?? panic("public socket")
    private :: net.socket_addr("127.0.0.1", 443) ?? panic("private socket")
    mapped :: net.socket_addr("::ffff:127.0.0.1", 443) ?? panic("mapped socket")
    mapped_public :: net.socket_addr("::ffff:8.8.8.8", 443) ?? panic("mapped public socket")
    public_v6 :: net.socket_addr("2001:4860:4860::8888", 443) ?? panic("public IPv6 socket")
    assert(!foundation_addresses_are_public([SocketAddr]{}))
    assert(foundation_addresses_are_public([SocketAddr]{public}))
    assert(foundation_addresses_are_public([SocketAddr]{public, mapped_public, public_v6}))
    assert(!foundation_addresses_are_public([SocketAddr]{public, private}))
    assert(!foundation_addresses_are_public([SocketAddr]{private, public}))
    assert(!foundation_addresses_are_public([SocketAddr]{public, mapped}))
}
#Test("foundation resolve public addresses returns the checked numeric endpoint") {
    addresses :: foundation_resolve_public_addresses("[2001:4860:4860::8888]", 443) ?? panic("numeric IPv6 endpoint")
    assert_eq(addresses.len(), 1)
    assert(foundation_addresses_are_public(addresses))
    assert_eq(net.socket_host(addresses[0]), "2001:4860:4860::8888")
    assert_eq(net.socket_port(addresses[0]), 443)
    v4 :: foundation_resolve_public_addresses("8.8.8.8", 53) ?? panic("numeric IPv4 endpoint")
    assert_eq(net.socket_to_string(v4[0]), "8.8.8.8:53")
}
#Test("foundation resolve public addresses refuses private and invalid endpoints") {
    loop host in ([String]{"127.0.0.1", "[::1]", "::1", "10.0.0.1", "[::ffff:127.0.0.1]"}) {
        if foundation_resolve_public_addresses(host, 443) == {
            .Err(error) -> assert_eq(error, FoundationFetchError.IO("provider destination resolves to a non-public address"))
            .Ok(_) -> panic("non-public destination {host} accepted")
        }
    }
    if foundation_resolve_public_addresses("8.8.8.8", 70000) == {
        .Err(.IO(detail)) -> assert(detail.starts_with("could not resolve provider destination: ") && detail.contains("port must be in 0..=65535"))
        .Err(error) -> panic("out-of-range port refused as {error}")
        .Ok(_) -> panic("out-of-range port accepted")
    }
}
#Test("foundation comptime_http_fetch_rejects_loopback_before_connecting original") {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("bind loopback fixture")
    address :: net.listener_local_socket_addr(listener) ?? panic("loopback address")
    port :: net.socket_port(address)
    // Rooted/stream fetch arrives with the Jet HTTP client port (#3665); a
    // public-policy-only check cannot stand in for fetch-before-connect proof.
    if foundation_fetch("http://127.0.0.1:{port}/secret") == {
        .Err(error) -> assert("{error}".contains("not public"))
        .Ok(_) -> panic("loopback destination accepted")
    }
}
#Test("foundation a Public request refuses loopback before connecting") {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("bind loopback fixture")
    address :: net.listener_local_socket_addr(listener) ?? panic("loopback address")
    port :: net.socket_port(address)
    // The client's destination policy arrives with the Jet HTTP client port (#3665).
    client :: http_client.Client.new().destinations(.Public)
    if client.send(http_client.request("GET", "http://127.0.0.1:{port}/r")) == {
        .Err(.Policy(_)) -> {}
        .Err(error) -> panic("loopback refused for the wrong reason: {error}")
        .Ok(_) -> panic("loopback destination accepted")
    }
}
