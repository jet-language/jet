// The public tree-hash subclaim. The store install/tamper/E1204 remainder
// stays verbatim in the pkg-lib archive.
use {
    jetpack_foundation.[foundation_tree_hash]
    files: core.files
    sys: core.sys
}

#Test("pkg integration auxiliary file source hash subclaim") {
    root: files.join(sys.temp_dir(), "jet-pkg-auxiliary-hash-{sys.pid()}")
    files.remove_all(root).drop("fixture may be absent")
    source: files.join(root, "src")
    files.create_dir_all(source) ?? panic("mkdir source")
    files.write(files.join(source, "lib.jet"), "x: fn() {{}}\n") ?? panic("source fixture")
    files.write(files.join(source, "package.jet"), "name: \"mylib\"\nversion: \"0.1.0\"\njet: \">=a0.0.43\"\ndescription: \"\"\nlicense: \"MIT\"\nrepository: \"\"\n") ?? panic("manifest fixture")
    files.write_bytes(files.join(source, "runtime.data"), "trusted bytes\n".bytes()) ?? panic("trusted auxiliary")
    source_hash: foundation_tree_hash(source)
    files.write_bytes(files.join(source, "runtime.data"), "hostile bytes\n".bytes()) ?? panic("hostile auxiliary")
    assert(source_hash != foundation_tree_hash(source))
    files.remove_all(root).drop("original cleanup result unasserted")
}
