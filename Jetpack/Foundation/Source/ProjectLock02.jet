// Native continuation of Foundation.ProjectLock, not a second public lock policy.
// GATE #4494: std File/OpenOptions own real native handles and close on scope exit;
// raw imports below must bind Core OS providers, never Rust callbacks.
use std.fs.[File, OpenOptions]
use core.sys.target.[selected_os, selected_family]
use core.sys.host.unix_fd.[fcntl, flock, last_error]
use core.sys.host.windows_file.[SetHandleInformation, GetFileInformationByHandle, LockFileEx, UnlockFileEx]

// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:21
LOCK_F_GETFD :: 1
LOCK_F_SETFD :: 2
LOCK_FD_CLOEXEC :: 1
LOCK_EXCLUSIVE :: 2
LOCK_NONBLOCKING :: 4
LOCK_UNLOCK :: 8
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:27
fn runtime_lock_nofollow() -> I32 {
    // GATE #4483: selected target, not the machine running the compiler.
    if selected_os() == "linux" || selected_os() == "android" -> 0o400000 else -> 0x00000100
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:40
// fcntl -> core.sys.host.unix_fd.fcntl (two/three argument native ABI #4494).
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:41
// flock -> core.sys.host.unix_fd.flock (native ABI #4494).
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:44
struct UnixLockFile {
    owner: File
    marker: File
    owner_path: OSPath
    marker_path: OSPath
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:53
fn unix_lock_open(path: OSPath) -> UnixLockFile IOError! { unix_lock_open_mode(path, true) }
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:57
fn unix_lock_open_existing(path: OSPath) -> UnixLockFile IOError! { unix_lock_open_mode(path, false) }
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:61
fn unix_lock_open_mode(path: OSPath, create: Bool) -> UnixLockFile IOError! {
    owner_path :: unix_lock_canonical_owner(path)
    owner :: OpenOptions.new().read(true).custom_flags(runtime_lock_nofollow()).open(owner_path)
    unix_lock_set_close_on_exec(owner)
    marker :: OpenOptions.new().read(true).write(true).create(create).custom_flags(runtime_lock_nofollow()).open(path)
    unix_lock_set_close_on_exec(marker)
    lock :: UnixLockFile{owner: ^owner, marker: ^marker, owner_path: ^owner_path, marker_path: path}
    unix_lock_validate_path(lock, path)
    Ok(^lock)
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:85
fn unix_lock_canonical_owner(path: OSPath) -> OSPath IOError! {
    lock_dir :: path.parent() ?? return Err(runtime_lock_backend_error(.InvalidInput, "jetpack lock path has no directory"))
    root :: lock_dir.parent() ?? return Err(runtime_lock_backend_error(.InvalidInput, "jetpack lock path has no managed root"))
    std.fs.canonicalize(root)
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:101
fn unix_lock_validate_identity(file: &File, path: OSPath, directory: Bool) -> IOError! {
    at_path :: std.fs.symlink_metadata(path)
    held :: file.metadata()
    expected_kind :: if directory -> at_path.file_type().is_dir() && held.file_type().is_dir() else -> at_path.file_type().is_file() && held.file_type().is_file()
    if !expected_kind || at_path.dev() != held.dev() || at_path.ino() != held.ino() {
        return Err(runtime_lock_backend_error(.Other, "jetpack lock ownership path `{path.display()}` changed"))
    }
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:121
fn unix_lock_validate_path(lock: &UnixLockFile, path: OSPath) -> IOError! {
    if path != lock.marker_path -> return Err(runtime_lock_backend_error(.InvalidInput, "jetpack lock validation used a different marker path"))
    unix_lock_validate_identity(&lock.owner, lock.owner_path, true)
    unix_lock_validate_identity(&lock.marker, path, false)
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:132
fn unix_lock_set_close_on_exec(file: &File) -> IOError! {
    fd :: file.as_raw_fd()
    #Unsafe("live file owns descriptor; fcntl reads and changes only descriptor flags") {
        flags :: fcntl(fd, LOCK_F_GETFD)
        if flags < 0 -> return Err(last_error(.Write, None))
        if fcntl(fd, LOCK_F_SETFD, flags | LOCK_FD_CLOEXEC) < 0 -> return Err(last_error(.Write, None))
    }
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:146
fn unix_lock_set_inheritable(lock: &UnixLockFile) -> IOError! {
    fd :: lock.owner.as_raw_fd()
    #Unsafe("live owner descriptor; clear only close-on-exec for the child lease") {
        flags :: fcntl(fd, LOCK_F_GETFD)
        if flags < 0 -> return Err(last_error(.Write, None))
        if fcntl(fd, LOCK_F_SETFD, flags & !LOCK_FD_CLOEXEC) < 0 -> return Err(last_error(.Write, None))
    }
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:160
fn unix_lock_try_lock(lock: &UnixLockFile) -> Bool IOError! {
    #Unsafe("owner is the live canonical managed-root directory descriptor") {
        if flock(lock.owner.as_raw_fd(), LOCK_EXCLUSIVE | LOCK_NONBLOCKING) == 0 -> return Ok(true)
    }
    error :: last_error(.Write, None)
    // GATE #4409: only WouldBlock becomes contention, every other errno survives.
    if error.kind() == .WouldBlock -> Ok(false) else -> Err(error)
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:173
fn unix_lock_unlock(lock: &UnixLockFile) -> IOError! {
    #Unsafe("live owner descriptor locked by flock; unlock the same domain") {
        if flock(lock.owner.as_raw_fd(), LOCK_UNLOCK) == 0 -> return
    }
    return Err(last_error(.Write, None))
}

// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:219
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unsupported.rs:4
struct UnsupportedLockFile {}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:231
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unsupported.rs:6
fn runtime_lock_unsupported() -> IOError {
    message :: if selected_family() == "unix" -> "Jetpack advisory locks are unsupported on this Unix target" else -> "Jetpack advisory locks are unsupported on this target"
    runtime_lock_backend_error(.Unsupported, message)
}
fn runtime_lock_backend_error(kind: IOErrorKind, message: String) -> IOError {
    // GATE #4409: retain InvalidInput, Other and Unsupported independently.
    IOError.new(kind, IOContext{operation: .Write, resource: None, os_code: None, cause: Val(message)})
}

// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:8
// Handle -> native Core windows_file handle pointer; never an Int.
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:10
LOCK_FILE_SHARE_READ :: U32{0x00000001}
LOCK_FILE_SHARE_WRITE :: U32{0x00000002}
LOCK_FILE_ATTRIBUTE_REPARSE_POINT :: U32{0x00000400}
LOCK_FILE_FLAG_BACKUP_SEMANTICS :: U32{0x02000000}
LOCK_FILE_FLAG_OPEN_REPARSE_POINT :: U32{0x00200000}
LOCK_HANDLE_FLAG_INHERIT :: U32{0x00000001}
LOCKFILE_FAIL_IMMEDIATELY :: U32{0x00000001}
LOCKFILE_EXCLUSIVE_LOCK :: U32{0x00000002}
LOCK_ERROR_LOCK_VIOLATION :: I32{33}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:21
// GATE #4494/#4483: exact repr(C) OVERLAPPED layout, selected pointer-sized fields.
struct LockOverlapped {
    internal: USize
    internal_high: USize
    offset: [U32; 2]
    event: *U8
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:29
struct LockFileTime { low: U32, high: U32 }
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:35
// GATE #4494: repr(C) BY_HANDLE_FILE_INFORMATION in declaration order.
struct LockByHandleFileInformation {
    attributes: U32
    creation_time: LockFileTime
    last_access_time: LockFileTime
    last_write_time: LockFileTime
    volume_serial: U32
    size_high: U32
    size_low: U32
    links: U32
    file_index_high: U32
    file_index_low: U32
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:49
struct LockFileIdentity {
    volume_serial: U32
    file_index_high: U32
    file_index_low: U32
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:55
struct WindowsLockFile {
    file: File
    path: OSPath
    identity: LockFileIdentity
    parents: [LockPinnedComponent]
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:62
struct LockPinnedComponent { file: File, path: OSPath, identity: LockFileIdentity }
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:69
// SetHandleInformation -> core.sys.host.windows_file.SetHandleInformation.
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:70
// GetFileInformationByHandle -> core.sys.host.windows_file.GetFileInformationByHandle.
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:72
// LockFileEx -> core.sys.host.windows_file.LockFileEx.
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:80
// UnlockFileEx -> core.sys.host.windows_file.UnlockFileEx (all four raw imports #4494).
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:89
fn windows_lock_overlapped() -> LockOverlapped {
    LockOverlapped{internal: 0, internal_high: 0, offset: [0, 0], event: std.ptr.null_mut()}
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:98
fn windows_lock_open(path: OSPath) -> WindowsLockFile IOError! { windows_lock_open_with_create(path, true) }
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:102
fn windows_lock_open_existing(path: OSPath) -> WindowsLockFile IOError! { windows_lock_open_with_create(path, false) }
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:106
fn windows_lock_open_with_create(path: OSPath, create: Bool) -> WindowsLockFile IOError! {
    parents :: windows_lock_pin_parent_components(path)
    file :: windows_lock_open_raw(path, create)
    identity :: windows_lock_file_identity(file)
    lock :: WindowsLockFile{file: ^file, path, identity, parents: ^parents}
    windows_lock_validate_path(lock, path)
    Ok(^lock)
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:124
fn windows_lock_pin_parent_components(path: OSPath) -> [LockPinnedComponent] IOError! {
    parent :: path.parent() ?? return Err(runtime_lock_backend_error(.InvalidInput, "jetpack lock path has no parent"))
    paths := [OSPath]{}
    loop component in parent.ancestors() {
        if !component.as_os_str().is_empty() -> &paths.push(component)
    }
    &paths.reverse()
    pinned := [LockPinnedComponent]{}
    loop component in paths {
        file :: windows_lock_open_directory_raw(component)
        identity :: windows_lock_file_identity(file)
        &pinned.push(LockPinnedComponent{file: ^file, path: ^component, identity})
    }
    Ok(^pinned)
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:150
fn windows_lock_open_raw(path: OSPath, create: Bool) -> File IOError! {
    file :: OpenOptions.new().read(true).write(true).create(create).custom_flags(LOCK_FILE_FLAG_OPEN_REPARSE_POINT).share_mode(LOCK_FILE_SHARE_READ | LOCK_FILE_SHARE_WRITE).open(path)
    #Unsafe("live file owns handle; change inheritance metadata only") {
        if SetHandleInformation(file.as_raw_handle(), LOCK_HANDLE_FLAG_INHERIT, 0) == 0 -> return Err(core.sys.host.windows_file.last_error(.Write, None))
    }
    if file.metadata().file_attributes() & LOCK_FILE_ATTRIBUTE_REPARSE_POINT != 0 {
        return Err(runtime_lock_backend_error(.Other, "jetpack lock path `{path.display()}` is a reparse point"))
    }
    Ok(^file)
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:175
fn windows_lock_open_directory_raw(path: OSPath) -> File IOError! {
    // Metadata-only access, no directory listing right and no delete sharing.
    file :: OpenOptions.new().access_mode(0).custom_flags(LOCK_FILE_FLAG_OPEN_REPARSE_POINT | LOCK_FILE_FLAG_BACKUP_SEMANTICS).share_mode(LOCK_FILE_SHARE_READ | LOCK_FILE_SHARE_WRITE).open(path)
    #Unsafe("live directory handle; inheritance metadata only") {
        if SetHandleInformation(file.as_raw_handle(), LOCK_HANDLE_FLAG_INHERIT, 0) == 0 -> return Err(core.sys.host.windows_file.last_error(.Write, None))
    }
    if file.metadata().file_attributes() & LOCK_FILE_ATTRIBUTE_REPARSE_POINT != 0 {
        return Err(runtime_lock_backend_error(.Other, "jetpack lock parent `{path.display()}` is a reparse point"))
    }
    Ok(^file)
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:198
fn windows_lock_file_identity(file: &File) -> LockFileIdentity IOError! {
    information := std.mem.MaybeUninit<LockByHandleFileInformation>.uninit()
    #Unsafe("live handle; success initializes complete native output before assume_init") {
        if GetFileInformationByHandle(file.as_raw_handle(), information.as_mut_ptr()) == 0 -> return Err(core.sys.host.windows_file.last_error(.Read, None))
        initialized :: information.assume_init()
        return Ok(LockFileIdentity{volume_serial: initialized.volume_serial, file_index_high: initialized.file_index_high, file_index_low: initialized.file_index_low})
    }
}
fn windows_lock_same_identity(left: LockFileIdentity, right: LockFileIdentity) -> Bool {
    left.volume_serial == right.volume_serial && left.file_index_high == right.file_index_high && left.file_index_low == right.file_index_low
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:215
fn windows_lock_validate_path(lock: &WindowsLockFile, path: OSPath) -> IOError! {
    if path != lock.path -> return Err(runtime_lock_backend_error(.Other, "jetpack lock validation path changed"))
    if lock.file.metadata().file_attributes() & LOCK_FILE_ATTRIBUTE_REPARSE_POINT != 0 -> return Err(runtime_lock_backend_error(.Other, "jetpack lock handle became a reparse point"))
    loop component in lock.parents {
        if component.file.metadata().file_attributes() & LOCK_FILE_ATTRIBUTE_REPARSE_POINT != 0 {
            return Err(runtime_lock_backend_error(.Other, "jetpack lock parent `{component.path.display()}` became a reparse point"))
        }
        reopened :: windows_lock_open_directory_raw(component.path)
        if !windows_lock_same_identity(windows_lock_file_identity(reopened), component.identity) {
            return Err(runtime_lock_backend_error(.Other, "jetpack lock parent `{component.path.display()}` changed file identity"))
        }
    }
    reopened :: windows_lock_open_raw(path, false)
    if !windows_lock_same_identity(windows_lock_file_identity(reopened), lock.identity) {
        return Err(runtime_lock_backend_error(.Other, "jetpack lock path `{path.display()}` changed file identity"))
    }
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:249
fn windows_lock_try_lock(lock: &WindowsLockFile) -> Bool IOError! {
    state := windows_lock_overlapped()
    #Unsafe("live file handle; initialized OVERLAPPED retained through synchronous native call") {
        if LockFileEx(lock.file.as_raw_handle(), LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY, 0, 1, 0, &state) != 0 -> return Ok(true)
    }
    error :: core.sys.host.windows_file.last_error(.Write, None)
    if error.raw_os_error() == Val(LOCK_ERROR_LOCK_VIOLATION) -> Ok(false) else -> Err(error)
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:273
fn windows_lock_unlock(lock: &WindowsLockFile) -> IOError! {
    state := windows_lock_overlapped()
    #Unsafe("live handle; unlock exactly the one-byte range at offset zero") {
        if UnlockFileEx(lock.file.as_raw_handle(), 0, 1, 0, &state) != 0 -> return
    }
    return Err(core.sys.host.windows_file.last_error(.Write, None))
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/windows.rs:283
fn windows_lock_set_inheritable(lock: &WindowsLockFile) -> IOError! {
    #Unsafe("live lock file handle; enable inheritance for the next child launch") {
        if SetHandleInformation(lock.file.as_raw_handle(), LOCK_HANDLE_FLAG_INHERIT, LOCK_HANDLE_FLAG_INHERIT) != 0 -> return
    }
    return Err(core.sys.host.windows_file.last_error(.Write, None))
}

// The original cfg/reexports select one backend, not three lock policies.
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:183
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:195
fn runtime_lock_unix_supported() -> Bool {
    os :: selected_os()
    os == "linux" || os == "android" || os == "macos" || os == "ios" || os == "freebsd" || os == "dragonfly" || os == "openbsd" || os == "netbsd"
}
enum BackendLockFile { Unix(UnixLockFile), Windows(WindowsLockFile), Unsupported(UnsupportedLockFile) }
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:248
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unsupported.rs:13
fn runtime_lock_backend_open(path: OSPath) -> BackendLockFile IOError! {
    if selected_os() == "windows" -> return Ok(.Windows(windows_lock_open(path)))
    if selected_family() == "unix" && runtime_lock_unix_supported() -> return Ok(.Unix(unix_lock_open(path)))
    Err(runtime_lock_unsupported())
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:262
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unsupported.rs:17
fn runtime_lock_backend_open_existing(path: OSPath) -> BackendLockFile IOError! {
    if selected_os() == "windows" -> return Ok(.Windows(windows_lock_open_existing(path)))
    if selected_family() == "unix" && runtime_lock_unix_supported() -> return Ok(.Unix(unix_lock_open_existing(path)))
    Err(runtime_lock_unsupported())
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:276
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unsupported.rs:21
fn runtime_lock_backend_validate_path(lock: &BackendLockFile, path: OSPath) -> IOError! {
    if lock == {
        .Unix(file) -> unix_lock_validate_path(&file, path)
        .Windows(file) -> windows_lock_validate_path(&file, path)
        .Unsupported(_) -> Err(runtime_lock_unsupported())
    }
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:290
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unsupported.rs:25
fn runtime_lock_backend_try_lock(lock: &BackendLockFile) -> Bool IOError! {
    if lock == {
        .Unix(file) -> unix_lock_try_lock(&file)
        .Windows(file) -> windows_lock_try_lock(&file)
        .Unsupported(_) -> Err(runtime_lock_unsupported())
    }
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:304
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unsupported.rs:29
fn runtime_lock_backend_unlock(lock: &BackendLockFile) -> IOError! {
    if lock == {
        .Unix(file) -> unix_lock_unlock(&file)
        .Windows(file) -> windows_lock_unlock(&file)
        .Unsupported(_) -> Err(runtime_lock_unsupported())
    }
}
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unix.rs:318
// Rust: crates/jetpack/src/RuntimePolicy/Lock/unsupported.rs:33
fn runtime_lock_backend_set_inheritable(lock: &BackendLockFile) -> IOError! {
    if lock == {
        .Unix(file) -> unix_lock_set_inheritable(&file)
        .Windows(file) -> windows_lock_set_inheritable(&file)
        .Unsupported(_) -> Err(runtime_lock_unsupported())
    }
}
