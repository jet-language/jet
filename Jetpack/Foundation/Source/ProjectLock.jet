// RuntimePolicy root advisory coordination. The managed root's dedicated
// regular lock file is the ONE kernel domain; marker names are never ownership
// evidence. Every operation retains the original Foundation authority,
// including the marker's parent, and revalidates that held chain around every
// claim.
//
// Every scope of one canonical managed root shares `.jetpack.lock`, a regular
// file outside the replaceable `.locks` marker directory. FILELOCK1 creates it
// owner-only, refuses a final link and never unlinks it when releasing a claim.
// Per-scope markers remain the visible names probes inspect. File contents,
// PID reuse, timestamps and path existence are never liveness evidence.
use core.files as files
use core.time as time


RUNTIME_LOCK_DIR :: ".locks"
RUNTIME_LOCK_OWNER_FILE :: ".jetpack.lock"
// Rust LOCK_WAIT: a contended acquire gives up after 30 seconds.
RUNTIME_LOCK_WAIT_SECONDS :: 30
RUNTIME_LOCK_MARKER_MODE :: 0o600
RUNTIME_LOCK_POLL_MS :: 1

// Kernel state of one managed-root lock domain.
enum RuntimeLockState {
    Absent
    Held
    Idle
}

// A held process lock. `owner` is the FILELOCK1 lock on the canonical managed
// root's dedicated regular file `owner_path`; `marker` pins the scope marker
// inode that `path` must keep naming. Scope exit releases the kernel lock; both
// files always stay on disk.
struct RuntimeLock {
    path: String
    owner_path: String
    owner: FileLock
    marker: FileReader
    authority: FoundationDirectoryAuthority
    marker_parent: FoundationDirectoryAuthority
    marker_name: String

    fn revalidate(self) IOError! -[FS]> {
        self.authority.revalidate()
        env_lock_validate_marker(self.marker_parent, self.marker, self.marker_name, self.path)
    }
}

struct RuntimeLockScope {
    authority: FoundationDirectoryAuthority
    marker_parent: FoundationDirectoryAuthority
    marker: FileReader
    name: String
    path: String
}

// Rust `drop(lock)`: release the kernel lock now instead of at scope exit.
// Both files stay on disk so every later opener locks the same owner inode.
impl RuntimeLock.Close {
    fn close(^self) {}
}

// Rust `lock_path_for_scope`.
fn env_lock_path_for_scope(root: String, scope: String) -> String Never! {
    files.join(files.join(root, RUNTIME_LOCK_DIR), "{env_lock_sanitize_scope(scope)}.lock")
}

// ASCII letters, digits, `-` and `_` survive; every other scalar becomes `_`.
fn env_lock_sanitize_scope(scope: String) -> String Never! {
    out := [String]{}
    loop scalar in scope.chars() {
        text :: "{scalar}"
        bytes :: text.bytes()
        keep :: bytes.len() == 1 && env_lock_scope_byte(Int.from_u8(bytes[0]))
        &out.push(if keep -> text else -> "_")
    }
    if out.len() == 0 -> return "global"
    out.join("")
}

fn env_lock_scope_byte(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 45 || code == 95
}

fn env_lock_io_error(path: String, cause: String) -> IOError Never! {
    IOError.Other(IOContext{operation: .Write, resource: Val(path), os_code: None, cause: Val(cause)})
}

fn env_lock_invalid_input(path: String, cause: String) -> IOError Never! {
    IOError.InvalidInput(IOContext{operation: .Write, resource: Val(path), os_code: None, cause: Val(cause)})
}

// Rust `acquire_lock`: wait up to 30 seconds for the root's lock domain.
fn env_acquire_lock(root: String, scope: String) -[FS, Env, Time]> RuntimeLock IOError! {
    env_acquire_lock_waiting(root, scope, time.duration_seconds(RUNTIME_LOCK_WAIT_SECONDS))
}

// Rust `try_acquire_lock`: claim for recovery without waiting behind a live
// owner. Recovery must hold the claim while inspecting and removing state; a
// probe followed by deletion lets a contender take the same inode in the gap.
fn env_try_acquire_lock(root: String, scope: String) -[FS, Env]> RuntimeLock? IOError! {
    authority :: foundation_open_directory_authority(root, true)
    opened :: env_lock_open_scope(^authority, scope)
    owner :: env_lock_try_owner(opened) ?? return Ok(None)
    Ok(Val(env_lock_hold(^opened, ^owner)))
}

// Rust `acquire_lock_with_timing`: a bounded wait reports IOError.TimedOut.
fn env_acquire_lock_waiting(root: String, scope: String, wait: Duration) -[FS, Env, Time]> RuntimeLock IOError! {
    authority :: foundation_open_directory_authority(root, true)
    env_lock_acquire_opened(env_lock_open_scope(^authority, scope), wait)
}

fn env_lock_acquire_opened(opened: ^RuntimeLockScope, wait: Duration) -[FS, Env, Time]> RuntimeLock IOError! {
    deadline :: time.instant() + wait
    loop {
        if env_lock_try_owner(opened) == .Val(owner) -> return Ok(env_lock_hold(^opened, ^owner))
        remaining :: deadline - time.instant()
        if remaining.ns <= 0 -> return Err(IOError.TimedOut(IOContext{operation: .Write, resource: Val(opened.path), os_code: None, cause: Val("timed out waiting for jetpack lock `{opened.path}`")}))
        poll :: time.duration_ms(RUNTIME_LOCK_POLL_MS)
        time.sleep(if remaining.ns < poll.ns -> remaining else -> poll)
    }
}

// Rust `acquire_lease_lock`. Rust passes the lock to the launched process
// tree; Core cannot pass an open descriptor to a child, so a lease that
// holds it refuses the handoff (`CacheLease.keep_open_for`).
fn env_acquire_lease_lock(root: String, scope: String) -[FS, Env, Time]> RuntimeLock IOError! {
    env_acquire_lock(root, scope)
}

// A scope marker is created/opened only below the original retained root.
fn env_lock_open_scope(authority: ^FoundationDirectoryAuthority, scope: String) -[FS]> RuntimeLockScope IOError! {
    marker_parent :: authority.child(RUNTIME_LOCK_DIR, true)
    name :: "{env_lock_sanitize_scope(scope)}.lock"
    if marker_parent.create_exclusive(name, RUNTIME_LOCK_MARKER_MODE) == {
        .Ok(writer) -> {
            writer.fsync()
            marker_parent.fsync()
        }
        .Err(error) -> if error == {
            .AlreadyExists(_) -> {}
            else -> return Err(error)
        }
    }
    path :: files.join(marker_parent.path(), name)
    env_lock_check_marker_kind(marker_parent, name, path)
    marker :: marker_parent.open_file(name)
    env_lock_validate_marker(marker_parent, marker, name, path)
    Ok(RuntimeLockScope{authority: ^authority, marker_parent: marker_parent, marker: marker, name: name, path: path})
}

// FILELOCK1 on `<canonical managed root>/.jetpack.lock`: created owner-only,
// a final link or a non-regular file is refused, and contention alone is None.
// The retained root chain and the scope marker are revalidated after every
// attempt, so a moved root or replaced marker never yields a claim.
fn env_lock_try_owner(opened: RuntimeLockScope) -[FS, Env]> FileLock? IOError! {
    attempted :: files.try_lock(env_lock_owner_path(opened.authority))
    opened.authority.revalidate()
    env_lock_validate_marker(opened.marker_parent, opened.marker, opened.name, opened.path)
    Ok(attempted)
}
fn env_lock_owner_path(authority: FoundationDirectoryAuthority) -> String Never! {
    files.join(authority.path(), RUNTIME_LOCK_OWNER_FILE)
}
// The lock takes the scope's retained handles; nothing else keeps them.
fn env_lock_hold(opened: ^RuntimeLockScope, owner: ^FileLock) -> RuntimeLock Never! {
    owner_path :: env_lock_owner_path(opened.authority)
    RuntimeLock{path: opened.path, owner_path: owner_path, owner: ^owner, marker: ^opened.marker, authority: ^opened.authority, marker_parent: ^opened.marker_parent, marker_name: opened.name}
}
fn env_lock_check_marker_kind(parent: FoundationDirectoryAuthority, name: String, path: String) IOError! -[FS]> {
    info :: parent.entry_stat(name)
    if !info.is_file || info.is_symlink -> return Err(env_lock_io_error(path, "jetpack lock ownership path `{path}` changed"))
}
fn env_lock_validate_marker(parent: FoundationDirectoryAuthority, marker: FileReader, name: String, path: String) IOError! -[FS]> {
    parent.revalidate()
    at_path :: parent.entry_stat(name)
    held :: marker.stat()
    if !at_path.is_file || at_path.is_symlink || !held.is_file || at_path.id != held.id -> return Err(env_lock_io_error(path, "jetpack lock ownership path `{path}` changed"))
}

// Rust `lock_state`: probe the kernel lock behind one marker. An absent
// marker (or lock directory) is Absent and the probe creates nothing.
fn env_lock_state(path: String) -[FS, Env]> RuntimeLockState IOError! {
    lock_dir :: files.dirname(path)
    if lock_dir == "" -> return Err(env_lock_invalid_input(path, "jetpack lock path has no directory"))
    root :: files.dirname(lock_dir)
    if root == "" -> return Err(env_lock_invalid_input(path, "jetpack lock path has no managed root"))
    authority :: foundation_open_directory_authority(root) ?? {
        if err == .NotFound(_) -> return Ok(RuntimeLockState.Absent)
        return Err(err)
    }
    marker_parent :: authority.child(files.basename(lock_dir)) ?? {
        if err == .NotFound(_) -> return Ok(RuntimeLockState.Absent)
        return Err(err)
    }
    name :: files.basename(path)
    env_lock_check_marker_kind(marker_parent, name, path) ?? {
        if err == .NotFound(_) -> return Ok(RuntimeLockState.Absent)
        return Err(err)
    }
    marker :: marker_parent.open_file(name) ?? {
        if err == .NotFound(_) -> return Ok(RuntimeLockState.Absent)
        return Err(err)
    }
    env_lock_validate_marker(marker_parent, marker, name, path)
    opened :: RuntimeLockScope{authority: authority, marker_parent: marker_parent, marker: marker, name: name, path: path}
    probe :: env_lock_try_owner(opened)
    if probe == None -> return Ok(RuntimeLockState.Held)
    Ok(RuntimeLockState.Idle)
}

// Rust `with_lock` for a single, non-nested scope: the returned lock is held
// until the caller's scope exits.
fn env_runtime_lock(root: String, scope: String) -[FS, Env, Time]> RuntimeLock IOError! {
    env_acquire_lock(root, scope)
}

// Rust `with_project_lock`: the project's managed `.jet` directory.
fn env_runtime_project_lock(project: String, scope: String) -[FS, Env, Time]> RuntimeLock IOError! {
    env_runtime_lock(files.join(project, SOURCE_ROOT_DIR), scope)
}

// One nested lock claim. `lock` is None when an outer claim of the same
// session already holds this root's domain.
struct RuntimeLockGuard {
    root: String
    identity: FileID
    lock: RuntimeLock?
}

// Rust HELD_LOCK_ROOTS: all scopes for one managed root share one kernel lock
// domain, so a nested claim on a root this session already holds reuses the
// outer guard instead of waiting on itself. Jet carries the held set
// explicitly instead of in thread-local state.
struct RuntimeLockSession {
    held_roots: [FileID]

    fn new() -> RuntimeLockSession Never! {
        RuntimeLockSession{held_roots: [FileID]{}}
    }

    fn enter(&self, root: String, scope: String) -[FS, Env, Time]> RuntimeLockGuard IOError! {
        authority :: foundation_open_directory_authority(root, true)
        identity :: authority.identity()
        key :: authority.path()
        if self.held_roots.contains(identity) -> return Ok(RuntimeLockGuard{root: key, identity: identity, lock: None})
        lock :: env_lock_acquire_opened(env_lock_open_scope(^authority, scope), time.duration_seconds(RUNTIME_LOCK_WAIT_SECONDS))
        &self.held_roots.push(identity)
        Ok(RuntimeLockGuard{root: key, identity: identity, lock: Val(lock)})
    }

    // Forget the claim `guard` added, then release its lock at scope exit.
    // A reused guard added nothing and releases nothing.
    fn leave(&self, guard: ^RuntimeLockGuard) Never! {
        if guard.lock == None -> return
        at := self.held_roots.len() - 1
        loop at >= 0 {
            if self.held_roots[at] == guard.identity {
                _ :: &self.held_roots.remove(at, .Slot)
                break
            }
            at -= 1
        }
    }
}
