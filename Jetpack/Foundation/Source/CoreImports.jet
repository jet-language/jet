// The one home for Jetpack's Core imports. The Jetpack unit is assembled into a
// single file, where a `use core.<module> as <alias>` line may appear only once,
// so every area reaches Core through these aliases instead of importing it again.
// Add a module here when an area first needs it.

use core.encoding.json as json
use core.files as files
use core.sys as sys
use core.process as process
use core.time as time
use core.crypto.random as random
use core.crypto as crypto
use core.http as http
use core.http.client as http_client
use core.encoding.base64 as base64
use core.archive as archive
use core.archive.gzip as gzip
use core.net.ip as ip
use core.term as term
use core.archive.zstd as zstd
use core.io as io
use core.net as net
use core.math as math
use core.encoding.hex as hex
