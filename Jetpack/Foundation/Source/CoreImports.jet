// The one home for Jetpack's Core imports. The Jetpack unit is assembled into a
// single file, where an `<alias> :: core.<module>` import may appear only once,
// so every area reaches Core through these aliases instead of importing it again.
// Add a module here when an area first needs it.

use {
    json :: core.encoding.json
    files :: core.files
    sys :: core.sys
    process :: core.process
    time :: core.time
    random :: core.crypto.random
    crypto :: core.crypto
    http :: core.http
    http_client :: core.http.client
    base64 :: core.encoding.base64
    archive :: core.archive
    gzip :: core.archive.gzip
    ip :: core.net.ip
    term :: core.term
    zstd :: core.archive.zstd
    net :: core.net
    math :: core.math
    hex :: core.encoding.hex
    vault :: core.crypto.vault
    http_server :: core.http.server
    // Option A: caller-chosen `encoding.EncodingLimits` for json.parse.
    encoding :: core.encoding
    // Terminal display width (core.text.display_width) for fitting live lines.
    core_text :: core.text
}
