// The shared machine-report value model (jet_foundation::Report). Every command
// `--json` result is one `jet.status/v1` object (`StatusEnvelope`) whose
// `reports` are `jet.report/v4` findings (`ReportEnvelope`): the compiler's one
// CompilerDiagnostic record, then the report extension. Both render through
// Core JSON: each envelope builds one insertion-ordered `Dyn` in the exact
// field order, and `json.to_string` writes it. Status field values are Core
// `Dyn` values.
use {
    json: core.encoding.json
    files: core.files
    sys: core.sys
    crypto: core.crypto
    jet_foundation.[DiagnosticFixSafety, DiagnosticNoFixReasonKind, diagnostic_display_name, diagnostic_fix_safety_word, diagnostic_no_fix_kind_word]
}

REPORT_NAME: "jet.report"

REPORT_VERSION: 4

REPORT_SCHEMA: "jet.report/v4"

STATUS_NAME: "jet.status"

STATUS_VERSION: 1

STATUS_SCHEMA: "jet.status/v1"

// The report model's one failure carrier; the text is the error string.
#Error
ReportError: struct {
    message: String,

    new: fn(message: String) -> ReportError Never! { ReportError{message: message} }
}

// C0, DEL, or C1 (U+0080..U+009F, encoded 0xC2 0x80..0x9F). Foundation sits
// below every area, so the report validators carry their own copy of this
// check.
foundation_text_has_control: fn(value: String) -> Bool Never! {
    raw: value.bytes()
    loop index in 0..<raw.len() {
        code: Int{raw[index]}
        if code < 32 || code == 127 -> return true
        if code == 0xC2 && index + 1 < raw.len() {
            next_code: Int{raw[index + 1]}
            if next_code >= 0x80 && next_code <= 0x9F -> return true
        }
    }
    false
}

// Compact JSON text uses Core's fallible wire projection.
report_json: fn(value: Dyn) -> String ReportError! {
    text: json.to_string(value) ?? return Err(ReportError.new(err.reason))
    Ok(text)
}

report_optional_text: fn(value: String?) -> Dyn Never! {
    if value == {
        .Val(text) -> Dyn.Text(text)
        .None -> Dyn.Null
    }
}

report_optional_int: fn(value: Int?) -> Dyn Never! {
    if value == {
        .Val(number) -> Dyn.Int(number)
        .None -> Dyn.Null
    }
}

report_texts: fn(values: [String]) -> Dyn Never! {
    ^items: [Dyn]{}
    loop value in values -> items.push(Dyn.Text(value))
    Dyn.Array(items)
}

// A reviewed action for a diagnostic that cannot carry an automatic edit.
NoFixReason: struct {
    kind: DiagnosticNoFixReasonKind,
    next: String,

    new: fn(kind: DiagnosticNoFixReasonKind, next: String) -> NoFixReason Never! {
        NoFixReason.try_new(kind, next) ?? panic("NoFixReason::new requires a reviewed next action")
    }

    try_new: fn(kind: DiagnosticNoFixReasonKind, next: String) -> NoFixReason ReportError! {
        reason: NoFixReason{kind: kind, next: next}
        reason.validate()
        Ok(reason)
    }

    validate: fn(self) ReportError! {
        if self.next.trim() == "" {
            return Err(ReportError.new("no-fix reason next action must not be empty"))
        }
        if foundation_text_has_control(self.next) {
            return Err(ReportError.new("no-fix reason next action must not contain control characters"))
        }
    }
}

// One named status field.
StatusField: struct {
    name: String,
    value: Dyn,
}

// Ordered, typed action-specific fields for a status object.
StatusFields: struct {
    entries: [StatusField],

    new: fn() -> StatusFields Never! { StatusFields{entries: [StatusField]{}} }

    with: fn(self, name: String, value: Dyn) -> StatusFields Never! {
        self.try_with(name, value) ?? panic("status fields must have unique, non-empty names")
    }

    try_with: fn(self, name: String, value: Dyn) -> StatusFields ReportError! {
        ^fields: self
        fields.insert(name, value)
        Ok(fields)
    }

    insert: fn(^self, name: String, value: Dyn) ReportError! {
        if name == "" || foundation_text_has_control(name) {
            return Err(ReportError.new("status field names must be non-empty and printable"))
        }
        loop entry in self.entries {
            if entry.name == name -> return Err(ReportError.new("duplicate status field `{name}`"))
        }
        self.entries.push(StatusField{name: name, value: value})
    }

    extend: fn(^self, fields: StatusFields) ReportError! {
        loop entry in fields.entries -> self.insert(entry.name, entry.value)
    }

    is_empty: fn(self) -> Bool Never! { self.entries.len() == 0 }

    // Status fields refuse duplicate names, so an object is re-inserted field
    // by field in document order.
    from_dyn_object: fn(value: [String:Dyn]) -> StatusFields ReportError! {
        ^fields: StatusFields.new()
        loop entry in value -> fields.insert(entry.key, entry.value)
        Ok(fields)
    }
}

// A JSON text as a status field value.
report_status_value_parse: fn(text: String) -> Dyn ReportError! {
    if json.parse(text) == {
        .Ok(tree) -> Ok(tree)
        .Err(error) -> Err(ReportError.new(error.reason))
    }
}

report_status_object: fn(fields: StatusFields) -> Dyn Never! {
    ^object: [String:Dyn]{}
    loop entry in fields.entries -> object[entry.name] = entry.value
    Dyn.Object(object)
}

// The one machine status object for every command `--json` result.
StatusEnvelope: struct {
    action: String,
    ok: Bool,
    reports: [ReportEnvelope],
    fields: StatusFields,

    new: fn(action: String, ok: Bool) -> StatusEnvelope Never! {
        StatusEnvelope{action: action, ok: ok, reports: [ReportEnvelope]{}, fields: StatusFields.new()}
    }

    with_report: fn(self, report: ReportEnvelope) -> StatusEnvelope Never! {
        ^envelope: self
        envelope.reports.push(report.copy())
        envelope
    }

    with_reports: fn(self, reports: [ReportEnvelope]) -> StatusEnvelope Never! {
        ^envelope: self
        loop report in reports -> envelope.reports.push(report.copy())
        envelope
    }

    with_field: fn(self, name: String, value: Dyn) -> StatusEnvelope Never! {
        ^envelope: self
        envelope.fields = envelope.fields.with(name, value)
        envelope
    }

    with_fields: fn(self, fields: StatusFields) -> StatusEnvelope Never! {
        self.try_with_fields(fields) ?? panic("status fields must not duplicate envelope fields")
    }

    try_with_fields: fn(self, fields: StatusFields) -> StatusEnvelope ReportError! {
        ^envelope: self
        envelope.fields.extend(fields)
        Ok(envelope)
    }

    validate: fn(self) ReportError! {
        if self.action == "" -> return Err(ReportError.new("status action must not be empty"))
        if foundation_text_has_control(self.action) {
            return Err(ReportError.new("status action must not contain control characters"))
        }
        loop entry in self.fields.entries {
            if entry.name == {
                "schema" | "action" | "ok" | "reports" -> return Err(ReportError.new("status field `{entry.name}` is reserved"))
                else -> {}
            }
        }
        loop report in self.reports -> report.validate()
    }

    to_tree: fn(self) -> Dyn Never! {
        self.validate() ?? panic("invalid jet.status/v1 envelope")
        ^object: [String:Dyn]{}
        object["schema"] = Dyn.Text(STATUS_SCHEMA)
        object["action"] = Dyn.Text(self.action.copy())
        object["ok"] = Dyn.Bool(self.ok)
        ^reports: [Dyn]{}
        loop report in self.reports -> reports.push(report.to_tree())
        object["reports"] = Dyn.Array(reports)
        loop entry in self.fields.entries -> object[entry.name] = entry.value
        Dyn.Object(object)
    }

    json: fn(self) -> String ReportError! { report_json(self.to_tree()) }

    json_line: fn(self) -> String ReportError! {
        text: self.json() ?? return Err(err)
        Ok("{text}\n")
    }
}

// Render a typed status envelope; reserved keys fail through the one
// validator every producer shares.
report_render_status: fn(action: String, ok: Bool, fields: StatusFields) -> String ReportError! {
    envelope: StatusEnvelope.new(action, ok).try_with_fields(fields) ?? panic("status fields must not duplicate envelope fields")
    envelope.json()
}

// Render one status object with typed report children.
report_render_status_with_reports: fn(action: String, ok: Bool, reports: [ReportEnvelope], fields: StatusFields) -> String ReportError! {
    envelope: StatusEnvelope.new(action, ok).with_reports(reports).try_with_fields(fields) ?? panic("status fields must not duplicate envelope fields")
    envelope.json()
}

// The promise attached to a machine-applicable edit.
FixApplicability: enum {
    Safe,
    Suggested,

    // Applying every edit with this grade is proved to make report progress.
    // Useful to show, but a person must choose whether to apply it.

    as_str: fn(self) -> String Never! {
        if self == {
            .Safe -> "safe"
            .Suggested -> "suggested"
        }
    }
}

// A source identity a report consumer can open from its process. Relative
// disk paths become absolute lexically; synthetic labels such as `<cli>`
// stay labels.
ReportPath: struct {
    priv value: String,

    from_process: fn(value: String) -[FS, Env]> ReportPath Never! {
        if value == "" || value.starts_with("<") -> return ReportPath{value: value}
        ReportPath.from_path(value)
    }

    from_path: fn(path: String) -[FS, Env]> ReportPath Never! {
        if path == "" || path.starts_with("<") -> return ReportPath{value: path}
        if files.is_abs(path) -> return ReportPath{value: report_lexically_normalize(path)}
        if sys.current_dir() == {
            .Ok(cwd) -> ReportPath{value: report_lexically_normalize(files.join(cwd, path))}
            .Err(_) -> ReportPath{value: path}
        }
    }

    as_str: fn(self) -> String Never! { self.value }

    is_empty: fn(self) -> Bool Never! { self.value == "" }
}

// Drop `.`, pop on `..` (never above the root).
report_lexically_normalize: fn(path: String) -> String Never! {
    absolute: path.starts_with("/")
    ^parts: [String]{}
    loop part in path.split("/") {
        if part == {
            "" | "." -> {}
            ".." -> {
                if parts.len() > 0 -> ^_: parts.pop()
            }
            else -> { parts.push(part) }
        }
    }
    joined: parts.join("/")
    if absolute -> return "/{joined}"
    joined
}

// A SourceSpan: byte offsets into the text of `file` ("" for text that came
// from no file).
ReportSpan: struct {
    file: String,
    start: Int,
    end: Int,

    new: fn(file: String, start: Int, end: Int) -> ReportSpan Never! {
        ReportSpan{file: file, start: start, end: end}
    }

    to_tree: fn(self) -> Dyn Never! {
        ^object: [String:Dyn]{}
        object["file"] = Dyn.Text("{self.file}")
        object["start"] = Dyn.Int(self.start)
        object["end"] = Dyn.Int(self.end)
        Dyn.Object(object)
    }
}

// The checked text a span indexes: the file it was read from and the SHA-256
// of the exact bytes checked (a CompilerDiagnosticOrigin).
ReportOrigin: struct {
    path: String?,
    source_digest: String,

    to_tree: fn(self) -> Dyn Never! {
        ^object: [String:Dyn]{}
        object["path"] = report_optional_text(self.path)
        object["source_digest"] = Dyn.Text("{self.source_digest}")
        Dyn.Object(object)
    }
}

// A span and its origin: both null without a span, and the origin null when
// the report holds no snapshot of its text.
report_placed_span: fn(object: ^[String:Dyn], span: ReportSpan?, origin: ReportOrigin?) Never! {
    if span == .Val(found) {
        object["span"] = found.to_tree()
        object["origin"] = if origin == .Val(placed) -> placed.to_tree() else -> Dyn.Null
        return
    }
    object["span"] = Dyn.Null
    object["origin"] = Dyn.Null
}

// One ordered cause in a `jet.report/v4` diagnostic. Every location field is
// independent; an unknown one stays unknown instead of inheriting the root's.
ReportCause: struct {
    code: String,
    line: Int?,
    col: Int?,
    span: ReportSpan?,
    origin: ReportOrigin?,

    new: fn(code: String) -> ReportCause Never! {
        ReportCause{code: code, line: None, col: None, span: None, origin: None}
    }

    // Code-only access for non-report status projections.
    as_str: fn(self) -> String Never! { self.code }

    to_tree: fn(self) -> Dyn Never! {
        ^object: [String:Dyn]{}
        object["code"] = Dyn.Text(self.code.copy())
        report_placed_span(object, self.span, self.origin)
        object["line"] = report_optional_int(self.line)
        object["col"] = report_optional_int(self.col)
        Dyn.Object(object)
    }
}

// One graded repair (a CompilerFixEdit): its span names its own file.
ReportEdit: struct {
    span: ReportSpan,
    new_text: String,
    safety: DiagnosticFixSafety,

    new: fn(span: ReportSpan, new_text: String, safety: DiagnosticFixSafety) -> ReportEdit Never! {
        ReportEdit{span: span, new_text: new_text, safety: safety}
    }

    to_tree: fn(self) -> Dyn Never! {
        ^object: [String:Dyn]{}
        object["span"] = self.span.to_tree()
        object["new_text"] = Dyn.Text(self.new_text.copy())
        object["safety"] = Dyn.Text(diagnostic_fix_safety_word(self.safety))
        Dyn.Object(object)
    }
}

// The crypto finding extension of a report.
ReportCryptoExtension: struct {
    reason: String,
    operation: String,
    expected: String?,
    actual: Int?,
}

ReportExtension: enum {
    Crypto(ReportCryptoExtension),
    BuildError(String),
}

// An already rendered build-error JSON document.

// A `jet.report/v4` diagnostic or machine finding: the record members
// (code, severity, message, why, fix, span, origin, fix_edits), then the
// report extension. `severity` is `error` or `lint`; a lint's `tier` is
// `warning` or `tidy`.
ReportEnvelope: struct {
    schema_name: String,
    schema_version: Int,
    moment: String,
    severity: String,
    tier: String?,
    code: String,
    message: String,
    why: String,
    fix: String,
    applicability: FixApplicability?,
    detail: String?,
    line: Int?,
    col: Int?,
    span: ReportSpan?,
    origin: ReportOrigin?,
    priv fix_edits: [ReportEdit],
    cause: [ReportCause],
    clears: Int,
    extension: ReportExtension?,
    priv no_fix_reason: NoFixReason?,
    denial_kind: String?,
    call_chain: [String],
    scope_chain: [String],
    nearest_granting_scope: String?,

    new: fn(moment: String, severity: String, code: String, message: String, why: String, fix: String) -> ReportEnvelope Never! {
        ReportEnvelope{
            schema_name: REPORT_NAME,
            schema_version: REPORT_VERSION,
            moment: moment,
            severity: severity,
            tier: None,
            code: code,
            message: message,
            why: why,
            fix: fix,
            applicability: None,
            detail: None,
            line: None,
            col: None,
            span: None,
            origin: None,
            fix_edits: [ReportEdit]{},
            cause: [ReportCause]{},
            clears: 0,
            extension: None,
            no_fix_reason: None,
            denial_kind: None,
            call_chain: [String]{},
            scope_chain: [String]{},
            nearest_granting_scope: None,
        }
    }

    push_fix_edit: fn(^self, edit: ReportEdit) ReportError! {
        if self.no_fix_reason != None {
            return Err(ReportError.new("a report cannot carry fix_edits and no_fix_reason"))
        }
        self.fix_edits.push(edit.copy())
    }

    with_fix_edits: fn(self, edits: [ReportEdit]) -> ReportEnvelope ReportError! {
        ^report: self
        loop edit in edits -> report.push_fix_edit(edit)
        Ok(report)
    }

    set_no_fix_reason: fn(^self, reason: NoFixReason) ReportError! {
        reason.validate()
        if self.fix_edits.len() > 0 {
            return Err(ReportError.new("a report cannot carry fix_edits and no_fix_reason"))
        }
        self.no_fix_reason = Val(reason)
    }

    with_no_fix_reason: fn(self, reason: NoFixReason) -> ReportEnvelope ReportError! {
        ^report: self
        report.set_no_fix_reason(reason)
        Ok(report)
    }

    validate: fn(self) ReportError! {
        if self.schema_name != REPORT_NAME || self.schema_version != REPORT_VERSION {
            return Err(ReportError.new("report envelope has an unsupported schema identity"))
        }
        if self.severity != "error" && self.severity != "lint" {
            return Err(ReportError.new("report severity `{self.severity}` is neither `error` nor `lint`"))
        }
        if self.tier == .Val(tier) {
            if self.severity != "lint" -> return Err(ReportError.new("only a lint has a tier"))
            if tier != "warning" && tier != "tidy" {
                return Err(ReportError.new("report tier `{tier}` is neither `warning` nor `tidy`"))
            }
        }
        if self.no_fix_reason == {
            .Val(reason) -> {
                reason.validate()
                if self.fix_edits.len() > 0 {
                    return Err(ReportError.new("a report cannot carry fix_edits and no_fix_reason"))
                }
            }
            .None -> {}
        }
    }

    to_tree: fn(self) -> Dyn Never! {
        self.validate() ?? panic("invalid jet.report/v4 envelope")
        ^object: [String:Dyn]{}
        object["schema"] = Dyn.Text("{self.schema_name}/v{self.schema_version}")
        object["code"] = Dyn.Text(self.code.copy())
        object["severity"] = Dyn.Text(self.severity.copy())
        object["message"] = Dyn.Text(self.message.copy())
        object["why"] = Dyn.Text(self.why.copy())
        object["fix"] = Dyn.Text(self.fix.copy())
        report_placed_span(object, self.span, self.origin)
        ^edits: [Dyn]{}
        loop edit in self.fix_edits -> edits.push(edit.to_tree())
        object["fix_edits"] = Dyn.Array(edits)
        object["moment"] = Dyn.Text(self.moment.copy())
        object["name"] = Dyn.Text(diagnostic_display_name(self.code))
        if self.tier == .Val(tier) -> object["tier"] = Dyn.Text(tier)
        if self.applicability == {
            .Val(applicability) -> { object["applicability"] = Dyn.Text(applicability.as_str()) }
            .None -> {}
        }
        object["detail"] = report_optional_text(self.detail)
        object["denial_kind"] = report_optional_text(self.denial_kind)
        object["call_chain"] = report_texts(self.call_chain)
        object["scope_chain"] = report_texts(self.scope_chain)
        object["nearest_granting_scope"] = report_optional_text(self.nearest_granting_scope)
        object["line"] = report_optional_int(self.line)
        object["col"] = report_optional_int(self.col)
        if self.no_fix_reason == .Val(reason) {
            ^no_fix: [String:Dyn]{}
            no_fix["kind"] = Dyn.Text(diagnostic_no_fix_kind_word(reason.kind))
            no_fix["next"] = Dyn.Text(reason.next)
            object["no_fix_reason"] = Dyn.Object(no_fix)
        }
        ^causes: [Dyn]{}
        loop cause in self.cause -> causes.push(cause.to_tree())
        object["cause"] = Dyn.Array(causes)
        object["clears"] = Dyn.Int(self.clears)
        if self.extension == {
            .Val(extension) -> { report_extension_fields(object, extension) }
            .None -> {}
        }
        Dyn.Object(object)
    }

    json: fn(self) -> String ReportError! { report_json(self.to_tree()) }

    json_line: fn(self) -> String ReportError! {
        text: self.json() ?? return Err(err)
        Ok("{text}\n")
    }
}

// The extension's fields, appended after `clears`.
report_extension_fields: fn(object: ^[String:Dyn], extension: ReportExtension) Never! {
    if extension == {
        .Crypto(crypto) -> {
            object["reason"] = Dyn.Text(crypto.reason)
            object["operation"] = Dyn.Text(crypto.operation)
            if crypto.expected == {
                .Val(expected) -> { object["expected"] = Dyn.Text(expected) }
                .None -> {}
            }
            if crypto.actual == {
                .Val(actual) -> { object["actual"] = Dyn.Int(actual) }
                .None -> {}
            }
        }
        .BuildError(report) -> {
            object["build_error"] = report_status_value_parse(report) ?? panic("a build-error extension is a rendered JSON document")
        }
    }
}
