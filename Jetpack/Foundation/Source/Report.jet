// The shared machine-report value model (jet_foundation::Report). Every
// command `--json` result is one `jet.status/v1` object (`StatusEnvelope`)
// whose `reports` are `jet.report/v3` findings (`ReportEnvelope`). Both
// render through Core JSON: each envelope builds one insertion-ordered
// `Dyn` in the exact Rust field order, and `json.to_string` writes it.
// Status field values are Core `Dyn` values (Rust `StatusValue`).
use core.encoding.json as json
use core.files as files
use core.sys as sys
use core.crypto as crypto


REPORT_NAME :: "jet.report"
REPORT_VERSION :: 3
REPORT_SCHEMA :: "jet.report/v3"
STATUS_NAME :: "jet.status"
STATUS_VERSION :: 1
STATUS_SCHEMA :: "jet.status/v1"

// The report model's one failure carrier; the text is the Rust error string.
#Error
struct ReportError {
    message: String

    fn new(message: String) -> ReportError Never! {
        ReportError{message: message}
    }
}

// Rust `char::is_control` over every scalar: C0, DEL, or C1 (U+0080..U+009F,
// encoded 0xC2 0x80..0x9F). Foundation sits below every area, so the report
// validators carry their own copy of this check.
fn foundation_text_has_control(value: String) -> Bool Never! {
    raw :: value.bytes()
    loop index in 0..<raw.len() {
        code :: Int.from_u8(raw[index])
        if code < 32 || code == 127 -> return true
        if code == 0xC2 && index + 1 < raw.len() {
            next_code :: Int.from_u8(raw[index + 1])
            if next_code >= 0x80 && next_code <= 0x9F -> return true
        }
    }
    false
}

// Compact JSON text uses Core's fallible wire projection.
fn report_json(value: Dyn) -> String ReportError! {
    text :: json.to_string(value) ?? return Err(ReportError.new(err.reason))
    Ok(text)
}

fn report_optional_text(value: String?) -> Dyn Never! {
    if value == {
        .Val(text) -> Dyn.Text(text)
        .None -> Dyn.Null
    }
}

fn report_optional_int(value: Int?) -> Dyn Never! {
    if value == {
        .Val(number) -> Dyn.Int(number)
        .None -> Dyn.Null
    }
}

fn report_texts(values: [String]) -> Dyn Never! {
    items := [Dyn]{}
    loop value in values -> &items.push(Dyn.Text(value))
    Dyn.Array(items)
}

// Why a diagnostic has no machine-applicable edit. The next action is part
// of the value, never inferred from the kind.
enum NoFixReasonKind {
    Behavior
    Design
    Ambiguous

    fn as_str(self) -> String Never! {
        if self == {
            .Behavior -> "behavior"
            .Design -> "design"
            .Ambiguous -> "ambiguous"
        }
    }

    fn parse(value: String) -> NoFixReasonKind ReportError! {
        if value == {
            "behavior" -> Ok(NoFixReasonKind.Behavior)
            "design" -> Ok(NoFixReasonKind.Design)
            "ambiguous" -> Ok(NoFixReasonKind.Ambiguous)
            else -> Err(ReportError.new("unknown no-fix reason kind `{value}`"))
        }
    }
}

// A reviewed action for a diagnostic that cannot carry an automatic edit.
struct NoFixReason {
    kind: NoFixReasonKind
    next: String

    fn new(kind: NoFixReasonKind, next: String) -> NoFixReason Never! {
        NoFixReason.try_new(kind, next) ?? panic("NoFixReason::new requires a reviewed next action")
    }

    fn try_new(kind: NoFixReasonKind, next: String) -> NoFixReason ReportError! {
        reason :: NoFixReason{kind: kind, next: next}
        reason.validate()
        Ok(reason)
    }

    fn validate(self) ReportError! {
        if self.next.trim() == "" -> return Err(ReportError.new("no-fix reason next action must not be empty"))
        if foundation_text_has_control(self.next) -> return Err(ReportError.new("no-fix reason next action must not contain control characters"))
    }
}

// One named status field.
struct StatusField {
    name: String
    value: Dyn
}

// Ordered, typed action-specific fields for a status object.
struct StatusFields {
    entries: [StatusField]

    fn new() -> StatusFields Never! {
        StatusFields{entries: [StatusField]{}}
    }

    fn with(self, name: String, value: Dyn) -> StatusFields Never! {
        self.try_with(name, value) ?? panic("status fields must have unique, non-empty names")
    }

    fn try_with(self, name: String, value: Dyn) -> StatusFields ReportError! {
        fields := self
        &fields.insert(name, value)
        Ok(fields)
    }

    fn insert(&self, name: String, value: Dyn) ReportError! {
        if name == "" || foundation_text_has_control(name) -> return Err(ReportError.new("status field names must be non-empty and printable"))
        loop entry in self.entries {
            if entry.name == name -> return Err(ReportError.new("duplicate status field `{name}`"))
        }
        &self.entries.push(StatusField{name: name, value: value})
    }

    fn extend(&self, fields: StatusFields) ReportError! {
        loop entry in fields.entries -> &self.insert(entry.name, entry.value)
    }

    fn is_empty(self) -> Bool Never! {
        self.entries.len() == 0
    }

    // Rust `StatusValue::parse`: status fields refuse duplicate names, so an
    // object is re-inserted field by field in document order.
    fn from_dyn_object(value: [String: Dyn]) -> StatusFields ReportError! {
        fields := StatusFields.new()
        loop entry in value -> &fields.insert(entry.key, entry.value)
        Ok(fields)
    }
}

// Rust `StatusValue::parse`: a JSON text as a status field value.
fn report_status_value_parse(text: String) -> Dyn ReportError! {
    if json.parse(text) == {
        .Ok(tree) -> Ok(tree)
        .Err(error) -> Err(ReportError.new(error.reason))
    }
}

// Rust `StatusValue::object`.
fn report_status_object(fields: StatusFields) -> Dyn Never! {
    object := [String: Dyn]{}
    loop entry in fields.entries -> object[entry.name] = entry.value
    Dyn.Object(object)
}

// The one machine status object for every command `--json` result.
struct StatusEnvelope {
    action: String
    ok: Bool
    reports: [ReportEnvelope]
    fields: StatusFields

    fn new(action: String, ok: Bool) -> StatusEnvelope Never! {
        StatusEnvelope{action: action, ok: ok, reports: [ReportEnvelope]{}, fields: StatusFields.new()}
    }

    fn with_report(self, report: ReportEnvelope) -> StatusEnvelope Never! {
        envelope := self
        &envelope.reports.push(report)
        envelope
    }

    fn with_reports(self, reports: [ReportEnvelope]) -> StatusEnvelope Never! {
        envelope := self
        loop report in reports -> &envelope.reports.push(report)
        envelope
    }

    fn with_field(self, name: String, value: Dyn) -> StatusEnvelope Never! {
        envelope := self
        envelope.fields = envelope.fields.with(name, value)
        envelope
    }

    fn with_fields(self, fields: StatusFields) -> StatusEnvelope Never! {
        self.try_with_fields(fields) ?? panic("status fields must not duplicate envelope fields")
    }

    fn try_with_fields(self, fields: StatusFields) -> StatusEnvelope ReportError! {
        envelope := self
        &envelope.fields.extend(fields)
        Ok(envelope)
    }

    fn validate(self) ReportError! {
        if self.action == "" -> return Err(ReportError.new("status action must not be empty"))
        if foundation_text_has_control(self.action) -> return Err(ReportError.new("status action must not contain control characters"))
        loop entry in self.fields.entries {
            if entry.name == {
                "schema" | "action" | "ok" | "reports" -> return Err(ReportError.new("status field `{entry.name}` is reserved"))
                else -> {}
            }
        }
        loop report in self.reports -> report.validate()
    }

    fn to_tree(self) -> Dyn Never! {
        self.validate() ?? panic("invalid jet.status/v1 envelope")
        object := [String: Dyn]{}
        object["schema"] = Dyn.Text(STATUS_SCHEMA)
        object["action"] = Dyn.Text(self.action.copy())
        object["ok"] = Dyn.Bool(self.ok)
        reports := [Dyn]{}
        loop report in self.reports -> &reports.push(report.to_tree())
        object["reports"] = Dyn.Array(reports)
        loop entry in self.fields.entries -> object[entry.name] = entry.value
        Dyn.Object(object)
    }

    fn json(self) -> String ReportError! {
        report_json(self.to_tree())
    }

    fn json_line(self) -> String ReportError! {
        text :: self.json() ?? return Err(err)
        Ok("{text}\n")
    }
}

// Render a typed status envelope; reserved keys fail through the one
// validator every producer shares.
fn report_render_status(action: String, ok: Bool, fields: StatusFields) -> String ReportError! {
    envelope :: StatusEnvelope.new(action, ok).try_with_fields(fields) ?? panic("status fields must not duplicate envelope fields")
    envelope.json()
}

// Render one status object with typed report children.
fn report_render_status_with_reports(action: String, ok: Bool, reports: [ReportEnvelope], fields: StatusFields) -> String ReportError! {
    envelope :: StatusEnvelope.new(action, ok).with_reports(reports).try_with_fields(fields) ?? panic("status fields must not duplicate envelope fields")
    envelope.json()
}

// Closed safety classes for machine edits.
enum FixSafety {
    Formatting
    BehaviorPreserving
    APIChanging
    TargetChanging
    NeedsReview

    fn as_str(self) -> String Never! {
        if self == {
            .Formatting -> "formatting"
            .BehaviorPreserving -> "behavior-preserving"
            .APIChanging -> "api-changing"
            .TargetChanging -> "target-changing"
            .NeedsReview -> "needs-review"
        }
    }

    fn auto_apply(self) -> Bool Never! {
        if self == {
            .Formatting | .BehaviorPreserving -> true
            else -> false
        }
    }
}

// The promise attached to a machine-applicable edit.
enum FixApplicability {
    // Applying every edit with this grade is proved to make report progress.
    Safe
    // Useful to show, but a person must choose whether to apply it.
    Suggested

    fn as_str(self) -> String Never! {
        if self == {
            .Safe -> "safe"
            .Suggested -> "suggested"
        }
    }
}

// A source identity a report consumer can open from its process. Relative
// disk paths become absolute lexically; synthetic labels such as `<cli>`
// stay labels.
struct ReportPath {
    priv value: String

    fn from_process(value: String) -[FS, Env]> ReportPath Never! {
        if value == "" || value.starts_with("<") -> return ReportPath{value: value}
        ReportPath.from_path(value)
    }

    fn from_path(path: String) -[FS, Env]> ReportPath Never! {
        if path == "" || path.starts_with("<") -> return ReportPath{value: path}
        if files.is_abs(path) -> return ReportPath{value: report_lexically_normalize(path)}
        if sys.current_dir() == {
            .Ok(cwd) -> ReportPath{value: report_lexically_normalize(files.join(cwd, path))}
            .Err(_) -> ReportPath{value: path}
        }
    }

    fn as_str(self) -> String Never! {
        self.value
    }

    fn is_empty(self) -> Bool Never! {
        self.value == ""
    }
}

// Rust `lexically_normalize`: drop `.`, pop on `..` (never above the root).
fn report_lexically_normalize(path: String) -> String Never! {
    absolute :: path.starts_with("/")
    parts := [String]{}
    loop part in path.split("/") {
        if part == {
            "" | "." -> {}
            ".." -> {
                if parts.len() > 0 {
                    _ := &parts.pop()
                }
            }
            else -> {
                &parts.push(part)
            }
        }
    }
    joined :: parts.join("/")
    if absolute -> return "/{joined}"
    joined
}

struct ReportSpan {
    start: Int
    end: Int

    fn new(start: Int, end: Int) -> ReportSpan Never! {
        ReportSpan{start: start, end: end}
    }

    fn to_tree(self) -> Dyn Never! {
        object := [String: Dyn]{}
        object["start"] = Dyn.Int(self.start)
        object["end"] = Dyn.Int(self.end)
        Dyn.Object(object)
    }
}

fn report_optional_span(span: ReportSpan?) -> Dyn Never! {
    if span == {
        .Val(value) -> value.to_tree()
        .None -> Dyn.Null
    }
}

fn report_optional_path(path: ReportPath?) -> Dyn Never! {
    if path == {
        .Val(file) -> {
            if file.is_empty() -> return Dyn.Null
            Dyn.Text(file.as_str())
        }
        .None -> Dyn.Null
    }
}

// One ordered cause in a `jet.report/v3` diagnostic. Every location field is
// independent; an unknown one stays unknown instead of inheriting the root's.
struct ReportCause {
    code: String
    file: ReportPath?
    line: Int?
    col: Int?
    span: ReportSpan?

    fn new(code: String) -> ReportCause Never! {
        ReportCause{code: code, file: None, line: None, col: None, span: None}
    }

    // Code-only access for non-report status projections.
    fn as_str(self) -> String Never! {
        self.code
    }

    fn to_tree(self) -> Dyn Never! {
        object := [String: Dyn]{}
        object["code"] = Dyn.Text(self.code.copy())
        object["file"] = report_optional_path(self.file)
        object["line"] = report_optional_int(self.line)
        object["col"] = report_optional_int(self.col)
        object["span"] = report_optional_span(self.span)
        Dyn.Object(object)
    }
}

struct ReportEdit {
    file: ReportPath
    span: ReportSpan
    new_text: String
    safety: FixSafety

    fn new(file: ReportPath, span: ReportSpan, new_text: String, safety: FixSafety) -> ReportEdit Never! {
        ReportEdit{file: file, span: span, new_text: new_text, safety: safety}
    }

    fn to_tree(self) -> Dyn Never! {
        object := [String: Dyn]{}
        object["file"] = Dyn.Text(self.file.as_str())
        object["span"] = self.span.to_tree()
        object["new_text"] = Dyn.Text(self.new_text.copy())
        object["safety"] = Dyn.Text(self.safety.as_str())
        Dyn.Object(object)
    }
}

// The crypto finding extension of a report.
struct ReportCryptoExtension {
    reason: String
    operation: String
    expected: String?
    actual: Int?
}

enum ReportExtension {
    Crypto(ReportCryptoExtension)
    // An already rendered build-error JSON document.
    BuildError(String)
}

// A `jet.report/v3` diagnostic or machine finding.
struct ReportEnvelope {
    schema_name: String
    schema_version: Int
    moment: String
    severity: String
    code: String
    what: String
    why: String
    fix: String
    applicability: FixApplicability?
    detail: String?
    file: ReportPath?
    line: Int?
    col: Int?
    span: ReportSpan?
    priv fix_edits: [ReportEdit]
    cause: [ReportCause]
    clears: Int
    extension: ReportExtension?
    priv no_fix_reason: NoFixReason?
    denial_kind: String?
    call_chain: [String]
    scope_chain: [String]
    nearest_granting_scope: String?

    fn new(moment: String, severity: String, code: String, what: String, why: String, fix: String) -> ReportEnvelope Never! {
        ReportEnvelope{
            schema_name: REPORT_NAME,
            schema_version: REPORT_VERSION,
            moment: moment,
            severity: severity,
            code: code,
            what: what,
            why: why,
            fix: fix,
            applicability: None,
            detail: None,
            file: None,
            line: None,
            col: None,
            span: None,
            fix_edits: [ReportEdit]{},
            cause: [ReportCause]{},
            clears: 0,
            extension: None,
            no_fix_reason: None,
            denial_kind: None,
            call_chain: [String]{},
            scope_chain: [String]{},
            nearest_granting_scope: None
        }
    }

    fn push_fix_edit(&self, edit: ReportEdit) ReportError! {
        if self.no_fix_reason != None -> return Err(ReportError.new("a report cannot carry fix_edits and no_fix_reason"))
        &self.fix_edits.push(edit)
    }

    fn with_fix_edits(self, edits: [ReportEdit]) -> ReportEnvelope ReportError! {
        report := self
        loop edit in edits -> &report.push_fix_edit(edit)
        Ok(report)
    }

    fn set_no_fix_reason(&self, reason: NoFixReason) ReportError! {
        reason.validate()
        if self.fix_edits.len() > 0 -> return Err(ReportError.new("a report cannot carry fix_edits and no_fix_reason"))
        self.no_fix_reason = Val(reason)
    }

    fn with_no_fix_reason(self, reason: NoFixReason) -> ReportEnvelope ReportError! {
        report := self
        &report.set_no_fix_reason(reason)
        Ok(report)
    }

    fn validate(self) ReportError! {
        if self.schema_name != REPORT_NAME || self.schema_version != REPORT_VERSION {
            return Err(ReportError.new("report envelope has an unsupported schema identity"))
        }
        if self.no_fix_reason == {
            .Val(reason) -> {
                reason.validate()
                if self.fix_edits.len() > 0 -> return Err(ReportError.new("a report cannot carry fix_edits and no_fix_reason"))
            }
            .None -> {}
        }
    }

    fn to_tree(self) -> Dyn Never! {
        self.validate() ?? panic("invalid jet.report/v3 envelope")
        object := [String: Dyn]{}
        object["schema"] = Dyn.Text("{self.schema_name}/v{self.schema_version}")
        object["moment"] = Dyn.Text(self.moment.copy())
        object["severity"] = Dyn.Text(self.severity.copy())
        object["code"] = Dyn.Text(self.code.copy())
        object["what"] = Dyn.Text(self.what.copy())
        object["why"] = Dyn.Text(self.why.copy())
        object["fix"] = Dyn.Text(self.fix.copy())
        if self.applicability == {
            .Val(applicability) -> object["applicability"] = Dyn.Text(applicability.as_str())
            .None -> {}
        }
        object["detail"] = report_optional_text(self.detail)
        object["denial_kind"] = report_optional_text(self.denial_kind)
        object["call_chain"] = report_texts(self.call_chain)
        object["scope_chain"] = report_texts(self.scope_chain)
        object["nearest_granting_scope"] = report_optional_text(self.nearest_granting_scope)
        object["file"] = report_optional_path(self.file)
        object["line"] = report_optional_int(self.line)
        object["col"] = report_optional_int(self.col)
        object["span"] = report_optional_span(self.span)
        if self.fix_edits.len() > 0 {
            edits := [Dyn]{}
            loop edit in self.fix_edits -> &edits.push(edit.to_tree())
            object["fix_edits"] = Dyn.Array(edits)
        } else {
            if self.no_fix_reason == {
                .Val(reason) -> {
                    no_fix := [String: Dyn]{}
                    no_fix["kind"] = Dyn.Text(reason.kind.as_str())
                    no_fix["next"] = Dyn.Text(reason.next)
                    object["no_fix_reason"] = Dyn.Object(no_fix)
                }
                .None -> object["fix_edits"] = Dyn.Array([Dyn]{})
            }
        }
        causes := [Dyn]{}
        loop cause in self.cause -> &causes.push(cause.to_tree())
        object["cause"] = Dyn.Array(causes)
        object["clears"] = Dyn.Int(self.clears)
        if self.extension == {
            .Val(extension) -> report_extension_fields(&object, extension)
            .None -> {}
        }
        Dyn.Object(object)
    }

    fn json(self) -> String ReportError! {
        report_json(self.to_tree())
    }

    fn json_line(self) -> String ReportError! {
        text :: self.json() ?? return Err(err)
        Ok("{text}\n")
    }
}

// The extension's fields, appended after `clears`.
fn report_extension_fields(object: &[String: Dyn], extension: ReportExtension) Never! {
    if extension == {
        .Crypto(crypto) -> {
            object["reason"] = Dyn.Text(crypto.reason)
            object["operation"] = Dyn.Text(crypto.operation)
            if crypto.expected == {
                .Val(expected) -> object["expected"] = Dyn.Text(expected)
                .None -> {}
            }
            if crypto.actual == {
                .Val(actual) -> object["actual"] = Dyn.Int(actual)
                .None -> {}
            }
        }
        .BuildError(report) -> {
            object["build_error"] = report_status_value_parse(report) ?? panic("a build-error extension is a rendered JSON document")
        }
    }
}
