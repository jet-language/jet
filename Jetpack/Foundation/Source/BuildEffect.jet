// Build-effect view of the canonical Prelude effect table, ported from
// Foundation's BuildEffects. The build projection excludes runtime-only
// FFI, Browser, and Secret roots while keeping the public effect identities.
// It is a subset view of the one effect vocabulary: while the compiler
// builds, BUILD_EFFECT_COUNT checks that each case (this file's text) is a
// root the toolchain tree's effect sources declare (JetFoundation
// EFFECT_VOCABULARY_ROOTS) and that `parse` and `name` give it back, and a
// stray stops the build (E3010) naming it.
use {
    jet_foundation.[EFFECT_VOCABULARY_ROOTS, effect_vocabulary_enum_cases, effect_vocabulary_strays]
}

BUILD_EFFECT_COUNT: comptime { build_effect_count(embed_file("BuildEffect.jet"), EFFECT_VOCABULARY_ROOTS) }

BuildEffect: enum {
    Net
    FS
    IO
    DB
    Time
    Rand
    Env
    Exec
    Log
    GPU

    name: fn(self) -> String Never! {
        if self == {
            .Net -> "Net"
            .FS -> "FS"
            .IO -> "IO"
            .DB -> "DB"
            .Time -> "Time"
            .Rand -> "Rand"
            .Env -> "Env"
            .Exec -> "Exec"
            .Log -> "Log"
            .GPU -> "GPU"
        }
    }

    flag: fn(self) -> String Never! {
        if self == {
            .Net -> "net"
            .FS -> "fs"
            .IO -> "io"
            .DB -> "db"
            .Time -> "time"
            .Rand -> "rand"
            .Env -> "env"
            .Exec -> "exec"
            .Log -> "log"
            .GPU -> "gpu"
        }
    }

    // A root effect name matched ASCII case-insensitively against the
    // canonical table; dotted leaves are not build effects.
    parse: fn(value: String) -> BuildEffect? Never! {
        if value.contains(".") -> return None
        if value.to_ascii_lower() == {
            "net" -> Val(BuildEffect.Net)
            "fs" -> Val(BuildEffect.FS)
            "io" -> Val(BuildEffect.IO)
            "db" -> Val(BuildEffect.DB)
            "time" -> Val(BuildEffect.Time)
            "rand" -> Val(BuildEffect.Rand)
            "env" -> Val(BuildEffect.Env)
            "exec" -> Val(BuildEffect.Exec)
            "log" -> Val(BuildEffect.Log)
            "gpu" -> Val(BuildEffect.GPU)
            else -> None
        }
    }

    // Position in the canonical table, the order Rust's derived `Ord` uses.
    rank: fn(self) -> Int Never! {
        if self == {
            .Net -> 0
            .FS -> 1
            .IO -> 2
            .DB -> 3
            .Time -> 4
            .Rand -> 5
            .Env -> 6
            .Exec -> 7
            .Log -> 8
            .GPU -> 9
        }
    }

    // Whether a build action declaring this effect can give a different
    // result with the same declared inputs. The native sandbox confines FS
    // to the action's work tree and declared folders, Exec to its tool and
    // what is mounted (identified by content in the key), and Env to its
    // declared variables (their values in the key), so those are not. Net
    // is: an action fetches no bytes pinned by a content hash in its key.
    // Time, Rand, IO, DB, Log and GPU reach outside the declared inputs.
    ambient: fn(self) -> Bool Never! {
        if self == {
            .FS -> false
            .Exec -> false
            .Env -> false
            .Net -> true
            .IO -> true
            .DB -> true
            .Time -> true
            .Rand -> true
            .Log -> true
            .GPU -> true
        }
    }

    // The effects in canonical table order, keeping repeats.
    sorted: fn(effects: [BuildEffect]) -> [BuildEffect] Never! {
        out := effects
        out = loop fresh_item in out -> fresh_item
        out.sort_by(written -> written.rank())
        out
    }
}

// The number of build effects, once each BuildEffect case (in `text`, this
// file) is one of `roots` and round-trips through `parse` and `name`; else
// the build stops naming the strays.
build_effect_count: fn(text: String, roots: [String]) -> Int {
    problem: build_effect_problem(text, roots)
    if problem != "" -> panic(problem)
    (effect_vocabulary_enum_cases(text, "BuildEffect") ?? [String]{}).len()
}

// What is wrong with the cases of `BuildEffect: enum { … }` in `text`: each
// case that is no root of `roots`, and each case `parse` and `name` do not
// give back, or "".
build_effect_problem: fn(text: String, roots: [String]) -> String {
    cases: effect_vocabulary_enum_cases(text, "BuildEffect") ?? return "BuildEffect.jet declares no `BuildEffect: enum {{ … }}`"
    strays: effect_vocabulary_strays(cases, roots)
    if strays.len() > 0 -> return "BuildEffect.jet: BuildEffect names effects the effect sources (Compiler/Prelude/Effects.jet, Core/Effects/Effects.jet, Core/Compiler/Meta.jet) do not declare: [{strays.join(", ")}]"
    unread := [String]{}
    loop case_name in cases {
        if (BuildEffect.parse(case_name)?.name() ?? "") != case_name -> unread.push(case_name.copy())
    }
    if unread.len() > 0 -> return "BuildEffect.jet: BuildEffect.parse and name do not give back [{unread.join(", ")}]"
    ""
}

#Test("each BuildEffect case is a declared effect root, and a stray is named") {
    roots: [String]{"Net", "FS", "DB", "Mem"}
    assert_eq(build_effect_problem("BuildEffect: enum {{\n    Net\n    FS\n    DB\n\n    name: fn(self) -> String {{\n}}\n", roots), "")
    assert_eq(build_effect_problem("BuildEffect: enum {{\n    Net\n    Disk\n}}\n", roots), "BuildEffect.jet: BuildEffect names effects the effect sources (Compiler/Prelude/Effects.jet, Core/Effects/Effects.jet, Core/Compiler/Meta.jet) do not declare: [Disk]")
    assert(build_effect_problem("BuildEffect: enum {{\n    Mem\n}}\n", roots).contains("do not give back [Mem]"))
    assert_eq(BUILD_EFFECT_COUNT, 10)
}
