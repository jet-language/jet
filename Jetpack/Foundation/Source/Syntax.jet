// Effect names the dependency graph must never use.
EFFECTS_FIELD_DENY :: comptime { "deny" }
// The audited per-dependency `grants` escape.
MANIFEST_BLOCK_GRANTS :: comptime { "grants" }
// The `policy: { … }` manifest block.
MANIFEST_BLOCK_POLICY :: comptime { "policy" }

