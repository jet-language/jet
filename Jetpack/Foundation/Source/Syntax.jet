KW_MODULE :: comptime { "module" }
// The workspace module namespace — `module workspace { … }`.
NS_WORKSPACE :: comptime { "workspace" }
// Reviewed workspace overlay blocks.
WORKSPACE_OVERLAY :: comptime { "overlay" }

