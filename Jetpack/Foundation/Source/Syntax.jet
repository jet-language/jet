// D-ECO12=A: the typed environment formatter package field.
ENV_FIELD_FORMATTER :: prep { "formatter" }

// ── PackageModel Lock/Workspace/Scripts (jet_foundation::Syntax) ──

// U2: the single project lockfile inside the `.jet/` managed folder.
UNIFIED_LOCK_FILE :: prep { ".jet/lock" }
// N1: compiler binary name.
BINARY_NAME :: prep { "jet" }
// D-JPK1/9: the Jetpack package-manager binary name.
JETPACK_BINARY_NAME :: prep { "jetpack" }
// D-SHAPE-MODULEINTERNAL1=A: module-internal name prefix.
MODULE_INTERNAL_PREFIX :: prep { "_" }
// D-WORKSPACE1=B: the `members:` field of a workspace module.
MODULE_FIELD_MEMBERS :: prep { "members" }

// ── Store Explain/Why (jet_foundation::Syntax, Syntax/jetpack_config.rs) ──

// The project environment filename `jetpack why` reports as the requesting file.
ENV_FILE :: prep { "env.jet" }

// ── PackageModel Foreign binders (jet_foundation::Syntax, Syntax/package_files.rs) ──

// Canonical list of real Jet keywords; generated binder names may not use them.
JET_KEYWORD_LIST :: prep { [String]{
    "fn", "pub", "priv", "use", "as", "extern", "module", "if", "else", "loop", "in", "break",
    "return", "defer", "struct", "enum", "alias", "impl", "policy", "wrap", "trait", "tag",
    "effect", "derive", "distinct", "migration", "rename", "add", "remove", "change", "via",
    "self", "Unsafe", "Impure", "Context", "task", "freeze", "shared", "Transact", "Job", "Test",
    "Todo", "State", "Transition", "state", "protocol", "client", "server", "marker", "validate",
    "check", "true", "false", "None", "it"
} }
// Canonical list of built-in type names a user writes.
JET_TYPE_LIST :: prep { [String]{
    "Int", "Float", "Bool", "String", "()", "Char", "Err", "Shared", "SharedSnapshot",
    "SharedRevisionError", "SharedGuard", "Shared.Weak", "Condition", "Task", "Receiver", "Sender",
    "TaskFailure", "HashMap", "BTreeMap", "Map", "Queue", "Set", "Rank", "PriorityQueue", "Cache",
    "Tally", "Bits", "Bytes", "ViewIter", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64",
    "F32", "F64"
} }
// The Prelude error type spelling a foreign name may still project to.
TYPE_ERR :: prep { "Err" }

// ── Recipe Toolchain (jet_foundation::Syntax, Syntax/predicates.rs) ──

// D-JPK-BUILDTOOL1=A / D-JPK-RINGSHIP1=C: the env var naming a realized
