// Jetpack surface spellings, ported from jet_foundation::Syntax. This is the
// one home for these tokens inside the Jetpack unit; parsers and renderers
// read them here instead of hand-copying the literals.

// ── Package refs (Syntax/effects_surface.rs, Syntax/jetpack_config.rs) ──

// D-JPK-REF1=A: `package@source`; the package precedes the source.
REF_PROVIDER_AT :: prep { "@" }
// D-JPK7/15: the `<source>:<package/path>` separator of the internal
// provider-first upstream form.
REF_SEPARATOR :: prep { ":" }
// D-CHANNEL-AUTO1=A amended by D-VERDICT-2190-1: channel policy markers follow
// `@source`. `#latest` is the manual moving tier; `#auto` opts a source into
// automatic movement. A source with no marker is pinned.
REF_CHANNEL_MARKER :: prep { "#" }
REF_CHANNEL_LATEST :: prep { "latest" }
REF_CHANNEL_MAIN :: prep { "main" }
REF_CHANNEL_AUTO :: prep { "auto" }

// D-JPK-SNIXREUSE1=A: Jetpack is the canonical package source.
REF_SOURCE_JETPACK :: prep { "jetpack" }
// D-JPK7/15: legacy nixpkgs source token, retained for migration/provenance.
REF_SOURCE_NIXPKGS :: prep { "nixpkgs" }
REF_SOURCE_GITHUB :: prep { "github" }
REF_SOURCE_PATH :: prep { "path" }
// D-FFI-R1 / D-JPK-PROVIDERS2: direct CRAN ecosystem root.
REF_SOURCE_CRAN :: prep { "cran" }
// D-JPK-PROVIDERS2 / D-FFI-LUA1: direct LuaRocks ecosystem root.
REF_SOURCE_LUAROCKS :: prep { "luarocks" }
// D-FFI-RUBY1 / D-JPK7: direct RubyGems ecosystem root.
REF_SOURCE_RUBY :: prep { "ruby" }
// D-FFI-PERL1 / D-JPK7: direct CPAN ecosystem root.
REF_SOURCE_PERL :: prep { "perl" }
// D-FFI-PHP1 / D-JPK7: direct Packagist ecosystem root.
REF_SOURCE_PHP :: prep { "php" }
// D-JPK-PROVIDERS2 / D-JPK-REGISTRY1: the first-party Jet registry root.
REF_SOURCE_JET_REGISTRY :: prep { "jet-registry" }
// D-JPK-PROVIDERS2: direct npm ecosystem root.
REF_SOURCE_NPM :: prep { "npm" }
// D-JPK-PROVIDERS2: direct Cargo ecosystem root.
REF_SOURCE_CARGO :: prep { "cargo" }
// D-JPK-EXTPROV1: direct PyPI ecosystem root.
REF_SOURCE_PYPI :: prep { "pypi" }
// D-JPK-EXTPROV1: direct SwiftPM ecosystem root.
REF_SOURCE_SWIFTPM :: prep { "swiftpm" }
// D-CHANNEL-AUTO1=A / card #2166: the native release-artifact source.
REF_SOURCE_RELEASES :: prep { "releases" }

// The one home for "which source tokens are built-in providers", in the order
// a ref may not put them (D-JPK-REF1=A: `target@provider`, never
// `provider@target`).
REF_SOURCE_PROVIDERS :: prep { [String]{
    REF_SOURCE_JETPACK,
    REF_SOURCE_NIXPKGS,
    REF_SOURCE_GITHUB,
    REF_SOURCE_PATH,
    REF_SOURCE_CRAN,
    REF_SOURCE_LUAROCKS,
    REF_SOURCE_RUBY,
    REF_SOURCE_PERL,
    REF_SOURCE_PHP,
    REF_SOURCE_JET_REGISTRY,
    REF_SOURCE_NPM,
    REF_SOURCE_CARGO,
    REF_SOURCE_PYPI,
    REF_SOURCE_SWIFTPM,
    REF_SOURCE_RELEASES
} }

// ── Module and workspace manifests (Syntax/jetpack_config.rs) ──

// U3: module declaration keyword — `module name { … }`.
KW_MODULE :: prep { "module" }
// The workspace module namespace — `module workspace { … }`.
NS_WORKSPACE :: prep { "workspace" }
// D-JPK-OVERLAY1=A: reviewed workspace overlay blocks.
WORKSPACE_OVERLAY :: prep { "overlay" }

// ── Policy and effect-budget manifest keys (Syntax/predicates.rs) ──

// D-EFFBUDGET1: effect names the whole dependency graph may use.
EFFECTS_FIELD_ALLOW :: prep { "allow" }
// D-EFFBUDGET1: effect names the dependency graph must never use.
EFFECTS_FIELD_DENY :: prep { "deny" }
// D-EFFBUDGET1: the audited per-dependency `grants` escape.
MANIFEST_BLOCK_GRANTS :: prep { "grants" }
// D-POLICY-WORD1=A: the `policy: { … }` manifest block.
MANIFEST_BLOCK_POLICY :: prep { "policy" }

// ── EnvModel Environment/Workspace (jet_foundation::Syntax, Syntax/jetpack_config.rs) ──

// The canonical package manifest filename.
PACKAGE_FILE :: prep { "package.jet" }
// D-WORKSPACE1=B + D-WORKSPACE2=A: the monorepo index filename.
WORKSPACE_FILE :: prep { "workspace.jet" }
// D-JPK-FILENAME2=B: the payload adapter filename.
PAYLOAD_FILE :: prep { "pkg.jet" }
// The workspace `members: find("./dir")` discovery builtin.
