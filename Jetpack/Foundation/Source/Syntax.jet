// Jetpack surface spellings, ported from jet_foundation::Syntax. This is the
// one home for these tokens inside the Jetpack unit; parsers and renderers
// read them here instead of hand-copying the literals.

// ── Package refs (Syntax/effects_surface.rs, Syntax/jetpack_config.rs) ──

// `package@source`; the package precedes the source.
REF_PROVIDER_AT :: comptime { "@" }
// 15: the `<source>:<package/path>` separator of the internal
// provider-first upstream form.
REF_SEPARATOR :: comptime { ":" }
// This rule amended by channel policy markers follow
// `@source`. `#latest` is the manual moving tier; `#auto` opts a source into
// automatic movement. A source with no marker is pinned.
REF_CHANNEL_MARKER :: comptime { "#" }
REF_CHANNEL_LATEST :: comptime { "latest" }
REF_CHANNEL_MAIN :: comptime { "main" }
REF_CHANNEL_AUTO :: comptime { "auto" }

// Jetpack is the canonical package source.
REF_SOURCE_JETPACK :: comptime { "jetpack" }
// 15: legacy nixpkgs source token, retained for migration/provenance.
REF_SOURCE_NIXPKGS :: comptime { "nixpkgs" }
REF_SOURCE_GITHUB :: comptime { "github" }
REF_SOURCE_PATH :: comptime { "path" }
// Direct CRAN ecosystem root.
REF_SOURCE_CRAN :: comptime { "cran" }
// Direct LuaRocks ecosystem root.
REF_SOURCE_LUAROCKS :: comptime { "luarocks" }
// Direct RubyGems ecosystem root.
REF_SOURCE_RUBY :: comptime { "ruby" }
// Direct CPAN ecosystem root.
REF_SOURCE_PERL :: comptime { "perl" }
// Direct Packagist ecosystem root.
REF_SOURCE_PHP :: comptime { "php" }
// The first-party Jet registry root.
REF_SOURCE_JET_REGISTRY :: comptime { "jet-registry" }
// Direct npm ecosystem root.
REF_SOURCE_NPM :: comptime { "npm" }
// Direct Cargo ecosystem root.
REF_SOURCE_CARGO :: comptime { "cargo" }
// Direct PyPI ecosystem root.
REF_SOURCE_PYPI :: comptime { "pypi" }
// Direct SwiftPM ecosystem root.
REF_SOURCE_SWIFTPM :: comptime { "swiftpm" }
// Card #2166: the native release-artifact source.
REF_SOURCE_RELEASES :: comptime { "releases" }

// The one home for "which source tokens are built-in providers", in the order
// a ref may not put them (`target@provider`, never
// `provider@target`).
REF_SOURCE_PROVIDERS :: comptime { [String]{
    REF_SOURCE_JETPACK,
    REF_SOURCE_NIXPKGS,
    REF_SOURCE_GITHUB,
    REF_SOURCE_PATH,
    REF_SOURCE_CRAN,
    REF_SOURCE_LUAROCKS,
    REF_SOURCE_RUBY,
    REF_SOURCE_PERL,
    REF_SOURCE_PHP,
    REF_SOURCE_JET_REGISTRY,
    REF_SOURCE_NPM,
    REF_SOURCE_CARGO,
    REF_SOURCE_PYPI,
    REF_SOURCE_SWIFTPM,
    REF_SOURCE_RELEASES
} }

// ── Module and workspace manifests (Syntax/jetpack_config.rs) ──

