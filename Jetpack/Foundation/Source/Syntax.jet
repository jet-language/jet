// Package-root command role homes.
COMMAND_FILE_RUN :: comptime { "@run.jet" }
COMMAND_FILE_BUILD :: comptime { "@build.jet" }
COMMAND_FILE_DEV :: comptime { "@dev.jet" }
COMMAND_FILE_TEST :: comptime { "@test.jet" }
COMMAND_ROLE_FILES :: comptime { [String]{COMMAND_FILE_RUN, COMMAND_FILE_BUILD, COMMAND_FILE_DEV, COMMAND_FILE_TEST} }
// The package build entry and its compiler-owned parameter type.
BUILD_ENTRY_FN :: comptime { "build" }
TYPE_BUILD_CONTEXT :: comptime { "Build" }
// UI capability rights accepted by `authority.needs`.
UI_CAPABILITY_NAMES :: comptime { [String]{"UI.FileDialog", "UI.Clipboard", "UI.IME", "UI.DragDrop", "UI.Shortcuts", "UI.Accessibility", "UI.FontShaping"} }

// The role home a bare command resolves to (`command_role_file`).
fn syntax_command_role_file(command: String) -> String? Never! {
    if command == {
        "run" -> Val(COMMAND_FILE_RUN)
        "build" -> Val(COMMAND_FILE_BUILD)
        "dev" -> Val(COMMAND_FILE_DEV)
        "test" -> Val(COMMAND_FILE_TEST)
        else -> None
    }
}

// `Syntax::is_ui_capability`.
fn syntax_is_ui_capability(name: String) -> Bool Never! {
    UI_CAPABILITY_NAMES.contains(name)
}

