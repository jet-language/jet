// D-CONF-PLANE1: the retired file-backed Config filename.
CONFIG_FILE :: prep { "config.jet" }
// D-ROLEFILE1=A / D-CMDOVERRIDE1=A: package-root command role homes.
COMMAND_FILE_RUN :: prep { "@run.jet" }
COMMAND_FILE_BUILD :: prep { "@build.jet" }
COMMAND_FILE_DEV :: prep { "@dev.jet" }
COMMAND_FILE_TEST :: prep { "@test.jet" }
COMMAND_ROLE_FILES :: prep { [String]{COMMAND_FILE_RUN, COMMAND_FILE_BUILD, COMMAND_FILE_DEV, COMMAND_FILE_TEST} }
// D-BUILDENTRY1: the package build entry and its compiler-owned parameter type.
BUILD_ENTRY_FN :: prep { "build" }
TYPE_BUILD_CONTEXT :: prep { "BuildContext" }
// D-UICAP1: UI capability rights accepted by `authority.needs`.
UI_CAPABILITY_NAMES :: prep { [String]{"UI.FileDialog", "UI.Clipboard", "UI.IME", "UI.DragDrop", "UI.Shortcuts", "UI.Accessibility", "UI.FontShaping"} }

// D-CMDOVERRIDE1=A: the role home a bare command resolves to (`command_role_file`).
fn syntax_command_role_file(command: String) -> String? Never! {
    if command == {
        "run" -> Val(COMMAND_FILE_RUN)
        "build" -> Val(COMMAND_FILE_BUILD)
        "dev" -> Val(COMMAND_FILE_DEV)
        "test" -> Val(COMMAND_FILE_TEST)
        else -> None
    }
}

// `Syntax::is_ui_capability`.
fn syntax_is_ui_capability(name: String) -> Bool Never! {
    UI_CAPABILITY_NAMES.contains(name)
}

