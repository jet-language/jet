    "doctor",
    "env",
    "use",
    "hangar",
    "audit",
    "add",
    "remove",
    "update",
    JETPACK_LOCK_VERB,
    "outdated",
    "search",
    "info",
    "explain",
    JETPACK_WHY,
    JETPACK_IMPORT_VERB,
    "logs",
    "override",
    "push",
    TRUST_SUBCOMMAND,
    CONFIG_SUBCOMMAND,
    BRIDGE_SUBCOMMAND,
    SERVICES_SUBCOMMAND,
    SECRETS_SUBCOMMAND,
    IMAGE_SUBCOMMAND,
    USER_SUBCOMMAND,
    TOOL_SUBCOMMAND,
    PROFILE_SUBCOMMAND,
    BROWSER_SUBCOMMAND
} }

// ── CLI (jet_foundation::Syntax, effects_surface.rs, jetpack_config.rs) ──

