BROWSER_DEFAULT_PROTOCOL :: prep { "bidi-2025.5" }
// Every Jetpack verb, in dispatch order. JetOS's `os` verb is out of scope for
// this port and is not listed.
JETPACK_VERBS :: prep { [String]{
    "doctor",
    "env",
    "use",
    "hangar",
    "audit",
    "add",
    "remove",
    "update",
    JETPACK_LOCK_VERB,
    "outdated",
    "search",
    "info",
    "explain",
    JETPACK_WHY,
    JETPACK_IMPORT_VERB,
    "logs",
    "override",
    "push",
    TRUST_SUBCOMMAND,
    CONFIG_SUBCOMMAND,
    BRIDGE_SUBCOMMAND,
    SERVICES_SUBCOMMAND,
    SECRETS_SUBCOMMAND,
    IMAGE_SUBCOMMAND,
    USER_SUBCOMMAND,
    TOOL_SUBCOMMAND,
    PROFILE_SUBCOMMAND,
    BROWSER_SUBCOMMAND
} }

