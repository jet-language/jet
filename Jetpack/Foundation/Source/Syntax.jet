TOOLCHAIN_OBJECT_ENV :: prep { "JET_TOOLCHAIN_FIXTURE" }

// ── PackageModel Authority/Store (jet_foundation::Syntax, Syntax/core_surface.rs, effects_surface.rs, jetpack_config.rs) ──

// N2 (ratified): source file extension (without the dot).
FILE_EXT :: prep { "jet" }
// S52 (ratified M12): package source root directory inside a project.
SOURCE_ROOT_DIR :: prep { ".jet" }
// D-JPK-FILENAME2=B: retired manifest filenames; a directory holding one is
// still an authority-discovery candidate so the CLI can report E1225.
STALE_MANIFEST_NAMES :: prep { [String]{"pack.jet", "payload.jet", "jet.toml"} }

