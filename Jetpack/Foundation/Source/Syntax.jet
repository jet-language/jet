// D-ENV-LIFECYCLE1: prompt hook activation identity.
ENV_HOOK_ACTIVE_HASH_VAR :: prep { "JETPACK_ENV_HASH" }
// D-ENVHOOK1=A: the root of the env the prompt hook currently has loaded.
ENV_HOOK_ACTIVE_DIR_VAR :: prep { "JETPACK_ENV_DIR" }
// D-ENVHOOK1=A: the pre-activation `PATH`, restored verbatim on unload.
ENV_HOOK_OLD_PATH_VAR :: prep { "JETPACK_ENV_OLD_PATH" }
// D-ENVHOOK1=A: the private per-prompt callback verb (`jet env export <shell>`).
ENV_EXPORT_VERB :: prep { "export" }
