// The Jet source tree the running jetpack builds its Rust bridge from. The
// native compiler finds its Core sources and runtime through the toolchain
// root named by `JET_TOOLCHAIN_ROOT` (JetCli Request.jet); the bridge builder
// uses the same root. The root must hold the Jet sources: a guessed tree could
// hand the bridge builder unrelated or stale sources.
use core.sys as sys
use core.files as files

TOOLCHAIN_ROOT_ENV :: "JET_TOOLCHAIN_ROOT"

// The markers that identify a Jet source root; all of them must exist.
SOURCE_ROOT_MARKERS :: [String]{"Jetpack/Integrations/Source/Foreign/RustBridge/Support/jet-foundation/Cargo.toml", "Core", "Compiler"}

fn foundation_jet_source_root() -[FS, Env]> String IOError! {
    root :: sys.get(TOOLCHAIN_ROOT_ENV) ?? return Err(IOError.NotFound(IOContext{operation: .Resolve, resource: Val(TOOLCHAIN_ROOT_ENV), os_code: None, cause: Val("`{TOOLCHAIN_ROOT_ENV}` is not set; the bridge builder needs the Jet toolchain source tree")}))
    canonical :: files.canonicalize(root) ?? return Err(IOError.NotFound(IOContext{operation: .Resolve, resource: Val(root), os_code: None, cause: Val("the Jet toolchain root `{root}` cannot be resolved: {err}")}))
    if !foundation_is_jet_source_root(canonical) -> return Err(IOError.NotFound(IOContext{operation: .Resolve, resource: Val(canonical), os_code: None, cause: Val("`{TOOLCHAIN_ROOT_ENV}` does not name a Jet source tree; the bridge builder needs the Jet sources")}))
    Ok(canonical)
}

fn foundation_is_jet_source_root(directory: String) -[FS]> Bool Never! {
    loop marker in SOURCE_ROOT_MARKERS {
        if !files.exists(files.join(directory, marker)) -> return false
    }
    true
}
