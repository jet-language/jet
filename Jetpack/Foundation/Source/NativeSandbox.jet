// The one native child-isolation substrate shared by Jetpack build actions and
// adapter recipes (Rust jet_comptime Comptime::Build `native_sandbox_status` /
// `run_native_sandboxed` over the Prelude ProcessSandbox backend). The policy
// is a receipt, never a claim inferred from user namespaces or an exit status.
// Linux runs the action under Bubblewrap and macOS under Seatbelt, both through
// core.process. There is no Core process-isolation API for the Windows
// AppContainer backend, so Windows reports the sandbox unavailable and every
// sandboxed action fails closed.
use {
    sys: core.sys
    process: core.process
    time: core.time
    files: core.files
    foundation_paths: core.files.path
    crypto: core.crypto
    term: core.term
    http_client: core.http.client
}


NATIVE_SANDBOX_FAKE_ENV: "JETPACK_FAKE_SANDBOX"
NATIVE_SANDBOX_MAX_OUTPUT_BYTES: 67108864
NATIVE_SANDBOX_MACOS_EXEC: "/usr/bin/sandbox-exec"
NATIVE_SANDBOX_NOT_ENFORCED: "not-enforced"
// Rust ProcessSandbox `DEFAULT_ACTION_TIMEOUT`: every build action has a
// finite wall-clock budget in every native backend.
NATIVE_SANDBOX_DEFAULT_ACTION_TIMEOUT_MS: 30000
// The backend status probe runs one trivial child; it gets a short fixed
// budget so a wedged backend reports unavailable instead of hanging.
NATIVE_SANDBOX_STATUS_PROBE_TIMEOUT_MS: 5000
// Jet's pinned Bubblewrap: one static, stripped `bwrap` per Linux host,
// published with every jet release as its own asset and built by
// Tools/agent/bwrap.nix. Tools/release `admit` refuses a release whose
// binary differs from the hash here, so updating jet updates the binary.
NATIVE_SANDBOX_BWRAP_ASSETS: #run { [NativeSandboxBwrapAsset]{
    {
        arch: "x86_64",
        file: "jet-bwrap-x86_64-linux",
        sha256: "0a0c6389f605169e916aa9b9f424fc1128fc318a539948986cdc639cb183107a",
        size: 186304
    }
} }
// The pinned Bubblewrap's name in its Hangar directory
// (`<hangar>/tools/<sha256>/bwrap`).
NATIVE_SANDBOX_BWRAP_NAME: "bwrap"
// Where a missing pinned Bubblewrap may come from besides the copy beside the
// running jet: `JET_BWRAP_URL` (`https://` or `file://`), else the release
// the seed's one-line RELEASE file names.
NATIVE_SANDBOX_BWRAP_URL_ENV: "JET_BWRAP_URL"
NATIVE_SANDBOX_RELEASE_BASE: "https://github.com/jet-language/jet/releases/download"
NATIVE_SANDBOX_RELEASE_FILE: "RELEASE"
NATIVE_SANDBOX_MAX_RELEASE_BYTES: 256
NATIVE_SANDBOX_DENY_NETWORK_ENV: "JETPACK_DENY_NETWORK"
NATIVE_SANDBOX_FETCH_TIMEOUT_MS: 120000
NATIVE_SANDBOX_FETCH_MAX_REDIRECTS: 5
// How a user makes the sandbox usable, for every missing-sandbox diagnostic.
NATIVE_SANDBOX_FIX: "install bubblewrap (`bwrap`) with user namespaces enabled, or let jet fetch its pinned bubblewrap (online, or with `JET_BWRAP_URL` naming a copy)"

// One pinned Bubblewrap: the host architecture it runs on, its release asset
// name, and the exact bytes jet accepts.
NativeSandboxBwrapAsset: struct {
    arch: String
    file: String
    sha256: String
    size: Int
}

NativeSandboxStatus: struct {
    available: Bool
    mechanism: String
    policy: String
    reason: String

    unavailable: fn(mechanism: String, reason: String) -> NativeSandboxStatus Never! {
        NativeSandboxStatus{available: false, mechanism, policy: NATIVE_SANDBOX_NOT_ENFORCED, reason}
    }
}

#Error
NativeSandboxError: enum {
    Unsupported(String)
    IO(String)
    // The child ran past its time limit (in milliseconds) and was killed.
    TimedOut(limit_ms: Int)

    message: fn(self) -> String Never! {
        if self == {
            .Unsupported(detail) -> detail
            .IO(detail) -> detail
            .TimedOut(limit_ms) -> "sandbox process timed out after {limit_ms}ms"
        }
    }
}

// One immutable host directory exposed read-only to a sandboxed child at
// `destination`; no adapter adds an implicit host search path.
NativeSandboxMount: struct {
    source: String
    destination: String
}

// One sandboxed action's captured result and the boundary it ran under.
NativeSandboxOutput: struct {
    receipt: ProcessReceipt
    mechanism: String
    policy: String
}

// The filesystem, process, network and resource policy text of the backend.
foundation_native_sandbox_policy: fn(output_is_separate: Bool, share_network: Bool) -[Env]> String Never! {
    if sys.is_linux() {
        filesystem: if output_is_separate -> "source-readonly,output-private-copy" else -> "private-workspace-readwrite"
        network: if share_network -> "declared-shared" else -> "isolated"
        return "filesystem={filesystem};process=private-pid,parent-death;network={network};environment=clear;devices=private-dev;privilege=no-new-privs+cap-drop-all;resources=tmpfs-64MiB"
    }
    filesystem: if output_is_separate -> "source-readonly,output-readwrite" else -> "private-workspace-readwrite"
    network: if share_network -> "declared-shared" else -> "denied"
    "filesystem={filesystem};process=declared-tool-and-fork;network={network};environment=clear;devices=denied;resources=none-declared"
}

// Probe the exact native backend before a build claims strong isolation.
foundation_native_sandbox_status: fn() -[FS, Env, Exec, Time.Wait]> NativeSandboxStatus Never! {
    if sys.get(NATIVE_SANDBOX_FAKE_ENV) != None {
        return NativeSandboxStatus.unavailable("test-sandbox-unavailable", "test sandbox override prevents the native backend probe")
    }
    if {
        sys.is_linux() -> foundation_linux_sandbox_status()
        sys.is_macos() -> foundation_macos_sandbox_status()
        sys.is_windows() -> NativeSandboxStatus.unavailable("windows-appcontainer-unavailable", "the native Windows AppContainer backend has no Core process-isolation API")
        else -> NativeSandboxStatus.unavailable("unsupported", "Jetpack's native child sandbox is implemented only on Linux, macOS, and Windows")
    }
}

// The Bubblewrap the Linux backend runs, the first that passes one isolated
// probe, in this one order for every sandboxed action:
//   1. the `bwrap` on PATH. A host may confine unprivileged user namespaces
//      to profiled binaries (Ubuntu's AppArmor profile for /usr/bin/bwrap);
//      there only the host's own copy can make the sandbox, so it comes first.
//   2. Jet's pinned Bubblewrap (NATIVE_SANDBOX_BWRAP_ASSETS) in the Hangar,
//      installed from the copy beside jet when the Hangar has none. A command
//      that runs build actions fetches it first (foundation_native_sandbox_prepare).
// Unsupported names why each one failed. Nothing ever runs unsandboxed.
foundation_linux_bwrap: fn() -[FS, Env, Exec, Time.Wait]> String NativeSandboxError! {
    host := "bubblewrap (`bwrap`) is not available on PATH"
    if foundation_sandbox_program("bwrap") == .Val(path) {
        failed: foundation_linux_bwrap_probe(path, false) ?? return Ok(path)
        host = "the `bwrap` on PATH (`{path}`) failed its probe: {failed}"
    }
    pinned := ""
    if foundation_pinned_bwrap() == {
        .Ok(path) -> {
            failed: foundation_linux_bwrap_probe(path, true) ?? return Ok(path)
            pinned = "Jet's pinned bubblewrap (`{path}`) failed its probe: {failed}"
        }
        .Err(error) -> pinned = error.message()
    }
    Err(NativeSandboxError.Unsupported("{host}; {pinned}"))
}

// Why `bwrap` failed the isolated backend probe, or None when it passed. The
// probe runs `sh -c 'exit 0'` from PATH under it; the pinned copy is static,
// so it runs itself (`bwrap --version`, from its read-only Hangar directory)
// and needs no shell on the host.
foundation_linux_bwrap_probe: fn(bwrap: String, pinned: Bool) -[FS, Env, Exec, Time.Wait]> String? Never! {
    mounts := [NativeSandboxMount]{}
    command := [String]{}
    if pinned {
        mounts.push(NativeSandboxMount{source: files.dirname(bwrap), destination: "/jet-bwrap"})
        command = [String]{"/jet-bwrap/{NATIVE_SANDBOX_BWRAP_NAME}", "--version"}
    } else {
        shell: foundation_sandbox_program("sh") ?? return Val("no immutable shell probe is available")
        command = [String]{shell, "-c", "exit 0"}
    }
    argv := foundation_linux_sandbox_argv(bwrap, None, None, [String: String]{}, false, false, false, mounts, None)
    loop part in command -> argv.push(part)
    receipt: process.cmd(argv).env_clear().stdout(.Capture).stderr(.Capture).timeout(time.duration_ms(NATIVE_SANDBOX_STATUS_PROBE_TIMEOUT_MS)).run() ?? return Val("bubblewrap backend probe failed: {err}")
    if receipt.timed_out -> return Val("bubblewrap backend probe timed out after {NATIVE_SANDBOX_STATUS_PROBE_TIMEOUT_MS}ms")
    if !receipt.success -> return Val("bubblewrap backend probe exited with exit status: {receipt.code}")
    None
}

foundation_linux_sandbox_status: fn() -[FS, Env, Exec, Time.Wait]> NativeSandboxStatus Never! {
    if foundation_linux_bwrap() == .Err(error) -> return NativeSandboxStatus.unavailable("linux-bwrap-unavailable", error.message())
    NativeSandboxStatus{available: true, mechanism: "linux-bwrap", policy: foundation_native_sandbox_policy(false, false), reason: "bubblewrap completed the isolated backend probe"}
}

// Make the Linux sandbox usable before a command runs build actions: when
// neither the PATH `bwrap` nor a pinned copy already in the Hangar or beside
// jet passes its probe, fetch Jet's pinned Bubblewrap into the Hangar (from
// `JET_BWRAP_URL`, else this jet's release) and resolve again. Elsewhere, and
// when a sandbox is already usable, it does nothing; an error says why no
// sandbox is usable.
foundation_native_sandbox_prepare: fn() NativeSandboxError! -[FS, Env, Exec, IO, Net, Time.Wait]> {
    if !sys.is_linux() || sys.get(NATIVE_SANDBOX_FAKE_ENV) != None -> return Ok()
    if foundation_linux_bwrap() == .Err(first) {
        why: first.message()
        asset: foundation_pinned_bwrap_asset() ?? return Err(NativeSandboxError.Unsupported(why))
        // A pinned copy that is present and failed its probe is not fetched
        // again: the same bytes would fail the same way.
        if files.is_file(foundation_pinned_bwrap_path(asset)) -> return Err(NativeSandboxError.Unsupported(why))
        foundation_fetch_pinned_bwrap(asset) ?? return Err(NativeSandboxError.Unsupported("{why}; fetching it failed: {err.message()}"))
        if foundation_linux_bwrap() == .Err(error) -> return Err(NativeSandboxError.Unsupported(error.message()))
    }
}

// The pinned Bubblewrap for this host's architecture.
foundation_pinned_bwrap_asset: fn() -[Env]> NativeSandboxBwrapAsset NativeSandboxError! {
    arch: sys.arch()
    loop asset in NATIVE_SANDBOX_BWRAP_ASSETS {
        if asset.arch == arch -> return Ok(asset)
    }
    Err(NativeSandboxError.Unsupported("Jet pins no bubblewrap for Linux `{arch}`"))
}

// The pinned Bubblewrap's Hangar path: `<hangar>/tools/<sha256>/bwrap`.
foundation_pinned_bwrap_path: fn(asset: NativeSandboxBwrapAsset) -[Env]> String Never! {
    files.join(files.join(files.join(foundation_hangar_dir(), HANGAR_TOOLS_DIR), asset.sha256), NATIVE_SANDBOX_BWRAP_NAME)
}

// The verified pinned Bubblewrap in the Hangar, installed first from the copy
// beside the running jet (a release archive carries it there) when the
// Hangar has none. Every use re-hashes it; a copy with the wrong bytes is
// deleted. It never touches the network (foundation_native_sandbox_prepare does).
foundation_pinned_bwrap: fn() -[FS, Env]> String NativeSandboxError! {
    asset: foundation_pinned_bwrap_asset() ?? return Err(err)
    path: foundation_pinned_bwrap_path(asset)
    if files.is_file(path) {
        if files.read_bytes(path) == {
            .Ok(bytes) -> {
                if foundation_pinned_bwrap_problem(bytes, asset) == .Val(problem) {
                    files.remove_all(files.dirname(path)).drop("a pinned bubblewrap with the wrong bytes is removed best-effort; it is reported")
                    return Err(NativeSandboxError.Unsupported("Jet's pinned bubblewrap in the Hangar (`{path}`) {problem} and was removed"))
                }
                return Ok(path)
            }
            .Err(error) -> return Err(NativeSandboxError.IO("read Jet's pinned bubblewrap `{path}`: {error}"))
        }
    }
    beside: foundation_beside_jet(asset.file) ?? {
        return Err(NativeSandboxError.Unsupported("Jet's pinned bubblewrap `{asset.file}` is not in the Hangar (`{path}`) or beside jet"))
    }
    bytes: files.read_bytes(beside) ?? return Err(NativeSandboxError.IO("read Jet's pinned bubblewrap `{beside}`: {err}"))
    foundation_install_pinned_bwrap(bytes, asset, "`{beside}`") ?? return Err(err)
    Ok(path)
}

// The regular file `name` in the running jet's directory, if there is one.
foundation_beside_jet: fn(name: String) -[FS, Env]> String? Never! {
    executable: sys.executable()
    if executable == "" -> return None
    path: files.join(files.dirname(executable), name)
    if !files.is_file(path) -> return None
    Val(path)
}

// Why `bytes` are not the pinned Bubblewrap, or None when they are.
foundation_pinned_bwrap_problem: fn(bytes: [U8], asset: NativeSandboxBwrapAsset) -> String? Never! {
    if bytes.len() != asset.size -> return Val("has {bytes.len()} bytes, not the {asset.size} this jet pins")
    actual: crypto.sha256(bytes).hex()
    if actual != asset.sha256 -> return Val("has SHA-256 {actual}, not the {asset.sha256} this jet pins")
    None
}

// Verify `bytes` from `origin` and publish them read-only and executable at
// the pinned path, through a private staging file renamed into place.
foundation_install_pinned_bwrap: fn(bytes: [U8], asset: NativeSandboxBwrapAsset, origin: String) NativeSandboxError! -[FS, Env]> {
    if foundation_pinned_bwrap_problem(bytes, asset) == .Val(problem) {
        return Err(NativeSandboxError.Unsupported("the bubblewrap from {origin} {problem}"))
    }
    path: foundation_pinned_bwrap_path(asset)
    directory: files.dirname(path)
    files.create_dir_all(directory) ?? return Err(NativeSandboxError.IO("create `{directory}`: {err}"))
    staging: files.join(directory, ".{NATIVE_SANDBOX_BWRAP_NAME}.partial-{process.current_pid()}")
    files.write_bytes(staging, bytes) ?? return Err(NativeSandboxError.IO("write `{staging}`: {err}"))
    files.set_mode(staging, 0o555) ?? return Err(NativeSandboxError.IO("set the mode of `{staging}`: {err}"))
    files.rename(staging, path) ?? return Err(NativeSandboxError.IO("install Jet's pinned bubblewrap at `{path}`: {err}"))
}

// Download the pinned Bubblewrap into the Hangar from `JET_BWRAP_URL`, else
// from the release this jet came from (the RELEASE file beside it). A
// `file://` URL is read where it lies, so it also works offline.
foundation_fetch_pinned_bwrap: fn(asset: NativeSandboxBwrapAsset) NativeSandboxError! -[FS, Env, IO, Net, Time.Wait]> {
    url := sys.get(NATIVE_SANDBOX_BWRAP_URL_ENV) ?? ""
    if url == "" {
        release: foundation_jet_release_name() ?? {
            return Err(NativeSandboxError.Unsupported("this jet does not name the release it came from, so `{asset.file}` cannot be downloaded; put it beside jet or set `{NATIVE_SANDBOX_BWRAP_URL_ENV}` to its URL"))
        }
        url = "{NATIVE_SANDBOX_RELEASE_BASE}/{release}/{asset.file}"
    }
    if url.starts_with("file://") {
        local: url.removeprefix("file://")
        bytes: files.read_bytes(local) ?? return Err(NativeSandboxError.IO("read `{local}`: {err}"))
        foundation_install_pinned_bwrap(bytes, asset, url) ?? return Err(err)
        return Ok()
    }
    if (sys.get(NATIVE_SANDBOX_DENY_NETWORK_ENV) ?? "") != "" {
        return Err(NativeSandboxError.Unsupported("network disabled by {NATIVE_SANDBOX_DENY_NETWORK_ENV}, so {url} cannot be downloaded"))
    }
    term.eprint("first use: fetching Jet's sandbox, bubblewrap ({terminal_human_size(asset.size)})")
    request: http_client.request("GET", url).total_timeout(NATIVE_SANDBOX_FETCH_TIMEOUT_MS).redirects(NATIVE_SANDBOX_FETCH_MAX_REDIRECTS).header("Accept-Encoding", "identity")
    response: http_client.send(request) ?? return Err(NativeSandboxError.IO("could not fetch {url}: {err}"))
    status: response.status()
    if status < 200 || status >= 300 -> return Err(NativeSandboxError.IO("{url} returned HTTP {status}"))
    bytes: response.body().bytes(asset.size + 1) ?? return Err(NativeSandboxError.IO("download {url}: {err}"))
    foundation_install_pinned_bwrap(bytes, asset, url) ?? return Err(err)
}

// The release this jet came from: the seed's one-line RELEASE file beside it.
foundation_jet_release_name: fn() -[FS, Env]> String? Never! {
    path: foundation_beside_jet(NATIVE_SANDBOX_RELEASE_FILE) ?? return None
    info: files.stat(path) ?? return None
    if info.size > NATIVE_SANDBOX_MAX_RELEASE_BYTES -> return None
    text: files.read(path) ?? return None
    name: text.trim()
    if name == "" || name.contains("/") || name.contains(" ") -> return None
    Val(name)
}

foundation_macos_sandbox_status: fn() -[FS, Env, Exec, Time.Wait]> NativeSandboxStatus Never! {
    if !files.is_file(NATIVE_SANDBOX_MACOS_EXEC) {
        return NativeSandboxStatus.unavailable("macos-seatbelt-unavailable", "native macOS backend `{NATIVE_SANDBOX_MACOS_EXEC}` is unavailable")
    }
    probe_profile: "(version 1)\n(deny default)\n(import \"system.sb\")\n(allow process-exec (literal \"/usr/bin/true\"))\n(allow file-read* (subpath \"/System\") (subpath \"/usr\") (subpath \"/bin\") (subpath \"/nix/store\"))\n"
    receipt: process.cmd([String]{NATIVE_SANDBOX_MACOS_EXEC, "-p", probe_profile, "/usr/bin/true"}).env_clear().stdout(.Capture).stderr(.Capture).timeout(time.duration_ms(NATIVE_SANDBOX_STATUS_PROBE_TIMEOUT_MS)).run() ?? return NativeSandboxStatus.unavailable("macos-seatbelt-unavailable", "native macOS Seatbelt backend probe failed: {err}")
    if receipt.timed_out -> return NativeSandboxStatus.unavailable("macos-seatbelt-unavailable", "native macOS Seatbelt backend probe timed out after {NATIVE_SANDBOX_STATUS_PROBE_TIMEOUT_MS}ms")
    if !receipt.success -> return NativeSandboxStatus.unavailable("macos-seatbelt-unavailable", "native macOS Seatbelt backend probe exited with exit status: {receipt.code}")
    NativeSandboxStatus{available: true, mechanism: "macos-seatbelt", policy: foundation_native_sandbox_policy(true, false), reason: "native macOS Seatbelt completed the isolated backend probe"}
}

// Run one executable action through the shared native sandbox. `source_dir`
// is read-only when `output_dir` is present, and only that output directory
// is writable; without one the private work tree is writable. Captured output
// is bounded at 64 MiB.
foundation_run_native_sandboxed: fn(executable: String, args: [String], source_dir: String, output_dir: String?, env: [String: String], share_network: Bool) -[FS, Env, Exec, Time.Wait]> NativeSandboxOutput NativeSandboxError! {
    foundation_run_native_sandboxed_with_mounts(executable, args, source_dir, output_dir, env, share_network, [NativeSandboxMount]{})
}

// Run one action with additional immutable host directories projected
// read-only at their declared destinations.
foundation_run_native_sandboxed_with_mounts: fn(executable: String, args: [String], source_dir: String, output_dir: String?, env: [String: String], share_network: Bool, mounts: [NativeSandboxMount]) -[FS, Env, Exec, Time.Wait]> NativeSandboxOutput NativeSandboxError! {
    foundation_run_native_sandboxed_with_timeout_and_mounts(executable, args, source_dir, output_dir, env, share_network, mounts, None)
}

// Rust `run_native_sandboxed_with_timeout_and_mounts`: the same boundary with
// a finite wall-clock budget. A child that outlives `timeout` is killed with
// its process group and the run fails with the Rust backend's message.
//
// Descendants. Rust also walks `/proc/<pid>/task/*/children` and SIGKILLs
// every descendant it saw. Core `process` signals only the wrapper's process
// group, and on Linux that is sufficient: `--unshare-all` puts the action in
// a private pid namespace, `--die-with-parent` kills the namespace's init
// when the wrapper dies (timeout), and the init exits with the action
// (normal exit); either way the kernel kills every process left in the
// namespace. `--new-session` or `setsid` cannot leave it. The "action
// timeout" fixture checks that a pipe-holding descendant is reaped on both
// paths. macOS Seatbelt has no pid namespace: a forked child that leaves the
// process group survives the group kill there, exactly as in Rust, whose
// `/proc` walk is Linux-only.
foundation_run_native_sandboxed_with_timeout_and_mounts: fn(executable: String, args: [String], source_dir: String, output_dir: String?, env: [String: String], share_network: Bool, mounts: [NativeSandboxMount], timeout: Duration?) -[FS, Env, Exec, Time.Wait]> NativeSandboxOutput NativeSandboxError! {
    command: foundation_native_sandbox_command(executable, args, source_dir, output_dir, env, share_network, mounts, [String]{}, timeout)
    receipt: command.spec.run() ?? return Err(NativeSandboxError.IO("{err}"))
    foundation_native_sandbox_finish(command, receipt)
}

// One sandboxed child, checked and ready to run: its process (output
// captured and bounded, the time limit set) and what its receipt is read
// against. A caller runs many at once with `process.run_all` and reads each
// receipt with foundation_native_sandbox_finish.
NativeSandboxCommand: struct {
    spec: ProcessSpec
    timeout: Duration?
    mechanism: String
    policy: String
}

// The child foundation_run_native_sandboxed_with_timeout_and_mounts runs,
// without running it. `programs` are the host paths of the programs the
// child is passed as arguments (foundation_sandbox_program_argument); each
// may run there as `executable` may.
foundation_native_sandbox_command: fn(executable: String, args: [String], source_dir: String, output_dir: String?, env: [String: String], share_network: Bool, mounts: [NativeSandboxMount], programs: [String], timeout: Duration?) -[FS, Env, Exec, Time.Wait]> NativeSandboxCommand NativeSandboxError! {
    if sys.is_windows() -> return Err(NativeSandboxError.Unsupported("the native Windows AppContainer backend has no Core process-isolation API"))
    if !sys.is_linux() && !sys.is_macos() -> return Err(NativeSandboxError.Unsupported("Jetpack's native child sandbox is implemented only on Linux, macOS, and Windows"))
    if sys.get(NATIVE_SANDBOX_FAKE_ENV) != None -> return Err(NativeSandboxError.Unsupported("test sandbox override prevents child execution"))
    // Linux resolves (and so probes) its Bubblewrap once for the action.
    bwrap := ""
    if sys.is_linux() {
        bwrap = foundation_linux_bwrap() ?? return Err(err)
    } else {
        status: foundation_macos_sandbox_status()
        if !status.available -> return Err(NativeSandboxError.Unsupported(status.reason))
    }
    program: foundation_sandbox_executable(executable) ?? return Err(err)
    passed := [String]{}
    loop path in programs -> passed.push(foundation_sandbox_executable(path) ?? return Err(err))
    source: foundation_sandbox_real_directory(source_dir)
    output := String?{None}
    if output_dir == {
        .Val(path) -> output = Val(foundation_sandbox_real_directory(path))
        .None -> {}
    }
    checked_mounts: foundation_validate_read_only_mounts(mounts)
    output_is_separate: output != None
    // The source is always readable, and writable only as the private tree.
    source_writable: !output_is_separate

    spec := if sys.is_linux() -> foundation_linux_sandbox_spec(bwrap, source, output, env, share_network, source_writable, checked_mounts, program, args) else -> foundation_macos_sandbox_spec(source, output, env, share_network, source_writable, checked_mounts, program, passed, args)
    if timeout == .Val(limit) -> spec = spec.timeout(limit)
    mechanism: if sys.is_linux() -> "linux-bwrap" else -> "macos-seatbelt"
    Ok(NativeSandboxCommand{spec: spec.stdout(.Capture).stderr(.Capture).output_limit(NATIVE_SANDBOX_MAX_OUTPUT_BYTES), timeout, mechanism, policy: foundation_native_sandbox_policy(output_is_separate, share_network)})
}

// The canonical path of an executable a sandboxed child runs.
foundation_sandbox_executable: fn(executable: String) -[FS, Env]> String NativeSandboxError! {
    program: files.canonicalize(executable) ?? return Err(NativeSandboxError.Unsupported("sandbox executable is unavailable: {err}"))
    if !files.is_file(program) -> return Err(NativeSandboxError.Unsupported("sandbox executable `{program}` is not a file"))
    Ok(program)
}

// The argument that names the program at host path `program` (canonical) to a
// sandboxed child with `mounts`: the path it runs at there, the one the
// child's own executable gets.
foundation_sandbox_program_argument: fn(program: String, mounts: [NativeSandboxMount]) -[Env]> String Never! {
    if sys.is_linux() -> foundation_mounted_executable_path(program, mounts) else -> program.copy()
}

// The result of one sandboxed child `command` that ran to `receipt`.
foundation_native_sandbox_finish: fn(command: NativeSandboxCommand, receipt: ProcessReceipt) -> NativeSandboxOutput NativeSandboxError! {
    if receipt.timed_out {
        limit: command.timeout ?? panic("a timed-out sandbox run had a timeout")
        return Err(NativeSandboxError.TimedOut{limit_ms: limit.ns.div_euclid(1000000)})
    }
    if receipt.limit_hit == .Val(_) -> return Err(NativeSandboxError.IO("sandbox process output exceeded {NATIVE_SANDBOX_MAX_OUTPUT_BYTES} bytes"))
    Ok(NativeSandboxOutput{receipt, mechanism: command.mechanism, policy: command.policy})
}

// `bwrap` is the Bubblewrap foundation_linux_bwrap resolved for the action.
foundation_linux_sandbox_spec: fn(bwrap: String, source: String, output: String?, env: [String: String], share_network: Bool, source_writable: Bool, mounts: [NativeSandboxMount], program: String, args: [String]) -[FS, Env, Exec]> ProcessSpec NativeSandboxError! {
    argv := foundation_linux_sandbox_argv(bwrap, Val(source), output, env, share_network, true, source_writable, mounts, Val(files.basename(program)))
    argv.push(foundation_mounted_executable_path(program, mounts))
    loop arg in args -> argv.push(arg.copy())
    Ok(process.cmd(argv).env_clear())
}

foundation_macos_sandbox_spec: fn(source: String, output: String?, env: [String: String], share_network: Bool, source_writable: Bool, mounts: [NativeSandboxMount], program: String, programs: [String], args: [String]) -[Exec]> ProcessSpec NativeSandboxError! {
    // Seatbelt restricts real host paths; it has no mount namespace, so the
    // executable keeps its host path.
    profile: foundation_seatbelt_profile(program, programs, source, output, share_network, true, source_writable, mounts)
    // The profile is passed inline: a temporary `-f` profile could be
    // replaced between spawn and Seatbelt reading it.
    argv := [String]{NATIVE_SANDBOX_MACOS_EXEC, "-p", profile, program}
    loop arg in args -> argv.push(arg.copy())
    spec := process.cmd(argv).env_clear().cwd(source)
    if output == {
        .Val(path) -> spec = spec.env("JET_BUILD_OUTPUT", path)
        .None -> {}
    }
    loop name in foundation_sandbox_sorted_names(env) -> spec = spec.env(name, env[name])
    Ok(spec)
}

// The Bubblewrap argument vector up to and including the `--` that ends
// options; the caller appends the executable and its arguments.
foundation_linux_sandbox_argv: fn(bwrap: String, source: String?, output: String?, env: [String: String], share_network: Bool, source_readable: Bool, source_writable: Bool, mounts: [NativeSandboxMount], argv0: String?) -> [String] Never! {
    argv := [String]{
        bwrap, "--die-with-parent", "--new-session", "--unshare-all", "--unshare-user", "--disable-userns", "--assert-userns-disabled",
        "--cap-drop", "ALL", "--ro-bind-try", "/nix/store", "/nix/store", "--proc", "/proc", "--dev", "/dev",
        "--size", "67108864", "--tmpfs", "/tmp", "--dir", "/homeless-shelter", "--clearenv",
        "--setenv", "PATH", "/nix/store", "--setenv", "HOME", "/homeless-shelter",
    }
    source_bind: if {
        source_writable -> "--bind"
        source_readable -> "--ro-bind"
        else -> ""
    }
    if source == {
        .Val(source_path) -> {
            if output == {
                .Val(output_path) -> {
                    argv.push("--dir")
                    argv.push("/work")
                    if source_bind == "" {
                        argv.push("--dir")
                        argv.push("/work/source")
                    } else {
                        argv.push(source_bind)
                        argv.push(source_path.copy())
                        argv.push("/work/source")
                    }
                    output_args: [String]{"--bind", output_path, "/work/output", "--chdir", "/work/source", "--setenv", "JET_BUILD_OUTPUT", "/work/output"}
                    loop part in output_args -> argv.push(part)
                }
                .None -> {
                    if source_bind == "" {
                        argv.push("--dir")
                        argv.push("/work")
                    } else {
                        argv.push(source_bind)
                        argv.push(source_path.copy())
                        argv.push("/work")
                    }
                    argv.push("--chdir")
                    argv.push("/work")
                }
            }
        }
        .None -> {
            if output == {
                .Val(output_path) -> {
                    output_args: [String]{"--bind", output_path, "/work", "--chdir", "/work"}
                    loop part in output_args -> argv.push(part)
                }
                .None -> {
                    work_args: [String]{"--dir", "/work", "--chdir", "/work"}
                    loop part in work_args -> argv.push(part)
                }
            }
        }
    }
    loop mount in mounts {
        // Create every destination directory, then bind the source over it.
        destination := ""
        segments: mount.destination.split("/").to_list()
        loop segment in segments {
            if segment == "" -> next
            destination = "{destination}/{segment}"
            argv.push("--dir")
            argv.push(destination.copy())
        }
        argv.push("--ro-bind")
        argv.push(mount.source)
        argv.push(mount.destination)
    }
    if share_network -> argv.push("--share-net")
    loop name in foundation_sandbox_sorted_names(env) {
        argv.push("--setenv")
        argv.push(name.copy())
        argv.push(env[name])
    }
    if argv0 == {
        .Val(name) -> {
            argv.push("--argv0")
            argv.push(name.copy())
        }
        .None -> {}
    }
    // Options end here, so an executable or argument starting with a dash
    // stays in the command position.
    argv.push("--")
    argv
}

// The Seatbelt profile for one action: it runs `executable`, and `programs`
// it is passed, each of which it may run and read as it does `executable`.
foundation_seatbelt_profile: fn(executable: String, programs: [String], source: String, output: String?, share_network: Bool, source_readable: Bool, source_writable: Bool, mounts: [NativeSandboxMount]) -> String NativeSandboxError! {
    program: foundation_sbpl_path(executable)
    passed := [String]{}
    loop path in programs -> passed.push("  (literal \"{foundation_sbpl_path(path)}\")")
    source_path: foundation_sbpl_path(source)
    output_path := String?{None}
    if output == {
        .Val(path) -> output_path = Val(foundation_sbpl_path(path))
        .None -> {}
    }
    lines := [String]{"(version 1)", "(deny default)", "(import \"system.sb\")", "(allow process-fork)", "(allow process-exec", "  (literal \"{program}\")"}
    loop line in passed -> lines.push(line)
    loop mount in mounts -> lines.push("  (subpath \"{foundation_sbpl_path(mount.source)}\")")
    lines.push(")")
    lines.push("(allow file-read*")
    if source_readable -> lines.push("  (subpath \"{source_path}\")")
    if output_path == {
        .Val(path) -> lines.push("  (subpath \"{path}\")")
        .None -> {}
    }
    read_paths: [String]{"  (literal \"{program}\")", "  (subpath \"/System\")", "  (subpath \"/usr/lib\")", "  (subpath \"/usr/bin\")", "  (subpath \"/bin\")", "  (subpath \"/sbin\")"}
    loop line in read_paths -> lines.push(line)
    loop line in passed -> lines.push(line)
    lines.push("  (subpath \"/nix/store\")")
    loop mount in mounts {
        lines.push("  (subpath \"{foundation_sbpl_path(mount.source)}\")")
        if mount.destination != mount.source -> lines.push("  (subpath \"{foundation_sbpl_path(mount.destination)}\")")
    }
    profile := "{lines.join("\n")}\n)"
    if output_path == {
        .Val(path) -> profile = "{profile}(allow file-write* (subpath \"{path}\"))\n"
        .None -> {
            if source_writable -> profile = "{profile}(allow file-write* (subpath \"{source_path}\"))\n"
        }
    }
    profile = if share_network -> "{profile}(allow network*)\n" else -> "{profile}(deny network*)\n"
    Ok("{profile}(deny device*)\n")
}

// A path quoted for Seatbelt's profile language.
foundation_sbpl_path: fn(path: String) -> String NativeSandboxError! {
    if foundation_sandbox_has_control(path) -> return Err(NativeSandboxError.Unsupported("sandbox path contains a control character"))
    Ok(path.replace("\\", "\\\\").replace("\"", "\\\""))
}

foundation_sandbox_real_directory: fn(path: String) -[FS, Env]> String NativeSandboxError! {
    canonical: files.canonicalize(path) ?? return Err(NativeSandboxError.IO("sandbox directory `{path}`: {err}"))
    if !files.is_dir(canonical) -> return Err(NativeSandboxError.IO("sandbox path `{path}` is not a directory"))
    Ok(canonical)
}

// The canonical path of `program`: a path with a separator directly, else the
// first regular file of that name on PATH.
foundation_sandbox_program: fn(program: String) -[FS, Env]> String? Never! {
    candidate := program
    if !program.contains("/") {
        candidate = files.which(program) ?? return None
    }
    if !files.is_file(candidate) -> return None
    canonical: files.canonicalize(candidate) ?? return None
    Val(canonical)
}

// Environment names in key order, the order Rust's `BTreeMap` iterates.
foundation_sandbox_sorted_names: fn(env: [String: String]) -> [String] Never! {
    names := env.keys().to_list()
    names.sort()
    names
}

// Rust `char::is_control` over every scalar: C0, DEL and C1 controls.
foundation_sandbox_has_control: fn(text: String) -> Bool Never! {
    loop scalar in text.chars() {
        code: "{scalar}".bytes()
        first: Int.from_u8(code[0])
        if first < 32 || first == 127 -> return true
        if code.len() == 2 && first == 194 && Int.from_u8(code[1]) < 160 -> return true
    }
    false
}

// Each mount source must be a real directory (canonicalized); each destination
// an absolute, normalized directory other than `/`.
foundation_validate_read_only_mounts: fn(mounts: [NativeSandboxMount]) -[FS, Env]> [NativeSandboxMount] NativeSandboxError! {
    checked := [NativeSandboxMount]{}
    loop mount in mounts {
        info: files.stat(mount.source) ?? return Err(NativeSandboxError.Unsupported("sandbox mount source `{mount.source}` is unavailable: {err}"))
        if info.is_symlink || !info.is_dir -> return Err(NativeSandboxError.Unsupported("sandbox mount source `{mount.source}` is not a real directory"))
        source: foundation_sandbox_real_directory(mount.source)
        if !foundation_is_normalized_mount_destination(mount.destination) {
            return Err(NativeSandboxError.Unsupported("sandbox mount destination `{mount.destination}` is not an absolute, normalized directory"))
        }
        checked.push(NativeSandboxMount{source, destination: mount.destination})
    }
    Ok(checked)
}

foundation_is_normalized_mount_destination: fn(destination: String) -> Bool Never! {
    if !destination.starts_with("/") -> return false
    has_component := false
    segments: destination.split("/").to_list()
    loop segment in segments {
        if segment == "." || segment == ".." -> return false
        if segment != "" -> has_component = true
    }
    has_component
}

// Linux runs the executable at its path inside the mount whose relative
// remainder is deepest (the last such mount on ties), else at its host path.
foundation_mounted_executable_path: fn(executable: String, mounts: [NativeSandboxMount]) -> String Never! {
    best := String?{None}
    best_depth := -1
    loop mount in mounts {
        if !foundation_paths.is_relative_to(foundation_paths.of(executable), foundation_paths.of(mount.source)) -> next
        relative: files.relative(executable, mount.source)
        depth := 0
        segments: relative.split("/").to_list()
        loop segment in segments {
            if segment != "" && segment != "." -> depth += 1
        }
        if depth >= best_depth {
            best_depth = depth
            best = Val(if depth == 0 -> mount.destination else -> files.join(mount.destination, relative))
        }
    }
    best ?? executable
}
