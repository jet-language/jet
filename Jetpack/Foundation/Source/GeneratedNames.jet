// Generated-name policy for binders, ported from jet_foundation::Syntax
// (`sanitize_generated_name`, `canonical_name_case`, and
// `is_reserved_generated_name`). Binders name every generated type through
// this one policy so their output never collides with Jet's own names.

// Real Jet keywords (`JET_KEYWORD_LIST`).
@GENERATED_NAME_KEYWORDS :: [String]{
    "fn", "pub", "priv", "use", "as", "extern", "module", "if", "else", "loop", "in", "break",
    "return", "defer", "struct", "enum", "alias", "impl", "policy", "wrap", "trait", "tag",
    "effect", "derive", "distinct", "migration", "rename", "add", "remove", "change", "via",
    "self", "Unsafe", "Impure", "Context", "task", "freeze", "shared", "Transact", "Job", "Test",
    "Todo", "State", "Transition", "state", "protocol", "client", "server", "marker", "validate",
    "check", "true", "false", "None", "it"
}

// Lexer keywords and teaching words outside the keyword list, and the
// contextual `state` that stays legal (`KW_MUTATE`, `KW_MOVE`, `KW_COPY`,
// `KW_CONST`, `FOREIGN_MATCH`, `LIT_NULL`, `KW_STATE_DECL`).
@GENERATED_NAME_RETIRED_WORDS :: [String]{"mut", "take", "copy", "const", "match", "None"}
@GENERATED_NAME_CONTEXTUAL_STATE :: "state"

// Built-in type names a user writes (`JET_TYPE_LIST`).
@GENERATED_NAME_BUILTIN_TYPES :: [String]{
    "Int", "Float", "Bool", "String", "()", "Char", "Err", "Shared", "SharedSnapshot",
    "SharedRevisionError", "SharedGuard", "Shared.Weak", "Condition", "Task", "Receiver", "Sender",
    "TaskFailure", "HashMap", "BTreeMap", "Map", "Queue", "Set", "Rank", "PriorityQueue", "Cache",
    "Tally", "Bits", "Bytes", "ViewIter", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64",
    "F32", "F64"
}

// Built-in type names users cannot redefine (`Collections::RESERVED_TYPES`).
@GENERATED_NAME_RESERVED_TYPES :: [String]{
    "HashMap", "BTreeMap", "Map", "Char", "Bits", "Bytes", "Set", "Rank", "PriorityQueue", "Cache",
    "Iter", "ViewIter", "MemoStats", "RemoveBy", "Ordering", "Range", "SharedGuard", "Shared.Weak",
    "Condition", "Tally", "Queue", "Decimal", "Duration", "DurationUnit", "RangeError",
    "ExpiringValue", "Authority", "Validate", "Solver", "BuildContext", "BuildPlan", "BuildAction",
    "BuildTarget", "BuildToolchain", "BuildProbe", "BuildSigningIdentity", "BuildError",
    "ProgramInfo", "Cell", "CellReadGuard", "CellEditGuard"
}

// Prelude type spellings (`TYPE_DATA`, `TYPE_JSON`, `TYPE_REGEX`, `TYPE_URL`,
// `TYPE_PATH`, `TYPE_DATETIME`, `CLOCK_TYPE`, `TYPE_INSTANT`,
// `TYPE_FRACTION`, `TYPE_RESULT`, `TYPE_ERR`, `TYPE_NEVER`,
// `RETIRED_TYPE_ERROR`).
@GENERATED_NAME_PRELUDE_TYPES :: [String]{
    "DataTree", "JSON", "Regex", "URL", "Path", "DateTime", "Clock", "Instant", "Fraction",
    "Result", "Err", "Never", "Error"
}

// The compile-time mark a canonical name keeps in front of its re-cased body.
@GENERATED_NAME_COMPTIME_MARK :: "@"

// Whether generated source may not use `name`. This applies the keyword,
// built-in, reserved, and Prelude type tables; Core module type exports
// (`CoreModuleExports::is_core_type_name`) are not part of this check.
pub fn foundation_is_reserved_generated_name(name: String) -> Bool !Never {
    (@GENERATED_NAME_KEYWORDS.contains(name) && name != @GENERATED_NAME_CONTEXTUAL_STATE)
        || @GENERATED_NAME_RETIRED_WORDS.contains(name)
        || @GENERATED_NAME_BUILTIN_TYPES.contains(name)
        || @GENERATED_NAME_RESERVED_TYPES.contains(name)
        || @GENERATED_NAME_PRELUDE_TYPES.contains(name)
}

// `canonical_name_case(name, NameCase::Pascal)`: every `_`-separated word
// capitalized and joined, keeping one leading `_` and a leading `@`.
pub fn foundation_pascal_name_case(name: String) -> String !Never {
    if name.starts_with(@GENERATED_NAME_COMPTIME_MARK) {
        return "{@GENERATED_NAME_COMPTIME_MARK}{foundation_pascal_name_case(name.removeprefix(@GENERATED_NAME_COMPTIME_MARK))}"
    }
    leading :: name.starts_with("_")
    body := name
    loop body.starts_with("_") -> body = body.removeprefix("_")
    words := [String]{}
    loop word in body.split("_") {
        if word == "" -> next
        words.push(foundation_capitalize_first(word))
    }
    joined :: words.join("")
    if leading -> return "_{joined}"
    joined
}

fn foundation_capitalize_first(word: String) -> String !Never {
    out := [String]{}
    loop scalar in word.chars() {
        text :: "{scalar}"
        out.push(if out.len() == 0 -> text.to_upper() else -> text)
    }
    out.join("")
}

// `sanitize_generated_name(raw, NameCase::Pascal, fallback)`: turn an
// external name into a legal Pascal-case Jet type name, repairing every
// reserved result by appending `Type`.
pub fn foundation_generated_type_name(input: String, fallback: String) -> String !Never {
    // Clark-expanded names use `{uri}local`; the opening delimiter is
    // namespace syntax, not part of the identifier.
    raw := input
    loop raw.starts_with("@") || raw.starts_with("$") {
        raw = raw.removeprefix("@").removeprefix("$")
    }
    raw = raw.removeprefix("{{")
    normalized := ""
    loop scalar in raw.chars() {
        text :: "{scalar}"
        if {
            text == "_" -> {
                if !normalized.ends_with("_") -> normalized = "{normalized}_"
            }
            text.is_alphabetic() || text.is_numeric() -> normalized = "{normalized}{text}"
            normalized == "" -> {}
            !normalized.ends_with("_") -> normalized = "{normalized}_"
            else -> {}
        }
    }
    loop normalized.ends_with("_") -> normalized = normalized.removesuffix("_")
    if normalized == "" -> normalized = fallback
    result := foundation_pascal_name_case(normalized)
    loop result.ends_with("_") -> result = result.removesuffix("_")
    if result == "" -> result = foundation_pascal_name_case(fallback)
    // A preserved soft-public `_` is legal only before an alphabetic name.
    body :: result.removeprefix("_")
    if !foundation_starts_alphabetic(body) && body != "" -> result = body
    if result == "" -> result = foundation_pascal_name_case(fallback)
    if !foundation_starts_alphabetic(result.removeprefix("_")) && result.removeprefix("_") != "" -> result = "Type{result}"
    loop result == "_" || result.starts_with("__") || foundation_is_reserved_generated_name(result) {
        result = "{result}Type"
    }
    result
}

fn foundation_starts_alphabetic(text: String) -> Bool !Never {
    loop scalar in text.chars() -> return "{scalar}".is_alphabetic()
    false
}
