// The connected development receipt record
// ported once from jet_codegen::development_receipt. Hosts own the durable
// filesystem transaction; this home owns the record bytes.

use {
    jet_foundation.[
        ENV_JET_DEVELOPMENT_RECEIPT_CLOSURE_DIGEST,
        ENV_JET_DEVELOPMENT_RECEIPT_DIRECTORY,
        ENV_JET_DEVELOPMENT_RECEIPT_ENTRY,
        ENV_JET_DEVELOPMENT_RECEIPT_INPUT_COUNT,
        ENV_JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_DIGEST,
        ENV_JET_DEVELOPMENT_RECEIPT_INPUT_DIGEST,
        ENV_JET_DEVELOPMENT_RECEIPT_SOURCE_DIGEST,
        ENV_JET_DEVELOPMENT_RECEIPT_TARGET,
        ENV_JET_DEVELOPMENT_RECEIPT_TARGET_DIGEST,
    ]
}

JET_DEVELOPMENT_RECEIPT_HEADER: "jet-development-receipt-v1"
// One production-receipt environment protocol.
JET_DEVELOPMENT_RECEIPT_DIRECTORY_ENV: ENV_JET_DEVELOPMENT_RECEIPT_DIRECTORY
JET_DEVELOPMENT_RECEIPT_ENTRY_ENV: ENV_JET_DEVELOPMENT_RECEIPT_ENTRY
JET_DEVELOPMENT_RECEIPT_SOURCE_DIGEST_ENV: ENV_JET_DEVELOPMENT_RECEIPT_SOURCE_DIGEST
JET_DEVELOPMENT_RECEIPT_CLOSURE_DIGEST_ENV: ENV_JET_DEVELOPMENT_RECEIPT_CLOSURE_DIGEST
JET_DEVELOPMENT_RECEIPT_INPUT_DIGEST_ENV: ENV_JET_DEVELOPMENT_RECEIPT_INPUT_DIGEST
JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_ENV: ENV_JET_DEVELOPMENT_RECEIPT_INPUT_COUNT
JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_DIGEST_ENV: ENV_JET_DEVELOPMENT_RECEIPT_INPUT_COUNT_DIGEST
JET_DEVELOPMENT_RECEIPT_TARGET_ENV: ENV_JET_DEVELOPMENT_RECEIPT_TARGET
JET_DEVELOPMENT_RECEIPT_TARGET_DIGEST_ENV: ENV_JET_DEVELOPMENT_RECEIPT_TARGET_DIGEST

JetDevelopmentReceiptInput: struct {
    name: String
    digest: String
}

JetDevelopmentReceiptPath: struct {
    code: String
    file: String
    line: Int
    function: String
}

JetDevelopmentReceipt: struct {
    act: String
    locked_closure: String
    inputs: [JetDevelopmentReceiptInput]
    planned_action: String
    outputs: [JetDevelopmentReceiptInput]
    activation_proof: String
    parent_generation: String
    witness: String
    outcome: String
    failure_path: JetDevelopmentReceiptPath?

    render: fn(self) -> String Never! {
        out := "{JET_DEVELOPMENT_RECEIPT_HEADER}\n"
        out = "{out}{jet_receipt_line("act", "", self.act)}"
        out = "{out}{jet_receipt_line("closure", "", self.locked_closure)}"
        loop input in jet_receipt_sorted_pairs(self.inputs) -> out = "{out}{jet_receipt_line("input", input.name, input.digest)}"
        out = "{out}{jet_receipt_line("action", "planned", self.planned_action)}"
        loop output in jet_receipt_sorted_pairs(self.outputs) -> out = "{out}{jet_receipt_line("output", output.name, output.digest)}"
        out = "{out}{jet_receipt_line("activation-proof", "", self.activation_proof)}"
        out = "{out}{jet_receipt_line("parent-generation", "", self.parent_generation)}"
        out = "{out}{jet_receipt_line("witness", "", self.witness)}"
        if self.failure_path == {
            .Val(path) -> {
                out = "{out}{jet_receipt_line("failure-path", "code", path.code)}"
                out = "{out}{jet_receipt_line("failure-path", "file", path.file)}"
                out = "{out}{jet_receipt_line("failure-path", "line", "{path.line}")}"
                out = "{out}{jet_receipt_line("failure-path", "function", path.function)}"
            }
            .None -> {}
        }
        "{out}{jet_receipt_line("outcome", "", self.outcome)}"
    }

    // The stable identity of an act, independent of its witness and result.
    // Inputs are sorted so callers cannot manufacture a second identity by
    // presenting the same locked closure in a different order.
    identity_bytes: fn(self) -> [U8] Never! {
        out := "jet-development-act-v1".bytes()
        out.push(U8{0})
        jet_receipt_frame(out, self.act)
        jet_receipt_frame(out, self.locked_closure)
        loop input in jet_receipt_sorted_pairs(self.inputs) {
            jet_receipt_frame(out, input.name)
            jet_receipt_frame(out, input.digest)
        }
        jet_receipt_frame(out, self.planned_action)
        out
    }
}

// The shared symbol hosts use to serialize a receipt.
jet_development_receipt_render: fn(receipt: JetDevelopmentReceipt) -> String Never! {
    receipt.render()
}

// Whether `value` is a `sha256-<64 lowercase hex>` content address.
jet_receipt_is_content_address: fn(value: String) -> Bool Never! {
    if !value.starts_with("sha256-") -> return false
    digits: value.removeprefix("sha256-").bytes()
    if digits.len() != 64 -> return false
    loop byte in digits {
        code: Int.from_u8(byte)
        if !((code >= 48 && code <= 57) || (code >= 97 && code <= 102)) -> return false
    }
    true
}

// Inputs ordered by (name, digest).
jet_receipt_sorted_pairs: fn(values: [JetDevelopmentReceiptInput]) -> [JetDevelopmentReceiptInput] Never! {
    sorted := values.copy()
    sorted.sort_by(fn(left: JetDevelopmentReceiptInput, right: JetDevelopmentReceiptInput) { (left.name <=> right.name).then(left.digest <=> right.digest) })
    sorted
}

// One `kind\thex(name)\thex(value)\n` record line.
jet_receipt_line: fn(kind: String, name: String, value: String) -> String Never! {
    "{kind}\t{jet_receipt_hex(name)}\t{jet_receipt_hex(value)}\n"
}

jet_receipt_hex: fn(value: String) -> String Never! {
    digits: "0123456789abcdef".bytes()
    out := [U8]{}
    loop byte in value.bytes() {
        code: Int.from_u8(byte)
        out.push(digits[code >> 4])
        out.push(digits[(code).bit_and(15)])
    }
    String.from_bytes(out) ?? ""
}

// An 8-byte big-endian length followed by the UTF-8 bytes.
jet_receipt_frame: fn(out: &[U8], value: String) Never! {
    bytes: value.bytes()
    shift := 56
    loop shift >= 0 {
        out.push(U8{((bytes.len() >> shift)).bit_and(255)})
        shift -= 8
    }
    loop byte in bytes -> out.push(byte)
}
