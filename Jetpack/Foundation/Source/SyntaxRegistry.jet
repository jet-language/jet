SERVICES_VERB_UP: "up"
SERVICES_VERB_DOWN: "down"
SERVICES_VERB_HEALTH: "health"
SERVICES_VERB_LOGS: "logs"
SERVICES_VERB_RESTART: "restart"
SERVICES_VERB_WAIT: "wait"
SERVICES_VERB_WATCH: "watch"
