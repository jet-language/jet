CONFIG_VERB_SANDBOX: "sandbox"
CONFIG_TRUST_VERB_ADD: "add"
CONFIG_TRUST_VERB_LIST: "list"
CONFIG_TRUST_VERB_REMOVE: "remove"
CONFIG_TRUST_VERBS: [String]{
    CONFIG_TRUST_VERB_ADD,
    CONFIG_TRUST_VERB_LIST,
    CONFIG_TRUST_VERB_REMOVE,
}
CONFIG_SANDBOX_VERB_REQUIRE: "require"
CONFIG_SANDBOX_VERB_ALLOW: "allow"
CONFIG_SANDBOX_VERB_STATUS: "status"
CONFIG_SANDBOX_VERBS: [String]{
    CONFIG_SANDBOX_VERB_REQUIRE,
    CONFIG_SANDBOX_VERB_ALLOW,
    CONFIG_SANDBOX_VERB_STATUS,
}

/// U19: the one-shot bypass flag for the env/dev trust gate — never persists
/// a grant (unlike accepting the interactive prompt, which does).
TRUST_BYPASS_FLAG: "--trust"

/// U19: the shared trust store, `~/.jet/trust` (home-scoped: a user's trust
/// decisions follow them across projects). Plain newline-separated
/// `hash:`/`pattern:` lines. `Jetpack::Recipe`'s adapter trust marker uses the
/// same store and record format. Lives under the same default dir as
/// `~/.jet/config.jet` (`CONFIG_DEFAULT_DIR`).
TRUST_FILE: "trust"

/// (A1, card c9jetpackgates): `jet` execs the engine
/// binary (`jetpack`, later `jetos`) for every engine verb instead of linking
/// it in-process — git/kubectl-style dispatch by executable name. Before
/// exec-ing the real command, `jet` runs `<engine> --engine-protocol`, a
/// hidden handshake flag every engine binary answers with its own
/// `CARGO_PKG_VERSION` on stdout; a mismatch against `jet`'s own version is
/// E1227 (`engine-version-skew`). This is process-dispatch plumbing between
/// two binaries jet ships together, never a token a user writes in a `.jet`
/// file, so I7 (every user-typeable keyword lives here with a decision ID)
/// does not require it to gate a Tower ballot of its own — it is this
/// gate's own implementation surface.
ENGINE_PROTOCOL_FLAG: "--engine-protocol"

/// Amended by owner ruling 2026-08-25: the visible prompt label
/// inside a Jetpack shell. The environment belongs to jetpack, so the prompt
/// names jetpack rather than the compiler.
JETPACK_PROMPT_LABEL: "jetpack"

/// Shell marker env var set inside a Jetpack shell.
JETPACK_ENV_MARKER: "JETPACK_ENV"

/// Env var carrying the realized package refs inside a Jetpack shell.
JETPACK_REF_VAR: "JETPACK_REF"

/// Prompt hook activation identity.
ENV_HOOK_ACTIVE_HASH_VAR: "JETPACK_ENV_HASH"

/// (predates the current numbering; current directive law
/// lives under): the directive calls an `env.jet` author
/// writes. `pkg.source`
/// takes one arg (default built-in source) or two (named source + upstream/pin,
/// ). Packages reference named sources as `package@source`.
PACK_DIRECTIVE_SOURCE: "pkg.source"
PACK_DIRECTIVE_PACKAGES: "pkg.packages"
PACK_DIRECTIVE_PROMPT: "pkg.prompt"

/// U3 (ratified 2026-06-16): module declaration keyword — `name: module { … }`.
KW_MODULE: "module"

/// (ratified 2026-06-25, option A): the monorepo index is the
/// reserved namespace `workspace` — `workspace: module { members: … }` in
/// `workspace.jet` (see WORKSPACE_FILE). Owner kept the
/// industry-standard term over the aviation menu (`fleet`/`wing`/…). Not yet wired
/// (resolver rides board card c156).
NS_WORKSPACE: "workspace"

/// U3 (ratified 2026-06-16): the type matching each reserved namespace.
TYPE_ENV: "Env"

/// The type name of a `profile.<name>` contribution.
TYPE_PROFILE: "Profile"

/// Structured prompt config inside an `Env` contribution.
TYPE_PROMPT: "Prompt"
TYPE_SYSTEM: "System"

/// A Library may declare a `.jetlib` loadable artifact.
OUTPUT_FIELD_LOADABLE: "loadable"

/// A Library requests native static/shared output.
OUTPUT_FIELD_NATIVE: "native"

/// Names the foreign binding generators to run.
OUTPUT_FIELD_BINDINGS: "bindings"

/// Frozen jetos sketch fields kept only for legacy
/// parser/evaluator coverage while `system.*` is outside current syntax law.
SYSTEM_FIELD_TARGET: "target"
SYSTEM_FIELD_PACKAGES: "packages"

/// Package-generation fields. `profile.<name>` declarations
/// are source-backed package sets; generation switching belongs to the shared
/// generation engine.
PROFILE_FIELD_EXTENDS: "extends"
PROFILE_FIELD_PACKAGES: "packages"
PROFILE_FIELD_COLLISIONS: "collisions"

/// The required first field of every `Service` record.
SERVICE_FIELD_ENABLE: "enable"

/// (supervised-services slice, card c9jetpackgates):
/// the recognized fields of a **dev-supervised** `Service` (an entry under an
/// `env.<name>` role-module's `services:` map). `Service` stays the one
/// ratified open record either way (same grammar as `system.*.services`,
/// `SYSTEM_FIELD_SERVICES`/`SERVICE_FIELD_ENABLE` reused verbatim) — only the
/// dev-runtime tier (`Jetpack::Services`) interprets these particular keys,
/// to start/probe/stop the supervised process: `ports` (the `[Int]` TCP ports
/// it listens on), `run` (the executable plus argv that starts it), `shutdown`
/// (the typed stop policy, else a bounded signal sequence), `data_dir` (its
/// persisted-state directory, else `.jet/services/<name>/data`), and `ready`
/// (a shell command polled until it exits 0 — the readiness contract, else a
/// TCP probe on `ports[0]`, else a bare process-alive check). Dependencies use
/// `after` only; retired `depends_on` declarations are rejected by the dev
/// supervisor as E1262.
DEV_SERVICE_FIELD_PORTS: "ports"
DEV_SERVICE_FIELD_RUN: "run"
DEV_SERVICE_FIELD_SHUTDOWN: "shutdown"
DEV_SERVICE_FIELD_DATA_DIR: "data_dir"
DEV_SERVICE_FIELD_READY: "ready"
DEV_SERVICE_FIELD_RESTART: "restart"
DEV_SERVICE_FIELD_WATCH: "watch"
DEV_SERVICE_FIELD_AFTER: "after"
DEV_SERVICE_FIELD_BEFORE_START: "before_start"
DEV_SERVICE_FIELD_SOCKETS: "sockets"

/// The typed platform values a `System.target` (and a
/// cross-compile `Image.target`) may hold — `linux.x64` / `linux.arm64`. Written
/// as a dotted typed value (an OS namespace `.` an arch), never a quoted string.
PLATFORM_OS_LINUX: "linux"
PLATFORM_ARCH_X64: "x64"
PLATFORM_ARCH_ARM64: "arm64"
IMAGE_FIELD_FORMAT: "format"

/// The disk-image formats — `iso` (default) / `qcow` /
/// `raw`.
IMAGE_FORMAT_ISO: "iso"
IMAGE_FORMAT_QCOW: "qcow"
IMAGE_FORMAT_RAW: "raw"

/// An `Image`'s optional `kind:` — a leading-dot enum literal
/// (`.Oci`/`.Iso`) picking which referent `from:` names. Omitted,
/// it infers from `from:` itself (`system.*` → Iso, `packages.*` → Oci); written,
/// it must agree with `from:` or name a real kind (E1266 `image-unknown-kind`).
IMAGE_KIND_ISO: "Iso"
IMAGE_KIND_OCI: "Oci"

/// The `.Oci`-only fields — exposed TCP ports (`[Int]`), env vars
/// (a `[KEY: "value"]` map), extra files layered into the image (`[String]`
/// project-relative paths), and an optional base image escape hatch
/// (`base: oci("<ref>")`, unrealized — no registry-pull client yet -
/// RINGSHIP1 territory, honestly gated rather than faked).
/// This rule adds the existing environment-image controls `target`,
/// `services`, `health`, `entrypoint`, and `user` to this same record.
IMAGE_FIELD_KIND: "kind"
IMAGE_FIELD_EXPOSE: "expose"
IMAGE_FIELD_ENV_VARS: "env_vars"
IMAGE_FIELD_FILES: "files"
IMAGE_FIELD_BASE: "base"

/// Optional environment-image projection controls.
IMAGE_FIELD_SERVICES: "services"
IMAGE_FIELD_HEALTH: "health"
IMAGE_FIELD_ENTRYPOINT: "entrypoint"
IMAGE_FIELD_USER: "user"

/// The `oci(...)` call name inside `base: oci("<ref>")`.
IMAGE_BASE_FN: "oci"

/// U3 (ratified 2026-06-16): project environment file (`env` namespace) and the
/// master jetos system config (`system`/`image` namespaces, default dir ~/.jet/).
ENV_FILE: "env.jet"
CONFIG_FILE: "config.jet"

/// The one reserved Package source filename. `pkg.jet`
/// remains only as explicit migration input while the current root is
/// `package.jet`.
PACKAGE_FILE: "package.jet"

/// (B) + (A), ratified 2026-06-25: the monorepo index
/// is a `workspace: module { members: … }` written in `workspace.jet`, parallel to
/// `env.jet`/`config.jet`; the old root `jetpack.toml` plane is retired so the
/// whole project uses one grammar (Jet). `members:` may run arbitrary `#run`
/// . Wired by the resolver (board card c156). `NS_WORKSPACE` is
/// declared with the other reserved namespaces near `NS_ENV`.
WORKSPACE_FILE: "workspace.jet"

/// Reviewed workspace overlay blocks.
WORKSPACE_OVERLAY: "overlay"

/// The `members:` field in a workspace module — the comptime
/// expression that evaluates to the list of member package paths.
MODULE_FIELD_MEMBERS: "members"

/// (ratified 2026-07-06): the public jetos CLI surface is
/// `jet os <verb>`. The engine still executes in the `jetpack` process via
/// But users type `jet os`, not `jetpack os`.
OS_SUBCOMMAND: "os"

/// Public jetos verbs.
OS_VERB_CHECK: "check"
OS_VERB_INIT: "init"
OS_VERB_SWITCH: "switch"
OS_VERB_BUILD: "build"

/// Read the exact checked plan without building.
OS_VERB_PLAN: "plan"

/// Read proof/provenance artifacts for the latest generation.
OS_VERB_PROOF: "proof"
OS_VERB_ROLLBACK: "rollback"
OS_VERB_GENERATIONS: "generations"
OS_VERB_LIFT: "lift"

/// Import semantic NixOS/flake-parts/Home Manager facts.
OS_VERB_IMPORT: "import"

/// Explicit access to migration-only backends.
OS_VERB_MIGRATE: "migrate"
OS_VERB_IMAGE: "image"

/// `jet os vm prove` runs installer/reboot proof.
OS_VERB_VM: "vm"

/// `jet os push <host>`: the CLI registry's push action under `os`.
OS_VERB_PUSH: "push"

/// `jetos studio`.
STUDIO_SUBCOMMAND: "studio"

/// Standalone user-profile management entrypoint.
USER_SUBCOMMAND: "user"

/// Every `jet os` verb: the jetos dispatcher's own verbs, then the actions the
/// CLI registry routes under `os`.
OS_VERBS: [String]{
    OS_VERB_CHECK,
    OS_VERB_INIT,
    OS_VERB_PLAN,
    OS_VERB_PROOF,
    OS_VERB_BUILD,
    OS_VERB_SWITCH,
    OS_VERB_ROLLBACK,
    OS_VERB_GENERATIONS,
    OS_VERB_LIFT,
    OS_VERB_IMPORT,
    OS_VERB_MIGRATE,
    OS_VERB_IMAGE,
    OS_VERB_VM,
    STUDIO_SUBCOMMAND,
    USER_SUBCOMMAND,
    OS_VERB_PUSH,
    BRIDGE_SUBCOMMAND,
    SERVICES_SUBCOMMAND,
    CONFIG_SUBCOMMAND,
}

/// This rule amends a bare host discovers `system.<host>` in
/// the current repo; `host@root` selects an exact external repo/config root.
OS_HOST_SELECTOR: "@"

/// Current-repo/external-root config filename.
CONFIG_DEFAULT_DIR: ".jet"

/// Switch may override the generated generation name.
OS_FLAG_NAME: "--name"

/// Consequence-scaled CLI output accepts both spellings for
/// bypassing mutation confirmation gates.
CLI_FLAG_YES_SHORT: "-y"
CLI_FLAG_YES_LONG: "--yes"

/// `jetpack update` scope selectors.
UPDATE_FLAG_DEPS: "--deps"
UPDATE_FLAG_TOOLS: "--tools"

/// U4 (ratified 2026-06-16): import-tree discovery builtin — `find("./modules")`
/// auto-discovers and merges every `.jet` module in the tree.
BUILTIN_FIND: "find"

/// First-party environment integrations are ordinary
/// typed import calls. They lower into the existing package/file/task/provider
/// and trust facts; they do not create a private resolver or activation plane.
ENV_INTEGRATION_ANDROID: "env.platform.android"
ENV_INTEGRATION_APPLE: "env.platform.apple"
ENV_INTEGRATION_CERTIFICATES: "env.security.certificates"
ENV_INTEGRATION_HOSTS: "env.network.hosts"
ENV_INTEGRATION_CODEX: "env.agent.codex"
ENV_INTEGRATION_EDITOR: "env.editor.vscode"
ENV_INTEGRATION_CLOUD: "env.cloud.credentials"
ENV_INTEGRATION_VAULT: "env.security.vault"

/// U6/U8: the conventional name of the default source (`sources: { default: … }`)
/// that bare packages and `default.ripgrep` sugar resolve against. Not a
/// reserved keyword — just the well-known name `jetpack` falls back to.
DEFAULT_SOURCE: "default"

/// U3/U8: the `Env` contribution field carrying the shell prompt label.
ENV_FIELD_PROMPT: "prompt"

/// Typed environment lifecycle fields.
ENV_FIELD_DOTENV: "dotenv"
ENV_FIELD_UNSET: "unset"
ENV_FIELD_ON_ENTER: "on_enter"
ENV_FIELD_CHECKS: "checks"
ENV_FIELD_RELOAD: "reload"

/// Map the typed environment to the project's Git hook directory.
ENV_FIELD_GIT_HOOKS_PATH: "git_hooks_path"

/// Typed environment formatter package for non-`.jet` files.
ENV_FIELD_FORMATTER: "formatter"

/// Renamed by typed
/// environment composition fields. A preset is one named composition.
ENV_FIELD_PRESETS: "presets"
ENV_FIELD_LANGUAGES: "languages"

/// Managed project-relative file declarations.
ENV_FIELD_FILES: "files"

/// -ENV-FACET1: select one declared environment module
/// (`env.<name>`). This is the environment axis; `--preset` selects a
/// declared composition.
ENV_FLAG_ENV: "--env"
ENV_FLAG_PRESET: "--preset"

/// `Prompt{ label: "...", path: .Short, strip: .On }`.
PROMPT_FIELD_LABEL: "label"
PROMPT_FIELD_PATH: "path"
PROMPT_FIELD_STRIP: "strip"
PROMPT_SETTING_PATH: "prompt.path"
PROMPT_SETTING_STRIP: "prompt.strip"
PROMPT_PATH_SHORT: "Short"
PROMPT_PATH_FULL: "Full"
PROMPT_STRIP_ON: "On"
PROMPT_STRIP_OFF: "Off"
REF_PROVIDER_AT: "@"

/// Migration-era wrapper filename. The canonical Package root is
/// `PACKAGE_FILE`; this spelling is accepted only by the explicit migration
/// adapter and never competes with a canonical root.
PAYLOAD_FILE: "pkg.jet"

/// (ratified 2026-08-06): the top-level
/// identity fields — bare `name:`/`version:`, no wrapper. Supersedes the
/// U10 `payload: { name, version, … }` block and the `identity: .{
/// }` block; both are retired to a normal unknown-field error (E1215).
MANIFEST_FIELD_NAME: "name"
MANIFEST_FIELD_VERSION: "version"

/// The block nouns of the one Package manifest
/// vocabulary, alongside `MANIFEST_BLOCK_PACKAGES`/`MANIFEST_BLOCK_BUILD`/
/// `MANIFEST_BLOCK_EFFECTS`/`MANIFEST_BLOCK_GRANTS`/`MANIFEST_BLOCK_POLICY`
/// (each already declared with its own decision). `settings:` declares the
/// typed build facts consumed by `#build.settings.*`.
MANIFEST_BLOCK_DEPS: "deps"
MANIFEST_BLOCK_OUTPUTS: "outputs"
MANIFEST_BLOCK_SETTINGS: "settings"
MANIFEST_BLOCK_MEMBERS: "members"

/// (ratified 2026-08-19): package-owned import boundaries
/// live under `boundaries: { deny: [ ... ] }`.
MANIFEST_BLOCK_BOUNDARIES: "boundaries"

/// (ratified 2026-06-21): a package's build targets, replacing the
/// removed `kind:` (U10). The five shipped targets — `library` is imported for its
/// code, `executable` installs a binary on PATH, `test`/`example` build their own
/// artifacts, and `sandbox` (c81) builds an isolated WASM Component Model
/// module. Written as a bare keyword (`deploy: executable`) or inside a
/// `{ targets: [ … ] }` list.
TARGET_LIBRARY: "library"
TARGET_EXECUTABLE: "executable"
TARGET_TEST: "test"
TARGET_EXAMPLE: "example"

/// (ratified 2026-06-25; backend shipped c81): a
/// package built as `sandbox` compiles to an isolated `wasm32` Component Model
/// module (Jet plugin-engine host, typed `.wit` contract) instead of a native binary.
/// Safe by default — no `#Unsafe` gate (I1 holds by construction: the sandbox
/// is the safety boundary). Its exported surface is named by the `export:`
/// target field (`TARGET_FIELD_EXPORT`).
TARGET_SANDBOX: "sandbox"

/// (ratified 2026-06-21): target keywords reserved for a future increment —
/// recognized but rejected (no backend yet) until their tooling lands.
/// `sandbox` shipped (c81). Empty until the next reserved target is proposed.
TARGET_RESERVED: [String]{}

/// (ratified 2026-06-21): the per-package field listing build targets —
/// `app: { targets: [library, executable { entry: "src/cli.jet" }] }`. A bare
/// keyword value (`app: library`) is the single-target shorthand.
PACKAGE_FIELD_TARGETS: "targets"

/// (ratified 2026-06-21): fields a target block may carry —
/// `entry:` (entry module), `name:` (output/bin name). Parsed when
/// present; behavior lands with the realize pipeline. `api:` is
/// retired by S2 — a target block carrying it hits the ordinary
/// unknown-field error like any other typo'd key.
TARGET_FIELD_ENTRY: "entry"
TARGET_FIELD_NAME: "name"

/// (ratified 2026-06-25): names a `sandbox` target's exported
/// surface (the `.wit` world name). Only meaningful on `sandbox { export: "…" }`;
/// defaults to the package name when omitted.
TARGET_FIELD_EXPORT: "export"

/// (ratified 2026-06-16): the project compatibility marker — `edition: "2026"`
/// in the `payload: { … }` block of `pkg.jet`. An edition opts a project into a
/// specific era of Jet syntax; a toolchain advertises the editions it supports
/// and rejects a future edition it can't provide (E2001). Single-file `jet run
/// file.jet` has no edition marker and always uses the newest stable edition
/// (E2-V4). Not an `S`/`N`/`U` surface decision, so it is not; it is a
/// release-policy key recorded here per I7.
MANIFEST_FIELD_EDITION: "edition"

/// S68 (ratified): `if` is the one branching keyword, including
/// ordered subjectless statement/value guard tables.
KW_IF: "if"
KW_ELSE: "else"

/// (ratified 2026-08-28, card #2283): bare `in` is
/// the source-loop binding/source separator and is not a membership operator
/// in value position; the postfix lexer/parser admits it only after `.`.
KW_IN: "in"

/// S23 (ratified) + loop control. Bare payloads return from the innermost
/// loop; `break(name[, value])` and `next(name)` select named loop targets.
KW_BREAK: "break"

/// Contextual statement/fallback control.
KW_NEXT: "next"

/// S11 (ratified): the two `Bool` literals.
LIT_TRUE: "true"
LIT_FALSE: "false"

/// S16 (ratified M6; amended 2026-06-16, #6542): file path or module `use`; optional `alias:`.
KW_USE: "use"
KW_AS: "as"

/// S50 (ratified M7): Rust FFI block introducers — `extern rust "…" { … }`.
KW_EXTERN: "extern" // S50
KW_RUST: "rust" // S50
PY_MODULE_ROOT: "py"
JS_MODULE_ROOT: "js"
SWIFT_MODULE_ROOT: "swift"
GO_MODULE_ROOT: "go"
JAVA_MODULE_ROOT: "java"
CS_MODULE_ROOT: "cs"
TCL_MODULE_ROOT: "tcl"
LUA_MODULE_ROOT: "lua"
FORTRAN_MODULE_ROOT: "fortran"
COBOL_MODULE_ROOT: "cobol"
ADA_MODULE_ROOT: "ada"
PASCAL_MODULE_ROOT: "pascal"
DART_MODULE_ROOT: "dart"
PWSH_MODULE_ROOT: "pwsh"
PERL_MODULE_ROOT: "perl"
RUBY_MODULE_ROOT: "ruby"
PHP_MODULE_ROOT: "php"
R_MODULE_ROOT: "r"
OCTAVE_MODULE_ROOT: "octave"
COM_MODULE_ROOT: "com"

/// S59 (ratified E2-M14): C FFI module path root — `c.<lib>`, `c.<lib>.__bindgen__`.
C_MODULE_ROOT: "c" // S59

/// (ratified 2026-07-11, card #501): C++ foreign root — the
/// `cpp.<lib>` namespace binder and the `#FFI(cpp)` inline-tier language name.
CPP_MODULE_ROOT: "cpp"

/// Generated foreign bindings live under `.jet/bindings/<lang>/`.
BINDINGS_ROOT_SUBDIR: "bindings"

/// S28 (ratified M9): trait declaration keyword.
/// (ratified 2026-06-26): the trait separator in top-level impl blocks
/// is `.` — `impl Type.Trait { … }` / `impl Type.Trait using field`. Amends
/// S28/S62; retires `~~` (S83).
KW_TRAIT: "trait"

/// (ratified 2026-06-21): tag declaration keyword — a marker qualifier
/// with no methods that erases at runtime. The beginner rule: methods → trait,
/// no methods → tag. Declaring a method on a `tag` is E0732; using a tag where
/// dispatch is expected is E0731.
KW_TAG: "tag"

/// S55 (ratified M9): opt-in built-in derive line in a type body.
KW_DERIVE: "derive"

/// S43 (ratified M6; PascalCase marker follow-on 2026-06-21):
/// top-level test-declaration block, written as the marker `#Test("name") { … }`.
/// (ratified 2026-06-26): the name is now a parenthesized string
/// argument, matching the `#FX(…)` marker family.
/// (ratified 2026-08-12): the optional `faults: [Effect]`
/// argument names effect-root call sites for the deterministic test harness.
/// The bare lowercase `test` keyword (FOREIGN_TEST) is the retired spelling;
/// no rule accepts it.
KW_TEST: "Test"

/// `#Job fn` — a top-level function Jet can
/// invoke as an argv subcommand, living beside `run: fn()`. The word is `job`
/// everywhere (marker, `jet jobs`, diagnostics). Bare marker defaults to `.Dev`.
KW_JOB: "Job"

/// S52 (ratified M12; amended 2026-06-16, U2): the unified single lockfile lives
/// inside the `.jet/` managed folder (SOURCE_ROOT_DIR). Replaces `jet.lock`
/// (and `pack.lock`); the manifest reshape chunk migrates the old paths.
UNIFIED_LOCK_FILE: ".jet/lock"

/// Legacy migration source only. Moved the default Hangar to
/// the native per-user data path; this retired root-owned path is never used
/// for new resolution.
HANGAR_DIR: "/etc/jet/hangar"

/// `run.jet` is the conventional stock entry for `jet run` and the `jet run`
/// command home: a root `run.jet` without `run: fn` is an inert home that the
/// stock entry runs.
DEFAULT_ENTRY_FILE: "run.jet"

/// One optional leading contextual Package carrier
/// may live in the entry source as `package: { … }`. The word remains
/// contextual so `pub(package)` keeps its existing visibility meaning.
INLINE_PACKAGE_DECL: "package"

/// The optional package-root command homes, named for their commands with no
/// mark. The home names are closed to these four commands; there is no
/// command directory and no package/module role-file spelling. The same
/// names below the package root are ordinary source.
COMMAND_FILE_RUN: "run.jet"
COMMAND_FILE_BUILD: "build.jet"
COMMAND_FILE_DEV: "dev.jet"
COMMAND_FILE_TEST: "test.jet"
COMMAND_ROLE_FILES: [String]{
    COMMAND_FILE_RUN,
    COMMAND_FILE_BUILD,
    COMMAND_FILE_DEV,
    COMMAND_FILE_TEST,
}

/// (ratified 2026-06-19): `UserId: distinct Int` — declares a
/// distinct type (a separate nominal type sharing the base's representation).
/// Used in the value position of a `:` immutable binding at item level;
/// `distinct`-over-`distinct` chaining is rejected in v1.
KW_DISTINCT: "distinct"

/// (ratified 2026-06-22): contextual keyword `migration` — introduces
/// a migration block that declares how a `#PublishedSchema` struct changed between
/// releases. Used as `migration TypeName { rename old -> new }`.
/// (ratified 2026-07-12, card #506): contextual keyword `validate`
/// — introduces the in-body `validate { … }` block inside a struct definition
/// (S82 in-body grammar). Rules are `check(cond, at: field, "msg")`
/// statements; sema resolves `field` as a bare sibling reference
/// and purity-checks `cond`/`msg` (reuses the `#Pre`/`#Post`
/// checker). Failing `check`s accumulate into `[FieldError]`; `decode<T>()`
/// runs the block automatically on a successfully shape-decoded value, and
/// `Type.validate(value)` runs it standalone. `Validate.over(s)` is the
/// use-site escape for rules needing outside context.
KW_VALIDATE_BLOCK: "validate"

/// The builtin call name inside a `validate { … }` block —
/// `check(cond, at: field, "msg")` records one `FieldError { path, reason }`
/// when `cond` is false. Contextual: recognized as this builtin only inside
/// a `validate { … }` block; an ordinary function named `check` elsewhere is
/// unaffected.
VALIDATE_CHECK_FN: "check"
KW_MIGRATION: "migration"

/// (ratified 2026-06-22): contextual keyword `rename` inside a
/// `migration { }` block — declares that field `old` was renamed to `new`.
KW_RENAME: "rename"

/// (ratified): `add f: T = default` inside a `migration { }` block —
/// declares a new field plus the default old records are read with.
KW_ADD: "add"

/// (ratified): `remove f` inside a `migration { }` block — deletes a
/// field. The verb is `remove`, NOT `drop` (a `drop` op is taught back to this).
KW_REMOVE: "remove"

/// Amended by
/// `change f: Old -> New [via { … }]` inside a
/// `migration { }` block — a field type change with an optional inline converter.
KW_CHANGE: "change"

/// (ratified): the `via { expr }` clause that supplies the inline
/// converter for a `change` op
/// (`change price: Int -> Usd via { c -> Usd.from_int(c) }`).
///
/// (ratified 2026-06-22): also the pass-through marker in a `#(via f)`
/// signature annotation — a function whose published effect set IS whatever the
/// callback parameter `f` carries (a tight pass-through that holds when the value
/// escapes, vs. the conservative flow-through default). Erased in codegen (I3).
KW_VIA: "via"

/// Canonical list of real Jet keywords for LSP completion and rename validation.
///
/// Every entry corresponds to a `KW_*`, `LIT_*`, or `BUILTIN_*` constant above.
/// FOREIGN_* words must NOT appear here — no rule accepts them.
JET_KEYWORD_LIST: [String]{
    // Core structure (S1 S16, S50, U3)
    KW_FN,
    KW_PUB,
    KW_PRIV,
    KW_USE,
    KW_AS,
    KW_EXTERN,
    KW_MODULE,
    KW_RUST,
    // Control flow (M1, S19, S23, M1/M2)
    KW_IF,
    KW_ELSE,
    KW_LOOP,
    KW_IN,
    KW_BREAK,
    KW_NEXT,
    KW_RETURN,
    KW_YIELD,
    KW_DEFER,
    // Types and declarations (M2, S30, S27, M2, S28, S55, S57)
    KW_STRUCT,
    KW_ENUM,
    KW_IMPL,
    KW_POLICY,
    KW_WRAP,
    KW_TRAIT,
    KW_TAG,
    KW_EFFECT_DECL,
    KW_DERIVE,
    // Compiler facts. The compiler requests `#run`, `#if` and `#loop` are
    // `#` forms, not words, so none is here.
    KW_FACT,
    KW_DISTINCT,
    // Schema migrations
    KW_MIGRATION,
    KW_RENAME,
    KW_ADD,
    KW_REMOVE,
    KW_CHANGE,
    KW_VIA,
    // Ownership / borrow keywords (S10, M2). The retired KW_MUTATE/KW_MOVE
    // (now the `&`/`&&` sigils) and KW_COPY (now the method `x.copy()`) stay
    // lexer-reserved with no grammar rule, so none of them are in the
    // keyword list. The retired `ref[label]` field spelling is gone outright
    // with stored-reference fields (S3) — `ref` is an ordinary identifier.
    KW_SELF,
    // Memory / expert tier (S58)
    KW_UNSAFE,
    KW_IMPURE,
    CTX_BLOCK,
    // One reserved word owns task spawning and fan-out.
    KW_CONC_TASK,
    // Immutable task-crossing snapshot verb.
    KW_FREEZE,
    // Transactions (–): `#Transact(name) { … }`
    KW_TRANSACT,
    // Schedule-as-code (card #505): `#Job fn` — `#Job(every: …)`
    // stays out of this list, matching MARKER_TARGET/MARKER_META (paren-arg
    // config markers aren't bare completion words).
    KW_JOB,
    // Test / tooling (S43, S60)
    KW_TEST,
    KW_TODO,
    // This rule retired `Tainted`/`Sanitizer`; direct declared tags and
    // `#Scrub(Tag)` come from the applied-rule registry.
    // Typestate
    KW_STATE,
    KW_STATE_DECL,
    // Session/protocol types
    KW_PROTOCOL,
    PROTO_CLIENT,
    PROTO_SERVER,
    // In-body struct validation (card #506)
    KW_VALIDATE_BLOCK,
    VALIDATE_CHECK_FN,
    // Reserved literals: boolean (S11), option (S32), synthetic (M4).
    // Result `Ok`/`Err` and Optional `Val` are contextual identifiers, so their
    // canonical LIT_* constants intentionally stay outside this keyword list.
    LIT_TRUE,
    LIT_FALSE,
    LIT_NULL,
    KW_IT,
    // Binding sigils (SIGIL_BIND_IMMUT / SIGIL_BIND_MUT) are not words; omitted.
}

/// (ratified 2026-06-25): the `build { }` block in `pkg.jet`
/// where named build profiles are defined. A profile is a `Build{ optimize: … }`
/// value; blessed names `release`/`debug` carry built-in defaults; all others
/// must be declared here. Active profile is chosen by `--release` (sugar for
/// `--profile=release`) or `--profile=<name>` — never by ambient environment.
MANIFEST_BLOCK_BUILD: "build"

/// The constructor type for a build profile value inside
/// `pkg.jet`'s `build { }` block — written as `Build{ optimize: … }`. Its
/// option fields are the rows of JET_BUILD_OPTIONS (Registry/BuildOptions.jet).
BUILD_CTOR: "Build"

/// Blessed profile names — `release`, `debug`, `ci`, and
/// `hardened` carry built-in defaults and need no explicit declaration in
/// `build { }`.
BUILD_PROFILE_RELEASE: "release"

/// (ratified 2026-07-03): canonical adapter declaration
/// and recipe spellings. These are named module calls, not lexer keywords, so
/// they do not add a grammar token or editor highlight.
PKG_ADAPT: "Pkg.adapt"
ADAPTER_FIELD_NAME: "name"
ADAPTER_FIELD_SOURCE: "source"
ADAPTER_FIELD_DEPS: "deps"
ADAPTER_FIELD_RECIPE: "recipe"
RECIPE_COPY: "Recipe.copy"
RECIPE_PREBUILT: "Recipe.prebuilt"
RECIPE_FIELD_BIN: "bin"
RECIPE_FIELD_AS: "as"
RECIPE_FIELD_AS_NAME: "as_name"
RECIPE_BUILD: "Recipe.build"
RECIPE_FIELD_STEPS: "steps"
RECIPE_STEP_FETCH: ".fetch"
RECIPE_STEP_EXEC: ".exec"
RECIPE_STEP_INSTALL: ".install"
RECIPE_STEP_INSTALL_TREE: ".install_tree"
RECIPE_STEP_FIELD_URL: "url"
RECIPE_STEP_FIELD_SHA256: "sha256"
RECIPE_STEP_FIELD_TOOL: "tool"
RECIPE_STEP_FIELD_ARGS: "args"
RECIPE_STEP_FIELD_SRC: "src"
RECIPE_STEP_FIELD_DEST: "dest"

/// `panic:` values for `Build{ panic: … }`.
BUILD_PANIC_ABORT: "abort"
BUILD_PANIC_UNWIND: "unwind"

/// `optimize:` levels for `Build{ optimize: … }`:
/// `O0` (no optimization, fastest compile), `O1` (lighter optimization)
/// and `O2` (full optimization, maximum throughput).
BUILD_OPTIMIZE_O0: "O0"
BUILD_OPTIMIZE_O1: "O1"
BUILD_OPTIMIZE_O2: "O2"

/// The env var that names the active realized toolchain object directory
/// (#179). Tests set it to a fixture; #179's realizer points
/// it at the hangar object. The object carries prebuilt ring artifacts under
/// `<dir>/ring/<name>`.
TOOLCHAIN_OBJECT_ENV: "JET_TOOLCHAIN_FIXTURE"

/// (#179): re-exec guard marker. Before `jet` execs a
/// version-pinned toolchain, it sets this env var to the pinned version. The
/// child, seeing its own version match the marker, runs natively and never
/// re-realizes or re-execs — this breaks the exec loop and lets the pinned
/// toolchain run the program directly.
TOOLCHAIN_EXEC_MARKER_ENV: "JET_TOOLCHAIN_EXEC"

/// (ratified 2026-07-01): the `effects { allow: […], deny: […] }`
/// block in `pkg.jet` that turns on whole-dependency-graph effect enforcement.
/// Manifest keys only — no language grammar (§0.4 DO-NOT).
MANIFEST_BLOCK_EFFECTS: "effects"

/// The `allow:` field inside `effects { … }` — the closed list of
/// effect names the whole dependency graph may use.
EFFECTS_FIELD_ALLOW: "allow"

/// The `deny:` field inside `effects { … }` — effect names the
/// dependency graph must never use.
EFFECTS_FIELD_DENY: "deny"

/// The `grants { "dep": [Effect] }` block — an audited
/// per-dependency escape from the `authority` budget, recorded in the lockfile.
MANIFEST_BLOCK_GRANTS: "grants"

/// Package floors and memory governance live under the
/// `policy: { … }` block in `package.jet`. Manifest keys only, no language
/// grammar.
MANIFEST_BLOCK_POLICY: "policy"

/// Package-only dependency containment policy. These
/// fields intentionally do not enter the source `PolicyKey` registry.
POLICY_FIELD_CONTAIN: "contain"
POLICY_FIELD_HARDEN: "harden"

/// One package policy namespace for team ceilings. These
/// fields are package-only and therefore never become source policy keys.
POLICY_FIELD_UNSAFE: "unsafe"
POLICY_FIELD_EXPERT: "expert"
POLICY_FIELD_DEPS: "deps"

/// The package claims floor (`.Unchecked` through
/// `.Proved`) is a package-only policy field.
POLICY_FIELD_CLAIMS: "claims"

/// Package license allow-list policy.
POLICY_FIELD_LICENSES: "licenses"

/// Package-pattern to source-authority mapping.
POLICY_FIELD_SOURCES: "sources"

/// Reviewed, expiring package policy exceptions.
POLICY_FIELD_EXCEPTIONS: "exceptions"

/// Typed exception record in `policy.exceptions`.
POLICY_EXCEPTION_TYPE: "PolicyException"
POLICY_EXCEPTION_FIELD_ID: "id"
POLICY_EXCEPTION_FIELD_SCOPE: "scope"
POLICY_EXCEPTION_FIELD_REASON: "reason"
POLICY_EXCEPTION_FIELD_EXPIRES: "expires"

/// Source-reviewed trust and
/// provider authority live under the one `authority: { … }` block.
MANIFEST_BLOCK_AUTHORITY: "authority"

/// The package's own bound sits directly in the block: `allow`, `deny`.
AUTHORITY_FIELD_ALLOW: "allow"
AUTHORITY_FIELD_DENY: "deny"
AUTHORITY_FIELD_GRANTS: "grants"

/// A guest package declares the capabilities it may
/// request; hosts provide the tightened authority separately.
AUTHORITY_FIELD_NEEDS: "needs"
AUTHORITY_FIELD_TRUST: "trust"
AUTHORITY_FIELD_PROVIDERS: "providers"
PROVIDER_FIELD_REGISTRY: "registry"
PROVIDER_FIELD_ALLOW: "allow"
PROVIDER_FIELD_DENY: "deny"
AUTHORITY_TRUST_FIELD_DEFAULT: "default"
AUTHORITY_TRUST_FIELD_CI: "ci"
AUTHORITY_TRUST_FIELD_PROMPT: "prompt"
AUTHORITY_TRUST_FIELD_SERVICES: "services"
AUTHORITY_TRUST_FIELD_REQUIRE: "require"
AUTHORITY_TRUST_REQUIRE_NONE: "none"
AUTHORITY_TRUST_REQUIRE_LOGGED: "logged"
AUTHORITY_TRUST_REQUIRE_ATTESTED: "attested"
AUTHORITY_TRUST_DECISION_PROMPT: "prompt"
AUTHORITY_TRUST_DECISION_DENY: "deny"
AUTHORITY_TRUST_DECISION_ALLOW: "allow"

/// (the override law, card #505): the `policy: { lints: { … } }`
/// sub-block. Warnings never fail a build by default (I1 memory/type safety is
/// never in scope here); a team opts into a wall by naming stable lints here.
/// Manifest keys only, no language grammar.
POLICY_FIELD_LINTS: "lints"

/// Every compiler-visible generated symbol uses one reserved
/// machine prefix. Keep this helper below the syntax surface so sema, engines,
/// tools, and generated Rust share one naming law.
GENERATED_NAME_PREFIX: "__jet_"

// Concurrency surface — thirteen ratified -* outcomes on card #1505.
// Rows for forms that implementation cards will make parseable belong here
// now; parser and sema support land on those cards.
// This rule change compiler facts only.
// keeps #Transact keeps Job/Every/Duration, and
// This rule keeps yield/Stream. Is retired by
// TaskOutcome, TaskStatus, trace, and exception have no rows.
/// The one reserved word for structured task spawning.
KW_CONC_TASK: "task"

/// (ratified 2026-08-12, card #1889): prefix verb that
/// creates a deeply immutable owned snapshot for a task crossing.
KW_FREEZE: "freeze"
