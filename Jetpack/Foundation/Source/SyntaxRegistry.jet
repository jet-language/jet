SECRET_META_FIELD_GENERATE: "generate"
SECRET_NONE: "none"
SECRET_ROTATION_MAX_AGE: "max_age"
SECRET_GENERATOR_RANDOM: "random"
SECRET_GENERATOR_FIELD_LENGTH: "length"

/// U19: `jetpack config <verb>` — today only `trust` pattern management.
CONFIG_SUBCOMMAND: "config"
CONFIG_VERB_TRUST: "trust"

/// U28 sandbox fallback policy lives under `jetpack config
/// sandbox`; `require` hard-fails when unprivileged sandboxing is unavailable,
