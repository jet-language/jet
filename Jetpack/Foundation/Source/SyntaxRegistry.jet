SECRET_COMPOSE: "compose"
SECRET_COMPOSE_FIELD_TEMPLATE: "template"
SECRET_COMPOSE_FIELD_FROM: "from"
SECRET_META_FIELD_DESCRIPTION: "description"
SECRET_META_FIELD_REQUIRED: "required"
