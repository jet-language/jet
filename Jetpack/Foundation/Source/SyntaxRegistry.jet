PROFILE_SUBCOMMAND: "profile"
PROFILE_VERB_PLAN: "plan"
PROFILE_VERB_BUILD: "build"
PROFILE_VERB_SWITCH: "switch"
PROFILE_VERB_ROLLBACK: "rollback"
PROFILE_VERB_GENERATIONS: "generations"
PROFILE_VERBS: [String]{
    PROFILE_VERB_PLAN,
    PROFILE_VERB_BUILD,
    PROFILE_VERB_SWITCH,
    PROFILE_VERB_ROLLBACK,
    PROFILE_VERB_GENERATIONS,
}

