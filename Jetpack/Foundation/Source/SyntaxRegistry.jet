// This file is generated by Tools/agent/JetpackSyntax.jet from Compiler/JetFoundation/Data/Syntax; do not edit.
// Each constant is the registry's, with its comments; the tool keeps
// exactly those the Jetpack unit's sources name or packages import.

/// Package authority names for the typed UI host boundary. These are policy
/// facts, not a second effect vocabulary; host rows refer to this one list.
UI_CAPABILITY_NAMES: [String]{
    "UI.FileDialog",
    "UI.Clipboard",
    "UI.IME",
    "UI.DragDrop",
    "UI.Shortcuts",
    "UI.Accessibility",
}

/// N1 (ratified): language name.
LANG_NAME: "Jet"

/// N1 (ratified): compiler binary name.
BINARY_NAME: "jet"

/// N2 (ratified): source file extension (without the dot).
FILE_EXT: "jet"

/// S1 (ratified): keyword that starts a function definition.
KW_FN: "fn"

/// `pub use` re-export is the only remaining `pub` form (re-export
/// ballot pending, card #4723). No rule accepts `pub` on a declaration or
/// field.
KW_PUB: "pub"

/// (owner directive 2026-10-07, card #4723): everything is public by
/// default. `priv` marks a module (`priv name: module`, usable only by its
/// enclosing module) or a struct field (usable only by the type's own module).
KW_PRIV: "priv"

/// The `$` of a config-surface `$NAME` environment read. Program source has
/// no `$` words: the site values are `#package`, `#here` and `#caller`, a
/// program reads a compiler fact through its subject (`T.reflect().layout`,
/// `f.reflect().effects`, `value.reflect().origin`), the other subjectless
/// facts are the compiler values `#build`, `#phase` and `#program`, and a
/// derive or marker template pastes a binding as `#{name}` (`#{method}: fn`,
/// `self.#{field}`, `.#{left}`).
COMPTIME_MARK: "$"

/// S5 (ratified): line comments run from this prefix to end of line.
COMMENT_PREFIX: "//"

/// S5 (ratified 2026-06-15): block comments `/* … */`, nesting allowed so a
/// region containing other comments can always be commented out.
BLOCK_COMMENT_OPEN: "/*"
BLOCK_COMMENT_CLOSE: "*/"
TYPE_STRING: "String"

/// S80 (ratified; amended by): default error type and
/// constructor share `Err`.
TYPE_ERR: "Err"

/// M2: struct definition keyword (construction spelling: S29).
KW_STRUCT: "struct"

/// S30 (ratified M3): sum-type definition keyword.
KW_ENUM: "enum"
LIT_NULL: "None"

/// S27 (ratified M3): method receiver name.
KW_SELF: "self"

/// S27 (ratified M3): external method block — `impl Type { ... }`.
KW_IMPL: "impl"

/// (ratified 2026-08-19): user-declared policy settings use
/// `policy name(...) { wrap(call) { ... } }`, public like every declaration.
KW_POLICY: "policy"

/// The checked body that wraps the declared callable.
KW_WRAP: "wrap"

/// M1/M2: return from a function. Foundational keyword predating the
/// S-numbered decision log (card #447 KW_DECISION_ID_EXEMPT).
KW_RETURN: "return"

/// (ratified): `defer statement` or `defer { block }` runs its body when the
/// enclosing block ends, on every exit, the latest defer first; the body can't
/// leave its block (E0509) or pass a failure on (E0512). `defer
/// close(resource)` stays the one closing form. `defer` is contextual so
/// ordinary identifiers keep their existing meaning outside statement-head
/// position.
KW_DEFER: "defer"

/// S19 (ratified): loop statement (for SharedHandle lint checks) — same
/// governing decision as the loop-header keywords.
KW_LOOP: "loop"

/// (ratified): `yield expr` — hand a value to a `Stream<T>`
/// consumer and suspend until the next pull. Legal only in a function whose
/// return type is `Stream<T>`.
KW_YIELD: "yield"

/// (ratified 2026-06-22, opt B; prev S58 2026-06-12) and
/// The audited
/// expert gate. Block form: `#Unsafe("reason") { … }`. Whole-function form:
/// `#Unsafe("reason") fn`. Bare `#Unsafe { … }` / `#Unsafe fn` are E3112.
/// The reason is the argument of `#Unsafe` itself. The lowercase word
/// `unsafe` (FOREIGN_UNSAFE) is not Jet syntax.
KW_UNSAFE: "Unsafe"

/// (ratified 2026-06-25): `#Impure("reason") { … }` — the audited
/// Tier-2 comptime effect gate. Both this block AND `--gate impure=allow` at build
/// are required to execute ambient comptime I/O (FS/Env/Exec/IO). PascalCase
/// per (consistent with `Unsafe`).
KW_IMPURE: "Impure"

/// (ratified 2026-06-22, G2): smart-context block marker.
/// `#Context(field: value) { … }` swaps named ambient fields (allocator,
/// logger) for the lexical+dynamic extent of the block, then restores them.
/// The marker is PascalCase the field names inside are lower.
/// Expert-tier only (R1): never emitted in beginner-tier diagnostics or docs.
CTX_BLOCK: "Context"

/// Typed build-program values.
/// These names are compiler-known only while the selected root `build: fn`
/// runs; build entry is removed before runtime codegen.
TYPE_BUILD_CONTEXT: "Build"

/// (ratified 2026-06-17, E2-M11; PascalCase marker follow-on
/// 2026-06-21): typed goal `#Todo` — compiles everywhere, panics at runtime with
/// file, line, and expected type. Bare lowercase `todo` (FOREIGN_TODO) is the
/// retired spelling; no rule accepts it.
KW_TODO: "Todo"

/// The effect-declaration word. An effect is a type: a struct, or an enum
/// whose cases are a closed family, with an `impl Effect { … }` block; a
/// package effect that is a kind of another names it with `parent:`. The word
/// itself declares nothing: a `Root.Leaf: effect` line is refused (E0003)
/// with that type declaration as its fix.
KW_EFFECT_DECL: "effect"

/// The retired typestate fn marker. State types carry its facts: a parameter
/// typed `Reservation.Confirmed` requires that state (calling with a value in
/// any other state is E0150), and `confirm: fn(self: &&Reservation.Pending)
/// -> Reservation.Confirmed` consumes a `Pending` value and yields a
/// `Confirmed` one along the state list's `Pending -> Confirmed`. A
/// constructor's result type names the start state. `#State(S)` and
/// `#State(A -> B)` still parse so that each one is reported (E0175) with the
/// edit that writes those types; any other argument shape is E0930.
/// `#Transition` is retired (E0927).
KW_STATE: "State"

/// (amends): the typestate **state list** contextual keyword —
/// `TypeName: struct { state { Pending -> Confirmed … } }`, one state per line
/// with its moves. The
/// bounded set is owned by the named struct or enum, erases at runtime, and
/// its arrows are the moves its methods may make (E0174). A state named in a
/// state type or an arrow that is not in the set is E0151. Contextual:
/// `state` stays an ordinary identifier outside a struct or enum body.
KW_STATE_DECL: "state"

/// Amended by the session/protocol
/// declaration contextual keyword — `protocol Name { client: Msg(…) }`.
/// Declares an ordered request/response exchange once; sema expands it into
/// `#SingleUse` `.Client`/`.Server` handle types with typestate-checked send/recv
/// methods (out-of-order use = E0150). Contextual like `state`/`migration`.
KW_PROTOCOL: "protocol"

/// Endpoint labels in a protocol message line.
PROTO_CLIENT: "client"
PROTO_SERVER: "server"

/// The retired fact-declaration word. A compiler fact plane is a field-less
/// struct with an `impl Fact { … }` block; no rule accepts `fact Name(…)`.
/// The registry reads the planes from `Prelude/Facts.jet`.
KW_FACT: "fact"

/// (ratified 2026-06-24): the transaction-block marker, written
/// `#Transact(order) { … }`. `order` binds a user-chosen transaction handle
/// (any lowercase ident, mirroring `region r { … }`). Inside the block an
/// irreversible effect (`Net`, `FS.Write`, `Exec`, `FFI`) is rejected (E0746); the fix is to
/// move it after the block or register it on the handle via
/// `order.on_commit(() -> { … })` which runs Drop-backed on a clean
/// commit. PascalCase per. Erased in codegen (I3).
KW_TRANSACT: "Transact"

/// M4: synthetic name for a `switch` subject that isn't a plain identifier.
/// Foundational keyword predating the S-numbered decision log (card #447
/// KW_DECISION_ID_EXEMPT).
KW_IT: "it"

/// S52 (ratified M12): package source root directory inside a project.
SOURCE_ROOT_DIR: ".jet"

/// S59 (ratified): the native-C-library dependency name, written in
/// `name@source` order inside the `deps: { … }` block —
/// `lib: c@system` (pkg-config, with a bare `-l <lib>` fallback) or
/// `lib: c@"vendor/path"` (local dir: `-L`/`-I`/`-l`). Replaces the retired
/// TOML `[dependencies:c]` table. A C dep is a link dep, not a Jet package: it
/// is never realized as source or written to the package lock.
DEP_PROVIDER_C: "c"

/// S59 (ratified): the `c@<target>` system-library target —
/// `lib: c@system` resolves via `pkg-config <lib>`, falling back to a bare
/// `-l <lib>` when there is no `.pc` (e.g. libc). Any other target is a local
/// directory path.
SYSTEM_LIB_TARGET: "system"

/// 9: the Jetpack package-manager binary name.
JETPACK_BINARY_NAME: "jetpack"

/// 15: the `<source>:<package/path>` ref separator. Jetpack translates
/// the canonical channel syntax to the provider's form.
REF_SEPARATOR: ":"

/// (owner, 2026-08-24), amended by
/// Channel policy markers follow `@source`. `#latest` is
/// the manual moving tier; `#auto` opts a source into automatic movement. A
/// source with no marker is pinned.
REF_CHANNEL_MARKER: "#"
REF_CHANNEL_LATEST: "latest"
REF_CHANNEL_MAIN: "main"
REF_CHANNEL_AUTO: "auto"

/// Jetpack is the canonical package source. `nixpkgs`
/// remains an internal migration alias until its public retirement diagnostic
/// lands; both names resolve through the same locked package identity.
REF_SOURCE_JETPACK: "jetpack"

/// 15: legacy nixpkgs source token, retained for migration/provenance.
REF_SOURCE_NIXPKGS: "nixpkgs"
REF_SOURCE_GITHUB: "github"
REF_SOURCE_PATH: "path"

/// Direct CRAN ecosystem root.
REF_SOURCE_CRAN: "cran"

/// Direct LuaRocks ecosystem root.
REF_SOURCE_LUAROCKS: "luarocks"

/// Direct RubyGems ecosystem root.
REF_SOURCE_RUBY: "ruby"

/// Direct CPAN ecosystem root.
REF_SOURCE_PERL: "perl"

/// Direct Packagist ecosystem root.
REF_SOURCE_PHP: "php"

/// The first-party Jet registry root.
REF_SOURCE_JET_REGISTRY: "jet-registry"

/// Direct npm ecosystem root.
REF_SOURCE_NPM: "npm"

/// Direct Cargo ecosystem root.
REF_SOURCE_CARGO: "cargo"

/// Direct PyPI ecosystem root.
REF_SOURCE_PYPI: "pypi"

/// Direct SwiftPM ecosystem root.
REF_SOURCE_SWIFTPM: "swiftpm"

/// Card #2166: the native release-artifact source.
REF_SOURCE_RELEASES: "releases"

/// 9: the Phase 1 verb set.
/// Card #2216: answer one package's environment, provenance, trust, size, and
/// dependent questions without dumping the full dependency graph.
JETPACK_WHY: "why"

/// Import a foreign environment into canonical Jet source.
JETPACK_IMPORT_VERB: "import"

/// Card #2218: read-only changelog view over the unified `.jet/lock`.
JETPACK_LOCK_VERB: "lock"
LOCK_DIFF_VERB: "diff"
LOCK_DIFF_FLAG_AGAINST: "--against"

/// `jet split env|package <name>|hosts <name>` and its reverse `jet fold
/// <file>`: reversible package source transitions; `--check` previews.
TRANSITION_SPLIT_VERB: "split"
TRANSITION_FOLD_VERB: "fold"
TRANSITION_FLAG_CHECK: "--check"

/// Every Jetpack verb, in dispatch order. JetOS's `os` verb (OS_SUBCOMMAND)
/// routes through its own dispatcher and is not listed.
JETPACK_VERBS: [String]{
    // `doctor` reports Jetpack's health.
    "doctor",
    "env",
    "use",
    "hangar",
    "audit",
    "add",
    "remove",
    "update",
