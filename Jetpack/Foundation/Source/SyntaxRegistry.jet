/// U16 (card c9jetpackgates): `jetpack env -p <pkg>...` — ad-hoc nixpkgs packages
/// added to the shell without declaring them in any manifest. Repeatable;
/// realized once and dropped, same lifecycle as a manifest-declared ref.
///
/// On `jet test` / `jet run`, the same `-p`
/// spelling selects workspace members by exact name (cargo-style, repeatable).
ENV_FLAG_PACKAGE: "-p"

/// Materialize an environment or ad-hoc package shell
/// without entering it.
ENV_FLAG_PREP: "--prep"

/// Card #2214: expand environment acquisition plans to per-package facts.
ENV_FLAG_EXPLAIN: "--explain"

/// U16: force foreign-flake/devenv detection even when the project's own
/// manifest already declares `env.*` modules (which otherwise wins).
ENV_FLAG_FLAKE: "--flake"

/// U16: enter an isolated shell with no host environment leaking in —
/// threaded straight through to the underlying `nix` invocation.
ENV_FLAG_PURE: "--pure"

/// U27 preserve failed build scratch and open a shell in
/// the failing build environment.
BUILD_FLAG_SHELL_ON_FAIL: "--shell-on-fail"

/// U16: `jetpack bridge <verb>` — best-effort translators from a foreign
/// ecosystem descriptor into jetpack's own manifest form.
BRIDGE_SUBCOMMAND: "bridge"
BRIDGE_VERB_FLAKE: "flake"

/// U16: foreign dev-shell descriptor filenames `jet env`/`jet os bridge flake`
/// look for. `jet env` only auto-detects one of these when the project's own
/// manifest declares no `env.*` module; `--flake` forces it either way.
FOREIGN_FLAKE_FILE: "flake.nix"
FOREIGN_DEVENV_FILE: "devenv.nix"

/// Legacy Nix shell expressions accepted by `jetpack import`.
FOREIGN_SHELL_FILE: "shell.nix"
FOREIGN_DEFAULT_FILE: "default.nix"

/// (ratified 2026-07-12): direnv-style opt-in env auto-activation.
/// `jet env hook <shell>` prints a one-line shell hook the user installs once;
/// after that, entering a directory whose tree carries an `env.jet` activates
/// that env (its first activation of an untrusted env prompts through the
/// This rule trust law), and leaving it deactivates. The hook is opt-in:
/// nothing runs on `cd` until the user adds it. These are engine subverbs of
/// `jet env`, so they route through `jetpack env` exactly
/// like the bare `jet env` shell-entry does.
ENV_HOOK_VERB: "hook"

/// The hook's private per-prompt callback — realizes the nearest
/// `env.jet` and prints the shell statements the installed hook `eval`s to
/// activate/deactivate. Users never type this themselves; the installed hook
/// calls it (direnv's `direnv export` shape).
ENV_EXPORT_VERB: "export"

/// Inspect the composed environment and run its declared
/// checks in a clean process environment.
ENV_TEST_VERB: "test"

/// Plan and apply the managed-file graph for the active env.
ENV_SYNC_VERB: "sync"

/// Disclose the selected preset and typed environment facts.
ENV_INFO_VERB: "info"

/// (ratified 2026-08-17, card #1448): the two headings the
/// `jet env info` entry list splits into. The project's own `#Job` functions
/// print under `jobs`, so this surface uses the same word as the rest of the
/// job surface; entries the environment model supplies through its lifecycle
/// hooks print under `checks`. Splitting them is the load-bearing half — a
/// reader can tell an entry they wrote from an entry the environment supplied
/// (option A, renaming the merged list, was rejected for keeping two kinds of
/// thing under one heading).
///
/// I8: one spelling each. Both the human heading and the machine key read
/// these constants, so the two renderings cannot desynchronise. This is the
/// env report's list only — it is unrelated to `KW_CONC_TASK`, the `task`
/// concurrency keyword and to the per-integration `tasks`
/// disclosure field of the typed integration projection.
ENV_REPORT_JOBS_KEY: "jobs"

/// See `ENV_REPORT_JOBS_KEY`.
ENV_REPORT_CHECKS_KEY: "checks"

/// The escape hatch — set to any non-empty value to suppress
/// auto-activation (and drop any active env) in the current shell.
/// Documented in Docs/spec/reference/environment.md.
ENV_DISABLE_VAR: "JET_ENV_DISABLE"

/// The hook's activation state, exported into the shell so each
/// per-prompt `export` knows which `env.jet` directory is currently live (empty
/// = none). A change from it to the nearest `env.jet` root is what triggers a
/// load / unload.
ENV_HOOK_ACTIVE_DIR_VAR: "JETPACK_ENV_DIR"

/// The pre-activation `PATH` saved on load, restored verbatim on
/// unload so leaving a project returns the shell to exactly its prior `PATH`.
ENV_HOOK_OLD_PATH_VAR: "JETPACK_ENV_OLD_PATH"

/// The shells `jet env hook` can emit an auto-activation hook for.
ENV_HOOK_SHELLS: [String]{"bash", "zsh", "fish"}

/// U12 (card c9jetpackgates): `jetpack services <verb>` supervises the
/// project's dev `services:` processes under `.jet/services/<name>/` —
/// `up`/`down` start/stop the enabled set (or one named service), `health`
/// one-shot probes readiness, `logs` prints a service's captured
/// stdout/stderr. Distinct from the jetos `system.*.services` tier (Phase D,
/// untouched): this dev tier runs plain child processes via `std::process`,
/// never a system service manager.
SERVICES_SUBCOMMAND: "services"

/// (=A, ratified 2026-07-01, c9jetpackgates): `jet image <name>`
/// builds the named `image.<name>` module contribution into a hangar OCI
/// layout (the `.Oci` kind only — `.Iso` rides the jetos installer tier,
/// Phase D, owner-gated, untouched). `--push <ref>` is honestly gated (E1268)
/// until TLS support lands for registry pushes.
IMAGE_SUBCOMMAND: "image"
IMAGE_FLAG_PUSH: "--push"

/// The `jetpack tool` noun keeps persistent global PATH
/// management; ephemeral package execution is the `jetpack use` verb.
TOOL_SUBCOMMAND: "tool"
TOOL_VERB_INSTALL: "install"
TOOL_VERB_LIST: "list"
TOOL_VERB_UNINSTALL: "uninstall"
TOOL_VERBS: [String]{TOOL_VERB_INSTALL, TOOL_VERB_LIST, TOOL_VERB_UNINSTALL}

/// Install under a different on-PATH bin name (avoids JPK-TOOL-COLLIDE / E1297).
TOOL_FLAG_AS: "--as"

/// Default profile name for `jetpack tool install` PATH projections.
TOOL_PROFILE_NAME: "tools"

/// On-PATH projection directory under `~/.jet/` (`bin/`).
TOOL_BIN_DIR: "bin"

/// Generation + metadata root under `~/.jet/` (`tools/`).
TOOL_STATE_DIR: "tools"

/// External tool-provider prefixes recognized but not yet realizable as
/// hangar providers — emit E1298 instead of silently skipping.
TOOL_EXTERNAL_PROVIDERS: [String]{"npm", "pypi", "cargo", "crates", "brew", "go", "gem"}

/// Diagnostic class JPK-TOOL-COLLIDE (E1297): install bin shadows a `#Job fn`.
TOOL_DIAG_COLLIDE: "E1297"

/// Diagnostic class JPK-TOOL-PROVIDER (E1298): external provider not available.
TOOL_DIAG_PROVIDER: "E1298"

/// One source-backed package generation engine. Planning,
/// publication, switching, rollback, and history all address the same
