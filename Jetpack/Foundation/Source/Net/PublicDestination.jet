// crates/jet-net/src/lib.rs:674-737: the outbound public-destination policy.
// Core owns the address tables (ip.is_public_destination and
// ip.ipv6_is_public_destination) and the ordered resolver (net.socket_addrs).
use core.net as net
use core.net.ip as ip

// Rust addresses_are_public: an empty set is not public, and every answer must
// pass. A mixed public/private set is refused, never filtered into an allowed set.
fn foundation_addresses_are_public(addresses: [SocketAddr]) -> Bool Never! {
    if addresses.len() == 0 -> return false
    loop address in addresses {
        if !foundation_address_is_public(address) -> return false
    }
    true
}

// Core spells an IPv4-mapped IPv6 address `::ffff:a.b.c.d`; it takes the IPv4 rule.
fn foundation_address_is_public(address: SocketAddr) -> Bool Never! {
    host :: net.socket_host(address)
    if !host.contains(":") {
        v4 :: ip.parse_ipv4(host) ?? return false
        return ip.is_public_destination(v4)
    }
    if host.contains(".") {
        mapped :: ip.parse_ipv4(host.removeprefix("::ffff:")) ?? return false
        return ip.is_public_destination(mapped)
    }
    v6 :: ip.parse_ipv6(host) ?? return false
    ip.ipv6_is_public_destination(v6)
}

// Rust resolve_public_addresses: strip paired outer brackets, resolve every
// answer in the platform resolver's order, and return that same set only when
// all of it is public.
fn foundation_resolve_public_addresses(host: String, port: Int) -[Net, Time.Wait]> [SocketAddr] FoundationFetchError! {
    name := host
    if host.starts_with("[") && host.ends_with("]") -> name = host.removeprefix("[").removesuffix("]")
    if net.socket_addrs(name, port) == {
        .Ok(addresses) -> {
            if !foundation_addresses_are_public(addresses) -> return Err(FoundationFetchError.IO("provider destination resolves to a non-public address"))
            Ok(addresses)
        }
        .Err(error) -> Err(FoundationFetchError.IO("could not resolve provider destination: {error}"))
    }
}
