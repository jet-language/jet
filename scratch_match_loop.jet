enum D { A([D]) B(Int) }
fn eq(left: D, right: D) -> Bool {
    if left == {
        .A(xs) -> {
            if right == {
                .A(ys) -> {
                    if xs.len() != ys.len() -> return false
                    loop i in 0..<xs.len() {
                        if !eq(xs[i], ys[i]) -> return false
                    }
                    return true
                }
                else -> return false
            }
        }
        else -> return false
    }
    false
}
