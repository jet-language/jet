/target
/target-*
/result
/.tmp
/.tmp-*
__pycache__/
/__snapshots__/
/build_wait.log
scratchpad_difftest.sh
plugins/tower/.tower/server.log

# Compiler output: `jet build/run/test` emits a build/ folder next to the
# working directory, so ignore it at any depth (e.g. examples/build/).
build/

# c121: timing reports (only written under JET_TIMING=1).
jet-timing.json
jet-lsp-timing.json
.claude/worktrees/
.claude/recovery/
.agent-worktrees/

# Native C-dep link cache: per-machine `/nix/store` paths resolved by `c@…`
# auto-provision. Machine-specific and self-healing (stale paths re-realize),
# so never commit it.
**/.jet/clinks/

# Polyglot binder output (`jet inspect bind`). The generated `*.jet` binding
# source is deterministic, so it stays tracked and the example checks without
# the foreign toolchain installed. Native archives, class files, worker
# scripts, provenance, and resolved host paths are machine-specific.
**/.jet/bindings/*/*
!**/.jet/bindings/*/*.jet

# `b.generate` output (D-BUILDGEN1=A: "generated source lands under
# `.jet/generated/`, never committed"). The build materializes it on every run
# and locks its digest over the formatter's exact bytes, so a committed copy
# goes stale the moment the renderer changes and then shadows itself (E3510).
# The two example locks below go with it: their only content is that digest.
# (`examples/features/comptime/.jet/lock` stays tracked — it is a `[build.stamp]`
# fixture, not build output.)
**/.jet/generated/
examples/features/tooling/.jet/lock
examples/features/tooling/programmable_build/.jet/lock
# Exception: this fixture needs a real hand-written module *at* the generated
# path — it is E3510's input, not build output (see its `use` of the path).
!tests/ui/build_generated_collision/.jet/generated/

# Generated Zed grammar build artifact (editors/zed/install.sh output)
editors/zed/grammar-repo/
