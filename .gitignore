# --- Build output ----------------------------------------------------------
/target
/target-*
/result
__pycache__/

# Stray `jet build` output beside sources. Source directories that happen to
# be named `build` stay visible.
build/
!/Core/build/
!/crates/jet-foundation/build/
!/tests/conformance/corpus/core/build/

# `jet build/run/test` emits its canonical tree under `.jet/build/`.
**/.jet/build/
# Per-run last-run pointers (`.jet/last-run/<program digest>`, project_state.rs)
# are workspace run state, not sources or fixtures.
**/.jet/last-run/

# Timing reports, written only under JET_TIMING=1.
jet-timing.json
jet-lsp-timing.json

# --- Machine-local Jet state -----------------------------------------------
# Native C-dependency link cache: per-machine `/nix/store` paths.
**/.jet/clinks/
# Discovery index and lock, ICE bug-report bundles, and the peer launcher
# built from Tools/ci/compiled-workload-peer-launcher.rs.
**/.jet/discovery/
**/.jet/ice-report/
**/.jet/.locks/
**/.jet/rustc
**/.jet/rustc-args
/.jet/compiled-workload-peer-launcher
# Production receipts carry this machine's toolchain and hardware identity.
**/.jet/receipts/
**/.jet/reports/
# The record index is per-machine cache rebuilt by ordinary check/test runs
# (#3731). Saved claims under `.jet/records/saved/` stay tracked.
**/.jet/records/index.jsonl
**/.jet/records/.index.jsonl.*
**/.jet/records/.index.lock

# Polyglot binder output (`jet inspect bind`). The generated `*.jet` binding
# source is deterministic and stays tracked; native archives, class files,
# worker scripts, and resolved host paths are machine-specific.
**/.jet/bindings/*/*
!**/.jet/bindings/*/*.jet

# `b.generate` output (D-BUILDGEN1=A) is materialized on every build and never
# committed. The two example locks below only hold that output's digest.
# (`Examples/features/comptime/.jet/lock` stays tracked: it is a fixture.)
**/.jet/generated/
Examples/features/tooling/.jet/lock
Examples/features/tooling/programmable_build/.jet/lock
# Exception: E3510's input is a hand-written module at the generated path.
!tests/ui/build_generated_collision/.jet/generated/

# --- Tools -------------------------------------------------------------------
Tools/editors/zed/grammar-repo/
Tools/tower/.tower/server.log
Tools/tower/.tower/.tower.json.tmp-*
Tools/tower/.tower/*.pre-restore

# --- Agent and debugging scratch ---------------------------------------------
# Scratch belongs in ~/.cache, never in the repository.
/.tmp
/.tmp-*
/__snapshots__/
/build_wait.log
/jit-aot-parity-report/
/scratch-*
/.codex-*
/.card*.jet
/~/
scratchpad_difftest.sh
rustc-args
rustc-stderr
.claude/*.log
.claude/**/*.log
.claude/worktrees/
.claude/recovery/
.agent-worktrees/
.agent-scratch-*/
