# --- Build output ----------------------------------------------------------
/target
/target-*
/result
__pycache__/

# Stray `jet build` output beside sources. Source directories that happen to
# be named `build` stay visible.
build/
!/Core/Build/
!/crates/jet-foundation/build/
!/tests/conformance/corpus/core/build/

# The repository root's `.jet/` is run state of jets started at the root
# (evidence, stamps, the job queue, traces, proofs, secrets audit); nothing
# reads a committed copy.
/.jet/

# `jet build/run/test` emits its canonical tree under `.jet/build/`.
**/.jet/build/
# A build's workspace stamps (absolute source paths) and the sandbox folders
# its steps run in are per machine.
**/.jet/stamps
**/.jet/build-sandbox/
# Per-run last-run pointers (`.jet/last-run/<program digest>`, project_state.rs)
# are workspace run state, not sources or fixtures.
**/.jet/last-run/

# Timing reports, written only under JET_TIMING=1.
jet-timing.json
jet-lsp-timing.json

# --- Machine-local Jet state -----------------------------------------------
# Native C-dependency link cache: per-machine `/nix/store` paths.
**/.jet/clinks/
# Discovery index and lock, and ICE bug-report bundles.
**/.jet/discovery/
**/.jet/ice-report/
**/.jet/.locks/
**/.jet/rustc
**/.jet/rustc-args
# Production receipts carry this machine's toolchain and hardware identity.
**/.jet/receipts/
**/.jet/reports/
# The record index is per-machine cache rebuilt by ordinary check/test runs
# (#3731). Saved claims under `.jet/records/saved/` stay tracked.
**/.jet/records/index.jsonl
**/.jet/records/.index.jsonl.*
**/.jet/records/.index.lock
# `jet test` history (`.jet/evidence/<report id>.json`, one per run) is
# per machine.
**/.jet/evidence/
# `jet test --profile <p>` baselines (`.jet/test/<p>/*.rows`) hold the rows of
# this checkout's last recorded run, so they are per machine too.
**/.jet/test/
# Per-run `jet test` result files (`.jet/test-results/<run digest>`) name this
# checkout's absolute paths.
**/.jet/test-results/
# The symbol store (`.jet/symbols/.build-id/`) holds the side debug files of
# split links, rebuilt with the `.jet/build/` output beside it.
**/.jet/symbols/

# Polyglot binder output (`jet inspect bind`). The generated `*.jet` binding
# source is deterministic and stays tracked, and so are a C binding's `.hash`
# and `.metadata` sidecars; native archives, class files, worker scripts, and
# resolved host paths (a `.provenance` record) are machine-specific.
**/.jet/bindings/*/*
!**/.jet/bindings/*/*.jet
!**/.jet/bindings/c/*.hash
!**/.jet/bindings/c/*.metadata
# A foreign-reflection ui fixture's boundary record is hand-written evidence,
# not a host scan, so it stays tracked.
!tests/ui/foreign_meta_*/.jet/bindings/c/*.provenance

# `b.generate` output (D-BUILDGEN1=A) is materialized on every build and never
# committed, and an example's `.jet/lock` only holds that output's digest. Two
# example locks are tracked fixtures, and the backend starter ships the locks
# that pin its service's and client's dependencies.
**/.jet/generated/
Examples/**/.jet/lock
!Examples/Metaprogramming/Comptime/.jet/lock
!Examples/Tooling/DevLoop/StaticSiteGenerator/.jet/lock
!Examples/Network/BackendStarter/Packages/Service/.jet/lock
!Examples/Network/BackendStarter/Packages/Client/.jet/lock
# Exception: E3510's input is a hand-written module at the generated path.
!tests/ui/build_generated_collision/.jet/generated/

# --- Tools -------------------------------------------------------------------
Tools/editors/zed/grammar-repo/
Tools/tower/.tower/server.log
Tools/tower/.tower/.tower.json.tmp-*
Tools/tower/.tower/history/.*.tmp-*
Tools/tower/.tower/*.pre-restore

# --- Agent and debugging scratch ---------------------------------------------
# Scratch belongs in ~/.cache, never in the repository.
/.tmp
/.tmp-*
/__snapshots__/
/build_wait.log
/scratch-*
/.codex-*
/.card*.jet
/~/
scratchpad_difftest.sh
rustc-args
rustc-stderr
.claude/*.log
.claude/**/*.log
.claude/worktrees/
.claude/recovery/
.agent-worktrees/
.agent-scratch-*/

# Generated by Docs/site/generate.jet and the static_site_generator example
/dist/
