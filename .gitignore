# Compiler output: `jet build/run/test` emits a build/ folder next to the
# working directory, so ignore it at any depth (e.g. examples/build/).
build/

# c121: timing reports (only written under JET_TIMING=1).
jet-timing.json
jet-lsp-timing.json
.claude/worktrees/
.agent-worktrees/

# Native C-dep link cache: per-machine `/nix/store` paths resolved by `c@…`
# auto-provision. Machine-specific and self-healing (stale paths re-realize),
# so never commit it.
**/.jet/clinks/

# Generated Zed grammar build artifact (editors/zed/install.sh output)
editors/zed/grammar-repo/
