use core.collections.[counter_from, add, inc, dec, get, set_count, total, names, elements, most_common, subtract, merge_add, clear_counter, deque_from, deque_len, deque_is_empty, append, appendleft, pop, popleft, peek, peekleft, extend, extendleft, rotate, deque_items, ordered_map, map_get, map_set, map_remove, map_keys, map_values, map_contains, map_len, chain, chain_push, chain_get, chain_contains]

fn run() {
    c := counter_from([String]{"a", "b", "a"})
    c = add(c, "c", 2)
    c = inc(c, "b")
    c = dec(c, "a")
    c = set_count(c, "c", 3)
    print(names(c))
    print(elements(c))
    print(get(c, "a"))
    print(total(c))
    mc :: most_common(c, 2)
    print(names(mc))
    sub :: subtract(c, counter_from([String]{"a", "c"}))
    print(elements(sub))
    merged :: merge_add(c, counter_from([String]{"a"}))
    print(elements(merged))
    print(names(clear_counter(c)))

    d := deque_from([String]{"a", "b", "c"})
    d = appendleft(d, "z")
    d = append(d, "d")
    print(deque_len(d))
    print(deque_is_empty(d))
    print(peek(d))
    print(peekleft(d))
    pair :: popleft(d)
    print(pair.value)
    d = pair.deque
    pair2 :: pop(d)
    print(pair2.value)
    d = pair2.deque
    d = extend(d, [String]{"x", "y"})
    d = extendleft(d, [String]{"l", "m"})
    d = rotate(d, 2)
    print(deque_items(d))

    m := ordered_map()
    m = map_set(m, "a", "one")
    m = map_set(m, "b", "two")
    m = map_set(m, "a", "uno")
    print(map_get(m, "a"))
    print(map_keys(m))
    print(map_values(m))
    print(map_contains(m, "b"))
    print(map_len(m))
    m = map_remove(m, "a")
    print(map_keys(m))

    ch := chain()
    ch = chain_push(ch, [String]{"a", "b"}, [String]{"outer-a", "outer-b"})
    ch = chain_push(ch, [String]{"a"}, [String]{"inner-a"})
    print(chain_get(ch, "a"))
    print(chain_get(ch, "b"))
    print(chain_contains(ch, "missing"))
}
