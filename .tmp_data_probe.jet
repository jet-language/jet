use core.data as data

#Codable
struct Ticket {
    team: String
    minutes: Float
}

fn run() {
    raw :: "team,minutes\nCore,4.0\nTools,5.0\nCore,8.0\nTools,7.0"
    rows :: data.csv<Ticket>(raw) ?? panic("bad csv")
    print("rows: {rows.len()}")
    groups :: data.query(rows).group_by(t -> t.team).count().collect() ?? panic("group")
    print("groups: {groups.len()}")
    loop g in groups -> print("{g.key}")
}
