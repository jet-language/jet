use core.files as fs
use core.io as io
use core.process as process
use core.ui as ui

fn fail_int(message: String) -> Int {
    print(message)
    process.exit(1)
    return 0
}

fn level_source(x: Int, y: Int) -> String {
    return "pub fn name() -> String {{\n    return \"nebula-edited\"\n}}\n\npub fn asteroid_x() -> Int {{\n    return {x}\n}}\n\npub fn asteroid_y() -> Int {{\n    return {y}\n}}\n"
}

fn arg_or(args: [String], idx: Int, default: String) -> String {
    return args.get(idx) ?? copy default
}

fn int_arg(args: [String], idx: Int, default: Int) -> Int {
    raw :: args.get(idx) ?? return default
    return raw.to_int() ?? fail_int("jetplay editor: argument {idx} must be an integer")
}

fn render_editor_panel(x: Int, y: Int) -> [String] {
    backend :: ui.null_backend()
    node :: ui.node_color("asteroid {x},{y}", 180.0, 40.0, "#2f6bff")
    constraint :: ui.constraint(0.0, 0.0, 240.0, 80.0)
    size :: backend.measure(node, constraint)
    frame :: ui.rect(16.0, 16.0, size.width, size.height)
    backend.layout(node, frame)
    backend.paint(node)
    return backend.commands()
}

fn run() {
    args :: io.args()
    root :: arg_or(args, 1, "examples/apps/jetfighter")
    x :: int_arg(args, 2, 2)
    y :: int_arg(args, 3, 0)
    fs.create_dir_all(root) ?? return
    level_path :: "{root}/level.jet"
    fs.write(level_path, level_source(x, y)) ?? return
    print("jetplay editor")
    print("root {root}")
    print("source {level_path}")
    print("asteroid {x},{y}")
    loop cmd in render_editor_panel(x, y) {
        print("ui {cmd}")
    }
    print("workflow source-backed")
}

#Test("level source writer is deterministic") {
    src :: level_source(2, 0)
    require(src.contains("nebula-edited"))
    require(src.contains("return 2"))
    require(src.contains("return 0"))
}
