query 1
jetplay capstone
level nebula-edited asteroid=(2,0)
frame 0 ship=(1,0) score=0
frame 1 ship=(2,0) score=250
frame 2 ship=(2,1) score=250
render ship=(2,1) asteroid=(2,0)
export native: jet build examples/apps/jetfighter/main.jet
export web-editor: jet build --target=web examples/apps/jetfighter/workbench_ui.jet
export replay: runs/jetfighter.jreplay
hook fire 1
scene:jetfighter
backend:headless/none/none
replay:runs/jetfighter.jreplay
assets:image:assets/player.png,sound:assets/laser.wav
input:thrust=Up,fire=Space
components:Position,Velocity
budgets:frame=16ms,memory=128mb,assets=512kb,draws=8
frame:0 input:none
frame:1 input:thrust+fire
frame:2 input:none
