#Target(Web)
use core.ui as ui

fn run() {
    backend :: ui.null_backend()
    title :: ui.node_color("JetPlay editor", 180.0, 40.0, "#2f6bff")
    constraint :: ui.constraint(0.0, 0.0, 300.0, 100.0)
    size :: backend.measure(title, constraint)
    frame :: ui.rect(20.0, 20.0, size.width, size.height)
    backend.layout(title, frame)
    backend.paint(title)
    print("jetplay editor ui")
    loop cmd in backend.commands() {
        print(cmd)
    }
}
