// forge — a Nix-backed dev-environment & task runner, written in Jet.
//
// The whole CLI lives here; the real work is in the four packages under
// packages/ (ansi, manifest, taskrunner, nixbridge).
//
// This file coordinates the four packages. Because a type can only be named in
// the file that defines it, the app never names `Project`/`Node`/`Resolved`;
// it threads opaque values straight from one package function into another and
// works entirely in strings, lists, and maps.

import manifest;
import taskrunner;
import nixbridge;
import ansi;
import std.io as io;
import std.env as env;
import std.process as process;
import std.fs as fs;

fn manifest_path() -> String {
    return "demo/forge.json";
}

fn fixture_dir() -> String {
    return "demo/fixtures";
}

// --- Color helpers (color is a flag, off for pipes/`--no-color`) -----------

fn bold(text: String, color: Bool) -> String {
    if (color == true) { return ansi.bold(text); }
    return text.clone();
}

fn cyan(text: String, color: Bool) -> String {
    if (color == true) { return ansi.cyan(text); }
    return text.clone();
}

fn green(text: String, color: Bool) -> String {
    if (color == true) { return ansi.green(text); }
    return text.clone();
}

fn red(text: String, color: Bool) -> String {
    if (color == true) { return ansi.red(text); }
    return text.clone();
}

fn header(text: String, color: Bool) -> String {
    return "{bold("forge ", color)}{cyan(text, color)}";
}

// --- Command model --------------------------------------------------------

enum Command {
    Help;
    List;
    Tools;
    Doctor;
    Env;
    Sync;
    Shell;
    Plan(String);
    Run(String);
    Use(String);
    Bad(String);
}

struct Cli {
    command: Command;
    online: Bool;
    execute: Bool;
    color: Bool;
    passthrough: List<String>;
}

fn to_command(positionals: List<String>) -> Command {
    if (positionals.len() == 0) {
        return Command.Help;
    }
    val verb = positionals.get(0) or "help";
    if (verb == "__badflag__") {
        return Command.Bad("unknown flag {positionals.get(1) or ""}");
    }
    if (verb == "help") { return Command.Help; }
    if (verb == "list") { return Command.List; }
    if (verb == "tools") { return Command.Tools; }
    if (verb == "doctor") { return Command.Doctor; }
    if (verb == "env") { return Command.Env; }
    if (verb == "sync") { return Command.Sync; }
    if (verb == "shell") { return Command.Shell; }
    if (verb == "plan") {
        if positionals.get(1) == value(task) {
            return Command.Plan(task);
        }
        return Command.Bad("`plan` needs a task name, e.g. `forge plan build`");
    }
    if (verb == "run") {
        if positionals.get(1) == value(task) {
            return Command.Run(task);
        }
        return Command.Bad("`run` needs a task name, e.g. `forge run build`");
    }
    if (verb == "use") {
        if positionals.get(1) == value(package) {
            return Command.Use(package);
        }
        return Command.Bad("`use` needs a nixpkgs package, e.g. `forge use nixpkgs#jq -- jq --version`");
    }
    return Command.Bad("unknown command `{verb}` — try `forge help`");
}

fn parse(args: List<String>) -> Cli {
    var online = false;
    var execute = false;
    var color = true;
    var positionals: List<String> = [];
    var passthrough: List<String> = [];
    var i = 1;
    while (i < args.len()) {
        if args.get(i) == value(arg) {
            if (arg == "--") {
                i += 1;
                while (i < args.len()) {
                    if args.get(i) == value(rest) {
                        passthrough.push(rest);
                    }
                    i += 1;
                }
            } else if (arg == "--online") {
                online = true;
            } else if (arg == "--execute") {
                execute = true;
            } else if (arg == "--no-color") {
                color = false;
            } else if (arg == "-h" || arg == "--help") {
                positionals.push("help");
            } else if (arg.starts_with("-")) {
                positionals.push("__badflag__");
                positionals.push(arg.clone());
            } else {
                positionals.push(arg.clone());
            }
        }
        i += 1;
    }
    val command = to_command(positionals);
    return Cli { command: command, online: online, execute: execute, color: color, passthrough: passthrough };
}

// --- Commands -------------------------------------------------------------

fn cmd_list(color: Bool) -> Int {
    switch manifest.load(manifest_path()) {
        it == err(e) -> {
            io.eprint("{red("error: ", color)}{manifest.describe(e)}");
            return 1;
        };
        it == ok(project) -> {
            print(header("tasks for {manifest.project_name(project)}", color));
            print("");
            val names = manifest.task_names(project);
            for name in names {
                val tools = manifest.task_tool_names(project, name.clone());
                val run_cmd = manifest.task_command(project, name.clone());
                print("  {bold(name.clone(), color)}");
                if (tools.len() > 0) {
                    print("      tools: {tools.join(", ")}");
                }
                if (run_cmd.len() > 0) {
                    print("      runs:  {run_cmd}");
                }
            }
            return 0;
        };
    }
}

fn cmd_tools(color: Bool) -> Int {
    switch manifest.load(manifest_path()) {
        it == err(e) -> {
            io.eprint("{red("error: ", color)}{manifest.describe(e)}");
            return 1;
        };
        it == ok(project) -> {
            print(header("tools for {manifest.project_name(project)}", color));
            print("");
            val names = manifest.tool_names(project);
            for name in names {
                val package = manifest.tool_package(project, name.clone());
                print("  {bold(name.clone(), color)}  <-  {package}");
            }
            return 0;
        };
    }
}

fn cmd_plan(task: String, color: Bool) -> Int {
    // Switch directly on the cross-package result (binding it to a `val` would
    // make codegen name a foreign type). Gather primitives, then delegate.
    switch manifest.load(manifest_path()) {
        it == err(e) -> {
            io.eprint("{red("error: ", color)}{manifest.describe(e)}");
            return 1;
        };
        it == ok(project) -> {
            val edges = manifest.task_edges(project);
            val commands = manifest.task_commands(project);
            return print_plan(task, edges, commands, color);
        };
    }
}

// Inner switch lives in its own function so it doesn't collide with the outer
// `it`, and takes only maps (no cross-package types).
fn print_plan(task: String, edges: Map<String, List<String>>, commands: Map<String, String>, color: Bool) -> Int {
    switch taskrunner.resolve_edges(edges, [task.clone()]) {
        it == err(pe) -> {
            io.eprint("{red("error: ", color)}{taskrunner.describe(pe)}");
            return 1;
        };
        it == ok(order) -> {
            print(header("plan for {bold(task.clone(), color)}", color));
            print("");
            var step = 1;
            for name in order {
                val run_cmd = commands.get(name.clone()) or "";
                print("  {step}. {green(name.clone(), color)}   {run_cmd}");
                step += 1;
            }
            return 0;
        };
    }
}

fn cmd_env(online: Bool, color: Bool) -> Int {
    switch manifest.load(manifest_path()) {
        it == err(e) -> {
            io.eprint("{red("error: ", color)}{manifest.describe(e)}");
            return 1;
        };
        it == ok(project) -> {
            val specs = manifest.tool_specs(project);
            val base = env.get("PATH") or "/usr/bin";
            val offline = (online == false);
            print("# {header("environment for {manifest.project_name(project)}", color)}");
            print("# eval this in your shell:  eval \"$(forge env)\"");
            print("");
            val new_path = nixbridge.provision_path(specs, offline, fixture_dir(), base);
            print("export PATH=\"{new_path}\"");
            val pairs = manifest.env_pairs(project);
            for key, value_str in pairs {
                print("export {key}=\"{value_str}\"");
            }
            return 0;
        };
    }
}

fn cmd_sync(color: Bool) -> Int {
    print(header("syncing forge.env.jet", color));
    val spawned = process.run(["jet", "run", "forge.env.jet"]);
    switch spawned {
        spawned == ok(_) -> {
            return 0;
        };
        spawned == err(_) -> {
            io.eprint("{red("error: ", color)}could not run `jet run forge.env.jet`");
            return 1;
        };
    }
}

fn cmd_shell(color: Bool) -> Int {
    val synced = cmd_sync(color);
    if (synced != 0) {
        return synced;
    }
    switch manifest.load(manifest_path()) {
        it == err(e) -> {
            io.eprint("{red("error: ", color)}{manifest.describe(e)}");
            return 1;
        };
        it == ok(project) -> {
            val specs = manifest.tool_specs(project);
            val base = env.get("PATH") or "/usr/bin";
            val path = nixbridge.provision_path(specs, false, fixture_dir(), base);
            val _mk = fs.create_dir("build");
            var exports: List<String> = [];
            exports.push("# generated by Forge; source this file to enter the tool environment");
            exports.push("export PATH=\"{path}\"");
            exports.push("export FORGE_ACTIVE=1");
            val pairs = manifest.env_pairs(project);
            for key, value_str in pairs {
                exports.push("export {key}=\"{value_str}\"");
            }
            val env_text = exports.join("\n");
            val env_written = fs.write("build/forge-env.sh", "{env_text}\n");
            switch env_written {
                env_written == err(_) -> {
                    io.eprint("{red("error: ", color)}could not write build/forge-env.sh");
                    return 1;
                };
                env_written == ok(_) -> {};
            }
            val shell = env.get("SHELL") or "bash";
            val shell_text = "#!/usr/bin/env bash\nsource \"$(dirname \"$0\")/forge-env.sh\"\nexec {shell}\n";
            val shell_written = fs.write("build/forge-shell", shell_text);
            switch shell_written {
                shell_written == err(_) -> {
                    io.eprint("{red("error: ", color)}could not write build/forge-shell");
                    return 1;
                };
                shell_written == ok(_) -> {};
            }
            val _chmod = process.run(["chmod", "+x", "build/forge-shell"]);
            print(header("shell ready", color));
            print("source build/forge-env.sh");
            print("bash build/forge-shell");
            return 0;
        };
    }
}

fn inferred_bin(package: String) -> String {
    if (package.contains("#")) {
        val parts = package.split("#");
        return parts.get(parts.len() - 1) or package.clone();
    }
    return package.clone();
}

fn package_ref(package: String) -> String {
    if (package.contains("#")) {
        return package.clone();
    }
    return "nixpkgs#{package}";
}

fn join_command(parts: List<String>) -> String {
    var out: List<String> = [];
    for part in parts {
        out.push(part);
    }
    return out.join(" ");
}

fn cmd_use(package: String, cmd: List<String>, color: Bool) -> Int {
    val name = inferred_bin(package.clone());
    val pkg = package_ref(package.clone());
    val base = env.get("PATH") or "/usr/bin";
    var actual: List<String> = [];
    if (cmd.len() == 0) {
        actual.push(name.clone());
    } else {
        for part in cmd {
            actual.push(part);
        }
    }
    val command = join_command(actual);
    val online_first = nixbridge.provision_one_path(name.clone(), pkg.clone(), false, fixture_dir(), base.clone());
    var resolved_path = "";
    switch online_first {
        online_first == ok(path) -> {
            resolved_path = path;
        };
        online_first == err(reason) -> {
            io.eprint("{red("error: ", color)}could not provision {pkg}: {reason}");
            return 1;
        };
    }
    print(header("using {pkg}", color));
    val output = execute_command(command, resolved_path);
    if (output.trim().len() > 0) {
        print(output.trim());
    }
    return 0;
}

fn cmd_run(task: String, online: Bool, execute: Bool, color: Bool) -> Int {
    switch manifest.load(manifest_path()) {
        it == err(e) -> {
            io.eprint("{red("error: ", color)}{manifest.describe(e)}");
            return 1;
        };
        it == ok(project) -> {
            val edges = manifest.task_edges(project);
            val commands = manifest.task_commands(project);
            val specs = manifest.tool_specs(project);
            return run_plan(task, edges, commands, specs, online, execute, color);
        };
    }
}

fn run_plan(
    task: String,
    edges: Map<String, List<String>>,
    commands: Map<String, String>,
    specs: Map<String, String>,
    online: Bool,
    execute: Bool,
    color: Bool
) -> Int {
    switch taskrunner.resolve_edges(edges, [task.clone()]) {
        it == err(pe) -> {
            io.eprint("{red("error: ", color)}{taskrunner.describe(pe)}");
            return 1;
        };
        it == ok(order) -> {
            val base = env.get("PATH") or "/usr/bin";
            val offline = (online == false);
            print(header("provisioning toolchain...", color));
            val report = nixbridge.provision_report(specs, offline, fixture_dir());
            for line in report {
                print("  {line}");
            }
            val new_path = nixbridge.provision_path(specs, offline, fixture_dir(), base);
            print("");
            print(header("running {bold(task.clone(), color)}", color));
            var step = 1;
            for name in order {
                val run_cmd = commands.get(name.clone()) or "";
                if (run_cmd.len() == 0) {
                    print("  {step}. {green(name.clone(), color)}  (no command)");
                } else if (execute == true) {
                    print("  {step}. {green(name.clone(), color)}  $ {run_cmd}");
                    val output = execute_command(run_cmd.clone(), new_path.clone());
                    print(indent(output));
                } else {
                    print("  {step}. {green(name.clone(), color)}  $ {run_cmd}");
                }
                step += 1;
            }
            if (execute == false) {
                print("");
                print("(dry run — pass {bold("--execute", color)} to actually run these)");
            }
            return 0;
        };
    }
}

// Run a command with the provisioned PATH, capturing its output via a file
// (we read the file rather than the subprocess result struct).
fn execute_command(run_cmd: String, path: String) -> String {
    val out_file = "/tmp/forge-step.out";
    val script = "export PATH=\"{path}\"; ({run_cmd}) > {out_file} 2>&1";
    val spawned = process.run(["bash", "-c", script]);
    switch spawned {
        spawned == err(_) -> {
            return "      (could not start a shell)";
        };
        spawned == ok(_proc) -> {
            val produced = fs.read(out_file);
            switch produced {
                produced == ok(text) -> { return text; };
                produced == err(_) -> { return ""; };
            }
        };
    }
}

fn indent(text: String) -> String {
    var out: List<String> = [];
    for line in text.split("\n") {
        if (line.len() > 0) {
            out.push("      {line}");
        }
    }
    return out.join("\n");
}

fn cmd_doctor(color: Bool) -> Int {
    print(header("doctor", color));
    print("");
    if (nixbridge.nix_available() == true) {
        print("  {green("ok", color)}   nix is on your PATH");
    } else {
        print("  {red("--", color)}   nix not found (offline/fixture mode still works)");
    }
    switch manifest.load(manifest_path()) {
        it == ok(project) -> {
            val tools = manifest.tool_names(project);
            val tasks = manifest.task_names(project);
            print("  {green("ok", color)}   {manifest_path()} parses ({tools.len()} tools, {tasks.len()} tasks)");
            return 0;
        };
        it == err(e) -> {
            print("  {red("--", color)}   {manifest.describe(e)}");
            return 1;
        };
    }
}

fn print_help(color: Bool) {
    print(header("— a Nix-backed dev-environment & task runner", color));
    print("");
    print("usage: forge <command> [options]");
    print("");
    print("commands:");
    print("  {bold("list", color)}            list tasks and the tools they need");
    print("  {bold("tools", color)}           list tools and their Nix packages");
    print("  {bold("plan", color)} <task>     show the dependency-ordered run plan");
    print("  {bold("run", color)} <task>      provision the toolchain, then run the plan");
    print("  {bold("env", color)}             print shell exports for the toolchain");
    print("  {bold("sync", color)}            generate manifest + jet.toml from forge.env.jet");
    print("  {bold("shell", color)}           create shell activation scripts");
    print("  {bold("use", color)} <pkg> -- <cmd>  run one nixpkgs package directly");
    print("  {bold("doctor", color)}          check Nix and the manifest");
    print("  {bold("help", color)}            show this help");
    print("");
    print("options:");
    print("  --online        actually build tools with Nix (default: offline fixtures)");
    print("  --execute       in `run`, execute commands (default: dry run)");
    print("  --no-color      disable ANSI color");
}

// --- Entry point ----------------------------------------------------------

fn main() {
    val code = run(io.args());
    process.exit(code);
}

/// Parse args and dispatch. Returns a process exit code.
fn run(args: List<String>) -> Int {
    val cli = parse(args);
    val color = cli.color;
    val online = cli.online;
    val execute = cli.execute;
    val passthrough = cli.passthrough.clone();
    val command = cli.command.clone();
    switch command {
        command == Help -> {
            print_help(color);
            return 0;
        };
        command == List -> {
            return cmd_list(color);
        };
        command == Tools -> {
            return cmd_tools(color);
        };
        command == Doctor -> {
            return cmd_doctor(color);
        };
        command == Env -> {
            return cmd_env(online, color);
        };
        command == Sync -> {
            return cmd_sync(color);
        };
        command == Shell -> {
            return cmd_shell(color);
        };
        command == Plan(task) -> {
            return cmd_plan(task, color);
        };
        command == Run(task) -> {
            return cmd_run(task, online, execute, color);
        };
        command == Use(package) -> {
            return cmd_use(package, passthrough, color);
        };
        command == Bad(msg) -> {
            io.eprint("{red("error: ", color)}{msg}");
            io.eprint("try `forge help`");
            return 2;
        };
    }
}
