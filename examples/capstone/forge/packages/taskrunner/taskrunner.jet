// taskrunner — order tasks by their dependencies, or explain the cycle.
//
// Showcases: a depth-first topological sort with recursion and `mut`
// accumulators, `Map`/`List`, a generic helper, friendly
// errors that name the exact cycle. Self-contained (no std, no deps) so it
// unit-tests in isolation; the `forge` app adds color on top.

/// What can go wrong building a run order.
pub enum PlanError {
    Unknown(String);       // a task depends on something that doesn't exist
    Cycle(List<String>);   // tasks depend on each other in a loop
}

/// One task and the tasks that must run before it.
pub struct Node {
    pub name: String;
    pub needs: List<String>;
}

/// Generic "first element, or a fallback" — one definition serves every
/// element type. (A comparison-free generic: generic `==` isn't a v1 feature.)
pub fn first_or<T>(take xs: List<T>, take fallback: T) -> T {
    if xs.get(0) == value(head) {
        return head;
    }
    return fallback;
}

/// Is `name` one of `names`? Concrete on `String` (generic `==` isn't v1).
fn contains_name(names: List<String>, name: String) -> Bool {
    for candidate in names {
        if (candidate == name) {
            return true;
        }
    }
    return false;
}

// Build a name -> needs index and the set of known names.
fn index_of(nodes: List<Node>) -> Map<String, List<String>> {
    var index: Map<String, List<String>> = [:];
    for node in nodes {
        index[node.name.clone()] = node.needs.clone();
    }
    return index;
}

fn names_of(nodes: List<Node>) -> List<String> {
    var names: List<String> = [];
    for node in nodes {
        names.push(node.name.clone());
    }
    return names;
}

// Trim a recorded path down to the actual cycle: from the repeated node to
// the end. Turns `a -> b -> c -> b` into `b -> c -> b`.
fn cycle_slice(path: List<String>, repeated: String) -> List<String> {
    var start = 0;
    var i = 0;
    for step in path {
        if (step == repeated) {
            start = i;
            break;
        }
        i += 1;
    }
    var out: List<String> = [];
    var j = start;
    while (j < path.len()) {
        if path.get(j) == value(step) {
            out.push(step);
        }
        j += 1;
    }
    out.push(repeated.clone());
    return out;
}

// Depth-first visit. `state`: 0/absent = unvisited, 1 = on the current path,
// 2 = finished. `problem` is set (once) to a cycle path if one is found.
fn visit(
    name: String,
    index: Map<String, List<String>>,
    mut state: Map<String, Int>,
    mut order: List<String>,
    mut path: List<String>,
    mut problem: List<String>
) {
    if (problem.len() > 0) {
        return;
    }
    val current = state.get(name) or 0;
    if (current == 2) {
        return;
    }
    if (current == 1) {
        val cyc = cycle_slice(path, name.clone());
        for step in cyc {
            problem.push(step);
        }
        return;
    }
    state[name.clone()] = 1;
    path.push(name.clone());
    if index.get(name) == value(deps) {
        for dep in deps {
            visit(dep, index, mut state, mut order, mut path, mut problem);
        }
    }
    val _dropped = path.pop() or "";
    state[name.clone()] = 2;
    order.push(name.clone());
}

/// Produce a run order for `targets` (and everything they depend on), with
/// dependencies before the tasks that need them. Reports the first unknown
/// task or dependency cycle instead.
pub fn resolve(nodes: List<Node>, targets: List<String>) -> List<String> ? PlanError {
    val index = index_of(nodes);
    val known = names_of(nodes);

    // Every target and every dependency must name a real task.
    for target in targets {
        if (contains_name(known.clone(), target.clone()) == false) {
            return err(PlanError.Unknown(target.clone()));
        }
    }
    for name in known {
        if index.get(name) == value(deps) {
            for dep in deps {
                if (contains_name(known.clone(), dep.clone()) == false) {
                    return err(PlanError.Unknown(dep.clone()));
                }
            }
        }
    }

    var state: Map<String, Int> = [:];
    var order: List<String> = [];
    var path: List<String> = [];
    var problem: List<String> = [];
    for target in targets {
        visit(target, index, mut state, mut order, mut path, mut problem);
    }
    if (problem.len() > 0) {
        return err(PlanError.Cycle(problem));
    }
    return ok(order);
}

/// Primitive-facing entry point: callers in other packages can't name `Node`,
/// so they pass a `name -> needs` map directly.
pub fn resolve_edges(edges: Map<String, List<String>>, targets: List<String>) -> List<String> ? PlanError {
    var nodes: List<Node> = [];
    for name, needs in edges {
        nodes.push(Node { name: name.clone(), needs: needs.clone() });
    }
    return resolve(nodes, targets);
}

/// A friendly, plain-text description of a plan error. The `forge` app adds
/// color; keeping this dependency-free lets taskrunner unit-test in isolation.
pub fn describe(take e: PlanError) -> String {
    switch e {
        e == Unknown(name) -> {
            return "no task named {name} — check the spelling or your `needs`";
        };
        e == Cycle(path) -> {
            return "tasks depend on each other in a loop: {path.join(" -> ")}";
        };
    }
}

// --- Tests ----------------------------------------------------------------

fn node(take name: String, take needs: List<String>) -> Node {
    return Node { name: name, needs: needs };
}

fn sample() -> List<Node> {
    val empty: List<String> = [];
    return [
        node("all", ["report", "greet"]),
        node("report", ["search"]),
        node("search", ["greet"]),
        node("greet", take empty),
    ];
}

test "dependencies come before the tasks that need them" {
    val order = resolve(sample(), ["all"]) or panic("should resolve");
    require_eq(order.join(","), "greet,search,report,all");
}

test "a single leaf task resolves to just itself" {
    val order = resolve(sample(), ["greet"]) or panic("should resolve");
    require_eq(order.join(","), "greet");
}

test "an unknown target is reported" {
    switch resolve(sample(), ["deploy"]) {
        it == ok(_) -> { require(false); };
        it == err(e) -> {
            require(describe(e).contains("no task named deploy"));
        };
    }
}

test "a dependency cycle names the loop" {
    val empty: List<String> = [];
    val cyclic = [
        node("build", ["test"]),
        node("test", ["build"]),
    ];
    switch resolve(cyclic, ["build"]) {
        it == ok(_) -> { require(false); };
        it == err(e) -> {
            val msg = describe(e);
            require(msg.contains("loop"));
            require(msg.contains("build"));
            require(msg.contains("test"));
        };
    }
}

test "resolve_edges takes a name->needs map" {
    var edges: Map<String, List<String>> = [:];
    val empty: List<String> = [];
    edges["a"] = ["b"];
    edges["b"] = empty;
    val order = resolve_edges(edges, ["a"]) or panic("should resolve");
    require_eq(order.join(","), "b,a");
}

test "first_or is generic over the element type" {
    require_eq(first_or([10, 20], -1), 10);
    val empty: List<Int> = [];
    require_eq(first_or(empty, -1), -1);
    require_eq(first_or(["x", "y"], "?"), "x");
}
