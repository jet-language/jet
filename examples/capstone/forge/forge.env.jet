// Forge environment spec.
//
// This is the Jet-native counterpart to a small `flake.nix`: declare the
// nixpkgs tools and project tasks here, then run `forge sync` or `forge shell`.
// The generator writes the runtime manifest Forge consumes and records the
// manifest path in `jet.toml`.

import std.fs as fs;
import std.process as process;

struct Tool {
    name: String;
    package: String;
    bin: String;
}

struct Task {
    name: String;
    run: String;
    tools: List<String>;
    needs: List<String>;
}

fn tool(take name: String, take package: String, take bin: String) -> Tool {
    return Tool { name: name, package: package, bin: bin };
}

fn task(take name: String, take run: String, take tools: List<String>, take needs: List<String>) -> Task {
    return Task { name: name, run: run, tools: tools, needs: needs };
}

fn quote_list(items: List<String>) -> String {
    var out: List<String> = [];
    for item in items {
        out.push("\"{item}\"");
    }
    return out.join(", ");
}

fn tool_json(t: Tool) -> String {
    return "{{ \"name\": \"{t.name}\", \"package\": \"{t.package}\", \"bin\": \"{t.bin}\" }}";
}

fn task_json(t: Task) -> String {
    return "{{ \"name\": \"{t.name}\", \"run\": \"{t.run}\", \"tools\": [{quote_list(t.tools)}], \"needs\": [{quote_list(t.needs)}] }}";
}

fn tools() -> List<Tool> {
    return [
        tool("ripgrep", "nixpkgs#ripgrep", "rg"),
        tool("jq", "nixpkgs#jq", "jq"),
        tool("hello", "nixpkgs#hello", "hello"),
    ];
}

fn tasks() -> List<Task> {
    val empty: List<String> = [];
    return [
        task("greet", "hello", ["hello"], empty.clone()),
        task("search", "rg TODO demo", ["ripgrep"], ["greet"]),
        task("report", "jq . demo/forge.json", ["jq"], ["search"]),
        task("build", "jq -r .name demo/forge.json", ["jq"], ["report"]),
        task("all", "", empty.clone(), ["build", "greet"]),
    ];
}

fn forge_json() -> String {
    var tool_lines: List<String> = [];
    for t in tools() {
        tool_lines.push("    {tool_json(t)}");
    }
    var task_lines: List<String> = [];
    for t in tasks() {
        task_lines.push("    {task_json(t)}");
    }
    val tool_block = tool_lines.join(",\n");
    val task_block = task_lines.join(",\n");
    return "{{\n  \"name\": \"demo-app\",\n  \"description\": \"A sample project Forge manages\",\n  \"tools\": [\n{tool_block}\n  ],\n  \"env\": {{\n    \"FORGE_DEMO\": \"1\",\n    \"GREETING\": \"hello from forge\"\n  }},\n  \"tasks\": [\n{task_block}\n  ]\n}}\n";
}

fn jet_toml() -> String {
    return "[package]\nname = \"forge\"\nversion = \"0.1.0\"\njet = \">=0.1.0\"\ndescription = \"A Nix-backed dev-environment & task runner, written in Jet\"\nlicense = \"MIT OR Apache-2.0\"\nrepository = \"\"\n\n[dependencies]\nansi = {{ path = \"packages/ansi\" }}\nmanifest = {{ path = \"packages/manifest\" }}\ntaskrunner = {{ path = \"packages/taskrunner\" }}\nnixbridge = {{ path = \"packages/nixbridge\" }}\n\n[tool.forge]\nenv = \"forge.env.jet\"\nmanifest = \"demo/forge.json\"\n\n";
}

fn main() {
    val _manifest = fs.write("demo/forge.json", forge_json()) or panic("could not write demo/forge.json");
    val _toml = fs.write("jet.toml", jet_toml()) or panic("could not write jet.toml");
    print("synced forge.env.jet -> demo/forge.json + jet.toml");
    process.exit(0);
}
