// server.jet — HTTP server for the logbook capstone.
// Routes GET requests to note listing, individual notes, graph Json,
// health check, and full-text search.
use jet.http as http
use jet.crypto as crypto
use core.encoding.json as json
use "note"
use "index"
use "render"
use "search"

fn graph_json(idx: Index) -> Json {
    nodes: [Json] := []
    edges: [Json] := []
    loop name, n in idx.notes {
        node_fields: [String, Json] @= ["id": Json.Text(name.clone())]
        node @= Json.Object(node_fields)
        nodes.push(node)
        loop target in n.links {
            edge_fields: [String, Json] @= ["from": Json.Text(name.clone()), "to": Json.Text(target)]
            edge @= Json.Object(edge_fields)
            edges.push(edge)
        }
    }
    arr_nodes: [Json] @= nodes
    arr_edges: [Json] @= edges
    obj: [String, Json] @= ["nodes": Json.Array(arr_nodes), "edges": Json.Array(arr_edges)]
    return Json.Object(obj)
}

fn html_response(body: String) -> HttpResponse {
    empty_hdrs: [String, String] @= [:]
    return HttpResponse.{status: "200 OK", body: body.clone(), headers: empty_hdrs}
}

fn route(req: HttpRequest, idx: Index) -> HttpResponse {
    method @= req.method()
    if method == {
        "GET" -> {
            p @= req.path()
            if p == "/" {
                names @= index.note_names(idx)
                return html_response(render.list_to_html(names))
            }
            if p == "/graph.json" {
                g @= graph_json(idx)
                body @= json.to_string_pretty(g)
                hdrs: [String, String] @= ["Content-Type": "application/json"]
                return HttpResponse.{status: "200 OK", body: body, headers: hdrs}
            }
            if p == "/health" {
                empty_hdrs: [String, String] @= [:]
                return HttpResponse.{status: "200 OK", body: "ok", headers: empty_hdrs}
            }
            if p.starts_with("/note/") {
                name @= p.slice(6, (p.len() - 1))
                notes_map: [String, Note] @= idx.notes
                maybe_note: Note? @= notes_map.get(name)
                if maybe_note == {
                    value(note_val) -> {
                        bls_map: [String, [String]] @= idx.backlinks
                        bls: [String] @= bls_map.get(name) ?? []
                        body @= render.note_to_html(note_val, bls)
                        etag @= crypto.sha256(note_val.body)
                        hdrs: [String, String] := [:]
                        hdrs.insert("ETag", etag)
                        return HttpResponse.{status: "200 OK", body: body, headers: hdrs}
                    }
                    null -> {
                        empty_hdrs: [String, String] @= [:]
                        return HttpResponse.{status: "404 Not Found", body: "note not found: {name}", headers: empty_hdrs}
                    }

                }
            }
            if p.starts_with("/search") {
                q @= req.header("q") ?? ""
                hits @= search.find(idx, q)
                body @= render.search_to_html(q, hits)
                return html_response(body)
            }
            empty_hdrs: [String, String] @= [:]
            return HttpResponse.{status: "404 Not Found", body: "not found: {p}", headers: empty_hdrs}
        }
        else -> {
            empty_hdrs: [String, String] @= [:]
            return HttpResponse.{status: "405 Method Not Allowed", body: "only GET is supported", headers: empty_hdrs}
        }
    }
}

pub fn serve(addr: String, idx: Index) {
    idx2 @= idx.clone()
    http.serve(addr, take(idx2) (req: HttpRequest) => route(req, idx2))
}

pub fn graph_json_str(idx: Index) -> String {
    return json.to_string_pretty(graph_json(idx))
}

fn main() {
    print("server module loaded")
}
