use core.io as io
use core.process as process
use core.path as path
use core.files as files
use core.log as log
use "note"
use "index"
use "search"
use "server"
use "config"
use "ffi"
comptime VERSION = "0.1.0"
comptime BANNER = "logbook {VERSION} — markdown knowledge-base manager"
fn usage() {
    io.eprint("usage: logbook <command> [args]")
    io.eprint("")
    io.eprint("commands:")
    io.eprint("  version              print version")
    io.eprint("  index <dir>          build and report index")
    io.eprint("  lint <dir>           check for issues")
    io.eprint("  find <dir> <query>   search notes")
    io.eprint("  links <dir> <name>   show forward and backlinks")
    io.eprint("  graph <dir> [json]    print link graph as JSON")
    io.eprint("  serve <dir> [config <path>]  start HTTP server")
    io.eprint("  new <dir> <name>     create a new note")
}
fn cmd_index(dir: String) {
    idx @= index.build(dir) ?? panic("cannot build index")
    names @= index.note_names(idx)
    print("indexed {names.len()} notes")
    loop err_msg in idx.errors {
        print("error: {err_msg}")
    }
}
fn cmd_lint(dir: String) {
    idx @= index.build(dir) ?? panic("cannot build index")
    if idx.errors.len() == 0 {
        print("ok: no issues")
    } else {
        loop err_msg in idx.errors {
            io.eprint("{err_msg}")
        }
        process.exit(1)
    }
}
fn cmd_find(dir: String, query: String) {
    idx @= index.build(dir) ?? panic("cannot build index")
    results @= search.find(idx, query)
    loop name in results {
        print("{name}")
    }
}
fn cmd_links(dir: String, name: String) {
    idx @= index.build(dir) ?? panic("cannot build index")
    notes_map@ [String, Note] = idx.notes
    maybe_note@ Note? = notes_map.get(name)
    if maybe_note == {
        value(n) -> {
            print("forward links:")
            loop link in n.links {
                print("  -> {link}")
            }
        }
        null -> {
            io.eprint("note not found: {name}")
            process.exit(1)
        }

    }
    bls_map: [String, [String]] @= idx.backlinks
    bls@ [String] = bls_map.get(name) ?? []
    print("backlinks:")
    loop link in bls {
        print("  <- {link}")
    }
}
fn cmd_graph(dir: String, as_json: Bool) {
    idx @= index.build(dir) ?? panic("cannot build index")
    if as_json {
        print(server.graph_json_str(idx))
    } else {
        loop name, n in idx.notes {
            loop target in n.links {
                print("{name} -> {target}")
            }
        }
    }
}
fn cmd_serve(dir: String, config_path: String?) {
    cp@ String = config_path.clone() ?? "logbook.toml"
    cfg @= config.load(cp)
    log.set_level(cfg.level)
    pid @= ffi.pid()
    log.info("logbook server starting pid={pid} dir={dir}")
    idx @= index.build(cfg.notes_dir) ?? panic("cannot build index")
    server.serve(cfg.addr, idx)
}
fn cmd_new(dir: String, name: String) {
    file_path @= path.join(dir, "{name}.md")
    writer @= files.create(file_path) ?? panic("cannot create {file_path}")
    writer.write_line("---") ?? panic("write failed")
    writer.write_line("title: {name}") ?? panic("write failed")
    writer.write_line("tags: []") ?? panic("write failed")
    writer.write_line("---") ?? panic("write failed")
    writer.write_line("") ?? panic("write failed")
    writer.write_line("# {name}") ?? panic("write failed")
    writer.write_line("") ?? panic("write failed")
    print("created {file_path}")
}
fn main() {
    args @= io.args()
    if args.len() < 2 {
        print(BANNER)
        usage()
        process.exit(2)
    }
    cmd @= args[1]
    if cmd == {
        "version" -> {
            print(BANNER)
        }
        "index" -> {
            cmd_index(args[2])
        }
        "lint" -> {
            cmd_lint(args[2])
        }
        "find" -> {
            cmd_find(args[2], args[3])
        }
        "links" -> {
            cmd_links(args[2], args[3])
        }
        "graph" -> {
            as_json @= ((args.len() >= 4) && (args[3] == "json"))
            cmd_graph(args[2], as_json)
        }
        "serve" -> {
            config_path@ String? = null
            if (args.len() >= 4) && (args[3] == "config") {
                cmd_serve(args[2], value(args[4]))
            } else {
                cmd_serve(args[2], config_path)
            }
        }
        "new" -> {
            cmd_new(args[2], args[3])
        }
        else -> {
            io.eprint("unknown command: {cmd}")
            usage()
            process.exit(2)
        }
    }
}
