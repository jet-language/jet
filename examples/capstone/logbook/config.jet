use core.fs as fs
use core.env as env
use core.encoding.toml as toml
pub struct Config {
    pub addr: String
    pub notes_dir: String
    pub level: String
}
pub fn load(path: String) -> Config {
    addr: String = "127.0.0.1:7070"
    notes_dir: String = "notes"
    level: String = "info"
    if fs.exists(path.clone()) {
        raw @= fs.read(path.clone()) ?? ""
        // `toml.parse` returns the rich `Toml` (= Data) value; read each key, keeping
        // the default when a key is absent.
        if toml.parse(raw) == {
            ok(data) -> {
                if data == Object(table) {
                    if table.get("addr") == value(av) {
                        if av == Text(s) { addr = s }
                    }
                    if table.get("notes_dir") == value(nv) {
                        if nv == Text(s) { notes_dir = s }
                    }
                    if table.get("level") == value(lv) {
                        if lv == Text(s) { level = s }
                    }
                }
            }
            err(e) -> {

            }

        }
    }
    addr = env.get("LOGBOOK_ADDR") ?? addr
    level = env.get("LOGBOOK_LEVEL") ?? level
    return Config.{addr: addr, notes_dir: notes_dir, level: level}
}
fn main() {
    cfg @= load("config.toml")
    print("addr: {cfg.addr}")
}
