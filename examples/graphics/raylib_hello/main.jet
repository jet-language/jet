// Jet + raylib, through the native C binder (D-CBIND3, Source/CBind.rs).
//
// `use "include/raylib.h"` binds the raylib subset that lands in Jet's bindable
// FFI types (scalars, `bool`, `char*`, `void`); the cache lands at
// `.jet/bindings/c/raylib.jet`. pkg.jet resolves the link line via
// `pkg-config raylib`. No `unsafe` in this file — the edge marshals `Int`s by
// value and the title/text `String`s to C `char*`.
//
// Color-as-int: raylib's draw calls take a by-value `Color` struct (4 bytes:
// r,g,b,a). The binder can't bind by-value structs, so include/raylib.h declares
// the color parameter as `int` — ABI-identical for a 4-byte struct (one GP
// register on x86-64 SysV and AArch64). We pack the color little-endian to match
// the struct's field order: `r | (g<<8) | (b<<16) | (a<<24)`. See include/raylib.h.
//
// This is a GUI program: it opens a real window and cannot be stdout golden-
// tested, which is why it lives under examples/graphics/ and NOT
// examples/features/ (the golden runner executes everything there).
use "include/raylib.h" as rl

// Pack an RGBA color into the little-endian int raylib's draw calls expect.
fn rgba(r: Int, g: Int, b: Int, a: Int) -> Int {
    return r | (g << 8) | (b << 16) | (a << 24)
}

fn main() {
    width := 800
    height := 450
    rl.InitWindow(width, height, "Jet + raylib")
    rl.SetTargetFPS(60)

    // Colors (all fully opaque, a = 255).
    bg := rgba(20, 24, 38, 255)         // dark navy background
    white := rgba(245, 245, 245, 255)   // RAYWHITE — the "hello, world" text

    frame := 0
    loop {
        if rl.WindowShouldClose() {
            break
        }

        // Triangle-wave bounce of a 60px-wide box across the window's interior.
        // `span` is the travel distance; `pos` ping-pongs in [0, span] using the
        // sawtooth `frame % period` folded in half.
        span := width - 60
        period := span * 2
        phase := (frame * 3) % period
        boxX := phase
        if phase >= span {
            boxX = period - phase
        }

        // A circle bouncing vertically on the opposite phase.
        ballSpan := height - 80
        ballPeriod := ballSpan * 2
        ballPhase := (frame * 4) % ballPeriod
        ballY := ballPhase
        if ballPhase >= ballSpan {
            ballY = ballPeriod - ballPhase
        }

        // Cycle the moving shapes' hue across the frame counter so motion +
        // color are both obvious.
        r := (frame * 2) % 256
        g := (frame * 3) % 256
        b := (frame * 5) % 256
        boxColor := rgba(r, 80, 255 - r, 255)
        ballColor := rgba(255 - g, g, b, 255)

        rl.BeginDrawing()
        rl.ClearBackground(bg)
        rl.DrawRectangle(boxX, 40, 60, 60, boxColor)
        rl.DrawCircle(700, 40 + ballY, 24.0, ballColor)
        rl.DrawText("hello, world", 260, 200, 40, white)
        rl.DrawText("Jet + raylib via the native C binder", 230, 260, 16, white)
        rl.EndDrawing()

        frame += 1
    }
    rl.CloseWindow()
}
