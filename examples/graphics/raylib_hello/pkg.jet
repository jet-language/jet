// raylib_hello — opens a raylib window from Jet via the native C binder.
//
// `raylib: c@system` resolves raylib through pkg-config: the build needs
// raylib.pc on PKG_CONFIG_PATH and pkg-config on PATH (see README.md).
// pkg-config supplies both the lib dir (`-L`) and `-lraylib`; the rest
// (GL/X11/…) come from libraylib.so's own NEEDED entries.
payload: {
    name: "raylib_hello",
    version: "0.1.0",
    edition: "2026",
}

deps: {
    raylib: c@system,
}
