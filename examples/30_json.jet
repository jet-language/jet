import std.json as json;

fn main() {
    val raw = "{{\"name\":\"jet\",\"ok\":true,\"items\":[1,2]}}";
    val data = json.parse(raw) or panic("bad json");
    print(json.render(data));
    print(json.render_pretty(data).contains("\n"));
    if data == Object(entries) {
        print(entries.len());
    }
    var obj: Map<String, Json> = [:];
    obj["name"] = Json.Text("jet");
    obj["ok"] = Json.Boolean(true);
    print(json.render(Json.Object(obj)));
}
