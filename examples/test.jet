fn main() {
    print("Hello, World!");
    val testval = Test {number: 42};
    testval.printNumber();
    val testobj = Test {number: 24};
    printTestNum(testobj);
}
struct Test {
    number: Int;

    fn printNumber(self) {
        print("{self.number}");
    }
}
fn printTestNum(testobj: Test) {
    print("{testobj.number}");
}
