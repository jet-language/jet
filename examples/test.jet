fn main() {
    print("Hello, World!");
    var testval = Test {number: 42};
    testval.printNumber();
    val testobj = Test {number: 24};
    printTestNum(testobj);
    val doubled = double.[1, 2, 3];
    val [a, b, c] = doubled;
    val [e, f, g] = ["a", "b", "c"];
    print.[e, f, g, a, b, c];
}
fn double(n: Int) -> Int {
    return (n * 2);
}
struct Test {
    number: Int;

    fn printNumber(self) {
        print("{self.number}");
    }
}
fn printTestNum(testobj: Test) {
    print("{testobj.number}");
}
