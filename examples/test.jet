fn main() {
    print("Hello, World!")
    testval := Test {number: 42}
    testval.printNumber()
    testobj @= Test {number: 24}
    printTestNum(testobj)
    doubled @= double.[1, 2, 3]
    [a, b, c] @= doubled
    [e, f, g] @= ["a", "b", "c"]
    print.[e, f, g, a, b, c]
}
fn double(n: Int) -> Int {
    return (n * 2)
}
struct Test {
    number: Int

    fn printNumber(self) {
        print("{self.number}")
    }
}
fn printTestNum(testobj: Test) {
    print("{testobj.number}")
}
