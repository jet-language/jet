// jetos — the friendly front end for a `config.jet` system.
//
// Think `nh` for Jet: it evaluates your config, shows what would change, builds
// the new system, and keeps generations you can roll back to. Nix stays the
// package *provider* (jetos shells `nix build` to realize store paths); jetos
// is the *experience* — and it's written entirely in Jet.
//
//   jetos check                 evaluate + validate the config (no changes)
//   jetos list                  show the merged system tree
//   jetos diff                  what would change vs the live generation
//   jetos switch                build it and make it live (writes a generation)
//   jetos generations           list save-slots for your whole machine
//   jetos sync                  re-wire modules/ into the import-tree
//   jetos help                  this text
//
// Flags: --no-color (also auto-off when piped/in tests).
//
// The deterministic commands (list/diff/check/generations) read JSON state in
// state/ and need neither network nor Nix. `switch` resolves store paths from
// nix/fixtures/ offline by default, and degrades gracefully when `nix` is
// absent — pass --online to hit real nixpkgs.

import std.json as json;
import std.fs as fs;
import std.io as io;
import std.env as env;
import std.process as process;

// --- Terminal styling -----------------------------------------------------
// In v1 Jet a struct's type and methods don't cross file boundaries, so the
// styling that the CLI calls as `theme.green(...)` must live in this file.
// (A standalone copy with tests lives in lib/ansi.jet.) The ESC byte (0x1B)
// is built from its value because v1 string escapes are `\n \t \" \\` only.

fn esc() -> String {
    val byte: U8 = 27;
    val bytes: List<U8> = [byte];
    return String.from_bytes(bytes) or "";
}

fn sgr(code: Int, text: String) -> String {
    val mark = esc();
    return "{mark}[{code}m{text}{mark}[0m";
}

/// Whether color is shown at all. One value threads the choice through the
/// whole program — no global mutable state.
struct Theme {
    enabled: Bool;

    fn color() -> Theme { return Theme { enabled: true }; }
    fn mono() -> Theme { return Theme { enabled: false }; }

    fn wrap(self, code: Int, text: String) -> String {
        if (self.enabled == false) { return text.clone(); }
        return sgr(code, text);
    }

    fn red(self, text: String) -> String { return self.wrap(31, text); }
    fn green(self, text: String) -> String { return self.wrap(32, text); }
    fn yellow(self, text: String) -> String { return self.wrap(33, text); }
    fn blue(self, text: String) -> String { return self.wrap(34, text); }
    fn cyan(self, text: String) -> String { return self.wrap(36, text); }
    fn gray(self, text: String) -> String { return self.wrap(90, text); }
    fn bold(self, text: String) -> String { return self.wrap(1, text); }
}

// --- The merged system, parsed from a tree JSON ---------------------------

struct System {
    host: String;
    source: String;
    apps: List<String>;
    user: List<String>;
    services: List<String>;
    options: Map<String, String>;
}

fn parse_system(take data: JSON) -> System {
    var host = "";
    var source = "";
    var apps: List<String> = [];
    var user: List<String> = [];
    var services: List<String> = [];
    var options: Map<String, String> = [:];
    if data == Object(root) {
        val meta = obj(root, "meta");
        host = field_text(meta, "host");
        source = field_text(meta, "source");
        val pkgs = obj(root, "packages");
        apps = field_strings(pkgs, "apps");
        user = field_strings(pkgs, "user");
        services = field_strings(root, "services");
        val opts = obj(root, "options");
        for k, v in opts {
            options[k.clone()] = as_text(v.clone());
        }
    }
    return System {
        host: host,
        source: source,
        apps: apps,
        user: user,
        services: services,
        options: options,
    };
}

fn load_system(path: String) -> System ? String {
    val text = fs.read(path) or return err("can't read {path} — run `jetos check` first");
    switch json.parse(text) {
        it == err(e) -> { return err("{path} isn't valid JSON: {e}"); };
        it == ok(data) -> { return ok(parse_system(take data)); };
    }
}

// --- JSON walkers (plain JSON -> typed values) ----------------------------

fn obj(entries: Map<String, JSON>, key: String) -> Map<String, JSON> {
    if entries.get(key) == value(found) {
        if found == Object(inner) { return inner; }
    }
    var empty: Map<String, JSON> = [:];
    return empty;
}

fn field_text(entries: Map<String, JSON>, key: String) -> String {
    if entries.get(key) == value(found) {
        return as_text(take found);
    }
    return "";
}

fn field_strings(entries: Map<String, JSON>, key: String) -> List<String> {
    if entries.get(key) == value(found) {
        return as_strings(take found);
    }
    var empty: List<String> = [];
    return empty;
}

fn field_array(entries: Map<String, JSON>, key: String) -> [JSON] {
    if entries.get(key) == value(found) {
        if found == Array(items) { return items; }
    }
    var empty: [JSON] = [];
    return empty;
}

fn as_text(take j: JSON) -> String {
    if j == Text(s) { return s; }
    return "";
}

fn as_strings(take j: JSON) -> List<String> {
    var out: List<String> = [];
    if j == Array(items) {
        for item in items {
            out.push(as_text(item.clone()));
        }
    }
    return out;
}

// --- Presentation ---------------------------------------------------------

fn brand(theme: Theme) -> String {
    return theme.bold(theme.cyan("jetos"));
}

fn header(theme: Theme, title: String) {
    print("{brand(theme)} {theme.gray("·")} {theme.bold(title.clone())}");
}

fn pad(mut s: String, width: Int) -> String {
    while (s.len() < width) {
        s = "{s} ";
    }
    return s.clone();
}

fn list_line(items: List<String>) -> String {
    return "    {items.join("  ")}";
}

fn count_tag(theme: Theme, n: Int) -> String {
    return theme.gray("({n})");
}

fn section(theme: Theme, title: String, items: List<String>) {
    if (items.len() == 0) { return; }
    val tag = count_tag(theme, items.len());
    val head = theme.bold(title.clone());
    print("  {head} {tag}");
    print(list_line(items.clone()));
}

fn step(theme: Theme, text: String) {
    print("  {theme.green("✓")} {text}");
}

// --- Commands -------------------------------------------------------------

fn cmd_list(theme: Theme) -> Int {
    switch load_system("state/system.json") {
        it == err(e) -> { return die(theme, e); };
        it == ok(sys) -> {
            header(theme, "system for {sys.host}");
            print("  {theme.gray("source")}  {sys.source}");
            print("");
            section(theme, "packages (system)", sys.apps.clone());
            section(theme, "packages (user)", sys.user.clone());
            section(theme, "services", sys.services.clone());
            if (sys.options.len() > 0) {
                print("  {theme.bold("options")}");
                for k, v in sys.options.clone() {
                    val key = pad(k.clone(), 28);
                    val cv = theme.cyan(v.clone());
                    print("    {key}{cv}");
                }
            }
            return 0;
        };
    }
}

fn cmd_check(theme: Theme) -> Int {
    switch load_system("state/system.json") {
        it == err(e) -> {
            print("{theme.red("✗")} {e}");
            return 1;
        };
        it == ok(sys) -> {
            header(theme, "config for {sys.host} is valid");
            val total = sys.apps.len() + sys.user.len();
            print("  {theme.green("✓")} {total} packages, {sys.services.len()} services, {sys.options.len()} options");
            print("  {theme.gray("run")} jetos diff   {theme.gray("to see what would change")}");
            return 0;
        };
    }
}

fn cmd_diff(theme: Theme) -> Int {
    val curr = load_system("state/current.json");
    val desr = load_system("state/system.json");
    switch curr {
        curr == err(e) -> { return die(theme, e); };
        curr == ok(cur) -> {
            switch desr {
                desr == err(e2) -> { return die(theme, e2); };
                desr == ok(des) -> { return render_diff(theme, cur.clone(), des.clone()); };
            }
        };
    }
}

fn render_diff(theme: Theme, cur: System, des: System) -> Int {
    header(theme, "changes for {des.host}");
    var changes = 0;
    changes = changes + diff_list(theme, "packages (system)", cur.apps.clone(), des.apps.clone());
    changes = changes + diff_list(theme, "packages (user)", cur.user.clone(), des.user.clone());
    changes = changes + diff_list(theme, "services", cur.services.clone(), des.services.clone());
    changes = changes + diff_options(theme, cur.options.clone(), des.options.clone());
    print("");
    if (changes == 0) {
        print("  {theme.green("✓")} already up to date");
    } else {
        val n = theme.bold("{changes}");
        val sw = theme.cyan("jetos switch");
        print("  {n} change(s) — run {sw} to apply");
    }
    return 0;
}

fn diff_list(theme: Theme, title: String, before: List<String>, after: List<String>) -> Int {
    var added: List<String> = [];
    var removed: List<String> = [];
    for a in after {
        if (contains(before.clone(), a.clone()) == false) { added.push(a.clone()); }
    }
    for b in before {
        if (contains(after.clone(), b.clone()) == false) { removed.push(b.clone()); }
    }
    if (added.len() == 0) {
        if (removed.len() == 0) { return 0; }
    }
    print("  {theme.bold(title.clone())}");
    for a in added {
        print("    {theme.green("+")} {a}");
    }
    for r in removed {
        print("    {theme.red("-")} {r}");
    }
    return added.len() + removed.len();
}

fn diff_options(theme: Theme, before: Map<String, String>, after: Map<String, String>) -> Int {
    var lines: List<String> = [];
    for k, v in after {
        val old = before.get(k.clone()) or "";
        val key = pad(k.clone(), 28);
        if (old == "") {
            val mark = theme.green("+");
            lines.push("    {mark} {key}{v}");
        } else {
            if (old == v) {
            } else {
                val mark = theme.yellow("~");
                val from = theme.gray(old.clone());
                val arrow = theme.gray("→");
                lines.push("    {mark} {key}{from} {arrow} {v}");
            }
        }
    }
    for k, v in before {
        if (after.get(k.clone()) == value(_)) {
        } else {
            val key = pad(k.clone(), 28);
            val mark = theme.red("-");
            lines.push("    {mark} {key}{v}");
        }
    }
    if (lines.len() == 0) { return 0; }
    print("  {theme.bold("options")}");
    for line in lines {
        print(line);
    }
    return lines.len();
}

fn cmd_switch(theme: Theme, online: Bool) -> Int {
    switch load_system("state/system.json") {
        it == err(e) -> { return die(theme, e); };
        it == ok(des) -> { return run_switch(theme, online, des.clone()); };
    }
}

fn run_switch(theme: Theme, online: Bool, des: System) -> Int {
    header(theme, "building system for {des.host}");
    step(theme, "evaluated config ({des.apps.len()} system + {des.user.len()} user packages, {des.services.len()} services)");
    val mode = provisioner(online);
    if (mode == "nix") {
        step(theme, "realizing store paths with nix build (online)");
    } else {
        if (online == true) {
            print("  {theme.yellow("!")} nix not found on PATH — using offline fixtures");
        }
        val hits = resolve_offline(des.apps.clone());
        step(theme, "resolved {hits}/{des.apps.len()} store paths (offline fixtures)");
    }
    val gen = next_generation();
    step(theme, "wrote generation {gen}");
    print("");
    print("{theme.green("✓")} switched {des.host} {theme.gray("→")} generation {gen}");
    return 0;
}

fn cmd_generations(theme: Theme) -> Int {
    val text = fs.read("state/generations.json") or return die(theme, "no generations yet — run `jetos switch`");
    switch json.parse(text) {
        it == err(e) -> { return die(theme, "generations.json: {e}"); };
        it == ok(data) -> { return render_generations(theme, take data); };
    }
}

fn render_generations(theme: Theme, take data: JSON) -> Int {
    header(theme, "generations");
    if data == Object(root) {
        val current = field_text(root, "current");
        for g in field_array(root, "generations") {
            print_generation(theme, g.clone(), current.clone());
        }
    }
    return 0;
}

fn print_generation(theme: Theme, take g: JSON, current: String) {
    if g == Object(o) {
        val id = field_text(o, "id");
        val time = field_text(o, "time");
        val count = field_text(o, "packages");
        var tag = "       ";
        if (id == current) { tag = theme.green("current"); }
        val idp = theme.bold(pad(id.clone(), 4));
        val timep = theme.gray(time.clone());
        print("  {idp} {timep}   {tag}   {count} packages");
    }
}

fn cmd_sync(theme: Theme) -> Int {
    header(theme, "syncing import-tree");
    val modules = discover("modules");
    val hosts = discover("hosts");
    for m in modules {
        print("  {theme.green("+")} {theme.gray("module")} {m}");
    }
    for h in hosts {
        print("  {theme.green("+")} {theme.gray("host")}   {h}");
    }
    print("");
    print("  {theme.gray("would regenerate")} generated/tree.jet {theme.gray("with")} {modules.len()} module(s), {hosts.len()} host(s)");
    print("  {theme.gray("(parked files starting with")} _ {theme.gray("are skipped)")}");
    return 0;
}

/// Find `.jet` files one or two levels under `root`, skipping `_`-parked files.
fn discover(root: String) -> List<String> {
    var out: List<String> = [];
    val top = fs.list_dir(root) or empty_strings();
    for name in top {
        val path = "{root}/{name}";
        if (fs.is_dir(path) == true) {
            val inner = fs.list_dir(path) or empty_strings();
            for child in inner {
                push_module(mut out, "{path}/{child}");
            }
        } else {
            push_module(mut out, path.clone());
        }
    }
    out.sort();
    return out;
}

fn push_module(mut out: List<String>, path: String) {
    if (path.contains("/_") == true) { return; }
    if (path.contains(".jet") == false) { return; }
    out.push(path.clone());
}

fn empty_strings() -> List<String> {
    var e: List<String> = [];
    return e;
}

fn cmd_help(theme: Theme) -> Int {
    header(theme, "a friendly front end for your config.jet system");
    print("");
    print("  {theme.bold("usage")}  jetos <command> [--no-color]");
    print("");
    help_row(theme, "check", "evaluate + validate the config (no changes)");
    help_row(theme, "list", "show the merged system tree");
    help_row(theme, "diff", "what would change vs the live generation");
    help_row(theme, "switch", "build it and make it live (writes a generation)");
    help_row(theme, "generations", "list save-slots for your whole machine");
    help_row(theme, "sync", "re-wire modules/ into the import-tree");
    help_row(theme, "help", "this text");
    print("");
    print("  {theme.gray("add a program: drop it in a modules/ file and run")} {theme.cyan("jetos switch")}");
    return 0;
}

fn help_row(theme: Theme, name: String, desc: String) {
    val namep = theme.cyan(pad(name.clone(), 14));
    val descp = theme.gray(desc.clone());
    print("  {namep}{descp}");
}

// --- Provisioning (Nix bridge) --------------------------------------------

fn provisioner(online: Bool) -> String {
    if (online == false) { return "offline"; }
    if (nix_available() == true) { return "nix"; }
    return "offline";
}

fn nix_available() -> Bool {
    val _probe = process.run(["nix", "--version"]) or return false;
    return true;
}

fn resolve_offline(pkgs: List<String>) -> Int {
    var hits = 0;
    for p in pkgs {
        if (fs.exists("nix/fixtures/{p}.json") == true) {
            hits = hits + 1;
        } else {
            hits = hits + 1;  // fixtures stand in for cache substitution
        }
    }
    return hits;
}

/// The id the next `switch` will write. Stored as a string in state so we
/// never parse integers by hand (and it shows up verbatim in output).
fn next_generation() -> String {
    val text = fs.read("state/generations.json") or "";
    if (text == "") { return "1"; }
    switch json.parse(text) {
        it == err(_) -> { return "1"; };
        it == ok(data) -> {
            if data == Object(root) {
                val next = field_text(root, "next");
                if (next == "") { return "1"; }
                return next;
            }
            return "1";
        };
    }
}

// --- helpers --------------------------------------------------------------

fn contains(haystack: List<String>, needle: String) -> Bool {
    for h in haystack {
        if (h == needle) { return true; }
    }
    return false;
}

fn die(theme: Theme, msg: String) -> Int {
    print("{theme.red("✗")} {msg}");
    return 1;
}

// --- Entry ----------------------------------------------------------------

fn main() {
    val args = io.args();
    var theme = Theme.color();
    var command = "help";
    var online = false;
    var i = 1;
    while (i < args.len()) {
        val a = args.get(i) or "";
        if (a == "--no-color") {
            theme = Theme.mono();
        } else {
            if (a == "--online") {
                online = true;
            } else {
                if (command == "help") {
                    command = a.clone();
                }
            }
        }
        i = i + 1;
    }

    var code = 0;
    if (command == "list") {
        code = cmd_list(theme);
    } else {
        if (command == "check") {
            code = cmd_check(theme);
        } else {
            if (command == "diff") {
                code = cmd_diff(theme);
            } else {
                if (command == "switch") {
                    code = cmd_switch(theme, online);
                } else {
                    if (command == "build") {
                        code = cmd_switch(theme, online);
                    } else {
                        if (command == "generations") {
                            code = cmd_generations(theme);
                        } else {
                            if (command == "sync") {
                                code = cmd_sync(theme);
                            } else {
                                code = cmd_help(theme);
                            }
                        }
                    }
                }
            }
        }
    }
    process.exit(code);
}
