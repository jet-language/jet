// hosts/laptop.jet — one machine. A host is just a module that flips the
// switches for that box. Here the host *decides* the desktop environment
// (normal priority beats the desktop module's `gnome` suggestion), names
// itself, and adds laptop-only power management.

import jetpack as pkg;
import std.json as json;

pub fn contribute() -> List<Json> {
    return [
        pkg.option("sys.desktop.environment", "cinnamon"),
        pkg.option("sys.networking.hostName", "laptop"),
        pkg.installed(["tlp", "powertop"]),
    ];
}
