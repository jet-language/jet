// modules/apps/desktop.jet — a desktop workstation, in one liftable file.
//
// Dendritic: everything "desktop" lives here — the programs, the audio/
// bluetooth services, and a *polite* default for the desktop environment
// (`suggest` = "use this unless a host cares"). Copy this file into any
// config repo and it just works; it talks to the rest of the system only
// through the directives it returns.

import jetpack as pkg;
import std.json as json;

pub fn contribute() -> List<Json> {
    return [
        pkg.installed(["firefox", "fastfetch", "btop", "vlc"]),
        pkg.services(["pipewire", "bluetooth"]),
        pkg.suggest("sys.desktop.environment", "gnome"),
    ];
}
