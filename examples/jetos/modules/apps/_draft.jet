// modules/apps/_draft.jet — PARKED.
//
// A leading underscore parks a file: `jetos sync` skips it, so it never
// reaches the system tree. Rename to `gaming.jet` to switch it on. This is
// the one-way "comment out a feature" mechanism — no edits elsewhere.
import jetpack as pkg;
import core.json as json;
pub fn contribute() -> [JSON] {
    return [pkg.installed(["steam", "lutris"])];
}
