// generated/tree.jet — GENERATED by `jetos sync`. Do not edit by hand.
//
// This is jetpack's "import-tree": every `.jet` under modules/ (except files
// parked with a leading `_`) plus the hosts/ are statically wired here, so the
// rest of your config never maintains an import list. Add a feature file, run
// `jetos sync`, and it appears below. Each module's directives are tagged with
// its path via `pkg.from(...)`, so a conflict can name the exact files.
import jetpack as pkg;
import std.json as json;
import desktop as m_apps_desktop;
import developer as m_apps_developer;
import network as m_services_network;
import laptop as h_laptop;
/// Every active module's directives, source-tagged, for the selected host.
pub fn directives(host: String) -> [JSON] {
    var out: [JSON] = [];
    for d in pkg.from("modules/apps/desktop", m_apps_desktop.contribute()) {
        out.push(d);
    }
    for d in pkg.from("modules/apps/developer", m_apps_developer.contribute()) {
        out.push(d);
    }
    for d in pkg.from("modules/services/network", m_services_network.contribute()) {
        out.push(d);
    }
    if host == "laptop" {
        for d in pkg.from("hosts/laptop", h_laptop.contribute()) {
            out.push(d);
        }
    }
    return out;
}
/// The hosts this config can build (for error messages and `jetos generations`).
pub fn hosts() -> [String] {
    return ["laptop"];
}
