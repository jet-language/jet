// ansi — tiny terminal styling for the jetos CLI.
//
// Pure Jet, zero std. A `Theme` carries one `enabled` flag so `--no-color`
// (and pipes/tests) flip every output through a single value — no global
// mutable state. v1 string escapes are `\n \t \" \\` only, so the ESC byte
// (0x1B) is built from its byte value.

fn esc() -> String {
    val byte: U8 = 27;
    val bytes: List<U8> = [byte];
    return String.from_bytes(bytes) or "";
}

fn sgr(code: Int, text: String) -> String {
    val mark = esc();
    return "{mark}[{code}m{text}{mark}[0m";
}

/// Whether color is shown at all. `Theme.color()` for terminals,
/// `Theme.mono()` for pipes, tests and `--no-color`.
pub struct Theme {
    enabled: Bool;

    pub fn color() -> Theme { return Theme { enabled: true }; }
    pub fn mono() -> Theme { return Theme { enabled: false }; }

    fn wrap(self, code: Int, text: String) -> String {
        if (self.enabled == false) { return text.clone(); }
        return sgr(code, text);
    }

    pub fn red(self, text: String) -> String { return self.wrap(31, text); }
    pub fn green(self, text: String) -> String { return self.wrap(32, text); }
    pub fn yellow(self, text: String) -> String { return self.wrap(33, text); }
    pub fn blue(self, text: String) -> String { return self.wrap(34, text); }
    pub fn magenta(self, text: String) -> String { return self.wrap(35, text); }
    pub fn cyan(self, text: String) -> String { return self.wrap(36, text); }
    pub fn gray(self, text: String) -> String { return self.wrap(90, text); }
    pub fn bold(self, text: String) -> String { return self.wrap(1, text); }
}

test "color wraps SGR codes" {
    val t = Theme.color();
    require(t.green("ok").contains("32m"));
    require(t.bold("x").contains("1m"));
}

test "mono leaves text untouched" {
    val t = Theme.mono();
    require_eq(t.red("hello"), "hello");
}
