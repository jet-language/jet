{
  "meta": {
    "host": "laptop",
    "source": "github:NixOS/nixpkgs/nixos-unstable"
  },
  "options": {
    "sys.desktop.environment": "cinnamon",
    "sys.networking.firewall": "on",
    "sys.networking.hostName": "laptop"
  },
  "packages": {
    "apps": [
      "btop",
      "fastfetch",
      "fd",
      "firefox",
      "git",
      "powertop",
      "ripgrep",
      "tlp",
      "vlc"
    ],
    "user": [
      "fastfetch",
      "helix",
      "jq"
    ]
  },
  "services": [
    "bluetooth",
    "docker",
    "openssh",
    "pipewire",
    "tailscale"
  ]
}
