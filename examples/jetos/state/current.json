{
  "meta": {
    "host": "laptop",
    "source": "github:NixOS/nixpkgs/nixos-unstable"
  },
  "options": {
    "sys.desktop.environment": "gnome",
    "sys.networking.firewall": "on",
    "sys.networking.hostName": "laptop"
  },
  "packages": {
    "apps": [
      "btop",
      "chromium",
      "fastfetch",
      "fd",
      "firefox",
      "git",
      "ripgrep",
      "vlc"
    ],
    "user": [
      "fastfetch",
      "jq"
    ]
  },
  "services": [
    "bluetooth",
    "openssh",
    "pipewire"
  ]
}
