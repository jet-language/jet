use lua.ops as ops
use core.encoding.json as json

#Codable
struct Payload {
    name: String
    values: [Int]
}

fn run() =[Lua, IO]=> {
    session :: ops.open() ?? panic("Lua open failed")
    counters :: ops.counters_view(session, 5000) ?? panic("Lua table view failed")
    print(ops.view_get_int(counters, "requests") ?? panic("Lua table read failed"))
    _changed :: ops.view_set_int(counters, "requests", 8) ?? panic("Lua table write failed")
    print(ops.view_get_int(counters, "requests") ?? panic("Lua table reread failed"))
    input :: DataTree.Object(["nested": DataTree.Object(["ok": DataTree.Bool(true)]), "list": DataTree.Array([DataTree.Int(1), DataTree.Null]), "scalar": DataTree.Float(3.5)])
    print(json.canonical(ops.transform(session, ~input, 5000) ?? panic("first call failed")))
    print(json.canonical(ops.transform(session, ~input, 5000) ?? panic("second call failed")))
    payload :: Payload.{name: "typed", values: [2, 4, 8]}
    echoed :: ops.echo_typed<Payload>(session, payload, 5000) ?? panic("typed call failed")
    print("{echoed.name}:{echoed.values.len()}")
    failed :: ops.fail_call(session, DataTree.Text("secret"), 5000) ?? DataTree.Text("laundered")
    print(json.canonical(failed))
    timed :: ops.spin(session, DataTree.Null, 5) ?? DataTree.Text("timeout")
    print(json.canonical(timed))
    recovered :: ops.echo(session, DataTree.Text("recovered"), 5000) ?? panic("recovery failed")
    print(json.canonical(recovered))
}
