#Extern module c.jet_ruby_ops {
    fn open() => Int = "jet_ruby_ops_open"
    fn take_error() => Int = "jet_ruby_ops_take_error"
    fn cancel(handle: Int) = "jet_ruby_ops_cancel"
    fn close(handle: Int) = "jet_ruby_ops_close"
    fn transform(handle: Int, input: String, deadline_ms: Int) => String = "jet_ruby_ops_invoke_transform"
    fn fail_call(handle: Int, input: String, deadline_ms: Int) => String = "jet_ruby_ops_invoke_fail_call"
    fn sleep_call(handle: Int, input: String, deadline_ms: Int) => String = "jet_ruby_ops_invoke_sleep_call"
}
use c.jet_ruby_ops as abi
use core.encoding.json as json

pub struct Session { value: Int }
pub enum RubyError { NotRunning Timeout Cancelled Protocol CommandFailed Limit }

impl Session.Close {
    fn close(^self) { abi.close(self.value) }
}

pub fn close(^session: Session) { abi.close(session.value) }

pub fn open() => Session ? RubyError {
    handle :: abi.open()
    if abi.take_error() != 0 { return Err(RubyError.NotRunning) }
    return Ok(Session.{ value: handle })
}

pub fn cancel(session: Session) { abi.cancel(session.value) }

pub fn transform(session: Session, input: DataTree, deadline_ms: Int) => DataTree ? RubyError {
    raw :: abi.transform(session.value, json.to_string(input), deadline_ms)
    code :: abi.take_error()
    if code == 1 { return Err(RubyError.NotRunning) }
    if code == 2 { return Err(RubyError.Timeout) }
    if code == 3 { return Err(RubyError.Cancelled) }
    if code == 5 { return Err(RubyError.Limit) }
    if code != 0 { return Err(RubyError.Protocol) }
    response := json.parse(raw) ?? return Err(RubyError.Protocol)
    succeeded := (response.field("ok") ?? DataTree.Bool(false)).bool() ?? false
    if !succeeded { return Err(RubyError.CommandFailed) }
    return Ok(response.field("value") ?? DataTree.Null)
}

pub fn fail_call(session: Session, input: DataTree, deadline_ms: Int) => DataTree ? RubyError {
    raw :: abi.fail_call(session.value, json.to_string(input), deadline_ms)
    code :: abi.take_error()
    if code == 1 { return Err(RubyError.NotRunning) }
    if code == 2 { return Err(RubyError.Timeout) }
    if code == 3 { return Err(RubyError.Cancelled) }
    if code == 5 { return Err(RubyError.Limit) }
    if code != 0 { return Err(RubyError.Protocol) }
    response := json.parse(raw) ?? return Err(RubyError.Protocol)
    succeeded := (response.field("ok") ?? DataTree.Bool(false)).bool() ?? false
    if !succeeded { return Err(RubyError.CommandFailed) }
    return Ok(response.field("value") ?? DataTree.Null)
}

pub fn sleep_call(session: Session, input: DataTree, deadline_ms: Int) => DataTree ? RubyError {
    raw :: abi.sleep_call(session.value, json.to_string(input), deadline_ms)
    code :: abi.take_error()
    if code == 1 { return Err(RubyError.NotRunning) }
    if code == 2 { return Err(RubyError.Timeout) }
    if code == 3 { return Err(RubyError.Cancelled) }
    if code == 5 { return Err(RubyError.Limit) }
    if code != 0 { return Err(RubyError.Protocol) }
    response := json.parse(raw) ?? return Err(RubyError.Protocol)
    succeeded := (response.field("ok") ?? DataTree.Bool(false)).bool() ?? false
    if !succeeded { return Err(RubyError.CommandFailed) }
    return Ok(response.field("value") ?? DataTree.Null)
}

