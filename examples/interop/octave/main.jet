use octave.scale as scale
use core.compute as compute

fn run() -[FFI.Octave, IO]> {
    session :: scale.open() ?? panic("Octave sidecar did not start")
    input :: compute.from_list([1.0, 2.0, 3.0, 4.0]) ?? panic("tensor")
    matrix :: compute.reshape(input, [2, 2]) ?? panic("reshape")
    output :: scale.scale(session, matrix, 5000) ?? panic("Octave call failed")
    print(compute.shape(output))
    print(compute.to_list(output))
    scale.close(^session)
}
