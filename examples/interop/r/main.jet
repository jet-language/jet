use r.ops as ops
use core.encoding.json as json
use core.data as data

#Codable
struct Score {
    label: String
    score: Float
}

fn run() =[R, IO]=> {
    session :: ops.open() ?? panic("R open failed")
    input :: DataTree.Object(["nested": DataTree.Object(["ok": DataTree.Bool(true)]), "vector": DataTree.Array([DataTree.Int(1), DataTree.Int(2)]), "scalar": DataTree.Float(3.5), "nothing": DataTree.Null])
    print(json.canonical(ops.transform(session, ~input, 5000) ?? panic("first call failed")))
    print(json.canonical(ops.transform(session, ~input, 5000) ?? panic("second call failed")))
    print(json.canonical(ops.double_values(session, DataTree.Array([DataTree.Int(2), DataTree.Int(4)]), 5000) ?? panic("vector call failed")))
    scores :: data.table([Score.{label: "a", score: 1.5}, Score.{label: "b", score: 2.0}])
    scaled :: ops.scale_table_table<Score>(session, scores, 5000) ?? panic("table call failed")
    loop row, data.rows(scaled) {
        print("{row.label}:{row.score}")
    }
    svg :: ops.plot_scores_plot(session, DataTree.Object(["values": DataTree.Array([DataTree.Int(2), DataTree.Int(5), DataTree.Int(3)])]), 5000) ?? panic("plot call failed")
    print(svg.starts_with("<svg "))
    print(svg.contains("Jet and R") || svg.contains("glyph-"))
    failed :: ops.fail_call(session, DataTree.Null, 5000) ?? DataTree.Text("failed")
    print(json.canonical(failed))
    timed :: ops.sleep_call(session, DataTree.Int(1), 100) ?? DataTree.Text("timeout")
    print(json.canonical(timed))
    ops.close(^session)
}
