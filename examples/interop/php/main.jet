use php.ops as ops
use core.encoding.json as json

fn run() =[Php, Io]=> {
    pool :: ops.open() ?? panic("PHP pool open failed")
    input :: DataTree.Object(["nested": DataTree.Object(["ok": DataTree.Bool(true)]), "list": DataTree.Array([DataTree.Int(1), DataTree.Text("two")]), "scalar": DataTree.Float(3.5), "nothing": DataTree.Null])
    print(json.canonical(ops.transform(pool, ~input, 5000) ?? panic("call failed")))
    print(json.canonical(ops.transform(pool, ~input, 5000) ?? panic("call failed")))
    print(json.canonical(ops.transform(pool, ~input, 5000) ?? panic("call failed")))
    print(json.canonical(ops.transform(pool, ~input, 5000) ?? panic("call failed")))
    print(json.canonical(ops.transform(pool, ~input, 5000) ?? panic("call failed")))
    failed :: ops.fail_call(pool, DataTree.Null, 5000) ?? DataTree.Text("failed")
    print(json.canonical(failed))
    timed :: ops.sleep_call(pool, DataTree.Int(1), 100) ?? DataTree.Text("timeout")
    print(json.canonical(timed))
    ops.close(^pool)
}
