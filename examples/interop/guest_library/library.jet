#Import(c) fn host_reenter(value: Int) Int = "host_reenter"
#Export(c) pub fn on_tick(dt: Int) Int -> dt + 1
#Export(c) pub fn is_enabled(flag: Bool) Bool -> flag
#Export(c) pub fn greet(name: String) String -> "hello, {name}!"
#Export(c) pub fn reenter(value: Int) Int -> host_reenter(value)
#Export(c) pub fn panic_now(value: Int) Int -> panic("guest panic {value}")
