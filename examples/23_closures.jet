// M8: lambdas and closure-powered list methods.
fn main() {
    val nums = [1, 2, 3, 4, 5];
    val squares = nums.map((n: Int) => (n * n));
    val big = squares.filter((n) => (n > 5));
    print(big);
    val total = nums.reduce(0, (acc: Int, n: Int) => (acc + n));
    print(total);
    var words = ["pear", "apple", "fig"];
    words.sort_by((w: String) => w.len());
    print(words);
}
