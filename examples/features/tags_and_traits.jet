// D-QUAL2: the two kinds of qualifier. A `trait` has at least one method and
// dispatches via a vtable; a `tag` has no methods and erases at runtime. The
// beginner rule is one sentence: methods → trait, no methods → tag.
//
// Here `Reviewed` and `Internal` are marker tags — they carry no methods and
// generate no code. `Greeter` is a trait, because it has a method to dispatch.

tag Reviewed;

tag Internal {}

trait Greeter {
    fn greet(self) -> String;
}

struct Doc {
    title: String,
}

impl Doc: Greeter {
    fn greet(self) -> String {
        return "reviewing: {self.title}";
    }
}

fn main() {
    d @= Doc.{ title: "spec" };
    print(d.greet());
}
