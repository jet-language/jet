// D-AUTOPAR1=A: explicit parallel iterator adapters.
// par_map/par_filter preserve order; par_fold is associative.
fn double(n: Int) -> Int { return n * 2 }
fn is_even(n: Int) -> Bool { return n % 2 == 0 }

fn main() {
    nums: [Int] @= [1, 2, 3, 4, 5]

    // par_map: double each element in parallel.
    doubled @= nums.par_map((n: Int) => n * 2)
    print(doubled)

    // par_filter: keep even numbers.
    evens @= nums.par_filter((n: Int) => n % 2 == 0)
    print(evens)

    // par_fold: sum all elements (associative).
    total @= nums.par_fold(0, (acc: Int, n: Int) => acc + n)
    print(total)
}
