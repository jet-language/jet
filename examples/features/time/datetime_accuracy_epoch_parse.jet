use core.time as time

fn parse_status(text: String) String -> {
    if time.parse_rfc3339(text) == {
        .Ok(value) -> { return "accepted|{value.format_rfc3339()}" }
        .Err(_) -> { return "rejected" }
    }
    return "rejected"
}

