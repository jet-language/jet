use core.time as time

// Time values use one equality and ordering contract in every execution tier.
fn run() {
    early :: DateTime{"2024-02-29T23:58:57Z"}
    late :: DateTime{"2024-03-01T00:00:00Z"}
    early_date :: early.date()
    late_date :: late.date()
    morning :: time.time(1, 2, 3)
    evening :: time.time(20, 30, 40)
    short :: 1s
    long :: 2s
    first_instant :: time.instant()
    second_instant :: time.instant()
    early_zoned :: time.zoned(early, time.utc())
    late_zoned :: time.zoned(late, time.utc())

    print(early == late)
    print(early < late)
    print(early_date == late_date)
    print(early_date < late_date)
    print(morning == evening)
    print(morning < evening)
    print(short == long)
    print(short < long)
    print(first_instant == first_instant)
    print(first_instant <= second_instant)
    print(early_zoned == late_zoned)
    print(early_zoned < late_zoned)

    datetimes := [DateTime]{late, early}
    datetimes.sort()
    loop value in datetimes {
        print(value.to_string())
    }

    dates := [LocalDate]{late_date, early_date}
    dates.sort()
    loop value in dates {
        print(value.to_string())
    }
}
