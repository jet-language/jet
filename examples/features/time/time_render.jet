use core.time as time

fn run() {
    datetime :: time.datetime(2024, 3, 1, 12, 34, 56)
    duration :: 2s
    local_date :: datetime.date()
    local_time :: datetime.time()
    zone :: time.utc()
    zoned :: time.zoned(datetime, zone)
    datetimes :: [DateTime]{~datetime}
    durations :: [Duration]{~duration}

    print("DateTime: {datetime} | {datetime:Debug} | {datetime:Pretty}")
    print("Duration: {duration} | {duration:Debug} | {duration:Pretty}")
    print("LocalDate: {local_date} | {local_date:Debug} | {local_date:Pretty}")
    print("LocalTime: {local_time} | {local_time:Debug} | {local_time:Pretty}")
    print("Zone: {zone} | {zone:Debug} | {zone:Pretty}")
    print("ZonedDateTime: {zoned} | {zoned:Debug} | {zoned:Pretty}")
    print("Nested: {datetimes} | {durations}")
}
