use core.time as time

fn run() {
    early :: DateTime{"2024-02-29T23:58:57Z"}
    late :: DateTime{"2024-03-01T00:00:00Z"}
    early_date :: early.date()
    late_date :: late.date()
    early_time :: early.time()
    late_time :: late.time()
    short :: Duration.milliseconds(500) ?? return Err("short")
    long :: Duration.seconds(1) ?? return Err("long")

    print(early < late)
    print(early_date < late_date)
    print(early_time < late_time)
    print(short < long)
    print(early == early)
    print(early_date == early_date)
    print(early_time == early_time)
    print(short == short)
}
