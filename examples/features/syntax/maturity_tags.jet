// D-MATURITY1=B: `@Experimental` / `@Tested` / `@Hardened` are doc-only
// stability tags. Parsed and formatter-preserved; zero sema/codegen effect.
@Experimental fn experimental_label() -> String {
    return "exp"
}

@Tested fn tested_label() -> String {
    return "tested"
}

@Hardened fn hardened_label() -> String {
    return "hard"
}

fn run() {
    print(experimental_label())
    print(tested_label())
    print(hardened_label())
}
