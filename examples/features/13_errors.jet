// 13 — Errors as values (M4, S34/S35/S36/S7).
enum ParseError {
    Empty;
    BadDigit(String);
}
fn parse_age(raw: String) -> Int ? ParseError {
    if raw == "" {
        return err(ParseError.Empty);
    }
    if raw == "x" {
        return err(ParseError.BadDigit(raw));
    }
    return ok(42);
}
fn load() -> Int ? ParseError {
    val n = parse_age("7")?;
    return ok((n * 2));
}
fn main() {
    val a = parse_age("42") ?? 0;
    print(a);
    val doubled = load() ?? 0;
    print(doubled);
    when parse_age("x") {
        | it == ok(n) {
            print(n);
        }
        | it == err(e) {
            print(e);
        }

    }
}
