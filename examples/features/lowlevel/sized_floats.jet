// D-FLOATW1 (ratified 2026-06-22): sized-float math is precision-correct.
// `sqrt(F32) -> F32`, `sqrt(Float) -> Float` — the math functions are
// width-generic. F32 is a real precision choice, not just storage; there is no
// silent widening to F64. Mixing widths (`F32` + `Float`) is a compile error.
use core.math as math

fn run() {
    // Float (= F64) math — full 64-bit precision.
    root64: Float :: math.sqrt(4.0)
    print(root64)
    // F32 math — 32-bit precision, NOT silently promoted.
    root32: F32 :: math.sqrt(9.0)
    print(root32)
    // Width conversions are destination-owned and explicit (D-SHAPE-CONVERT1).
    x: F32 :: 2.0
    wide: Float :: Float.from_f32(x)
    print(math.sqrt(wide))
    // pow, floor, ceil are also width-generic.
    p64: Float :: math.pow(2.0, 10.0)
    print(p64)
    f32_val: F32 :: 2.7
    print(math.floor(f32_val))
    print(math.ceil(f32_val))
}
