// Card #239 / D-TARGET-*: freestanding core-only sample.
// Hosted ceremony stays off. Board profiles live beside the build
// (`board.sensor_v1`, `board.virt_aarch64`) and reject OS APIs (E3301).
//
// Build (hosted freestanding check):
//   jet build --freestanding examples/features/lowlevel/target_profile_board.jet
//
// Firmware proof (linker/map/audit/QEMU) is exercised by tests/target_profiles.rs.
use core.math as math

fn clamp(x: Int, lo: Int, hi: Int) -> Int {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

fn run() {
    a :: clamp(15, 0, 10)
    b :: clamp((-3), 0, 10)
    root :: math.sqrt(16.0)
    print("target-profile: clamp(15,0,10)={a}, clamp(-3,0,10)={b}, sqrt(16)={root}")
}
