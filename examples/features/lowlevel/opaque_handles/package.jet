name: "opaque_handles"
version: "0.1.0"
description: "Generated C handles for zlib and HarfBuzz shaping"
edition: "2026"
authority: {
    holds: {
        allow: [FFI, IO],
    },
}
license: "MIT OR Apache-2.0"
deps: {
    // `z` is the native linker name; nixpkgs calls the provider `zlib`.
    z: c@nixpkgs:zlib,
    harfbuzz: c@nixpkgs:harfbuzz,
}
