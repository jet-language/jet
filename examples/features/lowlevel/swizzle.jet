// D-SWIZZLE1 (ratified 2026-06-27): named lane swizzles on vector/SIMD types.
// Read patterns reorder/extract lanes; write patterns assign in one statement.
// Overlapping writes (`v.xx = …`) are rejected at compile time (E3111).

fn main() {
v: Vec3 :: Vec3(1.0, 2.0, 3.0)
    print(v.x)                    // 1.0
    print(v.yz.to_array())        // [2.0, 3.0]

flipped: Vec2 :: v.yx
    print(flipped.to_array())     // [2.0, 1.0]

col: Vec4 :: Vec4(1.0, 0.5, 0.2, 1.0)
rgb: Vec3 :: col.xyz
    print(rgb.to_array())         // [1.0, 0.5, 0.2]

rev: Vec4 :: col.wzyx
    print(rev.to_array())         // [1.0, 0.2, 0.5, 1.0]

    pos := Vec3(10.0, 20.0, 30.0)
    pos.xy = Vec2(0.0, 0.0)
    print(pos.to_array())         // [0.0, 0.0, 30.0]

lanes: F32x4 :: F32x4(1.0, 2.0, 3.0, 4.0)
    print(lanes.x)                // 1.0
pair: Vec2 :: lanes.xy
    print(pair.to_array())        // [1.0, 2.0]

    d := F64x2(5.0, 6.0)
    d.yx = F64x2(7.0, 8.0)
    print(d.to_array())           // [8.0, 7.0]
}
