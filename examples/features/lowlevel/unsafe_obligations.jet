use core.mem

fn run() {
    cell: Int :: 1337
    #Unsafe("cell stays live and the pointer remains local", obligations: .Track) {
        pointer: *Int :: *cell
        assert no_alias
        print(pointer.*)
        assert valid_ptr, aligned
        observed: Int :: mem.volatile_read(pointer)
        assert valid_ptr, aligned
        print(observed)
    }
}
