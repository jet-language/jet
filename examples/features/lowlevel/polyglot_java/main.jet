// Run `jet inspect bind java Counter.java --pkg counter`, then `jet run main.jet`.
use java.counter as counter

// Panic is declared: a missing JVM is unrecoverable for this demo (D-NOPANIC1=D).
fn run() =[Java, IO, Panic]=> {
    handle :: counter.new(40) ?? panic("JVM create failed")
    print(counter.add(handle, 2) ?? -1)
    print(counter.twice(2.5) ?? -1.0)
    print(counter.explode(handle, -1) ?? -7)
    counter.close(^handle)
}
