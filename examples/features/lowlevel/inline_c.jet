package {
    name: "lowlevel_inline_c"
    version: "0.1.0"
    authority: { holds: { allow: [Exec, FFI, IO, Mem.Alloc] } }
}

#[Unsafe("the scalar ABI contract matches the C definition"), FFI(c)] fn add(a: Int, b: Int) Int -> {
    """int64_t add(int64_t a, int64_t b) { return a + b; }"""
}

fn jet_add(a: Int, b: Int) Int -> (a + b)

#[Unsafe("the scalar ABI contract deliberately returns a mismatched result"), FFI(c)] fn wrong_add(a: Int, b: Int) Int -> {
    """int64_t wrong_add(int64_t a, int64_t b) { return a + b + 1; }"""
}

fn run() {
    #Unsafe("call the audited inline C contract") {
        print(add(20, 22))
    }
}

#Test("inline C Int comparisons") {
    loop n in -100..100 {
        #Unsafe("call the audited inline C contract with bounded Int values") {
            assert_eq(add(n, 22), jet_add(n, 22))
            assert((add(n, 22) == jet_add(n, 22)))
        }
    }
    .expect_fail {
        #Unsafe("call the audited inline C contract with a deliberately wrong C result") {
            assert_eq(wrong_add(20, 22), jet_add(20, 22))
        }
    }
}
