// Run `jet inspect bind cs Counter.cs --pkg counter`, then `jet run run.jet`.
use cs.counter as counter

// Panic is deny-only; this demo handles the fallible bridge results locally.
fn run() {
    handle :: counter.new(40) ?? panic("CoreCLR create failed")
    print(counter.add(handle, 2) ?? -1)
    print(counter.twice(2.5) ?? -1.0)
    print(counter.explode(handle, -1) ?? -7)
    counter.close(^handle)
}
