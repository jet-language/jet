package {
    name: "lowlevel_inline_asm"
    version: "0.1.0"
    authority: { holds: { allow: [Exec, FFI, IO, Mem.Alloc] } }
}

use core.mem

#[Unsafe("the operands are scalar registers and add does not access memory"), FFI(asm)] fn add_registers(a: Int, b: Int) Int -> {
    """add {a}, {b} ; -> return"""
}

fn run() {
    #Unsafe("call the audited register-only assembly contract") {
        print(add_registers(20, 22))
    }
}
