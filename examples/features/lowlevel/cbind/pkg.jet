name: "cbind_demo"
version: "0.1.0"
description: "Binding a C header end to end (S59 / E2-M14)"
license: "MIT OR Apache-2.0"

// `c@system` names the C standard library for the link line (`-l c`). libc has
// no `c.pc`, so resolution falls back to a bare `-l c` — which the Rust backend
// already links anyway. A third-party lib would use `name: c@"vendor/path"`.
deps: {
    c: c@system,
}
