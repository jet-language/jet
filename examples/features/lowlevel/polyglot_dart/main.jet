// Run `jet inspect bind dart callbacks.dart --jet main.jet --pkg callbacks`,
// then `dart run host.dart` from the generated project.
use dart.callbacks as callbacks

pub fn compute(value: Int) Int -[FFI.Dart]> {
    return callbacks.dart_double(value) ?? -1
}

pub fn compute_float(value: Float) Float -[FFI.Dart]> {
    return callbacks.dart_half(value) ?? -1.0
}
