// 110 — transaction blocks (D-TXN1–D-TXN4).
// `#Transact(name) { … }` opens a transaction. `name.on_commit(() => { … })`
// registers a post-commit hook: it runs LIFO on a clean commit, and is dropped
// (never run) on a `?`-failure. An irreversible effect (Net/Fs/Exec) directly in
// the block is rejected (E0746) — register it on the handle to defer it instead.
enum Fail {
    Empty
}

// A clean transaction: both hooks fire LIFO after the block commits.
fn place_order(items: Int) -> Int ? Fail {
    #Transact(order) {
        print("reserving stock")
        order.on_commit(() => {
            print("commit hook 1: charge card")
        })
        order.on_commit(() => {
            print("commit hook 2: send receipt")
        })
        if items == 0 {
            // `?`-failure: the block never commits, so the hooks are dropped un-run.
            return err(Fail.Empty)
        }
        print("stock reserved")
    }
    return ok(items)
}

fn main() {
    print("=== success path ===")
    n @= place_order(3) ?? (-1)
    print(n)
    print("=== failure path (hooks dropped) ===")
    m @= place_order(0) ?? (-1)
    print(m)
}
