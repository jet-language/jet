// D-ENCSTREAM-SURFACE1=A: bounded CBOR reader/writer lifecycle.
use core.encoding as encoding
use core.encoding.cbor as cbor
use core.files as files

fn write_catalog(path: Path) ? {
    output :: files.create(path)?
    writer :: cbor.writer(^output, encoding.EncodingLimits.safe())?
    writer.write(encoding.DataEvent.ObjectStart)?
    writer.write(encoding.DataEvent.Key("ok"))?
    writer.write(encoding.DataEvent.Bool(true))?
    writer.write(encoding.DataEvent.ObjectEnd)?
    writer.flush()?
    writer.finish()?
}

fn run() ? {
    // Scratch output belongs in a fresh temp directory, never the working
    // directory the example happens to run from.
    scratch :: files.temp_dir("jet-encoding-cbor")?
    path :: Path.from(scratch.path).join("catalog.cbor")
    write_catalog(path)?
    input :: files.open(path)?
    reader :: cbor.reader(^input)?
    loop event, reader {
        print("event")
    }
    print("eof")
}
