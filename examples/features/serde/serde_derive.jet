// 55 — #Codable derive (D-SERDE): encode a struct to JSON and typed-decode back.
// One marker, both directions; #Rename sets a field's wire key; an absent
// optional is omitted on the wire.
use core.encoding.json as json

#Codable
struct Order {
    id: Int
    #Rename("customer") who: String
    items: [String]
    note: String?
}

fn run() {
    o :: Order.{id: 7, who: "Ada", items: ["pen", "ink"], note: None}
    print(json.to_string(o))
    raw :: "{{\"id\":9,\"customer\":\"Bo\",\"items\":[\"ink\"],\"note\":\"rush\"}}"
    back :: json.decode<Order>(raw) ?? panic("bad order")
    print(back.who)
    print(back.note ?? "(none)")
}
