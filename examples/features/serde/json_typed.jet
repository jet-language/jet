// D-JSON-EXACTNUM1: typed JSON keeps Decimal and Int number tokens exact.
use core.encoding.json as json

#Codable
struct Address {
    city: String
    zip: String
}

#[Codable, RenameAll(camel)]
struct Person {
    full_name: String
    home_address: Address
    nicknames: [String]
    age: Int
}

#Codable
struct ExactNumbers {
    amount: Decimal
    exponent: Decimal
    whole: Decimal
    tenth: Decimal
    tenth_with_zero: Decimal
    scientific_tenth: Decimal
    adjacent_lo: Int
    adjacent_hi: Int
    large: Int
    large_exp: Int
}

fn run() ? [FieldError] {
    raw :: "{{\"fullName\":\"Ada\",\"homeAddress\":{{\"city\":\"Reno\",\"zip\":\"89501\"}},\"nicknames\":[\"Addy\"],\"age\":36}}"
    p :: json.decode<Person>(raw)?
    print(p.full_name)
    print(p.home_address.city)
    print(p.nicknames.len())
    print(json.to_string(p))
    // Beginner default: Decimal preserves scale; Int preserves whole values.
    exact_raw :: "{{\"amount\":12.340,\"exponent\":1E-5,\"whole\":100,\"tenth\":0.1,\"tenth_with_zero\":0.10,\"scientific_tenth\":1e-1,\"adjacent_lo\":9007199254740992,\"adjacent_hi\":9007199254740993,\"large\":12345678901234567890123456789012345678901234567890,\"large_exp\":1e30}}"
    exact :: json.decode<ExactNumbers>(exact_raw)?
    print(exact.amount.to_string())
    print(exact.exponent.to_string())
    print(exact.whole.to_string())
    print(exact.tenth.to_string())
    print(exact.tenth_with_zero.to_string())
    print(exact.scientific_tenth.to_string())
    print(exact.adjacent_lo.to_string())
    print(exact.adjacent_hi.to_string())
    print(exact.large.to_string())
    print(exact.large_exp.to_string())
    // Expert policy: use fixed-width I64 for a bounded wire range.
}
