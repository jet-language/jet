// 57 — typed JSON round-trip (D-SERDE): nested struct + list + optional, with a
// camelCase wire via #RenameAll.
use core.encoding.json as json

#Codable
struct Address {
    city: String
    zip: String
}

#[Codable, RenameAll(camel)]
struct Person {
    full_name: String
    home_address: Address
    nicknames: [String]
    age: Int?
}

#Codable
struct ExactNumbers {
    amount: Decimal
    exponent: Decimal
    whole: Decimal
    large: Int
}

fn run() ? [FieldError] {
    raw :: "{{\"fullName\":\"Ada\",\"homeAddress\":{{\"city\":\"Reno\",\"zip\":\"89501\"}},\"nicknames\":[\"Addy\"],\"age\":36}}"
    p :: json.decode<Person>(raw)?
    print(p.full_name)
    print(p.home_address.city)
    print(p.nicknames.len())
    print(json.to_string(p))
    exact_raw :: "{{\"amount\":12.340,\"exponent\":1E-5,\"whole\":100,\"large\":123456789012345678901234567890}}"
    exact :: json.decode<ExactNumbers>(exact_raw)?
    print(exact.amount.to_string())
    print(exact.exponent.to_string())
    print(exact.whole.to_string())
    print(exact.large.to_string())
}
