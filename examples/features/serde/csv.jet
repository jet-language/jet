// E2-M9: jet.csv — parse and clean a CSV table.
use core.encoding.csv as csv

// D-FAIL-CONV1: csv.parse fails as String; name the rail instead of a default Err.
fn run() String! {
    raw :: "name,score,grade\nAlice,95,A\nBob,\"82\",B\nCarol,71,C"
    rows :: csv.parse(raw)?
    loop row in rows {
        name :: row[0]
        score :: row[1]
        print("{name}: {score}")
    }
    rebuilt :: csv.to_string(rows)
    print(rebuilt.len() > 0)
}
