// D-SERDE2=A: hand-written and derived codecs share one public protocol.
// Email owns a bare-string wire form; Signup's generated codec composes it.
use core.encoding.json as json

struct Email {
    address: String
}

impl Email.Encode {
    fn encode(self) => DataTree :: DataTree.Text(~self.address)
}

impl Email.Decode {
    fn decode(tree: DataTree) => Email ? [FieldError] {
        address :: tree.text()?
        if !address.contains("@") {
            return Err([FieldError.{path: "", reason: "not a valid email: {address}"}])
        }
        return Ok(Email.{address: address})
    }
}

#Codable
struct Signup {
    name: String
    email: Email
}

fn run() {
    signup :: Signup.{name: "Ada", email: Email.{address: "ada@lovelace.org"}}
    wire :: json.to_string(signup)
    print(wire)
    decoded :: json.decode<Signup>(wire) ?? panic("decode failed")
    print(decoded.email.address)
}
