// 128 — D-METADERIVE1=A: user-authored derive + D-METAREFLECT1=B: T.reflect()
// Demonstrates: derive bodies are checked Jet items with typed holes.
// D-MARK-DEBUG1=A: `Debug` itself is retired as an explicit-derive spelling
// (built-in Debug auto-derives, E0922 if written) — a user-authored derive
// provider can't reuse that name either, so this demo names its own
// `DebugText`.
derive T.DebugText {
    fn debug_string(self) => String :: T.@name;
}

#DebugText
struct Point {
    x: Int
    y: Int
}

fn run() {
    p :: Point.{x: 3, y: 4}
    print(p.debug_string())
}
