// D-MIGRATE1: #PublishedSchema struct + migration rename block.
//
// A published record's field layout is locked at release — readers of
// old serialised data must still work. When a field is renamed, a
// `migration` block tells the compiler how old data maps to the new shape.
//
// This package (version 1.3.0) renames `name` -> `display_name`.
// The canonical fixture is `fixture-state/cache/schema/UserRecord.snapshot`.
// The golden harness stages it as `.jet/cache/schema` in an external scratch
// project, keeping measured/source state out of the checkout.
#PublishedSchema struct UserRecord {
    display_name: String
    age: Int
}

migration UserRecord {
    rename name -> display_name
}

fn run() {
    u :: UserRecord{display_name: "Alice", age: 30}
    print("user: {u.display_name}, age: {u.age}")
}
