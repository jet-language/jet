// 56 — typed CSV round-trip → struct → JSON (D-SERDE; the c89+c90 pipeline).
// `csv.decode<Sale>` maps columns to fields by header name; `csv.to_string`
// writes the same values back, and one derive re-emits them as JSON. A failed
// decode is one printable value: the accumulated `[FieldError]` list
// (D-VALIDATE-DECODE1=B) renders every element's path and reason in a single
// interpolation hole.
use core.encoding.csv as csv
use core.encoding.json as json

#Codable
struct Sale {
    item: String
    qty: Int
}

fn run() ? [FieldError] {
    raw :: "item,qty\npen,3\nink,5"
    sales :: csv.decode<Sale>(raw)?
    total := 0
    loop s, sales :> total += s.qty
    print("rows: {sales.len()}")
    print("total qty: {total}")
    print(csv.to_string(sales))
    print(json.to_string(sales))
    // Every row that fails accumulates instead of stopping the decode, and the
    // whole list prints in one hole — no hand loop over `.path`/`.reason`.
    bad_raw :: "item,qty\npen,x\nink,y"
    attempted :: csv.decode<Sale>(bad_raw)
    if attempted == {
        .Ok(rows) :> print("decoded {rows.len()} rows")
        .Err(errs) :> print("{errs}")
    }
}
