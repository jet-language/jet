// 56 — typed CSV round-trip → struct → JSON (D-SERDE; the c89+c90 pipeline).
// `csv.decode<Sale>` maps columns to fields by header name; `csv.to_string`
// writes the same values back, and one derive re-emits them as JSON.
use core.encoding.csv as csv
use core.encoding.json as json

#Codable
struct Sale {
    item: String
    qty: Int
}

fn run() ? {
    raw :: "item,qty\npen,3\nink,5"
    sales :: csv.decode<Sale>(raw)?
    total := 0
    loop s, sales { total += s.qty }
    print("rows: {sales.len()}")
    print("total qty: {total}")
    print(csv.to_string(sales))
    print(json.to_string(sales))
}
