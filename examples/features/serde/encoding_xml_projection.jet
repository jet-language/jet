// D-ENCXML-PROJECTION1=A: typed decode + focused tree helpers.
use core.encoding.xml as xml

#Codable
struct Catalog {
    book: [Book]
}

#Codable
struct Book {
    #Rename("@id") id: String
    title: String
    price: Price
}

#Codable
struct Price {
    #Rename("@currency") currency: String
    #Rename("$text") amount: String
}

fn run() {
    source :: "<catalog><book id=\"7\"><title>Hi</title><price currency=\"USD\">9</price></book><book id=\"8\"><title>Lo</title><price currency=\"EUR\">3</price></book></catalog>"
    document :: xml.parse(source) ?? panic("parse")
    root :: xml.root(document) ?? panic("root")
    name :: xml.expanded_name(root) ?? panic("name")
    print(name.local)
    print((xml.attribute(root, "id") ?? panic("attr")) ?? "missing")
    children :: xml.content(root) ?? panic("content")
    loop child; children {
        child_name :: xml.expanded_name(child) ?? panic("child")
        print(child_name.local)
        print((xml.attribute(child, "id") ?? panic("child attr")) ?? "missing")
    }
    catalog :: xml.decode<Catalog>(source) ?? panic("decode")
    print(catalog.book.len())
    print(catalog.book[0].id)
    print(catalog.book[0].title)
    print(catalog.book[0].price.currency)
    print(catalog.book[0].price.amount)
    wire :: xml.to_bytes(document) ?? panic("bytes")
    again :: xml.decode_bytes<Catalog>(wire) ?? panic("decode_bytes")
    print(again.book[1].title)
}
