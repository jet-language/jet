// D-ENCBASE-STRICT1: edition 2026 compatibility union for transport-shaped input.
use core.encoding.base64 as base64
use core.encoding.base32 as base32

fn run() {
    mime := base64.decode("Zg==\n") ?? panic("mime")
    print(mime.len())
    legacy := base32.decode("my======") ?? panic("legacy")
    print(legacy.len())
}
