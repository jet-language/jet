// D-ENCSTREAM-SURFACE1=A: bounded CSV reader/writer lifecycle.
use core.encoding as encoding
use core.encoding.csv as csv
use core.files as files

fn write_catalog(path: Path) ? {
    output :: files.create(path)?
    writer :: csv.writer(^output, encoding.EncodingLimits.safe())?
    writer.write(["ok", "true"])?
    writer.flush()?
    writer.finish()?
}

fn run() ? {
    // Scratch output belongs in a fresh temp directory, never the working
    // directory the example happens to run from.
    scratch :: files.temp_dir("jet-encoding-csv")?
    path :: Path.from(scratch.path).join("catalog.csv")
    write_catalog(path)?
    input :: files.open(path)?
    reader :: csv.reader(^input)?
    loop record, reader {
        print("record")
    }
    print("eof")
}
