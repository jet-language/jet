// D-ENCSTREAM-SURFACE1=A: bounded CSV reader/writer lifecycle.
use core.encoding as encoding
use core.encoding.csv as csv
use core.files as files
use core.path as path

fn write_catalog(path: String) {
    output :: files.create(path) ?? panic("create")
    writer :: csv.writer(^output, encoding.EncodingLimits.safe()) ?? panic("writer")
    writer.write(["ok", "true"]) ?? panic("record")
    writer.flush() ?? panic("flush")
    writer.finish() ?? panic("finish")
}

fn run() {
    // Scratch output belongs in a fresh temp directory, never the working
    // directory the example happens to run from.
    scratch :: files.temp_dir("jet-encoding-csv") ?? panic("temp_dir")
    path :: path.join(scratch.path, "catalog.csv")
    write_catalog(path)
    input :: files.open(path) ?? panic("open")
    reader :: csv.reader(^input) ?? panic("reader")
    count := 0
    loop count < 3 {
        maybe :: reader.next() ?? panic("next")
        if maybe == .None {
            print("eof")
            break
        }
        print("record")
        count++
    }
}
