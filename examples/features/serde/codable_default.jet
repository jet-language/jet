// Card #131 / D-FIELDDEF1=C — a non-primitive `=` default fills a missing field with the
// EXACT value it names, on both the compiled binary and `jet run` (I9). The
// argument is evaluated once at compile time; a list/struct/enum default no
// longer silently degrades to an empty/zero value.
use core.encoding.json as json

// D-META-AUTO1=A — structurally eligible structs are Codable by default.
struct Config {
    name: String
    ports: [Int] = [80, 443]
    env: String = "prod"
}

fn run() ! [FieldError] {
    // `ports` and `env` are absent on the wire → both defaults apply.
    c :: json.decode<Config>("{{\"name\":\"web\"}}")?
    // No derive marker is needed for the generated Codable body.
    print(json.to_string(c))
    print(c.name, c.ports, c.env)
    // The same plain struct is encodable without a derive marker.
    print(json.to_string(c))
    // A wire value overrides the default.
    d :: json.decode<Config>("{{\"name\":\"api\",\"ports\":[8080]}}")?
    print(d.ports)
}
