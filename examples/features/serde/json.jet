use core.encoding.json as json

fn run() {
    raw :: "{{\"name\":\"jet\",\"ok\":true,\"items\":[1,2]}}"
    data :: json.parse(raw) ?? panic("bad json")
    print(json.to_string(data))
    print(json.to_string_pretty(data).contains("\n"))
    if data == .Object(entries) { print(entries.len()) }
    obj := [String: DataTree].{}
    obj["name"] = DataTree.Text("jet")
    obj["ok"] = DataTree.Bool(true)
    print(json.to_string(DataTree.Object(obj)))
}
