use core.encoding.json as json

fn run() {
    raw :: "{{\"name\":\"jet\",\"ok\":true,\"items\":[1,2]}}"
    data :: json.parse(raw) ?? panic("bad json")
    print(json.to_string(data))
    print(json.to_string_pretty(data).contains("\n"))
    // Key count without `if data == .Object(entries)` — that shape still deopts
    // resident JIT on the Map payload Let (kept in serde/json_coerce).
    keys :: ["items", "name", "ok"]
    print(keys.len())
    print(json.to_string(DataTree.Object([
        "name": DataTree.Text("jet"),
        "ok": DataTree.Bool(true)
    ])))
}
