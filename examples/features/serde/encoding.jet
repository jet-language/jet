// D-ENC1: one unified serialization library. `use core.encoding` gives you every
// format as a submodule — json, csv, toml, yaml — through one import. Each speaks the
// same verbs: `parse` (text → value) and `to_string` (value → text, D-JSONVERB1).
use core.encoding

fn run() ? {
    // JSON — parse a document, round-trip it back to compact text.
    data :: encoding.json.parse("{{\"lang\":\"jet\",\"stars\":5}}")?
    print(encoding.json.to_string(data))
    // CSV — rows in, rows out.
    rows :: encoding.csv.parse("name,score\nada,9\nlin,8")?
    print(encoding.csv.to_string(rows))
    // TOML — flat key/value config.
    cfg :: encoding.toml.parse("title = \"jet\"\nport = 8080")?
    print(encoding.toml.to_string(cfg))
    // YAML — same shape, different notation.
    y :: encoding.yaml.parse("host: localhost\nport: 9000")?
    print(encoding.yaml.to_string(y))
}
