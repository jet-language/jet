// D-SERDE-ACCESS=B: dynamic DataTree/JSON accessor methods
use core.encoding.json as json

fn run() ? {
    raw :: "{{\"user\":{{\"name\":\"Alice\",\"score\":42,\"active\":true}}}}"
    tree :: json.parse(raw)?
    user :: tree.field("user")?
    name :: user.field("name")?
    score :: user.field("score")?
    active :: user.field("active")?
    print(name.text()?)
    print(score.int()?)
    print(active.bool()?)
}
