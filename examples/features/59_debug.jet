// E2-M12: debugging and observability foundation.
// Demonstrates the E3001 rich panic report: Jet file/line, function name,
// source-line context box, and safe local values (Int/Float/Bool) in dev mode.
// D-OBS1 foundation — full DAP step-through is E2-M17.
fn summarize(rows: Int, path: String) {
    val count: Int = rows;
    require(count > 0, "no rows to summarize");
}

fn main() {
    summarize(0, "report.csv");
}
