agent:lock=jetpack_browser_lock
agent:connect=browser.connect_profile(endpoint,profile,timeout)
agent:beginner=get_by_role|text|label+wait+click|fill
agent:network=subscribe+add_intercept+continue|fail|fulfill
agent:artifacts=cookie+storage+set_files+screenshot+pdf
agent:expert=protocol(cdp)_after_capabilities.cdp
agent:privacy=receipt.redacted+isolated_profiles+explicit_close
agent:no_node_playwright_runtime
agent:timeout_ok:true
