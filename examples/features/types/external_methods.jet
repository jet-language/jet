struct Point {
    x: Int
    y: Int

    fn label(self) -> String {
        return "point"
    }
}

impl Point {
    fn dist2(self, other: Point) -> Int {
        dx :: self.x - other.x
        dy :: self.y - other.y
        return dx * dx + dy * dy
    }
}

impl Point {
    fn origin() -> Point {
        return Point.{x: 0, y: 0}
    }
}

fn main() {
    p :: Point.{x: 3, y: 4}
    o :: Point.origin()
    print(p.label())
    print(p.dist2(o))
}
