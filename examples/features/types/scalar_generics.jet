#Comparable
struct Score {
    points: Int
}

fn max_of<T: Comparable>(left: T, right: T) T -> if left > right -> ~left else -> ~right

fn copy_of<T>(value: T) T -> ~value

fn run() {
    print(max_of(3, 7))
    // Float has partial ordering, so it does not implement Comparable.
    print(copy_of(Float{2.5}))
    print(max_of(I64{4}, I64{2}))
    best :: max_of(Score{points: 11}, Score{points: 19})
    print(best.points)
}
