// D-REFINE1: `@Invariant` refines a distinct Int through a pure linear bounds
// proof. D-OOBPROOF1 lets fixed-size-list indexing use the carried proof.
@Invariant("value >= 0 && value < 4")
Index4 :: distinct Int

fn pick(xs: [String#4], i: Index4) -> String {
    return xs[i]
}

fn checked(raw: Int) -> Index4 ? String {
    return ok(Index4(raw)?)
}

fn run() {
    idx :: Index4(2)
    words: [String#4] :: ["zero", "one", "two", "three"]
    print(pick(words, idx))
    from_runtime :: checked(3) ?? Index4(0)
    print(pick(words, from_runtime))
}
