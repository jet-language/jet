// D-DYNAMIC-TYPE1=A: Jet has no top type like Any.
// Pick the precise mechanism: enum for known variants, generics for abstraction,
// T? for absence, and DataTree for parsed dynamic input.
use core.encoding.json as json

enum Payload {
    Name(String)
    Count(Int)
}

fn echo<T>(value: T) -> T { return ~value }

fn label(payload: Payload) -> String {
    if payload == {
        .Name(s) -> { return ~s }
        .Count(n) -> { return "{n}" }
    }
}

fn run() {
    p :: Payload.Count(3)
    print(label(p))
    print(echo("typed"))
    maybe :: Val("present")
    if maybe == .Val(s) { print(s) }
    data :: DataTree.{json.parse("{{\"name\":\"jet\"}}") ?? panic("bad json")}
    if data == .Object(entries) {
        if entries["name"] == .Text(name) { print(name) }
    }
}
