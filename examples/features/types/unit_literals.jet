// D-UNITLIT1: a numeric literal may carry a unit suffix resolving to a
// Time literals are members of the canonical Prelude Time family. They
// elaborate to Duration's checked i64-nanosecond carrier.
use core.math.[abs]

fn run() {
    a :: 500ms
    b :: 200ms
    total :: a + b
    print(total)

    z :: 3 + 4i
    print(z * z)
    print(abs(z))

    i :: 9
    print(i)
}
