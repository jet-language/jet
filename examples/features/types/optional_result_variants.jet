// D-SHAPE3b: Optional and Result use one PascalCase variant law.
fn optional(flag: Bool) => Int? {
    return if flag -> .Val(7) else -> .None
}

fn result(flag: Bool) => Int ? String {
    return if flag -> .Ok(9) else -> .Err("no")
}

fn run() {
    if optional(true) == {
        .Val(value) -> print(value)
        .None -> print(0)
    }

    if result(false) == {
        .Ok(value) -> print(value)
        .Err(error) -> print(error)
    }
}
