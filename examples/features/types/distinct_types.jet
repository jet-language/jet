// 69 — Distinct types (D-DIST1, D-DIST3).
// `Name :: distinct Base` creates a named type that never implicitly
// coerces to/from its base. Construct with `Name(expr)`, unwrap with `.raw()`.
// `@Numeric` enables same-type arithmetic.
UserId :: distinct Int;

@Numeric Meters :: distinct Float;

fn greet(id: UserId) {
    print("user {(id.raw())}")
}

fn run() {
    uid :: UserId(42)
    greet(uid)
    a :: Meters(3.0)
    b :: Meters(1.5)
    c :: a + b
    print("{(c.raw())} m")
    // equality on same distinct type works
    x :: UserId(7)
    y :: UserId(7)
    print("{(x == y)}")
}
// --- expected output --------------------------------------------------
// user 42
// 4.5 m
// true
