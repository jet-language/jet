// D-QUAL4=A: `#Marker T` is a value-tag qualifier in type position.
// The tag documents intent (e.g., "this string is untrusted") without
// changing the runtime type — the underlying value is still a plain T.
fn tag_score(rating: @Raw Int) -> Int {
    return rating * 2
}

fn show_pair(label: @Locale String, value: @Sanitized String) -> String {
    return "{label}: {value}"
}

fn run() {
    score :: tag_score(21)
    line :: show_pair("Name", "Alice")
    print("{score}")
    print(line)
}
