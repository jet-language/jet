// D-DOTCTOR2/3: list elements infer one type from a named head or annotation.
struct Fighter {
    name: String
    hp: Int
}

fn run() {
    headed :: [Fighter.{name: "Ada", hp: 10}, .{name: "Bo", hp: 8}, .{name: "Cy", hp: 6}]
    annotated :: [Fighter].{.{name: "Dee", hp: 7}, .{name: "Eli", hp: 5}}
    print("{headed[0].name}:{headed.len()}")
    print("{annotated[1].name}:{annotated.len()}")
}
