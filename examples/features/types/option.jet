// 12 — Option with pattern tests and flow narrowing (M3, S32/S31, D-FLOWTYPE1=A).
fn find_even(limit: Int) => (Int?) {
    loop i; 1..limit {
        if (i % 2) == 0 { return Val(i) }
    }
    return None
}

fn describe(n: Int?) => String {
    // D-FLOWTYPE1=A: a stable immutable Optional narrows after a None check.
    if n != None {
        return "got {n}"
    }
    return "none"
}

fn run() {
    if find_even(9) == .Val(n) { print(n) }
    if find_even(1) == .None { print("absent") }
    print(describe(Val(4)))
    print(describe(None))
}
