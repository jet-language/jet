// 12 — Option with pattern tests (M3, S32/S31).
fn find_even(limit: Int) -> (Int?) {
    loop i; 1..limit {
        if (i % 2) == 0 {
            return Val(i)
        }
    }
    return None
}

fn run() {
    if find_even(9) == .Val(n) {
        print(n)
    }
    if find_even(8) == .None {
        print("none")
    }
}
