// 112 — Unit families (D-QUAL3).
// `#UnitFamily(Name) { a, b, … }` mints one distinct `#Numeric` type per
// member — `usd` becomes the type `Usd`, erasing to `Float`. Signatures then
// read in plain English, and the compiler keeps the units from mixing.
// This is sugar over distinct types (D-DIST1/D-DIST3): convert with
// `Usd.from_float(value)`, same-unit arithmetic works, and `.raw()` strips the unit.
#UnitFamily(Currency) { usd, eur }

fn subtotal(price: Usd, qty: Int) => Usd = Usd.from_float(price.raw() * Float.from_int(qty))

fn run() {
    unit :: Usd.from_float(9.99)
    total :: subtotal(unit, 3)
    print("total {(total.raw())}")
    // Same-unit arithmetic stays in the unit.
    tax :: Usd.from_float(2.5)
    grand :: total + tax
    print("grand {(grand.raw())}")
    // A different family member is a different type.
    budget :: Eur.from_float(20.0)
    print("budget {(budget.raw())}")
    // `.raw()` drops back to the base Float.
    bare :: grand.raw()
    print("bare {(bare)}")
}
// --- expected output --------------------------------------------------
// total 29.97
// grand 32.47
// budget 20.0
// bare 32.47
