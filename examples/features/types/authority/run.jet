// D-AUTHORITY-WORD2=E: Authority is the one rights value that crosses
// process, plugin, and session boundaries. It only narrows.
use core.process as process

struct Holder {
    grant: Authority
}

fn run() -[Exec, Time.Wait]> {
    #FX(grant: Exec, IO, Time.Wait) {
        spec :: process.cmd(["echo", "authority"]).under(grant)
        result :: process.run_spec(spec) ?? panic("authority process")
        print(result.success)
    }
}
