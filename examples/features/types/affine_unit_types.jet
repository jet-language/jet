// D-QUANTITY-DECL1 / D-QUANTITY-POINT1: an affine family mints separate
// zero-overhead Point and Delta types, while exact scale/offset facts remain
// part of the package API identity.
@UnitFamily(Temperature, base: kelvin) {
    kelvin
    celsius(scale: 1, offset: 27315/100)
}

fn run() {
    target :: CelsiusPoint.from_float(200.0)
    tolerance :: CelsiusDelta.from_float(5.0)
    warmer :: target + tolerance
    drift :: warmer - target
    absolute :: KelvinPoint.from_celsius_point(target)
    print("target {(target.raw())}")
    print("tolerance {(tolerance.raw())}")
    print("warmer {(warmer.raw())}")
    print("drift {(drift.raw())}")
    print("kelvin {(absolute.raw())}")
}
