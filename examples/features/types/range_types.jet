// D-RANGETYPE1: `distinct Int(0..10)` is an `Int` that accepts only 0..10
// (inclusive, S22). Destination-owned conversion checks literals at compile
// time and returns a fallible result for runtime values. "Parse, don't
// validate" as a type.
#Numeric Severity :: distinct Int(0..10)

struct Brightness {
    level: Int(0..100)
}

fn set_brightness(level: Int(0..100)) => Int(0..100) :: level

fn checked_inline(raw: Int) => Int(0..100) ? String :: Int(0..100).from_int(raw)

fn checked(raw: Int) => Severity ? String :: Severity.from_int(raw)

fn sum(band: Range) => Int {
    total := 0
    loop n, band -> total += n
    return total
}

fn run() {
    inline_value :: set_brightness(42)
    print("{inline_value}")
    inline_binding: Int(0..100) = 12
    print("{inline_binding}")
    brightness :: Brightness.{ level: 55 }
    print("{brightness.level}")
    runtime_inline :: checked_inline(3) ?? Int(0..100).from_int(0)
    print("{runtime_inline}")

    // Checked at compile time — always in range.
    sev :: Severity.from_int(7)
    print("{sev.raw()}")
    from_runtime :: checked(3) ?? Severity.from_int(0)
    print("{from_runtime.raw()}")
    // D-TYPE2-EXACT1 / D-FACT-LAW1: range knowledge loosens only at a
    // written bounded-arithmetic gate.
    widened :: wrapping(sev + from_runtime)
    print("{widened}")

    // D-RANGE-VALUE1=A: inclusive and exclusive spellings make the same
    // storable type. The value keeps its end behavior when passed to `sum`.
    bands :: [1..3, 4..<7]
    print(bands[0].contains(3))
    print(bands[1].end)
    print(sum(bands[1]))
}
