// D-RANGETYPE1: `distinct Int(0..10)` is an `Int` that provably holds 0..10
// (inclusive, S22). A literal construction is checked at compile time; a
// runtime value needs the fallible `?` form. "Parse, don't validate" as a
// type.

Severity #= distinct Int(0..10);

fn main() {
    // Checked at compile time — always in range.
    sev #= Severity(7)
    print("{sev.raw()}")
}
