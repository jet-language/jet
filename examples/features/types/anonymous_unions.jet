// D-UNIONTYPE1=A: anonymous unions are structural enum sugar.
// Named enums stay the documenting public form; convert with match.
enum Payload {
    Name(String)
    Count(Int)
}

fn describe(value: Int | String) -> String {
    if value == {
        .Int(n) -> { return "n={n}" }
        .String(s) -> { return "s={s}" }
    }
}

fn take_number(n: Int | String) -> String { return describe(n) }

fn as_named(value: Int | String) -> Payload {
    if value == {
        .Int(n) -> { return Payload.Count(n) }
        .String(s) -> { return Payload.Name(s) }
    }
}

fn from_named(payload: Payload) -> Int | String {
    if payload == {
        .Count(n) -> { return n }
        .Name(s) -> { return s }
    }
}

fn hold(v: Int | String) -> Int | String { return ~v }

#Codable
struct Box {
    value: Int | String
}

fn run() {
    print(describe(7))
    print(take_number("hi"))
    mixed :: hold(3)
    print(describe(mixed))
    print(describe(from_named(as_named("x"))))
    packed :: Box.{value: 9}
    boxed :: packed.value
    if boxed == {
        .Int(n) -> { print("box={n}") }
        .String(s) -> { print("box={s}") }
    }
}
