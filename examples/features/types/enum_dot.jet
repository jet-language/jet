// 151 — leading-dot enum variant `.Variant` in value position (D-ENUMDOT2=A).
// When the enum type is known from context, `.Variant` is a shorthand for `Type.Variant`.
enum Direction {
    North
    South
    East
    West
}

enum Shape {
    Circle(Float)
    Square(Float)
}

fn area(s: Shape) => Float {
    return if s == {
        .Circle(r) -> 3.14159 * r * r
        .Square(w) -> w * w
        else -> 0.0
    }
}

fn label(d: Direction) => String {
    return if d == {
        .North -> "north"
        .South -> "south"
        .East -> "east"
        .West -> "west"
    }
}

fn run() {
    d :: Direction.North
    print(label(d))
    print(label(.South))
    s :: Shape.Circle(3.0)
    print(area(s))
    print(area(.Square(4.0)))
}
