trait Shape {
    fn area(self) -> Float
    fn name(self) -> String
}

struct Circle {
    radius: Float

    impl Shape {
        fn area(self) -> Float {
            return ((3.14159 * self.radius) * self.radius)
        }

        fn name(self) -> String {
            return "circle"
        }
    }
}

struct Square {
    side: Float
}

impl Square.Shape {
    fn area(self) -> Float {
        return (self.side * self.side)
    }

    fn name(self) -> String {
        return "square"
    }
}

fn largest<T: Comparable>(xs: [T]) -> (T?) {
    if xs.len() == 0 {
        return None
    }
    best := ~xs[0]
    i := 1
    loop i < xs.len() {
        if xs[i] > best {
            best = ~xs[i]
        }
        i += 1
    }
    return Val(best)
}

fn print_area(s: Shape) {
    print("{s.name()}: {s.area()}")
}

struct Score {
    points: Int
    derive Comparable
}

fn run() {
    shapes :: [Shape].{Circle.{radius: 1.0}, Square.{side: 2.0}}
    shapes.each((s) => {
        print_area(s)
    })
    nums :: [3, 1, 4, 1, 5]
    print(largest(nums))
    scores := [Score.{points: 10}, Score.{points: 20}]
    scores.sort_by((s: Score) => s.points)
    print(scores[0].points)
}
