// 10 — Structs with methods (M3, S27/S29).
struct Point {
    x: Float
    y: Float

    fn dist_sq(self) => Float = self.x * self.x + self.y * self.y

    fn unit() => Point {
        return .{x: 1.0, y: 0.0}
    }
}

fn run() {
    p :: Point.{x: 3.0, y: 4.0}
    print(p.dist_sq())
    u :: Point.unit()
    print(u.x)
}
