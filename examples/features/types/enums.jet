// 11 — Enums and exhaustive when (M3, S30/S31, D-ENUMDOT1).
enum Light {
    Red
    Yellow
    Green
}

fn next(light: Light) => Light {
    return if light == {
        .Red -> .Yellow
        .Yellow -> .Green
        .Green -> .Red
    }
}

fn label(light: Light) => String {
    return if light == {
        .Red -> "stop"
        .Yellow -> "caution"
        .Green -> "go"
    }
}

fn run() {
    start :: Light.Red
    print(label(start))
    print(label(next(start)))
}
