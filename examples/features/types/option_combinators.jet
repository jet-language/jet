// D-HOLE1: `.zip`/`Option.lift2` — Option composition without a general
// "hole"/absent-propagating value type. A sensor reading only has a total
// price when BOTH price and quantity are present; either missing makes the
// total unknown (`null`), never a silent zero or a distinct "hole" type.
fn lookup_price(id: Int) -> (Float?) {
    if id == 1 {
        return value(19.99)
    }
    return null
}

fn lookup_qty(id: Int) -> (Float?) {
    if id == 1 {
        return value(3.0)
    }
    if id == 2 {
        return value(5.0)
    }
    return null
}

fn main() {
    // Both present: `.zip` pairs them, `.map` computes the total.
    price: Float? #= lookup_price(1)
    qty: Float? #= lookup_qty(1)
    total1 #= price.zip(qty).map((pair) => pair.a * pair.b)
    print(total1)

    // `Option.lift2` does the same combination without an explicit pair.
    total2 #= Option.lift2((p, q) => p * q, price, qty)
    print(total2)

    // One absent (id 2 has a quantity but no price) -> null, not a partial total.
    price2: Float? #= lookup_price(2)
    qty2: Float? #= lookup_qty(2)
    total3 #= price2.zip(qty2).map((pair) => pair.a * pair.b)
    print(total3)

    // Both absent (id 3 has neither) -> null.
    price3: Float? #= lookup_price(3)
    qty3: Float? #= lookup_qty(3)
    total4 #= Option.lift2((p, q) => p * q, price3, qty3)
    print(total4)
}
