// 196 — a real, clickable webpage rendered by Jet-compiled JS (Phase 7
// extension: DOM backend now mounts real elements when a `document` exists,
// and every top-level `#Target(JS) fn` is exported so a hand-written host page
// (ui_web_click.html) can call `render` directly from a button's onclick.
// The box's fill color is wired all the way through `ui.node_color` ->
// `JetPaintCmd::FillRect` -> the real DOM background (Phase 3/7 wiring) —
// no hardcoded "#000000" anywhere in this path. Every other click switches
// color, proving the color is live per-render, not a static style.
// D-WEBDEFAULT1/D-HTMLPAIR1 (ratified 2026-07-01, c134): explicit instead of implicit —
// `jet dev`/`jet build`/`jet run` infer the web backend from #Target(Web)
// (no --target=web needed), and #HTML names the companion host page instead
// of relying on the <stem>.html filename convention.
// c-devserver (owner-directed 2026-07-01): `fn dev()` below is this file's
// OWN `jet dev` behavior — a real `core.web.devserver` value, configured and
// started as ordinary Jet code. `jet dev examples/features/web/ui_web_click.jet`
// (zero flags) now detects `dev()`, compiles this file NATIVELY with `dev()`
// as the entry point (not `main()`), and runs it; `dev()`'s body then shells
// out to `jet build --target=web` on every save and serves `build/` with
// live-reload — same end result as the old `jet dev --target=web`, but
// authored by the file itself instead of hardcoded in the CLI. `fn run()`
// below is untouched: `jet run examples/features/web/ui_web_click.jet` still
// prints the native demo exactly as before.
// `devserver.app()` = "watch the file jet dev launched" (passed in via
// JET_DEV_FILE, always absolute — works from any directory). Use
// `devserver.for_app("path")` only to watch a DIFFERENT entry file; it
// accepts relative (resolved against the invocation cwd) or absolute paths.
use core.ui as ui
use core.web.devserver as devserver
#[Target(Web), HTML("ui_web_click.html")]

fn dev() {
    server :: devserver.app()
    server.serve()
}

fn render(n: Int) {
    backend :: ui.null_backend()
    color := "#e8790c"
    if ((n % 2) == 0) { color = "#3366ff" }
    node :: ui.node_color("Clicks: {n}", 160.0, 40.0, color)
    constraint :: ui.constraint(0.0, 0.0, 300.0, 100.0)
    size :: backend.measure(node, constraint)
    frame :: ui.rect(20.0, 20.0, size.width, size.height)
    backend.layout(node, frame)
    backend.paint(node)
}

fn run() { render(0) }
