// D-WEB-CLICK-OWN1=D / D-WEB-CLICK-PORT1=D: Jet owns the click listener, counter
// signal, and render. The companion HTML is only a shell. Portable
// `ui.button(..., on_click:)` carries the handler on the node — no `web.on`
// selector bind. D-UI-NODE-ID1=C / D-UI-EVT-DISP1=E / D-UI-EVT-SET1=D.
// D-WEBDEFAULT1/D-HTMLPAIR1 (ratified 2026-07-01, c134): explicit instead of implicit —
// `jet dev`/`jet build`/`jet run` infer the web backend from #Target(Web)
// (no --target=web needed), and #HTML names the companion host page instead
// of relying on the <stem>.html filename convention.
// Exported `render(n)` remains for the FAKE_DOM harness in tests/web_build.rs.
use core.ui as ui
use core.reactive as reactive
#[Target(Web), HTML("ui_web_click.html")]

fn render(n: Int) {
    backend :: ui.null_backend()
    color := "#e8790c"
    if n % 2 == 0 { color = "#3366ff" }
    node :: ui.node_color("Clicks: {n}", 160.0, 40.0, color)
    constraint :: ui.constraint(0.0, 0.0, 300.0, 100.0)
    size :: backend.measure(node, constraint)
    frame :: ui.rect(20.0, 20.0, size.width, size.height)
    backend.layout(node, frame)
    backend.paint(node)
}

fn run() {
    count :: reactive.signal(0)
    backend :: ui.null_backend()
    ui.reactive_render(() => {
        n := count.get()
        color := "#e8790c"
        if n % 2 == 0 { color = "#3366ff" }
        tree :: ui.box([
            ui.node_color("Clicks: {n}", 160.0, 40.0, color),
            ui.button("Click me", on_click: () => { count.set(count.get() + 1) }),
        ])
        ui.mount(backend, tree, ui.constraint(0.0, 0.0, 300.0, 120.0))
    })
}
