use web as battery
use core.reactive as reactive
use core.ui as ui

#[Target(Web), HTML(Path{"index.html"})]
fn run() {
    props :: battery.island_props(1, "alice")
    backend :: ui.null_backend()
    count :: reactive.signal(0)
    ui.reactive_render(() -> {
        n :: count.get()
        tree :: ui.box([
            ui.text("Orders island count: {n}"),
            ui.text("Serializable props: {props}"),
            ui.button("Refresh", on_click: () -> {
                count.set(count.get() + 1)
            })
        ])
        ui.mount(backend, tree, ui.constraint(0.0, 0.0, 360.0, 120.0))
    })
    loop command in backend.commands() -> print(command)
    count.set(count.get() + 1)
    loop command in backend.commands() -> print(command)
}
