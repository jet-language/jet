// D-WEBAPP1=D: minimal full-stack application builder smoke example.
use core.web as web

fn home() => WebPage = web.page("Hello", "world")

fn save() { print("saved") }

fn run() => WebApp {
    return web.app()
        .route("/", home)
        .action("save", save)
        .security("csp")
        .assets("public")
        .a11y("wcag")
        .adapter("node")
        .csr()
}
