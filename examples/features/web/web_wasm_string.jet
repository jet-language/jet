// D-JSBIND1 / #123: Wasm #WasmExport String return ABI (packed ptr/len) with
// hostile empty / tab+newline / Unicode roundtrip through the JS bridge.
#WasmExport
fn pick_str(which: Int) => String {
    return if which == {
        0 -> ""
        1 -> "ascii-ok"
        2 -> "tab\tline\nbreak"
        else -> "emoji🌍"
    }
}

#Target(JS)
fn run() {
    print(pick_str(@[0, 1, 2, 3]@))
}
