// D-JSBIND1 / #123: Wasm #WasmExport [String: Int] ABI with hostile empty,
// control-character, Unicode, full-width signed, and JS -> Wasm -> JS -> Wasm roundtrip.
#WasmExport
fn echo_scores(scores: [String: Int]) => [String: Int] = ~scores

#WasmExport
fn score(scores: [String: Int], key: String) => Int = scores[key]

#WasmExport
fn verify_limits(scores: [String: Int]) => Int = scores["min"] + scores["max"] + (scores["above-safe"] - 9007199254740992) + (scores["below-safe"] + 9007199254740992)

#Target(JS)
fn run() {
    empty :: [String: Int].{}
    empty_roundtrip :: echo_scores(empty)
    _empty_twice :: echo_scores(empty_roundtrip)
    scores :: [String: Int].{
        "": 0,
        "tab\tline\nbreak": -7,
        "emoji🌍": 42,
        "z": 99,
        "min": -9223372036854775807 - 1,
        "max": 9223372036854775807,
        "above-safe": 9007199254740993,
        "below-safe": -9007199254740993
    }
    roundtrip :: echo_scores(scores)
    print(score(roundtrip, ""))
    print(score(roundtrip, "tab\tline\nbreak"))
    print(score(roundtrip, "emoji🌍"))
    print(score(roundtrip, "z"))
    print(verify_limits(roundtrip))
}
