use core.web.store as store

fn run() {
    store.set(store.with_history("Counter", 0, 2), 1)
    store.set(store.with_history("Counter", 0, 2), 2)
    store.set(store.with_history("Counter", 0, 2), 3)
    print("store.history")
    print(store.facts_json(store.with_history("Counter", 0, 2)))
    print(store.event_json(store.with_history("Counter", 0, 2)))
}
