// D-JSBIND1 / #123: JS event callback invokes a #WasmExport bridge (JS -> Wasm
// inside a browser-style handler), proving callback + compute round-trip.
use core.web as web

#WasmExport
fn double(n: Int) => Int = n * 2

#Target(JS)
fn init() {
    web.on("#go", "click", ev => print(double(21)))
}

fn run() {
    print(double(21))
}
