// Wasm compute export called from JS main (card #123 / #705).
// `jet build --target web examples/features/web/web_compute.jet`
// `jet build --target web --explain-partition` to audit JS vs Wasm buckets.
#WasmExport
fn compute(n: Int) -> Int {
    return (n * 2)
}

#Target(Js)
fn run() {
    print(compute(21))
}
