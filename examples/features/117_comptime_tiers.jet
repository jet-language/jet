// D-CTEFFECT1 (ratified 2026-06-25): comptime effect tiers.
//
// Tier 0 — pure (always safe): deterministic Core builtins from the
//           D-CTCORE1 whitelist. No gate required.
//
// Tier 1 — reproducible: embed_file / embed_bytes hash their inputs
//           into .jet/lock so the build is content-addressable.
//
// Tier 2 — ambient: reads the host filesystem, environment, etc.
//           Requires BOTH a `#Impure("reason") { … }` gate AND
//           `--allow-impure` on the build command.

use core.math as math

// Tier 0: pure math — always evaluates at compile time.
comptime DIGITS_OF_PI = math.floor(math.pow(10.0, 4.0) * 3.14159)
comptime GREETING     = "hello"

// Tier 1: embed_file reads the file once at compile time; its path and
// content hash are recorded in .jet/lock. (Shown here as comment — no
// file to embed in this self-contained example.)
//
//   comptime NOTICE = embed_file("NOTICE.txt")

fn main() {
    print("{GREETING}, world")
    print("pi × 10^4 ≈ {DIGITS_OF_PI}")

    // Tier 2 gate: the block itself is fine without --allow-impure as
    // long as no `comptime` binding is attempted inside it. With
    // --allow-impure you can add: comptime cfg = fs.read("config.txt")
    #Impure("demonstrating the gate syntax") {
        print("inside #Impure gate (runtime block, Tier-2 comptime disabled here)")
    }
}
