// 157 — D-COROUTINE1: coroutine-grade control via task handles (internal substrate).
// Task failure uses the canonical `TaskFailure` rail.
use core.tasks as tasks
use core.time as time

fn slow_two() => Int {
    time.sleep(50)
    return 2
}

fn run() {
    print(tasks.current_task())
    tasks.yield_now()

    t :: task 7
    t.pause()
    t.resume()
    t.cancel()
    print(t.join() ?? panic("cancelled task"))

    print(task.any { slow_two(), 1 })

    (tx, rx) :: tasks.channel<Int>()
    tx.send(9)
    tx.close()
    rx.close()
    print(9)
}
