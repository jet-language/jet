// 157 — D-COROUTINE1: coroutine-grade control via task handles (internal substrate).
// #1468: yield_now, exception, wait_any, current_task, Sender/Receiver.close.
use core.tasks as tasks
use core.time as time

fn slow_two() => Int {
    time.sleep(50)
    return 2
}

fn run() {
    print(tasks.current_task())
    tasks.yield_now()

    t :: tasks.spawn(() => 7)
    t.pause()
    print(t.trace())
    print(t.exception())
    t.resume()
    t.cancel()
    print(t.trace())
    print(t.exception())
    print(t.join())

    fast :: tasks.spawn(() => 1)
    slow :: tasks.spawn(() => slow_two())
    print(tasks.wait_any([slow, fast]))

    (tx, rx) :: tasks.channel<Int>()
    tx.send(9)
    tx.close()
    rx.close()
    print(9)
}
