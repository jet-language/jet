// D-CONC-SPAWN1=D: dynamic fan-out uses the one `task.group` surface.
// The limit bounds active children; the group joins every child at close.

fn work(value: Int) => Int {
    value + 1
}

fn run() {
    task.group workers(limit: 3) {
        results :: task.all {
            work(1),
            work(2),
            work(3),
            work(4)
        }
        print(results)
    }
}
