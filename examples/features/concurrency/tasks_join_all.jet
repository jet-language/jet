fn work(value: Int, turns: Int) => Int {
    total := value
    loop _, 1..turns {
        total += 1
        total -= 1
    }
    return total
}

fn run() {
    results :: task.all {
        work(10, 10000),
        work(20, 1),
        work(30, 100)
    }
    print(results[0], results[1], results[2])
}
