// 169 — D-CONCCOMB1/A: all fail-fast cancels siblings when one task panics.
// Expected: process exits non-zero; stderr mentions panic (golden uses .err.out).
use core.tasks as tasks
use core.time as time

fn slow_one() => Int {
    time.sleep(200)
    return 1
}

// This example is about cancelling siblings, so it panics outright rather than
// through arithmetic — a divide-by-zero whose divisor the checker can see is
// caught at build time, which is not what is being shown here.
fn boom() => Int {
    panic("task failed")
    return 0
}

fn run() {
    taskgroup g {
        slow :: g.task => {
            slow_one()
        }
        bad :: g.task => {
            boom()
        }
        results :: g.all([slow, bad])
        print(results[0])
    }
}
