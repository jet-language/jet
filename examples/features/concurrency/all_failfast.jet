// 169 — D-CONC-SPAWN1=D: all fail-fast cancels siblings when one task panics.
// Expected: process exits non-zero; stderr mentions panic (golden uses .err.out).
use core.time as time

fn slow_one() => Int {
    time.sleep(200)
    return 1
}

// This example is about cancelling siblings, so it panics outright rather than
// through arithmetic. `1 / zero` no longer type-checks in a `=> Int` function
// (D-INTDIV1: the quotient is a Float), and `/%` is not a drop-in either,
// because the comptime evaluator folds a divisor it can see and stops the
// build before the task ever runs.
fn boom() => Int {
    panic("task failed")
    return 0
}

fn run() {
    task.group g {
        results :: task.all {
            slow_one(),
            boom()
        }
        print(results[0])
    }
}
