// 160 — D-ASYNCRT1=A M2: M:N scheduler — spawn pool + channel wake-on-send.

use core.tasks as tasks

fn main() {
ch: Channel<Int> :: tasks.channel()
sender: Sender<Int> :: ch.sender()
    loop i in 1..1000 {
        copy :: sender.clone()
        h :: tasks.spawn(take(copy) () => {
            copy.send(1)
        })
        h.join()
    }
    total: Int := 0
    loop i in 1..1000 {
        total = (total + (ch.receive() ?? panic("channel closed")))
    }
    print(total)
}
