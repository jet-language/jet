// D-CONC-FAIL1=A / D-OBSERVE-TASK1=A / card #2277: a joined child keeps its
// panic text and task identity on the TaskFailure rail.
fn boom() Int -> {
    panic("child boom")
    return 0
}

fn failure_text(error: TaskFailure) String -> {
    if error == {
        .Panicked(reason) -> { return reason }
        .DeadlineBlown -> { return "deadline" }
        .Cancelled -> { return "cancelled" }
    }
}

fn run() {
    child :: task boom()
    result :: child.join()
    if result == {
        .Err(error) -> { panic(failure_text(error)) }
        .Ok(_) -> { print("unexpected success") }
    }
}
