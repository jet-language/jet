// 34 — Parallel file scan: tasks + channels for real I/O-bound work.
//
// Default demo (no extra args):
//   nix develop -c jet run examples/features/concurrency/parallel_scan.jet
//
// Pick your own files:
//   nix develop -c jet run examples/features/concurrency/parallel_scan.jet examples/features/serde/json.jet examples/features/io/cli.jet
//
// Interactive prompts:
//   INTERACTIVE=1 nix develop -c jet run examples/features/concurrency/parallel_scan.jet
use core.tasks as tasks
use core.files as fs
use core.io as io
use core.env as env

fn count_lines(text: String) => Int = text.lines().len()

fn scan_one(path: String) => String {
    text :: fs.read(~path) ?? return "{path}: unreadable"
    lines :: count_lines(text)
    return "{path}: {lines} lines, {text.len()} chars"
}

fn default_paths() => [String] {
    return [
        "examples/features/concurrency/tasks.jet",
        "examples/features/concurrency/pipeline.jet",
        "examples/features/collections/wordcount.jet",
        "examples/features/serde/json.jet"
    ]
}

fn paths_from_args() => [String] = io.args().skip(1).to_list()

fn paths_from_prompt() => [String] {
    print("Enter file paths (blank line when done):")
    out := [String].{}
    loop true {
        raw :: io.input("> ") ?? return ~out
        if raw == "" { break }
        out.push(raw)
    }
    return out
}

fn gather_paths() => [String] {
    from_args :: paths_from_args()
    if from_args.len() > 0 { return from_args }
    if (env.get("INTERACTIVE") ?? "") == "1" { return paths_from_prompt() }
    return default_paths()
}

fn scan_parallel(paths: [String]) => [String] {
    expected :: paths.len()
    (sender, ch) :: tasks.channel<String>()
    workers := [Task<Unit>].{}
    loop path; paths {
        tx :: ~sender
        file :: ~path
        workers.push(tasks.spawn(() => {
            tx.send(scan_one(file))
        }))
    }
    loop workers.len() > 0 {
        worker :: workers.pop() ?? panic("missing worker")
        worker.join()
    }
    results := [String].{}
    got := 0
    loop got < expected {
        results.push(ch.receive() ?? panic("channel closed early"))
        got += 1
    }
    results.sort()
    return results
}

fn copy_paths(paths: [String]) => [String] = paths.map(path => ~path).to_list()

fn run() {
    paths :: gather_paths()
    if paths.len() == 0 {
        print("no files to scan")
        return
    }
    print("scanning {paths.len()} files...")
    print("")
    parallel_paths :: copy_paths(paths)
    parallel :: scan_parallel(parallel_paths)
    loop line; parallel { print(line) }
    print("")
    print("done — {paths.len()} files scanned in parallel")
}
