fn work(value: Int, turns: Int) Int -> {
    total := value
    loop _ in 1..turns {
        total += 1
        total -= 1
    }
    return total
}

fn run() {
    results :: task.all {
        first: work(10, 10000),
        second: work(20, 1),
        third: work(30, 100)
    } ?? panic("task.all failed")
    print(results.first, results.second, results.third)
}
