// D-TASKBORROW1=A: a task group joins every child, so a child may borrow a place
// its owner still gives access. Reads are free. Writes are admitted only where sema can
// prove the places never overlap — here, two constant indexes into one list.
// The loan opens before the child launches and closes when the group joins, so
// the owner sees every write once the block ends.
struct Particle {
    position: Int
    velocity: Int
}

fn run() {
    particles := [Particle].{
        .{position: 10, velocity: 2},
        .{position: 20, velocity: 3},
        .{position: 30, velocity: 4}
    }
    task.group g {
        left :: &particles[0]
        right :: &particles[2]
        print(task.all {
            { left.position += left.velocity; left.position },
            { right.position += right.velocity; right.position }
        })
    }
    print(particles[0].position)
    print(particles[1].position)
    print(particles[2].position)

    // One borrow on its own is the same law with one child. The write still
    // lands on the owner, because the group joins before the block ends.
    task.group solo {
        only :: &particles[1]
        task {
            only.position += only.velocity
            only.position
        }
    }
    print(particles[1].position)
}
