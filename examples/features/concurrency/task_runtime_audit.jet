// D-TYPE2-TIME1=A: bounded channels, typed timer channels, and readiness timeouts
// all consume the canonical Duration literal.
use core.tasks as tasks

fn run() {
    task.group g {
        (sender, ch) :: channel<Int>(1)
        sender.send(1)
        blocked :: task ^sender {
            sender.send(2)
            sender.close()
        }
        loop value, ch -> print(value)
        blocked.join() ?? panic("blocked task failed")
        if {
            after 0ms -> { print(-1) }
        }
        once :: tasks.after(0ms, 7)
        print(once.receive() ?? panic("timer closed"))
        ticks :: tasks.interval(1ms)
        print(ticks.receive() ?? panic("interval closed"))
        print(ticks.receive() ?? panic("interval closed"))
    }
}
