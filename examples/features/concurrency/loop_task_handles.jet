// A task handle owns one running child and its join slot, so it cannot be
// copied. Looping over a list of handles therefore takes the list: each step
// hands you the handle itself, and waiting on it consumes it. Using the list
// again after the loop is ordinary use-after-move (E0121), not a compiler crash.
fn run() {
    handles :: [
        task 1,
        task 2,
        task 3
    ]
    total := 0
    loop handle, handles { total += handle.join() ?? 0 }
    print(total)
}
