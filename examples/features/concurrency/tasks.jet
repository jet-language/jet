use core.tasks as tasks

fn sum_range(first: Int, last: Int) => Int {
    total := 0
    loop n, first..last { total += n }
    return total
}

fn run() {
    results :: task.all {
        sum_range(1, 25),
        sum_range(26, 50),
        sum_range(51, 75),
        sum_range(76, 100)
    }
    first_half :: results[0] + results[1]
    second_half :: results[2] + results[3]
    print(first_half + second_half)
    tasks.yield_now()
    print(tasks.current_task())
}
