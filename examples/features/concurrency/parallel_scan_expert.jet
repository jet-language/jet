// Expert variant of parallel_scan.jet (D-EXAMPLES-SHORTPATH1=A).
// Manual channels + spawn + join. Prefer `para_map` in the flagship.
use core.tasks as tasks
use core.files as fs
use core.io as io
use core.path as path

fn count_lines(text: String) => Int = text.lines().len()

fn scan_one(file_path: String) => String {
    text :: fs.read(~file_path) ?? return "{file_path}: unreadable"
    lines :: count_lines(text)
    return "{file_path}: {lines} lines, {text.len()} chars"
}

fn default_paths() => [String] {
    a :: path.join("/tmp", "jet_parallel_scan_a.txt")
    b :: path.join("/tmp", "jet_parallel_scan_b.txt")
    _ :: fs.write(a, "one\ntwo\n")
    _ :: fs.write(b, "alpha\nbeta\ngamma\n")
    return [a, b]
}

fn paths_from_args() => [String] = io.args().skip(1).to_list()

fn gather_paths() => [String] {
    from_args :: paths_from_args()
    if from_args.len() > 0 { return from_args }
    return default_paths()
}

fn scan_parallel(paths: [String]) => [String] {
    expected :: paths.len()
    (sender, ch) :: tasks.channel<String>()
    workers := [Task<()>].{}
    loop file_path, paths {
        tx :: ~sender
        file :: ~file_path
        workers.push(tasks.spawn(() => {
            tx.send(scan_one(file))
        }))
    }
    loop workers.len() > 0 {
        worker :: workers.pop() ?? panic("missing worker")
        worker.join()
    }
    results := [String].{}
    got := 0
    loop got < expected {
        results.push(ch.receive() ?? panic("channel closed early"))
        got += 1
    }
    results.sort()
    return results
}

fn run() {
    paths :: gather_paths()
    if paths.len() == 0 {
        print("no files to scan")
        return
    }
    print("scanning {paths.len()} files...")
    print("")
    parallel :: scan_parallel(paths)
    loop line, parallel { print(line) }
    print("")
    print("done — {paths.len()} files scanned in parallel")
}
