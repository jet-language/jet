// D-CONC-CHAN2=D / card #1560: a readiness table waits on plain endpoints.

fn run() {
    (s1, ch1) :: channel<Int>()
    (s2, ch2) :: channel<Int>()
    s1.send(11)
    if {
        job, ch1 :> print(job)
        msg, ch2 :> print(msg)
    }
    s2.send(22)
    if {
        job, ch1 :> print(job)
        msg, ch2 :> print(msg)
    }
}
