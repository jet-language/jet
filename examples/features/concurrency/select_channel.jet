// 168 — D-CONCSELECT1=A: fluent scoped select wakes one recv arm.
use core.tasks as tasks

fn run() {
    taskgroup g {
        ch1: Channel<Int> :: tasks.channel()
        ch2: Channel<Int> :: tasks.channel()
        s1 :: ch1.sender()
        s2 :: ch2.sender()
        s1.send(11)
        winner :: g.select().recv(ch1).recv(ch2).wait()
        print(winner)
        s2.send(22)
        winner2 :: g.select().recv(ch1).recv(ch2).wait()
        print(winner2)
    }
}
