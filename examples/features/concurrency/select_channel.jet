// 168 — D-CONCSELECT1=A: fluent scoped select wakes one recv arm.
use core.tasks as tasks

fn run() {
    task.group g {
        (s1, ch1) :: tasks.channel<Int>()
        (s2, ch2) :: tasks.channel<Int>()
        s1.send(11)
        winner :: if {
            value, ch1 -> value
            value, ch2 -> value
        }
        print(winner)
        s2.send(22)
        winner2 :: if {
            value, ch1 -> value
            value, ch2 -> value
        }
        print(winner2)
    }
}
