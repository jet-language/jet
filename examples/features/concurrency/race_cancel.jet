// 167 — D-CONCCOMB1/A + D-RACEWIN1: race returns first success; losers cancelled at runtime.
use core.tasks as tasks
use core.time as time

fn slow_one() => Int {
    time.sleep(200)
    return 1
}

fn fast_seven() => Int = 7

fn run() {
    task.group g {
        winner :: task.race { slow_one(), fast_seven() }
        print(winner)
    }
}
