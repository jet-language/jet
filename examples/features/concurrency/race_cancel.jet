// 167 — D-CONCCOMB1/A + D-RACEWIN1: race returns first success; losers cancelled at runtime.
use core.tasks as tasks
use core.time as time

fn slow_one() => Int {
    time.sleep(200)
    return 1
}

fn fast_seven() => Int = 7

fn run() {
    taskgroup g {
        slow :: g.task => {
            slow_one()
        }
        fast :: g.task => {
            fast_seven()
        }
        winner :: g.race([slow, fast])
        print(winner)
    }
}
