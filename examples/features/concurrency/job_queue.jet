// D-JOB-QUEUE1: one typed job flows through the durable queue lifecycle.
use core.jobs as jobs
use core.sys as sys
use core.testing as testing

#Job(.Dev) fn process(payload: String) {
    print("job:{payload}")
}

fn run() {
    root := testing.temp_dir("job-queue")
    sys.set("JET_JOB_QUEUE_DB", Path.from(root).join("jobs.db").to_string())
    queue :: jobs.queue() ?? return

    first :: queue.enqueue(process, "now", key: "first") ?? return
    _failed :: queue.enqueue(process, "fail", key: "failed") ?? return
    cancelled :: queue.delay(process, "cancel", for: 1s) ?? return
    deadlettered :: queue.delay(process, "dead", for: 1s) ?? return
    receipt :: queue.receipt(first.id) ?? return
    print("receipt:{receipt.id}:{receipt.job_type}")
    records :: queue.inspect(16, true) ?? return
    print("records:{records.len()}")
    events :: queue.events(first.id) ?? return
    print("events:{events.len()}")

    claims :: queue.claim("teaching-worker", 2) ?? return
    loop claim in claims {
        queue.heartbeat(claim) ?? return
        if claim.payload.bytes == "now".bytes() {
            result :: JobResult{
                type_id: claim.payload.type_id,
                bytes: claim.payload.bytes,
                publish: false,
            }
            queue.acknowledge(claim, result) ?? return
        } else {
            error :: JobError{
                type_id: claim.payload.type_id,
                reason: "teaching failure",
                detail: None,
            }
            queue.fail(claim, error) ?? return
        }
    }

    queue.cancel(cancelled.id, "teaching cancellation") ?? return
    queue.dead_letter(deadlettered.id, "teaching dead letter") ?? return
    queue.recover_expired() ?? return
    queue.status() ?? return
    queue.pause() ?? return
    queue.resume() ?? return
    queue.wait(1ms) ?? return
    print("pruned:{queue.prune()}")
}
