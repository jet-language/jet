// D-CONCCOMB1/A: race/any use task completion order, not task-list order.
use core.time as time

fn slow_one() => Int {
    time.sleep(100)
    return 1
}

fn fast_seven() => Int = 7

fn run() {
    task.group race_group {
        // Listed slow-first: race still returns the fast branch's value,
        // proving completion order (not list order) picks the winner.
        print(task.race { slow_one(), fast_seven() })
    }
    task.group any_group {
        print(task.any { slow_one(), fast_seven() })
    }
}
