use core.tasks as tasks
use core.time as time

fn run() {
    @Context(deadline: time.now() + 20) {
        slow :: tasks.spawn(() => {
            time.sleep(10)
            print("finished")
        })
        slow.wait()
    }
    @Context(deadline: time.now() + 20) {
        slow :: tasks.spawn(() => {
            time.sleep(40)
            print("finished")
        })
        slow.wait()
    }
}
