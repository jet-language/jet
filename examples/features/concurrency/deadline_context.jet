use core.time as time

fn run() {
    #Context(deadline: time.now() + 20) {
        slow :: task {
            time.sleep(10)
            print("finished fast")
        }
        slow.join() ?? panic("fast task failed")
    }
    #Context(deadline: time.now() + 20) {
        slow :: task {
            time.sleep(40)
            print("finished slow")
        }
        slow.join() ?? panic("slow task failed")
    }
}
