struct Pair<T> {
    first: T;
    second: T;
}
fn make_pair<T>(a: T, b: T) -> Pair<T> {
    return Pair<T> {first: a, second: b};
}
struct Stack<T> {
    items: List<T>;
}
fn empty_stack<T>() -> Stack<T> {
    return Stack<T> {items: []};
}
fn push<T>(s: Stack<T>, item: T) -> Stack<T> {
    var copy = s;
    copy.items.push(item);
    return copy;
}
fn main() {
    val p: Pair<Int> = make_pair(1, 2);
    print(p.first);
    var st: Stack<Int> = empty_stack();
    st = push(st, 42);
    print(st.items[0]);
}
