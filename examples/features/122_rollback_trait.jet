// 122 — D-TXN-ROLLBACK layer 2: the `Rollback` trait.
// A type implementing `Rollback` supplies a cheap `snapshot`/`restore` pair
// used instead of a full clone. `Ledger` records only the balance on entry.

struct Ledger {
    balance: Int
    name: String
}

struct LedgerSnap {
    balance: Int
}

impl Ledger.Rollback {
    type Snapshot = LedgerSnap
    fn snapshot(self) -> LedgerSnap {
        return LedgerSnap.{ balance: self.balance }
    }
    fn restore(~self, snap: ^LedgerSnap) {
        self.balance = snap.balance
    }
}

enum TxnErr {
    Overdraft
}

fn transfer(from: ~Ledger, to: ~Ledger, amount: Int) -> Int ? TxnErr {
    #Transact(tx) {
        from.balance -= amount
        to.balance += amount
        if from.balance < 0 {
            return err(TxnErr.Overdraft)
        }
    }
    return ok(amount)
}

fn main() {
    alice := Ledger.{ balance: 100, name: "Alice" }
    bob   := Ledger.{ balance: 0, name: "Bob" }

    print("=== successful transfer ===")
    r @= transfer(~alice, ~bob, 40) ?? (-1)
    print(alice.balance)
    print(bob.balance)

    print("=== overdraft: balances restored by Rollback ===")
    s @= transfer(~alice, ~bob, 200) ?? (-1)
    print(alice.balance)
    print(bob.balance)
    print(s)
}
