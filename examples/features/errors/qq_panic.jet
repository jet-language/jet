// #1967: a failing `?? panic(…)` reports AND stops, byte-identically on every
// tier (I9). The `??` right side keeps its own interpolated message and the
// `panic` span, and the stop ends the program — the `print` below is never
// reached, so any tier that only reports the stop shows up as stray stdout.
fn maybe() => Int? {
    return None
}

fn run() {
    v :: maybe() ?? panic("expected the answer, got none")
    print(v)
}
