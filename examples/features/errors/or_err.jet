// D-FAIL-CARRIER1=A — `T?` and `T ? E` are two views of one outcome carrier.
// `.or_err("why")` moves an outcome from the first view to the second: the
// payload rides through untouched and only the report changes.
fn birth_year(book: [String: String], name: String) => String ? {
    // `book.get(name)` answers `String?`, where an absence is clean and says
    // nothing. `.or_err` gives that absence a reason to tell the caller.
    return book.get(name).or_err("nobody in the book is called that")
}

fn run() {
    book :: ["ada": "1815", "alan": "1912"]

    // A present payload stays present. Nothing converts, so the same carrier
    // reads as a value on the fallible view.
    print(birth_year(book, "ada") ?? "unknown")
    print(birth_year(book, "alan") ?? "unknown")

    // A clean absence is now a failure, so the fallible view sees an `Err`
    // where the optional view saw only an empty answer.
    if birth_year(book, "grace") == {
        .Ok(year) -> { print(year) }
        .Err(_) -> { print("no year on file, and now the caller is told why") }
    }
}
