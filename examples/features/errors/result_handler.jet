// D-RESULT-DECON2=B: one fixed exhaustive Result handler handles both payloads.
fn classify(ok: Bool) Int -> if ok -> Ok(7) else -> Err("bad")

fn choose<T>(value: ^T, ok: Bool) T -> if ok -> Ok(value) else -> Err("bad")

fn choose_text(value: ^String, ok: Bool) String -> if ok -> Ok(value) else -> Err("bad")

fn owned(ok: Bool) String -> {
    return choose_text("owned", ok) ? success -> success ! _failure -> "bad"
}

fn generic<T>(value: ^T, ok: Bool) T -> {
    return choose<T>(^value, ok) ? success -> success ! _failure -> return Err("bad")
}

fn nested(value: Int, ok: Bool) Int -> {
    return choose<Int>(^value, ok) ? success -> {
        choose<Int>(^success, ok) ? nested_success -> nested_success + 1 ! _nested_failure -> 0
    } ! _failure -> 0
}

fn run() {
    #FX(authority: IO) {
        authority.with("IO")
        classify(true) ? ok -> { print("ok"); print(ok) } ! _error -> print("error")
        classify(false) ? ok -> { print("ok"); print(ok) } ! _error -> print("error")
        value :: classify(true) ? ok -> ok + 1 ! _error -> 0
        print("value")
        print(value)
        print(owned(true))
        print(owned(false))
        print(generic(4, true) ? generic_value -> generic_value ! _generic_failure -> 0)
        print(nested(4, true))
        print(nested(4, false))
    }
}
