// D-FAIL-CTX1=A: automatic `?`-propagation trace (dev builds) + lazy `?` notes.
// An uncaught Err prints each `?` site as `error propagated from: fn (file:line) via ?`
// on stderr. Notes ride the hop and consecutive identical frames collapse.
fn read_raw() => String ? :: Err("file not found")

fn parse_config(path: String) => String ? {
    raw :: read_raw()? "reading raw config"
    return Ok(raw)
}

fn load_config(path: String) => String ? {
    cfg :: parse_config(path)? "loading config {path}"
    return Ok(cfg)
}

fn run() ? { _ :: load_config("app.toml")? }
