// D-FAIL-CTX1=A: automatic `?`-propagation trail (dev builds) + lazy `?` notes.
// An uncaught Err prints the root failure first, then a `Trail [E3002]` block of
// numbered `fn (file:line)` hops, origin first; repeats collapse with a `×N`.
fn read_raw() String ! -> Err("file not found")

fn parse_config(path: String) String ! {
    raw :: read_raw()? "reading raw config"
    return Ok(raw)
}

fn load_config(path: String) String ! {
    cfg :: parse_config(path)? "loading config {path}"
    return Ok(cfg)
}

fn run() ! { _ :: load_config("app.toml")? }
