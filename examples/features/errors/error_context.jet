// D-ERRCTX1=D: `.context("msg {var}")` adds a lazily-evaluated human boundary
// message to an error as it crosses a layer — the message closure only runs
// if the error actually propagates. Errors are plain text, so each
// `.context()` crossed on the way out prepends to the same chain.
fn read_raw() -> String ? {
    return Err("file not found")
}

fn parse_config(path: String) -> String ? {
    raw :: read_raw()?
    return Ok(raw)
}

fn load_config(path: String) -> String ? {
    cfg :: parse_config(path).context("loading config {path}")?
    return Ok(cfg)
}

fn run() {
    if load_config("app.toml") == {
        Ok(v) -> {
            print("ok: {v}")
        }
        Err(e) -> {
            print("failed: {e#Debug}")
        }

    }
}
