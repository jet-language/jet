// 72 — Typed error families + error conversion (D-ERR-CONV, ratified 2026-06-19).
// Demonstrates `impl Source -> Target { … }` and `?` auto-applying it.
enum FileErr {
    NotFound(String)
    PermDenied
}

enum ParseErr {
    Empty
    BadInt(String)
}

enum AppErr {
    File(FileErr)
    Parse(ParseErr)
    Missing(String)
}

// D-ERR-CONV: declare how each lower-level error becomes an AppErr.
impl FileErr -> AppErr { return AppErr.File(self) }

impl ParseErr -> AppErr { return AppErr.Parse(self) }

fn read_file(path: String) -> String ? FileErr {
    if path == "" {
        return Err(FileErr.NotFound("(empty path)"))
    }
    return Ok("42")
}

fn parse_int(s: String) -> Int ? ParseErr {
    if s == "" {
        return Err(ParseErr.Empty)
    }
    if s == "x" {
        return Err(ParseErr.BadInt(~s))
    }
    return Ok(42)
}

// Both `?` calls cross error-type boundaries via the declared conversions.
fn load(path: String) -> Int ? AppErr {
    raw :: read_file(path)?  // FileErr  -> AppErr.File  (declared)
    port :: parse_int(raw)?  // ParseErr -> AppErr.Parse (declared)
    return Ok(port)
}

fn run() {
    // Happy path: `?` applies declared conversions; fallback to 0.
    n :: load("config.txt") ?? 0
    print(n)
    // Trigger FileErr -> AppErr conversion via ?
    if load("") == {
        Ok(v) -> {
            print(v)
        }
        Err(e) -> {
            print("error")
        }
        else -> {

        }
    }
}
