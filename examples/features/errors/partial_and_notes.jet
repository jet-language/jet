// D-FAIL-CARRIER1=A — the middle states of the one outcome carrier.
//
// An outcome has three independent facts: a payload, a verdict, and the
// reports it collected. Success and failure are the two corners people already
// know. The middle states are the ones real programs need and could not say:
// a failure that still produced part of the result, and an outcome worth a
// note. Both are the same carrier, so neither needs a third type.
//
// Both facts live on the outcome value. An error type opts in by carrying the
// surviving payload under `partial` and what it has to say under `notes`. Two
// outcomes therefore never share a fact, and reading one twice answers the
// same thing both times.
struct ImportErr {
    broken: Int
    partial: [String]
    notes: [String]
}

fn import_rows(label: String, rows: [String]) => [String] ? ImportErr {
    good :: rows.filter((row) => row != "")
    broken :: rows.len() - good.len()
    if broken > 0 {
        return Err(ImportErr.{
            broken: broken,
            partial: good,
            notes: ["{label}: {broken} rows were empty"]
        })
    }
    return Ok(good)
}

fn run() {
    // Two spotty imports, alive at the same time. Each one carries its own
    // notes, because the notes are part of the outcome and not of the program.
    people :: import_rows("people", ["ada", "", "alan", "", "grace"])
    ports :: import_rows("ports", ["80", "", "443"])

    print((people.partial() ?? []).join(", "))
    print((ports.partial() ?? []).join(", "))
    print(people.notes().join(" / "))
    print(ports.notes().join(" / "))

    // Reading the same outcome again answers the same thing. Nothing was
    // consumed, because nothing was stored beside the value.
    print(people.notes().join(" / "))
    print((people.partial() ?? []).len())

    // A clean import kept nothing back and had nothing to say, so the same two
    // reads answer an absence and an empty list. One carrier, one way to ask.
    clean :: import_rows("clean", ["ada", "alan"])
    print((clean.partial() ?? ["nothing was held back"]).join(", "))
    print(clean.notes().len())
}
