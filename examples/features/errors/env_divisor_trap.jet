// #1483: dividing by an args-derived value traps at runtime with the Prelude
// wording — never E0953 "your comptime code stopped the build".
// The typed CLI value is read at run time (I9 with AOT); a missing value
// falls through to the field default of 0.
#CLI
struct DivisorArgs {
    divisor: Int{0}
}

fn run(args: DivisorArgs) {
    n :: 10 /% args.divisor
    print(n)
}
