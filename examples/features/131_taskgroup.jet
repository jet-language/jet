// 131 — D-TASKSCOPE1=A / D-NURSERY1=A: structured `taskgroup` (c102).

fn sum_range(first: Int, last: Int) -> Int {
    total := 0
    loop n in first..last {
        total = (total + n)
    }
    return total
}

fn fast_val() -> Int {
    return 42
}

fn main() {
    taskgroup g {
        print("inside taskgroup")
        a #= g.task { sum_range(1, 25) }
        b #= g.task { sum_range(26, 50) }
        results #= g.all([a, b])
        print((results[0] + results[1]))
        slow #= g.task { sum_range(1, 500000) }
        fast #= g.task { fast_val() }
        winner #= g.race([slow, fast])
        print(winner)
    }
}
