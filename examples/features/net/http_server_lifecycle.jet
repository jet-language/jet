// D-HTTP-SERVER2=A: one bound Server owns bounded serve and graceful shutdown.
use core.http.server as http_server
use core.tasks as tasks
use core.time as time

fn run() {
    mux :: http_server.mux()
    mux.get("/", (req: HttpSrvReq) => http_server.response(200, "ok"))
    server :: http_server.bind("127.0.0.1:0", mux) ?? panic("bind")
    addr :: server.local_addr() ?? panic("local address")
    print(addr.starts_with("127.0.0.1:"))
    serving :: tasks.spawn(() => server.serve() ?? panic("serve"))
    time.sleep(20)
    grace :: Duration.milliseconds(100) ?? panic("duration")
    report :: server.shutdown(grace) ?? panic("shutdown")
    print(report.cancelled)
    print(serving.join().completed)
}
