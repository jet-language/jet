// D-HTTP-SERVER2=A: one bound Server owns bounded serve and graceful shutdown.
use core.http.server as http_server
use core.tasks as tasks
use core.time as time

fn run() ? {
    mux :: http_server.mux()
    mux.get("/", (req: HTTPRequest) => Ok(http_server.response(200, "ok")))
    server :: http_server.bind("127.0.0.1:0", mux)?
    addr :: server.local_addr()?
    print(addr.starts_with("127.0.0.1:"))
    serving :: task { server.serve() ?? return }
    time.sleep(20)
    grace :: Duration.milliseconds(100)?
    report :: server.shutdown(grace)?
    print(report.cancelled)
    serving.join()?
}
