// D-BROWSER-AUTO1=A (#1194): acceptance matrix for the shipped browser surface.
// Rows map to cards #1187–#1193. Live endpoints come from the host; this example
// documents the matrix the focused tests execute without skip/fallback.
use core.browser as browser

fn profile_ok(name: String) => String {
    browser.profile(name) ?? return "false"
    return "true"
}

fn run() {
    print("matrix:1187.locked_provision")
    print("matrix:1188.lifecycle_context_page_tab_frame")
    print("matrix:1189.locators_actions_waits")
    print("matrix:1190.events_network_intercept")
    print("matrix:1191.artifacts_files_screenshot_pdf")
    print("matrix:1192.checked_expert_cdp")
    print("matrix:1193.privacy_isolation_receipt_cleanup")
    print("matrix:1194.closeout_hostile_agent")
    // Profile pins stay offline-checkable without a live browser.
    print("profile:{profile_ok("bidi-2025.5")}")
}
