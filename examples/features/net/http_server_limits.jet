// D-HTTP-SERVER2=A: reject ambiguous framing and oversized bodies before handlers run.
use core.http.server as Server
use core.net as net
use core.tasks as tasks

fn run() {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("bind")
    addr :: listener.local_addr() ?? panic("address")
    mux :: Server.mux()
    mux.post("/", (req: HttpSrvReq) => Server.response(200, "handler ran"))

    server :: tasks.spawn(take(listener, mux) () => {
        Server.serve_once_listener(listener, mux) ?? panic("serve smuggling")
        Server.serve_once_listener(listener, mux) ?? panic("serve body limit")
    })

    smuggling :: net.tcp_connect(addr) ?? panic("connect smuggling")
    smuggling.write_all("POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n".bytes()) ?? panic("write smuggling")
    print(smuggling.read_text(8192) ?? panic("read smuggling"))

    oversized :: net.tcp_connect(addr) ?? panic("connect oversized")
    oversized.write_all("POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 1048577\r\n\r\n".bytes()) ?? panic("write oversized")
    print(oversized.read_text(8192) ?? panic("read oversized"))
    server.join()
}
