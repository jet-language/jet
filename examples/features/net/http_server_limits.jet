// D-HTTP-SERVER2=A: reject ambiguous framing and oversized bodies before handlers run.
use core.http.server as http_server
use core.net as net
use core.tasks as tasks

fn run() ? {
    listener :: net.tcp_listen("127.0.0.1:0")?
    addr :: listener.local_addr()?
    mux :: http_server.mux()
    mux.post("/", (req: HTTPRequest) => Ok(http_server.response(200, "handler ran")))
    server :: task {
        http_server.serve_once_listener(listener, mux) ?? return
        http_server.serve_once_listener(listener, mux) ?? return
    }
    smuggling :: net.tcp_connect(addr)?
    smuggling_request := "".bytes()
    loop line,
        ["POST / HTTP/1.1", "Host: local", "Content-Length: 4", "Transfer-Encoding: chunked", "", "0", ""] {
        loop byte, line.bytes() { smuggling_request.push(byte) }
        smuggling_request.push(13)
        smuggling_request.push(10)
    }
    smuggling.write_all(smuggling_request)?
    smuggling_response :: smuggling.read_text(8192)?
    print(smuggling_response.starts_with("HTTP/1.1 400 Bad Request"))
    print(smuggling_response.contains("handler ran"))
    oversized :: net.tcp_connect(addr)?
    oversized_request := "".bytes()
    loop line, ["POST / HTTP/1.1", "Host: local", "Content-Length: 1048577", ""] {
        loop byte, line.bytes() { oversized_request.push(byte) }
        oversized_request.push(13)
        oversized_request.push(10)
    }
    oversized.write_all(oversized_request)?
    oversized_response :: oversized.read_text(8192)?
    print(oversized_response.starts_with("HTTP/1.1 413 Payload Too Large"))
    print(oversized_response.contains("handler ran"))
    server.join()?
}
