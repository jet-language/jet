// core.http.server: function-first mux with path params.
use core.http.server as http_server
use core.net as net
use core.tasks as tasks

fn run() {
    mux :: http_server.mux()
    mux.get("/", (req: HttpSrvReq) => http_server.response(200, "hello from mux"))
    mux.get("/ping", (req: HttpSrvReq) => http_server.response(200, "pong"))
    mux.post("/echo", (req: HttpSrvReq) => http_server.response(200, req.body()))
    print("mux ready")
}
