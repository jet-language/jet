// D-NETSOCKET1=A: typed addresses, TCP echo, UDP datagrams, Unix sockets.
use core.files as fs
use core.net as net
use core.tasks as tasks
use core.time as time

fn run() {
    typed :: net.socket_addr("127.0.0.1", 0) ?? panic("socket addr")
    listener :: net.tcp_listen_addr(typed) ?? panic("tcp bind")
    local :: net.listener_local_socket_addr(listener) ?? panic("tcp local addr")
    print("tcp-listen:{net.socket_host(local)}")

    (ready_tx, ready_rx) :: tasks.channel<String>()
    tcp_task :: tasks.spawn(take(listener, ready_tx) () => {
        ready_tx.send(net.socket_to_string(net.listener_local_socket_addr(listener) ?? panic("tcp local addr")))
        stream :: listener.accept() ?? panic("tcp accept")
        msg :: stream.read_text(8192) ?? panic("tcp read")
        stream.write_all("tcp:{msg}".bytes()) ?? panic("tcp write")
    })

    addr :: ready_rx.receive() ?? panic("tcp addr")
    client :: net.tcp_connect(addr) ?? panic("tcp connect")
    net.set_timeout(&client, 1000) ?? panic("tcp timeout")
    client.write_all("ping".bytes()) ?? panic("tcp client write")
    print(client.read_text(8192) ?? panic("tcp client read"))
    client.close() ?? panic("tcp close")
    client.close() ?? panic("tcp close idempotent")
    tcp_task.join()

    udp_server :: net.udp_bind("127.0.0.1:0") ?? panic("udp bind")
    udp_addr :: net.udp_local_addr(udp_server) ?? panic("udp local addr")
    udp_client :: net.udp_bind("127.0.0.1:0") ?? panic("udp client")
    net.udp_set_timeout(udp_client, 1000) ?? panic("udp timeout")
    _sent :: net.udp_send_bytes_to(udp_client, "pong".bytes(), udp_addr) ?? panic("udp send")
    packet :: net.udp_receive(udp_server, 128) ?? panic("udp recv")
    print("udp:{net.udp_packet_bytes(packet)}:{net.udp_packet_original_len(packet)}:{net.udp_packet_truncated(packet)}")

    path :: "/tmp/jet-socket-echo-{time.now()}.sock"
    unix_listener :: net.unix_listen(path) ?? panic("unix bind")
    (unix_tx, unix_rx) :: tasks.channel<String>()
    unix_task :: tasks.spawn(take(unix_listener, unix_tx) () => {
        unix_tx.send("ready")
        s :: net.unix_accept(unix_listener) ?? panic("unix accept")
        msg :: net.unix_read(&s) ?? panic("unix read")
        net.unix_write_all_bytes(&s, "unix:{msg}".bytes()) ?? panic("unix write")
    })
    _ready :: unix_rx.receive() ?? panic("unix ready")
    unix_client :: net.unix_connect(path) ?? panic("unix connect")
    net.unix_write_all_bytes(&unix_client, "ok".bytes()) ?? panic("unix client write")
    print(net.unix_read(&unix_client) ?? panic("unix client read"))
    net.unix_close(&unix_client) ?? panic("unix close")
    net.unix_close(&unix_client) ?? panic("unix close idempotent")
    unix_task.join()
    fs.remove(path) ?? return
}
