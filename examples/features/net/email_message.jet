use core.email as email
use core.crypto as crypto

fn run() ? {
    from :: email.address("Mara ☕ <mara@example.com>")?
    to :: email.address("Ada <ada@example.net>")?
    attachment :: email.attachment("hello.txt", "text/plain", [104, 105])?
    message :: email.message(from, [to], [], "Welcome ☕", "Hello", "<b>Hello</b>", [attachment])?
    password :: crypto.Secret.from_text("example-only")
    config :: email.SMTPConfig.{
        host: "localhost",
        port: 465,
        security: .TLS,
        auth: .Password.{username: "mailer", password: password},
        recipient_policy: .RequireAll,
        trust: .System,
        limits: email.Limits.safe(),
        dkim: None
    }
    mailer :: email.smtp(config)?
    bytes :: email.serialize(message)?
    print(bytes.len() > 0)
}
