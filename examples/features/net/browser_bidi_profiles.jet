// D-BROWSER-AUTO1=A: Browser profiles are pinned client command contracts.
use core.browser as browser

fn profile_outcome(name: String) => String {
    profile :: browser.profile(name) ?? return "rejected"
    return "accepted"
}

fn timeout_outcome(milliseconds: Int) => String {
    timeout :: browser.timeout(milliseconds) ?? return "rejected"
    return "accepted"
}

fn run() {
    print("2024.11:{profile_outcome("bidi-2024.11")}")
    print("2025.5:{profile_outcome("bidi-2025.5")}")
    print("rolling:{profile_outcome("rolling")}")
    print("timeout:{timeout_outcome(500)}")
}
