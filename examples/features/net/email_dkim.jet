use core.crypto as crypto
use core.email as email

fn run() {
    key :: crypto.Secret.from_text("0123456789abcdef0123456789abcdef")
    password :: crypto.Secret.from_text("example-only")
    dkim := email.DkimConfig.{
        domain: "example.com",
        selector: "login-2026",
        private_key: key,
        signed_headers: ["from", "to", "subject", "mime-version", "content-type"],
    }
    config := email.SmtpConfig.{
        host: "smtp.example.com",
        port: 587,
        security: .StartTls,
        auth: .Password.{ username: "mailer", password: password },
        recipient_policy: .RequireAll,
        trust: .System,
        limits: email.Limits.safe(),
        dkim: Val(dkim),
    }
    mailer := email.smtp(config) ?? panic("invalid DKIM mailer policy")
    print("DKIM mailer ready for login-2026._domainkey.example.com")
}
