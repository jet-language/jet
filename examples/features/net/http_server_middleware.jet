// D-HTTP-SERVER2=A: middleware composes on the same Handler server engine.
use core.http.client as http_client
use core.http.server as http_server
use core.tasks as tasks
use core.time as time

fn outer(next: HTTPHandler) => HTTPHandler {
    owned :: ~next
    return (req: HTTPRequest) => {
        if owned.handle(req) == {
            .Ok(response) -> {
                return Ok(http_server.response(response.status(), "outer>{response.body().text(1048576) ?? "invalid body"}<outer"))
            }
            .Err(error) -> { return Err(error) }
        }
    }
}

fn inner(next: HTTPHandler) => HTTPHandler {
    owned :: ~next
    return (req: HTTPRequest) => {
        if req.path() == "/blocked" { return Ok(http_server.response(403, "blocked")) }
        if owned.handle(req) == {
            .Ok(response) -> {
                return Ok(http_server.response(response.status(), "inner>{response.body().text(1048576) ?? "invalid body"}<inner"))
            }
            .Err(error) -> { return Err(error) }
        }
    }
}

fn run() ? {
    mux :: http_server.mux()
    http_server.request_id(mux)
    mux.middleware(outer)
    mux.middleware(inner)
    mux.get("/ok", (req: HTTPRequest) => Ok(http_server.response(200, "handler")))
    mux.get("/blocked", (req: HTTPRequest) => Ok(http_server.response(200, "must not run")))
    server :: http_server.bind("127.0.0.1:0", mux)?
    addr :: server.local_addr()?
    serving :: task { server.serve() ?? return }
    time.sleep(20)
    success :: http_client.get("http://{addr}/ok")?
    print(success.status())
    print(success.body().text(1048576)?)
    blocked :: http_client.get("http://{addr}/blocked")?
    print(blocked.status())
    print(blocked.body().text(1048576)?)
    grace :: Duration.milliseconds(100)?
    server.shutdown(grace)?
    serving.join()?
}
