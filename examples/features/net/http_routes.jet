// D-ROUTE1=A (c83): HTTP router — registration, :param extraction, 404/405.
// router.get/post register routes; req.param("name") reads :param segments.
// http.dispatch(router, req) resolves method+path to the right handler.
// http.serve(addr, router) is the production path; for golden-test determinism
// we drive 4 connections manually so output order is fixed.
use core.http as http
use core.net as net
use core.tasks as tasks

fn handle_root(req: HttpRequest) -> HttpResponse {
    return HttpResponse.{status: "200 OK", body: "welcome", headers: []}
}

fn handle_user(req: HttpRequest) -> HttpResponse {
    id :: req.param("id") ?? "unknown"
    return HttpResponse.{status: "200 OK", body: "user={id}", headers: []}
}

fn handle_create(req: HttpRequest) -> HttpResponse {
    return HttpResponse.{status: "201 Created", body: "created", headers: []}
}

fn run() {
    router :: http.router()
    router.get("/", handle_root)
    router.get("/users/:id", handle_user)
    router.post("/users", handle_create)
    (sender, ch) :: tasks.channel<String>()
    tasks.spawn(take(sender, router) () => {
        listener :: net.tcp_listen("127.0.0.1:0") ?? panic("bind failed")
        addr :: listener.local_addr() ?? panic("address failed")
        sender.send(~addr)
        // Serve exactly 4 connections then let the task exit.
        loop i; [0, 1, 2, 3] {
            stream :: listener.accept() ?? panic("accept failed")
            raw :: stream.read_text(8192) ?? panic("read failed")
            req :: http.parse(raw)
            resp :: http.dispatch(router, req)
            net.tcp_reply(^stream, resp.status(), resp.body()) ?? panic("tcp reply")
        }
    })
    addr :: ch.receive() ?? panic("no address")
    // 1: GET / → "welcome"
    r1 :: http.get("http://{addr}/") ?? panic("GET / failed")
    print(r1.body())
    // 2: GET /users/42 → "user=42"
    r2 :: http.get("http://{addr}/users/42") ?? panic("GET /users/42 failed")
    print(r2.body())
    // 3: POST /users → "created"
    r3 :: http.post("http://{addr}/users", "") ?? panic("POST /users failed")
    print(r3.body())
    // 4: GET /missing → 404
    r4 :: http.get("http://{addr}/missing") ?? panic("GET /missing failed")
    print(r4.status())
}
