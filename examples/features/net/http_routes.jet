// D-ROUTE1=A: HTTP router — registration, :param extraction, 404/405.
// mux.get/post register routes; req.param("name") reads :param segments.
// serve_once_listener drives one connection at a time so golden output order
// stays fixed.
use core.http.client as http
use core.http.server as server
use core.net as net
use core.tasks as tasks

fn handle_root(req: HttpRequest) => HttpResponse ? HttpError = Ok(server.response(200, "welcome"))

fn handle_user(req: HttpRequest) => HttpResponse ? HttpError {
    id :: req.param("id") ?? "unknown"
    return Ok(server.response(200, "user={id}"))
}

fn handle_create(req: HttpRequest) => HttpResponse ? HttpError = Ok(server.response(201, "created"))

fn run() {
    listener :: net.tcp_listen("127.0.0.1:0") ?? panic("bind failed")
    addr :: listener.local_addr() ?? panic("address failed")
    mux :: server.mux()
    mux.get("/", (req: HttpRequest) => handle_root(req))
    mux.get("/users/:id", (req: HttpRequest) => handle_user(req))
    mux.post("/users", (req: HttpRequest) => handle_create(req))
    t :: tasks.spawn(() => {
        loop i; [0, 1, 2, 3] { server.serve_once_listener(listener, mux) ?? panic("serve failed") }
    })
    r1 :: http.get("http://{addr}/") ?? panic("GET / failed")
    print(r1.body().text(8388608) ?? panic("body failed"))
    r2 :: http.get("http://{addr}/users/42") ?? panic("GET /users/42 failed")
    print(r2.body().text(8388608) ?? panic("body failed"))
    r3 :: http.post("http://{addr}/users", "") ?? panic("POST /users failed")
    print(r3.body().text(8388608) ?? panic("body failed"))
    r4 :: http.get("http://{addr}/missing") ?? panic("GET /missing failed")
    print(r4.status())
    t.join()
}
