// D-JPK-TASKRUN1 (card #476) — project tasks are Jet `#Task fn`s.
// Invoke: `jet run --task greet <this-file>` / `jet run --task seed <this-file>`.
// Cross-task dependency = a plain call (`seed` calls `greet` below).
// I5 golden runs both --task paths (see tests/golden.rs).
#Task fn greet() {
    print("hello from task")
}

#Task fn seed() {
    greet()
    print("seeded")
}

fn run() { print("use jet run --task greet <this-file>") }
