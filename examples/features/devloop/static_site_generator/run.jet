// D-DEVSTATIC1: `jet dev` runs a generator, serves its output, and reloads it
// when the generator or one of its filesystem inputs changes.
use core.files as fs

fn run() {
    headline := "hello from the static generator"
    if fs.exists("content.txt") {
        headline = fs.read("content.txt")
    }

    fs.create_dir_all("dist")
    page :: "<!doctype html><html><body><h1>{headline}</h1></body></html>"
    fs.write("dist/index.html", page)
    if fs.exists("widget.wasm") {
        fs.copy("widget.wasm", "dist/widget.wasm")
    }
    print("generated: {headline}")
}
