// D-SCHEDULE1 (ratified 2026-07-11, card #505) — schedule-as-code.
// `#Every(…)` is a directive marker on a `#Job fn` (D-JPK-TASKRUN1): one
// declaration feeds `jet dev` (runs due jobs in the dev loop), the service
// runtime (D-SERVICE1), and a jetos timer projection. `#Every(2h)` takes a
// duration literal from the canonical Time family (`ns`/`us`/`ms`/`s`/`min`/`h`/`d`);
// `#Every("03:00")` takes a daily wall-clock time. A `#Job fn` with no `#Every(…)` is a plain
// manually-invoked job (`jet run <this-file> -- manual_only`).
//
// Calling a `#Job fn` directly remains an ordinary function call; the schedule
// only changes when a runtime consumer invokes it automatically. The service
// runtime and jetos consumers use the same checked schedule metadata.
#[Job(.Dev), Every(5min)] fn prune_sessions() { print("pruning sessions") }

#[Job(.Dev), Every(2h)] fn refresh_indexes() { print("refreshing indexes") }

#[Job(.Dev), Every(1d)] fn compact_archive() { print("compacting archive") }

#[Job(.Dev), Every("03:00")] fn nightly_backup() { print("running nightly backup") }

#Job(.Ship) fn manual_only() { print("ran manually") }

fn run() {
    prune_sessions()
    refresh_indexes()
    compact_archive()
    nightly_backup()
    manual_only()
}
// --- expected output --------------------------------------------------
// pruning sessions
// refreshing indexes
// compacting archive
// running nightly backup
// ran manually
