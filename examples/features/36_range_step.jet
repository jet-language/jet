// 36 — Counting with a stride: `step` on a range (S22, D-SG8).
fn main() {
    // `a..b` is inclusive (S22); `step n` counts every nth value.
    print("evens 0 to 10:");
    loop n in 0..10 step 2 {
        print("  {n}");
    }
    // The default stride is 1 when you omit `step`.
    print("down the row:");
    loop n in 1..3 {
        print("  {n}");
    }
    // `step` is just a name elsewhere — only special inside a range.
    val step = 5;
    print("a value named step: {step}");
}
