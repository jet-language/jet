// D-SHAREDGUARD-PROJECTION1: map and split an edit guard into direct fields.
struct Pair {
    left: Int
    right: Int
}

fn project_left(state: Shared<Pair>) Int -> {
    guard :: state.guard_edit()
    projected :: guard.map(value -> value.left)
    return projected.value
}

fn project_both(state: Shared<Pair>) (left: Int, right: Int) -> {
    guard :: state.guard_edit()
    (first, second) :: guard.split(value -> value.left, value -> value.right)
    return (left: first.value, right: second.value)
}

fn run() {
    state :: shared Pair{left: 7, right: 11}
    print(project_left(state))
    pair :: project_both(state)
    print(pair.left)
    print(pair.right)
}
