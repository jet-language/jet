// D-MEM-FACTS1=B: no_alloc is a strict transitive memory fact. Sema checks
// allocation events in every reachable Jet body and rejects open dispatch or
// unavailable dependency evidence. Every reachable operation below is scalar
// or reference-only, so the module proves the fact.
@Policy(no_alloc)

struct Entity {
    pos: Float
    vel: Float
}

fn integrate(e: &Entity, dt: Float) {
    e.pos += e.vel * dt
}

fn run() {
    e := Entity.{ pos: 0.0, vel: 1.0 }
    integrate(&e, 2.0)
    // No interpolation here — `"{e.pos}"` would itself allocate a fresh
    // `String` (E0921); a static literal (no `{…}` hole) is one constant
    // piece of text, not "concatenation/interpolation that produces a new
    // String", so it is compatible with the transitive `no_alloc` fact.
    print("integrated ok")
}
