struct Resource {
    name: String
}

impl Resource.Close {
    fn close(^self) { print("close {self.name}") }
}

fn make() Int -> {
    first := Resource{name: "first"}
    defer close(^first)
    second := Resource{name: "second"}
    defer close(^second)
    print("body")
    return 7
}

fn run() {
    print(make())
}
