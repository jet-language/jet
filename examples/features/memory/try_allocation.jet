// D-ALLOCFAIL1=A (ratified 2026-08-12): fallible allocation is a value.
// Freestanding-safe: Fixed owns one compile-time inline buffer, so exhaustion
// is deterministic and does not call the hosted aborting allocator.
// Run with: jet run examples/features/memory/try_allocation.jet
use core.mem

fn run() {
    fixed :: mem.Fixed.new(size: 40)

    fixed.try_alloc(7) ? value -> {
        print("success {value}")
    } ! error -> {
        print("unexpected failure {error.requested_bytes} {error.allocator}")
    }

    fixed.try_alloc(9) ? value -> {
        print("unexpected success {value}")
    } ! error -> {
        print("failure {error.requested_bytes} {error.allocator}")
    }
}
