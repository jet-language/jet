// D-UNINIT1: plain-data scratch without zero-fill — written before any read.
// (Fixed-array index-write in `#Uninit` bindings is sema-proved; TIR coverage for
// `[T#N]` index-assign is a follow-up — this example stays scalar for golden parity.)
use core.mem

fn main() {
    #Uninit n: Int
    n = 8
    print(n)
}
