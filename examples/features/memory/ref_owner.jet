// D-REF-SHORTHAND1: a `&T` field stores a reference into an owner instead of
// its own copy. When exactly one in-scope value has the referent type, the
// owner is inferred — zero ceremony, no label.
struct TokenView {
    text: &String
}

fn show(source: String) {
    t: TokenView :: TokenView.{ text: source }
    print(t.text)
}

fn main() {
    show("hello")
}
