// D-ALLOC-PROGRAM1=A: package.jet wraps the hidden system heap once for the
// whole hosted program. The request exceeds its 2 GB cap on every tier, and
// the fallible Core collection API reports that policy without aborting.
fn run() {
    allocation :: List<Int>.try_with_capacity(400_000_000)
    if allocation == {
        .Ok(_values) -> {
            print("unexpected allocation success")
        }
        .Err(_error) -> {
            print("program allocator cap reached")
        }
    }
}
