// D-PIN1=A / D-PIN2=A / D-PIN3=A: `Pin<T>` is the address-stability contract.
// Most values survive being moved to a new address. A value that stores an
// address into itself, or that another value links to, does not — after a move
// every stored address points at the old place. `mem.pin(&place)` opens a
// tracked write window on `place` and promises that safe code will not move,
// replace, or resize it while the window is live (E0219). Reading and editing
// through the pin stay legal, and the edits land in the caller's storage.
//
// The mark for a field that carries the same promise is the field's own type: a
// field declared `Pin<T>` projects to `Pin<T>` through a pinned value
// (D-PIN3=A), and every other field projects as an ordinary value. That is the
// one expert stored-window exception to "a struct field owns its value"
// (see ref_field.jet).
//
// Criterion 2: unsafe construction stays inside the library. Call sites never
// write `#Unsafe` — they receive a ready `Pin<T>` from a safe API.
use core.mem

struct Node {
    payload: Int
    hops: Int
}

// Self-referential node: `self_addr` names this place's payload once wiring
// finishes. The raw address write is audited locally; callers stay safe.
struct SelfNode {
    payload: Int
    self_addr: Int
}

// An intrusive queue. It never allocates a node: the caller owns the storage
// and lends it, so `Queue` records the promise instead of copying the node.
struct Queue {
    label: String
    head: Pin<Node>
}

// Safe public API: the `#Unsafe` block stays inside the function body. Callers
// of `wire_self` do not need an audited region (D-PIN1 step 5 / criterion 2).
fn wire_self(node: &SelfNode) => Pin<SelfNode> {
    #Unsafe("node storage is fixed for the returned pin; self_addr names this place") {
        node.self_addr = mem.address_of(node.payload)
    }
    return mem.pin(&node)
}

fn run() {
    // Caller storage: no allocator, no heap node, no copy of `node`.
    node := Node.{payload: 41, hops: 0}
    pinned :: mem.pin(&node)

    // Editing through the pin is legal and lands in `node` itself; only moving
    // or replacing the pinned storage is rejected.
    pinned.hops += 1
    pinned.hops += 1
    pinned.payload += 1

    // The queue stores the same promise. `head` is declared `Pin<Node>`, so
    // reaching it through the queue projects to a pin again (D-PIN3=A) rather
    // than to a copy of the node.
    queue :: Queue.{label: "ready", head: mem.pin(&node)}
    print("label: {(queue.label)}")
    print("payload: {(queue.head.payload)}")
    print("hops: {(queue.head.hops)}")

    // Self-referential construction through a safe library API (criterion 2+5).
    self_node := SelfNode.{payload: 7, self_addr: 0}
    self_pinned :: wire_self(&self_node)
    print("self_payload: {(self_pinned.payload)}")
    print("self_wired: {(self_pinned.self_addr != 0)}")
}
