// D-SHAPE-COPY1=A (supersedes D-CAP2/D-MEM1/S4): `~x` — the one copy sigil.
// Produces a fresh, independent value from a named binding; a temporary, so
// it never needs `^` and never trips E0209 (unlike passing `x` itself to a
// move param). `.clone()` is not user-typable Jet syntax — `~x` is the only
// spelling.
struct Ticket {
    id: Int
    label: String
}

// D-MEM-COPYSEM1=A: a read-only view entering an owned return slot is copied
// automatically through the same semantic path as `~`. `~` remains the one
// explicit spelling when the boundary is intentional in source.
fn implicit_domain() :> String {
    email := "nate@jet.dev"
    domain :: email.after("@")
    return domain
}

fn implicit_window() :> [Int] {
    values := [1, 2, 3]
    window :: values[0..1]
    return window
}

fn archive(t: ^Ticket) :> String :: t.label

fn run() {
    name :: "vault"
    saved :: ~name
    print(name)
    print(saved)
    n :: 5
    m :: ~n
    print(n)
    print(m)
    print(implicit_domain())
    print(implicit_window()[1])
    t :: Ticket{id: 1, label: "root"}
    print(archive(~t))
    print(t.label)
}
