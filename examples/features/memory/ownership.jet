// Ownership (M2 / D-MEM1): unmarked is read by default, `&` to write/change,
// `^` to move, `~x` to copy (D-SHAPE-COPY1=A). Functions below use read borrows by
// default, explicit write borrows, or explicit takes; returned values are owned. v5 has no borrow-return form
// (`-> &T` is not in the grammar; see docs/spec/syntax-decisions.md D-MEM1).
fn show(msg: String) { print(msg) }

fn bump(n: &Int) { n += 1 }

fn archive(name: ^String) => String = name

fn headline(text: String) => String = "== {text} =="

fn length(text: String) => Int = text.len()

fn apply(reader: fn(String) => Int, text: String) => Int = reader(text)

fn run() {
    score := 41
    bump(&score)
    print(score)
    greeting :: "hello"
    show(greeting)
    print(greeting)
    print(apply(length, greeting))
    print(apply((text: String) => text.len(), greeting))
    saved :: archive(^"vault")
    print(saved)
    print(headline("Jet"))
}
