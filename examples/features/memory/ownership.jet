// Ownership (M2 / D-CAP7): default shared access, `~` to change, `^` to move,
// `.clone()` to copy, and `&` to hand back a borrow.
fn show(msg: String) {
    print(msg)
}

fn bump(n: ~Int) {
    n += 1
}

fn archive(name: ^String) -> String {
    return name
}

fn headline(text: String) -> &String {
    return text
}

fn run() {
    score: Int := 41
    bump(~score)
    print(score)
    greeting: String :: "hello"
    show(greeting)
    print(greeting)
    saved: String :: archive(^"vault")
    print(saved)
    print(headline("Jet"))
}
