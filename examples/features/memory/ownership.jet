// Ownership (M2 / D-MEM1): unmarked is read by default, `&` to write/change,
// `^` to move, `copy x` to copy (D-CAP2). Every function below takes and returns
// owned values or plain write-borrows — v5 has no borrow-return form
// (`-> &T` is not in the grammar; see docs/spec/syntax-decisions.md D-MEM1).
fn show(msg: String) {
    print(msg)
}

fn bump(n: &Int) {
    n += 1
}

fn archive(name: ^String) -> String {
    return name
}

fn headline(text: String) -> String {
    return "== {text} =="
}

fn run() {
    score: Int := 41
    bump(&score)
    print(score)
    greeting: String :: "hello"
    show(greeting)
    print(greeting)
    saved: String :: archive(^"vault")
    print(saved)
    print(headline("Jet"))
}
