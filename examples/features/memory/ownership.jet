// Ownership (M2 / D-MEM1): unmarked is read by default, `&` to write/change,
// `^` to move, `.clone()` to copy. `headline`'s `-> &String` borrow-return is
// a separate, still-live form (second-class borrows land in migration S3).
fn show(msg: String) {
    print(msg)
}

fn bump(n: &Int) {
    n += 1
}

fn archive(name: ^String) -> String {
    return name
}

fn headline(text: String) -> &String {
    return text
}

fn run() {
    score: Int := 41
    bump(&score)
    print(score)
    greeting: String :: "hello"
    show(greeting)
    print(greeting)
    saved: String :: archive(^"vault")
    print(saved)
    print(headline("Jet"))
}
