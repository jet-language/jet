struct SyntaxTree {
    source: String
    line_starts: Cell<[Int]?>
}

fn line_starts(tree: SyntaxTree) => [Int] {
    return tree.line_starts.get_or_set(() => {
        print("index built")
        return [0, tree.source.len()]
    })
}

fn run() {
    tree :: SyntaxTree.{
        source: "first\nsecond"
        line_starts: Cell.new(None)
    }
    print(line_starts(tree))
    print(line_starts(tree))
}
