// D-SHARED-CYCLE1=C: beginner strong Shared cycles are rejected (E0221).
// Expert intentional cycles use Shared.Weak back-edges. Free-when-strong-roots-
// drop is proved by Prelude unit tests (JetShared Weak Arc semantics); this
// example proves the Weak cycle surface with identical AOT / jet run output.
struct Node {
    label: String
    peer: Shared.Weak<Node>?
}

fn peer_label(n: Node) => String {
    if n.peer == .None {
        return "none"
    }
    if n.peer == .Val(weak) {
        if weak.upgrade() == .None {
            return "gone"
        }
        if weak.upgrade() == .Val(peer) {
            return peer.read(p => p.label)
        }
    }
    return "none"
}

fn run() {
    a := Shared.new(Node.{ label: "a", peer: None })
    b := Shared.new(Node.{ label: "b", peer: None })
    // Downgrade before edit so the closures do not move the strong handles.
    wa := a.downgrade()
    wb := b.downgrade()
    a.edit(n => { n.peer = Val(~wb) })
    b.edit(n => { n.peer = Val(~wa) })
    alive :: a.read(n => peer_label(~n))
    print("while-alive:{alive}")
    count :: a.strong_count()
    print("strong:{count}")
    // Fresh weak — wa/wb were moved into the edit closures above.
    up := a.downgrade()
    if up.upgrade() == .Val(_) {
        print("upgrade-ok")
    }
    if up.upgrade() == .None {
        print("upgrade-gone")
    }
}
