// D-SHAPE-PLACE1=A: bare range reads, `&` edits, `~` copies.
fn run() {
    xs := [1, 2, 3]

    if true {
        read :: xs[0..1]
        print(read[1])
    }

    if true {
        edit :: &xs[1..2]
        edit[0] = 9
    }
    print(xs[1])

    copied :: ~xs[0..1]
    xs[0] = 7
    print(copied[0])
}
