// D-MEMPROVENANCE3=A: parameter `from` requires the argument view to borrow
// from a named sibling parameter (Rust's 'b: 'a, spelled with names).

fn use_window(window: View<Int> from packet, packet: [Int]) {
    print(window[0])
}

fn run() {
    packet := [9, 8, 7]
    window :: packet[0..1]
    use_window(window, packet)
}
