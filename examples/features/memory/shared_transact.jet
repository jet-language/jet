// D-STM1=A (ratified 2026-07-12, card #506): the Shared plane of `#Transact`.
// A `#Transact` block that touches `Shared<T>` handles turns every `.edit`
// inside it into ONE atomic commit — either every handle's change lands or none
// does, and no concurrent task ever observes a half-applied transfer. The
// deferred edits are applied together at the block's end under all the handles'
// locks at once, taken in a canonical order that cannot deadlock. No new marker
// (I8): the same `#Transact` that already gives single-task rollback now spans
// shared state. An irreversible effect inside is still rejected (E0746).
use core.tasks as tasks

struct Account {
    balance: Int
}

// Move `amount` from one account handle to another, atomically. Under heavy
// concurrent load a second task can never read a total that is briefly wrong:
// the debit and the credit land together at the transaction's commit.
fn transfer(from: Shared<Account>, to: Shared<Account>, amount: Int) {
    #Transact(tx) {
        from.edit(a => { a.balance -= amount })  // both land, or neither
        to.edit(a => { a.balance += amount })    // no lock ordering to get wrong
    }
}

fn run() {
    from :: Shared.new(Account.{ balance: 1000 })
    to :: Shared.new(Account.{ balance: 0 })

    // Eight concurrent transfers of 100 each. Whatever order the runtime picks,
    // every transfer is atomic, so the final balances are deterministic and the
    // grand total is conserved exactly.
    t1 :: tasks.spawn(() => { transfer(from, to, 100) })
    t2 :: tasks.spawn(() => { transfer(from, to, 100) })
    t3 :: tasks.spawn(() => { transfer(from, to, 100) })
    t4 :: tasks.spawn(() => { transfer(from, to, 100) })
    t5 :: tasks.spawn(() => { transfer(from, to, 100) })
    t6 :: tasks.spawn(() => { transfer(from, to, 100) })
    t7 :: tasks.spawn(() => { transfer(from, to, 100) })
    t8 :: tasks.spawn(() => { transfer(from, to, 100) })
    t1.wait()
    t2.wait()
    t3.wait()
    t4.wait()
    t5.wait()
    t6.wait()
    t7.wait()
    t8.wait()

    from_bal :: from.read(a => a.balance)
    to_bal :: to.read(a => a.balance)
    print("from={from_bal}")
    print("to={to_bal}")
    print("total={from_bal + to_bal}")
}
