// D-MEMPROVENANCE3=A: function-type `from` names which callback args a returned
// view may borrow. Inference stays the default; this spelling is opt-in.

fn first_field(line: String, _noise: String) => View<str> {
    text :: line.before(":")
    return text
}

fn scan(
    input: String,
    noise: String,
    pick: fn(line: String, noise: String) => View<str> from line
) => View<str> from input {
    return pick(input, noise)
}

fn run() {
    packet := "alpha:beta"
    filler := "ignored"
    chosen :: scan(packet, filler, first_field)
    // `from line` keeps filler free while chosen is live.
    filler = "still ok"
    print(chosen)
    print(filler)
}
