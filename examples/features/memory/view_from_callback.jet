// D-MEMPROVENANCE3=A: function-type `from` names which callback args a returned
// view may borrow. Inference stays the default; this spelling is opt-in.
// Function types do not keep surface parameter names through fmt, so the
// owner spelling is the parser's synthetic `_N` index (same as an unnamed param).

fn first_field(line: String, _noise: String) => View<str> {
    text :: line.before(":")
    return text
}

fn scan(
    input: String,
    noise: String,
    pick: fn(String, String) => View<str> from _0
) => View<str> from input {
    return pick(input, noise)
}

fn run() {
    packet := "alpha:beta"
    filler := "ignored"
    chosen :: scan(packet, filler, first_field)
    // `from _0` keeps filler free while chosen is live.
    filler = "still ok"
    print(chosen)
    print(filler)
}
