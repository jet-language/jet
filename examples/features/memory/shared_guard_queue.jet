// D-SHAREDGUARD1=A / D-SHAREDGUARD2=A: expert guards keep manual control after
// D-CONC-SHARE1=A made ordinary shared access plain field reads and writes. A
// guard can span helpers and wait without missing a wake; plain access cannot.
struct WorkQueue {
    jobs: [Int]
    capacity: Int
}

fn produce(queue: Shared<WorkQueue>, changed: Condition) {
    guard :: queue.guard_edit()
    guard.wait(changed, value :> value.jobs.len() < value.capacity) ?? panic("wait failed")
    guard.value.jobs.push(7)
    changed.notify_all()
}

fn consume(queue: Shared<WorkQueue>, changed: Condition) {
    guard :: queue.guard_edit()
    _ :: guard.value.jobs.pop()
    changed.notify_one()
}

fn run() {
    queue := shared WorkQueue{jobs: [1], capacity: 1}
    changed := Condition.new()
    task.group workers {
        producer :: task produce(queue, changed)
        consume(queue, changed)
        producer.join() ?? panic("producer failed")
    }
    print(queue.jobs.first() ?? 0)
}
