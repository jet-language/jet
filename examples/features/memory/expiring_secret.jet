// D-TTLVAL1=A / D-TTL-ZEROIZE1=A: cache expiry plus the one secret wrapper.
use core.crypto as crypto
use core.vault as vault

fn run() {
    clk := Clock.new(1000)
    ttl :: Duration.seconds(5) ?? panic("duration")
    cache :: ExpiringValue.new("fresh", ttl, clk)
    if cache.get(clk) == .Ok(v) {
        print("cache: {v}")
    }
    clk.tick(6000)
    if cache.get(clk) == .Err(_) { print("cache expired: true") }
    secret_clk := Clock.new(1000)
    secret_ttl :: Duration.seconds(2) ?? panic("duration")
    key :: crypto.SigningKey.new_random() ?? panic("key")
    secret := vault.ExpiringSecret.new(^key, secret_ttl, secret_clk)
    if secret.with(borrowed => borrowed.public_key()) == .Ok(_) { print("secret available: true") }
    secret_clk.tick(3000)
    if secret.with(borrowed => borrowed.public_key()) == .Err(_) { print("secret expired: true") }
}
