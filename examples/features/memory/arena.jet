// D-ALLOC1 (ratified 2026-06-19): explicit arena allocators under `core.mem`.
// Four allocator names live under `core.mem`; this executable demonstrates
// the three #648 runtimes whose storage contracts are implementation-complete.
// No `@Unsafe` needed; `use core.mem` is the opt-in gate (E3102 if absent).
use core.mem

fn run() {
    // Arena: general-purpose grow-only allocator.
    arena :: mem.Arena.new()
    x :: arena.alloc(42)
    print(x)
    // Arena with capacity hint.
    sized :: mem.Arena.new(capacity: 4096)
    s :: sized.alloc("hello")
    print(s)
    // reset keeps the backing buffer; the arena is reusable.
    arena.reset()
    y :: arena.alloc(99)
    print(y)
    // Bump: one contiguous monotonic buffer until reset.
    bump :: mem.Bump.new(capacity: 64)
    b :: bump.alloc(7)
    print(b)
    // Pool: caller-bounded slots with retained size/alignment-class reuse.
    pool :: mem.Pool.new(slots: 8)
    p :: pool.alloc(3)
    print(p)
    // Fixed: compiler-synthesized inline backing, with payload and drop metadata
    // sharing exactly this compile-time byte budget.
    fixed :: mem.Fixed.new(size: 256)
    f :: fixed.alloc(1)
    print(f)
    // close is the same terminal release used by every resource.
    close(^arena)
    close(^bump)
    close(^pool)
    close(^fixed)
}
