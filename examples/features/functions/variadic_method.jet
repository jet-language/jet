// Variadic method: rest parameter packs like a free-function variadic (I8/I9).
struct Logger {
    id: Int
}

impl Logger {
    fn write(self, level: String, parts: ...String) => String {
        return [level, ...parts].join(" ")
    }
}

fn run() {
    log :: Logger.{ id: 0 }
    print(log.write("1"))
    print(log.write("2", "one"))
    print(log.write("3", "a", "b", "c"))
}
