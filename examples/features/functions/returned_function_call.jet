// D-CALLVALUE1=B: a returned function value uses the explicit `.call(...)`
// projection, whether it is first bound or invoked directly.
fn make_adder(base: Int) => fn(Int) => Int = (value: Int) => base + value

fn run() {
    add :: make_adder(40)
    print(add.call(2))
    print(make_adder(1).call(2))
}
