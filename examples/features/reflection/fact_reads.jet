// D-FACT-READ1=A: every compiler-held plane uses one typed `@` read.
#Numeric Severity :: distinct Int(0..10)
#UnitFamily(Length, dimension) { meter }

state Order { Draft, Confirmed }

struct Order {
    id: Int
}

fn send_report() =[IO]=> {}

@range :: Severity.@range
@effects :: send_report.@effects
@states :: Order.@states
@dimension :: Meter.@dimension
@package_name :: @build.package.name
@package_version :: @build.package.version
@os :: @build.os
@profile :: @build.profile
@sendability :: Severity.@sendability
@movedness :: Severity.@movedness
@attribution :: report.@attribution
@track_origin :: Severity.@track_origin
@view_provenance :: send_report.@view_provenance
@unit_scale :: Meter.@unit_scale_provenance
@maturity :: send_report.@maturity

fn run() {
    print(@range.start)
    print(@effects.values.len())
    print(@states[0].name)
    print(@dimension.axes.len())
    print(@package_name)
    print(@package_version)
    print(@profile)
    print(@sendability.known)
    print(@movedness.known)
    print(@attribution.source)
    print(@track_origin.tracked)
    print(@view_provenance.mutable)
}
