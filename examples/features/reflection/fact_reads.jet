// D-FACT-READ1=A: every compiler-held plane uses one typed `@` read.
#Numeric Severity :: distinct Int(0..10)

#UnitFamily(Length, dimension) { meter }

tag Audited { deny: [Net] }

struct PlaneFacts {
    approximate: F32
    shape: [Int#4]
    classified: #Audited Int
    callable: fn(value: Int) Int
}

struct Order {
    state { Draft, Confirmed }
    id: Int
}

fn send_report() {}

fn sendability_for(cell: Cell<Int>) Bool -> {
    @known :: cell.@sendability.known
    return @known
}

@range :: Severity.@range

@effects :: send_report.@effects

@states :: Order.@states

@dimension :: Meter.@dimension

@measure :: PlaneFacts.@measure

@exactness :: PlaneFacts.@exactness

@classification :: PlaneFacts.@classification

@obligation :: PlaneFacts.@obligation

@package_name :: @build.package.name

@package_version :: @build.package.version

@os :: @build.os

@profile :: @build.profile

@sendability :: Severity.@sendability

@movedness :: Severity.@movedness

@attribution :: report.@attribution

@origin :: Severity.@origin

@view_provenance :: send_report.@view_provenance

@unit_scale :: Meter.@unit_scale_provenance

@maturity :: send_report.@maturity

fn run() {
    print(@range.start)
    print(@effects.values.len())
    print(@states[0].name)
    print(@dimension.axes.len())
    print(@measure.kind == "length")
    print(@exactness.kind == .Approximate)
    print(@classification.name)
    print(@obligation.param_contract[0].zone == .Either)
    print(@package_name)
    print(@package_version)
    print(@profile)
    print(@sendability.known)
    print(@movedness.known)
    print(@attribution.source)
    print(@origin.tracked)
    print(@view_provenance.mutable)
    cell :: Cell.new(1)
    print(sendability_for(cell))
}
