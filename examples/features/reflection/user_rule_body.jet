// D-META-USER1=A: a source rule with a body adds an ordinary method.
marker Audited($sites: [.Type])
marker AddGreeting($sites: [.Type]) {
    tname :: target.name
    marker_count :: target.markers.len()
    emit("""
impl $tname {{
    fn greeting(self) => String {{
        return "hello"
    }}
    fn marker_count(self) => Int {{
        return $marker_count
    }}
}}
""")
}

#[Audited, AddGreeting]
struct Person { name: String }

fn run() {
    person :: Person.{name: "ada"}
    print(person.greeting())
    print(person.marker_count())
}
