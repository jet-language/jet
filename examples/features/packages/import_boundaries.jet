// D-STRUCT-EDGE1 / D-STRUCT-PLANE1: package-owned import boundaries are
// compile-time policy. The executable matrix names the five observable cases;
// tests/ui/import_boundary/ and tests/pkg.rs prove the manifest enforcement.
//
// allowed: app.ui -> app.db
// denied: app.ui -> app.secret (E0619)
// wildcard: app.api.* -> app.db.*
// absent key: today's import behavior
// zero-match rule: L0619
fn run() -[IO]> {
    print("allowed edge: app.ui -> app.db")
    print("denied edge: E0619")
    print("wildcard: app.api.* -> app.db.*")
    print("absent key: current import behavior")
    print("zero-match rule: L0619")
}
