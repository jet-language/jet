// A directory module (`service/module.jet`), not a root-level file — the
// migration-era `fn run` fallback only ever scans root-level files, so it
// cannot find this one. Only package.jet's `outputs: .{ demo:
// .Executable.{ entry: service.run } }` (via `entry.jet`'s `use service`)
// points `jet run`/`jet build` here.
pub fn run() {
    print("outputs: demo drives the build")
}
