// c81 / D-PLUGIN1=B / D-DEP-WASM1=A: the plugin's own source. Built with
// `--target=plugin` (see pkg.jet) instead of run directly — no `fn run()`,
// this package is loaded, not executed. v1 plugin exports are Int/Float-only
// scalar functions (D-PLUGIN-EXPORT1=A; see `Codegen::Plugin` module doc for
// why Bool/Text aren't wired yet) and may not use any effect — the wasmtime
// host that loads this registers zero host imports (D-PLUGIN1=B: safe by
// default, no `#Unsafe` gate anywhere in this story).
use core.math as math

pub fn scale(a: Float, b: Float) -> Float {
    return a * b
}

pub fn hypot(a: Float, b: Float) -> Float {
    return math.sqrt(a * a + b * b)
}

pub fn gcd(a: Int, b: Int) -> Int {
    x := a
    y := b
    loop y != 0 {
        t := y
        y = x % y
        x = t
    }
    return x
}
