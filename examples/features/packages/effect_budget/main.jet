// D-EFFBUDGET1: the effect budget is a `package.jet` manifest feature (see the
// `effects: { allow: [FS, Time] }` block in this example's package.jet), not new
// language grammar — this program just uses the effects that budget allows.
// `jet build` always prints a one-line effect summary; with the `effects:`
// block present, it also fails the build if a dependency reached an effect
// outside the list (E1220), unless `grants:` names an audited exception.
use core.files as fs

fn run() {
    path :: "/tmp/jet_effect_budget_demo.txt"
    fs.write(path, "budget ok") ?? panic("write failed")
    text :: fs.read(path) ?? panic("read failed")
    print(text)
}
