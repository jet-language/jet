// E2-M15: cross-compilation example.
// Build for a non-host target:
//   jet build --target=aarch64-unknown-linux-gnu 60_cross.jet
//
// The binary runs on aarch64-linux (or under QEMU — see docs/embedded.md).
fn add(a: Int, b: Int) -> Int {
    return (a + b)
}
fn main() {
    result #= add(3, 4)
    print("cross: 3 + 4 = {result}")
}
