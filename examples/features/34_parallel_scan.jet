// 34 — Parallel file scan: tasks + channels for real I/O-bound work.
//
// Default demo (no extra args):
//   nix develop -c jet run examples/features/34_parallel_scan.jet
//
// Pick your own files:
//   nix develop -c jet run examples/features/34_parallel_scan.jet examples/features/30_json.jet examples/features/31_cli.jet
//
// Interactive prompts:
//   INTERACTIVE=1 nix develop -c jet run examples/features/34_parallel_scan.jet
use core.tasks as tasks;
use core.fs as fs;
use core.io as io;
use core.env as env;
fn count_lines(text: String) -> Int {
    var lines = 0;
    loop _line in text.split("\n") {
        lines+= 1;
    }
    return lines;
}
fn scan_one(path: String) -> String {
    val text = fs.read(path) ?? return "{path}: unreadable";
    val lines = count_lines(text);
    return "{path}: {lines} lines, {text.len()} chars";
}
fn default_paths() -> [String] {
    return ["examples/features/32_tasks.jet", "examples/features/33_pipeline.jet", "examples/features/16_wordcount.jet", "examples/features/30_json.jet"];
}
fn paths_from_args() -> [String] {
    val args = io.args();
    var out: [String] = [];
    var i = 1;
    loop i < args.len() {
        if args.get(i) == value(path) {
            out.push(path);
        }
        i+= 1;
    }
    return out;
}
fn paths_from_prompt() -> [String] {
    print("Enter file paths (blank line when done):");
    var out: [String] = [];
    loop true {
        val raw = io.input("> ") ?? return out.clone();
        if raw == "" {
            break;
        }
        out.push(raw);
    }
    return out;
}
fn gather_paths() -> [String] {
    val from_args = paths_from_args();
    if from_args.len() > 0 {
        return from_args;
    }
    if (env.get("INTERACTIVE") ?? "") == "1" {
        return paths_from_prompt();
    }
    return default_paths();
}
fn scan_parallel(paths: [String]) -> [String] {
    val ch: Channel<String> = tasks.channel();
    var workers: [Task<Unit>] = [];
    var i = 0;
    loop i < paths.len() {
        if paths.get(i) == value(path) {
            val sender = ch.sender();
            val file = path.clone();
            workers.push(tasks.spawn(take(sender) () => {
                sender.send(scan_one(file));
            }));
        }
        i+= 1;
    }
    loop workers.len() > 0 {
        val worker = workers.pop() ?? panic("missing worker");
        worker.join();
    }
    var results: [String] = [];
    var got = 0;
    loop got < paths.len() {
        results.push(ch.receive() ?? panic("channel closed early"));
        got+= 1;
    }
    results.sort();
    return results;
}
fn copy_paths(paths: [String]) -> [String] {
    var out: [String] = [];
    loop path in paths {
        out.push(path);
    }
    return out;
}
fn main() {
    val paths = gather_paths();
    if paths.len() == 0 {
        print("no files to scan");
        return;
    }
    print("scanning {paths.len()} files...");
    print("");
    val parallel_paths = copy_paths(paths);
    val parallel = scan_parallel(parallel_paths);
    loop line in parallel {
        print(line);
    }
    print("");
    print("done — {paths.len()} files scanned in parallel");
}
