// S73 (D-SG7): named-only tuples — literals, types, access, equality, destructure.
fn bounds() -> (min: Int, max: Int) {
    return (min: 0, max: 10);
}

fn main() {
    val p = (x: 1, y: 2);
    val q = (y: 3, x: 4);
    val same_shape = p == q;
    val (a, b) = p.clone();
    print("{p.x} {p.y} {a} {b} {same_shape}");
    val pair = bounds();
    print("{pair.min} {pair.max}");
}
