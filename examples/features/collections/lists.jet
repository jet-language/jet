// 15 — Lists: literals, methods, slice, join (M5).
fn run() {
    nums := [Int]{3, 1, 2}
    nums.push(4)
    nums.sort()
    print(nums[0])
    print(nums.get(99) ?? (-1))
    mid :: nums[1..2]
    print(mid.join(","))
    nested :: [[1, 2], [3], [4, 5]]
    print(nested.flatten())
    print(nested.flat_map((xs: [Int]) :> xs))

    descending := [Int]{3, 1, 2}
    descending.sort_desc()
    print(descending)
    words := ["a", "abcd", "bb"]
    words.sort_by_desc((w: String) :> w.len())
    print(words)
}
