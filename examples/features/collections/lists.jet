// 15 — Lists: literals, methods, slice, join (M5).
struct Meeting {
    name: String
    hour: Int
}

fn run() {
    nums := [Int]{3, 1, 2}
    nums.push(4)
    nums.sort()
    print(nums[0])
    print(nums.get(99) ?? (-1))
    mid :: nums[1..2]
    print(mid.join(","))
    nested :: [[1, 2], [3], [4, 5]]
    print(nested.flatten())
    print(nested.flat_map((xs: [Int]) -> xs))

    descending := [Int]{3, 1, 2}
    descending.sort_desc()
    print(descending)
    words := ["a", "abcd", "bb"]
    words.sort_by_desc((w: String) -> w.len())
    print(words)
    meetings := [(name: "late", hour: 9), (name: "early", hour: 1)]
    meetings.sort_by(meeting -> meeting.hour)
    print("{meetings[0].name},{meetings[1].name}")
    records := [Meeting{name: "late", hour: 9}, Meeting{name: "early", hour: 1}]
    records.sort_by(record -> record.hour)
    print("{records[0].name},{records[1].name}")
}
