// D-COLLBREADTH1=A: Deque<T> — ring-buffer double-ended queue.
// Construct with Deque.new(), push/pop from both ends.
fn main() {
    d: Deque<Int> := Deque.new()
    d.push_back(1)
    d.push_back(2)
    d.push_back(3)
    d.push_front(0)
    print("len: {d.len()}")
    print("is_empty: {d.is_empty()}")
    if d.peek_front() == value(n) {
        print("front: {n}")
    }
    if d.peek_back() == value(n) {
        print("back: {n}")
    }
    if d.pop_front() == value(n) {
        print("popped front: {n}")
    }
    print("len after pop: {d.len()}")
    if d.pop_back() == value(n) {
        print("popped back: {n}")
    }
    print("len after two pops: {d.len()}")
}
