// 181 — D-INDEX-HOOK: expert `mytype[k]` via Index + IndexMut
struct Cell {
    value: Int
}

struct Grid {
    cells: [Cell]
}

impl Grid.Index {
    type Key = Int
    type Value = Int

    fn get(self, k: Int) -> (Int?) {
        if k < 0 || k >= self.cells.len() {
            return None
        }
        return Val(self.cells[k].value)
    }
}

impl Grid.IndexMut {
    fn set(&self, k: Int, v: Int) {
        if k >= 0 && k < self.cells.len() {
            self.cells[k].value = v
        }
    }
}

fn run() {
    g := Grid.{cells: [Cell.{value: 1}, Cell.{value: 2}]}
    g[1] = 99
    print("g[1]: {g[1]}")
}
