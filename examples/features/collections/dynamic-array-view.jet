// D-DYNARRAY1: `[a..b]` (beginner law, unchanged) always COPIES; `.view(a..b)`
// (expert tier) is a zero-copy WINDOW into the list's own backing storage,
// tracked by sema so it can never outlive `incidents` (E2305).
struct Incident {
    severity: Int
}

fn main() {
    incidents: [Incident] := [
        Incident.{ severity: 1 },
        Incident.{ severity: 2 },
        Incident.{ severity: 3 },
        Incident.{ severity: 4 },
        Incident.{ severity: 5 },
    ]

    // Copy-slice: `head` owns its own three `Incident`s.
    head :: incidents[0..2]
    print("copy-slice len: {head.len()}")

    // Zero-copy: `window` borrows straight into `incidents`' storage.
    window :: incidents.view(0..2)
    print("view len: {window.len()}")

    print("indexed: {window[0].severity}")

    sum :: window.fold(0, (a, i) => a + i.severity)
    print("fold sum: {sum}")

    doubled :: window.map((i) => i.severity * 2)
    print("map-to-owned: {doubled.join(",")}")

    loop i in window {
        print("iter: {i.severity}")
    }
}
