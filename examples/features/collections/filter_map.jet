// D-FAILCOMP1=A: filter_map and try_collect — failure-aware collection adapters.
fn parse_int(s: String) => Int ? String {
    n :: Int.parse(s) ?? return Err("not a number: {s}")
    return Ok(n)
}

fn run() {
    // filter_map: keeps ok, drops err. Returns lazy Iter; materialize to print.
    words :: [String].{"1", "two", "3", "four", "5"}
    nums :: words.filter_map((w: String) => parse_int(w))
    print(nums.to_list())
    // try_collect: Iter<T?E> → T?E — stops at first error.
    good_words :: [String].{"1", "2", "4"}
    collected :: good_words.map((s: String) => parse_int(s)).try_collect()
    if collected == .Ok(vs) print(vs)
    bad_words :: [String].{"1", "oops", "3"}
    result :: bad_words.map((s: String) => parse_int(s)).try_collect()
    if result == .Err(e) print("stopped at: {e}")
}
