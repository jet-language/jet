// D-ITERTOOLS1=A: lazy Iter protocol — adapters return Iter; materialize explicitly.
fn run() {
    nums :: [1, 2, 3, 4, 5]
    // Chain of lazy views; to_list materializes.
    ids :: nums.filter(n => n % 2 == 0).map(n => n * 10).to_list()
    print(ids)
    // Terminal reducer materializes without to_list.
    print(nums.map(n => n * n).sum())
    // String split joins the same lazy model.
    parts :: "a,b,c".split(",")
    print(parts.to_list())
    loop p, "x y z".split(" ") { print(p) }
}
