// Int map keys retain both signed i64 extremes.
fn run() {
    values := [Int:String]{}
    values.add(Int.MIN, "min").drop("keys are unique")
    values.add(Int.MIN + 1, "min+1").drop("keys are unique")
    values.add(-1, "negative-one").drop("keys are unique")
    values.add(0, "zero").drop("keys are unique")
    values.add(Int.MAX, "max").drop("keys are unique")
    print(values.get(Int.MIN) ?? "missing")
    print(values.get(Int.MIN + 1) ?? "missing")
    print(values.get(-1) ?? "missing")
    print(values.get(0) ?? "missing")
    print(values.get(Int.MAX) ?? "missing")
}
