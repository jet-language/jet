// D-COLLBREADTH1=A: Set<T> — hash-backed unordered set.
// Construct with Set.from([...]), mutate with add/remove, query with contains/len.
fn run() {
    s := Set.from([1, 2, 3, 2, 1])  // deduplication on construction
    s.add(4)
    s.add(3)  // duplicate — no effect
    print("len: {s.len()}")
    print("has 2: {s.has(2)}")
    print("has 5: {s.has(5)}")
    s.remove(2)
    print("after remove: len={s.len()}")
    t :: Set.from([3, 4, 5])
    u :: Set<Int>.{s.union(t)}
    u_list := [Int].{u.to_list()}
    u_list.sort()
    print("union sorted: {u_list}")
    i_list := [Int].{s.intersection(t).to_list()}
    i_list.sort()
    print("intersection sorted: {i_list}")
    d_list := [Int].{s.difference(t).to_list()}
    d_list.sort()
    print("difference sorted: {d_list}")
    x_list := [Int].{s.symmetric_difference(t).to_list()}
    x_list.sort()
    print("symmetric difference sorted: {x_list}")
    print("subset: {s.is_subset(Set.from([1, 3, 4, 5]))}")
    print("superset: {s.is_superset(Set.from([1, 3]))}")
    print("disjoint: {s.is_disjoint(Set.from([8]))}")
    ordered_a := SortedSet.from([1, 2, 3])
    ordered_b := SortedSet.from([3, 4])
    print("sorted intersection: {ordered_a.intersection(ordered_b).to_list()}")
    print("sorted difference: {ordered_a.difference(ordered_b).to_list()}")
    print("sorted symmetric difference: {ordered_a.symmetric_difference(ordered_b).to_list()}")
    print("sorted subset: {ordered_a.is_subset(SortedSet.from([1, 2, 3, 4]))}")
    print("sorted superset: {ordered_a.is_superset(SortedSet.from([1, 2]))}")
    print("sorted disjoint: {ordered_a.is_disjoint(SortedSet.from([8]))}")
    print("is_empty: {s.is_empty()}")
}
