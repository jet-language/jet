// D-COLLBREADTH1=A: Set<T> — hash-backed unordered set.
// Construct with Set.from([...]), mutate with add/remove, query with contains/len.
fn run() {
    s := Set.from([1, 2, 3, 2, 1])  // deduplication on construction
    s.add(4)
    s.add(3)  // duplicate — no effect
    print("len: {s.len()}")
    print("has 2: {s.has(2)}")
    print("has 5: {s.has(5)}")
    s.remove(2)
    print("after remove: len={s.len()}")
    t := Set.from([3, 4, 5])
    u := Set<Int>.{s.union(t)}
    u_list := [Int].{u.to_list()}
    u_list.sort()
    print("union sorted: {u_list}")
    print("is_empty: {s.is_empty()}")
}
