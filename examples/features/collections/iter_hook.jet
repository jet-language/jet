// 180 — D-ITER-HOOK: zero-copy `loop x; mytype` via Iterable + Iterator
struct Crate {
    data: [Int]
}

struct BagIter {
    bag: Crate
    idx: Int
}

impl BagIter.Iterator {
    type Item = Int

    fn next(&self) => (Int?) {
        if self.idx >= self.bag.data.len() { return None }
        v :: self.bag.data[self.idx]
        self.idx += 1
        return Val(v)
    }
}

impl Crate.Iterable {
    type Iter = BagIter

    fn iter(^self) => BagIter {
        return BagIter.{bag: self, idx: 0}
    }
}

fn run() {
    b :: Crate.{data: [10, 20, 30]}
    sum := 0
    loop n; b { sum += n }
    print("sum: {sum}")
}
