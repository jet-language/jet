// Card #2291: mutating methods on indexed collection elements update storage.
// `outer` and `lists` are mutable bindings; `i` and `k` are immutable selectors.
// Indexing a mutable collection exposes the selected element's write contract,
// so `push` changes the original nested storage rather than a temporary copy.
// Each print is the observed write, not merely permission to write.
struct Bucket {
    values: [Int]
}

fn run() {
    outer := [[1, 2], [3]]
    i :: 0
    outer[i].push(9)
    print(outer)

    lists := [String:[Int]]{"x": [1, 2]}
    k :: "x"
    lists[k].push(3)
    print(lists)

    buckets := [Bucket{values: [1]}]
    buckets[0].values.push(2)
    print(buckets)

    map_rows := [[String:[Int]]{"x": [4]}]
    map_rows[0][k].push(5)
    print(map_rows)
}
