// E2-M9: jet.toml — parse and rewrite a config file.
use jet.toml as toml
fn main() {
    raw :: "# server config\nhost = \"localhost\"\nport = \"8080\"\ndebug = \"true\""
    cfg :: toml.parse(raw) ?? panic("toml parse failed")
    host :: cfg["host"]
    port :: cfg["port"]
    print("{host}:{port}")
    rendered :: toml.render(cfg)
    print((rendered.len() > 0))
}
