// c80 / D-TGT2: `benchmark` target — routes `jet bench` at this package's
// entry via the existing `#Bench` / `jet bench` engine (no new mechanism, I8).
// Running `jet bench examples/features/123_bench_target/main.jet` times each
// `#Bench` region and reports ns/iter + ops/sec.
payload: {
    name:    "bench_perf",
    version: "0.1.0",
    jet:     ">=0.1.0",
    description: "Demonstrates target: benchmark in pkg.jet (c80).",
    license: "MIT OR Apache-2.0",
    repository: "",
}
packages: {
    bench_perf: benchmark,
}
deps: {
}
