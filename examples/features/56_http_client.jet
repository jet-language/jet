// E2-M10: HTTP client over blocking sockets.
// Starts a loopback server in a background task, then uses jet.http.get
// to send a request and print the response body.
use jet.http as http;
use core.net as net;
use core.tasks as tasks;

fn main() {
    val ch: Channel<String> = tasks.channel();
    val sender = ch.sender();
    // Mini one-shot server: bind, send address back, handle one request.
    tasks.spawn(take(sender) () => {
        val listener = net.tcp_listen("127.0.0.1:0") ?? panic("bind failed");
        sender.send(listener.local_addr());
        val stream = listener.accept() ?? panic("accept failed");
        val _req = stream.read() ?? panic("read failed");
        net.tcp_reply(stream, "200 OK", "hello, world!");
    });
    val addr = ch.receive() ?? panic("no address");
    val resp = http.get("http://{addr}/") ?? panic("http get failed");
    print(resp.body());
}
