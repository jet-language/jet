// D-GENMOD2=A: generic module templates and aliases (card #91).
//
// A generic module is a module template parameterised by types and values.
// `module Cache<K>` defines the template; `module IntCache = Cache<Int>`
// instantiates it, producing a concrete module with all type params resolved.
module Cache<K, capacity: Int> {
    comptime BASE = capacity
    comptime SIZE = BASE + 1

    pub struct Entry {
        key: K
        limit: Int => capacity
    }

    pub enum Slot {
        Empty
        Value(K)
    }

    pub fn entry(k: K) -> Entry {
        return Entry.{ key: k }
    }

    pub fn slot(k: K) -> Slot {
        return Slot.Value(k)
    }

    pub fn key_of(k: K) -> String {
        value: K := k
        return "key"
    }

    pub fn describe() -> String {
        return "generic cache"
    }

    pub fn size() -> Int {
        return SIZE
    }
}

// Forward alias chain: declaration order does not affect resolution.
module ForwardCache = IntCache
module IntCache = Cache<Int, 32>

enum Mode {
    Fast
    Safe
}

module TierZero<flag: Bool, count: Int, letter: Char, label: String, mode: Mode> {
    #Meta(category: label)
    pub fn show() {
        print(flag)
        print(count)
        print(letter)
        print(label)
        print(mode == Mode.Fast)
    }
}

module Values = TierZero<true, 7, 'J', "jet", Mode.Fast>

trait Token {}

struct GoodToken {}

impl GoodToken.Token {}

// Parameter spelling never decides its kind: lowercase `item` is a type slot
// because its annotation is a trait; uppercase `COUNT` is an Int value slot.
module AnnotationKinds<item: Token, COUNT: Int> {
    pub fn count() -> Int {
        return COUNT
    }
}

module Kinds = AnnotationKinds<GoodToken, 8>

module FixedBuffer<T, capacity: Int> {
    pub struct Buffer {
        items: [T#capacity]
    }

    pub fn echo(values: [T#capacity]) -> [T#capacity] {
        result: [T#capacity] := values
        return result
    }
}

module ThreeInts = FixedBuffer<Int, 3>

module LocalLaws<T> {
    pub trait Reveal {
        type Output
        fn reveal(self) -> T
    }

    pub struct Wrapped {
        value: T
    }

    impl Wrapped.Reveal {
        type Output = T
        fn reveal(self) -> T { return self.value }
    }

    pub enum SourceErr { Bad(T) }
    pub enum TargetErr { Wrapped(SourceErr) }
    impl SourceErr -> TargetErr { return TargetErr.Wrapped(self) }
}

module IntLaws = LocalLaws<Int>

fn run() {
    k :: IntCache__key_of(42)
    d :: IntCache__describe()
    n :: IntCache__size()
    e :: IntCache__entry(42)
    s :: IntCache__slot(7)
    print(k)
    print(d)
    print(n)
    print(IntCache__SIZE)
    print(e.key)
    print(e.limit)
    forwarded :: ForwardCache.entry(9)
    print(ForwardCache.size())
    print(forwarded.key)
    if s == {
        .Value(v) -> { print(v) }
        .Empty -> { print(0) }
    }
    Values.show()
    print(Kinds.count())
    input: [Int#3] := [1, 2, 3]
    fixed: [Int#3] := ThreeInts.echo(input)
    buffer :: ThreeInts__Buffer.{ items: fixed }
    print(buffer.items[2])
    wrapped :: IntLaws__Wrapped.{ value: 91 }
    print(wrapped.reveal())
}
