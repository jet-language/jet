// D-MOD2: an inline module function calls a private sibling. The call lowers to
// the module-mangled name; the sibling stays unreachable from outside.
module geo {
    fn square(n: Int) -> Int { return n * n }

    pub fn area(side: Int) -> Int {
        return square(side)
    }
}

fn run() {
    print(geo.area(5))
}
