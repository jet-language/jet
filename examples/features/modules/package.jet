// D-CONF-MODULE1=A: profile settings feed the generic-module value plane.
name: "generic_module_fact_values"
version: "0.1.0"
edition: "2026"

settings: .{
    cache_slots: Int = 3,
}

build: {
    compact: Build.{ optimize: full, settings: { cache_slots: 2 } },
    spacious: Build.{ optimize: full, settings: { cache_slots: 5 } },
}
