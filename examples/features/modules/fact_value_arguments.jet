// D-CONF-MODULE1=A: a typed build setting is a legal generic-module value.
module cache<K>(capacity: Int) {
    pub struct Buffer {
        items: [K#capacity]
    }

    pub fn slots() => Int :: capacity
}

module tuned :: cache<Int>(@build.settings.cache_slots)

fn run() {
    print(tuned.slots())
}
