// M9.5: `embed_file` bakes a file's contents into the binary at compile
// time — the file is never opened at runtime. A `comptime require` then
// validates the embedded text while compiling (the sanctioned proc-macro
// use case): if it fails, you get a compile error, not a runtime surprise.
comptime MOTD = embed_file("motd.txt")

comptime OK = check_nonempty(MOTD)

fn check_nonempty(s: String) -> Bool {
    require((s.len() > 0), "motd.txt must not be empty")
    return true
}

fn main() {
    print("message of the day:")
    print("{MOTD}")
}
