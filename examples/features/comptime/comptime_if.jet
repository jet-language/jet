// D-WHEN1/D-WHEN2 (ratified 2026-06-19): `#Known if` selects a branch at
// compile time. Only the selected arm is type-checked and emitted; the
// dropped arm gets name-resolution only (typos still caught).
#Known debug :: false

#Known platform :: "unix"

fn run() {
    #Known if debug {
        print("debug mode")
    } else {
        print("release mode")
    }
    #Known if platform == "windows" {
        print("windows path")
    } else {
        print("unix path")
    }
    // Nested #Known if (comptime else-if chain)
    #Known if debug {
        print("debug")
    } else {
        #Known if platform == "unix" {
            print("unix, non-debug")
        } else {
            print("other")
        }
    }
}
