// D-WHEN1/D-WHEN2 (ratified 2026-06-19): `@if` selects a branch at
// compile time. Only the selected arm is type-checked and emitted; the
// dropped arm gets name-resolution only (typos still caught).
@DEBUG :: false

@PLATFORM :: "unix"

fn run() {
    @if @DEBUG {
        print("debug mode")
    } else {
        print("release mode")
    }
    @if @PLATFORM == "windows" {
        print("windows path")
    } else {
        print("unix path")
    }
    // Nested @if (comptime else-if chain)
    @if @DEBUG {
        print("debug")
    } else {
        @if @PLATFORM == "unix" {
            print("unix, non-debug")
        } else {
            print("other")
        }
    }
}
