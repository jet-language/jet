// D-CONF-READ1=A: one folded program reads the registered build fact plane.
fn run() {
    @if @build.os == {
        .Linux -> { print("linux") }
        .MacOS -> { print("macos") }
        .Windows -> { print("windows") }
    }
    print(@build.package.name)
    print(@build.package.version)
    print(@build.os)
    print(@build.profile)
}
