// D-CTFIND1/2: a `find(glob)` that matches nothing still evaluates to a
// (empty) `[String]` — codegen must render it as a correctly typed
// `Vec::<String>::new()`, never a bare `vec![]` (ambiguous to rustc, E0282,
// a P0 I2 violation — see card #520).
comptime paths = find("find_inputs/**/no-such-file-*.zzz")

fn run() {
    print(paths.join("|"))
}
