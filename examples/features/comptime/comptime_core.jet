// D-META-EFFECT1: the comptime interpreter reads the shared Core effect fact.
// `core.math` calls have an empty effect set; ambient modules remain gated.
// The results are constant-folded into the binary — no runtime math involved.
use core.math as math

@SQRT4 :: math.sqrt(Float{4.0})

@POW2 :: math.pow(Float{2.0}, Float{8.0})

@FLOORED :: math.floor(Float{3.7})

@CEILED :: math.ceil(Float{2.1})

@MAXI :: math.max(Float{10.0}, Float{20.0})

@COMPLEX_SQUARE :: (3 + 4i) * (3 + 4i)

@COMPLEX_ABS :: math.abs(3 + 4i)

fn run() {
    print(@SQRT4)
    print(@POW2)
    print(@FLOORED)
    print(@CEILED)
    print(@MAXI)
    print(@COMPLEX_SQUARE)
    print(@COMPLEX_ABS)
}
