// 35 — Zero-copy field views.
//
// A `view` return hands back a *borrow* into a value the caller already owns,
// so reading a field costs nothing — no copy is made. Contrast the two readers
// below: the clone-heavy one duplicates every field it reads; the zero-copy one
// borrows straight into the record the caller is holding.
//
//   nix develop -c jet run examples/features/35_zerocopy.jet

struct Field {
    name: String;
    value: String;
}

struct Record {
    fields: [Field];
}

// Parse "key=value" lines into an owned record. Parsing builds the record once;
// after that, reads should be free.
fn parse(text: String) -> Record {
    var fields: [Field] = [];
    for line in text.split("\n") {
        val trimmed = line.trim();
        if trimmed.len() == 0 {
            continue;
        }
        var key = "";
        var val_text = "";
        var seen_eq = false;
        for part in trimmed.split("=") {
            if seen_eq {
                val_text = part;
            } else {
                key = part;
                seen_eq = true;
            }
        }
        fields.push(Field { name: key, value: val_text });
    }
    return Record { fields: fields };
}

// ZERO-COPY read: hand back a borrow into the field the caller already owns.
// No copy is made. This compiles because `field` is a parameter — the caller
// keeps owning it for as long as the returned view is used.
fn name_of(field: Field) -> view String {
    return field.name;
}

// CLONE-HEAVY read: returns an owned copy. Every call duplicates the text.
fn name_copy(field: Field) -> String {
    return field.name.clone();
}

fn main() {
    val rec: Record = parse("host=localhost\nport=8080\nmode=fast");

    // Read every field name with the zero-copy view accessor — no clones.
    // A `view` result is read in place (here, printed) rather than stored.
    print("zero-copy field names (borrowed, no copies):");
    for field in rec.fields {
        print("  {name_of(field)}");
    }

    // The clone-heavy accessor returns the same text but copies it each time.
    print("clone-heavy field names (each one duplicated):");
    for field in rec.fields {
        val owned = name_copy(field);
        print("  {owned}");
    }
}
