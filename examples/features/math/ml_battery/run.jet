use core.compute as compute
use core.files as files
use core.http.server as http_server
use core.net as net
use ml

fn handle_completion(req: HTTPRequest) HTTPResponse !HTTPError -> {
    body :: req.body().text(4096) ?? ""
    if body.contains("tool_result:") {
        return Ok(http_server.sse("data: {{\"choices\":[{{\"delta\":{{\"content\":\"done\"}}}}]}}\n\ndata: [DONE]\n\n"))
    }
    return Ok(http_server.sse("data: {{\"choices\":[{{\"delta\":{{\"tool_calls\":[{{\"id\":\"call-1\",\"function\":{{\"name\":\"lookup\",\"arguments\":\"{{\\\"key\\\":\\\"jet\\\"}}\"}}}}]}}}}]}}\n\ndata: [DONE]\n\n"))
}

fn run() !(HTTPError | NetError | TaskFailure) {
    tensor :: ml.tensor_demo()
    print("tensor=rank:{tensor.rank} shape:{tensor.shape} broadcast:{tensor.broadcast}")
    print("matmul={tensor.product} reduction={tensor.reduction}")

    data :: ml.parity_dataset(4, 42)
    batches :: ml.loader_batches(data, 2, 0, true)
    first_batch :: batches[0]
    inputs :: ml.collate_inputs(data, first_batch)
    targets :: ml.collate_targets(data, first_batch)
    print("loader=epoch:{first_batch.epoch} batches:{batches.len()} indices:{first_batch.indices}")
    print("collate=inputs:{compute.shape(inputs)} targets:{compute.shape(targets)}")

    training :: ml.train_two_layer(4, 2, 42, 0.1)
    model :: training.model
    print("training=w1:{compute.to_list(model.w1)} w2:{compute.to_list(model.w2)} losses:{training.losses}")
    trained_loss :: ml.training_loss(model.w1, model.w2, inputs, targets)
    print("training_loss={compute.to_list(trained_loss)}")

    temp :: files.temp_dir("ml-battery") ?? panic("ml temp dir")
    model_path :: Path.from(temp.path).join("model.tensor").to_string()
    state :: ml.model_state_round_trip(model_path, model)
    print("state=equal:{state.equal} checksum_equal:{state.checksum == state.restored_checksum} restored_w2:{compute.to_list(state.restored.w2)}")
    files.remove(model_path) ?? panic("ml model cleanup")

    index :: ml.exact_embedding_index(10000)
    query :: ml.embedding_vector(4242)
    hits :: ml.top_k_embeddings(index, query, 2)
    score :: ml.cosine_similarity(query, query)
    print("embedding=count:{index.vectors.len()} top:{hits[0].id},{hits[1].id} self_cosine:{score}")

    request :: ml.chat_request("mock", [ml.user_message("lookup")])
    print("chat_request=streaming:{request.len() > 0}")

    listener :: net.tcp_listen("127.0.0.1:0")
    address :: listener.local_addr()
    mux :: http_server.mux()
    mux.post("/v1/chat/completions", (req: HTTPRequest) -> handle_completion(req))
    serving :: task {
        http_server.serve_once_listener(listener, mux)
        http_server.serve_once_listener(listener, mux)
    }
    loop_report :: ml.bounded_tool_loop("http://{address}/v1/chat/completions", "mock", "lookup", 2)
    transcript :: loop_report.transcript.join("|")
    print("llm=steps:{loop_report.steps} tools:{loop_report.tool_calls} tool_results:{loop_report.tool_result_turns} completed:{loop_report.completed} bounded:{loop_report.bounded} transcript:{transcript}")
    serving.join() ?? panic("ml server join")

    gpu :: ml.f32_gpu_receipt()
    print("gpu=requested:{gpu.requested} selected:{gpu.selected} available:{gpu.available} precision:{gpu.precision}")

    bench :: ml.matmul_benchmark(4, 4, 4, 2, "jet")
    print("bench=shape:{bench.rows}x{bench.inner}x{bench.cols} repeats:{bench.repetitions} tier:{bench.tier} check:{bench.jet_result_check} numpy:{bench.numpy.available} pytorch:{bench.pytorch.available}")

    loop gate in ml.open_core_gates() -> print("gate={gate}")
}
