// D-GO127-STDLIB1=A: exact Int Euclidean quotient and non-negative remainder.
fn run() {
    a :: -17
    positive :: 5
    negative :: -5
    print(a.div_euclid(positive))
    print(a.rem_euclid(positive))
    print(a.div_euclid(negative))
    print(a.rem_euclid(negative))
    print(17.div_euclid(negative))
    print(17.rem_euclid(negative))
}
