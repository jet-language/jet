// Power operator (D-EXPOP1=A): infix `^` raises a number to a power, and
// `^=` raises a mutable binding in place. Exclusive-or moved to `~|`
// (D-XORSPELL1=A), so the caret reads the way a textbook writes it.
// Grouping, associativity, and the result type are in power_semantics.jet.
fn run() {
    print(3 ^ 2)
    side :: 4
    print(side ^ 3)
    // `^=` accumulates a power in place.
    growth := 2
    growth ^= 10
    print(growth)
    // Floats raise the same way.
    print(1.5 ^ 2.0)
}
