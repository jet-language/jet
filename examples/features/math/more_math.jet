use core.math as math

// Operations the Core surface ledger scored against two or more of the eleven
// compared languages. Every one answers the same on every execution tier.
fn run() {
    // Inverse hyperbolics, the pair of the sinh/cosh/tanh Jet already had.
    print(math.asinh(0.0))
    print(math.acosh(1.0))
    print(math.atanh(0.0))

    // Roots and powers that keep their accuracy where the obvious spelling
    // loses it. exp_m1 and ln_1p stay exact for values near zero, where
    // `exp(x) - 1` and `ln(1 + x)` cancel most of their digits away.
    print(math.cbrt(27.0))
    print(math.exp2(10.0))
    print(math.exp_m1(0.0))
    print(math.ln_1p(0.0))
    print(math.log(8.0, 2.0))

    // Sign carried from one number to another, and sign on its own.
    print(math.copysign(3.0, -1.0))
    print(math.signum(-2.5))

    // One rounding for a multiply and an add together, so the product keeps
    // full width before the sum.
    print(math.fma(2.0, 3.0, 1.0))

    // Whole-number parity.
    print(math.is_even(4))
    print(math.is_odd(4))
}
