// D-MATHLIB2 + D-CORESURFACE1 (#1464): core.math owns libm breadth, integer
// safety, and the remaining high-witness float/decompose gaps.
use core.math as math

fn run() {
    print(math.sin(Float{0.0}))
    print(math.cos(Float{0.0}))
    print(math.atan2(Float{1.0}, Float{1.0}) > Float{0.7})
    print(math.hypot(Float{3.0}, Float{4.0}))
    print(math.lerp(Float{10.0}, Float{20.0}, Float{0.25}))
    print(math.degrees(math.radians(Float{180.0})))
    print(math.is_finite(math.exp(Float{1.0})))
    print(math.sign(-Float{9.0}))
    print(math.checked_add(9223372036854775807, 1) ?? -1)
    print(math.saturating_add(9223372036854775807, 1))
    print(math.wrapping_add(9223372036854775807, 1))
    print(math.int_pow(2, 10))
    print(math.gcd(54, 24))
    print(math.lcm(6, 8))

    // Classify and sign.
    print(math.is_normal(Float{1.0}))
    print(math.is_subnormal(Float{0.0}))
    print(math.is_canonical(Float{1.0}))
    print(math.is_signed(-Float{1.0}))
    print(math.is_zero(Float{0.0}))
    print(math.is_integer(Float{3.0}))
    print(math.sign_bit(-Float{2.0}))

    // Neighboring floats and scale.
    print(math.next_up(Float{1.0}) > Float{1.0})
    print(math.next_down(Float{1.0}) < Float{1.0})
    print(math.next_after(Float{1.0}, Float{2.0}) > Float{1.0})
    print(math.ldexp(Float{0.5}, 3))
    print(math.scaleb(Float{0.5}, 3))
    print(math.logb(Float{8.0}))
    print(math.ilogb(Float{8.0}) ?? -1)
    print(math.significand(Float{12.0}))
    print(math.ulp(Float{1.0}) > Float{0.0})
    print(math.radix(Float{1.0}))
    print(math.zero())

    // Trig helpers and specials.
    print(math.copy(-Float{4.5}))
    print(math.inv(Float{4.0}))
    print(math.cot(math.atan(Float{1.0})))
    print(math.erf(Float{0.0}))
    print(math.erfc(Float{0.0}))
    print(math.gamma(Float{5.0}))
    print(math.lgamma(Float{5.0}) > Float{3.0})
    print(math.cmp(Float{1.0}, Float{2.0}))

    // Pairs.
    sc :: math.sin_cos(Float{0.0})
    print(sc.sin)
    print(sc.cos)
    mf :: math.modf(Float{3.25})
    print(mf.fract)
    print(mf.whole)
    fr :: math.frexp(Float{8.0})
    print(fr.frac)
    print(fr.exp)
    dm :: math.div_mod(-7, 3)
    print(dm.quot)
    print(dm.rem)
    dr :: math.div_rem(-7, 3)
    print(dr.quot)
    print(dr.rem)

    // Whole-number helpers.
    print(math.leading_ones(-1))
    print(math.trailing_ones(7))
    print(math.digits(12345))
    print(math.binomial(5, 2) ?? -1)
}
