// What `/` answers (D-INTDIV1=A): the true quotient, always. `7 / 2` is 3.5,
// not 3 — dividing two whole numbers gives a Float, because that is the answer
// to the question the operator asks.
//
// This is the rule Python 3 settled on, and it removes the oldest arithmetic
// surprise in programming: an average that silently loses its fraction.
//
// When the whole-number answer IS what you want, `/%` says so out loud
// (floor_div.jet). Because `/` cannot store its result back into a whole
// number, `n /= 2` on an Int is a type error that points at `/%=`.
fn score(n: Int) => Int { return n }

fn run() {
    // Two whole numbers, a fractional answer.
    print(score(7) / score(2))
    // The average of 8 and 9 keeps its half instead of rounding down to 8 —
    // and it needs no conversion to get there. Writing `Float.from_int(…)`
    // around both sides is the ceremony this decision exists to delete.
    total :: score(8) + score(9)
    print(total / score(2))
    // The whole-number path is spelled `/%`.
    print(score(17) /% score(2))
}
