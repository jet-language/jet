// D-INLINE-PARAM1=A — checked `#Inline` contracts.
// `#Inline` is a soft hint (the compiler is free to ignore it; never an
// error). `#Inline(Always)` is a checked promise: the compiler proves it can
// actually inline every call, or the build fails naming why (self-recursive,
// address-taken, or too large) — never a silent miss. Methods stay ordinary
// functions; there is no macro-rewrite hook, just an attribute on the
// generated Rust once sema has confirmed the promise holds.
#Inline fn square(x: Int) => Int { return x * x }

#Inline(Always) fn double(x: Int) => Int { return x * 2 }

struct Meters {
    value: Int

    #Inline(Always) fn plus(self, other: Int) => Int { return self.value + other }
}

fn run() {
    m :: Meters.{value: 7}
    print("{square(4)} {double(5)} {m.plus(3)}")
}
// --- expected output --------------------------------------------------
// 16 10 10
