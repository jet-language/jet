// 86 — D-LSDIR1: fs.list_dir returns [DirEntry] ({name, path, is_dir}).
// path.join(dir, name) builds portable paths for experts who need finer control.
use core.fs as fs
use core.path as path
fn main() {
    dir @= "/tmp/jet_lsdir_demo"
    fs.create_dir(dir) ?? panic("could not create demo dir")
    fs.write(path.join(dir, "hello.txt"), "hi") ?? panic("write failed")
    sub @= path.join(dir, "sub")
    fs.create_dir(sub) ?? panic("could not create subdir")
    entries @= fs.list_dir(dir) ?? panic("list_dir failed")
    loop entry in entries {
        if entry.is_dir {
            print("dir:  {entry.name}")
        } else {
            print("file: {entry.name}")
        }
    }
    joined @= path.join(dir, "hello.txt")
    print(fs.exists(joined))
}
