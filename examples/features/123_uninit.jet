// D-UNINIT1 (ratified 2026-06-21): `#Uninit` opts out of automatic zero-fill for a
// binding, skipping the default initialisation for raw performance. Gated by
// `use core.mem`; sema proves every read happens after a write on all paths (E0420).
//
// The canonical use case is large fixed buffers filled by I/O calls — a real
// syscall-style fill avoids zero-initializing memory that is immediately overwritten.
// Here we use plain scalars to keep the example self-contained and deterministic.
use core.mem

fn main() {
    // A scalar left uninit: the compiler proves `n` is written before `print(n)`.
    #Uninit n: Int
    n = 99
    print(n)

    // Both branches write `m`, so every read path is provably post-write.
    #Uninit m: Int
    if 1 > 0 {
        m = 10
    } else {
        m = 20
    }
    print(m)
}
