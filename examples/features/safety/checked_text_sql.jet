// D-TEXTHEAD-TYPE1=A / D-UNIFYLIT1=A: SQL and HTML are library-defined,
// nominal String-backed types with ordinary `CheckedText` implementations.
// Each `{hole}` is encoded by its implementation; a runtime `String` can
// never fill the position directly — `.raw("…")` is the sole audited escape.
fn run_query(q: SQL) {
    print("template: {q.template()}")
    print("param count: {q.params().len()}")
}

fn render(h: HTML) { print("html: {h.text()}") }

fn run() {
    id :: 42
    q :: SQL{"select * from incidents where id = {id}"}
    run_query(q)
    name :: "<script>alert(1)</script>"
    page :: HTML{"<p>{name}</p>"}
    render(page)
    trusted :: HTML.raw("<b>audited</b>")
    render(trusted)
}
