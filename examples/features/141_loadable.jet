// D-PENDING1=B: Loadable<T,E> — async UI state machine.
use core.async.loadable as L

fn fetch_user(id: Int) -> String ? String {
    if id == 0 { return err("user not found") }
    return ok("Alice")
}

fn main() {
    idle_state @= L.idle()
    loading_state @= L.loading()
    print(idle_state.is_idle())
    print(loading_state.is_loading())

    result @= fetch_user(1)
    if result == ok(name) {
        loaded_state @= L.loaded(name)
        print(loaded_state.is_loaded())
        print(loaded_state.loaded() ?? "none")
        print(loaded_state.or_else("unknown"))
    }

    fail_result @= fetch_user(0)
    if fail_result == err(msg) {
        failed_state @= L.failed(msg)
        print(failed_state.is_failed())
    }
}
