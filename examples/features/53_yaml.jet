// E2-M9: jet.yaml — parse and render YAML config.
use jet.yaml as yaml
fn main() {
    raw :: "# app config\nname: myapp\nversion: 1.0\nenvironment: production"
    cfg :: yaml.parse(raw) ?? panic("yaml parse failed")
    name :: cfg["name"]
    env :: cfg["environment"]
    print("{name} ({env})")
    rendered :: yaml.render(cfg)
    print((rendered.len() > 0))
}
