// E2-M9: jet.yaml — parse and render YAML config.
use jet.yaml as yaml;

fn main() {
    val raw = "# app config\nname: myapp\nversion: 1.0\nenvironment: production";
    val cfg = yaml.parse(raw) ?? panic("yaml parse failed");
    val name = cfg["name"];
    val env = cfg["environment"];
    print("{name} ({env})");
    val rendered = yaml.render(cfg);
    print(rendered.len() > 0);
}
