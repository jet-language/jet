// D-RAYLIB1 stage 1: typed `core.raylib` skeleton.
// Golden tests type-check/codegen this file. Running against a real display is
// gated until the native raylib bridge replaces the current no-op stubs.
use core.raylib as rl

fn run() {
    window :: rl.window_open(640, 480, "Jet raylib")
    dark :: rl.color(20, 24, 32, 255)
    white :: rl.color(245, 245, 245, 255)

    rl.begin_drawing(window)
    rl.clear_background(dark)
    rl.draw_text("Jet + raylib", 24, 24, 24, white)
    rl.end_drawing()
    rl.close_window(window)

    print("core.raylib skeleton typechecked")
}
