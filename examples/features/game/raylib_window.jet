// D-FLAGSHIP-RAYLIB1=A + D-GAME-LOOP1=A: typed `core.raylib` bridge with a
// real frame loop, keyboard input, and audio play. Headless by default; set
// JET_RAYLIB_DISPLAY=1 with raylib installed to open a native window.
use core.raylib as rl

fn run() {
    window :: rl.window_open(640, 480, "Jet raylib")
    rl.set_target_fps(60)
    dark :: rl.color(20, 24, 32, 255)
    white :: rl.color(245, 245, 245, 255)
    blip :: rl.load_sound("assets/jump.wav")
    frames := 0
    last_space := false
    audio_ok := false
    loop {
        // Headless: window_should_close is true immediately, so draw one frame
        // then exit. Native: keep looping until the user closes the window.
        if frames > 0 && rl.window_should_close(window) {
            break
        }
        space :: rl.key_down("Space")
        last_space = space
        if space {
            audio_ok = rl.play_sound(blip)
        }
        rl.begin_drawing(window)
        rl.clear_background(dark)
        rl.draw_rectangle(24, 64, 160, 48, white)
        rl.draw_text("Jet + raylib", 24, 24, 24, white)
        rl.end_drawing()
        frames += 1
        if !rl.window_ready(window) {
            break
        }
    }
    print("frames {frames}")
    print("input {last_space}")
    print("audio {audio_ok}")
    rl.close_window(window)
    print("core.raylib bridge ready")
}
