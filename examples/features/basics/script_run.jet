// Bare statements are the implicit fn run body. Declarations stay file-wide.
print("script entry")
limit :: 2
print(limit)
print(even(limit + 2))
print(helper())

fn helper() => String { return "declaration" }
fn even(n: Int) => Bool {
    return if n == 0 -> true else -> odd(n - 1)
}
fn odd(n: Int) => Bool {
    return if n == 0 -> false else -> even(n - 1)
}
