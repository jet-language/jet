// D-VERDICT-1321-1: `print` is variadic — each argument writes on its own
// line. One argument with interpolation keeps everything on a single line,
// so both shapes stay a one-liner.
use core.io as io

fn run() {
    count :: 3
    print("first", "second", count)
    print("one line: {count} items")
    io.print("io first", "io second")
}
