struct Box {
    value: Int
}

fn run() {
    count := 10
    next :: () -> {
        count += 1
        count
    }
    print(next())
    print(next())
    print(count)

    boxed := Box{value: 11}
    read :: () -> boxed.value
    boxed.value = 22
    print(read())
    print(boxed.value)

    x := 2
    outer :: (y: Int) -> {
        inner :: (z: Int) -> x + y + z
        inner(4)
    }
    print(outer(3))
}
