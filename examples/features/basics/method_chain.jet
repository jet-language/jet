// D-SG3: a broken dot-chain keeps one step per line, each freely commented.
fn run() {
    raw :: "  hello world  "
    shout :: raw
        .trim()  // drop the padding
        .to_upper()  // raise your voice
        .replace("O", "0")  // leetspeak the vowels
    print("{shout}")
    // A short chain stays on one line.
    n :: "Jet".to_lower().len()
    print("{n}")
}
