// 37 — `if` as a value, and optional condition parens (S68, D-SG2).
fn classify(n: Int) -> String {
    // Ordered guards produce one value; `else` makes the result exhaustive.
    return if {
        n > 0 -> "positive"
        n < 0 -> "negative"
        else -> "zero"
    }
}

fn run() {
    // The whole `if` is the value bound to `m` — no ternary needed.
    a :: 10
    b :: 3
    m :: if a > b {
        a
    } else {
        b
    }
    print("max is {m}")
    // A branch may run statements before its trailing value.
    note :: if a > b {
        diff :: (a - b)
        "a leads by {diff}"
    } else {
        "b leads"
    }
    print(note)
    print(classify(7))
    print(classify((-4)))
    print(classify(0))
    // Optional parens around a condition are accepted (jet fmt removes them).
    if a > b { print("a is bigger") }
}
