// M8: lambdas and closure-powered list methods (D-ITERTOOLS1=A: lazy views).
fn run() {
    nums :: [1, 2, 3, 4, 5]
    squares :: nums.map((n: Int) => (n * n))
    big :: squares.filter((n) => (n > 5)).to_list()
    print(big)
    total :: nums.reduce(0, (acc: Int, n: Int) => (acc + n))
    print(total)
    words := ["pear", "apple", "fig"]
    words.sort_by((w: String) => w.len())
    print(words)
}
