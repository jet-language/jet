// C-style increment/decrement (D-INCR1=A).
// Prefix `++x`/`--x` return the updated value; postfix `x++`/`x--` return
// the old value. Operand must be a mutable integer lvalue (`:=` binding or
// `&self` field). Overflow traps like `+= 1` (D-NUMOPS2).
fn run() {
    lives := 3
    tick := 0
    loop --lives > 0 {
        tick++
        print("tick {tick} lives {lives}")
    }
    n := 5
    print(n++)
    print(n)
    print(++n)
    print(n)
}
