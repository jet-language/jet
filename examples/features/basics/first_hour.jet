// First-hour tour: one small command-line tool that also builds as a native binary.
use core.io as io

fn run() {
    args :: io.args()
    project :: if args.len() > 1 -> args.get(1) ?? "first-hour" else -> "first-hour"
    steps :: ["check source", "build binary", "run smoke test"]
    print("Shipping {project}")
    loop step; steps {
        print("[ok] {step}")
    }
}
