// 36 — Counting with a source stride (D-LOOP-ADVANCE2=A).
fn run() {
    // `a..b` is inclusive (S22); the third clause selects every nth value.
    print("evens 0 to 10:")
    loop n, 0..10, 2 {
        print("  {n}")
    }
    // The default stride is 1 when you omit the third clause.
    print("down the row:")
    loop n, 1..3 {
        print("  {n}")
    }
    // `step` is an ordinary name; loop headers use semicolons, not role words.
    step :: 5
    print("a value named step: {step}")
}
