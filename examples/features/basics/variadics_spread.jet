// D-VARIADIC1 (c93): variadic parameters, call spread, and list spread.
fn join(prefix: String, msgs: ...String) -> String {
    return [prefix, ...msgs].join(" ")
}

fn run() {
    // variadic call — trailing args pack into `msgs`
    a :: join("log:", "hello", "world")
    print(a)
    // call spread — expand an existing list
    parts := [String].{"one", "two"}
    b :: join("tags:", ...parts)
    print(b)
    // list spread — flatten lists into one new list
    left := [String].{"a", "b"}
    right := [String].{"c"}
    merged :: [...left, "mid", ...right]
    print(merged.join(","))
}
