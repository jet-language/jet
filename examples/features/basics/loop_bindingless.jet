struct User {
    active: Bool
    name: String
}

struct Order {
    paid: Bool
    total: Int
}

fn run() {
    users :: [User]{
        User{active: true, name: "Ada"},
        User{active: false, name: "Grace"}
    }
    orders :: [Order]{
        Order{paid: true, total: 12},
        Order{paid: false, total: 20}
    }
    words :: [String]{"jet", "loop"}

    names :: loop users if .active -> .name
    totals :: loop orders if .paid -> .total
    upper :: loop words -> .to_upper()
    doubled :: loop n, [1, 2] -> n * 2

    print(names)
    print(totals)
    print(upper)
    print(doubled)
}
