// 03 — Values and types.
// `name :: value` names a value that never changes; `name := value` names one
// that can (D-BIND1). Type annotations are optional — Jet infers locals (S4).
fn main() {
    name: String :: "Jet"  // annotated
    year :: 2026  // inferred as Int
    version :: 0.1  // inferred as Float
    ready: Bool :: true
    // arithmetic, with the usual precedence
    sum :: (7 + (3 * 4))  // 19, not 40
    half :: (19.0 / 2.0)  // Float division keeps the fraction
    leftover :: (19 % 4)  // remainder
    depth :: (-12)
    // any expression can sit inside { } in quoted text (S8)
    print("{name} {version} (ready: {ready})")
    print("sum {sum}, half {half}, leftover {leftover}")
    print("next year is {(year + 1)}, depth {depth}")
    // escapes: \n newline, \t tab, \" quote, \\ backslash (S20)
    print("line one\nline two")
    print("col a\tcol b")
    print("she said \"hi\"")
    print("a real backslash: \\")
    // literal braces are doubled, since { } means interpolation (S20)
    print("braces print {{like this}}")
}
// --- expected output --------------------------------------------------
// Jet 0.1 (ready: true)
// sum 19, half 9.5, leftover 3
// next year is 2027, depth -12
// line one
// line two
// col a	col b
// she said "hi"
// a real backslash: \
// braces print {like this}
