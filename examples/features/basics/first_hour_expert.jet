// Expert variant of first_hour.jet (D-EXAMPLES-SHORTPATH1=A).
// Hand-walks raw `process.argv()` instead of the `#CLI` typed entry the flagship teaches.
use core.process as process

fn run() {
    args :: process.argv()
    project :: if args.len() > 1 -> args.get(1) ?? "first-hour" else -> "first-hour"
    steps :: ["check source", "build binary", "run smoke test"]
    print("Shipping {project}")
    loop step, steps -> print("[ok] {step}")
}
