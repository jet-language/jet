// FizzBuzz, 1 through 15, with both loops (S19).
// `1..15` is inclusive — it counts 1 through 15 (S22).
// `break` and `next` work inside both loops (D-LOOP-CONTROLWORD1).
// A function hands back a value with `-> Type` and `return`.
fn label(n: Int) => String {
    return if {
        n % 15 == 0 -> "FizzBuzz"
        n % 3 == 0 -> "Fizz"
        n % 5 == 0 -> "Buzz"
        else -> "{n}"
    }
}

fn run() {
    // `for` walks a range, one number at a time
    loop n, 1..15 { print(label(n)) }
    // `loop cond` repeats as long as its condition holds
    fuel := 3
    loop fuel > 0 {
        print("t-minus {fuel}")
        fuel -= 1
    }
    print("liftoff")
}
// --- expected output --------------------------------------------------
// 1
// 2
// Fizz
// 4
// Buzz
// Fizz
// 7
// 8
// Fizz
// Buzz
// 11
// Fizz
// 13
// 14
// FizzBuzz
// t-minus 3
// t-minus 2
// t-minus 1
// liftoff
