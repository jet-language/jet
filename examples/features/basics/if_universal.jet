// if_universal — D-IF3/D-IFGUARD1. `if` is the one branching keyword. Beyond the familiar
// two-arm form, an ordered pattern-arm table is the preferred multi-arm form:
//   - the `==` marker enters value/pattern dispatch;
//   - a bare value arm compares against the subject (`subject == value`);
//   - a range arm `lo..hi ->` matches a band;
//   - any Boolean expression is evaluated as written;
//   - an arm body is a braceless single statement OR a `{ … }` block;
//   - `else -> …` is the catch-all.
fn classify(code: Int) => String {
    // Bare-value arms (inferred `code == …`), a range arm, braceless and block
    // bodies, and an `else` catch-all — mixed freely.
    if code == {
        200 -> return "ok"
        404 -> {
            note :: "not found"
            return note
        }
        500..599 -> return "server error"
        else -> return "other"
    }
}

fn run() {
    print(classify(200))
    print(classify(404))
    print(classify(503))
    print(classify(301))
    // The conventional two-arm `if` is unchanged.
    n :: 7
    if n > 5 print("big") else print("small")
    // A subject is optional. Arbitrary Boolean heads run in order, first true wins.
    if n > 10 print("too big")
    if {
        n < 0 -> print("negative")
        n < 10 -> print("single digit")
    }
    // A value table is total: its final else is required.
    size :: if {
        n < 5 -> "small"
        n < 10 -> "medium"
        else -> "large"
    }
    print(size)
}
