fn rec(n: Int) Int -> {
    if n == 0 {
        return 0
    }
    return rec(n - 1) + 1
}

fn second(n: Int) Int -> {
    if n == 0 {
        return 0
    }
    return second(n - 1) + 1
}

fn even(n: Int) Int -> {
    if n == 0 {
        return 0
    }
    return odd(n - 1) + 1
}

fn odd(n: Int) Int -> {
    if n == 0 {
        return 0
    }
    return even(n - 1) + 1
}

fn run() {
    print(rec(10))
    print(second(10))
    print(even(1000))
    print(odd(1000))
}
