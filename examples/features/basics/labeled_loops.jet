// labeled_loops — D-LOOPLABEL2. A loop can carry a `name@` label; `break name@`
// and `continue name@` target that loop from inside a nested one.
fn run() {
    // `break outer@` leaves both loops at once on the first match.
    found := ""
    outer@ loop row in [1, 2, 3] {
        loop col in [1, 2, 3] {
            if (row * col) == 6 {
                found = "{row}x{col}"
                break outer@
            }
        }
    }
    print("first product 6 at {found}")
    // `continue rows@` skips to the next outer iteration.
    count := 0
    rows@ loop r in [1, 2, 3] {
        loop c in [1, 2, 3] {
            if c == 2 {
                continue rows@
            }
            count += 1
        }
    }
    print("counted {count}")
}
