struct User {
    active: Bool
    name: String
}

fn run() {
    users :: [User]{
        {active: true, name: "Ada"},
        {active: false, name: "Grace"},
        {active: true, name: "Lin"}
    }

    named :: loop user, users if user.active -> user.name
    subject :: loop users if .active -> .name
    chained :: users.filter(.active).map(.name)

    print(named)
    print(subject)
    print(chained)
}
