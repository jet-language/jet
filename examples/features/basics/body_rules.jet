// body_rules — D-CALLABLE-ONE1=A, D-BODY-LAST1=B, D-SIG-SHAPE1=B and
// D-LOOP-STMT-ARROW1=C.
fn twice(n: Int) Int -> {
    adjusted :: n + 1
    adjusted * 2
}

fn early(n: Int) Int -> {
    if n == 0 -> return 7
    n * 2
}

fn label(n: Int) String -> {
    if n == {
        1 -> "one"
        else -> "other"
    }
}

fn report(value: Int) {
    print("report {value}")
}

fn save() ! {
    report(0)
}

fn run() {
    if true -> print("if arrow")
    loop value in [1, 2] -> print("loop {value}")
    print(twice(3))
    print(early(0))
    print(early(3))
    print(label(1))
}
