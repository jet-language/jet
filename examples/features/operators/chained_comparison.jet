// D-CHAINCMP1: a same-direction relational chain reads like the range guard
// it is — `0 <= sev < 10` means "sev is between 0 and 10", not two separate
// comparisons the reader has to join by hand. `==`/`!=` never chain.
fn main() {
    sev :: 5
    if 0 <= sev < 10 {
        print("in range")
    }
}
