// D-FOUND-SANDBOX1: this package declares the one host capability it needs.
// Build the Component from its canonical entry with:
//   (cd examples/features/foundations/capabilities/guest && \
//       jet build capability_guest.jet --target=sandbox)
// This writes guest/build/capability_guest.wasm, which the host loads with a
// resource-scoped FS.Read authority; no ambient host authority is inherited.
name: "capability_guest"
version: "0.1.0"
edition: "2026"
authority: {
    needs: [FS.Read],
}
