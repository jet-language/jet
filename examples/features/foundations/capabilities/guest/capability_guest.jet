use core.files as fs

#Codable
pub struct Row {
    pub label: String
    pub score: Int
}

pub fn greet(name: String) String -> "hello, {name}!"

pub fn scale(value: Float, factor: Float) Float -> value * factor

pub fn index(rows: [Row]) Int -> {
    total := 0
    loop row in rows {
        total += row.score
    }
    return total
}

pub fn read(path: String) String !String -> {
    text :: fs.read(path) ?? return Err("{err}")
    return Ok(text)
}
