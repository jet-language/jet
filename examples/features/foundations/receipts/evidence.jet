use core.encoding.json as json

#[Receipt("regression"), Codable]
struct RegressionEvidence {
    slope: Float
    intercept: Float
    residuals: [Float]
    tolerance: Float
    max_residual: Float
    passed: Bool
}

fn run() {
    evidence :: RegressionEvidence{
        slope: Float{1.9},
        intercept: Float{0.2},
        residuals: [Float]{Float{0.0}, Float{-0.1}, Float{0.2}, Float{0.0}},
        tolerance: Float{0.25},
        max_residual: Float{0.2},
        passed: true
    }
    receipt.attach(evidence)
    print("pure:{json.to_string(evidence)}")
}
