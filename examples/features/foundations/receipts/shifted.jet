use core.encoding.json as json
use core.math as math

#[Receipt("regression"), Codable]
struct RegressionEvidence {
    slope: Float
    intercept: Float
    residuals: [Float]
    tolerance: Float
    max_residual: Float
    passed: Bool
}

fn fit() RegressionEvidence -> {
    x1 :: Float{1.0}
    x2 :: Float{2.0}
    x3 :: Float{3.0}
    x4 :: Float{4.0}
    y1 :: Float{2.5}
    y2 :: Float{4.3}
    y3 :: Float{6.1}
    y4 :: Float{8.7}
    slope :: (y4 - y1) / (x4 - x1)
    intercept :: y1 - slope * x1
    residuals :: [Float]{
        y1 - (intercept + slope * x1),
        y2 - (intercept + slope * x2),
        y3 - (intercept + slope * x3),
        y4 - (intercept + slope * x4)
    }
    max_residual :: math.max(
        math.max(math.abs(residuals[0]), math.abs(residuals[1])),
        math.max(math.abs(residuals[2]), math.abs(residuals[3]))
    )
    tolerance :: Float{0.25}
    passed :: max_residual <= tolerance
    RegressionEvidence{
        slope,
        intercept,
        residuals,
        tolerance,
        max_residual,
        passed
    }
}

fn run() {
    evidence :: fit()
    receipt.attach(evidence)
    print("receipt:shifted")
    print("evidence:{json.to_string(evidence)}")
    print("passed:{evidence.passed}")
    if evidence.passed -> panic("shifted regression evidence unexpectedly passed")
}
