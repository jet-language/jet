// 07 — Choosing one branch from many: multi-arm `if` (D-IF3).
// `if subject == { arm -> body }`: the `==` marker enters value dispatch, a
// bare-value arm compares against the subject, the first matching arm runs, and
// `else ->` catches the rest.
// The backend lowers value-equality chains to a native Rust match (jump
// tables where profitable), so this is never slower than if/else.
// S25: in a `||` chain, a plain value re-applies the nearest comparison —
// `"sat" || "sun"` means `day == "sat" || day == "sun"`.
fn day_type(day: String) -> String {
    if day == {
        "sat" || "sun" -> {
            return "weekend"
        }
        "mon" || "tue" || "wed" || "thu" || "fri" -> {
            return "weekday"
        }
        else -> {
            return "not a day"
        }
    }
}
fn main() {
    code @= 404
    // D-IF3 Q4: a band uses a range arm, not a predicate.
    if code == {
        200 -> {
            print("ok")
        }
        301 || 302 -> {
            print("redirected")
        }
        400..499 -> {
            print("client error")
        }
        else -> {
            print("unexpected: {code}")
        }
    }
    print(day_type("sun"))
    print(day_type("wed"))
    print(day_type("pizza"))
}
// --- expected output --------------------------------------------------
// client error
// weekend
// weekday
// not a day
