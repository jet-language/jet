// D-LOGFMT1=A: human-readable log format.
// log.setup("text") forces text format so this works consistently regardless of TTY.
// Log lines go to stderr; only the print goes to stdout (the golden .out file).
use jet.log as log

fn main() {
    log.setup("text")
    log.set_level("info")
    log.info("server started on port 8080")
    log.warn("connection pool below 10%")
    log.debug("this won't print at info level")
    log.info("processed 42 requests")
    print("log demo done")
}
