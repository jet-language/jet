// D-DBDRIVER1: core.db — the generic parameterized driver interface. SQL text
// plus a separate `[DBValue]` bind list; the driver binds the values, so they
// never get concatenated into the SQL string. There is no raw execute(sql)
// escape hatch — `.query`/`.query_one`/`.execute` are the only ways to talk
// to the database.
use core.db as db

fn run() {
    conn :: db.open_memory()
    _created :: conn.execute("CREATE TABLE greet (id INTEGER PRIMARY KEY, msg TEXT)", []) ?? panic("create failed")
    // An "injection-looking" literal — because it is a BIND PARAMETER, not
    // spliced SQL text, it round-trips as inert data.
    evil :: "'; DROP TABLE greet; --"
    _ins1 :: conn.execute("INSERT INTO greet (msg) VALUES (?)", [DBValue.Text(evil)]) ?? panic("insert failed")
    _ins2 :: conn.execute("INSERT INTO greet (msg) VALUES (?)", [DBValue.Text("hello, jet.db!")]) ?? panic("insert failed")
    rows :: conn.query("SELECT msg FROM greet ORDER BY id", []) ?? panic("query failed")
    loop row; rows {
        msg_val :: row.get("msg") ?? panic("missing msg")
        msg :: msg_val.text() ?? panic("msg is not text")
        print(msg)
    }
    // Prove the table survived the "injection": still exactly 2 rows.
    count_opt :: conn.query_one("SELECT COUNT(*) AS n FROM greet", []) ?? panic("count failed")
    if count_opt == .Val(count_row) {
        n_val :: count_row.get("n") ?? panic("missing n")
        n :: n_val.int() ?? panic("n is not an int")
        print("row count: {n}")
    }
    // A transaction: an insert inside begin/rollback must not stick.
    _begun :: conn.begin()
    _ins3 :: conn.execute("INSERT INTO greet (msg) VALUES (?)", [DBValue.Text("temporary")]) ?? panic("insert failed")
    _rolledback :: conn.rollback()
    after_opt :: conn.query_one("SELECT COUNT(*) AS n FROM greet", []) ?? panic("count failed")
    if after_opt == .Val(after_row) {
        n_val :: after_row.get("n") ?? panic("missing n")
        n :: n_val.int() ?? panic("n is not an int")
        print("row count after rollback: {n}")
    }
    _closed :: conn.close()
}
