// E2-M9: jet.log — structured logging with levels.
use core.log as log

fn main() {
    log.set_level("info")
    log.info("server started on port 8080")
    log.warn("connection pool below 10%")
    log.debug("this won't print at info level")
    log.info("processed 42 requests")
    print("log demo done")
}
