// D-NAME-ALIAS1=A: the readable Core prelude opens its closed ambient surface
// without a `use` line. A first program needs no namespace boilerplate.
//
// `greet` exercises `input` resolution (no `use`); main calls `print` for the
// deterministic golden output. Interactive use of input() is tested in
// tests/corelib.rs (io_input_reads_a_line_from_stdin).
fn greet() => String {
    name :: input() ?? "world"
    return "hello, {name}"
}

fn run() {
    assert(1 == 1)
    assert_eq(2, 2)
    print("prelude: print works without use")
    print("prelude: input is ambient (see greet fn)")
}
