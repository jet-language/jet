// D-NAME-ALIAS1=A / D-CORE-PRELUDE1=A: the readable Core prelude opens its
// closed ambient surface without a `use` line. A first program needs no
// namespace boilerplate. `core.files` is imported only for cleanup; the file
// trio below remains ambient.
use core.files as files

fn greet() String -> {
    name :: input() ?? "world"
    if name.is_empty() -> return "hello, world"
    return "hello, {name}"
}

fn run() {
    print("prelude: print works without use")
    eprint("prelude: eprint works")
    assert(1 == 1)
    assert_eq([[1, 2], [3, 4]], [[1, 2], [3, 4]])
    print("prelude: input: {greet()}")

    now :: Clock.now()
    today :: Date.today()
    duration :: 1s
    _ :: now
    _ :: today
    _ :: duration
    print("prelude: Clock.now, Date.today and Duration are ambient")

    path :: Path.home().join("logs").join("x.txt")
    home_join_ok :: path.to_string().ends_with("x.txt")
    print("prelude: Path.home().join works: {home_join_ok}")

    temp :: "/tmp/jet-io-prelude.txt"
    if files.exists(temp) -> files.remove(temp)
    write_file(Path.from(temp), "ambient")
    print("prelude: file_exists: {file_exists(temp)}")
    // D-FAIL-EXIT1=A: `fn run()` is fallible by default, so its miss route
    // carries the failure value the entry contract owes.
    text_from_string :: read_file(temp)
    text_from_path :: read_file(Path.from(temp))
    print("prelude: read_file Path: {text_from_path}")
    files.remove(temp)
}
