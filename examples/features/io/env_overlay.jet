use core.env as env

fn run() {
    env.set("JET_ENV_EXAMPLE", "ready")
    print(env.get("JET_ENV_EXAMPLE") ?? "missing")
    names :: env.vars() ?? panic("environment is not Unicode")
    print(names.contains("JET_ENV_EXAMPLE"))
    print(env.unset("JET_ENV_EXAMPLE") ?? false)
    print(env.unset("JET_ENV_EXAMPLE") ?? true)
}
