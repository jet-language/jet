// D-COREIO1=A / D-IO-PROMPT1=A: terminal facts, streams, and interactive prompts.
use core.env as env
use core.io as io

fn run() {
    env.set("COLUMNS", "100")
    env.set("LINES", "40")
    env.set("NO_COLOR", "1")
    confirmed :: io.confirm("Continue?")
    print("confirm: {confirmed}")
    choice :: io.choose("Choose a target:", ["staging", "production"]) ?? panic("choose failed")
    print("choice: {choice}")
    if io.input_secret("Secret: ") == {
        .Ok(secret) -> { print("secret length: {secret.len()}") }
        .Err(error) -> {
            if error == {
                .InvalidInput(_) -> { print("secret: non-tty") }
                else -> { print("secret: other error") }
            }
        }
    }
    out :: io.stdout()
    err_stream :: io.stderr()
    out.write("stdout") ?? panic("stdout write failed")
    out.write(" stream") ?? panic("stdout write failed")
    out.flush() ?? panic("stdout flush failed")
    out.write_line("") ?? panic("stdout newline failed")
    bytes :: [U8].{114, 97, 119, 10}
    out.write_bytes(bytes) ?? panic("stdout bytes failed")
    print("stdout tty: {out.is_tty()}")
    print("stderr tty: {err_stream.is_tty()}")
    print("size: {io.terminal_width()}x{io.terminal_height()}")
    print(io.style("red", "plain"))
    print(io.style_force("green", "forced").len())
    io.progress("progress") ?? panic("progress failed")
    err_stream.write_line("stderr stream") ?? panic("stderr write failed")
    err_stream.flush() ?? panic("stderr flush failed")
}
