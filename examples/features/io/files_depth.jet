// D-FSOPS1=A: std-backed filesystem depth beyond read/write/list_dir.
use core.files as fs

fn run() {
    root :: "/tmp/jet_files_depth_demo"
    copy_root :: "/tmp/jet_files_depth_demo_copy"
    if fs.exists(root) :> fs.remove_all(root) ?? return Err("cleanup root failed")
    if fs.exists(copy_root) :> fs.remove_all(copy_root) ?? return Err("cleanup copy failed")
    nested :: Path.from(root).join("a/b")
    fs.create_dir_all(nested) ?? return Err("mkdir failed")
    file :: nested.join("data.txt")
    fs.write(file, "abcdef") ?? return Err("write failed")
    stat :: fs.stat(file) ?? return Err("stat failed")
    print("stat: {stat.kind} {stat.size} {stat.is_file}")
    part :: fs.read_at(file, 2, 3) ?? return Err("read_at failed")
    print("read_at bytes: {part.len()}")
    patch :: [U8]{88, 89}
    fs.write_at(file, 3, patch) ?? return Err("write_at failed")
    fs.fsync(file) ?? return Err("fsync failed")
    text :: fs.read(file) ?? return Err("read failed")
    print(text)
    atom :: [U8]{79, 75}
    atomic_path :: nested.join("atomic.txt")
    fs.write_atomic(atomic_path, atom) ?? return Err("atomic write failed")
    atomic_text :: fs.read(atomic_path) ?? return Err("atomic read failed")
    print("atomic: {atomic_text}")
    walked :: fs.walk(root) ?? return Err("walk failed")
    print("walk count: {walked.len()}")
    matches :: fs.glob(Path.from(root).join("*.txt")) ?? return Err("glob failed")
    print("glob count: {matches.len()}")
    link :: Path.from(root).join("data.link")
    fs.symlink(file, link) ?? return Err("symlink failed")
    link_stat :: fs.stat(link) ?? return Err("link stat failed")
    link_target :: fs.read_link(link) ?? return Err("read_link failed")
    print("link: {link_stat.is_symlink} {link_target}")
    hard :: Path.from(root).join("hard.txt")
    fs.hard_link(file, hard) ?? return Err("hard link failed")
    print("hard exists: {fs.exists(hard)}")
    canon :: fs.canonicalize(file) ?? return Err("canonicalize failed")
    canon_has_file :: canon.contains("data.txt")
    print("canon has file: {canon_has_file}")
    abs :: fs.absolute("examples") ?? return Err("absolute failed")
    abs_has_examples :: abs.contains("examples")
    print("absolute examples: {abs_has_examples}")
    fs.copy_dir(root, copy_root) ?? return Err("copy_dir failed")
    copied :: Path.from(copy_root).join("a/b/data.txt")
    print("copy exists: {fs.exists(copied)}")
    tmpd :: fs.temp_dir("jet-depth") ?? return Err("temp_dir failed")
    tmpf :: fs.temp_file("jet-depth") ?? return Err("temp_file failed")
    print("temp handles: {fs.exists(tmpd.path)} {fs.exists(tmpf.path)}")
    lock_path :: Path.from(root).join("build.lock")
    lock :: fs.lock(lock_path) ?? return Err("lock failed")
    print("lock exists: {fs.exists(lock.path)}")
    fs.remove_all(root) ?? return Err("remove root failed")
    fs.remove_all(copy_root) ?? return Err("remove copy failed")
    print("removed: {(!fs.exists(root)) && (!fs.exists(copy_root))}")
}
