// D-WATCH-SCOPE1=A/comment: core.watcher owns file/process/port watch handles.
use core.event as event
use core.files as fs
use core.path as path
use core.watcher as watcher

fn run() {
    root :: "/tmp/jet_watcher_demo"
    if fs.exists(root) {
        fs.remove_all(root) ?? panic("cleanup failed")
    }
    fs.create_dir_all(root) ?? panic("mkdir failed")

    scope :: event.scope()
    files :: watcher.files(root) ?? panic("watch files failed")
    files.on(scope, (ev) => {
        print("callback {ev.domain}:{ev.kind}:{ev.detail}")
    })

    created :: path.join(root, "note.txt")
    fs.write(created, "hello") ?? panic("write failed")
    first :: files.poll()
    first_kind := "none"
    if first.len() > 0 {
        ev :: first.get(0) ?? panic("missing file event")
        first_kind = ev.kind
    }
    print("file events: {first.len()} {first_kind}")

    dead :: watcher.process_pid(-1)
    proc_events :: dead.poll()
    proc_kind := "none"
    if proc_events.len() > 0 {
        ev :: proc_events.get(0) ?? panic("missing process event")
        proc_kind = ev.kind
    }
    print("process events: {proc_events.len()} {proc_kind}")

    closed :: watcher.port("127.0.0.1", 1)
    print("port events: {closed.poll().len()}")

    set := watcher.set()
    set.add(dead)
    combined :: set.poll()
    print("set events: {combined.len()}")

    fs.remove_all(root) ?? panic("remove failed")
}
