// D-PATHFS1=A: Typed Path API — construction, decomposition, and directory listing.
fn run() {
    home_child :: Path.home().join("logs").join("x.txt")
    home_join_ok :: home_child.to_string().ends_with("x.txt")
    print("home join: {home_join_ok}")

    p :: Path.from("/tmp/example/data.json")
    print(p.to_string())
    ext :: p.extension()
    if ext == .Val(e) -> print("extension: {e}")
    st :: p.stem()
    if st == .Val(s) -> print("stem: {s}")
    par :: p.parent()
    if par == .Val(d) {
        print("parent: {d.to_string()}")
        child :: d.join("output.txt")
        print("child: {child.to_string()}")
    }
    // Walk a bounded source directory. Walking the workspace root also scans
    // build outputs and agent worktrees, so runtime depends on ambient state.
    paths :: Path.from("examples/features/io").walk()
    print("walk non-empty: {paths.len() > 0}")

    // `is_within` is lexical. Use `canonicalize` when symlink identity matters.
    inside :: Path.from("/srv/root/a/../file").is_within(Path.from("/srv/root"))
    partial_name :: Path.from("/srv/rooted/file").is_within(Path.from("/srv/root"))
    escaped :: Path.from("/srv/root/../outside").is_within(Path.from("/srv/root"))
    mixed_separators :: Path.from("srv\\root\\file").is_within(Path.from("srv/root"))
    print("within: {inside} {partial_name} {escaped} {mixed_separators}")
}
