// E2-M7: streaming I/O with RAII handles.
// Files close automatically on every exit path, including `?` early returns.
use core.files as fs
use core.files as files

fn count_lines(src: String) => Int ? IOError {
    handle :: files.open(~src)?
    n := 0
    loop line, handle.lines() { n += 1 }
    return Ok(n)
}

fn copy_upper(src: String, dst: String) => Int ? IOError {
    input :: files.open(~src)?
    output :: files.create(~dst)?
    n := 0
    loop line, input.lines() {
        output.write_line(line.to_upper())?
        n += 1
    }
    return Ok(n)
}

fn run() {
    src :: Path.from("/tmp").join("jet_m7_src.txt").to_string()
    dst :: Path.from("/tmp").join("jet_m7_dst.txt").to_string()
    // Write test data via whole-file helper (D-IO3: kept as sugar).
    wrote :: fs.write(src, "alpha\nbeta\ngamma")
    // Stream-copy with uppercase transform — bounded memory.
    copied :: copy_upper(src, dst) ?? panic("copy failed")
    // Verify: read destination and print.
    result :: fs.read(dst) ?? panic("read failed")
    print(result)
    // Count lines streaming.
    n :: count_lines(src) ?? panic("count failed")
    print("lines: {n}")
    // std.path helpers.
    print(Path.from("/home/user/file.txt").parent())
    print(Path.from("/home/user/file.txt").extension())
    print(Path.from("/home/user/../file.txt").normalize().to_string())
}
