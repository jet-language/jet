// D-EFFDBREAD1=A: core.db read/write effect leaves. The compiler's own closed
// core.db method table now tags `conn.query`/`conn.query_one` with the `DB.Read`
// effect leaf and `conn.execute` with `DB.Write` (transaction-control and
// `close` keep the plain `DB` root). So a read-only query function can PROVE
// `-[DB.Read]>` — the read-footprint qualification a live query (D-LIVEQUERY1)
// rides on. A write hiding inside such a function would be rejected by E0740.
use core.db as db

// A checked read-only query: its only DB effect is `DB.Read`, so the
// `-[DB.Read]>` bound holds. Decoding a row value (`.get`/`.int`) is pure,
// so it adds no effect — the query's implicit error propagation and the
// row-field `??` fallbacks are the whole set. A `conn.execute` hiding in here would need `DB.Write`
// and be rejected by E0740, which is the point.
fn person_count(conn: DBScope) Int -[DB.Read]> {
    row_opt :: conn.query_one(SQL{"SELECT COUNT(*) AS n FROM person"})
    if row_opt == .Val(row) {
        n_val :: row.get("n") ?? panic("missing n")
        return n_val.int() ?? 0
    }
    return 0
}

fn run() {
    conn :: db.open_memory()
    policy :: db.policy("person", "true") ?? panic("policy")
    scoped :: conn.with_policy(policy, "owner")
    _created :: db.migrate(scoped, "person-v1", [SQL{"CREATE TABLE person (id INTEGER PRIMARY KEY, name TEXT)"}]) ?? panic("create failed")
    ada :: "Ada"
    _a :: scoped.execute(SQL{"INSERT INTO person (name) VALUES ({ada})"}) ?? panic("insert failed")
    grace :: "Grace"
    _b :: scoped.execute(SQL{"INSERT INTO person (name) VALUES ({grace})"}) ?? panic("insert failed")
    print("people: {person_count(scoped)}")
    _closed :: scoped.close()
}
