// D-EFFDBREAD1=A: core.db read/write effect leaves. The compiler's own closed
// core.db method table now tags `conn.query`/`conn.query_one` with the `DB.Read`
// effect leaf and `conn.execute` with `DB.Write` (transaction-control and
// `close` keep the plain `DB` root). So a read-only query function can PROVE
// `=[DB.Read]=>` — the read-footprint qualification a live query (D-LIVEQUERY1)
// rides on. A write hiding inside such a function would be rejected by E0740.
use core.db as db

// A checked read-only query: its inferred effect is exactly `DB.Read`, so the
// `=[DB.Read]=>` bound holds. Decoding a row value (`.get`/`.int`) is pure, so it
// adds no effect — only the `conn.query_one` read does.
fn person_count(conn: DBScope) =[DB.Read]=> Int {
    row_opt :: conn.query_one("SELECT COUNT(*) AS n FROM person", []) ?? panic("count failed")
    if row_opt == .Val(row) {
        n_val :: row.get("n") ?? panic("missing n")
        return n_val.int() ?? 0
    }
    return 0
}

fn run() {
    conn :: db.open_memory()
    policy :: db.policy("person", "true") ?? panic("policy")
    scoped :: conn.with_policy(policy, "owner") ?? panic("scope")
    _created :: db.migrate(scoped, "person-v1", ["CREATE TABLE person (id INTEGER PRIMARY KEY, name TEXT)"]) ?? panic("create failed")
    _a :: scoped.execute("INSERT INTO person (name) VALUES (?)", [DBValue.Text("Ada")]) ?? panic("insert failed")
    _b :: scoped.execute("INSERT INTO person (name) VALUES (?)", [DBValue.Text("Grace")]) ?? panic("insert failed")
    print("people: {person_count(scoped)}")
    _closed :: scoped.close()
}
