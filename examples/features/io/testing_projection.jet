// D-TESTING1: corpus, fixture, and golden helpers all read explicit paths.
use core.testing as testing

fn run() {
    corpus :: testing.corpus("examples/features/expected/io")
    fixture :: testing.fixture("examples/features/expected/io/db.out")
    golden :: testing.golden("examples/features/expected/io/db.out", "")
    print("corpus:{corpus.len()}")
    print("fixture:{fixture.len()}")
    print("golden:{golden}")
}
