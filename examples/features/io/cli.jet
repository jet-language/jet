use core.io as io
use core.env as env
use core.process as process

fn main() {
    args :: io.args()
    mode :: env.get("JET_M10_MODE") ?? "default"
    // `jet run tool.jet alice` forwards words after the file as argv (index 0 stays the program name).
    if args.len() >= 2 {
        print(args.get(1) ?? "")
    } else {
        print(args.len())
    }
    print(mode)
    process.exit(0)
}
