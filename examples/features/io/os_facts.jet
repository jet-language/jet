// D-OSFACTS1: system facts live in core.os; core.env stays environment vars.
use core.os as os

fn run() {
    print(os.name().len() > 0)
    print(os.family().len() > 0)
    print(os.arch().len() > 0)
    print(os.cpu_count() >= 1)
    print(os.temp_dir().len() > 0)
    print(os.executable().len() > 0)
    print(os.pid() >= 1)
    print(os.hostname().len() > 0)
}
