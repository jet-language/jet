// 86 — D-LSDIR1: fs.list_dir returns [DirEntry] ({name, path, is_dir}).
// Path.join(name) builds portable paths for experts who need finer control.
use core.files as fs

fn run() {
    dir :: "/tmp/jet_lsdir_demo"
    fs.create_dir(dir)
    fs.write(Path.from(dir).join("hello.txt"), "hi")
    sub :: Path.from(dir).join("sub")
    fs.create_dir(sub)
    entries :: fs.list_dir(dir)
    loop entry in entries {
        if {
            entry.is_dir -> { print("dir:  {entry.name}") }
            else -> { print("file: {entry.name}") }
        }
    }
    joined :: Path.from(dir).join("hello.txt")
    print(fs.exists(joined))
}
