// D-SHIFT1 (c7shift): `binary.Reader` — the "shift" kernel from linear
// stream parsing (Jai's `shift` primitive), without a dedicated operator.
// `Reader.over(bytes)` wraps a `[U8]` buffer; every read advances the
// position and returns a prefix-contract result such as `U32 !String` — a bounds miss is an ordinary error
// value, never a panic or silent truncation (I1).
fn run() {
// header/count/payload wire shape: a little-endian u32 magic, a
// little-endian u16 item count, then that many raw bytes.
    packet :: [U8]{0x2a, 0x00, 0x00, 0x00, 0x03, 0x00, 0x10, 0x20, 0x30}
    // magic = 42
    // count = 3
// payload
    r :: Reader.over(packet)
    magic :: r.read_u32_le() ?? return Err("bad packet: no magic")
    count :: r.read_u16_le() ?? return Err("bad packet: no count")
    // D-BINREAD-LEN1=A: unsigned wire lengths through U32 widen internally.
    payload :: r.take(count) ?? return Err("bad packet: short payload")
    print("magic={magic} count={count} payload_len={payload.len()}")
    print("remaining={r.remaining()} is_at_end={r.is_at_end()}")

    counted8 :: Reader.over([U8]{0x01, 0xA0})
    length8 :: counted8.read_u8() ?? return Err("bad U8 count")
    payload8 :: counted8.take(length8) ?? return Err("bad U8 payload")
    counted32 :: Reader.over([U8]{0x02, 0x00, 0x00, 0x00, 0xB0, 0xC0})
    length32 :: counted32.read_u32_le() ?? return Err("bad U32 count")
    payload32 :: counted32.take(length32) ?? return Err("bad U32 payload")
    print("sized payloads={payload8.len()}/{payload.len()}/{payload32.len()}")

    floats :: Reader.over([U8]{
        0x00,
        0x00,
        0xC0,
        0x3F,
        0x00,
        0x00,
        0x00,
        0x00,
        0x00,
        0x00,
        0x04,
        0x40
    })
    f32 :: floats.read_f32_le() ?? return Err("bad F32")
    f64 :: floats.read_f64_le() ?? return Err("bad Float")
    print("float_reads={f32}/{f64} remaining={floats.remaining()}")

    magic_bytes :: Reader.over(b"JGB1").take(4) ?? return Err("short byte magic")
    bytes_match :: magic_bytes == b"JGB1"
    print("bytes_match={bytes_match}")

    max_u64 :: u64_from_bytes(b"\xff\xff\xff\xff\xff\xff\xff\xff")
    wrapped_u64 :: max_u64.wrapping_add(U64{1})
    fnv :: fnv1a(b"hello")
    print("u64_wrap={wrapped_u64} fnv1a={fnv}")

    // A bounds miss is an ordinary error value — `?`-composable, never a panic.
    short :: [U8]{0x01}
    r2 :: Reader.over(short)
    short_value :: r2.read_u32_le() ?? 0
    print("short read fallback={short_value}")

    // D-BINPAT1 (card #506 follow-up): `take_pattern([U8]{"…"})` — the byte-mode
    // sibling of `Cursor.take_pattern`, reusing the D-BINPAT1 pattern engine
    // (`try_bin_match_pattern`'s `{name:U<width>}` holes) in CONSUME mode:
    // it advances the reader past the matched prefix instead of requiring
    // the whole remaining bytes to match, so more reads can follow.
    header :: [U8]{0x45, 0x00, 0x00, 0x28, 0xDE, 0xAD, 0xBE, 0xEF}
    r3 :: Reader.over(header)
    parsed :: r3.take_pattern([U8]{"{version:U4}{ihl:U4}{tos:U8}{len:U16be}"}) ?? return Err("bad header")
    print("IPv{parsed.version}, header {parsed.ihl} words, tos {parsed.tos}, len {parsed.len}")
    left :: r3.remaining()
    payload2 :: r3.take(left) ?? return Err("short read")
    print("remaining after take_pattern={payload2.len()}")
}

fn u64_from_bytes(bytes: [U8]) U64 -> {
    value := U64{0}
    loop byte in bytes {
        value = value.wrapping_mul(U64{256}).wrapping_add(U64.from_u8(byte))
    }
    value
}

fn fnv1a(bytes: [U8]) U64 -> {
    offset :: u64_from_bytes(b"\xcb\xf2\x9c\xe4\x84\x22\x23\x25")
    prime :: u64_from_bytes(b"\x00\x00\x01\x00\x00\x00\x01\xb3")
    hash := offset
    loop byte in bytes {
        hash = (hash ~| U64.from_u8(byte)).wrapping_mul(prime)
    }
    hash
}
