// D-CLI-GLOBAL1=E: one program struct owns root flags and callable commands.
// Root flags are legal before or after the command. Command methods receive
// the read-only shared value; a binding can target an existing function.
//
// Run a subcommand:  jet run examples/features/cli/subcommands.jet -- serve --config prod --port 8080
//                    jet run examples/features/cli/subcommands.jet -- --config prod import data.csv
// Run --help:        jet run examples/features/cli/subcommands.jet -- serve --help
// Golden test (no extra args) exercises the bare-invocation shape: zero
// arguments prints the command list and exits 0 (docs/spec/spec.md — a bare
// invocation asking "what can this program do" isn't a mistake).
#CLI(Standard)
struct Commands {
    #[Doc("configuration file"), Env("COMMANDS_CONFIG")] config: String = "default"

    #Doc("preview changes") plan = plan_impl

    #Doc("Start the service and listen for requests")
    fn serve(self, port: Int = 3000) {
        print("serve")
        print(self.config)
        print(port)
    }

    #Doc("Import one data file")
    fn import(self, file: String) {
        print("import")
        print(self.config)
        print(file)
    }
}

fn plan_impl(args: Commands) {
    print("plan")
    print(args.config)
}

fn run(args: Commands) {
}
