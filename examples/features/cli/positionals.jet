// D-CLI-POS1=A: required command values fill from bare argv in declaration
// order. Optional / defaulted values stay flag-only. Every value still
// accepts its named `--field` form; named wins when both forms appear.
//
// Run:  jet run examples/features/cli/positionals.jet -- add buy-milk --due fri
//       jet run examples/features/cli/positionals.jet -- login secret
//       jet run examples/features/cli/positionals.jet -- --help
#CLI
struct Commands {
    #Doc("add a todo") fn add(self, text: String, due: String = "") {
        print("add")
        print(text)
        print(due)
    }

    #Doc("log in") fn login(self, token: String) {
        print("login")
        print(token)
    }
}

fn run(args: Commands) {

}
