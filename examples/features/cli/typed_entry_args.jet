// D-CLIFLAG1 (ratified 2026-07-01, option A): the entry function's typed
// parameter IS the CLI spec. `@[Cli]` derives one `--flag`/`--option`
// registration per field (see docs/spec/spec.md "Typed entry-signature CLI
// parsing" for the pinned field-mapping rule); `@[Doc("...")]` supplies that
// flag's `--help` text. `fn run(args: T)` replaces `fn main()` as the entry
// point and parses `io.args()` before calling the user body.
//
// Run with extra flags:  jet run examples/features/cli/typed_entry_args.jet -- --port 8080 --verbose --config prod.toml
// Run --help:            jet run examples/features/cli/typed_entry_args.jet -- --help
// Golden test (no extra args) exercises every field's default: `port` via
// `#[Default(...)]`, `verbose` as a plain flag (defaults false), `config` as
// `String?` (defaults null) — so a bare invocation is deterministic.
@Cli
struct ServeArgs {
    @[Doc("port to listen on")] #[Default(3000)] port: Int
    @[Doc("print extra detail")] verbose: Bool
    @[Doc("path to a config file")] config: String?
}

fn run(args: ServeArgs) {
    print(args.port)
    print(args.verbose)
    print(args.config ?? "(none)")
}
