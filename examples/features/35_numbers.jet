// S34: digit separators, base prefixes, and float exponents.
fn main() {
    val population = 8100000000;
    val red = 255;
    val perms = 493;
    val flags = 10;
    val avogadro = 602200000000000027262976.0;
    print("population: {population}");
    print("red channel: {red}");
    print("perms: {perms}");
    print("flags: {flags}");
    print("avogadro: {avogadro}");
}
