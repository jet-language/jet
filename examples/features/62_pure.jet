// S60 (E2-M16): `pure fn` checked modifier.
// A `pure fn` may only call other `pure fn`s; impure calls are E3401.
// Use `jet eval --pure 62_pure.jet` to evaluate this deterministically.
pure fn double(n: Int) -> Int {
    return (n * 2)
}
pure fn greeting(name: String) -> String {
    return "hello, {name}!"
}
fn main() {
    x :: double(21)
    print("{x}")
    g :: greeting("world")
    print(g)
}
