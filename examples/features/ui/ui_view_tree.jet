// D-UITREE1: one canonical UiNode tree. Repainting the same paths lets retained
// backends update stable native/DOM widgets instead of maintaining another View.
use core.ui as ui

fn run() {
    backend := ui.null_backend()
    initial := ui.box([ui.text("a"), ui.text("b")])
    size := backend.measure(initial, ui.constraint(0.0, 0.0, 80.0, 24.0))
    backend.layout(initial, ui.rect(0.0, 0.0, size.width, size.height))
    backend.paint(initial)
    print("paint: a")
    print("paint: b")

    updated := ui.box([ui.text("a"), ui.text("zz")])
    backend.paint(updated)
    print("update: zz")
}
