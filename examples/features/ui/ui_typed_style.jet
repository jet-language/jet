// One flat typed Style feeds the canonical UiNode paint pipeline directly.
// Lengths use Jet's existing unit-family mechanism; there is no parallel View.
use core.ui as ui

@UnitFamily(Length) { px }

struct Style {
    color: String
    width: Px
    height: Px
}

fn styled_text(text: String, style: Style) -> UiNode {
    return ui.node_color(text, style.width.raw(), style.height.raw(), style.color)
}

fn run() {
    red := Style.{color: "#dc143c", width: 10px, height: 4px}
    blue := Style.{color: "#1e3cc8", width: 20px, height: 4px}
    tree := ui.box([styled_text("a", red), styled_text("b", blue)])
    backend := ui.null_backend()
    size := backend.measure(tree, ui.constraint(0.0, 0.0, 80.0, 24.0))
    backend.layout(tree, ui.rect(0.0, 0.0, size.width, size.height))
    backend.paint(tree)
    print("a color={red.color} w={red.width.raw()} h={red.height.raw()}")
    print("b color={blue.color} w={blue.width.raw()} h={blue.height.raw()}")
    print("total width {(red.width.raw() + blue.width.raw())}")
}
