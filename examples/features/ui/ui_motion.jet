// 193 — reactive motion (Tower c134 Phase 5, D-MOTIONTIME1=A). A motion value
// is a PURE function of (target state, elapsed clock time): `tween` computes
// an eased interpolation from an injectable `Clock` reading. There is no
// imperative "tick" that pokes the animated value directly — the clock is
// the same injectable D-DET1 capability used elsewhere for deterministic
// tests (`core.time.clock(seed)`), not a global/ambient time signal. That is
// exactly the axis D-MOTIONTIME1 decided: injectable Clock over a global
// time signal, so animation tests are reproducible by construction.
//
// The elapsed-time reading lives in a `Signal<Int>`; `reactive.derived`
// recomputes the eased position whenever that signal changes. `x` (the
// animated value) is never `.set()` — only `elapsed` is, and only in
// response to explicitly advancing the injected `Clock`. That is the "no
// imperative frame mutation" rule: motion values are derived, not mutated.
use core.time as time
use core.reactive as reactive

// Smoothstep ease: 3t^2 - 2t^3, clamped at the ends. A correct, simple,
// deterministic interpolation — not a physics spring-damper model, which
// this phase's acceptance bar does not require.
fn tween(from: Float, to: Float, elapsed_ms: Int, duration_ms: Int) -> Float {
    if elapsed_ms <= 0 {
        return from
    }
    if elapsed_ms >= duration_ms {
        return to
    }
    t := elapsed_ms.to_float() / duration_ms.to_float()
    eased := t * t * (3.0 - 2.0 * t)
    return from + (to - from) * eased
}

fn main() {
    // D-DET1 injectable Clock, seeded at 0 — no wall-clock read, reproducible
    // by construction. `elapsed` is a Signal fed by explicit clock reads.
    clock := time.clock(0)
    elapsed #= reactive.signal(clock.now())
    x #= reactive.derived(() => tween(0.0, 100.0, elapsed.get(), 400))

    print("t={elapsed.get()} x={x.get()}")

    clock.tick(100)
    elapsed.set(clock.now())
    print("t={elapsed.get()} x={x.get()}")

    clock.tick(100)
    elapsed.set(clock.now())
    print("t={elapsed.get()} x={x.get()}")

    clock.tick(100)
    elapsed.set(clock.now())
    print("t={elapsed.get()} x={x.get()}")

    clock.tick(100)
    elapsed.set(clock.now())
    print("t={elapsed.get()} x={x.get()}")

    // Past the duration the motion clamps to the target — still a pure
    // function of elapsed time, no special-case mutation of x.
    clock.tick(200)
    elapsed.set(clock.now())
    print("t={elapsed.get()} x={x.get()}")
}
