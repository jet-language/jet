// D-UIDEVSHELL1=A (ratified 2026-07-03, c134 Phase 8): the native Linux UI
// backend — a real, working GTK4 app. `core.ui.gtk_backend()` is a `JetBackend`
// over libgtk-4: canonical `UiNode` trees reconcile into real widgets,
// `on_click` wires the reconciled button, and `present` opens the window.
//
// The counter below actually counts: the button's click sets a `reactive.signal`,
// the `ui.reactive_render` effect re-runs (it read the signal), and it updates
// the label's text in place — the same reactive model the web/DOM backend uses
// (I8, one reactive core).
//
// Run it inside `nix develop` (which provides gtk4):
//     jet run examples/features/ui/ui_native_linux.jet
// and a window opens with a live counter. Selection is the shipped `comptime if
// build.os` dispatch (D-OSTARGET2=B): only the `.Linux` arm compiles into a
// native Linux build, so the gtk path never reaches a non-Linux target. The
// native link (`-lgtk-4 …`) is named by `use c.gtk4` via `pkg-config gtk4`
// (S59); every gtk C call lives in the vetted `jet_gtk` prelude — this file
// writes no low-level tier code. `JET_UI_HEADLESS=1` skips the window (what the
// golden test sets, so it terminates); `tests/cross.rs` proves the window/
// widget/click/style code compiles and links against gtk4.
use core.ui as ui
use core.reactive as reactive
use c.gtk4 as gtk4

fn run() {
    comptime if build.os == {
        .Linux -> {
            clicks :: reactive.signal(0)
            app :: ui.gtk_backend()
            render_app :: ~app
            ui.reactive_render(() => {
                tree :: ui.box([ui.text("Jet — native GTK4 counter"), ui.node_color("count: {clicks.get()}", 220.0, 40.0, "#3366ff"), ui.button("Increment")])
                size :: render_app.measure(tree, ui.constraint(0.0, 0.0, 320.0, 240.0))
                render_app.layout(tree, ui.rect(0.0, 0.0, size.width, size.height))
                render_app.paint(tree)
            })
            // The retained event hook resolves the already-reconciled canonical
            // Button widget by identity; it does not create a parallel tree.
            increment :: app.button("Increment")
            app.on_click(increment, () => clicks.set(clicks.get() + 1))
            print("native backend: gtk4")
            app.present("Jet — GTK4")
        }
        .MacOS -> { print("native backend: not yet on macOS") }
        .Windows -> { print("native backend: not yet on Windows") }
    }
}
