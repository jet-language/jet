// Constraint layout — Cassowary-style solver (Tower c28/ca3ynsl,
// D-LAYOUT1=A / D-LAYOUT-GATES1=A). `layout NAME { … }` opens a block whose
// lines are `>=`/`<=`/`==` comparisons of layout values (GATE 1 blesses
// those operators to return a `Constraint` instead of `Bool`, closed to this
// type family only — same category as D-SIMD2). `box.anchor` reads
// (`left`/`right`/`width`/`top`/`bottom`/`height`) auto-vivify a box scoped
// to the block; `left`/`right`/`width` are horizontal (`HVar`), `top`/
// `bottom`/`height` are vertical (`VVar`) — mixing axes is a compile error
// (E2932), caught before it could ever produce a nonsensical layout.
//
// A two-column form: the label column has a minimum width, the input column
// fills the rest of the row, and a fixed gap separates them. All three
// constraints are REQUIRED (the default); the layout is solved once, then
// read back with `.value()`.
fn run() {
    layout form {
        label.width >= 80.0
        label.right + 16.0 == input.left
        label.width + 16.0 + input.width == form.width
    }
    // `form`'s own width is itself just a box anchor (`form.width`) — set it
    // via a soft suggestion (an edit variable): required constraints always
    // win over a suggestion, but with nothing else pinning label.width, the
    // solver settles at its tightest required bound (80.0) and gives the
    // rest of the row to input.width.
    form.suggest(form.h("form", "width"), 300.0)
    label_w :: form.value(form.h("label", "width"))
    input_w :: form.value(form.h("input", "width"))
    print("label width: {label_w}")
    print("input width: {input_w}")
    print("feasible: {(form.is_feasible())}")
}
