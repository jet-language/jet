// 11 — Enums and exhaustive when (M3, S30/S31).
enum Light {
    Red;
    Yellow;
    Green;
}
fn next(light: Light) -> Light {
    when light {
        | Red {
            return Light.Yellow;
        }
        | Yellow {
            return Light.Green;
        }
        | Green {
            return Light.Red;
        }

    }
}
fn label(light: Light) -> String {
    when light {
        | Red {
            return "stop";
        }
        | Yellow {
            return "caution";
        }
        | Green {
            return "go";
        }

    }
}
fn main() {
    val start = Light.Red;
    print(label(start));
    print(label(next(start)));
}
