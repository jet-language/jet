// D-DETACH1 (ratified; D-DETACH1 = A): fire-and-forget task with `.detach()`.
// `.detach()` consumes the Task handle; the task keeps running in the background.
use core.tasks

fn main() {
    // Spawn a background task and immediately detach it — no join needed.
    tasks.spawn(() => 42).detach()

    // The program may exit before the detached task finishes.
    print("launched")
}
