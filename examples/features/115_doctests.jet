// 115 — doctests (D-TEST4, ratified option A).
//
// A runnable example inside a `///` doc comment is a test: `jet test` discovers
// the fenced ```jet block, runs it, and checks every `// =>` trailing comment
// against the value the line produces. A mismatch fires E2901 — docs cannot lie.
//
/// Doubles a number.
///
/// ```jet
/// n := 21
/// n * 2 // => 42
/// "jet" // => jet
/// ```
fn double(n: Int) -> Int {
    return (n * 2)
}

fn main() {
    print("{double(21)}")
}
