// D-CAP7: mix of ~ (write) and ^ (take/move) in one function.
// equip: edit the player in place, consume the item.
struct Player { hp: Int, name: String }
struct Item { bonus: Int, label: String }

// ~Player = edit in place; ^Item = consume/take ownership
fn equip(p: ~Player, item: ^Item) {
    p.hp = p.hp + item.bonus
    print("equipped {item.label}, hp now {p.hp}")
}

fn main() {
    hero := Player.{ hp: 50, name: "Rex" }
    sword := Item.{ bonus: 20, label: "iron sword" }
    equip(~hero, ^sword)   // ~ mirrors write; ^ mirrors take
    // sword is consumed; hero.hp is updated
    print(hero.name)
    print(hero.hp)
}
