// D-CONFIG-ENV1: typed runtime config overlays .env with environment values.
use core.files as fs
use core.sys as sys
use core.crypto as crypto

struct Database {
    port: Int
}

struct AppConfig {
    host: String
    database: Database
    secret: crypto.Secret
}

fn run() ? {
    dotenv :: "typed_config.env"
    sys.set("APP_DATABASE__PORT", "8443")
    sys.set("APP_SECRET", "process-secret")
    fs.write(dotenv, "APP_HOST=from-dotenv\nAPP_DATABASE__PORT=5432\nAPP_SECRET=dotenv-secret\n") ?? return Err("write")

    loaded :: sys.decode<AppConfig>("APP_", dotenv, [])
    if loaded == {
        .Ok(config) -> {
            print("host={config.host}")
            print("port={config.database.port}")
        }
        .Err(errors) -> print("unexpected: {errors}")
    }
    fs.remove(dotenv) ?? return Err("cleanup")

    sys.set("APP_DATABASE__PORT", "not-an-int")
    bad :: sys.decode<AppConfig>("APP_", "", [])
    if bad == {
        .Ok(_) -> print("unexpected ok")
        .Err(errors) -> print(errors)
    }
}
