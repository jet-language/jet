// D-COMPUTE-CAPABILITIES1: auto device selection, strict profiling, and sparse display.
use core.compute as compute

fn run() {
    auto :: compute.device_auto()
    _ :: compute.profile_f32_strict()
    print("auto:{auto}")

    matrix := compute.matrix(2, 2, 0.0) ?? panic("matrix")
    compute.set(&matrix, [0, 0], 1.0) ?? panic("set")
    compute.set(&matrix, [1, 1], 2.0) ?? panic("set")
    sparse :: compute.to_sparse(matrix) ?? panic("sparse")
    print("sparse:{compute.sparse_show(sparse)}")
}
