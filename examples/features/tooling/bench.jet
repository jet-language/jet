// D-CLAIM-BENCH1=A: `.measure` marks a `#Test` claim for
// `jet test --measure`; plain `jet test` still checks the claim once.
// `jet run` ignores test claims and just runs `main`.
fn fib(n: Int) Int {
    a := 0
    b := 1
    loop i, 0..<n {
        next := a + b
        a = b
        b = next
    }
    return a
}

fn run() { print("fib(10) = {fib(10)}") }

#Test("fib(10)") {
    .measure {
        assert_eq(fib(10), 55)
    }
}

#Test("sum to 100") {
    .measure {
        total := 0
        loop i, 0..<100 :> total += i
        assert_eq(total, 4950)
    }
}
