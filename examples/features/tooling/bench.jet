// D-BENCH1: `#Bench("name") { … }` — a region benchmark, the sibling of
// `#Test`. `jet bench` times each block and reports ns/iter + ops/sec.
// `jet run` ignores the bench blocks and just runs `main`.
fn fib(n: Int) => Int = if n < 2 -> n else -> fib(n - 1) + fib(n - 2)

fn run() {
    print("fib(10) = {fib(10)}")
}

#Bench("fib(10)") {
    require_eq(fib(10), 55)
}

#Bench("sum to 100") {
    total := 0
    loop i, 0..<100 { total += i }
    require_eq(total, 4950)
}
