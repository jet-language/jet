// D-CLAIM-BENCH1=A: `.measure` marks a `#Test` claim for
// `jet test --measure`; plain `jet test` still checks the claim once.
// `jet run` ignores test claims and just runs `main`.
fn fib(n: Int) Int {
    a := 0
    b := 1
    loop i in 0..<n {
        next := a + b
        a = b
        b = next
    }
    return a
}

fn work(i: Int) Int { return (i * 17 + 3) % 101 }

// The baseline drops every loop value. An optimizing build may erase its work.
fn elided_baseline(n: Int) Int {
    loop i in 0..<n -> work(i)
    return 0
}

// Feed each value to keep() inside the measured loop before using it.
fn kept_loop(n: Int) Int {
    total := 0
    loop i in 0..<n -> total += keep(work(i))
    return total
}

fn run() {
    print("fib(10) = {fib(10)}")
    print("keep loop sum(10) = {kept_loop(10)}")
}

#Test("fib(10)") {
    .measure {
        assert_eq(fib(10), 55)
    }
}

#Test("sum to 100") {
    .measure {
        total := 0
        loop i in 0..<100 -> total += i
        assert_eq(total, 4950)
    }
}

#Test("elided baseline") {
    .measure {
        assert_eq(elided_baseline(10000), 0)
    }
}

#Test("keep loop") {
    .measure {
        assert_eq(kept_loop(10000), 499953)
    }
}
