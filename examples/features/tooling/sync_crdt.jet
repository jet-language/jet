// D-SYNC1=A / D-DBPOLICY1=A: CRDT values + typed row policy.
use core.sync as sync
use app

fn run() {
    // Two replicas edit the same document while apart, then merge.  A text
    // CRDT keeps both edits and reaches one document, in either merge order.
    base :: sync.text_new("r1", "hello world")
    a :: sync.text_edit(base, "r1", 5, 0, ",")
    b :: sync.text_edit(base, "r2", 11, 0, "!")
    merged :: sync.text_merge(a, b)
    print(sync.text_show(merged))
    print(sync.text_show(sync.text_merge(b, a)))
    // Merging twice changes nothing, and a replica that already saw the
    // result still agrees with it.
    print(sync.text_show(sync.text_merge(merged, a)))
    print(sync.text_metadata(merged))

    c0 :: sync.counter_new("r1", 2)
    c2 :: sync.counter_new("r2", 3)
    c1 :: sync.counter_inc(c0, "r1", 1)
    print("counter:{sync.counter_value(sync.counter_merge(c1, c2))}")

    m0 :: sync.map_new()
    m :: sync.map_set(m0, "k", "v1")
    m2 :: sync.map_set(sync.map_new(), "k", "v2")
    print(sync.map_show(sync.map_merge(m, m2)))

    l0 :: sync.list_new()
    l1 :: sync.list_push(l0, "r1", "a")
    l :: sync.list_push(l1, "r2", "b")
    print(sync.list_show(l))

    policy :: sync.policy_new("tickets", "owner == user") ?? panic("policy")
    print(sync.policy_show(policy))
    print("allow:{sync.policy_allows(policy, "alice", "alice")}")
    print("deny:{sync.policy_allows(policy, "alice", "bob")}")

    print(app.sync(sync.text_show(merged), over: "sess-1"))
}
