// D-DBG3 step 2 (dap-debugger) — a native-only program `jet debug` steps
// through the LLDB-BACKED backend, not the step-1 interpreter.
//
// Run it normally:              jet run examples/features/tooling/debug_native.jet
// Step through it (native):     jet debug examples/features/tooling/debug_native.jet
//
// `use core.fs` is a native-only Core module the interpreter declines
// (E2203) — `jet debug` auto-detects this and launches the SAME `(jet)`
// prompt (step/next/finish/continue/break/print/locals/backtrace/quit) over a
// real compiled binary via lldb instead, transparently. `--raw-frames`
// (D-DBG2) is the expert opt-in that shows the raw Rust file:line instead of
// the Jet source; `--dap` speaks the Debug Adapter Protocol for editor wiring.

use core.fs as fs

fn word_count(text: String) -> Int {
    total := 0
    loop word in text.split(" ") {
        total += 1
    }
    return total
}

fn main() {
    path := "/tmp/jet_189_debug_native_notes.txt"
    fs.write(path, "jet debug steps the full feature set") ?? return
    text := fs.read(path) ?? ""
    n := word_count(text)
    print("that note has {n} words")
    fs.remove(path) ?? return
}
