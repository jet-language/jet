// Typed Core data slice (D-WD9, D-DATA-SURFACE1, D-DATAFLOW1=A).
use core.data as data

#Codable
struct Ticket {
    team: String
    minutes: Float
}

fn run() {
    raw :: "team,minutes\nCore,4.0\nTools,5.0\nCore,8.0\nTools,7.0"
    rows :: data.csv<Ticket>(raw) ?? panic("bad csv")
    print("rows: {rows.len()}")
    means :: data.query(rows)
        .group_by(t -> t.team)
        .mean(t -> t.minutes)
        .collect() ?? panic("mean groups")
    sums :: data.query(rows)
        .group_by(t -> t.team)
        .sum(t -> t.minutes)
        .collect() ?? panic("sum groups")
    counts :: data.query(rows)
        .group_by(t -> t.team)
        .count()
        .collect() ?? panic("count groups")
    loop g in counts -> print("{g.key}: count={g.value}")
    loop g in sums -> print("{g.key}: sum={g.value}")
    loop g in means -> print("{g.key}: mean={g.value}")
    values :: [Float]{2.0, 4.0, 6.0}
    mean :: data.mean(values) ?? panic("mean")
    print("series mean: {mean}")
    print(data.bar_text(counts) ?? panic("bar"))
    svg :: data.bar_svg(counts) ?? panic("svg")
    print("svg bytes: {svg.len()}")
    status :: data.status()
    print("status: {status[0].step} {status[0].path}")
}
