// D-BRANCH-CODEGEN1: representative classifier workloads use the existing
// benchmark mechanism. Run with `jet bench`.
enum Mode {
    Read
    Write
    Admin
}

fn dense(n: Int) => Int {
    return if n == {
        0 -> 10
        1 -> 11
        2 -> 12
        else -> 0
    }
}

fn sparse(n: Int) => Int {
    return if n == {
        1 -> 10
        1000 -> 20
        100000 -> 30
        else -> 0
    }
}

fn enum_dispatch(mode: Mode) => Int {
    return if mode == {
        .Read -> 1
        .Write -> 2
        .Admin -> 3
    }
}

fn ordered(n: Int) => Int {
    return if n == {
        0..9 -> 1
        10..99 -> 2
        else -> 3
    }
}

fn biased(n: Int) => Int {
    return if n == {
        0 -> 1
        1..100 -> 2
        else -> 3
    }
}

#Bench("branch dense") {
    require_eq(dense(2), 12)
}

#Bench("branch sparse") {
    require_eq(sparse(1000), 20)
}

#Bench("branch enum") {
    require_eq(enum_dispatch(Mode.Write), 2)
}

#Bench("branch ordered") {
    require_eq(ordered(40), 2)
}

#Bench("branch biased") {
    require_eq(biased(0), 1)
}

fn run() {
    require_eq(dense(2), 12)
    require_eq(sparse(1000), 20)
    require_eq(enum_dispatch(Mode.Write), 2)
    require_eq(ordered(40), 2)
    require_eq(biased(0), 1)
    print("branch dispatch benchmarks")
}
