// D-TEST-COMPARE1=A: equal finite samples are an honest matched result,
// not a universal proof.
use core.testing as testing

fn reference(value: DataTree) DataTree -> ~value
fn candidate(value: DataTree) DataTree -> ~value

fn run() {
    cases :: [DataTree]{DataTree.Int(1), DataTree.Int(2)}
    comparison :: testing.compare(cases, reference, candidate, "typed_equality")
    print(testing.status(comparison))
    print(testing.assert_equal(comparison))
}
