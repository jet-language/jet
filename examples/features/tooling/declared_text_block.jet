// D-META-DSL1=A: the library rule owns checking; Jet owns the braces.
marker Checked(@sites: [.Block]) {
    assert(target.contains("inside checked text"), "checked text does not contain the required phrase")
    fn checked_value() -> String { "checked block" }
}

fn run() {
    #Checked {
        print("inside checked text")
    }
    print("outside block")
    print(checked_value())
}
