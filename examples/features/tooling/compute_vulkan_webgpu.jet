// #1146: explicit portable accelerator seams never fall back to CPU.
use core.compute as compute

fn run() {
    seed :: compute.full([1, 1], 2.0) ?? panic("seed")
    f32_value :: compute.matmul_f32_tile(seed, seed) ?? panic("f32")

    if compute.on_device(f32_value, compute.device_vulkan()) == {
        .Ok(_) -> { print("vulkan:accepted") }
        .Err(_) -> { print("vulkan:rejected") }
    }

    if compute.on_device(f32_value, compute.device_webgpu()) == {
        .Ok(_) -> { print("webgpu:accepted") }
        .Err(_) -> { print("webgpu:rejected") }
    }
}
