// D-BUILDPROFILE1: named build profiles — an example package that declares
// custom profiles in its `build {}` block. Build this with:
//   jet build --release examples/features/tooling/build_profiles/main.jet
//   jet build --profile=fast examples/features/tooling/build_profiles/main.jet
//   jet build --profile=ci examples/features/tooling/build_profiles/main.jet
// The active profile changes the rustc optimization flags but not program output.
fn main() {
    print("build profiles: ok")
}
