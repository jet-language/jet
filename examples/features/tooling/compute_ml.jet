// D-COMPUTE-ML1 / #1142: inference, autodiff training, and model serialization.
use core.compute as compute

fn predict(weight: Tensor, input: Tensor) => Tensor {
    return compute.matmul(input, weight) ?? panic("predict")
}

fn training_loss(weight: Tensor, input: Tensor, target: Tensor) => Tensor {
    prediction :: predict(weight, input)
    return compute.mse_loss(prediction, target) ?? panic("loss")
}

fn run() {
    weight :: compute.matrix(2, 2, 0.0) ?? panic("weight")
    input :: compute.eye(2) ?? panic("input")
    target :: compute.ones([2, 2]) ?? panic("target")

    before :: predict(weight, input)
    print("before:{compute.to_list(before)}")
    before_loss :: compute.mse_loss(before, target) ?? panic("before_loss")
    print("loss:{compute.to_list(before_loss)}")

    gradients :: compute.gradient(training_loss, ~weight, ~input, ~target, wrt: [weight])
    next :: compute.sgd_step(weight, gradients.weight, 0.5) ?? panic("sgd")
    after :: predict(next, input)
    print("after:{compute.to_list(after)}")
    after_loss :: compute.mse_loss(after, target) ?? panic("after_loss")
    print("trained_loss:{compute.to_list(after_loss)}")

    wire :: compute.serialize(next) ?? panic("serialize")
    print("wire:{wire}")
    round :: compute.deserialize(wire) ?? panic("deserialize")
    print("round:{compute.to_list(round)}")

    f32_one :: compute.matrix(1, 1, 1.0) ?? panic("f32_one")
    f32_model :: compute.matmul_f32_tile(f32_one, f32_one) ?? panic("f32_model")
    f32_input_seed :: compute.matrix(1, 1, 2.0) ?? panic("f32_input_seed")
    f32_input :: compute.matmul_f32_tile(f32_input_seed, f32_one) ?? panic("f32_input")
    f32_target_seed :: compute.matrix(1, 1, 4.0) ?? panic("f32_target_seed")
    f32_target :: compute.matmul_f32_tile(f32_target_seed, f32_one) ?? panic("f32_target")

    f32_before :: predict(f32_model, f32_input)
    print("f32_before:{compute.to_list(f32_before)}")
    f32_loss :: training_loss(f32_model, f32_input, f32_target)
    print("f32_loss:{compute.to_list(f32_loss)}")
    f32_gradients :: compute.gradient(training_loss, ~f32_model, ~f32_input, ~f32_target, wrt: [f32_model])
    f32_next :: compute.sgd_step(f32_model, f32_gradients.f32_model, 0.125) ?? panic("f32_sgd")
    f32_after :: predict(f32_next, f32_input)
    print("f32_after:{compute.to_list(f32_after)}")
    f32_after_loss :: training_loss(f32_next, f32_input, f32_target)
    print("f32_trained_loss:{compute.to_list(f32_after_loss)}")
    f32_wire :: compute.serialize(f32_next) ?? panic("f32_serialize")
    f32_round :: compute.deserialize(f32_wire) ?? panic("f32_deserialize")
    print("f32_round:{compute.to_list(f32_round)}")
    print("f32_placement:{compute.placement(f32_round)}")
}
