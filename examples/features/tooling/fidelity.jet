// D-ADAPTFID1=A: Perf.fidelity() — adaptive quality/perf knob.
use core.perf as Perf

fn main() {
    // Default: full quality (1.0).
    f :: Perf.fidelity()
    print(f)
    // App degrades at half quality.
    Perf.set_fidelity(0.5)
    f2 :: Perf.fidelity()
    print(f2)
    // Low quality path.
    Perf.set_fidelity(0.1)
    if Perf.fidelity() < 0.5 {
        print("low quality mode")
    }
    // Restore full quality.
    Perf.set_fidelity(1.0)
    print(Perf.fidelity())
}
