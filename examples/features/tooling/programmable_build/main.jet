fn build(b: BuildContext) BuildPlan ? {
    b.generate("build_message") {
        fn generated_build_message() String :> "generated source checked"

    }?
    app :: b.add_executable("programmable_build", ["main.jet", ".jet/generated/main/build_message.jet"], [])?
    return b.plan(app)
}

fn run() { print("generated source checked") }
