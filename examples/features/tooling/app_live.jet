// D-LIVEQUERY1=A (#505): app.live footprint tracking + #Transact-driven invalidate → Signal.
use app

fn run() {
    q :: app.live("users", "[alice,bob]")
    print(app.live_show(q))
    print("value:{app.live_get(q)}")
    hit :: app.invalidate("users")
    print("hit:{hit}")
    print("value:{app.live_get(q)}")
    print(app.live_stats())
    expert :: app.subscribe("metrics")
    print(app.live_show(expert))
    // Commit hook runs after `#Transact` succeeds — write-set invalidation into live registry.
    #Transact(tx) {
        tx.on_commit(() => {
            app.transact_invalidate("users,orders")
            print("commit:invalidate")
        })
        print("in-txn")
    }
    print("value:{app.live_get(q)}")
    print(app.live_stats())
    q2 :: app.signal_push(q, "signal:users")
    print("value:{app.live_get(q2)}")
}
