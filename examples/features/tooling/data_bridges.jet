package {
    name: "tooling_data_bridges"
    version: "0.1.0"
    authority: { holds: { allow: [IO, Mem.Alloc] } }
}

// D-DATA-BRIDGE1 / D-DATA-STATUS1: honest Python/R/GPU bridge facts (#708).
use core.data as data

fn show_bridge(step: String) {
    status :: data.status()
    loop row in status {
        if row.step == step {
            print("{row.step} path={row.path} copy={row.copy} ownership={row.ownership} trust={row.trust} fallback={row.fallback} replacement={row.replacement}")
        }
    }
}

fn probe_bridge(name: String) {
    if data.require_bridge(name) == {
        .Ok(_) -> { print("{name}: available") }
        .Err(error) -> { print("{name}: {error}") }
    }
}

fn run() {
    show_bridge("py.*")
    show_bridge("r.*")
    show_bridge("gpu.*")
    probe_bridge("py")
    probe_bridge("r")
    probe_bridge("gpu")
    if data.require_bridge("nope") == {
        .Ok(_) -> { print("nope: unexpectedly ok") }
        .Err(error) -> { print("nope: {error}") }
    }
}
