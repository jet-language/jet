use core.testing as testing

module perf.testing {
    budgets: [Budget.{
        name: "parse",
        scope: .Bench("parse"),
        metric: .BenchTime(.P50),
        provider: .BenchMeasurement("parse"),
        comparison: .AbsoluteFrom("local/testing-helpers"),
        limit: .AtMost(5ms),
        enforcement: .Warn,
    }]
}

fn run() {
    temp :: testing.temp_dir("demo")
    print(temp.len() > 0)
    print(testing.snap("demo-output", "hello"))
    clock :: testing.fake_clock(42)
    rng := testing.fake_rng(7)
    print(clock.now())
    print(rng.int(1, 3) >= 1)
}

@Bench("parse") {}
