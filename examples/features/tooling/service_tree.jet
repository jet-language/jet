// D-SERVICE1=D (#444): service tree, mailboxes, OneForOne restart under a typed
// restart budget carried by the group, escalating to the parent when spent.
use core.services as services

fn run() {
    // `:=` — worker/group/send/receive/fail mutate the tree place (Write).
    tree := services.tree("demo")
    worker :: services.worker(&tree, "echo", 2) ?? panic("worker")
    services.group(&tree, "front", ["echo"]) ?? panic("group")
    services.start(&tree) ?? panic("start")
    print(services.tree_show(tree))
    print(services.endpoint_show(worker))

    services.send(&tree, worker, "hello") ?? panic("send")
    print("depth:{services.mailbox_depth(tree, worker) ?? panic("depth")}")
    msg :: services.receive(&tree, worker) ?? panic("receive")
    print("msg:{msg}")

    // Bounded backpressure. The mailbox holds two; the third send is refused
    // with a typed Full instead of growing the queue (D-SERVICE-DELIVERY1=D).
    services.send(&tree, worker, "one").drop("a refused fill shows up as the next depth")
    services.send(&tree, worker, "two").drop("a refused fill shows up as the next depth")
    print("depth:{services.mailbox_depth(tree, worker) ?? -1}")
    third :: services.send(&tree, worker, "three")
    if third == {
        .Ok(_) -> { print("full:accepted") }
        .Err(_) -> { print("full:refused") }
    }

    // Drain. The worker takes no new work and hands back what it already holds,
    // in order, until the mailbox is empty.
    services.drain_worker(&tree, worker).drop("already draining is not an error")
    print("drained:{services.receive(&tree, worker) ?? "none"}")
    print("drained:{services.receive(&tree, worker) ?? "none"}")
    print("depth:{services.mailbox_depth(tree, worker) ?? -1}")

    // Supervision. A supervisor is a task that owns a group; OneForOne restarts
    // the failed worker inside that group.
    services.fail_worker(&tree, worker) ?? panic("fail")
    print("restarts:{services.restarts(tree, worker) ?? panic("restarts")}")

    // The restart budget is data on the group: five restarts per minute. Spend
    // the rest of it, then the sixth failure escalates to the parent group
    // instead of restarting forever, and the tree stops.
    services.fail_worker(&tree, worker).drop("the restart count below is the check")
    services.fail_worker(&tree, worker).drop("the restart count below is the check")
    services.fail_worker(&tree, worker).drop("the restart count below is the check")
    services.fail_worker(&tree, worker).drop("the restart count below is the check")
    print("restarts:{services.restarts(tree, worker) ?? -1}")
    spent :: services.fail_worker(&tree, worker)
    if spent == {
        .Ok(_) -> { print("escalate:none") }
        .Err(_) -> { print("escalate:parent") }
    }
    print("restarts:{services.restarts(tree, worker) ?? -1}")
    print(services.observe(tree))
    services.stop(&tree) ?? panic("stop")
}
