enum TextError { Empty }

Token :: distinct String

impl Token.CheckedText {
    type Error = TextError

    fn check(text: String) () ! -[]> {
        if text == "" { return Err(TextError.Empty) }
        return Ok(())
    }

    fn encode_hole<T: Printable>(value: T) String -[]> {
        return "[{value}]"
    }
}

fn show(value: Token) {
    #Unsafe("checked text example output") {
        print(value.raw())
    }
}

fn run() {
    literal :: Token{"accepted {7}"}
    show(literal)

    dynamic :: Token.from("accepted")
    dynamic ? value -> show(value) ! error -> print("rejected")
}
