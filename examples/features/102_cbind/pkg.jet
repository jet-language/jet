payload: {
    name: "cbind_demo",
    version: "0.1.0",
    description: "Binding a C header end to end (S59 / E2-M14)",
    license: "MIT OR Apache-2.0",
}

# The link key for `use c.c` — the C standard library, which the Rust backend
# already links, so this just names it for the link line (`-l c`). A real
# third-party library would point at a hangar ref or a local `path = "…"`.
[dependencies:c]
c = "system"
