// Display-column and grapheme-safe textwrap contract audit.
use core.text.wrap as wrap

fn run() {
    print("wide")
    loop line in wrap.wrap("界界", 3) -> print(line)

    print("cjk")
    print(wrap.shorten("你好世界", 5, "…"))

    print("combining")
    print(wrap.shorten("éclair", 4, "…"))

    print("words")
    print(wrap.shorten("Hello world", 8, "..."))

    indents :: wrap.Wrapper{
        width: 8,
        initial_indent: "> ",
        subsequent_indent: "---",
        expand_tabs: false,
        drop_whitespace: true,
        break_long_words: true,
        break_on_hyphens: false,
        max_lines: 0,
        placeholder: "...",
        tabsize: 8,
    }
    print("indents")
    loop line in wrap.wrap_with("abcdefgh", indents) -> print(line)

    family_break :: wrap.Wrapper{
        width: 1,
        initial_indent: "",
        subsequent_indent: "",
        expand_tabs: false,
        drop_whitespace: true,
        break_long_words: true,
        break_on_hyphens: false,
        max_lines: 0,
        placeholder: "...",
        tabsize: 8,
    }
    print("family-break")
    loop line in wrap.wrap_with("👨‍👩‍👦", family_break) -> print(line)

    family_tab := wrap.expand_tabs("👨‍👩‍👦\tX", 8)
    print("family-tab")
    print("[{family_tab}]")

    max_lines :: wrap.Wrapper{
        width: 20,
        initial_indent: "",
        subsequent_indent: "",
        expand_tabs: false,
        drop_whitespace: true,
        break_long_words: true,
        break_on_hyphens: true,
        max_lines: 1,
        placeholder: "...",
        tabsize: 8,
    }
    print("max-lines")
    loop line in wrap.wrap_with("one two three four five", max_lines) -> print(line)

    hyphen_true :: wrap.Wrapper{
        width: 7,
        initial_indent: "",
        subsequent_indent: "",
        expand_tabs: false,
        drop_whitespace: true,
        break_long_words: true,
        break_on_hyphens: true,
        max_lines: 0,
        placeholder: "...",
        tabsize: 8,
    }
    hyphen_false :: wrap.Wrapper{
        width: 7,
        initial_indent: "",
        subsequent_indent: "",
        expand_tabs: false,
        drop_whitespace: true,
        break_long_words: true,
        break_on_hyphens: false,
        max_lines: 0,
        placeholder: "...",
        tabsize: 8,
    }
    print("hyphen-true")
    loop line in wrap.wrap_with("alpha-beta", hyphen_true) -> print(line)
    print("hyphen-false")
    loop line in wrap.wrap_with("alpha-beta", hyphen_false) -> print(line)

    preserve_whitespace :: wrap.Wrapper{
        width: 20,
        initial_indent: "",
        subsequent_indent: "",
        expand_tabs: false,
        drop_whitespace: false,
        break_long_words: true,
        break_on_hyphens: true,
        max_lines: 0,
        placeholder: "...",
        tabsize: 8,
    }
    print("preserved-whitespace")
    loop line in wrap.wrap_with("  a  b  ", preserve_whitespace) -> print("[{line}]")

    print("empty-placeholder")
    print(wrap.shorten("abcdef", 3, ""))
    print("zero-width")
    print(wrap.wrap("x", 0)[0])
    negative_short := wrap.shorten("abcdef", -1, "...")
    print("negative-short={negative_short}")
}
