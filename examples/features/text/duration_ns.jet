use core.time as time

fn run() ? {
    ns :: Duration.nanoseconds(400) ?? return Err("ns")
    us :: Duration.microseconds(400) ?? return Err("us")
    ns_read :: ns.in(.Nanoseconds) ?? return Err("read")
    print(ns_read)
    us_read :: us.in(.Microseconds) ?? return Err("read")
    print(us_read)
    us_ns :: us.in(.Nanoseconds) ?? return Err("read")
    print(us_ns)
    print(ns.is_zero())
    zero :: Duration.milliseconds(0) ?? return Err("zero")
    print(zero.is_zero())
    sec :: Duration.seconds(2) ?? return Err("sec")
    print(sec.total_seconds())
    a :: Duration.milliseconds(1500) ?? return Err("a")
    b :: Duration.milliseconds(500) ?? return Err("b")
    diff :: a.difference(b).in(.Milliseconds) ?? return Err("diff")
    print(diff)
    literal_ns :: (250ns).in(.Nanoseconds) ?? return Err("literal read")
    print(literal_ns)
    literal_us :: (3us).in(.Microseconds) ?? return Err("literal read")
    print(literal_us)
    inst :: time.instant()
    later :: inst + 5min
    print(later >= inst)
    delta :: (later - inst).in(.Minutes) ?? return Err("point delta")
    print(delta)
    elapsed :: inst.elapsed()
    print(elapsed.total_seconds() >= 0)
}
