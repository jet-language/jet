use core.time as time

fn run() {
    ns :: 400ns
    us :: 400us
    ns_read :: ns.in(.Nanoseconds)
    print(ns_read)
    us_read :: us.in(.Microseconds)
    print(us_read)
    us_ns :: us.in(.Nanoseconds)
    print(us_ns)
    print(ns.is_zero())
    zero :: 0ms
    print(zero.is_zero())
    sec :: 2s
    print(sec.total_seconds())
    a :: 1500ms
    b :: 500ms
    diff :: a.difference(b).in(.Milliseconds)
    print(diff)
    literal_ns :: (250ns).in(.Nanoseconds)
    print(literal_ns)
    literal_us :: (3us).in(.Microseconds)
    print(literal_us)
    inst :: time.instant()
    later :: inst + 5min
    print(later >= inst)
    delta :: (later - inst).in(.Minutes)
    print(delta)
    elapsed :: inst.elapsed()
    print(elapsed.total_seconds() >= 0)
}
