use core.time as time
use core.time as date

fn run() ? {
    dt :: time.parse_rfc3339("2024-03-10T06:30:00Z") ?? return Err("bad rfc3339")
    print(dt.format_rfc3339())
    print(dt.to_unix_ms())
    print(time.from_unix_ms(dt.to_unix_ms()).format("yyyy-MM-dd HH:mm:ss"))
    d :: date.new(2024, 3, 31)
    print(d.add_period(time.period_months(1)).to_string())
    print(d.iso_weekday())
    print(d.iso_week())
    print(d.format("EEE yyyy-DDD"))
    utc :: time.utc()
    z :: time.zoned(dt, utc)
    print(z.format("yyyy-MM-dd HH:mm:ss VV XXX"))
    print(z.offset_seconds())
    span :: Duration.hours(2) ?? return Err("duration")
    span_s :: span.in(.Seconds) ?? return Err("duration read")
    print(span_s)
    inst :: time.instant()
    print(inst.elapsed_millis() >= 0)

    // Zoned arithmetic keeps the whole ZonedDateTime: `add_duration` moves the
    // instant and holds the zone, `add_period` moves the local wall clock.
    day :: Duration.hours(24) ?? return Err("duration")
    absolute :: z.add_duration(day)
    print(absolute.format("yyyy-MM-dd HH:mm:ss VV XXX"))
    print(absolute.offset_seconds())
    print(absolute.is_dst())
    civil :: z.add_period(time.period_days(1))
    print(civil.to_string())
    print(civil.date().to_string())
    print(civil.time().to_string())
    print(civil.zone().name())
    print(civil.to_datetime().format_rfc3339())
}
