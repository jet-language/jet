// core.text.unicode — std-only Unicode scalar helpers.
// Grapheme clusters are intentionally not exposed here; this API speaks in
// bytes and Unicode scalar values so the unit is explicit.
use core.text.unicode as unicode

fn main() {
    word :: "café"
    print(unicode.scalar_count(word))
    print(unicode.byte_count(word))
    print(unicode.is_ascii(word))
    print(unicode.lower("MIXED İ"))
    print(unicode.upper("straße"))
    parts :: unicode.scalars("aé")
    print(parts.len())
    print(parts[1])
}
