use core.time.date as date

fn run() {
    d :: date.new(2024, 3, 15)
    print(d.year())
    print(d.month())
    print(d.day())
    print(d.to_string())
    next :: d.add_days(10)
    print(next.to_string())
    march_end :: date.new(2024, 3, 31)
    april :: march_end.add_months(1)
    print(april.to_string())
    diff :: next.diff_days(d)
    print(diff)
    print(d.weekday())
    print(d.day_of_year())
    today :: date.today()
    print(today.year() > 2023)
}
