// D-SHAPE-DURATION1=A / D-TYPE2-TIME1=A: fixed values use exact duration
// literals. Runtime values still use the TYPE-owned unit constructor, whose
// checked result is exercised by the range probe below.
fn run() {
    exact :: 2s
    fine :: 400us
    nano :: 250ns
    exact_ms :: exact.in(.Milliseconds)
    print(exact_ms)
    fine_ns :: fine.in(.Nanoseconds)
    print(fine_ns)
    nano_ns :: nano.in(.Nanoseconds)
    print(nano_ns)
    print(exact.total_seconds())
    print(exact.is_zero())
    zero :: 0ms
    print(zero.is_zero())
    from_nanos :: 1_000_000ns
    from_nanos_ms :: from_nanos.in(.Milliseconds)
    print(from_nanos_ms)
    if Duration.hours(9223372036854775807) == .Err(_) -> print("range")
    via_literal :: 1ms
    literal_ms :: via_literal.in(.Milliseconds)
    print(literal_ms)
}
