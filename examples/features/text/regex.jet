// D-REGEXENGINE1: core.regex — std-only linear regex (no ReDoS), no hidden
// bridge crate.
use core.regex as re

fn run() {
    text :: "order 42 shipped to zip 90210"
    print(re.is_match(Regex{"\d+"}, text))
    print(re.is_match(Regex{"[a-z]+"}, "hello123"))
    print(re.full_match(Regex{"[a-z]+"}, "hello123"))
    nums :: re.find_all(Regex{"\d+"}, text)
    print(nums[0])
    print(nums.len())
    m :: re.match(Regex{"(\d+) shipped"}, text)
    if m == .Val(mat) {
        print(mat.group(0) ?? "none")
        print(mat.group(1) ?? "none")
    }
    print(re.replace_all(Regex{"\d+"}, text, "#"))
    print(re.split(Regex{"\s+"}, text).len())
    print(Regex{"\d+"}.is_match(text))
    print(Regex{"[a-z]+"}.is_match("hello123"))
    print(Regex{"[a-z]+"}.full_match("hello123"))

    flag_set :: re.flags(true, true, false)
    rx :: re.compile_with("(?<word>[a-z]+)", flag_set) ?? return Err("bad pattern")
    print(rx.matches("Ada lovelace").len())
    first_named :: rx.match("Ada lovelace")
    if first_named == .Val(mat) {
        print(mat.name("word") ?? "none")
        print(mat.start())
        print(mat.end())
        print(mat.named_captures().len())
    }
    word :: re.compile("\\w+") ?? return Err("bad word")
    print(word.replace_all_with("a b", (m: Match) -> "hit"))
    sep :: re.compile(",\\s*") ?? return Err("bad sep")
    print(sep.split_limit("a, b, c", 2)[1])
    print(rx.pattern())
    print(rx.source())
    print(rx.flags())
    print(rx.names().len())
    print(rx.count("Ada lovelace"))
    print(re.escape("a+b?"))
}
