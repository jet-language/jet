// 17 — Strings & Char (M5). #1476 remaining String surface.
fn run() {
    loop c, "héllo".chars() { print(c) }
    print("  hi  ".trim())
    parts :: "a,b,c".split(",")
    print(parts.len())
    // D-STR-AFTER1: first-occurrence substring split.
    print("nate@jet.dev".after("@"))
    print("nate@jet.dev".before("@"))
    // `sep` absent -> the whole original string on both sides.
    print("no-at-sign".after("@"))
    print("no-at-sign".before("@"))
    print("  jet".trim_start())
    print("jet  ".trim_end())
    print("jet".pad_start(5, "."))
    print("jet".pad_end(5, "."))
    print("hello jet".index_of("jet"))
    print("banana".count("an"))
    print("Hello".is_alphabetic())
    print("123".is_numeric())
    print(" \t".is_whitespace())
    print("jet lang".is_ascii())
    print("hELLO jet".to_title())
    pair :: "left:right".split_once(":") ?? panic("split")
    print(pair.before)
    print(pair.after)
    // #1476
    print("banana".last_index_of("an"))
    print("hello".is_lower())
    print("HELLO".is_upper())
    print("hELLO".capitalize())
    print("hELLo".swapcase())
    print("prefix-body".remove_prefix("prefix-"))
    print("body-suffix".remove_suffix("-suffix"))
    print("a".compare("b"))
    print("jet".equal("jet"))
    print("jet".copy())
    print("jet".reverse())
    print("é".normalize() == "é")
    rparts :: "a,b,c".rsplit(",")
    print(rparts.len())
    // D-STR-DECLINE1=C: `matches`/`match` route through the one core.regex
    // engine (`jet.regex.compile` + `is_match`/`find`) — same bad-pattern
    // `? String` error shape `jet.regex.compile` already returns.
    phone :: "call 555-0134"
    has_digits :: phone.matches("[0-9]+") ?? panic("bad pattern")
    print(has_digits)
    no_digits :: "no numbers here".matches("[0-9]+") ?? panic("bad pattern")
    print(no_digits)
    found :: phone.match("[0-9]+") ?? panic("bad pattern")
    print(found ?? "none")
    // A bad pattern takes the `??` fallback (compile fails before any match runs).
    bad_pattern :: "x".matches("[") ?? false
    print(bad_pattern)
}
