// 17 — Strings & Char (M5).
fn run() {
    loop c, "héllo".chars() { print(c) }
    print("  hi  ".trim())
    parts :: "a,b,c".split(",")
    print(parts.len())
    // D-STR-AFTER1: first-occurrence substring split.
    print("nate@jet.dev".after("@"))
    print("nate@jet.dev".before("@"))
    // `sep` absent -> the whole original string on both sides.
    print("no-at-sign".after("@"))
    print("no-at-sign".before("@"))
    print("  jet".trim_start())
    print("jet  ".trim_end())
    print("jet".pad_start(5, "."))
    print("jet".pad_end(5, "."))
    print("hello jet".index_of("jet"))
    print("banana".count("an"))
    print("Hello".is_alphabetic())
    print("123".is_numeric())
    print(" \t".is_whitespace())
    print("jet lang".is_ascii())
    print("hELLO jet".to_title())
    pair :: "left:right".split_once(":") ?? panic("split")
    print(pair.before)
    print(pair.after)
}
