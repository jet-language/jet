fn run() {
    exact :: Duration.seconds(2) ?? panic("duration")
    fractional :: Duration.seconds(1.75) ?? panic("duration")
    negative :: Duration.milliseconds(-1500) ?? panic("duration")
    print(exact.in(.Milliseconds) ?? panic("duration read"))
    print(fractional.in(.Milliseconds) ?? panic("duration read"))
    print(negative.in(.Seconds) ?? panic("duration read"))
    if Duration.hours(9223372036854775807) == .Err(_) {
        print("range")
    }
}
