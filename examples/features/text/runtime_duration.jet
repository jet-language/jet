fn run() {
    exact :: 2s
    fractional_value :: Float{1.75}
    fractional :: Duration.seconds(fractional_value)
    negative :: Duration.milliseconds(-1500)
    exact_ms :: exact.in(.Milliseconds)
    print(exact_ms)
    fractional_ms :: fractional.in(.Milliseconds)
    print(fractional_ms)
    negative_s :: negative.in(.Seconds)
    print(negative_s)
    if Duration.hours(9223372036854775807) == .Err(_) -> print("range")
}
