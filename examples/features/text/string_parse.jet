// 84 — String parsing and line splitting for *small in-memory* text
// (D-STRPARSE1). File-scale work → text/stream_lines.jet (streaming reader).
fn run() {
    // Int.parse(text) — fallible integer parse, returns Int ? ParseError.
    n :: Int.parse("42") ?? -1
    print(n + 1)
    // A bad parse takes the `??` fallback.
    bad :: Int.parse("oops") ?? -1
    print(bad)
    // String.lines() — split text into its lines.
    text :: "first\nsecond\nthird"
    lines :: text.lines()
    print(lines.len())
    loop line, lines { print(line) }
    // Sum the numbers on each line.
    total := 0
    loop row, "10\n20\n30".lines() { total += (Int.parse(row) ?? 0) }
    print(total)
    // D-STR-DECLINE1=C: `to_int`/`to_float` — direct String spellings of the
    // same `Int.parse`/`Float.parse` builtin (the string is the receiver
    // either way), reached one call shorter from cleaned-up text.
    port :: "  8080  ".trim().to_int() ?? -1
    print(port)
    price :: "19.95".to_float() ?? -1.0
    print(price)
    bad_num :: "oops".to_int() ?? -1
    print(bad_num)
}
