// D-EXAMPLES-SHORTPATH1=A: file-scale text opens with a streaming reader.
// For tiny in-memory snippets, see string_parse.jet (String.lines()).
use core.files as fs
use core.files as files
use core.path as path

fn run() {
    src :: path.join("/tmp", "jet_stream_lines.txt")
    _ :: fs.write(src, "alpha\nbeta\ngamma\n")
    handle :: files.open(~src) ?? panic("open")
    n := 0
    loop line, handle.lines() {
        print(line)
        n += 1
    }
    print("lines {n}")
}
