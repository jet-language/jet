// D-FMT-PRETTY1=A / card #1966: one expanded formatter for selector and API.
use core.text.fmt as fmt

struct Team {
    name: String
    members: [String]
}

struct Org {
    title: String
    teams: [Team]
}

fn run() {
    org :: Org{
        title: "acme",
        teams: [
            Team{name: "core", members: ["ada", "brian", "casey"]},
            Team{name: "web", members: ["dana"]}
        ]
    }
    print("{org:Pretty}")
    print(fmt.pretty(org))
}
