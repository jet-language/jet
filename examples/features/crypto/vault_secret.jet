// U13 (D-JPK-SECRETCRYPTO1): core.vault.get reads a secret decrypted from the
// project's encrypted repo file (`.jet/secrets.age`, age-style crypto FFI
// bridge) — `jetpack secrets keygen/recipients/set` manage the store.
// Reading one always requires the `Secret` effect (E1264 otherwise); a build
// -time (comptime) context can never reach it at all (E1265).
use core.vault as vault

fn handler() =[Secret, Io]=> {
    v :: vault.get("db_password")
    if v == .Val(x) {
        print("db_password: {x}")
    } else {
        print("no secret configured")
    }
}

fn run() =[Secret, Io]=> { handler() }
