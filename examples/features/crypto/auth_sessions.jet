// D-AUTH1=A (#506): sessions, password login, OAuth begin/finish, magic links.
use core.auth as auth
use core.text as text
use app

fn run() {
    auth.register_user("alice", "argon2id:demo") ?? return
    sess :: auth.password_login("alice", "argon2id:demo", 1_700_000_000_000, 3_600_000) ?? return
    show :: auth.session_show(sess)
    print("show:{text.byte_count(show) > 0}")
    print("user:{auth.session_user(sess)}")
    cookie :: auth.session_cookie(sess)
    print("cookie:{text.byte_count(cookie) > 0}")
    id :: auth.session_id(sess)
    print("id:{text.byte_count(id) > 0}")
    validated :: auth.session_validate(id, 1_700_000_000_001) ?? return
    print("validated:{auth.session_user(validated)}")

    auth.register_user("bob@example.com", "argon2id:demo") ?? return
    magic :: auth.magic_link_issue("bob@example.com", 1_700_000_000_000, 600_000) ?? return
    magic_sess :: auth.magic_link_consume(magic, 1_700_000_000_100, 3_600_000) ?? return
    print("magic_user:{auth.session_user(magic_sess)}")

    if auth.oauth_begin("google") == {
        .Ok(state) -> {
            if auth.oauth_finish(state, "carol", 1_700_000_000_200, 3_600_000) == {
                .Ok(oauth_sess) -> print("oauth_user:{auth.session_user(oauth_sess)}")
                .Err(_) -> print("oauth:rejected")
            }
        }
        .Err(_) -> print("oauth:rejected")
    }

    gate0 :: app.auth("users")
    gate :: app.auth_oauth(gate0, "google github")
    print(app.auth_show(gate))
    print(app.auth_routes(gate))
}
