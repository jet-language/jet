// E2-M9: core.crypto — SHA-256 hash for verification.
use core.crypto as crypto

fn run() {
    data :: "hello, jet".bytes()
    hash :: crypto.sha256(data)
    print(hash.hex().len())
    print(hash.hex() == "c8cb65770279d8b1df8296e3d242fc311bef32722c3df33af91c75e025bf3712")
    abc :: "abc".bytes()
    // NIST FIPS 180-4 and FIPS 202 vectors for the fixed input "abc".
    print(crypto.sha1(abc) == "a9993e364706816aba3e25717850c26c9cd0d89d")
    print(crypto.sha224(abc) == "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7")
    print(crypto.sha384(abc) == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    print(crypto.sha3_224(abc) == "e642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf")
    print(crypto.sha3_256(abc) == "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
    print(crypto.sha3_384(abc) == "ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25")
    print(crypto.sha3_512(abc) == "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0")
    derived :: crypto.pbkdf2_hmac("password".bytes(), "salt".bytes(), 1, 32)
    print(derived == [U8].{0x12, 0x0f, 0xb6, 0xcf, 0xfc, 0xf8, 0xb3, 0x2c, 0x43, 0xe7, 0x22, 0x52, 0x56, 0xc4, 0xf8, 0x37, 0xa8, 0x65, 0x48, 0xc9, 0x2c, 0xcc, 0x35, 0x48, 0x08, 0x05, 0x98, 0x7c, 0xb7, 0x0b, 0xe1, 0x7b})
    hasher := crypto.Hasher.new()
    hasher.update([U8].{0x61})
    hasher.update([U8].{0x62, 0x63})
    print(hasher.digest() == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}
