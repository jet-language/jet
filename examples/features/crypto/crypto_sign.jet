// D-CRYPTOENV1=A: crypto.sign / crypto.verify (Ed25519 envelope).
use core.crypto as crypto

fn main() {
    seed: [U8] :: [0x9d, 0x61, 0xb1, 0x9d, 0xef, 0xfd, 0x5a, 0x60, 0xba, 0x84, 0x4a, 0xf4, 0x92, 0xec, 0x2c, 0xc4, 0x44, 0x49, 0xc5, 0x69, 0x7b, 0x32, 0x69, 0x19, 0x70, 0x3b, 0xac, 0x03, 0x1c, 0xae, 0x7f, 0x60]
    msg: [U8] :: [116, 0x65, 0x73, 0x74]
    sig :: crypto.sign(seed, msg) ?? panic("sign failed")
    print("sig len: {sig.len()}")
    pk: [U8] :: [0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7, 0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a, 0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25, 0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a]
    crypto.verify(pk, msg, sig) ?? panic("verify failed")
    print("verify ok: true")
}
