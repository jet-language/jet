// D-CRYPTOENV1=A: crypto.sign / crypto.verify (Ed25519 envelope).
use core.crypto as crypto

fn run() {
    key :: crypto.SigningKey.new_random() ?? return Err("signing key")
    msg :: [U8]{116, 0x65, 0x73, 0x74}
    sig :: crypto.sign(key, msg) ?? return Err("sign failed")
    print("sig len: {sig.bytes().len()}")
    verified :: crypto.verify(key.public_key(), msg, sig) ?? return Err("verify failed")
    print("verify ok: {verified}")
}
