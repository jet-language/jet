// D-CAP7: all four capabilities in one program.
// plain T = read; ~T = write; ^T = take/move; &T = share.
struct Account {
    owner: String
    balance: Int
}

// plain read — no sigil
fn check(a: Account) -> Bool {
    return a.balance > 0
}

// &Account = shared read at a call boundary
fn print_balance(a: Account) {
    print("{a.owner}: {a.balance}")
}

// ~Account = edit in place
fn deposit(a: ~Account, amount: Int) {
    a.balance = a.balance + amount
}

// ^Account = consume; return a log string
fn close(a: ^Account) -> String {
    return "closed {a.owner} (final balance: {a.balance})"
}

fn run() {
    acc := Account.{owner: "Alice", balance: 100}
    print(check(acc))  // plain read
    print_balance(&acc)  // & share
    deposit(~acc, 50)  // ~ write
    print_balance(&acc)  // & share again
    log := close(^acc)  // ^ take; acc consumed
    print(log)
}
