// 152 — effect prohibition =[!E]=> (D-PROP1=A, D-PROP2=A).
// A function annotated =[!Net]=> guarantees it and its whole call graph never touch the network.
fn add(a: Int, b: Int) => Int :: a + b

fn multiply(a: Int, b: Int) => Int :: a * b

fn pure_math(x: Int, y: Int) =[!Net]=> Int {
    sum :: add(x, y)
    return multiply(sum, 2)
}

fn run() { print(pure_math(3, 4)) }
