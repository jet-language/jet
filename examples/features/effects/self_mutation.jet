// 83 — Self-mutation in `&self` methods (D-MUTSELF1 / D-MEM1).
// A `&self` method may change its receiver in place: assign a field
// (`self.field = v`), update one in place (`self.field += v`, S17), or
// reassign the whole receiver (`self = New{…}`).
struct Tracker {
    hits: Int
    streak: Int

    fn take_hit(&self) {
        // Field assignment + compound update on `self`.
        self.hits = (self.hits + 1)
        self.streak += 1
    }

    fn reset(&self) {
        // Whole-`self` reassignment back to a fresh value.
        self = Tracker.{hits: 0, streak: 0}
    }
}

fn run() {
    t := Tracker.{hits: 0, streak: 0}
    t.take_hit()
    t.take_hit()
    t.take_hit()
    print(t.hits)
    print(t.streak)
    t.reset()
    print(t.hits)
    print(t.streak)
}
