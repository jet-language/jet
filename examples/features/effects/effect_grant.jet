// A named `#FX` block binds a scoped `Authority` handle. The rights are
// revoked at scope end, and the block's effects must stay inside its list.
use core.files as fs

fn run() {
    path :: "/tmp/jet_scap_grant.txt"
    // Filesystem + console authority is granted only for the extent of this
    // block. Every effect used inside (`FS` for the file work, `IO` for `print`)
    // must be in the named block's list (E0712). The handle may not escape (E0711).
    #FX(grant: FS, IO) {
        fs.write(path, "granted\nthen revoked")
        text :: fs.read(path)
        print(text.to_upper())
    }
    // Outside the block the authority is revoked — ordinary code resumes.
    print("done")
}
