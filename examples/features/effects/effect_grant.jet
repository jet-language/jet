// `#Grant(caps: FS) { … }` (D-SCAP1) is the dual of `#Caps`: it GRANTS the
// listed effect(s) into a lexical scope, binding a first-class `Authority` handle
// (`caps`) that authorizes the work inside. The authority is RAII-revoked at
// scope end — the handle is bound only for the block, can't escape it (E0711),
// and an effect the grant doesn't cover has no authority backing it (E0712).
// The grant/revoke is a compile-time authority fact; codegen erases it to a
// plain block (I3).
use core.files as fs

fn run() ? {
    path :: "/tmp/jet_scap_grant.txt"
    // Filesystem + console authority is granted only for the extent of this
    // block. Like `#Caps`, the block is bounded to the granted set — every effect
    // used inside (`FS` for the file work, `IO` for `print`) must be granted, or
    // it has no authority (E0712). The handle `caps` may not escape (E0711).
    #Grant(caps: FS, IO) {
        fs.write(path, "granted\nthen revoked") ?? return Err("write failed")
        text :: fs.read(path) ?? return Err("read failed")
        print(text.to_upper())
    }
    // Outside the grant the authority is revoked — ordinary code resumes.
    print("done")
}
