// D-EFF2 expert levers. Beyond the transparent flow-through default, a
// higher-order function may demand or publish callback effects explicitly.
//
//   1. Callback param effect bound — `fn(T) =[]=> U` (or `fn(T) =[E]=> U`)
//      on a parameter type requires the actual callback's effects stay within
//      the bound. Passing one that exceeds it is E0747.
//
//   2. `=[via f]=>` pass-through — a function whose published effect set IS
//      whatever its callback parameter `f` carries. A tight, escape-proof
//      contract instead of the conservative flow-through.
// Lever 1: `transform` insists on a pure callback. An impure one is rejected at
// the call site before it ever runs.
fn transform(items: [Int], f: fn(Int) =[]=> Int) => [Int] :: items.map(x => f(x))

fn run_each(items: [Int], act: fn(Int)) =[via act]=> {
    loop x, items {
        act(x)
    }
}

fn double(n: Int) =[]=> Int :: n * 2

fn show(n: Int, /) =[IO]=> {
    print("{n}")
}

fn run() {
    doubled :: transform([1, 2, 3], double)
    print("{doubled}")
    run_each([10, 20], n => print("{n}"))
}
