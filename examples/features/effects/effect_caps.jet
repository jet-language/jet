// `#Abilities(…) { … }` (D-EFF1) restricts a block to a fixed set of effects: only
// those listed may be used inside, directly or through any call it reaches.
// An out-of-set effect is a compile error (E0712). The region is a plain
// lexical block in codegen — the restriction is a compile-time proof only.
fn announce(label: String, n: Int) :[IO]> { print("{label}: {n}") }

fn run() {
    // Inside, only `IO` is permitted — `announce` uses exactly `IO`, so it fits.
    #Abilities(IO) {
        announce("answer", 42)
    }
}
