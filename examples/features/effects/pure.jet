// S60 (E2-M16): `fn … =[]=>` checked modifier.
// A `fn … =[]=>` may only call other `fn … =[]=>`s; impure calls are E3401.
// Use `jet eval --pure 62_pure.jet` to evaluate this deterministically.
fn double(n: Int) =[]=> Int = (n * 2)

fn greeting(name: String) =[]=> String = "hello, {name}!"

fn run() {
    x :: double(21)
    print("{x}")
    g :: greeting("world")
    print(g)
}
