// D-CRYPTOENV1=A: misuse-resistant crypto.seal / crypto.open envelope.
use core.crypto as crypto

fn main() {
    key: [U8] #= [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
        0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
        0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
    ]
    msg: [U8] #= [104, 101, 108, 108, 111, 44, 32, 106, 101, 116]
    box #= crypto.seal(key, msg) ?? panic("seal failed")
    print("sealed bytes: {box.len()}")
    plain #= crypto.open(key, box) ?? panic("open failed")
    print("roundtrip len: {plain.len()}")
    print("roundtrip ok: {plain == msg}")
}
