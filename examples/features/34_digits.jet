//! S67 (ratified): `_` digit separators in numeric literals.
//! Separators are stripped before parsing — they only aid reading, never the
//! value, and the formatter neither inserts nor removes them.
fn main() {
    val population = 1_000_000;
    val balance = 1_000_000;
    val deadbeef = 0xDEAD_BEEF;
    val nibbles = 0b1010_0101;
    print("population: {population}");
    print("balance: {balance}");
    print("deadbeef: {deadbeef}");
    print("nibbles: {nibbles}");
}
