// D-JPK-TASKRUN1 (card #476) — project tasks are `#Task fn`s.
// Invoke: `jetpack run greet` / `jetpack run seed`
//   (or `jet run --task=greet|seed <this-file>`).
// Cross-task dependency = a plain call (`seed` calls `greet` below).
// I5 golden runs both --task paths (see tests/golden.rs).
#Task
fn greet() {
    print("hello from task")
}

#Task
fn seed() {
    greet()
    print("seeded")
}

fn run() {
    print("use jetpack run greet")
}
