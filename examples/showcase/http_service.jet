// Showcase 2 — HTTP service with tasks + channels.
// Starts a loopback server in a background task and sends one request.
// Demonstrates: tasks, channels, net, HTTP (E2-M10).
use jet.http as http;
use core.net as net;
use core.tasks as tasks;

fn handle(req: HttpRequest) -> HttpResponse {
    val greeting = "hello from Jet! method={req.method()} path={req.path()}";
    return HttpResponse { status: "200 OK", body: greeting, headers: [:] };
}

fn main() {
    val ch: Channel<String> = tasks.channel();
    val sender = ch.sender();
    tasks.spawn(take(sender) () => {
        val listener = net.tcp_listen("127.0.0.1:0") ?? panic("bind failed");
        val addr = listener.local_addr();
        sender.send(addr);
        val stream = listener.accept() ?? panic("accept failed");
        val _req_raw = stream.read() ?? panic("read failed");
        val req = HttpRequest { method: "GET", path: "/", body: "", headers: [:] };
        val resp = handle(req);
        net.tcp_reply(stream, resp.status(), resp.body());
    });
    val addr = ch.receive() ?? panic("no address");
    val resp = http.get("http://{addr}/") ?? panic("http get failed");
    print(resp.body());
}
