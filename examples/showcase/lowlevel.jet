// Showcase 5 — expert low-level tier: #Unsafe + *T.
// Everything outside the #Unsafe region is safe Jet; the
// pointer operations are confined to the explicitly-audited block.
// C FFI (use c.<lib>) is in tests/cffi.rs; this smoke shows the
// core.mem tier that underpins it — E2-M13 / D-UNSAFE2.
use core.mem
fn main() {
    cell@ Int = 42
    #Unsafe("`cell` is live on this stack frame and the pointer never escapes") {
        p@ *Int = *cell
        print("low-level read: {p.*}")
    }
}
