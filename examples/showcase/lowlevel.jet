// Showcase 5 — expert low-level tier: @unsafe + Ptr<T> + @audit.
// Everything outside the @audit/@unsafe region is safe Jet; the
// pointer operations are confined to the explicitly-audited block.
// C FFI (use c.<lib>) is in tests/cffi.rs; this smoke shows the
// core.mem tier that underpins it — E2-M13.
use core.mem
@unsafe
fn read_int(addr: Int) -> Int {
    p :: mem.Ptr<Int>.from_addr(addr)
    return mem.volatile_read(p)
}
fn main() {
    cell: Int :: 42
    addr :: mem.address_of(cell)
    @audit("addr is the address of `cell`, a live stack Int")
    @unsafe {
        seen :: read_int(addr)
        print("low-level read: {seen}")
    }
}
