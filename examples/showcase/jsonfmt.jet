// jsonfmt — JSON pretty-printer/validator.
// Usage: jsonfmt FILE
use core.io as io
use core.fs as fs
use core.json as json
use core.process as process
fn main() {
    args :: io.args()
    path :: args.get(1) ?? ""
    if path == "" {
        print("usage: jsonfmt FILE")
        process.exit(1)
    }
    text :: fs.read(path) ?? panic("cannot read file")
    if json.parse(text) {
        it == ok(data) -> {
            print(json.render_pretty(data))
        }
        it == err(e) -> {
            io.eprint("parse error at line {e.line}: {e.message}")
            process.exit(1)
        }

    }
}
