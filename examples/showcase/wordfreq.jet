// wordfreq — word frequency across files in a directory.
// Usage: wordfreq DIR
use core.io as io
use core.fs as fs
use core.process as process
fn count_file(path: String, mut counts: [String, Int]) {
    if fs.read(path) {
        it == ok(text) -> {
            flat @= text.replace("\n", " ")
            words @= flat.split(" ")
            loop raw in words {
                word @= raw.trim().to_lower()
                if word != "" {
                    counts[word] = ((counts.get(word) ?? 0) + 1)
                }
            }
        }
        it == err(_) -> {

        }

    }
}
fn count_dir(dir: String, mut counts: [String, Int]) {
    if fs.list_dir(dir) {
        it == ok(entries) -> {
            loop entry in entries {
                if entry.is_dir {
                    count_dir(entry.path, mut counts)
                } else if entry.name.ends_with(".txt") {
                    count_file(entry.path, mut counts)
                }
            }
        }
        it == err(_) -> {

        }

    }
}
fn main() {
    args @= io.args()
    target @= args.get(1) ?? ""
    if target == "" {
        print("usage: wordfreq DIR")
        process.exit(1)
    }
    counts: [String, Int] := [:]
    if fs.is_dir(target) {
        count_dir(target, mut counts)
    } else {
        count_file(target, mut counts)
    }
    pairs: [(n: Int, word: String)] := []
    loop word, n in counts {
        pairs.push((word: word, n: n))
    }
    pairs.sort_by((p: (n: Int, word: String)) => (-p.n))
    loop p in pairs {
        print("{p.word}: {p.n}")
    }
}
