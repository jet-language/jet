// jetgrep — grep-lite: search files for a pattern.
// Usage: jetgrep [-n] [-r] PATTERN FILE_OR_DIR
use core.io as io
use core.fs as fs
use core.process as process
fn grep_file(path: String, pattern: String, show_line_nums: Bool) -> Bool {
    text @= fs.read(path) ?? return false
    lines @= text.split("\n")
    matched := false
    n := 0
    loop line in lines {
        n+= 1
        if line.contains(pattern) {
            matched = true
            if show_line_nums {
                print("{path}:{n}:{line}")
            } else {
                print("{path}:{line}")
            }
        }
    }
    return matched
}
fn grep_dir(dir: String, pattern: String, show_line_nums: Bool) -> Bool {
    entries @= fs.list_dir(dir) ?? return false
    matched := false
    loop entry in entries {
        full @= "{dir}/{entry}"
        if fs.is_dir(full) {
            if grep_dir(full, pattern, show_line_nums) {
                matched = true
            }
        } else {
            if grep_file(full, pattern, show_line_nums) {
                matched = true
            }
        }
    }
    return matched
}
fn main() {
    args @= io.args()
    show_line_nums := false
    recursive := false
    pattern := ""
    target := ""
    i := 1
    loop i < args.len() {
        a @= args.get(i) ?? ""
        if a == "-n" {
            show_line_nums = true
        } else if a == "-r" {
            recursive = true
        } else if pattern == "" {
            pattern = a
        } else {
            target = a
        }
        i+= 1
    }
    if pattern == "" {
        print("usage: jetgrep [-n] [-r] PATTERN FILE_OR_DIR")
        process.exit(1)
    }
    if target == "" {
        print("usage: jetgrep [-n] [-r] PATTERN FILE_OR_DIR")
        process.exit(1)
    }
    found := false
    if recursive || fs.is_dir(target) {
        found = grep_dir(target, pattern, show_line_nums)
    } else {
        found = grep_file(target, pattern, show_line_nums)
    }
    if found {
        process.exit(0)
    } else {
        process.exit(1)
    }
}
