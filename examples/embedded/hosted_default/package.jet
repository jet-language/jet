// Hosted defaults stay hidden in the canonical machine. No target-specific
// provider or alternate Prelude is declared here.
name: "embedded_hosted_default"
version: "0.1.0"
edition: "2026"
target: "hosted"
runtime: "hosted"
authority: {
    holds: {
        allow: [IO, Mem.Alloc]
    }
}
build: {
    release: Build{ optimize: full },
    debug: Build{ optimize: none, debug_info: true },
}
