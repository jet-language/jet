// Target facts stay in the typed `TargetMachine`; package fields only select
// that machine and the runtime ceiling. There is no legacy freestanding flag.
name: "embedded_allocator_firmware"
version: "0.1.0"
edition: "2026"
targets: { machine: { profile: "board.sensor_v1" } }
runtime: "alloc"
authority: {
    holds: {
        allow: [IO, Mem.Alloc]
    }
}
build: {
    release: Build{ optimize: full, panic: abort },
}
