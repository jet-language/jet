// The named target supplies the complete no-OS dossier; this manifest does not
// recreate a second Prelude or infer providers from the target triple.
name: "embedded_heap_free_core"
version: "0.1.0"
edition: "2026"
targets: { machine: { profile: "web.no_os" } }
runtime: "core"
build: {
    release: Build{ optimize: full, panic: abort },
}
