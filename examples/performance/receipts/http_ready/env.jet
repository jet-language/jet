module env.dev {
    services: {
        http_ready: {
            enable: true,
            ports: [18080],
            run: ["./build/run", "serve"],
            ready: "/run/current-system/sw/bin/curl --fail --silent --show-error http://127.0.0.1:18080/",
            data_dir: ".",
        }
    }
}
