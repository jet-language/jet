module env.dev {
    sources: { stable: NixOS/nixpkgs/nixos-24.05@github }
    packages: [nixpkgs.git]
    languages: [
        "rust": Lang{ enable: true, channel: .Stable },
        "python": Lang{ enable: true, version: "3.12", venv: true }
    ]
    dotenv: [Dotenv{ file: ".env", allow: ["PORT", "TOKEN"], secrets: ["TOKEN"] }]
    imports: [
        env.cloud.credentials([TOKEN]),
        env.security.vault([TOKEN])
    ]
    files: ["config/generated.txt": File{ content: "generated\n", mode: .Copy }]
}
