// jet-pkgs/env.jet — a first-party Jet package repo (R2).
//
// A package repo declares the packages it provides with `pkg.package(...)`:
// a name and the source subpath whose tree the `core` provider materializes
// into the Jetpack store. No Nix is involved.
//
// Consume it from another project's env.jet:
//   pkg.source("mine", "path:../jet-pkgs", "core");
//   pkg.packages(["mine:hello"]);
import jetpack as pkg;
pub fn shell() -> [JSON] {
    return [pkg.package("hello", "./pkgs/hello")];
}
