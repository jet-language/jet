// env.jet — a Jetpack dev environment, typed module surface (U3/U6/U8).
//
// This is the target authoring surface the Phase-1 `pkg.*` directive file
// evolves into. `module` is the single outermost construct: `sources:` and
// `imports:` nest inside the body as siblings of the `env.dev: Env { … }`
// contribution — like a flake's one `{}` holding both its inputs and outputs.
//
//   jetpack build     # realize ripgrep + fd + jq from the pinned nixpkgs
//   jetpack run       # the same, then enter a shell prompted `wordstats`
//
// `imports: find("./modules")` auto-discovers every `.jet` file under
// `modules/` and merges each module's contributions — drop `modules/tools.jet`
// in and its `jq` joins the env with no edit here (U4 import-tree discovery).
//
// Source refs are `provider@target` (U6); `default.[ripgrep, fd]` is the typed
// Pkg sugar — each bracket item is one `Pkg` drawn from the `default` source.
module dev {
    sources: { default: github@NixOS/nixpkgs/nixos-24.05 }
    imports: find("./modules")
    env.dev: Env {
        packages: [default.[ripgrep, fd]],
        prompt: "wordstats",
    }
}
