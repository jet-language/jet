// User story: a support lead wants the open tickets that need attention.
struct Ticket {
    id: Int
    customer: String
    priority: Int
    open: Bool
}

fn run() {
    tickets :: [
        Ticket{id: 101, customer: "Ada", priority: 1, open: true},
        Ticket{id: 102, customer: "Lin", priority: 3, open: false},
        Ticket{id: 103, customer: "Mina", priority: 2, open: true}
    ]
    loop ticket in tickets {
        if ticket.open -> print("{ticket.id} {ticket.customer} p{ticket.priority}")
    }
}
