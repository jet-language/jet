// User story: a shop owner wants a small daily expense report.
struct LineItem {
    label: String
    cents: Int
}

fn total(items: [LineItem]) Int -> {
    sum := 0
    loop item in items -> sum += item.cents
    return sum
}

fn run() {
    items :: [
        LineItem{label: "coffee", cents: 450},
        LineItem{label: "sandwich", cents: 875},
        LineItem{label: "tea", cents: 325}
    ]
    print("items: {items.len()}")
    print("total cents: {total(items)}")
}
