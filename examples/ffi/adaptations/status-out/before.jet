#Import module c.status {
    fn decode_status(input: &[U8], input_len: U32, output: &[U8], output_cap: U32, written: &U32) Int = "decode_status"
}

// Unrun expectation: the native status and out count remain visible to the caller.
pub fn run() Int -> {
    input := [1, 2, 3]
    output := [0, 0, 0]
    written := 0
    return c.status.decode_status(&input, 3, &output, 3, &written)
}
