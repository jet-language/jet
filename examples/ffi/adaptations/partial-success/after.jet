#Import module c.stream {
    fn __jet_ffi_native_read_chunk(input: &[U8], input_len: U32, output: &[U8], output_cap: U32, read_len: &U32) Int = "read_chunk"
}

// Unrun expectation: partial success is a first-class outcome; the facade
// never retries, pads, truncates, or changes the native status meaning.
pub fn read_chunk(input: &[U8], output: &[U8]) Result<U32, Int> -> {
    read_len := 0
    status := __jet_ffi_native_read_chunk(input, input.len(), output, output.len(), &read_len)
    if status < 0 -> return Err(status)
    return Ok(read_len)
}

pub fn run() Result<U32, Int> -> {
    input := [1, 2, 3, 4]
    output := [0, 0]
    return read_chunk(&input, &output)
}
