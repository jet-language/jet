#Import module c.names {
    fn find_name_native(id: U64) String? = "find_name"
}

// Unrun expectation: NULL is lifted to absence; a non-null result keeps the
// foreign storage identity and does not introduce a copy or fabricated value.
pub fn find_name(id: U64) String? -> {
    return find_name_native(id)
}

pub fn run() String? -> {
    return find_name(7)
}
