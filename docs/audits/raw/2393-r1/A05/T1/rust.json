  "source": "use std::{env, fs, process};\n\nstruct Section {\n    name: String,\n    inherits: Option<String>,\n    fields: Vec<(String, String)>,\n}\n\nfn fail(message: impl AsRef<str>) -> ! {\n    eprintln!(\"{}\", message.as_ref());\n    process::exit(1);\n}\n\nfn parse_quoted(input: &str) -> Result<String, String> {\n    if input.len() < 2 || !input.starts_with('\"') || !input.ends_with('\"') {\n        return Err(\"expected a quoted value\".to_owned());\n    }\n    let inner = &input[1..input.len() - 1];\n    let mut output = String::new();\n    let mut characters = inner.chars();\n    while let Some(character) = characters.next() {\n        if character != '\\\\' {\n            if character == '\"' {\n                return Err(\"unescaped quote in value\".to_owned());\n            }\n            output.push(character);\n            continue;\n        }\n        let escaped = characters\n            .next()\n            .ok_or_else(|| \"unfinished escape in value\".to_owned())?;\n        match escaped {\n            '\"' => output.push('\"'),\n            '\\\\' => output.push('\\\\'),\n            'n' => output.push('\\n'),\n            'r' => output.push('\\r'),\n            't' => output.push('\\t'),\n            other => return Err(format!(\"unsupported escape '\\\\{}'\", other)),\n        }\n    }\n    Ok(output)\n}\n\nfn resolve_section(index: usize, sections: &[Section]) -> Result<Vec<(String, String)>, String> {\n    let section = &sections[index];\n    let mut resolved = Vec::new();\n\n    if let Some(parent_name) = &section.inherits {\n        let parent_index = sections\n            .iter()\n            .position(|candidate| candidate.name == *parent_name)\n            .ok_or_else(|| {\n                format!(\n                    \"section '{}' inherits unknown section '{}'\",\n                    section.name, parent_name\n                )\n            })?;\n        let parent = &sections[parent_index];\n        if parent.inherits.is_some() {\n            return Err(format!(\n                \"section '{}' has an inheritance chain longer than one level\",\n                section.name\n            ));\n        }\n        for (key, value) in &parent.fields {\n            if key != \"inherits\" {\n                resolved.push((key.clone(), value.clone()));\n            }\n        }\n    }\n\n    for (key, value) in &section.fields {\n        if key == \"inherits\" {\n            continue;\n        }\n        if let Some(existing) = resolved\n            .iter_mut()\n            .find(|(existing_key, _)| existing_key == key)\n        {\n            existing.1 = value.clone();\n        } else {\n            resolved.push((key.clone(), value.clone()));\n        }\n    }\n    Ok(resolved)\n}\n\nfn main() {\n    let path = match env::args().nth(1) {\n        Some(path) => path,\n        None => fail(\"missing input path\"),\n    };\n    let input = match fs::read_to_string(&path) {\n        Ok(input) => input,\n        Err(error) => fail(format!(\"cannot read '{}': {}\", path, error)),\n    };\n\n    let mut sections: Vec<Section> = Vec::new();\n    let mut current: Option<usize> = None;\n\n    for (line_number, raw_line) in input.lines().enumerate() {\n        let line = raw_line.strip_suffix('\\r').unwrap_or(raw_line).trim();\n        if line.is_empty() || line.starts_with('#') {\n            continue;\n        }\n        if line.starts_with('[') {\n            if !line.ends_with(']') || line.len() <= 2 {\n                fail(format!(\"line {}: malformed section header\", line_number + 1));\n            }\n            let name = line[1..line.len() - 1].trim();\n            if name.is_empty() || name.contains('[') || name.contains(']') {\n                fail(format!(\"line {}: malformed section header\", line_number + 1));\n            }\n            if sections.iter().any(|section| section.name == name) {\n                fail(format!(\"line {}: duplicate section '{}',\", line_number + 1, name));\n            }\n            sections.push(Section {\n                name: name.to_owned(),\n                inherits: None,\n                fields: Vec::new(),\n            });\n            current = Some(sections.len() - 1);\n            continue;\n        }\n\n        let section_index = match current {\n            Some(index) => index,\n            None => fail(format!(\"line {}: field appears before a section\", line_number + 1)),\n        };\n        let (key, raw_value) = match line.split_once('=') {\n            Some(parts) => parts,\n            None => fail(format!(\"line {}: expected key = value\", line_number + 1)),\n        };\n        let key = key.trim();\n        if key.is_empty() {\n            fail(format!(\"line {}: empty field name\", line_number + 1));\n        }\n        if sections[section_index]\n            .fields\n            .iter()\n            .any(|(existing_key, _)| existing_key == key)\n        {\n            fail(format!(\n                \"duplicate field '{}' in section '{}'\",\n                key, sections[section_index].name\n            ));\n        }\n        let value = match parse_quoted(raw_value.trim()) {\n            Ok(value) => value,\n            Err(error) => fail(format!(\"line {}: {}\", line_number + 1, error)),\n        };\n        if key == \"inherits\" {\n            sections[section_index].inherits = Some(value.clone());\n        }\n        sections[section_index]\n            .fields\n            .push((key.to_owned(), value));\n    }\n\n    if sections.is_empty() {\n        fail(\"configuration has no sections\");\n    }\n\n    let mut output = String::new();\n    for (index, section) in sections.iter().enumerate() {\n        let resolved = match resolve_section(index, &sections) {\n            Ok(resolved) => resolved,\n            Err(error) => fail(error),\n        };\n        for (key, value) in resolved {\n            output.push_str(&section.name);\n            output.push('.');\n            output.push_str(&key);\n            output.push('=');\n            output.push_str(&value);\n            output.push('\\n');\n        }\n    }\n    print!(\"{}\", output);\n}\n",
