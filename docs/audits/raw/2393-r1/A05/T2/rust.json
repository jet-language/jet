  "source": "use std::{env, process};\n\n#[derive(Clone, Copy)]\nenum Format {\n    Text,\n    Json,\n}\n\nstruct Options {\n    format: Format,\n    dry_run: bool,\n}\n\nenum Command {\n    List { name: String, options: Options },\n    Inspect { name: String, options: Options },\n    Remove { name: String, options: Options },\n}\n\nfn fail(message: impl AsRef<str>) -> ! {\n    eprintln!(\"{}\", message.as_ref());\n    process::exit(1);\n}\n\nfn format_name(format: Format) -> &'static str {\n    match format {\n        Format::Text => \"text\",\n        Format::Json => \"json\",\n    }\n}\n\nfn parse_command() -> Result<Command, String> {\n    let mut arguments = env::args().skip(1);\n    let operation = arguments\n        .next()\n        .ok_or_else(|| \"missing command\".to_owned())?;\n    let operation = match operation.as_str() {\n        \"list\" | \"ls\" => 0,\n        \"inspect\" => 1,\n        \"remove\" | \"rm\" => 2,\n        other => return Err(format!(\"unknown command '{}'\", other)),\n    };\n\n    let mut name: Option<String> = None;\n    let mut format = Format::Text;\n    let mut dry_run = false;\n    while let Some(argument) = arguments.next() {\n        match argument.as_str() {\n            \"--json\" => format = Format::Json,\n            \"--dry-run\" => dry_run = true,\n            \"--format\" => {\n                let value = arguments\n                    .next()\n                    .ok_or_else(|| \"missing value for --format\".to_owned())?;\n                format = match value.as_str() {\n                    \"text\" => Format::Text,\n                    \"json\" => Format::Json,\n                    other => return Err(format!(\"invalid format '{}'\", other)),\n                };\n            }\n            option if option.starts_with(\"--\") => {\n                return Err(format!(\"unknown option '{}'\", option));\n            }\n            value => {\n                if name.is_some() {\n                    return Err(\"multiple command names\".to_owned());\n                }\n                name = Some(value.to_owned());\n            }\n        }\n    }\n\n    let name = name.ok_or_else(|| \"missing command name\".to_owned())?;\n    let options = Options { format, dry_run };\n    Ok(match operation {\n        0 => Command::List { name, options },\n        1 => Command::Inspect { name, options },\n        _ => Command::Remove { name, options },\n    })\n}\n\nfn dispatch(command: Command) {\n    match command {\n        Command::List { name, options } => println!(\n            \"list name={} format={} dry_run={}\",\n            name,\n            format_name(options.format),\n            options.dry_run\n        ),\n        Command::Inspect { name, options } => println!(\n            \"inspect name={} format={} dry_run={}\",\n            name,\n            format_name(options.format),\n            options.dry_run\n        ),\n        Command::Remove { name, options } => println!(\n            \"remove name={} format={} dry_run={}\",\n            name,\n            format_name(options.format),\n            options.dry_run\n        ),\n    }\n}\n\nfn main() {\n    let command = match parse_command() {\n        Ok(command) => command,\n        Err(error) => fail(error),\n    };\n    dispatch(command);\n}\n",
