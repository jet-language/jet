  "source": "use std::{env, fs, process};\n\nstruct Entry {\n    key: String,\n    value: String,\n}\n\nfn fail(message: impl AsRef<str>) -> ! {\n    eprintln!(\"{}\", message.as_ref());\n    process::exit(1);\n}\n\nfn main() {\n    let path = match env::args().nth(1) {\n        Some(path) => path,\n        None => fail(\"missing input path\"),\n    };\n    let input = match fs::read_to_string(&path) {\n        Ok(input) => input,\n        Err(error) => fail(format!(\"cannot read '{}': {}\", path, error)),\n    };\n\n    let mut entries: Vec<Entry> = Vec::new();\n    for (line_number, raw_line) in input.lines().enumerate() {\n        let line = raw_line.strip_suffix('\\r').unwrap_or(raw_line);\n        if line.is_empty() {\n            fail(format!(\"line {}: malformed record\", line_number + 1));\n        }\n        let fields: Vec<&str> = line.split('|').collect();\n        if fields.len() != 3 {\n            fail(format!(\"line {}: malformed record\", line_number + 1));\n        }\n\n        match fields[0] {\n            \"put\" => {\n                if fields[1].is_empty() {\n                    fail(format!(\"line {}: empty key\", line_number + 1));\n                }\n                if let Some(entry) = entries.iter_mut().find(|entry| entry.key == fields[1]) {\n                    entry.value.clear();\n                    entry.value.push_str(fields[2]);\n                } else {\n                    entries.push(Entry {\n                        key: fields[1].to_owned(),\n                        value: fields[2].to_owned(),\n                    });\n                }\n            }\n            \"delete\" => {\n                if fields[1].is_empty() || !fields[2].is_empty() {\n                    fail(format!(\"line {}: malformed delete record\", line_number + 1));\n                }\n                if let Some(position) = entries.iter().position(|entry| entry.key == fields[1]) {\n                    entries.remove(position);\n                }\n            }\n            kind => fail(format!(\n                \"line {}: unknown record kind '{}'\",\n                line_number + 1,\n                kind\n            )),\n        }\n    }\n\n    let mut output = String::new();\n    for entry in entries {\n        output.push_str(&entry.key);\n        output.push('=');\n        output.push_str(&entry.value);\n        output.push('\\n');\n    }\n    print!(\"{}\", output);\n}\n",
