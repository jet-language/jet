  "source": "use std::env;\nuse std::process;\n\n#[derive(Clone, Copy)]\nenum Format {\n    Text,\n    Json,\n}\n\nstruct Options {\n    format: Format,\n    dry_run: bool,\n}\n\nenum Command {\n    List { name: String, options: Options },\n    Inspect { name: String, options: Options },\n    Remove { name: String, options: Options },\n}\n\nfn parse_args(args: &[String]) -> Result<Command, String> {\n    let command_name = args\n        .first()\n        .ok_or_else(|| \"missing command\".to_string())?;\n    let canonical = match command_name.as_str() {\n        \"list\" | \"ls\" => \"list\",\n        \"inspect\" => \"inspect\",\n        \"remove\" | \"rm\" => \"remove\",\n        _ => return Err(format!(\"unknown command '{}'\", command_name)),\n    };\n\n    let mut format = Format::Text;\n    let mut dry_run = false;\n    let mut name: Option<String> = None;\n    let mut index = 1;\n    while index < args.len() {\n        let arg = &args[index];\n        if arg == \"--json\" {\n            format = Format::Json;\n        } else if arg == \"--dry-run\" {\n            dry_run = true;\n        } else if arg == \"--format\" {\n            index += 1;\n            let value = args\n                .get(index)\n                .ok_or_else(|| \"missing value for --format\".to_string())?;\n            format = parse_format(value)?;\n        } else if let Some(value) = arg.strip_prefix(\"--format=\") {\n            if value.is_empty() {\n                return Err(\"missing value for --format\".to_string());\n            }\n            format = parse_format(value)?;\n        } else if arg.starts_with('-') {\n            return Err(format!(\"unknown option '{}'\", arg));\n        } else if name.replace(arg.to_string()).is_some() {\n            return Err(\"multiple names supplied\".to_string());\n        }\n        index += 1;\n    }\n\n    let name = name.ok_or_else(|| \"missing name\".to_string())?;\n    if name.is_empty() {\n        return Err(\"missing name\".to_string());\n    }\n    let options = Options { format, dry_run };\n    Ok(match canonical {\n        \"list\" => Command::List { name, options },\n        \"inspect\" => Command::Inspect { name, options },\n        \"remove\" => Command::Remove { name, options },\n        _ => unreachable!(),\n    })\n}\n\nfn parse_format(value: &str) -> Result<Format, String> {\n    match value {\n        \"text\" => Ok(Format::Text),\n        \"json\" => Ok(Format::Json),\n        _ => Err(format!(\"invalid format '{}'\", value)),\n    }\n}\n\nfn format_name(format: Format) -> &'static str {\n    match format {\n        Format::Text => \"text\",\n        Format::Json => \"json\",\n    }\n}\n\nfn render(command: Command) -> String {\n    let (operation, name, options) = match command {\n        Command::List { name, options } => (\"list\", name, options),\n        Command::Inspect { name, options } => (\"inspect\", name, options),\n        Command::Remove { name, options } => (\"remove\", name, options),\n    };\n    format!(\n        \"{} name={} format={} dry_run={}\\n\",\n        operation,\n        name,\n        format_name(options.format),\n        options.dry_run\n    )\n}\n\nfn main() {\n    let args: Vec<String> = env::args().skip(1).collect();\n    match parse_args(&args) {\n        Ok(command) => print!(\"{}\", render(command)),\n        Err(error) => {\n            eprintln!(\"{}\", error);\n            process::exit(1);\n        }\n    }\n}\n",
