  "source": "use std::collections::HashMap;\nuse std::env;\nuse std::fs;\nuse std::process;\n\nstruct Section {\n    name: String,\n    fields: Vec<(String, String)>,\n    inherits: Option<String>,\n}\n\nfn parse_quoted(value: &str) -> Result<String, String> {\n    let value = value.trim();\n    if !value.starts_with('\"') || !value.ends_with('\"') || value.len() < 2 {\n        return Err(\"field value must be quoted\".to_string());\n    }\n    let inner = &value[1..value.len() - 1];\n    let mut result = String::new();\n    let mut escaped = false;\n    for ch in inner.chars() {\n        if escaped {\n            let decoded = match ch {\n                '\"' => '\"',\n                '\\\\' => '\\\\',\n                'n' => '\\n',\n                'r' => '\\r',\n                't' => '\\t',\n                _ => return Err(\"unsupported escape in quoted value\".to_string()),\n            };\n            result.push(decoded);\n            escaped = false;\n        } else if ch == '\\\\' {\n            escaped = true;\n        } else {\n            result.push(ch);\n        }\n    }\n    if escaped {\n        return Err(\"unterminated escape in quoted value\".to_string());\n    }\n    Ok(result)\n}\n\nfn parse_file(contents: &str) -> Result<Vec<Section>, String> {\n    let mut sections = Vec::new();\n    let mut current: Option<usize> = None;\n    for (line_number, raw_line) in contents.lines().enumerate() {\n        let line = raw_line.trim();\n        if line.is_empty() {\n            continue;\n        }\n        if line.starts_with('[') {\n            if !line.ends_with(']') || line.len() < 3 {\n                return Err(format!(\"malformed section header on line {}\", line_number + 1));\n            }\n            let name = line[1..line.len() - 1].trim();\n            if name.is_empty() {\n                return Err(format!(\"empty section name on line {}\", line_number + 1));\n            }\n            sections.push(Section {\n                name: name.to_string(),\n                fields: Vec::new(),\n                inherits: None,\n            });\n            current = Some(sections.len() - 1);\n            continue;\n        }\n        let section_index = current.ok_or_else(|| {\n            format!(\"field outside a section on line {}\", line_number + 1)\n        })?;\n        let (key, value) = line.split_once('=').ok_or_else(|| {\n            format!(\"malformed field on line {}\", line_number + 1)\n        })?;\n        let key = key.trim();\n        if key.is_empty() {\n            return Err(format!(\"empty field name on line {}\", line_number + 1));\n        }\n        if (key == \"inherits\" && sections[section_index].inherits.is_some())\n            || sections[section_index]\n                .fields\n                .iter()\n                .any(|(existing, _)| existing == key)\n        {\n            return Err(format!(\n                \"duplicate field '{}' in section '{}'\",\n                key, sections[section_index].name\n            ));\n        }\n        let value = parse_quoted(value).map_err(|error| {\n            format!(\"{} on line {}\", error, line_number + 1)\n        })?;\n        if key == \"inherits\" {\n            sections[section_index].inherits = Some(value);\n        } else {\n            sections[section_index]\n                .fields\n                .push((key.to_string(), value));\n        }\n    }\n    if sections.is_empty() {\n        return Err(\"no sections found\".to_string());\n    }\n    Ok(sections)\n}\n\nfn resolve_section(\n    index: usize,\n    sections: &[Section],\n    by_name: &HashMap<String, usize>,\n    visiting: &mut Vec<usize>,\n) -> Result<Vec<(String, String)>, String> {\n    if visiting.contains(&index) {\n        return Err(format!(\"inheritance cycle at section '{}'\", sections[index].name));\n    }\n    visiting.push(index);\n    let mut resolved = if let Some(parent_name) = sections[index].inherits.as_ref() {\n        let parent_index = by_name.get(parent_name).ok_or_else(|| {\n            format!(\n                \"section '{}' inherits unknown section '{}'\",\n                sections[index].name, parent_name\n            )\n        })?;\n        resolve_section(*parent_index, sections, by_name, visiting)?\n    } else {\n        Vec::new()\n    };\n    for (key, value) in &sections[index].fields {\n        if let Some(existing) = resolved.iter_mut().find(|(name, _)| name == key) {\n            existing.1 = value.clone();\n        } else {\n            resolved.push((key.clone(), value.clone()));\n        }\n    }\n    visiting.pop();\n    Ok(resolved)\n}\n\nfn run() -> Result<String, String> {\n    let path = env::args()\n        .nth(1)\n        .ok_or_else(|| \"missing records.cfg path\".to_string())?;\n    let contents = fs::read_to_string(&path)\n        .map_err(|error| format!(\"cannot read '{}': {}\", path, error))?;\n    let sections = parse_file(&contents)?;\n    let mut by_name = HashMap::new();\n    for (index, section) in sections.iter().enumerate() {\n        if by_name.insert(section.name.clone(), index).is_some() {\n            return Err(format!(\"duplicate section '{}'\", section.name));\n        }\n    }\n    let mut output = String::new();\n    for (index, section) in sections.iter().enumerate() {\n        let resolved = resolve_section(index, &sections, &by_name, &mut Vec::new())?;\n        for (key, value) in resolved {\n            output.push_str(&section.name);\n            output.push('.');\n            output.push_str(&key);\n            output.push('=');\n            output.push_str(&value);\n            output.push('\\n');\n        }\n    }\n    Ok(output)\n}\n\nfn main() {\n    match run() {\n        Ok(output) => print!(\"{}\", output),\n        Err(error) => {\n            eprintln!(\"{}\", error);\n            process::exit(1);\n        }\n    }\n}\n",
