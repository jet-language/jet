  "source": "use std::collections::HashMap;\nuse std::env;\nuse std::fs;\nuse std::process;\n\nfn run() -> Result<String, String> {\n    let path = env::args()\n        .nth(1)\n        .ok_or_else(|| \"missing journal.log path\".to_string())?;\n    let contents = fs::read_to_string(&path)\n        .map_err(|error| format!(\"cannot read '{}': {}\", path, error))?;\n    let mut state: HashMap<String, String> = HashMap::new();\n    let mut order: Vec<String> = Vec::new();\n\n    for (line_number, raw_line) in contents.lines().enumerate() {\n        let line = raw_line.strip_suffix('\\r').unwrap_or(raw_line);\n        if line.is_empty() {\n            return Err(format!(\"malformed record on line {}\", line_number + 1));\n        }\n        let parts: Vec<&str> = line.split('|').collect();\n        if parts.len() != 3 || parts[1].is_empty() {\n            return Err(format!(\"malformed record on line {}\", line_number + 1));\n        }\n        let key = parts[1].to_string();\n        match parts[0] {\n            \"put\" => {\n                if !state.contains_key(&key) {\n                    order.push(key.clone());\n                }\n                state.insert(key, parts[2].to_string());\n            }\n            \"delete\" => {\n                if !parts[2].is_empty() {\n                    return Err(format!(\"malformed delete on line {}\", line_number + 1));\n                }\n                state.remove(&key);\n            }\n            kind => {\n                return Err(format!(\"unknown record kind '{}'\", kind));\n            }\n        }\n    }\n\n    let mut output = String::new();\n    for key in order {\n        if let Some(value) = state.get(&key) {\n            output.push_str(&key);\n            output.push('=');\n            output.push_str(value);\n            output.push('\\n');\n        }\n    }\n    Ok(output)\n}\n\nfn main() {\n    match run() {\n        Ok(output) => print!(\"{}\", output),\n        Err(error) => {\n            eprintln!(\"{}\", error);\n            process::exit(1);\n        }\n    }\n}\n",
