  "source": "use std::env;\nuse std::fs;\nuse std::process;\n\nstruct Report {\n    count: i64,\n    name: String,\n    note: String,\n}\n\nfn parse_report(contents: &str) -> Result<Report, String> {\n    let mut name: Option<String> = None;\n    let mut count: Option<i64> = None;\n    let mut note: Option<String> = None;\n    for (line_number, raw_line) in contents.lines().enumerate() {\n        let line = raw_line.strip_suffix('\\r').unwrap_or(raw_line);\n        let (field, value) = line\n            .split_once('\\t')\n            .ok_or_else(|| format!(\"malformed field on line {}\", line_number + 1))?;\n        if field.is_empty() || value.contains('\\t') {\n            return Err(format!(\"malformed field on line {}\", line_number + 1));\n        }\n        match field {\n            \"name\" => {\n                if name.is_some() {\n                    return Err(\"duplicate field 'name'\".to_string());\n                }\n                name = Some(value.to_string());\n            }\n            \"count\" => {\n                if count.is_some() {\n                    return Err(\"duplicate field 'count'\".to_string());\n                }\n                count = Some(\n                    value\n                        .parse::<i64>()\n                        .map_err(|_| format!(\"invalid count on line {}\", line_number + 1))?,\n                );\n            }\n            \"note\" => {\n                if note.is_some() {\n                    return Err(\"duplicate field 'note'\".to_string());\n                }\n                note = Some(value.to_string());\n            }\n            other => return Err(format!(\"unknown field '{}'\", other)),\n        }\n    }\n    Ok(Report {\n        count: count.ok_or_else(|| \"missing field 'count'\".to_string())?,\n        name: name.ok_or_else(|| \"missing field 'name'\".to_string())?,\n        note: note.ok_or_else(|| \"missing field 'note'\".to_string())?,\n    })\n}\n\nfn escape_json(value: &str) -> String {\n    let mut escaped = String::new();\n    for ch in value.chars() {\n        match ch {\n            '\"' => escaped.push_str(\"\\\\\\\"\"),\n            '\\\\' => escaped.push_str(\"\\\\\\\\\"),\n            '\\n' => escaped.push_str(\"\\\\n\"),\n            '\\r' => escaped.push_str(\"\\\\r\"),\n            '\\t' => escaped.push_str(\"\\\\t\"),\n            '\\u{08}' => escaped.push_str(\"\\\\b\"),\n            '\\u{0c}' => escaped.push_str(\"\\\\f\"),\n            ch if ch <= '\\u{1f}' => {\n                escaped.push_str(&format!(\"\\\\u{:04x}\", ch as u32));\n            }\n            ch => escaped.push(ch),\n        }\n    }\n    escaped\n}\n\nfn run() -> Result<String, String> {\n    let path = env::args()\n        .nth(1)\n        .ok_or_else(|| \"missing report.tsv path\".to_string())?;\n    let contents = fs::read_to_string(&path)\n        .map_err(|error| format!(\"cannot read '{}': {}\", path, error))?;\n    let report = parse_report(&contents)?;\n    Ok(format!(\n        \"{{\\\"count\\\":{},\\\"name\\\":\\\"{}\\\",\\\"note\\\":\\\"{}\\\"}}\\n\",\n        report.count,\n        escape_json(&report.name),\n        escape_json(&report.note)\n    ))\n}\n\nfn main() {\n    match run() {\n        Ok(output) => print!(\"{}\", output),\n        Err(error) => {\n            eprintln!(\"{}\", error);\n            process::exit(1);\n        }\n    }\n}\n",
