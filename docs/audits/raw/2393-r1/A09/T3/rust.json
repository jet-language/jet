  "source": "use std::env;\nuse std::fs;\nuse std::process;\n\nstruct Entry {\n    key: String,\n    value: String,\n}\n\nfn replay(data: &str) -> Result<Vec<Entry>, String> {\n    let mut state: Vec<Entry> = Vec::new();\n    for (line_number, raw_line) in data.lines().enumerate() {\n        let line = raw_line.strip_suffix('\\r').unwrap_or(raw_line);\n        if line.is_empty() {\n            return Err(format!(\"malformed record on line {}\", line_number + 1));\n        }\n        let fields: Vec<&str> = line.split('|').collect();\n        if fields.len() != 3 {\n            return Err(format!(\"malformed record on line {}\", line_number + 1));\n        }\n        let kind = fields[0];\n        let key = fields[1];\n        let value = fields[2];\n        if key.is_empty() {\n            return Err(format!(\"empty key on line {}\", line_number + 1));\n        }\n        match kind {\n            \"put\" => {\n                if let Some(entry) = state.iter_mut().find(|entry| entry.key == key) {\n                    entry.value = value.to_string();\n                } else {\n                    state.push(Entry {\n                        key: key.to_string(),\n                        value: value.to_string(),\n                    });\n                }\n            }\n            \"delete\" => {\n                if !value.is_empty() {\n                    return Err(format!(\"delete record must end with an empty field on line {}\", line_number + 1));\n                }\n                if let Some(index) = state.iter().position(|entry| entry.key == key) {\n                    state.remove(index);\n                }\n            }\n            other => return Err(format!(\"unknown record kind '{}' on line {}\", other, line_number + 1)),\n        }\n    }\n    Ok(state)\n}\n\nfn fail(message: impl AsRef<str>) -> ! {\n    eprintln!(\"{}\", message.as_ref());\n    process::exit(1);\n}\n\nfn main() {\n    let mut arguments = env::args();\n    arguments.next();\n    let path = arguments.next().unwrap_or_else(|| fail(\"missing journal.log path\"));\n    let data = fs::read_to_string(&path)\n        .unwrap_or_else(|error| fail(format!(\"cannot read '{}': {}\", path, error)));\n    let state = replay(&data).unwrap_or_else(|message| fail(message));\n    let mut output = String::new();\n    for entry in state {\n        output.push_str(&entry.key);\n        output.push('=');\n        output.push_str(&entry.value);\n        output.push('\\n');\n    }\n    print!(\"{}\", output);\n}\n",
