  "source": "use std::env;\nuse std::fs;\nuse std::process;\n\n#[derive(Clone)]\nstruct Section {\n    name: String,\n    fields: Vec<(String, String)>,\n    inherits: Option<String>,\n}\n\nfn parse_quoted(value: &str) -> Result<String, String> {\n    let chars: Vec<char> = value.chars().collect();\n    if chars.len() < 2 || chars[0] != '\"' || chars[chars.len() - 1] != '\"' {\n        return Err(\"field values must be quoted\".to_string());\n    }\n    let mut result = String::new();\n    let mut index = 1;\n    while index + 1 < chars.len() {\n        let ch = chars[index];\n        if ch == '\"' {\n            return Err(\"unexpected quote in field value\".to_string());\n        }\n        if ch == '\\\\' {\n            index += 1;\n            if index + 1 >= chars.len() {\n                return Err(\"unterminated escape in field value\".to_string());\n            }\n            let escaped = match chars[index] {\n                '\"' => '\"',\n                '\\\\' => '\\\\',\n                'n' => '\\n',\n                'r' => '\\r',\n                't' => '\\t',\n                '0' => '\\0',\n                other => return Err(format!(\"unsupported escape \\\\{}\", other)),\n            };\n            result.push(escaped);\n        } else {\n            result.push(ch);\n        }\n        index += 1;\n    }\n    Ok(result)\n}\n\nfn parse(data: &str) -> Result<Vec<Section>, String> {\n    let mut sections: Vec<Section> = Vec::new();\n    for (line_number, raw_line) in data.lines().enumerate() {\n        let line = raw_line.strip_suffix('\\r').unwrap_or(raw_line);\n        let trimmed = line.trim();\n        if trimmed.is_empty() {\n            continue;\n        }\n        if trimmed.starts_with('[') {\n            if !trimmed.ends_with(']') || trimmed.len() < 3 {\n                return Err(format!(\"malformed section header on line {}\", line_number + 1));\n            }\n            let name = trimmed[1..trimmed.len() - 1].trim();\n            if name.is_empty() || name.contains('[') || name.contains(']') {\n                return Err(format!(\"malformed section header on line {}\", line_number + 1));\n            }\n            if sections.iter().any(|section| section.name == name) {\n                return Err(format!(\"duplicate section '{}'\", name));\n            }\n            sections.push(Section {\n                name: name.to_string(),\n                fields: Vec::new(),\n                inherits: None,\n            });\n            continue;\n        }\n\n        let section = sections\n            .last_mut()\n            .ok_or_else(|| format!(\"field outside a section on line {}\", line_number + 1))?;\n        let (key, raw_value) = trimmed\n            .split_once('=')\n            .ok_or_else(|| format!(\"malformed field on line {}\", line_number + 1))?;\n        let key = key.trim();\n        let raw_value = raw_value.trim();\n        if key.is_empty() || key.contains(char::is_whitespace) {\n            return Err(format!(\"malformed field on line {}\", line_number + 1));\n        }\n        let value = parse_quoted(raw_value)\n            .map_err(|message| format!(\"{} on line {}\", message, line_number + 1))?;\n        if key == \"inherits\" {\n            if section.inherits.is_some() {\n                return Err(format!(\"duplicate field 'inherits' in section '{}'\", section.name));\n            }\n            section.inherits = Some(value);\n        } else {\n            if section.fields.iter().any(|(existing, _)| existing == key) {\n                return Err(format!(\"duplicate field '{}' in section '{}'\", key, section.name));\n            }\n            section.fields.push((key.to_string(), value));\n        }\n    }\n    if sections.is_empty() {\n        return Err(\"no sections found\".to_string());\n    }\n    Ok(sections)\n}\n\nfn resolve(index: usize, sections: &[Section]) -> Result<Vec<(String, String)>, String> {\n    let section = &sections[index];\n    let mut fields = Vec::new();\n    if let Some(parent_name) = &section.inherits {\n        let parent_index = sections\n            .iter()\n            .position(|candidate| candidate.name == *parent_name)\n            .ok_or_else(|| {\n                format!(\n                    \"section '{}' inherits unknown section '{}'\",\n                    section.name, parent_name\n                )\n            })?;\n        if sections[parent_index].inherits.is_some() {\n            return Err(format!(\n                \"section '{}' inherits through '{}' more than one level\",\n                section.name, parent_name\n            ));\n        }\n        fields.extend(sections[parent_index].fields.iter().cloned());\n    }\n    for (key, value) in &section.fields {\n        if let Some((_, existing_value)) = fields.iter_mut().find(|(existing_key, _)| existing_key == key) {\n            *existing_value = value.clone();\n        } else {\n            fields.push((key.clone(), value.clone()));\n        }\n    }\n    Ok(fields)\n}\n\nfn fail(message: impl AsRef<str>) -> ! {\n    eprintln!(\"{}\", message.as_ref());\n    process::exit(1);\n}\n\nfn main() {\n    let mut arguments = env::args();\n    arguments.next();\n    let path = arguments.next().unwrap_or_else(|| fail(\"missing records.cfg path\"));\n    let data = fs::read_to_string(&path)\n        .unwrap_or_else(|error| fail(format!(\"cannot read '{}': {}\", path, error)));\n    let sections = parse(&data).unwrap_or_else(|message| fail(message));\n    let mut output = String::new();\n    for index in 0..sections.len() {\n        let fields = resolve(index, &sections).unwrap_or_else(|message| fail(message));\n        for (key, value) in fields {\n            output.push_str(&sections[index].name);\n            output.push('.');\n            output.push_str(&key);\n            output.push('=');\n            output.push_str(&value);\n            output.push('\\n');\n        }\n    }\n    print!(\"{}\", output);\n}\n",
