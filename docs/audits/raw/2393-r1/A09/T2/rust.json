  "source": "use std::env;\nuse std::process;\n\n#[derive(Clone, Copy)]\nenum Format {\n    Text,\n    Json,\n}\n\nimpl Format {\n    fn name(self) -> &'static str {\n        match self {\n            Format::Text => \"text\",\n            Format::Json => \"json\",\n        }\n    }\n}\n\nenum Command {\n    List {\n        name: String,\n        format: Format,\n        dry_run: bool,\n    },\n    Inspect {\n        name: String,\n        format: Format,\n        dry_run: bool,\n    },\n    Remove {\n        name: String,\n        format: Format,\n        dry_run: bool,\n    },\n}\n\nfn parse<I>(mut arguments: I) -> Result<Command, String>\nwhere\n    I: Iterator<Item = String>,\n{\n    let operation = arguments.next().ok_or_else(|| \"missing command\".to_string())?;\n    let operation = match operation.as_str() {\n        \"list\" | \"ls\" => 0,\n        \"inspect\" => 1,\n        \"remove\" | \"rm\" => 2,\n        other => return Err(format!(\"unknown command '{}'\", other)),\n    };\n\n    let mut name: Option<String> = None;\n    let mut format = Format::Text;\n    let mut dry_run = false;\n    while let Some(argument) = arguments.next() {\n        match argument.as_str() {\n            \"--json\" => format = Format::Json,\n            \"--dry-run\" => dry_run = true,\n            \"--format\" => {\n                let value = arguments\n                    .next()\n                    .ok_or_else(|| \"missing value for --format\".to_string())?;\n                format = match value.as_str() {\n                    \"text\" => Format::Text,\n                    \"json\" => Format::Json,\n                    other => return Err(format!(\"invalid format '{}'\", other)),\n                };\n            }\n            option if option.starts_with('-') => {\n                return Err(format!(\"unknown option '{}'\", option));\n            }\n            value => {\n                if name.is_some() {\n                    return Err(\"multiple names supplied\".to_string());\n                }\n                name = Some(value.to_string());\n            }\n        }\n    }\n    let name = name.ok_or_else(|| \"missing name\".to_string())?;\n    Ok(match operation {\n        0 => Command::List {\n            name,\n            format,\n            dry_run,\n        },\n        1 => Command::Inspect {\n            name,\n            format,\n            dry_run,\n        },\n        _ => Command::Remove {\n            name,\n            format,\n            dry_run,\n        },\n    })\n}\n\nfn fail(message: impl AsRef<str>) -> ! {\n    eprintln!(\"{}\", message.as_ref());\n    process::exit(1);\n}\n\nfn main() {\n    let command = parse(env::args().skip(1)).unwrap_or_else(|message| fail(message));\n    let (operation, name, format, dry_run) = match command {\n        Command::List {\n            name,\n            format,\n            dry_run,\n        } => (\"list\", name, format, dry_run),\n        Command::Inspect {\n            name,\n            format,\n            dry_run,\n        } => (\"inspect\", name, format, dry_run),\n        Command::Remove {\n            name,\n            format,\n            dry_run,\n        } => (\"remove\", name, format, dry_run),\n    };\n    println!(\n        \"{} name={} format={} dry_run={}\",\n        operation,\n        name,\n        format.name(),\n        dry_run\n    );\n}\n",
