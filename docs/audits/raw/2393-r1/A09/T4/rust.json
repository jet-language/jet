  "source": "use std::env;\nuse std::fmt::Write as FmtWrite;\nuse std::fs;\nuse std::process;\n\nstruct Report {\n    count: u64,\n    name: String,\n    note: String,\n}\n\nfn parse(data: &str) -> Result<Report, String> {\n    let mut count: Option<u64> = None;\n    let mut name: Option<String> = None;\n    let mut note: Option<String> = None;\n    for (line_number, raw_line) in data.lines().enumerate() {\n        let line = raw_line.strip_suffix('\\r').unwrap_or(raw_line);\n        let (field, value) = line\n            .split_once('\\t')\n            .ok_or_else(|| format!(\"malformed field on line {}\", line_number + 1))?;\n        match field {\n            \"count\" => {\n                if count.is_some() {\n                    return Err(\"duplicate count field\".to_string());\n                }\n                count = Some(\n                    value\n                        .parse::<u64>()\n                        .map_err(|_| format!(\"invalid count on line {}\", line_number + 1))?,\n                );\n            }\n            \"name\" => {\n                if name.is_some() {\n                    return Err(\"duplicate name field\".to_string());\n                }\n                name = Some(value.to_string());\n            }\n            \"note\" => {\n                if note.is_some() {\n                    return Err(\"duplicate note field\".to_string());\n                }\n                note = Some(value.to_string());\n            }\n            other => return Err(format!(\"unknown field '{}'\", other)),\n        }\n    }\n    Ok(Report {\n        count: count.ok_or_else(|| \"missing count field\".to_string())?,\n        name: name.ok_or_else(|| \"missing name field\".to_string())?,\n        note: note.ok_or_else(|| \"missing note field\".to_string())?,\n    })\n}\n\nfn escape_json(value: &str) -> String {\n    let mut escaped = String::with_capacity(value.len());\n    for character in value.chars() {\n        match character {\n            '\"' => escaped.push_str(\"\\\\\\\"\"),\n            '\\\\' => escaped.push_str(\"\\\\\\\\\"),\n            '\\u{08}' => escaped.push_str(\"\\\\b\"),\n            '\\u{0c}' => escaped.push_str(\"\\\\f\"),\n            '\\n' => escaped.push_str(\"\\\\n\"),\n            '\\r' => escaped.push_str(\"\\\\r\"),\n            '\\t' => escaped.push_str(\"\\\\t\"),\n            character if character <= '\\u{1f}' => {\n                write!(&mut escaped, \"\\\\u{:04x}\", character as u32).unwrap();\n            }\n            character => escaped.push(character),\n        }\n    }\n    escaped\n}\n\nfn fail(message: impl AsRef<str>) -> ! {\n    eprintln!(\"{}\", message.as_ref());\n    process::exit(1);\n}\n\nfn main() {\n    let mut arguments = env::args();\n    arguments.next();\n    let path = arguments.next().unwrap_or_else(|| fail(\"missing report.tsv path\"));\n    let data = fs::read_to_string(&path)\n        .unwrap_or_else(|error| fail(format!(\"cannot read '{}': {}\", path, error)));\n    let report = parse(&data).unwrap_or_else(|message| fail(message));\n    let name = escape_json(&report.name);\n    let note = escape_json(&report.note);\n    println!(\n        \"{{\\\"count\\\":{},\\\"name\\\":\\\"{}\\\",\\\"note\\\":\\\"{}\\\"}}\",\n        report.count, name, note\n    );\n}\n",
