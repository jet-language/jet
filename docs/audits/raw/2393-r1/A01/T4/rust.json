  "source": "use std::env;\nuse std::fs;\nuse std::process;\n\nstruct Report {\n    count: i64,\n    name: String,\n    note: String,\n}\n\nfn parse_file(path: &str) -> Result<Report, String> {\n    let source = fs::read_to_string(path)\n        .map_err(|error| format!(\"cannot read '{}': {}\", path, error))?;\n    let mut count = None;\n    let mut name = None;\n    let mut note = None;\n\n    for (line_index, raw_line) in source.lines().enumerate() {\n        let line_number = line_index + 1;\n        let line = raw_line.trim_end_matches('\\r');\n        let (field, value) = line\n            .split_once('\\t')\n            .ok_or_else(|| format!(\"malformed field on line {}\", line_number))?;\n        if value.contains('\\t') || field.is_empty() {\n            return Err(format!(\"malformed field on line {}\", line_number));\n        }\n\n        match field {\n            \"count\" => {\n                if count.is_some() {\n                    return Err(\"duplicate field 'count'\".to_string());\n                }\n                count = Some(\n                    value\n                        .parse::<i64>()\n                        .map_err(|_| format!(\"invalid count on line {}\", line_number))?,\n                );\n            }\n            \"name\" => {\n                if name.is_some() {\n                    return Err(\"duplicate field 'name'\".to_string());\n                }\n                name = Some(value.to_string());\n            }\n            \"note\" => {\n                if note.is_some() {\n                    return Err(\"duplicate field 'note'\".to_string());\n                }\n                note = Some(value.to_string());\n            }\n            _ => return Err(format!(\"unknown field '{}' on line {}\", field, line_number)),\n        }\n    }\n\n    Ok(Report {\n        count: count.ok_or_else(|| \"missing field 'count'\".to_string())?,\n        name: name.ok_or_else(|| \"missing field 'name'\".to_string())?,\n        note: note.ok_or_else(|| \"missing field 'note'\".to_string())?,\n    })\n}\n\nfn escape_json(value: &str) -> String {\n    const HEX: &[u8; 16] = b\"0123456789abcdef\";\n    let mut escaped = String::new();\n    for character in value.chars() {\n        match character {\n            '\"' => escaped.push_str(\"\\\\\\\"\"),\n            '\\\\' => escaped.push_str(\"\\\\\\\\\"),\n            '\\u{08}' => escaped.push_str(\"\\\\b\"),\n            '\\u{0c}' => escaped.push_str(\"\\\\f\"),\n            '\\n' => escaped.push_str(\"\\\\n\"),\n            '\\r' => escaped.push_str(\"\\\\r\"),\n            '\\t' => escaped.push_str(\"\\\\t\"),\n            character if (character as u32) < 0x20 => {\n                let code = character as u32;\n                escaped.push_str(\"\\\\u00\");\n                escaped.push(HEX[(code >> 4) as usize] as char);\n                escaped.push(HEX[(code & 0x0f) as usize] as char);\n            }\n            character => escaped.push(character),\n        }\n    }\n    escaped\n}\n\nfn run(path: &str) -> Result<String, String> {\n    let report = parse_file(path)?;\n    Ok(format!(\n        \"{{\\\"count\\\":{},\\\"name\\\":\\\"{}\\\",\\\"note\\\":\\\"{}\\\"}}\\n\",\n        report.count,\n        escape_json(&report.name),\n        escape_json(&report.note)\n    ))\n}\n\nfn main() {\n    let mut arguments = env::args();\n    let _program = arguments.next();\n    let path = match arguments.next() {\n        Some(path) => path,\n        None => {\n            eprintln!(\"missing report.tsv path\");\n            process::exit(1);\n        }\n    };\n\n    match run(&path) {\n        Ok(output) => print!(\"{}\", output),\n        Err(error) => {\n            eprintln!(\"{}\", error);\n            process::exit(1);\n        }\n    }\n}\n",
