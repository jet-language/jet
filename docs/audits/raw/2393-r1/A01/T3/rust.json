  "source": "use std::collections::HashMap;\nuse std::env;\nuse std::fs;\nuse std::process;\n\nfn run(path: &str) -> Result<String, String> {\n    let source = fs::read_to_string(path)\n        .map_err(|error| format!(\"cannot read '{}': {}\", path, error))?;\n    let mut order = Vec::new();\n    let mut values = HashMap::new();\n\n    for (line_index, raw_line) in source.lines().enumerate() {\n        let line_number = line_index + 1;\n        let line = raw_line.trim_end_matches('\\r');\n        let parts: Vec<&str> = line.split('|').collect();\n        if parts.len() != 3 {\n            return Err(format!(\"malformed record on line {}\", line_number));\n        }\n\n        match parts[0] {\n            \"put\" => {\n                if parts[1].is_empty() {\n                    return Err(format!(\"empty key on line {}\", line_number));\n                }\n                if !values.contains_key(parts[1]) {\n                    order.push(parts[1].to_string());\n                }\n                values.insert(parts[1].to_string(), parts[2].to_string());\n            }\n            \"delete\" => {\n                if parts[1].is_empty() || !parts[2].is_empty() {\n                    return Err(format!(\"malformed delete record on line {}\", line_number));\n                }\n                if values.remove(parts[1]).is_some() {\n                    order.retain(|key: &String| key != parts[1]);\n                }\n            }\n            kind => return Err(format!(\"unknown record kind '{}' on line {}\", kind, line_number)),\n        }\n    }\n\n    let mut output = String::new();\n    for key in order {\n        if let Some(value) = values.get(&key) {\n            output.push_str(&key);\n            output.push('=');\n            output.push_str(value);\n            output.push('\\n');\n        }\n    }\n    Ok(output)\n}\n\nfn main() {\n    let mut arguments = env::args();\n    let _program = arguments.next();\n    let path = match arguments.next() {\n        Some(path) => path,\n        None => {\n            eprintln!(\"missing journal.log path\");\n            process::exit(1);\n        }\n    };\n\n    match run(&path) {\n        Ok(output) => print!(\"{}\", output),\n        Err(error) => {\n            eprintln!(\"{}\", error);\n            process::exit(1);\n        }\n    }\n}\n",
