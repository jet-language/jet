  "source": "use std::env;\nuse std::process;\n\nenum Format {\n    Text,\n    Json,\n}\n\nimpl Format {\n    fn as_str(&self) -> &'static str {\n        match self {\n            Format::Text => \"text\",\n            Format::Json => \"json\",\n        }\n    }\n}\n\nenum Operation {\n    List,\n    Inspect,\n    Remove,\n}\n\nstruct Options {\n    name: String,\n    format: Format,\n    dry_run: bool,\n}\n\nenum Command {\n    List(Options),\n    Inspect(Options),\n    Remove(Options),\n}\n\nfn fail(message: impl AsRef<str>) -> ! {\n    eprintln!(\"{}\", message.as_ref());\n    process::exit(1);\n}\n\nfn main() {\n    let mut arguments = env::args();\n    arguments.next();\n\n    let mut positionals: Vec<String> = Vec::new();\n    let mut format = Format::Text;\n    let mut dry_run = false;\n\n    while let Some(argument) = arguments.next() {\n        match argument.as_str() {\n            \"list\" | \"ls\" | \"inspect\" | \"remove\" | \"rm\" => {\n                positionals.push(argument);\n            }\n            \"--json\" => {\n                format = Format::Json;\n            }\n            \"--format\" => {\n                let value = match arguments.next() {\n                    Some(value) => value,\n                    None => fail(\"missing value for --format\"),\n                };\n                format = match value.as_str() {\n                    \"text\" => Format::Text,\n                    \"json\" => Format::Json,\n                    _ => fail(format!(\"invalid format {:?}\", value)),\n                };\n            }\n            \"--dry-run\" => {\n                dry_run = true;\n            }\n            value if value.starts_with('-') => {\n                fail(format!(\"unknown option {:?}\", value));\n            }\n            value => {\n                positionals.push(value.to_owned());\n            }\n        }\n    }\n\n    if positionals.len() > 2 {\n        fail(\"unexpected positional argument\");\n    }\n    let operation = match positionals.first().map(String::as_str) {\n        Some(\"list\") | Some(\"ls\") => Operation::List,\n        Some(\"inspect\") => Operation::Inspect,\n        Some(\"remove\") | Some(\"rm\") => Operation::Remove,\n        Some(command) => fail(format!(\"unknown command {:?}\", command)),\n        None => fail(\"missing command\"),\n    };\n    let options = Options {\n        name: positionals\n            .get(1)\n            .cloned()\n            .unwrap_or_else(|| fail(\"missing name\")),\n        format,\n        dry_run,\n    };\n    let command = match operation {\n        Operation::List => Command::List(options),\n        Operation::Inspect => Command::Inspect(options),\n        Operation::Remove => Command::Remove(options),\n    };\n\n    match command {\n        Command::List(options) => print_command(\"list\", options),\n        Command::Inspect(options) => print_command(\"inspect\", options),\n        Command::Remove(options) => print_command(\"remove\", options),\n    }\n}\n\nfn print_command(operation: &str, options: Options) {\n    println!(\n        \"{} name={} format={} dry_run={}\",\n        operation,\n        options.name,\n        options.format.as_str(),\n        options.dry_run\n    );\n}\n",
