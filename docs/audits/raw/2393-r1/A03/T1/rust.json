  "source": "use std::env;\nuse std::fs;\nuse std::process;\n\n#[derive(Clone)]\nstruct Field {\n    key: String,\n    value: String,\n}\n\nstruct Section {\n    name: String,\n    inherits: Option<String>,\n    fields: Vec<Field>,\n}\n\nfn fail(message: impl AsRef<str>) -> ! {\n    eprintln!(\"{}\", message.as_ref());\n    process::exit(1);\n}\n\nfn parse_quoted(raw: &str, line_number: usize) -> String {\n    let value = raw.trim();\n    if !value.starts_with('\"') {\n        fail(format!(\"expected quoted value on line {}\", line_number));\n    }\n\n    let mut parsed = String::new();\n    let mut characters = value[1..].chars();\n    loop {\n        match characters.next() {\n            Some('\"') => {\n                if characters.any(|character| !character.is_whitespace()) {\n                    fail(format!(\"trailing data on line {}\", line_number));\n                }\n                return parsed;\n            }\n            Some('\\\\') => match characters.next() {\n                Some('\"') => parsed.push('\"'),\n                Some('\\\\') => parsed.push('\\\\'),\n                Some('n') => parsed.push('\\n'),\n                Some('r') => parsed.push('\\r'),\n                Some('t') => parsed.push('\\t'),\n                Some(escaped) => fail(format!(\n                    \"unsupported escape {:?} on line {}\",\n                    escaped, line_number\n                )),\n                None => fail(format!(\"unterminated escape on line {}\", line_number)),\n            },\n            Some(character) => parsed.push(character),\n            None => fail(format!(\"unterminated quoted value on line {}\", line_number)),\n        }\n    }\n}\n\nfn main() {\n    let mut arguments = env::args();\n    arguments.next();\n    let path = match arguments.next() {\n        Some(path) => path,\n        None => fail(\"missing input path\"),\n    };\n    if arguments.next().is_some() {\n        fail(\"unexpected extra argument\");\n    }\n\n    let input = match fs::read_to_string(&path) {\n        Ok(input) => input,\n        Err(error) => fail(format!(\"cannot read {}: {}\", path, error)),\n    };\n\n    let mut sections: Vec<Section> = Vec::new();\n    let mut current: Option<usize> = None;\n\n    for (index, line) in input.lines().enumerate() {\n        let line_number = index + 1;\n        let trimmed = line.trim();\n        if trimmed.is_empty() {\n            continue;\n        }\n\n        if trimmed.starts_with('[') {\n            if !trimmed.ends_with(']') || trimmed.len() < 3 {\n                fail(format!(\"malformed section header on line {}\", line_number));\n            }\n            let name = trimmed[1..trimmed.len() - 1].trim();\n            if name.is_empty() {\n                fail(format!(\"empty section name on line {}\", line_number));\n            }\n            if sections.iter().any(|section| section.name == name) {\n                fail(format!(\"duplicate section {:?}\", name));\n            }\n            sections.push(Section {\n                name: name.to_owned(),\n                inherits: None,\n                fields: Vec::new(),\n            });\n            current = Some(sections.len() - 1);\n            continue;\n        }\n\n        let section_index = current\n            .unwrap_or_else(|| fail(format!(\"field before section on line {}\", line_number)));\n        let (key, raw_value) = match trimmed.split_once('=') {\n            Some(parts) => parts,\n            None => fail(format!(\"malformed field on line {}\", line_number)),\n        };\n        let key = key.trim();\n        if key.is_empty() {\n            fail(format!(\"empty field name on line {}\", line_number));\n        }\n        let value = parse_quoted(raw_value, line_number);\n        let section = &mut sections[section_index];\n\n        if key == \"inherits\" {\n            if section.inherits.is_some() {\n                fail(format!(\n                    \"duplicate field {:?} in section {:?}\",\n                    key, section.name\n                ));\n            }\n            section.inherits = Some(value);\n        } else {\n            if section.fields.iter().any(|field| field.key == key) {\n                fail(format!(\n                    \"duplicate field {:?} in section {:?}\",\n                    key, section.name\n                ));\n            }\n            section.fields.push(Field {\n                key: key.to_owned(),\n                value,\n            });\n        }\n    }\n\n    let mut output = String::new();\n    for section_index in 0..sections.len() {\n        let section_name = sections[section_index].name.clone();\n        let parent_name = sections[section_index].inherits.clone();\n        let mut resolved = match parent_name {\n            Some(parent_name) => {\n                let parent_index = sections\n                    .iter()\n                    .position(|section| section.name == parent_name)\n                    .unwrap_or_else(|| {\n                        fail(format!(\n                            \"unknown inherited section {:?} for {:?}\",\n                            parent_name, section_name\n                        ))\n                    });\n                if sections[parent_index].inherits.is_some() {\n                    fail(format!(\n                        \"section {:?} inherits through {:?}\",\n                        section_name, parent_name\n                    ));\n                }\n                sections[parent_index].fields.clone()\n            }\n            None => Vec::new(),\n        };\n\n        for field in &sections[section_index].fields {\n            if let Some(existing) = resolved.iter_mut().find(|item| item.key == field.key) {\n                existing.value = field.value.clone();\n            } else {\n                resolved.push(field.clone());\n            }\n        }\n\n        for field in resolved {\n            output.push_str(&section_name);\n            output.push('.');\n            output.push_str(&field.key);\n            output.push('=');\n            output.push_str(&field.value);\n            output.push('\\n');\n        }\n    }\n\n    print!(\"{}\", output);\n}\n",
