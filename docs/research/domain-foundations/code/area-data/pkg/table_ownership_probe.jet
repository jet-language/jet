use core.data as data
use core.files as files

#Codable
struct Row { team: String value: Float }

fn run() {
    raw :: files.read("/home/nate/.cache/jet-luna/dx3/area-data/fixture-100k.csv") ?? panic("read")
    rows :: data.csv<Row>(raw) ?? panic("csv")
    table :: data.table(rows)
    print("table={data.count(table)} rows={rows.len()} schema={data.schema(table).len()}")
}
