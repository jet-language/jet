use core.data as data
use core.files as files

#Codable
struct Observation {
    team: String
    segment: String
    x: Float
    y: Float
    value: Float
}

fn run() {
    raw :: files.read("/home/nate/.cache/jet-luna/dx3/area-data/fixture-100k.csv") ?? panic("read")
    rows :: data.csv<Observation>(raw) ?? panic("csv")
    table :: data.table(rows)
    print("rows={data.count(table)} columns={data.schema(table).len()}")
}
