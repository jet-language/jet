use core.data as data

#Codable
struct Row {
    team: String
    value: Float
}

fn run() {
    rows :: data.csv<Row>("team,value\nA,1.0\nB,2.0\nA,3.0") ?? panic("csv")
    groups :: data.group_mean(rows, r -> r.team, r -> r.value) ?? panic("group")
    print("rows={data.count(rows)} groups={data.count(groups)}")
}
