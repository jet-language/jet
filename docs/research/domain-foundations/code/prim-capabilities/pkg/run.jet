use core.files as fs
use core.plugin as plugin
use "service" as service

fn run() {
    root :: "/home/nate/.cache/jet-luna/dx3/prim-capabilities/pkg/plugin_src"
    input :: "/home/nate/.cache/jet-luna/dx3/prim-capabilities/inputs/allowed.txt"
    outside :: "/home/nate/.cache/jet-luna/dx3/prim-capabilities/inputs-outside.txt"
    wasm :: "{root}/build/run.wasm"
    malformed :: "{root}/hostile.wasm"
    root_policy :: Authority.from_rights(["FS.Read:{root}"])
    build_policy :: root_policy.with("FS.Read:{root}/build")
    #FX(FS, IO, Exec) {
        text :: fs.read(input) ?? {
            print("file:read-failed")
            return
        }
        print("file:inside={text.trim()}")

        guest :: plugin.load(wasm, build_policy)
        greeting :: guest.call_text("greet", ["Ada"]) ?? {
            print("plugin:load-failed")
            return
        }
        print("plugin:greeting={greeting}")
        scaled :: guest.call("scale", [6.0, 7.0]) ?? {
            print("plugin:scale-failed")
            return
        }
        print("plugin:scale={scaled}")

        invalid :: plugin.load(malformed, root_policy)
        _invalid_result :: invalid.call_text("greet", ["Ada"]) ?? {
            print("plugin:malformed-rejected {err}")
            "rejected"
        }

        outside_plugin :: plugin.load(outside, root_policy)
        _outside_result :: outside_plugin.call_text("greet", ["Ada"]) ?? {
            print("plugin:outside-rejected {err}")
            "rejected"
        }

        service.lifecycle()
    }
}
