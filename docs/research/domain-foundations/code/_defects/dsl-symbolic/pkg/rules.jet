pub enum RuleCondition {
    AtLeast(Int)
    Equals(Int)
}

pub enum RuleAction {
    Add(Int)
    Set(Int)
}

pub struct Rule {
    name: String
    fact: String
    condition: RuleCondition
    action: RuleAction
}

fn matches(condition: RuleCondition, value: Int) Bool -> {
    if condition == {
        .AtLeast(limit) -> value >= limit
        .Equals(target) -> value == target
    }
}

fn apply(action: RuleAction, facts: &[String:Int], key: String) String -> {
    if action == {
        .Add(delta) -> {
            next :: (facts.get(~key) ?? 0) + delta
            facts[key] = next
            return "{key}={next}"
        }
        .Set(next) -> {
            facts[key] = next
            return "{key}={next}"
        }
    }
}

pub fn fire(facts: &[String:Int], rules: [Rule]) [String] -> {
    events := [String]{}
    loop rule in rules {
        value :: facts.get(~rule.fact) ?? 0
        if !matches(~rule.condition, value) -> events.push("{rule.name}:skip")
        else -> events.push("{rule.name}:{apply(~rule.action, &facts, ~rule.fact)}")
    }
    return events
}

pub fn sample() [String] -> {
    facts := [String:Int]{"score": 7}
    rules :: [Rule]{
        Rule{ name: "bonus", fact: "score", condition: RuleCondition.AtLeast(5), action: RuleAction.Add(3) },
        Rule{ name: "cap", fact: "score", condition: RuleCondition.AtLeast(20), action: RuleAction.Set(20) },
        Rule{ name: "award", fact: "score", condition: RuleCondition.Equals(10), action: RuleAction.Add(1) }
    }
    return fire(&facts, rules)
}
