module symbolic;

fn run() {
    x :: symbolic.variable("x")
    two :: symbolic.constant(2.0)
    expr :: symbolic.add(symbolic.mul(~two, ~x), symbolic.constant(0.0))
    simplified :: symbolic.simplify(~expr)
    deriv :: symbolic.derivative(~simplified, "x")
    print("expr={symbolic.show(~expr)}")
    print("simplified={symbolic.show(~simplified)}")
    print("derivative={symbolic.show(~deriv)}")
}
