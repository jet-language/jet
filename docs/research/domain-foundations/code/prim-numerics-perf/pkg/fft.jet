use core.math as math
use core.time as time

struct FFTBuffers {
    re: [Float]
    im: [Float]
}

fn fft_radix2(re0: ^[Float], im0: ^[Float], n: Int) FFTBuffers -> {
    re := re0
    im := im0

    // In-place bit-reversal permutation.
    j := 0
    i := 1
    loop i < n {
        bit := n /% 2
        loop bit > 0 {
            if j >= bit {
                j -= bit
                bit /%= 2
            } else {
                break
            }
        }
        j += bit
        if i < j {
            tmp_re :: ~re[i]
            re[i] = re[j]
            re[j] = tmp_re
            tmp_im :: ~im[i]
            im[i] = im[j]
            im[j] = tmp_im
        }
        i += 1
    }

    // Cooley-Tukey radix-2 butterflies. The literal is used because the
    // current evaluator/codegen does not lower core.math.pi in a function.
    length := 2
    half_f := Float{1.0}
    loop length <= n {
        half := length /% 2
        angle :: -Float{3.141592653589793} / half_f
        step_re :: math.cos(angle)
        step_im :: math.sin(angle)
        w_re := Float{1.0}
        w_im := Float{0.0}
        j = 0
        loop j < half {
            i = j
            loop i < n {
                k := i + half
                odd_re :: ~re[k]
                odd_im :: ~im[k]
                t_re :: w_re * odd_re - w_im * odd_im
                t_im :: w_re * odd_im + w_im * odd_re
                even_re :: ~re[i]
                even_im :: ~im[i]
                re[i] = even_re + t_re
                im[i] = even_im + t_im
                re[k] = even_re - t_re
                im[k] = even_im - t_im
                i += length
            }
            next_re :: w_re * step_re - w_im * step_im
            next_im :: w_re * step_im + w_im * step_re
            w_re = next_re
            w_im = next_im
            j += 1
        }
        length *= 2
        half_f *= Float{2.0}
    }

    return FFTBuffers{re: re, im: im}
}

fn make_impulse(n: Int) FFTBuffers -> {
    re := [Float]{}
    im := [Float]{}
    loop i in 0..<n {
        if i == 0 {
            re.push(Float{1.0})
        } else {
            re.push(Float{0.0})
        }
        im.push(Float{0.0})
    }
    return FFTBuffers{re: re, im: im}
}

fn check_fft(out: FFTBuffers, n: Int) Float -> {
    sum_re := Float{0.0}
    sum_abs_im := Float{0.0}
    zero :: Float{0.0}
    loop i in 0..<n {
        sum_re += out.re[i]
        if out.im[i] < zero {
            sum_abs_im -= out.im[i]
        } else {
            sum_abs_im += out.im[i]
        }
    }
    return sum_re + sum_abs_im
}

fn bench(n: Int) {
    input :: make_impulse(n)
    started :: time.instant()
    output :: fft_radix2(~input.re, ~input.im, n)
    finished :: time.instant()
    duration :: finished - started
    elapsed :: duration.in(.Nanoseconds)
    checksum :: check_fft(output, n)
    print("fft_n:{n} ns:{elapsed} checksum:{checksum} first:{output.re[0]} last:{output.re[n - 1]} max_im_abs:{output.im[0]}") 
}

fn run() {
    bench(4096)
    bench(65536)
}
