use core.ui as ui
use core.reactive as reactive

fn run() {
    body := reactive.signal("old")
    backend := ui.tui_backend()
    render_backend :: ~backend
    ui.reactive_render(() -> {
        ui.mount(render_backend, ui.box([
            ui.node_role(body.get(), 30.0, 3.0, ui.aria_role_text_input()),
            ui.button("Save", on_click: () -> { print("save") })
        ]))
    })
    backend.set_focus_group([
        ui.node_role("Save", 10.0, 1.0, ui.aria_role_button()),
        ui.node_role("Editor", 30.0, 3.0, ui.aria_role_text_input())
    ])
    print("focus: {backend.focused_label()}")
    _event :: backend.on_event(ui.key_event("Tab"))
    print("focus after: {backend.focused_label()}")
    body.set("new")
    print("renders: {backend.render_count()}")
}
