pub struct Meter {
    value: Float
}
pub fn meter(value: Float) Meter -> Meter{ value: value }
pub fn checked_add(left: Meter, right: Meter) Meter !Err -> {
    sum :: left.value + right.value
    if !sum.is_finite() -> return Err("meter sum is not finite")
    return Ok(Meter{ value: sum })
}
fn run() {
    position :: checked_add(meter(1.0), meter(2.0)) ?? panic("sum failed")
    print("{position.value}")
}
