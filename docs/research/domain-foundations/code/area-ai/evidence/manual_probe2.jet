use core.compute as compute
fn run() {
    x :: compute.eye(2) ?? panic("x")
    t :: compute.eye(2) ?? panic("t")
    w :: compute.eye(2) ?? panic("w")
    h :: compute.matmul(x, w) ?? panic("h")
    r :: compute.sub(h, t) ?? panic("r")
    ht :: compute.transpose(h) ?? panic("ht")
    g :: compute.matmul(ht, r) ?? panic("g")
    print("h={compute.to_list(h)} r={compute.to_list(r)} g={compute.to_list(g)}")
}
