struct Meter { value: Float }
struct Second { value: Float }
struct Speed { value: Float }

impl Meter.Add {
    fn add(self, rhs: Meter) Meter -> Meter{ value: self.value + rhs.value }
}

impl Meter.Div {
    fn div(self, rhs: Second) Speed -> Speed{ value: self.value / rhs.value }
}

fn run() {
    a :: Meter{ value: 1.0 }
    b :: Meter{ value: 2.0 }
    t :: Second{ value: 0.5 }
    print((a + b).value)
    print((a / t).value)
}
