#Codable
struct RegressionEvidence {
    slope: Float
    intercept: Float
    residuals: [Float]
    tolerance: Float
    max_residual: Float
    passed: Bool
}

fn run() {
    slope :: Float{2.0666666666666664}
    intercept :: Float{0.43333333333333357}
    residuals :: [Float]{Float{0.0}, Float{-0.2666666666666666}, Float{-0.5333333333333332}, Float{0.0}}
    tolerance :: Float{0.25}
    max_residual :: Float{0.5333333333333332}
    passed :: max_residual <= tolerance
    evidence :: RegressionEvidence{
        slope,
        intercept,
        residuals,
        tolerance,
        max_residual,
        passed
    }
    print("slope:{evidence.slope}")
    print("intercept:{evidence.intercept}")
    print("residuals:{evidence.residuals}")
    print("tolerance:{evidence.tolerance}")
    print("max_residual:{evidence.max_residual}")
    print("passed:{evidence.passed}")
}
