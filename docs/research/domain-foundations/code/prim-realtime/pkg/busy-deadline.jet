package {
    name: "prim-realtime-busy-deadline"
    version: "0.1.0"
    authority: { holds: { allow: [IO, Time, Mem.Alloc] } }
}

use core.time as time

fn run() {
    #Context(deadline: time.now() + 5) {
        total := 0
        loop i in 0..<10000000 {
            total += i
        }
        print("cpu-finished={total}")
    }
    print("context-returned")
}
