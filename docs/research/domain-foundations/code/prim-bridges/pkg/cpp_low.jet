#Import module c.jet_cpp_reader {
    fn take_error() Int = "jet_cpp_reader_take_error"
    fn reader_new() Int = "jet_cpp_reader_reader_new"
    fn reader_close(handle: Int) = "jet_cpp_reader_reader_close"
    fn reader_next_line_length(handle: Int) Int = "jet_cpp_reader_reader_next_line_length"
}
use c.jet_cpp_reader as c

fn run() {
    handle := c.reader_new()
    print(c.reader_next_line_length(handle))
    print(c.reader_next_line_length(handle))
    c.reader_close(handle)
}
