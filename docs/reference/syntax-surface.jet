// syntax-surface.jet — the aspirational syntax reference.
//
// NON-EXECUTABLE. This file does NOT compile and is NOT golden-tested. It
// exists so the owner can eyeball the whole ratified syntax surface in one
// place. It is a survey, not a program.
//
// Two sources of truth back every line here:
//   examples/canon.jet            — the COMPILING showcase. Anything there is
//                                   ratified AND implemented (golden-tested).
//   docs/spec/syntax-decisions.md — the ratified decision record; each feature
//                                   below cites its real decision ID + rationale.
//
// Marking convention:
//   // ...   ordinary explanatory comment (canon.jet house style)
//   # RATIFIED, NOT YET IMPLEMENTED (<id>)
//           appears immediately above any feature that is ratified in
//           syntax-decisions.md but has no shipped evidence (not in canon.jet,
//           no golden example, no parser/sema support). Verify before relying.
//
// `#`/`@` in the actual code below (e.g. `@Pure`, `@Unsafe`, `@[Codable]`,
// `[T#N]`) is REAL Jet syntax — two marker planes (D-MARKER-FAMILY1): `@`
// states a checkable contract about the declaration below it (`@Pure`,
// `@MustUse`, `@Codable`); `#` is a compiler directive and may appear in
// type/expression position (`@Unsafe`, `[T#N]`). Neither is a comment.
// Only a full line beginning `# RATIFIED…` is a not-yet-implemented marker.
//
// Implemented features are written as live code. Ratified-but-UNIMPLEMENTED
// examples are COMMENTED OUT (every code line prefixed `// `) so they never
// read as working syntax — they sit under their `# RATIFIED…` marker.
//
// OWNER MARKUP (flag a change you want; an agent harvests the marks later):
//   //<<< Owner <area>: <what's wrong>
//   // HAVE:
//   <current spelling — live code lines>
//   // WANT:
//   <spelling you want — live code lines>
//   //>>>
//   //!! Owner: <note>            inline form, for a one-line tweak
//   list every open mark:  rg '//<<<|//!!' docs/reference/syntax-surface.jet
// Marking is not deciding — each WANT is now a Tower v2 decision card; a
// `//>>> tracked: #N D-ID` tag on a closer means it's already balloted.


// ============================================================================
// VALUES, BINDINGS & TYPES
// ============================================================================
// `::` binds immutable (D-BIND4); `:=` binds mutable; `=` reassigns a `:=`
// binding (S17). Optional type annotation before the sigil (S4).

//<<< Owner Bindings: Incorrect explicit binding syntax.
// HAVE:
nameImmut: String :: "Jet" // Immutable binding with explicit type annotation.
nameMut: String := "Jet" // Mutable binding with explicit type annotation.
// WANT:
nameImmut: String :: "Jet" // Immutable binding with explicit type annotation.
nameMut: String := "Jet" // Mutable binding with explicit type annotation.
//>>> tracked: #29 D-BINDEXPLICIT1

fn values() {
name: String :: "Jet"          // annotated immutable (S4 + D-BIND2)
    year :: 2026                   // inferred Int (S11/S42)
    version :: 0.1                 // inferred Float; always prints with `.0` (S21)
ready: Bool :: true            // Bool (S11)

    count := 0                     // mutable (D-BIND1)
    count = count + 3              // reassign (S17)

    // string interpolation — expressions inside `{ }` (S8); double braces escape
    print("v{version} {{literal braces}} ready={ready}")
}

// Built-in scalar types (S11): Int, Float, Bool, String, Char (S41).
// Default numerics are Int (i64) / Float (f64) (S42).
// Sized expert/FFI menu (S42, D-SG9): I8 I16 I32 I64 U8 U16 U32 U64 F32 F64.
fn sized() {
small: U8 :: 255
wide: I64 :: 9_000_000_000      // `_` digit separators (S67)
    mask :: 0xDEAD_BEEF             // hex; also 0o.. octal, 0b.. binary (S67)
    big :: 6.022e23                 // float exponent (S67)
    // conversions are named methods only — no `as`, no C casts (S42, D-SG9)
    f :: small.to_float()
    n :: f.to_int()
}

// # RATIFIED, NOT YET IMPLEMENTED (D-NUMOPS1)
// Integer arithmetic traps on overflow by default; experts opt a single op into
// wrapping/saturating/checked, visible at the use site.
