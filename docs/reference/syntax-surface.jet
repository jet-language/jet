// ============================================================================
// TRAITS, GENERICS & DISPATCH
// ============================================================================
// Named capabilities, not Go-structural (S28). Two equivalent impl spellings.

trait Shape2 {
    fn area(self) -> Float
}

struct Square { side: Float }

impl Square.Shape2 {                          // top-level impl (S28)
    fn area(self) -> Float { return self.side * self.side }
}

// Trait name in type position => dynamic dispatch; `<T: Trait>` => monomorphize (S48).
fn total_area(shapes: [Shape2]) -> Float {     // boxed dynamic dispatch
    // ...
}

// Trait delegation: forward one trait to one field (S62).
//<<< Owner Trait Forwarding: Update trait forwarding syntax
// HAVE:
impl App.Logger using logger
// WANT:
impl App.Logger using logger
//>>> tracked: #33 D-IMPLDOT1

// Built-in derives (S55): auto Printable/Equatable; opt-in Comparable/Codable.
// D-SHAPE2: built-in derives are applied rules in the one `@[…]` list.
@[Comparable, Codable]
struct Score {
    value: Int
}

// # RATIFIED, NOT YET IMPLEMENTED (S56)
// User-defined derives against the serde data model (Epoch 3; S56/S26 Layer 3).
// @[MyTrait]
// struct Custom { x: Int }


// ============================================================================
// COLLECTIONS & STRINGS
// ============================================================================
// List `[a, b, c]` (S37); map `["k": v]` (S38). Type shorthands `[T]` / `[K: V]`.

fn collections() {
     nums: [Int]  := [3, 1, 2]                    // list type shorthand (S65)
    nums.push(4)
    nums.sort()

    // empty literals infer element type from context (S78); else annotate
     seen: [Int]  := []                           // (S78 / explicit)

     fruits: [String: Float]  := ["limes": 4.2]   // map shorthand (S64)
    fruits["pears"] = 9.9                        // insert (S39)
    got :: fruits.get("limes")                  // safe access -> V? (S39)

    // map entry iteration yields a named entry value (S66)
    loop e in fruits {
        print("{e.key}: {e.value}")
    }

    // indexing & inclusive, copying slices (S39/S40)
    first :: nums[0]
    head :: nums[0..1]

    // lazy iterator adapters on the blessed iterator protocol (D-ITER1 / D-EXT1)
    out :: nums.enumerate().zip(seen).take(2).map((p) => p.value)
}

// Fixed-size list type `[T#N]` — `#` introduces a pinned count (S76/D-FIXARR1).
fn fixed() -> [Int#3] {
    return [1, 2, 3]                            // `.len` is a compile-time const
}

fn strings() {
    parts :: "a,b,c".split(",")
    trimmed :: "  hi  ".trim()
    loop c in "héllo".chars() { }              // Char iteration; no s[i] (S41)
    block :: """
        multi-line string
        with {trimmed} interpolation
        """                                     // triple-quoted (S70)
}


// ============================================================================
// CLOSURES
// ============================================================================
// `(params) => expr` or `(params) => { ... }` (S46). `=>` lambda, `->` returns.

fn closures() {
    nums :: [3, 1, 2]
    squares :: nums.map((n: Int) => n * n)
    big :: squares.filter((n: Int) => n > 5)
    total :: nums.reduce(0, (acc: Int, n: Int) => acc + n)

    // escaping closures must own captures; explicit `take(name)` when needed (S47)
    make :: take(total) () => total
}

// Function types: `fn(T1, T2) -> R` (S47). Named fns coerce to function values.
fn apply(f: fn(Int) -> Int, x: Int) -> Int {
    return f(x)
}

// Fan-out (S75): `f.[a, b, c]` == `[f(a), f(b), f(c)]`; result is `[T#N]` (S76).
fn fanout() {
    tripled :: triple.[1, 2, 3]
    [t0, t1, t2] :: tripled
}


// ============================================================================
// MODULES & IMPORTS
// ============================================================================
// `use "path"` = file; `use name` = module (S16). Core stdlib is `core.*` (S51).

use "./lib"                          // file path -> namespace lib
use "grades/scoring" as g            // file path, aliased
use core.files as fs                 // core submodule (S51)
use core.encoding.json as json       // unified encoding library (D-ENC1)
use core.tasks as tasks              // see async/tasks below
use core.regex as re                  // std-only linear regex (D-REGEXENGINE1)

// Inline module; `pub` controls cross-file access (S18).
module math {
    pub fn double(n: Int) -> Int { return n * 2 }
}

// Kebab-case allowed in name positions only (package/module/system/image/env) (S84).
module web-app { }


// ============================================================================
// EFFECTS  (@Pure / #(Io))
// ============================================================================
// Every fn carries an inferred, erased effect set; a `#(…)` list bounds it (D-EFF1).
// Effect tags are PascalCase (D-CASING1). Effects flow through calls (D-EFF2).
// `@Pure` is a contract marker (D-MARKER-FAMILY1/D-MARKERMOVE1); the general
// `#(…)` effect-list bound is a directive and stays on `#`.

@Pure fn square(n: Int) -> Int {              // empty effect set (S60/@Pure)
    return n * n
}

fn announce(label: String, n: Int) #(Io) {    // upper bound: may use Io
    print("{label} {n}")
}

// Expert levers (D-EFF2): demand/bound a callback, or publish a pass-through.
// D-MARKERMOVE2 (G1): `@Pure` is the one carve-out where a contract marker
// prefixes a function TYPE, not a declaration.
fn run_all(cb: @Pure fn(Int) -> Int) { }      // lever 1: param-type effect bound
fn map_each(f: fn(Int) -> Int) #(via f) { }   // lever 2: `#(via f)` pass-through

// Scoped capability: granted into a lexical scope, revoked at scope end (D-SCAP1).
//<<< Owner Scoped Capability: Update scoped capability syntax
// HAVE:
fn with_fs() {
    @Grant(Fs) { caps ->
        // Fs effect authorized only inside this block
    }
}
// WANT:
fn with_fs() {
    @Grant(Fs) { caps ->
        // Fs effect authorized only inside this block
    }
}
//>>> tracked: #34 D-MARKERCASE1


// ============================================================================
// LOW-LEVEL / UNSAFE TIER  (@Unsafe, *T, p.*)
// ============================================================================
// `use core.mem` is the discovery gate (S58). `@Unsafe("reason")` is the audit
// gate; the reason IS the review artifact (D-UNSAFE2). Sigils per D-MEM1/D-CAP9.

use core.mem

// Access-capability sigils ride the type (D-MEM1): `&T` write, `^T` take/move,
// bare `T` read (the default; no sigil). Call site & receivers mirror them.
fn damage(p: &Player, amount: Int) {           // &  = exclusive write
    p.hp = p.hp - amount
}
fn consume(item: ^Item) { }                    // ^ = ownership moved/consumed
struct P {
    fn edit(&self) { }                         // receiver sigils
    fn destroy(^self) { }
}
fn call_sites(player: Player, file: File) {
    damage(&player, 10)
    consume(^item)
}

// Raw pointers (D-CAP9): `*T` type, prefix `*x` raw-pointer-of, postfix `p.*` deref.
@Unsafe("reads through a raw pointer; addr must be live and valid")
fn deref_cell(cell: Int) -> Int {
    addr :: mem.address_of(cell)               // address-of is a call, not a sigil
    @Unsafe("addr is the address of a live Int on this frame") {
        p :: *addr                             // raw-pointer-of
        return p.*                             // dereference (composes as p.*.field)
    }
}

// Visible uninitialization, gated behind `use core.mem`; write-before-read
// proof (D-UNINIT1); `uninit` contextual keyword spelling (D-UNINIT-SENTINEL1).
fn uninit() {
    n: Int := uninit
    n = 7
    print("{n}")
}

// Arena allocation: named constructor + `.alloc`, freed at scope end (D-ALLOC1/2).
fn arena_use() {
    arena :: mem.Arena.new(capacity: 4096)
    node :: arena.alloc(42)
}

// Explicit expert region block (D-REGION1 opt B); the beginner tier infers the
// region from the `arena` binding scope (opt A).
fn explicit_region() {
    @Region(scratch) {
        // allocations bounded to `scratch`, may flow out under a stated bound
    }
}


// ============================================================================
// COMPTIME
// ============================================================================
// Value-only compile-time execution; comptime never creates/selects types (S26).
// `comptime` is itself the (always-immutable) binding keyword (S57).

comptime TABLE = build_table()                 // baked into the binary as constants

fn embedding() {
    data :: embed_file("logo.bin")             // the one I/O exception (S26)
}
// Curated pure-Core whitelist at comptime (D-CTCORE1); Result/Option ok (D-STRPARSE1).


// ============================================================================
// ASYNC / TASKS
// ============================================================================
// Tasks ship via `core.tasks` (S53 surface): spawn returns a Task, `.join()`
// blocks, `.detach()` fires and forgets. No shared mutable state.

fn tasks_demo() {
    a :: tasks.spawn(() => square(5))
    b :: tasks.spawn(() => square(6))
    print("{a.join() + b.join()}")
    tasks.spawn(() => square(7)).detach()
}

// # RATIFIED, NOT YET IMPLEMENTED (S53)
// `#Async { }` scoped-effect block is reserved for Epoch 3 (the `tasks` library
// above is the shipped surface).
// fn async_block() {
//     #Async {
//         // ...
//     }
// }


// ============================================================================
// TAGS, TYPESTATE, LINEAR & TAINT  (the value-fact tier)
// ============================================================================
// Two qualifier kinds: `trait` (has methods, dispatches) vs `tag` (no methods,
// erases). Beginner rule: methods -> trait, no methods -> tag (D-QUAL2).

tag Reviewed                                   // marker tag, erases at runtime
tag Internal { }
trait Greeter { fn greet(self) -> String }

// Typestate via transitioning tags (D-STATE1): require a state, or transition states.
@State(Open) fn write_line(self, s: String) { }       // valid only when Open
@Transition(Closed -> Open) fn open(self) -> File { }  // consume Closed, yield Open

// Taint tracking (D-TAINT1): `@Tainted` value-fact spreads; `@Sanitizer fn` strips it.
fn taint(raw: String) {
    user :: @Tainted raw                        // marks untrusted input
    clean :: sanitize(user)                     // strip via sanitizer
}
@Sanitizer fn sanitize(s: String) -> String { return s }

// Single-use / linear values (D-LIN1): must be consumed exactly once on every path.
@SingleUse
struct Ticket { id: Int }

// Must-use results (D-MUSTUSE1): cannot be silently ignored as a bare
// statement (E0419). D-MARKERMOVE1: `@MustUse` is a contract marker.
@MustUse fn ack() -> Int { return 1 }
@MustUse struct Receipt { id: Int }

// Units of measure as a tag family (D-QUAL3, supersedes D-UNIT1 spelling).
@UnitFamily(currency) { usd, eur }
fn price() -> Usd {
    return Usd(9.99)                            // literal; `.raw()` strips the unit
}


// ============================================================================
// MEMORY LAYOUT & SIMD
// ============================================================================

// Layout control (D-SOA1/D-SOA2): whole-struct columnar (struct-of-arrays).
//<<< Owner Layout Control: Update layout control syntax
// HAVE:
@Layout(columnar)
struct Particle { x: Float, y: Float, vx: Float, vy: Float }
// WANT:
@Layout(columnar)
struct Particle { x: Float, y: Float, vx: Float, vy: Float }
//>>> tracked: #34 D-MARKERCASE1

@Layout(C)                                      // C-compatible repr for FFI
struct CView { a: Int, b: Int }

// Portable SIMD lane types with safe ops + scalar fallback (D-SIMD1).
fn simd() {
    v :: F32x4.splat(1.0)
    w :: v + v
}


// ============================================================================
// FFI
// ============================================================================
// Rust FFI: explicit `extern rust` blocks, each entry a Jet signature + path (S50).

extern rust "base64@0.22" {
    fn b64encode(s: String) -> String  = "base64::encode"
}

// C FFI: auto-generated bindings, consumed with `use c.<lib> as alias` (S59).
use c.raylib as rl
fn c_ffi() {
    rl.init_window(800, 600, "pong")
}


// ============================================================================
// TESTS, DOCS & MIGRATIONS
// ============================================================================
// `@Test` blocks/fns (S43/D-TEST1). A parameterized `@Test fn` is a property test.

//<<< Owner Test Blocks: Update test block syntax
// HAVE:
@Test "reversing twice is identity" {
    require_eq(reverse(reverse([1, 2, 3])), [1, 2, 3])
}
//WANT:
@Test("reversing twice is identity") {
    require_eq(reverse(reverse([1, 2, 3])), [1, 2, 3])
}
//>>> tracked: #35 D-TESTPAREN1

@Test fn addition_commutes(a: Int, b: Int) {   // property test (inputs generated)
    require_eq(a + b, b + a)
}

/// Doc comment (S49). A fenced jet block with `// =>` runs as a doctest (D-TEST4).
/// ```jet
/// double(21) // => 42
/// ```
fn double(n: Int) -> Int { return n * 2 }

// Bug stops: panic / require (S36). Typed holes: @Todo (D-CASING1).
fn invariants(n: Int) {
    require(n > 0, "n must be positive")
    panic("unreachable")
}

// Published schema + migration block; `rename` ships (D-MIGRATE1).
// D-MARKERMOVE1: `@PublishedSchema` is a contract marker.
@PublishedSchema
struct UserRecord {
    display_name: String
    age: Int
}
migration UserRecord {
    rename name -> display_name
}

