// Two tasks each wait to receive from the other before sending: a wait
// cycle. A detector names the cycle; without one the program hangs.
ping: fn(input: Receiver<Int>, out: Sender<Int>) {
    n: input.receive() ?? 0
    out.send(n + 1)
}

run: fn() {
    { sender: to_b, receiver: from_a }: channel<Int>(1)
    { sender: to_a, receiver: from_b }: channel<Int>(1)
    a: task ping(from_b, to_b)
    b: task ping(from_a, to_a)
    a.join() ?? panic("a failed")
    b.join() ?? panic("b failed")
    print("done")
}
