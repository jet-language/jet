// Four tasks, each burning CPU in fib at once, so CPU-time samples land on
// several threads at the same time.
use core.process

fib: fn(n: Int) -> Int {
    if n < 2 -> return n
    fib(n - 1) + fib(n - 2)
}

burn: fn(n: Int) -> Int { fib(n) }

run: fn() {
    args: process.args()
    n: if args.len() > 0 -> Int.parse(args[args.len() - 1]) ?? 30 else -> 30
    a: task burn(n)
    b: task burn(n)
    c: task burn(n)
    d: task burn(n)
    ra: a.join() ?? 0
    rb: b.join() ?? 0
    rc: c.join() ?? 0
    rd: d.join() ?? 0
    print("sum={ra + rb + rc + rd}")
}
