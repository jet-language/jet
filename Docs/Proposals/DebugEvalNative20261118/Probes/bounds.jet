// Probe P6 (revision 4): one source, two images. The image's build options
// decide what the same expression does, so the eval object must be built
// with them.
peek: fn(xs: [Int], at: Int) -[]> Int { xs[at] }

run: fn() {
    xs: [Int]{1, 2, 3}
    print(peek(xs, 1))
    print(peek(xs, 5))
    print("went on")
}
