// Probe N2: an unmarked move of a whole binding that a later use turns into
// a share. A stop at line 10 sits between the move and the later use.
Box: struct {
    items: [Int],
}

run: fn() {
    xs := [Int]{1, 2}
    box := Box{items: xs}
    box.items.push(4)
    print(xs.len())
    print(box.items.len())
}
