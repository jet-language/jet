// The script/run scope census (#6281 c180): parse every Jet source the repo
// tracks with the compiler's own lexer and parser and classify each file that
// has top-level statements or binds the local name `run` through an import.
//
// Usage, from the repo root:
//   git ls-files > /tmp/tracked.txt
//   jet run Docs/audits/2026-11-10-script-run-scope/census/Census.jet -- . /tmp/tracked.txt census.tsv
//
// Sources are every tracked `.jet` file except the manifests, plus the
// `tests/**/*.template` and `tests/**/*.source` files a case copies into a
// `.jet` file. A `package.jet` or `workspace.jet` marks its directory's scope.
use {
    files: core.files
    process: core.process
    term: core.term
    jet_lexer.[lex_generated]
    jet_parser.[parse_lexed_with_source, parser_line_starts]
    jet_foundation.[ImportKind, Program]
}

fail: fn(message: String) -> Never { process.fail(1, message) }

Row: struct {
    path: String
    statements: Int
    run_fns: Int
    run_imports: Int
    parse_errors: Int
    imports: [String]
}

is_source: fn(path: String) -> Bool {
    stem: path.split("/").to_list().last() ?? ""
    if stem == "package.jet" || stem == "workspace.jet" -> return false
    if path.ends_with(".jet") -> return true
    path.starts_with("tests/") && (path.ends_with(".template") || path.ends_with(".source"))
}

directory: fn(path: String) -> String {
    parts := path.split("/").to_list()
    parts.pop().drop("the last segment is the file name")
    parts.join("/")
}

// The nearest ancestor directory of `path` that `scopes` holds, or "-".
scope_of: fn(path: String, scopes: [String]) -> String {
    dir := directory(path)
    loop {
        if scopes.contains(dir) -> return dir
        if dir.len() == 0 -> return "-"
        dir = directory(dir)
    }
}

// The local names an import declaration binds.
import_locals: fn(kind: ImportKind, alias: String) -> [String] {
    if kind == {
        .Unqualified(_, _, items, _, _) -> {
            out := [String]{}
            loop item in items -> out.push(item.alias ?? item.original)
            out
        }
        .File(_, _) | .Module(_, _) -> [String]{alias}
    }
}

// The sibling stems an import declaration names: `use helper`, `use "./tools"`.
import_stem: fn(kind: ImportKind) -> String? {
    if kind == {
        .File(path, _) -> Val(path.replace("./", "").replace(".jet", ""))
        .Module(name, _) -> Val(name)
        .Unqualified(_, _, _, _, _) -> None
    }
}

census_row: fn(path: String, program: Program, parse_errors: Int) -> Row {
    run_fns := 0
    loop item in program.items {
        if item == .Func(function) && function.name == "run" && function.external_type == None -> run_fns += 1
    }
    run_imports := 0
    imports := [String]{}
    loop decl in program.imports {
        loop local in import_locals(decl.kind, decl.alias) {
            if local == "run" -> run_imports += 1
        }
        stem: import_stem(decl.kind) ?? next
        imports.push(stem)
    }
    Row{path: path, statements: program.script_body.len(), run_fns: run_fns, run_imports: run_imports, parse_errors: parse_errors, imports: imports}
}

stem_of: fn(path: String) -> String {
    name: path.split("/").to_list().last() ?? ""
    name.split(".").to_list().first() ?? name
}

// What the script/run scope rule makes of one row.
verdict: fn(row: Row, rows: [Row], package: String, workspace: String) -> String {
    if row.statements == 0 -> return "library-run-alias: not an entry"
    if row.parse_errors > 0 -> return "parse-error: the parser refuses the file before any entry check"
    if row.run_fns > 0 -> return "same-file: E0621 (already refused)"
    if row.run_imports > 0 -> return "renamed-run: refused by the scope check"
    loop other in rows {
        if other.path == row.path || directory(other.path) != directory(row.path) -> next
        if other.imports.contains(stem_of(row.path)) -> return "imported-script: E0620 (already refused)"
    }
    if package != "-" || workspace != "-" -> return "package-scope: review against the package's entries"
    "script-standalone: legal (one script, no run entry)"
}

run: fn() {
    args: process.args()
    if args.len() != 3 -> fail("usage: jet run Census.jet -- <repo root> <tracked file list> <out.tsv>")
    root: args[0]
    listing: files.read(args[1].copy()) ?? fail("cannot read {args[1]}: {err}")
    packages := [String]{}
    workspaces := [String]{}
    rows := [Row]{}
    scanned := 0
    loop path in listing.split("\n").to_list() {
        if path.ends_with("package.jet") && stem_of(path) == "package" -> packages.push(directory(path))
        if path.ends_with("workspace.jet") && stem_of(path) == "workspace" -> workspaces.push(directory(path))
        if !is_source(path) -> next
        bytes: files.read_bytes("{root}/{path}") ?? next
        scanned += 1
        lexed := lex_generated(bytes.copy())
        parsed: parse_lexed_with_source(lexed, bytes.copy(), parser_line_starts(bytes))
        rows.push(census_row(path, parsed.program, parsed.diagnostics.len()))
    }
    lines := ["path\tstatements\trun_fns\trun_imports\tparse_errors\tpackage\tworkspace\tverdict"]
    loop row in rows {
        if row.statements == 0 && row.run_imports == 0 -> next
        package: scope_of(row.path, packages)
        workspace: scope_of(row.path, workspaces)
        lines.push("{row.path}\t{row.statements}\t{row.run_fns}\t{row.run_imports}\t{row.parse_errors}\t{package}\t{workspace}\t{verdict(row, rows, package, workspace)}")
    }
    files.write(args[2].copy(), "{lines.join("\n")}\n") ?? fail("cannot write {args[2]}: {err}")
    term.print("scanned {scanned} sources; {lines.len() - 1} rows")
}
