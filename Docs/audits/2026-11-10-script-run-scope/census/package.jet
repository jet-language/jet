// The script/run scope census (#6281 c180): Census.jet reads the compiler's
// own parse of every tracked Jet source.
name: "script_run_scope_census"
version: "0.0.1"
edition: "2026"
authority: { allow: [Exec, FS, IO, Mem.Alloc] }
deps: {
    jet_foundation: ../../../../Compiler/JetFoundation,
    jet_lexer: ../../../../Compiler/JetLexer,
    jet_parser: ../../../../Compiler/JetParser,
}
