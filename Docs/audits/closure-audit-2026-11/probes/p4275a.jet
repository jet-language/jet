trait Stopper {
    fn stop(self) -> Never
}

struct Halt {}

impl Halt.Stopper {
    fn stop(self) -> Never { panic("stopped") }
}

fn pick(h: Halt, x: Int) -> Int {
    if x > 0 -> return x
    h.stop()
}

fn run() {
    print(pick(Halt{}, 3))
    print(pick(Halt{}, 5))
    print(pick(Halt{}, 10))
}
