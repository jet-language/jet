// #4717 c42: a scalar initializer fills an Atomic<Int> field (atomic_field_inner); a plain generic owner keeps its type.
struct Counters {
    hits: Atomic<Int>
}

struct Holder<T> {
    value: T
}

fn run() {
    counters :: Counters{hits: 5}
    prior :: counters.hits.add(2)
    print("prior={prior} now={counters.hits.load()}")
    holder :: Holder<Int>{value: 9}
    print(holder.value)
}
