package {
    name: "c4599_28_comptime_asm"
    version: "0.1.0"
    authority: { allow: [Exec, FFI, IO, Mem.Alloc] }
}
// #4599 c28 (was #5572): a comptime block in a file that also holds an FFI(asm) body.
// The comptime closure must not type-check the assembly body as Jet (E0114 missing return).
use core.mem

#[Unsafe("the operands are scalar registers and the early-written r10 clobber does not overlap live inputs"), FFI(asm)]
fn add_registers(a: Int, b: Int) -> Int {
    """
    mov r10, {a}
    add r10, {b}
    mov {a}, r10 ; -> return
    ; clobbers r10
    """
}

fn double(n: Int) -> Int { n * 2 }

fn run() {
    folded :: comptime { double(21) }
    print(folded)
    #Unsafe("call the audited register-only assembly contract") {
        print(add_registers(20, 22))
    }
}
