// #4599 c103 (was #4970): literal sub-patterns in variant payloads must parse and select the right arm.
enum Shape {
    Circle(Int)
    Square(Int)
    Label(String)
}

fn describe(shape: Shape) -> String {
    if shape == {
        .Circle(0) -> "dot"
        .Circle(r) -> "circle {r}"
        .Square(1) -> "unit square"
        .Label("x") -> "label x"
        .Square(n) -> "square {n}"
        else -> "other"
    }
}

fn run() {
    print(describe(.Circle(0)))
    print(describe(.Circle(5)))
    print(describe(.Square(1)))
    print(describe(.Square(4)))
    print(describe(.Label("x")))
    print(describe(.Label("y")))
}
