// #4717 c83: a fixed array range-slices into a read view without materializing; c84: a direct range-slice argument gets View typing.
fn total(window: View<Int>) -> Int {
    sum := 0
    loop x in window {
        sum += x
    }
    sum
}

fn middle(values: [Int#4]) -> View<Int> from values {
    values[1..<3]
}

fn run() {
    values :: [Int#4]{1, 2, 3, 4}
    print(middle(values))
    print(total(values[1..<3]))
    list :: [Int]{5, 6, 7}
    print(total(list[0..<2]))
}
