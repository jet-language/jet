// #4717 c73: cognitive complexity adds the nesting term: two_loops 3, nested_if 3, if_in_loop 3.
fn two_loops(xs: [Int]) -> Int {
    total := 0
    loop x in xs {
        loop y in xs {
            total += x * y
        }
    }
    total
}

fn nested_if(a: Bool, b: Bool) -> Int {
    if a {
        if b {
            return 1
        }
    }
    0
}

fn if_in_loop(xs: [Int]) -> Int {
    count := 0
    loop x in xs {
        if x > 0 {
            count += 1
        }
    }
    count
}

fn run() {
    print(two_loops([Int]{1, 2}) + nested_if(true, true) + if_in_loop([Int]{1, -1}))
}
