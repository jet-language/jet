// #4717 c82: a bare parameter or field place returned as View<T> is a read window (no E0113).
struct Holder {
    items: [Int]
}

fn all(items: [Int]) -> View<Int> from items {
    items
}

fn field(holder: Holder) -> View<Int> from holder {
    holder.items
}

fn run() {
    xs :: [Int]{1, 2, 3}
    h :: Holder{items: [Int]{4, 5}}
    print(all(xs))
    print(field(h))
}
