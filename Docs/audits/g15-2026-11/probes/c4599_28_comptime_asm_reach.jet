package {
    name: "c4599_28_comptime_asm_reach"
    version: "0.1.0"
    authority: { allow: [Exec, FFI, IO, Mem.Alloc] }
}
// #4599 c28 (was #5572): the comptime closure reaches an FFI(asm) function on a branch it never takes.
// Comptime must not type-check the assembly body as Jet (E0114 missing return).
use core.mem

#[Unsafe("the operands are scalar registers and the early-written r10 clobber does not overlap live inputs"), FFI(asm)]
fn add_registers(a: Int, b: Int) -> Int {
    """
    mov r10, {a}
    add r10, {b}
    mov {a}, r10 ; -> return
    ; clobbers r10
    """
}

fn pick(n: Int) -> Int {
    if n > 100 {
        #Unsafe("call the audited register-only assembly contract") {
            return add_registers(n, 1)
        }
    }
    n * 2
}

fn run() {
    folded :: comptime { pick(21) }
    print(folded)
    print(pick(200))
}
