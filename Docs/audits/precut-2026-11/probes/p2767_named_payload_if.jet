// cards: 2767
// claim: a named-payload enum arm whose body holds an if lowers and runs on every tier
// mode: run
enum Expr {
    Num(value: Int)
    Add(left: Int, right: Int)
}

fn eval(e: Expr) -> Int {
    if e == {
        .Num{value} -> {
            if value < 0 -> return 0
            value
        }
        .Add{left, right} -> left + right
    }
}

fn run() {
    print(eval(Expr.Num{value: 5}))
    print(eval(Expr.Num{value: -1}))
    print(eval(Expr.Add{left: 2, right: 3}))
}
