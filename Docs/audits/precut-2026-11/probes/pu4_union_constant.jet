// cards: 3484 3485
// claim: module constants holding an anonymous union (in a struct and in an enum payload) work on every tier
// mode: run
struct Box {
    value: Int | String
}

enum Slot {
    Filled(Int | String)
    Empty
}

START :: Box{value: "z"}
FULL :: Slot.Filled(9)

fn show(v: Int | String) -> String {
    if v == {
        .Int(n) -> "int {n}"
        .String(s) -> "text {s}"
    }
}

fn run() {
    print(show(START.value))
    if FULL == {
        .Filled(v) -> print(show(v))
        .Empty -> print("empty")
    }
}
