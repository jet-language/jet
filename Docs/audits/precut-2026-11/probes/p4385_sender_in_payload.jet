// cards: 4385
// claim: a channel Sender carried in a struct inside an enum payload still sends
// mode: run
package {
    name: "p4385_sender_in_payload"
    authority: { allow: [IO, Mem.Alloc] }
}

struct Reply {
    tx: Sender<Int>
}

enum Message {
    Get(Reply)
    Stop
}

fn handle(message: Message) {
    if message == {
        .Get(reply) -> reply.tx.send(7)
        .Stop -> {}
    }
}

fn run() {
    { sender: tx, receiver: rx } :: channel<Int>(capacity: 1)
    handle(Message.Get(Reply{tx: tx}))
    print(rx.try_receive() ?? -1)
}
