// cards: 3972
// claim: a match arm ending in an expression followed by a leading-dot arm parses as two arms
// mode: run
enum Node {
    Apply(String)
    Pair(a: Int, b: Int)
}

fn label(n: Node) -> String? {
    if n == {
        .Apply(name) -> return Val(name)
        .Pair(a, b) -> {
            if a == b -> return None
            return Val("{a}-{b}")
        }
    }
}

fn run() {
    print(label(Node.Apply("f")) ?? "none")
    print(label(Node.Pair{a: 1, b: 2}) ?? "none")
    print(label(Node.Pair{a: 3, b: 3}) ?? "none")
}
