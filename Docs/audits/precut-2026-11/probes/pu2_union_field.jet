// cards: 3479 3482 3483
// claim: an anonymous union works as a struct field built by a constructor on every tier
// mode: run
struct Box {
    value: Int | String
}

fn show(v: Int | String) -> String {
    if v == {
        .Int(n) -> "int {n}"
        .String(s) -> "text {s}"
    }
}

fn run() {
    c :: Box{value: "y"}
    d :: Box{value: 5}
    print(show(c.value))
    print(show(d.value))
}
