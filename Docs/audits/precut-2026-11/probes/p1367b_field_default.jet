// cards: 1367
// claim: a struct field default field: T{expr} fills an omitted field on every tier
// mode: run
struct Config {
    retries: Int{3}
    name: String{"jet"}
}

fn run() {
    config :: Config{}
    print(config.retries)
    print(config.name)
    custom :: Config{retries: 5}
    print(custom.retries)
}
