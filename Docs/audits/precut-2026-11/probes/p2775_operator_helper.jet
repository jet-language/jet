// cards: 2775
// claim: a plain helper call inside an operator impl is not treated as fallible
// mode: run
struct Money {
    cents: Int
}

fn add_cents(a: Int, b: Int) -> Int { a + b }

impl Money.Add {
    fn add(self, rhs: Money) -> Money { Money{cents: add_cents(self.cents, rhs.cents)} }
}

fn run() {
    total :: Money{cents: 5} + Money{cents: 7}
    print(total.cents)
}
