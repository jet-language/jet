// cards: 2768
// claim: assigning a field through a map index updates the stored value on every tier
// mode: run
struct P2768Item {
    value: Int
}

fn run() {
    cells := [String:P2768Item]{"a": P2768Item{value: 1}}
    cells["a"].value = 5
    print((cells.get("a") ?? P2768Item{value: 0}).value)
}
