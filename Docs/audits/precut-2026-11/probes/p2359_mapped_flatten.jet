// cards: 2359
// claim: a mapped String-list flatten gives the same rows on every tier
// note: String.split now returns Iter<String>, so each line's words are collected with .to_list() before flatten
// note: the expected list prints its String items unquoted ([a, b, …]); the first draft of this .out guessed quoted items, which was a formatting guess only
// mode: run
fn run() {
    contents :: "a b\nc d e"
    words :: contents.lines().map((line: String) -> line.split(" ").to_list()).flatten()
    print(words)
    print(words.len())
}
