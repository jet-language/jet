// cards: 3969
// claim: L0303 names the enum type with single backticks
// mode: check-text
// has: `Shape`
// lacks: ``Shape``
enum Shape {
    Circle
    Square
}

fn name(s: Shape) -> String {
    if s == {
        .Circle -> "circle"
        .Square -> "square"
        else -> "other"
    }
}

fn run() {
    print(name(Shape.Circle))
}
