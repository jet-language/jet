// cards: 2758
// claim: a lambda may pass a captured mutable binding as a & write-lend argument
// mode: run
fn key(n: Int, seen: &Int) -> Int {
    seen += 1
    n
}

fn run() {
    seen := 0
    items := [Int]{3, 1, 2}
    &items.sort_by((n: Int) -> key(n, &seen))
    print(items)
    print(seen > 0)
}
