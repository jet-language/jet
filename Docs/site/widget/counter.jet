// The live widget on jet-lang.dev: a reactive counter compiled to WebAssembly.
// Adapted from Examples/Apps/Web/UIWebClick.jet (golden-tested).
use {
    ui: core.ui
    reactive: core.reactive
    core.color.[Color]
}
#[Target(Web), HTML(Path{"shell.html"})]

run: fn() {
    count: reactive.signal(0)
    ui.reactive_render(fn() {
        n := count.get()
        color := Color{r: 46, g: 46, b: 51, a: 255}
        if n % 2 == 1 -> color = Color{r: 232, g: 35, b: 42, a: 255}
        backend: ui.null_backend()
        tree: ui.box([
            ui.node_color("count: {n}", 160.0, 40.0, color),
            ui.button("Add one", on_click: fn() {
                count.set(count.get() + 1)
            })
        ])
        ui.mount(backend, tree, ui.constraint(0.0, 0.0, 300.0, 120.0))
    })
}
