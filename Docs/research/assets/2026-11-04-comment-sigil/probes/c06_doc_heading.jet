// c06: a doc comment with markdown headings and a code fence, as `jet doc`
// reads it. Under `##` comments these lines would read `### ## Examples`.

/// Adds one.
///
/// ## Examples
///
/// ```jet
/// add_one(1) // => 2
/// ```
fn add_one(x: Int) -> Int { x + 1 }

fn run() {
    print(add_one(1))
}
