// c08: every job `/` has today: division, whole-number division `/%`,
// compound assignment, and the positional-only parameter zone.
fn area(w: Int, h: Int, /) -> Int { w * h }

fn run() {
    total := 17
    total /%= 2
    print(total)
    print(17 / 4)
    print(17 /% 4)
    print(area(3, 4))
}
