// c05: today's `#` jobs: markers and fixed-size lists. c05b adds the
// ratified-but-unbuilt site value `#line` (D-META-HASH1 A).
#Inline
fn double(x: Int) -> Int { x * 2 }

struct Point {
    x: Int
    y: Int
}

fn run() {
    xs :: [Int#3]{1, 2, 3}
    print(double(xs[2]))
    print(xs.len())
}
