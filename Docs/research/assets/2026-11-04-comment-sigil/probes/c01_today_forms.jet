//! c01: every comment form Jet accepts today, beside `/` and `#` in code.

/// Splits `total` items into pages of `size`.
/// Example: pages(10, 3)
fn pages(total: Int, size: Int) -> Int {
    (total + size - 1) /% size   // `/%` is whole-number division
}

/* a block comment /* nested inside */ still closed */

fn run() {
    // a full-line comment
    print(pages(10, 3))                    // trailing comment
    print(7 / 2)
    print("a // inside text is text, # too")
    print("https://example.com/a#frag")
    //// four slashes are a plain comment
    // #Unsafe("a commented-out marker") stays a comment
}
