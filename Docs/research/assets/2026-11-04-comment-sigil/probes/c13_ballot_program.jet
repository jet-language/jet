// c13: the ballot's same-program example, in today's spelling.
// A comment may mention #{name}, #line or #Inline: comment text is never lexed.

/// Splits a bill evenly.
#Inline
fn share(total: Int, people: Int) -> Int {
    // whole-number division drops the cents
    total /% people  // #4828: round up later
}

fn run() {
    print(share(1000, 3))
}
