// Today's spellings of the flow shapes the census found most often.
use json :: core.encoding.json

// Shape 1: a staged read with a fallback on every stage (Core/Web/Web.jet:374).
fn app_port(raw: [U8], fallback: Int) -> Int {
    text :: String.from_bytes(raw) ?? return fallback
    port :: Int.parse(text.trim()) ?? return fallback
    if port < 1 || port > 65535 -> return fallback
    port
}

// Shape 2: deep prefix nesting with extra arguments (Core/Crypto/Crypto.jet:360).
fn digest(bytes: [U8]) -> [U8] { bytes.map((b) -> b) }
fn take_front(bytes: [U8], count: Int) -> [U8] { bytes[0..<count] }
fn hex(bytes: [U8]) -> String { bytes.map((b) -> "{b}").join("-") }
fn short_id(bytes: [U8]) -> String { hex(take_front(digest(bytes), 2)) }

// Shape 3: a free function wraps a dot chain, then a method follows (Core/Encoding/Yaml.jet:40).
fn render(value: Dyn, depth: Int) -> String { "{json.to_string(value)}  " }
fn yaml_like(value: Dyn) -> String { render(value, 0).trim_end() }

// Shape 4: the same function nested three times (Compiler/JetRepl/Tests/Notebook/Codec.jet:139).
fn drop_key(text: String, key: String) -> String { text.replace(key, "") }

// Shape 5: the data is not the first argument, so a first-argument pipe cannot reach it.
fn wrap(prefix: String, body: String) -> String { "{prefix}({body})" }

// Shape 6: no new syntax, a library helper that applies a function.
fn apply<T, U>(value: T, step: fn(T) -> U) -> U { step(value) }

fn run() {
    print(app_port([U8]{"8080"}, 80))
    print(app_port([U8]{"x"}, 80))
    print(short_id([U8]{"abc"}))
    tree :: json.parse("{{\"a\":1}}") ?? panic("parse")
    print(yaml_like(tree))
    print(drop_key(drop_key(drop_key("a-b-c-d", "a"), "b"), "c"))
    print(wrap("outer", wrap("inner", "x")))
    print(apply<String, String>("  hi  ", (s) -> s.trim()))
}
