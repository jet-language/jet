// Can today's Jet nest a fallback-with-return inside a call, and apply a lambda in place?
fn port(raw: [U8], fallback: Int) -> Int {
    Int.parse((String.from_bytes(raw) ?? return fallback).trim()) ?? return fallback
}

fn run() {
    print(port([U8]{" 8080 "}, 80))
    print(port([U8]{"no"}, 80))
    print(((s: String) -> s.trim())("  x  "))
}
