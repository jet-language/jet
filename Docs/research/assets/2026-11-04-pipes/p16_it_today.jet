// Today's `it`: the subject of an arm table over a non-name subject, and the item of a bindingless loop.
fn find(xs: [Int], n: Int) -> Int? {
    loop i in 0..<xs.len() {
        if xs[i] == n -> return Val(i)
    }
    None
}

struct User {
    name: String
    age: Int
}

fn run() {
    xs :: [Int]{4, 5, 6}
    // 1. Arm table over a call: the arms see the subject as `it`.
    if find(xs, 5) == {
        .Val(i) -> print("found {i}, it is {it ?? -1}")
        else -> print("none")
    }
    // 2. An arm table inside an arm: the inner subject hides the outer one.
    if find(xs, 6) == {
        .Val(i) -> {
            if i * 10 == {
                30 -> print("thirty")
                else -> print("inner it {it}")
            }
        }
        else -> print("none")
    }
    // 3. A bindingless collecting loop: `it` is the item, and `.age` reads it.
    users :: [User]{User{name: "ann", age: 30}, User{name: "bo", age: 4}}
    print(loop users -> "{it.name} {.age}")
    // 4. An arm table inside a bindingless loop body.
    print(loop users -> if .age * 2 == {
        8 -> "eight"
        else -> "table it {it}"
    })
}
