// A top-level method on a type declared in the same file: chaining works today.
struct Lines { text: String }

fn Lines.trimmed(self) -> Lines { Lines{text: self.text.trim()} }
fn Lines.count(self) -> Int { self.text.split("\n").len() }

fn run() {
    print(Lines{text: "  a\nb  "}.trimmed().count())
}
