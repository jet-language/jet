// Today's spellings for one three-stage flow.
fn parse(line: String) -> Int { line.len() }
fn validate(n: Int) -> Int { n + 1 }
fn normalize(n: Int) -> Int { n * 10 }

// One-line typed body.
fn flow(line: String) Int -> normalize(validate(parse(line)))

fn run() {
    // Nested calls read inside out.
    print(normalize(validate(parse("abc"))))
    // Named stages read top to bottom.
    a :: parse("abc")
    b :: validate(a)
    print(normalize(b))
    // A named function value.
    f :: (s: String) -> normalize(validate(parse(s)))
    print(f("abc"))
    print(flow("abc"))
}
