// In what order do a call's arguments run when one of them is a nested call?
fn note(label: String) -> String {
    print(label)
    label.copy()
}

fn wrap(prefix: String, body: String) -> String { "{prefix}({body})" }

fn run() {
    print(wrap(note("outer"), wrap(note("inner"), "x")))
    inner :: wrap(note("inner"), "x")
    print(wrap(note("outer"), inner))
}
