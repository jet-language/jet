// Glyph probe: what a leading `|` already means at the start of a line.
enum Color {
    Red
    Green
    Blue
}

fn warm(c: Color) -> Bool {
    if c == {
        .Red
        | .Green -> true
        else -> false
    }
}

fn label(v: Int | String) -> String {
    if v == {
        .Int(n) -> "int {n}"
        .String(s) -> "text {s}"
    }
}

fn run() {
    print(warm(Color.Green))
    print(label(3))
}
