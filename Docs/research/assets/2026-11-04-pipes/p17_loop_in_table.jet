// A bindingless loop inside an arm of a table whose subject is `it`.
fn find(xs: [Int], n: Int) -> Int? {
    loop i in 0..<xs.len() {
        if xs[i] == n -> return Val(i)
    }
    None
}

struct User {
    name: String
    age: Int
}

fn run() {
    xs :: [Int]{4, 5, 6}
    users :: [User]{User{name: "ann", age: 30}}
    if find(xs, 4) == {
        .Val(i) -> print(loop users -> "loop it {it.name} {i}")
        else -> print("none")
    }
}
