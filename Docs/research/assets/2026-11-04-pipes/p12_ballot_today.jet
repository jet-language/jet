// The ballot's "today" program (current code and option C), checked as written.
// The digest helpers are stand-ins with the same shape as Core/Crypto/Crypto.jet:360.
SHA224_IV :: [U8]{"iv"}

fn sha2_256(bytes: [U8], iv: [U8]) -> [U8] { bytes.map((b) -> b) }
fn slice_u8(bytes: [U8], start: Int, end: Int) -> [U8] { bytes[start..<end] }
fn hex_encode(bytes: [U8]) -> String { bytes.map((b) -> "{b}").join("") }

fn app_port(raw: [U8], fallback: Int) -> Int {
    text :: String.from_bytes(raw) ?? return fallback
    port :: Int.parse(text.trim()) ?? return fallback
    if port < 1 || port > 65535 -> fallback else -> port
}

fn sha224(bytes: [U8]) -> String {
    hex_encode(slice_u8(sha2_256(bytes, SHA224_IV), 0, 28))
}

// Option C: name the first step instead of nesting it.
fn sha224_named(bytes: [U8]) -> String {
    digest :: sha2_256(bytes, SHA224_IV)
    hex_encode(slice_u8(digest, 0, 28))
}

fn run() {
    print(app_port([U8]{" 8080 "}, 80))
    print(app_port([U8]{"99999"}, 80))
    print(sha224([U8]{"abcdefghijklmnopqrstuvwxyz0123"}))
    print(sha224_named([U8]{"abcdefghijklmnopqrstuvwxyz0123"}))
}
