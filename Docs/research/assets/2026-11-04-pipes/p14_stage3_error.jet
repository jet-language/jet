// A type mistake in the third step of a nested flow: what does today's error point at?
fn load(path: String) -> [U8] { path.bytes() }
fn check_size(bytes: [U8], limit: Int) -> [U8] { bytes[0..<limit] }

fn port(path: String) -> Int {
    Int.parse(check_size(load(path), 4)) ?? 0
}

fn run() {
    print(port("8080"))
}
