// Edges of today's `it`: nested bindingless loops, a table over a plain name, and `it` with no subject.
struct Team {
    names: [String]
}

fn run() {
    teams :: [Team]{Team{names: [String]{"a", "b"}}}
    // A. Nested bindingless loops.
    words :: [String]{"x", "yy"}
    print(loop teams -> loop words -> it.len())
    // B. A table over a plain name: is `it` bound?
    n :: 3
    if n == {
        3 -> print("three {it}")
        else -> print("other")
    }
    // C. `it` with no subject at all.
    print(it)
}
