// A type passed as a type argument, read while compiling inside a generic function.
struct Rock {
    size: Float
    hard: Bool
}

struct Door {
    open: Bool
}

fn field_count<T>() -> Int {
    T.reflect().fields.len()
}

fn name_of<T>() -> String {
    T.reflect().name
}

fn run() {
    print("{name_of<Rock>()} {field_count<Rock>()}")
    print("{name_of<Door>()} {field_count<Door>()}")
}
