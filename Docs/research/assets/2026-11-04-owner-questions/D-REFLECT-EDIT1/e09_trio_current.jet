// The ballot's "today" snippet: a typed patch, apply, and the undo patch.
#Patchable
struct Rock {
    size: Float{1.0}
}

fn run() {
    rock := Rock{}
    before :: rock.copy()
    rock = rock.apply(Rock.Patch{size: Float{2.0}})
    undo :: Rock.diff(^before, rock.copy())
    print(rock.size)
    print(undo.size)
}
