// Today a generic function cannot name a field of its type parameter, so a
// signature such as `fn keep<T>(value: &T)` tells the reader it leaves fields alone.
struct Rock {
    size: Float{1.0}
}

fn keep<T>(value: &T) {
    value.size = 2.0
}

fn run() {
    rock := Rock{}
    keep(&rock)
    print(rock.size)
}
