// A priv field: outside its module, typed code cannot write it. What does
// today's read-only reflection show of it?
use reflect :: core.reflect

module shop {
    struct Cart {
        items: Int{0}
        priv total_cents: Int{0}
    }

    fn add(cart: &Cart, cents: Int) {
        cart.items = cart.items + 1
        cart.total_cents = cart.total_cents + cents
    }
}

fn run() {
    cart := shop.Cart{}
    shop.add(&cart, 250)
    loop f in reflect.of(cart).fields() -> print("{f.name()} = {f.value().display()}")
    // cart.total_cents = 0   // a typed write from here
}
