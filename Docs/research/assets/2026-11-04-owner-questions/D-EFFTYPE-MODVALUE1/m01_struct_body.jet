// A struct body holds a function without self; a module body holds the
// same function plus a nested type. (A struct body refuses `X :: 3` and a
// nested `struct`; see m02_struct_const.jet and m06_struct_nested.jet.)
struct Pricing {
    fn total(text: String) -> Int { text.len() }
}

module pricing {
    struct Line {
        cents: Int
    }

    fn total(text: String) -> Int { text.len() }
}

fn run() {
    print(Pricing.total("abc"))
    print(pricing.total("abc"))
    print(pricing.Line{cents: 5}.cents)
}
