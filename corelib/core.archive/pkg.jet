// core.archive ring package — zip/tar containers (D-CORE-COMPRESS1=A).
//
// Usage in a Jet program:
//   use core.archive as ar
//   zipped :: ar.zip_compress("data.bin", bytes)
//   original :: ar.zip_decompress(zipped)

payload: {
    name: "core.archive"
    version: "0.2.0"
}
packages: {
    archive: library
}
