use core.collections as c

fn run() {
    print(c.heapify([Int]{5, 1, 4, 2, 3}))
    print(c.heappush([Int]{1, 3, 4}, 2))
    print(c.bisect_left([Int]{1, 2, 2, 4}, 2))
    print(c.bisect_right([Int]{1, 2, 2, 4}, 2))
    print(c.insort_left([Int]{1, 2, 2, 4}, 2))
    print(c.insort_right([Int]{1, 2, 2, 4}, 2))
    print(c.merge_sorted([Int]{1, 3, 5}, [Int]{2, 4, 6}))
    print(c.nsmallest(3, [Int]{5, 1, 4, 2, 3}))
    print(c.nlargest(3, [Int]{5, 1, 4, 2, 3}))
}
