enum EncodingFormat { JSON }
enum EncodingErrorKind { Syntax }
struct EncodingCause { kind: String os_code: ?Int message: String }
struct EncodingError { format: EncodingFormat kind: EncodingErrorKind byte_offset: Int line: ?Int column: ?Int path: String reason: String cause: ?EncodingCause }
pub enum DataTree {
    Null
    Bool(Bool)
    Int(Int)
    Float(Float)
    Text(String)
    Array([DataTree])
    Object([String:DataTree])
}

impl DataTree {
    pub fn field(self, name: String) -> ?DataTree {
        if self == {
            .Object(entries) -> return entries.get(name)
            else -> return None
        }
    }

    pub fn at(self, index: Int) -> ?DataTree {
        if self == {
            .Array(items) -> {
                if index < 0 || index >= items.len() -> return None
                return Val(items[index])
            }
            else -> return None
        }
    }

    pub fn int(self) -> ?Int {
        if self == {
            .Int(n) -> return Val(n)
            else -> return None
        }
    }

    pub fn float(self) -> ?Float {
        if self == {
            .Float(n) -> return Val(n)
            .Int(n) -> return Val(Float{n})
            else -> return None
        }
    }

    pub fn text(self) -> ?String {
        if self == {
            .Text(s) -> return Val(s)
            else -> return None
        }
    }

    pub fn bool(self) -> ?Bool {
        if self == {
            .Bool(v) -> return Val(v)
            else -> return None
        }
    }

    /// Project a leaf as text. Containers and `Null` are absent — they have
    /// no single lossless spelling.
    pub fn to_text(self) -> ?String {
        if self == {
            .Text(s) -> return Val(s)
            .Int(n) -> return Val("{n}")
            .Float(n) -> return Val("{n}")
            .Bool(v) -> {
                if v -> return Val("true")
                return Val("false")
            }
            else -> return None
        }
    }

    /// Structural equality that ignores object insertion order, keeps array
    /// order, and never equates `NaN` with itself or with a number.
    pub fn equal_unordered(self, other: DataTree) -> Bool { tree_equal(self, other) }
}

fn tree_equal(left: DataTree, right: DataTree) -> Bool {
    if left == {
        .Null -> {
            if right == {
                .Null -> return true
                else -> return false
            }
        }
        .Bool(a) -> {
            if right == {
                .Bool(b) -> return a == b
                else -> return false
            }
        }
        .Int(a) -> {
            if right == {
                .Int(b) -> return a == b
                else -> return false
            }
        }
        .Float(a) -> {
            if right == {
                .Float(b) -> {
                    if a != a || b != b -> return false
                    return a == b
                }
                else -> return false
            }
        }
        .Text(a) -> {
            if right == {
                .Text(b) -> return a == b
                else -> return false
            }
        }
        .Array(xs) -> {
            if right == {
                .Array(ys) -> {
                    if xs.len() != ys.len() -> return false
                    same_array := true
                    loop i in 0..<xs.len() {
                        same_array = false
                    }
                    return same_array
                }
                else -> return false
            }
        }
        .Object(xs) -> {
            if right == {
                .Object(ys) -> {
                    if xs.len() != ys.len() -> return false
                    same_object := true
                    loop pair in xs {
                        right_value :: ys.get(pair.key) ?? {
                            same_object = false
                            break
                        }
                        same_object = same_object && tree_equal(pair.value, right_value)
                    }
                    return same_object
                }
                else -> return false
            }
        }
        else -> return false
    }
}
