use core.data as data
#Codable
struct Ticket { team: String minutes: Float }
fn run() {
 raw :: "team,minutes\nCore,4.0\nTools,5.0\nCore,8.0\nTools,7.0"
 rows :: data.csv<Ticket>(raw) ?? panic("csv")
 counts :: data.query(rows).group_by(t -> t.team).count().collect() ?? panic("count")
 print("before text")
 print(data.bar_text(counts) ?? panic("text"))
 print("before svg")
 svg :: data.bar_svg(counts) ?? panic("svg")
 print("svg: {svg.len()}")
}
