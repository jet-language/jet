use core.encoding.binary as b

fn run() {
    print(b.pack_u8(255))
    print(b.pack_u16le(4660))
    print(b.pack_u16be(4660))
    print(b.pack_u32le(305419896))
    print(b.pack_u64be(72623859790382856))
    print(b.unpack_u16le([U8]{52, 18}, 0))
    print(b.unpack_u32be([U8]{18, 52, 86, 120}, 0))
    print(b.sign_extend(255, 8))
    print(b.pack_f64le(1.5))
    print(b.unpack_f64be([U8]{63, 248, 0, 0, 0, 0, 0, 0}, 0))
    print(b.calcsize("<3Ih"))
    print(b.pack("<3Ih", [Int]{1, 2, 3, 4}))
    print(b.unpack("<3Ih", [U8]{1, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0, 4, 0}))
}
