fn run() {
    a := Set.from([1, 2, 3])
    b :: Set.from([2, 3, 4])
    a.difference_update(b)
    print(a.has(1))
    print(a.has(2))

    c := Set.from([1, 2, 3])
    d :: Set.from([2, 3, 4])
    c.intersection_update(d)
    print(c.has(1))
    print(c.has(2))

    e := Set.from([1, 2])
    f :: Set.from([2, 3])
    e.symmetric_difference_update(f)
    print(e.has(1))
    print(e.has(2))
    print(e.has(3))

    s := Set.from(["a", "b"])
    t :: Set.from(["b", "c"])
    s.symmetric_difference_update(t)
    print(s.has("a"))
    print(s.has("b"))
    print(s.has("c"))
}
