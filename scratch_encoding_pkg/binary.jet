package {
    name: "core.encoding.binary"
    version: "0.1.0"
    edition: "2026"
    description: "Endian integer packing, IEEE-754 bits, and struct formats."
    license: "MIT"
    outputs: {
        binary: .Library{ entry: binary }
    }
}
// core.encoding.binary — Python `struct` for integers, plus named packers.
//
// Format characters (after an optional `<` little / `>` `!` big prefix):
// `x` pad byte, `c`/`b` i8, `B` u8, `h` i16, `H` u16, `i`/`l` i32, `I`/`L` u32
// `q` i64, `Q` u64. Values are `[Int]`. Floats use the named `f32`/`f64`
// helpers because Jet `Float` is software-decimal at Core, not IEEE-by-default;
// `pack_f64le` stores `math.to_bits`.
//
// There is no native alignment (`@`). Repeat counts (`3I`) are supported.
// A missing or extra value is a `String` error, not a panic.
use core.math as math

fn u8_int(b: U8) -> Int { Int.from_u8(b) }

pub fn pack_u8(n: Int) -> [U8] {
    if n < 0 || n > 255 -> return Err("u8 value out of range 0..255")
    [U8]{U8{n}}
}

pub fn pack_i8(n: Int) -> [U8] {
    if n < -128 || n > 127 -> return Err("i8 value out of range -128..127")
    pack_u8(n & 255)
}

pub fn pack_u16le(n: Int) -> [U8] {
    if n < 0 || n > 65535 -> return Err("u16 value out of range 0..65535")
    [U8]{U8{n & 255}, U8{(n >> 8) & 255}}
}

pub fn pack_u16be(n: Int) -> [U8] {
    if n < 0 || n > 65535 -> return Err("u16 value out of range 0..65535")
    [U8]{U8{(n >> 8) & 255}, U8{n & 255}}
}

pub fn pack_u32le(n: Int) -> [U8] {
    if n < 0 || n > 4294967295 -> return Err("u32 value out of range 0..4294967295")
    [U8]{U8{n & 255}, U8{(n >> 8) & 255}, U8{(n >> 16) & 255}, U8{(n >> 24) & 255}}
}

pub fn pack_u32be(n: Int) -> [U8] {
    if n < 0 || n > 4294967295 -> return Err("u32 value out of range 0..4294967295")
    [U8]{U8{(n >> 24) & 255}, U8{(n >> 16) & 255}, U8{(n >> 8) & 255}, U8{n & 255}}
}

pub fn pack_u64le(n: Int) -> [U8] {
    if n < 0 || n > 18446744073709551615 -> return Err("u64 value out of range 0..18446744073709551615")
    out := [U8]{}
    loop k in 0..<8 -> out.push(U8{(n >> (k * 8)) & 255})
    out
}

pub fn pack_u64be(n: Int) -> [U8] {
    if n < 0 || n > 18446744073709551615 -> return Err("u64 value out of range 0..18446744073709551615")
    out := [U8]{}
    loop k in 0..<8 -> out.push(U8{(n >> ((7 - k) * 8)) & 255})
    out
}

pub fn unpack_u8(data: [U8], offset: Int) -> ?Int {
    if offset < 0 || offset >= data.len() -> return None
    n :: u8_int(data[offset])
    Val(n)
}

pub fn unpack_u16le(data: [U8], offset: Int) -> ?Int {
    if offset < 0 || offset + 1 >= data.len() -> return None
    a :: u8_int(data[offset])
    b :: u8_int(data[offset + 1])
    Val(a | (b << 8))
}

pub fn unpack_u16be(data: [U8], offset: Int) -> ?Int {
    if offset < 0 || offset + 1 >= data.len() -> return None
    a :: u8_int(data[offset])
    b :: u8_int(data[offset + 1])
    Val((a << 8) | b)
}

pub fn unpack_u32le(data: [U8], offset: Int) -> ?Int {
    if offset < 0 || offset + 3 >= data.len() -> return None
    n := 0
    k := 0
    loop k < 4 {
        b :: u8_int(data[offset + k])
        n = n | (b << (k * 8))
        k = k + 1
    }
    Val(n)
}

pub fn unpack_u32be(data: [U8], offset: Int) -> ?Int {
    if offset < 0 || offset + 3 >= data.len() -> return None
    n := 0
    k := 0
    loop k < 4 {
        b :: u8_int(data[offset + k])
        n = (n << 8) | b
        k = k + 1
    }
    Val(n)
}

pub fn unpack_u64le(data: [U8], offset: Int) -> ?Int {
    lo :: unpack_u32le(data, offset) ?? return None
    hi :: unpack_u32le(data, offset + 4) ?? return None
    Val(lo | (hi << 32))
}

pub fn unpack_u64be(data: [U8], offset: Int) -> ?Int {
    hi :: unpack_u32be(data, offset) ?? return None
    lo :: unpack_u32be(data, offset + 4) ?? return None
    Val(lo | (hi << 32))
}

pub fn sign_extend(n: Int, bits: Int) -> Int {
    sign :: 1 << (bits - 1)
    mask :: (1 << bits) - 1
    v := n & mask
    if (v & sign) != 0 -> return v - (1 << bits)
    v
}

pub fn pack_f64le(n: Float) -> [U8] { pack_u64le(math.to_bits(n)) }

pub fn pack_f64be(n: Float) -> [U8] { pack_u64be(math.to_bits(n)) }

pub fn unpack_f64le(data: [U8], offset: Int) -> ?Float {
    bits :: unpack_u64le(data, offset) ?? return None
    Val(math.from_bits(bits))
}

pub fn unpack_f64be(data: [U8], offset: Int) -> ?Float {
    bits :: unpack_u64be(data, offset) ?? return None
    Val(math.from_bits(bits))
}

pub fn calcsize(fmt: String) -> Int {
    spec :: parse_fmt(fmt)
    Ok(spec.size)
}

pub fn pack(fmt: String, values: [Int]) -> [U8] {
    spec :: parse_fmt(fmt)
    if values.len() != spec.count {
        return Err("struct pack expected {spec.count} values, got {values.len()}")
    }
    out := [U8]{}
    i := 0
    loop op in spec.ops {
        if op.code == 120 {
            loop _ in 0..<op.repeat -> out.push(U8{0})
            next
        }
        r := 0
        loop r < op.repeat {
            if i >= values.len() -> return Err("struct pack ran out of values")
            packed :: pack_one(op.code, spec.little, values[i])
            loop b in packed -> out.push(b)
            i = i + 1
            r = r + 1
        }
    }
    Ok(out)
}

pub fn unpack(fmt: String, data: [U8]) -> [Int] {
    spec :: parse_fmt(fmt)
    if data.len() < spec.size {
        return Err("struct unpack needs {spec.size} bytes, got {data.len()}")
    }
    out := [Int]{}
    off := 0
    loop op in spec.ops {
        if op.code == 120 {
            off = off + op.repeat
            next
        }
        r := 0
        loop r < op.repeat {
            pair :: unpack_one(op.code, spec.little, data, off)
            out.push(pair.value)
            off = pair.next
            r = r + 1
        }
    }
    Ok(out)
}

pub fn iter_unpack(fmt: String, data: [U8]) -> [[Int]] {
    size :: calcsize(fmt)
    if size <= 0 -> return Err("iter_unpack needs a positive format size")
    if data.len() %% size != 0 {
        return Err("iter_unpack buffer length is not a multiple of the format size")
    }
    rows := [[Int]]{}
    off := 0
    loop off < data.len() {
        chunk := [U8]{}
        k := 0
        loop k < size {
            chunk.push(data[off + k])
            k = k + 1
        }
        row :: unpack(fmt, chunk)
        rows.push(row)
        off = off + size
    }
    Ok(rows)
}

struct Op {
    code: Int
    repeat: Int
}

struct Spec {
    little: Bool
    size: Int
    count: Int
    ops: [Op]
}

fn parse_fmt(fmt: String) -> Spec {
    raw :: fmt.bytes()
    i := 0
    little := true
    if raw.len() > 0 {
        n :: raw[0]
        if {
            n == 60 -> {
                little = true
                i = 1
            }
            n == 62 || n == 33 -> {
                little = false
                i = 1
            }
            n == 61 -> {
                little = true
                i = 1
            }
            n == 64 -> return Err("native-alignment '@' is not supported; choose '<', '>', '!', or '=' explicitly")
        }
    }
    ops := [Op]{}
    size := 0
    count := 0
    loop i < raw.len() {
        n :: u8_int(raw[i])
        if n >= 48 && n <= 57 {
            rep := 0
            loop i < raw.len() {
                d :: u8_int(raw[i])
                if d < 48 || d > 57 -> break
                rep = rep * 10 + (d - 48)
                i = i + 1
            }
            if i >= raw.len() -> return Err("format repeat count is missing a type")
            code :: u8_int(raw[i])
            i = i + 1
            if rep < 1 -> return Err("format repeat count must be positive")
            w :: width(code) ?? return Err("unknown struct format character")
            ops.push(Op{code: code, repeat: rep})
            size = size + w * rep
            if code != 120 -> count = count + rep
            next
        }
        w :: width(n) ?? return Err("unknown struct format character")
        ops.push(Op{code: n, repeat: 1})
        size = size + w
        if n != 120 -> count = count + 1
        i = i + 1
    }
    Ok({little: little, size: size, count: count, ops: ops})
}

fn width(code: Int) -> ?Int {
    if code == {
        120 | 99 | 98 | 66 -> Val(1)
        104 | 72 -> Val(2)
        105 | 73 | 108 | 76 -> Val(4)
        113 | 81 -> Val(8)
        else -> None
    }
}

fn pack_one(code: Int, little: Bool, value: Int) -> [U8] {
    if code == 99 || code == 66 -> return pack_u8(value)
    if code == 98 -> return pack_i8(value)
    if code == 104 {
        if value < -32768 || value > 32767 -> return Err("i16 value out of range -32768..32767")
        if little -> return pack_u16le(value & 65535)
        return pack_u16be(value & 65535)
    }
    if code == 72 {
        if little -> return pack_u16le(value)
        return pack_u16be(value)
    }
    if code == 105 || code == 108 {
        if value < -2147483648 || value > 2147483647 -> return Err("i32 value out of range -2147483648..2147483647")
        if little -> return pack_u32le(value & 4294967295)
        return pack_u32be(value & 4294967295)
    }
    if code == 73 || code == 76 {
        if little -> return pack_u32le(value)
        return pack_u32be(value)
    }
    if code == 113 {
        if value < -9223372036854775808 || value > 9223372036854775807 -> return Err("i64 value out of range -9223372036854775808..9223372036854775807")
        if little -> return pack_u64le(value & 18446744073709551615)
        return pack_u64be(value & 18446744073709551615)
    }
    if little -> return pack_u64le(value)
    pack_u64be(value)
}

fn unpack_one(code: Int, little: Bool, data: [U8], offset: Int) -> (next: Int, value: Int) {
    if code == 99 || code == 66 {
        n :: unpack_u8(data, offset) ?? 0
        return (value: n, next: offset + 1)
    }
    if code == 98 {
        n :: unpack_u8(data, offset) ?? 0
        return (value: sign_extend(n, 8), next: offset + 1)
    }
    if code == 104 || code == 72 {
        n := 0
        if little -> n = unpack_u16le(data, offset) ?? 0 else -> n = unpack_u16be(data, offset) ?? 0
        if code == 104 -> n = sign_extend(n, 16)
        return (value: n, next: offset + 2)
    }
    if code == 105 || code == 73 || code == 108 || code == 76 {
        n := 0
        if little -> n = unpack_u32le(data, offset) ?? 0 else -> n = unpack_u32be(data, offset) ?? 0
        if code == 105 || code == 108 -> n = sign_extend(n, 32)
        return (value: n, next: offset + 4)
    }
    n := 0
    if little -> n = unpack_u64le(data, offset) ?? 0 else -> n = unpack_u64be(data, offset) ?? 0
    if code == 113 -> n = sign_extend(n, 64)
    (value: n, next: offset + 8)
}
