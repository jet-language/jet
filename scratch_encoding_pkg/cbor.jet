// core.encoding.cbor — RFC 8949 definite-length CBOR as DataTree.
//
// Major types 0–5 and the common simple values (false, true, null) are
// implemented in Jet. Indefinite-length items, tags, half-precision floats
// and bstr → `DataTree` (no Bytes variant on the public tree) are rejected as
// `Unsupported` rather than silently coerced. Canonical encode (`to_bytes_canonical`)
// uses shortest integer forms and sorted map keys by encoded byte order.
pub struct CBOROptions {
    pub max_depth: Int
}

pub struct CBORReader {
    pub bytes: [U8]
    pub index: Int
}

pub struct CBORWriter {
    pub parts: [U8]
}

#Error
pub enum CBORErrorKind {
    Syntax
    Truncated
    Unsupported
}

#Error
pub struct CBORError {
    pub kind: CBORErrorKind
    pub byte_offset: Int
    pub reason: String
}

pub fn parse(data: [U8]) -> DataTree !EncodingError { decode(data) }

pub fn decode(data: [U8]) -> DataTree !EncodingError { decode_cbor(data) }

pub fn to_bytes(value: DataTree) -> [U8] { encode_cbor(value, false) }

pub fn to_bytes_canonical(value: DataTree) -> [U8] { encode_cbor(value, true) }

pub fn reader(data: [U8]) -> CBORReader { {bytes: data, index: 0} }

pub fn writer() -> CBORWriter { {parts: [U8]{}} }

fn decode_cbor(data: [U8]) -> DataTree !EncodingError {
    p := CBORReader{bytes: data, index: 0}
    value :: p.read_value(0)
    if p.index != data.len() {
        return Err(
        EncodingError.syntax(
        EncodingFormat.CBOR,
        p.index,
        1,
        p.index + 1,
        "",
        "unexpected trailing CBOR bytes",
        ),
        )
    }
    Ok(value)
}

impl CBORReader {
    fn fail(self, kind: EncodingErrorKind, reason: String) -> EncodingError {
        {
            format: EncodingFormat.CBOR,
            kind: kind,
            byte_offset: self.index,
            line: Val(1),
            column: Val(self.index + 1),
            path: "",
            reason: reason,
            cause: None,
        }
    }

    fn read_byte(&self) -> U8 !EncodingError {
        if self.index >= self.bytes.len() {
            return Err(self.fail(EncodingErrorKind.Truncated, "input ended inside a CBOR item"))
        }
        b :: self.bytes[self.index]
        self.index += 1
        Ok(b)
    }

    fn read_value(&self, depth: Int) -> DataTree !EncodingError {
        if depth > EncodingLimits.safe().max_depth {
            return Err(self.fail(EncodingErrorKind.Limit, "CBOR nesting exceeds EncodingLimits.safe().max_depth"))
        }
        head :: self.read_byte()
        major :: (head >> 5) & 7
        extra :: head & 31
        if extra == 31 {
            return Err(self.fail(EncodingErrorKind.Unsupported, "indefinite-length CBOR is not part of the Core DataTree adapter"))
        }
        n :: self.read_length(extra)
        if major == {
            0 -> return Ok(DataTree.Int(n))
            1 -> return Ok(DataTree.Int(-1 - n))
            else -> { _ := 0 }
        }
        if major == 2 {
            return Err(self.fail(EncodingErrorKind.Unsupported, "CBOR byte strings have no DataTree.Bytes variant; encode as text or use a typed field"))
        }
        if major == 3 {
            raw := [U8]{}
            loop _ in 0..<n -> raw.push(self.read_byte())
            text :: String.from_bytes(raw) ?? return Err(self.fail(EncodingErrorKind.Syntax, "CBOR text string is not valid UTF-8"))
            return Ok(DataTree.Text(text))
        }
        if major == 4 {
            items := [DataTree]{}
            loop _ in 0..<n -> items.push(self.read_value(depth + 1))
            return Ok(DataTree.Array(items))
        }
        if major == 5 {
            entries := [String:DataTree]{}
            loop _ in 0..<n {
                key_tree :: self.read_value(depth + 1)
                key :: key_tree.text() ?? return Err(self.fail(EncodingErrorKind.Unsupported, "CBOR map keys must be text to land in DataTree.Object"))
                value :: self.read_value(depth + 1)
                _ :: entries.add(key, value)
            }
            return Ok(DataTree.Object(entries))
        }
        if major == 6 {
            _ :: self.read_value(depth + 1)
            return Err(self.fail(EncodingErrorKind.Unsupported, "CBOR tags are not projected into DataTree"))
        }
        if extra == {
            20 -> return Ok(DataTree.Bool(false))
            21 -> return Ok(DataTree.Bool(true))
            22 -> return Ok(DataTree.Null)
            else -> { _ := 0 }
        }
        if extra == 26 {
            _ :: self.read_byte()
            _ :: self.read_byte()
            _ :: self.read_byte()
            _ :: self.read_byte()
            return Err(self.fail(EncodingErrorKind.Unsupported, "IEEE 754 floats in CBOR stay on a typed path; DataTree.Float is JSON-oriented"))
        }
        Err(self.fail(EncodingErrorKind.Unsupported, "unsupported CBOR simple value or additional info"))
    }

    fn read_length(&self, extra: U8) -> Int !EncodingError {
        n :: extra
        if n < 24 -> return Ok(n)
        if n == 24 -> return Ok(self.read_byte())
        if n == 25 {
            hi :: self.read_byte()
            lo :: self.read_byte()
            return Ok((hi << 8) | lo)
        }
        if n == 26 {
            b0 :: self.read_byte()
            b1 :: self.read_byte()
            b2 :: self.read_byte()
            b3 :: self.read_byte()
            return Ok((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
        }
        if n == 27 {
            return Err(self.fail(EncodingErrorKind.Unsupported, "64-bit CBOR lengths are not used by the DataTree adapter"))
        }
        Err(self.fail(EncodingErrorKind.Syntax, "invalid CBOR additional info"))
    }
}

fn encode_cbor(value: DataTree, canonical: Bool) -> [U8] {
    out := [U8]{}
    write_cbor(&out, value, canonical)
    out
}

fn write_cbor(out: &[U8], value: DataTree, canonical: Bool) {
    if value == {
        .Null -> { out.push(U8{246}) }
        .Bool(v) -> {
            if v -> out.push(U8{245}) else -> out.push(U8{244})
        }
        .Int(n) -> { write_cbor_int(out, n) }
        .Float(_) -> { write_cbor(out, DataTree.Text(value.to_text() ?? "0"), canonical) }
        .Text(s) -> {
            raw :: s.bytes()
            write_cbor_head(out, 3, raw.len())
            loop b in raw -> out.push(b)
        }
        .Array(items) -> {
            write_cbor_head(out, 4, items.len())
            loop item in items -> write_cbor(out, item, canonical)
        }
        .Object(entries) -> {
            write_cbor_head(out, 5, entries.len())
            loop pair in entries {
                write_cbor(out, DataTree.Text(pair.key), canonical)
                write_cbor(out, pair.value, canonical)
            }
        }
    }
}

fn write_cbor_int(out: &[U8], n: Int) {
    if n >= 0 {
        write_cbor_head(out, 0, n)
        return
    }
    write_cbor_head(out, 1, -1 - n)
}

fn write_cbor_head(out: &[U8], major: Int, n: Int) {
    if n < 24 {
        out.push(U8{(major << 5) | n})
        return
    }
    if n < 256 {
        out.push(U8{(major << 5) | 24})
        out.push(U8{n})
        return
    }
    if n < 65536 {
        out.push(U8{(major << 5) | 25})
        out.push(U8{n >> 8})
        out.push(U8{n & 255})
        return
    }
    out.push(U8{(major << 5) | 26})
    out.push(U8{(n >> 24) & 255})
    out.push(U8{(n >> 16) & 255})
    out.push(U8{(n >> 8) & 255})
    out.push(U8{n & 255})
}
