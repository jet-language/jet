use core.math.[abs, abs_float, checked_sub, checked_mul, saturating_sub, saturating_mul, is_nan, is_inf, tau_const, hypot3, clamp_float, min_float, max_float, midpoint, gcd_many, lcm_many, powmod, sum_int, prod_int, abs_diff, even, odd, in_range, log1p, xor]

fn run() {
    print(abs(-7))
    print(abs_float(-2.5))
    print(checked_sub(10, 20))
    print(checked_mul(6, 7))
    print(saturating_sub(10, 20))
    print(saturating_mul(6, 7))
    print(is_nan(Float{0.0 / 0.0}))
    print(is_inf(Float{1.0 / 0.0}))
    print(tau_const())
    print(hypot3(2.0, 3.0, 6.0))
    print(clamp_float(12.0, 0.0, 10.0))
    print(min_float(4.0, 2.0))
    print(max_float(4.0, 2.0))
    print(midpoint(2.0, 8.0))
    print(gcd_many([Int]{18, 24, 30}))
    print(lcm_many([Int]{4, 6, 10}))
    print(powmod(2, 10, 1000))
    print(sum_int([Int]{1, 2, 3, 4}))
    print(prod_int([Int]{1, 2, 3, 4}))
    print(abs_diff(3, 10))
    print(even(8))
    print(odd(9))
    print(in_range(4, 1, 5))
    print(log1p(0.25))
    print(xor(6, 3))
}
