fn count_and_keep(n: Int, visits: Cell<Int>) Bool -> {
    return n % 2 == 0
}
fn run() {
    nums := [1, 2, 3, 4]
    mapped := nums.map((n: Int) -> n + 1)
    print(mapped)
    print(mapped.len())
    visits := Cell.new(0)
    visits_copy :: ~visits
    even := count_and_keep(2, visits_copy)
    print(even)
    print(visits.get())
    lazy_values := nums.lazy().filter((n: Int) -> n > 2).map((n: Int) -> n * 10).to_list()
    print(lazy_values)
    parts := "a,b,c".split(",")
    print(parts.to_list())
}
