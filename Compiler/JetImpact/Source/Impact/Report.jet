// Impact report records over SemIndex facts.
use {
    jet_semindex.[SemIndex, SemDefinition, SemRef, SemCall]
    jet_foundation.[foundation_json_quote]
}

ImpactEdge: struct {
    depth: Int
    caller: String
    callee: String
    module_path: String
    span_start: Int
    span_end: Int
}
ImpactRef: struct {
    depth: Int
    name: String
    module_path: String
    span_start: Int
    span_end: Int
}
ImpactReport: struct {
    symbol: String
    found: Bool
    depth_limit: Int
    definition_module: String?
    references: [ImpactRef]
    call_sites: [ImpactEdge]
    upstream_callers: [ImpactEdge]
    downstream_callees: [ImpactEdge]

    // Rust ImpactReport::analyze (44–72) over one checked program's index.
    analyze: fn(index: SemIndex, symbol: String, depth_limit: Int) -> ImpactReport Never! {
        impact_report(index.definitions, index.references, index.calls, symbol, depth_limit)
    }

    // Rust ImpactReport::to_json and nested edge_json/ref_json (74–115).
    // Rust json_str (266–282) shares Foundation's exact quote contract, including
    // DEL/C1 controls and lowercase \u0008/\u000c rather than debug quoting.
    to_json: fn(self) -> String Never! {
        refs: loop reference in self.references -> impact_ref_json(reference)
        sites: loop edge in self.call_sites -> impact_edge_json(edge)
        upstream: loop edge in self.upstream_callers -> impact_edge_json(edge)
        downstream: loop edge in self.downstream_callees -> impact_edge_json(edge)
        definition_module: if self.definition_module == {
            .Val(module_path) -> foundation_json_quote(module_path)
            .None -> "null"
        }
        found: if self.found -> "true" else -> "false"
        "{{\"symbol\":{foundation_json_quote(self.symbol)},\"found\":{found},\"depth_limit\":{self.depth_limit},\"definition_module\":{definition_module},\"references\":[{refs.join(",")}],\"call_sites\":[{sites.join(",")}],\"upstream_callers\":[{upstream.join(",")}],\"downstream_callees\":[{downstream.join(",")}]}}"
    }

    // Rust ImpactReport::render_text (117–170): preserve ordering and whitespace.
    render_text: fn(self) -> String Never! {
        out := ""
        if !self.found {
            out = "symbol `{self.symbol}` not found in index\n"
            if self.references.len() != 0 || self.call_sites.len() != 0 {
                out = "{out}partial matches from name references/calls:\n"
            } else {
                return out
            }
        } else {
            out = "blast radius for `{self.symbol}`"
            if self.definition_module == .Val(module_path) -> out = "{out} (defined in {module_path})"
            out = "{out}\n"
        }
        out = "{out}  references:        {self.references.len()}\n"
        out = "{out}  direct call sites: {self.call_sites.len()}\n"
        out = "{out}  upstream callers:  {self.upstream_callers.len()} (depth <= {self.depth_limit})\n"
        out = "{out}  downstream callees:{self.downstream_callees.len()} (depth <= {self.depth_limit})\n"
        loop reference in self.references -> out = "{out}  ref  {reference.module_path}:{reference.span_start}..{reference.span_end}\n"
        loop edge in self.call_sites -> out = "{out}  call {edge.caller} -> {edge.callee} @ {edge.module_path}:{edge.span_start}..{edge.span_end}\n"
        loop edge in self.upstream_callers -> out = "{out}  upstream[d{edge.depth}] {edge.caller} -> {edge.callee} @ {edge.module_path}\n"
        loop edge in self.downstream_callees -> out = "{out}  downstream[d{edge.depth}] {edge.caller} -> {edge.callee} @ {edge.module_path}\n"
        out
    }
}

// The report over an index's definition, reference and call rows. All
// queries retain the original name, even when qualified resolution finds a
// definition by its leaf spelling; depth zero still reports direct uses.
impact_report: fn(definitions: [SemDefinition], references: [SemRef], calls: [SemCall], symbol: String, depth_limit: Int) -> ImpactReport Never! {
    definition_module: impact_resolve_module(definitions, symbol)
    found: definition_module != None
    direct_references := [ImpactRef]{}
    loop reference in references {
        if reference.name == symbol -> direct_references.push(impact_ref_to_impact(reference, 1))
    }
    call_sites := [ImpactEdge]{}
    loop call in calls {
        if call.callee == symbol -> call_sites.push(impact_edge_to_impact(call, 1))
    }
    upstream_callers := [ImpactEdge]{}
    downstream_callees := [ImpactEdge]{}
    if found {
        upstream_callers = impact_transitive_edges(calls, symbol, depth_limit, true)
        downstream_callees = impact_transitive_edges(calls, symbol, depth_limit, false)
    }
    ImpactReport{
        symbol: symbol.copy(), found, depth_limit, definition_module,
        references: direct_references.move(), call_sites: call_sites.move(),
        upstream_callers: upstream_callers.move(), downstream_callees: downstream_callees.move(),
    }
}

// Rust resolve_symbol (173–180): split at the last `.`; the first definition
// whose module is that prefix, or ends with it, is the symbol. An unqualified
// query is the first definition of that name.
impact_resolve_module: fn(definitions: [SemDefinition], query: String) -> String? Never! {
    bytes: query.bytes()
    separator := -1
    loop position in 0..<bytes.len() {
        if bytes[position] == (U8{46}) -> separator = position
    }
    if separator < 0 {
        loop definition in definitions {
            if definition.def.name == query -> return Val(definition.def.module_path.copy())
        }
        return None
    }
    module_path: String.from_bytes(bytes[0..<separator]) ?? panic("separator is an ASCII UTF-8 boundary")
    name: String.from_bytes(bytes[(separator + 1)..<bytes.len()]) ?? panic("separator is an ASCII UTF-8 boundary")
    loop definition in definitions {
        if definition.def.name == name && (definition.def.module_path == module_path || definition.def.module_path.ends_with(module_path)) {
            return Val(definition.def.module_path.copy())
        }
    }
    None
}

// Rust seen (caller, callee) identity and VecDeque frontier (198–243).
// Named records avoid tuple Debug/Show emission defect #4357; no location is
// part of identity. Queue is Core's ring buffer, not a shifting front removal.
ImpactEdgeKey: struct { caller: String, callee: String }
ImpactFrontier: struct { name: String, depth: Int }

// Breadth-first over the call rows from `start`: `upstream` follows calls into
// the frontier name (its callers), otherwise calls out of it (its callees).
// Each (caller, callee) pair is reported once, at its shortest depth.
impact_transitive_edges: fn(calls: [SemCall], start: String, depth_limit: Int, upstream: Bool) -> [ImpactEdge] Never! {
    out := [ImpactEdge]{}
    seen_edges := [ImpactEdgeKey:Bool]{}
    frontier := Queue<ImpactFrontier>.new()
    frontier.push_back(ImpactFrontier{name: start.copy(), depth: 0})
    loop {
        current: (frontier.pop_front()) ?? break
        if current.depth >= depth_limit -> next
        loop call in calls {
            if upstream && call.callee != current.name -> next
            if !upstream && call.caller != current.name -> next
            key: ImpactEdgeKey{caller: call.caller.copy(), callee: call.callee.copy()}
            if seen_edges.has_key(key) -> next
            seen_edges[key] = true
            next_depth: current.depth + 1
            out.push(impact_edge_to_impact(call, next_depth))
            reached: if upstream -> call.caller.copy() else -> call.callee.copy()
            frontier.push_back(ImpactFrontier{name: reached, depth: next_depth})
        }
    }
    out
}

// Rust ref_to_impact/edge_to_impact (245–264): byte spans are never re-sliced.
impact_ref_to_impact: fn(reference: SemRef, depth: Int) -> ImpactRef Never! {
    ImpactRef{depth, name: reference.name.copy(), module_path: reference.module_path.copy(),
        span_start: reference.span.start, span_end: reference.span.end}
}
impact_edge_to_impact: fn(call: SemCall, depth: Int) -> ImpactEdge Never! {
    ImpactEdge{depth, caller: call.caller.copy(), callee: call.callee.copy(), module_path: call.module_path.copy(),
        span_start: call.span.start, span_end: call.span.end}
}
impact_edge_json: fn(edge: ImpactEdge) -> String Never! {
    "{{\"depth\":{edge.depth},\"caller\":{foundation_json_quote(edge.caller)},\"callee\":{foundation_json_quote(edge.callee)},\"module_path\":{foundation_json_quote(edge.module_path)},\"span\":{{\"start\":{edge.span_start},\"end\":{edge.span_end}}}}}"
}
impact_ref_json: fn(reference: ImpactRef) -> String Never! {
    "{{\"depth\":{reference.depth},\"name\":{foundation_json_quote(reference.name)},\"module_path\":{foundation_json_quote(reference.module_path)},\"span\":{{\"start\":{reference.span_start},\"end\":{reference.span_end}}}}}"
}
