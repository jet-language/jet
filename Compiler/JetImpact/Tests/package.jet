name: "jet_impact_tests"
version: "0.0.1"
edition: "2026"
deps: {
    jet_impact: ../../JetImpact,
    jet_foundation: ../../JetFoundation,
    jet_semindex: ../../JetSemIndex,
    // jet_semindex's Jetpack packages sit outside Compiler/, so the root names them too (E1223).
    jet_pkg_model: ../../../Jetpack/PackageModel,
    jet_env_model: ../../../Jetpack/EnvModel,
    jetpack_foundation: ../../../Jetpack/Foundation,
}
