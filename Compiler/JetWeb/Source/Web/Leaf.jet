// The `#FFI(asm)` leaves of the backend's Linux layer (JetBackend OS/Linux.jet)
// as WebAssembly, each with its template's meaning: a memory access is the
// same access of linear memory, a system call goes to the host's `syscall`
// import with the same number and arguments, and a stack word the template
// lends to the kernel lives in the scratch bytes below the stack pointer
// (WEB_SCRATCH). The machine's single thread makes every atomic a plain
// read-modify-write. Calls through a code address are `call_indirect`
// through the module table.

use jet_ir.[IRFunction, IRModule]

// The host's system call: number and six arguments.
WEB_SYSCALL_SIG: "lllllll:l"

web_host_syscall: fn(e: &WebEmitter, st: &WebState) Never! {
    web_call(e, web_ref(st, "host", "syscall", WEB_SYSCALL_SIG))
}

// t3 := the scratch bytes' address.
web_scratch: fn(e: &WebEmitter) Never! {
    web_global_get(e, WEB_GLOBAL_SP)
    web_i64(e, WEB_SCRATCH)
    web_op(e, 0x7d)
    scratch: e.t3
    web_set(e, scratch)
}

// Pushes local `local` (an i64 address) as an i32 address.
web_at: fn(e: &WebEmitter, local: Int) Never! {
    web_get(e, local)
    web_wrap(e)
}

// Scratch word `offset` := local `local`.
web_scratch_put: fn(e: &WebEmitter, offset: Int, local: Int) Never! {
    scratch: e.t3
    web_at(e, scratch)
    web_get(e, local)
    web_mem(e, 0x37, offset)
}

// Scratch word `offset` := `value`.
web_scratch_const: fn(e: &WebEmitter, offset: Int, value: Int) Never! {
    scratch: e.t3
    web_at(e, scratch)
    web_i64(e, value)
    web_mem(e, 0x37, offset)
}

// Zeroes `count` scratch bytes.
web_scratch_zero: fn(e: &WebEmitter, count: Int) Never! {
    scratch: e.t3
    web_at(e, scratch)
    web_i32(e, 0)
    web_i32(e, count)
    web_memory_fill(e)
}

// Word `to` at local `output` := scratch word `from`.
web_scratch_out: fn(e: &WebEmitter, output: Int, to: Int, from: Int) Never! {
    web_at(e, output)
    scratch: e.t3
    web_at(e, scratch)
    web_mem(e, 0x29, from)
    web_mem(e, 0x37, to)
}

// Pushes `count` zero arguments.
web_zeros: fn(e: &WebEmitter, count: Int) Never! {
    loop _ in 0..<count -> web_i64(e, 0)
}

// Pushes `base` - `scale` * (local `count` - 1): the first unit of a run
// whose last starts at local `last`.
web_run_start: fn(e: &WebEmitter, last: Int, count: Int, scale: Int) Never! {
    web_get(e, last)
    web_get(e, count)
    web_i64(e, 1)
    web_op(e, 0x7d)
    web_i64(e, scale)
    web_op(e, 0x7e)
    web_op(e, 0x7d)
    web_wrap(e)
}

// Pushes `old` := the word at local `address` and leaves it in t0.
web_read_old: fn(e: &WebEmitter, address: Int) Never! {
    web_at(e, address)
    web_mem(e, 0x29, 0)
    old: e.t0
    web_set(e, old)
}

// The leaf `name` over argument locals `args` (each an i64): its value on
// the stack when `result`. False when the web target has no form of it.
web_leaf: fn(e: &WebEmitter, st: &WebState, name: String, args: [Int], result: Bool) -> Bool Never! {
    if name.starts_with("os_call") -> return web_leaf_call(e, st, args, result)
    // The scratch address (web_scratch) and the old word (web_read_old).
    scratch: e.t3
    old: e.t0
    if name == {
        "os_load_i64" | "os_load_word" -> {
            web_at(e, args[0])
            web_mem(e, 0x29, 0)
        }
        "os_store_i64" | "os_store_word" -> {
            web_at(e, args[0])
            web_get(e, args[1])
            web_mem(e, 0x37, 0)
        }
        "os_load_u8" | "os_load_byte" -> {
            web_at(e, args[0])
            web_mem(e, 0x31, 0)
        }
        "os_store_u8" | "os_store_byte" -> {
            web_at(e, args[0])
            web_get(e, args[1])
            web_mem(e, 0x3c, 0)
        }
        "os_cas_i64" -> {
            web_read_old(e, args[0])
            web_get(e, old)
            web_get(e, args[1])
            web_op(e, 0x51)
            web_if(e)
            web_at(e, args[0])
            web_get(e, args[2])
            web_mem(e, 0x37, 0)
            web_end(e)
            web_get(e, old)
        }
        "os_swap_i64" -> {
            web_read_old(e, args[0])
            web_at(e, args[0])
            web_get(e, args[1])
            web_mem(e, 0x37, 0)
            web_get(e, old)
        }
        "os_fetch_add_i64" -> {
            web_read_old(e, args[0])
            web_at(e, args[0])
            web_get(e, old)
            web_get(e, args[1])
            web_op(e, 0x7c)
            web_mem(e, 0x37, 0)
            web_get(e, old)
        }
        "os_spin_pause" -> {}
        // No processor feature is reported: every feature-gated path takes
        // its portable form.
        "os_cpuid_eax_i64" | "os_cpuid_ebx_i64" | "os_cpuid_ecx_i64" | "os_cpuid_edx_i64" | "os_xgetbv_i64" -> web_i64(e, 0)
        // Only a caller that saw the SHA extensions in cpuid runs this leaf,
        // and no web host reports them.
        "os_sha256_block_i64" -> web_op(e, 0x00)
        // Likewise AES-NI and PCLMULQDQ: only a caller that saw them in
        // cpuid runs these leaves.
        "os_aes_encrypt4_10_i64" | "os_aes_encrypt4_12_i64" | "os_aes_encrypt4_14_i64" | "os_aes_decrypt4_10_i64" | "os_aes_decrypt4_12_i64" | "os_aes_decrypt4_14_i64" | "os_aes_encrypt1_10_i64" | "os_aes_encrypt1_12_i64" | "os_aes_encrypt1_14_i64" | "os_ghash1_i64" | "os_ghash4_i64" -> web_op(e, 0x00)
        // Only a carrier thread switches fibers or moves GS, and the web
        // target starts no thread (clone below refuses).
        "os_fiber_switch_i64" | "os_gs_base_write_i64" -> web_op(e, 0x00)
        // The web host delivers no signal to a handler, so no restorer runs.
        "os_signal_return" -> web_op(e, 0x00)
        "os_stack_address_i64" -> web_global_get(e, WEB_GLOBAL_SP)
        "os_copy_ascending_i64" -> {
            web_at(e, args[0])
            web_at(e, args[1])
            web_at(e, args[2])
            web_memory_copy(e)
        }
        "os_copy_descending_bytes_i64" -> {
            web_run_start(e, args[0], args[2], 1)
            web_run_start(e, args[1], args[2], 1)
            web_at(e, args[2])
            web_memory_copy(e)
        }
        "os_copy_descending_words_i64" -> {
            web_run_start(e, args[0], args[2], 8)
            web_run_start(e, args[1], args[2], 8)
            web_get(e, args[2])
            web_i64(e, 8)
            web_op(e, 0x7e)
            web_wrap(e)
            web_memory_copy(e)
        }
        // count words from target, each the word: an i64.store loop over
        // the leaf's own address and count copies (t0, t1).
        "os_fill_words_i64" -> {
            at: e.t0
            left: e.t1
            web_get(e, args[0])
            web_set(e, at)
            web_get(e, args[2])
            web_set(e, left)
            web_op(e, 0x02)
            web_op(e, WEB_VOID)
            web_op(e, 0x03)
            web_op(e, WEB_VOID)
            // Leave once no word is left.
            web_get(e, left)
            web_i64(e, 0)
            web_op(e, 0x57)
            web_op(e, 0x0d)
            web_op(e, 1)
            web_at(e, at)
            web_get(e, args[1])
            web_mem(e, 0x37, 0)
            web_get(e, at)
            web_i64(e, 8)
            web_op(e, 0x7c)
            web_set(e, at)
            web_get(e, left)
            web_i64(e, 1)
            web_op(e, 0x7d)
            web_set(e, left)
            web_op(e, 0x0c)
            web_op(e, 0)
            web_end(e)
            web_end(e)
        }
        // The reduce leaves (JetIR OptReduce.jet) decline every run here
        // (2^62, never an inline Int), so the Loop after the call runs every pass.
        "rt_int_sum" | "rt_count_bytes" | "rt_count_ints" | "rt_count_words" | "rt_count_widened" | "rt_fill_1" | "rt_fill_2" | "rt_fill_4" | "rt_fill_8" | "rt_fill_ints" -> web_i64(e, 4611686018427387904)
        "os_tls_base_i64" -> {
            web_global_get(e, WEB_GLOBAL_TLS)
            web_wrap(e)
            web_mem(e, 0x29, 0)
        }
        // ARCH_GET_GS into a zeroed word, or'd into the call's result.
        "os_tls_base_probe_i64" -> {
            web_scratch(e)
            web_scratch_const(e, 0, 0)
            web_i64(e, 158)
            web_i64(e, 4100)
            web_get(e, scratch)
            web_zeros(e, 4)
            web_host_syscall(e, st)
            web_at(e, scratch)
            web_mem(e, 0x29, 0)
            web_op(e, 0x84)
        }
        "os_syscall" | "os_syscall_i64" -> {
            loop local in args -> web_get(e, local)
            web_host_syscall(e, st)
        }
        // write(fd, word, count).
        "os_write_word_i64" -> {
            web_scratch(e)
            web_scratch_put(e, 0, args[1])
            web_i64(e, 1)
            web_get(e, args[0])
            web_get(e, scratch)
            web_get(e, args[2])
            web_zeros(e, 3)
            web_host_syscall(e, st)
        }
        // writev(fd, [{bytes, length}, {&LF, 1}], 2).
        "os_write_line_i64" -> {
            web_scratch(e)
            web_scratch_put(e, 0, args[1])
            web_scratch_put(e, 8, args[2])
            web_at(e, scratch)
            web_get(e, scratch)
            web_i64(e, 32)
            web_op(e, 0x7c)
            web_mem(e, 0x37, 16)
            web_scratch_const(e, 24, 1)
            web_scratch_const(e, 32, 10)
            web_i64(e, 20)
            web_get(e, args[0])
            web_get(e, scratch)
            web_i64(e, 2)
            web_zeros(e, 3)
            web_host_syscall(e, st)
        }
        // number(a1, [w0, w1, w2, w3], 0, a4, w2, w3).
        "os_syscall_stack4_i64" -> {
            web_scratch(e)
            web_scratch_put(e, 0, args[2])
            web_scratch_put(e, 8, args[3])
            web_scratch_put(e, 16, args[4])
            web_scratch_put(e, 24, args[5])
            web_get(e, args[0])
            web_get(e, args[1])
            web_get(e, scratch)
            web_i64(e, 0)
            web_get(e, args[6])
            web_get(e, args[4])
            web_get(e, args[5])
            web_host_syscall(e, st)
        }
        // linkat(source, "", directory, name, AT_EMPTY_PATH).
        "os_link_fd_i64" -> {
            web_scratch(e)
            web_scratch_const(e, 0, 0)
            web_i64(e, 265)
            web_get(e, args[0])
            web_get(e, scratch)
            web_get(e, args[1])
            web_get(e, args[2])
            web_i64(e, 4096)
            web_i64(e, 0)
            web_host_syscall(e, st)
        }
        // ioctl(fd, request, word).
        "os_ioctl_word_i64" -> {
            web_scratch(e)
            web_scratch_put(e, 0, args[2])
            web_i64(e, 16)
            web_get(e, args[0])
            web_get(e, args[1])
            web_get(e, scratch)
            web_zeros(e, 3)
            web_host_syscall(e, st)
        }
        // number(object, stat144) into the portable 128-byte row.
        "os_stat_packed_i64" -> {
            web_scratch(e)
            web_scratch_zero(e, 144)
            web_get(e, args[0])
            web_get(e, args[1])
            web_get(e, scratch)
            web_zeros(e, 4)
            web_host_syscall(e, st)
            web_set(e, old)
            output: args[2]
            moves: [Int]{0, 0, 8, 8, 16, 24, 24, 16, 32, 24, 40, 32, 48, 40, 56, 48, 64, 72, 72, 80, 80, 88, 88, 96, 96, 104, 104, 112, 112, 64, 120, 56}
            index := 0
            loop index < moves.len() {
                web_scratch_out(e, output, moves[index], moves[index + 1])
                index += 2
            }
            web_get(e, old)
        }
        // statx(directory, path, flags, STATX_BTIME, statx256): the birth
        // time's seconds and nanoseconds after the result mask.
        "os_statx_created_i64" -> {
            web_scratch(e)
            web_scratch_zero(e, 256)
            web_i64(e, 332)
            web_get(e, args[0])
            web_get(e, args[1])
            web_get(e, args[2])
            web_i64(e, 2048)
            web_get(e, scratch)
            web_i64(e, 0)
            web_host_syscall(e, st)
            web_set(e, old)
            web_scratch_out(e, args[3], 0, 0)
            web_scratch_out(e, args[3], 8, 80)
            web_scratch_out(e, args[3], 16, 88)
            web_get(e, old)
        }
        // clone(flags, stack, parent_tid, child_tid, 0): the host runs one
        // thread and refuses.
        "os_clone_i64" -> {
            web_i64(e, 56)
            web_get(e, args[0])
            web_get(e, args[1])
            web_get(e, args[2])
            web_get(e, args[3])
            web_zeros(e, 2)
            web_host_syscall(e, st)
        }
        else -> return false
    }
    true
}

// A call through code address `args[0]` with the other arguments. Every
// table function returns a word (web_slot_sig); a call without a result drops it.
web_leaf_call: fn(e: &WebEmitter, st: &WebState, args: [Int], result: Bool) -> Bool Never! {
    if args.len() == 0 -> return false
    letters := ""
    loop index in 1..<args.len() {
        web_get(e, args[index])
        letters = "{letters}l"
    }
    web_get(e, args[0])
    web_call_indirect(e, st, "{letters}:l")
    if !result -> web_op(e, 0x1a)
    true
}

// An asm leaf's own body, for its address or a call the selector does not
// inline: the leaf over its parameters.
web_leaf_body: fn(st: &WebState, m: IRModule, f: IRFunction) -> WebBody Never! {
    e := web_emitter(m, f)
    args := [Int]{}
    loop slot in 0..<f.param_count -> args.push(e.locals[slot])
    if !web_leaf(e, st, f.name, args, f.result >= 0) {
        st.errors.push("{f.name}: the web target has no form of this asm leaf")
        web_op(e, 0x00)
    }
    web_finish(e)
}

// A stop poll (JetIR Build.jet ir_stop_poll): the attached thread's TCB
// (the word WEB_GLOBAL_TLS names), its task control (word 16), the
// control's status (word 32); with a status, or under a strong pause
// (pauseMode, word 24: JetRuntime Scheduler.jet scheduler_check_loops),
// jet_rt_session_propagate's delivered stop as a Bool, else 0.
web_poll_body: fn(st: &WebState, m: IRModule, f: IRFunction) -> WebBody Never! {
    e := web_emitter(m, f)
    web_global_get(e, WEB_GLOBAL_TLS)
    web_wrap(e)
    web_mem(e, 0x29, 0)
    word: e.t0
    web_set(e, word)
    web_poll_quiet_unless(e, word)
    web_at(e, word)
    web_mem(e, 0x29, 16)
    web_set(e, word)
    web_poll_quiet_unless(e, word)
    web_at(e, word)
    web_mem(e, 0x29, 24)
    web_op(e, 0x50)
    web_if(e)
    web_at(e, word)
    web_mem(e, 0x29, 32)
    web_set(e, word)
    web_poll_quiet_unless(e, word)
    web_end(e)
    resolved: web_symbol(st, "jet_rt_session_propagate", ":l")
    web_call(e, resolved.callee)
    web_i64(e, 0)
    web_op(e, 0x52)
    web_op(e, 0xad)
    web_finish(e)
}

// `if word == 0 { return 0 }`.
web_poll_quiet_unless: fn(e: &WebEmitter, word: Int) Never! {
    web_get(e, word)
    web_op(e, 0x50)
    web_if(e)
    web_i64(e, 0)
    web_op(e, 0x0f)
    web_end(e)
}
