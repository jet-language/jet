// The generated JavaScript host of a web build (Module.jet): `app.js`, the
// program's entry, and `jet_dom_runtime.js`, which owns the memory, table and
// globals both modules import and answers their Linux system calls (the
// runtime's one platform boundary, as the native kernel does) and the C
// library calls the runtime makes (WEB_HOST_C). Under node the file system
// is the host's; a page has no file system, so those calls fail with ENOSYS.

use {
    jet_ir.[IR_HOST_PROVIDER]
}

// The C functions the host provides, each as the runtime's IR calls it.
WEB_HOST_C: [String]{
    "getauxval", "pthread_attr_destroy", "pthread_attr_init", "pthread_attr_setstacksize",
    "pthread_create", "pthread_detach", "pthread_join",
}

// Each host C function: true when it replaces the runtime's own definition,
// as each leaf of the UI provider seam (IR_HOST_PROVIDER) does: the host
// forwards it to the page's browser provider.
web_host_functions: fn() -> [String:Bool] Never! {
    hosts := [String:Bool]{}
    loop name in WEB_HOST_C -> hosts[name.copy()] = false
    loop name in IR_HOST_PROVIDER -> hosts[name.copy()] = true
    hosts
}

// `web.manifest.json`: the two partitions (Module.jet WebLayout) the host
// lays out.
web_manifest: fn(runtime_end: Int, runtime_slots: Int, app_base: Int, app_end: Int, app_slots: Int) -> String Never! {
    lines: [String]{
        "{{",
        "  \"target\": \"web\",",
        "  \"entry\": \"app.js\",",
        "  \"host\": \"jet_dom_runtime.js\",",
        "  \"partitions\": [",
        "    {{\"name\": \"runtime\", \"module\": \"rt.wasm\", \"data_base\": {WEB_DATA_BASE}, \"data_end\": {runtime_end}, \"table_base\": 0, \"slots\": {runtime_slots}}},",
        "    {{\"name\": \"app\", \"module\": \"app.wasm\", \"data_base\": {app_base}, \"data_end\": {app_end}, \"table_base\": {runtime_slots}, \"slots\": {app_slots}}}",
        "  ]",
        "}}",
        "",
    }
    lines.join("\n")
}

WEB_APP_JS: comptime { ```// Generated by `jet build --target web`: the program's entry. `node app.js`
// runs it, and so does the page that loads it with `data-jet-run`
// (index.html); a harness imports `jet_main`.
import { JetHostExitError, runMain, runProgram } from "./jet_dom_runtime.js";

const wasm = new URL("./app.wasm", import.meta.url);

// Resolves when the program exits 0. Rejects with JetHostExitError (its
// `status`) when the program exits otherwise, JetHostWasmError when it traps.
export async function jet_main() {
  const status = await runProgram(wasm);
  if (status !== 0) throw new JetHostExitError(status);
}

if (import.meta.main || globalThis.document?.querySelector?.("script[data-jet-run]")) await runMain(wasm);
``` }

// `index.html`: the default page, which loads app.js as a module that runs
// the program.
WEB_INDEX_HTML: comptime { ```<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jet app</title>
</head>
<body>
<script type="module" src="./app.js" data-jet-run></script>
</body>
</html>
``` }

WEB_DOM_RUNTIME_JS: comptime { ```// Generated by `jet build --target web`: the host of a Jet program's two
// WebAssembly modules, the runtime partition and the program partition
// (web.manifest.json). It owns the linear memory, the function table and the
// globals both import, and answers their Linux system calls and C library
// calls. Under node the file system is the host's; a page has none.

export class JetHostAbiError extends Error {
  constructor(message, options) {
    super(message, options);
    this.name = "JetHostAbiError";
  }
}

export class JetHostWasmError extends Error {
  constructor(message, options) {
    super(message, options);
    this.name = "JetHostWasmError";
  }
}

export class JetHostExitError extends Error {
  constructor(status) {
    super("the program exited with status " + status);
    this.name = "JetHostExitError";
    this.status = status;
  }
}

// An exit or exit_group: unwinds the modules to the host.
class JetHostExit {
  constructor(status) {
    this.status = status;
  }
}

const nodeProcess = globalThis.process?.versions?.node ? globalThis.process : null;
const fs = nodeProcess ? await import("node:fs") : null;
const PAGE = 65536;
const STACK = 8 * 1024 * 1024;
const AUX_RANDOM = 496;
const TRAP_STATUS = 134;
const E = {
  PERM: 1, NOENT: 2, SRCH: 3, INTR: 4, IO: 5, BADF: 9, CHILD: 10, AGAIN: 11, NOMEM: 12, ACCES: 13,
  EXIST: 17, XDEV: 18, NODEV: 19, NOTDIR: 20, INVAL: 22, MFILE: 24, NOTTY: 25, SPIPE: 29, RANGE: 34,
  NOSYS: 38, NOTSUP: 95, TIMEDOUT: 110,
};
const encoder = new TextEncoder();
const decoder = new TextDecoder();
const hosts = new WeakMap();
const sleeper = new Int32Array(new SharedArrayBuffer(4));

function alignUp(value, align) {
  return Math.ceil(value / align) * align;
}

function sleep(milliseconds) {
  if (milliseconds <= 0) return;
  try {
    Atomics.wait(sleeper, 0, 0, milliseconds);
  } catch {
    // A page's main thread cannot block; the sleep returns at once.
  }
}

// A core.ui.host provider record: each field is its UTF-8 byte length in
// decimal, `:`, then its text, so any text survives (Core/Ui/Host.jet).
function providerRecord(fields) {
  return fields.map((field) => encoder.encode(field).length + ":" + field).join("");
}

// The page's default core.ui.host provider, installed when the page set none.
// It forwards browser primitives only, raw event types and values included;
// Core decodes and judges every answer. Composition events queue on 0,
// drag/drop events on 1 and claimed key presses on 2 for event_pop, each in a
// host buffer of UI_QUEUE records; a full buffer drops further events behind
// one empty record, which Core reports as a full queue. A key claim is
// `<modifier mask>:<lowercased key>`, the mask Control 1, Alt 2, Shift 4 and
// Meta 8: a keydown matching a claim loses its browser default and queues,
// and every other key keeps its default. The clipboard is the text this page last
// observed through a paste, copy or cut, or its own write: a browser lends the
// live clipboard only to a user gesture, and a write's later refusal by the
// browser is not seen. File dialogs and font shaping are absent: a file input
// answers later than the synchronous seam and gives no filesystem path.
const UI_QUEUE = 256;

function defaultUiProvider(doc) {
  const queues = [[], [], []];
  const claims = new Set();
  let clipboard = null;
  const enqueue = (queue, fields) => {
    const records = queues[queue];
    if (records.length < UI_QUEUE) records.push(providerRecord(fields));
    else if (records.at(-1) !== "") records.push("");
  };
  const target = (event) => String(event.target?.id ?? "");
  // A composition reports no caret or marked range of its own.
  const composition = (event) => enqueue(0, [target(event), event.type, event.data ?? "", "", "", "", ""]);
  doc.addEventListener("compositionstart", composition);
  doc.addEventListener("compositionupdate", composition);
  doc.addEventListener("compositionend", composition);
  // A page accepts a drop by cancelling dragover; the dropped data is
  // readable only on drop.
  const drag = (event) => {
    if (event.type === "dragover" || event.type === "drop") event.preventDefault();
    const data = event.dataTransfer;
    const dropped = event.type === "drop" && data;
    enqueue(1, [
      target(event),
      event.type,
      data?.dropEffect ?? "none",
      dropped ? data.getData("text/plain") : "",
      dropped ? data.getData("text/uri-list") : "",
    ]);
  };
  doc.addEventListener("dragenter", drag);
  doc.addEventListener("dragover", drag);
  doc.addEventListener("drop", drag);
  doc.addEventListener("dragleave", drag);
  const keydown = (event) => {
    const mask = (event.ctrlKey ? 1 : 0) | (event.altKey ? 2 : 0) | (event.shiftKey ? 4 : 0) | (event.metaKey ? 8 : 0);
    const key = String(event.key ?? "");
    if (!claims.has(mask + ":" + key.toLowerCase())) return;
    event.preventDefault();
    enqueue(2, [target(event), key, String(mask)]);
  };
  doc.addEventListener("keydown", keydown);
  // Paste carries the pasted text; copy and cut carry what the page set, else
  // the selection the browser copies.
  const observe = (event) => {
    const text = event.clipboardData?.getData("text/plain") ?? "";
    if (event.type === "paste" || text !== "") clipboard = text;
    else if (!event.defaultPrevented) clipboard = String(doc.getSelection?.() ?? "");
  };
  doc.addEventListener("paste", observe);
  doc.addEventListener("copy", observe);
  doc.addEventListener("cut", observe);
  return {
    capability: (code) => code >= 1 && code <= 5,
    clipboardGet: () => clipboard,
    clipboardSet: (text) => {
      const system = globalThis.navigator?.clipboard;
      if (!system?.writeText) return false;
      clipboard = text;
      system.writeText(text).catch(() => {});
      return true;
    },
    eventPop: (queue) => queues[queue]?.shift() ?? null,
    dialogRequest: () => -1,
    dialogResult: () => null,
    keyClaim: (claim) => {
      claims.add(claim);
      return true;
    },
  };
}

function nowNanoseconds(clock) {
  if (clock === 0 || clock === 8 || clock === 11) {
    return BigInt(Date.now()) * 1000000n + BigInt(Math.floor((performance.now() % 1) * 1000000));
  }
  if (clock === 2 || clock === 3) {
    if (!nodeProcess) return BigInt(Math.round(performance.now() * 1000000));
    const usage = nodeProcess.cpuUsage();
    return BigInt(usage.user + usage.system) * 1000n;
  }
  return nodeProcess ? nodeProcess.hrtime.bigint() : BigInt(Math.round(performance.now() * 1000000));
}

async function load(url) {
  if (fs && url.protocol === "file:") return fs.readFileSync(url);
  const response = await fetch(url);
  if (!response.ok) throw new JetHostAbiError("cannot load " + url.href + ": HTTP " + response.status);
  return new Uint8Array(await response.arrayBuffer());
}

class Host {
  constructor(manifest) {
    this.runtime = manifest.partitions?.find((partition) => partition.name === "runtime");
    this.program = manifest.partitions?.find((partition) => partition.name === "app");
    if (!this.runtime || !this.program) throw new JetHostAbiError("web.manifest.json names no runtime and app partitions");
    this.stackTop = alignUp(this.program.data_end, PAGE) + STACK;
    this.memory = new WebAssembly.Memory({ initial: this.stackTop / PAGE });
    this.table = new WebAssembly.Table({ element: "anyfunc", initial: this.program.table_base + this.program.slots });
    this.sp = new WebAssembly.Global({ value: "i64", mutable: true }, BigInt(this.stackTop));
    this.tls = new WebAssembly.Global({ value: "i64", mutable: true }, 0n);
    this.edx = new WebAssembly.Global({ value: "i32", mutable: true }, 0);
    this.unmapped = [];
    this.files = new Map();
    this.lines = ["", "", ""];
    this.outcome = null;
    this.dom = false;
    crypto.getRandomValues(new Uint8Array(this.memory.buffer, AUX_RANDOM, 16));
  }

  static async open(url, args, environment) {
    // A page gets the default core.ui.host provider unless it installed one.
    if (globalThis.document?.addEventListener && globalThis.jetUiProvider === undefined) {
      globalThis.jetUiProvider = defaultUiProvider(globalThis.document);
    }
    const base = new URL(".", url);
    const manifest = JSON.parse(decoder.decode(await load(new URL("web.manifest.json", base))));
    const host = new Host(manifest);
    host.rt = (await host.instantiate(new URL(host.runtime.module, base), {})).exports;
    host.app = (await host.instantiate(url, { rt: host.rt })).exports;
    host.enter(() => host.rt.jet_web_init());
    // A page (or a DOM harness) shows the core.ui scene the program paints.
    if (globalThis.document?.createElement && globalThis.document.body) {
      host.dom = true;
      host.enter(() => host.rt.jet_ui_web_attach());
    }
    const [argc, argv, envp] = host.place(args, environment);
    host.enter(() => host.rt.jet_rt_host_arguments(BigInt(argc), BigInt(argv), BigInt(envp)));
    return host;
  }

  async instantiate(url, extra) {
    const bytes = await load(url);
    const imports = {
      env: { memory: this.memory, table: this.table, sp: this.sp, tls: this.tls, edx: this.edx },
      host: {
        syscall: (n, a, b, c, d, e, f) => BigInt(this.syscall(Number(n), Number(a), Number(b), Number(c), Number(d), Number(e), Number(f)) ?? 0),
      },
      c: this.cLibrary(),
      ...extra,
    };
    try {
      return (await WebAssembly.instantiate(bytes, imports)).instance;
    } catch (error) {
      throw new JetHostAbiError("cannot instantiate " + url.href + ": " + error.message, { cause: error });
    }
  }

  u8() {
    return new Uint8Array(this.memory.buffer);
  }

  view() {
    return new DataView(this.memory.buffer);
  }

  text(at) {
    const bytes = this.u8();
    let end = at;
    while (bytes[end] !== 0) end += 1;
    return decoder.decode(bytes.subarray(at, end));
  }

  zero(at, length) {
    if (at !== 0) this.u8().fill(0, at, at + length);
  }

  // Runs `body` unless the program has exited; an exit records its status.
  enter(body) {
    if (this.outcome !== null) return;
    try {
      body();
    } catch (error) {
      this.flushLines();
      if (error instanceof JetHostExit) {
        this.outcome = error.status;
        return;
      }
      this.outcome = TRAP_STATUS;
      this.error = new JetHostWasmError("the program trapped: " + error.message, { cause: error });
      throw this.error;
    }
  }

  // The program's run, as the native process runs main and then exits: its
  // exit status.
  run() {
    this.enter(() => {
      const status = Number(BigInt.asIntN(32, this.app.jet_export_run())) & 255;
      this.rt.jet_web_fini();
      this.flushLines();
      this.outcome = status;
      this.paintScene();
    });
    return this.outcome;
  }

  // The scene the runtime's last core.ui paint recorded (UiBackends.jet), as
  // the children of `#jet-app`: a button for a Button, an input for a
  // TextInput, a span for a Text and a div for any other leaf, each placed
  // at its frame. An element with a click slot runs its handler on click.
  paintScene() {
    if (!this.dom || this.rt.jet_ui_web_scene_take() === 0n) return;
    const doc = globalThis.document;
    let root = doc.getElementById("jet-app");
    if (!root) {
      root = doc.createElement("div");
      root.id = "jet-app";
      root.style.position = "relative";
      doc.body.appendChild(root);
    }
    for (const child of Array.from(root.children)) child.remove();
    const at = Number(this.rt.jet_ui_web_scene_data());
    const bytes = this.u8().slice(at, at + Number(this.rt.jet_ui_web_scene_length()));
    let offset = 0;
    while (offset < bytes.length) {
      const fields = [];
      while (fields.length < 8) {
        const end = bytes.indexOf(9, offset);
        fields.push(decoder.decode(bytes.subarray(offset, end)));
        offset = end + 1;
      }
      const [kind, slot, x, y, width, height, color, length] = fields;
      const label = decoder.decode(bytes.subarray(offset, offset + Number(length)));
      offset += Number(length) + 1;
      const tag = kind === "3" ? "button" : kind === "4" ? "input" : kind === "1" ? "span" : "div";
      const element = doc.createElement(tag);
      element.style.position = "absolute";
      element.style.left = x + "px";
      element.style.top = y + "px";
      element.style.width = width + "px";
      element.style.height = height + "px";
      if (color !== "" && tag !== "span") element.style.background = color;
      if (tag === "input") element.value = label;
      else element.textContent = label;
      const id = Number(slot);
      if (id !== 0) element.addEventListener("click", () => this.click(id));
      root.appendChild(element);
    }
  }

  // A click on a scene element after the program's run returned 0: runs the
  // element's handler, drains stdout, then shows the scene it painted.
  click(id) {
    if (this.outcome !== 0) return;
    try {
      this.rt.jet_ui_web_click(BigInt(id));
      this.rt.jet_rt_stdout_flush();
    } catch (error) {
      this.flushLines();
      if (error instanceof JetHostExit) {
        this.outcome = error.status;
        return;
      }
      this.outcome = TRAP_STATUS;
      this.error = new JetHostWasmError("the program trapped: " + error.message, { cause: error });
      throw this.error;
    }
    this.flushLines();
    this.paintScene();
  }

  // The argument and environment strings and their pointer arrays at the top
  // of the stack, the stack pointer below them, then an empty auxiliary
  // vector (one AT_NULL pair): the runtime reads that vector after envp's
  // terminating null, as on Linux, and finds no entry.
  place(args, environment) {
    const strings = [...args, ...environment].map((item) => encoder.encode(item + "\0"));
    const size = alignUp(strings.reduce((total, bytes) => total + bytes.length, 0), 16);
    const words = alignUp((args.length + environment.length + 4) * 8, 16);
    const view = this.view();
    let at = this.stackTop - size;
    const addresses = [];
    for (const bytes of strings) {
      this.u8().set(bytes, at);
      addresses.push(at);
      at += bytes.length;
    }
    const argv = this.stackTop - size - words;
    let slot = argv;
    const put = (value) => {
      view.setBigInt64(slot, BigInt(value), true);
      slot += 8;
    };
    for (let index = 0; index < args.length; index += 1) put(addresses[index]);
    put(0);
    const envp = slot;
    for (let index = 0; index < environment.length; index += 1) put(addresses[args.length + index]);
    put(0);
    put(0);
    put(0);
    this.sp.value = BigInt(argv);
    return [args.length, argv, envp];
  }

  flushLines() {
    for (const fd of [1, 2]) {
      if (this.lines[fd] !== "") (fd === 1 ? console.log : console.error)(this.lines[fd]);
      this.lines[fd] = "";
    }
  }

  path(dirfd, at) {
    const name = this.text(at);
    if (name.startsWith("/") || dirfd === -100) return name;
    return fs.readlinkSync("/proc/self/fd/" + dirfd) + "/" + name;
  }

  syscall(number, a, b, c, d, e, f) {
    const call = SYSCALLS[number];
    if (call === undefined) return -E.NOSYS;
    try {
      return call(this, a, b, c, d, e, f);
    } catch (error) {
      if (error instanceof JetHostExit) throw error;
      if (typeof error?.errno === "number") return error.errno < 0 ? error.errno : -error.errno;
      return -E.IO;
    }
  }

  read(fd, buffer, length, position) {
    if (!fs) return fd === 0 ? 0 : -E.BADF;
    const file = this.files.get(fd);
    const at = position ?? (file ? file.position : null);
    for (;;) {
      try {
        const count = fs.readSync(fd, this.u8(), buffer, length, at);
        if (position === undefined && file) file.position += count;
        return count;
      } catch (error) {
        if (error.code === "EOF") return 0;
        if (error.code !== "EAGAIN") throw error;
        sleep(1);
      }
    }
  }

  write(fd, buffer, length, position) {
    if (!fs) {
      if (fd !== 1 && fd !== 2) return -E.BADF;
      const parts = (this.lines[fd] + decoder.decode(this.u8().slice(buffer, buffer + length))).split("\n");
      this.lines[fd] = parts.pop();
      for (const line of parts) (fd === 1 ? console.log : console.error)(line);
      return length;
    }
    const file = this.files.get(fd);
    const at = position ?? (file ? file.position : null);
    for (;;) {
      try {
        const count = fs.writeSync(fd, this.u8(), buffer, length, at);
        if (position === undefined && file) file.position += count;
        return count;
      } catch (error) {
        if (error.code !== "EAGAIN") throw error;
        sleep(1);
      }
    }
  }

  vector(fd, iov, count, position, transfer) {
    const view = this.view();
    let total = 0;
    for (let index = 0; index < count; index += 1) {
      const base = Number(view.getBigUint64(iov + 16 * index, true));
      const length = Number(view.getBigUint64(iov + 16 * index + 8, true));
      if (length === 0) continue;
      const done = transfer.call(this, fd, base, length, position === undefined ? undefined : position + total);
      if (done < 0) return total > 0 ? total : done;
      total += done;
      if (done < length) break;
    }
    return total;
  }

  open(path, flags, mode) {
    if (!fs) return -E.NOSYS;
    const fd = fs.openSync(path, flags, mode);
    this.files.set(fd, { position: 0, flags, entries: null, cursor: 0 });
    return fd;
  }

  stat(at, info) {
    const view = this.view();
    this.zero(at, 144);
    view.setBigUint64(at, info.dev, true);
    view.setBigUint64(at + 8, info.ino, true);
    view.setBigUint64(at + 16, info.nlink, true);
    view.setUint32(at + 24, Number(info.mode), true);
    view.setUint32(at + 28, Number(info.uid), true);
    view.setUint32(at + 32, Number(info.gid), true);
    view.setBigUint64(at + 40, info.rdev, true);
    view.setBigInt64(at + 48, info.size, true);
    view.setBigInt64(at + 56, info.blksize, true);
    view.setBigInt64(at + 64, info.blocks, true);
    const times = [info.atimeNs, info.mtimeNs, info.ctimeNs];
    for (let index = 0; index < 3; index += 1) {
      view.setBigInt64(at + 72 + 16 * index, times[index] / 1000000000n, true);
      view.setBigInt64(at + 80 + 16 * index, times[index] % 1000000000n, true);
    }
    return 0;
  }

  statx(at, info) {
    const view = this.view();
    this.zero(at, 256);
    view.setUint32(at, 0xfff, true);
    view.setUint32(at + 4, Number(info.blksize), true);
    view.setUint32(at + 16, Number(info.nlink), true);
    view.setUint32(at + 20, Number(info.uid), true);
    view.setUint32(at + 24, Number(info.gid), true);
    view.setUint16(at + 28, Number(info.mode), true);
    view.setBigUint64(at + 32, info.ino, true);
    view.setBigUint64(at + 40, info.size, true);
    view.setBigUint64(at + 48, info.blocks, true);
    const times = [info.atimeNs, info.birthtimeNs, info.ctimeNs, info.mtimeNs];
    for (let index = 0; index < 4; index += 1) {
      view.setBigInt64(at + 64 + 16 * index, times[index] / 1000000000n, true);
      view.setUint32(at + 72 + 16 * index, Number(times[index] % 1000000000n), true);
    }
    view.setUint32(at + 128, Number(info.rdev >> 8n) & 0xfff, true);
    view.setUint32(at + 132, Number(info.rdev & 0xffn), true);
    view.setUint32(at + 136, Number(info.dev >> 8n) & 0xfff, true);
    view.setUint32(at + 140, Number(info.dev & 0xffn), true);
    return 0;
  }

  entries(fd, buffer, count) {
    if (!fs) return -E.NOSYS;
    let file = this.files.get(fd);
    if (!file) {
      file = { position: null, flags: 0, entries: null, cursor: 0 };
      this.files.set(fd, file);
    }
    if (file.entries === null) {
      const kind = (entry) =>
        entry.isDirectory() ? 4 : entry.isFile() ? 8 : entry.isSymbolicLink() ? 10 : entry.isFIFO() ? 1 : entry.isSocket() ? 12 : entry.isCharacterDevice() ? 2 : entry.isBlockDevice() ? 6 : 0;
      const listed = fs.readdirSync(fs.readlinkSync("/proc/self/fd/" + fd), { withFileTypes: true });
      file.entries = [[".", 4], ["..", 4], ...listed.map((entry) => [entry.name, kind(entry)])];
      file.cursor = 0;
    }
    const view = this.view();
    const bytes = this.u8();
    let at = 0;
    while (file.cursor < file.entries.length) {
      const [name, type] = file.entries[file.cursor];
      const encoded = encoder.encode(name);
      const length = alignUp(19 + encoded.length + 1, 8);
      if (at + length > count) break;
      bytes.fill(0, buffer + at, buffer + at + length);
      view.setBigUint64(buffer + at, BigInt(file.cursor + 1), true);
      view.setBigInt64(buffer + at + 8, BigInt(file.cursor + 1), true);
      view.setUint16(buffer + at + 16, length, true);
      bytes[buffer + at + 18] = type;
      bytes.set(encoded, buffer + at + 19);
      at += length;
      file.cursor += 1;
    }
    if (at === 0 && file.cursor < file.entries.length) return -E.INVAL;
    return at;
  }

  map(length, flags, fd, offset) {
    if (length <= 0) return -E.INVAL;
    const size = alignUp(length, 4096);
    let at = -1;
    for (let index = 0; index < this.unmapped.length; index += 1) {
      const [start, free] = this.unmapped[index];
      if (free < size) continue;
      at = start;
      if (free === size) this.unmapped.splice(index, 1);
      else this.unmapped[index] = [start + size, free - size];
      this.u8().fill(0, at, at + size);
      break;
    }
    if (at < 0) {
      const grown = alignUp(size, PAGE);
      try {
        at = this.memory.grow(grown / PAGE) * PAGE;
      } catch {
        return -E.NOMEM;
      }
      if (grown > size) this.unmap(at + size, grown - size);
    }
    if ((flags & 0x20) === 0) {
      if (!fs) return -E.NODEV;
      let done = 0;
      while (done < length) {
        const count = fs.readSync(fd, this.u8(), at + done, length - done, offset + done);
        if (count === 0) break;
        done += count;
      }
    }
    return at;
  }

  unmap(address, length) {
    if (length <= 0) return -E.INVAL;
    this.unmapped.push([address, alignUp(length, 4096)]);
    this.unmapped.sort((left, right) => left[0] - right[0]);
    const merged = [];
    for (const range of this.unmapped) {
      const last = merged[merged.length - 1];
      if (last && last[0] + last[1] >= range[0]) last[1] = Math.max(last[1], range[0] + range[1] - last[0]);
      else merged.push([range[0], range[1]]);
    }
    this.unmapped = merged;
    return 0;
  }

  timespec(at, nanoseconds) {
    const view = this.view();
    view.setBigInt64(at, nanoseconds / 1000000000n, true);
    view.setBigInt64(at + 8, nanoseconds % 1000000000n, true);
  }

  sleepUntil(request, absolute, clock) {
    const view = this.view();
    let nanoseconds = view.getBigInt64(request, true) * 1000000000n + view.getBigInt64(request + 8, true);
    if (absolute) nanoseconds -= nowNanoseconds(clock);
    sleep(Number(nanoseconds / 1000000n));
    return 0;
  }

  terminate(signal) {
    this.flushLines();
    throw new JetHostExit(128 + signal);
  }

  cLibrary() {
    const host = this;
    // The host runs one thread: the first refused thread start says why
    // before the runtime stops with E3001.
    let threadsRefused = false;
    // The UI provider seam's leaves forward to the page's browser provider,
    // globalThis.jetUiProvider, and only marshal: Core owns every rule and
    // error. A text answer is staged here until jet_ui_provider_take copies it.
    const provider = () => globalThis.jetUiProvider;
    let staged = null;
    const stage = (text) => {
      staged = text == null ? null : encoder.encode(text);
      return staged === null ? -1n : BigInt(staged.length);
    };
    const textAt = (bytes, length) => decoder.decode(host.u8().slice(Number(bytes), Number(bytes) + Number(length)));
    return {
      jet_ui_provider_capability: (code) => (provider()?.capability(Number(code)) ? 1n : 0n),
      jet_ui_provider_clipboard_get: () => stage(provider()?.clipboardGet()),
      jet_ui_provider_clipboard_set: (bytes, length) => (provider()?.clipboardSet(textAt(bytes, length)) ? 0n : -1n),
      jet_ui_provider_event_pop: (queue) => stage(provider()?.eventPop(Number(queue))),
      jet_ui_provider_dialog_request: (kind, bytes, length) => BigInt(provider()?.dialogRequest(Number(kind), textAt(bytes, length)) ?? -1),
      jet_ui_provider_dialog_result: (token) => stage(provider()?.dialogResult(Number(token))),
      jet_ui_provider_key_claim: (bytes, length) => (provider()?.keyClaim(textAt(bytes, length)) ? 0n : -1n),
      jet_ui_provider_take: (buffer) => {
        if (staged !== null) host.u8().set(staged, Number(buffer));
        staged = null;
      },
      getauxval: (type) => {
        if (type === 6n) return 4096n;
        if (type === 25n) return BigInt(AUX_RANDOM);
        return 0n;
      },
      pthread_attr_init: () => 0n,
      pthread_attr_destroy: () => 0n,
      pthread_attr_setstacksize: () => 0n,
      pthread_create: () => {
        if (!threadsRefused) console.error("jet: tasks are not available on the web target yet");
        threadsRefused = true;
        return BigInt(E.AGAIN);
      },
      pthread_detach: () => BigInt(E.SRCH),
      pthread_join: () => BigInt(E.SRCH),
    };
  }
}

// The Linux x86-64 system calls the host answers; any other is ENOSYS.
const SYSCALLS = {
  0: (h, fd, buffer, length) => h.read(fd, buffer, length),
  1: (h, fd, buffer, length) => h.write(fd, buffer, length),
  2: (h, path, flags, mode) => h.open(h.text(path), flags, mode),
  3: (h, fd) => {
    if (fd > 2 && fs) fs.closeSync(fd);
    h.files.delete(fd);
    return 0;
  },
  4: (h, path, at) => (fs ? h.stat(at, fs.statSync(h.text(path), { bigint: true })) : -E.NOSYS),
  5: (h, fd, at) => (fs ? h.stat(at, fs.fstatSync(fd, { bigint: true })) : -E.NOSYS),
  6: (h, path, at) => (fs ? h.stat(at, fs.lstatSync(h.text(path), { bigint: true })) : -E.NOSYS),
  7: (h, fds, count) => {
    const view = h.view();
    let ready = 0;
    for (let index = 0; index < count; index += 1) {
      const events = view.getInt16(fds + 8 * index + 4, true);
      const revents = events & 5;
      view.setInt16(fds + 8 * index + 6, revents, true);
      if (revents !== 0) ready += 1;
    }
    return ready;
  },
  8: (h, fd, offset, whence) => {
    const file = h.files.get(fd);
    if (!file || file.position === null) return -E.SPIPE;
    const base = whence === 0 ? 0 : whence === 1 ? file.position : whence === 2 ? Number(fs.fstatSync(fd).size) : NaN;
    if (Number.isNaN(base) || base + offset < 0) return -E.INVAL;
    file.position = base + offset;
    return file.position;
  },
  9: (h, address, length, protection, flags, fd, offset) => h.map(length, flags, fd, offset),
  10: () => 0,
  11: (h, address, length) => h.unmap(address, length),
  12: () => -E.NOMEM,
  13: (h, signal, action, old) => {
    h.zero(old, 32);
    return 0;
  },
  14: (h, how, set, old) => {
    h.zero(old, 8);
    return 0;
  },
  16: () => -E.NOTTY,
  17: (h, fd, buffer, length, position) => h.read(fd, buffer, length, position),
  18: (h, fd, buffer, length, position) => h.write(fd, buffer, length, position),
  19: (h, fd, iov, count) => h.vector(fd, iov, count, undefined, h.read),
  20: (h, fd, iov, count) => h.vector(fd, iov, count, undefined, h.write),
  21: (h, path, mode) => (fs ? (fs.accessSync(h.text(path), mode), 0) : -E.NOSYS),
  24: () => 0,
  28: (h, address, length, advice) => {
    if (advice === 4) h.zero(address, length);
    return 0;
  },
  35: (h, request) => h.sleepUntil(request, false, 1),
  39: () => nodeProcess?.pid ?? 1,
  60: (h, status) => {
    h.flushLines();
    throw new JetHostExit(status & 255);
  },
  61: () => -E.CHILD,
  62: (h, pid, signal) => {
    if (signal === 0) return 0;
    if (pid !== (nodeProcess?.pid ?? 1)) return -E.PERM;
    return h.terminate(signal);
  },
  63: (h, at) => {
    h.zero(at, 390);
    const fields = ["Linux", "localhost", "0.0.0", "jet-web", "wasm32", "(none)"];
    fields.forEach((field, index) => h.u8().set(encoder.encode(field), at + 65 * index));
    return 0;
  },
  72: (h, fd, command) => {
    if (command === 1 || command === 2 || command === 4) return 0;
    if (command === 3) return h.files.get(fd)?.flags ?? 2;
    return -E.INVAL;
  },
  74: (h, fd) => (fs ? (fs.fsyncSync(fd), 0) : -E.NOSYS),
  75: (h, fd) => (fs ? (fs.fdatasyncSync(fd), 0) : -E.NOSYS),
  77: (h, fd, length) => (fs ? (fs.ftruncateSync(fd, length), 0) : -E.NOSYS),
  79: (h, buffer, size) => {
    const bytes = encoder.encode((nodeProcess ? nodeProcess.cwd() : "/") + "\0");
    if (bytes.length > size) return -E.RANGE;
    h.u8().set(bytes, buffer);
    return bytes.length;
  },
  80: (h, path) => (nodeProcess ? (nodeProcess.chdir(h.text(path)), 0) : -E.NOSYS),
  82: (h, from, to) => (fs ? (fs.renameSync(h.text(from), h.text(to)), 0) : -E.NOSYS),
  83: (h, path, mode) => (fs ? (fs.mkdirSync(h.text(path), { mode }), 0) : -E.NOSYS),
  84: (h, path) => (fs ? (fs.rmdirSync(h.text(path)), 0) : -E.NOSYS),
  86: (h, from, to) => (fs ? (fs.linkSync(h.text(from), h.text(to)), 0) : -E.NOSYS),
  87: (h, path) => (fs ? (fs.unlinkSync(h.text(path)), 0) : -E.NOSYS),
  88: (h, target, path) => (fs ? (fs.symlinkSync(h.text(target), h.text(path)), 0) : -E.NOSYS),
  89: (h, path, buffer, size) => SYSCALLS[267](h, -100, path, buffer, size),
  90: (h, path, mode) => (fs ? (fs.chmodSync(h.text(path), mode), 0) : -E.NOSYS),
  91: (h, fd, mode) => (fs ? (fs.fchmodSync(fd, mode), 0) : -E.NOSYS),
  95: () => 0o022,
  96: (h, at) => {
    const microseconds = BigInt(Date.now()) * 1000n;
    if (at !== 0) {
      h.view().setBigInt64(at, microseconds / 1000000n, true);
      h.view().setBigInt64(at + 8, microseconds % 1000000n, true);
    }
    return 0;
  },
  97: (h, resource, at) => SYSCALLS[302](h, 0, resource, 0, at),
  98: (h, who, at) => {
    h.zero(at, 144);
    return 0;
  },
  100: (h, at) => {
    h.zero(at, 32);
    return Math.floor(performance.now() / 10);
  },
  102: () => nodeProcess?.getuid?.() ?? 0,
  104: () => nodeProcess?.getgid?.() ?? 0,
  107: () => nodeProcess?.geteuid?.() ?? 0,
  108: () => nodeProcess?.getegid?.() ?? 0,
  110: () => nodeProcess?.ppid ?? 0,
  115: () => 0,
  124: () => nodeProcess?.pid ?? 1,
  131: (h, stack, old) => {
    if (old !== 0) {
      h.zero(old, 24);
      h.view().setInt32(old + 8, 2, true);
    }
    return 0;
  },
  149: () => 0,
  157: (h, option) => (option === 15 ? 0 : -E.INVAL),
  158: (h, code, address) => {
    if (code === 0x1001) {
      h.tls.value = BigInt(address);
      return 0;
    }
    if (code === 0x1004) {
      h.view().setBigInt64(address, h.tls.value, true);
      return 0;
    }
    return -E.INVAL;
  },
  186: () => nodeProcess?.pid ?? 1,
  192: () => -E.NOTSUP,
  201: (h, at) => {
    const seconds = Math.floor(Date.now() / 1000);
    if (at !== 0) h.view().setBigInt64(at, BigInt(seconds), true);
    return seconds;
  },
  202: (h, address, operation, value, timeout) => {
    const command = operation & 127;
    if (command === 0 || command === 9) {
      if (h.view().getInt32(address, true) !== value) return -E.AGAIN;
      if (timeout === 0) return -E.AGAIN;
      h.sleepUntil(timeout, command === 9, 1);
      return -E.TIMEDOUT;
    }
    return 0;
  },
  204: (h, pid, size, mask) => {
    h.zero(mask, size);
    h.u8()[mask] = 1;
    return 8;
  },
  217: (h, fd, buffer, count) => h.entries(fd, buffer, count),
  218: () => nodeProcess?.pid ?? 1,
  228: (h, clock, at) => {
    h.timespec(at, nowNanoseconds(clock));
    return 0;
  },
  229: (h, clock, at) => {
    if (at !== 0) h.timespec(at, 1n);
    return 0;
  },
  230: (h, clock, flags, request) => h.sleepUntil(request, (flags & 1) !== 0, clock),
  231: (h, status) => SYSCALLS[60](h, status),
  234: (h, group, thread, signal) => SYSCALLS[62](h, group, signal),
  257: (h, dirfd, path, flags, mode) => (fs ? h.open(h.path(dirfd, path), flags, mode) : -E.NOSYS),
  258: (h, dirfd, path, mode) => (fs ? (fs.mkdirSync(h.path(dirfd, path), { mode }), 0) : -E.NOSYS),
  262: (h, dirfd, path, at, flags) => {
    if (!fs) return -E.NOSYS;
    if ((flags & 0x1000) !== 0 && h.text(path) === "") return h.stat(at, fs.fstatSync(dirfd, { bigint: true }));
    const name = h.path(dirfd, path);
    return h.stat(at, (flags & 0x100) !== 0 ? fs.lstatSync(name, { bigint: true }) : fs.statSync(name, { bigint: true }));
  },
  263: (h, dirfd, path, flags) => {
    if (!fs) return -E.NOSYS;
    const name = h.path(dirfd, path);
    if ((flags & 0x200) !== 0) fs.rmdirSync(name);
    else fs.unlinkSync(name);
    return 0;
  },
  264: (h, fromfd, from, tofd, to) => SYSCALLS[316](h, fromfd, from, tofd, to, 0),
  265: (h, fromfd, from, tofd, to) => (fs ? (fs.linkSync(h.path(fromfd, from), h.path(tofd, to)), 0) : -E.NOSYS),
  266: (h, target, dirfd, path) => (fs ? (fs.symlinkSync(h.text(target), h.path(dirfd, path)), 0) : -E.NOSYS),
  267: (h, dirfd, path, buffer, size) => {
    if (!fs) return -E.NOSYS;
    const bytes = encoder.encode(fs.readlinkSync(h.path(dirfd, path)));
    const count = Math.min(bytes.length, size);
    h.u8().set(bytes.subarray(0, count), buffer);
    return count;
  },
  268: (h, dirfd, path, mode) => (fs ? (fs.chmodSync(h.path(dirfd, path), mode), 0) : -E.NOSYS),
  269: (h, dirfd, path, mode) => (fs ? (fs.accessSync(h.path(dirfd, path), mode), 0) : -E.NOSYS),
  271: (h, fds, count) => SYSCALLS[7](h, fds, count),
  273: () => 0,
  280: (h, dirfd, path, times, flags) => {
    if (!fs) return -E.NOSYS;
    const view = h.view();
    const stamp = (at) => Number(view.getBigInt64(at, true)) + Number(view.getBigInt64(at + 8, true)) / 1e9;
    const now = Date.now() / 1000;
    fs.utimesSync(h.path(dirfd, path), times === 0 ? now : stamp(times), times === 0 ? now : stamp(times + 16));
    return 0;
  },
  302: (h, pid, resource, limit, old) => {
    if (old !== 0) {
      const value = resource === 3 ? BigInt(STACK) : resource === 7 ? 1024n : 0xffffffffffffffffn;
      h.view().setBigUint64(old, value, true);
      h.view().setBigUint64(old + 8, value, true);
    }
    return 0;
  },
  316: (h, fromfd, from, tofd, to, flags) => {
    if (!fs) return -E.NOSYS;
    const target = h.path(tofd, to);
    if ((flags & 1) !== 0 && fs.existsSync(target)) return -E.EXIST;
    fs.renameSync(h.path(fromfd, from), target);
    return 0;
  },
  318: (h, buffer, length) => {
    for (let at = 0; at < length; at += 65536) crypto.getRandomValues(new Uint8Array(h.memory.buffer, buffer + at, Math.min(65536, length - at)));
    return length;
  },
  332: (h, dirfd, path, flags, mask, at) => {
    if (!fs) return -E.NOSYS;
    if ((flags & 0x1000) !== 0 && h.text(path) === "") return h.statx(at, fs.fstatSync(dirfd, { bigint: true }));
    const name = h.path(dirfd, path);
    return h.statx(at, (flags & 0x100) !== 0 ? fs.lstatSync(name, { bigint: true }) : fs.statSync(name, { bigint: true }));
  },
  437: (h, dirfd, path, how) => {
    if (!fs) return -E.NOSYS;
    const view = h.view();
    const flags = Number(view.getBigUint64(how, true));
    const mode = Number(view.getBigUint64(how + 8, true));
    const resolve = Number(view.getBigUint64(how + 16, true));
    const name = h.path(dirfd, path);
    if ((resolve & 0x18) !== 0) {
      const root = fs.realpathSync(dirfd === -100 ? nodeProcess.cwd() : fs.readlinkSync("/proc/self/fd/" + dirfd));
      let real;
      try {
        real = fs.realpathSync(name);
      } catch {
        real = name;
      }
      if (real !== root && !real.startsWith(root + "/")) return -E.XDEV;
    }
    return h.open(name, flags, mode);
  },
};

// Loads the program partition at `path` (beside web.manifest.json and the
// runtime partition) with the runtime started; its `jet_export_run` runs the
// program once and returns its exit status.
export async function instantiateWasm(path, args = ["app"], environment = []) {
  const host = await Host.open(new URL(path, import.meta.url), args, environment);
  const exports = Object.freeze({ ...host.app, jet_export_run: () => host.run() });
  hosts.set(exports, host);
  return { exports };
}

// The outcome of the run of `exports` (instantiateWasm): Ok after a zero
// exit status, else Err with the status and any trap.
export function takeWasmError(exports) {
  const host = hosts.get(exports);
  if (!host) throw new JetHostAbiError("takeWasmError needs the exports instantiateWasm returned");
  const status = host.outcome;
  if (status === null) return null;
  return status === 0 ? { tag: "Ok" } : { tag: "Err", status, error: host.error ?? null };
}

function processArguments() {
  return nodeProcess ? ["app", ...nodeProcess.argv.slice(2)] : ["app"];
}

function processEnvironment() {
  return nodeProcess ? Object.entries(nodeProcess.env).map(([name, value]) => name + "=" + value) : [];
}

// Runs the program at `url` with the process's arguments and environment:
// its exit status. A trap rejects with JetHostWasmError.
export async function runProgram(url) {
  const host = await Host.open(url, processArguments(), processEnvironment());
  return host.run();
}

// `node app.js`: runs the program and exits with its status; a trap is
// reported on stderr with status 134.
export async function runMain(url) {
  let status;
  try {
    status = await runProgram(url);
  } catch (error) {
    console.error("jet: " + error.message);
    status = TRAP_STATUS;
  }
  if (nodeProcess) nodeProcess.exitCode = status;
}
``` }
