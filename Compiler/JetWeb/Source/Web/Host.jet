// The generated JavaScript host of a web build (Module.jet): `app.js`, the
// program's entry, and `jet_dom_runtime.js`, which owns the memory, table and
// globals both modules import and answers their Linux system calls (the
// runtime's one platform boundary, as the native kernel does) and the C
// library calls the runtime makes (WEB_HOST_C). Under node the file system
// is the host's; a page has no file system, so those calls fail with ENOSYS.
use jet_ir.[IR_HOST_PROVIDER]

// The C functions the host provides, each as the runtime's IR calls it.
WEB_HOST_C: [String]{"getauxval"}

// Each host C function: true when it replaces the runtime's own definition,
// as each runtime host seam (IR_HOST_PROVIDER) does: the host forwards a UI
// leaf to the page's browser provider and answers the calling chain itself.
web_host_functions: fn() -> [String:Bool] Never! {
    hosts := [String:Bool]{}
    loop name in WEB_HOST_C -> hosts[name.copy()] = false
    loop name in IR_HOST_PROVIDER -> hosts[name.copy()] = true
    hosts
}

// The build a web build's files belong to: the target machine the program
// was checked for and the identities of the modules the build wrote.
// web.manifest.json records it as `binding` and app.js as
// JET_TARGET_BINDING, under the same names; the host runs the program only
// when the two agree and each module's bytes hash to its identity.
WebTargetBinding: struct {
    machine: String,
    triple: String,
    environment: String,
    runtime_layer: String,
    provider_identity: String,
    dossier_identity: String,
    runtime_identity: String,
    artifact_identity: String,
}

// The binding's fields as both files name them, each beside its value.
web_binding_fields: fn(binding: WebTargetBinding) -> [{name: String, value: String}] Never! {
    [{name: String, value: String}]{
        {name: "targetMachine", value: binding.machine},
        {name: "wasmTriple", value: binding.triple},
        {name: "targetEnvironment", value: binding.environment},
        {name: "runtimeLayer", value: binding.runtime_layer},
        {name: "providerIdentity", value: binding.provider_identity},
        {name: "targetDossierIdentity", value: binding.dossier_identity},
        {name: "runtimeIdentity", value: binding.runtime_identity},
        {name: "artifactIdentity", value: binding.artifact_identity},
    }
}

// The two partition rows (Module.jet WebLayout) of web.manifest.json.
web_manifest_partitions: fn(runtime_end: Int, runtime_slots: Int, app_base: Int, app_end: Int, app_slots: Int) -> [String] Never! {
    [String]{
        "    {{\"name\": \"runtime\", \"module\": \"rt.wasm\", \"data_base\": {WEB_DATA_BASE}, \"data_end\": {runtime_end}, \"table_base\": 0, \"slots\": {runtime_slots}}}",
        "    {{\"name\": \"app\", \"module\": \"app.wasm\", \"data_base\": {app_base}, \"data_end\": {app_end}, \"table_base\": {runtime_slots}, \"slots\": {app_slots}}}",
    }
}

// `web.manifest.json`: the build's target binding and the two partitions
// the host lays out.
web_manifest: fn(partitions: [String], binding: WebTargetBinding) -> String Never! {
    fields: loop field in web_binding_fields(binding) -> "    \"{field.name}\": \"{field.value}\""
    lines: [String]{
        "{{",
        "  \"target\": \"web\",",
        "  \"entry\": \"app.js\",",
        "  \"host\": \"jet_dom_runtime.js\",",
        "  \"binding\": {{",
        fields.join(",\n"),
        "  }},",
        "  \"partitions\": [",
        partitions.join(",\n"),
        "  ]",
        "}}",
        "",
    }
    lines.join("\n")
}

// `app.js`: the program's entry, which hands the host its target binding.
web_app_js: fn(binding: WebTargetBinding) -> String Never! {
    fields: loop field in web_binding_fields(binding) -> "  {field.name}: \"{field.value}\","
    body: fields.join("\n")
    "{WEB_APP_JS_HEAD}const JET_TARGET_BINDING = Object.freeze({{\n{body}\n}});\n\n{WEB_APP_JS_TAIL}"
}

WEB_APP_JS_HEAD: #run { ``// Generated by `jet build --target web`: the program's entry. `node app.js`
// runs it, and so does the page that loads it with `data-jet-run`
// (index.html); a harness imports `jet_main`.
import { JetHostExitError, runMain, runProgram } from "./jet_dom_runtime.js";

// The build these files belong to (web.manifest.json `binding`): the host
// refuses a manifest or a module another build wrote.
`` }

WEB_APP_JS_TAIL: #run { ``const wasm = new URL("./app.wasm", import.meta.url);

// Resolves when the program exits 0. Rejects with JetHostExitError (its
// `status`) when the program exits otherwise, JetHostWasmError when it traps,
// JetHostAbiError when its files are not one build's.
export async function jet_main() {
  const status = await runProgram(wasm, JET_TARGET_BINDING);
  if (status !== 0) throw new JetHostExitError(status);
}

if (import.meta.main || globalThis.document?.querySelector?.("script[data-jet-run]")) await runMain(wasm, JET_TARGET_BINDING);
`` }

// `index.html`: the default page, which loads app.js as a module that runs
// the program.
WEB_INDEX_HTML: #run { `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jet app</title>
</head>
<body>
<script type="module" src="./app.js" data-jet-run></script>
</body>
</html>
` }

WEB_DOM_RUNTIME_JS: #run { ``// Generated by `jet build --target web`: the host of a Jet program's two
// WebAssembly modules, the runtime partition and the program partition
// (web.manifest.json). It owns the linear memory, the function table and the
// globals both import, and answers their Linux system calls and C library
// calls. Under node the file system is the host's; a page has none.

export class JetHostAbiError extends Error {
  constructor(message, options) {
    super(message, options);
    this.name = "JetHostAbiError";
  }
}

export class JetHostWasmError extends Error {
  constructor(message, options) {
    super(message, options);
    this.name = "JetHostWasmError";
  }
}

export class JetHostExitError extends Error {
  constructor(status) {
    super("the program exited with status " + status);
    this.name = "JetHostExitError";
    this.status = status;
  }
}

// An exit or exit_group: unwinds the modules to the host.
class JetHostExit {
  constructor(status) {
    this.status = status;
  }
}

const nodeProcess = globalThis.process?.versions?.node ? globalThis.process : null;
const fs = nodeProcess ? await import("node:fs") : null;
const PAGE = 65536;
const STACK = 8 * 1024 * 1024;
const AUX_RANDOM = 496;
const TRAP_STATUS = 134;
const E = {
  PERM: 1, NOENT: 2, SRCH: 3, INTR: 4, IO: 5, BADF: 9, CHILD: 10, AGAIN: 11, NOMEM: 12, ACCES: 13,
  EXIST: 17, XDEV: 18, NODEV: 19, NOTDIR: 20, INVAL: 22, MFILE: 24, NOTTY: 25, SPIPE: 29, RANGE: 34,
  NOSYS: 38, NOTSUP: 95, TIMEDOUT: 110,
};
const encoder = new TextEncoder();
const decoder = new TextDecoder();
const hosts = new WeakMap();
const sleeper = new Int32Array(new SharedArrayBuffer(4));
// JavaScript promise integration: a wasm call made through
// WebAssembly.promising may suspend on a promise an import wrapped in
// WebAssembly.Suspending returns, and resumes once it settles.
const JSPI = typeof WebAssembly.Suspending === "function" && typeof WebAssembly.promising === "function";
// The program's entries (Host.turn) of every host, each after the one
// before it.
let turns = Promise.resolve();

function alignUp(value, align) {
  return Math.ceil(value / align) * align;
}

function sleep(milliseconds) {
  if (milliseconds <= 0) return;
  try {
    Atomics.wait(sleeper, 0, 0, milliseconds);
  } catch {
    // A page's main thread cannot block; the sleep returns at once.
  }
}

// A core.ui.host provider record: each field is its UTF-8 byte length in
// decimal, `:`, then its text, so any text survives (Core/UI/Host.jet).
function providerRecord(fields) {
  return fields.map((field) => encoder.encode(field).length + ":" + field).join("");
}

// The page's default core.ui.host provider, installed when the page set none.
// It forwards browser primitives only, raw event types and values included;
// Core decodes and judges every answer. Composition events queue on 0,
// drag/drop events on 1 and claimed key presses on 2 for event_pop, each in a
// host buffer of UI_QUEUE records; a full buffer drops further events behind
// one empty record, which Core reports as a full queue. A key claim is
// `<modifier mask>:<lowercased key>`, the mask Control 1, Alt 2, Shift 4 and
// Meta 8: a keydown matching a claim loses its browser default and queues,
// and every other key keeps its default. The clipboard is the text this page last
// observed through a paste, copy or cut, or its own write: a browser lends the
// live clipboard only to a user gesture, and a write's later refusal by the
// browser is not seen. A saved file is a download of its bytes under its
// name, which the browser keeps in its downloads folder or where the person
// says when it asks. The file dialogs that answer a path (dialogRequest) and
// font shaping are absent: a page gives no filesystem path. A device request,
// the app's file chooser, the files dropped on it and the folders it is given
// among them, is answered the browser's way (deviceRequest): core.browser.host
// routes listen on the elements they select, and core.browser.storage is the
// page's localStorage and sessionStorage.
const UI_QUEUE = 256;

// How long a location request waits for the person: then it is refused, as
// on Linux.
const ASK_WAIT_MS = 300000;

// app.ask's permission `name` (`camera`, `location`, `notifications`) asked
// of the browser: a promise of `granted`, `denied` or `restricted`. The
// Permissions API answers first; a permission the browser would still ask
// for is asked by using the device once (the camera's stream, stopped at
// once; one position; the notification request). A browser without the
// device's API, or with no camera to give, is `restricted`. A person who
// dismisses the request is `denied`, as on Linux.
async function askPermission(name) {
  const browser = globalThis.navigator;
  const query = { camera: "camera", location: "geolocation", notifications: "notifications" }[name];
  if (query === undefined) return null;
  try {
    const state = (await browser?.permissions?.query({ name: query }))?.state;
    if (state === "granted" || state === "denied") return state;
  } catch {}
  if (name === "camera") {
    if (!browser?.mediaDevices?.getUserMedia) return "restricted";
    try {
      const stream = await browser.mediaDevices.getUserMedia({ video: true });
      for (const track of stream.getTracks()) track.stop();
      return "granted";
    } catch (error) {
      return cameraRefusal(error);
    }
  }
  if (name === "location") return (await findPlace())[0];
  const notices = globalThis.Notification;
  if (!notices?.requestPermission) return "restricted";
  return (await notices.requestPermission()) === "granted" ? "granted" : "denied";
}

// The grant a refused camera request gives: the person's or the page's
// refusal is `denied`; no camera, or one another program holds, `restricted`.
function cameraRefusal(error) {
  return error?.name === "NotAllowedError" || error?.name === "SecurityError" ? "denied" : "restricted";
}

// Where the device is, through the Geolocation API: a promise of the grant
// and, once allowed, the latitude, longitude and accuracy in meters. A
// position error other than a refusal comes after the person allowed it, so
// it is `granted` with no place; a request left unanswered for five minutes
// is `denied`.
function findPlace() {
  const geolocation = globalThis.navigator?.geolocation;
  if (!geolocation?.getCurrentPosition) return Promise.resolve(["restricted"]);
  return new Promise((resolve) => {
    const unanswered = setTimeout(() => resolve(["denied"]), ASK_WAIT_MS);
    unanswered.unref?.();
    const said = (fields) => {
      clearTimeout(unanswered);
      resolve(fields);
    };
    geolocation.getCurrentPosition(
      ({ coords }) => said(["granted", String(coords.latitude), String(coords.longitude), String(coords.accuracy ?? 0)]),
      (error) => said([error?.code === 1 ? "denied" : "granted"]),
    );
  });
}

// A photo from the camera: a promise of the grant and, once one was taken,
// the photo as a JPEG Blob. ImageCapture takes it where the browser has it;
// elsewhere a frame of the camera's video is drawn and encoded. The camera's
// stream stops once the photo is taken.
async function takePhoto(doc) {
  const media = globalThis.navigator?.mediaDevices;
  if (!media?.getUserMedia) return { grant: "restricted", photo: null };
  let stream;
  try {
    stream = await media.getUserMedia({ video: true });
  } catch (error) {
    return { grant: cameraRefusal(error), photo: null };
  }
  try {
    const track = (stream.getVideoTracks?.() ?? stream.getTracks())[0];
    if (globalThis.ImageCapture) return { grant: "granted", photo: await new globalThis.ImageCapture(track).takePhoto() };
    if (!doc?.createElement) return { grant: "granted", photo: null };
    const video = doc.createElement("video");
    video.muted = true;
    video.playsInline = true;
    video.srcObject = stream;
    await video.play();
    const canvas = doc.createElement("canvas");
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    canvas.getContext("2d").drawImage(video, 0, 0);
    return { grant: "granted", photo: await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg")) };
  } catch {
    return { grant: "granted", photo: null };
  } finally {
    for (const track of stream.getTracks()) track.stop();
  }
}

// The file the person picks in the browser's file chooser, which offers
// `accept` (an `<input type=file>`'s, empty for any file): a promise of the
// grant and the File, null when the person closed the chooser without one.
// A page without a document has no chooser to ask with: `restricted`.
function pickFile(doc, accept) {
  if (!doc?.createElement) return Promise.resolve({ grant: "restricted", file: null });
  const input = doc.createElement("input");
  input.type = "file";
  if (accept !== "") input.accept = accept;
  input.style.display = "none";
  (doc.body ?? doc.documentElement).append(input);
  return new Promise((resolve) => {
    const picked = (file) => {
      input.remove();
      resolve({ grant: "granted", file });
    };
    input.addEventListener("change", () => picked(input.files?.[0] ?? null));
    input.addEventListener("cancel", () => picked(null));
    input.click();
  });
}

// The folder the person picks in the browser's directory picker, for the
// page to read and write: a promise of its record, the grant and, when
// picked, the number `kept` holds its handle under and its name (holdFolder).
// Closing the picker is `granted` with no folder. A browser without the
// picker is `restricted`, a picker asked for outside the person's gesture
// `gesture`, and any other refusal `denied`.
async function pickFolder(kept) {
  if (!globalThis.showDirectoryPicker) return providerRecord(["restricted"]);
  try {
    return providerRecord(["granted", ...holdFolder(kept, await globalThis.showDirectoryPicker({ mode: "readwrite" }))]);
  } catch (error) {
    if (error?.name === "AbortError") return providerRecord(["granted"]);
    return providerRecord([error?.name === "SecurityError" ? "gesture" : "denied"]);
  }
}

// The fields a record gives for the folder handle `folder`, which `kept`
// now holds: the number it holds it under and its name.
function holdFolder(kept, folder) {
  return [String(kept.push(folder) - 1), folder.name];
}

// The record of the files directly in the folder `kept` holds under
// `number`, in name order: `listed`, then each file's number in `kept`, size
// and name (keptFile). Null when `kept` holds no folder there, or the
// browser refuses to list it.
async function listFolder(kept, number) {
  const folder = kept[number];
  if (folder?.kind !== "directory") return null;
  try {
    const files = [];
    for await (const entry of folder.values()) {
      if (entry.kind === "file") files.push(await entry.getFile());
    }
    files.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
    return providerRecord(["listed", ...files.flatMap((file) => keptFile(kept, file))]);
  } catch {
    return null;
  }
}

// Writes the bytes `request` gives in base64 as the file it names, in the
// folder `kept` holds under its number (`<number> <base64> <name>`). The
// browser writes them to a new copy and replaces the file only when it
// closes, so a failed write leaves it as it was: `written`, or null when the
// write failed.
async function writeToFolder(kept, request) {
  const [number, encoded] = request.split(" ", 2);
  const name = request.slice(number.length + encoded.length + 2);
  const folder = kept[Number(number)];
  if (folder?.kind !== "directory") return null;
  let writable = null;
  try {
    writable = await (await folder.getFileHandle(name, { create: true })).createWritable();
    await writable.write(Uint8Array.from(atob(encoded), (char) => char.charCodeAt(0)));
    await writable.close();
    return "written";
  } catch {
    await writable?.abort().catch(() => {});
    return null;
  }
}

// `ask` asked of the page's store of kept folders: IndexedDB's
// `jet-app-folders` database, whose `folders` store keeps each folder's
// handle under its key. A promise of the request's result once its
// transaction completes, null when the browser has no IndexedDB or the
// request fails.
async function folderStore(mode, ask) {
  const opening = globalThis.indexedDB?.open("jet-app-folders", 1);
  if (!opening) return null;
  const db = await new Promise((resolve) => {
    opening.onupgradeneeded = () => opening.result.createObjectStore("folders");
    opening.onsuccess = () => resolve(opening.result);
    opening.onerror = () => resolve(null);
  });
  if (db === null) return null;
  try {
    return await new Promise((resolve) => {
      const transaction = db.transaction("folders", mode);
      const request = ask(transaction.objectStore("folders"));
      transaction.oncomplete = () => resolve(request.result ?? null);
      transaction.onerror = () => resolve(null);
      transaction.onabort = () => resolve(null);
    });
  } finally {
    db.close();
  }
}

// Keeps the folder `kept` holds under the number `request` starts with in
// the store of kept folders, under the key that follows (`<number> <key>`),
// for keptFolder in a later visit: `kept`, or null when there is no such
// folder or no store.
async function keepFolder(kept, request) {
  const space = request.indexOf(" ");
  const folder = kept[Number(request.slice(0, space))];
  if (space < 0 || folder?.kind !== "directory") return null;
  return (await folderStore("readwrite", (store) => store.put(folder, request.slice(space + 1)))) === null ? null : "kept";
}

// The record of the folder kept under `key` in the store of kept folders:
// the grant and, when given, the number `kept` now holds its handle under
// and its name (holdFolder). A browser asks the person again before a page
// in a later visit reaches a folder (requestPermission, which needs the
// person's gesture); a refusal is `denied`. No folder kept is null.
async function keptFolder(kept, key) {
  const folder = await folderStore("readonly", (store) => store.get(key));
  if (folder?.kind !== "directory") return null;
  try {
    let state = (await folder.queryPermission?.({ mode: "readwrite" })) ?? "granted";
    if (state === "prompt") state = await folder.requestPermission({ mode: "readwrite" });
    return providerRecord(state === "granted" ? ["granted", ...holdFolder(kept, folder)] : ["denied"]);
  } catch {
    return providerRecord(["denied"]);
  }
}

// How long a sensor stream waits for its sensor's first reading: a browser
// on a device without the sensor gives none, or one without values.
const SENSOR_WAIT_MS = 1000;

// How many readings a sensor stream keeps that the app has not taken; past
// that, the oldest goes.
const SENSOR_QUEUE = 64;

// How the device is held, from the browser's tilt angles in degrees (beta
// front to back, gamma left to right), named as the Linux sensor proxy
// names it: the edge of the device that faces up, or `undefined` when it
// lies nearly flat.
function heldWay(beta, gamma) {
  const up = Math.sin((beta * Math.PI) / 180);
  const left = Math.cos((beta * Math.PI) / 180) * Math.sin((gamma * Math.PI) / 180);
  if (Math.max(Math.abs(up), Math.abs(left)) < 0.5) return "undefined";
  if (Math.abs(up) >= Math.abs(left)) return up > 0 ? "normal" : "bottom-up";
  return left > 0 ? "left-up" : "right-up";
}

// Follows `sensor` (`place`, `orientation` or `heading`) for one of the
// app's streams: a promise of its grant and, once the sensor gives a first
// reading, the number `watches` keeps the watch under. Each reading that
// differs from the one before queues as its fields' record: a place's
// latitude, longitude and accuracy in meters (watchPosition); how the device
// is held (heldWay); where it points, in degrees clockwise from north (an
// absolute device orientation, or Safari's compass heading). A place the
// person leaves unanswered for five minutes is `denied`; a sensor that gives
// no reading within a second, or the browser's empty one, `restricted`.
// Either way nothing stays listening.
function watchSensor(watches, sensor) {
  return new Promise((resolve) => {
    const watch = { readings: [], waiting: null, last: null, gone: false, stop: () => {} };
    let wait = null;
    let answered = false;
    const answer = (grant) => {
      if (answered) return;
      answered = true;
      clearTimeout(wait);
      if (grant !== "granted") {
        watch.stop();
        resolve(providerRecord([grant]));
        return;
      }
      watches.count += 1;
      watches.held.set(watches.count, watch);
      resolve(providerRecord([grant, String(watches.count)]));
    };
    const waitFor = (milliseconds, grant) => {
      clearTimeout(wait);
      wait = setTimeout(() => answer(grant), milliseconds);
    };
    const reading = (fields) => {
      const record = providerRecord(fields);
      if (record !== watch.last) {
        watch.last = record;
        const waiting = watch.waiting;
        watch.waiting = null;
        if (waiting) waiting(record);
        else {
          if (watch.readings.length === SENSOR_QUEUE) watch.readings.shift();
          watch.readings.push(record);
        }
      }
      answer("granted");
    };
    if (sensor === "place") {
      const geolocation = globalThis.navigator?.geolocation;
      if (!geolocation?.watchPosition) return answer("restricted");
      waitFor(ASK_WAIT_MS, "denied");
      const id = geolocation.watchPosition(
        ({ coords }) => reading([String(coords.latitude), String(coords.longitude), String(coords.accuracy ?? 0)]),
        (error) => {
          if (error?.code !== 1) return answer("granted");
          if (!answered) return answer("denied");
          // Refused after the grant: the stream ends.
          watch.stop();
          watch.gone = true;
          const waiting = watch.waiting;
          watch.waiting = null;
          waiting?.(null);
        },
      );
      watch.stop = () => geolocation.clearWatch(id);
      return;
    }
    const events = globalThis.addEventListener ? globalThis : null;
    if (!events || (sensor !== "orientation" && sensor !== "heading")) return answer("restricted");
    const type = sensor === "heading" && "ondeviceorientationabsolute" in globalThis ? "deviceorientationabsolute" : "deviceorientation";
    const listen = (event) => {
      if (sensor === "orientation") {
        if (event.beta == null || event.gamma == null) return answer("restricted");
        return reading([heldWay(event.beta, event.gamma)]);
      }
      const degrees = event.webkitCompassHeading ?? (event.absolute && event.alpha != null ? (360 - event.alpha) % 360 : null);
      if (degrees == null) return answer("restricted");
      reading([String(degrees)]);
    };
    // A browser that asks before it gives the tilt (Safari's
    // requestPermission) asks the person here.
    const asking = globalThis.DeviceOrientationEvent?.requestPermission;
    waitFor(ASK_WAIT_MS, "denied");
    Promise.resolve(asking ? asking.call(globalThis.DeviceOrientationEvent) : "granted")
      .catch(() => "denied")
      .then((state) => {
        if (answered) return;
        if (state !== "granted") return answer("denied");
        events.addEventListener(type, listen);
        watch.stop = () => events.removeEventListener(type, listen);
        waitFor(SENSOR_WAIT_MS, "restricted");
      });
  });
}

// The next reading of the watch `number`: its record now, or a promise of
// it; null once the watch is gone.
function nextReading(watches, number) {
  const watch = watches.held.get(number);
  if (watch === undefined) return null;
  if (watch.readings.length > 0) return watch.readings.shift();
  if (watch.gone) return null;
  return new Promise((resolve) => (watch.waiting = resolve));
}

// Stops the watch `number`, so nothing listens for its sensor any more.
function stopWatch(watches, number) {
  const watch = watches.held.get(number);
  if (watch === undefined) return "";
  watches.held.delete(number);
  watch.stop();
  const waiting = watch.waiting;
  watch.waiting = null;
  waiting?.(null);
  return "";
}

// The clipboard's text through the Clipboard API, for app.paste_text: a
// promise of the text, or of null when the browser refuses the read. A
// browser lends the live clipboard only inside the person's gesture, so a
// read outside one is refused without asking.
function pasteText() {
  const browser = globalThis.navigator;
  if (!browser?.clipboard?.readText) return null;
  if (browser.userActivation && !browser.userActivation.isActive) return null;
  return browser.clipboard.readText().then(
    (text) => String(text),
    () => null,
  );
}

// The link `url` shared through the Web Share API, for app.share: a promise
// of `shared`, `canceled` when the person dismissed the share sheet, or
// `copy` when the browser has no share sheet or refused this one, so the
// app copies the link instead.
function shareLink(url) {
  const browser = globalThis.navigator;
  if (!browser?.share) return "copy";
  return browser.share({ url }).then(
    () => "shared",
    (error) => (error?.name === "AbortError" ? "canceled" : "copy"),
  );
}

// A remote call's POST through the browser's fetch, for app.remote_at in a
// page. `request` is the address, then a line `name: value` for each
// header, an empty line and the body; an address with no origin (`/api/add`)
// is on the page's own. A promise of the record of the reply's status, its
// `retry-after` ("" for none) and its body's text, or of why no reply came.
function postRequest(request) {
  const blank = request.indexOf("\n\n");
  const [address, ...lines] = request.slice(0, blank).split("\n");
  const headers = lines.map((line) => [line.slice(0, line.indexOf(": ")), line.slice(line.indexOf(": ") + 2)]);
  const page = globalThis.location?.href;
  return Promise.resolve()
    .then(() => fetch(page === undefined ? address : new URL(address, page).href, { method: "POST", headers, body: request.slice(blank + 2) }))
    .then((reply) =>
      reply.text().then((text) => providerRecord([String(reply.status), reply.headers.get("retry-after") ?? "", text])),
    )
    .catch((error) => providerRecord([String(error?.message ?? error)]));
}

// The provider's answer to the app's device request `request` of kind
// `kind` (UIHostProvider.jet jet_ui_provider_device): 0 app.ask's grant, 1
// the location's record, 2 the photo's record (its grant and, when taken,
// the number the provider keeps it under and its size), 3 the bytes of the
// kept file `<number> <offset> <limit>` names, 4 a sensor stream's start
// (watchSensor), 5 its next reading and 6 its stop, each naming the watch's
// number, 7 the clipboard's text (pasteText), 8 a share of the link
// `request` (shareLink), 9 the record of the file the person picks in the
// browser's file chooser, which offers `request` (pickFile: its grant and,
// when picked, its number, size and name), 10 the record of the files
// the page's last drop on a body that takes them gave (filesDropped: each
// one's number, size and name), 11 the record of the folder the person
// picks in the browser's directory picker (pickFolder), 12 the record of
// the files in the kept folder number `request` (listFolder), 13 a write of
// a file to a kept folder (writeToFolder), 14 the keeping of a kept folder
// for later visits (keepFolder), 15 the record of the folder kept for
// them under the key `request` (keptFolder), 16 the app following the
// page's lifecycle through the hook whose click slot `request` names,
// its first moment the document's visibility, 17 the oldest moment
// of the page's lifecycle the app hasn't taken (Host followLifecycle),
// 18 a remote call's POST (postRequest), 19 the app drawing its screens
// through the hook whose click slot `request` names (Host show), the page's
// address, 20 a route's binding (bindRoute), 21 the payload of the event
// whose route's handler runs, 22 the value of the element the selector
// `request` selects (elementValue) and 23 an operation on the page's
// storage (storageRequest), null for none. An answer may be a promise.
function deviceRequest(doc, kept, watches, drops, lifecycle, routes, kind, request) {
  if (kind === 0) return askPermission(request);
  if (kind === 1) return findPlace().then(providerRecord);
  if (kind === 2) {
    return takePhoto(doc).then(({ grant, photo }) =>
      providerRecord(photo?.size > 0 ? [grant, String(kept.push(photo) - 1), String(photo.size)] : [grant]),
    );
  }
  if (kind === 3) {
    const [number, offset, limit] = request.split(" ").map(Number);
    const file = kept[number];
    if (file === undefined) return null;
    return file
      .slice(offset, offset + limit)
      .arrayBuffer()
      .then((bytes) => new Uint8Array(bytes));
  }
  if (kind === 4) return watchSensor(watches, request);
  if (kind === 5) return nextReading(watches, Number(request));
  if (kind === 6) return stopWatch(watches, Number(request));
  if (kind === 7) return pasteText();
  if (kind === 8) return shareLink(request);
  if (kind === 9) {
    return pickFile(doc, request).then(({ grant, file }) =>
      providerRecord(file ? [grant, ...keptFile(kept, file)] : [grant]),
    );
  }
  if (kind === 10) {
    const files = drops.shift();
    return files === undefined ? null : providerRecord(files.flatMap((file) => keptFile(kept, file)));
  }
  if (kind === 11) return pickFolder(kept);
  if (kind === 12) return listFolder(kept, Number(request));
  if (kind === 13) return writeToFolder(kept, request);
  if (kind === 14) return keepFolder(kept, request);
  if (kind === 15) return keptFolder(kept, request);
  if (kind === 16) {
    lifecycle.hook = Number(request);
    lifecycle.moments.push(doc.visibilityState === "hidden" ? "hidden" : "visible");
    return "following";
  }
  if (kind === 17) return lifecycle.moments.shift() ?? null;
  if (kind === 18) return postRequest(request);
  if (kind === 19) {
    lifecycle.draw = Number(request);
    const place = globalThis.location;
    return place?.pathname ? place.pathname + (place.search ?? "") : "/";
  }
  if (kind === 20) return bindRoute(doc, routes, request);
  if (kind === 21) return routes.payload;
  if (kind === 22) return elementValue(doc.querySelector?.(request));
  if (kind === 23) return storageRequest(request);
  return null;
}

// The fields a record gives for `file`, which `kept` now holds: the number
// it holds it under, its size and its name.
function keptFile(kept, file) {
  return [String(kept.push(file) - 1), String(file.size), file.name];
}

// What `element` holds: an input's value, else its text; null for no
// element.
function elementValue(element) {
  if (!element) return null;
  return String(typeof element.value === "string" ? element.value : (element.textContent ?? ""));
}

// Binds the route `<click slot> <event type> <selector>` (core.browser.host
// on): each event of that type on the element the selector selects runs the
// slot's handler (routes.run), with the value the element holds then as the
// event's payload. "bound", or null when no element matches.
function bindRoute(doc, routes, request) {
  const [slot, type] = request.split(" ", 2);
  const element = doc.querySelector?.(request.slice(slot.length + type.length + 2));
  if (!element?.addEventListener) return null;
  element.addEventListener(type, (event) => {
    const payload = elementValue(event.target ?? element) ?? "";
    return routes.run(Number(slot), () => (routes.payload = payload));
  });
  return "bound";
}

// An operation on the page's storage (core.browser.storage page_ask):
// `<area> <op> <key bytes> <key><value>`, the area local or session. A get
// answers the record of the key's value, empty when it has none; set,
// remove and clear answer "ok". Null when the page has no such storage.
function storageRequest(request) {
  const [area, op, size] = request.split(" ", 3);
  const store = area === "session" ? globalThis.sessionStorage : area === "local" ? globalThis.localStorage : undefined;
  if (!store) return null;
  const rest = encoder.encode(request.slice(area.length + op.length + size.length + 3));
  const key = decoder.decode(rest.subarray(0, Number(size)));
  if (op === "get") {
    const value = store.getItem(key);
    return providerRecord(value === null ? [] : [value]);
  }
  if (op === "set") store.setItem(key, decoder.decode(rest.subarray(Number(size))));
  else if (op === "remove") store.removeItem(key);
  else if (op === "clear") store.clear();
  else return null;
  return "ok";
}
function defaultUiProvider(doc, run) {
  const queues = [[], [], []];
  const claims = new Set();
  let clipboard = null;
  // The files and folders the app was given (a photo, a picked or dropped
  // file, a picked or kept folder's handle), by number; each lives as long
  // as the page. The files of each drop on a body that takes them, until
  // the app takes them. The sensors its streams follow, by number, until
  // each stops. The click slots of the hooks of the app that launched (each
  // 0 before one launched): the one following the page's lifecycle, with
  // the moments it hasn't taken, and the one drawing its screens (Host show).
  // How a route runs its handler as the page's next entry (`run`, Host
  // click), and the payload of the event whose route's handler runs.
  const kept = [];
  const drops = [];
  const watches = { count: 0, held: new Map() };
  const lifecycle = { hook: 0, moments: [], draw: 0 };
  const routes = { run, payload: "" };
  const enqueue = (queue, fields) => {
    const records = queues[queue];
    if (records.length < UI_QUEUE) records.push(providerRecord(fields));
    else if (records.at(-1) !== "") records.push("");
  };
  const target = (event) => String(event.target?.id ?? "");
  // A composition reports no caret or marked range of its own.
  const composition = (event) => enqueue(0, [target(event), event.type, event.data ?? "", "", "", "", ""]);
  doc.addEventListener("compositionstart", composition);
  doc.addEventListener("compositionupdate", composition);
  doc.addEventListener("compositionend", composition);
  // A page accepts a drop by canceling dragover; the dropped data is
  // readable only on drop.
  const drag = (event) => {
    if (event.type === "dragover" || event.type === "drop") event.preventDefault();
    const data = event.dataTransfer;
    const dropped = event.type === "drop" && data;
    enqueue(1, [
      target(event),
      event.type,
      data?.dropEffect ?? "none",
      dropped ? data.getData("text/plain") : "",
      dropped ? data.getData("text/uri-list") : "",
    ]);
  };
  doc.addEventListener("dragenter", drag);
  doc.addEventListener("dragover", drag);
  doc.addEventListener("drop", drag);
  doc.addEventListener("dragleave", drag);
  const keydown = (event) => {
    const mask = (event.ctrlKey ? 1 : 0) | (event.altKey ? 2 : 0) | (event.shiftKey ? 4 : 0) | (event.metaKey ? 8 : 0);
    const key = String(event.key ?? "");
    if (!claims.has(mask + ":" + key.toLowerCase())) return;
    event.preventDefault();
    enqueue(2, [target(event), key, String(mask)]);
  };
  doc.addEventListener("keydown", keydown);
  // Paste carries the pasted text; copy and cut carry what the page set, else
  // the selection the browser copies.
  const observe = (event) => {
    const text = event.clipboardData?.getData("text/plain") ?? "";
    if (event.type === "paste" || text !== "") clipboard = text;
    else if (!event.defaultPrevented) clipboard = String(doc.getSelection?.() ?? "");
  };
  doc.addEventListener("paste", observe);
  doc.addEventListener("copy", observe);
  doc.addEventListener("cut", observe);
  return {
    capability: (code) => code >= 1 && code <= 5,
    clipboardGet: () => clipboard,
    clipboardSet: (text) => {
      const system = globalThis.navigator?.clipboard;
      if (!system?.writeText) return false;
      clipboard = text;
      system.writeText(text).catch(() => {});
      return true;
    },
    eventPop: (queue) => queues[queue]?.shift() ?? null,
    dialogRequest: () => -1,
    dialogResult: () => null,
    device: (kind, request) => deviceRequest(doc, kept, watches, drops, lifecycle, routes, kind, request),
    filesDropped: (files) => drops.push(files),
    // A moment of the page's lifecycle (Host followLifecycle), held for the
    // app that launched: its hook's click slot, 0 with no app to tell.
    moment: (moment) => {
      if (lifecycle.hook === 0) return 0;
      lifecycle.moments.push(moment);
      return lifecycle.hook;
    },
    // The click slot of the hook of the app drawing its screens, 0 with no
    // app that launched with screens.
    drawHook: () => lifecycle.draw,
    keyClaim: (claim) => {
      claims.add(claim);
      return true;
    },
    saveFile: (name, media, bytes) => {
      const urls = globalThis.URL;
      if (!urls?.createObjectURL || !doc.createElement) return false;
      const link = doc.createElement("a");
      const address = urls.createObjectURL(new Blob([bytes], { type: media }));
      link.href = address;
      link.download = name;
      (doc.body ?? doc.documentElement).append(link);
      link.click();
      link.remove();
      // The download reads the bytes after this call returns.
      setTimeout(() => urls.revokeObjectURL(address), 60000);
      return true;
    },
  };
}

function nowNanoseconds(clock) {
  if (clock === 0 || clock === 8 || clock === 11) {
    return BigInt(Date.now()) * 1000000n + BigInt(Math.floor((performance.now() % 1) * 1000000));
  }
  if (clock === 2 || clock === 3) {
    if (!nodeProcess) return BigInt(Math.round(performance.now() * 1000000));
    const usage = nodeProcess.cpuUsage();
    return BigInt(usage.user + usage.system) * 1000n;
  }
  return nodeProcess ? nodeProcess.hrtime.bigint() : BigInt(Math.round(performance.now() * 1000000));
}

async function load(url) {
  if (fs && url.protocol === "file:") return fs.readFileSync(url);
  const response = await fetch(url);
  if (!response.ok) throw new JetHostAbiError("cannot load " + url.href + ": HTTP " + response.status);
  return new Uint8Array(await response.arrayBuffer());
}

const SHA256_K = new Uint32Array([
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
]);

// The identity the build wrote for a module (web.manifest.json `binding`):
// "sha256:" and the lowercase hex SHA-256 of its bytes. It is computed here,
// not with crypto.subtle, which a page served over plain HTTP lacks.
function moduleIdentity(bytes) {
  const length = bytes.length;
  const padded = new Uint8Array(((length + 72) >> 6) << 6);
  padded.set(bytes);
  padded[length] = 0x80;
  const view = new DataView(padded.buffer);
  view.setUint32(padded.length - 8, Math.floor(length / 0x20000000));
  view.setUint32(padded.length - 4, (length * 8) >>> 0);
  const hash = new Uint32Array([0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]);
  const w = new Uint32Array(64);
  const rotate = (x, n) => (x >>> n) | (x << (32 - n));
  for (let block = 0; block < padded.length; block += 64) {
    for (let i = 0; i < 16; i++) w[i] = view.getUint32(block + 4 * i);
    for (let i = 16; i < 64; i++) {
      const s0 = rotate(w[i - 15], 7) ^ rotate(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotate(w[i - 2], 17) ^ rotate(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    let [a, b, c, d, e, f, g, h] = hash;
    for (let i = 0; i < 64; i++) {
      const t1 = (h + (rotate(e, 6) ^ rotate(e, 11) ^ rotate(e, 25)) + ((e & f) ^ (~e & g)) + SHA256_K[i] + w[i]) | 0;
      const t2 = ((rotate(a, 2) ^ rotate(a, 13) ^ rotate(a, 22)) + ((a & b) ^ (a & c) ^ (b & c))) | 0;
      h = g;
      g = f;
      f = e;
      e = (d + t1) | 0;
      d = c;
      c = b;
      b = a;
      a = (t1 + t2) | 0;
    }
    [a, b, c, d, e, f, g, h].forEach((word, i) => { hash[i] += word; });
  }
  return "sha256:" + Array.from(hash, (word) => word.toString(16).padStart(8, "0")).join("");
}

// A web build's files must be one build's: each name the entry's binding
// (app.js JET_TARGET_BINDING) holds names the same value in the manifest's.
function checkBinding(binding, manifest) {
  for (const [name, value] of Object.entries(binding)) {
    const written = manifest.binding?.[name];
    if (written !== value) {
      throw new JetHostAbiError("target binding mismatch: app.js binds " + name + " " + JSON.stringify(value) + ", web.manifest.json " + JSON.stringify(written ?? null));
    }
  }
}

// The program module's location table, its `jet.lines` custom section
// (Module.jet web_location_table), by function index: each function's name,
// file, declaration line and line rows, [code offset, line] in offset order.
function locationTable(module) {
  const table = new Map();
  const [section] = module ? WebAssembly.Module.customSections(module, "jet.lines") : [];
  if (!section) return table;
  const { leb, text } = sectionReader(section);
  const files = [];
  for (let count = leb(false); count > 0; count -= 1) files.push(text());
  for (let count = leb(false); count > 0; count -= 1) {
    const index = leb(false);
    const name = text();
    const file = files[leb(false)];
    const declared = leb(false);
    const rows = [];
    let offset = 0;
    let line = 0;
    for (let left = leb(false); left > 0; left -= 1) {
      offset += leb(false);
      line += leb(true);
      rows.push([offset, line]);
    }
    table.set(index, { name, file, declared, rows });
  }
  return table;
}

// The line of code offset `offset` in a function with line rows `rows`: the
// last row at or before it, 0 before the first, as the native walk reads
// its table (JetRuntime Fault.jet trace_line).
function lineAt(rows, offset) {
  let line = 0;
  for (const [at, row] of rows) {
    if (at > offset) break;
    line = row;
  }
  return line;
}

// The Jet frames of the stack trace `stack`, innermost first: each frame of
// the program module (named `app`) that the location table `locations`
// holds, with the line of its code offset.
function* jetFrames(stack, locations) {
  for (const frame of stack.matchAll(/(?:wasm:\/\/wasm\/app-[0-9a-f]+|\/app\.wasm):wasm-function\[(\d+)\]:0x([0-9a-f]+)/g)) {
    const location = locations.get(Number(frame[1]));
    if (location) yield { location, line: lineAt(location.rows, parseInt(frame[2], 16)) };
  }
}

// Whether `error` is the engine's refusal of a call when the call stack has
// run out: V8's and JavaScriptCore's RangeError, SpiderMonkey's
// InternalError.
function stackOverflow(error) {
  if (error instanceof RangeError) return /call stack/i.test(error.message);
  return error?.name === "InternalError" && /too much recursion/i.test(error.message);
}

// The source map file the program module `module` names in its
// `sourceMappingURL` custom section (JetWeb Build.jet web_program), or null.
function sourceMapName(module) {
  const [section] = WebAssembly.Module.customSections(module, "sourceMappingURL");
  return section ? sectionReader(section).text() : null;
}

// A reader of custom section `section`'s LEB128 numbers (`leb`, signed or
// not) and length-prefixed UTF-8 names (`text`), from its start on.
function sectionReader(section) {
  const bytes = new Uint8Array(section);
  let at = 0;
  const leb = (signed) => {
    let value = 0;
    let scale = 1;
    let byte;
    do {
      byte = bytes[at++];
      value += (byte & 127) * scale;
      scale *= 128;
    } while (byte & 128);
    return signed && (byte & 64) !== 0 ? value - scale : value;
  };
  const text = () => {
    const length = leb(false);
    const value = decoder.decode(bytes.subarray(at, at + length));
    at += length;
    return value;
  };
  return { leb, text };
}

class Host {
  constructor(manifest) {
    this.runtime = manifest.partitions?.find((partition) => partition.name === "runtime");
    this.program = manifest.partitions?.find((partition) => partition.name === "app");
    if (!this.runtime || !this.program) throw new JetHostAbiError("web.manifest.json names no runtime and app partitions");
    this.stackTop = alignUp(this.program.data_end, PAGE) + STACK;
    this.memory = new WebAssembly.Memory({ initial: this.stackTop / PAGE });
    this.table = new WebAssembly.Table({ element: "anyfunc", initial: this.program.table_base + this.program.slots });
    // Where every entry starts on the stack: its top, then below the
    // arguments and the environment (place).
    this.base = BigInt(this.stackTop);
    this.sp = new WebAssembly.Global({ value: "i64", mutable: true }, this.base);
    this.tls = new WebAssembly.Global({ value: "i64", mutable: true }, 0n);
    this.edx = new WebAssembly.Global({ value: "i32", mutable: true }, 0);
    this.unmapped = [];
    // Without JSPI the host runs one thread: the first refused thread start
    // (clone) says why before the runtime stops with E3001.
    this.threadsRefused = false;
    this.files = new Map();
    this.lines = ["", "", ""];
    this.outcome = null;
    // Without JSPI, the running entry would wait (waitableCall) but can't.
    this.waitable = false;
    // With JSPI the program's threads and fibers, and each entry, are
    // coroutines on the page's event loop that take turns (step): the one
    // whose registers the globals hold now (`running`), the ones due to run
    // next (`ready`), the entries under way (`underWay`), the futex waits by
    // address (`waiters`), the contexts fiber switches left by token
    // (`switched`), the waits' timers, and the registers of the thread that
    // runs the page's plain calls (`home`).
    this.running = null;
    this.ready = [];
    this.stepping = false;
    this.underWay = new Set();
    this.waiters = new Map();
    this.switched = new Map();
    this.timers = new Set();
    this.tokens = 0n;
    this.home = null;
    this.nextTid = (nodeProcess?.pid ?? 1) + 1;
    this.dom = false;
    // The scene's open context menu (openMenu), null for none.
    this.menu = null;
    // The scene's bodies that take what a person moves (paintScene), the
    // pick slot of the body a pointer drags now (0 for none), and the body
    // the keyboard picked up and the one it shows it would drop on (null
    // for none).
    this.zones = [];
    this.dragging = 0;
    this.picked = null;
    crypto.getRandomValues(new Uint8Array(this.memory.buffer, AUX_RANDOM, 16));
  }

  // With the entry's `binding` (app.js JET_TARGET_BINDING), the manifest
  // and both modules must come from the build that wrote the entry; a
  // harness that loads the modules itself passes none.
  static async open(url, args, environment, binding = null) {
    const base = new URL(".", url);
    const manifest = JSON.parse(decoder.decode(await load(new URL("web.manifest.json", base))));
    if (binding) checkBinding(binding, manifest);
    const host = new Host(manifest);
    // A page gets the default core.ui.host provider unless it installed one;
    // its routes run their handlers as this host's clicks.
    if (globalThis.document?.addEventListener && globalThis.jetUiProvider === undefined) {
      globalThis.jetUiProvider = defaultUiProvider(globalThis.document, (slot, before) => host.click(slot, before));
    }
    host.rt = (await host.instantiate(new URL(host.runtime.module, base), {}, binding?.runtimeIdentity)).instance.exports;
    const app = await host.instantiate(url, { rt: host.rt }, binding?.artifactIdentity);
    host.app = app.instance.exports;
    host.appModule = app.module;
    host.appUrl = url;
    host.enter(() => host.rt.jet_web_init());
    // A page (or a DOM harness) shows the core.ui scene the program paints.
    if (globalThis.document?.createElement && globalThis.document.body) {
      host.dom = true;
      host.enter(() => host.rt.jet_ui_web_attach());
      host.followLifecycle(globalThis.document);
    }
    const [argc, argv, envp] = host.place(args, hostZoneEnvironment(environment));
    host.enter(() => host.rt.jet_rt_host_arguments(BigInt(argc), BigInt(argv), BigInt(envp)));
    return host;
  }

  // The module at `url` and its instance; with an `identity`, its bytes must
  // hash to it (moduleIdentity).
  async instantiate(url, extra, identity = undefined) {
    const bytes = await load(url);
    if (identity !== undefined) {
      const actual = moduleIdentity(bytes);
      if (actual !== identity) throw new JetHostAbiError("target binding mismatch: " + url.href + " is " + actual + ", the build bound " + identity);
    }
    const imports = {
      env: { memory: this.memory, table: this.table, sp: this.sp, tls: this.tls, edx: this.edx },
      host: {
        syscall: (n, a, b, c, d, e, f) => BigInt(this.syscall(Number(n), Number(a), Number(b), Number(c), Number(d), Number(e), Number(f)) ?? 0),
        // A fiber switch (JetWeb Leaf.jet os_fiber_switch_i64): only
        // carriers switch, and without JSPI no carrier starts.
        switch: JSPI
          ? new WebAssembly.Suspending((save, target) => this.fiberSwitch(save, target))
          : () => {
              throw new JetHostWasmError("a fiber switch needs JavaScript Promise Integration");
            },
      },
      c: this.cLibrary(),
      ...extra,
    };
    try {
      return await WebAssembly.instantiate(bytes, imports);
    } catch (error) {
      throw new JetHostAbiError("cannot instantiate " + url.href + ": " + error.message, { cause: error });
    }
  }

  // The calling chain's Jet frames, innermost first, one
  // `function\tfile\tline\n` line each (JetRuntime Fault.jet
  // jet_rt_host_frames): each frame of the program module (named `app`) that
  // its location table holds, at the line of its call's code offset.
  trace() {
    const limit = Error.stackTraceLimit;
    Error.stackTraceLimit = 4096;
    const stack = new Error().stack ?? "";
    Error.stackTraceLimit = limit;
    this.locations ??= locationTable(this.appModule);
    let text = "";
    for (const { location, line } of jetFrames(stack, this.locations)) text += location.name + "\t" + location.file + "\t" + line + "\n";
    return text;
  }

  u8() {
    return new Uint8Array(this.memory.buffer);
  }

  view() {
    return new DataView(this.memory.buffer);
  }

  text(at) {
    const bytes = this.u8();
    let end = at;
    while (bytes[end] !== 0) end += 1;
    return decoder.decode(bytes.subarray(at, end));
  }

  zero(at, length) {
    if (at !== 0) this.u8().fill(0, at, at + length);
  }

  // Runs `body` unless the program has exited.
  enter(body) {
    if (this.outcome !== null) return;
    try {
      body();
    } catch (error) {
      this.fail(error);
    }
  }

  // An entry's failure: an exit records its status; a stack overflow is the
  // runtime's E3012 stop (overflowStop), whose exit it records; anything
  // else is a trap, recorded and thrown on as JetHostWasmError. A trap or a
  // nonzero exit ends the program's threads with it (end).
  fail(error) {
    if (stackOverflow(error)) error = this.overflowStop(error) ?? error;
    this.flushLines();
    if (error instanceof JetHostExit) {
      this.outcome = error.status;
      if (this.outcome !== 0) this.end();
      return;
    }
    this.outcome = TRAP_STATUS;
    this.end();
    this.error = new JetHostWasmError("the program trapped: " + error.message, { cause: error });
    throw this.error;
  }

  // The runtime's E3012 stop (JetRuntime Trap.jet jet_rt_stack_overflow_stop)
  // for stack overflow `error`, as the native fault report gives it: the
  // innermost Jet function on the overflowing stack, at its declaration
  // line, with that line's source when the build's source map holds it
  // (readSources). The engine has unwound the overflowing calls; the stop
  // runs from where every entry starts on the stack (`base`), with its
  // strings just below. What the stop ended with (the process exit), or
  // null when no frame of the program is on the stack.
  overflowStop(error) {
    this.locations ??= locationTable(this.appModule);
    const frame = jetFrames(error.stack ?? "", this.locations).next().value;
    if (!frame) return null;
    const { name, file, declared } = frame.location;
    const source = this.sources?.get(file)?.split("\n")[declared - 1] ?? "";
    this.sp.value = this.base;
    const [named, path, text] = [name, file, source].map((item) => {
      const bytes = encoder.encode(item);
      const at = Math.floor((Number(this.sp.value) - bytes.length) / 16) * 16;
      this.u8().set(bytes, at);
      this.sp.value = BigInt(at);
      return [BigInt(at), BigInt(bytes.length)];
    });
    try {
      this.rt.jet_rt_stack_overflow_stop(...named, ...path, BigInt(declared), ...text);
    } catch (exit) {
      return exit;
    }
    return null;
  }

  // The program's source files by the names its location table gives them,
  // from the sources and their contents in the source map the program module
  // names (sourceMapName), read once. A build or a page without the map
  // leaves them unknown, and a stack overflow's report quotes no source line
  // (overflowStop), as the native report quotes none when it can't read the
  // file.
  async readSources() {
    if (this.sources) return;
    this.sources = new Map();
    const name = sourceMapName(this.appModule);
    if (name === null) return;
    let map;
    try {
      map = JSON.parse(decoder.decode(await load(new URL(name, this.appUrl))));
    } catch {
      return;
    }
    (map.sources ?? []).forEach((source, index) => {
      const content = map.sourcesContent?.[index];
      if (typeof content === "string") this.sources.set(source, content);
    });
  }

  // A program that trapped or exited nonzero is over: no thread of it runs
  // again, as the native process exit takes every thread with it, and no
  // wait's timer holds the page. One whose run returned 0 lives on with its
  // threads, since its clicks still run (click).
  end() {
    for (const timer of this.timers) clearTimeout(timer);
    this.timers.clear();
    this.waiters.clear();
    this.switched.clear();
    this.ready.length = 0;
  }

  // Whether the program is over (end).
  over() {
    return this.outcome !== null && this.outcome !== 0;
  }

  // Runs the async `body`, one of the program's entries, once every entry
  // before it finished, so only one is ever under way: a promise of what
  // it answers. A failure goes to `fail`; the next entry runs regardless.
  // A stack overflow ends the program before its report reads the sources.
  turn(body) {
    const result = turns.then(async () => {
      try {
        return await body();
      } catch (error) {
        if (stackOverflow(error)) {
          this.end();
          await this.readSources();
        }
        this.fail(error);
      }
    });
    turns = result.catch(() => {});
    return result;
  }

  // The wasm export `call` with `args`, called where it may wait (wait): a
  // promise of its result. Under JSPI it is a coroutine on the page's
  // thread, whose stack is the page's own (home). Without JSPI it runs
  // straight through, and a wait in it stops the program
  // (jet_rt_host_can_wait), since it could neither suspend nor block the
  // page's event loop.
  waitableCall(call, ...args) {
    if (JSPI) {
      return new Promise((resolve, reject) => this.launch({ fn: call, args, tid: nodeProcess?.pid ?? 1, settle: { resolve, reject } }));
    }
    this.waitable = true;
    try {
      return Promise.resolve(call(...args));
    } catch (error) {
      return Promise.reject(error);
    } finally {
      this.waitable = false;
    }
  }

  // The program's run, as the native process runs main and then exits: a
  // promise of its exit status. After 0 its threads live on for its clicks;
  // otherwise they end with it.
  run() {
    return this.turn(async () => {
      if (this.outcome !== null) return;
      const status = Number(BigInt.asIntN(32, await this.waitableCall(this.app.jet_export_run))) & 255;
      this.rt.jet_web_fini();
      this.flushLines();
      this.outcome = status;
      if (status !== 0) this.end();
      if (status === 0) await this.show();
      else this.paintScene();
    }).then(() => this.outcome);
  }

  // Coroutines (JSPI). A record: the wasm function `fn` it runs with `args`,
  // its registers while it is not running (`sp`, `tls`, `edx`; an entry
  // starts on the page thread's, home), its thread id (`tid`, gettid), the
  // word its end clears and wakes (`clearTid`, as the kernel's
  // CLONE_CHILD_CLEARTID), an entry's promise (`settle`), and once it has
  // started, the resolver its suspension resumes (`resume`) with `value`.
  // Exactly one runs at a time: it holds the globals from the moment `step`
  // hands them over until it suspends (park) or ends (finish), and nothing
  // else is resumed meanwhile, so a resumption queued as a microtask can't
  // find another one's registers.

  // Starts coroutine `record` once the running one, if any, suspends.
  launch(record) {
    record.started = false;
    record.edx ??= 0;
    record.clearTid ??= 0;
    if (record.settle) this.underWay.add(record);
    this.wake(record);
  }

  // Makes `record` due to run, resumed with `value`; `first` puts it
  // ahead of the others, as a fiber switch hands over to the context it
  // names.
  wake(record, value = 0n, first = false) {
    record.value = value;
    if (first) this.ready.unshift(record);
    else this.ready.push(record);
    this.schedule();
  }

  // A `step` as a microtask, once the code under way returns.
  schedule() {
    if (this.stepping) return;
    this.stepping = true;
    queueMicrotask(() => {
      this.stepping = false;
      this.step();
    });
  }

  // Hands the globals to the next due coroutine and runs or resumes it; with
  // none due, back to the page's thread (home), whose registers they held
  // before the first coroutine ran.
  step() {
    if (this.running !== null) return;
    if (this.over()) {
      this.ready.length = 0;
      return;
    }
    this.home ??= { sp: this.sp.value, tls: this.tls.value };
    const next = this.ready.shift();
    if (next === undefined) {
      this.sp.value = this.home.sp;
      this.tls.value = this.home.tls;
      return;
    }
    this.running = next;
    this.sp.value = next.sp ?? this.home.sp;
    this.tls.value = next.tls ?? this.home.tls;
    this.edx.value = next.edx;
    if (next.started) {
      next.resume(next.value);
      return;
    }
    next.started = true;
    let result;
    try {
      result = WebAssembly.promising(next.fn)(...next.args);
    } catch (error) {
      result = Promise.reject(error);
    }
    result.then(
      (value) => this.finish(next, value, null),
      (error) => this.finish(next, null, error),
    );
  }

  // Suspends the running coroutine: its registers are kept, `arm` sets up
  // what wakes it, and the next due one runs. A promise of the value its
  // wake gives, which resumes it.
  park(arm) {
    const record = this.running;
    record.sp = this.sp.value;
    record.tls = this.tls.value;
    record.edx = this.edx.value;
    // A suspended entry's frames are live on the page's stack: plain calls
    // run below them.
    if (record.settle) this.home = { sp: record.sp, tls: record.tls };
    this.running = null;
    const resumed = new Promise((resolve) => (record.resume = resolve));
    arm(record);
    this.schedule();
    return resumed;
  }

  // A coroutine's end: its result or failure. An entry answers its promise;
  // a thread clears and wakes its id word. A thread's failure (a trap, or
  // the process exit it called) is the program's: it fails the entries
  // under way, whose turns record it (fail), else it fails here.
  finish(record, value, error) {
    this.running = null;
    if (record.settle) {
      this.underWay.delete(record);
      this.home = { sp: this.sp.value, tls: this.tls.value };
      if (error === null) record.settle.resolve(value);
      else record.settle.reject(error);
    } else if (error !== null) {
      this.end();
      if (this.underWay.size === 0) this.fail(error);
      for (const entry of this.underWay) entry.settle.reject(error);
      this.underWay.clear();
    } else if (record.clearTid !== 0) {
      this.view().setInt32(record.clearTid, 0, true);
      this.futexWake(record.clearTid, Infinity);
    }
    this.schedule();
  }

  // The scene the runtime's last core.ui paint recorded (UiBackends.jet), as
  // the children of `#jet-app`: a button for a Button, an input for a
  // TextInput, a span for a Text and a div for any other leaf, each placed
  // at its frame, with its ARIA role and accessible name when it has a role.
  // The element in the focused element's place, when of its kind, takes the
  // focus. An element with a click slot runs its handler on click; one with
  // a drop slot accepts drops and runs its handler on each dropped item; an
  // input with a change slot runs its handler on its value at each input,
  // and keeps the selection across the repaint that may follow; one with a
  // files slot accepts a drop of files,
  // which the provider keeps (filesDropped) for the handler it then clicks
  // to take (deviceRequest); one with context menu entries opens them
  // (openMenu) on contextmenu in place of the browser's own menu. An
  // element of a body a person drags (app.draggable) drags; one of a body
  // that takes what is moved (app.drop_zone) takes a drop, which moves what
  // the person drags there (move) and refuses anything else. The move needs
  // no drag: the first such element of each dragged body is focusable, and
  // Space picks it up, the arrow keys step it through the bodies that take
  // what is moved, Enter drops it on the one outlined and Escape puts it
  // back (pickKey); its contextmenu (a long press on a touch screen, or the
  // menu key) offers a move to each body that takes its kind, after its own
  // entries.
  paintScene() {
    if (!this.dom || this.rt.jet_ui_web_scene_take() === 0n) return;
    const doc = globalThis.document;
    let root = doc.getElementById("jet-app");
    if (!root) {
      root = doc.createElement("div");
      root.id = "jet-app";
      root.style.position = "relative";
      doc.body.appendChild(root);
    }
    const before = Array.from(root.children);
    const focusAt = before.indexOf(doc.activeElement);
    const focusTag = focusAt >= 0 ? before[focusAt].tagName : "";
    for (const child of before) child.remove();
    const at = Number(this.rt.jet_ui_web_scene_data());
    const bytes = this.u8().slice(at, at + Number(this.rt.jet_ui_web_scene_length()));
    let offset = 0;
    // The next `count` tab-ended fields, then a label of `length` bytes and
    // its newline.
    const fields = (count) => {
      const taken = [];
      while (taken.length < count) {
        const end = bytes.indexOf(9, offset);
        taken.push(decoder.decode(bytes.subarray(offset, end)));
        offset = end + 1;
      }
      return taken;
    };
    const label = (length) => {
      const text = decoder.decode(bytes.subarray(offset, offset + Number(length)));
      offset += Number(length) + 1;
      return text;
    };
    // The bodies that take what is moved, by their take slots, in paint
    // order, and the dragged bodies by their pick slots, each with its kind,
    // its name, its elements and whether one of them is focusable.
    const zones = new Map();
    const drags = new Map();
    const held = (bodies, slot, kind, name, element) => {
      if (!bodies.has(slot)) bodies.set(slot, { slot, kind, name, elements: [], focusable: false });
      bodies.get(slot).elements.push(element);
      return bodies.get(slot);
    };
    this.picked = null;
    this.dragging = 0;
    while (offset < bytes.length) {
      const [kind, slot, dropSlot, changeSlot, filesSlot, entries, pickSlot, pickKind, takeSlot, takeKind, x, y, width, height, color, role, length] = fields(17);
      const text = label(length);
      const name = role !== "" ? label(fields(1)[0]) : "";
      const pick = Number(pickSlot);
      const take = Number(takeSlot);
      const dragName = pick !== 0 ? label(fields(1)[0]) : "";
      const zoneName = take !== 0 ? label(fields(1)[0]) : "";
      const menu = [];
      for (let index = 0; index < Number(entries); index += 1) {
        const [entryKind, entrySlot, entryLength] = fields(3);
        menu.push({ kind: entryKind, slot: Number(entrySlot), label: label(entryLength) });
      }
      const tag = kind === "3" ? "button" : kind === "4" ? "input" : kind === "1" ? "span" : "div";
      const element = doc.createElement(tag);
      element.style.position = "absolute";
      element.style.left = x + "px";
      element.style.top = y + "px";
      element.style.width = width + "px";
      element.style.height = height + "px";
      if (color !== "" && tag !== "span") element.style.background = color;
      if (tag === "input") element.value = text;
      else element.textContent = text;
      if (role !== "") {
        element.role = role;
        element.ariaLabel = name;
      }
      const id = Number(slot);
      if (id !== 0) element.addEventListener("click", () => this.click(id));
      const changeId = Number(changeSlot);
      if (changeId !== 0) element.addEventListener("input", () => this.change(changeId, element));
      const dropId = Number(dropSlot);
      const filesId = Number(filesSlot);
      if (take !== 0) held(zones, take, takeKind, zoneName, element);
      if (dropId !== 0 || filesId !== 0 || take !== 0) {
        element.addEventListener("dragover", (event) => event.preventDefault());
        element.addEventListener("drop", (event) => {
          event.preventDefault();
          const files = Array.from(event.dataTransfer?.files ?? []);
          if (filesId !== 0 && files.length > 0) {
            globalThis.jetUiProvider?.filesDropped?.(files);
            return this.click(filesId);
          }
          if (take !== 0) {
            const moved = this.dragging;
            this.dragging = 0;
            return this.move(moved, take);
          }
          if (dropId !== 0) return this.drop(dropId, event.dataTransfer);
          return Promise.resolve();
        });
      }
      if (pick !== 0) {
        const body = held(drags, pick, pickKind, dragName, element);
        element.draggable = true;
        element.addEventListener("dragstart", (event) => {
          event.dataTransfer?.setData?.("application/x-jet-move", dragName);
          this.dragging = pick;
        });
        element.addEventListener("dragend", () => (this.dragging = 0));
        if (!body.focusable && tag !== "button" && tag !== "input") {
          body.focusable = true;
          element.tabIndex = 0;
          element.addEventListener("keydown", (event) => this.pickKey(body, event));
        }
      }
      if (menu.length > 0 || pick !== 0) {
        element.addEventListener("contextmenu", (event) => {
          const moves = [...zones.values()]
            .filter((zone) => zone.kind === pickKind)
            .map((zone) => ({ kind: "3", label: `Move ${dragName} to ${zone.name}`, run: () => this.move(pick, zone.slot) }));
          const shown = pick !== 0 ? [...menu, ...(menu.length > 0 && moves.length > 0 ? [{ kind: "0" }] : []), ...moves] : menu;
          if (shown.length === 0) return;
          event.preventDefault();
          this.openMenu(shown, event.clientX, event.clientY);
        });
      }
      root.appendChild(element);
    }
    this.zones = [...zones.values()];
    const again = focusAt >= 0 ? root.children[focusAt] : undefined;
    if (again?.tagName === focusTag) again.focus();
  }

  // Moves what the dragged body whose pick slot is `pick` holds onto the
  // body whose take slot is `take`: its handler picks the value up, then
  // the other's takes it. With no pick (0), as for a drop from elsewhere,
  // the take refuses the drop. A promise of the take's end.
  move(pick, take) {
    return (pick !== 0 ? this.click(pick) : Promise.resolve()).then(() => this.click(take));
  }

  // A key on the focusable element of the dragged body `body`: Space picks
  // it up and outlines the first body that takes what is moved; with it
  // picked up, an arrow key outlines the next (Right, Down) or the
  // previous (Left, Up) one, around the end, Enter drops it on the one
  // outlined (move) and Escape puts it back.
  pickKey(body, event) {
    const outline = (at) => {
      this.zones.forEach((zone, index) => zone.elements.forEach((element) => (element.style.outline = index === at ? "2px solid #3366ff" : "")));
    };
    if (this.picked === null || this.picked.body !== body) {
      if (event.key !== " " || this.zones.length === 0) return Promise.resolve();
      event.preventDefault();
      this.picked = { body, at: 0 };
      outline(0);
      return Promise.resolve();
    }
    const count = this.zones.length;
    const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: count - 1, ArrowUp: count - 1 }[event.key];
    if (step !== undefined) {
      event.preventDefault();
      this.picked.at = (this.picked.at + step) % count;
      outline(this.picked.at);
      return Promise.resolve();
    }
    if (event.key !== "Enter" && event.key !== "Escape") return Promise.resolve();
    event.preventDefault();
    const zone = this.zones[this.picked.at];
    this.picked = null;
    outline(-1);
    return event.key === "Enter" ? this.move(body.slot, zone.slot) : Promise.resolve();
  }

  // Opens a scene element's context menu (`app.context_menu`) at the
  // viewport point (x, y), over the page, closing any open one: a menu item
  // button for an entry the person chooses (kind 3), a disabled one for an
  // entry that can't be chosen (kind 1) and a separator for any other.
  // Choosing an entry closes the menu and runs its handler as a click on a
  // scene element does; a click elsewhere or Escape closes it, and that
  // click or key reaches nothing else.
  openMenu(menu, x, y) {
    this.closeMenu();
    const doc = globalThis.document;
    const box = doc.createElement("div");
    box.setAttribute("role", "menu");
    box.style.position = "fixed";
    box.style.left = x + "px";
    box.style.top = y + "px";
    box.style.background = "#f5f5f5";
    box.style.border = "1px solid #c8c8c8";
    box.style.zIndex = "2147483647";
    for (const entry of menu) {
      if (entry.kind !== "3" && entry.kind !== "1") {
        const line = doc.createElement("hr");
        line.setAttribute("role", "separator");
        box.appendChild(line);
        continue;
      }
      const item = doc.createElement("button");
      item.setAttribute("role", "menuitem");
      item.style.display = "block";
      item.style.width = "100%";
      item.style.textAlign = "left";
      item.textContent = entry.label;
      if (entry.kind === "3" && (entry.run !== undefined || entry.slot !== 0)) {
        item.addEventListener("click", () => {
          this.closeMenu();
          return entry.run !== undefined ? entry.run() : this.click(entry.slot);
        });
      } else item.disabled = true;
      box.appendChild(item);
    }
    const away = (event) => {
      if (box.contains(event.target)) return;
      event.preventDefault();
      event.stopPropagation();
      this.closeMenu();
    };
    const escape = (event) => {
      if (event.key !== "Escape") return;
      event.preventDefault();
      event.stopPropagation();
      this.closeMenu();
    };
    doc.addEventListener("click", away, true);
    doc.addEventListener("keydown", escape, true);
    doc.body.appendChild(box);
    this.menu = { box, away, escape };
  }

  // Closes the open context menu (openMenu), if there is one.
  closeMenu() {
    if (this.menu === null) return;
    const doc = globalThis.document;
    doc.removeEventListener("click", this.menu.away, true);
    doc.removeEventListener("keydown", this.menu.escape, true);
    this.menu.box.remove();
    this.menu = null;
  }

  // A click on a scene element, once the program's run returned 0: runs the
  // element's handler as the next entry (turn), then shows what it changed
  // (show). A route's click (bindRoute) first sets its event's payload
  // (`before`), in its own turn. A promise of the handler's end.
  click(id, before = null) {
    return this.turn(async () => {
      if (this.outcome !== 0) return;
      before?.();
      await this.waitableCall(this.rt.jet_ui_click, BigInt(id));
      await this.show();
    });
  }

  // The end of an entry that ran the program's handlers: the app that
  // launched with screens draws them again when what they show changed
  // (app.launch's draw hook, which the provider names), stdout drains, and
  // the page shows the scene painted.
  async show() {
    const draw = globalThis.jetUiProvider?.drawHook?.() ?? 0;
    if (draw !== 0) await this.waitableCall(this.rt.jet_ui_click, BigInt(draw));
    this.rt.jet_rt_stdout_flush();
    this.flushLines();
    this.paintScene();
  }

  // The page's lifecycle, told to the app that launched (app.launch's hook,
  // whose click takes the moments the provider holds for it): the document
  // shown or hidden, the window taking or losing the focus, the page frozen
  // and resumed (the Page Lifecycle API, and a page the back-forward cache
  // keeps or gives back), and the page going away.
  followLifecycle(doc) {
    if (!doc.addEventListener) return;
    const tell = (moment) => {
      const hook = globalThis.jetUiProvider?.moment?.(moment) ?? 0;
      return hook !== 0 ? this.click(hook) : Promise.resolve();
    };
    doc.addEventListener("visibilitychange", () => tell(doc.visibilityState === "hidden" ? "hidden" : "visible"));
    doc.addEventListener("freeze", () => tell("freeze"));
    doc.addEventListener("resume", () => tell("resume"));
    // A page's window is its global object.
    if (!globalThis.addEventListener) return;
    globalThis.addEventListener("focus", () => tell("focus"));
    globalThis.addEventListener("blur", () => tell("blur"));
    globalThis.addEventListener("pagehide", (event) => tell(event.persisted ? "freeze" : "gone"));
    globalThis.addEventListener("pageshow", (event) => (event.persisted ? tell("resume") : Promise.resolve()));
  }

  // A drop on a scene element with a drop slot, as core.ui.host.drag_drop
  // reads one: nonempty `text/plain` is one Text item (kind 0) and each
  // `text/uri-list` line that is neither empty nor a `#` comment one URI item
  // (kind 1). The items are read while the drop is dispatched; then, once
  // the program's run returned 0, each runs the element's handler in order
  // as the next entry (turn), and the page shows what they changed (show).
  // A promise of the last handler's end.
  drop(id, data) {
    if (!data) return Promise.resolve();
    const items = [];
    const text = data.getData("text/plain");
    if (text.length > 0) items.push([0, text]);
    for (const line of data.getData("text/uri-list").split("\n")) {
      const uri = line.trim();
      if (uri.length > 0 && !uri.startsWith("#")) items.push([1, uri]);
    }
    return this.turn(async () => {
      if (this.outcome !== 0) return;
      for (const [kind, value] of items) {
        const bytes = encoder.encode(value);
        const at = Number(this.rt.jet_ui_web_text_buffer(BigInt(bytes.length)));
        this.u8().set(bytes, at);
        await this.waitableCall(this.rt.jet_ui_web_drop, BigInt(id), BigInt(kind));
      }
      await this.show();
    });
  }

  // An input in `element`, a scene element with change slot `id`: once the
  // program's run returned 0, the element's handler runs on its value as the
  // next entry (turn), and the page shows what it changed (show). That
  // repaint replaces the elements: the element in the input's place takes
  // the focus (paintScene) and the selection it had. A promise of the
  // handler's end.
  change(id, element) {
    const value = element.value;
    return this.turn(async () => {
      if (this.outcome !== 0) return;
      const bytes = encoder.encode(value);
      const at = Number(this.rt.jet_ui_web_text_buffer(BigInt(bytes.length)));
      this.u8().set(bytes, at);
      await this.waitableCall(this.rt.jet_ui_web_change, BigInt(id));
      const doc = globalThis.document;
      const focused = doc.activeElement === element;
      const [start, end] = [element.selectionStart, element.selectionEnd];
      await this.show();
      const again = doc.activeElement;
      if (focused && again && again !== element && again.tagName === "INPUT") again.setSelectionRange?.(start, end);
    });
  }

  // The argument and environment strings and their pointer arrays at the top
  // of the stack, the stack pointer below them, then an empty auxiliary
  // vector (one AT_NULL pair): the runtime reads that vector after envp's
  // terminating null, as on Linux, and finds no entry.
  place(args, environment) {
    const strings = [...args, ...environment].map((item) => encoder.encode(item + "\0"));
    const size = alignUp(strings.reduce((total, bytes) => total + bytes.length, 0), 16);
    const words = alignUp((args.length + environment.length + 4) * 8, 16);
    const view = this.view();
    let at = this.stackTop - size;
    const addresses = [];
    for (const bytes of strings) {
      this.u8().set(bytes, at);
      addresses.push(at);
      at += bytes.length;
    }
    const argv = this.stackTop - size - words;
    let slot = argv;
    const put = (value) => {
      view.setBigInt64(slot, BigInt(value), true);
      slot += 8;
    };
    for (let index = 0; index < args.length; index += 1) put(addresses[index]);
    put(0);
    const envp = slot;
    for (let index = 0; index < environment.length; index += 1) put(addresses[args.length + index]);
    put(0);
    put(0);
    put(0);
    this.base = BigInt(argv);
    this.sp.value = this.base;
    return [args.length, argv, envp];
  }

  flushLines() {
    for (const fd of [1, 2]) {
      if (this.lines[fd] !== "") (fd === 1 ? console.log : console.error)(this.lines[fd]);
      this.lines[fd] = "";
    }
  }

  path(dirfd, at) {
    const name = this.text(at);
    if (name.startsWith("/") || dirfd === -100) return name;
    return fs.readlinkSync("/proc/self/fd/" + dirfd) + "/" + name;
  }

  syscall(number, a, b, c, d, e, f) {
    const call = SYSCALLS[number];
    if (call === undefined) return -E.NOSYS;
    try {
      return call(this, a, b, c, d, e, f);
    } catch (error) {
      if (error instanceof JetHostExit) throw error;
      if (typeof error?.errno === "number") return error.errno < 0 ? error.errno : -error.errno;
      return -E.IO;
    }
  }

  read(fd, buffer, length, position) {
    if (!fs) return fd === 0 ? 0 : -E.BADF;
    const file = this.files.get(fd);
    const at = position ?? (file ? file.position : null);
    for (;;) {
      try {
        const count = fs.readSync(fd, this.u8(), buffer, length, at);
        if (position === undefined && file) file.position += count;
        return count;
      } catch (error) {
        if (error.code === "EOF") return 0;
        if (error.code !== "EAGAIN") throw error;
        sleep(1);
      }
    }
  }

  write(fd, buffer, length, position) {
    if (!fs) {
      if (fd !== 1 && fd !== 2) return -E.BADF;
      const parts = (this.lines[fd] + decoder.decode(this.u8().slice(buffer, buffer + length))).split("\n");
      this.lines[fd] = parts.pop();
      for (const line of parts) (fd === 1 ? console.log : console.error)(line);
      return length;
    }
    const file = this.files.get(fd);
    const at = position ?? (file ? file.position : null);
    for (;;) {
      try {
        const count = fs.writeSync(fd, this.u8(), buffer, length, at);
        if (position === undefined && file) file.position += count;
        return count;
      } catch (error) {
        if (error.code !== "EAGAIN") throw error;
        sleep(1);
      }
    }
  }

  vector(fd, iov, count, position, transfer) {
    const view = this.view();
    let total = 0;
    for (let index = 0; index < count; index += 1) {
      const base = Number(view.getBigUint64(iov + 16 * index, true));
      const length = Number(view.getBigUint64(iov + 16 * index + 8, true));
      if (length === 0) continue;
      const done = transfer.call(this, fd, base, length, position === undefined ? undefined : position + total);
      if (done < 0) return total > 0 ? total : done;
      total += done;
      if (done < length) break;
    }
    return total;
  }

  open(path, flags, mode) {
    if (!fs) return -E.NOSYS;
    const fd = fs.openSync(path, flags, mode);
    this.files.set(fd, { position: 0, flags, entries: null, cursor: 0 });
    return fd;
  }

  stat(at, info) {
    const view = this.view();
    this.zero(at, 144);
    view.setBigUint64(at, info.dev, true);
    view.setBigUint64(at + 8, info.ino, true);
    view.setBigUint64(at + 16, info.nlink, true);
    view.setUint32(at + 24, Number(info.mode), true);
    view.setUint32(at + 28, Number(info.uid), true);
    view.setUint32(at + 32, Number(info.gid), true);
    view.setBigUint64(at + 40, info.rdev, true);
    view.setBigInt64(at + 48, info.size, true);
    view.setBigInt64(at + 56, info.blksize, true);
    view.setBigInt64(at + 64, info.blocks, true);
    const times = [info.atimeNs, info.mtimeNs, info.ctimeNs];
    for (let index = 0; index < 3; index += 1) {
      view.setBigInt64(at + 72 + 16 * index, times[index] / 1000000000n, true);
      view.setBigInt64(at + 80 + 16 * index, times[index] % 1000000000n, true);
    }
    return 0;
  }

  statx(at, info) {
    const view = this.view();
    this.zero(at, 256);
    view.setUint32(at, 0xfff, true);
    view.setUint32(at + 4, Number(info.blksize), true);
    view.setUint32(at + 16, Number(info.nlink), true);
    view.setUint32(at + 20, Number(info.uid), true);
    view.setUint32(at + 24, Number(info.gid), true);
    view.setUint16(at + 28, Number(info.mode), true);
    view.setBigUint64(at + 32, info.ino, true);
    view.setBigUint64(at + 40, info.size, true);
    view.setBigUint64(at + 48, info.blocks, true);
    const times = [info.atimeNs, info.birthtimeNs, info.ctimeNs, info.mtimeNs];
    for (let index = 0; index < 4; index += 1) {
      view.setBigInt64(at + 64 + 16 * index, times[index] / 1000000000n, true);
      view.setUint32(at + 72 + 16 * index, Number(times[index] % 1000000000n), true);
    }
    view.setUint32(at + 128, Number(info.rdev >> 8n) & 0xfff, true);
    view.setUint32(at + 132, Number(info.rdev & 0xffn), true);
    view.setUint32(at + 136, Number(info.dev >> 8n) & 0xfff, true);
    view.setUint32(at + 140, Number(info.dev & 0xffn), true);
    return 0;
  }

  entries(fd, buffer, count) {
    if (!fs) return -E.NOSYS;
    let file = this.files.get(fd);
    if (!file) {
      file = { position: null, flags: 0, entries: null, cursor: 0 };
      this.files.set(fd, file);
    }
    if (file.entries === null) {
      const kind = (entry) =>
        entry.isDirectory() ? 4 : entry.isFile() ? 8 : entry.isSymbolicLink() ? 10 : entry.isFIFO() ? 1 : entry.isSocket() ? 12 : entry.isCharacterDevice() ? 2 : entry.isBlockDevice() ? 6 : 0;
      const listed = fs.readdirSync(fs.readlinkSync("/proc/self/fd/" + fd), { withFileTypes: true });
      file.entries = [[".", 4], ["..", 4], ...listed.map((entry) => [entry.name, kind(entry)])];
      file.cursor = 0;
    }
    const view = this.view();
    const bytes = this.u8();
    let at = 0;
    while (file.cursor < file.entries.length) {
      const [name, type] = file.entries[file.cursor];
      const encoded = encoder.encode(name);
      const length = alignUp(19 + encoded.length + 1, 8);
      if (at + length > count) break;
      bytes.fill(0, buffer + at, buffer + at + length);
      view.setBigUint64(buffer + at, BigInt(file.cursor + 1), true);
      view.setBigInt64(buffer + at + 8, BigInt(file.cursor + 1), true);
      view.setUint16(buffer + at + 16, length, true);
      bytes[buffer + at + 18] = type;
      bytes.set(encoded, buffer + at + 19);
      at += length;
      file.cursor += 1;
    }
    if (at === 0 && file.cursor < file.entries.length) return -E.INVAL;
    return at;
  }

  map(length, flags, fd, offset) {
    if (length <= 0) return -E.INVAL;
    const size = alignUp(length, 4096);
    let at = -1;
    for (let index = 0; index < this.unmapped.length; index += 1) {
      const [start, free] = this.unmapped[index];
      if (free < size) continue;
      at = start;
      if (free === size) this.unmapped.splice(index, 1);
      else this.unmapped[index] = [start + size, free - size];
      this.u8().fill(0, at, at + size);
      break;
    }
    if (at < 0) {
      const grown = alignUp(size, PAGE);
      try {
        at = this.memory.grow(grown / PAGE) * PAGE;
      } catch {
        return -E.NOMEM;
      }
      if (grown > size) this.unmap(at + size, grown - size);
    }
    if ((flags & 0x20) === 0) {
      if (!fs) return -E.NODEV;
      let done = 0;
      while (done < length) {
        const count = fs.readSync(fd, this.u8(), at + done, length - done, offset + done);
        if (count === 0) break;
        done += count;
      }
    }
    return at;
  }

  unmap(address, length) {
    if (length <= 0) return -E.INVAL;
    this.unmapped.push([address, alignUp(length, 4096)]);
    this.unmapped.sort((left, right) => left[0] - right[0]);
    const merged = [];
    for (const range of this.unmapped) {
      const last = merged[merged.length - 1];
      if (last && last[0] + last[1] >= range[0]) last[1] = Math.max(last[1], range[0] + range[1] - last[0]);
      else merged.push([range[0], range[1]]);
    }
    this.unmapped = merged;
    return 0;
  }

  timespec(at, nanoseconds) {
    const view = this.view();
    view.setBigInt64(at, nanoseconds / 1000000000n, true);
    view.setBigInt64(at + 8, nanoseconds % 1000000000n, true);
  }

  sleepUntil(request, absolute, clock) {
    const view = this.view();
    let nanoseconds = view.getBigInt64(request, true) * 1000000000n + view.getBigInt64(request + 8, true);
    if (absolute) nanoseconds -= nowNanoseconds(clock);
    sleep(Number(nanoseconds / 1000000n));
    return 0;
  }

  // The futex wait of the running coroutine (JetRuntime Sync.jet
  // jet_rt_host_wait): -EAGAIN at once when the word at `address` is not
  // `expected`, else a promise of 0 once a futex wake (futexWake) reaches
  // it, or of -ETIMEDOUT once the monotonic clock reaches `deadline`, in
  // nanoseconds (-1: never). It stays suspended until then while the page's
  // event loop and the program's other threads run; the next entry waits
  // its turn.
  wait(address, expected, deadline) {
    const at = Number(address);
    if (this.view().getInt32(at, true) !== Number(BigInt.asIntN(32, expected))) return BigInt(-E.AGAIN);
    return this.park((record) => {
      const waiter = { record, timer: null };
      const queue = this.waiters.get(at) ?? [];
      queue.push(waiter);
      this.waiters.set(at, queue);
      if (deadline < 0n) return;
      const milliseconds = Math.max(0, Math.ceil(Number(deadline - nowNanoseconds(1)) / 1000000));
      waiter.timer = this.later(milliseconds, () => {
        const left = this.waiters.get(at) ?? [];
        const index = left.indexOf(waiter);
        if (index < 0) return;
        left.splice(index, 1);
        if (left.length === 0) this.waiters.delete(at);
        this.wake(record, BigInt(-E.TIMEDOUT));
      });
    });
  }

  // `body` after `milliseconds`, unless the program ends first (end).
  later(milliseconds, body) {
    const timer = setTimeout(() => {
      this.timers.delete(timer);
      body();
    }, milliseconds);
    this.timers.add(timer);
    return timer;
  }

  // A futex wake: resumes up to `count` of the coroutines waiting on
  // `address`, longest waiting first; how many it resumed.
  futexWake(address, count) {
    const queue = this.waiters.get(address) ?? [];
    let woken = 0;
    while (queue.length > 0 && woken < count) {
      const waiter = queue.shift();
      if (waiter.timer !== null) {
        clearTimeout(waiter.timer);
        this.timers.delete(waiter.timer);
      }
      this.wake(waiter.record);
      woken += 1;
    }
    if (queue.length === 0) this.waiters.delete(address);
    return woken;
  }

  // A fiber switch (JetRuntime Fiber.jet fiber_run and fiber_switch_out,
  // through JetWeb Leaf.jet os_fiber_switch_i64): the running coroutine
  // leaves at `save` a token a later switch to it names and suspends, and
  // the context `target` names runs next on the same thread: the coroutine
  // a switch left there, else a fresh fiber, whose seed (Fiber.jet
  // fiber_new) holds the function jet_rt_fiber_entry at `target` and starts
  // with its stack pointer there and the switching thread's registers.
  // Tokens lie past 32 bits, so none is a seed's address.
  fiberSwitch(save, target) {
    this.tokens += 1n;
    const token = (1n << 32n) + this.tokens;
    this.view().setBigUint64(Number(save), token, true);
    return this.park((record) => {
      this.switched.set(token, record);
      const left = this.switched.get(target);
      if (left !== undefined) {
        this.switched.delete(target);
        left.tid = record.tid;
        this.wake(left, 0n, true);
        return;
      }
      const entry = this.view().getBigUint64(Number(target), true);
      const fiber = { fn: this.table.get(Number(entry)), args: [0n], sp: target, tls: record.tls, edx: 0, tid: record.tid, clearTid: 0, started: false };
      this.wake(fiber, 0n, true);
    });
  }

  // A thread start (clone, JetRuntime Thread.jet thread_spawn): under JSPI
  // a coroutine on its own stack `stack`, which holds the function
  // jet_rt_thread_entry and its start record; it starts with the starting
  // thread's thread pointer, as a clone without CLONE_SETTLS does, once the
  // running coroutine suspends. CLONE_PARENT_SETTID stores its id at
  // `parentTid`; CLONE_CHILD_CLEARTID has its end clear `childTid` and wake
  // it (finish). Without JSPI the host runs one thread and refuses.
  clone(flags, stack, parentTid, childTid) {
    if (!JSPI) {
      if (!this.threadsRefused) console.error("jet: this web host can't run tasks: it has no JavaScript Promise Integration (WebAssembly.Suspending and WebAssembly.promising)");
      this.threadsRefused = true;
      return -E.AGAIN;
    }
    const view = this.view();
    const tid = this.nextTid;
    this.nextTid += 1;
    if ((flags & 0x100000) !== 0) view.setInt32(parentTid, tid, true);
    if ((flags & 0x1000000) !== 0) view.setInt32(childTid, tid, true);
    const entry = view.getBigUint64(stack, true);
    const start = view.getBigUint64(stack + 8, true);
    this.launch({ fn: this.table.get(Number(entry)), args: [start], sp: BigInt(stack), tls: this.tls.value, tid, clearTid: (flags & 0x200000) !== 0 ? childTid : 0 });
    return tid;
  }

  terminate(signal) {
    this.flushLines();
    throw new JetHostExit(128 + signal);
  }

  cLibrary() {
    const host = this;
    // The UI provider seam's leaves forward to the page's browser provider,
    // globalThis.jetUiProvider, and only marshal: Core owns every rule and
    // error. A text or byte answer (a Uint8Array) is staged here until
    // jet_ui_provider_take copies it. An answer the provider gives later, a
    // promise, waits in `pending` for jet_ui_provider_settle; a refused
    // promise is no answer.
    const provider = () => globalThis.jetUiProvider;
    let staged = null;
    let pending = null;
    const stage = (answer) => {
      if (typeof answer?.then === "function") {
        pending = Promise.resolve(answer).catch(() => null);
        return -2n;
      }
      staged = answer == null ? null : answer instanceof Uint8Array ? answer : encoder.encode(answer);
      return staged === null ? -1n : BigInt(staged.length);
    };
    const textAt = (bytes, length) => decoder.decode(host.u8().slice(Number(bytes), Number(bytes) + Number(length)));
    return {
      jet_ui_provider_capability: (code) => (provider()?.capability(Number(code)) ? 1n : 0n),
      jet_ui_provider_clipboard_get: () => stage(provider()?.clipboardGet()),
      jet_ui_provider_clipboard_set: (bytes, length) => (provider()?.clipboardSet(textAt(bytes, length)) ? 0n : -1n),
      jet_ui_provider_event_pop: (queue) => stage(provider()?.eventPop(Number(queue))),
      jet_ui_provider_dialog_request: (kind, bytes, length) => BigInt(provider()?.dialogRequest(Number(kind), textAt(bytes, length)) ?? -1),
      jet_ui_provider_dialog_result: (token) => stage(provider()?.dialogResult(Number(token))),
      // What the program printed shows before what the page does for it.
      jet_ui_provider_device: (kind, bytes, length) => {
        host.rt.jet_rt_stdout_flush();
        host.flushLines();
        return stage(provider()?.device?.(Number(kind), textAt(bytes, length)));
      },
      jet_ui_provider_key_claim: (bytes, length) => (provider()?.keyClaim(textAt(bytes, length)) ? 0n : -1n),
      jet_ui_provider_save_file: (name, nameLength, media, mediaLength, bytes, length) =>
        (provider()?.saveFile?.(textAt(name, nameLength), textAt(media, mediaLength), host.u8().slice(Number(bytes), Number(bytes) + Number(length))) ? 0n : -1n),
      jet_ui_provider_take: (buffer) => {
        if (staged !== null) host.u8().set(staged, Number(buffer));
        staged = null;
      },
      // The provider's later answer, staged once the asking thread runs
      // again; it stays suspended meanwhile, as in wait.
      jet_ui_provider_settle: JSPI
        ? new WebAssembly.Suspending(() => {
            const answer = pending;
            pending = null;
            return host.park((record) => answer.then((value) => host.wake(record, value ?? null))).then(stage);
          })
        : () => -1n,
      // The calling chain (trace): up to `capacity` bytes of its lines at
      // `buffer`, and their full length.
      jet_rt_host_frames: (buffer, capacity) => {
        const lines = encoder.encode(host.trace());
        if (capacity > 0n) host.u8().set(lines.subarray(0, Math.min(lines.length, Number(capacity))), Number(buffer));
        return BigInt(lines.length);
      },
      // The wait seam (wait): under JSPI the running coroutine (an entry
      // under waitableCall, or a thread) can wait, and a plain call of the
      // page can't. Without JSPI an entry would wait and can't, so its wait
      // stops the program (jet_rt_host_wait_refused) in place of an answer.
      jet_rt_host_can_wait: () => {
        if (JSPI) return host.running !== null ? 1n : 0n;
        if (host.waitable) host.rt.jet_rt_host_wait_refused();
        return 0n;
      },
      jet_rt_host_wait: JSPI ? new WebAssembly.Suspending((address, expected, deadline) => host.wait(address, expected, deadline)) : () => BigInt(-E.NOSYS),
      getauxval: (type) => {
        if (type === 6n) return 4096n;
        if (type === 25n) return BigInt(AUX_RANDOM);
        return 0n;
      },
    };
  }
}

// The Linux x86-64 system calls the host answers; any other is ENOSYS.
const SYSCALLS = {
  0: (h, fd, buffer, length) => h.read(fd, buffer, length),
  1: (h, fd, buffer, length) => h.write(fd, buffer, length),
  2: (h, path, flags, mode) => h.open(h.text(path), flags, mode),
  3: (h, fd) => {
    if (fd > 2 && fs) fs.closeSync(fd);
    h.files.delete(fd);
    return 0;
  },
  4: (h, path, at) => (fs ? h.stat(at, fs.statSync(h.text(path), { bigint: true })) : -E.NOSYS),
  5: (h, fd, at) => (fs ? h.stat(at, fs.fstatSync(fd, { bigint: true })) : -E.NOSYS),
  6: (h, path, at) => (fs ? h.stat(at, fs.lstatSync(h.text(path), { bigint: true })) : -E.NOSYS),
  7: (h, fds, count) => {
    const view = h.view();
    let ready = 0;
    for (let index = 0; index < count; index += 1) {
      const events = view.getInt16(fds + 8 * index + 4, true);
      const revents = events & 5;
      view.setInt16(fds + 8 * index + 6, revents, true);
      if (revents !== 0) ready += 1;
    }
    return ready;
  },
  8: (h, fd, offset, whence) => {
    const file = h.files.get(fd);
    if (!file || file.position === null) return -E.SPIPE;
    const base = whence === 0 ? 0 : whence === 1 ? file.position : whence === 2 ? Number(fs.fstatSync(fd).size) : NaN;
