// Fixed timing in the selected WebAssembly: the wasm32 table of the
// instructions a `timing: .Fixed` value may meet, and the validator that
// checks the code emitted for a function with a fixed slot against it (the
// fixed slots and the x86-64 table are JetIR Timing.jet's).
//
// The WebAssembly Core Specification gives no instruction a timing. The
// table is CT-Wasm's: Watt, Renner, Popescu, Cauligi and Stefan, "CT-Wasm:
// Type-Driven Secure Cryptography for the Web Ecosystem" (POPL 2019), whose
// secret integers may meet the integer constants, arithmetic, bit, shift,
// rotate, comparison and width instructions but not division or remainder,
// and may decide no branch, select, call target or memory address. Of
// those, web_timing_row admits the ones the selector (Select.jet) writes
// for a fixed word. Code one public slot alone decides (a shift's check of
// its public count, WebEmitter.decided) is admitted whole, as JetIR
// Timing.jet admits a stop whose tested value is public. The engine that
// compiles the module chooses the machine instructions, so the code's
// timing on a host is the engine's.

use {
    jet_foundation.[Type]
    jet_ir.[IRFunction, IRModule, IROp, IRSlotKind, IR_OVERFLOW_WRAP, ir_emit, ir_function_new, ir_intern_name, ir_module_new, ir_slot, ir_timing_any, ir_timing_at, ir_timing_finding, ir_timing_fixed, ir_type_row, ir_x64_reads_into]
    jet_wasm.[WasmOpTable, WasmReader, wasm_decode_body]
}

// Whether opcode `op` (0xfc00 + n for a 0xfc-prefixed one) is in the
// wasm32 table: the structure that decides nothing (nop, block, else, end,
// br, return), a direct call (its callee is checked on its own), drop,
// local and global access, i32 and i64 constants, comparisons, add, sub,
// mul, and, or, xor, shifts and rotates, wrap and the extensions.
web_timing_row: fn(op: Int) -> Bool Never! {
    if op == 0x01 || op == 0x02 || op == 0x05 || op == 0x0b || op == 0x0c || op == 0x0f || op == 0x10 || op == 0x1a -> return true
    if op >= 0x20 && op <= 0x24 -> return true
    if op == 0x41 || op == 0x42 -> return true
    if op >= 0x45 && op <= 0x5a -> return true
    if (op >= 0x6a && op <= 0x6c) || (op >= 0x71 && op <= 0x78) -> return true
    if (op >= 0x7c && op <= 0x7e) || (op >= 0x83 && op <= 0x8a) -> return true
    op == 0xa7 || op == 0xac || op == 0xad || (op >= 0xc0 && op <= 0xc4)
}

// Whether opcode `op` reads or writes linear memory.
web_timing_memory: fn(op: Int) -> Bool Never! {
    (op >= 0x28 && op <= 0x3e) || op == 0xfc0a || op == 0xfc0b
}

// The findings of `body`, the code emitted for `f`, into `st.errors`.
// `marks` holds pairs: the emitter's code offset where an IR instruction's
// code starts, and the instruction (-1 for the epilogue after the last).
// `decided` holds triples: the emitter's code offsets [start, end) of code
// one slot alone decides, and that slot (WebEmitter.decided).
// Each wasm instruction in the code of an IR instruction with a fixed
// operand is in the table, or is a load or store of that instruction's
// public address (a Load's, Store's or StreamStore's `a`, a CopyBytes' `a`
// and `b`), or lies in code a public slot alone decides. The code is
// decoded with its call indices patched (to 0): an unpatched index's
// padding bytes are no instructions.
web_timing_check: fn(st: &WebState, m: IRModule, f: IRFunction, body: WebBody, marks: [Int], decided: [Int]) Never! {
    fixed: ir_timing_fixed(f)
    reads := [Int]{}
    operands := [Bool]{}
    loop at in 0..<f.op.len() {
        ir_x64_reads_into(f, at, reads)
        operand: ir_timing_any(fixed, reads)
        operands.push(operand)
        callee: f.a[at]
        if operand && f.op[at] == .Call && callee >= 0 && callee < m.functions.len() && m.functions[callee].asm != None -> st.errors.push(ir_timing_finding(f, at, "a fixed operand reaches an inline-asm template, whose bytes are not checked"))
    }
    ops: WasmOpTable.new()
    // copy: the reader owns the bytes it decodes; the body keeps its own.
    bytes := body.code.copy()
    loop pair in 0..<(body.fixups.len() /% 2) -> web_patch_padded(bytes, body.fixups[2 * pair], 0)
    reader := WasmReader.new(bytes.move())
    code: wasm_decode_body(reader, ops, true) ?? {
        st.errors.push("{f.name}: fixed timing: its code does not decode: {err.render()}")
        return
    }
    mark := 0
    loop k in 0..<code.op.len() {
        offset: code.at[k] - code.start
        loop mark + 2 < marks.len() && marks[mark + 2] <= offset -> mark += 2
        if mark >= marks.len() || marks[mark] > offset -> next
        at: marks[mark + 1]
        if at < 0 || !operands[at] -> next
        op: code.op[k]
        if web_timing_public_decision(decided, fixed, offset) -> next
        if web_timing_row(op) -> next
        if web_timing_memory(op) && web_timing_public_address(f, fixed, at) -> next
        name := "opcode {op}"
        if ops.info(op) == .Val(info) -> name = info.name
        st.errors.push(ir_timing_finding(f, at, "a fixed operand meets `{name}`, which the wasm32 table has no row for"))
    }
}

// Whether the code at `offset` lies in a range of `decided` (triples of
// start, end and slot) whose deciding slot is public.
web_timing_public_decision: fn(decided: [Int], fixed: [Bool], offset: Int) -> Bool Never! {
    loop index in 0..<(decided.len() /% 3) {
        if offset >= decided[3 * index] && offset < decided[3 * index + 1] && !ir_timing_at(fixed, decided[3 * index + 2]) -> return true
    }
    false
}

// Whether instruction `at` of `f` is a memory access at public addresses.
web_timing_public_address: fn(f: IRFunction, fixed: [Bool], at: Int) -> Bool Never! {
    if f.op[at] == {
        .Load | .Store | .StreamStore -> !ir_timing_at(fixed, f.a[at])
        .CopyBytes -> !ir_timing_at(fixed, f.a[at]) && !ir_timing_at(fixed, f.b[at])
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .StackAddress | .Offset | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig -> false
    }
}

// The findings for `code`, the instructions of `f`'s one IR instruction `op`
// (no local declarations, no `end`): `key` (slot 0) is fixed and `data`
// (slot 1) public, and `op` reads key then data, or data then key with
// `secret_right`. `fixups` holds the offsets of `code`'s padded call
// indices, `checks` pairs of the offsets [start, end) of code the right
// operand alone decides.
web_timing_test_errors: fn(op: IROp, code: [U8], fixups: [Int], checks: [Int], secret_right: Bool) -> [String] Never! {
    m := ir_module_new()
    word: ir_type_row(m, Type.IntN{signed: false, bits: 64}) ?? panic("no U64 row")
    f := ir_function_new("mix", "test:timing.jet::mix", "", "timing.jet", 1)
    key: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "key"), 1)
    data: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "data"), 1)
    mixed: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    f.slot_fixed[key] = true
    left: if secret_right -> data else -> key
    right: if secret_right -> key else -> data
    _ := ir_emit(f, op, mixed, left, right, IR_OVERFLOW_WRAP, 2)
    st := WebState{
        app: true, stop_points: false, data_at: [Int]{}, table_base: 0, slots: [Int]{}, slot_rows: [Int]{},
        types: [String]{}, type_rows: [String:Int]{}, refs: [WebRef]{}, ref_rows: [String:Int]{}, internal: [String:Int]{},
        exports: [String:String]{}, hosts: [String:Bool]{}, sigs: [String]{}, poll: -1, trap: -1, turn: -1, armed: -1, errors: [String]{},
    }
    // The body's one byte of local declarations comes first.
    bytes := [U8]{0x00}
    bytes.extend(code.copy())
    bytes.push(0x0b)
    patches := [Int]{}
    loop at in fixups {
        patches.push(at + 1)
        patches.push(0)
    }
    decided := [Int]{}
    loop pair in 0..<(checks.len() /% 2) {
        decided.push(checks[2 * pair])
        decided.push(checks[2 * pair + 1])
        decided.push(right)
    }
    web_timing_check(st, m, f, WebBody{code: bytes, fixups: patches}, [Int]{0, 0, code.len(), -1}, decided)
    st.errors.move()
}

#Test("A fixed word's xor passes the wasm32 validator and its division does not") {
    // local.get 0, local.get 1, i64.xor, local.set 2
    assert_eq(web_timing_test_errors(IROp.BitXor, [U8]{0x20, 0x00, 0x20, 0x01, 0x85, 0x21, 0x02}, [Int]{}, [Int]{}, false).len(), 0)
    // local.get 0, local.get 1, i64.div_u, local.set 2
    errors: web_timing_test_errors(IROp.Div, [U8]{0x20, 0x00, 0x20, 0x01, 0x80, 0x21, 0x02}, [Int]{}, [Int]{}, false)
    assert_eq(errors.len(), 1)
    assert_eq(errors[0], "mix: instruction 0 (div) at timing.jet:2: fixed timing: a fixed operand meets `i64.div_u`, which the wasm32 table has no row for")
}

#Test("A call's unpatched index is decoded as its index, not as unreachable padding") {
    // local.get 0, call (padded index), drop
    code: [U8]{0x20, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1a}
    assert_eq(web_timing_test_errors(IROp.BitXor, code, [Int]{3}, [Int]{}, false).len(), 0)
}

#Test("A shift's count check passes the wasm32 validator for a public count and not for a fixed one") {
    // local.get count, i64.const 64, i64.ge_u, if, unreachable, end (bytes
    // 0..<10), then local.get value, local.get count, i64.shr_u, local.set 2.
    public_count: [U8]{0x20, 0x01, 0x42, 0xc0, 0x00, 0x5a, 0x04, 0x40, 0x00, 0x0b, 0x20, 0x00, 0x20, 0x01, 0x88, 0x21, 0x02}
    assert_eq(web_timing_test_errors(IROp.Shr, public_count, [Int]{}, [Int]{0, 10}, false).len(), 0)
    // Unrecorded, the same check is refused.
    assert_eq(web_timing_test_errors(IROp.Shr, public_count, [Int]{}, [Int]{}, false).len(), 2)
    fixed_count: [U8]{0x20, 0x00, 0x42, 0xc0, 0x00, 0x5a, 0x04, 0x40, 0x00, 0x0b, 0x20, 0x01, 0x20, 0x00, 0x88, 0x21, 0x02}
    errors: web_timing_test_errors(IROp.Shr, fixed_count, [Int]{}, [Int]{0, 10}, true)
    assert_eq(errors.len(), 2)
    assert_eq(errors[0], "mix: instruction 0 (shr) at timing.jet:2: fixed timing: a fixed operand meets `if`, which the wasm32 table has no row for")
    assert_eq(errors[1], "mix: instruction 0 (shr) at timing.jet:2: fixed timing: a fixed operand meets `unreachable`, which the wasm32 table has no row for")
}
