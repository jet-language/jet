// The state one WebAssembly module's selection shares across its functions,
// and the per-function emitter with its byte-level instruction helpers.
//
// Every Jet value but Unit is one Wasm value: a Float an f64, a Float32 an
// f32, every other kind (Bool, Int, Word, Char, String, Pointer, the pointer
// to an Aggregate's bytes) an i64. Memory is one linear memory both modules
// import; addresses are i64 values wrapped to i32 at each access. A function
// with an Aggregate result takes the caller's storage as a hidden first
// parameter, as the x86-64 selector does, and returns nothing.

use {
    jet_ir.[IRFunction, IRModule, IRType, IRTypeKind]
    jet_wasm.[WASM_F32, WASM_F64, WASM_I32, WASM_I64, wasm_put_fixed, wasm_put_signed, wasm_put_unsigned, wasm_signed, wasm_unsigned]
}

// The globals every module imports from `env`, then the program module's own.
WEB_GLOBAL_SP: 0
WEB_GLOBAL_TLS: 1
WEB_GLOBAL_EDX: 2

// Bytes below the stack pointer a leaf may use for its stack words.
WEB_SCRATCH: 1024

// A callee that is not one of the module's IR functions: an import from
// `space` "rt", "c" or "host", or a helper the module defines (`space` "").
WebRef: struct {
    space: String
    name: String
    sig: String
}

WebState: struct {
    // The program's module: it keeps the stop protocol (WEB_GLOBAL_EDX).
    app: Bool
    stop_points: Bool
    // Per IRX64Tables data row: its address.
    data_at: [Int]
    // The table index of this module's first function slot.
    table_base: Int
    // Per IR function: its table slot, -1 while its address is never taken.
    slots: [Int]
    slot_rows: [Int]
    types: [String]
    type_rows: [String:Int]
    refs: [WebRef]
    ref_rows: [String:Int]
    // Runtime symbols this module defines -> IR function row.
    internal: [String:Int]
    // The program module: the runtime's exports -> signature.
    exports: [String:String]
    // C symbols the JavaScript host provides.
    hosts: [String:Bool]
    // Per IR function: its signature.
    sigs: [String]
    poll: Int
    trap: Int
    // The address of the runtime's armed word for loops' stop polls (JetIR
    // X64Select.jet IR_X64_CHECKS_ARMED_SYMBOL, the receipt's `data` row),
    // -1 when the runtime names none.
    armed: Int
    errors: [String]
}

// One function's code (locals, instructions, `end`) and its function-index
// fields to patch: pairs of byte offset and callee (an IR function row, or
// -1 - k for refs[k]). `lines`: pairs of byte offset and the source line the
// code from there was selected for (a program's selected bodies only; the
// source map, Build.jet web_source_map).
WebBody: struct {
    code: [U8]
    fixups: [Int]
    lines: [Int]{[Int]{}}
}

WebEmitter: struct {
    code: [U8]
    fixups: [Int]
    // Per slot: its local, -1 for a Unit slot.
    locals: [Int]
    // Every local's value type, the parameters first.
    local_types: [Int]
    params: Int
    // The function's result letter ("" for none).
    result: String
    // The hidden result pointer's local, -1 without one.
    sret: Int
    t0: Int
    t1: Int
    t2: Int
    t3: Int
    d0: Int
    s0: Int
    frame: Int
    // i32: a slow path published a stop for the trap point after it.
    flag: Int
    // i32 scratch.
    ok: Int
    frame_size: Int
    // Per instruction: its frame storage's offset from `frame`, -1 for none.
    areas: [Int]
    // The End of every open stop edge.
    pad_ends: [Int]
    // The instruction being selected is followed by a trap point its stop
    // paths take (WebState.stop_points, outside any stop edge).
    trap_next: Bool
    // The last instruction selected has a stop path that set `flag`.
    wired: Bool
    // Pairs of byte offset in `code` and source line (web_line).
    lines: [Int]{[Int]{}}
}

web_type_index: fn(st: &WebState, key: String) -> Int Never! {
    found: st.type_rows.get(key) ?? -1
    if found >= 0 -> return found
    id: st.types.len()
    st.types.push(key.copy())
    st.type_rows[key.copy()] = id
    id
}

web_table_index: fn(st: &WebState, row: Int) -> Int Never! {
    if st.slots[row] < 0 {
        st.slots[row] = st.slot_rows.len()
        st.slot_rows.push(row)
    }
    st.table_base + st.slots[row]
}

// The callee of ref (`space`, `name`, `sig`), added once.
web_ref: fn(st: &WebState, space: String, name: String, sig: String) -> Int Never! {
    key := "{space}\t{name}\t{sig}"
    found: st.ref_rows.get(key) ?? -1
    if found >= 0 -> return 0 - found - 1
    id: st.refs.len()
    st.refs.push(WebRef{space: space.copy(), name: name.copy(), sig: sig.copy()})
    st.ref_rows[key.move()] = id
    0 - id - 1
}

// The signatures of the C memory routines every module defines itself.
web_helper_sig: fn(symbol: String) -> String Never! {
    if symbol == "memcpy" || symbol == "memmove" || symbol == "memset" || symbol == "memcmp" -> return "lll:l"
    ""
}

// The callee and signature of runtime symbol `symbol` called with the
// arguments and result of `site`: the module's own function, a helper, the
// runtime's export (program module), else a C function the host provides.
web_symbol: fn(st: &WebState, symbol: String, site: String) -> (callee: Int, sig: String) Never! {
    row: st.internal.get(symbol) ?? -1
    if row >= 0 -> return (callee: row, sig: st.sigs[row].copy())
    helper: web_helper_sig(symbol)
    if helper != "" -> return (callee: web_ref(st, "", symbol, helper), sig: helper)
    if st.app {
        exported: st.exports.get(symbol) ?? ""
        if exported != "" -> return (callee: web_ref(st, "rt", symbol, exported), sig: exported)
    }
    if st.hosts.get(symbol) == None -> st.errors.push("the web host provides no `{symbol}`")
    (callee: web_ref(st, "c", symbol, site), sig: site.copy())
}

// ---------------------------------------------------------------------------
// Value types.

// The value type of a slot kind, 0 for Unit (no value).
web_kind_type: fn(kind: IRTypeKind) -> Int Never! {
    if kind == {
        .Unit -> 0
        .Float -> WASM_F64
        .Float32 -> WASM_F32
        .Bool | .Int | .Word | .Char | .String | .Pointer | .Aggregate -> WASM_I64
    }
}

web_slot_kind: fn(m: IRModule, f: IRFunction, slot: Int) -> IRTypeKind Never! {
    m.types[f.slot_type[slot]].kind
}

web_slot_type: fn(m: IRModule, f: IRFunction, slot: Int) -> Int Never! {
    web_kind_type(m.types[f.slot_type[slot]].kind)
}

web_returns_aggregate: fn(m: IRModule, f: IRFunction) -> Bool Never! {
    f.result >= 0 && m.types[f.result].kind == .Aggregate
}

// The result letter of `f`, "" for none (Unit, an Aggregate's hidden pointer).
web_result_letter: fn(m: IRModule, f: IRFunction) -> String Never! {
    if f.result < 0 -> return ""
    ty: web_kind_type(m.types[f.result].kind)
    if ty == 0 || m.types[f.result].kind == .Aggregate -> return ""
    web_type_letter(ty)
}

// The signature of IR function `f`.
web_function_sig: fn(m: IRModule, f: IRFunction) -> String Never! {
    params := if web_returns_aggregate(m, f) -> "l" else -> ""
    loop slot in 0..<f.param_count {
        ty: web_slot_type(m, f, slot)
        if ty != 0 -> params = "{params}{web_type_letter(ty)}"
    }
    "{params}:{web_result_letter(m, f)}"
}

// The width of a fixed-width integer's carrier bits (64 for a whole word).
web_bits: fn(ty: IRType) -> Int Never! {
    if ty.kind == .Word && ty.bits > 0 && ty.bits < 64 -> return ty.bits
    64
}

// Bytes a value of `ty` occupies in memory (X64Select ir_x64_value_width).
web_value_width: fn(ty: IRType) -> Int Never! {
    if ty.kind == {
        .Bool -> 1
        .Float32 -> 4
        .Word -> if ty.size == 1 || ty.size == 2 || ty.size == 4 -> ty.size else -> 8
        .Unit | .Int | .Float | .Char | .String | .Pointer | .Aggregate -> 8
    }
}

// Whether comparisons and shifts of `ty` are unsigned.
web_unsigned: fn(ty: IRType) -> Bool Never! {
    if ty.kind == {
        .Word -> !ty.signed
        .Bool | .Char | .Pointer | .String -> true
        .Unit | .Int | .Float | .Float32 | .Aggregate -> false
    }
}

// ---------------------------------------------------------------------------
// The emitter.

web_emitter: fn(m: IRModule, f: IRFunction) -> WebEmitter Never! {
    locals := [Int]{}
    types := [Int]{}
    sret := -1
    if web_returns_aggregate(m, f) {
        sret = 0
        types.push(WASM_I64)
    }
    loop _ in 0..<f.slot_type.len() -> locals.push(-1)
    loop slot in 0..<f.param_count {
        ty: web_slot_type(m, f, slot)
        if ty != 0 {
            locals[slot] = types.len()
            types.push(ty)
        }
    }
    params: types.len()
    loop slot in f.param_count..<f.slot_type.len() {
        ty: web_slot_type(m, f, slot)
        if ty != 0 {
            locals[slot] = types.len()
            types.push(ty)
        }
    }
    base: types.len()
    scratch: [Int]{WASM_I64, WASM_I64, WASM_I64, WASM_I64, WASM_F64, WASM_F32, WASM_I64, WASM_I32, WASM_I32}
    loop ty in scratch -> types.push(ty)
    areas := [Int]{}
    loop _ in 0..<f.op.len() -> areas.push(-1)
    WebEmitter{
        code: [U8]{}, fixups: [Int]{}, locals: locals, local_types: types, params: params, result: web_result_letter(m, f), sret: sret,
        t0: base, t1: base + 1, t2: base + 2, t3: base + 3, d0: base + 4, s0: base + 5, frame: base + 6, flag: base + 7, ok: base + 8,
        frame_size: 0, areas: areas, pad_ends: [Int]{}, trap_next: false, wired: false,
    }
}

// The function's code: its local declarations (runs of one type), its
// instructions and `end`, with the fixups moved past the declarations.
web_finish: fn(e: WebEmitter) -> WebBody Never! {
    runs := [Int]{}
    at := e.params
    loop at < e.local_types.len() {
        ty: e.local_types[at]
        count := 0
        loop at < e.local_types.len() && e.local_types[at] == ty {
            count += 1
            at += 1
        }
        runs.push(count)
        runs.push(ty)
    }
    code := [U8]{}
    wasm_put_unsigned(code, runs.len() /% 2)
    loop index in 0..<(runs.len() /% 2) {
        wasm_put_unsigned(code, runs[2 * index])
        code.push(U8{runs[2 * index + 1]})
    }
    shift: code.len()
    code.extend(e.code)
    code.push(0x0b)
    fixups := [Int]{}
    loop index in 0..<(e.fixups.len() /% 2) {
        fixups.push(e.fixups[2 * index] + shift)
        fixups.push(e.fixups[2 * index + 1])
    }
    lines := [Int]{}
    loop index in 0..<(e.lines.len() /% 2) {
        lines.push(e.lines[2 * index] + shift)
        lines.push(e.lines[2 * index + 1])
    }
    WebBody{code: code, fixups: fixups, lines: lines}
}

// The line row for the code from here on: a new row when the line changes,
// replacing a row at the same offset that no code followed (as JetIR
// X64Select.jet ir_x64_debug_line does for the native image's rows).
web_line: fn(e: &WebEmitter, line: Int) Never! {
    if line <= 0 -> return
    at: e.code.len()
    count: e.lines.len() /% 2
    if count > 0 {
        if e.lines[2 * count - 1] == line -> return
        if e.lines[2 * count - 2] == at {
            e.lines[2 * count - 1] = line
            return
        }
    }
    e.lines.push(at)
    e.lines.push(line)
}

web_op: fn(e: &WebEmitter, byte: Int) Never! {
    e.code.push(U8{byte})
}

web_get: fn(e: &WebEmitter, local: Int) Never! {
    web_op(e, 0x20)
    wasm_put_unsigned(e.code, local)
}

web_set: fn(e: &WebEmitter, local: Int) Never! {
    web_op(e, 0x21)
    wasm_put_unsigned(e.code, local)
}

web_tee: fn(e: &WebEmitter, local: Int) Never! {
    web_op(e, 0x22)
    wasm_put_unsigned(e.code, local)
}

web_global_get: fn(e: &WebEmitter, global: Int) Never! {
    web_op(e, 0x23)
    wasm_put_unsigned(e.code, global)
}

web_global_set: fn(e: &WebEmitter, global: Int) Never! {
    web_op(e, 0x24)
    wasm_put_unsigned(e.code, global)
}

web_i64: fn(e: &WebEmitter, value: Int) Never! {
    web_op(e, 0x42)
    wasm_put_signed(e.code, wasm_signed(wasm_unsigned(value, 64), 64))
}

web_i32: fn(e: &WebEmitter, value: Int) Never! {
    web_op(e, 0x41)
    wasm_put_signed(e.code, wasm_signed(wasm_unsigned(value, 32), 32))
}

// f64.const of the IEEE bits `bits`.
web_f64_bits: fn(e: &WebEmitter, bits: Int) Never! {
    web_op(e, 0x44)
    wasm_put_fixed(e.code, bits, 8)
}

// f32.const of the IEEE bits `bits`.
web_f32_bits: fn(e: &WebEmitter, bits: Int) Never! {
    web_op(e, 0x43)
    wasm_put_fixed(e.code, bits, 4)
}

// A load or store: opcode, alignment hint 0 (any address), byte offset.
web_mem: fn(e: &WebEmitter, op: Int, offset: Int) Never! {
    web_op(e, op)
    wasm_put_unsigned(e.code, 0)
    wasm_put_unsigned(e.code, offset)
}

// A 0xfc-prefixed instruction.
web_misc: fn(e: &WebEmitter, sub: Int) Never! {
    web_op(e, 0xfc)
    wasm_put_unsigned(e.code, sub)
}

// memory.copy of (destination, source, length), all i32, on the stack.
web_memory_copy: fn(e: &WebEmitter) Never! {
    web_misc(e, 10)
    web_op(e, 0)
    web_op(e, 0)
}

// memory.fill of (destination, byte, length), all i32, on the stack.
web_memory_fill: fn(e: &WebEmitter) Never! {
    web_misc(e, 11)
    web_op(e, 0)
}

web_wrap: fn(e: &WebEmitter) Never! {
    web_op(e, 0xa7)
}

// `if` with no result.
web_if: fn(e: &WebEmitter) Never! {
    web_op(e, 0x04)
    web_op(e, WEB_VOID)
}

// `if` producing one value of type `ty`.
web_if_value: fn(e: &WebEmitter, ty: Int) Never! {
    web_op(e, 0x04)
    web_op(e, ty)
}

web_else: fn(e: &WebEmitter) Never! {
    web_op(e, 0x05)
}

web_end: fn(e: &WebEmitter) Never! {
    web_op(e, 0x0b)
}

// A call of `callee` (an IR function row or a ref), its index patched later.
web_call: fn(e: &WebEmitter, callee: Int) Never! {
    web_op(e, 0x10)
    web_call_field(e, callee)
}

// `return_call` of IR function `callee`.
web_return_call: fn(e: &WebEmitter, callee: Int) Never! {
    web_op(e, 0x12)
    web_call_field(e, callee)
}

web_call_field: fn(e: &WebEmitter, callee: Int) Never! {
    e.fixups.push(e.code.len())
    e.fixups.push(callee)
    loop _ in 0..<WEB_PADDED -> web_op(e, 0)
}

// call_indirect through table 0 with the code (a table index, i64) on top.
web_call_indirect: fn(e: &WebEmitter, st: &WebState, sig: String) Never! {
    web_wrap(e)
    web_op(e, 0x11)
    wasm_put_unsigned(e.code, web_type_index(st, sig))
    web_op(e, 0)
}

// The zero value of type `ty`.
web_zero: fn(e: &WebEmitter, ty: Int) Never! {
    if ty == WASM_F64 -> return web_f64_bits(e, 0)
    if ty == WASM_F32 -> return web_f32_bits(e, 0)
    if ty == WASM_I32 -> return web_i32(e, 0)
    web_i64(e, 0)
}

// Pushes slot `slot`'s value (a Unit slot has none).
web_load: fn(e: &WebEmitter, slot: Int) Never! {
    local: e.locals[slot]
    if local >= 0 -> web_get(e, local)
}

// Pops the value on top into slot `slot` (a Unit slot drops it).
web_store: fn(e: &WebEmitter, slot: Int) Never! {
    local: e.locals[slot]
    if local >= 0 -> return web_set(e, local)
    web_op(e, 0x1a)
}

// i32: whether slot `slot` (i64) is nonzero.
web_truth: fn(e: &WebEmitter, slot: Int) Never! {
    web_load(e, slot)
    web_op(e, 0x50)
    web_op(e, 0x45)
}

// The i64 frame address `offset` bytes into the frame.
web_frame_address: fn(e: &WebEmitter, offset: Int) Never! {
    frame: e.frame
    web_get(e, frame)
    if offset != 0 {
        web_i64(e, offset)
        web_op(e, 0x7c)
    }
}

// Pushes the i32 address of local `local` (i64) + `offset`; returns the
// memarg offset still to add (an offset outside u32 is added first).
web_address: fn(e: &WebEmitter, local: Int, offset: Int) -> Int Never! {
    web_get(e, local)
    if offset >= 0 && offset < (1 << 32) {
        web_wrap(e)
        return offset
    }
    web_i64(e, offset)
    web_op(e, 0x7c)
    web_wrap(e)
    0
}

// Sign- or zero-extends the low `bits` of the i64 on top to the whole word.
web_narrow: fn(e: &WebEmitter, signed: Bool, bits: Int) Never! {
    if bits <= 0 || bits >= 64 -> return
    if signed {
        if bits == 8 -> return web_op(e, 0xc2)
        if bits == 16 -> return web_op(e, 0xc3)
        if bits == 32 -> return web_op(e, 0xc4)
        web_i64(e, 64 - bits)
        web_op(e, 0x86)
        web_i64(e, 64 - bits)
        web_op(e, 0x87)
        return
    }
    web_i64(e, (1 << bits) - 1)
    web_op(e, 0x83)
}

// A call result in the carrier of `ty` (X64Select ir_x64_normalize): a
// Bool's low byte, a narrow integer's low bits.
web_normalize: fn(e: &WebEmitter, ty: IRType) Never! {
    if ty.kind == .Bool {
        web_i64(e, 255)
        web_op(e, 0x83)
        return
    }
    if ty.kind == .Word -> web_narrow(e, ty.signed, web_bits(ty))
}

// The i32 test that the i64 in `local` is an inline Int (bits 63 and 62 agree).
web_inline_test: fn(e: &WebEmitter, local: Int) Never! {
    web_get(e, local)
    web_get(e, local)
    web_i64(e, 1)
    web_op(e, 0x86)
    web_op(e, 0x85)
    web_i64(e, 0)
    web_op(e, 0x59)
}
