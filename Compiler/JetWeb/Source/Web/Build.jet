// The two partitions of a web build (Module.jet). The runtime partition is
// selected once, when the toolchain packages the runtime library; its
// receipt (`layout`, `export`, `data` and `import` rows) is what the program
// partition is placed and linked against at `jet build --target web`.

use {
    jet_backend.[X64DataExport]
    jet_foundation.[CHECKED_ALLOC_RUNTIME_EXPORTS]
    jet_ir.[IRLibraryExport, IRModule, IR_X64_CHECKS_ARMED_SYMBOL]
}

WebRuntime: struct {
    bytes: [U8]
    // The receipt: `layout\t<data end>\t<slots>`, then an `export\t<symbol>\t<sig>`
    // row per export, a `data\t<symbol>\t<address>` row per data export and an
    // `import\t<space>\t<name>\t<sig>` row per import.
    receipt: String
    errors: [String]
}

// The runtime partition of the runtime library's lowered module `m` (JetIR
// ir_x64_compile_module's program), its exports and lifecycle hooks, and its
// data exports `data` (words a program's code reads in place, the native
// object's data symbols). Every web program shares it, and a web build has
// no checked heap, so it leaves out the checked heap's exports
// (CHECKED_ALLOC_RUNTIME_EXPORTS), as the prelinked native image does
// (JetBackend Image/RuntimePack.jet): their hook would turn checked mode on
// in every web program.
web_runtime_partition: fn(m: IRModule, exports: [IRLibraryExport], data: [X64DataExport]) -> WebRuntime Never! {
    rows := [String:Int]{}
    hooks := [WebHook]{}
    loop row in exports {
        if CHECKED_ALLOC_RUNTIME_EXPORTS.contains(row.symbol) -> next
        rows[row.symbol.copy()] = row.function
        if row.init_priority >= 0 -> hooks.push(WebHook{row: row.function, priority: row.init_priority, fini: false})
        if row.fini_priority >= 0 -> hooks.push(WebHook{row: row.function, priority: row.fini_priority, fini: true})
    }
    built := web_module(m, false, WebLayout{data_base: WEB_DATA_BASE, table_base: 0}, [String:String]{}, -1, web_host_functions(), rows, hooks)
    lines := [String]{"layout\t{built.data_end}\t{built.slots}"}
    loop row in built.exports -> lines.push("export\t{row}")
    loop row in data {
        if row.data >= 0 && row.data < built.data_at.len() -> lines.push("data\t{row.symbol}\t{built.data_at[row.data]}")
    }
    loop row in built.imports -> lines.push("import\t{row}")
    lines.push("")
    WebRuntime{bytes: built.bytes.move(), receipt: lines.join("\n"), errors: built.errors.move()}
}

WebProgram: struct {
    bytes: [U8]
    manifest: String
    errors: [String]
}

// The program partition of built module `program` (its entry `program.entry`)
// against the runtime partition's receipt `receipt`, and the manifest of the
// two.
web_program: fn(program: &&IRModule, receipt: String) -> WebProgram Never! {
    runtime_end := -1
    runtime_slots := -1
    armed := -1
    runtime := [String:String]{}
    loop line in receipt.split("\n").to_list() {
        fields: line.split("\t").to_list()
        if fields.len() == 3 && fields[0] == "layout" {
            runtime_end = Int.parse(fields[1]) ?? -1
            runtime_slots = Int.parse(fields[2]) ?? -1
        } else if fields.len() == 3 && fields[0] == "export" {
            runtime[fields[1].copy()] = fields[2].copy()
        } else if fields.len() == 3 && fields[0] == "data" && fields[1] == IR_X64_CHECKS_ARMED_SYMBOL {
            armed = Int.parse(fields[2]) ?? -1
        }
    }
    if runtime_end < 0 || runtime_slots < 0 {
        return WebProgram{bytes: [U8]{}, manifest: "", errors: [String]{"the runtime partition's receipt has no layout row"}}
    }
    m := program.move()
    web_lower(m)
    base: web_align_up(runtime_end, 16)
    built := web_module(m, true, WebLayout{data_base: base, table_base: runtime_slots}, runtime, armed, web_host_functions(), [String:Int]{}, [WebHook]{})
    manifest: web_manifest(runtime_end, runtime_slots, base, built.data_end, built.slots)
    WebProgram{bytes: built.bytes.move(), manifest: manifest, errors: built.errors.move()}
}

// The generated host files of a web build: `app.js`, `jet_dom_runtime.js`,
// `index.html`.
web_app_js: fn() -> String Never! {
    WEB_APP_JS
}

web_dom_runtime_js: fn() -> String Never! {
    WEB_DOM_RUNTIME_JS
}

web_index_html: fn() -> String Never! {
    WEB_INDEX_HTML
}
