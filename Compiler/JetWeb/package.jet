// The web target of `jet build --target web`: WebAssembly modules selected
// from Jet IR (the runtime's when the toolchain is packaged, the program's at
// build), the manifest that links them, and the JavaScript host that loads
// them.
name: "jet_web"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../JetFoundation,
    jet_backend: ../JetBackend,
    jet_ir: ../JetIR,
    jet_wasm: ../JetWasm,
}
