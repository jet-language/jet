// TOOLS-S9: two independent real policy-filter tests. Remaining functions are
// unregistered original checked acceptance fixtures, never fake checked rows.
// S4/C4/S8/S10–S12/S20/CP-NAMES/CP-AST/CP-POLICY and #4397 gate composition.
use jet_foundation.[PolicyDeclaration, PolicyScope, Span]

semindex_items_test_policy: fn(scope: PolicyScope, target: Span?) -> PolicyDeclaration Never! {
    PolicyDeclaration{key: .Unsafe, value: .Forbid, scope: scope, span: Span{start: 0, end: 1}, target: target, source: "fixture"}
}
#Test("semindex_function_hover_policy_includes_ambient_scopes") {
    function: Span{start: 10, end: 40}
    scopes: [PolicyScope]{PolicyScope.Organization, PolicyScope.Package, PolicyScope.Module}
    loop scope in scopes {
        assert(semindex_policy_applies_to_function(semindex_items_test_policy(scope, None), function))
        assert(semindex_policy_applies_to_function(semindex_items_test_policy(scope, Val(Span{start: 60, end: 80})), function))
    }
    assert(!semindex_policy_applies_to_function(semindex_items_test_policy(.Block, Val(function)), function))
    assert(!semindex_policy_applies_to_function(semindex_items_test_policy(.Block, None), function))
}
#Test("semindex_function_hover_policy_requires_exact_function_target") {
    function: Span{start: 10, end: 40}
    assert(semindex_policy_applies_to_function(semindex_items_test_policy(.Function, Val(function)), function))
    assert(!semindex_policy_applies_to_function(semindex_items_test_policy(.Function, None), function))
    assert(!semindex_policy_applies_to_function(semindex_items_test_policy(.Function, Val(Span{start: 10, end: 41})), function))
    assert(!semindex_policy_applies_to_function(semindex_items_test_policy(.Function, Val(Span{start: 9, end: 40})), function))
    assert(!semindex_policy_applies_to_function(semindex_items_test_policy(.Function, Val(Span{start: 0, end: 50})), function))
}

// Byte-exact original method/dossier source.
semindex_s9_scattered_members_source: fn() -> String Never! {
    "\nDrawThing: trait {{\n    render: fn(self) -> String ->\n}}\n\nWidget: struct {{\n    title: String\n\n    label: fn(self) -> String {{\n        return ~self.title\n    }}\n}}\n\nimpl Widget {{\n    size: fn(self) -> Int {{\n        return 1\n    }}\n}}\n\nimpl Widget.DrawThing {{\n    render: fn(self) -> String {{\n        return self.label()\n    }}\n}}\n\nrun: fn() {{\n    w: Widget.{{title: \"ok\"}}\n    print(w.render())\n}}\n"
}
semindex_s9_scattered_members_assertions: fn(index: SemIndex, dossier_json: String) {
    semindex_test_dossier_stitches_scattered_members(index)
    assert(dossier_json.contains("\"target\":\"Widget\""))
    assert(dossier_json.contains("\"trait_impl\""))
    assert(dossier_json.contains("\"inherent_impl\""))
}
// The Rust original remains canonical in S6; reuse its exact fixture and
// assertions, including defaults/public labels/zones/rest, no second oracle.
semindex_s9_method_contract_source: fn() -> String Never! { semindex_s6_method_contract_source() }
semindex_s9_method_contract_assertions: fn(index: SemIndex) Never! { semindex_s6_method_contract_assertions(index) }

// Actual state owner and checked marker anchor.
semindex_s9_state_owner_source: fn() -> String Never! {
    "\nDoor: struct {{\n    state {{ Closed, Open }}\n}}\nimpl Door {{\n    #Transition(_, Door.State.Closed) new: fn() -[]> Door {{ return Door{{}} }}\n    #Transition(Door.State.Closed, Door.State.Open) open: fn(self: &&Door) -[]> Door {{ return self }}\n}}\nrun: fn() {{}}\n"
}
semindex_s9_state_owner_assertions: fn(index: SemIndex, source: String, json: String) Never! {
    definition_found := false
    reference_found := false
    loop definition in index.definitions() {
        if !definition.qualified_name.ends_with("Door.State.Closed") -> next
        if definition.kind == {
            .EnumVariant(parent) -> assert_eq(parent, "Door.State")
            else -> { panic("owning struct state definition kind") }
        }
        definition_found = true
        loop window in index.references_to("Closed") {
            loop reference in window {
                if reference.target == .Val(target) {
                    if target.def_span != definition.def_span -> next
                    assert_eq(target.def_span, definition.def_span)
                    selected := source.bytes()[reference.span.start..<reference.span.end] // #4303
                    assert_eq(String.from_bytes(selected) ?? panic("valid source span"), "Closed")
                    reference_found = true
                    break
                }
            }
            if reference_found -> break
        }
        assert(json.contains("\"name\":\"{definition.qualified_name}\""))
        break
    }
    assert(definition_found && reference_found)
}

// Caller supplies real checked two-file symbols.
semindex_s9_import_library_source: fn() -> String Never! { "score: fn(name: String) -> Int {{ return 1 }}\n" }
semindex_s9_import_main_source: fn() -> String Never! {
    "use api: \"./library\"\nuse imported_score: api.score\nrun: fn() {{ print(imported_score(\"Ada\")) }}\n"
}
semindex_s9_import_assertions: fn(symbols: SemanticSymbolIndex) Never! {
    assert_eq(symbols.lookup("api").len(), 1)
    imported: symbols.lookup("imported_score")
    assert_eq(imported.len(), 1)
    assert(imported[0].identity.starts_with("import:"))
    assert(imported[0].signature.contains("score(name: String) Int"))
}

