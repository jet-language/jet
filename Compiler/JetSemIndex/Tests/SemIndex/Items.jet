// Original spelled bypass fixture and assertions.
semindex_s9_bypasses_source: fn() -> String Never! {
    "\nInvoice: struct {{\n    #Allow(jet.FloatMoney)\n    price: Float,\n}}\n\n#Unsafe(\"caller must ensure the pointer is valid\") risky_fn: fn() {{\n    print(\"danger\")\n}}\n\nrun: fn() {{\n    #Unsafe(\"index checked against len\") {{\n        print(\"audited\")\n    }}\n    #Unsafe(\"risky_fn's contract is upheld here\") {{\n        risky_fn()\n    }}\n    fetch_it().drop(\"telemetry only\")\n}}\n\nfetch_it: fn() -> Int {{\n    return 1\n}}\n"
}
semindex_s9_bypasses_assertions: fn(index: SemIndex, dossier_json: String, dossier_text: String) {
    semindex_test_dossier_bypass_facts(index)
    assert(dossier_json.contains("\"bypass_facts\""))
    assert(dossier_json.contains("\"lint_allow\""))
    assert(dossier_text.contains("bypass facts"))
    assert(dossier_text.contains("jet.FloatMoney"))
}
