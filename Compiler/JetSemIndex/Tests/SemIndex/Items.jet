// tests/semindex.rs486–534: actual state owner and checked marker anchor.
pub fn semindex_s9_state_owner_source() -> String Never! {
    "\nstruct Door {\n    state { Closed, Open }\n}\nimpl Door {\n    #Transition(_, Door.State.Closed) fn new() -[]> Door { return Door{} }\n    #Transition(Door.State.Closed, Door.State.Open) fn open(self: ^Door) -[]> Door { return self }\n}\nfn run() {}\n"
}
pub fn semindex_s9_state_owner_assertions(index: SemIndex, source: String, json: String) Never! {
    definition_found := false
    reference_found := false
    loop definition in index.definitions() {
        if !definition.qualified_name.ends_with("Door.State.Closed") -> next
        if definition.kind == { .EnumVariant(parent) -> assert_eq(parent, "Door.State"), else -> panic("owning struct state definition kind") }
        definition_found = true
        loop window in index.references_to("Closed") {
            loop reference in window {
                if reference.target == .Val(target) {
                    if target.def_span != definition.def_span -> next
                    assert_eq(target.def_span, definition.def_span)
                    selected := source.bytes()[reference.span.start..<reference.span.end] // #4303
                    assert_eq(String.from_bytes(selected) ?? panic("valid source span"), "Closed")
                    reference_found = true
                    break
                }
            }
            if reference_found -> break
        }
        assert(json.contains("\"name\":\"{definition.qualified_name}\""))
        break
    }
    assert(definition_found && reference_found)
}

// tests/semindex.rs774–795: caller supplies real checked two-file symbols.
pub fn semindex_s9_import_library_source() -> String Never! { "pub fn score(name: String) -> Int { return 1 }\n" }
pub fn semindex_s9_import_main_source() -> String Never! {
    "use \"./library\" as api\nuse api.[score as imported_score]\nfn run() { print(imported_score(\"Ada\")) }\n"
}
pub fn semindex_s9_import_assertions(symbols: SemanticSymbolIndex) Never! {
    assert_eq(symbols.lookup("api").len(), 1)
    imported :: symbols.lookup("imported_score")
    assert_eq(imported.len(), 1)
    assert(imported[0].identity.starts_with("import:"))
    assert(imported[0].signature.contains("score(name: String) Int"))
}

