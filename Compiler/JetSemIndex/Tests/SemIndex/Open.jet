// Checked open-variant fixtures. CP-DRIVER-ENTRY-CHECK must capture real
// authorized sources/overlays once and call the public opening seam before
// registering these assertions. They are not fake preconstructed snapshots.
fn semindex_open_test_symbol_free_input_fixture(root: String) -[FS]> {
    semindex_open_test_write(root, "main.jet", "use \"./empty_a\" as a\nuse \"./empty_b\" as b\nfn run() {{}}\n")
    semindex_open_test_write(root, "empty_a.jet", "// intentionally no definitions\n")
    semindex_open_test_write(root, "empty_b.jet", "// another read-only symbol-free input\n")
}
fn semindex_open_test_symbol_free_inputs(inputs: [String], entry: String, a: String, b: String) Never! {
    // Rust Loader4595 schedules the current module before walking authored
    // imports4614. Preserve both symbol-free imports in that exact order.
    assert_eq(inputs, [String]{entry, a, b})
}
fn semindex_open_test_diagnostic_source() -> String Never! {
    "fn run() {{ missing_name() }}\n"
}
fn semindex_open_test_diagnostic_index(index: SemIndex, diagnostics: [Diagnostic]) Never! {
    assert(index.lookup("run") != None)
    assert(semindex_open_has_errors(diagnostics))
}

// Structural open's candidate directory is DIFFERENT from the output
// directory, and the output need not exist. Only Driver may apply import_root
// to the real authorized snapshot. Retain this fixture until the checked
// budget adapter lands; using the output directory is not a valid control.
fn semindex_open_test_structural_fixture(root: String) -[FS]> {
    candidate :: semindex_open_files.join(root, "candidate")
    semindex_open_files.create_dir_all(candidate) ?? panic("create candidate directory")
    semindex_open_test_write(candidate, "library.jet", "pub fn value() -> Int {{ return 7 }}\n")
}
fn semindex_open_test_structural_candidate_source() -> String Never! {
    "use \"./library\" as api\nfn run() {{ value :: api.value() }}\n"
}
fn semindex_open_test_structural_import(index: SemIndex, library_path: String) Never! {
    found := false
    loop reference in index.references() {
        if reference.name != "value" -> next
        if reference.target == .Val(target) {
            if target.module_path == library_path && target.kind == "function" -> found = true
        }
    }
    assert(found, "structural candidate import must target the adjacent real library")
}

// tests/semindex.rs923–1032,1036–1104,1164–1189: the existing exact before/after
// checked source builders/oracles stay with CallableFacts/Signatures/Build.
// The open harness invokes each using actual indices/revisions; no local
// reconstruction of ViewProvenance, derivation identity or signature digests.
fn semindex_open_test_checked_revision_oracles(union: SemIndex, right: SemIndex, distinct_pair: SemIndex, changed_pair: SemIndex, field_before: SemIndex, field_after: SemIndex, callable_before: SemIndex, callable_after: SemIndex, ancestry_before: SemIndex, ancestry_after: SemIndex) {
    union_pick :: (union.lookup("pick") ?? panic("union pick"))[0]
    right_pick :: (right.lookup("pick") ?? panic("right pick"))[0]
    union_fact :: semindex_test_checked_identity(union._definition_facts, union_pick.identity)
    right_fact :: semindex_test_checked_identity(right._definition_facts, right_pick.identity)
    semindex_test_returned_view_provenance_is_structured_and_changes_signature_id(union_pick, right_pick, union_fact, right_fact, union.to_json())
    pair :: (distinct_pair.lookup("pair") ?? panic("pair"))[0]
    changed :: (changed_pair.lookup("pair") ?? panic("changed pair"))[0]
    distinct_fact :: semindex_test_checked_identity(distinct_pair._definition_facts, pair.identity)
    changed_fact :: semindex_test_checked_identity(changed_pair._definition_facts, changed.identity)
    semindex_test_aggregate_view_provenance_preserves_slots_and_changes_signature_id(pair, distinct_fact, changed_fact, distinct_pair.to_json())
    semindex_test_structural_audit_reports_signature_change(field_before, field_after)
    semindex_test_structural_audit_tracks_callable_signature_changes(callable_before, callable_after)
    semindex_build_test_definition_ancestry_identity_ignores_signature_and_body_shape(ancestry_before, ancestry_after)
}

// tests/semindex.rs369–564 and1378–1552: original arithmetic/state/output and
// dossier/contract/bypass assertions, with the real DB where hover is required.
fn semindex_open_test_checked_dossier_oracles(widget: SemIndex, contract: SemIndex, bypasses: SemIndex) {
    widget_dossier :: widget.dossier("Widget")
    semindex_s9_scattered_members_assertions(widget, widget_dossier.to_json())
    semindex_s6_method_contract_assertions(contract)
    invoice :: bypasses.dossier("Invoice")
    semindex_s9_bypasses_assertions(bypasses, invoice.to_json(), invoice.render_text())
}
fn semindex_open_test_checked_state_output_oracles(arithmetic: SymbolDB, arithmetic_path: String, terminal: SemIndex, terminal_hover: SymbolDB, output: SemIndex) {
    semindex_build_test_semindex_projects_arithmetic_policy_and_exact_scope(arithmetic, arithmetic_path, arithmetic.index.to_json())
    door :: terminal.dossier("Door")
    semindex_build_test_semindex_projects_terminal_and_reachability_graph(terminal, terminal.to_json(), door.render_text(), door.to_json())
    semindex_build_test_semindex_hover_projects_terminal_and_reachability_facts(terminal_hover)
    semindex_build_test_semindex_reconstructs_checked_output_callable(output, output.to_json())
}
