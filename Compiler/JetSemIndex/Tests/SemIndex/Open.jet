// The Rust original open/package/workspace oracles. Checked fixture assertions
// already owned by CallableFacts/Facts/Build/Codec are reused below, not
// replaced with hand-built checked records. These tests are source-only; no
// registration into the package list or proof is implied by this file.
use {
    jet_foundation.[Diagnostic, DIAGNOSTIC_ERROR, sha256_hex]
    jet_pkg_model.[WorkspaceDeclarationCache]
    semindex_open_files: core.files
    semindex_open_process: core.process
    semindex_open_sys: core.sys
}

semindex_open_test_root: fn(label: String) -[FS, Env]> String Never! {
    root: semindex_open_files.join(semindex_open_sys.temp_dir(), "jet-semindex-{label}-{semindex_open_process.current_pid()}")
    semindex_open_files.remove_all(root).drop("a stale test fixture may be absent")
    semindex_open_files.create_dir_all(root) ?? panic("create semantic-index fixture")
    root
}
semindex_open_test_write: fn(root: String, path: String, source: String) -[FS]> {
    semindex_open_files.write(semindex_open_files.join(root, path), source) ?? panic("write semantic-index fixture")
}
semindex_open_test_lock_dir: fn(root: String) -[FS]> {
    semindex_open_files.create_dir_all(semindex_open_files.join(root, ".jet")) ?? panic("create lock directory")
}
semindex_open_test_clean: fn(root: String) -[FS]> {
    semindex_open_files.remove_all(root) ?? panic("remove semantic-index fixture")
}

#Test("schema_version_constant") {
    assert_eq(SEMINDEX_SCHEMA_VERSION, 20)
}

#Test("semindex_load_error_preserves_diagnostics_and_exact_display") {
    assert_eq(SemIndexError.Load{diagnostics: [Diagnostic]{}}.message(), "0 load/check diagnostic(s)")
    first: semindex_package_facts_diagnostic("./é/main.jet", "broken")
    second: semindex_package_facts_diagnostic("other.jet", "ambiguous")
    failure: SemIndexError.Load{diagnostics: [Diagnostic]{first, second}}
    assert_eq(failure.message(), "2 load/check diagnostic(s)")
    if failure == .Load(diagnostics) -> assert_eq(diagnostics, ([Diagnostic]{first, second}))
    assert_eq(semindex_package_facts_error_text([Diagnostic]{}), "")
    expected: "E1215: package facts for `./é/main.jet` have a shape error — one typed Package fact graph must own this projection; broken; E1215: package facts for `other.jet` have a shape error — one typed Package fact graph must own this projection; ambiguous"
    assert_eq(semindex_package_facts_error_text([Diagnostic]{first, second}), expected)
    assert_eq(first.severity, DIAGNOSTIC_ERROR)
    assert_eq(first.code, "E1215")
    assert_eq(first.span, None)
    assert_eq(first.fix, "fix package.jet, the inline Package carrier, or its declared Config files before tooling uses package facts")
}

#Test("malformed_package_facts_are_not_dropped_from_projection") {
    cache := WorkspaceDeclarationCache.new()
    root: semindex_open_test_root("ambiguous-package")
    semindex_open_test_write(root, "package.jet", "name: \"canonical\"\nversion: \"0.1.0\"\n")
    semindex_open_test_write(root, "pkg.jet", "name: \"legacy\"\nversion: \"0.1.0\"\n")
    semindex_open_test_write(root, "run.jet", "run: fn() {{}}\n")
    entry: semindex_open_files.join(root, "run.jet")
    if semindex_package_facts_for_entry(cache, entry) == {
        .Ok(_) -> { panic("ambiguous package roots must remain an error") }
        .Err(error) -> {
            // Main's oracle ruling: the migration-era substring was stale;
            // the registered Authority diagnostic text remains canonical.
            assert_eq(error.message, "E1215: the package has two manifest roots — `package.jet` and `pkg.jet` both exist; choosing one would make package identity ambiguous")
            assert_eq(semindex_package_facts_diagnostic(entry, error.message).code, "E1215")
        }
    }
    semindex_open_test_clean(root)
}

#Test("stale_workspace_lock_returns_e1202_instead_of_empty_policy") {
    cache := WorkspaceDeclarationCache.new()
    root: semindex_open_test_root("stale-workspace")
    semindex_open_test_lock_dir(root)
    semindex_open_test_write(root, "workspace.jet", "workspace: module {{ members: [] }}\n")
    semindex_open_test_write(root, ".jet/lock", "version = 1\nworkspace_source_digest = \"sha256-stale\"\n")
    semindex_open_test_write(root, "run.jet", "run: fn() {{}}\n")
    if semindex_workspace_overlay_policy_for_entry(cache, semindex_open_files.join(root, "run.jet")) == {
        .Ok(_) -> { panic("stale workspace authority must remain visible") }
        .Err(error) -> assert_eq(error.diagnostic.code, "E1202")
    }
    semindex_open_test_clean(root)
}

#Test("outer_stale_workspace_lock_does_not_cross_inner_workspace_boundary") {
    cache := WorkspaceDeclarationCache.new()
    root: semindex_open_test_root("nested-stale-workspace")
    child: semindex_open_files.join(root, "child")
    semindex_open_files.create_dir_all(child) ?? panic("create child")
    semindex_open_test_lock_dir(root)
    semindex_open_test_write(root, "workspace.jet", "workspace: module {{ members: [] }}\n")
    semindex_open_test_write(root, ".jet/lock", "version = 1\nworkspace_source_digest = \"sha256-stale\"\n")
    semindex_open_test_write(child, "inner-authority.jet", "workspace: module {{ members: [] }}\n")
    semindex_open_test_write(child, "run.jet", "run: fn() {{}}\n")
    policy: semindex_workspace_overlay_policy_for_entry(cache, semindex_open_files.join(child, "run.jet")) ?? panic("nearest workspace boundary must stop lookup")
    assert(policy == None)
    semindex_open_test_clean(root)
}

#Test("ancestor_lock_scan_uses_an_arbitrary_workspace_source") {
    cache := WorkspaceDeclarationCache.new()
    root: semindex_open_test_root("ancestor-workspace")
    child: semindex_open_files.join(root, "packages/app")
    semindex_open_files.create_dir_all(child) ?? panic("create child")
    semindex_open_test_lock_dir(root)
    source: "workspace: module {{ members: [] }}\n"
    semindex_open_test_write(root, "authority.jet", source)
    digest: sha256_hex(source)
    semindex_open_test_write(root, ".jet/lock", "version = 1\nworkspace_source_digest = \"{digest}\"\nworkspace_policy_allow_unfree = [\"discord\"]\n")
    semindex_open_test_write(child, "run.jet", "run: fn() {{}}\n")
    policy: (semindex_workspace_overlay_policy_for_entry(cache, semindex_open_files.join(child, "run.jet")) ?? panic("ancestor workspace lock should load")) ?? panic("persisted policy should be attached")
    assert_eq(policy.allow_unfree, [String]{"discord"})
    semindex_open_test_clean(root)
}

#Test("malformed_workspace_boundary_is_not_hidden_by_an_outer_lock") {
    cache := WorkspaceDeclarationCache.new()
    root: semindex_open_test_root("ambiguous-workspace-boundary")
    child: semindex_open_files.join(root, "packages/app")
    semindex_open_files.create_dir_all(child) ?? panic("create child")
    semindex_open_test_lock_dir(root)
    source: "workspace: module {{ members: [] }}\n"
    semindex_open_test_write(root, "authority.jet", source)
    digest: sha256_hex(source)
    semindex_open_test_write(root, ".jet/lock", "version = 1\nworkspace_source_digest = \"{digest}\"\n")
    semindex_open_test_write(child, "a.jet", source)
    semindex_open_test_write(child, "b.jet", source)
    semindex_open_test_write(child, "run.jet", "run: fn() {{}}\n")
    if semindex_workspace_overlay_policy_for_entry(cache, semindex_open_files.join(child, "run.jet")) == {
        .Ok(_) -> { panic("ambiguous boundary must remain visible") }
        .Err(error) -> assert_eq(error.diagnostic.code, "E1239")
    }
    semindex_open_test_clean(root)
}

#Test("missing_empty_and_nonworkspace_inner_locks_are_boundaries") {
    cache := WorkspaceDeclarationCache.new()
    root: semindex_open_test_root("empty-inner-boundary")
    child: semindex_open_files.join(root, "child")
    semindex_open_files.create_dir_all(child) ?? panic("create child")
    semindex_open_test_lock_dir(root)
    semindex_open_test_lock_dir(child)
    source: "workspace: module {{ members: [] }}\n"
    semindex_open_test_write(root, "workspace.jet", source)
    semindex_open_test_write(root, ".jet/lock", "version = 1\nworkspace_source_digest = \"sha256-stale\"\n")
    semindex_open_test_write(child, "workspace.jet", source)
    semindex_open_test_write(child, "run.jet", "run: fn() {{}}\n")
    entry: semindex_open_files.join(child, "run.jet")
    assert((semindex_workspace_overlay_policy_for_entry(cache, entry) ?? panic("missing lock is a boundary")) == None)
    semindex_open_test_write(child, ".jet/lock", "version = 1\n")
    assert((semindex_workspace_overlay_policy_for_entry(cache, entry) ?? panic("nonworkspace lock is a boundary")) == None)
    digest: sha256_hex(source)
    semindex_open_test_write(child, ".jet/lock", "version = 1\nworkspace_source_digest = \"{digest}\"\n")
    assert((semindex_workspace_overlay_policy_for_entry(cache, entry) ?? panic("empty policy is a boundary")) == None)
    // A recognized workspace lock that cannot decode is an error, not absence.
    semindex_open_test_write(child, ".jet/lock", "version = nope\nworkspace_source_digest = \"{digest}\"\n")
    if semindex_workspace_overlay_policy_for_entry(cache, entry) == {
        .Ok(_) -> { panic("malformed inner workspace lock cannot fall outward") }
        .Err(error) -> assert_eq(error.diagnostic.code, "E1202")
    }
    semindex_open_test_clean(root)
}

// These assertions are deliberately unregistered until the Driver-owned host
// snapshot fixture harness can call the real opens below. They consume real
// checked indices from Examples/features, never synthetic graph rows.
// Filesystem capture belongs to Driver, not to a Tools test parser.
semindex_open_test_effects_index: fn(index: SemIndex) Never! {
    assert_eq(index.schema_version(), SEMINDEX_SCHEMA_VERSION)
    assert(index.lookup("run") != None)
    assert(index.lookup("report") != None)
    assert(index.call_edges().len() > 0, "expected call graph edges in effects example")
    assert(index.effect_of("report") != None, "expected effect facts for report()")
}
semindex_open_test_hello_index: fn(index: SemIndex) Never! {
    assert(index.references_to("print").len() > 0)
    json: index.to_json()
    assert(json.contains("\"schema_version\":{SEMINDEX_SCHEMA_VERSION}"))
    loop field in ([String]{"outputs", "definitions", "identity", "references", "calls", "effects", "members", "instances", "run"}) -> assert(json.contains("\"{field}\""))
}

