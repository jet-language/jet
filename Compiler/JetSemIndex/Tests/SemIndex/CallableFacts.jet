// Original Rust tests/semindex.rs:930–975 assertions on real checked records.
// Unregistered until S4/C4/S6 and index JSON supply both checked revisions.
fn semindex_test_returned_view_provenance_is_structured_and_changes_signature_id(union_pick: SymbolDef, right_pick: SymbolDef, union_fact: DefinitionFact, right_fact: DefinitionFact, union_json: String) {
    assert(union_pick.kind == .Function(_, _, _))
    assert_eq(union_pick.view_provenance.len(), 1)
    provenance :: union_pick.view_provenance[0]
    assert_eq(provenance.output_path, [String]{})
    assert_eq(provenance.sources.len(), 2)
    assert_eq(provenance.sources[0].source, ViewSourceFact.Parameter{index: 0})
    assert_eq(provenance.sources[0].projections, [ViewProjectionFact]{ViewProjectionFact.Range})
    assert_eq(provenance.sources[1].source, ViewSourceFact.Parameter{index: 1})
    assert_eq(provenance.sources[1].projections, [ViewProjectionFact]{ViewProjectionFact.Range})
    assert(!provenance.mutable)
    assert(union_json.contains("\"view_provenance\":[{\"output_path\":[],\"sources\":[{\"source\":{\"kind\":\"parameter\",\"index\":0}"))
    assert(union_json.contains("\"source\":{\"kind\":\"parameter\",\"index\":1}"))
    assert(union_json.contains("\"projections\":[{\"kind\":\"range\"}]"))
    assert_eq(right_pick.view_provenance[0].canonical(), "slot:$;parameter:1;access:read;path:range")
    assert(union_fact.signature_id != right_fact.signature_id)
}

// Exact Rust tests/semindex.rs:982–992 fixture parameterized by right_owner.
fn semindex_test_aggregate_view_fixture(right_owner: String) -> String Never! {
    "\nstruct Pair {{ left: View<Int>, right: View<Int> }}\n\nfn pair(left: [Int], right: [Int]) -> Pair {{\n    left_view :: left[0..1]\n    right_view :: {right_owner}[0..1]\n    return Pair.{{ left: left_view, right: right_view }}\n}}\n\nfn run() {{}}\n"
}

// Original Rust tests/semindex.rs:998–1032 assertions on actual pair facts.
// Before opens aggregate_view_fixture("right"), after opens ("left").
fn semindex_test_aggregate_view_provenance_preserves_slots_and_changes_signature_id(pair: SymbolDef, distinct_fact: DefinitionFact, changed_fact: DefinitionFact, distinct_json: String) {
    assert_eq(pair.view_provenance.len(), 2)
    assert_eq(pair.view_provenance[0].output_path, [String]{"left"})
    assert_eq(pair.view_provenance[0].sources[0].source, ViewSourceFact.Parameter{index: 0})
    assert_eq(pair.view_provenance[1].output_path, [String]{"right"})
    assert_eq(pair.view_provenance[1].sources[0].source, ViewSourceFact.Parameter{index: 1})
    assert(distinct_json.contains("\"output_path\":[\"left\"],\"sources\":[{\"source\":{\"kind\":\"parameter\",\"index\":0}"))
    assert(distinct_json.contains("\"output_path\":[\"right\"],\"sources\":[{\"source\":{\"kind\":\"parameter\",\"index\":1}"))
    assert(distinct_fact.signature_id != changed_fact.signature_id)
}
