// TOOLS-S14 original checked producer acceptance. Intentionally UNREGISTERED:
// C4 must load/check each exact fixture, then S8 must build db from that actual
// registration/Checks result and the SAME canonical module_sources before
// invoking these helpers. No prefilled facts, fake Session, alternate parser,
// or source-only catalog counts as this integration proof.
// Original consumer-only tests52–95,252–360 remain solely in Index.jet (S13);
// numeric destination113–129 remains solely in Language.jet (S16), with the
// approved current-contract golden migration. Full checked_text169–226 source
// and assertions remain solely in SemIndex/Convert.jet (S20), called below.
use jet_foundation.[MIRNameFacts, name_facts_alias_identity]
use jet_sema.[SemaCompilerModuleSource, SemaRegistrationGraph]

fn semantic_s14_from_checked(db: SymbolDB, registration: SemaRegistrationGraph, names: MIRNameFacts, module_sources: [SemaCompilerModuleSource], loaded_module_rows: [Int]) -> SemanticSymbolIndex Never! {
    assert(registration.complete, "fixture must come from the real complete C4 checked graph")
    semindex_build_semantic_symbol_index(db, registration, names, module_sources, loaded_module_rows)
}

// tests/semindex.rs98–109.
pub fn semantic_s14_contextual_result_source() -> String Never! { "fn run() {}\n" }
fn semantic_s14_contextual_result_names_are_not_advertised_as_keywords(db: SymbolDB, registration: SemaRegistrationGraph, names: MIRNameFacts, module_sources: [SemaCompilerModuleSource], loaded_module_rows: [Int]) Never! {
    symbols :: semantic_s14_from_checked(db, registration, names, module_sources, loaded_module_rows)
    loop name in [String]{"Ok", "Err"} {
        keyword_identity :: "builtin:keyword:{name}"
        loop symbol in symbols.symbols() {
            assert(symbol.identity != keyword_identity && !(symbol.name == name && symbol.kind == SemanticSymbolKind.Keyword))
        }
    }
}

// tests/semindex.rs132–165. Exact initial and final LF are part of the fixture.
pub fn semantic_s14_distinct_unit_source() -> String Never! {
    "\n#Numeric UserID :: distinct Int\n#UnitFamily(Currency) { usd }\n\nfn run() {}\n"
}
fn semantic_s14_source_distinct_and_unit_conversion_members_are_cataloged(db: SymbolDB, registration: SemaRegistrationGraph, names: MIRNameFacts, module_sources: [SemaCompilerModuleSource], loaded_module_rows: [Int], module_path: String) Never! {
    symbols :: semantic_s14_from_checked(db, registration, names, module_sources, loaded_module_rows)
    user :: (symbols.lookup_qualified("UserID.from_u8") ?? panic("source distinct conversion member"))[0]
    assert_eq(user.owner, Val("UserID"))
    assert_eq(user.signature, "UserID.from_u8(value: U8) -> UserID")
    unit :: (symbols.lookup_qualified("Usd.from_int") ?? panic("unit-family conversion member"))[0]
    assert_eq(unit.owner, Val("Usd"))
    found := false
    distinct_start :: "\n".bytes().len()
    loop candidate in symbols.complete_visible_at("from_u", Val("UserID"), SemanticVisibilityAnchor{module_path: module_path, offset: Val(distinct_start), session_top_level: false}) {
        if candidate[0].qualified_name == "UserID.from_u8" -> found = true
    }
    assert(found)
}

