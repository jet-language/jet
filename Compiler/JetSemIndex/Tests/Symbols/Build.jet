fn semantic_s14_checked_text_contract_is_one_tooling_fact(db: SymbolDB, registration: SemaRegistrationGraph, names: MIRNameFacts, module_sources: [SemaCompilerModuleSource], loaded_module_rows: [Int], json: String, dossier_text: String) Never! {
