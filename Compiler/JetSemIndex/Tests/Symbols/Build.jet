// tests/semindex.rs230–248.
pub fn semantic_s14_affine_unit_source() -> String Never! {
    "\n#UnitFamily(Temperature, base: kelvin) {\n    kelvin\n    celsius(scale: 1, offset: 27315/100)\n}\n\nfn run() {}\n"
}
fn semantic_s14_affine_unit_point_and_delta_members_are_cataloged(db: SymbolDB, registration: SemaRegistrationGraph, names: MIRNameFacts, module_sources: [SemaCompilerModuleSource], loaded_module_rows: [Int]) Never! {
    symbols :: semantic_s14_from_checked(db, registration, names, module_sources, loaded_module_rows)
