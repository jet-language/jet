    config :: ConfigFacts{name: None, version: Val(""), source: Val("./local/../src"), deps: [String: DepSource]{"textkit": DepSource.Version("1.0")}, services: [String: ServiceFact]{}, outputs: [String: OutputFact]{}, environments: environments, defaults: [String: String]{}, origin: "./release.jet"}
    assert_eq(semindex_json_config_facts(config), `{"name":null,"version":"","source":"./local/../src","deps":[{"name":"textkit","source":"1.0"}],"services":{},"outputs":[],"environments":{"dev":{"name":"dev","tools":["git","git"],"services":{"cache":{"enable":true,"ports":[6379],"ready":null,"fields":{"transport":"stdio"}}},"secrets":{"token":"x"},"fields":{"path":"./a/../b"}}},"defaults":{},"origin":"./release.jet"}`)
    assert_eq(semindex_json_members([MemberRef]{MemberRef.Path("./a/../b"), MemberRef.Find("./*"), MemberRef.Path("./a/../b")}), `{"kind":"path","path":"./a/../b"},{"kind":"find","path":"./*"},{"kind":"path","path":"./a/../b"}`)
    semindex_package_status_consumer(semindex_json_config_facts(config), semindex_status_config_facts(config) ?? panic("valid config"), true)
    semindex_package_status_consumer("[{semindex_json_members([MemberRef]{MemberRef.Path("./a/../b"), MemberRef.Find("./*"), MemberRef.Path("./a/../b")})}]", semindex_status_members([MemberRef]{MemberRef.Path("./a/../b"), MemberRef.Find("./*"), MemberRef.Path("./a/../b")}), true)
}

#Test("semindex_package_json_uses_model_digest_not_presentation_metadata") {
    // Real canonical PackageFacts constructor and digest, no reduced model.
    facts := PackageFacts.default()
    facts.name = "demo"
    facts.origin = "./package.jet"
    facts.configs = [String]{"release.jet", "release.jet"}
    facts.resolved_config_paths = [String]{"./release.jet"}
    facts.provenance["source"] = [String]{"first", "first", "last"}
    digest :: facts.semantic_digest()
    json :: package_facts_json(facts)
    assert(json.contains("\"semantic_digest\":{foundation_json_quote(digest)}"))
    assert(json.contains(`"configs":["release.jet","release.jet"],"resolved_config_paths":["./release.jet"]`))
    assert(json.contains(`"provenance":{"source":["first","first","last"]}`))
    semindex_package_status_consumer(json, package_facts_status_value(facts) ?? panic("valid package"), true)
    facts.origin = "./elsewhere/package.jet"
    facts.provenance["source"] = [String]{"elsewhere"}
    assert_eq(facts.semantic_digest(), digest)
    assert(package_facts_json(facts) != json)
    facts.name = "changed"
    assert(facts.semantic_digest() != digest)
}

// tests/semindex923–976: genuine checked signature hashes change with view
// source provenance, not with presentation/JSON field order.
fn semindex_package_codec_test_view_signature_hash(union: DefinitionFact, right: DefinitionFact, union_json: String) {
    assert(union.signature_id != right.signature_id)
    assert(union_json.contains(`"view_provenance":[{"output_path":[],"sources":[{"source":{"kind":"parameter","index":0}`))
    assert(union_json.contains(`"source":{"kind":"parameter","index":1}`))
    assert(union_json.contains(`"projections":[{"kind":"range"}]`))
}

fn semindex_package_codec_test_reorder_fixtures() -> [String] Never! {
    [String]{
        `
module math {
    pub fn double(n: Int) -> Int {
        return n * 2
    }
}

struct Point {
    x: Int
    y: Int

    fn sum(self) -> Int {
        return self.x + self.y
    }
}

impl Point {
    fn origin() -> Point {
        return Point.{x: 0, y: 0}
    }
}

enum Light {
    Red
    Green
}

fn helper(p: Point) -> Int {
    return p.sum()
}

fn run() {
    p :: Point.origin()
    print(helper(p))
}
`,
        `
enum Light {
    Red
    Green
}

fn helper(p: Point) -> Int {
    return p.sum()
}

struct Point {
    x: Int
    y: Int

    fn sum(self) -> Int {
        return self.x + self.y
    }
}

module math {
    pub fn double(n: Int) -> Int {
        return n * 2
    }
}

impl Point {
    fn origin() -> Point {
        return Point.{x: 0, y: 0}
    }
}

fn run() {
    p :: Point.origin()
    print(helper(p))
}
`,
    }
}

fn semindex_package_codec_test_view_signature_fixtures() -> [String] Never! {
    [String]{
        `fn pick(left: [Int], right: [Int], first: Bool) -> View<Int> {
    if first { return left[0..1] }
    return right[0..1]
}
fn run() {}
`,
        `fn pick(left: [Int], right: [Int], first: Bool) -> View<Int> { return right[0..1] }
fn run() {}
`,
    }
}

#Test("semindex_typed_package_uses_real_nested_payload_and_rejects_provider_duplicates") {
    facts := PackageFacts.default()
    facts.name = "real-codec-consumer"
    facts.outputs["wire-key"] = OutputFact{kind: PackageOutputKind.Executable, name: "display", entry: None,
        fields: [String: String]{}, payload: OutputPayload.Array([OutputPayload]{OutputPayload.Number("-0.00e+02"), OutputPayload.Null, OutputPayload.Array([OutputPayload]{})})}
    facts.provenance["outputs.wire-key"] = [String]{"first", "first", "last"}
    facts.inline_configs["empty"] = ConfigFacts{name: None, version: Val(""), source: None, deps: [String: DepSource]{},
        services: [String: ServiceFact]{}, outputs: [String: OutputFact]{}, environments: [String: EnvironmentFact]{}, defaults: [String: String]{}, origin: "./raw/../config"}
    raw :: package_facts_json(facts)
    assert(raw.contains(`"payload":[-0.00e+02,null,[]],"provenance":["first","first","last"]`))
    canonical :: raw.replace(`"payload":[-0.00e+02,null,[]]`, `"payload":[-0,null,[]]`)
    semindex_package_status_consumer(canonical, package_facts_status_value(facts) ?? panic("real package projection"), true)
    rendered :: StatusEnvelope.new("inspect-semindex", true).with_field("package_facts", package_facts_status_value(facts) ?? panic("real package projection")).json()
    assert(rendered.contains(`"payload":[-0,null,[]],"provenance":["first","first","last"]`))
    assert(rendered.contains(`"inline_configs":{"empty":{"name":null,"version":"","source":null`))
    facts.authority.providers = [ProviderAuthority]{
        ProviderAuthority{provider: "same", registry: "one", allow: [String]{}, deny: [String]{}},
        ProviderAuthority{provider: "same", registry: "two", allow: [String]{}, deny: [String]{}},
    }
    if package_facts_status_value(facts) == {
        .Err(error) -> assert_eq(error.message, "duplicate status field `same`")
        .Ok(_) -> panic("canonical Report silently collapsed provider duplicates")
    }
}

