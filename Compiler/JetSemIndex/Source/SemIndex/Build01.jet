// Rust: crates/jet-semindex/src/Build.rs:1212
// Genuine gap: Structure.jet185 used plain addition, not usize saturation.
// Integration replaces that body and migrates every walker caller to this body.
// GATE #4483: USize.MAX is the compilation target's unsigned pointer maximum.
// Foundation's Span carrier must retain every offset in that range.
// Rust: crates/jet-semindex/src/Build.rs:1218
fn structural_span_add(offset: Int, extra: Int) -> Int {
    maximum :: USize.MAX as Int
    if offset > maximum - extra -> maximum else -> offset + extra
}
// Rust: crates/jet-semindex/src/Build.rs:1212
fn structural_expr_span(expr: Expr) -> Span {
    if expr == {
        .Call(call) -> {
            end :: if call.args.is_empty() -> structural_span_add(call.name_span.end, 2)
                else -> structural_span_add(structural_expr_span(call.args[call.args.len() - 1].expr).end, 1)
            Span{start: call.name_span.start, end: end}
        }
        .MethodCall(receiver, _, method_span, _, _, args, _, _, _, _) -> {
            end :: if args.is_empty() -> structural_span_add(method_span.end, 2)
                else -> structural_span_add(structural_expr_span(args[args.len() - 1].expr).end, 1)
            Span{start: structural_expr_span(receiver).start, end: end}
        }
        _ -> expr_span(expr)
    }
}

