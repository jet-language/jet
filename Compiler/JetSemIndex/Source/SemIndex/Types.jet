// The semantic index's stable query types (and the `SymKind`/`SymDef`/`SymRef`
// records walks into). The index is versioned independently of its consumers:
// `jet inspect semindex`, `jet inspect expand`, and `jet doc` read these rows;
// LSP hover and inlay projections have no Jet consumer and are not part of this
// port.
use jet_foundation.[
    AccessConvention,
    CallablePolicy,
    DerivationRecord,
    EffectRowEntry,
    FailureContract,
    NamedSpan,
    ParamZone,
    Span,
    Type,
    ViewProvenanceMap,
    failure_contract_shown_type,
    failure_contract_source,
    type_name,
    Field,
    Param,
]

// `SCHEMA_VERSION`: bump when the exported fact shape changes incompatibly.
SEMINDEX_SCHEMA_VERSION: 20

// `CallableFactUnavailable`: the typed reason a checked projection cannot
// supply a later metadata value.
SemUnavailable: struct {
    required_stage: String
    reason: String
}

// `CallableDefaultFact`: a source-text projection of a declared default; its
// prepared value is unavailable.
SemDefault: struct {
    source_text: String
    source: Span
}

// One public call slot (`CallableParameterFact` plus the `SymKind::Function`
// parallel rows it is assembled from).
SemParam: struct {
    name: String
    ty: Type
    source: Span
    label: String
    zone: ParamZone
    variadic: Bool
    access: AccessConvention
    default: SemDefault?
}

// `failure_contract` is `None` exactly when `failure_unavailable` explains why
// (`CallableFactAvailability`); the same holds for `generic_parameters`.
SemCallable: struct {
    params: [SemParam]
    signature_facts_available: Bool
    return_type: Type?
    failure_contract: FailureContract?
    failure_unavailable: SemUnavailable?
    foreign_boundary: Bool
    effects: [EffectRowEntry]?
    effect_via: NamedSpan?
    policies: [CallablePolicy]
    generic_parameters: [String]?
    generic_unavailable: SemUnavailable?
}

SemField: struct {
    name: String
    ty: Type
}

SemKind: enum {
    Module
    Function(callable: SemCallable)
    Struct(fields: [SemField], derives: [String])
    Enum(variants: [String], derives: [String])
    Trait
    Tag
    Type(derives: [String])
    Const
    EnumVariant(parent: String)
    Field(ty: Type, parent: String)
    Local(mutable: Bool, ty: Type?)
    Param(ty: Type)
}

// When an immutable `name: value` local is computed (semindex_local_stages):
// while compiling, with the value it holds (`value` is "" when that value is
// too long to show), or at run time, with the reason it waits.
SemLocalStage: enum {
    Build(value: String)
    Run(reason: String)
}

// `qualified_name` is the canonical display path the walk records with the
// definition; `local_stage` is set on an immutable local whose stage is known.
SemDef: struct {
    identity: String
    name: String
    qualified_name: String
    def_span: Span
    module_path: String
    kind: SemKind
    local_stage: SemLocalStage?{None}
}

SemAnchor: struct {
    module_path: String
    kind: String
    def_span: Span
    semantic_identity: String?
}

SemCompilerFact: struct {
    name: String
    kind: String
    type_name: String
}

SemRef: struct {
    name: String
    span: Span
    module_path: String
    scope_identity: String?
    target: SemAnchor?
    fact: SemCompilerFact?
}

SemCall: struct {
    caller: String
    callee: String
    module_path: String
    span: Span
}

// `kind` is `field`, `variant`, or `method`; `origin` is `type_body`,
// `inherent_impl`, `trait_impl`, or `trait_requirement`, with `origin_trait`
// naming the trait of the last two.
SemMember: struct {
    owner: String
    name: String
    identity: String
    kind: String
    origin: String
    origin_trait: String
    signature: String
    module_path: String
    span: Span
}

SemEffectProvenance: struct {
    effect_name: String
    call_path: [String]
    spans: [Span]
}

SemEffect: struct {
    function: String
    direct: [String]
    callees: [String]
    inferred: [String]
    maximal: Bool
    provenance: [SemEffectProvenance]
}

SemArithmetic: struct {
    operation: String
    policy: String
    module_path: String
    operation_span: Span
    scope_span: Span
}

// `slot_kind` is `scalar` or `list`.
SemNode: struct {
    id: Int
    parent: Int?
    slot: String
    slot_kind: String
    ordinal: Int
    class: String
    shape: String
    module_path: String
    span: Span
}

SemSlotBoundary: struct {
    parent: Int
    slot: String
    module_path: String
    span: Span
}

// `kind` is the stable `BypassKind::as_str` word.
SemBypass: struct {
    kind: String
    site: String
    detail: String
    module_path: String
    span: Span
}

SemDefinitionFact: struct {
    stable_id: String
    signature_id: String
    content_id: String
    human_identity: String
    name: String
    kind: String
    module_path: String
    span: Span
}

// An associated type with no `ty` is a requirement (`type Item`).
SemAssociatedType: struct {
    name: String
    ty: String?
}

SemTraitContract: struct {
    trait_name: String
    associated_types: [SemAssociatedType]
    methods: [String]
}

SemInstanceApplication: struct {
    name: String
    module_path: String
    semantic_identity: String
    span: Span
}

SemInstance: struct {
    name: String
    module_path: String
    fingerprint: String
    full_key_hex: String
    template_definition_id: String
    template_span: Span
    arguments: [String]
    argument_values: [String]
    argument_provenance: [[String]]
    applications: [SemInstanceApplication]
    exported_members: [String]
}

SemOutputEntry: struct {
    identity: String
    name: String
    module_path: String
    definition_span: Span
    reference_span: Span
    params: [String]
    return_type: String?
    failure_contract: String
    failure_source: String
    authority: String
    effects: [String]
}

SemOutput: struct {
    binding: String
    kind: String
    name: String
    module_path: String
    span: Span
    entry: SemOutputEntry
}

SemStateNode: struct {
    name: String
    terminal: Bool
    reachable: Bool?
    span: Span
}

SemStateTransition: struct {
    operation: String
    from: String?
    to: String
}

SemStateGraph: struct {
    owner: String
    module_path: String
    states: [SemStateNode]
    transitions: [SemStateTransition]
}

// One converted definition: the walk's record plus the per-definition facts
// `convert_defs` attaches.
SemDefinition: struct {
    def: SemDef
    view_provenance: ViewProvenanceMap?
    derives: [String]
    nominal_base: String?
    trait_contracts: [SemTraitContract]
}

// The application-boundary effect roles of one checked program: what it
// requires, what its policy grants and denies, and the policy's name, each a
// sorted set. The caller that knows the program's authority supplies it.
SemEffectProjection: struct {
    required: [String]
    granted: [String]
    denied: [String]
    authority: String
}

// `SemIndex`: the versioned index over one checked program. Its effect
// projection is the application authority of the same checked program `jet
// build` authorizes.
SemIndex: struct {
    definitions: [SemDefinition]
    definition_facts: [SemDefinitionFact]
    derivations: [DerivationRecord]
    instances: [SemInstance]
    outputs: [SemOutput]
    state_graphs: [SemStateGraph]
    effect_projection: SemEffectProjection
    references: [SemRef]
    calls: [SemCall]
    effects: [SemEffect]
    arithmetic: [SemArithmetic]
    members: [SemMember]
    nodes: [SemNode]
    slot_boundaries: [SemSlotBoundary]
    bypasses: [SemBypass]
}

// `CallableSignatureFact::failure_contract_name`.
semindex_failure_contract_name: fn(callable: SemCallable) -> String? Never! {
    contract: callable.failure_contract ?? return None
    Val(type_name(failure_contract_shown_type(contract)))
}

// `CallableSignatureFact::failure_source_name`.
semindex_failure_source_name: fn(callable: SemCallable) -> String? Never! {
    contract: callable.failure_contract ?? return None
    Val(failure_contract_source(contract))
}

// `CallableParameterFact::access_name`.
semindex_access_name: fn(access: AccessConvention) -> String Never! {
    if access == {
        .Read -> "read"
        .Write -> "write"
        .Move -> "move"
    }
}

// `CallableParameterFact::zone_name`.
semindex_zone_name: fn(zone: ParamZone) -> String Never! {
    if zone == {
        .PositionalOnly -> "positional_only"
        .Either -> "either"
        .LabelOnly -> "label_only"
    }
}

// The callable a definition carries, when it is a function.
semindex_callable: fn(definition: SemDef) -> SemCallable? Never! {
    // copy: `callable` is a payload of read parameter `definition`, which keeps the original; the Val carrier owns this one
    if definition.kind == .Function(callable) -> return Val(callable.copy())
    None
}
