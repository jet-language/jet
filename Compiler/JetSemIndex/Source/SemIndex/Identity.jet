// Presentation replacement, stable declaration identities, caller keys and
// active/local scope identities. CP-NAMES owns generated display projections
// and checked reference anchors. Presentation replacement never changes an
// identity or a definition span.
use {
    jet_foundation.[
        NameFacts,
        Span,
        TraitMethodSig,
    ]
    jet_sema.[SemaCompilerModuleSource, SemaRegistrationGraph]
}

// #4357: Rust `(internal, display)` replacement row; ephemeral presentation
// input, not another checked-name ledger. Caller preserves longest-first order.
SemIndexPresentationReplacement: struct {
    internal: String
    display: String
}

semindex_project_text: fn(replacements: [SemIndexPresentationReplacement], text: &String) Never! {
    loop replacement in replacements -> text = text.replace(replacement.internal, replacement.display)
}

semindex_caller_key: fn(frame: CallerFrame) -> String Never! {
    if frame.owner == {
        .Val(owner) -> "{owner}::{frame.name}"
        .None -> frame.name
    }
}

semindex_root_identity: fn(module_path: String) -> String Never! {
    "module:{module_path}"
}
semindex_module_identity: fn(scope: String, name: String) -> String Never! {
    "module:{scope}::{name}"
}
semindex_type_identity: fn(scope: String, name: String) -> String Never! {
    "type:{scope}::{name}"
}
semindex_member_identity: fn(scope: String, parent: String, kind: String, name: String) -> String Never! {
    "{kind}:{scope}::{parent}.{name}"
}
// Rust's unused Func parameter is omitted: identity deliberately ignores edits
// to the call contract/body; the structural audit compares signature separately.
semindex_callable_identity: fn(scope: String, owner: String?, name: String) -> String Never! {
    if owner == {
        .Val(owner) -> "method:{scope}::{owner}.{name}"
        .None -> "fn:{scope}::{name}"
    }
}
semindex_trait_method_identity: fn(scope: String, owner: String, signature: TraitMethodSig) -> String Never! {
    "method:{scope}::{owner}.{signature.name}"
}
semindex_active_scope: fn(ctx: WalkCtx) -> String Never! {
    if ctx.caller == {
        .Val(caller) -> caller.identity
        .None -> ctx.scope_identity
    }
}
semindex_local_identity: fn(scope: String, kind: String, name: String) -> String Never! {
    "{kind}:{scope}::{name}"
}
semindex_scoped_local_identity: fn(ctx: WalkCtx, kind: String, name: String) -> String Never! {
    semindex_local_identity(semindex_active_scope(ctx), kind, name)
}
semindex_origin_label: fn(origin: MemberOrigin) -> String Never! {
    if origin == {
        .TypeBody -> "type"
        .InherentImpl -> "impl"
        .TraitImpl(trait_name) -> "impl {trait_name}"
        .TraitRequirement(trait_name) -> "trait {trait_name}"
    }
}

// All replacements are collected before presentation mutates. CP-NAMES owns
// canonical_paths/display_path and their checked producer.
semindex_project_generated_presentation: fn(db: &SymbolDB, registration: SemaRegistrationGraph, names: NameFacts, module_sources: [SemaCompilerModuleSource], loaded_module_rows: [Int]) Never! {
    projections := [Int:[SemIndexPresentationReplacement]]{}
    sources: semindex_loaded_source_rows_by_path(module_sources, loaded_module_rows)
    loop source_index in loaded_module_rows {
        module_index: semindex_loaded_registration_index(registration, module_sources[source_index])
        replacements := [SemIndexPresentationReplacement]{}
        loop path in name_facts_canonical_paths(names, module_index) {
            if path.name.contains(".") -> next
            if name_facts_display_path(names, module_index, path.name, Val(module_index)) == .Val(display) {
                leaves: display.split(".")
                leaf := leaves[leaves.len() - 1] // #4303
                if display != path.name && leaf != path.name -> replacements.push(SemIndexPresentationReplacement{internal: path.name, display: display})
            }
        }
        // Rust sort is stable and compares UTF-8 byte lengths, not scalar count.
        replacements.sort_by((left: SemIndexPresentationReplacement, right: SemIndexPresentationReplacement) -> right.internal.bytes().len() <=> left.internal.bytes().len())
        projections[module_index] = replacements.move()
    }
    loop index in 0..<db.hover.len() {
        if sources.get(db.hover[index].module_path) == .Val(source_index) -> semindex_project_text(projections[semindex_loaded_registration_index(registration, module_sources[source_index])], db.hover[index].text)
    }
    loop index in 0..<db.inlay.len() {
        if sources.get(db.inlay[index].module_path) == .Val(source_index) -> semindex_project_text(projections[semindex_loaded_registration_index(registration, module_sources[source_index])], db.inlay[index].label)
    }
    loop index in 0..<db.members.len() {
        if sources.get(db.members[index].module_path) == .Val(source_index) -> semindex_project_text(projections[semindex_loaded_registration_index(registration, module_sources[source_index])], db.members[index].signature)
    }
}

// Checked anchors only; no spelling-based target resolution. The prefix reuses
// S5's one DB/state and explicit canonical names input.
semindex_scoped_ref: fn(db: SymbolDB, ctx: WalkCtx, names: NameFacts, name: String, span: Span, module_path: String) -> SymRef Never! {
    target := DefinitionAnchor?{None}
    checked_path: names.modules[ctx.module_idx].path
    if name_facts_reference(names, checked_path, span.start, span.end) == .Val(reference) {
        target = Val(DefinitionAnchor{module_path: reference.module_path, kind: reference.kind, def_span: semindex_source_span(reference.def_span), semantic_identity: reference.semantic_identity})
    }
    SymRef{name: name, span: span, module_path: module_path, scope_identity: Val(semindex_active_scope(ctx)), target: target, fact: CompilerFact.from_member(name)}
}
semindex_declaration_ref: fn(db: SymbolDB, ctx: WalkCtx, names: NameFacts, name: String, span: Span, module_path: String) -> SymRef Never! {
    target := DefinitionAnchor?{None}
    if name_facts_declaration(names, ctx.module_idx, name) == .Val(declaration) {
        declaration_module := module_path
        if declaration.module_index >= 0 && declaration.module_index < names.modules.len() -> declaration_module = names.modules[declaration.module_index].path
        target = Val(DefinitionAnchor{module_path: declaration_module, kind: declaration.kind, def_span: semindex_source_span(declaration.span), semantic_identity: name_facts_semantic_identity(names, declaration.module_index, name)})
    }
    SymRef{name: name, span: span, module_path: module_path, scope_identity: Val(semindex_active_scope(ctx)), target: target, fact: None}
}
