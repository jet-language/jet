// Rust: crates/jet-semindex/src/lib.rs:264
pub fn semindex_open_with_overlays_and_diagnostics(entry: OSPath, overlays: [(OSPath, String)]) -[FS, Env]> (SemIndex, [Diagnostic]) SemIndexError! {
    (index, diagnostics, _) :: semindex_open_with_overlays_diagnostics_and_inputs(entry, overlays)
    Ok((^index, ^diagnostics))
}

// Rust: crates/jet-semindex/src/lib.rs:275
pub fn semindex_open_with_overlays_diagnostics_and_inputs(entry: OSPath, overlays: [(OSPath, String)]) -[FS, Env]> (SemIndex, [Diagnostic], [OSPath]) SemIndexError! {
    entry_str :: entry.to_string_lossy()
    (diags, bundle, facts) :: check_file_with_overlays(entry_str, overlays, false)
    if bundle == {
        .Val(checked_bundle) -> {
            // Preserve physical loader membership and order, including modules
            // with no definitions. Expected diagnostics do not reject a bundle.
            inputs :: loop module in checked_bundle.modules -> ~module.path
            index := build_index(checked_bundle, facts)
            cache := WorkspaceDeclarationCache.new()
            semindex_attach_package_facts(&index, &cache, entry_str)
            Ok((^index, ^diags, ^inputs))
        }
        .None -> Err(SemIndexError.Load{diagnostics: ^diags})
    }
}
