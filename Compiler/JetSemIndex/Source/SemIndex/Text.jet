// The source-text helpers the index walk and its documentation rows read.

// The text of `bytes[start..<end]`, or "" when the range is empty.
semindex_doc_text: fn(bytes: [U8], start: Int, end: Int) -> String Never! {
    if start >= end -> return ""
    String.from_bytes(bytes[start..end - 1]) ?? ""
}

// Rust `str::lines`: split on `\n`, drop one trailing `\r` per line, and no
// final empty line after a trailing newline.
semindex_doc_lines: fn(text: String) -> [String] Never! {
    bytes: text.bytes()
    lines := [String]{}
    start := 0
    loop index in 0..<bytes.len() {
        if bytes[index] != (U8{10}) -> next
        end := index
        if end > start && bytes[end - 1] == (U8{13}) -> end -= 1
        lines.push(semindex_doc_text(bytes, start, end))
        start = index + 1
    }
    if start < bytes.len() {
        end := bytes.len()
        if end > start && bytes[end - 1] == (U8{13}) -> end -= 1
        lines.push(semindex_doc_text(bytes, start, end))
    }
    lines
}

// `line.strip_prefix(prefix)`.
semindex_doc_strip_prefix: fn(line: String, prefix: String) -> String? Never! {
    if !line.starts_with(prefix) -> return None
    bytes: line.bytes()
    Val(semindex_doc_text(bytes, prefix.bytes().len(), bytes.len()))
}

// One declaration's `///` block: its first summary line and its `Example:`
// lines.
SemDocComment: struct {
    summary: String
    examples: [String]
}
