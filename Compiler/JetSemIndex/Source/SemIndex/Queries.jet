use {
    jet_foundation.[
        DerivationIdentity,
        DerivationRecord,
        DerivationRef,
        derivation_record_reference,
        derivation_record_invalidate_if_identity_changed,
    ]
    jet_pkg_model.[
        PackageFacts,
        OverlayPolicy,
        EffectProjection,
        pkg_project_application_effects,
    ]
}

// Construction, attachment, retained checked facts and first-match queries.
// Views borrow the index; a single-result view has one row.
impl SemIndex {
    new: fn(defs: &&[SymbolDef], refs: &&[SymbolRef], calls: &&[CallEdge], effects: &&[EffectFact], members: &&[MemberFact], nodes: &&[StructuralNode], definition_facts: &&[DefinitionFact]) -> SemIndex Never! {
        SemIndex{
            schema_version: SEMINDEX_SCHEMA_VERSION,
            defs: defs.move(),
            refs: refs.move(),
            calls: calls.move(),
            effects: effects.move(),
            arithmetic: [ArithmeticOperationFact]{},
            members: members.move(),
            nodes: nodes.move(),
            _definition_facts: definition_facts.move(),
            bypasses: [BypassFact]{},
            instances: [InstanceFact]{},
            outputs: [SemIndexOutputFact]{},
            state_graphs: [StateGraphFact]{},
            package_facts: None,
            workspace_overlay_policy: None,
            effect_projection: EffectProjection.default(),
            derivations: [DerivationRecord]{},
        }
    }

    set_bypasses: fn(&self, facts: &&[BypassFact]) Never! { self.bypasses = facts.move() }
    set_instances: fn(&self, facts: &&[InstanceFact]) Never! { self.instances = facts.move() }
    set_outputs: fn(&self, facts: &&[SemIndexOutputFact]) Never! { self.outputs = facts.move() }
    set_state_graphs: fn(&self, facts: &&[StateGraphFact]) Never! { self.state_graphs = facts.move() }
    set_arithmetic: fn(&self, facts: &&[ArithmeticOperationFact]) Never! { self.arithmetic = facts.move() }
    set_effect_projection: fn(&self, projection: &&EffectProjection) Never! { self.effect_projection = projection.move() }

    set_derivations: fn(&self, facts: &&[DerivationRecord]) Never! {
        self.derivations = facts.move()
        // #4343: inline comparator, not a named-function comparator.
        self.derivations.sort_by((left: DerivationRecord, right: DerivationRecord) -> left.id <=> right.id)
    }
    derivations: fn(self) -> View<DerivationRecord> Never! { self.derivations[0..<self.derivations.len()] }
    derivation_window: fn(self, index: Int) -> View<DerivationRecord> Never! { self.derivations[index..index] }
    derivation: fn(self, id: String) -> View<DerivationRecord>? Never! {
        loop index in 0..<self.derivations.len() {
            if self.derivations[index].id == id -> return Val(self.derivation_window(index))
        }
        None
    }
    derivation_ref: fn(self, subject: String) -> DerivationRef? Never! {
        loop record in self.derivations {
            if record.subject == subject -> return Val(derivation_record_reference(record))
        }
        None
    }
    invalidate_derivations: fn(&self, current: DerivationIdentity) -> Int Never! {
        count := 0
        loop index in 0..<self.derivations.len() {
            if derivation_record_invalidate_if_identity_changed(self.derivations[index], current) -> count += 1
        }
        count
    }

    attach_package_facts: fn(&self, facts: &&PackageFacts) Never! {
        self.effect_projection = pkg_project_application_effects(self.effect_projection.required_effects, Val(facts))
        self.package_facts = Val(facts.move())
        // Scalar facts stay in their canonical owner. Read consumers take the
        // SemIndex as a READ parameter and project its fields synchronously;
        // #4446 has no scalar View representation, and lists would allocate.
    }
    attach_workspace_overlay_policy: fn(&self, policy: &&OverlayPolicy) Never! { self.workspace_overlay_policy = Val(policy.move()) }

    schema_version: fn(self) -> Int Never! { self.schema_version }
    definitions: fn(self) -> View<SymbolDef> Never! { self.defs[0..<self.defs.len()] }
    references: fn(self) -> View<SymbolRef> Never! { self.refs[0..<self.refs.len()] }
    call_edges: fn(self) -> View<CallEdge> Never! { self.calls[0..<self.calls.len()] }
    effects: fn(self) -> View<EffectFact> Never! { self.effects[0..<self.effects.len()] }
    arithmetic: fn(self) -> View<ArithmeticOperationFact> Never! { self.arithmetic[0..<self.arithmetic.len()] }
    members: fn(self) -> View<MemberFact> Never! { self.members[0..<self.members.len()] }
    structural_nodes: fn(self) -> View<StructuralNode> Never! { self.nodes[0..<self.nodes.len()] }
    definition_facts: fn(self) -> View<DefinitionFact> Never! { self._definition_facts[0..<self._definition_facts.len()] }
    bypasses: fn(self) -> View<BypassFact> Never! { self.bypasses[0..<self.bypasses.len()] }
    instances: fn(self) -> View<InstanceFact> Never! { self.instances[0..<self.instances.len()] }
    outputs: fn(self) -> View<SemIndexOutputFact> Never! { self.outputs[0..<self.outputs.len()] }
    state_graphs: fn(self) -> View<StateGraphFact> Never! { self.state_graphs[0..<self.state_graphs.len()] }

    definition_window: fn(self, index: Int) -> View<SymbolDef> Never! { self.defs[index..index] }
    reference_window: fn(self, index: Int) -> View<SymbolRef> Never! { self.refs[index..index] }
    call_window: fn(self, index: Int) -> View<CallEdge> Never! { self.calls[index..index] }
    effect_window: fn(self, index: Int) -> View<EffectFact> Never! { self.effects[index..index] }
    references_to: fn(self, name: String) -> [View<SymbolRef>] Never! {
        matches := [View<SymbolRef>]{}
        loop index in 0..<self.refs.len() {
            if self.refs[index].name == name -> matches.push(self.reference_window(index))
        }
        matches
    }
    call_sites: fn(self, callee: String) -> [View<CallEdge>] Never! {
        matches := [View<CallEdge>]{}
        loop index in 0..<self.calls.len() {
            if self.calls[index].callee == callee -> matches.push(self.call_window(index))
        }
        matches
    }
    effect_of: fn(self, function: String) -> View<EffectFact>? Never! {
        loop index in 0..<self.effects.len() {
            if self.effects[index].function == function -> return Val(self.effect_window(index))
        }
        None
    }
    lookup: fn(self, name: String) -> View<SymbolDef>? Never! {
        loop index in 0..<self.defs.len() {
            if self.defs[index].name == name -> return Val(self.definition_window(index))
        }
        None
    }
    lookup_identity: fn(self, identity: String) -> View<SymbolDef>? Never! {
        loop index in 0..<self.defs.len() {
            if self.defs[index].identity == identity -> return Val(self.definition_window(index))
        }
        None
    }

    // Dossier joins retained facts, never checks again. Bypass facts are
    // program-wide; state graphs and references are owner-only.
    dossier: fn(self, target: String) -> TypeDossier Never! {
        definition := SymbolDef?{None}
        owner := target.copy()
        loop row in self.defs {
            if row.name == target || row.identity == target {
                definition = Val(row.copy())
                owner = row.name.copy()
                break
            }
        }
        members := [MemberFact]{}
        loop row in self.members { if row.owner == owner -> members.push(row.copy()) }
        semindex_sort_members(members)
        references := [SymbolRef]{}
        loop row in self.refs { if row.name == owner -> references.push(row.copy()) }
        references.sort_by((left: SymbolRef, right: SymbolRef) -> (left.module_path <=> right.module_path).then(left.span.start <=> right.span.start).then(left.span.end <=> right.span.end))
        bypass_facts := self.bypasses.copy()
        bypass_facts.sort_by((left: BypassFact, right: BypassFact) -> (left.module_path <=> right.module_path).then(left.span.start <=> right.span.start))
        state_graphs := [StateGraphFact]{}
        loop graph in self.state_graphs { if graph.owner == owner -> state_graphs.push(graph.copy()) }
        TypeDossier{
            schema_version: SEMINDEX_SCHEMA_VERSION,
            target: owner,
            definition: definition,
            members: members,
            references: references,
            bypass_facts: bypass_facts,
            state_graphs: state_graphs,
            effect_projection: self.effect_projection.copy(),
        }
    }

    // location/body/name alone never change the structural signature. Repeated IDs
    // are retained, not deduplicated.
    structural_audit: fn(self, next: SemIndex) -> StructuralAudit Never! {
        added := [String]{}
        removed := [String]{}
        changed := [String]{}
        loop definition in next.defs {
            if self.lookup_identity(definition.identity) == {
                .Val(previous) -> {
                    if semindex_structural_signature(previous[0].kind, previous[0].view_provenance) != semindex_structural_signature(definition.kind, definition.view_provenance) -> changed.push(definition.identity.copy())
                }
                .None -> added.push(definition.identity.copy())
            }
        }
        loop definition in self.defs {
            if next.lookup_identity(definition.identity) == None -> removed.push(definition.identity.copy())
        }
        added.sort()
        removed.sort()
        changed.sort()
        StructuralAudit{added: added, removed: removed, changed: changed}
    }
}

// Stable member order by kind, origin, spelling, module, then byte start; end
// and trait spelling are intentionally not tie breakers.
semindex_sort_members: fn(members: &[MemberFact]) Never! {
    members.sort_by((left: MemberFact, right: MemberFact) -> (semindex_member_rank(left.kind) <=> semindex_member_rank(right.kind)).then(semindex_origin_rank(left.origin) <=> semindex_origin_rank(right.origin)).then(left.name <=> right.name).then(left.module_path <=> right.module_path).then(left.span.start <=> right.span.start))
}
semindex_member_rank: fn(kind: MemberKind) -> Int Never! {
    if kind == {
        .Field -> 0
        .Variant -> 1
        .Method -> 2
    }
}
semindex_origin_rank: fn(origin: MemberOrigin) -> Int Never! {
    if origin == {
        .TypeBody -> 0
        .InherentImpl -> 1
        .TraitImpl(_) -> 2
        .TraitRequirement(_) -> 3
    }
}

// Exact callable/field/variant identity material, including structured
// returned-view provenance. Parameter names are excluded.
semindex_structural_signature: fn(kind: SemIndexSymbolKind, view_provenance: [ViewProvenanceFact]) -> String Never! {
    if kind == {
        .Module -> "module"
        .Function(params, call_contract, ret) -> {
            types := [String]{}
            contracts := [String]{}
            views := [String]{}
            loop param in params -> types.push(param.ty.copy())
            loop entry in call_contract -> contracts.push("{entry.label}:{entry.zone}:{entry.variadic}")
            loop view in view_provenance -> views.push(view.canonical())
            "fn({types.join(",")});call_contract=[{contracts.join(",")}]=>{ret ?? "()"};view_source={views.join("|")}"
        }
        .Struct(fields) -> {
            rows := [String]{}
            loop field in fields -> rows.push("{field.name}:{field.ty}")
            "struct{{{rows.join(",")}}}"
        }
        .Enum(variants) -> "enum{{{variants.join(",")}}}"
        .Trait -> "trait"
        .Tag -> "tag"
        .Type -> "type"
        .Const -> "const"
        .EnumVariant(parent) -> "variant:{parent}"
        .Field(ty, parent) -> "field:{parent}:{ty}"
        .Local(mutable, ty) -> "local:{mutable}:{ty ?? "?"}"
        .Param(ty) -> "param:{ty}"
    }
}
