// Additive projections, callable checked facts, arithmetic facts, and their
// public presentation helpers.
use jet_foundation.[
    AccessConvention,
    CallablePolicy,
    FailureContract,
    ParamZone,
    Type,
    TypeParam,
    failure_contract_shown_type,
    failure_contract_source,
    type_name,
    Field,
]

// Rust ExpandValue/Lens/Projection. An object is an ordered list, not a map:
// duplicate keys and their order remain representable. Named rows avoid the
// bootstrap tuple Debug/Show defect (#4357).
ExpandValue: enum {
    Null
    Bool(value: Bool)
    Number(value: Int)
    String(value: String)
    Array(values: [ExpandValue])
    Object(entries: [ExpandObjectEntry])
}

ExpandObjectEntry: struct {
    key: String
    value: ExpandValue
}

ExpandLens: struct {
    name: String
    summary: String
    facts: [ExpandValue]
}

ExpandProjection: struct {
    selection: String
    lenses: [ExpandLens]
}

// Rust ViewSourceFact/ViewProjectionFact/ViewSourcePathFact.
ViewSourceFact: enum {
    Receiver
    Parameter(index: Int)
    Static(module_path: String, name: String)
}

ViewProjectionFact: enum {
    Field(name: String)
    Index
    Range
}

ViewSourcePathFact: struct {
    source: ViewSourceFact
    projections: [ViewProjectionFact]
}

// Rust ViewProvenanceFact::canonical: these exact bytes feed signature identity.
// Preserve the returned aggregate slot and the order of all alternative sources.
ViewProvenanceFact: struct {
    output_path: [String]
    sources: [ViewSourcePathFact]
    mutable: Bool

    canonical: fn(self) -> String Never! {
        access: if self.mutable -> "write" else -> "read"
        slot: if self.output_path.len() == 0 -> "$" else -> self.output_path.join(".")
        paths := [String]{}
        loop source_path in self.sources {
            source: if source_path.source == {
                .Receiver -> "receiver"
                .Parameter(index) -> "parameter:{index}"
                .Static(module_path, name) -> "static:{module_path}::{name}"
            }
            projections := [String]{}
            loop projection in source_path.projections {
                name: if projection == {
                    .Field(name) -> "field:{name}"
                    .Index -> "index"
                    .Range -> "range"
                }
                projections.push(name)
            }
            path: projections.join("/")
            if self.sources.len() == 1 -> return "slot:{slot};{source};access:{access};path:{path}"
            paths.push("{source};path:{path}")
        }
        "slot:{slot};one_of({paths.join(",")});access:{access}"
    }
}

// Rust CallableDefaultFact/CallableFactUnavailable/CallableFactAvailability.
// SourceSpan is S2's lossless byte-range record. Defaults are source projections,
// never prepared values; a checked empty collection is not unavailable.
CallableDefaultFact: struct {
    source_text: String
    source: SourceSpan
    value_unavailable: CallableFactUnavailable
}

CallableFactUnavailable: struct {
    required_stage: CompilerStage
    reason: String
}

CallableFactAvailability: enum<T> {
    Checked(value: T)
    Unavailable(reason: CallableFactUnavailable)
}

// Rust CallableParameterFact::{access_name,zone_name,type_name}.
CallableParameterFact: struct {
    name: String
    label: String
    source: SourceSpan
    default: CallableDefaultFact?
    access: AccessConvention
    zone: ParamZone
    ty: Type
    variadic: Bool

    access_name: fn(self) -> String Never! {
        if self.access == {
            .Read -> "read"
            .Write -> "write"
            .Move -> "move"
        }
    }

    zone_name: fn(self) -> String Never! {
        if self.zone == {
            .PositionalOnly -> "positional_only"
            .Either -> "either"
            .LabelOnly -> "label_only"
        }
    }

    type_name: fn(self) -> String Never! { type_name(self.ty) }
}

// Rust CallableEffectFact::display_name and CallableEffectsFact.
CallableEffectFact: enum {
    Named(name: String, source: SourceSpan)
    ViaParameter(name: String, source: SourceSpan)

    display_name: fn(self) -> String Never! {
        if self == {
            .Named(name, _) -> name
            .ViaParameter(name, _) -> "via {name}"
        }
    }
}

CallableEffectsFact: enum {
    Checked(effects: [CallableEffectFact])
    Unavailable(reason: CallableFactUnavailable)
}

// Rust CallableSignatureFact::{effect_names,error_names,error_types,
// failure_contract_name,failure_source_name,policy_names}. Effective failure
// types come from Foundation's checked contract, not parsed display strings.
CallableSignatureFact: struct {
    parameters: [CallableParameterFact]
    return_type: Type?
    effects: CallableEffectsFact
    failure_contract: CallableFactAvailability<FailureContract>
    returned_views: [ViewProvenanceFact]
    policies: [CallablePolicy]
    generic_parameters: CallableFactAvailability<[TypeParam]>
    metadata_producer_status: MetadataProducerStatus

    effect_names: fn(self) -> [String]? Never! {
        if self.effects == {
            .Checked(effects) -> {
                names: loop fact in effects -> fact.display_name()
                Val(names)
            }
            .Unavailable(_) -> None
        }
    }

    error_types: fn(self) -> [Type]? Never! {
        if self.failure_contract == {
            .Checked(contract) -> {
                effective: failure_contract_shown_type(contract)
                errors := [Type]{}
                if effective == .Result(_, error) {
                    // AST::Type::is_never matches only the Named Never variant.
                    if error != (Type.Named{name: "Never"}) -> errors.push(error)
                }
                Val(errors)
            }
            .Unavailable(_) -> None
        }
    }

    error_names: fn(self) -> [String]? Never! {
        if self.error_types() == {
            .Val(errors) -> {
                names: loop error in errors -> type_name(error)
                Val(names)
            }
            .None -> None
        }
    }

    failure_contract_name: fn(self) -> String? Never! {
        if self.failure_contract == {
            .Checked(contract) -> Val(type_name(failure_contract_shown_type(contract)))
            .Unavailable(_) -> None
        }
    }

    failure_source_name: fn(self) -> String? Never! {
        if self.failure_contract == {
            .Checked(contract) -> Val(failure_contract_source(contract))
            .Unavailable(_) -> None
        }
    }

    policy_names: fn(self) -> [String] Never! {
        // AST::CallablePolicy::display; arguments are already checked spellings.
        loop policy in self.policies -> "{policy.name}({policy.arguments.join(", ")})"
    }
}

// Rust ArithmeticOperationFact: operation and lexical policy spans are exact
// parser-owned byte ranges, not token-window estimates.
ArithmeticOperationFact: struct {
    operation: String
    policy: String
    module_path: String
    operation_span: SourceSpan
    scope_span: SourceSpan
}
