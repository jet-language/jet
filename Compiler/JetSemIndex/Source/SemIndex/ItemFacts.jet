// crates/jet-semindex/src/Build.rs:1896–1921,2550–2814: remaining item
// facts in the ONE Items.semindex_collect_item walk; 2821–2900 hover_for_fn.
// The root has already recorded/pushed the item and state-marker references.
// Only that root pops. Imports are Program/CodeModule imports, NOT Item variants;
// S8 owns add_import_alias_definitions1460–1488 over canonical checked name facts.
// S6 owns checked anchors/signatures, S7 slots/ordinals, S20 public conversion.
// Full execution is gated by CP-NAMES/AST handles/C4/S8/S11/S12 and Foundation's
// canonical unit-family expansion/callable projections. Never synthesize them.
use jet_foundation.[
    Item, Program, MIRNameFacts, Func, ExternFn, DeriveBodyItem,
    AccessConvention, ParamZone, CallablePolicy,
    unit_family_distinct_defs, access_sigil, type_name,
    callable_policy_display, func_failure_contract, func_effective_return_type,
    failure_contract_effective_type, failure_contract_source,
]

pub fn semindex_collect_item_facts(db: &SymbolDB, ctx: &WalkCtx, names: MIRNameFacts, program: Program, source: String, item: Item, mp: String) {
    if item == {
        // These six belong to the root's nominal dispatch. Explicit invariant
        // arms keep new AST variants from silently disappearing in a catch-all.
        .Func(_) -> panic("nominal item must be dispatched by semindex_collect_item")
        .Struct(_) -> panic("nominal item must be dispatched by semindex_collect_item")
        .Enum(_) -> panic("nominal item must be dispatched by semindex_collect_item")
        .Trait(_) -> panic("nominal item must be dispatched by semindex_collect_item")
        .Tag(_) -> panic("nominal item must be dispatched by semindex_collect_item")
        .Impl(_) -> panic("nominal item must be dispatched by semindex_collect_item")
        // These four are intentional original Rust no-index branches, not gates.
        .EffectDecl(_) -> {}
        .CModule(_) -> {}
        .ErrorConv(_) -> {}
        .Migration(_) -> {}
        .MarkerDecl(value) -> {
            &db.defs.push(SymDef{identity: "rule:{ctx.scope_identity}::{value.name}", name: value.name, def_span: value.name_span, module_path: mp, kind: .Type{derives: [String]{}}})
        }
        .FactDecl(value) -> {
            &db.defs.push(SymDef{identity: "fact:{ctx.scope_identity}::{value.name}", name: value.name, def_span: value.name_span, module_path: mp, kind: .Type{derives: [String]{}}})
        }
        .Const(value) -> {
            &db.defs.push(SymDef{identity: "const:{ctx.scope_identity}::{value.name}", name: value.name, def_span: value.name_span, module_path: mp, kind: .Const})
            &db.hover.push(HoverEntry{span: value.name_span, module_path: mp, text: "const `{value.name}`"})
            semindex_structural_slot(&db, &ctx, "value", .Scalar, (db: &SymbolDB, ctx: &WalkCtx) -> {
                semindex_collect_expr(&db, &ctx, names, program, source, value.value, mp)
            })
        }
        .Test(value) -> {
            semindex_structural_slot(&db, &ctx, "body", .List, (db: &SymbolDB, ctx: &WalkCtx) -> {
                semindex_collect_stmts(&db, &ctx, names, program, source, value.body, mp)
            })
        }
        .ExternRust(block) -> {
            // rust_path is bridge metadata, never a source navigation target.
            loop function in block.functions -> &db.defs.push(SymDef{identity: "fn:{ctx.scope_identity}::{function.name}", name: function.name, def_span: function.name_span, module_path: mp, kind: semindex_extern_callable_kind(function, source)})
        }
        .Module(value) -> {
            &db.defs.push(SymDef{identity: semindex_module_identity(ctx.scope_identity, value.name), name: value.name, def_span: value.name_span, module_path: mp, kind: .Module})
        }
        .CodeModule(value) -> {
            identity :: if value.instance_identity == {
                .Val(instance) -> "instance:{instance.fingerprint}"
                None -> semindex_module_identity(ctx.scope_identity, value.name)
            }
            &db.defs.push(SymDef{identity: identity, name: value.name, def_span: value.name_span, module_path: mp, kind: .Module})
            if value.body == .Val(body) {
                previous :: ctx.scope_identity
                ctx.scope_identity = identity
                semindex_structural_slot(&db, &ctx, "items", .List, (db: &SymbolDB, ctx: &WalkCtx) -> {
                    loop child in body -> semindex_collect_item(&db, &ctx, names, program, source, child, mp)
                })
                ctx.scope_identity = previous
            }
        }
        .Distinct(value) -> {
            derives := [String]{}
            loop derive in value.derives -> &derives.push(derive.name)
            &db.defs.push(SymDef{identity: semindex_type_identity(ctx.scope_identity, value.name), name: value.name, def_span: value.name_span, module_path: mp, kind: .Type{derives: derives}})
            semindex_structural_slot(&db, &ctx, "base", .Scalar, (db: &SymbolDB, ctx: &WalkCtx) -> {
                _ := semindex_record_node(&db, ctx, "type", "type", mp, value.base_span)
            })
        }
        .TypeAlias(value) -> {
            &db.defs.push(SymDef{identity: semindex_type_identity(ctx.scope_identity, value.name), name: value.name, def_span: value.name_span, module_path: mp, kind: .Type{derives: [String]{}}})
            semindex_structural_slot(&db, &ctx, "target", .Scalar, (db: &SymbolDB, ctx: &WalkCtx) -> {
                _ := semindex_record_node(&db, ctx, "type", "type", mp, value.target_span)
            })
        }
        .UnitFamily(value) -> {
            &db.defs.push(SymDef{identity: semindex_type_identity(ctx.scope_identity, value.family), name: value.family, def_span: value.family_span, module_path: mp, kind: .Type{derives: [String]{}}})
            // Canonical Foundation expansion includes affine Point/Delta and
            // core.units Time's fixed-carrier exception; no local sugar/provider.
            loop definition in unit_family_distinct_defs(value) {
                derives := [String]{}
                loop derive in definition.derives -> &derives.push(derive.name)
                &db.defs.push(SymDef{identity: semindex_type_identity(ctx.scope_identity, definition.name), name: definition.name, def_span: definition.name_span, module_path: mp, kind: .Type{derives: derives}})
            }
            loop member in value.members -> &db.defs.push(SymDef{identity: "unit:{ctx.scope_identity}::{member.name}", name: member.name, def_span: member.name_span, module_path: mp, kind: .Const})
        }
        .ProtocolDecl(value) -> {
            &db.defs.push(SymDef{identity: semindex_type_identity(ctx.scope_identity, value.name), name: value.name, def_span: value.name_span, module_path: mp, kind: .Type{derives: [String]{}}})
            loop message in value.messages -> &db.defs.push(SymDef{identity: "protocol:{ctx.scope_identity}::{message.name}", name: message.name, def_span: message.name_span, module_path: mp, kind: .EnumVariant{parent: value.name}})
        }
        .UserDerive(value) -> {
            &db.refs.push(semindex_scoped_ref(&db, ctx, names, value.trait_name, value.trait_span, mp))
            semindex_structural_slot(&db, &ctx, "body", .List, (db: &SymbolDB, ctx: &WalkCtx) -> {
                loop body_item in value.body {
                    if body_item == {
                        .Item(child) -> semindex_collect_item(&db, &ctx, names, program, source, child, mp)
                        .Stmt(statement) -> semindex_collect_stmt(&db, &ctx, names, program, source, statement, mp)
                        .Loop(_, _, expression, body, _) -> {
                            semindex_collect_expr(&db, &ctx, names, program, source, expression, mp)
                            loop nested in body -> semindex_collect_template_body_item(&db, &ctx, names, program, source, nested, mp)
                        }
                    }
                }
            })
        }
        .TemplateLoop(value) -> {
            semindex_structural_slot(&db, &ctx, "source", .Scalar, (db: &SymbolDB, ctx: &WalkCtx) -> {
                semindex_collect_expr(&db, &ctx, names, program, source, value.source, mp)
            })
            semindex_structural_slot(&db, &ctx, "body", .List, (db: &SymbolDB, ctx: &WalkCtx) -> {
                loop body_item in value.body -> semindex_collect_template_body_item(&db, &ctx, names, program, source, body_item, mp)
            })
        }
        .GenericModule(value) -> {
            &db.defs.push(SymDef{identity: semindex_module_identity(ctx.scope_identity, value.name), name: value.name, def_span: value.name_span, module_path: mp, kind: .Module})
        }
        .ModuleAlias(value) -> {
            &db.defs.push(SymDef{identity: semindex_module_identity(ctx.scope_identity, value.name), name: value.name, def_span: value.name_span, module_path: mp, kind: .Module})
        }
    }
}

// Rust2759–2779/2788–2794 deliberately stop at a nested Loop's source. This is
// not a recursive derive expander: checked expansion belongs to Sema.
fn semindex_collect_template_body_item(db: &SymbolDB, ctx: &WalkCtx, names: MIRNameFacts, program: Program, source: String, body_item: DeriveBodyItem, mp: String) {
    if body_item == {
        .Item(child) -> semindex_collect_item(&db, &ctx, names, program, source, child, mp)
        .Stmt(statement) -> semindex_collect_stmt(&db, &ctx, names, program, source, statement, mp)
        .Loop(_, _, expression, _, _) -> semindex_collect_expr(&db, &ctx, names, program, source, expression, mp)
    }
}

// Rust2577–2628: only the wrapper signature, all params including authored self.
// Source defaults are unevaluated S6 byte spans; generic/failure facts unavailable
// at the original Typed stage, not fabricated checked-empty values.
fn semindex_extern_callable_kind(function: ExternFn, source: String) -> SymKind Never! {
    params := [SymNameType]{}
    sources := [SourceSpan]{}
    access := [AccessConvention]{}
    loop parameter in function.params {
        &params.push(SymNameType{name: parameter.name, ty: parameter.ty})
        &sources.push(semindex_source_span(parameter.name_span))
        &access.push(parameter.convention)
    }
    SymKind.Function{
        params: params, param_sources: sources, signature_facts_available: true,
        param_contract: semindex_parameter_contract(function.params),
        param_variadic: semindex_parameter_variadic(function.params),
        return_type: function.return_type,
        failure_contract: .Unavailable{reason: CallableFactUnavailable{required_stage: .Typed, reason: "extern Jet boundary has no checked failure contract"}},
        foreign_boundary: true, effects: None, effect_via: None,
        param_access: access, param_defaults: semindex_parameter_defaults(function.params, source, false),
        policies: [CallablePolicy]{},
        generic_parameters: .Unavailable{reason: CallableFactUnavailable{required_stage: .Typed, reason: "extern declarations expose no generic parameter facts"}},
    }
}

// Rust hover_for_fn2821–2900. Unlike fn_signature, retain the effective return
// before the arrow, explicit empty -[]> and every declared effect (even Mem/Panic).
pub fn semindex_hover_for_fn(function: Func) -> String Never! {
    parts := [String]{}
    star_done := false
    loop index in 0..<function.params.len() {
        parameter :: function.params[index]
        if parameter.name == "self" -> next
        if parameter.zone == .LabelOnly && !star_done {
            star_done = true
            &parts.push("*")
        }
        head :: if parameter.zone == .PositionalOnly -> parameter.name else if parameter.public_label == {
            .Val(label) -> "{label.name} {parameter.name}"
            None -> parameter.name
        }
        default :: if parameter.default != None -> "{{…}}" else -> ""
        rest :: if parameter.variadic -> "..." else -> ""
        &parts.push("{access_sigil(parameter.convention)}{head}: {rest}{type_name(parameter.ty)}{default}")
        if parameter.zone == .PositionalOnly {
            following := index + 1
            loop following < function.params.len() && function.params[following].name == "self" -> following += 1
            if following >= function.params.len() || function.params[following].zone != .PositionalOnly -> &parts.push("/")
        }
    }
    arrow := ""
    if function.effect_via == {
        .Val(via) -> arrow = " -[via {via.name}]>"
        None -> {
            if function.declared_effects == .Val(row) {
                effects := [String]{}
                loop fact in row -> &effects.push(fact.name)
                arrow = " -[{effects.join(", ")}]>"
            }
        }
    }
    policies := [String]{}
    loop policy in semindex_callable_policies(function) -> &policies.push(callable_policy_display(policy))
    chain :: policies.join(", ")
    policy_text :: if chain != "" -> " ; policies=[{chain}]" else -> ""
    failure :: func_failure_contract(function)
    "fn {function.name}({parts.join(", ")}) {type_name(func_effective_return_type(function))}{arrow}{policy_text}\nfailure: {type_name(failure_contract_effective_type(failure))} ({failure_contract_source(failure)})"
}
