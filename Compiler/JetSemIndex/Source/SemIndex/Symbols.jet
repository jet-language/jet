//RS /// The smallest node (optionally only item nodes) whose span encloses
//RS /// `start..end`; among equal sizes, the earliest structural node.
//RS fn smallest_enclosing<'n>(
//RS     nodes: impl Iterator<Item = &'n StructuralNode>,
//RS     start: usize,
//RS     end: usize,
//RS     items_only: bool,
//RS ) -> Option<usize> {
//RS     nodes
//RS         .filter(|node| {
//RS             (!items_only || node.class == "item")
//RS                 && node.span.start <= start
//RS                 && end <= node.span.end
//RS         })
//RS         .min_by_key(|node| (node.span.end.saturating_sub(node.span.start), node.id))
//RS         .map(|node| node.id)
//RS }
//RS 
//RS fn is_lexical_slot(slot: &str) -> bool {
//RS     slot == "body" || slot.ends_with("_body") || slot.ends_with("_bodies")
//RS }
