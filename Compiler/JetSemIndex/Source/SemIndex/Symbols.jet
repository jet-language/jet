//RS /// Structural lookups behind the lexical scope of each local and parameter,
//RS /// built once per symbol index. A scan of every structural node per
//RS /// definition made the index quadratic in program size; here each definition
//RS /// costs the number of nodes that overlap its start.
//RS struct LexicalScopeIndex<'a> {
//RS     db: &'a SymbolDB,
//RS     /// (module, def start, def end) to the smallest enclosing node and the
//RS     /// smallest enclosing item node. Ties go to the earlier node.
//RS     enclosing: HashMap<(&'a str, usize, usize), (Option<usize>, Option<usize>)>,
//RS     /// (module, parent) to the parent's first child in a lexical slot.
//RS     first_lexical_child: HashMap<(&'a str, usize), &'a StructuralNode>,
//RS     /// (module, parent, slot) to the first matching slot boundary.
//RS     boundaries: HashMap<(&'a str, usize, &'a str), SourceSpan>,
//RS }
//RS 
//RS impl<'a> LexicalScopeIndex<'a> {
//RS     fn new(db: &'a SymbolDB) -> Self {
//RS         let mut queries: HashMap<&'a str, Vec<(usize, usize)>> = HashMap::new();
//RS         for def in &db.defs {
//RS             if matches!(def.kind, SymKind::Local { .. } | SymKind::Param { .. }) {
//RS                 let span: SourceSpan = def.def_span.into();
//RS                 queries
//RS                     .entry(def.module_path.as_str())
//RS                     .or_default()
//RS                     .push((span.start, span.end));
//RS             }
//RS         }
//RS         let mut module_nodes: HashMap<&'a str, Vec<&'a StructuralNode>> = HashMap::new();
//RS         let mut first_lexical_child = HashMap::new();
//RS         for node in &db.nodes {
//RS             let module = node.module_path.as_str();
//RS             if !queries.contains_key(module) {
//RS                 continue;
//RS             }
//RS             module_nodes.entry(module).or_default().push(node);
//RS             if let Some(parent) = node.parent {
//RS                 if is_lexical_slot(&node.slot) {
//RS                     first_lexical_child.entry((module, parent)).or_insert(node);
//RS                 }
//RS             }
//RS         }
//RS         let mut boundaries = HashMap::new();
//RS         for boundary in &db.slot_boundaries {
//RS             boundaries
//RS                 .entry((
//RS                     boundary.module_path.as_str(),
//RS                     boundary.parent,
//RS                     boundary.slot.as_str(),
//RS                 ))
//RS                 .or_insert(boundary.span);
//RS         }
//RS         let mut enclosing = HashMap::new();
//RS         for (module, mut spans) in queries {
//RS             spans.sort_unstable();
//RS             spans.dedup();
//RS             let mut nodes = module_nodes.remove(module).unwrap_or_default();
//RS             // Stable sort: equal starts keep structural order.
//RS             nodes.sort_by_key(|node| node.span.start);
//RS             let mut next = 0;
//RS             // Nodes that start at or before the current definition and have
//RS             // not ended before it; definitions arrive in start order, so a
//RS             // node that ends before one can never enclose a later one.
//RS             let mut active: Vec<&StructuralNode> = Vec::new();
//RS             for (start, end) in spans {
//RS                 while next < nodes.len() && nodes[next].span.start <= start {
//RS                     active.push(nodes[next]);
//RS                     next += 1;
//RS                 }
//RS                 active.retain(|node| node.span.end >= start);
//RS                 let found = if end < start {
//RS                     // A reversed span can sit inside a node that ended
//RS                     // before its start; answer it from every module node.
//RS                     (
//RS                         smallest_enclosing(nodes.iter().copied(), start, end, false),
//RS                         smallest_enclosing(nodes.iter().copied(), start, end, true),
//RS                     )
//RS                 } else {
//RS                     (
//RS                         smallest_enclosing(active.iter().copied(), start, end, false),
//RS                         smallest_enclosing(active.iter().copied(), start, end, true),
//RS                     )
