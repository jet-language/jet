// The structural audit between two indexes of one program: which
// declarations a revision added, removed, or changed the structural
// signature of. A declaration is matched by its human identity
// (`fn:audit.score`), and it changed when its `signature_id` did. A move, a
// body edit or a reformat alone never changes a signature id.

// Each list holds positions into a `definition_facts` list, sorted by human
// identity: `added` and `changed` into the later index's, `removed` into the
// earlier one's. A repeated identity keeps its first fact.
SemStructuralAudit: struct {
    added: [Int],
    removed: [Int],
    changed: [Int],
}

semindex_structural_audit: fn(before: SemIndex, after: SemIndex) -> SemStructuralAudit Never! {
    earlier := [String:Int]{}
    loop (at, fact) in before.definition_facts {
        if earlier.get(fact.human_identity) == None -> earlier[fact.human_identity] = at
    }
    later := [String:Int]{}
    loop (at, fact) in after.definition_facts {
        if later.get(fact.human_identity) == None -> later[fact.human_identity] = at
    }
    audit := SemStructuralAudit{added: [Int]{}, removed: [Int]{}, changed: [Int]{}}
    loop (at, fact) in after.definition_facts {
        if later.get(fact.human_identity) != Val(at) -> next
        if earlier.get(fact.human_identity) == {
            .Val(previous) -> if before.definition_facts[previous].signature_id != fact.signature_id -> audit.changed.push(at)
            .None -> audit.added.push(at)
        }
    }
    loop (at, fact) in before.definition_facts {
        if (earlier.get(fact.human_identity) ?? -1) == at && later.get(fact.human_identity) == None -> audit.removed.push(at)
    }
    audit.added.sort_by(fn(left: Int, right: Int) { after.definition_facts[left].human_identity <=> after.definition_facts[right].human_identity })
    audit.changed.sort_by(fn(left: Int, right: Int) { after.definition_facts[left].human_identity <=> after.definition_facts[right].human_identity })
    audit.removed.sort_by(fn(left: Int, right: Int) { before.definition_facts[left].human_identity <=> before.definition_facts[right].human_identity })
    audit
}
