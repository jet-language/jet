use jet_foundation.[Span]

// Rust SourceSpan and From<Span>/From<SourceSpan>. UTF-8 byte coordinates with
// an exclusive end, not character indices. Conversion is lossless even for
// empty, reversed, or unchecked coordinates.
SourceSpan: struct {
    start: Int
    end: Int
}
semindex_source_span: fn(span: Span) -> SourceSpan Never! {
    SourceSpan{start: span.start, end: span.end}
}
semindex_foundation_span: fn(span: SourceSpan) -> Span Never! {
    Span{start: span.start, end: span.end}
}
