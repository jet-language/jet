use jet_foundation.[
    StatusEnvelope,
    StatusFields,
    StatusValue,
    ReportError,
    derivation_record_status_value,
    foundation_json_quote,
    status_value_from_json_number_atom,
]
use jet_pkg_model.[pkg_effect_projection_status_value]

// Rust JSON.rs:1045–1118: the canonical inspect.semindex status boundary.
// Schema VERSION 20 has the actual fifteen payload fields below, plus expand
// only when requested. Nodes/bypasses are not extra top-level wire fields.
// S17/S18 and Foundation own every nested codec; no escaped/raw JSON field,
// no payload reparse, no index getter copies and no local report model.
impl SemIndex {
    pub fn to_json(self) -> String Never! { self.to_status_envelope().json() }

    pub fn to_status_envelope(self) -> StatusEnvelope Never! {
        StatusEnvelope.new("inspect.semindex", true).with_field("semindex", StatusValue.Object{fields: self.status_payload_fields()})
    }

    pub fn to_status_envelope_with_expand(self, expand: ExpandProjection) -> StatusEnvelope Never! {
        fields :: self.status_payload_fields()
        value :: semindex_status_expand_projection(expand) ?? panic("semindex payload must be valid JSON")
        StatusEnvelope.new("inspect.semindex", true).with_field("semindex", StatusValue.Object{fields: ^fields.with("expand", value)})
    }

    // The Rust private inner helper's base assembly. Keep optional expansion
    // outside this helper: Val(read ExpandProjection) would clone its graph
    // rather than represent Rust's Option<&ExpandProjection> (#4462).
    // This is the full fifteen-field inspect payload, not the distinct
    // twelve-field CompilerSemanticIndex projection owned by the compiler.
    fn status_payload_fields(self) -> StatusFields Never! {
        definitions := [StatusValue]{}
        loop row in self.definitions() -> &definitions.push(semindex_status_def(row))
        definition_facts := [StatusValue]{}
        loop row in self.definition_facts() -> &definition_facts.push(semindex_status_definition_fact(row))
        derivations := [StatusValue]{}
        loop row in self.derivations() -> &derivations.push(derivation_record_status_value(row))
        instances := [StatusValue]{}
        loop row in self.instances() -> &instances.push(semindex_status_instance(row))
        outputs := [StatusValue]{}
        loop row in self.outputs() -> &outputs.push(semindex_status_output(row))
        state_graphs := [StatusValue]{}
        loop row in self.state_graphs() -> &state_graphs.push(semindex_status_state_graph(row))
        package :: if self.package_facts == {
            .Val(row) -> package_facts_status_value(row) ?? panic("semindex payload must be valid JSON")
            .None -> StatusValue.Null
        }
        overlays :: if self.workspace_overlay_policy == {
            .Val(row) -> workspace_overlay_policy_status_value(row) ?? panic("semindex payload must be valid JSON")
            .None -> StatusValue.Null
        }
        references := [StatusValue]{}
        loop row in self.references() -> &references.push(semindex_status_ref(row))
        calls := [StatusValue]{}
        loop row in self.call_edges() -> &calls.push(semindex_status_call(row))
        effects := [StatusValue]{}
        loop row in self.effects() -> &effects.push(semindex_status_effect(row))
        arithmetic := [StatusValue]{}
        loop row in self.arithmetic() -> &arithmetic.push(semindex_status_arithmetic(row))
        members := [StatusValue]{}
        loop row in self.members() -> &members.push(semindex_status_member(row))
        fields := StatusFields.new()
            .with("schema_version", StatusValue.Integer{value: self.schema_version()})
            .with("definitions", StatusValue.Array{values: definitions})
            .with("definition_facts", StatusValue.Array{values: definition_facts})
            .with("derivations", StatusValue.Array{values: derivations})
            .with("instances", StatusValue.Array{values: instances})
            .with("outputs", StatusValue.Array{values: outputs})
            .with("state_graphs", StatusValue.Array{values: state_graphs})
            .with("package_facts", package)
            .with("workspace_overlays", overlays)
            .with("effect_projection", pkg_effect_projection_status_value(self.effect_projection))
            .with("references", StatusValue.Array{values: references})
            .with("calls", StatusValue.Array{values: calls})
            .with("effects", StatusValue.Array{values: effects})
            .with("arithmetic", StatusValue.Array{values: arithmetic})
            .with("members", StatusValue.Array{values: members})
        fields
    }
}

// Typed counterpart of JSON1121–1169. Canonical StatusFields insertion
// preserves order and refuses duplicate object keys as Rust Report245 does.
// Raw helper bytes below preserve duplicates; envelope conversion does NOT
// collapse them through a Core map and does NOT escape/reparse those bytes.
pub fn semindex_status_expand_projection(projection: ExpandProjection) -> StatusValue ReportError! {
    lenses := [StatusValue]{}
    loop lens in projection.lenses {
        facts := [StatusValue]{}
        loop fact in lens.facts -> &facts.push(semindex_status_expand_value(fact))
        fields :: StatusFields.new()
            .with("name", StatusValue.String{value: lens.name})
            .with("summary", StatusValue.String{value: lens.summary})
            .with("facts", StatusValue.Array{values: facts})
        &lenses.push(StatusValue.Object{fields: fields})
    }
    Ok(StatusValue.Object{fields: StatusFields.new()
        .with("selection", StatusValue.String{value: projection.selection})
        .with("lenses", StatusValue.Array{values: lenses})})
}

pub fn semindex_status_expand_value(value: ExpandValue) -> StatusValue ReportError! {
    if value == {
        .Null -> Ok(StatusValue.Null)
        .Bool(flag) -> Ok(StatusValue.Bool{value: flag})
        .Number(number) -> status_value_from_json_number_atom("{number}")
        .String(text) -> Ok(StatusValue.String{value: text})
        .Array(values) -> {
            rows := [StatusValue]{}
            loop row in values -> &rows.push(semindex_status_expand_value(row))
            Ok(StatusValue.Array{values: rows})
        }
        .Object(entries) -> {
            fields := StatusFields.new()
            loop index in semindex_expand_object_order(entries) {
                &fields.insert(entries[index].key, semindex_status_expand_value(entries[index].value))
            }
            Ok(StatusValue.Object{fields: fields})
        }
    }
}

// Rust JSON.rs:1121–1169 json_expand_projection/json_expand_value. Objects
// stable-sort by key only, retaining duplicate keys and equal-key input order.
// Sort scalar indices, never clone the recursive fact graph to reorder it.
pub fn semindex_json_expand_projection(projection: ExpandProjection) -> String Never! {
    lenses := [String]{}
    loop lens in projection.lenses {
        facts := [String]{}
        loop fact in lens.facts -> &facts.push(semindex_json_expand_value(fact))
        &lenses.push("{{\"name\":{foundation_json_quote(lens.name)},\"summary\":{foundation_json_quote(lens.summary)},\"facts\":[{facts.join(",")}]}}")
    }
    "{{\"selection\":{foundation_json_quote(projection.selection)},\"lenses\":[{lenses.join(",")}]}}"
}

pub fn semindex_json_expand_value(value: ExpandValue) -> String Never! {
    if value == {
        .Null -> "null"
        .Bool(flag) -> if flag -> "true" else -> "false"
        .Number(number) -> "{number}"
        .String(text) -> foundation_json_quote(text)
        .Array(values) -> {
            rows := [String]{}
            loop row in values -> &rows.push(semindex_json_expand_value(row))
            "[{rows.join(",")}]"
        }
        .Object(entries) -> {
            rows := [String]{}
            loop index in semindex_expand_object_order(entries) {
                &rows.push("{foundation_json_quote(entries[index].key)}:{semindex_json_expand_value(entries[index].value)}")
            }
            "{{{rows.join(",")}}}"
        }
    }
}

fn semindex_expand_object_order(entries: [ExpandObjectEntry]) -> [Int] Never! {
    order := [Int]{}
    loop index in 0..<entries.len() -> &order.push(index)
    &order.sort_by((left: Int, right: Int) -> entries[left].key <=> entries[right].key)
    order
}
