// crates/jet-semindex/src/Docs.rs:1–294,1487–1567. Sole documentation
// schema, checked source-graph ordering and parent source/identity helpers.
// S22 owns row JSON/status codecs and Markdown/HTML; S23 owns the exhaustive
// Item collector; S24 owns checked contract enrichment and doctest extraction.
// The caller retains the original loaded_module_rows from the checked result.
// Registration-only Prelude/native rows do not belong to the documentation
// bundle. Native project_root/physical_path are loader facts, never cwd or a
// display-text re-resolution. Authored bytes come from loaded_source, not the
// registration's comptime-masked source.
use core.text as doc_text
use core.files.runtime.kernel_path_components as doc_os_path
use jet_foundation.[Span, StatusEnvelope, StatusFields, StatusValue, foundation_json_quote]
use jet_sema.[SemaCompilerModuleSource, SemaRegistrationGraph]
use jet_pkg_model.[EffectProjection, pkg_effect_projection_status_value, pkg_render_effect_projection_object]

pub DOC_SCHEMA_VERSION :: 1

pub struct DocSource {
    pub path: String
    pub start: Int
    pub end: Int
    pub line: Int
    pub column: Int
    pub link: String
}
pub struct DocItem {
    pub kind: String
    pub name: String
    pub qualified_name: String
    // `module` is a Jet keyword; the wire key remains exactly "module".
    pub module_path: String
    pub public: Bool
    pub package_public: Bool
    pub signature: String
    // None is intentional for non-callables, not a checked-empty contract.
    pub failure_contract: String?
    pub failure_source: String?
    pub summary: String
    pub examples: [String]
    pub markers: [String]
    pub source: DocSource
}
pub struct DocModule {
    pub name: String
    pub path: String
    pub public: Bool
    pub summary: String
    pub source: DocSource
}
pub struct DocImpl {
    pub kind: String
    pub type_name: String
    pub trait_name: String?
    pub module_path: String
    pub public: Bool
    pub methods: [String]
    pub source: DocSource
}
pub struct DocExpectation {
    pub expression: String
    pub expected: String
}
pub struct DocTest {
    pub module_path: String
    pub line: Int
    pub setup: [String]
    pub expectations: [DocExpectation]
    pub source: DocSource
}
pub struct DocGraph {
    pub schema_version: Int
    pub root: String
    // The same application-boundary projection as inspect; never re-solve it.
    pub effect_projection: EffectProjection
    pub modules: [DocModule]
    pub items: [DocItem]
    pub impls: [DocImpl]
    pub doctests: [DocTest]
}

// Identity joins select checked AST rows, never a positional source/name zip.
// Loaded metadata retains Core displays/aliases/pub_file verbatim. All original
// modules participate in the protocol prepass BEFORE any item collection.
pub fn build_doc_graph(registration: SemaRegistrationGraph, module_sources: [SemaCompilerModuleSource], loaded_module_rows: [Int], project_root: doc_os_path.OsPath?, path_platform: doc_os_path.PathPlatform, index: SemIndex) -> DocGraph Never! {
    protocol_names := [String:Bool]{}
    loop source_index in loaded_module_rows {
        module_index :: doc_loaded_registration_index(registration, module_sources[source_index])
        doc_collect_protocol_names(registration.modules[module_index].program.items, &protocol_names)
    }
    graph := DocGraph{
        schema_version: DOC_SCHEMA_VERSION,
        root: doc_stable_root(project_root),
        effect_projection: ~index.effect_projection,
        modules: [DocModule]{}, items: [DocItem]{},
        impls: [DocImpl]{}, doctests: [DocTest]{},
    }
    loop source_index in loaded_module_rows {
        loaded :: module_sources[source_index]
        module_index :: doc_loaded_registration_index(registration, loaded)
        registered :: registration.modules[module_index]
        source :: loaded.loaded_source
        path :: doc_stable_module_path(project_root, loaded.physical_path, loaded.display)
        &graph.modules.push(DocModule{
            name: doc_module_name(path, loaded.alias, path_platform), path: path,
            public: loaded.pub_file,
            summary: doc_leading_summary(source),
            source: doc_source_for(project_root, loaded.physical_path, loaded.display, source, Span{start: 0, end: 0}),
        })
        tests := doc_discover_doctests(project_root, loaded.physical_path, loaded.display, source, path)
        &tests.reverse()
        loop tests.len() > 0 {
            test :: &tests.pop() ?? panic("nonempty documentation tests")
            &graph.doctests.push(^test)
        }
        doc_collect_items(registered.program.items, path, "", loaded.pub_file, loaded.physical_path, loaded.display, source, project_root, protocol_names, &graph.items, &graph.impls)
    }
    doc_enrich_callable_contracts(&graph.items, index, module_sources, loaded_module_rows, project_root)
    doc_enrich_type_contracts(&graph.items, index, module_sources, loaded_module_rows, project_root)
    doc_sort_modules(&graph.modules)
    doc_sort_items(&graph.items)
    doc_sort_impls(&graph.impls)
    doc_sort_tests(&graph.doctests)
    graph
}
fn doc_loaded_registration_index(registration: SemaRegistrationGraph, source: SemaCompilerModuleSource) -> Int Never! {
    registration.module_rows.get(source.module_identity) ?? panic("loaded documentation module must be registered")
}

// Stable rendering order is separate from checked module/source collection
// order. Equal keys keep authored order (the native stable list sort).
pub fn doc_sort_modules(rows: &[DocModule]) Never! {
    &rows.sort_by((left: DocModule, right: DocModule) -> (left.path <=> right.path).then(left.name <=> right.name))
}
pub fn doc_sort_items(rows: &[DocItem]) Never! {
    &rows.sort_by((left: DocItem, right: DocItem) -> (left.module_path <=> right.module_path).then(left.qualified_name <=> right.qualified_name).then(doc_kind_rank(left.kind) <=> doc_kind_rank(right.kind)).then(left.source.start <=> right.source.start))
}
pub fn doc_sort_impls(rows: &[DocImpl]) Never! {
    &rows.sort_by((left: DocImpl, right: DocImpl) -> (left.module_path <=> right.module_path).then(left.type_name <=> right.type_name).then(doc_trait_name_order(left.trait_name, right.trait_name)).then(left.source.start <=> right.source.start))
}
pub fn doc_sort_tests(rows: &[DocTest]) Never! {
    &rows.sort_by((left: DocTest, right: DocTest) -> (left.module_path <=> right.module_path).then(left.line <=> right.line))
}
// Rust Option orders None before Some; Jet's enum declaration order is not
// that contract. Match the optional strings explicitly, without cloning them.
fn doc_trait_name_order(left: String?, right: String?) -> Ordering Never! {
    if left == {
        .Val(left_name) -> if right == {
            .Val(right_name) -> left_name <=> right_name
            None -> 1 <=> 0
        }
        None -> if right == {
            .Val(_) -> 0 <=> 1
            None -> 0 <=> 0
        }
    }
}

impl DocGraph {
    // Owner-backed one-row windows; never clone documented item vectors.
    fn item_window(self, index: Int) -> View<DocItem> Never! { self.items[index..index] }
    pub fn undocumented_public(self) -> [View<DocItem>] Never! {
        rows := [View<DocItem>]{}
        loop index in 0..<self.items.len() {
            if self.items[index].public && self.items[index].summary == "" -> &rows.push(self.item_window(index))
        }
        rows
    }

    // Rust to_status_envelope: one typed canonical Foundation report.
    // No local value model or parse of our own JSON.
    // Foundation owns constructor/with_field visibility (CP-REPORT-STATUS-API).
    pub fn to_status_envelope(self) -> StatusEnvelope Never! {
        projection :: pkg_effect_projection_status_value(self.effect_projection)
        modules := [StatusValue]{}
        loop row in self.modules -> &modules.push(doc_module_value(row))
        items := [StatusValue]{}
        loop row in self.items -> &items.push(doc_item_value(row))
        impls := [StatusValue]{}
        loop row in self.impls -> &impls.push(doc_impl_value(row))
        tests := [StatusValue]{}
        loop row in self.doctests -> &tests.push(doc_test_value(row))
        doc :: StatusFields.new()
            .with("schema_version", StatusValue.Integer{value: self.schema_version})
            .with("root", StatusValue.String{value: ~self.root})
            .with("effect_projection", projection)
            .with("modules", StatusValue.Array{values: ^modules})
            .with("items", StatusValue.Array{values: ^items})
            .with("impls", StatusValue.Array{values: ^impls})
            .with("doctests", StatusValue.Array{values: ^tests})
        StatusEnvelope.new("inspect.doc", true).with_field("doc", StatusValue.Object{fields: doc})
    }

    // Raw artifact JSON, NOT the command's jet.status/v1 envelope. Explicit
    // field order and canonical Foundation quote, not RFC8785 canonicalization.
    pub fn to_json(self) -> String Never! {
        modules := [String]{}
        loop row in self.modules -> &modules.push(doc_module_json(row))
        items := [String]{}
        loop row in self.items -> &items.push(doc_item_json(row))
        impls := [String]{}
        loop row in self.impls -> &impls.push(doc_impl_json(row))
        tests := [String]{}
        loop row in self.doctests -> &tests.push(doc_test_json(row))
        projection :: pkg_render_effect_projection_object(self.effect_projection)
        "{{\"schema_version\":{self.schema_version},\"root\":{foundation_json_quote(self.root)},\"effect_projection\":{projection},\"modules\":[{modules.join(",")}],\"items\":[{items.join(",")}],\"impls\":[{impls.join(",")}],\"doctests\":[{tests.join(",")}]}}"
    }
}
pub fn doc_status_strings(values: [String]) -> StatusValue Never! {
    rows := [StatusValue]{}
    loop value in values -> &rows.push(StatusValue.String{value: ~value})
    StatusValue.Array{values: ^rows}
}

// Parent helper family shared by S23 and S24. Byte spans/columns stay Rust
// UTF8 byte counts, independently of Jet's scalar-indexed String.slice.
pub fn doc_source_for(root: doc_os_path.OsPath?, file_path: doc_os_path.OsPath?, display_path: String, source: String, span: Span) -> DocSource Never! {
    path :: doc_stable_module_path(root, file_path, display_path)
    bytes :: source.bytes()
    start :: if span.start < bytes.len() -> span.start else -> bytes.len()
    clipped_end :: if span.end < bytes.len() -> span.end else -> bytes.len()
    end :: if clipped_end > start -> clipped_end else -> start
    line := 1
    column := 1
    doc_line_column_bytes(bytes, start, &line, &column)
    DocSource{path: path, start: start, end: end, line: line, column: column, link: "{path}#L{line}"}
}
pub fn doc_declaration_text(source: String, span: Span) -> String Never! {
    bytes :: source.bytes()
    start :: if span.start < bytes.len() -> span.start else -> bytes.len()
    clipped_end :: if span.end < bytes.len() -> span.end else -> bytes.len()
    end :: if clipped_end > start -> clipped_end else -> start
    selected := bytes[start..<end] // #4303: byte view flows to String API.
    raw :: String.from_bytes(selected) ?? panic("documentation declaration span must select source text")
    out := [U8]{}
    pending_space := false
    loop index in 0..<raw.len() {
        scalar := raw.slice(index, index + 1) // #4303
        if scalar == "{{" -> break
        if doc_text.is_whitespace(scalar) {
            if out.len() > 0 -> pending_space = true
        } else {
            if pending_space -> &out.push(U8{32})
            loop byte in scalar.bytes() -> &out.push(byte)
            pending_space = false
        }
    }
    String.from_bytes(out) ?? panic("documentation declaration preserves UTF8")
}
pub fn doc_stable_root(root: doc_os_path.OsPath?) -> String Never! { "." }

// Native component identity decides prefix membership BEFORE lossy display.
// Separator replacement is OUTPUT-only, as in Rust Docs. Missing physical
// paths/roots and empty remainders preserve virtual display metadata; no cwd.
pub fn doc_stable_module_path(root: doc_os_path.OsPath?, path: doc_os_path.OsPath?, display: String) -> String Never! {
    if root == .Val(base) {
        if path == .Val(physical) {
            if doc_os_path.strip_prefix_span(physical, base) == .Val(relative_span) {
                if relative_span.start != relative_span.end {
                    relative :: doc_os_path.display_span(physical, relative_span)
                    if relative != "." -> return relative.replace("\\", "/")
                }
            }
        }
    }
    display.replace("\\", "/")
}
// Rust module_name interprets the STABLE OUTPUT spelling, not the physical
// identity: a Unix native `dir\name.jet` renders `dir/name.jet`, named `name`.
// This byte conversion is presentation-only; it never resolves a source or
// participates in root/prefix authority. The caller supplies its retained
// native platform (entry_path.platform even when project_root is None).
pub fn doc_module_name(path: String, alias: String, platform: doc_os_path.PathPlatform) -> String Never! {
    if alias != "" -> return ~alias
    rendered :: doc_os_path.from_encoded(path.bytes(), platform)
    if doc_os_path.file_stem_span(rendered) == .Val(stem) -> return doc_os_path.display_span(rendered, stem)
    ~path
}
pub fn doc_qualified(parent: String, name: String) -> String Never! {
    if parent == "" -> ~name else -> "{parent}::{name}"
}
pub fn doc_kind_rank(kind: String) -> Int Never! {
    if kind == {
        "module" -> 0
        "marker" | "fact" -> 1
        "protocol" | "trait" | "tag" | "effect" -> 2
        "struct" | "enum" | "distinct" | "type_alias" | "unit_family" -> 3
        "field" | "variant" -> 4
        "function" -> 5
        else -> 6
    }
}
// #4357: output receivers retain the Rust pair without an allocated list or
// extra schema record. Columns count UTF8 bytes, NOT Unicode/display cells.
pub fn doc_line_column(source: String, offset: Int, line: &Int, column: &Int) Never! {
    doc_line_column_bytes(source.bytes(), offset, &line, &column)
}
fn doc_line_column_bytes(bytes: [U8], offset: Int, line: &Int, column: &Int) Never! {
    line = 1
    column = 1
    end :: if offset < bytes.len() -> offset else -> bytes.len()
    loop index in 0..<end {
        if bytes[index] == 10 { line += 1; column = 1 } else { column += 1 }
    }
}
pub fn doc_line_offset(source: String, line: Int) -> Int Never! {
    if line <= 1 -> return 0
    bytes :: source.bytes()
    remaining := line - 1
    loop index in 0..<bytes.len() {
        if bytes[index] == 10 {
            remaining -= 1
            if remaining == 0 -> return index + 1
        }
    }
    bytes.len()
}
