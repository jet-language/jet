#!/usr/bin/env jet
// The lexer's keyword spans, made by Compiler/build.jet's `lexer-keywords`
// step: the canonical keyword table (JetLexer/Data/Lexer/Keywords.jet)
// projected onto the Syntax literals (the JetFoundation/Data/Syntax folder)
// as borrowed byte checks, written whole to JetLexer/Source/Lexer/KeywordSpans.jet
// with the table's spellings as two lists (LEXER_KEYWORD_SPELLINGS, the active
// rows, and LEXER_RETIRED_SPELLINGS), which `jet inspect reserved` prints.
// Spellings remain Jet Syntax constants; Tokens.jet TOKEN_* kinds are the
// single source of truth for every token kind number. The step keeps the file
// in git (`kept: true`), so the build rewrites a stale one and refuses a hand
// edit of it.
// Usage (from Compiler/): jet Toolchain/LexerKeywordRows.jet [--check|--write] [--syntax=DIR]
// Paths are relative to the Compiler package, the step's working folder;
// DIR (default JetFoundation/Data/Syntax) is the Syntax folder, which the
// step passes so the build reads it whole.
use {
    json: core.encoding.json
    files: core.files
    process: core.process
}

SPANS_PATH: "JetLexer/Source/Lexer/KeywordSpans.jet"

SYNTAX_DIR: "JetFoundation/Data/Syntax"

KEYWORDS_PATH: "JetLexer/Data/Lexer/Keywords.jet"

TOKENS_PATH: "JetLexer/Source/Lexer/Tokens.jet"

SPANS_HEADER: "// This file is generated by Compiler/Toolchain/LexerKeywordRows.jet, which `jet build Compiler`\n// runs, from Compiler/JetLexer/Data/Lexer/Keywords.jet and the Syntax literals of\n// Compiler/JetFoundation/Data/Syntax; do not edit.\n// It stays committed: the seed builds the compiler from the checkout, and\n// `jet check` reads it before any build step runs.\n// No spelling ownership here: Payload still builds the exact token text.\n"

LINE_COMMENT: Regex{"//[^\n]*"}

// The LEXER_KEYWORDS body: from its opening line to the first line that
// starts with `}`. Matched against the text after a leading newline, so a
// newline marks every line start.
KEYWORD_TABLE: Regex{"\nLEXER_KEYWORDS: \[LexerKeyword\]\{{([\s\S]*?)\n\}}"}

KEYWORD_ARM: Regex{"^(?:LexerKeyword)?\{{constant: \x22(\w+)\x22, kind: \x22(Kw\w+)\x22, tag: \x22(TOKEN_\w+)\x22, retired: (true|false)\}},$"}

// The JET_KEYWORD_LIST body in the Syntax folder (LSP completion and rename
// validation), matched the same way: constant names, comma separated.
KEYWORD_LIST: Regex{"\nJET_KEYWORD_LIST: \[String\]\{{([\s\S]*?)\n\}}"}

// One line each: `NAME: "literal"` with an optional trailing comment, and a
// canonical keyword token kind from Tokens.jet.
SYNTAX_CONSTANT: Regex{"^\s*(\w+)\s*:\s*(\x22(?:[^\x22\\]|\\.)*\x22)[^\S\n]*(?://[^\n]*)?$"}

KEYWORD_TOKEN: Regex{"^(TOKEN_(?:KW_\w+|TRUE|FALSE|SELF|NULL|BREAK|RETURN)): \d+\s*$"}

// Any canonical token kind with its number in Tokens.jet.
TOKEN_NUMBER: Regex{"^TOKEN_(\w+): (\d+)\s*$"}

SPELLING: Regex{"^[A-Za-z][A-Za-z0-9_]*$"}

WORD_BREAK: Regex{"([a-z0-9])([A-Z])"}

#Error
KeywordRowsError: struct {
    message: String,
}

KeywordRow: struct {
    constant: String,
    kind: String,
    tag: String,
    spelling: String,
    bytes: [Int],
    retired: Bool,
}

rows_fail: fn(message: String) -> KeywordRowsError Never! {
    KeywordRowsError{message: "lexer keyword rows: {message}"}
}

// The value of a Jet string literal, read as the JSON string it also is.
literal_value: fn(literal: String) -> String? Never! {
    parsed: json.parse(literal) ?? return None
    if parsed == {
        .Text(text) -> Val(text)
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> None
    }
}

// `KwFn` -> `FN`, `KwSelfType` -> `SELF_TYPE`.
kind_bare: fn(kind: String) -> String Never! {
    WORD_BREAK.replace(kind.remove_prefix("Kw"), "$1_$2").upper()
}

// `TOKEN_KW_FN` -> `FN`, `TOKEN_TRUE` -> `TRUE`.
token_bare: fn(token_name: String) -> String Never! {
    token_name.remove_prefix("TOKEN_").remove_prefix("KW_")
}

keyword_rows: fn(mapping: String, syntax: String, tokens: String) -> [KeywordRow] KeywordRowsError! {
    table: KEYWORD_TABLE.match("\n{LINE_COMMENT.replace(mapping, "")}") ?? return Err(rows_fail("unrecognized LEXER_KEYWORDS table"))
    constants := [String:[String]]{}
    loop line in syntax.split("\n") {
        row: SYNTAX_CONSTANT.match(line) ?? next
        values := constants.get(row.groups[0]) ?? [String]{}
        values.push(row.groups[1])
        constants[row.groups[0].copy()] = values
    }
    token_tags := [String]{}
    loop line in tokens.split("\n") {
        token: KEYWORD_TOKEN.match(line) ?? next
        token_tags.push(token.groups[0])
    }
    distinct := [String]{}
    loop token_tag in token_tags {
        if !distinct.contains(token_tag) -> distinct.push(token_tag)
    }
    if token_tags.len() == 0 || distinct.len() != token_tags.len() {
        return Err(rows_fail("unparsed/ambiguous keyword token kinds"))
    }
    numbers := [String:String]{}
    loop line in tokens.split("\n") {
        token: TOKEN_NUMBER.match(line) ?? next
        name: token.groups[0].remove_prefix("KW_")
        if numbers.get(name) != None {
            return Err(rows_fail("token kinds TOKEN_{name} and TOKEN_KW_{name} share one tag name"))
        }
        numbers[name] = token.groups[1].copy()
    }
    rows := [KeywordRow]{}
    spellings := [String]{}
    kinds := [String]{}
    mapped := [String]{}
    listed := [String]{}
    has_list := false
    if KEYWORD_LIST.match("\n{LINE_COMMENT.replace(syntax, "")}") == .Val(list) {
        has_list = true
        loop line in list.groups[0].split("\n") {
            loop entry in line.split(",") {
                name: entry.trim()
                if name != "" -> listed.push(name)
            }
        }
    }
    loop raw in table.groups[0].split("\n") {
        line: raw.trim()
        if line == "" -> next
        arm: KEYWORD_ARM.match(line) ?? return Err(rows_fail("unparsed keyword row: {line}"))
        constant: arm.groups[0]
        kind: arm.groups[1]
        token_tag: arm.groups[2]
        values: constants.get(constant) ?? [String]{}
        if values.len() != 1 {
            return Err(rows_fail("unresolved/ambiguous literal Syntax.{constant}"))
        }
        spelling: literal_value(values[0]) ?? return Err(rows_fail("unsupported Jet literal Syntax.{constant}"))
        if !SPELLING.is_match(spelling) {
            return Err(rows_fail("unsupported keyword spelling Syntax.{constant}"))
        }
        if kind_bare(kind) != token_bare(token_tag) || !token_tags.contains(token_tag) {
            return Err(rows_fail("unresolved token kind {kind}/{token_tag}"))
        }
        if spellings.contains(spelling) || kinds.contains(kind) || mapped.contains(token_tag) {
            return Err(rows_fail("duplicate keyword spelling/kind {constant}/{kind}"))
        }
        if !has_list -> return Err(rows_fail("no JET_KEYWORD_LIST in the Syntax folder"))
        retired: arm.groups[3] == "true"
        if !retired && !listed.contains(constant) {
            return Err(rows_fail("active keyword {constant} is missing from JET_KEYWORD_LIST"))
        }
        if retired && listed.contains(constant) {
            return Err(rows_fail("retired keyword {constant} is in JET_KEYWORD_LIST"))
        }
        spellings.push(spelling.copy())
        kinds.push(kind.copy())
        mapped.push(token_tag.copy())
        bytes: loop byte in spelling.bytes() -> (Int{byte})
        rows.push(KeywordRow{constant: constant, kind: kind, tag: token_tag, spelling: spelling, bytes: bytes, retired: retired})
    }
    if rows.len() == 0 -> return Err(rows_fail("incomplete keyword mapping/token coverage"))
    loop token_tag in token_tags {
        if !mapped.contains(token_tag) {
            return Err(rows_fail("incomplete keyword mapping/token coverage"))
        }
    }
    Ok(rows)
}

// The rows, read from the Syntax folder `syntax_dir` (its `.jet` files in
// name order) and the keyword table and canonical token kinds.
read_keyword_rows: fn(syntax_dir: String) -[FS]> [KeywordRow] KeywordRowsError! {
    names := [String]{}
    listed: files.list_dir(syntax_dir) ?? return Err(rows_fail("cannot list {syntax_dir}: {err}"))
    loop entry in listed {
        if entry.name.ends_with(".jet") -> names.push(entry.name)
    }
    names.sort()
    parts := [String]{}
    loop name in names {
        parts.push(files.read("{syntax_dir}/{name}") ?? return Err(rows_fail("cannot read {syntax_dir}/{name}: {err}")))
    }
    mapping: files.read(KEYWORDS_PATH) ?? return Err(rows_fail("cannot read the keyword table {KEYWORDS_PATH}: {err}"))
    tokens: files.read(TOKENS_PATH) ?? return Err(rows_fail("cannot read the token kinds {TOKENS_PATH}: {err}"))
    keyword_rows(mapping, parts.join("\n"), tokens)
}

// The value that tells `rows` apart from byte `offset` on, its lines at
// `indent`.
branches: fn(rows: [KeywordRow], offset: Int, indent: String) -> String Never! {
    if rows.len() == 1 {
        row: rows[0]
        if offset == row.bytes.len() -> return "{row.tag}"
        checks := [String]{}
        loop index in offset..<row.bytes.len() {
            checks.push("byte_at(source, start + {index}) == {row.bytes[index]}")
        }
        return "if {checks.join(" && ")} -> {row.tag} else -> TOKEN_IDENT"
    }
    order := [Int]{}
    groups := [Int:[KeywordRow]]{}
    loop row in rows {
        byte: row.bytes[offset]
        group := groups.get(byte) ?? [KeywordRow]{}
        if group.len() == 0 -> order.push(byte)
        group.push(row.copy())
        groups[byte] = group
    }
    order.sort()
    out := "if byte_at(source, start + {offset}) == {{\n"
    loop byte in order {
        group: groups.get(byte) ?? [KeywordRow]{}
        out = "{out}{arm(group, "{byte}", offset + 1, "{indent}    ")}"
    }
    "{out}{indent}    else -> TOKEN_IDENT\n{indent}}}"
}

// The arm `key -> value` for `rows`; an arm that settles one keyword names
// its Syntax constant on the line above, where `jet fmt` keeps a comment.
arm: fn(rows: [KeywordRow], key: String, offset: Int, indent: String) -> String Never! {
    note: if rows.len() == 1 -> "{indent}// Syntax.{rows[0].constant}\n" else -> ""
    "{note}{indent}{key} -> {branches(rows, offset, indent)}\n"
}

// The table's spellings as one generated list: the active rows or the
// retired ones, in table order, one per line.
spelling_list: fn(name: String, rows: [KeywordRow], retired: Bool) -> String Never! {
    out := "{name}: [String]{{\n"
    loop row in rows {
        if row.retired == retired -> out = "{out}    \"{row.spelling}\",\n"
    }
    "{out}}}\n"
}

// KeywordSpans.jet, whole: its header, `word_kind`, and the spelling lists.
render_keyword_spans: fn(rows: [KeywordRow]) -> String Never! {
    order := [Int]{}
    lengths := [Int:[KeywordRow]]{}
    loop row in rows {
        length: row.bytes.len()
        group := lengths.get(length) ?? [KeywordRow]{}
        if group.len() == 0 -> order.push(length)
        group.push(row.copy())
        lengths[length] = group
    }
    order.sort()
    out := "{SPANS_HEADER}word_kind: fn(source: [U8], start: Int, end: Int, previous_kind: Int) -> Int Never! {{\n    kind: if end - start == {{\n"
    loop length in order {
        group: lengths.get(length) ?? [KeywordRow]{}
        out = "{out}{arm(group, "{length}", 0, "        ")}"
    }
    words: "{out}        else -> TOKEN_IDENT\n    }}\n    // Only exact in becomes a member after a postfix dot.\n    if kind == TOKEN_KW_IN && (previous_kind == TOKEN_DOT || previous_kind == TOKEN_QUESTION_DOT) -> return TOKEN_IDENT\n    kind\n}}\n"
    active: spelling_list("LEXER_KEYWORD_SPELLINGS", rows, retired: false)
    retired: spelling_list("LEXER_RETIRED_SPELLINGS", rows, retired: true)
    "{words}\n// Every word `word_kind` reads as a keyword, so no identifier may be one:\n// the active keywords, then the retired ones no grammar rule accepts.\n{active}\n{retired}"
}

keyword_rows_main: fn(args: [String]) -[FS]> String KeywordRowsError! {
    usage: "usage: jet Toolchain/LexerKeywordRows.jet [--check|--write] [--syntax=DIR]"
    mode := "--check"
    syntax_dir := SYNTAX_DIR
    loop (index, arg) in args {
        if {
            arg.starts_with("--syntax=") -> syntax_dir = arg.remove_prefix("--syntax=")
            index == 0 && (arg == "--check" || arg == "--write") -> mode = arg
            else -> return Err(rows_fail(usage))
        }
    }
    generated: render_keyword_spans(read_keyword_rows(syntax_dir) ?? return Err(err))
    current: if files.exists(SPANS_PATH) -> files.read(SPANS_PATH) ?? return Err(rows_fail("cannot read {SPANS_PATH}: {err}")) else -> ""
    if mode == "--write" {
        if current == generated -> return Ok("lexer keyword rows: {SPANS_PATH} is current")
        files.write(SPANS_PATH, generated) ?? return Err(rows_fail("cannot write {SPANS_PATH}: {err}"))
        return Ok("lexer keyword rows written")
    }
    if current != generated {
        return Err(rows_fail("{SPANS_PATH} is stale; run jet build Compiler"))
    }
    Ok("lexer keyword rows check passed")
}

run: fn() { print(keyword_rows_main(process.args()) ?? process.fail(1, err.message)) }

// The error text keyword_rows reports for these inputs, or "" when it accepts them.
keyword_rows_error: fn(mapping: String, syntax: String, tokens: String) -> String Never! {
    if keyword_rows(mapping, syntax, tokens) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("the keyword projection is byte checks and rejects incomplete authority") {
    mapping: "LEXER_KEYWORDS: [LexerKeyword]{{\n    LexerKeyword{{constant: \"KW_FN\", kind: \"KwFn\", tag: \"TOKEN_KW_FN\", retired: false}},\n    LexerKeyword{{constant: \"KW_FOR\", kind: \"KwFor\", tag: \"TOKEN_KW_FOR\", retired: false}},\n}}"
    syntax: "KW_FN: \"fn\"\nKW_FOR: \"for\"\nJET_KEYWORD_LIST: [String]{{\n    KW_FN,\n    KW_FOR, // loops\n}}"
    tokens: "TOKEN_KW_FN: 57\nTOKEN_KW_FOR: 58\n"
    rows: keyword_rows(mapping, syntax, tokens) ?? panic("the minimal table did not parse: {err.message}")
    assert_eq(rows[0].spelling, "fn")
    generated: render_keyword_spans(rows)
    assert(generated.starts_with(SPANS_HEADER))
    assert(!generated.contains("slice_text") && !generated.contains(".bytes(") && !generated.contains("String.from_bytes") && !generated.contains("[U8]{{"))
    loop row in rows {
        assert_eq(generated.split("// Syntax.{row.constant}\n").to_list().len() - 1, 1)
        assert(generated.contains(row.tag))
    }
    assert(generated.contains("        // Syntax.KW_FN\n        2 -> if byte_at(source, start + 0) == 102 && byte_at(source, start + 1) == 110 -> TOKEN_KW_FN else -> TOKEN_IDENT\n"))
    assert(generated.ends_with("\nLEXER_KEYWORD_SPELLINGS: [String]{{\n    \"fn\",\n    \"for\",\n}}\n\nLEXER_RETIRED_SPELLINGS: [String]{{\n}}\n"))
    retired_spans: render_keyword_spans(keyword_rows(mapping.replace("\"TOKEN_KW_FOR\", retired: false", "\"TOKEN_KW_FOR\", retired: true"), syntax.replace("    KW_FOR, // loops\n", ""), tokens) ?? panic("the retired table did not parse: {err.message}"))
    assert(retired_spans.ends_with("\nLEXER_KEYWORD_SPELLINGS: [String]{{\n    \"fn\",\n}}\n\nLEXER_RETIRED_SPELLINGS: [String]{{\n    \"for\",\n}}\n"))
    assert(keyword_rows_error(mapping.replace("\n}}", "\n    invalid row,\n}}"), syntax, tokens).contains("unparsed keyword row"))
    assert(keyword_rows_error("LEXER_KEYWORDS: [LexerKeyword]{{\n}}", syntax, tokens).contains("incomplete"))
    assert(keyword_rows_error(mapping.replace("KwFn", "KwNew"), syntax, tokens).contains("unresolved token kind"))
    assert(keyword_rows_error(mapping, syntax, "{tokens}TOKEN_KW_NEW: 59\n").contains("incomplete"))
    assert(keyword_rows_error(mapping.replace("KwFn", "KwFn(String)"), syntax, tokens).contains("unparsed"))
    assert(keyword_rows_error(mapping, "{syntax}\n{syntax}", tokens).contains("ambiguous"))
    assert(keyword_rows_error(mapping, "KW_FN: OTHER\nKW_FOR: \"for\"", tokens).contains("unresolved"))
    assert(keyword_rows_error(mapping, "KW_FN: \"fñ\"\nKW_FOR: \"for\"", tokens).contains("unsupported keyword"))
    assert(keyword_rows_error(mapping, "KW_FN: \"fn\"\nKW_FOR: \"for\"", tokens).contains("no JET_KEYWORD_LIST"))
    assert(keyword_rows_error(mapping, syntax.replace("    KW_FOR, // loops\n", ""), tokens).contains("active keyword KW_FOR is missing"))
    retired: mapping.replace("\"TOKEN_KW_FOR\", retired: false", "\"TOKEN_KW_FOR\", retired: true")
    assert(keyword_rows_error(retired, syntax, tokens).contains("retired keyword KW_FOR is in"))
    assert_eq(keyword_rows_error(retired, syntax.replace("    KW_FOR, // loops\n", ""), tokens), "")
}

#Test("every keyword token kind has one canonical name in Tokens.jet") {
    mapping: "LEXER_KEYWORDS: [LexerKeyword]{{\n    LexerKeyword{{constant: \"KW_FN\", kind: \"KwFn\", tag: \"TOKEN_KW_FN\", retired: false}},\n}}"
    syntax: "KW_FN: \"fn\"\nJET_KEYWORD_LIST: [String]{{\n    KW_FN,\n}}"
    tokens: "TOKEN_IDENT: 1\nTOKEN_STRING: 3\nTOKEN_KW_FN: 57\n"
    assert_eq(keyword_rows_error(mapping, syntax, tokens), "")
    assert(keyword_rows_error(mapping, syntax, "{tokens}TOKEN_FN: 58\n").contains("share one tag name"))
}
