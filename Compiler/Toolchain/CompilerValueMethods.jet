#!/usr/bin/env jet
// The compiler value method projections, made by Compiler/build.jet's
// `compiler-value-methods` step: every public `Compiler*` record and its
// fields in `CORE_RECORD_FIELD_ROWS`
// (JetFoundation/Source/Registry/CoreRecordRows.jet) projected whole into
// JetEval/Source/CompilerValueMethods.jet so the evaluator never lists
// compiler records or fields by hand. Adding a field on `CompilerChecked` (or
// any other `Compiler*` record) in CoreRecordRows.jet exposes it with no
// evaluator edit. The step keeps the file in git (`kept: true`), so the build
// rewrites a stale one and refuses a hand edit of it.
// Usage (from Compiler/): jet Toolchain/CompilerValueMethods.jet [--check|--write]
// Paths are relative to the Compiler package, the step's working folder.
use {
    files: core.files
    process: core.process
}

RECORDS_PATH: "JetFoundation/Source/Registry/CoreRecordRows.jet"

TARGET_PATH: "JetEval/Source/CompilerValueMethods.jet"

GENERATED_HEADER: "// This file is generated by Compiler/Toolchain/CompilerValueMethods.jet, which `jet build Compiler`\n// runs, from Compiler/JetFoundation/Source/Registry/CoreRecordRows.jet; do not edit.\n// It stays committed: the seed builds the compiler from the checkout, and\n// `jet check` reads it before any build step runs.\n// Source-owned projections for compiler query values.\n// These methods consume immutable TComptimeValue packets produced by the\n// compiler service; they never re-run a checker or call native Builtins.\n"

LINE_COMMENT: Regex{"//[^\n]*"}

// The CORE_RECORD_FIELD_ROWS body: from its opening line to the first line
// that starts with `}`. Matched against the text after a leading newline, so a
// newline marks every line start.
RECORD_TABLE: Regex{"\nCORE_RECORD_FIELD_ROWS: \[CoreRecordFieldRow\]\{{([\s\S]*?)\n\}}"}

RECORD_ROW: Regex{"^\s*(?:CoreRecordFieldRow)?\{{owner: \x22([A-Za-z][A-Za-z0-9_]*)\x22, field: \x22([a-z][a-z0-9_]*)\x22, ty: .+(?:, core_only: (true|false))?\}},$"}

CORE_ONLY_TRUE: Regex{",\s*core_only:\s*true\s*\}},$"}

#Error
CompilerValueMethodsError: struct {
    message: String,
}

CompilerValueRecord: struct {
    owner: String,
    fields: [String],
}

methods_fail: fn(message: String) -> CompilerValueMethodsError Never! {
    CompilerValueMethodsError{message: "compiler value methods: {message}"}
}

// The public `Compiler*` records and their fields in row order, deduplicated
// per owner (matching `core_record_field`).
compiler_value_records: fn(source: String) -> [CompilerValueRecord] CompilerValueMethodsError! {
    table: RECORD_TABLE.match("\n{LINE_COMMENT.replace(source, "")}") ?? return Err(methods_fail("unrecognized CORE_RECORD_FIELD_ROWS table"))
    records := [CompilerValueRecord]{}
    loop raw in table.groups[0].split("\n") {
        line: raw.trim()
        if line == "" -> next
        row: RECORD_ROW.match(line) ?? return Err(methods_fail("unparsed record field row: {line}"))
        owner: "{row.groups[0]}"
        field: "{row.groups[1]}"
        if !owner.starts_with("Compiler") -> next
        if CORE_ONLY_TRUE.match(line) != None -> next
        found := -1
        loop (index, entry) in records {
            if entry.owner == owner {
                found = index
                break
            }
        }
        if found < 0 -> records.push(CompilerValueRecord{owner: owner, fields: [String]{field}}) else {
            if !records[found].fields.contains(field) -> records[found].fields.push(field)
        }
    }
    if records.len() == 0 {
        return Err(methods_fail("CORE_RECORD_FIELD_ROWS contains no Compiler* records"))
    }
    has_checked := false
    loop entry in records {
        if entry.owner == "CompilerChecked" -> has_checked = true
    }
    if !has_checked -> return Err(methods_fail("CORE_RECORD_FIELD_ROWS is missing CompilerChecked"))
    Ok(records)
}

// One `if owner == "..."` arm in `jet_eval_compiler_value_method_record`,
// formatted as `jet fmt` keeps it (inline `->` up to 100 columns, else a block).
render_record_arm: fn(record: CompilerValueRecord) -> String Never! {
    parts := [String]{}
    loop field in record.fields -> parts.push("method == \"{field}\"")
    checks: parts.join(" || ")
    inline: "    if owner == \"{record.owner}\" -> return {checks}"
    if inline.len() <= 100 -> return "{inline}\n"
    "    if owner == \"{record.owner}\" {{\n        return {checks}\n    }}\n"
}

// JetEval/Source/CompilerValueMethods.jet, whole.
render_compiler_value_methods: fn(records: [CompilerValueRecord]) -> String Never! {
    arms := ""
    loop record in records -> arms = "{arms}{render_record_arm(record)}"
    prefix: ```use jet_foundation.[
    TComptimeField,
    TComptimeValue,
    type_name,
]

// The owner and method of a host method member `Owner.method`. The owner is a
// type name, which has no dot; the method is the rest, which may hold one: a
// hidden method that no source can spell, such as `Compiler`'s
// `events.functions` (JetSema Calls/Build.jet).
jet_eval_compiler_value_method_owner: fn(member: String) -> [String]? {
    parts: member.partition(".")
    if parts.head == "" || parts.tail == "" -> return None
    Val([String]{parts.head, parts.tail})
}

jet_eval_compiler_value_method_record: fn(owner: String, method: String) -> Bool Never! {
```
    suffix: ```    false
}

jet_eval_compiler_value_method_supported: fn(owner: String, method: String, arg_count: Int) -> Bool Never! {
    if arg_count != 0 && owner != "EffectInfo" -> return false
    if owner == "ProgramInfo" {
        return method == "types" || method == "functions" || method == "traits" || method == "constants" || method == "packages" || method == "foreign" || method == "definitions" || method == "references" || method == "call_edges" || method == "structural_nodes" || method == "revision" || method == "complete"
    }
    if jet_eval_compiler_value_method_record(owner, method) -> return true
    if owner == "FunctionInfo" -> return method == "reaches_panic"
    if owner == "EffectInfo" -> return method == "has" && arg_count == 1
    false
}

// What a compiler value or reflection method answers on its checked
// receiver: the projected value, or the defect (`Fault`) that keeps the
// receiver from one.
JetEvalCompilerValueAnswer: enum {
    Value(value: TComptimeValue),
    Fault(message: String),
}

jet_eval_compiler_value_fault: fn(message: String) -> JetEvalCompilerValueAnswer Never! {
    JetEvalCompilerValueAnswer.Fault{message: message}
}

jet_eval_compiler_value_field: fn(fields: [TComptimeField], name: String) -> TComptimeValue? Never! {
    loop field in fields {
        if field.name == name -> return Val(field.value)
    }
    None
}

// The fields of `value` when it is the checked record `owner`.
jet_eval_compiler_value_fields: fn(value: TComptimeValue, owner: String) -> [TComptimeField]? Never! {
    if value == .Struct(type_name, fields) {
        if type_name == owner -> return Val(fields)
    }
    None
}

// Compiler value method `owner.method` (one jet_eval_compiler_value_method_supported
// accepts) on `args`, the receiver first.
jet_eval_compiler_value_answer: fn(owner: String, method: String, args: [TComptimeValue]) -> JetEvalCompilerValueAnswer Never! {
    if args.len() == 0 {
        return jet_eval_compiler_value_fault("compiler value route has no receiver")
    }
    fields: jet_eval_compiler_value_fields(args[0], owner) ?? return jet_eval_compiler_value_fault("compiler value route receiver is not {owner}")
    if owner == "EffectInfo" && method == "has" {
        wanted: if args.len() == 2 && args[1] == .String(text) -> text else -> {
            return jet_eval_compiler_value_fault("EffectInfo.has requires a String argument")
        }
        list: jet_eval_compiler_value_field(fields, "values") ?? return jet_eval_compiler_value_fault("EffectInfo.values projection is missing from its checked value")
        if list == .List(values) {
            loop value in values {
                if value == .String(text) {
                    if text == wanted {
                        return JetEvalCompilerValueAnswer.Value{value: TComptimeValue.Bool{value: true}}
                    }
                } else {
                    return jet_eval_compiler_value_fault("EffectInfo.has projection field values must contain only Strings")
                }
            }
            return JetEvalCompilerValueAnswer.Value{value: TComptimeValue.Bool{value: false}}
        }
        return jet_eval_compiler_value_fault("EffectInfo.has projection field values is not a list")
    }
    projected: jet_eval_compiler_value_field(fields, method) ?? return jet_eval_compiler_value_fault("{owner}.{method} projection is missing from its checked value")
    if owner != "ProgramInfo" -> return JetEvalCompilerValueAnswer.Value{value: projected}
    if method == "revision" {
        if projected == .String(_) -> return JetEvalCompilerValueAnswer.Value{value: projected}
        return jet_eval_compiler_value_fault("ProgramInfo.revision projection is not a String")
    }
    if method == "complete" {
        if projected == .Bool(_) -> return JetEvalCompilerValueAnswer.Value{value: projected}
        return jet_eval_compiler_value_fault("ProgramInfo.complete projection is not a Bool")
    }
    if projected == .List(_) -> return JetEvalCompilerValueAnswer.Value{value: projected}
    jet_eval_compiler_value_fault("{owner}.{method} projection is not a list")
}
```
    "{GENERATED_HEADER}{prefix}{arms}{suffix}"
}

compiler_value_methods_main: fn(args: [String]) -[FS]> String CompilerValueMethodsError! {
    usage: "usage: jet Toolchain/CompilerValueMethods.jet [--check|--write]"
    mode := "--check"
    loop (index, arg) in args {
        if index == 0 && (arg == "--check" || arg == "--write") -> mode = arg else {
            return Err(methods_fail(usage))
        }
    }
    source: files.read(RECORDS_PATH) ?? return Err(methods_fail("cannot read {RECORDS_PATH}: {err}"))
    records: compiler_value_records(source) ?? return Err(err)
    generated: render_compiler_value_methods(records)
    current: if files.exists(TARGET_PATH) -> files.read(TARGET_PATH) ?? return Err(methods_fail("cannot read {TARGET_PATH}: {err}")) else -> ""
    if mode == "--write" {
        if current == generated -> return Ok("compiler value methods: {TARGET_PATH} is current")
        files.write(TARGET_PATH, generated) ?? return Err(methods_fail("cannot write {TARGET_PATH}: {err}"))
        return Ok("compiler value methods written")
    }
    if current != generated {
        return Err(methods_fail("{TARGET_PATH} is stale; run jet build Compiler"))
    }
    Ok("compiler value methods check passed")
}

run: fn() { print(compiler_value_methods_main(process.args()) ?? process.fail(1, err.message)) }

// The error text compiler_value_records reports for `source`, or "" when accepted.
compiler_value_records_error: fn(source: String) -> String Never! {
    if compiler_value_records(source) == {
        .Ok(_) -> ""
        .Err(error) -> error.message
    }
}

#Test("a new field on CompilerChecked appears in the generated evaluator table with no evaluator edit") {
    base: "CORE_RECORD_FIELD_ROWS: [CoreRecordFieldRow]{{\n    CoreRecordFieldRow{{owner: \"CSVRow\", field: \"line\", ty: Type.Int}},\n    CoreRecordFieldRow{{owner: \"CompilerChecked\", field: \"source\", ty: Type.String}},\n    CoreRecordFieldRow{{owner: \"CompilerChecked\", field: \"internal_id\", ty: Type.Int, core_only: true}},\n    CoreRecordFieldRow{{owner: \"CompilerChecked\", field: \"source\", ty: Type.String}},\n    CoreRecordFieldRow{{owner: \"CompilerDependency\", field: \"name\", ty: Type.String}},\n}}\n"
    before: render_compiler_value_methods(compiler_value_records(base) ?? panic("base table did not parse: {err.message}"))
    assert(before.starts_with(GENERATED_HEADER))
    assert(before.contains("if owner == \"CompilerChecked\" -> return method == \"source\"\n"))
    assert(!before.contains("diagnostics_count"))
    assert(!before.contains("internal_id"))
    assert(!before.contains("CSVRow"))
    extended: base.replace("\n}}\n", "\n    CoreRecordFieldRow{{owner: \"CompilerChecked\", field: \"diagnostics_count\", ty: Type.Int}},\n}}\n")
    after: render_compiler_value_methods(compiler_value_records(extended) ?? panic("extended table did not parse: {err.message}"))
    assert(after.contains("if owner == \"CompilerChecked\" -> return method == \"source\" || method == \"diagnostics_count\"\n"))
    assert(after.contains("if owner == \"CompilerDependency\" -> return method == \"name\"\n"))
    assert(compiler_value_records_error("CORE_RECORD_FIELD_ROWS: [CoreRecordFieldRow]{{\n}}\n").contains("no Compiler* records"))
    assert(compiler_value_records_error("CORE_RECORD_FIELD_ROWS: [CoreRecordFieldRow]{{\n    CoreRecordFieldRow{{owner: \"CompilerDependency\", field: \"name\", ty: Type.String}},\n}}\n").contains("missing CompilerChecked"))
    assert(compiler_value_records_error("CORE_RECORD_FIELD_ROWS: [CoreRecordFieldRow]{{\n    bad row,\n}}\n").contains("unparsed record field row"))
}
