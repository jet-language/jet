#!/usr/bin/env jet
// Core's vendored C, made by Compiler/build.jet's `vendored-c` step: the one
// C the toolchain build still compiles. It goes, with this script, that step
// and the archives' rows in the runtime pack's identity and provenance, when
// sqlite3 and mbedtls are Jet (#6694, #6695).
//
//   jet Toolchain/VendoredC.jet --cc=CC --ar=AR --sqlite3=DIR --mbedtls=DIR
//       --policy=FILE --out=DIR --recipe=FILE
//
// Core's vendored C (Core/Vendor/Sqlite3 and Core/Vendor/Mbedtls, read from
// the `--sqlite3` and `--mbedtls` folders) backs Core modules' `c.sqlite3`
// and `c.mbedtls` imports. CC compiles it under the one native C policy
// (FILE, Compiler/JetCli/Source/Cli/native-c-policy.tsv) and AR archives it
// as OUT/<lib>/lib<lib>.a, with the library's LICENSE and VERSION beside it,
// so neither jet's self-compile nor a core.db or core.net.tls program needs a
// C compiler. A program whose live code calls it links it, and user foreign
// closures, with the musl libc and compiler builtins of jet's C toolchain
// pack (Compiler/JetCli ForeignLink.jet). The runtime pack links none of it:
// the `runtime` step (Toolchain/RuntimePack.jet) only checks and records the
// archives. `--recipe` gets the sha256 of the recipe the archives are a
// function of (format jet-vendored-c/v1): the source bytes, the flags, the
// policy and the compiler.
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    term: core.term
}

USAGE: "usage: jet Toolchain/VendoredC.jet --cc=CC --ar=AR --sqlite3=DIR --mbedtls=DIR --policy=FILE --out=DIR --recipe=FILE"
VENDOR_BASE_FLAGS: [String]{"-std=c11", "-O2", "-fPIC", "-fno-stack-protector", "-fno-asynchronous-unwind-tables", "-fno-unwind-tables", "-D_GNU_SOURCE"}
// libsqlite3-sys 0.28.0 build.rs120-141,245-249 on Linux.
SQLITE_FLAGS: [String]{
    "-DSQLITE_CORE", "-DSQLITE_DEFAULT_FOREIGN_KEYS=1",
    "-DSQLITE_ENABLE_API_ARMOR", "-DSQLITE_ENABLE_COLUMN_METADATA",
    "-DSQLITE_ENABLE_DBSTAT_VTAB", "-DSQLITE_ENABLE_FTS3",
    "-DSQLITE_ENABLE_FTS3_PARENTHESIS", "-DSQLITE_ENABLE_FTS5",
    "-DSQLITE_ENABLE_JSON1", "-DSQLITE_ENABLE_LOAD_EXTENSION=1",
    "-DSQLITE_ENABLE_MEMORY_MANAGEMENT", "-DSQLITE_ENABLE_RTREE",
    "-DSQLITE_ENABLE_STAT2", "-DSQLITE_ENABLE_STAT4", "-DSQLITE_SOUNDEX",
    "-DSQLITE_THREADSAFE=1", "-DSQLITE_USE_URI", "-DHAVE_USLEEP=1",
    "-D_POSIX_THREAD_SAFE_FUNCTIONS", "-DHAVE_ISNAN", "-DHAVE_LOCALTIME_R", "-w",
}
NOTICES: [String]{"LICENSE", "VERSION"}
// At most this many C compilers run at once.
JOBS: 6

// A vendored C library: `source` names its checkout folder, `folder` where
// the step reads it. The tree keeps its relative layout (mbedtls/ and psa/
// headers sit under -I).
Vendored: struct {
    name: String
    source: String
    folder: String
    flags: [String]
}

// One vendored library's build: its compile units' objects, in unit order.
Library: struct {
    name: String
    root: String
    objects: [String]
    archive: String
}

VendoredC: struct {
    cc: String
    ar: String
    policy: [String]
    vendored: [Vendored]
}

fail: fn(message: String) -> Never {
    term.eprint("vendored-c: {message}")
    process.exit(1)
}

// The step's absolute path of `path`.
absolute: fn(path: String) -> String {
    files.absolute(path) ?? fail("cannot resolve `{path}`: {err}")
}

// `--name=value` flags, each given once.
parse_flags: fn(args: [String]) -> [String: String] {
    known: [String]{"cc", "ar", "sqlite3", "mbedtls", "policy", "out", "recipe"}
    values := [String: String]{}
    loop arg in args {
        if !arg.starts_with("--") || !arg.contains("=") -> fail(USAGE)
        pair: arg.removeprefix("--").partition("=")
        if pair.tail == "" -> fail(USAGE)
        if !known.contains(pair.head) -> fail("unknown flag --{pair.head}\n{USAGE}")
        if values.get(pair.head) != None -> fail("--{pair.head} is given twice")
        values[pair.head] = pair.tail.copy()
    }
    values
}

flag: fn(flags: [String: String], name: String) -> String {
    flags.get(name) ?? fail("--{name} is missing\n{USAGE}")
}

// Every file under `directory` that `keep` accepts, relative to it, sorted.
tree_files: fn(directory: String, keep: fn(String) -> Bool) -> [String] {
    found := [String]{}
    entries: files.walk_files(directory).list() ?? fail("cannot list `{directory}`: {err}")
    loop entry in entries {
        if keep(files.basename(entry.relative)) -> found.push(entry.relative.copy())
    }
    found.sort()
    found
}

vendor_file: fn(name: String) -> Bool { name.ends_with(".c") || name.ends_with(".h") || name == "LICENSE" || name == "VERSION" }

// One sha256 over `<path byte count>:<path>:<size>:<bytes>` per file, the
// sorted unique checkout paths `where` gives the file of.
inventory_sha256: fn(paths: [String], where: fn(String) -> String) -> String {
    sorted := paths.copy()
    sorted.sort()
    total := crypto.new()
    last := ""
    loop path in sorted {
        if path == last -> next
        last = path.copy()
        bytes: files.read_bytes(where(path)) ?? fail("cannot read `{path}`: {err}")
        total.update("{path.count_bytes()}:{path}:{bytes.len()}:".bytes())
        total.update(bytes)
    }
    total.digest()
}

text_array: fn(items: [String]) -> Dyn { Dyn.Array(loop item in items -> Dyn.Text(item.copy())) }

sha256_json: fn(value: Dyn) -> String { crypto.sha256((json.dumps(value) ?? fail("cannot render JSON: {err}")).bytes()).hex() }

// A command that must exit 0; its stdout.
output_of: fn(spec: ProcessSpec, what: String) -> String {
    receipt: spec.output_limit(268435456).run() ?? fail("{what} could not start: {err}")
    if receipt.code != 0 || receipt.signal != None -> fail("{what} failed ({receipt.code}):\n{receipt.errors}")
    receipt.output
}

copy_into: fn(from: String, to: String) {
    files.copy(from, to) ?? fail("cannot copy `{from}` to `{to}`: {err}")
}

// The `flag` rows of the native C policy `text` (the file `path`); its
// `hardening-remove` rows name the Nix compiler wrapper's hardening, which a
// step's cleared environment enables none of.
policy_flags: fn(text: String, path: String) -> [String] {
    flags := [String]{}
    lines: text.split("\n").to_list()
    loop index in 0..<lines.len() {
        line: lines[index]
        if line == "" || line.starts_with("#") -> next
        fields: line.split("\t").to_list()
        if fields.len() != 2 || fields[1] == "" -> fail("{path}:{index + 1}: expected \"kind<TAB>value\"")
        if fields[0] == {
            "flag" -> flags.push(fields[1].copy())
            "hardening-remove" -> {}
            else -> fail("{path}:{index + 1}: unknown policy kind `{fields[0]}`")
        }
    }
    flags
}

read_policy: fn(path: String) -> [String] {
    policy_flags(files.read(path) ?? fail("cannot read `{path}`: {err}"), path)
}

cc_spec: fn(c: VendoredC, argv: [String]) -> ProcessSpec {
    process.cmd([String]{c.cc.copy()}).args_extend(argv)
}

// Each vendored library's compile jobs; objects are written under `work`.
compile_jobs: fn(c: VendoredC, work: String, libraries: &[Library], units: &[String]) -> [ProcessSpec] {
    jobs := [ProcessSpec]{}
    loop library in c.vendored {
        root: library.folder.copy()
        objects: files.join(work, library.name)
        files.create_dir_all(objects) ?? fail("cannot create `{objects}`: {err}")
        built := [String]{}
        loop unit in tree_files(root, vendor_file) {
            if !unit.ends_with(".c") -> next
            object: files.join(objects, "{unit.replace("/", "_").removesuffix(".c")}.o")
            argv := VENDOR_BASE_FLAGS.copy()
            argv.extend(library.flags.copy())
            argv.extend([String]{"-ffile-prefix-map={root}=/jet/c", "-ffile-prefix-map={objects}=.", "-I", root.copy(), "-c", files.join(root, unit), "-o", object.copy()})
            argv.extend(c.policy.copy())
            jobs.push(cc_spec(c, argv))
            units.push("{library.source}/{unit}")
            built.push(object)
        }
        libraries.push(Library{name: library.name.copy(), root: root, objects: built, archive: files.join(objects, "lib{library.name}.a")})
    }
    jobs
}

// The vendored C recipe: source bytes, flags, policy and the compiler
// (format jet-vendored-c/v1).
recipe: fn(c: VendoredC) -> String {
    inputs := [String]{}
    folders := [String: String]{}
    loop library in c.vendored {
        folders[library.source] = library.folder.copy()
        loop path in tree_files(library.folder, vendor_file) -> inputs.push("{library.source}/{path}")
    }
    where: (path: String) -> {
        library: path.partition("/Vendor/").tail.partition("/")
        source: "Core/Vendor/{library.head}"
        files.join(folders.get(source) ?? fail("`{path}` is in no vendored library"), library.tail)
    }
    libraries: loop library in c.vendored -> Dyn.Object([String: Dyn]{"name": Dyn.Text(library.name.copy()), "flags": text_array(library.flags)})
    version: output_of(cc_spec(c, [String]{"--version"}), "{c.cc} --version")
    cc1: output_of(cc_spec(c, [String]{"-print-prog-name=cc1"}), "{c.cc} -print-prog-name=cc1").trim()
    sha256_json(Dyn.Object([String: Dyn]{
        "format": Dyn.Text("jet-vendored-c/v1"),
        "inputs": Dyn.Text(inventory_sha256(inputs, where)),
        "base": text_array(VENDOR_BASE_FLAGS),
        "policy": text_array(c.policy),
        "libraries": Dyn.Array(libraries),
        "compiler": text_array([String]{version, cc1}),
    }))
}

run: fn() {
    flags: parse_flags(process.args())
    c: VendoredC{
        cc: absolute(flag(flags, "cc")),
        ar: absolute(flag(flags, "ar")),
        policy: read_policy(flag(flags, "policy")),
        vendored: [Vendored]{
            Vendored{name: "sqlite3", source: "Core/Vendor/Sqlite3", folder: absolute(flag(flags, "sqlite3")), flags: SQLITE_FLAGS.copy()},
            Vendored{name: "mbedtls", source: "Core/Vendor/Mbedtls", folder: absolute(flag(flags, "mbedtls")), flags: [String]{}},
        },
    }
    out: absolute(flag(flags, "out"))
    recipe_path: flag(flags, "recipe")
    sha256: recipe(c)
    // The step's folder, not /tmp: sqlite3's objects outgrow a small
    // temporary file system.
    work: absolute(".vendored-c")
    files.remove_all(work) ?? ()
    files.create_dir_all(work) ?? fail("cannot create `{work}`: {err}")
    libraries := [Library]{}
    units := [String]{}
    // sqlite3's single large unit first.
    jobs: compile_jobs(c, work, libraries, units)
    results: process.run_all(jobs, JOBS) ?? fail("the C compilers could not start: {err}")
    problems := [String]{}
    loop index in 0..<results.len() {
        if results[index] == {
            .Ok(receipt) -> {
                if receipt.code != 0 || receipt.signal != None {
                    detail: if receipt.errors == "" -> "" else -> ":\n{receipt.errors}"
                    problems.push("C compiler on {units[index]} failed ({receipt.code}){detail}")
                }
            }
            .Err(error) -> problems.push("C compiler on {units[index]} could not start: {error}")
        }
    }
    if problems.len() > 0 -> fail(problems.join("\n"))
    loop item in libraries {
        argv := [String]{c.ar.copy(), "rcsD", item.archive.copy()}
        argv.extend(item.objects.copy())
        _: output_of(process.cmd(argv), "{c.ar} rcsD {item.archive}")
        target: files.join(out, item.name)
        files.create_dir_all(target) ?? fail("cannot create `{target}`: {err}")
        copy_into(item.archive, files.join(target, "lib{item.name}.a"))
        loop notice in NOTICES {
            if files.exists(files.join(item.root, notice)) -> copy_into(files.join(item.root, notice), files.join(target, notice))
        }
    }
    files.remove_all(work) ?? ()
    files.write(recipe_path, "{sha256}\n") ?? fail("cannot write `{recipe_path}`: {err}")
}

#Test("the recipe JSON keeps its field order") {
    assert_eq(json.dumps(Dyn.Object([String: Dyn]{"format": Dyn.Text("f"), "base": text_array([String]{"a", "b"}), "n": Dyn.Int(0)})) ?? "", "{{\"format\":\"f\",\"base\":[\"a\",\"b\"],\"n\":0}}")
}

#Test("the native C policy keeps its flag rows") {
    assert_eq(policy_flags("# comment\nflag\t-fno-plt\nhardening-remove\tfortify\n\nflag\t-g0\n", "policy.tsv"), [String]{"-fno-plt", "-g0"})
}
