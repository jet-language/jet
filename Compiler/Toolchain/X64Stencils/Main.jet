        add_stencil(s, "o0_st_f32_{fnames[idx]}_m32", true, [String]{"disp"}, ms32.bytes, [StencilHole]{StencilHole{at: ms32.bytes.len() - 4, kind: HOLE_I32, param: "disp"}})
    }
    ^sqd: x64_code()
    x64_float_op(sqd, X64FloatOp.Sqrt, false, 0, 0)
    add_stencil(s, "o0_st_f64_sqrt", true, [String]{}, sqd.bytes, [StencilHole]{})
    ^sqs: x64_code()
    x64_float_op(sqs, X64FloatOp.Sqrt, true, 0, 0)
    add_stencil(s, "o0_st_f32_sqrt", true, [String]{}, sqs.bytes, [StencilHole]{})
    ^c1: x64_code()
    x64_ucomisd(c1, 0, 1)
    add_stencil(s, "o0_st_ucomisd_01", true, [String]{}, c1.bytes, [StencilHole]{})
    ^c1b: x64_code()
    x64_ucomisd(c1b, 1, 0)
    add_stencil(s, "o0_st_ucomisd_10", true, [String]{}, c1b.bytes, [StencilHole]{})
    ^c2: x64_code()
    x64_ucomiss(c2, 0, 1)
    add_stencil(s, "o0_st_ucomiss_01", true, [String]{}, c2.bytes, [StencilHole]{})
    ^c2b: x64_code()
    x64_ucomiss(c2b, 1, 0)
    add_stencil(s, "o0_st_ucomiss_10", true, [String]{}, c2b.bytes, [StencilHole]{})
    ^c3: x64_code()
    x64_cvtsi2sd(c3, 0, X64_RAX)
    add_stencil(s, "o0_st_cvtsi2sd", true, [String]{}, c3.bytes, [StencilHole]{})
    ^c4: x64_code()
    x64_cvtsi2ss(c4, 0, X64_RAX)
    add_stencil(s, "o0_st_cvtsi2ss", true, [String]{}, c4.bytes, [StencilHole]{})
    ^c5: x64_code()
    x64_cvttsd2si(c5, X64_RAX, 0)
    add_stencil(s, "o0_st_cvttsd2si", true, [String]{}, c5.bytes, [StencilHole]{})
    ^c6: x64_code()
    x64_cvttss2si(c6, X64_RAX, 0)
    add_stencil(s, "o0_st_cvttss2si", true, [String]{}, c6.bytes, [StencilHole]{})
    ^c7: x64_code()
    x64_cvtss2sd(c7, 0, 0)
    add_stencil(s, "o0_st_cvtss2sd", true, [String]{}, c7.bytes, [StencilHole]{})
    ^c8: x64_code()
    x64_cvtsd2ss(c8, 0, 0)
    add_stencil(s, "o0_st_cvtsd2ss", true, [String]{}, c8.bytes, [StencilHole]{})
    ^c9: x64_code()
    x64_movq_to_xmm(c9, false, 0, X64_RAX)
    add_stencil(s, "o0_st_movq_xmm0_rax", true, [String]{}, c9.bytes, [StencilHole]{})
    ^c10: x64_code()
    x64_movq_from_xmm(c10, false, X64_RAX, 0)
