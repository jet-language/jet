        true,
        [String]{"dst"},
        r8.bytes,
        [StencilHole]{
            StencilHole{at: h8, kind: HOLE_ZERO32, param: ""},
            StencilHole{at: 13, kind: HOLE_I8, param: "dst"},
        },
    )
}

add_alu_stencils: fn(s: ^[StencilSpec]) Never! {
    alu_ops: [X64Alu]{X64Alu.Add, X64Alu.Sub, X64Alu.Cmp, X64Alu.And, X64Alu.Or, X64Alu.Xor}
    alu_names: [String]{"add", "sub", "cmp", "and", "or", "xor"}
    loop idx in 0..<alu_ops.len() {
        aop: alu_ops[idx]
        an: alu_names[idx]
        ^m8: x64_code()
        x64_alu_rm(m8, aop, X64_RAX, X64_RBP, SENTINEL_D8)
        add_stencil(s, "o0_st_{an}_rax_m8", true, [String]{"disp"}, m8.bytes, [StencilHole]{StencilHole{at: 3, kind: HOLE_I8, param: "disp"}})
        ^m32: x64_code()
        x64_alu_rm(m32, aop, X64_RAX, X64_RBP, SENTINEL_D32)
        add_stencil(s, "o0_st_{an}_rax_m32", true, [String]{"disp"}, m32.bytes, [StencilHole]{StencilHole{at: 3, kind: HOLE_I32, param: "disp"}})
        ^rr: x64_code()
        x64_alu_rr(rr, aop, X64_RAX, X64_RCX)
        add_stencil(s, "o0_st_{an}_rax_rcx", true, [String]{}, rr.bytes, [StencilHole]{})
        ^ri8: x64_code()
        x64_alu_ri(ri8, aop, X64_RAX, 1)
        add_stencil(s, "o0_st_{an}_rax_i8", true, [String]{"imm"}, ri8.bytes, [StencilHole]{StencilHole{at: 3, kind: HOLE_I8, param: "imm"}})
        ^ri32: x64_code()
        x64_alu_ri(ri32, aop, X64_RAX, SENTINEL_I32)
        add_stencil(s, "o0_st_{an}_rax_i32", true, [String]{"imm"}, ri32.bytes, [StencilHole]{StencilHole{at: 3, kind: HOLE_I32, param: "imm"}})
    }

    ^c1: x64_code()
    x64_imul_rr(c1, X64_RAX, X64_RCX)
    add_stencil(s, "o0_st_imul_rax_rcx", true, [String]{}, c1.bytes, [StencilHole]{})
    ^c2: x64_code()
    x64_imul_rri(c2, X64_RAX, X64_RAX, SENTINEL_I32)
    add_stencil(s, "o0_st_imul_rax_i32", true, [String]{"imm"}, c2.bytes, [StencilHole]{StencilHole{at: 3, kind: HOLE_I32, param: "imm"}})
    ^c3: x64_code()
    x64_cqo(c3)
    x64_idiv(c3, X64_RCX)
    add_stencil(s, "o0_st_cqo_idiv_rcx", true, [String]{}, c3.bytes, [StencilHole]{})
    ^c4: x64_code()
    x64_zero(c4, X64_RDX)
    x64_div(c4, X64_RCX)
    add_stencil(s, "o0_st_div_rcx", true, [String]{}, c4.bytes, [StencilHole]{})
    ^c5: x64_code()
    x64_mul(c5, X64_RCX)
    add_stencil(s, "o0_st_mul_rcx", true, [String]{}, c5.bytes, [StencilHole]{})
    ^c6: x64_code()
    x64_imul_wide(c6, X64_RCX)
    add_stencil(s, "o0_st_imul_wide_rcx", true, [String]{}, c6.bytes, [StencilHole]{})
    ^c7: x64_code()
    x64_neg(c7, X64_RAX)
    add_stencil(s, "o0_st_neg_rax", true, [String]{}, c7.bytes, [StencilHole]{})
    ^c8: x64_code()
    x64_shift_cl(c8, X64Shift.Shl, X64_RAX)
    add_stencil(s, "o0_st_shl_rax_cl", true, [String]{}, c8.bytes, [StencilHole]{})
    ^c9: x64_code()
    x64_shift_cl(c9, X64Shift.Shr, X64_RAX)
    add_stencil(s, "o0_st_shr_rax_cl", true, [String]{}, c9.bytes, [StencilHole]{})
    ^c10: x64_code()
    x64_shift_cl(c10, X64Shift.Sar, X64_RAX)
    add_stencil(s, "o0_st_sar_rax_cl", true, [String]{}, c10.bytes, [StencilHole]{})
    ^c11: x64_code()
    x64_shift_ri(c11, X64Shift.Shl, X64_RAX, 1)
    add_stencil(s, "o0_st_shl_rax_i8", true, [String]{"imm"}, c11.bytes, [StencilHole]{StencilHole{at: 3, kind: HOLE_I8, param: "imm"}})
    ^c12: x64_code()
    x64_shift_ri(c12, X64Shift.Shr, X64_RAX, 1)
    add_stencil(s, "o0_st_shr_rax_i8", true, [String]{"imm"}, c12.bytes, [StencilHole]{StencilHole{at: 3, kind: HOLE_I8, param: "imm"}})
    ^c13: x64_code()
    x64_shift_ri(c13, X64Shift.Sar, X64_RAX, 1)
    add_stencil(s, "o0_st_sar_rax_i8", true, [String]{"imm"}, c13.bytes, [StencilHole]{StencilHole{at: 3, kind: HOLE_I8, param: "imm"}})
    ^c14: x64_code()
    x64_test_rr(c14, X64_RAX, X64_RAX)
    add_stencil(s, "o0_st_test_rax_rax", true, [String]{}, c14.bytes, [StencilHole]{})
    ^c15: x64_code()
    x64_test_rr(c15, X64_RCX, X64_RCX)
    add_stencil(s, "o0_st_test_rcx_rcx", true, [String]{}, c15.bytes, [StencilHole]{})
    ^c16: x64_code()
    x64_test_r32(c16, X64_RDX, X64_RDX)
    j_at: x64_jcc_rel32(c16, X64Cond.NE)
    add_stencil(s, "o0_st_stop_jne_edx", true, [String]{}, c16.bytes, [StencilHole]{StencilHole{at: j_at, kind: HOLE_ZERO32, param: ""}})
    ^c17: x64_code()
    x64_setcc_compact(c17, X64Cond.E, X64_RAX)
    x64_movzx_r32_r8(c17, X64_RAX, X64_RAX)
    add_stencil(s, "o0_st_setcc_rax", true, [String]{"cc"}, c17.bytes, [StencilHole]{StencilHole{at: 1, kind: HOLE_CC_SET, param: "cc"}})
    ^c18: x64_code()
    x64_setcc_compact(c18, X64Cond.E, X64_RAX)
    x64_setcc_compact(c18, X64Cond.NP, X64_RCX)
    x64_alu8_rr(c18, X64Alu.And, X64_RAX, X64_RCX)
    x64_movzx_r32_r8(c18, X64_RAX, X64_RAX)
    add_stencil(s, "o0_st_float_eq_flags", true, [String]{}, c18.bytes, [StencilHole]{})
    ^c19: x64_code()
    x64_setcc_compact(c19, X64Cond.NE, X64_RAX)
    x64_setcc_compact(c19, X64Cond.P, X64_RCX)
    x64_alu8_rr(c19, X64Alu.Or, X64_RAX, X64_RCX)
    x64_movzx_r32_r8(c19, X64_RAX, X64_RAX)
    add_stencil(s, "o0_st_float_ne_flags", true, [String]{}, c19.bytes, [StencilHole]{})
    ^c20: x64_code()
    x64_cmov_rr(c20, X64Cond.E, X64_RAX, X64_RCX)
    add_stencil(s, "o0_st_cmov_rax_rcx", true, [String]{"cc"}, c20.bytes, [StencilHole]{StencilHole{at: 2, kind: HOLE_CC_CMOV, param: "cc"}})
    ^c21: x64_code()
    x64_mov_rr(c21, X64_RDX, X64_RAX)
    x64_alu_rr(c21, X64Alu.Add, X64_RDX, X64_RDX)
    jo_at: x64_jcc_rel32(c21, X64Cond.O)
    add_stencil(s, "o0_st_test_inline_rax", true, [String]{}, c21.bytes, [StencilHole]{StencilHole{at: jo_at, kind: HOLE_ZERO32, param: ""}})
    ^c22: x64_code()
    x64_mov_rr(c22, X64_RDX, X64_RCX)
    x64_alu_rr(c22, X64Alu.Add, X64_RDX, X64_RDX)
    jo_at2: x64_jcc_rel32(c22, X64Cond.O)
    add_stencil(s, "o0_st_test_inline_rcx", true, [String]{}, c22.bytes, [StencilHole]{StencilHole{at: jo_at2, kind: HOLE_ZERO32, param: ""}})
}

add_float_stencils: fn(s: ^[StencilSpec]) Never! {
    fops: [X64FloatOp]{X64FloatOp.Add, X64FloatOp.Sub, X64FloatOp.Mul, X64FloatOp.Div}
    fnames: [String]{"add", "sub", "mul", "div"}
    loop idx in 0..<fops.len() {
        ^cd: x64_code()
        x64_float_op(cd, fops[idx], false, 0, 1)
        add_stencil(s, "o0_st_f64_{fnames[idx]}", true, [String]{}, cd.bytes, [StencilHole]{})
        ^cs: x64_code()
        x64_float_op(cs, fops[idx], true, 0, 1)
        add_stencil(s, "o0_st_f32_{fnames[idx]}", true, [String]{}, cs.bytes, [StencilHole]{})
        ^md8: x64_code()
        x64_float_op_mem(md8, fops[idx], false, 0, X64_RBP, SENTINEL_D8)
        add_stencil(s, "o0_st_f64_{fnames[idx]}_m8", true, [String]{"disp"}, md8.bytes, [StencilHole]{StencilHole{at: md8.bytes.len() - 1, kind: HOLE_I8, param: "disp"}})
        ^md32: x64_code()
        x64_float_op_mem(md32, fops[idx], false, 0, X64_RBP, SENTINEL_D32)
        add_stencil(s, "o0_st_f64_{fnames[idx]}_m32", true, [String]{"disp"}, md32.bytes, [StencilHole]{StencilHole{at: md32.bytes.len() - 4, kind: HOLE_I32, param: "disp"}})
        ^ms8: x64_code()
        x64_float_op_mem(ms8, fops[idx], true, 0, X64_RBP, SENTINEL_D8)
        add_stencil(s, "o0_st_f32_{fnames[idx]}_m8", true, [String]{"disp"}, ms8.bytes, [StencilHole]{StencilHole{at: ms8.bytes.len() - 1, kind: HOLE_I8, param: "disp"}})
        ^ms32: x64_code()
