#!/usr/bin/env jet
// The compiler's embedded Prelude sources, made by Compiler/build.jet's
// `prelude-sources` step. Each Prelude file below is the one source of the
// Jet text the compiler parses for it; the file that carries the text into
// the compiler is generated whole from it: its comment, its path constant and
// the raw-string constant holding the text byte for byte. The step keeps each
// generated file in git (`kept: true`), so the build rewrites a stale one and
// refuses a hand edit of it. Prelude/Effects.jet's copy
// (JET_CLI_EFFECT_SOURCE) is read at build time (JetFoundation EffectVocabulary.jet).
// Usage (from Compiler/): jet Toolchain/PreludeSources.jet [--check|--write]
// Paths are relative to the Compiler package, the step's working folder.
// --check fails when a generated file differs in any byte, inside its raw
// strings or outside them; --write rewrites the generated files.
use {
    files: core.files
    process: core.process
}

// A Prelude source and the constant whose raw text is its copy, with the
// comment above that constant and the `<constant>_PATH` value the compiler
// names the source by ("" when the target has none). A target holding more
// than one copy lists them in file order, one blank line apart.
PreludeCopy: struct {
    source: String
    target: String
    constant: String
    comment: String
    path: String
}

COPIES: [PreludeCopy]{
    PreludeCopy{source: "Prelude/Markers.jet", target: "JetFoundation/Source/Policy/PreludeMarkers.jet", constant: "MARKER_SOURCE", comment: "The marker vocabulary: one struct with an `impl Marker` block per rule. A\nmarker exists exactly when it is written here; every reader of the rule rows\n(parser, sema, `jet inspect`, `jet explain`) parses this one text. The text\nis Compiler/Prelude/Markers.jet, copied by `jet build Compiler`\n(Compiler/Toolchain/PreludeSources.jet): edit the Prelude file, not this\ncopy.", path: ""},
    PreludeCopy{source: "Prelude/Derives.jet", target: "JetSema/Source/Sema/Registration/PreludeDerives.jet", constant: "SEMA_PRELUDE_DERIVE_SOURCE", comment: "The built-in derive providers: Prelude markers whose typed `expand` bodies\nJetSema expands for each selected capability (Registration/Derives.jet). The\ntext is Compiler/Prelude/Derives.jet, copied by `jet build Compiler`\n(Compiler/Toolchain/PreludeSources.jet): edit the Prelude file, not this\ncopy.", path: "jet:canonical-prelude/Prelude/Derives.jet"},
    PreludeCopy{source: "Prelude/Errors.jet", target: "JetSema/Source/Sema/Registration/PreludeDerives.jet", constant: "SEMA_PRELUDE_ERROR_SOURCE", comment: "The standard library's own error family and its conversions into the\ndefault `Err`: ordinary Prelude source JetSema injects where a module needs it.\nThe text is Compiler/Prelude/Errors.jet, copied by `jet build Compiler`\n(Compiler/Toolchain/PreludeSources.jet): edit the Prelude file, not this\ncopy.", path: "jet:canonical-prelude/Prelude/Errors.jet"},
    PreludeCopy{source: "Prelude/Units.jet", target: "JetSema/Source/Sema/Registration/PreludeUnits.jet", constant: "SEMA_PRELUDE_UNITS_SOURCE", comment: "The standard unit catalog: ordinary Jet source that JetSema parses through\nthe generated-source parser into every program. Base families mint nominal\naxes; derived families claim structural products. The text is\nCompiler/Prelude/Units.jet, copied by `jet build Compiler`\n(Compiler/Toolchain/PreludeSources.jet): edit the Prelude file, not this\ncopy.", path: ""},
}

FENCE: "```"

#Error
PreludeSourcesError: struct {
    message: String
}

sources_fail: fn(message: String) -> PreludeSourcesError Never! {
    PreludeSourcesError{message: "prelude sources: {message}"}
}

read_text: fn(path: String) -[FS]> String PreludeSourcesError! {
    files.read(path) ?? return Err(sources_fail("cannot read {path}: {err}"))
}

TextFile: struct {
    path: String
    text: String
}

// One copy's block: its comment, its path constant and its raw string.
render_copy: fn(row: PreludeCopy, source: String) -> String PreludeSourcesError! {
    if source.contains(FENCE) -> return Err(sources_fail("{row.source} holds ``` and cannot be a raw string"))
    lines := [String]{}
    loop line in row.comment.split("\n") -> lines.push("// {line}")
    if row.path != "" -> lines.push("{row.constant}_PATH: \"{row.path}\"")
    Ok("{lines.join("\n")}\n{row.constant}: comptime {{ {FENCE}{source}{FENCE} }}\n")
}

// Every target, generated whole from `copies`, whose sources `read` holds.
render_targets: fn(copies: [PreludeCopy], read: [TextFile]) -> [TextFile] PreludeSourcesError! {
    out := [TextFile]{}
    loop row in copies {
        source := ""
        known := false
        loop file in read {
            if file.path == row.source {
                source = file.text.copy()
                known = true
            }
        }
        if !known -> return Err(sources_fail("no text for {row.source}"))
        block: render_copy(row, source) ?? return Err(err)
        found := -1
        loop (index, file) in out {
            if file.path == row.target -> found = index
        }
        if {
            found < 0 -> out.push(TextFile{path: row.target.copy(), text: block})
            else -> out[found].text = "{out[found].text}\n{block}"
        }
    }
    Ok(out)
}

generated_files: fn() -[FS]> [TextFile] PreludeSourcesError! {
    read := [TextFile]{}
    loop row in COPIES -> read.push(TextFile{path: row.source.copy(), text: read_text(row.source) ?? return Err(err)})
    render_targets(COPIES, read)
}

prelude_sources_main: fn(args: [String]) -[FS]> String PreludeSourcesError! {
    mode: if args.len() == 0 -> "--check" else -> args[0]
    if args.len() > 1 || (mode != "--check" && mode != "--write") -> return Err(sources_fail("usage: jet Toolchain/PreludeSources.jet [--check|--write]"))
    generated: generated_files() ?? return Err(err)
    differing := [String]{}
    loop file in generated {
        current: if files.exists(file.path) -> read_text(file.path) ?? return Err(err) else -> ""
        if current == file.text -> next
        differing.push(file.path.copy())
        if mode == "--write" -> files.write(file.path, file.text) ?? return Err(sources_fail("cannot write {file.path}: {err}"))
    }
    if mode == "--write" -> return Ok("prelude source copies written: {differing.len()} rewritten of {generated.len()}")
    if differing.len() == 0 -> return Ok("prelude sources check passed: {COPIES.len()} copies in {generated.len()} wholly generated files match")
    Err(sources_fail("{differing.join(", ")} differ from what Compiler/Prelude generates (a generated file takes no hand edit, inside its raw strings or outside them); run jet build Compiler"))
}

run: fn() { print(prelude_sources_main(process.args()) ?? process.fail(1, err.message)) }

#Test("a target is generated whole, its copies one blank line apart") {
    copies: [PreludeCopy]{
        PreludeCopy{source: "a.jet", target: "t.jet", constant: "A", comment: "First.\nSecond.", path: ""},
        PreludeCopy{source: "b.jet", target: "t.jet", constant: "B", comment: "Bee.", path: "jet:b.jet"},
        PreludeCopy{source: "a.jet", target: "u.jet", constant: "C", comment: "Sea.", path: ""},
    }
    read: [TextFile]{TextFile{path: "a.jet", text: "a: 1\n"}, TextFile{path: "b.jet", text: "b: 2\n"}}
    out: render_targets(copies, read) ?? panic(err.message)
    assert_eq(out.len(), 2)
    assert_eq(out[0].path, "t.jet")
    assert_eq(out[0].text, "// First.\n// Second.\nA: comptime {{ ```a: 1\n``` }}\n\n// Bee.\nB_PATH: \"jet:b.jet\"\nB: comptime {{ ```b: 2\n``` }}\n")
    assert_eq(out[1].text, "// Sea.\nC: comptime {{ ```a: 1\n``` }}\n")
    if render_targets(copies, [TextFile]{TextFile{path: "a.jet", text: "has ``` inside"}, TextFile{path: "b.jet", text: ""}}) == .Ok(_) -> panic("a fence in the source must fail")
    if render_targets(copies, [TextFile]{TextFile{path: "a.jet", text: ""}}) == .Ok(_) -> panic("a source with no text must fail")
}
