#!/usr/bin/env jet
// The Jet runtime pack beside a hosted compiler, made by Compiler/build.jet's
// `runtime` step, and the runtime's one-namespace unit.
//
//   jet Toolchain/RuntimePack.jet pack --jet=JET --tree=DIR... --out=DIR
//       --identity=FILE
//   jet Toolchain/RuntimePack.jet [--root DIR] unit OUT [--test NAME]...
//   jet Toolchain/RuntimePack.jet [--root DIR] unit OUT --check
//
// Paths are relative to the Compiler package (the step's working folder;
// `--root`, default the working directory, for `unit`). Every path the pack
// records is the checkout's (Compiler/...), so the pack is
// the same wherever the package sits.
//
// `pack` lowers Compiler/JetRuntime/sources.list and lifecycle.list as one
// object with JET, the jet-bare this build made: its native library hook writes
// the object, the prelinked pack and image, the web partition and the Core
// library (jet_core.o, core.exports, core.facts, core.seal, core.threads:
// every non-generic function of a shipped package of JET's embedded Core as
// a global symbol, which of them a bound program may take as sealed, and
// what it may know of them unchecked), core.interface (each embedded
// Core unit's load rows and function body spans, JetDriver
// CoreInterface.jet) and core.bodies (the Core function checks as the
// Core library's check left them, JetSema CoreBodies.jet),
// which the image links beside the runtime and the pack does not. A `jet
// run` whose Core is the Core built into jet binds its Core calls to the
// image's Core code, or to jet_core.o's in a full link (JetCLI Host.jet). Jet's
// linker binds those objects alone; the pack links no C (#6693). No Rust
// compiler, Rust runtime or system linker runs, and no `nm`: the step reads
// the symbol tables of every object it makes itself and refuses
// Rust symbols (built_object_digest). The `--tree` folders are the runtime's and
// its producer's sources: the IR builder, optimizer and selector, the x86-64
// encoder, object writer and linker, and the WebAssembly selector and
// encoder of the web partition. Their files make up the pack's identity.
//
// The pack carries no C, libc or compiler runtime archive, and the step runs
// no C compiler or archiver. A program's C closure takes libc from jet's C
// toolchain pack (Compiler/JetCLI ForeignLink.jet).
//
// The pack's files land in OUT, and OUT/native.key holds its content
// identity. FILE gets JET's identity, `jet@<JET_VERSION>#<sha256 of JET>`:
// the version JET names in `jet --version --json` (its `release`) and the
// bytes JET lowers the runtime under. The step declares each file, so the
// build publishes the pack and IDENTITY in jet-runtime/, where jet-bare reads
// the pack, and the `core-embed` step adds them to jet as parts (JetCLI
// RuntimeEmbed.jet), which checks that IDENTITY names the jet that lowered
// the runtime. The release gate holds provenance.json's compilerSha256 to
// that part (Tools/Release Gate.jet).
//
// `unit` writes the runtime's one-namespace unit, OUT/unit.jet, and its
// OUT/package.jet, then prints OUT/unit.jet: each sources.list source after a
// `// [unit source: PATH]` line, its Core imports dropped and gathered once
// each, in first-seen order, at the head of the unit, and its other imports
// dropped. Each `--test NAME` appends the fragment
// Compiler/JetRuntime/Tests/Fragments.fixture/NAMETests.jet, in order, and
// any `--test` writes a test package of the driver's one edition instead of
// the runtime's package.jet. `unit OUT --check` composes every fragment of
// Fragments.fixture, sorted, into one test unit and type-checks it with $JET
// (default `jet`) under JET_KEEP_GOING=1: the compiler's output with each
// error location followed by the source it falls in, then one
// `SOURCE<TAB>ERRORS` row per unit source; exit 0 only with no error. It is
// the check of Fragments.fixture, whose files compile only in that unit.
use {
    crypto: core.crypto
    files: core.files
    json: core.encoding.json
    process: core.process
    re: core.regex
    term: core.term
}

USAGE: "usage: jet Toolchain/RuntimePack.jet pack --jet=JET --tree=DIR... --out=DIR --identity=FILE\n       jet Toolchain/RuntimePack.jet [--root DIR] unit OUT [--test NAME]...|--check"

// The checkout folder of the Compiler package, which every recorded path names.
PACKAGE: "Compiler"

RUNTIME_SOURCES: "Compiler/JetRuntime/sources.list"

RUNTIME_PACKAGE: "Compiler/JetRuntime/package.jet"

RUNTIME_LIFECYCLE: "Compiler/JetRuntime/lifecycle.list"

// The embedded jet.runtime interface (JetDriver RuntimeInterface.jet): the
// runtime production renders it from the runtime source, and the pack fails
// when this copy disagrees.
RUNTIME_INTERFACE: "Compiler/JetFoundation/Source/Registry/RuntimeInterface.jet"

RUNTIME_FRAGMENTS: "Compiler/JetRuntime/Tests/Fragments.fixture"

DRIVER_LOADER: "Compiler/JetDriver/Source/Driver/Loader.jet"

// The runtime's folder; every other `--tree` folder is its producer's.
RUNTIME_TREE: "JetRuntime"

// JetSema's unit map (UnsafeObligations.jet) reads this mark too.
UNIT_SOURCE_MARK: "// [unit source: "

// A package.jet's `policy: { memory: .Kernel([...]) }` list, and each path in it.
MEMORY_KERNEL_FIELD: Regex{"\bmemory\s*:\s*\.\s*Kernel\s*\(\s*\[([^\]]*)\]"}

QUOTED_PATH: Regex{"\"([^\"]*)\""}

InventoryFile: struct {
    path: String,
    sha256: String,
}

Inventory: struct {
    sha256: String,
    files: [InventoryFile],
}

Toolchain: struct {
    root: String,
    jet: String,
    // `jet@<JET_VERSION>` of the built jet, the running compiler's.
    version: String,
    out: String,
}

fail: fn(message: String) -> Never { process.fail(1, "runtime-pack: {message}") }

// The file a checkout path names in the package at `root`.
at: fn(root: String, path: String) -> String {
    rest: path.removeprefix("{PACKAGE}/")
    if rest.len() == path.len() -> fail("`{path}` is outside the {PACKAGE} package")
    files.join(root, rest)
}

sha256_file: fn(path: String) -> String {
    crypto.sha256(files.read_bytes(path) ?? fail("cannot read `{path}`: {err}")).hex()
}

// The sorted unique checkout paths, each file's sha256, and one sha256 over
// `<path byte count>:<path>:<size>:<bytes>` per file. `where` gives the file a
// path names.
inventory: fn(paths: [String], where: fn(String) -> String) -> Inventory {
    ^sorted: paths.copy()
    sorted.sort()
    ^total: crypto.new()
    ^rows: [InventoryFile]{}
    loop path in sorted {
        if rows.len() > 0 && rows[rows.len() - 1].path == path -> next
        bytes: files.read_bytes(where(path)) ?? fail("cannot read `{path}`: {err}")
        total.update("{path.count_bytes()}:{path}:{bytes.len()}:".bytes())
        total.update(bytes)
        rows.push(InventoryFile{path: path.copy(), sha256: crypto.sha256(bytes).hex()})
    }
    Inventory{sha256: total.digest(), files: rows}
}

// Every file under `directory` that `keep` accepts, relative to it, sorted.
tree_files: fn(directory: String, keep: fn(String) -> Bool) -> [String] {
    ^found: [String]{}
    entries: files.walk_files(directory).list() ?? fail("cannot list `{directory}`: {err}")
    loop entry in entries {
        if keep(files.basename(entry.relative)) -> found.push(entry.relative.copy())
    }
    found.sort()
    found
}

// The `width`-byte little-endian unsigned value at `at` in `b`, -1 when it
// runs past the end.
le: fn(b: [U8], at: Int, width: Int) -> Int {
    if at < 0 || at + width > b.len() -> return -1
    ^value: 0
    loop k in 0..<width -> value = value * 256 + (Int{b[at + width - 1 - k]})
    value
}

// The NUL-terminated name at `at`, ending at `end` at the latest.
c_string: fn(b: [U8], at: Int, end: Int) -> String {
    ^stop: at
    loop stop < end && (Int{b[stop]}) != 0 -> stop += 1
    String.from_bytes_lossy(b.slice(at, stop))
}

// Appends every name in the symbol tables (SHT_SYMTAB and SHT_DYNSYM) of the
// 64-bit little-endian ELF object at b[base..<end] to `names`; what is wrong
// with it, else "".
elf_symbol_names: fn(b: [U8], base: Int, end: Int, what: String, names: ^[String]) -> String {
    size: end - base
    if size < 64 || le(b, base, 4) != 1179403647 || le(b, base + 4, 2) != 258 {
        return "{what} is not a 64-bit little-endian ELF object"
    }
    shoff: le(b, base + 40, 8)
    shentsize: le(b, base + 58, 2)
    ^shnum: le(b, base + 60, 2)
    if shoff == 0 -> return ""
    if shentsize < 64 || shoff < 0 || shoff + shentsize > size {
        return "{what} has a malformed section header table"
    }
    // More than 0xff00 sections: section 0's sh_size holds the count.
    if shnum == 0 -> shnum = le(b, base + shoff + 32, 8)
    if shnum < 0 || shoff + shnum * shentsize > size {
        return "{what} has a malformed section header table"
    }
    loop i in 0..<shnum {
        header: base + shoff + i * shentsize
        kind: le(b, header + 4, 4)
        if kind != 2 && kind != 11 -> next
        table: le(b, header + 24, 8)
        table_size: le(b, header + 32, 8)
        link: le(b, header + 40, 4)
        entry: le(b, header + 56, 8)
        if entry < 24 || link >= shnum || table < 0 || table_size < 0 || table + table_size > size {
            return "{what} has a malformed symbol table"
        }
        strings: le(b, base + shoff + link * shentsize + 24, 8)
        strings_size: le(b, base + shoff + link * shentsize + 32, 8)
        if strings < 0 || strings_size < 0 || strings + strings_size > size {
            return "{what} has a malformed string table"
        }
        ^at: base + table
        loop at + entry <= base + table + table_size {
            name: le(b, at, 4)
            if name >= strings_size -> return "{what} has a symbol name outside its string table"
            text: c_string(b, base + strings + name, base + strings + strings_size)
            if text != "" -> names.push(text)
            at += entry
        }
    }
    ""
}

// Appends every symbol name of the ELF object `b` (the file `what`) to
// `names`; the problem, else "".
symbol_names: fn(b: [U8], what: String, names: ^[String]) -> String {
    elf_symbol_names(b, 0, b.len(), what, names)
}

// Whether the NUL-terminated symbol name starting at `at` (before `end`)
// matches `^(?:_R[A-Z]|_ZN[0-9]|__rust_|__rdl_)`.
is_rust_symbol_bytes: fn(b: [U8], at: Int, end: Int) -> Bool {
    if at >= end || b[at] != 95 -> return false
    if at + 2 < end && b[at + 1] == 82 {
        c: b[at + 2]
        return c >= 65 && c <= 90
    }
    if at + 3 < end && b[at + 1] == 90 && b[at + 2] == 78 {
        c: b[at + 3]
        return c >= 48 && c <= 57
    }
    if at + 5 < end && b[at + 1] == 95 && b[at + 2] == 114 {
        if b[at + 3] == 100 && b[at + 4] == 108 && b[at + 5] == 95 -> return true
        if at + 6 < end && b[at + 3] == 117 && b[at + 4] == 115 && b[at + 5] == 116 && b[at + 6] == 95 {
            return true
        }
    }
    false
}

// The Rust symbols among the symbol names of `bytes` (the file `what`), or
// why they can't be read, else "".
rust_symbols: fn(bytes: [U8], what: String) -> String {
    size: bytes.len()
    if size < 64 || le(bytes, 0, 4) != 1179403647 || le(bytes, 4, 2) != 258 {
        return "{what} is not a 64-bit little-endian ELF object"
    }
    shoff: le(bytes, 40, 8)
    shentsize: le(bytes, 58, 2)
    ^shnum: le(bytes, 60, 2)
    if shoff == 0 -> return ""
    if shentsize < 64 || shoff < 0 || shoff + shentsize > size {
        return "{what} has a malformed section header table"
    }
    if shnum == 0 -> shnum = le(bytes, shoff + 32, 8)
    if shnum < 0 || shoff + shnum * shentsize > size {
        return "{what} has a malformed section header table"
    }
    ^forbidden: [String]{}
    loop i in 0..<shnum {
        header: shoff + i * shentsize
        kind: le(bytes, header + 4, 4)
        if kind != 2 && kind != 11 -> next
        table: le(bytes, header + 24, 8)
        table_size: le(bytes, header + 32, 8)
        link: le(bytes, header + 40, 4)
        entry: le(bytes, header + 56, 8)
        if entry < 24 || link >= shnum || table < 0 || table_size < 0 || table + table_size > size {
            return "{what} has a malformed symbol table"
        }
        strings: le(bytes, shoff + link * shentsize + 24, 8)
        strings_size: le(bytes, shoff + link * shentsize + 32, 8)
        if strings < 0 || strings_size < 0 || strings + strings_size > size {
            return "{what} has a malformed string table"
        }
        strings_end: strings + strings_size
        table_end: table + table_size
        ^at: table
        loop at + entry <= table_end {
            name: Int{bytes[at]} + (Int{bytes[at + 1]} << 8) + (Int{bytes[at + 2]} << 16) + (Int{bytes[at + 3]} << 24)
            if name >= strings_size -> return "{what} has a symbol name outside its string table"
            if is_rust_symbol_bytes(bytes, strings + name, strings_end) {
                text: c_string(bytes, strings + name, strings_end)
                if text != "" -> forbidden.push(text.copy())
            }
            at += entry
        }
    }
    if forbidden.len() > 0 -> return "Rust symbols in {what}:\n{forbidden.join("\n")}"
    ""
}

// A file's sha256, or the problem the step fails with over it.
FileDigest: struct {
    sha256: String,
    problem: String,
}

file_digest: fn(path: String) -> FileDigest {
    bytes: files.read_bytes(path) ?? return FileDigest{sha256: "", problem: "cannot read `{path}`: {err}"}
    FileDigest{sha256: crypto.sha256(bytes).hex(), problem: ""}
}

// The digest of the object the step built at `path`, which holds no Rust
// symbol: its bytes are read once for both.
built_object_digest: fn(path: String) -> FileDigest {
    bytes: files.read_bytes(path) ?? return FileDigest{sha256: "", problem: "cannot read `{path}`: {err}"}
    problem: rust_symbols(bytes, path)
    if problem != "" -> return FileDigest{sha256: "", problem: problem}
    FileDigest{sha256: crypto.sha256(bytes).hex(), problem: ""}
}

// The digests of the built objects `objects` (built_object_digest), then of
// the files `others`, in order, each read and hashed on a task of its own:
// together they are hundreds of megabytes. Nothing fails here; digest_of
// reports a problem where the step reads that digest.
digests: fn(objects: [String], others: [String]) -> [FileDigest] {
    ^found: [FileDigest]{}
    task.group hashing {
        built: loop path in objects -> task built_object_digest(path)
        plain: loop path in others -> task file_digest(path)
        loop (index, handle) in built {
            found.push(handle.join() ?? FileDigest{sha256: "", problem: "hashing `{objects[index]}` stopped"})
        }
        loop (index, handle) in plain {
            found.push(handle.join() ?? FileDigest{sha256: "", problem: "hashing `{others[index]}` stopped"})
        }
    }
    found
}

// The sha256 `found` holds, moved out; the step fails with its problem.
digest_of: fn(found: ^^FileDigest) -> String {
    if found.problem != "" -> fail(found.problem)
    found.sha256.move()
}

inventory_value: fn(found: Inventory) -> Dyn {
    rows: loop row in found.files -> Dyn.Object([String:Dyn]{"path": Dyn.Text(row.path.copy()), "sha256": Dyn.Text(row.sha256.copy())})
    Dyn.Object([String:Dyn]{"sha256": Dyn.Text(found.sha256.copy()), "files": Dyn.Array(rows)})
}

compact: fn(value: Dyn) -> String { json.dumps(value) ?? fail("cannot render JSON: {err}") }

sha256_json: fn(value: Dyn) -> String { crypto.sha256(compact(value).bytes()).hex() }

// The recipe the pack is a function of (format jet-native-runtime-recipe/v3).
pack_recipe: fn(source: String, backend: String, lifecycle: String, compiler: String) -> String {
    sha256_json(
        Dyn.Object(
            [String:Dyn]{
                "format": Dyn.Text("jet-native-runtime-recipe/v3"),
                "source": Dyn.Text(source.copy()),
                "backend": Dyn.Text(backend.copy()),
                "lifecycle": Dyn.Text(lifecycle.copy()),
                "compiler": Dyn.Text(compiler.copy()),
            },
        ),
    )
}

// The pack's content identity, native.key (format jet-native-runtime/v6):
// the runtime's source, ABI, thread receipt, stops receipt, backend and
// lifecycle, and `core`, the digests of the Core library's object, export
// list and thread receipt, which the image links beside the runtime.
pack_identity: fn(source: String, abi: String, threads: String, stops: String, backend: String, lifecycle: String, core: String) -> String {
    sha256_json(
        Dyn.Object(
            [String:Dyn]{
                "format": Dyn.Text("jet-native-runtime/v6"),
                "source": Dyn.Text(source.copy()),
                "abi": Dyn.Text(abi.copy()),
                "threads": Dyn.Text(threads.copy()),
                "stops": Dyn.Text(stops.copy()),
                "backend": Dyn.Text(backend.copy()),
                "lifecycle": Dyn.Text(lifecycle.copy()),
                "core": Dyn.Text(core.copy()),
            },
        ),
    )
}

field: fn(value: Dyn, key: String) -> Dyn {
    if value == {
        .Object(fields) -> {
            loop entry in fields {
                if entry.key == key -> return entry.value.copy()
            }
        }
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Array(_) -> {}
    }
    Dyn.Null
}

text_of: fn(value: Dyn) -> String {
    if value == {
        .Text(found) -> found
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Bytes(_) | .DateTime(_) | .Array(_) | .Object(_) -> ""
    }
}

items_of: fn(value: Dyn) -> [Dyn] {
    if value == {
        .Array(items) -> items
        .Null | .Bool(_) | .Int(_) | .Float(_) | .Number(_) | .Text(_) | .Bytes(_) | .DateTime(_) | .Object(_) -> [Dyn]{}
    }
}

// The sorted symbols of a runtime ABI inventory, or [] when it is not a
// non-empty array.
abi_symbols: fn(text: String) -> [String] {
    abi: json.parse(text) ?? return [String]{}
    ^symbols: loop row in items_of(abi) -> text_of(field(row, "symbol"))
    symbols.sort()
    symbols
}

export_names: fn(text: String) -> [String] {
    ^names: text.trim().split("\n").to_list()
    names.sort()
    names
}

copy_into: fn(from: String, to: String) {
    files.copy(from, to) ?? fail("cannot copy `{from}` to `{to}`: {err}")
}

// Publishes the work file `from` at `to`: renamed, so no byte is copied,
// unless the rename can't move it (`to` on another file system), then copied.
// Either way `to` keeps the file's bytes and mode.
move_into: fn(from: String, to: String) {
    if files.rename(from, to) == .Ok(_) {
        return
    }
    copy_into(from, to)
}

// `--name=value` flags; `--tree` may repeat.
Flags: struct {
    values: [String:String],
    trees: [String],
}

parse_flags: fn(args: [String]) -> Flags {
    ^values: [String:String]{}
    ^trees: [String]{}
    loop arg in args {
        if !arg.starts_with("--") || !arg.contains("=") -> fail(USAGE)
        pair: arg.removeprefix("--").partition("=")
        if pair.tail == "" -> fail(USAGE)
        if pair.head == "tree" {
            trees.push(pair.tail.copy())
            next
        }
        if values.get(pair.head) != None -> fail("--{pair.head} is given twice")
        values[pair.head] = pair.tail.copy()
    }
    Flags{values: values, trees: trees}
}

flag: fn(flags: Flags, name: String) -> String {
    flags.values.get(name) ?? fail("--{name} is missing\n{USAGE}")
}

// The step's absolute path of `path`.
absolute: fn(path: String) -> String {
    files.absolute(path) ?? fail("cannot resolve `{path}`: {err}")
}

pack: fn(args: [String]) {
    flags: parse_flags(args)
    known: [String]{"jet", "out", "identity"}
    loop entry in flags.values {
        if !known.contains(entry.key) -> fail("unknown flag --{entry.key}\n{USAGE}")
    }
    if !flags.trees.contains(RUNTIME_TREE) {
        fail("the --tree folders must include the runtime's, {RUNTIME_TREE}")
    }
    root: absolute(".")
    identity: flag(flags, "identity")
    jet: absolute(flag(flags, "jet"))
    info: files.stat(jet) ?? fail("cannot inspect `{jet}`: {err}")
    if (info.mode /% 64) % 2 == 0 {
        files.set_mode(jet, 493) ?? fail("cannot make `{jet}` executable: {err}")
    }
    // The step's folder, not /tmp: the runtime build's files outgrow a small
    // temporary file system.
    work: files.join(root, ".runtime-pack")
    files.remove_all(work) ?? ()
    files.create_dir_all(work) ?? fail("cannot create `{work}`: {err}")
    library: files.join(work, "library")
    ^compiler_digests: [FileDigest]{}
    ^versions: [String]{}
    task.group prep {
        t_hash: task file_digest(jet)
        t_ver: task built_version(jet)
        ^_: compose_unit(root, library, [String]{})
        compiler_digests.push(t_hash.join() ?? FileDigest{sha256: "", problem: "hashing `{jet}` stopped"})
        versions.push(t_ver.join() ?? fail("reading version of `{jet}` stopped"))
    }
    compiler_sha256: digest_of(compiler_digests.pop() ?? fail("the compiler digest was not read"))
    version: versions.pop() ?? fail("the compiler version was not read")
    tool: Toolchain{root: root, jet: jet.copy(), version: "jet@{version}", out: absolute(flag(flags, "out"))}
    build(tool, work, library, flags, compiler_sha256)
    files.remove_all(work) ?? ()
    files.write(identity, "{tool.version}#{compiler_sha256}\n") ?? fail("cannot write `{identity}`: {err}")
}

// The inventories of the runtime's sources, the trees `flags` name and the
// lifecycle hooks.
PackInventories: struct {
    source: Inventory,
    backend: Inventory,
    lifecycle: Inventory,
}

pack_inventories: fn(root: String, flags: Flags) -> PackInventories {
    manifest: files.read(at(root, RUNTIME_SOURCES)) ?? fail("cannot read `{RUNTIME_SOURCES}`: {err}")
    ^sources: runtime_sources(manifest)
    // Each source's package.jet names its memory kernel, which the unit's
    // check reads (unit_kernel), so it is part of the pack's source.
    ^source_paths: [String]{RUNTIME_SOURCES, RUNTIME_PACKAGE}
    loop directory in unit_packages(root, sources) -> source_paths.push("{directory}/package.jet")
    source_paths.extend(sources.move())
    in_package: fn(path: String) -> String { at(root, path) }
    source: inventory(source_paths, in_package)
    ^backend_paths: [String]{}
    loop tree in flags.trees {
        if tree == RUNTIME_TREE -> next
        directory: "{PACKAGE}/{tree}"
        loop path in tree_files(at(root, directory), fn(name: String) { name.ends_with(".jet") }) {
            backend_paths.push("{directory}/{path}")
        }
    }
    backend: inventory(backend_paths, in_package)
    lifecycle: inventory([String]{RUNTIME_LIFECYCLE}, in_package)
    PackInventories{source: source, backend: backend, lifecycle: lifecycle}
}

// The JET_VERSION the jet at `jet` was built at: the `release` of its
// `--version --json`.
built_version: fn(jet: String) -> String {
    text: output_of(process.cmd([String]{jet.copy(), "--version", "--json"}).env_remove("JET_TOOLCHAIN_ROOT"), "{jet} --version --json")
    facts: json.parse(text.trim()) ?? fail("`{jet} --version --json` is not JSON: {err}")
    version: text_of(field(facts, "release"))
    if version == "" || version.contains(" ") || version.contains("#") || version.contains("@") {
        fail("`{jet} --version --json` names no release version")
    }
    version
}

// A command that must exit 0; its stdout.
output_of: fn(spec: ProcessSpec, what: String) -> String {
    receipt: spec.output_limit(268435456).run() ?? fail("{what} could not start: {err}")
    if receipt.code != 0 || receipt.signal != None {
        fail("{what} failed ({receipt.code}):\n{receipt.errors}")
    }
    receipt.output
}

// The runtime build's issue reports and Core's skipped list, kept in OUT
// when it fails; the issue reports are printed to stderr too, so the failed
// build's log names the issues.
keep_issues: fn(work: String, out: String) {
    suffixes: [String]{".issues", ".pack-issues"}
    loop suffix in suffixes {
        path: files.join(work, "jet_runtime_jet{suffix}")
        if !files.exists(path) -> next
        files.copy(path, files.join(out, "runtime{suffix}")) ?? ()
        print_issues(path)
    }
    core_names: [String]{"issues", "skipped"}
    loop name in core_names {
        core_file: files.join(work, "jet_core.{name}")
        if !files.exists(core_file) -> next
        files.copy(core_file, files.join(out, "core.{name}")) ?? ()
        if name == "issues" -> print_issues(core_file)
    }
}

// Prints the issue report at `path` to stderr.
print_issues: fn(path: String) {
    text: files.read(path) ?? return
    term.eprint("runtime-pack: {path}:\n{text.trim()}")
}

// Builds the pack in `work` and publishes it in `tool.out`.
build: fn(tool: Toolchain, work: String, library: String, flags: Flags, compiler_sha256: String) {
    prefix: files.join(work, "jet_runtime_jet")
    // The Core code library (JetCLI CoreLibrary.jet): every non-generic Core
    // function as a global symbol, which the image links beside the runtime.
    core: files.join(work, "jet_core")
    pack: files.join(work, "jet_runtime.pack.o")
    // The runtime object and the Core object, prelinked at the run base,
    // which `jet run` binds programs to; the pack stays the runtime's alone.
    image: files.join(work, "jet_runtime.image")
    // The runtime partition of a web build (JetWeb Build.jet) and its receipt.
    web: files.join(work, "jet_runtime")
    // The child's own files stay in the step's folder.
    home: files.join(work, "home")
    temporary: files.join(work, "tmp")
    files.create_dir_all(temporary) ?? fail("cannot create `{temporary}`: {err}")
    // The runtime-library seam in the hosted source loader (Request.jet
    // jet_cli_compile_prepared) under `jet doc`: the checked program stopped
    // before lowering, then built as IR; under the seam `jet doc` builds no
    // index or pages. The jet reads its own embedded Core, and the Core
    // library is built from it.
    doc: process.cmd([String]{tool.jet.copy(), "doc", files.join(library, "unit.jet")}).cwd(library)
        .stdin(.Inherit).stdout(.Inherit).stderr(.Inherit)
        .env_remove("JET_TOOLCHAIN_ROOT")
        .env("JET_COMPILER_IDENTITY", "{tool.version}#{compiler_sha256}")
        .env("HOME", home)
        .env("TMPDIR", temporary)
        .env("XDG_CACHE_HOME", files.join(home, ".cache"))
        .env("JET_FRONT_LIBRARY_OBJECT_OUTPUT", prefix)
        .env("JET_FRONT_LIBRARY_LIFECYCLE", at(tool.root, RUNTIME_LIFECYCLE))
        .env("JET_FRONT_RUNTIME_PACK_OUTPUT", pack)
        .env("JET_FRONT_RUNTIME_IMAGE_OUTPUT", image)
        .env("JET_FRONT_RUNTIME_WEB_OUTPUT", web)
        .env("JET_FRONT_CORE_OBJECT_OUTPUT", core)
    ^inventories: [PackInventories]{}
    task.group run_doc {
        t_inv: task pack_inventories(tool.root, flags)
        if doc.run() == {
            .Ok(receipt) -> {
                if receipt.code != 0 || receipt.signal != None {
                    files.create_dir_all(tool.out) ?? ()
                    keep_issues(work, tool.out)
                    fail("Jet runtime production failed ({receipt.code})")
                }
            }
            .Err(error) -> fail("Jet runtime production could not start: {error}")
        }
        inventories.push(t_inv.join() ?? fail("the pack's input inventories stopped"))
    }
    inv: inventories.pop() ?? fail("the pack's input inventories were not read")
    source: inv.source
    backend: inv.backend
    lifecycle: inv.lifecycle
    recipe: pack_recipe(source.sha256, backend.sha256, lifecycle.sha256, compiler_sha256)
    // Every output the provenance names is read once and hashed on tasks while
    // the text receipts and interface are checked on the main thread; each
    // built object is read once for its Rust check and its digest too.
    ^hashed: [FileDigest]{}
    ^abi_sha256: ""
    ^threads_sha256: ""
    ^stops_sha256: ""
    task.group verify_and_hash {
        t_hash: task digests([String]{"{prefix}.o", pack, image, "{core}.o"}, [String]{"{core}.exports", "{core}.facts", "{core}.seal", "{core}.threads", "{core}.interface", "{core}.bodies", "{web}.wasm"})
        abi_text: files.read("{prefix}.abi.json") ?? fail("cannot read the runtime ABI inventory: {err}")
        symbols: abi_symbols(abi_text)
        if symbols.len() == 0 -> fail("runtime ABI inventory is empty")
        exports: export_names(files.read("{prefix}.exports") ?? fail("cannot read the runtime exports: {err}"))
        if symbols != exports -> fail("runtime ABI and checked exports disagree")
        abi_sha256 = crypto.sha256(abi_text.bytes()).hex()
        // The stops receipt (Request.jet ir_stop_exports): the exports whose
        // call can publish a stop. The runtime's scheduler always has some, so an
        // empty one means the stop publisher it is read from was renamed away.
        stops: files.read("{prefix}.stops") ?? fail("cannot read the runtime stops receipt: {err}")
        if stops.trim() == "" {
            fail("the runtime stops receipt is empty: no export reaches the stop publisher (JetIR BuildLibrary.jet IR_STOP_PUBLISH)")
        }
        loop name in stops.split("\n") {
            if name != "" && !exports.contains(name) {
                fail("runtime stops receipt names a symbol the checked exports lack")
            }
        }
        // The thread receipt (Request.jet ir_thread_exports): the exports that can
        // start a second thread, or `*` when a lifecycle hook can.
        threads: files.read("{prefix}.threads") ?? fail("cannot read the runtime thread receipt: {err}")
        thread_rows: threads.split("\n").to_list()
        thread_names: loop name in thread_rows.move() if name != "" -> name
        if !(thread_names.len() == 1 && thread_names[0] == "*") && thread_names.any(fn(name) { !exports.contains(name) }) {
            fail("runtime thread receipt names a symbol the checked exports lack")
        }
        check_core_library(core, tool.out)
        // The jet.runtime interface the runtime source renders (Request.jet
        // jet_cli_runtime_library) must be the copy jet embeds; a stale copy fails
        // the pack with the rendered file beside the outputs.
        rendered: files.read("{prefix}.interface.jet") ?? fail("cannot read the rendered runtime interface: {err}")
        embedded: files.read(at(tool.root, RUNTIME_INTERFACE)) ?? fail("cannot read `{RUNTIME_INTERFACE}`: {err}")
        if rendered != embedded {
            files.create_dir_all(tool.out) ?? ()
            stale: files.join(tool.out, "runtime.interface.jet")
            copy_into("{prefix}.interface.jet", stale)
            fail("`{RUNTIME_INTERFACE}` disagrees with the interface the runtime source renders; copy `{stale}` over it")
        }
        threads_sha256 = crypto.sha256(threads.bytes()).hex()
        stops_sha256 = crypto.sha256(stops.bytes()).hex()
        hashed = t_hash.join() ?? fail("hashing runtime outputs stopped")
    }
    object_sha256: digest_of(hashed[0])
    pack_sha256: digest_of(hashed[1])
    image_sha256: digest_of(hashed[2])
    core_object_sha256: digest_of(hashed[3])
    core_exports_sha256: digest_of(hashed[4])
    core_facts_sha256: digest_of(hashed[5])
    core_seal_sha256: digest_of(hashed[6])
    core_threads_sha256: digest_of(hashed[7])
    core_interface_sha256: digest_of(hashed[8])
    core_bodies_sha256: digest_of(hashed[9])
    // The Core object's, export list's, facts', seal's, thread receipt's, interface's and bodies' digests.
    core_sha256: "{core_object_sha256} {core_exports_sha256} {core_facts_sha256} {core_seal_sha256} {core_threads_sha256} {core_interface_sha256} {core_bodies_sha256}"
    key: pack_identity(source.sha256, abi_sha256, threads_sha256, stops_sha256, backend.sha256, lifecycle.sha256, core_sha256)
    out: tool.out
    files.create_dir_all(out) ?? fail("cannot create `{out}`: {err}")
    web_sha256: digest_of(hashed[10])
    move_into("{prefix}.o", files.join(out, "jet_runtime_jet.o"))
    move_into("{prefix}.abi.json", files.join(out, "runtime.abi.json"))
    move_into("{prefix}.exports", files.join(out, "runtime.exports"))
    move_into("{prefix}.threads", files.join(out, "runtime.threads"))
    move_into("{prefix}.stops", files.join(out, "runtime.stops"))
    // The debugger's eval link receipt (JetIR EvalLink.jet
    // ir_eval_link_receipt): nothing links it, so it is no part of the
    // pack's identity.
    move_into("{prefix}.eval", files.join(out, "runtime.eval"))
    move_into("{core}.o", files.join(out, "jet_core.o"))
    move_into("{core}.exports", files.join(out, "core.exports"))
    move_into("{core}.facts", files.join(out, "core.facts"))
    move_into("{core}.seal", files.join(out, "core.seal"))
    move_into("{core}.threads", files.join(out, "core.threads"))
    move_into("{core}.interface", files.join(out, "core.interface"))
    move_into("{core}.bodies", files.join(out, "core.bodies"))
    move_into(pack, files.join(out, "jet_runtime.pack.o"))
    move_into(image, files.join(out, "jet_runtime.image"))
    move_into("{web}.wasm", files.join(out, "jet_runtime.wasm"))
    move_into("{web}.wasm.tsv", files.join(out, "jet_runtime.wasm.tsv"))
    fields: [String:Dyn]{
        "backend": Dyn.Text("jet-native"),
        "runtimeKey": Dyn.Text(key.copy()),
        "objectSha256": Dyn.Text(object_sha256),
        "packSha256": Dyn.Text(pack_sha256),
        "imageSha256": Dyn.Text(image_sha256),
        "webSha256": Dyn.Text(web_sha256),
        "rustObjects": Dyn.Int(0),
        "llvmObjects": Dyn.Int(0),
        "abiSha256": Dyn.Text(abi_sha256.move()),
        "threadsSha256": Dyn.Text(threads_sha256.move()),
        "stopsSha256": Dyn.Text(stops_sha256.move()),
        "source": inventory_value(source),
        "backendInputs": inventory_value(backend),
        "lifecycle": inventory_value(lifecycle),
        "compilerSha256": Dyn.Text(compiler_sha256.copy()),
        "recipeSha256": Dyn.Text(recipe.copy()),
        "coreObjectSha256": Dyn.Text(core_object_sha256),
        "coreExportsSha256": Dyn.Text(core_exports_sha256),
        "coreFactsSha256": Dyn.Text(core_facts_sha256),
        "coreSealSha256": Dyn.Text(core_seal_sha256),
        "coreThreadsSha256": Dyn.Text(core_threads_sha256),
        "coreInterfaceSha256": Dyn.Text(core_interface_sha256),
        "coreBodiesSha256": Dyn.Text(core_bodies_sha256),
    }
    provenance: Dyn.Object(fields)
    text: "{json.to_string_pretty(provenance) ?? fail("cannot render the provenance: {err}")}\n"
    files.write(files.join(out, "provenance.json"), text) ?? fail("cannot write the provenance: {err}")
    files.write(files.join(out, "native.key"), "{key}\n") ?? fail("cannot write native.key: {err}")
}

// The Core library's export list (JetIR BuildCore.jet ir_core_exports_text:
// symbol, key and IR signature per line) and its thread receipt, which names
// Core exports, or is `*`.
check_core_library: fn(core: String, out: String) {
    core_text: files.read("{core}.exports") ?? fail("cannot read the Core exports: {err}")
    if !core_text.split("\n").any(fn(row) { row != "" }) -> fail("the Core export list is empty")
    core_threads: files.read("{core}.threads") ?? fail("cannot read the Core thread receipt: {err}")
    if core_threads_unexported(core_text, core_threads) {
        fail("Core thread receipt names a symbol the Core exports lack")
    }
    // A Core root the library left out (JetCLI CoreLibrary.jet writes one
    // `{prefix}.skipped` row per failure) fails the pack, the rows kept in OUT
    // as core.skipped: a skipped root would make its callers fall back
    // silently.
    skipped_text: files.read("{core}.skipped") ?? fail("cannot read the skipped Core roots: {err}")
    skipped: loop row in skipped_text.split("\n") if row.trim() != "" -> row.copy()
    if skipped.len() > 0 {
        files.create_dir_all(out) ?? ()
        kept: files.join(out, "core.skipped")
        copy_into("{core}.skipped", kept)
        fail("the Core library left out {skipped.len()} root(s), listed in `{kept}`; the first: {skipped[0]}")
    }
}

// Whether the thread receipt `threads` names a symbol the export list
// `exports` (one `symbol<TAB>...` row each) lacks; `*` names none. The
// export symbols are read once into a set, so each name is one lookup.
core_threads_unexported: fn(exports: String, threads: String) -> Bool {
    if threads.trim() == "*" -> return false
    ^symbols: [String:Bool]{}
    loop row in exports.split("\n") {
        cut: row.partition("\t")
        if cut.sep != "" -> symbols[cut.head] = true
    }
    threads.split("\n").any(fn(name) { name != "" && symbols.get(name) == None })
}

// The sources sources.list lists, in order.
runtime_sources: fn(listed: String) -> [String] {
    ^paths: [String]{}
    loop row in listed.split("\n") {
        trimmed: row.trim()
        if trimmed == "" || trimmed.starts_with("#") -> next
        line: trimmed.copy()
        if paths.contains(line) -> fail("`{RUNTIME_SOURCES}` lists `{line}` twice")
        paths.push(line)
    }
    if paths.len() == 0 -> fail("`{RUNTIME_SOURCES}` lists no source")
    paths
}

// An import of Core: `core.x` or `alias: core.x`, member list or not, with
// any surrounding spaces ignored.
core_import: fn(spec: String) -> Bool {
    text: spec.trim()
    head: text.partition(": ")
    target: if head.tail != "" && re.full_match(Regex{"[A-Za-z_][A-Za-z0-9_]*"}, head.head) -> head.tail else -> text
    target.starts_with("core.")
}

// The unit text of one source: its lines with each import line left empty,
// so a line of the source keeps its number counted from the unit source mark
// (JetSema's unit map reads a raw operation's source line that way). Each
// Core import (a `use` line, or a row of a top-level `use { … }` block) not
// yet in `uses` is added to it.
unit_body: fn(text: String, uses: ^[String]) -> String {
    ^kept: [String]{}
    ^block: false
    ^depth: 0
    loop line in text.split("\n") {
        if block {
            kept.push("")
            if depth == 0 && line.trim_end() == "}}" {
                block = false
                next
            }
            row: line.trim()
            if depth == 0 && row != "" && !row.starts_with("//") && core_import(line) {
                import: "use {row}"
                if !uses.contains(import) -> uses.push(import)
            }
            loop b in line.partition("//").head.bytes() {
                if b == (U8{91}) -> depth += 1
                if b == (U8{93}) -> depth -= 1
            }
            next
        }
        if depth > 0 {
            kept.push("")
            if line.contains("]") -> depth = 0
            next
        }
        if line.starts_with("use ") {
            kept.push("")
            if line.trim_end() == "use {{" {
                block = true
                next
            }
            if core_import(line.removeprefix("use ")) && !uses.contains(line) {
                uses.push(line.copy())
            }
            if line.contains("[") && !line.contains("]") -> depth = 1
            next
        }
        kept.push(line.copy())
    }
    kept.join("\n")
}

// The package folder of each of `paths`: the folder of the package.jet
// nearest above it inside the Compiler package, in first-seen order. A source
// with none fails, so a step that cannot see a source's package.jet never
// drops that package's memory kernel.
unit_packages: fn(root: String, paths: [String]) -> [String] {
    ^packages: [String]{}
    loop path in paths {
        ^directory: path.rpartition("/").head
        loop directory != "" && directory != PACKAGE && !files.exists(at(root, "{directory}/package.jet")) {
            directory = directory.rpartition("/").head
        }
        if directory == "" || directory == PACKAGE {
            fail("`{path}` has no package.jet above it inside {PACKAGE}, so its memory kernel cannot be read")
        }
        if !packages.contains(directory) -> packages.push(directory.move())
    }
    packages
}

// The memory kernel of a unit of `paths`: every file `policy.memory` names
// in each path's package.jet (unit_packages), by checkout path. A unit is one
// file, so its kernel rule reads each raw operation's own source from the
// unit source marks against this list.
unit_kernel: fn(root: String, paths: [String]) -> [String] {
    ^kernel: [String]{}
    loop directory in unit_packages(root, paths) {
        manifest: files.read(at(root, "{directory}/package.jet")) ?? fail("`{directory}/package.jet` cannot be read: {err}")
        field: MEMORY_KERNEL_FIELD.match(manifest) ?? next
        loop found in QUOTED_PATH.matches(field.groups[0]) {
            entry: found.groups[0].removeprefix("./").removesuffix("/")
            kernel.push("{directory}/{entry}")
        }
    }
    kernel
}

// `manifest` with its one-line `policy.memory` field naming `kernel`
// instead, or with a policy block naming it when it has none.
unit_manifest: fn(manifest: String, kernel: [String]) -> String {
    quoted: loop path in kernel -> "\"{path}\""
    memory: "memory: .Kernel([{quoted.join(", ")}])"
    ^lines: manifest.split("\n").to_list()
    ^replaced: false
    loop at in 0..<lines.len() {
        field: lines[at].partition("memory:")
        if field.sep == "" || !field.tail.contains(".Kernel(") -> next
        lines[at] = "{field.head}{memory}{field.tail.partition("])").tail}"
        replaced = true
    }
    if replaced -> return lines.join("\n")
    "{manifest.trim_end()}\npolicy: {{\n    {memory}\n}}\n"
}

// A test unit's package.jet: the one language edition the driver accepts.
test_package: fn(root: String) -> String {
    loader: files.read(at(root, DRIVER_LOADER)) ?? fail("`{DRIVER_LOADER}` cannot be read: {err}")
    loop line in loader.split("\n") {
        value: line.removeprefix("JET_DRIVER_EDITION: \"")
        if value.len() < line.len() && value.len() > 1 && value.ends_with("\"") && !value.removesuffix("\"").contains("\"") {
            return "name: \"jet_runtime_tests\"\nversion: \"0.0.1\"\nedition: \"{value.removesuffix("\"")}\"\n"
        }
    }
    fail("JET_DRIVER_EDITION is not found in `{DRIVER_LOADER}`")
}

// The runtime's one-namespace unit with the files `fragments` appended, in
// order, written to OUT/unit.jet beside its package.jet; returns OUT/unit.jet.
compose_unit: fn(root: String, out: String, fragments: [String]) -> String {
    listed: files.read(at(root, RUNTIME_SOURCES)) ?? fail("`{RUNTIME_SOURCES}` cannot be read: {err}")
    ^paths: runtime_sources(listed)
    paths.extend(fragments.copy())
    ^uses: [String]{}
    ^bodies: [String]{}
    loop path in paths {
        text: files.read(at(root, path)) ?? fail("`{path}` cannot be read: {err}")
        bodies.push("{UNIT_SOURCE_MARK}{path}]\n{unit_body(text, uses)}")
    }
    // Any fragment makes a test package; either answers to its sources'
    // memory kernels.
    manifest: if fragments.len() > 0 -> test_package(root) else -> files.read(at(root, RUNTIME_PACKAGE)) ?? fail("`{RUNTIME_PACKAGE}` cannot be read: {err}")
    package: unit_manifest(manifest, unit_kernel(root, paths))
    files.create_dir_all(out) ?? fail("`{out}` cannot be created: {err}")
    ^unit: uses.move()
    unit.push("")
    unit.extend(bodies)
    unit_path: files.join(out, "unit.jet")
    files.write(unit_path, unit.join("\n")) ?? fail("`{unit_path}` cannot be written: {err}")
    files.write(files.join(out, "package.jet"), package) ?? fail("`{out}/package.jet` cannot be written: {err}")
    unit_path
}

// `^[A-Z][A-Za-z0-9]*$`.
is_type_name: fn(text: String) -> Bool { re.full_match(Regex{"[A-Z][A-Za-z0-9]*"}, text) }

// The fragment names of `unit OUT [--test NAME]...`, in order; None when the
// arguments are not that shape or name a fragment twice.
unit_tests: fn(args: [String]) -> [String]? {
    if args.len() % 2 != 1 -> return None
    ^tests: [String]{}
    ^at: 1
    loop at < args.len() {
        if args[at] != "--test" || !is_type_name(args[at + 1]) || tests.contains(args[at + 1]) {
            return None
        }
        tests.push(args[at + 1].copy())
        at += 2
    }
    Val(tests)
}

// `unit OUT --check`: the runtime composed with every fragment of
// Fragments.fixture (each .jet file but its package.jet), sorted,
// type-checked by $JET (default `jet`) with JET_KEEP_GOING=1; the exit status.
unit_check: fn(root: String, out: String) -> Int {
    dir: at(root, RUNTIME_FRAGMENTS)
    listed: files.list_dir(dir) ?? fail("`{RUNTIME_FRAGMENTS}` cannot be listed: {err}")
    ^fragments: [String]{}
    loop entry in listed {
        if entry.name.ends_with(".jet") && entry.name != "package.jet" {
            fragments.push("{RUNTIME_FRAGMENTS}/{entry.name}")
        }
    }
    fragments.sort()
    if fragments.len() == 0 -> fail("`{RUNTIME_FRAGMENTS}` holds no fragment")
    ^unit_path: compose_unit(root, out, fragments)
    unit: files.read(unit_path) ?? fail("`{unit_path}` cannot be read: {err}")
    jet: process.env_get("JET") ?? "jet"
    receipt: process.cmd([String]{jet.copy(), "check", unit_path.move()}).cwd(out).env("JET_KEEP_GOING", "1").output_limit(1073741824).run() ?? fail("{jet} check cannot run: {err}")
    ^sources: [String]{}
    ^owners: [String]{}
    ^current: ""
    loop line in unit.split("\n") {
        if line.starts_with(UNIT_SOURCE_MARK) {
            current = line.removeprefix(UNIT_SOURCE_MARK).removesuffix("]").copy()
            sources.push(current.copy())
        }
        owners.push(current.copy())
    }
    ^counts: [String:Int]{}
    ^total: 0
    ^error: false
    loop line in "{receipt.output}{receipt.errors}".split("\n") {
        trimmed: line.trim_start()
        if trimmed.len() == line.len() && line != "" -> error = line.starts_with("Error")
        if !error || !trimmed.starts_with("-->") {
            print(line)
            next
        }
        parts: trimmed.removeprefix("-->").trim().partition(" ").head.split(":").to_list()
        number: if parts.len() >= 3 -> Int.parse(parts[parts.len() - 2]) ?? 0 else -> 0
        in_unit: parts.len() >= 3 && parts.slice(0, parts.len() - 2).join(":").ends_with("unit.jet")
        owner: if in_unit && number >= 1 && number <= owners.len() -> owners[number - 1].copy() else -> ""
        print(if owner == "" -> line.copy() else -> "{line} ({owner})")
        counts[owner] = (counts.get(owner) ?? 0) + 1
        total += 1
        error = false
    }
    loop source in sources -> print("{source}\t{counts.get(source) ?? 0}")
    if (counts.get("") ?? 0) > 0 -> print("(outside the unit)\t{counts.get("") ?? 0}")
    print("runtime unit check: {total} error(s) over {fragments.len()} fragments; jet check exit {receipt.code}")
    if total == 0 && receipt.success -> 0 else -> 1
}

run: fn() {
    ^args: process.args()
    ^root: "."
    if args.len() >= 2 && args[0] == "--root" {
        root = args[1].copy()
        args = args.slice(2, args.len())
    }
    if args.len() == 0 -> fail(USAGE)
    rest: args.slice(1, args.len())
    if args[0] == {
        "pack" -> {
            if root != "." -> fail(USAGE)
            pack(rest)
        }
        "unit" -> {
            if rest.len() == 2 && rest[1] == "--check" -> process.exit(unit_check(root, rest[0]))
            tests: unit_tests(rest) ?? fail(USAGE)
            fragments: loop name in tests -> "{RUNTIME_FRAGMENTS}/{name}Tests.jet"
            print(compose_unit(root, rest[0], fragments))
        }
        else -> fail(USAGE)
    }
}

#Test("recipe and identity JSON keep their field order") {
    assert_eq(compact(Dyn.Object([String:Dyn]{"format": Dyn.Text("f"), "source": Dyn.Text("s"), "n": Dyn.Int(0)})), "{{\"format\":\"f\",\"source\":\"s\",\"n\":0}}")
}

#Test("ABI symbols and export names compare sorted") {
    assert_eq(abi_symbols("[{{\"symbol\":\"b\"}},{{\"symbol\":\"a\"}}]"), [String]{"a", "b"})
    assert_eq(export_names("b\na\n"), [String]{"a", "b"})
    assert_eq(abi_symbols("{{}}"), [String]{})
}

#Test("a Core thread receipt names only exported symbols, or is `*`") {
    exports: "core_a\tk1\tsig\ncore_b\tk2\tsig\n"
    assert(!core_threads_unexported(exports, "core_b\ncore_a\n"))
    assert(!core_threads_unexported(exports, "*\n"))
    assert(!core_threads_unexported(exports, ""))
    assert(core_threads_unexported(exports, "core_a\ncore_c\n"))
    // A symbol is the whole first field, never a prefix of one.
    assert(core_threads_unexported(exports, "core\n"))
}

#Test("unit names only type-shaped fragments, each once") {
    assert(is_type_name("Alloc"))
    assert(is_type_name("Fmt2"))
    assert(!is_type_name("lower"))
    assert(!is_type_name(""))
    assert(!is_type_name("Bad-Name"))
    assert(unit_tests([String]{"out"}) == Val([String]{}))
    assert(unit_tests([String]{"out", "--test", "World", "--test", "Sentry"}) == Val([String]{"World", "Sentry"}))
    assert(unit_tests([String]{"out", "--test", "World", "--test", "World"}) == None)
    assert(unit_tests([String]{"out", "--test"}) == None)
    assert(unit_tests([String]{"out", "--test", "lower"}) == None)
    assert(unit_tests([String]{"out", "--tests", "World"}) == None)
}

#Test("a unit gathers each Core import once and blanks every import line") {
    ^uses: [String]{"use core.files"}
    body: unit_body("use core.files\nuse m: core.math\nuse jet_lexer.[\n    lex,\n]\nuse {{\n    core.sys\n    fs: core.files\n    jet_ir.[\n        Block,\n    ]\n}}\nmain: fn() {{}}\n", uses)
    assert_eq(uses, [String]{"use core.files", "use m: core.math", "use core.sys", "use fs: core.files"})
    assert_eq(body, "\n\n\n\n\n\n\n\n\n\n\n\nmain: fn() {{}}\n")
    assert(core_import("core.text.[Text, Rune]"))
    assert(!core_import("jet_lexer.[lex]"))
    assert(!core_import("pub: jet.x"))
}

// Test input: `value` as `width` little-endian bytes at `at` of `b`.
put: fn(b: ^[U8], at: Int, width: Int, value: Int) {
    ^rest: value
    loop k in 0..<width {
        b[at + k] = checked(U8{rest % 256}) ?? U8{0}
        rest /%= 256
    }
}

// Test input: a 64-bit little-endian ELF relocatable whose .symtab names
// `names` after the null symbol, its .strtab first.
elf_with_symbols: fn(names: [String]) -> [U8] {
    ^strings: [U8]{U8{0}}
    ^offsets: [Int]{}
    loop name in names {
        offsets.push(strings.len())
        strings.extend(name.bytes())
        strings.push(U8{0})
    }
    symtab: (64 + strings.len() + 7) /% 8 * 8
    symtab_size: (names.len() + 1) * 24
    shoff: symtab + symtab_size
    ^b: [U8]{}
    loop _ in 0..<(shoff + 3 * 64) -> b.push(U8{0})
    put(b, 0, 4, 1179403647)
    // ELFCLASS64, ELFDATA2LSB, EV_CURRENT; ET_REL; EM_X86_64.
    put(b, 4, 3, 65794)
    put(b, 16, 2, 1)
    put(b, 18, 2, 62)
    put(b, 40, 8, shoff)
    put(b, 52, 2, 64)
    put(b, 58, 2, 64)
    put(b, 60, 2, 3)
    loop k in 0..<strings.len() -> b[64 + k] = strings[k]
    loop index in 0..<offsets.len() -> put(b, symtab + (index + 1) * 24, 4, offsets[index])
    // Section 1: .symtab, linked to section 2, .strtab.
    put(b, shoff + 64 + 4, 4, 2)
    put(b, shoff + 64 + 24, 8, symtab)
    put(b, shoff + 64 + 32, 8, symtab_size)
    put(b, shoff + 64 + 40, 4, 2)
    put(b, shoff + 64 + 56, 8, 24)
    put(b, shoff + 128 + 4, 4, 3)
    put(b, shoff + 128 + 24, 8, 64)
    put(b, shoff + 128 + 32, 8, strings.len())
    b
}

#Test("a unit's package names its sources' memory kernels") {
    kernel: [String]{"Compiler/JetRuntime/Source/Alloc.jet", "Compiler/JetBackend/Source/OS/Linux.jet"}
    assert_eq(unit_manifest("name: \"jet_runtime\"\npolicy: {{\n    memory: .Kernel([\"Source/Alloc.jet\"]),\n}}\n", kernel), "name: \"jet_runtime\"\npolicy: {{\n    memory: .Kernel([\"Compiler/JetRuntime/Source/Alloc.jet\", \"Compiler/JetBackend/Source/OS/Linux.jet\"]),\n}}\n")
    assert_eq(unit_manifest("name: \"jet_runtime_tests\"\n", kernel), "name: \"jet_runtime_tests\"\npolicy: {{\n    memory: .Kernel([\"Compiler/JetRuntime/Source/Alloc.jet\", \"Compiler/JetBackend/Source/OS/Linux.jet\"])\n}}\n")
}

#Test("a unit's kernel reads each source's own package, not the Compiler package") {
    root: files.mkdtemp("runtime-pack-kernel") ?? panic("scratch: {err}")
    files.create_dir_all(files.join(root, "JetRuntime/Source")) ?? panic("runtime folder: {err}")
    files.create_dir_all(files.join(root, "JetBackend/Source/OS")) ?? panic("backend folder: {err}")
    files.write(files.join(root, "package.jet"), "name: \"compiler\"\n") ?? panic("compiler manifest: {err}")
    files.write(files.join(root, "JetRuntime/package.jet"), "name: \"jet_runtime\"\npolicy: {{\n    memory: .Kernel([\"Source/Alloc.jet\"]),\n}}\n") ?? panic("runtime manifest: {err}")
    files.write(files.join(root, "JetBackend/package.jet"), "name: \"jet_backend\"\npolicy: {{\n    memory: .Kernel([\"./Source/OS/\"]),\n}}\n") ?? panic("backend manifest: {err}")
    paths: [String]{"Compiler/JetBackend/Source/OS/Linux.jet", "Compiler/JetRuntime/Source/Alloc.jet", "Compiler/JetRuntime/Source/Host.jet"}
    assert_eq(unit_packages(root, paths), [String]{"Compiler/JetBackend", "Compiler/JetRuntime"})
    assert_eq(unit_kernel(root, paths), [String]{"Compiler/JetBackend/Source/OS", "Compiler/JetRuntime/Source/Alloc.jet"})
    files.remove_all(root) ?? panic("scratch cleanup: {err}")
}

#Test("the Rust check reads ELF symbol tables itself") {
    rusty: elf_with_symbols([String]{"jet_main", "_ZN3foo3barE", "__rust_alloc"})
    assert_eq(rust_symbols(rusty, "r.o"), "Rust symbols in r.o:\n_ZN3foo3barE\n__rust_alloc")
    clean: elf_with_symbols([String]{"jet_main", "memcpy", "x_ZN1a"})
    assert_eq(rust_symbols(clean, "c.o"), "")
    ^names: [String]{}
    assert_eq(symbol_names(clean, "c.o", names), "")
    assert_eq(names, [String]{"jet_main", "memcpy", "x_ZN1a"})
    assert_eq(rust_symbols("not an object".bytes(), "x"), "x is not a 64-bit little-endian ELF object")
    truncated: rusty.slice(0, rusty.len() - 8)
    assert_eq(rust_symbols(truncated, "t.o"), "t.o has a malformed section header table")
}

#Test("the step's digests keep their files' order and each file's own problem") {
    root: files.mkdtemp("runtime-pack-digests") ?? panic("scratch: {err}")
    clean_bytes: elf_with_symbols([String]{"jet_main"})
    clean: files.join(root, "c.o")
    files.write_bytes(clean, clean_bytes) ?? panic("clean object: {err}")
    rusty: files.join(root, "r.o")
    files.write_bytes(rusty, elf_with_symbols([String]{"__rust_alloc"})) ?? panic("Rust object: {err}")
    plain: files.join(root, "plain")
    files.write(plain, "abc") ?? panic("plain file: {err}")
    missing: files.join(root, "missing")
    found: digests([String]{clean, rusty}, [String]{plain, missing})
    assert_eq(found.len(), 4)
    assert_eq(digest_of(found[0]), crypto.sha256(clean_bytes).hex())
    assert_eq(found[1].problem, "Rust symbols in {rusty}:\n__rust_alloc")
    assert_eq(digest_of(found[2]), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert(found[3].problem.starts_with("cannot read `{missing}`"))
    files.remove_all(root) ?? panic("scratch cleanup: {err}")
}
