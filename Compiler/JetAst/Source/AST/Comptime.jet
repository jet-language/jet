// Compile-time values retained on AST nodes and semantic projections.

pub enum CtFloat {
    F32(value: Float)
    F64(value: Float)
}

pub enum CtValue {
    Int(value: Int)
    Float(value: CtFloat)
    Bool(value: Bool)
    Char(value: Char)
    Str(value: String)
    BigInt(value: String)
    Bytes(value: [U8])
    List(values: [CtValue])
    Map(entries: [CtMapEntry])
    Struct(type_name: String, fields: [NamedCtValue])
    Enum(type_name: String, variant: String, args: [CtEnumArg])
    Present(value: CtValue)
    Failed(report: CtReport)
    Unit
    Closure(value: ClosureData)
}

pub struct CtMapEntry {
    pub key: CtKey
    pub value: CtValue
}

pub struct NamedCtValue {
    pub name: String
    pub value: CtValue
}

pub struct CtEnumArg {
    pub label: ?String
    pub value: CtValue
}

pub enum CtReport {
    Clean(ty: Type)
    Told(value: CtValue)
}

pub struct ClosureData {
    pub lambda: Lambda
    pub captured: [NamedCtValue]
    pub return_type: ?Type
    pub opaque: ?CtOpaque
}

pub struct CtOpaque {
    pub kind: String
    pub identity: String
}

pub enum CtKey {
    Int(value: Int)
    Str(value: String)
    Bool(value: Bool)
    Char(value: Char)
    Tuple(fields: [NamedCtKey])
    Struct(type_name: String, fields: [NamedCtKey])
    Enum(type_name: String, variant: String)
}

pub struct NamedCtKey {
    pub name: String
    pub value: CtKey
}

pub enum FailureContract {
    Default(success: Type, error: Type)
    Optional(success: Type)
    DeclaredNever
    Explicit(success: Type, error: Type)
    Converted(success: Type, source: Type, target: Type)
    ProvenUnreachable(success: Type)
}

pub fn ast_comptime_key_type(key: CtKey) -> Type {
    if key == {
        .Int(_) -> Type.Int
        .Str(_) -> Type.String
        .Bool(_) -> Type.Bool
        .Char(_) -> Type.Char
        .Tuple(fields) -> {
            types := [TypeTupleField]{}
            loop field in fields -> types.push(TypeTupleField{name: field.name, ty: ast_comptime_key_type(field.value)})
            Type.Tuple(types)
        }
        .Struct(name, _) | .Enum(name, _) -> Type.Named(name)
    }
}

pub fn ast_comptime_value_type(value: CtValue) -> Type {
    if value == {
        .Int(_) | .BigInt(_) -> Type.Int
        .Float(number) -> if number == {
            .F32(_) -> Type.Float32
            .F64(_) -> Type.Float
        }
        .Bool(_) -> Type.Bool
        .Char(_) -> Type.Char
        .Str(_) -> Type.String
        .Bytes(_) -> Type.List(Type.IntN(false, 8))
        .List(values) -> Type.List(if values.len() == 0 -> Type.Int else -> ast_comptime_value_type(values[0]))
        .Map(entries) -> {
            if entries.len() == 0 -> Type.Map(Type.String, None, Type.Int)
            else -> Type.Map(ast_comptime_key_type(entries[0].key), None, ast_comptime_value_type(entries[0].value))
        }
        .Struct(name, _) | .Enum(name, _, _) -> Type.Named(name)
        .Present(inner) -> Type.Option(ast_comptime_value_type(inner))
        .Failed(report) -> if report == {
            .Clean(ty) -> Type.Option(ty)
            .Told(error) -> Type.Result(Type.Int, ast_comptime_value_type(error))
        }
        .Unit -> Type.Named("Unit")
        .Closure(_) -> Type.Fn([Type]{}, None, None, None, None, None)
    }
}
