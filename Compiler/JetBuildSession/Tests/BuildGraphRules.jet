// Declaration rules, run through the Jet build session service that replaced
// the Rust BuildContext. Each call is what a `build: fn(b: Build)` body issues;
// nothing is executed.
use jet_build_session.[
    BuildSession, BuildSessionDiagnostic, BuildSessionError, BuildSessionPolicy, BuildSessionReply, BuildSessionValue,
    build_session_abort, build_session_call, build_session_compiler_node, build_session_graph, build_session_new, build_session_set_dependencies,
]

build_graph_rules_session: fn(id: Int) -> BuildSession Never! {
    policy: BuildSessionPolicy{plugins_denied: None, plugin_grants: [String:[String]]{}}
    build_session_new(id, "graph", "graph-compiler", policy)
}

build_graph_rules_list: fn(values: [String]) -> BuildSessionValue Never! {
    BuildSessionValue.List{values: loop value in values -> BuildSessionValue.Text{value: value}}
}

build_graph_rules_error: fn(reply: BuildSessionReply) -> BuildSessionError? Never! {
    if reply == {
        .Failure(diagnostic) -> diagnostic.error
        .Value(_) | .HostRequest(_, _) -> None
    }
}

build_graph_rules_ok: fn(reply: BuildSessionReply) -> Bool Never! {
    if reply == {
        .Value(_) -> true
        .Failure(_) | .HostRequest(_, _) -> false
    }
}

build_graph_rules_value: fn(reply: BuildSessionReply) -> BuildSessionValue Never! {
    if reply == {
        .Value(value) -> value
        .Failure(_) | .HostRequest(_, _) -> panic("build declaration failed")
    }
}

build_graph_rules_failed: fn(reply: BuildSessionReply) -> Bool Never! {
    if reply == {
        .Failure(_) -> true
        .Value(_) | .HostRequest(_, _) -> false
    }
}

build_graph_rules_failure: fn(reply: BuildSessionReply) -> BuildSessionDiagnostic? Never! {
    if reply == {
        .Failure(diagnostic) -> Val(diagnostic)
        .Value(_) | .HostRequest(_, _) -> None
    }
}

// `b.found(b.probe("tool", "find_program", "tool"))`: the program the
// session's steps run.
build_graph_rules_tool: fn(session: &BuildSession) -> BuildSessionValue Never! {
    probe: build_graph_rules_value(build_session_call(session, "probe", [BuildSessionValue]{.Text(value: "tool"), .Text(value: "find_program"), .Text(value: "tool")}, None, true, 1, 2))
    build_graph_rules_value(build_session_call(session, "found", [BuildSessionValue]{probe}, None, true, 3, 4))
}

build_graph_rules_step: fn(session: &BuildSession, method: String, step: BuildSessionValue, values: [BuildSessionValue]) -> BuildSessionReply Never! {
    args := [BuildSessionValue]{step.copy()}
    loop value in values -> args.push(value.copy())
    build_session_call(session, "action.{method}", args, None, true, 9, 10)
}

// `step := b.run(name, tool, caps)`, then `step.output(path)` for each output.
build_graph_rules_made: fn(session: &BuildSession, tool: BuildSessionValue, name: String, outputs: [String]) -> BuildSessionReply Never! {
    step: build_session_call(session, "run", [BuildSessionValue]{.Text(value: name), tool, build_graph_rules_list([String]{})}, None, true, 5, 6)
    handle: if step == {
        .Value(value) -> value
        .Failure(_) | .HostRequest(_, _) -> return step
    }
    loop output in outputs {
        made: build_graph_rules_step(session, "output", handle, [BuildSessionValue]{.Text(value: output)})
        if made == .Failure(_) -> return made
    }
    step
}

#Test("duplicate_target_or_action_names_are_rejected") {
    session := build_graph_rules_session(81)
    tool: build_graph_rules_tool(session)
    empty: build_graph_rules_list([String]{})
    assert(build_graph_rules_ok(build_session_call(session, "add_executable", [BuildSessionValue]{.Text(value: "app"), empty, empty}, None, false, 1, 2)))
    duplicate_target: build_session_call(session, "add_library", [BuildSessionValue]{.Text(value: "app"), empty, empty}, None, false, 3, 4)
    assert_eq(build_graph_rules_error(duplicate_target), Val(BuildSessionError.DuplicateTargetName{value: "app"}))
    assert(build_graph_rules_ok(build_graph_rules_made(session, tool, "codegen", [String]{"out.jet"})))
    duplicate_action: build_graph_rules_made(session, tool, "codegen", [String]{"other.jet"})
    assert_eq(build_graph_rules_error(duplicate_action), Val(BuildSessionError.DuplicateActionName{value: "codegen"}))
}

#Test("action_outputs_have_one_owner_in_the_plan") {
    session := build_graph_rules_session(85)
    tool: build_graph_rules_tool(session)
    assert(build_graph_rules_ok(build_graph_rules_made(session, tool, "generate-a", [String]{".jet/generated/out.jet"})))
    assert(build_graph_rules_ok(build_graph_rules_made(session, tool, "generate-b", [String]{".jet/generated/out.jet"})))
    plan: build_session_call(session, "plan", [BuildSessionValue]{}, None, false, 7, 8)
    queried: build_session_graph(session, if plan == {
        .Value(value) -> value
        .Failure(_) | .HostRequest(_, _) -> panic("plan failed")
    })
    assert(queried.graph == None)
    diagnostic: queried.diagnostic ?? panic("duplicate output must refuse the plan")
    assert_eq(diagnostic.error, Val(BuildSessionError.DuplicateBuildOutput{output: ".jet/generated/out.jet", first_action: "generate-a", second_action: "generate-b"}))
}

#Test("compiler_nodes_are_sorted_and_path_independent") {
    first: build_session_compiler_node("check", "src/main.jet", [BuildGraphInputDigest]{{name: "src/z.jet", digest: "digest-z"}, {name: "src/a.jet", digest: "digest-a"}})
    second: build_session_compiler_node("check", "src/main.jet", [BuildGraphInputDigest]{{name: "src/a.jet", digest: "digest-a"}, {name: "src/z.jet", digest: "digest-z"}})
    assert_eq(first.kind, second.kind)
    assert_eq(first.subject, second.subject)
    assert_eq(first.key, second.key)
    assert_eq(first.inputs, second.inputs)
    assert_eq(loop row in first.input_digests -> "{row.name}={row.digest}", loop row in second.input_digests -> "{row.name}={row.digest}")
    assert_eq(first.inputs, [String]{"src/a.jet", "src/z.jet"})
    assert_eq(first.key.len(), 64)
}

#Test("registers_typed_targets_and_default_plan") {
    session := build_graph_rules_session(86)
    tool: build_graph_rules_tool(session)
    empty: build_graph_rules_list([String]{})
    gen: build_graph_rules_value(build_graph_rules_made(session, tool, "generate-assets", [String]{".jet/generated/assets.jet"}))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "input", gen, [BuildSessionValue]{.Text(value: "assets/sprite.png")})))
    lib: build_graph_rules_value(build_session_call(session, "add_library", [BuildSessionValue]{.Text(value: "engine"), build_graph_rules_list([String]{"src/engine.jet"}), .List(values: [BuildSessionValue]{gen})}, None, false, 3, 4))
    app: build_graph_rules_value(build_session_call(session, "add_executable", [BuildSessionValue]{.Text(value: "game"), build_graph_rules_list([String]{"src/main.jet"}), empty, .List(values: [BuildSessionValue]{lib})}, None, false, 5, 6))
    on_app: BuildSessionValue.List{values: [BuildSessionValue]{app}}
    assert(build_graph_rules_ok(build_session_call(session, "add_test", [BuildSessionValue]{.Text(value: "unit"), empty, empty, on_app}, None, false, 7, 8)))
    assert(build_graph_rules_ok(build_session_call(session, "add_test", [BuildSessionValue]{.Text(value: "frame-time"), empty, empty, on_app}, None, false, 9, 10)))
    assert(build_graph_rules_ok(build_session_call(session, "add_asset_bundle", [BuildSessionValue]{.Text(value: "assets"), empty, .List(values: [BuildSessionValue]{gen})}, None, false, 11, 12)))
    assert(build_graph_rules_ok(build_session_call(session, "add_doc", [BuildSessionValue]{.Text(value: "manual"), build_graph_rules_list([String]{"docs/manual.md"}), empty}, None, false, 13, 14)))
    assert(build_graph_rules_ok(build_session_call(session, "add_install", [BuildSessionValue]{.Text(value: "install"), empty, empty, on_app}, None, false, 15, 16)))
    assert(build_graph_rules_ok(build_session_call(session, "add_package", [BuildSessionValue]{.Text(value: "package"), empty, empty, on_app}, None, false, 17, 18)))
    assert(build_graph_rules_ok(build_session_call(session, "add_publish", [BuildSessionValue]{.Text(value: "publish"), empty, empty, on_app}, None, false, 19, 20)))
    plan: build_graph_rules_value(build_session_call(session, "plan", [BuildSessionValue]{app}, None, false, 21, 22))
    // plan.default_target() == app: the plan handle carries the default target's id.
    assert_eq(app, BuildSessionValue.Handle{type_name: "BuildTarget", session: 86, id: 1})
    assert_eq(plan, BuildSessionValue.Handle{type_name: "BuildPlan", session: 86, id: 1})
    queried: build_session_graph(session, plan)
    assert(queried.diagnostic == None)
    graph: queried.graph ?? panic("plan graph")
    assert_eq(graph.targets[1].kind, "Executable")
    assert_eq(graph.targets[0].kind, "Library")
    bundles := 0
    loop target in graph.targets { if target.kind == "AssetBundle" -> bundles += 1 }
    assert_eq(bundles, 1)
    assert_eq(graph.actions.len(), 1)
    assert_eq(graph.actions[0].outputs[0], ".jet/generated/assets.jet")
    assert_eq(graph.actions[0].inputs, [String]{"assets/sprite.png"})
    // The executable uses the session's default host toolchain (role Host).
    permit: session.storage.guard_read()
    assert_eq(permit.value.targets[1].toolchain, 0)
    assert_eq(permit.value.toolchains[0].role, "host")
}

#Test("foreign_toolchain_probe_and_signer_handles_are_rejected") {
    a := build_graph_rules_session(87)
    b := build_graph_rules_session(88)
    toolchain: build_graph_rules_value(build_session_call(b, "toolchain", [BuildSessionValue]{.Text(value: "other"), .Text(value: "wasm32-wasi")}, None, false, 1, 2))
    signer: build_graph_rules_value(build_session_call(b, "signing", [BuildSessionValue]{.Text(value: "other-signer"), .Text(value: "developer-id:OTHER")}, None, false, 3, 4))
    probe: build_graph_rules_value(build_session_call(b, "probe", [BuildSessionValue]{.Text(value: "other-cc"), .Text(value: "find_program"), .Text(value: "cc")}, None, true, 5, 6))
    empty: build_graph_rules_list([String]{})
    host: BuildSessionValue.Handle{type_name: "BuildToolchain", session: 87, id: 0}
    assert(build_graph_rules_failed(build_session_call(a, "add_executable", [BuildSessionValue]{.Text(value: "bad-toolchain"), empty, empty, empty, empty, toolchain}, None, false, 7, 8)))
    assert(build_graph_rules_failed(build_session_call(a, "add_executable", [BuildSessionValue]{.Text(value: "bad-signer"), empty, empty, empty, empty, host, signer}, None, false, 9, 10)))
    assert(build_graph_rules_failed(build_session_call(a, "add_library", [BuildSessionValue]{.Text(value: "bad-probe"), empty, empty, empty, .List(values: [BuildSessionValue]{probe})}, None, false, 11, 12)))
    assert(build_graph_rules_failed(build_session_call(a, "found", [BuildSessionValue]{probe}, None, true, 13, 14)))
    permit: a.storage.guard_read()
    assert_eq(permit.value.targets.len(), 0)
}

// `meta.events` reads a `Compiler` value's checked program only after
// `compiler.live` accepts the value: one of this build's, while it runs.
#Test("meta_events_read_only_a_live_compiler_value_of_this_build") {
    a := build_graph_rules_session(187)
    b := build_graph_rules_session(188)
    empty: build_graph_rules_list([String]{})
    app: build_graph_rules_value(build_session_call(a, "add_executable", [BuildSessionValue]{.Text(value: "app"), empty, empty}, None, false, 1, 2))
    other: build_graph_rules_value(build_session_call(b, "add_executable", [BuildSessionValue]{.Text(value: "app"), empty, empty}, None, false, 3, 4))
    meta: build_graph_rules_value(build_session_call(a, "compiler", [BuildSessionValue]{app.copy()}, None, false, 5, 6))
    foreign: build_graph_rules_value(build_session_call(b, "compiler", [BuildSessionValue]{other}, None, false, 7, 8))
    assert(build_graph_rules_ok(build_session_call(a, "compiler.live", [BuildSessionValue]{meta.copy()}, None, false, 9, 10)))
    assert(build_graph_rules_failed(build_session_call(a, "compiler.live", [BuildSessionValue]{foreign}, None, false, 11, 12)))
    assert(build_graph_rules_failed(build_session_call(a, "compiler.live", [BuildSessionValue]{app}, None, false, 13, 14)))
    assert(build_graph_rules_failed(build_session_call(a, "compiler.live", [BuildSessionValue]{}, None, false, 15, 16)))
    build_session_abort(a)
    assert(build_graph_rules_failed(build_session_call(a, "compiler.live", [BuildSessionValue]{meta}, None, false, 17, 18)))
}

// Rewrites of one function compose in the order they run: a later rewrite's
// paste line, written with the name its call gave the function, is the body
// the earlier rewrite made, at that line's margin, and the module records
// both callers.
#Test("meta_rewrite_body_rewrites_of_one_function_compose_in_order") {
    a := build_graph_rules_session(189)
    empty: build_graph_rules_list([String]{})
    app: build_graph_rules_value(build_session_call(a, "add_executable", [BuildSessionValue]{.Text(value: "app"), empty, empty}, None, false, 1, 2))
    meta: build_graph_rules_value(build_session_call(a, "compiler", [BuildSessionValue]{app}, None, false, 3, 4))
    trace: Val("print(\"enter\")\n#{{f.body}}\n")
    timer: Val("print(\"time start\")\nif true {{\n    #{{g.body}}\n}}\n")
    assert(build_graph_rules_ok(build_session_call(a, "compiler.rewrite_body", [BuildSessionValue]{meta.copy(), .Text(value: "load"), .Text(value: "`trace_install` at main.jet:22"), .Text(value: ""), .Text(value: "f")}, trace, false, 5, 6)))
    assert(build_graph_rules_ok(build_session_call(a, "compiler.rewrite_body", [BuildSessionValue]{meta.copy(), .Text(value: "load"), .Text(value: "`timer_install` at main.jet:37"), .Text(value: ""), .Text(value: "g")}, timer, false, 7, 8)))
    assert(build_graph_rules_failed(build_session_call(a, "compiler.rewrite_body", [BuildSessionValue]{meta, .Text(value: "load"), .Text(value: "`build` at main.jet:50"), .Text(value: "")}, trace, false, 9, 10)))
    permit: a.storage.guard_read()
    assert_eq(permit.value.generated.len(), 1)
    assert_eq(permit.value.generated[0].source, "print(\"time start\")\nif true {{\n    print(\"enter\")\n    #{{load.body}}\n}}\n")
    assert(permit.value.generated[0].producer == Val("`trace_install` at main.jet:22, then `timer_install` at main.jet:37"))
    assert_eq(permit.value.generated[0].start, 5)
}

// A `Compiler` value passed to a function is a new value of the same build
// whose chain ends with that pass: what it adds records every handoff, root
// first, and keeps a stable identity. The consent a handed value gives is
// its root's, which the root's own rewrites read. A value of another build is
// not handed.
#Test("a_handed_compiler_value_records_its_chain_and_shares_its_roots_consent") {
    a := build_graph_rules_session(191)
    b := build_graph_rules_session(192)
    empty: build_graph_rules_list([String]{})
    app: build_graph_rules_value(build_session_call(a, "add_executable", [BuildSessionValue]{.Text(value: "app"), empty, empty}, None, false, 1, 2))
    other: build_graph_rules_value(build_session_call(b, "add_executable", [BuildSessionValue]{.Text(value: "app"), empty, empty}, None, false, 3, 4))
    meta: build_graph_rules_value(build_session_call(a, "compiler", [BuildSessionValue]{app}, None, false, 5, 6))
    foreign: build_graph_rules_value(build_session_call(b, "compiler", [BuildSessionValue]{other}, None, false, 7, 8))
    once: build_graph_rules_value(build_session_call(a, "compiler.handoff", [BuildSessionValue]{meta.copy(), .Text(value: "`build` handed it to `install` at main.jet:5")}, None, false, 9, 10))
    twice: build_graph_rules_value(build_session_call(a, "compiler.handoff", [BuildSessionValue]{once, .Text(value: "`install` handed it to `stage` at tool.jet:4")}, None, false, 11, 12))
    assert(build_graph_rules_failed(build_session_call(a, "compiler.handoff", [BuildSessionValue]{foreign, .Text(value: "`build` handed it to `install` at main.jet:5")}, None, false, 13, 14)))
    assert(build_graph_rules_ok(build_session_call(a, "compiler.add", [BuildSessionValue]{twice.copy(), .Text(value: "greeting"), .Text(value: "`stage` at tool.jet:8"), .Text(value: "Meta.Generate")}, Val("greeting: fn() -> String {{ \"hi\" }}\n"), false, 15, 16)))
    assert(build_graph_rules_ok(build_session_call(a, "compiler.allow_rewrite", [BuildSessionValue]{twice, .Text(value: "dep")}, None, false, 17, 18)))
    assert(build_graph_rules_ok(build_session_call(a, "compiler.rewrite_body", [BuildSessionValue]{meta, .Text(value: "load"), .Text(value: "`build` at main.jet:9"), .Text(value: "dep"), .Text(value: "")}, Val("print(\"enter\")\n"), false, 19, 20)))
    permit: a.storage.guard_read()
    assert_eq(permit.value.generated.len(), 2)
    assert_eq(permit.value.generated[0].handoffs, [String]{"`build` handed it to `install` at main.jet:5", "`install` handed it to `stage` at tool.jet:4"})
    assert(permit.value.generated[0].identity.starts_with("sha256:"))
    assert(permit.value.generated[0].identity != permit.value.generated[1].identity)
    assert_eq(permit.value.generated[1].handoffs.len(), 0)
    assert(permit.value.generated[1].consent == Val("dep"))
}

// A second compile (a workspace) is another Compiler value from the same
// `b.compiler(output)`. No option of a build that holds a Compiler value may
// skip or weaken a check: `bounds: off` or `report` is refused before
// `b.compiler` or after it, pinned or not; any other value, and a build
// without a Compiler value, stay as they were.
#Test("compiler_sessions_keep_checking_on") {
    a := build_graph_rules_session(190)
    empty: build_graph_rules_list([String]{})
    app: build_graph_rules_value(build_session_call(a, "add_executable", [BuildSessionValue]{.Text(value: "app"), empty, empty}, None, false, 1, 2))
    tool: build_graph_rules_value(build_session_call(a, "add_executable", [BuildSessionValue]{.Text(value: "tool"), empty, empty}, None, false, 3, 4))
    assert(build_graph_rules_ok(build_session_call(a, "optimize", [BuildSessionValue]{.Text(value: "optimize"), .Text(value: "full")}, None, false, 5, 6)))
    first: build_graph_rules_value(build_session_call(a, "compiler", [BuildSessionValue]{app}, None, false, 7, 8))
    second: build_graph_rules_value(build_session_call(a, "compiler", [BuildSessionValue]{tool}, None, false, 9, 10))
    assert_eq(first, BuildSessionValue.Handle{type_name: "Compiler", session: 190, id: 0})
    assert_eq(second, BuildSessionValue.Handle{type_name: "Compiler", session: 190, id: 1})
    after: build_graph_rules_failure(build_session_call(a, "bounds", [BuildSessionValue]{.Text(value: "bounds"), .Text(value: "off")}, None, false, 11, 12)) ?? panic("bounds off after b.compiler was accepted")
    assert_eq(after.code, "E3503")
    assert_eq(after.what, "`b.bounds(.Off)` weakens checking in a build that holds a `Compiler` value")
    assert_eq(after.start, 11)
    pinned: build_graph_rules_failure(build_session_call(a, "pin", [BuildSessionValue]{.Text(value: "bounds"), .Text(value: "report")}, None, false, 13, 14)) ?? panic("a pinned bounds report after b.compiler was accepted")
    assert_eq(pinned.what, "`b.pin(.bounds, .Report)` weakens checking in a build that holds a `Compiler` value")
    assert(build_graph_rules_ok(build_session_call(a, "bounds", [BuildSessionValue]{.Text(value: "bounds"), .Text(value: "fatal")}, None, false, 15, 16)))
    b := build_graph_rules_session(191)
    other: build_graph_rules_value(build_session_call(b, "add_executable", [BuildSessionValue]{.Text(value: "app"), empty, empty}, None, false, 1, 2))
    assert(build_graph_rules_ok(build_session_call(b, "bounds", [BuildSessionValue]{.Text(value: "bounds"), .Text(value: "off")}, None, false, 3, 4)))
    before: build_graph_rules_failure(build_session_call(b, "compiler", [BuildSessionValue]{other}, None, false, 5, 6)) ?? panic("b.compiler after bounds off was accepted")
    assert_eq(before.code, "E3503")
    assert_eq(before.start, 5)
}

// `meta.report(finding, at: c)` (`compiler.report`): the finding is kept in
// call order with its code, tier, texts, file, span and rewrite; a value of
// another build, an unknown tier or a lost span records nothing.
#Test("meta_report_keeps_each_finding_in_call_order") {
    a := build_graph_rules_session(193)
    b := build_graph_rules_session(194)
    empty: build_graph_rules_list([String]{})
    app: build_graph_rules_value(build_session_call(a, "add_executable", [BuildSessionValue]{.Text(value: "app"), empty, empty}, None, false, 1, 2))
    other: build_graph_rules_value(build_session_call(b, "add_executable", [BuildSessionValue]{.Text(value: "other"), empty, empty}, None, false, 3, 4))
    meta: build_graph_rules_value(build_session_call(a, "compiler", [BuildSessionValue]{app}, None, false, 5, 6))
    foreign: build_graph_rules_value(build_session_call(b, "compiler", [BuildSessionValue]{other}, None, false, 7, 8))
    texts: [BuildSessionValue]{.Text(value: "mypkg.NoPrintInLib"), .Text(value: "Tidy"), .Text(value: "library code prints"), .Text(value: "the caller owns the terminal"), .Text(value: "log it"), .Text(value: "main.jet")}
    found := [BuildSessionValue]{meta.copy()}
    loop text in texts -> found.push(text.copy())
    found.push(.Span(start: 40, end: 48))
    found.push(.Text(value: "log.info"))
    assert(build_graph_rules_ok(build_session_call(a, "compiler.report", found, None, false, 9, 10)))
    stray := [BuildSessionValue]{foreign}
    loop text in texts -> stray.push(text.copy())
    stray.push(.Span(start: 50, end: 58))
    stray.push(.Text(value: ""))
    assert(build_graph_rules_failed(build_session_call(a, "compiler.report", stray, None, false, 11, 12)))
    untiered := found.copy()
    untiered[2] = .Text(value: "Warning")
    assert(build_graph_rules_failed(build_session_call(a, "compiler.report", untiered, None, false, 13, 14)))
    unplaced := found.copy()
    unplaced[7] = .Int(value: 40)
    assert(build_graph_rules_failed(build_session_call(a, "compiler.report", unplaced, None, false, 15, 16)))
    later := found.copy()
    later[1] = .Text(value: "mypkg.Second")
    later[8] = .Text(value: "")
    assert(build_graph_rules_ok(build_session_call(a, "compiler.report", later, None, false, 17, 18)))
    permit: a.storage.guard_read()
    assert_eq(permit.value.findings.len(), 2)
    assert_eq(permit.value.findings[0].code, "mypkg.NoPrintInLib")
    assert_eq(permit.value.findings[0].tier, "Tidy")
    assert_eq(permit.value.findings[0].module, "main.jet")
    assert_eq(permit.value.findings[0].at_start, 40)
    assert_eq(permit.value.findings[0].at_end, 48)
    assert_eq(permit.value.findings[0].rewrite, "log.info")
    assert_eq(permit.value.findings[1].code, "mypkg.Second")
    assert_eq(permit.value.findings[1].rewrite, "")
}
#Test("invalid_toolchain_probe_and_signer_specs_do_not_reserve_names") {
    session := build_graph_rules_session(89)
    bad_toolchain: build_session_call(session, "toolchain", [BuildSessionValue]{.Text(value: "cross"), .Text(value: "")}, None, false, 1, 2)
    assert_eq(build_graph_rules_error(bad_toolchain), Val(BuildSessionError.EmptyToolchainTriple{value: "cross"}))
    toolchain: build_graph_rules_value(build_session_call(session, "toolchain", [BuildSessionValue]{.Text(value: "cross"), .Text(value: "wasm32-wasi")}, None, false, 3, 4))
    bad_signer: build_session_call(session, "signing", [BuildSessionValue]{.Text(value: "release"), .Text(value: "")}, None, false, 5, 6)
    assert_eq(build_graph_rules_error(bad_signer), Val(BuildSessionError.EmptyIdentityField{value: "release"}))
    assert(build_graph_rules_ok(build_session_call(session, "signing", [BuildSessionValue]{.Text(value: "release"), .Text(value: "developer-id:ACME")}, None, false, 7, 8)))
    bad_probe: build_session_call(session, "probe", [BuildSessionValue]{.Text(value: "sqlite"), .Text(value: "pkg_config"), .Text(value: "")}, None, true, 9, 10)
    assert_eq(build_graph_rules_error(bad_probe), Val(BuildSessionError.EmptyProbeField{value: "sqlite"}))
    assert(build_graph_rules_ok(build_session_call(session, "probe", [BuildSessionValue]{.Text(value: "sqlite"), .Text(value: "pkg_config"), .Text(value: "sqlite3"), toolchain}, None, true, 11, 12)))
}

#Test("a_step_toolchain_and_signer_change_its_action_key") {
    keys := [String]{}
    controls: [String]{"plain", "toolchain", "sign"}
    loop index in 0..<controls.len() {
        control: controls[index]
        session := build_graph_rules_session(90 + index)
        tool: build_graph_rules_tool(session)
        step: build_graph_rules_value(build_graph_rules_made(session, tool, "same", [String]{"build/out"}))
        if control == "toolchain" {
            cross: build_graph_rules_value(build_session_call(session, "toolchain", [BuildSessionValue]{.Text(value: "cross"), .Text(value: "wasm32-wasi")}, None, false, 7, 8))
            assert(build_graph_rules_ok(build_graph_rules_step(session, "toolchain", step, [BuildSessionValue]{cross})))
        }
        if control == "sign" {
            signer: build_graph_rules_value(build_session_call(session, "signing", [BuildSessionValue]{.Text(value: "dev"), .Text(value: "Developer")}, None, false, 7, 8))
            assert(build_graph_rules_ok(build_graph_rules_step(session, "sign", step, [BuildSessionValue]{signer})))
        }
        plan: build_graph_rules_value(build_session_call(session, "plan", [BuildSessionValue]{}, None, false, 11, 12))
        graph: build_session_graph(session, plan).graph ?? panic("plan graph")
        keys.push(graph.action_keys[0].key)
    }
    assert(keys[0] != keys[1])
    assert(keys[0] != keys[2])
    assert(keys[1] != keys[2])
}

#Test("run_steps_build_their_command_line_from_declared_files") {
    session := build_graph_rules_session(97)
    caps: build_graph_rules_list([String]{"Exec", "FS"})
    shell: build_graph_rules_value(build_session_call(session, "probe", [BuildSessionValue]{.Text(value: "shell"), .Text(value: "find_program"), .Text(value: "sh")}, None, true, 1, 2))
    found: build_graph_rules_value(build_session_call(session, "found", [BuildSessionValue]{shell}, None, true, 3, 4))
    assert(build_graph_rules_failed(build_session_call(session, "file.path", [BuildSessionValue]{found}, None, true, 5, 6)))
    gen: build_graph_rules_value(build_session_call(session, "run", [BuildSessionValue]{.Text(value: "gen"), found, caps}, None, true, 7, 8))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "arg", gen, [BuildSessionValue]{.Text(value: "-c")})))
    assert_eq(build_graph_rules_error(build_graph_rules_step(session, "arg", gen, [BuildSessionValue]{.Text(value: " ")})), Val(BuildSessionError.EmptyActionArgv{value: "gen"}))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "input", gen, [BuildSessionValue]{.Text(value: "gen.sh")})))
    tool: build_graph_rules_value(build_graph_rules_step(session, "output", gen, [BuildSessionValue]{.Text(value: "tool.sh"), .Text(value: "--out=")}))
    assert_eq(build_session_call(session, "file.path", [BuildSessionValue]{tool}, None, true, 11, 12), BuildSessionReply.Value{value: BuildSessionValue.Text{value: "tool.sh"}})
    assert(build_graph_rules_failed(build_graph_rules_step(session, "file", gen, [BuildSessionValue]{tool})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "timeout", gen, [BuildSessionValue]{.Text(value: "2min")})))
    assert(build_graph_rules_failed(build_graph_rules_step(session, "timeout", gen, [BuildSessionValue]{.Text(value: "10us")})))
    made: build_graph_rules_value(build_session_call(session, "run", [BuildSessionValue]{.Text(value: "made"), tool, caps}, None, true, 13, 14))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "reads", made, [BuildSessionValue]{.Text(value: "data.txt")})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "writes", made, [BuildSessionValue]{.Text(value: "made.txt")})))
    permit: session.storage.guard_read()
    first: permit.value.actions[0]
    assert_eq(first.argv, [String]{"sh", "-c", "gen.sh", "--out=tool.sh"})
    assert_eq(first.inputs, [String]{"gen.sh"})
    assert_eq(first.outputs, [String]{"tool.sh"})
    assert_eq(first.probes, [Int]{0})
    assert_eq(first.timeout_ms, Val(120000))
    second: permit.value.actions[1]
    assert_eq(second.argv, [String]{"tool.sh"})
    assert_eq(second.inputs, [String]{"tool.sh", "data.txt"})
    assert_eq(second.outputs, [String]{"made.txt"})
}

#Test("kept_outputs_stay_outside_jet") {
    session := build_graph_rules_session(95)
    tool: build_graph_rules_tool(session)
    step: build_graph_rules_value(build_session_call(session, "run", [BuildSessionValue]{.Text(value: "table"), tool, build_graph_rules_list([String]{"FS"})}, None, true, 5, 6))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "output", step, [BuildSessionValue]{.Text(value: "table.jet"), .Text(value: "--out="), .Bool(value: true)})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "writes", step, [BuildSessionValue]{.Text(value: "index.txt"), .Bool(value: true)})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "output", step, [BuildSessionValue]{.Text(value: "scratch.txt"), .Bool(value: false)})))
    assert(build_graph_rules_failed(build_graph_rules_step(session, "output", step, [BuildSessionValue]{.Text(value: ".jet/generated/table.jet"), .Bool(value: true)})))
    assert(build_graph_rules_failed(build_graph_rules_step(session, "writes", step, [BuildSessionValue]{.Text(value: ".jet"), .Bool(value: true)})))
    permit: session.storage.guard_read()
    action: permit.value.actions[0]
    assert_eq(action.argv, [String]{"tool", "--out=table.jet", "scratch.txt"})
    assert_eq(action.outputs, [String]{"table.jet", "index.txt", "scratch.txt"})
    assert_eq(action.kept, [String]{"table.jet", "index.txt"})
}

#Test("host_image_and_jet_tools_are_step_files") {
    session := build_graph_rules_session(99)
    caps: build_graph_rules_list([String]{"Exec", "FS"})
    empty: build_graph_rules_list([String]{})
    gen: build_graph_rules_value(build_session_call(session, "add_executable", [BuildSessionValue]{.Text(value: "gen"), build_graph_rules_list([String]{"gen/main.jet"}), empty}, None, false, 1, 2))
    lib: build_graph_rules_value(build_session_call(session, "add_library", [BuildSessionValue]{.Text(value: "lib"), build_graph_rules_list([String]{"lib.jet"}), empty}, None, false, 3, 4))
    assert(build_graph_rules_failed(build_session_call(session, "host", [BuildSessionValue]{lib}, None, false, 5, 6)))
    host: build_graph_rules_value(build_session_call(session, "host", [BuildSessionValue]{gen}, None, false, 7, 8))
    assert_eq(build_session_call(session, "file.path", [BuildSessionValue]{host}, None, false, 9, 10), BuildSessionReply.Value{value: BuildSessionValue.Text{value: ".jet/build/host/gen"}})
    assert(build_graph_rules_failed(build_session_call(session, "image", [BuildSessionValue]{lib}, None, false, 21, 22)))
    image: build_graph_rules_value(build_session_call(session, "image", [BuildSessionValue]{gen}, None, false, 23, 24))
    assert_eq(build_session_call(session, "file.path", [BuildSessionValue]{image}, None, false, 25, 26), BuildSessionReply.Value{value: BuildSessionValue.Text{value: ".jet/build/image/gen"}})
    jet: build_graph_rules_value(build_session_call(session, "jet", [BuildSessionValue]{}, None, false, 11, 12))
    assert(build_graph_rules_failed(build_session_call(session, "file.path", [BuildSessionValue]{jet}, None, false, 13, 14)))
    table: build_graph_rules_value(build_session_call(session, "run", [BuildSessionValue]{.Text(value: "table"), host, caps}, None, true, 15, 16))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "output", table, [BuildSessionValue]{.Text(value: "table.jet")})))
    check: build_graph_rules_value(build_session_call(session, "run", [BuildSessionValue]{.Text(value: "check"), jet, caps}, None, true, 17, 18))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "arg", check, [BuildSessionValue]{.Text(value: "check")})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", check, [BuildSessionValue]{host})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", check, [BuildSessionValue]{image})))
    assert(build_graph_rules_failed(build_graph_rules_step(session, "file", check, [BuildSessionValue]{jet})))
    toolchain: build_graph_rules_value(build_session_call(session, "toolchain", [BuildSessionValue]{.Text(value: "cross"), .Text(value: "wasm32-wasi")}, None, false, 19, 20))
    assert(build_graph_rules_failed(build_graph_rules_step(session, "toolchain", check, [BuildSessionValue]{toolchain})))
    permit: session.storage.guard_read()
    assert_eq(permit.value.actions[0].argv, [String]{".jet/build/host/gen", "table.jet"})
    assert_eq(permit.value.actions[0].inputs, [String]{".jet/build/host/gen"})
    assert_eq(permit.value.actions[1].argv, [String]{"jet", "check", ".jet/build/host/gen", ".jet/build/image/gen"})
    assert_eq(permit.value.actions[1].inputs, [String]{".jet/build/host/gen", ".jet/build/image/gen"})
}

#Test("dependency_files_are_step_files_under_jet_deps") {
    session := build_graph_rules_session(96)
    build_session_set_dependencies(session, [String: String]{"words": "/src/words"})
    caps: build_graph_rules_list([String]{"Exec", "FS"})
    assert(build_graph_rules_failed(build_session_call(session, "dependency", [BuildSessionValue]{.Text(value: "other")}, None, false, 1, 2)))
    words: build_graph_rules_value(build_session_call(session, "dependency", [BuildSessionValue]{.Text(value: "words")}, None, false, 3, 4))
    assert_eq(build_session_call(session, "file.path", [BuildSessionValue]{words}, None, false, 5, 6), BuildSessionReply.Value{value: BuildSessionValue.Text{value: ".jet/deps/words"}})
    assert(build_graph_rules_failed(build_session_call(session, "file.file", [BuildSessionValue]{words, .Text(value: "../escape.txt")}, None, false, 7, 8)))
    data: build_graph_rules_value(build_session_call(session, "file.file", [BuildSessionValue]{words, .Text(value: "data/answer.txt")}, None, false, 9, 10))
    assert_eq(build_session_call(session, "file.path", [BuildSessionValue]{data}, None, false, 11, 12), BuildSessionReply.Value{value: BuildSessionValue.Text{value: ".jet/deps/words/data/answer.txt"}})
    assert(build_graph_rules_failed(build_session_call(session, "file.file", [BuildSessionValue]{data, .Text(value: "more.txt")}, None, false, 13, 14)))
    assert(build_graph_rules_failed(build_session_call(session, "run", [BuildSessionValue]{.Text(value: "folder"), words, caps}, None, true, 15, 16)))
    gen: build_graph_rules_value(build_session_call(session, "file.file", [BuildSessionValue]{words, .Text(value: "gen.sh")}, None, false, 17, 18))
    step: build_graph_rules_value(build_session_call(session, "run", [BuildSessionValue]{.Text(value: "answer"), gen, caps}, None, true, 19, 20))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", step, [BuildSessionValue]{words})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", step, [BuildSessionValue]{data, .Text(value: "--in=")})))
    permit: session.storage.guard_read()
    assert_eq(permit.value.actions[0].argv, [String]{".jet/deps/words/gen.sh", ".jet/deps/words", "--in=.jet/deps/words/data/answer.txt"})
    assert_eq(permit.value.actions[0].inputs, [String]{".jet/deps/words/gen.sh", ".jet/deps/words/data/answer.txt"})
    assert_eq(permit.value.files[1].from, Val("/src/words/data/answer.txt"))
    folder: permit.value.files[permit.value.actions[0].folders[0]]
    assert_eq(folder.kind, "folder")
    assert_eq(folder.from, Val("/src/words"))
}

#Test("folders_are_read_whole_and_written_plainly") {
    session := build_graph_rules_session(99)
    build_session_set_dependencies(session, [String: String]{"words": "/src/words"})
    tool: build_graph_rules_tool(session)
    unplain: [String]{"", "../up", "/abs", "data/", "a//b", "./data", "data/."}
    loop bad in unplain {
        assert(build_graph_rules_failed(build_session_call(session, "folder", [BuildSessionValue]{.Text(value: bad)}, None, false, 1, 2)))
    }
    assert(build_graph_rules_ok(build_session_call(session, "folder", [BuildSessionValue]{.Text(value: ".")}, None, false, 1, 2)))
    data: build_graph_rules_value(build_session_call(session, "folder", [BuildSessionValue]{.Text(value: "data")}, None, false, 3, 4))
    assert_eq(build_session_call(session, "file.path", [BuildSessionValue]{data}, None, false, 5, 6), BuildSessionReply.Value{value: BuildSessionValue.Text{value: "data"}})
    assert(build_graph_rules_failed(build_session_call(session, "run", [BuildSessionValue]{.Text(value: "folder"), data, build_graph_rules_list([String]{})}, None, true, 7, 8)))
    words: build_graph_rules_value(build_session_call(session, "dependency", [BuildSessionValue]{.Text(value: "words")}, None, false, 9, 10))
    assert(build_graph_rules_failed(build_session_call(session, "file.folder", [BuildSessionValue]{words, .Text(value: "lib/")}, None, false, 11, 12)))
    lib: build_graph_rules_value(build_session_call(session, "file.folder", [BuildSessionValue]{words, .Text(value: "lib")}, None, false, 11, 12))
    assert(build_graph_rules_failed(build_session_call(session, "file.folder", [BuildSessionValue]{data, .Text(value: "sub")}, None, false, 13, 14)))
    step: build_graph_rules_value(build_graph_rules_made(session, tool, "pack", [String]{"out/pack.txt"}))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", step, [BuildSessionValue]{data, .Text(value: "--dir=")})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", step, [BuildSessionValue]{data})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", step, [BuildSessionValue]{lib})))
    plan: build_graph_rules_value(build_session_call(session, "plan", [BuildSessionValue]{}, None, false, 15, 16))
    assert(build_session_graph(session, plan).diagnostic == None)
    permit: session.storage.guard_read()
    assert_eq(permit.value.actions[0].argv, [String]{"tool", "out/pack.txt", "--dir=data", "data", ".jet/deps/words/lib"})
    assert_eq(permit.value.actions[0].inputs, [String]{})
    assert_eq(permit.value.actions[0].folders.len(), 2)
    shared: permit.value.files[permit.value.actions[0].folders[1]]
    assert_eq(shared.path, ".jet/deps/words/lib")
    assert_eq(shared.from, Val("/src/words/lib"))
}

#Test("no_step_output_lies_inside_a_folder_a_step_reads") {
    session := build_graph_rules_session(100)
    tool: build_graph_rules_tool(session)
    data: build_graph_rules_value(build_session_call(session, "folder", [BuildSessionValue]{.Text(value: "data")}, None, false, 1, 2))
    _: build_graph_rules_value(build_graph_rules_made(session, tool, "gen", [String]{"data/gen.txt"}))
    read: build_graph_rules_value(build_graph_rules_made(session, tool, "read", [String]{"read.txt"}))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", read, [BuildSessionValue]{data})))
    plan: build_graph_rules_value(build_session_call(session, "plan", [BuildSessionValue]{}, None, false, 3, 4))
    diagnostic: build_session_graph(session, plan).diagnostic ?? panic("an output inside a folder a step reads must refuse the plan")
    assert(diagnostic.what.contains("step `gen` makes `data/gen.txt` inside the folder `data` that step `read` reads whole"))
}

#Test("a_found_folder_is_read_whole_at_its_probe_name") {
    session := build_graph_rules_session(101)
    tool: build_graph_rules_tool(session)
    assert(build_graph_rules_failed(build_session_call(session, "probe", [BuildSessionValue]{.Text(value: "deep"), .Text(value: "find_folder"), .Text(value: "lib/libc.a")}, None, true, 1, 2)))
    nested: build_graph_rules_value(build_session_call(session, "probe", [BuildSessionValue]{.Text(value: "a/b"), .Text(value: "find_folder"), .Text(value: "libc.a")}, None, true, 1, 2))
    assert(build_graph_rules_failed(build_session_call(session, "found", [BuildSessionValue]{nested}, None, true, 3, 4)))
    musl: build_graph_rules_value(build_session_call(session, "probe", [BuildSessionValue]{.Text(value: "musl"), .Text(value: "find_folder"), .Text(value: "libc.a")}, None, true, 5, 6))
    lib: build_graph_rules_value(build_session_call(session, "found", [BuildSessionValue]{musl}, None, true, 7, 8))
    assert_eq(build_session_call(session, "file.path", [BuildSessionValue]{lib}, None, false, 9, 10), BuildSessionReply.Value{value: BuildSessionValue.Text{value: ".jet/found/musl"}})
    assert(build_graph_rules_failed(build_session_call(session, "run", [BuildSessionValue]{.Text(value: "folder"), lib, build_graph_rules_list([String]{})}, None, true, 11, 12)))
    step: build_graph_rules_value(build_graph_rules_made(session, tool, "link", [String]{"app"}))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", step, [BuildSessionValue]{lib, .Text(value: "-L")})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", step, [BuildSessionValue]{lib})))
    plan: build_graph_rules_value(build_session_call(session, "plan", [BuildSessionValue]{}, None, false, 13, 14))
    assert(build_session_graph(session, plan).diagnostic == None)
    permit: session.storage.guard_read()
    action: permit.value.actions[0]
    assert_eq(action.argv, [String]{"tool", "app", "-L.jet/found/musl", ".jet/found/musl"})
    assert_eq(action.folders.len(), 1)
    folder: permit.value.files[action.folders[0]]
    assert_eq(folder.kind, "folder")
    assert_eq(folder.from, None)
    probe: folder.probe ?? panic("a found folder keeps its probe")
    assert_eq(permit.value.probes[probe].name, "musl")
    assert(action.probes.contains(probe), "the step that reads a found folder runs its probe first")
}

#Test("a_found_program_is_passed_to_a_step_by_the_path_its_probe_finds") {
    session := build_graph_rules_session(102)
    tool: build_graph_rules_tool(session)
    cc_probe: build_graph_rules_value(build_session_call(session, "probe", [BuildSessionValue]{.Text(value: "cc"), .Text(value: "find_program"), .Text(value: "cc")}, None, true, 1, 2))
    cc: build_graph_rules_value(build_session_call(session, "found", [BuildSessionValue]{cc_probe}, None, true, 3, 4))
    assert(build_graph_rules_failed(build_session_call(session, "file.path", [BuildSessionValue]{cc}, None, false, 5, 6)))
    step: build_graph_rules_value(build_graph_rules_made(session, tool, "compile", [String]{"a.o"}))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", step, [BuildSessionValue]{cc, .Text(value: "--cc=")})))
    assert(build_graph_rules_ok(build_graph_rules_step(session, "file", step, [BuildSessionValue]{cc})))
    plan: build_graph_rules_value(build_session_call(session, "plan", [BuildSessionValue]{}, None, false, 7, 8))
    assert(build_session_graph(session, plan).diagnostic == None)
    permit: session.storage.guard_read()
    action: permit.value.actions[0]
    assert_eq(action.argv, [String]{"tool", "a.o", "--cc=cc", "cc"})
    assert_eq(action.inputs, [String]{})
    assert_eq(action.programs.len(), 2)
    assert_eq(action.programs[0].at, 2)
    assert_eq(action.programs[0].flag, "--cc=")
    assert_eq(action.programs[1].at, 3)
    assert_eq(action.programs[1].flag, "")
    probe: action.programs[0].probe
    assert_eq(permit.value.probes[probe].name, "cc")
    assert(action.probes.contains(probe), "the step passed a found program runs its probe first")
}

#Test("run_step_without_an_output_refuses_the_plan") {
    session := build_graph_rules_session(98)
    shell: build_graph_rules_value(build_session_call(session, "probe", [BuildSessionValue]{.Text(value: "shell"), .Text(value: "find_program"), .Text(value: "sh")}, None, true, 1, 2))
    found: build_graph_rules_value(build_session_call(session, "found", [BuildSessionValue]{shell}, None, true, 3, 4))
    _: build_graph_rules_value(build_session_call(session, "run", [BuildSessionValue]{.Text(value: "quiet"), found, build_graph_rules_list([String]{"Exec"})}, None, true, 5, 6))
    plan: build_graph_rules_value(build_session_call(session, "plan", [BuildSessionValue]{}, None, false, 7, 8))
    diagnostic: build_session_graph(session, plan).diagnostic ?? panic("a step with no output must refuse the plan")
    assert_eq(diagnostic.error, Val(BuildSessionError.StepWithoutOutputs{value: "quiet"}))
}
