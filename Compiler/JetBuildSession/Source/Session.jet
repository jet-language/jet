// Private compiler service linkage, not a second public Build API. The trusted
// build/comptime wrapper binds these symbols after ordinary checking. Handles
// remain the compiler's Build/BuildPlan/BuildAction/... nominal values.
// Source owns session mutation, validation and projection on every tier.
use core.crypto as build_crypto
use core.build.[BuildGraph, BuildGraphTarget, BuildGraphAction, BuildGraphActionKey, BuildGraphFile, BuildGraphNode, BuildGraphInputDigest]
use jet_foundation.[Span, build_option_row, type_name]

struct BuildSessionPolicy {
    legacy_denied: String?
    plugins_denied: String?
    plugin_grants: [String:[String]]
}

enum BuildSessionValue {
    Unit
    Text(value: String)
    Bool(value: Bool)
    Int(value: Int)
    Char(value: Char)
    Enum(variant: String)
    List(values: [BuildSessionValue])
    Handle(type_name: String, session: Int, id: Int)
    Span(start: Int, end: Int)
}

struct BuildSessionDiagnostic {
    code: String
    what: String
    why: String
    fix: String
    start: Int
    end: Int
    error: BuildSessionError?{None}
}

enum BuildSessionReply {
    Value(value: BuildSessionValue)
    Failure(error: BuildSessionDiagnostic)
    HostRequest(method: String, args: [BuildSessionValue])
}

struct BuildSessionGeneratedModule {
    name: String
    path: String
    source: String
    source_digest: String
    plugin: Int?
}

struct BuildSessionContribution {
    key: String
    value: BuildSessionValue
    source: String
    start: Int
    end: Int
}

struct BuildSessionToolchain {
    name: String
    role: String
    host_triple: String
    target_triple: String
    sdk: String?
    linker: String?
    sysroot: String?
}

struct BuildSessionProbe {
    name: String
    kind: String
    value: String
    code: String
    reproducibility: String
    toolchain: Int
}

struct BuildSessionSigning {
    name: String
    label: String
}

struct BuildSessionPlugin {
    name: String
    version: String
    api_version: String
    component_digest: String
    grants: [String]
}

struct BuildSessionAction {
    name: String
    inputs: [String]
    outputs: [String]
    argv: [String]
    caps: [String]
    toolchain: Int
    probes: [Int]
    signing: Int?
    kind: String
    pools: [String]
    env: [String:String]
    env_allowlist: [String]
    helpers: [String:String]
    labels: [String:String]
    cache: String
    legacy: String?
    plugin: Int?
    compiler_owned: Bool{false}
    variant_identity: String?{None}
}

struct BuildSessionTarget {
    name: String
    kind: String
    sources: [String]
    inputs: [String]
    outputs: [String]
    actions: [Int]
    deps: [Int]
    probes: [Int]
    toolchain: Int
    signing: Int?
    metadata: [String:String]
    plugin: Int?
}

// A build option `fn build` set (`b.optimize(.Full)`) or pinned
// (`b.pin(.optimize, .Full)`): its row and value as the option table spells
// them (JetFoundation BuildOptions.jet), and the call's span.
struct BuildSessionOption {
    name: String
    value: String
    pinned: Bool
    start: Int
    end: Int
}

struct BuildSessionState {
    id: Int
    active: Bool
    package: String
    compiler_version: String
    policy: BuildSessionPolicy
    actions: [BuildSessionAction]
    targets: [BuildSessionTarget]
    toolchains: [BuildSessionToolchain]
    signing: [BuildSessionSigning]
    probes: [BuildSessionProbe]
    plugins: [BuildSessionPlugin]
    generated: [BuildSessionGeneratedModule]
    contributions: [BuildSessionContribution]
    diagnostics: [BuildSessionDiagnostic]
    nodes: [BuildGraphNode]
    // One row per option `fn build` set, the last call's value.
    options: [BuildSessionOption]
    // The target `b.default(t)` selected, or -1 for every target.
    default_target: Int
    // The words after `--` on `jet build`, which `b.args()` returns.
    args: [String]
    start: Int
    end: Int
}

struct BuildSession { storage: Shared<BuildSessionState> }

fn build_session_new(session_id: Int, package: String, compiler_version: String, policy: BuildSessionPolicy) -> BuildSession Never! {
    {storage: shared BuildSessionState{
        id: session_id, active: true, package: package, compiler_version: compiler_version, policy: policy,
        actions: [BuildSessionAction]{}, targets: [BuildSessionTarget]{},
        toolchains: [BuildSessionToolchain]{{name: "host", role: "host", host_triple: "host", target_triple: "host", sdk: None, linker: None, sysroot: None}},
        signing: [BuildSessionSigning]{}, probes: [BuildSessionProbe]{}, plugins: [BuildSessionPlugin]{},
        generated: [BuildSessionGeneratedModule]{}, contributions: [BuildSessionContribution]{},
        diagnostics: [BuildSessionDiagnostic]{}, nodes: [BuildGraphNode]{}, options: [BuildSessionOption]{}, default_target: -1, args: [String]{}, start: 0, end: 0,
    }}
}

fn build_session_abort(session: &BuildSession) Never! {
    permit := session.storage.guard_edit()
    permit.value.active = false
}

// The words after `--` on `jet build` (`b.args()`); a new session has none.
fn build_session_set_args(session: &BuildSession, args: [String]) Never! {
    permit := session.storage.guard_edit()
    permit.value.args = args.copy()
}

// runtime_bridge.rs `build_diag`: a generated-source cycle is E3511, every
// other invalid graph fact the E3502 invalid-plan report.
fn build_session_diag(state: BuildSessionState, what: String) -> BuildSessionDiagnostic {
    if what.starts_with("E3511: ") {
        detail :: what.removeprefix("E3511: ")
        return {code: "E3511", what: "build plan is invalid: {detail}", why: "generated source must reach a bounded deterministic order, not loop until quiescent", fix: "break the dependency between these generators or give each generated module one owner", start: state.start, end: state.end}
    }
    {code: "E3502", what: "build plan is invalid: {what}", why: "`fn build` must describe one deterministic typed graph whose handles all belong to that build", fix: "fix the named target/action/toolchain/probe and run `jet inspect explain-build` to inspect the graph", start: state.start, end: state.end}
}

fn build_session_fail(state: BuildSessionState, what: String) -> BuildSessionReply {
    return BuildSessionReply.Failure{error: build_session_diag(state, what)}
}

// runtime_bridge.rs `eval_session_method`: an ambient build call outside
// `#Impure` is its own E3502 report, not an invalid-plan fact.
fn build_session_impure(state: BuildSessionState, method: String) -> BuildSessionReply {
    return BuildSessionReply.Failure{error: {code: "E3502", what: "`b.{method}` touches the ambient world and must be inside `#Impure(\"reason\")`", why: "build effects must be declared exactly where an auditor can see them", fix: "wrap the `b.{method}` call in `#Impure(\"why it is needed\")`", start: state.start, end: state.end}}
}

fn build_session_text(args: [BuildSessionValue], index: Int) -> String? {
    if index < args.len() && args[index] == .Text(text) -> return Val(text)
    None
}

fn build_session_strings(args: [BuildSessionValue], index: Int) -> [String]? {
    if index >= args.len() -> return None
    if args[index] == .List(values) {
        out := [String]{}
        loop value in values {
            if value == {
                .Text(text) -> &out.push(text)
                else -> return None
            }
        }
        return Val(out)
    }
    None
}

fn build_session_handle(state: BuildSessionState, value: BuildSessionValue, kind: String) -> Int? {
    if value == .Handle(type_name, session, id) {
        if type_name != kind || session != state.id -> return None
        if kind == "BuildPlan" && id >= -1 && id < state.targets.len() -> return Val(id)
        if id < 0 -> return None
        count :: if kind == {
            "BuildAction" -> state.actions.len()
            "BuildTarget" -> state.targets.len()
            "BuildToolchain" -> state.toolchains.len()
            "BuildProbe" -> state.probes.len()
            "BuildSigningIdentity" -> state.signing.len()
            else -> 0
        }
        if id < count -> return Val(id)
    }
    None
}

fn build_session_handles(state: BuildSessionState, args: [BuildSessionValue], index: Int, kind: String) -> [Int]? {
    if index >= args.len() -> return None
    if args[index] == .List(values) {
        out := [Int]{}
        loop value in values -> &out.push(build_session_handle(state, value, kind) ?? return None)
        return Val(out)
    }
    None
}

fn build_session_path(path: String) -> Bool {
    if path.trim() == "" || path.starts_with("/") -> return false
    loop part in path.split("/") { if part == ".." -> return false }
    true
}
fn build_session_path_error(path: String) -> BuildSessionError? Never! {
    if path.trim() == "" -> return Val(.EmptyPath)
    if !build_session_path(path) -> return Val(BuildSessionError.InvalidPath{value: path})
    None
}

fn build_session_paths(paths: [String]) -> Bool {
    loop path in paths { if !build_session_path(path) -> return false }
    true
}

fn build_session_map(entries: [String]) -> [String:String]? {
    out := [String:String]{}
    loop entry in entries {
        parts :: entry.split_once("=") ?? return None
        out[parts.before] = parts.after
    }
    Val(out)
}

fn build_session_unique(values: [String]) -> [String] {
    out := [String]{}
    loop value in values -> build_session_append_unique(&out, value)
    &out.sort()
    out
}

fn build_session_caps(values: [String]) -> [String]? {
    // Rust BuildEffect declaration order, not lexical string order.
    out := [String]{}
    normalized := [String]{}
    loop value in values {
        if value.contains(".") -> return None
        lower :: value.to_lower()
        if !build_session_contains_string([String]{"net", "fs", "io", "db", "time", "rand", "env", "exec", "log", "gpu"}, lower) -> return None
        build_session_append_unique(&normalized, lower)
    }
    loop flag in ([String]{"net", "fs", "io", "db", "time", "rand", "env", "exec", "log", "gpu"}) {
        if build_session_contains_string(normalized, flag) -> &out.push(flag)
    }
    Val(out)
}
fn build_session_cap_name(flag: String) -> String Never! {
    if flag == {
        "net" -> "Net"
        "fs" -> "FS"
        "io" -> "IO"
        "db" -> "DB"
        "time" -> "Time"
        "rand" -> "Rand"
        "env" -> "Env"
        "exec" -> "Exec"
        "log" -> "Log"
        "gpu" -> "GPU"
        else -> panic("invalid checked build effect")
    }
}

fn build_session_pools(values: [String]) -> [String] {
    known :: [String]{"cpu", "memory", "linker", "console", "gpu"}
    out := [String]{}
    custom := [String]{}
    loop value in values {
        lower :: value.to_lower()
        if build_session_contains_string(known, lower) -> build_session_append_unique(&out, lower)
        else -> build_session_append_unique(&custom, value)
    }
    ordered := [String]{}
    loop value in known { if build_session_contains_string(out, value) -> &ordered.push(value) }
    &custom.sort()
    loop value in custom -> &ordered.push(value)
    ordered
}

fn build_session_kind(value: String) -> String? {
    lower :: value.to_lower()
    if lower == "source_archive" -> return Val("source-archive")
    if build_session_contains_string([String]{"compile", "docs", "debug", "source-archive", "generic"}, lower) -> return Val(lower)
    None
}

fn build_session_call(session: &BuildSession, method: String, args: [BuildSessionValue], generated_source: String?, in_impure_gate: Bool, start: Int, end: Int) -> BuildSessionReply Never! {
    permit := session.storage.guard_edit()
    state := &permit.value
    state.start = start
    state.end = end
    if !state.active -> return build_session_fail(state, "build context expired")
    if method == "action" || method == "legacy" {
        index :: if method == "action" -> 4 else -> 5
        caps :: build_session_strings(args, index) ?? return build_session_fail(state, "build action effects must be a list of strings")
        if caps.len() > 0 && !in_impure_gate -> return build_session_impure(state, method)
        return build_session_add_action(&state, method, args)
    }
    if method.starts_with("add_") -> return build_session_add_target(&state, method, args)
    if method == "toolchain" -> return build_session_add_toolchain(&state, args)
    if method == "signing" -> return build_session_add_signing(&state, args)
    if method == "probe" -> return build_session_add_probe(&state, args, in_impure_gate)
    if method == "pin" -> return build_session_set_option(&state, args, true, start, end)
    if build_option_row(method) != None -> return build_session_set_option(&state, args, false, start, end)
    if method == "generate" {
        if args.len() != 1 -> return build_session_fail(state, "`b.generate` requires a name and typed item block")
        name :: build_session_text(args, 0) ?? return build_session_fail(state, "generated module name must be a string")
        source :: generated_source ?? return build_session_fail(state, "`b.generate` requires a typed item block, not a source string")
        path :: ".jet/generated/{build_session_package_dir(state.package)}/{build_session_safe_name(name)}.jet"
        return build_session_add_generated(&state, BuildSessionGeneratedModule{name: name, path: path, source: source, source_digest: "", plugin: None})
    }
    if method == "default" {
        if args.len() != 1 -> return build_session_fail(state, "`b.default` takes one target")
        state.default_target = build_session_handle(state, args[0], "BuildTarget") ?? return build_session_fail(state, "default target does not belong to this build")
        return BuildSessionReply.Value{value: BuildSessionValue.Unit}
    }
    if method == "args" {
        if args.len() != 0 -> return build_session_fail(state, "`b.args` takes no arguments")
        return BuildSessionReply.Value{value: BuildSessionValue.List{values: loop word in state.args -> BuildSessionValue.Text{value: word.copy()}}}
    }
    if method == "plan" {
        if args.len() > 1 -> return build_session_fail(state, "`b.plan` accepts zero or one default target")
        default := -1
        if args.len() == 1 -> default = build_session_handle(state, args[0], "BuildTarget") ?? return build_session_fail(state, "default target does not belong to this build")
        return BuildSessionReply.Value{value: BuildSessionValue.Handle{type_name: "BuildPlan", session: state.id, id: default}}
    }
    if method == "contribute" {
        if args.len() != 2 -> return build_session_fail(state, "`b.contribute` requires a fact name and one value")
        name :: build_session_text(args, 0) ?? return build_session_fail(state, "build fact name must be a string")
        if name.trim() == "" || name.contains(".") -> return build_session_fail(state, "`b.contribute` needs one declared setting name, such as `cache_slots`")
        if args[1] == {.Bool(_) | .Int(_) | .Char(_) | .Text(_) | .Enum(_) -> {} else -> return build_session_fail(state, "`b.contribute` accepts only Bool, Int, Char, String, or a fieldless enum value")}
        &state.contributions.push(BuildSessionContribution{key: "Build.Settings.{name}", value: args[1], source: "{state.package}::build", start: start, end: end})
        return BuildSessionReply.Value{value: BuildSessionValue.Unit}
    }
    if method == "error" -> return build_session_project_error(&state, args)
    if method == "plugin" {
        if args.len() != 2 || build_session_text(args, 0) == None || build_session_text(args, 1) == None -> return build_session_fail(state, "`b.plugin` requires manifest and component paths")
        if !in_impure_gate -> return build_session_impure(state, method)
        if state.policy.plugins_denied != None -> return build_session_fail(state, "wasm build plugin denied: {state.policy.plugins_denied ?? ""}")
        return BuildSessionReply.HostRequest{method: method, args: args}
    }
    // These calls use the existing locked input host service; no graph action
    // is run and no generated source is written by this request.
    if method == "find" || method == "embed" || method == "fetch" -> return BuildSessionReply.HostRequest{method: method, args: args}
    build_session_fail(state, "unknown build method `{method}`")
}

// `b.optimize(.Full)` (args: the row name, the value) or `b.pin(...)`: the
// last call's value holds; a pinned value can't change in the same fn build.
fn build_session_set_option(state: &BuildSessionState, args: [BuildSessionValue], pinned: Bool, start: Int, end: Int) -> BuildSessionReply {
    if args.len() != 2 -> return build_session_fail(state, "a build option call takes an option and a value")
    name :: build_session_text(args, 0) ?? return build_session_fail(state, "build option name must be a string")
    value :: build_session_text(args, 1) ?? return build_session_fail(state, "build option value must be a string")
    row :: build_option_row(name) ?? return build_session_fail(state, "`{name}` isn't a build option")
    if !row.values.contains(value) -> return build_session_fail(state, "`{value}` isn't a value of build option `{name}`")
    loop index in 0..<state.options.len() {
        if state.options[index].name != name -> next
        if state.options[index].pinned && state.options[index].value != value -> return build_session_fail(state, "build option `{name}` is pinned to `{state.options[index].value}`; `fn build` can't change it")
        // A pinned option keeps its pin's span: the pin is what a flag meets.
        if state.options[index].pinned && !pinned -> return BuildSessionReply.Value{value: BuildSessionValue.Unit}
        state.options[index] = BuildSessionOption{name: name.copy(), value: value.copy(), pinned: pinned, start: start, end: end}
        return BuildSessionReply.Value{value: BuildSessionValue.Unit}
    }
    &state.options.push(BuildSessionOption{name: name, value: value, pinned: pinned, start: start, end: end})
    BuildSessionReply.Value{value: BuildSessionValue.Unit}
}

// The `<package>` directory of `.jet/generated/<package>/`: the package name
// of a loader identity (`package:15:write_generated:0.1.0`, written by
// Loader.jet's jet_driver_package_identity), else the session's package as given.
fn build_session_package_dir(package: String) -> String {
    parts :: package.split(":").to_list()
    if parts.len() >= 3 && parts[0] == "package" && (Int.parse(parts[1]) ?? -1) == parts[2].len() -> return parts[2].copy()
    package.copy()
}

fn build_session_safe_name(name: String) -> String {
    bytes := [U8]{}
    loop byte in name.bytes() {
        n :: Int.from_u8(byte)
        if (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n == 95 || n == 45 -> &bytes.push(byte)
        else if n < 128 || n >= 192 -> &bytes.push(U8{95})
    }
    String.from_bytes(bytes) ?? panic("invalid generated module name")
}

fn build_session_add_generated(state: &BuildSessionState, generated: BuildSessionGeneratedModule) -> BuildSessionReply {
    if generated.name.trim() == "" || generated.path.trim() == "" || generated.source.trim() == "" -> return build_session_error_fail(state, BuildSessionError.EmptyGeneratedModuleField{value: generated.name})
    if !generated.path.starts_with(".jet/generated/") || !generated.path.ends_with(".jet") || !build_session_path(generated.path) -> return build_session_error_fail(state, BuildSessionError.InvalidGeneratedModulePath{value: generated.path})
    loop action in state.actions { if build_session_contains_string(action.outputs, generated.path) -> return build_session_error_fail(state, BuildSessionError.GeneratedModuleCycle{name: generated.name, path: generated.path}) }
    loop old in state.generated {
        if old.name == generated.name -> return build_session_error_fail(state, BuildSessionError.DuplicateGeneratedModuleName{value: generated.name})
        if old.path == generated.path -> return build_session_error_fail(state, BuildSessionError.DuplicateGeneratedModulePath{value: generated.path})
    }
    checked := generated
    checked.source_digest = "sha256:{build_crypto.sha256(checked.source.bytes()).hex()}"
    &state.generated.push(checked)
    BuildSessionReply.Value{value: BuildSessionValue.Unit}
}

fn build_session_add_toolchain(state: &BuildSessionState, args: [BuildSessionValue]) -> BuildSessionReply {
    if args.len() < 2 || args.len() > 6 -> return build_session_fail(state, "`b.toolchain` accepts two through six string arguments")
    texts := [String]{}
    loop index in 0..<args.len() -> &texts.push(build_session_text(args, index) ?? return build_session_fail(state, "toolchain fields must be strings"))
    name :: texts[0]
    if name.trim() == "" -> return build_session_error_fail(state, .EmptyToolchainName)
    loop old in state.toolchains { if old.name == name -> return build_session_error_fail(state, BuildSessionError.DuplicateToolchainName{value: name}) }
    host :: if texts.len() >= 3 -> texts[2] else -> "host"
    if texts[1].trim() == "" || host.trim() == "" -> return build_session_error_fail(state, BuildSessionError.EmptyToolchainTriple{value: name})
    loop index in 3..<texts.len() { if texts[index].trim() == "" -> return build_session_error_fail(state, BuildSessionError.EmptyIdentityField{value: name}) }
    id :: state.toolchains.len()
    &state.toolchains.push(BuildSessionToolchain{name: name, role: "target", target_triple: texts[1], host_triple: host, sdk: if texts.len() >= 4 -> Val(texts[3]) else -> None, linker: if texts.len() >= 5 -> Val(texts[4]) else -> None, sysroot: if texts.len() >= 6 -> Val(texts[5]) else -> None})
    BuildSessionReply.Value{value: BuildSessionValue.Handle{type_name: "BuildToolchain", session: state.id, id: id}}
}

fn build_session_add_signing(state: &BuildSessionState, args: [BuildSessionValue]) -> BuildSessionReply {
    if args.len() != 2 -> return build_session_fail(state, "`b.signing` requires name and label")
    name :: build_session_text(args, 0) ?? return build_session_fail(state, "signing name must be a string")
    label :: build_session_text(args, 1) ?? return build_session_fail(state, "signing label must be a string")
    if name.trim() == "" -> return build_session_error_fail(state, .EmptySigningIdentityName)
    if label.trim() == "" -> return build_session_error_fail(state, BuildSessionError.EmptyIdentityField{value: name})
    loop old in state.signing { if old.name == name -> return build_session_error_fail(state, BuildSessionError.DuplicateSigningIdentityName{value: name}) }
    id :: state.signing.len()
    &state.signing.push(BuildSessionSigning{name: name, label: label})
    BuildSessionReply.Value{value: BuildSessionValue.Handle{type_name: "BuildSigningIdentity", session: state.id, id: id}}
}

fn build_session_add_probe(state: &BuildSessionState, args: [BuildSessionValue], in_impure_gate: Bool) -> BuildSessionReply {
    if args.len() < 3 || args.len() > 6 -> return build_session_fail(state, "`b.probe` accepts three through six arguments")
    name :: build_session_text(args, 0) ?? return build_session_fail(state, "probe name must be a string")
    kind :: build_session_text(args, 1) ?? return build_session_fail(state, "probe kind must be a string")
    value :: build_session_text(args, 2) ?? return build_session_fail(state, "probe value must be a string")
    reproducible_gate := false
    loop index in 0..<args.len() { if index + 2 >= args.len() && args[index] == .Text(text) { if text.to_lower() == "reproducible" -> reproducible_gate = true } }
    if !reproducible_gate && !in_impure_gate -> return build_session_impure(state, "probe")
    if name.trim() == "" -> return build_session_error_fail(state, .EmptyProbeName)
    if value.trim() == "" -> return build_session_error_fail(state, BuildSessionError.EmptyProbeField{value: name})
    loop old in state.probes { if old.name == name -> return build_session_error_fail(state, BuildSessionError.DuplicateProbeName{value: name}) }
    code := ""
    control := 3
    if kind == "compile_check" {
        if args.len() < 4 -> return build_session_fail(state, "compile_check requires source code")
        code = build_session_text(args, 3) ?? return build_session_fail(state, "compile_check source must be a string")
        if code.trim() == "" -> return build_session_error_fail(state, BuildSessionError.EmptyProbeField{value: name})
        control = 4
    } else {
        if !build_session_contains_string([String]{"find_program", "pkg_config", "header"}, kind) -> return build_session_fail(state, "unknown typed probe kind `{kind}`")
        if args.len() > 5 -> return build_session_fail(state, "non-compile probes accept at most one reproducibility value and one toolchain")
    }
    if kind == "header" {
        invalid := !build_session_path(value)
        loop byte in value.bytes() {
            if byte == (U8{0}) || byte == (U8{10}) || byte == (U8{13}) || byte == (U8{34}) || byte == (U8{60}) || byte == (U8{62}) -> invalid = true
        }
        if invalid -> return build_session_error_fail(state, BuildSessionError.EmptyProbeField{value: name})
    }
    reproducibility := "ambient"
    toolchain := 0
    if control < args.len() {
        if args[control] == .Text(text) {
            reproducibility = text.to_lower()
            if reproducibility != "ambient" && reproducibility != "reproducible" -> return build_session_fail(state, "probe reproducibility must be `ambient` or `reproducible`")
            control += 1
        }
        if control < args.len() -> toolchain = build_session_handle(state, args[control], "BuildToolchain") ?? return build_session_fail(state, "probe toolchain does not belong to this build")
    }
    // All source probe constructors use ambient-record provenance without a
    // lock. Rust rejects reproducible classification on these same values.
    if reproducibility == "reproducible" -> return build_session_error_fail(state, BuildSessionError.MissingLockedProvenance{value: name})
    id :: state.probes.len()
    &state.probes.push(BuildSessionProbe{name: name, kind: kind, value: value, code: code, reproducibility: reproducibility, toolchain: toolchain})
    BuildSessionReply.Value{value: BuildSessionValue.Handle{type_name: "BuildProbe", session: state.id, id: id}}
}

fn build_session_project_error(state: &BuildSessionState, args: [BuildSessionValue]) -> BuildSessionReply {
    if args.len() != 5 -> return build_session_fail(state, "`b.error` requires SourceSpan, code, what, why, and fix")
    start := state.start
    end := state.end
    if args[0] == {
        .Span(first, last) -> {
            start = first
            end = last
        }
        else -> return build_session_fail(state, "argument 1 must be SourceSpan")
    }
    code :: build_session_text(args, 1) ?? return build_session_fail(state, "build rule code must be a string")
    what :: build_session_text(args, 2) ?? return build_session_fail(state, "build rule what must be a string")
    why :: build_session_text(args, 3) ?? return build_session_fail(state, "build rule why must be a string")
    fix :: build_session_text(args, 4) ?? return build_session_fail(state, "build rule fix must be a string")
    reserved := code.len() > 1 && (code.starts_with("E") || code.starts_with("W"))
    bytes :: code.bytes()
    loop index in 1..<bytes.len() { if bytes[index] < (U8{48}) || bytes[index] > (U8{57}) -> reserved = false }
    diagnostic := BuildSessionDiagnostic{code: code, what: what, why: why, fix: fix, start: start, end: end}
    if reserved {
        diagnostic = BuildSessionDiagnostic{code: "E3530", what: "build rule code `{code}` is reserved", why: "codes beginning with E or W followed only by digits belong to the compiler", fix: "use a project prefix such as `ORG01`", start: start, end: end}
    } else if code.trim() == "" || what.trim() == "" || why.trim() == "" || fix.trim() == "" {
        diagnostic = build_session_diag(state, "build rule errors require non-empty code, what, why, and fix")
    }
    &state.diagnostics.push(diagnostic)
    BuildSessionReply.Value{value: BuildSessionValue.Unit}
}

fn build_session_contains_string(values: [String], value: String) -> Bool Never! {
    loop item in values { if item == value -> return true }
    false
}
fn build_session_append_unique(values: &[String], value: String) Never! {
    if !build_session_contains_string(values, value) -> &values.push(value)
}

// Build failures are values only for the checked BuildError constructors.
// Parser/transport/gate failures remain diagnostics; never infer a variant by
// parsing a diagnostic's display text.
enum BuildSessionError {
    EmptyTargetName
    EmptyActionName
    EmptyToolchainName
    EmptySigningIdentityName
    EmptyProbeName
    DuplicateTargetName(value: String)
    DuplicateActionName(value: String)
    CompilerPackageDependencyMissing(package: String, dependency: String)
    DuplicateToolchainName(value: String)
    DuplicateSigningIdentityName(value: String)
    DuplicateProbeName(value: String)
    EmptyPath
    InvalidPath(value: String)
    EmptyToolchainTriple(value: String)
    EmptyIdentityField(value: String)
    MissingLockedProvenance(value: String)
    EmptyProbeField(value: String)
    EmptyActionArgv(value: String)
    EmptyEnvName(value: String)
    UndeclaredEnvName(action: String, key: String)
    CachedActionWithoutOutputs(value: String)
    PhonyActionWithoutCaps(value: String)
    PhonyActionWithOutputs(value: String)
    DuplicateActionOutput(action: String, output: String)
    DuplicateBuildOutput(output: String, first_action: String, second_action: String)
    UnknownTarget(id: Int)
    UnknownAction(id: Int)
    UnknownToolchain(id: Int)
    UnknownSigningIdentity(id: Int)
    UnknownProbe(id: Int)
    LegacyWrapperWithoutInputs(kind: String)
    LegacyWrapperWithoutOutputs(kind: String)
    LegacyWrapperWithoutCaps(kind: String)
    LegacyWrapperCommandMismatch(wrapper: String, actual: String)
    LegacyProjectFileMissing(kind: String)
    LegacyProjectFileInvalid(value: String)
    PolicyDenied(subject: String, allowed: Bool, reason: String, required_caps: [String])
    EmptyPluginField(value: String)
    InvalidPluginDigest(value: String)
    PackagedPlugin(value: String)
    PluginVersionMismatch(plugin: String, expected: String, actual: String)
    EmptyGeneratedModuleField(value: String)
    InvalidGeneratedModulePath(value: String)
    DuplicateGeneratedModuleName(value: String)
    DuplicateGeneratedModulePath(value: String)
    GeneratedModuleCycle(name: String, path: String)
    TargetDependencyCycle(nodes: [String])
    ActionDependencyCycle(nodes: [String])
}

struct BuildSessionErrorField { name: String value: String }
struct BuildSessionErrorProjection { variant: String text: String fields: [BuildSessionErrorField] }
fn build_session_error_field(name: String, value: String) -> BuildSessionErrorField Never! {
    {name: name, value: build_session_error_json_text(value)}
}
fn build_session_error_json_text(value: String) -> String Never! {
    bytes := [U8]{U8{34}}
    digits :: "0123456789abcdef".bytes()
    loop byte in value.bytes() {
        number :: Int.from_u8(byte)
        escaped := ""
        if number == 34 -> escaped = "\\\""
        else if number == 92 -> escaped = "\\\\"
        else if number == 10 -> escaped = "\\n"
        else if number == 13 -> escaped = "\\r"
        else if number == 9 -> escaped = "\\t"
        else if number < 32 {
            pair :: String.from_bytes([U8]{digits[number /% 16], digits[number % 16]}) ?? panic("invalid hex")
            escaped = "\\u00{pair}"
        }
        if escaped == "" -> &bytes.push(byte)
        else { loop part in escaped.bytes() -> &bytes.push(part) }
    }
    &bytes.push(U8{34})
    String.from_bytes(bytes) ?? panic("JSON preserves UTF8")
}
fn build_session_error_texts(values: [String]) -> String Never! {
    rows :: loop value in values -> build_session_error_json_text(value)
    "[{rows.join(",")}]"
}
fn build_session_error_plain(variant: String) -> BuildSessionErrorProjection Never! {
    {variant: variant, text: variant, fields: []}
}
fn build_session_error_one(variant: String, value: String, text: String) -> BuildSessionErrorProjection Never! {
    {variant: variant, text: text, fields: [BuildSessionErrorField]{build_session_error_field("value", value)}}
}
fn build_session_error_debug(variant: String, value: String) -> BuildSessionErrorProjection Never! {
    build_session_error_one(variant, value, "{variant}({build_key_debug_text(value)})")
}
fn build_session_error_id(variant: String, kind: String, id: Int) -> BuildSessionErrorProjection Never! {
    {variant: variant, text: "{variant}({kind}({id}))", fields: [BuildSessionErrorField]{{name: "id", value: "{id}"}}}
}
fn build_session_error_kind(variant: String, kind: String) -> BuildSessionErrorProjection Never! {
    wrapper :: if kind == {
        "cmake" -> "CMake"
        "make" -> "Make"
        "gradle" -> "Gradle"
        "npm" -> "Npm"
        "cargo" -> "Cargo"
        else -> panic("invalid checked legacy kind")
    }
    {variant: variant, text: "{variant}({wrapper})", fields: [BuildSessionErrorField]{build_session_error_field("kind", kind)}}
}
fn build_session_error_cycle(variant: String, kind: String, nodes: [String]) -> BuildSessionErrorProjection Never! {
    chain :: loop node in nodes -> "`{node}`"
    {variant: variant, text: "{kind} dependency graph contains a cycle: {chain.join(" -> ")}; a cycle has no build order, so no {kind} in it can ever start; remove one dependency from that chain", fields: [BuildSessionErrorField]{{name: "nodes", value: build_session_error_texts(nodes)}}}
}
fn build_session_error_projection(error: BuildSessionError) -> BuildSessionErrorProjection Never! {
    if error == {
        .EmptyTargetName -> build_session_error_plain("EmptyTargetName")
        .EmptyActionName -> build_session_error_plain("EmptyActionName")
        .EmptyToolchainName -> build_session_error_plain("EmptyToolchainName")
        .EmptySigningIdentityName -> build_session_error_plain("EmptySigningIdentityName")
        .EmptyProbeName -> build_session_error_plain("EmptyProbeName")
        .EmptyPath -> build_session_error_plain("EmptyPath")
        .DuplicateTargetName(value) -> build_session_error_one("DuplicateTargetName", value, "target name `{value}` is registered twice")
        .DuplicateActionName(value) -> build_session_error_one("DuplicateActionName", value, "action name `{value}` is registered twice")
        .DuplicateToolchainName(value) -> build_session_error_one("DuplicateToolchainName", value, "toolchain name `{value}` is registered twice")
        .DuplicateSigningIdentityName(value) -> build_session_error_debug("DuplicateSigningIdentityName", value)
        .DuplicateProbeName(value) -> build_session_error_one("DuplicateProbeName", value, "probe name `{value}` is registered twice")
        .InvalidPath(value) -> build_session_error_one("InvalidPath", value, "build path `{value}` must be relative and stay inside the project")
        .EmptyToolchainTriple(value) -> build_session_error_debug("EmptyToolchainTriple", value)
        .EmptyIdentityField(value) -> build_session_error_debug("EmptyIdentityField", value)
        .MissingLockedProvenance(value) -> build_session_error_debug("MissingLockedProvenance", value)
        .EmptyProbeField(value) -> build_session_error_debug("EmptyProbeField", value)
        .EmptyActionArgv(value) -> build_session_error_debug("EmptyActionArgv", value)
        .EmptyEnvName(value) -> build_session_error_debug("EmptyEnvName", value)
        .CachedActionWithoutOutputs(value) -> build_session_error_one("CachedActionWithoutOutputs", value, "cached action `{value}` declares no outputs")
        .PhonyActionWithoutCaps(value) -> build_session_error_one("PhonyActionWithoutCaps", value, "uncached action `{value}` declares no abilities")
        .PhonyActionWithOutputs(value) -> build_session_error_debug("PhonyActionWithOutputs", value)
        .LegacyWrapperWithoutInputs(kind) -> build_session_error_kind("LegacyWrapperWithoutInputs", kind)
        .LegacyWrapperWithoutOutputs(kind) -> build_session_error_kind("LegacyWrapperWithoutOutputs", kind)
        .LegacyWrapperWithoutCaps(kind) -> build_session_error_kind("LegacyWrapperWithoutCaps", kind)
        .LegacyProjectFileMissing(kind) -> ({variant: "LegacyProjectFileMissing", text: "legacy {kind} import requires `{build_session_legacy_file(kind)}` in the project root", fields: [BuildSessionErrorField]{build_session_error_field("kind", kind)}})
        .LegacyProjectFileInvalid(value) -> build_session_error_one("LegacyProjectFileInvalid", value, "legacy project file `{value}` must be a readable regular file")
        .EmptyPluginField(value) -> build_session_error_debug("EmptyPluginField", value)
        .InvalidPluginDigest(value) -> build_session_error_one("InvalidPluginDigest", value, "build plugin component digest is invalid: {value}")
        .PackagedPlugin(value) -> build_session_error_one("PackagedPlugin", value, "packaged build plugin rejected: {value}")
        .EmptyGeneratedModuleField(value) -> build_session_error_debug("EmptyGeneratedModuleField", value)
        .InvalidGeneratedModulePath(value) -> build_session_error_debug("InvalidGeneratedModulePath", value)
        .DuplicateGeneratedModuleName(value) -> build_session_error_one("DuplicateGeneratedModuleName", value, "E3511: generation rounds form a cycle: module `{value}` is generated twice")
        .DuplicateGeneratedModulePath(value) -> build_session_error_one("DuplicateGeneratedModulePath", value, "E3511: generation rounds form a cycle: path `{value}` is generated twice")
        .UnknownTarget(id) -> build_session_error_id("UnknownTarget", "TargetId", id)
        .UnknownAction(id) -> build_session_error_id("UnknownAction", "ActionId", id)
        .UnknownToolchain(id) -> build_session_error_id("UnknownToolchain", "ToolchainId", id)
        .UnknownSigningIdentity(id) -> build_session_error_id("UnknownSigningIdentity", "SigningIdentityId", id)
        .UnknownProbe(id) -> build_session_error_id("UnknownProbe", "ProbeId", id)
        .CompilerPackageDependencyMissing(package, dependency) -> ({variant: "CompilerPackageDependencyMissing", text: "compiler package `{package}` depends on missing package artifact `{dependency}`", fields: [BuildSessionErrorField]{build_session_error_field("package", package), build_session_error_field("dependency", dependency)}})
        .UndeclaredEnvName(action, key) -> ({variant: "UndeclaredEnvName", text: "action `{action}` allowlists undeclared environment variable `{key}`", fields: [BuildSessionErrorField]{build_session_error_field("action", action), build_session_error_field("key", key)}})
        .DuplicateActionOutput(action, output) -> ({variant: "DuplicateActionOutput", text: "DuplicateActionOutput {{ action: {build_key_debug_text(action)}, output: {build_key_debug_text(output)} }}", fields: [BuildSessionErrorField]{build_session_error_field("action", action), build_session_error_field("output", output)}})
        .DuplicateBuildOutput(output, first, second) -> ({variant: "DuplicateBuildOutput", text: "output `{output}` is owned by both `{first}` and `{second}`", fields: [BuildSessionErrorField]{build_session_error_field("output", output), build_session_error_field("first_action", first), build_session_error_field("second_action", second)}})
        .LegacyWrapperCommandMismatch(wrapper, actual) -> {
            name :: if wrapper == {
                "cmake" -> "CMake"
                "make" -> "Make"
                "gradle" -> "Gradle"
                "npm" -> "Npm"
                "cargo" -> "Cargo"
                else -> panic("invalid checked legacy kind")
            }
            {variant: "LegacyWrapperCommandMismatch", text: "LegacyWrapperCommandMismatch {{ wrapper: {name}, actual: {build_key_debug_text(actual)} }}", fields: [BuildSessionErrorField]{build_session_error_field("wrapper", wrapper), build_session_error_field("actual", actual)}}
        }
        .PluginVersionMismatch(plugin, expected, actual) -> ({variant: "PluginVersionMismatch", text: "PluginVersionMismatch {{ plugin: {build_key_debug_text(plugin)}, expected: {build_key_debug_text(expected)}, actual: {build_key_debug_text(actual)} }}", fields: [BuildSessionErrorField]{build_session_error_field("plugin", plugin), build_session_error_field("expected", expected), build_session_error_field("actual", actual)}})
        .GeneratedModuleCycle(name, path) -> ({variant: "GeneratedModuleCycle", text: "E3511: generation rounds form a cycle: `{name}` and `{path}` have two producers", fields: [BuildSessionErrorField]{build_session_error_field("module", name), build_session_error_field("path", path)}})
        .TargetDependencyCycle(nodes) -> build_session_error_cycle("TargetDependencyCycle", "target", nodes)
        .ActionDependencyCycle(nodes) -> build_session_error_cycle("ActionDependencyCycle", "action", nodes)
        .PolicyDenied(subject, allowed, reason, caps) -> {
            // PolicyExplanation Debug is part of the reference failed value.
            names :: loop cap in caps -> build_session_cap_name(cap)
            return {variant: "PolicyDenied", text: "PolicyDenied(PolicyExplanation {{ subject: {build_key_debug_text(subject)}, allowed: {allowed}, reason: {build_key_debug_text(reason)}, required_caps: [{names.join(", ")}] }})", fields: [BuildSessionErrorField]{build_session_error_field("subject", subject), {name: "allowed", value: "{allowed}"}, build_session_error_field("reason", reason), {name: "required_caps", value: build_session_error_texts(names)}}}
        }
    }
}
fn build_session_error_diag(state: BuildSessionState, error: BuildSessionError) -> BuildSessionDiagnostic Never! {
    projection :: build_session_error_projection(error)
    diagnostic := build_session_diag(state, projection.text)
    diagnostic.error = Val(error)
    diagnostic
}
fn build_session_error_fail(state: BuildSessionState, error: BuildSessionError) -> BuildSessionReply Never! {
    return BuildSessionReply.Failure{error: build_session_error_diag(state, error)}
}
