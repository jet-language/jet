// One checked plan graph for queries and compiler-generated declarations.
// No graph query executes an action, inspects a cache, or writes generated text.
use core.build.[BuildGraph, BuildGraphAction, BuildGraphActionKey, BuildGraphFile, BuildGraphTarget]

BuildSessionGraphResult: struct { graph: BuildGraph? diagnostic: BuildSessionDiagnostic? }
BuildSessionPlan: struct { storage: Shared<BuildSessionState> default: Int }
BuildSessionFinish: struct { plan: BuildSessionPlan? diagnostics: [BuildSessionDiagnostic] }

build_session_contains_int: fn(values: [Int], value: Int) -> Bool Never! {
    loop item in values { if item == value -> return true }
    false
}
build_session_append_int: fn(values: &[Int], value: Int) Never! {
    if !build_session_contains_int(values, value) -> values.push(value)
}
build_session_cycle: fn(edges: [[Int]], names: [String]) -> [String]? Never! {
    colors := [Int]{}
    loop _ in edges -> colors.push(0)
    loop root in 0..<edges.len() {
        if colors[root] != 0 -> next
        stack := [Int]{root}
        positions := [Int]{0}
        colors[root] = 1
        loop stack.len() > 0 {
            last: stack.len() - 1
            node: stack[last].copy()
            if positions[last] >= edges[node].len() {
                colors[node] = 2
                _ := stack.pop()
                _ := positions.pop()
                next
            }
            child: edges[node][positions[last]]
            positions[last] = positions[last] + 1
            if colors[child] == 2 -> next
            if colors[child] == 1 {
                chain := [String]{}
                adding := false
                loop current in stack {
                    if current == child -> adding = true
                    if adding -> chain.push(names[current])
                }
                chain.push(names[child])
                return Val(chain)
            }
            colors[child] = 1
            stack.push(child)
            positions.push(0)
        }
    }
    None
}
build_session_target_actions: fn(state: BuildSessionState, id: Int, selected: &[Int]) Never! {
    pending := [Int]{id}
    seen := [Int]{}
    loop pending.len() > 0 {
        current: pending.pop() ?? break
        if build_session_contains_int(seen, current) -> next
        seen.push(current)
        loop action in state.targets[current].actions -> build_session_append_int(selected, action)
        loop dependency in state.targets[current].deps -> pending.push(dependency)
    }
}
build_session_prerequisites: fn(state: BuildSessionState) -> [[Int]] Never! {
    edges := [[Int]]{}
    loop _ in state.actions -> edges.push([Int]{})
    loop target in state.targets {
        dependencies := [Int]{}
        loop dep in target.deps -> build_session_target_actions(state, dep, dependencies)
        loop action in target.actions { loop dep in dependencies -> build_session_append_int(edges[action], dep) }
    }
    owners := [String:Int]{}
    loop (id, action) in state.actions { loop output in action.outputs -> owners[output] = id }
    loop (id, action) in state.actions {
        loop input in action.inputs {
            if owners.get(input) == .Val(owner) && owner != id -> build_session_append_int(edges[id], owner)
        }
        edges[id].sort()
    }
    edges
}
build_session_validate: fn(state: BuildSessionState, default: Int) -> BuildSessionDiagnostic? Never! {
    if default < -1 || default >= state.targets.len() -> return Val(build_session_error_diag(state, BuildSessionError.UnknownTarget{id: default}))
    target_edges := [[Int]]{}
    target_names := [String]{}
    action_names := [String]{}
    owners := [String:Int]{}
    loop target in state.targets {
        loop id in target.actions { if id < 0 || id >= state.actions.len() -> return Val(build_session_error_diag(state, BuildSessionError.UnknownAction{id: id})) }
        loop id in target.deps { if id < 0 || id >= state.targets.len() -> return Val(build_session_error_diag(state, BuildSessionError.UnknownTarget{id: id})) }
        target_edges.push(target.deps)
        target_names.push(target.name)
    }
    loop (id, action) in state.actions {
        action_names.push(action.name)
        // A step leaves only its declared outputs, so a step with none is
        // reported at its own `b.run` call.
        if action.outputs.len() == 0 {
            diagnostic := build_session_error_diag(state, BuildSessionError.StepWithoutOutputs{value: action.name})
            diagnostic.start = action.start
            diagnostic.end = action.end
            return Val(diagnostic)
        }
        loop output in action.outputs {
            if owners.get(output) == .Val(first) -> return Val(build_session_error_diag(state, BuildSessionError.DuplicateBuildOutput{output: output, first_action: state.actions[first].name, second_action: action.name}))
            owners[output] = id
        }
    }
    if build_session_cycle(target_edges, target_names) == .Val(nodes) -> return Val(build_session_error_diag(state, BuildSessionError.TargetDependencyCycle{nodes: nodes}))
    if build_session_cycle(build_session_prerequisites(state), action_names) == .Val(nodes) -> return Val(build_session_error_diag(state, BuildSessionError.ActionDependencyCycle{nodes: nodes}))
    None
}
build_session_project: fn(state: BuildSessionState) -> BuildGraph Never! {
    targets := [BuildGraphTarget]{}
    actions := [BuildGraphAction]{}
    keys := [BuildGraphActionKey]{}
    file_rows := [String:BuildGraphFile]{}
    loop (id, target) in state.targets {
        paths := target.sources
        loop path in target.inputs -> paths.push(path.copy())
        loop path in target.outputs -> paths.push(path.copy())
        targets.push(BuildGraphTarget{id: id, name: target.name, kind: build_key_target_kind(target.kind), deps: target.deps, actions: target.actions, files: paths, plugin: target.plugin})
    }
    loop (id, action) in state.actions {
        target: build_session_action_target(state, id)
        key: build_session_action_key(state, id)
        actions.push(BuildGraphAction{id: id, name: action.name, kind: "generic", inputs: action.inputs, outputs: action.outputs, target: target, caps: loop flag in action.caps -> build_session_cap_name(flag), pools: [String]{"cpu"}, plugin: None, compiler_owned: false, key: key, cache_hit: None})
        keys.push(BuildGraphActionKey{action: action.name, key: key})
        loop output in action.outputs {
            row := file_rows.get(output) ?? BuildGraphFile{path: output, owner: None, consumers: [Int]{}, targets: [Int]{}}
            row.owner = Val(id)
            file_rows[output] = row.move()
        }
        loop input in action.inputs {
            row := file_rows.get(input) ?? BuildGraphFile{path: input, owner: None, consumers: [Int]{}, targets: [Int]{}}
            row.consumers.push(id)
            file_rows[input] = row.move()
        }
    }
    loop (id, target) in state.targets {
        paths := target.sources
        loop path in target.inputs -> paths.push(path.copy())
        loop path in target.outputs -> paths.push(path.copy())
        loop path in paths {
            row := file_rows.get(path) ?? BuildGraphFile{path: path, owner: None, consumers: [Int]{}, targets: [Int]{}}
            row.targets.push(id)
            file_rows[path] = row.move()
        }
        loop action_id in target.actions {
            action: state.actions[action_id]
            owner: build_session_action_target(state, action_id) ?? panic("checked target action lost its owner")
            action_paths := action.inputs
            loop path in action.outputs -> action_paths.push(path.copy())
            loop path in action_paths {
                row := file_rows.get(path) ?? BuildGraphFile{path: path, owner: None, consumers: [Int]{}, targets: [Int]{}}
                build_session_append_int(row.targets, owner)
                file_rows[path] = row.move()
            }
        }
    }
    paths := file_rows.keys().collect()
    paths.sort()
    files := [BuildGraphFile]{}
    loop path in paths -> files.push(file_rows.get(path) ?? panic("checked file index lost a path"))
    BuildGraph{targets: targets.move(), actions: actions.move(), action_keys: keys.move(), cache_hits: [BuildGraphAction]{}, files: files.move(), affected_files: [BuildGraphFile]{}, nodes: state.nodes}
}
build_session_graph: fn(session: BuildSession, returned: BuildSessionValue) -> BuildSessionGraphResult Never! {
    permit: session.storage.guard_read()
    if !permit.value.active -> return {graph: None, diagnostic: Val(build_session_diag(permit.value, "build context expired"))}
    default: build_session_handle(permit.value, returned, "BuildPlan") ?? return {graph: None, diagnostic: Val(build_session_diag(permit.value, "argument 1 must be a BuildPlan returned by this build"))}
    if build_session_validate(permit.value, default) == .Val(error) -> return {graph: None, diagnostic: Val(error)}
    {graph: Val(build_session_project(permit.value)), diagnostic: None}
}
build_session_finish: fn(session: &BuildSession, returned: BuildSessionValue) -> BuildSessionFinish Never! {
    permit := session.storage.guard_edit()
    state := &permit.value
    if !state.active -> return {plan: None, diagnostics: [BuildSessionDiagnostic]{build_session_diag(state, "build context expired")}}
    state.active = false
    // `build: fn(b: Build)` returns nothing: the session it configured is the plan.
    if returned != .Unit -> return {plan: None, diagnostics: [BuildSessionDiagnostic]{build_session_diag(state, "`build: fn` returns nothing")}}
    default: state.default_target
    if build_session_validate(state, default) == .Val(error) -> return {plan: None, diagnostics: [BuildSessionDiagnostic]{error}}
    {plan: Val(BuildSessionPlan{storage: session.storage, default: default}), diagnostics: state.diagnostics}
}
// What `jet build` runs: the selected targets (the default and its dependencies, or every
// target), dependencies first. `executables` compile their first source after the target's
// actions ran; `libraries` check theirs, as `jet check` does (a library is the source its
// importers compile; `jet build --lib` is the linkable native library); `unsupported` names
// the selected targets the build neither compiles, checks nor produces with actions.
// `options` are the build options fn build set, its layer of the build-option order.
// `source` is the target's first source, the one it compiles or checks; `sources` are every
// source it declares, which `jet build` requires to exist before any action runs.
BuildPlanExecutable: struct { name: String source: String sources: [String] }
BuildPlanSelection: struct { executables: [BuildPlanExecutable] libraries: [BuildPlanExecutable] unsupported: [String] options: [BuildSessionOption] }
build_plan_selection: fn(plan: BuildSessionPlan) -> BuildPlanSelection Never! {
    permit: plan.storage.guard_read()
    order := [Int]{}
    visiting := [Int]{}
    pending := [Int]{}
    if plan.default >= 0 -> pending.push(plan.default)
    else {
        index := permit.value.targets.len() - 1
        loop index >= 0 {
            pending.push(index)
            index -= 1
        }
    }
    // Iterative post-order: a target follows every dependency it names.
    loop pending.len() > 0 {
        current: pending[pending.len() - 1]
        if build_session_contains_int(order, current) {
            _: pending.pop()
            next
        }
        if build_session_contains_int(visiting, current) {
            _: pending.pop()
            order.push(current)
            next
        }
        visiting.push(current)
        loop dependency in permit.value.targets[current].deps {
            if !build_session_contains_int(order, dependency) -> pending.push(dependency)
        }
    }
    executables := [BuildPlanExecutable]{}
    libraries := [BuildPlanExecutable]{}
    unsupported := [String]{}
    loop index in order {
        target: permit.value.targets[index]
        if target.kind == "executable" && target.sources.len() > 0 {
            executables.push(BuildPlanExecutable{name: target.name.copy(), source: target.sources[0].copy(), sources: target.sources.copy()})
        } else if target.kind == "library" && target.sources.len() > 0 {
            libraries.push(BuildPlanExecutable{name: target.name.copy(), source: target.sources[0].copy(), sources: target.sources.copy()})
        } else if target.actions.len() == 0 {
            unsupported.push("{target.name} ({target.kind})")
        }
    }
    {executables: executables, libraries: libraries, unsupported: unsupported, options: permit.value.options.copy()}
}
build_plan_graph: fn(plan: BuildSessionPlan) -> BuildGraph Never! {
    permit: plan.storage.guard_read()
    build_session_project(permit.value)
}
// The declared graph `jet build` hands its executor, in declaration order:
// every handle id of the session indexes these lists. `default` is the
// target `b.default(t)` selected, or -1 for every target.
BuildPlanExecution: struct {
    toolchains: [BuildSessionToolchain]
    signing: [BuildSessionSigning]
    probes: [BuildSessionProbe]
    plugins: [BuildSessionPlugin]
    actions: [BuildSessionAction]
    targets: [BuildSessionTarget]
    default: Int
}
build_plan_execution: fn(plan: BuildSessionPlan) -> BuildPlanExecution Never! {
    permit: plan.storage.guard_read()
    BuildPlanExecution{toolchains: permit.value.toolchains.copy(), signing: permit.value.signing.copy(), probes: permit.value.probes.copy(), plugins: permit.value.plugins.copy(), actions: permit.value.actions.copy(), targets: permit.value.targets.copy(), default: plan.default}
}
// Every module `build: fn` generated, selected or not (`write_generated: on`
// writes them all for inspection), in path order.
build_plan_generated: fn(plan: BuildSessionPlan) -> [BuildSessionGeneratedModule] Never! {
    permit: plan.storage.guard_read()
    generated := permit.value.generated.copy()
    generated.sort_by((left: BuildSessionGeneratedModule, right: BuildSessionGeneratedModule) -> if left.path == right.path -> left.name <=> right.name else -> left.path <=> right.path)
    generated
}
// Every setting value `build: fn` contributed (`b.contribute`), in call order.
build_plan_contributions: fn(plan: BuildSessionPlan) -> [BuildSessionContribution] Never! {
    permit: plan.storage.guard_read()
    permit.value.contributions.copy()
}
build_plan_selected_generated: fn(plan: BuildSessionPlan) -> [BuildSessionGeneratedModule] Never! {
    permit: plan.storage.guard_read()
    selected_targets := [Int]{}
    selected_actions := [Int]{}
    paths := [String]{}
    pending := [Int]{}
    if plan.default >= 0 -> pending.push(plan.default)
    else { loop index in 0..<permit.value.targets.len() -> pending.push(index) }
    loop pending.len() > 0 {
        current: pending.pop() ?? break
        if build_session_contains_int(selected_targets, current) -> next
        selected_targets.push(current)
        loop path in permit.value.targets[current].sources -> build_session_append_unique(paths, path)
        loop action in permit.value.targets[current].actions -> build_session_append_int(selected_actions, action)
        loop dependency in permit.value.targets[current].deps -> pending.push(dependency)
    }
    prerequisites: build_session_prerequisites(permit.value)
    cursor := 0
    loop cursor < selected_actions.len() {
        current: selected_actions[cursor].copy()
        cursor += 1
        loop dep in prerequisites[current] -> build_session_append_int(selected_actions, dep)
    }
    loop action in selected_actions { loop output in permit.value.actions[action].outputs -> build_session_append_unique(paths, output) }
    generated := [BuildSessionGeneratedModule]{}
    loop generated_row in permit.value.generated {
        if permit.value.targets.len() == 0 || build_session_contains_string(paths, generated_row.path) -> generated.push(generated_row)
    }
    generated.sort_by((left: BuildSessionGeneratedModule, right: BuildSessionGeneratedModule) -> if left.path == right.path -> left.name <=> right.name else -> left.path <=> right.path)
    generated
}
