// Stable static plan identity: the Rust v2 length-prefixed byte contract.
// These keys contain no observed filesystem/cache/runtime facts.
// This file is compiler-private linkage, not the public core.build module.
// Reuse the compiler's canonical Rust Debug scalar table for failed values
// and key recipes; no second Unicode-printability convention.
use jet_foundation.[JET_RUST_DEBUG_ESCAPED_RANGES]
use core.crypto as build_crypto
use core.build.[BuildGraphInputDigest, BuildGraphNode]
fn build_key_number(bytes: &[U8], value: Int) Never! {
    divisor := 72057594037927936
    loop _ in 0..<8 {
        &bytes.push(U8{(value /% divisor) % 256})
        divisor = divisor /% 256
    }
}
fn build_key_text(bytes: &[U8], value: String) Never! {
    raw :: value.bytes()
    build_key_number(&bytes, raw.len())
    loop byte in raw -> &bytes.push(byte)
}
fn build_key_bool(bytes: &[U8], value: Bool) Never! { &bytes.push(if value -> U8{1} else -> U8{0}) }
fn build_key_texts(bytes: &[U8], values: [String]) Never! {
    build_key_number(&bytes, values.len())
    loop value in values -> build_key_text(&bytes, value)
}
fn build_key_map(bytes: &[U8], values: [String:String]) Never! {
    keys := values.keys().collect()
    &keys.sort()
    build_key_number(&bytes, keys.len())
    loop key in keys {
        build_key_text(&bytes, key)
        build_key_text(&bytes, values[key])
    }
}
fn build_key_declared_provenance(bytes: &[U8]) Never! {
    build_key_text(&bytes, "user-declared")
    build_key_text(&bytes, "fn build")
    build_key_bool(&bytes, false)
}
fn build_key_toolchain(bytes: &[U8], toolchain: BuildSessionToolchain) Never! {
    values :: [String]{toolchain.name, toolchain.role, toolchain.host_triple, toolchain.target_triple}
    loop value in values -> build_key_text(&bytes, value)
    build_key_bool(&bytes, toolchain.sdk != None)
    if toolchain.sdk == .Val(sdk) {
        build_key_text(&bytes, sdk)
        build_key_text(&bytes, "declared")
        build_key_declared_provenance(&bytes)
    }
    build_key_bool(&bytes, toolchain.linker != None)
    if toolchain.linker == .Val(linker) {
        build_key_text(&bytes, linker)
        build_key_declared_provenance(&bytes)
    }
    build_key_bool(&bytes, toolchain.sysroot != None)
    if toolchain.sysroot == .Val(sysroot) {
        build_key_text(&bytes, sysroot)
        build_key_text(&bytes, "declared")
        build_key_declared_provenance(&bytes)
    }
    build_key_text(&bytes, "tools")
    build_key_number(&bytes, 0)
    build_key_text(&bytes, "resolution")
    build_key_text(&bytes, "ambient")
    build_key_text(&bytes, "mounts")
    if toolchain.role == "host" {
        build_key_text(&bytes, "inferred-host")
        build_key_bool(&bytes, false)
    } else { build_key_declared_provenance(&bytes) }
}
fn build_key_probe(bytes: &[U8], state: BuildSessionState, probe: BuildSessionProbe) Never! {
    build_key_text(&bytes, probe.name)
    kind :: if probe.kind == {
        "find_program" -> "find-program"
        "pkg_config" -> "pkg-config"
        "header" -> "header-check"
        else -> "compile-check"
    }
    build_key_text(&bytes, kind)
    build_key_text(&bytes, probe.value)
    if probe.kind == "pkg_config" -> build_key_bool(&bytes, false)
    if probe.kind == "compile_check" {
        build_key_number(&bytes, 0)
        build_key_text(&bytes, probe.code)
    }
    build_key_text(&bytes, probe.reproducibility)
    build_key_text(&bytes, "ambient-record")
    build_key_text(&bytes, if probe.kind == "header" -> "header_check" else -> probe.kind)
    build_key_bool(&bytes, false)
    build_key_toolchain(&bytes, state.toolchains[probe.toolchain])
}
fn build_key_target_kind(kind: String) -> String Never! {
    if kind == {
        "executable" -> "Executable"
        "library" -> "Library"
        "test" -> "Test"
        "asset-bundle" -> "AssetBundle"
        "doc" -> "Doc"
        "install" -> "Install"
        "package" -> "Package"
        "publish" -> "Publish"
        else -> panic("invalid checked target kind")
    }
}
fn build_key_debug_text(value: String) -> String Never! {
    parts := [String]{"\""}
    raw :: value.bytes()
    position := 0
    loop position < raw.len() {
        start :: position
        first :: Int.from_u8(raw[position])
        position += 1
        scalar := first
        remaining := 0
        if first >= 240 {
            scalar = first.bit_and(7)
            remaining = 3
        } else if first >= 224 {
            scalar = first.bit_and(15)
            remaining = 2
        } else if first >= 192 {
            scalar = first.bit_and(31)
            remaining = 1
        }
        loop remaining > 0 {
            scalar = scalar * 64 + (Int.from_u8(raw[position]).bit_and(63))
            position += 1
            remaining -= 1
        }
        if scalar == {
            0 -> &parts.push("\\0")
            9 -> &parts.push("\\t")
            10 -> &parts.push("\\n")
            13 -> &parts.push("\\r")
            34 -> &parts.push("\\\"")
            92 -> &parts.push("\\\\")
            else -> {
                escaped := scalar < 32 || scalar == 127
                if scalar >= 128 {
                    low := 0
                    high := JET_RUST_DEBUG_ESCAPED_RANGES.len() /% 2
                    loop low < high {
                        middle :: low + (high - low) /% 2
                        if scalar < JET_RUST_DEBUG_ESCAPED_RANGES[middle * 2] -> high = middle
                        else if scalar > JET_RUST_DEBUG_ESCAPED_RANGES[middle * 2 + 1] -> low = middle + 1
                        else {
                            escaped = true
                            break
                        }
                    }
                }
                if escaped {
                    alphabet :: "0123456789abcdef".bytes()
                    digits := [U8]{}
                    number := scalar
                    loop {
                        &digits.push(alphabet[number % 16])
                        number = number /% 16
                        if number == 0 -> break
                    }
                    &digits.reverse()
                    hex :: String.from_bytes(digits) ?? panic("hex is ASCII")
                    &parts.push("\\u{{{hex}}}")
                } else { &parts.push(String.from_bytes_lossy(raw[start..<position])) }
            }
        }
    }
    &parts.push("\"")
    parts.join("")
}
fn build_key_contribution(value: BuildSessionValue) -> String Never! {
    if value == {
        .Bool(data) -> "Bool({data})"
        .Int(data) -> "Int({data})"
        .Char(data) -> "Char('{data}')"
        .Text(data) -> "Text({build_key_debug_text(data)})"
        .Enum(data) -> "Enum({build_key_debug_text(data)})"
        else -> panic("invalid checked build contribution")
    }
}
fn build_session_action_target(state: BuildSessionState, action: Int) -> Int? Never! {
    loop (index, target) in state.targets { loop selected in target.actions { if selected == action -> return Val(index) } }
    None
}
fn build_session_dep_outputs(state: BuildSessionState, action: Int) -> [String] Never! {
    target :: build_session_action_target(state, action) ?? return [String]{}
    paths := [String]{}
    loop dep in state.targets[target].deps {
        loop path in state.targets[dep].outputs -> build_session_append_unique(&paths, path)
        loop path in state.targets[dep].inputs -> build_session_append_unique(&paths, path)
        loop selected in state.targets[dep].actions { loop path in state.actions[selected].outputs -> build_session_append_unique(&paths, path) }
    }
    &paths.sort()
    paths
}
fn build_session_action_key(state: BuildSessionState, id: Int) -> String Never! {
    action :: state.actions[id]
    bytes := [U8]{}
    build_key_text(&bytes, "jet.action-key.v2")
    build_key_text(&bytes, "kind")
    build_key_text(&bytes, action.kind)
    observes :: action.kind != "generic"
    build_key_text(&bytes, "observe-exact-source")
    build_key_bool(&bytes, observes)
    build_key_text(&bytes, "compiler-owned")
    build_key_bool(&bytes, action.compiler_owned)
    build_key_text(&bytes, "argv")
    build_key_texts(&bytes, action.argv)
    build_key_text(&bytes, "env-allowlist")
    env := [String:String]{}
    loop key in action.env.keys() { if action.env_allowlist.len() == 0 || build_session_contains_string(action.env_allowlist, key) -> env[key] = action.env[key] }
    build_key_map(&bytes, env)
    build_key_text(&bytes, "inputs")
    build_key_texts(&bytes, action.inputs)
    build_key_text(&bytes, "input-snapshots")
    if observes {
        loop path in action.inputs {
            build_key_text(&bytes, path)
            build_key_bool(&bytes, false)
        }
    }
    build_key_number(&bytes, 0)
    build_key_text(&bytes, "outputs")
    build_key_texts(&bytes, action.outputs)
    build_key_text(&bytes, "dep-outputs")
    build_key_texts(&bytes, build_session_dep_outputs(state, id))
    build_key_text(&bytes, "caps")
    loop cap in action.caps -> build_key_text(&bytes, cap)
    build_key_text(&bytes, "cache")
    build_key_text(&bytes, action.cache)
    build_key_text(&bytes, "compiler-version")
    build_key_text(&bytes, state.compiler_version)
    build_key_text(&bytes, "helper-versions")
    build_key_map(&bytes, action.helpers)
    build_key_text(&bytes, "generated-modules")
    generated := state.generated
    generated = loop fresh_item in generated -> fresh_item
    &generated.sort_by((left: BuildSessionGeneratedModule, right: BuildSessionGeneratedModule) -> left.path <=> right.path)
    loop generated_row in generated {
        build_key_text(&bytes, generated_row.path)
        build_key_text(&bytes, generated_row.source_digest)
        if observes -> build_key_text(&bytes, generated_row.source)
    }
    build_key_text(&bytes, "build-fact-contributions")
    contributions := state.contributions
    contributions = loop fresh_item in contributions -> fresh_item
    &contributions.sort_by((left: BuildSessionContribution, right: BuildSessionContribution) -> left.key <=> right.key)
    loop contribution in contributions {
        values :: [String]{contribution.key, build_key_contribution(contribution.value), "function", "environment", contribution.source, "computed by fn build"}
        loop value in values -> build_key_text(&bytes, value)
        build_key_bool(&bytes, false)
        build_key_text(&bytes, "")
    }
    build_key_text(&bytes, "target")
    target :: build_session_action_target(state, id)
    build_key_bool(&bytes, target != None)
    if target == .Val(index) {
        selected :: state.targets[index]
        build_key_text(&bytes, selected.name)
        build_key_text(&bytes, build_key_target_kind(selected.kind))
        build_key_map(&bytes, selected.metadata)
        build_key_texts(&bytes, selected.sources)
    }
    build_key_text(&bytes, "toolchain")
    build_key_toolchain(&bytes, state.toolchains[action.toolchain])
    build_key_text(&bytes, "probes")
    loop index in action.probes -> build_key_probe(&bytes, state, state.probes[index])
    build_key_text(&bytes, "signing")
    build_key_bool(&bytes, action.signing != None)
    if action.signing == .Val(index) {
        selected :: state.signing[index]
        build_key_text(&bytes, selected.name)
        build_key_text(&bytes, selected.label)
        build_key_declared_provenance(&bytes)
    }
    build_key_text(&bytes, "variant")
    build_key_bool(&bytes, action.variant_identity != None)
    if action.variant_identity == .Val(identity) -> build_key_text(&bytes, identity)
    build_key_text(&bytes, "labels")
    build_key_map(&bytes, action.labels)
    build_key_text(&bytes, "resource-pools")
    pools :: if action.pools.len() == 0 -> [String]{"cpu"} else -> action.pools
    loop pool in pools {
        if !build_session_contains_string([String]{"cpu", "memory", "linker", "console", "gpu"}, pool) -> build_key_text(&bytes, "custom")
        build_key_text(&bytes, pool)
    }
    build_key_text(&bytes, "legacy")
    build_key_bool(&bytes, action.legacy != None)
    if action.legacy == .Val(wrapper) -> build_key_text(&bytes, wrapper)
    build_key_text(&bytes, "plugin")
    build_key_bool(&bytes, action.plugin != None)
    if action.plugin == .Val(index) {
        selected :: state.plugins[index]
        values :: [String]{selected.name, selected.version, selected.api_version, selected.component_digest}
        loop value in values -> build_key_text(&bytes, value)
        loop grant in selected.grants -> build_key_text(&bytes, grant)
    }
    "act-sha256:{build_crypto.sha256(bytes).hex()}"
}
fn build_session_compiler_node(kind: String, subject: String, input_digests: [BuildGraphInputDigest]) -> BuildGraphNode Never! {
    sorted := input_digests
    sorted = loop fresh_item in sorted -> fresh_item
    &sorted.sort_by((left: BuildGraphInputDigest, right: BuildGraphInputDigest) -> if left.name == right.name -> left.digest <=> right.digest else -> left.name <=> right.name)
    digests := [BuildGraphInputDigest]{}
    inputs := [String]{}
    previous := BuildGraphInputDigest?{None}
    loop row in sorted {
        if previous == .Val(old) && old.name == row.name && old.digest == row.digest -> next
        previous = Val(row)
        &digests.push(row)
        &inputs.push(row.name)
    }
    bytes := [U8]{}
    values :: [String]{"jet.action-key.v2", "compiler-node", kind, subject}
    loop value in values -> build_key_text(&bytes, value)
    loop row in digests {
        build_key_text(&bytes, row.name)
        build_key_text(&bytes, row.digest)
    }
    BuildGraphNode{kind: kind, key: build_crypto.sha256(bytes).hex(), subject: subject, inputs: ^inputs, input_digests: ^digests}
}
