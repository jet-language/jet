use jet_foundation.[ForeignLanguage, COverlayOverride, SOURCE_ROOT_DIR]

// Link-time validation of generated foreign binding artifacts, ported from
// jet_pkg_model::CFFI. Before a library's link flags are used, its generated
// archive, cache, and recorded inputs must still match their binding
// provenance, and a local native archive must export every bound symbol.
// Symbol inventories come from the pinned `nm` tool.

// Validate the artifacts behind one directly linked library.
fn pkg_cffi_validate_link_inputs(lib: String, project_root: String, target: String, flags: LinkFlags, overlay_overrides: [COverlayOverride], entry: String?) CFFIError! -[FS, Env, Exec, Time.Wait]> {
    bindings_root :: files.join(project_root, SOURCE_ROOT_DIR)
    cpp_prefix :: ForeignLanguage.Cpp.bridge_prefix()
    if lib.starts_with(cpp_prefix) {
        actual := lib.removeprefix(cpp_prefix) // #4303
        directory :: files.join(bindings_root, ForeignLanguage.Cpp.bindings_subdir())
        archive :: files.join(directory, "lib{lib}.a")
        pkg_cffi_validate_generated_artifact(files.join(directory, "{actual}.provenance"), archive, lib)
        return pkg_cffi_validate_cpp_symbols(actual, lib, archive, target, flags)
    }
    generated :: [ForeignLanguage]{ForeignLanguage.Java, ForeignLanguage.JS, ForeignLanguage.Py}
    loop language in generated {
        prefix :: language.bridge_prefix()
        if !lib.starts_with(prefix) -> next
        actual := lib.removeprefix(prefix) // #4303
        directory :: files.join(bindings_root, language.bindings_subdir())
        return pkg_cffi_validate_generated_artifact(files.join(directory, "{actual}.provenance"), files.join(directory, "lib{lib}.a"), lib)
    }
    com_prefix :: ForeignLanguage.Com.bridge_prefix()
    if lib.starts_with(com_prefix) {
        directory :: files.join(bindings_root, ForeignLanguage.Com.bindings_subdir())
        return pkg_cffi_validate_com_binding(lib.removeprefix(com_prefix), directory, files.join(directory, "lib{lib}.a"))
    }
    pkg_cffi_validate_c_binding(lib, project_root, overlay_overrides, entry)
}

fn pkg_cffi_validate_com_binding(lib: String, directory: String, archive: String) CFFIError! -[FS, Env, Exec, Time.Wait]> {
    generated_source :: files.join(directory, "{lib}.jet")
    provenance :: files.join(directory, "{lib}.provenance")
    pkg_com_validate_provenance(provenance, generated_source, archive, lib) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(provenance, "jet_com_{lib}", "the COM binding is invalid ({err.message()})")))
}

// A generated archive must hash to the digest its binding provenance
// recorded, and so must every recorded source and local archive input.
fn pkg_cffi_validate_generated_artifact(provenance_path: String, archive: String, lib: String) CFFIError! -[FS]> {
    if !files.is_file(provenance_path) -> return
    provenance :: pkg_bridge_read_provenance(provenance_path) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the binding provenance is invalid ({err.message})")))
    artifact_name :: files.basename(archive)
    expected :: provenance.value("artifact.{artifact_name}") ?? return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the binding provenance has no digest for `{artifact_name}`")))
    actual :: pkg_bridge_sha_file(archive) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the generated archive could not be read ({err.message})")))
    if expected != actual -> return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the generated archive digest differs from its binding provenance; regenerate the binding")))
    pkg_cffi_validate_provenance_source_inputs(provenance, provenance_path, lib)
    pkg_cffi_validate_provenance_archive_inputs(provenance, provenance_path, lib)
}

CFFI_PROVENANCE_SOURCE_ROLES :: prep { [String]{"source", "runtime", "declaration", "worker", "link"} }

// Every recorded source role still hashes to its recorded digest.
fn pkg_cffi_validate_provenance_source_inputs(provenance: ForeignProvenance, provenance_path: String, lib: String) CFFIError! -[FS]> {
    loop role in CFFI_PROVENANCE_SOURCE_ROLES {
        digest_key :: "{role}-sha256"
        if provenance.fields.get(role) == None {
            if provenance.fields.has_key(digest_key) -> return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the binding provenance has no path for `{role}`")))
            next
        }
        paths :: provenance.fields[role]
        digests :: provenance.fields.get(digest_key) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the binding provenance has no digest for `{role}`")))
        if paths.len() != digests.len() -> return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the binding provenance has an incomplete `{role}` inventory")))
        loop index in 0..<paths.len() {
            path :: paths[index]
            actual :: pkg_bridge_sha_file(path) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "foreign `{role}` `{path}` could not be read ({err.message}); regenerate the binding")))
            if actual != digests[index] -> return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "foreign `{role}` `{path}` differs from binding provenance; regenerate the binding")))
        }
    }
}

// Every recorded local archive still hashes to its recorded digest; an
// unreadable archive compares as `missing`.
fn pkg_cffi_validate_provenance_archive_inputs(provenance: ForeignProvenance, provenance_path: String, lib: String) CFFIError! -[FS]> {
    paths :: provenance.fields.get("linked-archive") ?? [String]{}
    digests :: provenance.fields.get("linked-archive-sha256") ?? [String]{}
    if paths.len() != digests.len() -> return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the binding provenance has an incomplete local archive inventory")))
    loop index in 0..<paths.len() {
        path :: paths[index]
        actual :: if files.read_bytes(path) == {
            .Ok(bytes) -> pkg_sha256_hex(bytes)
            .Err(_) -> "missing"
        }
        if actual != digests[index] -> return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "local archive `{path}` differs from binding provenance; regenerate the binding")))
    }
}

// A C binding's cache must match the identity and cache digest its
// provenance recorded, and a declared local archive must export every
// symbol the cache binds (after overlay replacements).
fn pkg_cffi_validate_c_binding(lib: String, project_root: String, overlay_overrides: [COverlayOverride], entry: String?) CFFIError! -[FS, Env, Exec, Time.Wait]> {
    cache :: pkg_cffi_binding_cache_file(project_root, ForeignLanguage.C, lib)
    if !files.is_file(cache) -> return
    provenance_path :: pkg_cffi_sidecar(cache, "provenance")
    if files.is_file(provenance_path) -> pkg_cffi_validate_c_binding_provenance(lib, project_root, cache, provenance_path, entry)
    inputs :: pkg_cffi_local_c_archive_inputs(project_root, lib, entry)
    if inputs.len() == 0 -> return
    input :: inputs[0]
    if !files.is_file(input.path) -> return
    if input.bytes == None -> return Err(pkg_cffi_error(pkg_cffi_e3208(cache, lib, "the local archive `{input.path}` could not be read")))
    source :: files.read(cache) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(cache, lib, "the generated C cache could not be read ({err})")))
    expected := pkg_cffi_binding_symbols(source)
    loop overlay in overlay_overrides {
        if overlay.lib != lib -> next
        remaining := [String]{}
        loop symbol in expected {
            if symbol != overlay.generated_symbol -> &remaining.push(symbol)
        }
        if !remaining.contains(overlay.overlay_symbol) -> &remaining.push(overlay.overlay_symbol)
        &remaining.sort()
        expected = remaining
    }
    if expected.len() == 0 -> return
    defined :: pkg_cffi_nm_symbols(input.path, false) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(cache, lib, "could not inventory exported symbols in `{input.path}` ({err.message})")))
    missing := [String]{}
    loop symbol in expected {
        if !defined.contains(pkg_cffi_normalize_nm_symbol(symbol)) -> &missing.push(symbol)
    }
    if missing.len() == 0 -> return
    return Err(pkg_cffi_error(pkg_cffi_e3208(cache, lib, "the local archive `{input.path}` is missing bound export symbol(s): {missing.join(", ")}; the binding is stale")))
}

fn pkg_cffi_validate_c_binding_provenance(lib: String, project_root: String, cache: String, provenance_path: String, entry: String?) CFFIError! -[FS, Env, Exec, Time.Wait]> {
    provenance :: pkg_bridge_read_provenance(provenance_path) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the C binding provenance is invalid ({err.message})")))
    header :: provenance.value("source") ?? return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the C binding provenance has no source header")))
    expected :: pkg_cffi_c_binding_identity_with_entry(project_root, lib, header, cache, entry) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the C binding inputs could not be read ({err.message})")))
    if provenance.identity != expected -> return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the C header, generated cache, or local archive changed after binding; regenerate the binding")))
    expected_cache :: provenance.value("artifact.{files.basename(cache)}")
    actual_cache :: pkg_bridge_sha_file(cache) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the generated C cache could not be read ({err.message})")))
    if expected_cache != Val(actual_cache) -> return Err(pkg_cffi_error(pkg_cffi_e3208(provenance_path, lib, "the generated C cache digest differs from its binding provenance; regenerate the binding")))
}

// The native symbols a generated cache binds: the quoted target of every
// `= "<symbol>"` declaration, sorted and unique.
fn pkg_cffi_binding_symbols(source: String) -> [String] Never! {
    symbols := [String]{}
    loop line in pkg_bridge_text_lines(source) {
        parts :: line.cut_last("= \"") ?? next
        symbol :: if parts.after.split_once("\"") == {
            .Val(quoted) -> quoted.before
            .None -> parts.after
        }
        if symbol != "" && !symbols.contains(symbol) -> &symbols.push(symbol)
    }
    &symbols.sort()
    symbols
}

// A generated C++ archive may only need symbols the local archives of its
// declared libraries export (C++ runtime and standard-library symbols aside).
fn pkg_cffi_validate_cpp_symbols(actual: String, lib: String, generated_archive: String, target: String, flags: LinkFlags) CFFIError! -[FS, Env, Exec, Time.Wait]> {
    generated_name :: "{ForeignLanguage.Cpp.bridge_prefix()}{actual}"
    libraries := [String]{}
    loop name in flags.link_names {
        bare := name
        if {
            name.starts_with("static=") -> bare = name.removeprefix("static=")
            name.starts_with("dylib=") -> bare = name.removeprefix("dylib=")
            name.starts_with("framework=") -> bare = name.removeprefix("framework=")
            else -> {}
        }
        if bare != generated_name && !pkg_cffi_cpp_runtime_library(bare, target) -> &libraries.push(bare)
    }
    inputs := [ArchiveInput]{}
    loop input in pkg_bridge_local_archive_inputs(flags.lib_dirs, libraries) {
        if files.is_file(input.path) -> &inputs.push(input)
    }
    if inputs.len() == 0 -> return
    defined := [String]{}
    loop input in inputs {
        if input.bytes == None -> return Err(pkg_cffi_error(pkg_cffi_e3208(generated_archive, lib, "the local archive `{input.path}` could not be read")))
        exported :: pkg_cffi_nm_symbols(input.path, false) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(generated_archive, lib, "could not inventory exported symbols in `{input.path}` ({err.message})")))
        loop symbol in exported {
            if !defined.contains(symbol) -> &defined.push(symbol)
        }
    }
    undefined :: pkg_cffi_nm_symbols(generated_archive, true) ?? return Err(pkg_cffi_error(pkg_cffi_e3208(generated_archive, lib, "could not inventory bound symbols in `{generated_archive}` ({err.message})")))
    missing := [String]{}
    loop symbol in undefined {
        if pkg_cffi_ignorable_cpp_symbol(symbol) || defined.contains(symbol) -> next
        &missing.push(symbol)
    }
    if missing.len() == 0 -> return
    return Err(pkg_cffi_error(pkg_cffi_e3208(generated_archive, lib, "local C++ archive inventory is missing bound symbol(s): {missing.join(", ")}; regenerate the binding or restore the archive")))
}

fn pkg_cffi_cpp_runtime_library(name: String, target: String) -> Bool Never! {
    if name == pkg_ffi_cxx_runtime_for_target(target) -> return true
    if name == {
        "c" | "m" | "dl" | "pthread" | "rt" | "gcc_s" -> true
        else -> false
    }
}

// `nm -g [-u] <path>`: the sorted global (or undefined) symbols.
fn pkg_cffi_nm_symbols(path: String, undefined: Bool) -[Exec, Time.Wait]> [String] ForeignBridgeError! {
    argv := [String]{"nm", "-g"}
    if undefined -> &argv.push("-u")
    &argv.push(path)
    receipt :: process.cmd(argv).run() ?? return Err(pkg_bridge_error(pkg_bridge_spawn_error("nm", err)))
    if !receipt.success {
        detail := receipt.errors.trim() // #4303
        return Err(pkg_bridge_error(if detail == "" -> "nm rejected the native archive" else -> detail))
    }
    Ok(pkg_cffi_parse_nm_symbols(receipt.output, undefined))
}

// Symbols of the requested kind from `nm` output rows (`[addr] <kind> <name>`).
fn pkg_cffi_parse_nm_symbols(output: String, undefined: Bool) -> [String] Never! {
    symbols := [String]{}
    loop line in pkg_bridge_text_lines(output) {
        tokens :: pkg_cffi_whitespace_tokens(line)
        if tokens.len() < 2 -> next
        is_undefined :: tokens.contains("U") || tokens.contains("u")
        if undefined != is_undefined -> next
        symbol :: tokens[tokens.len() - 1]
        if symbol == "" || symbol == "?" -> next
        normalized :: pkg_cffi_normalize_nm_symbol(symbol)
        if !symbols.contains(normalized) -> &symbols.push(normalized)
    }
    &symbols.sort()
    symbols
}

// Mach-O prefixes C symbols with one `_`.
fn pkg_cffi_normalize_nm_symbol(symbol: String) -> String Never! {
    symbol.removeprefix("_")
}

CFFI_IGNORABLE_CPP_PREFIXES :: prep { [String]{"ZSt", "ZNSt", "ZNKSt", "ZNS", "ZNKS", "ZTI", "ZTV", "ZTS", "ZTT", "Zda", "Zdl", "Zna", "Znw", "atomic_", "dynamic_cast", "errno_location", "gthread", "pthread", "dl", "sched_", "stack_chk", "__"} }
CFFI_IGNORABLE_CPP_FRAGMENTS :: prep { [String]{"cxa", "gxx_personality", "Unwind"} }
CFFI_IGNORABLE_CPP_NAMES :: prep { [String]{"abort", "free", "malloc", "memcpy", "memmove", "memset", "strlen"} }

// C++ runtime, standard-library, and libc symbols a generated archive may
// leave undefined for the platform to supply.
fn pkg_cffi_ignorable_cpp_symbol(raw: String) -> Bool Never! {
    symbol := raw
    loop symbol.starts_with("_") -> symbol = symbol.removeprefix("_")
    loop prefix in CFFI_IGNORABLE_CPP_PREFIXES {
        if symbol.starts_with(prefix) -> return true
    }
    loop fragment in CFFI_IGNORABLE_CPP_FRAGMENTS {
        if symbol.contains(fragment) -> return true
    }
    CFFI_IGNORABLE_CPP_NAMES.contains(symbol)
}
