use core.files as files
use jet_foundation.[ApplicationAuthority, Diagnostic, Span, StatusValue, StatusFields, StatusEnvelope, authority_holds, authority_parse_rights, diagnostic_from_registry, diagnostic_with_rights, diagnostic_with_detail, diagnostic_with_source_derived_suggestion, foundation_json_quote]

// The application-boundary effect projection (jet-pkg-model EffectBudget.rs
// `EffectProjection`, `project_*`, `application_policy_diagnostic`, and the
// summary renderers).
//
// Keep the four roles separate: `required_effects` is a sema fact;
// `granted_effects` and `denied_effects` are policy facts; `authority` names
// the policy source. Consumers never infer one role from another. Effect sets
// are sorted, duplicate-free `[String]` (Foundation `authority_holds`).

pub EFFECT_AUTHORITY_PACKAGE_HOLDS :: prep { "package.jet authority.holds" }
pub EFFECT_AUTHORITY_PACKAGE_GRANTS :: prep { "package.jet authority.grants" }
pub EFFECT_STATUS_ACTION :: prep { "build.effects" }

// One checked program's application-boundary view.
pub struct EffectProjection {
    pub required_effects: [String]
    pub granted_effects: [String]
    pub denied_effects: [String]
    pub authority: String

    // The beginner basics with no sema requirement yet (Rust `Default`).
    pub fn default() -> EffectProjection Never! {
        basics :: ApplicationAuthority.ambient_basics()
        EffectProjection{required_effects: [String]{}, granted_effects: basics.granted_effects, denied_effects: basics.denied_effects, authority: basics.authority}
    }

    // This checked application decision, carried into the execution bundle.
    pub fn application_authority(self) -> ApplicationAuthority Never! {
        ApplicationAuthority{
            required_effects: self.required_effects,
            granted_effects: self.granted_effects,
            denied_effects: self.denied_effects,
            authority: self.authority
        }
    }

    // Required effects with no policy verdict at the application boundary.
    pub fn undecided(self) -> [String] Never! {
        self.application_authority().undecided_effects()
    }

    pub fn is_allowed(self) -> Bool Never! {
        self.application_authority().is_allowed()
    }
}

// The entry file of a program run without any Package manifest: its E1803
// repair names the exact `--allow` invocation (D-SCRIPT-CONFIRM1=A) and
// inserts the leading inline Package carrier (D-ECO-INLINEPACKAGE1).
pub struct ScriptEntry {
    pub path: String
    pub source: String
    // The `jet` command that ran the script (`run`, `build`).
    pub command: String
}

// Project the application policy without changing the sema effect fact. A
// manifest-less program, and a manifest that writes no `authority.holds`
// (#3718), receive D-AUTH-AMBIENT1's beginner basics; written holds replace
// that default with exactly the written policy.
pub fn pkg_project_application_effects(required_effects: [String], manifest: PackageFacts?) -> EffectProjection Never! {
    facts :: manifest ?? return pkg_effect_floor_projection(required_effects, ApplicationAuthority.ambient_basics())
    if facts.authority.holds.allow == None && facts.authority.holds.deny == None {
        return pkg_effect_floor_projection(required_effects, ApplicationAuthority.package_default())
    }
    EffectProjection{
        required_effects: required_effects,
        granted_effects: authority_parse_rights(facts.authority.holds.allow ?? [String]{}),
        denied_effects: authority_parse_rights(facts.authority.holds.deny ?? [String]{}),
        authority: EFFECT_AUTHORITY_PACKAGE_HOLDS
    }
}

pub fn pkg_effect_floor_projection(required_effects: [String], floor: ApplicationAuthority) -> EffectProjection Never! {
    EffectProjection{required_effects: required_effects, granted_effects: floor.granted_effects, denied_effects: floor.denied_effects, authority: floor.authority}
}

// The projection of the exact selected entry, not the per-package aggregate.
pub fn pkg_project_program_effects(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String, manifest: PackageFacts?) -> EffectProjection Never! {
    pkg_project_application_effects(pkg_program_effects(program, summaries, default_entry), manifest)
}

// `Sema::show_set`: a set as `Net, FS.Read` in canonical order.
pub fn pkg_effect_show_set(effects: [String]) -> String Never! {
    effects.join(", ")
}

pub fn pkg_effect_names_or_none(effects: [String]) -> String Never! {
    if effects.len() == 0 -> return "none"
    pkg_effect_show_set(effects)
}

// E1803: the structured authority failure for JSON, redirected, and
// non-interactive invocations. The Why is one plain sentence; the role rows
// ride in structured detail for `--json`. A manifest-less `script` with
// undecided effects leads its Fix with the exact `--allow` command and also
// carries the inline Package block as a needs-review edit (D-RIGHTS-DIAG1=B);
// a denial is never repaired by a grant.
pub fn pkg_application_policy_diagnostic(projection: EffectProjection, denied: [String], script: ScriptEntry?) -> Diagnostic Never! {
    missing :: projection.undecided()
    authority :: projection.application_authority()
    denied_required :: authority.denied_required_effects()
    what :: if denied_required.len() == 0 -> "application authority is undecided for `{pkg_effect_show_set(missing)}`" else -> "application authority denies `{pkg_effect_show_set(denied_required)}`"
    repair :: script ?? {
        base :: diagnostic_from_registry("E1803", None, what, authority.policy_why(), authority.policy_fix())
        return diagnostic_with_rights(diagnostic_with_detail(^base, authority.policy_facts()), "authority", [String]{}, [String]{projection.authority}, None)
    }
    scripted :: denied.len() == 0 && missing.len() > 0 && authority.is_application_default()
    fix :: if scripted -> "run `jet {repair.command} --allow={missing.join(",")} {repair.path}` to allow it for this run, or {authority.policy_fix()}" else -> authority.policy_fix()
    base :: diagnostic_from_registry("E1803", None, what, authority.policy_why(), fix)
    diagnostic :: diagnostic_with_rights(diagnostic_with_detail(^base, authority.policy_facts()), "authority", [String]{}, [String]{projection.authority}, None)
    if !scripted -> return diagnostic
    at :: pkg_inline_package_insertion_offset(repair.source)
    diagnostic_with_source_derived_suggestion(diagnostic, Span{start: at, end: at}, pkg_inline_authority_package(repair.path, authority.inline_allow_row()))
}

// The inline Package carrier granting `allow` to the script at `path`; its
// name is the file stem, or `script` when the stem is not a plain name.
pub fn pkg_inline_authority_package(path: String, allow: [String]) -> String Never! {
    name :: pkg_effect_script_name(path)
    "package {{\n    name: \"{name}\"\n    authority: {{ holds: {{ allow: [{allow.join(", ")}] }} }}\n}}\n\n"
}

pub fn pkg_effect_script_name(path: String) -> String Never! {
    base :: files.basename(path)
    raw :: base.bytes()
    stem_end := raw.len()
    index := raw.len() - 1
    loop index > 0 {
        if Int.from_u8(raw[index]) == 46 {
            stem_end = index
            break
        }
        index -= 1
    }
    stem :: String.from_bytes(raw[0..<stem_end]) ?? ""
    if stem == "" -> return "script"
    loop byte in stem.bytes() {
        code :: Int.from_u8(byte)
        plain :: (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 || code == 45 || code == 46
        if !plain -> return "script"
    }
    stem
}

// Every effect reachable from `entry` through statically known calls.
pub fn pkg_entry_effects(summaries: [String: PackageEffectSummary], entry: String) -> [String] Never! {
    effects := [String]{}
    seen := [String: Bool]{}
    pending := [String]{entry}
    loop pending.len() > 0 {
        key :: &pending.pop() ?? break
        if seen.has_key(key) -> next
        seen[key] = true
        summary :: summaries.get(key) ?? next
        loop effect_name in summary.direct -> &effects.push(effect_name)
        loop edge in summary.edges -> &pending.push(edge)
    }
    authority_holds(effects)
}

pub fn pkg_program_effects(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> [String] Never! {
    candidates :: pkg_effect_entry_candidates(program, summaries, default_entry)
    if candidates.len() == 0 -> return [String]{}
    pkg_entry_effects(summaries, candidates[0])
}

pub fn pkg_render_effect_line(effects: [String]) -> String Never! {
    if effects.len() == 0 -> return "effects: none"
    "effects: {effects.join(", ")}"
}

pub fn pkg_effect_texts(effects: [String]) -> StatusValue Never! {
    items := [StatusValue]{}
    loop effect_name in effects -> &items.push(StatusValue.String{value: effect_name})
    StatusValue.Array{values: items}
}

pub fn pkg_render_effect_json(effects: [String]) -> String Never! {
    StatusEnvelope.new(EFFECT_STATUS_ACTION, true).with_field("effects", pkg_effect_texts(effects)).json()
}

pub fn pkg_effect_summary_line_for_program(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> String Never! {
    pkg_render_effect_line(pkg_program_effects(program, summaries, default_entry))
}

pub fn pkg_effect_summary_json_for_program(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String) -> String Never! {
    pkg_render_effect_json(pkg_program_effects(program, summaries, default_entry))
}

// Human application-boundary summary with explicit policy roles.
pub fn pkg_effect_summary_line_for_program_with_authority(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String, manifest: PackageFacts?) -> String Never! {
    pkg_render_effect_projection_line(pkg_project_program_effects(program, summaries, default_entry, manifest))
}

pub fn pkg_render_effect_projection_line(projection: EffectProjection) -> String Never! {
    "required effects: {pkg_effect_names_or_none(projection.required_effects)}; granted effects: {pkg_effect_names_or_none(projection.granted_effects)}; denied effects: {pkg_effect_names_or_none(projection.denied_effects)}; authority: {projection.authority}"
}

// The JSON object embedded in semantic-index, dossier, and Canvas documents,
// so the four roles stay one shared projection.
pub fn pkg_render_effect_projection_object(projection: EffectProjection) -> String Never! {
    required :: pkg_render_quoted_list(projection.required_effects)
    granted :: pkg_render_quoted_list(projection.granted_effects)
    denied :: pkg_render_quoted_list(projection.denied_effects)
    "{{\"required_effects\":[{required}],\"granted_effects\":[{granted}],\"denied_effects\":[{denied}],\"authority\":{foundation_json_quote(projection.authority)}}}"
}

// Typed embedding of the same four roles, preserving the supplied effect arrays.
pub fn pkg_effect_projection_status_value(projection: EffectProjection) -> StatusValue Never! {
    StatusValue.Object{fields: StatusFields.new()
        .with("required_effects", pkg_effect_texts(projection.required_effects))
        .with("granted_effects", pkg_effect_texts(projection.granted_effects))
        .with("denied_effects", pkg_effect_texts(projection.denied_effects))
        .with("authority", StatusValue.String{value: ~projection.authority})}
}

pub fn pkg_render_quoted_list(values: [String]) -> String Never! {
    quoted := [String]{}
    loop value in values -> &quoted.push(foundation_json_quote(value))
    quoted.join(",")
}

// Machine application-boundary summary. The legacy `effects` field stays for
// existing consumers; the role fields are the canonical view.
pub fn pkg_effect_summary_json_for_program_with_authority(program: EffectBudgetProgram, summaries: [String: PackageEffectSummary], default_entry: String, manifest: PackageFacts?) -> String Never! {
    pkg_render_effect_projection_json(pkg_project_program_effects(program, summaries, default_entry, manifest))
}

pub fn pkg_render_effect_projection_json(projection: EffectProjection) -> String Never! {
    required :: pkg_effect_texts(projection.required_effects)
    StatusEnvelope.new(EFFECT_STATUS_ACTION, true)
        .with_field("effects", required)
        .with_field("required_effects", required)
        .with_field("granted_effects", pkg_effect_texts(projection.granted_effects))
        .with_field("denied_effects", pkg_effect_texts(projection.denied_effects))
        .with_field("authority", StatusValue.String{value: ~projection.authority})
        .json()
}

// Human build status: effects reachable through statically known calls from
// the selected entry. Open function values stay conservative in enforcement
// but do not invent every ambient effect here.
pub fn pkg_effect_summary_line_for_entry(summaries: [String: PackageEffectSummary], entry: String) -> String Never! {
    pkg_render_effect_line(pkg_entry_effects(summaries, entry))
}

pub fn pkg_effect_summary_json_for_entry(summaries: [String: PackageEffectSummary], entry: String) -> String Never! {
    pkg_render_effect_json(pkg_entry_effects(summaries, entry))
}
