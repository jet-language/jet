use jet_foundation.[pkg_bytes_code, pkg_bytes_text]

// Byte-offset text helpers for the package-model source scanners.
//
// Manifest scanners track UTF-8 byte offsets and cut only at ASCII
// delimiters, so every slice they take is whole Unicode scalars. Whitespace
// follows the Unicode White_Space property, the same set `trim` removes.


// ASCII letters, digits, and `_`: the identifier characters word-boundary
// checks look for.
pub fn pkg_bytes_is_word(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
}

// The byte width of the White_Space scalar starting at `at`, or 0.
pub fn pkg_bytes_space_width(raw: [U8], at: Int) -> Int Never! {
    lead :: pkg_bytes_code(raw, at)
    if lead == 32 || (lead >= 9 && lead <= 13) -> return 1
    if lead < 128 -> return 0
    second :: pkg_bytes_code(raw, at + 1)
    third :: pkg_bytes_code(raw, at + 2)
    if lead == {
        // U+0085, U+00A0
        0xC2 -> if second == 0x85 || second == 0xA0 -> 2 else -> 0
        // U+1680
        0xE1 -> if second == 0x9A && third == 0x80 -> 3 else -> 0
        // U+2000..U+200A, U+2028, U+2029, U+202F, U+205F
        0xE2 -> {
            if second == 0x80 && ((third >= 0x80 && third <= 0x8A) || third == 0xA8 || third == 0xA9 || third == 0xAF) -> return 3
            if second == 0x81 && third == 0x9F -> return 3
            0
        }
        // U+3000
        0xE3 -> if second == 0x80 && third == 0x80 -> 3 else -> 0
        else -> 0
    }
}

// The first offset at or after `at` that does not start a White_Space scalar.
pub fn pkg_bytes_skip_space(raw: [U8], at: Int) -> Int Never! {
    cursor := at
    loop {
        width :: pkg_bytes_space_width(raw, cursor)
        if width == 0 -> return cursor
        cursor += width
    }
}

// Whether `value` holds a Unicode control scalar (C0, DEL, or C1): Rust's
// `char::is_control` over every scalar.
pub fn pkg_text_has_control(value: String) -> Bool Never! {
    raw :: value.bytes()
    loop index in 0..<raw.len() {
        code :: Int.from_u8(raw[index])
        if code < 32 || code == 127 -> return true
        // C1 controls U+0080..U+009F encode as 0xC2 0x80..0x9F.
        if code == 0xC2 && index + 1 < raw.len() {
            next_code :: Int.from_u8(raw[index + 1])
            if next_code >= 0x80 && next_code <= 0x9F -> return true
        }
    }
    false
}

// ASCII-only lowercase (`str::to_ascii_lowercase`); other scalars unchanged.
pub fn pkg_ascii_lower(value: String) -> String Never! {
    raw :: value.bytes()
    out := [U8]{}
    loop byte in raw {
        code :: Int.from_u8(byte)
        &out.push(if code >= 65 && code <= 90 -> U8{code + 32} else -> byte)
    }
    pkg_bytes_text(out, 0, out.len())
}
// A `[start, end)` byte range.
pub struct EditSpan {
    pub start: Int
    pub end: Int
}
