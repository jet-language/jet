use core.files.runtime.kernel_path_components as path_components
use core.files.runtime.kernel_path_components.[OSPath]

// Authority.rs containment is native component containment, not a textual
// prefix and not canonicalization. The sole Core path owner defines the law.
pub fn pkg_authority_path_within(path: OSPath, root: OSPath) -> Bool Never! {
    path_components.starts_with(path, root)
}
