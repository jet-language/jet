use jet_foundation.[mir_sha256_hex_bytes, mir_sha256_bytes]

// Lowercase hex SHA-256 of `bytes`, through the compiler's canonical infallible
// hash (the package model's `SHA256::sha256_hex`).
pub fn pkg_sha256_hex(bytes: [U8]) -> String Never! {
    mir_sha256_hex_bytes(mir_sha256_bytes(bytes))
}
