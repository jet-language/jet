use core.files.runtime.kernel_path_components as path_components
use core.files.runtime.kernel_path_components.[OSPath]
use core.files.host.retained_descriptor as bridge_io
use core.process.host.native_process as native_process
use core.sys.host.os_path_ingress as native_ingress
use core.sys as sys
use jet_foundation.[ForeignLanguage, BinderDescriptor, pkg_binder_descriptor]

// Queryable provenance sidecars for published foreign bridges, the canonical
// boundary row appended to binder records, local archive identity inputs, and
// pinned host-tool identities. Ported from jet_pkg_model::ForeignBridge.

FOREIGN_BRIDGE_LOCAL_ARCHIVE_SUFFIXES :: prep { [String]{".a", ".so", ".dylib", ".dll", ".lib"} }

// One exact file input in a bridge identity. The role is part of the record,
// so a declaration, runtime, header, or generated worker cannot be mistaken
// for another file merely because both have the same bytes.
pub struct BridgeSource {
    pub role: String
    pub path: OSPath
}

// A local native archive candidate used by a binding or link record.
// `bytes == None` is deliberate evidence that the candidate was absent or
// unreadable when the identity was made; never a permission to fall back.
pub struct ArchiveInput {
    pub library: String
    pub path: OSPath
    pub bytes: [U8]?
}


// The target identity used by adapters that do not receive a target argument.
// An environment-provided target wins over host guessing.
pub fn pkg_bridge_foreign_host_target() -[Env]> String Never! {
    if sys.get("JET_TARGET") == .Val(target) -> return target
    if sys.get("TARGET") == .Val(target) -> return target
    "{sys.arch()}-{sys.name()}"
}


fn pkg_bridge_field_value(fields: [(name: String, value: String)], name: String) -> String? Never! {
    loop field in fields {
        if field.name == name -> return Val(field.value)
    }
    None
}

fn pkg_bridge_bool_text(value: Bool) -> String Never! {
    if value -> "true" else -> "false"
}

// The capability rows that follow every appended boundary row.
fn pkg_bridge_append_capability_lines(text: &String, language: ForeignLanguage) ForeignBridgeError! {
    capability :: pkg_foreign_boundary_capability(language)
    pkg_bridge_append_line(&text, "boundary-mixed-debug", pkg_bridge_bool_text(capability.mixed_debug))
    pkg_bridge_append_line(&text, "boundary-native-export", pkg_bridge_bool_text(capability.native_export))
    pkg_bridge_append_line(&text, "boundary-build-host", pkg_bridge_bool_text(capability.build_host))
    pkg_bridge_append_line(&text, "boundary-reason", capability.reason)
}

// Render the common queryable provenance format without publishing a file.
// Binders use this when their result object carries the record to a CLI
// writer; `pkg_bridge_write_provenance` uses the same formatter on disk.
pub fn pkg_bridge_render_provenance(identity: String, fields: [(name: String, value: String)], artifacts: [(name: String, digest: String)]) -[Env]> String ForeignBridgeError! {
    text := "schema={FOREIGN_BRIDGE_PROVENANCE_SCHEMA}\nidentity={identity}\n"
    has_boundary_fields := false
    loop field in fields {
        if field.name.starts_with("boundary-") -> has_boundary_fields = true
    }
    language := ForeignLanguage?{None}
    if pkg_bridge_field_value(fields, "language") == .Val(root) -> language = ForeignLanguage.from_root(root)
    if has_boundary_fields -> language = None
    loop field in fields -> pkg_bridge_append_line(&text, field.name, field.value)
    if language == .Val(boundary_language) {
        abi_library := String?{None}
        if pkg_bridge_field_value(fields, "abi") == .Val(abi) {
            if abi.starts_with("jet_") {
                if abi.removeprefix("jet_").split_once("_") == .Val(parts) -> abi_library = Val(parts.after)
            }
        }
        library :: pkg_bridge_field_value(fields, "library") ?? (pkg_bridge_field_value(fields, "lib") ?? (abi_library ?? "not-recorded"))
        artifact_rows := [String]{}
        loop artifact in artifacts -> &artifact_rows.push("{artifact.name}:sha256-{artifact.digest}")
        loaded_artifact :: artifact_rows.join("|")
        source :: pkg_bridge_field_value(fields, "source") ?? (pkg_bridge_field_value(fields, "source_path") ?? (pkg_bridge_field_value(fields, "type-library") ?? "not-recorded"))
        overlay :: pkg_bridge_field_value(fields, "overlay") ?? (pkg_bridge_field_value(fields, "overlay-identity") ?? "none")
        generator :: pkg_bridge_field_value(fields, "binder-schema") ?? (pkg_bridge_field_value(fields, "descriptor") ?? "not-recorded")
        loaded_fallback :: if loaded_artifact != "" -> Val(loaded_artifact) else -> None
        implementation :: pkg_bridge_field_value(fields, "generated") ?? (pkg_bridge_field_value(fields, "worker") ?? (pkg_bridge_field_value(fields, "archive") ?? (loaded_fallback ?? "not-recorded")))
        toolchain :: pkg_bridge_field_value(fields, "toolchain") ?? (pkg_bridge_field_value(fields, "runtime") ?? (pkg_bridge_field_value(fields, "cc") ?? (pkg_bridge_field_value(fields, "compiler") ?? "not-recorded")))
        target :: pkg_bridge_field_value(fields, "target") ?? (pkg_bridge_field_value(fields, "foreign-host-target") ?? pkg_bridge_foreign_host_target())
        descriptor :: pkg_binder_descriptor(boundary_language) ?? return Err(pkg_bridge_error("missing binder descriptor for {boundary_language.debug_name()}"))
        loaded :: if loaded_artifact == "" -> "not-recorded" else -> loaded_artifact
        boundary :: ForeignBoundaryContract.new(descriptor, library, ForeignBoundaryIdentity.new(source, overlay, generator, implementation, toolchain, target)).with_artifact_coverage(ForeignArtifactCoverage.new(loaded, target, generator))
        loop field in boundary.provenance_fields() -> pkg_bridge_append_line(&text, field.name, field.value)
        pkg_bridge_append_capability_lines(&text, boundary_language)
    }
    loop artifact in artifacts -> pkg_bridge_append_line(&text, "artifact.{artifact.name}", artifact.digest)
    Ok(text)
}

// Write the queryable provenance sidecar for one published bridge: stage
// beside the target, then rename into place.
pub fn pkg_bridge_write_provenance(path: OSPath, identity: String, fields: [(name: String, value: String)], artifacts: [(name: String, digest: String)]) ForeignBridgeError! -[FS, Env]> {
    text :: pkg_bridge_render_provenance(identity, fields, artifacts)
    temporary :: path_components.with_extension(path, "tmp.{sys.pid()}")
    bridge_io.write(temporary, text.bytes()) ?? return Err(pkg_bridge_error("could not stage {path_components.display(path)}: {err}"))
    bridge_io.rename(temporary, path) ?? {
        bridge_io.remove(temporary) ?? ()
        return Err(pkg_bridge_error("could not publish {path_components.display(path)}: {err}"))
    }
}

// Append the canonical boundary row to a binder-owned provenance record.
// A record that already carries a boundary row is left unchanged.
pub fn pkg_bridge_append_boundary_provenance(text: &String, descriptor: @BinderDescriptor, library: String, identity: ForeignBoundaryIdentity, coverage: ForeignArtifactCoverage) ForeignBridgeError! {
    loop line in text.split("\n") {
        if line.starts_with("boundary-schema=") -> return
    }
    if !text.ends_with("\n") -> text = "{text}\n"
    boundary :: ForeignBoundaryContract.new(descriptor, library, identity).with_artifact_coverage(coverage)
    loop field in boundary.provenance_fields() -> pkg_bridge_append_line(&text, field.name, field.value)
    pkg_bridge_append_capability_lines(&text, descriptor.language)
}

// Append a boundary for an adapter that publishes a legacy text record.
pub fn pkg_bridge_append_boundary_for_artifact(text: &String, descriptor: @BinderDescriptor, library: String, source: OSPath, archive: OSPath, toolchain: String) ForeignBridgeError! -[FS, Env, Exec, Time.Wait]> {
    source_digest :: pkg_bridge_sha_file(source)
    archive_digest :: pkg_bridge_sha_file(archive)
    archive_extent :: path_components.file_name_span(archive) ?? return Err(pkg_bridge_error("foreign artifact path has no file name"))
    archive_name :: path_components.display_span(archive, archive_extent)
    target :: pkg_bridge_foreign_host_target()
    pkg_bridge_append_boundary_provenance(&text, descriptor, library, ForeignBoundaryIdentity.new("source:{path_components.display(source)}:sha256-{source_digest}", "none", descriptor.stamp(), "archive:{archive_name}:sha256-{archive_digest}", toolchain, target), ForeignArtifactCoverage.new("{archive_name}:sha256-{archive_digest}", target, descriptor.stamp()))
}

// Native reads use the sole retained descriptor producer, with the captured
// text decoder preserving its exact messages and one existing error wrapper.
pub fn pkg_bridge_read_provenance(path: OSPath) -[FS]> ForeignProvenance ForeignBridgeError! {
    text :: bridge_io.read_text(path) ?? return Err(pkg_bridge_error("could not read {path_components.display(path)}: {err}"))
    pkg_bridge_read_provenance_text(path_components.display(path), text) ?? return Err(pkg_bridge_error(err))
}

pub fn pkg_bridge_read_boundary_provenance(path: OSPath) -[FS]> ForeignProvenance ForeignBridgeError! {
    text :: bridge_io.read_text(path) ?? return Err(pkg_bridge_error("could not read {path_components.display(path)}: {err}"))
    pkg_bridge_read_boundary_provenance_text(path_components.display(path), text) ?? return Err(pkg_bridge_error(err))
}

// Resolve each named native library to the first exact local archive found
// in the declared search paths. Missing candidates remain records, so adding
// or replacing a local archive changes the identity.
pub fn pkg_bridge_local_archive_inputs(library_dirs: [OSPath], libraries: [String]) -[FS, Env]> [ArchiveInput] Never! {
    inputs := [ArchiveInput]{}
    if library_dirs.len() == 0 -> return inputs
    loop library in libraries {
        found := OSPath?{None}
        loop directory in library_dirs {
            if found != None -> break
            loop suffix in FOREIGN_BRIDGE_LOCAL_ARCHIVE_SUFFIXES {
                candidate :: pkg_authority_named_join(directory, "lib{library}{suffix}")
                if bridge_io.is_file(candidate) {
                    found = Val(candidate)
                    break
                }
            }
        }
        path :: found ?? pkg_authority_named_join(library_dirs[0], "lib{library}.a")
        canonical :: bridge_io.canonicalize(path) ?? path
        bytes :: if bridge_io.read_bytes(canonical) == {
            .Ok(value) -> Val(value)
            .Err(_) -> None
        }
        &inputs.push(ArchiveInput{library: library, path: canonical, bytes: bytes})
    }
    inputs
}

// Add local archive path/byte records to a binding identity.
pub fn pkg_bridge_add_local_archive_inputs(identity: &ForeignIdentityBuilder, library_dirs: [OSPath], libraries: [String]) -[FS, Env]> {
    pkg_bridge_add_archive_inputs(&identity, pkg_bridge_local_archive_inputs(library_dirs, libraries))
}

// Add already-resolved archive records to an identity. Callers with a
// provider-specific notion of local libraries use this without manufacturing
// missing candidates for system or provisioned dependencies.
pub fn pkg_bridge_add_archive_inputs(identity: &ForeignIdentityBuilder, inputs: [ArchiveInput]) Never! {
    loop input in inputs {
        &identity.field("linked_library", input.library.bytes())
        &identity.field("linked_archive_path", input.path.encoded)
        if input.bytes == {
            .Val(bytes) -> {
                &identity.field("linked_archive_bytes", bytes)
            }
            .None -> {
                &identity.field("linked_archive_missing", "true".bytes())
            }
        }
    }
}

// Both complete original cfg bodies await the ONE canonical family publisher.
// pkg_bridge_tool_path is deliberately UNDECLARED, exactly like Root/Studio;
// #4483/D-LANG-IN-LIBS has no published selector. No lexical/host proxy.
fn pkg_bridge_tool_path_nonwindows_body(tool: String) -[FS, Env]> OSPath? Never! {
    search :: native_ingress.var_os("PATH") ?? return None
    loop directory in native_ingress.split_paths(search) {
        candidate :: pkg_authority_named_join(directory, tool)
        if bridge_io.is_file(candidate) -> return Val(candidate)
    }
    None
}

fn pkg_bridge_tool_path_windows_body(tool: String) -[FS, Env]> OSPath? Never! {
    search :: native_ingress.var_os("PATH") ?? return None
    loop directory in native_ingress.split_paths(search) {
        candidate :: pkg_authority_named_join(directory, tool)
        if bridge_io.is_file(candidate) -> return Val(candidate)
        suffixed :: pkg_authority_named_join(directory, "{tool}.exe")
        if bridge_io.is_file(suffixed) -> return Val(suffixed)
    }
    None
}

// `<canonical path>;version=<first non-empty --version lines joined by ` | `>`,
// `missing` when the tool is absent, `unavailable` when it cannot report.
pub fn pkg_bridge_tool_identity(tool: String) -[FS, Env, Exec, IO, Time.Wait]> String Never! {
    found :: pkg_bridge_tool_path(tool) ?? return "missing"
    path :: bridge_io.canonicalize(found) ?? found
    version := "unavailable"
    command := native_process.command(path)
    &command.args([OSPath]{path_components.from_text("--version", path.platform)})
    if command.output() == .Ok(receipt) {
        if receipt.status.success {
            rows := [String]{}
            loop line in pkg_bridge_text_lines("{String.from_bytes_lossy(receipt.stdout)}{String.from_bytes_lossy(receipt.stderr)}") {
                trimmed := line.trim() // #4303: this view flows into a String row.
                if trimmed != "" -> &rows.push(trimmed)
            }
            joined :: rows.join(" | ")
            if joined != "" -> version = joined
        }
    }
    "{path_components.display(path)};version={version}"
}

pub fn pkg_bridge_sha_file(path: OSPath) -[FS]> String ForeignBridgeError! {
    bytes :: bridge_io.read_bytes(path) ?? return Err(pkg_bridge_error("could not read {path_components.display(path)}: {err}"))
    Ok(pkg_sha256_hex(bytes))
}

pub fn pkg_bridge_spawn_error(tool: String, error: IOError) -> String Never! {
    if error == {
        .NotFound(_) -> "the provisioned {tool} tool was not found"
        else -> "could not start {tool}: {error}"
    }
}
