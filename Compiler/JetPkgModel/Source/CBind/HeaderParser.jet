use jet_foundation.[ForeignAbiContract, foundation_generated_type_name, pkg_bytes_text, pkg_bytes_starts_with]

// The focused C header parser behind the C `#Bindgen` generator, ported from
// jet_pkg_model::CBind: comment/directive/linkage stripping, declaration and
// prototype splitting, C type spelling helpers, and the header's type catalog
// (typedef aliases, callback typedefs, and complete C-layout records).
//
// The catalog is a declaration table, not a library table: aliases resolve
// through the header's own typedefs and no API name is inspected.

// One parsed C function prototype.
struct CProto {
    ret: String
    name: String
    params: [String]
}

// A complete C struct that can be represented by a checked `#Layout(c)` Jet
// struct. Unsupported fields make the whole record unavailable; a partial
// record would change its native stride and make array marshalling unsound.
// C unions stay overlay-only.
struct CStructDef {
    jet_name: String
    fields: [(name: String, ty: String)]
}

struct CRawRecord {
    struct_tag: String?
    alias: String?
    body: String
}

// The callback typedef marker the catalog stores as an alias target:
// `__jet_callback__<ret>|<param>|<param>...`.
CBIND_CALLBACK_MARKER :: prep { "__jet_callback__" }

// Header type facts shared by prototype rendering and generated C records.
struct CTypeCatalog {
    aliases: [String: String]
    records: [String: CStructDef]
    names: [String: String]

    fn parse(source: String, handles: OpaqueHandleDiscovery) -> CTypeCatalog Never! {
        declarations :: pkg_opaque_split_declarations(source)
        catalog := CTypeCatalog{aliases: [String: String]{}, records: [String: CStructDef]{}, names: [String: String]{}}
        used_names := [String]{}
        loop handle in handles.handles -> &used_names.push(handle.jet_name)
        raw_records := [(record: CRawRecord, jet_name: String)]{}

        loop declaration in declarations {
            if pkg_cbind_parse_complete_record(declaration) == {
                .Val(record) -> {
                    seed :: record.alias ?? (record.struct_tag ?? "CRecord")
                    jet_name :: pkg_bind_unique_name(&used_names, foundation_generated_type_name(pkg_cbind_trim_end_matches(seed, "_t"), "CRecord"))
                    if record.struct_tag == {
                        .Val(struct_tag) -> catalog.names[struct_tag] = jet_name
                        .None -> {}
                    }
                    if record.alias == {
                        .Val(alias) -> {
                            catalog.names[alias] = jet_name
                            catalog.aliases[alias] = record.struct_tag ?? ""
                        }
                        .None -> {}
                    }
                    &raw_records.push((record: record, jet_name: jet_name))
                    next
                }
                .None -> {}
            }
            if pkg_cbind_parse_callback_alias(declaration) == {
                .Val(callback) -> {
                    catalog.aliases[callback.alias] = callback.target
                    next
                }
                .None -> {}
            }
            if pkg_cbind_parse_scalar_or_alias_typedef(declaration) == {
                .Val(typedef) -> catalog.aliases[typedef.alias] = typedef.target
                .None -> {}
            }
        }

        // The alias table is complete before fields are lowered, so scalar
        // typedefs that appear after a record still resolve.
        loop entry in raw_records {
            key :: entry.record.alias ?? (entry.record.struct_tag ?? next)
            fields :: pkg_cbind_parse_record_fields(entry.record.body, catalog) ?? next
            def :: CStructDef{jet_name: entry.jet_name, fields: fields}
            catalog.records[key] = def
            if entry.record.struct_tag == {
                .Val(struct_tag) -> catalog.records[struct_tag] = def
                .None -> {}
            }
            if entry.record.alias == {
                .Val(alias) -> catalog.records[alias] = def
                .None -> {}
            }
        }
        catalog
    }

    // The generated record name a C type spells through the alias chain.
    fn resolved_name(self, c_type: String) -> String? Never! {
        current := pkg_cbind_canonical_c_type(c_type)
        seen := [String]{}
        loop {
            if seen.contains(current) -> return None
            &seen.push(current)
            name :: self.names.get(current)
            if name != None -> return name
            following :: self.aliases.get(current) ?? return None
            current = pkg_cbind_canonical_c_type(following)
        }
    }

    // The C-layout scalar a C type spells through the alias chain.
    fn resolved_scalar(self, c_type: String) -> String? Never! {
        current := pkg_cbind_canonical_c_type(c_type)
        seen := [String]{}
        loop {
            if seen.contains(current) -> return None
            &seen.push(current)
            scalar :: pkg_cbind_layout_scalar(current)
            if scalar != None -> return scalar
            following :: self.aliases.get(current) ?? return None
            current = pkg_cbind_canonical_c_type(following)
        }
    }

    // A callback typedef as a Jet `fn(...)` type. A leading `void *` context
    // parameter makes it a managed callback whose events carry the scalars.
    fn map_callback_alias(self, c_type: String) -> String? Never! {
        target :: self.aliases.get(pkg_cbind_canonical_c_type(c_type)) ?? return None
        if !target.starts_with(CBIND_CALLBACK_MARKER) -> return None
        pieces :: target.removeprefix(CBIND_CALLBACK_MARKER).split("|").to_list()
        if pieces.len() == 0 -> return None
        ret :: pieces[0]
        raw_params := [String]{}
        loop index in 1..<pieces.len() -> &raw_params.push(pieces[index].trim())
        managed :: raw_params.len() > 0 && pkg_cbind_is_void_pointer_type(raw_params[0])
        params := [String]{}
        loop index in 0..<raw_params.len() {
            if managed && index == 0 -> next
            scalar :: pkg_cbind_callback_scalar_type(raw_params[index]) ?? return None
            &params.push(if managed -> "FfiCallbackEvent<{scalar}>" else -> scalar)
        }
        joined :: params.join(", ")
        if ret == "void" -> return Val("fn({joined})")
        result :: pkg_cbind_callback_scalar_type(ret.trim()) ?? return None
        Val("fn({joined}) {result}")
    }

    // Whether a callback typedef takes a `void *` context first.
    fn callback_has_context(self, c_type: String) -> Bool Never! {
        target :: self.aliases.get(pkg_cbind_canonical_c_type(c_type)) ?? return false
        if !target.starts_with(CBIND_CALLBACK_MARKER) -> return false
        pieces :: target.removeprefix(CBIND_CALLBACK_MARKER).split("|").to_list()
        pieces.len() > 1 && pkg_cbind_is_void_pointer_type(pieces[1])
    }

    // The element type of a single-level typed pointer, when it is a scalar,
    // an ABI scalar, or a generated record and not an owned handle.
    fn map_array_element(self, c_type: String, contract: ForeignAbiContract, handles: OpaqueHandleDiscovery) -> String? Never! {
        pointer :: pkg_cbind_pointer_base(c_type)
        if pointer.depth != 1 -> return None
        if handles.handle_for_type(c_type) != None -> return None
        scalar :: self.resolved_scalar(pointer.base)
        if scalar != None -> return scalar
        if contract.c_scalar(pointer.base) == {
            .Val(abi_scalar) -> return abi_scalar.jet_name()
            .None -> {}
        }
        self.resolved_name(pointer.base)
    }

    // The scalar an out-length pointer (`size_t *length`) writes.
    fn map_length_type(self, c_type: String) -> String? Never! {
        pointer :: pkg_cbind_pointer_base(c_type)
        if pointer.depth != 1 -> return None
        self.resolved_scalar(pointer.base)
    }

    // The by-value layout type of a record field or pointee.
    fn map_layout_type(self, c_type: String) -> String? Never! {
        pointer :: pkg_cbind_pointer_base(c_type)
        if pointer.depth != 0 -> return None
        scalar :: self.resolved_scalar(pointer.base)
        if scalar != None -> return scalar
        self.resolved_name(pointer.base)
    }

    // One `#Layout(c)` struct per distinct record, in record-key order.
    fn render_type_declarations(self) -> String Never! {
        seen := [String]{}
        out := [String]{}
        keys := self.records.keys().to_list()
        &keys.sort()
        loop key in keys {
            record :: self.records[key]
            if seen.contains(record.jet_name) -> next
            &seen.push(record.jet_name)
            &out.push("#Layout(c)\npub struct {record.jet_name} {{\n")
            loop field in record.fields -> &out.push("    {field.name}: {field.ty},\n")
            &out.push("}}\n\n")
        }
        out.join("")
    }
}

// A complete `struct { ... }` declaration, with its tag and typedef alias.
fn pkg_cbind_parse_complete_record(decl: String) -> CRawRecord? Never! {
    keyword :: "struct"
    mentions := false
    loop token in pkg_cbind_words(decl) {
        if pkg_cbind_trim_non_word(token) == keyword {
            mentions = true
            break
        }
    }
    if !mentions -> return None
    bytes :: decl.bytes()
    keyword_start :: pkg_cbind_find(bytes, keyword, 0)
    if keyword_start < 0 -> return None
    open :: pkg_cbind_find(bytes, "{{", keyword_start)
    if open < 0 -> return None
    close :: pkg_cbind_rfind_byte(bytes, 125)
    if close < 0 || close <= open -> return None
    prefix := pkg_bytes_text(bytes, keyword_start + 6, open).trim() // #4303
    suffix := pkg_bytes_text(bytes, close + 1, bytes.len()).trim() // #4303
    Val(CRawRecord{
        struct_tag: pkg_cbind_first_ident_word(prefix),
        alias: pkg_cbind_first_ident_word(suffix),
        body: pkg_bytes_text(bytes, open + 1, close)
    })
}

fn pkg_cbind_first_ident_word(text: String) -> String? Never! {
    loop token in pkg_cbind_words(text) {
        if pkg_cbind_is_ident(token) -> return Val(token)
    }
    None
}

// A simple C function-pointer typedef. The checked surface stores it as a Jet
// `fn(...)` type; registration/context ownership stays on the generated
// callback facade, never in an untyped pointer alias.
fn pkg_cbind_parse_callback_alias(decl: String) -> (alias: String, target: String)? Never! {
    text := decl.trim() // #4303
    if !text.starts_with("typedef ") || !text.contains("(*") -> return None
    bytes :: text.bytes()
    pointer :: pkg_cbind_find(bytes, "(*", 0)
    alias_start :: pointer + 2
    alias_end :: pkg_cbind_find(bytes, ")", alias_start)
    if alias_end < 0 -> return None
    alias := pkg_bytes_text(bytes, alias_start, alias_end).trim() // #4303
    if !pkg_cbind_is_ident(alias) -> return None
    params_open :: pkg_cbind_find(bytes, "(", alias_end + 1)
    if params_open < 0 -> return None
    params_close :: pkg_cbind_rfind_byte(bytes, 41)
    if params_close <= params_open || pkg_bytes_text(bytes, params_close + 1, bytes.len()).trim() != "" -> return None
    ret :: pkg_cbind_normalize_type(pkg_bytes_text(bytes, 8, pointer).trim())
    if ret == "" -> return None
    params :: pkg_cbind_split_params(pkg_bytes_text(bytes, params_open + 1, params_close)) ?? return None
    types := [String]{}
    loop param in params -> &types.push(pkg_cbind_split_param_type_and_name(param, 0).ty)
    Val((alias: alias, target: "{CBIND_CALLBACK_MARKER}{ret}|{types.join("|")}"))
}

// `typedef <target> <alias>` without a body or parameter list. The target is
// the text between the first seven bytes of the declaration and the alias.
fn pkg_cbind_parse_scalar_or_alias_typedef(decl: String) -> (alias: String, target: String)? Never! {
    tokens :: pkg_cbind_words(decl)
    if tokens.len() == 0 || tokens[0] != "typedef" || decl.contains("{{") || decl.contains("(") -> return None
    alias := ""
    position := tokens.len() - 1
    loop position >= 0 {
        if pkg_cbind_is_ident(tokens[position]) {
            alias = tokens[position]
            break
        }
        position -= 1
    }
    if alias == "" -> return None
    bytes :: decl.bytes()
    alias_pos :: pkg_cbind_rfind(bytes, alias)
    if alias_pos < 7 -> return None
    target := pkg_bytes_text(bytes, 7, alias_pos).trim() // #4303
    if target == "" || pkg_cbind_normalize_type(target) == pkg_cbind_normalize_type(alias) -> return None
    Val((alias: alias, target: target))
}

// The fields of a complete record body, or nothing when any field is outside
// the checked layout subset (bit-fields, declarator lists, unknown types).
fn pkg_cbind_parse_record_fields(body: String, catalog: CTypeCatalog) -> [(name: String, ty: String)]? Never! {
    declarations :: pkg_opaque_split_declarations(body)
    if declarations.len() == 0 -> return None
    fields := [(name: String, ty: String)]{}
    loop index in 0..<declarations.len() {
        declaration := declarations[index].trim() // #4303
        if declaration == "" || declaration.contains(":") || declaration.contains(",") -> return None
        split :: pkg_cbind_split_param_type_and_name(declaration, index)
        if !pkg_cbind_is_ident(split.name) -> return None
        ty :: catalog.map_layout_type(split.ty) ?? return None
        &fields.push((name: foundation_generated_snake_name(split.name, "field"), ty: ty))
    }
    Val(fields)
}

// Remove comments, preprocessor directives (honouring `\` continuations), and
// standard C++ linkage wrappers. Declarations and record bodies stay verbatim.
fn pkg_cbind_strip_comments_and_directives(src: String) -> String Never! {
    pkg_cbind_strip_extern_c_wrappers(pkg_opaque_strip_comments_and_directives(src))
}

// Remove `extern "C" { ... }` wrappers while keeping their declarations: only
// the wrapper's opening and matching close become spaces.
fn pkg_cbind_strip_extern_c_wrappers(src: String) -> String Never! {
    result := src.bytes()
    search := 0
    loop search < result.len() {
        start :: pkg_cbind_find(result, "extern", search)
        if start < 0 -> break
        if (start > 0 && pkg_bytes_is_word(Int.from_u8(result[start - 1]))) || (start + 6 < result.len() && pkg_bytes_is_word(Int.from_u8(result[start + 6]))) {
            search = start + 6
            next
        }
        cursor := start + 6
        loop cursor < result.len() && pkg_cbind_is_ascii_space(Int.from_u8(result[cursor])) -> cursor += 1
        if !pkg_bytes_starts_with(result, cursor, "\"C\"".bytes()) {
            search = cursor
            next
        }
        cursor += 3
        loop cursor < result.len() && pkg_cbind_is_ascii_space(Int.from_u8(result[cursor])) -> cursor += 1
        if cursor >= result.len() || Int.from_u8(result[cursor]) != 123 {
            search = cursor
            next
        }
        open :: cursor
        close :: pkg_cbind_matching_brace(result, open) ?? break
        loop index in start..<(open + 1) -> result[index] = U8{32}
        result[close] = U8{32}
        search = start
    }
    pkg_bytes_text(result, 0, result.len())
}

// The `}` closing the `{` at `open`, skipping quoted text.
fn pkg_cbind_matching_brace(bytes: [U8], open: Int) -> Int? Never! {
    depth := 0
    quote := -1
    escaped := false
    loop index in open..<bytes.len() {
        code :: Int.from_u8(bytes[index])
        if quote >= 0 {
            if {
                escaped -> escaped = false
                code == 92 -> escaped = true
                code == quote -> quote = -1
                else -> {}
            }
            next
        }
        if code == {
            34 | 39 -> quote = code
            123 -> depth += 1
            125 -> {
                if depth == 0 -> return None
                depth -= 1
                if depth == 0 -> return Val(index)
            }
            else -> {}
        }
    }
    None
}

// `<ret> name(<params>)` with nothing after the closing paren and no body.
fn pkg_cbind_parse_prototype(decl: String) -> CProto? Never! {
    if decl.contains("{{") -> return None
    bytes :: decl.bytes()
    open :: pkg_cbind_find(bytes, "(", 0)
    if open < 0 -> return None
    close :: pkg_cbind_rfind_byte(bytes, 41)
    if close < open || pkg_bytes_text(bytes, close + 1, bytes.len()).trim() != "" -> return None
    before := pkg_bytes_text(bytes, 0, open).trim() // #4303
    params_src := pkg_bytes_text(bytes, open + 1, close).trim() // #4303

    // The function name is the last identifier in `before`; everything
    // earlier is the return type. A non-ASCII separator is not in scope.
    before_bytes :: before.bytes()
    name_start := before_bytes.len()
    loop name_start > 0 && pkg_bytes_is_word(Int.from_u8(before_bytes[name_start - 1])) -> name_start -= 1
    if name_start > 0 && Int.from_u8(before_bytes[name_start - 1]) >= 128 -> return None
    name :: pkg_bytes_text(before_bytes, name_start, before_bytes.len())
    if !pkg_cbind_is_ident(name) -> return None
    // No return type at all (a bare K&R `foo(x)`) is not in scope.
    ret := pkg_bytes_text(before_bytes, 0, name_start).trim() // #4303
    if ret == "" -> return None
    params :: pkg_cbind_split_params(params_src) ?? return None
    Val(CProto{ret: ret, name: name, params: params})
}

// Top-level comma-separated parameters; `void` or nothing is none, and an
// empty or unbalanced parameter rejects the list.
fn pkg_cbind_split_params(src: String) -> [String]? Never! {
    text := src.trim() // #4303
    if text == "" || text == "void" -> return Val([String]{})
    bytes :: text.bytes()
    out := [String]{}
    start := 0
    depth := 0
    loop index in 0..<bytes.len() {
        code :: Int.from_u8(bytes[index])
        if code == {
            40 -> depth += 1
            41 -> {
                depth -= 1
                if depth < 0 -> return None
            }
            44 -> {
                if depth == 0 {
                    current :: pkg_bytes_text(bytes, start, index)
                    if current.trim() == "" -> return None
                    &out.push(current)
                    start = index + 1
                }
            }
            else -> {}
        }
    }
    last :: pkg_bytes_text(bytes, start, bytes.len())
    if depth != 0 || last.trim() == "" -> return None
    &out.push(last)
    Val(out)
}

// A parameter's type and name; an unnamed parameter is called `arg<idx>`.
fn pkg_cbind_split_param_type_and_name(input: String, idx: Int) -> (ty: String, name: String) Never! {
    raw := input.trim() // #4303
    bytes :: raw.bytes()
    position := bytes.len() - 1
    loop position >= 0 && pkg_bytes_is_word(Int.from_u8(bytes[position])) -> position -= 1
    if position >= 0 {
        tail :: pkg_bytes_text(bytes, position + 1, bytes.len())
        separator :: Int.from_u8(bytes[position])
        // `int *p` / `int x`: a name follows a `*` or whitespace; `char*`
        // leaves an empty tail and a lone type keyword is not a name.
        if pkg_cbind_is_ident(tail) && (separator == 42 || pkg_cbind_is_ascii_space(separator)) {
            ty := pkg_bytes_text(bytes, 0, position + 1).trim() // #4303
            if ty != "" -> return (ty: ty, name: tail)
        }
    }
    (ty: raw, name: "arg{idx}")
}

// Collapse whitespace and drop the qualifiers the binder ignores.
fn pkg_cbind_normalize_type(c_type: String) -> String Never! {
    kept := [String]{}
    loop token in pkg_cbind_words(c_type) {
        if token == {
            "const" | "volatile" | "register" | "restrict" | "extern" -> {}
            else -> &kept.push(token)
        }
    }
    kept.join(" ")
}

// A type's base spelling (without `*` or a struct/union/enum keyword) and
// how many `*` it carries.
fn pkg_cbind_pointer_base(c_type: String) -> (base: String, depth: Int) Never! {
    norm :: pkg_cbind_normalize_type(c_type)
    depth := 0
    loop byte in norm.bytes() {
        if Int.from_u8(byte) == 42 -> depth += 1
    }
    (base: pkg_cbind_canonical_c_type(norm.replace("*", " ")), depth: depth)
}

fn pkg_cbind_canonical_c_type(c_type: String) -> String Never! {
    norm :: pkg_cbind_normalize_type(c_type)
    if {
        norm.starts_with("struct ") -> norm.removeprefix("struct ")
        norm.starts_with("union ") -> norm.removeprefix("union ")
        norm.starts_with("enum ") -> norm.removeprefix("enum ")
        else -> norm
    }
}

fn pkg_cbind_is_void_pointer_type(c_type: String) -> Bool Never! {
    pointer :: pkg_cbind_pointer_base(c_type)
    pointer.depth == 1 && pointer.base == "void"
}

// Whether `const` qualifies the pointee (appears before a standalone `*`).
fn pkg_cbind_pointer_is_const(c_type: String) -> Bool Never! {
    loop token in pkg_cbind_words(c_type) {
        if token == "*" -> return false
        if token == "const" -> return true
    }
    false
}

// The fixed-width Jet scalar a C layout type spells.
fn pkg_cbind_layout_scalar(c_type: String) -> String? Never! {
    if c_type == {
        "char" | "signed char" | "int8_t" -> Val("I8")
        "unsigned char" | "uint8_t" -> Val("U8")
        "short" | "signed short" | "short int" | "signed short int" | "int16_t" -> Val("I16")
        "unsigned short" | "unsigned short int" | "uint16_t" -> Val("U16")
        "int" | "signed" | "signed int" | "int32_t" -> Val("I32")
        "unsigned" | "unsigned int" | "uint32_t" -> Val("U32")
        "long long" | "signed long long" | "int64_t" -> Val("I64")
        "unsigned long long" | "uint64_t" -> Val("U64")
        "float" -> Val("F32")
        "double" -> Val("Float")
        "_Bool" | "bool" -> Val("Bool")
        "size_t" | "uintptr_t" -> Val("U64")
        "ssize_t" | "intptr_t" -> Val("I64")
        else -> None
    }
}

// The Jet scalar a callback parameter or result spells.
fn pkg_cbind_callback_scalar_type(c_type: String) -> String? Never! {
    if pkg_cbind_normalize_type(c_type) == {
        "void" -> Val("Unit")
        "char" | "signed char" | "int8_t" -> Val("I8")
        "unsigned char" | "uint8_t" -> Val("U8")
        "short" | "signed short" | "short int" | "int16_t" -> Val("I16")
        "unsigned short" | "unsigned short int" | "uint16_t" -> Val("U16")
        "int" | "signed" | "signed int" | "int32_t" -> Val("I32")
        "unsigned" | "unsigned int" | "uint32_t" -> Val("U32")
        "long long" | "signed long long" | "int64_t" -> Val("I64")
        "unsigned long long" | "uint64_t" -> Val("U64")
        "float" -> Val("F32")
        "double" -> Val("Float")
        "_Bool" | "bool" -> Val("Bool")
        else -> None
    }
}

CBIND_LENGTH_SUFFIXES :: prep { [String]{"_len", "_length", "_count", "_size", "_num", "_number"} }
CBIND_LENGTH_PREFIXES :: prep { [String]{"len_", "length_", "count_", "size_", "num_", "number_"} }

// Parameter names that may carry an element count.
fn pkg_cbind_is_length_name(name: String) -> Bool Never! {
    lower :: pkg_ascii_lower(name)
    if lower == {
        "n" | "len" | "length" | "count" | "size" | "num" | "number" -> return true
        else -> {}
    }
    loop suffix in CBIND_LENGTH_SUFFIXES {
        if lower.ends_with(suffix) -> return true
    }
    loop prefix in CBIND_LENGTH_PREFIXES {
        if lower.starts_with(prefix) -> return true
    }
    false
}

// A trimmed ASCII C identifier.
fn pkg_cbind_is_ident(value: String) -> Bool Never! {
    bytes :: value.trim().bytes()
    if bytes.len() == 0 -> return false
    first :: Int.from_u8(bytes[0])
    if first >= 48 && first <= 57 -> return false
    loop byte in bytes {
        if !pkg_bytes_is_word(Int.from_u8(byte)) -> return false
    }
    true
}

// Rust `char::is_ascii_whitespace`: space, tab, LF, form feed, CR.
fn pkg_cbind_is_ascii_space(code: Int) -> Bool Never! {
    code == 32 || code == 9 || code == 10 || code == 12 || code == 13
}

// `str::split_whitespace`: runs of non-White_Space text.
fn pkg_cbind_words(text: String) -> [String] Never! {
    bytes :: text.bytes()
    words := [String]{}
    start := -1
    index := 0
    loop index < bytes.len() {
        width :: pkg_bytes_space_width(bytes, index)
        if width > 0 {
            if start >= 0 {
                &words.push(pkg_bytes_text(bytes, start, index))
                start = -1
            }
            index += width
            next
        }
        if start < 0 -> start = index
        index += 1
    }
    if start >= 0 -> &words.push(pkg_bytes_text(bytes, start, bytes.len()))
    words
}

// Trim every leading and trailing byte outside ASCII letters, digits and `_`.
fn pkg_cbind_trim_non_word(token: String) -> String Never! {
    bytes :: token.bytes()
    start := 0
    end := bytes.len()
    loop start < end && !pkg_bytes_is_word(Int.from_u8(bytes[start])) -> start += 1
    loop end > start && !pkg_bytes_is_word(Int.from_u8(bytes[end - 1])) -> end -= 1
    pkg_bytes_text(bytes, start, end)
}

// `str::trim_end_matches(suffix)`: drop every trailing repeat of `suffix`.
fn pkg_cbind_trim_end_matches(value: String, suffix: String) -> String Never! {
    out := value
    loop suffix != "" && out.ends_with(suffix) -> out = out.removesuffix(suffix)
    out
}

// The first byte offset of `needle` at or after `from`, or -1.
fn pkg_cbind_find(bytes: [U8], needle: String, from: Int) -> Int Never! {
    raw :: needle.bytes()
    index := if from < 0 -> 0 else -> from
    loop index + raw.len() <= bytes.len() {
        if pkg_bytes_starts_with(bytes, index, raw) -> return index
        index += 1
    }
    -1
}

// The last byte offset of `needle`, or -1.
fn pkg_cbind_rfind(bytes: [U8], needle: String) -> Int Never! {
    raw :: needle.bytes()
    index := bytes.len() - raw.len()
    loop index >= 0 {
        if pkg_bytes_starts_with(bytes, index, raw) -> return index
        index -= 1
    }
    -1
}

fn pkg_cbind_rfind_byte(bytes: [U8], code: Int) -> Int Never! {
    index := bytes.len() - 1
    loop index >= 0 {
        if Int.from_u8(bytes[index]) == code -> return index
        index -= 1
    }
    -1
}

// `preferred` (or `value` when empty), else `preferred_2`, `preferred_3`, ...
// The chosen name is recorded in `used`.
fn pkg_bind_unique_name(used: &[String], preferred: String) -> String Never! {
    base :: if preferred == "" -> "value" else -> preferred
    if !used.contains(base) {
        &used.push(base)
        return base
    }
    suffix := 2
    loop {
        candidate :: "{base}_{suffix}"
        if !used.contains(candidate) {
            &used.push(candidate)
            return candidate
        }
        suffix += 1
    }
}
