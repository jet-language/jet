use jet_foundation.[ForeignAbiContract, foundation_generated_snake_name, foundation_json_quote]

// Prototype rendering for the C `#Bindgen` generator, ported from
// jet_pkg_model::CBind. Each bindable prototype becomes one
// `fn name(p: T, ...) -> R = "c_symbol"` line; a prototype outside the
// checked subset is skipped with its reason, never faked.
//
// The subset: scalar values, NUL-terminated strings, uncounted object
// pointers, typed pointer/count slices, complete C-layout records, callback
// typedefs, and the owned opaque handles found by `OpaqueHandleDiscovery`.

// Why one prototype was skipped.
#Error
struct CBindingSkip {
    reason: String
}

// Render one prototype as a `#Bindgen` line, or the reason it is skipped.
fn pkg_cbind_render_binding(p: CProto, used_names: &[String], contract: ForeignAbiContract, handles: OpaqueHandleDiscovery, catalog: CTypeCatalog) -> String CBindingSkip! {
    managed_callback :: pkg_cbind_managed_callback_param_index(p, catalog)
    managed_unsubscribe :: p.name == "unsubscribe" && pkg_cbind_native_void_pointer_proto(p)
    managed_emit :: p.name == "emit_async"
    array_element :: catalog.map_array_element(p.ret, contract, handles)
    length_found :: pkg_cbind_array_length_param(p, catalog)
    length_param :: if array_element != None -> length_found ?? -1 else -> -1
    ret_jet :: if {
        managed_callback != None -> Val("*U8")
        length_param >= 0 -> Val("[{array_element ?? ""}]")
        else -> pkg_cbind_map_return_type(p.ret, contract, handles, catalog)
    }
    seed :: if {
        managed_callback != None -> "__jet_native_{p.name}"
        managed_unsubscribe -> "__jet_native_unsubscribe"
        managed_emit -> "__jet_native_emit_async"
        else -> p.name
    }
    function_name :: pkg_bind_unique_name(&used_names, foundation_generated_snake_name(seed, "function"))
    context_index :: if managed_callback == {
        .Val(callback_index) -> callback_index + 1
        .None -> -1
    }
    params := [String]{}
    used_param_names := [String]{}
    loop idx in 0..<p.params.len() {
        if idx == context_index -> next
        raw := p.params[idx].trim() // #4303
        if raw == "..." -> return Err(CBindingSkip{reason: "variadic (`...`) parameters aren't bindable"})
        split :: pkg_cbind_split_param_type_and_name(raw, idx)
        ty :: split.ty
        jet_ty :: pkg_cbind_render_param_type(p, idx, ty, length_param, contract, handles, catalog)
        name :: pkg_bind_unique_name(&used_param_names, foundation_generated_snake_name(split.name, "arg"))
        &params.push("{name}: {jet_ty}")
    }
    params_str :: params.join(", ")
    close_marker :: if handles.handle_for_type(p.ret) == {
        .Val(handle) -> "#Close({handle.close})\n"
        .None -> ""
    }
    symbol :: pkg_cbind_quote(p.name)
    if ret_jet == {
        .Val(result) -> Ok("{close_marker}fn {function_name}({params_str}) -> {result} = {symbol}")
        .None -> Ok("{close_marker}fn {function_name}({params_str}) = {symbol}")
    }
}

// The Jet type of one parameter: an out-length, a counted slice, an owned
// handle (consumed by its close function), or a mapped value or pointer.
fn pkg_cbind_render_param_type(p: CProto, idx: Int, ty: String, length_param: Int, contract: ForeignAbiContract, handles: OpaqueHandleDiscovery, catalog: CTypeCatalog) -> String CBindingSkip! {
    if idx == length_param {
        length :: catalog.map_length_type(ty) ?? return Err(CBindingSkip{reason: "array length type `{ty.trim()}` isn't bindable"})
        return Ok("&{length}")
    }
    if pkg_cbind_has_companion_count(p, idx, catalog) {
        if catalog.map_array_element(ty, contract, handles) == {
            .Val(element) -> {
                access :: if pkg_cbind_pointer_is_const(ty) -> "" else -> "&"
                return Ok("{access}[{element}]")
            }
            .None -> {}
        }
    }
    if handles.handle_for_type(ty) == {
        .Val(handle) -> {
            access :: if handles.is_close_function(p.name, ty) -> "^" else -> "&"
            return Ok("{access}{handle.jet_name}")
        }
        .None -> {}
    }
    mapped :: pkg_cbind_map_type(ty, contract, handles, catalog)
    if mapped != None -> return Ok(mapped)
    single :: pkg_cbind_map_single_pointer(ty, p, idx, contract, handles, catalog)
    if single != None -> return Ok(single)
    reason :: handles.unresolved_reason_for_type(ty) ?? "type `{ty.trim()}` isn't bindable"
    Err(CBindingSkip{reason: reason})
}

// One uncounted C object pointer with its access convention: `const T *` is
// a Jet read parameter (`T`), a mutable `T *` a write parameter (`&T`).
// Counted pointers were already lowered to typed list parameters.
fn pkg_cbind_map_single_pointer(c_type: String, p: CProto, pointer_index: Int, contract: ForeignAbiContract, handles: OpaqueHandleDiscovery, catalog: CTypeCatalog) -> String? Never! {
    pointer :: pkg_cbind_pointer_base(c_type)
    if pointer.depth != 1 || pkg_cbind_has_companion_count(p, pointer_index, catalog) -> return None
    layout :: catalog.map_layout_type(pointer.base)
    mapped :: if layout != None -> layout else -> pkg_cbind_map_type(pointer.base, contract, handles, catalog) ?? return None
    if mapped == "String" -> return None
    if pkg_cbind_pointer_is_const(c_type) -> return Val(mapped)
    Val("&{mapped}")
}

// A C return type as a Jet type, `None` for `void`, or the skip reason.
fn pkg_cbind_map_return_type(c_type: String, contract: ForeignAbiContract, handles: OpaqueHandleDiscovery, catalog: CTypeCatalog) -> String? CBindingSkip! {
    if pkg_cbind_normalize_type(c_type) == "void" -> return Ok(None)
    if pkg_cbind_map_type(c_type, contract, handles, catalog) == {
        .Val(mapped) -> Ok(Val(mapped))
        .None -> {
            reason :: handles.unresolved_reason_for_type(c_type) ?? "return type `{c_type.trim()}` isn't bindable"
            Err(CBindingSkip{reason: reason})
        }
    }
}

// The first mutable out-length parameter (`size_t *length`) of a prototype.
fn pkg_cbind_array_length_param(p: CProto, catalog: CTypeCatalog) -> Int? Never! {
    loop index in 0..<p.params.len() {
        split :: pkg_cbind_split_param_type_and_name(p.params[index], index)
        if !pkg_cbind_pointer_is_const(split.ty) && pkg_cbind_is_length_name(split.name) && catalog.map_length_type(split.ty) != None -> return Val(index)
    }
    None
}

// Whether another parameter is a by-value scalar count for this pointer.
fn pkg_cbind_has_companion_count(p: CProto, pointer_index: Int, catalog: CTypeCatalog) -> Bool Never! {
    loop index in 0..<p.params.len() {
        if index == pointer_index -> next
        split :: pkg_cbind_split_param_type_and_name(p.params[index], index)
        if pkg_cbind_pointer_base(split.ty).depth == 0 && pkg_cbind_is_length_name(split.name) && catalog.resolved_scalar(split.ty) != None -> return true
    }
    false
}

// The callback parameter followed by its `void *` context, if any.
fn pkg_cbind_managed_callback_param_index(p: CProto, catalog: CTypeCatalog) -> Int? Never! {
    loop idx in 0..<p.params.len() {
        split :: pkg_cbind_split_param_type_and_name(p.params[idx], idx)
        if !catalog.callback_has_context(split.ty) -> next
        if idx + 1 >= p.params.len() -> next
        context :: pkg_cbind_split_param_type_and_name(p.params[idx + 1], idx + 1)
        if pkg_cbind_is_void_pointer_type(context.ty) -> return Val(idx)
    }
    None
}

// A prototype taking exactly one `void *`.
fn pkg_cbind_native_void_pointer_proto(p: CProto) -> Bool Never! {
    if p.params.len() != 1 -> return false
    pkg_cbind_is_void_pointer_type(pkg_cbind_split_param_type_and_name(p.params[0], 0).ty)
}

// A C type as a Jet FFI type, or nothing outside the bound subset.
fn pkg_cbind_map_type(c_type: String, contract: ForeignAbiContract, handles: OpaqueHandleDiscovery, catalog: CTypeCatalog) -> String? Never! {
    callback :: catalog.map_callback_alias(c_type)
    if callback != None -> return callback
    if handles.handle_for_type(c_type) == {
        .Val(handle) -> return Val(handle.jet_name)
        .None -> {}
    }
    pointer :: pkg_cbind_pointer_base(c_type)
    // NUL-terminated C strings are the one pointer-shaped scalar accepted by
    // the generated bridge; counted `char *` buffers were lowered to `[I8]`.
    if pointer.depth == 1 && pointer.base == "char" -> return Val("String")
    t := pkg_cbind_canonical_c_type(c_type).trim() // #4303
    // Untyped `void *` is not a Jet value; a raw allocator stays skipped.
    if t == "void" || (pointer.depth == 1 && pointer.base == "void") -> return None
    if contract.c_scalar(t) == {
        .Val(scalar) -> {
            name :: scalar.jet_name()
            if name != None -> return name
        }
        .None -> {}
    }
    scalar :: catalog.resolved_scalar(t)
    if scalar != None -> return scalar
    catalog.resolved_name(t)
}

// A C symbol as a quoted Jet string literal.
fn pkg_cbind_quote(value: String) -> String Never! {
    foundation_json_quote(value)
}
