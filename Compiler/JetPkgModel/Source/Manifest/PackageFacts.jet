use jet_foundation.[EvidenceRecord, EvidenceKind, EvidenceOutcome, EvidenceFacet, PolicyDeclaration, MIRAllocatorPolicy, MIRRuntimeLayer, OUTPUT_FIELD_BINDINGS, OUTPUT_FIELD_LOADABLE, OUTPUT_FIELD_NATIVE]

// Closed Package and Config facts for the unified ecosystem surface
// (Package/mod.rs). `PackageFacts` is the checked meaning of one source tree;
// `ConfigFacts` is a typed contribution to it. Both are plain data: parsing is
// structural (PackageParse.jet), composition deterministic (Compose.jet), and
// filesystem resolution goes through the authority resolver (PackageLoad.jet).

pub enum PackageOutputKind {
    Library
    Executable
    Service
    Check
    Environment
    Image
    Bundle
    System
    Fleet

    pub fn is_runnable(self) -> Bool Never! {
        if self == {
            .Executable | .Service -> true
            else -> false
        }
    }

    pub fn parse(value: String) -> PackageOutputKind PackageParseError! {
        name :: pkg_trim_start_matches(value.trim(), ".")
        if name == {
            "Library" -> Ok(PackageOutputKind.Library)
            "Executable" -> Ok(PackageOutputKind.Executable)
            "Service" -> Ok(PackageOutputKind.Service)
            "Check" -> Ok(PackageOutputKind.Check)
            "Environment" -> Ok(PackageOutputKind.Environment)
            "Image" -> Ok(PackageOutputKind.Image)
            "Bundle" -> Ok(PackageOutputKind.Bundle)
            "System" -> Ok(PackageOutputKind.System)
            "Fleet" -> Ok(PackageOutputKind.Fleet)
            else -> Err(PackageParseError.UnknownOutputKind(name))
        }
    }

    // The Rust `Debug` spelling (the variant name).
    pub fn debug_name(self) -> String Never! {
        if self == {
            .Library -> "Library"
            .Executable -> "Executable"
            .Service -> "Service"
            .Check -> "Check"
            .Environment -> "Environment"
            .Image -> "Image"
            .Bundle -> "Bundle"
            .System -> "System"
            .Fleet -> "Fleet"
        }
    }
}

// The checked structured payload of an output; arrays, objects, booleans,
// and numbers keep their shape.
pub enum OutputPayload {
    Null
    Bool(Bool)
    Number(String)
    String(String)
    Array([OutputPayload])
    Object([String: OutputPayload])
}

pub struct OutputFact {
    pub kind: PackageOutputKind
    pub name: String
    pub entry: String?
    pub fields: [String: String]
    pub payload: OutputPayload

    // D-LIB-NAME1=A: `Library{ loadable: true }` requests a `.jetlib`.
    pub fn is_loadable(self) -> Bool Never! {
        self.kind == PackageOutputKind.Library && self.payload_bool(OUTPUT_FIELD_LOADABLE)
    }

    // D-LIB-EXPORT1=C: a native Library output.
    pub fn is_native(self) -> Bool Never! {
        self.kind == PackageOutputKind.Library && self.payload_bool(OUTPUT_FIELD_NATIVE)
    }

    // D-LIB-EXPORT1=C: the checked binding language names of this output.
    pub fn binding_languages(self) -> [String] Never! {
        out := [String]{}
        fields :: if self.payload == {
            .Object(fields) -> fields
            else -> {
                return out
            }
        }
        bindings :: fields.get(OUTPUT_FIELD_BINDINGS) ?? return out
        values :: if bindings == {
            .Array(values) -> values
            else -> {
                return out
            }
        }
        loop value in values {
            if value == .String(name) -> &out.push(name)
        }
        out
    }

    pub fn payload_bool(self, field: String) -> Bool Never! {
        fields :: if self.payload == {
            .Object(fields) -> fields
            else -> {
                return false
            }
        }
        value :: fields.get(field) ?? return false
        if value == {
            .Bool(flag) -> flag
            else -> false
        }
    }
}


pub struct ServiceFact {
    pub enable: Bool
    pub ports: [Int]
    pub ready: String?
    pub fields: [String: String]

    pub fn default() -> ServiceFact Never! {
        ServiceFact{enable: false, ports: [Int]{}, ready: None, fields: [String: String]{}}
    }
}

pub struct EnvironmentFact {
    pub name: String
    pub tools: [String]
    pub services: [String: ServiceFact]
    pub secrets: [String: String]
    pub fields: [String: String]
}

pub enum MemberRef {
    Path(String)
    Find(String)

    pub fn path(self) -> String Never! {
        if self == {
            .Path(path) | .Find(path) -> path
        }
    }
}

// D-GRADE1=D / D-GRADE-POLICY1=A: the one claims ladder.
pub enum ClaimsGrade {
    Unchecked
    Checked
    Examples(Int)
    Generated(Int)
    Proved

    pub fn as_str(self) -> String Never! {
        if self == {
            .Unchecked -> "unchecked"
            .Checked -> "checked"
            .Examples(_) -> "examples"
            .Generated(_) -> "generated"
            .Proved -> "proved"
        }
    }

    pub fn render(self) -> String Never! {
        if self == {
            .Examples(count) -> "examples({count})"
            .Generated(count) -> "generated({count})"
            else -> self.as_str()
        }
    }

    pub fn rank(self) -> Int Never! {
        if self == {
            .Unchecked -> 0
            .Checked -> 1
            .Examples(_) -> 2
            .Generated(_) -> 3
            .Proved -> 4
        }
    }

    pub fn parse(value: String) -> ClaimsGrade? Never! {
        lowercase :: pkg_ascii_lower(pkg_trim_start_matches(value.trim(), "."))
        if pkg_strip_wrapped(lowercase, "generated(", ")") == .Val(count) {
            parsed :: pkg_parse_u64(count) ?? return None
            return Val(ClaimsGrade.Generated(parsed))
        }
        if pkg_strip_wrapped(lowercase, "examples(", ")") == .Val(count) {
            parsed :: pkg_parse_u64(count) ?? return None
            return Val(ClaimsGrade.Examples(parsed))
        }
        if lowercase == {
            "unchecked" -> Val(ClaimsGrade.Unchecked)
            "checked" -> Val(ClaimsGrade.Checked)
            "examples" | "example" -> Val(ClaimsGrade.Examples(0))
            "generated" -> Val(ClaimsGrade.Generated(0))
            "proved" | "proven" -> Val(ClaimsGrade.Proved)
            else -> None
        }
    }

    pub fn meets(self, floor: ClaimsGrade) -> Bool Never! {
        if self == .Examples(actual) && floor == .Examples(required) -> return actual >= required
        if self == .Generated(actual) && floor == .Generated(required) -> return actual >= required
        self.rank() >= floor.rank()
    }

    // The Rust `Debug` spelling.
    pub fn debug(self) -> String Never! {
        if self == {
            .Unchecked -> "Unchecked"
            .Checked -> "Checked"
            .Examples(count) -> "Examples({count})"
            .Generated(count) -> "Generated({count})"
            .Proved -> "Proved"
        }
    }
}

// A typed projection of the evidence ledger for claims inspection. Failed
// records never raise the grade or satisfy a floor.
pub struct ClaimsProjection {
    pub grade: ClaimsGrade
    pub generated_attempts: Int
    pub generated_successes: Int
    pub examples_successes: Int
    pub failed: Bool

    pub fn from_records(records: [EvidenceRecord]) -> ClaimsProjection Never! {
        generated_attempts := 0
        generated_successes := 0
        examples_successes := 0
        failed := false
        solver_proved := false
        checked := false
        loop record in records {
            expected_failure :: record.is_expected_failure()
            if (record.outcome.is_failure() && !expected_failure) || record.is_unexpected_pass() -> failed = true
            if record.kind == EvidenceKind.Property && record.count > 0 {
                if record.outcome == {
                    .Generated | .Passed | .Failed -> generated_attempts += record.count
                    else -> {}
                }
                if record.outcome == {
                    .Generated | .Passed -> {
                        if !record.is_unexpected_pass() -> generated_successes += record.count
                    }
                    else -> {}
                }
            }
            if record.kind == {
                .Unit | .Runtime | .Doctest -> {
                    if record.outcome == EvidenceOutcome.Passed && !record.is_unexpected_pass() -> examples_successes += 1
                }
                else -> {}
            }
            if record.facet == EvidenceFacet.Solver && record.outcome == EvidenceOutcome.Proved -> solver_proved = true
            if record.outcome == EvidenceOutcome.Checked -> checked = true
        }
        grade :: if {
            solver_proved -> ClaimsGrade.Proved
            generated_successes > 0 -> ClaimsGrade.Generated(generated_successes)
            examples_successes > 0 -> ClaimsGrade.Examples(examples_successes)
            checked -> ClaimsGrade.Checked
            else -> ClaimsGrade.Unchecked
        }
        ClaimsProjection{grade: grade, generated_attempts: generated_attempts, generated_successes: generated_successes, examples_successes: examples_successes, failed: failed}
    }

    pub fn floor_met(self, floor: ClaimsGrade?) -> Bool Never! {
        if self.failed -> return false
        if floor == .Val(required) -> return self.grade.meets(required)
        true
    }
}

// One source-owned package policy exception scoped to an exact
// `package#version` identity.
pub struct PackagePolicyException {
    pub id: String
    pub scope: String
    pub reason: String
    pub expires_at: Int

    pub fn summary(self) -> String Never! {
        "id={self.id};scope={self.scope};reason={self.reason};expires={self.expires_at}"
    }

    pub fn matches(self, package: String, version: String) -> Bool Never! {
        self.scope == "{package}#{version}"
    }
}

// D-POLICY-WORD1=A / D-TEAMPOLICY1=A: the package's non-memory governance
// namespace. Memory denials live in `authority.holds.deny`.
pub struct PackagePolicy {
    pub declarations: [PolicyDeclaration]
    // `None` means no `lints:` block at all.
    pub lints_deny: [String]?
    // Closed effect ceilings keyed by project-relative module path; each set
    // is sorted, and an empty set is an explicit pure ceiling.
    pub effects: [String: [String]]
    // `None`: no unsafe rule; empty: `.Deny`; otherwise `.Paths([...])`.
    pub unsafe_paths: [String]?
    // `None`: no rule; false: `.Deny`; true: `.Allow`.
    pub expert: Bool?
    // `None`: no dependency wall; otherwise the `.List([...])` allow-list.
    pub deps: [String]?
    pub claims_min: ClaimsGrade?
    // D-MEM-GUARANTEE1=A: contained dependencies, sorted.
    pub contain: [String]
    pub harden: Bool
    pub licenses: [String]?
    pub source_maps: [PolicySourceMap]
    pub exceptions: [PackagePolicyException]

    pub fn default() -> PackagePolicy Never! {
        PackagePolicy{
            declarations: [PolicyDeclaration]{},
            lints_deny: None,
            effects: [String: [String]]{},
            unsafe_paths: None,
            expert: None,
            deps: None,
            claims_min: None,
            contain: [String]{},
            harden: false,
            licenses: None,
            source_maps: [PolicySourceMap]{},
            exceptions: [PackagePolicyException]{},
        }
    }

    // A later policy may add contained dependencies, turn hardening on, or
    // raise the claims floor, never widen them.
    pub fn guarantees_tighten(self, following: PackagePolicy) PolicyTightenError! {
        loop dependency in self.contain {
            if !following.contain.contains(dependency) -> return Err(PolicyTightenError{message: "`policy.contain` cannot remove a contained dependency"})
        }
        if self.harden && !following.harden -> return Err(PolicyTightenError{message: "`policy.harden` cannot be turned off"})
        if self.claims_min == .Val(current) {
            if following.claims_min == {
                .Val(candidate) -> {
                    if !candidate.meets(current) -> return Err(PolicyTightenError{message: "`policy.claims.min` cannot weaken from `{current.render()}` to `{candidate.render()}`"})
                }
                .None -> return Err(PolicyTightenError{message: "`policy.claims.min` cannot remove the `{current.render()}` floor"})
            }
        }
    }

    // The effective fenced set for the package dependency graph.
    pub fn contained_dependencies(self, dependencies: [String]) -> [String] Never! {
        if !self.harden -> return self.contain
        out := [String]{}
        loop dependency in dependencies {
            if !out.contains(dependency) -> &out.push(dependency)
        }
        pkg_manifest_sorted(out)
    }
}

// Why a package guarantee policy would widen.
#Error
pub struct PolicyTightenError {
    pub message: String
}

// D-AUTHORITY-MANIFEST1=A / D-BOUND-PROV1=A: package-scope authority facts.
pub struct PackageAuthority {
    pub holds: AuthorityHolds
    // D-PLUGIN-AUTHORITY1: guest-declared requirements, never a host grant.
    pub needs: [String]
    pub grants: [PackageGrant]
    pub trust: TrustPolicy?
    pub providers: [ProviderAuthority]

    pub fn default() -> PackageAuthority Never! {
        PackageAuthority{holds: AuthorityHolds.default(), needs: [String]{}, grants: [PackageGrant]{}, trust: None, providers: [ProviderAuthority]{}}
    }
}

// D-CONF-MODULE1=A: one `settings:` entry — a Tier-0 type and its default.
pub struct SettingDecl {
    pub ty: String
    pub default: String
}

pub struct ConfigFacts {
    pub name: String?
    pub version: String?
    pub source: String?
    pub deps: [String: DepSource]
    pub services: [String: ServiceFact]
    pub outputs: [String: OutputFact]
    pub environments: [String: EnvironmentFact]
    pub defaults: [String: String]
    pub origin: String
}

pub struct PackageFacts {
    pub name: String
    pub version: String?
    // The optional Jet self-toolchain pin (D-JPK-TOOLCHAIN1).
    pub jet: String?
    pub source: String?
    pub edition: String?
    pub description: String?
    pub license: String?
    pub repository: String?
    // D-ALLOC-PROGRAM1=A: the hosted whole-program allocator.
    pub allocator: MIRAllocatorPolicy
    pub targets: PackageTargets
    // D-RINGLAYER1=A: optional runtime ceiling.
    pub layer: MIRRuntimeLayer?
    pub deps: [String: DepSource]
    // D-LIVE1: package-level development mode.
    pub dev: DevPolicy
    pub boundaries: [ImportBoundary]
    pub packages: [PackageEntry]
    pub services: [String: ServiceFact]
    pub outputs: [String: OutputFact]
    pub environments: [String: EnvironmentFact]
    pub defaults: [String: String]
    pub build_profiles: [BuildProfileDef]
    // D-CTEFFECT1: standing capabilities granted to this package's `fn build`.
    pub build_allow: [String]
    // D-EFFBUDGET1: whether `authority.holds` is present at all.
    pub effects_enabled: Bool
    pub effects_allow: [String]?
    pub effects_deny: [String]?
    pub grants: [PackageGrant]
    pub authority: PackageAuthority
    pub policy: PackagePolicy
    pub settings: [String: SettingDecl]
    pub configs: [String]
    // Resolved file-backed Config paths, relative to the Package root.
    pub resolved_config_paths: [String]
    // Inline `name :: Config{ ... }` contributions by declared name.
    pub inline_configs: [String: ConfigFacts]
    pub members: [MemberRef]
    // Every successful contributor to a field, in composition order.
    pub provenance: [String: [String]]
    pub origin: String

    pub fn default() -> PackageFacts Never! {
        PackageFacts{
            name: "",
            version: None,
            jet: None,
            source: None,
            edition: None,
            description: None,
            license: None,
            repository: None,
            allocator: MIRAllocatorPolicy.HostedDefault,
            targets: PackageTargets.empty(),
            layer: None,
            deps: [String: DepSource]{},
            dev: DevPolicy.default(),
            boundaries: [ImportBoundary]{},
            packages: [PackageEntry]{},
            services: [String: ServiceFact]{},
            outputs: [String: OutputFact]{},
            environments: [String: EnvironmentFact]{},
            defaults: [String: String]{},
            build_profiles: [BuildProfileDef]{},
            build_allow: [String]{},
            effects_enabled: false,
            effects_allow: None,
            effects_deny: None,
            grants: [PackageGrant]{},
            authority: PackageAuthority.default(),
            policy: PackagePolicy.default(),
            settings: [String: SettingDecl]{},
            configs: [String]{},
            resolved_config_paths: [String]{},
            inline_configs: [String: ConfigFacts]{},
            members: [MemberRef]{},
            provenance: [String: [String]]{},
            origin: "",
        }
    }

    // The exact profile identity selected for `target_name`.
    pub fn target_profile(self, target_name: String) -> TargetProfileIdentity? Never! {
        self.targets.profile(target_name)
    }

    // The declared kind of package `name` from its `packages:` targets: an
    // executable target wins, else a library target.
    pub fn package_kind(self, name: String) -> PackageKind? Never! {
        loop entry in self.packages {
            if entry.name != name -> next
            if entry.targets.contains(PackageTarget.Executable) -> return Val(PackageKind.Executable)
            if entry.targets.contains(PackageTarget.Library) -> return Val(PackageKind.Library)
            return None
        }
        None
    }

    // The ordered sources that contributed to one typed field.
    pub fn field_provenance(self, field: String) -> [String] Never! {
        self.provenance.get(field) ?? [String]{}
    }

    // Contained names must belong to this package's declared dependencies.
    pub fn validate_guarantees(self) PackageParseError! {
        loop name in self.policy.contain {
            if !self.deps.has_key(name) -> return Err(PackageParseError.BadGuaranteePolicy{detail: "`policy.contain` names `{name}`, but `deps:` does not declare that dependency"})
        }
    }

    // Stable, checkout-portable digest of the composed typed facts used by
    // workspace locks; origins and provenance never enter it.
    pub fn semantic_digest(self) -> String Never! {
        pkg_sha256_hex(pkg_facts_semantic_text(self).bytes())
    }
}
