browser_test_panel: fn(status: String) -> BrowserPanelFact {
    nodes: [BrowserNode]{BrowserNode.new("go", DevtoolsNodeKind.Action, "Go"), BrowserNode.new("source", DevtoolsNodeKind.Text, "Source")}
    BrowserPanelFact.new("build", "Build", 12, status, nodes)
}
browser_test_event: fn(session: String, revision: Int, sequence: Int, status: String) -> BrowserHostEvent {
    BrowserHostEvent.new(session, revision, sequence, 100 + sequence, [BrowserPanelFact]{browser_test_panel(status)})
}

#Test("event_validation_and_monotonic_projection") {
    host := BrowserHost.new("s1")
    host.apply_event(browser_test_event("s1", 1, 1, "ready")) ?? panic("first event")
    assert_eq(host.revision, Val(1))
    assert_eq(host.sequence, Val(1))
    assert_eq(host.state, BrowserSessionState.Idle)
    assert_eq(host.panels.len(), 1)
    stale_revision: if host.apply_event(browser_test_event("s1", 0, 2, "ready")) == {
        .Err(.StaleRevision(_, _)) -> true
        else -> false
    }
    assert(stale_revision)
    stale_sequence: if host.apply_event(browser_test_event("s1", 1, 1, "ready")) == {
        .Err(.StaleSequence(_, _)) -> true
        else -> false
    }
    assert(stale_sequence)
    wrong_session: if host.apply_event(browser_test_event("s2", 2, 2, "ready")) == {
        .Err(.WrongSession(_, _)) -> true
        else -> false
    }
    assert(wrong_session)
}
#Test("layout_and_selection_are_shared_but_open_state_is_placement_local") {
    host := BrowserHost.new("s1")
    host.apply_event(browser_test_event("s1", 1, 1, "ready")) ?? panic("event")
    _: host.dispatch(BrowserHostAction.OpenPanel(placement: BrowserPlacement.InApp, panel_id: "build")) ?? panic("open in-app")
    _: host.dispatch(BrowserHostAction.OpenPanel(placement: BrowserPlacement.Workbench, panel_id: "build")) ?? panic("open workbench")
    host.select("build", Val("source")) ?? panic("select")
    _: host.dispatch(BrowserHostAction.DockPanel(placement: BrowserPlacement.Workbench, panel_id: "build", dock: DevtoolsDock.Right)) ?? panic("dock")
    in_app: host.view_model(BrowserPlacement.InApp)
    workbench: host.view_model(BrowserPlacement.Workbench)
    assert(in_app.panels[0].open)
    assert(workbench.panels[0].open)
    assert_eq(in_app.panels[0].dock, DevtoolsDock.Left)
    assert_eq(workbench.panels[0].dock, DevtoolsDock.Right)
    assert_eq(in_app.selection, workbench.selection)
    assert_eq(in_app.route, "/__jet_devtools")
    assert_eq(workbench.route, "/__jet_devtools/workbench")
    // The two placements render the same elements; only the placement fragment of each id differs.
    assert_eq(in_app.elements.len(), workbench.elements.len())
    loop index in 0..<in_app.elements.len() {
        left: in_app.elements[index]
        right: workbench.elements[index]
        assert(left.id.starts_with("jet-devtools-in-app"))
        assert(right.id.starts_with("jet-devtools-workbench"))
        assert_eq(left.kind, right.kind)
        assert_eq(left.panel_id, right.panel_id)
        assert_eq(left.node_id, right.node_id)
        assert_eq(left.label, right.label)
        assert_eq(left.value, right.value)
        assert_eq(left.status, right.status)
    }
}
#Test("reconnect_is_bounded_and_cursor_resumes") {
    host := BrowserHost.new("s1")
    loop sequence in 1..<(MAX_RECONNECT_EVENTS + 3) {
        host.apply_event(browser_test_event("s1", sequence, sequence, "ready")) ?? panic("event")
    }
    retained: host.resume_from(Val(BrowserReconnectCursor{sequence: 254})) ?? panic("resume")
    assert_eq(retained.events.len(), 4)
    assert_eq(retained.events[0].sequence, 255)
    expired: if host.resume_from(Val(BrowserReconnectCursor{sequence: 1})) == {
        .Err(.CursorExpired(_, _)) -> true
        else -> false
    }
    assert(expired)
    ahead: if host.resume_from(Val(BrowserReconnectCursor{sequence: MAX_RECONNECT_EVENTS + 3})) == {
        .Err(.CursorAhead(_, _)) -> true
        else -> false
    }
    assert(ahead)
}
#Test("stale_wrong_session_and_ungranted_actions_are_rejected") {
    host := BrowserHost.new("s1")
    host.apply_event(browser_test_event("s1", 7, 1, "ready")) ?? panic("event")
    location: BrowserSourceLocation{source_id: "src/main.jet", line: 4, column: 2, function: Val("main")}
    source: BrowserSourceGrant{session_id: "s1", revision: 7, panel_id: "build", node_id: "source", source: location}
    navigated: if host.dispatch(BrowserHostAction.NavigateSource(placement: BrowserPlacement.InApp, panel_id: "build", node_id: "source", grant: source)) == {
        .Ok(.SourceNavigated(_, _, _, _)) -> true
        else -> false
    }
    assert(navigated)
    stale: BrowserSourceGrant{session_id: "s1", revision: 6, panel_id: "build", node_id: "source", source: location}
    stale_rejected: if host.dispatch(BrowserHostAction.NavigateSource(placement: BrowserPlacement.Workbench, panel_id: "build", node_id: "source", grant: stale)) == {
        .Err(.StaleRevision(_, _)) -> true
        else -> false
    }
    assert(stale_rejected)
    wrong: BrowserSourceGrant{session_id: "s2", revision: 7, panel_id: "build", node_id: "source", source: location}
    wrong_rejected: if host.dispatch(BrowserHostAction.NavigateSource(placement: BrowserPlacement.InApp, panel_id: "build", node_id: "source", grant: wrong)) == {
        .Err(.WrongSession(_, _)) -> true
        else -> false
    }
    assert(wrong_rejected)
    action: BrowserActionGrant{session_id: "s1", revision: 7, panel_id: "build", node_id: "source", action_id: "source"}
    action_rejected: if host.dispatch(BrowserHostAction.InvokeAction(placement: BrowserPlacement.InApp, panel_id: "build", node_id: "source", action_id: "source", grant: action)) == {
        .Err(.ActionNotGranted(_)) -> true
        else -> false
    }
    assert(action_rejected)
}
