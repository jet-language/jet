// The paused devtools kernel: typed inspection, read-only and observed
// evaluation, authority, budgets, cancellation and deterministic audits.
use {
    jet_devserver.[
        AuditOutcome, AuthorityGrant, AuthorityRequirement, AuthoritySet, DEFAULT_EVALUATION_BUDGET, EVALUATE_AUTHORITY, EvaluateRequest,
        EvaluationBudget, EvaluationUsage, EvaluatorResult, INSPECT_AUTHORITY, InspectRequest, LexicalScope, MUTATE_AUTHORITY, ObservationFact,
        PausedSession, RejectReason, SessionIdentity, SourceLocation, TypedValue, cancellation_none, cancellation_requested, evaluate,
        evaluator_completed, inspect, parse_evaluate_request, paused_session, value_projection_absent, value_projection_published,
        value_projection_redacted,
    ]
}

test_identity: fn() -> SessionIdentity Never! {
    SessionIdentity.new("session-1", "src/main.jet", "rev-1", "pause-1", "frame-1") ?? panic("identity")
}

test_source: fn() -> SourceLocation Never! {
    SourceLocation.new("src/main.jet", "rev-1", 0, 10) ?? panic("source")
}

test_scope: fn() -> LexicalScope Never! {
    location: test_source()
    bindings: [
        value_projection_published("value-public", "count", "Int", location, TypedValue.Int{value: 7}),
        value_projection_redacted("value-secret", "token", "String", location),
        value_projection_absent("value-hidden", "password", "String", location),
    ]
    LexicalScope.new("scope-1", "run", None, location, bindings) ?? panic("scope")
}

test_grant: fn(capability: String) -> AuthorityGrant Never! {
    AuthorityGrant.new(capability, "scope-1") ?? panic("grant")
}

test_authority: fn() -> AuthoritySet Never! {
    AuthoritySet.new([test_grant(INSPECT_AUTHORITY), test_grant(EVALUATE_AUTHORITY), test_grant(MUTATE_AUTHORITY), test_grant("fs.write")])
}

test_session: fn() -> PausedSession Never! {
    paused_session(test_identity(), .Paused, [test_scope()], test_authority(), DEFAULT_EVALUATION_BUDGET) ?? panic("session")
}

test_inspect_request: fn(id: String, identity: SessionIdentity) -> InspectRequest Never! {
    InspectRequest{request_id: id, identity: identity, scope_id: "scope-1", value_id: None, budget: DEFAULT_EVALUATION_BUDGET, authority: [AuthorityRequirement]{}, cancellation: cancellation_none()}
}

test_evaluate_request: fn(id: String, expression: String, budget: EvaluationBudget) -> EvaluateRequest Never! {
    EvaluateRequest{request_id: id, identity: test_identity(), scope_id: "scope-1", expression: expression, mode: .ReadOnly, effects: [String]{}, authority: [AuthorityRequirement]{}, budget: budget, cancellation: cancellation_none()}
}

test_usage: fn(depth: Int, nodes: Int, bytes: Int, steps: Int) -> EvaluationUsage Never! {
    EvaluationUsage{depth: depth, nodes: nodes, bytes: bytes, steps: steps}
}

test_rejection: fn(request: InspectRequest, session: PausedSession) -> RejectReason Never! {
    if inspect(session, request) == {
        .Err(failure) -> failure.reason
        else -> panic("inspection was accepted")
    }
}

#Test("inspect_is_typed_and_omits_unpublished_values") {
    response: inspect(test_session(), test_inspect_request("request-1", test_identity())) ?? panic("inspect")
    json: response.json()
    assert(json.contains("\"kind\":\"int\""), json)
    assert(json.contains("\"publication\":\"redacted\""), json)
    assert(!json.contains("password"), json)
    assert(json.contains("\"name\":\"token\""), json)
    assert(response.audit.outcome == AuditOutcome.Accepted)
}

#Test("stale_running_and_wrong_source_fail_closed") {
    request: test_inspect_request("request-2", test_identity())
    stale := test_session()
    stale.state = .Stale
    assert(test_rejection(request, stale) == RejectReason.StaleSession)
    running := test_session()
    running.state = .Running
    assert(test_rejection(request, running) == RejectReason.SessionNotPaused)
    wrong: SessionIdentity.new("session-1", "src/other.jet", "rev-1", "pause-1", "frame-1") ?? panic("identity")
    assert(test_rejection(test_inspect_request("request-3", wrong), test_session()) == RejectReason.SourceIdentityMismatch)
}

#Test("evaluator_result_is_injected_and_mutation_needs_authority_and_observation") {
    paused: test_session()
    request: test_evaluate_request("request-4", "count + 1", DEFAULT_EVALUATION_BUDGET)
    value: value_projection_published("eval-value", "result", "Int", test_source(), TypedValue.Int{value: 8})
    response: evaluate(paused, request, evaluator_completed(test_identity(), "scope-1", Val(value), test_usage(1, 1, 64, 2))) ?? panic("evaluate")
    projected: response.value ?? panic("value")
    assert(projected.value == Val(TypedValue.Int{value: 8}))
    mutation := test_evaluate_request("request-5", "count = 8", DEFAULT_EVALUATION_BUDGET)
    mutation.mode = .Mutate
    mutation.effects = ["fs.write"]
    observation: ObservationFact{event_id: "event-1", kind: "paused.update", session_id: "session-1", source_id: "src/main.jet", source_revision: "rev-1", scope_id: "scope-1", target_id: "value-public", effect_ref: "fs.write"}
    mutated := evaluator_completed(test_identity(), "scope-1", None, test_usage(1, 1, 32, 2))
    mutated.changed = true
    mutated.observation = Val(observation)
    accepted: evaluate(paused, mutation, mutated) ?? panic("observed mutation")
    assert(accepted.changed)
    denied := mutation.copy()
    &denied.authority.push(AuthorityRequirement.new("fs.read", "scope-1") ?? panic("requirement"))
    if evaluate(paused, denied, evaluator_completed(test_identity(), "scope-1", None, test_usage(1, 0, 0, 1))) == {
        .Err(failure) -> assert(failure.reason == RejectReason.InsufficientAuthority)
        else -> panic("denied mutation was accepted")
    }
}

#Test("audit_receipts_are_deterministic") {
    request: test_inspect_request("request-6", test_identity())
    first: inspect(test_session(), request) ?? panic("first")
    second: inspect(test_session(), request) ?? panic("second")
    assert(first.audit == second.audit)
    assert(first.audit.receipt_id.starts_with("paused-audit-"), first.audit.receipt_id)
}

#Test("cancellation_budget_and_absent_result_are_fail_closed") {
    paused: test_session()
    cancelled := test_inspect_request("request-cancelled", test_identity())
    cancelled.cancellation = cancellation_requested("user stopped") ?? panic("cancellation")
    assert(test_rejection(cancelled, paused) == RejectReason.Cancelled)
    budget: EvaluationBudget.new(4, 16, 4096, 1) ?? panic("budget")
    request: test_evaluate_request("request-budget", "count", budget)
    if evaluate(paused, request, evaluator_completed(test_identity(), "scope-1", None, test_usage(1, 1, 1, 2))) == {
        .Err(failure) -> assert(failure.reason == RejectReason.BudgetExceeded)
        else -> panic("over-budget evaluation was accepted")
    }
    absent: value_projection_absent("eval-hidden", "secret", "String", test_source())
    response: evaluate(paused, request, evaluator_completed(test_identity(), "scope-1", Val(absent), test_usage(1, 1, 1, 1))) ?? panic("absent")
    assert(response.value == None)
    assert(!response.json().contains("secret"), response.json())
}

#Test("request_json_round_trips") {
    request: test_evaluate_request("request-7", "count", DEFAULT_EVALUATION_BUDGET)
    parsed: parse_evaluate_request(request.json()) ?? panic("parse")
    assert(parsed == request)
}
