use {
    jet_devserver.WebHost.[DevStatus, ListenerKind, WebHost, handle_connection_with_root_and_policy]
    std.net.[TcpStream, SocketAddr, IpAddr, Ipv4Addr]
    std.io.[Error]
    std.sync.[Arc, Mutex]
    core.files.[OSPath]
    jet_devserver.Canvas.[DebugSessions]
    jet_devserver.[ResidentDevSession]
    jet_devserver.BrowserWebAdapter.[BrowserWebState]
    jet_devserver.PausedEvaluate.[PausedEvaluateHost]
    jet_devserver.TerminalStyleReload.[TerminalStyleHostAdapter]
    jet_driver.Package.[ReleaseDevtoolsPolicy]
}
// Rust: crates/jet-devserver/src/WebHost.rs:4448
fn handle_connection(stream: TcpStream, status: &DevStatus, debug_sessions: &DebugSessions, session: &ResidentDevSession, canvas_file: String, listener_kind: ListenerKind, bind_host: String, session_secret: String) Err! {
    handle_connection_with_root(^stream, status, debug_sessions, session, canvas_file, listener_kind, bind_host, session_secret, &OSPath.new("build"))
}
// Rust: crates/jet-devserver/src/WebHost.rs:4472
fn handle_connection_with_root(stream: TcpStream, status: &DevStatus, debug_sessions: &DebugSessions, session: &ResidentDevSession, canvas_file: String, listener_kind: ListenerKind, bind_host: String, session_secret: String, static_root: &OSPath) Err! {
    browser_state :: Arc.new(Mutex.new(.None))
    paused_evaluate :: Arc.new(Mutex.new(PausedEvaluateHost.new()))
    terminal_style :: Arc.new(TerminalStyleHostAdapter.new())
    return handle_connection_with_root_and_policy(^stream, status, debug_sessions, session, canvas_file, listener_kind, bind_host, session_secret, static_root, &browser_state, &paused_evaluate, &terminal_style, &ReleaseDevtoolsPolicy.development(), SocketAddr.new(IpAddr.V4(Ipv4Addr.LOCALHOST), 0))
}
