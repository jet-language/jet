use {
    jetpack_foundation.[ColorChoice]
    core.tui.[TUIColorProfile]
}

terminal_style_test_edit: fn(source: String) -> TerminalStyleEdit { TerminalStyleEdit.new("app/style", source) }
terminal_style_test_bytes: fn(text: String) -> [U8] {
    out := [U8]{}
    loop byte in text.bytes() -> out.push(byte)
    out
}
terminal_style_test_sgr: fn(codes: String) -> TerminalStyleValue? { Val(TerminalStyleValue.Sgr(codes: codes)) }
terminal_style_test_adapter: fn() -> TerminalStyleHostAdapter {
    adapter := TerminalStyleHostAdapter.new()
    adapter.inject(TerminalStyleHostSource.new("app/style", TERMINAL_CAPABILITY_DEFAULT) ?? panic("host source"))
    adapter
}

#Test("capability_facts_are_deterministic_and_follow_explicit_policy") {
    ansi256: TerminalCapabilityFacts.from_environment(Val("xterm-256color"), None, true, false, ColorChoice.Auto)
    assert_eq(ansi256.profile, TUIColorProfile.ANSI256)
    assert(ansi256.color_enabled())
    dumb: TerminalCapabilityFacts.from_environment(Val("dumb"), Val("truecolor"), true, false, ColorChoice.Auto)
    assert_eq(dumb.profile, TUIColorProfile.ASCII)
    assert(!dumb.color_enabled())
    forced: TerminalCapabilityFacts.from_environment(Val("dumb"), None, false, true, ColorChoice.Always)
    assert_eq(forced.profile, TUIColorProfile.ANSI16)
    assert(forced.color_enabled())
    assert_eq(ansi256.fingerprint(), ansi256.fingerprint())
}
#Test("parser_produces_typed_roles_without_retaining_source") {
    document: TerminalStyleDocument.parse("# semantic roles\naccent=1;96\nsuccess=green\nerror=plain\n") ?? panic("style parses")
    assert_eq(document.value(TerminalStyleRole.Accent), terminal_style_test_sgr("1;96"))
    assert_eq(document.value(TerminalStyleRole.Success), terminal_style_test_sgr("32"))
    assert_eq(document.value(TerminalStyleRole.Error), Val(TerminalStyleValue.Plain))
    rejected: if TerminalStyleDocument.parse("accent=1;;96") == {
        .Err(_) -> true
        else -> false
    }
    assert(rejected)
}
#Test("style_reload_is_atomic_and_keeps_last_valid_snapshot_on_failure") {
    reload := TerminalStyleReload.new()
    subscriber: reload.subscribe() ?? panic("subscriber")
    first: reload.reload(terminal_style_test_edit("accent=red\nsuccess=green"))
    assert(first.applied())
    assert_eq(first.revision, 1)
    prior: reload.current ?? panic("initial style")
    state_outside_snapshot: "focused:search cursor:3"
    rejected: reload.reload(terminal_style_test_edit("accent=1;;31"))
    assert(rejected.rejected())
    assert_eq(rejected.revision, 1)
    retained: reload.current ?? panic("retained style")
    assert_eq(retained.facts.fingerprint, prior.facts.fingerprint)
    assert_eq(reload.revision(), 1)
    assert_eq(state_outside_snapshot, "focused:search cursor:3")
    error: reload.last_error ?? panic("one error fact")
    assert_eq(error.code, TerminalStyleErrorCode.InvalidStyle)
    assert(error.is_bounded())
    notifications: reload.drain_notifications(subscriber)
    assert_eq(notifications.len(), 2)
    assert_eq(notifications[0].revision, 1)
    assert_eq(notifications[1].change, TerminalStyleChangeKind.Invalid)
    assert_eq(notifications[1].revision, 1)
}
#Test("burst_coalescing_notifies_once_for_last_edit") {
    reload := TerminalStyleReload.new()
    subscriber: reload.subscribe() ?? panic("subscriber")
    _: reload.reload(terminal_style_test_edit("accent=red"))
    _: reload.drain_notifications(subscriber)
    reload.enqueue(terminal_style_test_edit("accent=green"))
    reload.enqueue(terminal_style_test_edit("accent=blue"))
    reload.enqueue(terminal_style_test_edit("accent=yellow"))
    assert(reload.pending != None)
    receipt: reload.flush() ?? panic("coalesced edit")
    assert_eq(receipt.change, TerminalStyleChangeKind.StyleOnly)
    assert_eq(receipt.revision, 2)
    assert_eq(reload.drain_notifications(subscriber).len(), 1)
    current: reload.current ?? panic("current style")
    assert_eq(current.value(TerminalStyleRole.Accent), terminal_style_test_sgr("33"))
}
#Test("capability_change_applies_but_layout_or_type_change_requires_restart") {
    reload := TerminalStyleReload.new()
    base: TerminalCapabilityFacts.from_environment(Val("xterm-256color"), None, true, false, ColorChoice.Auto)
    plain: TerminalCapabilityFacts.from_environment(Val("dumb"), None, true, false, ColorChoice.Auto)
    first: reload.reload(terminal_style_test_edit("accent=red").with_capabilities(base))
    assert_eq(first.revision, 1)
    capability: reload.reload(terminal_style_test_edit("accent=red").with_capabilities(plain))
    assert_eq(capability.change, TerminalStyleChangeKind.CapabilityOnly)
    assert_eq(capability.revision, 2)
    layout: reload.reload(terminal_style_test_edit("accent=green").with_capabilities(plain).with_layout_fingerprint("layout-v2"))
    assert_eq(layout.change, TerminalStyleChangeKind.RestartRequired(reason: TerminalStyleRestartReason.LayoutFingerprintChanged))
    assert_eq(layout.revision, 2)
    type_change: reload.reload(terminal_style_test_edit("accent=green").with_capabilities(plain).with_type_fingerprint("type-v2"))
    assert_eq(type_change.change, TerminalStyleChangeKind.RestartRequired(reason: TerminalStyleRestartReason.TypeFingerprintChanged))
    assert_eq(type_change.revision, 2)
}
#Test("dependency_order_is_canonical") {
    first: TerminalStyleDependency.from_bytes(TerminalStyleDependencyKind.Source, "z", terminal_style_test_bytes("z")) ?? panic("first dependency")
    second: TerminalStyleDependency.from_bytes(TerminalStyleDependencyKind.Source, "a", terminal_style_test_bytes("a")) ?? panic("second dependency")
    a: TerminalStyleFingerprintFacts.new("style", "accent=red", [TerminalStyleDependency]{first, second}, TERMINAL_CAPABILITY_DEFAULT, "", "") ?? panic("facts a")
    b: TerminalStyleFingerprintFacts.new("style", "accent=red", [TerminalStyleDependency]{second, first}, TERMINAL_CAPABILITY_DEFAULT, "", "") ?? panic("facts b")
    assert_eq(a.dependencies, b.dependencies)
    assert_eq(a.fingerprint, b.fingerprint)
}
#Test("host_adapter_reports_unavailable_before_source_is_injected") {
    adapter := TerminalStyleHostAdapter.new()
    assert(adapter.source == None)
    response: adapter.apply_json(`{"source":"accent=red"}`)
    assert_eq(response.outcome, TerminalStyleHostOutcome.Unavailable(reason: TerminalStyleHostUnavailableReason.SourceNotInjected))
    assert(response.event.contains(`"outcome":"unavailable"`))
    assert(response.event.contains(`"reason":"source_not_injected"`))
}
#Test("host_adapter_applies_bounded_json_after_injection") {
    adapter := terminal_style_test_adapter()
    assert(adapter.source != None)
    response: adapter.apply_json(`{"source":"accent=red\nsuccess=green"}`)
    assert_eq(response.outcome, TerminalStyleHostOutcome.Applied(revision: 1, change: TerminalStyleChangeKind.Initial))
    assert(response.event.contains(`"outcome":"applied"`))
    assert(response.event.contains(`"fingerprint"`))
}
#Test("host_adapter_rejects_invalid_style_json") {
    adapter := terminal_style_test_adapter()
    response: adapter.apply_json(`{"source":"accent=1;;96"}`)
    code: if response.outcome == {
        .Rejected(.Invalid(fact)) -> Val(fact.code)
        else -> TerminalStyleErrorCode?{None}
    }
    assert_eq(code, Val(TerminalStyleErrorCode.InvalidStyle))
    assert(response.event.contains(`"outcome":"rejected"`))
}
#Test("host_adapter_rejects_restart_required_layout_change_without_reloading") {
    adapter := terminal_style_test_adapter()
    first: adapter.apply_json(`{"source":"accent=red"}`)
    applied: if first.outcome == {
        .Applied(_, _) -> true
        else -> false
    }
    assert(applied)
    response: adapter.apply_json(`{"source":"accent=green","layout_fingerprint":"layout-v2"}`)
    assert_eq(response.outcome, TerminalStyleHostOutcome.Rejected(rejection: TerminalStyleHostRejection.RestartRequired(reason: TerminalStyleRestartReason.LayoutFingerprintChanged)))
    assert(response.event.contains(`"code":"layout_fingerprint_changed"`))
}
#Test("host_adapter_current_json_reports_unavailable_then_applied") {
    adapter := TerminalStyleHostAdapter.new()
    before: adapter.current_json()
    assert_eq(before.outcome, TerminalStyleHostOutcome.Unavailable(reason: TerminalStyleHostUnavailableReason.NoStyleApplied))
    adapter.inject(TerminalStyleHostSource.new("app/style", TERMINAL_CAPABILITY_DEFAULT) ?? panic("host source"))
    _: adapter.apply_json(`{"source":"accent=red"}`)
    after: adapter.current_json()
    assert_eq(after.outcome, TerminalStyleHostOutcome.Applied(revision: 1, change: TerminalStyleChangeKind.Unchanged))
    assert(after.event.contains(`"fingerprint"`))
}
