recording_test_identity: fn(source_id: String, build_id: String) -> SessionRecordingIdentity {
    SessionRecordingIdentity.new(source_id, build_id) ?? panic("identity")
}
recording_test_event: fn(sequence: Int, timestamp_ms: Int) -> SessionEvent {
    SessionEvent.new(sequence, timestamp_ms, "runtime", "Trace", "request-1", `{"status":"ok"}`, None) ?? panic("event")
}
recording_test_with_events: fn(max_events: Int, count: Int) -> SessionRecording {
    recording := SessionRecording.with_limits(recording_test_identity("src-a", "build-a"), SessionRecordingLimits{max_events, max_bytes: 64 * 1024}) ?? panic("recording")
    loop index in 1..<(count + 1) {
        _: recording.append_event(recording_test_event(index, index * 10)) ?? panic("append")
    }
    recording
}
recording_test_bytes: fn(text: String) -> [U8] {
    out := [U8]{}
    loop byte in text.bytes() -> out.push(byte)
    out
}

#Test("replay_steps_and_checkpoint_restore_are_deterministic") {
    recording: recording_test_with_events(8, 3)
    cursor := recording.replay()
    first: cursor.step(recording, ReplayStep.Forward) ?? panic("step 1")
    assert_eq(first.sequence, Val(1))
    checkpoint: recording.checkpoint(cursor) ?? panic("checkpoint")
    second: cursor.step(recording, ReplayStep.Forward) ?? panic("step 2")
    assert_eq(second.sequence, Val(2))
    third: cursor.step(recording, ReplayStep.Forward) ?? panic("step 3")
    assert_eq(third.sequence, Val(3))
    back: cursor.step(recording, ReplayStep.Backward) ?? panic("step back")
    assert_eq(back.sequence, Val(2))
    restored: recording.restore_checkpoint(checkpoint) ?? panic("restore")
    assert_eq(restored.sequence, Val(1))
    projection: recording.projection(restored) ?? panic("projection")
    assert_eq(projection.next_sequence, Val(2))
    event: projection.event ?? panic("projected event")
    assert_eq(event.sequence, 1)
}
#Test("truncation_facts_expose_count_and_window") {
    recording: recording_test_with_events(2, 3)
    facts: recording.truncation()
    assert_eq(facts.retained_events, 2)
    assert_eq(facts.first_retained_sequence, Val(2))
    assert_eq(facts.last_retained_sequence, Val(3))
    assert_eq(facts.dropped_events, 1)
    assert_eq(facts.first_dropped_sequence, Val(1))
    assert(facts.event_limit_reached)
    assert(facts.truncated())
}
#Test("incompatible_identity_fails_closed_and_payload_stays_absent") {
    recording: SessionRecording.new(recording_test_identity("src-a", "build-a")) ?? panic("recording")
    mismatched: if recording.replay_for(recording_test_identity("src-b", "build-a")) == {
        .Err(.IdentityMismatch(_, _)) -> true
        else -> false
    }
    assert(mismatched)
    assert_eq(recording_test_event(1, 1).payload_json, None)
}
#Test("envelope_preserves_explicit_payload_and_rejects_time_regressions") {
    recording := SessionRecording.new(recording_test_identity("src-a", "build-a")) ?? panic("recording")
    envelope: `{"protocol":"jet.devtools.v1","events":[{"sequence":1,"timestamp_ms":7,"source":"host","kind":"Custom","entity":"item","fields":{"state":"ready"},"payload":{"published":true}}]}`
    recorded: recording.record_envelope(recording_test_bytes(envelope)) ?? panic("envelope")
    assert_eq(recorded, 1)
    assert_eq(recording.events[0].payload_json, Val(`{"published":true}`))
    regressed: if recording.append_event(recording_test_event(2, 6)) == {
        .Err(.NonMonotonicTime(_, _)) -> true
        else -> false
    }
    assert(regressed)
}
