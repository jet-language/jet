browser_web_test_projection: fn(sequence: Int) -> DevtoolsProjection {
    DevtoolsProjection{
        protocol: JET_DEVTOOLS_PROTOCOL, session_id: "s1", source_id: None, build_id: None, revision: "rev", world_id: None,
        sequence: sequence, observed_at: 100 + sequence, panels: [JetDevtoolsEvent]{}, selection: None,
        status: DevtoolsStatusFact{state: .Ready, diagnostic_code: None, diagnostic: None, accepted_revision: None, last_good_revision: None, run_target: None, run_output: None, test_state: None},
        command_capabilities: DevtoolsCommandCapabilities{project_rebuild: false, project_rebuild_reason: Val("no rebuild executor is registered for this host")},
        command_receipts: [JetDevtoolsCommandReceipt]{}, reset: sequence == 1, truncation: false,
    }
}
browser_web_test_panels: fn(sequence: Int) -> [JetDevtoolsPanelProjection] {
    envelope := JetDevtoolsEnvelope.new("s1", 0)
    event: JetDevtoolsEvent.from_parts(100 + sequence, "devserver", "state", "session", "{{\"state\":\"ready\"}}") ?? panic("event")
    _: envelope.push(event)
    catalog: JetDevtoolsPanelCatalog.canonical() ?? panic("catalog")
    catalog.project(envelope, .BrowserInApp, JetDevtoolsPanelCapability.all())
}

#Test("typed_projection_renders_both_placements_from_one_state") {
    state := BrowserWebState.new("s1")
    state.sync(browser_web_test_projection(1), browser_web_test_panels(1)) ?? panic("sync")
    in_app: state.host.view_model(.InApp)
    workbench: state.host.view_model(.Workbench)
    assert_eq(in_app.session_id, workbench.session_id)
    assert(in_app.panels.len() > 0)
    assert_eq(in_app.panels[0].panel_id, workbench.panels[0].panel_id)
    assert(in_app.route != workbench.route)
}
#Test("typed_status_and_identity_stay_frame_metadata") {
    projected := browser_web_test_projection(1)
    projected.source_id = Val("src/main.jet")
    projected.build_id = Val("build-1")
    projected.world_id = Val("world-1")
    projected.status = DevtoolsStatusFact{state: .Building, diagnostic_code: Val("E0102"), diagnostic: Val("missing name"), accepted_revision: Val("accepted"), last_good_revision: Val("good"), run_target: Val("browser"), run_output: Val("web"), test_state: Val("idle")}
    state := BrowserWebState.new("s1")
    state.sync(projected, browser_web_test_panels(1)) ?? panic("sync")
    frame: state.frame(.InApp)
    assert_eq(frame.source_id, Val("src/main.jet"))
    assert_eq(frame.state, BrowserSessionState.Building)
    assert(frame.panels.len() > 0)
    assert_eq(frame.status.diagnostic_code, Val("E0102"))
    assert(!frame.tools.rebuild)
    json: browser_web_view_json(state, .InApp)
    assert(json.contains("\"source_id\":\"src/main.jet\""))
    assert(json.contains("\"status\":{{\"state\":\"building\""))
    assert(json.contains("\"rebuild\":{{\"available\":false,\"reason\":\"no rebuild executor is registered for this host\"}}"))
    assert(json.contains("\"receipts\":[]"))
    assert(!json.contains("__session_status"))
}
#Test("page_offers_tools_only_where_the_host_has_them") {
    projected := browser_web_test_projection(1)
    projected.status.state = .Error
    projected.status.diagnostic_code = Val("E0102")
    projected.status.diagnostic = Val("Error [jet.UnknownFunction]: unknown symbol\n  --> app.jet:12:9\n")
    state := BrowserWebState.new("s1")
    state.sync(projected, browser_web_test_panels(1)) ?? panic("sync")
    page: browser_web_render_page(state, .InApp)
    assert(!page.contains("data-tool=\"source\""))
    assert(!page.contains("data-tool=\"rebuild\""))
    assert(page.contains("no rebuild executor is registered for this host"))
    assert(page.contains("<pre class=\"diag\">Error [jet.UnknownFunction]: unknown symbol"))
    state.tools.source = true
    state.tools.source_reason = None
    source_page: browser_web_render_page(state, .InApp)
    assert(source_page.contains("data-tool=\"source\" data-focus=\"tool:source\" data-file=\"app.jet\">Fix in source"))
    assert(source_page.contains("class=\"source\""))
}
#Test("reconnect_reset_returns_bounded_snapshot_events") {
    state := BrowserWebState.new("s1")
    state.sync(browser_web_test_projection(1), browser_web_test_panels(1)) ?? panic("sync")
    body: browser_web_reconnect_json(state, None, true, false) ?? panic("reconnect")
    assert(body.contains("\"reset\":true"))
    assert(body.contains("\"complete\":true"))
    assert(body.contains("\"sequence\":1"))
    truncated: browser_web_reconnect_json(state, Val(0), true, true) ?? panic("truncated reconnect")
    assert(truncated.contains("\"truncation\":true"))
    assert(truncated.contains("\"complete\":false"))
    assert(truncated.contains("\"events\":[]"))
}
#Test("action_parser_requires_typed_grant_for_source_navigation") {
    body: "{{\"action\":\"navigate_source\",\"panel_id\":\"build\",\"node_id\":\"source\"}}"
    rejected: if browser_web_parse_action(body.bytes(), .InApp) == {
        .Err(message) -> "{message}".contains("grant")
        .Ok(_) -> false
    }
    assert(rejected)
}
#Test("escaping_keeps_markup_and_script_text_inert") {
    assert_eq(browser_web_html_escape("<a href='x'>&\"</a>"), "&lt;a href=&#39;x&#39;&gt;&amp;&quot;&lt;/a&gt;")
    assert_eq(browser_web_js_string("</script>\n\"\\"), "\\u003c/script\\u003e\\n\\\"\\\\")
    control: String.from_bytes([U8]{1}) ?? panic("control byte")
    assert_eq(browser_web_js_string(control), "\\u0001")
}
