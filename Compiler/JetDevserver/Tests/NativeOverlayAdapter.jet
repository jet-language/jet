overlay_adapter_test_projection: fn(revision: String, sequence: Int, events: [JetDevtoolsEvent]) -> DevtoolsProjection {
    DevtoolsProjection{
        protocol: JET_DEVTOOLS_PROTOCOL, session_id: "session", source_id: None, build_id: None,
        revision: revision, world_id: None, sequence: sequence, observed_at: 99, panels: events, selection: None,
        status: DevtoolsStatusFact{
            state: JetDevtoolsLifecycleState.Unavailable, diagnostic_code: None, diagnostic: None,
            accepted_revision: None, last_good_revision: None, run_target: None, run_output: None, test_state: None,
        },
        command_capabilities: DevtoolsCommandCapabilities{project_rebuild: false, project_rebuild_reason: Val("native overlay test projection has no rebuild executor")},
        command_receipts: [JetDevtoolsCommandReceipt]{}, reset: false, truncation: false,
    }
}
overlay_adapter_test_event: fn(sequence: Int) -> JetDevtoolsEvent {
    raw: JetDevtoolsEvent.from_parts(sequence, "session", "build", "program", `{"ok":true}`) ?? panic("devtools event")
    event: raw.publish(JetDevtoolsPayload.one("message", JetDevtoolsValue.text("opaque payload"))) ?? panic("published payload")
    envelope := JetDevtoolsEnvelope.new("session", 0)
    envelope.push(event)
    envelope.events()[0]
}
overlay_adapter_test_action_panel: fn() -> NativeOverlayPanelFact {
    action: NativeOverlayAction{action_id: "build.run", required_grant: NativeOverlayGrant.Control}
    NativeOverlayPanelFact.new("Build", "Build", 1, "ready", [NativeOverlayNode]{NativeOverlayNode.new("run", NativeOverlayNodeKind.Action, "run").with_action(action)})
}

#Test("projects_canonical_event_without_json_parsing") {
    input: overlay_adapter_test_projection("rev-1", 1, [JetDevtoolsEvent]{overlay_adapter_test_event(1)})
    update: NativeOverlayAdapter.from_projection(input, [NativeOverlayPanelFact]{}) ?? panic("projection applies")
    event: update.event ?? panic("projected event")
    log := NativeOverlayPanelFact?{None}
    loop panel in event.panels {
        if panel.panel_id == NATIVE_OVERLAY_EVENT_LOG_PANEL_ID -> log = Val(panel)
    }
    panel: log ?? panic("event log panel")
    root: panel.nodes[0]
    assert_eq(root.status, Val("build"))
    assert_eq(root.children[4].value, Val(`{"ok":true}`))
    assert_eq(root.children[5].value, Val(`{"fields":{"message":"opaque payload"}}`))
}
#Test("action_request_rejects_stale_revision") {
    adapter := NativeOverlayAdapter.new("session")
    update: adapter.apply_projection_with_panels(overlay_adapter_test_projection("rev-1", 1, [JetDevtoolsEvent]{overlay_adapter_test_event(1)}), [NativeOverlayPanelFact]{overlay_adapter_test_action_panel()}) ?? panic("first projection")
    request: adapter.action_request("Build", "run") ?? panic("action request")
    second: adapter.apply_projection_with_panels(overlay_adapter_test_projection("rev-2", 2, [JetDevtoolsEvent]{overlay_adapter_test_event(2)}), [NativeOverlayPanelFact]{overlay_adapter_test_action_panel()}) ?? panic("second projection")
    assert_eq(update.identity.revision, "rev-1")
    assert(second.reset)
    stale: if adapter.validate_action_request(request) == {
        .Err(.StaleRevision(_, _)) -> true
        else -> false
    }
    assert(stale)
}
#Test("reset_and_truncation_are_preserved") {
    input := overlay_adapter_test_projection("rev-1", 1, [JetDevtoolsEvent]{overlay_adapter_test_event(1)})
    input.reset = true
    input.truncation = true
    update: NativeOverlayAdapter.from_projection(input, [NativeOverlayPanelFact]{}) ?? panic("projection applies")
    assert(update.reset)
    assert(update.truncation)
    reset_reported := false
    loop fact in update.unavailable {
        if fact.reason == NativeOverlayUnavailableReason.Reset -> reset_reported = true
    }
    assert(reset_reported)
}
