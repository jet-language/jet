use {
    watch_test_files: core.files
}

watch_test_dir: fn(name: String) -> String {
    watch_test_files.mkdtemp("jet_watch_{name}_") ?? panic("cannot make a temp dir: {err}")
}

watch_test_write: fn(path: String, body: String) {
    watch_test_files.write(path, body) ?? panic("cannot write {path}: {err}")
}

#Test("typed_graph_records_kinds_reverse_edges_and_receipts") {
    dir: watch_test_dir("graph")
    entry: watch_test_files.join(dir, "app.jet")
    lib: watch_test_files.join(dir, "lib.jet")
    css: watch_test_files.join(dir, "app.css")
    html: watch_test_files.join(dir, "app.html")
    watch_test_files.create_dir_all(watch_test_files.join(dir, ".jet")) ?? panic("cannot make .jet: {err}")
    watch_test_write(entry, "use lib\nrun: fn() {{}}\n")
    watch_test_write(lib, "helper: fn() {{}}\n")
    watch_test_write(css, "body{{}}\n")
    watch_test_write(html, "<html></html>\n")
    watch_test_write(watch_test_files.join(dir, "package.jet"), "name: \"app\"\n")
    watch_test_write(watch_test_files.join(dir, ".jet/lock"), "lock = 1\n")
    graph := WatchGraph.from_entry(entry, [String]{"{lib}"})
    graph.upsert(watch_test_files.join(dir, "logo.png"), RootKind.Asset)
    graph.upsert(watch_test_files.join(dir, "generated/out.jet"), RootKind.Generated)
    graph.upsert(watch_test_files.join(dir, "input.json"), RootKind.BuildInput)
    assert(graph.node_count() >= 8)
    kinds := [String:Bool]{}
    loop node in graph.node_list() -> kinds[node.kind.as_str()] = true
    expected_kinds: [String]{"import", "manifest", "lock", "style", "html", "asset", "generated", "build_input"}
    loop kind in expected_kinds -> assert(kinds.has_key(kind), "graph lost the {kind} kind")
    canonical_lib: watch_canonicalize_loose(lib)
    closure: graph.closure_of([String]{canonical_lib})
    assert(closure.contains(watch_canonicalize_loose(lib)))
    assert(closure.contains(watch_canonicalize_loose(entry)))
    session := WatchSession.from_graph(graph)
    watch_test_files.append_all(lib, "// touch\n") ?? panic("cannot touch lib: {err}")
    session.mark_edit_started()
    receipt: session.poll() ?? panic("lib change")
    assert(receipt.closure.len() > 0)
    assert(receipt.render().contains("\"generation\":"))
    assert(watch_within_budget(receipt))
    watch_test_files.remove_all(dir).drop("a leftover temp dir does not change the result")
}

#Test("html_shell_tracks_local_assets_and_future_creates") {
    dir: watch_test_dir("html_assets")
    entry_path: watch_test_files.join(dir, "app.jet")
    shell_path: watch_test_files.join(dir, "shell.html")
    watch_test_write(entry_path, "run: fn() {{}}\n")
    watch_test_write(shell_path, "<html><head><link href=\"theme.css\"></head><body><img src=\"logo.png\"></body></html>")
    watch_test_write(watch_test_files.join(dir, "theme.css"), "body {{ color: white; }}\n")
    graph: WatchGraph.from_entry(entry_path, [String]{"{shell_path}"})
    shell: watch_canonicalize_loose(shell_path)
    stylesheet: watch_canonicalize_loose(watch_test_files.join(dir, "theme.css"))
    image: watch_canonicalize_loose(watch_test_files.join(dir, "logo.png"))
    entry: watch_canonicalize_loose(entry_path)
    assert(graph.nodes.has_key(shell))
    assert(graph.nodes.has_key(stylesheet))
    assert(graph.nodes.has_key(image))
    if graph.nodes.get(image) == .Val(node) -> assert(!node.stamp.exists)
    assert((graph.reverse.get(stylesheet) ?? [String:Bool]{}).has_key(entry))
    assert((graph.reverse.get(image) ?? [String:Bool]{}).has_key(entry))
    watch_test_files.remove_all(dir).drop("a leftover temp dir does not change the result")
}

#Test("runtime_file_inputs_track_generator_directories_and_files") {
    dir: watch_test_dir("runtime_inputs")
    entry_path: watch_test_files.join(dir, "generate.jet")
    assets_path: watch_test_files.join(dir, "assets")
    watch_test_files.create_dir_all(assets_path) ?? panic("cannot make assets: {err}")
    watch_test_write(watch_test_files.join(assets_path, "logo.png"), "asset")
    watch_test_write(entry_path, "use fs: core.files\nrun: fn() {{\n    fs.copy_dir(\"assets\", \"dist/assets\")\n}}\n")
    graph: WatchGraph.from_entry(entry_path, [String]{})
    entry: watch_canonicalize_loose(entry_path)
    assets: watch_canonicalize_loose(assets_path)
    image: watch_canonicalize_loose(watch_test_files.join(assets_path, "logo.png"))
    assert(graph.nodes.has_key(assets))
    assert(graph.nodes.has_key(image))
    assert((graph.reverse.get(assets) ?? [String:Bool]{}).has_key(entry))
    assert((graph.reverse.get(image) ?? [String:Bool]{}).has_key(entry))
    watch_test_files.remove_all(dir).drop("a leftover temp dir does not change the result")
}

#Test("rename_delete_atomic_and_stale_events") {
    dir: watch_test_dir("events")
    entry_path: watch_test_files.join(dir, "main.jet")
    a_path: watch_test_files.join(dir, "a.jet")
    watch_test_write(entry_path, "run: fn() {{}}\n")
    watch_test_write(a_path, "a: fn() {{}}\n")
    entry: watch_canonicalize_loose(entry_path)
    a: watch_canonicalize_loose(a_path)
    session := WatchSession.from_graph(WatchGraph.from_entry(entry_path, [String]{"{a_path}"}))
    temporary: watch_test_files.join(dir, "a.jet.tmp")
    watch_test_write(temporary, "a: fn() {{ /* new */ }}\n")
    watch_test_files.rename(temporary, a_path) ?? panic("cannot rename: {err}")
    saved: session.poll() ?? panic("atomic save")
    assert(saved.change_kinds.contains("modified") || saved.change_kinds.contains("created"))
    session.applied_generation = saved.generation
    watch_test_files.remove(a_path) ?? panic("cannot remove: {err}")
    deleted: session.poll() ?? panic("delete")
    assert(deleted.change_kinds.contains("deleted") || deleted.changed.contains(a))
    session.applied_generation = deleted.generation
    b_path: watch_test_files.join(dir, "b.jet")
    watch_test_write(b_path, "b: fn() {{}}\n")
    b: watch_canonicalize_loose(b_path)
    session.graph.upsert(b, RootKind.Import)
    session.graph.link(entry, b)
    session.graph.refresh_stamps()
    c_path: watch_test_files.join(dir, "c.jet")
    watch_test_files.rename(b_path, c_path) ?? panic("cannot rename: {err}")
    session.graph.upsert(watch_canonicalize_loose(c_path), RootKind.Import)
    renamed: session.poll() ?? panic("rename")
    session.applied_generation = renamed.generation + 10
    watch_test_write(entry_path, "run: fn() {{ /* x */ }}\n")
    if session.poll() == .Val(stale) -> assert(stale.change_kinds.contains("stale") || stale.closure.len() == 0)
    watch_test_files.remove_all(dir).drop("a leftover temp dir does not change the result")
}

#Test("crash_reconnect_recovers_stamps") {
    dir: watch_test_dir("recover")
    entry: watch_test_files.join(dir, "app.jet")
    watch_test_write(entry, "run: fn() {{}}\n")
    session := WatchSession.from_graph(WatchGraph.from_entry(entry, [String]{}))
    watch_test_write(entry, "run: fn() {{ /* edited offline */ }}\n")
    session.recover()
    assert(session.poll() == None)
    watch_test_write(entry, "run: fn() {{ /* again */ }}\n")
    session.mark_edit_started()
    receipt: session.poll() ?? panic("post-reconnect edit")
    assert(watch_within_budget(receipt))
    watch_test_files.remove_all(dir).drop("a leftover temp dir does not change the result")
}

#Test("a_settled_save_reports_its_digest_once") {
    dir: watch_test_dir("settle")
    entry: watch_test_files.join(dir, "app.jet")
    watch_test_write(entry, "run: fn() {{}}\n")
    session := WatchSession.from_graph(WatchGraph.from_entry(entry, [String]{}))
    saved: "run: fn() {{ print(\"saved\") }}\n"
    watch_test_write(entry, saved)
    receipt: session.poll() ?? panic("save")
    expected: watch_file_digest(entry)
    assert_eq(watch_test_files.read(entry) ?? "", saved)
    assert_eq(receipt.content_digests, [String?]{expected})
    assert(session.poll() == None, "a settled save must not rebuild twice")
    watch_test_files.remove_all(dir).drop("a leftover temp dir does not change the result")
}
