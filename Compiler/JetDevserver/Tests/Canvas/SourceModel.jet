use {
    source_model_test_files: core.files
    source_model_test_sys: core.sys
}

// A fresh private directory for one test, named by the test's label.
source_model_test_root: fn(label: String) -> String {
    root: source_model_test_files.join(source_model_test_sys.temp_dir(), "jet-canvas-source-model-{source_model_test_sys.pid()}-{label}")
    if source_model_test_files.exists(root) -> source_model_test_files.remove_all(root) ?? panic("cannot clear {root}: {err}")
    source_model_test_files.create_dir_all(root) ?? panic("cannot create {root}: {err}")
    root
}

source_model_test_write: fn(path: String, text: String) {
    source_model_test_files.write(path, text) ?? panic("cannot write {path}: {err}")
}

source_model_test_read: fn(path: String) -> String {
    source_model_test_files.read(path) ?? panic("cannot read {path}: {err}")
}

source_model_test_cleanup: fn(path: String) {
    source_model_test_files.remove_all(path) ?? panic("cannot remove {path}: {err}")
}

// Holds the target's parent, then swaps the final name for a link to `outside`
// before the replacement is published through the held parent.
source_model_test_replace_after_final_swap: fn(path: String, outside: String, candidate: [U8]) {
    target: source_open_parent(path) ?? panic("cannot hold parent: {err.message}")
    current: source_read_current(target.parent, target.name) ?? panic("cannot read source: {err.message}")
    mode: if current == .Val(file) -> Val(file.mode) else -> None
    source_model_test_files.rename(path, "{path}.canvas-test-held") ?? panic("cannot move source: {err}")
    source_model_test_files.symlink(outside, path) ?? panic("cannot link source: {err}")
    source_replace(target, candidate, mode) ?? panic("replace failed: {err.message}")
}

// Holds the target's parent, then swaps the parent directory itself for a
// link to `outside`; the publication stays in the held (moved) directory.
source_model_test_replace_after_ancestor_swap: fn(path: String, outside: String, candidate: [U8]) {
    target: source_open_parent(path) ?? panic("cannot hold parent: {err.message}")
    current: source_read_current(target.parent, target.name) ?? panic("cannot read source: {err.message}")
    mode: if current == .Val(file) -> Val(file.mode) else -> None
    parent: source_model_test_files.dirname(path)
    source_model_test_files.rename(parent, source_model_test_files.join(source_model_test_files.dirname(parent), "canvas-test-held")) ?? panic("cannot move parent: {err}")
    source_model_test_files.symlink(outside, parent) ?? panic("cannot link parent: {err}")
    source_replace(target, candidate, mode) ?? panic("replace failed: {err.message}")
}

#Test("compare and publish preserves the source on a conflict") {
    if !source_model_test_sys.is_unix() -> return
    root: source_model_test_root("conflict")
    path: source_model_test_files.join(root, "main.jet")
    source_model_test_write(path, "before\n")
    write_source_if_unchanged(path, "before\n", "after\n") ?? panic("first write failed")
    assert_eq(source_model_test_read(path), "after\n")
    assert(write_source_if_unchanged(path, "before\n", "lost\n") == .Err(.Conflict))
    assert_eq(source_model_test_read(path), "after\n")
    source_model_test_cleanup(root)
}

#Test("compare and publish preserves the source permissions") {
    if !source_model_test_sys.is_unix() -> return
    root: source_model_test_root("permissions")
    path: source_model_test_files.join(root, "main.jet")
    source_model_test_write(path, "before\n")
    source_model_test_files.set_mode(path, 0o640) ?? panic("cannot set mode: {err}")
    replace_source_if_unchanged_locked(path, Val("before\n"), Val("after\n")) ?? panic("replace failed")
    stat: source_model_test_files.stat(path) ?? panic("cannot stat source: {err}")
    assert_eq(stat.mode.bit_and(0o7777), 0o640)
    source_model_test_cleanup(root)
}

#Test("compare and publish creates and removes a source") {
    if !source_model_test_sys.is_unix() -> return
    root: source_model_test_root("create-remove")
    path: source_model_test_files.join(root, "main.jet")
    replace_source_if_unchanged_locked(path, None, Val("new\n")) ?? panic("create failed")
    assert_eq(source_model_test_read(path), "new\n")
    replace_source_if_unchanged_locked(path, Val("new\n"), None) ?? panic("remove failed")
    assert(!source_model_test_files.exists(path))
    source_model_test_cleanup(root)
}

#Test("compare and publish refuses a symlinked source") {
    if !source_model_test_sys.is_unix() -> return
    root: source_model_test_root("symlinked-source")
    path: source_model_test_files.join(root, "main.jet")
    outside: source_model_test_files.join(root, "outside.jet")
    source_model_test_write(outside, "must survive\n")
    source_model_test_files.symlink(outside, path) ?? panic("cannot link source: {err}")
    assert(write_source_if_unchanged(path, "must survive\n", "attacker\n") == .Err(.Failed(_)))
    assert_eq(source_model_test_read(outside), "must survive\n")
    source_model_test_cleanup(root)
}

#Test("compare and publish refuses a symlinked parent") {
    if !source_model_test_sys.is_unix() -> return
    root: source_model_test_root("symlinked-parent")
    outside: source_model_test_root("symlinked-parent-outside")
    outside_file: source_model_test_files.join(outside, "main.jet")
    source_model_test_write(outside_file, "must survive\n")
    linked: source_model_test_files.join(root, "linked")
    source_model_test_files.symlink(outside, linked) ?? panic("cannot link parent: {err}")
    path: source_model_test_files.join(linked, "main.jet")
    assert(write_source_if_unchanged(path, "must survive\n", "attacker\n") == .Err(.Failed(_)))
    assert_eq(source_model_test_read(outside_file), "must survive\n")
    source_model_test_cleanup(root)
    source_model_test_cleanup(outside)
}

#Test("compare and publish keeps a final swap inside the held parent") {
    if !source_model_test_sys.is_unix() -> return
    root: source_model_test_root("final-swap")
    path: source_model_test_files.join(root, "main.jet")
    outside: source_model_test_files.join(root, "outside.jet")
    source_model_test_write(path, "before\n")
    source_model_test_write(outside, "must survive\n")
    source_model_test_replace_after_final_swap(path, outside, "after\n".bytes())
    assert_eq(source_model_test_read(outside), "must survive\n")
    // The rename replaced the planted link itself, inside the held parent.
    assert_eq(source_model_test_read(path), "after\n")
    source_model_test_cleanup(root)
}

#Test("a read through the held parent refuses a final swap to a link") {
    if !source_model_test_sys.is_unix() -> return
    root: source_model_test_root("read-final-swap")
    path: source_model_test_files.join(root, "main.jet")
    outside: source_model_test_files.join(root, "outside.jet")
    source_model_test_write(path, "before\n")
    source_model_test_write(outside, "must survive\n")
    target: source_open_parent(path) ?? panic("cannot hold parent: {err.message}")
    source_model_test_files.rename(path, "{path}.canvas-test-held") ?? panic("cannot move source: {err}")
    source_model_test_files.symlink(outside, path) ?? panic("cannot link source: {err}")
    assert(source_read_current(target.parent, target.name) == .Err(_))
    assert_eq(source_model_test_read(outside), "must survive\n")
    source_model_test_cleanup(root)
}

#Test("compare and publish keeps an ancestor swap inside the held parent") {
    if !source_model_test_sys.is_unix() -> return
    root: source_model_test_root("ancestor-swap")
    nested: source_model_test_files.join(root, "nested")
    source_model_test_files.create_dir_all(nested) ?? panic("cannot create {nested}: {err}")
    path: source_model_test_files.join(nested, "main.jet")
    source_model_test_write(path, "before\n")
    outside: source_model_test_root("ancestor-swap-outside")
    outside_file: source_model_test_files.join(outside, "main.jet")
    source_model_test_write(outside_file, "must survive\n")
    source_model_test_replace_after_ancestor_swap(path, outside, "after\n".bytes())
    assert_eq(source_model_test_read(outside_file), "must survive\n")
    assert_eq(source_model_test_read(source_model_test_files.join(root, "canvas-test-held/main.jet")), "after\n")
    source_model_test_cleanup(root)
    source_model_test_cleanup(outside)
}

#Test("removal keeps a final swap inside the held parent") {
    if !source_model_test_sys.is_unix() -> return
    root: source_model_test_root("remove-final-swap")
    path: source_model_test_files.join(root, "main.jet")
    outside: source_model_test_files.join(root, "outside.jet")
    moved: "{path}.canvas-test-held"
    source_model_test_write(path, "before\n")
    source_model_test_write(outside, "must survive\n")
    target: source_open_parent(path) ?? panic("cannot hold parent: {err.message}")
    source_model_test_files.rename(path, moved) ?? panic("cannot move source: {err}")
    source_model_test_files.symlink(outside, path) ?? panic("cannot link source: {err}")
    target.parent.remove(target.name) ?? panic("remove failed: {err}")
    assert(source_model_test_files.stat(path) == .Err(_))
    assert_eq(source_model_test_read(moved), "before\n")
    assert_eq(source_model_test_read(outside), "must survive\n")
    source_model_test_cleanup(root)
}

#Test("removal keeps an ancestor swap inside the held parent") {
    if !source_model_test_sys.is_unix() -> return
    root: source_model_test_root("remove-ancestor-swap")
    nested: source_model_test_files.join(root, "nested")
    source_model_test_files.create_dir_all(nested) ?? panic("cannot create {nested}: {err}")
    path: source_model_test_files.join(nested, "main.jet")
    source_model_test_write(path, "before\n")
    outside: source_model_test_root("remove-ancestor-swap-outside")
    outside_file: source_model_test_files.join(outside, "main.jet")
    source_model_test_write(outside_file, "must survive\n")
    target: source_open_parent(path) ?? panic("cannot hold parent: {err.message}")
    source_model_test_files.rename(nested, source_model_test_files.join(root, "canvas-test-held")) ?? panic("cannot move parent: {err}")
    source_model_test_files.symlink(outside, nested) ?? panic("cannot link parent: {err}")
    target.parent.remove(target.name) ?? panic("remove failed: {err}")
    assert(!source_model_test_files.exists(source_model_test_files.join(root, "canvas-test-held/main.jet")))
    assert_eq(source_model_test_read(outside_file), "must survive\n")
    source_model_test_cleanup(root)
    source_model_test_cleanup(outside)
}
