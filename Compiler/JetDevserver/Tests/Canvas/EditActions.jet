use jet_devserver.Canvas.EditActions.[core_import_insert_point, core_imports, ident_prefix, imported_core_prefix]

// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1173
#Test("canvas_core_imports_preserve_module_alias_and_ignore_comments") {
    imports :: core_imports("// use core.fake as fake\nuse core.io as output // alias\nuse core.math\nfn run() -> {{}}\n")
    assert(imports.len() == 2)
    assert(imports[0].module_ref == "core.io")
    assert(imports[0].alias == "output")
    assert(imports[1].module_ref == "core.math")
    assert(imports[1].alias == "math")
    assert(ident_prefix("output.trailing") == "output")
}

// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1147
#Test("canvas_core_prefix_selects_longest_existing_import") {
    src :: "use core as base\nuse core.io as output\nuse core.io.file as files\n"
    assert(imported_core_prefix(src, "core.io.file") == "files")
    assert(imported_core_prefix(src, "core.io.file.read") == "files.read")
    assert(imported_core_prefix(src, "core.io.net") == "output.net")
    assert(imported_core_prefix(src, "other") == .None)
}

// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1207
#Test("canvas_core_import_insertion_preserves_header_and_use_block") {
    header :: "// heading\n\n"
    imports :: "use core.math as math\nuse core.io as io\n"
    (point, joined) :: core_import_insert_point("{header}{imports}\nfn run() -> {{}}\n")
    assert(point == header.len() + imports.len())
    assert(joined)
    (point, joined) :: core_import_insert_point("{header}fn run() -> {{}}\n")
    assert(point == header.len())
    assert(!joined)
    (point, joined) :: core_import_insert_point("fn run() -> {{}}\nuse core.io as io\n")
    assert(point == 0)
    assert(!joined)
}

// #6542: `alias :: path` lines and `use {` block rows name core imports too,
// and a new import goes after the block's closing brace.
#Test("canvas_core_imports_read_alias_rows_and_use_blocks") {
    src :: "use {{\n    output :: core.io // alias\n    core.math\n    // core.fake\n}}\nuse files :: core.io.file\nfn run() -> {{}}\n"
    imports :: core_imports(src)
    assert(imports.len() == 3)
    assert(imports[0].module_ref == "core.io")
    assert(imports[0].alias == "output")
    assert(imports[1].module_ref == "core.math")
    assert(imports[1].alias == "math")
    assert(imports[2].module_ref == "core.io.file")
    assert(imports[2].alias == "files")
    assert(imported_core_prefix(src, "core.io.file.read") == "files.read")
    block :: "use {{\n    m :: core.math\n    io :: core.io\n}}\n"
    (point, joined) :: core_import_insert_point("{block}\nfn run() -> {{}}\n")
    assert(point == block.len())
    assert(joined)
}
