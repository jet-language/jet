use jet_devserver.Canvas.EditActions.[core_import_insert_point, core_imports, ident_prefix, imported_core_prefix]

#Test("canvas_core_imports_preserve_module_alias_and_ignore_comments") {
    imports: core_imports("// use fake: core.fake\nuse output: core.term // alias\nuse core.math\nrun: fn() -> {{}}\n")
    assert(imports.len() == 2)
    assert(imports[0].module_ref == "core.term")
    assert(imports[0].alias == "output")
    assert(imports[1].module_ref == "core.math")
    assert(imports[1].alias == "math")
    assert(ident_prefix("output.trailing") == "output")
}

#Test("canvas_core_prefix_selects_longest_existing_import") {
    src: "use base: core\nuse fs: core.files\nuse paths: core.files.path\n"
    assert(imported_core_prefix(src, "core.files.path") == "paths")
    assert(imported_core_prefix(src, "core.files.path.join") == "paths.join")
    assert(imported_core_prefix(src, "core.files.read") == "fs.read")
    assert(imported_core_prefix(src, "other") == .None)
}

#Test("canvas_core_import_insertion_preserves_header_and_use_block") {
    header: "// heading\n\n"
    imports: "use math: core.math\nuse term: core.term\n"
    (point, joined): core_import_insert_point("{header}{imports}\nrun: fn() -> {{}}\n")
    assert(point == header.len() + imports.len())
    assert(joined)
    (point, joined): core_import_insert_point("{header}run: fn() -> {{}}\n")
    assert(point == header.len())
    assert(!joined)
    (point, joined): core_import_insert_point("run: fn() -> {{}}\nuse term: core.term\n")
    assert(point == 0)
    assert(!joined)
}

// #6542: `alias: path` lines and `use {` block rows name core imports too,
// and a new import goes after the block's closing brace.
#Test("canvas_core_imports_read_alias_rows_and_use_blocks") {
    src: "use {{\n    output: core.term // alias\n    core.math\n    // core.fake\n}}\nuse paths: core.files.path\nrun: fn() -> {{}}\n"
    imports: core_imports(src)
    assert(imports.len() == 3)
    assert(imports[0].module_ref == "core.term")
    assert(imports[0].alias == "output")
    assert(imports[1].module_ref == "core.math")
    assert(imports[1].alias == "math")
    assert(imports[2].module_ref == "core.files.path")
    assert(imports[2].alias == "paths")
    assert(imported_core_prefix(src, "core.files.path.join") == "paths.join")
    block: "use {{\n    m: core.math\n    term: core.term\n}}\n"
    (point, joined): core_import_insert_point("{block}\nrun: fn() -> {{}}\n")
    assert(point == block.len())
    assert(joined)
}
