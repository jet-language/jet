use {
    jet_devserver.Canvas.ProjectTransactions.[validate_project_path]
    fs :: std.fs // GATE #4494
    std.env.[temp_dir]
    std.process.[id]
    std.os.unix.fs.[symlink] // GATE #4494
    core.sys.target.[selected_family] // GATE #4483
    std.fmt.[format]
}

#Test("project_path_validation_rejects_symlink_components") {
    if selected_family() == "unix" {
        root :: temp_dir().join("jet-canvas-project-path-{id()}")
        _ :: fs.remove_dir_all(root)
        fs.create_dir_all(root).unwrap()
        outside :: root.with_file_name("jet-canvas-project-outside-{id()}")
        fs.create_dir_all(outside).unwrap()
        symlink(outside, root.join("linked")).unwrap()
        error :: validate_project_path(root, root.join("linked/new.jet"), "linked/new.jet").expect_err("Canvas must not resolve project paths through symlinks")
        assert(error.contains("must not traverse symlinks"), error)
        _ :: fs.remove_dir_all(root)
        _ :: fs.remove_dir_all(outside)
    }
}
