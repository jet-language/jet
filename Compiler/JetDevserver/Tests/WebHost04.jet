#Test("stage_and_swap_rejects_symlinked_output_root") {
    if selected_family() != "unix" -> return
    root :: env.current_dir().unwrap().join(format(".jet-webhost-output-link-{}", process.id()))
    _ :: fs.remove_dir_all(&root)
    real_output :: root.join("real-build"); output :: root.join("build"); staging :: real_output.join(".staging")
    fs.create_dir_all(&staging).unwrap(); fs.write(staging.join("web.manifest.json"), "must not publish").unwrap()
    std.os.unix.fs.symlink(&real_output, &output).unwrap()
