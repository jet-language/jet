    _ :: fs.remove_dir_all(&root)
}
// Rust: crates/jet-devserver/src/WebHost.rs:6867
#Test("canvas_source_route_rejects_symlinked_entry") {
    if selected_family() != "unix" -> return
    root :: env.temp_dir().join(format("jet-devserver-canvas-source-symlink-{}-{}", process.id(), SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()))
    fs.create_dir_all(&root).unwrap()
    real :: root.join("real.jet"); alias :: root.join("alias.jet")
    fs.write(&real, "fn run() { print(\"secret\") }\n").unwrap()
    std.os.unix.fs.symlink(&real, &alias).unwrap()
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap(); port :: listener.local_addr().unwrap().port(); secret :: "canvas-source-secret"
    client := TcpStream.connect(("127.0.0.1", port)).unwrap()
    request :: format("GET /canvas/source?session={} HTTP/1.1\r\nHost: 127.0.0.1:{}\r\nOrigin: http://127.0.0.1:{}\r\nConnection: close\r\n\r\n", secret, port, port)
    client.write_all(request.as_bytes()).unwrap()
    (server, _) :: listener.accept().unwrap()
    status :: DevStatus.new_with_terminal("alias.jet", false, false, false); status.set_port(port)
    session :: ResidentDevSession.new("alias.jet", port, 0); debug_sessions :: Canvas.DebugSessions.default()
    handle_connection(^server, &status, &debug_sessions, &session, alias.to_str().unwrap(), .Canvas, "127.0.0.1", secret).unwrap()
    response := ""; client.read_to_string(&response).unwrap()
    assert(response.starts_with("HTTP/1.1 404 Not Found"), response)
    assert(!response.contains("secret"), "symlinked source was disclosed")
    _ :: fs.remove_dir_all(^root)
}
// Rust: crates/jet-devserver/src/WebHost.rs:6920
#Test("application_preview_does_not_serve_files_from_source_directory") {
    root :: env.temp_dir().join(format("jet-devserver-source-disclosure-{}-{}", process.id(), SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()))
    build :: root.join("build"); source_dir :: root.join("source"); source :: source_dir.join("app.jet")
    fs.create_dir_all(&build).unwrap(); fs.create_dir_all(&source_dir).unwrap()
    fs.write(&source, "fn main() {}\n").unwrap(); fs.write(source_dir.join("private.txt"), "must not be served").unwrap()
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap(); port :: listener.local_addr().unwrap().port()
    client := TcpStream.connect(("127.0.0.1", port)).unwrap()
    client.write_all(format("GET /private.txt HTTP/1.1\r\nHost: 127.0.0.1:{}\r\nConnection: close\r\n\r\n", port).as_bytes()).unwrap()
    (server, _) :: listener.accept().unwrap()
    status :: DevStatus.new_with_terminal("app.jet", false, false, false); status.set_port(port)
    debug_sessions :: Canvas.DebugSessions.default(); session :: ResidentDevSession.new("app.jet", port, port)
    handle_connection_with_root(^server, &status, &debug_sessions, &session, source.to_str().unwrap(), .Application, "127.0.0.1", "", &build).unwrap()
    response := ""; client.read_to_string(&response).unwrap()
    assert(response.starts_with("HTTP/1.1 404 Not Found"), response)
    assert(!response.contains("must not be served"), response)
    _ :: fs.remove_dir_all(^root)
}
// Rust: crates/jet-devserver/src/WebHost.rs:6974
#Test("invalid_utf8_html_fails_closed_without_lossy_replacement") {
    root :: env.temp_dir().join(format("jet-devserver-invalid-html-{}-{}", process.id(), SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()))
    fs.create_dir_all(&root).unwrap(); fs.write(root.join("index.html"), [0x3c as U8, 0xff, 0x3e]).unwrap()
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap(); port :: listener.local_addr().unwrap().port()
    client := TcpStream.connect(("127.0.0.1", port)).unwrap()
    client.write_all(format("GET / HTTP/1.1\r\nHost: 127.0.0.1:{}\r\nConnection: close\r\n\r\n", port).as_bytes()).unwrap()
    (server, _) :: listener.accept().unwrap()
    status :: DevStatus.new_with_terminal("app.jet", false, false, false); status.set_port(port)
    debug_sessions :: Canvas.DebugSessions.default(); session :: ResidentDevSession.new("app.jet", port, port)
    handle_connection_with_root(^server, &status, &debug_sessions, &session, "app.jet", .Application, "127.0.0.1", "", &root).unwrap()
    response := ""; client.read_to_string(&response).unwrap()
    assert(response.starts_with("HTTP/1.1 500 Internal Server Error"), response)
    assert(!response.contains('�'), "invalid HTML was lossy-decoded")
    assert(decode_html([0xff]).is_err())
    _ :: fs.remove_dir_all(^root)
}
