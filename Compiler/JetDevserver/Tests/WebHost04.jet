fn bind_canvas_for_test(file: String, verbose: Bool, port: U16?) -> WebHost {
    options := CanvasHostOptions.default()
    options.port = port
    return WebHost.bind_canvas_with_options_and_policy(file, OSPath.new("build"), verbose, &options, ReleaseDevtoolsPolicy.development()).unwrap()
}
