// Rust: crates/jet-devserver/src/WebHost.rs:7143
#Test("expired_browser_lease_drives_shared_reconnect_then_ready") {
    status :: DevStatus.new("app.jet", false); status.set_port(8123); status.note_client("tab-a")
    status.clients.lock().unwrap().insert("tab-a", Instant.now() - Duration.from_millis(CLIENT_TTL_MS + 1))
    status.expire_clients()
    reconnecting :: status.json()
    assert(reconnecting.contains("\"state\":\"reconnecting\"")); assert(reconnecting.contains("reconnecting · waiting for connection"))
    status.note_client("tab-a"); ready :: status.json()
    assert(ready.contains("\"state\":\"ready\"")); assert(ready.contains("ready · localhost:8123 · 1 client"))
}
// Rust: crates/jet-devserver/src/WebHost.rs:7163
#Test("failed_edit_revision_facts_agree") {
    status :: DevStatus.new("app.jet", false); status.mark_building()
    assert_eq(status.revision_facts(), DevRevisionFacts(accepted: .None, candidate: .Val(1), diagnostic: .None))
    status.mark_ready(10, false); status.mark_building(); status.mark_ready(10, true)
    assert_eq(status.version.load(Ordering.SeqCst), 2)
    status.mark_building(); status.mark_error("E0003", "Error [E0003]: bad", true)
    failed :: status.json()
    assert(failed.contains("\"version\":2,"), failed); assert(failed.contains("\"candidate\":3,"), failed)
    assert(failed.contains("\"diagnostic_revision\":3,"), failed); assert(failed.contains("\"accepted_revision\":2,"), failed)
    assert(failed.contains("\"last_good_revision\":2}"), failed)
    status.mark_building(); status.mark_error("E0003", "Error [E0003]: bad", true)
    assert_eq(status.revision_facts(), DevRevisionFacts(accepted: .Val(2), candidate: .Val(3), diagnostic: .Val(3)))
    status.mark_building(); status.mark_ready(10, true)
    recovered :: status.json()
    assert(recovered.contains("\"version\":3,"), recovered); assert(recovered.contains("\"candidate\":null,"), recovered)
    assert(recovered.contains("\"diagnostic_revision\":null,"), recovered); assert(recovered.contains("\"accepted_revision\":3,"), recovered)
}
// Rust: crates/jet-devserver/src/WebHost.rs:7205
#Test("reconnect_overrides_ready_building_and_error_without_losing_snapshot") {
    status :: DevStatus.new("app.jet", false); status.set_port(8123); status.mark_ready(425, false); status.reconnecting.store(true, Ordering.SeqCst)
    ready :: status.json(); assert(ready.contains("\"state\":\"reconnecting\"")); assert(ready.contains("\"last_build_ms\":425"))
    status.mark_building()
    building :: status.json(); assert(building.contains("\"state\":\"reconnecting\"")); assert(building.contains("\"last_build_ms\":425"))
    status.mark_error("E0102", "Error [E0102]: missing", true)
    error :: status.json(); assert(error.contains("\"state\":\"reconnecting\"")); assert(error.contains("\"code\":\"E0102\""))
    assert(error.contains("Error [E0102]: missing")); assert(error.contains("\"last_build_ms\":425"))
    status.reconnecting.store(false, Ordering.SeqCst)
    recovered :: status.json(); assert(recovered.contains("\"state\":\"error\"")); assert(recovered.contains("\"code\":\"E0102\""))
}
// Rust: crates/jet-devserver/src/WebHost.rs:7238
#Test("blocked_verbose_refresh_cannot_reinstall_region_after_disable") {
    status :: Arc.new(DevStatus.new_with_terminal("app.jet", true, true, false))
    status.controls_ready.store(true, Ordering.SeqCst)
    terminal_guard :: status.term_lock.lock().unwrap()
    waiter :: Arc.clone(&status)
    (started_tx, started_rx) :: std.sync.mpsc.channel()
    handle :: thread.spawn(move () -> { started_tx.send(()).unwrap(); waiter.write_header_verbose("jet dev  [ready] localhost:8123 · 1 client") })
    started_rx.recv().unwrap()
    status.controls_ready.store(false, Ordering.SeqCst)
    *status.header_started.lock().unwrap() = false
    drop(^terminal_guard); handle.join().unwrap()
    assert(!status.controls_ready.load(Ordering.SeqCst)); assert(!*status.header_started.lock().unwrap())
}
