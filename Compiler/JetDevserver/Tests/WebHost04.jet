// Rust: crates/jet-devserver/src/WebHost.rs:7647
#Test("canvas_request_gate_requires_secret_and_strict_request_context") {
    secret :: mint_session_secret().unwrap(); headers: [String:String] := [:]
    headers.insert("host", "localhost:8123"); headers.insert("origin", "http://localhost:8123"); headers.insert("authorization", format("Bearer {}", secret))
    request := Request(method: "GET", target: "/canvas/graph", headers: ^headers, body: [])
    assert(canvas_api_path("/canvas/graph", "/canvas/graph"))
    for path in ["/__jet_devtools/workbench", "/__jet_devtools/recording", "/__jet_devtools/paused/inspect", "/__jet_devtools/style", "/__jet_canvas/devtools", "/canvas/devtools", "/panel/devtools"] {
        assert(canvas_api_path(path, path), format("{} must be an authorized Canvas route", path))
        assert(devtools_path(path), format("{} must enter the devtools dispatcher", path))
    }
    assert(canvas_api_path("/__jet_dev_status", "/__jet_dev_status"))
    assert(canvas_request_authorized(&request, request.target, "127.0.0.1", 8123, secret))
    request.target = format("/canvas/graph?session={}&session=wrong", secret)
    assert(!canvas_request_authorized(&request, request.target, "127.0.0.1", 8123, secret))
    request.target = "/canvas/graph"; _ :: request.headers.remove("authorization")
    assert(!canvas_request_authorized(&request, request.target, "127.0.0.1", 8123, secret))
    request.headers.insert("authorization", format("Bearer {}", secret)); _ :: request.headers.remove("origin")
    assert(!canvas_request_authorized(&request, request.target, "127.0.0.1", 8123, secret))
    request.headers.insert("sec-fetch-site", "same-origin")
    assert(canvas_request_authorized(&request, request.target, "127.0.0.1", 8123, secret))
    request.target = format("/canvas/graph?session={}", secret)
    assert(!canvas_request_authorized(&request, request.target, "127.0.0.1", 8123, secret))
    request.headers.insert("origin", "http://localhost:8123"); request.headers.insert("authorization", format("Basic {}", secret))
    assert(!canvas_request_authorized(&request, request.target, "127.0.0.1", 8123, secret))
    request.headers.insert("authorization", format("Bearer {}", secret)); request.method = "PUT"
    assert(!canvas_request_authorized(&request, request.target, "127.0.0.1", 8123, secret))
    request.method = "GET"; request.target = "/canvas/not-a-route"
    assert(!canvas_request_authorized(&request, request.target, "127.0.0.1", 8123, secret))
    request.target = "/canvas/graph"; request.body = [U8].repeat(0, jet_devserver.MAX_REQUEST_BODY_BYTES + 1)
    assert(!canvas_request_authorized(&request, request.target, "127.0.0.1", 8123, secret))
    request.body.clear()
    assert(!canvas_request_authorized(&request, request.target, "127.0.0.1", 8124, secret))
    assert(!host_header_allowed("evil.test:8123", "127.0.0.1", 8123))
    assert(!origin_allowed("http://evil.test:8123", "127.0.0.1", 8123))
    assert(!constant_time_equal(secret, "wrong"))
}
// Rust: crates/jet-devserver/src/WebHost.rs:7788
#Test("canvas_page_and_bootstrap_reject_missing_session") {
    secret :: "canvas-test-secret"
    response :: canvas_response("/canvas", secret); assert(response.starts_with("HTTP/1.1 401 Unauthorized"), response)
    response :: canvas_response("/canvas/app.js", secret); assert(response.starts_with("HTTP/1.1 401 Unauthorized"), response)
    response :: canvas_response(format("/canvas?session={}", secret), secret)
    assert(response.starts_with("HTTP/1.1 200 OK"), response); assert(response.contains(format("app.js?session={}&", secret)), response)
    response :: canvas_response(format("/canvas/app.js?session={}", secret), secret); assert(response.starts_with("HTTP/1.1 200 OK"), response)
}
// Rust: crates/jet-devserver/src/WebHost.rs:7813
fn canvas_response(target: String, secret: String) -> String {
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap(); port :: listener.local_addr().unwrap().port()
    client := TcpStream.connect(listener.local_addr().unwrap()).unwrap(); (server, _) :: listener.accept().unwrap()
    raw :: format("GET {} HTTP/1.1\r\nHost: 127.0.0.1:{}\r\nConnection: close\r\n\r\n", target, port)
    client.write_all(raw.as_bytes()).unwrap()
    status :: DevStatus.new_with_terminal("app.jet", false, false, false); status.set_port(port)
    session :: ResidentDevSession.new_with_canvas_host("app.jet", "127.0.0.1", port, 0); debug_sessions :: Canvas.DebugSessions.default()
    handle_connection(^server, &status, &debug_sessions, &session, "app.jet", .Canvas, "127.0.0.1", secret).unwrap()
    response := ""; client.read_to_string(&response).unwrap(); return ^response
}
