// Rust: crates/jet-devserver/src/WebHost.rs:6556
fn inject_live_reload(html: String, nonce: String) -> String {
    script := live_reload_script(nonce, "")
    script.shrink_to_fit()
    return inject_live_reload_with_script(html, script).unwrap_or_else(() -> { out := html.to_string(); out.push_str(script); ^out })
}
