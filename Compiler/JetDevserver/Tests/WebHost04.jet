// Rust: crates/jet-devserver/src/WebHost.rs:7470
#Test("concurrent_canvas_clients_share_checked_revision_boundary") {
    root :: env.temp_dir().join(format("jet-devserver-concurrent-canvas-{}-{}", process.id(), SystemTime.now().duration_since(UNIX_EPOCH).unwrap().as_nanos()))
    fs.create_dir_all(&root).unwrap(); path :: root.join("main.jet")
    fs.write(&path, "fn run() {\n    total := 1\n    print(total)\n}\n").unwrap()
    before :: fs.read_to_string(&path).unwrap(); revision :: Canvas.source_revision(before)
    host :: bind_canvas_for_test(path.to_str().unwrap(), false, .None); port :: host.status.port(); secret :: host.session_secret.clone(); host.start_canvas()
    barrier :: Arc.new(Barrier.new(3))
    responses :: [("client-a", "first"), ("client-b", "second")].into_iter().map(((client, name)) -> {
        barrier :: Arc.clone(&barrier); secret :: secret.clone()
        body :: format("{{\"schema_version\":1,\"op\":\"rename_binding\",\"revision\":\"{}\",\"from\":\"total\",\"to\":\"{}\",\"client_id\":\"{}\"}}", revision, name, client)
        thread.spawn(move () -> { barrier.wait(); post_canvas_transaction(port, secret, client, body) })
    }).collect<[_]>()
    barrier.wait()
    responses :: responses.into_iter().map((thread) -> thread.join().unwrap()).collect<[_]>()
    assert_eq(responses.iter().filter((response) -> response.starts_with("HTTP/1.1 200 OK")).count(), 1, "exactly one client must publish the shared revision")
    loser :: responses.iter().find((response) -> response.starts_with("HTTP/1.1 409 Conflict")).expect("one client must receive a conflict")
    current :: fs.read_to_string(&path).unwrap(); current_revision :: Canvas.source_revision(current)
    assert(loser.contains("\"kind\":\"conflict\""), loser); assert(loser.contains(format("\"current_revision\":\"{}\"", current_revision)), loser)
    session :: host.session.json()
    assert(session.contains(format("\"accepted_revision\":\"{}\"", current_revision)), session)
    assert(session.contains("\"status\":\"accepted\"")); assert(session.contains("\"status\":\"refused\""))
    drop(^host); _ :: fs.remove_dir_all(^root)
}
// Rust: crates/jet-devserver/src/WebHost.rs:7543
fn post_canvas_transaction(port: U16, secret: String, client: String, body: String) -> String {
    stream := TcpStream.connect(("127.0.0.1", port)).unwrap(); stream.set_read_timeout(.Val(Duration.from_secs(10))).unwrap()
    request :: format("POST /canvas/transaction?client_id={} HTTP/1.1\r\nHost: 127.0.0.1:{}\r\nOrigin: http://127.0.0.1:{}\r\nAuthorization: Bearer {}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", client, port, port, secret, body.len(), body)
    stream.write_all(request.as_bytes()).unwrap(); response: [U8] := []; stream.read_to_end(&response).unwrap()
    return String.from_utf8(^response).unwrap()
}
