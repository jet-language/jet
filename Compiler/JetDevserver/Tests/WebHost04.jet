use jetpack_foundation.[terminal_esc]

#Test("header_words_ready_includes_port_clients_and_build_time") {
    words: header_words("ready", "app.jet", "", 8080, 2, 420)
    assert_eq(words.word, "ready")
    assert_eq(words.rest, "localhost:8080 · 2 clients · built 0.4s")
}

#Test("header_words_ready_omits_build_time_before_first_build") {
    words: header_words("ready", "app.jet", "", 8080, 0, 0)
    assert_eq(words.word, "ready")
    assert_eq(words.rest, "localhost:8080 · 0 clients")
}

#Test("header_words_building_shows_watched_file_not_port") {
    words: header_words("building", "app.jet", "", 8080, 1, 0)
    assert_eq(words.word, "building")
    assert_eq(words.rest, "app.jet · 1 client")
}

#Test("header_words_error_shows_diagnostic_code_not_port") {
    words: header_words("error", "app.jet", "E0102", 8080, 2, 0)
    assert_eq(words.word, "error")
    assert_eq(words.rest, "E0102 · 2 clients")
}

#Test("format_build_time_renders_seconds_with_one_decimal") {
    assert_eq(format_build_time(420), "0.4s")
    assert_eq(format_build_time(1500), "1.5s")
    assert_eq(format_build_time(0), "0.0s")
}

#Test("format_line_colored_carries_a_dot_and_the_full_parity_words") {
    line: format_line_colored("ready", "localhost:8080 · 2 clients · built 0.4s")
    assert(line.starts_with("jet dev  "), line)
    assert(line.contains("●"), line)
    assert(line.contains("ready · localhost:8080 · 2 clients · built 0.4s"), line)
}

#Test("format_line_plain_uses_bracketed_state_word_no_color") {
    line: format_line_plain("error", "E0102 · 2 clients")
    assert_eq(line, "jet dev  [error] E0102 · 2 clients")
    assert(!line.contains(terminal_esc()), "the NO_COLOR and CI floor carries no ANSI: {line}")
}

#Test("frame_lines_keeps_diagnostic_words_verbatim") {
    diagnostic: "Error [jet.UnknownFunction]: nothing named `nonexistent_function_xyz` exists here\n  8 | nonexistent_function_xyz()\n    | ^^^^^^^^^^^^^^^^^^^^^^^^\nWhy: only defined names can be called\nFix: define it first"
    framed: frame_lines("E0102", diagnostic)
    loop line in diagnostic.split("\n") -> assert(framed.contains("│ {line}"), "missing verbatim line {line}")
    assert(framed[0].starts_with("┌ E0102 "), framed[0])
    assert(framed[framed.len() - 1].starts_with("└"), framed[framed.len() - 1])
}

#Test("frame_lines_drops_line_ends") {
    framed: frame_lines("E0204", "one\r\ntwo\n")
    assert_eq(framed.len(), 4)
    assert_eq(framed[1], "│ one")
    assert_eq(framed[2], "│ two")
}

#Test("injects_before_closing_body_tag") {
    html: "<html><body><p>hi</p></BODY></html>"
    out: inject_live_reload_with_script(html, live_reload_script("nonce", "secret"))
    before: out.partition("</BODY>").head
    assert(before.contains("<script>"), out)
    assert(out.contains("__jetPerfRecord"), "a live relay nonce adds the perf beacon")
}

#Test("appends_when_no_body_tag") {
    html: "<html><p>hi</p></html>"
    out: inject_live_reload_with_script(html, live_reload_script("", "secret"))
    assert(out.starts_with(html), out)
    assert(out.contains("<script>"), out)
    assert(!out.contains("__jetPerfRecord"), "no relay, no perf beacon")
}

#Test("transformed_html_uses_one_aggregate_response_budget") {
    script_capacity: 4096
    raw_limit: html_raw_response_limit(script_capacity)
    assert(2 * raw_limit + 2 * script_capacity <= MAX_STATIC_RESPONSE_BYTES, "raw HTML plus transformed HTML exceeds the shared response budget")
    assert(2 * (raw_limit + 1) + 2 * script_capacity > MAX_STATIC_RESPONSE_BYTES, "the raw HTML limit leaves an unbounded transformed response")
    assert(html_script_fits_budget(script_capacity))
}

#Test("static_paths_stay_inside_the_output_root") {
    assert_eq(static_relative_path("/") ?? "", "index.html")
    assert_eq(static_relative_path("/app.js") ?? "", "app.js")
    assert_eq(static_relative_path("/assets/site.css") ?? "", "assets/site.css")
    assert(static_relative_path("/../secret") == None)
    assert(static_relative_path("/assets/./site.css") == None)
    assert(static_relative_path("/assets//site.css") == None)
    assert(static_relative_path("/assets\\site.css") == None)
    assert(static_relative_path("/C:/secret") == None)
    assert(static_relative_path("app.js") == None)
}

#Test("content_types_follow_the_extension") {
    assert_eq(content_type_for("index.html"), "text/html; charset=utf-8")
    assert_eq(content_type_for("app.JS"), "application/javascript; charset=utf-8")
    assert_eq(content_type_for("app.wasm"), "application/wasm")
    assert_eq(content_type_for("assets/site.css"), "text/css; charset=utf-8")
    assert_eq(content_type_for("noext"), "application/octet-stream")
    assert_eq(content_type_for(".gitignore"), "application/octet-stream")
    assert(webhost_is_html("pages/About.HTML"))
    assert(!webhost_is_html(".html"))
}

#Test("failed_edit_revision_facts_agree") {
    facts := web_host_facts("app.jet", 8123)
    facts.building()
    assert(facts.accepted() == None)
    assert_eq(facts.candidate ?? 0, 1)
    assert(facts.diagnostic_revision() == None)
    facts.ready(10, false)
    facts.building()
    facts.ready(10, true)
    assert_eq(facts.version, 2)
    facts.building()
    facts.failed("E0003", "Error [jet.InvalidStatement]: bad")
    failed: facts.json()
    assert(failed.contains("\"version\":2,"), failed)
    assert(failed.contains("\"candidate\":3,"), failed)
    assert(failed.contains("\"diagnostic_revision\":3,"), failed)
    assert(failed.contains("\"accepted_revision\":2,"), failed)
    assert(failed.ends_with("\"last_good_revision\":2}}"), failed)
    facts.building()
    facts.failed("E0003", "Error [jet.InvalidStatement]: bad")
    assert_eq(facts.accepted() ?? 0, 2)
    assert_eq(facts.candidate ?? 0, 3)
    assert_eq(facts.diagnostic_revision() ?? 0, 3)
    facts.building()
    facts.ready(10, true)
    recovered: facts.json()
    assert(recovered.contains("\"version\":3,"), recovered)
    assert(recovered.contains("\"candidate\":null,"), recovered)
    assert(recovered.contains("\"diagnostic_revision\":null,"), recovered)
    assert(recovered.contains("\"accepted_revision\":3,"), recovered)
}

#Test("reconnect_overrides_ready_building_and_error_without_losing_snapshot") {
    facts := web_host_facts("app.jet", 8123)
    facts.ready(425, false)
    facts.reconnecting = true
    ready: facts.json()
    assert(ready.contains("\"state\":\"reconnecting\""), ready)
    assert(ready.contains("reconnecting · waiting for connection"), ready)
    assert(ready.contains("\"last_build_ms\":425"), ready)
    facts.building()
    building: facts.json()
    assert(building.contains("\"state\":\"reconnecting\""), building)
    assert(building.contains("\"last_build_ms\":425"), building)
    facts.failed("E0102", "Error [jet.UnknownFunction]: missing")
    error: facts.json()
    assert(error.contains("\"state\":\"reconnecting\""), error)
    assert(error.contains("\"code\":\"E0102\""), error)
    assert(error.contains("Error [jet.UnknownFunction]: missing"), error)
    assert(error.contains("\"last_build_ms\":425"), error)
    facts.reconnecting = false
    recovered: facts.json()
    assert(recovered.contains("\"state\":\"error\""), recovered)
    assert(recovered.contains("\"message\":\"error · E0102 · 0 clients\""), recovered)
}

#Test("status_words_count_the_leased_pages") {
    facts := web_host_facts("app.jet", 8123)
    facts.clients = 1
    facts.ready(1500, false)
    words: facts.words()
    assert_eq(words.word, "ready")
    assert_eq(words.rest, "localhost:8123 · 1 client · built 1.5s")
}
