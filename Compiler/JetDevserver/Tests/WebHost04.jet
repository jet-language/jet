// Rust: crates/jet-devserver/src/WebHost.rs:7855
#Test("release_devtools_route_is_read_only_and_token_gated") {
    policy :: ReleaseDevtoolsPolicy.from_manifest_profile(jet_driver.Package.ReleaseInspect.ReadOnly).with_deployment(jet_driver.Package.ReleaseDevtoolsDeployment.with_values(true, .Val("release-token"), .default()))
    unauthorized :: release_response(&policy, "GET", .None, "/__jet_devtools")
    assert(unauthorized.starts_with("HTTP/1.1 401 Unauthorized"), unauthorized); assert(unauthorized.contains("JET_INSPECT_TOKEN required"), unauthorized)
    writable :: release_response(&policy, "POST", .Val("Bearer release-token"), "/__jet_devtools")
    assert(writable.starts_with("HTTP/1.1 405 Method Not Allowed"), writable); assert(!writable.contains("\"protocol\""), writable)
    authorized :: release_response(&policy, "GET", .Val("Bearer release-token"), "/__jet_devtools")
    assert(authorized.starts_with("HTTP/1.1 200 OK"), authorized); assert(authorized.contains("\"protocol\":\"jet.devtools.v1\""), authorized)
    local :: ReleaseDevtoolsPolicy.from_manifest_profile(jet_driver.Package.ReleaseInspect.Local).with_deployment(jet_driver.Package.ReleaseDevtoolsDeployment.with_values(true, .Val("release-token"), .default()))
    absent :: release_response(&local, "GET", .Val("Bearer release-token"), "/__jet_devtools"); assert(absent.starts_with("HTTP/1.1 404 Not Found"), absent)
}
// Rust: crates/jet-devserver/src/WebHost.rs:7915
fn release_response(policy: &ReleaseDevtoolsPolicy, method: String, authorization: String?, target: String) -> String {
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap(); address :: listener.local_addr().unwrap()
    client := TcpStream.connect(address).unwrap(); (server, peer_addr) :: listener.accept().unwrap()
    request := format("{} {} HTTP/1.1\r\nHost: 127.0.0.1:{}\r\n", method, target, address.port())
    if authorization == .Val(value) -> request.push_str(format("Authorization: {}\r\n", value))
    request.push_str("Connection: close\r\n\r\n"); client.write_all(request.as_bytes()).unwrap()
    status :: DevStatus.new_with_terminal("release.jet", false, false, false); status.set_port(address.port())
    session :: ResidentDevSession.new("release.jet", 0, address.port()); debug_sessions :: Canvas.DebugSessions.default()
    browser_state :: Arc.new(Mutex.new(.None)); paused_evaluate :: Arc.new(Mutex.new(PausedEvaluateHost.new())); terminal_style :: Arc.new(TerminalStyleHostAdapter.new())
    handle_connection_with_root_and_policy(^server, &status, &debug_sessions, &session, "release.jet", .Application, "127.0.0.1", "unused-session", &OSPath.new("."), &browser_state, &paused_evaluate, &terminal_style, policy, peer_addr).unwrap()
    response := ""; client.read_to_string(&response).unwrap(); return ^response
}
