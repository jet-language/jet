    output :: root.join("build"); staging :: output.join(".staging"); outside :: root.join("outside.js")
    fs.create_dir_all(&staging).unwrap()
    fs.write(staging.join("web.manifest.json"), "staged").unwrap()
    fs.write(&outside, "must survive").unwrap()
    fs.hard_link(&outside, output.join("web.manifest.json")).unwrap()
    assert(stage_and_swap(&staging, &output, &root).is_err(), "web finalization must reject hard-linked output members")
    assert_eq(fs.read_to_string(&outside).unwrap(), "must survive")
    _ :: fs.remove_dir_all(&root)
}
// Rust: crates/jet-devserver/src/WebHost.rs:6807
#Test("stage_and_swap_rejects_symlinked_staging_ancestor") {
    if selected_family() != "unix" -> return
    root :: env.current_dir().unwrap().join(format(".jet-webhost-staging-link-{}", process.id()))
    _ :: fs.remove_dir_all(&root)
    output :: root.join("build"); staging_target :: root.join("staging-target"); staging :: output.join(".staging"); outside :: root.join("outside.js")
    fs.create_dir_all(&output).unwrap(); fs.create_dir_all(&staging_target).unwrap()
    fs.write(staging_target.join("web.manifest.json"), "must not publish").unwrap()
    fs.write(&outside, "must survive").unwrap()
    std.os.unix.fs.symlink(&staging_target, &staging).unwrap()
    assert(stage_and_swap(&staging, &output, &root).is_err(), "web finalization must reject a symlinked staging directory")
    assert_eq(fs.read_to_string(&outside).unwrap(), "must survive")
    assert_eq(fs.read_to_string(staging_target.join("web.manifest.json")).unwrap(), "must not publish")
    _ :: fs.remove_dir_all(&root)
}
