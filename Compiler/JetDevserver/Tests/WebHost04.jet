// Rust: crates/jet-devserver/src/WebHost.rs:7325
#Test("frame_lines_keeps_diagnostic_words_verbatim") {
    diagnostic :: "Error [E0102]: nothing named `nonexistent_function_xyz` exists here\n  8 | nonexistent_function_xyz()\n    | ^^^^^^^^^^^^^^^^^^^^^^^^\nWhy: only defined names can be called\nFix: define it first"
    framed :: frame_lines("E0102", diagnostic)
    for line in diagnostic.lines() -> assert(framed.iter().any((f) -> f == format("│ {}", line)), format("missing verbatim line {:?} in {:#?}", line, framed))
    assert(framed.first().unwrap().starts_with("┌ E0102 ")); assert(framed.last().unwrap().starts_with('└'))
}
