// Rust: crates/jet-devserver/src/WebHost.rs:6654
#Test("slowloris_request_hits_the_absolute_deadline_without_exhausting_admission") {
    active :: AtomicUsize.new(MAX_CONNECTION_THREADS)
    assert(!try_acquire_connection(&active), "the connection cap must reject the next slow client")
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    address :: listener.local_addr().unwrap()
    client :: thread.spawn(move () -> { stream := TcpStream.connect(address).unwrap(); _ :: stream.write_all(b"G"); thread.sleep(Duration.from_millis(100)) })
    (stream, _) :: listener.accept().unwrap()
    started :: Instant.now()
    reader := BufReader.new(DeadlineStream.new(^stream, started + Duration.from_millis(40)))
    error :: Request.read(&reader).expect_err("slow request must time out")
    assert_eq(error.kind(), ErrorKind.TimedOut)
    assert(started.elapsed() < Duration.from_millis(200))
    client.join().unwrap()
}
// Rust: crates/jet-devserver/src/WebHost.rs:6681
#Test("live_server_admission_drops_connections_after_cap") {
    listener :: TcpListener.bind(("127.0.0.1", 0)).unwrap()
    address :: listener.local_addr().unwrap()
    shutdown :: Arc.new(AtomicBool.new(false))
    server_shutdown :: Arc.clone(&shutdown)
    status :: Arc.new(DevStatus.new("admission.jet", false))
    debug_sessions :: Arc.new(Canvas.DebugSessions.default())
    session :: Arc.new(ResidentDevSession.new("admission.jet", 0, address.port()))
    browser_state :: Arc.new(Mutex.new(.None))
    paused_evaluate :: Arc.new(Mutex.new(PausedEvaluateHost.new()))
    terminal_style :: Arc.new(TerminalStyleHostAdapter.new())
    server :: thread.spawn(move () -> serve_forever(^listener, ^status, ^debug_sessions, ^session, "admission.jet", .Application, "127.0.0.1", "test-session", ^server_shutdown, OSPath.new("."), ReleaseDevtoolsPolicy.development(), ^browser_state, ^paused_evaluate, ^terminal_style))
    clients := [TcpStream].with_capacity(MAX_CONNECTION_THREADS)
    for _ in 0..MAX_CONNECTION_THREADS { client := TcpStream.connect(address).unwrap(); client.write_all(b"G").unwrap(); clients.push(^client) }
    rejected := false
    for _ in 0..100 {
        candidate := TcpStream.connect(address).unwrap()
        candidate.set_read_timeout(.Val(Duration.from_millis(20))).unwrap()
        _ :: candidate.write_all(b"G")
        byte: [U8] := [0]
        match candidate.read(&byte) {
            .Ok(0) -> { rejected = true; break }
            .Err(error) if error.kind() is .TimedOut | .WouldBlock -> {}
            .Err(_) -> { rejected = true; break }
            .Ok(_) -> {}
        }
        thread.sleep(Duration.from_millis(5))
    }
    assert(rejected, "live server must enforce the connection cap")
    drop(^clients)
    shutdown.store(true, Ordering.SeqCst)
    server.join().unwrap()
}
// Rust: crates/jet-devserver/src/WebHost.rs:6757
#Test("stage_and_swap_rejects_symlinked_destination") {
    if selected_family() != "unix" -> return // GATE #4483
    root :: env.current_dir().unwrap().join(format(".jet-webhost-symlink-{}", process.id()))
    _ :: fs.remove_dir_all(&root)
    output :: root.join("build"); staging :: output.join(".staging"); outside :: root.join("outside.js")
    fs.create_dir_all(&staging).unwrap()
    fs.write(staging.join("web.manifest.json"), "staged").unwrap()
    fs.write(&outside, "must survive").unwrap()
    std.os.unix.fs.symlink(&outside, output.join("web.manifest.json")).unwrap()
    assert(stage_and_swap(&staging, &output, &root).is_err(), "web finalization must not replace a symlinked output")
    assert_eq(fs.read_to_string(&outside).unwrap(), "must survive")
    _ :: fs.remove_dir_all(&root)
}
