            build_id :: manifest.as_deref().and_then((m) -> browser_web_adapter.manifest_artifact_identity(m).ok())
            source_revision := String?{.None}
            browser_error := String?{.None}
            if Canvas.read_source_without_symlinks(&OSPath.from(self.canvas_file)) == .Ok(source) {
                revision :: Canvas.source_revision(source)
                source_revision = .Val(revision.clone())
                if build_id.as_deref() == .Val(id) -> _ :: self.session.set_devtools_source_identity(.Val(self.canvas_file.clone()), .Val(id.to_string()), .Val(revision.clone()), .None)
                self.session.observe_source(revision)
                if (_0: manifest.as_deref(), _1: build_id.as_deref()) == (_0: .Val(m), _1: .Val(id)) {
                    if self.browser_state.lock() == {
                        .Ok(state) -> {
