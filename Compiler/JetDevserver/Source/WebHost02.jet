// Rust: crates/jet-devserver/src/WebHost.rs:2576
fn normal_output_name(value: String) -> OsStr io.Error! {
    path :: OSPath.from(value)
    components := path.components()
    name :: if components.next() == {
        .Val(.Normal(name)) -> name
        else -> { return .Err(io.Error.new(.InvalidInput, "web output name is not a normal component")) }
    }
    if components.next().is_some() -> return .Err(io.Error.new(.InvalidInput, "web output name is not a single component"))
    return name
}

