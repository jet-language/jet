            if browser_error == .Val(error) {
                self.status.mark_error("E2210", error.clone(), is_rebuild)
                self.session.mark_error("E2210", error)
                return
            }
            if (_0: build_id.as_deref(), _1: source_revision.as_deref()) == (_0: .Val(id), _1: .Val(revision)) -> self.session.mark_last_good(revision, id)
        }
        self.status.mark_ready(elapsed_ms, is_rebuild)
        self.session.mark_ready()
