use {
    jet_devserver.WebHost.[WebHost, CanvasHostOptions, DevStatus, DevRevisionFacts, terminal_style_adapter, LIVE_RELOAD_POLL_MS, APPLICATION_PORT_RANGE, CANVAS_SESSION_BYTES]
    jet_devserver.WebOutput.[web_output_publish]
    jet_devserver.[ResidentDevSession]
    Canvas: jet_devserver.Canvas
    browser_web_adapter: jet_devserver.BrowserWebAdapter
    jet_devserver.PausedEvaluate.[PausedEvaluateHost]
    jet_devserver.TerminalStyleReload.[TerminalStyleHostAdapter]
    jet_driver.Package.[ReleaseDevtoolsPolicy]
    jet_foundation.HotSwap.[HotSwapDecision]
    std.sync.[Arc, Mutex, MutexGuard]
    std.sync.atomic.[AtomicBool, Ordering]
    std.net.[TcpListener, IpAddr]
    std.time.[Duration, Instant, SystemTime, UNIX_EPOCH]
    thread: std.thread
    std.fs.[File]
    io: std.io
    std.io.[Read, Write]
    core.files.[OSPath]
    jet_repl.Term.[RawGuard, KeyReader, Key]
}
// GATE #4494: native threads, locks, retained handles and terminal IO.
// GATE #4409: IO errors retain their source kinds.
impl WebHost {
    bind_application_only_with_listener: fn(file: String, verbose: Bool, static_root: OSPath, release_policy: ReleaseDevtoolsPolicy, web_swap_enabled: Bool, application_listener: TcpListener, session: Arc<ResidentDevSession>) -> Self Err! {
        application_port: application_listener.local_addr().map((a) -> a.port()).unwrap_or(0)
        status: Arc.new(DevStatus.new_with_root(file, verbose, static_root))
        status.set_port(application_port)
        status.set_canvas_port(0)
        status.set_canvas_enabled(false)
        session_secret: mint_session_secret()
        return Self {
            listener: Mutex.new(.None), application_listener: Mutex.new(.Val(application_listener)),
            started: AtomicBool.new(false), shutdown: Arc.new(AtomicBool.new(false)), server_threads: Mutex.new([]),
            poll_thread: Mutex.new(.None), terminal_thread: Mutex.new(.None), status,
            debug_sessions: Arc.new(Canvas.DebugSessions.default()), session, canvas_file: file.to_string(),
            bind_host: "127.0.0.1", session_secret, release_policy, static_root,
            browser_state: Arc.new(Mutex.new(.None)), web_swap_enabled, hot_swap_decision: Mutex.new(.None),
            paused_evaluate: Arc.new(Mutex.new(PausedEvaluateHost.new())), terminal_style: terminal_style_adapter(file)
        }
    }
    bind_web_with_canvas_options_and_policy: fn(file: String, static_root: &OSPath, verbose: Bool, fallback_port: U16?, options: &CanvasHostOptions, release_policy: ReleaseDevtoolsPolicy) -> Self Err! {
        host: validate_canvas_options(options)
        (listener, application_listener): if {
            options.port.is_some() -> {
                listener: bind_canvas_server(host, options.port)
                application_listener: bind_application_server(fallback_port)
                (_0: listener, _1: application_listener)
            }
            else -> {
                application_listener: bind_application_server(fallback_port)
                listener: bind_canvas_server(host, .None)
                (_0: listener, _1: application_listener)
            }
        }
        canvas_port: listener.local_addr().map((a) -> a.port()).unwrap_or(0)
        application_port: application_listener.local_addr().map((a) -> a.port()).unwrap_or(0)
        status: Arc.new(DevStatus.new_with_root(file, verbose || options.audit, static_root))
        status.set_port(application_port)
        status.set_canvas_port(canvas_port)
        session_secret: mint_session_secret()
        session: Arc.new(ResidentDevSession.new_with_hosts(file, host, canvas_port, "127.0.0.1", application_port))
        session.select_output_values(options.output.as_deref(), options.target.as_deref())
        return Self {
            listener: Mutex.new(.Val(listener)), application_listener: Mutex.new(.Val(application_listener)),
            started: AtomicBool.new(false), shutdown: Arc.new(AtomicBool.new(false)), server_threads: Mutex.new([]),
            poll_thread: Mutex.new(.None), terminal_thread: Mutex.new(.None), status,
            debug_sessions: Arc.new(Canvas.DebugSessions.default()), session, canvas_file: file.to_string(),
            bind_host: host, session_secret, release_policy, static_root: static_root.to_path_buf(),
            browser_state: Arc.new(Mutex.new(.None)), web_swap_enabled: true, hot_swap_decision: Mutex.new(.None),
            paused_evaluate: Arc.new(Mutex.new(PausedEvaluateHost.new())), terminal_style: terminal_style_adapter(file)
        }
    }
    bind_canvas_with_options_and_policy: fn(file: String, static_root: &OSPath, verbose: Bool, options: &CanvasHostOptions, release_policy: ReleaseDevtoolsPolicy) -> Self Err! {
        host: validate_canvas_options(options)
        listener: bind_canvas_server(host, options.port)
        bound_port: listener.local_addr().map((a) -> a.port()).unwrap_or(0)
        status: Arc.new(DevStatus.new_with_root(file, verbose || options.audit, static_root))
        status.set_port(bound_port)
        status.set_canvas_port(bound_port)
        session_secret: mint_session_secret()
        session: Arc.new(ResidentDevSession.new_with_canvas_host(file, host, bound_port, 0))
        return Self {
            listener: Mutex.new(.Val(listener)), application_listener: Mutex.new(.None),
            started: AtomicBool.new(false), shutdown: Arc.new(AtomicBool.new(false)), server_threads: Mutex.new([]),
            poll_thread: Mutex.new(.None), terminal_thread: Mutex.new(.None), status,
            debug_sessions: Arc.new(Canvas.DebugSessions.default()), session, canvas_file: file.to_string(),
            bind_host: host, session_secret, release_policy, static_root: static_root.to_path_buf(),
            browser_state: Arc.new(Mutex.new(.None)), web_swap_enabled: false, hot_swap_decision: Mutex.new(.None),
            paused_evaluate: Arc.new(Mutex.new(PausedEvaluateHost.new())), terminal_style: terminal_style_adapter(file)
        }
    }
    start: fn(self: Self) -> Unit { self.start_inner(true) }
    start_canvas: fn(self: Self) -> Unit { self.start_inner(false) }
    lock_source_transaction: fn(self: Self) -> MutexGuard[Unit] { return self.session.lock_source_transaction() }
    resident_session: fn(self: Self) -> Arc<ResidentDevSession> { return Arc.clone(self.session) }
    publish_hot_swap_decision: fn(self: &Self, decision: &HotSwapDecision) Err! {
        self.session.publish_hot_swap_decision(decision)
        *self.hot_swap_decision.lock().unwrap() = .Val(decision.clone())
    }
    canvas_url: fn(self: Self) -> String { return "http://{url_host(self.bind_host)}:{self.session.canvas_port()}/canvas?session={self.session_secret}" }
    start_inner: fn(self: Self, terminal_controls: Bool) -> Unit {
        if self.started.swap(true, .SeqCst) -> return
        has_canvas: self.listener.lock().unwrap().is_some()
        listener: self.listener.lock().unwrap().take()
        if listener == .Val(listener) {
            status: Arc.clone(self.status)
            debug_sessions: Arc.clone(self.debug_sessions)
            session: Arc.clone(self.session)
            canvas_file: self.canvas_file.clone()
            bind_host: self.bind_host.clone()
            session_secret: self.session_secret.clone()
            release_policy: self.release_policy.clone()
            static_root: self.static_root.clone()
            shutdown: Arc.clone(self.shutdown)
            browser_state: Arc.clone(self.browser_state)
            paused_evaluate: Arc.clone(self.paused_evaluate)
            terminal_style: Arc.clone(self.terminal_style)
            handle: thread.spawn(() -> serve_forever(listener, status, debug_sessions, session, canvas_file, .Canvas, bind_host, session_secret, shutdown, static_root, release_policy, browser_state, paused_evaluate, terminal_style))
            self.server_threads.lock().unwrap().push(handle)
        }
        if self.application_listener.lock().unwrap().take() == .Val(application_listener) {
            status: Arc.clone(self.status)
            debug_sessions: Arc.clone(self.debug_sessions)
            session: Arc.clone(self.session)
            canvas_file: self.canvas_file.clone()
            static_root: self.static_root.clone()
            session_secret: self.session_secret.clone()
            application_host: self.session.application_host().to_string()
            release_policy: self.release_policy.clone()
            browser_state: Arc.clone(self.browser_state)
            paused_evaluate: Arc.clone(self.paused_evaluate)
            terminal_style: Arc.clone(self.terminal_style)
            shutdown: Arc.clone(self.shutdown)
            handle: thread.spawn(() -> serve_forever(application_listener, status, debug_sessions, session, canvas_file, .Application, application_host, session_secret, shutdown, static_root, release_policy, browser_state, paused_evaluate, terminal_style))
            self.server_threads.lock().unwrap().push(handle)
        }
        _: (() -> {
            status: Arc.clone(self.status)
            shutdown: Arc.clone(self.shutdown)
            handle: thread.spawn(() -> {
                loop !wait_for_shutdown(shutdown, Duration.from_millis(LIVE_RELOAD_POLL_MS)) {
                    status.activate_requested_browser_trace()
                    status.expire_clients()
                }
            })
            *self.poll_thread.lock().unwrap() = .Val(handle)
        })()
        if self.session_application_port() != 0 -> println("App preview: http://{url_host(self.session.application_host())}:{self.session_application_port()}/")
        if has_canvas -> println("Canvas: {self.canvas_url()}")
        _: std.io.stdout().flush()
        if terminal_controls {
            if start_terminal_controls(Arc.clone(self.status), Arc.clone(self.shutdown)) == .Val(handle) -> *self.terminal_thread.lock().unwrap() = .Val(handle)
        }
        self.status.activate()
    }
    mark_building: fn(self: Self) -> Unit { self.status.mark_building(); self.session.mark_building() }
    mark_ready: fn(self: Self, elapsed_ms: U128, is_rebuild: Bool) -> Unit {
        _: self.hot_swap_decision.lock().unwrap().take()
        if self.web_swap_enabled && Canvas.read_source_without_symlinks(OSPath.from(self.canvas_file)) == .Ok(source) -> self.session.observe_source(Canvas.source_revision(source))
        self.status.mark_ready(elapsed_ms, is_rebuild)
        self.session.mark_ready()
    }
    mark_error: fn(self: Self, code: String, diagnostic: String, is_rebuild: Bool) -> Unit {
        _: self.hot_swap_decision.lock().unwrap().take()
        self.status.mark_error(code.clone(), diagnostic.clone(), is_rebuild)
        if Canvas.read_source_without_symlinks(OSPath.from(self.canvas_file)) == .Ok(source) -> self.session.observe_source(Canvas.source_revision(source))
        self.session.mark_error(code, diagnostic)
    }
    revision_facts: fn(self: Self) -> DevRevisionFacts { return self.status.revision_facts() }
    exit_code: fn(self: Self) -> I32? {
        code: self.status.exit_code.load(.SeqCst)
        return if code != 0 -> .Val(I32{code}) else -> .None
    }
    session_application_port: fn(self: Self) -> U16 { return self.session.application_port() }
}
impl WebHost.Drop {
    drop: fn(self: Self) -> Unit {
        self.session.mark_stopped()
        self.shutdown.store(true, .SeqCst)
        _: self.listener.lock().unwrap().take()
        _: self.application_listener.lock().unwrap().take()
        if self.terminal_thread.lock().unwrap().take() == .Val(handle) -> _: handle.join()
        if self.poll_thread.lock().unwrap().take() == .Val(handle) -> _: handle.join()
        handles: self.server_threads.lock().unwrap().drain(..).collect[[thread.JoinHandle[Unit]]]()
        loop handle in handles -> _: handle.join()
        if self.paused_evaluate.lock() == .Ok(paused_evaluate) -> _: self.debug_sessions.cancel_all_paused_sessions(paused_evaluate, "web host stopped")
        self.status.active.store(false, .SeqCst)
    }
}
wait_for_shutdown: fn(shutdown: AtomicBool, duration: Duration) -> Bool {
    deadline: Instant.now() + duration
    loop !shutdown.load(.SeqCst) {
        remaining: deadline.saturating_duration_since(Instant.now())
        if remaining.is_zero() -> return false
        thread.sleep(remaining.min(Duration.from_millis(10)))
    }
    return true
}
start_terminal_controls: fn(status: Arc<DevStatus>, shutdown: Arc<AtomicBool>) -> thread.JoinHandle[Unit]? {
    if !status.pin -> return .None
    raw: RawGuard.enable() ?? return .None
    status.controls_ready.store(true, .SeqCst)
    return .Val(thread.spawn(() -> {
        keys := KeyReader.new(std.io.stdin())
        loop {
            if shutdown.load(.SeqCst) { status.disable_terminal_controls(); drop(raw); return }
            if keys.read_key() == {
                .Char('v') | .Char('V') -> status.toggle_verbose()
                .Idle -> {}
                .CtrlC -> { status.disable_terminal_controls(); drop(raw); status.exit_code.store(130, .SeqCst); return }
                .Eof -> { status.disable_terminal_controls(); drop(raw); return }
                else -> {}
            }
        }
    }))
}
header_words: fn(state: String, file: String, code: String, port: U16, clients: U64, last_build_ms: U128) -> (String, String) {
    plural: if clients == 1 -> "" else -> "s"
    if state == {
        "building" -> { return (_0: "building", _1: "{file} · {clients} client{plural}") }
        "error" -> { return (_0: "error", _1: "{code} · {clients} client{plural}") }
        else -> {
            rest := "localhost:{port} · {clients} client{plural}"
            if last_build_ms > 0 -> rest.push_str(" · built {format_build_time(last_build_ms)}")
            return (_0: "ready", _1: rest)
        }
    }
}
format_build_time: fn(ms: U128) -> String { return "{ms as F64 / 1000.0:.1}s" }
format_line_colored: fn(word: String, rest: String) -> String {
    sgr: if word == {
        "ready" -> "32"
        "building".bit_or("reconnecting") -> "33"
        "error" -> "31"
        else -> "37"
    }
    return "jet dev  {Char{27}}[{sgr}m●{Char{27}}[0m {word} · {rest}"
}
format_line_plain: fn(word: String, rest: String) -> String { return "jet dev  [{word}] {rest}" }
frame_lines: fn(code: String, diagnostic: String) -> [String] {
    lines: diagnostic.lines().collect[[String]]()
    content_width: lines.iter().map((l) -> l.chars().count()).max().unwrap_or(0)
    width: content_width.max(code.len() + 2).clamp(20, 96)
    dash_count: width.saturating_sub(code.len() + 3).max(1)
    out := [String].with_capacity(lines.len() + 2)
    out.push("┌ {code} " + "─".repeat(dash_count))
    loop line in lines -> out.push("│ {line}")
    out.push("└" + "─".repeat(width + 2))
    return out
}
clock_time: fn() -> String {
    secs: SystemTime.now().duration_since(UNIX_EPOCH).unwrap_or_default().as_secs()
    sod: secs % 86400
    return "{sod / 3600:02}:{(sod % 3600) / 60:02}:{sod % 60:02}"
}
// Publish completed bundles under the static-reader lock, with preflight and rollback.
stage_and_swap: fn(staging: OSPath, out_dir: OSPath, root: OSPath) -> io.Error! {
    publication: lock_static_publication()
    return web_output_publish(staging, out_dir, root)
}
bind_application_server: fn(port: U16?) -> TcpListener Err! {
    if port == .Val(port) {
        if TcpListener.bind((_0: "127.0.0.1", _1: port)) == {
            .Ok(listener) -> { return listener }
            .Err(e) -> {
                fix: if e.kind() == .AddrInUse -> "\n fix: stop whatever's using port {port}, or pick another with --port=<N>" else -> ""
                return .Err("error: couldn't bind application preview to port {port}: {e}{fix}")
            }
        }
    }
    last_err := io.Error?{.None}
    loop port in APPLICATION_PORT_RANGE {
        if TcpListener.bind((_0: "127.0.0.1", _1: port)) == {
            .Ok(listener) -> { return listener }
            .Err(e) && e.kind() == .AddrInUse -> { last_err = .Val(e); next }
            .Err(e) -> { return .Err("error: couldn't start the application preview: {e}") }
        }
    }
    detail: last_err.map((e) -> " ({e})").unwrap_or_default()
    return .Err("error: every application preview port from {APPLICATION_PORT_RANGE.start()} to {APPLICATION_PORT_RANGE.end()} is already in use{detail}\n fix: free one of those ports, stop the other process using it, or pick one explicitly with --port=<N>")
}
bind_canvas_server: fn(host: String, port: U16?) -> TcpListener Err! {
    requested: port.unwrap_or(0)
    if TcpListener.bind((_0: host, _1: requested)) == {
        .Ok(listener) -> { return listener }
        .Err(error) -> {
            fix: if error.kind() == .AddrInUse -> "\n fix: stop whatever's using port {requested}, or pick another with --canvas-port=<N>" else -> ""
            return .Err("error: couldn't bind Canvas host {host}:{requested}: {error}{fix}")
        }
    }
}
validate_canvas_options: fn(options: CanvasHostOptions) -> String Err! {
    if options.transport != "http" -> return .Err("error: Canvas transport `{options.transport}` is unsupported; use `http`")
    if options.authority != "loopback" && options.authority != "remote" -> return .Err("error: Canvas authority `{options.authority}` is invalid; use `loopback` or `remote`")
    host: normalize_bind_host(options.host)
    if !is_loopback_host(host) && options.authority != "remote" -> return .Err("error: Canvas host `{host}` is not loopback; set `authority = remote` explicitly")
    return host
}
mint_session_secret: fn() -> String Err! {
    bytes := [U8; CANVAS_SESSION_BYTES]{[0; CANVAS_SESSION_BYTES]}
    source := File.open(OSPath.from("/dev/urandom")) ?? return .Err("could not open the system random source: {err}")
    source.read_exact(bytes) ?? return .Err("could not read the system random source: {err}")
    return bytes.iter().map((byte) -> "{byte:02x}").collect()
}
normalize_bind_host: fn(host: String) -> String Err! {
    host := host.trim() // #4303
    host: host.strip_prefix('[').and_then((h) -> h.strip_suffix(']')).unwrap_or(host)
    if host.is_empty() || host.chars().any((c) -> c.is_whitespace()) || host.contains('/') -> return .Err("error: Canvas host `{host}` is invalid")
    return host.to_string()
}
is_loopback_host: fn(host: String) -> Bool {
    return host.eq_ignore_ascii_case("localhost") || host.parse[IpAddr]().map((address) -> address.is_loopback()).unwrap_or(false)
}
url_host: fn(host: String) -> String { return if host.parse[IpAddr]() == {
    .Ok(.V6(_)) -> "[{host}]"
    else -> host.to_string()
} }

