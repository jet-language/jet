// Rust: crates/jet-devserver/src/WebHost.rs:3336
fn stage_and_swap_locked(staging: OSPath, out_dir: OSPath, root: OSPath) -> io.Error! {
    // Rust: crates/jet-devserver/src/WebHost.rs:3337
    FILES :: ["web.manifest.json", "jet_dom_runtime.js", "app.js", "app_wasm.rs", "app.wasm", "index.html"]
    // Rust: crates/jet-devserver/src/WebHost.rs:3345
    MAP_FILES :: ["app.js.map", "app.wasm.map"]
    output_root :: WebOutputAuthority.open(out_dir, root)
    staging_name :: staging.file_name().and_then((n) -> n.to_str()) ?? return .Err(io.Error.new(.InvalidInput, "web staging directory has no normal name"))
    staging_parent :: staging.parent().filter((p) -> !p.as_os_str().is_empty()).unwrap_or_else(() -> OSPath.from("."))
    if fs.canonicalize(staging_parent)? != output_root.path() -> return .Err(io.Error.new(.PermissionDenied, "web staging directory escapes the output directory"))
    staging_root :: output_root.open_existing_child(staging_name)
    names := [String].with_capacity(FILES.len() + MAP_FILES.len())
    staged_names := [String].with_capacity(FILES.len() + MAP_FILES.len())
    loop name in FILES {
        _ :: staging_root.validate_file(name, true)
        _ :: output_root.validate_file(name, false)
        names.push(name)
        staged_names.push(name)
    }
    loop name in MAP_FILES {
        staged :: staging_root.validate_file(name, false)
        current :: output_root.validate_file(name, false)
        if staged || current -> names.push(name)
        if staged -> staged_names.push(name)
    }
    (backup_name, backup) :: output_root.create_unique_child(".jet-web-publication")
    backed_up := [String]{}
    published := [String]{}
    result :: (() -> Unit io.Error! {
        loop name in &names {
            if output_root.validate_file(name, false)? {
                backed_up.push(name)
                output_root.rename_file_to(name, &backup)?
            }
        }
        loop name in &staged_names {
            published.push(name)
            staging_root.rename_file_to(name, &output_root)?
        }
    })()
    if result == .Err(error) {
        loop name in published.iter().rev() -> _ :: output_root.remove_file_if_exists(name)
        loop name in backed_up.iter().rev() -> _ :: backup.rename_file_to(name, &output_root)
        loop name in &names -> _ :: backup.remove_file_if_exists(name)
        _ :: output_root.remove_child_directory(backup_name)
        return .Err(^error)
    }
    loop name in &names -> _ :: backup.remove_file_if_exists(name)
    _ :: output_root.remove_child_directory(backup_name)
}
// Rust: crates/jet-devserver/src/WebHost.rs:3426
fn ensure_real_output_dir(path: OSPath, root: OSPath) -> OSPath io.Error! {
    root :: fs.canonicalize(root)
    ensure_directory_without_symlinks(path)
    real :: fs.canonicalize(path)
    if !real.starts_with(&root) -> return .Err(io.Error.new(.PermissionDenied, "output directory escapes `{root.display()}`"))
    return real
}
// Rust: crates/jet-devserver/src/WebHost.rs:3439
fn ensure_directory_without_symlinks(path: OSPath) -> io.Error! {
    if fs.symlink_metadata(path) == {
        .Ok(m) && m.file_type().is_symlink() -> { return .Err(io.Error.new(.PermissionDenied, "web output directory must not be a symlink")) }
        .Ok(m) && m.is_dir() -> { return }
        .Ok(_) -> { return .Err(io.Error.new(.AlreadyExists, "web output path is not a directory")) }
        .Err(error) && error.kind() == .NotFound -> {
            if path.parent().filter((p) -> !p.as_os_str().is_empty()) == .Val(parent) -> ensure_directory_without_symlinks(parent)
            return fs.create_dir(path)
        }
        .Err(error) -> { return .Err(^error) }
    }
}
// Rust: crates/jet-devserver/src/WebHost.rs:3466
fn bind_application_server(port: U16?) -> TcpListener Err! {
    if port == .Val(port) {
        if TcpListener.bind((_0: "127.0.0.1", _1: port)) == {
            .Ok(listener) -> { return listener }
            .Err(e) -> {
                fix :: if e.kind() == .AddrInUse -> "\n fix: stop whatever's using port {port}, or pick another with --port=<N>" else -> ""
                return .Err("error: couldn't bind application preview to port {port}: {e}{fix}")
            }
        }
    }
    last_err := io.Error?{.None}
    loop port in APPLICATION_PORT_RANGE {
        if TcpListener.bind((_0: "127.0.0.1", _1: port)) == {
            .Ok(listener) -> { return listener }
            .Err(e) && e.kind() == .AddrInUse -> { last_err = .Val(^e); next }
            .Err(e) -> { return .Err("error: couldn't start the application preview: {e}") }
        }
    }
    detail :: last_err.map((e) -> " ({e})").unwrap_or_default()
    return .Err("error: every application preview port from {APPLICATION_PORT_RANGE.start()} to {APPLICATION_PORT_RANGE.end()} is already in use{detail}\n fix: free one of those ports, stop the other process using it, or pick one explicitly with --port=<N>")
}
// Rust: crates/jet-devserver/src/WebHost.rs:3510
fn bind_canvas_server(host: String, port: U16?) -> TcpListener Err! {
    requested :: port.unwrap_or(0)
    if TcpListener.bind((_0: host, _1: requested)) == {
        .Ok(listener) -> { return listener }
        .Err(error) -> {
            fix :: if error.kind() == .AddrInUse -> "\n fix: stop whatever's using port {requested}, or pick another with --canvas-port=<N>" else -> ""
            return .Err("error: couldn't bind Canvas host {host}:{requested}: {error}{fix}")
        }
    }
}
// Rust: crates/jet-devserver/src/WebHost.rs:3531
fn validate_canvas_options(options: CanvasHostOptions) -> String Err! {
    if options.transport != "http" -> return .Err("error: Canvas transport `{options.transport}` is unsupported; use `http`")
    if options.authority != "loopback" && options.authority != "remote" -> return .Err("error: Canvas authority `{options.authority}` is invalid; use `loopback` or `remote`")
    host :: normalize_bind_host(options.host)
    if !is_loopback_host(host) && options.authority != "remote" -> return .Err("error: Canvas host `{host}` is not loopback; set `authority = remote` explicitly")
    return host
}
// Rust: crates/jet-devserver/src/WebHost.rs:3553
fn mint_session_secret() -> String Err! {
    bytes := [U8; CANVAS_SESSION_BYTES]{[0; CANVAS_SESSION_BYTES]}
    source := File.open(OSPath.from("/dev/urandom")) ?? return .Err("could not open the system random source: {err}")
    source.read_exact(&bytes) ?? return .Err("could not read the system random source: {err}")
    return bytes.iter().map((byte) -> "{byte:02x}").collect()
}
// Rust: crates/jet-devserver/src/WebHost.rs:3562
fn normalize_bind_host(host: String) -> String Err! {
    host := host.trim() // #4303
    host :: host.strip_prefix('[').and_then((h) -> h.strip_suffix(']')).unwrap_or(host)
    if host.is_empty() || host.chars().any((c) -> c.is_whitespace()) || host.contains('/') -> return .Err("error: Canvas host `{host}` is invalid")
    return host.to_string()
}
// Rust: crates/jet-devserver/src/WebHost.rs:3574
fn is_loopback_host(host: String) -> Bool {
    return host.eq_ignore_ascii_case("localhost") || host.parse[IpAddr]().map((address) -> address.is_loopback()).unwrap_or(false)
}
// Rust: crates/jet-devserver/src/WebHost.rs:3582
fn url_host(host: String) -> String { return if host.parse[IpAddr]() == {
    .Ok(.V6(_)) -> "[{host}]"
    else -> host.to_string()
} }

