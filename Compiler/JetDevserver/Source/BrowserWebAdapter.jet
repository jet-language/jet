    // Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:103
    fn new(session_id: String) -> BrowserWebState {
        BrowserWebState { host: BrowserHost.new(session_id), facts: [:], panel_order: VecDeque.new(),
            source_id: .None, build_id: .None, revision: "", world_id: .None, status: starting_status(),
            tools: BrowserTools { source: false, source_reason: .None, rebuild: false, rebuild_reason: .None },
            receipts: [], swap: .None, last_swap: .None, swap_error: .None, dom_state: [] }
    }
    // Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:127
    pub fn host(self) -> &BrowserHost { &self.host }
    // Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:131
    pub fn frame(self, placement: BrowserPlacement) -> BrowserDevtoolsFrame {
        model := self.host.view_model(placement)
        BrowserDevtoolsFrame { placement: model.placement, route: model.route, protocol: model.protocol,
            session_id: model.session_id, source_id: self.source_id.clone(), build_id: self.build_id.clone(),
            revision: self.revision.clone(), world_id: self.world_id.clone(), sequence: model.sequence,
            cursor: model.cursor, state: browser_session_state(self.status.state), status: self.status.clone(),
            tools: self.tools.clone(), receipts: self.receipts.clone(), selection: model.selection,
            panels: model.panels, elements: model.elements }
    }
    // Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:154
    fn reset(&self, session_id: String) -> {
        self.host = BrowserHost.new(session_id)
        self.facts.clear(); self.panel_order.clear()
        self.source_id = .None; self.build_id = .None; self.revision.clear(); self.world_id = .None
        self.status = starting_status(); self.receipts.clear()
        self.swap = .None; self.last_swap = .None; self.swap_error = .None; self.dom_state.clear()
    }
    // Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:170
    fn sync(&self, projection: DevtoolsProjection, canonical_panels: [JetDevtoolsPanelProjection]) -> () Err! {
        if projection.protocol != JET_DEVTOOLS_PROTOCOL -> return .Err("devtools projection protocol does not match jet.devtools.v1")
        if projection.session_id != self.host.session_id() -> self.reset(projection.session_id.clone())
        if projection.reset {
            self.facts.clear(); self.panel_order.clear()
            self.host = BrowserHost.new(projection.session_id.clone())
        }
        self.source_id = bounded_optional(projection.source_id.clone(), MAX_BROWSER_TEXT)
        self.build_id = bounded_optional(projection.build_id.clone(), MAX_BROWSER_TEXT)
        self.revision = bounded_text(projection.revision, "", MAX_BROWSER_TEXT)
        self.world_id = bounded_optional(projection.world_id, MAX_BROWSER_TEXT)
        self.status = normalize_status(projection.status)
        self.tools.rebuild = projection.command_capabilities.project_rebuild
        self.tools.rebuild_reason = bounded_optional(projection.command_capabilities.project_rebuild_reason, MAX_BROWSER_TEXT)
        self.receipts = projection.command_receipts
        self.facts.clear(); self.panel_order.clear()
        for panel in canonical_panels {
            fact := panel_from_projection(panel)
            panel_id := fact.panel_id.clone()
            self.panel_order.push_back(panel_id.clone())
            _ :: self.facts.insert(panel_id, fact)
        }
        sequence := projection.sequence
        should_apply := self.host.sequence().map_or(true, (current) -> sequence > current)
        if should_apply {
            revision := self.host.revision().unwrap_or(0).max(parse_revision(projection.revision).unwrap_or(sequence))
            panels := self.panel_order.iter().filter_map((panel_id) -> self.facts.get(panel_id)).cloned().collect()
            event := BrowserHostEvent.new(self.host.session_id(), revision, sequence, projection.observed_at, panels)
            self.host.apply_event(event) ?? return .Err("browser projection rejected event: {err}")
        }
        if projection.selection == {
            .Val(selection) -> {
                if self.host.panel(selection.panel_id).is_some() {
                    if selection.item_key.is_empty() || self.host.select(selection.panel_id, .Val(selection.item_key.clone())).is_ok() {
                        if selection.item_key.is_empty() -> self.host.select(selection.panel_id, .None) ?? return .Err(err.to_string())
                    } else {
                        self.host.select(selection.panel_id, .None) ?? return .Err(err.to_string())
                    }
                } else { self.host.clear_selection() }
            },
            .None -> self.host.clear_selection()
        }
        .Ok(())
    }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:269
fn starting_status() -> DevtoolsStatusFact {
    DevtoolsStatusFact { state: .Starting, diagnostic_code: .None, diagnostic: .None, accepted_revision: .None,
        last_good_revision: .None, run_target: .None, run_output: .None, test_state: .None }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:282
fn normalize_status(status: DevtoolsStatusFact) -> DevtoolsStatusFact {
    status.diagnostic_code = bounded_optional(status.diagnostic_code, MAX_BROWSER_TEXT)
    status.diagnostic = bounded_optional(status.diagnostic, MAX_BROWSER_VALUE)
    status.accepted_revision = bounded_optional(status.accepted_revision, MAX_BROWSER_TEXT)
    status.last_good_revision = bounded_optional(status.last_good_revision, MAX_BROWSER_TEXT)
    status.run_target = bounded_optional(status.run_target, MAX_BROWSER_TEXT)
    status.run_output = bounded_optional(status.run_output, MAX_BROWSER_VALUE)
    status.test_state = bounded_optional(status.test_state, MAX_BROWSER_TEXT)
    status
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:293
fn bounded_optional(value: String?, limit: USize) -> String? {
    value.and_then((value) -> {
        bounded := bounded_text(value, "", limit)
        if bounded.is_empty() -> .None else .Val(bounded)
    })
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:300
fn browser_session_state(state: DevtoolsSessionState) -> BrowserSessionState {
    if state == { .Starting | .Ready -> .Idle, .Building -> .Building, .Error -> .BuildFailed,
        .Unavailable | .Stopped -> .RuntimeFailure }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:312
pub fn sync_session(state: &BrowserWebState?, session: &ResidentDevSession) -> () Err! {
    cursor := state.as_ref().and_then((state) -> state.host().sequence())
    projection := session.devtools_events_since(cursor)
    canonical_panels := session.devtools_panels(.BrowserInApp, JetDevtoolsPanelCapability.ALL) ?? return .Err("browser panel catalog rejected projection: {err}")
    if state.is_none() -> state = .Val(BrowserWebState.new(projection.session_id.clone()))
    resident := state.as_mut().expect("browser web state initialized")
    resident.tools.source = session.canvas_port() != 0
    resident.tools.source_reason = if resident.tools.source -> .None else .Val(SOURCE_TOOLS_OFF_REASON.to_string())
    resident.sync(projection, canonical_panels)
}
