// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:340
fn object_map(value: &DataTree) -> [String:DataTree] Err! {
    if value == { .Object(fields) -> .Ok(fields.iter().cloned().collect()), _ -> .Err("expected a JSON object") }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:351
pub fn record_dom_snapshot(state: &BrowserWebState?, session_id: String, payload: &[U8]) -> () Err! {
    text := std.str.from_utf8(payload) ?? return .Err("web DOM snapshot body must be UTF-8 JSON")
    root := parse_json_with_limit(text, MAX_REQUEST_BODY_BYTES) ?? return .Err("web DOM snapshot body is not valid bounded JSON")
    object := object_map(root) ?? return .Err("web DOM snapshot must be a JSON object")
    protocol := required_json_string(object, "protocol")?
    if protocol != JET_DEVTOOLS_PROTOCOL -> return .Err("web DOM snapshot protocol does not match jet.devtools.v1")
    if required_json_string(object, "kind")? != "web.dom-snapshot" -> return .Err("web DOM snapshot kind is not web.dom-snapshot")
    rows_value := object.get("state").ok_or("web DOM snapshot must include state")?
    rows := rows_value.as_array() ?? return .Err("web DOM snapshot state must be an array")
    facts: [WebModuleSwapStateFact] := [].with_capacity(rows.len())
    live_value_updates: [WebLiveValueUpdate] := []
    seen: [(String, String):()] := [:] // GATE #4499: composite map keys.
    for raw_row in rows {
        row := object_map(raw_row) ?? return .Err("web DOM snapshot state rows must be objects")
        kind := required_json_string(row, "kind")?
        if kind == "persist_live_value" {
            update := parse_live_value_update(row)?
            if seen.insert((kind.clone(), update.key.clone()), ()).is_some() -> return .Err("web DOM snapshot state keys must be unique per family")
            live_value_updates.push(update)
            continue
        }
        key := required_json_string(row, "key")?
        type_fingerprint := required_json_string(row, "type_fingerprint")?
        identity := row.get("identity").map((value) -> value.as_str().map((s) -> s.to_string()).map_err((_) -> "web DOM island identity must be a string")).transpose()?
        value := parse_dom_state_value(row.get("value").ok_or("web DOM snapshot state row has no value")?)?
        if seen.insert((kind.clone(), key.clone()), ()).is_some() -> return .Err("web DOM snapshot state keys must be unique per family")
        fact := if kind == {
            "signal" -> WebModuleSwapStateFact.Signal(WebSignalFact.new(key, type_fingerprint, value)),
            "store" -> WebModuleSwapStateFact.Store(WebStoreFact.new(key, type_fingerprint, value)),
            "query_cache" -> WebModuleSwapStateFact.QueryCache(WebQueryCacheFact.new(key, type_fingerprint, value)),
            "form_draft" -> WebModuleSwapStateFact.FormDraft(WebFormDraftFact.new(key, type_fingerprint, value)),
            "scroll" -> WebModuleSwapStateFact.Scroll(WebScrollFact.new(key, type_fingerprint, value)),
            "focus" -> WebModuleSwapStateFact.Focus(WebFocusFact.new(key, type_fingerprint, value)),
            "island" -> WebModuleSwapStateFact.Island(WebIslandFact.new(key, identity.ok_or("web DOM island state needs identity")?, type_fingerprint, value)),
            _ -> return .Err("web DOM snapshot has unknown state family `{kind}`")
        }
        facts.push(fact)
    }
    for update in live_value_updates -> jet_observe_live_value_update(update.key, update.type_identity, update.rendered_value.as_deref())
    resident := state.get_or_insert_with(() -> BrowserWebState.new(session_id.to_string()))
    resident.dom_state = facts
    .Ok(())
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:457
fn parse_live_value_update(object: &[String:DataTree]) -> WebLiveValueUpdate Err! {
    keys := object.keys().collect(); keys.sort()
    for field in keys {
        if !["kind", "key", "type_identity", "rendered_value"].contains(field) -> return .Err("web DOM snapshot persist_live_value has unknown field `{field}`")
    }
    if required_json_string(object, "kind")? != "persist_live_value" -> return .Err("web DOM snapshot live value row has the wrong kind")
    key := required_json_string(object, "key")?
    type_identity := required_json_string(object, "type_identity")?
    rendered_value := if object.get("rendered_value") == {
        .Val(.Null) -> .None, .Val(.Text(value)) -> .Val(value.to_string()),
        .Val(_) -> return .Err("web DOM snapshot persist_live_value `rendered_value` must be a string or null"),
        .None -> return .Err("web DOM snapshot persist_live_value has no `rendered_value`")
    }
    .Ok(WebLiveValueUpdate { key: key, type_identity: type_identity, rendered_value: rendered_value })
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:495
fn required_json_string(object: &[String:DataTree], key: String) -> String Err! {
    value := object.get(key).ok_or("web DOM snapshot has no `{key}`")?
    text := value.as_str() ?? return .Err("web DOM snapshot `{key}` must be a string")
    .Ok(text.to_string())
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:510
fn parse_dom_state_value(value: &DataTree) -> WebStateValue Err! {
    object := object_map(value) ?? return .Err("web DOM snapshot state value must be an object")
    kind := required_json_string(object, "kind")?
    if kind == {
        "text" -> .Ok(.Text(required_json_string(object, "value")?)),
        "integer" -> if object.get("value") == { .Val(.Int(value)) -> .Ok(.Integer(value)), _ -> .Err("web DOM integer state value must be a JSON integer") },
        "unsigned" -> if object.get("value") == { .Val(.Int(value)) if value >= 0 -> .Ok(.Unsigned(value as U64)), _ -> .Err("web DOM unsigned state value must be a non-negative integer") },
        "boolean" -> if object.get("value") == { .Val(.Bool(value)) -> .Ok(.Boolean(value)), _ -> .Err("web DOM boolean state value must be a JSON boolean") },
        "bytes" -> {
            raw := object.get("value").ok_or("web DOM bytes state value has no value")?
            values := raw.as_array() ?? return .Err("web DOM bytes state value must be an array")
            bytes: [U8] := [].with_capacity(values.len())
            for value in values {
                if value == { .Int(n) if n >= 0 && n <= 255 -> bytes.push(n as U8), _ -> return .Err("web DOM bytes state value has a non-byte element") }
            }
            .Ok(.Bytes(bytes))
        },
        _ -> .Err("web DOM state value has unknown kind `{kind}`")
    }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:548
pub fn view_json(state: &BrowserWebState, placement: BrowserPlacement) -> String { frame_json(state.frame(placement)) }
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:551
pub fn swap_json(state: &BrowserWebState) -> String {
    output := String.with_capacity(2048)
    output.push('{')
    field_string(&output, "protocol", JET_DEVTOOLS_PROTOCOL, true)
    field_string(&output, "kind", "web.module-swap", false)
    output.push_str(",\"active\":")
    if state.swap.as_ref() == { .Val(swap) -> write_swap_snapshot(&output, swap.active()), .None -> output.push_str("null") }
    output.push_str(",\"committed\":")
    if state.swap.as_ref() == { .Val(swap) -> write_swap_snapshot(&output, swap.committed()), .None -> output.push_str("null") }
    output.push_str(",\"phase\":")
    if state.swap.as_ref() == { .Val(swap) -> quoted(swap.phase().as_str(), &output), .None -> output.push_str("null") }
    output.push_str(",\"last_receipt\":")
    if state.last_swap.as_ref() == { .Val(receipt) -> write_swap_receipt(&output, receipt), .None -> output.push_str("null") }
    output.push_str(",\"error\":")
    if state.swap_error.as_deref() == { .Val(error) -> quoted(error, &output), .None -> output.push_str("null") }
    output.push('}'); output
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:593
pub fn release_json(projection: &DevtoolsProjection, panels: &[JetDevtoolsPanelProjection]) -> String {
    output := String.with_capacity(2048)
    output.push('{')
    field_string(&output, "protocol", projection.protocol, true)
    field_string(&output, "kind", "devtools.release", false)
    field_string(&output, "session_id", projection.session_id, false)
    field_optional_string(&output, "source_id", projection.source_id.as_deref())
    field_optional_string(&output, "build_id", projection.build_id.as_deref())
    field_string(&output, "revision", projection.revision, false)
    field_string(&output, "lifecycle", projection.status.state.as_str(), false)
    field_bool(&output, "read_only", true, false)
    field_bool(&output, "payloads_redacted", true, false)
    output.push_str(",\"panels\":[")
    for (index, panel) in panels.iter().enumerate() {
        if index != 0 -> output.push(',')
        descriptor := panel.availability.descriptor
        output.push('{')
        field_string(&output, "id", descriptor.id.as_str(), true)
        field_string(&output, "title", descriptor.title, false)
        field_bool(&output, "available", panel.availability.is_available(), false)
        output.push_str(",\"capabilities\":[")
        for (capability_index, capability) in descriptor.required_capabilities.iter().enumerate() {
            if capability_index != 0 -> output.push(',')
            quoted(capability.as_str(), &output)
        }
        output.push_str("]}")
    }
    output.push_str("]}"); output
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:645
pub fn apply_web_swap_from_manifest(state: &BrowserWebState?, session_id: String, source_revision: String, build_revision: String, manifest: String, decision: &HotSwapDecision?) -> () Err! {
    dom_state := state.as_ref().map((state) -> state.dom_state.clone()).unwrap_or_default()
    candidate := snapshot_from_manifest(source_revision, build_revision, manifest, dom_state) ?? {
        resident := state.get_or_insert_with(() -> BrowserWebState.new(session_id.to_string()))
        resident.swap_error = .Val(err.clone())
        return .Err(err)
    }
    apply_web_swap_snapshot(state, session_id, candidate, decision)
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:669
pub fn manifest_artifact_identity(manifest: String) -> String Err! {
    value := parse_manifest(manifest)?
    root := object_map(value) ?? return .Err("web manifest must be a JSON object")
    package := required_json_string(root, "package")?
    if package.is_empty() -> return .Err("web manifest package identity is empty")
    artifact_value := root.get("artifact").ok_or("web manifest has no selected artifact")?
    artifact := object_map(artifact_value) ?? return .Err("web manifest artifact must be an object")
    identity := required_json_string(artifact, "artifact_identity")?
    if identity.is_empty() -> return .Err("web manifest artifact identity is empty")
    .Ok(identity)
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:688
fn parse_manifest(manifest: String) -> DataTree Err! {
    root := parse_json_with_limit(manifest, MAX_STATIC_RESPONSE_BYTES as USize) ?? return .Err("web manifest is not valid bounded JSON")
    object := object_map(root) ?? return .Err("web manifest must be a JSON object")
    schema := required_json_string(object, "schema")?
    if schema != "mir-web-v1" -> return .Err("unsupported web manifest schema `{schema}`")
    .Ok(root)
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:699
fn snapshot_from_manifest(source_revision: String, build_revision: String, manifest: String, state: [WebModuleSwapStateFact]) -> WebModuleSwapSnapshot Err! {
    if source_revision.is_empty() || build_revision.is_empty() -> return .Err("web swap requires non-empty source and build revisions")
    value := parse_manifest(manifest)?
    root := object_map(value) ?? return .Err("web manifest must be a JSON object")
    package := required_json_string(root, "package")?
    artifact_value := root.get("artifact").ok_or("web manifest has no selected artifact")?
    artifact := object_map(artifact_value) ?? return .Err("web manifest artifact must be an object")
    artifact_identity := required_json_string(artifact, "artifact_identity")?
    selected_value := artifact.get("modules").ok_or("web manifest artifact has no modules")?
    selected_modules := selected_value.as_array() ?? return .Err("web manifest artifact modules must be an array")
    modules_value := root.get("modules").ok_or("web manifest has no module table")?
    modules := modules_value.as_array() ?? return .Err("web manifest modules must be an array")
    module_facts: [WebModuleFact] := [].with_capacity(selected_modules.len())
    for selected in selected_modules {
        module_id := if selected == { .Int(id) -> id, _ -> return .Err("web manifest module id must be an integer") }
        module_value := modules.iter().find((module) -> {
            object := object_map(module) ?? return false
            if object.get("id") == { .Val(.Int(id)) -> id == module_id, _ -> false }
        }).ok_or("web manifest selected module {module_id} is missing")?
        module := object_map(module_value) ?? return .Err("web manifest module must be an object")
        identity := required_json_string(module, "key")?
        path := required_json_string(module, "path")?
        imports_value := module.get("imports").ok_or("web manifest module has no imports")?
        import_rows := imports_value.as_array() ?? return .Err("web manifest module imports must be an array")
        imports: [String] := []
        for id in import_rows {
            if id == { .Int(n) -> imports.push(n.to_string()), _ -> return .Err("web manifest module import id must be an integer") }
        }
        imports_text := imports.join(",")
        items_value := module.get("item_order").ok_or("web manifest module has no item_order")?
        item_rows := items_value.as_array() ?? return .Err("web manifest module item_order must be an array")
        items: [String] := []
        for item in item_rows {
            text := item.as_str() ?? return .Err("web manifest module item_order entries must be strings")
            items.push(text.to_string())
        }
        item_order := items.join(TEXT_NUL)
        interface_seed := "{identity}{TEXT_NUL}{path}{TEXT_NUL}{imports_text}{TEXT_NUL}{item_order}"
        interface_fingerprint := "sha256-{sha256_hex(interface_seed.as_bytes())}"
        body_seed := "{artifact_identity}{TEXT_NUL}{module_id}{TEXT_NUL}{path}"
        body_fingerprint := "sha256-{sha256_hex(body_seed.as_bytes())}"
        module_facts.push(WebModuleFact.new(identity, interface_fingerprint, body_fingerprint))
    }
    WebModuleSwapSnapshot.new(WebModuleSwapIdentity.new(package, "application"), source_revision, build_revision, WebPageFact.new("application", artifact_identity), module_facts, state).map_err((error) -> "web swap candidate rejected: {error}")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:791
fn apply_web_swap_snapshot(state: &BrowserWebState?, session_id: String, candidate: WebModuleSwapSnapshot, decision: &HotSwapDecision?) -> () Err! {
    resident := state.get_or_insert_with(() -> BrowserWebState.new(session_id.to_string()))
    if resident.swap.is_none() {
        if decision.is_some() {
            error := "web swap decision has no resident snapshot; rebuild was rejected"
            resident.swap_error = .Val(error.clone())
            return .Err(error)
        }
        swap := WebModuleSwapState.new(candidate) ?? return .Err("web swap state rejected: {err}")
