// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1099
INTENT_GROUPS: [(String, [String])] :: [
    ("Build & source", ["build", "gates", "structure", "tests", "jobs"]),
    ("Data & requests", ["routes", "queries", "mutations", "forms", "table", "store", "database"]),
    ("Runtime & interface", ["traces", "cost", "profiler", "ui-tree", "topology", "game", "world"])
]
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1124
fn intent_group(panel_id: String) -> USize { INTENT_GROUPS.iter().position((group) -> group.1.contains(panel_id)).unwrap_or(INTENT_GROUPS.len() - 1) }
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1131
fn panel_available(panel: &BrowserPanelView) -> Bool { !panel.status.starts_with("unavailable") }
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1137
fn unavailable_reason_text(status: String) -> String {
    status.trim_start_matches("unavailable:").split(',').map((reason) -> if reason == {
        "unsupported-host" | "host-kind" -> "not offered by this host".to_string(),
        "missing-capability" -> "needs a grant this session does not hold".to_string(),
        other -> other.to_string()
    }).collect().join(", ")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1151
fn diagnostic_file(diagnostic: String) -> String? {
    rest := diagnostic.split("-->").nth(1)?.trim_start() // #4303
    token := rest.split_whitespace().next()?
    file := token.split(':').next()?
    if file.ends_with(".jet") -> .Val(file) else .None
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1163
pub fn render_page(state: &BrowserWebState, placement: BrowserPlacement) -> String {
    frame := state.frame(placement)
    state_json := frame_json(frame)
    workbench := placement == .Workbench
    selection := frame.selection.as_ref()
    any_open := frame.panels.iter().any((panel) -> panel.open && panel_available(panel))
    html := String.with_capacity(16 * 1024)
    html.push_str("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; connect-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'\"><title>Jet devtools")
    if workbench -> html.push_str(" workbench")
    html.push_str("</title><style>"); html.push_str(PAGE_CSS)
    html.push_str("</style></head><body><main data-schema=\""); html.push_str(BROWSER_PAGE_SCHEMA)
    html.push_str("\" data-placement=\""); html.push_str(placement.as_str())
    html.push_str("\" data-session-id=\""); html.push_str(html_escape(frame.session_id))
    html.push_str("\" data-state=\"")
    state_word := devtools_state_as_str(frame.status.state)
    html.push_str(state_word)
    html.push_str("\"><header class=\"bar\"><span class=\"mark\">")
    html.push_str(include_str("../../../Docs/site/assets/mark.svg")) // GATE #4494: compile-time embedded asset.
    html.push_str("</span><strong>Jet devtools</strong><span class=\"state\"><i class=\"status-mark\" aria-hidden=\"true\"></i>")
    html.push_str(state_word)
    html.push_str("</span><span class=\"grow\"></span><span class=\"note\" role=\"status\"></span>")
    if !workbench -> html.push_str("<a class=\"link\" data-route=\"/__jet_devtools/workbench\">Workbench</a>")
    html.push_str("</header>")
    render_attention(&html, frame); render_source_tool(&html, frame)
    html.push_str("<div class=\"body\"><section class=\"facts\" data-scroll aria-label=\"Facts\">")
    if !workbench -> render_selected(&html, frame)
    for (index, group) in INTENT_GROUPS.iter().enumerate() {
        members := frame.panels.iter().filter((panel) -> intent_group(panel.panel_id) == index).collect()
        if members.is_empty() -> continue
        available_count := members.iter().filter((panel) -> panel_available(panel)).count()
        open_count := members.iter().filter((panel) -> panel.open && panel_available(panel)).count()
        selected_here := selection.is_some_and((selected) -> members.iter().any((panel) -> panel.panel_id == selected.panel_id))
        forced := selected_here || open_count > 0 || (!workbench && index == 0 && (frame.status.state == .Building || frame.status.state == .Error))
        initially_open := forced || (workbench && index == 0 && !any_open && selection.is_none())
        html.push_str("<details class=\"group\" data-intent=\""); html.push_str(index.to_string())
        html.push_str(if forced -> "\" data-active=\"true\"" else "\"")
        if initially_open -> html.push_str(" open")
        html.push_str("><summary data-focus=\"intent:"); html.push_str(index.to_string())
        html.push_str("\"><span class=\"group-label\">"); html.push_str(html_escape(group.0))
        html.push_str("</span><span class=\"group-meta\">")
        if selected_here { html.push_str("Selected") }
        else if open_count > 0 {
            suffix := if available_count == 1 -> "" else "s"
            html.push_str("{open_count} open · {available_count} panel{suffix}")
        } else { html.push_str("{available_count} available") }
        html.push_str("</span></summary><div class=\"group-body\">")
        for panel in members.iter().filter((panel) -> panel_available(panel)) -> render_panel(&html, panel, selection)
        unavailable_count := members.len() - available_count
        if unavailable_count > 0 {
            html.push_str("<details class=\"fold\"><summary>{unavailable_count} not available here</summary>")
            for panel in members.iter().filter((panel) -> !panel_available(panel)) {
                html.push_str("<div class=\"u\"><span>"); html.push_str(html_escape(panel.title))
                html.push_str("</span><small>"); html.push_str(html_escape(unavailable_reason_text(panel.status)))
                html.push_str("</small></div>")
            }
            html.push_str("</details>")
        }
        html.push_str("</div></details>")
    }
    if frame.panels.is_empty() { html.push_str("<p class=\"empty\">Waiting for the first devtools fact.</p>") }
    else if frame.panels.iter().all((panel) -> !panel_available(panel)) { html.push_str("<p class=\"empty\">No live panels are available on this host.</p>") }
    html.push_str("</section>")
    if workbench -> render_inspector(&html, frame)
    html.push_str("</div><script>const S=JSON.parse(\"")
    html.push_str(js_string(state_json)); html.push_str("\");"); html.push_str(PAGE_JS)
    html.push_str("</script></main></body></html>")
    html
}

// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1305
fn render_attention(html: &String, frame: &BrowserDevtoolsFrame) -> {
    status := frame.status
    failing_file := status.diagnostic.as_deref().and_then(diagnostic_file)
    html.push_str("<section class=\"attention\" aria-label=\"Attention\"><h2><i class=\"status-mark\" aria-hidden=\"true\"></i>")
    html.push_str(if status.state == { .Starting -> "Starting", .Building -> "Building", .Ready -> "Ready",
        .Error -> "Build failed", .Unavailable -> "Runtime unavailable", .Stopped -> "Stopped" })
    if status.diagnostic_code == .Val(code) {
        html.push_str("<small class=\"mono\">"); html.push_str(html_escape(code)); html.push_str("</small>")
    }
    if failing_file == .Val(file) {
        html.push_str("<small class=\"mono\">"); html.push_str(html_escape(file)); html.push_str("</small>")
    }
    if status.test_state == .Val(tests) {
        html.push_str("<small>tests "); html.push_str(html_escape(tests)); html.push_str("</small>")
    }
    html.push_str("</h2>")
    if status.diagnostic == .Val(diagnostic) {
        // Verbatim diagnostic (I4), escaped for HTML.
        html.push_str("<pre class=\"diag\">"); html.push_str(html_escape(diagnostic)); html.push_str("</pre>")
    }
    html.push_str("<div class=\"acts\">")
    if frame.tools.source {
        if status.state == .Error {
            html.push_str("<button class=\"btn primary\" type=\"button\" data-tool=\"source\" data-focus=\"tool:source\"")
            if failing_file == .Val(file) {
                html.push_str(" data-file=\""); html.push_str(html_escape(file)); html.push('"')
            }
            html.push_str(">Fix in source</button>")
        } else { html.push_str("<button class=\"btn\" type=\"button\" data-tool=\"source\" data-focus=\"tool:source\">Source</button>") }
    }
    if frame.tools.rebuild -> html.push_str("<button class=\"btn\" type=\"button\" data-tool=\"rebuild\" data-focus=\"tool:rebuild\">Rebuild</button>")
    html.push_str("<span class=\"receipt\" role=\"status\"></span><span class=\"result\" role=\"status\"></span>")
    reasons: [String] := []
    if frame.tools.source_reason.as_deref() == .Val(reason) -> reasons.push(reason)
    if !frame.tools.rebuild && frame.tools.rebuild_reason.as_deref() == .Val(reason) -> reasons.push(reason)
    if !reasons.is_empty() {
        html.push_str("<span class=\"why\">"); html.push_str(html_escape(reasons.join(" "))); html.push_str("</span>")
    }
    html.push_str("</div></section>")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1376
fn render_source_tool(html: &String, frame: &BrowserDevtoolsFrame) -> {
    if !frame.tools.source -> return
    html.push_str("<section class=\"source\" aria-label=\"Source\" hidden><header><select aria-label=\"Source file\"></select><span class=\"rev\"></span><span class=\"grow\"></span><button class=\"btn quiet\" type=\"button\" data-refresh hidden>Facts changed — refresh</button><button class=\"btn quiet\" type=\"button\" data-src=\"close\">Close</button></header><textarea spellcheck=\"false\" autocapitalize=\"off\" autocomplete=\"off\" aria-label=\"Source text\" data-focus=\"tool:source-text\"></textarea><footer><button class=\"btn\" type=\"button\" data-src=\"check\">Check</button><button class=\"btn primary\" type=\"button\" data-src=\"apply\" disabled>Apply</button><button class=\"btn quiet\" type=\"button\" data-src=\"discard\" hidden>Discard draft</button><span class=\"result\" role=\"status\"></span></footer><pre class=\"out\" hidden></pre></section>")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1388
fn render_panel(html: &String, panel: &BrowserPanelView, selection: &BrowserSelection?) -> {
    node_id := selection.filter((selection) -> selection.panel_id == panel.panel_id).and_then((selection) -> selection.node_id.as_deref())
    html.push_str("<article class=\"panel\" data-panel-id=\""); html.push_str(html_escape(panel.panel_id))
    html.push_str("\" data-open=\""); html.push_str(if panel.open -> "true" else "false")
    html.push_str("\"><header><h2><button class=\"toggle\" data-layout=\""); html.push_str(if panel.open -> "close" else "open")
    html.push_str("\" data-panel=\""); html.push_str(html_escape(panel.panel_id))
    html.push_str("\" data-focus=\"toggle:"); html.push_str(html_escape(panel.panel_id))
    html.push_str("\" aria-expanded=\""); html.push_str(if panel.open -> "true" else "false")
    html.push_str("\"><span class=\"chev\"></span>"); html.push_str(html_escape(panel.title))
    html.push_str("</button></h2><small>"); html.push_str(html_escape(panel.status)); html.push_str("</small></header>")
    if panel.open {
        html.push_str("<ul class=\"nodes\">"); render_nodes_html(html, panel.panel_id, panel.nodes, node_id); html.push_str("</ul>")
    }
    html.push_str("</article>")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1418
fn render_selected(html: &String, frame: &BrowserDevtoolsFrame) -> {
    selection := frame.selection.as_ref() ?? return
    panel := frame.panels.iter().find((panel) -> panel.panel_id == selection.panel_id) ?? return
    path: [&BrowserNode] := []
    node := selection.node_id.as_deref().filter((node_id) -> find_path(panel.nodes, node_id, &path)).and_then((_) -> path.last().copied())
    html.push_str("<section class=\"selected\" aria-label=\"Selected\"><div class=\"eyebrow\">Selected fact</div>")
    render_crumbs(html, panel, path)
    if node == { .Val(node) -> render_node_detail(html, panel.panel_id, node),
        .None -> { html.push_str("<h3>"); html.push_str(html_escape(panel.title)); html.push_str("</h3>") } }
    html.push_str("</section>")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1448
fn render_crumbs(html: &String, panel: &BrowserPanelView, path: &[&BrowserNode]) -> {
    html.push_str("<div class=\"crumbs\"><span>"); html.push_str(html_escape(panel.title)); html.push_str("</span>")
    for ancestor in path.iter().take(path.len().saturating_sub(1)) {
        html.push_str("<span>›</span><button data-select=\"1\" data-panel=\""); html.push_str(html_escape(panel.panel_id))
        html.push_str("\" data-node=\""); html.push_str(html_escape(ancestor.id))
        html.push_str("\">"); html.push_str(html_escape(ancestor.label)); html.push_str("</button>")
    }
    html.push_str("<span class=\"grow\"></span><button class=\"btn quiet\" type=\"button\" data-clear=\"1\" data-focus=\"clear\">Clear</button></div>")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1466
fn render_node_detail(html: &String, panel_id: String, node: &BrowserNode) -> {
    html.push_str("<h3>"); html.push_str(html_escape(node.label))
    if node.status == .Val(status) { html.push_str(" <small class=\"mono\">"); html.push_str(html_escape(status)); html.push_str("</small>") }
    html.push_str("</h3>")
    if node.value == .Val(value) { html.push_str("<code class=\"value\">"); html.push_str(html_escape(value)); html.push_str("</code>") }
    (leaves, trees) := node.children.iter().partition((child) -> child.children.is_empty() && child.value.is_some())
    if !leaves.is_empty() {
        html.push_str("<dl class=\"kv\">")
        for leaf in leaves {
            html.push_str("<dt>"); html.push_str(html_escape(leaf.label))
            html.push_str("</dt><dd>"); html.push_str(html_escape(leaf.value.as_deref().unwrap_or(""))); html.push_str("</dd>")
        }
        html.push_str("</dl>")
    }
    if !trees.is_empty() {
        html.push_str("<ul class=\"nodes\">")
        owned := trees.into_iter().cloned().collect()
        render_nodes_html(html, panel_id, owned, .None)
        html.push_str("</ul>")
    }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1505
fn render_inspector(html: &String, frame: &BrowserDevtoolsFrame) -> {
    html.push_str("<aside class=\"inspector\" data-scroll aria-label=\"Inspector\">")
    selection := frame.selection.as_ref() ?? { html.push_str("<p class=\"empty\">Select a fact to inspect it.</p></aside>"); return }
    panel := frame.panels.iter().find((panel) -> panel.panel_id == selection.panel_id) ?? {
        html.push_str("<p class=\"empty\">Selected panel is not in the current catalog.</p></aside>"); return
    }
    path: [&BrowserNode] := []
    node := selection.node_id.as_deref().filter((node_id) -> find_path(panel.nodes, node_id, &path)).and_then((_) -> path.last().copied())
    render_crumbs(html, panel, path)
    if node == {
        .Val(node) -> render_node_detail(html, panel.panel_id, node),
        .None -> {
            html.push_str("<h3>"); html.push_str(html_escape(panel.title))
            html.push_str("</h3><dl class=\"kv\"><dt>status</dt><dd>"); html.push_str(html_escape(panel.status))
            html.push_str("</dd><dt>facts</dt><dd>{panel.nodes.len()}</dd></dl>")
        }
    }
    html.push_str("</aside>")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1547
fn find_path(nodes: &[BrowserNode], node_id: String, path: &[&BrowserNode]) -> Bool {
    for node in nodes {
        path.push(node)
        if node.id == node_id || find_path(node.children, node_id, path) -> return true
        _ :: path.pop()
    }
    false
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1558
fn panel_from_projection(panel: &JetDevtoolsPanelProjection) -> BrowserPanelFact {
    descriptor := panel.availability.descriptor
    status := if panel.availability.is_available() {
        panel.events.last().map((event) -> event.kind().to_string()).unwrap_or_else(() -> "available".to_string())
    } else {
        reasons := panel.availability.unavailable_reasons().iter().map((reason) -> reason.as_str()).collect().join(",")
        "unavailable:{reasons}"
    }
    status = bounded_text(status, "unavailable", MAX_BROWSER_TEXT)
    nodes: [BrowserNode] := [].with_capacity(panel.events.len().max(1))
    for event in panel.events {
        prefix := "event:{event.sequence()}"
        children := [
            BrowserNode.new("{prefix}:source", .Text, "source").with_value(bounded_value(event.source())),
            BrowserNode.new("{prefix}:kind", .Text, "kind").with_value(bounded_value(event.kind())),
            BrowserNode.new("{prefix}:entity", .Text, "entity").with_value(bounded_value(event.entity())),
            BrowserNode.new("{prefix}:fields", .Text, "fields").with_value(bounded_value(event.fields_json())),
            BrowserNode.new("{prefix}:payload", .Text, "payload").with_value(bounded_value(event.payload_json().unwrap_or("(absent)")))
        ]
        label := bounded_text(event.entity(), event.kind(), MAX_BROWSER_TEXT)
        nodes.push(BrowserNode.new(prefix, .Tree, label).with_status(bounded_text(event.kind(), "event", MAX_BROWSER_TEXT)).with_children(children))
    }
    if nodes.is_empty() -> nodes.push(BrowserNode.new("availability", .Status, "availability").with_status(status.clone()))
    BrowserPanelFact.new(descriptor.id.as_str(), descriptor.title, 0, status, nodes).with_cursor(panel.cursor)
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1620
fn parse_revision(value: String) -> U64? { value.parse<U64>().ok() }
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1624
fn bounded_text(value: String, fallback: String, limit: USize) -> String {
    source := if value.is_empty() -> fallback else value
    output := String.new()
    for raw_character in source.chars() {
        character := if raw_character.is_control() -> ' ' else raw_character
        if output.len() + character.len_utf8() > limit -> break
        output.push(character)
    }
    if output.is_empty() -> fallback.to_string() else output
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1645
fn bounded_value(value: String) -> String { bounded_text(value, "(none)", MAX_BROWSER_VALUE) }

// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1649
fn frame_json(frame: &BrowserDevtoolsFrame) -> String {
    output := String.with_capacity(4096)
    output.push('{')
    field_string(&output, "schema", BROWSER_PAGE_SCHEMA, true)
    field_string(&output, "protocol", frame.protocol, false)
    field_string(&output, "placement", frame.placement.as_str(), false)
    field_string(&output, "route", frame.route, false)
    field_string(&output, "session_id", frame.session_id, false)
    field_optional_string(&output, "source_id", frame.source_id.as_deref())
    field_optional_string(&output, "build_id", frame.build_id.as_deref())
    field_string(&output, "revision", frame.revision, false)
    field_optional_string(&output, "world_id", frame.world_id.as_deref())
    field_u64_option(&output, "sequence", frame.sequence)
    field_u64_option(&output, "cursor", frame.cursor.map((cursor) -> cursor.sequence))
    field_string(&output, "state", frame.state.as_str(), false)
    output.push_str(",\"status\":"); status_json(&output, frame.status)
    output.push_str(",\"tools\":{\"source\":{")
    field_bool(&output, "available", frame.tools.source, true)
    field_optional_string(&output, "reason", frame.tools.source_reason.as_deref())
    output.push_str("},\"rebuild\":{")
    field_bool(&output, "available", frame.tools.rebuild, true)
    field_optional_string(&output, "reason", frame.tools.rebuild_reason.as_deref())
    output.push_str("}},\"receipts\":[")
    for (index, receipt) in frame.receipts.iter().enumerate() {
        if index != 0 -> output.push(',')
        output.push('{')
        field_u64(&output, "sequence", receipt.sequence, true)
        field_string(&output, "request_id", receipt.request_id, false)
        field_string(&output, "kind", receipt.kind, false)
        field_string(&output, "status", receipt.status, false)
        field_optional_string(&output, "error", receipt.error.as_deref())
        output.push('}')
    }
    output.push_str("],\"selection\":")
    if frame.selection.as_ref() == {
        .Val(selection) -> {
            output.push('{'); field_string(&output, "panel_id", selection.panel_id, true)
            field_optional_string(&output, "node_id", selection.node_id.as_deref()); output.push('}')
        },
        .None -> output.push_str("null")
    }
    output.push_str(",\"panels\":[")
    for (index, panel) in frame.panels.iter().enumerate() {
        if index != 0 -> output.push(',')
        output.push('{')
        field_string(&output, "panel_id", panel.panel_id, true)
        field_string(&output, "title", panel.title, false)
        field_u64(&output, "freshness_ms", panel.freshness_ms, false)
        field_string(&output, "status", panel.status, false)
        field_u64_option(&output, "cursor", panel.cursor)
        field_bool(&output, "open", panel.open, false)
        field_string(&output, "dock", panel.dock.as_str(), false)
        output.push_str(",\"nodes\":["); write_nodes_json(&output, panel.nodes); output.push_str("]}")
    }
    output.push_str("],\"elements\":[")
    for (index, element) in frame.elements.iter().enumerate() {
        if index != 0 -> output.push(',')
        output.push('{')
        field_string(&output, "id", element.id, true)
        field_string(&output, "kind", element.kind, false)
        field_optional_string(&output, "panel_id", element.panel_id.as_deref())
        field_optional_string(&output, "node_id", element.node_id.as_deref())
        field_string(&output, "label", element.label, false)
        field_optional_string(&output, "value", element.value.as_deref())
        field_optional_string(&output, "status", element.status.as_deref())
        output.push('}')
    }
    output.push_str("]}"); output
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1740
fn status_json(output: &String, status: &DevtoolsStatusFact) -> {
    output.push('{')
    field_string(output, "state", devtools_state_as_str(status.state), true)
    field_optional_string(output, "diagnostic_code", status.diagnostic_code.as_deref())
    field_optional_string(output, "diagnostic", status.diagnostic.as_deref())
    field_optional_string(output, "accepted_revision", status.accepted_revision.as_deref())
    field_optional_string(output, "last_good_revision", status.last_good_revision.as_deref())
    field_optional_string(output, "run_target", status.run_target.as_deref())
    field_optional_string(output, "run_output", status.run_output.as_deref())
    field_optional_string(output, "test_state", status.test_state.as_deref())
    output.push('}')
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1761
fn devtools_state_as_str(state: DevtoolsSessionState) -> String {
    if state == { .Starting -> "starting", .Building -> "building", .Ready -> "ready", .Error -> "error", .Unavailable -> "unavailable", .Stopped -> "stopped" }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1772
fn write_nodes_json(output: &String, nodes: &[BrowserNode]) -> {
    for (index, node) in nodes.iter().enumerate() {
        if index != 0 -> output.push(',')
        output.push('{')
        field_string(output, "id", node.id, true)
        field_string(output, "kind", node.kind.as_str(), false)
        field_string(output, "label", node.label, false)
        field_optional_string(output, "value", node.value.as_deref())
        field_optional_string(output, "status", node.status.as_deref())
        output.push_str(",\"children\":["); write_nodes_json(output, node.children); output.push_str("]}")
    }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1789
fn field_string(output: &String, key: String, value: String, first: Bool) -> {
    if !first -> output.push(',')
    quoted(key, output); output.push(':'); quoted(value, output)
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1798
fn field_optional_string(output: &String, key: String, value: String?) -> {
    output.push(','); quoted(key, output); output.push(':')
    if value == { .Val(value) -> quoted(value, output), .None -> output.push_str("null") }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1808
fn field_u64_option(output: &String, key: String, value: U64?) -> {
    output.push(','); quoted(key, output); output.push(':')
    if value == { .Val(value) -> output.push_str(value.to_string()), .None -> output.push_str("null") }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1818
fn field_u64(output: &String, key: String, value: U64, first: Bool) -> {
    if !first -> output.push(',')
    quoted(key, output); output.push(':'); output.push_str(value.to_string())
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1827
fn field_bool(output: &String, key: String, value: Bool, first: Bool) -> {
    if !first -> output.push(',')
    quoted(key, output); output.push(':'); output.push_str(if value -> "true" else "false")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1836
fn quoted(value: String, output: &String) -> { output.push('"'); output.push_str(json_escape(value)); output.push('"') }
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1844
pub fn reconnect_json(state: &BrowserWebState, from: U64?, reset: Bool, truncation: Bool) -> String Err! {
    output := String.with_capacity(4096)
    output.push('{')
    field_string(&output, "schema", BROWSER_PAGE_SCHEMA, true)
    field_string(&output, "protocol", JET_DEVTOOLS_PROTOCOL, false)
    field_string(&output, "session_id", state.host().session_id(), false)
    field_u64_option(&output, "from", from)
    field_u64_option(&output, "cursor", state.host().sequence())
    field_bool(&output, "reset", reset, false)
    field_bool(&output, "truncation", truncation, false)
    field_bool(&output, "complete", !truncation, false)
    output.push_str(",\"events\":[")
    if !truncation {
        replay := state.host().resume_from(from.map(BrowserReconnectCursor.new)) ?? return .Err(err.to_string())
        for (index, event) in replay.events.iter().enumerate() {
            if index != 0 -> output.push(',')
            event_json(&output, event)
        }
    }
    output.push_str("],\"view\":"); output.push_str(view_json(state, .Workbench)); output.push('}')
    .Ok(output)
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1890
fn event_json(output: &String, event: &BrowserHostEvent) -> {
    output.push('{')
    field_string(output, "protocol", event.protocol, true)
    field_string(output, "session_id", event.session_id, false)
    field_u64(output, "revision", event.revision, false)
    field_u64(output, "sequence", event.sequence, false)
    field_u64(output, "observed_at_ms", event.observed_at_ms, false)
    output.push_str(",\"panels\":[")
    for (index, panel) in event.panels.iter().enumerate() {
        if index != 0 -> output.push(',')
        panel_json(output, panel)
    }
    output.push_str("]}")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1907
fn panel_json(output: &String, panel: &BrowserPanelFact) -> {
    output.push('{')
    field_string(output, "panel_id", panel.panel_id, true)
    field_string(output, "title", panel.title, false)
    field_u64(output, "freshness_ms", panel.freshness_ms, false)
    field_string(output, "status", panel.status, false)
    field_u64_option(output, "cursor", panel.cursor)
    output.push_str(",\"nodes\":["); write_nodes_json(output, panel.nodes); output.push_str("]}")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1922
pub fn parse_selection(payload: &[U8]) -> (String, String?)? Err! {
    text := std.str.from_utf8(payload) ?? return .Err("browser selection body must be UTF-8 JSON")
    root := parse_json_with_limit(text, MAX_REQUEST_BODY_BYTES) ?? return .Err("browser selection body is not valid bounded JSON")
    object := object_map(root) ?? return .Err("browser selection body must be an object")
    selection_value := object.get("selection").ok_or("browser selection body must include selection")?
    if selection_value == .Null -> return .Ok(.None)
    selection := object_map(selection_value) ?? return .Err("browser selection must be an object or null")
    panel_value := selection.get("panel_id").ok_or("browser selection must include panel_id")?
    panel_id := panel_value.as_str() ?? return .Err("browser selection panel_id must be a string")
    if panel_id.is_empty() -> return .Err("browser selection panel_id must not be empty")
    item_key := if selection.get("item_key") == {
        .None | .Val(.Null) -> .None,
        .Val(value) -> {
            key := value.as_str() ?? return .Err("browser selection item_key must be a string")
            .Val(key.to_string())
        }
    }
    .Ok(.Val((panel_id.to_string(), item_key)))
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:1959
pub fn parse_action(payload: &[U8], default_placement: BrowserPlacement) -> BrowserHostAction Err! {
    text := std.str.from_utf8(payload) ?? return .Err("browser action body must be UTF-8 JSON")
    root := parse_json_with_limit(text, MAX_REQUEST_BODY_BYTES) ?? return .Err("browser action body is not valid bounded JSON")
    object := object_map(root) ?? return .Err("browser action body must be an object")
    name := required_string(object, "action").or_else((_) -> required_string(object, "op"))?
    placement := object.get("placement").map(parse_placement).transpose()?.unwrap_or(default_placement)
    if name == {
        "open" | "open_panel" -> .Ok(BrowserHostAction.open(placement, required_string(object, "panel_id")?)),
        "close" | "close_panel" -> .Ok(BrowserHostAction.close(placement, required_string(object, "panel_id")?)),
        "dock" | "dock_panel" -> .Ok(BrowserHostAction.dock(placement, required_string(object, "panel_id")?, parse_dock(required_string(object, "dock")?)?)),
        "navigate_source" | "navigate" -> .Ok(BrowserHostAction.navigate_source(placement, required_string(object, "panel_id")?, required_string(object, "node_id")?, parse_source_grant(object)?)),
        "invoke_action" | "invoke" -> {
            action_id := required_string(object, "action_id")?
            .Ok(BrowserHostAction.invoke_action(placement, required_string(object, "panel_id")?, required_string(object, "node_id")?, action_id, parse_action_grant(object)?))
        },
        _ -> .Err("unknown browser action `{name}`")
    }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2009
fn parse_source_grant(object: &[String:DataTree]) -> BrowserSourceGrant Err! {
    grant := nested_object(object, "grant")?
    source := nested_object(grant, "source")?
    function := optional_string(source, "function")
    location := BrowserSourceLocation.new(required_string(source, "source_id")?, required_u32(source, "line")?, optional_u32(source, "column").unwrap_or(0), function.map((s) -> s.to_string()))
    .Ok(BrowserSourceGrant.new(required_string(grant, "session_id")?, required_u64(grant, "revision")?, required_string(grant, "panel_id")?, required_string(grant, "node_id")?, location))
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2028
fn parse_action_grant(object: &[String:DataTree]) -> BrowserActionGrant Err! {
    grant := nested_object(object, "grant")?
    .Ok(BrowserActionGrant.new(required_string(grant, "session_id")?, required_u64(grant, "revision")?, required_string(grant, "panel_id")?, required_string(grant, "node_id")?, required_string(grant, "action_id")?))
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2039
fn nested_object(object: &[String:DataTree], key: String) -> [String:DataTree] Err! {
    value := object.get(key).ok_or("browser action is missing `{key}`")?
    object_map(value).map_err((_) -> "browser action `{key}` must be an object")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2049
fn required_string(object: &[String:DataTree], key: String) -> String Err! {
    value := object.get(key).ok_or("browser action is missing `{key}`")?
    value.as_str().map_err((_) -> "browser action `{key}` must be a string")
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2060
fn optional_string(object: &[String:DataTree], key: String) -> String? { object.get(key).and_then((value) -> value.as_str().ok()) }
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2064
fn required_u64(object: &[String:DataTree], key: String) -> U64 Err! {
    if object.get(key) == { .Val(.Int(value)) if value >= 0 -> U64.try_from(value).map_err((_) -> "browser action `{key}` is out of range"),
        _ -> .Err("browser action `{key}` must be a non-negative integer") }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2075
fn required_u32(object: &[String:DataTree], key: String) -> U32 Err! {
    required_u64(object, key).and_then((value) -> U32.try_from(value).map_err((_) -> "browser action `{key}` is out of range"))
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2081
fn optional_u32(object: &[String:DataTree], key: String) -> U32? {
    object.get(key).and_then((value) -> if value == { .Int(n) if n >= 0 -> U32.try_from(n).ok(), _ -> .None })
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2088
fn parse_placement(value: &DataTree) -> BrowserPlacement Err! {
    text := value.as_str() ?? return .Err("browser action placement must be a string")
    if text == { "in-app" | "in_app" -> .Ok(.InApp), "workbench" -> .Ok(.Workbench), _ -> .Err("unknown browser placement `{text}`") }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2099
fn parse_dock(value: String) -> BrowserDock Err! {
    if value == { "left" -> .Ok(.Left), "right" -> .Ok(.Right), "bottom" -> .Ok(.Bottom), "floating" -> .Ok(.Floating), _ -> .Err("unknown browser dock `{value}`") }
}

// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2109
fn effect_json(effect: &BrowserHostEffect) -> String {
    output := String.from("{\"schema\":\"")
    output.push_str(BROWSER_PAGE_SCHEMA); output.push_str("\",\"effect\":")
    if effect == {
        .PanelOpened { placement, panel_id } -> {
            output.push_str("{\"kind\":\"panel-opened\",\"placement\":"); quoted(placement.as_str(), &output)
            field_string(&output, "panel_id", panel_id, false)
        },
        .PanelClosed { placement, panel_id } -> {
            output.push_str("{\"kind\":\"panel-closed\",\"placement\":"); quoted(placement.as_str(), &output)
            field_string(&output, "panel_id", panel_id, false)
        },
        .PanelDocked { placement, panel_id, dock } -> {
            output.push_str("{\"kind\":\"panel-docked\",\"placement\":"); quoted(placement.as_str(), &output)
            field_string(&output, "panel_id", panel_id, false); field_string(&output, "dock", dock.as_str(), false)
        },
        .SourceNavigated { placement, panel_id, node_id, source } -> {
            output.push_str("{\"kind\":\"source-navigated\",\"placement\":"); quoted(placement.as_str(), &output)
            field_string(&output, "panel_id", panel_id, false); field_string(&output, "node_id", node_id, false)
            output.push_str(",\"source\":{")
            field_string(&output, "source_id", source.source_id, true)
            field_u64(&output, "line", source.line as U64, false)
            field_u64(&output, "column", source.column as U64, false)
            field_optional_string(&output, "function", source.function.as_deref())
            output.push('}')
        },
        .ActionInvoked { placement, panel_id, node_id, action_id } -> {
            output.push_str("{\"kind\":\"action-invoked\",\"placement\":"); quoted(placement.as_str(), &output)
            field_string(&output, "panel_id", panel_id, false); field_string(&output, "node_id", node_id, false)
            field_string(&output, "action_id", action_id, false)
        }
    }
    output.push_str("}}"); output
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2183
pub fn dispatch_action(state: &BrowserWebState, action: BrowserHostAction) -> String BrowserHostError! {
    state.host.dispatch(action).map((effect) -> effect_json(effect))
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2197
fn render_nodes_html(output: &String, panel_id: String, nodes: &[BrowserNode], selected: String?) -> {
    for node in nodes {
        is_selected := selected == .Val(node.id.as_str())
        holds := contains_node(node.children, selected)
        output.push_str("<li data-selected=\""); output.push_str(if is_selected || holds -> "true" else "false")
        output.push_str("\"><button class=\"node\" data-select=\"1\" data-panel=\""); output.push_str(html_escape(panel_id))
        output.push_str("\" data-node=\""); output.push_str(html_escape(node.id))
        output.push_str("\" data-focus=\"node:"); output.push_str(html_escape(panel_id))
        output.push(':'); output.push_str(html_escape(node.id))
        output.push_str("\" aria-pressed=\""); output.push_str(if is_selected -> "true" else "false")
        output.push_str("\"><span class=\"lbl\">"); output.push_str(html_escape(node.label)); output.push_str("</span>")
        if node.status == .Val(status) { output.push_str("<b>"); output.push_str(html_escape(status)); output.push_str("</b>") }
        output.push_str("</button></li>")
    }
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2234
fn contains_node(nodes: &[BrowserNode], node_id: String?) -> Bool {
    id := node_id ?? return false
    nodes.iter().any((node) -> node.id == id || contains_node(node.children, .Val(id)))
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2243
fn html_escape(value: String) -> String {
    output := String.with_capacity(value.len())
    for character in value.chars() {
        if character == {
            '&' -> output.push_str("&amp;"), '<' -> output.push_str("&lt;"), '>' -> output.push_str("&gt;"),
            '"' -> output.push_str("&quot;"), '\'' -> output.push_str("&#39;"),
            c if c.is_control() -> output.push(' '), c -> output.push(c)
        }
    }
    output
}
// Rust: crates/jet-devserver/src/BrowserWebAdapter.rs:2259
fn js_string(value: String) -> String {
    output := String.with_capacity(value.len())
    for character in value.chars() {
        if character == {
            '\\' -> output.push_str("\\\\"), '"' -> output.push_str("\\\""),
            '\n' -> output.push_str("\\n"), '\r' -> output.push_str("\\r"), '\t' -> output.push_str("\\t"),
            '\u{2028}' -> output.push_str("\\u2028"), '\u{2029}' -> output.push_str("\\u2029"),
            '<' -> output.push_str("\\u003c"), '>' -> output.push_str("\\u003e"), '&' -> output.push_str("\\u0026"),
            c if c.is_control() -> {
                output.push_str("\\u"); output.push_str((c as U32).to_radix(16).pad_start(4, '0'))
            },
            c -> output.push(c)
        }
    }
    output
}

