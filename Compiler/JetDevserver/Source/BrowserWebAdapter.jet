    })?
    swap := resident.swap.as_mut().expect("web swap state initialized")
    plan := WebModuleSwapPlan.from_hot_swap_decision(swap.committed(), candidate, canonical_decision) ?? return .Err("web swap plan rejected: {err}")
    receipt := swap.apply_decision(plan) ?? {
        resident.swap_error = .Val(err.to_string())
        return .Err("web swap transaction rejected: {err}")
    }
    resident.last_swap = .Val(receipt); resident.swap_error = .None
