fn write_string_array(output: &String, key: String, values: &[String]) -> {
    output.push(','); quoted(key, output); output.push_str(":[")
    for (index, value) in values.iter().enumerate() {
        if index != 0 -> output.push(',')
        quoted(value, output)
    }
    output.push(']')
