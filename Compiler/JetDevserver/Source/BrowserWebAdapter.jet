//RS function renderReceipt(list){const r=(list||[]).filter((x)=>x.kind==='ProjectRebuild').pop();if(!receiptEl)return;if(!r){receiptEl.textContent='';receiptEl.removeAttribute('data-status');return}receiptEl.dataset.status=r.status;receiptEl.textContent=(receiptText[r.status]||r.status)+(r.error?': '+r.error:'')}
