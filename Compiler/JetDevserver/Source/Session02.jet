    // Rust: crates/jet-devserver/src/Session.rs:2137
    pub fn json(self: &Self) -> String {
        current :: ~*self.current_revision.lock().unwrap()
        accepted :: ~*self.accepted_revision.lock().unwrap()
        last_good :: ~*self.last_good_revision.lock().unwrap()
        program :: ~*self.last_good_program.lock().unwrap()
        state :: ~*self.state.lock().unwrap()
        diagnostic_code :: ~*self.diagnostic_code.lock().unwrap()
        diagnostic :: ~*self.diagnostic.lock().unwrap()
        diagnostic_revision :: ~*self.diagnostic_revision.lock().unwrap()
        selected_source_id :: ~*self.selected_source_id.lock().unwrap()
        output :: ~*self.selected_output.lock().unwrap()
        target :: ~*self.selected_target.lock().unwrap()
        debugger :: ~*self.debugger.lock().unwrap()
        tests :: ~*self.test_state.lock().unwrap()
        views :: ~*self.last_good_views.lock().unwrap()
        live_lineage :: ~*self.live_lineage.lock().unwrap()
        live_values :: ~*self.live_values.lock().unwrap()
        (live_protocol, live_session_id, live_source_id, live_build_id, live_revision, live_world_id) :: live_lineage.as_ref().map((lineage) ->
            (json_value(lineage.protocol), json_value(lineage.session_id), json_value(lineage.source_id), json_value(lineage.build_id),
                json_value(lineage.revision), json_value(lineage.world_id))).unwrap_or(("null", "null", "null", "null", "null", "null"))
        live_values_json :: live_values.iter().map(live_value_fact_json).collect::<[String]>().join(",")
        now :: Instant.now()
        client_state :: self.clients.lock().unwrap()
        expire_clients(&client_state, now)
        clients :: client_state.len()
        listener_entries: [String] := []
        if self.canvas_port != 0 {
            listener_entries.push("\"canvas\":{{\"host\":{json_value(self.canvas_host)},\"port\":{self.canvas_port},\"transport\":\"canvas\",\"listener\":\"canvas\",\"shared\":false}}")
        }
        if self.application_port != 0 {
            listener_entries.push("\"application\":{{\"host\":{json_value(self.application_host)},\"port\":{self.application_port},\"transport\":\"application\",\"listener\":\"application\",\"routes\":\"application-owned\",\"shared\":false}}")
        }
        listeners :: "{{{listener_entries.join(",")}}}"
        custom_server_listener :: if self.application_port != 0 -> "\"application\"" else -> "null"
        receipts :: self.receipts.lock().unwrap().iter().map((receipt) -> {
            live :: receipt.live.as_ref().map(live_receipt_json).unwrap_or("null")
            "{{\"kind\":{json_value(receipt.kind)},\"status\":{json_value(receipt.status)},\"before\":{json_value(receipt.before)},\"after\":{json_value(receipt.after)},\"client\":{json_value(receipt.client)},\"output\":{json_value(receipt.output)},\"live\":{live}}}"
        }).collect::<[String]>().join(",")
        "{{\"id\":{json_value(self.id)},\"protocol\":{live_protocol},\"session_id\":{live_session_id},\"source_id\":{live_source_id},\"build_id\":{live_build_id},\"revision\":{live_revision},\"world_id\":{live_world_id},\"values\":[{live_values_json}],\"entry\":{json_value(self.entry)},\"project_context\":{{\"source_id\":{json_value(selected_source_id)}}},\"source_revision\":{json_value(current)},\"accepted_revision\":{json_value(accepted)},\"last_good_revision\":{json_value(last_good)},\"last_good_program\":{json_value(program)},\"state\":{json_value(state)},\"diagnostic_code\":{json_value(diagnostic_code)},\"diagnostic\":{json_value(diagnostic)},\"diagnostic_revision\":{json_value(diagnostic_revision)},\"last_good_views\":{{\"graph\":{retained_view_json(views.get("graph"))},\"debugger\":{retained_view_json(views.get("debugger"))},\"runtime\":{retained_view_json(views.get("runtime"))}}},\"clients\":{clients},\"run\":{{\"output\":{json_value(output)},\"target\":{json_value(target)}}},\"debugger\":{{\"state\":{json_value(debugger.state)},\"session_id\":{json_value(debugger.session_id)},\"source_id\":{json_value(debugger.source_id)},\"revision\":{json_value(debugger.revision)},\"tier\":{json_value(debugger.tier)}}},\"tests\":{{\"state\":{json_value(tests)}}},\"history\":{{\"count\":{self.receipts.lock().unwrap().len()},\"receipts\":[{receipts}]}},\"listeners\":{listeners},\"custom_servers\":{{\"owner\":\"application\",\"transport\":\"application\",\"reload\":\"source-transaction\",\"listener\":{custom_server_listener}}}}}"
    }
    // Rust: crates/jet-devserver/src/Session.rs:2270
    fn push_receipt(self: &Self, receipt: Receipt) -> Unit {
        receipts :: self.receipts.lock().unwrap()
        receipts.push(^receipt)
        if receipts.len() > MAX_RECEIPTS -> receipts.remove(0)
    }
    // Rust: crates/jet-devserver/src/Session.rs:2280
    pub fn install_devtools_event_sink(self: &Arc<Self>) -> JetDevtoolsEventSinkGuard {
        // GATE #4494: scoped Arc-backed callback registration.
        sink: Arc<JetDevtoolsEventSink> :: self.clone()
        jet_foundation.Devtools.jet_devtools_install_event_sink(^sink)
    }
    // Rust: crates/jet-devserver/src/Session.rs:2288
    fn drop(self: &Self) -> Unit {
        jet_foundation.DevtoolsControl.jet_devtools_clear_commands(self.id)
        _ :: jet_foundation.Devtools.jet_devtools_clear_game_control_relays()
    }
}
