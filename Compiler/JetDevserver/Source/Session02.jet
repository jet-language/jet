impl RecordIndexCaptureSink for ResidentDevSession {
    type Error = String
    // Rust: crates/jet-devserver/src/Session.rs:2310
    fn record_capture_start(self: &Self, fact: &CaptureStartFact) -> Unit Err! { ResidentDevSession.record_capture_start(self, fact) }
    // Rust: crates/jet-devserver/src/Session.rs:2314
