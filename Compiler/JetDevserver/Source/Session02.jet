// Rust: crates/jet-devserver/src/Session.rs:2300
fn trim_capture_facts(facts: &[CaptureSessionFact]) -> Unit {
    if facts.len() > MAX_RECEIPTS {
        drop_count :: facts.len() - MAX_RECEIPTS
        facts.drain(..drop_count)
    }
}
