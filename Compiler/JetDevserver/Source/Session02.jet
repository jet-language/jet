impl ResidentDevSession {
    // Rust: crates/jet-devserver/src/Session.rs:1824
    fn publish_session_state(self: &Self, state_name: String, code: String, diagnostic: String) -> Unit {
        lifecycle :: devtools_session_state(state_name)
        freshness :: if lifecycle == .Ready -> JetDevtoolsFreshnessFact.fresh(unix_time_ms()) else -> JetDevtoolsFreshnessFact.stale(unix_time_ms())
        {
            state :: self.devtools_lock()
            state.envelope.set_lifecycle(lifecycle)
            state.envelope.set_freshness(freshness)
        }
        fields :: "{{\"state\":{json_value(state_name)},\"code\":{json_value(code)},\"diagnostic\":{json_value(diagnostic)}}}"
        if JetDevtoolsEvent.from_parts(unix_time_ms(), "devserver", "state", "session", ^fields) == .Ok(event) {
            _ :: self.publish_devtools_event_typed(^event)
        }
    }
    // Rust: crates/jet-devserver/src/Session.rs:1852
    fn push_devtools_event(self: &Self, event: JetDevtoolsEvent) -> U64 Err! {
        devtools :: self.devtools_lock()
        sequence :: if devtools.envelope.latest_sequence() == {
            .Val(sequence) -> sequence.checked_add(1) ?? return .Err("devtools event sequence exhausted")
            .None -> 1
        }
        recording :: self.recording.lock() ?? return .Err("devtools recording state is unavailable because its lock is poisoned")
        if recording.as_mut() == .Val(state) {
            recorded :: SessionEvent.new(sequence, event.timestamp_ms, event.source().to_string(), event.kind().to_string(),
                event.entity().to_string(), event.fields_json().to_string(), event.payload_json().map((text) -> text.to_string())).map_err(recording_error)?
            state.recording.append_event(^recorded).map_err(recording_error)?
        }
        assigned :: devtools.envelope.push(^event)
        if recording.as_mut() == .Val(state) {
            cursor := state.recording.replay()
            for _ in 0..state.recording.event_count() -> _ :: cursor.step_forward(&state.recording).map_err(recording_error)?
            state.cursor = ^cursor
            state.checkpoints.clear()
        }
        assigned
    }
    // Rust: crates/jet-devserver/src/Session.rs:1893
    fn devtools_lock(self: &Self) -> MutexGuard<DevtoolsState> {
        // GATE #4494: poison recovery retains the resident envelope.
        if self.devtools.lock() == { .Ok(guard) -> guard, .Err(poisoned) -> poisoned.into_inner() }
    }
    // Rust: crates/jet-devserver/src/Session.rs:1899
    fn sync_replay_cursor(self: &Self, projection: &ReplayProjection) -> Unit { self.devtools_lock().envelope.set_cursor(projection.sequence()) }
    // Rust: crates/jet-devserver/src/Session.rs:1905
    pub fn mark_last_good(self: &Self, revision: String, program: String) -> Unit {
        if revision.is_empty() -> return
        *self.last_good_revision.lock().unwrap() = revision
        *self.last_good_program.lock().unwrap() = program
    }
    // Rust: crates/jet-devserver/src/Session.rs:1917
    pub fn remember_last_good_view(self: &Self, kind: String, source_id: String, revision: String, payload: String) -> Unit {
        if !(kind == "graph" || kind == "debugger" || kind == "runtime") || revision.is_empty() || payload.is_empty() || payload.len() > MAX_RETAINED_VIEW_BYTES -> return
        self.last_good_views.lock().unwrap().insert(kind, RetainedView { revision, source_id, payload })
    }
    // Rust: crates/jet-devserver/src/Session.rs:1942
    pub fn last_good_view(self: &Self, kind: String, source_id: String) -> (String,String)? {
        views :: self.last_good_views.lock().unwrap()
        view :: views.get(kind)?
        if view.source_id != source_id -> return .None
        .Val((~view.revision, ~view.payload))
    }
    // Rust: crates/jet-devserver/src/Session.rs:1955
    fn clear_last_good_view(self: &Self, kind: String) -> Unit { self.last_good_views.lock().unwrap().remove(kind) }
    // Rust: crates/jet-devserver/src/Session.rs:1959
    pub fn accept_transaction(self: &Self, request: String, revision: String) -> Unit {
        before :: request_string(request, "revision")
        client :: request_string(request, "client_id")
        kind :: request_string(request, "op")
        self.select_project_source(request_string(request, "source_id"))
        self.observe_source(revision)
        if !revision.is_empty() -> *self.accepted_revision.lock().unwrap() = revision
        self.push_receipt(Receipt { kind: if kind.is_empty() -> "source" else -> ^kind, status: "accepted", before: ^before,
            after: revision, client: ^client, output: request_string(request, "output"), live: .None })
    }
    // Rust: crates/jet-devserver/src/Session.rs:1983
    pub fn refuse_transaction(self: &Self, request: String, current_revision: String) -> Unit {
        self.observe_source(current_revision)
        self.push_receipt(Receipt { kind: request_string(request, "op"), status: "refused", before: request_string(request, "revision"),
            after: current_revision, client: request_string(request, "client_id"), output: request_string(request, "output"), live: .None })
    }
    // Rust: crates/jet-devserver/src/Session.rs:1996
    pub fn lock_source_transaction(self: &Self) -> MutexGuard<Unit> { self.source_transactions.lock_source_transaction() }
    // Rust: crates/jet-devserver/src/Session.rs:2000
    pub fn record_command(self: &Self, request: String) -> Unit {
        action :: request_string(request, "action_id")
        self.select_project_source(request_string(request, "source_id"))
        if action.contains("test") -> *self.test_state.lock().unwrap() = "requested"
        self.push_receipt(Receipt { kind: if action.is_empty() -> "command" else -> ^action, status: "requested", before: "",
            after: ~*self.current_revision.lock().unwrap(), client: request_string(request, "client_id"),
            output: ~*self.selected_output.lock().unwrap(), live: .None })
    }
    // Rust: crates/jet-devserver/src/Session.rs:2021
    pub fn record_debug(self: &Self, request: String) -> Unit {
        self.select_project_source(request_string(request, "source_id"))
        debugger :: self.debugger.lock().unwrap()
        if request_bool(request, "stop") || request_string(request, "op") == "disconnect" {
            *debugger = idle_debugger()
            drop(debugger)
            self.clear_last_good_view("debugger")
            return
        }
        debugger.state = "active"
        set_if_present(&debugger.session_id, request_string(request, "session_id"))
        set_if_present(&debugger.source_id, request_string(request, "source_id"))
        set_if_present(&debugger.revision, request_string(request, "revision"))
        set_if_present(&debugger.tier, request_string(request, "tier"))
    }
    // Rust: crates/jet-devserver/src/Session.rs:2037
    pub fn record_debug_response(self: &Self, request: String, response: String) -> Unit {
        self.record_debug(request)
        if request_bool(request, "stop") -> return
        snapshot :: find_debugger_snapshot(response) ?? return
        (source_id, debugger_revision) :: {
            debugger :: self.debugger.lock().unwrap()
            state :: if snapshot.state == { "running" -> "active", "stopped" -> "idle", state -> ~state }
            *debugger = DebuggerSnapshot { state: ^state, session_id: ^snapshot.session_id, source_id: ^snapshot.source_id,
                revision: ^snapshot.revision, tier: ^snapshot.tier }
            source_id :: if debugger.source_id.is_empty() -> request_string(request, "source_id") else -> ~debugger.source_id
            (source_id, ~debugger.revision)
        }
        revision :: if debugger_revision.is_empty() {
            requested :: request_string(request, "revision")
            if requested.is_empty() -> ~*self.current_revision.lock().unwrap() else -> ^requested
        } else -> ^debugger_revision
        self.remember_last_good_view("debugger", source_id, revision, response)
    }
    // Rust: crates/jet-devserver/src/Session.rs:2079
    pub fn select_project_source(self: &Self, source_id: String) -> Unit {
        if !source_id.is_empty() -> *self.selected_source_id.lock().unwrap() = source_id
    }
    // Rust: crates/jet-devserver/src/Session.rs:2085
    pub fn select_project_source_from_payload(self: &Self, payload: String) -> Unit {
        if json_string_any(payload, "source_id") == .Val(source_id) -> self.select_project_source(source_id)
    }
    // Rust: crates/jet-devserver/src/Session.rs:2091
    pub fn select_output(self: &Self, request: String) -> Unit {
        output :: request_string(request, "output")
        target :: request_string(request, "target")
        self.select_output_values(if !output.is_empty() -> .Val(&output) else -> .None, if !target.is_empty() -> .Val(&target) else -> .None)
    }
    // Rust: crates/jet-devserver/src/Session.rs:2100
    pub fn select_output_values(self: &Self, output: &String?, target: &String?) -> Unit {
        if output.filter((output) -> !output.is_empty()) == .Val(output) -> *self.selected_output.lock().unwrap() = ~output
        if target.filter((target) -> !target.is_empty()) == .Val(target) -> *self.selected_target.lock().unwrap() = ~target
    }
    // Rust: crates/jet-devserver/src/Session.rs:2109
    pub fn id(self: &Self) -> &String { &self.id }
    // Rust: crates/jet-devserver/src/Session.rs:2115
    pub fn selected_target(self: &Self) -> String? {
        target :: ~*self.selected_target.lock().unwrap()
        if !target.is_empty() -> .Val(^target) else -> .None
    }
    // Rust: crates/jet-devserver/src/Session.rs:2121
    pub fn selected_output(self: &Self) -> String? {
        output :: ~*self.selected_output.lock().unwrap()
        if !output.is_empty() -> .Val(^output) else -> .None
    }
    // Rust: crates/jet-devserver/src/Session.rs:2125
    pub fn application_port(self: &Self) -> U16 { self.application_port }
    // Rust: crates/jet-devserver/src/Session.rs:2129
    pub fn canvas_port(self: &Self) -> U16 { self.canvas_port }
