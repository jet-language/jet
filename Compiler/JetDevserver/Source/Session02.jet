}
// Rust: crates/jet-devserver/src/Session.rs:2319
fn persist_outcome_fact(outcome: &PersistOutcome) -> LiveValueFact {
    if outcome == {
        .Kept(entry) -> LiveValueFact { value_id: entry.stable_key(), type_identity: entry.type_identity().to_string(), disposition: "kept", reason: "" }
        .Migrated(entry) -> LiveValueFact { value_id: entry.stable_key(), type_identity: entry.type_identity().to_string(), disposition: "migrated", reason: "published schema migration applied" }
        .Reset { reason, entry } -> LiveValueFact { value_id: entry.stable_key(), type_identity: entry.type_identity().to_string(), disposition: "reset", reason: ~reason }
        .Rejected { reason, prior } -> {
            type_identity :: if reason == { .MigrationUnavailable { from, .. } | .ShapeChanged { from, .. } -> ~from, _ -> "unavailable" }
            LiveValueFact { value_id: prior.key(), type_identity: ^type_identity, disposition: "rejected", reason: reason.message() }
        }
    }
}
// Rust: crates/jet-devserver/src/Session.rs:2355
fn optional_fact(value: String) -> String? { if !value.is_empty() -> .Val(value) else -> .None }
// Rust: crates/jet-devserver/src/Session.rs:2359
fn devtools_session_state(value: String) -> DevtoolsSessionState {
    if value == { "starting" -> .Starting, "building" -> .Building, "ready" -> .Ready, "error" -> .Error, "stopped" -> .Stopped, _ -> .Unavailable }
}
// Rust: crates/jet-devserver/src/Session.rs:2369
fn live_value_fact_json(value: &LiveValueFact) -> String {
    "{{\"value_id\":{json_value(value.value_id)},\"type_identity\":{json_value(value.type_identity)},\"disposition\":{json_value(value.disposition)},\"reason\":{json_value(value.reason)}}}"
}
// Rust: crates/jet-devserver/src/Session.rs:2379
fn live_receipt_json(receipt: &LiveReceipt) -> String {
    values :: receipt.values.iter().map(live_value_fact_json).collect::<[String]>().join(",")
    "{{\"protocol\":{json_value(receipt.lineage.protocol)},\"session_id\":{json_value(receipt.lineage.session_id)},\"source_id\":{json_value(receipt.lineage.source_id)},\"build_id\":{json_value(receipt.lineage.build_id)},\"revision\":{json_value(receipt.lineage.revision)},\"world_id\":{json_value(receipt.lineage.world_id)},\"values\":[{values}]}}"
}
// Rust: crates/jet-devserver/src/Session.rs:2398
fn expire_clients(clients: &[String:Instant], now: Instant) -> Unit { clients.retain((_, seen) -> now.saturating_duration_since(*seen) <= CLIENT_TTL) }
// Rust: crates/jet-devserver/src/Session.rs:2402
pub fn client_id_is_valid(client: String) -> Bool { !client.is_empty() && client.len() <= MAX_CLIENT_ID && !client.chars().any((ch) -> ch.is_control()) }
// Rust: crates/jet-devserver/src/Session.rs:2406
fn retained_view_json(view: &RetainedView?) -> String {
    retained :: view.cloned().unwrap_or(RetainedView { revision: "", source_id: "", payload: "" })
    "{{\"revision\":{json_value(retained.revision)},\"source_id\":{json_value(retained.source_id)},\"payload\":{json_value(retained.payload)}}}"
}
// Rust: crates/jet-devserver/src/Session.rs:2416
fn recording_error(error: RecordingError) -> String { error.to_string() }
// Rust: crates/jet-devserver/src/Session.rs:2420
fn recording_unavailable() -> String { "devtools recording is unavailable because source/build identity is not installed" }
// Rust: crates/jet-devserver/src/Session.rs:2424
fn recording_unavailable_json(session_id: String, reason: String) -> String {
    "{{\"protocol\":{json_value(JET_DEVTOOLS_PROTOCOL)},\"session_id\":{json_value(session_id)},\"kind\":\"session.recording\",\"available\":false,\"reason\":{json_value(reason)},\"events\":[],\"cursor\":null,\"divergence\":null}}"
}
// Rust: crates/jet-devserver/src/Session.rs:2433
fn recording_json_for_state(session_id: String, state: &ResidentRecordingState, projection: &ReplayProjection, divergence: &DevtoolsRecordingDivergence?) -> String {
    identity :: state.recording.identity()
    events :: state.recording.events().map(recording_event_json).collect::<[String]>().join(",")
    names := state.checkpoints.keys().cloned().collect::<[String]>()
    names.sort()
    checkpoints :: names.into_iter().map((name) -> recording_checkpoint_json(name, state.checkpoints.get(name).unwrap())).collect::<[String]>().join(",")
    current_event :: projection.event().map(recording_event_json).unwrap_or("null")
    truncation :: state.recording.truncation()
    divergence_json :: divergence.map(recording_divergence_json).unwrap_or("null")
    "{{\"protocol\":{json_value(JET_DEVTOOLS_PROTOCOL)},\"session_id\":{json_value(session_id)},\"kind\":\"session.recording\",\"available\":true,\"identity\":{{\"source_id\":{json_value(identity.source_id)},\"build_id\":{json_value(identity.build_id)}}},\"events\":[{events}],\"truncation\":{{\"event_limit\":{truncation.event_limit},\"byte_limit\":{truncation.byte_limit},\"retained_events\":{truncation.retained_events},\"retained_bytes\":{truncation.retained_bytes},\"dropped_events\":{truncation.dropped_events},\"dropped_bytes\":{truncation.dropped_bytes},\"event_limit_reached\":{truncation.event_limit_reached},\"byte_limit_reached\":{truncation.byte_limit_reached},\"first_dropped_sequence\":{optional_u64_json(truncation.first_dropped_sequence)},\"last_dropped_sequence\":{optional_u64_json(truncation.last_dropped_sequence)},\"first_retained_sequence\":{optional_u64_json(truncation.first_retained_sequence)},\"last_retained_sequence\":{optional_u64_json(truncation.last_retained_sequence)}}},\"cursor\":{{\"identity\":{{\"source_id\":{json_value(projection.identity().source_id)},\"build_id\":{json_value(projection.identity().build_id)}}},\"generation\":{state.cursor.generation()},\"position\":{projection.position()},\"sequence\":{optional_u64_json(projection.sequence())},\"timestamp_ms\":{optional_u64_json(projection.timestamp_ms())},\"previous_sequence\":{optional_u64_json(projection.previous_sequence())},\"next_sequence\":{optional_u64_json(projection.next_sequence())},\"event\":{current_event}}},\"checkpoints\":[{checkpoints}],\"divergence\":{divergence_json}}}"
}
// Rust: crates/jet-devserver/src/Session.rs:2496
fn recording_event_json(event: &SessionEvent) -> String {
    "{{\"sequence\":{event.sequence()},\"timestamp_ms\":{event.timestamp_ms()},\"source\":{json_value(event.source())},\"kind\":{json_value(event.kind())},\"entity\":{json_value(event.entity())},\"fields\":{event.fields_json()},\"payload\":{event.payload_json().unwrap_or("null")}}}"
}
// Rust: crates/jet-devserver/src/Session.rs:2509
fn recording_checkpoint_json(name: String, checkpoint: &SessionCheckpoint) -> String {
    "{{\"name\":{json_value(name)},\"identity\":{{\"source_id\":{json_value(checkpoint.identity().source_id)},\"build_id\":{json_value(checkpoint.identity().build_id)}}},\"generation\":{checkpoint.generation()},\"position\":{checkpoint.position()},\"sequence\":{optional_u64_json(checkpoint.sequence())},\"timestamp_ms\":{optional_u64_json(checkpoint.timestamp_ms())}}}"
}
// Rust: crates/jet-devserver/src/Session.rs:2522
fn recording_divergence_json(divergence: &DevtoolsRecordingDivergence) -> String {
    reason :: divergence.reason.as_ref().map(json_value).unwrap_or("null")
    "{{\"divergent\":{divergence.divergent},\"reason\":{reason},\"expected_sequence\":{optional_u64_json(divergence.expected_sequence)},\"actual_sequence\":{optional_u64_json(divergence.actual_sequence)},\"retained_events\":{divergence.retained_events},\"dropped_events\":{divergence.dropped_events}}}"
}
// Rust: crates/jet-devserver/src/Session.rs:2538
fn optional_u64_json(value: U64?) -> String { value.map((value) -> value.to_string()).unwrap_or("null") }
// Rust: crates/jet-devserver/src/Session.rs:2544
fn json_value(value: String) -> String { if value.is_empty() -> "null" else -> "\"{json_escape(value)}\"" }
// Rust: crates/jet-devserver/src/Session.rs:2552
fn unix_time_ms() -> U64 {
    // GATE #4494: wall clock uses epoch duration with original failure/overflow behavior.
    SystemTime.now().duration_since(UNIX_EPOCH).unwrap_or_default().as_millis().try_into().unwrap_or(U64.MAX)
}
// Rust: crates/jet-devserver/src/Session.rs:2561
fn json_string(value: &DataTree) -> &String? { if value == { .Text(value) | .TypedText(value) -> .Val(value), _ -> .None } }
// Rust: crates/jet-devserver/src/Session.rs:2568
fn json_u64(value: &DataTree) -> U64? {
    if value == {
        .Int(value) if *value >= 0 -> U64.try_from(*value).ok()
        .Float(value) if value.fract() == 0.0 && *value >= 0.0 && *value <= U64.MAX as F64 -> .Val(*value as U64)
        _ -> .None
    }
}
// Rust: crates/jet-devserver/src/Session.rs:2580
fn validate_devtools_text(value: String, label: String) -> Unit Err! {
    if value.is_empty() || value.len() > DEVTOOLS_TEXT_LIMIT || value.chars().any((ch) -> ch.is_control()) -> return .Err("devtools {label} is empty, too long, or contains control text")
}
// Rust: crates/jet-devserver/src/Session.rs:2588
fn string_array_json(values: &[String]) -> String { "[{values.iter().map((value) -> json_value(value)).collect::<[String]>().join(",")}]" }
// Rust: crates/jet-devserver/src/Session.rs:2599
fn retention_fact_json(fact: &StateRetentionFact) -> String {
    (decision, reason) :: if fact.decision == { .Preserve -> ("preserve", ""), .Fresh { reason } -> ("fresh", reason) }
    "{{\"key\":{json_value(fact.key)},\"decision\":{json_value(decision)},\"reason\":{json_value(reason)}}}"
}
// Rust: crates/jet-devserver/src/Session.rs:2612
fn game_change_fact_json(fact: &JetGameChangeFact) -> String {
    old_schema :: fact.old_schema_id.as_ref().map(json_value).unwrap_or("null")
    new_schema :: fact.new_schema_id.as_ref().map(json_value).unwrap_or("null")
    "{{\"path\":{json_value(fact.path)},\"kind\":{json_value(fact.kind.as_str())},\"old_schema_id\":{old_schema},\"new_schema_id\":{new_schema},\"migration\":{json_value(fact.migration.as_str())},\"reason\":{json_value(fact.reason)}}}"
}
// Rust: crates/jet-devserver/src/Session.rs:2630
pub fn render_json(value: &DataTree) -> String {
    if value == {
        .Null -> "null"
        .Bool(value) -> value.to_string()
        .Int(value) -> value.to_string()
        .Float(value) -> value.to_string()
        .Number(value) -> ~value
        .TypedText(value) | .Text(value) -> json_value(value)
        .Bytes(values) -> "[{values.iter().map((value) -> value.to_string()).collect::<[String]>().join(",")}]"
        .Array(values) -> "[{values.iter().map(render_json).collect::<[String]>().join(",")}]"
        .Object(values) -> "{{{values.iter().map(((key, value)) -> "{json_value(key)}:{render_json(value)}").collect::<[String]>().join(",")}}}"
    }
}
// Rust: crates/jet-devserver/src/Session.rs:2660
fn object_map(value: &DataTree) -> [String:DataTree]? {
    if value == { .Object(values) -> .Val(values.iter().cloned().collect()), _ -> .None }
}
// Rust: crates/jet-devserver/src/Session.rs:2667
fn request_string(text: String, key: String) -> String {
    value :: parse_json(text) ?? return ""
    object_map(&value).and_then((object) -> object.get(key).and_then(json_string).map((text) -> text.to_string())).unwrap_or_default()
}
// Rust: crates/jet-devserver/src/Session.rs:2676
fn request_bool(text: String, key: String) -> Bool {
    value :: parse_json(text) ?? return false
    object_map(&value).and_then((object) -> object.get(key).cloned()).is_some_and((value) -> if value == { .Bool(true) -> true, _ -> false })
}
// Rust: crates/jet-devserver/src/Session.rs:2685
fn set_if_present(target: &String, value: String) -> Unit { if !value.is_empty() -> *target = value }
// Rust: crates/jet-devserver/src/Session.rs:2691
fn idle_debugger() -> DebuggerSnapshot { DebuggerSnapshot { state: "idle", session_id: "", source_id: "", revision: "", tier: "" } }
// Rust: crates/jet-devserver/src/Session.rs:2701
fn json_string_any(text: String, key: String) -> String? {
    value :: parse_json(text).ok()?
    // Rust: crates/jet-devserver/src/Session.rs:2704
    fn find(value: &DataTree, key: String) -> String? {
        if value == {
            .Object(object) -> {
                if object.iter().find_map(((name, value)) -> if name == key -> .Val(value) else -> .None) == .Val(found) {
                    if json_string(found) == .Val(text) -> return .Val(~text)
                }
                object.iter().find_map(((_, value)) -> find(value, key))
            }
            .Array(values) -> values.iter().find_map((value) -> find(value, key))
            _ -> .None
        }
    }
    find(&value, key)
}
// Rust: crates/jet-devserver/src/Session.rs:2722
fn find_debugger_snapshot(text: String) -> DebuggerSnapshot? {
    value :: parse_json(text).ok()?
    // Rust: crates/jet-devserver/src/Session.rs:2725
    fn find(value: &DataTree) -> DebuggerSnapshot? {
        if value == {
            .Object(object) -> {
                if object.iter().find_map(((name, value)) -> if name == "id" -> .Val(value) else -> .None).and_then(json_string) == .Val(session_id) {
                    if session_id.starts_with("canvas-debug-") {
                        field :: (key: String) -> object.iter().find_map(((name, value)) -> if name == key -> .Val(value) else -> .None)
                            .and_then(json_string).map((text) -> text.to_string()).unwrap_or_default()
                        return .Val(DebuggerSnapshot { state: field("state"), session_id: ~session_id, source_id: field("source_id"), revision: field("revision"), tier: field("tier") })
                    }
                }
                object.iter().find_map(((_, value)) -> find(value))
            }
            .Array(values) -> values.iter().find_map(find)
            _ -> .None
        }
    }
    find(&value)
}
