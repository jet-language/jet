// -* Canvas: source-backed graph projection and edit transactions. Canvas
// consumes ProgramBundle and semindex facts from the checked front end; edits
// pass through jet fmt before replacing the source file.

// Dependency-free projection assets retain their canonical owner. Publication
// of these imports belongs to the package manifest.
use {
    jet_canvas.html.[canvas_html, canvas_html_for, canvas_html_query]
    jet_canvas.js.[canvas_js]
    jet_devserver.Canvas.DebugSourceGit.[DebugSessions]

    jet_devserver.Canvas.SourceModel.[read_source_without_symlinks, source_revision]
}

