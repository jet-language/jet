// The devserver's live inspector: jet_foundation's secure JETLIVE1 transport,
// projected as the jet.live.v1 JSON view the canvas and the last-good page
// read. Never reads process memory or exposes payloads, locals, environment
// or credentials.
use {
    jet_foundation.[JetLiveSnapshot, JetLiveValue, foundation_json_quote, jet_live_read, jet_live_snapshot_path]
    jet_debug.[render_event_observations]
}

#Error
LiveInspectError: struct {
    message: String

    impl Display { display: fn(self) -> String { self.message } }
}
live_inspect_error: fn(message: String) -> LiveInspectError Never! {
    LiveInspectError{message: message}
}

// The jet.live.v1 view of process `pid`'s published snapshot. The event
// sequence must pass the debugger's closed event projection.
live_inspect_read: fn(pid: Int) -[FS, Env, Time]> String LiveInspectError! {
    snapshot: jet_live_read(pid, jet_live_snapshot_path(pid)) ?? return Err(live_inspect_error(err.message))
    view: live_view_json(snapshot)
    _: render_event_observations(view) ?? return Err(live_inspect_error("live runtime event observations are invalid: {err.message}"))
    Ok(view)
}

live_view_count: fn(counters: [String:Int], key: String) -> Int Never! {
    counters.get(key) ?? 0
}
live_view_optional: fn(value: Int?) -> String Never! {
    if value == .Val(number) -> return "{number}"
    "null"
}
live_view_value: fn(value: JetLiveValue) -> String Never! {
    rendered: if value.rendered_value == .Val(shown) -> ",\"rendered_value\":{foundation_json_quote(shown)}" else -> ""
    "{{\"value_id\":{foundation_json_quote(value.value_id)},\"type_identity\":{foundation_json_quote(value.type_identity)},\"disposition\":{foundation_json_quote(value.disposition)},\"reason\":{foundation_json_quote(value.reason)}{rendered}}}"
}

// Field order is the jet.live.v1 wire order; an unbound process start is
// "unbound".
live_view_json: fn(snapshot: JetLiveSnapshot) -> String Never! {
    values: loop value in snapshot.values -> live_view_value(value)
    tasks: loop task in snapshot.tasks -> "{{\"id\":{task.id},\"parent\":{task.parent},\"state\":{foundation_json_quote(task.state)},\"wait\":{foundation_json_quote(task.wait)},\"deadline_ms\":{live_view_optional(task.deadline_ms)},\"cancelled\":{task.cancelled}}}"
    channels: loop channel in snapshot.channels -> "{{\"id\":{channel.id},\"depth\":{channel.depth},\"capacity\":{live_view_optional(channel.capacity)},\"send_waiters\":{channel.send_waiters},\"recv_waiters\":{channel.recv_waiters},\"closed\":{channel.closed}}}"
    events: loop event in snapshot.event_records -> "{{\"sequence\":{event.sequence},\"source\":{foundation_json_quote(event.source)},\"event_id\":{event.event_id},\"owner_id\":{event.owner_id},\"subscription_id\":{event.subscription_id},\"dispatch_id\":{event.dispatch_id},\"lifecycle\":{foundation_json_quote(event.lifecycle)},\"queued\":{event.queued},\"blocked\":{event.blocked},\"running\":{event.running},\"capacity\":{event.capacity},\"overflow\":{foundation_json_quote(event.overflow)},\"priority\":{event.priority},\"failure\":{foundation_json_quote(event.failure)},\"terminal\":{foundation_json_quote(event.terminal)}}}"
    effects: snapshot.effects
    resources: snapshot.resources
    start_id: if snapshot.start_id == "" -> "unbound" else -> snapshot.start_id
    identity: "\"protocol\":{foundation_json_quote(snapshot.protocol)},\"session_id\":{foundation_json_quote(snapshot.session_id)},\"source_id\":{foundation_json_quote(snapshot.source_id)},\"build_id\":{foundation_json_quote(snapshot.build_id)},\"revision\":{foundation_json_quote(snapshot.revision)},\"world_id\":{foundation_json_quote(snapshot.world_id)}"
    effect_fields: "\"compute\":{live_view_count(effects, "compute")},\"waiting\":{live_view_count(effects, "waiting")},\"channel\":{live_view_count(effects, "channel")},\"time\":{live_view_count(effects, "time")},\"io\":{live_view_count(effects, "io")}"
    resource_fields: "\"workers\":{live_view_count(resources, "workers")},\"running\":{live_view_count(resources, "running")},\"queued\":{live_view_count(resources, "queued")},\"cancelled\":{live_view_count(resources, "cancelled")},\"arenas\":{live_view_count(resources, "arenas")},\"arena_allocations\":{live_view_count(resources, "arena_allocations")},\"arena_bytes\":{live_view_count(resources, "arena_bytes")}"
    runtime: "\"elapsed_ns\":{snapshot.runtime.elapsed_ns},\"cpu_ns\":{live_view_optional(snapshot.runtime.cpu_ns)},\"exit\":{snapshot.runtime.exit}"
    "{{{identity},\"values\":[{values.join(",")}],\"schema_version\":1,\"pid\":{snapshot.pid},\"start_id\":{foundation_json_quote(start_id)},\"captured_ms\":{snapshot.captured_ms},\"tasks\":[{tasks.join(",")}],\"channels\":[{channels.join(",")}],\"effects\":{{{effect_fields}}},\"resources\":{{{resource_fields}}},\"event_observations\":[{events.join(",")}],\"runtime\":{{{runtime}}}}}"
}
