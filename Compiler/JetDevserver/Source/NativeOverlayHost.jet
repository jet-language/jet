// Typed native GUI/game overlay over jet.devtools.v1. Bounded draw commands for
// the real game-window backend; adapter owns the sole projection bridge.
use jet_foundation.[JetDevtoolsNativeColor, JetDevtoolsNativeDrawCommand, JetDevtoolsNativeFrame, JetDevtoolsNativeHost, JetDevtoolsNativeInput, JetDevtoolsNativeWindow, jettrace_has_control]

MAX_OVERLAY_PANELS: Int{64}
MAX_OVERLAY_NODES: Int{512}
MAX_OVERLAY_DEPTH: Int{32}
MAX_OVERLAY_FRAMES: Int{64}
MAX_OVERLAY_TEXT_BYTES: Int{16384}
MAX_OVERLAY_COORDINATE: Int{2147483647}

#Error
NativeOverlayHostError: struct {
    message: String

    impl Display { display: fn(&&self) -> String { self.message } }
}
native_overlay_error: fn(message: String) -> NativeOverlayHostError { NativeOverlayHostError{message: message} }

// Projects an action's required NativeOverlayGrant; never grants or executes an action.
NativeOverlayAction: struct { action_id: String, required_grant: NativeOverlayGrant }

// Values are optional; no recovery of unpublished observation payloads.
NativeOverlayNode: struct {
    id: String
    kind: DevtoolsNodeKind
    label: String
    value: String?
    status: String?
    children: [NativeOverlayNode]
    action: NativeOverlayAction?

    new: fn(id: String, kind: DevtoolsNodeKind, label: String) -> NativeOverlayNode {
        NativeOverlayNode{id: id, kind: kind, label: label, value: None, status: None, children: [NativeOverlayNode]{}, action: None}
    }
    text: fn(id: String, label: String) -> NativeOverlayNode { NativeOverlayNode.new(id, .Text, label) }
    with_value: fn(self, value: String) -> NativeOverlayNode {
        node := self
        node.value = Val(value)
        node
    }
    with_status: fn(self, status: String) -> NativeOverlayNode {
        node := self
        node.status = Val(status)
        node
    }
    with_children: fn(self, children: [NativeOverlayNode]) -> NativeOverlayNode {
        node := self
        node.children = children
        node
    }
    with_action: fn(self, action: NativeOverlayAction) -> NativeOverlayNode {
        node := self
        node.action = Val(action)
        node
    }
    validate: fn(self, depth: Int, count: &Int, ids: &[String: Bool]) NativeOverlayHostError! {
        if depth > MAX_OVERLAY_DEPTH -> return Err(native_overlay_error("native overlay node tree exceeds its depth budget"))
        validate_overlay_text(self.id, "native overlay node id", false)
        validate_overlay_text(self.label, "native overlay node label", false)
        if ids.get(self.id) != None -> return Err(native_overlay_error("native overlay node id `{self.id}` is duplicated"))
        ids[self.id] = true
        count += 1
        if count > MAX_OVERLAY_NODES -> return Err(native_overlay_error("native overlay frame exceeds its node budget"))
        if self.value == .Val(value) -> validate_overlay_text(value, "native overlay node value", true)
        if self.status == .Val(status) -> validate_overlay_text(status, "native overlay node status", true)
        if self.action == .Val(action) {
            if self.kind != .Action -> return Err(native_overlay_error("native overlay node `{self.id}` carries an action but is not an action node"))
            validate_overlay_text(action.action_id, "native overlay action id", false)
        } else if self.kind == .Action {
            return Err(native_overlay_error("native overlay action node `{self.id}` has no typed action"))
        }
        loop child in self.children -> child.validate(depth + 1, count, ids)
    }
}
// Already-typed panel facts; host never infers meaning from panel names.
NativeOverlayPanelFact: struct {
    panel_id: String
    title: String
    freshness: Int
    status: String
    nodes: [NativeOverlayNode]

    new: fn(panel_id: String, title: String, freshness: Int, status: String, nodes: [NativeOverlayNode]) -> NativeOverlayPanelFact {
        NativeOverlayPanelFact{panel_id: panel_id, title: title, freshness: freshness, status: status, nodes: nodes}
    }
    validate: fn(self, count: &Int) NativeOverlayHostError! {
        validate_overlay_text(self.panel_id, "native overlay panel id", false)
        validate_overlay_text(self.title, "native overlay panel title", false)
        validate_overlay_text(self.status, "native overlay panel status", true)
        ids := [String: Bool]{}
        loop node in self.nodes -> node.validate(0, count, ids)
    }
}
NativeOverlayEvent: struct {
    protocol: String
    session_id: String
    revision: String
    sequence: Int
    observed_at_ms: Int
    panels: [NativeOverlayPanelFact]

    new: fn(protocol: String, session_id: String, revision: String, sequence: Int, observed_at_ms: Int, panels: [NativeOverlayPanelFact]) -> NativeOverlayEvent {
        NativeOverlayEvent{protocol: protocol, session_id: session_id, revision: revision, sequence: sequence, observed_at_ms: observed_at_ms, panels: panels}
    }
    current: fn(session_id: String, revision: String, sequence: Int, observed_at_ms: Int, panels: [NativeOverlayPanelFact]) -> NativeOverlayEvent {
        NativeOverlayEvent.new(JET_DEVTOOLS_PROTOCOL, session_id, revision, sequence, observed_at_ms, panels)
    }
    validate: fn(self) NativeOverlayHostError! {
        if self.protocol != JET_DEVTOOLS_PROTOCOL -> return Err(native_overlay_error("native overlay protocol must be `{JET_DEVTOOLS_PROTOCOL}`"))
        validate_overlay_text(self.revision, "native overlay revision", false)
        if self.sequence <= 0 -> return Err(native_overlay_error("native overlay event sequence must be greater than zero"))
        if self.panels.len() > MAX_OVERLAY_PANELS -> return Err(native_overlay_error("native overlay event exceeds its panel budget"))
        panel_ids := [String: Bool]{}
        count := 0
        loop panel in self.panels {
            if panel_ids.get(panel.panel_id) != None -> return Err(native_overlay_error("native overlay event repeats panel `{panel.panel_id}`"))
            panel_ids[panel.panel_id] = true
            panel.validate(count)
        }
    }
}
// Physical viewport with integer DPI scale for reproducible headless geometry.
NativeOverlayViewport: struct {
    width: Int
    height: Int
    scale_milli: Int

    new: fn(width: Int, height: Int, scale_milli: Int) -> NativeOverlayViewport NativeOverlayHostError! {
        viewport: NativeOverlayViewport{width: width, height: height, scale_milli: scale_milli}
        viewport.validate()
        viewport
    }
    validate: fn(self) NativeOverlayHostError! {
        if self.width <= 0 || self.height <= 0 -> return Err(native_overlay_error("native overlay viewport dimensions must be non-zero"))
        if self.width > MAX_OVERLAY_COORDINATE || self.height > MAX_OVERLAY_COORDINATE -> return Err(native_overlay_error("native overlay viewport exceeds coordinate range"))
        if self.scale_milli <= 0 || self.scale_milli > 10000 -> return Err(native_overlay_error("native overlay scale must be between 1 and 10000 milli-units"))
    }
    overlay_rect: fn(self, dock: DevtoolsDock) -> NativeOverlayRect {
        width: self.scaled_extent(480, self.width)
        height: self.scaled_extent(360, self.height)
        if dock == {
            .Floating -> NativeOverlayRect{x: (self.width - width) / 2, y: (self.height - height) / 2, width: width, height: height}
            .Left -> NativeOverlayRect{x: 0, y: 0, width: width, height: self.height}
            .Right -> NativeOverlayRect{x: self.width - width, y: 0, width: width, height: self.height}
            .Top -> NativeOverlayRect{x: 0, y: 0, width: self.width, height: height}
            .Bottom -> NativeOverlayRect{x: 0, y: self.height - height, width: self.width, height: height}
        }
    }
    // The logical extent at this scale, rounded up, at least 1 and at most `available`.
    scaled_extent: fn(self, logical: Int, available: Int) -> Int {
        scaled: (logical * self.scale_milli + 999) / 1000
        if scaled < 1 -> return 1
        if scaled > available -> return available
        scaled
    }
}
NATIVE_OVERLAY_DEFAULT_VIEWPORT: NativeOverlayViewport{NativeOverlayViewport{width: 1280, height: 720, scale_milli: 1000}}
NativeOverlayRect: struct {
    x: Int
    y: Int
    width: Int
    height: Int

    contains: fn(self, x: Int, y: Int) -> Bool { x >= self.x && y >= self.y && x < self.x + self.width && y < self.y + self.height }
}
NativeOverlayState: struct { open: Bool, dock: DevtoolsDock, focused: Bool }

NativeOverlayInput: enum {
    Toggle
    Close
    Dock(dock: DevtoolsDock)
    Focus(focused: Bool)
    Key(code: String, pressed: Bool)
    Gamepad(gamepad: Int, control: String, pressed: Bool)
    Pointer(x: Int, y: Int, pressed: Bool)
    Text(text: String)
    Activate(action_id: String)
}
NativeOverlayInputRoute: enum { Overlay Game }

NativeOverlayFrame: struct {
    frame_id: Int
    protocol: String
    session_id: String
    revision: String
    sequence: Int
    observed_at_ms: Int
    open: Bool
    dock: DevtoolsDock
    focused: Bool
    viewport: NativeOverlayViewport
    bounds: NativeOverlayRect
    cursor: Int?
    selection: JetDevtoolsSelection?
    panels: [NativeOverlayPanelFact]

    panel_count: fn(self) -> Int { self.panels.len() }
    node_count: fn(self) -> Int {
        total := 0
        loop panel in self.panels -> total += overlay_panel_node_count(panel)
        total
    }
}
overlay_node_count: fn(node: NativeOverlayNode) -> Int {
    total := 1
    loop child in node.children -> total += overlay_node_count(child)
    total
}
overlay_panel_node_count: fn(panel: NativeOverlayPanelFact) -> Int {
    total := 0
    loop node in panel.nodes -> total += overlay_node_count(node)
    total
}

NativeOverlayHost: struct {
    state: NativeOverlayState
    viewport: NativeOverlayViewport
    toggle_key: String
    release_build: Bool
    session_id: String?
    revision: String?
    sequence: Int?
    cursor: Int?
    selection: JetDevtoolsSelection?
    observed_at_ms: Int
    panels: [String: NativeOverlayPanelFact]
    next_frame_id: Int
    max_frames: Int
    // Oldest first; bounded by max_frames.
    frames: [NativeOverlayFrame]
    // One real game-backend draw callback, bounded independently of frame history.
    last_native_draw: JetDevtoolsNativeDrawCommand?

    new: fn() -> NativeOverlayHost { NativeOverlayHost.with_viewport(NATIVE_OVERLAY_DEFAULT_VIEWPORT) }
    with_viewport: fn(viewport: NativeOverlayViewport) -> NativeOverlayHost {
        _: viewport.validate() ?? panic("invalid native overlay viewport: {err.message}")
        NativeOverlayHost{
            state: NativeOverlayState{open: false, dock: .Floating, focused: false},
            viewport: viewport, toggle_key: "F12", release_build: false,
            session_id: None, revision: None, sequence: None, cursor: None, selection: None, observed_at_ms: 0,
            panels: [String: NativeOverlayPanelFact]{}, next_frame_id: 1, max_frames: MAX_OVERLAY_FRAMES,
            frames: [NativeOverlayFrame]{}, last_native_draw: None,
        }
    }
    set_frame_capacity: fn(&self, capacity: Int) {
        self.max_frames = if capacity < 1 -> 1 else if capacity > MAX_OVERLAY_FRAMES -> MAX_OVERLAY_FRAMES else -> capacity
    }
    set_release_build: fn(&self, release_build: Bool) {
        self.release_build = release_build
        if release_build {
            self.state.open = false
            self.state.focused = false
            self.session_id = None
            self.revision = None
            self.sequence = None
            self.cursor = None
            self.selection = None
            self.observed_at_ms = 0
            self.panels = [String: NativeOverlayPanelFact]{}
            self.frames = [NativeOverlayFrame]{}
            self.last_native_draw = None
        }
    }
    panel_catalog: fn(self) -> [JetDevtoolsPanelDescriptor] { descriptors() }
    available_panels: fn(self) -> [JetDevtoolsPanelAvailability] { self.available_panels_for(JetDevtoolsPanelCapability.ALL) }
    available_panels_for: fn(self, grants: [JetDevtoolsPanelCapability]) -> [JetDevtoolsPanelAvailability] {
        panel_availability(.NativeOverlay, if self.release_build -> [JetDevtoolsPanelCapability]{} else -> grants)
    }
    set_viewport: fn(&self, viewport: NativeOverlayViewport) NativeOverlayHostError! {
        viewport.validate()
        self.viewport = viewport
        self.push_frame()
    }
    open: fn(&self) {
        if self.release_build -> return
        self.state.open = true
        self.state.focused = true
        self.push_frame()
    }
    close: fn(&self) {
        self.state.open = false
        self.state.focused = false
    }
    toggle: fn(&self) {
        if self.release_build -> return
        if self.state.open -> self.close() else -> self.open()
    }
    set_dock: fn(&self, dock: DevtoolsDock) {
        self.state.dock = dock
        self.push_frame()
    }
    set_focus: fn(&self, focused: Bool) {
        self.state.focused = self.state.open && focused
        self.push_frame()
    }
    is_focused: fn(self) -> Bool { self.state.open && self.state.focused }
    captures_input: fn(self) -> Bool { self.is_focused() }
    // Strictly increasing sequence; revision identity and freshness gates before mutation.
    ingest: fn(&self, event: NativeOverlayEvent) NativeOverlayHostError! {
        if self.release_build -> return Err(native_overlay_error("native overlay is excluded from release builds"))
        event.validate()
        if self.session_id == .Val(session_id) {
            if session_id != event.session_id -> return Err(native_overlay_error("native overlay event belongs to a different session"))
        }
        if self.sequence == .Val(sequence) {
            if event.sequence <= sequence {
                if self.revision != Val(event.revision) -> return Err(native_overlay_error("native overlay stale event revision identity"))
                return Err(native_overlay_error("native overlay event sequence is not increasing"))
            }
        }
        revision_changed := false
        if self.revision == .Val(revision) -> revision_changed = revision != event.revision
        projected_panel_count := 0
        projected_node_count := 0
        if !revision_changed {
            projected_panel_count = self.panels.len()
            loop (_, panel) in self.panels -> projected_node_count += overlay_panel_node_count(panel)
        }
        loop panel in event.panels {
            if !revision_changed {
                if self.panels.get(panel.panel_id) == .Val(previous) {
                    if panel.freshness < previous.freshness -> return Err(native_overlay_error("native overlay panel `{panel.panel_id}` freshness moved backwards"))
                    projected_node_count = projected_node_count - overlay_panel_node_count(previous) + overlay_panel_node_count(panel)
                    next
                }
            }
            projected_panel_count += 1
            projected_node_count += overlay_panel_node_count(panel)
        }
        if projected_panel_count > MAX_OVERLAY_PANELS -> return Err(native_overlay_error("native overlay frame exceeds its panel budget"))
        if projected_node_count > MAX_OVERLAY_NODES -> return Err(native_overlay_error("native overlay frame exceeds its node budget"))
        if revision_changed -> self.panels = [String: NativeOverlayPanelFact]{}
        self.session_id = Val(event.session_id)
        self.revision = Val(event.revision)
        self.sequence = Val(event.sequence)
        self.cursor = Val(event.sequence)
        self.observed_at_ms = event.observed_at_ms
        loop panel in event.panels -> self.panels[panel.panel_id] = panel
        self.push_frame()
    }
    ingest_update: fn(&self, update: NativeOverlayUpdate) NativeOverlayHostError! {
        if self.release_build -> return Err(native_overlay_error("native overlay is excluded from release builds"))
        self.cursor = None
        if update.identity.cursor == .Val(cursor) -> self.cursor = Val(cursor.sequence)
        self.selection = None
        if update.selection == .Val(selected) {
            item: if selected.item_key != "" -> String?{Val(selected.item_key)} else -> None
            self.selection = Val(JetDevtoolsSelection.new(selected.panel_id, item))
        }
        if update.event == .Val(event) {
            self.ingest(event)
        } else if self.sequence != None {
            self.push_frame()
        }
    }
    frame: fn(self) -> NativeOverlayFrame? {
        if self.frames.len() == 0 -> return None
        Val(self.frames[self.frames.len() - 1])
    }
    record_native_draw: fn(&self, command: JetDevtoolsNativeDrawCommand) {
        if !self.release_build -> self.last_native_draw = Val(command)
    }
    // Canonical commands executed in the real backend's BeginDrawing/EndDrawing context.
    native_draw_commands: fn(self) -> [JetDevtoolsNativeDrawCommand] {
        commands := [JetDevtoolsNativeDrawCommand]{}
        frame: self.frame() ?? return commands
        if self.release_build || !frame.open -> return commands
        bounds: frame.bounds
        bottom: bounds.y + bounds.height
        commands.push(JetDevtoolsNativeDrawCommand.Rectangle(x: bounds.x, y: bounds.y, width: bounds.width, height: bounds.height, color: JetDevtoolsNativeColor.new(16, 20, 28, 232)))
        commands.push(JetDevtoolsNativeDrawCommand.Text(text: "Jet Devtools [{frame.session_id}]", x: bounds.x + 12, y: bounds.y + 22, size: 18, color: JetDevtoolsNativeColor.WHITE))
        y := bounds.y + 46
        loop panel in frame.panels {
            if y >= bottom || commands.len() >= MAX_OVERLAY_NODES -> break
            commands.push(JetDevtoolsNativeDrawCommand.Text(text: panel.title, x: bounds.x + 12, y: overlay_clamp_coordinate(y), size: 15, color: JetDevtoolsNativeColor.new(255, 220, 120, 255)))
            y += 18
            if panel.status != "" && y < bottom {
                commands.push(JetDevtoolsNativeDrawCommand.Text(text: panel.status, x: bounds.x + 18, y: overlay_clamp_coordinate(y), size: 12, color: JetDevtoolsNativeColor.new(170, 190, 210, 255)))
                y += 16
            }
            loop node in panel.nodes {
                append_native_node_commands(commands, node, bounds.x + 18, y, bottom, 0)
                if y >= bottom || commands.len() >= MAX_OVERLAY_NODES -> break
            }
        }
        commands
    }
    // Focused/open overlays capture all input, including pointers outside bounds.
    route_input: fn(&self, input: NativeOverlayInput) -> NativeOverlayInputRoute {
        if input == {
            .Toggle -> {
                if self.release_build -> return .Game
                self.toggle()
                .Overlay
            }
            .Close -> {
                if !self.state.open -> return .Game
                self.close()
                .Overlay
            }
            .Dock(dock) -> {
                if !self.state.open -> return .Game
                self.set_dock(dock)
                .Overlay
            }
            .Focus(focused) -> {
                if !self.state.open -> return .Game
                self.set_focus(focused)
                .Overlay
            }
            .Key(code, pressed) -> {
                if pressed && code == self.toggle_key {
                    if self.release_build -> return .Game
                    self.toggle()
                    return .Overlay
                }
                if self.captures_input() -> .Overlay else -> .Game
            }
            .Pointer(x, y, _) -> {
                if self.captures_input() || (self.state.open && self.viewport.overlay_rect(self.state.dock).contains(x, y)) -> .Overlay else -> .Game
            }
            .Gamepad(_, _, _) | .Text(_) | .Activate(_) -> if self.captures_input() -> .Overlay else -> .Game
        }
    }
    headless_projection: fn(event: NativeOverlayEvent) -> NativeOverlayFrame NativeOverlayHostError! {
        host := NativeOverlayHost.new()
        host.open()
        host.ingest(event)
        host.frame() ?? Err(native_overlay_error("native overlay did not produce a headless frame"))
    }
    push_frame: fn(&self) {
        if self.release_build -> return
        session_id: self.session_id ?? return
        revision: self.revision ?? return
        sequence: self.sequence ?? return
        frame_id: self.next_frame_id
        self.next_frame_id += 1
        keys := self.panels.keys().to_list()
        keys.sort()
        panels: loop key in keys -> self.panels[key]
        frame: NativeOverlayFrame{frame_id: frame_id, protocol: JET_DEVTOOLS_PROTOCOL, session_id: session_id, revision: revision, sequence: sequence,
            observed_at_ms: self.observed_at_ms, open: self.state.open, dock: self.state.dock, focused: self.is_focused(), viewport: self.viewport,
            bounds: self.viewport.overlay_rect(self.state.dock), cursor: self.cursor, selection: self.selection, panels: panels}
        if self.frames.len() >= self.max_frames {
            first: self.frames.len() - self.max_frames + 1
            self.frames = loop index in first..<self.frames.len() -> self.frames[index]
        }
        self.frames.push(frame)
    }
}
overlay_clamp_coordinate: fn(value: Int) -> Int {
    if value > MAX_OVERLAY_COORDINATE -> return MAX_OVERLAY_COORDINATE
    if value < -MAX_OVERLAY_COORDINATE - 1 -> return -MAX_OVERLAY_COORDINATE - 1
    value
}
append_native_node_commands: fn(commands: &[JetDevtoolsNativeDrawCommand], node: NativeOverlayNode, x: Int, y: &Int, bottom: Int, depth: Int) {
    if y >= bottom || commands.len() >= MAX_OVERLAY_NODES -> return
    text := node.label
    if node.value == .Val(value) -> text = "{text}: {value}"
    if node.status == .Val(status) -> text = "{text} [{status}]"
    commands.push(JetDevtoolsNativeDrawCommand.Text(text: text, x: x + depth * 12, y: overlay_clamp_coordinate(y), size: 12, color: JetDevtoolsNativeColor.new(220, 230, 240, 255)))
    y += 16
    loop child in node.children {
        append_native_node_commands(commands, child, x, y, bottom, depth + 1)
        if y >= bottom || commands.len() >= MAX_OVERLAY_NODES -> break
    }
}

// Foundation callbacks installed by jet dev, joining resident session to actual
// window hooks without importing devserver into the generated Prelude. The
// bridge exclusively owns its adapter, host and toggle-key edge state.
NativeOverlayHostBridge: struct {
    session: ResidentDevSession
    adapter: NativeOverlayAdapter
    host: NativeOverlayHost
    toggle_key_state: [String: Bool]

    new: fn(session: ResidentDevSession, release_build: Bool) -> NativeOverlayHostBridge {
        adapter := NativeOverlayAdapter.for_session(session)
        adapter.set_release_build(release_build)
        host := NativeOverlayHost.new()
        host.set_release_build(release_build)
        NativeOverlayHostBridge{session: session, adapter: adapter, host: host, toggle_key_state: [String: Bool]{}}
    }
    frame: fn(self) -> NativeOverlayFrame? { self.host.frame() }

    impl JetDevtoolsNativeHost {
        on_event: fn(&self, session_id: String, event: JetDevtoolsEvent) {
            if session_id != self.session.id() -> return
            update: self.adapter.sync_session(self.session) ?? return
            _: self.host.ingest_update(update)
        }
        on_window_open: fn(&self, window: JetDevtoolsNativeWindow) {
            if window.session_id != self.session.id() -> return
            viewport: NativeOverlayViewport.new(window.width, window.height, 1000) ?? return
            _: self.host.set_viewport(viewport)
        }
        on_window_close: fn(&self, session_id: String) {
            if session_id != self.session.id() -> return
            self.host.close()
        }
        on_input: fn(&self, session_id: String, input: JetDevtoolsNativeInput) -> Bool {
            if session_id != self.session.id() -> return false
            routed: if input == {
                .Key(code, pressed) -> {
                    edge_pressed := pressed
                    if code == self.host.toggle_key {
                        was_pressed: self.toggle_key_state.get(code) ?? false
                        self.toggle_key_state[code] = pressed
                        edge_pressed = pressed && !was_pressed
                    }
                    NativeOverlayInput.Key(code: code, pressed: edge_pressed)
                }
                .Gamepad(gamepad, control, pressed) -> NativeOverlayInput.Gamepad(gamepad: gamepad, control: control, pressed: pressed)
            }
            self.host.route_input(routed) == .Overlay
        }
        on_frame_begin: fn(&self, frame: JetDevtoolsNativeFrame) -> [JetDevtoolsNativeDrawCommand] {
            if frame.session_id != self.session.id() -> return [JetDevtoolsNativeDrawCommand]{}
            viewport: NativeOverlayViewport.new(frame.width, frame.height, 1000) ?? return [JetDevtoolsNativeDrawCommand]{}
            if self.host.viewport != viewport -> _: self.host.set_viewport(viewport)
            self.host.native_draw_commands()
        }
        on_draw: fn(&self, session_id: String, command: JetDevtoolsNativeDrawCommand) {
            if session_id != self.session.id() -> return
            self.host.record_native_draw(command)
        }
        on_frame_end: fn(&self, session_id: String) {}
    }
}
validate_overlay_text: fn(value: String, label: String, allow_empty: Bool) NativeOverlayHostError! {
    if (!allow_empty && value == "") || value.bytes().len() > MAX_OVERLAY_TEXT_BYTES || jettrace_has_control(value) {
        return Err(native_overlay_error("{label} is empty, too long, or contains control text"))
    }
}
