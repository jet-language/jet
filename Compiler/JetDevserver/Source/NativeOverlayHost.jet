    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:212
    fn validate(self: &Self, count: &Usize) -> Unit Err! {
        validate_text(self.panel_id, "native overlay panel id", false)?
        validate_text(self.title, "native overlay panel title", false)?
        validate_text(self.status, "native overlay panel status", true)?
        ids: [String: Bool] := [:]
        for node in &self.nodes -> node.validate(0, count, &ids)?
        return ()
    }
}
// Rust: crates/jet-devserver/src/NativeOverlayHost.rs:224
pub struct NativeOverlayEvent {
    pub protocol: String; pub session_id: String; pub revision: String
    pub sequence: U64; pub observed_at_ms: U64; pub panels: [NativeOverlayPanelFact]
}
impl NativeOverlayEvent {
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:238
    pub fn new(protocol: String, session_id: String, revision: String, sequence: U64, observed_at_ms: U64, panels: [NativeOverlayPanelFact]) -> Self {
        return Self { protocol, session_id, revision, sequence, observed_at_ms, panels }
    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:256
    pub fn current(session_id: String, revision: String, sequence: U64, observed_at_ms: U64, panels: [NativeOverlayPanelFact]) -> Self {
        return Self.new(JET_DEVTOOLS_PROTOCOL, session_id, revision, sequence, observed_at_ms, ^panels)
    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:273
    pub fn validate(self: &Self) -> Unit Err! {
        if self.protocol != JET_DEVTOOLS_PROTOCOL -> return .Err("native overlay protocol must be `{JET_DEVTOOLS_PROTOCOL}`")
        validate_text(self.revision, "native overlay revision", false)?
        if self.sequence == 0 -> return .Err("native overlay event sequence must be greater than zero")
        if self.panels.len() > MAX_OVERLAY_PANELS -> return .Err("native overlay event exceeds its panel budget")
        panel_ids: [String: Bool] := [:]
        count: Usize := 0
        for panel in &self.panels {
            if panel_ids.insert(~panel.panel_id, true).is_some() -> return .Err("native overlay event repeats panel `{panel.panel_id}`")
            panel.validate(&count)?
        }
        return ()
    }
}
// Rust: crates/jet-devserver/src/NativeOverlayHost.rs:301
// Physical viewport with integer DPI scale for reproducible headless geometry.
pub struct NativeOverlayViewport { pub width: U32; pub height: U32; pub scale_milli: U32 }
impl NativeOverlayViewport {
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:311
    pub fn new(width: U32, height: U32, scale_milli: U32) -> Self Err! {
        viewport :: Self { width, height, scale_milli }
        viewport.validate()?
        return viewport
    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:321
    pub fn validate(self: &Self) -> Unit Err! {
        if self.width == 0 || self.height == 0 -> return .Err("native overlay viewport dimensions must be non-zero")
        if self.width > I32.MAX as U32 || self.height > I32.MAX as U32 -> return .Err("native overlay viewport exceeds coordinate range")
        if self.scale_milli == 0 || self.scale_milli > 10_000 -> return .Err("native overlay scale must be between 1 and 10000 milli-units")
        return ()
    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:334
    pub fn scale(self: &Self) -> F64 { return F64.from(self.scale_milli) / 1000.0 }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:338
    pub fn overlay_rect(self: &Self, dock: NativeOverlayDock) -> NativeOverlayRect {
        width :: self.scaled_extent(480, self.width)
        height :: self.scaled_extent(360, self.height)
        return match dock {
            .Floating -> NativeOverlayRect { x: ((self.width - width) / 2) as I32, y: ((self.height - height) / 2) as I32, width, height }
            .Left -> NativeOverlayRect { x: 0, y: 0, width, height: self.height }
            .Right -> NativeOverlayRect { x: (self.width - width) as I32, y: 0, width, height: self.height }
            .Top -> NativeOverlayRect { x: 0, y: 0, width: self.width, height }
            .Bottom -> NativeOverlayRect { x: 0, y: (self.height - height) as I32, width: self.width, height }
        }
    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:375
    fn scaled_extent(self: &Self, logical: U32, available: U32) -> U32 {
        return (U64.from(logical).saturating_mul(U64.from(self.scale_milli)).saturating_add(999) / 1000).max(1).min(U64.from(available)) as U32
    }
}
impl Default for NativeOverlayViewport {
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:386
    fn default() -> Self { return Self { width: 1280, height: 720, scale_milli: 1000 } }
}
// Rust: crates/jet-devserver/src/NativeOverlayHost.rs:395
pub struct NativeOverlayRect { pub x: I32; pub y: I32; pub width: U32; pub height: U32 }
impl NativeOverlayRect {
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:406
    pub fn contains(self: Self, x: I32, y: I32) -> Bool {
        return x >= self.x && y >= self.y && (x as I64) < I64.from(self.x) + I64.from(self.width) && (y as I64) < I64.from(self.y) + I64.from(self.height)
    }
}
