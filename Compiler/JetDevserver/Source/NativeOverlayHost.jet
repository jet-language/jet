// Rust: crates/jet-devserver/src/NativeOverlayHost.rs:1001
fn append_native_node_commands(commands: &[JetDevtoolsNativeDrawCommand], node: &NativeOverlayNode, x: I32, y: &I64, bottom: I64, depth: Usize) -> Unit {
    if y >= bottom || commands.len() >= MAX_OVERLAY_NODES -> return
    indent :: depth.saturating_mul(12).min(I32.MAX as Usize) as I32
    text := ~node.label
    if node.value.as_deref() == .Val(value) { text.push_str(": "); text.push_str(value) }
    if node.status.as_deref() == .Val(status) { text.push_str(" ["); text.push_str(status); text.push(']') }
    commands.push(.Text { text, x: x.saturating_add(indent), y: y.clamp(I64.from(I32.MIN), I64.from(I32.MAX)) as I32, size: 12, color: JetDevtoolsNativeColor.new(220, 230, 240, 255) })
    y = y.saturating_add(16)
    for child in &node.children {
        append_native_node_commands(commands, child, x, y, bottom, depth.saturating_add(1))
        if y >= bottom || commands.len() >= MAX_OVERLAY_NODES -> break
    }
}
// Rust: crates/jet-devserver/src/NativeOverlayHost.rs:1039
// Foundation callbacks installed by jet dev, joining resident session to actual
// window hooks without importing devserver into the generated Prelude.
pub struct NativeOverlayHostBridge {
    session: Arc[ResidentDevSession]; adapter: Mutex[NativeOverlayAdapter]
    host: Mutex[NativeOverlayHost]; toggle_key_state: Mutex[[String: Bool]]
}
impl NativeOverlayHostBridge {
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:1050
    pub fn new(session: Arc[ResidentDevSession], release_build: Bool) -> Self {
        // GATE #4494: native Arc ownership and mutex guards at callback boundaries.
        adapter :: NativeOverlayAdapter.for_session(&session).with_release_build(release_build)
        host :: NativeOverlayHost.new().with_release_build(release_build)
        return Self { session, adapter: Mutex.new(^adapter), host: Mutex.new(^host), toggle_key_state: Mutex.new([:]) }
    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:1061
    pub fn frame(self: &Self) -> NativeOverlayFrame? { return self.host.lock().ok()?.frame().cloned() }
}
impl JetDevtoolsNativeHost for NativeOverlayHostBridge {
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:1067
    fn on_event(self: &Self, session_id: String, _event: JetDevtoolsEvent) -> Unit {
