        viewport :: NativeOverlayViewport.new(frame.width, frame.height, 1000) ?? return []
        host := self.host.lock() ?? return []
        if host.viewport() != viewport -> _ :: host.set_viewport(viewport)
        return host.native_draw_commands()
    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:1155
    fn on_draw(self: &Self, session_id: String, command: JetDevtoolsNativeDrawCommand) -> Unit {
        if session_id != self.session.id() -> return
        if self.host.lock() == .Ok(host) -> host.record_native_draw(^command)
    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:1164
    fn on_frame_end(self: &Self, session_id: String) -> Unit {
        if session_id != self.session.id() -> return
        _ :: self.frame()
    }
}
// Rust: crates/jet-devserver/src/NativeOverlayHost.rs:1172
fn validate_text(value: String, label: String, allow_empty: Bool) -> Unit Err! {
    if (!allow_empty && value.is_empty()) || value.len() > MAX_OVERLAY_TEXT_BYTES || value.chars().any((c) -> c.is_control()) -> return .Err("{label} is empty, too long, or contains control text")
    return ()
}
