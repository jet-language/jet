    pub value: String?; pub status: String?; pub children: [NativeOverlayNode]
    pub action: NativeOverlayAction?
}
impl NativeOverlayNode {
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:90
    pub fn new(id: String, kind: NativeOverlayNodeKind, label: String) -> Self {
        return Self { id, kind, label, value: .None, status: .None, children: [], action: .None }
    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:106
    pub fn text(id: String, label: String) -> Self { return Self.new(id, .Text, label) }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:110
    pub fn with_value(self: Self, value: String) -> Self { self.value = .Val(value); return self }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:115
    pub fn with_status(self: Self, status: String) -> Self { self.status = .Val(status); return self }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:120
    pub fn with_children(self: Self, children: [NativeOverlayNode]) -> Self { self.children = children; return self }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:125
    pub fn with_action(self: Self, action: NativeOverlayAction) -> Self { self.action = .Val(action); return self }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:130
    fn validate(self: &Self, depth: Usize, count: &Usize, ids: &[String: Bool]) -> Unit Err! {
        if depth > MAX_OVERLAY_DEPTH -> return .Err("native overlay node tree exceeds its depth budget")
        validate_text(self.id, "native overlay node id", false)?
        validate_text(self.label, "native overlay node label", false)?
        if ids.insert(~self.id, true).is_some() -> return .Err("native overlay node id `{self.id}` is duplicated")
        count = count.checked_add(1) ?? return .Err("native overlay node count overflowed")
        if count > MAX_OVERLAY_NODES -> return .Err("native overlay frame exceeds its node budget")
        if self.value.as_deref() == .Val(value) -> validate_text(value, "native overlay node value", true)?
        if self.status.as_deref() == .Val(status) -> validate_text(status, "native overlay node status", true)?
        match (self.kind, self.action.as_ref()) {
            (.Action, .None) -> return .Err("native overlay action node `{self.id}` has no typed action")
            (.Action, .Val(action)) -> validate_text(action.action_id, "native overlay action id", false)?
            (_, .Val(_)) -> return .Err("native overlay node `{self.id}` carries an action but is not an action node")
            (_, .None) -> {}
        }
        for child in &self.children -> child.validate(depth + 1, count, ids)?
        return ()
    }
}
// Rust: crates/jet-devserver/src/NativeOverlayHost.rs:184
// Already-typed panel facts; host never infers meaning from panel names.
pub struct NativeOverlayPanelFact {
    pub panel_id: String; pub title: String; pub freshness: U64
    pub status: String; pub nodes: [NativeOverlayNode]
}
impl NativeOverlayPanelFact {
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:196
    pub fn new(panel_id: String, title: String, freshness: U64, status: String, nodes: [NativeOverlayNode]) -> Self {
