//RS //! Typed native GUI/game overlay projection over `jet.devtools.v1`.
//RS //!
//RS //! The host consumes canonical typed session events and returns bounded draw
//RS //! commands to the real game-window backend.  It does not parse the wire
//RS //! envelope or execute actions; `NativeOverlayAdapter` remains the only typed
//RS //! projection bridge.
//RS 
//RS use std::collections::{BTreeMap, BTreeSet, VecDeque};
//RS use std::sync::{Arc, Mutex};
//RS 
//RS use crate::Devtools::{
//RS     JetDevtoolsEvent, JetDevtoolsNativeColor, JetDevtoolsNativeDrawCommand,
//RS     JetDevtoolsNativeFrame, JetDevtoolsNativeHost, JetDevtoolsNativeInput,
//RS     JetDevtoolsNativeWindow, JetDevtoolsSelection, JetDevtoolsViewState,
//RS };
//RS use crate::NativeOverlayAdapter::NativeOverlayAdapter;
//RS use crate::Session::ResidentDevSession;
//RS use crate::TerminalHost::{
//RS     panel_availability as project_panel_availability, JetDevtoolsHostKind,
//RS     JetDevtoolsPanelAvailability, JetDevtoolsPanelCapability, JetDevtoolsPanelDescriptor,
//RS };
//RS 
//RS 
//RS /// The only protocol accepted by this host projection.
//RS pub const JET_DEVTOOLS_PROTOCOL: &str = "jet.devtools.v1";
//RS 
//RS /// Bounded panel count for one native projection.
//RS pub const MAX_OVERLAY_PANELS: usize = 64;
//RS /// Bounded node count across all panel trees in one event/frame.
//RS pub const MAX_OVERLAY_NODES: usize = 512;
//RS /// Bounded tree depth accepted from a panel producer.
//RS pub const MAX_OVERLAY_DEPTH: usize = 32;
//RS /// Bounded retained frame snapshots.
//RS pub const MAX_OVERLAY_FRAMES: usize = 64;
//RS /// Shared devtools text budget for typed labels and identifiers.
//RS pub const MAX_OVERLAY_TEXT_BYTES: usize = 16 * 1024;
//RS 
