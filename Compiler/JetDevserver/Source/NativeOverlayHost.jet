    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:803
    // Canonical commands executed in the real backend's BeginDrawing/EndDrawing context.
    pub fn native_draw_commands(self: &Self) -> [JetDevtoolsNativeDrawCommand] {
        frame :: self.frame() ?? return []
        if self.release_build || !frame.open -> return []
        bounds :: frame.bounds
        bottom :: I64.from(bounds.y) + I64.from(bounds.height)
        commands: [JetDevtoolsNativeDrawCommand] := [].with_capacity(MAX_OVERLAY_NODES.min(64))
        commands.push(.Rectangle { x: bounds.x, y: bounds.y, width: bounds.width as I32, height: bounds.height as I32, color: JetDevtoolsNativeColor.new(16, 20, 28, 232) })
        commands.push(.Text { text: "Jet Devtools [{frame.session_id}]", x: bounds.x.saturating_add(12), y: bounds.y.saturating_add(22), size: 18, color: JetDevtoolsNativeColor.WHITE })
        y := I64.from(bounds.y).saturating_add(46)
        for panel in &frame.panels {
            if y >= bottom || commands.len() >= MAX_OVERLAY_NODES -> break
            commands.push(.Text { text: ~panel.title, x: bounds.x.saturating_add(12), y: y.clamp(I64.from(I32.MIN), I64.from(I32.MAX)) as I32, size: 15, color: JetDevtoolsNativeColor.new(255, 220, 120, 255) })
            y = y.saturating_add(18)
            if !panel.status.is_empty() && y < bottom {
                commands.push(.Text { text: ~panel.status, x: bounds.x.saturating_add(18), y: y.clamp(I64.from(I32.MIN), I64.from(I32.MAX)) as I32, size: 12, color: JetDevtoolsNativeColor.new(170, 190, 210, 255) })
                y = y.saturating_add(16)
            }
            for node in &panel.nodes {
                append_native_node_commands(&commands, node, bounds.x.saturating_add(18), &y, bottom, 0)
                if y >= bottom || commands.len() >= MAX_OVERLAY_NODES -> break
            }
        }
        return commands
    }
    // Rust: crates/jet-devserver/src/NativeOverlayHost.rs:870
    // Focused/open overlays capture all input, including pointers outside bounds.
    pub fn route_input(self: &Self, input: NativeOverlayInput) -> NativeOverlayInputRoute {
        return match input {
            .Toggle -> {
                if self.release_build -> .Game
                else { self.toggle(); .Overlay }
            }
            .Close -> {
                if self.state.open { self.close(); .Overlay } else -> .Game
            }
            .Dock(dock) -> {
