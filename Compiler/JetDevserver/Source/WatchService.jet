struct Watcher {
    paths: Arc<Mutex<[OSPath]>>; control_write: I32; stop: Arc<AtomicBool>; join: JoinHandle<()>?
    // Rust: crates/jet-devserver/src/WatchService.rs:237
    fn new(paths: [OSPath], sender: mpsc.Sender<()>) -> Watcher? {
        pipes := [I32{0}, I32{0}]
        if pipe(&pipes.as_mut_ptr()) != 0 -> return None
        paths :: normalize_paths(^paths); probe :: build_notify_fd(paths)
        if probe < 0 { _ :: close(pipes[0]); _ :: close(pipes[1]); return None }
        _ :: close(probe)
        paths :: Arc.new(Mutex.new(paths)); stop :: Arc.new(AtomicBool.new(false))
        thread_paths :: paths.clone(); thread_stop :: stop.clone()
        join :: thread.Builder.new().name("jet-watch-events").spawn(fn() -> run(pipes[0], ^thread_paths, ^thread_stop, ^sender)).ok()
        if join == .Val(join) -> .Val(Watcher{paths, control_write: pipes[1], stop, join: .Val(join)}) else -> None
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:275
    fn refresh(self, paths: [OSPath]) -> () {
        paths :: normalize_paths(^paths); current := self.paths.lock().unwrap_or_else(fn(e) -> e.into_inner())
