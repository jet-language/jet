// Rust: crates/jet-devserver/src/WatchService.rs:1780
fn detect_renames(changed: &[OSPath], change_kinds: &[ChangeKind], graph: WatchGraph) -> () {
    deleted :: changed.iter().enumerate().filter(fn(pair) -> change_kinds[pair.0] == ChangeKind.Deleted).map(fn(pair) -> (pair.0, pair.1.clone())).collect()
    created :: changed.iter().enumerate().filter(fn(pair) -> change_kinds[pair.0] == ChangeKind.Created).map(fn(pair) -> (pair.0, pair.1.clone())).collect()
    loop (di, dpath) in deleted {
        dparent :: dpath.parent(); dkind :: graph.nodes.get(dpath).map(fn(n) -> n.kind)
        loop (_, cpath) in created {
            if cpath.parent() == dparent && graph.nodes.get(cpath).map(fn(n) -> n.kind) == dkind && dpath != cpath -> change_kinds[di] = .Renamed
        }
    }
}
// Rust: crates/jet-devserver/src/WatchService.rs:1813
fn make_dev_entries(graph: WatchGraph, paths: [OSPath], change_kinds: [ChangeKind], root_kinds: [RootKind], old_digests: [String?], new_digests: [String?]) -> [DevWatchEntry] {
    paths.iter().enumerate().filter_map(fn(pair) -> {
        (index, path) :: pair
        game_kind :: graph.game_kind_for(path).or_else(fn() -> if root_kinds.get(index) == .Val(RootKind.Asset) -> .Val(JetGameChangeKind.Asset) else -> None)
        if game_kind == .Val(game_kind) {
            (old_schema_id, new_schema_id) :: graph.game_schema_ids_for(path)
            .Val(DevWatchEntry{path: path.clone(), change_kind: change_kinds.get(index).copied().map(fn(kind) -> change_kind_name(kind)).unwrap_or("modified"),
                game_kind, old_digest: old_digests.get(index).cloned().flatten(), new_digest: new_digests.get(index).cloned().flatten(), old_schema_id, new_schema_id})
        } else { None }
    }).collect()
}
// Rust: crates/jet-devserver/src/WatchService.rs:1847
fn change_kind_name(kind: ChangeKind) -> String { if kind == { .Created -> "created", .Modified -> "modified", .Deleted -> "deleted", .Renamed -> "renamed", .Stale -> "stale" } }
// Rust: crates/jet-devserver/src/WatchService.rs:1861
// Persist remains at the shared runtime-heap owner.
use jet_foundation.Persist.[PersistEntry, PersistIdentity, PersistOutcome, PersistRejectReason, PersistStore]
use jet_foundation.Persist as Persist
// Rust: crates/jet-devserver/src/WatchService.rs:1869
pub struct SessionSnapshot {
    pub generation: U64; pub artifact_token: String; pub source_id: String; pub build_id: String; pub revision: String; pub world_id: String; pub persist: PersistStore
    // Rust: crates/jet-devserver/src/WatchService.rs:1883
    pub fn new(generation: U64, artifact_token: String, persist: PersistStore) -> SessionSnapshot {
        SessionSnapshot{generation, artifact_token: ^artifact_token, source_id: "", build_id: "", revision: "", world_id: "", persist: ^persist}
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:1895
    pub fn with_lineage(self: SessionSnapshot, source_id: String, build_id: String, revision: String, world_id: String) -> SessionSnapshot {
        self := ^self; self.source_id = ^source_id; self.build_id = ^build_id; self.revision = ^revision; self.world_id = ^world_id; ^self
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:1909
    pub fn with_persist(self: SessionSnapshot, persist: PersistStore) -> SessionSnapshot { self := ^self; self.persist = ^persist; ^self }
    // Rust: crates/jet-devserver/src/WatchService.rs:1914
    pub fn lineage_valid(self) -> Bool { [self.source_id, self.build_id, self.revision, self.world_id].iter().all(fn(value) -> !value.is_empty() && !value.chars().any(fn(c) -> c.is_control())) }
}
// Rust: crates/jet-devserver/src/WatchService.rs:1923
pub enum HotReplacePolicy { Swap; Restart; Pin
    pub fn default() -> HotReplacePolicy { .Swap }
}
// Rust: crates/jet-devserver/src/WatchService.rs:1931
pub enum HotReplacePhase { Begun; Paused; Preflighted; Staged; Committed; RolledBack }
// Rust: crates/jet-devserver/src/WatchService.rs:1941
pub struct HotReplaceTxn {
    prior: SessionSnapshot; shared_prior: PersistStore; candidate: SessionSnapshot?; decisions: [PersistOutcome]
    policy: HotReplacePolicy; phase: HotReplacePhase; failure: String?
    // Rust: crates/jet-devserver/src/WatchService.rs:1951
    pub fn begin(prior: SessionSnapshot) -> HotReplaceTxn { HotReplaceTxn.begin_with_policy(^prior, .Swap) }
    // Rust: crates/jet-devserver/src/WatchService.rs:1955
    pub fn begin_with_policy(prior: SessionSnapshot, policy: HotReplacePolicy) -> HotReplaceTxn {
        HotReplaceTxn{shared_prior: Persist.shared_clone(), prior: ^prior, candidate: None, decisions: [], policy, phase: .Begun, failure: None}
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:1967
    pub fn policy(self) -> HotReplacePolicy { self.policy }
    // Rust: crates/jet-devserver/src/WatchService.rs:1972
    pub fn pause(self: &HotReplaceTxn) -> () Err! {
        if self.phase != HotReplacePhase.Begun -> return Err("hot replacement pause is out of order")
        self.phase = .Paused
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:1983
    pub fn preflight(self: &HotReplaceTxn, candidate: SessionSnapshot) -> () Err! {
        if self.phase != HotReplacePhase.Paused -> return Err("hot replacement preflight requires a paused world")
        if self.policy == HotReplacePolicy.Restart -> return &self.reject("explicit restart requested; swap was not attempted")
        if !candidate.lineage_valid() -> return &self.reject("candidate lineage is incomplete; live identity is unavailable")
        if !self.prior.lineage_valid() -> return &self.reject("prior lineage is incomplete; live identity is unavailable")
        if candidate.source_id != self.prior.source_id -> return &self.reject("source identity changed; restart required")
        if candidate.world_id != self.prior.world_id -> return &self.reject("world identity changed; restart required")
        &self.decisions.clear(); rejected := String?{None}
        loop entry in candidate.persist.entries() {
            outcome :: self.prior.persist.plan_migrate(entry.module, entry.name, entry.shape, entry.payload)
            if outcome == .Rejected{reason, prior} -> rejected = .Val("`{prior.key()}`: {reason.message()}")
            &self.decisions.push(outcome)
        }
        loop old in self.prior.persist.entries() {
            if candidate.persist.get(old.module, old.name).is_none() -> &self.decisions.push(.Reset{
                reason: "binding `{old.stable_key()}` disappeared; prior value reset because its name is no longer present", entry: old.clone()})
        }
        if rejected == .Val(reason) -> return &self.reject("hot replacement preflight rejected: {reason}")
        self.candidate = .Val(candidate.clone()); self.phase = .Preflighted
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:2040
    pub fn stage(self: &HotReplaceTxn) -> () Err! {
        if self.phase != HotReplacePhase.Preflighted || self.candidate.is_none() -> return Err("hot replacement stage requires successful preflight")
        self.phase = .Staged
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:2050
    pub fn commit(self: HotReplaceTxn) -> Result<SessionSnapshot, (SessionSnapshot, String)> {
        self := ^self
        if self.phase != HotReplacePhase.Staged {
            reason :: &self.failure.take().unwrap_or("hot replacement was not staged; prior session kept")
            Persist.shared_replace(^self.shared_prior)
            return .Err((^self.prior, reason))
        }
        if &self.candidate.take() == .Val(candidate) {
            generation :: self.prior.generation + 1
            next := ^candidate; next.generation = generation; next.artifact_token = "gen-{generation}"
            Persist.shared_replace(next.persist.clone()); self.phase = .Committed
            .Ok(^next)
        } else {
            Persist.shared_replace(^self.shared_prior)
            .Err((^self.prior, "hot replacement candidate disappeared"))
        }
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:2075
    pub fn rollback(self: &HotReplaceTxn, reason: String) -> SessionSnapshot {
        self.failure = .Val(^reason); Persist.shared_replace(self.shared_prior.clone()); self.phase = .RolledBack; self.prior.clone()
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:2082
    fn reject(self: &HotReplaceTxn, reason: String) -> () Err! { self.failure = .Val(reason.clone()); Err(^reason) }
    // Rust: crates/jet-devserver/src/WatchService.rs:2088
    pub fn phase(self) -> HotReplacePhase { self.phase }
    // Rust: crates/jet-devserver/src/WatchService.rs:2092
    pub fn decisions(self) -> &[PersistOutcome] { &self.decisions }
    // Rust: crates/jet-devserver/src/WatchService.rs:2096
    pub fn candidate(self) -> SessionSnapshot? { self.candidate.as_ref() }
    // Rust: crates/jet-devserver/src/WatchService.rs:2100
    pub fn prior(self) -> &SessionSnapshot { &self.prior }
}
// Rust: crates/jet-devserver/src/WatchService.rs:2108
pub WATCH_POLL_INTERVAL_MS :: U64{5}
// Rust: crates/jet-devserver/src/WatchService.rs:2112
pub WATCH_COALESCE_MS :: U64{4}
// Rust: crates/jet-devserver/src/WatchService.rs:2117
pub WATCH_SETTLE_MAX_MS :: U64{250}
// Rust: crates/jet-devserver/src/WatchService.rs:2120
pub EDIT_TO_VISIBLE_BUDGET_MS :: U128{2000}
// Rust: crates/jet-devserver/src/WatchService.rs:2123
pub fn within_budget(receipt: InvalidationReceipt) -> Bool { receipt.edit_to_visible_ms.map(fn(ms) -> ms <= EDIT_TO_VISIBLE_BUDGET_MS).unwrap_or(true) }
// Rust: crates/jet-devserver/src/WatchService.rs:2132
pub fn any_stamp_changed(graph: WatchGraph) -> Bool { graph.nodes().any(fn(node) -> { now :: PathStamp.capture(node.path); node.stamp.changed_since(now) }) }
// Rust: crates/jet-devserver/src/WatchService.rs:2142
pub struct SessionBroker {
    source_transactions: Mutex<()>
    pub fn default() -> SessionBroker { SessionBroker{source_transactions: Mutex.new(())} }
    // Rust: crates/jet-devserver/src/WatchService.rs:2147
    pub fn lock_source_transaction(self) -> MutexGuard<()> { self.source_transactions.lock().unwrap() }
}

