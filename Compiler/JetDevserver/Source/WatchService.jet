// Rust: crates/jet-devserver/src/WatchService.rs:53
pub struct PathStamp {
    pub exists: Bool; pub mtime: SystemTime?; pub len: U64?; pub digest: String?
    // Rust: crates/jet-devserver/src/WatchService.rs:60
    pub fn capture(path: OSPath) -> PathStamp {
        if fs.metadata(path) == {
            .Ok(meta) -> {
                digest :: if meta.is_file() -> SHA256.sha256_file_hex(path).ok().map(fn(d) -> "sha256-{d}") else -> None
                PathStamp{exists: true, mtime: meta.modified().ok(), len: .Val(meta.len()), digest}
            }
            .Err(_) -> PathStamp{exists: false, mtime: None, len: None, digest: None}
        }
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:87
    fn changed_since(self, newer: PathStamp) -> Bool {
        if self.exists != newer.exists -> return true
        if (self.digest.as_ref(), newer.digest.as_ref()) == {
            (.Val(previous), .Val(current)) -> previous != current
            (.Val(_), None) | (None, .Val(_)) -> true
            (None, None) -> self.mtime != newer.mtime || self.len != newer.len
        }
    }
}
