    }
    // Rust: crates/jet-devserver/src/WatchService.rs:144
    fn wait(self, timeout: Duration?) -> Bool {
        if selected_os() == "linux" && self.native.is_some() {
            return if timeout == { .Val(timeout) -> self.receiver.recv_timeout(timeout).is_ok(), None -> self.receiver.recv().is_ok() }
        }
        timeout :: timeout.unwrap_or(Duration.from_millis(WATCH_POLL_INTERVAL_MS))
        _ :: self.receiver.recv_timeout(timeout)
        true
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:163
    fn coalesce(self, timeout: Duration) -> () {
        if selected_os() == "linux" && self.native.is_some() {
            deadline :: Instant.now() + timeout
            loop {
                remaining :: deadline.saturating_duration_since(Instant.now())
                if remaining.is_zero() || self.receiver.recv_timeout(remaining).is_err() -> break
            }
            loop { if self.receiver.try_recv().is_err() -> break }
            return
        }
        thread.sleep(timeout)
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:179
    fn wake_handle(self) -> WatchWake { self.wake.clone() }
}
