//RS /// Compatibility wait cadence for targets without a native filesystem event
//RS /// backend. Linux `jet dev` blocks on inotify; this value remains for other
//RS /// std-only watch loops and the latency fixture's configuration contract.
//RS pub const WATCH_POLL_INTERVAL_MS: u64 = 5;
//RS 
//RS /// Bounded save coalescing window. Keep this below the old fixed 30 ms delay;
//RS /// native event waits absorb the editor save burst without an idle sleep.
//RS pub const WATCH_COALESCE_MS: u64 = 4;
//RS 
//RS /// Upper bound on waiting for a save's content to stop changing. A stable
//RS /// save settles after one extra coalesce window; only a save that is still
//RS /// moving (or reads empty right after a truncation) waits longer.
//RS pub const WATCH_SETTLE_MAX_MS: u64 = 250;
//RS 
//RS /// Shared edit-to-visible budget used by browser and native matrices (ms).
//RS pub const EDIT_TO_VISIBLE_BUDGET_MS: u128 = 2000;
//RS 
//RS /// Did this receipt meet the edit-to-visible budget?
//RS pub fn within_budget(receipt: &InvalidationReceipt) -> bool {
//RS     match receipt.edit_to_visible_ms {
//RS         Some(ms) => ms <= EDIT_TO_VISIBLE_BUDGET_MS,
//RS         None => true,
//RS     }
//RS }
//RS 
//RS /// Convenience: one-shot state check used by thin callers that only need to
//RS /// know whether *any* watched path drifted (without building a receipt).
//RS pub fn any_stamp_changed(graph: &WatchGraph) -> bool {
//RS     graph.nodes.values().any(|node| {
//RS         let now = PathStamp::capture(&node.path);
//RS         node.stamp.changed_since(&now)
//RS     })
//RS }
//RS 
//RS /// The session-owned source boundary. Canvas and project transactions use one
//RS /// gate so a client cannot publish a stale result after a newer one.
