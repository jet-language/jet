    // Rust: crates/jet-devserver/src/WatchService.rs:121
    fn new(paths: [OSPath]) -> EventWaiter {
        (sender, receiver) :: mpsc.channel()
        native :: if selected_os() == "linux" -> Watcher.new(^paths, sender.clone()) else -> None
        EventWaiter{receiver, wake: WatchWake{sender}, native}
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:135
    fn refresh(self, paths: [OSPath]) -> () {
