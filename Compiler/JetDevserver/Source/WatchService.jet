fn normalize_paths(paths: [OSPath]) -> [OSPath] { paths := ^paths; &paths.sort(); &paths.dedup(); ^paths }
// Rust: crates/jet-devserver/src/WatchService.rs:311
fn existing_directory(path: OSPath) -> OSPath? {
    candidate := if path.is_dir() -> path.to_path_buf() else -> path.parent().unwrap_or(OSPath(".")).to_path_buf()
    loop {
        if candidate.is_dir() -> return .Val(^candidate)
        if candidate.parent() == .Val(parent) {
            if parent == candidate -> return None
            candidate = parent.to_path_buf()
        } else { return None }
    }
}
// Rust: crates/jet-devserver/src/WatchService.rs:331
fn build_notify_fd(paths: [OSPath]) -> I32 {
    fd :: inotify_init1(IN_NONBLOCK | IN_CLOEXEC)
    if fd < 0 -> return -1
    directories := paths.iter().filter_map(fn(path) -> existing_directory(path)).collect()
    &directories.sort(); &directories.dedup(); watched := 0
    loop directory in directories {
        if CString.new(directory.as_os_str().as_bytes()).ok() == .Val(path) {
            if inotify_add_watch(fd, path.as_ptr(), IN_MASK) >= 0 -> watched += 1
        }
    }
    if watched == 0 { _ :: close(fd); -1 } else { fd }
}
// Rust: crates/jet-devserver/src/WatchService.rs:360
fn run(control_read: I32, paths: Arc<Mutex<[OSPath]>>, stop: Arc<AtomicBool>, sender: mpsc.Sender<()>) -> () {
    notify_fd := { paths :: paths.lock().unwrap_or_else(fn(e) -> e.into_inner()); build_notify_fd(paths) }
    loop {
        if stop.load(Ordering.Acquire) -> break
        fds := [PollFd{fd: control_read, events: POLLIN, revents: 0}, PollFd{fd: notify_fd, events: POLLIN, revents: 0}]
        count :: if notify_fd >= 0 -> 2 else -> 1; result :: poll(&fds.as_mut_ptr(), count, -1)
        if result < 0 {
            if std.io.Error.last_os_error().raw_os_error() == .Val(4) -> continue
            break
        }
        if fds[0].revents != 0 {
            bytes := [U8; 64]{0}; _ :: read(control_read, &bytes.as_mut_ptr(), bytes.len())
            if stop.load(Ordering.Acquire) -> break
            if notify_fd >= 0 -> _ :: close(notify_fd)
            paths :: paths.lock().unwrap_or_else(fn(e) -> e.into_inner()); notify_fd = build_notify_fd(paths)
        }
        if notify_fd >= 0 && (fds[1].revents & (POLLIN | POLLERR | POLLHUP | POLLNVAL)) != 0 {
            buffer := [U8; 8192]{0}; changed := false
            loop {
                count :: read(notify_fd, &buffer.as_mut_ptr(), buffer.len())
                if count <= 0 -> break
                changed = true
            }
            if changed -> _ :: sender.send(())
        }
    }
    if notify_fd >= 0 -> _ :: close(notify_fd)
    _ :: close(control_read)
}
