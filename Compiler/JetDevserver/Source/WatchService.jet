        current = ^paths; drop(^current); self.signal()
    }
    // Rust: crates/jet-devserver/src/WatchService.rs:286
    fn signal(self) -> () { byte :: [U8{1}]; _ :: write(self.control_write, byte.as_ptr(), byte.len()) }
}
