    pub fn refresh_stamps(self: &WatchGraph) -> () { loop node in &self.nodes.values_mut() { node.stamp = PathStamp.capture(node.path) } }
    // Rust: crates/jet-devserver/src/WatchService.rs:863
    pub fn classify(path: OSPath) -> RootKind {
        name :: path.file_name().and_then(fn(n) -> n.to_str()).unwrap_or("").to_ascii_lowercase()
        if name == PACKAGE_FILE || name == PAYLOAD_FILE || name.ends_with(".manifest") || name == "web.manifest.json" -> return .Manifest
        if name == "lock" || name.ends_with(".lock") || path.ends_with(".jet/lock") -> return .Lock
        if path.parent() == .Val(parent) {
            if parent.components().any(fn(c) -> c.as_os_str() == "generated" || c.as_os_str() == ".jet-gen") -> return .Generated
        }
        extension :: path.extension().and_then(fn(e) -> e.to_str()).map(fn(e) -> e.to_ascii_lowercase())
        if extension == {
