impl Watcher.Drop {
    fn drop(self: &Watcher) -> () {
        self.stop.store(true, Ordering.Release); self.signal()
        if &self.join.take() == .Val(join) -> _ :: join.join()
        _ :: close(self.control_write)
    }
}
