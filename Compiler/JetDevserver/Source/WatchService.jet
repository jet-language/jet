// The typed dependency graph of one entry and the watch session over it. A
// session polls the directories that hold its watched paths through
// core.watcher, settles a save before it reports it, then invalidates the
// reverse closure of what changed. The host serializes source transactions
// by holding the session behind its `Shared` guard, and the loader's view of
// the entry's modules comes from the host's `LSPChecker`.
use {
    watch_crypto: core.crypto
    watch_files: core.files
    watch_time: core.time
    watch_watcher: core.watcher
    core.files.[LinkPolicy]
    core.time.[Stopwatch]
    core.watcher.[WatchHandle]
    jet_foundation.[foundation_json_quote]
    jet_lsp.[LSPChecker, LSPOverlay]
    jetpack_foundation.[PACKAGE_FILE]
}

WATCH_POLL_INTERVAL_MS: Int{5}
WATCH_COALESCE_MS: Int{4}
WATCH_SETTLE_MAX_MS: Int{250}
EDIT_TO_VISIBLE_BUDGET_MS: Int{2000}

impl RootKind {
    as_str: fn(self) -> String Never! {
        if self == {
            .Import -> "import"
            .Asset -> "asset"
            .HTML -> "html"
            .Style -> "style"
            .Manifest -> "manifest"
            .Lock -> "lock"
            .Generated -> "generated"
            .BuildInput -> "build_input"
            .TargetFact -> "target_fact"
        }
    }
}

impl ChangeKind {
    as_str: fn(self) -> String Never! {
        if self == {
            .Created -> "created"
            .Modified -> "modified"
            .Deleted -> "deleted"
            .Renamed -> "renamed"
            .Stale -> "stale"
        }
    }
}

// What one path looked like at one poll: a file carries the digest of its
// bytes, so a save that keeps the size and time is still seen.
PathStamp: struct {
    exists: Bool
    modified_ns: Int?
    size: Int?
    digest: String?

    changed_since: fn(self, newer: PathStamp) -> Bool Never! {
        if self.exists != newer.exists -> return true
        if self.digest == .Val(previous) {
            if newer.digest == .Val(current) -> return previous != current
            return true
        }
        if newer.digest != None -> return true
        self.modified_ns != newer.modified_ns || self.size != newer.size
    }
}

watch_stamp_missing: fn() -> PathStamp Never! {
    PathStamp{exists: false, modified_ns: None, size: None, digest: None}
}

watch_stamp_capture: fn(path: String) -> PathStamp {
    stat: watch_files.stat(path, links: Val(LinkPolicy.Follow)) ?? return watch_stamp_missing()
    digest: if stat.is_file -> watch_file_digest(path) else -> None
    PathStamp{exists: true, modified_ns: Val(stat.modified.to_unix_ns() ?? 0), size: Val(stat.size), digest: digest}
}

watch_file_digest: fn(path: String) -> String? {
    bytes: watch_files.read_bytes(path) ?? return None
    Val("sha256-{watch_crypto.sha256(bytes).hex()}")
}

watch_stamps: fn(paths: [String]) -> [PathStamp] {
    stamps := [PathStamp]{}
    loop path in paths -> stamps.push(watch_stamp_capture(path))
    stamps
}

// The nearest existing directory that holds `path`.
watch_existing_directory: fn(path: String) -> String? {
    candidate := if watch_files.is_dir(path) -> watch_files.normalize(path) else -> watch_files.dirname(path)
    loop {
        if candidate == "" -> return None
        if watch_files.is_dir(candidate) -> return Val(candidate)
        parent: watch_files.dirname(candidate)
        if parent == candidate -> return None
        candidate = parent
    }
}

watch_directories: fn(paths: [String]) -> [String] {
    seen := [String:Bool]{}
    loop path in paths {
        if watch_existing_directory(path) == .Val(directory) -> seen[directory] = true
    }
    directories := seen.keys().to_list()
    directories.sort()
    directories
}

// One file watch per existing directory that holds a watched path; a
// directory that cannot be watched is left out.
WatchEvents: struct {
    directories: [String]
    handles: [WatchHandle]

    open: fn(paths: [String]) -> WatchEvents {
        events := WatchEvents{directories: [String]{}, handles: [WatchHandle]{}}
        events.refresh(paths)
        events
    }

    refresh: fn(&self, paths: [String]) {
        directories: watch_directories(paths)
        if directories == self.directories && self.handles.len() > 0 -> return
        loop handle in self.handles -> handle.cancel()
        handles := [WatchHandle]{}
        loop directory in directories {
            if watch_watcher.files(directory) == .Ok(handle) -> handles.push(handle)
        }
        self.handles = handles
        self.directories = directories
    }

    // Drains every handle, then says whether any reported a change.
    changed: fn(self) -> Bool {
        any := false
        loop handle in self.handles {
            if handle.poll().len() > 0 -> any = true
        }
        any
    }

    wait: fn(self, timeout_ms: Int?) -> Bool {
        clock: watch_time.start()
        loop {
            if self.changed() -> return true
            interval := WATCH_POLL_INTERVAL_MS
            if timeout_ms == .Val(limit) {
                remaining: limit - clock.elapsed_millis()
                if remaining <= 0 -> return false
                if remaining < interval -> interval = remaining
            }
            watch_time.sleep(watch_time.duration_ms(interval))
        }
    }

    coalesce: fn(self, ms: Int) {
        watch_time.sleep(watch_time.duration_ms(ms))
        _: self.changed()
    }
}

DevWatchEntry: struct {
    path: String
    change_kind: String
    game_kind: String
    old_digest: String?
    new_digest: String?
}

InvalidationReceipt: struct {
    generation: Int
    changed: [String]
    closure: [String]
    kinds: [String]
    change_kinds: [String]
    content_digests: [String?]
    dev_entries: [DevWatchEntry]
    edit_to_visible_ms: Int?

    render: fn(self) -> String Never! {
        elapsed: if self.edit_to_visible_ms == .Val(ms) -> "{ms}" else -> "null"
        "{{\"generation\":{self.generation},\"changed\":[{watch_json_strings(self.changed)}],\"closure\":[{watch_json_strings(self.closure)}],\"kinds\":[{watch_json_strings(self.kinds)}],\"change_kinds\":[{watch_json_strings(self.change_kinds)}],\"content_digests\":[{watch_json_optional_strings(self.content_digests)}],\"dev_entries\":[{watch_json_dev_entries(self.dev_entries)}],\"edit_to_visible_ms\":{elapsed}}}"
    }
}

watch_json_optional: fn(value: String?) -> String Never! {
    if value == .Val(text) -> foundation_json_quote(text) else -> "null"
}

watch_json_strings: fn(items: [String]) -> String Never! {
    parts := [String]{}
    loop item in items -> parts.push(foundation_json_quote(item))
    parts.join(",")
}

watch_json_optional_strings: fn(items: [String?]) -> String Never! {
    parts := [String]{}
    loop item in items -> parts.push(watch_json_optional(item))
    parts.join(",")
}

watch_json_dev_entries: fn(entries: [DevWatchEntry]) -> String Never! {
    parts := [String]{}
    loop entry in entries {
        parts.push("{{\"path\":{foundation_json_quote(entry.path)},\"change_kind\":{foundation_json_quote(entry.change_kind)},\"game_kind\":{foundation_json_quote(entry.game_kind)},\"old_digest\":{watch_json_optional(entry.old_digest)},\"new_digest\":{watch_json_optional(entry.new_digest)}}}")
    }
    parts.join(",")
}

WatchNode: struct {
    path: String
    kind: RootKind
    stamp: PathStamp
    is_dir: Bool
}

WatchGraph: struct {
    nodes: [String:WatchNode]
    asset_roots: [String:Bool]
    runtime_input_roots: [String:Bool]
    reverse: [String:[String:Bool]]
    forward: [String:[String:Bool]]
    entry: String?

    new: fn() -> WatchGraph Never! {
        WatchGraph{
            nodes: [String:WatchNode]{}, asset_roots: [String:Bool]{}, runtime_input_roots: [String:Bool]{},
            reverse: [String:[String:Bool]]{}, forward: [String:[String:Bool]]{}, entry: None,
        }
    }

    entry_path: fn(self) -> String? Never! { self.entry }

    node_count: fn(self) -> Int Never! { self.nodes.len() }

    // The nodes in path order.
    node_list: fn(self) -> [WatchNode] {
        paths := self.nodes.keys().to_list()
        paths.sort()
        out := [WatchNode]{}
        loop path in paths {
            if self.nodes.get(path) == .Val(node) -> out.push(node)
        }
        out
    }

    watched_paths: fn(self) -> [String] {
        paths := self.nodes.keys().to_list()
        paths.sort()
        paths
    }

    upsert: fn(&self, path: String, kind: RootKind) { self.upsert_with_dir_hint(path, kind, false) }

    upsert_with_dir_hint: fn(&self, path: String, kind: RootKind, dir_hint: Bool) {
        is_dir: dir_hint || watch_files.is_dir(path)
        self.nodes[path] = WatchNode{path: path, kind: kind, stamp: watch_stamp_capture(path), is_dir: is_dir}
    }

    set_stamp: fn(&self, path: String, stamp: PathStamp) {
        if self.nodes.get(path) == .Val(node) {
            updated := node
            updated.stamp = stamp
            self.nodes[path] = updated
        }
    }

    // A node that exists now takes its current shape; a directory becomes an
    // asset sentinel.
    reshape: fn(&self, path: String, is_dir: Bool, as_asset: Bool) {
        if self.nodes.get(path) == .Val(node) {
            updated := node
            updated.is_dir = is_dir
            if as_asset && is_dir -> updated.kind = RootKind.Asset
            self.nodes[path] = updated
        }
    }

    stamp_size: fn(self, path: String) -> Int {
        if self.nodes.get(path) == .Val(node) {
            if node.stamp.size == .Val(size) -> return size
        }
        0
    }

    link: fn(&self, source_path: String, target_path: String) {
        targets := self.forward.get(source_path) ?? [String:Bool]{}
        targets[target_path] = true
        self.forward[source_path] = targets
        sources := self.reverse.get(target_path) ?? [String:Bool]{}
        sources[source_path] = true
        self.reverse[target_path] = sources
    }

    link_from_entry: fn(&self, path: String) {
        entry: self.entry_path() ?? return
        self.link(entry, path)
    }

    set_entry: fn(&self, entry: String) {
        self.entry = Val(entry)
        self.upsert(entry, RootKind.Import)
    }

    mark_runtime_root: fn(&self, path: String) { self.runtime_input_roots[path] = true }

    register_asset_root: fn(&self, raw_path: String) {
        root: watch_canonicalize_loose(raw_path)
        self.asset_roots[root] = true
        visited := [String:Bool]{}
        self.add_asset_tree(root, visited)
    }

    add_asset_tree: fn(&self, raw_path: String, visited: &[String:Bool]) {
        path: watch_canonicalize_loose(raw_path)
        if visited.has_key(path) -> return
        visited[path] = true
        self.upsert(path, RootKind.Asset)
        if !watch_files.is_dir(path) -> return
        loop child in watch_children(path) -> self.add_asset_tree(child, visited)
    }

    discover_asset_tree: fn(&self) {
        roots := self.asset_roots.keys().to_list()
        roots.sort()
        visited := [String:Bool]{}
        loop root in roots -> self.add_new_asset_tree(root, visited)
    }

    add_new_asset_tree: fn(&self, raw_path: String, visited: &[String:Bool]) {
        path: watch_canonicalize_loose(raw_path)
        if visited.has_key(path) -> return
        visited[path] = true
        is_dir: watch_files.is_dir(path)
        exists: watch_files.exists(path)
        if self.nodes.has_key(path) {
            if exists -> self.reshape(path, is_dir, false)
        } else {
            self.nodes[path] = WatchNode{path: path, kind: RootKind.Asset, stamp: watch_stamp_missing(), is_dir: is_dir}
        }
        if !is_dir -> return
        loop child in watch_children(path) -> self.add_new_asset_tree(child, visited)
    }

    discover_runtime_input_trees: fn(&self) {
        roots := self.runtime_input_roots.keys().to_list()
        roots.sort()
        visited := [String:Bool]{}
        loop root in roots -> self.add_new_runtime_tree(root, visited)
    }

    add_new_runtime_tree: fn(&self, raw_path: String, visited: &[String:Bool]) {
        path: watch_canonicalize_loose(raw_path)
        if visited.has_key(path) -> return
        visited[path] = true
        exists: watch_files.exists(path)
        expected_dir := false
        if !exists && self.nodes.get(path) == .Val(node) -> expected_dir = node.is_dir && !node.stamp.exists
        is_dir: watch_files.is_dir(path) || expected_dir
        if self.nodes.has_key(path) {
            if exists -> self.reshape(path, is_dir, true)
        } else {
            kind: if is_dir -> RootKind.Asset else -> WatchGraph.classify(path)
            self.nodes[path] = WatchNode{path: path, kind: kind, stamp: watch_stamp_missing(), is_dir: is_dir}
        }
        self.link_from_entry(path)
        if !is_dir -> return
        loop child in watch_children(path) -> self.add_new_runtime_tree(child, visited)
    }

    // The seeds and every path that reaches one through reverse edges.
    closure_of: fn(self, seeds: [String]) -> [String] {
        seen := [String:Bool]{}
        loop seed in seeds -> seen[seed] = true
        frontier := seen.keys().to_list()
        loop frontier.len() > 0 {
            found := [String:Bool]{}
            loop path in frontier {
                if self.reverse.get(path) == .Val(dependents) {
                    loop dependent in dependents.keys() {
                        if !seen.has_key(dependent) -> found[dependent] = true
                    }
                }
            }
            loop dependent in found.keys() -> seen[dependent] = true
            frontier = found.keys().to_list()
        }
        result := seen.keys().to_list()
        result.sort()
        result
    }

    refresh_stamps: fn(&self) {
        loop path in self.watched_paths() -> self.set_stamp(path, watch_stamp_capture(path))
    }

    classify: fn(path: String) -> RootKind Never! {
        name: watch_ascii_lower(watch_files.basename(path))
        if name == PACKAGE_FILE || name.ends_with(".manifest") || name == "web.manifest.json" -> return RootKind.Manifest
        if name == "lock" || name.ends_with(".lock") || path.ends_with(".jet/lock") -> return RootKind.Lock
        parents: "/{watch_files.dirname(path)}/"
        if parents.contains("/generated/") || parents.contains("/.jet-gen/") -> return RootKind.Generated
        if watch_extension(name) == {
            "jet" -> RootKind.Import
            "html" | "htm" -> RootKind.HTML
            "css" -> RootKind.Style
            "png" | "jpg" | "jpeg" | "gif" | "svg" | "webp" | "woff" | "woff2" | "ttf" | "otf" -> RootKind.Asset
            "toml" | "json" | "yaml" | "yml" -> RootKind.BuildInput
            else -> if name.starts_with("target.") || name.contains("target_fact") -> RootKind.TargetFact else -> RootKind.BuildInput
        }
    }

    // The graph of the entry and the files it depends on: its manifest, lock,
    // shell, style and target fact, each dependency, what the HTML shells
    // reference and the files the sources read at run time.
    from_entry: fn(entry_path: String, dependencies: [String]) -> WatchGraph {
        graph := WatchGraph.new()
        entry: watch_canonicalize_loose(entry_path)
        graph.set_entry(entry)
        html_paths := [String]{}
        entry_dir: watch_files.dirname(entry)
        project: watch_manifest_root(entry_dir) ?? entry_dir
        stem: watch_files.stem(entry)
        graph.add_extra(watch_files.join(project, PACKAGE_FILE), RootKind.Manifest)
        graph.add_extra(watch_files.join(project, ".jet/lock"), RootKind.Lock)
        shell: watch_files.join(entry_dir, "{stem}.html")
        graph.add_extra(shell, RootKind.HTML)
        html_paths.push(shell)
        graph.add_extra(watch_files.join(project, "{stem}.css"), RootKind.Style)
        graph.add_extra(watch_files.join(project, "target.fact"), RootKind.TargetFact)
        loop dependency in dependencies {
            path: watch_canonicalize_loose(dependency)
            if path == entry -> next
            kind: WatchGraph.classify(path)
            graph.upsert(path, kind)
            graph.link(entry, path)
            if kind == RootKind.HTML -> html_paths.push(path)
        }
        graph.scan_html_references(html_paths)
        graph.scan_runtime_inputs()
        graph
    }

    // A manifest, lock or shell is watched before it exists; the rest only
    // once they do.
    add_extra: fn(&self, path: String, kind: RootKind) {
        expected: kind == RootKind.Manifest || kind == RootKind.Lock || kind == RootKind.HTML
        if !expected && !watch_files.exists(path) -> return
        self.upsert(path, kind)
        self.link_from_entry(path)
    }

    // The graph of `entry` over the modules the checker loaded for it.
    discover: fn(entry: String, checker: LSPChecker) -> WatchGraph {
        checked: checker.check(entry, [LSPOverlay]{})
        seen := [String:Bool]{}
        loop loaded in checked.modules {
            if loaded.physical_path != "" {
                seen[loaded.physical_path] = true
            } else if loaded.path != "" {
                seen[loaded.path] = true
            }
        }
        dependencies := seen.keys().to_list()
        dependencies.sort()
        WatchGraph.from_entry(entry, dependencies)
    }

    scan_runtime_inputs: fn(&self) {
        sources := [String]{}
        nodes: self.node_list()
        loop node in nodes.move() {
            if node.kind == RootKind.Import || watch_extension(watch_ascii_lower(node.path)) == "jet" -> sources.push(node.path)
        }
        base: if self.entry == .Val(entry) -> watch_files.dirname(entry) else -> "."
        inputs := [String:Bool]{}
        loop source in sources {
            if watch_files.read(source) == .Ok(text) {
                loop input in watch_runtime_file_inputs(text) {
                    joined: if watch_files.is_absolute(input.path) -> watch_files.normalize(input.path) else -> watch_files.join(base, input.path)
                    path: watch_canonicalize_loose(joined)
                    inputs[path] = (inputs.get(path) ?? false) || input.is_dir
                }
            }
        }
        paths := inputs.keys().to_list()
        paths.sort()
        visited := [String:Bool]{}
        loop path in paths -> self.add_runtime_input_node(path, visited, inputs.get(path) ?? false, true)
    }

    add_runtime_input_node: fn(&self, raw_path: String, visited: &[String:Bool], dir_hint: Bool, register_root: Bool) {
        path: watch_canonicalize_loose(raw_path)
        if visited.has_key(path) -> return
        visited[path] = true
        exists: watch_files.exists(path)
        is_dir: watch_files.is_dir(path) || (dir_hint && !exists)
        if self.nodes.has_key(path) {
            if exists -> self.reshape(path, is_dir, true)
        } else {
            kind: if is_dir -> RootKind.Asset else -> WatchGraph.classify(path)
            self.upsert_with_dir_hint(path, kind, dir_hint && !exists)
        }
        if register_root && dir_hint -> self.mark_runtime_root(path)
        self.link_from_entry(path)
        if !is_dir -> return
        loop child in watch_children(path) -> self.add_runtime_input_node(child, visited, false, false)
    }

    scan_html_references: fn(&self, roots: [String]) {
        visited := [String:Bool]{}
        loop root in roots -> self.add_reference_tree(root, visited)
    }

    add_reference_tree: fn(&self, raw_path: String, visited: &[String:Bool]) {
        path: watch_canonicalize_loose(raw_path)
        if visited.has_key(path) -> return
        visited[path] = true
        self.upsert(path, WatchGraph.classify(path))
        self.link_from_entry(path)
        source: watch_files.read(path) ?? return
        parent: watch_files.dirname(path)
        loop reference in watch_referenced_paths(path, source) {
            if watch_local_reference_path(parent, reference) == .Val(child) -> self.add_reference_tree(child, visited)
        }
    }
}

// The children of a directory in path order; an unreadable one has none.
watch_children: fn(path: String) -> [String] {
    entries: watch_files.list_dir(path) ?? return [String]{}
    children := [String]{}
    loop entry in entries.move() -> children.push(entry.path)
    children.sort()
    children
}

// The nearest directory at or above `start` that holds a package manifest.
watch_manifest_root: fn(start: String) -> String? {
    candidate := watch_files.normalize(start)
    loop {
        if watch_files.is_file(watch_files.join(candidate, PACKAGE_FILE)) -> return Val(candidate)
        parent: watch_files.dirname(candidate)
        if parent == candidate || parent == "" -> return None
        candidate = parent
    }
}

// The canonical path when it exists, else the path made absolute.
watch_canonicalize_loose: fn(path: String) -> String {
    if watch_files.canonicalize(path) == .Ok(found) -> return found
    if watch_files.is_absolute(path) -> return watch_files.normalize(path)
    watch_files.normalize(watch_files.join(watch_files.cwd() ?? ".", path))
}

watch_ascii_lower: fn(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() {
        if byte >= 65 && byte <= 90 -> out.push(byte + 32) else -> out.push(byte)
    }
    String.from_bytes(out) ?? ""
}

// The text after the last `.` of a file name, or "".
watch_extension: fn(name: String) -> String Never! {
    bytes: name.bytes()
    at := bytes.len() - 1
    loop at >= 0 {
        if bytes[at] == 47 -> return ""
        if bytes[at] == 46 -> return String.from_bytes(bytes.slice(at + 1, bytes.len())) ?? ""
        at -= 1
    }
    ""
}

watch_is_space: fn(byte: U8) -> Bool Never! { byte == 32 || byte == 9 || byte == 10 || byte == 13 }

watch_is_word: fn(byte: U8) -> Bool Never! {
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

watch_is_attribute_name: fn(byte: U8) -> Bool Never! { watch_is_word(byte) || byte == 45 }

watch_skip_space: fn(bytes: [U8], start: Int) -> Int Never! {
    cursor := start
    loop cursor < bytes.len() && watch_is_space(bytes[cursor]) -> cursor += 1
    cursor
}

// The first index at or after `start` where `needle` begins, or -1.
watch_find: fn(bytes: [U8], needle: [U8], start: Int) -> Int Never! {
    if needle.len() == 0 -> return -1
    at := start
    loop at + needle.len() <= bytes.len() {
        matched := true
        loop index in 0..<needle.len() {
            if bytes[at + index] != needle[index] {
                matched = false
                break
            }
        }
        if matched -> return at
        at += 1
    }
    -1
}

watch_text: fn(bytes: [U8], start: Int, end: Int) -> String Never! {
    String.from_bytes(bytes.slice(start, end)) ?? ""
}

RuntimeFileInput: struct {
    path: String
    is_dir: Bool
}

WatchQuoted: struct {
    value: String
    end: Int
}

// The literal paths a source hands to the file-reading calls, each marked
// when the call reads a directory.
watch_runtime_file_inputs: fn(source: String) -> [RuntimeFileInput] Never! {
    bytes: source.bytes()
    inputs := [String:Bool]{}
    watch_scan_method(bytes, "copy", false, inputs)
    watch_scan_method(bytes, "copy_dir", true, inputs)
    watch_scan_method(bytes, "exists", false, inputs)
    watch_scan_method(bytes, "is_dir", true, inputs)
    watch_scan_method(bytes, "list_dir", true, inputs)
    watch_scan_method(bytes, "read", false, inputs)
    watch_scan_method(bytes, "read_bytes", false, inputs)
    watch_scan_method(bytes, "walk", true, inputs)
    watch_scan_method(bytes, "glob", false, inputs)
    watch_scan_method(bytes, "stat", false, inputs)
    watch_scan_method(bytes, "fixture", false, inputs)
    watch_scan_method(bytes, "golden", false, inputs)
    watch_scan_method(bytes, "corpus", true, inputs)
    watch_scan_method(bytes, "corpus_entries", true, inputs)
    paths := inputs.keys().to_list()
    paths.sort()
    out := [RuntimeFileInput]{}
    loop path in paths.move() {
        is_dir: inputs.get(path) ?? false
        out.push(RuntimeFileInput{path: path, is_dir: is_dir})
    }
    out
}

watch_scan_method: fn(bytes: [U8], method: String, is_dir: Bool, inputs: &[String:Bool]) Never! {
    marker: ".{method}".bytes()
    offset := 0
    loop {
        start: watch_find(bytes, marker, offset)
        if start < 0 -> break
        cursor := start + marker.len()
        if cursor < bytes.len() && watch_is_word(bytes[cursor]) {
            offset = cursor
            next
        }
        cursor = watch_skip_space(bytes, cursor)
        if cursor >= bytes.len() || bytes[cursor] != 40 {
            offset = cursor
            next
        }
        cursor = watch_skip_space(bytes, cursor + 1)
        if watch_quoted_literal(bytes, cursor) == .Val(quoted) {
            value: quoted.value
            if value != "" && !value.contains("{{") && !value.contains("}}") && !value.contains("://") {
                inputs[value] = (inputs.get(value) ?? false) || is_dir
            }
            offset = quoted.end + 1
        } else {
            offset = cursor + 1
        }
    }
}

watch_quoted_literal: fn(bytes: [U8], start: Int) -> WatchQuoted? Never! {
    if start >= bytes.len() -> return None
    quote: bytes[start]
    if quote != 39 && quote != 34 -> return None
    cursor := start + 1
    loop cursor < bytes.len() {
        if bytes[cursor] == 92 {
            cursor += 2
        } else if bytes[cursor] == quote {
            return Val(WatchQuoted{value: watch_text(bytes, start + 1, cursor), end: cursor})
        } else {
            cursor += 1
        }
    }
    None
}

// A reference an HTML or CSS file makes to a local file, resolved against
// `base`; remote, inline and script URLs are not files.
watch_local_reference_path: fn(base: String, raw: String) -> String? {
    bytes: raw.trim().bytes()
    cut := bytes.len()
    loop (index, byte) in bytes {
        if byte == 63 || byte == 35 {
            cut = index
            break
        }
    }
    reference: watch_text(bytes, 0, cut).trim()
    if reference == "" -> return None
    loop prefix in ["//", "data:", "blob:", "http:", "https:", "mailto:", "javascript:"] {
        if reference.starts_with(prefix) -> return None
    }
    if reference.contains("\\") -> return None
    relative := reference
    loop relative.starts_with("/") -> relative = relative.slice(1, relative.len())
    Val(watch_canonicalize_loose(watch_files.join(base, relative)))
}

watch_referenced_paths: fn(path: String, source: String) -> [String] Never! {
    references := [String]{}
    extension: watch_extension(watch_ascii_lower(watch_files.basename(path)))
    markup: extension == "html" || extension == "htm"
    if markup {
        loop attribute in ["src", "href", "poster", "srcset"] {
            watch_extract_values(source, attribute, 61, false, attribute == "srcset", references)
        }
    }
    if markup || extension == "css" -> watch_extract_values(source, "url", 40, false, false, references)
    if extension == "js" || extension == "mjs" {
        watch_extract_values(source, "from", 0, false, false, references)
        watch_extract_values(source, "import", 0, true, false, references)
    }
    references
}

// Every value that follows `keyword` (and the `delimiter` byte, when it is
// not 0), quoted or bare, compared without case.
watch_extract_values: fn(source: String, keyword: String, delimiter: Int, optional_parentheses: Bool, split_srcset: Bool, out: &[String]) Never! {
    bytes: source.bytes()
    lower: watch_ascii_lower(source).bytes()
    needle: keyword.bytes()
    offset := 0
    loop {
        start: watch_find(lower, needle, offset)
        if start < 0 -> break
        after_keyword: start + needle.len()
        before_word: start > 0 && watch_is_attribute_name(lower[start - 1])
        after_word: after_keyword < lower.len() && watch_is_attribute_name(lower[after_keyword])
        if before_word || after_word {
            offset = after_keyword
            next
        }
        cursor := watch_skip_space(lower, after_keyword)
        if delimiter != 0 {
            if cursor >= lower.len() || (Int{lower[cursor]}) != delimiter {
                offset = after_keyword
                next
            }
            cursor = watch_skip_space(lower, cursor + 1)
        } else if optional_parentheses && cursor < lower.len() && lower[cursor] == 40 {
            cursor = watch_skip_space(lower, cursor + 1)
        }
        quote := 0
        if cursor < bytes.len() && (bytes[cursor] == 39 || bytes[cursor] == 34) {
            quote = Int{bytes[cursor]}
            cursor += 1
        }
        if quote == 0 && delimiter == 0 {
            offset = after_keyword
            next
        }
        value_end := cursor
        loop value_end < bytes.len() {
            byte: bytes[value_end]
            if quote != 0 {
                if (Int{byte}) == quote -> break
            } else if watch_is_space(byte) || byte == 62 || (delimiter == 40 && byte == 41) {
                break
            }
            value_end += 1
        }
        if cursor < value_end {
            value: watch_text(bytes, cursor, value_end)
            if split_srcset {
                loop candidate in value.split(",").to_list() {
                    word: watch_first_word(candidate)
                    if word != "" -> out.push(word)
                }
            } else {
                out.push(value)
            }
        }
        offset = value_end + 1
    }
}

watch_first_word: fn(text: String) -> String Never! {
    bytes: text.bytes()
    start: watch_skip_space(bytes, 0)
    end := start
    loop end < bytes.len() && !watch_is_space(bytes[end]) -> end += 1
    watch_text(bytes, start, end)
}

// One path a poll saw change, and how.
WatchChange: struct {
    path: String
    kind: ChangeKind
}

// One settled change, with what it was and what it is now.
WatchSettled: struct {
    path: String
    change_kind: ChangeKind
    root_kind: RootKind
    old_digest: String?
    new_digest: String?
}

WatchSession: struct {
    graph: WatchGraph
    generation: Int
    applied_generation: Int
    coalesce_ms: Int
    edit_started: Stopwatch?
    events: WatchEvents

    open: fn(entry: String, checker: LSPChecker) -> WatchSession {
        WatchSession.from_graph(WatchGraph.discover(entry, checker))
    }

    from_graph: fn(&&graph: WatchGraph) -> WatchSession {
        events: WatchEvents.open(graph.watched_paths())
        WatchSession{graph: graph.move(), generation: 0, applied_generation: 0, coalesce_ms: WATCH_COALESCE_MS, edit_started: None, events: events}
    }

    reopen: fn(&self, entry: String, checker: LSPChecker) {
        graph: WatchGraph.discover(entry, checker)
        self.events.refresh(graph.watched_paths())
        self.graph = graph
        self.generation = 0
        self.applied_generation = 0
        self.edit_started = None
    }

    register_asset_root: fn(&self, path: String) {
        self.graph.register_asset_root(path)
        self.events.refresh(self.graph.watched_paths())
    }

    mark_edit_started: fn(&self) { self.edit_started = Val(watch_time.start()) }

    wait_for_change_for: fn(&self, timeout_ms: Int?) -> Bool {
        self.events.refresh(self.graph.watched_paths())
        self.events.wait(timeout_ms)
    }

    // The receipt of what changed since the last poll, once the saves settle;
    // None when nothing did. A generation the host already applied comes
    // back stale, with no closure.
    poll: fn(&self) -> InvalidationReceipt? {
        self.graph.discover_asset_tree()
        self.graph.discover_runtime_input_trees()
        self.events.refresh(self.graph.watched_paths())
        changes := [WatchChange]{}
        nodes: self.graph.node_list()
        loop node in nodes.move() {
            now: watch_stamp_capture(node.path)
            if !node.stamp.changed_since(now) -> next
            if !node.stamp.exists && !now.exists -> next
            kind: if {
                !node.stamp.exists -> ChangeKind.Created
                !now.exists -> ChangeKind.Deleted
                else -> ChangeKind.Modified
            }
            changes.push(WatchChange{path: node.path, kind: kind})
        }
        watch_detect_renames(changes, self.graph)
        if changes.len() == 0 -> return None
        if self.edit_started == None -> self.edit_started = Val(watch_time.start())
        self.events.coalesce(self.coalesce_ms)
        changed_paths := [String]{}
        loop change in changes -> changed_paths.push(watch_files.normalize(change.path))
        self.settle(changed_paths)
        rows := [WatchSettled]{}
        loop change in changes.move() {
            root_kind := WatchGraph.classify(change.path)
            is_dir := watch_files.is_dir(change.path)
            previous := watch_stamp_missing()
            if self.graph.nodes.get(change.path) == .Val(node) {
                root_kind = node.kind
                is_dir = node.is_dir
                previous = node.stamp
            }
            now: watch_stamp_capture(change.path)
            if !previous.changed_since(now) && change.kind != ChangeKind.Renamed -> next
            if root_kind == RootKind.Asset && is_dir {
                runtime_root: self.graph.runtime_input_roots.has_key(change.path)
                transition: change.kind == ChangeKind.Created || change.kind == ChangeKind.Deleted
                if !(runtime_root && transition) {
                    // Directory nodes are discovery sentinels; files carry resource changes.
                    self.graph.set_stamp(change.path, now)
                    next
                }
            }
            rows.push(WatchSettled{path: change.path, change_kind: change.kind, root_kind: root_kind, old_digest: previous.digest, new_digest: now.digest})
        }
        if rows.len() == 0 -> return None
        self.generation += 1
        generation: self.generation
        stale: generation <= self.applied_generation
        if !stale {
            loop row in rows {
                if self.graph.nodes.has_key(row.path) -> self.graph.set_stamp(row.path, watch_stamp_capture(row.path)) else -> self.graph.upsert(row.path, WatchGraph.classify(row.path))
            }
        }
        dev_entries: watch_dev_entries(rows, stale)
        changed := [String]{}
        kinds := [String]{}
        change_names := [String]{}
        digests := [String?]{}
        loop row in rows.move() {
            kinds.push(row.root_kind.as_str())
            change_names.push(if stale -> ChangeKind.Stale.as_str() else -> row.change_kind.as_str())
            digests.push(if stale -> None else -> row.new_digest)
            changed.push(row.path)
        }
        if stale {
            return Val(InvalidationReceipt{
                generation: generation, changed: changed, closure: [String]{}, kinds: kinds, change_kinds: change_names,
                content_digests: digests, dev_entries: dev_entries, edit_to_visible_ms: None,
            })
        }
        closure: self.graph.closure_of(changed)
        edit_to_visible_ms := Int?{None}
        if self.edit_started == .Val(started) -> edit_to_visible_ms = Val(started.elapsed_millis())
        self.edit_started = None
        Val(InvalidationReceipt{
            generation: generation, changed: changed, closure: closure, kinds: kinds, change_kinds: change_names,
            content_digests: digests, dev_entries: dev_entries, edit_to_visible_ms: edit_to_visible_ms,
        })
    }

    // Waits until the changed paths stop changing, past a save that
    // truncated a file before writing it, for at most WATCH_SETTLE_MAX_MS.
    settle: fn(self, paths: [String]) {
        clock: watch_time.start()
        previous := watch_stamps(paths)
        loop clock.elapsed_millis() < WATCH_SETTLE_MAX_MS {
            truncated := false
            loop (index, path) in paths {
                if (previous[index].size ?? -1) == 0 && self.graph.stamp_size(path) > 0 -> truncated = true
            }
            self.events.coalesce(self.coalesce_ms)
            current: watch_stamps(paths)
            if current == previous && !truncated -> return
            previous = current
        }
    }

    // Acknowledges `receipt` with the dependencies its rebuild loaded; a
    // change to the set of imports rediscovers the graph.
    acknowledge_with_dependencies: fn(&self, receipt: InvalidationReceipt, dependencies: [String], checker: LSPChecker) {
        entry: self.graph.entry_path() ?? {
            self.acknowledge(receipt, checker)
            return
        }
        desired := [String:Bool]{}
        desired[entry] = true
        loop dependency in dependencies {
            path: watch_canonicalize_loose(dependency)
            if WatchGraph.classify(path) == RootKind.Import -> desired[path] = true
        }
        current := [String:Bool]{}
        nodes: self.graph.node_list()
        loop node in nodes {
            if node.kind == RootKind.Import -> current[node.path] = true
        }
        topology_changed := false
        loop path in desired.keys() {
            if !current.has_key(path) -> topology_changed = true
        }
        loop path in current.keys() {
            if !desired.has_key(path) -> topology_changed = true
        }
        if topology_changed {
            self.acknowledge(receipt, checker)
            return
        }
        if receipt.generation > self.applied_generation -> self.applied_generation = receipt.generation
        loop dependency in dependencies {
            path: watch_canonicalize_loose(dependency)
            if !self.graph.nodes.has_key(path) -> self.graph.upsert(path, WatchGraph.classify(path))
            self.graph.link(entry, path)
        }
        self.events.refresh(self.graph.watched_paths())
    }

    acknowledge: fn(&self, receipt: InvalidationReceipt, checker: LSPChecker) {
        if receipt.generation > self.applied_generation -> self.applied_generation = receipt.generation
        entry: self.graph.entry_path() ?? return
        discovered: WatchGraph.discover(entry, checker)
        nodes: discovered.node_list()
        loop node in nodes {
            if !self.graph.nodes.has_key(node.path) -> self.graph.upsert(node.path, node.kind)
        }
        targets := discovered.reverse.keys().to_list()
        targets.sort()
        loop target in targets {
            if discovered.reverse.get(target) == .Val(sources) {
                source_paths := sources.keys().to_list()
                source_paths.sort()
                loop source_path in source_paths -> self.graph.link(source_path, target)
            }
        }
        loop path in discovered.runtime_input_roots.keys() -> self.graph.mark_runtime_root(path)
        self.events.refresh(self.graph.watched_paths())
    }

    recover: fn(&self) {
        self.graph.refresh_stamps()
        self.edit_started = None
    }
}

// A deletion beside a creation of the same kind in the same directory is a
// rename.
watch_detect_renames: fn(changes: &[WatchChange], graph: WatchGraph) {
    loop deleted_index in 0..<changes.len() {
        if changes[deleted_index].kind != ChangeKind.Deleted -> next
        deleted_path: changes[deleted_index].path
        deleted_parent: watch_files.dirname(deleted_path)
        deleted_node: graph.nodes.get(deleted_path) ?? next
        renamed := false
        loop change in changes {
            if change.kind != ChangeKind.Created || change.path == deleted_path -> next
            if watch_files.dirname(change.path) != deleted_parent -> next
            if graph.nodes.get(change.path) == .Val(created_node) {
                if created_node.kind == deleted_node.kind -> renamed = true
            }
        }
        if renamed -> changes[deleted_index].kind = ChangeKind.Renamed
    }
}

// The game-facing rows of a receipt: scripts and assets. A stale receipt
// carries no digests.
watch_dev_entries: fn(rows: [WatchSettled], stale: Bool) -> [DevWatchEntry] Never! {
    entries := [DevWatchEntry]{}
    loop row in rows {
        game_kind: if row.root_kind == {
            .Import -> "script"
            .Asset -> "asset"
            .HTML | .Style | .Manifest | .Lock | .Generated | .BuildInput | .TargetFact -> ""
        }
        if game_kind == "" -> next
        entries.push(DevWatchEntry{
            path: row.path, change_kind: row.change_kind.as_str(), game_kind: game_kind,
            old_digest: if stale -> None else -> row.old_digest, new_digest: if stale -> None else -> row.new_digest,
        })
    }
    entries
}

watch_within_budget: fn(receipt: InvalidationReceipt) -> Bool Never! {
    if receipt.edit_to_visible_ms == .Val(ms) -> return ms <= EDIT_TO_VISIBLE_BUDGET_MS
    true
}
