fn notify(state: &ReloadState, notification: TerminalStyleReloadNotification) -> () {
    loop mailbox in &state.subscribers.values_mut() {
        if mailbox.notifications.len() >= MAX_TERMINAL_STYLE_NOTIFICATIONS -> _ :: &mailbox.notifications.pop_front()
        &mailbox.notifications.push_back(notification.clone())
    }
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1270
fn validate_identity(value: String) -> () Err! {
    if value.is_empty() -> return Err("style identity must not be empty")
    if value.len() > MAX_TERMINAL_STYLE_ID_BYTES -> return Err("style identity exceeds {MAX_TERMINAL_STYLE_ID_BYTES} bytes")
    if value.chars().any(fn(c) -> c.is_control()) -> return Err("style identity contains a control character")
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1286
fn validate_sha256(value: String) -> () Err! {
    if value.len() != 64 || !value.bytes().all(fn(byte) -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) -> return Err("style dependency fingerprint must be lowercase SHA-256")
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1297
fn validate_optional_fingerprint(value: String, label: String) -> String TerminalStyleFactError! {
    if value.len() > MAX_TERMINAL_STYLE_ID_BYTES || value.chars().any(fn(c) -> c.is_control()) -> return Err(TerminalStyleFactError.new(.InvalidFingerprint, "{label} is not a bounded stable string"))
    Ok(^value)
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1307
fn frame(output: &String, value: String) -> () { &output.push_str("{value.len()}"); &output.push(':'); &output.push_str(value); &output.push(';') }
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1314
fn bounded_text(value: String, max_bytes: USize) -> String {
    output := ""
    loop character in value.chars() {
        if character.is_control() -> continue
        if output.len() + character.len_utf8() > max_bytes -> break
        &output.push(character)
    }
    ^output
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1328
fn bounded_identity(value: String) -> String { bounded_text(value, MAX_TERMINAL_STYLE_ID_BYTES) }
