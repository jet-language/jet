// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:157
pub struct TerminalCapabilityFacts {
    pub profile: TerminalColorProfile; pub mode: TerminalColorMode; pub is_tty: Bool; pub term_is_dumb: Bool; pub no_color: Bool
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:165
    pub fn default() -> TerminalCapabilityFacts { TerminalCapabilityFacts.new(.Monochrome, .Auto, false, true, false) }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:177
    pub fn new(profile: TerminalColorProfile, mode: TerminalColorMode, is_tty: Bool, term_is_dumb: Bool, no_color: Bool) -> TerminalCapabilityFacts {
        TerminalCapabilityFacts{profile, mode, is_tty, term_is_dumb, no_color}
    }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:196
    pub fn from_environment(term: String?, colorterm: String?, is_tty: Bool, no_color: Bool, mode: TerminalColorMode) -> TerminalCapabilityFacts {
        term := term.unwrap_or("").trim(); colorterm := colorterm.unwrap_or("").trim() // #4303
        term :: term.to_ascii_lowercase(); colorterm :: colorterm.to_ascii_lowercase(); term_is_dumb :: term == "dumb"
        enabled :: if mode == { .Always -> true, .Never -> false, .Auto -> is_tty && !term_is_dumb && !no_color }
        profile :: if !enabled -> TerminalColorProfile.Monochrome else if colorterm == "truecolor" || colorterm == "24bit" -> TerminalColorProfile.TrueColor
            else if term.contains("256color") -> TerminalColorProfile.Ansi256 else -> TerminalColorProfile.Ansi16
        TerminalCapabilityFacts.new(profile, mode, is_tty, term_is_dumb, no_color)
    }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:223
    pub fn color_enabled(self) -> Bool { if self.mode == { .Always -> true, .Never -> false, .Auto -> self.is_tty && !self.term_is_dumb && !self.no_color } }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:234
    pub fn fingerprint(self) -> String {
        canonical :: "terminal-capabilities-v1{TEXT_NUL}profile={self.profile.as_str()};mode={self.mode.as_str()};tty={U8(self.is_tty)};dumb={U8(self.term_is_dumb)};no_color={U8(self.no_color)};"
        SHA256.sha256_hex(canonical.as_bytes())
    }
}
