// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:310
pub struct TerminalStyleFingerprintFacts {
    pub source_id: String; pub source_fingerprint: String; pub dependencies: [TerminalStyleDependency]; pub capabilities: TerminalCapabilityFacts
    pub layout_fingerprint: String; pub type_fingerprint: String; pub fingerprint: String
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:320
    pub fn new(source_id: String, source: String, dependencies: [TerminalStyleDependency], capabilities: TerminalCapabilityFacts, layout_fingerprint: String, type_fingerprint: String) -> TerminalStyleFingerprintFacts TerminalStyleFactError! {
        validate_identity(source_id).map_err(fn(message) -> TerminalStyleFactError.new(.InvalidSourceIdentity, message))
        if source.len() > MAX_TERMINAL_STYLE_SOURCE_BYTES -> return Err(TerminalStyleFactError.new(.SourceTooLarge, "style source exceeds {MAX_TERMINAL_STYLE_SOURCE_BYTES} bytes"))
        if dependencies.len() > MAX_TERMINAL_STYLE_DEPENDENCIES -> return Err(TerminalStyleFactError.new(.TooManyDependencies, "style has {dependencies.len()} dependencies; limit is {MAX_TERMINAL_STYLE_DEPENDENCIES}"))
        dependencies := ^dependencies; &dependencies.sort()
        loop pair in dependencies.windows(2) {
            if pair[0].kind == pair[1].kind && pair[0].id == pair[1].id -> return Err(TerminalStyleFactError.new(.InvalidDependency, "duplicate {pair[0].id} dependency identity"))
        }
        loop dependency in dependencies {
            validate_identity(dependency.id).map_err(fn(message) -> TerminalStyleFactError.new(.InvalidDependency, message))
            validate_sha256(dependency.fingerprint).map_err(fn(message) -> TerminalStyleFactError.new(.InvalidFingerprint, message))
        }
        layout_fingerprint :: validate_optional_fingerprint(^layout_fingerprint, "layout fingerprint")
        type_fingerprint :: validate_optional_fingerprint(^type_fingerprint, "value-type fingerprint")
        source_fingerprint :: SHA256.sha256_hex(source.as_bytes())
        fingerprint :: facts_fingerprint(source_id, source_fingerprint, dependencies, capabilities, layout_fingerprint, type_fingerprint)
        Ok(TerminalStyleFingerprintFacts{source_id: ^source_id, source_fingerprint, dependencies: ^dependencies, capabilities, layout_fingerprint, type_fingerprint, fingerprint})
    }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:399
    pub fn dependency(self, kind: TerminalStyleDependencyKind, id: String) -> TerminalStyleDependency? { self.dependencies.iter().find(fn(d) -> d.kind == kind && d.id == id) }
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:410
fn facts_fingerprint(source_id: String, source_fingerprint: String, dependencies: [TerminalStyleDependency], capabilities: TerminalCapabilityFacts, layout_fingerprint: String, type_fingerprint: String) -> String {
    canonical := "terminal-style-facts-v1{TEXT_NUL}"
    frame(&canonical, source_id); frame(&canonical, source_fingerprint); frame(&canonical, capabilities.fingerprint())
    frame(&canonical, layout_fingerprint); frame(&canonical, type_fingerprint)
    loop dependency in dependencies { frame(&canonical, dependency.kind.as_str()); frame(&canonical, dependency.id); frame(&canonical, dependency.fingerprint) }
    SHA256.sha256_hex(canonical.as_bytes())
}
