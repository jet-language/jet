    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:752
    pub fn as_str(self) -> String { if self == { .SourceIdentityChanged -> "source_identity_changed", .LayoutFingerprintChanged -> "layout_fingerprint_changed", .TypeFingerprintChanged -> "type_fingerprint_changed" } }
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:764
pub enum TerminalStyleChangeKind {
    Initial; Unchanged; StyleOnly; CapabilityOnly; RestartRequired(TerminalStyleRestartReason); Invalid
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:773
    pub fn as_str(self) -> String { if self == { .Initial -> "initial", .Unchanged -> "unchanged", .StyleOnly -> "style_only", .CapabilityOnly -> "capability_only", .RestartRequired(_) -> "restart_required", .Invalid -> "invalid" } }
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:787
pub fn classify_change(previous: TerminalStyleSnapshot?, next: TerminalStyleSnapshot) -> TerminalStyleChangeKind {
    if previous == .Val(previous) {
        if previous.source_id != next.source_id || previous.facts.source_id != next.facts.source_id -> return .RestartRequired(.SourceIdentityChanged)
        if previous.facts.layout_fingerprint != next.facts.layout_fingerprint || !dependencies_equal(previous, next, .Layout) -> return .RestartRequired(.LayoutFingerprintChanged)
        if previous.facts.type_fingerprint != next.facts.type_fingerprint || !dependencies_equal(previous, next, .ValueType) -> return .RestartRequired(.TypeFingerprintChanged)
        if previous.facts.fingerprint == next.facts.fingerprint -> return .Unchanged
        style_inputs_changed :: previous.facts.source_fingerprint != next.facts.source_fingerprint || previous.facts.dependencies != next.facts.dependencies
        if !style_inputs_changed && previous.facts.capabilities != next.facts.capabilities -> return .CapabilityOnly
        .StyleOnly
    } else { .Initial }
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:832
fn dependencies_equal(previous: TerminalStyleSnapshot, next: TerminalStyleSnapshot, kind: TerminalStyleDependencyKind) -> Bool {
    previous.facts.dependencies.iter().filter(fn(d) -> d.kind == kind).map(fn(d) -> (d.id, d.fingerprint))
        .eq(next.facts.dependencies.iter().filter(fn(d) -> d.kind == kind).map(fn(d) -> (d.id, d.fingerprint)))
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:856
pub struct TerminalStyleErrorFact {
    pub code: TerminalStyleErrorCode; pub source_id: String; pub attempted_fingerprint: String?; pub revision: U64; pub message: String
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:864
    pub fn is_bounded(self) -> Bool { self.message.len() <= MAX_TERMINAL_STYLE_ERROR_BYTES && self.source_id.len() <= MAX_TERMINAL_STYLE_ID_BYTES && self.attempted_fingerprint.as_ref().is_none_or(fn(value) -> value.len() == 64) }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:873
    pub fn render(self) -> String { fingerprint :: self.attempted_fingerprint.as_ref().unwrap_or("none"); "{self.code.as_str()} source={self.source_id} revision={self.revision} fingerprint={fingerprint} detail={self.message}" }
}
