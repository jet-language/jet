// PORT-PENDING 0786 crates-jet-devserver-src-terminalstylereload: crates/jet-devserver/src/TerminalStyleReload.rs:1-1963
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! Typed terminal-style live reload state for resident `jet dev` sessions.
//RS //!
//RS //! This module owns only style facts.  Widget trees, focus, cursor, and the
//RS //! application model stay with their host, so replacing a style snapshot can
//RS //! never replace application state.  The reload boundary is deliberately
//RS //! independent of `WatchService`: a later host adapter can feed coalesced
//RS //! edits here without teaching the watcher or renderer about style semantics.
//RS 
//RS use jet_foundation::DataTree::DataTree;
//RS use jet_foundation::JSON::{json_escape, parse_json_with_limit};
//RS use jet_foundation::SHA256;
//RS use std::collections::{BTreeMap, VecDeque};
//RS use std::fmt;
//RS use std::sync::{Arc, Mutex};
//RS 
//RS /// The protocol boundary used by a future devtools host publication.
//RS pub const TERMINAL_STYLE_PROTOCOL: &str = "jet.devtools.v1";
//RS /// Maximum source bytes retained by one style candidate.
//RS pub const MAX_TERMINAL_STYLE_SOURCE_BYTES: usize = 64 * 1024;
//RS /// Maximum bytes retained by the human-readable part of one error fact.
//RS pub const MAX_TERMINAL_STYLE_ERROR_BYTES: usize = 512;
//RS /// Maximum dependency facts carried by one style snapshot.
//RS pub const MAX_TERMINAL_STYLE_DEPENDENCIES: usize = 256;
//RS /// Maximum semantic role entries in one style document.
//RS pub const MAX_TERMINAL_STYLE_ROLES: usize = 32;
//RS /// Maximum stable identity bytes accepted for a style source or dependency.
//RS pub const MAX_TERMINAL_STYLE_ID_BYTES: usize = 256;
//RS /// Maximum pending style subscribers.
//RS pub const MAX_TERMINAL_STYLE_SUBSCRIBERS: usize = 256;
//RS /// Maximum queued notifications retained for one subscriber.
//RS pub const MAX_TERMINAL_STYLE_NOTIFICATIONS: usize = 256;
//RS /// Maximum bytes accepted for one host `/style` request envelope: the
//RS /// bounded style source plus dependency facts and JSON structure.
//RS pub const MAX_TERMINAL_STYLE_REQUEST_BYTES: usize = 256 * 1024;
