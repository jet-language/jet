// Style facts only; widget trees, focus, cursor and application model remain with the host.
use {
    jet_foundation.[foundation_json_escape]
    jet_foundation.JSON.[foundation_json_escape, parse_json_with_limit]
    SHA256: jet_foundation.SHA256
    std.collections.[VecDeque]
    // GATE #4494: shared immutable snapshots and transactional mutex ownership.
    std.sync.[Arc, Mutex]
    core.encoding.[Dyn]
}

TERMINAL_STYLE_PROTOCOL: "jet.devtools.v1"
MAX_TERMINAL_STYLE_SOURCE_BYTES: 64 * 1024
MAX_TERMINAL_STYLE_ERROR_BYTES: 512
MAX_TERMINAL_STYLE_DEPENDENCIES: 256
MAX_TERMINAL_STYLE_ROLES: 32
MAX_TERMINAL_STYLE_ID_BYTES: 256
MAX_TERMINAL_STYLE_SUBSCRIBERS: 256
MAX_TERMINAL_STYLE_NOTIFICATIONS: 256
MAX_TERMINAL_STYLE_REQUEST_BYTES: 256 * 1024
TerminalStyleErrorCode: enum {
    SourceTooLarge; InvalidSourceIdentity; InvalidDependency; InvalidFingerprint; InvalidStyle; TooManyDependencies; TooManyRoles; RevisionOverflow
    as_str: fn(self) -> String {
        if self == { .SourceTooLarge -> "style_source_too_large", .InvalidSourceIdentity -> "style_source_identity"
            .InvalidDependency -> "style_dependency", .InvalidFingerprint -> "style_fingerprint", .InvalidStyle -> "style_parse"
            .TooManyDependencies -> "style_dependency_limit", .TooManyRoles -> "style_role_limit", .RevisionOverflow -> "style_revision_overflow" }
    }
}
impl TerminalStyleErrorCode.Display { display: fn(self) -> String { self.as_str() } }
#Error
TerminalStyleFactError: struct {
    code: TerminalStyleErrorCode; message: String
    new: fn(code: TerminalStyleErrorCode, message: String) -> TerminalStyleFactError {
        TerminalStyleFactError{code, message: bounded_text(message, MAX_TERMINAL_STYLE_ERROR_BYTES)}
    }
}
impl TerminalStyleFactError.Display { display: fn(self) -> String { "{self.code.as_str()}: {self.message}" } }
TerminalColorProfile: enum {
    Monochrome; Ansi16; Ansi256; TrueColor
    as_str: fn(self) -> String { if self == {
        .Monochrome -> "monochrome"
        .Ansi16 -> "ansi16"
        .Ansi256 -> "ansi256"
        .TrueColor -> "truecolor"
    } }
    parse: fn(value: String) -> TerminalColorProfile? {
        value := value.trim() // #4303
        if value.to_ascii_lowercase() == {
            "monochrome" -> .Val(.Monochrome)
            "ansi16" -> .Val(.Ansi16)
            "ansi256" -> .Val(.Ansi256)
            "truecolor" -> .Val(.TrueColor)
            else -> None
        }
    }
    default: fn() -> TerminalColorProfile { .Monochrome }
}
TerminalColorMode: enum {
    Auto; Always; Never
    as_str: fn(self) -> String { if self == {
        .Auto -> "auto"
        .Always -> "always"
        .Never -> "never"
    } }
    parse: fn(value: String) -> TerminalColorMode {
        value := value.trim() // #4303
        if value.to_ascii_lowercase() == {
            "always" -> .Always
            "never" -> .Never
            else -> .Auto
        }
    }
    default: fn() -> TerminalColorMode { .Auto }
}
TerminalCapabilityFacts: struct {
    profile: TerminalColorProfile; mode: TerminalColorMode; is_tty: Bool; term_is_dumb: Bool; no_color: Bool
    default: fn() -> TerminalCapabilityFacts { TerminalCapabilityFacts.new(.Monochrome, .Auto, false, true, false) }
    new: fn(profile: TerminalColorProfile, mode: TerminalColorMode, is_tty: Bool, term_is_dumb: Bool, no_color: Bool) -> TerminalCapabilityFacts {
        TerminalCapabilityFacts{profile, mode, is_tty, term_is_dumb, no_color}
    }
    from_environment: fn(term: String?, colorterm: String?, is_tty: Bool, no_color: Bool, mode: TerminalColorMode) -> TerminalCapabilityFacts {
        term := term.unwrap_or("").trim(); colorterm := colorterm.unwrap_or("").trim() // #4303
        term: term.to_ascii_lowercase(); colorterm: colorterm.to_ascii_lowercase(); term_is_dumb: term == "dumb"
        enabled: if mode == {
            .Always -> true
            .Never -> false
            .Auto -> is_tty && !term_is_dumb && !no_color
        }
        profile: if !enabled -> TerminalColorProfile.Monochrome else if colorterm == "truecolor" || colorterm == "24bit" -> TerminalColorProfile.TrueColor
            else if term.contains("256color") -> TerminalColorProfile.Ansi256 else -> TerminalColorProfile.Ansi16
        TerminalCapabilityFacts.new(profile, mode, is_tty, term_is_dumb, no_color)
    }
    color_enabled: fn(self) -> Bool { if self.mode == {
        .Always -> true
        .Never -> false
        .Auto -> self.is_tty && !self.term_is_dumb && !self.no_color
    } }
    fingerprint: fn(self) -> String {
        canonical: "terminal-capabilities-v1{TEXT_NUL}profile={self.profile.as_str()};mode={self.mode.as_str()};tty={U8(self.is_tty)};dumb={U8(self.term_is_dumb)};no_color={U8(self.no_color)};"
        SHA256.sha256_hex(canonical.as_bytes())
    }
}
TerminalStyleDependencyKind: enum {
    Source; Capability; Layout; ValueType
    as_str: fn(self) -> String { if self == {
        .Source -> "source"
        .Capability -> "capability"
        .Layout -> "layout"
        .ValueType -> "value_type"
    } }
}
TerminalStyleDependency: struct {
    kind: TerminalStyleDependencyKind; id: String; fingerprint: String
    new: fn(kind: TerminalStyleDependencyKind, id: String, fingerprint: String) -> TerminalStyleDependency TerminalStyleFactError! {
        validate_identity(id).map_err((message) -> TerminalStyleFactError.new(.InvalidDependency, message))
        validate_sha256(fingerprint).map_err((message) -> {kind, id: id, fingerprint: fingerprint.move()})
    }
    from_bytes: fn(kind: TerminalStyleDependencyKind, id: String, bytes: [U8]) -> TerminalStyleDependency TerminalStyleFactError! {
        TerminalStyleDependency.new(kind, id, SHA256.sha256_hex(bytes))
    }
}
TerminalStyleFingerprintFacts: struct {
    source_id: String; source_fingerprint: String; dependencies: [TerminalStyleDependency]; capabilities: TerminalCapabilityFacts
    layout_fingerprint: String; type_fingerprint: String; fingerprint: String
    new: fn(source_id: String, source: String, dependencies: [TerminalStyleDependency], capabilities: TerminalCapabilityFacts, layout_fingerprint: String, type_fingerprint: String) -> TerminalStyleFingerprintFacts TerminalStyleFactError! {
        validate_identity(source_id).map_err((message) -> TerminalStyleFactError.new(.InvalidSourceIdentity, message))
        if source.len() > MAX_TERMINAL_STYLE_SOURCE_BYTES -> return Err(TerminalStyleFactError.new(.SourceTooLarge, "style source exceeds {MAX_TERMINAL_STYLE_SOURCE_BYTES} bytes"))
        if dependencies.len() > MAX_TERMINAL_STYLE_DEPENDENCIES -> return Err(TerminalStyleFactError.new(.TooManyDependencies, "style has {dependencies.len()} dependencies; limit is {MAX_TERMINAL_STYLE_DEPENDENCIES}"))
        dependencies := dependencies.move(); dependencies.sort()
        loop pair in dependencies.windows(2) {
            if pair[0].kind == pair[1].kind && pair[0].id == pair[1].id -> return Err(TerminalStyleFactError.new(.InvalidDependency, "duplicate {pair[0].id} dependency identity"))
        }
        loop dependency in dependencies {
            validate_identity(dependency.id).map_err((message) -> TerminalStyleFactError.new(.InvalidDependency, message))
            validate_sha256(dependency.fingerprint).map_err((message) -> TerminalStyleFactError.new(.InvalidFingerprint, message))
        }
        layout_fingerprint: validate_optional_fingerprint(layout_fingerprint, "layout fingerprint")
        type_fingerprint: validate_optional_fingerprint(type_fingerprint, "value-type fingerprint")
        source_fingerprint: SHA256.sha256_hex(source.as_bytes())
        fingerprint: facts_fingerprint(source_id, source_fingerprint, dependencies, capabilities, layout_fingerprint, type_fingerprint)
        Ok(TerminalStyleFingerprintFacts{source_id: source_id.move(), source_fingerprint, dependencies: dependencies, capabilities, layout_fingerprint, type_fingerprint, fingerprint})
    }
    dependency: fn(self, kind: TerminalStyleDependencyKind, id: String) -> TerminalStyleDependency? { self.dependencies.iter().find((d) -> d.kind == kind && d.id == id) }
}
facts_fingerprint: fn(source_id: String, source_fingerprint: String, dependencies: [TerminalStyleDependency], capabilities: TerminalCapabilityFacts, layout_fingerprint: String, type_fingerprint: String) -> String {
    canonical := "terminal-style-facts-v1{TEXT_NUL}"
    frame(canonical, source_id); frame(canonical, source_fingerprint); frame(canonical, capabilities.fingerprint())
    frame(canonical, layout_fingerprint); frame(canonical, type_fingerprint)
    loop dependency in dependencies { frame(canonical, dependency.kind.as_str()); frame(canonical, dependency.id); frame(canonical, dependency.fingerprint) }
    SHA256.sha256_hex(canonical.as_bytes())
}
TerminalStyleEdit: struct {
    source_id: String; source: String; dependencies: [TerminalStyleDependency]; capabilities: TerminalCapabilityFacts
    layout_fingerprint: String; type_fingerprint: String
    new: fn(source_id: String, source: String) -> TerminalStyleEdit {
        TerminalStyleEdit{source_id: source_id.move(), source: source, dependencies: [], capabilities: TerminalCapabilityFacts.default(), layout_fingerprint: "", type_fingerprint: ""}
    }
    with_capabilities: fn(self: TerminalStyleEdit, capabilities: TerminalCapabilityFacts) -> TerminalStyleEdit { self := self.move(); self.capabilities = capabilities; self.move() }
    with_dependencies: fn(self: TerminalStyleEdit, dependencies: [TerminalStyleDependency]) -> TerminalStyleEdit { self := self.move(); self.dependencies = dependencies.move(); self.move() }
    with_layout_fingerprint: fn(self: TerminalStyleEdit, fingerprint: String) -> TerminalStyleEdit { self := self.move(); self.layout_fingerprint = fingerprint.move(); self.move() }
    with_type_fingerprint: fn(self: TerminalStyleEdit, fingerprint: String) -> TerminalStyleEdit { self := self.move(); self.type_fingerprint = fingerprint.move(); self.move() }
    bound_source: fn(self: TerminalStyleEdit) -> TerminalStyleEdit {
        self := self.move()
        if self.source.len() > MAX_TERMINAL_STYLE_SOURCE_BYTES {
            end := USize{0}
            loop character in self.source.chars() { end += character.len_utf8(); if end > MAX_TERMINAL_STYLE_SOURCE_BYTES -> break }
            self.source.truncate(end)
        }
        self.move()
    }
}
TerminalStyleRole: enum {
    Accent; Dim; Success; Warn; Error; Invert; Border; Bold
    as_str: fn(self) -> String { if self == {
        .Accent -> "accent"
        .Dim -> "dim"
        .Success -> "success"
        .Warn -> "warn"
        .Error -> "error"
        .Invert -> "invert"
        .Border -> "border"
        .Bold -> "bold"
    } }
    parse: fn(value: String) -> TerminalStyleRole? { if value == {
        "accent" -> .Val(.Accent)
        "dim" -> .Val(.Dim)
        "success" -> .Val(.Success)
        "warn" -> .Val(.Warn)
        "error" -> .Val(.Error)
        "invert" -> .Val(.Invert)
        "border" -> .Val(.Border)
        "bold" -> .Val(.Bold)
        else -> None
    } }
}
TerminalStyleValue: enum {
    Plain; Sgr(String)
    sgr: fn(self) -> String? { if self == {
        .Plain -> None
        .Sgr(value) -> .Val(value)
    } }
    paint: fn(self, text: String) -> String { if self == {
        .Plain -> text.to_string()
        .Sgr(sgr) -> "{Char{27}}[{sgr}m{text}{Char{27}}[0m"
    } }
}
TerminalStyleDocument: struct {
    roles: [TerminalStyleRole:TerminalStyleValue]
    parse: fn(source: String) -> TerminalStyleDocument TerminalStyleParseError! {
        if source.len() > MAX_TERMINAL_STYLE_SOURCE_BYTES -> return Err(TerminalStyleParseError.new(0, .SourceTooLarge, "style source exceeds {MAX_TERMINAL_STYLE_SOURCE_BYTES} bytes"))
        if source.bytes().any((byte) -> byte.is_ascii_control() && byte != 10 && byte != 13 && byte != 9) -> return Err(TerminalStyleParseError.new(0, .InvalidStyle, "style source contains a control byte"))
        roles := [TerminalStyleRole:TerminalStyleValue]{}
        loop (index, line) in source.lines().enumerate() {
            line_number: index + 1; line := line.trim() // #4303
            if line.is_empty() || line.starts_with('#') || line.starts_with("//") -> next
            (raw_role, raw_value): line.split_once('=').ok_or_else(() -> TerminalStyleParseError.new(line_number, .InvalidStyle, "expected role=value"))
            role_name := raw_role.trim() // #4303
            role: TerminalStyleRole.parse(role_name).ok_or_else(() -> TerminalStyleParseError.new(line_number, .InvalidStyle, "unknown semantic style role"))
            if roles.contains_key(role) -> return Err(TerminalStyleParseError.new(line_number, .InvalidStyle, "style role is declared more than once"))
            if roles.len() >= MAX_TERMINAL_STYLE_ROLES -> return Err(TerminalStyleParseError.new(line_number, .TooManyRoles, "style exceeds {MAX_TERMINAL_STYLE_ROLES} roles"))
            raw_value := raw_value.trim() // #4303
            value: parse_style_value(raw_value).map_err((message) -> TerminalStyleParseError.new(line_number, .InvalidStyle, message))
            roles.insert(role, value)
        }
        if roles.is_empty() -> return Err(TerminalStyleParseError.new(0, .InvalidStyle, "style source declares no semantic roles"))
        Ok(TerminalStyleDocument{roles: roles.move()})
    }
    roles: fn(self) -> [TerminalStyleRole:TerminalStyleValue] { &self.roles }
    value: fn(self, role: TerminalStyleRole) -> TerminalStyleValue? { self.roles.get(role) }
}
#Error
TerminalStyleParseError: struct {
    line: USize; code: TerminalStyleErrorCode; message: String
    new: fn(line: USize, code: TerminalStyleErrorCode, message: String) -> TerminalStyleParseError { TerminalStyleParseError{line, code, message: bounded_text(message, MAX_TERMINAL_STYLE_ERROR_BYTES)} }
}
impl TerminalStyleParseError.Display {
    display: fn(self) -> String { if self.line == 0 -> "{self.code.as_str()}: {self.message}" else -> "{self.code.as_str()} at line {self.line}: {self.message}" }
}
parse_style_value: fn(value: String) -> TerminalStyleValue Err! {
    if value == "plain" -> return Ok(.Plain)
    value: if value == {
        "black" -> "30"
        "red" -> "31"
        "green" -> "32"
        "yellow" -> "33"
        "blue" -> "34"
        "magenta" -> "35"
        "cyan" -> "36"
        "white" -> "37"
        "bold" -> "1"
        "dim" -> "2"
        else -> value
    }
    if value.is_empty() || value.len() > 128 -> return Err("style SGR value is empty or too long")
    normalized := ""
    loop (index, part) in value.split(';').enumerate() {
        if part.is_empty() -> return Err("style SGR value has an empty code")
        code: part.parse<U16>().map_err((_) -> "style SGR value has a non-numeric code")
        if code > 255 -> return Err("style SGR code exceeds 255")
        if index > 0 -> normalized.push(';')
        normalized.push_str("{code}")
    }
    Ok(.Sgr(normalized))
}
TerminalStyleSnapshot: struct {
    revision: U64; source_id: String; roles: [TerminalStyleRole:TerminalStyleValue]; facts: TerminalStyleFingerprintFacts
    fingerprint: fn(self) -> String { self.facts.fingerprint }
    capabilities: fn(self) -> TerminalCapabilityFacts { self.facts.capabilities }
    value: fn(self, role: TerminalStyleRole) -> TerminalStyleValue? { self.roles.get(role) }
    paint: fn(self, role: TerminalStyleRole, text: String) -> String {
        if self.roles.get(role) == .Val(value) { if self.facts.capabilities.color_enabled() -> return value.paint(text) }
        text.to_string()
    }
}
TerminalStyleRestartReason: enum {
    SourceIdentityChanged; LayoutFingerprintChanged; TypeFingerprintChanged
    as_str: fn(self) -> String { if self == {
        .SourceIdentityChanged -> "source_identity_changed"
        .LayoutFingerprintChanged -> "layout_fingerprint_changed"
        .TypeFingerprintChanged -> "type_fingerprint_changed"
    } }
}
TerminalStyleChangeKind: enum {
    Initial; Unchanged; StyleOnly; CapabilityOnly; RestartRequired(TerminalStyleRestartReason); Invalid
    as_str: fn(self) -> String { if self == {
        .Initial -> "initial"
        .Unchanged -> "unchanged"
        .StyleOnly -> "style_only"
        .CapabilityOnly -> "capability_only"
        .RestartRequired(_) -> "restart_required"
        .Invalid -> "invalid"
    } }
}
classify_change: fn(previous: TerminalStyleSnapshot?, next: TerminalStyleSnapshot) -> TerminalStyleChangeKind {
    if previous == .Val(previous) {
        if previous.source_id != next.source_id || previous.facts.source_id != next.facts.source_id -> return .RestartRequired(.SourceIdentityChanged)
        if previous.facts.layout_fingerprint != next.facts.layout_fingerprint || !dependencies_equal(previous, next, .Layout) -> return .RestartRequired(.LayoutFingerprintChanged)
        if previous.facts.type_fingerprint != next.facts.type_fingerprint || !dependencies_equal(previous, next, .ValueType) -> return .RestartRequired(.TypeFingerprintChanged)
        if previous.facts.fingerprint == next.facts.fingerprint -> return .Unchanged
        style_inputs_changed: previous.facts.source_fingerprint != next.facts.source_fingerprint || previous.facts.dependencies != next.facts.dependencies
        if !style_inputs_changed && previous.facts.capabilities != next.facts.capabilities -> return .CapabilityOnly
        .StyleOnly
    } else { .Initial }
}
dependencies_equal: fn(previous: TerminalStyleSnapshot, next: TerminalStyleSnapshot, kind: TerminalStyleDependencyKind) -> Bool {
    previous.facts.dependencies.iter().filter((d) -> d.kind == kind).map((d) -> (_0: d.id, _1: d.fingerprint))
        .eq(next.facts.dependencies.iter().filter((d) -> d.kind == kind).map((d) -> (_0: d.id, _1: d.fingerprint)))
}
TerminalStyleErrorFact: struct {
    code: TerminalStyleErrorCode; source_id: String; attempted_fingerprint: String?; revision: U64; message: String
    is_bounded: fn(self) -> Bool { self.message.len() <= MAX_TERMINAL_STYLE_ERROR_BYTES && self.source_id.len() <= MAX_TERMINAL_STYLE_ID_BYTES && self.attempted_fingerprint.as_ref().is_none_or((value) -> value.len() == 64) }
    render: fn(self) -> String { fingerprint: self.attempted_fingerprint.as_ref().unwrap_or("none"); "{self.code.as_str()} source={self.source_id} revision={self.revision} fingerprint={fingerprint} detail={self.message}" }
}
TerminalStyleReloadReceipt: struct {
    revision: U64; change: TerminalStyleChangeKind; snapshot: Arc<TerminalStyleSnapshot>?; error: TerminalStyleErrorFact?
    applied: fn(self) -> Bool { if self.change == {
        .Initial | .StyleOnly | .CapabilityOnly -> true
        else -> false
    } }
    restart_required: fn(self) -> Bool { if self.change == {
        .RestartRequired(_) -> true
        else -> false
    } }
    rejected: fn(self) -> Bool { self.change == TerminalStyleChangeKind.Invalid }
}
TerminalStyleReloadNotification: struct { revision: U64; change: TerminalStyleChangeKind; prior_fingerprint: String?; candidate_fingerprint: String?; error: TerminalStyleErrorFact? }
TerminalStyleSubscriberId: struct { value: U64 }
#Error
TerminalStyleSubscribeError: enum { LimitReached }
impl TerminalStyleSubscribeError.Display { display: fn(self) -> String { "terminal style subscriber limit reached" } }
SubscriberMailbox: struct { notifications: VecDeque<TerminalStyleReloadNotification> }
ReloadState: struct {
    current: Arc<TerminalStyleSnapshot>?; pending: TerminalStyleEdit?; last_error: TerminalStyleErrorFact?
    next_subscriber: U64; subscribers: [TerminalStyleSubscriberId:SubscriberMailbox]
}
TerminalStyleReload: struct {
    state: Mutex<ReloadState>
    default: fn() -> TerminalStyleReload { TerminalStyleReload.new() }
    new: fn() -> TerminalStyleReload { TerminalStyleReload{state: Mutex.new(ReloadState{current: None, pending: None, last_error: None, next_subscriber: 1, subscribers: {}})} }
    reload: fn(self, edit: TerminalStyleEdit) -> TerminalStyleReloadReceipt {
        state := self.state.lock().unwrap_or_else((poisoned) -> poisoned.into_inner())
        apply_locked(state, edit.bound_source())
    }
    enqueue: fn(self, edit: TerminalStyleEdit) -> () {
        state := self.state.lock().unwrap_or_else((poisoned) -> poisoned.into_inner()); state.pending = .Val(edit.bound_source())
    }
    has_pending: fn(self) -> Bool { self.state.lock().unwrap_or_else((p) -> p.into_inner()).pending.is_some() }
    flush: fn(self) -> TerminalStyleReloadReceipt? {
        state := self.state.lock().unwrap_or_else((p) -> p.into_inner())
        if state.pending.take() == .Val(edit) -> .Val(apply_locked(state, edit)) else -> None
    }
    revision: fn(self) -> U64 { self.state.lock().unwrap_or_else((p) -> p.into_inner()).current.as_ref().map((s) -> s.revision).unwrap_or(0) }
    last_valid: fn(self) -> Arc<TerminalStyleSnapshot>? { self.state.lock().unwrap_or_else((p) -> p.into_inner()).current.clone() }
    error_fact: fn(self) -> TerminalStyleErrorFact? { self.state.lock().unwrap_or_else((p) -> p.into_inner()).last_error.clone() }
    subscribe: fn(self) -> TerminalStyleSubscriberId TerminalStyleSubscribeError! {
        state := self.state.lock().unwrap_or_else((p) -> p.into_inner())
        if state.subscribers.len() >= MAX_TERMINAL_STYLE_SUBSCRIBERS -> return Err(.LimitReached)
        id: TerminalStyleSubscriberId{value: state.next_subscriber}; state.next_subscriber = state.next_subscriber.saturating_add(1)
        state.subscribers.insert(id, SubscriberMailbox{notifications: VecDeque.new()})
        Ok(id)
    }
    unsubscribe: fn(self, id: TerminalStyleSubscriberId) -> Bool {
        state := self.state.lock().unwrap_or_else((p) -> p.into_inner()); state.subscribers.remove(id).is_some()
    }
    drain_notifications: fn(self, id: TerminalStyleSubscriberId) -> [TerminalStyleReloadNotification] {
        state := self.state.lock().unwrap_or_else((p) -> p.into_inner())
        if state.subscribers.get_mut(id) == .Val(mailbox) -> std.mem.take(mailbox.notifications).into_iter().collect() else -> []
    }
    reset: fn(self) -> () { state := self.state.lock().unwrap_or_else((p) -> p.into_inner()); state.current = None; state.pending = None; state.last_error = None }
}
apply_locked: fn(state: ReloadState, edit: TerminalStyleEdit) -> TerminalStyleReloadReceipt {
    current: state.current.clone(); revision: current.as_ref().map((s) -> s.revision).unwrap_or(0)
    attempted_fingerprint: if edit.source.len() <= MAX_TERMINAL_STYLE_SOURCE_BYTES -> .Val(SHA256.sha256_hex(edit.source.as_bytes())) else -> None
    candidate := build_snapshot(edit) ?? {
        fact: TerminalStyleErrorFact{code: err.code(), source_id: bounded_identity(edit.source_id), attempted_fingerprint: attempted_fingerprint.clone(), revision, message: bounded_text(err.message(), MAX_TERMINAL_STYLE_ERROR_BYTES)}
        state.last_error = .Val(fact.clone())
        receipt: TerminalStyleReloadReceipt{revision, change: .Invalid, snapshot: current.clone(), error: .Val(fact.clone())}
        notify(state, TerminalStyleReloadNotification{revision, change: .Invalid, prior_fingerprint: current.as_ref().map((s) -> s.fingerprint().to_string()), candidate_fingerprint: attempted_fingerprint, error: .Val(fact)})
        return receipt
    }
    change: classify_change(current.as_deref(), candidate); candidate_fingerprint: .Val(candidate.fingerprint().to_string())
    if change == {
        .Unchanged -> { state.last_error = None; TerminalStyleReloadReceipt{revision, change, snapshot: current, error: None} }
        .RestartRequired(reason) -> {
            state.last_error = None
            receipt: TerminalStyleReloadReceipt{revision, change: .RestartRequired(reason), snapshot: current.clone(), error: None}
            notify(state, TerminalStyleReloadNotification{revision, change: .RestartRequired(reason), prior_fingerprint: current.as_ref().map((s) -> s.fingerprint().to_string()), candidate_fingerprint, error: None})
            receipt
        }
        .Initial | .StyleOnly | .CapabilityOnly -> {
            if revision.checked_add(1) == .Val(next_revision) {
                candidate.revision = next_revision; snapshot: Arc.new(candidate); state.current = .Val(snapshot.clone()); state.last_error = None
                notify(state, TerminalStyleReloadNotification{revision: next_revision, change, prior_fingerprint: current.as_ref().map((s) -> s.fingerprint().to_string()), candidate_fingerprint: .Val(snapshot.fingerprint().to_string()), error: None})
                TerminalStyleReloadReceipt{revision: next_revision, change, snapshot: .Val(snapshot), error: None}
            } else {
                fact: TerminalStyleErrorFact{code: .RevisionOverflow, source_id: bounded_identity(edit.source_id), attempted_fingerprint: attempted_fingerprint.clone(), revision, message: "style revision counter exhausted"}
                state.last_error = .Val(fact.clone())
                receipt: TerminalStyleReloadReceipt{revision, change: .Invalid, snapshot: current.clone(), error: .Val(fact.clone())}
                notify(state, TerminalStyleReloadNotification{revision, change: .Invalid, prior_fingerprint: current.as_ref().map((s) -> s.fingerprint().to_string()), candidate_fingerprint: attempted_fingerprint, error: .Val(fact)})
                receipt
            }
        }
        .Invalid -> { panic("candidate parsing produced invalid change") }
    }
}
build_snapshot: fn(edit: TerminalStyleEdit) -> TerminalStyleSnapshot BuildError! {
    document: TerminalStyleDocument.parse(edit.source).map_err((error) -> BuildError.Parse(error))
    facts: TerminalStyleFingerprintFacts.new(edit.source_id.clone(), edit.source, edit.dependencies.clone(), edit.capabilities, edit.layout_fingerprint.clone(), edit.type_fingerprint.clone()).map_err((error) -> {revision: 0, source_id: edit.source_id.clone(), roles: document.roles.move(), facts})
}
#Error
BuildError: enum {
    Parse(TerminalStyleParseError); Facts(TerminalStyleFactError)
    code: fn(self) -> TerminalStyleErrorCode { if self == {
        .Parse(error) -> error.code
        .Facts(error) -> error.code
    } }
    message: fn(self) -> String { if self == {
        .Parse(error) -> error.to_string()
        .Facts(error) -> error.to_string()
    } }
}
notify: fn(state: ReloadState, notification: TerminalStyleReloadNotification) -> () {
    loop mailbox in state.subscribers.values_mut() {
        if mailbox.notifications.len() >= MAX_TERMINAL_STYLE_NOTIFICATIONS -> _: mailbox.notifications.pop_front()
        mailbox.notifications.push_back(notification.clone())
    }
}
validate_identity: fn(value: String) Err! {
    if value.is_empty() -> return Err("style identity must not be empty")
    if value.len() > MAX_TERMINAL_STYLE_ID_BYTES -> return Err("style identity exceeds {MAX_TERMINAL_STYLE_ID_BYTES} bytes")
    if value.chars().any((c) -> c.is_control()) -> return Err("style identity contains a control character")
}
validate_sha256: fn(value: String) Err! {
    if value.len() != 64 || !value.bytes().all((byte) -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) -> return Err("style dependency fingerprint must be lowercase SHA-256")
}
validate_optional_fingerprint: fn(value: String, label: String) -> String TerminalStyleFactError! {
    if value.len() > MAX_TERMINAL_STYLE_ID_BYTES || value.chars().any((c) -> c.is_control()) -> return Err(TerminalStyleFactError.new(.InvalidFingerprint, "{label} is not a bounded stable string"))
    Ok(value)
}
frame: fn(output: String, value: String) -> () { output.push_str("{value.len()}"); output.push(':'); output.push_str(value); output.push(';') }
bounded_text: fn(value: String, max_bytes: USize) -> String {
    output := ""
    loop character in value.chars() {
        if character.is_control() -> next
        if output.len() + character.len_utf8() > max_bytes -> break
        output.push(character)
    }
    output.move()
}
bounded_identity: fn(value: String) -> String { bounded_text(value, MAX_TERMINAL_STYLE_ID_BYTES) }
TerminalStyleHostSource: struct {
    source_id: String; capabilities: TerminalCapabilityFacts
    new: fn(source_id: String, capabilities: TerminalCapabilityFacts) -> TerminalStyleHostSource TerminalStyleFactError! {
        validate_identity(source_id).map_err((message) -> {source_id: source_id.move(), capabilities})
    }
}
TerminalStyleHostUnavailableReason: enum {
    SourceNotInjected; NoStyleApplied; MalformedRequest; MissingSource
    as_str: fn(self) -> String { if self == {
        .SourceNotInjected -> "source_not_injected"
        .NoStyleApplied -> "no_style_applied"
        .MalformedRequest -> "malformed_request"
        .MissingSource -> "missing_source"
    } }
}
TerminalStyleHostRejection: enum {
    Invalid(TerminalStyleErrorFact); RestartRequired(TerminalStyleRestartReason)
    code: fn(self) -> String { if self == {
        .Invalid(fact) -> fact.code.as_str()
        .RestartRequired(reason) -> reason.as_str()
    } }
}
#Error
TerminalStyleHostOutcome: enum {
    Applied{revision: U64, change: TerminalStyleChangeKind}; Unavailable(TerminalStyleHostUnavailableReason); Rejected(TerminalStyleHostRejection)
}
TerminalStyleHostAdapter: struct {
    reload: TerminalStyleReload; source: Mutex<TerminalStyleHostSource?>
    default: fn() -> TerminalStyleHostAdapter { TerminalStyleHostAdapter.new() }
    new: fn() -> TerminalStyleHostAdapter { TerminalStyleHostAdapter{reload: TerminalStyleReload.new(), source: Mutex.new(.None)} }
    inject: fn(self, source: TerminalStyleHostSource) -> () {
        guard := self.source.lock().unwrap_or_else((p) -> p.into_inner())
        identity_changed: guard.as_ref().is_some_and((previous) -> previous.source_id != source.source_id)
        guard = .Val(source); drop(guard)
        if identity_changed -> self.reload.reset()
    }
    is_injected: fn(self) -> Bool { self.source.lock().unwrap_or_else((p) -> p.into_inner()).is_some() }
    apply_json: fn(self, body: String) -> (TerminalStyleHostOutcome, String) {
        source: self.source.lock().unwrap_or_else((p) -> p.into_inner()).clone()
        if source == .Val(source) {
            revision: self.reload.revision()
            edit: parse_style_request(body, source, revision) ?? { event: outcome_json(err, None); return (_0: err, _1: event) }
            receipt: self.reload.reload(edit); outcome: host_outcome_from_receipt(receipt)
            event: outcome_json(outcome, receipt.snapshot.as_deref()); (_0: outcome, _1: event)
        } else {
            outcome: TerminalStyleHostOutcome.Unavailable(.SourceNotInjected); event: outcome_json(outcome, None); (_0: outcome, _1: event)
        }
    }
    current_json: fn(self) -> (TerminalStyleHostOutcome, String) {
        if self.reload.last_valid() == .Val(snapshot) {
            outcome: TerminalStyleHostOutcome.Applied{revision: snapshot.revision, change: .Unchanged}
            event: outcome_json(outcome, .Val(snapshot)); (_0: outcome, _1: event)
        } else {
            outcome: TerminalStyleHostOutcome.Unavailable(.NoStyleApplied); event: outcome_json(outcome, None); (_0: outcome, _1: event)
        }
    }
}
malformed_request: fn() -> TerminalStyleHostOutcome { .Unavailable(.MalformedRequest) }
parse_style_request: fn(body: String, source: TerminalStyleHostSource, revision: U64) -> TerminalStyleEdit TerminalStyleHostOutcome! {
    value: parse_json_with_limit(body, MAX_TERMINAL_STYLE_REQUEST_BYTES).map_err((_) -> malformed_request())
    object: object_map(value).map_err((_) -> malformed_request())
    style_source: if object.get("source") == {
        .Val(.Text(text)) -> text.clone()
        else -> { return Err(.Unavailable(.MissingSource)) }
    }
    edit := TerminalStyleEdit.new(source.source_id.clone(), style_source).with_capabilities(source.capabilities)
    if object.get("layout_fingerprint") == .Val(.Text(layout)) -> edit = edit.with_layout_fingerprint(layout.clone())
    if object.get("type_fingerprint") == .Val(.Text(fingerprint)) -> edit = edit.with_type_fingerprint(fingerprint.clone())
    if object.get("dependencies") == .Val(entries) {
        entries: if entries == {
            .Array(entries) -> entries
            else -> { return Err(malformed_request()) }
        }
        dependencies := [TerminalStyleDependency]{}
        loop entry in entries {
            fields: object_map(entry).map_err((_) -> malformed_request())
            kind: if fields.get("kind") == {
                .Val(.Text(kind)) -> parse_dependency_kind(kind).ok_or_else(() -> malformed_request())
                else -> { return Err(malformed_request()) }
            }
            id: if fields.get("id") == {
                .Val(.Text(id)) -> id.clone()
                else -> { return Err(malformed_request()) }
            }
            fingerprint: if fields.get("fingerprint") == {
                .Val(.Text(fingerprint)) -> fingerprint.clone()
                else -> { return Err(malformed_request()) }
            }
            dependency: TerminalStyleDependency.new(kind, id, fingerprint).map_err((error) -> TerminalStyleHostOutcome.Rejected(.Invalid(TerminalStyleErrorFact{
                code: error.code, source_id: bounded_identity(source.source_id), attempted_fingerprint: None, revision, message: error.message})))
            dependencies.push(dependency)
        }
        edit = edit.with_dependencies(dependencies)
    }
    Ok(edit)
}
object_map: fn(value: Dyn) -> [String:Dyn] Err! {
    if value == .Object(fields) -> Ok(fields.iter().cloned().collect()) else -> Err("terminal style request must be an object")
}
parse_dependency_kind: fn(value: String) -> TerminalStyleDependencyKind? { if value == {
    "source" -> .Val(.Source)
    "capability" -> .Val(.Capability)
    "layout" -> .Val(.Layout)
    "value_type" -> .Val(.ValueType)
    else -> None
} }
host_outcome_from_receipt: fn(receipt: TerminalStyleReloadReceipt) -> TerminalStyleHostOutcome {
    if receipt.change == {
        .Initial | .StyleOnly | .CapabilityOnly | .Unchanged -> .Applied{revision: receipt.revision, change: receipt.change}
        .RestartRequired(reason) -> .Rejected(.RestartRequired(reason))
        .Invalid -> {
            fact: receipt.error.clone().unwrap_or_else(() -> {code: .InvalidStyle, source_id: "", attempted_fingerprint: None, revision: receipt.revision, message: "style candidate was rejected"})
            .Rejected(.Invalid(fact))
        }
    }
}
outcome_json: fn(outcome: TerminalStyleHostOutcome, snapshot: TerminalStyleSnapshot?) -> String {
    output := String.with_capacity(256)
    output.push_str("{{\"protocol\":\""); output.push_str(TERMINAL_STYLE_PROTOCOL); output.push('"')
    if outcome == {
        .Applied{revision, change} -> {
            output.push_str(",\"outcome\":\"applied\",\"revision\":{revision},\"change\":\"{change.as_str()}\"")
            if snapshot == .Val(snapshot) -> output.push_str(",\"fingerprint\":\"{foundation_json_escape(snapshot.fingerprint())}\"")
        }
        .Rejected(rejection) -> {
            output.push_str(",\"outcome\":\"rejected\",\"code\":\"{rejection.code()}\"")
            if rejection == .Invalid(fact) -> output.push_str(",\"message\":\"{foundation_json_escape(fact.message)}\"")
        }
        .Unavailable(reason) -> output.push_str(",\"outcome\":\"unavailable\",\"reason\":\"{reason.as_str()}\"")
    }
    output.push('}'); output.move()
}
