// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:559
pub struct TerminalStyleDocument {
    roles: [TerminalStyleRole:TerminalStyleValue]
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:563
    pub fn parse(source: String) -> TerminalStyleDocument TerminalStyleParseError! {
        if source.len() > MAX_TERMINAL_STYLE_SOURCE_BYTES -> return Err(TerminalStyleParseError.new(0, .SourceTooLarge, "style source exceeds {MAX_TERMINAL_STYLE_SOURCE_BYTES} bytes"))
        if source.bytes().any(fn(byte) -> byte.is_ascii_control() && byte != 10 && byte != 13 && byte != 9) -> return Err(TerminalStyleParseError.new(0, .InvalidStyle, "style source contains a control byte"))
        roles := [TerminalStyleRole:TerminalStyleValue]{}
        loop (index, line) in source.lines().enumerate() {
            line_number :: index + 1; line := line.trim() // #4303
            if line.is_empty() || line.starts_with('#') || line.starts_with("//") -> continue
            (raw_role, raw_value) :: line.split_once('=').ok_or_else(fn() -> TerminalStyleParseError.new(line_number, .InvalidStyle, "expected role=value"))
            role_name := raw_role.trim() // #4303
            role :: TerminalStyleRole.parse(role_name).ok_or_else(fn() -> TerminalStyleParseError.new(line_number, .InvalidStyle, "unknown semantic style role"))
            if roles.contains_key(role) -> return Err(TerminalStyleParseError.new(line_number, .InvalidStyle, "style role is declared more than once"))
            if roles.len() >= MAX_TERMINAL_STYLE_ROLES -> return Err(TerminalStyleParseError.new(line_number, .TooManyRoles, "style exceeds {MAX_TERMINAL_STYLE_ROLES} roles"))
            raw_value := raw_value.trim() // #4303
            value :: parse_style_value(raw_value).map_err(fn(message) -> TerminalStyleParseError.new(line_number, .InvalidStyle, message))
            &roles.insert(role, ^value)
        }
        if roles.is_empty() -> return Err(TerminalStyleParseError.new(0, .InvalidStyle, "style source declares no semantic roles"))
        Ok(TerminalStyleDocument{roles: ^roles})
    }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:634
    pub fn roles(self) -> &[TerminalStyleRole:TerminalStyleValue] { &self.roles }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:638
    pub fn value(self, role: TerminalStyleRole) -> TerminalStyleValue? { self.roles.get(role) }
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:646
#Error
pub struct TerminalStyleParseError {
    pub line: USize; pub code: TerminalStyleErrorCode; pub message: String
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:652
    fn new(line: USize, code: TerminalStyleErrorCode, message: String) -> TerminalStyleParseError { TerminalStyleParseError{line, code, message: bounded_text(message, MAX_TERMINAL_STYLE_ERROR_BYTES)} }
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:662
impl TerminalStyleParseError.Display {
    fn display(self) -> String { if self.line == 0 -> "{self.code.as_str()}: {self.message}" else -> "{self.code.as_str()} at line {self.line}: {self.message}" }
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:673
fn parse_style_value(value: String) -> TerminalStyleValue Err! {
    if value == "plain" -> return Ok(.Plain)
    value :: if value == { "black" -> "30", "red" -> "31", "green" -> "32", "yellow" -> "33", "blue" -> "34", "magenta" -> "35", "cyan" -> "36", "white" -> "37", "bold" -> "1", "dim" -> "2", else -> value }
    if value.is_empty() || value.len() > 128 -> return Err("style SGR value is empty or too long")
    normalized := ""
    loop (index, part) in value.split(';').enumerate() {
        if part.is_empty() -> return Err("style SGR value has an empty code")
        code :: part.parse<U16>().map_err(fn(_) -> "style SGR value has a non-numeric code")
        if code > 255 -> return Err("style SGR code exceeds 255")
        if index > 0 -> &normalized.push(';')
        &normalized.push_str("{code}")
    }
    Ok(.Sgr(^normalized))
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:716
pub struct TerminalStyleSnapshot {
    pub revision: U64; pub source_id: String; pub roles: [TerminalStyleRole:TerminalStyleValue]; pub facts: TerminalStyleFingerprintFacts
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:723
    pub fn fingerprint(self) -> String { self.facts.fingerprint }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:727
    pub fn capabilities(self) -> TerminalCapabilityFacts { self.facts.capabilities }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:731
    pub fn value(self, role: TerminalStyleRole) -> TerminalStyleValue? { self.roles.get(role) }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:735
    pub fn paint(self, role: TerminalStyleRole, text: String) -> String {
        if self.roles.get(role) == .Val(value) { if self.facts.capabilities.color_enabled() -> return value.paint(text) }
        text.to_string()
    }
}
