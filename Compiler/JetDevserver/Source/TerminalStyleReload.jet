    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:460
    pub fn with_dependencies(self: TerminalStyleEdit, dependencies: [TerminalStyleDependency]) -> TerminalStyleEdit { self := ^self; self.dependencies = ^dependencies; ^self }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:465
    pub fn with_layout_fingerprint(self: TerminalStyleEdit, fingerprint: String) -> TerminalStyleEdit { self := ^self; self.layout_fingerprint = ^fingerprint; ^self }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:470
    pub fn with_type_fingerprint(self: TerminalStyleEdit, fingerprint: String) -> TerminalStyleEdit { self := ^self; self.type_fingerprint = ^fingerprint; ^self }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:475
    fn bound_source(self: TerminalStyleEdit) -> TerminalStyleEdit {
        self := ^self
        if self.source.len() > MAX_TERMINAL_STYLE_SOURCE_BYTES {
            end := USize{0}
            loop character in self.source.chars() { end += character.len_utf8(); if end > MAX_TERMINAL_STYLE_SOURCE_BYTES -> break }
            &self.source.truncate(end)
        }
        ^self
    }
