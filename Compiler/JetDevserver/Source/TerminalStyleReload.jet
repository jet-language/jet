//RS /// ---------------------------------------------------------------------
//RS /// Host-facing adapter
//RS /// ---------------------------------------------------------------------
//RS ///
//RS /// The kernel above owns style facts only.  `TerminalStyleHostAdapter` is
//RS /// the boring, typed seam a resident host (for example `WebHost`) stores
//RS /// once and delegates its `/style` surface to.  It injects the two facts
//RS /// only a real host producer can supply -- source identity and terminal
//RS /// capability -- accepts one bounded style-update JSON body per call, and
//RS /// returns a typed outcome plus one event JSON string.  It never derives a
//RS /// capability from a client request, never performs a full application
//RS /// reload, and never reimplements parsing, fingerprinting, or change
//RS /// classification: every decision is delegated to `TerminalStyleReload`.
//RS 
//RS /// A real host's typed source identity and terminal capability facts.
//RS /// Capability facts are trusted as supplied: this type never derives them
//RS /// from a request or from the process environment, so a caller cannot make
//RS /// the adapter report a terminal capability the host did not observe.
//RS #[derive(Clone, Debug, Eq, PartialEq)]
//RS pub struct TerminalStyleHostSource {
//RS     pub source_id: String,
//RS     pub capabilities: TerminalCapabilityFacts,
//RS }
//RS 
//RS impl TerminalStyleHostSource {
//RS     pub fn new(
//RS         source_id: impl Into<String>,
//RS         capabilities: TerminalCapabilityFacts,
//RS     ) -> Result<Self, TerminalStyleFactError> {
//RS         let source_id = source_id.into();
//RS         validate_identity(&source_id).map_err(|message| {
//RS             TerminalStyleFactError::new(TerminalStyleErrorCode::InvalidSourceIdentity, message)
//RS         })?;
//RS         Ok(Self {
//RS             source_id,
//RS             capabilities,
//RS         })
//RS     }
//RS }
//RS 
//RS /// Why one `/style` request could not be evaluated at all.  Distinct from
//RS /// `TerminalStyleHostRejection`, which reports a candidate that was
//RS /// evaluated by the kernel and found invalid or restart-requiring.
//RS #[derive(Clone, Copy, Debug, Eq, PartialEq)]
//RS pub enum TerminalStyleHostUnavailableReason {
//RS     /// No real producer has injected a source identity/capability yet.
//RS     SourceNotInjected,
//RS     /// A style has never been applied, so there is no current snapshot.
//RS     NoStyleApplied,
//RS     /// The request body is not valid JSON, or exceeds the bounded envelope.
//RS     MalformedRequest,
//RS     /// The request JSON does not declare a `source` string field.
//RS     MissingSource,
//RS }
//RS 
//RS impl TerminalStyleHostUnavailableReason {
//RS     pub const fn as_str(self) -> &'static str {
//RS         match self {
//RS             Self::SourceNotInjected => "source_not_injected",
//RS             Self::NoStyleApplied => "no_style_applied",
//RS             Self::MalformedRequest => "malformed_request",
//RS             Self::MissingSource => "missing_source",
//RS         }
//RS     }
//RS }
//RS 
//RS /// Why one evaluated style candidate could not be applied by this
//RS /// style-only delegate.
//RS #[derive(Clone, Debug, Eq, PartialEq)]
//RS pub enum TerminalStyleHostRejection {
//RS     /// The candidate failed bounded parsing or fact construction.
//RS     Invalid(TerminalStyleErrorFact),
//RS     /// The candidate is valid but would require a full application
//RS     /// restart; this style-only delegate never performs one.
//RS     RestartRequired(TerminalStyleRestartReason),
//RS }
//RS 
//RS impl TerminalStyleHostRejection {
//RS     pub fn code(&self) -> &'static str {
//RS         match self {
//RS             Self::Invalid(fact) => fact.code.as_str(),
//RS             Self::RestartRequired(reason) => reason.as_str(),
//RS         }
//RS     }
//RS }
//RS 
//RS /// Typed result of one host `/style` delegate call.
//RS #[derive(Clone, Debug, Eq, PartialEq)]
//RS pub enum TerminalStyleHostOutcome {
//RS     /// The candidate replaced (or matched) the resident style snapshot.
//RS     Applied {
//RS         revision: u64,
//RS         change: TerminalStyleChangeKind,
//RS     },
//RS     /// The request could not be evaluated; see
//RS     /// `TerminalStyleHostUnavailableReason`.
//RS     Unavailable(TerminalStyleHostUnavailableReason),
//RS     /// The request was evaluated and rejected; see
//RS     /// `TerminalStyleHostRejection`.
//RS     Rejected(TerminalStyleHostRejection),
//RS }
//RS 
//RS /// Persistent host-facing wrapper.  A resident host owns exactly one
//RS /// instance and delegates its `/style` surface to it instead of
//RS /// reimplementing style parsing, fingerprinting, or change classification.
//RS pub struct TerminalStyleHostAdapter {
//RS     reload: TerminalStyleReload,
//RS     source: Mutex<Option<TerminalStyleHostSource>>,
//RS }
//RS 
//RS impl Default for TerminalStyleHostAdapter {
//RS     fn default() -> Self {
//RS         Self::new()
//RS     }
//RS }
//RS 
//RS impl TerminalStyleHostAdapter {
//RS     pub fn new() -> Self {
//RS         Self {
//RS             reload: TerminalStyleReload::new(),
//RS             source: Mutex::new(None),
//RS         }
//RS     }
//RS 
//RS     /// Inject (or replace) the real host's typed source identity and
//RS     /// terminal capability facts.  Before this is ever called, every
//RS     /// `apply_json` call reports `Unavailable(SourceNotInjected)` rather
//RS     /// than applying against a fabricated default.  Injecting a source
//RS     /// identity that differs from the previously injected one resets the
//RS     /// resident kernel, since that is a bind to a different style source
//RS     /// entirely, not a live edit of the current one; without the reset,
//RS     /// the kernel would classify every future candidate against the old
//RS     /// source's snapshot and stay stuck behind
//RS     /// `RestartRequired(SourceIdentityChanged)` forever.
//RS     pub fn inject(&self, source: TerminalStyleHostSource) {
//RS         let mut guard = self
//RS             .source
//RS             .lock()
//RS             .unwrap_or_else(|poisoned| poisoned.into_inner());
//RS         let identity_changed = guard
//RS             .as_ref()
//RS             .is_some_and(|previous| previous.source_id != source.source_id);
//RS         *guard = Some(source);
//RS         drop(guard);
//RS         if identity_changed {
//RS             self.reload.reset();
//RS         }
//RS     }
//RS 
