//RS             return (outcome, event);
//RS         };
//RS         let revision = self.reload.revision();
//RS         let edit = match parse_style_request(body, &source, revision) {
//RS             Ok(edit) => edit,
//RS             Err(outcome) => {
//RS                 let event = outcome_json(&outcome, None);
//RS                 return (outcome, event);
//RS             }
//RS         };
//RS         let receipt = self.reload.reload(edit);
//RS         let outcome = host_outcome_from_receipt(&receipt);
//RS         let event = outcome_json(&outcome, receipt.snapshot.as_deref());
//RS         (outcome, event)
//RS     }
//RS 
//RS     /// Return the current last-valid style as one applied outcome and event
//RS     /// JSON, or `Unavailable(NoStyleApplied)` when nothing has ever
//RS     /// applied.
//RS     pub fn current_json(&self) -> (TerminalStyleHostOutcome, String) {
//RS         match self.reload.last_valid() {
//RS             Some(snapshot) => {
//RS                 let outcome = TerminalStyleHostOutcome::Applied {
//RS                     revision: snapshot.revision,
//RS                     change: TerminalStyleChangeKind::Unchanged,
//RS                 };
//RS                 let event = outcome_json(&outcome, Some(&*snapshot));
//RS                 (outcome, event)
//RS             }
//RS             None => {
//RS                 let outcome = TerminalStyleHostOutcome::Unavailable(
//RS                     TerminalStyleHostUnavailableReason::NoStyleApplied,
//RS                 );
//RS                 let event = outcome_json(&outcome, None);
//RS                 (outcome, event)
//RS             }
//RS         }
//RS     }
//RS }
