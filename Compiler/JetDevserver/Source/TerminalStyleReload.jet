#Error
enum BuildError {
    Parse(TerminalStyleParseError); Facts(TerminalStyleFactError)
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1246
    fn code(self) -> TerminalStyleErrorCode { if self == { .Parse(error) -> error.code, .Facts(error) -> error.code } }
    // Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1253
    fn message(self) -> String { if self == { .Parse(error) -> error.to_string(), .Facts(error) -> error.to_string() } }
}
