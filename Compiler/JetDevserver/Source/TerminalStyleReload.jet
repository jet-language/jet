// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1546
fn malformed_request() -> TerminalStyleHostOutcome { .Unavailable(.MalformedRequest) }
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1550
fn parse_style_request(body: String, source: TerminalStyleHostSource, revision: U64) -> TerminalStyleEdit TerminalStyleHostOutcome! {
    value :: parse_json_with_limit(body, MAX_TERMINAL_STYLE_REQUEST_BYTES).map_err(fn(_) -> malformed_request())
    object :: object_map(value).map_err(fn(_) -> malformed_request())
    style_source :: if object.get("source") == { .Val(.Text(text)) -> text.clone(), else -> return Err(.Unavailable(.MissingSource)) }
    edit := TerminalStyleEdit.new(source.source_id.clone(), ^style_source).with_capabilities(source.capabilities)
    if object.get("layout_fingerprint") == .Val(.Text(layout)) -> edit = edit.with_layout_fingerprint(layout.clone())
    if object.get("type_fingerprint") == .Val(.Text(fingerprint)) -> edit = edit.with_type_fingerprint(fingerprint.clone())
    if object.get("dependencies") == .Val(entries) {
        entries :: if entries == { .Array(entries) -> entries, else -> return Err(malformed_request()) }
        dependencies := [TerminalStyleDependency]{}
        loop entry in entries {
            fields :: object_map(entry).map_err(fn(_) -> malformed_request())
            kind :: if fields.get("kind") == { .Val(.Text(kind)) -> parse_dependency_kind(kind).ok_or_else(fn() -> malformed_request()), else -> return Err(malformed_request()) }
            id :: if fields.get("id") == { .Val(.Text(id)) -> id.clone(), else -> return Err(malformed_request()) }
            fingerprint :: if fields.get("fingerprint") == { .Val(.Text(fingerprint)) -> fingerprint.clone(), else -> return Err(malformed_request()) }
            dependency :: TerminalStyleDependency.new(kind, ^id, ^fingerprint).map_err(fn(error) -> TerminalStyleHostOutcome.Rejected(.Invalid(TerminalStyleErrorFact{
                code: error.code, source_id: bounded_identity(source.source_id), attempted_fingerprint: None, revision, message: error.message})))
            &dependencies.push(^dependency)
        }
        edit = edit.with_dependencies(^dependencies)
    }
    Ok(^edit)
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1612
fn object_map(value: DataTree) -> [String:DataTree] Err! {
    if value == .Object(fields) -> Ok(fields.iter().cloned().collect()) else -> Err("terminal style request must be an object")
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1619
fn parse_dependency_kind(value: String) -> TerminalStyleDependencyKind? { if value == { "source" -> .Val(.Source), "capability" -> .Val(.Capability), "layout" -> .Val(.Layout), "value_type" -> .Val(.ValueType), else -> None } }
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1629
fn host_outcome_from_receipt(receipt: TerminalStyleReloadReceipt) -> TerminalStyleHostOutcome {
    if receipt.change == {
        .Initial | .StyleOnly | .CapabilityOnly | .Unchanged -> .Applied{revision: receipt.revision, change: receipt.change}
        .RestartRequired(reason) -> .Rejected(.RestartRequired(reason))
        .Invalid -> {
            fact :: receipt.error.clone().unwrap_or_else(fn() -> TerminalStyleErrorFact{code: .InvalidStyle, source_id: "", attempted_fingerprint: None, revision: receipt.revision, message: "style candidate was rejected"})
            .Rejected(.Invalid(fact))
        }
    }
}
// Rust: crates/jet-devserver/src/TerminalStyleReload.rs:1654
fn outcome_json(outcome: TerminalStyleHostOutcome, snapshot: TerminalStyleSnapshot?) -> String {
    output := String.with_capacity(256)
    &output.push_str("{\"protocol\":\""); &output.push_str(TERMINAL_STYLE_PROTOCOL); &output.push('"')
    if outcome == {
        .Applied{revision, change} -> {
            &output.push_str(",\"outcome\":\"applied\",\"revision\":{revision},\"change\":\"{change.as_str()}\"")
            if snapshot == .Val(snapshot) -> &output.push_str(",\"fingerprint\":\"{json_escape(snapshot.fingerprint())}\"")
        }
        .Rejected(rejection) -> {
            &output.push_str(",\"outcome\":\"rejected\",\"code\":\"{rejection.code()}\"")
            if rejection == .Invalid(fact) -> &output.push_str(",\"message\":\"{json_escape(fact.message)}\"")
        }
        .Unavailable(reason) -> &output.push_str(",\"outcome\":\"unavailable\",\"reason\":\"{reason.as_str()}\"")
    }
    &output.push('}'); ^output
}
