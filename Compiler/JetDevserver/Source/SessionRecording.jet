// Rust: crates/jet-devserver/src/SessionRecording.rs:525
pub struct SessionRecording {
    identity: SessionIdentity; limits: SessionRecordingLimits; events: VecDeque<SessionEvent>; retained_bytes: USize
    dropped_events: U64; dropped_bytes: U64; event_limit_reached: Bool; byte_limit_reached: Bool
    first_dropped_sequence: U64?; last_dropped_sequence: U64?; last_sequence: U64?; last_timestamp_ms: U64?; generation: U64
}
impl SessionRecording {
    // Rust: crates/jet-devserver/src/SessionRecording.rs:542
    pub fn new(identity: SessionIdentity) -> Self RecordingError! { Self.with_limits(^identity, SessionRecordingLimits.default()) }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:546
    pub fn with_limits(identity: SessionIdentity, limits: SessionRecordingLimits) -> Self RecordingError! {
        validate_id(identity.source_id, "source_id")?
        validate_id(identity.build_id, "build_id")?
        limits.validate()?
        Self { identity: ^identity, limits, events: VecDeque.new(), retained_bytes: 0, dropped_events: 0, dropped_bytes: 0,
            event_limit_reached: false, byte_limit_reached: false, first_dropped_sequence: .None, last_dropped_sequence: .None,
            last_sequence: .None, last_timestamp_ms: .None, generation: 0 }
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:570
    pub fn identity(self: &Self) -> &SessionIdentity { &self.identity }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:574
    pub fn limits(self: &Self) -> SessionRecordingLimits { self.limits }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:578
    pub fn event_count(self: &Self) -> USize { self.events.len() }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:582
    pub fn generation(self: &Self) -> U64 { self.generation }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:586
    pub fn retained_bytes(self: &Self) -> USize { self.retained_bytes }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:590
    pub fn events(self: &Self) -> Iterator<&SessionEvent> { self.events.iter() }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:595
    pub fn truncation(self: &Self) -> TruncationFacts {
        TruncationFacts { event_limit: self.limits.max_events, byte_limit: self.limits.max_bytes,
            retained_events: self.events.len(), retained_bytes: self.retained_bytes, dropped_events: self.dropped_events,
            dropped_bytes: self.dropped_bytes, event_limit_reached: self.event_limit_reached, byte_limit_reached: self.byte_limit_reached,
            first_dropped_sequence: self.first_dropped_sequence, last_dropped_sequence: self.last_dropped_sequence,
            first_retained_sequence: self.events.front().map((event) -> event.sequence), last_retained_sequence: self.events.back().map((event) -> event.sequence) }
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:614
    pub fn append_event(self: &Self, event: SessionEvent) -> U64 RecordingError! {
        self.validate_next(&event)?
        sequence :: event.sequence
        self.append_event_unchecked(^event)
        sequence
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:623
    pub fn record_envelope(self: &Self, bytes: &[U8]) -> USize RecordingError! {
        if bytes.len() > MAX_RECORDING_BYTES -> return .Err(.EnvelopeTooLarge { bytes: bytes.len(), limit: MAX_RECORDING_BYTES })
        events :: parse_envelope(bytes, &self.identity)?
        self.preflight(&events)?
        count :: events.len()
        for event in events -> self.append_event_unchecked(^event)
        count
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:640
    pub fn replay(self: &Self) -> ReplayCursor { ReplayCursor { identity: ~self.identity, generation: self.generation, position: 0, sequence: .None } }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:651
    pub fn replay_for(self: &Self, identity: &SessionIdentity) -> ReplayCursor RecordingError! {
        validate_id(identity.source_id, "source_id")?
        validate_id(identity.build_id, "build_id")?
        if !self.identity.matches(identity) -> return .Err(.IdentityMismatch { expected: ~self.identity, found: ~identity })
        self.replay()
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:663
    pub fn projection(self: &Self, cursor: &ReplayCursor) -> ReplayProjection RecordingError! {
        cursor.check(self)?
        self.make_projection(cursor)
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:668
    pub fn checkpoint(self: &Self, cursor: &ReplayCursor) -> SessionCheckpoint RecordingError! {
        cursor.check(self)?
        timestamp_ms :: cursor.position.checked_sub(1).and_then((index) -> self.events.get(index)).map((event) -> event.timestamp_ms)
        SessionCheckpoint { identity: ~self.identity, generation: self.generation, position: cursor.position, sequence: cursor.sequence, timestamp_ms,
            first_retained_sequence: self.events.front().map((event) -> event.sequence), last_retained_sequence: self.events.back().map((event) -> event.sequence) }
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:686
    pub fn restore_checkpoint(self: &Self, checkpoint: &SessionCheckpoint) -> ReplayCursor RecordingError! {
        if !self.identity.matches(&checkpoint.identity) -> return .Err(.IdentityMismatch { expected: ~self.identity, found: ~checkpoint.identity })
        if checkpoint.generation != self.generation || checkpoint.first_retained_sequence != self.events.front().map((event) -> event.sequence)
            || checkpoint.last_retained_sequence != self.events.back().map((event) -> event.sequence) || checkpoint.position > self.events.len() -> return .Err(.CheckpointUnavailable)
        actual_sequence :: checkpoint.position.checked_sub(1).and_then((index) -> self.events.get(index)).map((event) -> event.sequence)
        if actual_sequence != checkpoint.sequence -> return .Err(.CheckpointUnavailable)
        ReplayCursor { identity: ~self.identity, generation: self.generation, position: checkpoint.position, sequence: checkpoint.sequence }
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:720
    fn preflight(self: &Self, events: &[SessionEvent]) -> Unit RecordingError! {
        previous_sequence := self.last_sequence
        previous_time := self.last_timestamp_ms
        for event in events {
            bytes :: event.wire_len()
            if bytes > self.limits.max_bytes -> return .Err(.EventTooLarge { bytes, limit: self.limits.max_bytes })
            if previous_sequence == .Val(previous) {
                if event.sequence <= previous -> return .Err(.NonMonotonicSequence { previous, next: event.sequence })
            }
            if previous_time == .Val(previous) {
                if event.timestamp_ms < previous -> return .Err(.NonMonotonicTime { previous, next: event.timestamp_ms })
            }
            previous_sequence = .Val(event.sequence)
            previous_time = .Val(event.timestamp_ms)
        }
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:753
    fn validate_next(self: &Self, event: &SessionEvent) -> Unit RecordingError! {
        bytes :: event.wire_len()
        if bytes > self.limits.max_bytes -> return .Err(.EventTooLarge { bytes, limit: self.limits.max_bytes })
        if self.last_sequence == .Val(previous) {
            if event.sequence <= previous -> return .Err(.NonMonotonicSequence { previous, next: event.sequence })
        }
        if self.last_timestamp_ms == .Val(previous) {
            if event.timestamp_ms < previous -> return .Err(.NonMonotonicTime { previous, next: event.timestamp_ms })
        }
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:780
    fn append_event_unchecked(self: &Self, event: SessionEvent) -> Unit {
        bytes :: event.wire_len()
        self.last_sequence = .Val(event.sequence)
        self.last_timestamp_ms = .Val(event.timestamp_ms)
        self.events.push_back(^event)
        self.retained_bytes = self.retained_bytes.saturating_add(bytes)
        if self.events.len() > self.limits.max_events -> self.event_limit_reached = true
        while self.events.len() > self.limits.max_events || self.retained_bytes > self.limits.max_bytes {
            if self.events.len() > self.limits.max_events -> self.event_limit_reached = true
            if self.retained_bytes > self.limits.max_bytes -> self.byte_limit_reached = true
            evicted :: self.events.pop_front() ?? break
            evicted_bytes :: evicted.wire_len()
            self.retained_bytes = self.retained_bytes.saturating_sub(evicted_bytes)
            self.dropped_events = self.dropped_events.saturating_add(1)
            self.dropped_bytes = self.dropped_bytes.saturating_add(evicted_bytes as U64)
            if self.first_dropped_sequence.is_none() -> self.first_dropped_sequence = .Val(evicted.sequence)
            self.last_dropped_sequence = .Val(evicted.sequence)
        }
        self.generation = self.generation.wrapping_add(1)
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:815
    fn make_projection(self: &Self, cursor: &ReplayCursor) -> ReplayProjection {
        current_index :: cursor.position.checked_sub(1)
        event :: current_index.and_then((index) -> self.events.get(index)).cloned()
        previous_sequence :: cursor.position.checked_sub(2).and_then((index) -> self.events.get(index)).map((event) -> event.sequence)
        next_sequence :: self.events.get(cursor.position).map((event) -> event.sequence)
        ReplayProjection { identity: ~self.identity, position: cursor.position, sequence: cursor.sequence,
            timestamp_ms: event.as_ref().map((event) -> event.timestamp_ms), event: ^event, previous_sequence, next_sequence,
            limits: self.limits, truncation: self.truncation() }
    }
}
// Rust: crates/jet-devserver/src/SessionRecording.rs:841
fn parse_envelope(bytes: &[U8], expected_identity: &SessionIdentity) -> [SessionEvent] RecordingError! {
    text :: std.str.from_utf8(bytes) ?? return .Err(.InvalidEnvelope("envelope is not UTF-8"))
    root :: parse_json_value(text, "devtools envelope")?
    object: [String:DataTree] :: if root == { .Object(object) -> object.into_iter().collect(), _ -> return .Err(.InvalidEnvelope("envelope must be an object")) }
    protocol :: object.get("protocol").and_then((value) -> if value == { .Text(protocol) -> .Val(protocol), _ -> .None })
        ?? return .Err(.InvalidEnvelope("missing string `protocol`"))
    if protocol != JET_DEVTOOLS_PROTOCOL -> return .Err(.InvalidEnvelope("protocol is `{protocol}`, expected `{JET_DEVTOOLS_PROTOCOL}`"))
    validate_optional_envelope_identity(&object, expected_identity)?
    values :: object.get("events") ?? return .Err(.InvalidEnvelope("missing `events` array"))
    if values == .Array(values) {
        events: [SessionEvent] := []
        for value in values -> events.push(parse_event(value)?)
        events
    } else -> .Err(.InvalidEnvelope("envelope `events` must be an array"))
}
// Rust: crates/jet-devserver/src/SessionRecording.rs:883
fn parse_event(value: &DataTree) -> SessionEvent RecordingError! {
    object: [String:DataTree] :: if value == { .Object(object) -> object.iter().cloned().collect(), _ -> return .Err(.InvalidEvent("event must be an object")) }
    sequence :: required_u64(&object, "sequence")?
    timestamp_ms :: required_u64(&object, "timestamp_ms")?
    source :: required_string(&object, "source")?
    kind :: required_string(&object, "kind")?
    entity :: required_string(&object, "entity")?
    fields :: object.get("fields") ?? return .Err(.InvalidEvent("missing event `fields`"))
    fields_json :: if fields == { .Object(_) -> canonical_json(fields), _ -> return .Err(.InvalidEvent("event fields must be an object")) }
    payload_json :: if object.get("payload") == {
        .None | .Val(.Null) -> .None
        .Val(value) if value == .Object(_) -> .Val(canonical_json(value))
        .Val(_) -> return .Err(.InvalidEvent("event payload must be an object or null"))
    }
    SessionEvent.new(sequence, timestamp_ms, ^source, ^kind, ^entity, ^fields_json, ^payload_json)
}
// Rust: crates/jet-devserver/src/SessionRecording.rs:928
fn parse_json_value(text: String, label: String) -> DataTree RecordingError! {
    if text.len() > MAX_RECORDING_BYTES -> return .Err(.InvalidEvent("{label} exceeds the {MAX_RECORDING_BYTES}-byte limit"))
    parse_json_with_limit(text, MAX_RECORDING_BYTES).map_err((_) ->
        if label == "devtools envelope" -> RecordingError.InvalidEnvelope("{label} is not valid bounded JSON")
        else -> RecordingError.InvalidEvent("{label} is not valid bounded JSON"))
}
// Rust: crates/jet-devserver/src/SessionRecording.rs:944
fn canonical_object(text: String, label: String) -> String RecordingError! {
    if text.len() > MAX_RECORDING_TEXT_BYTES -> return .Err(.InvalidEvent("{label} exceeds the {MAX_RECORDING_TEXT_BYTES}-byte JSON object limit"))
    value :: parse_json_value(text, label)?
    if value == .Object(_) -> canonical_json(&value)
    else -> .Err(.InvalidEvent("{label} must be an object"))
}
// Rust: crates/jet-devserver/src/SessionRecording.rs:958
fn required_string(object: &[String:DataTree], key: String) -> String RecordingError! {
    value :: object.get(key).and_then((value) -> if value == { .Text(value) -> .Val(~value), _ -> .None })
        ?? return .Err(.InvalidEvent("missing string `{key}`"))
    validate_text(value, "event {key}")?
    value
}
// Rust: crates/jet-devserver/src/SessionRecording.rs:970
fn required_u64(object: &[String:DataTree], key: String) -> U64 RecordingError! {
    if object.get(key) == {
        .Val(.Int(value)) -> U64.try_from(*value) ?? return .Err(.InvalidEvent("event `{key}` must be a non-negative integer"))
        .Val(_) -> .Err(.InvalidEvent("event `{key}` must be an exact integer"))
        .None -> .Err(.InvalidEvent("missing integer `{key}`"))
    }
}
// Rust: crates/jet-devserver/src/SessionRecording.rs:982
fn validate_optional_envelope_identity(object: &[String:DataTree], expected: &SessionIdentity) -> Unit RecordingError! {
    source :: object.get("source_id")
    build :: object.get("build_id")
    if source.is_none() && build.is_none() -> return
    source_text :: source.and_then((value) -> if value == { .Text(value) -> .Val(~value), _ -> .None })
        ?? return .Err(.InvalidEnvelope("envelope `source_id` must be a string"))
    build_text :: build.and_then((value) -> if value == { .Text(value) -> .Val(~value), _ -> .None })
        ?? return .Err(.InvalidEnvelope("envelope `build_id` must be a string"))
    found :: SessionIdentity.new(^source_text, ^build_text) ?? return .Err(.InvalidEnvelope("invalid envelope identity: {err}"))
    if !expected.matches(&found) -> return .Err(.IdentityMismatch { expected: ~expected, found: ^found })
}
// Rust: crates/jet-devserver/src/SessionRecording.rs:1019
fn validate_id(value: String, label: String) -> Unit RecordingError! {
    if value.is_empty() || value.len() > MAX_ID_BYTES || value.bytes().any((byte) -> byte.is_ascii_control()) -> return .Err(.InvalidIdentity("{label} must contain 1..={MAX_ID_BYTES} bytes and no control characters"))
}
// Rust: crates/jet-devserver/src/SessionRecording.rs:1033
fn validate_text(value: String, label: String) -> Unit RecordingError! {
    if value.len() > MAX_RECORDING_TEXT_BYTES -> return .Err(.InvalidEvent("{label} exceeds the {MAX_RECORDING_TEXT_BYTES}-byte text limit"))
}
// Rust: crates/jet-devserver/src/SessionRecording.rs:1043
fn quoted(value: String) -> String { "\"{json_escape(value)}\"" }
// Rust: crates/jet-devserver/src/SessionRecording.rs:1047
fn canonical_json(value: &DataTree) -> String {
    if value == {
        .Null -> "null"
        .Bool(value) -> value.to_string()
        .Int(value) -> value.to_string()
        .Float(value) -> value.to_string()
        .Number(value) -> ~value
        .TypedText(value) | .Text(value) -> quoted(value)
        .Bytes(values) -> "[{values.iter().map((value) -> value.to_string()).collect::<[String]>().join(",")}]"
        .Array(values) -> "[{values.iter().map(canonical_json).collect::<[String]>().join(",")}]"
        .Object(values) -> "{{{values.iter().map(((key, value)) -> "{quoted(key)}:{canonical_json(value)}").collect::<[String]>().join(",")}}}"
    }
}
