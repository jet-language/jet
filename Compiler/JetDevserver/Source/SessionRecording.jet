//RS //! Bounded replay state for the shared `jet.devtools.v1` observation stream.
//RS //!
//RS //! The recorder only understands the envelope's transport facts: sequence,
//RS //! monotonic timestamp, source, kind, entity, and opaque JSON objects. It does
//RS //! not assign meaning to an event family or manufacture a payload. Replay
//RS //! cursors operate on an immutable recording generation and fail closed when
//RS //! the source/build identity or retained window changes.
//RS 
//RS use crate::Session::JET_DEVTOOLS_PROTOCOL;
//RS use jet_foundation::DataTree::DataTree;
//RS use jet_foundation::JSON::{json_escape, parse_json_with_limit};
//RS use std::collections::{BTreeMap, VecDeque};
//RS use std::fmt;
//RS 
//RS /// The largest event ring admitted by the shared devtools policy.
//RS pub const MAX_RECORDING_EVENTS: usize = 256;
//RS /// The largest byte budget admitted by the shared devtools policy.
//RS pub const MAX_RECORDING_BYTES: usize = 1024 * 1024;
//RS /// Maximum size of one identity or event text label.
//RS pub const MAX_RECORDING_TEXT_BYTES: usize = 16 * 1024;
//RS /// Maximum size of an identity component. IDs are opaque stable strings.
//RS pub const MAX_ID_BYTES: usize = 1024;
