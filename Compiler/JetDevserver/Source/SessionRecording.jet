impl SessionEvent {
    // Rust: crates/jet-devserver/src/SessionRecording.rs:106
    pub fn new(sequence: U64, timestamp_ms: U64, source: String, kind: String, entity: String, fields_json: String, payload_json: String?) -> Self RecordingError! {
        validate_text(source, "event source")?
        validate_text(kind, "event kind")?
        validate_text(entity, "event entity")?
        fields :: canonical_object(fields_json, "event fields")?
        payload :: if payload_json == {
            .None -> .None
            .Val(payload) -> {
                value :: parse_json_value(payload, "event payload")?
                if value == {
                    .Null -> .None
                    .Object(_) -> .Val(canonical_json(&value))
                    _ -> return .Err(.InvalidEvent("event payload must be an object or null"))
                }
            }
        }
        event :: Self { sequence, timestamp_ms, source: ^source, kind: ^kind, entity: ^entity, fields_json: ^fields, payload_json: ^payload }
        if event.wire_len() > MAX_RECORDING_BYTES -> return .Err(.EventTooLarge { bytes: event.wire_len(), limit: MAX_RECORDING_BYTES })
        event
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:155
    pub fn sequence(self: &Self) -> U64 { self.sequence }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:159
    pub fn timestamp_ms(self: &Self) -> U64 { self.timestamp_ms }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:163
    pub fn source(self: &Self) -> &String { &self.source }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:167
    pub fn kind(self: &Self) -> &String { &self.kind }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:171
    pub fn entity(self: &Self) -> &String { &self.entity }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:176
    pub fn fields_json(self: &Self) -> &String { &self.fields_json }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:181
    pub fn payload_json(self: &Self) -> &String? { self.payload_json.as_ref() }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:185
    fn wire_len(self: &Self) -> USize {
        payload :: self.payload_json.as_ref().unwrap_or("null")
        "{{\"sequence\":{self.sequence},\"timestamp_ms\":{self.timestamp_ms},\"source\":{quoted(self.source)},\"kind\":{quoted(self.kind)},\"entity\":{quoted(self.entity)},\"fields\":{self.fields_json},\"payload\":{payload}}}".len()
    }
}
