        if self.max_bytes == 0 || self.max_bytes > MAX_RECORDING_BYTES -> return .Err(.InvalidLimits { max_events: self.max_events, max_bytes: self.max_bytes })
    }
    // Rust: crates/jet-devserver/src/SessionRecording.rs:84
