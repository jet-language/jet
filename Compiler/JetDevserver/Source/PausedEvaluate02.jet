use jet_foundation.DataTree.[DataTree]
use jet_foundation.JSON.[json_escape, json_int, parse_json_with_limit]

impl PausedEvaluateHostError {
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1792
    pub fn json(self: &Self) -> String {
        if self == {
            .SessionUnavailable -> "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"ok\":false,\"error\":\"session_unavailable\"}}"
            .EvaluatorUnavailable -> "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"ok\":false,\"error\":\"evaluator_unavailable\"}}"
            .InvalidRequest(detail) -> "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"ok\":false,\"error\":\"invalid_request\",\"detail\":\"{json_escape(detail)}\"}}"
            .Rejected(err) -> err.json()
        }
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1814
    pub fn fmt(self: &Self, formatter: &fmt.Formatter) -> Unit fmt.Error! {
        if self == {
            .SessionUnavailable -> formatter.write_str("session_unavailable")
            .EvaluatorUnavailable -> formatter.write_str("evaluator_unavailable")
            .InvalidRequest(detail) -> formatter.write_str("invalid_request: {detail}")
            .Rejected(err) -> err.fmt(formatter)
        }
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1827
    pub fn from(err: RequestError) -> Self { .Rejected(^err) }
}

// Rust: crates/jet-devserver/src/PausedEvaluate.rs:1832
// One wrapper per devtools connection: facts are injected, never evaluated here.
pub struct PausedEvaluateHost {
    session: PausedSession?
    evaluator_result: EvaluatorResult?
}
impl PausedEvaluateHost {
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1851
    pub fn new() -> Self { Self { session: .None, evaluator_result: .None } }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1857
    pub fn set_session(self: &Self, session: PausedSession) -> Unit { self.session = .Val(^session) }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1864
    pub fn clear_session(self: &Self) -> Unit {
        self.session = .None
        self.evaluator_result = .None
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1877
    pub fn cancel_session(self: &Self, reason: String) -> Unit PausedEvaluateHostError! {
        session :: self.session.as_mut() ?? return .Err(.SessionUnavailable)
        session.cancel(^reason) ?? return .Err(.InvalidRequest(err))
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1888
    pub fn session(self: &Self) -> &PausedSession? { self.session.as_ref() }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1893
    pub fn is_paused(self: &Self) -> Bool { self.session.as_ref().is_some_and((session) -> session.state == .Paused) }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1900
    pub fn set_evaluator_result(self: &Self, result: EvaluatorResult) -> Unit { self.evaluator_result = .Val(^result) }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1906
    pub fn clear_evaluator_result(self: &Self) -> Unit { self.evaluator_result = .None }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1914
    pub fn handle_inspect(self: &Self, raw: String) -> String PausedEvaluateHostError! { self.inspect_request(raw)?.json() }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1921
    pub fn inspect_request(self: &Self, raw: String) -> InspectResponse PausedEvaluateHostError! {
        session :: self.session.as_ref() ?? return .Err(.SessionUnavailable)
        request :: InspectRequest.from_json(raw) ?? return .Err(.InvalidRequest(err))
        inspect(session, &request) ?? return .Err(.Rejected(err))
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1934
    pub fn handle_evaluate(self: &Self, raw: String) -> String PausedEvaluateHostError! { self.evaluate_request(raw)?.json() }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1941
    pub fn evaluate_request(self: &Self, raw: String) -> EvaluateResponse PausedEvaluateHostError! {
        session :: self.session.as_ref() ?? return .Err(.SessionUnavailable)
        request :: EvaluateRequest.from_json(raw) ?? return .Err(.InvalidRequest(err))
        result :: self.evaluator_result.take() ?? return .Err(.EvaluatorUnavailable)
        evaluate(session, &request, ^result) ?? return .Err(.Rejected(err))
    }
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:1957
fn inspect_authority(request: &InspectRequest) -> [AuthorityRequirement] {
    authority := ~request.authority
    authority.push(AuthorityRequirement { capability: INSPECT_AUTHORITY, scope_id: ~request.scope_id })
    authority
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:1966
fn evaluate_authority(request: &EvaluateRequest) -> [AuthorityRequirement] {
    authority := ~request.authority
    authority.push(AuthorityRequirement { capability: EVALUATE_AUTHORITY, scope_id: ~request.scope_id })
    if request.mode == .Mutate {
        authority.push(AuthorityRequirement { capability: MUTATE_AUTHORITY, scope_id: ~request.scope_id })
        authority.extend(request.effects.iter().map((effect) -> AuthorityRequirement { capability: ~effect, scope_id: ~request.scope_id }))
    }
    authority.sort()
    authority.dedup()
    authority
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:1987
fn validate_common(session: &PausedSession, identity: &SessionIdentity, request_id: String, scope_id: String,
    budget: &EvaluationBudget, cancellation: &Cancellation, authority: &[AuthorityRequirement]) -> Unit RejectReason! {
    if session.state == .Stale -> return .Err(.StaleSession)
    if session.state != .Paused {
        return .Err(if session.state == .Cancelled || cancellation.requested -> .Cancelled else -> .SessionNotPaused)
    }
    if identity.validate().is_err() || valid_id(request_id, "request id").is_err()
        || valid_id(scope_id, "scope id").is_err() || budget.validate().is_err()
        || cancellation.validate().is_err() || authority.iter().any((requirement) -> requirement.validate().is_err()) {
        return .Err(.InvalidRequest)
    }
    if identity.session_id != session.identity.session_id -> return .Err(.SessionIdentityMismatch)
    if identity.source_id != session.identity.source_id || identity.source_revision != session.identity.source_revision -> return .Err(.SourceIdentityMismatch)
    if identity.pause_id != session.identity.pause_id -> return .Err(.PauseIdentityMismatch)
    if identity.frame_id != session.identity.frame_id -> return .Err(.FrameIdentityMismatch)
    if session.cancellation.requested || cancellation.requested -> return .Err(.Cancelled)
    if !session.budget.contains(budget) -> return .Err(.BudgetExceeded)
    if authority.iter().any((requirement) -> !session.authority.allows(requirement)) -> return .Err(.InsufficientAuthority)
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2044
fn reject(operation: String, request_id: String, identity: &SessionIdentity, scope_id: String,
    authority: &[AuthorityRequirement], reason: RejectReason, usage: EvaluationUsage) -> RequestError {
    RequestError { reason, audit: AuditReceipt.new(operation, request_id, identity, scope_id, authority,
        .Rejected, .Val(reason), usage, false, 0, 0, .None) }
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2072
fn project_root(value: &ValueProjection, identity: &SessionIdentity, budget: EvaluationBudget, stats: &ProjectionStats) -> ValueProjection Err! {
    nodes := stats.usage.nodes
    projected :: project_node(value, identity, budget, 1, true, &nodes, stats) ?? return .Err("paused value root could not be retained")
    stats.usage.nodes = nodes
    projected
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2085
fn project_node(value: &ValueProjection, identity: &SessionIdentity, budget: EvaluationBudget,
    depth: U32, root: Bool, nodes: &U64, stats: &ProjectionStats) -> ValueProjection? {
    if value.publication == .Absent -> return .None
    if !root && *nodes >= budget.max_nodes {
        stats.truncated = true
        return .None
    }
    if *nodes < budget.max_nodes -> *nodes = nodes.saturating_add(1)
    else -> stats.truncated = true
    stats.usage.nodes = *nodes
    stats.usage.depth = stats.usage.depth.max(depth)
    metadata :: value.metadata_bytes()
    available :: budget.max_bytes.saturating_sub(stats.usage.bytes)
    metadata_fits :: metadata <= available
    if metadata_fits -> stats.usage.bytes = stats.usage.bytes.saturating_add(metadata)
    else {
        stats.usage.bytes = budget.max_bytes
        stats.truncated = true
    }
    projected := ~value
    projected.value = .None
    projected.children.clear()
    projected.truncated = value.truncated || !metadata_fits
    if value.publication == .Published {
        if value.value.as_ref() == .Val(typed) {
            payload :: typed.bytes()
            available :: budget.max_bytes.saturating_sub(stats.usage.bytes)
            if metadata_fits && payload <= available {
                stats.usage.bytes = stats.usage.bytes.saturating_add(payload)
                projected.value = .Val(~typed)
            } else {
                stats.truncated = true
                projected.truncated = true
            }
        }
    }
    if !value.children.is_empty() {
        if depth >= budget.max_depth || !metadata_fits {
            stats.truncated = true
            projected.truncated = true
        } else {
            for child in &value.children {
                if project_node(child, identity, budget, depth.saturating_add(1), false, nodes, stats) == .Val(child) {
                    projected.children.push(^child)
                } else {
                    stats.truncated = true
                    projected.truncated = true
                }
            }
        }
    }
    if value.publication == .Published {
        measured :: value.measure()
        stats.usage.depth = stats.usage.depth.max(measured.depth.min(budget.max_depth))
    }
    .Val(^projected)
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2169
fn valid_id(value: String, label: String) -> Unit Err! {
    if value.is_empty() || value.len() > 256 || value.chars().any((ch) -> ch.is_control()) -> return .Err("{label} is empty, too long, or contains control text")
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2176
fn valid_text(value: String, label: String, max_bytes: USize) -> Unit Err! {
    if value.len() > max_bytes || value.chars().any((ch) -> ch.is_control()) -> return .Err("{label} exceeds its bounded text contract")
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2183
fn array_json(values: Iterator<String>) -> String { "[{values.collect::<[String]>().join(",")}]" }
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2187
fn object(raw: String) -> [String:DataTree] Err! {
    root :: parse_json_with_limit(raw, MAX_REQUEST_BYTES) ?? return .Err("paused request is not valid bounded JSON")
    if root == .Object(fields) -> fields.into_iter().collect()
    else -> .Err("paused request must be a JSON object")
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2196
fn required_string(fields: &[String:DataTree], key: String) -> String Err! {
    value :: fields.get(key).and_then((value) -> if value == { .Text(value) -> .Val(~value), _ -> .None })
        ?? return .Err("paused request requires string `{key}`")
    valid_text(value, key, 256)?
    value
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2211
fn optional_string(fields: &[String:DataTree], key: String) -> String? Err! {
    if fields.get(key) == {
        .None | .Val(.Null) -> .None
        .Val(.Text(value)) -> {
            valid_text(value, key, 256)?
            .Val(~value)
        }
        .Val(_) -> .Err("paused request field `{key}` must be a string or null")
    }
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2225
fn required_u64(fields: &[String:DataTree], key: String) -> U64 Err! {
    fields.get(key).and_then(json_int).and_then((value) -> U64.try_from(value).ok())
        ?? return .Err("paused request requires non-negative integer `{key}`")
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2237
fn required_u32(fields: &[String:DataTree], key: String) -> U32 Err! {
    value :: required_u64(fields, key)?
    U32.try_from(value) ?? return .Err("paused request integer `{key}` is too large")
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2245
fn optional_bool(fields: &[String:DataTree], key: String) -> Bool Err! {
    if fields.get(key) == { .None -> false, .Val(.Bool(value)) -> *value, .Val(_) -> .Err("paused request field `{key}` must be boolean") }
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2256
fn parse_identity(fields: &[String:DataTree]) -> SessionIdentity Err! {
    identity: [String:DataTree] :: if fields.get("identity") == {
        .Val(.Object(identity)) -> identity.iter().cloned().collect()
        .Val(_) -> return .Err("paused request `identity` must be an object")
        .None -> ~fields
    }
    SessionIdentity.new(required_string(&identity, "session_id")?, required_string(&identity, "source_id")?,
        required_string(&identity, "source_revision")?, required_string(&identity, "pause_id")?, required_string(&identity, "frame_id")?)
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2273
fn parse_budget(fields: &[String:DataTree]) -> EvaluationBudget Err! {
    if fields.get("budget") == .Val(.Object(entries)) {
        budget: [String:DataTree] :: entries.iter().cloned().collect()
        EvaluationBudget.new(required_u32(&budget, "max_depth")?, required_u64(&budget, "max_nodes")?,
            required_u64(&budget, "max_bytes")?, required_u64(&budget, "max_steps")?)
    } else -> DEFAULT_EVALUATION_BUDGET
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2289
fn parse_authority(fields: &[String:DataTree]) -> [AuthorityRequirement] Err! {
    value :: fields.get("authority") ?? return []
    if value == .Array(values) {
        authority: [AuthorityRequirement] := []
        for value in values {
            if value == .Object(entries) {
                fields: [String:DataTree] :: entries.iter().cloned().collect()
                authority.push(AuthorityRequirement.new(required_string(&fields, "capability")?, required_string(&fields, "scope_id")?)?)
            } else -> return .Err("paused authority requirement must be an object")
        }
        authority
    } else -> .Err("paused request `authority` must be an array")
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2314
fn validate_header(fields: &[String:DataTree], kind: String) -> Unit Err! {
    if required_string(fields, "protocol")? != PAUSED_EVALUATE_PROTOCOL -> return .Err("paused request protocol does not match jet.devtools.v1")
    schema :: fields.get("schema_version").and_then(json_int).and_then((value) -> U32.try_from(value).ok())
        ?? return .Err("paused request schema_version is missing or invalid")
    if schema != PAUSED_EVALUATE_SCHEMA_VERSION -> return .Err("paused request schema_version is unsupported")
    if required_string(fields, "kind")? != kind -> return .Err("paused request kind must be `{kind}`")
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2335
pub fn parse_inspect_request(raw: String) -> InspectRequest Err! {
    fields :: object(raw)?
    validate_header(&fields, "paused.inspect")?
    request := InspectRequest.new(required_string(&fields, "request_id")?, parse_identity(&fields)?,
        required_string(&fields, "scope_id")?, parse_budget(&fields)?, parse_authority(&fields)?)?
    request.value_id = optional_string(&fields, "value_id")?
    request.cancellation = if optional_bool(&fields, "cancelled")? -> Cancellation.requested("request cancelled")? else -> Cancellation.none()
    request.validate_shape()?
    request
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:2355
pub fn parse_evaluate_request(raw: String) -> EvaluateRequest Err! {
    fields :: object(raw)?
    validate_header(&fields, "paused.evaluate")?
    mode :: if required_string(&fields, "mode")? == {
        "read_only" -> EvaluationMode.ReadOnly
        "mutate" -> EvaluationMode.Mutate
        _ -> return .Err("paused evaluation mode is unsupported")
    }
    effects: [String] := []
    if fields.get("effects") == {
        .None -> {}
        .Val(.Array(values)) -> {
            for value in values {
                if value == .Text(value) {
                    valid_id(value, "evaluation effect")?
                    effects.push(~value)
                } else -> return .Err("paused evaluation effects must be strings")
            }
        }
        .Val(_) -> return .Err("paused evaluation `effects` must be an array")
    }
    request := EvaluateRequest.new(required_string(&fields, "request_id")?, parse_identity(&fields)?,
        required_string(&fields, "scope_id")?, required_string(&fields, "expression")?, mode, ^effects,
        parse_authority(&fields)?, parse_budget(&fields)?)?
    request.cancellation = if optional_bool(&fields, "cancelled")? -> Cancellation.requested("request cancelled")? else -> Cancellation.none()
    request.validate_shape()?
    request
}
