//RS /// Host-owned state wrapper around the paused inspect/evaluate kernel.
//RS ///
//RS /// A host stores exactly one instance per devtools connection and injects
//RS /// the real paused session and the real evaluator's result as those facts
//RS /// become available; it never runs an evaluator, never decides pause state
//RS /// on its own, and never invents a value.  An absent session or an absent
//RS /// evaluator result is reported as an explicit [`PausedEvaluateHostError`],
//RS /// never silently substituted.  `handle_inspect` and `handle_evaluate` are
//RS /// the only entry points a host needs to serve `/paused/inspect` and
//RS /// `/paused/evaluate`: they parse the typed request, delegate to the
//RS /// kernel, and return a bounded JSON body with no semantic logic left for
//RS /// the caller.
//RS #[derive(Clone, Debug, Default, Eq, PartialEq)]
//RS pub struct PausedEvaluateHost {
//RS     session: Option<PausedSession>,
//RS     evaluator_result: Option<EvaluatorResult>,
//RS }
//RS 
//RS impl PausedEvaluateHost {
//RS     pub fn new() -> Self {
//RS         Self::default()
//RS     }
//RS 
//RS     /// Inject the real paused session.  Replaces any session injected
//RS     /// earlier; does not touch a separately staged evaluator result.
//RS     pub fn set_session(&mut self, session: PausedSession) {
//RS         self.session = Some(session);
//RS     }
//RS 
//RS     /// Clear the paused session (resume, detach, or process exit).  Also
//RS     /// drops any evaluator result staged for a request the session can no
//RS     /// longer serve.
//RS     pub fn clear_session(&mut self) {
//RS         self.session = None;
//RS         self.evaluator_result = None;
//RS     }
//RS 
//RS     /// Mark the injected session cancelled in place, e.g. the host is
//RS     /// stopping the debug target while a paused inspect/evaluate call may
//RS     /// still be in flight.  Kept distinct from `clear_session`: the session
//RS     /// facts (identity, scopes) stay retained and visible for one last
//RS     /// `handle_inspect`, but the kernel now fails every further request
//RS     /// with `RejectReason::Cancelled` per [`PausedSession::cancel`].
//RS     /// Returns an explicit error if no session is injected, or if the
//RS     /// reason text fails the kernel's own bounded-text validation.
//RS     pub fn cancel_session(
//RS         &mut self,
//RS         reason: impl Into<String>,
//RS     ) -> Result<(), PausedEvaluateHostError> {
//RS         let Some(session) = self.session.as_mut() else {
//RS             return Err(PausedEvaluateHostError::SessionUnavailable);
//RS         };
//RS         session.cancel(reason).map_err(PausedEvaluateHostError::InvalidRequest)
//RS     }
