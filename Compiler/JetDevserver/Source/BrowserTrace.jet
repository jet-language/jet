// Payload-free browser rows relayed by jet dev. `jet perf` reads the relay
// (JetCli's Perf/BrowserCapture); this side only produces it and consumes the
// collection request.
use {
    browser_trace_files: core.files
    browser_trace_sys: core.sys
    browser_trace_time: core.time
    browser_trace_random: core.crypto.random
    browser_trace_hex: core.encoding.hex
    jet_foundation.[foundation_json_quote]
}

BROWSER_TRACE_ROW_LIMIT: Int{4096}
BROWSER_TRACE_ENVELOPE_LIMIT: Int{512}
BROWSER_TRACE_REQUEST_SCHEMA: String{"jet.browser.request.v1"}
BROWSER_TRACE_RELAY_ACTION: String{"browser.relay"}
BROWSER_TRACE_STATUS_SCHEMA: String{"jet.status/v1"}

#Error
BrowserTraceError: struct { message: String }

browser_trace_error: fn(message: String) -> BrowserTraceError { BrowserTraceError{message: message} }

#Error
BrowserTraceRecordError: enum {
    Malformed
    Oversized
    Unavailable
}

BrowserTraceSymbol: struct {
    name: String
    kind: String
}

// One compiler-identified browser source and the symbols it defines.
BrowserTraceSource: struct {
    path: String
    sha256: String
    symbols: [BrowserTraceSymbol]
}

// The compiler trace identity a web manifest carries.
BrowserTraceIdentity: struct {
    sources: [BrowserTraceSource]
    source_map: String?
}

// The owner-only relay file of this process; rows past the bound are dropped
// after one truncation marker.
BrowserTraceRelay: struct {
    writer: FileWriter
    nonce: String
    path: String
    rows: Int
    started: Instant
}
impl BrowserTraceRelay {
    new: fn(manifest: String) -> BrowserTraceRelay BrowserTraceError! {
        browser_trace_supported()
        identity: browser_trace_identity_from_manifest(manifest)
        pid: browser_trace_sys.pid()
        path: browser_trace_relay_path(pid)
        browser_trace_remove_quietly(path)
        started: browser_trace_process_start(pid) ?? return Err(browser_trace_error("browser trace process identity cannot be verified"))
        nonce: browser_trace_random.token_hex(16) ?? return Err(browser_trace_error("cannot generate a browser trace relay nonce"))
        writer := browser_trace_files.create(path, if_exists: .Refuse, mode: Val(0o600), links: .Refuse) ?? return Err(browser_trace_error("cannot create browser trace relay: {err}"))
        fields := [String]{"\"nonce\":{foundation_json_quote(nonce)}", "\"pid\":{pid}", "\"started\":{foundation_json_quote(started)}", "\"sources\":{foundation_json_quote(browser_trace_hex.encode(browser_trace_encode_sources(identity.sources).bytes()))}"}
        if identity.source_map == .Val(map) -> fields.push("\"source_map\":{foundation_json_quote(browser_trace_hex.encode(map.bytes()))}")
        header: browser_trace_status_line(BROWSER_TRACE_RELAY_ACTION, fields)
        writer.write_all(header.bytes()) ?? return Err(browser_trace_error("cannot initialize browser trace relay: {err}"))
        writer.flush() ?? return Err(browser_trace_error("cannot flush browser trace relay: {err}"))
        BrowserTraceRelay{writer: writer, nonce: nonce, path: path, rows: 0, started: browser_trace_time.instant()}
    }

    // Appends one beacon envelope `class=…&symbol=…&start_ns=…&duration_ns=…&clock_ns=…`,
    // rebasing the page clock onto the relay's monotonic clock.
    record: fn(&self, body: [U8]) BrowserTraceRecordError! {
        if body.len() > BROWSER_TRACE_ENVELOPE_LIMIT -> return Err(BrowserTraceRecordError.Oversized)
        text: String.from_bytes(body) ?? return Err(BrowserTraceRecordError.Malformed)
        keys := [String]{}
        loop part in text.split("&") -> keys.push(part.split("=").to_list()[0])
        keys.sort()
        expected: [String]{"class", "clock_ns", "duration_ns", "start_ns", "symbol"}
        if keys != expected -> return Err(BrowserTraceRecordError.Malformed)
        query: "?{text}"
        class: query_param(query, "class") ?? return Err(BrowserTraceRecordError.Malformed)
        symbol: query_param(query, "symbol") ?? return Err(BrowserTraceRecordError.Malformed)
        if (class != "event" && class != "wasm" && class != "dom") || !browser_trace_symbol_ok(symbol) -> return Err(BrowserTraceRecordError.Malformed)
        start: browser_trace_number(query_param(query, "start_ns"))
        duration: browser_trace_number(query_param(query, "duration_ns"))
        clock: browser_trace_number(query_param(query, "clock_ns"))
        if start > clock || duration > clock - start -> return Err(BrowserTraceRecordError.Malformed)
        host_now: (browser_trace_time.instant() - self.started).ns
        mapped_start: if host_now > clock - start -> host_now - (clock - start) else -> 0
        if self.rows >= BROWSER_TRACE_ROW_LIMIT {
            if self.rows == BROWSER_TRACE_ROW_LIMIT {
                self.append(browser_trace_status_line("browser.relay.truncated", [String]{}))
                self.rows += 1
            }
            return
        }
        fields: [String]{"\"start_ns\":{mapped_start}", "\"duration_ns\":{duration}", "\"class\":{foundation_json_quote(class)}", "\"symbol\":{foundation_json_quote(symbol)}"}
        self.append(browser_trace_status_line("browser.relay.row", fields))
        self.rows += 1
    }

    append: fn(&self, line: String) BrowserTraceRecordError! {
        self.writer.write_all(line.bytes()) ?? return Err(BrowserTraceRecordError.Unavailable)
        self.writer.flush() ?? return Err(BrowserTraceRecordError.Unavailable)
    }

    // Ends the relay: the file is removed so no reader sees a stale session.
    close: fn(self) { browser_trace_remove_quietly(self.path) }
}

// One shared status line: `{"schema":"jet.status/v1","action":…,"ok":true,"reports":[],…fields}`.
browser_trace_status_line: fn(action: String, fields: [String]) -> String {
    rendered := "{{\"schema\":{foundation_json_quote(BROWSER_TRACE_STATUS_SCHEMA)},\"action\":{foundation_json_quote(action)},\"ok\":true,\"reports\":[]"
    loop field in fields -> rendered = "{rendered},{field}"
    "{rendered}}}\n"
}

browser_trace_relay_path: fn(pid: Int) -> String { browser_trace_files.join(browser_trace_sys.temp_dir(), "jet-browser-trace-{pid}.relay") }

browser_trace_request_path: fn(pid: Int) -> String { browser_trace_files.join(browser_trace_sys.temp_dir(), "jet-browser-trace-{pid}.request") }

browser_trace_remove_quietly: fn(path: String) {
    if browser_trace_files.remove(path) == {
        .Err(_) -> {}
        else -> {}
    }
}

// Consumes `jet perf`'s collection request for this process. The request
// names this process's start marker, so a request left by an earlier process
// with the same id is refused.
browser_trace_take_request: fn() -> Bool BrowserTraceError! {
    browser_trace_supported()
    pid: browser_trace_sys.pid()
    path: browser_trace_request_path(pid)
    if !browser_trace_files.exists(path) -> return false
    raw: browser_trace_secure_read(path, 256, "browser trace request")
    parts: raw.trim().split("\t").to_list()
    current: browser_trace_process_start(pid) ?? return Err(browser_trace_error("browser trace process identity cannot be verified"))
    valid: parts.len() == 3 && parts[0] == BROWSER_TRACE_REQUEST_SCHEMA && parts[1] == "{pid}" && parts[2] == current
    browser_trace_remove_quietly(path)
    if !valid -> return Err(browser_trace_error("browser trace request belongs to a stale process session"))
    true
}

browser_trace_supported: fn() BrowserTraceError! {
    platform: browser_trace_sys.name()
    if platform != "linux" && platform != "android" -> return Err(browser_trace_error("browser trace relay requires verified process and file ownership"))
}

// Reads a private regular file of this user without following a final link.
browser_trace_secure_read: fn(path: String, limit: Int, label: String) -> String BrowserTraceError! {
    entry: browser_trace_files.lstat(path) ?? return Err(browser_trace_error("{label} is unavailable"))
    if !entry.is_file || entry.is_symlink -> return Err(browser_trace_error("{label} is not a regular file"))
    reader := browser_trace_files.open(path, links: .Refuse) ?? return Err(browser_trace_error("cannot securely open {label}"))
    metadata: reader.stat() ?? return Err(browser_trace_error("cannot inspect {label}"))
    if browser_trace_sys.is_unix() {
        if metadata.mode.bit_and(0o077) != 0 -> return Err(browser_trace_error("{label} permissions expose session data"))
        if metadata.owner != Val(browser_trace_sys.getuid()) -> return Err(browser_trace_error("{label} belongs to another user"))
    }
    if !metadata.is_file || metadata.size > limit -> return Err(browser_trace_error("{label} is not bounded"))
    bytes := [U8]{}
    loop {
        chunk: reader.read(limit + 1 - bytes.len()) ?? return Err(browser_trace_error("cannot read {label}"))
        if chunk.len() == 0 -> break
        loop byte in chunk -> bytes.push(byte)
        if bytes.len() > limit -> return Err(browser_trace_error("{label} exceeds its limit"))
    }
    String.from_bytes(bytes) ?? Err(browser_trace_error("{label} is not UTF-8"))
}

// The compiler trace map and optional source map the web manifest carries,
// both hex-encoded.
browser_trace_identity_from_manifest: fn(manifest: String) -> BrowserTraceIdentity BrowserTraceError! {
    trace_field: browser_trace_manifest_field(manifest, "\"traceMap\": \"", "trace map")
    trace: trace_field ?? return Err(browser_trace_error("web manifest has no compiler trace map"))
    sources: browser_trace_decode_sources(browser_trace_unhex(trace))
    map_field: browser_trace_manifest_field(manifest, "\"sourceMap\": \"", "source map")
    source_map: if map_field == {
        .Val(map) -> Val(browser_trace_unhex(map))
        else -> None
    }
    BrowserTraceIdentity{sources: sources, source_map: source_map}
}

// The quoted value after the first `key`: None when the key is absent, an
// error when its closing quote is missing.
browser_trace_manifest_field: fn(manifest: String, key: String, label: String) -> String? BrowserTraceError! {
    after: manifest.split(key).to_list()
    if after.len() < 2 -> return None
    rest: after[1..after.len() - 1].join(key)
    value: rest.split("\"").to_list()
    if value.len() < 2 -> return Err(browser_trace_error("web manifest {label} is malformed"))
    Val(value[0])
}

browser_trace_encode_sources: fn(sources: [BrowserTraceSource]) -> String {
    lines := [String]{}
    loop source in sources {
        path: browser_trace_hex.encode(source.path.bytes())
        lines.push("source\t{path}\t{source.sha256}")
        loop symbol in source.symbols -> lines.push("symbol\t{path}\t{browser_trace_hex.encode(symbol.name.bytes())}\t{symbol.kind}")
    }
    lines.sort()
    lines.join("\n")
}

// Source rows `source\t<hex path>\t<sha256>` precede nothing in particular;
// symbol rows `symbol\t<hex path>\t<hex name>\t<fn|handler>` attach to the
// first source with that path, and a symbol name is unique across sources.
browser_trace_decode_sources: fn(text: String) -> [BrowserTraceSource] BrowserTraceError! {
    sources := [BrowserTraceSource]{}
    pending := [(path: String, symbol: BrowserTraceSymbol)]{}
    lines: text.split("\n").to_list()
    loop index in 0..<lines.len() {
        line: lines[index]
        if line == "" && index == lines.len() - 1 -> break
        parts: line.split("\t").to_list()
        if parts.len() == 3 && parts[0] == "source" {
            sha256: parts[2]
            if !browser_trace_lower_hex(sha256) || sha256.bytes().len() != 64 -> return Err(browser_trace_error("compiler trace source identity is malformed"))
            sources.push(BrowserTraceSource{path: browser_trace_unhex(parts[1]), sha256: sha256, symbols: [BrowserTraceSymbol]{}})
        } else if parts.len() == 4 && parts[0] == "symbol" {
            name: browser_trace_unhex(parts[2])
            if name == "" || (parts[3] != "fn" && parts[3] != "handler") -> return Err(browser_trace_error("compiler trace symbol identity is malformed"))
            pending.push((path: browser_trace_unhex(parts[1]), symbol: BrowserTraceSymbol{name: name, kind: parts[3]}))
        } else {
            return Err(browser_trace_error("compiler trace map row is malformed"))
        }
    }
    if sources.len() == 0 -> return Err(browser_trace_error("compiler trace map has no sources"))
    by_path := [String: Int]{}
    loop index in 0..<sources.len() {
        if !by_path.has_key(sources[index].path) -> by_path[sources[index].path] = index
    }
    names := [String: Bool]{}
    loop row in pending {
        if names.has_key(row.symbol.name) -> return Err(browser_trace_error("compiler trace symbol `{row.symbol.name}` is ambiguous"))
        index: by_path.get(row.path) ?? return Err(browser_trace_error("compiler trace symbol names an unknown source"))
        names[row.symbol.name] = true
        sources[index].symbols.push(row.symbol)
    }
    sources
}

browser_trace_number: fn(value: String?) -> Int BrowserTraceRecordError! {
    text: value ?? return Err(BrowserTraceRecordError.Malformed)
    number: Int.parse(text) ?? return Err(BrowserTraceRecordError.Malformed)
    if number < 0 -> return Err(BrowserTraceRecordError.Malformed)
    number
}

// A browser symbol: 1 to 128 bytes of ASCII letters, digits, `_` or `$`.
browser_trace_symbol_ok: fn(value: String) -> Bool {
    bytes: value.bytes()
    if bytes.len() == 0 || bytes.len() > 128 -> return false
    loop byte in bytes {
        digit: byte >= U8{48} && byte <= U8{57}
        upper: byte >= U8{65} && byte <= U8{90}
        lower: byte >= U8{97} && byte <= U8{122}
        mark: byte == U8{95} || byte == U8{36}
        if !digit && !upper && !lower && !mark -> return false
    }
    true
}

browser_trace_lower_hex: fn(value: String) -> Bool {
    loop byte in value.bytes() {
        digit: byte >= U8{48} && byte <= U8{57}
        letter: byte >= U8{97} && byte <= U8{102}
        if !digit && !letter -> return false
    }
    true
}

// Lowercase hexadecimal UTF-8 text; uppercase digits are refused.
browser_trace_unhex: fn(text: String) -> String BrowserTraceError! {
    if !browser_trace_lower_hex(text) -> return Err(browser_trace_error("browser trace relay source encoding is malformed"))
    bytes: browser_trace_hex.decode(text) ?? return Err(browser_trace_error("browser trace relay source encoding is malformed"))
    String.from_bytes(bytes) ?? Err(browser_trace_error("browser trace relay source is not UTF-8"))
}

// The start-time field of `/proc/<pid>/stat`: the 20th field after the
// command name, whose last `) ` closes it.
browser_trace_process_start: fn(pid: Int) -> String? {
    stat: browser_trace_files.read("/proc/{pid}/stat") ?? return None
    parts: stat.split(") ").to_list()
    if parts.len() < 2 -> return None
    fields := [String]{}
    loop field in parts[parts.len() - 1].split(" ") {
        if field != "" -> fields.push(field)
    }
    if fields.len() <= 19 -> return None
    Val(fields[19])
}
