impl Relay {
    // Rust: crates/jet-devserver/src/BrowserTrace.rs:53
    pub fn new(manifest: String) -> Self Err! {
        // GATE #4494: owner-only atomic file creation, native locks and clock.
        supported()?
        (sources, source_map) :: identity_from_manifest(manifest)?
        path :: relay_path(std.process.id())
        _ :: fs.remove_file(path)
        options := OpenOptions.new()
        options.write(true).create_new(true)
        if selected_family() == "unix" -> options.mode(0o600)
        file := options.open(path) ?? return .Err("cannot create browser trace relay: {err}")
        nonce :: nonce()
        pid :: std.process.id()
        started :: process_start_marker(pid) ?? return .Err("browser trace process identity cannot be verified")
        fields := StatusFields.new()
        fields.insert("nonce", ~nonce).expect("relay nonce field is unique")
        fields.insert("pid", pid).expect("relay pid field is unique")
        fields.insert("started", ~started).expect("relay started field is unique")
        fields.insert("sources", hex(encode_sources(sources).as_bytes())).expect("relay sources field is unique")
        if source_map.as_ref() == .Val(map) -> fields.insert("source_map", hex(map.as_bytes())).expect("relay source_map field is unique")
        header :: StatusEnvelope.new(RELAY_ACTION, true).with_fields(^fields).json()
        file.write_all("{header}\n".as_bytes()) ?? return .Err("cannot initialize browser trace relay: {err}")
        file.flush() ?? return .Err("cannot flush browser trace relay: {err}")
        return Self { file: Mutex.new(^file), nonce: ^nonce, path: ^path, rows: Mutex.new(0), started: Instant.now() }
    }
    // Rust: crates/jet-devserver/src/BrowserTrace.rs:106
    pub fn nonce(self: &Self) -> String { return self.nonce }
    // Rust: crates/jet-devserver/src/BrowserTrace.rs:110
    pub fn record(self: &Self, body: &[U8]) -> Unit RecordError! {
        if body.len() > ENVELOPE_LIMIT -> return .Err(.Oversized)
        body :: std.str.from_utf8(body) ?? return .Err(.Malformed)
        keys := body.split('&').map((part) -> part.split_once('=').map(((key, _)) -> key).unwrap_or(part)).collect()
        keys.sort_unstable()
        if keys != ["class", "clock_ns", "duration_ns", "start_ns", "symbol"] -> return .Err(.Malformed)
        param :: (name) -> query_param("?{body}", name)
        class :: param("class") ?? return .Err(.Malformed)
        symbol :: param("symbol") ?? return .Err(.Malformed)
        if (class != "event" && class != "wasm" && class != "dom") || symbol.is_empty() || symbol.len() > 128 || !symbol.bytes().all((b) -> b == 95 || b == 36 || b.is_ascii_alphanumeric()) -> return .Err(.Malformed)
        start :: number(param("start_ns"))?
        duration :: number(param("duration_ns"))?
        clock :: number(param("clock_ns"))?
        if start > clock || duration > clock - start -> return .Err(.Malformed)
        host_now :: self.started.elapsed().as_nanos().min(U64.MAX as U128) as U64
        mapped_start :: host_now.saturating_sub(clock - start)
        rows := self.rows.lock() ?? return .Err(.Unavailable)
        file := self.file.lock() ?? return .Err(.Unavailable)
        if rows >= ROW_LIMIT {
            if rows == ROW_LIMIT {
                truncated :: StatusEnvelope.new("browser.relay.truncated", true).json()
                file.write_all("{truncated}\n".as_bytes()) ?? return .Err(.Unavailable)
                file.flush() ?? return .Err(.Unavailable)
                rows += 1
            }
            return ()
        }
        fields := StatusFields.new()
        fields.insert("start_ns", mapped_start).expect("relay start_ns field is unique")
        fields.insert("duration_ns", duration).expect("relay duration_ns field is unique")
        fields.insert("class", ^class).expect("relay class field is unique")
        fields.insert("symbol", ^symbol).expect("relay symbol field is unique")
        row :: StatusEnvelope.new("browser.relay.row", true).with_fields(^fields).json()
        file.write_all("{row}\n".as_bytes()) ?? return .Err(.Unavailable)
        file.flush() ?? return .Err(.Unavailable)
        rows += 1
        return ()
    }
}
