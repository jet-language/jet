#Error
pub enum RecordError { Malformed; Oversized; Unavailable }
// Rust: crates/jet-devserver/src/BrowserTrace.rs:190
pub fn read(pid: U32) -> Capture Err! { supported()?; return read_with_process_state(pid, process_state(pid)) }
// Rust: crates/jet-devserver/src/BrowserTrace.rs:196
 enum ProcessState { Alive(String); Dead; Unknown }
// Rust: crates/jet-devserver/src/BrowserTrace.rs:202
fn read_with_process_state(pid: U32, process: ProcessState) -> Capture Err! {
    // GATE #4494: descriptor-backed no-follow open and native metadata ownership.
    path :: relay_path(pid)
    link_metadata :: fs.symlink_metadata(path) ?? return .Err("process {pid} has no browser trace relay")
    if !link_metadata.file_type().is_file() -> return .Err("browser trace relay is not a regular file")
    options := OpenOptions.new()
    options.read(true)
    if selected_os() == "linux" || selected_os() == "android" -> options.custom_flags(0o400000)
    file :: options.open(path) ?? return .Err("cannot securely open browser trace relay")
    metadata :: file.metadata() ?? return .Err("cannot inspect browser trace relay")
    if !metadata.file_type().is_file() || metadata.len() > 1024 * 1024 -> return .Err("browser trace relay is not a bounded regular file")
    if selected_family() == "unix" {
        if metadata.permissions().mode() & 0o077 != 0 -> return .Err("browser trace relay permissions expose session rows")
        if selected_os() == "linux" || selected_os() == "android" {
            if fs.metadata("/proc/self") == .Ok(self_metadata) {
                if metadata.uid() != self_metadata.uid() -> return .Err("browser trace relay belongs to another user")
            }
        }
    }
    raw := ""
    file.take(1024 * 1024 + 1).read_to_string(&raw) ?? return .Err("cannot read browser trace relay")
    if raw.len() > 1024 * 1024 -> return .Err("browser trace relay exceeds 1 MiB")
    lines := raw.lines()
    header :: lines.next() ?? return .Err("browser trace relay is empty")
    (recorded_pid, started, sources, source_map) :: relay_header(header)?
    if process == .Unknown -> return .Err("browser trace process identity cannot be verified")
    stale_process :: match process {
        .Alive(current) -> current != started
        .Dead -> true
        .Unknown -> false
    }
    if recorded_pid != pid || stale_process {
        _ :: fs.remove_file(path)
        return .Err("browser trace relay belongs to a stale process session")
    }
    rows := [Row]{}
    truncated := false
    for line in lines {
        if relay_status(line, "browser.relay.truncated").is_ok() { truncated = true; next }
        (start_ns, duration_ns, class, symbol) :: relay_row(line)?
        if rows.len() >= ROW_LIMIT -> return .Err("browser trace relay exceeds its closed row schema")
        rows.push(Row { class: ^class, duration_ns: duration_ns, start_ns: start_ns, symbol: ^symbol })
    }
    return Capture { rows: ^rows, sources: ^sources, source_map: ^source_map, truncated: truncated }
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:287
pub fn relay_path(pid: U32) -> OSPath { return std.env.temp_dir().join("jet-browser-trace-{pid}.relay") }
// Rust: crates/jet-devserver/src/BrowserTrace.rs:291
pub fn request_path(pid: U32) -> OSPath { return std.env.temp_dir().join("jet-browser-trace-{pid}.request") }
// Rust: crates/jet-devserver/src/BrowserTrace.rs:295
pub fn request(pid: U32) -> Unit Err! {
    supported()?
    started :: match process_state(pid) { .Alive(started) -> ^started; _ -> return .Err("process {pid} identity cannot be verified") }
    path :: request_path(pid)
    _ :: fs.remove_file(path)
    options := OpenOptions.new()
    options.write(true).create_new(true)
    if selected_family() == "unix" -> options.mode(0o600)
    file := options.open(path) ?? return .Err("cannot request browser trace collection: {err}")
    file.write_all("{REQUEST_SCHEMA}\t{pid}\t{started}\n".as_bytes()) ?? return .Err("cannot write browser trace request: {err}")
    file.flush() ?? return .Err("cannot flush browser trace request: {err}")
    return ()
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:318
pub fn take_request() -> Bool Err! {
    supported()?
    pid :: std.process.id()
    path :: request_path(pid)
    if !path.exists() -> return false
    raw :: secure_read(path, 256, "browser trace request")?
    parts := raw.trim_end().split('\t')
    current :: process_start_marker(pid) ?? return .Err("browser trace process identity cannot be verified")
    pid_text :: pid.to_string()
    valid :: parts.next() == .Val(REQUEST_SCHEMA) && parts.next() == .Val(pid_text) && parts.next() == .Val(current) && parts.next().is_none()
    _ :: fs.remove_file(path)
    if !valid -> return .Err("browser trace request belongs to a stale process session")
    return true
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:341
pub fn cancel_request(pid: U32) -> { _ :: fs.remove_file(request_path(pid)) }
// Rust: crates/jet-devserver/src/BrowserTrace.rs:345
fn supported() -> Unit Err! {
    if selected_os() == "linux" || selected_os() == "android" -> return ()
    return .Err("browser trace relay requires verified process and file ownership")
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:356
fn secure_read(path: &OSPath, limit: U64, label: String) -> String Err! {
    link :: fs.symlink_metadata(path) ?? return .Err("{label} is unavailable")
    if !link.file_type().is_file() -> return .Err("{label} is not a regular file")
    options := OpenOptions.new()
    options.read(true)
    if selected_os() == "linux" || selected_os() == "android" -> options.custom_flags(0o400000)
    file :: options.open(path) ?? return .Err("cannot securely open {label}")
    metadata :: file.metadata() ?? return .Err("cannot inspect {label}")
    if selected_family() == "unix" {
        if metadata.permissions().mode() & 0o077 != 0 -> return .Err("{label} permissions expose session data")
        self_metadata :: fs.metadata("/proc/self") ?? return .Err("cannot verify browser trace owner")
        if metadata.uid() != self_metadata.uid() -> return .Err("{label} belongs to another user")
    }
    if !metadata.is_file() || metadata.len() > limit -> return .Err("{label} is not bounded")
    raw := ""
    file.take(limit + 1).read_to_string(&raw) ?? return .Err("cannot read {label}")
    if raw.len() as U64 > limit -> return .Err("{label} exceeds its limit")
    return ^raw
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:400
pub fn sources_from_manifest(manifest: String) -> [Source] Err! { return identity_from_manifest(manifest)?.0 }
// Rust: crates/jet-devserver/src/BrowserTrace.rs:404
fn identity_from_manifest(manifest: String) -> ([Source], String?) Err! {
    key :: "\"traceMap\": \""
    start :: manifest.find(key).map((index) -> index + key.len()) ?? return .Err("web manifest has no compiler trace map")
    end :: manifest[start..].find('"').map((index) -> start + index) ?? return .Err("web manifest trace map is malformed")
    sources :: decode_sources(unhex(manifest[start..end])?)?
    map_key :: "\"sourceMap\": \""
    source_map :: match manifest.find(map_key) {
        .Val(index) -> {
            start :: index + map_key.len()
            end :: manifest[start..].find('"').map((index) -> start + index) ?? return .Err("web manifest source map is malformed")
            .Val(unhex(manifest[start..end])?)
        }
        None -> None
    }
    return (^sources, ^source_map)
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:430
fn encode_sources(sources: &[Source]) -> String {
    lines := [String]{}
    for source in sources {
        lines.push("source\t{hex(source.path.as_bytes())}\t{source.sha256}")
        for (name, kind) in source.symbols -> lines.push("symbol\t{hex(source.path.as_bytes())}\t{hex(name.as_bytes())}\t{kind}")
    }
    lines.sort()
    return lines.join("\n")
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:450
fn decode_sources(text: String) -> [Source] Err! {
    sources := [Source]{}
    symbols := [(String, String, String)]{}
    for line in text.lines() {
        parts := line.split('\t')
        match parts.next() {
            .Val("source") -> {
                path :: unhex(parts.next() ?? return .Err("trace source path is missing"))?
                sha256 :: (parts.next() ?? return .Err("trace source hash is missing")).to_string()
                if parts.next().is_some() || sha256.len() != 64 || !sha256.bytes().all((byte) -> byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) -> return .Err("compiler trace source identity is malformed")
                sources.push(Source { path: ^path, sha256: ^sha256, symbols: [] })
            }
            .Val("symbol") -> {
                path :: unhex(parts.next() ?? return .Err("trace symbol path is missing"))?
                name :: unhex(parts.next() ?? return .Err("trace symbol name is missing"))?
                kind :: (parts.next() ?? return .Err("trace symbol kind is missing")).to_string()
                if parts.next().is_some() || name.is_empty() || (kind != "fn" && kind != "handler") -> return .Err("compiler trace symbol identity is malformed")
                symbols.push((^path, ^name, ^kind))
            }
            _ -> return .Err("compiler trace map row is malformed")
        }
    }
    if sources.is_empty() -> return .Err("compiler trace map has no sources")
    // Index first occurrence exactly as Rust find(), without repeated source scans.
    by_path := [String:Usize]{}
    for (i, source) in sources.iter().enumerate() {
        if !by_path.contains_key(source.path) -> by_path[~source.path] = i
    }
    names := [String:Bool]{}
    for (path, name, kind) in symbols {
        if names.contains_key(name) -> return .Err("compiler trace symbol `{name}` is ambiguous")
        i :: by_path.get(path) ?? return .Err("compiler trace symbol names an unknown source")
        names[~name] = true
        sources[i].symbols.push((^name, ^kind))
    }
    return ^sources
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:513
fn number(value: String?) -> U64 RecordError! {
    value :: value ?? return .Err(.Malformed)
    return U64.parse(value) ?? return .Err(.Malformed)
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:520
fn relay_status(line: String, action: String) -> DataTree Err! {
    value :: parse(line) ?? return .Err("browser trace relay record is malformed")
    object :: object_map(value)?
    if object.get("schema").and_then(json_str) != .Val(STATUS_SCHEMA) || object.get("action").and_then(json_str) != .Val(action) || object.get("ok") != .Val(.Bool(true)) || object.get("reports") != .Val(.Array(_)) || object.contains_key("status") -> return .Err("browser trace relay record is not a shared status")
    return ^value
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:534
fn relay_row(line: String) -> (U64, U64, String, String) Err! {
    value :: relay_status(line, "browser.relay.row")?
    object :: object_map(value)?
    start_ns :: object.get("start_ns").and_then(json_int).and_then((value) -> U64.try_from(value).ok()) ?? return .Err("browser trace relay start is malformed")
    duration_ns :: object.get("duration_ns").and_then(json_int).and_then((value) -> U64.try_from(value).ok()) ?? return .Err("browser trace relay duration is malformed")
    class :: (object.get("class").and_then(json_str) ?? return .Err("browser trace relay class is missing")).to_owned()
    symbol :: (object.get("symbol").and_then(json_str) ?? return .Err("browser trace relay symbol is missing")).to_owned()
    if (class != "event" && class != "wasm" && class != "dom") || symbol.is_empty() || symbol.len() > 128 || !symbol.bytes().all((b) -> b == 95 || b == 36 || b.is_ascii_alphanumeric()) -> return .Err("browser trace relay row is malformed")
    return (start_ns, duration_ns, ^class, ^symbol)
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:569
fn relay_header(header: String) -> (U32, String, [Source], String?) Err! {
    value :: relay_status(header, RELAY_ACTION)?
    object :: object_map(value)?
    _nonce :: object.get("nonce").and_then(json_str).filter((value) -> !value.is_empty()) ?? return .Err("browser trace relay nonce is missing")
    recorded_pid :: object.get("pid").and_then(json_u32) ?? return .Err("browser trace relay process id is missing")
    started :: (object.get("started").and_then(json_str).filter((value) -> !value.is_empty()) ?? return .Err("browser trace relay process identity is missing")).to_owned()
    sources :: object.get("sources").and_then(json_str) ?? return .Err("browser trace relay source map is missing")
    sources := decode_sources(unhex(sources)?)?
    source_map :: object.get("source_map").map((value) -> {
        text :: json_str(value) ?? return .Err("browser trace relay source map is malformed")
        unhex(text)
    }).transpose()?
    return (recorded_pid, ^started, ^sources, ^source_map)
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:603
fn nonce() -> String {
    // GATE #4494: randomized native hash state, process ID and system clock.
    state :: RandomState.new()
    seed :: SystemTime.now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos()
    out := ""
    for domain in [0 as U64, 1] {
        hasher := state.build_hasher()
        hasher.write_u128(seed)
        hasher.write_u32(std.process.id())
        hasher.write_u64(domain)
        out.push_str(format("{:016x}", hasher.finish()))
    }
    return ^out
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:620
fn process_start_marker(pid: U32) -> String? {
    if selected_os() == "linux" || selected_os() == "android" {
        stat :: fs.read_to_string("/proc/{pid}/stat").ok()?
        (_, rest) :: stat.rsplit_once(") ")?
        fields :: rest.split_whitespace().collect()
        return fields.get(19).map((value) -> value.to_string())
    }
    return None
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:636
fn object_map(value: &DataTree) -> [String:DataTree] Err! {
    fields :: match value { .Object(fields) -> fields; _ -> return .Err("browser trace relay record must be an object") }
    return fields.iter().map(((key, value)) -> (~key, ~value)).collect()
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:643
fn process_state(pid: U32) -> ProcessState {
    if selected_os() == "linux" || selected_os() == "android" {
        path :: OSPath.from("/proc/{pid}")
        if !path.exists() -> return .Dead
        return process_start_marker(pid).map((start) -> ProcessState.Alive(^start)).unwrap_or(.Unknown)
    }
    return .Unknown
}
// Rust: crates/jet-devserver/src/BrowserTrace.rs:661
fn unhex(text: String) -> String Err! {
    if text.len() % 2 != 0 -> return .Err("browser trace relay source encoding is malformed")
    digit :: (byte) -> {
        if byte >= 48 && byte <= 57 -> .Val(byte - 48)
        else if byte >= 97 && byte <= 102 -> .Val(byte - 97 + 10)
        else -> None
    }
    bytes := [U8].with_capacity(text.len() / 2)
    for pair in text.as_bytes().chunks_exact(2) {
        a :: digit(pair[0]) ?? return .Err("browser trace relay source encoding is malformed")
        b :: digit(pair[1]) ?? return .Err("browser trace relay source encoding is malformed")
        bytes.push(a * 16 + b)
    }
    return String.from_utf8(^bytes) ?? return .Err("browser trace relay source is not UTF-8")
}
