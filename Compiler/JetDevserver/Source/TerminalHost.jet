                    detail: if available -> "{panel_events.len()} event(s), retained {ordered.len()}/{self.config.max_events}"
                        else -> panel_state.map((row) -> unavailable_panel_detail(row.unavailable_reasons())).unwrap_or("unavailable"),
                    freshness}
