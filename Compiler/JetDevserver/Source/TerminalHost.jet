// Rust: crates/jet-devserver/src/TerminalHost.rs:1560
fn validate_text(value: String, label: String) -> () Err! { validate_optional_text(value, label, false) }
// Rust: crates/jet-devserver/src/TerminalHost.rs:1564
fn validate_optional_text(value: String, label: String, allow_empty: Bool) -> () Err! {
    if (!allow_empty && value.is_empty()) || value.len() > MAX_TERMINAL_TEXT_BYTES || value.chars().any(fn(c) -> c.is_control()) {
        return Err("terminal {label} is empty, too long, or contains control text")
    }
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1574
fn validate_projection(projection: DevtoolsProjection) -> () Err! {
    if projection.protocol != JET_DEVTOOLS_PROTOCOL -> return Err("devtools projection protocol must be {JET_DEVTOOLS_PROTOCOL}")
    validate_text(projection.session_id, "session id"); validate_optional_text(projection.revision, "revision", true)
    loop (value, label) in [(projection.source_id.as_ref(), "source id"), (projection.build_id.as_ref(), "build id"), (projection.world_id.as_ref(), "world id")] {
        if value == .Val(value) -> validate_text(value, label)
    }
    validate_status(projection.status)
    loop event in projection.panels {
        if event.sequence() == 0 -> return Err("devtools event sequence must be positive")
        if event.sequence() > projection.sequence -> return Err("devtools event sequence exceeds the projection cursor")
        validate_text(event.source(), "event source"); validate_text(event.kind(), "event kind")
        validate_text(event.entity(), "event entity"); validate_text(event.fields_json(), "event fields")
        if event.payload_json() == .Val(payload) -> validate_text(payload, "event payload")
    }
    if projection.selection == .Val(selection) {
        valid_panel :: descriptors().iter().any(fn(d) -> d.id.as_str() == selection.panel_id)
        if !valid_panel -> return Err("devtools selection panel `{selection.panel_id}` is not canonical")
        validate_optional_text(selection.item_key, "selection item", true)
    }
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1622
fn validate_status(status: DevtoolsStatusFact) -> () Err! {
    loop (value, label) in [(status.diagnostic_code.as_ref(), "diagnostic code"), (status.diagnostic.as_ref(), "diagnostic"),
        (status.accepted_revision.as_ref(), "accepted revision"), (status.last_good_revision.as_ref(), "last good revision"),
        (status.run_target.as_ref(), "run target"), (status.run_output.as_ref(), "run output"), (status.test_state.as_ref(), "test state")] {
        if value == .Val(value) { if value.is_empty() -> return Err("terminal {label} is empty") }
    }
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1641
fn bounded_status(status: DevtoolsStatusFact) -> DevtoolsStatusFact Err! {
    validate_status(status)
    bounded := status.clone()
    loop value in [&bounded.diagnostic_code, &bounded.diagnostic, &bounded.accepted_revision, &bounded.last_good_revision,
        &bounded.run_target, &bounded.run_output, &bounded.test_state] {
        if value == .Val(text) -> value = .Val(bounded_text(text, MAX_TERMINAL_TEXT_BYTES))
    }
    Ok(^bounded)
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1660
fn bounded_text(value: String, limit: USize) -> String {
    if limit == 0 -> return ""
    output := String.with_capacity(value.len().min(limit))
    loop character in value.chars() {
        replacement :: if character == {
            '\n' -> "\\n"
            '\r' -> "\\r"
            '\t' -> "\\t"
            else -> if character.is_control() -> "?" else -> ""
        }
        if replacement.is_empty() {
            if output.len().saturating_add(character.len_utf8()) > limit -> break
            &output.push(character)
            continue
        }
        if output.len().saturating_add(replacement.len()) > limit -> break
        &output.push_str(replacement)
    }
    ^output
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1687
fn display_optional(value: String) -> String { if value.is_empty() -> "-" else -> value }
// Rust: crates/jet-devserver/src/TerminalHost.rs:1695
fn yes_no(value: Bool) -> String { if value -> "yes" else -> "no" }
// Rust: crates/jet-devserver/src/TerminalHost.rs:1699
fn access_label(access: TerminalHostAccess) -> String {
    if access.read_only -> "read-only" else if access.release -> "release" else if access.local -> "local" else -> "remote"
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1711
fn session_state_label(state: DevtoolsSessionState) -> String {
    if state == { .Starting -> "starting", .Building -> "building", .Ready -> "ready", .Error -> "error", .Unavailable -> "unavailable", .Stopped -> "stopped" }
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1722
fn status_summary(status: DevtoolsStatusFact, reveal: Bool) -> String {
    fields := ["state={session_state_label(status.state)}"]
    loop (key, value) in [("diagnostic_code", status.diagnostic_code.as_ref()), ("diagnostic", status.diagnostic.as_ref()),
        ("accepted_revision", status.accepted_revision.as_ref()), ("last_good_revision", status.last_good_revision.as_ref()),
        ("run_target", status.run_target.as_ref()), ("run_output", status.run_output.as_ref()), ("test_state", status.test_state.as_ref())] {
        rendered :: if value == { .Val(value) -> if reveal -> value else -> "<redacted>", None -> "-" }
        &fields.push("{key}={rendered}")
    }
    fields.join(" ")
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1744
fn unavailable_panel_detail(reasons: [JetDevtoolsPanelUnavailableReason]) -> String {
    details :: reasons.iter().map(fn(reason) -> if reason == {
        .UnsupportedHost(host) -> "unsupported host {host.as_str()}"
        .MissingCapability(capability) -> "missing {capability.grant()}"
    }).collect()
    if details.is_empty() -> "unavailable" else -> details.join(", ")
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1765
fn ordered_events(events: VecDeque<TerminalHostEvent>) -> [&TerminalHostEvent] {
    ordered := events.iter().collect()
    &ordered.sort_by(fn(left, right) -> left.sequence.cmp(right.sequence)
        .then_with(fn() -> left.observed_at.cmp(right.observed_at))
        .then_with(fn() -> left.revision.cmp(right.revision))
        .then_with(fn() -> left.kind.cmp(right.kind))
        .then_with(fn() -> left.entity.cmp(right.entity))
        .then_with(fn() -> left.source.cmp(right.source)))
    ^ordered
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1779
fn event_key(event: TerminalHostEvent) -> String { "event:{event.revision}:{event.sequence}:{event.kind}:{event.entity}" }
// Rust: crates/jet-devserver/src/TerminalHost.rs:1783
fn event_summary(event: TerminalHostEvent, capabilities: TerminalHostCapabilities) -> String {
    details_enabled :: capabilities.access.local_details_enabled()
    published :: if details_enabled -> event.facts.iter().filter(fn(fact) -> fact.published).map(fn(fact) -> fact.display()).collect().join(",")
        else -> "<redacted>"
    values :: if published.is_empty() -> "-" else -> published
    verbose :: if capabilities.verbose -> " details=on" else -> ""
    revision :: if event.revision.is_empty() -> "-" else -> event.revision
    "{event.kind} · {event.entity} · {revision} · {event.observed_at}ms · source={event.source} · published_facts={event.published_fact_count()} · values={values}{verbose}"
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1819
fn panel_freshness(events: [&TerminalHostEvent], cursor: U64?) -> TerminalFreshness {
    if events.iter().map(fn(event) -> event.sequence).max() == .Val(latest) {
        if cursor.is_some_and(fn(cursor) -> cursor < latest) -> .Stale else -> .Fresh
    } else { .Empty }
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1830
fn overall_freshness(events: [&TerminalHostEvent], cursor: U64?) -> TerminalFreshness {
    if events.is_empty() -> return .Empty
    if events.iter().any(fn(event) -> cursor.is_some_and(fn(cursor) -> cursor < event.sequence)) -> .Stale else -> .Fresh
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1844
fn render_lines(tree: TerminalPanelTree, viewport: TerminalViewport, capabilities: TerminalHostCapabilities,
    session_id: String, source_id: String?, build_id: String?, world_id: String?, revision: String,
    cursor: U64?, observed_at: U64?, status: DevtoolsStatusFact?, focus: TerminalFocus, keyboard: TerminalKeyboardState,
    event_count: USize, event_limit: USize, freshness: TerminalFreshness) -> [String] {
    if capabilities.quiet -> return []
    raw := [String]{}
    sequence :: cursor.map(fn(value) -> "{value}").unwrap_or("-")
    observed :: observed_at.map(fn(value) -> "{value}").unwrap_or("-")
    state :: status.map(fn(status) -> session_state_label(status.state)).unwrap_or("-")
    &raw.push("jet devtools  session={display_optional(session_id)}  source_id={display_optional(source_id.unwrap_or(\"\"))}  build_id={display_optional(build_id.unwrap_or(\"\"))}  world_id={display_optional(world_id.unwrap_or(\"\"))}  revision={display_optional(revision)}  sequence={sequence}  observed_at={observed}  state={state}  freshness={freshness.label()}")
    &raw.push("terminal={viewport.width}x{viewport.height}  tty={yes_no(capabilities.tty)}  ansi={yes_no(capabilities.ansi)}  no_color={yes_no(capabilities.no_color)}  verbose={yes_no(capabilities.verbose)}  quiet={yes_no(capabilities.quiet)}  access={access_label(capabilities.access)}  local={yes_no(capabilities.access.local)}  release={yes_no(capabilities.access.release)}  read_only={yes_no(capabilities.access.read_only)}  nodes={tree.node_count}/{tree.node_limit}  events={event_count}/{event_limit}  focus={focus.panel_id.as_ref().unwrap_or(\"-\")}")
    if status == .Val(status) -> &raw.push("status: {status_summary(status, capabilities.access.local_details_enabled())}")
    loop panel in tree.root.children {
        selected :: focus.panel_id.as_ref().is_some_and(fn(id) -> panel.id.strip_prefix("panel:").is_some_and(fn(candidate) -> candidate == id))
        marker :: if selected -> ">" else -> " "
        panel_label :: if selected -> style("{marker}[{panel.label}]", "36", capabilities) else -> "{marker}[{panel.label}]"
        &raw.push("{panel_label} {panel.freshness.label()}")
        loop child in panel.children {
            if child.kind == {
                .Status -> { if child.status == .Val(status) -> &raw.push("  status={style(status.label, \"33\", capabilities)}  {status.detail}") }
                .Text -> &raw.push("  {child.text.as_ref().unwrap_or(\"\")}")
                .Table -> { if child.table == .Val(table) { loop row in table.rows { &raw.push("  {row.cells.join(\" | \")}") } } }
                .Root | .Panel -> {}
            }
        }
    }
    action_help :: if capabilities.access.actions_enabled() -> "r rerun  R restart" else -> "r/R disabled(read-only)"
    last :: keyboard.last_action.as_ref().map(fn(action) -> action_label(action)).unwrap_or("none")
    &raw.push("keys: Tab/Down next panel  Shift-Tab/Up previous  Enter inspect  Esc back  {action_help}  j jobs  t time  q quit  last={last}")
    skip :: viewport.scroll.min(raw.len())
    raw.iter().skip(skip).take(viewport.height).map(fn(line) -> truncate_columns(line, viewport.width)).collect()
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1965
fn action_label(action: TerminalAction) -> String {
    if action == { .FocusPanel{..} -> "focus-panel", .Inspect{..} -> "inspect", .ReturnToPanel -> "back", .MoveCursor{..} -> "time",
        .Rerun -> "rerun", .Restart -> "restart", .FocusJob -> "jobs", .Quit -> "quit", .Ignored -> "ignored" }
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1979
fn style(text: String, code: String, capabilities: TerminalHostCapabilities) -> String {
    if capabilities.color_enabled() -> "\x1b[{code}m{text}\x1b[0m" else -> text.to_string()
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:1987
fn strip_ansi(text: String) -> String {
    output := String.with_capacity(text.len()); chars := text.chars()
    loop {
        ch :: &chars.next()
        if ch == .Val(ch) {
            if ch == '\x1b' && &chars.next() == .Val('[') {
                loop {
                    code :: &chars.next()
                    if code == .Val(code) { if code >= '@' && code <= '~' -> break }
                    else { break }
                }
            } else { &output.push(ch) }
        } else { break }
    }
    ^output
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:2004
fn truncate_columns(text: String, width: USize) -> String {
    limit :: width.max(1); output := String.with_capacity(text.len().min(limit.saturating_add(16)))
    chars := text.chars().peekable(); visible := USize{0}; clipped := false; has_ansi :: text.contains('\x1b')
    loop {
        character :: &chars.next()
        if character == .Val(character) {
            if character == '\x1b' && &chars.peek() == .Val('[') {
                &output.push(character); &output.push(&chars.next().expect("CSI introducer follows escape"))
                loop {
                    code :: &chars.next()
                    if code == .Val(code) { &output.push(code); if code >= '@' && code <= '~' -> break }
                    else { break }
                }
                continue
            }
            if visible >= limit { clipped = true; break }
            &output.push(character); visible += 1
        } else { break }
    }
    if clipped && has_ansi -> &output.push_str("\x1b[0m")
    ^output
}

