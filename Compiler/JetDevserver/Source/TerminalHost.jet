// Rust: crates/jet-devserver/src/TerminalHost.rs:322
pub struct TerminalHostFact {
    pub key: String; pub value: TerminalFactValue?; pub published: Bool
    // Rust: crates/jet-devserver/src/TerminalHost.rs:328
    pub fn redacted(key: String) -> TerminalHostFact { TerminalHostFact{key: ^key, value: None, published: false} }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:336
    pub fn text(key: String, value: String) -> TerminalHostFact { TerminalHostFact{key: ^key, value: .Val(.Text(^value)), published: true} }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:344
    pub fn text_bounded(key: String, value: String) -> TerminalHostFact { TerminalHostFact.text(^key, bounded_text(value, MAX_TERMINAL_TEXT_BYTES)) }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:348
    pub fn integer(key: String, value: I64) -> TerminalHostFact { TerminalHostFact{key: ^key, value: .Val(.Integer(value)), published: true} }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:356
    pub fn boolean(key: String, value: Bool) -> TerminalHostFact { TerminalHostFact{key: ^key, value: .Val(.Boolean(value)), published: true} }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:364
    pub fn duration_ms(key: String, value: U64) -> TerminalHostFact { TerminalHostFact{key: ^key, value: .Val(.DurationMs(value)), published: true} }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:372
    fn validate(self) -> () Err! {
        validate_text(self.key, "fact key")
        if !self.published && self.value.is_some() -> return Err("terminal fact `{self.key}` is redacted but carries a value")
        if self.value == .Val(.Text(value)) -> validate_text(value, "fact value")
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:383
    fn display(self) -> String {
        if self.published { if self.value == .Val(value) -> return "{self.key}={value.display()}" }
        "{self.key}=<redacted>"
    }
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:400
pub struct TerminalHostEvent {
    pub protocol: String; pub session_id: String; pub revision: String; pub sequence: U64; pub observed_at: U64
    pub source: String; pub kind: String; pub entity: String; pub panel_id: JetDevtoolsPanelId; pub facts: [TerminalHostFact]
    // Rust: crates/jet-devserver/src/TerminalHost.rs:413
    pub fn new(panel_id: JetDevtoolsPanelId, session_id: String, revision: String, sequence: U64, observed_at: U64, source: String, kind: String, entity: String, facts: [TerminalHostFact]) -> TerminalHostEvent {
        TerminalHostEvent.from_projection(panel_id, JET_DEVTOOLS_PROTOCOL, ^session_id, ^revision, sequence, observed_at, ^source, ^kind, ^entity, ^facts)
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:438
    pub fn from_projection(panel_id: JetDevtoolsPanelId, protocol: String, session_id: String, revision: String, sequence: U64, observed_at: U64, source: String, kind: String, entity: String, facts: [TerminalHostFact]) -> TerminalHostEvent {
        TerminalHostEvent{protocol: ^protocol, session_id: ^session_id, revision: ^revision, sequence, observed_at, source: ^source, kind: ^kind, entity: ^entity, panel_id, facts: ^facts}
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:464
    pub fn from_devtools_event(event: JetDevtoolsEvent, protocol: String, session_id: String, revision: String, panel_id: JetDevtoolsPanelId) -> TerminalHostEvent {
        facts := [TerminalHostFact.text_bounded("fields", event.fields_json())]
        if event.payload_json() == .Val(payload) -> &facts.push(TerminalHostFact.text_bounded("payload", payload))
        TerminalHostEvent.from_projection(panel_id, protocol.clone(), session_id.clone(), revision.clone(), event.sequence(), event.timestamp_ms, event.source().to_string(), event.kind().to_string(), event.entity().to_string(), ^facts)
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:489
    pub fn published_fact_count(self) -> USize { self.facts.iter().filter(fn(fact) -> fact.published).count() }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:493
    fn validate(self) -> () Err! {
        if self.protocol != JET_DEVTOOLS_PROTOCOL -> return Err("terminal event protocol must be {JET_DEVTOOLS_PROTOCOL}")
        validate_text(self.session_id, "session id")
        validate_optional_text(self.revision, "revision", true)
        if self.sequence == 0 -> return Err("terminal event sequence must be positive")
        validate_text(self.source, "event source"); validate_text(self.kind, "event kind"); validate_text(self.entity, "event entity")
        if self.facts.len() > MAX_TERMINAL_FACTS -> return Err("terminal event exceeds its fact bound")
        keys := [String:Bool]{}
        loop fact in self.facts {
            fact.validate()
            if keys.contains_key(fact.key) -> return Err("terminal event repeats fact key `{fact.key}`")
            &keys.insert(fact.key.clone(), true)
        }
    }
}
