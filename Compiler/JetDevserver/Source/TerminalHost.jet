fn panel_availability(host: JetDevtoolsHostKind, grants: [JetDevtoolsPanelCapability]) -> [JetDevtoolsPanelAvailability] {
    JetDevtoolsPanelCatalog.canonical().map((catalog) -> catalog.available_for(host, grants)).unwrap_or([])
}
// Rust: crates/jet-devserver/src/TerminalHost.rs:40
fn terminal_panel_availability(access: TerminalHostAccess) -> [JetDevtoolsPanelAvailability] {
    grants :: if access.local_details_enabled() -> JetDevtoolsPanelCapability.ALL else -> []
    panel_availability(.Terminal, grants)
}
