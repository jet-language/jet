    // Rust: crates/jet-devserver/src/TerminalHost.rs:328
    fn redacted(key: String) -> TerminalHostFact { TerminalHostFact{key: ^key, value: None, published: false} }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:336
    fn text(key: String, value: String) -> TerminalHostFact { TerminalHostFact{key: ^key, value: .Val(.Text(^value)), published: true} }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:344
    fn text_bounded(key: String, value: String) -> TerminalHostFact { TerminalHostFact.text(^key, bounded_text(value, MAX_TERMINAL_TEXT_BYTES)) }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:348
    fn integer(key: String, value: I64) -> TerminalHostFact { TerminalHostFact{key: ^key, value: .Val(.Integer(value)), published: true} }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:356
    fn boolean(key: String, value: Bool) -> TerminalHostFact { TerminalHostFact{key: ^key, value: .Val(.Boolean(value)), published: true} }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:364
