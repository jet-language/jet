    fn inspect_focused(self: &TerminalHost) -> TerminalAction {
        panel_id :: self.focus.panel_id.clone().unwrap_or_else(fn() -> first_panel_id().to_string())
        if self.focus.item_key.clone() == .Val(item_key) -> return .Inspect{panel_id: ^panel_id, item_key: ^item_key}
        item_key :: ordered_events(self.events).iter().rev().find(fn(event) -> self.panel_id_for_event(event) == panel_id).map(fn(event) -> event_key(event))
        if item_key == .Val(item_key) {
            self.focus.item_key = .Val(item_key.clone())
            return .Inspect{panel_id: ^panel_id, item_key: ^item_key}
        }
        .FocusPanel{panel_id: ^panel_id}
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:1380
    fn move_cursor(self: &TerminalHost) -> TerminalAction {
        sequences := ordered_events(self.events).iter().map(fn(event) -> event.sequence).collect()
        &sequences.sort_unstable(); &sequences.dedup()
        if sequences.is_empty() -> return .Ignored
        current :: self.time_cursor.unwrap_or(sequences[0])
        next :: sequences.iter().find(fn(sequence) -> sequence > current).unwrap_or(sequences[0])
        self.time_cursor = .Val(next); .MoveCursor{cursor: next}
    }
