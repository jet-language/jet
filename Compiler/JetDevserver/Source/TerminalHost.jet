pub struct TerminalNode {
    pub id: String; pub kind: TerminalNodeKind; pub label: String; pub bounds: TerminalBounds
    pub freshness: TerminalFreshness; pub focusable: Bool; pub text: String?; pub status: TerminalStatus?; pub table: TerminalTable?
    pub children: [TerminalNode]
    // Rust: crates/jet-devserver/src/TerminalHost.rs:655
    fn container(id: String, kind: TerminalNodeKind, label: String, bounds: TerminalBounds, freshness: TerminalFreshness, children: [TerminalNode]) -> TerminalNode {
        TerminalNode{id: ^id, kind, label: ^label, bounds, freshness, focusable: false, text: None, status: None, table: None, children: ^children}
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:677
    fn text(id: String, label: String, text: String, bounds: TerminalBounds, freshness: TerminalFreshness) -> TerminalNode {
        TerminalNode{id: ^id, kind: .Text, label: ^label, bounds, freshness, focusable: false, text: .Val(^text), status: None, table: None, children: []}
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:698
    fn status(id: String, label: String, status: TerminalStatus, bounds: TerminalBounds, focusable: Bool) -> TerminalNode {
        freshness :: status.freshness
        TerminalNode{id: ^id, kind: .Status, label: ^label, bounds, freshness, focusable, text: None, status: .Val(^status), table: None, children: []}
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:719
    fn table(id: String, label: String, table: TerminalTable, bounds: TerminalBounds, freshness: TerminalFreshness) -> TerminalNode {
        TerminalNode{id: ^id, kind: .Table, label: ^label, bounds, freshness, focusable: false, text: None, status: None, table: .Val(^table), children: []}
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:740
    pub fn is_leaf(self) -> Bool { self.children.is_empty() }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:744
    pub fn find(self, id: String) -> TerminalNode? {
        if self.id == id -> return .Val(self)
        self.children.iter().find_map(fn(child) -> child.find(id))
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:751
    fn flatten(self, out: &[String:&TerminalNode]) -> () {
        &out.insert(self.id.clone(), &self)
        loop child in self.children { child.flatten(&out) }
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:758
    fn count(self) -> USize { 1 + self.children.iter().map(fn(child) -> child.count()).sum() }
}
