    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:1234
    pub fn clear_item_focus(self: &TerminalHost) -> () { &self.focus.clear_item(); self.keyboard.last_action = .Val(.ReturnToPanel) }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:1239
    pub fn handle(self: &TerminalHost, input: TerminalInput) -> TerminalAction {
        if input == {
            .Key(key) -> &self.handle_key(key)
            .Resize(viewport) -> { &self.set_viewport(viewport); action :: TerminalAction.Ignored; self.keyboard.last_action = .Val(action.clone()); action }
        }
    }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:1254
    pub fn handle_key(self: &TerminalHost, key: TerminalKey) -> TerminalAction {
        self.keyboard.last_key = .Val(key)
        action :: if key == {
            .Tab | .Down -> &self.move_panel(1)
            .BackTab | .Up -> &self.move_panel(-1)
            .Enter | .Right -> &self.inspect_focused()
            .Escape | .Left -> {
                if self.focus.item_key.is_some() { &self.clear_item_focus(); TerminalAction.ReturnToPanel }
                else { TerminalAction.Ignored }
            }
            .Character('r') -> if self.config.capabilities.access.actions_enabled() -> TerminalAction.Rerun else -> TerminalAction.Ignored
            .Character('R') -> if self.config.capabilities.access.actions_enabled() -> TerminalAction.Restart else -> TerminalAction.Ignored
            .Character('j') -> { _ :: &self.focus_panel("jobs"); TerminalAction.FocusJob }
            .Character('q') -> TerminalAction.Quit
            .Character('t') -> &self.move_cursor()
            .Character(_) -> TerminalAction.Ignored
        }
        self.keyboard.last_action = .Val(action.clone())
        action
    }
