// Deterministic terminal facts for the shared jet.devtools.v1 stream.
use jet_foundation.[JetDevtoolsEvent, JetDevtoolsLifecycleState]

MAX_TERMINAL_EVENTS: Int{256}
MAX_TERMINAL_FACTS: Int{64}
MAX_TERMINAL_TEXT_BYTES: Int{16384}
MAX_TERMINAL_NODES: Int{2048}
DEFAULT_TERMINAL_COLUMNS: Int{80}
DEFAULT_TERMINAL_ROWS: Int{24}

first_panel_id: fn() -> String {
    loop descriptor in descriptors() -> return descriptor.id.as_str()
    ""
}
panel_availability: fn(host: JetDevtoolsHostKind, grants: [JetDevtoolsPanelCapability]) -> [JetDevtoolsPanelAvailability] {
    panel_catalog: JetDevtoolsPanelCatalog.canonical() ?? return [JetDevtoolsPanelAvailability]{}
    panel_catalog.available_for(host, grants)
}
terminal_panel_availability: fn(access: TerminalHostAccess) -> [JetDevtoolsPanelAvailability] {
    grants: if access.local_details_enabled() -> JetDevtoolsPanelCapability.ALL else -> [JetDevtoolsPanelCapability]{}
    panel_availability(.Terminal, grants)
}

#Error
TerminalHostError: struct {
    message: String

    impl Display { display: fn(&&self) -> String { self.message } }
}
TerminalHostAccess: struct {
    local: Bool
    release: Bool
    read_only: Bool

    interactive: fn() -> TerminalHostAccess { TerminalHostAccess{local: true, release: false, read_only: false} }
    local_details_enabled: fn(self) -> Bool { self.local && !self.release }
    actions_enabled: fn(self) -> Bool { !self.read_only }
}
TerminalHostCapabilities: struct {
    tty: Bool
    ansi: Bool
    no_color: Bool
    width: Int
    verbose: Bool
    quiet: Bool
    access: TerminalHostAccess

    new: fn(tty: Bool, ansi: Bool, no_color: Bool, width: Int, verbose: Bool, quiet: Bool, access: TerminalHostAccess) -> TerminalHostCapabilities {
        TerminalHostCapabilities{tty: tty, ansi: ansi, no_color: no_color, width: terminal_at_least_one(width), verbose: verbose, quiet: quiet, access: access}
    }
    color: fn() -> TerminalHostCapabilities { TerminalHostCapabilities.new(true, true, false, DEFAULT_TERMINAL_COLUMNS, false, false, TerminalHostAccess.interactive()) }
    plain: fn() -> TerminalHostCapabilities { TerminalHostCapabilities.new(false, false, true, DEFAULT_TERMINAL_COLUMNS, false, false, TerminalHostAccess.interactive()) }
    color_enabled: fn(self) -> Bool { self.tty && self.ansi && !self.no_color }
}
TerminalBounds: struct {
    x: Int
    y: Int
    width: Int
    height: Int

    right: fn(self) -> Int { self.x + self.width }
    bottom: fn(self) -> Int { self.y + self.height }
    contains: fn(self, x: Int, y: Int) -> Bool { x >= self.x && y >= self.y && x < self.right() && y < self.bottom() }
}
TerminalViewport: struct {
    width: Int
    height: Int
    scroll: Int

    new: fn(width: Int, height: Int) -> TerminalViewport { TerminalViewport.with_scroll(width, height, 0) }
    with_scroll: fn(width: Int, height: Int, scroll: Int) -> TerminalViewport {
        TerminalViewport{width: terminal_at_least_one(width), height: terminal_at_least_one(height), scroll: scroll}
    }
    bounds: fn(self) -> TerminalBounds { TerminalBounds{x: 0, y: 0, width: self.width, height: self.height} }
    resize: fn(self, width: Int, height: Int) -> TerminalViewport { TerminalViewport.with_scroll(width, height, self.scroll) }
}
TerminalHostConfig: struct {
    viewport: TerminalViewport
    capabilities: TerminalHostCapabilities
    max_events: Int
    max_nodes: Int

    new: fn(viewport: TerminalViewport, capabilities: TerminalHostCapabilities) -> TerminalHostConfig {
        TerminalHostConfig{viewport: viewport, capabilities: capabilities, max_events: MAX_TERMINAL_EVENTS, max_nodes: MAX_TERMINAL_NODES}
    }
    standard: fn() -> TerminalHostConfig {
        TerminalHostConfig.new(TerminalViewport.new(DEFAULT_TERMINAL_COLUMNS, DEFAULT_TERMINAL_ROWS), TerminalHostCapabilities.plain())
    }
    with_limits: fn(self, max_events: Int, max_nodes: Int) -> TerminalHostConfig {
        config := self
        config.max_events = terminal_clamp(max_events, 1, MAX_TERMINAL_EVENTS)
        config.max_nodes = terminal_clamp(max_nodes, 1, MAX_TERMINAL_NODES)
        config
    }
    with_viewport: fn(self, viewport: TerminalViewport) -> TerminalHostConfig {
        config := self
        config.viewport = viewport
        config
    }
    with_capabilities: fn(self, capabilities: TerminalHostCapabilities) -> TerminalHostConfig {
        config := self
        config.capabilities = capabilities
        config
    }
}
TerminalFactValue: enum {
    Text(value: String) Integer(value: Int) Boolean(value: Bool) DurationMs(value: Int)

    display: fn(self) -> String {
        if self == {
            .Text(value) -> value
            .Integer(value) -> "{value}"
            .Boolean(value) -> "{value}"
            .DurationMs(value) -> "{value}ms"
        }
    }
}
TerminalHostFact: struct {
    key: String
    value: TerminalFactValue?
    published: Bool

    redacted: fn(key: String) -> TerminalHostFact { TerminalHostFact{key: key, value: None, published: false} }
    text: fn(key: String, value: String) -> TerminalHostFact { TerminalHostFact{key: key, value: Val(TerminalFactValue.Text(value: value)), published: true} }
    text_bounded: fn(key: String, value: String) -> TerminalHostFact { TerminalHostFact.text(key, terminal_bounded_text(value, MAX_TERMINAL_TEXT_BYTES)) }
    integer: fn(key: String, value: Int) -> TerminalHostFact { TerminalHostFact{key: key, value: Val(TerminalFactValue.Integer(value: value)), published: true} }
    boolean: fn(key: String, value: Bool) -> TerminalHostFact { TerminalHostFact{key: key, value: Val(TerminalFactValue.Boolean(value: value)), published: true} }
    duration_ms: fn(key: String, value: Int) -> TerminalHostFact { TerminalHostFact{key: key, value: Val(TerminalFactValue.DurationMs(value: value)), published: true} }
    validate: fn(self) TerminalHostError! {
        terminal_validate_text(self.key, "fact key", false)
        if !self.published && self.value != None -> return Err(TerminalHostError{message: "terminal fact `{self.key}` is redacted but carries a value"})
        if self.value == .Val(.Text(text)) -> terminal_validate_text(text, "fact value", false)
    }
    display: fn(self) -> String {
        if self.published {
            if self.value == .Val(value) -> return "{self.key}={value.display()}"
        }
        "{self.key}=<redacted>"
    }
}
TerminalHostEvent: struct {
    protocol: String
    session_id: String
    revision: String
    sequence: Int
    observed_at: Int
    source: String
    kind: String
    entity: String
    panel_id: JetDevtoolsPanelId
    facts: [TerminalHostFact]

    from_devtools_event: fn(event: JetDevtoolsEvent, protocol: String, session_id: String, revision: String, panel_id: JetDevtoolsPanelId) -> TerminalHostEvent {
        facts := [TerminalHostFact]{}
        facts.push(TerminalHostFact.text_bounded("fields", event.fields_json()))
        if event.payload_json() == .Val(payload) -> facts.push(TerminalHostFact.text_bounded("payload", payload))
        TerminalHostEvent{
            protocol: protocol, session_id: session_id, revision: revision, sequence: event.sequence(), observed_at: event.timestamp_ms,
            source: event.source(), kind: event.kind(), entity: event.entity(), panel_id: panel_id, facts: facts,
        }
    }
    published_fact_count: fn(self) -> Int {
        count := 0
        loop fact in self.facts {
            if fact.published -> count += 1
        }
        count
    }
    validate: fn(self) TerminalHostError! {
        if self.protocol != JET_DEVTOOLS_PROTOCOL -> return Err(TerminalHostError{message: "terminal event protocol must be {JET_DEVTOOLS_PROTOCOL}"})
        terminal_validate_text(self.session_id, "session id", false)
        terminal_validate_text(self.revision, "revision", true)
        if self.sequence <= 0 -> return Err(TerminalHostError{message: "terminal event sequence must be positive"})
        terminal_validate_text(self.source, "event source", false)
        terminal_validate_text(self.kind, "event kind", false)
        terminal_validate_text(self.entity, "event entity", false)
        if self.facts.len() > MAX_TERMINAL_FACTS -> return Err(TerminalHostError{message: "terminal event exceeds its fact bound"})
        keys := [String: Bool]{}
        loop fact in self.facts {
            fact.validate()
            if keys.get(fact.key) != None -> return Err(TerminalHostError{message: "terminal event repeats fact key `{fact.key}`"})
            keys[fact.key] = true
        }
    }
    // The stable item key the terminal focuses and inspects.
    key: fn(self) -> String { "event:{self.revision}:{self.sequence}:{self.kind}:{self.entity}" }
}
TerminalFocus: struct {
    panel_id: String?
    item_key: String?

    panel: fn(panel_id: String) -> TerminalFocus { TerminalFocus{panel_id: Val(panel_id), item_key: None} }
    item: fn(panel_id: String, item_key: String) -> TerminalFocus { TerminalFocus{panel_id: Val(panel_id), item_key: Val(item_key)} }
}
// A key press; `TerminalKey.Character` holds the one typed character.
TerminalInput: enum { Key(key: TerminalKey) Resize(viewport: TerminalViewport) }
impl TerminalAction {
    label: fn(self) -> String {
        if self == {
            .FocusPanel(_) -> "focus-panel"
            .Inspect(_, _) -> "inspect"
            .ReturnToPanel -> "back"
            .MoveCursor(_) -> "time"
            .Rerun -> "rerun"
            .Restart -> "restart"
            .FocusJob -> "jobs"
            .Quit -> "quit"
            .Ignored -> "ignored"
        }
    }
}
TerminalKeyboardState: struct { last_key: TerminalKey?, last_action: TerminalAction? }

impl TerminalFreshness {
    label: fn(self) -> String {
        if self == {
            .Empty -> "empty"
            .Fresh -> "fresh"
            .Stale -> "stale"
        }
    }
}

TerminalStatus: struct { label: String, detail: String, freshness: TerminalFreshness }
TerminalTableRow: struct { key: String, cells: [String] }
TerminalTable: struct { columns: [String], rows: [TerminalTableRow] }
TerminalNode: struct {
    id: String
    kind: TerminalNodeKind
    label: String
    bounds: TerminalBounds
    freshness: TerminalFreshness
    focusable: Bool
    text: String?
    status: TerminalStatus?
    table: TerminalTable?
    children: [TerminalNode]

    container: fn(id: String, kind: TerminalNodeKind, label: String, bounds: TerminalBounds, freshness: TerminalFreshness, children: [TerminalNode]) -> TerminalNode {
        TerminalNode{id: id, kind: kind, label: label, bounds: bounds, freshness: freshness, focusable: false, text: None, status: None, table: None, children: children}
    }
    text_node: fn(id: String, label: String, text: String, bounds: TerminalBounds, freshness: TerminalFreshness) -> TerminalNode {
        TerminalNode{id: id, kind: .Text, label: label, bounds: bounds, freshness: freshness, focusable: false, text: Val(text), status: None, table: None, children: [TerminalNode]{}}
    }
    status_node: fn(id: String, label: String, status: TerminalStatus, bounds: TerminalBounds, focusable: Bool) -> TerminalNode {
        TerminalNode{id: id, kind: .Status, label: label, bounds: bounds, freshness: status.freshness, focusable: focusable, text: None, status: Val(status), table: None, children: [TerminalNode]{}}
    }
    table_node: fn(id: String, label: String, table: TerminalTable, bounds: TerminalBounds, freshness: TerminalFreshness) -> TerminalNode {
        TerminalNode{id: id, kind: .Table, label: label, bounds: bounds, freshness: freshness, focusable: false, text: None, status: None, table: Val(table), children: [TerminalNode]{}}
    }
    is_leaf: fn(self) -> Bool { self.children.len() == 0 }
    find: fn(self, id: String) -> TerminalNode? {
        if self.id == id -> return Val(self)
        loop child in self.children {
            if child.find(id) == .Val(found) -> return Val(found)
        }
        None
    }
    flatten: fn(self, out: &[String: TerminalNode]) {
        out[self.id] = self
        loop child in self.children -> child.flatten(out)
    }
    count: fn(self) -> Int {
        total := 1
        loop child in self.children -> total += child.count()
        total
    }
}
TerminalPanelTree: struct {
    root: TerminalNode
    bounds: TerminalBounds
    node_count: Int
    node_limit: Int
    panel_count: Int

    panel: fn(self, panel_id: String) -> TerminalNode? {
        loop node in self.root.children {
            if node.id == "panel:{panel_id}" -> return Val(node)
        }
        None
    }
    nodes: fn(self) -> [String: TerminalNode] {
        nodes := [String: TerminalNode]{}
        self.root.flatten(nodes)
        nodes
    }
}
TerminalFrame: struct {
    protocol: String
    session_id: String
    source_id: String?
    build_id: String?
    world_id: String?
    observed_at: Int?
    status: DevtoolsStatusFact?
    revision: String
    cursor: Int?
    viewport: TerminalViewport
    capabilities: TerminalHostCapabilities
    focus: TerminalFocus
    keyboard: TerminalKeyboardState
    freshness: TerminalFreshness
    event_count: Int
    event_limit: Int
    tree: TerminalPanelTree
    lines: [String]

    text: fn(self) -> String { self.lines.join("\n") }
    plain_lines: fn(self) -> [String] { loop line in self.lines -> terminal_strip_ansi(line) }
    plain_text: fn(self) -> String { self.plain_lines().join("\n") }
    panel: fn(self, panel_id: String) -> TerminalNode? { self.tree.panel(panel_id) }
    diff: fn(self, previous: TerminalFrame) -> TerminalDiff {
        before: previous.tree.nodes()
        after: self.tree.nodes()
        ids := [String: Bool]{}
        loop id in before.keys().to_list() -> ids[id] = true
        loop id in after.keys().to_list() -> ids[id] = true
        ordered_ids := ids.keys().to_list()
        ordered_ids.sort_by((left, right) -> left <=> right)
        operations := [TerminalDiffOperation]{}
        loop id in ordered_ids {
            old: before.get(id)
            new: after.get(id)
            if old == None {
                if new == .Val(node) -> operations.push(TerminalDiffOperation.Insert(id: id, node: node))
            } else if new == None {
                operations.push(TerminalDiffOperation.Remove(id: id))
            } else if old != new {
                if new == .Val(node) -> operations.push(TerminalDiffOperation.Replace(id: id, node: node))
            }
        }
        metadata_changed: previous.protocol != self.protocol || previous.session_id != self.session_id
            || previous.source_id != self.source_id || previous.build_id != self.build_id || previous.world_id != self.world_id
            || previous.observed_at != self.observed_at || previous.status != self.status || previous.capabilities != self.capabilities
            || previous.cursor != self.cursor || previous.freshness != self.freshness || previous.event_count != self.event_count || previous.event_limit != self.event_limit
        TerminalDiff{
            from_revision: previous.revision, to_revision: self.revision, operations: operations,
            viewport_changed: previous.viewport != self.viewport, focus_changed: previous.focus != self.focus,
            keyboard_changed: previous.keyboard != self.keyboard, metadata_changed: metadata_changed,
            lines_changed: previous.plain_lines() != self.plain_lines(),
        }
    }
}
TerminalDiff: struct {
    from_revision: String
    to_revision: String
    operations: [TerminalDiffOperation]
    viewport_changed: Bool
    focus_changed: Bool
    keyboard_changed: Bool
    metadata_changed: Bool
    lines_changed: Bool

    initial: fn(frame: TerminalFrame) -> TerminalDiff {
        nodes: frame.tree.nodes()
        ids := nodes.keys().to_list()
        ids.sort_by((left, right) -> left <=> right)
        operations := [TerminalDiffOperation]{}
        loop id in ids {
            if nodes.get(id) == .Val(node) -> operations.push(TerminalDiffOperation.Insert(id: id, node: node))
        }
        TerminalDiff{
            from_revision: "", to_revision: frame.revision, operations: operations,
            viewport_changed: true, focus_changed: true, keyboard_changed: true, metadata_changed: true, lines_changed: true,
        }
    }
    is_empty: fn(self) -> Bool {
        self.operations.len() == 0 && !self.viewport_changed && !self.focus_changed && !self.keyboard_changed && !self.metadata_changed && !self.lines_changed
    }
}
// Retains the bounded typed event ring; derives frames without a second panel model.
TerminalHost: struct {
    config: TerminalHostConfig
    // Oldest first, bounded by config.max_events.
    events: [TerminalHostEvent]
    session_id: String?
    source_id: String?
    build_id: String?
    world_id: String?
    revision: String?
    cursor: Int?
    time_cursor: Int?
    observed_at: Int?
    status: DevtoolsStatusFact?
    focus: TerminalFocus
    keyboard: TerminalKeyboardState

    new: fn(config: TerminalHostConfig) -> TerminalHost {
        bounded: config.with_limits(config.max_events, config.max_nodes)
        TerminalHost{
            config: bounded, events: [TerminalHostEvent]{}, session_id: None, source_id: None, build_id: None,
            world_id: None, revision: None, cursor: None, time_cursor: None, observed_at: None, status: None,
            focus: TerminalFocus.panel(first_panel_id()), keyboard: TerminalKeyboardState{last_key: None, last_action: None},
        }
    }
    standard: fn() -> TerminalHost { TerminalHost.new(TerminalHostConfig.standard()) }
    panel_availability: fn(self) -> [JetDevtoolsPanelAvailability] { terminal_panel_availability(self.config.capabilities.access) }
    viewport: fn(self) -> TerminalViewport { self.effective_viewport() }
    // The time cursor when one is set, else the latest event cursor.
    display_cursor: fn(self) -> Int? {
        if self.time_cursor != None -> return self.time_cursor
        self.cursor
    }
    append_event: fn(&self, event: TerminalHostEvent) TerminalHostError! {
        event.validate()
        if self.session_id == .Val(session_id) {
            if session_id != event.session_id -> return Err(TerminalHostError{message: "terminal event session id does not match the host"})
        } else {
            self.session_id = Val(event.session_id)
        }
        if self.revision == .Val(revision) {
            if revision != event.revision -> return Err(TerminalHostError{message: "terminal event revision does not match the host"})
        } else {
            self.revision = Val(event.revision)
        }
        if self.cursor == .Val(cursor) {
            if event.sequence <= cursor -> return Err(TerminalHostError{message: "terminal event sequence is not newer than the host cursor"})
        }
        self.observed_at = Val(event.observed_at)
        self.cursor = Val(event.sequence)
        if self.time_cursor == None -> self.time_cursor = Val(event.sequence)
        first_event: self.events.len() == 0
        panel_id: event.panel_id.as_str()
        if self.events.len() >= self.config.max_events {
            first: self.events.len() - self.config.max_events + 1
            self.events = loop index in first..<self.events.len() -> self.events[index]
        }
        self.events.push(event)
        if first_event {
            self.focus = TerminalFocus.item(panel_id, event.key())
        } else if self.focus.panel_id == None {
            self.focus.panel_id = Val(panel_id)
        }
        self.keyboard.last_action = Val(TerminalAction.FocusPanel(panel_id: self.focus.panel_id ?? panel_id))
    }
    // `panel_ids` maps each event sequence to the panel that owns it.
    sync_projection: fn(&self, projection: DevtoolsProjection, panel_ids: [Int: JetDevtoolsPanelId]) -> TerminalFrame TerminalHostError! {
        terminal_validate_projection(projection)
        session_changed := false
        if self.session_id == .Val(id) -> session_changed = id != projection.session_id
        revision_changed := false
        if self.revision == .Val(revision) -> revision_changed = revision != projection.revision
        if session_changed || revision_changed || projection.reset || projection.truncation {
            self.time_cursor = None
            self.events = [TerminalHostEvent]{}
            self.cursor = None
            self.focus = TerminalFocus.panel(first_panel_id())
            self.keyboard.last_action = None
        }
        self.session_id = Val(projection.session_id)
        self.source_id = projection.source_id
        self.build_id = projection.build_id
        self.world_id = projection.world_id
        self.revision = Val(projection.revision)
        self.observed_at = Val(projection.observed_at)
        self.status = Val(terminal_bounded_status(projection.status))
        previous_time_cursor: self.time_cursor
        previous_cursor: self.cursor
        loop event in projection.panels {
            sequence: event.sequence()
            if previous_cursor == .Val(cursor) {
                if sequence <= cursor -> next
            }
            if panel_ids.get(sequence) == .Val(panel_id) {
                self.append_event(TerminalHostEvent.from_devtools_event(event, projection.protocol, projection.session_id, projection.revision, panel_id))
            }
        }
        self.cursor = Val(projection.sequence)
        if previous_time_cursor == None {
            self.time_cursor = None
            if projection.sequence != 0 -> self.time_cursor = Val(projection.sequence)
        }
        self.apply_selection(projection.selection)
        self.render()
    }
    sync_session: fn(&self, session: ResidentDevSession) -> TerminalFrame TerminalHostError! {
        projection: session.devtools_events_since(self.cursor)
        grants: if self.config.capabilities.access.local_details_enabled() -> JetDevtoolsPanelCapability.ALL else -> [JetDevtoolsPanelCapability]{}
        panels: session.devtools_panels(.Terminal, grants) ?? return Err(TerminalHostError{message: "{err}"})
        panel_ids := [Int: JetDevtoolsPanelId]{}
        loop panel in panels {
            panel_id: panel.availability.descriptor.id
            loop event in panel.events {
                if panel_ids.get(event.sequence()) == None -> panel_ids[event.sequence()] = panel_id
            }
        }
        self.sync_projection(projection, panel_ids)
    }
    apply_selection: fn(&self, selection: DevtoolsSelectionFact?) {
        if selection == .Val(chosen) {
            if terminal_canonical_panel(chosen.panel_id) == .Val(panel_id) {
                if chosen.item_key == "" {
                    _: self.focus_panel(panel_id)
                } else {
                    _: self.focus_item(panel_id, chosen.item_key)
                }
                return
            }
        }
        self.focus = TerminalFocus.panel(first_panel_id())
    }
    set_viewport: fn(&self, viewport: TerminalViewport) { self.config.viewport = viewport }
    set_capabilities: fn(&self, capabilities: TerminalHostCapabilities) { self.config.capabilities = capabilities }
    set_cursor: fn(&self, cursor: Int?) {
        self.cursor = cursor
        self.time_cursor = cursor
    }
    focus_panel: fn(&self, panel_id: String) -> Bool {
        canonical: terminal_canonical_panel(panel_id) ?? return false
        self.focus = TerminalFocus.panel(canonical)
        self.keyboard.last_action = Val(TerminalAction.FocusPanel(panel_id: canonical))
        true
    }
    focus_item: fn(&self, panel_id: String, item_key: String) -> Bool {
        if !self.focus_panel(panel_id) -> return false
        self.focus.item_key = Val(item_key)
        self.keyboard.last_action = Val(TerminalAction.Inspect(panel_id: self.focus.panel_id ?? "", item_key: item_key))
        true
    }
    clear_item_focus: fn(&self) {
        self.focus.item_key = None
        self.keyboard.last_action = Val(TerminalAction.ReturnToPanel)
    }
    handle: fn(&self, input: TerminalInput) -> TerminalAction {
        if input == .Key(key) -> return self.handle_key(key)
        if input == .Resize(viewport) -> self.set_viewport(viewport)
        self.keyboard.last_action = Val(TerminalAction.Ignored)
        TerminalAction.Ignored
    }
    handle_key: fn(&self, key: TerminalKey) -> TerminalAction {
        self.keyboard.last_key = Val(key)
        action: if key == {
            .Tab | .Down -> self.move_panel(1)
            .BackTab | .Up -> self.move_panel(-1)
            .Enter | .Right -> self.inspect_focused()
            .Escape | .Left -> self.leave_item()
            .Character(text) -> self.handle_character(text)
        }
        self.keyboard.last_action = Val(action)
        action
    }
    leave_item: fn(&self) -> TerminalAction {
        if self.focus.item_key == None -> return TerminalAction.Ignored
        self.clear_item_focus()
        TerminalAction.ReturnToPanel
    }
    handle_character: fn(&self, text: String) -> TerminalAction {
        actions_enabled: self.config.capabilities.access.actions_enabled()
        if text == "r" && actions_enabled -> return TerminalAction.Rerun
        if text == "R" && actions_enabled -> return TerminalAction.Restart
        if text == "j" {
            _: self.focus_panel("jobs")
            return TerminalAction.FocusJob
        }
        if text == "q" -> return TerminalAction.Quit
        if text == "t" -> return self.move_cursor()
        TerminalAction.Ignored
    }
    render: fn(self) -> TerminalFrame {
        ordered: terminal_ordered_events(self.events)
        viewport: self.effective_viewport()
        tree: self.build_tree(ordered)
        freshness: terminal_overall_freshness(ordered, self.display_cursor())
        revision := ""
        if self.revision == .Val(current) {
            revision = current
        } else if ordered.len() > 0 {
            revision = ordered[ordered.len() - 1].revision
        }
        session_id: self.session_id ?? ""
        lines: terminal_render_lines(TerminalRenderInput{
            tree: tree, viewport: viewport, capabilities: self.config.capabilities, session_id: session_id, source_id: self.source_id,
            build_id: self.build_id, world_id: self.world_id, revision: revision, cursor: self.display_cursor(), observed_at: self.observed_at,
            status: self.status, focus: self.focus, keyboard: self.keyboard, event_count: ordered.len(), event_limit: self.config.max_events, freshness: freshness,
        })
        TerminalFrame{
            protocol: JET_DEVTOOLS_PROTOCOL, session_id: session_id, source_id: self.source_id, build_id: self.build_id, world_id: self.world_id,
            observed_at: self.observed_at, status: self.status, revision: revision, cursor: self.display_cursor(),
            viewport: viewport, capabilities: self.config.capabilities, focus: self.focus, keyboard: self.keyboard,
            freshness: freshness, event_count: ordered.len(), event_limit: self.config.max_events, tree: tree, lines: lines,
        }
    }
    move_panel: fn(&self, direction: Int) -> TerminalAction {
        panel_ids := [String]{}
        loop descriptor in descriptors() -> panel_ids.push(descriptor.id.as_str())
        if panel_ids.len() == 0 -> return TerminalAction.Ignored
        current := 0
        if self.focus.panel_id == .Val(focused) {
            loop (index, panel_id) in panel_ids.enumerate() {
                if panel_id == focused {
                    current = index
                    break
                }
            }
        }
        count: panel_ids.len()
        target: ((current + direction) % count + count) % count
        self.focus = TerminalFocus.panel(panel_ids[target])
        TerminalAction.FocusPanel(panel_id: panel_ids[target])
    }
    inspect_focused: fn(&self) -> TerminalAction {
        panel_id: self.focus.panel_id ?? first_panel_id()
        if self.focus.item_key == .Val(item_key) -> return TerminalAction.Inspect(panel_id: panel_id, item_key: item_key)
        ordered: terminal_ordered_events(self.events)
        index := ordered.len()
        loop index > 0 {
            index -= 1
            if ordered[index].panel_id.as_str() == panel_id {
                item_key: ordered[index].key()
                self.focus.item_key = Val(item_key)
                return TerminalAction.Inspect(panel_id: panel_id, item_key: item_key)
            }
        }
        TerminalAction.FocusPanel(panel_id: panel_id)
    }
    // Steps the time cursor to the next retained sequence, wrapping to the first.
    move_cursor: fn(&self) -> TerminalAction {
        sequences := [Int]{}
        loop event in terminal_ordered_events(self.events) {
            if sequences.len() == 0 || sequences[sequences.len() - 1] != event.sequence -> sequences.push(event.sequence)
        }
        if sequences.len() == 0 -> return TerminalAction.Ignored
        current: self.time_cursor ?? sequences[0]
        target := sequences[0]
        loop sequence in sequences {
            if sequence > current {
                target = sequence
                break
            }
        }
        self.time_cursor = Val(target)
        TerminalAction.MoveCursor(cursor: target)
    }
    effective_viewport: fn(self) -> TerminalViewport {
        configured: self.config.viewport
        width := configured.width
        capability_width: terminal_at_least_one(self.config.capabilities.width)
        if capability_width < width -> width = capability_width
        configured.resize(width, configured.height)
    }
    build_tree: fn(self, ordered: [TerminalHostEvent]) -> TerminalPanelTree {
        viewport: self.effective_viewport()
        root_bounds: viewport.bounds()
        children := [TerminalNode]{}
        availability: self.panel_availability()
        remaining := self.config.max_nodes - 1
        panel_height: 3
        cursor: self.display_cursor()
        index := 0
        loop descriptor in descriptors() {
            if remaining <= 0 -> break
            remaining -= 1
            panel_id: descriptor.id.as_str()
            panel_events := [TerminalHostEvent]{}
            loop event in ordered {
                if event.panel_id.as_str() == panel_id -> panel_events.push(event)
            }
            freshness: terminal_panel_freshness(panel_events, cursor)
            y: index * panel_height
            height: terminal_clamp(viewport.height - y, 0, panel_height)
            panel_bounds: TerminalBounds{x: 0, y: y, width: viewport.width, height: height}
            panel_children := [TerminalNode]{}
            if remaining > 0 {
                status := TerminalStatus{label: freshness.label(), detail: "{panel_events.len()} event(s), retained {ordered.len()}/{self.config.max_events}", freshness: freshness}
                loop row in availability {
                    if row.descriptor.id == descriptor.id && !row.is_available() {
                        status.label = "unavailable"
                        status.detail = terminal_unavailable_panel_detail(row.unavailable_reasons())
                    }
                }
                focused: self.focus.panel_id == .Val(panel_id)
                panel_children.push(TerminalNode.status_node("panel:{panel_id}:status", "freshness", status, TerminalBounds{x: 0, y: y, width: viewport.width, height: terminal_clamp(height, 0, 1)}, focused))
                remaining -= 1
            }
            if remaining > 0 {
                summary := "No recorded facts"
                if panel_events.len() > 0 -> summary = terminal_event_summary(panel_events[panel_events.len() - 1], self.config.capabilities)
                panel_children.push(TerminalNode.text_node("panel:{panel_id}:summary", "summary", summary, TerminalBounds{x: 0, y: y + 1, width: viewport.width, height: terminal_clamp(height - 1, 0, 1)}, freshness))
                remaining -= 1
            }
            if remaining > 0 {
                rows := [TerminalTableRow]{}
                loop event in panel_events {
                    cells := [String]{}
                    cells.push(event.revision)
                    cells.push("{event.sequence}")
                    cells.push("{event.observed_at}")
                    cells.push(event.kind)
                    cells.push(event.entity)
                    cells.push(event.source)
                    cells.push("{event.published_fact_count()}")
                    rows.push(TerminalTableRow{key: event.key(), cells: cells})
                }
                columns: "revision sequence observed_at kind entity source published_facts".split(" ").to_list()
                panel_children.push(TerminalNode.table_node("panel:{panel_id}:events", "events", TerminalTable{columns: columns, rows: rows}, TerminalBounds{x: 0, y: y + 2, width: viewport.width, height: terminal_clamp(height - 2, 0, height)}, freshness))
                remaining -= 1
            }
            children.push(TerminalNode.container("panel:{panel_id}", .Panel, descriptor.title, panel_bounds, freshness, panel_children))
            index += 1
        }
        root: TerminalNode.container("terminal-root", .Root, "jet devtools", root_bounds, terminal_overall_freshness(ordered, cursor), children)
        TerminalPanelTree{root: root, bounds: root_bounds, node_count: root.count(), node_limit: self.config.max_nodes, panel_count: root.children.len()}
    }
}
terminal_at_least_one: fn(value: Int) -> Int { if value < 1 -> 1 else -> value }
terminal_clamp: fn(value: Int, low: Int, high: Int) -> Int {
    if value < low -> return low
    if value > high -> return high
    value
}
// The catalog's spelling of `panel_id`, when it names a canonical panel.
terminal_canonical_panel: fn(panel_id: String) -> String? {
    loop descriptor in descriptors() {
        if descriptor.id.as_str() == panel_id -> return Val(descriptor.id.as_str())
    }
    None
}
terminal_validate_text: fn(value: String, label: String, allow_empty: Bool) TerminalHostError! {
    if (!allow_empty && value == "") || value.bytes().len() > MAX_TERMINAL_TEXT_BYTES || terminal_style_bounded_text(value, MAX_TERMINAL_TEXT_BYTES) != value {
        return Err(TerminalHostError{message: "terminal {label} is empty, too long, or contains control text"})
    }
}
terminal_validate_optional: fn(value: String?, label: String) TerminalHostError! {
    if value == .Val(text) -> terminal_validate_text(text, label, false)
}
terminal_validate_projection: fn(projection: DevtoolsProjection) TerminalHostError! {
    if projection.protocol != JET_DEVTOOLS_PROTOCOL -> return Err(TerminalHostError{message: "devtools projection protocol must be {JET_DEVTOOLS_PROTOCOL}"})
    terminal_validate_text(projection.session_id, "session id", false)
    terminal_validate_text(projection.revision, "revision", true)
    terminal_validate_optional(projection.source_id, "source id")
    terminal_validate_optional(projection.build_id, "build id")
    terminal_validate_optional(projection.world_id, "world id")
    terminal_validate_status(projection.status)
    loop event in projection.panels {
        if event.sequence() <= 0 -> return Err(TerminalHostError{message: "devtools event sequence must be positive"})
        if event.sequence() > projection.sequence -> return Err(TerminalHostError{message: "devtools event sequence exceeds the projection cursor"})
        terminal_validate_text(event.source(), "event source", false)
        terminal_validate_text(event.kind(), "event kind", false)
        terminal_validate_text(event.entity(), "event entity", false)
        terminal_validate_text(event.fields_json(), "event fields", false)
        if event.payload_json() == .Val(payload) -> terminal_validate_text(payload, "event payload", false)
    }
    if projection.selection == .Val(selection) {
        if terminal_canonical_panel(selection.panel_id) == None -> return Err(TerminalHostError{message: "devtools selection panel `{selection.panel_id}` is not canonical"})
        terminal_validate_text(selection.item_key, "selection item", true)
    }
}
// Present status texts must not be empty.
terminal_validate_status: fn(status: DevtoolsStatusFact) TerminalHostError! {
    terminal_require_text(status.diagnostic_code, "diagnostic code")
    terminal_require_text(status.diagnostic, "diagnostic")
    terminal_require_text(status.accepted_revision, "accepted revision")
    terminal_require_text(status.last_good_revision, "last good revision")
    terminal_require_text(status.run_target, "run target")
    terminal_require_text(status.run_output, "run output")
    terminal_require_text(status.test_state, "test state")
}
terminal_require_text: fn(value: String?, label: String) TerminalHostError! {
    text: value ?? return
    if text == "" -> return Err(TerminalHostError{message: "terminal {label} is empty"})
}
terminal_bounded_status: fn(status: DevtoolsStatusFact) -> DevtoolsStatusFact TerminalHostError! {
    terminal_validate_status(status)
    bounded := status
    bounded.diagnostic_code = terminal_bounded_optional(status.diagnostic_code)
    bounded.diagnostic = terminal_bounded_optional(status.diagnostic)
    bounded.accepted_revision = terminal_bounded_optional(status.accepted_revision)
    bounded.last_good_revision = terminal_bounded_optional(status.last_good_revision)
    bounded.run_target = terminal_bounded_optional(status.run_target)
    bounded.run_output = terminal_bounded_optional(status.run_output)
    bounded.test_state = terminal_bounded_optional(status.test_state)
    bounded
}
terminal_bounded_optional: fn(value: String?) -> String? {
    text: value ?? return None
    Val(terminal_bounded_text(text, MAX_TERMINAL_TEXT_BYTES))
}
// Newlines, carriage returns and tabs become escapes, other control characters `?`;
// the result is cut at a character boundary to `limit` bytes.
terminal_bounded_text: fn(value: String, limit: Int) -> String {
    if limit <= 0 -> return ""
    bytes: value.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        lead: bytes[index]
        width: terminal_style_char_len(lead)
        end: if index + width > bytes.len() -> bytes.len() else -> index + width
        replacement: if lead == 10 -> "\\n" else if lead == 13 -> "\\r" else if lead == 9 -> "\\t" else if lead < 32 || lead == 127 -> "?" else if lead == 194 && end > index + 1 && bytes[index + 1] < 160 -> "?" else -> ""
        if replacement == "" {
            if out.len() + (end - index) > limit -> break
            loop position in index..<end -> out.push(bytes[position])
        } else {
            if out.len() + replacement.bytes().len() > limit -> break
            out.extend(replacement.bytes())
        }
        index = end
    }
    String.from_bytes(out) ?? ""
}
terminal_display_optional: fn(value: String) -> String { if value == "" -> "-" else -> value }
terminal_yes_no: fn(value: Bool) -> String { if value -> "yes" else -> "no" }
terminal_access_label: fn(access: TerminalHostAccess) -> String {
    if access.read_only -> return "read-only"
    if access.release -> return "release"
    if access.local -> return "local"
    "remote"
}
terminal_session_state_label: fn(state: JetDevtoolsLifecycleState) -> String {
    if state == {
        .Starting -> "starting"
        .Building -> "building"
        .Ready -> "ready"
        .Error -> "error"
        .Unavailable -> "unavailable"
        .Stopped -> "stopped"
    }
}
terminal_status_field: fn(key: String, value: String?, reveal: Bool) -> String {
    text: value ?? return "{key}=-"
    if !reveal -> return "{key}=<redacted>"
    "{key}={text}"
}
terminal_status_summary: fn(status: DevtoolsStatusFact, reveal: Bool) -> String {
    fields := [String]{}
    fields.push("state={terminal_session_state_label(status.state)}")
    fields.push(terminal_status_field("diagnostic_code", status.diagnostic_code, reveal))
    fields.push(terminal_status_field("diagnostic", status.diagnostic, reveal))
    fields.push(terminal_status_field("accepted_revision", status.accepted_revision, reveal))
    fields.push(terminal_status_field("last_good_revision", status.last_good_revision, reveal))
    fields.push(terminal_status_field("run_target", status.run_target, reveal))
    fields.push(terminal_status_field("run_output", status.run_output, reveal))
    fields.push(terminal_status_field("test_state", status.test_state, reveal))
    fields.join(" ")
}
terminal_unavailable_panel_detail: fn(reasons: [JetDevtoolsPanelUnavailableReason]) -> String {
    details := [String]{}
    loop reason in reasons {
        if reason == {
            .UnsupportedHost(host) -> details.push("unsupported host {host.as_str()}")
            .MissingCapability(capability) -> details.push("missing {capability.grant()}")
        }
    }
    if details.len() == 0 -> return "unavailable"
    details.join(", ")
}
// Events by sequence, then observation time, revision, kind, entity and source.
terminal_ordered_events: fn(events: [TerminalHostEvent]) -> [TerminalHostEvent] {
    ordered := events
    ordered.sort_by((left, right) -> (left.sequence <=> right.sequence).then(left.observed_at <=> right.observed_at)
        .then(left.revision <=> right.revision).then(left.kind <=> right.kind).then(left.entity <=> right.entity).then(left.source <=> right.source))
    ordered
}
terminal_event_summary: fn(event: TerminalHostEvent, capabilities: TerminalHostCapabilities) -> String {
    values := "<redacted>"
    if capabilities.access.local_details_enabled() {
        published := [String]{}
        loop fact in event.facts {
            if fact.published -> published.push(fact.display())
        }
        values = if published.len() == 0 -> "-" else -> published.join(",")
    }
    verbose: if capabilities.verbose -> " details=on" else -> ""
    revision: terminal_display_optional(event.revision)
    "{event.kind} · {event.entity} · {revision} · {event.observed_at}ms · source={event.source} · published_facts={event.published_fact_count()} · values={values}{verbose}"
}
terminal_panel_freshness: fn(events: [TerminalHostEvent], cursor: Int?) -> TerminalFreshness {
    if events.len() == 0 -> return TerminalFreshness.Empty
    latest := events[0].sequence
    loop event in events {
        if event.sequence > latest -> latest = event.sequence
    }
    if cursor == .Val(position) {
        if position < latest -> return TerminalFreshness.Stale
    }
    TerminalFreshness.Fresh
}
terminal_overall_freshness: fn(events: [TerminalHostEvent], cursor: Int?) -> TerminalFreshness { terminal_panel_freshness(events, cursor) }

TerminalRenderInput: struct {
    tree: TerminalPanelTree
    viewport: TerminalViewport
    capabilities: TerminalHostCapabilities
    session_id: String
    source_id: String?
    build_id: String?
    world_id: String?
    revision: String
    cursor: Int?
    observed_at: Int?
    status: DevtoolsStatusFact?
    focus: TerminalFocus
    keyboard: TerminalKeyboardState
    event_count: Int
    event_limit: Int
    freshness: TerminalFreshness
}
terminal_optional_number: fn(value: Int?) -> String {
    number: value ?? return "-"
    "{number}"
}
terminal_render_lines: fn(input: TerminalRenderInput) -> [String] {
    capabilities: input.capabilities
    if capabilities.quiet -> return [String]{}
    raw := [String]{}
    state := "-"
    if input.status == .Val(status) -> state = terminal_session_state_label(status.state)
    raw.push("jet devtools  session={terminal_display_optional(input.session_id)}  source_id={terminal_display_optional(input.source_id ?? "")}  build_id={terminal_display_optional(input.build_id ?? "")}  world_id={terminal_display_optional(input.world_id ?? "")}  revision={terminal_display_optional(input.revision)}  sequence={terminal_optional_number(input.cursor)}  observed_at={terminal_optional_number(input.observed_at)}  state={state}  freshness={input.freshness.label()}")
    access: capabilities.access
    raw.push("terminal={input.viewport.width}x{input.viewport.height}  tty={terminal_yes_no(capabilities.tty)}  ansi={terminal_yes_no(capabilities.ansi)}  no_color={terminal_yes_no(capabilities.no_color)}  verbose={terminal_yes_no(capabilities.verbose)}  quiet={terminal_yes_no(capabilities.quiet)}  access={terminal_access_label(access)}  local={terminal_yes_no(access.local)}  release={terminal_yes_no(access.release)}  read_only={terminal_yes_no(access.read_only)}  nodes={input.tree.node_count}/{input.tree.node_limit}  events={input.event_count}/{input.event_limit}  focus={input.focus.panel_id ?? "-"}")
    if input.status == .Val(status) -> raw.push("status: {terminal_status_summary(status, access.local_details_enabled())}")
    loop panel in input.tree.root.children {
        selected: input.focus.panel_id != None && "panel:{input.focus.panel_id ?? ""}" == panel.id
        marker: if selected -> ">" else -> " "
        panel_label: if selected -> terminal_style_text("{marker}[{panel.label}]", "36", capabilities) else -> "{marker}[{panel.label}]"
        raw.push("{panel_label} {panel.freshness.label()}")
        loop child in panel.children {
            if child.status == .Val(child_status) -> raw.push("  status={terminal_style_text(child_status.label, "33", capabilities)}  {child_status.detail}")
            if child.kind == .Text -> raw.push("  {child.text ?? ""}")
            if child.table == .Val(table) {
                loop row in table.rows -> raw.push("  {row.cells.join(" | ")}")
            }
        }
    }
    action_help: if access.actions_enabled() -> "r rerun  R restart" else -> "r/R disabled(read-only)"
    last := "none"
    if input.keyboard.last_action == .Val(action) -> last = action.label()
    raw.push("keys: Tab/Down next panel  Shift-Tab/Up previous  Enter inspect  Esc back  {action_help}  j jobs  t time  q quit  last={last}")
    skip: terminal_clamp(input.viewport.scroll, 0, raw.len())
    end: terminal_clamp(skip + input.viewport.height, skip, raw.len())
    loop index in skip..<end -> terminal_truncate_columns(raw[index], input.viewport.width)
}
// ESC, the byte that opens an ANSI control sequence.
TERMINAL_ESC: U8{27}
terminal_style_text: fn(text: String, code: String, capabilities: TerminalHostCapabilities) -> String {
    if !capabilities.color_enabled() -> return text
    out := [U8]{}
    out.push(TERMINAL_ESC)
    out.extend("[{code}m{text}".bytes())
    out.push(TERMINAL_ESC)
    out.extend("[0m".bytes())
    String.from_bytes(out) ?? text
}
// The end of the CSI sequence opened at `start` (ESC `[` ... final byte `@`..`~`).
terminal_csi_end: fn(bytes: [U8], start: Int) -> Int {
    index := start + 2
    loop index < bytes.len() {
        byte: bytes[index]
        index += 1
        if byte >= 64 && byte <= 126 -> break
    }
    index
}
// `text` without CSI sequences; an ESC not followed by `[` drops with its next byte.
terminal_strip_ansi: fn(text: String) -> String {
    bytes: text.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        if bytes[index] == TERMINAL_ESC {
            if index + 1 < bytes.len() && bytes[index + 1] == 91 {
                index = terminal_csi_end(bytes, index)
            } else {
                index += 2
            }
            next
        }
        out.push(bytes[index])
        index += 1
    }
    String.from_bytes(out) ?? ""
}
// At most `width` visible characters; CSI sequences pass through, and a clipped styled line ends with a reset.
terminal_truncate_columns: fn(text: String, width: Int) -> String {
    limit: terminal_at_least_one(width)
    bytes: text.bytes()
    out := [U8]{}
    visible := 0
    clipped := false
    has_ansi := false
    loop byte in bytes {
        if byte == TERMINAL_ESC -> has_ansi = true
    }
    index := 0
    loop index < bytes.len() {
        if bytes[index] == TERMINAL_ESC && index + 1 < bytes.len() && bytes[index + 1] == 91 {
            end: terminal_csi_end(bytes, index)
            loop position in index..<end -> out.push(bytes[position])
            index = end
            next
        }
        if visible >= limit {
            clipped = true
            break
        }
        end: terminal_clamp(index + terminal_style_char_len(bytes[index]), index + 1, bytes.len())
        loop position in index..<end -> out.push(bytes[position])
        visible += 1
        index = end
    }
    if clipped && has_ansi {
        out.push(TERMINAL_ESC)
        out.extend("[0m".bytes())
    }
    String.from_bytes(out) ?? ""
}
