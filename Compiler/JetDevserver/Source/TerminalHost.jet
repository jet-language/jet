    // Rust: crates/jet-devserver/src/TerminalHost.rs:184
    pub fn new(x: USize, y: USize, width: USize, height: USize) -> TerminalBounds { TerminalBounds{x, y, width, height} }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:193
    pub fn right(self) -> USize { self.x.saturating_add(self.width) }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:197
    pub fn bottom(self) -> USize { self.y.saturating_add(self.height) }
    // Rust: crates/jet-devserver/src/TerminalHost.rs:201
    pub fn contains(self, x: USize, y: USize) -> Bool { x >= self.x && y >= self.y && x < self.right() && y < self.bottom() }
}
