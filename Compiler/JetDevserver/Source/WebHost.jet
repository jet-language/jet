    fn command_receipt(self: &Self) -> String? { return self.command_receipt.lock().unwrap().clone() }
    // Rust: crates/jet-devserver/src/WebHost.rs:1646
    fn activate_browser_trace(self: &Self, manifest: String) -> Unit Err! {
        relay :: BrowserTrace.Relay.new(manifest)?
