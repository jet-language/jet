            self.reconnecting.store(false, .SeqCst)
            self.refresh()
        }
    }
    // Rust: crates/jet-devserver/src/WebHost.rs:1638
    fn record_command_receipt(self: &Self, receipt: String) -> Unit { *self.command_receipt.lock().unwrap() = .Val(^receipt) }
