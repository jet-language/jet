//RS 
//RS /// Revision identity shared by `/__jet_dev_status` and `jet dev --json`.
//RS /// `accepted` is the revision `/__jet_dev_version` serves (the web host only
//RS /// publishes accepted builds, so it is also the last-good revision);
//RS /// `candidate` is the revision an in-flight or rejected build would publish;
//RS /// `diagnostic` is that candidate while its diagnostic is pending.
//RS #[derive(Clone, Copy, Debug, PartialEq, Eq)]
//RS pub struct DevRevisionFacts {
//RS     pub accepted: Option<u64>,
//RS     pub candidate: Option<u64>,
//RS     pub diagnostic: Option<u64>,
//RS }
//RS 
//RS /// D-FE-DEVSRV1 outcome D (hybrid, owner-modified 2026-07-08: pinned parity
//RS /// header required as the terminal anchor): a one-line terminal status and a
//RS /// browser corner strip mirror the exact same words from one shared status
//RS /// (`header_words`/`json`'s `message` field) — they cannot drift because both
//RS /// read the same source. On error both sides show the identical verbatim
//RS /// diagnostic (I4): terminal frames it in a box (TTY) or prints it plain (CI
//RS /// floor); the browser expands its strip into a full overlay. `--verbose`
//RS /// (or `-v`) adds a request/rebuild log under the still-pinned header.
//RS #[derive(Clone)]
//RS struct DevStatusSnapshot {
//RS     state: String,
//RS     code: String,
//RS     diagnostic: String,
//RS     last_build_ms: u128,
//RS     /// Revision the in-flight or last rejected build would publish; `None`
//RS     /// once that build is accepted.
//RS     candidate: Option<u64>,
//RS }
//RS 
//RS struct DevStatus {
//RS     version: AtomicU64,
//RS     clients: Mutex<HashMap<String, Instant>>,
//RS     state: Mutex<DevStatusSnapshot>,
