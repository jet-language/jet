        clients.retain((_, seen) -> now.saturating_duration_since(*seen) <= cutoff)
        changed :: clients.len() != before
        disconnected :: before > 0 && clients.is_empty()
        drop(^clients)
        if disconnected -> self.reconnecting.store(true, .SeqCst)
