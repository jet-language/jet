        }
    }
    // Rust: crates/jet-devserver/src/NativeOverlayAdapter.rs:321
    pub fn panel_catalog(self: &Self) -> &[JetDevtoolsPanelDescriptor] { return descriptors() }
    // Rust: crates/jet-devserver/src/NativeOverlayAdapter.rs:327
    pub fn panel_availability(self: &Self) -> [JetDevtoolsPanelAvailability] {
