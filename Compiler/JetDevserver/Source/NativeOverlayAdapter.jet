// Typed resident-session/native-overlay bridge. Keeps canonical event identity and body
// intact. Never parses devtools_json, selects panel policy or executes actions.
use jet_foundation.[JetDevtoolsEvent]

NATIVE_OVERLAY_EVENT_LOG_PANEL_ID: String{"event-log"}
NATIVE_OVERLAY_EVENT_LOG_TITLE: String{"Event Log"}
NATIVE_OVERLAY_EVENT_LOG_STATUS: String{"canonical events"}
MAX_NATIVE_OVERLAY_EVENTS: Int{256}
EVENT_LOG_NODES_PER_EVENT: Int{7}

NativeOverlayCursor: struct { sequence: Int }

NativeOverlayIdentity: struct {
    protocol: String
    session_id: String
    revision: String
    cursor: NativeOverlayCursor?
}

impl NativeOverlayUnavailableReason {
    as_str: fn(self) -> String {
        if self == {
            .EmptyStream -> "empty-stream"
            .Reset -> "reset"
            .Truncated -> "truncated"
            .EventLimit -> "event-limit"
            .NodeLimit -> "node-limit"
            .SelectionPanelUnavailable -> "selection-panel-unavailable"
            .NoCursor -> "no-cursor"
        }
    }
}

NativeOverlayUnavailableFact: struct { subject: String, reason: NativeOverlayUnavailableReason }

NativeOverlayActionRequest: struct {
    protocol: String
    session_id: String
    revision: String
    sequence: Int
    panel_id: String
    node_id: String
    action_id: String
    required_grant: NativeOverlayGrant
}
impl NativeOverlayActionRequest {
    cursor: fn(self) -> NativeOverlayCursor { NativeOverlayCursor{sequence: self.sequence} }
}

NativeOverlaySelectionRequest: struct {
    protocol: String
    session_id: String
    revision: String
    sequence: Int
    panel_id: String
    item_key: String
}
impl NativeOverlaySelectionRequest {
    cursor: fn(self) -> NativeOverlayCursor { NativeOverlayCursor{sequence: self.sequence} }
}

// Event is absent only for an empty canonical cursor; never synthesize a sequence.
NativeOverlayUpdate: struct {
    identity: NativeOverlayIdentity
    event: NativeOverlayEvent?
    reset: Bool
    truncation: Bool
    selection: NativeOverlaySelectionRequest?
    unavailable: [NativeOverlayUnavailableFact]
}

#Error
NativeOverlayAdapterError: enum {
    InvalidProtocol(expected: String, received: String)
    SessionMismatch(expected: String, received: String)
    InvalidRevision
    InvalidSequence(sequence: Int)
    StaleRevision(expected: String, received: String)
    StaleSequence(expected: Int, received: Int)
    InvalidText(field: String)
    DuplicatePanel(panel_id: String)
    ReservedPanel(panel_id: String)
    InvalidPanel(message: String)
    InvalidNode(message: String)
    HostRejected(message: String)
    MissingProjection
    UnknownPanel(panel_id: String)
    UnknownNode(node_id: String)
    ActionUnavailable(node_id: String)
    ActionMismatch(action_id: String)

    message: fn(self) -> String {
        if self == {
            .InvalidProtocol(expected, received) -> "native overlay protocol `{received}` does not match `{expected}`"
            .SessionMismatch(expected, received) -> "native overlay session `{received}` does not match `{expected}`"
            .InvalidRevision -> "native overlay revision is empty, too long, or contains control text"
            .InvalidSequence(sequence) -> "native overlay sequence {sequence} is invalid"
            .StaleRevision(expected, received) -> "native overlay revision `{received}` is stale; current revision is `{expected}`"
            .StaleSequence(expected, received) -> "native overlay sequence {received} is stale; current sequence is {expected}"
            .InvalidText(field) -> "native overlay {field} is empty, too long, or contains control text"
            .DuplicatePanel(panel_id) -> "native overlay panel `{panel_id}` is duplicated"
            .ReservedPanel(panel_id) -> "native overlay panel `{panel_id}` is reserved for the event log"
            .InvalidPanel(message) | .InvalidNode(message) | .HostRejected(message) -> message
            .MissingProjection -> "native overlay has no current projection"
            .UnknownPanel(panel_id) -> "native overlay panel `{panel_id}` is unavailable"
            .UnknownNode(node_id) -> "native overlay node `{node_id}` is unavailable"
            .ActionUnavailable(node_id) -> "native overlay node `{node_id}` has no action"
            .ActionMismatch(action_id) -> "native overlay action `{action_id}` is stale or no longer matches the node"
        }
    }
}
impl NativeOverlayAdapterError.Display { display: fn(&&self) -> String { self.message() } }

// The current request context: the revision and cursor a request must name.
NativeOverlayContext: struct { revision: String, sequence: Int }
NativeOverlayRenderedPanels: struct { panels: [NativeOverlayPanelFact], dropped_for_nodes: Bool }

NativeOverlayAdapter: struct {
    session_id: String
    revision: String?
    sequence: Int?
    release_build: Bool
    // Oldest first; bounded by MAX_NATIVE_OVERLAY_EVENTS.
    event_facts: [JetDevtoolsEvent]
    typed_panels: [String: NativeOverlayPanelFact]
    history_truncated: Bool
    last_update: NativeOverlayUpdate?
}
impl NativeOverlayAdapter {
    new: fn(session_id: String) -> NativeOverlayAdapter {
        NativeOverlayAdapter{session_id: session_id, revision: None, sequence: None, release_build: false,
            event_facts: [JetDevtoolsEvent]{}, typed_panels: [String: NativeOverlayPanelFact]{}, history_truncated: false, last_update: None}
    }
    from_projection: fn(projection: DevtoolsProjection, typed_panels: [NativeOverlayPanelFact]) -> NativeOverlayUpdate NativeOverlayAdapterError! {
        adapter := NativeOverlayAdapter.new(projection.session_id)
        adapter.apply_projection_with_panels(projection, typed_panels)
    }
    for_session: fn(session: ResidentDevSession) -> NativeOverlayAdapter { NativeOverlayAdapter.new(session.id()) }
    set_release_build: fn(&self, release_build: Bool) {
        self.release_build = release_build
        if release_build {
            self.revision = None
            self.sequence = None
            self.event_facts = [JetDevtoolsEvent]{}
            self.typed_panels = [String: NativeOverlayPanelFact]{}
            self.history_truncated = false
            self.last_update = None
        }
    }
    panel_catalog: fn(self) -> [JetDevtoolsPanelDescriptor] { descriptors() }
    available_panels: fn(self) -> [JetDevtoolsPanelAvailability] {
        grants: if self.release_build -> [JetDevtoolsPanelCapability]{} else -> JetDevtoolsPanelCapability.ALL
        panel_availability(.NativeOverlay, grants)
    }
    cursor: fn(self) -> NativeOverlayCursor? {
        if self.sequence == .Val(sequence) -> return Val(NativeOverlayCursor{sequence: sequence})
        None
    }
    // Retain already-typed nodes/actions without deriving semantics from names.
    set_typed_panels: fn(&self, panels: [NativeOverlayPanelFact]) NativeOverlayAdapterError! {
        if self.release_build -> return Err(NativeOverlayAdapterError.HostRejected(message: "native overlay is excluded from release builds"))
        self.typed_panels = typed_panel_map(panels)
    }
    apply_projection: fn(&self, projection: DevtoolsProjection) -> NativeOverlayUpdate NativeOverlayAdapterError! {
        self.apply_projection_internal(projection, false)
    }
    apply_projection_with_panels: fn(&self, projection: DevtoolsProjection, panels: [NativeOverlayPanelFact]) -> NativeOverlayUpdate NativeOverlayAdapterError! {
        self.set_typed_panels(panels)
        self.apply_projection_internal(projection, true)
    }
    apply_projection_internal: fn(&self, projection: DevtoolsProjection, retain_typed_panels: Bool) -> NativeOverlayUpdate NativeOverlayAdapterError! {
        if self.release_build -> return Err(NativeOverlayAdapterError.HostRejected(message: "native overlay is excluded from release builds"))
        validate_projection_identity(projection, self.session_id)
        validate_revision(projection.revision, projection.sequence == 0)
        self.check_projection_order(projection)
        revision_changed: self.revision != Val(projection.revision)
        effective_reset: projection.reset || revision_changed
        if effective_reset {
            self.event_facts = [JetDevtoolsEvent]{}
            self.history_truncated = false
            if !retain_typed_panels -> self.typed_panels = [String: NativeOverlayPanelFact]{}
        }
        events := projection.panels
        events.sort_by((left, right) -> (left.sequence() <=> right.sequence()).then(left.timestamp_ms <=> right.timestamp_ms).then(left.source() <=> right.source()).then(left.kind() <=> right.kind()).then(left.entity() <=> right.entity()))
        previous_sequence := Int?{None}
        loop event in events {
            validate_event(event, projection)
            if previous_sequence == Val(event.sequence()) -> return Err(NativeOverlayAdapterError.InvalidSequence(sequence: event.sequence()))
            if !projection.reset && !revision_changed {
                if self.sequence == .Val(current_sequence) {
                    if event.sequence() <= current_sequence -> return Err(NativeOverlayAdapterError.StaleSequence(expected: current_sequence, received: event.sequence()))
                }
            }
            previous_sequence = Val(event.sequence())
        }
        loop event in events -> self.event_facts.push(event)
        if self.event_facts.len() > MAX_NATIVE_OVERLAY_EVENTS {
            first: self.event_facts.len() - MAX_NATIVE_OVERLAY_EVENTS
            self.event_facts = loop index in first..<self.event_facts.len() -> self.event_facts[index]
            self.history_truncated = true
        }
        self.revision = Val(projection.revision)
        self.sequence = if projection.sequence != 0 -> Val(projection.sequence) else -> None
        unavailable := [NativeOverlayUnavailableFact]{}
        if effective_reset -> unavailable.push(make_unavailable("session", .Reset))
        if projection.truncation -> unavailable.push(make_unavailable("session", .Truncated))
        if self.history_truncated -> unavailable.push(make_unavailable(NATIVE_OVERLAY_EVENT_LOG_PANEL_ID, .EventLimit))
        event := NativeOverlayEvent?{None}
        if self.sequence == .Val(sequence) {
            rendered: self.render_panels(sequence)
            if rendered.dropped_for_nodes -> unavailable.push(make_unavailable(NATIVE_OVERLAY_EVENT_LOG_PANEL_ID, .NodeLimit))
            current: NativeOverlayEvent.new(JET_DEVTOOLS_PROTOCOL, self.session_id, projection.revision, sequence, projection.observed_at, rendered.panels)
            _: current.validate() ?? return Err(NativeOverlayAdapterError.HostRejected(message: err.message))
            event = Val(current)
        } else {
            unavailable.push(make_unavailable("session", .EmptyStream))
        }
        selection := NativeOverlaySelectionRequest?{None}
        if projection.selection == .Val(selected) {
            if self.sequence == .Val(sequence) {
                if self.typed_panels.get(selected.panel_id) == None && selected.panel_id != NATIVE_OVERLAY_EVENT_LOG_PANEL_ID {
                    unavailable.push(make_unavailable(selected.panel_id, .SelectionPanelUnavailable))
                }
                selection = Val(NativeOverlaySelectionRequest{protocol: JET_DEVTOOLS_PROTOCOL, session_id: self.session_id, revision: projection.revision, sequence: sequence, panel_id: selected.panel_id, item_key: selected.item_key})
            } else {
                unavailable.push(make_unavailable(selected.panel_id, .NoCursor))
            }
        }
        identity: NativeOverlayIdentity{protocol: JET_DEVTOOLS_PROTOCOL, session_id: self.session_id, revision: projection.revision, cursor: self.cursor()}
        update: NativeOverlayUpdate{identity: identity, event: event, reset: effective_reset, truncation: projection.truncation, selection: selection, unavailable: unavailable}
        self.last_update = Val(update)
        update
    }
    sync_session: fn(&self, session: ResidentDevSession) -> NativeOverlayUpdate NativeOverlayAdapterError! {
        if session.id() != self.session_id -> return Err(NativeOverlayAdapterError.SessionMismatch(expected: self.session_id, received: session.id()))
        self.apply_projection(session.devtools_events_since(self.sequence))
    }
    action_request: fn(self, panel_id: String, node_id: String) -> NativeOverlayActionRequest NativeOverlayAdapterError! {
        context: self.current_context()
        node: self.find_node(panel_id, node_id)
        action: node.action ?? return Err(NativeOverlayAdapterError.ActionUnavailable(node_id: node_id))
        NativeOverlayActionRequest{protocol: JET_DEVTOOLS_PROTOCOL, session_id: self.session_id, revision: context.revision, sequence: context.sequence,
            panel_id: panel_id, node_id: node_id, action_id: action.action_id, required_grant: action.required_grant}
    }
    validate_action_request: fn(self, request: NativeOverlayActionRequest) NativeOverlayAdapterError! {
        self.validate_request_identity(request.protocol, request.session_id, request.revision, request.sequence)
        node: self.find_node(request.panel_id, request.node_id)
        action: node.action ?? return Err(NativeOverlayAdapterError.ActionUnavailable(node_id: request.node_id))
        if action.action_id != request.action_id || action.required_grant != request.required_grant -> return Err(NativeOverlayAdapterError.ActionMismatch(action_id: request.action_id))
    }
    selection_request: fn(self, panel_id: String, item_key: String) -> NativeOverlaySelectionRequest NativeOverlayAdapterError! {
        validate_text(panel_id, "selection panel id", false)
        validate_text(item_key, "selection item key", true)
        context: self.current_context()
        NativeOverlaySelectionRequest{protocol: JET_DEVTOOLS_PROTOCOL, session_id: self.session_id, revision: context.revision, sequence: context.sequence, panel_id: panel_id, item_key: item_key}
    }
    current_context: fn(self) -> NativeOverlayContext NativeOverlayAdapterError! {
        revision: self.revision ?? return Err(NativeOverlayAdapterError.MissingProjection)
        sequence: self.sequence ?? return Err(NativeOverlayAdapterError.MissingProjection)
        NativeOverlayContext{revision: revision, sequence: sequence}
    }
    validate_request_identity: fn(self, protocol: String, session_id: String, revision: String, sequence: Int) NativeOverlayAdapterError! {
        if protocol != JET_DEVTOOLS_PROTOCOL -> return Err(NativeOverlayAdapterError.InvalidProtocol(expected: JET_DEVTOOLS_PROTOCOL, received: protocol))
        if session_id != self.session_id -> return Err(NativeOverlayAdapterError.SessionMismatch(expected: self.session_id, received: session_id))
        context: self.current_context()
        if revision != context.revision -> return Err(NativeOverlayAdapterError.StaleRevision(expected: context.revision, received: revision))
        if sequence != context.sequence -> return Err(NativeOverlayAdapterError.StaleSequence(expected: context.sequence, received: sequence))
    }
    check_projection_order: fn(self, projection: DevtoolsProjection) NativeOverlayAdapterError! {
        current_sequence: self.sequence ?? return Ok(())
        if self.revision == .Val(current_revision) {
            if projection.revision != current_revision && projection.sequence <= current_sequence -> return Err(NativeOverlayAdapterError.StaleRevision(expected: current_revision, received: projection.revision))
        }
        if projection.sequence < current_sequence -> return Err(NativeOverlayAdapterError.StaleSequence(expected: current_sequence, received: projection.sequence))
        if projection.sequence == current_sequence && self.revision == Val(projection.revision) && projection.panels.len() > 0 && !projection.reset {
            return Err(NativeOverlayAdapterError.StaleSequence(expected: current_sequence, received: projection.sequence))
        }
    }
    find_node: fn(self, panel_id: String, node_id: String) -> NativeOverlayNode NativeOverlayAdapterError! {
        panel: self.typed_panels.get(panel_id) ?? return Err(NativeOverlayAdapterError.UnknownPanel(panel_id: panel_id))
        find_overlay_node(panel.nodes, node_id) ?? Err(NativeOverlayAdapterError.UnknownNode(node_id: node_id))
    }
    render_panels: fn(self, sequence: Int) -> NativeOverlayRenderedPanels NativeOverlayAdapterError! {
        typed_node_count := 0
        panels := [NativeOverlayPanelFact]{}
        keys := self.typed_panels.keys().to_list()
        keys.sort()
        loop key in keys {
            panel: self.typed_panels[key]
            typed_node_count += panel_node_count(panel)
            panels.push(panel)
        }
        dropped_for_nodes := false
        if self.event_facts.len() > 0 {
            available: if typed_node_count >= MAX_OVERLAY_NODES -> 0 else -> MAX_OVERLAY_NODES - typed_node_count
            max_events: available / EVENT_LOG_NODES_PER_EVENT
            skip: if self.event_facts.len() > max_events -> self.event_facts.len() - max_events else -> 0
            if skip != 0 -> dropped_for_nodes = true
            facts: loop index in skip..<self.event_facts.len() -> self.event_facts[index]
            if facts.len() > 0 -> panels.push(event_log_panel(facts, sequence))
        }
        if panels.len() > MAX_OVERLAY_PANELS -> return Err(NativeOverlayAdapterError.InvalidPanel(message: "native overlay projection exceeds its panel budget"))
        NativeOverlayRenderedPanels{panels: panels, dropped_for_nodes: dropped_for_nodes}
    }
}

node_from_event: fn(event: JetDevtoolsEvent) -> NativeOverlayNode NativeOverlayAdapterError! {
    if event.sequence() == 0 -> return Err(NativeOverlayAdapterError.InvalidSequence(sequence: event.sequence()))
    validate_event_text(event)
    children := [NativeOverlayNode]{}
    children.push(NativeOverlayNode.text("source", "source").with_value(event.source()))
    children.push(NativeOverlayNode.text("kind", "kind").with_value(event.kind()))
    children.push(NativeOverlayNode.text("entity", "entity").with_value(event.entity()))
    children.push(NativeOverlayNode.text("observed_at", "observed_at").with_value("{event.timestamp_ms}"))
    children.push(NativeOverlayNode.text("fields", "fields").with_value(event.fields_json()))
    if event.payload_json() == .Val(payload) -> children.push(NativeOverlayNode.text("payload", "payload").with_value(payload))
    NativeOverlayNode.new("event-{event.sequence()}", .Status, "event").with_value(event.entity()).with_status(event.kind()).with_children(children)
}
event_log_panel: fn(events: [JetDevtoolsEvent], sequence: Int) -> NativeOverlayPanelFact NativeOverlayAdapterError! {
    if sequence == 0 -> return Err(NativeOverlayAdapterError.InvalidSequence(sequence: sequence))
    if events.len() > MAX_NATIVE_OVERLAY_EVENTS || events.len() > MAX_OVERLAY_NODES / EVENT_LOG_NODES_PER_EVENT {
        return Err(NativeOverlayAdapterError.InvalidPanel(message: "native overlay event log exceeds its event or node budget"))
    }
    nodes := [NativeOverlayNode]{}
    loop event in events -> nodes.push(node_from_event(event))
    NativeOverlayPanelFact.new(NATIVE_OVERLAY_EVENT_LOG_PANEL_ID, NATIVE_OVERLAY_EVENT_LOG_TITLE, sequence, NATIVE_OVERLAY_EVENT_LOG_STATUS, nodes)
}
validate_projection_identity: fn(projection: DevtoolsProjection, session_id: String) NativeOverlayAdapterError! {
    if projection.protocol != JET_DEVTOOLS_PROTOCOL -> return Err(NativeOverlayAdapterError.InvalidProtocol(expected: JET_DEVTOOLS_PROTOCOL, received: projection.protocol))
    if projection.session_id != session_id -> return Err(NativeOverlayAdapterError.SessionMismatch(expected: session_id, received: projection.session_id))
    validate_text(projection.session_id, "session id", false)
}
validate_revision: fn(revision: String, allow_empty: Bool) NativeOverlayAdapterError! {
    if !allow_empty && revision == "" -> return Err(NativeOverlayAdapterError.InvalidRevision)
    validate_text(revision, "revision", true)
}
validate_event: fn(event: JetDevtoolsEvent, projection: DevtoolsProjection) NativeOverlayAdapterError! {
    if event.sequence() == 0 || event.sequence() > projection.sequence -> return Err(NativeOverlayAdapterError.InvalidSequence(sequence: event.sequence()))
    validate_event_text(event)
}
validate_event_text: fn(event: JetDevtoolsEvent) NativeOverlayAdapterError! {
    validate_text(event.source(), "event source", false)
    validate_text(event.kind(), "event kind", false)
    validate_text(event.entity(), "event entity", false)
    validate_text(event.fields_json(), "event fields", true)
    if event.payload_json() == .Val(payload) -> validate_text(payload, "event payload", true)
}
typed_panel_map: fn(panels: [NativeOverlayPanelFact]) -> [String: NativeOverlayPanelFact] NativeOverlayAdapterError! {
    if panels.len() > MAX_OVERLAY_PANELS -> return Err(NativeOverlayAdapterError.InvalidPanel(message: "native overlay typed panels exceed their panel budget"))
    output := [String: NativeOverlayPanelFact]{}
    count := 0
    loop panel in panels {
        if panel.panel_id == NATIVE_OVERLAY_EVENT_LOG_PANEL_ID -> return Err(NativeOverlayAdapterError.ReservedPanel(panel_id: panel.panel_id))
        if output.get(panel.panel_id) != None -> return Err(NativeOverlayAdapterError.DuplicatePanel(panel_id: panel.panel_id))
        validate_panel(panel, count)
        output[panel.panel_id] = panel
    }
    output
}
validate_panel: fn(panel: NativeOverlayPanelFact, count: &Int) NativeOverlayAdapterError! {
    validate_text(panel.panel_id, "panel id", false)
    validate_text(panel.title, "panel title", false)
    validate_text(panel.status, "panel status", true)
    ids := [String: Bool]{}
    loop node in panel.nodes -> validate_node(node, 0, count, ids)
}
validate_node: fn(node: NativeOverlayNode, depth: Int, count: &Int, ids: &[String: Bool]) NativeOverlayAdapterError! {
    if depth > MAX_OVERLAY_DEPTH -> return Err(NativeOverlayAdapterError.InvalidNode(message: "native overlay node tree exceeds its depth budget"))
    validate_text(node.id, "node id", false)
    validate_text(node.label, "node label", false)
    if ids.get(node.id) != None -> return Err(NativeOverlayAdapterError.InvalidNode(message: "native overlay node id `{node.id}` is duplicated"))
    ids[node.id] = true
    count += 1
    if count > MAX_OVERLAY_NODES -> return Err(NativeOverlayAdapterError.InvalidNode(message: "native overlay projection exceeds its node budget"))
    if node.value == .Val(value) -> validate_text(value, "node value", true)
    if node.status == .Val(status) -> validate_text(status, "node status", true)
    if node.action == .Val(action) {
        if node.kind != .Action -> return Err(NativeOverlayAdapterError.InvalidNode(message: "native overlay node `{node.id}` carries an action but is not an action node"))
        validate_text(action.action_id, "action id", false)
    } else if node.kind == .Action {
        return Err(NativeOverlayAdapterError.InvalidNode(message: "native overlay action node `{node.id}` has no typed action"))
    }
    loop child in node.children -> validate_node(child, depth + 1, count, ids)
}
validate_text: fn(value: String, field: String, allow_empty: Bool) NativeOverlayAdapterError! {
    if (!allow_empty && value == "") || value.bytes().len() > MAX_OVERLAY_TEXT_BYTES -> return Err(NativeOverlayAdapterError.InvalidText(field: field))
    loop byte in value.bytes() {
        if byte < 32 || byte == 127 -> return Err(NativeOverlayAdapterError.InvalidText(field: field))
    }
}
panel_node_count: fn(panel: NativeOverlayPanelFact) -> Int {
    total := 0
    loop node in panel.nodes -> total += node_count(node)
    total
}
node_count: fn(node: NativeOverlayNode) -> Int {
    total := 1
    loop child in node.children -> total += node_count(child)
    total
}
find_overlay_node: fn(nodes: [NativeOverlayNode], node_id: String) -> NativeOverlayNode? {
    loop node in nodes {
        if node.id == node_id -> return Val(node)
        if find_overlay_node(node.children, node_id) == .Val(found) -> return Val(found)
    }
    None
}
make_unavailable: fn(subject: String, reason: NativeOverlayUnavailableReason) -> NativeOverlayUnavailableFact {
    NativeOverlayUnavailableFact{subject: subject, reason: reason}
}
