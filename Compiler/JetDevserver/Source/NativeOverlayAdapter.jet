    // Rust: crates/jet-devserver/src/NativeOverlayAdapter.rs:530
    fn apply_projection_with_panels(self: Self, projection: DevtoolsProjection, panels: [NativeOverlayPanelFact]) -> NativeOverlayUpdate NativeOverlayAdapterError! {
        self.set_typed_panels(panels)
        return self.apply_projection_internal(^projection, true)
    }
    // Rust: crates/jet-devserver/src/NativeOverlayAdapter.rs:540
    fn sync_session(self: Self, session: ResidentDevSession) -> NativeOverlayUpdate NativeOverlayAdapterError! {
        if session.id() != self.session_id -> return .Err(.SessionMismatch { expected: self.session_id.copy(), received: session.id().to_string() })
        return self.apply_projection(session.devtools_events_since(self.sequence))
    }
    // Rust: crates/jet-devserver/src/NativeOverlayAdapter.rs:554
    fn sync(self: Self, session: ResidentDevSession) -> NativeOverlayUpdate NativeOverlayAdapterError! { return self.sync_session(session) }
    // Rust: crates/jet-devserver/src/NativeOverlayAdapter.rs:561
    fn action_request(self: Self, panel_id: String, node_id: String) -> NativeOverlayActionRequest NativeOverlayAdapterError! {
        (revision, sequence) :: self.current_context()
        node :: self.find_node(panel_id, node_id)
        action :: node.action.as_ref() ?? return .Err(.ActionUnavailable(node_id.to_string()))
        return NativeOverlayActionRequest.new(JET_DEVTOOLS_PROTOCOL, self.session_id.copy(), ^revision, sequence, panel_id, node_id, action.action_id.copy(), action.required_grant)
