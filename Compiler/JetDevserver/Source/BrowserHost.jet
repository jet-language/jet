    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:820
    pub fn for_session(session_id: String) -> BrowserHost { BrowserHost.new(^session_id) }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:825
    pub fn session_id(self) -> String { self.session_id }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:830
    pub fn revision(self) -> U64? { self.revision }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:835
    pub fn sequence(self) -> U64? { self.sequence }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:840
    pub fn observed_at_ms(self) -> U64? { self.observed_at_ms }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:845
    pub fn state(self) -> BrowserSessionState { self.state }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:851
    pub fn cursor(self) -> BrowserReconnectCursor? { self.cursor }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:856
    pub fn selection(self) -> BrowserSelection? { self.selection }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:861
    pub fn apply_event(&self, event: BrowserHostEvent) -> () BrowserHostError! {
        _ :: event.validate() ?? return .Err(err)
        if event.session_id != self.session_id -> return .Err(.WrongSession { expected: ~self.session_id, received: ^event.session_id })
        if self.revision == .Val(current) && event.revision < current -> return .Err(.StaleRevision { current: current, received: event.revision })
        if self.sequence == .Val(current) && event.sequence <= current -> return .Err(.StaleSequence { current: current, received: event.sequence })
        next_ids := [String:Bool]{}
        loop panel in event.panels { &next_ids.insert(panel.panel_id, true) }
        &self.panels.retain((panel_id, _) -> next_ids.contains(panel_id))
        loop fact in event.panels {
            if self.panels.get_mut(fact.panel_id) == .Val(panel) {
                panel.fact = ~fact
            } else {
                &self.panels.insert(~fact.panel_id, PanelState { fact: ~fact, layout: [PanelLayout.default(), PanelLayout.default()] })
            }
        }
        self.revision = .Val(event.revision)
        self.sequence = .Val(event.sequence)
        self.observed_at_ms = .Val(event.observed_at_ms)
        self.state = derive_session_state(event.panels)
        self.cursor = .Val(BrowserReconnectCursor.new(event.sequence))
        if self.selection == .Val(selection) && !self.node_exists(selection.panel_id, selection.node_id) -> self.selection = None
        if self.history.len() == MAX_RECONNECT_EVENTS -> _ :: &self.history.pop_front()
        &self.history.push_back(^event)
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:923
    pub fn apply(&self, event: BrowserHostEvent) -> () BrowserHostError! { &self.apply_event(^event) }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:928
    pub fn resume_from(self, cursor: BrowserReconnectCursor?) -> BrowserReconnect BrowserHostError! {
        if cursor == .Val(requested) && self.sequence == .Val(current) && requested.sequence > current -> return .Err(.CursorAhead { cursor: requested.sequence, current: current })
        if cursor == .Val(requested) {
            if self.history.front() == .Val(first) {
                earliest :: first.sequence
                if requested.sequence.saturating_add(1) < earliest -> return .Err(.CursorExpired { cursor: requested.sequence, earliest: earliest })
            } else if requested.sequence > 0 -> return .Err(.CursorExpired { cursor: requested.sequence, earliest: 0 })
        }
        events :: self.history.iter().filter((event) -> cursor == None || cursor.is_some_and((from) -> event.sequence > from.sequence)).cloned().collect[[BrowserHostEvent]]()
        return BrowserReconnect { session_id: ~self.session_id, from: cursor, cursor: self.sequence.map(BrowserReconnectCursor.new), events: ^events, complete: true }
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:972
    pub fn events_since(self, sequence: U64?) -> [BrowserHostEvent] BrowserHostError! {
        resumed :: self.resume_from(sequence.map(BrowserReconnectCursor.new)) ?? return .Err(err)
        return ^resumed.events
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:979
    pub fn set_cursor(&self, cursor: BrowserReconnectCursor?) -> () BrowserHostError! {
        if cursor == .Val(value) -> _ :: self.resume_from(.Val(value)) ?? return .Err(err)
        self.cursor = cursor
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:988
    pub fn scrub(&self, sequence: U64?) -> () BrowserHostError! { &self.set_cursor(sequence.map(BrowserReconnectCursor.new)) }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:993
    pub fn panel_catalog(self) -> [BrowserPanelFact] {
        keys := self.panels.keys().collect[[String]]()
        &keys.sort()
        panels := keys.iter().map((key) -> ~self.panels[key].fact).collect[[BrowserPanelFact]]()
        catalog :: descriptors()
        ranks := [String:USize]{}
        loop (index, descriptor) in catalog.iter().enumerate() {
            if !ranks.contains(descriptor.id.as_str()) -> &ranks.insert(descriptor.id.as_str(), index)
        }
        // Stable rank sort preserves BTree identity order for unlisted panels.
        &panels.sort_by_key((panel) -> ranks.get(panel.panel_id) ?? USize.MAX)
        return panels
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1010
    pub fn panel(self, panel_id: String) -> BrowserPanelFact? { self.panels.get(panel_id).map((panel) -> panel.fact) }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1015
    pub fn is_open(self, placement: BrowserPlacement, panel_id: String) -> Bool { self.panels.get(panel_id).is_some_and((panel) -> panel.layout[placement.index()].open) }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1022
    pub fn dock(self, placement: BrowserPlacement, panel_id: String) -> BrowserDock? { self.panels.get(panel_id).map((panel) -> panel.layout[placement.index()].dock) }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1029
    pub fn open_panel(&self, placement: BrowserPlacement, panel_id: String) -> BrowserHostEffect BrowserHostError! {
        panel :: &self.require_panel(panel_id) ?? return .Err(err)
        panel.layout[placement.index()].open = true
        return .PanelOpened { placement: placement, panel_id: ^panel_id }
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1044
    pub fn close_panel(&self, placement: BrowserPlacement, panel_id: String) -> BrowserHostEffect BrowserHostError! {
        panel :: &self.require_panel(panel_id) ?? return .Err(err)
        panel.layout[placement.index()].open = false
        if self.selection.is_some_and((selection) -> selection.panel_id == panel_id) -> self.selection = None
        return .PanelClosed { placement: placement, panel_id: ^panel_id }
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1066
    pub fn dock_panel(&self, placement: BrowserPlacement, panel_id: String, dock: BrowserDock) -> BrowserHostEffect BrowserHostError! {
        panel :: &self.require_panel(panel_id) ?? return .Err(err)
        panel.layout[placement.index()].dock = dock
