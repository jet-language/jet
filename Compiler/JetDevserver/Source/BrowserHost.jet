// Typed projection of the shared session; no wire decoder or renderer lives here.
use {
    std.collections.[VecDeque]
    fmt: std.fmt
    jet_devserver.Devtools.catalog.[descriptors]
}
BROWSER_DEVTOOLS_PROTOCOL: "jet.devtools.v1"
JET_DEVTOOLS_PROTOCOL: BROWSER_DEVTOOLS_PROTOCOL
MAX_RECONNECT_EVENTS: 256
MAX_BROWSER_PANELS: 128
MAX_BROWSER_NODES: 4096
MAX_BROWSER_NODE_DEPTH: 64
MAX_BROWSER_TEXT: 256
MAX_BROWSER_VALUE: 4096
BrowserPlacement: enum { InApp; Workbench }
impl BrowserPlacement {
    as_str: fn(self) -> String { if self == {
        .InApp -> "in-app"
        .Workbench -> "workbench"
    } }
    index: fn(self) -> USize { if self == {
        .InApp -> 0
        .Workbench -> 1
    } }
    default: fn() -> BrowserPlacement { .InApp }
}
BrowserNodeKind: enum { Text; Status; Table; Tree; Chart; Action }
impl BrowserNodeKind {
    as_str: fn(self) -> String {
        if self == {
            .Text -> "text"
            .Status -> "status"
            .Table -> "table"
            .Tree -> "tree"
            .Chart -> "chart"
            .Action -> "action"
        }
    }
}
BrowserDock: enum { Left; Right; Bottom; Floating }
impl BrowserDock {
    as_str: fn(self) -> String { if self == {
        .Left -> "left"
        .Right -> "right"
        .Bottom -> "bottom"
        .Floating -> "floating"
    } }
    default: fn() -> BrowserDock { .Left }
}
BrowserSessionState: enum { Idle; Building; BuildFailed; RuntimeFailure; HotReload; TestsFailing }
impl BrowserSessionState {
    as_str: fn(self) -> String {
        if self == {
            .Idle -> "idle"
            .Building -> "building"
            .BuildFailed -> "build-failed"
            .RuntimeFailure -> "runtime-failure"
            .HotReload -> "hot-reload"
            .TestsFailing -> "tests-failing"
        }
    }
    default: fn() -> BrowserSessionState { .Idle }
}
BrowserSourceLocation: struct { source_id: String; line: U32; column: U32; function: String? }
impl BrowserSourceLocation {
    new: fn(source_id: String, line: U32, column: U32, function: String?) -> BrowserSourceLocation {
        BrowserSourceLocation { source_id: source_id.move(), line: line, column: column, function: function.move() }
    }
    validate: fn(self) BrowserHostError! {
        _: validate_source_id(self.source_id) ?? return .Err(err)
        if self.line == 0 -> return .Err(.InvalidSource("source line must be one-based"))
        if self.function == .Val(function) -> _: validate_text(function, "source function", MAX_BROWSER_TEXT) ?? return .Err(err)
    }
}
BrowserSourceGrant: struct {
    session_id: String; revision: U64; panel_id: String; node_id: String; source: BrowserSourceLocation
}
impl BrowserSourceGrant {
    new: fn(session_id: String, revision: U64, panel_id: String, node_id: String, source: BrowserSourceLocation) -> BrowserSourceGrant {
        BrowserSourceGrant { session_id: session_id.move(), revision: revision, panel_id: panel_id, node_id: node_id, source: source.move() }
    }
}
// The Rust `SourceNavigationGrant` is `BrowserSourceGrant` `BrowserNavigationGrant` is
// `BrowserSourceGrant`
BrowserActionGrant: struct { session_id: String; revision: U64; panel_id: String; node_id: String; action_id: String }
impl BrowserActionGrant {
    new: fn(session_id: String, revision: U64, panel_id: String, node_id: String, action_id: String) -> BrowserActionGrant {
        BrowserActionGrant { session_id: session_id.move(), revision: revision, panel_id: panel_id, node_id: node_id, action_id: action_id.move() }
    }
}
// The Rust `ActionGrant` is `BrowserActionGrant`
BrowserNode: struct { id: String; kind: BrowserNodeKind; label: String; value: String?; status: String?; children: [BrowserNode] }
impl BrowserNode {
    new: fn(id: String, kind: BrowserNodeKind, label: String) -> BrowserNode {
        BrowserNode { id: id.move(), kind: kind, label: label, value: None, status: None, children: [] }
    }
    with_value: fn(self: BrowserNode, value: String) -> BrowserNode {
        self := self.move()
        self.value = .Val(value)
        return self
    }
    with_status: fn(self: BrowserNode, status: String) -> BrowserNode {
        self := self.move()
        self.status = .Val(status)
        return self
    }
    with_children: fn(self: BrowserNode, children: [BrowserNode]) -> BrowserNode {
        self := self.move()
        self.children = children.move()
        return self
    }
}
BrowserPanelFact: struct {
    panel_id: String; title: String; freshness_ms: U64; status: String; cursor: U64?; nodes: [BrowserNode]
}
impl BrowserPanelFact {
    new: fn(panel_id: String, title: String, freshness_ms: U64, status: String, nodes: [BrowserNode]) -> BrowserPanelFact {
        BrowserPanelFact { panel_id: panel_id.move(), title: title, freshness_ms: freshness_ms, status: status, cursor: None, nodes: nodes.move() }
    }
    with_cursor: fn(self: BrowserPanelFact, cursor: U64?) -> BrowserPanelFact {
        self := self.move()
        self.cursor = cursor
        return self
    }
    identity: fn(self) -> String { self.panel_id }
}
BrowserHostEvent: struct {
    protocol: String; session_id: String; revision: U64; sequence: U64; observed_at_ms: U64; panels: [BrowserPanelFact]
}
impl BrowserHostEvent {
    new: fn(session_id: String, revision: U64, sequence: U64, observed_at_ms: U64, panels: [BrowserPanelFact]) -> BrowserHostEvent {
        BrowserHostEvent { protocol: BROWSER_DEVTOOLS_PROTOCOL, session_id: session_id, revision: revision, sequence: sequence, observed_at_ms: observed_at_ms, panels: panels.move() }
    }
    validate: fn(self) BrowserHostError! {
        if self.protocol != BROWSER_DEVTOOLS_PROTOCOL -> return .Err(.InvalidEvent("browser event protocol does not match jet.devtools.v1"))
        _: validate_text(self.session_id, "event session", MAX_BROWSER_TEXT) ?? return .Err(err)
        if self.panels.len() > MAX_BROWSER_PANELS -> return .Err(.InvalidEvent("browser event exceeds the panel bound"))
        panel_ids := [String:Bool]{}
        node_count := USize{0}
        loop panel in self.panels {
            _: validate_panel(panel, node_count) ?? return .Err(err)
            if panel_ids.contains(panel.panel_id) -> return .Err(.InvalidEvent("browser event repeats panel `{panel.panel_id}`"))
            panel_ids.insert(panel.panel_id, true)
        }
    }
}
BrowserReconnectCursor: struct { sequence: U64 }
impl BrowserReconnectCursor {
    new: fn(sequence: U64) -> BrowserReconnectCursor { BrowserReconnectCursor { sequence: sequence } }
    default: fn() -> BrowserReconnectCursor { BrowserReconnectCursor.new(0) }
}
impl From[U64] for BrowserReconnectCursor {
    from: fn(sequence: U64) -> BrowserReconnectCursor { BrowserReconnectCursor.new(sequence) }
}
BrowserReconnect: struct {
    session_id: String; from: BrowserReconnectCursor?; cursor: BrowserReconnectCursor?; events: [BrowserHostEvent]; complete: Bool
}
BrowserSelection: struct { panel_id: String; node_id: String? }
BrowserHostAction: enum {
    OpenPanel { placement: BrowserPlacement, panel_id: String }
    ClosePanel { placement: BrowserPlacement, panel_id: String }
    DockPanel { placement: BrowserPlacement, panel_id: String, dock: BrowserDock }
    NavigateSource { placement: BrowserPlacement, panel_id: String, node_id: String, grant: BrowserSourceGrant }
    InvokeAction { placement: BrowserPlacement, panel_id: String, node_id: String, action_id: String, grant: BrowserActionGrant }
}
impl BrowserHostAction {
    open: fn(placement: BrowserPlacement, panel_id: String) -> BrowserHostAction { .OpenPanel { placement: placement, panel_id: panel_id.move() } }
    close: fn(placement: BrowserPlacement, panel_id: String) -> BrowserHostAction { .ClosePanel { placement: placement, panel_id: panel_id.move() } }
    dock: fn(placement: BrowserPlacement, panel_id: String, dock: BrowserDock) -> BrowserHostAction { .DockPanel { placement: placement, panel_id: panel_id, dock: dock } }
    navigate_source: fn(placement: BrowserPlacement, panel_id: String, node_id: String, grant: BrowserSourceGrant) -> BrowserHostAction { .NavigateSource { placement: placement, panel_id: panel_id, node_id: node_id, grant: grant.move() } }
    invoke_action: fn(placement: BrowserPlacement, panel_id: String, node_id: String, action_id: String, grant: BrowserActionGrant) -> BrowserHostAction { .InvokeAction { placement: placement, panel_id: panel_id, node_id: node_id, action_id: action_id, grant: grant.move() } }
}
BrowserHostEffect: enum {
    PanelOpened { placement: BrowserPlacement, panel_id: String }
    PanelClosed { placement: BrowserPlacement, panel_id: String }
    PanelDocked { placement: BrowserPlacement, panel_id: String, dock: BrowserDock }
    SourceNavigated { placement: BrowserPlacement, panel_id: String, node_id: String, source: BrowserSourceLocation }
    ActionInvoked { placement: BrowserPlacement, panel_id: String, node_id: String, action_id: String }
}
BrowserHtmlElement: struct {
    id: String; kind: String; panel_id: String?; node_id: String?; label: String; value: String?; status: String?
}
BrowserHtmlViewModel: struct {
    placement: BrowserPlacement; route: String; protocol: String; session_id: String;
    revision: U64?; sequence: U64?; cursor: BrowserReconnectCursor?; state: BrowserSessionState;
    selection: BrowserSelection?; panels: [BrowserPanelView]; elements: [BrowserHtmlElement]
}
BrowserPanelView: struct {
    panel_id: String; title: String; freshness_ms: U64; status: String; cursor: U64?;
    open: Bool; dock: BrowserDock; nodes: [BrowserNode]
}
#Error
BrowserHostError: enum {
    InvalidEvent(String)
    WrongSession { expected: String, received: String }
    StaleRevision { current: U64, received: U64 }
    StaleSequence { current: U64, received: U64 }
    CursorExpired { cursor: U64, earliest: U64 }
    CursorAhead { cursor: U64, current: U64 }
    UnknownPanel(String)
    UnknownNode { panel_id: String, node_id: String }
    ActionNotGranted(String)
    InvalidSource(String)
    InvalidAction(String)
}
impl BrowserHostError.Display {
    fmt: fn(self, formatter: &fmt.Formatter) -> fmt.Result {
        message: if self == {
            .InvalidEvent(message) -> "invalid browser event: {message}"
            .WrongSession { expected, received } -> "browser event belongs to session `{received}`, expected `{expected}`"
            .StaleRevision { current, received } -> "stale browser revision {received}; current revision is {current}"
            .StaleSequence { current, received } -> "stale browser sequence {received}; current sequence is {current}"
            .CursorExpired { cursor, earliest } -> "browser reconnect cursor {cursor} predates retained sequence {earliest}"
            .CursorAhead { cursor, current } -> "browser reconnect cursor {cursor} is ahead of current sequence {current}"
            .UnknownPanel(panel_id) -> "unknown browser panel `{panel_id}`"
            .UnknownNode { panel_id, node_id } -> "unknown browser node `{node_id}` in panel `{panel_id}`"
            .ActionNotGranted(message) -> "browser action not granted: {message}"
            .InvalidSource(message) -> "invalid browser source: {message}"
            .InvalidAction(message) -> "invalid browser action: {message}"
        }
        return formatter.write_str(message)
    }
}
PanelState: struct { fact: BrowserPanelFact; layout: [PanelLayout] }
PanelLayout: struct { open: Bool; dock: BrowserDock }
impl PanelLayout { default: fn() -> PanelLayout { PanelLayout { open: false, dock: .Left } } }
BrowserHost: struct {
    session_id: String; revision: U64?; sequence: U64?; observed_at_ms: U64?; state: BrowserSessionState;
    cursor: BrowserReconnectCursor?; selection: BrowserSelection?; panels: [String:PanelState]; history: VecDeque<BrowserHostEvent>
}
impl BrowserHost {
    new: fn(session_id: String) -> BrowserHost {
        BrowserHost { session_id: session_id.move(), revision: None, sequence: None, observed_at_ms: None, state: .Idle, cursor: None, selection: None, panels: {}, history: VecDeque[BrowserHostEvent].new() }
    }
    for_session: fn(session_id: String) -> BrowserHost { BrowserHost.new(session_id) }
    session_id: fn(self) -> String { self.session_id }
    revision: fn(self) -> U64? { self.revision }
    sequence: fn(self) -> U64? { self.sequence }
    observed_at_ms: fn(self) -> U64? { self.observed_at_ms }
    state: fn(self) -> BrowserSessionState { self.state }
    cursor: fn(self) -> BrowserReconnectCursor? { self.cursor }
    selection: fn(self) -> BrowserSelection? { self.selection }
    apply_event: fn(&self, event: BrowserHostEvent) BrowserHostError! {
        _: event.validate() ?? return .Err(err)
        if event.session_id != self.session_id -> return .Err(.WrongSession { expected: self.session_id.copy(), received: event.session_id.move() })
        if self.revision == .Val(current) && event.revision < current -> return .Err(.StaleRevision { current: current, received: event.revision })
        if self.sequence == .Val(current) && event.sequence <= current -> return .Err(.StaleSequence { current: current, received: event.sequence })
        next_ids := [String:Bool]{}
        loop panel in event.panels { next_ids.insert(panel.panel_id, true) }
        self.panels.retain((panel_id, _) -> next_ids.contains(panel_id))
        loop fact in event.panels {
            if self.panels.get_mut(fact.panel_id) == .Val(panel) {
                panel.fact = fact.copy()
            } else {
                self.panels.insert(fact.panel_id.copy(), PanelState { fact: fact.copy(), layout: [PanelLayout.default(), PanelLayout.default()] })
            }
        }
        self.revision = .Val(event.revision)
        self.sequence = .Val(event.sequence)
        self.observed_at_ms = .Val(event.observed_at_ms)
        self.state = derive_session_state(event.panels)
        self.cursor = .Val(BrowserReconnectCursor.new(event.sequence))
        if self.selection == .Val(selection) && !self.node_exists(selection.panel_id, selection.node_id) -> self.selection = None
        if self.history.len() == MAX_RECONNECT_EVENTS -> _: self.history.pop_front()
        self.history.push_back(event)
    }
    apply: fn(&self, event: BrowserHostEvent) BrowserHostError! { self.apply_event(event) }
    resume_from: fn(self, cursor: BrowserReconnectCursor?) -> BrowserReconnect BrowserHostError! {
        if cursor == .Val(requested) && self.sequence == .Val(current) && requested.sequence > current -> return .Err(.CursorAhead { cursor: requested.sequence, current: current })
        if cursor == .Val(requested) {
            if self.history.front() == .Val(first) {
                earliest: first.sequence
                if requested.sequence.saturating_add(1) < earliest -> return .Err(.CursorExpired { cursor: requested.sequence, earliest: earliest })
            } else if requested.sequence > 0 -> return .Err(.CursorExpired { cursor: requested.sequence, earliest: 0 })
        }
        events: self.history.iter().filter((event) -> cursor == None || cursor.is_some_and((from) -> event.sequence > from.sequence)).cloned().collect[[BrowserHostEvent]]()
        return BrowserReconnect { session_id: self.session_id.copy(), from: cursor, cursor: self.sequence.map(BrowserReconnectCursor.new), events: events, complete: true }
    }
    events_since: fn(self, sequence: U64?) -> [BrowserHostEvent] BrowserHostError! {
        resumed: self.resume_from(sequence.map(BrowserReconnectCursor.new)) ?? return .Err(err)
        return resumed.events.move()
    }
    set_cursor: fn(&self, cursor: BrowserReconnectCursor?) BrowserHostError! {
        if cursor == .Val(value) -> _: self.resume_from(.Val(value)) ?? return .Err(err)
        self.cursor = cursor
    }
    scrub: fn(&self, sequence: U64?) BrowserHostError! { self.set_cursor(sequence.map(BrowserReconnectCursor.new)) }
    panel_catalog: fn(self) -> [BrowserPanelFact] {
        keys := self.panels.keys().collect[[String]]()
        keys.sort()
        panels := keys.iter().map((key) -> self.panels[key].fact.copy()).collect[[BrowserPanelFact]]()
        catalog: descriptors()
        ranks := [String:USize]{}
        loop (index, descriptor) in catalog.iter().enumerate() {
            if !ranks.contains(descriptor.id.as_str()) -> ranks.insert(descriptor.id.as_str(), index)
        }
        // Stable rank sort preserves BTree identity order for unlisted panels.
        panels.sort_by_key((panel) -> ranks.get(panel.panel_id) ?? USize.MAX)
        return panels
    }
    panel: fn(self, panel_id: String) -> BrowserPanelFact? { self.panels.get(panel_id).map((panel) -> panel.fact) }
    is_open: fn(self, placement: BrowserPlacement, panel_id: String) -> Bool { self.panels.get(panel_id).is_some_and((panel) -> panel.layout[placement.index()].open) }
    dock: fn(self, placement: BrowserPlacement, panel_id: String) -> BrowserDock? { self.panels.get(panel_id).map((panel) -> panel.layout[placement.index()].dock) }
    open_panel: fn(&self, placement: BrowserPlacement, panel_id: String) -> BrowserHostEffect BrowserHostError! {
        panel: self.require_panel(panel_id) ?? return .Err(err)
        panel.layout[placement.index()].open = true
        return .PanelOpened { placement: placement, panel_id: panel_id.move() }
    }
    close_panel: fn(&self, placement: BrowserPlacement, panel_id: String) -> BrowserHostEffect BrowserHostError! {
        panel: self.require_panel(panel_id) ?? return .Err(err)
        panel.layout[placement.index()].open = false
        if self.selection.is_some_and((selection) -> selection.panel_id == panel_id) -> self.selection = None
        return .PanelClosed { placement: placement, panel_id: panel_id.move() }
    }
    dock_panel: fn(&self, placement: BrowserPlacement, panel_id: String, dock: BrowserDock) -> BrowserHostEffect BrowserHostError! {
        panel: self.require_panel(panel_id) ?? return .Err(err)
        panel.layout[placement.index()].dock = dock
        return .PanelDocked { placement: placement, panel_id: panel_id, dock: dock }
    }
    select: fn(&self, panel_id: String, node_id: String?) BrowserHostError! {
        _: self.require_panel(panel_id) ?? return .Err(err)
        if node_id == .Val(id) -> _: self.require_node(panel_id, id) ?? return .Err(err)
        self.selection = .Val(BrowserSelection { panel_id: panel_id.move(), node_id: node_id.move() })
    }
    clear_selection: fn(&self) { self.selection = None }
    dispatch: fn(&self, action: BrowserHostAction) -> BrowserHostEffect BrowserHostError! {
        if action == {
            .OpenPanel { placement, panel_id } -> self.open_panel(placement, panel_id)
            .ClosePanel { placement, panel_id } -> self.close_panel(placement, panel_id)
            .DockPanel { placement, panel_id, dock } -> self.dock_panel(placement, panel_id, dock)
            .NavigateSource { placement, panel_id, node_id, grant } -> self.navigate_source(placement, panel_id, node_id, grant)
            .InvokeAction { placement, panel_id, node_id, action_id, grant } -> self.invoke_action(placement, panel_id, node_id, action_id, grant)
        }
    }
    navigate_source: fn(self, placement: BrowserPlacement, panel_id: String, node_id: String, grant: BrowserSourceGrant) -> BrowserHostEffect BrowserHostError! {
        _: self.validate_grant_context(panel_id, node_id, grant.session_id, grant.revision) ?? return .Err(err)
        if grant.panel_id != panel_id || grant.node_id != node_id -> return .Err(.ActionNotGranted("source grant does not name the requested panel/node"))
        _: grant.source.validate() ?? return .Err(err)
        return .SourceNavigated { placement: placement, panel_id: panel_id.to_string(), node_id: node_id.to_string(), source: grant.source.move() }
    }
    invoke_action: fn(self, placement: BrowserPlacement, panel_id: String, node_id: String, action_id: String, grant: BrowserActionGrant) -> BrowserHostEffect BrowserHostError! {
        _: self.validate_grant_context(panel_id, node_id, grant.session_id, grant.revision) ?? return .Err(err)
        if grant.panel_id != panel_id || grant.node_id != node_id || grant.action_id != action_id -> return .Err(.ActionNotGranted("action grant does not name the requested panel/node/action"))
        _: validate_text(action_id, "action identity", MAX_BROWSER_TEXT) ?? return .Err(.ActionNotGranted(err.to_string()))
        node: self.require_node(panel_id, node_id) ?? return .Err(err)
        if node.kind != .Action || node.id != action_id -> return .Err(.ActionNotGranted("the requested node is not an explicitly granted Action node"))
        return .ActionInvoked { placement: placement, panel_id: panel_id.to_string(), node_id: node_id.to_string(), action_id: action_id.to_string() }
    }
    view_model: fn(self, placement: BrowserPlacement) -> BrowserHtmlViewModel {
        keys := self.panels.keys().collect[[String]]()
        keys.sort()
        panels := keys.iter().map((key) -> {
            panel: self.panels[key]
            BrowserPanelView { panel_id: panel.fact.panel_id.copy(), title: panel.fact.title.copy(), freshness_ms: panel.fact.freshness_ms, status: panel.fact.status.copy(), cursor: panel.fact.cursor, open: panel.layout[placement.index()].open, dock: panel.layout[placement.index()].dock, nodes: panel.fact.nodes.copy() }
        }).collect[[BrowserPanelView]]()
        catalog: descriptors()
        ranks := [String:USize]{}
        loop (index, descriptor) in catalog.iter().enumerate() {
            if !ranks.contains(descriptor.id.as_str()) -> ranks.insert(descriptor.id.as_str(), index)
        }
        panels.sort_by_key((panel) -> ranks.get(panel.panel_id) ?? USize.MAX)
        elements := [BrowserHtmlElement {
            id: "jet-devtools-{placement.as_str()}", kind: "host", panel_id: None, node_id: None,
            label: self.state.as_str(), value: self.sequence.map((sequence) -> sequence.to_string()), status: .Val(self.state.as_str())
        }]
        loop panel in panels {
            elements.push(BrowserHtmlElement { id: element_id(placement, panel.panel_id, None), kind: "panel", panel_id: .Val(panel.panel_id.copy()), node_id: None, label: panel.title.copy(), value: None, status: .Val(panel.status.copy()) })
            flatten_nodes(placement, panel.panel_id, panel.nodes, elements)
        }
        return BrowserHtmlViewModel {
            placement: placement, route: if placement == {
                .InApp -> "/__jet_devtools"
                .Workbench -> "/__jet_devtools/workbench"
            },
            protocol: BROWSER_DEVTOOLS_PROTOCOL, session_id: self.session_id.copy(), revision: self.revision, sequence: self.sequence,
            cursor: self.cursor, state: self.state, selection: self.selection.copy(), panels: panels, elements: elements.move()
        }
    }
    require_panel: fn(&self, panel_id: String) -> PanelState BrowserHostError! {
        self.panels.get_mut(panel_id) ?? return .Err(.UnknownPanel(panel_id.to_string()))
    }
    require_node: fn(self, panel_id: String, node_id: String) -> BrowserNode BrowserHostError! {
        panel: self.panels.get(panel_id) ?? return .Err(.UnknownPanel(panel_id.to_string()))
        find_node(panel.fact.nodes, node_id) ?? return .Err(.UnknownNode { panel_id: panel_id.to_string(), node_id: node_id.to_string() })
    }
    node_exists: fn(self, panel_id: String, node_id: String?) -> Bool {
        if node_id == {
            .Val(id) -> self.require_node(panel_id, id).is_ok()
            .None -> self.panels.contains(panel_id)
        }
    }
    validate_grant_context: fn(self, panel_id: String, node_id: String, grant_session: String, grant_revision: U64) BrowserHostError! {
        current_revision: self.revision ?? return .Err(.ActionNotGranted("no canonical event has established a current revision"))
        if grant_session != self.session_id -> return .Err(.WrongSession { expected: self.session_id.copy(), received: grant_session.to_string() })
        if grant_revision != current_revision -> return .Err(.StaleRevision { current: current_revision, received: grant_revision })
        _: self.require_node(panel_id, node_id) ?? return .Err(err)
    }
    default: fn() -> BrowserHost { BrowserHost.new("") }
}
validate_panel: fn(panel: BrowserPanelFact, node_count: &USize) BrowserHostError! {
    _: validate_text(panel.panel_id, "panel identity", MAX_BROWSER_TEXT) ?? return .Err(err)
    _: validate_text(panel.title, "panel title", MAX_BROWSER_TEXT) ?? return .Err(err)
    _: validate_text(panel.status, "panel status", MAX_BROWSER_TEXT) ?? return .Err(err)
    node_ids := [String:Bool]{}
    loop node in panel.nodes { _: validate_node(node, 0, node_count, node_ids) ?? return .Err(err) }
}
validate_node: fn(node: BrowserNode, depth: USize, node_count: &USize, node_ids: &[String:Bool]) BrowserHostError! {
    if depth > MAX_BROWSER_NODE_DEPTH -> return .Err(.InvalidEvent("browser node tree exceeds the depth bound"))
    node_count = node_count.saturating_add(1)
    if node_count > MAX_BROWSER_NODES -> return .Err(.InvalidEvent("browser event exceeds the node bound"))
    _: validate_text(node.id, "node identity", MAX_BROWSER_TEXT) ?? return .Err(err)
    _: validate_text(node.label, "node label", MAX_BROWSER_TEXT) ?? return .Err(err)
    if node.value == .Val(value) -> _: validate_text(value, "node value", MAX_BROWSER_VALUE) ?? return .Err(err)
    if node.status == .Val(status) -> _: validate_text(status, "node status", MAX_BROWSER_TEXT) ?? return .Err(err)
    if node_ids.contains(node.id) -> return .Err(.InvalidEvent("browser panel repeats node `{node.id}`"))
    node_ids.insert(node.id, true)
    loop child in node.children { _: validate_node(child, depth + 1, node_count, node_ids) ?? return .Err(err) }
}
validate_text: fn(value: String, label: String, limit: USize) BrowserHostError! {
    if value.is_empty() || value.len() > limit || value.chars().any((c) -> c.is_control()) -> return .Err(.InvalidEvent("{label} is empty, too long, or contains control text"))
}
validate_source_id: fn(source_id: String) BrowserHostError! {
    if source_id.is_empty() || source_id.len() > MAX_BROWSER_TEXT || source_id.chars().any((c) -> c.is_control()) || source_id.starts_with('/') || source_id.starts_with('\\') || source_id.contains('\\') || source_id.split('/').any((part) -> part == ".." || part.is_empty()) || source_id.contains("://") -> return .Err(.InvalidSource("source identity must be a non-empty project-relative path"))
}
derive_session_state: fn(panels: [BrowserPanelFact]) -> BrowserSessionState {
    state := BrowserSessionState.Idle
    loop panel in panels {
        value := panel.status.trim() // #4303
        value = value.to_ascii_lowercase()
        candidate: if value == {
            "building" -> .Building
            "build_failed" | "build-failed" | "build failed" -> .BuildFailed
            "runtime_failure" | "runtime-failure" | "runtime failure" -> .RuntimeFailure
            "hot_reload" | "hot-reload" | "hot reload" -> .HotReload
            "tests_failing" | "tests-failing" | "tests failing" -> .TestsFailing
            else -> { next }
        }
        state = prefer_state(state, candidate)
    }
    return state
}
prefer_state: fn(current: BrowserSessionState, candidate: BrowserSessionState) -> BrowserSessionState {
    fn rank(state: BrowserSessionState) -> U8 {
        if state == {
            .Idle -> 0
            .HotReload -> 1
            .Building -> 2
            .TestsFailing -> 3
            .RuntimeFailure -> 4
            .BuildFailed -> 5
        }
    }
    if rank(candidate) >= rank(current) -> candidate else -> current
}
find_node: fn(nodes: [BrowserNode], node_id: String) -> BrowserNode? {
    loop node in nodes {
        if node.id == node_id -> return .Val(node)
        if find_node(node.children, node_id) == .Val(found) -> return .Val(found)
    }
    return None
}
element_id: fn(placement: BrowserPlacement, panel_id: String, node_id: String?) -> String {
    id := "jet-devtools-{placement.as_str()}-panel-{stable_fragment(panel_id)}"
    if node_id == .Val(node_id) { id.push_str("-node-"); id.push_str(stable_fragment(node_id)) }
    return id
}
stable_fragment: fn(value: String) -> String {
    output := String.with_capacity(value.len())
    loop character in value.chars() { output.push(if character.is_ascii_alphanumeric() || character == '_' || character == '-' -> character else -> '-') }
    if output.is_empty() -> "item" else -> output
}
flatten_nodes: fn(placement: BrowserPlacement, panel_id: String, nodes: [BrowserNode], elements: &[BrowserHtmlElement]) {
    loop node in nodes {
        elements.push(BrowserHtmlElement { id: element_id(placement, panel_id, .Val(node.id)), kind: node.kind.as_str(), panel_id: .Val(panel_id.to_string()), node_id: .Val(node.id.copy()), label: node.label.copy(), value: node.value.copy(), status: node.status.copy() })
        flatten_nodes(placement, panel_id, node.children, elements)
    }
}
