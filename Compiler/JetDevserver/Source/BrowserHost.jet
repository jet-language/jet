pub struct BrowserHostEvent {
    pub protocol: String; pub session_id: String; pub revision: U64; pub sequence: U64; pub observed_at_ms: U64; pub panels: [BrowserPanelFact]
}
impl BrowserHostEvent {
    // Rust: crates/jet-devserver/src/BrowserHost.rs:385
    pub fn new(session_id: String, revision: U64, sequence: U64, observed_at_ms: U64, panels: [BrowserPanelFact]) -> BrowserHostEvent {
        BrowserHostEvent { protocol: BROWSER_DEVTOOLS_PROTOCOL, session_id: ^session_id, revision: revision, sequence: sequence, observed_at_ms: observed_at_ms, panels: ^panels }
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:403
    pub fn validate(self) -> () BrowserHostError! {
        if self.protocol != BROWSER_DEVTOOLS_PROTOCOL -> return .Err(.InvalidEvent("browser event protocol does not match jet.devtools.v1"))
        _ :: validate_text(self.session_id, "event session", MAX_BROWSER_TEXT) ?? return .Err(err)
        if self.panels.len() > MAX_BROWSER_PANELS -> return .Err(.InvalidEvent("browser event exceeds the panel bound"))
        panel_ids := [String:Bool]{}
        node_count := USize{0}
        loop panel in self.panels {
            _ :: validate_panel(panel, &node_count) ?? return .Err(err)
            if panel_ids.contains(panel.panel_id) -> return .Err(.InvalidEvent("browser event repeats panel `{panel.panel_id}`"))
            &panel_ids.insert(panel.panel_id, true)
        }
    }
}
