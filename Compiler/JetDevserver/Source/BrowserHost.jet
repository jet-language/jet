    // Rust: crates/jet-devserver/src/BrowserHost.rs:1138
    pub fn navigate_source(self, placement: BrowserPlacement, panel_id: String, node_id: String, grant: BrowserSourceGrant) -> BrowserHostEffect BrowserHostError! {
        _ :: self.validate_grant_context(panel_id, node_id, grant.session_id, grant.revision) ?? return .Err(err)
