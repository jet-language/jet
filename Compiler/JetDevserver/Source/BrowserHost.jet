// PORT-PENDING 0755 crates-jet-devserver-src-browserhost: crates/jet-devserver/src/BrowserHost.rs:1-1652
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! Typed browser-host projection for the shared `jet.devtools.v1` session.
//RS //!
//RS //! `Session` owns protocol decoding and supplies [`BrowserHostEvent`] values to
//RS //! this module.  This module deliberately has no wire decoder, renderer, or
//RS //! browser runtime.  It keeps the two browser placements on one state machine,
//RS //! retains a bounded reconnect history, and accepts source/action requests only
//RS //! when their typed grants still belong to the current session and revision.
//RS 
//RS use std::collections::{BTreeMap, BTreeSet, VecDeque};
//RS use std::fmt;
//RS 
//RS /// The one protocol accepted by every devtools host.
//RS pub const BROWSER_DEVTOOLS_PROTOCOL: &str = "jet.devtools.v1";
//RS /// Compatibility spelling for callers that name the protocol after the wire.
//RS pub const JET_DEVTOOLS_PROTOCOL: &str = BROWSER_DEVTOOLS_PROTOCOL;
//RS 
//RS /// Maximum number of event snapshots retained for a reconnecting browser.
//RS pub const MAX_RECONNECT_EVENTS: usize = 256;
//RS /// Maximum number of panels in one event.
//RS pub const MAX_BROWSER_PANELS: usize = 128;
//RS /// Maximum number of nodes in one event, including descendants.
//RS pub const MAX_BROWSER_NODES: usize = 4096;
//RS /// Maximum nesting depth of a typed node tree.
//RS pub const MAX_BROWSER_NODE_DEPTH: usize = 64;
//RS /// Maximum length of an identity, title, label, or status string.
//RS pub const MAX_BROWSER_TEXT: usize = 256;
//RS /// Maximum length of an explicitly published node value.
//RS pub const MAX_BROWSER_VALUE: usize = 4096;
//RS 
