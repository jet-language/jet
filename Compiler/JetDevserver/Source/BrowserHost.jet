//RS 
//RS /// Errors raised before a browser action or event can change host state.
//RS #[derive(Clone, Debug, Eq, PartialEq)]
//RS pub enum BrowserHostError {
//RS     /// Event failed shape/protocol validation.
//RS     InvalidEvent(String),
//RS     /// An event belongs to another resident session.
//RS     WrongSession { expected: String, received: String },
//RS     /// An event moved backwards in source revision.
//RS     StaleRevision { current: u64, received: u64 },
//RS     /// An event reused or moved backwards in sequence.
//RS     StaleSequence { current: u64, received: u64 },
//RS     /// A reconnect cursor points before retained history.
//RS     CursorExpired { cursor: u64, earliest: u64 },
//RS     /// A reconnect cursor points beyond the current event.
//RS     CursorAhead { cursor: u64, current: u64 },
//RS     /// The requested panel is not in the canonical catalog.
//RS     UnknownPanel(String),
//RS     /// The requested node is not in the canonical panel facts.
//RS     UnknownNode { panel_id: String, node_id: String },
//RS     /// A source/action request carries no matching capability.
//RS     ActionNotGranted(String),
//RS     /// A source target is not safe to open.
//RS     InvalidSource(String),
//RS     /// A generic local action request is malformed.
//RS     InvalidAction(String),
//RS }
//RS 
//RS impl fmt::Display for BrowserHostError {
//RS     fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
//RS         match self {
//RS             Self::InvalidEvent(message) => write!(formatter, "invalid browser event: {message}"),
//RS             Self::WrongSession { expected, received } => write!(
//RS                 formatter,
//RS                 "browser event belongs to session `{received}`, expected `{expected}`"
//RS             ),
//RS             Self::StaleRevision { current, received } => write!(
//RS                 formatter,
//RS                 "stale browser revision {received}; current revision is {current}"
//RS             ),
//RS             Self::StaleSequence { current, received } => write!(
//RS                 formatter,
//RS                 "stale browser sequence {received}; current sequence is {current}"
//RS             ),
//RS             Self::CursorExpired { cursor, earliest } => write!(
//RS                 formatter,
//RS                 "browser reconnect cursor {cursor} predates retained sequence {earliest}"
//RS             ),
//RS             Self::CursorAhead { cursor, current } => write!(
//RS                 formatter,
//RS                 "browser reconnect cursor {cursor} is ahead of current sequence {current}"
//RS             ),
//RS             Self::UnknownPanel(panel_id) => write!(formatter, "unknown browser panel `{panel_id}`"),
//RS             Self::UnknownNode { panel_id, node_id } => write!(
//RS                 formatter,
//RS                 "unknown browser node `{node_id}` in panel `{panel_id}`"
//RS             ),
//RS             Self::ActionNotGranted(message) => write!(formatter, "browser action not granted: {message}"),
//RS             Self::InvalidSource(message) => write!(formatter, "invalid browser source: {message}"),
//RS             Self::InvalidAction(message) => write!(formatter, "invalid browser action: {message}"),
//RS         }
//RS     }
//RS }
//RS 
//RS impl std::error::Error for BrowserHostError {}
