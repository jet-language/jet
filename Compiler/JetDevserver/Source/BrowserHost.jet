    // Rust: crates/jet-devserver/src/BrowserHost.rs:1162
    pub fn invoke_action(self, placement: BrowserPlacement, panel_id: String, node_id: String, action_id: String, grant: BrowserActionGrant) -> BrowserHostEffect BrowserHostError! {
        _ :: self.validate_grant_context(panel_id, node_id, grant.session_id, grant.revision) ?? return .Err(err)
        if grant.panel_id != panel_id || grant.node_id != node_id || grant.action_id != action_id -> return .Err(.ActionNotGranted("action grant does not name the requested panel/node/action"))
        _ :: validate_text(action_id, "action identity", MAX_BROWSER_TEXT) ?? return .Err(.ActionNotGranted(err.to_string()))
        node :: self.require_node(panel_id, node_id) ?? return .Err(err)
        if node.kind != .Action || node.id != action_id -> return .Err(.ActionNotGranted("the requested node is not an explicitly granted Action node"))
        return .ActionInvoked { placement: placement, panel_id: panel_id.to_string(), node_id: node_id.to_string(), action_id: action_id.to_string() }
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1193
    pub fn view_model(self, placement: BrowserPlacement) -> BrowserHtmlViewModel {
        keys := self.panels.keys().collect[[String]]()
        &keys.sort()
        panels := keys.iter().map((key) -> {
            panel :: self.panels[key]
            BrowserPanelView { panel_id: ~panel.fact.panel_id, title: ~panel.fact.title, freshness_ms: panel.fact.freshness_ms, status: ~panel.fact.status, cursor: panel.fact.cursor, open: panel.layout[placement.index()].open, dock: panel.layout[placement.index()].dock, nodes: ~panel.fact.nodes }
        }).collect[[BrowserPanelView]]()
        catalog :: descriptors()
        ranks := [String:USize]{}
        loop (index, descriptor) in catalog.iter().enumerate() {
            if !ranks.contains(descriptor.id.as_str()) -> &ranks.insert(descriptor.id.as_str(), index)
        }
        &panels.sort_by_key((panel) -> ranks.get(panel.panel_id) ?? USize.MAX)
        elements := [BrowserHtmlElement {
            id: "jet-devtools-{placement.as_str()}", kind: "host", panel_id: None, node_id: None,
            label: self.state.as_str(), value: self.sequence.map((sequence) -> sequence.to_string()), status: .Val(self.state.as_str())
        }]
        loop panel in panels {
            &elements.push(BrowserHtmlElement { id: element_id(placement, panel.panel_id, None), kind: "panel", panel_id: .Val(~panel.panel_id), node_id: None, label: ~panel.title, value: None, status: .Val(~panel.status) })
            flatten_nodes(placement, panel.panel_id, panel.nodes, &elements)
        }
        return BrowserHtmlViewModel {
            placement: placement, route: if placement == { .InApp -> "/__jet_devtools", .Workbench -> "/__jet_devtools/workbench" },
            protocol: BROWSER_DEVTOOLS_PROTOCOL, session_id: ~self.session_id, revision: self.revision, sequence: self.sequence,
            cursor: self.cursor, state: self.state, selection: ~self.selection, panels: ^panels, elements: ^elements
        }
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1260
    fn require_panel(&self, panel_id: String) -> &PanelState BrowserHostError! {
        self.panels.get_mut(panel_id) ?? return .Err(.UnknownPanel(panel_id.to_string()))
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1266
    fn require_node(self, panel_id: String, node_id: String) -> BrowserNode BrowserHostError! {
        panel :: self.panels.get(panel_id) ?? return .Err(.UnknownPanel(panel_id.to_string()))
        find_node(panel.fact.nodes, node_id) ?? return .Err(.UnknownNode { panel_id: panel_id.to_string(), node_id: node_id.to_string() })
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1277
    fn node_exists(self, panel_id: String, node_id: String?) -> Bool {
        if node_id == { .Val(id) -> self.require_node(panel_id, id).is_ok(), None -> self.panels.contains(panel_id) }
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1284
    fn validate_grant_context(self, panel_id: String, node_id: String, grant_session: String, grant_revision: U64) -> () BrowserHostError! {
        current_revision :: self.revision ?? return .Err(.ActionNotGranted("no canonical event has established a current revision"))
        if grant_session != self.session_id -> return .Err(.WrongSession { expected: ~self.session_id, received: grant_session.to_string() })
        if grant_revision != current_revision -> return .Err(.StaleRevision { current: current_revision, received: grant_revision })
        _ :: self.require_node(panel_id, node_id) ?? return .Err(err)
    }
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1314
    pub fn default() -> BrowserHost { BrowserHost.new("") }
}
// Rust: crates/jet-devserver/src/BrowserHost.rs:1319
fn validate_panel(panel: BrowserPanelFact, node_count: &USize) -> () BrowserHostError! {
    _ :: validate_text(panel.panel_id, "panel identity", MAX_BROWSER_TEXT) ?? return .Err(err)
    _ :: validate_text(panel.title, "panel title", MAX_BROWSER_TEXT) ?? return .Err(err)
    _ :: validate_text(panel.status, "panel status", MAX_BROWSER_TEXT) ?? return .Err(err)
    node_ids := [String:Bool]{}
    loop node in panel.nodes { _ :: validate_node(node, 0, node_count, &node_ids) ?? return .Err(err) }
}
// Rust: crates/jet-devserver/src/BrowserHost.rs:1330
fn validate_node(node: BrowserNode, depth: USize, node_count: &USize, node_ids: &[String:Bool]) -> () BrowserHostError! {
    if depth > MAX_BROWSER_NODE_DEPTH -> return .Err(.InvalidEvent("browser node tree exceeds the depth bound"))
    node_count = node_count.saturating_add(1)
    if node_count > MAX_BROWSER_NODES -> return .Err(.InvalidEvent("browser event exceeds the node bound"))
    _ :: validate_text(node.id, "node identity", MAX_BROWSER_TEXT) ?? return .Err(err)
    _ :: validate_text(node.label, "node label", MAX_BROWSER_TEXT) ?? return .Err(err)
    if node.value == .Val(value) -> _ :: validate_text(value, "node value", MAX_BROWSER_VALUE) ?? return .Err(err)
    if node.status == .Val(status) -> _ :: validate_text(status, "node status", MAX_BROWSER_TEXT) ?? return .Err(err)
    if node_ids.contains(node.id) -> return .Err(.InvalidEvent("browser panel repeats node `{node.id}`"))
    &node_ids.insert(node.id, true)
    loop child in node.children { _ :: validate_node(child, depth + 1, node_count, node_ids) ?? return .Err(err) }
}
// Rust: crates/jet-devserver/src/BrowserHost.rs:1367
fn validate_text(value: String, label: String, limit: USize) -> () BrowserHostError! {
    if value.is_empty() || value.len() > limit || value.chars().any((c) -> c.is_control()) -> return .Err(.InvalidEvent("{label} is empty, too long, or contains control text"))
}
// Rust: crates/jet-devserver/src/BrowserHost.rs:1376
fn validate_source_id(source_id: String) -> () BrowserHostError! {
    if source_id.is_empty() || source_id.len() > MAX_BROWSER_TEXT || source_id.chars().any((c) -> c.is_control()) || source_id.starts_with('/') || source_id.starts_with('\\') || source_id.contains('\\') || source_id.split('/').any((part) -> part == ".." || part.is_empty()) || source_id.contains("://") -> return .Err(.InvalidSource("source identity must be a non-empty project-relative path"))
}
// Rust: crates/jet-devserver/src/BrowserHost.rs:1393
fn derive_session_state(panels: [BrowserPanelFact]) -> BrowserSessionState {
    state := BrowserSessionState.Idle
    loop panel in panels {
        value := panel.status.trim() // #4303
        value = value.to_ascii_lowercase()
        candidate :: if value == {
            "building" -> .Building,
            "build_failed" | "build-failed" | "build failed" -> .BuildFailed,
            "runtime_failure" | "runtime-failure" | "runtime failure" -> .RuntimeFailure,
            "hot_reload" | "hot-reload" | "hot reload" -> .HotReload,
            "tests_failing" | "tests-failing" | "tests failing" -> .TestsFailing,
            else -> next
        }
        state = prefer_state(state, candidate)
    }
    return state
}
// Rust: crates/jet-devserver/src/BrowserHost.rs:1414
fn prefer_state(current: BrowserSessionState, candidate: BrowserSessionState) -> BrowserSessionState {
    // Rust: crates/jet-devserver/src/BrowserHost.rs:1415
    fn rank(state: BrowserSessionState) -> U8 {
        if state == { .Idle -> 0, .HotReload -> 1, .Building -> 2, .TestsFailing -> 3, .RuntimeFailure -> 4, .BuildFailed -> 5 }
    }
    if rank(candidate) >= rank(current) -> candidate else -> current
}
// Rust: crates/jet-devserver/src/BrowserHost.rs:1432
fn find_node(nodes: [BrowserNode], node_id: String) -> BrowserNode? {
    loop node in nodes {
        if node.id == node_id -> return .Val(node)
        if find_node(node.children, node_id) == .Val(found) -> return .Val(found)
    }
    return None
}
// Rust: crates/jet-devserver/src/BrowserHost.rs:1442
fn element_id(placement: BrowserPlacement, panel_id: String, node_id: String?) -> String {
    id := "jet-devtools-{placement.as_str()}-panel-{stable_fragment(panel_id)}"
    if node_id == .Val(node_id) { &id.push_str("-node-"); &id.push_str(stable_fragment(node_id)) }
    return id
}
// Rust: crates/jet-devserver/src/BrowserHost.rs:1455
fn stable_fragment(value: String) -> String {
    output := String.with_capacity(value.len())
    loop character in value.chars() { &output.push(if character.is_ascii_alphanumeric() || character == '_' || character == '-' -> character else -> '-') }
    if output.is_empty() -> "item" else -> output
}
// Rust: crates/jet-devserver/src/BrowserHost.rs:1471
fn flatten_nodes(placement: BrowserPlacement, panel_id: String, nodes: [BrowserNode], elements: &[BrowserHtmlElement]) -> {
    loop node in nodes {
        &elements.push(BrowserHtmlElement { id: element_id(placement, panel_id, .Val(node.id)), kind: node.kind.as_str(), panel_id: .Val(panel_id.to_string()), node_id: .Val(~node.id), label: ~node.label, value: ~node.value, status: ~node.status })
        flatten_nodes(placement, panel_id, node.children, elements)
    }
}
