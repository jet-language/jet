// Typed projection of the shared session; no wire decoder or renderer lives here.
use jet_foundation.[jettrace_has_control]

BROWSER_DEVTOOLS_PROTOCOL: String{"jet.devtools.v1"}
MAX_RECONNECT_EVENTS: Int{256}
MAX_BROWSER_PANELS: Int{128}
MAX_BROWSER_NODES: Int{4096}
MAX_BROWSER_NODE_DEPTH: Int{64}
MAX_BROWSER_TEXT: Int{256}
MAX_BROWSER_VALUE: Int{4096}
// Panels outside the canonical catalog sort after every catalog panel.
BROWSER_UNLISTED_PANEL_RANK: Int{9223372036854775807}

BrowserPlacement: enum {
    InApp Workbench

    as_str: fn(self) -> String {
        if self == {
            .InApp -> "in-app"
            .Workbench -> "workbench"
        }
    }
    index: fn(self) -> Int {
        if self == {
            .InApp -> 0
            .Workbench -> 1
        }
    }
    route: fn(self) -> String {
        if self == {
            .InApp -> "/__jet_devtools"
            .Workbench -> "/__jet_devtools/workbench"
        }
    }
}
impl DevtoolsNodeKind {
    as_str: fn(self) -> String {
        if self == {
            .Text -> "text"
            .Status -> "status"
            .Table -> "table"
            .Tree -> "tree"
            .Chart -> "chart"
            .Action -> "action"
        }
    }
}

impl DevtoolsDock {
    as_str: fn(self) -> String {
        if self == {
            .Floating -> "floating"
            .Left -> "left"
            .Right -> "right"
            .Top -> "top"
            .Bottom -> "bottom"
        }
    }
}

impl BrowserSessionState {
    as_str: fn(self) -> String {
        if self == {
            .Idle -> "idle"
            .Building -> "building"
            .BuildFailed -> "build-failed"
            .RuntimeFailure -> "runtime-failure"
            .HotReload -> "hot-reload"
            .TestsFailing -> "tests-failing"
        }
    }
    // Higher ranks win when panels report several states at once.
    rank: fn(self) -> Int {
        if self == {
            .Idle -> 0
            .HotReload -> 1
            .Building -> 2
            .TestsFailing -> 3
            .RuntimeFailure -> 4
            .BuildFailed -> 5
        }
    }
}

BrowserSourceLocation: struct {
    source_id: String
    line: Int
    column: Int
    function: String?

    validate: fn(self) BrowserHostError! {
        validate_source_id(self.source_id)
        if self.line < 1 -> return Err(BrowserHostError.InvalidSource{message: "source line must be one-based"})
        if self.function == .Val(function) -> validate_browser_text(function, "source function", MAX_BROWSER_TEXT)
    }
}
// Source navigation is granted for one session revision, panel and node.
BrowserSourceGrant: struct { session_id: String, revision: Int, panel_id: String, node_id: String, source: BrowserSourceLocation }
// Action invocation is granted for one session revision, panel, node and action.
BrowserActionGrant: struct { session_id: String, revision: Int, panel_id: String, node_id: String, action_id: String }

BrowserNode: struct {
    id: String
    kind: DevtoolsNodeKind
    label: String
    value: String?
    status: String?
    children: [BrowserNode]

    new: fn(id: String, kind: DevtoolsNodeKind, label: String) -> BrowserNode {
        BrowserNode{id: id, kind: kind, label: label, value: None, status: None, children: [BrowserNode]{}}
    }
    with_value: fn(self, value: String) -> BrowserNode {
        node := self
        node.value = Val(value)
        node
    }
    with_status: fn(self, status: String) -> BrowserNode {
        node := self
        node.status = Val(status)
        node
    }
    with_children: fn(self, children: [BrowserNode]) -> BrowserNode {
        node := self
        node.children = children
        node
    }
}
BrowserPanelFact: struct {
    panel_id: String
    title: String
    freshness_ms: Int
    status: String
    cursor: Int?
    nodes: [BrowserNode]

    new: fn(panel_id: String, title: String, freshness_ms: Int, status: String, nodes: [BrowserNode]) -> BrowserPanelFact {
        BrowserPanelFact{panel_id: panel_id, title: title, freshness_ms: freshness_ms, status: status, cursor: None, nodes: nodes}
    }
    with_cursor: fn(self, cursor: Int?) -> BrowserPanelFact {
        panel := self
        panel.cursor = cursor
        panel
    }
}
BrowserHostEvent: struct {
    protocol: String
    session_id: String
    revision: Int
    sequence: Int
    observed_at_ms: Int
    panels: [BrowserPanelFact]

    new: fn(session_id: String, revision: Int, sequence: Int, observed_at_ms: Int, panels: [BrowserPanelFact]) -> BrowserHostEvent {
        BrowserHostEvent{protocol: BROWSER_DEVTOOLS_PROTOCOL, session_id: session_id, revision: revision, sequence: sequence, observed_at_ms: observed_at_ms, panels: panels}
    }
    validate: fn(self) BrowserHostError! {
        if self.protocol != BROWSER_DEVTOOLS_PROTOCOL -> return Err(BrowserHostError.InvalidEvent{message: "browser event protocol does not match jet.devtools.v1"})
        validate_browser_text(self.session_id, "event session", MAX_BROWSER_TEXT)
        if self.panels.len() > MAX_BROWSER_PANELS -> return Err(BrowserHostError.InvalidEvent{message: "browser event exceeds the panel bound"})
        panel_ids := [String: Bool]{}
        node_count := 0
        loop panel in self.panels {
            validate_browser_panel(panel, node_count)
            if panel_ids.get(panel.panel_id) != None -> return Err(BrowserHostError.InvalidEvent{message: "browser event repeats panel `{panel.panel_id}`"})
            panel_ids[panel.panel_id] = true
        }
    }
}
BrowserReconnectCursor: struct { sequence: Int }
BrowserReconnect: struct {
    session_id: String
    from: BrowserReconnectCursor?
    cursor: BrowserReconnectCursor?
    events: [BrowserHostEvent]
    complete: Bool
}
BrowserSelection: struct { panel_id: String, node_id: String? }

BrowserHostAction: enum {
    OpenPanel(placement: BrowserPlacement, panel_id: String)
    ClosePanel(placement: BrowserPlacement, panel_id: String)
    DockPanel(placement: BrowserPlacement, panel_id: String, dock: DevtoolsDock)
    NavigateSource(placement: BrowserPlacement, panel_id: String, node_id: String, grant: BrowserSourceGrant)
    InvokeAction(placement: BrowserPlacement, panel_id: String, node_id: String, action_id: String, grant: BrowserActionGrant)
}
BrowserHostEffect: enum {
    PanelOpened(placement: BrowserPlacement, panel_id: String)
    PanelClosed(placement: BrowserPlacement, panel_id: String)
    PanelDocked(placement: BrowserPlacement, panel_id: String, dock: DevtoolsDock)
    SourceNavigated(placement: BrowserPlacement, panel_id: String, node_id: String, source: BrowserSourceLocation)
    ActionInvoked(placement: BrowserPlacement, panel_id: String, node_id: String, action_id: String)
}

BrowserHTMLElement: struct {
    id: String
    kind: String
    panel_id: String?
    node_id: String?
    label: String
    value: String?
    status: String?
}
BrowserHTMLViewModel: struct {
    placement: BrowserPlacement
    route: String
    protocol: String
    session_id: String
    revision: Int?
    sequence: Int?
    cursor: BrowserReconnectCursor?
    state: BrowserSessionState
    selection: BrowserSelection?
    panels: [BrowserPanelView]
    elements: [BrowserHTMLElement]
}
BrowserPanelView: struct {
    panel_id: String
    title: String
    freshness_ms: Int
    status: String
    cursor: Int?
    open: Bool
    dock: DevtoolsDock
    nodes: [BrowserNode]
}

#Error
BrowserHostError: enum {
    InvalidEvent(message: String)
    WrongSession(expected: String, received: String)
    StaleRevision(current: Int, received: Int)
    StaleSequence(current: Int, received: Int)
    CursorExpired(cursor: Int, earliest: Int)
    CursorAhead(cursor: Int, current: Int)
    UnknownPanel(panel_id: String)
    UnknownNode(panel_id: String, node_id: String)
    ActionNotGranted(message: String)
    InvalidSource(message: String)
    InvalidAction(message: String)

    message: fn(self) -> String {
        if self == {
            .InvalidEvent(message) -> "invalid browser event: {message}"
            .WrongSession(expected, received) -> "browser event belongs to session `{received}`, expected `{expected}`"
            .StaleRevision(current, received) -> "stale browser revision {received}; current revision is {current}"
            .StaleSequence(current, received) -> "stale browser sequence {received}; current sequence is {current}"
            .CursorExpired(cursor, earliest) -> "browser reconnect cursor {cursor} predates retained sequence {earliest}"
            .CursorAhead(cursor, current) -> "browser reconnect cursor {cursor} is ahead of current sequence {current}"
            .UnknownPanel(panel_id) -> "unknown browser panel `{panel_id}`"
            .UnknownNode(panel_id, node_id) -> "unknown browser node `{node_id}` in panel `{panel_id}`"
            .ActionNotGranted(message) -> "browser action not granted: {message}"
            .InvalidSource(message) -> "invalid browser source: {message}"
            .InvalidAction(message) -> "invalid browser action: {message}"
        }
    }

    impl Display { display: fn(self) -> String { self.message() } }
}
// Layout is indexed by BrowserPlacement.index(): in-app, then workbench.
BrowserPanelLayout: struct { open: Bool, dock: DevtoolsDock }
BrowserPanelState: struct { fact: BrowserPanelFact, layout: [BrowserPanelLayout] }

BrowserHost: struct {
    session_id: String
    revision: Int?
    sequence: Int?
    observed_at_ms: Int?
    state: BrowserSessionState
    cursor: BrowserReconnectCursor?
    selection: BrowserSelection?
    panels: [String: BrowserPanelState]
    // Oldest first; bounded by MAX_RECONNECT_EVENTS.
    history: [BrowserHostEvent]

    new: fn(session_id: String) -> BrowserHost {
        BrowserHost{session_id: session_id, revision: None, sequence: None, observed_at_ms: None, state: .Idle, cursor: None, selection: None, panels: [String: BrowserPanelState]{}, history: [BrowserHostEvent]{}}
    }
    apply_event: fn(&self, &&event: BrowserHostEvent) BrowserHostError! {
        event.validate()
        if event.session_id != self.session_id -> return Err(BrowserHostError.WrongSession{expected: self.session_id, received: event.session_id})
        if self.revision == .Val(current) {
            if event.revision < current -> return Err(BrowserHostError.StaleRevision{current: current, received: event.revision})
        }
        if self.sequence == .Val(current) {
            if event.sequence <= current -> return Err(BrowserHostError.StaleSequence{current: current, received: event.sequence})
        }
        // Panels absent from the event are dropped; present panels keep their layout.
        panels := [String: BrowserPanelState]{}
        loop index in 0..<event.panels.len() {
            fact: event.panels[index]
            layout := [BrowserPanelLayout]{}
            if self.panels.get(fact.panel_id) == .Val(previous) {
                layout = previous.layout
            } else {
                layout.push(BrowserPanelLayout{open: false, dock: .Left})
                layout.push(BrowserPanelLayout{open: false, dock: .Left})
            }
            key: "{fact.panel_id}"
            panels[key] = BrowserPanelState{fact: fact, layout: layout}
        }
        self.panels = panels
        self.revision = Val(event.revision)
        self.sequence = Val(event.sequence)
        self.observed_at_ms = Val(event.observed_at_ms)
        self.state = derive_browser_session_state(event.panels)
        self.cursor = Val(BrowserReconnectCursor{sequence: event.sequence})
        if self.selection == .Val(selection) {
            if !self.node_exists(selection.panel_id, selection.node_id) -> self.selection = None
        }
        if self.history.len() >= MAX_RECONNECT_EVENTS {
            first: self.history.len() - MAX_RECONNECT_EVENTS + 1
            self.history = loop index in first..<self.history.len() -> self.history[index]
        }
        self.history.push(event.move())
    }
    resume_from: fn(self, cursor: BrowserReconnectCursor?) -> BrowserReconnect BrowserHostError! {
        if cursor == .Val(requested) {
            if self.sequence == .Val(current) {
                if requested.sequence > current -> return Err(BrowserHostError.CursorAhead{cursor: requested.sequence, current: current})
            }
            if self.history.len() > 0 {
                earliest: self.history[0].sequence
                if requested.sequence + 1 < earliest -> return Err(BrowserHostError.CursorExpired{cursor: requested.sequence, earliest: earliest})
            } else if requested.sequence > 0 {
                return Err(BrowserHostError.CursorExpired{cursor: requested.sequence, earliest: 0})
            }
        }
        events := [BrowserHostEvent]{}
        loop index in 0..<self.history.len() {
            if cursor == .Val(from) {
                if self.history[index].sequence <= from.sequence -> next
            }
            events.push(self.history[index])
        }
        latest := BrowserReconnectCursor?{None}
        if self.sequence == .Val(sequence) -> latest = Val(BrowserReconnectCursor{sequence: sequence})
        BrowserReconnect{session_id: self.session_id, from: cursor, cursor: latest, events: events, complete: true}
    }
    panel: fn(self, panel_id: String) -> BrowserPanelFact? {
        panel: self.panels.get(panel_id) ?? return None
        Val(panel.fact)
    }
    select: fn(&self, panel_id: String, node_id: String?) BrowserHostError! {
        if self.panels.get(panel_id) == None -> return Err(BrowserHostError.UnknownPanel{panel_id: panel_id})
        if node_id == .Val(id) -> _: self.require_node(panel_id, id)
        self.selection = Val(BrowserSelection{panel_id: panel_id, node_id: node_id})
    }
    clear_selection: fn(&self) { self.selection = None }
    dispatch: fn(&self, action: BrowserHostAction) -> BrowserHostEffect BrowserHostError! {
        if action == {
            .OpenPanel(placement, panel_id) -> self.set_panel_open(placement, panel_id, true)
            .ClosePanel(placement, panel_id) -> self.set_panel_open(placement, panel_id, false)
            .DockPanel(placement, panel_id, dock) -> self.dock_panel(placement, panel_id, dock)
            .NavigateSource(placement, panel_id, node_id, grant) -> self.navigate_source(placement, panel_id, node_id, grant)
            .InvokeAction(placement, panel_id, node_id, action_id, grant) -> self.invoke_action(placement, panel_id, node_id, action_id, grant)
        }
    }
    set_panel_open: fn(&self, placement: BrowserPlacement, panel_id: String, open: Bool) -> BrowserHostEffect BrowserHostError! {
        panel := self.panels.get(panel_id) ?? return Err(BrowserHostError.UnknownPanel{panel_id: panel_id})
        panel.layout[placement.index()].open = open
        self.panels[panel_id] = panel
        if open -> return BrowserHostEffect.PanelOpened{placement: placement, panel_id: panel_id}
        if self.selection == .Val(selection) {
            if selection.panel_id == panel_id -> self.selection = None
        }
        BrowserHostEffect.PanelClosed{placement: placement, panel_id: panel_id}
    }
    dock_panel: fn(&self, placement: BrowserPlacement, panel_id: String, dock: DevtoolsDock) -> BrowserHostEffect BrowserHostError! {
        panel := self.panels.get(panel_id) ?? return Err(BrowserHostError.UnknownPanel{panel_id: panel_id})
        panel.layout[placement.index()].dock = dock
        self.panels[panel_id] = panel
        BrowserHostEffect.PanelDocked{placement: placement, panel_id: panel_id, dock: dock}
    }
    navigate_source: fn(self, placement: BrowserPlacement, panel_id: String, node_id: String, grant: BrowserSourceGrant) -> BrowserHostEffect BrowserHostError! {
        self.validate_grant_context(panel_id, node_id, grant.session_id, grant.revision)
        if grant.panel_id != panel_id || grant.node_id != node_id -> return Err(BrowserHostError.ActionNotGranted{message: "source grant does not name the requested panel/node"})
        grant.source.validate()
        BrowserHostEffect.SourceNavigated{placement: placement, panel_id: panel_id, node_id: node_id, source: grant.source}
    }
    invoke_action: fn(self, placement: BrowserPlacement, panel_id: String, node_id: String, action_id: String, grant: BrowserActionGrant) -> BrowserHostEffect BrowserHostError! {
        self.validate_grant_context(panel_id, node_id, grant.session_id, grant.revision)
        if grant.panel_id != panel_id || grant.node_id != node_id || grant.action_id != action_id {
            return Err(BrowserHostError.ActionNotGranted{message: "action grant does not name the requested panel/node/action"})
        }
        _: validate_browser_text(action_id, "action identity", MAX_BROWSER_TEXT) ?? return Err(BrowserHostError.ActionNotGranted{message: err.message()})
        node: self.require_node(panel_id, node_id)
        if node.kind != .Action || node.id != action_id -> return Err(BrowserHostError.ActionNotGranted{message: "the requested node is not an explicitly granted Action node"})
        BrowserHostEffect.ActionInvoked{placement: placement, panel_id: panel_id, node_id: node_id, action_id: action_id}
    }
    view_model: fn(self, placement: BrowserPlacement) -> BrowserHTMLViewModel {
        keys := self.panels.keys().to_list()
        keys.sort()
        views := [BrowserPanelView]{}
        loop key in keys {
            panel: self.panels[key]
            layout: panel.layout[placement.index()]
            views.push(BrowserPanelView{panel_id: panel.fact.panel_id, title: panel.fact.title, freshness_ms: panel.fact.freshness_ms, status: panel.fact.status, cursor: panel.fact.cursor, open: layout.open, dock: layout.dock, nodes: panel.fact.nodes})
        }
        ranks: browser_catalog_ranks()
        views.sort_by(fn(left, right) { browser_panel_rank(ranks, left.panel_id) <=> browser_panel_rank(ranks, right.panel_id) })
        sequence_text := String?{None}
        if self.sequence == .Val(sequence) -> sequence_text = Val("{sequence}")
        elements := [BrowserHTMLElement]{}
        elements.push(BrowserHTMLElement{id: "jet-devtools-{placement.as_str()}", kind: "host", panel_id: None, node_id: None, label: self.state.as_str(), value: sequence_text, status: Val(self.state.as_str())})
        loop view in views {
            elements.push(BrowserHTMLElement{id: browser_element_id(placement, view.panel_id, None), kind: "panel", panel_id: Val(view.panel_id), node_id: None, label: view.title, value: None, status: Val(view.status)})
            flatten_browser_nodes(placement, view.panel_id, view.nodes, elements)
        }
        BrowserHTMLViewModel{
            placement: placement, route: placement.route(), protocol: BROWSER_DEVTOOLS_PROTOCOL, session_id: self.session_id,
            revision: self.revision, sequence: self.sequence, cursor: self.cursor, state: self.state, selection: self.selection,
            panels: views, elements: elements,
        }
    }
    require_node: fn(self, panel_id: String, node_id: String) -> BrowserNode BrowserHostError! {
        panel: self.panels.get(panel_id) ?? return Err(BrowserHostError.UnknownPanel{panel_id: panel_id})
        node: find_browser_node(panel.fact.nodes, node_id) ?? return Err(BrowserHostError.UnknownNode{panel_id: panel_id, node_id: node_id})
        Ok(node)
    }
    node_exists: fn(self, panel_id: String, node_id: String?) -> Bool {
        panel: self.panels.get(panel_id) ?? return false
        if node_id == .Val(id) -> return find_browser_node(panel.fact.nodes, id) != None
        true
    }
    validate_grant_context: fn(self, panel_id: String, node_id: String, grant_session: String, grant_revision: Int) BrowserHostError! {
        current_revision: self.revision ?? return Err(BrowserHostError.ActionNotGranted{message: "no canonical event has established a current revision"})
        if grant_session != self.session_id -> return Err(BrowserHostError.WrongSession{expected: self.session_id, received: grant_session})
        if grant_revision != current_revision -> return Err(BrowserHostError.StaleRevision{current: current_revision, received: grant_revision})
        _: self.require_node(panel_id, node_id)
    }
}
// Catalog position of each canonical panel; the first listing of an id wins.
browser_catalog_ranks: fn() -> [String: Int] {
    ranks := [String: Int]{}
    index := 0
    loop descriptor in descriptors() {
        id: descriptor.id.as_str()
        if ranks.get(id) == None -> ranks[id] = index
        index += 1
    }
    ranks
}
browser_panel_rank: fn(ranks: [String: Int], panel_id: String) -> Int { ranks.get(panel_id) ?? BROWSER_UNLISTED_PANEL_RANK }

validate_browser_panel: fn(panel: BrowserPanelFact, node_count: &Int) BrowserHostError! {
    validate_browser_text(panel.panel_id, "panel identity", MAX_BROWSER_TEXT)
    validate_browser_text(panel.title, "panel title", MAX_BROWSER_TEXT)
    validate_browser_text(panel.status, "panel status", MAX_BROWSER_TEXT)
    node_ids := [String: Bool]{}
    loop node in panel.nodes -> validate_browser_node(node, 0, node_count, node_ids)
}
validate_browser_node: fn(node: BrowserNode, depth: Int, node_count: &Int, node_ids: &[String: Bool]) BrowserHostError! {
    if depth > MAX_BROWSER_NODE_DEPTH -> return Err(BrowserHostError.InvalidEvent{message: "browser node tree exceeds the depth bound"})
    node_count += 1
    if node_count > MAX_BROWSER_NODES -> return Err(BrowserHostError.InvalidEvent{message: "browser event exceeds the node bound"})
    validate_browser_text(node.id, "node identity", MAX_BROWSER_TEXT)
    validate_browser_text(node.label, "node label", MAX_BROWSER_TEXT)
    if node.value == .Val(value) -> validate_browser_text(value, "node value", MAX_BROWSER_VALUE)
    if node.status == .Val(status) -> validate_browser_text(status, "node status", MAX_BROWSER_TEXT)
    if node_ids.get(node.id) != None -> return Err(BrowserHostError.InvalidEvent{message: "browser panel repeats node `{node.id}`"})
    node_ids[node.id] = true
    loop child in node.children -> validate_browser_node(child, depth + 1, node_count, node_ids)
}
validate_browser_text: fn(value: String, label: String, limit: Int) BrowserHostError! {
    if value == "" || value.bytes().len() > limit || jettrace_has_control(value) {
        return Err(BrowserHostError.InvalidEvent{message: "{label} is empty, too long, or contains control text"})
    }
}
// A source identity is a non-empty project-relative path with no empty or `..` segment.
validate_source_id: fn(source_id: String) BrowserHostError! {
    invalid: BrowserHostError.InvalidSource{message: "source identity must be a non-empty project-relative path"}
    if source_id == "" || source_id.bytes().len() > MAX_BROWSER_TEXT || jettrace_has_control(source_id) -> return Err(invalid)
    if source_id.starts_with("/") || source_id.contains("\\") || source_id.contains("://") -> return Err(invalid)
    loop part in source_id.split("/").to_list() {
        if part == "" || part == ".." -> return Err(invalid)
    }
}

derive_browser_session_state: fn(panels: [BrowserPanelFact]) -> BrowserSessionState {
    state := BrowserSessionState.Idle
    loop panel in panels {
        value: panel.status.trim().to_ascii_lower()
        candidate: if value == {
            "building" -> BrowserSessionState.Building
            "build_failed" | "build-failed" | "build failed" -> BrowserSessionState.BuildFailed
            "runtime_failure" | "runtime-failure" | "runtime failure" -> BrowserSessionState.RuntimeFailure
            "hot_reload" | "hot-reload" | "hot reload" -> BrowserSessionState.HotReload
            "tests_failing" | "tests-failing" | "tests failing" -> BrowserSessionState.TestsFailing
            else -> next
        }
        if candidate.rank() >= state.rank() -> state = candidate
    }
    state
}

find_browser_node: fn(nodes: [BrowserNode], node_id: String) -> BrowserNode? {
    loop node in nodes {
        if node.id == node_id -> return Val(node)
        if find_browser_node(node.children, node_id) == .Val(found) -> return Val(found)
    }
    None
}

browser_element_id: fn(placement: BrowserPlacement, panel_id: String, node_id: String?) -> String {
    id: "jet-devtools-{placement.as_str()}-panel-{browser_stable_fragment(panel_id)}"
    if node_id == .Val(node) -> return "{id}-node-{browser_stable_fragment(node)}"
    id
}
// ASCII letters, digits, `_` and `-` survive; every other character becomes one `-`.
browser_stable_fragment: fn(value: String) -> String {
    out := [U8]{}
    loop byte in value.bytes() {
        // UTF-8 continuation bytes belong to the character already replaced.
        if byte >= 128 && byte <= 191 -> next
        keep: (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte == 45
        out.push(if keep -> byte else -> 45)
    }
    if out.len() == 0 -> return "item"
    String.from_bytes(out) ?? "item"
}
flatten_browser_nodes: fn(placement: BrowserPlacement, panel_id: String, nodes: [BrowserNode], elements: &[BrowserHTMLElement]) {
    loop node in nodes {
        elements.push(BrowserHTMLElement{id: browser_element_id(placement, panel_id, Val(node.id)), kind: node.kind.as_str(), panel_id: Val(panel_id), node_id: Val(node.id), label: node.label, value: node.value, status: node.status})
        flatten_browser_nodes(placement, panel_id, node.children, elements)
    }
}
