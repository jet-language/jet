// Backend-neutral facts and compare-and-commit transaction state for a resident native swap.
// No method waits for quiescence or performs linker, socket, scheduler or OS operations.
// Producers supply checked semantic, relocation, link and quiescence facts before pause.

NATIVE_SWAP_PROTOCOL: String{"jet.native.swap.v1"}
MAX_NATIVE_SWAP_ID_BYTES: Int{256}
MAX_NATIVE_SWAP_DETAIL_BYTES: Int{1024}
MAX_NATIVE_SWAP_FACTS: Int{1024}

NativeSwapSourceIdentity: struct {
    source_id: String
    module_ref: String

    new: fn(source_id: String) -> NativeSwapSourceIdentity NativeSwapError! {
        NativeSwapSourceIdentity.new_with_module(source_id, source_id)
    }
    new_with_module: fn(source_id: String, module_ref: String) -> NativeSwapSourceIdentity NativeSwapError! {
        _: native_swap_validate_identity(source_id, "source identity") ?? return Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        _: native_swap_validate_identity(module_ref, "module identity") ?? return Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        NativeSwapSourceIdentity{source_id: source_id, module_ref: module_ref}
    }
    canonical: fn(self) -> String {
        if self.source_id == self.module_ref -> self.source_id else -> "{self.source_id}::{self.module_ref}"
    }
    matches: fn(self, other: NativeSwapSourceIdentity) -> Bool {
        self.source_id == other.source_id && self.module_ref == other.module_ref
    }

    impl Display { display: fn(self) -> String { self.canonical() } }
}
NativeSwapCodeRevision: struct {
    value: String

    new: fn(value: String) -> NativeSwapCodeRevision NativeSwapError! {
        _: native_swap_validate_revision(value, "code revision") ?? return Err(NativeSwapError.input(value, .InvalidRevision, err))
        NativeSwapCodeRevision{value: value}
    }
    as_str: fn(self) -> String { self.value }

    impl Display { display: fn(self) -> String { self.value } }
}
NativeSwapDataRevision: struct {
    value: String

    new: fn(value: String) -> NativeSwapDataRevision NativeSwapError! {
        _: native_swap_validate_revision(value, "data revision") ?? return Err(NativeSwapError.input(value, .InvalidRevision, err))
        NativeSwapDataRevision{value: value}
    }
    as_str: fn(self) -> String { self.value }

    impl Display { display: fn(self) -> String { self.value } }
}
NativeSwapRevision: struct {
    code: NativeSwapCodeRevision
    data: NativeSwapDataRevision

    new: fn(code: String, data: String) -> NativeSwapRevision NativeSwapError! {
        NativeSwapRevision{code: NativeSwapCodeRevision.new(code), data: NativeSwapDataRevision.new(data)}
    }
    code_revision: fn(self) -> String { self.code.value }
    data_revision: fn(self) -> String { self.data.value }
    code_unchanged: fn(self, other: NativeSwapRevision) -> Bool { self.code.value == other.code.value }
    data_unchanged: fn(self, other: NativeSwapRevision) -> Bool { self.data.value == other.data.value }
}
NativeSwapExecutable: struct {
    source: NativeSwapSourceIdentity
    revision: NativeSwapRevision
    generation: U64

    new: fn(source: NativeSwapSourceIdentity, revision: NativeSwapRevision, generation: U64) -> NativeSwapExecutable NativeSwapError! {
        _: native_swap_validate_source_identity(source, "executable") ?? return Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        NativeSwapExecutable{source: source, revision: revision, generation: generation}
    }
    source_id: fn(self) -> String { self.source.canonical() }
    same_as: fn(self, other: NativeSwapExecutable) -> Bool {
        self.source.matches(other.source) && self.revision.code_unchanged(other.revision) && self.revision.data_unchanged(other.revision) && self.generation == other.generation
    }
}
impl NativeSwapCodePolicy {
    as_str: fn(self) -> String {
        if self == {
            .Replace -> "replace"
            .Restart -> "restart"
            .Reject -> "reject"
        }
    }
}
impl NativeSwapDataPolicy {
    as_str: fn(self) -> String {
        if self == {
            .Preserve -> "preserve"
            .Replace -> "replace"
            .Migrate -> "migrate"
            .Restart -> "restart"
            .Reject -> "reject"
        }
    }
}
NativeSwapHandlePolicy: enum {
    Never ExplicitCompatible

    as_str: fn(self) -> String {
        if self == {
            .Never -> "never"
            .ExplicitCompatible -> "explicit_compatible"
        }
    }
}
NativeSwapQuiescencePolicy: enum {
    Required NotRequired

    as_str: fn(self) -> String {
        if self == {
            .Required -> "required"
            .NotRequired -> "not_required"
        }
    }
}
impl NativeSwapRelocationStrategy {
    as_str: fn(self) -> String {
        if self == {
            .StableIdentity -> "stable_identity"
            .RebindByIdentity -> "rebind_by_identity"
            .Restart -> "restart"
            .Reject -> "reject"
        }
    }
    permits_in_place: fn(self) -> Bool { self == .StableIdentity || self == .RebindByIdentity }
}
impl NativeSwapRelocationStrategy.Display { display: fn(self) -> String { self.as_str() } }
impl NativeSwapLinkStrategy {
    as_str: fn(self) -> String {
        if self == {
            .ReuseResident -> "reuse_resident"
            .Relink -> "relink"
            .Restart -> "restart"
            .Reject -> "reject"
        }
    }
    permits_in_place: fn(self) -> Bool { self == .ReuseResident || self == .Relink }
}
impl NativeSwapLinkStrategy.Display { display: fn(self) -> String { self.as_str() } }

NativeSwapRelocationFacts: struct {
    strategy: NativeSwapRelocationStrategy
    code_symbols: [String]
    data_slots: [String]

    new: fn(strategy: NativeSwapRelocationStrategy) -> NativeSwapRelocationFacts {
        NativeSwapRelocationFacts{strategy: strategy, code_symbols: [String]{}, data_slots: [String]{}}
    }
    // Resident code and data keep their identities unless a producer says otherwise.
    stable: fn() -> NativeSwapRelocationFacts { NativeSwapRelocationFacts.new(.StableIdentity) }
}
NativeSwapLinkFacts: struct {
    strategy: NativeSwapLinkStrategy
    resident_identity: String
    candidate_identity: String

    new: fn(strategy: NativeSwapLinkStrategy, resident_identity: String, candidate_identity: String) -> NativeSwapLinkFacts NativeSwapError! {
        _: native_swap_validate_identity(resident_identity, "resident link identity") ?? return Err(NativeSwapError.input(resident_identity, .InvalidIdentity, err))
        _: native_swap_validate_identity(candidate_identity, "candidate link identity") ?? return Err(NativeSwapError.input(candidate_identity, .InvalidIdentity, err))
        NativeSwapLinkFacts{strategy: strategy, resident_identity: resident_identity, candidate_identity: candidate_identity}
    }
    resident: fn(identity: String) -> NativeSwapLinkFacts NativeSwapError! { NativeSwapLinkFacts.new(.ReuseResident, identity, identity) }
    // Opaque labels only: this does not claim a linker has run.
    unlinked: fn() -> NativeSwapLinkFacts {
        NativeSwapLinkFacts{strategy: .ReuseResident, resident_identity: "resident", candidate_identity: "candidate"}
    }
}
NativeSwapQuiescence: struct {
    required: Bool
    active_operations: U64
    reached: Bool

    ready: fn() -> NativeSwapQuiescence { NativeSwapQuiescence{required: true, active_operations: 0, reached: true} }
    pending: fn(active_operations: U64) -> NativeSwapQuiescence { NativeSwapQuiescence{required: true, active_operations: active_operations, reached: false} }
    not_required: fn() -> NativeSwapQuiescence { NativeSwapQuiescence{required: false, active_operations: 0, reached: true} }
    is_ready: fn(self) -> Bool { self.reached && self.active_operations == 0 }
}
// `Unblocked` is the fact a compatible plan carries; it renders as "none".
impl NativeSwapBlockingFact {
    as_str: fn(self) -> String {
        if self == {
            .Unblocked -> "none"
            .InvalidIdentity -> "invalid_identity"
            .InvalidRevision -> "invalid_revision"
            .SourceIdentityChanged -> "source_identity_changed"
            .CodeRevisionUnsupported -> "code_revision_unsupported"
            .DataRevisionUnsupported -> "data_revision_unsupported"
            .IncompatibleType -> "incompatible_type"
            .ConnectionHandleStale -> "connection_handle_stale"
            .LayoutChanged -> "layout_changed"
            .UnsafeEdit -> "unsafe_edit"
            .RestartRequired -> "restart_required"
            .ListenerHandleMissing -> "listener_handle_missing"
            .ListenerHandleIncompatible -> "listener_handle_incompatible"
            .ListenerHandleStale -> "listener_handle_stale"
            .ConnectionHandleMissing -> "connection_handle_missing"
            .ConnectionHandleIncompatible -> "connection_handle_incompatible"
            .ConnectionListenerNotPreserved -> "connection_listener_not_preserved"
            .DuplicateIdentity -> "duplicate_identity"
            .FactLimit -> "fact_limit"
            .QuiescenceRequired -> "quiescence_required"
            .RelocationUnsupported -> "relocation_unsupported"
            .LinkStrategyUnsupported -> "link_strategy_unsupported"
            .StaleReference -> "stale_reference"
            .StalePlan -> "stale_plan"
            .InvalidPhase -> "invalid_phase"
            .CompileFailed -> "compile_failed"
            .MigrationFailed -> "migration_failed"
            .RollbackUnavailable -> "rollback_unavailable"
            .CapabilityUnavailable -> "capability_unavailable"
        }
    }
    is_restartable: fn(self) -> Bool {
        if self == {
            .CodeRevisionUnsupported | .DataRevisionUnsupported | .IncompatibleType | .LayoutChanged | .RestartRequired | .RelocationUnsupported | .LinkStrategyUnsupported -> true
            else -> false
        }
    }
}
impl NativeSwapBlockingFact.Display { display: fn(self) -> String { self.as_str() } }

impl NativeSwapDisposition {
    as_str: fn(self) -> String {
        if self == {
            .Swap -> "swap"
            .Restart -> "restart"
            .Rejected -> "rejected"
        }
    }
}
impl NativeSwapDisposition.Display { display: fn(self) -> String { self.as_str() } }

NativeSwapExplanation: struct {
    source_id: String
    disposition: NativeSwapDisposition
    blocking_fact: NativeSwapBlockingFact
    detail: String

    new: fn(source_id: String, disposition: NativeSwapDisposition, blocking_fact: NativeSwapBlockingFact, detail: String) -> NativeSwapExplanation {
        NativeSwapExplanation{source_id: bounded_text(source_id, MAX_NATIVE_SWAP_ID_BYTES), disposition: disposition, blocking_fact: blocking_fact, detail: bounded_text(detail, MAX_NATIVE_SWAP_DETAIL_BYTES)}
    }
    compatible: fn(source_id: String) -> NativeSwapExplanation {
        NativeSwapExplanation.new(source_id, .Swap, .Unblocked, "code/data and explicit resident handles are compatible")
    }
    render: fn(self) -> String {
        "reload disposition={self.disposition.as_str()} source={self.source_id} blocking_fact={self.blocking_fact.as_str()} detail={self.detail}"
    }

    impl Display { display: fn(self) -> String { self.render() } }
}
#Error
NativeSwapError: struct {
    explanation: NativeSwapExplanation

    input: fn(source_id: String, blocking_fact: NativeSwapBlockingFact, detail: String) -> NativeSwapError {
        NativeSwapError{explanation: NativeSwapExplanation.new(source_id, .Rejected, blocking_fact, detail)}
    }
    restart: fn(source_id: String, blocking_fact: NativeSwapBlockingFact, detail: String) -> NativeSwapError {
        NativeSwapError{explanation: NativeSwapExplanation.new(source_id, .Restart, blocking_fact, detail)}
    }
    source_id: fn(self) -> String { self.explanation.source_id }
    blocking_fact: fn(self) -> NativeSwapBlockingFact { self.explanation.blocking_fact }
    render: fn(self) -> String { self.explanation.render() }

    impl Display { display: fn(self) -> String { self.render() } }
}
NativeSwapHandleCompatibility: enum {
    Compatible Incompatible

    as_str: fn(self) -> String {
        if self == {
            .Compatible -> "compatible"
            .Incompatible -> "incompatible"
        }
    }
    is_compatible: fn(self) -> Bool { self == .Compatible }
}
NativeSwapListenerHandle: struct {
    id: String
    source: NativeSwapSourceIdentity
    generation: U64
    compatibility: NativeSwapHandleCompatibility

    new: fn(id: String, source: NativeSwapSourceIdentity, generation: U64, compatibility: NativeSwapHandleCompatibility) -> NativeSwapListenerHandle NativeSwapError! {
        _: native_swap_validate_identity(id, "listener handle identity") ?? return Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        _: native_swap_validate_source_identity(source, "listener") ?? return Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        NativeSwapListenerHandle{id: id, source: source, generation: generation, compatibility: compatibility}
    }
    compatible: fn(id: String, source: NativeSwapSourceIdentity, generation: U64) -> NativeSwapListenerHandle NativeSwapError! {
        NativeSwapListenerHandle.new(id, source, generation, .Compatible)
    }
    incompatible: fn(id: String, source: NativeSwapSourceIdentity, generation: U64) -> NativeSwapListenerHandle NativeSwapError! {
        NativeSwapListenerHandle.new(id, source, generation, .Incompatible)
    }
    is_compatible: fn(self) -> Bool { self.compatibility.is_compatible() }
}
NativeSwapConnectionHandle: struct {
    id: String
    listener_id: String
    source: NativeSwapSourceIdentity
    generation: U64
    compatibility: NativeSwapHandleCompatibility

    new: fn(id: String, listener_id: String, source: NativeSwapSourceIdentity, generation: U64, compatibility: NativeSwapHandleCompatibility) -> NativeSwapConnectionHandle NativeSwapError! {
        _: native_swap_validate_identity(id, "connection handle identity") ?? return Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        _: native_swap_validate_identity(listener_id, "connection listener identity") ?? return Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        _: native_swap_validate_source_identity(source, "connection") ?? return Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        NativeSwapConnectionHandle{id: id, listener_id: listener_id, source: source, generation: generation, compatibility: compatibility}
    }
    compatible: fn(id: String, listener_id: String, source: NativeSwapSourceIdentity, generation: U64) -> NativeSwapConnectionHandle NativeSwapError! {
        NativeSwapConnectionHandle.new(id, listener_id, source, generation, .Compatible)
    }
    incompatible: fn(id: String, listener_id: String, source: NativeSwapSourceIdentity, generation: U64) -> NativeSwapConnectionHandle NativeSwapError! {
        NativeSwapConnectionHandle.new(id, listener_id, source, generation, .Incompatible)
    }
    is_compatible: fn(self) -> Bool { self.compatibility.is_compatible() }
}
NativeSwapCapability: struct {
    code: NativeSwapCodePolicy
    data: NativeSwapDataPolicy
    listeners: NativeSwapHandlePolicy
    connections: NativeSwapHandlePolicy
    restart: Bool
    quiescence: NativeSwapQuiescencePolicy
    relocation: NativeSwapRelocationStrategy
    link: NativeSwapLinkStrategy

    resident: fn() -> NativeSwapCapability {
        NativeSwapCapability{code: .Replace, data: .Preserve, listeners: .ExplicitCompatible, connections: .ExplicitCompatible,
            restart: true, quiescence: .Required, relocation: .StableIdentity, link: .ReuseResident}
    }
    with_relocation: fn(self, strategy: NativeSwapRelocationStrategy) -> NativeSwapCapability {
        next := self
        next.relocation = strategy
        next
    }
    with_link: fn(self, strategy: NativeSwapLinkStrategy) -> NativeSwapCapability {
        next := self
        next.link = strategy
        next
    }
    allows_restart: fn(self) -> Bool { self.restart }
}
NativeSwapRestartBoundary: struct {
    required: Bool
    reason: NativeSwapBlockingFact?
    affected: [String]
    kept: [String]
    reset: [String]

    in_place: fn() -> NativeSwapRestartBoundary {
        NativeSwapRestartBoundary{required: false, reason: None, affected: [String]{}, kept: [String]{}, reset: [String]{}}
    }
    required_by: fn(reason: NativeSwapBlockingFact, affected: [String]) -> NativeSwapRestartBoundary {
        NativeSwapRestartBoundary{required: true, reason: Val(reason), affected: normalized_facts(affected), kept: [String]{}, reset: [String]{}}
    }
    validate: fn(self, source_id: String) NativeSwapError! {
        validate_fact_list(source_id, self.affected)
        validate_fact_list(source_id, self.kept)
        validate_fact_list(source_id, self.reset)
        if self.required && self.reason == None -> return Err(NativeSwapError.input(source_id, .RestartRequired, "restart boundary is required but has no blocking fact"))
        if !self.required && self.reason != None -> return Err(NativeSwapError.input(source_id, .RestartRequired, "in-place boundary carries a restart reason"))
        if self.reason == .Val(reason) {
            if !reason.is_restartable() -> return Err(NativeSwapError.input(source_id, reason, "restart boundary reason `{reason.as_str()}` cannot be handled by a clean restart"))
        }
        loop value in self.reset {
            if self.kept.contains(value) -> return Err(NativeSwapError.input(source_id, .DuplicateIdentity, "restart state `{value}` is both kept and reset"))
        }
    }
}
NativeSwapPlan: struct {
    source: NativeSwapSourceIdentity
    from: NativeSwapExecutable
    to: NativeSwapExecutable
    capability: NativeSwapCapability
    preserve_listeners: [NativeSwapListenerHandle]
    preserve_connections: [NativeSwapConnectionHandle]
    restart_boundary: NativeSwapRestartBoundary
    quiescence: NativeSwapQuiescence
    relocation: NativeSwapRelocationFacts
    link: NativeSwapLinkFacts
    changed_items: [String]
    removed_definitions: [String]
    blocking_fact: NativeSwapBlockingFact?

    // A plan reads Sema's checked hot-swap decision, which this compiler does
    // not produce yet, so planning refuses once the executables check.
    new: fn(source: NativeSwapSourceIdentity, from: NativeSwapExecutable, to: NativeSwapExecutable) -> NativeSwapPlan NativeSwapError! {
        source_id: source.canonical()
        if !from.source.matches(source) || !to.source.matches(source) -> return Err(NativeSwapError.input(source_id, .SourceIdentityChanged, "plan source does not match both executable identities"))
        if to.generation <= from.generation -> return Err(NativeSwapError.input(source_id, .StalePlan, "candidate generation must advance beyond the resident generation"))
        Err(NativeSwapError.input(source_id, .CapabilityUnavailable, "native hot swap is not available: this compiler has no checked hot-swap decision"))
    }
    mark_layout_changed: fn(self, affected: [String]) -> NativeSwapPlan {
        next := self
        next.blocking_fact = Val(NativeSwapBlockingFact.LayoutChanged)
        next.restart_boundary = NativeSwapRestartBoundary.required_by(.LayoutChanged, affected)
        next
    }
    with_quiescence: fn(self, quiescence: NativeSwapQuiescence) -> NativeSwapPlan {
        next := self
        next.quiescence = quiescence
        next
    }
    with_relocation: fn(self, relocation: NativeSwapRelocationFacts) -> NativeSwapPlan {
        next := self
        next.relocation = relocation
        next
    }
    with_link: fn(self, link: NativeSwapLinkFacts) -> NativeSwapPlan {
        next := self
        next.link = link
        next
    }
    // Handles stay ordered by identity so receipts and validation read them deterministically.
    preserve_listener: fn(self, handle: NativeSwapListenerHandle) -> NativeSwapPlan {
        next := self
        at := next.preserve_listeners.len()
        loop index in 0..<next.preserve_listeners.len() {
            if handle.id < next.preserve_listeners[index].id {
                at = index
                break
            }
        }
        next.preserve_listeners.insert(at, handle)
        next
    }
    preserve_connection: fn(self, handle: NativeSwapConnectionHandle) -> NativeSwapPlan {
        next := self
        at := next.preserve_connections.len()
        loop index in 0..<next.preserve_connections.len() {
            if handle.id < next.preserve_connections[index].id {
                at = index
                break
            }
        }
        next.preserve_connections.insert(at, handle)
        next
    }
    code_changed: fn(self) -> Bool { !self.from.revision.code_unchanged(self.to.revision) }
    data_changed: fn(self) -> Bool { !self.from.revision.data_unchanged(self.to.revision) }
    requires_restart: fn(self) -> Bool {
        if self.restart_boundary.required -> return true
        if self.blocking_fact == .Val(fact) -> return fact.is_restartable()
        false
    }
    explanation: fn(self) -> NativeSwapExplanation {
        state: NativeSwapState.new(self.from, self.preserve_listeners, self.preserve_connections) ?? return err.explanation
        state.explain_reload(self)
    }
    validate_shape: fn(self) NativeSwapError! {
        source_id: self.source.canonical()
        _: native_swap_validate_source_identity(self.source, "plan") ?? return Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        _: native_swap_validate_source_identity(self.from.source, "resident executable") ?? return Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        _: native_swap_validate_source_identity(self.to.source, "candidate executable") ?? return Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        if !self.from.source.matches(self.source) || !self.to.source.matches(self.source) -> return Err(NativeSwapError.input(source_id, .SourceIdentityChanged, "plan source does not match both executable identities"))
        if self.to.generation <= self.from.generation -> return Err(NativeSwapError.input(source_id, .StalePlan, "candidate generation must advance beyond the resident generation"))
        self.restart_boundary.validate(source_id)
        validate_fact_list(source_id, self.changed_items)
        validate_fact_list(source_id, self.removed_definitions)
        validate_fact_list(source_id, self.relocation.code_symbols)
        validate_fact_list(source_id, self.relocation.data_slots)
        validate_listener_plan_facts(source_id, self.source, self.preserve_listeners)
        validate_connection_plan_facts(source_id, self.source, self.preserve_connections)
        _: native_swap_validate_identity(self.link.resident_identity, "resident link identity") ?? return Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        _: native_swap_validate_identity(self.link.candidate_identity, "candidate link identity") ?? return Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
    }
}
impl NativeSwapOutcome {
    as_str: fn(self) -> String {
        if self == {
            .Committed -> "committed"
            .RolledBack -> "rolled_back"
            .Rejected -> "rejected"
            .RestartRequired -> "restart_required"
        }
    }
}
impl NativeSwapOutcome.Display { display: fn(self) -> String { self.as_str() } }

NativeSwapReceipt: struct {
    source: NativeSwapSourceIdentity
    outcome: NativeSwapOutcome
    before: NativeSwapRevision
    after: NativeSwapRevision
    before_generation: U64
    after_generation: U64
    preserved_listeners: [String]
    reset_listeners: [String]
    preserved_connections: [String]
    reset_connections: [String]
    restart_boundary: NativeSwapRestartBoundary
    explanation: NativeSwapExplanation?

    committed: fn(self) -> Bool { self.outcome == .Committed }
    rolled_back: fn(self) -> Bool { self.outcome == .RolledBack }
    rejected: fn(self) -> Bool { self.outcome == .Rejected || self.outcome == .RestartRequired }
    render: fn(self) -> String {
        explanation: if self.explanation == .Val(value) -> value.render() else -> "none"
        before: "code:{self.before.code.value}+data:{self.before.data.value}@{self.before_generation}"
        after: "code:{self.after.code.value}+data:{self.after.data.value}@{self.after_generation}"
        handles: "preserved_listeners=[{self.preserved_listeners.join(",")}] reset_listeners=[{self.reset_listeners.join(",")}] preserved_connections=[{self.preserved_connections.join(",")}] reset_connections=[{self.reset_connections.join(",")}]"
        "native-swap outcome={self.outcome.as_str()} source={self.source.canonical()} before={before} after={after} {handles} restart={self.restart_boundary.required} explanation={explanation}"
    }
}
impl NativeSwapPhase {
    as_str: fn(self) -> String {
        if self == {
            .Ready -> "ready"
            .Paused -> "paused"
            .Applied -> "applied"
        }
    }
}
impl NativeSwapPhase.Display { display: fn(self) -> String { self.as_str() } }

NativeSwapCheckpoint: struct {
    executable: NativeSwapExecutable
    listeners: [String: NativeSwapListenerHandle]
    connections: [String: NativeSwapConnectionHandle]
}
NativeSwapWorkingReceipt: struct {
    source: NativeSwapSourceIdentity
    before: NativeSwapExecutable
    after: NativeSwapExecutable
    preserved_listeners: [String]
    reset_listeners: [String]
    preserved_connections: [String]
    reset_connections: [String]
    restart_boundary: NativeSwapRestartBoundary
}
NativeSwapState: struct {
    executable: NativeSwapExecutable
    listeners: [String: NativeSwapListenerHandle]
    connections: [String: NativeSwapConnectionHandle]
    phase: NativeSwapPhase
    checkpoint: NativeSwapCheckpoint?
    pending_plan: NativeSwapPlan?
    working_receipt: NativeSwapWorkingReceipt?

    new: fn(executable: NativeSwapExecutable, listeners: [NativeSwapListenerHandle], connections: [NativeSwapConnectionHandle]) -> NativeSwapState NativeSwapError! {
        source_id: executable.source.canonical()
        _: native_swap_validate_source_identity(executable.source, "executable") ?? return Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        resident_listeners: listener_map(source_id, executable, listeners)
        resident_connections: connection_map(source_id, executable, connections, resident_listeners)
        NativeSwapState{executable: executable, listeners: resident_listeners, connections: resident_connections,
            phase: .Ready, checkpoint: None, pending_plan: None, working_receipt: None}
    }
    empty: fn(executable: NativeSwapExecutable) -> NativeSwapState NativeSwapError! {
        NativeSwapState.new(executable, [NativeSwapListenerHandle]{}, [NativeSwapConnectionHandle]{})
    }
    source: fn(self) -> NativeSwapSourceIdentity { self.executable.source }
    revision: fn(self) -> NativeSwapRevision { self.executable.revision }
    generation: fn(self) -> U64 { self.executable.generation }
    is_paused: fn(self) -> Bool { self.phase == .Paused }
    is_applied: fn(self) -> Bool { self.phase == .Applied }
    resident_listeners: fn(self) -> [NativeSwapListenerHandle] {
        loop key in sorted_keys(self.listeners) -> self.listeners[key]
    }
    resident_connections: fn(self) -> [NativeSwapConnectionHandle] {
        loop key in sorted_keys(self.connections) -> self.connections[key]
    }
    listener: fn(self, id: String) -> NativeSwapListenerHandle? { self.listeners.get(id) }
    connection: fn(self, id: String) -> NativeSwapConnectionHandle? { self.connections.get(id) }
    listener_count: fn(self) -> Int { self.listeners.len() }
    connection_count: fn(self) -> Int { self.connections.len() }
    preflight: fn(self, plan: NativeSwapPlan) NativeSwapError! { self.validate_plan(plan) }
    explain_reload: fn(self, plan: NativeSwapPlan) -> NativeSwapExplanation {
        _: self.validate_plan(plan) ?? return err.explanation
        NativeSwapExplanation.compatible(plan.source.canonical())
    }
    pause: fn(&self, plan: NativeSwapPlan) NativeSwapError! {
        if self.phase != .Ready -> return Err(self.phase_error("pause requires a ready transaction"))
        self.validate_plan(plan)
        self.checkpoint = Val(NativeSwapCheckpoint{executable: self.executable, listeners: self.listeners, connections: self.connections})
        self.pending_plan = Val(plan)
        self.working_receipt = None
        self.phase = .Paused
    }
    apply: fn(&self, plan: NativeSwapPlan) NativeSwapError! {
        if self.phase != .Paused -> return Err(self.phase_error("apply requires a paused transaction"))
        pending: self.pending_plan ?? return Err(self.phase_error("apply has no paused plan"))
        if !plans_match(pending, plan) -> return Err(NativeSwapError.input(self.source().canonical(), .StalePlan, "apply plan does not match the paused plan"))
        self.validate_plan(plan)
        checkpoint: self.checkpoint ?? return Err(self.error(.RollbackUnavailable, "apply checkpoint is missing"))
        next_listeners := [String: NativeSwapListenerHandle]{}
        loop handle in plan.preserve_listeners {
            preserved := handle
            preserved.generation = plan.to.generation
            next_listeners[preserved.id] = preserved
        }
        next_connections := [String: NativeSwapConnectionHandle]{}
        loop handle in plan.preserve_connections {
            preserved := handle
            preserved.generation = plan.to.generation
            next_connections[preserved.id] = preserved
        }
        reset_listeners := [String]{}
        loop id in sorted_keys(checkpoint.listeners) {
            if next_listeners.get(id) == None -> reset_listeners.push(id)
        }
        reset_connections := [String]{}
        loop id in sorted_keys(checkpoint.connections) {
            if next_connections.get(id) == None -> reset_connections.push(id)
        }
        working: NativeSwapWorkingReceipt{source: plan.source, before: checkpoint.executable, after: plan.to,
            preserved_listeners: sorted_keys(next_listeners), reset_listeners: reset_listeners,
            preserved_connections: sorted_keys(next_connections), reset_connections: reset_connections,
            restart_boundary: plan.restart_boundary}
        // Every fallible check and all receipt facts are complete before the first resident mutation.
        self.executable = plan.to
        self.listeners = next_listeners
        self.connections = next_connections
        self.working_receipt = Val(working)
        self.phase = .Applied
    }
    commit: fn(&self) -> NativeSwapReceipt NativeSwapError! {
        if self.phase != .Applied -> return Err(self.phase_error("commit requires an applied transaction"))
        working: self.working_receipt ?? return Err(self.error(.InvalidPhase, "applied transaction has no working receipt"))
        self.working_receipt = None
        self.checkpoint = None
        self.pending_plan = None
        self.phase = .Ready
        receipt_from_working(working, .Committed, None)
    }
    rollback: fn(&self) -> NativeSwapReceipt NativeSwapError! {
        if self.phase != .Paused && self.phase != .Applied -> return Err(self.phase_error("rollback requires a paused or applied transaction"))
        checkpoint: self.checkpoint ?? return Err(self.error(.RollbackUnavailable, "rollback checkpoint is missing"))
        before: self.executable
        reset_listeners := [String]{}
        loop id in sorted_keys(self.listeners) {
            if checkpoint.listeners.get(id) == None -> reset_listeners.push(id)
        }
        reset_connections := [String]{}
        loop id in sorted_keys(self.connections) {
            if checkpoint.connections.get(id) == None -> reset_connections.push(id)
        }
        explanation: NativeSwapExplanation.new(checkpoint.executable.source.canonical(), .Rejected, .UnsafeEdit, "rollback restored the prior executable and explicit handles")
        receipt: NativeSwapReceipt{source: checkpoint.executable.source, outcome: .RolledBack,
            before: before.revision, after: checkpoint.executable.revision, before_generation: before.generation,
            after_generation: checkpoint.executable.generation, preserved_listeners: sorted_keys(checkpoint.listeners),
            reset_listeners: reset_listeners, preserved_connections: sorted_keys(checkpoint.connections), reset_connections: reset_connections,
            restart_boundary: NativeSwapRestartBoundary.in_place(), explanation: Val(explanation)}
        self.executable = checkpoint.executable
        self.listeners = checkpoint.listeners
        self.connections = checkpoint.connections
        self.checkpoint = None
        self.pending_plan = None
        self.working_receipt = None
        self.phase = .Ready
        receipt
    }
}
// NativeSwap02 continues NativeSwapState with reject/fail (compilation or
// migration failing before pause can begin), plan validation and the shared
// identity and fact-list validators.
