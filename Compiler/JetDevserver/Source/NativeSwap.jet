// Rust: crates/jet-devserver/src/NativeSwap.rs:1528
pub struct NativeSwapState {
    executable: NativeSwapExecutable
    listeners: [String:NativeSwapListenerHandle]
    connections: [String:NativeSwapConnectionHandle]
    phase: NativeSwapPhase
    checkpoint: NativeSwapCheckpoint?
    pending_plan: NativeSwapPlan?
    working_receipt: NativeSwapWorkingReceipt?
}
impl NativeSwapState {
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1540
    pub fn new(executable: NativeSwapExecutable, listeners: [NativeSwapListenerHandle], connections: [NativeSwapConnectionHandle]) -> Self NativeSwapError! {
        source_id :: executable.source.canonical()
        _ :: validate_source_identity(&executable.source, "executable") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        listener_map :: listener_map(source_id, &executable, ^listeners)?
        connection_map :: connection_map(source_id, &executable, ^connections, &listener_map)?
        Self { executable: ^executable, listeners: ^listener_map, connections: ^connection_map,
            phase: .Ready, checkpoint: .None, pending_plan: .None, working_receipt: .None }
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1567
    pub fn empty(executable: NativeSwapExecutable) -> Self NativeSwapError! { Self.new(^executable, [], []) }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1572
    pub fn executable(self: &Self) -> &NativeSwapExecutable { &self.executable }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1577
    pub fn source(self: &Self) -> &NativeSwapSourceIdentity { &self.executable.source }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1582
    pub fn revision(self: &Self) -> &NativeSwapRevision { &self.executable.revision }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1587
    pub fn generation(self: &Self) -> U64 { self.executable.generation }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1592
    pub fn phase(self: &Self) -> NativeSwapPhase { self.phase }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1597
    pub fn is_paused(self: &Self) -> Bool { self.phase == .Paused }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1602
    pub fn is_applied(self: &Self) -> Bool { self.phase == .Applied }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1607
    pub fn listeners(self: &Self) -> [NativeSwapListenerHandle] {
        keys := self.listeners.keys().cloned().collect[[String]]()
        keys.sort()
        keys.iter().map((key) -> ~self.listeners[key]).collect()
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1612
    pub fn connections(self: &Self) -> [NativeSwapConnectionHandle] {
        keys := self.connections.keys().cloned().collect[[String]]()
        keys.sort()
        keys.iter().map((key) -> ~self.connections[key]).collect()
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1617
    pub fn listener(self: &Self, id: String) -> &NativeSwapListenerHandle? { self.listeners.get(id) }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1622
    pub fn connection(self: &Self, id: String) -> &NativeSwapConnectionHandle? { self.connections.get(id) }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1627
    pub fn listener_count(self: &Self) -> USize { self.listeners.len() }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1632
    pub fn connection_count(self: &Self) -> USize { self.connections.len() }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1637
    pub fn preflight(self: &Self, plan: &NativeSwapPlan) -> Unit NativeSwapError! { self.validate_plan(plan) }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1642
    pub fn explain_reload(self: &Self, plan: &NativeSwapPlan) -> NativeSwapExplanation {
        _ :: self.validate_plan(plan) ?? return ~err.explanation
        NativeSwapExplanation.compatible(plan.source.canonical())
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1652
    pub fn pause(self: &Self, plan: &NativeSwapPlan) -> Unit NativeSwapError! {
        if self.phase != .Ready -> return .Err(self.phase_error("pause requires a ready transaction"))
        self.validate_plan(plan)?
        checkpoint :: NativeSwapCheckpoint { executable: ~self.executable, listeners: ~self.listeners, connections: ~self.connections }
        self.checkpoint = .Val(^checkpoint)
        self.pending_plan = .Val(~plan)
        self.working_receipt = .None
        self.phase = .Paused
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1671
    pub fn apply(self: &Self, plan: &NativeSwapPlan) -> Unit NativeSwapError! {
        if self.phase != .Paused -> return .Err(self.phase_error("apply requires a paused transaction"))
        if self.pending_plan.as_ref() != .Val(plan) -> return .Err(NativeSwapError.input(self.source().canonical(), .StalePlan, "apply plan does not match the paused plan"))
        self.validate_plan(plan)?
        checkpoint :: self.checkpoint.as_ref() ?? return .Err(self.error(.RollbackUnavailable, "apply checkpoint is missing"))
        preserved_listener_ids: [String:Bool] := [:]
        for handle in plan.preserve_listeners -> preserved_listener_ids.insert(~handle.id, true)
        preserved_connection_ids: [String:Bool] := [:]
        for handle in plan.preserve_connections -> preserved_connection_ids.insert(~handle.id, true)
        next_listeners: [String:NativeSwapListenerHandle] := [:]
        for handle in plan.preserve_listeners {
            preserved := ~handle
            preserved.generation = plan.to.generation
            next_listeners.insert(~preserved.id, ^preserved)
        }
        next_connections: [String:NativeSwapConnectionHandle] := [:]
        for handle in plan.preserve_connections {
            preserved := ~handle
            preserved.generation = plan.to.generation
            next_connections.insert(~preserved.id, ^preserved)
        }
        reset_listeners := checkpoint.listeners.keys().filter((id) -> !preserved_listener_ids.contains_key(id)).cloned().collect[[String]]()
        reset_listeners.sort()
        reset_connections := checkpoint.connections.keys().filter((id) -> !preserved_connection_ids.contains_key(id)).cloned().collect[[String]]()
        reset_connections.sort()
        listener_ids := preserved_listener_ids.keys().cloned().collect[[String]]()
        listener_ids.sort()
        connection_ids := preserved_connection_ids.keys().cloned().collect[[String]]()
        connection_ids.sort()
        working :: NativeSwapWorkingReceipt { source: ~plan.source, before: ~checkpoint.executable, after: ~plan.to,
            preserved_listeners: ^listener_ids, reset_listeners: ^reset_listeners,
            preserved_connections: ^connection_ids, reset_connections: ^reset_connections,
            restart_boundary: ~plan.restart_boundary }
        // Every fallible check and all receipt facts are complete before the first resident mutation.
        self.executable = ~plan.to
        self.listeners = ^next_listeners
        self.connections = ^next_connections
        self.working_receipt = .Val(^working)
        self.phase = .Applied
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1744
    pub fn commit(self: &Self) -> NativeSwapReceipt NativeSwapError! {
        if self.phase != .Applied -> return .Err(self.phase_error("commit requires an applied transaction"))
        working :: self.working_receipt.take() ?? return .Err(self.error(.InvalidPhase, "applied transaction has no working receipt"))
        receipt :: receipt_from_working(&working, .Committed, .None)
        self.checkpoint = .None
        self.pending_plan = .None
        self.phase = .Ready
        receipt
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1762
    pub fn rollback(self: &Self) -> NativeSwapReceipt NativeSwapError! {
        if self.phase != .Paused && self.phase != .Applied -> return .Err(self.phase_error("rollback requires a paused or applied transaction"))
        checkpoint :: self.checkpoint.take() ?? return .Err(self.error(.RollbackUnavailable, "rollback checkpoint is missing"))
        before :: &self.executable
        preserved_listeners := checkpoint.listeners.keys().cloned().collect[[String]]()
        preserved_listeners.sort()
        reset_listeners := self.listeners.keys().filter((id) -> !checkpoint.listeners.contains_key(id)).cloned().collect[[String]]()
        reset_listeners.sort()
        preserved_connections := checkpoint.connections.keys().cloned().collect[[String]]()
        preserved_connections.sort()
        reset_connections := self.connections.keys().filter((id) -> !checkpoint.connections.contains_key(id)).cloned().collect[[String]]()
        reset_connections.sort()
        receipt :: NativeSwapReceipt { source: ~checkpoint.executable.source, outcome: .RolledBack,
            before: ~before.revision, after: ~checkpoint.executable.revision, before_generation: before.generation,
            after_generation: checkpoint.executable.generation, preserved_listeners: ^preserved_listeners,
            reset_listeners: ^reset_listeners, preserved_connections: ^preserved_connections, reset_connections: ^reset_connections,
            restart_boundary: NativeSwapRestartBoundary.in_place(), explanation: .Val(NativeSwapExplanation.new(
                checkpoint.executable.source.canonical(), .Rejected, .UnsafeEdit, "rollback restored the prior executable and explicit handles")) }
        self.executable = ^checkpoint.executable
        self.listeners = ^checkpoint.listeners
        self.connections = ^checkpoint.connections
        self.pending_plan = .None
        self.working_receipt = .None
        self.phase = .Ready
        receipt
    }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:1812
// reject (continued in NativeSwap02) retains the current executable and handles
// when compilation or migration fails before pause can begin.
