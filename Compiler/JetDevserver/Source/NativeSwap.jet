// Rust: crates/jet-devserver/src/NativeSwap.rs:1048
pub struct NativeSwapRestartBoundary {
    pub required: Bool
    pub reason: NativeSwapBlockingFact?
    pub affected: [String]
    pub kept: [String]
    pub reset: [String]
}
impl NativeSwapRestartBoundary {
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1062
    pub fn in_place() -> Self { Self { required: false, reason: .None, affected: [], kept: [], reset: [] } }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1073
    pub fn required(reason: NativeSwapBlockingFact, affected: [String]) -> Self {
        Self { required: true, reason: .Val(reason), affected: normalized_facts(^affected), kept: [], reset: [] }
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1084
    pub fn with_state(self: Self, kept: [String], reset: [String]) -> Self {
        self.kept = normalized_facts(^kept)
        self.reset = normalized_facts(^reset)
        self
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1090
    fn validate(self: &Self, source_id: String) -> Unit NativeSwapError! {
        validate_fact_list(source_id, &self.affected)?
        validate_fact_list(source_id, &self.kept)?
        validate_fact_list(source_id, &self.reset)?
        if self.required && self.reason.is_none() -> return .Err(NativeSwapError.input(source_id, .RestartRequired, "restart boundary is required but has no blocking fact"))
        if !self.required && self.reason.is_some() -> return .Err(NativeSwapError.input(source_id, .RestartRequired, "in-place boundary carries a restart reason"))
        if self.reason == .Val(reason) {
            if !reason.is_restartable() -> return .Err(NativeSwapError.input(source_id, reason, "restart boundary reason `{reason.as_str()}` cannot be handled by a clean restart"))
        }
        kept_index: [String:Bool] := [:]
        for kept in self.kept -> kept_index.insert(kept, true)
        for value in self.reset {
            if kept_index.contains_key(value) -> return .Err(NativeSwapError.input(source_id, .DuplicateIdentity, "restart state `{value}` is both kept and reset"))
        }
    }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:1132
impl Default for NativeSwapRestartBoundary {
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1133
    fn default() -> Self { Self.in_place() }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:1140
pub struct NativeSwapPlan {
    pub source: NativeSwapSourceIdentity
    pub from: NativeSwapExecutable
    pub to: NativeSwapExecutable
    pub decision: HotSwapDecision
    pub capability: NativeSwapCapability
    pub preserve_listeners: [NativeSwapListenerHandle]
    pub preserve_connections: [NativeSwapConnectionHandle]
    pub restart_boundary: NativeSwapRestartBoundary
    pub quiescence: NativeSwapQuiescence
    pub relocation: NativeSwapRelocationFacts
    pub link: NativeSwapLinkFacts
    pub changed_items: [String]
    pub removed_definitions: [String]
    pub blocking_fact: NativeSwapBlockingFact?
}
impl NativeSwapPlan {
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1176
    pub fn new(source: NativeSwapSourceIdentity, from: NativeSwapExecutable, to: NativeSwapExecutable, capability: NativeSwapCapability, decision: HotSwapDecision) -> Self NativeSwapError! {
        source_id :: source.canonical()
        validate_hot_swap_decision(source_id, &source, &decision)?
        if !from.source.matches(&source) || !to.source.matches(&source) -> return .Err(NativeSwapError.input(source_id, .SourceIdentityChanged, "plan source does not match both executable identities"))
        if to.generation <= from.generation -> return .Err(NativeSwapError.input(source.canonical(), .StalePlan, "candidate generation must advance beyond the resident generation"))
        restart_boundary :: if decision.is_compatible() -> NativeSwapRestartBoundary.in_place() else -> decision_restart_boundary(&decision)
        changed_items :: normalized_facts(~decision.changed_functions)
        Self { source: ^source, from: ^from, to: ^to, decision: ^decision, capability: ^capability,
            preserve_listeners: [], preserve_connections: [], restart_boundary: ^restart_boundary,
            quiescence: NativeSwapQuiescence.ready(), relocation: NativeSwapRelocationFacts.default(),
            link: NativeSwapLinkFacts.default(), changed_items: ^changed_items, removed_definitions: [], blocking_fact: .None }
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1224
    pub fn mark_layout_changed(self: Self, affected: [String]) -> Self {
        self.blocking_fact = .Val(.LayoutChanged)
        self.restart_boundary = NativeSwapRestartBoundary.required(.LayoutChanged, ^affected)
        self
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1234
    pub fn with_quiescence(self: Self, quiescence: NativeSwapQuiescence) -> Self { self.quiescence = quiescence; self }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1240
    pub fn with_relocation(self: Self, relocation: NativeSwapRelocationFacts) -> Self { self.relocation = ^relocation; self }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1246
    pub fn with_link(self: Self, link: NativeSwapLinkFacts) -> Self { self.link = ^link; self }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1252
    pub fn preserve_listener(self: Self, handle: NativeSwapListenerHandle) -> Self {
        self.preserve_listeners.push(^handle)
        self.preserve_listeners.sort()
        self
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1259
    pub fn preserve_connection(self: Self, handle: NativeSwapConnectionHandle) -> Self {
        self.preserve_connections.push(^handle)
        self.preserve_connections.sort()
        self
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1266
    pub fn code_changed(self: &Self) -> Bool { !self.from.revision.code_unchanged(&self.to.revision) }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1271
    pub fn data_changed(self: &Self) -> Bool { !self.from.revision.data_unchanged(&self.to.revision) }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1276
    pub fn requires_restart(self: &Self) -> Bool {
        self.decision.requires_restart() || self.restart_boundary.required || self.blocking_fact.is_some_and((fact) -> fact.is_restartable())
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1288
    pub fn explanation(self: &Self) -> NativeSwapExplanation {
        if !self.decision.is_compatible() {
            disposition :: if self.capability.restart -> NativeSwapDisposition.Restart else -> NativeSwapDisposition.Rejected
            return NativeSwapExplanation.new(self.source.canonical(), disposition, .IncompatibleType,
                self.decision.compatibility.reason().unwrap_or("semantic hot-swap verdict requires a clean restart"))
        }
        state :: NativeSwapState.new(~self.from, ~self.preserve_listeners, ~self.preserve_connections) ?? return ~err.explanation
        state.explain_reload(self)
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1315
    fn validate_shape(self: &Self) -> Unit NativeSwapError! {
        source_id :: self.source.canonical()
        for (label, identity) in [("plan", &self.source), ("resident executable", &self.from.source), ("candidate executable", &self.to.source)] {
            _ :: validate_source_identity(identity, label) ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        }
        if !self.from.source.matches(&self.source) || !self.to.source.matches(&self.source) -> return .Err(NativeSwapError.input(source_id, .SourceIdentityChanged, "plan source does not match both executable identities"))
        if self.to.generation <= self.from.generation -> return .Err(NativeSwapError.input(source_id, .StalePlan, "candidate generation must advance beyond the resident generation"))
        validate_hot_swap_decision(source_id, &self.source, &self.decision)?
        self.restart_boundary.validate(source_id)?
        validate_fact_list(source_id, &self.changed_items)?
        validate_fact_list(source_id, &self.removed_definitions)?
        validate_fact_list(source_id, &self.relocation.code_symbols)?
        validate_fact_list(source_id, &self.relocation.data_slots)?
        validate_listener_plan_facts(source_id, &self.source, &self.preserve_listeners)?
        validate_connection_plan_facts(source_id, &self.source, &self.preserve_connections)?
        for (label, identity) in [("resident link identity", self.link.resident_identity), ("candidate link identity", self.link.candidate_identity)] {
            _ :: validate_identity(identity, label) ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        }
    }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:1370
pub struct NativeSwapReceipt {
    pub source: NativeSwapSourceIdentity
    pub outcome: NativeSwapOutcome
    pub before: NativeSwapRevision
    pub after: NativeSwapRevision
    pub before_generation: U64
    pub after_generation: U64
    pub preserved_listeners: [String]
    pub reset_listeners: [String]
    pub preserved_connections: [String]
    pub reset_connections: [String]
    pub restart_boundary: NativeSwapRestartBoundary
    pub explanation: NativeSwapExplanation?
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:1399
pub enum NativeSwapOutcome { Committed; RolledBack; Rejected; RestartRequired }
impl NativeSwapOutcome {
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1412
    pub fn as_str(self) -> String { if self == { .Committed -> "committed", .RolledBack -> "rolled_back", .Rejected -> "rejected", .RestartRequired -> "restart_required" } }
}
impl NativeSwapReceipt {
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1424
    pub fn committed(self: &Self) -> Bool { self.outcome == .Committed }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1429
    pub fn rolled_back(self: &Self) -> Bool { self.outcome == .RolledBack }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1434
    pub fn rejected(self: &Self) -> Bool { self.outcome == .Rejected || self.outcome == .RestartRequired }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1443
    pub fn render(self: &Self) -> String {
        explanation :: self.explanation.as_ref().map((value) -> value.render()).unwrap_or("none")
        "native-swap outcome={self.outcome.as_str()} source={self.source.canonical()} before=code:{self.before.code.as_str()}+data:{self.before.data.as_str()}@{self.before_generation} after=code:{self.after.code.as_str()}+data:{self.after.data.as_str()}@{self.after_generation} preserved_listeners=[{self.preserved_listeners.join(",")}] reset_listeners=[{self.reset_listeners.join(",")}] preserved_connections=[{self.preserved_connections.join(",")}] reset_connections=[{self.reset_connections.join(",")}] restart={self.restart_boundary.required} explanation={explanation}"
    }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:1469
impl fmt.Display for NativeSwapOutcome {
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1470
