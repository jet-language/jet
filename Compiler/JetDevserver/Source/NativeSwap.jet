// Backend-neutral facts and compare-and-commit transaction state for a resident native swap.
// No method waits for quiescence or performs linker, socket, scheduler or OS operations.
// Producers supply checked semantic, relocation, link and quiescence facts before pause.
use {
    jet_foundation.HotSwap.[HotSwapDecision, StateRetentionDecision]
    std.fmt
}

NATIVE_SWAP_PROTOCOL :: String{"jet.native.swap.v1"}
MAX_NATIVE_SWAP_ID_BYTES :: USize{256}
MAX_NATIVE_SWAP_DETAIL_BYTES :: USize{1024}
MAX_NATIVE_SWAP_FACTS :: USize{1024}

struct NativeSwapSourceIdentity { source_id: String; module_ref: String }
impl NativeSwapSourceIdentity {
    fn new(source_id: String) -> Self NativeSwapError! { Self.new_with_module(source_id.copy(), ^source_id) }
    fn new_with_module(source_id: String, module_ref: String) -> Self NativeSwapError! {
        _ :: validate_identity(source_id, "source identity") ?? return .Err(NativeSwapError.input(^source_id, .InvalidIdentity, err))
        _ :: validate_identity(module_ref, "module identity") ?? return .Err(NativeSwapError.input(^source_id, .InvalidIdentity, err))
        Self { source_id: ^source_id, module_ref: ^module_ref }
    }
    fn canonical(self: Self) -> String {
        if self.source_id == self.module_ref -> self.source_id.copy() else -> "{self.source_id}::{self.module_ref}"
    }
    fn matches(self: Self, other: Self) -> Bool { self == other }
}
impl NativeSwapSourceIdentity.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.canonical()) }
}
struct NativeSwapCodeRevision { value: String }
impl NativeSwapCodeRevision {
    fn new(value: String) -> Self NativeSwapError! {
        _ :: validate_revision(value, "code revision") ?? return .Err(NativeSwapError.input(^value, .InvalidRevision, err))
        Self { value: ^value }
    }
    fn as_str(self: Self) -> String { self.value }
}
impl NativeSwapCodeRevision.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.value) }
}
struct NativeSwapDataRevision { value: String }
impl NativeSwapDataRevision {
    fn new(value: String) -> Self NativeSwapError! {
        _ :: validate_revision(value, "data revision") ?? return .Err(NativeSwapError.input(^value, .InvalidRevision, err))
        Self { value: ^value }
    }
    fn as_str(self: Self) -> String { self.value }
}
impl NativeSwapDataRevision.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.value) }
}
struct NativeSwapRevision { code: NativeSwapCodeRevision; data: NativeSwapDataRevision }
impl NativeSwapRevision {
    fn new(code: String, data: String) -> Self NativeSwapError! {
        Self { code: NativeSwapCodeRevision.new(^code), data: NativeSwapDataRevision.new(^data)? }
    }
    fn code_revision(self: Self) -> String { self.code.as_str() }
    fn data_revision(self: Self) -> String { self.data.as_str() }
    fn code_unchanged(self: Self, other: Self) -> Bool { self.code == other.code }
    fn data_unchanged(self: Self, other: Self) -> Bool { self.data == other.data }
}
struct NativeSwapExecutable {
    source: NativeSwapSourceIdentity
    revision: NativeSwapRevision
    generation: U64
}
impl NativeSwapExecutable {
    fn new(source: NativeSwapSourceIdentity, revision: NativeSwapRevision, generation: U64) -> Self NativeSwapError! {
        _ :: validate_source_identity(&source, "executable") ?? return .Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        Self { source: ^source, revision: ^revision, generation }
    }
    fn source_id(self: Self) -> String { self.source.canonical() }
}
enum NativeSwapCodePolicy { Replace; Restart; Reject }
impl NativeSwapCodePolicy {
    fn as_str(self) -> String { if self == {
        .Replace -> "replace"
        .Restart -> "restart"
        .Reject -> "reject"
    } }
}
enum NativeSwapDataPolicy { Preserve; Replace; Migrate; Restart; Reject }
impl NativeSwapDataPolicy {
    fn as_str(self) -> String { if self == {
        .Preserve -> "preserve"
        .Replace -> "replace"
        .Migrate -> "migrate"
        .Restart -> "restart"
        .Reject -> "reject"
    } }
}
enum NativeSwapHandlePolicy { Never; ExplicitCompatible }
impl NativeSwapHandlePolicy {
    fn as_str(self) -> String { if self == {
        .Never -> "never"
        .ExplicitCompatible -> "explicit_compatible"
    } }
}
enum NativeSwapQuiescencePolicy { Required; NotRequired }
impl NativeSwapQuiescencePolicy {
    fn as_str(self) -> String { if self == {
        .Required -> "required"
        .NotRequired -> "not_required"
    } }
}
enum NativeSwapRelocationStrategy { StableIdentity; RebindByIdentity; Restart; Reject }
impl NativeSwapRelocationStrategy {
    fn as_str(self) -> String { if self == {
        .StableIdentity -> "stable_identity"
        .RebindByIdentity -> "rebind_by_identity"
        .Restart -> "restart"
        .Reject -> "reject"
    } }
    fn permits_in_place(self) -> Bool { self == .StableIdentity || self == .RebindByIdentity }
}
enum NativeSwapLinkStrategy { ReuseResident; Relink; Restart; Reject }
impl NativeSwapLinkStrategy {
    fn as_str(self) -> String { if self == {
        .ReuseResident -> "reuse_resident"
        .Relink -> "relink"
        .Restart -> "restart"
        .Reject -> "reject"
    } }
    fn permits_in_place(self) -> Bool { self == .ReuseResident || self == .Relink }
}
impl NativeSwapRelocationStrategy.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.as_str()) }
}
impl NativeSwapLinkStrategy.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.as_str()) }
}
struct NativeSwapRelocationFacts {
    strategy: NativeSwapRelocationStrategy
    code_symbols: [String]
    data_slots: [String]
}
impl NativeSwapRelocationFacts {
    fn new(strategy: NativeSwapRelocationStrategy) -> Self { Self { strategy, code_symbols: [], data_slots: [] } }
}
impl NativeSwapRelocationFacts.Default {
    fn default() -> Self { Self.new(.StableIdentity) }
}
struct NativeSwapLinkFacts {
    strategy: NativeSwapLinkStrategy
    resident_identity: String
    candidate_identity: String
}
// The Rust `NativeSwapLinkStrategyFacts` is `NativeSwapLinkFacts`
impl NativeSwapLinkFacts {
    fn new(strategy: NativeSwapLinkStrategy, resident_identity: String, candidate_identity: String) -> Self NativeSwapError! {
        _ :: validate_identity(resident_identity, "resident link identity") ?? return .Err(NativeSwapError.input(^resident_identity, .InvalidIdentity, err))
        _ :: validate_identity(candidate_identity, "candidate link identity") ?? return .Err(NativeSwapError.input(^candidate_identity, .InvalidIdentity, err))
        Self { strategy, resident_identity: ^resident_identity, candidate_identity: ^candidate_identity }
    }
    fn resident(identity: String) -> Self NativeSwapError! { Self.new(.ReuseResident, identity.copy(), ^identity) }
}
impl NativeSwapLinkFacts.Default {
    fn default() -> Self {
        // Opaque labels only: this does not claim a linker has run.
        Self { strategy: .ReuseResident, resident_identity: "resident", candidate_identity: "candidate" }
    }
}
struct NativeSwapQuiescence { required: Bool; active_operations: U64; reached: Bool }
impl NativeSwapQuiescence {
    fn ready() -> Self { Self { required: true, active_operations: 0, reached: true } }
    fn pending(active_operations: U64) -> Self { Self { required: true, active_operations, reached: false } }
    fn not_required() -> Self { Self { required: false, active_operations: 0, reached: true } }
    fn is_ready(self) -> Bool { self.reached && self.active_operations == 0 }
}
enum NativeSwapBlockingFact {
    None; InvalidIdentity; InvalidRevision; SourceIdentityChanged; CodeRevisionUnsupported; DataRevisionUnsupported;
    IncompatibleType; ConnectionHandleStale; LayoutChanged; UnsafeEdit; RestartRequired; ListenerHandleMissing;
    ListenerHandleIncompatible; ListenerHandleStale; ConnectionHandleMissing; ConnectionHandleIncompatible;
    ConnectionListenerNotPreserved; DuplicateIdentity; FactLimit; QuiescenceRequired; RelocationUnsupported;
    LinkStrategyUnsupported; StaleReference; StalePlan; InvalidPhase; CompileFailed; MigrationFailed;
    RollbackUnavailable; CapabilityUnavailable
}
impl NativeSwapBlockingFact {
    fn as_str(self) -> String {
        if self == {
            .None -> "none", .InvalidIdentity -> "invalid_identity", .InvalidRevision -> "invalid_revision"
            .SourceIdentityChanged -> "source_identity_changed", .CodeRevisionUnsupported -> "code_revision_unsupported"
            .DataRevisionUnsupported -> "data_revision_unsupported", .IncompatibleType -> "incompatible_type"
            .ConnectionHandleStale -> "connection_handle_stale", .LayoutChanged -> "layout_changed", .UnsafeEdit -> "unsafe_edit"
            .RestartRequired -> "restart_required", .ListenerHandleMissing -> "listener_handle_missing"
            .ListenerHandleIncompatible -> "listener_handle_incompatible", .ListenerHandleStale -> "listener_handle_stale"
            .ConnectionHandleMissing -> "connection_handle_missing", .ConnectionHandleIncompatible -> "connection_handle_incompatible"
            .ConnectionListenerNotPreserved -> "connection_listener_not_preserved", .DuplicateIdentity -> "duplicate_identity"
            .FactLimit -> "fact_limit", .QuiescenceRequired -> "quiescence_required", .RelocationUnsupported -> "relocation_unsupported"
            .LinkStrategyUnsupported -> "link_strategy_unsupported", .StaleReference -> "stale_reference", .StalePlan -> "stale_plan"
            .InvalidPhase -> "invalid_phase", .CompileFailed -> "compile_failed", .MigrationFailed -> "migration_failed"
            .RollbackUnavailable -> "rollback_unavailable", .CapabilityUnavailable -> "capability_unavailable"
        }
    }
    fn is_restartable(self) -> Bool {
        self == .CodeRevisionUnsupported || self == .DataRevisionUnsupported || self == .IncompatibleType ||
        self == .LayoutChanged || self == .RestartRequired || self == .RelocationUnsupported || self == .LinkStrategyUnsupported
    }
}
impl NativeSwapBlockingFact.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.as_str()) }
}
enum NativeSwapDisposition { Swap; Restart; Rejected }
impl NativeSwapDisposition {
    fn as_str(self) -> String { if self == {
        .Swap -> "swap"
        .Restart -> "restart"
        .Rejected -> "rejected"
    } }
}
impl NativeSwapDisposition.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.as_str()) }
}
struct NativeSwapExplanation {
    source_id: String
    disposition: NativeSwapDisposition
    blocking_fact: NativeSwapBlockingFact
    detail: String
}
impl NativeSwapExplanation {
    fn new(source_id: String, disposition: NativeSwapDisposition, blocking_fact: NativeSwapBlockingFact, detail: String) -> Self {
        Self { source_id: bounded_text(source_id, MAX_NATIVE_SWAP_ID_BYTES), disposition, blocking_fact, detail: bounded_text(detail, MAX_NATIVE_SWAP_DETAIL_BYTES) }
    }
    fn compatible(source_id: String) -> Self {
        Self.new(^source_id, .Swap, .None, "code/data and explicit resident handles are compatible")
    }
    fn render(self: Self) -> String {
        "reload disposition={self.disposition.as_str()} source={self.source_id} blocking_fact={self.blocking_fact.as_str()} detail={self.detail}"
    }
}
impl NativeSwapExplanation.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.render()) }
}
#Error
struct NativeSwapError { explanation: NativeSwapExplanation }
impl NativeSwapError {
    fn input(source_id: String, blocking_fact: NativeSwapBlockingFact, detail: String) -> Self {
        Self { explanation: NativeSwapExplanation.new(^source_id, .Rejected, blocking_fact, ^detail) }
    }
    fn restart(source_id: String, blocking_fact: NativeSwapBlockingFact, detail: String) -> Self {
        Self { explanation: NativeSwapExplanation.new(^source_id, .Restart, blocking_fact, ^detail) }
    }
    fn explanation(self: Self) -> NativeSwapExplanation { &self.explanation }
    fn source_id(self: Self) -> String { self.explanation.source_id }
    fn blocking_fact(self: Self) -> NativeSwapBlockingFact { self.explanation.blocking_fact }
    fn render(self: Self) -> String { self.explanation.render() }
}
impl NativeSwapError.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.render()) }
}
// NativeSwapError's #Error supplies the std.error.Error contract.
enum NativeSwapHandleCompatibility { Compatible; Incompatible }
impl NativeSwapHandleCompatibility {
    fn as_str(self) -> String { if self == {
        .Compatible -> "compatible"
        .Incompatible -> "incompatible"
    } }
    fn is_compatible(self) -> Bool { self == .Compatible }
}
struct NativeSwapListenerHandle {
    id: String
    source: NativeSwapSourceIdentity
    generation: U64
    compatibility: NativeSwapHandleCompatibility
}
impl NativeSwapListenerHandle {
    fn new(id: String, source: NativeSwapSourceIdentity, generation: U64, compatibility: NativeSwapHandleCompatibility) -> Self NativeSwapError! {
        _ :: validate_identity(id, "listener handle identity") ?? return .Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        _ :: validate_source_identity(&source, "listener") ?? return .Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        Self { id: ^id, source: ^source, generation, compatibility }
    }
    fn compatible(id: String, source: NativeSwapSourceIdentity, generation: U64) -> Self NativeSwapError! { Self.new(^id, ^source, generation, .Compatible) }
    fn incompatible(id: String, source: NativeSwapSourceIdentity, generation: U64) -> Self NativeSwapError! { Self.new(^id, ^source, generation, .Incompatible) }
    fn is_compatible(self: Self) -> Bool { self.compatibility.is_compatible() }
}
struct NativeSwapConnectionHandle {
    id: String
    listener_id: String
    source: NativeSwapSourceIdentity
    generation: U64
    compatibility: NativeSwapHandleCompatibility
}
impl NativeSwapConnectionHandle {
    fn new(id: String, listener_id: String, source: NativeSwapSourceIdentity, generation: U64, compatibility: NativeSwapHandleCompatibility) -> Self NativeSwapError! {
        _ :: validate_identity(id, "connection handle identity") ?? return .Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        _ :: validate_identity(listener_id, "connection listener identity") ?? return .Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        _ :: validate_source_identity(&source, "connection") ?? return .Err(NativeSwapError.input(source.canonical(), .InvalidIdentity, err))
        Self { id: ^id, listener_id: ^listener_id, source: ^source, generation, compatibility }
    }
    fn compatible(id: String, listener_id: String, source: NativeSwapSourceIdentity, generation: U64) -> Self NativeSwapError! { Self.new(^id, ^listener_id, ^source, generation, .Compatible) }
    fn incompatible(id: String, listener_id: String, source: NativeSwapSourceIdentity, generation: U64) -> Self NativeSwapError! { Self.new(^id, ^listener_id, ^source, generation, .Incompatible) }
    fn is_compatible(self: Self) -> Bool { self.compatibility.is_compatible() }
}
struct NativeSwapCapability {
    code: NativeSwapCodePolicy
    data: NativeSwapDataPolicy
    listeners: NativeSwapHandlePolicy
    connections: NativeSwapHandlePolicy
    restart: Bool
    quiescence: NativeSwapQuiescencePolicy
    relocation: NativeSwapRelocationStrategy
    link: NativeSwapLinkStrategy
}
impl NativeSwapCapability {
    fn resident() -> Self {
        Self { code: .Replace, data: .Preserve, listeners: .ExplicitCompatible, connections: .ExplicitCompatible,
            restart: true, quiescence: .Required, relocation: .StableIdentity, link: .ReuseResident }
    }
    fn with_relocation(self: Self, strategy: NativeSwapRelocationStrategy) -> Self { self.relocation = strategy; self }
    fn with_link(self: Self, strategy: NativeSwapLinkStrategy) -> Self { self.link = strategy; self }
    fn allows_restart(self) -> Bool { self.restart }
}
impl NativeSwapCapability.Default {
    fn default() -> Self { Self.resident() }
}
struct NativeSwapRestartBoundary {
    required: Bool
    reason: NativeSwapBlockingFact?
    affected: [String]
    kept: [String]
    reset: [String]
}
impl NativeSwapRestartBoundary {
    fn in_place() -> Self { Self { required: false, reason: .None, affected: [], kept: [], reset: [] } }
    fn required(reason: NativeSwapBlockingFact, affected: [String]) -> Self {
        Self { required: true, reason: .Val(reason), affected: normalized_facts(^affected), kept: [], reset: [] }
    }
    fn with_state(self: Self, kept: [String], reset: [String]) -> Self {
        self.kept = normalized_facts(^kept)
        self.reset = normalized_facts(^reset)
        self
    }
    fn validate(self: &Self, source_id: String) NativeSwapError! {
        validate_fact_list(source_id, &self.affected)
        validate_fact_list(source_id, &self.kept)
        validate_fact_list(source_id, &self.reset)
        if self.required && self.reason.is_none() -> return .Err(NativeSwapError.input(source_id, .RestartRequired, "restart boundary is required but has no blocking fact"))
        if !self.required && self.reason.is_some() -> return .Err(NativeSwapError.input(source_id, .RestartRequired, "in-place boundary carries a restart reason"))
        if self.reason == .Val(reason) {
            if !reason.is_restartable() -> return .Err(NativeSwapError.input(source_id, reason, "restart boundary reason `{reason.as_str()}` cannot be handled by a clean restart"))
        }
        kept_index := [String:Bool]{}
        loop kept in self.kept -> kept_index.insert(kept, true)
        loop value in self.reset {
            if kept_index.contains_key(value) -> return .Err(NativeSwapError.input(source_id, .DuplicateIdentity, "restart state `{value}` is both kept and reset"))
        }
    }
}
impl NativeSwapRestartBoundary.Default {
    fn default() -> Self { Self.in_place() }
}
struct NativeSwapPlan {
    source: NativeSwapSourceIdentity
    from: NativeSwapExecutable
    to: NativeSwapExecutable
    decision: HotSwapDecision
    capability: NativeSwapCapability
    preserve_listeners: [NativeSwapListenerHandle]
    preserve_connections: [NativeSwapConnectionHandle]
    restart_boundary: NativeSwapRestartBoundary
    quiescence: NativeSwapQuiescence
    relocation: NativeSwapRelocationFacts
    link: NativeSwapLinkFacts
    changed_items: [String]
    removed_definitions: [String]
    blocking_fact: NativeSwapBlockingFact?
}
impl NativeSwapPlan {
    fn new(source: NativeSwapSourceIdentity, from: NativeSwapExecutable, to: NativeSwapExecutable, capability: NativeSwapCapability, decision: HotSwapDecision) -> Self NativeSwapError! {
        source_id :: source.canonical()
        validate_hot_swap_decision(source_id, &source, &decision)
        if !from.source.matches(&source) || !to.source.matches(&source) -> return .Err(NativeSwapError.input(source_id, .SourceIdentityChanged, "plan source does not match both executable identities"))
        if to.generation <= from.generation -> return .Err(NativeSwapError.input(source.canonical(), .StalePlan, "candidate generation must advance beyond the resident generation"))
        restart_boundary :: if decision.is_compatible() -> NativeSwapRestartBoundary.in_place() else -> decision_restart_boundary(&decision)
        changed_items :: normalized_facts(decision.changed_functions.copy())
        Self { source: ^source, from: ^from, to: ^to, decision: ^decision, capability: ^capability,
            preserve_listeners: [], preserve_connections: [], restart_boundary: ^restart_boundary,
            quiescence: NativeSwapQuiescence.ready(), relocation: NativeSwapRelocationFacts.default(),
            link: NativeSwapLinkFacts.default(), changed_items: ^changed_items, removed_definitions: [], blocking_fact: .None }
    }
    fn mark_layout_changed(self: Self, affected: [String]) -> Self {
        self.blocking_fact = .Val(.LayoutChanged)
        self.restart_boundary = NativeSwapRestartBoundary.required(.LayoutChanged, ^affected)
        self
    }
    fn with_quiescence(self: Self, quiescence: NativeSwapQuiescence) -> Self { self.quiescence = quiescence; self }
    fn with_relocation(self: Self, relocation: NativeSwapRelocationFacts) -> Self { self.relocation = ^relocation; self }
    fn with_link(self: Self, link: NativeSwapLinkFacts) -> Self { self.link = ^link; self }
    fn preserve_listener(self: Self, handle: NativeSwapListenerHandle) -> Self {
        self.preserve_listeners.push(^handle)
        self.preserve_listeners.sort()
        self
    }
    fn preserve_connection(self: Self, handle: NativeSwapConnectionHandle) -> Self {
        self.preserve_connections.push(^handle)
        self.preserve_connections.sort()
        self
    }
    fn code_changed(self: Self) -> Bool { !self.from.revision.code_unchanged(&self.to.revision) }
    fn data_changed(self: Self) -> Bool { !self.from.revision.data_unchanged(&self.to.revision) }
    fn requires_restart(self: Self) -> Bool {
        self.decision.requires_restart() || self.restart_boundary.required || self.blocking_fact.is_some_and((fact) -> fact.is_restartable())
    }
    fn explanation(self: Self) -> NativeSwapExplanation {
        if !self.decision.is_compatible() {
            disposition :: if self.capability.restart -> NativeSwapDisposition.Restart else -> NativeSwapDisposition.Rejected
            return NativeSwapExplanation.new(self.source.canonical(), disposition, .IncompatibleType,
                self.decision.compatibility.reason().unwrap_or("semantic hot-swap verdict requires a clean restart"))
        }
        state :: NativeSwapState.new(self.from.copy(), self.preserve_listeners.copy(), self.preserve_connections.copy()) ?? return err.explanation.copy()
        state.explain_reload(self)
    }
    fn validate_shape(self: &Self) NativeSwapError! {
        source_id :: self.source.canonical()
        loop (label, identity) in [("plan", &self.source), ("resident executable", &self.from.source), ("candidate executable", &self.to.source)] {
            _ :: validate_source_identity(identity, label) ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        }
        if !self.from.source.matches(&self.source) || !self.to.source.matches(&self.source) -> return .Err(NativeSwapError.input(source_id, .SourceIdentityChanged, "plan source does not match both executable identities"))
        if self.to.generation <= self.from.generation -> return .Err(NativeSwapError.input(source_id, .StalePlan, "candidate generation must advance beyond the resident generation"))
        validate_hot_swap_decision(source_id, &self.source, &self.decision)
        self.restart_boundary.validate(source_id)
        validate_fact_list(source_id, &self.changed_items)
        validate_fact_list(source_id, &self.removed_definitions)
        validate_fact_list(source_id, &self.relocation.code_symbols)
        validate_fact_list(source_id, &self.relocation.data_slots)
        validate_listener_plan_facts(source_id, &self.source, &self.preserve_listeners)
        validate_connection_plan_facts(source_id, &self.source, &self.preserve_connections)
        loop (label, identity) in [("resident link identity", self.link.resident_identity), ("candidate link identity", self.link.candidate_identity)] {
            _ :: validate_identity(identity, label) ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        }
    }
}
struct NativeSwapReceipt {
    source: NativeSwapSourceIdentity
    outcome: NativeSwapOutcome
    before: NativeSwapRevision
    after: NativeSwapRevision
    before_generation: U64
    after_generation: U64
    preserved_listeners: [String]
    reset_listeners: [String]
    preserved_connections: [String]
    reset_connections: [String]
    restart_boundary: NativeSwapRestartBoundary
    explanation: NativeSwapExplanation?
}
enum NativeSwapOutcome { Committed; RolledBack; Rejected; RestartRequired }
impl NativeSwapOutcome {
    fn as_str(self) -> String { if self == {
        .Committed -> "committed"
        .RolledBack -> "rolled_back"
        .Rejected -> "rejected"
        .RestartRequired -> "restart_required"
    } }
}
impl NativeSwapReceipt {
    fn committed(self: Self) -> Bool { self.outcome == .Committed }
    fn rolled_back(self: Self) -> Bool { self.outcome == .RolledBack }
    fn rejected(self: Self) -> Bool { self.outcome == .Rejected || self.outcome == .RestartRequired }
    fn render(self: Self) -> String {
        explanation :: self.explanation.as_ref().map((value) -> value.render()).unwrap_or("none")
        "native-swap outcome={self.outcome.as_str()} source={self.source.canonical()} before=code:{self.before.code.as_str()}+data:{self.before.data.as_str()}@{self.before_generation} after=code:{self.after.code.as_str()}+data:{self.after.data.as_str()}@{self.after_generation} preserved_listeners=[{self.preserved_listeners.join(",")}] reset_listeners=[{self.reset_listeners.join(",")}] preserved_connections=[{self.preserved_connections.join(",")}] reset_connections=[{self.reset_connections.join(",")}] restart={self.restart_boundary.required} explanation={explanation}"
    }
}
impl NativeSwapOutcome.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.as_str()) }
}
enum NativeSwapPhase { Ready; Paused; Applied }
impl NativeSwapPhase {
    fn as_str(self) -> String { if self == {
        .Ready -> "ready"
        .Paused -> "paused"
        .Applied -> "applied"
    } }
}
impl NativeSwapPhase.Display {
    fn fmt(self: Self, output: fmt.Formatter) -> fmt.Result { output.write_str(self.as_str()) }
}
struct NativeSwapCheckpoint {
    executable: NativeSwapExecutable
    listeners: [String:NativeSwapListenerHandle]
    connections: [String:NativeSwapConnectionHandle]
}
struct NativeSwapWorkingReceipt {
    source: NativeSwapSourceIdentity
    before: NativeSwapExecutable
    after: NativeSwapExecutable
    preserved_listeners: [String]
    reset_listeners: [String]
    preserved_connections: [String]
    reset_connections: [String]
    restart_boundary: NativeSwapRestartBoundary
}
struct NativeSwapState {
    executable: NativeSwapExecutable
    listeners: [String:NativeSwapListenerHandle]
    connections: [String:NativeSwapConnectionHandle]
    phase: NativeSwapPhase
    checkpoint: NativeSwapCheckpoint?
    pending_plan: NativeSwapPlan?
    working_receipt: NativeSwapWorkingReceipt?
}
impl NativeSwapState {
    fn new(executable: NativeSwapExecutable, listeners: [NativeSwapListenerHandle], connections: [NativeSwapConnectionHandle]) -> Self NativeSwapError! {
        source_id :: executable.source.canonical()
        _ :: validate_source_identity(&executable.source, "executable") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        listener_map :: listener_map(source_id, &executable, ^listeners)
        connection_map :: connection_map(source_id, &executable, ^connections, &listener_map)
        Self { executable: ^executable, listeners: ^listener_map, connections: ^connection_map,
            phase: .Ready, checkpoint: .None, pending_plan: .None, working_receipt: .None }
    }
    fn empty(executable: NativeSwapExecutable) -> Self NativeSwapError! { Self.new(^executable, [], []) }
    fn executable(self: Self) -> NativeSwapExecutable { &self.executable }
    fn source(self: Self) -> NativeSwapSourceIdentity { &self.executable.source }
    fn revision(self: Self) -> NativeSwapRevision { &self.executable.revision }
    fn generation(self: Self) -> U64 { self.executable.generation }
    fn phase(self: Self) -> NativeSwapPhase { self.phase }
    fn is_paused(self: Self) -> Bool { self.phase == .Paused }
    fn is_applied(self: Self) -> Bool { self.phase == .Applied }
    fn listeners(self: Self) -> [NativeSwapListenerHandle] {
        keys := self.listeners.keys().cloned().collect[[String]]()
        keys.sort()
        keys.iter().map((key) -> self.listeners[key].copy()).collect()
    }
    fn connections(self: Self) -> [NativeSwapConnectionHandle] {
        keys := self.connections.keys().cloned().collect[[String]]()
        keys.sort()
        keys.iter().map((key) -> self.connections[key].copy()).collect()
    }
    fn listener(self: Self, id: String) -> NativeSwapListenerHandle? { self.listeners.get(id) }
    fn connection(self: Self, id: String) -> NativeSwapConnectionHandle? { self.connections.get(id) }
    fn listener_count(self: Self) -> USize { self.listeners.len() }
    fn connection_count(self: Self) -> USize { self.connections.len() }
    fn preflight(self: &Self, plan: &NativeSwapPlan) NativeSwapError! { self.validate_plan(plan) }
    fn explain_reload(self: Self, plan: NativeSwapPlan) -> NativeSwapExplanation {
        _ :: self.validate_plan(plan) ?? return err.explanation.copy()
        NativeSwapExplanation.compatible(plan.source.canonical())
    }
    fn pause(self: &Self, plan: &NativeSwapPlan) NativeSwapError! {
        if self.phase != .Ready -> return .Err(self.phase_error("pause requires a ready transaction"))
        self.validate_plan(plan)
        checkpoint :: NativeSwapCheckpoint { executable: self.executable.copy(), listeners: self.listeners.copy(), connections: self.connections.copy() }
        self.checkpoint = .Val(^checkpoint)
        self.pending_plan = .Val(plan.copy())
        self.working_receipt = .None
        self.phase = .Paused
    }
    fn apply(self: &Self, plan: &NativeSwapPlan) NativeSwapError! {
        if self.phase != .Paused -> return .Err(self.phase_error("apply requires a paused transaction"))
        if self.pending_plan.as_ref() != .Val(plan) -> return .Err(NativeSwapError.input(self.source().canonical(), .StalePlan, "apply plan does not match the paused plan"))
        self.validate_plan(plan)
        checkpoint :: self.checkpoint.as_ref() ?? return .Err(self.error(.RollbackUnavailable, "apply checkpoint is missing"))
        preserved_listener_ids := [String:Bool]{}
        loop handle in plan.preserve_listeners -> preserved_listener_ids.insert(handle.id.copy(), true)
        preserved_connection_ids := [String:Bool]{}
        loop handle in plan.preserve_connections -> preserved_connection_ids.insert(handle.id.copy(), true)
        next_listeners := [String:NativeSwapListenerHandle]{}
        loop handle in plan.preserve_listeners {
            preserved := handle.copy()
            preserved.generation = plan.to.generation
            next_listeners.insert(preserved.id.copy(), ^preserved)
        }
        next_connections := [String:NativeSwapConnectionHandle]{}
        loop handle in plan.preserve_connections {
            preserved := handle.copy()
            preserved.generation = plan.to.generation
            next_connections.insert(preserved.id.copy(), ^preserved)
        }
        reset_listeners := checkpoint.listeners.keys().filter((id) -> !preserved_listener_ids.contains_key(id)).cloned().collect[[String]]()
        reset_listeners.sort()
        reset_connections := checkpoint.connections.keys().filter((id) -> !preserved_connection_ids.contains_key(id)).cloned().collect[[String]]()
        reset_connections.sort()
        listener_ids := preserved_listener_ids.keys().cloned().collect[[String]]()
        listener_ids.sort()
        connection_ids := preserved_connection_ids.keys().cloned().collect[[String]]()
        connection_ids.sort()
        working :: NativeSwapWorkingReceipt { source: plan.source.copy(), before: checkpoint.executable.copy(), after: plan.to.copy(),
            preserved_listeners: ^listener_ids, reset_listeners: ^reset_listeners,
            preserved_connections: ^connection_ids, reset_connections: ^reset_connections,
            restart_boundary: plan.restart_boundary.copy() }
        // Every fallible check and all receipt facts are complete before the first resident mutation.
        self.executable = plan.to.copy()
        self.listeners = ^next_listeners
        self.connections = ^next_connections
        self.working_receipt = .Val(^working)
        self.phase = .Applied
    }
    fn commit(self: Self) -> NativeSwapReceipt NativeSwapError! {
        if self.phase != .Applied -> return .Err(self.phase_error("commit requires an applied transaction"))
        working :: self.working_receipt.take() ?? return .Err(self.error(.InvalidPhase, "applied transaction has no working receipt"))
        receipt :: receipt_from_working(&working, .Committed, .None)
        self.checkpoint = .None
        self.pending_plan = .None
        self.phase = .Ready
        receipt
    }
    fn rollback(self: Self) -> NativeSwapReceipt NativeSwapError! {
        if self.phase != .Paused && self.phase != .Applied -> return .Err(self.phase_error("rollback requires a paused or applied transaction"))
        checkpoint :: self.checkpoint.take() ?? return .Err(self.error(.RollbackUnavailable, "rollback checkpoint is missing"))
        before :: &self.executable
        preserved_listeners := checkpoint.listeners.keys().cloned().collect[[String]]()
        preserved_listeners.sort()
        reset_listeners := self.listeners.keys().filter((id) -> !checkpoint.listeners.contains_key(id)).cloned().collect[[String]]()
        reset_listeners.sort()
        preserved_connections := checkpoint.connections.keys().cloned().collect[[String]]()
        preserved_connections.sort()
        reset_connections := self.connections.keys().filter((id) -> !checkpoint.connections.contains_key(id)).cloned().collect[[String]]()
        reset_connections.sort()
        receipt :: NativeSwapReceipt { source: checkpoint.executable.source.copy(), outcome: .RolledBack,
            before: before.revision.copy(), after: checkpoint.executable.revision.copy(), before_generation: before.generation,
            after_generation: checkpoint.executable.generation, preserved_listeners: ^preserved_listeners,
            reset_listeners: ^reset_listeners, preserved_connections: ^preserved_connections, reset_connections: ^reset_connections,
            restart_boundary: NativeSwapRestartBoundary.in_place(), explanation: .Val(NativeSwapExplanation.new(
                checkpoint.executable.source.canonical(), .Rejected, .UnsafeEdit, "rollback restored the prior executable and explicit handles")) }
        self.executable = ^checkpoint.executable
        self.listeners = ^checkpoint.listeners
        self.connections = ^checkpoint.connections
        self.pending_plan = .None
        self.working_receipt = .None
        self.phase = .Ready
        receipt
    }
}
// The Rust original reject (continued in NativeSwap02) retains the current
// executable and handles when compilation or migration fails before pause can
// begin.
