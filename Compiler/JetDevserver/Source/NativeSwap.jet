//RS /// Whether `jet explain --reload` recommends an in-place swap or a restart.
//RS #[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
//RS pub enum NativeSwapDisposition {
//RS     /// The checked plan may be applied in place.
//RS     Swap,
//RS     /// The plan is valid evidence for a clean restart, but this module will
