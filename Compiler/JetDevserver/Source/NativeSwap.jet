// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! Backend-neutral facts and transaction state for a resident native swap.
//RS //!
//RS //! This module deliberately stops before a linker, socket, scheduler, or
//RS //! operating-system adapter.  A compiler/sema producer supplies the source,
//RS //! revision, compatibility, relocation, and link facts.  A native host can
//RS //! then consume the checked plan without re-deciding what an edit means.
//RS //!
//RS //! A swap is a small compare-and-commit transaction:
//RS //!
//RS //! 1. [`NativeSwapState::pause`] validates every fact while the old executable
//RS //!    is still live and records a checkpoint.
//RS //! 2. [`NativeSwapState::apply`] installs only the already validated candidate
//RS //!    and only the listener/connection handles named by the plan.
//RS //! 3. [`NativeSwapState::commit`] drops the checkpoint and publishes a receipt.
//RS //!    [`NativeSwapState::rollback`] restores the checkpoint exactly.
//RS //!
//RS //! No method waits for quiescence or performs a native operation.  Quiescence,
//RS //! relocation, and link strategy are facts that an adapter must prove before it
//RS //! hands a plan to this boundary.
//RS 
//RS use std::collections::{BTreeMap, BTreeSet};
//RS use std::fmt;
//RS 
//RS use jet_foundation::HotSwap::{HotSwapDecision, StateRetentionDecision};
//RS 
//RS /// Protocol label for a future native devtools/reload projection.
//RS pub const NATIVE_SWAP_PROTOCOL: &str = "jet.native.swap.v1";
//RS /// Maximum bytes accepted for one stable source, handle, symbol, or revision identity.
//RS pub const MAX_NATIVE_SWAP_ID_BYTES: usize = 256;
//RS /// Maximum bytes retained for one human-readable explanation.
//RS pub const MAX_NATIVE_SWAP_DETAIL_BYTES: usize = 1024;
//RS /// Maximum number of typed handle or changed-item facts in one plan.
//RS pub const MAX_NATIVE_SWAP_FACTS: usize = 1024;
//RS 
