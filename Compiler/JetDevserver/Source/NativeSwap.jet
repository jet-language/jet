//RS /// Why a plan cannot be applied as an in-place native swap.
//RS #[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
//RS pub enum NativeSwapBlockingFact {
//RS     /// No fact blocks the in-place operation.
//RS     None,
//RS     /// A source/module identity is malformed or does not match.
//RS     InvalidIdentity,
//RS     /// A code or data revision is malformed or stale.
//RS     InvalidRevision,
//RS     /// Source identity changed between the resident and candidate images.
//RS     SourceIdentityChanged,
//RS     /// Candidate code revision is not accepted by the capability.
//RS     CodeRevisionUnsupported,
//RS     /// Candidate data/layout revision is not accepted by the capability.
//RS     DataRevisionUnsupported,
//RS     /// The checked semantic type surface changed.
//RS     IncompatibleType,
//RS     /// A connection handle belongs to another source or generation.
//RS     ConnectionHandleStale,
//RS     LayoutChanged,
//RS     /// An unsafe edit was offered to the resident boundary.
//RS     UnsafeEdit,
//RS     /// A restart boundary was explicitly required.
//RS     RestartRequired,
//RS     /// A listener handle was not explicitly supplied.
//RS     ListenerHandleMissing,
//RS     /// A listener handle was supplied but marked incompatible.
//RS     ListenerHandleIncompatible,
//RS     /// A listener handle belongs to another source or generation.
//RS     ListenerHandleStale,
//RS     /// A connection handle was not explicitly supplied.
//RS     ConnectionHandleMissing,
//RS     /// A connection handle was supplied but marked incompatible.
//RS     ConnectionHandleIncompatible,
//RS     /// A connection's listener was not explicitly preserved.
//RS     ConnectionListenerNotPreserved,
//RS     /// The plan has duplicate handle or changed-item identity.
//RS     DuplicateIdentity,
//RS     /// The plan has too many typed facts.
//RS     FactLimit,
//RS     /// The boundary was not quiescent.
//RS     QuiescenceRequired,
//RS     /// Relocation facts do not permit in-place activation.
//RS     RelocationUnsupported,
//RS     /// Link facts do not permit in-place activation.
//RS     LinkStrategyUnsupported,
//RS     /// A removed definition would leave an old reference callable.
//RS     StaleReference,
//RS     /// The plan no longer describes the current executable.
//RS     StalePlan,
//RS     /// The transaction method was called in the wrong phase.
//RS     InvalidPhase,
//RS     /// Candidate compilation failed before activation.
//RS     CompileFailed,
//RS     /// Candidate data migration failed before activation.
//RS     MigrationFailed,
//RS     /// No checkpoint remains to restore.
//RS     RollbackUnavailable,
//RS     /// A capability does not offer the requested operation.
//RS     CapabilityUnavailable,
//RS }
//RS 
