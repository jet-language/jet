        self.diagnostic_revision.lock().unwrap().clear()
        self.publish_session_state("ready", "", "")
    }
    // Rust: crates/jet-devserver/src/Session.rs:793
    pub fn mark_error(self: &Self, code: String, diagnostic: String) -> Unit {
