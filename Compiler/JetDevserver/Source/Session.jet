    pub fn take_project_rebuild(self: &Self) -> JetDevtoolsProjectRebuildRequest? Err! {
        command :: self.poll_devtools_command() ?? return .None
        if command == .ProjectRebuild(request) {
            if request.session_id != self.id {
                self.update_command_receipt(request.request_id, "failed", .Val("jet.devtools.v1 command session identity mismatch"))
                return .Err("jet.devtools.v1 command session identity mismatch")
            }
            if !self.project_rebuild_executor_available() {
                error :: "no rebuild executor is registered for this host"
                self.update_command_receipt(request.request_id, "failed", .Val(error))
                return .Err(error)
            }
            if request.expected_revision != self.current_revision() {
                error :: "source changed since this rebuild was requested"
                self.update_command_receipt(request.request_id, "failed", .Val(error))
                return .Err(error)
            }
            self.update_command_receipt(request.request_id, "building", .None)
            .Val(^request)
        } else {
            jet_foundation.DevtoolsControl.jet_devtools_requeue_command_front(^command)?
            .None
        }
    }
