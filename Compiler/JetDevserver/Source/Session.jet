    // Rust: crates/jet-devserver/src/Session.rs:1411
    pub fn divergence(self: &Self) -> DevtoolsRecordingDivergence Err! {
        (envelope_sequence, envelope_identity) :: {
            state :: self.devtools_lock()
            (state.envelope.latest_sequence(), ~state.envelope.source_identity)
        }
        recording :: self.recording.lock() ?? return .Err("devtools recording state is unavailable because its lock is poisoned")
        state :: recording.as_ref() ?? return .Err(recording_unavailable())
        expected_sequence :: state.first_sequence.and_then((first) -> envelope_sequence.filter((sequence) -> *sequence >= first))
        actual_sequence :: state.recording.events().last().map((event) -> event.sequence())
        reason: String? := .None
        if envelope_identity.as_ref().map_or(true, (identity) ->
            identity.source_id.as_ref() != .Val(&state.recording.identity().source_id) || identity.build_id.as_ref() != .Val(&state.recording.identity().build_id)) {
            reason = .Val("resident source/build identity differs from recording")
        } else if expected_sequence != actual_sequence -> reason = .Val("resident event tail differs from recording")
        else if state.recording.projection(&state.cursor) == .Err(error) -> reason = .Val(error.to_string())
        truncation :: state.recording.truncation()
        DevtoolsRecordingDivergence { divergent: reason.is_some(), reason: ^reason, identity: ~state.recording.identity(),
            expected_sequence, actual_sequence, retained_events: state.recording.event_count(), dropped_events: truncation.dropped_events, truncation }
    }
    // Rust: crates/jet-devserver/src/Session.rs:1454
    pub fn recording_control(self: &Self, payload: String) -> String Err! {
        root :: parse_json_with_limit(payload, JET_DEVTOOLS_MAX_ENVELOPE_BYTES) ?? return .Err("recording control must be valid bounded JSON")
        object :: object_map(&root) ?? return .Err("recording control must be a JSON object")
        operation :: object.get("op").or_else(() -> object.get("action")).and_then(json_string) ?? return .Err("recording control must include string op")
        if operation == {
            "scrub" -> {
                sequence :: object.get("sequence").and_then(json_u64) ?? return .Err("recording scrub requires non-negative sequence")
                _ :: self.scrub(sequence)?
            }
            "scrub_time" -> {
                timestamp_ms :: object.get("timestamp_ms").and_then(json_u64) ?? return .Err("recording scrub_time requires non-negative timestamp_ms")
                _ :: self.scrub_time(timestamp_ms)?
            }
            "step" -> if object.get("direction").and_then(json_string) == {
                .None | .Val("forward") -> _ :: self.step()?
                .Val("backward") | .Val("reverse") -> return .Err("recording step is forward-only")
                .Val(direction) -> return .Err("unknown recording step direction `{direction}`")
            }
            "skip" -> {
                count :: object.get("count").and_then(json_u64) ?? return .Err("recording skip requires non-negative count")
                _ :: self.skip(count)?
            }
            "checkpoint" -> {
                name :: object.get("name").and_then(json_string) ?? return .Err("recording checkpoint requires string name")
                _ :: self.checkpoint(name)?
            }
            "restore" -> {
                name :: object.get("name").and_then(json_string) ?? return .Err("recording restore requires string name")
                _ :: self.restore(name)?
            }
            "divergence" -> _ :: self.divergence()?
            _ -> return .Err("unknown recording operation `{operation}`")
        }
        self.recording_json()
    }
    // Rust: crates/jet-devserver/src/Session.rs:1522
    pub fn recording_json(self: &Self) -> String {
