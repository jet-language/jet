    // Rust: crates/jet-devserver/src/Session.rs:719
    pub fn capture_facts(self: &Self) -> [CaptureSessionFact] { ~*self.capture_facts.lock().unwrap() }
    // Rust: crates/jet-devserver/src/Session.rs:723
    fn validate_capture_identity(self: &Self, identity: &CaptureIdentity) -> Unit Err! {
        if !identity.is_exact() -> return .Err("capture identity is incomplete")
        if identity.session_id != self.id -> return .Err("capture fact session does not match live session")
        locked :: self.live_lineage.lock().unwrap()
        lineage :: locked.as_ref() ?? return .Err("capture fact has no live lineage")
        if identity.source_id != lineage.source_id || identity.build_id != lineage.build_id || identity.revision != lineage.revision -> return .Err("capture fact does not match live lineage")
    }
    // Rust: crates/jet-devserver/src/Session.rs:745
    pub fn record_live_transaction(self: &Self, snapshot: &SessionSnapshot, decisions: &[PersistOutcome]) -> Unit Err! {
        before :: ~*self.accepted_revision.lock().unwrap()
        self.set_live_lineage(snapshot.source_id, snapshot.build_id, snapshot.revision, snapshot.world_id)?
        values :: decisions.iter().map(persist_outcome_fact).collect::<[LiveValueFact]>()
        *self.live_values.lock().unwrap() = ~values
        lineage :: self.live_lineage.lock().unwrap().clone().expect("validated live lineage")
        *self.accepted_revision.lock().unwrap() = ~snapshot.revision
        self.push_receipt(Receipt { kind: "live_swap", status: "committed", before: ^before, after: ~snapshot.revision, client: "", output: "",
