        recording :: self.recording.lock() ?? return recording_unavailable_json(self.id, "devtools recording state is unavailable because its lock is poisoned")
        state :: recording.as_ref() ?? return recording_unavailable_json(self.id, "source/build identity is unavailable")
        projection :: state.recording.projection(&state.cursor) ?? return recording_unavailable_json(self.id, err.to_string())
        recording_json_for_state(self.id, state, &projection, divergence.as_ref())
    }
    // Rust: crates/jet-devserver/src/Session.rs:1546
    pub fn set_devtools_source_identity(self: &Self, source_id: String?, build_id: String?, revision: String?, world_id: String?) -> Unit Err! {
        recording_identity :: if (source_id.as_ref(), build_id.as_ref()) == {
            (.Val(source), .Val(build)) -> .Val(SessionIdentity.new(source, build).map_err(recording_error)?)
            _ -> .None
        }
        identity :: JetDevtoolsSourceIdentityFact.new(^source_id, ^build_id, ^revision, ^world_id)
        first_sequence :: {
            state :: self.devtools_lock()
            state.envelope.set_source_identity(.Val(^identity))?
            if state.envelope.latest_sequence() == {
                .Val(sequence) -> .Val(sequence.checked_add(1) ?? return .Err("devtools event sequence exhausted"))
                .None -> .Val(1)
            }
        }
        self.set_recording_identity(^recording_identity, first_sequence)
    }
    // Rust: crates/jet-devserver/src/Session.rs:1576
    fn set_recording_identity(self: &Self, identity: SessionIdentity?, first_sequence: U64?) -> Unit Err! {
        recording :: self.recording.lock() ?? return .Err("devtools recording state is unavailable because its lock is poisoned")
        if (recording.as_ref(), identity.as_ref()) == (.Val(state), .Val(identity)) {
            if state.recording.identity() == identity -> return
        }
        *recording = if identity == {
            .Val(identity) -> .Val(ResidentRecordingState.new(SessionRecording.new(^identity).map_err(recording_error)?, first_sequence))
            .None -> .None
        }
    }
    // Rust: crates/jet-devserver/src/Session.rs:1602
    pub fn publish_hot_swap_decision(self: &Self, decision: &HotSwapDecision) -> Unit Err! {
        validate_devtools_text(decision.module, "HotSwap module")?
        compatibility :: if decision.is_compatible() -> "compatible" else -> "incompatible"
        reason :: decision.compatibility.reason().unwrap_or("")
        (kept, reset) :: decision.state.iter().partition((fact) -> fact.is_preserved())
        state :: decision.state.iter().map(retention_fact_json).collect::<[String]>().join(",")
        change_facts :: decision.change_facts.iter().map(game_change_fact_json).collect::<[String]>().join(",")
        kept_keys :: kept.iter().map((fact) -> ~fact.key).collect::<[String]>()
        reset_keys :: reset.iter().map((fact) -> ~fact.key).collect::<[String]>()
        fields :: "{{\"module\":{json_value(decision.module)},\"compatibility\":{json_value(compatibility)},\"reason\":{json_value(reason)},\"changed\":{string_array_json(&decision.changed)},\"changed_functions\":{string_array_json(&decision.changed_functions)},\"state\":[{state}],\"kept\":{string_array_json(&kept_keys)},\"reset\":{string_array_json(&reset_keys)},\"rechecked_items\":{string_array_json(&decision.rechecked_items)},\"change_facts\":[{change_facts}]}}"
        event :: JetDevtoolsEvent.from_parts(unix_time_ms(), "sema", "HotSwap", "module", ^fields)?
        _ :: self.publish_devtools_event_typed(^event)?
    }
    // Rust: crates/jet-devserver/src/Session.rs:1664
    pub fn set_devtools_selection(self: &Self, request: String) -> Unit Err! {
        root :: parse_json(request) ?? return .Err("devtools selection must be valid JSON")
        object :: object_map(&root) ?? return .Err("devtools selection must be an object")
        nested :: object.get("selection").and_then(object_map)
        field :: (key: String) -> object.get(key).or_else(() -> nested.as_ref().and_then((selection) -> selection.get(key))).and_then(json_string).map((text) -> text.to_string())
        clear :: object.get("clear").is_some_and((value) -> if value == { .Bool(true) -> true, _ -> false })
            || object.get("selection") == .Val(.Null)
        panel_id :: field("panel_id").or_else(() -> field("target"))
        item_key :: field("item_key").or_else(() -> field("source_id")).or_else(() -> field("output"))
        origin :: field("origin").unwrap_or("host")
        validate_devtools_text(origin, "selection origin")?
        for (value, label) in [(panel_id.as_ref(), "panel_id"), (item_key.as_ref(), "item_key")] {
            if value == .Val(value) -> validate_devtools_text(value, label)?
        }
        if !clear && panel_id.is_none() && item_key.is_none() -> return .Err("devtools selection has no selected value")
        source_id :: field("source_id")
        output :: field("output")
        target :: field("target")
        if clear {
            *self.selected_source_id.lock().unwrap() = ""
            *self.selected_output.lock().unwrap() = ""
            *self.selected_target.lock().unwrap() = ""
        } else {
            if source_id.as_ref().or(item_key.as_ref()) == .Val(source) -> self.select_project_source(source)
            self.select_output_values(output.as_ref(), target.as_ref().or(panel_id.as_ref()))
        }
        {
            state :: self.devtools_lock()
            if clear -> state.envelope.set_selection(.None)
            else {
                previous_panel :: state.envelope.view().selection().map((selection) -> ~selection.panel_id)
                selected_panel :: panel_id.clone().or(^previous_panel).unwrap_or_default()
                selected_item :: item_key.clone().or_else(() -> state.envelope.view().selection().and_then((selection) -> ~selection.item_key))
                state.envelope.set_selection(.Val(JetDevtoolsSelection.new(^selected_panel, ^selected_item)))
            }
        }
        panel_json :: if clear -> "null" else -> panel_id.as_ref().map(json_value).unwrap_or("null")
        item_json :: if clear -> "null" else -> item_key.as_ref().map(json_value).unwrap_or("null")
        fields :: "{{\"panel_id\":{panel_json},\"item_key\":{item_json},\"cleared\":{clear}}}"
        event :: JetDevtoolsEvent.from_parts(unix_time_ms(), origin, "Selection", "session", ^fields)?
        _ :: self.publish_devtools_event_typed(^event)?
    }
    // Rust: crates/jet-devserver/src/Session.rs:1773
    pub fn set_devtools_cursor(self: &Self, request: String) -> Unit Err! {
        root :: parse_json(request) ?? return .Err("devtools cursor must be valid JSON")
        object :: object_map(&root) ?? return .Err("devtools cursor must be an object")
        origin :: object.get("origin").and_then(json_string).unwrap_or("host")
        validate_devtools_text(origin, "cursor origin")?
        cursor_value :: object.get("cursor").or_else(() -> object.get("sequence"))
        sequence :: if cursor_value == {
            .None | .Val(.Null) -> .None
            .Val(.Object(entries)) -> {
                cursor: [String:DataTree] :: entries.iter().cloned().collect()
                value :: cursor.get("sequence") ?? return .Err("devtools cursor must be a sequence")
                .Val(json_u64(value) ?? return .Err("devtools cursor must be a sequence"))
            }
            .Val(value) -> .Val(json_u64(value) ?? return .Err("devtools cursor must be a sequence"))
        }
        { self.devtools_lock().envelope.set_cursor(sequence) }
        sequence_json :: sequence.map((value) -> value.to_string()).unwrap_or("null")
        fields :: "{{\"sequence\":{sequence_json}}}"
        event :: JetDevtoolsEvent.from_parts(unix_time_ms(), origin, "Cursor", "session", ^fields)?
        _ :: self.publish_devtools_event_typed(^event)?
    }
}
