    // Rust: crates/jet-devserver/src/Session.rs:1003
    pub fn dispatch_pending_devtools_commands(self: &Self) -> USize Err! {
        pending :: jet_foundation.DevtoolsControl.jet_devtools_command_count(self.id).min(32)
        dispatched: USize := 0
        for _ in 0..pending {
            command :: self.poll_devtools_command() ?? break
            if command == {
                .DatabaseExplain(request) -> {
                    if request.session_id != self.id {
                        jet_foundation.DevtoolsControl.jet_devtools_requeue_command_front(.DatabaseExplain(^request))?
                        return .Err("jet.devtools.v1 command session identity mismatch")
                    }
                    if jet_foundation.Devtools.jet_devtools_dispatch_database_explain(request.session_id, request.request_id, request.statement_identity, request.timeout_ms, request.max_rows) == {
                        .Ok(_) -> {
                            self.update_command_receipt(request.request_id, "dispatched", .None)
                            dispatched = dispatched.saturating_add(1)
                        }
                        .Err(error) if error == "database EXPLAIN runtime callback is unavailable" -> {
                            self.update_command_receipt(request.request_id, "waiting", .Val(~error))
                            jet_foundation.DevtoolsControl.jet_devtools_requeue_command_front(.DatabaseExplain(^request))?
                            return dispatched
                        }
                        .Err(error) -> {
                            self.update_command_receipt(request.request_id, "rejected", .Val(~error))
                            result :: JetDevtoolsDatabaseExplainResult.new(~request.session_id, ~request.request_id, ~request.statement_identity,
                                "error", 0, false, 0, [], .Val("dispatch_failed"), .Val(^error))
                                .and_then((result) -> self.publish_database_explain_result(^result, unix_time_ms(), "devserver"))
                            if result == .Err(publish_error) {
                                jet_foundation.DevtoolsControl.jet_devtools_requeue_command_front(.DatabaseExplain(^request))?
                                return .Err(^publish_error)
                            }
                            dispatched = dispatched.saturating_add(1)
                        }
                    }
                }
                .GameControl(request) -> {
                    if request.session_id != self.id {
                        jet_foundation.DevtoolsControl.jet_devtools_requeue_command_front(.GameControl(^request))?
                        return .Err("jet.devtools.v1 game control session identity mismatch")
                    }
                    payload :: request.render_json()
                    if jet_foundation.Devtools.jet_devtools_dispatch_game_control(request.session_id, payload) == {
                        .Ok(_) -> {
                            self.update_command_receipt(request.request_id, "dispatched", .None)
                            dispatched = dispatched.saturating_add(1)
                        }
                        .Err(error) if error == "game control runtime callback is unavailable" -> {
                            if jet_foundation.Devtools.jet_devtools_write_game_control_relay(request.session_id, payload) == {
                                .Ok(_) -> {
                                    self.update_command_receipt(request.request_id, "relayed", .Val(~error))
                                    dispatched = dispatched.saturating_add(1)
                                }
                                .Err(relay_error) -> {
                                    self.update_command_receipt(request.request_id, "waiting", .Val(~relay_error))
                                    jet_foundation.DevtoolsControl.jet_devtools_requeue_command_front(.GameControl(^request))?
                                    return .Err(^relay_error)
                                }
                            }
                        }
                        .Err(error) -> {
                            self.update_command_receipt(request.request_id, "rejected", .Val(~error))
                            jet_foundation.DevtoolsControl.jet_devtools_requeue_command_front(.GameControl(^request))?
                            return .Err(^error)
                        }
                    }
                }
                .ProjectRebuild(request) -> {
                    jet_foundation.DevtoolsControl.jet_devtools_requeue_command_front(.ProjectRebuild(^request))?
                    return dispatched
                }
            }
        }
        dispatched
    }
