// The resident development session one `jet dev` process serves, shared by
// the Canvas, application, terminal, editor and native hosts: source lineage,
// build state, run selection, debugger and capture facts, the devtools
// envelope, the session's own command queue and its recording. It is plain
// owned state. A host keeps it in one `Shared<ResidentDevSession>` and edits
// it under that guard, so a source transaction is serialized by the guard
// itself; there is no lock per field and no process-global registry.
use {
    session_files: core.files
    session_process: core.process
    session_random: core.crypto.random
    session_time: core.time
    core.time.[Stopwatch]
    jet_foundation.[foundation_json_quote, jettrace_has_control]
}

SESSION_MAX_CLIENT_ID: Int{128}
SESSION_MAX_CLIENTS: Int{256}
SESSION_CLIENT_TTL_MS: Int{160}
SESSION_MAX_RECEIPTS: Int{128}
SESSION_MAX_RETAINED_VIEW_BYTES: Int{2097152}
SESSION_MAX_GAME_CONTROL_FRAME: Int{32}
BROWSER_ASSET_WATCH_MAX_FILES: Int{4096}
BROWSER_ASSET_WATCH_MAX_EVENTS: Int{256}
BROWSER_ASSET_WATCH_MAX_PATH_BYTES: Int{1024}

LiveLineage: struct {
    protocol: String
    session_id: String
    source_id: String
    build_id: String
    revision: String
    world_id: String
}
LiveValueFact: struct {
    value_id: String
    type_identity: String
    disposition: String
    reason: String
}
LiveReceipt: struct {
    lineage: LiveLineage
    values: [LiveValueFact]
}
Receipt: struct {
    kind: String
    status: String
    before: String
    after: String
    client: String
    output: String
    live: LiveReceipt?
}
DebuggerSnapshot: struct {
    state: String
    session_id: String
    source_id: String
    revision: String
    tier: String

    idle: fn() -> DebuggerSnapshot Never! { DebuggerSnapshot{state: "idle", session_id: "", source_id: "", revision: "", tier: ""} }
}
RetainedView: struct {
    revision: String
    source_id: String
    payload: String
}
DevtoolsSelectionFact: struct {
    panel_id: String
    item_key: String
}
DevtoolsStatusFact: struct {
    state: JetDevtoolsLifecycleState
    diagnostic_code: String?
    diagnostic: String?
    accepted_revision: String?
    last_good_revision: String?
    run_target: String?
    run_output: String?
    test_state: String?
}
DevtoolsCommandCapabilities: struct {
    project_rebuild: Bool
    project_rebuild_reason: String?
}
// What a host renders after `cursor`: identity, the retained events, the
// selection, status and command facts.
DevtoolsProjection: struct {
    protocol: String
    session_id: String
    source_id: String?
    build_id: String?
    revision: String
    world_id: String?
    sequence: Int
    observed_at: Int
    panels: [JetDevtoolsEvent]
    selection: DevtoolsSelectionFact?
    status: DevtoolsStatusFact
    command_capabilities: DevtoolsCommandCapabilities
    command_receipts: [JetDevtoolsCommandReceipt]
    reset: Bool
    truncation: Bool
}
DevtoolsRecordingDivergence: struct {
    divergent: Bool
    reason: String?
    identity: SessionRecordingIdentity
    expected_sequence: Int?
    actual_sequence: Int?
    retained_events: Int
    dropped_events: Int
    truncation: TruncationFacts
}
// The recording, its live cursor, named checkpoints and the first envelope
// sequence it holds.
ResidentRecordingState: struct {
    recording: SessionRecording
    cursor: ReplayCursor
    checkpoints: [String:SessionCheckpoint]
    first_sequence: Int?

    new: fn(recording: SessionRecording, first_sequence: Int?) -> ResidentRecordingState Never! {
        cursor: recording.replay()
        ResidentRecordingState{recording: recording, cursor: cursor, checkpoints: [String:SessionCheckpoint]{}, first_sequence: first_sequence}
    }
}

// One regular file under the game's `assets` directory.
BrowserAssetStamp: struct {
    modified_ns: Int
    size: Int
}
BrowserAssetChange: struct {
    path: String
    kind: String
}
BrowserAssetPoll: struct {
    changes: [BrowserAssetChange]
    skipped: Int
}
// Polls `<entry dir>/assets` and reports created, changed and deleted files
// as one host_to_runtime frame. Links are skipped, never followed.
BrowserAssetWatcher: struct {
    root: String
    known: [String:BrowserAssetStamp]

    for_entry: fn(entry: String) -> BrowserAssetWatcher {
        watcher := BrowserAssetWatcher{root: browser_asset_root(entry), known: [String:BrowserAssetStamp]{}}
        watcher.snapshot()
        watcher
    }
    reopen: fn(&self, entry: String) {
        self.root = browser_asset_root(entry)
        self.snapshot()
    }
    snapshot: fn(&self) {
        files := [String:BrowserAssetStamp]{}
        skipped := 0
        browser_asset_collect(self.root, files, skipped)
        self.known = files
    }
    poll: fn(&self) -> BrowserAssetPoll {
        current := [String:BrowserAssetStamp]{}
        skipped := 0
        browser_asset_collect(self.root, current, skipped)
        changes := [BrowserAssetChange]{}
        paths := current.keys().to_list()
        paths.sort()
        loop path in paths {
            stamp: current[path]
            if self.known.get(path) == {
                .None -> changes.push(BrowserAssetChange{path: path, kind: "created"})
                .Val(previous) -> if previous != stamp -> changes.push(BrowserAssetChange{path: path, kind: "changed"})
            }
        }
        old_paths := self.known.keys().to_list()
        old_paths.sort()
        loop path in old_paths {
            if !current.has_key(path) -> changes.push(BrowserAssetChange{path: path, kind: "deleted"})
        }
        kept := [BrowserAssetChange]{}
        loop change in changes {
            if kept.len() >= BROWSER_ASSET_WATCH_MAX_EVENTS {
                skipped += 1
                next
            }
            kept.push(change)
        }
        self.known = current
        BrowserAssetPoll{changes: kept, skipped: skipped}
    }
    frame: fn(&self, session_id: String) -> String {
        polled: self.poll()
        prefix: "{self.root}/"
        events := [String]{}
        loop change in polled.changes {
            if !change.path.starts_with(prefix) -> next
            logical: change.path.slice(prefix.len()..<change.path.len())
            if logical == "" -> next
            events.push("{{\"root\":{{\"id\":\"game\",\"path\":\".\"}},\"logical_path\":{foundation_json_quote("assets/{logical}")},\"kind\":{foundation_json_quote(change.kind)}}}")
        }
        "{{\"protocol\":{foundation_json_quote(JET_DEVTOOLS_PROTOCOL)},\"session_id\":{foundation_json_quote(session_id)},\"started_at_ms\":{session_unix_ms()},\"direction\":\"host_to_runtime\",\"events\":[{events.join(",")}],\"skipped\":{polled.skipped}}}"
    }
}

browser_asset_root: fn(entry: String) -> String Never! {
    parent: session_files.dirname(entry)
    session_files.join(if parent == "" -> "." else -> parent, "assets")
}

browser_asset_collect: fn(path: String, files: &[String:BrowserAssetStamp], skipped: &Int) {
    if files.len() >= BROWSER_ASSET_WATCH_MAX_FILES {
        skipped += 1
        return
    }
    stat: session_files.stat(path) ?? {
        skipped += 1
        return
    }
    if stat.is_symlink {
        skipped += 1
        return
    }
    if stat.is_file {
        if path.bytes().len() > BROWSER_ASSET_WATCH_MAX_PATH_BYTES {
            skipped += 1
            return
        }
        files[path] = BrowserAssetStamp{modified_ns: stat.modified.to_unix_ns() ?? 0, size: stat.size}
        return
    }
    if !stat.is_dir {
        skipped += 1
        return
    }
    entries: session_files.list_dir(path) ?? {
        skipped += 1
        return
    }
    children := [String]{}
    loop entry in entries -> children.push(session_files.join(path, entry.name))
    children.sort()
    loop child in children {
        browser_asset_collect(child, files, skipped)
        if files.len() >= BROWSER_ASSET_WATCH_MAX_FILES -> break
    }
}

ResidentDevSession: struct {
    session_id: String
    entry: String
    canvas_host: String
    canvas_port_number: Int
    application_host_name: String
    application_port_number: Int
    clock: Stopwatch
    current_revision_text: String
    live_lineage: LiveLineage?
    live_values: [LiveValueFact]
    accepted_revision: String
    last_good_revision: String
    last_good_program: String
    state: String
    diagnostic_code: String
    diagnostic: String
    diagnostic_revision: String
    selected_source_id: String
    selected_output_name: String
    selected_target_name: String
    debugger: DebuggerSnapshot
    test_state: String
    capture_fact_list: [CaptureSessionFact]
    last_good_views: [String:RetainedView]
    clients: [String:Int]
    receipts: [Receipt]
    devtools: JetDevtoolsEnvelope
    commands: JetDevtoolsCommandQueue
    browser_game_controls: [JetDevtoolsGameControlRequest]
    browser_asset_watcher: BrowserAssetWatcher
    recording: ResidentRecordingState?
    project_rebuild_executor: Bool

    new: fn(entry: String, canvas_port: Int, application_port: Int) -> ResidentDevSession {
        ResidentDevSession.new_with_hosts(entry, "127.0.0.1", canvas_port, "127.0.0.1", application_port)
    }
    new_with_canvas_host: fn(entry: String, canvas_host: String, canvas_port: Int, application_port: Int) -> ResidentDevSession {
        ResidentDevSession.new_with_hosts(entry, canvas_host, canvas_port, "127.0.0.1", application_port)
    }
    // The id joins this process with a random token, so two sessions of one
    // process never share an id without a process-global counter.
    new_with_hosts: fn(entry: String, canvas_host: String, canvas_port: Int, application_host: String, application_port: Int) -> ResidentDevSession {
        token: session_random.token_hex(8) ?? "0"
        id: "jet-session-{session_process.current_pid()}-{token}"
        envelope_id: "{id}"
        queue_id: "{id}"
        ResidentDevSession{
            session_id: id, entry: entry, canvas_host: canvas_host, canvas_port_number: canvas_port,
            application_host_name: application_host, application_port_number: application_port, clock: session_time.start(),
            current_revision_text: "", live_lineage: None, live_values: [LiveValueFact]{},
            accepted_revision: "", last_good_revision: "", last_good_program: "", state: "starting",
            diagnostic_code: "", diagnostic: "", diagnostic_revision: "",
            selected_source_id: "", selected_output_name: "", selected_target_name: "",
            debugger: DebuggerSnapshot.idle(), test_state: "idle", capture_fact_list: [CaptureSessionFact]{},
            last_good_views: [String:RetainedView]{}, clients: [String:Int]{}, receipts: [Receipt]{},
            devtools: JetDevtoolsEnvelope.new(envelope_id, session_unix_ms()), commands: JetDevtoolsCommandQueue.new(queue_id),
            browser_game_controls: [JetDevtoolsGameControlRequest]{}, browser_asset_watcher: BrowserAssetWatcher.for_entry(entry),
            recording: None, project_rebuild_executor: false
        }
    }
    note_client: fn(&self, client: String) {
        if !session_client_id_is_valid(client) -> return
        now: self.clock.elapsed_millis()
        self.expire_clients(now)
        if !self.clients.has_key(client) && self.clients.len() >= SESSION_MAX_CLIENTS -> return
        self.clients[client] = now
    }
    drop_client: fn(&self, client: String) {
        if !session_client_id_is_valid(client) -> return
        self.expire_clients(self.clock.elapsed_millis())
        _: self.clients.remove(client)
    }
    expire_clients: fn(&self, now: Int) {
        kept := [String:Int]{}
        loop client in self.clients.keys().to_list() {
            seen: self.clients[client]
            if now - seen <= SESSION_CLIENT_TTL_MS -> kept[client] = seen
        }
        self.clients = kept
    }
    client_count: fn(&self) -> Int {
        self.expire_clients(self.clock.elapsed_millis())
        self.clients.len()
    }
    // Up to 32 queued browser game controls as one command frame; on a
    // serialization failure every taken control returns to the queue front.
    browser_game_control_frame: fn(&self) -> String Err! {
        frame := JetDevtoolsCommandEnvelope.new("{self.session_id}", session_unix_ms())
        request_ids := [String]{}
        loop request_ids.len() < SESSION_MAX_GAME_CONTROL_FRAME && self.browser_game_controls.len() > 0 {
            request: self.browser_game_controls.remove(0, .Slot) ?? break
            request_ids.push("{request.request_id}")
            frame.enqueue_command(JetDevtoolsCommand.GameControl{request: request.move()})
        }
        body: frame.serialize() ?? {
            taken: frame.commands()
            at := 0
            loop command in taken.move() {
                if command.move() == .GameControl(request) {
                    self.browser_game_controls.insert(at, request.move())
                    at += 1
                }
            }
            return Err("{err}")
        }
        loop request_id in request_ids -> self.update_command_receipt(request_id, "relayed", None)
        Ok(body)
    }
    browser_game_asset_frame: fn(&self) -> String {
        frame: self.browser_asset_watcher.frame(self.session_id)
        frame
    }
    reopen_game_asset_watcher: fn(&self, entry: String) Err! {
        if entry.trim() == "" -> return Err("browser game asset watcher entry must not be empty")
        self.browser_asset_watcher.reopen(entry)
        Ok()
    }
    devtools_events_since: fn(self, cursor: Int?) -> DevtoolsProjection {
        envelope: self.devtools
        source_identity: envelope.source_identity
        revision := self.current_revision_text
        source_id := String?{None}
        build_id := String?{None}
        world_id := String?{None}
        if source_identity == .Val(identity) {
            if identity.revision == .Val(published) -> revision = published
            source_id = identity.source_id
            build_id = identity.build_id
            world_id = identity.world_id
        }
        oldest: envelope.oldest_sequence()
        truncation := envelope.truncated
        if cursor == .Val(after) {
            if oldest == .Val(first) {
                if after + 1 < first -> truncation = true
            }
        }
        reset: envelope.reset || cursor == None || truncation
        selection := DevtoolsSelectionFact?{None}
        if envelope.selection() == .Val(selected) -> selection = Val(DevtoolsSelectionFact{panel_id: selected.panel_id, item_key: selected.item_key ?? ""})
        status: DevtoolsStatusFact{
            state: envelope.lifecycle, diagnostic_code: session_optional_fact(self.diagnostic_code), diagnostic: session_optional_fact(self.diagnostic),
            accepted_revision: session_optional_fact(self.accepted_revision), last_good_revision: session_optional_fact(self.last_good_revision),
            run_target: session_optional_fact(self.selected_target_name), run_output: session_optional_fact(self.selected_output_name), test_state: session_optional_fact(self.test_state)
        }
        DevtoolsProjection{
            protocol: JET_DEVTOOLS_PROTOCOL, session_id: self.session_id, source_id: source_id, build_id: build_id, revision: revision, world_id: world_id,
            sequence: envelope.latest_sequence() ?? 0, observed_at: session_unix_ms(), panels: envelope.events_since(cursor), selection: selection,
            status: status, command_capabilities: self.devtools_command_capabilities(), command_receipts: self.commands.receipts(), reset: reset, truncation: truncation
        }
    }
    observe_source: fn(&self, revision: String) {
        if revision == "" -> return
        self.current_revision_text = revision
        if self.accepted_revision == "" -> self.accepted_revision = revision
    }
    set_live_lineage: fn(&self, source_id: String, build_id: String, revision: String, world_id: String) Err! {
        if !session_lineage_part(source_id) || !session_lineage_part(build_id) || !session_lineage_part(revision) || !session_lineage_part(world_id) -> return Err("live lineage is incomplete")
        self.live_lineage = Val(LiveLineage{protocol: "jet.live.v1", session_id: self.session_id, source_id: source_id, build_id: build_id, revision: revision, world_id: world_id})
        self.observe_source(revision)
        self.set_devtools_source_identity(Val("{source_id}"), Val("{build_id}"), Val("{revision}"), Val("{world_id}"))
        Ok()
    }
    capture_facts: fn(self) -> [CaptureSessionFact] Never! { self.capture_fact_list }
    trim_capture_facts: fn(&self) {
        loop self.capture_fact_list.len() > SESSION_MAX_RECEIPTS -> _: self.capture_fact_list.remove(0, .Slot)
    }
    validate_capture_identity: fn(self, identity: CaptureIdentity) CaptureSinkError! {
        if !identity.is_exact() -> return Err(CaptureSinkError.IncompleteIdentity)
        if identity.session_id != self.session_id -> return Err(CaptureSinkError.SessionMismatch)
        lineage: self.live_lineage ?? return Err(CaptureSinkError.NoLiveLineage)
        if identity.source_id != lineage.source_id || identity.build_id != lineage.build_id || identity.revision != lineage.revision -> return Err(CaptureSinkError.LineageMismatch)
        Ok()
    }
    mark_building: fn(&self) {
        self.state = "building"
        self.publish_session_state("building", "", "")
    }
    mark_ready: fn(&self) {
        self.state = "ready"
        self.diagnostic_code = ""
        self.diagnostic = ""
        self.diagnostic_revision = ""
        self.publish_session_state("ready", "", "")
    }
    mark_error: fn(&self, code: String, diagnostic: String) {
        self.state = "error"
        self.diagnostic_code = code
        self.diagnostic = diagnostic
        self.diagnostic_revision = self.current_revision_text
        self.publish_session_state("error", code, diagnostic)
    }
    mark_stopped: fn(&self) {
        self.state = "stopped"
        self.publish_session_state("stopped", "", "")
    }
    devtools_json: fn(self) -> String Err! { self.devtools.serialize() }
    devtools_panel_catalog: fn(self) -> JetDevtoolsPanelCatalog JetDevtoolsPanelCatalogError! { JetDevtoolsPanelCatalog.canonical() }
    devtools_panels: fn(self, host: JetDevtoolsHostKind, grants: [JetDevtoolsPanelCapability]) -> [JetDevtoolsPanelProjection] JetDevtoolsPanelCatalogError! {
        catalog: JetDevtoolsPanelCatalog.canonical()
        Ok(catalog.project(self.devtools, host, grants))
    }
    current_revision: fn(self) -> String Never! { self.current_revision_text }
    devtools_command_receipts: fn(self) -> [JetDevtoolsCommandReceipt] Never! { self.commands.receipts() }
    devtools_command_capabilities: fn(self) -> DevtoolsCommandCapabilities Never! {
        reason := String?{None}
        if !self.project_rebuild_executor -> reason = Val("no rebuild executor is registered for this host")
        else if self.current_revision_text == "" -> reason = Val("source revision is unavailable")
        DevtoolsCommandCapabilities{project_rebuild: reason == None, project_rebuild_reason: reason}
    }
    // One rebuild executor per host; the host unregisters it when it stops.
    register_project_rebuild_executor: fn(&self) Err! {
        if self.project_rebuild_executor -> return Err("a project rebuild executor is already registered")
        self.project_rebuild_executor = true
        Ok()
    }
    unregister_project_rebuild_executor: fn(&self) { self.project_rebuild_executor = false }
    project_rebuild_executor_available: fn(self) -> Bool Never! { self.project_rebuild_executor }
    validate_devtools_command_admission: fn(self, command: JetDevtoolsCommand) Err! {
        command.validate()
        if command.session_id() != self.session_id -> return Err("jet.devtools.v1 command session identity mismatch")
        if command == .ProjectRebuild(request) {
            if !self.project_rebuild_executor -> return Err("no rebuild executor is registered for this host")
            if request.expected_revision != self.current_revision_text -> return Err("source changed since this rebuild was requested")
        }
        Ok()
    }
    enqueue_devtools_command: fn(&self, &&command: JetDevtoolsCommand) Err! {
        self.validate_devtools_command_admission(command)
        self.commands.enqueue(command)
        Ok()
    }
    // Why the queued rebuild `request` cannot run now, if it cannot.
    rebuild_refusal: fn(self, request: JetDevtoolsProjectRebuildRequest) -> String? Never! {
        if request.session_id != self.session_id -> return Val("jet.devtools.v1 command session identity mismatch")
        if !self.project_rebuild_executor -> return Val("no rebuild executor is registered for this host")
        if request.expected_revision != self.current_revision_text -> return Val("source changed since this rebuild was requested")
        None
    }
    take_project_rebuild: fn(&self) -> JetDevtoolsProjectRebuildRequest? Err! {
        command: self.commands.poll() ?? return Ok(None)
        is_rebuild: command == .ProjectRebuild(_)
        if !is_rebuild {
            self.commands.requeue_front(command.move())
            return Ok(None)
        }
        if command.move() == .ProjectRebuild(request) {
            refusal: self.rebuild_refusal(request)
            if refusal.move() == .Val(error) {
                self.update_command_receipt(request.request_id, "failed", Val("{error}"))
                return Err(error)
            }
            self.update_command_receipt(request.request_id, "building", None)
            return Ok(Val(request.move()))
        }
        Ok(None)
    }
    finish_project_rebuild: fn(&self, request: JetDevtoolsProjectRebuildRequest, &&failure: String?) Err! {
        request.validate()
        if request.session_id != self.session_id -> return Err("jet.devtools.v1 command session identity mismatch")
        if failure == None {
            self.commands.update_receipt(request.request_id, "completed", None)
        } else {
            self.commands.update_receipt(request.request_id, "failed", failure.move())
        }
        Ok()
    }
    publish_devtools_event: fn(&self, &&event: JetDevtoolsEvent) -> Int Err! { self.push_devtools_event(event) }
    enqueue_game_control: fn(&self, &&request: JetDevtoolsGameControlRequest) Err! { self.enqueue_devtools_command(JetDevtoolsCommand.GameControl{request: request.move()}) }
    poll_devtools_command: fn(&self) -> JetDevtoolsCommand? Never! { self.commands.poll() }
    // The runtime host pulls EXPLAIN work from the session's queue; nothing
    // is dispatched through a process-global callback.
    poll_database_explain: fn(&self) -> JetDevtoolsDatabaseExplainRequest? Never! {
        request: self.commands.poll_database_explain() ?? return None
        self.update_command_receipt(request.request_id, "dispatched", None)
        Val(request)
    }
    update_command_receipt: fn(&self, request_id: String, &&status: String, &&error: String?) {
        self.commands.update_receipt(request_id, status, error).drop("a receipt for a request the queue no longer holds has nothing to update")
    }
    publish_database_explain_result: fn(&self, result: JetDevtoolsDatabaseExplainResult, timestamp_ms: Int, &&source: String) -> Int Err! {
        if result.session_id != self.session_id -> return Err("jet.devtools.v1 EXPLAIN result session identity mismatch")
        result.validate()
        event: JetDevtoolsEvent.from_parts(timestamp_ms, source, "DatabaseExplainResult", "{result.statement_identity}", result.render_json())
        self.push_devtools_event(event.move())
    }
    ingest_devtools_envelope: fn(&self, decoded: JetDevtoolsDecodedEnvelope) -> Int Err! {
        decoded.validate()
        if decoded.session_id() != self.session_id -> return Err("jet.devtools.v1 envelope session identity mismatch")
        if decoded == {
            .Events(envelope) -> {
                if envelope.source_identity == .Val(identity) -> self.set_devtools_source_identity(identity.source_id, identity.build_id, identity.revision, identity.world_id)
                events: envelope.events()
                count := 0
                loop event in events.move() {
                    _: self.push_devtools_event(event.move())
                    count += 1
                }
                self.devtools.set_selection(envelope.selection())
                self.devtools.set_cursor(envelope.cursor())
                self.devtools.set_lifecycle(envelope.lifecycle)
                self.devtools.set_freshness(envelope.freshness)
                self.devtools.privacy.loopback_only = envelope.privacy.loopback_only
                self.devtools.privacy.payload_free_by_default = envelope.privacy.payload_free_by_default
                self.devtools.privacy.published_payloads = self.devtools.privacy.published_payloads || envelope.privacy.published_payloads
                self.devtools.reset = self.devtools.reset || envelope.reset
                self.devtools.truncated = self.devtools.truncated || envelope.truncated
                Ok(count)
            }
            .Commands(envelope) -> {
                commands: envelope.commands()
                total: commands.len()
                game_count := 0
                loop command in commands {
                    self.validate_devtools_command_admission(command)
                    if command == .GameControl(_) -> game_count += 1
                }
                if self.commands.command_count() + total - game_count > JET_DEVTOOLS_MAX_COMMANDS -> return Err("jet.devtools.v1 command queue is full")
                if self.browser_game_controls.len() + game_count > JET_DEVTOOLS_MAX_COMMANDS -> return Err("jet.devtools.v1 browser game command queue is full")
                loop command in commands.move() {
                    is_game: command == .GameControl(_)
                    if is_game {
                        self.commands.record_receipt(command, "queued", None)
                        if command.move() == .GameControl(request) -> self.browser_game_controls.push(request.move())
                    } else {
                        self.commands.enqueue(command.move())
                    }
                }
                Ok(total)
            }
        }
    }
    publish_panel_events: fn(&self, &&events: [JetDevtoolsEvent]) -> Int Err! {
        count := 0
        loop event in events.move() {
            _: self.push_devtools_event(event.move())
            count += 1
        }
        Ok(count)
    }
}
