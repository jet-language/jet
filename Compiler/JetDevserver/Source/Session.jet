        watcher.frame(self.id)
    }
    // Rust: crates/jet-devserver/src/Session.rs:562
    pub fn reopen_game_asset_watcher(self: &Self, entry: String) -> Unit Err! {
        trimmed := entry.trim() // #4303
        if trimmed.is_empty() -> return .Err("browser game asset watcher entry must not be empty")
        watcher :: self.browser_asset_watcher.lock() ?? return .Err("browser asset watcher is poisoned")
        watcher.reopen(entry)
    }
    // Rust: crates/jet-devserver/src/Session.rs:577
    pub fn devtools_events_since(self: &Self, cursor: JetDevtoolsTimeCursor?) -> DevtoolsProjection {
        current_revision :: ~*self.current_revision.lock().unwrap()
        observed_at :: unix_time_ms()
        state :: self.devtools_lock()
        envelope :: &state.envelope
        source_identity :: ~envelope.source_identity
        revision :: source_identity.as_ref().and_then((identity) -> ~identity.revision).unwrap_or(^current_revision)
        latest :: envelope.latest_sequence().unwrap_or(0)
        oldest :: envelope.oldest_sequence()
        truncation :: envelope.truncated || cursor.is_some_and((cursor) -> oldest.is_some_and((oldest) -> cursor.saturating_add(1) < oldest))
        reset :: envelope.reset || cursor.is_none() || truncation
        panels :: envelope.events_since(cursor).cloned().collect::<[JetDevtoolsEvent]>()
        selection :: envelope.view().selection().map((selection) -> DevtoolsSelectionFact { panel_id: ~selection.panel_id, item_key: selection.item_key.clone().unwrap_or_default() })
        diagnostic_code :: ~*self.diagnostic_code.lock().unwrap()
        diagnostic :: ~*self.diagnostic.lock().unwrap()
        accepted_revision :: ~*self.accepted_revision.lock().unwrap()
        last_good_revision :: ~*self.last_good_revision.lock().unwrap()
        run_target :: ~*self.selected_target.lock().unwrap()
        run_output :: ~*self.selected_output.lock().unwrap()
        test_state :: ~*self.test_state.lock().unwrap()
        status :: DevtoolsStatusFact { state: envelope.lifecycle, diagnostic_code: optional_fact(diagnostic_code),
            diagnostic: optional_fact(diagnostic), accepted_revision: optional_fact(accepted_revision), last_good_revision: optional_fact(last_good_revision),
            run_target: optional_fact(run_target), run_output: optional_fact(run_output), test_state: optional_fact(test_state) }
        DevtoolsProjection {
            protocol: JET_DEVTOOLS_PROTOCOL, session_id: ~self.id,
            source_id: source_identity.as_ref().and_then((identity) -> ~identity.source_id),
            build_id: source_identity.as_ref().and_then((identity) -> ~identity.build_id), revision: ^revision,
            world_id: source_identity.as_ref().and_then((identity) -> ~identity.world_id), sequence: latest, observed_at, panels: ^panels, selection: ^selection,
            status: ^status, command_capabilities: self.devtools_command_capabilities(), command_receipts: self.devtools_command_receipts(), reset, truncation
        }
    }
    // Rust: crates/jet-devserver/src/Session.rs:652
    pub fn observe_source(self: &Self, revision: String) -> Unit {
        if revision.is_empty() -> return
        *self.current_revision.lock().unwrap() = revision
        accepted :: self.accepted_revision.lock().unwrap()
        if accepted.is_empty() -> *accepted = revision
    }
    // Rust: crates/jet-devserver/src/Session.rs:666
    pub fn set_live_lineage(self: &Self, source_id: String, build_id: String, revision: String, world_id: String) -> Unit Err! {
        if [source_id, build_id, revision, world_id].iter().any((value) -> value.is_empty() || value.chars().any((ch) -> ch.is_control())) -> return .Err("live lineage is incomplete")
        *self.live_lineage.lock().unwrap() = .Val(LiveLineage { protocol: "jet.live.v1", session_id: ~self.id, source_id, build_id, revision, world_id })
        self.observe_source(revision)
        self.set_devtools_source_identity(.Val(source_id), .Val(build_id), .Val(revision), .Val(world_id))?
    }
