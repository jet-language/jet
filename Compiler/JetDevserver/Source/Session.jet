// Rust: crates/jet-devserver/src/Session.rs:206
const BROWSER_ASSET_WATCH_MAX_FILES: USize = 4096
// Rust: crates/jet-devserver/src/Session.rs:207
const BROWSER_ASSET_WATCH_MAX_EVENTS: USize = 256
// Rust: crates/jet-devserver/src/Session.rs:208
const BROWSER_ASSET_WATCH_MAX_PATH_BYTES: USize = 1024
// Rust: crates/jet-devserver/src/Session.rs:211
struct BrowserAssetStamp { modified: SystemTime?; len: U64 }
// Rust: crates/jet-devserver/src/Session.rs:217
struct BrowserAssetChange { path: OSPath; kind: String }
// Rust: crates/jet-devserver/src/Session.rs:222
struct BrowserAssetWatcher { root: OSPath; known: [OSPath:BrowserAssetStamp] }
impl BrowserAssetWatcher {
    // Rust: crates/jet-devserver/src/Session.rs:228
    fn for_entry(entry: String) -> Self {
        parent :: OSPath.new(entry).parent().unwrap_or(OSPath.new("."))
        watcher := Self { root: parent.join("assets"), known: [:] }
        watcher.snapshot()
        watcher
    }
    // Rust: crates/jet-devserver/src/Session.rs:240
    fn reopen(self: &Self, entry: String) -> Unit {
        self.root = OSPath.new(entry).parent().unwrap_or(OSPath.new(".")).join("assets")
        self.snapshot()
    }
    // Rust: crates/jet-devserver/src/Session.rs:247
    fn stamp(path: &OSPath) -> BrowserAssetStamp? {
        // GATE #4494: filesystem metadata and timestamps.
        metadata :: fs.symlink_metadata(path).ok()?
        if !metadata.file_type().is_file() -> return .None
        .Val(BrowserAssetStamp { modified: metadata.modified().ok(), len: metadata.len() })
    }
    // Rust: crates/jet-devserver/src/Session.rs:258
    fn collect(path: &OSPath, files: &[OSPath:BrowserAssetStamp], skipped: &USize) -> Unit {
        if files.len() >= BROWSER_ASSET_WATCH_MAX_FILES { *skipped = skipped.saturating_add(1); return }
        metadata :: fs.symlink_metadata(path) ?? return
        if metadata.file_type().is_symlink() { *skipped = skipped.saturating_add(1); return }
        if metadata.file_type().is_file() {
            if Self.stamp(path) == .Val(stamp) {
                if path.to_string_lossy().len() <= BROWSER_ASSET_WATCH_MAX_PATH_BYTES -> files.insert(~path, ^stamp)
                else -> *skipped = skipped.saturating_add(1)
            }
            return
        }
        if !metadata.file_type().is_dir() { *skipped = skipped.saturating_add(1); return }
        entries :: fs.read_dir(path) ?? { *skipped = skipped.saturating_add(1); return }
        children := entries.filter_map((entry) -> entry.ok()).map((entry) -> entry.path()).collect::<[OSPath]>()
        children.sort()
        for child in children {
            Self.collect(&child, files, skipped)
            if files.len() >= BROWSER_ASSET_WATCH_MAX_FILES -> break
        }
    }
    // Rust: crates/jet-devserver/src/Session.rs:305
    fn snapshot(self: &Self) -> Unit {
        files: [OSPath:BrowserAssetStamp] := [:]
        skipped: USize := 0
        Self.collect(&self.root, &files, &skipped)
        self.known = ^files
    }
    // Rust: crates/jet-devserver/src/Session.rs:312
    fn poll(self: &Self) -> ([BrowserAssetChange], USize) {
        current: [OSPath:BrowserAssetStamp] := [:]
        skipped: USize := 0
        Self.collect(&self.root, &current, &skipped)
        changes: [BrowserAssetChange] := []
        paths := current.keys().cloned().collect::<[OSPath]>()
        paths.sort()
        for path in paths {
            kind :: if self.known.get(&path) == { .None -> "created", .Val(previous) if previous != current.get(&path).unwrap() -> "changed", .Val(_) -> continue }
            changes.push(BrowserAssetChange { path: ^path, kind })
        }
        old_paths := self.known.keys().cloned().collect::<[OSPath]>()
        old_paths.sort()
        for path in old_paths {
            if !current.contains_key(&path) -> changes.push(BrowserAssetChange { path: ^path, kind: "deleted" })
        }
        skipped = skipped.saturating_add(changes.len().saturating_sub(BROWSER_ASSET_WATCH_MAX_EVENTS))
        changes.truncate(BROWSER_ASSET_WATCH_MAX_EVENTS)
        self.known = ^current
        (changes, skipped)
    }
    // Rust: crates/jet-devserver/src/Session.rs:343
    fn frame(self: &Self, session_id: String) -> String {
        (changes, skipped) :: self.poll()
        events :: changes.into_iter().filter_map((change) -> {
            logical :: change.path.strip_prefix(&self.root).ok()?
            text :: logical.to_string_lossy().replace('\\', "/")
            if text.is_empty() -> return .None
            .Val("{{\"root\":{{\"id\":\"game\",\"path\":\".\"}},\"logical_path\":\"{json_escape("assets/{text}")}\",\"kind\":\"{json_escape(change.kind)}\"}}")
        }).collect::<[String]>().join(",")
        "{{\"protocol\":\"jet.devtools.v1\",\"session_id\":\"{json_escape(session_id)}\",\"started_at_ms\":{unix_time_ms()},\"direction\":\"host_to_runtime\",\"events\":[{events}],\"skipped\":{skipped}}}"
    }
}
