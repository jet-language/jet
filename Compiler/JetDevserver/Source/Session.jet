        *self.diagnostic_code.lock().unwrap() = code
        *self.diagnostic.lock().unwrap() = diagnostic
        *self.diagnostic_revision.lock().unwrap() = ~*self.current_revision.lock().unwrap()
        self.publish_session_state("error", code, diagnostic)
    }
