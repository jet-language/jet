        // GATE #4494: process identity.
        id :: "jet-session-{std.process.id()}-{serial}"
        Self {
            source_transactions: SessionBroker.default(), id: ~id, entry, canvas_host, canvas_port, application_host, application_port,
            current_revision: Mutex.new(""), live_lineage: Mutex.new(.None), live_values: Mutex.new([]),
            accepted_revision: Mutex.new(""), last_good_revision: Mutex.new(""), last_good_program: Mutex.new(""), state: Mutex.new("starting"),
            diagnostic_code: Mutex.new(""), diagnostic: Mutex.new(""), diagnostic_revision: Mutex.new(""),
            selected_source_id: Mutex.new(""), selected_output: Mutex.new(""), selected_target: Mutex.new(""),
            debugger: Mutex.new(DebuggerSnapshot { state: "idle", session_id: "", source_id: "", revision: "", tier: "" }),
            test_state: Mutex.new("idle"), capture_facts: Mutex.new([]), last_good_views: Mutex.new([:]), clients: Mutex.new([:]),
            receipts: Mutex.new([]), devtools: Mutex.new(DevtoolsState.new(id)), browser_game_controls: Mutex.new(VecDeque.new()),
            browser_asset_watcher: Mutex.new(BrowserAssetWatcher.for_entry(entry)), recording: Mutex.new(.None), project_rebuild_executor: Arc.new(Mutex.new(false))
        }
    }
    // Rust: crates/jet-devserver/src/Session.rs:495
    pub fn note_client(self: &Self, client: String) -> Unit {
        if !client_id_is_valid(client) -> return
        now :: Instant.now()
        clients :: self.clients.lock().unwrap()
        expire_clients(&clients, now)
        if !clients.contains_key(client) && clients.len() >= MAX_CLIENTS -> return
        clients.insert(client, now)
    }
    // Rust: crates/jet-devserver/src/Session.rs:508
    pub fn drop_client(self: &Self, client: String) -> Unit {
        if !client_id_is_valid(client) -> return
        now :: Instant.now()
        clients :: self.clients.lock().unwrap()
        expire_clients(&clients, now)
        clients.remove(client)
    }
    // Rust: crates/jet-devserver/src/Session.rs:520
    pub fn browser_game_control_frame(self: &Self) -> String Err! {
        queued :: self.browser_game_controls.lock().unwrap()
        frame := JetDevtoolsCommandEnvelope.new(~self.id, unix_time_ms())
        selected: [JetDevtoolsGameControlRequest] := []
        for _ in 0..32 {
            request :: queued.pop_front() ?? break
            frame.enqueue_command(.GameControl(~request))?
            selected.push(^request)
        }
        if frame.serialize() == {
            .Ok(body) -> {
                for request in &selected -> self.update_command_receipt(request.request_id, "relayed", .None)
                body
            }
            .Err(error) -> {
                for request in selected.into_iter().rev() -> queued.push_front(^request)
                .Err(^error)
            }
        }
    }
    // Rust: crates/jet-devserver/src/Session.rs:551
    pub fn browser_game_asset_frame(self: &Self) -> String Err! {
