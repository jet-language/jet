// Rust: crates/jet-devserver/src/WebModuleSwap.rs:863
pub struct WebModuleSwapReceipt {
    pub operation: WebModuleSwapOperation; pub status: WebModuleSwapReceiptStatus; pub phase: WebModuleSwapPhase
    pub identity: WebModuleSwapIdentity; pub candidate_identity: WebModuleSwapIdentity
    pub source_revision: String; pub build_revision: String; pub changed_modules: [String]; pub reason_codes: [WebModuleSwapReasonCode]
    pub preserved: [WebModuleSwapStateFact]; pub reset: [WebModuleSwapResetFact]; pub committed_page: WebPageFact; pub active_page: WebPageFact
}
impl WebModuleSwapReceipt {
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:881
    pub fn changed_module_set(self: &Self) -> &[String] { &self.changed_modules }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:885
    pub fn preserved_facts(self: &Self) -> &[WebModuleSwapStateFact] { &self.preserved }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:890
    pub fn audit(self: &Self) -> String {
        changed :: self.changed_modules.join(",")
        reasons :: self.reason_codes.iter().map((reason) -> reason.as_str()).collect<[_]>().join(",")
        preserved :: self.preserved.iter().map((fact) -> format("{}:{}", fact.kind().as_str(), fact.key())).collect<[_]>().join(",")
        reset :: self.reset.iter().map((fact) -> format("{}:{}({})", fact.state.kind().as_str(), fact.state.key(), fact.reason.as_str())).collect<[_]>().join(",")
        return format("operation={} status={} phase={} identity={}/{} candidate={}/{} source_revision={} build_revision={} changed_modules=[{}] reasons=[{}] preserved=[{}] reset=[{}] committed_page={} active_page={}", self.operation, self.status.as_str(), self.phase, self.identity.module, self.identity.page, self.candidate_identity.module, self.candidate_identity.page, self.source_revision, self.build_revision, changed, reasons, preserved, reset, self.committed_page.artifact, self.active_page.artifact)
    }
}
// Rust: crates/jet-devserver/src/WebModuleSwap.rs:939
#Error
pub enum WebModuleSwapError {
    InvalidSnapshot { detail: String }
    IdentityMismatch { expected: WebModuleSwapIdentity, found: WebModuleSwapIdentity }
    DecisionModuleMismatch { expected: String, found: String }
    MissingRetentionFact { kind: WebStateKind, key: String }
    DuplicateRetentionKey { key: String }
    UnusedRetentionFact { key: String }
    StalePlan { expected_source_revision: String, found_source_revision: String, expected_build_revision: String, found_build_revision: String }
    Incompatible { reason_codes: [WebModuleSwapReasonCode] }
    InvalidTransition { operation: WebModuleSwapOperation, phase: WebModuleSwapPhase }
    NoPendingPlan; NoAppliedPlan; NoCommittedPage
}
// Rust: crates/jet-devserver/src/WebModuleSwap.rs:979
impl WebModuleSwapError.Display {
    fn display(self: &Self) -> String {
        return match self {
            .InvalidSnapshot(detail: detail) -> format("invalid web swap snapshot: {}", detail)
            .IdentityMismatch(expected: expected, found: found) -> format("web swap identity mismatch: expected {}/{} but found {}/{}", expected.module, expected.page, found.module, found.page)
            .DecisionModuleMismatch(expected: expected, found: found) -> format("web swap decision module mismatch: expected `{}` but found `{}`", expected, found)
            .MissingRetentionFact(kind: kind, key: key) -> format("web swap has no canonical retention fact for {} `{}`", kind.as_str(), key)
            .DuplicateRetentionKey(key: key) -> format("web swap retention key `{}` is not unique", key)
            .UnusedRetentionFact(key: key) -> format("web swap retention fact `{}` has no typed state", key)
            .StalePlan(expected_source_revision: es, found_source_revision: fs, expected_build_revision: eb, found_build_revision: fb) -> format("stale web swap plan: expected source/build {}/{} but state is {}/{}", es, eb, fs, fb)
            .Incompatible(reason_codes: codes) -> format("web module swap is incompatible: {}", codes.iter().map((reason) -> reason.as_str()).collect<[_]>().join(","))
            .InvalidTransition(operation: op, phase: phase) -> format("web swap cannot {} while phase is {}", op, phase)
            .NoPendingPlan -> "web swap has no pending plan"; .NoAppliedPlan -> "web swap has no applied plan"; .NoCommittedPage -> "web swap has no committed page"
        }
    }
}
// Rust: crates/jet-devserver/src/WebModuleSwap.rs:1031
// #Error supplies the native error contract.
// Rust: crates/jet-devserver/src/WebModuleSwap.rs:1040
pub struct WebModuleSwapState {
    committed: WebModuleSwapSnapshot; pending: WebModuleSwapPlan?; active: WebModuleSwapSnapshot; phase: WebModuleSwapPhase
}
impl WebModuleSwapState {
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1048
    pub fn new(snapshot: WebModuleSwapSnapshot) -> Result<Self, WebModuleSwapError> {
        snapshot := ^snapshot; snapshot.normalize()?
        return .Ok(Self(active: snapshot.clone(), committed: ^snapshot, pending: .None, phase: .Committed))
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1059
    pub fn committed(self: &Self) -> &WebModuleSwapSnapshot { &self.committed }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1063
    pub fn active(self: &Self) -> &WebModuleSwapSnapshot { &self.active }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1067
    pub fn pending(self: &Self) -> &WebModuleSwapPlan? { self.pending.as_ref() }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1071
    pub fn phase(self: &Self) -> WebModuleSwapPhase { self.phase }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1076
    pub fn pause(self: &Self, plan: WebModuleSwapPlan) -> Result<WebModuleSwapReceipt, WebModuleSwapError> {
        if self.phase != .Committed || self.pending.is_some() -> return .Err(.InvalidTransition(operation: .Pause, phase: self.phase))
        self.validate_base(&plan)?
        if plan.base.identity != plan.candidate.identity -> return .Err(.IdentityMismatch(expected: plan.base.identity.clone(), found: plan.candidate.identity.clone()))
        if !plan.is_compatible() -> return .Err(.Incompatible(reason_codes: plan.compatibility.reason_codes().to_vec()))
        self.pending = .Val(^plan); self.phase = .Paused
        return .Ok(self.receipt(.Pause, .Paused))
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1107
    pub fn apply(self: &Self) -> Result<WebModuleSwapReceipt, WebModuleSwapError> {
        if self.phase != .Paused -> return .Err(.InvalidTransition(operation: .Apply, phase: self.phase))
        plan :: self.pending.as_ref().ok_or(WebModuleSwapError.NoPendingPlan)?
        self.validate_base(plan)?
        if !plan.is_compatible() -> return .Err(.Incompatible(reason_codes: plan.compatibility.reason_codes().to_vec()))
        applied :: plan.applied_snapshot(); self.active = ^applied; self.phase = .Applied
        return .Ok(self.receipt(.Apply, .Applied))
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1131
    pub fn commit(self: &Self) -> Result<WebModuleSwapReceipt, WebModuleSwapError> {
        if self.phase != .Applied -> return .Err(.InvalidTransition(operation: .Commit, phase: self.phase))
        plan :: self.pending.as_ref().ok_or(WebModuleSwapError.NoAppliedPlan)?
        self.validate_base(plan)?
        if self.active.identity != plan.candidate.identity -> return .Err(.IdentityMismatch(expected: plan.candidate.identity.clone(), found: self.active.identity.clone()))
        plan :: self.pending.take().expect("applied swap has a pending plan")
        self.committed = self.active.clone(); self.phase = .Committed
        return .Ok(self.receipt_for_plan(&plan, .Commit, .Committed))
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1157
    pub fn rollback(self: &Self) -> Result<WebModuleSwapReceipt, WebModuleSwapError> {
        had_pending :: self.pending.is_some()
        receipt_data :: self.pending.as_ref().map((plan) -> (plan.candidate.identity.clone(), plan.candidate.source_revision.clone(), plan.candidate.build_revision.clone(), plan.changed_modules.clone(), plan.reason_codes.clone(), plan.preserved.clone(), plan.reset.clone()))
        self.pending = .None; self.active = self.committed.clone(); self.phase = .Committed
        if had_pending {
            (candidate_identity, source_revision, build_revision, changed_modules, reason_codes, preserved, reset) :: receipt_data.expect("pending plan was present")
            return .Ok(WebModuleSwapReceipt(operation: .Rollback, status: .RolledBack, phase: self.phase, identity: self.committed.identity.clone(), candidate_identity: ^candidate_identity, source_revision: ^source_revision, build_revision: ^build_revision, changed_modules: ^changed_modules, reason_codes: ^reason_codes, preserved: ^preserved, reset: ^reset, committed_page: self.committed.page.clone(), active_page: self.active.page.clone()))
        }
        return .Ok(WebModuleSwapReceipt(operation: .Rollback, status: .RolledBack, phase: self.phase, identity: self.committed.identity.clone(), candidate_identity: self.committed.identity.clone(), source_revision: self.committed.source_revision.clone(), build_revision: self.committed.build_revision.clone(), changed_modules: [], reason_codes: [.NothingToRollback], preserved: [], reset: [], committed_page: self.committed.page.clone(), active_page: self.active.page.clone()))
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1210
    pub fn apply_decision(self: &Self, plan: WebModuleSwapPlan) -> Result<WebModuleSwapReceipt, WebModuleSwapError> {
        if !plan.is_compatible() -> return self.restart(^plan)
        self.pause(^plan)?
        if self.apply() == .Err(error) { _ :: self.rollback(); return .Err(^error) }
        return match self.commit() { .Ok(receipt) -> .Ok(^receipt); .Err(error) -> { _ :: self.rollback(); .Err(^error) } }
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1234
    pub fn restart(self: &Self, plan: WebModuleSwapPlan) -> Result<WebModuleSwapReceipt, WebModuleSwapError> {
        if self.phase != .Committed || self.pending.is_some() -> return .Err(.InvalidTransition(operation: .Restart, phase: self.phase))
        self.validate_base(&plan)?
        if plan.base.identity != plan.candidate.identity -> return .Err(.IdentityMismatch(expected: plan.base.identity.clone(), found: plan.candidate.identity.clone()))
        if plan.is_compatible() -> return .Err(.Incompatible(reason_codes: [.SemanticIncompatible]))
        self.active = plan.candidate.clone(); self.committed = self.active.clone(); self.phase = .Committed
        return .Ok(self.receipt_for_plan(&plan, .Restart, .Restarted))
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1267
    fn validate_base(self: &Self, plan: &WebModuleSwapPlan) -> Result<Unit, WebModuleSwapError> {
        if self.committed.identity != plan.base.identity -> return .Err(.IdentityMismatch(expected: self.committed.identity.clone(), found: plan.base.identity.clone()))
        if self.committed.source_revision != plan.base.source_revision || self.committed.build_revision != plan.base.build_revision -> return .Err(.StalePlan(expected_source_revision: plan.base.source_revision.clone(), found_source_revision: self.committed.source_revision.clone(), expected_build_revision: plan.base.build_revision.clone(), found_build_revision: self.committed.build_revision.clone()))
        return .Ok(())
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1287
    fn receipt(self: &Self, operation: WebModuleSwapOperation, status: WebModuleSwapReceiptStatus) -> WebModuleSwapReceipt {
        plan :: self.pending.as_ref().expect("successful swap operation has a pending plan")
        return self.receipt_for_plan(plan, operation, status)
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:1299
    fn receipt_for_plan(self: &Self, plan: &WebModuleSwapPlan, operation: WebModuleSwapOperation, status: WebModuleSwapReceiptStatus) -> WebModuleSwapReceipt {
        WebModuleSwapReceipt(operation: operation, status: status, phase: self.phase, identity: self.committed.identity.clone(), candidate_identity: plan.candidate.identity.clone(), source_revision: plan.candidate.source_revision.clone(), build_revision: plan.candidate.build_revision.clone(), changed_modules: plan.changed_modules.clone(), reason_codes: plan.reason_codes.clone(), preserved: plan.preserved.clone(), reset: plan.reset.clone(), committed_page: self.committed.page.clone(), active_page: self.active.page.clone())
    }
}

