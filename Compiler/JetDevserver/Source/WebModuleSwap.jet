// Rust: crates/jet-devserver/src/WebModuleSwap.rs:939
#Error
enum WebModuleSwapError {
    InvalidSnapshot { detail: String }
    IdentityMismatch { expected: WebModuleSwapIdentity, found: WebModuleSwapIdentity }
    DecisionModuleMismatch { expected: String, found: String }
    MissingRetentionFact { kind: WebStateKind, key: String }
    DuplicateRetentionKey { key: String }
    UnusedRetentionFact { key: String }
    StalePlan { expected_source_revision: String, found_source_revision: String, expected_build_revision: String, found_build_revision: String }
    Incompatible { reason_codes: [WebModuleSwapReasonCode] }
    InvalidTransition { operation: WebModuleSwapOperation, phase: WebModuleSwapPhase }
    NoPendingPlan; NoAppliedPlan; NoCommittedPage
}
// Rust: crates/jet-devserver/src/WebModuleSwap.rs:979
impl WebModuleSwapError.Display {
    fn display(self: Self) -> String {
        return if self == {
            .InvalidSnapshot(detail: detail) -> "invalid web swap snapshot: {detail}"
            .IdentityMismatch(expected: expected, found: found) -> "web swap identity mismatch: expected {expected.module_ref}/{expected.page} but found {found.module_ref}/{found.page}"
            .DecisionModuleMismatch(expected: expected, found: found) -> "web swap decision module mismatch: expected `{expected}` but found `{found}`"
            .MissingRetentionFact(kind: kind, key: key) -> "web swap has no canonical retention fact for {kind.as_str()} `{key}`"
            .DuplicateRetentionKey(key: key) -> "web swap retention key `{key}` is not unique"
            .UnusedRetentionFact(key: key) -> "web swap retention fact `{key}` has no typed state"
            .StalePlan(expected_source_revision: es, found_source_revision: fs, expected_build_revision: eb, found_build_revision: fb) -> "stale web swap plan: expected source/build {es}/{eb} but state is {fs}/{fb}"
            .Incompatible(reason_codes: codes) -> "web module swap is incompatible: {codes.iter().map((reason) -> reason.as_str()).collect<[_]>().join(",")}"
            .InvalidTransition(operation: op, phase: phase) -> "web swap cannot {op} loop phase is {phase}"
            .NoPendingPlan -> "web swap has no pending plan"; .NoAppliedPlan -> "web swap has no applied plan"; .NoCommittedPage -> "web swap has no committed page"
        }
    }
}
