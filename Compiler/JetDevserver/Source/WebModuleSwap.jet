// Rust: crates/jet-devserver/src/WebModuleSwap.rs:362
struct WebModuleSwapSnapshot {
    identity: WebModuleSwapIdentity; source_revision: String; build_revision: String
    page: WebPageFact; modules: [WebModuleFact]; state: [WebModuleSwapStateFact]
}
impl WebModuleSwapSnapshot {
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:372
    fn new(identity: WebModuleSwapIdentity, source_revision: String, build_revision: String, page: WebPageFact, modules: [WebModuleFact], state: [WebModuleSwapStateFact]) -> Self WebModuleSwapError! {
        snapshot := Self(identity: ^identity, source_revision: ^source_revision, build_revision: ^build_revision, page: ^page, modules: ^modules, state: ^state)
        snapshot.normalize()?; return .Ok(^snapshot)
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:392
    fn normalize(self: &Self) WebModuleSwapError! {
        if !self.identity.is_valid() -> return .Err(.InvalidSnapshot(detail: "module and page identity must be non-empty"))
        if self.source_revision.is_empty() || self.build_revision.is_empty() -> return .Err(.InvalidSnapshot(detail: "source and build revisions must be non-empty"))
        if self.page.identity.is_empty() -> return .Err(.InvalidSnapshot(detail: "page identity must be non-empty"))
        if self.page.identity != self.identity.page -> return .Err(.InvalidSnapshot(detail: "page fact identity does not match swap identity"))
        self.modules.sort_by((left, right) -> left.identity.cmp(&right.identity))
        loop module_ref in &self.modules {
            if module_ref.identity.is_empty() || module_ref.interface_fingerprint.is_empty() || module_ref.body_fingerprint.is_empty() -> return .Err(.InvalidSnapshot(detail: "module identity and fingerprints must be non-empty"))
        }
        if self.modules.windows(2).any((pair) -> pair[0].identity == pair[1].identity) -> return .Err(.InvalidSnapshot(detail: "module identities must be unique"))
        self.state.sort_by((left, right) -> (_0: left.kind(), _1: left.key()).cmp(&(_0: right.kind(), _1: right.key()))) // GATE #4499: exact enum/tuple order.
        loop fact in &self.state {
            if fact.key().is_empty() || fact.type_fingerprint().is_empty() -> return .Err(.InvalidSnapshot(detail: "state keys and type fingerprints must be non-empty"))
            if fact == .Island(_) && fact.identity().is_empty() -> return .Err(.InvalidSnapshot(detail: "island identities must be non-empty"))
        }
        if self.state.windows(2).any((pair) -> pair[0].kind() == pair[1].kind() && pair[0].key() == pair[1].key()) -> return .Err(.InvalidSnapshot(detail: "state keys must be unique within a state family"))
        return .Ok(_)
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:460
    fn module_ref(self: Self, identity: String) -> WebModuleFact? {
        self.modules.binary_search_by((module_ref) -> module_ref.identity.as_str().cmp(identity)).ok().map((index) -> &self.modules[index])
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:467
    fn state_fact(self: Self, kind: WebStateKind, key: String) -> WebModuleSwapStateFact? {
        self.state.binary_search_by((fact) -> (_0: fact.kind(), _1: fact.key()).cmp(&(_0: kind, _1: key))).ok().map((index) -> &self.state[index])
    }
}
