// Rust: crates/jet-devserver/src/WebModuleSwap.rs:252
pub enum WebModuleSwapStateFact {
    Signal(WebSignalFact); Store(WebStoreFact); QueryCache(WebQueryCacheFact); FormDraft(WebFormDraftFact)
    Scroll(WebScrollFact); Focus(WebFocusFact); Island(WebIslandFact)
}
impl WebModuleSwapStateFact {
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:263
    pub fn kind(self: &Self) -> WebStateKind { match self { .Signal(_) -> .Signal; .Store(_) -> .Store; .QueryCache(_) -> .QueryCache; .FormDraft(_) -> .FormDraft; .Scroll(_) -> .Scroll; .Focus(_) -> .Focus; .Island(_) -> .Island } }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:275
    pub fn key(self: &Self) -> &String { match self { .Signal(f) -> &f.key; .Store(f) -> &f.key; .QueryCache(f) -> &f.key; .FormDraft(f) -> &f.key; .Scroll(f) -> &f.key; .Focus(f) -> &f.key; .Island(f) -> &f.key } }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:287
    pub fn identity(self: &Self) -> &String { match self { .Island(f) -> &f.identity; _ -> self.key() } }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:294
    pub fn type_fingerprint(self: &Self) -> &String { match self { .Signal(f) -> &f.type_fingerprint; .Store(f) -> &f.type_fingerprint; .QueryCache(f) -> &f.type_fingerprint; .FormDraft(f) -> &f.type_fingerprint; .Scroll(f) -> &f.type_fingerprint; .Focus(f) -> &f.type_fingerprint; .Island(f) -> &f.type_fingerprint } }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:306
    pub fn value(self: &Self) -> &WebStateValue { match self { .Signal(f) -> &f.value; .Store(f) -> &f.value; .QueryCache(f) -> &f.value; .FormDraft(f) -> &f.value; .Scroll(f) -> &f.value; .Focus(f) -> &f.value; .Island(f) -> &f.value } }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:318
    fn with_value(self: &Self, value: WebStateValue) -> Self {
        match self {
            .Signal(f) -> .Signal(WebSignalFact(key: f.key.clone(), type_fingerprint: f.type_fingerprint.clone(), value: ^value))
            .Store(f) -> .Store(WebStoreFact(key: f.key.clone(), type_fingerprint: f.type_fingerprint.clone(), value: ^value))
            .QueryCache(f) -> .QueryCache(WebQueryCacheFact(key: f.key.clone(), type_fingerprint: f.type_fingerprint.clone(), value: ^value))
            .FormDraft(f) -> .FormDraft(WebFormDraftFact(key: f.key.clone(), type_fingerprint: f.type_fingerprint.clone(), value: ^value))
            .Scroll(f) -> .Scroll(WebScrollFact(key: f.key.clone(), type_fingerprint: f.type_fingerprint.clone(), value: ^value))
            .Focus(f) -> .Focus(WebFocusFact(key: f.key.clone(), type_fingerprint: f.type_fingerprint.clone(), value: ^value))
            .Island(f) -> .Island(WebIslandFact(key: f.key.clone(), identity: f.identity.clone(), type_fingerprint: f.type_fingerprint.clone(), value: ^value))
        }
    }
}
// Rust: crates/jet-devserver/src/WebModuleSwap.rs:362
pub struct WebModuleSwapSnapshot {
    pub identity: WebModuleSwapIdentity; pub source_revision: String; pub build_revision: String
    pub page: WebPageFact; pub modules: [WebModuleFact]; pub state: [WebModuleSwapStateFact]
}
impl WebModuleSwapSnapshot {
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:372
    pub fn new(identity: WebModuleSwapIdentity, source_revision: String, build_revision: String, page: WebPageFact, modules: [WebModuleFact], state: [WebModuleSwapStateFact]) -> Result<Self, WebModuleSwapError> {
        snapshot := Self(identity: ^identity, source_revision: ^source_revision, build_revision: ^build_revision, page: ^page, modules: ^modules, state: ^state)
        snapshot.normalize()?; return .Ok(^snapshot)
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:392
    pub fn normalize(self: &Self) -> Result<Unit, WebModuleSwapError> {
        if !self.identity.is_valid() -> return .Err(.InvalidSnapshot(detail: "module and page identity must be non-empty"))
        if self.source_revision.is_empty() || self.build_revision.is_empty() -> return .Err(.InvalidSnapshot(detail: "source and build revisions must be non-empty"))
        if self.page.identity.is_empty() -> return .Err(.InvalidSnapshot(detail: "page identity must be non-empty"))
        if self.page.identity != self.identity.page -> return .Err(.InvalidSnapshot(detail: "page fact identity does not match swap identity"))
        self.modules.sort_by((left, right) -> left.identity.cmp(&right.identity))
        for module in &self.modules {
            if module.identity.is_empty() || module.interface_fingerprint.is_empty() || module.body_fingerprint.is_empty() -> return .Err(.InvalidSnapshot(detail: "module identity and fingerprints must be non-empty"))
        }
        if self.modules.windows(2).any((pair) -> pair[0].identity == pair[1].identity) -> return .Err(.InvalidSnapshot(detail: "module identities must be unique"))
        self.state.sort_by((left, right) -> (left.kind(), left.key()).cmp(&(right.kind(), right.key()))) // GATE #4499: exact enum/tuple order.
        for fact in &self.state {
            if fact.key().is_empty() || fact.type_fingerprint().is_empty() -> return .Err(.InvalidSnapshot(detail: "state keys and type fingerprints must be non-empty"))
            if fact is .Island(_) && fact.identity().is_empty() -> return .Err(.InvalidSnapshot(detail: "island identities must be non-empty"))
        }
        if self.state.windows(2).any((pair) -> pair[0].kind() == pair[1].kind() && pair[0].key() == pair[1].key()) -> return .Err(.InvalidSnapshot(detail: "state keys must be unique within a state family"))
        return .Ok(())
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:460
    pub fn module(self: &Self, identity: String) -> &WebModuleFact? {
        self.modules.binary_search_by((module) -> module.identity.as_str().cmp(identity)).ok().map((index) -> &self.modules[index])
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:467
    pub fn state_fact(self: &Self, kind: WebStateKind, key: String) -> &WebModuleSwapStateFact? {
        self.state.binary_search_by((fact) -> (fact.kind(), fact.key()).cmp(&(kind, key))).ok().map((index) -> &self.state[index])
    }
}
// Rust: crates/jet-devserver/src/WebModuleSwap.rs:477
pub enum WebModuleSwapReasonCode {
    NoChange; SourceRevisionChanged; BuildRevisionChanged; ModuleBodyChanged; ModuleAdded; ModuleRemoved; ModuleIdentityChanged
    ModuleInterfaceChanged; PageIdentityChanged; StateAdded; StateRemoved; StateRetentionFresh; SignalTypeChanged
    StoreTypeChanged; QueryCacheTypeChanged; FormDraftTypeChanged; ScrollTypeChanged; FocusTypeChanged; IslandTypeChanged
    IslandIdentityChanged; IdentityMismatch; SemanticIncompatible; StalePlan; NothingToRollback
}
impl WebModuleSwapReasonCode {
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:505
    pub fn as_str(self) -> String {
        match self {
            .NoChange -> "no_change"; .SourceRevisionChanged -> "source_revision_changed"; .BuildRevisionChanged -> "build_revision_changed"
            .ModuleBodyChanged -> "module_body_changed"; .ModuleAdded -> "module_added"; .ModuleRemoved -> "module_removed"; .ModuleIdentityChanged -> "module_identity_changed"
            .ModuleInterfaceChanged -> "module_interface_changed"; .PageIdentityChanged -> "page_identity_changed"; .StateAdded -> "state_added"; .StateRemoved -> "state_removed"
            .StateRetentionFresh -> "state_retention_fresh"; .SignalTypeChanged -> "signal_type_changed"; .StoreTypeChanged -> "store_type_changed"
            .QueryCacheTypeChanged -> "query_cache_type_changed"; .FormDraftTypeChanged -> "form_draft_type_changed"; .ScrollTypeChanged -> "scroll_type_changed"
            .FocusTypeChanged -> "focus_type_changed"; .IslandTypeChanged -> "island_type_changed"; .IslandIdentityChanged -> "island_identity_changed"
            .IdentityMismatch -> "identity_mismatch"; .SemanticIncompatible -> "semantic_incompatible"; .StalePlan -> "stale_plan"; .NothingToRollback -> "nothing_to_rollback"
        }
    }
}
