// Backend-neutral typed web module swap facts and transaction state.
// Sema owns compatibility and retention; this adapter never re-derives either.
use jet_foundation.[HotSwapDecision, StateRetentionFact]

WebModuleSwapIdentity: struct {
    module_ref: String
    page: String
}
impl WebModuleSwapIdentity {
    new: fn(module_ref: String, page: String) -> WebModuleSwapIdentity { WebModuleSwapIdentity{module_ref, page} }
    is_valid: fn(self) -> Bool { self.module_ref.len() > 0 && self.page.len() > 0 }
    matches: fn(self, other: WebModuleSwapIdentity) -> Bool { self.module_ref == other.module_ref && self.page == other.page }
}

WebPageFact: struct {
    identity: String
    artifact: String
}
impl WebPageFact {
    new: fn(identity: String, artifact: String) -> WebPageFact { WebPageFact{identity, artifact} }
}

WebModuleFact: struct {
    identity: String
    interface_fingerprint: String
    body_fingerprint: String
}
impl WebModuleFact {
    new: fn(identity: String, interface_fingerprint: String, body_fingerprint: String) -> WebModuleFact {
        WebModuleFact{identity, interface_fingerprint, body_fingerprint}
    }
}

WebStateValue: enum { Text(String) Integer(I64) Unsigned(U64) Boolean(Bool) Bytes([U8]) }
impl WebStateValue {
    kind: fn(self) -> String {
        if self == {
            .Text(_) -> "text"
            .Integer(_) -> "integer"
            .Unsigned(_) -> "unsigned"
            .Boolean(_) -> "boolean"
            .Bytes(_) -> "bytes"
        }
    }
}

// Declaration order is the canonical state order.
WebStateKind: enum { Signal Store QueryCache FormDraft Scroll Focus Island }
impl WebStateKind {
    as_str: fn(self) -> String {
        if self == {
            .Signal -> "signal"
            .Store -> "store"
            .QueryCache -> "query_cache"
            .FormDraft -> "form_draft"
            .Scroll -> "scroll"
            .Focus -> "focus"
            .Island -> "island"
        }
    }
    rank: fn(self) -> Int {
        if self == {
            .Signal -> 0
            .Store -> 1
            .QueryCache -> 2
            .FormDraft -> 3
            .Scroll -> 4
            .Focus -> 5
            .Island -> 6
        }
    }
}

WebSignalFact: struct {
    key: String
    type_fingerprint: String
    value: WebStateValue
}
impl WebSignalFact {
    new: fn(key: String, type_fingerprint: String, value: WebStateValue) -> WebSignalFact { WebSignalFact{key, type_fingerprint, value} }
}
WebStoreFact: struct {
    key: String
    type_fingerprint: String
    value: WebStateValue
}
impl WebStoreFact {
    new: fn(key: String, type_fingerprint: String, value: WebStateValue) -> WebStoreFact { WebStoreFact{key, type_fingerprint, value} }
}
WebQueryCacheFact: struct {
    key: String
    type_fingerprint: String
    value: WebStateValue
}
impl WebQueryCacheFact {
    new: fn(key: String, type_fingerprint: String, value: WebStateValue) -> WebQueryCacheFact { WebQueryCacheFact{key, type_fingerprint, value} }
}
WebFormDraftFact: struct {
    key: String
    type_fingerprint: String
    value: WebStateValue
}
impl WebFormDraftFact {
    new: fn(key: String, type_fingerprint: String, value: WebStateValue) -> WebFormDraftFact { WebFormDraftFact{key, type_fingerprint, value} }
}
WebScrollFact: struct {
    key: String
    type_fingerprint: String
    value: WebStateValue
}
impl WebScrollFact {
    new: fn(key: String, type_fingerprint: String, value: WebStateValue) -> WebScrollFact { WebScrollFact{key, type_fingerprint, value} }
}
WebFocusFact: struct {
    key: String
    type_fingerprint: String
    value: WebStateValue
}
impl WebFocusFact {
    new: fn(key: String, type_fingerprint: String, value: WebStateValue) -> WebFocusFact { WebFocusFact{key, type_fingerprint, value} }
}
WebIslandFact: struct {
    key: String
    identity: String
    type_fingerprint: String
    value: WebStateValue
}
impl WebIslandFact {
    new: fn(key: String, identity: String, type_fingerprint: String, value: WebStateValue) -> WebIslandFact { WebIslandFact{key, identity, type_fingerprint, value} }
}

WebModuleSwapStateFact: enum {
    Signal(WebSignalFact) Store(WebStoreFact) QueryCache(WebQueryCacheFact) FormDraft(WebFormDraftFact)
    Scroll(WebScrollFact) Focus(WebFocusFact) Island(WebIslandFact)
}
impl WebModuleSwapStateFact {
    kind: fn(self) -> WebStateKind {
        if self == {
            .Signal(_) -> WebStateKind.Signal
            .Store(_) -> WebStateKind.Store
            .QueryCache(_) -> WebStateKind.QueryCache
            .FormDraft(_) -> WebStateKind.FormDraft
            .Scroll(_) -> WebStateKind.Scroll
            .Focus(_) -> WebStateKind.Focus
            .Island(_) -> WebStateKind.Island
        }
    }
    key: fn(self) -> String {
        if self == {
            .Signal(fact) -> fact.key
            .Store(fact) -> fact.key
            .QueryCache(fact) -> fact.key
            .FormDraft(fact) -> fact.key
            .Scroll(fact) -> fact.key
            .Focus(fact) -> fact.key
            .Island(fact) -> fact.key
        }
    }
    // Islands carry their own identity; every other family is identified by its key.
    identity: fn(self) -> String {
        if self == {
            .Island(fact) -> fact.identity
            else -> self.key()
        }
    }
    type_fingerprint: fn(self) -> String {
        if self == {
            .Signal(fact) -> fact.type_fingerprint
            .Store(fact) -> fact.type_fingerprint
            .QueryCache(fact) -> fact.type_fingerprint
            .FormDraft(fact) -> fact.type_fingerprint
            .Scroll(fact) -> fact.type_fingerprint
            .Focus(fact) -> fact.type_fingerprint
            .Island(fact) -> fact.type_fingerprint
        }
    }
    value: fn(self) -> WebStateValue {
        if self == {
            .Signal(fact) -> fact.value
            .Store(fact) -> fact.value
            .QueryCache(fact) -> fact.value
            .FormDraft(fact) -> fact.value
            .Scroll(fact) -> fact.value
            .Focus(fact) -> fact.value
            .Island(fact) -> fact.value
        }
    }
    with_value: fn(self, value: WebStateValue) -> WebModuleSwapStateFact {
        if self == {
            .Signal(fact) -> WebModuleSwapStateFact.Signal(WebSignalFact{key: fact.key, type_fingerprint: fact.type_fingerprint, value})
            .Store(fact) -> WebModuleSwapStateFact.Store(WebStoreFact{key: fact.key, type_fingerprint: fact.type_fingerprint, value})
            .QueryCache(fact) -> WebModuleSwapStateFact.QueryCache(WebQueryCacheFact{key: fact.key, type_fingerprint: fact.type_fingerprint, value})
            .FormDraft(fact) -> WebModuleSwapStateFact.FormDraft(WebFormDraftFact{key: fact.key, type_fingerprint: fact.type_fingerprint, value})
            .Scroll(fact) -> WebModuleSwapStateFact.Scroll(WebScrollFact{key: fact.key, type_fingerprint: fact.type_fingerprint, value})
            .Focus(fact) -> WebModuleSwapStateFact.Focus(WebFocusFact{key: fact.key, type_fingerprint: fact.type_fingerprint, value})
            .Island(fact) -> WebModuleSwapStateFact.Island(WebIslandFact{key: fact.key, identity: fact.identity, type_fingerprint: fact.type_fingerprint, value})
        }
    }
    same_slot: fn(self, other: WebModuleSwapStateFact) -> Bool { self.kind() == other.kind() && self.key() == other.key() }
}

WebModuleSwapSnapshot: struct {
    identity: WebModuleSwapIdentity
    source_revision: String
    build_revision: String
    page: WebPageFact
    modules: [WebModuleFact]
    state: [WebModuleSwapStateFact]
}
impl WebModuleSwapSnapshot {
    new: fn(identity: WebModuleSwapIdentity, source_revision: String, build_revision: String, page: WebPageFact, modules: [WebModuleFact], state: [WebModuleSwapStateFact]) -> WebModuleSwapSnapshot WebModuleSwapError! {
        snapshot := WebModuleSwapSnapshot{identity, source_revision, build_revision, page, modules, state}
        snapshot.normalize()
        snapshot
    }
    // Sorts modules by identity and state by (kind, key), then rejects empty or duplicate facts.
    normalize: fn(&self) WebModuleSwapError! {
        if !self.identity.is_valid() -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "module and page identity must be non-empty"))
        if self.source_revision.len() == 0 || self.build_revision.len() == 0 -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "source and build revisions must be non-empty"))
        if self.page.identity.len() == 0 -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "page identity must be non-empty"))
        if self.page.identity != self.identity.page -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "page fact identity does not match swap identity"))
        self.modules.sort_by((left, right) -> left.identity <=> right.identity)
        loop item in self.modules {
            if item.identity.len() == 0 || item.interface_fingerprint.len() == 0 || item.body_fingerprint.len() == 0 -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "module identity and fingerprints must be non-empty"))
        }
        loop index in 1..<self.modules.len() {
            if self.modules[index - 1].identity == self.modules[index].identity -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "module identities must be unique"))
        }
        web_swap_sort_state(self.state)
        loop fact in self.state {
            if fact.key().len() == 0 || fact.type_fingerprint().len() == 0 -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "state keys and type fingerprints must be non-empty"))
            if fact.kind() == WebStateKind.Island && fact.identity().len() == 0 -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "island identities must be non-empty"))
        }
        loop index in 1..<self.state.len() {
            if self.state[index - 1].same_slot(self.state[index]) -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "state keys must be unique within a state family"))
        }
    }
    module_ref: fn(self, identity: String) -> WebModuleFact? {
        loop item in self.modules {
            if item.identity == identity -> return Val(item)
        }
        None
    }
    state_fact: fn(self, kind: WebStateKind, key: String) -> WebModuleSwapStateFact? {
        loop fact in self.state {
            if fact.kind() == kind && fact.key() == key -> return Val(fact)
        }
        None
    }
}

WebModuleSwapReasonCode: enum {
    NoChange SourceRevisionChanged BuildRevisionChanged ModuleBodyChanged ModuleAdded ModuleRemoved ModuleIdentityChanged
    ModuleInterfaceChanged PageIdentityChanged StateAdded StateRemoved StateRetentionFresh SignalTypeChanged
    StoreTypeChanged QueryCacheTypeChanged FormDraftTypeChanged ScrollTypeChanged FocusTypeChanged IslandTypeChanged
    IslandIdentityChanged IdentityMismatch SemanticIncompatible StalePlan NothingToRollback
}
impl WebModuleSwapReasonCode {
    as_str: fn(self) -> String {
        if self == {
            .NoChange -> "no_change"
            .SourceRevisionChanged -> "source_revision_changed"
            .BuildRevisionChanged -> "build_revision_changed"
            .ModuleBodyChanged -> "module_body_changed"
            .ModuleAdded -> "module_added"
            .ModuleRemoved -> "module_removed"
            .ModuleIdentityChanged -> "module_identity_changed"
            .ModuleInterfaceChanged -> "module_interface_changed"
            .PageIdentityChanged -> "page_identity_changed"
            .StateAdded -> "state_added"
            .StateRemoved -> "state_removed"
            .StateRetentionFresh -> "state_retention_fresh"
            .SignalTypeChanged -> "signal_type_changed"
            .StoreTypeChanged -> "store_type_changed"
            .QueryCacheTypeChanged -> "query_cache_type_changed"
            .FormDraftTypeChanged -> "form_draft_type_changed"
            .ScrollTypeChanged -> "scroll_type_changed"
            .FocusTypeChanged -> "focus_type_changed"
            .IslandTypeChanged -> "island_type_changed"
            .IslandIdentityChanged -> "island_identity_changed"
            .IdentityMismatch -> "identity_mismatch"
            .SemanticIncompatible -> "semantic_incompatible"
            .StalePlan -> "stale_plan"
            .NothingToRollback -> "nothing_to_rollback"
        }
    }
}
impl WebModuleSwapReasonCode.Display { display: fn(&&self) -> String { self.as_str() } }

WebModuleSwapCompatibility: enum { Compatible Incompatible(reason_codes: [WebModuleSwapReasonCode]) }
impl WebModuleSwapCompatibility {
    is_compatible: fn(self) -> Bool {
        if self == {
            .Compatible -> true
            .Incompatible(_) -> false
        }
    }
    reason_codes: fn(self) -> [WebModuleSwapReasonCode] {
        if self == {
            .Compatible -> [WebModuleSwapReasonCode]{}
            .Incompatible(codes) -> codes
        }
    }
}

WebModuleSwapResetFact: struct {
    state: WebModuleSwapStateFact
    prior_identity: String?
    prior_type_fingerprint: String?
    reason: WebModuleSwapReasonCode
}

WebModuleSwapPlan: struct {
    base: WebModuleSwapSnapshot
    candidate: WebModuleSwapSnapshot
    decision: HotSwapDecision
    compatibility: WebModuleSwapCompatibility
    changed_modules: [String]
    preserved: [WebModuleSwapStateFact]
    reset: [WebModuleSwapResetFact]
    reason_codes: [WebModuleSwapReasonCode]
}
impl WebModuleSwapPlan {
    from_hot_swap_decision: fn(base: WebModuleSwapSnapshot, candidate: WebModuleSwapSnapshot, decision: HotSwapDecision) -> WebModuleSwapPlan WebModuleSwapError! {
        checked_base := base
        checked_candidate := candidate
        checked_base.normalize()
        checked_candidate.normalize()
        if decision.module_ref.len() == 0 || decision.module_ref != checked_base.identity.module_ref -> return Err(WebModuleSwapError.DecisionModuleMismatch(expected: checked_base.identity.module_ref, found: decision.module_ref))
        retention := [String:StateRetentionFact]{}
        loop fact in decision.state_facts() {
            if fact.key.len() == 0 -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "hot-swap retention keys must be non-empty"))
            if retention.get(fact.key) != None -> return Err(WebModuleSwapError.DuplicateRetentionKey(key: fact.key))
            retention[fact.key] = fact
        }
        old_state: web_swap_state_by_key(checked_base.state)
        new_state: web_swap_state_by_key(checked_candidate.state)
        old_keys := old_state.keys().to_list()
        old_keys.sort()
        new_keys := new_state.keys().to_list()
        new_keys.sort()
        retention_keys := retention.keys().to_list()
        retention_keys.sort()
        // Every typed state key, resident keys first, needs exactly one Sema retention fact.
        loop key in old_keys {
            if retention.get(key) == None {
                fact: new_state.get(key) ?? old_state[key]
                return Err(WebModuleSwapError.MissingRetentionFact(kind: fact.kind(), key: key))
            }
        }
        loop key in new_keys {
            if retention.get(key) == None -> return Err(WebModuleSwapError.MissingRetentionFact(kind: new_state[key].kind(), key: key))
        }
        loop key in retention_keys {
            if old_state.get(key) == None && new_state.get(key) == None -> return Err(WebModuleSwapError.UnusedRetentionFact(key: key))
        }
        compatible: decision.is_compatible()
        changed: decision.changed.len() > 0 || decision.changed_functions.len() > 0
        changed_modules := [String]{}
        if changed || !compatible -> changed_modules.push(decision.module_ref)
        fresh := false
        removed := false
        preserved := [WebModuleSwapStateFact]{}
        reset := [WebModuleSwapResetFact]{}
        loop key in new_keys {
            new_fact: new_state[key]
            if retention[key].decision == {
                .Preserve -> {
                    old_fact: old_state.get(key) ?? return Err(WebModuleSwapError.InvalidSnapshot(detail: "retention fact `{key}` preserves state with no resident value"))
                    preserved.push(new_fact.with_value(old_fact.value()))
                }
                else -> {
                    fresh = true
                    reset.push(web_swap_fresh_reset(new_fact, old_state.get(key)))
                }
            }
        }
        loop key in old_keys {
            if new_state.get(key) != None -> next
            old_fact: old_state[key]
            if retention[key].decision == .Preserve -> return Err(WebModuleSwapError.InvalidSnapshot(detail: "retention fact `{key}` preserves removed state"))
            removed = true
            reset.push(WebModuleSwapResetFact{state: old_fact, prior_identity: Val(old_fact.identity()), prior_type_fingerprint: Val(old_fact.type_fingerprint()), reason: WebModuleSwapReasonCode.StateRemoved})
        }
        web_swap_sort_state(preserved)
        reset.sort_by((left, right) -> (left.state.kind().rank() <=> right.state.kind().rank()).then(left.state.key() <=> right.state.key()))
        // Reason codes are reported once each, in declaration order.
        reason_codes := [WebModuleSwapReasonCode]{}
        if checked_base.source_revision != checked_candidate.source_revision -> reason_codes.push(WebModuleSwapReasonCode.SourceRevisionChanged)
        if checked_base.build_revision != checked_candidate.build_revision -> reason_codes.push(WebModuleSwapReasonCode.BuildRevisionChanged)
        if decision.changed_functions.len() > 0 && compatible -> reason_codes.push(WebModuleSwapReasonCode.ModuleBodyChanged)
        if removed -> reason_codes.push(WebModuleSwapReasonCode.StateRemoved)
        if fresh -> reason_codes.push(WebModuleSwapReasonCode.StateRetentionFresh)
        if !compatible -> reason_codes.push(WebModuleSwapReasonCode.SemanticIncompatible)
        if reason_codes.len() == 0 -> reason_codes.push(WebModuleSwapReasonCode.NoChange)
        compatibility: if compatible -> WebModuleSwapCompatibility.Compatible else -> WebModuleSwapCompatibility.Incompatible(reason_codes: [WebModuleSwapReasonCode]{WebModuleSwapReasonCode.SemanticIncompatible})
        WebModuleSwapPlan{base: checked_base, candidate: checked_candidate, decision, compatibility, changed_modules, preserved, reset, reason_codes}
    }
    is_compatible: fn(self) -> Bool { self.decision.is_compatible() }
    changed_module_set: fn(self) -> [String] { self.changed_modules }
    applied_snapshot: fn(self) -> WebModuleSwapSnapshot {
        snapshot := self.candidate
        loop kept in self.preserved {
            loop index in 0..<snapshot.state.len() {
                if snapshot.state[index].same_slot(kept) -> snapshot.state[index] = kept
            }
        }
        snapshot
    }
}

WebModuleSwapOperation: enum { Pause Apply Commit Rollback Restart }
impl WebModuleSwapOperation {
    as_str: fn(self) -> String {
        if self == {
            .Pause -> "pause"
            .Apply -> "apply"
            .Commit -> "commit"
            .Rollback -> "rollback"
            .Restart -> "restart"
        }
    }
}
impl WebModuleSwapOperation.Display { display: fn(&&self) -> String { self.as_str() } }

WebModuleSwapPhase: enum { Committed Paused Applied }
impl WebModuleSwapPhase {
    as_str: fn(self) -> String {
        if self == {
            .Committed -> "committed"
            .Paused -> "paused"
            .Applied -> "applied"
        }
    }
}
impl WebModuleSwapPhase.Display { display: fn(&&self) -> String { self.as_str() } }

WebModuleSwapReceiptStatus: enum { Paused Applied Committed RolledBack Restarted }
impl WebModuleSwapReceiptStatus {
    as_str: fn(self) -> String {
        if self == {
            .Paused -> "paused"
            .Applied -> "applied"
            .Committed -> "committed"
            .RolledBack -> "rolled_back"
            .Restarted -> "restarted"
        }
    }
}

WebModuleSwapReceipt: struct {
    operation: WebModuleSwapOperation
    status: WebModuleSwapReceiptStatus
    phase: WebModuleSwapPhase
    identity: WebModuleSwapIdentity
    candidate_identity: WebModuleSwapIdentity
    source_revision: String
    build_revision: String
    changed_modules: [String]
    reason_codes: [WebModuleSwapReasonCode]
    preserved: [WebModuleSwapStateFact]
    reset: [WebModuleSwapResetFact]
    committed_page: WebPageFact
    active_page: WebPageFact
}
impl WebModuleSwapReceipt {
    changed_module_set: fn(self) -> [String] { self.changed_modules }
    preserved_facts: fn(self) -> [WebModuleSwapStateFact] { self.preserved }
    audit: fn(self) -> String {
        changed: self.changed_modules.join(",")
        reason_names := [String]{}
        loop reason in self.reason_codes -> reason_names.push(reason.as_str())
        reasons: reason_names.join(",")
        preserved_names := [String]{}
        loop fact in self.preserved -> preserved_names.push("{fact.kind().as_str()}:{fact.key()}")
        preserved: preserved_names.join(",")
        reset_names := [String]{}
        loop fact in self.reset -> reset_names.push("{fact.state.kind().as_str()}:{fact.state.key()}({fact.reason.as_str()})")
        reset: reset_names.join(",")
        "operation={self.operation.as_str()} status={self.status.as_str()} phase={self.phase.as_str()} identity={self.identity.module_ref}/{self.identity.page} candidate={self.candidate_identity.module_ref}/{self.candidate_identity.page} source_revision={self.source_revision} build_revision={self.build_revision} changed_modules=[{changed}] reasons=[{reasons}] preserved=[{preserved}] reset=[{reset}] committed_page={self.committed_page.artifact} active_page={self.active_page.artifact}"
    }
}

#Error
WebModuleSwapError: enum {
    InvalidSnapshot(detail: String)
    IdentityMismatch(expected: WebModuleSwapIdentity, found: WebModuleSwapIdentity)
    DecisionModuleMismatch(expected: String, found: String)
    MissingRetentionFact(kind: WebStateKind, key: String)
    DuplicateRetentionKey(key: String)
    UnusedRetentionFact(key: String)
    StalePlan(expected_source_revision: String, found_source_revision: String, expected_build_revision: String, found_build_revision: String)
    Incompatible(reason_codes: [WebModuleSwapReasonCode])
    InvalidTransition(operation: WebModuleSwapOperation, phase: WebModuleSwapPhase)
    NoPendingPlan NoAppliedPlan NoCommittedPage
}
impl WebModuleSwapError.Display {
    display: fn(&&self) -> String {
        if self == {
            .InvalidSnapshot(detail) -> "invalid web swap snapshot: {detail}"
            .IdentityMismatch(expected, found) -> "web swap identity mismatch: expected {expected.module_ref}/{expected.page} but found {found.module_ref}/{found.page}"
            .DecisionModuleMismatch(expected, found) -> "web swap decision module mismatch: expected `{expected}` but found `{found}`"
            .MissingRetentionFact(kind, key) -> "web swap has no canonical retention fact for {kind.as_str()} `{key}`"
            .DuplicateRetentionKey(key) -> "web swap retention key `{key}` is not unique"
            .UnusedRetentionFact(key) -> "web swap retention fact `{key}` has no typed state"
            .StalePlan(expected_source, found_source, expected_build, found_build) -> "stale web swap plan: expected source/build {expected_source}/{expected_build} but state is {found_source}/{found_build}"
            .Incompatible(codes) -> "web module swap is incompatible: {web_swap_reason_list(codes)}"
            .InvalidTransition(operation, phase) -> "web swap cannot {operation.as_str()} while phase is {phase.as_str()}"
            .NoPendingPlan -> "web swap has no pending plan"
            .NoAppliedPlan -> "web swap has no applied plan"
            .NoCommittedPage -> "web swap has no committed page"
        }
    }
}

WebModuleSwapState: struct {
    committed_snapshot: WebModuleSwapSnapshot
    pending_plan: WebModuleSwapPlan?
    active_snapshot: WebModuleSwapSnapshot
    current_phase: WebModuleSwapPhase
}
impl WebModuleSwapState {
    new: fn(snapshot: WebModuleSwapSnapshot) -> WebModuleSwapState WebModuleSwapError! {
        checked := snapshot
        checked.normalize()
        WebModuleSwapState{committed_snapshot: checked, pending_plan: None, active_snapshot: checked, current_phase: WebModuleSwapPhase.Committed}
    }
    committed: fn(self) -> WebModuleSwapSnapshot { self.committed_snapshot }
    active: fn(self) -> WebModuleSwapSnapshot { self.active_snapshot }
    pending: fn(self) -> WebModuleSwapPlan? { self.pending_plan }
    phase: fn(self) -> WebModuleSwapPhase { self.current_phase }
    pause: fn(&self, plan: WebModuleSwapPlan) -> WebModuleSwapReceipt WebModuleSwapError! {
        if self.current_phase != WebModuleSwapPhase.Committed || self.pending_plan != None -> return Err(WebModuleSwapError.InvalidTransition(operation: WebModuleSwapOperation.Pause, phase: self.current_phase))
        self.validate_base(plan)
        if !plan.base.identity.matches(plan.candidate.identity) -> return Err(WebModuleSwapError.IdentityMismatch(expected: plan.base.identity, found: plan.candidate.identity))
        if !plan.is_compatible() -> return Err(WebModuleSwapError.Incompatible(reason_codes: plan.compatibility.reason_codes()))
        self.pending_plan = Val(plan)
        self.current_phase = WebModuleSwapPhase.Paused
        self.receipt_for_plan(plan, WebModuleSwapOperation.Pause, WebModuleSwapReceiptStatus.Paused)
    }
    apply: fn(&self) -> WebModuleSwapReceipt WebModuleSwapError! {
        if self.current_phase != WebModuleSwapPhase.Paused -> return Err(WebModuleSwapError.InvalidTransition(operation: WebModuleSwapOperation.Apply, phase: self.current_phase))
        plan: self.pending_plan ?? return Err(WebModuleSwapError.NoPendingPlan)
        self.validate_base(plan)
        if !plan.is_compatible() -> return Err(WebModuleSwapError.Incompatible(reason_codes: plan.compatibility.reason_codes()))
        self.active_snapshot = plan.applied_snapshot()
        self.current_phase = WebModuleSwapPhase.Applied
        self.receipt_for_plan(plan, WebModuleSwapOperation.Apply, WebModuleSwapReceiptStatus.Applied)
    }
    commit: fn(&self) -> WebModuleSwapReceipt WebModuleSwapError! {
        if self.current_phase != WebModuleSwapPhase.Applied -> return Err(WebModuleSwapError.InvalidTransition(operation: WebModuleSwapOperation.Commit, phase: self.current_phase))
        plan: self.pending_plan ?? return Err(WebModuleSwapError.NoAppliedPlan)
        self.validate_base(plan)
        if !self.active_snapshot.identity.matches(plan.candidate.identity) -> return Err(WebModuleSwapError.IdentityMismatch(expected: plan.candidate.identity, found: self.active_snapshot.identity))
        self.pending_plan = None
        self.committed_snapshot = self.active_snapshot
        self.current_phase = WebModuleSwapPhase.Committed
        self.receipt_for_plan(plan, WebModuleSwapOperation.Commit, WebModuleSwapReceiptStatus.Committed)
    }
    // Rollback always restores the last committed page; with no pending plan it reports nothing to roll back.
    rollback: fn(&self) -> WebModuleSwapReceipt {
        prior: self.pending_plan
        self.pending_plan = None
        self.active_snapshot = self.committed_snapshot
        self.current_phase = WebModuleSwapPhase.Committed
        if prior == .Val(plan) -> return self.receipt_for_plan(plan, WebModuleSwapOperation.Rollback, WebModuleSwapReceiptStatus.RolledBack)
        WebModuleSwapReceipt{operation: WebModuleSwapOperation.Rollback, status: WebModuleSwapReceiptStatus.RolledBack, phase: self.current_phase,
            identity: self.committed_snapshot.identity, candidate_identity: self.committed_snapshot.identity,
            source_revision: self.committed_snapshot.source_revision, build_revision: self.committed_snapshot.build_revision,
            changed_modules: [String]{}, reason_codes: [WebModuleSwapReasonCode]{WebModuleSwapReasonCode.NothingToRollback},
            preserved: [WebModuleSwapStateFact]{}, reset: [WebModuleSwapResetFact]{},
            committed_page: self.committed_snapshot.page, active_page: self.active_snapshot.page}
    }
    // Compatible plans pause, apply and commit as one transaction; any failure rolls back.
    apply_decision: fn(&self, plan: WebModuleSwapPlan) -> WebModuleSwapReceipt WebModuleSwapError! {
        if !plan.is_compatible() -> return self.restart(plan)
        self.pause(plan)
        _: self.apply() ?? {
            _: self.rollback()
            return Err(err)
        }
        receipt: self.commit() ?? {
            _: self.rollback()
            return Err(err)
        }
        receipt
    }
    restart: fn(&self, plan: WebModuleSwapPlan) -> WebModuleSwapReceipt WebModuleSwapError! {
        if self.current_phase != WebModuleSwapPhase.Committed || self.pending_plan != None -> return Err(WebModuleSwapError.InvalidTransition(operation: WebModuleSwapOperation.Restart, phase: self.current_phase))
        self.validate_base(plan)
        if !plan.base.identity.matches(plan.candidate.identity) -> return Err(WebModuleSwapError.IdentityMismatch(expected: plan.base.identity, found: plan.candidate.identity))
        if plan.is_compatible() -> return Err(WebModuleSwapError.Incompatible(reason_codes: [WebModuleSwapReasonCode]{WebModuleSwapReasonCode.SemanticIncompatible}))
        self.active_snapshot = plan.candidate
        self.committed_snapshot = plan.candidate
        self.current_phase = WebModuleSwapPhase.Committed
        self.receipt_for_plan(plan, WebModuleSwapOperation.Restart, WebModuleSwapReceiptStatus.Restarted)
    }
    validate_base: fn(self, plan: WebModuleSwapPlan) WebModuleSwapError! {
        if !self.committed_snapshot.identity.matches(plan.base.identity) -> return Err(WebModuleSwapError.IdentityMismatch(expected: self.committed_snapshot.identity, found: plan.base.identity))
        if self.committed_snapshot.source_revision != plan.base.source_revision || self.committed_snapshot.build_revision != plan.base.build_revision {
            return Err(WebModuleSwapError.StalePlan(expected_source_revision: plan.base.source_revision, found_source_revision: self.committed_snapshot.source_revision, expected_build_revision: plan.base.build_revision, found_build_revision: self.committed_snapshot.build_revision))
        }
    }
    receipt_for_plan: fn(self, plan: WebModuleSwapPlan, operation: WebModuleSwapOperation, status: WebModuleSwapReceiptStatus) -> WebModuleSwapReceipt {
        WebModuleSwapReceipt{operation, status, phase: self.current_phase, identity: self.committed_snapshot.identity, candidate_identity: plan.candidate.identity,
            source_revision: plan.candidate.source_revision, build_revision: plan.candidate.build_revision, changed_modules: plan.changed_modules,
            reason_codes: plan.reason_codes, preserved: plan.preserved, reset: plan.reset,
            committed_page: self.committed_snapshot.page, active_page: self.active_snapshot.page}
    }
}

web_swap_sort_state: fn(facts: &[WebModuleSwapStateFact]) {
    facts.sort_by((left, right) -> (left.kind().rank() <=> right.kind().rank()).then(left.key() <=> right.key()))
}
web_swap_state_by_key: fn(facts: [WebModuleSwapStateFact]) -> [String:WebModuleSwapStateFact] WebModuleSwapError! {
    by_key := [String:WebModuleSwapStateFact]{}
    loop fact in facts {
        if by_key.get(fact.key()) != None -> return Err(WebModuleSwapError.DuplicateRetentionKey(key: fact.key()))
        by_key[fact.key()] = fact
    }
    by_key
}
web_swap_fresh_reset: fn(fact: WebModuleSwapStateFact, prior: WebModuleSwapStateFact?) -> WebModuleSwapResetFact {
    if prior == .Val(old_fact) {
        return WebModuleSwapResetFact{state: fact, prior_identity: Val(old_fact.identity()), prior_type_fingerprint: Val(old_fact.type_fingerprint()), reason: WebModuleSwapReasonCode.StateRetentionFresh}
    }
    WebModuleSwapResetFact{state: fact, prior_identity: None, prior_type_fingerprint: None, reason: WebModuleSwapReasonCode.StateAdded}
}
web_swap_reason_list: fn(codes: [WebModuleSwapReasonCode]) -> String {
    names := [String]{}
    loop code in codes -> names.push(code.as_str())
    names.join(",")
}
