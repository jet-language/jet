struct WebModuleSwapPlan {
    base: WebModuleSwapSnapshot; candidate: WebModuleSwapSnapshot
    // Sema owns compatibility and retention; this adapter never re-derives either.
    decision: HotSwapDecision; compatibility: WebModuleSwapCompatibility
    changed_modules: [String]; preserved: [WebModuleSwapStateFact]; reset: [WebModuleSwapResetFact]; reason_codes: [WebModuleSwapReasonCode]
}
impl WebModuleSwapPlan {
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:591
    fn from_hot_swap_decision(base: WebModuleSwapSnapshot, candidate: WebModuleSwapSnapshot, decision: HotSwapDecision) -> Self WebModuleSwapError! {
        base := base.clone(); candidate := candidate.clone(); base.normalize()?; candidate.normalize()
        if decision.module_ref.is_empty() || decision.module_ref != base.identity.module_ref -> return .Err(.DecisionModuleMismatch(expected: base.identity.module_ref.clone(), found: decision.module_ref.clone()))
        retention := [String:&StateRetentionFact]{}
        loop fact in decision.state_facts() {
            if fact.key.is_empty() -> return .Err(.InvalidSnapshot(detail: "hot-swap retention keys must be non-empty"))
            if retention.insert(fact.key.as_str(), fact).is_some() -> return .Err(.DuplicateRetentionKey(key: fact.key.clone()))
        }
        old_state := [String:&WebModuleSwapStateFact]{}
        loop fact in &base.state {
            if old_state.insert(fact.key(), fact).is_some() -> return .Err(.DuplicateRetentionKey(key: fact.key().to_string()))
        }
        new_state := [String:&WebModuleSwapStateFact]{}
        loop fact in &candidate.state {
            if new_state.insert(fact.key(), fact).is_some() -> return .Err(.DuplicateRetentionKey(key: fact.key().to_string()))
        }
        old_keys :: old_state.keys().sorted(); new_keys :: new_state.keys().sorted(); retention_keys :: retention.keys().sorted()
        loop key in old_keys.iter().chain(new_keys.iter()) {
            if !retention.contains_key(key) {
                fact :: new_state.get(key).or_else(() -> old_state.get(key)).expect("state key exists")
                return .Err(.MissingRetentionFact(kind: fact.kind(), key: key.to_string()))
            }
        }
        loop key in &retention_keys {
            if !old_state.contains_key(key) && !new_state.contains_key(key) -> return .Err(.UnusedRetentionFact(key: key.to_string()))
        }
        reasons := [WebModuleSwapReasonCode:Bool]{} // GATE #4499: exact enum keys, declaration order.
        if base.source_revision != candidate.source_revision -> reasons.insert(.SourceRevisionChanged, true)
        if base.build_revision != candidate.build_revision -> reasons.insert(.BuildRevisionChanged, true)
        changed :: !decision.changed.is_empty() || !decision.changed_functions.is_empty()
        changed_modules :: if changed || !decision.is_compatible() -> [decision.module_ref.clone()] else -> []
        if !decision.changed_functions.is_empty() && decision.is_compatible() -> reasons.insert(.ModuleBodyChanged, true)
        if !decision.is_compatible() -> reasons.insert(.SemanticIncompatible, true)
        preserved := [WebModuleSwapStateFact]{}; reset := [WebModuleSwapResetFact]{}
        loop key in &new_keys {
            new_fact :: new_state.get(key).unwrap(); retention_fact :: retention.get(key).expect("checked web retention fact")
            match.bit_and(retention_fact.decision) {
                .Preserve -> {
                    old_fact :: old_state.get(key).ok_or_else(() -> WebModuleSwapError.InvalidSnapshot(detail: "retention fact `{key}` preserves state with no resident value"))?
                    preserved.push(new_fact.with_value(old_fact.value().clone()))
                }
                .Fresh(..) -> {
                    reasons.insert(.StateRetentionFresh, true)
                    (prior_identity, prior_type_fingerprint) :: old_state.get(key).map((old_fact) -> (.Val(old_fact.identity().to_string()), .Val(old_fact.type_fingerprint().to_string()))).unwrap_or((.None, .None))
                    reset.push(WebModuleSwapResetFact(state: new_fact.clone(), prior_identity: ^prior_identity, prior_type_fingerprint: ^prior_type_fingerprint, reason: if old_state.contains_key(key) { .StateRetentionFresh } else { .StateAdded }))
                }
            }
        }
        loop key in &old_keys {
            if new_state.contains_key(key) -> next
            old_fact :: old_state.get(key).unwrap(); retention_fact :: retention.get(key).expect("checked web retention fact")
            if retention_fact.decision == .Preserve -> return .Err(.InvalidSnapshot(detail: "retention fact `{key}` preserves removed state"))
            reasons.insert(.StateRemoved, true)
            reset.push(WebModuleSwapResetFact(state: old_fact.clone(), prior_identity: .Val(old_fact.identity().to_string()), prior_type_fingerprint: .Val(old_fact.type_fingerprint().to_string()), reason: .StateRemoved))
        }
        if reasons.is_empty() -> reasons.insert(.NoChange, true)
        preserved.sort_by((left, right) -> (_0: left.kind(), _1: left.key()).cmp(&(_0: right.kind(), _1: right.key())))
        reset.sort_by((left, right) -> (_0: left.state.kind(), _1: left.state.key()).cmp(&(_0: right.state.kind(), _1: right.state.key())))
        reason_codes :: reasons.keys().sorted()
        compatibility :: if decision.is_compatible() -> .Compatible else -> .Incompatible(reason_codes: [.SemanticIncompatible])
        return .Ok(Self(base: ^base, candidate: ^candidate, decision: decision.clone(), compatibility: ^compatibility, changed_modules: ^changed_modules, preserved: ^preserved, reset: ^reset, reason_codes: ^reason_codes))
    }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:762
    fn decision(self: Self) -> HotSwapDecision { &self.decision }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:766
    fn is_compatible(self: Self) -> Bool { self.decision.is_compatible() }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:770
    fn changed_module_set(self: Self) -> [String] { &self.changed_modules }
    // Rust: crates/jet-devserver/src/WebModuleSwap.rs:774
    fn applied_snapshot(self: Self) -> WebModuleSwapSnapshot {
        snapshot := self.candidate.clone()
        loop preserved in &self.preserved {
            if snapshot.state.iter_mut().find((fact) -> fact.kind() == preserved.kind() && fact.key() == preserved.key()) == .Val(slot) -> *slot = preserved.clone()
        }
        return ^snapshot
    }
}
