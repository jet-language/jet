// Rust: crates/jet-devserver/src/WebHost.rs:5926
fn inject_canvas_session(asset: CanvasAsset, session_secret: String) -> CanvasAsset {
    asset := ^asset
    if asset.content_type == "text/html; charset=utf-8" {
        if asset.body.find("app.js?") == .Val(index) {
            insert_at :: index + "app.js?".len()
            asset.body.insert_str(insert_at, format("session={}&", session_secret))
        }
    }
    return ^asset
}
// Rust: crates/jet-devserver/src/WebHost.rs:5941
fn method_not_allowed(stream: &impl Write) -> Result<Unit, Error> {
    write_response(stream, "405 Method Not Allowed", "text/plain; charset=utf-8", b"method not allowed")
}
// Rust: crates/jet-devserver/src/WebHost.rs:5950
fn web_stream_path(path: String) -> Bool { path == "/__jet_web/stream" }
// Rust: crates/jet-devserver/src/WebHost.rs:5957
// Same Canvas handlers, not a second editor.
fn source_tool_path(path: String) -> Bool {
    path is "/__jet_canvas/project" | "/__jet_canvas/source" | "/__jet_canvas/command" | "/__jet_canvas/transaction"
}
// Rust: crates/jet-devserver/src/WebHost.rs:5967
fn devtools_path(path: String) -> Bool {
    path is "/__jet_devtools" | "/__jet_devtools/workbench" | "/__jet_devtools/commands"
        | "/__jet_devtools/assets" | "/__jet_devtools/state" | "/__jet_devtools/reconnect"
        | "/__jet_devtools/action" | "/__jet_devtools/selection" | "/__jet_devtools/cursor"
        | "/__jet_devtools/swap" | "/__jet_devtools/recording" | "/__jet_devtools/error"
        | "/__jet_devtools/paused/inspect" | "/__jet_devtools/paused/evaluate"
        | "/__jet_devtools/style" | "/__jet_canvas/devtools" | "/canvas/devtools" | "/panel/devtools"
}
// Rust: crates/jet-devserver/src/WebHost.rs:5991
fn is_application_control_path(path: String) -> Bool {
    devtools_path(path) || web_stream_path(path) || source_tool_path(path)
        || path is "/__jet_dev_status" | "/__jet_dev_version" | "/__jet_dev_disconnect" | "/__jet_perf_browser"
}
