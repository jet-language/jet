WEB_ERROR_REQUEST_COUNTER :: AtomicU64.new(1) // GATE #4494: process-local atomic.
// Rust: crates/jet-devserver/src/WebHost.rs:6009
fn next_web_error_request_id() -> String { format("werr-{}", WEB_ERROR_REQUEST_COUNTER.fetch_add(1, Ordering.SeqCst)) }
// Rust: crates/jet-devserver/src/WebHost.rs:6019
fn paused_evaluate_error_status(error: &PausedEvaluateHostError) -> String {
    match error {
        .SessionUnavailable | .EvaluatorUnavailable -> "409 Conflict"
        .InvalidRequest(_) -> "400 Bad Request"
        .Rejected(_) -> "403 Forbidden"
    }
}
// Rust: crates/jet-devserver/src/WebHost.rs:6030
fn session_response(session: &ResidentDevSession) -> String {
    format("{{\"protocol\":\"jet.canvas.session\",\"schema_version\":1,\"session\":{}}}", session.json())
}
// Rust: crates/jet-devserver/src/WebHost.rs:6037
fn with_session(body: String, session: &ResidentDevSession) -> String {
    marker :: "\"canvas\":{"
    index :: body.find(marker) ?? return ^body
    insert_at :: index + marker.len()
    decorated := String.with_capacity(body.len() + session.json().len() + 16)
    decorated.push_str(body[..insert_at])
    decorated.push_str("\"session\":")
    decorated.push_str(session.json())
    decorated.push(',')
    decorated.push_str(body[insert_at..])
    return ^decorated
}
// Rust: crates/jet-devserver/src/WebHost.rs:6052
fn current_revision_for_request(canvas_file: String, request: String) -> String {
    source_id :: parse_json(request).ok().and_then((value) -> match value {
        .Object(object) -> object.into_iter().find_map(((name, value)) -> {
            if name != "source_id" -> return .None
            match value { .Text(id) | .TypedText(id) -> .Val(^id); _ -> .None }
        })
        _ -> .None
    }).unwrap_or_default()
    return current_revision_for_source_id(canvas_file, (!source_id.is_empty()).then_some(source_id.as_str()))
}
// Rust: crates/jet-devserver/src/WebHost.rs:6075
fn source_id_from_payload(payload: String) -> String {
    value :: match parse_json(payload) { .Ok(value) -> value; .Err(_) -> return "" }
    // Rust: crates/jet-devserver/src/WebHost.rs:6080
    fn find(value: &DataTree) -> String? {
        return match value {
            .Object(object) -> {
                if object.iter().find_map(((name, value)) -> {
                    if name != "source_id" -> return .None
                    match value { .Text(id) | .TypedText(id) -> .Val(id.clone()); _ -> .None }
                }) == .Val(source_id) -> return .Val(^source_id)
                object.iter().find_map(((_, value)) -> find(value))
            }
            .Array(values) -> values.iter().find_map(find)
            _ -> .None
        }
    }
    return find(&value).unwrap_or_default()
}
// Rust: crates/jet-devserver/src/WebHost.rs:6105
fn current_revision_for_source_id(canvas_file: String, source_id: String?) -> String {
    source_path :: source_id.and_then((id) -> Canvas.project_path_for_source_id(OSPath.new(canvas_file), id)).unwrap_or_else(() -> OSPath.new(canvas_file))
    return Canvas.read_source_without_symlinks(&source_path).map((source) -> Canvas.source_revision(source)).unwrap_or_default()
}
// Rust: crates/jet-devserver/src/WebHost.rs:6116
fn serve_static_from_root(stream: &impl Write, root: &OSPath, path: String, nonce: String, session_secret: String) -> Result<U16, Error> {
    // The generated output root is the complete preview boundary. No source fallback.
    relative :: match static_relative_path(path) {
        .Ok(path) -> path
        .Err(()) -> { write_response(stream, "400 Bad Request", "text/plain; charset=utf-8", b"bad path")?; return .Ok(400) }
    }
    content_type :: content_type_for(&relative)
    is_html :: relative.extension().and_then((extension) -> extension.to_str()).is_some_and((extension) -> extension.eq_ignore_ascii_case("html"))
    reload_script := is_html.then(() -> live_reload_script(nonce, session_secret))
    raw_limit :: match reload_script.as_mut() {
        .Val(script) -> {
            script.shrink_to_fit()
            if !html_script_fits_budget(script.capacity()) {
                write_response(stream, "500 Internal Server Error", "text/plain; charset=utf-8", b"live-reload script exceeds the response budget")?
                return .Ok(500)
            }
            html_raw_response_limit(script.capacity())
        }
        .None -> MAX_STATIC_RESPONSE_BYTES
    }
    bytes :: match read_static_file_bounded(root, &relative, raw_limit) {
        .Ok(b) -> b
        .Err(error) -> {
            (status, code, body) :: match error.kind() {
                .NotFound | .InvalidData -> ("404 Not Found", 404, format("not found: {}", path))
                _ -> ("400 Bad Request", 400, "bad path")
            }
            write_response(stream, status, "text/plain; charset=utf-8", body.as_bytes())?
            return .Ok(code)
        }
    }
    if reload_script == .Val(script) {
        html :: match decode_html(^bytes) {
            .Ok(html) -> html
            .Err(_) -> { write_response(stream, "500 Internal Server Error", "text/plain; charset=utf-8", b"static HTML is not valid UTF-8")?; return .Ok(500) }
        }
        injected :: inject_live_reload_with_script(html, script) ?? {
            write_response(stream, "500 Internal Server Error", "text/plain; charset=utf-8", b"static HTML response is too large")?
            return .Ok(500)
        }
        write_response(stream, "200 OK", content_type, injected.as_bytes())?
        return .Ok(200)
    }
    write_response(stream, "200 OK", content_type, &bytes)?
    return .Ok(200)
}
// Rust: crates/jet-devserver/src/WebHost.rs:6203
fn read_source_without_symlinks(path: &OSPath) -> Result<String, Error> { Canvas.read_source_without_symlinks(path) }
// Rust: crates/jet-devserver/src/WebHost.rs:6207
fn read_web_manifest(root: &OSPath) -> String? {
    bytes :: read_static_file_bounded(root, &OSPath.new("web.manifest.json"), MAX_STATIC_RESPONSE_BYTES).ok()?
    return String.from_utf8(^bytes).ok()
}
// Rust: crates/jet-devserver/src/WebHost.rs:6217
fn decode_html(bytes: [U8]) -> Result<String, Error> {
    String.from_utf8(^bytes).map_err((_) -> Error.new(ErrorKind.InvalidData, "static HTML is not valid UTF-8")) // GATE #4409
}
// Rust: crates/jet-devserver/src/WebHost.rs:6226
fn html_raw_response_limit(script_capacity: USize) -> U64 {
    script_bytes :: U64.try_from(script_capacity).unwrap_or(U64.MAX)
    MAX_STATIC_RESPONSE_BYTES.saturating_sub(script_bytes.saturating_mul(2)) / 2
}
// Rust: crates/jet-devserver/src/WebHost.rs:6231
fn html_script_fits_budget(script_capacity: USize) -> Bool {
    script_bytes :: U64.try_from(script_capacity).unwrap_or(U64.MAX)
    script_bytes.saturating_mul(2) <= MAX_STATIC_RESPONSE_BYTES
}
