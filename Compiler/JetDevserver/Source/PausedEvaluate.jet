            .InsufficientAuthority -> "insufficient_authority", .BudgetExceeded -> "budget_exceeded", .Cancelled -> "cancelled",
            .EvaluatorFailed -> "evaluator_failed", .MutationNotAllowed -> "mutation_not_allowed", .ObservationMissing -> "observation_missing",
