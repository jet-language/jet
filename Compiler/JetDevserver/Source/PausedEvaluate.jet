//RS /// Explicit failure to serve a `/paused/inspect` or `/paused/evaluate`
//RS /// request from [`PausedEvaluateHost`]'s currently injected facts.  This is
//RS /// distinct from [`RequestError`]: it covers the cases the kernel cannot
//RS /// even be called for, because no real session or evaluator fact has been
//RS /// injected yet.
//RS #[derive(Clone, Debug, Eq, PartialEq)]
//RS pub enum PausedEvaluateHostError {
//RS     /// No paused session has been injected, or it was cleared (resume,
//RS     /// detach, process exit).  There is nothing to inspect or evaluate.
//RS     SessionUnavailable,
//RS     /// A session is injected, but the real evaluator has not supplied a
//RS     /// result fact for this evaluate call.
//RS     EvaluatorUnavailable,
//RS     /// The request body was not valid JSON for the expected request shape.
//RS     InvalidRequest(String),
//RS     /// The kernel rejected the request against the injected facts.
//RS     Rejected(RequestError),
//RS }
//RS 
//RS impl PausedEvaluateHostError {
//RS     /// Explicit bounded JSON error body; never a fabricated success value.
