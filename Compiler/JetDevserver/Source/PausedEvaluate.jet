            .Unit -> "{\"kind\":\"unit\"}"
            .Bool(value) -> "{{\"kind\":\"bool\",\"value\":{value}}}"
            .Int(value) -> "{{\"kind\":\"int\",\"value\":{value}}}"
            .FloatBits(bits) -> "{{\"kind\":\"float_bits\",\"bits\":{bits}}}"
            .Text(value) -> "{{\"kind\":\"text\",\"value\":\"{json_escape(value)}\"}}"
            .Bytes { length, sha256 } -> "{{\"kind\":\"bytes\",\"length\":{length},\"sha256\":\"{json_escape(sha256)}\"}}"
