    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:699
    fn validate(self: &Self, identity: &SessionIdentity?) -> Unit Err! {
        valid_id(self.id, "scope id")?
        valid_text(self.name, "scope name", 256)?
        if self.parent_id == .Val(parent) -> valid_id(parent, "parent scope id")?
        self.source.validate()?
        if identity == .Val(identity) {
            if !identity.source_matches(&self.source) -> return .Err("lexical scope source identity does not match the session")
        }
        ids: [String:Bool] := [:]
        nodes: U64 := 0
        for binding in self.bindings -> binding.validate_inner(identity, 1, &ids, &nodes)?
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:719
    fn visible_bindings(self: &Self) -> Iterator[&ValueProjection] { self.bindings.iter().filter((binding) -> binding.publication != .Absent) }
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:727
pub struct ScopeProjection { pub id: String; pub name: String; pub parent_id: String?; pub source: SourceLocation; pub bindings: [ValueProjection] }
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:736
struct ProjectionStats { usage: EvaluationUsage; truncated: Bool; published: U64; redacted: U64 }
impl Default for ProjectionStats { fn default() -> Self { Self { usage: EvaluationUsage.default(), truncated: false, published: 0, redacted: 0 } } }
impl ScopeProjection {
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:744
    fn project(scope: &LexicalScope, identity: &SessionIdentity, budget: EvaluationBudget, selected_value: String?) -> (Self, ProjectionStats) Err! {
        stats := ProjectionStats.default()
        bindings := scope.visible_bindings().filter((binding) -> selected_value.is_none_or((id) -> id == binding.id)).collect[[&ValueProjection]]()
        bindings.sort_by((left, right) -> left.name.cmp(right.name).then(left.id.cmp(right.id)))
        projected: [ValueProjection] := [].with_capacity(bindings.len())
        for binding in bindings {
            if binding.publication == .Published -> stats.published = stats.published.saturating_add(1)
            else -> stats.redacted = stats.redacted.saturating_add(1)
            value :: project_root(binding, identity, budget, &stats)?
            projected.push(^value)
        }
        (Self { id: ~scope.id, name: ~scope.name, parent_id: ~scope.parent_id, source: ~scope.source, bindings: ^projected }, ^stats)
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:778
    pub fn json(self: &Self) -> String {
        bindings :: array_json(self.bindings.iter().filter_map((value) -> value.json()))
        parent_id :: self.parent_id.as_ref().map((id) -> "\"{json_escape(id)}\"").unwrap_or("null")
        "{{\"id\":\"{json_escape(self.id)}\",\"name\":\"{json_escape(self.name)}\",\"parent_id\":{parent_id},\"source\":{self.source.json()},\"bindings\":{bindings}}}"
    }
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:795
pub struct PausedSession {
    pub identity: SessionIdentity; pub state: SessionState; pub scopes: [LexicalScope]
    pub authority: AuthoritySet; pub budget: EvaluationBudget; pub cancellation: Cancellation
}
impl PausedSession {
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:805
    pub fn new(identity: SessionIdentity, state: SessionState, scopes: [LexicalScope], authority: AuthoritySet, budget: EvaluationBudget) -> Self Err! {
        identity.validate()?
        budget.validate()?
        authority.validate()?
        if scopes.len() > MAX_SCOPES -> return .Err("paused session exceeds the lexical scope limit")
        ids: [String:Bool] := [:]
        for scope in scopes {
            scope.validate(.Val(&identity))?
            if ids.insert(~scope.id, true).is_some() -> return .Err("paused session scope ids must be unique")
        }
        for scope in scopes {
            if scope.parent_id == .Val(parent) {
                if !ids.contains_key(parent) -> return .Err("paused lexical scope refers to a missing parent")
            }
        }
        Self { identity: ^identity, state, scopes: ^scopes, authority: ^authority, budget, cancellation: Cancellation.none() }
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:842
    pub fn paused(identity: SessionIdentity, scopes: [LexicalScope], authority: AuthoritySet, budget: EvaluationBudget) -> Self Err! { Self.new(^identity, .Paused, ^scopes, ^authority, budget) }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:851
    pub fn cancel(self: &Self, reason: String) -> Unit Err! { self.cancellation = Cancellation.requested(^reason)?; self.state = .Cancelled }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:857
    fn scope(self: &Self, id: String) -> &LexicalScope? { self.scopes.iter().find((scope) -> scope.id == id) }
}
