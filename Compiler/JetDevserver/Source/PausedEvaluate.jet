    }
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:482
pub struct ValueProjection {
    pub id: String; pub name: String; pub type_name: String; pub source: SourceLocation
    pub publication: Publication; pub value: TypedValue?; pub children: [ValueProjection]; pub truncated: Bool
}
impl ValueProjection {
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:494
    pub fn published(id: String, name: String, type_name: String, source: SourceLocation, value: TypedValue) -> Self {
        Self { id: ^id, name: ^name, type_name: ^type_name, source: ^source, publication: .Published, value: .Val(^value), children: [], truncated: false }
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:513
    pub fn redacted(id: String, name: String, type_name: String, source: SourceLocation) -> Self {
        Self { id: ^id, name: ^name, type_name: ^type_name, source: ^source, publication: .Redacted, value: .None, children: [], truncated: false }
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:531
    pub fn absent(id: String, name: String, type_name: String, source: SourceLocation) -> Self {
        Self { id: ^id, name: ^name, type_name: ^type_name, source: ^source, publication: .Absent, value: .None, children: [], truncated: false }
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:549
    pub fn with_children(self: Self, children: [ValueProjection]) -> Self { self.children = ^children; self }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:554
    pub fn validate(self: &Self) -> Unit Err! {
        ids: [String:Bool] := [:]
        nodes: U64 := 0
        self.validate_inner(.None, 1, &ids, &nodes)
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:560
    fn validate_for_session(self: &Self, identity: &SessionIdentity) -> Unit Err! {
        ids: [String:Bool] := [:]
        nodes: U64 := 0
        self.validate_inner(.Val(identity), 1, &ids, &nodes)
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:566
    fn validate_inner(self: &Self, identity: &SessionIdentity?, depth: U32, ids: &[String:Bool], nodes: &U64) -> Unit Err! {
        if depth > MAX_VALUE_DEPTH -> return .Err("paused value exceeds the maximum projection depth")
        nodes = nodes.saturating_add(1)
        if nodes > MAX_VALUE_NODES -> return .Err("paused value exceeds the maximum projection node count")
        valid_id(self.id, "value id")?
        valid_text(self.name, "value name", 256)?
        valid_id(self.type_name, "value type")?
        self.source.validate()?
        if ids.insert(~self.id, true).is_some() -> return .Err("paused value ids must be unique within a projection")
        if identity == .Val(identity) {
            if !identity.source_matches(&self.source) -> return .Err("paused value source identity does not match the session")
        }
        if self.publication == {
            .Published -> {
                value :: self.value.as_ref() ?? return .Err("published value is missing its typed payload")
                value.validate()?
                if !value.is_aggregate() && !self.children.is_empty() -> return .Err("only aggregate values may carry projected children")
            }
            .Redacted | .Absent -> {
                if self.value.is_some() || !self.children.is_empty() -> return .Err("redacted or absent values cannot carry a payload")
            }
        }
        for child in self.children -> child.validate_inner(identity, depth.saturating_add(1), ids, nodes)?
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:615
    fn metadata_bytes(self: &Self) -> U64 {
        self.id.len().saturating_add(self.name.len()).saturating_add(self.type_name.len())
            .saturating_add(self.source.source_id.len()).saturating_add(self.source.source_revision.len()).saturating_add(48) as U64
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:625
    fn measure_inner(self: &Self, depth: U32, usage: &EvaluationUsage) -> Unit {
        if self.publication == .Absent -> return
        usage.depth = usage.depth.max(depth)
        usage.nodes = usage.nodes.saturating_add(1)
        usage.bytes = usage.bytes.saturating_add(self.metadata_bytes()).saturating_add(self.value.as_ref().map_or(0, (value) -> value.bytes()))
        for child in self.children -> child.measure_inner(depth.saturating_add(1), usage)
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:640
    fn measure(self: &Self) -> EvaluationUsage { usage := EvaluationUsage.default(); self.measure_inner(1, &usage); usage }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:646
    fn json(self: &Self) -> String? {
        if self.publication == .Absent -> return .None
        value :: self.value.as_ref().map((value) -> ",\"value\":{value.json()}").unwrap_or("")
        children :: array_json(self.children.iter().filter_map((child) -> child.json()))
        .Val("{{\"id\":\"{json_escape(self.id)}\",\"name\":\"{json_escape(self.name)}\",\"type\":\"{json_escape(self.type_name)}\",\"source\":{self.source.json()},\"publication\":\"{self.publication.as_str()}\"{value} ,\"children\":{children},\"truncated\":{self.truncated}}}")
    }
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:672
pub struct LexicalScope { pub id: String; pub name: String; pub parent_id: String?; pub source: SourceLocation; pub bindings: [ValueProjection] }
impl LexicalScope {
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:681
    pub fn new(id: String, name: String, parent_id: String?, source: SourceLocation, bindings: [ValueProjection]) -> Self Err! {
        scope :: Self { id: ^id, name: ^name, parent_id: ^parent_id, source: ^source, bindings: ^bindings }
        scope.validate(.None)?
