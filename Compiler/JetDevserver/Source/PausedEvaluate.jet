            .Text(value) -> valid_text(value, "typed text", MAX_VALUE_BYTES as USize)
            .Bytes { sha256, .. } -> {
                if sha256.len() != 64 || !sha256.bytes().all((byte) -> byte.is_ascii_hexdigit()) -> return .Err("typed bytes must carry a 64-character SHA-256 digest")
            }
            .Unit | .Bool(_) | .Int(_) | .FloatBits(_) | .Aggregate { .. } -> {}
        }
    }
