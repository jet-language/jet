// Rust: crates/jet-devserver/src/PausedEvaluate.rs:1452
pub fn inspect(session: &PausedSession, request: &InspectRequest) -> InspectResponse RequestError! {
    authority :: inspect_authority(request)
    _ :: validate_common(session, &request.identity, request.request_id, request.scope_id, &request.budget, &request.cancellation, &authority) ?? return .Err(reject(
        "paused.inspect", request.request_id, &request.identity, request.scope_id, &authority, err, EvaluationUsage.default()))
    scope :: session.scope(request.scope_id) ?? return .Err(reject("paused.inspect", request.request_id, &request.identity, request.scope_id, &authority, .ScopeNotFound, EvaluationUsage.default()))
    if request.value_id == .Val(value_id) {
        binding :: scope.bindings.iter().find((binding) -> binding.id == value_id) ?? return .Err(reject("paused.inspect", request.request_id, &request.identity, request.scope_id, &authority, .ValueNotFound, EvaluationUsage.default()))
        if binding.publication == .Absent -> return .Err(reject("paused.inspect", request.request_id, &request.identity, request.scope_id, &authority, .ValueNotPublished, EvaluationUsage.default()))
    }
    (projection, stats) :: ScopeProjection.project(scope, &session.identity, request.budget, request.value_id) ?? return .Err(reject(
        "paused.inspect", request.request_id, &request.identity, request.scope_id, &authority, .InvalidEvaluatorResult, EvaluationUsage.default()))
    audit :: AuditReceipt.new("paused.inspect", request.request_id, &request.identity, request.scope_id, &authority, .Accepted, .None, stats.usage, stats.truncated, stats.published, stats.redacted, .None)
    InspectResponse { identity: ~request.identity, scope: ^projection, selected_value_id: ~request.value_id, truncated: stats.truncated, audit: ^audit }
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:1557
pub fn evaluate(session: &PausedSession, request: &EvaluateRequest, result: EvaluatorResult) -> EvaluateResponse RequestError! {
    authority :: evaluate_authority(request)
    _ :: validate_common(session, &request.identity, request.request_id, request.scope_id, &request.budget, &request.cancellation, &authority) ?? return .Err(reject(
        "paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, err, result.usage))
    if result.identity != request.identity || result.scope_id != request.scope_id -> return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .InvalidEvaluatorResult, result.usage))
    invalid_result_shape :: if result.status == {
        .Completed -> result.error.is_some()
        .Failed -> result.value.is_some() || result.changed || result.observation.is_some() || result.error.as_ref().is_none_or((message) -> message.is_empty() || valid_text(message, "evaluator error", 4 * 1024).is_err())
        .Cancelled -> result.value.is_some() || result.changed || result.observation.is_some() || result.error.is_some()
    }
    if invalid_result_shape -> return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .InvalidEvaluatorResult, result.usage))
    if result.status == .Failed -> return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .EvaluatorFailed, result.usage))
    if result.status == .Cancelled -> return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .Cancelled, result.usage))
    if !request.budget.fits(result.usage) -> return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .BudgetExceeded, result.usage))
    if result.changed || result.observation.is_some() {
        if request.mode != .Mutate -> return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .MutationNotAllowed, result.usage))
        if result.changed && result.observation.is_none() -> return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .ObservationMissing, result.usage))
        if !result.changed && result.observation.is_some() -> return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .InvalidEvaluatorResult, result.usage))
    }
    if result.observation.as_ref() == .Val(observation) {
        if !observation.matches(session, request) -> return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .InvalidEvaluatorResult, result.usage))
    }
    stats := ProjectionStats.default()
    value: ValueProjection? := .None
    if result.value.as_ref() == .Val(supplied) {
        _ :: supplied.validate_for_session(&session.identity) ?? return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .InvalidEvaluatorResult, result.usage))
        if supplied.publication != .Absent {
            if supplied.publication == .Published -> stats.published = 1 else -> stats.redacted = 1
            projected :: project_root(supplied, &session.identity, request.budget, &stats) ?? return .Err(reject("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .InvalidEvaluatorResult, result.usage))
            value = .Val(^projected)
        }
    }
    observation_id :: result.observation.as_ref().map((observation) -> observation.event_id)
    audit :: AuditReceipt.new("paused.evaluate", request.request_id, &request.identity, request.scope_id, &authority, .Accepted, .None, result.usage, stats.truncated, stats.published, stats.redacted, observation_id)
    EvaluateResponse { identity: ~request.identity, scope_id: ~request.scope_id, expression_hash: "sha256-{sha256_hex(request.expression.as_bytes())}", mode: request.mode,
        value: ^value, changed: result.changed, observation: ^result.observation, truncated: stats.truncated, audit: ^audit }
}
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:1777
#Error
pub enum PausedEvaluateHostError { SessionUnavailable; EvaluatorUnavailable; InvalidRequest(String); Rejected(RequestError) }
// Rust: crates/jet-devserver/src/PausedEvaluate.rs:1791
// PausedEvaluateHostError's bounded JSON error projection continues in PausedEvaluate02.
