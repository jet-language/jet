        parent_id :: self.parent_id.as_ref().map((id) -> "\"{foundation_json_escape(id)}\"").unwrap_or("null")
        "{{\"id\":\"{foundation_json_escape(self.id)}\",\"name\":\"{foundation_json_escape(self.name)}\",\"parent_id\":{parent_id},\"source\":{self.source.json()},\"bindings\":{bindings}}}"
    }
}
