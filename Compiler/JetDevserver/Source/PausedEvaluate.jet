    fn validate_inner(self: &Self, identity: &SessionIdentity?, depth: U32, ids: &[String:Bool], nodes: &U64) Err! {
        if depth > MAX_VALUE_DEPTH -> return .Err("paused value exceeds the maximum projection depth")
