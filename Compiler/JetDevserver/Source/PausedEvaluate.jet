            .Bytes { .. } -> 32
            .Aggregate { .. } -> 8
        }
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:171
    fn is_aggregate(self: Self) -> Bool { if self == {
        .Aggregate { .. } -> true
        else -> false
    } }
}
