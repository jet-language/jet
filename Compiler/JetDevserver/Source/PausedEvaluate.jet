        children :: array_json(self.children.iter().filter_map((child) -> child.json()))
        .Val("{{\"id\":\"{foundation_json_escape(self.id)}\",\"name\":\"{foundation_json_escape(self.name)}\",\"type\":\"{foundation_json_escape(self.type_name)}\",\"source\":{self.source.json()},\"publication\":\"{self.publication.as_str()}\"{value} ,\"children\":{children},\"truncated\":{self.truncated}}}")
    }
}
