// Typed paused-session inspection/evaluation adapter. It never executes an
// expression, closure, process or host command: real evaluators inject
// checked results, then this boundary checks identity, authority and budgets.
use {
    paused_json: core.encoding.json
    jet_foundation.[foundation_json_escape, foundation_json_integer, sha256_hex]
}

PAUSED_EVALUATE_PROTOCOL: "jet.devtools.v1"
PAUSED_EVALUATE_SCHEMA_VERSION: 1
INSPECT_AUTHORITY: "devtools.inspect"
EVALUATE_AUTHORITY: "devtools.evaluate"
MUTATE_AUTHORITY: "devtools.mutate"
MAX_REQUEST_BYTES: 65536
MAX_EXPRESSION_BYTES: 16384
MAX_SCOPES: 256
MAX_VALUE_DEPTH: 64
MAX_VALUE_NODES: 4096
MAX_VALUE_BYTES: 1048576
MAX_EVALUATION_STEPS: 1000000

// A paused-boundary contract violation, in words the client is shown.
#Error
PausedEvaluateError: struct { message: String }

paused_error: fn(message: String) -> PausedEvaluateError Never! {
    PausedEvaluateError{message: message}
}

SessionState: enum {
    Running
    Paused
    Finished
    Stale
    Cancelled

    as_str: fn(self) -> String Never! {
        if self == {
            .Running -> "running"
            .Paused -> "paused"
            .Finished -> "finished"
            .Stale -> "stale"
            .Cancelled -> "cancelled"
        }
    }
}

EvaluationMode: enum {
    ReadOnly
    Mutate

    as_str: fn(self) -> String Never! {
        if self == {
            .ReadOnly -> "read_only"
            .Mutate -> "mutate"
        }
    }
}

Publication: enum {
    Published
    Redacted
    Absent

    as_str: fn(self) -> String Never! {
        if self == {
            .Published -> "published"
            .Redacted -> "redacted"
            .Absent -> "absent"
        }
    }
}

AggregateKind: enum {
    Record
    List
    Map
    Set
    Tuple
    Variant

    as_str: fn(self) -> String Never! {
        if self == {
            .Record -> "record"
            .List -> "list"
            .Map -> "map"
            .Set -> "set"
            .Tuple -> "tuple"
            .Variant -> "variant"
        }
    }
}

// FloatBits is the exact IEEE-754 bit pattern; Bytes are length plus SHA-256.
TypedValue: enum {
    Unit
    Bool(value: Bool)
    Int(value: Int)
    FloatBits(bits: Int)
    Text(text: String)
    Bytes(length: Int, sha256: String)
    Aggregate(kind: AggregateKind, length: Int)

    validate: fn(self) PausedEvaluateError! {
        if self == {
            .Text(text) -> valid_text(text, "typed text", MAX_VALUE_BYTES)
            .Bytes(_, sha256) -> {
                if sha256.len() != 64 || !paused_is_hex(sha256) -> return Err(paused_error("typed bytes must carry a 64-character SHA-256 digest"))
            }
            else -> {}
        }
        Ok()
    }

    json: fn(self) -> String Never! {
        if self == {
            .Unit -> "{{\"kind\":\"unit\"}}"
            .Bool(value) -> "{{\"kind\":\"bool\",\"value\":{value}}}"
            .Int(value) -> "{{\"kind\":\"int\",\"value\":{value}}}"
            .FloatBits(bits) -> "{{\"kind\":\"float_bits\",\"bits\":{bits}}}"
            .Text(text) -> "{{\"kind\":\"text\",\"value\":\"{foundation_json_escape(text)}\"}}"
            .Bytes(length, sha256) -> "{{\"kind\":\"bytes\",\"length\":{length},\"sha256\":\"{foundation_json_escape(sha256)}\"}}"
            .Aggregate(kind, length) -> "{{\"kind\":\"{kind.as_str()}\",\"length\":{length}}}"
        }
    }

    bytes: fn(self) -> Int Never! {
        if self == {
            .Unit -> 1
            .Bool(_) -> 1
            .Text(text) -> text.len()
            .Bytes(_, _) -> 32
            else -> 8
        }
    }

    is_aggregate: fn(self) -> Bool Never! {
        if self == {
            .Aggregate(_, _) -> true
            else -> false
        }
    }
}

SourceLocation: struct {
    source_id: String
    source_revision: String
    start: Int
    end: Int

    new: fn(source_id: String, source_revision: String, start: Int, end: Int) -> SourceLocation PausedEvaluateError! {
        location: SourceLocation{source_id: source_id, source_revision: source_revision, start: start, end: end}
        location.validate()
        Ok(location)
    }

    validate: fn(self) PausedEvaluateError! {
        valid_id(self.source_id, "source id")
        valid_id(self.source_revision, "source revision")
        if self.start < 0 || self.end < self.start -> return Err(paused_error("source location ends before it starts"))
        Ok()
    }

    json: fn(self) -> String Never! {
        "{{\"source_id\":\"{foundation_json_escape(self.source_id)}\",\"source_revision\":\"{foundation_json_escape(self.source_revision)}\",\"start\":{self.start},\"end\":{self.end}}}"
    }
}

SessionIdentity: struct {
    session_id: String
    source_id: String
    source_revision: String
    pause_id: String
    frame_id: String

    new: fn(session_id: String, source_id: String, source_revision: String, pause_id: String, frame_id: String) -> SessionIdentity PausedEvaluateError! {
        identity: SessionIdentity{session_id: session_id, source_id: source_id, source_revision: source_revision, pause_id: pause_id, frame_id: frame_id}
        identity.validate()
        Ok(identity)
    }

    validate: fn(self) PausedEvaluateError! {
        valid_id(self.session_id, "session id")
        valid_id(self.source_id, "source id")
        valid_id(self.source_revision, "source revision")
        valid_id(self.pause_id, "pause id")
        valid_id(self.frame_id, "frame id")
        Ok()
    }

    source_matches: fn(self, location: SourceLocation) -> Bool Never! {
        self.source_id == location.source_id && self.source_revision == location.source_revision
    }

    json: fn(self) -> String Never! {
        "{{\"session_id\":\"{foundation_json_escape(self.session_id)}\",\"source_id\":\"{foundation_json_escape(self.source_id)}\",\"source_revision\":\"{foundation_json_escape(self.source_revision)}\",\"pause_id\":\"{foundation_json_escape(self.pause_id)}\",\"frame_id\":\"{foundation_json_escape(self.frame_id)}\"}}"
    }
}

// One capability a request needs in one lexical scope.
AuthorityRequirement: struct {
    capability: String
    scope_id: String

    new: fn(capability: String, scope_id: String) -> AuthorityRequirement PausedEvaluateError! {
        requirement: AuthorityRequirement{capability: capability, scope_id: scope_id}
        requirement.validate()
        Ok(requirement)
    }

    validate: fn(self) PausedEvaluateError! {
        valid_id(self.capability, "authority capability")
        valid_id(self.scope_id, "authority scope")
        Ok()
    }

    key: fn(self) -> String Never! { "{self.capability}@{self.scope_id}" }

    json: fn(self) -> String Never! {
        "{{\"capability\":\"{foundation_json_escape(self.capability)}\",\"scope_id\":\"{foundation_json_escape(self.scope_id)}\"}}"
    }
}

// One capability a session grants in one lexical scope.
AuthorityGrant: struct {
    capability: String
    scope_id: String

    new: fn(capability: String, scope_id: String) -> AuthorityGrant PausedEvaluateError! {
        grant: AuthorityGrant{capability: capability, scope_id: scope_id}
        valid_id(grant.capability, "authority capability")
        valid_id(grant.scope_id, "authority scope")
        Ok(grant)
    }
}

AuthoritySet: struct {
    grants: [AuthorityGrant]

    // The grants in canonical `capability@scope` order, each once.
    new: fn(grants: [AuthorityGrant]) -> AuthoritySet Never! {
        keys := [String]{}
        loop grant in grants -> keys.push("{grant.capability}@{grant.scope_id}")
        order := [Int]{}
        loop index in 0..<grants.len() -> order.push(index)
        order_keys: keys.copy()
        order.sort_by(fn(a: Int, b: Int) { order_keys[a] <=> order_keys[b] })
        kept := [AuthorityGrant]{}
        last := ""
        loop index in order {
            if kept.len() > 0 && keys[index] == last -> next
            last = keys[index]
            kept.push(grants[index])
        }
        AuthoritySet{grants: kept}
    }

    allows: fn(self, requirement: AuthorityRequirement) -> Bool Never! {
        loop grant in self.grants {
            if grant.capability == requirement.capability && grant.scope_id == requirement.scope_id -> return true
        }
        false
    }

    validate: fn(self) PausedEvaluateError! {
        loop grant in self.grants {
            valid_id(grant.capability, "authority capability")
            valid_id(grant.scope_id, "authority scope")
        }
        Ok()
    }
}

// The requirements in canonical `capability@scope` order, each once.
authority_requirements_canonical: fn(requirements: [AuthorityRequirement]) -> [AuthorityRequirement] Never! {
    order := [Int]{}
    loop index in 0..<requirements.len() -> order.push(index)
    order_keys := [String]{}
    loop requirement in requirements -> order_keys.push(requirement.key())
    order.sort_by(fn(a: Int, b: Int) { order_keys[a] <=> order_keys[b] })
    kept := [AuthorityRequirement]{}
    last := ""
    loop index in order {
        key: requirements[index].key()
        if kept.len() > 0 && key == last -> next
        last = key
        kept.push(requirements[index])
    }
    kept
}

EvaluationBudget: struct {
    max_depth: Int
    max_nodes: Int
    max_bytes: Int
    max_steps: Int

    new: fn(max_depth: Int, max_nodes: Int, max_bytes: Int, max_steps: Int) -> EvaluationBudget PausedEvaluateError! {
        budget: EvaluationBudget{max_depth: max_depth, max_nodes: max_nodes, max_bytes: max_bytes, max_steps: max_steps}
        budget.validate()
        Ok(budget)
    }

    validate: fn(self) PausedEvaluateError! {
        if self.max_depth <= 0 || self.max_depth > MAX_VALUE_DEPTH || self.max_nodes <= 0 || self.max_nodes > MAX_VALUE_NODES
            || self.max_bytes <= 0 || self.max_bytes > MAX_VALUE_BYTES || self.max_steps <= 0 || self.max_steps > MAX_EVALUATION_STEPS {
            return Err(paused_error("paused evaluation budget is outside its bounded range"))
        }
        Ok()
    }

    contains: fn(self, other: EvaluationBudget) -> Bool Never! {
        other.max_depth <= self.max_depth && other.max_nodes <= self.max_nodes && other.max_bytes <= self.max_bytes && other.max_steps <= self.max_steps
    }

    fits: fn(self, usage: EvaluationUsage) -> Bool Never! {
        usage.depth <= self.max_depth && usage.nodes <= self.max_nodes && usage.bytes <= self.max_bytes && usage.steps <= self.max_steps
    }

    json: fn(self) -> String Never! {
        "{{\"max_depth\":{self.max_depth},\"max_nodes\":{self.max_nodes},\"max_bytes\":{self.max_bytes},\"max_steps\":{self.max_steps}}}"
    }
}

DEFAULT_EVALUATION_BUDGET: EvaluationBudget{max_depth: 32, max_nodes: 1024, max_bytes: 262144, max_steps: 100000}

EvaluationUsage: struct {
    depth: Int
    nodes: Int
    bytes: Int
    steps: Int

    json: fn(self) -> String Never! {
        "{{\"depth\":{self.depth},\"nodes\":{self.nodes},\"bytes\":{self.bytes},\"steps\":{self.steps}}}"
    }
}

evaluation_usage_zero: fn() -> EvaluationUsage Never! {
    EvaluationUsage{depth: 0, nodes: 0, bytes: 0, steps: 0}
}

Cancellation: struct {
    requested: Bool
    reason: String?

    validate: fn(self) PausedEvaluateError! {
        if self.reason == .Val(reason) -> valid_text(reason, "cancellation reason", 256)
        if !self.requested && self.reason != None -> return Err(paused_error("a non-requested cancellation cannot carry a reason"))
        Ok()
    }
}

cancellation_none: fn() -> Cancellation Never! {
    Cancellation{requested: false, reason: None}
}

cancellation_requested: fn(reason: String) -> Cancellation PausedEvaluateError! {
    valid_text(reason, "cancellation reason", 256)
    Ok(Cancellation{requested: true, reason: Val(reason)})
}

ValueProjection: struct {
    id: String
    name: String
    type_name: String
    source: SourceLocation
    publication: Publication
    value: TypedValue?
    children: [ValueProjection]
    truncated: Bool

    validate: fn(self) PausedEvaluateError! {
        ids := [String:Bool]{}
        nodes := 0
        validate_projection(self, None, 1, ids, nodes)
    }

    validate_for_session: fn(self, identity: SessionIdentity) PausedEvaluateError! {
        ids := [String:Bool]{}
        nodes := 0
        validate_projection(self, Val(identity), 1, ids, nodes)
    }

    metadata_bytes: fn(self) -> Int Never! {
        self.id.len() + self.name.len() + self.type_name.len() + self.source.source_id.len() + self.source.source_revision.len() + 48
    }

    measure: fn(self) -> EvaluationUsage Never! {
        usage := evaluation_usage_zero()
        measure_projection(self, 1, usage)
        usage
    }

    json: fn(self) -> String? Never! {
        if self.publication == .Absent -> return None
        value: if self.value == {
            .Val(typed) -> ",\"value\":{typed.json()}"
            else -> ""
        }
        children := [String]{}
        loop child in self.children {
            if child.json() == .Val(text) -> children.push(text)
        }
        Val("{{\"id\":\"{foundation_json_escape(self.id)}\",\"name\":\"{foundation_json_escape(self.name)}\",\"type\":\"{foundation_json_escape(self.type_name)}\",\"source\":{self.source.json()},\"publication\":\"{self.publication.as_str()}\"{value},\"children\":{array_json(children)},\"truncated\":{self.truncated}}}")
    }
}

value_projection: fn(id: String, name: String, type_name: String, source: SourceLocation, publication: Publication, value: TypedValue?) -> ValueProjection Never! {
    ValueProjection{id: id, name: name, type_name: type_name, source: source, publication: publication, value: value, children: [ValueProjection]{}, truncated: false}
}

value_projection_published: fn(id: String, name: String, type_name: String, source: SourceLocation, value: TypedValue) -> ValueProjection Never! {
    value_projection(id, name, type_name, source, Publication.Published, Val(value))
}

value_projection_redacted: fn(id: String, name: String, type_name: String, source: SourceLocation) -> ValueProjection Never! {
    value_projection(id, name, type_name, source, Publication.Redacted, None)
}

value_projection_absent: fn(id: String, name: String, type_name: String, source: SourceLocation) -> ValueProjection Never! {
    value_projection(id, name, type_name, source, Publication.Absent, None)
}

validate_projection: fn(value: ValueProjection, identity: SessionIdentity?, depth: Int, ids: &[String:Bool], nodes: &Int) PausedEvaluateError! {
    if depth > MAX_VALUE_DEPTH -> return Err(paused_error("paused value exceeds the maximum projection depth"))
    nodes += 1
    if nodes > MAX_VALUE_NODES -> return Err(paused_error("paused value exceeds the maximum projection node count"))
    valid_id(value.id, "value id")
    valid_text(value.name, "value name", 256)
    valid_id(value.type_name, "value type")
    value.source.validate()
    if ids.get(value.id) != None -> return Err(paused_error("paused value ids must be unique within a projection"))
    ids[value.id] = true
    if identity == .Val(session) {
        if !session.source_matches(value.source) -> return Err(paused_error("paused value source identity does not match the session"))
    }
    if {
        value.publication == .Published -> {
            typed: value.value ?? return Err(paused_error("published value is missing its typed payload"))
            typed.validate()
            if !typed.is_aggregate() && value.children.len() > 0 -> return Err(paused_error("only aggregate values may carry projected children"))
        }
        value.value != None || value.children.len() > 0 -> return Err(paused_error("redacted or absent values cannot carry a payload"))
        else -> {}
    }
    loop child in value.children -> validate_projection(child, identity, depth + 1, ids, nodes)
    Ok()
}

measure_projection: fn(value: ValueProjection, depth: Int, usage: &EvaluationUsage) Never! {
    if value.publication == .Absent -> return
    if depth > usage.depth -> usage.depth = depth
    usage.nodes += 1
    payload: if value.value == {
        .Val(typed) -> typed.bytes()
        else -> 0
    }
    usage.bytes += value.metadata_bytes() + payload
    loop child in value.children -> measure_projection(child, depth + 1, usage)
}

LexicalScope: struct {
    id: String
    name: String
    parent_id: String?
    source: SourceLocation
    bindings: [ValueProjection]

    new: fn(id: String, name: String, parent_id: String?, source: SourceLocation, bindings: [ValueProjection]) -> LexicalScope PausedEvaluateError! {
        scope: LexicalScope{id: id, name: name, parent_id: parent_id, source: source, bindings: bindings}
        scope.validate(None)
        Ok(scope)
    }

    validate: fn(self, identity: SessionIdentity?) PausedEvaluateError! {
        valid_id(self.id, "scope id")
        valid_text(self.name, "scope name", 256)
        if self.parent_id == .Val(parent) -> valid_id(parent, "parent scope id")
        self.source.validate()
        if identity == .Val(session) {
            if !session.source_matches(self.source) -> return Err(paused_error("lexical scope source identity does not match the session"))
        }
        ids := [String:Bool]{}
        nodes := 0
        loop binding in self.bindings -> validate_projection(binding, identity, 1, ids, nodes)
        Ok()
    }
}

ScopeProjection: struct {
    id: String
    name: String
    parent_id: String?
    source: SourceLocation
    bindings: [ValueProjection]

    json: fn(self) -> String Never! {
        bindings := [String]{}
        loop binding in self.bindings {
            if binding.json() == .Val(text) -> bindings.push(text)
        }
        parent_id: if self.parent_id == {
            .Val(id) -> "\"{foundation_json_escape(id)}\""
            else -> "null"
        }
        "{{\"id\":\"{foundation_json_escape(self.id)}\",\"name\":\"{foundation_json_escape(self.name)}\",\"parent_id\":{parent_id},\"source\":{self.source.json()},\"bindings\":{array_json(bindings)}}}"
    }
}

ProjectionStats: struct {
    usage: EvaluationUsage
    truncated: Bool
    published: Int
    redacted: Int
}

projection_stats_zero: fn() -> ProjectionStats Never! {
    ProjectionStats{usage: evaluation_usage_zero(), truncated: false, published: 0, redacted: 0}
}

// One projected scope plus the accounting its projection spent.
ScopeProjectionResult: struct {
    scope: ScopeProjection
    stats: ProjectionStats
}

// The visible bindings of `scope` (only `selected_value` when given), ordered
// by name then id, each projected under `budget`.
project_scope: fn(scope: LexicalScope, identity: SessionIdentity, budget: EvaluationBudget, selected_value: String?) -> ScopeProjectionResult PausedEvaluateError! {
    stats := projection_stats_zero()
    visible := [ValueProjection]{}
    loop binding in scope.bindings {
        if binding.publication == .Absent -> next
        if selected_value == .Val(id) {
            if id != binding.id -> next
        }
        visible.push(binding)
    }
    order := [Int]{}
    loop index in 0..<visible.len() -> order.push(index)
    ordered: visible.copy()
    order.sort_by(fn(a: Int, b: Int) { if ordered[a].name != ordered[b].name -> ordered[a].name <=> ordered[b].name else -> ordered[a].id <=> ordered[b].id })
    projected := [ValueProjection]{}
    loop index in order {
        binding: visible[index]
        if binding.publication == .Published -> stats.published += 1 else -> stats.redacted += 1
        value: project_root(binding, identity, budget, stats)
        projected.push(value)
    }
    Ok(ScopeProjectionResult{
        scope: ScopeProjection{id: scope.id, name: scope.name, parent_id: scope.parent_id, source: scope.source, bindings: projected},
        stats: stats,
    })
}

PausedSession: struct {
    identity: SessionIdentity
    state: SessionState
    scopes: [LexicalScope]
    authority: AuthoritySet
    budget: EvaluationBudget
    cancellation: Cancellation

    cancel: fn(&self, reason: String) PausedEvaluateError! {
        self.cancellation = cancellation_requested(reason)
        self.state = .Cancelled
        Ok()
    }

    scope: fn(self, id: String) -> LexicalScope? Never! {
        loop scope in self.scopes {
            if scope.id == id -> return Val(scope)
        }
        None
    }
}

paused_session: fn(identity: SessionIdentity, state: SessionState, scopes: [LexicalScope], authority: AuthoritySet, budget: EvaluationBudget) -> PausedSession PausedEvaluateError! {
    identity.validate()
    budget.validate()
    authority.validate()
    if scopes.len() > MAX_SCOPES -> return Err(paused_error("paused session exceeds the lexical scope limit"))
    ids := [String:Bool]{}
    loop scope in scopes {
        scope.validate(Val(identity))
        if ids.get(scope.id) != None -> return Err(paused_error("paused session scope ids must be unique"))
        ids[scope.id] = true
    }
    loop scope in scopes {
        if scope.parent_id == .Val(parent) {
            if ids.get(parent) == None -> return Err(paused_error("paused lexical scope refers to a missing parent"))
        }
    }
    Ok(PausedSession{identity: identity, state: state, scopes: scopes, authority: authority, budget: budget, cancellation: cancellation_none()})
}

InspectRequest: struct {
    request_id: String
    identity: SessionIdentity
    scope_id: String
    value_id: String?
    budget: EvaluationBudget
    authority: [AuthorityRequirement]
    cancellation: Cancellation

    validate_shape: fn(self) PausedEvaluateError! {
        valid_id(self.request_id, "request id")
        self.identity.validate()
        valid_id(self.scope_id, "scope id")
        if self.value_id == .Val(value_id) -> valid_id(value_id, "value id")
        self.budget.validate()
        self.cancellation.validate()
        loop requirement in self.authority -> requirement.validate()
        Ok()
    }

    json: fn(self) -> String Never! {
        value_id: if self.value_id == {
            .Val(id) -> "\"{foundation_json_escape(id)}\""
            else -> "null"
        }
        "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"kind\":\"paused.inspect\",\"request_id\":\"{foundation_json_escape(self.request_id)}\",\"identity\":{self.identity.json()},\"scope_id\":\"{foundation_json_escape(self.scope_id)}\",\"value_id\":{value_id},\"budget\":{self.budget.json()},\"authority\":{requirements_json(self.authority)},\"cancelled\":{self.cancellation.requested}}}"
    }
}

EvaluateRequest: struct {
    request_id: String
    identity: SessionIdentity
    scope_id: String
    expression: String
    mode: EvaluationMode
    effects: [String]
    authority: [AuthorityRequirement]
    budget: EvaluationBudget
    cancellation: Cancellation

    validate_shape: fn(self) PausedEvaluateError! {
        valid_id(self.request_id, "request id")
        self.identity.validate()
        valid_id(self.scope_id, "scope id")
        valid_text(self.expression, "evaluation expression", MAX_EXPRESSION_BYTES)
        if self.mode == .Mutate && self.effects.len() == 0 -> return Err(paused_error("mutating evaluation requires at least one checked effect"))
        loop effect_ref in self.effects -> valid_id(effect_ref, "evaluation effect")
        self.budget.validate()
        self.cancellation.validate()
        loop requirement in self.authority -> requirement.validate()
        Ok()
    }

    json: fn(self) -> String Never! {
        effects := [String]{}
        loop effect_ref in self.effects -> effects.push("\"{foundation_json_escape(effect_ref)}\"")
        "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"kind\":\"paused.evaluate\",\"request_id\":\"{foundation_json_escape(self.request_id)}\",\"identity\":{self.identity.json()},\"scope_id\":\"{foundation_json_escape(self.scope_id)}\",\"expression\":\"{foundation_json_escape(self.expression)}\",\"mode\":\"{self.mode.as_str()}\",\"effects\":{array_json(effects)},\"authority\":{requirements_json(self.authority)},\"budget\":{self.budget.json()},\"cancelled\":{self.cancellation.requested}}}"
    }
}

EvaluatorStatus: enum {
    Completed
    Failed
    Cancelled
}

ObservationFact: struct {
    event_id: String
    kind: String
    session_id: String
    source_id: String
    source_revision: String
    scope_id: String
    target_id: String
    effect_ref: String

    validate_shape: fn(self) PausedEvaluateError! {
        valid_id(self.event_id, "observation id")
        valid_id(self.kind, "observation kind")
        valid_id(self.session_id, "observation session id")
        valid_id(self.source_id, "observation source id")
        valid_id(self.source_revision, "observation source revision")
        valid_id(self.scope_id, "observation scope id")
        valid_id(self.target_id, "observation target id")
        valid_id(self.effect_ref, "observation effect")
        Ok()
    }

    matches: fn(self, session: PausedSession, request: EvaluateRequest) -> Bool Never! {
        if self.session_id != session.identity.session_id || self.source_id != session.identity.source_id -> return false
        if self.source_revision != session.identity.source_revision || self.scope_id != request.scope_id -> return false
        request.effects.contains(self.effect_ref)
    }

    json: fn(self) -> String Never! {
        "{{\"event_id\":\"{foundation_json_escape(self.event_id)}\",\"kind\":\"{foundation_json_escape(self.kind)}\",\"session_id\":\"{foundation_json_escape(self.session_id)}\",\"source_id\":\"{foundation_json_escape(self.source_id)}\",\"source_revision\":\"{foundation_json_escape(self.source_revision)}\",\"scope_id\":\"{foundation_json_escape(self.scope_id)}\",\"target_id\":\"{foundation_json_escape(self.target_id)}\",\"effect\":\"{foundation_json_escape(self.effect_ref)}\"}}"
    }
}

EvaluatorResult: struct {
    identity: SessionIdentity
    scope_id: String
    status: EvaluatorStatus
    value: ValueProjection?
    usage: EvaluationUsage
    changed: Bool
    observation: ObservationFact?
    error: String?
}

evaluator_completed: fn(identity: SessionIdentity, scope_id: String, value: ValueProjection?, usage: EvaluationUsage) -> EvaluatorResult Never! {
    EvaluatorResult{identity: identity, scope_id: scope_id, status: .Completed, value: value, usage: usage, changed: false, observation: None, error: None}
}

evaluator_failed: fn(identity: SessionIdentity, scope_id: String, message: String, usage: EvaluationUsage) -> EvaluatorResult Never! {
    EvaluatorResult{identity: identity, scope_id: scope_id, status: .Failed, value: None, usage: usage, changed: false, observation: None, error: Val(message)}
}

evaluator_cancelled: fn(identity: SessionIdentity, scope_id: String, usage: EvaluationUsage) -> EvaluatorResult Never! {
    EvaluatorResult{identity: identity, scope_id: scope_id, status: .Cancelled, value: None, usage: usage, changed: false, observation: None, error: None}
}

AuditOutcome: enum {
    Accepted
    Rejected

    as_str: fn(self) -> String Never! {
        if self == {
            .Accepted -> "accepted"
            .Rejected -> "rejected"
        }
    }
}

#Error
RejectReason: enum {
    InvalidRequest
    SessionNotPaused
    StaleSession
    SessionIdentityMismatch
    SourceIdentityMismatch
    PauseIdentityMismatch
    FrameIdentityMismatch
    ScopeNotFound
    ValueNotFound
    ValueNotPublished
    InsufficientAuthority
    BudgetExceeded
    Cancelled
    EvaluatorFailed
    MutationNotAllowed
    ObservationMissing
    InvalidEvaluatorResult

    as_str: fn(self) -> String Never! {
        if self == {
            .InvalidRequest -> "invalid_request"
            .SessionNotPaused -> "session_not_paused"
            .StaleSession -> "stale_session"
            .SessionIdentityMismatch -> "session_identity_mismatch"
            .SourceIdentityMismatch -> "source_identity_mismatch"
            .PauseIdentityMismatch -> "pause_identity_mismatch"
            .FrameIdentityMismatch -> "frame_identity_mismatch"
            .ScopeNotFound -> "scope_not_found"
            .ValueNotFound -> "value_not_found"
            .ValueNotPublished -> "value_not_published"
            .InsufficientAuthority -> "insufficient_authority"
            .BudgetExceeded -> "budget_exceeded"
            .Cancelled -> "cancelled"
            .EvaluatorFailed -> "evaluator_failed"
            .MutationNotAllowed -> "mutation_not_allowed"
            .ObservationMissing -> "observation_missing"
            .InvalidEvaluatorResult -> "invalid_evaluator_result"
        }
    }
}

AuditReceipt: struct {
    receipt_id: String
    operation: String
    request_id: String
    outcome: AuditOutcome
    reason: RejectReason?
    identity: SessionIdentity
    scope_id: String
    authority: [AuthorityRequirement]
    usage: EvaluationUsage
    truncated: Bool
    published_values: Int
    redacted_values: Int
    observation_id: String?

    json: fn(self) -> String Never! {
        reason: if self.reason == {
            .Val(why) -> "\"{why.as_str()}\""
            else -> "null"
        }
        observation_id: if self.observation_id == {
            .Val(id) -> "\"{foundation_json_escape(id)}\""
            else -> "null"
        }
        "{{\"receipt_id\":\"{foundation_json_escape(self.receipt_id)}\",\"operation\":\"{foundation_json_escape(self.operation)}\",\"request_id\":\"{foundation_json_escape(self.request_id)}\",\"outcome\":\"{self.outcome.as_str()}\",\"reason\":{reason},\"identity\":{self.identity.json()},\"scope_id\":\"{foundation_json_escape(self.scope_id)}\",\"authority\":{requirements_json(self.authority)},\"usage\":{self.usage.json()},\"truncated\":{self.truncated},\"published_values\":{self.published_values},\"redacted_values\":{self.redacted_values},\"observation_id\":{observation_id}}}"
    }
}

// The receipt id hashes the canonical `paused-audit-v1|...` material and keeps
// the first 24 SHA-256 hex characters.
audit_receipt: fn(operation: String, request_id: String, identity: SessionIdentity, scope_id: String, authority: [AuthorityRequirement], outcome: AuditOutcome, reason: RejectReason?, usage: EvaluationUsage, truncated: Bool{false}, published_values: Int, redacted_values: Int, observation_id: String?) -> AuditReceipt Never! {
    canonical_authority: authority_requirements_canonical(authority)
    keys := [String]{}
    loop requirement in canonical_authority -> keys.push(requirement.key())
    reason_text: if reason == {
        .Val(why) -> why.as_str()
        else -> ""
    }
    observation_text: observation_id ?? ""
    canonical: "paused-audit-v1|{operation}|{request_id}|{identity.session_id}|{identity.source_id}|{identity.source_revision}|{identity.pause_id}|{identity.frame_id}|{scope_id}|{outcome.as_str()}|{reason_text}|{keys.join(",")}|{usage.depth}|{usage.nodes}|{usage.bytes}|{usage.steps}|{truncated}|{published_values}|{redacted_values}|{observation_text}"
    digest: sha256_hex(canonical)
    AuditReceipt{
        receipt_id: "paused-audit-{digest.slice(0, 24)}",
        operation: operation,
        request_id: request_id,
        outcome: outcome,
        reason: reason,
        identity: identity,
        scope_id: scope_id,
        authority: canonical_authority,
        usage: usage,
        truncated: truncated,
        published_values: published_values,
        redacted_values: redacted_values,
        observation_id: observation_id,
    }
}

// A rejected paused request: why, plus the audit receipt of the rejection.
#Error
RequestError: struct {
    reason: RejectReason
    audit: AuditReceipt

    json: fn(self) -> String Never! {
        "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"ok\":false,\"error\":\"{self.reason.as_str()}\",\"audit\":{self.audit.json()}}}"
    }
}

InspectResponse: struct {
    identity: SessionIdentity
    scope: ScopeProjection
    selected_value_id: String?
    truncated: Bool
    audit: AuditReceipt

    json: fn(self) -> String Never! {
        selected_value_id: if self.selected_value_id == {
            .Val(id) -> "\"{foundation_json_escape(id)}\""
            else -> "null"
        }
        "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"ok\":true,\"kind\":\"paused.inspect\",\"identity\":{self.identity.json()},\"scope\":{self.scope.json()},\"selected_value_id\":{selected_value_id},\"truncated\":{self.truncated},\"audit\":{self.audit.json()}}}"
    }
}

EvaluateResponse: struct {
    identity: SessionIdentity
    scope_id: String
    expression_hash: String
    mode: EvaluationMode
    value: ValueProjection?
    changed: Bool
    observation: ObservationFact?
    truncated: Bool
    audit: AuditReceipt

    json: fn(self) -> String Never! {
        value: if self.value == {
            .Val(projection) -> projection.json() ?? "null"
            else -> "null"
        }
        observation: if self.observation == {
            .Val(fact) -> fact.json()
            else -> "null"
        }
        "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"ok\":true,\"kind\":\"paused.evaluate\",\"identity\":{self.identity.json()},\"scope_id\":\"{foundation_json_escape(self.scope_id)}\",\"expression_hash\":\"{foundation_json_escape(self.expression_hash)}\",\"mode\":\"{self.mode.as_str()}\",\"value\":{value},\"changed\":{self.changed},\"observation\":{observation},\"truncated\":{self.truncated},\"audit\":{self.audit.json()}}}"
    }
}

inspect: fn(session: PausedSession, request: InspectRequest) -> InspectResponse RequestError! {
    authority: inspect_authority(request)
    zero: evaluation_usage_zero()
    if validate_common(session, request.identity, request.request_id, request.scope_id, request.budget, request.cancellation, authority) == .Err(why) {
        return Err(reject("paused.inspect", request.request_id, request.identity, request.scope_id, authority, why, zero))
    }
    scope: session.scope(request.scope_id) ?? return Err(reject("paused.inspect", request.request_id, request.identity, request.scope_id, authority, .ScopeNotFound, zero))
    if request.value_id == .Val(value_id) {
        found := false
        loop binding in scope.bindings {
            if binding.id != value_id -> next
            found = true
            if binding.publication == .Absent -> return Err(reject("paused.inspect", request.request_id, request.identity, request.scope_id, authority, .ValueNotPublished, zero))
        }
        if !found -> return Err(reject("paused.inspect", request.request_id, request.identity, request.scope_id, authority, .ValueNotFound, zero))
    }
    projected: project_scope(scope, session.identity, request.budget, request.value_id) ?? return Err(reject("paused.inspect", request.request_id, request.identity, request.scope_id, authority, .InvalidEvaluatorResult, zero))
    stats: projected.stats
    audit: audit_receipt("paused.inspect", request.request_id, request.identity, request.scope_id, authority, .Accepted, None, stats.usage, stats.truncated, stats.published, stats.redacted, None)
    Ok(InspectResponse{identity: request.identity, scope: projected.scope, selected_value_id: request.value_id, truncated: stats.truncated, audit: audit})
}

evaluate: fn(session: PausedSession, request: EvaluateRequest, result: EvaluatorResult) -> EvaluateResponse RequestError! {
    authority: evaluate_authority(request)
    usage: result.usage
    if validate_common(session, request.identity, request.request_id, request.scope_id, request.budget, request.cancellation, authority) == .Err(why) {
        return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, why, usage))
    }
    if result.identity != request.identity || result.scope_id != request.scope_id -> return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .InvalidEvaluatorResult, usage))
    carries_payload: result.value != None || result.changed || result.observation != None
    invalid_shape: if result.status == {
        .Completed -> result.error != None
        .Failed -> carries_payload || !evaluator_error_valid(result.error)
        .Cancelled -> carries_payload || result.error != None
    }
    if invalid_shape -> return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .InvalidEvaluatorResult, usage))
    if result.status == .Failed -> return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .EvaluatorFailed, usage))
    if result.status == .Cancelled -> return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .Cancelled, usage))
    if !request.budget.fits(usage) -> return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .BudgetExceeded, usage))
    if result.changed || result.observation != None {
        if request.mode != .Mutate -> return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .MutationNotAllowed, usage))
        if result.changed && result.observation == None -> return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .ObservationMissing, usage))
        if !result.changed -> return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .InvalidEvaluatorResult, usage))
    }
    observation_id := String?{None}
    if result.observation == .Val(observation) {
        if !observation.matches(session, request) -> return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .InvalidEvaluatorResult, usage))
        observation_id = Val(observation.event_id)
    }
    stats := projection_stats_zero()
    value := ValueProjection?{None}
    if result.value == .Val(supplied) {
        if supplied.validate_for_session(session.identity) == .Err(_) -> return Err(reject("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .InvalidEvaluatorResult, usage))
        if supplied.publication != .Absent {
            if supplied.publication == .Published -> stats.published = 1 else -> stats.redacted = 1
            value = Val(project_root(supplied, session.identity, request.budget, stats))
        }
    }
    audit: audit_receipt("paused.evaluate", request.request_id, request.identity, request.scope_id, authority, .Accepted, None, usage, stats.truncated, stats.published, stats.redacted, observation_id)
    Ok(EvaluateResponse{
        identity: request.identity,
        scope_id: request.scope_id,
        expression_hash: "sha256-{sha256_hex(request.expression)}",
        mode: request.mode,
        value: value,
        changed: result.changed,
        observation: result.observation,
        truncated: stats.truncated,
        audit: audit,
    })
}

// A failed evaluator result names a nonempty bounded error.
evaluator_error_valid: fn(error: String?) -> Bool Never! {
    message: error ?? return false
    if message == "" -> return false
    if valid_text(message, "evaluator error", 4096) == {
        .Err(_) -> false
        else -> true
    }
}

#Error
PausedEvaluateHostError: enum {
    SessionUnavailable
    EvaluatorUnavailable
    InvalidRequest(detail: String)
    Rejected(rejection: RequestError)

    json: fn(self) -> String Never! {
        if self == {
            .SessionUnavailable -> "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"ok\":false,\"error\":\"session_unavailable\"}}"
            .EvaluatorUnavailable -> "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"ok\":false,\"error\":\"evaluator_unavailable\"}}"
            .InvalidRequest(detail) -> "{{\"protocol\":\"{PAUSED_EVALUATE_PROTOCOL}\",\"schema_version\":{PAUSED_EVALUATE_SCHEMA_VERSION},\"ok\":false,\"error\":\"invalid_request\",\"detail\":\"{foundation_json_escape(detail)}\"}}"
            .Rejected(rejection) -> rejection.json()
        }
    }

    display: fn(self) -> String Never! {
        if self == {
            .SessionUnavailable -> "session_unavailable"
            .EvaluatorUnavailable -> "evaluator_unavailable"
            .InvalidRequest(detail) -> "invalid_request: {detail}"
            .Rejected(rejection) -> rejection.reason.as_str()
        }
    }
}

// One wrapper per devtools connection: facts are injected, never evaluated here.
PausedEvaluateHost: struct {
    session: PausedSession?
    evaluator_result: EvaluatorResult?

    set_session: fn(&self, session: PausedSession) Never! { self.session = Val(session) }

    clear_session: fn(&self) Never! {
        self.session = None
        self.evaluator_result = None
    }

    cancel_session: fn(&self, reason: String) PausedEvaluateHostError! {
        session := self.session ?? return Err(PausedEvaluateHostError.SessionUnavailable)
        if session.cancel(reason) == .Err(failure) -> return Err(PausedEvaluateHostError.InvalidRequest{detail: failure.message})
        self.session = Val(session)
        Ok()
    }

    is_paused: fn(self) -> Bool Never! {
        if self.session == {
            .Val(session) -> session.state == .Paused
            else -> false
        }
    }

    set_evaluator_result: fn(&self, result: EvaluatorResult) Never! { self.evaluator_result = Val(result) }

    clear_evaluator_result: fn(&self) Never! { self.evaluator_result = None }

    handle_inspect: fn(self, raw: String) -> String PausedEvaluateHostError! {
        response: self.inspect_request(raw)
        Ok(response.json())
    }

    inspect_request: fn(self, raw: String) -> InspectResponse PausedEvaluateHostError! {
        session: self.session ?? return Err(PausedEvaluateHostError.SessionUnavailable)
        request: parse_inspect_request(raw) ?? return Err(PausedEvaluateHostError.InvalidRequest{detail: err.message})
        Ok(inspect(session, request) ?? return Err(PausedEvaluateHostError.Rejected{rejection: err}))
    }

    handle_evaluate: fn(&self, raw: String) -> String PausedEvaluateHostError! {
        response: self.evaluate_request(raw)
        Ok(response.json())
    }

    // The injected evaluator result is consumed by the request it answers.
    evaluate_request: fn(&self, raw: String) -> EvaluateResponse PausedEvaluateHostError! {
        session: self.session ?? return Err(PausedEvaluateHostError.SessionUnavailable)
        request: parse_evaluate_request(raw) ?? return Err(PausedEvaluateHostError.InvalidRequest{detail: err.message})
        result: self.evaluator_result ?? return Err(PausedEvaluateHostError.EvaluatorUnavailable)
        self.evaluator_result = None
        Ok(evaluate(session, request, result) ?? return Err(PausedEvaluateHostError.Rejected{rejection: err}))
    }
}

inspect_authority: fn(request: InspectRequest) -> [AuthorityRequirement] Never! {
    authority := request.authority.copy()
    authority.push(AuthorityRequirement{capability: INSPECT_AUTHORITY, scope_id: request.scope_id})
    authority
}

evaluate_authority: fn(request: EvaluateRequest) -> [AuthorityRequirement] Never! {
    authority := request.authority.copy()
    authority.push(AuthorityRequirement{capability: EVALUATE_AUTHORITY, scope_id: request.scope_id})
    if request.mode == .Mutate {
        authority.push(AuthorityRequirement{capability: MUTATE_AUTHORITY, scope_id: request.scope_id})
        loop effect_ref in request.effects -> authority.push(AuthorityRequirement{capability: effect_ref, scope_id: request.scope_id})
    }
    authority_requirements_canonical(authority)
}

validate_common: fn(session: PausedSession, identity: SessionIdentity, request_id: String, scope_id: String, budget: EvaluationBudget, cancellation: Cancellation, authority: [AuthorityRequirement]) RejectReason! {
    if session.state == .Stale -> return Err(RejectReason.StaleSession)
    if session.state != .Paused {
        return Err(if session.state == .Cancelled || cancellation.requested -> RejectReason.Cancelled else -> RejectReason.SessionNotPaused)
    }
    if !request_shape_valid(identity, request_id, scope_id, budget, cancellation, authority) -> return Err(RejectReason.InvalidRequest)
    if identity.session_id != session.identity.session_id -> return Err(RejectReason.SessionIdentityMismatch)
    if identity.source_id != session.identity.source_id || identity.source_revision != session.identity.source_revision -> return Err(RejectReason.SourceIdentityMismatch)
    if identity.pause_id != session.identity.pause_id -> return Err(RejectReason.PauseIdentityMismatch)
    if identity.frame_id != session.identity.frame_id -> return Err(RejectReason.FrameIdentityMismatch)
    if session.cancellation.requested || cancellation.requested -> return Err(RejectReason.Cancelled)
    if !session.budget.contains(budget) -> return Err(RejectReason.BudgetExceeded)
    loop requirement in authority {
        if !session.authority.allows(requirement) -> return Err(RejectReason.InsufficientAuthority)
    }
    Ok()
}

request_shape_valid: fn(identity: SessionIdentity, request_id: String, scope_id: String, budget: EvaluationBudget, cancellation: Cancellation, authority: [AuthorityRequirement]) -> Bool Never! {
    if identity.validate() == .Err(_) || valid_id(request_id, "request id") == .Err(_) || valid_id(scope_id, "scope id") == .Err(_) -> return false
    if budget.validate() == .Err(_) || cancellation.validate() == .Err(_) -> return false
    loop requirement in authority {
        if requirement.validate() == .Err(_) -> return false
    }
    true
}

reject: fn(operation: String, request_id: String, identity: SessionIdentity, scope_id: String, authority: [AuthorityRequirement], reason: RejectReason, usage: EvaluationUsage) -> RequestError Never! {
    RequestError{reason: reason, audit: audit_receipt(operation, request_id, identity, scope_id, authority, .Rejected, Val(reason), usage, false, 0, 0, None)}
}

// The root is always retained; descendants stop at the node and byte budgets.
project_root: fn(value: ValueProjection, identity: SessionIdentity, budget: EvaluationBudget, stats: &ProjectionStats) -> ValueProjection Never! {
    project_node(value, identity, budget, 1, true, stats) ?? value_projection_absent(value.id, value.name, value.type_name, value.source)
}

project_node: fn(value: ValueProjection, identity: SessionIdentity, budget: EvaluationBudget, depth: Int, root: Bool{false}, stats: &ProjectionStats) -> ValueProjection? Never! {
    if value.publication == .Absent -> return None
    if !root && stats.usage.nodes >= budget.max_nodes {
        stats.truncated = true
        return None
    }
    if stats.usage.nodes < budget.max_nodes -> stats.usage.nodes += 1 else -> stats.truncated = true
    if depth > stats.usage.depth -> stats.usage.depth = depth
    metadata: value.metadata_bytes()
    metadata_fits: metadata <= budget.max_bytes - stats.usage.bytes
    if {
        metadata_fits -> stats.usage.bytes += metadata
        else -> {
            stats.usage.bytes = budget.max_bytes
            stats.truncated = true
        }
    }
    projected := value.copy()
    projected.value = None
    projected.children = [ValueProjection]{}
    projected.truncated = value.truncated || !metadata_fits
    if value.publication == .Published {
        if value.value == .Val(typed) {
            payload: typed.bytes()
            if {
                metadata_fits && payload <= budget.max_bytes - stats.usage.bytes -> {
                    stats.usage.bytes += payload
                    projected.value = Val(typed)
                }
                else -> {
                    stats.truncated = true
                    projected.truncated = true
                }
            }
        }
    }
    if value.children.len() > 0 {
        if {
            depth >= budget.max_depth || !metadata_fits -> {
                stats.truncated = true
                projected.truncated = true
            }
            else -> loop child in value.children {
                if project_node(child, identity, budget, depth + 1, false, stats) == {
                    .Val(projected_child) -> projected.children.push(projected_child)
                    else -> {
                        stats.truncated = true
                        projected.truncated = true
                    }
                }
            }
        }
    }
    if value.publication == .Published {
        measured: value.measure()
        bounded: if measured.depth < budget.max_depth -> measured.depth else -> budget.max_depth
        if bounded > stats.usage.depth -> stats.usage.depth = bounded
    }
    Val(projected)
}

// True when `value` holds a C0/C1 control scalar or DEL.
paused_has_control: fn(value: String) -> Bool Never! {
    bytes: value.bytes()
    loop index in 0..<bytes.len() {
        byte: Int{bytes[index]}
        if byte < 32 || byte == 127 -> return true
        if byte == 194 && index + 1 < bytes.len() {
            next_byte: Int{bytes[index + 1]}
            if next_byte >= 128 && next_byte <= 159 -> return true
        }
    }
    false
}

paused_is_hex: fn(value: String) -> Bool Never! {
    loop byte in value.bytes() {
        code: Int{byte}
        digit: code >= 48 && code <= 57
        lower: code >= 97 && code <= 102
        upper: code >= 65 && code <= 70
        if !digit && !lower && !upper -> return false
    }
    true
}

valid_id: fn(value: String, label: String) PausedEvaluateError! {
    if value == "" || value.len() > 256 || paused_has_control(value) -> return Err(paused_error("{label} is empty, too long, or contains control text"))
    Ok()
}

valid_text: fn(value: String, label: String, max_bytes: Int) PausedEvaluateError! {
    if value.len() > max_bytes || paused_has_control(value) -> return Err(paused_error("{label} exceeds its bounded text contract"))
    Ok()
}

array_json: fn(values: [String]) -> String Never! { "[{values.join(",")}]" }

requirements_json: fn(requirements: [AuthorityRequirement]) -> String Never! {
    rows := [String]{}
    loop requirement in requirements -> rows.push(requirement.json())
    array_json(rows)
}

// A paused request's top-level JSON object, at most MAX_REQUEST_BYTES.
request_object: fn(raw: String) -> [String:Dyn] PausedEvaluateError! {
    if raw.len() > MAX_REQUEST_BYTES -> return Err(paused_error("paused request is not valid bounded JSON"))
    root: paused_json.parse(raw) ?? return Err(paused_error("paused request is not valid bounded JSON"))
    dyn_object(root) ?? return Err(paused_error("paused request must be a JSON object"))
}

dyn_object: fn(value: Dyn) -> [String:Dyn]? Never! {
    if value == {
        .Object(members) -> {
            fields := [String:Dyn]{}
            loop member in members -> fields[member.key] = member.value
            Val(fields)
        }
        else -> None
    }
}

required_string: fn(fields: [String:Dyn], key: String) -> String PausedEvaluateError! {
    value: fields.get(key) ?? return Err(paused_error("paused request requires string `{key}`"))
    if value == {
        .Text(text) -> {
            valid_text(text, key, 256)
            Ok(text)
        }
        else -> Err(paused_error("paused request requires string `{key}`"))
    }
}

optional_string: fn(fields: [String:Dyn], key: String) -> String? PausedEvaluateError! {
    value: fields.get(key) ?? return Ok(None)
    if value == {
        .Null -> Ok(None)
        .Text(text) -> {
            valid_text(text, key, 256)
            Ok(Val(text))
        }
        else -> Err(paused_error("paused request field `{key}` must be a string or null"))
    }
}

required_count: fn(fields: [String:Dyn], key: String) -> Int PausedEvaluateError! {
    value: fields.get(key) ?? return Err(paused_error("paused request requires non-negative integer `{key}`"))
    number: foundation_json_integer(value) ?? return Err(paused_error("paused request requires non-negative integer `{key}`"))
    if number < 0 -> return Err(paused_error("paused request requires non-negative integer `{key}`"))
    Ok(number)
}

optional_bool: fn(fields: [String:Dyn], key: String) -> Bool PausedEvaluateError! {
    value: fields.get(key) ?? return Ok(false)
    if value == {
        .Bool(flag) -> Ok(flag)
        else -> Err(paused_error("paused request field `{key}` must be boolean"))
    }
}

// `identity` as a nested object, or the identity fields inline at the top level.
parse_identity: fn(fields: [String:Dyn]) -> SessionIdentity PausedEvaluateError! {
    identity := fields
    if fields.get("identity") == .Val(nested) {
        identity = dyn_object(nested) ?? return Err(paused_error("paused request `identity` must be an object"))
    }
    SessionIdentity.new(required_string(identity, "session_id"), required_string(identity, "source_id"),
        required_string(identity, "source_revision"), required_string(identity, "pause_id"), required_string(identity, "frame_id"))
}

parse_budget: fn(fields: [String:Dyn]) -> EvaluationBudget PausedEvaluateError! {
    value: fields.get("budget") ?? return Ok(DEFAULT_EVALUATION_BUDGET)
    budget: dyn_object(value) ?? return Ok(DEFAULT_EVALUATION_BUDGET)
    EvaluationBudget.new(required_count(budget, "max_depth"), required_count(budget, "max_nodes"),
        required_count(budget, "max_bytes"), required_count(budget, "max_steps"))
}

parse_authority: fn(fields: [String:Dyn]) -> [AuthorityRequirement] PausedEvaluateError! {
    value: fields.get("authority") ?? return Ok([AuthorityRequirement]{})
    if value == {
        .Array(values) -> {
            authority := [AuthorityRequirement]{}
            loop entry in values {
                requirement: dyn_object(entry) ?? return Err(paused_error("paused authority requirement must be an object"))
                authority.push(AuthorityRequirement.new(required_string(requirement, "capability"), required_string(requirement, "scope_id")))
            }
            Ok(authority)
        }
        else -> Err(paused_error("paused request `authority` must be an array"))
    }
}

validate_header: fn(fields: [String:Dyn], kind: String) PausedEvaluateError! {
    if required_string(fields, "protocol") != PAUSED_EVALUATE_PROTOCOL -> return Err(paused_error("paused request protocol does not match jet.devtools.v1"))
    schema_value: fields.get("schema_version") ?? return Err(paused_error("paused request schema_version is missing or invalid"))
    schema: foundation_json_integer(schema_value) ?? return Err(paused_error("paused request schema_version is missing or invalid"))
    if schema != PAUSED_EVALUATE_SCHEMA_VERSION -> return Err(paused_error("paused request schema_version is unsupported"))
    if required_string(fields, "kind") != kind -> return Err(paused_error("paused request kind must be `{kind}`"))
    Ok()
}

request_cancellation: fn(fields: [String:Dyn]) -> Cancellation PausedEvaluateError! {
    if optional_bool(fields, "cancelled") -> return cancellation_requested("request cancelled")
    Ok(cancellation_none())
}

parse_inspect_request: fn(raw: String) -> InspectRequest PausedEvaluateError! {
    fields: request_object(raw)
    validate_header(fields, "paused.inspect")
    request: InspectRequest{
        request_id: required_string(fields, "request_id"),
        identity: parse_identity(fields),
        scope_id: required_string(fields, "scope_id"),
        value_id: optional_string(fields, "value_id"),
        budget: parse_budget(fields),
        authority: parse_authority(fields),
        cancellation: request_cancellation(fields),
    }
    request.validate_shape()
    Ok(request)
}

parse_evaluate_request: fn(raw: String) -> EvaluateRequest PausedEvaluateError! {
    fields: request_object(raw)
    validate_header(fields, "paused.evaluate")
    mode: if required_string(fields, "mode") == {
        "read_only" -> EvaluationMode.ReadOnly
        "mutate" -> EvaluationMode.Mutate
        else -> { return Err(paused_error("paused evaluation mode is unsupported")) }
    }
    effects := [String]{}
    if fields.get("effects") == .Val(listed) {
        if listed == {
            .Array(values) -> {
                loop entry in values {
                    if entry == {
                        .Text(text) -> {
                            valid_id(text, "evaluation effect")
                            effects.push(text)
                        }
                        else -> { return Err(paused_error("paused evaluation effects must be strings")) }
                    }
                }
            }
            else -> { return Err(paused_error("paused evaluation `effects` must be an array")) }
        }
    }
    request: EvaluateRequest{
        request_id: required_string(fields, "request_id"),
        identity: parse_identity(fields),
        scope_id: required_string(fields, "scope_id"),
        expression: required_string(fields, "expression"),
        mode: mode,
        effects: effects,
        authority: parse_authority(fields),
        budget: parse_budget(fields),
        cancellation: request_cancellation(fields),
    }
    request.validate_shape()
    Ok(request)
}
