// Rust: crates/jet-devserver/src/PausedEvaluate.rs:1251
struct AuditReceipt {
    receipt_id: String; operation: String; request_id: String; outcome: AuditOutcome; reason: RejectReason?
    identity: SessionIdentity; scope_id: String; authority: [AuthorityRequirement]; usage: EvaluationUsage
    truncated: Bool; published_values: U64; redacted_values: U64; observation_id: String?
}
impl AuditReceipt {
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1268
    fn new(operation: String, request_id: String, identity: &SessionIdentity, scope_id: String, authority: &[AuthorityRequirement], outcome: AuditOutcome, reason: RejectReason?, usage: EvaluationUsage, truncated: Bool, published_values: U64, redacted_values: U64, observation_id: String?) -> Self {
        authority := authority.copy()
        authority.sort()
        authority.dedup()
        authority_key :: authority.iter().map((requirement) -> "{requirement.capability}@{requirement.scope_id}").collect[[String]]().join(",")
        reason_text :: reason.map((reason) -> reason.as_str()).unwrap_or("")
        observation_text :: observation_id.as_ref().unwrap_or("")
        canonical :: "paused-audit-v1|{operation}|{request_id}|{identity.session_id}|{identity.source_id}|{identity.source_revision}|{identity.pause_id}|{identity.frame_id}|{scope_id}|{outcome.as_str()}|{reason_text}|{authority_key}|{usage.depth}|{usage.nodes}|{usage.bytes}|{usage.steps}|{truncated}|{published_values}|{redacted_values}|{observation_text}"
        digest :: sha256_hex(canonical.as_bytes())
        Self { receipt_id: "paused-audit-{digest.slice(0..<24)}", operation: operation.copy(), request_id: request_id.copy(), outcome, reason,
            identity: identity.copy(), scope_id: scope_id.copy(), authority: ^authority, usage, truncated, published_values, redacted_values, observation_id: observation_id.copy() }
    }
    // Rust: crates/jet-devserver/src/PausedEvaluate.rs:1329
    fn json(self: Self) -> String {
        reason :: self.reason.map((reason) -> "\"{reason.as_str()}\"").unwrap_or("null")
        authority :: array_json(self.authority.iter().map((requirement) -> requirement.json()))
        observation_id :: self.observation_id.as_ref().map((id) -> "\"{foundation_json_escape(id)}\"").unwrap_or("null")
        "{{\"receipt_id\":\"{foundation_json_escape(self.receipt_id)}\",\"operation\":\"{foundation_json_escape(self.operation)}\",\"request_id\":\"{foundation_json_escape(self.request_id)}\",\"outcome\":\"{self.outcome.as_str()}\",\"reason\":{reason},\"identity\":{self.identity.json()},\"scope_id\":\"{foundation_json_escape(self.scope_id)}\",\"authority\":{authority},\"usage\":{self.usage.json()},\"truncated\":{self.truncated},\"published_values\":{self.published_values},\"redacted_values\":{self.redacted_values},\"observation_id\":{observation_id}}}"
    }
}
