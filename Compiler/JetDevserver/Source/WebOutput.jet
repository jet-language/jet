// Web bundle publication through held directories (core.files `Directory`).
// The output directory is held from the project root down without following
// a link, and every staged and published member must be a regular file with a
// single hard link, so a link planted in the output tree can't redirect a
// write or expose a file outside it.
use {
    files: core.files
    core.files.[Directory, Stat]
    process: core.process
}

// Owner-only permission bits of the publication backup directory.
WEB_OUTPUT_PRIVATE_MODE: 0o700
// Backup directory names tried before publication gives up.
WEB_OUTPUT_CHILD_ATTEMPTS: 100

// A held output directory and the canonical path it was opened at.
WebOutputAuthority: struct {
    path: String
    directory: Directory

    // Whether the member `name` is present as a regular file with one link;
    // a link, a directory or a hard-linked file is an error.
    has_file: fn(self, name: String) -[FS.Read]> Bool IOError! {
        web_output_normal_name(name)
        if web_output_member(self.directory, self.path, name) == {
            .Ok(_) -> Ok(true)
            .Err(error) -> {
                if error == .NotFound(_) -> return Ok(false)
                Err(error)
            }
        }
    }

    // The member `name` must be present as a regular file with one link.
    require_file: fn(self, name: String) IOError! -[FS.Read]> {
        web_output_normal_name(name)
        _ := web_output_member(self.directory, self.path, name)
    }

    // Move the member `name` into `destination` under the same name,
    // replacing a regular destination member, and check that the published
    // file is the one that left this directory.
    rename_file_to: fn(self, name: String, destination: WebOutputAuthority) IOError! -[FS]> {
        web_output_normal_name(name)
        source: web_output_member(self.directory, self.path, name)
        if web_output_member(destination.directory, destination.path, name) == .Err(error) {
            if !(error == .NotFound(_)) -> return Err(error)
        }
        self.directory.rename(name, name, into: Val(destination.directory), if_exists: .Replace)
        published: web_output_member(destination.directory, destination.path, name)
        if published.id != source.id -> return Err(web_output_denied(files.join(destination.path, name), "published web output identity changed"))
    }

    // Remove the member `name`; a missing member is success.
    remove_file_if_exists: fn(self, name: String) IOError! -[FS]> {
        web_output_normal_name(name)
        web_output_member(self.directory, self.path, name) ?? {
            if err == .NotFound(_) -> return
            return Err(err)
        }
        self.directory.remove(name)
    }

    // Hold the existing child directory `name`; a link is refused.
    open_existing_child: fn(self, name: String) -[FS.Read]> WebOutputAuthority IOError! {
        web_output_normal_name(name)
        directory: self.directory.open_directory(name)
        Ok(WebOutputAuthority{path: files.join(self.path, name), directory: directory})
    }

    // Create and hold a fresh owner-only child directory named
    // `{prefix}-{pid}-{attempt}`; an existing name is never reused.
    create_unique_child: fn(self, prefix: String) -[FS, Env]> WebOutputAuthority IOError! {
        web_output_normal_name(prefix)
        pid: process.current_pid()
        loop attempt in 0..<WEB_OUTPUT_CHILD_ATTEMPTS {
            name: "{prefix}-{pid}-{attempt}"
            if self.directory.create_directory(name, mode: Val(WEB_OUTPUT_PRIVATE_MODE)) == {
                .Ok(directory) -> return Ok(WebOutputAuthority{path: files.join(self.path, name), directory: directory})
                .Err(error) -> {
                    if !(error == .AlreadyExists(_)) -> return Err(error)
                }
            }
        }
        Err(IOError.AlreadyExists(IOContext{operation: .Write, resource: Val(self.path), os_code: None, cause: Val("could not allocate a web publication directory")}))
    }

    // Remove the empty child directory `name`; a missing one is success.
    remove_child_directory: fn(self, name: String) IOError! -[FS]> {
        web_output_normal_name(name)
        self.directory.remove_directory(name) ?? {
            if err == .NotFound(_) -> return
            return Err(err)
        }
    }
}

// Hold `out_dir`, creating it when missing. Neither it nor a directory created
// for it may be a link, and its real path must lie inside `root`; it is then
// opened from `root` one part at a time without following a link.
web_output_open: fn(out_dir: String, root: String) -[FS, Env]> WebOutputAuthority IOError! {
    anchor: files.canonicalize(root)
    web_output_ensure_directory(out_dir)
    real: files.canonicalize(out_dir)
    prefix: if anchor.ends_with("/") -> anchor.copy() else -> "{anchor}/"
    if real != anchor && !real.starts_with(prefix) -> return Err(web_output_denied(real, "web output directory escapes `{anchor}`"))
    directory := files.open_directory(anchor)
    if real != anchor {
        loop part in real.removeprefix(prefix).split("/") {
            if part == "" -> next
            directory = directory.open_directory(part)
        }
    }
    Ok(WebOutputAuthority{path: real, directory: directory})
}

// Make `path` a real directory: an existing link or non-directory is refused,
// and missing ancestors are created the same way, nearest the root first.
web_output_ensure_directory: fn(path: String) IOError! -[FS]> {
    missing := false
    if files.lstat(path) == {
        .Ok(info) -> {
            if info.is_symlink -> return Err(web_output_denied(path, "web output directory must not be a symlink"))
            if !info.is_dir -> return Err(IOError.AlreadyExists(IOContext{operation: .Write, resource: Val(path), os_code: None, cause: Val("web output path is not a directory")}))
        }
        .Err(error) -> {
            if !(error == .NotFound(_)) -> return Err(error)
            missing = true
        }
    }
    if !missing -> return
    parent: files.dirname(path)
    if parent != "" && parent != path -> web_output_ensure_directory(parent)
    holder: files.open_directory(if parent == "" -> "." else -> parent)
    if holder.create_directory(files.basename(path)) == .Err(created) {
        if !(created == .AlreadyExists(_)) -> return Err(created)
    }
}

// Publish the staged bundle `staging` (a child of `out_dir`) into `out_dir`.
// Every present member first moves aside into a private backup directory,
// then the staged members move in; on any failure the published members are
// removed and the backed-up ones restored. Every member is checked before the
// first move. The caller holds the static-reader publication lock.
web_output_publish: fn(staging: String, out_dir: String, root: String) IOError! -[FS, Env]> {
    output_root: web_output_open(out_dir, root)
    staging_name: files.basename(staging)
    web_output_normal_name(staging_name)
    staging_parent: files.dirname(staging)
    real_parent: files.canonicalize(if staging_parent == "" -> "." else -> staging_parent)
    if real_parent != output_root.path -> return Err(web_output_denied(staging, "web staging directory escapes the output directory"))
    staging_root: output_root.open_existing_child(staging_name)
    // The members every web bundle publishes, then its optional source maps.
    members: [String]{"web.manifest.json", "jet_dom_runtime.js", "app.js", "app.wasm", "index.html"}
    maps: [String]{"app.js.map", "app.wasm.map"}
    names := [String]{}
    staged_names := [String]{}
    loop name in members {
        staging_root.require_file(name)
        _ := output_root.has_file(name)
        names.push(name.copy())
        staged_names.push(name.copy())
    }
    loop name in maps {
        staged: staging_root.has_file(name)
        current: output_root.has_file(name)
        if staged || current -> names.push(name.copy())
        if staged -> staged_names.push(name.copy())
    }
    backup: output_root.create_unique_child(".jet-web-publication")
    backed_up := [String]{}
    published := [String]{}
    failure := IOError?{None}
    loop name in names {
        if failure != None -> break
        if output_root.has_file(name) == {
            .Ok(present) -> {
                if present {
                    backed_up.push(name.copy())
                    if output_root.rename_file_to(name, backup) == .Err(error) {
                        failure = Val(error)
                    }
                }
            }
            .Err(error) -> failure = Val(error)
        }
    }
    loop name in staged_names {
        if failure != None -> break
        published.push(name.copy())
        if staging_root.rename_file_to(name, output_root) == .Err(error) {
            failure = Val(error)
        }
    }
    if failure == .Val(error) {
        published.reverse()
        loop name in published -> output_root.remove_file_if_exists(name).drop("rollback continues past a member it can't remove")
        backed_up.reverse()
        loop name in backed_up -> backup.rename_file_to(name, output_root).drop("rollback continues past a member it can't restore")
        loop name in names -> backup.remove_file_if_exists(name).drop("the backup directory is removed below when empty")
        output_root.remove_child_directory(files.basename(backup.path)).drop("a leftover backup directory holds no published bytes")
        return Err(error)
    }
    loop name in names -> backup.remove_file_if_exists(name)
    output_root.remove_child_directory(files.basename(backup.path))
}

// The identity of the member `name` of `parent`, refused unless both the
// entry and the file it opens are the same regular file with one link.
web_output_member: fn(parent: Directory, parent_path: String, name: String) -[FS.Read]> Stat IOError! {
    resource: files.join(parent_path, name)
    entry: parent.entry_stat(name)
    if entry.is_symlink || !entry.is_file || entry.links != 1 -> return Err(web_output_denied(resource, "web output member must be a regular file with one link"))
    reader: parent.open(name)
    held: reader.stat()
    if held.id != entry.id || held.links != 1 -> return Err(web_output_denied(resource, "web output member changed while it was checked"))
    Ok(held)
}

// Refuse a name that is not exactly one normal path component.
web_output_normal_name: fn(name: String) IOError! {
    if name == "" || name == "." || name == ".." || name.contains("/") || name.contains("\\") || name.bytes().contains(U8{0}) {
        return Err(IOError.InvalidInput(IOContext{operation: .Write, resource: Val(name), os_code: None, cause: Val("web output name must be one normal path component")}))
    }
}

web_output_denied: fn(resource: String, cause: String) -> IOError Never! {
    IOError.PermissionDenied(IOContext{operation: .Write, resource: Val(resource), os_code: None, cause: Val(cause)})
}

web_output_test_root: fn(label: String) -[FS]> String {
    files.tmpdir("jet-web-output-{label}-") ?? panic("scratch directory")
}

// The members a whole staged test bundle holds.
web_output_test_members: fn() -> [String] {
    [String]{"web.manifest.json", "jet_dom_runtime.js", "app.js", "app.wasm", "index.html"}
}

web_output_test_stage: fn(staging: String) -[FS]> {
    files.create_dir_all(staging) ?? panic("staging directory")
    loop name in web_output_test_members() -> files.write(files.join(staging, name), "staged {name}") ?? panic("staged member")
}

#Test("web output publication replaces the bundle and leaves no backup") {
    root: web_output_test_root("publish")
    output: files.join(root, "build")
    staging: files.join(output, ".staging")
    web_output_test_stage(staging)
    files.write(files.join(output, "web.manifest.json"), "previous") ?? panic("previous manifest")
    files.write(files.join(output, "app.js.map"), "previous map") ?? panic("previous map")
    web_output_publish(staging, output, root) ?? panic("publication: {err}")
    loop name in web_output_test_members() {
        assert_eq(files.read(files.join(output, name)) ?? panic("published {name}"), "staged {name}")
        assert(!files.exists(files.join(staging, name)), "a published member leaves the staging directory")
    }
    assert(!files.exists(files.join(output, "app.js.map")), "an unstaged source map is retired with the old bundle")
    loop entry in files.list_dir(output) ?? panic("list output") {
        assert(!entry.name.starts_with(".jet-web-publication"), "publication removes its backup directory")
    }
    files.remove_all(root) ?? panic("cleanup")
}

#Test("web output publication refuses a symlinked destination member") {
    root: web_output_test_root("symlink")
    output: files.join(root, "build")
    staging: files.join(output, ".staging")
    outside: files.join(root, "outside.js")
    web_output_test_stage(staging)
    files.write(outside, "must survive") ?? panic("outside file")
    files.symlink(outside, files.join(output, "web.manifest.json")) ?? panic("planted link")
    assert(web_output_publish(staging, output, root) == .Err(_), "web finalization must not replace a symlinked output")
    assert_eq(files.read(outside) ?? panic("outside file"), "must survive")
    assert_eq(files.read(files.join(staging, "app.js")) ?? panic("staged member"), "staged app.js")
    files.remove_all(root) ?? panic("cleanup")
}

#Test("web output publication refuses a hard-linked destination member") {
    root: web_output_test_root("hardlink")
    output: files.join(root, "build")
    staging: files.join(output, ".staging")
    outside: files.join(root, "outside.js")
    web_output_test_stage(staging)
    files.write(outside, "must survive") ?? panic("outside file")
    files.hard_link(outside, files.join(output, "web.manifest.json")) ?? panic("planted hard link")
    assert(web_output_publish(staging, output, root) == .Err(_), "web finalization must reject hard-linked output members")
    assert_eq(files.read(outside) ?? panic("outside file"), "must survive")
    files.remove_all(root) ?? panic("cleanup")
}

#Test("web output publication refuses a symlinked staging directory") {
    root: web_output_test_root("staging-link")
    output: files.join(root, "build")
    staging_target: files.join(root, "staging-target")
    staging: files.join(output, ".staging")
    files.create_dir_all(output) ?? panic("output directory")
    web_output_test_stage(staging_target)
    files.symlink(staging_target, staging) ?? panic("planted staging link")
    assert(web_output_publish(staging, output, root) == .Err(_), "web finalization must reject a symlinked staging directory")
    assert(!files.exists(files.join(output, "web.manifest.json")), "a linked staging directory publishes nothing")
    assert_eq(files.read(files.join(staging_target, "web.manifest.json")) ?? panic("staged member"), "staged web.manifest.json")
    files.remove_all(root) ?? panic("cleanup")
}

#Test("web output publication refuses a symlinked output root") {
    root: web_output_test_root("output-link")
    real_output: files.join(root, "real-build")
    output: files.join(root, "build")
    web_output_test_stage(files.join(real_output, ".staging"))
    files.symlink(real_output, output) ?? panic("planted output link")
    assert(web_output_publish(files.join(output, ".staging"), output, root) == .Err(_), "web finalization must reject a symlinked output root")
    assert(!files.exists(files.join(real_output, "web.manifest.json")), "a rejected output-root link receives no bytes")
    files.remove_all(root) ?? panic("cleanup")
}

#Test("web output publication refuses an output directory outside the root") {
    root: web_output_test_root("escape")
    project: files.join(root, "project")
    output: files.join(root, "elsewhere")
    files.create_dir_all(project) ?? panic("project directory")
    web_output_test_stage(files.join(output, ".staging"))
    if web_output_publish(files.join(output, ".staging"), output, project) == {
        .Ok(_) -> panic("an output directory outside the project root must be refused")
        .Err(error) -> assert(error == .PermissionDenied(_))
    }
    assert(!files.exists(files.join(output, "web.manifest.json")), "an escaping output directory receives no bytes")
    files.remove_all(root) ?? panic("cleanup")
}
