use jet_foundation.HotSwap.[HotSwapDecision, StateRetentionDecision]

impl NativeSwapState {
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1815
    pub fn reject(self: &Self, plan: &NativeSwapPlan, explanation: NativeSwapExplanation) -> NativeSwapReceipt {
        preserved_listeners := self.listeners.keys().cloned().collect[[String]]()
        preserved_listeners.sort()
        preserved_connections := self.connections.keys().cloned().collect[[String]]()
        preserved_connections.sort()
        NativeSwapReceipt { source: ~self.executable.source,
            outcome: if explanation.disposition == .Restart -> NativeSwapOutcome.RestartRequired else -> NativeSwapOutcome.Rejected,
            before: ~self.executable.revision, after: ~plan.to.revision,
            before_generation: self.executable.generation, after_generation: self.executable.generation,
            preserved_listeners: ^preserved_listeners, reset_listeners: [], preserved_connections: ^preserved_connections,
            reset_connections: [], restart_boundary: ~plan.restart_boundary, explanation: .Val(^explanation) }
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1841
    pub fn fail(self: &Self, explanation: NativeSwapExplanation) -> NativeSwapReceipt NativeSwapError! {
        receipt := self.rollback()?
        receipt.outcome = if explanation.disposition == .Restart -> NativeSwapOutcome.RestartRequired else -> NativeSwapOutcome.Rejected
        receipt.explanation = .Val(^explanation)
        receipt
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:1855
    fn validate_plan(self: &Self, plan: &NativeSwapPlan) -> Unit NativeSwapError! {
        plan.validate_shape()?
        source_id :: self.source().canonical()
        if !plan.source.matches(self.source()) -> return .Err(NativeSwapError.input(source_id, .SourceIdentityChanged, "plan source `{plan.source.canonical()}` does not match resident source"))
        if plan.from != self.executable -> return .Err(NativeSwapError.input(source_id, .StalePlan, "plan `from` executable does not match resident executable"))
        if plan.to.source != plan.source -> return .Err(NativeSwapError.input(source_id, .SourceIdentityChanged, "candidate executable belongs to another source"))
        if plan.to.generation <= self.executable.generation -> return .Err(NativeSwapError.input(source_id, .StalePlan, "candidate generation does not advance the resident generation"))
        if plan.decision.requires_restart() -> return .Err(restart_or_reject(source_id, plan.capability.restart, .IncompatibleType,
            plan.decision.compatibility.reason().unwrap_or("semantic hot-swap verdict requires a clean restart")))
        if plan.blocking_fact == .Val(fact) {
            disposition :: if plan.capability.restart && fact.is_restartable() -> NativeSwapDisposition.Restart else -> NativeSwapDisposition.Rejected
            return .Err(NativeSwapError { explanation: NativeSwapExplanation.new(source_id, disposition, fact, "checked producer marked this plan unsafe or incompatible") })
        }
        if !plan.removed_definitions.is_empty() -> return .Err(NativeSwapError.input(source_id, .StaleReference, "removed definitions would leave stale references: {plan.removed_definitions.join(",")}"))
        if plan.restart_boundary.required {
            fact :: plan.restart_boundary.reason.unwrap_or(.RestartRequired)
            return .Err(restart_or_reject(source_id, plan.capability.restart, fact, "candidate requires the announced clean restart boundary"))
        }
        if plan.capability.quiescence == .Required && (!plan.quiescence.required || !plan.quiescence.is_ready()) -> return .Err(NativeSwapError.input(source_id, .QuiescenceRequired,
            "swap requires quiescence; active_operations={plan.quiescence.active_operations} reached={plan.quiescence.reached}"))
        if plan.code_changed() {
            if plan.capability.code == {
                .Replace -> {}
                .Restart -> return .Err(restart_or_reject(source_id, plan.capability.restart, .CodeRevisionUnsupported, "code revision changed but capability permits replacement only at restart"))
                .Reject -> return .Err(NativeSwapError.input(source_id, .CodeRevisionUnsupported, "code revision changed and capability rejects in-place replacement"))
            }
        }
        if plan.data_changed() {
            if plan.capability.data == {
                .Preserve -> return .Err(restart_or_reject(source_id, plan.capability.restart, .DataRevisionUnsupported, "data revision changed but resident data policy is preserve"))
                .Replace | .Migrate -> {}
                .Restart -> return .Err(restart_or_reject(source_id, plan.capability.restart, .LayoutChanged, "data revision changed and capability requires a clean restart"))
                .Reject -> return .Err(NativeSwapError.input(source_id, .DataRevisionUnsupported, "data revision changed and capability rejects in-place replacement"))
            }
        }
        relocation_supported :: plan.relocation.strategy.permits_in_place() && plan.capability.relocation.permits_in_place()
        if (plan.code_changed() || plan.data_changed()) && !relocation_supported -> return .Err(restart_or_reject(source_id, plan.capability.restart, .RelocationUnsupported,
            "relocation strategy `{plan.relocation.strategy.as_str()}` with capability `{plan.capability.relocation.as_str()}` does not permit in-place activation"))
        link_supported :: plan.link.strategy.permits_in_place() && plan.capability.link.permits_in_place()
        if (plan.code_changed() || plan.data_changed()) && !link_supported -> return .Err(restart_or_reject(source_id, plan.capability.restart, .LinkStrategyUnsupported,
            "link strategy `{plan.link.strategy.as_str()}` with capability `{plan.capability.link.as_str()}` does not permit in-place activation"))
        self.validate_listener_handles(plan)?
        self.validate_connection_handles(plan)?
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:2028
    fn validate_listener_handles(self: &Self, plan: &NativeSwapPlan) -> Unit NativeSwapError! {
        source_id :: self.source().canonical()
        if !plan.preserve_listeners.is_empty() && plan.capability.listeners == .Never -> return .Err(NativeSwapError.input(source_id, .CapabilityUnavailable, "listener preservation was requested but capability forbids it"))
        for handle in plan.preserve_listeners {
            if !handle.source.matches(self.source()) -> return .Err(NativeSwapError.input(source_id, .ListenerHandleStale, "listener handle `{handle.id}` belongs to another source"))
            current :: self.listeners.get(handle.id) ?? return .Err(NativeSwapError.input(source_id, .ListenerHandleMissing, "listener handle `{handle.id}` is not resident"))
            if !handle.is_compatible() -> return .Err(NativeSwapError.input(source_id, .ListenerHandleIncompatible, "listener handle `{handle.id}` is explicitly incompatible"))
            if current.generation != handle.generation || !current.is_compatible() -> return .Err(NativeSwapError.input(source_id, .ListenerHandleStale, "listener handle `{handle.id}` does not match the resident generation"))
        }
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:2072
    fn validate_connection_handles(self: &Self, plan: &NativeSwapPlan) -> Unit NativeSwapError! {
        source_id :: self.source().canonical()
        if !plan.preserve_connections.is_empty() && plan.capability.connections == .Never -> return .Err(NativeSwapError.input(source_id, .CapabilityUnavailable, "connection preservation was requested but capability forbids it"))
        listener_ids: [String:Bool] := [:]
        for handle in plan.preserve_listeners -> listener_ids.insert(handle.id, true)
        for handle in plan.preserve_connections {
            if !handle.source.matches(self.source()) -> return .Err(NativeSwapError.input(source_id, .ConnectionHandleStale, "connection handle `{handle.id}` belongs to another source"))
            current :: self.connections.get(handle.id) ?? return .Err(NativeSwapError.input(source_id, .ConnectionHandleMissing, "connection handle `{handle.id}` is not resident"))
            if !handle.is_compatible() -> return .Err(NativeSwapError.input(source_id, .ConnectionHandleIncompatible, "connection handle `{handle.id}` is explicitly incompatible"))
            if current.generation != handle.generation || !current.is_compatible() -> return .Err(NativeSwapError.input(source_id, .ConnectionHandleStale, "connection handle `{handle.id}` does not match the resident generation"))
            if !listener_ids.contains_key(handle.listener_id) -> return .Err(NativeSwapError.input(source_id, .ConnectionListenerNotPreserved,
                "connection `{handle.id}` names listener `{handle.listener_id}` without an explicit compatible listener handle"))
        }
    }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:2131
    fn error(self: &Self, fact: NativeSwapBlockingFact, detail: String) -> NativeSwapError { NativeSwapError.input(self.source().canonical(), fact, ^detail) }
    // Rust: crates/jet-devserver/src/NativeSwap.rs:2135
    fn phase_error(self: &Self, detail: String) -> NativeSwapError { self.error(.InvalidPhase, "{detail}; current phase={self.phase.as_str()}") }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2145
pub type CodeRevision = NativeSwapCodeRevision
// Rust: crates/jet-devserver/src/NativeSwap.rs:2147
pub type DataRevision = NativeSwapDataRevision
// Rust: crates/jet-devserver/src/NativeSwap.rs:2149
pub type NativeSwapResidentState = NativeSwapState
// Rust: crates/jet-devserver/src/NativeSwap.rs:2151
pub type NativeSwapFailure = NativeSwapError

// Rust: crates/jet-devserver/src/NativeSwap.rs:2153
fn receipt_from_working(working: &NativeSwapWorkingReceipt, outcome: NativeSwapOutcome, explanation: NativeSwapExplanation?) -> NativeSwapReceipt {
    NativeSwapReceipt { source: ~working.source, outcome, before: ~working.before.revision, after: ~working.after.revision,
        before_generation: working.before.generation, after_generation: working.after.generation,
        preserved_listeners: ~working.preserved_listeners, reset_listeners: ~working.reset_listeners,
        preserved_connections: ~working.preserved_connections, reset_connections: ~working.reset_connections,
        restart_boundary: ~working.restart_boundary, explanation: ^explanation }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2174
fn listener_map(source_id: String, executable: &NativeSwapExecutable, listeners: [NativeSwapListenerHandle]) -> [String:NativeSwapListenerHandle] NativeSwapError! {
    if listeners.len() > MAX_NATIVE_SWAP_FACTS -> return .Err(NativeSwapError.input(source_id, .FactLimit, "resident listener count exceeds its bounded fact limit"))
    map: [String:NativeSwapListenerHandle] := [:]
    for listener in listeners {
        _ :: validate_identity(listener.id, "listener handle identity") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        _ :: validate_source_identity(&listener.source, "listener handle") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        if !listener.source.matches(&executable.source) -> return .Err(NativeSwapError.input(source_id, .ListenerHandleStale, "listener `{listener.id}` belongs to another source"))
        if listener.generation != executable.generation -> return .Err(NativeSwapError.input(source_id, .ListenerHandleStale, "listener `{listener.id}` does not match resident generation"))
        if map.insert(~listener.id, ^listener).is_some() -> return .Err(NativeSwapError.input(source_id, .DuplicateIdentity, "resident listener identities must be unique"))
    }
    map
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2227
fn connection_map(source_id: String, executable: &NativeSwapExecutable, connections: [NativeSwapConnectionHandle], listeners: &[String:NativeSwapListenerHandle]) -> [String:NativeSwapConnectionHandle] NativeSwapError! {
    if connections.len() > MAX_NATIVE_SWAP_FACTS -> return .Err(NativeSwapError.input(source_id, .FactLimit, "resident connection count exceeds its bounded fact limit"))
    map: [String:NativeSwapConnectionHandle] := [:]
    for connection in connections {
        _ :: validate_identity(connection.id, "connection handle identity") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        _ :: validate_identity(connection.listener_id, "connection listener identity") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        _ :: validate_source_identity(&connection.source, "connection handle") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        if !connection.source.matches(&executable.source) -> return .Err(NativeSwapError.input(source_id, .ConnectionHandleStale, "connection `{connection.id}` belongs to another source"))
        if connection.generation != executable.generation -> return .Err(NativeSwapError.input(source_id, .ConnectionHandleStale, "connection `{connection.id}` does not match resident generation"))
        if !listeners.contains_key(connection.listener_id) -> return .Err(NativeSwapError.input(source_id, .ConnectionListenerNotPreserved, "connection `{connection.id}` names unknown listener `{connection.listener_id}`"))
        if map.insert(~connection.id, ^connection).is_some() -> return .Err(NativeSwapError.input(source_id, .DuplicateIdentity, "resident connection identities must be unique"))
    }
    map
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2298
fn validate_identity(value: String, label: String) -> Unit Err! {
    if value.is_empty() -> return .Err("{label} must not be empty")
    if value.len() > MAX_NATIVE_SWAP_ID_BYTES -> return .Err("{label} exceeds {MAX_NATIVE_SWAP_ID_BYTES} bytes")
    if value.chars().any((character) -> character.is_control()) -> return .Err("{label} contains a control character")
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2314
fn validate_source_identity(identity: &NativeSwapSourceIdentity, label: String) -> Unit Err! {
    validate_identity(identity.source_id, "{label} source")?
    validate_identity(identity.module, "{label} module")
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2321
fn validate_hot_swap_decision(source_id: String, source: &NativeSwapSourceIdentity, decision: &HotSwapDecision) -> Unit NativeSwapError! {
    _ :: validate_identity(decision.module, "hot-swap decision module") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
    if decision.module != source.module -> return .Err(NativeSwapError.input(source_id, .SourceIdentityChanged, "hot-swap decision module `{decision.module}` does not match source module `{source.module}`"))
    if decision.state_facts().len() > MAX_NATIVE_SWAP_FACTS -> return .Err(NativeSwapError.input(source_id, .FactLimit, "hot-swap decision exceeds its retention fact limit"))
    seen: [String:Bool] := [:]
    for fact in decision.state_facts() {
        _ :: validate_identity(fact.key, "hot-swap retention key") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        if seen.insert(fact.key, true).is_some() -> return .Err(NativeSwapError.input(source_id, .DuplicateIdentity, "hot-swap retention key `{fact.key}` appears more than once"))
    }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2370
fn decision_restart_boundary(decision: &HotSwapDecision) -> NativeSwapRestartBoundary {
    affected := normalized_facts(~decision.changed_functions)
    if affected.is_empty() -> affected.push(~decision.module)
    kept: [String] := []
    reset: [String] := []
    for fact in decision.state_facts() {
        if fact.decision == {
            .Preserve -> kept.push(~fact.key)
            .Fresh { .. } -> reset.push(~fact.key)
        }
    }
    NativeSwapRestartBoundary.required(.IncompatibleType, ^affected).with_state(^kept, ^reset)
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2387
fn validate_listener_plan_facts(source_id: String, expected_source: &NativeSwapSourceIdentity, handles: &[NativeSwapListenerHandle]) -> Unit NativeSwapError! {
    if handles.len() > MAX_NATIVE_SWAP_FACTS -> return .Err(NativeSwapError.input(source_id, .FactLimit, "native swap plan exceeds its listener fact limit"))
    seen: [String:Bool] := [:]
    for handle in handles {
        _ :: validate_identity(handle.id, "listener handle identity") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        _ :: validate_source_identity(&handle.source, "listener handle") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        if !handle.source.matches(expected_source) -> return .Err(NativeSwapError.input(source_id, .ListenerHandleStale, "listener handle `{handle.id}` belongs to another source"))
        if seen.insert(handle.id, true).is_some() -> return .Err(NativeSwapError.input(source_id, .DuplicateIdentity, "listener handle `{handle.id}` appears more than once"))
    }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2433
fn validate_connection_plan_facts(source_id: String, expected_source: &NativeSwapSourceIdentity, handles: &[NativeSwapConnectionHandle]) -> Unit NativeSwapError! {
    if handles.len() > MAX_NATIVE_SWAP_FACTS -> return .Err(NativeSwapError.input(source_id, .FactLimit, "native swap plan exceeds its connection fact limit"))
    seen: [String:Bool] := [:]
    for handle in handles {
        _ :: validate_identity(handle.id, "connection handle identity") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        _ :: validate_identity(handle.listener_id, "connection listener identity") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        _ :: validate_source_identity(&handle.source, "connection handle") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
        if !handle.source.matches(expected_source) -> return .Err(NativeSwapError.input(source_id, .ConnectionHandleStale, "connection handle `{handle.id}` belongs to another source"))
        if seen.insert(handle.id, true).is_some() -> return .Err(NativeSwapError.input(source_id, .DuplicateIdentity, "connection handle `{handle.id}` appears more than once"))
    }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2486
fn validate_revision(value: String, label: String) -> Unit Err! { validate_identity(value, label) }
// Rust: crates/jet-devserver/src/NativeSwap.rs:2490
fn validate_fact_list(source_id: String, facts: &[String]) -> Unit NativeSwapError! {
    if facts.len() > MAX_NATIVE_SWAP_FACTS -> return .Err(NativeSwapError.input(source_id, .FactLimit, "native swap fact list exceeds its bounded fact limit"))
    for fact in facts {
        _ :: validate_identity(fact, "native swap fact") ?? return .Err(NativeSwapError.input(source_id, .InvalidIdentity, err))
    }
    seen: [String:Bool] := [:]
    for fact in facts {
        if seen.insert(fact, true).is_some() -> return .Err(NativeSwapError.input(source_id, .DuplicateIdentity, "native swap fact `{fact}` appears more than once"))
    }
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2520
fn normalized_facts(facts: [String]) -> [String] { facts.sort(); facts }
// Rust: crates/jet-devserver/src/NativeSwap.rs:2525
fn bounded_text(value: String, limit: USize) -> String {
    output := ""
    for character in value.chars() {
        if character.is_control() -> continue
        if output.len() + character.len_utf8() > limit -> break
        output.push(character)
    }
    output
}
// Rust: crates/jet-devserver/src/NativeSwap.rs:2539
fn restart_or_reject(source_id: String, allows_restart: Bool, fact: NativeSwapBlockingFact, detail: String) -> NativeSwapError {
    if allows_restart && fact.is_restartable() -> NativeSwapError.restart(source_id, fact, ^detail)
    else {
        reason :: if fact.is_restartable() -> "capability does not allow a clean restart" else -> "blocking fact cannot be handled by a clean restart"
        NativeSwapError.input(source_id, fact, "{detail}; {reason}")
    }
}
