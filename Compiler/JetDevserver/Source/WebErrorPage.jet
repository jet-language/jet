    pub fn with_location(self: Self, line: U32?, column: U32?) -> Self WebErrorPageError! {
        if line.is_some_and((v) -> v == 0) || column.is_some_and((v) -> v == 0) -> return .Err(.InvalidSpan)
        self.line = line
        self.column = column
        return self
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:310
    pub fn validate(self: &Self) -> Unit WebErrorPageError! {
        validate_source_identity(self.source_id)?
        validate_identity(self.label, "source label")?
        if self.span == .Val(span) -> span.validate()?
        if self.line.is_some_and((v) -> v == 0) || self.column.is_some_and((v) -> v == 0) -> return .Err(.InvalidSpan)
        validate_optional_text(&self.excerpt, "source excerpt", MAX_WEB_ERROR_SOURCE_BYTES)?
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:323
    fn with_parts(source_id: String, label: String, span: WebErrorSpan?, line: U32?, column: U32?, excerpt: String?) -> Self WebErrorPageError! {
        item :: Self { source_id: normalize_source_identity(^source_id)?, label: normalize_identity(^label, "source label")?, span, line, column, excerpt: normalize_optional_text(^excerpt, "source excerpt", MAX_WEB_ERROR_SOURCE_BYTES)? }
        item.validate()?
        return item
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:343
    fn json(self: &Self) -> String {
        fields := ["\"source_id\":" + json_string(self.source_id), "\"label\":" + json_string(self.label)]
        if self.span == .Val(span) -> fields.push("\"span\":" + span.json())
        if self.line == .Val(line) -> fields.push("\"line\":" + line.to_string())
        if self.column == .Val(column) -> fields.push("\"column\":" + column.to_string())
        if self.excerpt.as_ref() == .Val(excerpt) -> fields.push("\"excerpt\":" + json_string(excerpt))
        return "{" + fields.join(",") + "}"
    }
}
