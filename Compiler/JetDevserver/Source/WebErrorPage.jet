    pub severity: String?; pub moment: String?; pub typed_identity: String?; pub span: WebErrorSpan?
}
impl WebErrorDiagnosticFact {
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:604
    pub fn new(code: String, what: String, why: String, fix: String) -> Self WebErrorPageError! {
        fact :: Self {
            code: .Val(normalize_code(^code)?),
            what: .Val(normalize_required_text(^what, "diagnostic what", MAX_WEB_ERROR_TEXT_BYTES)?),
            why: .Val(normalize_required_text(^why, "diagnostic why", MAX_WEB_ERROR_TEXT_BYTES)?),
            fix: .Val(normalize_required_text(^fix, "diagnostic fix", MAX_WEB_ERROR_TEXT_BYTES)?),
            severity: .None, moment: .None, typed_identity: .None, span: .None
        }
        fact.validate()?
        return fact
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:638
    pub fn from_diagnostic(diagnostic: &Diagnostic) -> Self WebErrorPageError! {
