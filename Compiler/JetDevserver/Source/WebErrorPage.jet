//RS //! Typed, bounded projections for a local development-service failure.
//RS //!
//RS //! The page is an adapter at the web boundary.  It consumes facts that were
//RS //! already recorded by the terminal/runtime error path; it never parses a
//RS //! rendered diagnostic and it never changes failure classification or
//RS //! lifecycle.  HTML and JSON are two renderings of one `WebErrorFacts` value,
//RS //! so their identity and digest cannot drift.
//RS 
//RS use jet_foundation::Diagnostics::{Diagnostic, Span};
//RS use jet_foundation::JSON::quote as json_string;
//RS use jet_foundation::Outcome::{JetErrorContextFrame, JetErrorJourneyFrame, JetErrorReport};
//RS use jet_foundation::SHA256::sha256_hex;
//RS use jet_semindex::html_escape;
//RS use std::fmt;
