// Rust: crates/jet-devserver/src/WebErrorPage.rs:32
#Error
pub enum WebErrorPageError {
    EmptyField(String), InvalidIdentity(String), InvalidSpan, InvalidStatus,
    InvalidLink, InvalidAccept, ControlCharacter(String), UnsafeContent(String),
    TextTooLarge(String), TooManyItems(String), InputTooLarge, OutputTooLarge
}
impl WebErrorPageError {
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:48
    fn fmt(self: &Self) -> String {
        return match self {
            .EmptyField(field) -> "{field} must not be empty"
            .InvalidIdentity(field) -> "invalid {field} identity"
            .InvalidSpan -> "invalid source span"
            .InvalidStatus -> "web error status must be between 400 and 599"
            .InvalidLink -> "action link is not a safe local or HTTPS URL"
            .InvalidAccept -> "invalid or oversized Accept header"
            .ControlCharacter(field) -> "{field} contains a control character"
            .UnsafeContent(field) -> "{field} contains unpublished sensitive content"
            .TextTooLarge(field) -> "{field} exceeds its byte budget"
            .TooManyItems(field) -> "too many {field}"
            .InputTooLarge -> "web error facts exceed the input byte budget"
            .OutputTooLarge -> "web error projection exceeds the output byte budget"
        }
    }
}
