fn report_source_excerpts(report: &JetErrorReport) -> [WebErrorSourceExcerpt] WebErrorPageError! {
    excerpts: [WebErrorSourceExcerpt] := []
    for frame in report.origin.iter().chain(&report.source_journey) -> excerpts.push(source_excerpt_from_journey(frame)?)
    for frame in &report.context_frames -> excerpts.push(source_excerpt_from_context(frame)?)
    return excerpts
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1414
fn source_excerpt_from_journey(frame: &JetErrorJourneyFrame) -> WebErrorSourceExcerpt WebErrorPageError! {
    excerpt :: if frame.note.is_empty() -> .None else -> .Val(frame.note.clone())
    return WebErrorSourceExcerpt.without_span(frame.file.clone(), frame.fn_name.clone(), ^excerpt)?.with_location(if frame.line > 0 -> .Val(frame.line) else -> .None, if frame.column > 0 -> .Val(frame.column) else -> .None)
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1425
fn source_excerpt_from_context(frame: &JetErrorContextFrame) -> WebErrorSourceExcerpt WebErrorPageError! {
    return WebErrorSourceExcerpt.without_span(frame.file.clone(), "context", .Val(frame.text.clone()))?.with_location(if frame.line > 0 -> .Val(frame.line) else -> .None, .None)
}
