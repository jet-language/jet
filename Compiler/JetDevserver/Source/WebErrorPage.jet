            what: .Val(normalize_required_text(diagnostic.what.clone(), "diagnostic what", MAX_WEB_ERROR_TEXT_BYTES)?),
            why: normalize_optional_text(.Val(diagnostic.why.clone()), "diagnostic why", MAX_WEB_ERROR_TEXT_BYTES)?,
            fix: normalize_optional_text(.Val(diagnostic.fix.clone()), "diagnostic fix", MAX_WEB_ERROR_TEXT_BYTES)?,
            severity: .Val(match diagnostic.severity { .Error -> "error"; .Lint -> "lint" }),
            moment: .Val(diagnostic.moment.as_str().to_string()), typed_identity: .None,
            span: diagnostic.span.map(web_span_from_span).transpose()?
        }
        fact.validate()?
        return fact
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:671
    pub fn from_report(report: &JetErrorReport) -> Self WebErrorPageError! {
        typed_identity :: report.typed_identity.clone().map((v) -> normalize_identity(v, "typed error identity")).transpose()?
        span :: report.details.as_ref().and_then((d) -> d.source_span.clone()).map((s) -> WebErrorSpan.new(s.start, s.end)).transpose()?
        fact :: Self {
            code: report.code.clone().map(normalize_code).transpose()?,
            what: .Val(normalize_required_text(report.message.clone(), "diagnostic what", MAX_WEB_ERROR_TEXT_BYTES)?),
            why: .None, fix: .None, severity: .None, moment: .None, typed_identity, span
        }
        fact.validate()?
        return fact
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:708
    pub fn from_dev_status(facts: &WebErrorDevStatusFacts) -> Self WebErrorPageError! {
        code :: if facts.code.is_empty() -> .None else -> .Val(normalize_code(facts.code.clone())?)
        fact :: Self { code, what: .Val(normalize_required_text(facts.diagnostic.clone(), "diagnostic what", MAX_WEB_ERROR_TEXT_BYTES)?), why: .None, fix: .None, severity: .None, moment: .None, typed_identity: .None, span: .None }
        fact.validate()?
        return fact
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:732
    pub fn with_span(self: Self, span: WebErrorSpan?) -> Self WebErrorPageError! {
        if span == .Val(v) -> v.validate()?
        self.span = span
        self.validate()?
        return self
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:741
    pub fn validate(self: &Self) -> Unit WebErrorPageError! {
        if self.code.as_ref() == .Val(v) -> validate_code(v)?
        if self.what.is_none() -> return .Err(.EmptyField("diagnostic what"))
        validate_optional_text(&self.what, "diagnostic what", MAX_WEB_ERROR_TEXT_BYTES)?
        validate_optional_text(&self.why, "diagnostic why", MAX_WEB_ERROR_TEXT_BYTES)?
        validate_optional_text(&self.fix, "diagnostic fix", MAX_WEB_ERROR_TEXT_BYTES)?
        if self.severity.as_ref() == .Val(v) -> validate_identity(v, "diagnostic severity")?
        if self.moment.as_ref() == .Val(v) -> validate_identity(v, "diagnostic moment")?
        if self.typed_identity.as_ref() == .Val(v) -> validate_identity(v, "typed error identity")?
        if self.span == .Val(v) -> v.validate()?
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:766
    fn json(self: &Self) -> String { return self.json_with_edits(&[]) }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:770
    fn json_with_edits(self: &Self, edits: &[WebErrorEdit]) -> String {
        fields: [String] := []
        if self.code.as_ref() == .Val(v) -> fields.push("\"code\":" + json_string(v))
        if self.what.as_ref() == .Val(v) -> fields.push("\"what\":" + json_string(v))
        if self.why.as_ref() == .Val(v) -> fields.push("\"why\":" + json_string(v))
        if self.fix.as_ref() == .Val(v) -> fields.push("\"fix\":" + json_string(v))
        if self.severity.as_ref() == .Val(v) -> fields.push("\"severity\":" + json_string(v))
        if self.moment.as_ref() == .Val(v) -> fields.push("\"moment\":" + json_string(v))
        if self.typed_identity.as_ref() == .Val(v) -> fields.push("\"typed_identity\":" + json_string(v))
        if self.span == .Val(v) -> fields.push("\"span\":" + v.json())
        if !edits.is_empty() -> fields.push("\"fix_edits\":[" + edits.iter().map(WebErrorEdit.json).collect[[String]]().join(",") + "]")
        return "{" + fields.join(",") + "}"
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:807
    fn internal_placeholder() -> Self {
        return Self { code: .None, what: .Val("Internal development-service failure"), why: .None, fix: .None, severity: .None, moment: .None, typed_identity: .None, span: .None }
    }
}
