fn validate_identity(value: String, field: String) -> Unit WebErrorPageError! {
    if value.is_empty() -> return .Err(.EmptyField(field))
    if value.len() > MAX_WEB_ERROR_ID_BYTES -> return .Err(.TextTooLarge(field))
    if value.chars().any((c) -> c.is_control()) -> return .Err(.ControlCharacter(field))
    if value.chars().any((c) -> c.is_whitespace() || c == '<' || c == '>' || c == '"' || c == '\'' || c == '`' || c == '\\') -> return .Err(.InvalidIdentity(field))
