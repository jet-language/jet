fn normalize_text(value: String, field: String, limit: Usize) -> String WebErrorPageError! {
    if value.len() > limit -> return .Err(.TextTooLarge(field))
    normalized := String.with_capacity(value.len())
    for c in value.chars() {
        if c == '\n' || c == '\r' || c == '\t' -> normalized.push(c)
        else if c.is_control() -> normalized.push('�')
        else -> normalized.push(c)
    }
    return normalized
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1556
fn validate_optional_text(value: &String?, field: String, limit: Usize) -> Unit WebErrorPageError! {
    value :: value.as_ref() ?? return ()
    if value.is_empty() -> return .Err(.EmptyField(field))
    if value.len() > limit -> return .Err(.TextTooLarge(field))
    if value.chars().any((c) -> c.is_control()) && value.chars().any((c) -> c != '\n' && c != '\r' && c != '\t' && c.is_control()) -> return .Err(.ControlCharacter(field))
    if contains_sensitive_marker(value) -> return .Err(.UnsafeContent(field))
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1581
fn contains_sensitive_marker(value: String) -> Bool {
    lower :: value.to_ascii_lowercase()
    return ["password=", "password:", "secret=", "secret:", "authorization:", "authorization=", "bearer ", "api_key", "apikey", "access_token", "client_secret", "private_key", "set-cookie", "cookie:", "sk_live_", "ghp_", "xoxb-"].iter().any((marker) -> lower.contains(marker))
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1606
fn normalize_href(value: String) -> String WebErrorPageError! { validate_href(value)?; return value }
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1611
fn validate_href(value: String) -> Unit WebErrorPageError! {
    if value.is_empty() -> return .Err(.EmptyField("action href"))
    if value.len() > MAX_WEB_ERROR_LINK_BYTES -> return .Err(.TextTooLarge("action href"))
    if value.chars().any((c) -> c.is_control()) || value.chars().any((c) -> c.is_whitespace()) -> return .Err(.InvalidLink)
    if contains_sensitive_marker(value) || value.contains('@') -> return .Err(.InvalidLink)
    lower :: value.to_ascii_lowercase()
    allowed :: (value.starts_with('/') && !value.starts_with("//")) || lower.starts_with("http://") || lower.starts_with("https://") || lower.starts_with("jet://")
    if !allowed || lower.starts_with("javascript:") || lower.starts_with("data:") || lower.starts_with("vbscript:") || lower.starts_with("file:") -> return .Err(.InvalidLink)
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1641
fn validate_status(status: U16) -> Unit WebErrorPageError! { if status < 400 || status > 599 -> return .Err(.InvalidStatus) }
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1649
fn source_excerpt_order(left: &WebErrorSourceExcerpt, right: &WebErrorSourceExcerpt) -> Ordering {
    return left.source_id.cmp(right.source_id).then_with(() -> left.label.cmp(right.label)).then_with(() -> left.span.map((s) -> (s.start, s.end)).cmp(right.span.map((s) -> (s.start, s.end)))).then_with(() -> left.line.cmp(right.line)).then_with(() -> left.column.cmp(right.column)).then_with(() -> left.excerpt.cmp(right.excerpt))
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1663
fn action_link_order(left: &WebErrorActionLink, right: &WebErrorActionLink) -> Ordering { return left.label.cmp(right.label).then_with(() -> left.href.cmp(right.href)) }
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1666
fn web_error_edit_order(left: &WebErrorEdit, right: &WebErrorEdit) -> Ordering {
    return left.source_id.cmp(right.source_id).then_with(() -> left.span.start.cmp(right.span.start).then_with(() -> left.span.end.cmp(right.span.end))).then_with(() -> left.new_text.cmp(right.new_text)).then_with(() -> left.applicability.cmp(right.applicability)).then_with(() -> left.safety.cmp(right.safety))
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1680
fn html_pair(label: String, value: String) -> String { return "<dt>" + html_escape(label) + "</dt><dd>" + html_escape(value) + "</dd>" }
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1688
fn render_source_html(html: &String, excerpts: &[WebErrorSourceExcerpt]) -> Unit {
    if excerpts.is_empty() -> return
    html.push_str("<h2>Source</h2>")
    for excerpt in excerpts {
        html.push_str("<section><h3>")
        html.push_str(html_escape(excerpt.label))
        html.push_str("</h3><p><code>")
        html.push_str(html_escape(excerpt.source_id))
        if excerpt.line == .Val(line) {
            html.push(':')
            html.push_str(line.to_string())
            if excerpt.column == .Val(column) { html.push(':'); html.push_str(column.to_string()) }
        }
        if excerpt.span == .Val(span) {
            html.push_str(" bytes ")
            html.push_str(span.start.to_string())
            html.push_str("..")
            html.push_str(span.end.to_string())
        }
        html.push_str("</code></p>")
        if excerpt.excerpt.as_ref() == .Val(text) { html.push_str("<pre>"); html.push_str(html_escape(text)); html.push_str("</pre>") }
        html.push_str("</section>")
    }
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1722
fn accept_candidate_better(candidate: (U16, U8, Usize), current: (U16, U8, Usize)?) -> Bool {
    return current.is_none_or((v) -> candidate.1 > v.1 || (candidate.1 == v.1 && candidate.2 < v.2))
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1732
fn negotiate_content_type(accept: String) -> WebErrorContentType {
    // Specificity wins within a representation before comparing qualities.
    html: (U16, U8, Usize)? := .None
    json: (U16, U8, Usize)? := .None
    for (index, item) in accept.split(',').enumerate() {
        pieces := item.split(';')
        media := pieces.next().unwrap_or("").trim() // #4303
        if media.is_empty() -> continue
        quality: U16 := 1000
        valid := true
        for parameter in pieces {
            parameter := parameter.trim() // #4303
            (name, value) :: parameter.split_once('=') ?? continue
            name := name.trim() // #4303
            if name.eq_ignore_ascii_case("q") {
                value := value.trim() // #4303
                match parse_quality(value) { .Val(v) -> quality = v; .None -> valid = false }
            }
        }
        if !valid -> continue
        content_type: WebErrorContentType? := .None
        specificity: U8 := 0
        if media.eq_ignore_ascii_case("text/html") { content_type = .Val(.Html); specificity = 2 }
        else if media.eq_ignore_ascii_case("application/json") { content_type = .Val(.Json); specificity = 2 }
        else if media.eq_ignore_ascii_case("text/*") { content_type = .Val(.Html); specificity = 1 }
        else if media.eq_ignore_ascii_case("application/*") { content_type = .Val(.Json); specificity = 1 }
        else if media != "*/*" && media != "*" -> continue
        candidate :: (quality, specificity, index)
        match content_type {
            .Val(.Html) -> { if accept_candidate_better(candidate, html) -> html = .Val(candidate) }
            .Val(.Json) -> { if accept_candidate_better(candidate, json) -> json = .Val(candidate) }
            .None -> {
                if accept_candidate_better(candidate, html) -> html = .Val(candidate)
                if accept_candidate_better(candidate, json) -> json = .Val(candidate)
            }
        }
    }
    match (html, json) {
        (.Val(h), .Val(j)) -> {
            if j.0 > h.0 || (j.0 == h.0 && (j.1 > h.1 || (j.1 == h.1 && j.2 < h.2))) -> return .Json
            return .Html
        }
        (.Val(_), _) -> return .Html
        (.None, .None) -> return .Html
        (.None, .Val(_)) -> return .Json
    }
}
// Rust: crates/jet-devserver/src/WebErrorPage.rs:1810
fn parse_quality(value: String) -> U16? {
    if value == "0" -> return .Val(0)
    if value == "1" -> return .Val(1000)
    (whole, fraction) :: value.split_once('.') ?? return .None
    if whole != "0" && whole != "1" -> return .None
    if fraction.is_empty() || fraction.len() > 3 || !fraction.bytes().all((b) -> b.is_ascii_digit()) -> return .None
    padded := fraction.to_string()
    while padded.len() < 3 -> padded.push('0')
    fractional :: padded.parse[U16]().ok() ?? return .None
    if whole == "1" && fractional != 0 -> return .None
    return .Val(if whole == "1" -> 1000 else -> fractional)
}
