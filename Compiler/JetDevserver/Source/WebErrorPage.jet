// Rust: crates/jet-devserver/src/WebErrorPage.rs:835
pub struct WebErrorPage {
    identity: WebErrorPageIdentity; diagnostic: WebErrorDiagnosticFact; internal: WebErrorInternalFact?
    edits: [WebErrorEdit]; source_excerpts: [WebErrorSourceExcerpt]; related_cause: WebErrorDiagnosticFact?
    action_links: [WebErrorActionLink]; status: U16; failure_id: String
}
impl WebErrorPage {
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:848
    pub fn new(identity: WebErrorPageIdentity, diagnostic: WebErrorDiagnosticFact, source_excerpts: [WebErrorSourceExcerpt], related_cause: WebErrorDiagnosticFact?, action_links: [WebErrorActionLink]) -> Self WebErrorPageError! {
        return Self.new_with_status(500, ^identity, ^diagnostic, ^source_excerpts, ^related_cause, ^action_links)
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:865
    pub fn new_with_status(status: U16, identity: WebErrorPageIdentity, diagnostic: WebErrorDiagnosticFact, source_excerpts: [WebErrorSourceExcerpt], related_cause: WebErrorDiagnosticFact?, action_links: [WebErrorActionLink]) -> Self WebErrorPageError! {
        validate_status(status)?
        identity.validate()?
        diagnostic.validate()?
        if related_cause.as_ref() == .Val(cause) -> cause.validate()?
        if source_excerpts.len() > MAX_WEB_ERROR_SOURCE_EXCERPTS -> return .Err(.TooManyItems("source excerpts"))
