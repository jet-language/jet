// Rust: crates/jet-devserver/src/WebErrorPage.rs:404
pub struct WebErrorEdit {
    pub source_id: String; pub span: WebErrorSpan; pub new_text: String
    pub applicability: String?; pub safety: String?
}
impl WebErrorEdit {
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:413
    pub fn new(source_id: String, span: WebErrorSpan, new_text: String, applicability: String?, safety: String?) -> Self WebErrorPageError! {
        edit :: Self {
            source_id: normalize_source_identity(^source_id)?, span,
            new_text: normalize_text(^new_text, "fix edit", MAX_WEB_ERROR_TEXT_BYTES)?,
            applicability: applicability.map((value) -> normalize_identity(value, "fix applicability")).transpose()?,
            safety: safety.map((value) -> normalize_identity(value, "fix safety")).transpose()?
        }
        edit.validate()?
        return edit
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:435
    fn from_diagnostic(source_id: String, edit: &TextEdit, applicability: String?, safety: String?) -> Self WebErrorPageError! {
        return Self.new(source_id, web_span_from_span(edit.span)?, edit.new_text.clone(), applicability.map((v) -> v.to_string()), safety.map((v) -> v.to_string()))
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:450
    pub fn validate(self: &Self) -> Unit WebErrorPageError! {
        validate_source_identity(self.source_id)?
        self.span.validate()?
        if self.new_text.len() > MAX_WEB_ERROR_TEXT_BYTES -> return .Err(.TextTooLarge("fix edit"))
        if self.new_text.chars().any((c) -> c.is_control() && c != '\n' && c != '\r' && c != '\t') -> return .Err(.ControlCharacter("fix edit"))
        if contains_sensitive_marker(self.new_text) -> return .Err(.UnsafeContent("fix edit"))
        if self.applicability.as_ref() == .Val(v) -> validate_identity(v, "fix applicability")?
        if self.safety.as_ref() == .Val(v) -> validate_identity(v, "fix safety")?
    }
    // Rust: crates/jet-devserver/src/WebErrorPage.rs:474
    fn json(self: &Self) -> String {
        fields := ["\"source_id\":" + json_string(self.source_id), "\"span\":" + self.span.json(), "\"new_text\":" + json_string(self.new_text)]
        if self.applicability.as_ref() == .Val(v) -> fields.push("\"applicability\":" + json_string(v))
        if self.safety.as_ref() == .Val(v) -> fields.push("\"safety\":" + json_string(v))
        return "{" + fields.join(",") + "}"
    }
}
