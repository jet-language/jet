        .Val(_) -> .Err(web_stream_request_error(format("web stream `{}` must be a string", key)))
        .None -> .Err(web_stream_request_error(format("web stream request has no `{}`", key)))
    }
}
// Rust: crates/jet-devserver/src/WebHost.rs:3838
fn web_stream_required_u64(object: &[String:DataTree], key: String) -> Result<U64, (String, String)> {
    return match object.get(key) {
        .Val(.Int(value)) if value >= 0 -> .Ok(value as U64)
        .Val(.Int(_)) -> .Err(web_stream_request_error(format("web stream `{}` must be non-negative", key)))
        .Val(_) -> .Err(web_stream_request_error(format("web stream `{}` must be an integer", key)))
        .None -> .Err(web_stream_request_error(format("web stream request has no `{}`", key)))
    }
}
