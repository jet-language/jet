fn web_stream_required_usize(object: &[String:DataTree], key: String) -> Result<USize, (String, String)> {
    value :: web_stream_required_u64(object, key)?
    return USize.try_from(value).map_err((_) -> web_stream_request_error(format("web stream `{}` is too large", key))) // GATE #4483: selected pointer width.
