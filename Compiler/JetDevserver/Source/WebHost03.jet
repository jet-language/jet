// Rust: crates/jet-devserver/src/WebHost.rs:3952
fn web_stream_failure(object: &[String:DataTree]) -> Result<web_stream_bridge.JetWebPendingError, (String, String)> {
    error :: web_stream_object(object, "error")?
    return match web_stream_required_string(&error, "code")? {
        "missing_final_chunk" -> .Ok(.MissingFinalChunk)
        "invalid_lifecycle" -> .Ok(.InvalidLifecycle(state: .Pending, operation: "web_stream_fail"))
        "content_too_large" -> .Ok(.ContentTooLarge(limit: web_stream_required_usize(&error, "limit")?, actual: web_stream_required_usize(&error, "actual")?))
        code -> .Err(web_stream_request_error(format("web stream failure code `{}` is not supported by the host bridge", code)))
    }
}
