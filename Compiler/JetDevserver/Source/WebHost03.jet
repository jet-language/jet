// Private continuation of WebHost: the listener's routes and the session,
// release-inspect and devtools checks each request passes. A handler only
// reads the state or notes into its inbox; the dev clock does the rest.
use {
    webhost_web: core.web
    core.http.[HTTPRequest, HTTPResponse]
    core.web.[App]
    jet_canvas.[
        canvas_host_body_empty, canvas_host_host_allowed, canvas_host_origin_allowed, canvas_host_query, canvas_host_same_secret,
        canvas_host_session_count, canvas_host_single_security_headers,
    ]
    jet_foundation.[JetReleaseDevtoolsPolicy]
    jetpack_foundation.[terminal_pad_end]
}

// The longest client id a page may lease.
WEB_HOST_MAX_CLIENT_ID: 128

// The listener's routes: every GET and POST goes through web_host_answer,
// which routes on the request's own path.
web_host_app: fn(state: Shared<WebHostState>) -> App {
    app: webhost_web.app()
    // `rest` only satisfies the catch-all's one typed input.
    app.get("/*rest", fn(request: HTTPRequest, rest: String) { Ok(web_host_answer(state, request)) })
    app.post("/*rest", fn(request: HTTPRequest, rest: String) { Ok(web_host_answer(state, request)) })
    app
}

web_host_answer: fn(state: Shared<WebHostState>, request: HTTPRequest) -> HTTPResponse {
    target: request.path.partition("?")
    path: target.head
    query: target.tail
    answered: web_host_route(state, request, path, query)
    web_host_note_request(state, request.method, path, answered.status)
    answered
}

web_host_route: fn(state: Shared<WebHostState>, request: HTTPRequest, path: String, query: String) -> HTTPResponse {
    release: web_host_is_release(state)
    if release && (path == "/__jet_devtools" || path.starts_with("/__jet_devtools/")) -> return web_host_release_inspect(state, request, path)
    if request.method != "GET" && request.method != "POST" -> return web_host_text(405, "method not allowed")
    if path == "/__jet_dev_version" {
        if request.method != "GET" -> return web_host_text(405, "method not allowed")
        return web_host_text(200, "{web_host_version(state)}")
    }
    if path == "/__jet_dev_status" -> return web_host_status(state, request, path, query)
    if path == "/__jet_dev_disconnect" -> return web_host_disconnect(state, request, path, query)
    if path == "/__jet_perf_browser" -> return web_host_perf_beacon(state, request, path, query)
    if source_tool_path(path) {
        if release -> return web_host_text(404, "source tools are absent in release builds")
        if !web_host_authorized(state, request, path, query) -> return web_host_rejected()
        return web_host_text(404, SOURCE_TOOLS_OFF_REASON)
    }
    if devtools_path(path) -> return web_host_devtools(state, request, path, query)
    if request.method != "GET" -> return web_host_text(405, "method not allowed")
    web_host_static(state, path)
}

// The page's poll: answered to any page, its client lease noted only with
// the session.
web_host_status: fn(state: Shared<WebHostState>, request: HTTPRequest, path: String, query: String) -> HTTPResponse {
    if request.method != "GET" -> return web_host_text(405, "method not allowed")
    if web_host_authorized(state, request, path, query) {
        if canvas_host_query(query, "client") == .Val(client) -> web_host_queue_client(state, client, false)
    }
    web_host_json(200, web_host_status_json(state))
}

// pagehide's beacon: a clean close, not a lost connection.
web_host_disconnect: fn(state: Shared<WebHostState>, request: HTTPRequest, path: String, query: String) -> HTTPResponse {
    if request.method != "POST" -> return web_host_text(405, "method not allowed")
    if !web_host_authorized(state, request, path, query) -> return web_host_rejected()
    if canvas_host_query(query, "client") == .Val(client) -> web_host_queue_client(state, client, true)
    web_host_text(200, "ok")
}

// A browser-trace row from the page's perf script, for the current relay
// only; the dev clock records it.
web_host_perf_beacon: fn(state: Shared<WebHostState>, request: HTTPRequest, path: String, query: String) -> HTTPResponse {
    if request.method != "POST" -> return web_host_text(405, "method not allowed")
    if !web_host_authorized(state, request, path, query) -> return web_host_rejected()
    nonce: web_host_nonce(state)
    if nonce == "" -> return web_host_text(503, "browser trace relay unavailable")
    sent: canvas_host_query(query, "nonce") ?? ""
    if !canvas_host_same_secret(sent, nonce) -> return web_host_text(403, "stale or foreign browser trace session")
    if request.body_len() > BROWSER_TRACE_ENVELOPE_LIMIT -> return web_host_text(413, "browser trace envelope exceeds 512 bytes")
    body: request.text(BROWSER_TRACE_ENVELOPE_LIMIT) ?? return web_host_text(413, "browser trace envelope exceeds 512 bytes")
    if !web_host_queue_beacon(state, body.bytes()) -> return web_host_text(503, "browser trace inbox is full; retry")
    web_host_text(204, "")
}

web_host_devtools: fn(state: Shared<WebHostState>, request: HTTPRequest, path: String, query: String) -> HTTPResponse {
    if !web_host_authorized(state, request, path, query) -> return web_host_rejected()
    if path == "/__jet_devtools" && request.method == "POST" -> return web_host_ingest(state, request)
    if path == "/__jet_devtools/paused/inspect" || path == "/__jet_devtools/paused/evaluate" -> return web_host_text(409, "no paused debug session on this host")
    if path == "/__jet_devtools/commands" {
        if request.method != "GET" -> return web_host_text(405, "method not allowed")
        frame: web_host_take_commands(state) ?? return web_host_text(503, "the next devtools frame is being prepared; retry")
        if frame.status != 200 -> return web_host_text(frame.status, frame.body)
        return web_host_json(200, frame.body)
    }
    if path == "/__jet_devtools/assets" {
        if request.method != "GET" -> return web_host_text(405, "method not allowed")
        assets: web_host_take_assets(state) ?? return web_host_text(503, "the next devtools frame is being prepared; retry")
        return web_host_json(200, assets)
    }
    if path == "/__jet_devtools/recording" && request.method == "GET" && canvas_host_query(query, "sequence") == None && canvas_host_query(query, "timestamp_ms") == None {
        if web_host_is_release(state) -> return web_host_text(404, "recording endpoint absent in release builds")
        return web_host_json(200, web_host_recording(state))
    }
    if path == "/__jet_devtools" || path == "/__jet_devtools/workbench" {
        if request.method != "GET" -> return web_host_text(405, "method not allowed")
        placement: if path == "/__jet_devtools" -> BrowserPlacement.InApp else -> BrowserPlacement.Workbench
        return web_host_html(200, web_host_browser_page(state, placement))
    }
    if path == "/__jet_devtools/state" {
        if request.method != "GET" -> return web_host_text(405, "method not allowed")
        return web_host_json(200, web_host_browser_view(state))
    }
    if path == "/__jet_devtools/reconnect" {
        if request.method != "GET" -> return web_host_text(405, "method not allowed")
        cursor := Int?{None}
        if canvas_host_query(query, "cursor") == .Val(text) {
            value: Int.parse(text) ?? -1
            if value < 0 -> return web_host_text(400, "cursor must be a non-negative integer")
            cursor = Val(value)
        }
        body: web_host_browser_reconnect(state, cursor) ?? return web_host_text(409, "{err}")
        return web_host_json(200, body)
    }
    if path == "/__jet_devtools/action" {
        if request.method != "POST" -> return web_host_text(405, "method not allowed")
        payload: request.text(MAX_REQUEST_BODY_BYTES) ?? return web_host_text(400, "browser action body is unreadable: {err}")
        action: browser_web_parse_action(payload.bytes(), .InApp) ?? return web_host_text(400, "{err}")
        body: web_host_browser_dispatch(state, action) ?? return web_host_text(403, "{err}")
        return web_host_json(200, body)
    }
    if path == "/__jet_devtools/selection" {
        if request.method != "POST" -> return web_host_text(405, "method not allowed")
        payload: request.text(MAX_REQUEST_BODY_BYTES) ?? return web_host_text(400, "browser selection body is unreadable: {err}")
        selection: if browser_web_parse_selection(payload.bytes()) == {
            .Ok(chosen) -> chosen
            .Err(error) -> { return web_host_text(400, "{error}") }
        }
        answer: web_host_browser_select(state, payload, selection)
        if answer.status != 200 -> return web_host_text(answer.status, answer.body)
        return web_host_json(200, answer.body)
    }
    web_host_unserved(path)
}

// A jet.devtools.v1 envelope for this session; the dev clock ingests it.
web_host_ingest: fn(state: Shared<WebHostState>, request: HTTPRequest) -> HTTPResponse {
    payload: request.text(MAX_REQUEST_BODY_BYTES) ?? return web_host_text(400, "devtools envelope is unreadable: {err}")
    decoded: decode_devtools_envelope(payload) ?? return web_host_text(400, "{err}")
    if decoded.session_id() != web_host_session_id(state) -> return web_host_text(400, "jet.devtools.v1 envelope session identity mismatch")
    if !web_host_queue_envelope(state, decoded) -> return web_host_text(503, "devtools inbox is full; retry")
    web_host_text(202, "accepted")
}

web_host_browser_page: fn(state: Shared<WebHostState>, placement: BrowserPlacement) -> String {
    permit: state.guard_read()
    browser_web_render_page(permit.value.browser, placement)
}

web_host_browser_view: fn(state: Shared<WebHostState>) -> String {
    permit: state.guard_read()
    browser_web_view_json(permit.value.browser, .InApp)
}

// The retained browser events after `cursor`, with the session's reset and
// truncation facts.
web_host_browser_reconnect: fn(state: Shared<WebHostState>, cursor: Int?) -> String Err! {
    permit: state.guard_read()
    projection: permit.value.session.devtools_events_since(cursor)
    browser_web_reconnect_json(permit.value.browser, cursor, projection.reset, projection.truncation)
}

// A layout or navigation action changes only the browser view, not the
// session, so the handler applies it.
web_host_browser_dispatch: fn(state: Shared<WebHostState>, action: BrowserHostAction) -> String BrowserHostError! {
    permit := state.guard_edit()
    browser_web_dispatch(permit.value.browser, action)
}

// The view shows a selection at once; the tick applies it to the session.
// The panel must be one of the catalog's, and an item the panel no longer
// holds selects the panel alone.
web_host_browser_select: fn(state: Shared<WebHostState>, payload: String, selection: DevtoolsSelectionFact?) -> WebHostFrame {
    permit := state.guard_edit()
    if permit.value.selections.len() >= WEB_HOST_MAX_QUEUED -> return WebHostFrame{status: 503, body: "devtools selection inbox is full; retry"}
    if selection == .Val(chosen) {
        if permit.value.browser.host.panel(chosen.panel_id) == None -> return WebHostFrame{status: 400, body: "browser selection panel_id must match the canonical panel catalog"}
        node_id := String?{None}
        if chosen.item_key != "" && permit.value.browser.host.node_exists(chosen.panel_id, Val(chosen.item_key)) -> node_id = Val(chosen.item_key)
        if permit.value.browser.host.select(chosen.panel_id, node_id) == .Err(error) -> return WebHostFrame{status: 400, body: "{error}"}
    } else {
        permit.value.browser.host.clear_selection()
    }
    permit.value.selections.push("{payload}")
    WebHostFrame{status: 200, body: browser_web_view_json(permit.value.browser, .InApp)}
}

// The release inspect endpoint: absent unless the policy serves it read-only,
// and then only to its own host and origin with the deployment token.
web_host_release_inspect: fn(state: Shared<WebHostState>, request: HTTPRequest, path: String) -> HTTPResponse {
    permit: state.guard_read()
    web_host_release_answer(permit.value.policy, permit.value.facts.port, permit.value.session, request, path)
}

web_host_release_answer: fn(policy: JetReleaseDevtoolsPolicy, port: Int, session: ResidentDevSession, request: HTTPRequest, path: String) -> HTTPResponse {
    if path != "/__jet_devtools" || policy.endpoint != .ReadOnly -> return web_host_text(404, "inspect endpoint absent")
    if request.method != "GET" -> return web_host_text(405, "method not allowed")
    if !policy.deployment.enabled -> return web_host_text(404, "inspect endpoint disabled")
    host: request.header("host") ?? ""
    if !canvas_host_single_security_headers(request) || !canvas_host_host_allowed(host, WEB_HOST_BIND, port) -> return web_host_text(403, "inspect host rejected")
    if request.header("origin") == .Val(origin) {
        if !canvas_host_origin_allowed(origin, WEB_HOST_BIND, port) -> return web_host_text(403, "inspect origin rejected")
    }
    if !web_host_release_token(request, policy) -> return web_host_json(401, "{{\"error\":\"JET_INSPECT_TOKEN required\"}}")
    if request.header("transfer-encoding") != None || !canvas_host_body_empty(request) -> return web_host_text(400, "inspect endpoint accepts GET without a request body")
    projection: session.devtools_events_since(None)
    panels: session.devtools_panels(.BrowserInApp, JetDevtoolsPanelCapability.all()) ?? return web_host_text(500, "{err}")
    web_host_json(200, browser_web_release_json(projection, panels))
}

web_host_release_token: fn(request: HTTPRequest, policy: JetReleaseDevtoolsPolicy) -> Bool Never! {
    token: policy.deployment.token ?? return false
    authorization: request.header("authorization") ?? return false
    if !authorization.starts_with("Bearer ") -> return false
    canvas_host_same_secret(authorization.slice(7, authorization.len()), token)
}

// The session check: GET or POST with an exact body framing, this listener's
// own Host, its Origin (or none on a bootstrap page or a same-origin fetch),
// and the session secret as a Bearer token and/or one `session` query value,
// each compared in constant time.
web_host_authorized: fn(state: Shared<WebHostState>, request: HTTPRequest, path: String, query: String) -> Bool {
    method: request.method
    if method != "GET" && method != "POST" -> return false
    if request.header("transfer-encoding") != None -> return false
    if method == "POST" && request.header("content-length") == None -> return false
    if method == "GET" && !canvas_host_body_empty(request) -> return false
    if request.body_len() > MAX_REQUEST_BODY_BYTES -> return false
    if !canvas_host_single_security_headers(request) -> return false
    host_header: request.header("host") ?? return false
    permit: state.guard_read()
    secret: permit.value.secret
    port: permit.value.facts.port
    if secret == "" || !canvas_host_host_allowed(host_header, WEB_HOST_BIND, port) -> return false
    same_origin: (request.header("sec-fetch-site") ?? "").to_ascii_lower() == "same-origin"
    if request.header("origin") == {
        .Val(origin) -> {
            if !canvas_host_origin_allowed(origin, WEB_HOST_BIND, port) -> return false
        }
        .None -> {
            bootstrap: path == "/__jet_devtools" || path == "/__jet_devtools/workbench"
            if !bootstrap && !same_origin -> return false
        }
    }
    if canvas_host_session_count(query) > 1 -> return false
    from_query: canvas_host_query(query, "session")
    if request.header("authorization") == {
        .Val(authorization) -> {
            if !authorization.starts_with("Bearer ") -> return false
            if !canvas_host_same_secret(authorization.slice(7, authorization.len()), secret) -> return false
            if from_query == .Val(token) -> return canvas_host_same_secret(token, secret)
            true
        }
        .None -> {
            token: from_query ?? return false
            canvas_host_same_secret(token, secret)
        }
    }
}

web_host_rejected: fn() -> HTTPResponse Never! {
    web_host_text(401, "devserver session, host, or origin rejected")
}

// A route the Rust host answered that this host doesn't serve yet.
web_host_unserved: fn(path: String) -> HTTPResponse Never! {
    web_host_text(501, "`{path}` is not served by this jet dev host yet")
}

web_host_is_release: fn(state: Shared<WebHostState>) -> Bool {
    permit: state.guard_read()
    permit.value.is_release()
}

web_host_version: fn(state: Shared<WebHostState>) -> Int {
    permit: state.guard_read()
    permit.value.facts.version
}

web_host_status_json: fn(state: Shared<WebHostState>) -> String {
    permit: state.guard_read()
    permit.value.facts.json()
}

web_host_nonce: fn(state: Shared<WebHostState>) -> String {
    permit: state.guard_read()
    "{permit.value.nonce}"
}

web_host_session_id: fn(state: Shared<WebHostState>) -> String {
    permit: state.guard_read()
    "{permit.value.session_id}"
}

// The latest recording, kept fresh for a while after each ask.
web_host_recording: fn(state: Shared<WebHostState>) -> String {
    permit := state.guard_edit()
    permit.value.recording_ticks = WEB_HOST_RECORDING_TICKS
    "{permit.value.recording}"
}

web_host_take_commands: fn(state: Shared<WebHostState>) -> WebHostFrame? {
    permit := state.guard_edit()
    if permit.value.commands == .Val(frame) {
        taken: WebHostFrame{status: frame.status, body: "{frame.body}"}
        permit.value.commands = None
        return Val(taken)
    }
    None
}

web_host_take_assets: fn(state: Shared<WebHostState>) -> String? {
    permit := state.guard_edit()
    if permit.value.assets == .Val(frame) {
        taken: "{frame}"
        permit.value.assets = None
        return Val(taken)
    }
    None
}

// A page's client lease, or its clean drop.
web_host_queue_client: fn(state: Shared<WebHostState>, client: String, dropped: Bool) {
    if client == "" || client.len() > WEB_HOST_MAX_CLIENT_ID -> return
    permit := state.guard_edit()
    if dropped {
        if permit.value.dropped.len() < WEB_HOST_MAX_QUEUED -> permit.value.dropped.push("{client}")
        return
    }
    if permit.value.noted.len() < WEB_HOST_MAX_QUEUED -> permit.value.noted.push("{client}")
}

web_host_queue_beacon: fn(state: Shared<WebHostState>, &&body: [U8]) -> Bool {
    permit := state.guard_edit()
    if permit.value.beacons.len() >= WEB_HOST_MAX_QUEUED -> return false
    permit.value.beacons.push(body.move())
    true
}

web_host_queue_envelope: fn(state: Shared<WebHostState>, &&envelope: JetDevtoolsDecodedEnvelope) -> Bool {
    permit := state.guard_edit()
    if permit.value.envelopes.len() >= WEB_HOST_MAX_QUEUED -> return false
    permit.value.envelopes.push(envelope.move())
    true
}

// The verbose request log; the dev clock stamps and prints it.
web_host_note_request: fn(state: Shared<WebHostState>, method: String, path: String, status: Int) {
    permit := state.guard_edit()
    if !permit.value.verbose || permit.value.requests.len() >= WEB_HOST_MAX_QUEUED -> return
    permit.value.requests.push("{method}  {terminal_pad_end(path, 20)} {status}")
}
