fn web_stream_required_string(object: &[String:DataTree], key: String) -> Result<String, (String, String)> {
    return match object.get(key) {
        .Val(.Text(value)) if !value.is_empty() -> .Ok(value.clone())
        .Val(.Text(_)) -> .Err(web_stream_request_error(format("web stream `{}` must not be empty", key)))
        .Val(_) -> .Err(web_stream_request_error(format("web stream `{}` must be a string", key)))
        .None -> .Err(web_stream_request_error(format("web stream request has no `{}`", key)))
    }
}
