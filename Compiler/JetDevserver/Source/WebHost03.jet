// Rust: crates/jet-devserver/src/WebHost.rs:4365
// One thread per accepted connection, bounded by MAX_CONNECTION_THREADS.
fn serve_forever(listener: TcpListener, status: Arc<DevStatus>, debug_sessions: Arc<Canvas.DebugSessions>, session: Arc<ResidentDevSession>, canvas_file: String, listener_kind: ListenerKind, bind_host: String, session_secret: String, shutdown: Arc<AtomicBool>, static_root: OSPath, release_policy: ReleaseDevtoolsPolicy, browser_state: Arc<Mutex<browser_web_adapter.BrowserWebState?>>, paused_evaluate: Arc<Mutex<PausedEvaluateHost>>, terminal_style: Arc<TerminalStyleHostAdapter>) -> Unit {
    if listener.set_nonblocking(true).is_err() -> return
    active_connections :: Arc.new(AtomicUsize.new(0)) // GATE #4494: native atomic and thread substrate.
    while !shutdown.load(Ordering.SeqCst) {
        match listener.accept() {
            .Ok((stream, peer_addr)) -> {
                if !try_acquire_connection(&active_connections) { drop(^stream); continue }
                status :: Arc.clone(&status)
                debug_sessions :: Arc.clone(&debug_sessions)
                session :: Arc.clone(&session)
                canvas_file :: canvas_file.clone()
                bind_host :: bind_host.clone()
                session_secret :: session_secret.clone()
                static_root :: static_root.clone()
                release_policy :: release_policy.clone()
                browser_state :: Arc.clone(&browser_state)
                paused_evaluate :: Arc.clone(&paused_evaluate)
                terminal_style :: Arc.clone(&terminal_style)
                active_connections :: Arc.clone(&active_connections)
                _ :: thread.spawn(move () -> {
                    _ :: handle_connection_with_root_and_policy(^stream, &status, &debug_sessions, &session, canvas_file, listener_kind, bind_host, session_secret, &static_root, &browser_state, &paused_evaluate, &terminal_style, &release_policy, peer_addr)
                    _ :: active_connections.fetch_sub(1, Ordering.AcqRel)
                })
            }
            .Err(error) if error.kind() == ErrorKind.WouldBlock -> { _ :: wait_for_shutdown(&shutdown, Duration.from_millis(10)) }
            .Err(_) -> return
        }
    }
}
// Rust: crates/jet-devserver/src/WebHost.rs:4432
fn try_acquire_connection(active: &AtomicUsize) -> Bool {
    current := active.load(Ordering.Acquire) // GATE #4494
    loop {
        if current >= MAX_CONNECTION_THREADS -> return false
        match active.compare_exchange(current, current + 1, Ordering.AcqRel, Ordering.Acquire) {
            .Ok(_) -> return true
            .Err(next) -> current = next
        }
    }
}
// Rust: crates/jet-devserver/src/WebHost.rs:4504
fn handle_connection_with_root_and_policy(stream: TcpStream, status: &DevStatus, debug_sessions: &Canvas.DebugSessions, session: &ResidentDevSession, canvas_file: String, listener_kind: ListenerKind, bind_host: String, session_secret: String, static_root: &OSPath, browser_state: &Arc<Mutex<browser_web_adapter.BrowserWebState?>>, paused_evaluate: &Arc<Mutex<PausedEvaluateHost>>, terminal_style: &Arc<TerminalStyleHostAdapter>, release_policy: &ReleaseDevtoolsPolicy, peer_addr: SocketAddr) -> Result<Unit, Error> {
    deadline :: Instant.now() + REQUEST_DEADLINE
    stream := DeadlineStream.new(^stream, deadline)
    reader := BufReader.new(stream.try_clone()?)
    request :: Request.read(&reader)? ?? return .Ok(())
    method :: request.method.as_str()
    target :: request.target.as_str()
    body :: request.body.as_slice()
    path :: target.split('?').next().unwrap_or("/")
    if listener_kind == .Application && release_policy.is_release() && devtools_path(path) {
        return handle_release_devtools_request(&stream, &request, path, bind_host, session.application_port(), peer_addr, session, release_policy)
    }
    if requires_session_authorization(listener_kind, path) && !canvas_request_authorized(&request, target, bind_host, if listener_kind == .Canvas { session.canvas_port() } else { session.application_port() }, session_secret) -> return unauthorized(&stream)
    if method != "GET" && method != "POST" -> return write_response(&stream, "405 Method Not Allowed", "text/plain; charset=utf-8", b"jet dev's web server only handles GET and Canvas POST requests")
    // Source tools require Canvas authority even on the application origin.
    if listener_kind == .Application && source_tool_path(path) {
        if release_policy.is_release() -> return write_response(&stream, "404 Not Found", "text/plain; charset=utf-8", b"source tools are absent in release builds")
        if session.canvas_port() == 0 -> return write_response(&stream, "404 Not Found", "text/plain; charset=utf-8", browser_web_adapter.SOURCE_TOOLS_OFF_REASON.as_bytes())
    }
    if listener_kind == .Canvas {
        if query_param(target, "client_id") == .Val(client) -> session.note_client(client)
    }
    if listener_kind == .Application && !is_application_control_path(path) {
        if method != "GET" -> return method_not_allowed(&stream)
        started :: Instant.now()
        nonce :: status.browser_relay.lock().unwrap().as_ref().map((relay) -> relay.nonce().to_string()).unwrap_or_default()
        code :: serve_static_from_root(&stream, static_root, path, nonce, session_secret)?
        status.log_request(method, path, code, started.elapsed())
        return .Ok(())
    }
    if listener_kind == .Application && web_stream_path(path) -> return handle_web_stream_request(&stream, &request)
    if devtools_path(path) {
        if query_param(target, "client_id") == .Val(client) -> session.note_client(client)
        placement :: match path { "/__jet_devtools/workbench" -> BrowserHost.BrowserPlacement.Workbench; _ -> BrowserHost.BrowserPlacement.InApp }
        if method == "GET" && listener_kind == .Application && path is "/__jet_devtools" | "/__jet_devtools/workbench" {
            state := browser_state.lock().unwrap()
            return match browser_web_adapter.sync_session(&state, session) {
                .Ok(()) -> {
                    body :: browser_web_adapter.render_page(state.as_ref().expect("browser web state initialized"), placement)
                    write_response(&stream, "200 OK", "text/html; charset=utf-8", body.as_bytes())
                }
                .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/reconnect" && method == "GET" {
            cursor :: match query_param(target, "cursor") {
                .Val(value) -> match value.parse<U64>() {
                    .Ok(cursor) -> .Val(cursor)
                    .Err(_) -> return write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", b"cursor must be a non-negative integer")
                }
                .None -> .None
            }
            state := browser_state.lock().unwrap()
            return match browser_web_adapter.sync_session(&state, session) {
                .Ok(()) -> {
                    projection :: session.devtools_events_since(cursor)
                    state :: state.as_ref().expect("browser web state initialized")
                    match browser_web_adapter.reconnect_json(state, cursor, projection.reset, projection.truncation) {
                        .Ok(body) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                        .Err(error) -> write_response(&stream, "409 Conflict", "text/plain; charset=utf-8", error.as_bytes())
                    }
                }
                .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/state" && method == "GET" {
            state := browser_state.lock().unwrap()
            return match browser_web_adapter.sync_session(&state, session) {
                .Ok(()) -> {
                    body :: browser_web_adapter.view_json(state.as_ref().expect("browser web state initialized"), placement)
                    write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                }
                .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/swap" && method == "GET" {
            state := browser_state.lock().unwrap()
            return match browser_web_adapter.sync_session(&state, session) {
                .Ok(()) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", browser_web_adapter.swap_json(state.as_ref().expect("browser web state initialized")).as_bytes())
                .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/swap" && method == "POST" {
            state := browser_state.lock().unwrap()
            result :: browser_web_adapter.sync_session(&state, session).and_then((()) -> browser_web_adapter.record_dom_snapshot(&state, session.id(), body))
            return match result {
                .Ok(()) -> write_response(&stream, "204 No Content", "text/plain; charset=utf-8", b"")
                .Err(error) -> write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/recording" && release_policy.is_release() -> return write_response(&stream, "404 Not Found", "text/plain; charset=utf-8", b"recording endpoint absent in release builds")
        if path == "/__jet_devtools/recording" && method == "GET" {
            body :: if query_param(target, "sequence") == .Val(value) {
                sequence :: match value.parse<U64>() {
                    .Ok(sequence) -> sequence
                    .Err(_) -> return write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", b"sequence must be a non-negative integer")
                }
                session.recording_control(format("{{\"op\":\"scrub\",\"sequence\":{}}}", sequence))
            } else if query_param(target, "timestamp_ms") == .Val(value) {
                timestamp_ms :: match value.parse<U64>() {
                    .Ok(timestamp_ms) -> timestamp_ms
                    .Err(_) -> return write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", b"timestamp_ms must be a non-negative integer")
                }
                session.recording_control(format("{{\"op\":\"scrub_time\",\"timestamp_ms\":{}}}", timestamp_ms))
            } else { .Ok(session.recording_json()) }
            return match body {
                .Ok(body) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                .Err(error) -> write_response(&stream, "409 Conflict", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/recording" && method == "POST" {
            payload :: std.str.from_utf8(body).map_err((_) -> Error.new(ErrorKind.InvalidData, "recording control must be UTF-8 JSON"))? // GATE #4409
            return match session.recording_control(payload) {
                .Ok(body) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                .Err(error) -> write_response(&stream, "409 Conflict", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/action" && method == "POST" {
            action :: match browser_web_adapter.parse_action(body, placement) {
                .Ok(action) -> action
                .Err(error) -> return write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", error.as_bytes())
            }
            state := browser_state.lock().unwrap()
            return match browser_web_adapter.sync_session(&state, session) {
                .Ok(()) -> match browser_web_adapter.dispatch_action(state.as_mut().expect("browser web state initialized"), ^action) {
                    .Ok(body) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                    .Err(error) -> write_response(&stream, "403 Forbidden", "text/plain; charset=utf-8", error.to_string().as_bytes())
                }
                .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/commands" && method == "GET" {
            return match session.browser_game_control_frame() {
                .Ok(body) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/assets" && method == "GET" {
            return match session.browser_game_asset_frame() {
                .Ok(body) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if method == "GET" && path is "/__jet_devtools" | "/__jet_canvas/devtools" | "/canvas/devtools" | "/panel/devtools" {
            state := browser_state.lock().unwrap()
            return match browser_web_adapter.sync_session(&state, session) {
                .Ok(()) -> {
                    body :: browser_web_adapter.view_json(state.as_ref().expect("browser web state initialized"), placement)
                    write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                }
                .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools" && method == "POST" {
            payload :: std.str.from_utf8(body).map_err((_) -> Error.new(ErrorKind.InvalidData, "devtools event must be UTF-8"))?
            return match decode_devtools_envelope(payload).and_then((decoded) -> {
                session.ingest_devtools_envelope(^decoded)?
                session.dispatch_pending_database_explain().map((_) -> ())
            }) {
                .Ok(()) -> {
                    state := browser_state.lock().unwrap()
                    match browser_web_adapter.sync_session(&state, session) {
                        .Ok(()) -> {
                            body :: browser_web_adapter.view_json(state.as_ref().expect("browser web state initialized"), placement)
                            write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                        }
                        .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
                    }
                }
                .Err(error) -> write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/selection" && method == "POST" {
            selection :: match browser_web_adapter.parse_selection(body) {
                .Ok(selection) -> selection
                .Err(error) -> return write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", error.as_bytes())
            }
            if selection == .Val((panel_id, _)) {
                panels :: match session.devtools_panels(Devtools.JetDevtoolsHostKind.BrowserInApp, &Devtools.JetDevtoolsPanelCapability.ALL) {
                    .Ok(panels) -> panels
                    .Err(error) -> return write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.to_string().as_bytes())
                }
                if !panels.iter().any((panel) -> panel.availability.descriptor.id.as_str() == panel_id) -> return write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", b"browser selection panel_id must match the canonical panel catalog")
            }
            payload :: std.str.from_utf8(body).map_err((_) -> Error.new(ErrorKind.InvalidData, "devtools selection must be UTF-8"))?
            return match session.set_devtools_selection(payload) {
                .Ok(()) -> {
                    state := browser_state.lock().unwrap()
                    match browser_web_adapter.sync_session(&state, session) {
                        .Ok(()) -> {
                            body :: browser_web_adapter.view_json(state.as_ref().expect("browser web state initialized"), placement)
                            write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                        }
                        .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
                    }
                }
                .Err(error) -> write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/cursor" && method == "POST" {
            payload :: std.str.from_utf8(body).map_err((_) -> Error.new(ErrorKind.InvalidData, "devtools cursor must be UTF-8"))?
            return match session.set_devtools_cursor(payload) {
                .Ok(()) -> {
                    state := browser_state.lock().unwrap()
                    match browser_web_adapter.sync_session(&state, session) {
                        .Ok(()) -> {
                            body :: browser_web_adapter.view_json(state.as_ref().expect("browser web state initialized"), placement)
                            write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
                        }
                        .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
                    }
                }
                .Err(error) -> write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/error" && method == "GET" {
            facts :: status.web_error_facts()
            devtools_projection :: session.devtools_events_since(.None)
            request_id :: next_web_error_request_id()
            source_id :: devtools_projection.source_id.filter((value) -> !value.is_empty()).unwrap_or_else(() -> canvas_file.to_string())
            build_id :: devtools_projection.build_id.filter((value) -> !value.is_empty()).or_else(() -> {
                std.fs.read_to_string(static_root.join("web.manifest.json")).ok().and_then((manifest) -> browser_web_adapter.manifest_artifact_identity(manifest).ok())
            }) ?? return write_response(&stream, "404 Not Found", "text/plain; charset=utf-8", b"error identity unavailable")
            accept :: request.headers.get("accept").map((v) -> v.as_str()).unwrap_or("*/*")
            identity :: jet_devserver.WebErrorPage.WebErrorPageIdentity.new(^request_id, session.id(), source_id.clone(), ^build_id, devtools_projection.revision.clone()).map_err((error) -> Error.new(ErrorKind.InvalidData, error.to_string()))?
            rendered :: if !facts.is_error() { .Ok(.None) } else {
                source_excerpts :: Canvas.read_source_without_symlinks(OSPath.new(canvas_file)).ok().and_then((source) -> {
                    excerpt :: source.chars().take(jet_devserver.WebErrorPage.MAX_WEB_ERROR_SOURCE_BYTES).collect<String>()
                    jet_devserver.WebErrorPage.WebErrorSourceExcerpt.without_span(source_id.clone(), "failure source", .Val(^excerpt)).ok()
                }).into_iter().collect<[_]>()
                action_links :: [("Open devtools", "/__jet_devtools"), ("Reconnect", "/__jet_devtools/reconnect"), ("Open recording", "/__jet_devtools/recording")].into_iter().filter_map(((label, href)) -> jet_devserver.WebErrorPage.WebErrorActionLink.new(label, href).ok()).collect<[_]>()
                page :: if facts.is_internal_failure() {
                    jet_devserver.WebErrorPage.WebErrorPage.from_internal(^identity, facts.code.clone(), facts.diagnostic.clone(), ^action_links).and_then((page) -> page.with_source_excerpts(^source_excerpts))
                } else {
                    jet_devserver.WebErrorPage.WebErrorDiagnosticFact.from_dev_status(&facts).and_then((diagnostic) -> jet_devserver.WebErrorPage.WebErrorPage.new_with_status(500, ^identity, ^diagnostic, ^source_excerpts, .None, ^action_links))
                }
                page.and_then((page) -> page.project(accept, jet_devserver.WebErrorPage.WebErrorCapabilities.local()).map((p) -> .Val(^p))).map_err((error) -> error.to_string())
            }
            return match rendered {
                .Ok(.Val(projection)) -> {
                    status :: match projection.status {
                        200 -> "200 OK"; 400 -> "400 Bad Request"; 401 -> "401 Unauthorized"
                        403 -> "403 Forbidden"; 404 -> "404 Not Found"; 405 -> "405 Method Not Allowed"
                        409 -> "409 Conflict"; 413 -> "413 Payload Too Large"; 415 -> "415 Unsupported Media Type"
                        422 -> "422 Unprocessable Content"; 429 -> "429 Too Many Requests"
                        500 -> "500 Internal Server Error"; 501 -> "501 Not Implemented"; 502 -> "502 Bad Gateway"
                        503 -> "503 Service Unavailable"; 504 -> "504 Gateway Timeout"
                        _ if projection.status >= 400 && projection.status < 500 -> "400 Bad Request"
                        _ -> "500 Internal Server Error"
                    }
                    write_response(&stream, status, projection.content_type.as_str(), projection.body.as_bytes())
                }
                .Ok(.None) -> write_response(&stream, "204 No Content", "text/plain; charset=utf-8", b"")
                .Err(error) -> write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.as_bytes())
            }
        }
        if path == "/__jet_devtools/paused/inspect" && method == "POST" {
            payload :: std.str.from_utf8(body).map_err((_) -> Error.new(ErrorKind.InvalidData, "paused inspect body must be UTF-8"))?
            request :: match jet_devserver.PausedEvaluate.InspectRequest.from_json(payload) {
                .Ok(request) -> request
                .Err(error) -> {
                    error :: jet_devserver.PausedEvaluate.PausedEvaluateHostError.InvalidRequest(^error)
                    return write_response(&stream, paused_evaluate_error_status(&error), "application/json; charset=utf-8", error.json().as_bytes())
                }
            }
            host := paused_evaluate.lock().unwrap()
            adapter :: match debug_sessions.paused_adapter(&request.identity) {
                .Ok(adapter) -> adapter
                .Err(_) -> {
                    host.clear_session()
                    error :: jet_devserver.PausedEvaluate.PausedEvaluateHostError.SessionUnavailable
                    return write_response(&stream, paused_evaluate_error_status(&error), "application/json; charset=utf-8", error.json().as_bytes())
                }
            }
            if adapter.inject_into(&host).is_err() {
                host.clear_session()
                error :: jet_devserver.PausedEvaluate.PausedEvaluateHostError.SessionUnavailable
                return write_response(&stream, paused_evaluate_error_status(&error), "application/json; charset=utf-8", error.json().as_bytes())
            }
            return match host.handle_inspect(payload) {
                .Ok(json) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", json.as_bytes())
                .Err(error) -> write_response(&stream, paused_evaluate_error_status(&error), "application/json; charset=utf-8", error.json().as_bytes())
            }
        }
        if path == "/__jet_devtools/paused/evaluate" && method == "POST" {
            payload :: std.str.from_utf8(body).map_err((_) -> Error.new(ErrorKind.InvalidData, "paused evaluate body must be UTF-8"))?
            request :: match jet_devserver.PausedEvaluate.EvaluateRequest.from_json(payload) {
                .Ok(request) -> request
                .Err(error) -> {
                    error :: jet_devserver.PausedEvaluate.PausedEvaluateHostError.InvalidRequest(^error)
                    return write_response(&stream, paused_evaluate_error_status(&error), "application/json; charset=utf-8", error.json().as_bytes())
                }
            }
            host := paused_evaluate.lock().unwrap()
            adapter :: match debug_sessions.paused_adapter(&request.identity) {
                .Ok(adapter) -> adapter
                .Err(_) -> {
                    host.clear_session()
                    error :: jet_devserver.PausedEvaluate.PausedEvaluateHostError.SessionUnavailable
                    return write_response(&stream, paused_evaluate_error_status(&error), "application/json; charset=utf-8", error.json().as_bytes())
                }
            }
            if adapter.inject_into(&host).is_err() {
                host.clear_session()
                error :: jet_devserver.PausedEvaluate.PausedEvaluateHostError.SessionUnavailable
                return write_response(&stream, paused_evaluate_error_status(&error), "application/json; charset=utf-8", error.json().as_bytes())
            }
            host.set_evaluator_result(adapter.evaluate(&request))
            return match host.handle_evaluate(payload) {
                .Ok(json) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", json.as_bytes())
                .Err(error) -> write_response(&stream, paused_evaluate_error_status(&error), "application/json; charset=utf-8", error.json().as_bytes())
            }
        }
        if path == "/__jet_devtools/style" && method == "GET" {
            (_, event) :: terminal_style.current_json()
            return write_response(&stream, "200 OK", "application/json; charset=utf-8", event.as_bytes())
        }
        if path == "/__jet_devtools/style" && method == "POST" {
            payload :: std.str.from_utf8(body).map_err((_) -> Error.new(ErrorKind.InvalidData, "style request must be UTF-8"))?
            (_, event) :: terminal_style.apply_json(payload)
            return write_response(&stream, "200 OK", "application/json; charset=utf-8", event.as_bytes())
        }
        return method_not_allowed(&stream)
    }
    if path is "/__jet_canvas/session" | "/canvas/session" | "/panel/session" {
        client :: query_param(target, "client_id").unwrap_or_default()
        if !client.is_empty() -> session.note_client(client)
        if method == "GET" {
            body :: session_response(session)
            return write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
        }
        if method != "GET" -> return method_not_allowed(&stream)
        body :: session_response(session)
        return write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
    }
    if path == "/__jet_canvas/live" {
        if method != "GET" -> return method_not_allowed(&stream)
        pid :: query_param(target, "pid").and_then((value) -> value.parse<U32>().ok()).ok_or_else(() -> Error.new(ErrorKind.InvalidInput, "missing live pid"))?
        source_id :: query_param(target, "source_id").unwrap_or_default()
        return match jet_devserver.LiveInspect.read(pid) {
            .Ok(snapshot) -> {
                revision :: current_revision_for_source_id(canvas_file, (!source_id.is_empty()).then_some(source_id.as_str()))
                session.remember_last_good_view("runtime", source_id, revision, snapshot)
                write_response(&stream, "200 OK", "application/json; charset=utf-8", snapshot.as_bytes())
            }
            .Err(message) -> match session.last_good_view("runtime", source_id) {
                .Val((_revision, snapshot)) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", snapshot.as_bytes())
                .None -> write_response(&stream, "404 Not Found", "text/plain; charset=utf-8", message.as_bytes())
            }
        }
    }
    if jet_devserver.canvas_asset(method, target, path) == .Val(asset) {
        asset :: inject_canvas_session(^asset, session_secret)
        return write_response(&stream, asset.status, asset.content_type, asset.body.as_bytes())
    }
    if target == "/?jet_panel_graph=1" {
        if method != "GET" -> return method_not_allowed(&stream)
        return match Canvas.graph_json_for_file(OSPath.new(canvas_file)) {
            .Ok(body) -> {
                session.select_project_source_from_payload(body)
                source_id :: source_id_from_payload(body)
                revision :: current_revision_for_source_id(canvas_file, (!source_id.is_empty()).then_some(source_id.as_str()))
                session.remember_last_good_view("graph", source_id, revision, body)
                write_response(&stream, "200 OK", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            }
            .Err(diags) -> {
                body :: with_session(Canvas.graph_json_error_for_file(OSPath.new(canvas_file), &diags), session)
                write_response(&stream, "409 Conflict", "application/json; charset=utf-8", body.as_bytes())
            }
        }
    }
    if path is "/__jet_canvas/graph" | "/canvas/graph" | "/panel/graph" {
        if method != "GET" -> return method_not_allowed(&stream)
        source_id :: query_param(target, "source_id")
        graph :: match query_param(target, "pid") {
            .Val(pid) -> Canvas.graph_json_for_entry_source_with_live_pid(OSPath.new(canvas_file), source_id.as_ref(), pid.parse<U32>().unwrap_or(0))
            .None -> Canvas.graph_json_for_entry_source(OSPath.new(canvas_file), source_id.as_ref())
        }
        if source_id == .Val(id) -> session.select_project_source(id)
        return match graph {
            .Ok(body) -> {
                session.select_project_source_from_payload(body)
                source_id :: source_id.clone().unwrap_or_else(() -> source_id_from_payload(body))
                revision :: current_revision_for_source_id(canvas_file, (!source_id.is_empty()).then_some(source_id.as_str()))
                session.remember_last_good_view("graph", source_id, revision, body)
                write_response(&stream, "200 OK", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            }
            .Err(body) -> write_response(&stream, "409 Conflict", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
        }
    }
    if path is "/__jet_canvas/project" | "/canvas/project" | "/panel/project" {
        if method != "GET" -> return method_not_allowed(&stream)
        body :: with_session(Canvas.project_json_for_entry(OSPath.new(canvas_file)), session)
        return write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
    }
    if path is "/__jet_canvas/source-control" | "/canvas/source-control" | "/panel/source-control" {
        if method != "GET" -> return method_not_allowed(&stream)
        body :: with_session(Canvas.source_control_json_for_entry(OSPath.new(canvas_file)), session)
        return write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
    }
    if path is "/__jet_canvas/core-catalog" | "/canvas/core-catalog" | "/panel/core-catalog" {
        if method != "GET" -> return method_not_allowed(&stream)
        query :: query_param(target, "query").unwrap_or_default()
        return match Canvas.core_catalog_json_for_entry(OSPath.new(canvas_file), query) {
            .Ok(body) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            .Err(body) -> write_response(&stream, "409 Conflict", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
        }
    }
    if path is "/__jet_canvas/proof" | "/canvas/proof" | "/panel/proof" {
        if method != "GET" -> return method_not_allowed(&stream)
        source_id :: query_param(target, "source_id")
        receipt :: status.command_receipt()
        return match Canvas.proof_json_for_entry_with_receipt(OSPath.new(canvas_file), source_id.as_ref(), receipt.as_ref()) {
            .Ok(body) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            .Err(body) -> write_response(&stream, "409 Conflict", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
        }
    }
    if path is "/__jet_canvas/source" | "/canvas/source" | "/panel/source" {
        if method != "GET" -> return method_not_allowed(&stream)
        source_id :: query_param(target, "source_id")
        source_path :: source_id.as_ref().and_then((id) -> Canvas.project_path_for_source_id(OSPath.new(canvas_file), id)).unwrap_or_else(() -> OSPath.new(canvas_file))
        return match read_source_without_symlinks(&source_path) {
            .Ok(source) -> write_response(&stream, "200 OK", "text/plain; charset=utf-8", source.as_bytes())
            .Err(e) -> write_response(&stream, "404 Not Found", "text/plain; charset=utf-8", format("could not read Canvas source: {}", e).as_bytes())
        }
    }
    if path is "/__jet_canvas/command" | "/canvas/command" | "/panel/command" {
        if method != "POST" -> return method_not_allowed(&stream)
        request :: String.from_utf8_lossy(body)
        _transaction :: session.lock_source_transaction()
        return match Canvas.command_receipt_json_for_entry(OSPath.new(canvas_file), request) {
            .Ok(body) -> {
                status.record_command_receipt(body.clone())
                session.record_command(request)
                write_response(&stream, "200 OK", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            }
            .Err(body) -> write_response(&stream, "409 Conflict", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
        }
    }
    if path is "/__jet_canvas/transaction" | "/canvas/transaction" | "/panel/transaction" {
        if method != "POST" -> return method_not_allowed(&stream)
        request :: String.from_utf8_lossy(body)
        _transaction :: session.lock_source_transaction()
        return match Canvas.apply_transaction_json(OSPath.new(canvas_file), request) {
            .Ok(body) -> {
                _ :: status.version.fetch_add(1, Ordering.SeqCst)
                revision :: current_revision_for_request(canvas_file, request)
                session.accept_transaction(request, revision)
                write_response(&stream, "200 OK", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            }
            .Err(body) -> {
                revision :: current_revision_for_request(canvas_file, request)
                session.refuse_transaction(request, revision)
                write_response(&stream, "409 Conflict", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            }
        }
    }
    if path is "/__jet_canvas/project/transaction" | "/canvas/project/transaction" | "/panel/project/transaction" {
        if method != "POST" -> return method_not_allowed(&stream)
        request :: String.from_utf8_lossy(body)
        _transaction :: session.lock_source_transaction()
        return match Canvas.apply_project_transaction_json(OSPath.new(canvas_file), request) {
            .Ok(body) -> {
                _ :: status.version.fetch_add(1, Ordering.SeqCst)
                revision :: current_revision_for_request(canvas_file, request)
                session.accept_transaction(request, revision)
                write_response(&stream, "200 OK", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            }
            .Err(body) -> {
                revision :: current_revision_for_request(canvas_file, request)
                session.refuse_transaction(request, revision)
                write_response(&stream, "409 Conflict", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            }
        }
    }
    if path is "/__jet_canvas/query" | "/canvas/query" | "/panel/query" {
        if method != "POST" -> return method_not_allowed(&stream)
        request :: String.from_utf8_lossy(body)
        return match Canvas.query_json_for_entry(OSPath.new(canvas_file), request) {
            .Ok(body) -> write_response(&stream, "200 OK", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            .Err(body) -> write_response(&stream, "409 Conflict", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
        }
    }
    if path is "/__jet_canvas/debug" | "/canvas/debug" | "/panel/debug" {
        if method != "POST" -> return method_not_allowed(&stream)
        request :: String.from_utf8_lossy(body)
        paused_evaluate := match paused_evaluate.lock() {
            .Ok(host) -> host
            .Err(_) -> return write_response(&stream, "500 Internal Server Error", "text/plain; charset=utf-8", b"paused evaluate host unavailable")
        }
        return match Canvas.debug_session_json_for_entry_with_sessions_and_host(OSPath.new(canvas_file), request, debug_sessions, &paused_evaluate) {
            .Ok(body) -> {
                session.record_debug_response(request, body)
                write_response(&stream, "200 OK", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
            }
            .Err(body) -> write_response(&stream, "409 Conflict", "application/json; charset=utf-8", with_session(^body, session).as_bytes())
        }
    }
    if path == "/__jet_dev_version" {
        if method != "GET" -> return method_not_allowed(&stream)
        body :: status.version.load(Ordering.SeqCst).to_string()
        return write_response(&stream, "200 OK", "text/plain; charset=utf-8", body.as_bytes())
    }
    if path == "/__jet_dev_status" {
        if method != "GET" -> return method_not_allowed(&stream)
        status_authorized :: canvas_request_authorized(&request, target, bind_host, if listener_kind == .Canvas { session.canvas_port() } else { session.application_port() }, session_secret)
        if status_authorized {
            if query_param(target, "client") == .Val(client) { status.note_client(client); session.note_client(client) }
        }
        body :: status.json()
        return write_response(&stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
    }
    if path == "/__jet_dev_disconnect" {
        if method != "POST" -> return method_not_allowed(&stream)
        if query_param(target, "client") == .Val(client) { status.drop_client(client); session.drop_client(client) }
        return write_response(&stream, "200 OK", "text/plain; charset=utf-8", b"ok")
    }
    if path == "/__jet_perf_browser" {
        if method != "POST" -> return method_not_allowed(&stream)
        relay :: status.browser_relay.lock().unwrap()
        relay :: relay.as_ref() ?? return write_response(&stream, "503 Service Unavailable", "text/plain; charset=utf-8", b"browser trace relay unavailable")
        if query_param(target, "nonce") != .Val(relay.nonce()) -> return write_response(&stream, "403 Forbidden", "text/plain; charset=utf-8", b"stale or foreign browser trace session")
        return match relay.record(body) {
            .Ok(()) -> write_response(&stream, "204 No Content", "text/plain; charset=utf-8", b"")
            .Err(jet_devserver.BrowserTrace.RecordError.Oversized) -> write_response(&stream, "413 Payload Too Large", "text/plain; charset=utf-8", b"browser trace envelope exceeds 512 bytes")
            .Err(jet_devserver.BrowserTrace.RecordError.Malformed) -> write_response(&stream, "400 Bad Request", "text/plain; charset=utf-8", b"browser trace envelope is malformed")
            .Err(jet_devserver.BrowserTrace.RecordError.Unavailable) -> write_response(&stream, "503 Service Unavailable", "text/plain; charset=utf-8", b"browser trace relay unavailable")
        }
    }
    if listener_kind == .Canvas -> return write_response(&stream, "404 Not Found", "text/plain; charset=utf-8", b"Canvas control host does not serve program assets")
    // Page/asset GETs alone get a request-log line; polling noise is excluded.
    started :: Instant.now()
    nonce :: status.browser_relay.lock().unwrap().as_ref().map((relay) -> relay.nonce().to_string()).unwrap_or_default()
    code :: serve_static_from_root(&stream, static_root, path, nonce, session_secret)?
    status.log_request(method, path, code, started.elapsed())
    return .Ok(())
}

