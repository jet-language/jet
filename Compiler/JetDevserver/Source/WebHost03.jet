// Rust: crates/jet-devserver/src/WebHost.rs:3589
fn canvas_api_path(path: String, target: String) -> Bool {
    return path is "/__jet_canvas" | "/__jet_canvas/" | "/__jet_canvas/app.js"
        | "/__jet_canvas/session" | "/__jet_canvas/live" | "/__jet_canvas/graph"
        | "/__jet_canvas/project" | "/__jet_canvas/source-control" | "/__jet_canvas/core-catalog"
        | "/__jet_canvas/proof" | "/__jet_canvas/source" | "/__jet_canvas/command"
        | "/__jet_canvas/transaction" | "/__jet_canvas/project/transaction" | "/__jet_canvas/query" | "/__jet_canvas/debug"
        | "/canvas" | "/canvas/" | "/canvas/app.js" | "/canvas/session"
        | "/canvas/graph" | "/canvas/project" | "/canvas/source-control" | "/canvas/core-catalog"
        | "/canvas/proof" | "/canvas/source" | "/canvas/command" | "/canvas/transaction"
        | "/canvas/project/transaction" | "/canvas/query" | "/canvas/debug"
        | "/panel" | "/panel/" | "/panel/app.js" | "/panel/session" | "/panel/graph"
        | "/panel/project" | "/panel/source-control" | "/panel/core-catalog" | "/panel/proof"
        | "/panel/source" | "/panel/command" | "/panel/transaction" | "/panel/project/transaction"
        | "/panel/query" | "/panel/debug" | "/__jet_dev_version" | "/__jet_dev_status"
        | "/__jet_dev_disconnect" | "/__jet_perf_browser" | "/__jet_web/stream"
        || devtools_path(path)
        || (path == "/" && (query_param(target, "jet_panel") == .Val("1")
            || query_param(target, "jet_panel_app") == .Val("1")
            || query_param(target, "jet_panel_graph") == .Val("1")))
}
// Rust: crates/jet-devserver/src/WebHost.rs:3650
fn canvas_request_authorized(request: &Request, target: String, bind_host: String, port: U16, session_secret: String) -> Bool {
    if session_secret.is_empty() || !(request.method is "GET" | "POST")
        || request.body.len() > MAX_REQUEST_BODY_BYTES
        || request.headers.contains_key("transfer-encoding")
        || (request.method == "POST" && !request.headers.contains_key("content-length"))
        || (request.method == "GET" && !request.body.is_empty()) -> return false
    path :: target.split('?').next().unwrap_or("")
    if !canvas_api_path(path, target) -> return false
    host :: request.headers.get("host") ?? return false
    if !host_header_allowed(host, bind_host, port) -> return false
    origin :: request.headers.get("origin")
    same_origin :: request.headers.get("sec-fetch-site").is_some_and((site) -> site.eq_ignore_ascii_case("same-origin"))
    if origin == .Val(value) {
        if !origin_allowed(value, bind_host, port) -> return false
    } else if !canvas_bootstrap_path(path, target) && !same_origin -> return false
    authorization :: request.headers.get("authorization")
    query_session :: match unique_session_param(target) { .Ok(v) -> v; .Err(_) -> return false }
    session_valid :: match (authorization, query_session) {
        (.Val(auth), .Val(query)) -> auth.strip_prefix("Bearer ").is_some_and((token) -> constant_time_equal(token, session_secret)) && constant_time_equal(query, session_secret)
        (.Val(auth), .None) -> auth.strip_prefix("Bearer ").is_some_and((token) -> constant_time_equal(token, session_secret))
        (.None, .Val(query)) -> constant_time_equal(query, session_secret)
        (.None, .None) -> false
    }
    return session_valid && (origin.is_some() || canvas_bootstrap_path(path, target) || same_origin)
}
// Rust: crates/jet-devserver/src/WebHost.rs:3709
fn unique_session_param(target: String) -> Result<String?, Unit> {
    (_, query) :: target.split_once('?') ?? return .Ok(.None)
    found := false
    for part in query.split('&') {
        name :: part.split_once('=').map(((name, _)) -> name).unwrap_or(part)
        if name == "session" {
            if found -> return .Err(())
            found = true
        }
    }
    return .Ok(query_param(target, "session"))
}
// Rust: crates/jet-devserver/src/WebHost.rs:3726
fn canvas_bootstrap_path(path: String, target: String) -> Bool {
    return path is "/__jet_canvas" | "/__jet_canvas/" | "/__jet_canvas/app.js"
        | "/canvas" | "/canvas/" | "/canvas/app.js" | "/panel" | "/panel/" | "/panel/app.js"
        | "/__jet_devtools" | "/__jet_devtools/workbench"
        || target is "/?jet_panel=1" | "/?jet_panel_app=1"
}
// Rust: crates/jet-devserver/src/WebHost.rs:3743
fn requires_canvas_authorization(listener_kind: ListenerKind) -> Bool { listener_kind == .Canvas }
// Rust: crates/jet-devserver/src/WebHost.rs:3747
fn requires_session_authorization(listener_kind: ListenerKind, path: String) -> Bool {
    (path != "/__jet_dev_status" && requires_canvas_authorization(listener_kind))
        || (listener_kind == .Application && (devtools_path(path) || web_stream_path(path) || source_tool_path(path)))
}
// Rust: crates/jet-devserver/src/WebHost.rs:3753
fn host_header_allowed(value: String, bind_host: String, port: U16) -> Bool {
    trimmed := value.trim() // #4303
    value :: trimmed.to_ascii_lowercase()
    if value == format("{}:{}", url_host(bind_host), port).to_ascii_lowercase() -> return true
    if !is_loopback_host(bind_host) -> return false
    return ["localhost", "127.0.0.1", "[::1]"].iter().any((alias) -> value == format("{}:{}", alias, port))
}
// Rust: crates/jet-devserver/src/WebHost.rs:3766
fn origin_allowed(value: String, bind_host: String, port: U16) -> Bool {
    trimmed := value.trim() // #4303
    value :: trimmed.to_ascii_lowercase()
    expected :: format("http://{}:{}", url_host(bind_host), port).to_ascii_lowercase()
    if value == expected -> return true
    return is_loopback_host(bind_host) && ["localhost", "127.0.0.1", "[::1]"].iter().any((alias) -> value == format("http://{}:{}", alias, port))
}
// Rust: crates/jet-devserver/src/WebHost.rs:3778
fn constant_time_equal(left: String, right: String) -> Bool {
    left :: left.as_bytes()
    right :: right.as_bytes()
    difference := left.len() ^ right.len()
    for index in 0..left.len().max(right.len()) {
        difference |= (left.get(index).copied().unwrap_or(0) as USize) ^ (right.get(index).copied().unwrap_or(0) as USize)
    }
    return difference == 0
}
