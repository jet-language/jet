fn unauthorized(stream: &impl Write) -> Result<Unit, Error> {
    write_response(stream, "401 Unauthorized", "text/plain; charset=utf-8", b"devserver session, host, or origin rejected")
}
// Rust: crates/jet-devserver/src/WebHost.rs:4190
fn handle_release_devtools_request(stream: &impl Write, request: &Request, path: String, bind_host: String, port: U16, peer_addr: SocketAddr, session: &ResidentDevSession, policy: &ReleaseDevtoolsPolicy) -> Result<Unit, Error> {
    if path != "/__jet_devtools" || !policy.endpoint_enabled() -> return write_response(stream, "404 Not Found", "text/plain; charset=utf-8", b"inspect endpoint absent")
    if request.method != "GET" -> return method_not_allowed(stream)
    if !policy.deployment_enabled() -> return write_response(stream, "404 Not Found", "text/plain; charset=utf-8", b"inspect endpoint disabled")
    host :: request.headers.get("host") ?? return write_response(stream, "403 Forbidden", "text/plain; charset=utf-8", b"inspect host rejected")
    if !host_header_allowed(host, bind_host, port) -> return write_response(stream, "403 Forbidden", "text/plain; charset=utf-8", b"inspect host rejected")
    if request.headers.get("origin").is_some_and((origin) -> !origin_allowed(origin, bind_host, port)) -> return write_response(stream, "403 Forbidden", "text/plain; charset=utf-8", b"inspect origin rejected")
    expected_token :: policy.deployment.token() ?? return write_response(stream, "401 Unauthorized", "application/json; charset=utf-8", b"{\"error\":\"JET_INSPECT_TOKEN required\"}")
    token_valid :: request.headers.get("authorization").and_then((value) -> value.strip_prefix("Bearer ")).is_some_and((token) -> constant_time_equal(token, expected_token))
    if !token_valid -> return write_response(stream, "401 Unauthorized", "application/json; charset=utf-8", b"{\"error\":\"JET_INSPECT_TOKEN required\"}")
    if !policy.peer_allowed(peer_addr.ip()) -> return write_response(stream, "403 Forbidden", "application/json; charset=utf-8", b"{\"error\":\"inspect network address not allowed\"}")
    if !request.body.is_empty() || request.headers.contains_key("transfer-encoding") -> return write_response(stream, "400 Bad Request", "text/plain; charset=utf-8", b"inspect endpoint accepts GET without a request body")
    projection :: session.devtools_events_since(.None)
    panels :: match session.devtools_panels(Devtools.JetDevtoolsHostKind.BrowserInApp, &Devtools.JetDevtoolsPanelCapability.ALL) {
        .Ok(panels) -> panels
        .Err(error) -> return write_response(stream, "500 Internal Server Error", "text/plain; charset=utf-8", error.to_string().as_bytes())
    }
    body :: browser_web_adapter.release_json(&projection, &panels)
    return write_response(stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
}
// Rust: crates/jet-devserver/src/WebHost.rs:4308
enum ListenerKind { Canvas; Application }
// Rust: crates/jet-devserver/src/WebHost.rs:4314
struct DeadlineStream {
    stream: TcpStream
    deadline: Instant
}
impl DeadlineStream {
    // Rust: crates/jet-devserver/src/WebHost.rs:4320
    fn new(stream: TcpStream, deadline: Instant) -> Self { Self(stream: ^stream, deadline: deadline) }
    // Rust: crates/jet-devserver/src/WebHost.rs:4324
    fn try_clone(self: &Self) -> Result<Self, Error> { .Ok(Self.new(self.stream.try_clone()?, self.deadline)) }
    // Rust: crates/jet-devserver/src/WebHost.rs:4328
    fn remaining(self: &Self) -> Result<Duration, Error> {
        remaining :: self.deadline.saturating_duration_since(Instant.now()) // GATE #4494: monotonic clock.
        if remaining.is_zero() { .Err(Error.new(ErrorKind.TimedOut, "devserver request deadline exceeded")) } else { .Ok(remaining) }
    }
}
impl DeadlineStream.Read {
    // Rust: crates/jet-devserver/src/WebHost.rs:4342
