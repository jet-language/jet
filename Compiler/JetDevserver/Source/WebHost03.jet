// Rust: crates/jet-devserver/src/WebHost.rs:3890
fn web_stream_identity(object: &[String:DataTree], key: String) -> Result<web_stream_bridge.JetWebIslandIdentity, (String, String)> {
    identity :: web_stream_object(object, key)?
    island_id :: web_stream_required_string(&identity, "island_id")?
    source_id :: web_stream_required_string(&identity, "source_id")?
    build_id :: web_stream_required_string(&identity, "build_id")?
    revision :: web_stream_required_string(&identity, "revision")?
    return web_stream_bridge.JetWebIslandIdentity.new(^island_id, ^source_id, ^build_id, ^revision).map_err(web_stream_error)
}
