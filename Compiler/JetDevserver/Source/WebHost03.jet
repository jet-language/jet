// Rust: crates/jet-devserver/src/WebHost.rs:3988
fn handle_web_stream_request(stream: &impl Write, request: &Request) -> Result<Unit, Error> {
    if request.method != "POST" -> return method_not_allowed(stream)
    text :: match std.str.from_utf8(&request.body) { // GATE #4494: borrowed UTF-8 byte view.
        .Ok(text) -> text
        .Err(_) -> return write_response(stream, "400 Bad Request", "application/json; charset=utf-8", web_stream_failure_json("invalid_request", "web stream request must be UTF-8 JSON").as_bytes())
    }
    root :: match parse_json_with_limit(text, MAX_REQUEST_BODY_BYTES) {
        .Ok(root) -> root
        .Err(_) -> return write_response(stream, "400 Bad Request", "application/json; charset=utf-8", web_stream_failure_json("invalid_request", "web stream request is not bounded JSON").as_bytes())
    }
    object :: object_map(&root) ?? return write_response(stream, "400 Bad Request", "application/json; charset=utf-8", web_stream_failure_json("invalid_request", "web stream request must be an object").as_bytes())
    result: Result<String, (String, String)> :: (() -> {
        action :: web_stream_required_string(&object, "action")?
        return match action {
            "register" -> {
                boundary_id :: web_stream_required_string(&object, "boundary_id")?
                identity :: web_stream_identity(&object, "identity")?
                boundary :: web_stream_bridge.jet_web_stream_register(^boundary_id, ^identity).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"boundary_id\":{}", boundary.render_json())))
            }
            "begin" -> {
                boundary_id :: web_stream_boundary_id(&object, "boundary_id")?
                identity :: web_stream_identity(&object, "identity")?
                at_ns :: web_stream_required_u64(&object, "at_ns")?
                stream_id :: web_stream_bridge.jet_web_stream_begin(&boundary_id, ^identity, at_ns).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"stream_id\":{}", stream_id.render_json())))
            }
            "chunk" -> {
                stream_id :: web_stream_id(&object, "stream_id")?
                sequence :: web_stream_required_u64(&object, "sequence")?
                content :: web_stream_required_text(&object, "content")?
                is_final :: web_stream_required_bool(&object, "is_final")?
                at_ns :: web_stream_required_u64(&object, "at_ns")?
                receipt :: web_stream_bridge.jet_web_stream_chunk(&stream_id, sequence, ^content, is_final, at_ns).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"receipt\":{}", receipt.render_json())))
            }
            "commit" -> {
                stream_id :: web_stream_id(&object, "stream_id")?
                at_ns :: web_stream_required_u64(&object, "at_ns")?
                receipt :: web_stream_bridge.jet_web_stream_commit(&stream_id, at_ns).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"receipt\":{}", receipt.render_json())))
            }
            "fail" -> {
                stream_id :: web_stream_id(&object, "stream_id")?
                error :: web_stream_failure(&object)?
                at_ns :: web_stream_required_u64(&object, "at_ns")?
                receipt :: web_stream_bridge.jet_web_stream_fail(&stream_id, ^error, at_ns).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"receipt\":{}", receipt.render_json())))
            }
            "cancel" -> {
                stream_id :: web_stream_id(&object, "stream_id")?
                at_ns :: web_stream_required_u64(&object, "at_ns")?
                receipt :: web_stream_bridge.jet_web_stream_cancel(&stream_id, at_ns).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"receipt\":{}", receipt.render_json())))
            }
            "rollback" -> {
                stream_id :: web_stream_id(&object, "stream_id")?
                at_ns :: web_stream_required_u64(&object, "at_ns")?
                receipt :: web_stream_bridge.jet_web_stream_rollback(&stream_id, at_ns).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"receipt\":{}", receipt.render_json())))
            }
            "hydration_start" -> {
                stream_id :: web_stream_id(&object, "stream_id")?
                trigger :: web_stream_trigger(&object, "trigger")?
                started_at_ns :: web_stream_required_u64(&object, "started_at_ns")?
                receipt :: web_stream_bridge.jet_web_stream_hydration_start(&stream_id, trigger, started_at_ns).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"receipt\":{}", receipt.render_json())))
            }
            "hydration_complete" -> {
                stream_id :: web_stream_id(&object, "stream_id")?
                completed_at_ns :: web_stream_required_u64(&object, "completed_at_ns")?
                receipt :: web_stream_bridge.jet_web_stream_hydration_complete(&stream_id, completed_at_ns).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"receipt\":{}", receipt.render_json())))
            }
            "receipt" -> {
                boundary_id :: web_stream_boundary_id(&object, "boundary_id")?
                receipt :: web_stream_bridge.jet_web_stream_receipt_json(&boundary_id).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"receipt\":{}", receipt)))
            }
            "projection" -> {
                boundary_id :: web_stream_boundary_id(&object, "boundary_id")?
                target :: web_stream_target(&object, "target")?
                projection :: web_stream_bridge.jet_web_stream_projection_json(&boundary_id, target).map_err(web_stream_error)?
                .Ok(web_stream_success(action, format("\"projection\":{}", projection)))
            }
            _ -> .Err(web_stream_request_error(format("web stream action `{}` is not recognized", action)))
        }
    })()
    return match result {
        .Ok(body) -> write_response(stream, "200 OK", "application/json; charset=utf-8", body.as_bytes())
        .Err((code, message)) -> write_response(stream, "400 Bad Request", "application/json; charset=utf-8", web_stream_failure_json(code, message).as_bytes())
    }
}
