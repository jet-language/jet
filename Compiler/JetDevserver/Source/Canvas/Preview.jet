// Rust: crates/jet-devserver/src/Canvas/preview.rs:322
pub struct CanvasPreviewAuthority { loopback_only: Bool; capabilities: BTreeSet<String> }
impl CanvasPreviewAuthority {
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:328
    pub fn development() -> Self { Self.new(true) }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:335
    pub fn new(loopback_only: Bool) -> Self { Self { loopback_only: loopback_only, capabilities: BTreeSet.new() } }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:342
    pub fn loopback_only(&self) -> Bool { self.loopback_only }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:346
    pub fn capabilities(&self) -> Iterator<&String> { self.capabilities.iter() }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:350
    pub fn with_capability(self, capability: String) -> Self Err! CanvasPreviewError {
        preview_text(capability, "authority capability", 256)?
        self.capabilities.insert(capability)
        self
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:357
    pub fn allows_capability(&self, requested: String) -> Bool {
        self.capabilities.iter().any((held) -> held == requested || requested.strip_prefix(held).is_some_and((tail) -> tail.starts_with('.') || tail.starts_with(':') || tail.starts_with('/')))
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:366
    pub fn allows_effect(&self, effect: &CanvasPreviewEffect, loopback: Bool) -> Bool { (!self.loopback_only || loopback) && self.allows_capability(effect.capability()) }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:370
    pub fn attenuate(&self, capabilities: [String]) -> Self Err! CanvasPreviewError {
        narrowed := Self.new(self.loopback_only)
        for capability in capabilities {
            preview_text(capability, "authority capability", 256)?
            if !self.allows_capability(capability) -> throw .CapabilityDenied(capability)
            narrowed.capabilities.insert(capability)
        }
        narrowed
    }
}
