// Rust: crates/jet-devserver/src/Canvas/preview.rs:1460
pub struct CanvasPreviewRegistry { descriptors: [String:CanvasPreviewDescriptor]; contexts: [String:CanvasPreviewContext]; selected: BTreeSet<String> }
impl CanvasPreviewRegistry {
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1459
    pub fn default() -> Self { Self { descriptors: [:], contexts: [:], selected: BTreeSet.new() } }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1467
