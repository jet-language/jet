        if self.descriptors.contains_key(descriptor.name()) -> throw .DuplicatePreview(descriptor.name().to_string())
        self.descriptors.insert(descriptor.name().to_string(), descriptor)
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1493
    pub fn replace(&self, descriptor: CanvasPreviewDescriptor) -> Unit Err! CanvasPreviewError {
        descriptor.validate()?
        if !self.descriptors.contains_key(descriptor.name()) -> return self.insert(descriptor)
        self.descriptors.insert(descriptor.name().to_string(), descriptor)
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1503
    pub fn remove(&self, name: String) -> Unit Err! CanvasPreviewError {
        _ :: self.descriptors.remove(name).ok_or_else(() -> CanvasPreviewError.UnknownPreview(name.to_string()))?
        self.selected.remove(name)
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1511
    pub fn get(&self, name: String) -> CanvasPreviewDescriptor? { self.descriptors.get(name) }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1515
    pub fn descriptors(&self) -> Iterator<&CanvasPreviewDescriptor> {
        keys := self.descriptors.keys().collect(); keys.sort()
        keys.into_iter().map((key) -> &self.descriptors[key])
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1519
    pub fn len(&self) -> USize { self.descriptors.len() }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1523
    pub fn is_empty(&self) -> Bool { self.descriptors.is_empty() }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1527
    pub fn select(&self, name: String) -> Unit Err! CanvasPreviewError {
        if !self.descriptors.contains_key(name) -> throw .UnknownPreview(name.to_string())
        if self.selected.len() >= CANVAS_PREVIEW_MAX_SELECTED && !self.selected.contains(name) -> throw .TooManySelected
        self.selected.insert(name.to_string())
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1538
    pub fn select_many(&self, names: [String]) -> Unit Err! CanvasPreviewError {
        if names.len() > CANVAS_PREVIEW_MAX_SELECTED -> throw .TooManySelected
        for name in names -> if !self.descriptors.contains_key(name) -> throw .UnknownPreview(name.clone())
        self.selected.clear(); self.selected.extend(names)
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1556
    pub fn clear_selection(&self) -> Unit { self.selected.clear() }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1560
    pub fn selected_names(&self) -> [String] { self.selected.iter().cloned().collect() }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1564
    fn selected_len(&self) -> USize { self.selected.len() }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1568
    fn is_selected(&self, name: String) -> Bool { self.selected.contains(name) }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1572
    pub fn insert_context(&self, context: CanvasPreviewContext) -> Unit Err! CanvasPreviewError {
        if self.contexts.len() >= CANVAS_PREVIEW_MAX_CONTEXTS -> throw .TooManyContexts
        if self.contexts.contains_key(context.id) -> throw .DuplicateContext(context.id)
        context.source.validate()?
        self.contexts.insert(context.id.clone(), context)
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1584
    pub fn context(&self, id: String) -> CanvasPreviewContext? { self.contexts.get(id) }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1588
    fn contexts_len(&self) -> USize { self.contexts.len() }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1592
    pub fn validate(&self) -> Unit Err! CanvasPreviewError {
        for descriptor in self.descriptors() {
            descriptor.validate()?
            if descriptor.context_id() == .Val(context_id) {
                context := self.contexts.get(context_id).ok_or_else(() -> CanvasPreviewError.UnknownContext(context_id.to_string()))?
                if context.source != descriptor.source() -> throw .ContextSourceMismatch
            }
        }
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1608
    pub fn to_json(&self) -> String {
        descriptors := self.descriptors().map((descriptor) -> {
            "{{\"name\":\"{preview_json_escape(descriptor.name())}\",\"kind\":\"{descriptor.kind().as_str()}\",\"callback\":\"{preview_json_escape(descriptor.callback().id)}\",\"source\":{preview_source_json(descriptor.source())},\"viewport\":{{\"device\":\"{preview_json_escape(descriptor.viewport().device.as_str())}\",\"width\":{descriptor.viewport().width},\"height\":{descriptor.viewport().height},\"scale\":{descriptor.viewport().scale}}},\"selected\":{self.selected.contains(descriptor.name())}}}"
        }).collect().join(",")
        selected := self.selected.iter().map((name) -> "\"{preview_json_escape(name)}\"").collect().join(",")
        "{{\"schema_version\":{CANVAS_PREVIEW_SCHEMA_VERSION},\"selected\":[{selected}],\"contexts\":{self.contexts.len()},\"descriptors\":[{descriptors}]}}"
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1641
    fn clear(&self) -> Unit { self.descriptors.clear(); self.contexts.clear(); self.selected.clear() }
}
// Rust: crates/jet-devserver/src/Canvas/preview.rs:1649
#Error
pub enum CanvasPreviewError {
    InvalidText { field: String, reason: String }; InvalidSource(String); InvalidViewport(String); InvalidInput(String)
    InvalidPolicy; TooManyPreviews; TooManySelected; TooManyContexts; TooManyInputs
    DuplicatePreview(String); UnknownPreview(String); DuplicateContext(String); UnknownContext(String); DuplicateInput(String)
    InputBudgetExceeded; AuthorityWidened; AuthorityRequired; CapabilityDenied(String); EffectSetMismatch
    LoopbackRequired; Unauthorized; TooManyClients; StaleConnection; InvalidCursor; FrameTooLarge
    ResidentBudgetExceeded; SourceMismatch; ContextSourceMismatch; RenderFailed; SessionClosed
}
impl CanvasPreviewError {
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:1683
    pub fn to_string(&self) -> String {
        match self {
            .InvalidText { field, reason } -> "invalid {field}: {reason}"
            .InvalidSource(reason) -> "invalid preview source: {reason}"
            .InvalidViewport(reason) -> "invalid preview viewport: {reason}"
            .InvalidInput(reason) -> "invalid preview input: {reason}"
            .InvalidPolicy -> "preview policy exceeds the bounded session contract"
            .TooManyPreviews -> "preview registry is full"
            .TooManySelected -> "preview selection exceeds the bounded limit"
            .TooManyContexts -> "preview context registry is full"
            .TooManyInputs -> "preview input overrides exceed the bounded limit"
            .DuplicatePreview(name) -> "preview `{name}` is duplicated"
            .UnknownPreview(name) -> "unknown preview `{name}`"
            .DuplicateContext(id) -> "preview context `{id}` is duplicated"
            .UnknownContext(id) -> "unknown preview context `{id}`"
            .DuplicateInput(name) -> "preview input `{name}` is duplicated"
            .InputBudgetExceeded -> "preview input budget exceeded"
            .AuthorityWidened -> "preview authority widens the session authority"
            .AuthorityRequired -> "preview effects require an authorized connection"
            .CapabilityDenied(capability) -> "preview capability `{capability}` is denied"
            .EffectSetMismatch -> "requested preview effects do not match the checked declaration"
            .LoopbackRequired -> "preview session requires a loopback connection"
            .Unauthorized -> "preview session authorization failed"
            .TooManyClients -> "preview session client limit reached"
            .StaleConnection -> "preview connection is stale; reconnect and resync"
            .InvalidCursor -> "preview cursor is outside the session history"
            .FrameTooLarge -> "preview frame exceeds the bounded frame limit"
            .ResidentBudgetExceeded -> "preview resident frame budget exceeded"
            .SourceMismatch -> "preview frame source identity does not match the checked declaration"
            .ContextSourceMismatch -> "preview context source identity does not match the checked declaration"
            .RenderFailed -> "preview callback failed; the last-good frame remains visible as stale"
            .SessionClosed -> "preview session is closed"
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/preview.rs:1721
fn preview_text(value: String, field: String, max_bytes: USize) -> Unit Err! CanvasPreviewError {
    trimmed := value.trim() // #4303
    if trimmed.is_empty() -> throw .InvalidText { field: field, reason: "must not be empty" }
    if value.len() > max_bytes -> throw .InvalidText { field: field, reason: "exceeds the bounded text size" }
    if value.chars().any((ch) -> ch.is_control()) -> throw .InvalidText { field: field, reason: "must not contain control characters" }
}
// Rust: crates/jet-devserver/src/Canvas/preview.rs:1743
fn preview_source_json(source: &CanvasPreviewSourceIdentity) -> String {
    "{{\"source_id\":\"{preview_json_escape(source.source_id)}\",\"build_id\":\"{preview_json_escape(source.build_id)}\",\"revision\":\"{preview_json_escape(source.revision)}\",\"span\":{{\"source_id\":\"{preview_json_escape(source.span.source_id)}\",\"file\":\"{preview_json_escape(source.span.file)}\",\"start_line\":{source.span.start_line},\"start_column\":{source.span.start_column},\"end_line\":{source.span.end_line},\"end_column\":{source.span.end_column}}}}}"
}
// Rust: crates/jet-devserver/src/Canvas/preview.rs:1758
fn constant_time_equal(left: String, right: String) -> Bool {
    difference := left.len() ^ right.len()
    width := left.len().max(right.len())
    for index in 0..width {
        left_byte := left.as_bytes().get(index).copied().unwrap_or(0)
        right_byte := right.as_bytes().get(index).copied().unwrap_or(0)
        difference |= (left_byte ^ right_byte) as USize
    }
    difference == 0
}
// Rust: crates/jet-devserver/src/Canvas/preview.rs:1769
fn connection_is_loopback(lease: PreviewClientLease?) -> Bool { lease.is_some_and((lease) -> lease.loopback) }
