// Rust: crates/jet-devserver/src/Canvas/preview.rs:116
pub struct CanvasPreviewViewport { pub device: CanvasPreviewDevice; pub width: U32; pub height: U32; pub scale: U16 }
impl CanvasPreviewViewport {
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:124
    pub fn new(device: CanvasPreviewDevice, width: U32, height: U32, scale: U16) -> Self Err! CanvasPreviewError {
        viewport := Self { device: device, width: width, height: height, scale: scale }
        viewport.validate()?
        viewport
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:140
    pub fn phone() -> Self { Self { device: .Phone, width: 390, height: 844, scale: 2 } }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:149
    pub fn tablet() -> Self { Self { device: .Tablet, width: 834, height: 1_119, scale: 2 } }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:158
    pub fn desktop() -> Self { Self { device: .Desktop, width: 1_280, height: 800, scale: 1 } }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:167
    pub fn validate(&self) -> Unit Err! CanvasPreviewError {
        if self.width == 0 || self.height == 0 -> throw .InvalidViewport("viewport dimensions must be positive")
        if self.width > CANVAS_PREVIEW_MAX_DIMENSION || self.height > CANVAS_PREVIEW_MAX_DIMENSION -> throw .InvalidViewport("viewport dimension exceeds the preview bound")
        if self.scale == 0 || self.scale > CANVAS_PREVIEW_MAX_SCALE -> throw .InvalidViewport("viewport scale is outside the preview bound")
        if self.device == .Custom(name) -> preview_text(name, "viewport device", 128)?
    }
}
