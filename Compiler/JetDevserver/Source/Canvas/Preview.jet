// Rust: crates/jet-devserver/src/Canvas/preview.rs:442
pub struct CanvasPreviewContext { pub id: String; pub source: CanvasPreviewSourceIdentity; values: [String:CanvasPreviewInput]; resident_bytes: USize }
impl CanvasPreviewContext {
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:449
    pub fn new(id: String, source: CanvasPreviewSourceIdentity, values: [CanvasPreviewInputOverride]) -> Self Err! CanvasPreviewError {
        preview_text(id, "preview context id", 256)?
        source.validate()?
        context := Self { id: id, source: source, values: [:], resident_bytes: 0 }
        for value in values {
            value.validate()?
            if context.values.len() >= CANVAS_PREVIEW_MAX_INPUTS -> throw .TooManyInputs
            if context.values.contains_key(value.name) -> throw .DuplicateInput(value.name)
            context.resident_bytes = context.resident_bytes.saturating_add(value.name.len()).saturating_add(value.value.encoded_len())
            if context.resident_bytes > CANVAS_PREVIEW_MAX_INPUT_BYTES -> throw .InputBudgetExceeded
            context.values.insert(value.name, value.value)
        }
        context
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:486
    pub fn values(&self) -> &[String:CanvasPreviewInput] { &self.values }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:490
    pub fn resident_bytes(&self) -> USize { self.resident_bytes }
}
