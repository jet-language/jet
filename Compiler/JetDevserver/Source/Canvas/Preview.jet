    // Rust: crates/jet-devserver/src/Canvas/preview.rs:607
    pub fn set_authority(&self, authority: CanvasPreviewAuthority) -> Unit { self.authority = authority }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:611
    pub fn add_effect(&self, effect: CanvasPreviewEffect) -> Unit Err! CanvasPreviewError { effect.validate()?; self.effects.insert(effect) }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:617
    pub fn set_input(&self, input: CanvasPreviewInputOverride) -> Unit Err! CanvasPreviewError {
        input.validate()?
        if self.inputs.len() >= CANVAS_PREVIEW_MAX_INPUTS && !self.inputs.contains_key(input.name) -> throw .TooManyInputs
        self.inputs.insert(input.name, input.value)
    }
    // Rust: crates/jet-devserver/src/Canvas/preview.rs:626
    pub fn validate(&self) -> Unit Err! CanvasPreviewError {
