// Bounded source-identified preview/playground host; rendering stays with Canvas.
use {
    time: core.time
    jet_foundation.[JetDevtoolsSourceSpan, foundation_json_escape, jettrace_has_control]
}

CANVAS_PREVIEW_SCHEMA_VERSION: Int{1}
CANVAS_PREVIEW_MAX_PREVIEWS: Int{64}
CANVAS_PREVIEW_MAX_SELECTED: Int{16}
CANVAS_PREVIEW_MAX_CONTEXTS: Int{16}
CANVAS_PREVIEW_MAX_INPUTS: Int{32}
CANVAS_PREVIEW_MAX_INPUT_BYTES: Int{16384}
CANVAS_PREVIEW_MAX_TEXT_BYTES: Int{16384}
CANVAS_PREVIEW_MAX_DIAGNOSTIC_BYTES: Int{16384}
CANVAS_PREVIEW_MAX_FRAME_BYTES: Int{4194304}
CANVAS_PREVIEW_MAX_RESIDENT_BYTES: Int{16777216}
CANVAS_PREVIEW_MAX_CLIENTS: Int{16}
CANVAS_PREVIEW_CLIENT_IDLE_SECS: Int{60}
CANVAS_PREVIEW_MAX_DIMENSION: Int{16384}
CANVAS_PREVIEW_MAX_SCALE: Int{8}

// A preview's checked declaration: the span's source must be the preview's own source.
CanvasPreviewSourceIdentity: struct {
    source_id: String
    build_id: String
    revision: String
    span: JetDevtoolsSourceSpan
}
impl CanvasPreviewSourceIdentity {
    validate: fn(self) CanvasPreviewError! {
        preview_text(self.source_id, "source id", CANVAS_PREVIEW_MAX_TEXT_BYTES)
        preview_text(self.build_id, "build id", CANVAS_PREVIEW_MAX_TEXT_BYTES)
        preview_text(self.revision, "revision", CANVAS_PREVIEW_MAX_TEXT_BYTES)
        if self.span.validate() == .Err(_) -> return Err(CanvasPreviewError.InvalidSource(reason: "source span is invalid"))
        if self.span.source_id != self.source_id -> return Err(CanvasPreviewError.InvalidSource(reason: "source span identity does not match preview source"))
    }
    to_json: fn(self) -> String {
        span: self.span
        "{{\"source_id\":\"{foundation_json_escape(self.source_id)}\",\"build_id\":\"{foundation_json_escape(self.build_id)}\",\"revision\":\"{foundation_json_escape(self.revision)}\",\"span\":{{\"source_id\":\"{foundation_json_escape(span.source_id)}\",\"file\":\"{foundation_json_escape(span.file)}\",\"start_line\":{span.start_line},\"start_column\":{span.start_column},\"end_line\":{span.end_line},\"end_column\":{span.end_column}}}}}"
    }
}

CanvasPreviewKind: enum {
    Preview
    Playground
}
impl CanvasPreviewKind {
    as_str: fn(self) -> String {
        if self == {
            .Preview -> "preview"
            .Playground -> "playground"
        }
    }
}

CanvasPreviewDevice: enum {
    Phone
    Tablet
    Desktop
    Custom(name: String)
}
impl CanvasPreviewDevice {
    as_str: fn(self) -> String {
        if self == {
            .Phone -> "phone"
            .Tablet -> "tablet"
            .Desktop -> "desktop"
            .Custom(name) -> name
        }
    }
}

CanvasPreviewViewport: struct {
    device: CanvasPreviewDevice
    width: Int
    height: Int
    scale: Int
}
impl CanvasPreviewViewport {
    new: fn(device: CanvasPreviewDevice, width: Int, height: Int, scale: Int) -> CanvasPreviewViewport CanvasPreviewError! {
        viewport: CanvasPreviewViewport{device: device, width: width, height: height, scale: scale}
        viewport.validate()
        viewport
    }
    phone: fn() -> CanvasPreviewViewport { CanvasPreviewViewport{device: .Phone, width: 390, height: 844, scale: 2} }
    tablet: fn() -> CanvasPreviewViewport { CanvasPreviewViewport{device: .Tablet, width: 834, height: 1119, scale: 2} }
    desktop: fn() -> CanvasPreviewViewport { CanvasPreviewViewport{device: .Desktop, width: 1280, height: 800, scale: 1} }
    validate: fn(self) CanvasPreviewError! {
        if self.width <= 0 || self.height <= 0 -> return Err(CanvasPreviewError.InvalidViewport(reason: "viewport dimensions must be positive"))
        if self.width > CANVAS_PREVIEW_MAX_DIMENSION || self.height > CANVAS_PREVIEW_MAX_DIMENSION -> return Err(CanvasPreviewError.InvalidViewport(reason: "viewport dimension exceeds the preview bound"))
        if self.scale <= 0 || self.scale > CANVAS_PREVIEW_MAX_SCALE -> return Err(CanvasPreviewError.InvalidViewport(reason: "viewport scale is outside the preview bound"))
        if self.device == .Custom(name) -> preview_text(name, "viewport device", 128)
    }
}

CanvasPreviewTheme: enum {
    System
    Light
    Dark
    HighContrast
    Custom(name: String)
}
impl CanvasPreviewTheme {
    as_str: fn(self) -> String {
        if self == {
            .System -> "system"
            .Light -> "light"
            .Dark -> "dark"
            .HighContrast -> "high-contrast"
            .Custom(name) -> name
        }
    }
}

CanvasPreviewAccessibility: enum {
    Default
    ReducedMotion
    LargeText
    HighContrast
    ScreenReader
    Custom(name: String)
}
impl CanvasPreviewAccessibility {
    as_str: fn(self) -> String {
        if self == {
            .Default -> "default"
            .ReducedMotion -> "reduced-motion"
            .LargeText -> "large-text"
            .HighContrast -> "high-contrast"
            .ScreenReader -> "screen-reader"
            .Custom(name) -> name
        }
    }
}

CanvasPreviewLifecycle: enum {
    Initial
    Loading
    Loaded
    Empty
    Error
    Offline
    Custom(name: String)
}
impl CanvasPreviewLifecycle {
    as_str: fn(self) -> String {
        if self == {
            .Initial -> "initial"
            .Loading -> "loading"
            .Loaded -> "loaded"
            .Empty -> "empty"
            .Error -> "error"
            .Offline -> "offline"
            .Custom(name) -> name
        }
    }
}

CanvasPreviewTraits: struct {
    theme: CanvasPreviewTheme
    locale: String
    accessibility: CanvasPreviewAccessibility
    lifecycle: CanvasPreviewLifecycle
}
impl CanvasPreviewTraits {
    default: fn() -> CanvasPreviewTraits { CanvasPreviewTraits{theme: .System, locale: "en-US", accessibility: .Default, lifecycle: .Initial} }
    validate: fn(self) CanvasPreviewError! {
        preview_text(self.locale, "locale", 128)
        preview_text(self.theme.as_str(), "theme", 128)
        preview_text(self.accessibility.as_str(), "accessibility", 128)
        preview_text(self.lifecycle.as_str(), "lifecycle", 128)
    }
}

CanvasPreviewEffect: enum {
    Read(capability: String)
    Write(capability: String)
    Network(capability: String)
    Clock
    Custom(capability: String)
}
impl CanvasPreviewEffect {
    capability: fn(self) -> String {
        if self == {
            .Read(capability) -> capability
            .Write(capability) -> capability
            .Network(capability) -> capability
            .Clock -> "Clock.Read"
            .Custom(capability) -> capability
        }
    }
    // Effect sets order by variant, then capability.
    order_key: fn(self) -> String {
        rank: if self == {
            .Read(_) -> 0
            .Write(_) -> 1
            .Network(_) -> 2
            .Clock -> 3
            .Custom(_) -> 4
        }
        "{rank}:{self.capability()}"
    }
    validate: fn(self) CanvasPreviewError! { preview_text(self.capability(), "preview effect", 256) }
}

CanvasPreviewAuthority: struct {
    loopback_only: Bool
    // Sorted and unique.
    capabilities: [String]
}
impl CanvasPreviewAuthority {
    development: fn() -> CanvasPreviewAuthority { CanvasPreviewAuthority.new(true) }
    new: fn(loopback_only: Bool) -> CanvasPreviewAuthority { CanvasPreviewAuthority{loopback_only: loopback_only, capabilities: [String]{}} }
    with_capability: fn(self, capability: String) -> CanvasPreviewAuthority CanvasPreviewError! {
        preview_text(capability, "authority capability", 256)
        widened := self
        preview_insert_sorted(widened.capabilities, capability)
        widened
    }
    // A held capability also grants its `.`, `:` and `/` sub-capabilities.
    allows_capability: fn(self, requested: String) -> Bool {
        loop held in self.capabilities {
            if requested == held -> return true
            if requested.starts_with("{held}.") || requested.starts_with("{held}:") || requested.starts_with("{held}/") -> return true
        }
        false
    }
    allows_effect: fn(self, requested: CanvasPreviewEffect, loopback: Bool) -> Bool { (!self.loopback_only || loopback) && self.allows_capability(requested.capability()) }
    attenuate: fn(self, capabilities: [String]) -> CanvasPreviewAuthority CanvasPreviewError! {
        narrowed := CanvasPreviewAuthority.new(self.loopback_only)
        loop capability in capabilities {
            preview_text(capability, "authority capability", 256)
            if !self.allows_capability(capability) -> return Err(CanvasPreviewError.CapabilityDenied(capability: capability))
            preview_insert_sorted(narrowed.capabilities, capability)
        }
        narrowed
    }
}

CanvasPreviewInput: enum {
    Text(value: String)
    Bool(value: Bool)
    Integer(value: Int)
    Float(value: Float)
}
impl CanvasPreviewInput {
    validate: fn(self) CanvasPreviewError! {
        if self == .Text(value) -> preview_text(value, "preview input", CANVAS_PREVIEW_MAX_INPUT_BYTES)
        if self == .Float(value) {
            if !value.is_finite() -> return Err(CanvasPreviewError.InvalidInput(reason: "preview float input must be finite"))
        }
    }
    encoded_len: fn(self) -> Int {
        if self == {
            .Text(value) -> value.bytes().len()
            .Bool(_) -> 1
            .Integer(_) -> 8
            .Float(_) -> 8
        }
    }
}

CanvasPreviewInputOverride: struct {
    name: String
    value: CanvasPreviewInput
}
impl CanvasPreviewInputOverride {
    new: fn(name: String, value: CanvasPreviewInput) -> CanvasPreviewInputOverride CanvasPreviewError! {
        input: CanvasPreviewInputOverride{name: name, value: value}
        input.validate()
        input
    }
    validate: fn(self) CanvasPreviewError! {
        preview_text(self.name, "preview input name", 256)
        self.value.validate()
    }
}

CanvasPreviewContext: struct {
    id: String
    source: CanvasPreviewSourceIdentity
    values: [String: CanvasPreviewInput]
    resident_bytes: Int
}
impl CanvasPreviewContext {
    new: fn(id: String, source: CanvasPreviewSourceIdentity, values: [CanvasPreviewInputOverride]) -> CanvasPreviewContext CanvasPreviewError! {
        preview_text(id, "preview context id", 256)
        source.validate()
        context := CanvasPreviewContext{id: id, source: source, values: [String: CanvasPreviewInput]{}, resident_bytes: 0}
        loop value in values {
            value.validate()
            if context.values.len() >= CANVAS_PREVIEW_MAX_INPUTS -> return Err(CanvasPreviewError.TooManyInputs)
            if context.values.has_key(value.name) -> return Err(CanvasPreviewError.DuplicateInput(name: value.name))
            context.resident_bytes += value.name.bytes().len() + value.value.encoded_len()
            if context.resident_bytes > CANVAS_PREVIEW_MAX_INPUT_BYTES -> return Err(CanvasPreviewError.InputBudgetExceeded)
            context.values[value.name] = value.value
        }
        context
    }
}

CanvasPreviewCallback: struct { id: String }
impl CanvasPreviewCallback {
    checked: fn(id: String) -> CanvasPreviewCallback CanvasPreviewError! {
        preview_text(id, "preview callback id", 256)
        CanvasPreviewCallback{id: id}
    }
    validate: fn(self) CanvasPreviewError! { preview_text(self.id, "preview callback id", 256) }
}

CanvasPreviewDescriptor: struct {
    kind: CanvasPreviewKind
    name: String
    callback: CanvasPreviewCallback
    source: CanvasPreviewSourceIdentity
    viewport: CanvasPreviewViewport
    traits: CanvasPreviewTraits
    // Ordered by `order_key` and unique.
    effects: [CanvasPreviewEffect]
    authority: CanvasPreviewAuthority
    inputs: [String: CanvasPreviewInput]
    context_id: String?
}
impl CanvasPreviewDescriptor {
    new: fn(kind: CanvasPreviewKind, name: String, callback: CanvasPreviewCallback, source: CanvasPreviewSourceIdentity) -> CanvasPreviewDescriptor {
        CanvasPreviewDescriptor{kind: kind, name: name, callback: callback, source: source, viewport: CanvasPreviewViewport.desktop(), traits: CanvasPreviewTraits.default(), effects: [CanvasPreviewEffect]{}, authority: CanvasPreviewAuthority.development(), inputs: [String: CanvasPreviewInput]{}, context_id: None}
    }
    preview: fn(name: String, callback: CanvasPreviewCallback, source: CanvasPreviewSourceIdentity) -> CanvasPreviewDescriptor { CanvasPreviewDescriptor.new(.Preview, name, callback, source) }
    playground: fn(name: String, callback: CanvasPreviewCallback, source: CanvasPreviewSourceIdentity) -> CanvasPreviewDescriptor { CanvasPreviewDescriptor.new(.Playground, name, callback, source) }
    set_viewport: fn(&self, viewport: CanvasPreviewViewport) CanvasPreviewError! {
        viewport.validate()
        self.viewport = viewport
    }
    add_effect: fn(&self, declared: CanvasPreviewEffect) CanvasPreviewError! {
        declared.validate()
        key: declared.order_key()
        at := 0
        loop at < self.effects.len() && self.effects[at].order_key() < key {
            at += 1
        }
        if at < self.effects.len() && self.effects[at].order_key() == key -> return
        self.effects.insert(at, declared)
    }
    set_input: fn(&self, input: CanvasPreviewInputOverride) CanvasPreviewError! {
        input.validate()
        if self.inputs.len() >= CANVAS_PREVIEW_MAX_INPUTS && !self.inputs.has_key(input.name) -> return Err(CanvasPreviewError.TooManyInputs)
        self.inputs[input.name] = input.value
    }
    validate: fn(self) CanvasPreviewError! {
        preview_text(self.name, "preview name", 256)
        self.callback.validate()
        self.source.validate()
        self.viewport.validate()
        self.traits.validate()
        loop declared in self.effects {
            declared.validate()
            if !self.authority.allows_capability(declared.capability()) -> return Err(CanvasPreviewError.CapabilityDenied(capability: declared.capability()))
        }
        keys := self.inputs.keys().to_list()
        keys.sort()
        loop name in keys {
            preview_text(name, "preview input name", 256)
            self.inputs[name].validate()
        }
        if self.inputs.len() > CANVAS_PREVIEW_MAX_INPUTS -> return Err(CanvasPreviewError.TooManyInputs)
        if self.context_id == .Val(context_id) -> preview_text(context_id, "preview context id", 256)
    }
}

CanvasPreviewPolicy: struct {
    max_previews: Int
    max_selected: Int
    max_contexts: Int
    max_inputs: Int
    max_frame_bytes: Int
    max_resident_bytes: Int
    max_diagnostic_bytes: Int
    max_clients: Int
    client_idle_secs: Int
}
impl CanvasPreviewPolicy {
    default: fn() -> CanvasPreviewPolicy {
        CanvasPreviewPolicy{max_previews: CANVAS_PREVIEW_MAX_PREVIEWS, max_selected: CANVAS_PREVIEW_MAX_SELECTED, max_contexts: CANVAS_PREVIEW_MAX_CONTEXTS, max_inputs: CANVAS_PREVIEW_MAX_INPUTS, max_frame_bytes: CANVAS_PREVIEW_MAX_FRAME_BYTES, max_resident_bytes: CANVAS_PREVIEW_MAX_RESIDENT_BYTES, max_diagnostic_bytes: CANVAS_PREVIEW_MAX_DIAGNOSTIC_BYTES, max_clients: CANVAS_PREVIEW_MAX_CLIENTS, client_idle_secs: CANVAS_PREVIEW_CLIENT_IDLE_SECS}
    }
    validate: fn(self) CanvasPreviewError! {
        if self.max_previews <= 0 || self.max_previews > CANVAS_PREVIEW_MAX_PREVIEWS -> return Err(CanvasPreviewError.InvalidPolicy)
        if self.max_selected <= 0 || self.max_selected > CANVAS_PREVIEW_MAX_SELECTED -> return Err(CanvasPreviewError.InvalidPolicy)
        if self.max_contexts < 0 || self.max_contexts > CANVAS_PREVIEW_MAX_CONTEXTS || self.max_inputs < 0 || self.max_inputs > CANVAS_PREVIEW_MAX_INPUTS -> return Err(CanvasPreviewError.InvalidPolicy)
        if self.max_frame_bytes <= 0 || self.max_frame_bytes > CANVAS_PREVIEW_MAX_FRAME_BYTES -> return Err(CanvasPreviewError.InvalidPolicy)
        if self.max_resident_bytes <= 0 || self.max_resident_bytes > CANVAS_PREVIEW_MAX_RESIDENT_BYTES -> return Err(CanvasPreviewError.InvalidPolicy)
        if self.max_diagnostic_bytes <= 0 || self.max_diagnostic_bytes > CANVAS_PREVIEW_MAX_DIAGNOSTIC_BYTES -> return Err(CanvasPreviewError.InvalidPolicy)
        if self.max_clients <= 0 || self.max_clients > CANVAS_PREVIEW_MAX_CLIENTS || self.client_idle_secs <= 0 -> return Err(CanvasPreviewError.InvalidPolicy)
    }
}

CanvasPreviewStatus: enum {
    Unrendered
    Building
    Ready
    Error
    Stale
    Closed
}
impl CanvasPreviewStatus {
    as_str: fn(self) -> String {
        if self == {
            .Unrendered -> "unrendered"
            .Building -> "building"
            .Ready -> "ready"
            .Error -> "error"
            .Stale -> "stale"
            .Closed -> "closed"
        }
    }
}

CanvasPreviewDiagnostic: struct {
    code: String
    message: String
    source: CanvasPreviewSourceIdentity
}
impl CanvasPreviewDiagnostic {
    new: fn(code: String, message: String, source: CanvasPreviewSourceIdentity, max_bytes: Int) -> CanvasPreviewDiagnostic CanvasPreviewError! {
        preview_text(code, "preview diagnostic code", 128)
        preview_text(message, "preview diagnostic", max_bytes)
        source.validate()
        CanvasPreviewDiagnostic{code: code, message: message, source: source}
    }
}

CanvasPreviewRendered: struct<T> {
    value: T
    bytes: Int
}

CanvasPreviewRenderError: struct {
    code: String
    message: String
}
impl CanvasPreviewRenderError {
    new: fn(code: String, message: String) -> CanvasPreviewRenderError CanvasPreviewError! {
        preview_text(code, "preview render error code", 128)
        preview_text(message, "preview render error", CANVAS_PREVIEW_MAX_DIAGNOSTIC_BYTES)
        CanvasPreviewRenderError{code: code, message: message}
    }
}

CanvasPreviewFrame: struct<T> {
    value: T
    source: CanvasPreviewSourceIdentity
    bytes: Int
    sequence: Int
}

CanvasPreviewSnapshot: struct<T> {
    session_id: String
    name: String
    kind: CanvasPreviewKind
    source: CanvasPreviewSourceIdentity
    status: CanvasPreviewStatus
    freshness: JetDevtoolsFreshnessState
    current: CanvasPreviewFrame<T>?
    last_good: CanvasPreviewFrame<T>?
    diagnostic: CanvasPreviewDiagnostic?
    sequence: Int
}
impl CanvasPreviewSnapshot {
    to_json: fn(self) -> String {
        diagnostic := "null"
        if self.diagnostic == .Val(value) -> diagnostic = "{{\"code\":\"{foundation_json_escape(value.code)}\",\"message\":\"{foundation_json_escape(value.message)}\",\"source\":{value.source.to_json()}}}"
        current_source := "null"
        if self.current == .Val(frame) -> current_source = frame.source.to_json()
        last_good_source := "null"
        if self.last_good == .Val(frame) -> last_good_source = frame.source.to_json()
        "{{\"schema_version\":{CANVAS_PREVIEW_SCHEMA_VERSION},\"session_id\":\"{foundation_json_escape(self.session_id)}\",\"name\":\"{foundation_json_escape(self.name)}\",\"kind\":\"{self.kind.as_str()}\",\"status\":\"{self.status.as_str()}\",\"freshness\":\"{self.freshness.as_str()}\",\"current\":{self.current != None},\"last_good\":{self.last_good != None},\"current_source\":{current_source},\"last_good_source\":{last_good_source},\"diagnostic\":{diagnostic},\"sequence\":{self.sequence}}}"
    }
}

CanvasPreviewRecord: struct<T> {
    descriptor: CanvasPreviewDescriptor
    status: CanvasPreviewStatus
    freshness: JetDevtoolsFreshnessState
    last_good: CanvasPreviewFrame<T>?
    diagnostic: CanvasPreviewDiagnostic?
    sequence: Int
}

CanvasPreviewConnection: struct {
    session_id: String
    client_id: String
    generation: Int
    cursor: Int
}

CanvasPreviewClientLease: struct {
    generation: Int
    cursor: Int
    loopback: Bool
    last_seen: Instant
}

// One preview host session: every registered preview has a record carrying its
// last-good frame, so a failed render leaves the previous frame visible as stale.
CanvasPreviewSession: struct<T> {
    id: String
    secret: String
    authority: CanvasPreviewAuthority
    policy: CanvasPreviewPolicy
    registry: CanvasPreviewRegistry
    records: [String: CanvasPreviewRecord<T>]
    clients: [String: CanvasPreviewClientLease]
    resident_bytes: Int
    sequence: Int
    closed: Bool
}
impl CanvasPreviewSession {
    new: fn(id: String, secret: String, authority: CanvasPreviewAuthority) -> CanvasPreviewSession<T> CanvasPreviewError! {
        CanvasPreviewSession<T>.with_policy(id, secret, authority, CanvasPreviewPolicy.default())
    }
    with_policy: fn(id: String, secret: String, authority: CanvasPreviewAuthority, policy: CanvasPreviewPolicy) -> CanvasPreviewSession<T> CanvasPreviewError! {
        preview_text(id, "preview session id", 256)
        preview_text(secret, "preview session secret", 256)
        policy.validate()
        CanvasPreviewSession<T>{id: id, secret: secret, authority: authority, policy: policy, registry: CanvasPreviewRegistry.empty(), records: [String: CanvasPreviewRecord<T>]{}, clients: [String: CanvasPreviewClientLease]{}, resident_bytes: 0, sequence: 0, closed: false}
    }
    // Registers a checked declaration; it starts unrendered with no frame.
    register: fn(&self, descriptor: CanvasPreviewDescriptor) CanvasPreviewError! {
        self.ensure_open()
        if self.records.len() >= self.policy.max_previews -> return Err(CanvasPreviewError.TooManyPreviews)
        if self.authority.loopback_only && !descriptor.authority.loopback_only -> return Err(CanvasPreviewError.AuthorityWidened)
        loop capability in descriptor.authority.capabilities {
            if !self.authority.allows_capability(capability) -> return Err(CanvasPreviewError.AuthorityWidened)
        }
        self.registry.insert(descriptor)
        sequence: self.bump_sequence()
        self.records[descriptor.name] = CanvasPreviewRecord<T>{descriptor: descriptor, status: .Unrendered, freshness: .Unknown, last_good: None, diagnostic: None, sequence: sequence}
    }
    register_context: fn(&self, context: CanvasPreviewContext) CanvasPreviewError! {
        self.ensure_open()
        if self.registry.contexts.len() >= self.policy.max_contexts -> return Err(CanvasPreviewError.TooManyContexts)
        self.registry.insert_context(context)
    }
    select: fn(&self, name: String) CanvasPreviewError! {
        self.ensure_open()
        if self.registry.selected.len() >= self.policy.max_selected && !self.registry.selected.contains(name) -> return Err(CanvasPreviewError.TooManySelected)
        self.registry.select(name)
    }
    select_many: fn(&self, names: [String]) CanvasPreviewError! {
        self.ensure_open()
        if names.len() > self.policy.max_selected -> return Err(CanvasPreviewError.TooManySelected)
        self.registry.select_many(names)
    }
    clear_selection: fn(&self) { self.registry.selected = [String]{} }
    descriptor: fn(self, name: String) -> CanvasPreviewDescriptor CanvasPreviewError! {
        record: self.records.get(name) ?? return Err(CanvasPreviewError.UnknownPreview(name: name))
        record.descriptor
    }
    snapshot: fn(self, name: String) -> CanvasPreviewSnapshot<T> CanvasPreviewError! {
        record: self.records.get(name) ?? return Err(CanvasPreviewError.UnknownPreview(name: name))
        self.snapshot_record(name, record)
    }
    snapshots: fn(self) -> [CanvasPreviewSnapshot<T>] {
        keys := self.records.keys().to_list()
        keys.sort()
        out := [CanvasPreviewSnapshot<T>]{}
        loop name in keys -> out.push(self.snapshot_record(name, self.records[name]))
        out
    }
    mark_building: fn(&self, name: String) CanvasPreviewError! {
        self.ensure_open()
        record: self.records.get(name) ?? return Err(CanvasPreviewError.UnknownPreview(name: name))
        record.status = .Building
        record.freshness = if record.last_good != None -> .Stale else -> .Unknown
        record.diagnostic = None
        record.sequence = self.bump_sequence()
        self.records[name] = record
    }
    mark_stale: fn(&self, name: String, code: String, message: String) CanvasPreviewError! {
        self.mark_failed(name, code, message, .Stale)
    }
    mark_error: fn(&self, name: String, code: String, message: String) CanvasPreviewError! {
        self.mark_failed(name, code, message, .Error)
    }
    mark_failed: fn(&self, name: String, code: String, message: String, status: CanvasPreviewStatus) CanvasPreviewError! {
        self.ensure_open()
        record: self.records.get(name) ?? return Err(CanvasPreviewError.UnknownPreview(name: name))
        diagnostic: CanvasPreviewDiagnostic.new(code, message, record.descriptor.source, self.policy.max_diagnostic_bytes)
        record.status = status
        record.freshness = .Stale
        record.diagnostic = Val(diagnostic)
        record.sequence = self.bump_sequence()
        self.records[name] = record
    }
    // Renders a preview that declares no effects.
    evaluate: fn(&self, name: String, render: fn(CanvasPreviewDescriptor, CanvasPreviewContext?) -> CanvasPreviewRendered<T> CanvasPreviewRenderError!) -> CanvasPreviewSnapshot<T> CanvasPreviewError! {
        descriptor: self.descriptor(name)
        if descriptor.effects.len() > 0 -> return Err(CanvasPreviewError.AuthorityRequired)
        self.evaluate_checked(name, descriptor, render)
    }
    // Renders an effectful preview for a live loopback connection whose
    // requested effects are exactly the checked declaration's.
    evaluate_authorized: fn(&self, connection: CanvasPreviewConnection, name: String, requested_effects: [CanvasPreviewEffect], render: fn(CanvasPreviewDescriptor, CanvasPreviewContext?) -> CanvasPreviewRendered<T> CanvasPreviewRenderError!) -> CanvasPreviewSnapshot<T> CanvasPreviewError! {
        self.touch(connection)
        descriptor: self.descriptor(name)
        self.authorize_descriptor(descriptor, connection, requested_effects)
        self.evaluate_checked(name, descriptor, render)
    }
    evaluate_checked: fn(&self, name: String, descriptor: CanvasPreviewDescriptor, render: fn(CanvasPreviewDescriptor, CanvasPreviewContext?) -> CanvasPreviewRendered<T> CanvasPreviewRenderError!) -> CanvasPreviewSnapshot<T> CanvasPreviewError! {
        self.mark_building(name)
        context := None
        if descriptor.context_id == .Val(context_id) -> context = self.registry.contexts.get(context_id)
        if render(descriptor, context) == {
            .Ok(rendered) -> self.publish_checked(name, descriptor.source, rendered)
            .Err(error) -> {
                self.mark_error(name, error.code, error.message)
                Err(CanvasPreviewError.RenderFailed)
            }
        }
    }
    publish: fn(&self, name: String, source: CanvasPreviewSourceIdentity, rendered: CanvasPreviewRendered<T>) -> CanvasPreviewSnapshot<T> CanvasPreviewError! {
        descriptor: self.descriptor(name)
        if descriptor.effects.len() > 0 -> return Err(CanvasPreviewError.AuthorityRequired)
        self.publish_checked(name, source, rendered)
    }
    publish_checked: fn(&self, name: String, source: CanvasPreviewSourceIdentity, rendered: CanvasPreviewRendered<T>) -> CanvasPreviewSnapshot<T> CanvasPreviewError! {
        source.validate()
        record: self.records.get(name) ?? return Err(CanvasPreviewError.UnknownPreview(name: name))
        if source != record.descriptor.source -> return Err(CanvasPreviewError.SourceMismatch)
        if rendered.bytes <= 0 || rendered.bytes > self.policy.max_frame_bytes -> return Err(CanvasPreviewError.FrameTooLarge)
        old_bytes := 0
        if record.last_good == .Val(frame) -> old_bytes = frame.bytes
        new_resident: self.resident_bytes - old_bytes + rendered.bytes
        if new_resident > self.policy.max_resident_bytes -> return Err(CanvasPreviewError.ResidentBudgetExceeded)
        sequence: self.bump_sequence()
        record.status = .Ready
        record.freshness = .Fresh
        record.last_good = Val(CanvasPreviewFrame<T>{value: rendered.value, source: source, bytes: rendered.bytes, sequence: sequence})
        record.diagnostic = None
        record.sequence = sequence
        self.records[name] = record
        self.resident_bytes = new_resident
        self.snapshot_record(name, record)
    }
    authorize_descriptor: fn(self, descriptor: CanvasPreviewDescriptor, connection: CanvasPreviewConnection, requested_effects: [CanvasPreviewEffect]) CanvasPreviewError! {
        if connection.session_id != self.id -> return Err(CanvasPreviewError.Unauthorized)
        lease: self.clients.get(connection.client_id) ?? return Err(CanvasPreviewError.LoopbackRequired)
        if !lease.loopback -> return Err(CanvasPreviewError.LoopbackRequired)
        requested := CanvasPreviewDescriptor.new(descriptor.kind, descriptor.name, descriptor.callback, descriptor.source)
        loop requested_effect in requested_effects -> requested.add_effect(requested_effect)
        if requested.effects != descriptor.effects -> return Err(CanvasPreviewError.EffectSetMismatch)
        loop declared in descriptor.effects {
            if !descriptor.authority.allows_effect(declared, true) || !self.authority.allows_effect(declared, true) -> return Err(CanvasPreviewError.CapabilityDenied(capability: declared.capability()))
        }
    }
    connect: fn(&self, client_id: String, presented_secret: String, loopback: Bool) -> CanvasPreviewConnection CanvasPreviewError! {
        self.ensure_open()
        _: self.prune_expired_at(time.instant())
        preview_text(client_id, "preview client id", 256)
        self.authorize_connection(presented_secret, loopback)
        self.open_client(client_id, loopback, 0)
    }
    reconnect: fn(&self, connection: CanvasPreviewConnection, presented_secret: String, loopback: Bool) -> CanvasPreviewConnection CanvasPreviewError! {
        self.ensure_open()
        self.authorize_connection(presented_secret, loopback)
        lease: self.clients.get(connection.client_id) ?? return Err(CanvasPreviewError.StaleConnection)
        if lease.generation != connection.generation || connection.session_id != self.id -> return Err(CanvasPreviewError.StaleConnection)
        cursor: if connection.cursor < self.sequence -> connection.cursor else -> self.sequence
        self.open_client(connection.client_id, loopback, cursor)
    }
    touch: fn(&self, connection: CanvasPreviewConnection) CanvasPreviewError! {
        self.ensure_open()
        if connection.session_id != self.id -> return Err(CanvasPreviewError.StaleConnection)
        lease: self.clients.get(connection.client_id) ?? return Err(CanvasPreviewError.StaleConnection)
        if lease.generation != connection.generation -> return Err(CanvasPreviewError.StaleConnection)
        lease.last_seen = time.instant()
        self.clients[connection.client_id] = lease
    }
    acknowledge: fn(&self, connection: CanvasPreviewConnection, cursor: Int) CanvasPreviewError! {
        self.touch(connection)
        if cursor < 0 || cursor > self.sequence -> return Err(CanvasPreviewError.InvalidCursor)
        lease: self.clients.get(connection.client_id) ?? return Err(CanvasPreviewError.StaleConnection)
        lease.cursor = cursor
        self.clients[connection.client_id] = lease
    }
    disconnect: fn(&self, connection: CanvasPreviewConnection) CanvasPreviewError! {
        lease: self.clients.get(connection.client_id) ?? return Err(CanvasPreviewError.StaleConnection)
        if connection.session_id != self.id || lease.generation != connection.generation -> return Err(CanvasPreviewError.StaleConnection)
        _ := self.clients.remove(connection.client_id)
    }
    prune_expired: fn(&self) -> Int { self.prune_expired_at(time.instant()) }
    // Drops every client idle past the policy timeout; returns how many.
    prune_expired_at: fn(&self, now: Instant) -> Int {
        timeout_ns: self.policy.client_idle_secs * 1000000000
        expired := [String]{}
        loop (client_id, lease) in self.clients {
            if (now - lease.last_seen).ns > timeout_ns -> expired.push(client_id)
        }
        loop client_id in expired -> _ := self.clients.remove(client_id)
        expired.len()
    }
    close: fn(&self) {
        self.closed = true
        self.clients = [String: CanvasPreviewClientLease]{}
        self.records = [String: CanvasPreviewRecord<T>]{}
        self.registry = CanvasPreviewRegistry.empty()
        self.resident_bytes = 0
    }
    to_json: fn(self) -> String {
        snapshots := [String]{}
        loop snapshot in self.snapshots() -> snapshots.push(snapshot.to_json())
        selected := [String]{}
        loop name in self.registry.selected -> selected.push("\"{foundation_json_escape(name)}\"")
        "{{\"schema_version\":{CANVAS_PREVIEW_SCHEMA_VERSION},\"session_id\":\"{foundation_json_escape(self.id)}\",\"closed\":{self.closed},\"selected\":[{selected.join(",")}],\"resident_bytes\":{self.resident_bytes},\"sequence\":{self.sequence},\"previews\":[{snapshots.join(",")}]}}"
    }
    open_client: fn(&self, client_id: String, loopback: Bool, cursor: Int) -> CanvasPreviewConnection CanvasPreviewError! {
        generation := 1
        if self.clients.get(client_id) == .Val(lease) {
            generation = lease.generation + 1
        } else if self.clients.len() >= self.policy.max_clients {
            return Err(CanvasPreviewError.TooManyClients)
        }
        self.clients[client_id] = CanvasPreviewClientLease{generation: generation, cursor: cursor, loopback: loopback, last_seen: time.instant()}
        CanvasPreviewConnection{session_id: self.id, client_id: client_id, generation: generation, cursor: cursor}
    }
    authorize_connection: fn(self, presented_secret: String, loopback: Bool) CanvasPreviewError! {
        if !preview_constant_time_equal(self.secret, presented_secret) -> return Err(CanvasPreviewError.Unauthorized)
        if self.authority.loopback_only && !loopback -> return Err(CanvasPreviewError.LoopbackRequired)
    }
    snapshot_record: fn(self, name: String, record: CanvasPreviewRecord<T>) -> CanvasPreviewSnapshot<T> {
        current: if record.freshness == .Fresh -> record.last_good else -> None
        CanvasPreviewSnapshot<T>{session_id: self.id, name: name, kind: record.descriptor.kind, source: record.descriptor.source, status: record.status, freshness: record.freshness, current: current, last_good: record.last_good, diagnostic: record.diagnostic, sequence: record.sequence}
    }
    bump_sequence: fn(&self) -> Int {
        self.sequence += 1
        self.sequence
    }
    ensure_open: fn(self) CanvasPreviewError! {
        if self.closed -> return Err(CanvasPreviewError.SessionClosed)
    }
}

CanvasPreviewRegistry: struct {
    descriptors: [String: CanvasPreviewDescriptor]
    contexts: [String: CanvasPreviewContext]
    // Sorted and unique.
    selected: [String]
}
impl CanvasPreviewRegistry {
    empty: fn() -> CanvasPreviewRegistry { CanvasPreviewRegistry{descriptors: [String: CanvasPreviewDescriptor]{}, contexts: [String: CanvasPreviewContext]{}, selected: [String]{}} }
    new: fn(descriptors: [CanvasPreviewDescriptor]) -> CanvasPreviewRegistry CanvasPreviewError! {
        registry := CanvasPreviewRegistry.empty()
        loop descriptor in descriptors -> registry.insert(descriptor)
        registry
    }
    insert: fn(&self, descriptor: CanvasPreviewDescriptor) CanvasPreviewError! {
        descriptor.validate()
        if self.descriptors.len() >= CANVAS_PREVIEW_MAX_PREVIEWS -> return Err(CanvasPreviewError.TooManyPreviews)
        if self.descriptors.has_key(descriptor.name) -> return Err(CanvasPreviewError.DuplicatePreview(name: descriptor.name))
        self.descriptors[descriptor.name] = descriptor
    }
    replace: fn(&self, descriptor: CanvasPreviewDescriptor) CanvasPreviewError! {
        descriptor.validate()
        if !self.descriptors.has_key(descriptor.name) -> return self.insert(descriptor)
        self.descriptors[descriptor.name] = descriptor
    }
    remove: fn(&self, name: String) CanvasPreviewError! {
        _: self.descriptors.remove(name) ?? return Err(CanvasPreviewError.UnknownPreview(name: name))
        kept := [String]{}
        loop selected in self.selected {
            if selected != name -> kept.push(selected)
        }
        self.selected = kept
    }
    // Declarations in name order.
    sorted_descriptors: fn(self) -> [CanvasPreviewDescriptor] {
        keys := self.descriptors.keys().to_list()
        keys.sort()
        out := [CanvasPreviewDescriptor]{}
        loop key in keys -> out.push(self.descriptors[key])
        out
    }
    select: fn(&self, name: String) CanvasPreviewError! {
        if !self.descriptors.has_key(name) -> return Err(CanvasPreviewError.UnknownPreview(name: name))
        if self.selected.len() >= CANVAS_PREVIEW_MAX_SELECTED && !self.selected.contains(name) -> return Err(CanvasPreviewError.TooManySelected)
        preview_insert_sorted(self.selected, name)
    }
    select_many: fn(&self, names: [String]) CanvasPreviewError! {
        if names.len() > CANVAS_PREVIEW_MAX_SELECTED -> return Err(CanvasPreviewError.TooManySelected)
        loop name in names {
            if !self.descriptors.has_key(name) -> return Err(CanvasPreviewError.UnknownPreview(name: name))
        }
        selected := [String]{}
        loop name in names -> preview_insert_sorted(selected, name)
        self.selected = selected
    }
    insert_context: fn(&self, context: CanvasPreviewContext) CanvasPreviewError! {
        if self.contexts.len() >= CANVAS_PREVIEW_MAX_CONTEXTS -> return Err(CanvasPreviewError.TooManyContexts)
        if self.contexts.has_key(context.id) -> return Err(CanvasPreviewError.DuplicateContext(id: context.id))
        context.source.validate()
        self.contexts[context.id] = context
    }
    validate: fn(self) CanvasPreviewError! {
        loop descriptor in self.sorted_descriptors() {
            descriptor.validate()
            if descriptor.context_id == .Val(context_id) {
                context: self.contexts.get(context_id) ?? return Err(CanvasPreviewError.UnknownContext(id: context_id))
                if context.source != descriptor.source -> return Err(CanvasPreviewError.ContextSourceMismatch)
            }
        }
    }
    to_json: fn(self) -> String {
        descriptors := [String]{}
        loop descriptor in self.sorted_descriptors() {
            viewport: descriptor.viewport
            descriptors.push("{{\"name\":\"{foundation_json_escape(descriptor.name)}\",\"kind\":\"{descriptor.kind.as_str()}\",\"callback\":\"{foundation_json_escape(descriptor.callback.id)}\",\"source\":{descriptor.source.to_json()},\"viewport\":{{\"device\":\"{foundation_json_escape(viewport.device.as_str())}\",\"width\":{viewport.width},\"height\":{viewport.height},\"scale\":{viewport.scale}}},\"selected\":{self.selected.contains(descriptor.name)}}}")
        }
        selected := [String]{}
        loop name in self.selected -> selected.push("\"{foundation_json_escape(name)}\"")
        "{{\"schema_version\":{CANVAS_PREVIEW_SCHEMA_VERSION},\"selected\":[{selected.join(",")}],\"contexts\":{self.contexts.len()},\"descriptors\":[{descriptors.join(",")}]}}"
    }
}

CanvasPreviewError: enum {
    InvalidText(field: String, reason: String)
    InvalidSource(reason: String)
    InvalidViewport(reason: String)
    InvalidInput(reason: String)
    InvalidPolicy
    TooManyPreviews
    TooManySelected
    TooManyContexts
    TooManyInputs
    DuplicatePreview(name: String)
    UnknownPreview(name: String)
    DuplicateContext(id: String)
    UnknownContext(id: String)
    DuplicateInput(name: String)
    InputBudgetExceeded
    AuthorityWidened
    AuthorityRequired
    CapabilityDenied(capability: String)
    EffectSetMismatch
    LoopbackRequired
    Unauthorized
    TooManyClients
    StaleConnection
    InvalidCursor
    FrameTooLarge
    ResidentBudgetExceeded
    SourceMismatch
    ContextSourceMismatch
    RenderFailed
    SessionClosed
}
impl CanvasPreviewError {
    message: fn(self) -> String {
        if self == {
            .InvalidText(field, reason) -> "invalid {field}: {reason}"
            .InvalidSource(reason) -> "invalid preview source: {reason}"
            .InvalidViewport(reason) -> "invalid preview viewport: {reason}"
            .InvalidInput(reason) -> "invalid preview input: {reason}"
            .InvalidPolicy -> "preview policy exceeds the bounded session contract"
            .TooManyPreviews -> "preview registry is full"
            .TooManySelected -> "preview selection exceeds the bounded limit"
            .TooManyContexts -> "preview context registry is full"
            .TooManyInputs -> "preview input overrides exceed the bounded limit"
            .DuplicatePreview(name) -> "preview `{name}` is duplicated"
            .UnknownPreview(name) -> "unknown preview `{name}`"
            .DuplicateContext(id) -> "preview context `{id}` is duplicated"
            .UnknownContext(id) -> "unknown preview context `{id}`"
            .DuplicateInput(name) -> "preview input `{name}` is duplicated"
            .InputBudgetExceeded -> "preview input budget exceeded"
            .AuthorityWidened -> "preview authority widens the session authority"
            .AuthorityRequired -> "preview effects require an authorized connection"
            .CapabilityDenied(capability) -> "preview capability `{capability}` is denied"
            .EffectSetMismatch -> "requested preview effects do not match the checked declaration"
            .LoopbackRequired -> "preview session requires a loopback connection"
            .Unauthorized -> "preview session authorization failed"
            .TooManyClients -> "preview session client limit reached"
            .StaleConnection -> "preview connection is stale; reconnect and resync"
            .InvalidCursor -> "preview cursor is outside the session history"
            .FrameTooLarge -> "preview frame exceeds the bounded frame limit"
            .ResidentBudgetExceeded -> "preview resident frame budget exceeded"
            .SourceMismatch -> "preview frame source identity does not match the checked declaration"
            .ContextSourceMismatch -> "preview context source identity does not match the checked declaration"
            .RenderFailed -> "preview callback failed; the last-good frame remains visible as stale"
            .SessionClosed -> "preview session is closed"
        }
    }
}

preview_text: fn(value: String, field: String, max_bytes: Int) CanvasPreviewError! {
    if value.trim() == "" -> return Err(CanvasPreviewError.InvalidText(field: field, reason: "must not be empty"))
    if value.bytes().len() > max_bytes -> return Err(CanvasPreviewError.InvalidText(field: field, reason: "exceeds the bounded text size"))
    if jettrace_has_control(value) -> return Err(CanvasPreviewError.InvalidText(field: field, reason: "must not contain control characters"))
}

// Inserts `value` into the sorted, unique `values`.
preview_insert_sorted: fn(values: &[String], value: String) {
    if values.contains(value) -> return
    values.push(value)
    values.sort()
}

// Compares every byte position of the longer secret, so the time taken does
// not depend on where the first difference sits.
preview_constant_time_equal: fn(left: String, right: String) -> Bool {
    left_bytes: left.bytes()
    right_bytes: right.bytes()
    width: if left_bytes.len() > right_bytes.len() -> left_bytes.len() else -> right_bytes.len()
    difference := if left_bytes.len() == right_bytes.len() -> 0 else -> 1
    loop index in 0..<width {
        left_byte: if index < left_bytes.len() -> left_bytes[index] else -> U8{0}
        right_byte: if index < right_bytes.len() -> right_bytes[index] else -> U8{0}
        if left_byte != right_byte -> difference += 1
    }
    difference == 0
}
