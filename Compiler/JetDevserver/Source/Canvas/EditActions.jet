// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:878
fn apply_insert_call(path: &OSPath, src: String, graph_id: String, callee: String, args: &[String], bind: String?, wire_inline_expr_id: String?, wire_expr: String?, wire_origin_pin_id: String?, wire_target_pin: String?, module_path: String?) -> String Err! {
    projection :: project_file(path) ?? return .Err(diagnostics_error(path, src, err))
    final_args :: if args.is_empty() -> wire_expr.map((expr) -> [~expr]).unwrap_or_default() else -> args.to_vec()
    plan := insert_call_plan(src, callee, final_args, module_path)
    call :: if plan.fallible -> "{plan.callee}({plan.args.join(", ")}) ?? panic(\"canvas\")" else -> "{plan.callee}({plan.args.join(", ")})"
    if wire_inline_expr_id == .Val(inline_id) {
        inline :: projection.inline_exprs.iter().find((i) -> i.id == inline_id) ?? return .Err(edit_error("not_found", "Canvas inline expression no longer exists"))
        edits := [edit(inline.span, call)]
        if plan.import == .Val(import) -> edits.push(^import)
        changed :: FixEngine.apply_edits(src, edits) ?? return .Err(edit_error("overlap", "Canvas wired insert edit overlapped"))
        return write_checked_formatted(path, src, changed)
    }
    anchor :: projection.graph_anchors.iter().find((a) -> a.graph_id == graph_id) ?? return .Err(edit_error("not_found", "Canvas graph no longer exists"))
    (insert_offset, indent) :: call_insert_target(src, graph_id, projection, anchor, wire_origin_pin_id, wire_target_pin)?
    stmt :: if bind == { .Val(name) -> "{indent}{name} :: {call}\n", .None -> "{indent}{call}\n" }
    edits := [edit(SourceSpan { start: insert_offset, end: insert_offset }, stmt)]
    if plan.import == .Val(import) -> edits.push(^import)
    changed :: FixEngine.apply_edits(src, edits) ?? return .Err(edit_error("overlap", "Canvas insert edit overlapped"))
    return write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:958
fn call_insert_target(src: String, graph_id: String, projection: &Projection, anchor: &GraphEditAnchor, wire_origin_pin_id: String?, _wire_target_pin: String?) -> (Usize, String) Err! {
    pin_id :: wire_origin_pin_id ?? return .Ok((anchor.insert_offset, "    "))
    (node_id, direction) :: pin_id.rsplit_once(":input:").map(((node, _)) -> (node, "input"))
        .or_else(() -> pin_id.rsplit_once(":output:").map(((node, _)) -> (node, "output")))
        ?? return .Err(edit_error("not_found", "Canvas insertion pin no longer exists"))
    node :: projection.node_refs.iter().filter((node) -> node.graph_id == graph_id)
        .filter((node) -> node.node_id == node_id || node.node_id.ends_with(":{node_id}"))
        .max_by_key((node) -> node.span.end.saturating_sub(node.span.start))
        ?? return .Err(edit_error("not_found", "Canvas insertion pin no longer exists"))
    if node.node_id.ends_with(":entry") -> return .Ok((anchor.insert_offset, "    "))
    indent :: indentation_at(src, node.span.start)
    statement_indent :: if indent.is_empty() -> "    " else -> indent
    line :: line_start(src, node.span.start)
    node_end :: node.span.end.min(src.len())
    tail := src[node_end..] // #4303
    line_end :: tail.find('\n').map((offset) -> node_end + offset).unwrap_or(src.len())
    inline_body :: line == line_start(src, anchor.insert_offset) && src.get(line..node.span.start.min(src.len())).is_some_and((prefix) -> prefix.contains('{')) && src.get(node_end..line_end).is_some_and((suffix) -> suffix.contains('}'))
    if inline_body {
        body_tail := src[node_end..line_end] // #4303
        insert :: if direction == "input" -> anchor.insert_offset else -> body_tail.find('}').map((offset) -> node_end + offset).unwrap_or(line_end)
        return .Ok((insert, "\n{statement_indent}"))
    }
    insert :: if direction == "input" -> line else -> line_after(src, node.span.end)
    return .Ok((insert, statement_indent))
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1026
struct InsertCallPlan { callee: String; args: [String]; fallible: Bool; import: TextEdit? }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1033
fn insert_call_plan(src: String, callee: String, args: &[String], module_path: String?) -> InsertCallPlan {
    target :: core_target_for_callee(src, callee, module_path) ?? return InsertCallPlan { callee: ~callee, args: args.to_vec(), fallible: false, import: .None }
    module :: normalize_core_module(target.module, target.member)
    (prefix, import) :: core_call_prefix_and_import(src, module)
    final_args :: if args.is_empty() -> core_default_args(module, target.member) else -> args.to_vec()
    return InsertCallPlan { callee: "{prefix}.{target.member}", args: ^final_args, fallible: core_call_is_fallible(module, target.member), import: ^import }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1062
struct CoreCallTarget { module: String; member: String }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1067
fn core_target_for_callee(src: String, callee: String, module_path: String?) -> CoreCallTarget? {
    parts :: callee.split('.').collect()
    if parts.len() < 2 -> return .None
    member :: parts.last()?.to_string()
    if module_path == .Val(module) {
        alias :: default_core_alias(module)
        if module.starts_with("core.") && parts.len() == 2 && parts.first().copied() == .Val(alias.as_str()) {
            return .Val(CoreCallTarget { module: ~module, member: ^member })
        }
    }
    if parts.first() == .Val("core") && parts.len() >= 3 -> return .Val(CoreCallTarget { module: parts[..parts.len() - 1].join("."), member: ^member })
    for import in core_imports(src) {
        if import.alias != parts[0] -> continue
        suffix :: if parts.len() > 2 -> ".{parts[1..parts.len() - 1].join(".")}" else -> ""
        return .Val(CoreCallTarget { module: "{import.module}{suffix}", member: ^member })
    }
    alias :: parts[0]
    if Syntax.core_module_for_alias(alias) == .Val(module) {
        suffix :: if parts.len() > 2 -> ".{parts[1..parts.len() - 1].join(".")}" else -> ""
        return .Val(CoreCallTarget { module: "{module}{suffix}", member: ^member })
    }
    return .None
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1124
fn normalize_core_module(module: String, member: String) -> String { Syntax.core_module_for_call(module, member).unwrap_or(module).to_string() }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1130
fn core_call_prefix_and_import(src: String, module: String) -> (String, TextEdit?) {
    if imported_core_prefix(src, module) == .Val(prefix) -> return (prefix, .None)
    alias :: default_core_alias(module)
    (offset, joins_use_block) :: core_import_insert_point(src)
    suffix :: if joins_use_block -> "\n" else -> "\n\n"
    import :: edit(SourceSpan { start: offset, end: offset }, "use {module} as {alias}{suffix}")
    return (alias, .Val(import))
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1147
fn imported_core_prefix(src: String, module: String) -> String? {
    best: (Usize, String)? := .None
    for import in core_imports(src) {
        if import.module == module -> return .Val(^import.alias)
        prefix :: "{import.module}."
        if module.starts_with(prefix) {
            suffix := module[prefix.len()..] // #4303
            candidate :: "{import.alias}.{suffix}"
            if best.as_ref().map_or(true, ((len, _)) -> import.module.len() > len) -> best = .Val((import.module.len(), ^candidate))
        }
    }
    return best.map(((_, alias)) -> ^alias)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1168
struct CoreImport { module: String; alias: String }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1173
fn core_imports(src: String) -> [CoreImport] {
    imports := []
    for line in src.lines() {
        code := line.split("//").next().unwrap_or("").trim() // #4303
        rest :: code.strip_prefix("use core.") ?? continue
        full :: "core.{rest}"
        module: String
        alias: String
        if full.split_once(" as ") == .Val((found_module, found_alias)) {
            module = found_module.trim() // #4303
            alias_text := found_alias.trim() // #4303
            alias = ident_prefix(alias_text)
        } else {
            module = full.trim() // #4303
            alias = default_core_alias(module)
        }
        if !module.is_empty() && !alias.is_empty() -> imports.push(CoreImport { module: module.to_string(), alias: ^alias })
    }
    return ^imports
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1197
fn ident_prefix(text: String) -> String { text.chars().take_while((c) -> c.is_ascii_alphanumeric() || c == '_').collect() }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1203
fn default_core_alias(module: String) -> String { module.rsplit('.').next().unwrap_or("core").to_string() }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1207
fn core_import_insert_point(src: String) -> (Usize, Bool) {
    offset := 0
    insert_at := 0
    saw_use := false
    for line in src.split_inclusive('\n') {
        trimmed := line.trim() // #4303
        if trimmed.starts_with("use ") {
            saw_use = true
            insert_at = offset + line.len()
        } else if saw_use -> break
        else if trimmed.is_empty() || trimmed.starts_with("//") -> insert_at = offset + line.len()
        else -> break
        offset += line.len()
    }
    return (insert_at, saw_use)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1228
fn core_default_args(module: String, member: String) -> [String] {
    core_call_signature(module, member).map(((params, _)) -> params.into_iter().map(((_, ty)) -> default_arg_for_type(ty.name())).collect()).unwrap_or_default()
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1239
fn core_call_signature(module: String, member: String) -> ([(AST.AccessConvention, AST.Type)], AST.Type?)? {
    if Syntax.core_call(module, member) == .Val(row) {
        if Sema.core_fixed_sig_for_row(row) == .Val(signature) -> return .Val(signature)
    }
    return Sema.core_call_surface_signature(module, member)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1251
fn core_call_is_fallible(module: String, member: String) -> Bool {
    if Syntax.core_call(module, member) == .Val(row) {
        if Sema.core_fixed_sig_for_row(row) == .Val((_, ret)) -> return ret.is_some_and((ret) -> ret.is_fallible())
    }
    return Sema.core_call_is_fallible(module, member)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1260
fn check_canvas_candidate(path: &OSPath, overlay_path: &OSPath, source: String) -> [Diagnostic] {
    path_str :: path.to_string_lossy()
    Driver.check_file(path_str, .Val((overlay_path, source)), true).0
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1265
fn canvas_action_candidate(path: &OSPath, src: String, graph_id: String, action_id: String, callee: String, args: &[String]) -> String Err! {
    overlay_path :: canonical_path(path)
    projection :: project_file(path) ?? return .Err(diagnostics_error(path, src, err))
    anchor :: projection.graph_anchors.iter().find((a) -> a.graph_id == graph_id) ?? return .Err(edit_error("not_found", "Canvas graph no longer exists"))
    if !action_id.starts_with("canvas.action:") -> return .Err(edit_error("bad_request", "Canvas action id must be a package Canvas action"))
    (_, descriptor_callee) :: action_id.rsplit_once(':') ?? return .Err(edit_error("bad_request", "Canvas action id has no checked source callee"))
    if descriptor_callee != callee -> return .Err(edit_error("bad_request", "Canvas action callee does not match its checked descriptor"))
    stmt :: "    {callee}({args.join(", ")})\n"
    changed :: FixEngine.apply_edits(src, [edit(SourceSpan { start: anchor.insert_offset, end: anchor.insert_offset }, stmt)]) ?? return .Err(edit_error("overlap", "Canvas action edit overlapped"))
    formatted :: format_source(changed) ?? return .Err(diagnostics_error(path, src, err))
    // In-memory overlay avoids a scratch pathname race before Driver reopens it.
    check :: check_canvas_candidate(path, overlay_path, formatted)
    errors :: check.iter().filter((d) -> d.severity == .Error).cloned().collect()
    if !errors.is_empty() -> return .Err(diagnostics_error(path, formatted, errors))
    return .Ok(^formatted)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1328
fn apply_insert_structural(path: &OSPath, src: String, graph_id: String, op: String, wire_origin_pin_id: String?, wire_target_pin: String?) -> String Err! {
    projection :: project_file(path) ?? return .Err(diagnostics_error(path, src, err))
    anchor :: projection.graph_anchors.iter().find((a) -> a.graph_id == graph_id) ?? return .Err(edit_error("not_found", "Canvas graph no longer exists"))
    (insert, indent) :: structural_insert_target(src, graph_id, projection, anchor, wire_origin_pin_id, wire_target_pin)?
    stmt :: if op == {
        "insert_branch" -> format("{0}if true {{\n{0}    print(\"branch\")\n{0}}} else {{\n{0}    print(\"else\")\n{0}}}\n", indent)
        "insert_switch" -> format("{0}if 0 == {{\n{0}    0 -> {{ print(\"case\") }}\n{0}    else -> {{ print(\"else\") }}\n{0}}}\n", indent)
        "insert_loop" -> format("{0}loop {{\n{0}    break\n{0}}}\n", indent)
        "insert_fallible_rail" -> {
            if !anchor.fallible -> return .Err(edit_error("unavailable", "needs a fallible function"))
            "{indent}fallible_value :: Int.parse(\"1\")\n{indent}unwrapped :: fallible_value ?? 0\n"
        }
        _ -> return .Err(edit_error("unsupported", "unknown Canvas structural operation"))
    }
    changed :: FixEngine.apply_edits(src, [edit(SourceSpan { start: insert, end: insert }, stmt)]) ?? return .Err(edit_error("overlap", "Canvas structural insert overlapped"))
    return write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1384
fn structural_insert_target(src: String, graph_id: String, projection: &Projection, anchor: &GraphEditAnchor, wire_origin_pin_id: String?, wire_target_pin: String?) -> (Usize, String) Err! {
    pin_id :: wire_origin_pin_id ?? {
        if wire_target_pin.is_some() -> return .Err(edit_error("bad_request", "Canvas structural wire origin is missing"))
        return .Ok((anchor.insert_offset, "    "))
    }
    target :: wire_target_pin ?? return .Err(edit_error("bad_request", "Canvas structural wire target is missing"))
    if target != "exec" -> return .Err(edit_error("bad_request", "Canvas structural nodes connect through the exec pin"))
    (node_id, direction) :: pin_id.rsplit_once(":input:").map(((node, _)) -> (node, "input"))
        .or_else(() -> pin_id.rsplit_once(":output:").map(((node, _)) -> (node, "output")))
        ?? return .Err(edit_error("not_found", "Canvas insertion pin no longer exists"))
    pin_marker :: "\"pin_id\":{json_str(pin_id)}"
    if !projection.json.contains(pin_marker) -> return .Err(edit_error("not_found", "Canvas insertion pin no longer exists"))
    pin_is_exec :: projection.json.split(pin_marker).skip(1).any((chunk) -> chunk.split("\"pin_id\":").next().is_some_and((pin) -> pin.contains("\"type\":\"exec\"")))
    if !pin_is_exec -> return .Err(edit_error("bad_request", "Canvas structural nodes connect through the exec pin"))
    node :: projection.node_refs.iter().filter((node) -> node.graph_id == graph_id).filter((node) -> node.node_id == node_id)
        .max_by_key((node) -> node.span.end.saturating_sub(node.span.start)) ?? return .Err(edit_error("not_found", "Canvas insertion pin no longer exists"))
    if node.node_id.ends_with(":entry") -> return .Ok((anchor.insert_offset, "    "))
    insert :: if direction == "input" -> line_start(src, node.span.start) else -> line_after(src, node.span.end)
    indent :: indentation_at(src, node.span.start)
    indent :: if indent.is_empty() -> "    " else -> indent
    return .Ok((insert, indent))
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1465
fn apply_create_comment_region(path: &OSPath, src: String, graph_id: String, start: Usize, end: Usize, title: String, color: String, alpha: String, bounds: String) -> String Err! {
    projection :: project_file(path) ?? return .Err(diagnostics_error(path, src, err))
    if !projection.graph_anchors.iter().any((a) -> a.graph_id == graph_id) -> return .Err(edit_error("not_found", "Canvas graph no longer exists"))
    validate_comment_color(color)?
    validate_comment_alpha(alpha)?
    bounds :: normalize_bounds(bounds)?
    anchor :: SourceSpan { start: start, end: end }
    insert_at :: line_after(src, end.min(src.len()))
    indent :: indentation_at(src, insert_at.min(src.len()))
    comment :: "{indent}// canvas:comment span={anchor.start}..{anchor.end} title={quoted_attr(title)} color={quoted_attr(color)} alpha={alpha} bounds=({bounds})\n"
    changed :: FixEngine.apply_edits(src, [edit(SourceSpan { start: insert_at, end: insert_at }, comment)]) ?? return .Err(edit_error("overlap", "Canvas comment insert overlapped"))
    return write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1513
fn apply_update_comment_region(path: &OSPath, src: String, region_id: String, title: String?, color: String?, alpha: String?, bounds: String?) -> String Err! {
    projection :: project_file(path) ?? return .Err(diagnostics_error(path, src, err))
    hint :: find_comment_hint(src, projection.json, region_id) ?? return .Err(edit_error("not_found", "Canvas comment region no longer exists"))
    color :: color.unwrap_or(hint.color)
    alpha :: alpha.unwrap_or(hint.alpha)
    validate_comment_color(color)?
    validate_comment_alpha(alpha)?
    fallback_bounds :: "{hint.bounds.0},{hint.bounds.1},{hint.bounds.2},{hint.bounds.3}"
    bounds :: normalize_bounds(bounds.unwrap_or(fallback_bounds))?
    title :: title.unwrap_or(hint.title)
    replacement :: "// canvas:comment span={hint.anchor.start}..{hint.anchor.end} title={quoted_attr(title)} color={quoted_attr(color)} alpha={alpha} bounds=({bounds})"
    changed :: FixEngine.apply_edits(src, [edit(hint.hint_span, replacement)]) ?? return .Err(edit_error("overlap", "Canvas comment edit overlapped"))
    return write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1553
fn apply_delete_comment_region(path: &OSPath, src: String, region_id: String) -> String Err! { apply_delete_hint_region(path, src, region_id, "comment") }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1561
fn apply_delete_hint_region(path: &OSPath, src: String, region_id: String, kind: String) -> String Err! {
    projection :: project_file(path) ?? return .Err(diagnostics_error(path, src, err))
    hint :: find_hint_region(src, projection.json, region_id, kind) ?? return .Err(edit_error("not_found", "Canvas source hint no longer exists"))
    span := hint.hint_span
    if span.end < src.len() && src.as_bytes().get(span.end) == .Val(10) -> span.end += 1
    changed :: FixEngine.apply_edits(src, [edit(span, "")]) ?? return .Err(edit_error("overlap", "Canvas source hint delete overlapped"))
    return write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1583
fn apply_create_collapse_region(path: &OSPath, src: String, graph_id: String, start: Usize, end: Usize, title: String) -> String Err! {
    projection :: project_file(path) ?? return .Err(diagnostics_error(path, src, err))
    if !projection.graph_anchors.iter().any((a) -> a.graph_id == graph_id) -> return .Err(edit_error("not_found", "Canvas graph no longer exists"))
    if start >= end || end > src.len() -> return .Err(edit_error("bad_request", "Canvas collapse needs one valid source span"))
    selected :: validated_collapse_selection(path, src, graph_id, SourceSpan { start: start, end: end })?
    if canvas_collapse_hints(src).iter().any((hint) -> hint.anchor.start == selected.start && hint.anchor.end == selected.end) -> return .Err(edit_error("conflict", "Canvas selection is already collapsed"))
    insert_at :: selected.end
    indent :: indentation_at(src, insert_at.min(src.len()))
    comment :: "{indent}// canvas:collapse span={selected.start}..{selected.end} title={quoted_attr(title)}\n"
    changed :: FixEngine.apply_edits(src, [edit(SourceSpan { start: insert_at, end: insert_at }, comment)]) ?? return .Err(edit_error("overlap", "Canvas collapse insert overlapped"))
    return write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1637
fn validated_collapse_selection(path: &OSPath, src: String, graph_id: String, requested: SourceSpan) -> SourceSpan Err! {
    name_span :: graph_id_name_span(graph_id) ?? return .Err(edit_error("bad_request", "Canvas graph id is not a function graph"))
    path_str :: path.to_string_lossy()
    (diags, bundle) :: Driver.check_file(path_str, .None, true)
    errors :: diags.iter().filter((d) -> d.severity == .Error).cloned().collect()
    if !errors.is_empty() -> return .Err(diagnostics_error(path, src, errors))
    bundle :: bundle ?? return .Err(edit_error("check", "Canvas could not read checked statement facts"))
    func :: find_func_by_name_span(bundle, name_span) ?? return .Err(edit_error("not_found", "Canvas graph no longer exists"))
    locs := []
    block := []
    collect_statement_locs(src, func.body, &block, &locs)
    first :: locs.iter().find((loc) -> requested.start == loc.anchor.start || requested.start == loc.source.start || requested.start == loc.full.start)
        .or_else(() -> locs.iter().find((loc) -> loc.is_guard && loc.guard_span.is_some_and((span) -> requested.start >= span.start && requested.start < span.end)))
    last :: locs.iter().find((loc) -> requested.end == loc.anchor.end || requested.end == loc.source.end || requested.end == loc.full.end)
        .or_else(() -> locs.iter().find((loc) -> loc.is_expr && requested.end > loc.source.start && requested.end <= loc.source.end))
    first :: first ?? return .Err(edit_error("bad_request", "Canvas collapse must select whole statements from this graph"))
    last :: last ?? return .Err(edit_error("bad_request", "Canvas collapse must select whole statements from this graph"))
    if first.block != last.block || first.index > last.index -> return .Err(edit_error("cross_block", "Canvas collapse cannot cross a block boundary"))
    return .Ok(SourceSpan { start: first.full.start, end: last.full.end })
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1721
fn extract_inline_candidate(path: &OSPath, src: String, inline_id: String, function: String, ret_type: String) -> String Err! {
    projection :: project_file(path) ?? return .Err(diagnostics_error(path, src, err))
    inline :: projection.inline_exprs.iter().find((i) -> i.id == inline_id) ?? return .Err(edit_error("not_found", "Canvas inline expression no longer exists"))
    expr :: snippet(src, Span.new(inline.span.start, inline.span.end))
    if expr.contains("#Unsafe") -> return .Err(edit_error("diagnostic", "Error [E2203]: Canvas extract cannot cross an unsafe source span"))
    params :: extract_params(projection.json, expr)
    signature :: params.iter().map(((name, ty)) -> "{name}: {ty}").collect().join(", ")
    args :: params.iter().map(((name, _)) -> ~name).collect().join(", ")
    helper :: format("fn {}({}) -> {} {{\n    return {}\n}}\n\n", function, signature, ret_type, expr)
    replacement :: "{function}({args})"
    return FixEngine.apply_edits(src, [edit(SourceSpan { start: 0, end: 0 }, helper), edit(inline.span, replacement)]).map_err((_) -> edit_error("overlap", "Canvas extract edits overlapped"))
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1765
fn inline_helper_candidate(path: &OSPath, src: String, inline_id: String?, start: Usize?, end: Usize?) -> String Err! {
    projection :: project_file(path) ?? return .Err(diagnostics_error(path, src, err))
    span: SourceSpan
    if inline_id == .Val(inline_id) {
        inline :: projection.inline_exprs.iter().find((i) -> i.id == inline_id) ?? return .Err(edit_error("not_found", "Canvas inline expression no longer exists"))
        span = inline.span
    } else -> span = SourceSpan { start: start.unwrap_or(0), end: end.unwrap_or(0) }
    call :: snippet(src, Span.new(span.start, span.end))
    (name, args) :: parse_simple_call(call) ?? return .Err(edit_error("diagnostic", "Canvas inline needs a direct helper call expression"))
    (params, body) :: find_simple_helper(src, name) ?? return .Err(edit_error("diagnostic", "Canvas inline could not find a simple helper return body"))
    if params.len() != args.len() -> return .Err(edit_error("diagnostic", "Canvas inline helper argument count changed"))
    expr := ^body
    for (param, arg) in params.iter().zip(args.iter()) -> expr = replace_ident(expr, param, arg)
    return FixEngine.apply_edits(src, [edit(span, expr)]).map_err((_) -> edit_error("overlap", "Canvas inline helper edit overlapped"))
}
