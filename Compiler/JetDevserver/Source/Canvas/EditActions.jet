// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:37
pub fn apply_transaction_json(path: &OSPath, request: String) -> String Err! {
    run_compiler_work(() -> apply_transaction_json_on_compiler_stack(path, request))
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:41
fn apply_transaction_json_on_compiler_stack(path: &OSPath, request: String) -> String Err! {
    src :: read_source_without_symlinks(path) ?? return .Err(edit_error("io", err.to_string()))
    revision :: required_string(request, "revision")?
    current_revision :: source_revision(src)
    if revision != current_revision -> return .Err(edit_conflict("source changed since this Canvas graph was drawn", current_revision))
    schema :: json_usize_field(request, "schema_version").unwrap_or(0)
    if schema != EDIT_SCHEMA_VERSION as Usize -> return .Err(edit_error("schema", "Canvas edit schema_version must be 1"))
    op :: required_string(request, "op")?
    return if op == {
        "noop" -> apply_noop(path, src)
        "rename_binding" | "rename_function" -> {
            from :: required_string(request, "from")?
            to :: required_string(request, "to")?
            validate_ident(from)?
            validate_ident(to)?
            apply_rename(path, src, from, to)
        }
        "create_function" -> {
            name :: required_string(request, "name")?
            validate_ident(name)?
            params :: json_string_field(request, "params").unwrap_or_default()
            validate_signature_fragment(params)?
            ret_type :: json_string_field(request, "ret_type").unwrap_or("Int")
            validate_type_fragment(ret_type)?
            apply_create_function(path, src, name, params, ret_type)
        }
        "edit_function_signature" -> {
            graph_id :: required_string(request, "graph_id")?
            signature :: required_string(request, "signature")?
            validate_function_signature(signature)?
            apply_edit_function_signature(path, src, graph_id, signature)
        }
        "edit_inline_expr" -> {
            inline_id :: required_string(request, "inline_expr_id")?
            new_expr :: required_string(request, "new_expr")?
            apply_inline_edit(path, src, inline_id, new_expr)
        }
        "promote_to_binding" -> {
            inline_id :: required_string(request, "inline_expr_id")?
            name :: required_string(request, "name")?
            validate_ident(name)?
            apply_promote_inline(path, src, inline_id, name)
        }
        "insert_visible_conversion" -> {
            inline_id :: required_string(request, "inline_expr_id")?
            callee :: required_string(request, "callee")?
            validate_qualified_name(callee)?
            apply_visible_conversion(path, src, inline_id, callee)
        }
        "break_link" -> {
            wire_id :: required_string(request, "wire_id")?
            apply_break_link(path, src, wire_id)
        }
        "move_link" -> {
            wire_id :: required_string(request, "wire_id")?
            replacement :: required_string(request, "replacement")?
            validate_qualified_name(replacement)?
            apply_move_link(path, src, wire_id, replacement)
        }
        "reorder_statements" -> {
            graph_id :: required_string(request, "graph_id")?
            moved :: SourceSpan {
                start: json_usize_field(request, "moved_start").ok_or_else(() -> edit_error("bad_request", "missing `moved_start`"))?,
                end: json_usize_field(request, "moved_end").ok_or_else(() -> edit_error("bad_request", "missing `moved_end`"))?
            }
            anchor :: SourceSpan {
                start: json_usize_field(request, "anchor_start").ok_or_else(() -> edit_error("bad_request", "missing `anchor_start`"))?,
                end: json_usize_field(request, "anchor_end").ok_or_else(() -> edit_error("bad_request", "missing `anchor_end`"))?
            }
            position :: json_string_field(request, "position").unwrap_or("after")
            apply_reorder_statements(path, src, graph_id, moved, anchor, position)
        }
        "add_pattern_arm" -> {
            graph_id :: required_string(request, "graph_id")?
            pattern :: required_string(request, "pattern")?
            validate_single_line_fragment(pattern, "pattern arm text must stay on one line")?
            node :: SourceSpan {
                start: json_usize_field(request, "node_start").ok_or_else(() -> edit_error("bad_request", "missing `node_start`"))?,
                end: json_usize_field(request, "node_end").ok_or_else(() -> edit_error("bad_request", "missing `node_end`"))?
            }
            apply_add_pattern_arm(path, src, graph_id, node, pattern)
        }
        "edit_pattern_arm" -> {
            graph_id :: required_string(request, "graph_id")?
            pattern :: required_string(request, "pattern")?
            validate_single_line_fragment(pattern, "pattern arm text must stay on one line")?
            pattern_span :: SourceSpan {
                start: json_usize_field(request, "pattern_start").ok_or_else(() -> edit_error("bad_request", "missing `pattern_start`"))?,
                end: json_usize_field(request, "pattern_end").ok_or_else(() -> edit_error("bad_request", "missing `pattern_end`"))?
            }
            apply_edit_pattern_arm(path, src, graph_id, pattern_span, pattern)
        }
        "remove_pattern_arm" -> {
            graph_id :: required_string(request, "graph_id")?
            pattern_span :: SourceSpan {
                start: json_usize_field(request, "pattern_start").ok_or_else(() -> edit_error("bad_request", "missing `pattern_start`"))?,
                end: json_usize_field(request, "pattern_end").ok_or_else(() -> edit_error("bad_request", "missing `pattern_end`"))?
            }
            apply_remove_pattern_arm(path, src, graph_id, pattern_span)
        }
        "toggle_switch_state" -> {
            graph_id :: required_string(request, "graph_id")?
            node_span :: SourceSpan {
                start: json_usize_field(request, "node_start").ok_or_else(() -> edit_error("bad_request", "missing `node_start`"))?,
                end: json_usize_field(request, "node_end").ok_or_else(() -> edit_error("bad_request", "missing `node_end`"))?
            }
            apply_toggle_switch_state(path, src, graph_id, node_span)
        }
        "append_multi_input" -> {
            element :: json_string_field(request, "element").unwrap_or("1")
            validate_single_line_fragment(element, "multi-input element must stay on one line")?
            node :: SourceSpan {
                start: json_usize_field(request, "node_start").ok_or_else(() -> edit_error("bad_request", "missing `node_start`"))?,
                end: json_usize_field(request, "node_end").ok_or_else(() -> edit_error("bad_request", "missing `node_end`"))?
            }
            apply_append_multi_input(path, src, node, element)
        }
        "remove_multi_input_element" -> {
            node :: SourceSpan {
                start: json_usize_field(request, "node_start").ok_or_else(() -> edit_error("bad_request", "missing `node_start`"))?,
                end: json_usize_field(request, "node_end").ok_or_else(() -> edit_error("bad_request", "missing `node_end`"))?
            }
            element :: SourceSpan {
                start: json_usize_field(request, "element_start").ok_or_else(() -> edit_error("bad_request", "missing `element_start`"))?,
                end: json_usize_field(request, "element_end").ok_or_else(() -> edit_error("bad_request", "missing `element_end`"))?
            }
            apply_remove_multi_input_element(path, src, node, element)
        }
        "replace_source" -> {
            if json_string_field(request, "source_edit") == .Val("exec_convergence") {
                graph_id :: required_string(request, "graph_id")?
                from_pin_name :: required_string(request, "from_pin_name")?
                strategy :: required_string(request, "strategy")?
                function :: required_string(request, "function")?
                from_span :: SourceSpan {
                    start: json_usize_field(request, "from_start").ok_or_else(() -> edit_error("bad_request", "missing `from_start`"))?,
                    end: json_usize_field(request, "from_end").ok_or_else(() -> edit_error("bad_request", "missing `from_end`"))?
                }
                target_span :: SourceSpan {
                    start: json_usize_field(request, "target_start").ok_or_else(() -> edit_error("bad_request", "missing `target_start`"))?,
                    end: json_usize_field(request, "target_end").ok_or_else(() -> edit_error("bad_request", "missing `target_end`"))?
                }
                return apply_exec_convergence(path, src, graph_id, from_span, target_span, from_pin_name, strategy, function, json_string_field(request, "helper_name"))
            }
            source :: required_string(request, "source")?
            if json_string_field(request, "undo_restore").is_some() -> write_checked_source(path, src, source)
            else -> write_checked_formatted(path, src, source)
        }
        "insert_branch" | "insert_switch" | "insert_loop" | "insert_fallible_rail" -> {
            graph_id :: required_string(request, "graph_id")?
            apply_insert_structural(path, src, graph_id, op, json_string_field(request, "wire_origin_pin_id"), json_string_field(request, "wire_target_pin"))
        }
        "create_comment_region" -> {
            graph_id :: required_string(request, "graph_id")?
            title :: required_string(request, "title")?
            color :: json_string_field(request, "color").unwrap_or("#2563eb")
            alpha :: json_string_field(request, "alpha").unwrap_or("0.18")
            start :: json_usize_field(request, "start").unwrap_or(0)
            end :: json_usize_field(request, "end").unwrap_or(start)
            bounds :: json_string_field(request, "bounds").unwrap_or("0,0,360,180")
            apply_create_comment_region(path, src, graph_id, start, end, title, color, alpha, bounds)
        }
        "edit_comment_region" | "move_comment_region" | "resize_comment_region" -> {
            region_id :: required_string(request, "region_id")?
            apply_update_comment_region(path, src, region_id, json_string_field(request, "title"), json_string_field(request, "color"), json_string_field(request, "alpha"), json_string_field(request, "bounds"))
        }
        "delete_comment_region" -> {
            region_id :: required_string(request, "region_id")?
            apply_delete_comment_region(path, src, region_id)
        }
        "create_collapsed_region" -> {
            graph_id :: required_string(request, "graph_id")?
            title :: required_string(request, "title")?
            start :: json_usize_field(request, "start").unwrap_or(0)
            end :: json_usize_field(request, "end").unwrap_or(start)
            apply_create_collapse_region(path, src, graph_id, start, end, title)
        }
        "expand_collapsed_region" -> {
            region_id :: required_string(request, "region_id")?
            apply_delete_hint_region(path, src, region_id, "collapse")
        }
        "extract_inline_expr" | "preview_extract_inline_expr" -> {
            inline_id :: required_string(request, "inline_expr_id")?
            function :: required_string(request, "function")?
            validate_ident(function)?
            ret_type :: json_string_field(request, "ret_type").unwrap_or("Int")
            candidate :: extract_inline_candidate(path, src, inline_id, function, ret_type)?
            if op == "preview_extract_inline_expr" -> .Ok(preview_ok(src, candidate))
            else -> write_checked_formatted(path, src, candidate)
        }
        "inline_helper_call" -> {
            inline_id :: json_string_field(request, "inline_expr_id")
            start :: json_usize_field(request, "start")
            end :: json_usize_field(request, "end")
            candidate :: inline_helper_candidate(path, src, inline_id, start, end)?
            write_checked_formatted(path, src, candidate)
        }
        "insert_call" -> {
            graph_id :: required_string(request, "graph_id")?
            callee :: required_string(request, "callee")?
            validate_qualified_name(callee)?
            args :: json_string_array(request, "args")
            bind :: json_string_field(request, "bind")
            wire_inline_expr_id :: json_string_field(request, "wire_inline_expr_id")
            wire_expr :: json_string_field(request, "wire_expr")
            wire_origin_pin_id :: json_string_field(request, "wire_origin_pin_id")
            wire_target_pin :: json_string_field(request, "wire_target_pin")
            module_path :: json_string_field(request, "module_path")
            if bind == .Val(name) -> validate_ident(name)?
            if wire_expr == .Val(expr) -> validate_qualified_name(expr)?
            if module_path == .Val(module) -> validate_qualified_name(module)?
            apply_insert_call(path, src, graph_id, callee, args, bind, wire_inline_expr_id, wire_expr, wire_origin_pin_id, wire_target_pin, module_path)
        }
        "create_trait_impl" -> {
            type_name :: required_string(request, "type_name")?
            trait_name :: required_string(request, "trait_name")?
            validate_qualified_name(type_name)?
            validate_qualified_name(trait_name)?
            apply_create_trait_impl(path, src, type_name, trait_name)
        }
        "preview_canvas_action" -> {
            graph_id :: required_string(request, "graph_id")?
            action_id :: required_string(request, "action_id")?
            callee :: required_string(request, "callee")?
            validate_qualified_name(callee)?
            args :: json_string_array(request, "args")
            candidate :: canvas_action_candidate(path, src, graph_id, action_id, callee, args)?
            .Ok(canvas_action_preview_ok(path, src, candidate, action_id, callee))
        }
        _ -> .Err(edit_error("unsupported", "unknown Canvas edit operation"))
    }
}

// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:375
fn apply_noop(path: &OSPath, _src: String) -> String Err! { .Ok(edit_ok(false, path)) }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:379
fn apply_rename(path: &OSPath, src: String, from: String, to: String) -> String Err! {
    idx :: semindex.open(path) ?? return .Err(edit_error("check", err.to_string()))
    edits := []
    for def in idx.definitions().iter().filter((d) -> d.name == from) -> edits.push(edit(def.def_span, to))
    for r in idx.references().iter().filter((r) -> r.name == from) -> edits.push(edit(r.span, to))
    if edits.is_empty() -> return .Err(edit_error("not_found", "Canvas rename found no matching binding"))
    changed :: FixEngine.apply_edits(src, edits) ?? return .Err(edit_error("overlap", "Canvas rename edits overlapped"))
    formatted :: format_source(changed) ?? return .Err(diagnostics_error(path, changed, err))
    result :: write_checked_source(path, src, formatted)?
    if formatted != src -> record_canvas_rename(path, src, formatted, from, to, idx)?
    return .Ok(^result)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:405
fn record_canvas_rename(path: &OSPath, before: String, after: String, from: String, to: String, index: &SemIndex) -> Unit Err! {
    // GATE #4494: symlink-safe exclusive creation; #4409: AlreadyExists receipt collision.
    project :: path.parent().unwrap_or_else(() -> OSPath.new("."))
    directory :: project.join(".jet/codemods")
    ensure_no_symlink_directory(directory) ?? return .Err(edit_error("io", "could not record semantic rename: {err}"))
    before_hash :: sha256_hex(before.as_bytes())
    after_hash :: sha256_hex(after.as_bytes())
    targets :: index.definition_facts().iter().filter((fact) -> fact.name == from).map((fact) ->
        format("{{\"stable_id\":{},\"before\":{},\"after\":{},\"kind\":{},\"module_path\":{}}}", json_str(fact.stable_id), json_str(fact.human_identity), json_str("{fact.module_path}::{to}"), json_str(fact.kind), json_str(fact.module_path))).collect().join(",")
    file :: format("{{\"path\":{},\"before_hash\":{},\"after_hash\":{}}}", json_str(path.display().to_string()), json_str(before_hash), json_str(after_hash))
    op :: format("{{\"kind\":\"rename\",\"from\":{},\"to\":{},\"targets\":[{}],\"files\":[{}]}}", json_str(from), json_str(to), targets, file)
    hash_prefix := after_hash[..12] // #4303
    base :: "CanvasRename-{hash_prefix}"
    receipt := directory.join("{base}.log.json")
    suffix := 0
    log :: format("{{\"schema\":2,\"name\":{},\"project\":{},\"semantic_ops\":[{}],\"files\":[{}]}}\n", json_str(base), json_str(project.display().to_string()), op, file)
    loop {
        if write_new_file_without_symlinks(receipt, log.as_bytes()) == {
            .Ok(_) -> return .Ok(())
            .Err(error) -> {
                if error.kind() == ErrorKind.AlreadyExists {
                    suffix += 1
                    receipt = directory.join("{base}-{suffix}.log.json")
                } else -> return .Err(edit_error("io", "could not record semantic rename: {error}"))
            }
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:475
fn apply_create_function(path: &OSPath, src: String, name: String, params: String, ret_type: String) -> String Err! {
    body :: if ret_type == "Void" -> "" else -> "    return {default_arg_for_type(ret_type)}\n"
    // D-SIG-AFTER1=A: one mandatory arrow even when the return type is absent.
    ret :: if ret_type == "Void" -> " ->" else -> " -> {ret_type}"
    function :: format("fn {}({}){} {{\n{}}}\n\n", name, params, ret, body)
    changed :: FixEngine.apply_edits(src, [edit(SourceSpan { start: 0, end: 0 }, function)]) ?? return .Err(edit_error("overlap", "Canvas create function edit overlapped"))
    return write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:498
fn apply_create_trait_impl(path: &OSPath, src: String, type_name: String, trait_name: String) -> String Err! {
    path_str :: path.to_string_lossy()
    (diags, bundle) :: Driver.check_file(path_str, .None, true)
    errors :: diags.iter().filter((d) -> d.severity == .Error).cloned().collect()
    if !errors.is_empty() -> return .Err(diagnostics_error(path, src, errors))
    bundle :: bundle ?? return .Err(edit_error("check", "Canvas could not read checked trait facts"))
    location :: find_trait_location(bundle, path, trait_name) ?? return .Err(edit_error("not_found", "Canvas trait was not found in source"))
    trait_def :: location.trait_def
    if !trait_def.assoc_types.is_empty() -> return .Err(edit_error("needs_associated_types", "Canvas will not guess associated type implementations; add each associated type in source first"))
    body := ""
    for method in trait_def.methods.iter().filter((method) -> method.default_body.is_none()) {
        sig :: trait_method_signature(src, method)
        body.push_str("    ")
        body.push_str(sig)
        // The canonical signature owns the single arrow (including effect rows).
        body.push_str(" {\n")
        if method.return_type.as_ref() == .Val(ret) {
            if ret.name() != "Void" {
                body.push_str("        return ")
                body.push_str(default_arg_for_type(ret.name()))
                body.push('\n')
            }
        }
        body.push_str("    }\n")
    }
    local_trait_name :: trait_name.rsplit('.').next().unwrap_or(trait_name)
    insert_at :: if location.scope.is_empty() -> src.len() else -> line_start(src, location.module_close)
    item_indent :: if location.scope.is_empty() -> "" else -> indentation_at(src, trait_def.span.start)
    prefix_view := src[..insert_at] // #4303
    prefix :: if insert_at == 0 || prefix_view.ends_with('\n') -> "" else -> "\n"
    method_body :: body.lines().map((line) -> "{item_indent}{line}\n").collect[String]()
    impl_block :: format("{}{}impl {}.{} {{\n{}{}}}\n", prefix, item_indent, type_name, local_trait_name, method_body, item_indent)
    changed :: FixEngine.apply_edits(src, [edit(SourceSpan { start: insert_at, end: insert_at }, impl_block)]) ?? return .Err(edit_error("overlap", "Canvas trait impl edit overlapped"))
    return write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:598
struct TraitLocation { trait_def: &AST.TraitDef; scope: [String]; module_close: Usize }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:604
fn source_trait_path(bundle: &AST.ProgramBundle, module_idx: Usize, module_alias: String, name: String, span: Span, fallback_scope: &[String]) -> String? {
    ledger :: &bundle.name_ledger
    path :: ["{module_alias}.{name}", if fallback_scope.is_empty() -> "{module_alias}.{name}" else -> "{module_alias}.{fallback_scope.join(".")}.{name}"]
        .into_iter().find_map((candidate) -> ledger.display_path(module_idx, candidate, .Val(module_idx)))
        .or_else(() -> ledger.canonical_path_at(module_idx, span.start, span.end))?
    return .Val(path.strip_prefix(module_alias).and_then((rest) -> rest.strip_prefix('.')).unwrap_or(path).to_string())
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:632
fn enclosing_inline_module(items: &[Item], position: Usize) -> ([String], Usize)? {
    for item in items {
        module :: if item == .CodeModule(module) -> module else -> continue
        body :: module.body.as_ref() ?? continue
        if !(module.span.start <= position && position < module.span.end) -> continue
        if enclosing_inline_module(body, position) == .Val((scope, close)) {
            scope.insert(0, ~module.name)
            return .Val((^scope, close))
        }
        return .Val(([~module.name], module.span.end.saturating_sub(1)))
    }
    return .None
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:652
fn find_trait_location(bundle: &AST.ProgramBundle, path: &OSPath, trait_name: String) -> TraitLocation? {
    parts :: trait_name.split('.').collect()
    local_name :: parts.last().copied().unwrap_or(trait_name)
    requested_scope := parts[..parts.len().saturating_sub(1)]
    source_path :: canonical_path(path)
    // Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:662
    fn find_in_items(items: &[Item], scope: &[String], requested_scope: &[String], requested_name: String, local_name: String,
        module_idx: Usize, module_alias: String, root_items: &[Item], source_len: Usize, bundle: &AST.ProgramBundle) -> TraitLocation? {
        for item in items {
            if item == {
                .Trait(t) -> {
                    display_path :: source_trait_path(bundle, module_idx, module_alias, t.name, t.name_span, scope)
                    fallback_match :: t.name == local_name && scope.iter().map((s) -> s.as_str()).eq(requested_scope.iter().copied())
                    if display_path != .Val(requested_name) && !fallback_match -> continue
                    (found_scope, module_close) :: enclosing_inline_module(root_items, t.name_span.start).unwrap_or_else(() -> (~scope, source_len))
                    found_scope :: display_path.as_ref().and_then((path) -> path.rsplit_once('.')).map(((scope, _)) -> scope.split('.').map((s) -> s.to_string()).collect()).unwrap_or(^found_scope)
                    return .Val(TraitLocation { trait_def: t, scope: ^found_scope, module_close: module_close })
                }
                .CodeModule(m) -> {
                    if m.body.as_ref() == .Val(body) {
                        scope.push(~m.name)
                        if find_in_items(body, scope, requested_scope, requested_name, local_name, module_idx, module_alias, root_items, source_len, bundle) == .Val(t) -> return .Val(t)
                        _ :: scope.pop()
                    }
                }
                _ -> {}
            }
        }
        return .None
    }
    for (module_idx, module) in bundle.modules.iter().enumerate() {
        if canonical_path(module.path) != source_path -> continue
        scope := []
        if find_in_items(module.items, &scope, requested_scope, trait_name, local_name, module_idx, module.alias, module.items, module.source.len(), bundle) == .Val(t) -> return .Val(t)
    }
    return .None
}
