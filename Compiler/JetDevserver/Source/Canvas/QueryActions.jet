// The Canvas queries: find, references and rename previews over one file or
// the whole project, the source-to-graph jump, and the action and Core
// catalogs the palette lists. Every semantic answer reads the index the
// host's `LSPChecker` built for the checked file.
use {
    query_files: core.files
    jet_canvas.[
        NodeQueryRef, Projection, QUERY_SCHEMA_VERSION, insert_descriptor_id, json_bool, json_optional_str, json_str, palette_rank_fields, query_error,
        read_source_without_symlinks, source_revision, span_json,
    ]
    jet_driver.[jet_driver_apply_edits, jet_driver_has_errors]
    jet_foundation.[CORE_MODULE_EXPORTS, CoreTypedCallSignature, Span, TextEdit, core_call, core_call_typed_signature, diagnostic_render_all, type_name]
    jet_impact.[ImpactReport]
    jet_lsp.[LSPChecker, LSPOverlay]
    jet_pkg_model.[WorkspaceDeclarationCache, pkg_find_manifest_root_checked, pkg_package_facts_for_entry]
    jet_semindex.[SemCallable, SemDef, SemIndex, SemRef]
}

PROJECT_QUERY_RESULT_LIMIT: 200
CORE_REGISTRY_SOURCE: "Compiler/JetFoundation/Source/Registry/CoreCallRows.jet"
CORE_REGISTRY_MODULE_SUMMARY: "Compiler-known Core module from the Core export registry."

// One project source with the semantic index of its own check.
ProjectSourceIndex: struct {
    path: String
    source_id: String
    source: String
    revision: String
    index: SemIndex
}

ProjectQueryContext: struct {
    project_root: String
    project_revision: String
    selected_source_id: String
    selected_path: String
    selected_source: String
    sources: [ProjectSourceIndex]
}

// A definition found in the project and the source (by position in
// `ProjectQueryContext.sources`) that owns it.
ProjectDefinitionHit: struct {
    source: Int
    def: SemDef
}

// One input pin of a palette entry: its name and written type.
CanvasParam: struct {
    name: String
    ty: String
}

CanvasAuthority: struct {
    grant: String
    package_id: String
    version: String
    touched_file: String
    project_root: String
}

CoreCatalogModule: struct {
    path: String
    title: String
    summary: String
    members: [CoreCatalogMember]
}

CoreCatalogMember: struct {
    name: String
    signature: String
    summary: String
    source: String
    pure: Bool
}

// A Core module's compiler-known members.
CoreCatalogExport: struct {
    path: String
    names: [String]
}

// Why a Core entry can't be inserted as a direct call; an empty code inserts.
CoreMemberReason: struct {
    code: String
    reason: String
}

CoreMemberStatus: struct {
    available: Bool
    stageable: Bool
    stage_reason_code: String
    stage_reason: String
    receiver_type: String
    unavailable_reason_code: String
    unavailable_reason: String
}

canvas_find: fn(checker: LSPChecker, path: String, src: String, query: String) -> String Err! {
    context: open_query_context(checker, path, src)
    needle: query.trim()
    if needle.is_empty() -> return Ok(query_ok("find", src, "[]", "\"impact\":null,\"diff\":null"))
    results := [String]{}
    loop definition in context.index.definitions {
        def: definition.def
        if contains_ci(def.name, needle) || contains_ci(def.identity, needle) {
            results.push(query_result_json("definition", def.name, def.name, def.module_path, def.def_span, node_for_span(context.projection, def.def_span), src))
        }
    }
    loop reference in context.index.references {
        if contains_ci(reference.name, needle) {
            results.push(query_result_json("reference", reference.name, reference.name, reference.module_path, reference.span, node_for_span(context.projection, reference.span), src))
        }
    }
    loop node in context.projection.node_refs {
        if contains_ci(node.title, needle) || contains_ci(node.kind, needle) {
            results.push(query_result_json("graph", node.title, node.title, "", node.span, Val(node), src))
        }
    }
    loop span in text_matches(src, needle) {
        results.push(query_result_json("source", needle, needle, path, span, node_for_span(context.projection, span), src))
    }
    dedupe_results(results)
    Ok(query_ok("find", src, "[{results.join(",")}]", "\"impact\":null,\"diff\":null"))
}

canvas_project_find: fn(checker: LSPChecker, entry: String, selected_path: String, selected_src: String, query: String, expected_project_revision: String?) -> String Err! {
    context: open_project_query_context(checker, entry, selected_path, selected_src, expected_project_revision)
    needle: query.trim()
    results := [String]{}
    seen := [String:Bool]{}
    if !needle.is_empty() {
        projection: project_file(checker, selected_path) ?? return Err(query_diagnostics_error(selected_path, selected_src, err.diagnostics))
        loop at in 0..<context.sources.len() {
            source: context.sources[at]
            loop definition in source.index.definitions {
                def: definition.def
                if !module_belongs_to(context.project_root, source.path, def.module_path) -> next
                if !contains_ci(def.name, needle) && !contains_ci(def.identity, needle) -> next
                owner: project_source_owner(context, at, def.module_path)
                push_project_result(results, seen, "definition", def.name, def.module_path, def.def_span, context.sources[owner], Val(projection), context.selected_source_id)
            }
            loop reference in source.index.references {
                if !module_belongs_to(context.project_root, source.path, reference.module_path) || !contains_ci(reference.name, needle) -> next
                owner: project_source_owner(context, at, reference.module_path)
                push_project_result(results, seen, "reference", reference.name, reference.module_path, reference.span, context.sources[owner], Val(projection), context.selected_source_id)
            }
            loop span in text_matches(source.source, needle) {
                push_project_result(results, seen, "source", needle, source.source_id, span, source, Val(projection), context.selected_source_id)
            }
        }
        loop node in projection.node_refs {
            if !contains_ci(node.title, needle) && !contains_ci(node.kind, needle) -> next
            selected: project_source_at(context.sources, context.selected_source_id) ?? return Err(query_error("not_found", "Canvas query source is not in the projected project"))
            push_project_result(results, seen, "graph", node.title, context.selected_source_id, node.span, context.sources[selected], Val(projection), context.selected_source_id)
        }
    }
    Ok(project_query_ok("project_search", context, results, "\"impact\":null,\"diff\":null"))
}

canvas_references: fn(checker: LSPChecker, path: String, src: String, symbol: String) -> String Err! {
    context: open_query_context(checker, path, src)
    results := [String]{}
    loop definition in context.index.definitions {
        def: definition.def
        if def.name != symbol -> next
        results.push(query_result_json("definition", def.name, def.name, def.module_path, def.def_span, node_for_span(context.projection, def.def_span), src))
    }
    loop reference in context.index.references {
        if reference.name != symbol -> next
        results.push(query_result_json("reference", reference.name, reference.name, reference.module_path, reference.span, node_for_span(context.projection, reference.span), src))
    }
    impact: ImpactReport.analyze(context.index, symbol, 3).to_json()
    Ok(query_ok("references", src, "[{results.join(",")}]", "\"impact\":{impact},\"diff\":null"))
}

canvas_project_references: fn(checker: LSPChecker, entry: String, selected_path: String, selected_src: String, symbol: String, expected_project_revision: String?) -> String Err! {
    context: open_project_query_context(checker, entry, selected_path, selected_src, expected_project_revision)
    projection: project_file(checker, selected_path) ?? return Err(query_diagnostics_error(selected_path, selected_src, err.diagnostics))
    definitions: project_symbol_definitions(context, symbol, true)
    results := [String]{}
    seen := [String:Bool]{}
    loop hit in definitions {
        push_project_result(results, seen, "definition", hit.def.name, hit.def.module_path, hit.def.def_span, context.sources[hit.source], Val(projection), context.selected_source_id)
    }
    push_project_references(results, seen, context, symbol, definitions, projection)
    impact := "null"
    loop source in context.sources {
        if index_defines(source.index, symbol) {
            impact = ImpactReport.analyze(source.index, symbol, 3).to_json()
            break
        }
    }
    Ok(project_query_ok("references", context, results, "\"impact\":{impact},\"diff\":null"))
}

canvas_project_preview_rename: fn(checker: LSPChecker, entry: String, selected_path: String, selected_src: String, symbol: String, to: String, expected_project_revision: String?) -> String Err! {
    context: open_project_query_context(checker, entry, selected_path, selected_src, expected_project_revision)
    project: project_context_for_entry(entry)
    if project.project_revision != context.project_revision -> return Err(query_error("conflict", "project changed while Canvas was preparing its rename"))
    projection: project_file(checker, selected_path) ?? return Err(query_diagnostics_error(selected_path, selected_src, err.diagnostics))
    plan: prepare_project_rename(checker, project, selected_path, symbol, to, None) ?? return Err(query_error(err.kind, err.message))
    changes := plan.changes
    normalize_and_format_project_changes(project, changes) ?? return Err(query_error("check", err.message))
    validate_project_rename_overlay(checker, project, changes) ?? return Err(query_error("check", err.message))
    definitions: project_symbol_definitions(context, symbol, false)
    results := [String]{}
    seen := [String:Bool]{}
    loop hit in definitions {
        push_project_result(results, seen, "definition", hit.def.name, hit.def.module_path, hit.def.def_span, context.sources[hit.source], Val(projection), context.selected_source_id)
    }
    push_project_references(results, seen, context, symbol, definitions, projection)
    files: loop change in changes -> "{{\"path\":{json_str(change.rel)},\"revision\":{json_str(source_revision(change.before))},\"after_revision\":{json_str(source_revision(change.after))},\"changed\":{json_bool(change.before != change.after)}}}"
    diffs: loop change in changes -> "diff -- {change.rel}\n{simple_diff(change.before, change.after)}"
    after_project_revision: project_revision_after_changes(project, changes)
    selected_after_revision := "null"
    loop change in changes {
        if change.rel == context.selected_source_id {
            selected_after_revision = json_str(source_revision(change.after))
            break
        }
    }
    Ok(project_query_ok("preview_rename", context, results, "\"impact\":null,\"diff\":{{\"changed\":true,\"text\":{json_str(diffs.join("\n"))},\"after_revision\":{selected_after_revision},\"after_project_revision\":{json_str(after_project_revision)},\"files\":[{files.join(",")}]}}"))
}

// Index every source file of the project the entry belongs to, refusing a
// query drawn against an older project or selected source revision.
open_project_query_context: fn(checker: LSPChecker, entry: String, selected_path: String, selected_src: String, expected_project_revision: String?) -> ProjectQueryContext Err! {
    project: project_context_for_entry(entry)
    if project.authority_diagnostic == .Val(diagnostic) -> return Err(query_error("stale", diagnostic.what))
    if expected_project_revision == .Val(expected) {
        if expected != project.project_revision -> return Err(query_error("conflict", "project changed since this Canvas query was drawn"))
    }
    selected_source_id: rel_path(project.project_root, selected_path)
    sources := [ProjectSourceIndex]{}
    loop file in project.files {
        if file.kind != "source" -> next
        path: query_files.join(project.project_root, file.path)
        source: read_source_without_symlinks(path) ?? return Err(query_error("stale", "Canvas project source moved or unreadable: {err.message}"))
        revision: source_revision(source)
        if revision != file.revision -> return Err(query_error("conflict", "project source changed while Canvas was building its query"))
        checked: checker.check(path, [LSPOverlay]{LSPOverlay{path: path, source: source}})
        if jet_driver_has_errors(checked.diagnostics) -> return Err(query_error("check", diagnostic_render_all(path, source, checked.diagnostics, false)))
        index: checked.index ?? return Err(query_error("check", "Canvas has no semantic index for `{file.path}`"))
        sources.push(ProjectSourceIndex{path: path, source_id: file.path.removeprefix("./"), source: source, revision: revision, index: index})
    }
    selected: project_source_at(sources, selected_source_id) ?? return Err(query_error("not_found", "Canvas query source is not in the projected project"))
    if sources[selected].revision != source_revision(selected_src) -> return Err(query_error("conflict", "source changed since this Canvas graph was drawn"))
    after: project_context_for_entry(entry)
    if after.project_revision != project.project_revision -> return Err(query_error("conflict", "project changed while Canvas was building its query"))
    Ok(ProjectQueryContext{
        project_root: project.project_root,
        project_revision: project.project_revision,
        selected_source_id: selected_source_id,
        selected_path: selected_path,
        selected_source: selected_src,
        sources: sources,
    })
}

project_source_at: fn(sources: [ProjectSourceIndex], source_id: String) -> Int? Never! {
    loop at in 0..<sources.len() {
        if sources[at].source_id == source_id -> return Val(at)
    }
    None
}

// The source whose file holds `module_path`, else `fallback`.
project_source_owner: fn(context: ProjectQueryContext, fallback: Int, module_path: String) -> Int {
    loop at in 0..<context.sources.len() {
        if module_belongs_to(context.project_root, context.sources[at].path, module_path) -> return at
    }
    fallback
}

// Every definition named `symbol` in the project's indexes; `by_owner`
// credits each to the source that holds its module.
project_symbol_definitions: fn(context: ProjectQueryContext, symbol: String, by_owner: Bool) -> [ProjectDefinitionHit] {
    hits := [ProjectDefinitionHit]{}
    loop at in 0..<context.sources.len() {
        loop definition in context.sources[at].index.definitions {
            if definition.def.name != symbol -> next
            source: if by_owner -> project_source_owner(context, at, definition.def.module_path) else -> at
            hits.push(ProjectDefinitionHit{source: source, def: definition.def})
        }
    }
    hits
}

push_project_references: fn(results: &[String], seen: &[String:Bool], context: ProjectQueryContext, symbol: String, definitions: [ProjectDefinitionHit], projection: Projection) {
    loop at in 0..<context.sources.len() {
        source: context.sources[at]
        loop reference in source.index.references {
            if reference.name != symbol || !module_belongs_to(context.project_root, source.path, reference.module_path) || !reference_targets(reference, definitions) -> next
            owner: project_source_owner(context, at, reference.module_path)
            push_project_result(results, seen, "reference", reference.name, reference.module_path, reference.span, context.sources[owner], Val(projection), context.selected_source_id)
        }
    }
}

index_defines: fn(index: SemIndex, symbol: String) -> Bool Never! {
    loop definition in index.definitions {
        if definition.def.name == symbol -> return true
    }
    false
}

// Whether `reference` resolves to one of `definitions`; an unresolved
// reference counts only when there is no definition to resolve to.
reference_targets: fn(reference: SemRef, definitions: [ProjectDefinitionHit]) -> Bool Never! {
    target: reference.target ?? return definitions.len() == 0
    loop hit in definitions {
        if target.semantic_identity == .Val(identity) && identity == hit.def.identity -> return true
        if target.module_path == hit.def.module_path && target.def_span.start == hit.def.def_span.start && target.def_span.end == hit.def.def_span.end -> return true
    }
    false
}

// One project result, kept once per kind, source, span and title; a result
// in the selected source names its graph node.
push_project_result: fn(results: &[String], seen: &[String:Bool], kind: String, title: String, module_path: String, span: Span, source: ProjectSourceIndex, projection: Projection?, selected_source_id: String) {
    key: "{kind}|{source.source_id}|{span.start}|{span.end}|{title}"
    if seen.has_key(key) -> return
    seen[key] = true
    node := NodeQueryRef?{None}
    if source.source_id == selected_source_id && projection == .Val(value) -> node = node_for_span(value, span)
    result: query_result_json(kind, title, title, module_path, span, node, source.source)
    results.push("{result.slice(0, result.len() - 1)},\"source_id\":{json_str(source.source_id)},\"revision\":{json_str(source.revision)}}}")
}

// The sorted results, cut to PROJECT_QUERY_RESULT_LIMIT of them.
project_query_ok: fn(op: String, context: ProjectQueryContext, results: &[String], extra_fields: String) -> String Never! {
    results.sort()
    truncated: results.len() > PROJECT_QUERY_RESULT_LIMIT
    loop results.len() > PROJECT_QUERY_RESULT_LIMIT {
        last: results.len() - 1
        _ := results.remove(last, .Slot)
    }
    "{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{QUERY_SCHEMA_VERSION},\"ok\":true,\"op\":{json_str(op)},\"revision\":{json_str(source_revision(context.selected_source))},\"source_id\":{json_str(context.selected_source_id)},\"project_revision\":{json_str(context.project_revision)},\"results\":[{results.join(",")}],\"result_limit\":{PROJECT_QUERY_RESULT_LIMIT},\"truncated\":{json_bool(truncated)},{extra_fields} }}"
}

canvas_source_to_graph: fn(checker: LSPChecker, path: String, src: String, span: Span) -> String Err! {
    projection: project_file(checker, path) ?? return Err(query_diagnostics_error(path, src, err.diagnostics))
    results := [String]{}
    loop node in projection.node_refs {
        if spans_overlap(node.span, span) -> results.push(query_result_json("source_to_graph", node.title, node.title, "", node.span, Val(node), src))
    }
    if results.len() == 0 && nearest_node(projection, span.start) == .Val(node) {
        results.push(query_result_json("source_to_graph", node.title, node.title, "", node.span, Val(node), src))
    }
    Ok(query_ok("source_to_graph", src, "[{results.join(",")}]", "\"impact\":null,\"diff\":null"))
}

canvas_preview_rename: fn(checker: LSPChecker, path: String, src: String, symbol: String, to: String) -> String Err! {
    context: open_query_context(checker, path, src)
    edits := [TextEdit]{}
    results := [String]{}
    loop definition in context.index.definitions {
        def: definition.def
        if def.name != symbol -> next
        edits.push(edit(def.def_span, to))
        results.push(query_result_json("definition", def.name, def.name, def.module_path, def.def_span, node_for_span(context.projection, def.def_span), src))
    }
    loop reference in context.index.references {
        if reference.name != symbol -> next
        edits.push(edit(reference.span, to))
        results.push(query_result_json("reference", reference.name, reference.name, reference.module_path, reference.span, node_for_span(context.projection, reference.span), src))
    }
    if edits.len() == 0 -> return Err(query_error("not_found", "Canvas rename preview found no matching symbol"))
    changed: jet_driver_apply_edits(src, edits) ?? return Err(query_error("overlap", "Canvas rename preview edits overlapped"))
    Ok(query_ok("preview_rename", src, "[{results.join(",")}]", "\"impact\":null,\"diff\":{{\"changed\":{json_bool(changed != src)},\"text\":{json_str(simple_diff(src, changed))},\"after_revision\":{json_str(source_revision(changed))}}}"))
}

// The palette: the project's callable functions, `print`, the Core catalog,
// the file's game edits, and the structural and command actions.
canvas_actions: fn(checker: LSPChecker, path: String, src: String) -> String Err! {
    context: open_query_context(checker, path, src)
    authority: canvas_authority_context(path)
    entries := [String]{}
    project_functions := [String]{}
    loop definition in context.index.definitions {
        def: definition.def
        if def.kind == .Function(callable) {
            if def.module_path.starts_with("core.") -> next
            callee: callable_export_callee(context.callable_exports, def) ?? next
            params: callable_params(callable)
            ret: callable_return(callable)
            pure: callable_is_pure(callable)
            project_functions.push(project_function_catalog_json(def, params, ret, pure, callee))
            if def.name == "run" -> next
            entries.push(canvas_action_json(def, params, ret, pure, callee, authority))
        }
    }
    entries.push(canvas_builtin_action_json("print", "Print", [CanvasParam]{CanvasParam{name: "value", ty: "Any"}}, "Void", [String]{"\"canvas\""}, authority))
    loop entry in canvas_core_catalog_action_jsons(src, authority) -> entries.push(entry)
    revision: source_revision(src)
    loop fact in context.game_facts -> entries.push(canvas_game_action_json(fact, authority, revision))
    loop entry in canvas_structural_action_jsons(authority) -> entries.push(entry)
    loop entry in canvas_command_action_jsons(authority) -> entries.push(entry)
    entries.sort()
    project_functions.sort()
    Ok(query_ok("actions", src, "[]", "\"impact\":null,\"diff\":null,\"actions_schema_version\":{ACTION_SCHEMA_VERSION},\"project_functions\":[{project_functions.join(",")}],\"actions\":[{entries.join(",")}]"))
}

// The callee an insertion in the entry module writes for `def`, when the
// entry module can call it.
callable_export_callee: fn(exports: [CanvasCallableExport], def: SemDef) -> String? Never! {
    loop export in exports {
        if export.module_path == def.module_path && export.span.start == def.def_span.start && export.span.end == def.def_span.end -> return Val(export.callee)
    }
    None
}

callable_params: fn(callable: SemCallable) -> [CanvasParam] Never! {
    loop param in callable.params -> CanvasParam{name: param.name, ty: type_name(param.ty)}
}

callable_return: fn(callable: SemCallable) -> String? Never! {
    ty: callable.return_type ?? return None
    Val(type_name(ty))
}

// A function is pure when its checked effect row is known and empty.
callable_is_pure: fn(callable: SemCallable) -> Bool Never! {
    if callable.effects == .Val(effects) -> effects.len() == 0 else -> false
}

canvas_core_catalog_query: fn(src: String, request: String) -> String Err! {
    canvas_core_catalog(src, json_string_field(request, "query") ?? "")
}

canvas_core_catalog: fn(src: String, query: String) -> String Err! {
    exports: core_module_exports()
    modules: loop module_ref in core_catalog_entries(query, exports) -> core_module_json(src, module_ref, exports)
    Ok(query_ok("core_catalog", src, "[]", "\"impact\":null,\"diff\":null,\"catalog_schema_version\":{CORE_CATALOG_SCHEMA_VERSION},\"authority\":[{json_str("canvas.catalog:core.read")}],\"writes\":\"none\",\"source\":{json_str(CORE_REGISTRY_SOURCE)},\"modules\":[{modules.join(",")}]"))
}

canvas_core_catalog_action_jsons: fn(src: String, authority: CanvasAuthority) -> [String] {
    exports: core_module_exports()
    out := [String]{}
    loop module_ref in core_catalog_entries("", exports) {
        source_callee: core_source_callee(src, module_ref.path)
        loop member in module_ref.members -> out.push(core_catalog_action_json(module_ref.path, source_callee, member, exports, authority))
    }
    out
}

core_catalog_action_json: fn(module_path: String, source_callee_prefix: String, member: CoreCatalogMember, exports: [CoreCatalogExport], authority: CanvasAuthority) -> String {
    action_id: "canvas.core_catalog:{module_path}:{member.name}"
    callee: "{source_callee_prefix}.{member.name}"
    params: core_member_params(module_path, member.name, member.signature)
    status: core_member_status(module_path, member, exports)
    descriptor_id: insert_descriptor_id("insert_call", member.pure)
    rank_fields: palette_rank_fields(descriptor_id)
    "{{\"action_id\":{json_str(action_id)},\"node_descriptor_id\":{json_str(descriptor_id)}{rank_fields},\"kind\":\"canvas.core_catalog\",\"title\":{json_str("{member.name} · {module_path}")},\"module_path\":{json_str(module_path)},\"callee\":{json_str(callee)},\"insert_callee\":{json_str(callee)},\"insert_op\":\"insert_call\",\"engine\":\"checked+jit\",\"execution\":\"source_transaction\",{core_member_status_json(status)}\"authority\":[{json_str(authority.grant)}],\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"touched_files\":[{json_str(authority.touched_file)}],\"writes\":\"source_transaction_only\",\"requires_confirmation\":false,\"audit\":[\"source\",\"module_path\",\"signature\",\"diff\",\"diagnostics\"],\"signature\":{json_str(member.signature)},\"ret\":{json_str(core_member_return_type(module_path, member.name))},\"pure\":{json_bool(member.pure)},\"summary\":{json_str(member.summary)},\"source\":{json_str(member.source)},\"pins\":[{core_member_pins_json(params, status.receiver_type)}],\"default_args\":[{default_args_json(params)}]}}"
}

// The Core export registry's modules and members, filtered by `query` and
// sorted by path and name.
core_catalog_entries: fn(query: String, exports: [CoreCatalogExport]) -> [CoreCatalogModule] {
    needle: query.trim()
    merged: core_registry_modules(exports)
    modules := [CoreCatalogModule]{}
    loop module_ref in merged {
        members := [CoreCatalogMember]{}
        loop member in module_ref.members {
            if needle.is_empty() || contains_ci(member.name, needle) || contains_ci(member.signature, needle) || contains_ci(member.summary, needle) -> members.push(member)
        }
        if !needle.is_empty() && members.len() == 0 && !contains_ci(module_ref.path, needle) && !contains_ci(module_ref.title, needle) && !contains_ci(module_ref.summary, needle) -> next
        members.sort_by(fn(left: CoreCatalogMember, right: CoreCatalogMember) { left.name <=> right.name })
        modules.push(CoreCatalogModule{path: module_ref.path, title: module_ref.title, summary: module_ref.summary, members: members})
    }
    modules.sort_by(fn(left: CoreCatalogModule, right: CoreCatalogModule) { left.path <=> right.path })
    modules
}

// The compiler-known Core module exports, keyed by user-facing module path.
core_module_exports: fn() -> [CoreCatalogExport] Never! {
    out := [CoreCatalogExport]{}
    loop row in CORE_MODULE_EXPORTS {
        if row.module_name == "core" || row.module_name.starts_with("core.") -> out.push(CoreCatalogExport{path: row.module_name, names: row.members})
    }
    out
}

// One module per exported path, holding every name its rows export.
core_registry_modules: fn(exports: [CoreCatalogExport]) -> [CoreCatalogModule] {
    merged := [CoreCatalogModule]{}
    seen := [String:Bool]{}
    loop export in exports {
        if seen.has_key(export.path) -> next
        seen[export.path] = true
        members := [CoreCatalogMember]{}
        loop other in exports {
            if other.path != export.path -> next
            loop name in other.names {
                if !core_catalog_has_member(members, name) -> members.push(core_registry_member(other.path, name))
            }
        }
        merged.push(CoreCatalogModule{path: export.path, title: export.path, summary: CORE_REGISTRY_MODULE_SUMMARY, members: members})
    }
    merged
}

core_registry_member: fn(module_path: String, name: String) -> CoreCatalogMember Never! {
    CoreCatalogMember{name: name, signature: "{module_path}.{name}", summary: "Compiler-known Core item from the Core export registry.", source: CORE_REGISTRY_SOURCE, pure: core_member_pure(module_path, name)}
}

core_catalog_has_member: fn(members: [CoreCatalogMember], name: String) -> Bool Never! {
    loop member in members {
        if member.name == name -> return true
    }
    false
}

core_export_resolves: fn(exports: [CoreCatalogExport], module_path: String, member: String) -> Bool Never! {
    loop export in exports {
        if export.path != module_path -> next
        loop name in export.names {
            if name == member -> return true
        }
    }
    false
}

// Whether Canvas can insert `member` as a direct call, and what stops it.
core_member_status: fn(module_path: String, member: CoreCatalogMember, exports: [CoreCatalogExport]) -> CoreMemberStatus {
    blocked: if core_export_resolves(exports, module_path, member.name) -> core_member_direct_exclusion(module_path, member) ?? CoreMemberReason{code: "", reason: ""} else -> core_member_unavailable_reason(module_path, member)
    available: blocked.code.is_empty()
    stageable: blocked.code == "needs_canvas_defaults" || blocked.code == "method_only"
    CoreMemberStatus{
        available: available,
        stageable: stageable,
        stage_reason_code: if stageable -> blocked.code else -> "",
        stage_reason: if stageable -> blocked.reason else -> "",
        receiver_type: if blocked.code == "method_only" -> core_member_receiver_type(module_path, member.name, member.signature) else -> "",
        unavailable_reason_code: if available -> "" else -> blocked.code,
        unavailable_reason: if available -> "" else -> blocked.reason,
    }
}

core_member_direct_exclusion: fn(module_path: String, member: CoreCatalogMember) -> CoreMemberReason? {
    first: member.name.bytes()
    if first.len() > 0 && (Int{first[0]}) >= 65 && (Int{first[0]}) <= 90 -> return Val(CoreMemberReason{code: "type_only", reason: "Use this as a type or constructor surface, not a direct call."})
    if core_member_requires_unsafe(module_path, member.name) -> return Val(CoreMemberReason{code: "needs_unsafe_region", reason: "Needs an #Unsafe region before Canvas can insert it."})
    if module_path == "core.event" && core_event_needs_type_arguments(member.name) {
        return Val(CoreMemberReason{code: "needs_signature", reason: "Needs explicit event type arguments and constructor inputs before Canvas can insert it."})
    }
    params: core_member_params(module_path, member.name, member.signature)
    generated_signature: member.signature == "{module_path}.{member.name}"
    if generated_signature && params.len() == 0 -> return Val(CoreMemberReason{code: "needs_signature", reason: "Needs parameter details before Canvas can insert it."})
    if !core_member_has_safe_defaults(module_path, member.name) {
        if params.len() == 0 -> return None
        return Val(CoreMemberReason{code: "needs_canvas_defaults", reason: "Needs Canvas argument defaults before this entry can be inserted."})
    }
    if !member.signature.contains("(") && params.len() == 0 -> return Val(CoreMemberReason{code: "value_only", reason: "Use this as a value, not a direct call."})
    None
}

core_event_needs_type_arguments: fn(name: String) -> Bool Never! {
    if name == {
        "new" | "with_policy" | "async_result" | "hook" | "decision_hook" -> true
        else -> false
    }
}

// The Core calls whose Canvas defaults (`default_arg_for_type`) make a call
// that checks and runs: the math functions and the text decoders.
core_member_has_safe_defaults: fn(module_path: String, name: String) -> Bool Never! {
    if module_path == {
        "core.math" -> true
        "core.encoding.json" -> name == "parse" || name == "decode" || name == "loads"
        "core.encoding.hex" | "core.encoding.base64" | "core.encoding.base32" -> if name == {
            "decode" | "decode_url" | "b64decode" | "standard_b64decode" | "urlsafe_b64decode" | "b16decode" | "a85decode" | "b85decode" | "z85decode" -> true
            else -> false
        }
        else -> false
    }
}

core_member_requires_unsafe: fn(module_path: String, member: String) -> Bool Never! {
    if module_path == {
        "core.crypto.expert" -> true
        "core.crypto.vault" -> member != "get"
        "core.mem" -> member == "from_addr" || member == "volatile_read" || member == "volatile_write"
        "core.sys" -> if member == {
            "fork" | "setuid" | "setgid" | "set_user_ids" | "set_group_ids" | "setpgid" | "setpgrp" | "setsid" | "initgroups" | "kill" | "reset_signal" | "wait" | "waitpid" | "pipe" | "close_fd" | "mkfifo" | "mknod" | "umask" | "getpriority" | "setpriority" | "set_scheduling" | "set_wall_clock" | "utime" | "atexit" | "stop" -> true
            else -> false
        }
        else -> false
    }
}

core_member_unavailable_reason: fn(module_path: String, member: CoreCatalogMember) -> CoreMemberReason Never! {
    sig: member.signature.trim()
    if module_path == "core.args" && sig.starts_with(".") -> return CoreMemberReason{code: "method_only", reason: "Use this as a method on an ArgsSpec value."}
    if sig.starts_with(".") || sig.contains(").") -> return CoreMemberReason{code: "method_only", reason: "Use this from the value shown in the signature."}
    if sig.contains(".") && !sig.starts_with(module_path) -> return CoreMemberReason{code: "type_member", reason: "Use this from the type shown in the signature."}
    CoreMemberReason{code: "not_direct_call", reason: "This Core entry is documentation only; it has no direct module call."}
}

core_member_receiver_type: fn(module_path: String, member_name: String, signature: String) -> String {
    if module_path == "core.args" {
        arity: core_member_params(module_path, member_name, signature).len()
        if member_name == {
            "flag" | "option" | "option_int" | "option_float" | "positional" -> return if arity == 1 -> "ParsedArgs" else -> "ArgsSpec"
            "options" | "subcommand" -> return if arity <= 1 -> "ParsedArgs" else -> "ArgsSpec"
            else -> return "ArgsSpec"
        }
    }
    if module_path == {
        "core.mod" -> "Option"
        "core.reflect" -> if member_name == "name" || member_name == "value" -> "Field" else -> "Value"
        "core.net.tls" -> "ClientConfig"
        "core.http" -> "HTTPClient"
        "core.perf" -> "String"
        else -> ""
    }
}

core_source_callee: fn(src: String, module_path: String) -> String {
    if imported_core_alias(src, module_path) == .Val(alias) -> return alias
    if module_path.cut_last(".") == .Val(parts) -> parts.after else -> module_path
}

// The local name of `module_path` when the source imports it: an `alias:`
// row, a bare path, or a `use {` block row (core_imports).
imported_core_alias: fn(src: String, module_path: String) -> String? {
    loop import in core_imports(src) {
        if import.module_ref == module_path -> return Val(import.alias)
    }
    None
}

core_member_pure: fn(module_path: String, name: String) -> Bool Never! {
    if module_path == {
        "core.math" | "core.text.fmt" | "core.text" | "core.encoding" | "core.encoding.json" | "core.encoding.jsonl" | "core.encoding.csv" | "core.encoding.toml" | "core.encoding.yaml" | "core.encoding.xml" | "core.encoding.cbor" | "core.encoding.hex" | "core.encoding.base64" | "core.encoding.base32" | "core.net.url" | "core.net.mime" | "core.reflect" | "core.compute.solve" | "core.data" -> true
        "core.files" -> name == "exists" || name == "is_dir" || name == "absolute"
        "core.sys" -> name == "get" || name == "current_dir" || name == "home_dir"
        "core.time" -> if name == {
            "ms" | "secs" | "seconds" | "minutes" | "hours" | "from_unix_ms" | "period" | "period_days" | "period_months" | "period_years" | "zone" | "utc" | "zoned" -> true
            else -> false
        }
        else -> false
    }
}

project_function_catalog_json: fn(def: SemDef, params: [CanvasParam], ret: String?, pure: Bool, callee: String) -> String {
    descriptor_id: insert_descriptor_id("insert_call", pure)
    rank_fields: palette_rank_fields(descriptor_id)
    "{{\"name\":{json_str(def.name)},\"signature\":{json_str(function_signature_from_parts(def.name, params, ret))},\"callee\":{json_str(callee)},\"insert_callee\":{json_str(callee)},\"node_descriptor_id\":{json_str(descriptor_id)}{rank_fields},\"module_path\":{json_str(def.module_path)},\"pure\":{json_bool(pure)},\"ret\":{json_str(ret ?? "Void")},\"pins\":[{core_member_pins_json(params, "")}],\"default_args\":[{default_args_json(params)}],\"available\":true,\"source_span\":{span_json(def.def_span)},\"insert_op\":\"insert_call\"}}"
}

function_signature_from_parts: fn(name: String, params: [CanvasParam], ret: String?) -> String Never! {
    written: loop param in params -> "{param.name}: {param.ty}"
    ret_text: if ret == .Val(ty) && ty != "!" -> " {ty}" else -> ""
    "{name}: fn({written.join(", ")}){ret_text}"
}

core_module_json: fn(src: String, module_ref: CoreCatalogModule, exports: [CoreCatalogExport]) -> String {
    members: loop member in module_ref.members -> core_member_json(src, module_ref.path, member, exports)
    "{{\"path\":{json_str(module_ref.path)},\"title\":{json_str(module_ref.title)},\"summary\":{json_str(module_ref.summary)},\"source\":{json_str(CORE_REGISTRY_SOURCE)},\"members\":[{members.join(",")}]}}"
}

core_member_json: fn(src: String, module_path: String, member: CoreCatalogMember, exports: [CoreCatalogExport]) -> String {
    callee: "{core_source_callee(src, module_path)}.{member.name}"
    params: core_member_params(module_path, member.name, member.signature)
    status: core_member_status(module_path, member, exports)
    descriptor_id: insert_descriptor_id("insert_call", member.pure)
    rank_fields: palette_rank_fields(descriptor_id)
    "{{\"name\":{json_str(member.name)},\"callee\":{json_str(callee)},\"insert_callee\":{json_str(callee)},\"node_descriptor_id\":{json_str(descriptor_id)}{rank_fields},\"signature\":{json_str(member.signature)},\"ret\":{json_str(core_member_return_type(module_path, member.name))},\"pure\":{json_bool(member.pure)},\"summary\":{json_str(member.summary)},\"source\":{json_str(member.source)},\"writes\":\"none\",{core_member_status_json(status)}\"pins\":[{core_member_pins_json(params, status.receiver_type)}],\"default_args\":[{default_args_json(params)}]}}"
}

core_member_status_json: fn(status: CoreMemberStatus) -> String Never! {
    receiver: if status.receiver_type.is_empty() -> "" else -> "\"receiver_type\":{json_str(status.receiver_type)},"
    unavailable: if status.available -> "" else -> "\"unavailable_reason_code\":{json_str(status.unavailable_reason_code)},\"denied_reason\":{json_str(status.unavailable_reason)},"
    "\"available\":{json_bool(status.available)},\"stageable\":{json_bool(status.stageable)},\"stage_reason_code\":{json_str(status.stage_reason_code)},\"stage_reason\":{json_str(status.stage_reason)},{receiver}{unavailable}"
}

// The input pins, after a `receiver` pin when the entry is a method.
core_member_pins_json: fn(params: [CanvasParam], receiver_type: String) -> String Never! {
    pins := [String]{}
    if !receiver_type.is_empty() -> pins.push("{{\"name\":\"receiver\",\"direction\":\"input\",\"type\":{json_str(receiver_type)}}}")
    loop param in params -> pins.push("{{\"name\":{json_str(param.name)},\"direction\":\"input\",\"type\":{json_str(param.ty)}}}")
    pins.join(",")
}

default_args_json: fn(params: [CanvasParam]) -> String Never! {
    args: loop param in params -> json_str(default_arg_for_type(param.ty))
    args.join(",")
}

canvas_action_json: fn(def: SemDef, params: [CanvasParam], ret: String?, pure: Bool, callee: String, authority: CanvasAuthority) -> String {
    descriptor_id: insert_descriptor_id("insert_call", pure)
    rank_fields: palette_rank_fields(descriptor_id)
    action_id: "canvas.action:{def.module_path}:{callee}"
    "{{\"action_id\":{json_str(action_id)},\"node_descriptor_id\":{json_str(descriptor_id)}{rank_fields},\"kind\":\"canvas.action\",\"title\":{json_str(def.name)},\"callee\":{json_str(callee)},\"insert_callee\":{json_str(callee)},\"module_path\":{json_str(def.module_path)},\"insert_op\":\"insert_call\",\"pure\":{json_bool(pure)},\"engine\":\"checked+jit\",\"authority\":[{json_str(authority.grant)}],\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"touched_files\":[{json_str(authority.touched_file)}],\"writes\":\"source_transaction_only\",\"audit\":[\"package_id\",\"version\",\"hash\",\"authority\",\"touched_files\",\"diff\",\"diagnostics\"],\"source_span\":{span_json(def.def_span)},\"ret\":{json_str(ret ?? "Void")},\"pins\":[{core_member_pins_json(params, "")}],\"default_args\":[{default_args_json(params)}]}}"
}

canvas_builtin_action_json: fn(callee: String, title: String, params: [CanvasParam], ret: String, default_args: [String], authority: CanvasAuthority) -> String {
    descriptor_id: insert_descriptor_id("insert_call", false)
    rank_fields: palette_rank_fields(descriptor_id)
    action_id: "canvas.action:builtin:{callee}"
    args: loop arg in default_args -> json_str(arg)
    "{{\"action_id\":{json_str(action_id)},\"node_descriptor_id\":{json_str(descriptor_id)}{rank_fields},\"kind\":\"canvas.builtin\",\"title\":{json_str(title)},\"callee\":{json_str(callee)},\"insert_callee\":{json_str(callee)},\"module_path\":\"builtin\",\"insert_op\":\"insert_call\",\"pure\":false,\"engine\":\"checked+jit\",\"authority\":[{json_str(authority.grant)}],\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"touched_files\":[{json_str(authority.touched_file)}],\"writes\":\"source_transaction_only\",\"audit\":[\"package_id\",\"version\",\"hash\",\"authority\",\"touched_files\",\"diff\",\"diagnostics\"],\"source_span\":null,\"ret\":{json_str(ret)},\"pins\":[{core_member_pins_json(params, "")}],\"default_args\":[{args.join(",")}]}}"
}

// The pins of a Core entry: its written parameters, else the checked
// signature's parameters numbered `arg1`, `arg2`, ...
core_member_params: fn(module_path: String, member_name: String, signature: String) -> [CanvasParam] {
    if params_from_signature(signature) == .Val(params) -> return params
    typed: core_member_signature(module_path, member_name) ?? return [CanvasParam]{}
    loop at in 0..<typed.parameters.len() -> CanvasParam{name: "arg{at + 1}", ty: type_name(typed.parameters[at].ty)}
}

core_member_return_type: fn(module_path: String, member_name: String) -> String {
    typed: core_member_signature(module_path, member_name) ?? return "Void"
    ret: typed.return_type ?? return "Void"
    type_name(ret)
}

// The checked signature of a Core call at its declared arity.
core_member_signature: fn(module_path: String, member_name: String) -> CoreTypedCallSignature? {
    row: core_call(module_path, member_name) ?? return None
    core_call_typed_signature(module_path, member_name, row.signature.arity)
}

params_from_signature: fn(signature: String) -> [CanvasParam]? Never! {
    open: signature.split_once("(") ?? return None
    close: open.after.split_once(")") ?? return None
    body: close.before.trim()
    params := [CanvasParam]{}
    if body.is_empty() -> return Val(params)
    parts: body.split(",").to_list()
    loop at in 0..<parts.len() {
        part: parts[at].trim()
        if part.is_empty() -> next
        name := ""
        ty := ""
        if part.split_once(":") == .Val(typed) {
            name = typed.before.trim()
            ty = normalize_param_type(typed.after.trim())
        } else {
            name = ident_prefix(part)
            ty = type_for_param_name(name)
        }
        if name.is_empty() -> name = "arg{at + 1}"
        params.push(CanvasParam{name: name, ty: ty})
    }
    Val(params)
}

// A written parameter type without its default and optional marks.
normalize_param_type: fn(ty: String) -> String Never! {
    written := ty
    if written.split_once("=") == .Val(parts) -> written = parts.before
    without_optional(written.trim()).trim()
}

without_optional: fn(ty: String) -> String Never! {
    text := ty
    loop text.ends_with("?") -> text = text.removesuffix("?")
    text
}

type_for_param_name: fn(name: String) -> String Never! {
    if name == {
        "text" | "raw" | "body" | "path" | "name" | "url" | "host" | "scheme" | "query" | "fragment" | "delim" | "method" -> "String"
        "ok" | "enabled" | "flag" -> "Bool"
        else -> "Int"
    }
}

// The argument Canvas writes for a parameter of type `ty`.
default_arg_for_type: fn(ty: String) -> String Never! {
    if without_optional(ty.trim()).trim() == {
        "Bool" -> "true"
        "String" | "Path" | "URL" -> "\"canvas\""
        "Float" | "F32" | "F64" | "Decimal" -> "1.0"
        else -> "1"
    }
}

canvas_game_action_json: fn(fact: CanvasGameFact, authority: CanvasAuthority, revision: String) -> String {
    resource_kind: if fact.kind == "asset" -> "asset" else -> "component"
    operation_leaf: if fact.operation.cut_last(".") == .Val(parts) -> parts.after else -> fact.operation
    title: if fact.kind == "asset" -> "Edit {operation_leaf} asset" else -> "Edit component"
    target: "{{\"source_id\":{json_str(fact.source_id)},\"revision\":{json_str(revision)},\"authored_instance_id\":{json_str(fact.authored_instance_id)},\"source_span\":{span_json(fact.source_span)}}}"
    patch: "{{\"field\":{json_str(fact.field)},\"value\":{json_str(canvas_game_patch_value(fact))}}}"
    "{{\"action_id\":{json_str("canvas.game:{fact.authored_instance_id}")},\"node_descriptor_id\":\"function_exec\",\"kind\":\"canvas.game\",\"resource_kind\":{json_str(resource_kind)},\"title\":{json_str(title)},\"op\":\"edit_game_selection\",\"engine\":\"source-transaction\",\"execution\":\"source_transaction\",\"available\":true,\"authority\":[{json_str(authority.grant)}],\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"touched_files\":[{json_str(fact.source_id)}],\"writes\":\"source_transaction_only\",\"requires_confirmation\":false,\"targets\":[{target}],\"field_patch\":{patch},\"source_truth\":\"ordinary_jet_source\",\"fact\":{canvas_game_fact_json(fact)}}}"
}

// The value a game field edit starts from: a quoted literal's unescaped
// text, else the written source.
canvas_game_patch_value: fn(fact: CanvasGameFact) -> String Never! {
    value: fact.value_source.trim()
    if value.len() < 2 || !value.starts_with("\"") || !value.ends_with("\"") -> return value
    out := [String]{}
    escaped := false
    loop character in value.slice(1, value.len() - 1).chars() {
        text: "{character}"
        if !escaped {
            if text == "\\" -> escaped = true else -> out.push(text)
            next
        }
        escaped = false
        if text == {
            "n" -> out.push("\n")
            "r" -> out.push("\r")
            "t" -> out.push("\t")
            "\"" -> out.push("\"")
            "\\" -> out.push("\\")
            else -> {
                out.push("\\")
                out.push(text)
            }
        }
    }
    if escaped -> out.push("\\")
    out.join("")
}

canvas_structural_action_jsons: fn(authority: CanvasAuthority) -> [String] {
    [String]{
        canvas_structural_action_json("branch", "Branch", "insert_branch", authority),
        canvas_structural_action_json("dispatch", "Switch", "insert_switch", authority),
        canvas_structural_action_json("loop", "Loop", "insert_loop", authority),
        canvas_structural_action_json("fallible", "Failure rail", "insert_fallible_rail", authority),
    }
}

canvas_structural_action_json: fn(name: String, title: String, transaction: String, authority: CanvasAuthority) -> String {
    descriptor_id: insert_descriptor_id(transaction, false)
    rank_fields: palette_rank_fields(descriptor_id)
    "{{\"action_id\":{json_str("canvas.structural:{name}")},\"node_descriptor_id\":{json_str(descriptor_id)}{rank_fields},\"kind\":\"canvas.structural\",\"title\":{json_str(title)},\"op\":{json_str(transaction)},\"engine\":\"source-transaction\",\"execution\":\"source_transaction\",\"available\":true,\"authority\":[{json_str(authority.grant)}],\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"touched_files\":[{json_str(authority.touched_file)}],\"writes\":\"source_transaction_only\",\"requires_confirmation\":false}}"
}

canvas_command_action_jsons: fn(authority: CanvasAuthority) -> [String] {
    source: authority.touched_file
    actions := [String]{
        canvas_command_action_json("run", "Run program", [String]{"jet", "run", source}, "none", [String]{"canvas.command:run", authority.grant}, true, None, authority),
        canvas_command_action_json("check", "Check project", [String]{"jet", "check", source}, "none", [String]{"canvas.command:check", authority.grant}, true, None, authority),
        canvas_command_action_json("test", "Test project", [String]{"jet", "test", source}, "test_outputs", [String]{"canvas.command:test", "canvas.build_output:test", authority.grant}, true, None, authority),
        canvas_command_action_json("build", "Build project", [String]{"jet", "build", source}, "build_outputs", [String]{"canvas.command:build", "canvas.build_output:binary", authority.grant}, true, None, authority),
    }
    services_available: env_project_json(authority.project_root).services.contains("\"enable\":true")
    denied: if services_available -> String?{None} else -> Val("no env service selected")
    actions.push(canvas_command_action_json("service.start", "Start service", [String]{"jet", "services", "up"}, "service_process", [String]{"canvas.service:start", "canvas.env:service"}, services_available, denied, authority))
    actions
}

canvas_command_action_json: fn(name: String, title: String, command: [String], writes: String, grants: [String], available: Bool, denied: String?, authority: CanvasAuthority) -> String {
    command_json: loop part in command -> json_str(part)
    grants_json: loop grant in grants -> json_str(grant)
    "{{\"action_id\":{json_str("canvas.command:{name}")},\"kind\":\"canvas.command\",\"title\":{json_str(title)},\"op\":\"command_authority\",\"engine\":\"jet-cli\",\"execution\":\"external_command\",\"available\":{json_bool(available)},\"denied_reason\":{json_optional_str(denied)},\"command\":[{command_json.join(",")}],\"authority\":[{grants_json.join(",")}],\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"touched_files\":[{json_str(authority.touched_file)}],\"writes\":{json_str(writes)},\"requires_confirmation\":{json_bool(writes != "none")},\"audit\":[\"package_id\",\"version\",\"command\",\"authority\",\"touched_files\",\"diagnostics\"]}}"
}

// The authority a Canvas edit of `path` runs under: its package's, read
// from the package facts, else the single file's.
canvas_authority_context: fn(path: String) -> CanvasAuthority {
    dir: entry_parent(path)
    cache := WorkspaceDeclarationCache.new()
    if pkg_package_facts_for_entry(cache, path) == {
        .Val(package) -> {
            root: if pkg_find_manifest_root_checked(cache, dir) == {
                .Val(found) -> found
                .None | .Err(_) -> dir
            }
            return CanvasAuthority{grant: "canvas.source_edit:package", package_id: package.name, version: package.version ?? "unversioned", touched_file: rel_path(root, path), project_root: root}
        }
        .None | .Err(_) -> {}
    }
    name: query_files.basename(path)
    CanvasAuthority{grant: "canvas.source_edit:single_file", package_id: "single-file", version: "unpackaged", touched_file: if name.is_empty() -> "current.jet" else -> name, project_root: dir}
}
