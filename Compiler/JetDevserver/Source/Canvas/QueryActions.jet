fn merge_sema_core_registry(modules: &[CoreCatalogModule], registry: String) -> {
    for (path, names) in parse_sema_core_module_items(registry) {
        pos :: modules.iter().position((module) -> module.path == path).unwrap_or_else(() -> {
            modules.push(CoreCatalogModule(title: path, path: path, summary: "Compiler-known Core module from the sema registry.", members: []))
            modules.len() - 1
        })
        module :: &modules[pos]
        if module.summary.is_empty() -> module.summary = "Compiler-known Core module from the sema registry."
        for name in names {
            if module.members.iter().any((member) -> member.name == name) -> continue
            module.members.push(CoreCatalogMember(signature: format("{}.{}", path, name), summary: "Compiler-known Core item from sema registry.", source: "crates/jet-sema/src/Sema/CheckerCoreLib/module_items.rs", pure: core_member_pure(path, name), name: name, available: true, stageable: false, stage_reason_code: "", stage_reason: "", receiver_type: "", unavailable_reason_code: "", unavailable_reason: ""))
