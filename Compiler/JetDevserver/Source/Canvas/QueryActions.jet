    member.unavailable_reason = if member.available { "" } else { reason }
}

// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1137
fn core_member_direct_exclusion(module_path: String, member: &CoreCatalogMember) -> (String, String)? {
    if member.name.chars().next().map_or(false, (c) -> c.is_ascii_uppercase()) -> return .Some(("type_only", "Use this as a type or constructor surface, not a direct call."))
    if core_member_requires_unsafe(module_path, member.name) -> return .Some(("needs_unsafe_region", "Needs an #Unsafe region before Canvas can insert it."))
    if module_path == "core.event" && (member.name is "new" | "with_policy" | "async_result" | "hook" | "decision_hook") -> return .Some(("needs_signature", "Needs explicit event type arguments and constructor inputs before Canvas can insert it."))
    params :: core_member_params(module_path, member.name, member.signature)
    generated_signature :: member.signature == format("{}.{}", module_path, member.name)
    if generated_signature && params.is_empty() -> return .Some(("needs_signature", "Needs parameter details before Canvas can insert it."))
    if !jet_driver.Sema.core_call_has_safe_defaults(module_path, member.name) {
        if params.is_empty() -> return .None
        return .Some(("needs_canvas_defaults", "Needs Canvas argument defaults before this entry can be inserted."))
    }
    if !member.signature.contains('(') && params.is_empty() -> return .Some(("value_only", "Use this as a value, not a direct call."))
    .None
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1196
fn core_member_requires_unsafe(module_path: String, member: String) -> Bool {
    if module_path is {
        "core.crypto.expert" -> true
        "core.crypto.vault" -> member != "get"
        "core.mem" -> member is "from_addr" | "volatile_read" | "volatile_write"
        "core.sys" -> member is "fork" | "setuid" | "setgid" | "setpgid" | "setpgrp" | "setsid" | "initgroups" | "kill" | "wait" | "waitpid" | "pipe" | "close_fd" | "mkfifo" | "umask" | "getpriority" | "setpriority" | "utime" | "atexit" | "stop"
        _ -> false
    }
}
