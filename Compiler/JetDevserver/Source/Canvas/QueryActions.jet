    rest := text[first + 1..] // #4303
    end :: rest.find('"')?
    .Some(rest[..end].to_string())
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1365
fn parse_core_catalog_markdown(markdown: String) -> [CoreCatalogModule] {
    modules: [CoreCatalogModule] := []
    current: CoreCatalogModule? := .None
    for line in markdown.lines() {
        if path :: core_heading_path(line) {
            if module :: current.take() -> modules.push(module)
            current = .Some(CoreCatalogModule(path: path, title: strip_markdown_heading(line), summary: "", members: []))
            continue
        }
        module :: current.as_mut() ?? continue
        trimmed := line.trim() // #4303
        if module.summary.is_empty() && !trimmed.is_empty() && !trimmed.starts_with('|') && !trimmed.starts_with("```") && !trimmed.starts_with('#') -> module.summary = strip_markdown_inline(trimmed)
        if member :: core_catalog_member_from_line(trimmed) {
            if !module.members.iter().any((existing) -> existing.signature == member.signature) -> module.members.push(member)
        }
    }
    if module :: current -> modules.push(module)
    for path in core_paths_in_markdown(markdown) {
        if !modules.iter().any((module) -> module.path == path) -> modules.push(CoreCatalogModule(title: path, path: path, summary: "Listed in the canonical Core library reference.", members: []))
    }
    modules
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1419
fn core_paths_in_markdown(markdown: String) -> [String] {
    paths: [String] := []
    for token in markdown.split((c) -> !(c.is_ascii_alphanumeric() || c == '_' || c == '.')) {
        if token == "core" || token.starts_with("core.") {
            path := token.trim_matches('.') // #4303
            if !path.is_empty() && !paths.iter().any((existing) -> existing == path) -> paths.push(path.to_string())
        }
    }
    paths
}
