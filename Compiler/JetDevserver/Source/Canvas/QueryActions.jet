// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1448
fn core_catalog_member_from_line(line: String) -> CoreCatalogMember? {
    if !line.starts_with('|') || !line.contains('`') || line.starts_with("| ---") -> return .None
    first :: line.find('`')?
    rest := line[first + 1..<line.len()] // #4303
    end :: rest.find('`')?
    signature := rest[0..<end].trim() // #4303
    if signature.is_empty() || signature == "Function/method" || signature == "Type" -> return .None
    name_source := signature.split('/').next().unwrap_or(signature).split('(').next().unwrap_or(signature).trim() // #4303
    name := name_source.rsplit('.').next().unwrap_or(name_source).split_whitespace().next().unwrap_or(name_source).trim_matches('`') // #4303
    summary :: line.split('|').nth(3).map(strip_markdown_inline).unwrap_or_default()
    .Some(CoreCatalogMember(name: name.to_string(), signature: signature.to_string(), summary: summary, source: "Docs/spec/reference/core-library.md", pure: core_member_pure_for_signature(signature), available: true, stageable: false, stage_reason_code: "", stage_reason: "", receiver_type: "", unavailable_reason_code: "", unavailable_reason: ""))
}
