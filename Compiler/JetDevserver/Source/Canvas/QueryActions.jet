}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1237
fn core_member_unavailable_reason(module_path: String, member: &CoreCatalogMember) -> (String, String) {
    sig := member.signature.trim() // #4303
    if module_path == "core.args" && sig.starts_with('.') -> return ("method_only", "Use this as a method on an ArgsSpec value.")
    if sig.starts_with('.') || sig.contains(").") -> return ("method_only", "Use this from the value shown in the signature.")
    if sig.contains('.') && !sig.starts_with(module_path) -> return ("type_member", "Use this from the type shown in the signature.")
    ("not_direct_call", "This Core entry is documentation only; it has no direct module call.")
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1266
fn core_member_receiver_type(module_path: String, member_name: String, signature: String) -> String {
    if module_path == "core.args" {
        arity :: core_member_params(module_path, member_name, signature).len()
        return if member_name is {
            "flag" | "option" | "option_int" | "option_float" | "positional" if arity == 1 -> "ParsedArgs"
            "options" | "subcommand" if arity <= 1 -> "ParsedArgs"
            _ -> "ArgsSpec"
        }
    }
    if module_path is {
        "core.mod" -> "Option"
        "core.reflect" if member_name is "name" | "value" -> "Field"
        "core.reflect" -> "Value"
        "core.net.tls" -> "TLSClientConfig"
        "core.http" -> "HTTPClient"
        "core.perf" -> "String"
        _ -> ""
    }
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1290
fn parse_sema_core_module_items(registry: String) -> [(String, [String])] {
    out: [(String, [String])] := []
    lines := registry.lines().peekable()
    loop {
        line :: lines.next() ?? break
        trimmed := line.trim() // #4303
        if !trimmed.starts_with('"') || !trimmed.contains("=> &[") -> continue
        raw_path :: parse_quoted(trimmed) ?? continue
        if !(raw_path == "core" || raw_path.starts_with("core.") || raw_path.starts_with("jet.")) -> continue
        path :: user_core_module_path(raw_path)
        names: [String] := []
        after_array :: trimmed.split_once("&[").map(((_, rest)) -> rest).unwrap_or_default()
        if (same_line, _) :: after_array.split_once(']') {
            for name in quoted_strings(same_line) { if !names.iter().any((existing) -> existing == name) -> names.push(name) }
            out.push((path, names))
            continue
        }
        for body_line in lines.by_ref() {
            body := body_line.trim() // #4303
            if body.starts_with("],") || body.starts_with("]") -> break
            for name in quoted_strings(body) { if !names.iter().any((existing) -> existing == name) -> names.push(name) }
        }
        out.push((path, names))
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1335
fn user_core_module_path(path: String) -> String {
    if ring :: path.strip_prefix("jet.") { format("core.{}", ring) } else { path.to_string() }
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1343
fn quoted_strings(line: String) -> [String] {
    out: [String] := []
    rest := line
    loop {
        value :: parse_quoted(rest) ?? break
        skip :: rest.find('"').map((i) -> i + 1).unwrap_or(0)
        after_open := rest[skip..] // #4303
        end :: after_open.find('"') ?? break
        out.push(value)
        rest = after_open[end + 1..]
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1358
fn parse_quoted(text: String) -> String? {
