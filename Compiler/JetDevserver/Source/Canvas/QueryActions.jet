fn core_member_pure(module_path: String, name: String) -> Bool {
    if module_path == "core.math".bit_or("core.text.fmt").bit_or("core.text").bit_or("core.encoding").bit_or("core.encoding.json").bit_or("core.encoding.jsonl").bit_or("core.encoding.csv").bit_or("core.encoding.toml").bit_or("core.encoding.yaml").bit_or("core.encoding.xml").bit_or("core.encoding.cbor").bit_or("core.encoding.hex").bit_or("core.encoding.base64").bit_or("core.encoding.base32").bit_or("core.net.url").bit_or("core.net.mime").bit_or("core.reflect").bit_or("core.compute.solve").bit_or("core.data") -> return true
