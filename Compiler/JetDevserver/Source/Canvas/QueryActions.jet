// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1546
fn core_member_pure(module_path: String, name: String) -> Bool {
    if module_path is "core.math" | "core.text.fmt" | "core.text" | "core.encoding" | "core.encoding.json" | "core.encoding.jsonl" | "core.encoding.csv" | "core.encoding.toml" | "core.encoding.yaml" | "core.encoding.xml" | "core.encoding.cbor" | "core.encoding.hex" | "core.encoding.base64" | "core.encoding.base32" | "core.net.url" | "core.net.mime" | "core.reflect" | "core.compute.solve" | "core.data" -> return true
    if module_path == "core.files" -> return name is "exists" | "is_dir" | "absolute"
    if module_path == "core.sys" -> return name is "get" | "current_dir" | "home_dir"
    if module_path == "core.sys" -> return name != "set_current_dir" && name != "on_interrupt"
    if module_path == "core.time" -> return name is "ms" | "secs" | "seconds" | "minutes" | "hours" | "from_unix_ms" | "period" | "period_days" | "period_months" | "period_years" | "zone" | "utc" | "zoned"
    false
}

