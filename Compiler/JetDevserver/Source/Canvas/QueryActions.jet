fn core_member_requires_unsafe(module_path: String, member: String) -> Bool {
    if module_path is {
        "core.crypto.expert" -> true
        "core.crypto.vault" -> member != "get"
        "core.mem" -> member == "from_addr".bit_or("volatile_read").bit_or("volatile_write")
        "core.sys" -> member == "fork".bit_or("setuid").bit_or("setgid").bit_or("setpgid").bit_or("setpgrp").bit_or("setsid").bit_or("initgroups").bit_or("kill").bit_or("wait").bit_or("waitpid").bit_or("pipe").bit_or("close_fd").bit_or("mkfifo").bit_or("umask").bit_or("getpriority").bit_or("setpriority").bit_or("utime").bit_or("atexit").bit_or("stop")
        _ -> false
    }
}
