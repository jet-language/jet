// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:42
pub fn canvas_find(path: OSPath, src: String, query: String) -> String Err! {
    (projection, index) :: open_query_context(path, src)?
    needle := query.trim() // #4303
    if needle.is_empty() -> return .Ok(query_ok("find", src, "[]", "\"impact\":null,\"diff\":null"))
    results: [String] := []
    for def in index.definitions() {
        if contains_ci(def.name, needle) || contains_ci(def.identity, needle) -> results.push(query_result_json("definition", def.name, def.name, def.module_path, def.def_span, node_for_span(projection, def.def_span), src))
    }
    for r in index.references() {
        if contains_ci(r.name, needle) -> results.push(query_result_json("reference", r.name, r.name, r.module_path, r.span, node_for_span(projection, r.span), src))
    }
    for node in projection.node_refs {
        if contains_ci(node.title, needle) || contains_ci(node.kind, needle) -> results.push(query_result_json("graph", node.title, node.title, "", node.span, .Some(node), src))
    }
    for span in text_matches(src, needle) { results.push(query_result_json("source", needle, needle, path.display().to_string(), span, node_for_span(projection, span), src)) }
    dedupe_results(&results)
    .Ok(query_ok("find", src, format("[{}]", results.join(",")), "\"impact\":null,\"diff\":null"))
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:108
pub fn canvas_project_find(entry: OSPath, selected_path: OSPath, selected_src: String, query: String, expected_project_revision: String?) -> String Err! {
    run_compiler_work(() -> {
        context :: open_project_query_context(entry, selected_path, selected_src, expected_project_revision)?
        needle := query.trim() // #4303
        projection :: if needle.is_empty() { .None } else { .Some(project_file(selected_path).map_err((diags) -> query_diagnostics_error(selected_path, selected_src, diags))?) }
        results: [String] := []
        seen := HashSet<String>.new()
        if !needle.is_empty() {
            for source in context.sources {
                for def in source.index.definitions() {
                    if !module_belongs_to(context.project_root, source.path, def.module_path) || (!contains_ci(def.name, needle) && !contains_ci(def.identity, needle)) -> continue
                    owner :: context.sources.iter().find((candidate) -> module_belongs_to(context.project_root, candidate.path, def.module_path)).unwrap_or(source)
                    push_project_result(&results, &seen, "definition", def.name, def.name, def.module_path, def.def_span, owner, projection, context.selected_path)
                }
                for reference in source.index.references() {
                    if !module_belongs_to(context.project_root, source.path, reference.module_path) || !contains_ci(reference.name, needle) -> continue
                    owner :: context.sources.iter().find((candidate) -> module_belongs_to(context.project_root, candidate.path, reference.module_path)).unwrap_or(source)
                    push_project_result(&results, &seen, "reference", reference.name, reference.name, reference.module_path, reference.span, owner, projection, context.selected_path)
                }
                for span in text_matches(source.source, needle) { push_project_result(&results, &seen, "source", needle, needle, source.source_id, span, source, projection, context.selected_path) }
            }
            if projection :: projection {
                for node in projection.node_refs {
                    if contains_ci(node.title, needle) || contains_ci(node.kind, needle) {
                        selected_source :: context.sources.iter().find((source) -> source.path == context.selected_path) ?? return .Err(query_error("not_found", "Canvas query source is not in the projected project"))
                        push_project_result(&results, &seen, "graph", node.title, node.title, context.selected_source_id, node.span, selected_source, .Some(projection), context.selected_path)
                    }
                }
            }
        }
        (results, truncated) :: bounded_project_results(results)
        .Ok(project_query_ok("project_search", context, results, truncated, "\"impact\":null,\"diff\":null"))
    })
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:253
pub fn canvas_references(path: OSPath, src: String, symbol: String) -> String Err! {
    (projection, index) :: open_query_context(path, src)?
    results: [String] := []
    for def in index.definitions().iter().filter((d) -> d.name == symbol) { results.push(query_result_json("definition", def.name, def.name, def.module_path, def.def_span, node_for_span(projection, def.def_span), src)) }
    for r in index.references_to(symbol) { results.push(query_result_json("reference", r.name, r.name, r.module_path, r.span, node_for_span(projection, r.span), src)) }
    impact :: ImpactReport.analyze(index, symbol, 3).to_json()
    .Ok(query_ok("references", src, format("[{}]", results.join(",")), format("\"impact\":{},\"diff\":null", impact)))
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:287
pub fn canvas_project_references(entry: OSPath, selected_path: OSPath, selected_src: String, symbol: String, expected_project_revision: String?) -> String Err! {
    run_compiler_work(() -> {
        context :: open_project_query_context(entry, selected_path, selected_src, expected_project_revision)?
        projection :: project_file(selected_path).map_err((diags) -> query_diagnostics_error(selected_path, selected_src, diags))?
        definitions :: context.sources.iter().flat_map((source) -> source.index.definitions().iter().filter((def) -> def.name == symbol).map((def) -> (source, def))).map(((source, def)) -> {
            owner :: context.sources.iter().find((candidate) -> module_belongs_to(context.project_root, candidate.path, def.module_path)).unwrap_or(source)
            (owner, def)
        }).collect()
        results: [String] := []
        seen := HashSet<String>.new()
        for (source, def) in definitions { push_project_result(&results, &seen, "definition", def.name, def.name, def.module_path, def.def_span, source, .Some(projection), context.selected_path) }
        for source in context.sources {
            for reference in source.index.references() {
                if reference.name != symbol || !module_belongs_to(context.project_root, source.path, reference.module_path) || !reference_targets(reference, definitions) -> continue
                owner :: context.sources.iter().find((candidate) -> module_belongs_to(context.project_root, candidate.path, reference.module_path)).unwrap_or(source)
                push_project_result(&results, &seen, "reference", reference.name, reference.name, reference.module_path, reference.span, owner, .Some(projection), context.selected_path)
            }
        }
        impact :: context.sources.iter().find((source) -> source.index.definitions().iter().any((def) -> def.name == symbol)).map((source) -> ImpactReport.analyze(source.index, symbol, 3).to_json()).unwrap_or("null")
        (results, truncated) :: bounded_project_results(results)
        .Ok(project_query_ok("references", context, results, truncated, format("\"impact\":{},\"diff\":null", impact)))
    })
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:404
pub fn canvas_project_preview_rename(entry: OSPath, selected_path: OSPath, selected_src: String, symbol: String, to: String, expected_project_revision: String?) -> String Err! {
    run_compiler_work(() -> {
        context :: open_project_query_context(entry, selected_path, selected_src, expected_project_revision)?
        project :: project_context_for_entry(entry)
        if project.project_revision != context.project_revision -> return .Err(query_error("conflict", "project changed while Canvas was preparing its rename"))
        projection :: project_file(selected_path).map_err((diags) -> query_diagnostics_error(selected_path, selected_src, diags))?
        plan := prepare_project_rename(project, selected_path, symbol, to, .None).map_err((error) -> query_error(error.kind, error.message))?
        normalize_and_format_project_changes(project, &plan.changes).map_err((error) -> query_error("check", error))?
        validate_project_rename_overlay(project, plan.changes).map_err((error) -> query_error("check", error))?
        definitions :: context.sources.iter().flat_map((source) -> source.index.definitions().iter().filter((definition) -> definition.name == symbol).map((definition) -> (source, definition))).collect()
        results: [String] := []
        seen := HashSet<String>.new()
        for (source, definition) in definitions { push_project_result(&results, &seen, "definition", definition.name, definition.name, definition.module_path, definition.def_span, source, .Some(projection), context.selected_path) }
        for source in context.sources {
            for reference in source.index.references() {
                if reference.name != symbol || !module_belongs_to(context.project_root, source.path, reference.module_path) || !reference_targets(reference, definitions) -> continue
                owner :: context.sources.iter().find((candidate) -> module_belongs_to(context.project_root, candidate.path, reference.module_path)).unwrap_or(source)
                push_project_result(&results, &seen, "reference", reference.name, reference.name, reference.module_path, reference.span, owner, .Some(projection), context.selected_path)
            }
        }
        (results, truncated) :: bounded_project_results(results)
        files :: plan.changes.iter().map((change) -> format("{{\"path\":{},\"revision\":{},\"after_revision\":{},\"changed\":{}}}", json_str(change.rel), json_str(source_revision(change.before)), json_str(source_revision(change.after)), if change.before != change.after { "true" } else { "false" })).collect().join(",")
        diff_text :: plan.changes.iter().map((change) -> format("diff -- {}\n{}", change.rel, simple_diff(change.before, change.after))).collect().join("\n")
        after_project_revision :: project_revision_after_changes(project, plan.changes)
        selected_after_revision :: plan.changes.iter().find((change) -> change.rel == context.selected_source_id).map((change) -> source_revision(change.after))
        .Ok(project_query_ok("preview_rename", context, results, truncated, format("\"impact\":null,\"diff\":{{\"changed\":true,\"text\":{},\"after_revision\":{},\"after_project_revision\":{},\"files\":[{}]}}", json_str(diff_text), selected_after_revision.map(json_str).unwrap_or("null"), json_str(after_project_revision), files)))
    })
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:556
fn open_project_query_context(entry: OSPath, selected_path: OSPath, selected_src: String, expected_project_revision: String?) -> ProjectQueryContext Err! {
    project :: project_context_for_entry(entry)
    if diagnostic :: project.authority_diagnostic -> return .Err(query_error("stale", diagnostic.what))
    if expected :: expected_project_revision {
        if expected != project.project_revision -> return .Err(query_error("conflict", "project changed since this Canvas query was drawn"))
    }
    selected_source_id :: rel_path(project.project_root, selected_path)
    selected_revision :: source_revision(selected_src)
    sources: [ProjectSourceIndex] := []
    for file in project.files.iter().filter((file) -> file.kind == "source") {
        path :: project.project_root.join(file.path)
        if !project.parts.should_index(path) -> continue
        source :: read_source_without_symlinks(path).map_err((error) -> query_error("stale", format("Canvas project source moved or unreadable: {}", error)))?
        revision :: source_revision(source)
        if revision != file.revision -> return .Err(query_error("conflict", "project source changed while Canvas was building its query"))
        index :: semindex.open(path).map_err((error) -> query_error("check", error.to_string()))?
        source_id := file.path.trim_start_matches("./") // #4303
        sources.push(ProjectSourceIndex(path: path, source_id: source_id.to_string(), source: source, revision: revision, index: index))
    }
    selected :: sources.iter().find((source) -> source.source_id == selected_source_id) ?? return .Err(query_error("not_found", "Canvas query source is not in the projected project"))
    if selected.revision != selected_revision -> return .Err(query_error("conflict", "source changed since this Canvas graph was drawn"))
    after :: project_context_for_entry(entry)
    if after.project_revision != project.project_revision -> return .Err(query_error("conflict", "project changed while Canvas was building its query"))
    .Ok(ProjectQueryContext(project_root: project.project_root, project_revision: project.project_revision, selected_source_id: selected_source_id, selected_path: selected_path, selected_source: selected_src, sources: sources))
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:637
fn reference_targets(reference: &SymbolRef, definitions: [(&ProjectSourceIndex, &SymbolDef)]) -> Bool {
    target :: reference.target ?? return definitions.is_empty()
    definitions.iter().any(((_, definition)) -> target.semantic_identity == .Some(definition.identity) || (target.module_path == definition.module_path && target.def_span == definition.def_span))
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:651
fn push_project_result(results: &[String], seen: &HashSet<String>, kind: String, title: String, symbol: String, module_path: String, span: SourceSpan, source: &ProjectSourceIndex, projection: Projection?, selected_path: OSPath) -> {
    node :: (source.path == selected_path).then(() -> projection.and_then((value) -> node_for_span(value, span))).flatten()
    key :: format("{}|{}|{}|{}|{}", kind, source.source_id, span.start, span.end, title)
    if !seen.insert(key) -> return
    result := query_result_json(kind, title, symbol, module_path, span, node, source.source)
    _ :: result.pop()
    result.push_str(format(",\"source_id\":{},\"revision\":{}}}", json_str(source.source_id), json_str(source.revision)))
    results.push(result)
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:691
fn bounded_project_results(results: [String]) -> ([String], Bool) {
    results := results
    results.sort()
    truncated :: results.len() > PROJECT_QUERY_RESULT_LIMIT
    results.truncate(PROJECT_QUERY_RESULT_LIMIT)
    (results, truncated)
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:698
fn project_query_ok(op: String, context: &ProjectQueryContext, results: [String], truncated: Bool, extra_fields: String) -> String {
    format("{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{},\"ok\":true,\"op\":{},\"revision\":{},\"source_id\":{},\"project_revision\":{},\"results\":[{}],\"result_limit\":{},\"truncated\":{},{} }}", QUERY_SCHEMA_VERSION, json_str(op), json_str(source_revision(context.selected_source)), json_str(context.selected_source_id), json_str(context.project_revision), results.join(","), PROJECT_QUERY_RESULT_LIMIT, if truncated { "true" } else { "false" }, extra_fields)
}

// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:719
pub fn canvas_source_to_graph(path: OSPath, src: String, span: SourceSpan) -> String Err! {
    projection :: project_file(path).map_err((diags) -> query_diagnostics_error(path, src, diags))?
    results := projection.node_refs.iter().filter((node) -> spans_overlap(node.span, span)).map((node) -> query_result_json("source_to_graph", node.title, node.title, "", node.span, .Some(node), src)).collect()
    if results.is_empty() {
        if node :: nearest_node(projection, span.start) -> results.push(query_result_json("source_to_graph", node.title, node.title, "", node.span, .Some(node), src))
    }
    .Ok(query_ok("source_to_graph", src, format("[{}]", results.join(",")), "\"impact\":null,\"diff\":null"))
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:763
pub fn canvas_preview_rename(path: OSPath, src: String, symbol: String, to: String) -> String Err! {
    (projection, index) :: open_query_context(path, src)?
    edits := []
    results: [String] := []
    for def in index.definitions().iter().filter((d) -> d.name == symbol) {
        edits.push(edit(def.def_span, to))
        results.push(query_result_json("definition", def.name, def.name, def.module_path, def.def_span, node_for_span(projection, def.def_span), src))
    }
    for r in index.references_to(symbol) {
        edits.push(edit(r.span, to))
        results.push(query_result_json("reference", r.name, r.name, r.module_path, r.span, node_for_span(projection, r.span), src))
    }
    if edits.is_empty() -> return .Err(query_error("not_found", "Canvas rename preview found no matching symbol"))
    changed :: FixEngine.apply_edits(src, edits).map_err((_) -> query_error("overlap", "Canvas rename preview edits overlapped"))?
    diff :: simple_diff(src, changed)
    .Ok(query_ok("preview_rename", src, format("[{}]", results.join(",")), format("\"impact\":null,\"diff\":{{\"changed\":{},\"text\":{},\"after_revision\":{}}}", if changed != src { "true" } else { "false" }, json_str(diff), json_str(source_revision(changed)))))
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:818
pub fn canvas_actions(path: OSPath, src: String) -> String Err! {
    (projection, index) :: open_query_context(path, src)?
    authority :: canvas_authority_context(path)
    entries: [String] := []
    project_functions: [String] := []
    for def in index.definitions() {
        if def.kind is .Function(params: params, ret: ret, ..) {
            if def.module_path.starts_with("core.") -> continue
            export :: projection.callable_exports.iter().find((export) -> export.module_path == def.module_path && export.span == def.def_span) ?? continue
            pure :: symbol_def_is_pure(def)
            project_functions.push(project_function_catalog_json(def, params, ret, export.callee))
            if def.name == "run" -> continue
            entries.push(canvas_action_json(def, params, ret, pure, export.callee, authority))
        }
    }
    entries.push(canvas_builtin_action_json("print", "Print", [("value", "Any")], "Void", ["\"canvas\""], authority))
    entries.extend(canvas_core_catalog_action_jsons(src, authority))
    entries.extend(projection.game_facts.iter().map((fact) -> canvas_game_action_json(fact, authority, source_revision(src))))
    entries.extend(canvas_structural_action_jsons(authority))
    entries.extend(canvas_command_action_jsons(authority))
    entries.sort()
    project_functions.sort()
    .Ok(query_ok("actions", src, "[]", format("\"impact\":null,\"diff\":null,\"actions_schema_version\":{},\"project_functions\":[{}],\"actions\":[{}]", ACTION_SCHEMA_VERSION, project_functions.join(","), entries.join(","))))
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:888
pub fn canvas_core_catalog_query(path: OSPath, src: String, request: String) -> String Err! {
    query :: json_string_field(request, "query").unwrap_or_default()
    canvas_core_catalog(path, src, query)
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:897
pub fn canvas_core_catalog(_path: OSPath, src: String, query: String) -> String Err! {
    catalog :: core_catalog_entries(query)
    modules :: catalog.iter().map((module) -> core_module_json(src, module)).collect().join(",")
    .Ok(query_ok("core_catalog", src, "[]", format("\"impact\":null,\"diff\":null,\"catalog_schema_version\":{},\"authority\":[{}],\"writes\":\"none\",\"source\":{},\"modules\":[{}]", CORE_CATALOG_SCHEMA_VERSION, json_str("canvas.catalog:core.read"), json_str("Docs/spec/reference/core-library.md"), modules)))
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:918
fn canvas_core_catalog_action_jsons(src: String, authority: &CanvasAuthority) -> [String] {
    core_catalog_entries("").into_iter().flat_map((module) -> {
        module_path :: module.path
        source_callee :: core_source_callee(src, module_path)
        module.members.into_iter().map((member) -> core_catalog_action_json(module_path, source_callee, member, authority))
    }).collect()
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:931
fn core_catalog_action_json(module_path: String, source_callee_prefix: String, member: &CoreCatalogMember, authority: &CanvasAuthority) -> String {
    action_id :: format("canvas.core_catalog:{}:{}", module_path, member.name)
    callee :: format("{}.{}", source_callee_prefix, member.name)
    params :: core_member_params(module_path, member.name, member.signature)
    default_args :: params.iter().map(((_, ty)) -> json_str(default_arg_for_type(ty))).collect().join(",")
    receiver_type :: (!member.receiver_type.is_empty()).then_some(member.receiver_type)
    pins :: core_member_pins_json(params, receiver_type)
    status :: core_member_status_json(member)
    descriptor_id :: node_catalog.insert_descriptor_id("insert_call", member.pure)
    rank_fields :: node_catalog.palette_rank_fields(descriptor_id)
    format("{{\"action_id\":{},\"node_descriptor_id\":{}{},\"kind\":\"canvas.core_catalog\",\"title\":{},\"module_path\":{},\"callee\":{},\"insert_callee\":{},\"insert_op\":\"insert_call\",\"engine\":\"checked-tir+jit\",\"execution\":\"source_transaction\",{}\"authority\":[{}],\"package_id\":{},\"version\":{},\"touched_files\":[{}],\"writes\":\"source_transaction_only\",\"requires_confirmation\":false,\"audit\":[\"source\",\"module_path\",\"signature\",\"diff\",\"diagnostics\"],\"signature\":{},\"ret\":{},\"pure\":{},\"summary\":{},\"source\":{},\"pins\":[{}],\"default_args\":[{}]}}", json_str(action_id), json_str(descriptor_id), rank_fields, json_str(format("{} · {}", member.name, module_path)), json_str(module_path), json_str(callee), json_str(callee), status, json_str(authority.grant), json_str(authority.package_id), json_str(authority.version), json_str(authority.touched_file), json_str(member.signature), json_str(core_member_return_type(module_path, member.name)), if member.pure { "true" } else { "false" }, json_str(member.summary), json_str(member.source), pins, default_args)
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:974
struct CoreCatalogModule { path: String, title: String, summary: String, members: [CoreCatalogMember] }
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:982
struct CoreCatalogMember {
    name: String
    signature: String
    summary: String
    source: String
    pure: Bool
    available: Bool
    stageable: Bool
    stage_reason_code: String
    stage_reason: String
    receiver_type: String
    unavailable_reason_code: String
    unavailable_reason: String
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:998
fn core_catalog_entries(query: String) -> [CoreCatalogModule] {
    needle := query.trim() // #4303
    modules := parse_core_catalog_markdown(include_str("../../../../Docs/spec/reference/core-library.md"))
    registry :: include_str("../../../../crates/jet-sema/src/Sema/CheckerCoreLib/module_items.rs")
    exports :: parse_sema_core_module_items(registry)
    merge_sema_core_registry(&modules, registry)
    mark_core_catalog_availability(&modules, exports)
    if !needle.is_empty() {
        modules = modules.into_iter().filter_map((module) -> {
            module := module
            module.members = module.members.into_iter().filter((member) -> contains_ci(member.name, needle) || contains_ci(member.signature, needle) || contains_ci(member.summary, needle)).collect()
            if contains_ci(module.path, needle) || contains_ci(module.title, needle) || contains_ci(module.summary, needle) || !module.members.is_empty() { .Some(module) } else { .None }
        }).collect()
    }
