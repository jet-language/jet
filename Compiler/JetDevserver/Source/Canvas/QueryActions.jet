}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1237
fn core_member_unavailable_reason(module_path: String, member: &CoreCatalogMember) -> (String, String) {
    sig := member.signature.trim() // #4303
    if module_path == "core.args" && sig.starts_with('.') -> return ("method_only", "Use this as a method on an ArgsSpec value.")
    if sig.starts_with('.') || sig.contains(").") -> return ("method_only", "Use this from the value shown in the signature.")
    if sig.contains('.') && !sig.starts_with(module_path) -> return ("type_member", "Use this from the type shown in the signature.")
    ("not_direct_call", "This Core entry is documentation only; it has no direct module call.")
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1266
fn core_member_receiver_type(module_path: String, member_name: String, signature: String) -> String {
    if module_path == "core.args" {
        arity :: core_member_params(module_path, member_name, signature).len()
        return if member_name is {
            "flag".bit_or("option").bit_or("option_int").bit_or("option_float").bit_or("positional") if arity == 1 -> "ParsedArgs"
            "options".bit_or("subcommand") if arity <= 1 -> "ParsedArgs"
            _ -> "ArgsSpec"
        }
    }
    if module_path is {
        "core.mod" -> "Option"
        "core.reflect" if member_name == "name".bit_or("value") -> "Field"
        "core.reflect" -> "Value"
        "core.net.tls" -> "TLSClientConfig"
        "core.http" -> "HTTPClient"
        "core.perf" -> "String"
        _ -> ""
    }
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1290
fn parse_sema_core_module_items(registry: String) -> [(String, [String])] {
    out := [(String, [String])]{}
    lines := registry.lines().peekable()
    loop {
        line :: lines.next() ?? break
        trimmed := line.trim() // #4303
        if !trimmed.starts_with('"') || !trimmed.contains("=> &[") -> next
        raw_path :: parse_quoted(trimmed) ?? next
        if !(raw_path == "core" || raw_path.starts_with("core.") || raw_path.starts_with("jet.")) -> next
        path :: user_core_module_path(raw_path)
        names := [String]{}
        after_array :: trimmed.split_once("&[").map(((_, rest)) -> rest).unwrap_or_default()
        if (same_line, _) :: after_array.split_once(']') {
            loop name in quoted_strings(same_line) { if !names.iter().any((existing) -> existing == name) -> names.push(name) }
            out.push((path, names))
            next
        }
        loop body_line in lines.by_ref() {
            body := body_line.trim() // #4303
            if body.starts_with("],") || body.starts_with("]") -> break
            loop name in quoted_strings(body) { if !names.iter().any((existing) -> existing == name) -> names.push(name) }
        }
        out.push((path, names))
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1335
fn user_core_module_path(path: String) -> String {
    if path.strip_prefix("jet.") == .Val(ring) -> "core.{ring}" else -> path.to_string()
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1343
fn quoted_strings(line: String) -> [String] {
    out := [String]{}
    rest := line
    loop {
        value :: parse_quoted(rest) ?? break
        skip :: rest.find('"').map((i) -> i + 1).unwrap_or(0)
        after_open := rest[skip..<rest.len()] // #4303
        end :: after_open.find('"') ?? break
        out.push(value)
        rest = after_open[end + 1..<after_open.len()]
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1358
fn parse_quoted(text: String) -> String? {
    first :: text.find('"')?
    rest := text[first + 1..<text.len()] // #4303
    end :: rest.find('"')?
    .Some(rest[0..<end].to_string())
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1365
fn parse_core_catalog_markdown(markdown: String) -> [CoreCatalogModule] {
    modules := [CoreCatalogModule]{}
    current := CoreCatalogModule?{.None}
    loop line in markdown.lines() {
        if core_heading_path(line) == .Val(path) {
            if current.take() == .Val(module_ref) -> modules.push(module_ref)
            current = .Some(CoreCatalogModule(path: path, title: strip_markdown_heading(line), summary: "", members: []))
            next
        }
        module_ref :: current.as_mut() ?? next
        trimmed := line.trim() // #4303
        if module_ref.summary.is_empty() && !trimmed.is_empty() && !trimmed.starts_with('|') && !trimmed.starts_with("```") && !trimmed.starts_with('#') -> module_ref.summary = strip_markdown_inline(trimmed)
        if core_catalog_member_from_line(trimmed) == .Val(member) {
            if !module_ref.members.iter().any((existing) -> existing.signature == member.signature) -> module_ref.members.push(member)
        }
    }
    if current == .Val(module_ref) -> modules.push(module_ref)
    loop path in core_paths_in_markdown(markdown) {
        if !modules.iter().any((module_ref) -> module_ref.path == path) -> modules.push(CoreCatalogModule(title: path, path: path, summary: "Listed in the canonical Core library reference.", members: []))
    }
    modules
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1419
fn core_paths_in_markdown(markdown: String) -> [String] {
    paths := [String]{}
    loop token in markdown.split((c) -> !(c.is_ascii_alphanumeric() || c == '_' || c == '.')) {
        if token == "core" || token.starts_with("core.") {
            path := token.trim_matches('.') // #4303
            if !path.is_empty() && !paths.iter().any((existing) -> existing == path) -> paths.push(path.to_string())
        }
    }
    paths
}
