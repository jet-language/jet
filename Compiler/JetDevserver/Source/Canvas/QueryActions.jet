fn mark_core_catalog_availability(modules: &[CoreCatalogModule], exports: [(String, [String])]) -> {
    for module in modules {
        for member in &module.members {
            if core_export_resolves(exports, module.path, member.name) {
                if (code, reason) :: core_member_direct_exclusion(module.path, member) { set_core_member_status(module.path, member, code, reason) }
