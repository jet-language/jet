// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1885
fn core_member_return_type(module_path: String, member_name: String) -> String {
    jet_driver.Sema.core_call_surface_signature(module_path, member_name).and_then(((_, ret)) -> ret).map((ret) -> ret.name()).unwrap_or("Void")
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1892
fn params_from_signature(signature: String) -> [(String, String)]? {
    start :: signature.find('(')?
    end :: signature[start + 1..<signature.len()].find(')')? + start + 1
    body := signature[start + 1..end].trim() // #4303
    if body.is_empty() -> return .Some([])
    params := [(String, String)]{}
    loop (i, raw) in body.split(',').enumerate() {
        part := raw.trim() // #4303
        if part.is_empty() -> next
        (name, ty) :: if (name, ty) :: part.split_once(':') { (name.trim(), normalize_param_type(ty.trim())) } else {
            name := part.split((c) -> !(c.is_ascii_alphanumeric() || c == '_')).next().unwrap_or("").trim() // #4303
            (name, type_for_param_name(name))
        }
        name :: if name.is_empty() -> "arg{i + 1}" else -> name.to_string()
        params.push((name, ty))
    }
    .Some(params)
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1925
fn normalize_param_type(ty: String) -> String {
    normalized := ty.split('=').next().unwrap_or(ty).trim().trim_end_matches('?').trim() // #4303
    normalized.to_string()
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1935
fn type_for_param_name(name: String) -> String {
    if name is {
        "text".bit_or("raw").bit_or("body").bit_or("path").bit_or("name").bit_or("url").bit_or("host").bit_or("scheme").bit_or("query").bit_or("fragment").bit_or("delim").bit_or("method") -> "String"
        "ok".bit_or("enabled").bit_or("flag") -> "Bool"
        _ -> "Int"
    }
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1945
fn default_arg_for_type(ty: String) -> String {
    ty := ty.trim().trim_end_matches('?').trim() // #4303
    if ty is {
        "Bool" -> "true"
        "String".bit_or("Path").bit_or("URL") -> "\"canvas\""
        "Float".bit_or("F32").bit_or("F64").bit_or("Decimal") -> "1.0"
        _ -> "1"
    }
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1955
fn canvas_game_action_json(fact: CanvasGameFact, authority: CanvasAuthority, revision: String) -> String {
    resource_kind :: if fact.kind == "asset" -> "asset" else -> "component"
    title :: if fact.kind == "asset" -> "Edit {fact.operation.rsplit('.').next().unwrap_or("game")} asset" else -> "Edit component"
    target :: "{{\"source_id\":{json_str(fact.source_id)},\"revision\":{json_str(revision)},\"authored_instance_id\":{json_str(fact.authored_instance_id)},\"source_span\":{span_json(fact.source_span)}}}"
    patch :: "{{\"field\":{json_str(fact.field)},\"value\":{json_str(canvas_game_patch_value(fact))}}}"
    "{{\"action_id\":{json_str(format("canvas.game:{}", fact.authored_instance_id))},\"node_descriptor_id\":\"function_exec\",\"kind\":\"canvas.game\",\"resource_kind\":{json_str(resource_kind)},\"title\":{json_str(title)},\"op\":\"edit_game_selection\",\"engine\":\"source-transaction\",\"execution\":\"source_transaction\",\"available\":true,\"authority\":[{json_str(authority.grant)}],\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"touched_files\":[{json_str(fact.source_id)}],\"writes\":\"source_transaction_only\",\"requires_confirmation\":false,\"targets\":[{target}],\"field_patch\":{patch},\"source_truth\":\"ordinary_jet_source\",\"fact\":{canvas_game_fact_json(fact)}}}"
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:1997
fn canvas_game_patch_value(fact: CanvasGameFact) -> String {
    value := fact.value_source.trim() // #4303
    inner :: value.strip_prefix('"').and_then((value) -> value.strip_suffix('"')) ?? return value.to_string()
    out := String.with_capacity(inner.len())
    escaped := false
    loop character in inner.chars() {
        if escaped {
            if character is {
                'n' -> out.push('\n')
                'r' -> out.push(Char{13})
                't' -> out.push('\t')
                '"' -> out.push('"')
                '\\' -> out.push('\\')
                other -> { out.push('\\'); out.push(other) }
            }
            escaped = false
        } else if character == '\\' { escaped = true } else { out.push(character) }
    }
    if escaped -> out.push('\\')
    out
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:2033
fn canvas_structural_action_jsons(authority: CanvasAuthority) -> [String] {
    [("branch", "Branch", "insert_branch"), ("dispatch", "Switch", "insert_switch"), ("loop", "Loop", "insert_loop"), ("fallible", "Failure rail", "insert_fallible_rail")].into_iter().map(((name, title, transaction)) -> {
        descriptor_id :: node_catalog.insert_descriptor_id(transaction, false)
        rank_fields :: node_catalog.palette_rank_fields(descriptor_id)
        "{{\"action_id\":{json_str(format("canvas.structural:{}", name))},\"node_descriptor_id\":{json_str(descriptor_id)}{rank_fields},\"kind\":\"canvas.structural\",\"title\":{json_str(title)},\"op\":{json_str(transaction)},\"engine\":\"source-transaction\",\"execution\":\"source_transaction\",\"available\":true,\"authority\":[{json_str(authority.grant)}],\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"touched_files\":[{json_str(authority.touched_file)}],\"writes\":\"source_transaction_only\",\"requires_confirmation\":false}}"
    }).collect()
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:2060
fn canvas_command_action_jsons(authority: CanvasAuthority) -> [String] {
    source :: authority.touched_file
    actions := [
        canvas_command_action_json("run", "Run program", ["jet", "run", source], "none", ["canvas.command:run", authority.grant], true, .None, authority),
        canvas_command_action_json("check", "Check project", ["jet", "check", source], "none", ["canvas.command:check", authority.grant], true, .None, authority),
        canvas_command_action_json("test", "Test project", ["jet", "test", source], "test_outputs", ["canvas.command:test", "canvas.build_output:test", authority.grant], true, .None, authority),
        canvas_command_action_json("build", "Build project", ["jet", "build", source], "build_outputs", ["canvas.command:build", "canvas.build_output:binary", authority.grant], true, .None, authority),
    ]
    services_available :: env_project_json(authority.project_root).services.contains("\"enable\":true")
    actions.push(canvas_command_action_json("service.start", "Start service", ["jet", "services", "up"], "service_process", ["canvas.service:start", "canvas.env:service"], services_available, if services_available -> .None else -> .Some("no env service selected"), authority))
    actions
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:2132
fn canvas_command_action_json(name: String, title: String, command: [String], writes: String, grants: [String], available: Bool, denied: String?, authority: &CanvasAuthority) -> String {
    command_json :: command.iter().map(json_str).collect().join(",")
    grants_json :: grants.iter().map(json_str).collect().join(",")
    "{{\"action_id\":{json_str(format("canvas.command:{}", name))},\"kind\":\"canvas.command\",\"title\":{json_str(title)},\"op\":\"command_authority\",\"engine\":\"jet-cli\",\"execution\":\"external_command\",\"available\":{if available { "true" } else { "false" }},\"denied_reason\":{json_optional_str(denied)},\"command\":[{command_json}],\"authority\":[{grants_json}],\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"touched_files\":[{json_str(authority.touched_file)}],\"writes\":{json_str(writes)},\"requires_confirmation\":{if writes == "none" { "false" } else { "true" }},\"audit\":[\"package_id\",\"version\",\"command\",\"authority\",\"touched_files\",\"diagnostics\"]}}"
}
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:2168
struct CanvasAuthority { grant: String, package_id: String, version: String, touched_file: String, project_root: OSPath }
// Rust: crates/jet-devserver/src/Canvas/query_actions.rs:2176
fn canvas_authority_context(path: OSPath) -> CanvasAuthority {
    dir :: path.parent().unwrap_or_else(() -> OSPath.new("."))
    if semindex.package_facts_for_entry(path) == .Ok(.Some(package)) {
        root :: jet_driver.Loader.find_manifest_root(dir).unwrap_or_else(() -> dir.to_path_buf())
        return CanvasAuthority(grant: "canvas.source_edit:package", package_id: package.name, version: package.version.unwrap_or("unversioned"), touched_file: rel_path(root, path), project_root: root)
    }
    CanvasAuthority(grant: "canvas.source_edit:single_file", package_id: "single-file", version: "unpackaged", touched_file: path.file_name().and_then((n) -> n.to_str()).unwrap_or("current.jet").to_string(), project_root: dir.to_path_buf())
}

