            module_ref.members.push(CoreCatalogMember(signature: "{path}.{name}", summary: "Compiler-known Core item from sema registry.", source: "crates/jet-sema/src/Sema/CheckerCoreLib/module_items.rs", pure: core_member_pure(path, name), name: name, available: true, stageable: false, stage_reason_code: "", stage_reason: "", receiver_type: "", unavailable_reason_code: "", unavailable_reason: ""))
