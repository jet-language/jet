// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:993
fn collect_interface_facts(items: &[&Item], out: &[String], scope: &[String], src: String, module_idx: USize, module_alias: String, name_ledger: &jet_foundation.Names.NameLedger) -> {
    for item in items {
        if item == {
            .Trait(t) -> {
                trait_path := source_item_path(name_ledger, module_idx, module_alias, t.name, t.name_span, scope)
                out.push(trait_fact_json(src, t, trait_path))
            },
            .Impl(i) if i.trait_name.is_some() && !i.is_generated_serde -> {
                type_path := source_item_path(name_ledger, module_idx, module_alias, i.type_name, i.type_span, scope)
                trait_name := i.trait_name.as_deref().unwrap_or("")
                trait_path := source_item_path(name_ledger, module_idx, module_alias, trait_name, i.trait_span.unwrap_or(i.type_span), scope)
                out.push(impl_fact_json(i, type_path, trait_path))
            },
            .Struct(s) -> {
                for block in s.trait_impls.iter().filter((block) -> !block.compiler_generated) {
                    type_path := source_item_path(name_ledger, module_idx, module_alias, s.name, s.name_span, scope)
                    trait_path := source_item_path(name_ledger, module_idx, module_alias, block.trait_name, block.trait_span, scope)
                    out.push(inline_trait_impl_fact_json(type_path, trait_path, block))
                }
            },
            .Enum(e) -> {
                for block in e.trait_impls.iter().filter((block) -> !block.compiler_generated) {
                    type_path := source_item_path(name_ledger, module_idx, module_alias, e.name, e.name_span, scope)
                    trait_path := source_item_path(name_ledger, module_idx, module_alias, block.trait_name, block.trait_span, scope)
                    out.push(inline_trait_impl_fact_json(type_path, trait_path, block))
                }
            },
            .CodeModule(m) -> {
                if m.body == .Val(body) {
                    nested := body.iter().collect(); nested_scope := scope.to_vec(); nested_scope.push(m.name.clone())
                    collect_interface_facts(nested, out, nested_scope, src, module_idx, module_alias, name_ledger)
                }
            },
            _ -> {}
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1106
fn source_item_path(name_ledger: &jet_foundation.Names.NameLedger, module_idx: USize, module_alias: String, internal_name: String, span: Span, fallback_scope: &[String]) -> String {
    for candidate in ["{module_alias}.{internal_name}", if fallback_scope.is_empty() -> "{module_alias}.{internal_name}" else "{module_alias}.{fallback_scope.join(\".\")}.{internal_name}"] {
        if name_ledger.display_path(module_idx, candidate, .Val(module_idx)) == .Val(path) -> return strip_module_alias(path, module_alias)
    }
    if name_ledger.canonical_path_at(module_idx, span.start, span.end) == .Val(path) -> return strip_module_alias(path, module_alias)
    fallback := if fallback_scope.is_empty() || internal_name.contains('.') -> internal_name.to_string() else "{fallback_scope.join(\".\")}.{internal_name}"
    strip_module_alias(fallback, module_alias)
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1143
fn strip_module_alias(path: String, module_alias: String) -> String {
    path.strip_prefix(module_alias).and_then((rest) -> rest.strip_prefix('.')).unwrap_or(path).to_string()
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1150
fn trait_fact_json(src: String, t: &AST.TraitDef, display_path: String) -> String {
    (scope, trait_name) := display_path.rsplit_once('.').map_or(("", display_path), (parts) -> parts)
    associated_types := t.assoc_types.iter().map((entry) -> json_str(entry.0)).collect().join(",")
    methods := t.methods.iter().map((m) -> {
        effects := m.declared_effects.as_ref().map((effects) -> effects.iter().map((entry) -> json_str(entry.0)).collect().join(",")).unwrap_or_default()
        "{{\"name\":{json_str(m.name)},\"signature\":{json_str(trait_method_signature(src, m))},\"required\":{m.default_body.is_none()},\"default\":{m.default_body.is_some()},\"pure\":{m.is_pure},\"effects\":[{effects}],\"source_span\":{span_json(m.span.into())}}}"
    }).collect().join(",")
    "{{\"kind\":\"trait_interface\",\"trait\":{json_str(trait_name)},\"scope\":{json_str(scope)},\"associated_types\":[{associated_types}],\"methods\":[{methods}],\"source_span\":{span_json(t.name_span.into())},\"authoring\":[\"create_trait_impl\",\"jump_trait_to_impls\",\"palette_trait_methods\"]}}"
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1198
fn impl_fact_json(i: &AST.ImplDef, type_path: String, trait_path: String) -> String {
    methods := i.methods.iter().map((m) -> json_str(m.name)).collect().join(",")
    associated_types := i.assoc_type_impls.iter().map((entry) -> json_str(entry.0)).collect().join(",")
    delegation := i.delegation_field.as_deref().map(json_str).unwrap_or_else(() -> "null".to_string())
    trait_name := trait_path.rsplit_once('.').map_or(trait_path, (parts) -> parts.1)
    scope := trait_path.rsplit_once('.').map_or("", (parts) -> parts.0)
    "{{\"kind\":\"trait_impl\",\"type\":{json_str(type_path)},\"trait\":{json_str(trait_name)},\"scope\":{json_str(scope)},\"methods\":[{methods}],\"associated_types\":[{associated_types}],\"delegation_field\":{delegation},\"source_span\":{span_json(i.type_span.into())},\"diagnostic_affordance\":\"surface_missing_trait_members\"}}"
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1226
fn inline_trait_impl_fact_json(type_path: String, trait_path: String, block: &AST.TraitImplBlock) -> String {
    methods := block.methods.iter().map((m) -> json_str(m.name)).collect().join(",")
    associated_types := block.assoc_type_impls.iter().map((entry) -> json_str(entry.0)).collect().join(",")
    trait_name := trait_path.rsplit_once('.').map_or(trait_path, (parts) -> parts.1)
    scope := trait_path.rsplit_once('.').map_or("", (parts) -> parts.0)
    "{{\"kind\":\"trait_impl\",\"type\":{json_str(type_path)},\"trait\":{json_str(trait_name)},\"scope\":{json_str(scope)},\"methods\":[{methods}],\"associated_types\":[{associated_types}],\"delegation_field\":null,\"source_span\":{span_json(block.trait_span.into())},\"diagnostic_affordance\":\"surface_missing_trait_members\"}}"
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1254
pub fn trait_method_signature(src: String, m: &AST.TraitMethodSig) -> String {
    params := m.params.iter().enumerate().flat_map((entry) -> {
        (i, p) := entry; parts: [String] := []
        if p.zone == .LabelOnly && !m.params[..i].iter().any((previous) -> previous.zone == .LabelOnly) -> parts.push("*")
        parts.push(trait_param_signature(src, p))
        if p.zone == .PositionalOnly && m.params.get(i + 1).is_none_or((next) -> next.zone != .PositionalOnly) -> parts.push("/")
        parts
    }).collect().join(", ")
    ret := m.return_type.as_ref().map((t) -> " {t.name()}").unwrap_or_default()
    provenance := trait_return_view_from(m, m.params)
    arrow := if m.declared_effects == .Val(row) {
        " -[{row.iter().map((entry) -> entry.0.as_str()).collect().join(\", \")}]>"
    } else if m.is_pure { " -[]>" } else { " ->" }
    "fn {m.name}({params}){arrow}{ret}{provenance}"
}

// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1302
fn event_dispatcher_facts(path: &OSPath, source: String, bundle: &AST.ProgramBundle, index: &SemIndex) -> [String] {
    path_text := path.to_string_lossy()
    module := bundle.modules.iter().find((module) -> module.display == path_text.as_ref()).or_else(() -> bundle.modules.iter().find((module) -> module.source == source)) ?? return []
    src := module.source.as_str()
    index.call_edges().iter().filter((call) -> call.module_path == module.display).filter_map((call) -> {
        aliases := event_module_aliases(src)
        call_source_span := event_call_span(src, call.call_span).unwrap_or(call.call_span)
        call_source := src.get(call_source_span.start..call_source_span.end).unwrap_or(call.callee)
        constructor := event_constructor_kind(src, call.call_span, call.callee.as_str(), call_source, aliases)
        receiver := event_receiver(src, index, call.call_span, module.display)
        kind := constructor.or_else(() -> {
            receiver_type := receiver.as_ref().map((receiver) -> receiver.1.as_str())?
            event_method_kind(receiver_type, call.callee.as_str())
        })?
        scope := event_scope_argument(index, call_source_span, module.display)
        receiver_type := constructor_type(call.callee.as_str(), call_source).or_else(() -> receiver.as_ref().map((receiver) -> receiver.1.clone()))
        receiver_name := receiver.as_ref().map((receiver) -> receiver.0.as_str()).map(json_str).unwrap_or_else(() -> "null".to_string())
        receiver_span := receiver.as_ref().map((receiver) -> span_json(receiver.2)).unwrap_or_else(() -> "null".to_string())
        scope_name := scope.as_ref().map((scope) -> scope.0.as_str()).map(json_str).unwrap_or_else(() -> "null".to_string())
        scope_span := scope.as_ref().map((scope) -> span_json(scope.1)).unwrap_or_else(() -> "null".to_string())
        receiver_json := receiver_type.as_deref().map(json_str).unwrap_or_else(() -> "null".to_string())
        .Val("{{\"kind\":{json_str(kind)},\"source\":{json_str(call_source)},\"source_span\":{span_json(call_source_span)},\"receiver\":{receiver_name},\"receiver_source_span\":{receiver_span},\"receiver_type\":{receiver_json},\"scope\":{scope_name},\"scope_source_span\":{scope_span},\"fact_source\":\"semindex_checked_call\",\"lifetime\":\"EventScope-owned\",\"observables\":[\"listener_count\",\"blocked_count\",\"queued_count\",\"running_count\",\"DispatchReport.trace\"],\"semantics\":\"core.event_source_truth\"}}")
    }).collect()
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1365
fn event_module_aliases(src: String) -> [String] {
    aliases: [String] := []
    for raw_line in src.lines() {
        line := raw_line.split("//").next().unwrap_or("").trim() // #4303
        rest := line.strip_prefix("use core.") ?? continue
        full := "core.{rest}"
        (module, alias) := full.split_once(" as ").map((parts) -> (parts.0.trim(), parts.1.trim())).unwrap_or_else(() -> {
            module := full.trim() // #4303
            (module, module.rsplit('.').next().unwrap_or(""))
        })
        if module == "core.event" && !alias.is_empty() -> aliases.push(alias.to_string())
    }
    aliases.sort(); aliases.dedup(); aliases
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1389
fn event_constructor_kind(src: String, call_span: SourceSpan, callee: String, _source: String, aliases: &[String]) -> String? {
    before := src.get(..call_span.start.min(src.len()))?.trim_end() // #4303
    if !aliases.iter().any((alias) -> before.ends_with("{alias}.")) -> return .None
    if callee == {
        "new" -> .Val("event_stream_create"), "with_policy" -> .Val("event_stream_create_with_policy"),
        "async_result" -> .Val("async_event_create"), "hook" -> .Val("hook_create"),
        "decision_hook" -> .Val("decision_hook_create"), "scope" -> .Val("event_scope_create"),
        "policy_sync" -> .Val("event_policy_sync"), _ -> .None
    }
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1415
fn constructor_type(callee: String, source: String) -> String? {
    type_args := source.find('<').and_then((start) -> source[start + 1..].find('>').map((end) -> source[start + 1..start + 1 + end])).map((s) -> s.trim()).filter((args) -> !args.is_empty())
    if callee == {
        "new" | "with_policy" -> type_args.map((args) -> "Event<{args}>"),
        "async_result" -> type_args.map((args) -> "AsyncEvent<{args}>"),
        "hook" -> type_args.map((args) -> "Hook<{args}>"),
        "decision_hook" -> type_args.map((args) -> "DecisionHook<{args}>"),
        "scope" -> .Val("EventScope"), "policy_sync" -> .Val("EventPolicy"), _ -> .None
    }
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1436
fn event_call_span(src: String, callee_span: SourceSpan) -> SourceSpan? {
    tail := src.get(callee_span.end..)?
    open_offset := tail.find('(')?; open := callee_span.end + open_offset
    bytes := src.as_bytes(); depth: USize := 0; quoted := false; escaped := false
    for (offset, byte) in bytes.iter().enumerate().skip(open) {
        ch := byte as Char
        if quoted {
            if escaped { escaped = false } else if ch == '\\' { escaped = true } else if ch == '"' { quoted = false }
            continue
        }
        if ch == '"' { quoted = true; continue }
        if ch == '(' { depth += 1 }
        else if ch == ')' {
            depth = depth.saturating_sub(1)
            if depth == 0 -> return .Val(SourceSpan { start: callee_span.start, end: offset + 1 })
        }
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1475
fn event_receiver(src: String, index: &SemIndex, call_span: SourceSpan, module_path: String) -> (String, String, SourceSpan)? {
    reference := index.references().iter().filter((reference) -> reference.module_path == module_path)
        .filter((reference) -> reference.span.end <= call_span.start)
        .filter((reference) -> src.get(reference.span.end..call_span.start).is_some_and((between) -> between.trim() == "."))
        .max_by_key((reference) -> reference.span.end)?
    target := reference.target.as_ref()?
    definition := index.definitions().iter().find((definition) -> definition.module_path == target.module_path && definition.def_span == target.def_span)?
    ty := if definition.kind == { .Local { ty: .Val(ty), .. } | .Param { ty } -> ty.clone(), _ -> return .None }
    .Val((reference.name.clone(), ty, reference.span))
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1502
fn event_scope_argument(index: &SemIndex, call_span: SourceSpan, module_path: String) -> (String, SourceSpan)? {
    index.references().iter().filter((reference) -> reference.module_path == module_path)
        .filter((reference) -> reference.span.start >= call_span.start && reference.span.end <= call_span.end)
        .filter_map((reference) -> {
            target := reference.target.as_ref()?
            definition := index.definitions().iter().find((definition) -> definition.module_path == target.module_path && definition.def_span == target.def_span)?
            is_scope := if definition.kind == { .Local { ty: .Val(ty), .. } if ty == "EventScope" -> true, _ -> false }
            if is_scope -> .Val((reference.name.clone(), reference.span)) else .None
        }).min_by_key((entry) -> entry.1.start)
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1526
fn event_method_kind(receiver_type: String, method: String) -> String? {
    kind := if (receiver_type, method) == {
        (ty, "on") if is_event_handler_type(ty) -> "event_subscribe",
        (ty, "once") if is_event_handler_type(ty) -> "event_subscribe_once",
        (ty, "on_priority") if is_event_handler_type(ty) -> "event_subscribe_priority",
        (ty, "emit") if ty.starts_with("Event<") -> "event_emit",
        (ty, "emit_async") if ty.starts_with("AsyncEvent<") -> "event_emit_async",
        (ty, "close") if ty.starts_with("AsyncEvent<") -> "event_close",
        (ty, "listener_count") if is_event_handler_type(ty) -> "event_listener_count",
        (ty, "queued_count") if ty.starts_with("AsyncEvent<") -> "event_queued_count",
        (ty, "running_count") if ty.starts_with("AsyncEvent<") -> "event_running_count",
        (ty, "blocked_count") if ty.starts_with("AsyncEvent<") -> "event_pending_count",
        (ty, "run") if ty.starts_with("Hook<") -> "hook_run",
        (ty, "run") if ty.starts_with("DecisionHook<") -> "decision_hook_run",
        ("EventScope", "cancel") -> "event_scope_cancel", ("EventScope", "active_count") -> "event_scope_active_count",
        ("Subscription", "unsubscribe") -> "event_unsubscribe", ("Subscription", "is_active") -> "event_subscription_active",
        ("EventTrace", "summary") -> "event_trace_summary",
        ("EventTrace", "delivered" | "queued" | "dropped") -> "event_trace_count",
        (ty, "accepted") if ty.starts_with("DispatchReport<") -> "event_report_accepted",
        (ty, "delivered_handlers") if ty.starts_with("DispatchReport<") -> "event_report_delivered",
        (ty, "state") if ty.starts_with("DispatchReport<") -> "event_report_state",
        (ty, "failures") if ty.starts_with("DispatchReport<") -> "event_report_failures",
        (ty, "trace") if ty.starts_with("DispatchReport<") -> "event_report_trace",
        _ -> return .None
    }
    .Val(kind)
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1556
fn is_event_handler_type(ty: String) -> Bool {
    ty.starts_with("Event<") || ty.starts_with("AsyncEvent<") || ty.starts_with("Hook<") || ty.starts_with("DecisionHook<")
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1563
fn trait_param_signature(src: String, p: &AST.Param) -> String {
    is_self := p.name == "self" && p.ty.name().is_empty(); out := String.new()
    if p.root -> out.push_str("#Root ")
    if is_self { out.push_str(p.convention.sigil()); out.push_str(p.name); return out }
    if p.public_label == .Val((label, _)) { out.push_str(label); out.push(' ') }
    out.push_str(p.name); out.push_str(": "); out.push_str(p.convention.sigil())
    if p.variadic -> out.push_str("...")
    if p.variadic_bound_list == .Val(bounds) { out.push('['); out.push_str(bounds.join(", ")); out.push(']') }
    else { out.push_str(p.ty.name()) }
    if p.declared_view_from_names == .Val(names) && !names.is_empty() { out.push_str(" from "); out.push_str(names.join(" | ")) }
    if p.default == .Val(default) { out.push('{'); out.push_str(snippet(src, default.span())); out.push('}') }
    out
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1605
fn trait_return_view_from(m: &AST.TraitMethodSig, params: &[AST.Param]) -> String {
    map := m.declared_return_view_provenance.as_ref() ?? return String.new()
    if map.is_empty() -> return String.new()
    source_union := (provenance: &AST.ViewProvenance) -> {
        provenance.sources.iter().map((path) -> {
            source := if path.source == {
                .Receiver -> "self".to_string(),
                .Parameter(index) -> params.iter().filter((param) -> param.name != "self").nth(index).map((param) -> param.name.clone()).unwrap_or_else(() -> "param{index}"),
                .Static { module_path, name } -> if module_path.is_empty() -> "static.{name}" else "static.{module_path}.{name}"
            }
            for projection in path.projections {
                if projection == .Field(field) { source.push('.'); source.push_str(field) }
            }
            source
        }).collect().join(" | ")
    }
    keys := map.keys().collect(); keys.sort() // GATE #4499: view path keys keep structural order.
    body := if map.len() == 1 {
        path := keys.first().expect("non-empty view map"); provenance := map[path]
        if path.is_empty() -> source_union(provenance) else "{path.join(\".\")}: {source_union(provenance)}"
    } else {
        keys.iter().map((path) -> "{path.join(\".\")}: {source_union(map[path])}").collect().join(", ")
    }
    if map.len() == 1 && keys.first().is_some_and((path) -> path.is_empty()) -> " from {body}" else " from ({body})"
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1664
fn task_flow_facts(src: String) -> [String] {
    facts: [String] := []
    // D-CONC-SPAWN1=D: task.group / task / task.all|race|any.
    for (needle, kind) in [("task.group", "structured_task_scope"), ("task ", "task_spawn"),
        ("task.all", "task_all"), ("task.race", "task_race"), ("task.any", "task_any"), (".join(", "join_task"),
        ("channel", "channel_create"), (".send(", "channel_send"), (".receive(", "channel_receive"), ("#Context", "deadline_context")] {
        for span in text_matches(src, needle) ->
            facts.push("{{\"kind\":{json_str(kind)},\"source\":{json_str(needle)},\"source_span\":{span_json(span)},\"rail\":\"async\",\"semantics\":\"core.tasks_source_truth\"}}")
    }
    facts
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1695
fn project_func(index: &SemIndex, module_display: String, module_src: String, f: &AST.Func) -> GraphBuilder {
    id := graph_id(module_display, f)
    g := GraphBuilder { graph_id: id.clone() }
    entry_id := "{id}:entry"; entry_descriptor := node_catalog.descriptor_for_id("entry")
    g.nodes.push(NodeRec { id: entry_id.clone(), kind: entry_descriptor.kind.to_string(), archetype: entry_descriptor.archetype.to_string(),
        title: f.name.clone(), span: f.name_span.into(), x: 40, y: 40,
        badges: effect_badges(index, f.name).into_iter().map((s) -> s.to_string()).collect(),
        affordances: ["source_jump", "insert_call", "rename_function", "edit_function_signature", "create_function"],
        meta_json: meta_attr_json(f.meta.as_ref()) })
    for (i, p) in f.params.iter().enumerate() {
        pin_id := "{entry_id}:out:{p.name}"; ty := p.ty.name()
        _ :: g.local_pins.insert(p.name.clone(), pin_id.clone()); _ :: g.local_types.insert(p.name.clone(), ty.clone())
        g.pins.push(PinRec { id: pin_id, node_id: entry_id.clone(), name: p.name.clone(), direction: "output", ty: ty, role: .None,
            pattern_source: .None, ability: p.convention.sigil().to_string(), fallible: false, effect_grant_need: .None,
            span: p.name_span.into(), pattern_source_span: .None, append_op: .None, element_index: .None })
        _ :: i
    }
    for def in index.definitions() {
        if def.kind == {
            .Local { ty, .. } -> { if ty == .Val(t) -> _ :: g.local_types.insert(def.name.clone(), t.clone()) },
            .Param { ty } -> _ :: g.local_types.insert(def.name.clone(), ty.clone()), _ -> {}
        }
    }
    project_stmt_block(&g, index, module_src, f.body, 0, 220, 170)
    add_source_comment_regions(&g, module_src, f); add_execution_overlay(&g, module_src, f.body)
    g
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:1771
fn collect_node_refs(graph: &GraphBuilder, out: &[NodeQueryRef]) -> {
    for node in graph.nodes ->
        out.push(NodeQueryRef { graph_id: graph.graph_id.clone(), node_id: node.id.clone(), kind: node.kind.clone(), title: node.title.clone(), span: node.span })
    for inline in graph.inline_exprs ->
        out.push(NodeQueryRef { graph_id: graph.graph_id.clone(), node_id: inline.node_id.clone(), kind: "inline:{inline.role}", title: inline.source.clone(), span: inline.span })
}

