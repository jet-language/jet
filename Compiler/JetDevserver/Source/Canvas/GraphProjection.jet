// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:145
fn canvas_reasoning_family(record: jet_foundation.Facts.DerivationRecord) -> String {
    text := "{record.subject} {record.claim} {record.rule} {record.producer}".to_ascii_lowercase()
    families := [(String, [String])]{[
        (_0: "value", _1: ["value", "observed"]), (_0: "ownership", _1: ["owner", "ownership", "lifetime", "borrow"]),
        (_0: "state", _1: ["state", "transition"]), (_0: "effects", _1: ["effect", "event", "callback", "task"]),
        (_0: "dependencies", _1: ["depend", "premise", "input"]), (_0: "impact", _1: ["impact", "changed", "change"]),
        (_0: "optimization", _1: ["optim", "copy", "cost", "vector"]), (_0: "counterexamples", _1: ["counterexample", "witness"])
    ]}
    families.iter().find_map((family) -> if family._1.iter().any((needle) -> text.contains(needle)) -> .Val(family._0) else -> .None).unwrap_or("relationships")
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:172
fn canvas_reasoning_json(path: OSPath, index: SemIndex) -> String {
    source_path := path.to_string_lossy().replace('\\', "/")
    records := [String]{}; lens_rows := [String:[String]]{}
    loop record in index.derivations() {
        source_span := index.definition_facts().iter().find((fact) -> fact.stable_id == record.subject).map((fact) -> span_json(fact.span)).unwrap_or_else(() -> "null".to_string())
        records.push("{{\"derivation\":{record.to_json()},\"source_span\":{source_span}}}")
        lens_rows.entry(canvas_reasoning_family(record)).or_default().push(json_str(record.id))
    }
    lenses := ["value", "ownership", "state", "effects", "dependencies", "impact", "optimization", "counterexamples", "relationships"].iter().map((name) -> {
        rows := lens_rows.get(name).map((rows) -> rows.join(",")).unwrap_or_default()
        "{{\"name\":{json_str(name)},\"records\":[{rows}]}}"
    }).collect().join(",")
    "{{\"kind\":\"jet.reasoning/v1\",\"source\":{json_str(source_path)},\"selection\":\"all\",\"records\":[{records.join(",")}],\"lenses\":[{lenses}],\"limits\":{{\"records\":{index.derivations().len()},\"records_truncated\":false,\"expanded\":true}}}}"
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:224
fn project_checked(path: OSPath, source_id: String, src: String, bundle: AST.ProgramBundle, facts: SemIndexEffectFacts, package_facts: jet_driver.Package.PackageFacts?, workspace_overlay_policy: jet_env_model.Overlay.OverlayPolicy?, runtime_events: String?) -> Projection {
    index := jet_semindex.from_checked(bundle, facts)
    if package_facts == .Val(package) -> index.attach_package_facts(package)
    if workspace_overlay_policy == .Val(policy) -> index.attach_workspace_overlay_policy(policy)
    graph_json := [String]{}; inline_spans := [InlineExpr]{}; anchors := [GraphEditAnchor]{}; node_refs := [NodeQueryRef]{}
    callable_exports := canvas_callable_exports(bundle, facts)
    loop (module_idx, module_ref) in bundle.modules.iter().enumerate() ->
        collect_item_graphs(path, src, index, facts.name_ledger, module_idx, bundle.entry, module_ref.display, module_ref.source, module_ref.items, .None, &graph_json, &inline_spans, &anchors, &node_refs)
    game_facts := canvas_game_facts(source_id, src, bundle)
    fmt := jet_driver.Formatter.format_source(src).unwrap_or_else((_) -> src.to_string())
    blueprint := canvas_blueprint_facts_json(path, src, bundle, index, runtime_events, game_facts)
    enum_catalog := enum_catalog_json(bundle); pattern_catalog := pattern_catalog_json(bundle)
    effect_projection := jet_semindex.render_effect_projection_object(index.effect_projection())
    reasoning := canvas_reasoning_json(path, index)
    json := "{{\"protocol\":\"jet.canvas.graph\",\"schema_version\":{GRAPH_SCHEMA_VERSION},\"source_id\":{json_str(source_id)},\"revision\":{json_str(source_revision(src))},\"fmt_fingerprint\":{json_str(source_revision(fmt))},\"source_text\":{json_str(src)},\"node_descriptors\":{node_catalog.catalog_json()},\"graphs\":[{graph_json.join(",")}],\"diagnostics\":[],\"facts\":{{\"semindex_schema_version\":{index.schema_version()},\"handles\":[\"definitions\",\"references\",\"calls\",\"effects\",\"members\",\"outputs\",\"state_graphs\",\"assets\",\"components\"],\"effect_projection\":{effect_projection},\"enum_variants\":{enum_catalog},\"pattern_variants\":{pattern_catalog},\"blueprint\":{blueprint},\"reasoning\":{reasoning}}}}}"
    Projection { json: json, inline_exprs: inline_spans, graph_anchors: anchors, node_refs: node_refs, callable_exports: callable_exports, game_facts: game_facts }
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:306
fn canvas_callable_exports(bundle: AST.ProgramBundle, facts: SemIndexEffectFacts) -> [CanvasCallableExport] {
    facts.name_ledger.declarations().filter((declaration) -> declaration.kind == "function")
        .filter((declaration) -> bundle.modules.get(declaration.module_ref).is_some_and((module_ref) -> !is_foreign_module(module_ref.display)))
        .filter((declaration) -> facts.name_ledger.visible(bundle.entry, declaration.module_ref, declaration.name))
        .filter_map((declaration) -> bundle.modules.get(declaration.module_ref).map((module_ref) ->
            CanvasCallableExport { module_path: module_ref.display.clone(), span: declaration.span.into(), callee: canvas_callable_callee(bundle, declaration) })).collect()
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:338
fn is_foreign_module(display: String) -> Bool {
    display.split_once('.').and_then((parts) -> AST.ForeignLanguage.from_root(parts._0)).is_some()
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:345
fn canvas_callable_callee(bundle: AST.ProgramBundle, declaration: jet_foundation.Names.NameDeclaration) -> String {
    module_alias := bundle.modules.get(declaration.module_ref).map((module_ref) -> module_ref.alias.as_str()).unwrap_or("")
    source_path := source_item_path(bundle.name_ledger, declaration.module_ref, module_alias, declaration.name, declaration.span, [])
    leaf := source_path.rsplit_once('.').map_or(source_path.as_str(), (parts) -> parts._1)
    if declaration.module_ref == bundle.entry -> return source_path
    if bundle.name_ledger.aliases().find((alias) ->
        alias.module_ref == bundle.entry && alias.target_module == .Val(declaration.module_ref) &&
        alias.target.rsplit_once('.').map_or(alias.target.as_str(), (parts) -> parts.1) == leaf) == .Val(alias) -> return alias.name.clone()
    module_alias = if module_alias.is_empty() -> leaf else -> module_alias
    prefix := bundle.name_ledger.aliases().find((alias) -> alias.module_ref == bundle.entry && alias.target_module == .Val(declaration.module_ref) && alias.target == module_alias)
        .map((alias) -> alias.name.as_str()).unwrap_or(module_alias)
    "{prefix}.{source_path}"
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:399
fn enum_catalog_json(bundle: AST.ProgramBundle) -> String {
    catalog := [String:[String]]{}
    loop module_ref in bundle.modules -> collect_enum_variants(module_ref.items, &catalog)
    keys := catalog.keys().collect(); keys.sort()
    entries := keys.iter().map((name) -> {
        variants := catalog[name].iter().map((variant) -> "{{\"name\":{json_str(variant)},\"source\":{json_str("{name}.{variant}")}}}").collect().join(",")
        "{json_str(name)}:[{variants}]"
    }).collect().join(",")
    "{{{entries}}}"
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:425
fn collect_enum_variants(items: &[Item], catalog: &[String:[String]]) {
    loop item in items {
        if item == {
            .Enum(def) -> {
                variants := def.variants.iter().filter((variant) -> if variant.payload == {
                    .Unit -> true
                    else -> false
                }).map((variant) -> variant.name.clone()).collect()
                _ :: catalog.entry(def.name.clone()).or_insert(variants)
            }
            .CodeModule(module_ref) -> { if module_ref.body == .Val(body) -> collect_enum_variants(body, catalog) } else -> {}
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:447
fn pattern_catalog_json(bundle: AST.ProgramBundle) -> String {
    catalog := [String:[(String, USize)]]{}
    loop module_ref in bundle.modules -> collect_pattern_variants(module_ref.items, &catalog)
    keys := catalog.keys().collect(); keys.sort()
    entries := keys.iter().map((name) -> {
        variants := catalog[name].iter().map((variant) -> "{{\"name\":{json_str(variant._0)},\"arity\":{variant._1}}}").collect().join(",")
        "{json_str(name)}:[{variants}]"
    }).collect().join(",")
    "{{{entries}}}"
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:469
fn collect_pattern_variants(items: &[Item], catalog: &[String:[(String, USize)]]) {
    loop item in items {
        if item == {
            .Enum(def) -> {
                variants := def.variants.iter().map((variant) -> {
                    arity := if variant.payload == {
                        .Unit -> 0
                        .Single(_, _) -> 1
                        .Named(fields) -> fields.len()
                    }
                    (_0: variant.name.clone(), _1: arity)
                }).collect()
                _ :: catalog.entry(def.name.clone()).or_insert(variants)
            }
            .CodeModule(module_ref) -> { if module_ref.body == .Val(body) -> collect_pattern_variants(body, catalog) } else -> {}
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:497
fn collect_item_graphs(entry_path: &OSPath, entry_src: String, index: &SemIndex, ledger: &jet_foundation.Names.NameLedger, module_idx: USize, entry_module_idx: USize, module_display: String, module_src: String, items: &[Item], owner: String?, out: &[String], inline_spans: &[InlineExpr], anchors: &[GraphEditAnchor], node_refs: &[NodeQueryRef]) {
    loop item in items {
        if item == {
            .Func(f) -> {
                graph := project_func(index, module_display, module_src, f)
                ledger_name := owner.map((owner) -> jet_foundation.Names.member_name(owner, f.name)).unwrap_or_else(() -> f.name.clone())
                visibility := ledger_function_visibility(ledger, module_idx, ledger_name)
                inline_spans.extend(graph.inline_exprs.iter().map((i) -> InlineExpr { id: i.id.clone(), span: i.span }))
                if module_idx == entry_module_idx -> anchors.push(GraphEditAnchor { graph_id: graph.graph_id.clone(), insert_offset: insert_offset(entry_src, f), fallible: function_is_fallible(f) })
                collect_node_refs(graph, node_refs); out.push(graph_to_json(graph, f, module_src, visibility))
            }
            .Struct(s) -> {
                loop method in s.methods {
                    graph := project_func(index, module_display, module_src, method)
                    visibility := ledger_function_visibility(ledger, module_idx, "{s.name}.{method.name}")
                    inline_spans.extend(graph.inline_exprs.iter().map((i) -> InlineExpr { id: i.id.clone(), span: i.span }))
                    if module_idx == entry_module_idx -> anchors.push(GraphEditAnchor { graph_id: graph.graph_id.clone(), insert_offset: insert_offset(entry_src, method), fallible: function_is_fallible(method) })
                    collect_node_refs(graph, node_refs); out.push(graph_to_json(graph, method, module_src, visibility))
                }
            }
            .Impl(i) -> {
                loop method in i.methods {
                    graph := project_func(index, module_display, module_src, method)
                    visibility := ledger_function_visibility(ledger, module_idx, "{i.type_name}.{method.name}")
                    inline_spans.extend(graph.inline_exprs.iter().map((e) -> InlineExpr { id: e.id.clone(), span: e.span }))
                    if module_idx == entry_module_idx -> anchors.push(GraphEditAnchor { graph_id: graph.graph_id.clone(), insert_offset: insert_offset(entry_src, method), fallible: function_is_fallible(method) })
                    collect_node_refs(graph, node_refs); out.push(graph_to_json(graph, method, module_src, visibility))
                }
            }
            .CodeModule(m) -> { if m.body == .Val(body) -> collect_item_graphs(entry_path, entry_src, index, ledger, module_idx, entry_module_idx, module_display, module_src, body, .Val(m.name), out, inline_spans, anchors, node_refs) } else -> {}
        }
    }
    _ :: entry_path
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:608
fn function_is_fallible(f: AST.Func) -> Bool { if f.return_type.as_ref() == {
    .Val(.Result { .. }) -> true
    else -> false
} }
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:612
fn canvas_blueprint_facts_json(path: OSPath, src: String, bundle: AST.ProgramBundle, index: SemIndex, runtime_events: String?, game_facts: [CanvasGameFact]) -> String {
    interfaces := [String]{}
    loop (module_idx, module_ref) in bundle.modules.iter().enumerate() {
        items := module_ref.items.iter().collect()
        collect_interface_facts(items, &interfaces, [], module_ref.source, module_idx, module_ref.alias, bundle.name_ledger)
    }
    task_flows := task_flow_facts(src).join(",")
    outputs := index.outputs().iter().map(output_fact_json).collect().join(",")
    package_facts := index.package_facts().map(jet_semindex.package_facts_json).unwrap_or_else(() -> "null".to_string())
    workspace_overlays := index.workspace_overlay_policy().map(jet_semindex.workspace_overlay_policy_json).unwrap_or_else(() -> "null".to_string())
    event_dispatchers := event_dispatcher_facts(path, src, bundle, index).join(",")
    state_graphs := index.state_graphs().iter().map(state_graph_json).collect().join(",")
    assets := game_facts.iter().filter((fact) -> fact.kind == "asset").map(canvas_game_fact_json).collect().join(",")
    components := game_facts.iter().filter((fact) -> fact.kind == "component").map(canvas_game_fact_json).collect().join(",")
    "{{\"runtime_events\":{runtime_events.unwrap_or("null")},\"event_dispatchers\":[{event_dispatchers}],\"interfaces\":[{interfaces.join(",")}],\"task_flows\":[{task_flows}],\"outputs\":[{outputs}],\"state_graphs\":[{state_graphs}],\"assets\":[{assets}],\"components\":[{components}],\"package_facts\":{package_facts},\"workspace_overlays\":{workspace_overlays},\"source_truth\":\"ordinary_jet_source\"}}"
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:682
fn canvas_game_fact_json(fact: CanvasGameFact) -> String {
    field_span := fact.field_span.map(span_json).unwrap_or_else(() -> "null".to_string())
    fields := "{{{json_str(fact.field)}:{{\"source_span\":{field_span},\"source\":{json_str(fact.value_source)}}}}}"
    "{{\"kind\":{json_str(fact.kind)},\"operation\":{json_str(fact.operation)},\"source_id\":{json_str(fact.source_id)},\"source_span\":{span_json(fact.source_span)},\"authored_instance_id\":{json_str(fact.authored_instance_id)},\"field\":{json_str(fact.field)},\"value\":{json_str(fact.value_source)},\"fields\":{fields},\"source_truth\":\"ordinary_jet_source\",\"fact_source\":\"checked_game_call\"}}"
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:705
fn canvas_game_facts(source_id: String, src: String, bundle: &AST.ProgramBundle) -> [CanvasGameFact] {
    facts := [CanvasGameFact]{}
    module_ref := bundle.modules.get(bundle.entry) ?? return facts
    collect_game_items(module_ref.items, source_id, src, &facts)
    facts.sort_by_key((fact) -> (_0: fact.source_span.start, _1: fact.source_span.end)); facts
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:719
fn collect_game_items(items: &[Item], source_id: String, src: String, out: &[CanvasGameFact]) {
    loop item in items {
        if item == {
            .Func(function) -> collect_game_statements(function.body, source_id, src, out)
            .Struct(structure) -> { loop method in structure.methods -> collect_game_statements(method.body, source_id, src, out) }
            .Impl(implementation) -> { loop method in implementation.methods -> collect_game_statements(method.body, source_id, src, out) }
            .CodeModule(module_ref) -> { if module_ref.body == .Val(body) -> collect_game_items(body, source_id, src, out) } else -> {}
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:748
fn collect_game_statements(statements: &[Stmt], source_id: String, src: String, out: &[CanvasGameFact]) {
    loop statement in statements {
        statement.for_each_expr((expr) -> {
            (receiver, method, method_span, owner_type_args, type_args, args) := if expr == {
                .MethodCall { receiver, method, method_span, owner_type_args, type_args, args, .. } -> (_0: receiver, _1: method, _2: method_span, _3: owner_type_args, _4: type_args, _5: args)
                else -> { return }
            }
            source_span := game_method_call_span(src, receiver, method_span)
            (operation, field, value_source, field_span) := if {
                (method == "image" || method == "sound") && game_assets_receiver(receiver) -> {
                    argument := args.first() ?? return
                    span := SourceSpan{argument.expr.span().into()}
                    (_0: "scene.assets.{method}", _1: "path", _2: source_span_text(src, span), _3: .Val(span))
                }
                method == "component" -> {
                    type_arg := type_args.first().or_else(() -> owner_type_args.first())
                    (field, value_source, field_span) := if {
                        type_arg == .Val(type_arg) -> {
                            value := type_arg.name(); span := game_type_name_span(src, source_span, method_span, value)
                            (_0: "component", _1: value, _2: span)
                        }
                        args.first() == .Val(argument) -> {
                            span := SourceSpan{argument.expr.span().into()}
                            (_0: "component", _1: source_span_text(src, span), _2: .Val(span))
                        }
                        else -> { return }
                    }
                    (_0: "scene.component", _1: field, _2: value_source, _3: field_span)
                }
                else -> { return }
            }
            authored_instance_id := "{source_id}:game:{operation}:{source_span.start}-{source_span.end}"
            out.push(CanvasGameFact { source_id: source_id.to_string(), kind: if operation == "scene.component" -> "component" else -> "asset",
                operation: operation, field: field, value_source: value_source, source_span: source_span, field_span: field_span, authored_instance_id: authored_instance_id })
        })
    }
}

// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:825
fn game_assets_receiver(expr: Expr) -> Bool {
    if expr == {
        .Field(_, name, _, _) -> name == "assets"
        .Paren(inner, _, _) -> game_assets_receiver(inner)
        else -> false
    }
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:832
fn game_receiver_start(expr: Expr) -> USize {
    if expr == {
        .Field(base, ..) | .Paren(base, .., _) -> game_receiver_start(base)
        else -> expr.span().start
    }
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:839
fn game_method_call_span(src: String, receiver: &Expr, method_span: Span) -> SourceSpan {
    fallback := SourceSpan{method_span.into()}
    start := game_receiver_start(receiver)
    open_relative := src.get(method_span.end..).and_then((tail) -> tail.find('(')) ?? return fallback
    open := method_span.end + open_relative
    close := matching_call_close(src, open) ?? return fallback
    SourceSpan { start: start, end: close }
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:862
fn matching_call_close(src: String, open: USize) -> USize? {
    bytes := src.as_bytes(); depth := USize{1}; in_string := false; escaped := false
    loop index in open + 1..bytes.len() {
        byte := bytes[index]
        if in_string {
            if escaped { escaped = false } else if byte == ((U8{'\\'})) { escaped = true } else if byte == (((U8{'"'}))) { in_string = false }
            next
        }
        if byte == {
            U8{'"'} -> in_string = true, U8{'('} -> depth += 1
            U8{')'} -> { depth = depth.saturating_sub(1); if depth == 0 -> return .Val(index + 1) } else -> {}
        }
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:895
fn game_type_name_span(src: String, enclosing: SourceSpan, method_span: Span, type_name: String) -> SourceSpan? {
    start := method_span.end.min(enclosing.end); end := enclosing.end.min(src.len())
    if start >= end -> return .None
    relative := src.get(start..end)?.find(type_name)
    token_start := start + relative
    .Val(SourceSpan { start: token_start, end: token_start + type_name.len() })
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:914
fn source_span_text(src: String, span: SourceSpan) -> String {
    text := src.get(span.start..span.end).unwrap_or("").trim() // #4303
    text.to_string()
}
// Rust: crates/jet-devserver/src/Canvas/graph_projection.rs:922
fn state_graph_json(graph: StateGraphFact) -> String {
    states := graph.states.iter().map((state) -> {
        reachable := state.reachable.map_or_else(() -> "null".to_string(), (value) -> value.to_string())
        "{{\"name\":{json_str(state.name)},\"terminal\":{state.terminal},\"reachable\":{reachable},\"span\":{span_json(state.span)}}}"
    }).collect().join(",")
    transitions := graph.transitions.iter().map((transition) -> {
        from := transition.from.as_ref().map_or_else(() -> "null".to_string(), (value) -> json_str(value))
        "{{\"operation\":{json_str(transition.operation)},\"from\":{from},\"to\":{json_str(transition.to)}}}"
    }).collect().join(",")
    "{{\"owner\":{json_str(graph.owner)},\"module\":{json_str(graph.module_path)},\"states\":[{states}],\"transitions\":[{transitions}]}}"
}
