fn event_dispatcher_facts(path: OSPath, source: String, bundle: AST.ProgramBundle, index: SemIndex) -> [String] {
    path_text := path.to_string_lossy()
    module_ref := bundle.modules.iter().find((module_ref) -> module_ref.display == path_text.as_ref()).or_else(() -> bundle.modules.iter().find((module_ref) -> module_ref.source == source)) ?? return []
    src := module_ref.source.as_str()
    index.call_edges().iter().filter((call) -> call.module_path == module_ref.display).filter_map((call) -> {
        aliases := event_module_aliases(src)
        call_source_span := event_call_span(src, call.call_span).unwrap_or(call.call_span)
        call_source := src.get(call_source_span.start..call_source_span.end).unwrap_or(call.callee)
        function Object() { [native code] } := event_constructor_kind(src, call.call_span, call.callee.as_str(), call_source, aliases)
        receiver := event_receiver(src, index, call.call_span, module_ref.display)
        kind := function Object() { [native code] }.or_else(() -> {
            receiver_type := receiver.as_ref().map((receiver) -> receiver.1.as_str())?
            event_method_kind(receiver_type, call.callee.as_str())
        })?
        scope := event_scope_argument(index, call_source_span, module_ref.display)
        receiver_type := constructor_type(call.callee.as_str(), call_source).or_else(() -> receiver.as_ref().map((receiver) -> receiver._1.clone()))
        receiver_name := receiver.as_ref().map((receiver) -> receiver._0.as_str()).map(json_str).unwrap_or_else(() -> "null".to_string())
        receiver_span := receiver.as_ref().map((receiver) -> span_json(receiver._2)).unwrap_or_else(() -> "null".to_string())
        scope_name := scope.as_ref().map((scope) -> scope._0.as_str()).map(json_str).unwrap_or_else(() -> "null".to_string())
        scope_span := scope.as_ref().map((scope) -> span_json(scope._1)).unwrap_or_else(() -> "null".to_string())
        receiver_json := receiver_type.as_deref().map(json_str).unwrap_or_else(() -> "null".to_string())
        .Val("{{\"kind\":{json_str(kind)},\"source\":{json_str(call_source)},\"source_span\":{span_json(call_source_span)},\"receiver\":{receiver_name},\"receiver_source_span\":{receiver_span},\"receiver_type\":{receiver_json},\"scope\":{scope_name},\"scope_source_span\":{scope_span},\"fact_source\":\"semindex_checked_call\",\"lifetime\":\"EventScope-owned\",\"observables\":[\"listener_count\",\"blocked_count\",\"queued_count\",\"running_count\",\"DispatchReport.trace\"],\"semantics\":\"core.event_source_truth\"}}")
    }).collect()
}
