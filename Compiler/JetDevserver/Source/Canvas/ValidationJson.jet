// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:7
pub fn validate_ident(name: String) -> Unit Err! {
    chars := name.chars()
    first :: chars.next() ?? return .Err(edit_error("bad_request", "empty identifier"))
    if (!first.is_ascii_alphabetic() && first != '_') || !chars.all((c) -> c.is_ascii_alphanumeric() || c == '_') -> return .Err(edit_error("bad_request", "identifier is not a Jet name"))
    .Ok(())
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:20
pub fn validate_query_ident(name: String) -> Unit Err! {
    chars := name.chars()
    first :: chars.next() ?? return .Err(query_error("bad_request", "empty identifier"))
    if (!first.is_ascii_alphabetic() && first != '_') || !chars.all((c) -> c.is_ascii_alphanumeric() || c == '_') -> return .Err(query_error("bad_request", "identifier is not a Jet name"))
    .Ok(())
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:33
pub fn validate_ident_for_project(name: String) -> Unit Err! {
    chars := name.chars()
    first :: chars.next() ?? return .Err(project_edit_error("bad_request", "empty identifier"))
    if (!first.is_ascii_alphabetic() && first != '_') || !chars.all((c) -> c.is_ascii_alphanumeric() || c == '_') -> return .Err(project_edit_error("bad_request", "identifier is not a Jet package name"))
    .Ok(())
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:49
pub fn validate_qualified_name(name: String) -> Unit Err! {
    for part in name.split('.') { validate_ident(part)? }
    .Ok(())
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:56
pub fn validate_signature_fragment(fragment: String) -> Unit Err! {
    if fragment.contains('{') || fragment.contains('}') || fragment.contains('\n') -> return .Err(edit_error("bad_request", "function parameter text must stay inside the signature"))
    .Ok(())
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:66
pub fn validate_type_fragment(fragment: String) -> Unit Err! {
    if fragment.trim().is_empty() || fragment.contains('{') || fragment.contains('}') || fragment.contains('\n') -> return .Err(edit_error("bad_request", "return type is not a Jet type"))
    .Ok(())
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:77
pub fn validate_function_signature(signature: String) -> Unit Err! {
    if signature.contains('{') || signature.contains('}') || signature.contains('\n') -> return .Err(edit_error("bad_request", "function signature must not include a body"))
    if !signature.split_whitespace().any((part) -> part == "fn") -> return .Err(edit_error("bad_request", "function signature must include fn"))
    .Ok(())
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:93
pub fn validate_single_line_fragment(fragment: String, label: String) -> Unit Err! {
    if fragment.trim().is_empty() || fragment.contains('\n') || fragment.contains('\r') -> return .Err(edit_error("bad_request", label))
    .Ok(())
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:100
pub fn validate_comment_color(color: String) -> Unit Err! {
    ok :: color.len() == 7 && color.starts_with('#') && color[1..].chars().all((c) -> c.is_ascii_hexdigit())
    if ok { .Ok(()) } else { .Err(edit_error("bad_request", "Canvas comment color must be #RRGGBB")) }
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:114
pub fn validate_comment_alpha(alpha: String) -> Unit Err! {
    value :: alpha.parse<F32>().map_err((_) -> edit_error("bad_request", "Canvas comment alpha must be a number"))?
    if value >= 0.0 && value <= 1.0 { .Ok(()) } else { .Err(edit_error("bad_request", "Canvas comment alpha must be between 0 and 1")) }
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:131
pub fn normalize_bounds(bounds: String) -> String Err! {
    nums :: bounds.trim().trim_start_matches('(').trim_end_matches(')').split(',').map((part) -> part.trim().parse<I32>()).collect<Result<[I32], _>>().map_err((_) -> edit_error("bad_request", "Canvas comment bounds must be x,y,w,h"))?
    if nums.len() != 4 || nums[2] <= 0 || nums[3] <= 0 -> return .Err(edit_error("bad_request", "Canvas comment bounds must be x,y,w,h with positive size"))
    .Ok(format("{},{},{},{}", nums[0], nums[1], nums[2], nums[3]))
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:149
pub fn quoted_attr(value: String) -> String { json_str(value) }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:153
pub fn find_comment_hint(src: String, graph_json: String, region_id: String) -> CommentHint? {
    for chunk in graph_json.split("\"region_id\":").skip(1) {
        (id, _) :: parse_json_string(chunk.trim_start())?
        if id != region_id -> continue
        start :: json_usize_field(chunk, "start")?
        end :: json_usize_field(chunk, "end")?
        return canvas_comment_hints(src).into_iter().find((hint) -> hint.anchor.start == start && hint.anchor.end == end)
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:172
pub fn find_hint_region(src: String, graph_json: String, region_id: String, kind: String) -> CommentHint? {
    for chunk in graph_json.split("\"region_id\":").skip(1) {
        (id, _) :: parse_json_string(chunk.trim_start())?
        if id != region_id -> continue
        if json_string_field(chunk, "kind") != .Some(kind) -> continue
        start :: json_usize_field(chunk, "start")?
        end :: json_usize_field(chunk, "end")?
        hints :: if kind is { "comment" -> canvas_comment_hints(src); "collapse" -> canvas_collapse_hints(src); _ -> return .None }
        return hints.into_iter().find((hint) -> hint.anchor.start == start && hint.anchor.end == end)
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:200
pub fn extract_params(graph_json: String, expr: String) -> [(String, String)] {
    out: [(String, String)] := []
    for ident in identifiers(expr) {
        if ty :: graph_type_for_name(graph_json, ident) {
            if !out.iter().any(((name, _)) -> name == ident) -> out.push((ident, ty))
        }
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:212
fn graph_type_for_name(graph_json: String, name: String) -> String? {
    for chunk in graph_json.split("\"name\":").skip(1) {
        (found, _) :: parse_json_string(chunk.trim_start())?
        if found != name || !chunk.contains("\"direction\":\"output\"") -> continue
        pos :: chunk.find("\"type\"")?
        rest := chunk[pos + "\"type\"".len()..] // #4303
        colon :: rest.find(':')?
        return parse_json_string(rest[colon + 1..].trim_start()).map(((s, _)) -> s)
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:226
fn identifiers(expr: String) -> [String] {
    out: [String] := []
    current := ""
    for c in expr.chars().chain(once(' ')) {
        if c.is_ascii_alphanumeric() || c == '_' { current.push(c) }
        else if !current.is_empty() {
            if current.chars().next().map((c) -> c.is_ascii_alphabetic() || c == '_').unwrap_or(false) && !(current is "true" | "false" | "ok" | "err") -> out.push(current.to_string())
            current.clear()
        }
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:248
pub fn parse_simple_call(call: String) -> (String, [String])? {
    open :: call.find('(')?
    close :: call.rfind(')')?
    name := call[..open].trim() // #4303
    validate_ident(name).ok()?
    args :: if call[open + 1..close].trim().is_empty() { [] } else { call[open + 1..close].split(',').map((arg) -> { arg := arg.trim(); arg.to_string() }).collect() }
    .Some((name.to_string(), args))
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:264
pub fn find_simple_helper(src: String, name: String) -> ([String], String)? {
    needle :: format("fn {}(", name)
    start :: src.find(needle)?
    params_start :: start + needle.len()
    params_end :: src[params_start..].find(')')? + params_start
    params :: src[params_start..params_end].split(',').filter_map((param) -> param.trim().split_once(':').map(((name, _)) -> { name := name.trim(); name.to_string() })).collect()
    body_start :: src[params_end..].find('{')? + params_end + 1
    body_end :: src[body_start..].find('}')? + body_start
    body := src[body_start..body_end].trim() // #4303
    returned := body.strip_prefix("return ")?.trim() // #4303
    .Some((params, returned.to_string()))
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:285
pub fn replace_ident(expr: String, ident: String, replacement: String) -> String {
    out := ""
    current := ""
    for c in expr.chars().chain(once(' ')) {
        if c.is_ascii_alphanumeric() || c == '_' { current.push(c) }
        else {
            if !current.is_empty() {
                if current == ident { out.push_str(replacement) } else { out.push_str(current) }
                current.clear()
            }
            out.push(c)
        }
    }
    trimmed := out.trim_end() // #4303
    trimmed.to_string()
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:306
pub fn attr_string(text: String, key: String) -> String? {
    needle :: format("{}=", key)
    pos :: text.find(needle)?
    rest := text[pos + needle.len()..].trim_start() // #4303
    if rest.starts_with('"') -> return parse_json_string(rest).map(((s, _)) -> s)
    .Some(rest.chars().take_while((c) -> !c.is_whitespace()).collect())
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:320
pub fn attr_span(text: String, key: String) -> SourceSpan? {
    raw :: attr_string(text, key)?
    (start, end) :: raw.split_once("..")?
    .Some(SourceSpan(start: start.parse().ok()?, end: end.parse().ok()?))
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:329
pub fn attr_bounds(text: String, key: String) -> (I32, I32, I32, I32)? {
    needle :: format("{}=", key)
    pos :: text.find(needle)?
    rest := text[pos + needle.len()..].trim_start().strip_prefix('(')? // #4303
    close :: rest.find(')')?
    nums :: rest[..close].split(',').map((part) -> part.trim().parse<I32>()).collect<Result<[I32], _>>().ok()?
    if nums.len() == 4 { .Some((nums[0], nums[1], nums[2], nums[3])) } else { .None }
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:347
pub fn required_string(text: String, key: String) -> String Err! { json_string_field(text, key).ok_or_else(() -> edit_error("bad_request", format("missing `{}`", key))) }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:352
pub fn required_query_string(text: String, key: String) -> String Err! { json_string_field(text, key).ok_or_else(() -> query_error("bad_request", format("missing `{}`", key))) }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:357
pub fn required_project_string(text: String, key: String) -> String Err! { json_string_field(text, key).ok_or_else(() -> project_edit_error("bad_request", format("missing `{}`", key))) }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:362
pub fn json_string_field(text: String, key: String) -> String? {
    needle :: format("\"{}\"", key)
    pos :: text.find(needle)?
    rest := text[pos + needle.len()..] // #4303
    colon :: rest.find(':')?
    parse_json_string(rest[colon + 1..].trim_start()).map(((s, _)) -> s)
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:371
pub fn json_bool_field(text: String, key: String) -> Bool? {
    needle :: format("\"{}\"", key)
    pos :: text.find(needle)?
    rest := text[pos + needle.len()..] // #4303
    colon :: rest.find(':')?
    rest = rest[colon + 1..].trim_start()
    if rest.starts_with("true") { .Some(true) } else if rest.starts_with("false") { .Some(false) } else { .None }
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:386
pub fn json_usize_field(text: String, key: String) -> Usize? {
    needle :: format("\"{}\"", key)
    pos :: text.find(needle)?
    rest := text[pos + needle.len()..] // #4303
    colon :: rest.find(':')?
    rest[colon + 1..].trim_start().chars().take_while((c) -> c.is_ascii_digit()).collect<String>().parse().ok()
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:400
pub fn json_usize_array(text: String, key: String) -> [Usize] {
    needle :: format("\"{}\"", key)
    pos :: text.find(needle) ?? return []
    rest := text[pos + needle.len()..] // #4303
    colon :: rest.find(':') ?? return []
    rest = rest[colon + 1..].trim_start()
    rest = rest.strip_prefix('[') ?? return []
    out: [Usize] := []
    loop {
        rest = rest.trim_start()
        if rest.starts_with(']') -> break
        digits :: rest.chars().take_while((c) -> c.is_ascii_digit()).collect<String>()
        if digits.is_empty() -> break
        if digits.parse<Usize>() is .Ok(n) -> out.push(n)
        rest = rest[digits.len()..].trim_start()
        if rest.starts_with(',') -> rest = rest[1..]
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:438
pub fn json_array_body(text: String, key: String) -> String? {
    needle :: format("\"{}\"", key)
    pos :: text.find(needle)?
    rest := text[pos + needle.len()..] // #4303
    colon :: rest.find(':')?
    rest = rest[colon + 1..].trim_start()
    bytes :: rest.as_bytes()
    if bytes.first().copied()? != 91 -> return .None
    depth: I32 := 0
    in_string := false
    escaped := false
    for (i, b) in bytes.iter().copied().enumerate() {
        if in_string {
            if escaped { escaped = false } else if b == 92 { escaped = true } else if b == 34 { in_string = false }
            continue
        }
        if b is {
            34 -> in_string = true
            91 -> depth += 1
            93 -> { depth -= 1; if depth == 0 -> return rest.get(1..i) }
            _ -> {}
        }
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:477
pub fn json_object_bodies(text: String) -> [String] {
    out: [String] := []
    start: Usize? := .None
    depth: I32 := 0
    in_string := false
    escaped := false
    for (i, b) in text.bytes().enumerate() {
        if in_string {
            if escaped { escaped = false } else if b == 92 { escaped = true } else if b == 34 { in_string = false }
            continue
        }
        if b is {
            34 -> in_string = true
            123 -> { if depth == 0 -> start = .Some(i + 1); depth += 1 }
            125 -> {
                depth -= 1
                if depth == 0 {
                    if s :: start.take() {
                        if body :: text.get(s..i) -> out.push(body)
                    }
                }
            }
            _ -> {}
        }
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:519
pub fn wire_span_from_json_chunk(chunk: String, wire_id: String) -> SourceSpan? {
    (id, _) :: parse_json_string(chunk.trim_start())?
    if id != wire_id -> return .None
    pos :: chunk.find("\"source_span\"")?
    rest := chunk[pos + "\"source_span\"".len()..] // #4303
    colon :: rest.find(':')?
    value := rest[colon + 1..].trim_start() // #4303
    if value.starts_with("null") -> return .None
    .Some(SourceSpan(start: json_usize_field(value, "start")?, end: json_usize_field(value, "end")?))
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:537
pub fn json_string_array(text: String, key: String) -> [String] {
    needle :: format("\"{}\"", key)
    pos :: text.find(needle) ?? return []
    rest := text[pos + needle.len()..] // #4303
    colon :: rest.find(':') ?? return []
    rest = rest[colon + 1..].trim_start()
    rest = rest.strip_prefix('[') ?? return []
    out: [String] := []
    loop {
        rest = rest.trim_start()
        if rest.starts_with(']') -> break
        (value, consumed) :: parse_json_string(rest) ?? break
        out.push(value)
        rest = rest[consumed..].trim_start()
        if rest.starts_with(',') -> rest = rest[1..]
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:569
pub fn parse_json_string(text: String) -> (String, Usize)? {
    chars := text.char_indices()
    if chars.next()?.1 != '"' -> return .None
    out := ""
    escaped := false
    for (i, c) in chars {
        if escaped {
            out.push(if c is { 'n' -> '\n'; 'r' -> '\r'; 't' -> '\t'; '"' -> '"'; '\\' -> '\\'; other -> other })
            escaped = false
        } else if c == '\\' { escaped = true }
        else if c == '"' { return .Some((out, i + 1)) }
        else { out.push(c) }
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:598
pub fn span_json(span: SourceSpan) -> String { format("{{\"start\":{},\"end\":{}}}", span.start, span.end) }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:602
pub fn json_strs(values: [String]) -> String { values.iter().map(json_str).collect().join(",") }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:610
pub fn json_optional_str(value: String?) -> String { value.map(json_str).unwrap_or("null") }
