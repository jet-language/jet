fn required_string(text: String, key: String) -> String Err! { json_string_field(text, key).ok_or_else(() -> edit_error("bad_request", "missing `{key}`")) }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:352
fn required_query_string(text: String, key: String) -> String Err! { json_string_field(text, key).ok_or_else(() -> query_error("bad_request", "missing `{key}`")) }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:357
fn required_project_string(text: String, key: String) -> String Err! { json_string_field(text, key).ok_or_else(() -> project_edit_error("bad_request", "missing `{key}`")) }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:362
fn json_string_field(text: String, key: String) -> String? {
    needle :: "\"{key}\""
    pos :: text.find(needle)?
    rest := text[pos + needle.len()..<text.len()] // #4303
    colon :: rest.find(':')?
    parse_json_string(rest[colon + 1..<rest.len()].trim_start()).map(((_0: s, _1: _)) -> s)
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:371
fn json_bool_field(text: String, key: String) -> Bool? {
    needle :: "\"{key}\""
    pos :: text.find(needle)?
    rest := text[pos + needle.len()..<text.len()] // #4303
    colon :: rest.find(':')?
    rest = rest[colon + 1..<rest.len()].trim_start()
    if rest.starts_with("true") { .Some(true) } else if rest.starts_with("false") { .Some(false) } else { .None }
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:386
fn json_usize_field(text: String, key: String) -> Usize? {
    needle :: "\"{key}\""
    pos :: text.find(needle)?
    rest := text[pos + needle.len()..<text.len()] // #4303
    colon :: rest.find(':')?
    rest[colon + 1..<rest.len()].trim_start().chars().take_while((c) -> c.is_ascii_digit()).collect<String>().parse().ok()
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:400
fn json_usize_array(text: String, key: String) -> [Usize] {
    needle :: "\"{key}\""
    pos :: text.find(needle) ?? return []
    rest := text[pos + needle.len()..<text.len()] // #4303
    colon :: rest.find(':') ?? return []
    rest = rest[colon + 1..<rest.len()].trim_start()
    rest = rest.strip_prefix('[') ?? return []
    out := [Usize]{}
    loop {
        rest = rest.trim_start()
        if rest.starts_with(']') -> break
        digits :: rest.chars().take_while((c) -> c.is_ascii_digit()).collect<String>()
        if digits.is_empty() -> break
        if digits.parse<Usize>() is .Ok(n) -> out.push(n)
        rest = rest[digits.len()..<rest.len()].trim_start()
        if rest.starts_with(',') -> rest = rest[1..<rest.len()]
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:438
fn json_array_body(text: String, key: String) -> String? {
    needle :: "\"{key}\""
    pos :: text.find(needle)?
    rest := text[pos + needle.len()..<text.len()] // #4303
    colon :: rest.find(':')?
    rest = rest[colon + 1..<rest.len()].trim_start()
    bytes :: rest.as_bytes()
    if bytes.first().copied()? != 91 -> return .None
    depth := I32{0}
    in_string := false
    escaped := false
    loop (i, b) in bytes.iter().copied().enumerate() {
        if in_string {
            if escaped { escaped = false } else if b == 92 { escaped = true } else if b == 34 { in_string = false }
            next
        }
        if b is {
            34 -> in_string = true
            91 -> depth += 1
            93 -> { depth -= 1; if depth == 0 -> return rest.get(1..i) }
            _ -> {}
        }
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:477
fn json_object_bodies(text: String) -> [String] {
    out := [String]{}
    start := Usize?{.None}
    depth := I32{0}
    in_string := false
    escaped := false
    loop (i, b) in text.bytes().enumerate() {
        if in_string {
            if escaped { escaped = false } else if b == 92 { escaped = true } else if b == 34 { in_string = false }
            next
        }
        if b is {
            34 -> in_string = true
            123 -> { if depth == 0 -> start = .Some(i + 1); depth += 1 }
            125 -> {
                depth -= 1
                if depth == 0 {
                    if s :: start.take() {
                        if body :: text.get(s..i) -> out.push(body)
                    }
                }
            }
            _ -> {}
        }
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:519
fn wire_span_from_json_chunk(chunk: String, wire_id: String) -> SourceSpan? {
    (id, _) :: parse_json_string(chunk.trim_start())?
    if id != wire_id -> return .None
    pos :: chunk.find("\"source_span\"")?
    rest := chunk[pos + "\"source_span\"".len()..<chunk.len()] // #4303
    colon :: rest.find(':')?
    value := rest[colon + 1..<rest.len()].trim_start() // #4303
    if value.starts_with("null") -> return .None
    .Some(SourceSpan(start: json_usize_field(value, "start")?, end: json_usize_field(value, "end")?))
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:537
fn json_string_array(text: String, key: String) -> [String] {
    needle :: "\"{key}\""
    pos :: text.find(needle) ?? return []
    rest := text[pos + needle.len()..<text.len()] // #4303
    colon :: rest.find(':') ?? return []
    rest = rest[colon + 1..<rest.len()].trim_start()
    rest = rest.strip_prefix('[') ?? return []
    out := [String]{}
    loop {
        rest = rest.trim_start()
        if rest.starts_with(']') -> break
        (value, consumed) :: parse_json_string(rest) ?? break
        out.push(value)
        rest = rest[consumed..<rest.len()].trim_start()
        if rest.starts_with(',') -> rest = rest[1..<rest.len()]
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:569
fn parse_json_string(text: String) -> (String, Usize)? {
    chars := text.char_indices()
    if chars.next()?._1 != '"' -> return .None
    out := ""
    escaped := false
    loop (i, c) in chars {
        if escaped {
            out.push(if c is { 'n' -> '\n'; 'r' -> Char{13}; 't' -> '\t'; '"' -> '"'; '\\' -> '\\'; other -> other })
            escaped = false
        } else if c == '\\' { escaped = true }
        else if c == '"' { return .Some((out, i + 1)) }
        else { out.push(c) }
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:598
fn span_json(span: SourceSpan) -> String { "{{\"start\":{span.start},\"end\":{span.end}}}" }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:602
fn json_strs(values: [String]) -> String { values.iter().map(json_str).collect().join(",") }
// Rust: crates/jet-devserver/src/Canvas/validation_json.rs:610
fn json_optional_str(value: String?) -> String { value.map(json_str).unwrap_or("null") }
