// Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:1376
fn git_root(path: OSPath) -> OSPath? {
    // GATE #4494: real bounded git subprocess and native path transport.
    dir :: path.parent().unwrap_or_else(() -> OSPath.new("."))
    command := Command.new("git")
    command.args(["-C"]).arg(dir).args(["rev-parse", "--show-toplevel"])
