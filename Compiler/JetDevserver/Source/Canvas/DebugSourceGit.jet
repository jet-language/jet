                native :: session.native.as_ref() ?? return .Err(debug_error("session", "native debug session lost its compiled artifact"))
                binary :: native.binary.copy()
                rust_file :: native.rust_file.copy()
                rust_source :: native.rust_source.copy()
                jet_file :: native.jet_file.copy()
                jet_source :: native.jet_source.copy()
                transcript := ""
                final_result := .None
