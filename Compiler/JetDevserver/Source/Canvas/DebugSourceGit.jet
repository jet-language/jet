        if sessions.get_mut(id) == .Val(session) {
            if session.paused_adapter.as_mut() == .Val(adapter) -> adapter.resume(host)
            else if host.session().is_some_and((injected) -> injected.identity.session_id == id) -> host.clear_session()
            session.paused_adapter = .None
        } else if host.session().is_some_and((injected) -> injected.identity.session_id == id) -> host.clear_session()
        return .Ok(_)
    }
    // Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:515
    fn cancel_paused_session(self: &Self, host: &PausedEvaluateHost, id: String, reason: String) Err! {
        sessions := self.sessions.lock() ?? return .Err(debug_error("session", "debug session store is unavailable"))
        if sessions.get_mut(id) == .Val(session) {
            if session.paused_adapter.as_mut() == .Val(adapter) -> adapter.cancel(host, reason)
            else if host.session().is_some_and((injected) -> injected.identity.session_id == id) -> host.clear_session()
            session.paused_adapter = .None
        } else if host.session().is_some_and((injected) -> injected.identity.session_id == id) -> host.clear_session()
        return .Ok(_)
    }
