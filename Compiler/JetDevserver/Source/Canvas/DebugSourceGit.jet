fn breakpoint_json(src: String, lines: &[Usize], stale_anchors: &[String]) -> String {
    entries := []
    loop line in lines {
        valid :: line > 0 && line <= src.lines().count()
        span :: if valid -> .Val(line_span(src, line)) else -> .None
        entries.push("{{\"line\":{line},\"source_span\":{span.map((span) -> span_json(span)).unwrap_or("null")},\"state\":{json_str(if valid -> "valid" else -> "stale")}}}")
    }
    loop anchor in stale_anchors {
        span :: anchor_span(src, anchor)
        entries.push("{{\"line\":null,\"source_span\":{span.map((span) -> span_json(span)).unwrap_or("null")},\"anchor\":{json_str(anchor)},\"state\":\"stale\"}}")
