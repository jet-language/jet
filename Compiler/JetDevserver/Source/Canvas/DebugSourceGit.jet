// Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:656
fn validate_debug_limits(commands: &[String], breakpoints: &[Usize], watches: &[String]) Err! {
    if commands.len() > MAX_DEBUG_COMMANDS || breakpoints.len() > MAX_DEBUG_BREAKPOINTS || watches.len() > MAX_DEBUG_WATCHES {
        return .Err(debug_error("limit", "Canvas debug accepts at most 64 commands, 128 breakpoints, and 32 watches per session"))
    }
    if commands.iter().chain(watches.iter()).any((value) -> value.len() > MAX_DEBUG_COMMAND_BYTES) {
        return .Err(debug_error("limit", "Canvas debug command and watch names are limited to 256 bytes"))
    }
    loop command in commands -> validate_debug_command(command)
    loop watch in watches {
        trimmed := watch.trim() // #4303
        if trimmed.is_empty() || watch.split_whitespace().count() != 1 {
            return .Err(debug_error("unsupported", "Canvas debug watches must be one source-level name"))
        }
    }
    return .Ok(_)
}
// Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:694
fn validate_debug_breakpoint_anchors(anchors: &[String]) Err! {
    if anchors.len() > MAX_DEBUG_BREAKPOINTS || anchors.iter().any((anchor) -> anchor.len() > MAX_DEBUG_COMMAND_BYTES) {
        return .Err(debug_error("limit", "Canvas debug accepts at most 128 breakpoint spans of 256 bytes each"))
    }
    return .Ok(_)
}
// Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:708
fn validate_debug_command(command: String) Err! {
    parts := command.split_whitespace()
    verb :: parts.next() ?? return .Err(debug_error("unsupported", "Canvas debug commands cannot be empty"))
    arg :: parts.next()
    extra :: parts.next().is_some()
    valid :: if verb == {
        "step" | "s" | "next" | "n" | "continue" | "c" | "finish" | "f" | "locals" |
        "backtrace" | "bt" | "help" | "h" | "quit" | "q" | "list" | "l" |
        "reverse-continue" | "rcontinue" | "back-continue" | "fix" -> arg.is_none() && !extra
        "back" | "reverse" | "reverse-step" | "rstep" -> arg.map_or(true, (value) -> value.parse[Usize]().ok().is_some_and((steps) -> steps >= 1)) && !extra
        "print" | "p" | "watch" | "unwatch" -> arg.is_some() && !extra
        "why" -> arg.is_some()
        "when" -> arg.is_some() && !extra
        "break" | "b" -> arg.and_then((value) -> value.parse[Usize]().ok()).is_some_and((line) -> line >= 1) && !extra
        else -> false
    }
    if valid -> return .Ok(_)
    return .Err(debug_error("unsupported", "Canvas debug command is not in the source-level debugger vocabulary"))
}

impl NativeDebugArtifact {
    // Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:749
    fn build(path: OSPath, id: String) -> Self Err! {
        // GATE #4494: native filesystem/process primitives, bounded real child output.
        jet_source :: read_source_without_symlinks(path) ?? return .Err(debug_error("io", "couldn't read debug source: {err}"))
        output := run_compiler_work(() -> Driver.compile_bundle_path_opts_dbg(path.display().to_string(), CompileMode.Run,
            false, GateSet.default(), false, true, .None))
            ?? return .Err(debug_diagnostics_error(path, jet_source, err))
        dir :: std.env.temp_dir().join("jet-canvas-debug-{id}")
        fs.create_dir_all(dir) ?? return .Err(debug_error("io", "couldn't prepare native Canvas debug storage: {err}"))
        rust_file :: "canvas_debug.rs"
        rust_path :: dir.join(rust_file)
        binary :: dir.join("canvas_debug")
        if fs.write(rust_path, output.rust) == .Err(error) {
            _ :: fs.remove_dir_all(dir)
            return .Err(debug_error("io", "couldn't write native Canvas debug artifact: {error}"))
        }
        rustc := Command.new("rustc")
        rustc.args(["--edition", "2021", "-C", "debuginfo=2", "-C", "opt-level=0"])
            .arg("--crate-name").arg("jet_canvas_debug").arg(rust_path).arg("-o").arg(binary)
        if output.ffi.as_ref() == .Val(link) {
            rustc.arg("--extern").arg("{link.crate_name}={link.rlib_path.display()}")
            loop deps_dir in link.dependency_dirs().filter((dir) -> dir.is_dir()) {
                rustc.arg("-L").arg("dependency={deps_dir.display()}")
            }
        }
        rustc.args(output.clinks)
        compiled :: command_output_bounded(&rustc, MAX_CHILD_OUTPUT_BYTES).map_err((error) ->
            debug_error("diagnostic", "native Canvas debugger is unavailable: couldn't run the native compiler ({error})"))
        if compiled == {
            .Ok(result) -> {
                if !result.status.success() {
                    _ :: fs.remove_dir_all(dir)
                    return .Err(debug_error("diagnostic", "native Canvas debugger could not build the compiled source; the Jet source was kept intact"))
                }
            }
            .Err(error) -> {
                _ :: fs.remove_dir_all(dir)
                return .Err(error)
            }
        }
        build_id :: sha256_file_hex(binary).ok().map((digest) -> "sha256-{digest}")
        return .Ok(Self { dir: ^dir, binary: ^binary, build_id: ^build_id, rust_file: rust_file,
            rust_source: ^output.rust, jet_file: path.file_name().map((name) -> name.to_string_lossy().into_owned()).unwrap_or_else(() -> path.display().to_string()), jet_source: ^jet_source })
    }
}

// Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:849
fn debug_ok(src: String, graph_json: String, transcript: String, snapshot: &DebugSnapshot?, status: SessionStatus,
    session_id: String, tier: DebugTier, source_id: String, breakpoint_lines: &[Usize], stale_breakpoints: &[String], watches: &[String]) -> String {
    active_line :: if status == {
        .Running -> snapshot.map((snapshot) -> snapshot.line).or_else(() -> active_line_from_transcript(transcript))
        .Finished | .Failed -> .None
    }
    active_span :: active_line.map((line) -> line_span(src, line)).unwrap_or(SourceSpan { start: 0, end: 0 })
    active_node :: active_line.and_then((_) -> record_id_for_span(graph_json, "node_id", active_span)).unwrap_or_default()
    (wire_path, wire_path_truncated) :: active_line.map((_) -> record_ids_for_span(graph_json, "wire_id", active_span)).unwrap_or_else(() -> (_0: [], _1: false))
