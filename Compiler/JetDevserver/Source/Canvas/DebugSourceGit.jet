// Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:36
enum DebugTier { Interpreter; NativeLldb }
impl DebugTier {
    // Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:42
    fn parse(value: String?) -> Self Err! {
        if value.unwrap_or("jet-dev-interpreter") == {
            "jet-dev-interpreter" -> { return .Ok(.Interpreter) }
            "native-lldb" -> { return .Ok(.NativeLldb) }
            else -> { return .Err(debug_error("bad_request", "Canvas debug tier must be `jet-dev-interpreter` or `native-lldb`")) }
        }
    }
    // Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:53
    fn wire_name(self) -> String {
        if self == {
            .Interpreter -> "jet-dev-interpreter"
            .NativeLldb -> "native-lldb"
        }
    }
}

