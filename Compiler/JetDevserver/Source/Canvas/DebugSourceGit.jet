}
// Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:1415
fn untracked_diff(rel: String, src: String) -> String {
    diff := "--- /dev/null\n+++ b/{rel}\n"
    loop line in src.lines() {
        diff.push('+')
        diff.push_str(line)
        diff.push('\n')
    }
    return ^diff
}
