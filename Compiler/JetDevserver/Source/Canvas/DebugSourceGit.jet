            } else { live_session.paused_adapter = .None }
        }
        if result.status != .Running -> _ :: sessions.remove(id)
        return .Ok(DebugExecution { id: ^id, status: result.status, transcript: ^result.transcript, snapshot: ^result.snapshot, tier: session_tier })
    }

    // Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:422
    fn paused_adapter(self: Self, identity: SessionIdentity) -> PausedDebugSessionAdapter Err! {
        sessions :: self.sessions.lock() ?? return .Err(debug_error("session", "debug session store is unavailable"))
        session :: sessions.get(identity.session_id) ?? return .Err(debug_error("session", "debug session is no longer live; start a new session"))
        if session.source_id != identity.source_id || session.revision != identity.source_revision {
            return .Err(debug_error("conflict", "paused request source identity is stale"))
        }
        adapter :: session.paused_adapter.as_ref() ?? return .Err(debug_error("session", "debug session has no live paused facts"))
        if adapter.identity() != identity || !adapter.is_paused() {
            return .Err(debug_error("conflict", "paused request identity does not match the live debug stop"))
        }
        return .Ok(adapter.copy())
    }
    // Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:460
    fn clear_paused_session(self: &Self, host: &PausedEvaluateHost, id: String) Err! {
        sessions := self.sessions.lock() ?? return .Err(debug_error("session", "debug session store is unavailable"))
        if sessions.get_mut(id) == .Val(session) {
            if session.paused_adapter.as_mut() == .Val(adapter) -> adapter.exit(host)
            else if host.session().is_some_and((injected) -> injected.identity.session_id == id) -> host.clear_session()
            session.paused_adapter = .None
        } else if host.session().is_some_and((injected) -> injected.identity.session_id == id) -> host.clear_session()
        return .Ok(_)
    }
