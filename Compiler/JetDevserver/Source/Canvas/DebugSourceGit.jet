                    if session.native_live.as_mut() == .Val(live) {
                        current := live.command("continue")
                        transcript.push_str(current.transcript)
                        final_result = .Val(^current)
                    }
                }
                final_result := final_result ?? return .Err(debug_error("execution", "native debugger did not produce a stopped result"))
                status :: if final_result.paused -> SessionStatus.Running
                    else if final_result.code == ExitCodes.OK -> SessionStatus.Finished
                    else -> SessionStatus.Failed
                SessionResult { status: status, transcript: ^transcript, snapshot: ^final_result.snapshot, history: ^final_result.history }
            }
        }
        if sessions.get_mut(id) == .Val(live_session) {
            if !result.history.events.is_empty() -> live_session.history = .Val(result.history.copy())
            snapshot := result.snapshot.copy()
            live_session.snapshot = snapshot.copy()
            if result.status == .Running {
