            serial :: self.next_id.fetch_add(1, Ordering.Relaxed)
            id = "canvas-debug-{serial}"
            history := commands.to_vec()
            if history.is_empty() -> history.push("s")
            replay_commands = history.copy()
            native :: if tier == {
                .Interpreter -> .None
