//RS /// Live Canvas debugger ownership. A session is source- and revision-bound;
//RS /// the server replays only its bounded command history through the same Jet
//RS /// debugger boundary on each request. This keeps the HTTP protocol live while
//RS /// avoiding a second interpreter or a second semantic model.
//RS pub struct DebugSessions {
//RS     next_id: AtomicU64,
//RS     sessions: Mutex<HashMap<String, DebugSession>>,
//RS     pause_on_input_end: bool,
//RS }
//RS struct DebugSession {
//RS     path: PathBuf,
//RS     /// Canonical source identity supplied by the typed debug request.  It is
//RS     /// intentionally distinct from the local filesystem path.
//RS     source_id: String,
//RS     revision: String,
//RS     breakpoints: Vec<usize>,
//RS     tier: DebugTier,
//RS     created: u64,
//RS     commands: Vec<String>,
//RS     watches: Vec<String>,
//RS     native: Option<NativeDebugArtifact>,
//RS     /// Native Canvas retains one real paused LLDB inferior instead of
//RS     /// rebuilding/replaying a transcript for every HTTP request.
//RS     native_live: Option<jet_debug::NativeLiveSession>,
//RS     /// One canonical event history is captured for the interpreter session.
//RS     /// Later HTTP requests navigate that history without rerunning the source.
//RS     history: Option<jet_debug::DebugHistory>,
//RS     /// Last real paused-frame snapshot returned by the debugger.  It remains
//RS     /// attached to a live (paused) session so the devtools evaluator can
//RS     /// consume facts without rerunning or reconstructing the debugger.
//RS     snapshot: Option<jet_debug::DebugSnapshot>,
//RS     /// Typed bridge for the same source-owned snapshot and authority set.
//RS     paused_adapter: Option<PausedDebugSessionAdapter>,
//RS }
//RS /// Compiled debugger material owned by one live session. It is deliberately
