// Rust: crates/jet-devserver/src/Canvas/debug_source_git.rs:1114
fn record_width_for_span(json: String, id_key: String, wanted: String) -> Usize? {
    needle :: "\"{id_key}\":"
    loop chunk in json.split(needle).skip(1) {
        trimmed := chunk.trim_start() // #4303
        (id, _) :: parse_json_string(trimmed) ?? next
        if id != wanted -> next
        pos :: chunk.find("\"source_span\"")
        rest := chunk[pos + "\"source_span\"".len()..<chunk.len()] // #4303
        colon :: rest.find(':')
        value := rest[colon + 1..<rest.len()].trim_start() // #4303
        start :: json_usize_field(value, "start")
