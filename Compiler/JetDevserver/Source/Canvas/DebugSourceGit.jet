    fn cancel_all_paused_sessions(self: &Self, host: &PausedEvaluateHost, reason: String) Err! {
        ids :: self.sessions.lock().map_err((_) -> debug_error("session", "debug session store is unavailable"))?.keys().cloned().collect()
        loop id in ids -> self.cancel_paused_session(host, id, reason)
