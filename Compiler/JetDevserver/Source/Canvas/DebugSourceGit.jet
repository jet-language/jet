fn record_ids_for_span(json: String, id_key: String, active: SourceSpan) -> ([String], Bool) {
    needle :: "\"{id_key}\":"
    matches := []
    loop chunk in json.split(needle).skip(1) {
        trimmed := chunk.trim_start() // #4303
        (id, _) :: parse_json_string(trimmed) ?? next
        pos :: chunk.find("\"source_span\"") ?? next
        rest := chunk[pos + "\"source_span\"".len()..<chunk.len()] // #4303
        colon :: rest.find(':') ?? next
        value := rest[colon + 1..<rest.len()].trim_start() // #4303
        if value.starts_with("null") -> next
        start :: json_usize_field(value, "start") ?? next
        end :: json_usize_field(value, "end") ?? next
        if span_overlaps(SourceSpan { start: start, end: end }, active) {
