// Canvas statement edits: reorder, pattern arms, statement states, multi-input
// lists and execution convergence. Each one finds its target in the checked
// AST of the file's own module, then writes through write_checked_formatted.
use {
    jet_canvas.[is_space_byte, line_after, line_start, lvalue_span, pattern_arm_edit_span, snippet, stmt_execution_anchor, stmt_is_terminal, switch_was_classic_if]
    jet_driver.[JetDriverDocModule, jet_driver_apply_edits, jet_driver_has_errors]
    jet_foundation.[DIAGNOSTIC_ERROR, Diagnostic, Expr, Func, Item, Span, Stmt, SwitchArm, TextEdit, ast_visit_body, expr_span, type_name]
    jet_lsp.[LSPChecker, LSPOverlay]
    jet_parser.[jet_format_source, jfmt_is_subjectless_guard, jfmt_stmt_span, jfmt_uses_classic_if_spelling]
    jet_semindex.[SemIndex]
}

// One function or method of the checked module a Canvas graph draws.
CanvasFunc: struct {
    name: String
    name_span: Span
    span: Span
    body: [Stmt]
    return_type: String?
}

// One statement of a function body: its execution anchor, its source span,
// its whole lines, and the branch path of the block that holds it.
StatementLoc: struct {
    anchor: Span
    source: Span
    full: Span
    block: [Int]
    index: Int
    is_guard: Bool
    is_expr: Bool
    guard_span: Span?
}

// The whole ordinary statements a convergence target selects.
ExpressionSelection: struct {
    span: Span
    full: Span
}

// Where a convergence step goes: the offset, the text before the step, the
// span of the statement or branch it follows, and whether that is a branch.
ExecInsertion: struct {
    offset: Int
    indent: String
    owner: Span
    branch: Bool
}

SelectionScan: struct {
    target: Span
    found: ExpressionSelection?
}

InsertionScan: struct {
    node_span: Span
    pin_name: String
    found: ExecInsertion?
    problem: String?
}

ArmInsertScan: struct {
    node_span: Span
    head: String
    fresh: String
    found: TextEdit?
}

ArmSpanScan: struct {
    pattern_span: Span
    found: Bool
    remove_span: Span
    only_arm: Bool
}

SwitchedScan: struct {
    node_span: Span
    marker: Span?
    nested: Bool
}

ListScan: struct {
    node_span: Span
    found: Bool
    items: [Span]
}

// ---- Reorder ----

apply_reorder_statements: fn(checker: LSPChecker, path: String, src: String, graph_id: String, moved: Span, anchor: Span, position: String) -> String Err! {
    func: checked_func_for_graph(checker, path, src, graph_id)
    locs := [StatementLoc]{}
    block := [Int]{}
    collect_statement_locs(src, func.body, block, locs)
    moved_at: loc_by_anchor(locs, moved) ?? return Err(edit_error("not_found", "Canvas step to move no longer exists"))
    anchor_at: loc_by_anchor(locs, anchor) ?? return Err(edit_error("not_found", "Canvas anchor step no longer exists"))
    moved_full: locs[moved_at].full
    anchor_full: locs[anchor_at].full
    if !same_block(locs[moved_at].block, locs[anchor_at].block) -> return Err(edit_error("bad_request", "can't move a step into a different branch yet"))
    if locs[moved_at].index == locs[anchor_at].index -> return Ok(edit_ok(false, path))
    if moved_full.start <= anchor_full.start && anchor_full.start < moved_full.end {
        return Err(edit_error("bad_request", "can't anchor a step inside the moved source yet"))
    }
    insert := 0
    if position == "before" {
        insert = anchor_full.start
    } else if position == "after" {
        insert = anchor_full.end
    } else {
        return Err(edit_error("bad_request", "Canvas reorder position must be before or after"))
    }
    if moved_full.end > src.len() -> return Err(edit_error("bad_request", "Canvas moved source span is stale"))
    chunk: src.slice(moved_full.start, moved_full.end)
    rest: "{src.slice(0, moved_full.start)}{src.slice(moved_full.end, src.len())}"
    if insert > moved_full.start -> insert -= moved_full.end - moved_full.start
    if insert < 0 -> insert = 0
    if insert > rest.len() -> insert = rest.len()
    write_checked_formatted(checker, path, src, "{rest.slice(0, insert)}{chunk}{rest.slice(insert, rest.len())}")
}

loc_by_anchor: fn(locs: [StatementLoc], anchor: Span) -> Int? Never! {
    loop (at, loc) in locs {
        if same_span(loc.anchor, anchor) -> return Val(at)
    }
    None
}

same_block: fn(left: [Int], right: [Int]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop at in 0..<left.len() {
        if left[at] != right[at] -> return false
    }
    true
}

// ---- Execution convergence ----

apply_exec_convergence: fn(checker: LSPChecker, path: String, src: String, graph_id: String, from_span: Span, target_span: Span, from_pin_name: String, strategy: String, function: String, helper_name: String?) -> String Err! {
    validate_ident(function)
    if strategy != "extract" && strategy != "helper" && strategy != "duplicate" {
        return Err(edit_error("bad_request", "Canvas convergence strategy must be extract, helper, or duplicate"))
    }
    if same_span(from_span, target_span) -> return Err(edit_error("bad_request", "Canvas convergence needs two different source pins"))
    name_span: graph_id_name_span(graph_id) ?? return Err(edit_error("bad_request", "Canvas graph id is not a function graph"))
    checked: checked_source(checker, path, src)
    doc: checked.modules[checked.at]
    func: find_func_by_name_span(doc.items, name_span) ?? return Err(edit_error("not_found", "Canvas graph no longer exists"))
    target: find_expression_selection(func.body, target_span, src) ?? return Err(edit_error("not_found", "Canvas convergence target source selection no longer exists"))
    if target.full.end > src.len() -> return Err(edit_error("bad_request", "Canvas convergence target span is stale"))
    target_text: src.slice(target.span.start, target.span.end).trim()
    if target_text == "" -> return Err(edit_error("ambiguous", "Canvas needs one or more complete ordinary source statements to converge"))
    scan := InsertionScan{node_span: from_span, pin_name: from_pin_name, found: None, problem: None}
    find_exec_insertion(src, func.body, scan)
    if scan.problem == .Val(problem) -> return Err(edit_error("ambiguous", problem))
    insertion: scan.found ?? return Err(edit_error("not_found", "Canvas convergence source path no longer exists"))
    if insertion.branch && target.span.start >= insertion.owner.end {
        return Err(edit_error("structured_join", "This source already has a structured join after the branch; keep the downstream step single"))
    }
    index: checked.index ?? return Err(edit_error("check", "Canvas could not resolve convergence captures: the check built no semantic index"))
    params: convergence_params(index, doc.path, target.span)
    arg_names: loop param in params -> param.name
    args: arg_names.join(", ")
    call_name := function
    edits := [TextEdit]{}
    if strategy == "helper" {
        name: helper_name ?? ""
        if name == "" -> return Err(edit_error("bad_request", "Canvas exact-body helper choice has no helper name"))
        validate_ident(name)
        if (exact_body_helper_name(doc.items, src, target_text, func.name) ?? "") != name {
            return Err(edit_error("stale", "The selected helper body no longer matches the converged source"))
        }
        call_name = name
    }
    if strategy == "extract" {
        if function_name_exists(doc.items, function) -> return Err(edit_error("bad_request", "Canvas helper name already exists; choose another name"))
        signature_parts: loop param in params -> "{param.name}: {param.ty}"
        body_lines: loop line in target_text.lines() -> "    {line.trim()}\n"
        edits.push(edit(Span{start: 0, end: 0}, "{function}: fn({signature_parts.join(", ")}) {{\n{body_lines.join("")}}}\n\n"))
    }
    if strategy != "duplicate" {
        suffix: src.slice(target.span.end, target.full.end)
        edits.push(edit(target.full, "{indentation_at(src, target.full.start)}{call_name}({args}){suffix}"))
    }
    incoming: if strategy == "duplicate" -> target_text else -> "{call_name}({args})"
    edits.push(edit(Span{start: insertion.offset, end: insertion.offset}, "{insertion.indent}{incoming}\n"))
    changed: jet_driver_apply_edits(src, edits) ?? return Err(edit_error("overlap", "Canvas convergence source edits overlapped"))
    write_checked_formatted(checker, path, src, changed)
}

// The locals and parameters `target` reads, in source order, each with the
// type its definition records.
convergence_params: fn(index: SemIndex, module_path: String, target: Span) -> [NamedType] Err! {
    order := [Int]{}
    loop (at, reference) in index.references {
        if reference.module_path == module_path && reference.span.start >= target.start && reference.span.end <= target.end -> order.push(at)
    }
    loop at in 1..<order.len() {
        cursor := at
        loop cursor > 0 && span_before(index.references[order[cursor]].span, index.references[order[cursor - 1]].span) {
            held: order[cursor]
            order[cursor] = order[cursor - 1]
            order[cursor - 1] = held
            cursor -= 1
        }
    }
    params := [NamedType]{}
    seen := [String:Bool]{}
    loop at in order {
        reference: index.references[at]
        anchor: reference.target ?? next
        shown := String?{None}
        loop definition in index.definitions {
            def: definition.def
            if def.module_path != anchor.module_path || !same_span(def.def_span, anchor.def_span) -> next
            if def.kind == .Local(_, local_ty) {
                found: local_ty ?? return Err(edit_error("ambiguous", "Canvas could not preserve a convergence capture type"))
                shown = Val(type_name(found))
            } else if def.kind == .Param(param_ty) {
                shown = Val(type_name(param_ty))
            }
            break
        }
        ty: shown ?? next
        if seen.has_key(reference.name) -> next
        seen[reference.name] = true
        params.push(NamedType{name: reference.name, ty: ty})
    }
    Ok(params)
}

span_before: fn(left: Span, right: Span) -> Bool Never! {
    left.start < right.start || (left.start == right.start && left.end < right.end)
}

find_expression_selection: fn(stmts: [Stmt], target: Span, src: String) -> ExpressionSelection? Never! {
    if expression_selection_in_block(stmts, target, src) == .Val(found) -> return Val(found)
    scan := SelectionScan{target: target, found: None}
    loop stmt in stmts {
        stmt_each_body(stmt, fn(body: [Stmt]) { note_expression_selection(scan, body, src) })
        if scan.found != None -> break
    }
    scan.found
}

note_expression_selection: fn(scan: &SelectionScan, body: [Stmt], src: String) Never! {
    if scan.found != None -> return
    scan.found = find_expression_selection(body, scan.target, src)
}

// The run of expression statements of this block that `target` touches,
// first through last; any other statement inside the run refuses it.
expression_selection_in_block: fn(stmts: [Stmt], target: Span, src: String) -> ExpressionSelection? Never! {
    first := -1
    last := -1
    loop (at, stmt) in stmts {
        if stmt == .Expr(expression) {
            anchor: expr_span(expression)
            span: source_expression_span(src, expression)
            if same_span(anchor, target) || same_span(span, target) || span_within(target, span) || span_within(span, target) || spans_cross(span, target) {
                if first < 0 -> first = at
                last = at
            }
        }
    }
    if first < 0 -> return None
    start := 0
    end := 0
    stop: last + 1
    loop at in first..<stop {
        if stmts[at] == .Expr(expression) {
            span: source_expression_span(src, expression)
            if at == first -> start = span.start
            end = span.end
        } else {
            return None
        }
    }
    if stop - first > 1 && (start < target.start || end > target.end) -> return None
    Val(ExpressionSelection{span: Span{start: start, end: end}, full: Span{start: line_start(src, start), end: line_after(src, end)}})
}

// Where a convergence step from the node at `scan.node_span` goes: after that
// statement, or at the end of the branch body its pin names.
find_exec_insertion: fn(src: String, stmts: [Stmt], scan: &InsertionScan) Never! {
    loop stmt in stmts {
        if scan.found != None || scan.problem != None -> return
        if exec_branch_node_matches(stmt, scan.node_span) {
            wanted: exec_branch_index(stmt, scan.pin_name) ?? -1
            owner: branch_source_span(src, stmt)
            stmt_each_branch(stmt, fn(branch: Int, body: [Stmt]) { note_branch_insertion(scan, src, body, owner, branch == wanted) })
            if scan.found == None && scan.problem == None -> scan.problem = Val("Canvas convergence pin has no source-backed branch body")
            return
        }
        if same_span(stmt_source_span(stmt), scan.node_span) || same_span(stmt_execution_anchor(stmt), scan.node_span) {
            if stmt_is_terminal(stmt) {
                scan.problem = Val("Canvas cannot add a convergence step after an early exit")
                return
            }
            full: stmt_text_span(src, stmt)
            scan.found = Val(ExecInsertion{offset: full.end, indent: indentation_at(src, full.start), owner: full, branch: false})
            return
        }
        stmt_each_body(stmt, fn(body: [Stmt]) { find_exec_insertion(src, body, scan) })
    }
}

note_branch_insertion: fn(scan: &InsertionScan, src: String, body: [Stmt], owner: Span, selected: Bool) Never! {
    if !selected || scan.found != None || scan.problem != None -> return
    if body.len() == 0 {
        scan.problem = Val("Canvas needs a non-empty source-backed branch body to converge")
        return
    }
    last: body[body.len() - 1]
    if stmt_is_terminal(last) || stmt_is_structured(last) {
        scan.problem = Val("Canvas cannot prove a convergence path after this branch body")
        return
    }
    full: stmt_text_span(src, last)
    if full.end > owner.end {
        last_end: if last == .Expr(expression) -> source_expression_span(src, expression).end else -> stmt_source_span(last).end
        close: find_unquoted_byte(src, last_end, 125) ?? -1
        if close < 0 || close >= owner.end {
            scan.problem = Val("Canvas could not locate the source-backed branch body boundary")
            return
        }
        scan.found = Val(ExecInsertion{offset: close, indent: "\n{indentation_at(src, owner.start)}    ", owner: owner, branch: true})
        return
    }
    scan.found = Val(ExecInsertion{offset: full.end, indent: indentation_at(src, full.start), owner: owner, branch: true})
}

exec_branch_node_matches: fn(stmt: Stmt, node_span: Span) -> Bool Never! {
    if stmt == .ComptimeIf(_, _, _, _, span, _) -> return same_span(span, node_span)
    if stmt == .Switch(_, arms, _, span) -> return switch_node_matches(arms, span, node_span)
    if stmt == .ComptimeSwitch(_, arms, _, span) -> return switch_node_matches(arms, span, node_span)
    false
}

switch_node_matches: fn(arms: [SwitchArm], span: Span, node_span: Span) -> Bool Never! {
    if same_span(span, node_span) -> return true
    loop arm in arms {
        if same_span(expr_span(arm.cond), node_span) -> return true
    }
    false
}

// The stmt_each_branch index of the branch a convergence pin names: `then`
// and `else` of a comptime if, else `then` (the first arm), `armN` and `else`.
exec_branch_index: fn(stmt: Stmt, pin_name: String) -> Int? Never! {
    if stmt == .ComptimeIf(_, _, _, _, _, _) {
        if pin_name == "then" -> return Val(0)
        if pin_name == "else" -> return Val(1)
        return None
    }
    arm_count := 0
    if stmt == .Switch(_, arms, _, _) -> arm_count = arms.len()
    if stmt == .ComptimeSwitch(_, arms, _, _) -> arm_count = arms.len()
    if pin_name == "else" -> return Val(arm_count)
    if pin_name == "then" {
        if arm_count > 0 -> return Val(0)
        return None
    }
    if !pin_name.starts_with("arm") -> return None
    number: pin_name.slice(3, pin_name.len()).to_int() ?? return None
    if number < 1 || number > arm_count -> return None
    Val(number - 1)
}

// The source of a branch statement from its `if` through the last `else`
// block's closing brace.
branch_source_span: fn(src: String, stmt: Stmt) -> Span Never! {
    stmt_span: jfmt_stmt_span(stmt)
    keyword: find_word(src, line_start(src, stmt_span.start), "if") ?? stmt_span.start
    open: find_unquoted_byte(src, keyword, 123) ?? return stmt_span
    close := matching_delimiter(src, open, 123, 125) ?? stmt_span.end
    loop {
        else_start: find_word(src, close + 1, "else") ?? break
        if src.slice(close + 1, else_start).trim() != "" -> break
        next_open: find_unquoted_byte(src, else_start + 4, 123) ?? break
        close = matching_delimiter(src, next_open, 123, 125) ?? break
    }
    Span{start: keyword, end: close + 1}
}

stmt_is_structured: fn(stmt: Stmt) -> Bool Never! {
    if stmt == {
        .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Switch(_, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeIf(_, _, _, _, _, _) -> true
        .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) | .Defer(_, _) -> false
    }
}

// The other function of this module whose body is exactly `target`.
exact_body_helper_name: fn(items: [Item], src: String, target: String, current: String) -> String? Never! {
    loop item in items {
        if item == .Func(function) {
            if function.name != current && body_matches_expression(src, function.body, target) -> return Val(function.name)
        } else if item == .Struct(structure) {
            loop method in structure.methods {
                if method.name != current && body_matches_expression(src, method.body, target) -> return Val(method.name)
            }
        } else if item == .Impl(implementation) {
            loop method in implementation.methods {
                if method.name != current && body_matches_expression(src, method.body, target) -> return Val(method.name)
            }
        } else if item == .CodeModule(code) {
            if code.body == .Val(body) {
                if exact_body_helper_name(body, src, target, current) == .Val(found) -> return Val(found)
            }
        }
    }
    None
}

body_matches_expression: fn(src: String, body: [Stmt], target: String) -> Bool Never! {
    text: expression_body_source(src, body) ?? return false
    formatted_expression_matches(text, target)
}

expression_body_source: fn(src: String, body: [Stmt]) -> String? Never! {
    if body.len() == 0 -> return None
    start := 0
    end := 0
    loop (at, stmt) in body {
        if stmt == .Expr(expression) {
            span: source_expression_span(src, expression)
            if at == 0 -> start = span.start
            end = span.end
        } else {
            return None
        }
    }
    if start > end || end > src.len() -> return None
    Val(src.slice(start, end).trim())
}

formatted_expression_matches: fn(left: String, right: String) -> Bool Never! {
    left_text: canvas_match_source(left)
    right_text: canvas_match_source(right)
    left_text == right_text || normalized_source_shape(left_text) == normalized_source_shape(right_text)
}

canvas_match_source: fn(expression: String) -> String Never! {
    candidate: "canvas_match: fn() {{\n    {expression.trim()}\n}}\n"
    formatted: jet_format_source(candidate, false)
    if formatted.ok -> return formatted.text
    candidate
}

// `source` without whitespace outside string and character literals.
normalized_source_shape: fn(source: String) -> String Never! {
    bytes: source.bytes()
    parts := [String]{}
    quote := 0
    escaped := false
    run := -1
    loop at in 0..<bytes.len() {
        byte: Int{bytes[at]}
        keep := true
        if quote != 0 {
            if escaped {
                escaped = false
            } else if byte == 92 {
                escaped = true
            } else if byte == quote {
                quote = 0
            }
        } else if byte == 34 || byte == 39 {
            quote = byte
        } else if is_space_byte(byte) {
            keep = false
        }
        if keep {
            if run < 0 -> run = at
        } else if run >= 0 {
            parts.push(source.slice(run, at))
            run = -1
        }
    }
    if run >= 0 -> parts.push(source.slice(run, bytes.len()))
    parts.join("")
}

function_name_exists: fn(items: [Item], name: String) -> Bool Never! {
    loop item in items {
        if item == .Func(function) {
            if function.name == name -> return true
        } else if item == .Struct(structure) {
            loop method in structure.methods {
                if method.name == name -> return true
            }
        } else if item == .Impl(implementation) {
            loop method in implementation.methods {
                if method.name == name -> return true
            }
        } else if item == .CodeModule(code) {
            if code.body == .Val(body) {
                if function_name_exists(body, name) -> return true
            }
        }
    }
    false
}

// ---- Pattern arms ----

apply_add_pattern_arm: fn(checker: LSPChecker, path: String, src: String, graph_id: String, node_span: Span, pattern: String) -> String Err! {
    func: checked_func_for_graph(checker, path, src, graph_id)
    head: normalize_pattern_arm_head(pattern)
    if head == "" -> return Err(edit_error("bad_request", "pattern arm text is empty"))
    scan := ArmInsertScan{node_span: node_span, head: head, fresh: fresh_arm_body(func.return_type), found: None}
    find_arm_insert(src, func.body, scan)
    found: scan.found ?? return Err(edit_error("not_found", "Canvas pattern node no longer exists"))
    changed: jet_driver_apply_edits(src, [TextEdit]{found}) ?? return Err(edit_error("overlap", "Canvas pattern arm insert overlapped"))
    write_checked_formatted(checker, path, src, changed)
}

apply_edit_pattern_arm: fn(checker: LSPChecker, path: String, src: String, graph_id: String, pattern_span: Span, pattern: String) -> String Err! {
    func: checked_func_for_graph(checker, path, src, graph_id)
    head: normalize_pattern_arm_head(pattern)
    if head == "" -> return Err(edit_error("bad_request", "pattern arm text is empty"))
    scan := ArmSpanScan{pattern_span: pattern_span, found: false, remove_span: Span{start: 0, end: 0}, only_arm: false}
    find_arm_span(src, func.body, scan)
    if !scan.found -> return Err(edit_error("not_found", "Canvas pattern arm no longer exists"))
    changed: jet_driver_apply_edits(src, [TextEdit]{edit(pattern_span, head)}) ?? return Err(edit_error("overlap", "Canvas pattern arm edit overlapped"))
    write_checked_formatted(checker, path, src, changed)
}

apply_remove_pattern_arm: fn(checker: LSPChecker, path: String, src: String, graph_id: String, pattern_span: Span) -> String Err! {
    func: checked_func_for_graph(checker, path, src, graph_id)
    scan := ArmSpanScan{pattern_span: pattern_span, found: false, remove_span: Span{start: 0, end: 0}, only_arm: false}
    find_arm_span(src, func.body, scan)
    if !scan.found -> return Err(edit_error("not_found", "Canvas pattern arm no longer exists"))
    if scan.only_arm -> return Err(edit_error("bad_request", "can't remove the last pattern arm; the branch would have no path left"))
    changed: jet_driver_apply_edits(src, [TextEdit]{edit(scan.remove_span, "")}) ?? return Err(edit_error("overlap", "Canvas pattern arm delete overlapped"))
    write_checked_formatted(checker, path, src, changed)
}

// The edit that adds an arm to the pattern branch drawn at `scan.node_span`.
// A classic `if x == .V(…)` branch is rewritten whole into a switch.
find_arm_insert: fn(src: String, stmts: [Stmt], scan: &ArmInsertScan) Never! {
    loop stmt in stmts {
        if scan.found != None -> return
        if stmt == .Switch(subject, arms, else_body, span) {
            if jfmt_is_subjectless_guard(subject, span) && switch_was_classic_if(src, arms, span) {
                first: arms[0]
                if first.cond == .PatternTest(_, _, _, _) && (same_span(expr_span(first.cond), scan.node_span) || same_span(span, scan.node_span)) {
                    scan.found = Val(edit(stmt_text_span(src, stmt), classic_switch_source(src, first, else_body, scan.head, scan.fresh)))
                    return
                }
            } else if same_span(span, scan.node_span) {
                scan.found = Val(switch_arm_insert(src, arms, else_body, span, scan.head, scan.fresh))
                return
            }
        } else if stmt == .ComptimeSwitch(_, arms, else_body, span) {
            if same_span(span, scan.node_span) {
                scan.found = Val(switch_arm_insert(src, arms, else_body, span, scan.head, scan.fresh))
                return
            }
        }
        stmt_each_body(stmt, fn(body: [Stmt]) { find_arm_insert(src, body, scan) })
    }
}

switch_arm_insert: fn(src: String, arms: [SwitchArm], else_body: [Stmt]?, span: Span, head: String, fresh: String) -> TextEdit Never! {
    insert := dispatch_body_insert_offset(src, span)
    if arms.len() > 0 {
        insert = line_after(src, arms[arms.len() - 1].span.end)
    } else if else_body == .Val(body) {
        insert = if body.len() > 0 -> line_start(src, jfmt_stmt_span(body[0]).start) else -> line_start(src, span.end)
    }
    indent: indentation_at(src, insert)
    edit(Span{start: insert, end: insert}, "{indent}{head} -> {{\n{indent}    {fresh}\n{indent}}}\n")
}

// `if subject == { head -> then; new_head -> fresh; else -> … }` for a
// classic single-pattern branch.
classic_switch_source: fn(src: String, arm: SwitchArm, else_body: [Stmt]?, new_head: String, fresh: String) -> String Never! {
    subject_src := ""
    if arm.cond == .PatternTest(subject, _, _, _) -> subject_src = snippet(src, expr_span(subject))
    head_span: pattern_arm_edit_span(src, arm.cond)
    head: if head_span.start >= 0 && head_span.end <= src.len() && head_span.start <= head_span.end -> src.slice(head_span.start, head_span.end) else -> snippet(src, expr_span(arm.cond))
    then_body: block_body_source(src, arm.body, "        ")
    else_text := ""
    if else_body == .Val(body) -> else_text = "    else -> {{\n{block_body_source(src, body, "        ")}    }}\n"
    "if {subject_src} == {{\n    {head} -> {{\n{then_body}    }}\n    {new_head} -> {{\n        {fresh}\n    }}\n{else_text}}}\n"
}

block_body_source: fn(src: String, stmts: [Stmt], indent: String) -> String Never! {
    parts := [String]{}
    loop stmt in stmts {
        span: stmt_text_span(src, stmt)
        loop line in src.slice(span.start, span.end).trim().lines() -> parts.push("{indent}{line.trim()}\n")
    }
    parts.join("")
}

dispatch_body_insert_offset: fn(src: String, span: Span) -> Int Never! {
    end: if span.end < src.len() -> span.end else -> src.len()
    if span.start > end -> return span.end
    if src.slice(span.start, end).index_of("{{") == .Val(open) -> return line_after(src, span.start + open)
    span.end
}

// The arm whose edit span is `scan.pattern_span`, the lines removing it take,
// and whether it is the branch's only path.
find_arm_span: fn(src: String, stmts: [Stmt], scan: &ArmSpanScan) Never! {
    loop stmt in stmts {
        if scan.found -> return
        if stmt == .Switch(subject, arms, else_body, span) {
            guard: jfmt_is_subjectless_guard(subject, span)
            loop arm in arms {
                classic: guard && jfmt_uses_classic_if_spelling(src.bytes(), span, expr_span(arm.cond))
                arm_span: if classic -> pattern_arm_edit_span(src, arm.cond) else -> expr_span(arm.cond)
                if same_span(arm_span, scan.pattern_span) {
                    scan.found = true
                    scan.remove_span = if classic -> stmt_text_span(src, stmt) else -> arm_text_span(src, arm.span)
                    scan.only_arm = classic || (arms.len() == 1 && else_body == None)
                    return
                }
            }
        } else if stmt == .ComptimeSwitch(_, arms, else_body, _) {
            loop arm in arms {
                if same_span(expr_span(arm.cond), scan.pattern_span) {
                    scan.found = true
                    scan.remove_span = arm_text_span(src, arm.span)
                    scan.only_arm = arms.len() == 1 && else_body == None
                    return
                }
            }
        }
        stmt_each_body(stmt, fn(body: [Stmt]) { find_arm_span(src, body, scan) })
    }
}

arm_text_span: fn(src: String, span: Span) -> Span Never! {
    Span{start: line_start(src, span.start), end: line_after(src, span.end)}
}

normalize_pattern_arm_head: fn(pattern: String) -> String Never! {
    head := pattern.trim()
    if head.starts_with("==") -> head = head.slice(2, head.len()).trim()
    loop head.ends_with("->") -> head = head.slice(0, head.len() - 2)
    head.trim()
}

fresh_arm_body: fn(return_type: String?) -> String Never! {
    if return_type == .Val(ret) {
        if ret != "Void" -> return "return {default_arg_for_type(ret)}"
    }
    "print(\"canvas arm\")"
}

// ---- Statement state ----

apply_toggle_switch_state: fn(checker: LSPChecker, path: String, src: String, graph_id: String, node_span: Span) -> String Err! {
    func: checked_func_for_graph(checker, path, src, graph_id)
    scan := SwitchedScan{node_span: node_span, marker: None, nested: false}
    find_switched_node(func.body, scan)
    if scan.marker == .Val(marker_span) {
        removed: jet_driver_apply_edits(src, [TextEdit]{edit(marker_span, "")}) ?? return Err(edit_error("overlap", "Canvas statement-state toggle overlapped"))
        return Ok(write_checked_formatted(checker, path, src, removed))
    }
    if scan.nested -> return Err(edit_error("bad_request", "Canvas node is already inside a statement state"))
    if !statement_contains_span(func.body, node_span) || same_span(func.name_span, node_span) {
        return Err(edit_error("not_found", "Canvas statement node no longer exists"))
    }
    insert: line_start(src, node_span.start)
    changed: jet_driver_apply_edits(src, [TextEdit]{edit(Span{start: insert, end: insert}, "#Off ")}) ?? return Err(edit_error("overlap", "Canvas statement-state toggle overlapped"))
    write_checked_formatted(checker, path, src, changed)
}

find_switched_node: fn(stmts: [Stmt], scan: &SwitchedScan) Never! {
    loop stmt in stmts {
        if scan.marker != None || scan.nested -> return
        if stmt == .Switched(marker, _, span) {
            if same_span(span, scan.node_span) {
                scan.marker = Val(Span{start: marker.span.start, end: marker.span.end})
                return
            }
            if span_within(scan.node_span, span) {
                scan.nested = true
                return
            }
        }
        stmt_each_body(stmt, fn(body: [Stmt]) { find_switched_node(body, scan) })
    }
}

statement_contains_span: fn(stmts: [Stmt], node_span: Span) -> Bool Never! {
    loop stmt in stmts {
        if span_within(node_span, jfmt_stmt_span(stmt)) -> return true
    }
    false
}

// ---- Multi-input lists ----

apply_append_multi_input: fn(checker: LSPChecker, path: String, src: String, node_span: Span, element: String) -> String Err! {
    func: checked_func_containing_span(checker, path, src, node_span)
    list: find_list_literal(func.body, node_span)
    if !list.found -> return Err(edit_error("not_found", "Canvas multi-input node no longer exists"))
    if node_span.start < 0 || node_span.end > src.len() || node_span.start > node_span.end {
        return Err(edit_error("bad_request", "Canvas multi-input source span is stale"))
    }
    insert := 0
    if list.items.len() > 0 {
        insert = list.items[list.items.len() - 1].end
    } else {
        close: src.slice(node_span.start, node_span.end).last_index_of("]") ?? return Err(edit_error("bad_request", "Canvas multi-input source span is stale"))
        insert = node_span.start + close
    }
    prefix: if list.items.len() == 0 -> "" else -> ", "
    changed: jet_driver_apply_edits(src, [TextEdit]{edit(Span{start: insert, end: insert}, "{prefix}{element}")}) ?? return Err(edit_error("overlap", "Canvas multi-input append overlapped"))
    write_checked_formatted(checker, path, src, changed)
}

apply_remove_multi_input_element: fn(checker: LSPChecker, path: String, src: String, node_span: Span, element_span: Span) -> String Err! {
    func: checked_func_containing_span(checker, path, src, node_span)
    list: find_list_literal(func.body, node_span)
    if !span_listed(list.items, element_span) -> return Err(edit_error("not_found", "Canvas multi-input element no longer exists"))
    remove: comma_separated_remove_span(src, node_span, element_span)
    changed: jet_driver_apply_edits(src, [TextEdit]{edit(remove, "")}) ?? return Err(edit_error("overlap", "Canvas multi-input delete overlapped"))
    write_checked_formatted(checker, path, src, changed)
}

// The list literal at `node_span` in `body`, with its element spans.
find_list_literal: fn(body: [Stmt], node_span: Span) -> ListScan Never! {
    scan := ListScan{node_span: node_span, found: false, items: [Span]{}}
    ast_visit_body(body, fn(expression: Expr) { note_list_literal(scan, expression) }, true)
    scan
}

note_list_literal: fn(scan: &ListScan, expression: Expr) Never! {
    if scan.found -> return
    if expression == .ListLit(elements, span, _) {
        if !same_span(span, scan.node_span) -> return
        scan.found = true
        loop element in elements -> scan.items.push(expr_span(element))
    }
}

span_listed: fn(spans: [Span], wanted: Span) -> Bool Never! {
    loop span in spans {
        if same_span(span, wanted) -> return true
    }
    false
}

// `element` with the comma after it, or else the comma before it.
comma_separated_remove_span: fn(src: String, container: Span, element: Span) -> Span Err! {
    if container.start < 0 || container.end > src.len() || container.start > container.end {
        return Err(edit_error("bad_request", "Canvas multi-input span is stale"))
    }
    text: src.slice(container.start, container.end)
    rel_start: clamp_offset(element.start - container.start, text.len())
    rel_end: clamp_offset(element.end - container.start, text.len())
    if text.slice(rel_end, text.len()).index_of(",") == .Val(comma) {
        return Ok(Span{start: element.start, end: consume_trailing_space(src, element.end + comma + 1, container.end)})
    }
    before: text.slice(0, rel_start)
    if before.last_index_of(",") == .Val(comma) {
        return Ok(Span{start: container.start + consume_leading_space_back(before, comma), end: element.end})
    }
    Ok(Span{start: element.start, end: element.end})
}

clamp_offset: fn(offset: Int, limit: Int) -> Int Never! {
    if offset < 0 -> return 0
    if offset > limit -> return limit
    offset
}

consume_trailing_space: fn(src: String, offset: Int, limit: Int) -> Int Never! {
    bytes: src.bytes()
    cursor := offset
    loop cursor < limit && cursor < bytes.len() && is_space_byte(Int{bytes[cursor]}) -> cursor += 1
    cursor
}

consume_leading_space_back: fn(before: String, comma: Int) -> Int Never! {
    bytes: before.bytes()
    start := comma
    loop start > 0 && is_space_byte(Int{bytes[start - 1]}) -> start -= 1
    start
}

// ---- Checked functions ----

// One checked module of a Canvas file: the check's modules, the position of
// the file's own, and the semantic index the check built.
CheckedSource: struct {
    modules: [JetDriverDocModule]
    at: Int
    index: SemIndex?
}

// Check `src` as `path`; an error diagnostic refuses the edit.
checked_source: fn(checker: LSPChecker, path: String, src: String) -> CheckedSource Err! {
    checked: checker.check(path, [LSPOverlay]{LSPOverlay{path: path, source: src}})
    if jet_driver_has_errors(checked.diagnostics) -> return Err(diagnostics_error(path, src, error_diagnostics(checked.diagnostics)))
    at: canvas_event_module(path, src, checked.modules) ?? return Err(edit_error("check", "Canvas could not find this file among its checked modules"))
    Ok(CheckedSource{modules: checked.modules, at: at, index: checked.index})
}

error_diagnostics: fn(diagnostics: [Diagnostic]) -> [Diagnostic] Never! {
    errors := [Diagnostic]{}
    loop at in 0..<diagnostics.len() {
        if diagnostics[at].severity == DIAGNOSTIC_ERROR -> errors.push(diagnostics[at])
    }
    errors
}

checked_func_for_graph: fn(checker: LSPChecker, path: String, src: String, graph_id: String) -> CanvasFunc Err! {
    name_span: graph_id_name_span(graph_id) ?? return Err(edit_error("bad_request", "Canvas graph id is not a function graph"))
    checked: checked_source(checker, path, src)
    found: find_func_by_name_span(checked.modules[checked.at].items, name_span) ?? return Err(edit_error("not_found", "Canvas graph no longer exists"))
    Ok(found)
}

checked_func_containing_span: fn(checker: LSPChecker, path: String, src: String, span: Span) -> CanvasFunc Err! {
    checked: checked_source(checker, path, src)
    found: find_func_containing_span(checked.modules[checked.at].items, span) ?? return Err(edit_error("not_found", "Canvas source node no longer belongs to a function"))
    Ok(found)
}

canvas_func: fn(function: Func) -> CanvasFunc Never! {
    return_type := String?{None}
    if function.return_type == .Val(ty) -> return_type = Val(type_name(ty))
    CanvasFunc{name: function.name, name_span: function.name_span, span: canvas_func_span(function), body: function.body, return_type: return_type}
}

canvas_func_span: fn(function: Func) -> Span Never! {
    start: if function.span.start < function.name_span.start -> function.span.start else -> function.name_span.start
    Span{start: start, end: function.span.end}
}

find_func_by_name_span: fn(items: [Item], name_span: Span) -> CanvasFunc? Never! {
    loop item in items {
        if item == .Func(function) {
            if same_span(function.name_span, name_span) -> return Val(canvas_func(function))
        } else if item == .Struct(structure) {
            loop method in structure.methods {
                if same_span(method.name_span, name_span) -> return Val(canvas_func(method))
            }
        } else if item == .Impl(implementation) {
            loop method in implementation.methods {
                if same_span(method.name_span, name_span) -> return Val(canvas_func(method))
            }
        } else if item == .CodeModule(code) {
            if code.body == .Val(body) {
                if find_func_by_name_span(body, name_span) == .Val(found) -> return Val(found)
            }
        }
    }
    None
}

find_func_containing_span: fn(items: [Item], span: Span) -> CanvasFunc? Never! {
    loop item in items {
        if item == .Func(function) {
            if span_within(span, canvas_func_span(function)) -> return Val(canvas_func(function))
        } else if item == .Struct(structure) {
            loop method in structure.methods {
                if span_within(span, canvas_func_span(method)) -> return Val(canvas_func(method))
            }
        } else if item == .Impl(implementation) {
            loop method in implementation.methods {
                if span_within(span, canvas_func_span(method)) -> return Val(canvas_func(method))
            }
        } else if item == .CodeModule(code) {
            if code.body == .Val(body) {
                if find_func_containing_span(body, span) == .Val(found) -> return Val(found)
            }
        }
    }
    None
}

// ---- Statement spans ----

collect_statement_locs: fn(src: String, stmts: [Stmt], block: &[Int], out: &[StatementLoc]) Never! {
    loop (at, stmt) in stmts {
        path: loop step in block -> step
        out.push(StatementLoc{anchor: stmt_execution_anchor(stmt), source: stmt_source_span(stmt), full: stmt_text_span(src, stmt), block: path, index: at, is_guard: stmt_is_switch(stmt), is_expr: stmt_is_expr(stmt), guard_span: stmt_guard_span(stmt)})
        block.push(at)
        stmt_each_branch(stmt, fn(branch: Int, body: [Stmt]) { collect_branch_locs(src, body, block, out, branch) })
        _: block.pop()
    }
}

collect_branch_locs: fn(src: String, body: [Stmt], block: &[Int], out: &[StatementLoc], branch: Int) Never! {
    block.push(branch)
    collect_statement_locs(src, body, block, out)
    _: block.pop()
}

stmt_is_switch: fn(stmt: Stmt) -> Bool Never! {
    if stmt == .Switch(_, _, _, _) -> return true
    if stmt == .ComptimeSwitch(_, _, _, _) -> return true
    false
}

stmt_is_expr: fn(stmt: Stmt) -> Bool Never! {
    if stmt == .Expr(_) -> return true
    false
}

stmt_guard_span: fn(stmt: Stmt) -> Span? Never! {
    if stmt == .Switch(_, arms, _, _) {
        if arms.len() > 0 -> return Val(expr_span(arms[0].cond))
    }
    if stmt == .ComptimeSwitch(_, arms, _, _) {
        if arms.len() > 0 -> return Val(expr_span(arms[0].cond))
    }
    None
}

// The whole lines a statement's source takes.
stmt_text_span: fn(src: String, stmt: Stmt) -> Span Never! {
    span: if stmt == .Expr(expression) -> source_expression_span(src, expression) else -> stmt_source_span(stmt)
    Span{start: line_start(src, span.start), end: line_after(src, span.end)}
}

stmt_source_span: fn(stmt: Stmt) -> Span Never! {
    if stmt == .Val(binding) -> return Span{start: binding.name_span.start, end: expr_span(binding.init).end}
    if stmt == .Assign(target, _, _, value) -> return Span{start: lvalue_span(target).start, end: expr_span(value).end}
    if stmt == .Expr(expression) -> return expr_span(expression)
    if stmt == .Return(value, span) {
        if value == .Val(expression) -> return Span{start: span.start, end: expr_span(expression).end}
    }
    if stmt == .BreakValue(value, span) -> return Span{start: span.start, end: expr_span(value).end}
    if stmt == .BreakLabelValue(_, _, value, span) -> return Span{start: span.start, end: expr_span(value).end}
    jfmt_stmt_span(stmt)
}

// An expression's source from its first through its last byte: a call
// through its closing parenthesis, a `?` included.
source_expression_span: fn(src: String, expression: Expr) -> Span Never! {
    span: expr_span(expression)
    start := span.start
    end := span.end
    if expression == .Call(call, _) {
        start = call.name_span.start
        end = call_source_end(src, call.name_span.end, span.end)
    } else if expression == .MethodCall(receiver, _, method_span, _, _, _, _) {
        start = source_expression_span(src, receiver).start
        end = call_source_end(src, method_span.end, span.end)
    } else if expression == .Try(value, try_span, _, _, _) {
        inner: source_expression_span(src, value)
        start = inner.start
        end = if inner.end > try_span.end -> inner.end else -> try_span.end
        bytes: src.bytes()
        if end < bytes.len() && (Int{bytes[end]}) == 63 -> end += 1
    } else if expression == .OrFallback(value, _, _, _, _) {
        start = source_expression_span(src, value).start
    }
    Span{start: start, end: if end > start -> end else -> start}
}

call_source_end: fn(src: String, name_end: Int, fallback_end: Int) -> Int Never! {
    open: find_unquoted_byte(src, name_end, 40) ?? return fallback_end
    close: matching_delimiter(src, open, 40, 41) ?? return fallback_end
    close + 1
}

// Each statement body directly inside `stmt`.
stmt_each_body: fn(stmt: Stmt, visit: fn([Stmt]) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if stmt == {
        .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .CountedLoop(_, _, _, body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) | .Defer(body, _) -> visit(body)
        .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
            loop arm in arms -> visit(arm.body)
            if else_body == .Val(body) -> visit(body)
        }
        .ComptimeIf(_, _, then_body, else_body, _, _) -> {
            visit(then_body)
            if else_body == .Val(body) -> visit(body)
        }
        .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Yield(_, _) | .DeferClose(_, _) -> {}
    }
}

// Each statement body directly inside `stmt` with its branch number: 0 for a
// single body, the arm's position or the arm count for `else`, 0 and 1 for
// a comptime if's then and else.
stmt_each_branch: fn(stmt: Stmt, visit: fn(Int, [Stmt]) -[Mem.Alloc, Mem.Rc, Time.Wait]> Never!) Never! {
    if stmt == {
        .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .CountedLoop(_, _, _, body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) | .Defer(body, _) -> visit(0, body)
        .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
            loop (at, arm) in arms -> visit(at, arm.body)
            if else_body == .Val(body) -> visit(arms.len(), body)
        }
        .ComptimeIf(_, _, then_body, else_body, _, _) -> {
            visit(0, then_body)
            if else_body == .Val(body) -> visit(1, body)
        }
        .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Yield(_, _) | .DeferClose(_, _) -> {}
    }
}

// ---- Spans and source bytes ----

same_span: fn(left: Span, right: Span) -> Bool Never! {
    left.start == right.start && left.end == right.end
}

span_within: fn(inner: Span, outer: Span) -> Bool Never! {
    inner.start >= outer.start && inner.end <= outer.end
}

spans_cross: fn(left: Span, right: Span) -> Bool Never! {
    left.start < right.end && right.start < left.end
}

// The first `wanted` byte at or after `start` outside quotes and `//` comments.
find_unquoted_byte: fn(src: String, start: Int, wanted: Int) -> Int? Never! {
    bytes: src.bytes()
    quote := 0
    escaped := false
    comment := false
    cursor := if start < 0 -> 0 else -> start
    loop cursor < bytes.len() {
        byte: Int{bytes[cursor]}
        following: if cursor + 1 < bytes.len() -> Int{bytes[cursor + 1]} else -> 0
        if comment {
            if byte == 10 -> comment = false
        } else if quote != 0 {
            if escaped {
                escaped = false
            } else if byte == 92 {
                escaped = true
            } else if byte == quote {
                quote = 0
            }
        } else if byte == 34 || byte == 39 {
            quote = byte
        } else if byte == 47 && following == 47 {
            comment = true
            cursor += 1
        } else if byte == wanted {
            return Val(cursor)
        }
        cursor += 1
    }
    None
}

// The `closing` byte that balances the `opening` byte at `open`.
matching_delimiter: fn(src: String, open: Int, opening: Int, closing: Int) -> Int? Never! {
    bytes: src.bytes()
    depth := 0
    quote := 0
    escaped := false
    comment := false
    cursor := if open < 0 -> 0 else -> open
    loop cursor < bytes.len() {
        byte: Int{bytes[cursor]}
        following: if cursor + 1 < bytes.len() -> Int{bytes[cursor + 1]} else -> 0
        if comment {
            if byte == 10 -> comment = false
        } else if quote != 0 {
            if escaped {
                escaped = false
            } else if byte == 92 {
                escaped = true
            } else if byte == quote {
                quote = 0
            }
        } else if byte == 34 || byte == 39 {
            quote = byte
        } else if byte == 47 && following == 47 {
            comment = true
            cursor += 1
        } else if byte == opening {
            depth += 1
        } else if byte == closing {
            if depth > 0 -> depth -= 1
            if depth == 0 -> return Val(cursor)
        }
        cursor += 1
    }
    None
}

// The first `word` at or after `start` that is not part of a longer name.
find_word: fn(src: String, start: Int, word: String) -> Int? Never! {
    bytes: src.bytes()
    cursor := if start < 0 -> 0 else -> start
    loop cursor < bytes.len() {
        relative: src.slice(cursor, bytes.len()).index_of(word) ?? return None
        found: cursor + relative
        after: found + word.len()
        before_ok: found == 0 || !ident_byte(Int{bytes[found - 1]}, false)
        after_ok: after >= bytes.len() || !ident_byte(Int{bytes[after]}, false)
        if before_ok && after_ok -> return Val(found)
        cursor = after
    }
    None
}
