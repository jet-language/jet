fn source_snippet(src: String, span: SourceSpan) -> String { src.get(span.start..span.end).unwrap_or_default().to_string() }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2736
fn formatted_expression_matches(left: String, right: String) -> Bool {
    wrap := (expr: String) -> {
        trimmed := expr.trim() // #4303
        candidate := "fn canvas_match() -> {{\n    {trimmed}\n}}\n"
        jet_driver.Formatter.format_source(candidate).unwrap_or_else((_) -> candidate.clone())
    }
    l := wrap(left); r := wrap(right)
    l == r || normalized_source_shape(l) == normalized_source_shape(r)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2746
fn normalized_source_shape(source: String) -> String {
    normalized := String.with_capacity(source.len()); quote: Char? := .None; escaped := false
    for ch in source.chars() {
        if quote == .Val(quoted) {
            normalized.push(ch)
            if escaped { escaped = false } else if ch == '\\' { escaped = true } else if ch == quoted { quote = .None }
        } else if ch == '"' || ch == '\'' { quote = .Val(ch); normalized.push(ch) }
        else if !ch.is_whitespace() { normalized.push(ch) }
    }
    normalized
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2770
fn function_name_exists(bundle: &ProgramBundle, name: String) -> Bool {
    // Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2771
    fn in_items(items: &[Item], name: String) -> Bool {
        items.iter().any((item) -> if item == {
            .Func(func) -> func.name == name,
            .Struct(structure) -> structure.methods.iter().any((method) -> method.name == name),
            .Impl(implementation) -> implementation.methods.iter().any((method) -> method.name == name),
            .CodeModule(module) -> module.body.as_deref().is_some_and((body) -> in_items(body, name)), _ -> false
        })
    }
    bundle.modules.iter().any((module) -> in_items(module.items, name))
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2792
fn apply_add_pattern_arm(path: &OSPath, src: String, graph_id: String, node_span: SourceSpan, pattern: String) -> String Err! {
    func := checked_func_for_graph(path, src, graph_id)?
    head := normalize_pattern_arm_head(pattern)
    if head.is_empty() -> return .Err(edit_error("bad_request", "pattern arm text is empty"))
    target: PatternTarget? := .None
    find_pattern_target(src, func.body, node_span, &target)
    selected := target ?? return .Err(edit_error("not_found", "Canvas pattern node no longer exists"))
    body := fresh_arm_body(func)
    changed := if selected == {
        .Classic { arm, else_body, span } -> add_arm_to_classic_switch(src, arm, else_body, span, head, body)?,
        .Switch { arms, else_body, span, .. } -> {
            insert := if arms.last() == .Val(last) { line_after(src, last.span.end) }
                else if else_body == .Val(else_body) { line_start(src, first_stmt_start(else_body).unwrap_or(span.end)) }
                else { dispatch_body_insert_offset(src, span) }
            indent := indentation_at(src, insert)
            arm := "{indent}{head} -> {{\n{indent}    {body}\n{indent}}}\n"
            FixEngine.apply_edits(src, [edit(SourceSpan { start: insert, end: insert }, arm)]) ?? return .Err(edit_error("overlap", "Canvas pattern arm insert overlapped"))
        }
    }
    write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2854
fn apply_edit_pattern_arm(path: &OSPath, src: String, graph_id: String, pattern_span: SourceSpan, pattern: String) -> String Err! {
    func := checked_func_for_graph(path, src, graph_id)?
    head := normalize_pattern_arm_head(pattern)
    if head.is_empty() -> return .Err(edit_error("bad_request", "pattern arm text is empty"))
    if !pattern_span_belongs_to_graph(src, func.body, pattern_span) -> return .Err(edit_error("not_found", "Canvas pattern arm no longer exists"))
    changed := FixEngine.apply_edits(src, [edit(pattern_span, head)]) ?? return .Err(edit_error("overlap", "Canvas pattern arm edit overlapped"))
    write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2877
fn apply_remove_pattern_arm(path: &OSPath, src: String, graph_id: String, pattern_span: SourceSpan) -> String Err! {
    func := checked_func_for_graph(path, src, graph_id)?
    arm: RemoveArmInfo? := .None
    find_pattern_arm_remove_span(src, func.body, pattern_span, &arm)
    info := arm ?? return .Err(edit_error("not_found", "Canvas pattern arm no longer exists"))
    if info.only_arm_without_else -> return .Err(edit_error("bad_request", "can't remove the last pattern arm; the branch would have no path left"))
    changed := FixEngine.apply_edits(src, [edit(info.remove_span, "")]) ?? return .Err(edit_error("overlap", "Canvas pattern arm delete overlapped"))
    write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2903
fn apply_toggle_switch_state(path: &OSPath, src: String, graph_id: String, node_span: SourceSpan) -> String Err! {
    func := checked_func_for_graph(path, src, graph_id)?
    if find_switched_node(func.body, node_span) == {
        .Val(.Marker(marker_span)) -> {
            changed := FixEngine.apply_edits(src, [edit(marker_span, "")]) ?? return .Err(edit_error("overlap", "Canvas statement-state toggle overlapped"))
            write_checked_formatted(path, src, changed)
        },
        .Val(.Nested) -> .Err(edit_error("bad_request", "Canvas node is already inside a statement state")),
        .None if !statement_contains_span(func.body, node_span) || same_span(func.name_span.into(), node_span) -> .Err(edit_error("not_found", "Canvas statement node no longer exists")),
        .None -> {
            insert := line_start(src, node_span.start)
            changed := FixEngine.apply_edits(src, [edit(SourceSpan { start: insert, end: insert }, "#Off ")]) ?? return .Err(edit_error("overlap", "Canvas statement-state toggle overlapped"))
            write_checked_formatted(path, src, changed)
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2946
enum SwitchedNode { Marker(SourceSpan); Nested }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2951
fn find_switched_node(stmts: &[Stmt], node_span: SourceSpan) -> SwitchedNode? {
    for stmt in stmts {
        if stmt == {
            .Switched { marker, body, span } -> {
                switched_span: SourceSpan := span.into()
                if same_span(switched_span, node_span) -> return .Val(.Marker(marker.span.into()))
                if span_within(node_span, switched_span) -> return .Val(.Nested)
                if find_switched_node(body, node_span) == .Val(found) -> return .Val(found)
            },
            _ -> { if find_switched_node_in_children(stmt, node_span) == .Val(found) -> return .Val(found) }
        }
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2976
fn find_switched_node_in_children(stmt: &Stmt, node_span: SourceSpan) -> SwitchedNode? {
    if stmt == {
        .While { body, .. } | .For { body, .. } | .Loop { body, .. } | .Unsafe { body, .. } |
        .Impure { body, .. } | .Reactive { body, .. } | .Shield { body, .. } | .Region { body, .. } |
        .Policy { body, .. } | .TaskGroup { body, .. } | .Layout { body, .. } | .AuthorityScope { body, .. } |
        .ComptimeBlock { body, .. } | .ContextBlock { body, .. } | .Live { body, .. } | .AssumeDet { body, .. } |
        .Transact { body, .. } | .ScopeMember { body, .. } -> find_switched_node(body, node_span),
        .CountedLoop { step, body, .. } -> step.as_deref().and_then((step) -> find_switched_node(std.slice.from_ref(step), node_span)).or_else(() -> find_switched_node(body, node_span)),
        .Switch { arms, else_body, .. } | .ComptimeSwitch { arms, else_body, .. } -> {
            for arm in arms { if find_switched_node(arm.body, node_span) == .Val(found) -> return .Val(found) }
            else_body.as_deref().and_then((body) -> find_switched_node(body, node_span))
        },
        .ComptimeIf { then_body, else_body, .. } -> find_switched_node(then_body, node_span).or_else(() -> else_body.as_deref().and_then((body) -> find_switched_node(body, node_span))),
        _ -> .None
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3028
fn statement_contains_span(stmts: &[Stmt], node_span: SourceSpan) -> Bool { stmts.iter().any((stmt) -> span_within(node_span, stmt.span().into())) }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3034
fn apply_append_multi_input(path: &OSPath, src: String, node_span: SourceSpan, element: String) -> String Err! {
    target: MultiInputTarget? := .None
    func := checked_func_containing_span(path, src, node_span)?
    find_multi_input_target(func.body, node_span, &target)
    selected := target ?? return .Err(edit_error("not_found", "Canvas multi-input node no longer exists"))
    (span, item_spans) := if selected == { .List { span, item_spans } -> (span, item_spans) }
    list_source := src.get(span.start..span.end).ok_or_else(() -> edit_error("bad_request", "Canvas multi-input source span is stale"))?
    insert := if item_spans.last() == .Val(item) { item.end } else {
        list_source.rfind(']').map((idx) -> span.start + idx).ok_or_else(() -> edit_error("bad_request", "Canvas multi-input source span is stale"))?
    }
    prefix := if item_spans.is_empty() -> "" else ", "
    changed := FixEngine.apply_edits(src, [edit(SourceSpan { start: insert, end: insert }, "{prefix}{element}")]) ?? return .Err(edit_error("overlap", "Canvas multi-input append overlapped"))
    write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3078
fn apply_remove_multi_input_element(path: &OSPath, src: String, node_span: SourceSpan, element_span: SourceSpan) -> String Err! {
    func := checked_func_containing_span(path, src, node_span)?
    if !multi_input_element_belongs_to_graph(func.body, node_span, element_span) -> return .Err(edit_error("not_found", "Canvas multi-input element no longer exists"))
    remove := comma_separated_remove_span(src, node_span, element_span)?
    changed := FixEngine.apply_edits(src, [edit(remove, "")]) ?? return .Err(edit_error("overlap", "Canvas multi-input delete overlapped"))
    write_checked_formatted(path, src, changed)
}
