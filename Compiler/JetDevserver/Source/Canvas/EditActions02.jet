fn normalize_pattern_arm_head(pattern: String) -> String {
    trimmed := pattern.trim() // #4303
    head := trimmed.strip_prefix("==").map((s) -> s.trim()).unwrap_or(trimmed).trim_end_matches("->").trim() // #4303
    head.to_string()
}
