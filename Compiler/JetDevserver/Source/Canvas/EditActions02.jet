use jet_devserver.Canvas.EditActions.*
use jet_parser.AST.[Stmt, Expr, Item, ProgramBundle, LValue]
use jet_foundation.[SourceSpan, Severity]
use jet_driver.Driver.[check_file]
use jet_fixer.FixEngine.[FixEngine]
use jet_semindex.[SymbolKind]
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1815
struct StatementLoc { anchor: SourceSpan; source: SourceSpan; full: SourceSpan; block: [USize]; index: USize; is_guard: Bool; is_expr: Bool; guard_span: SourceSpan? }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1826
fn apply_reorder_statements(path: &OSPath, src: String, graph_id: String, moved: SourceSpan, anchor: SourceSpan, position: String) -> String Err! {
    name_span := graph_id_name_span(graph_id) ?? return .Err(edit_error("bad_request", "Canvas graph id is not a function graph"))
    (diags, checked) := check_file(path.to_string_lossy(), .None, true)
    errors := diags.iter().filter((d) -> d.severity == Severity.Error).cloned().collect()
    if !errors.is_empty() -> return .Err(diagnostics_error(path, src, errors))
    bundle := checked ?? return .Err(edit_error("check", "Canvas could not read checked statement facts"))
    func := find_func_by_name_span(bundle, name_span) ?? return .Err(edit_error("not_found", "Canvas graph no longer exists"))
    locs: [StatementLoc] := []; block: [USize] := []
    collect_statement_locs(src, func.body, &block, &locs)
    moved_loc := locs.iter().find((loc) -> same_span(loc.anchor, moved)).cloned() ?? return .Err(edit_error("not_found", "Canvas step to move no longer exists"))
    anchor_loc := locs.iter().find((loc) -> same_span(loc.anchor, anchor)).cloned() ?? return .Err(edit_error("not_found", "Canvas anchor step no longer exists"))
    if moved_loc.block != anchor_loc.block -> return .Err(edit_error("bad_request", "can't move a step into a different branch yet"))
    if moved_loc.index == anchor_loc.index -> return .Ok(edit_ok(false, path))
    if moved_loc.full.start <= anchor_loc.full.start && anchor_loc.full.start < moved_loc.full.end -> return .Err(edit_error("bad_request", "can't anchor a step inside the moved source yet"))
    insert := if position == { "before" -> anchor_loc.full.start, "after" -> anchor_loc.full.end,
        _ -> return .Err(edit_error("bad_request", "Canvas reorder position must be before or after")) }
    chunk := src.get(moved_loc.full.start..moved_loc.full.end).ok_or_else(() -> edit_error("bad_request", "Canvas moved source span is stale"))?.to_string()
    changed := String.with_capacity(src.len())
    changed.push_str(src[..moved_loc.full.start]); changed.push_str(src[moved_loc.full.end..])
    insert_at := insert
    if insert_at > moved_loc.full.start -> insert_at = insert_at.saturating_sub(moved_loc.full.end - moved_loc.full.start)
    insert_at = insert_at.min(changed.len())
    changed.insert_str(insert_at, chunk)
    write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:1928
fn apply_exec_convergence(path: &OSPath, src: String, graph_id: String, from_span: SourceSpan, target_span: SourceSpan, from_pin_name: String, strategy: String, function: String, helper_name: String?) -> String Err! {
    validate_ident(function)?
    if !["extract", "helper", "duplicate"].contains(strategy) -> return .Err(edit_error("bad_request", "Canvas convergence strategy must be extract, helper, or duplicate"))
    if same_span(from_span, target_span) -> return .Err(edit_error("bad_request", "Canvas convergence needs two different source pins"))
    func := checked_func_for_graph(path, src, graph_id)?
    target := find_expression_selection(func.body, target_span, src) ?? return .Err(edit_error("not_found", "Canvas convergence target source selection no longer exists"))
    target_view := src.get(target.span.start..target.span.end).ok_or_else(() -> edit_error("bad_request", "Canvas convergence target span is stale"))?.trim() // #4303
    target_text := target_view.to_string()
    if target_text.is_empty() -> return .Err(edit_error("ambiguous", "Canvas needs one or more complete ordinary source statements to converge"))
    insertion := find_exec_insertion(src, func.body, from_span, from_pin_name)? ?? return .Err(edit_error("not_found", "Canvas convergence source path no longer exists"))
    if insertion.branch && target.span.start >= insertion.owner.end -> return .Err(edit_error("structured_join", "This source already has a structured join after the branch; keep the downstream step single"))
    params := convergence_params(path, target.span)?
    args := params.iter().map((param) -> param.0.as_str()).collect().join(", ")
    call_name := if strategy == "helper" -> helper_name.unwrap_or(function) else function
    call := "{call_name}({args})"
    incoming_source := if strategy == "duplicate" -> target_text.clone() else call.clone()
    bundle := checked_bundle(path, src)?
    exact_helper := exact_body_helper_name(bundle, src, target_text, func.name)
    edits := []
    insertion_text := "{insertion.indent}{incoming_source}\n"
    edits.push(edit(SourceSpan { start: insertion.offset, end: insertion.offset }, insertion_text))
    if strategy == {
        "helper" -> {
            name := helper_name.filter((name) -> !name.is_empty()) ?? return .Err(edit_error("bad_request", "Canvas exact-body helper choice has no helper name"))
            validate_ident(name)?
            if exact_helper.as_deref() != .Val(name) -> return .Err(edit_error("stale", "The selected helper body no longer matches the converged source"))
        },
        "extract" -> {
            if function_name_exists(bundle, function) -> return .Err(edit_error("bad_request", "Canvas helper name already exists; choose another name"))
            signature := params.iter().map((param) -> "{param.0}: {param.1}").collect().join(", ")
            body := target_text.lines().map((line) -> {
                trimmed := line.trim() // #4303
                "    {trimmed}\n"
            }).collect<String>()
            helper := "fn {function}({signature}) -> {{\n{body}}}\n\n"
            edits.push(edit(SourceSpan { start: 0, end: 0 }, helper))
        },
        "duplicate" -> {},
        _ -> unreachable()
    }
    if strategy != "duplicate" {
        suffix := src.get(target.span.end..target.full.end).ok_or_else(() -> edit_error("bad_request", "Canvas convergence target line is stale"))?
        replacement := "{indentation_at(src, target.full.start)}{call}{suffix}"
        edits.push(edit(target.full, replacement))
    }
    changed := FixEngine.apply_edits(src, edits) ?? return .Err(edit_error("overlap", "Canvas convergence source edits overlapped"))
    write_checked_formatted(path, src, changed)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2072
fn convergence_params(path: &OSPath, target: SourceSpan) -> [(String, String)] Err! {
    index := jet_semindex.open(path) ?? return .Err(edit_error("check", "Canvas could not resolve convergence captures: {err}"))
    references := index.references().iter().filter((reference) -> reference.span.start >= target.start && reference.span.end <= target.end).collect()
    references.sort_by_key((reference) -> (reference.span.start, reference.span.end))
    params: [(String, String)] := []
    for reference in references {
        target_def := reference.target.as_ref() ?? continue
        definition := index.definitions().iter().find((definition) -> definition.module_path == target_def.module_path && definition.def_span == target_def.def_span) ?? continue
        ty := if definition.kind == {
            .Local { ty: .Val(ty), .. } | .Param { ty } -> ty.clone(),
            .Local { ty: .None, .. } -> return .Err(edit_error("ambiguous", "Canvas could not preserve a convergence capture type")),
            _ -> continue
        }
        if !params.iter().any((param) -> param.0 == reference.name) -> params.push((reference.name.clone(), ty))
    }
    .Ok(params)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2118
struct ExpressionSelection { span: SourceSpan; full: SourceSpan }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2124
struct ExecInsertion { offset: USize; indent: String; owner: SourceSpan; branch: Bool }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2131
fn find_expression_selection(stmts: &[Stmt], target: SourceSpan, src: String) -> ExpressionSelection? {
    if find_expression_selection_in_block(stmts, target, src) == .Val(found) -> return .Val(found)
    for stmt in stmts {
        if find_expression_selection_in_children(stmt, target, src) == .Val(found) -> return .Val(found)
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2147
fn find_expression_selection_in_block(stmts: &[Stmt], target: SourceSpan, src: String) -> ExpressionSelection? {
    first: USize? := .None; last: USize? := .None
    for (index, stmt) in stmts.iter().enumerate() {
        expr := if stmt == { .Expr(expr) -> expr, _ -> continue }
        anchor: SourceSpan := expr.span().into()
        expr_span := source_expression_span(src, expr)
        if same_span(anchor, target) || same_span(expr_span, target) || span_contains(expr_span, target) || span_contains(target, expr_span) || source_spans_overlap(expr_span, target) {
            _ :: first.get_or_insert(index); last = .Val(index)
        }
    }
    begin := first?; end := last?
    selected: [SourceSpan] := [].with_capacity(end - begin + 1)
    for stmt in stmts[begin..=end] {
        expr := if stmt == { .Expr(expr) -> expr, _ -> return .None }
        selected.push(source_expression_span(src, expr))
    }
    span := SourceSpan { start: selected.first()?.start, end: selected.last()?.end }
    if selected.len() > 1 && (span.start < target.start || span.end > target.end) -> return .None
    .Val(ExpressionSelection { span: span, full: SourceSpan { start: line_start(src, span.start), end: line_after(src, span.end) } })
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2196
fn source_expression_span(src: String, expr: &Expr) -> SourceSpan {
    start := if expr == {
        .Call(call) -> call.name_span.start, .MethodCall { receiver, .. } -> source_expression_span(src, receiver).start,
        .Try(inner, ..) | .OrFallback { value: inner, .. } -> source_expression_span(src, inner).start,
        .Paren(_, span) -> span.start, _ -> expr.span().start
    }
    fallback_end := expr.span().end
    end := if expr == {
        .Call(call) -> call_source_end(src, call.name_span.end, fallback_end),
        .MethodCall { method_span, .. } -> call_source_end(src, method_span.end, fallback_end),
        .Try(inner, span, ..) -> {
            end := source_expression_span(src, inner).end.max(span.end)
            if src.as_bytes().get(end) == .Val('?' as U8) -> end += 1
            end
        },
        _ -> fallback_end
    }
    SourceSpan { start: start, end: end.max(start) }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2226
fn call_source_end(src: String, name_end: USize, fallback_end: USize) -> USize {
    open := find_unquoted_char(src, name_end, '(') ?? return fallback_end
    matching_delimiter(src, open, '(', ')').map_or(fallback_end, (close) -> close.saturating_add(1))
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2233
fn span_contains(outer: SourceSpan, inner: SourceSpan) -> Bool { inner.start >= outer.start && inner.end <= outer.end }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2237
fn source_spans_overlap(a: SourceSpan, b: SourceSpan) -> Bool { a.start < b.end && b.start < a.end }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2241
fn find_expression_selection_in_children(stmt: &Stmt, target: SourceSpan, src: String) -> ExpressionSelection? {
    if stmt == {
        .While { body, .. } | .For { body, .. } | .Loop { body, .. } | .CountedLoop { body, .. } | .Unsafe { body, .. } |
        .Impure { body, .. } | .Reactive { body, .. } | .Shield { body, .. } | .Switched { body, .. } |
        .Region { body, .. } | .Policy { body, .. } | .TaskGroup { body, .. } | .Layout { body, .. } |
        .AuthorityScope { body, .. } | .ComptimeBlock { body, .. } | .ContextBlock { body, .. } |
        .Live { body, .. } | .AssumeDet { body, .. } | .Transact { body, .. } | .ScopeMember { body, .. } -> find_expression_selection(body, target, src),
        .Switch { arms, else_body, .. } | .ComptimeSwitch { arms, else_body, .. } ->
            arms.iter().find_map((arm) -> find_expression_selection(arm.body, target, src)).or_else(() -> else_body.as_deref().and_then((body) -> find_expression_selection(body, target, src))),
        .ComptimeIf { then_body, else_body, .. } -> find_expression_selection(then_body, target, src).or_else(() -> else_body.as_deref().and_then((body) -> find_expression_selection(body, target, src))),
        _ -> .None
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2293
fn find_exec_insertion(src: String, stmts: &[Stmt], node_span: SourceSpan, pin_name: String) -> ExecInsertion? Err! {
    for stmt in stmts {
        if exec_branch_node_matches(stmt, node_span) {
            body := matching_exec_branch(stmt, node_span, pin_name).ok_or_else(() -> edit_error("ambiguous", "Canvas convergence pin has no source-backed branch body"))?
            owner := branch_source_span(src, stmt)
            return branch_exec_insertion(src, body, owner).map((value) -> .Val(value))
        }
        source := stmt_source_span(stmt)
        anchor: SourceSpan := stmt_canvas_anchor(stmt).into()
        if same_span(source, node_span) || same_span(anchor, node_span) {
            if execution_terminates(stmt) -> return .Err(edit_error("ambiguous", "Canvas cannot add a convergence step after an early exit"))
            full := stmt_text_span(src, stmt)
            return .Ok(.Val(ExecInsertion { offset: full.end, indent: indentation_at(src, full.start), owner: full, branch: false }))
        }
        if find_exec_insertion_in_children(src, stmt, node_span, pin_name)? == .Val(found) -> return .Ok(.Val(found))
    }
    .Ok(.None)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2334
fn exec_branch_node_matches(stmt: &Stmt, node_span: SourceSpan) -> Bool {
    if stmt == {
        .Switch { arms, span, .. } | .ComptimeSwitch { arms, span, .. } -> same_span(span.into(), node_span) || arms.iter().any((arm) -> same_span(arm.cond.span().into(), node_span)),
        .ComptimeIf { span, .. } -> same_span(span.into(), node_span), _ -> false
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2347
fn branch_source_span(src: String, stmt: &Stmt) -> SourceSpan {
    line := line_start(src, stmt.span().start)
    keyword := find_word(src, line, "if").unwrap_or(stmt.span().start)
    open := find_unquoted_char(src, keyword, '{') ?? return stmt.span().into()
    close := matching_delimiter(src, open, '{', '}').unwrap_or(stmt.span().end)
    loop {
        else_start := find_word(src, close + 1, "else") ?? break
        between := src[close + 1..else_start]
        if !between.chars().all((c) -> c.is_whitespace()) -> break
        next_open := find_unquoted_char(src, else_start + "else".len(), '{') ?? break
        next_close := matching_delimiter(src, next_open, '{', '}') ?? break
        close = next_close
    }
    SourceSpan { start: keyword, end: close.saturating_add(1) }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2376
fn find_word(src: String, start: USize, word: String) -> USize? {
    cursor := start.min(src.len())
    loop {
        relative := src[cursor..].find(word) ?? break
        found := cursor + relative
        before := found.checked_sub(1).and_then((i) -> src.as_bytes().get(i))
        after := src.as_bytes().get(found + word.len())
        if !before.is_some_and((b) -> b.is_ascii_alphanumeric()) && !before.is_some_and((b) -> b == '_' as U8) &&
            !after.is_some_and((b) -> b.is_ascii_alphanumeric()) && !after.is_some_and((b) -> b == '_' as U8) -> return .Val(found)
        cursor = found + word.len()
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2394
fn find_unquoted_char(src: String, start: USize, wanted: Char) -> USize? {
    quote: Char? := .None; escaped := false; line_comment := false; cursor := start.min(src.len())
    while cursor < src.len() {
        ch := src[cursor..].chars().next()?
        width := ch.len_utf8(); next := src[cursor + width..].chars().next()
        if line_comment { if ch == '\n' -> line_comment = false }
        else if quote == .Val(quoted) {
            if escaped { escaped = false } else if ch == '\\' { escaped = true } else if ch == quoted { quote = .None }
        } else if ch == '"' || ch == '\'' { quote = .Val(ch) }
        else if ch == '/' && next == .Val('/') { line_comment = true; cursor += width }
        else if ch == wanted { return .Val(cursor) }
        cursor += width
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2428
fn matching_delimiter(src: String, open: USize, opening: Char, closing: Char) -> USize? {
    depth: USize := 0; quote: Char? := .None; escaped := false; line_comment := false; cursor := open.min(src.len())
    while cursor < src.len() {
        ch := src[cursor..].chars().next()?
        width := ch.len_utf8(); next := src[cursor + width..].chars().next()
        if line_comment { if ch == '\n' -> line_comment = false }
        else if quote == .Val(quoted) {
            if escaped { escaped = false } else if ch == '\\' { escaped = true } else if ch == quoted { quote = .None }
        } else if ch == '"' || ch == '\'' { quote = .Val(ch) }
        else if ch == '/' && next == .Val('/') { line_comment = true; cursor += width }
        else if ch == opening { depth += 1 }
        else if ch == closing { depth = depth.saturating_sub(1); if depth == 0 -> return .Val(cursor) }
        cursor += width
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2468
fn find_exec_insertion_in_children(src: String, stmt: &Stmt, node_span: SourceSpan, pin_name: String) -> ExecInsertion? Err! {
    if stmt == {
        .While { body, .. } | .For { body, .. } | .Loop { body, .. } | .CountedLoop { body, .. } | .Unsafe { body, .. } |
        .Impure { body, .. } | .Reactive { body, .. } | .Shield { body, .. } | .Switched { body, .. } |
        .Region { body, .. } | .Policy { body, .. } | .TaskGroup { body, .. } | .Layout { body, .. } |
        .AuthorityScope { body, .. } | .ComptimeBlock { body, .. } | .ContextBlock { body, .. } |
        .Live { body, .. } | .AssumeDet { body, .. } | .Transact { body, .. } | .ScopeMember { body, .. } -> find_exec_insertion(src, body, node_span, pin_name),
        .Switch { arms, else_body, .. } | .ComptimeSwitch { arms, else_body, .. } -> {
            for arm in arms {
                if find_exec_insertion(src, arm.body, node_span, pin_name)? == .Val(found) -> return .Ok(.Val(found))
            }
            else_body.as_deref().map((body) -> find_exec_insertion(src, body, node_span, pin_name)).transpose().map((found) -> found.flatten())
        },
        .ComptimeIf { then_body, else_body, .. } -> {
            if find_exec_insertion(src, then_body, node_span, pin_name)? == .Val(found) -> return .Ok(.Val(found))
            else_body.as_deref().map((body) -> find_exec_insertion(src, body, node_span, pin_name)).transpose().map((found) -> found.flatten())
        },
        _ -> .Ok(.None)
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2530
fn matching_exec_branch(stmt: &Stmt, node_span: SourceSpan, pin_name: String) -> &[Stmt]? {
    if stmt == .ComptimeIf { then_body, else_body, span, .. } {
        if !same_span(span.into(), node_span) -> return .None
        return if pin_name == { "then" -> .Val(then_body.as_slice()), "else" -> else_body.as_deref(), _ -> .None }
    }
    (arms, else_body, span) := if stmt == {
        .Switch { arms, else_body, span, .. } | .ComptimeSwitch { arms, else_body, span, .. } -> (arms, else_body, span),
        _ -> return .None
    }
    node_matches := same_span(span.into(), node_span) || arms.iter().any((arm) -> same_span(arm.cond.span().into(), node_span))
    if !node_matches -> return .None
    if pin_name == "else" -> return else_body.as_deref()
    if pin_name == "then" -> return arms.first().map((arm) -> arm.body.as_slice())
    index := pin_name.strip_prefix("arm")?.parse<USize>().ok()?
    arms.get(index.checked_sub(1)?).map((arm) -> arm.body.as_slice())
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2584
fn branch_exec_insertion(src: String, body: &[Stmt], owner: SourceSpan) -> ExecInsertion Err! {
    last := body.last().ok_or_else(() -> edit_error("ambiguous", "Canvas needs a non-empty source-backed branch body to converge"))?
    structured := if last == { .While { .. } | .For { .. } | .Loop { .. } | .CountedLoop { .. } | .Switch { .. } | .ComptimeSwitch { .. } | .ComptimeIf { .. } -> true, _ -> false }
    if execution_terminates(last) || structured -> return .Err(edit_error("ambiguous", "Canvas cannot prove a convergence path after this branch body"))
    full := stmt_text_span(src, last)
    inline := full.end > owner.end
    (offset, indent) := if inline {
        last_end := if last == { .Expr(expr) -> source_expression_span(src, expr).end, _ -> stmt_source_span(last).end }
        close := find_unquoted_char(src, last_end, '}').filter((offset) -> offset < owner.end).ok_or_else(() -> edit_error("ambiguous", "Canvas could not locate the source-backed branch body boundary"))?
        (close, "\n{indentation_at(src, owner.start)}    ")
    } else { (full.end, indentation_at(src, full.start)) }
    .Ok(ExecInsertion { offset: offset, indent: indent, owner: owner, branch: true })
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2642
fn execution_terminates(stmt: &Stmt) -> Bool {
    if stmt == { .Return(..) | .Break(..) | .BreakValue(..) | .BreakLabel(..) | .BreakLabelValue(..) | .Continue(..) | .ContinueLabel(..) -> true, _ -> false }
}

// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2655
fn exact_body_helper_name(bundle: &ProgramBundle, src: String, target: String, current: String) -> String? {
    // Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2661
    fn in_items(items: &[Item], src: String, target: String, current: String) -> String? {
        for item in items {
            if item == {
                .Func(func) if func.name != current -> {
                    if expression_body_source(src, func.body).is_some_and((body) -> formatted_expression_matches(body, target)) -> return .Val(func.name.clone())
                },
                .Struct(structure) -> {
                    if structure.methods.iter().find_map((method) -> {
                        if method.name == current -> return .None
                        expression_body_source(src, method.body).and_then((body) -> if formatted_expression_matches(body, target) -> .Val(method.name.clone()) else .None)
                    }) == .Val(found) -> return .Val(found)
                },
                .Impl(implementation) -> {
                    if implementation.methods.iter().find_map((method) -> {
                        if method.name == current -> return .None
                        expression_body_source(src, method.body).and_then((body) -> if formatted_expression_matches(body, target) -> .Val(method.name.clone()) else .None)
                    }) == .Val(found) -> return .Val(found)
                },
                .CodeModule(module) -> {
                    if module.body == .Val(body) && in_items(body, src, target, current) == .Val(found) -> return .Val(found)
                },
                _ -> {}
            }
        }
        .None
    }
    bundle.modules.iter().find_map((module) -> in_items(module.items, src, target, current))
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:2713
fn expression_body_source(src: String, body: &[Stmt]) -> String? {
    spans: [SourceSpan] := [].with_capacity(body.len())
    for stmt in body {
        expr := if stmt == { .Expr(expr) -> expr, _ -> return .None }
        spans.push(source_expression_span(src, expr))
    }
    start := spans.first()?.start; end := spans.last()?.end
    text := source_snippet(src, SourceSpan { start: start, end: end }).trim() // #4303
    .Val(text.to_string())
}
