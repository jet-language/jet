// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3142
fn checked_bundle(path: &OSPath, src: String) -> &ProgramBundle Err! {
    (diags, checked) := check_file(path.to_string_lossy(), .None, true)
    errors := diags.iter().filter((d) -> d.severity == .Error).cloned().collect()
    if !errors.is_empty() -> return .Err(diagnostics_error(path, src, errors))
    bundle := checked ?? return .Err(edit_error("check", "Canvas could not read checked pattern facts"))
    .Ok(std.box.Box.leak(std.box.Box.new(bundle))) // GATE #4494: retained checked AST allocation.
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3162
enum PatternTarget {
    Classic { arm: &jet_parser.AST.SwitchArm; else_body: &[Stmt]?; span: SourceSpan }
    Switch { arms: &[jet_parser.AST.SwitchArm]; else_body: &[Stmt]?; span: SourceSpan }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3175
fn find_pattern_target(src: String, stmts: &[Stmt], node_span: SourceSpan, out: &PatternTarget?) -> {
    if out.is_some() -> return
    for stmt in stmts {
        if stmt == {
            .Switch { subject, arms, else_body, span, .. } -> {
                classic := jet_parser.AST.is_subjectless_guard(subject, span) && arms.first().is_some_and((arm) -> jet_parser.AST.uses_classic_if_spelling(src, span, arm.cond.span()))
                if classic {
                    if arms.first() == .Val(arm) {
                        pattern_test := if arm.cond == { .PatternTest { .. } -> true, _ -> false }
                        if (same_span(arm.cond.span().into(), node_span) || same_span(span.into(), node_span)) && pattern_test {
                            out = .Val(.Classic { arm: arm, else_body: else_body.as_ref(), span: stmt_text_span(src, stmt) }); return
                        }
                    }
                } else if same_span(span.into(), node_span) {
                    out = .Val(.Switch { arms: arms, else_body: else_body.as_ref(), span: span.into() }); return
                }
                for arm in arms -> find_pattern_target(src, arm.body, node_span, out)
                if else_body == .Val(body) -> find_pattern_target(src, body, node_span, out)
            },
            .ComptimeSwitch { arms, else_body, span, .. } -> {
                if same_span(span.into(), node_span) {
                    out = .Val(.Switch { arms: arms, else_body: else_body.as_ref(), span: span.into() }); return
                }
                for arm in arms -> find_pattern_target(src, arm.body, node_span, out)
                if else_body == .Val(body) -> find_pattern_target(src, body, node_span, out)
            },
            _ -> find_pattern_target_in_children(src, stmt, node_span, out)
        }
    }
}

// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3252
fn find_pattern_target_in_children(src: String, stmt: &Stmt, node_span: SourceSpan, out: &PatternTarget?) -> {
    if stmt == {
        .While { body, .. } | .For { body, .. } | .Loop { body, .. } | .CountedLoop { body, .. } | .Unsafe { body, .. } |
        .Impure { body, .. } | .Reactive { body, .. } | .Shield { body, .. } | .Switched { body, .. } |
        .Region { body, .. } | .Policy { body, .. } | .TaskGroup { body, .. } | .Layout { body, .. } |
        .AuthorityScope { body, .. } | .ComptimeBlock { body, .. } | .ContextBlock { body, .. } |
        .Live { body, .. } | .AssumeDet { body, .. } | .Transact { body, .. } | .ScopeMember { body, .. } -> find_pattern_target(src, body, node_span, out),
        .ComptimeIf { then_body, else_body, .. } -> {
            find_pattern_target(src, then_body, node_span, out)
            if else_body == .Val(body) -> find_pattern_target(src, body, node_span, out)
        },
        _ -> {}
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3293
struct RemoveArmInfo { remove_span: SourceSpan; only_arm_without_else: Bool }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3298
fn find_pattern_arm_remove_span(src: String, stmts: &[Stmt], pattern_span: SourceSpan, out: &RemoveArmInfo?) -> {
    if out.is_some() -> return
    for stmt in stmts {
        if stmt == {
            .Switch { subject, arms, else_body, span } -> {
                for arm in arms {
                    classic := jet_parser.AST.is_subjectless_guard(subject, span) && jet_parser.AST.uses_classic_if_spelling(src, span, arm.cond.span())
                    if same_span(switch_arm_edit_span(src, subject, span, arm), pattern_span) {
                        out = .Val(RemoveArmInfo { remove_span: if classic -> stmt_text_span(src, stmt) else stmt_arm_text_span(src, arm),
                            only_arm_without_else: classic || (arms.len() == 1 && else_body.is_none()) }); return
                    }
                    find_pattern_arm_remove_span(src, arm.body, pattern_span, out)
                }
                if else_body == .Val(body) -> find_pattern_arm_remove_span(src, body, pattern_span, out)
            },
            .ComptimeSwitch { arms, else_body, .. } -> {
                for arm in arms {
                    if same_span(arm.cond.span().into(), pattern_span) {
                        out = .Val(RemoveArmInfo { remove_span: stmt_arm_text_span(src, arm), only_arm_without_else: arms.len() == 1 && else_body.is_none() }); return
                    }
                    find_pattern_arm_remove_span(src, arm.body, pattern_span, out)
                }
                if else_body == .Val(body) -> find_pattern_arm_remove_span(src, body, pattern_span, out)
            },
            _ -> find_pattern_arm_remove_span_in_children(src, stmt, pattern_span, out)
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3358
fn find_pattern_arm_remove_span_in_children(src: String, stmt: &Stmt, pattern_span: SourceSpan, out: &RemoveArmInfo?) -> {
    if stmt == {
        .While { body, .. } | .For { body, .. } | .Loop { body, .. } | .CountedLoop { body, .. } | .Unsafe { body, .. } |
        .Impure { body, .. } | .Reactive { body, .. } | .Shield { body, .. } | .Switched { body, .. } |
        .Region { body, .. } | .Policy { body, .. } | .TaskGroup { body, .. } | .Layout { body, .. } |
        .AuthorityScope { body, .. } | .ComptimeBlock { body, .. } | .ContextBlock { body, .. } |
        .Live { body, .. } | .AssumeDet { body, .. } | .Transact { body, .. } | .ScopeMember { body, .. } -> find_pattern_arm_remove_span(src, body, pattern_span, out),
        .ComptimeIf { then_body, else_body, .. } -> {
            find_pattern_arm_remove_span(src, then_body, pattern_span, out)
            if else_body == .Val(body) -> find_pattern_arm_remove_span(src, body, pattern_span, out)
        },
        _ -> {}
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3401
fn pattern_span_belongs_to_graph(src: String, stmts: &[Stmt], pattern_span: SourceSpan) -> Bool {
    found := false; find_pattern_span(src, stmts, pattern_span, &found); found
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3407
fn find_pattern_span(src: String, stmts: &[Stmt], pattern_span: SourceSpan, found: &Bool) -> {
    if found -> return
    for stmt in stmts {
        if stmt == {
            .Switch { subject, arms, else_body, span } -> {
                for arm in arms {
                    if same_span(switch_arm_edit_span(src, subject, span, arm), pattern_span) { found = true; return }
                    find_pattern_span(src, arm.body, pattern_span, found)
                }
                if else_body == .Val(body) -> find_pattern_span(src, body, pattern_span, found)
            },
            .ComptimeSwitch { arms, else_body, .. } -> {
                for arm in arms {
                    if same_span(arm.cond.span().into(), pattern_span) { found = true; return }
                    find_pattern_span(src, arm.body, pattern_span, found)
                }
                if else_body == .Val(body) -> find_pattern_span(src, body, pattern_span, found)
            },
            _ -> find_pattern_span_in_children(src, stmt, pattern_span, found)
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3449
fn find_pattern_span_in_children(src: String, stmt: &Stmt, pattern_span: SourceSpan, found: &Bool) -> {
    if stmt == {
        .While { body, .. } | .For { body, .. } | .Loop { body, .. } | .CountedLoop { body, .. } | .Unsafe { body, .. } |
        .Impure { body, .. } | .Reactive { body, .. } | .Shield { body, .. } | .Switched { body, .. } |
        .Region { body, .. } | .Policy { body, .. } | .TaskGroup { body, .. } | .Layout { body, .. } |
        .AuthorityScope { body, .. } | .ComptimeBlock { body, .. } | .ContextBlock { body, .. } |
        .Live { body, .. } | .AssumeDet { body, .. } | .Transact { body, .. } | .ScopeMember { body, .. } -> find_pattern_span(src, body, pattern_span, found),
        .ComptimeIf { then_body, else_body, .. } -> {
            find_pattern_span(src, then_body, pattern_span, found)
            if else_body == .Val(body) -> find_pattern_span(src, body, pattern_span, found)
        },
        _ -> {}
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3490
enum MultiInputTarget { List { span: SourceSpan; item_spans: [SourceSpan] } }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3497
fn find_multi_input_target(stmts: &[Stmt], node_span: SourceSpan, out: &MultiInputTarget?) -> {
    if out.is_some() -> return
    for stmt in stmts -> find_multi_input_in_stmt(stmt, node_span, out)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3510
fn find_multi_input_in_stmt(stmt: &Stmt, node_span: SourceSpan, out: &MultiInputTarget?) -> {
    if out.is_some() -> return
    if stmt == {
        .Val(b) -> find_multi_input_in_expr(b.init, node_span, out),
        .Assign { target, value, .. } -> { find_multi_input_in_lvalue(target, node_span, out); find_multi_input_in_expr(value, node_span, out) },
        .Expr(e) | .BreakValue(e, _) | .BreakLabelValue(_, _, e, _) | .Return(.Val(e), _) | .Yield(e, _) -> find_multi_input_in_expr(e, node_span, out),
        .DeferClose { close, .. } -> find_multi_input_in_expr(close, node_span, out),
        .Switch { subject, arms, else_body, .. } | .ComptimeSwitch { subject, arms, else_body, .. } -> {
            find_multi_input_in_expr(subject, node_span, out)
            for arm in arms { find_multi_input_in_expr(arm.cond, node_span, out); find_multi_input_target(arm.body, node_span, out) }
            if else_body == .Val(body) -> find_multi_input_target(body, node_span, out)
        },
        .While { cond, body, .. } -> { find_multi_input_in_expr(cond, node_span, out); find_multi_input_target(body, node_span, out) },
        .For { kind, body, .. } -> {
            if kind == {
                .Range { start, end, step, exclusive: _ } -> {
                    find_multi_input_in_expr(start, node_span, out); find_multi_input_in_expr(end, node_span, out)
                    if step == .Val(step) -> find_multi_input_in_expr(step, node_span, out)
                },
                .In { collection, step } -> {
                    find_multi_input_in_expr(collection, node_span, out)
                    if step == .Val(step) -> find_multi_input_in_expr(step, node_span, out)
                }
            }
            find_multi_input_target(body, node_span, out)
        },
        .CountedLoop { init, cond, step, body, .. } -> {
            find_multi_input_in_expr(init.init, node_span, out); find_multi_input_in_expr(cond, node_span, out)
            if step == .Val(step) -> find_multi_input_in_stmt(step, node_span, out)
            find_multi_input_target(body, node_span, out)
        },
        .Loop { body, .. } | .Unsafe { body, .. } | .Impure { body, .. } | .Reactive { body, .. } |
        .Shield { body, .. } | .Switched { body, .. } | .Region { body, .. } | .Policy { body, .. } |
        .TaskGroup { body, .. } | .Layout { body, .. } | .AuthorityScope { body, .. } | .ComptimeBlock { body, .. } |
        .ContextBlock { body, .. } | .Live { body, .. } | .AssumeDet { body, .. } | .Transact { body, .. } |
        .ScopeMember { body, .. } -> find_multi_input_target(body, node_span, out),
        .ComptimeIf { cond, then_body, else_body, .. } -> {
            find_multi_input_in_expr(cond, node_span, out); find_multi_input_target(then_body, node_span, out)
            if else_body == .Val(body) -> find_multi_input_target(body, node_span, out)
        },
        .Return(.None, _) | .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3629
fn find_multi_input_in_lvalue(target: &LValue, node_span: SourceSpan, out: &MultiInputTarget?) -> {
    if target == {
        .Index { base, index, .. } -> { find_multi_input_in_expr(base, node_span, out); find_multi_input_in_expr(index, node_span, out) },
        .Field { base, .. } -> find_multi_input_in_expr(base, node_span, out), _ -> {}
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3644
fn find_multi_input_in_expr(expr: &Expr, node_span: SourceSpan, out: &MultiInputTarget?) -> {
    if out.is_some() -> return
    if expr == {
        .ListLit(items, span) if same_span(span.into(), node_span) -> out = .Val(.List { span: span.into(), item_spans: items.iter().map((item) -> item.span().into()).collect() }),
        _ -> walk_expr_children_for_multi_input(expr, node_span, out)
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3663
fn walk_expr_children_for_multi_input(expr: &Expr, node_span: SourceSpan, out: &MultiInputTarget?) -> {
    if expr == {
        .Call(c) -> { for arg in c.args -> find_multi_input_in_expr(arg.expr, node_span, out) },
        .MethodCall { receiver, args, .. } -> {
            find_multi_input_in_expr(receiver, node_span, out)
            for arg in args -> find_multi_input_in_expr(arg.expr, node_span, out)
        },
        .ListLit(items, _) -> { for item in items -> find_multi_input_in_expr(item, node_span, out) },
        .Index { base, index, .. } -> { find_multi_input_in_expr(base, node_span, out); find_multi_input_in_expr(index, node_span, out) },
        .Slice { base, start, end, range, .. } -> {
            find_multi_input_in_expr(base, node_span, out)
            if range == .Val(range) { find_multi_input_in_expr(range, node_span, out) }
            else { find_multi_input_in_expr(start, node_span, out); find_multi_input_in_expr(end, node_span, out) }
        },
        .MapLit(items, _) -> {
            for (key, value) in items { find_multi_input_in_expr(key, node_span, out); find_multi_input_in_expr(value, node_span, out) }
        },
        .Binary(_, left, right, _) -> { find_multi_input_in_expr(left, node_span, out); find_multi_input_in_expr(right, node_span, out) },
        .Unary(_, expr, _) | .Try(expr, ..) | .Present(expr, _) | .Ok(expr, _) | .Err(expr, _) |
        .Paren(expr, _) | .Copy(expr, _) | .Field(expr, _, _) | .RawOf(expr, _) | .Tainted(expr, _, _) -> find_multi_input_in_expr(expr, node_span, out),
        .PatternTest { subject, .. } -> find_multi_input_in_expr(subject, node_span, out),
        .If { cond, then_body, then_value, else_body, else_value, .. } -> {
            find_multi_input_in_expr(cond, node_span, out); find_multi_input_target(then_body, node_span, out)
            find_multi_input_in_expr(then_value, node_span, out); find_multi_input_target(else_body, node_span, out)
            find_multi_input_in_expr(else_value, node_span, out)
        },
        .TupleLit(items, _, _) -> { for (_, item) in items -> find_multi_input_in_expr(item, node_span, out) },
        .StructLit { fields, .. } -> { for (_, _, value) in fields -> find_multi_input_in_expr(value, node_span, out) },
        .EnumLit { args, .. } -> {
            for arg in args {
                if arg == { .Positional(expr) | .Named { expr, .. } -> find_multi_input_in_expr(expr, node_span, out) }
            }
        },
        _ -> {}
    }
}

// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3765
fn multi_input_element_belongs_to_graph(stmts: &[Stmt], node_span: SourceSpan, element_span: SourceSpan) -> Bool {
    target: MultiInputTarget? := .None; find_multi_input_target(stmts, node_span, &target)
    if target == { .Val(.List { item_spans, .. }) -> item_spans.iter().any((item_span) -> same_span(item_span, element_span)), .None -> false }
}
