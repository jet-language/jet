}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3890
fn comma_separated_remove_span(src: String, container: SourceSpan, element: SourceSpan) -> SourceSpan Err! {
    container_text := src.get(container.start..container.end) ?? return .Err(edit_error("bad_request", "Canvas multi-input span is stale"))
    rel_start := element.start.saturating_sub(container.start); rel_end := element.end.saturating_sub(container.start)
    before := container_text[..rel_start.min(container_text.len())]; after := container_text[rel_end.min(container_text.len())..]
    if after.find(',') == .Val(pos) {
        end := element.end + pos + 1
        return .Ok(SourceSpan { start: element.start, end: consume_trailing_space(src, end, container.end) })
    }
    if before.rfind(',') == .Val(pos) {
        start := container.start + consume_leading_space_back(before, pos)
        return .Ok(SourceSpan { start: start, end: element.end })
    }
    .Ok(element)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3922
fn consume_trailing_space(src: String, offset: USize, limit: USize) -> USize {
    while offset < limit && src.as_bytes().get(offset).is_some_and((b) -> b.is_ascii_whitespace()) -> offset += 1
    offset
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3934
fn consume_leading_space_back(before: String, comma: USize) -> USize {
    start := comma
    while start > 0 && before.as_bytes()[start - 1].is_ascii_whitespace() -> start -= 1
    start
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3942
fn find_func_containing_span(items: &[Item], span: SourceSpan) -> &jet_parser.AST.Func? {
    for item in items {
        if item == {
            .Func(f) if span_within(span, func_source_span(f)) -> return .Val(f),
            .Struct(s) -> { for method in s.methods { if span_within(span, func_source_span(method)) -> return .Val(method) } },
            .Impl(i) -> { for method in i.methods { if span_within(span, func_source_span(method)) -> return .Val(method) } },
            .CodeModule(m) -> { if m.body == .Val(body) && find_func_containing_span(body, span) == .Val(found) -> return .Val(found) },
            _ -> {}
        }
    }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3973
fn span_within(inner: SourceSpan, outer: SourceSpan) -> Bool { inner.start >= outer.start && inner.end <= outer.end }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3977
fn find_func_by_name_span(bundle: &ProgramBundle, name_span: SourceSpan) -> &jet_parser.AST.Func? {
    // Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3981
    fn find_in_items(items: &[Item], name_span: SourceSpan) -> &jet_parser.AST.Func? {
        for item in items {
            if item == {
                .Func(f) if same_span(f.name_span.into(), name_span) -> return .Val(f),
                .Struct(s) -> { for method in s.methods { if same_span(method.name_span.into(), name_span) -> return .Val(method) } },
                .Impl(i) -> { for method in i.methods { if same_span(method.name_span.into(), name_span) -> return .Val(method) } },
                .CodeModule(m) -> { if m.body == .Val(body) && find_in_items(body, name_span) == .Val(found) -> return .Val(found) },
                _ -> {}
            }
        }
        .None
    }
    for module in bundle.modules { if find_in_items(module.items, name_span) == .Val(found) -> return .Val(found) }
    .None
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:4019
fn collect_statement_locs(src: String, stmts: &[Stmt], block: &[USize], out: &[StatementLoc]) -> {
    for (index, stmt) in stmts.iter().enumerate() {
        out.push(StatementLoc { anchor: stmt_canvas_anchor(stmt).into(), source: stmt_source_span(stmt), full: stmt_text_span(src, stmt),
            block: block.clone(), index: index,
            is_guard: if stmt == { .Switch { .. } | .ComptimeSwitch { .. } -> true, _ -> false },
            is_expr: if stmt == { .Expr(_) -> true, _ -> false },
            guard_span: if stmt == { .Switch { arms, .. } | .ComptimeSwitch { arms, .. } -> arms.first().map((arm) -> arm.cond.span().into()), _ -> .None } })
        block.push(index); collect_child_statement_locs(src, stmt, block, out); _ :: block.pop()
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:4047
fn collect_child_statement_locs(src: String, stmt: &Stmt, block: &[USize], out: &[StatementLoc]) -> {
    if stmt == {
        .While { body, .. } | .For { body, .. } | .Loop { body, .. } | .CountedLoop { body, .. } | .Unsafe { body, .. } |
        .Impure { body, .. } | .Reactive { body, .. } | .Shield { body, .. } | .Switched { body, .. } |
        .Region { body, .. } | .Policy { body, .. } | .TaskGroup { body, .. } | .Layout { body, .. } |
        .AuthorityScope { body, .. } | .ComptimeBlock { body, .. } | .ContextBlock { body, .. } |
        .Live { body, .. } | .AssumeDet { body, .. } | .Transact { body, .. } | .ScopeMember { body, .. } -> {
            block.push(0); collect_statement_locs(src, body, block, out); _ :: block.pop()
        },
        .Switch { arms, else_body, .. } | .ComptimeSwitch { arms, else_body, .. } -> {
            for (i, arm) in arms.iter().enumerate() { block.push(i); collect_statement_locs(src, arm.body, block, out); _ :: block.pop() }
            if else_body == .Val(body) { block.push(arms.len()); collect_statement_locs(src, body, block, out); _ :: block.pop() }
        },
        .ComptimeIf { then_body, else_body, .. } -> {
            block.push(0); collect_statement_locs(src, then_body, block, out); _ :: block.pop()
            if else_body == .Val(body) { block.push(1); collect_statement_locs(src, body, block, out); _ :: block.pop() }
        },
        _ -> {}
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:4113
fn stmt_canvas_anchor(stmt: &Stmt) -> jet_foundation.Span {
    if stmt == {
        .Val(b) -> b.name_span, .Assign { target, .. } -> target.span(), .Expr(e) -> e.span(),
        .Return(_, span) | .Break(span) | .Continue(span) | .BreakLabel(_, span) | .ContinueLabel(_, span) |
        .BreakValue(_, span) | .BreakLabelValue(_, _, _, span) -> span, _ -> stmt.span()
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:4128
fn stmt_text_span(src: String, stmt: &Stmt) -> SourceSpan {
    span := if stmt == { .Expr(expr) -> source_expression_span(src, expr), _ -> stmt_source_span(stmt) }
    SourceSpan { start: line_start(src, span.start), end: line_after(src, span.end) }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:4139
fn stmt_source_span(stmt: &Stmt) -> SourceSpan {
    if stmt == {
        .Val(b) -> SourceSpan { start: b.name_span.start, end: b.init.span().end },
        .Assign { target, value, .. } -> SourceSpan { start: target.span().start, end: value.span().end },
        .Expr(e) -> e.span().into(),
        .Return(.Val(e), span) | .BreakValue(e, span) | .BreakLabelValue(_, _, e, span) -> SourceSpan { start: span.start, end: e.span().end },
        _ -> stmt.span().into()
    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:4162
fn same_span(a: SourceSpan, b: SourceSpan) -> Bool { a.start == b.start && a.end == b.end }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:4166
fn write_checked_formatted(path: &OSPath, before: String, candidate: String) -> String Err! {
    formatted := jet_driver.Formatter.format_source(candidate) ?? return .Err(diagnostics_error(path, candidate, err))
    write_checked_candidate(path, before, formatted)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:4176
fn write_checked_source(path: &OSPath, before: String, candidate: String) -> String Err! { write_checked_candidate(path, before, candidate) }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:4184
fn write_checked_candidate(path: &OSPath, before: String, candidate: String) -> String Err! {
    abs := canonical_path(path)
    (diags, _, _) := jet_driver.Driver.check_file_with_effect_facts(path.to_string_lossy(), .Val((abs, candidate)), true)
    errors := diags.iter().filter((d) -> d.severity == .Error).cloned().collect()
    if !errors.is_empty() -> return .Err(diagnostics_error(path, candidate, errors))
    changed := candidate != before
    if changed {
        write_source_if_unchanged(path, before, candidate).map_err((error) -> if error == {
            .Conflict -> {
                current_revision := read_source_without_symlinks(path).map((source) -> source_revision(source)).unwrap_or_else((_) -> "missing".to_string())
                edit_conflict("source changed while this Canvas edit was prepared", current_revision)
            },
            .Io(error) -> edit_error("io", error.to_string())
        })? // GATE #4494: atomic retained-descriptor source writer.
    }
    .Ok(edit_ok_source(changed, candidate))
}

