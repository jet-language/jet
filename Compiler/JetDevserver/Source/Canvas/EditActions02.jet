    }
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3798
fn switch_arm_edit_span(src: String, subject: &Expr, switch_span: jet_foundation.Span, arm: &jet_parser.AST.SwitchArm) -> SourceSpan {
    if jet_parser.AST.is_subjectless_guard(subject, switch_span) && jet_parser.AST.uses_classic_if_spelling(src, switch_span, arm.cond.span()) {
        if arm.cond == .PatternTest { pattern, .. } -> return span_through_closing_parens(src, pattern.span())
    }
    arm.cond.span().into()
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3814
fn add_arm_to_classic_switch(src: String, arm: &jet_parser.AST.SwitchArm, else_body: &[Stmt]?, span: SourceSpan, new_head: String, fresh_body: String) -> String Err! {
    (subject, pattern) := if arm.cond == { .PatternTest { subject, pattern, .. } -> (subject, pattern),
        _ -> return .Err(edit_error("bad_request", "Canvas branch is not a pattern branch")) }
    subject_src := snippet(src, subject.span())
    pattern_span := span_through_closing_parens(src, pattern.span())
    head := src.get(pattern_span.start..pattern_span.end).map((s) -> s.to_owned()).unwrap_or_else(() -> snippet(src, pattern.span()))
    then_body := block_body_source(src, arm.body, 2)
    else_text := if else_body == .Val(body) {
        body_text := block_body_source(src, body, 2)
        "    else -> {{\n{body_text}    }}\n"
    } else { String.new() }
    replacement := "if {subject_src} == {{\n    {head} -> {{\n{then_body}    }}\n    {new_head} -> {{\n        {fresh_body}\n    }}\n{else_text}}}\n"
    FixEngine.apply_edits(src, [edit(span, replacement)]).map_err((_) -> edit_error("overlap", "Canvas pattern branch conversion overlapped"))
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3851
fn block_body_source(src: String, stmts: &[Stmt], levels: USize) -> String {
    if stmts.is_empty() -> return String.new()
    out := String.new(); indent := "    ".repeat(levels)
    for stmt in stmts {
        span := stmt_text_span(src, stmt)
        text := src.get(span.start..span.end).unwrap_or("").trim_matches('\n').trim() // #4303
        for line in text.lines() {
            trimmed := line.trim() // #4303
            out.push_str(indent); out.push_str(trimmed); out.push('\n')
        }
    }
    out
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3873
fn first_stmt_start(stmts: &[Stmt]) -> USize? { stmts.first().map((stmt) -> stmt.span().start) }
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3877
fn dispatch_body_insert_offset(src: String, span: SourceSpan) -> USize {
    src.get(span.start..span.end).and_then((chunk) -> chunk.find('{').map((idx) -> line_after(src, span.start + idx))).unwrap_or(span.end)
}
// Rust: crates/jet-devserver/src/Canvas/edit_actions.rs:3883
fn stmt_arm_text_span(src: String, arm: &jet_parser.AST.SwitchArm) -> SourceSpan {
