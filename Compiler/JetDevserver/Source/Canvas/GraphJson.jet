use {
    jet_foundation.[
        Expr, Func, LValue, MetaAttr, NameLedger, Span, Stmt, access_sigil, expr_span, name_ledger_declaration, type_name,
    ]
    jet_parser.[jfmt_stmt_span]
    jet_semindex.[SourceSpan]
}

add_node: fn(g: &GraphBuilder, id: String, descriptor_id: String, title: String, span: SourceSpan, x: Int, y: Int, badges: [String], affordances: [String]) {
    descriptor: descriptor_for_id(descriptor_id)
    g.nodes.push(NodeRec{id: id, kind: descriptor.kind, archetype: descriptor.archetype, title: title, span: span, x: x, y: y, badges: badges, affordances: affordances, meta_json: None})
}

node_span_of: fn(g: GraphBuilder, node_id: String) -> SourceSpan Never! {
    loop node in g.nodes {
        if node.id == node_id -> return node.span
    }
    SourceSpan{start: 0, end: 0}
}

has_pin: fn(g: GraphBuilder, id: String) -> Bool Never! {
    loop pin in g.pins {
        if pin.id == id -> return true
    }
    false
}

add_pin: fn(g: &GraphBuilder, node_id: String, name: String, direction: String, ty: String, ability: String, fallible: Bool) -> String {
    id: "{node_id}:{direction}:{name}"
    span: node_span_of(g, node_id)
    g.pins.push(PinRec{id: id, node_id: node_id, name: name, direction: direction, ty: ty, role: None, pattern_source: None, ability: ability, fallible: fallible, effect_grant_need: None, span: span, pattern_source_span: None, append_op: None, element_index: None})
    id
}

add_arm_pin: fn(g: &GraphBuilder, node_id: String, name: String, pattern_source: String, pattern_span: SourceSpan) -> String {
    id: "{node_id}:output:{name}"
    if !has_pin(g, id) {
        g.pins.push(PinRec{id: id, node_id: node_id, name: name, direction: "output", ty: "exec", role: Val("arm"), pattern_source: Val(pattern_source), ability: "control", fallible: false, effect_grant_need: None, span: pattern_span, pattern_source_span: Val(pattern_span), append_op: Val("edit_pattern_arm"), element_index: None})
    }
    id
}

set_pin_source_span: fn(g: &GraphBuilder, pin_id: String, span: SourceSpan) {
    loop i in 0..<g.pins.len() {
        if g.pins[i].id == pin_id {
            g.pins[i].span = span
            return
        }
    }
}

set_pin_append: fn(g: &GraphBuilder, pin_id: String, op: String, index: Int) {
    loop i in 0..<g.pins.len() {
        if g.pins[i].id == pin_id {
            g.pins[i].append_op = Val(op)
            g.pins[i].element_index = Val(index)
            return
        }
    }
}

add_wire: fn(g: &GraphBuilder, from_pin: String, to_pin: String, kind: String) {
    add_wire_with_span(g, from_pin, to_pin, kind, None)
}

add_wire_with_span: fn(g: &GraphBuilder, from_pin: String, to_pin: String, kind: String, span: SourceSpan?) {
    g.next_wire += 1
    g.wires.push(WireRec{id: "{g.graph_id}:wire:{g.next_wire}", from_pin: from_pin, to_pin: to_pin, kind: kind, span: span, from_span: None, to_span: None})
}

add_control_wire: fn(g: &GraphBuilder, from_pin: String, to_pin: String, from_span: SourceSpan, to_span: SourceSpan) {
    g.next_wire += 1
    g.wires.push(WireRec{id: "{g.graph_id}:wire:{g.next_wire}", from_pin: from_pin, to_pin: to_pin, kind: "control", span: Val(to_span), from_span: Val(from_span), to_span: Val(to_span)})
}

source_span_of: fn(span: Span) -> SourceSpan Never! {
    SourceSpan{start: span.start, end: span.end}
}

add_region: fn(g: &GraphBuilder, ordinal: Int, kind: String, title: String, span: Span) {
    g.regions.push("{{\"region_id\":{json_str("{g.graph_id}:region:{ordinal}:{kind}")},\"kind\":{json_str(kind)},\"title\":{json_str(title)},\"source_span\":{span_json(source_span_of(span))}}}")
}

add_authority_region: fn(g: &GraphBuilder, ordinal: Int, title: String, required_effects: [String], granted_effects: [String], denied_effects: [String], binding: String?, span: Span) {
    authority: if binding == .Val(name) -> "Authority handle `{name}`" else -> "lexical #FX authority"
    g.regions.push("{{\"region_id\":{json_str("{g.graph_id}:region:{ordinal}:authority")},\"kind\":\"authority\",\"title\":{json_str(title)},\"required_effects\":{json_strs(required_effects)},\"granted_effects\":{json_strs(granted_effects)},\"denied_effects\":{json_strs(denied_effects)},\"authority\":{json_str(authority)},\"source_span\":{span_json(source_span_of(span))}}}")
}

meta_attr_json: fn(meta: MetaAttr?) -> String? Never! {
    value: meta ?? return None
    category := String?{None}
    tunable := false
    loop field in value.fields {
        if field == {
            .Category(text, _) -> category = literal_text(text)
            .Tunable(_) -> tunable = true
            else -> {}
        }
    }
    if category == None && !tunable -> return None
    category_json: if category == .Val(text) -> json_str(text) else -> "null"
    Val("{{\"category\":{category_json},\"tunable\":{json_bool(tunable)}}}")
}

// The text of a plain string literal.
literal_text: fn(expr: Expr) -> String? Never! {
    if expr == .Str(parts, _, _) {
        text := ""
        loop part in parts {
            if part == .Lit(piece) -> text = "{text}{piece}" else -> return None
        }
        return Val(text)
    }
    None
}

add_source_comment_regions: fn(g: &GraphBuilder, src: String, f: Func) {
    func_span: func_source_span(f)
    loop hint in canvas_comment_hints(src) {
        if !hint_belongs_to_function(src, hint.anchor, hint.hint_span, func_span) -> next
        g.regions.push("{{\"region_id\":{json_str(comment_region_id(g.graph_id, hint.anchor))},\"kind\":\"comment\",\"title\":{json_str(hint.title)},\"color\":{json_str(hint.color)},\"alpha\":{json_str(hint.alpha)},\"bounds\":{{\"x\":{hint.bounds.x},\"y\":{hint.bounds.y},\"w\":{hint.bounds.w},\"h\":{hint.bounds.h}}},\"source_span\":{span_json(hint.anchor)},\"hint_span\":{span_json(hint.hint_span)}}}")
    }
    loop hint in canvas_collapse_hints(src) {
        if !hint_belongs_to_function(src, hint.anchor, hint.hint_span, func_span) -> next
        g.regions.push("{{\"region_id\":{json_str(collapse_region_id(g.graph_id, hint.anchor))},\"kind\":\"collapse\",\"title\":{json_str(hint.title)},\"source_span\":{span_json(hint.anchor)},\"hint_span\":{span_json(hint.hint_span)}}}")
    }
}

hint_belongs_to_function: fn(src: String, anchor: SourceSpan, hint_span: SourceSpan, func_span: SourceSpan) -> Bool Never! {
    if span_overlaps(anchor, func_span) || span_overlaps(hint_span, func_span) -> return true
    if hint_span.start < func_span.end -> return false
    hint_span.start < next_function_start(src, func_span.end)
}

// The offset of the next `name: fn` declaration line at or after `offset`.
next_function_start: fn(src: String, offset: Int) -> Int Never! {
    cursor := if offset < src.len() -> offset else -> src.len()
    loop cursor < src.len() {
        line_end: if src.slice(cursor, src.len()).index_of("\n") == .Val(i) -> cursor + i + 1 else -> src.len()
        line: src.slice(cursor, line_end)
        trimmed: line.trim_start()
        if trimmed.split_once(": fn") == .Val(parts) && parts.before.len() > 0 && is_identifier_text(parts.before) {
            return cursor + line.len() - trimmed.len()
        }
        cursor = line_end
    }
    src.len()
}

is_identifier_text: fn(text: String) -> Bool Never! {
    loop byte in text.bytes() {
        b: Int.from_u8(byte)
        if !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95) -> return false
    }
    true
}

add_execution_overlay: fn(g: &GraphBuilder, src: String, body: [Stmt]) {
    exec_nodes := [NodeRec]{}
    loop node in g.nodes {
        if node_wants_exec(node) -> exec_nodes.push(node)
    }
    loop node in exec_nodes {
        if node.kind != "entry" -> ensure_exec_pin(g, node.id, "exec", "input", node.span, None)
        if {
            node_has_arm_pins(g, node.id) -> ensure_exec_pin(g, node.id, "else", "output", node.span, Val("else"))
            node.kind == "loop" -> {
                ensure_exec_pin(g, node.id, "body", "output", node.span, Val("loop_body"))
                ensure_exec_pin(g, node.id, "done", "output", node.span, Val("loop_done"))
            }
            node.kind == "return" -> ensure_exec_pin(g, node.id, "return", "output", node.span, Val("early_return"))
            node.kind == "branch" || (node.kind == "function" && node.archetype == "control") -> {
                ensure_exec_pin(g, node.id, "then", "output", node.span, None)
                ensure_exec_pin(g, node.id, "else", "output", node.span, Val("else"))
            }
            else -> ensure_exec_pin(g, node.id, "then", "output", node.span, None)
        }
    }
    entry := NodeRec?{None}
    loop node in g.nodes {
        if node.kind == "entry" {
            entry = Val(node)
            break
        }
    }
    found: entry ?? return
    flow: execution_block(g, src, body)
    if flow.entry == .Val(input) -> add_control_wire_once(g, "{found.id}:output:then", input.pin, found.span, input.span)
}

node_has_arm_pins: fn(g: GraphBuilder, node_id: String) -> Bool Never! {
    loop pin in g.pins {
        if pin.node_id == node_id && pin.direction == "output" && pin.role == .Val("arm") -> return true
    }
    false
}

ExecutionEndpoint: struct {
    pin: String
    span: SourceSpan
}

ExecutionFlow: struct {
    entry: ExecutionEndpoint?
    exits: [ExecutionEndpoint]
}

empty_flow: fn() -> ExecutionFlow Never! {
    ExecutionFlow{entry: None, exits: [ExecutionEndpoint]{}}
}

execution_block: fn(g: &GraphBuilder, src: String, stmts: [Stmt]) -> ExecutionFlow {
    flow := empty_flow()
    exits := [ExecutionEndpoint]{}
    reachable := true
    loop stmt in stmts {
        if !reachable -> break
        current: execution_stmt(g, src, stmt)
        if current.entry == .Val(entry) {
            if flow.entry == None -> flow.entry = Val(entry)
            loop previous in exits -> add_control_wire_once(g, previous.pin, entry.pin, previous.span, entry.span)
            exits = current.exits
            reachable = exits.len() > 0
        } else if current.exits.len() > 0 {
            exits = current.exits
            reachable = true
        }
    }
    flow.exits = exits
    flow
}

switched_off: fn(marker_name: String) -> Bool Never! {
    marker_name == "Off" || marker_name == "DebugOnly"
}

// Wires every switch or `#If` arm to its body, and collects the arms' exits.
execution_arms: fn(g: &GraphBuilder, src: String, stmt: Stmt, arm_bodies: [[Stmt]], else_body: [Stmt]?) -> ExecutionFlow {
    node: direct_execution_node(g, stmt) ?? return empty_flow()
    exits := [ExecutionEndpoint]{}
    arm_pins: node_has_arm_pins(g, node.id)
    loop (index, body) in arm_bodies {
        output_name: if {
            arm_pins -> "arm{index + 1}"
            index == 0 -> "then"
            else -> ""
        }
        output: if output_name.len() > 0 -> exec_output(g, node.id, output_name) else -> None
        append_branch_path(g, src, output, body, node.span, exits)
    }
    else_output: exec_output(g, node.id, "else")
    if else_body == .Val(body) {
        append_branch_path(g, src, else_output, body, node.span, exits)
    } else if else_output == .Val(output) {
        exits.push(ExecutionEndpoint{pin: output, span: node.span})
    }
    ExecutionFlow{entry: exec_input(node), exits: exits}
}

execution_loop: fn(g: &GraphBuilder, src: String, stmt: Stmt, body: [Stmt]) -> ExecutionFlow {
    node: direct_execution_node(g, stmt) ?? return empty_flow()
    body_flow: execution_block(g, src, body)
    if exec_output(g, node.id, "body") == .Val(output) {
        if body_flow.entry == .Val(body_entry) -> add_control_wire_once(g, output, body_entry.pin, node.span, body_entry.span)
        loop exit in body_flow.exits -> add_control_wire_once(g, exit.pin, "{node.id}:input:exec", exit.span, node.span)
    }
    exits := [ExecutionEndpoint]{}
    if exec_output(g, node.id, "done") == .Val(pin) -> exits.push(ExecutionEndpoint{pin: pin, span: node.span})
    ExecutionFlow{entry: exec_input(node), exits: exits}
}

execution_stmt: fn(g: &GraphBuilder, src: String, stmt: Stmt) -> ExecutionFlow {
    if stmt == {
        .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
            bodies: loop arm in arms -> arm.body
            execution_arms(g, src, stmt, bodies, else_body)
        }
        .ComptimeIf(_, _, then_body, else_body, _, _) -> execution_arms(g, src, stmt, [[Stmt]]{then_body}, else_body)
        .While(_, body, _, _, _) -> execution_loop(g, src, stmt, body)
        .For(_, _, _, _, body, _, _, _, _) -> execution_loop(g, src, stmt, body)
        .Loop(body, _, _, _) -> execution_loop(g, src, stmt, body)
        .CountedLoop(_, _, _, body, _, _, _) -> execution_loop(g, src, stmt, body)
        .Switched(marker, body, _) -> if switched_off(marker.name) -> empty_flow() else -> execution_block(g, src, body)
        .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .AssumeDet(_, _, body, _) -> execution_block(g, src, body)
        .Reactive(body, _) | .Shield(body, _) | .Live(body, _) -> execution_block(g, src, body)
        .Region(_, _, body, _) | .Layout(_, _, body, _) | .Policy(_, body, _) | .ContextBlock(_, body, _) -> execution_block(g, src, body)
        .TaskGroup(_, _, _, body, _) | .AuthorityScope(_, _, _, body, _) -> execution_block(g, src, body)
        .ComptimeBlock(body, _, _) -> execution_block(g, src, body)
        .Transact(_, _, body, _, _) -> execution_block(g, src, body)
        .ScopeMember(_, _, _, _, body, _, _, _) -> execution_block(g, src, body)
        else -> {
            node: direct_execution_node(g, stmt) ?? return empty_flow()
            exits := [ExecutionEndpoint]{}
            if !stmt_is_terminal(stmt) && exec_output(g, node.id, "then") == .Val(pin) -> exits.push(ExecutionEndpoint{pin: pin, span: node.span})
            ExecutionFlow{entry: exec_input(node), exits: exits}
        }
    }
}

stmt_is_terminal: fn(stmt: Stmt) -> Bool Never! {
    if stmt == {
        .Return(_, _) | .Break(_) | .BreakValue(_, _) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .Continue(_) | .ContinueLabel(_, _) -> true
        else -> false
    }
}

append_branch_path: fn(g: &GraphBuilder, src: String, output: String?, body: [Stmt], owner_span: SourceSpan, exits: &[ExecutionEndpoint]) {
    pin: output ?? return
    body_flow: execution_block(g, src, body)
    if body_flow.entry == .Val(entry) {
        add_control_wire_once(g, pin, entry.pin, owner_span, entry.span)
        loop exit in body_flow.exits -> exits.push(exit)
    } else {
        exits.push(ExecutionEndpoint{pin: pin, span: owner_span})
    }
}

direct_execution_node: fn(g: GraphBuilder, stmt: Stmt) -> NodeRec? Never! {
    anchor: stmt_execution_anchor(stmt)
    loop node in g.nodes {
        if !node_wants_exec(node) || node.kind == "entry" -> next
        matched: if stmt == .Val(binding) -> node.kind == "binding" && node.title == binding.name && node.span.start == binding.name_span.start else -> node.span.start == anchor.start && node.span.end == anchor.end
        if matched -> return Val(node)
    }
    None
}

stmt_execution_anchor: fn(stmt: Stmt) -> SourceSpan Never! {
    if stmt == {
        .Val(binding) -> source_span_of(binding.name_span)
        .Assign(target, _, _, _) -> source_span_of(lvalue_span(target))
        .Expr(expr) -> expr_execution_anchor(expr)
        else -> source_span_of(jfmt_stmt_span(stmt))
    }
}

lvalue_span: fn(target: LValue) -> Span Never! {
    if target == {
        .Local(_, name_span) -> name_span
        .Index(_, _, span, _) -> span
        .Field(_, _, span) -> span
    }
}

expr_execution_anchor: fn(expr: Expr) -> SourceSpan Never! {
    if expr == {
        .Call(call, _) -> source_span_of(call.name_span)
        .MethodCall(_, _, method_span, _, _, _, _) -> source_span_of(method_span)
        .Try(_, span, _, _, _) -> source_span_of(span)
        .OrFallback(value, _, _, _, _) -> expr_execution_anchor(value)
        else -> source_span_of(expr_span(expr))
    }
}

exec_input: fn(node: NodeRec) -> ExecutionEndpoint? Never! {
    if node.kind == "entry" -> return None
    Val(ExecutionEndpoint{pin: "{node.id}:input:exec", span: node.span})
}

exec_output: fn(g: GraphBuilder, node_id: String, name: String) -> String? Never! {
    loop pin in g.pins {
        if pin.node_id == node_id && pin.direction == "output" && pin.name == name -> return Val(pin.id)
    }
    None
}

add_control_wire_once: fn(g: &GraphBuilder, from_pin: String, to_pin: String, from_span: SourceSpan, to_span: SourceSpan) {
    loop wire in g.wires {
        if wire.kind == "control" && wire.from_pin == from_pin && wire.to_pin == to_pin -> return
    }
    add_control_wire(g, from_pin, to_pin, from_span, to_span)
}

node_wants_exec: fn(node: NodeRec) -> Bool Never! {
    node.archetype == "entry" || node.archetype == "function_exec" || node.archetype == "control"
}

ensure_exec_pin: fn(g: &GraphBuilder, node_id: String, name: String, direction: String, span: SourceSpan, role: String?) {
    id: "{node_id}:{direction}:{name}"
    if has_pin(g, id) -> return
    g.pins.push(PinRec{id: id, node_id: node_id, name: name, direction: direction, ty: "exec", role: role, pattern_source: None, ability: "control", fallible: false, effect_grant_need: None, span: span, pattern_source_span: None, append_op: None, element_index: None})
}

func_source_span: fn(f: Func) -> SourceSpan Never! {
    source_span_of(f.span)
}

CommentHint: struct {
    anchor: SourceSpan
    hint_span: SourceSpan
    title: String
    color: String
    alpha: String
    bounds: CanvasBounds
}

// Every `// canvas:<kind>` hint line in `src`, with the span of the line.
canvas_hint_lines: fn(src: String, kind: String) -> [CommentHint] Never! {
    out := [CommentHint]{}
    offset := 0
    prefix: "// canvas:{kind}"
    loop line in src.split("\n") {
        trimmed: line.trim()
        if trimmed.starts_with(prefix) {
            body: trimmed.remove_prefix(prefix)
            anchor: attr_span(body, "span") ?? SourceSpan{start: 0, end: 0}
            hint_span: SourceSpan{start: offset, end: offset + line.len()}
            if kind == "comment" {
                out.push(CommentHint{anchor: anchor, hint_span: hint_span, title: attr_string(body, "title") ?? "Comment", color: attr_string(body, "color") ?? "#2563eb", alpha: attr_string(body, "alpha") ?? "0.18", bounds: attr_bounds(body, "bounds") ?? CanvasBounds{x: 0, y: 0, w: 360, h: 180}})
            } else {
                out.push(CommentHint{anchor: anchor, hint_span: hint_span, title: attr_string(body, "title") ?? "Collapsed", color: "#64748b", alpha: "0.16", bounds: CanvasBounds{x: 0, y: 0, w: 360, h: 120}})
            }
        }
        offset += line.len() + 1
    }
    out
}

canvas_comment_hints: fn(src: String) -> [CommentHint] Never! {
    canvas_hint_lines(src, "comment")
}

comment_region_id: fn(graph_id: String, span: SourceSpan) -> String Never! {
    "{graph_id}:comment:{span.start}-{span.end}"
}

canvas_collapse_hints: fn(src: String) -> [CommentHint] Never! {
    canvas_hint_lines(src, "collapse")
}

collapse_region_id: fn(graph_id: String, span: SourceSpan) -> String Never! {
    "{graph_id}:collapse:{span.start}-{span.end}"
}

add_inline: fn(g: &GraphBuilder, node_id: String, ordinal: Int, role: String, src: String, span: Span) {
    g.inline_exprs.push(InlineRec{id: "{g.graph_id}:inline:{ordinal}:{role}", node_id: node_id, role: role, source: snippet(src, span), span: source_span_of(span)})
}

graph_to_json: fn(g: GraphBuilder, f: Func, src: String, visibility: String) -> String Never! {
    nodes: loop node in g.nodes -> node_json(node)
    pins: loop pin in g.pins -> pin_json(pin)
    wires: loop wire in g.wires -> wire_json(wire)
    inline: loop item in g.inline_exprs -> inline_json(item)
    exit_nodes := [String]{}
    loop node in g.nodes {
        if node.kind == "return" -> exit_nodes.push(json_str(node.id))
    }
    event_views: callback_event_view_json(g.graph_id, f) ?? ""
    "{{\"graph_id\":{json_str(g.graph_id)},\"title\":{json_str(f.name)},\"function\":{function_metadata_json(src, f, visibility)},\"event_views\":[{event_views}],\"entry_node\":{json_str("{g.graph_id}:entry")},\"exit_nodes\":[{exit_nodes.join(",")}],\"nodes\":[{nodes.join(",")}],\"pins\":[{pins.join(",")}],\"wires\":[{wires.join(",")}],\"regions\":[{g.regions.join(",")}],\"inline_exprs\":[{inline.join(",")}],\"rails\":{rails_json(g)},\"layout_hints\":{{\"algorithm\":\"source-order-v1\",\"direction\":\"data-left-to-right/control-top-to-bottom\"}}}}"
}

func_return_name: fn(f: Func) -> String Never! {
    if f.return_type == .Val(ty) -> type_name(ty) else -> "Unit"
}

function_metadata_json: fn(src: String, f: Func, visibility: String) -> String Never! {
    params: loop p in f.params -> {
        default: if p.default == .Val(expr) -> json_str(snippet(src, expr_span(expr))) else -> "null"
        "{{\"name\":{json_str(p.name)},\"type\":{json_str(type_name(p.ty))},\"ability\":{json_str(access_sigil(p.convention))},\"default\":{json_bool(p.default != None)},\"default_source\":{default},\"source_span\":{span_json(source_span_of(p.name_span))}}}"
    }
    effects := [String]{}
    if f.declared_effects == .Val(entries) {
        loop entry in entries -> effects.push(json_str(entry.name))
    }
    effect_via: if f.effect_via == .Val(via) -> json_str(via.name) else -> "null"
    meta: meta_attr_json(f.meta) ?? "null"
    "{{\"name\":{json_str(f.name)},\"signature\":{json_str(function_signature_text(src, f))},\"visibility\":{json_str(visibility)},\"docs\":{json_str(doc_comment_before(src, f.name_span.start))},\"pure\":{json_bool(f.is_pure)},\"unsafe\":{json_bool(f.is_unsafe)},\"effects\":[{effects.join(",")}],\"effect_via\":{effect_via},\"returns\":{json_str(func_return_name(f))},\"params\":[{params.join(",")}],\"meta\":{meta},\"source_span\":{span_json(func_source_span(f))},\"edit_affordances\":[\"rename_function\",\"edit_function_signature\",\"create_function\",\"source_jump\"]}}"
}

ledger_function_visibility: fn(ledger: NameLedger, module_index: Int, name: String) -> String Never! {
    declaration: name_ledger_declaration(ledger, module_index, name) ?? return "private"
    if declaration.visibility == {
        .Package -> "package"
        .Public -> "public"
        .Private -> "private"
    }
}

// Declarations are public by default, so the signature carries no visibility
// marker.
function_signature_text: fn(src: String, f: Func) -> String Never! {
    params: loop p in f.params -> {
        text := "{p.name}: {type_name(p.ty)}"
        if p.default == .Val(default) -> text = "{text}{{{snippet(src, expr_span(default))}}}"
        text
    }
    out := "{f.name}: fn({params.join(", ")}) {func_return_name(f)}"
    if f.effect_via == .Val(via) {
        out = "{out} -[via {via.name}]>"
    } else if f.declared_effects == .Val(entries) {
        names: loop entry in entries -> entry.name
        out = "{out} -[{names.join(", ")}]>"
    } else if f.is_pure {
        out = "{out} -[]>"
    }
    out
}

doc_comment_before: fn(src: String, name_start: Int) -> String Never! {
    docs := [String]{}
    cursor := line_start(src, name_start)
    loop cursor > 0 {
        prev_end: cursor - 1
        prev_start: line_start(src, prev_end)
        line: src.slice(prev_start, prev_end).trim()
        if line.starts_with("///") {
            docs.push(line.remove_prefix("///").trim())
            cursor = prev_start
            next
        }
        if line.is_empty() {
            cursor = prev_start
            next
        }
        break
    }
    ordered := [String]{}
    loop i in 0..<docs.len() -> ordered.push(docs[docs.len() - 1 - i])
    ordered.join("\n")
}

callback_event_view_json: fn(graph_id: String, f: Func) -> String? Never! {
    event: callback_event_name(f.name) ?? return None
    Val("{{\"event_id\":{json_str("{graph_id}:event:{event}")},\"kind\":\"callback_event\",\"title\":{json_str(event)},\"function\":{json_str(f.name)},\"entry_node\":{json_str("{graph_id}:entry")},\"semantics\":\"ordinary_jet_function\",\"dispatch\":\"framework_callback\",\"pending_first_class_events\":\"#286\",\"source_span\":{span_json(func_source_span(f))}}}")
}

callback_event_name: fn(name: String) -> String? Never! {
    if !name.starts_with("on_") || name.len() == 3 -> return None
    Val(name.remove_prefix("on_"))
}

rails_json: fn(g: GraphBuilder) -> String Never! {
    kinds := [String]{"control"}
    if g.wires.len() > 0 || g.pins.len() > 0 -> kinds.push("data")
    fallible := false
    loop wire in g.wires {
        if wire.kind == "fallible" -> fallible = true
    }
    loop pin in g.pins {
        if pin.fallible -> fallible = true
    }
    if fallible -> kinds.push("fallible")
    async_rail := false
    effect_rail := false
    proof_rail := false
    loop region in g.regions {
        if region.contains("\"kind\":\"task.group\"") -> async_rail = true
        if region.contains("\"kind\":\"authority\"") -> effect_rail = true
        if region.contains("\"kind\":\"unsafe\"") || region.contains("\"kind\":\"comptime\"") -> proof_rail = true
    }
    loop node in g.nodes {
        if node.title == ".task" || node.title == "spawn" || node.title.ends_with(".spawn") -> async_rail = true
        loop badge in node.badges {
            if badge == "effects" -> effect_rail = true
        }
    }
    if async_rail -> kinds.push("async")
    if effect_rail -> kinds.push("effect")
    if proof_rail -> kinds.push("proof")
    kinds.push("debug")
    "{{\"kinds\":[{json_strs(kinds)}],\"debug_overlay\":\"idle\",\"source\":\"front-end facts\"}}"
}

optional_json_str: fn(value: String?) -> String Never! {
    if value == .Val(text) -> json_str(text) else -> "null"
}

optional_span_json: fn(value: SourceSpan?) -> String Never! {
    if value == .Val(span) -> span_json(span) else -> "null"
}

node_json: fn(n: NodeRec) -> String Never! {
    descriptor: descriptor_for(n.kind, n.archetype)
    meta: n.meta_json ?? "null"
    "{{\"node_id\":{json_str(n.id)},\"node_descriptor_id\":{json_str(descriptor.id)},\"kind\":{json_str(n.kind)},\"archetype\":{json_str(n.archetype)},\"title\":{json_str(n.title)},\"source_span\":{span_json(n.span)},\"layout\":{{\"x\":{n.x},\"y\":{n.y}}},\"badges\":[{json_strs(n.badges)}],\"edit_affordances\":[{json_strs(n.affordances)}],\"meta\":{meta}}}"
}

pin_json: fn(p: PinRec) -> String Never! {
    element_index: if p.element_index == .Val(index) -> "{index}" else -> "null"
    "{{\"pin_id\":{json_str(p.id)},\"node_id\":{json_str(p.node_id)},\"name\":{json_str(p.name)},\"direction\":{json_str(p.direction)},\"type\":{json_str(p.ty)},\"role\":{optional_json_str(p.role)},\"pattern_source\":{optional_json_str(p.pattern_source)},\"pattern_source_span\":{optional_span_json(p.pattern_source_span)},\"append_op\":{optional_json_str(p.append_op)},\"element_index\":{element_index},\"ability\":{json_str(p.ability)},\"fallible\":{json_bool(p.fallible)},\"effect_grant_need\":{optional_json_str(p.effect_grant_need)},\"source_span\":{span_json(p.span)}}}"
}

wire_json: fn(w: WireRec) -> String Never! {
    "{{\"wire_id\":{json_str(w.id)},\"from_pin\":{json_str(w.from_pin)},\"to_pin\":{json_str(w.to_pin)},\"wire_kind\":{json_str(w.kind)},\"source_span\":{optional_span_json(w.span)},\"from_source_span\":{optional_span_json(w.from_span)},\"to_source_span\":{optional_span_json(w.to_span)}}}"
}

inline_json: fn(i: InlineRec) -> String Never! {
    "{{\"inline_expr_id\":{json_str(i.id)},\"node_id\":{json_str(i.node_id)},\"role\":{json_str(i.role)},\"source\":{json_str(i.source)},\"source_span\":{span_json(i.span)},\"editable\":true}}"
}
