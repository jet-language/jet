// The Canvas node descriptor catalog: one row per projected node identity,
// with its presentation and palette facts and the edit transaction it inserts.

NodeDescriptor: struct {
    id: String
    kind: String
    archetype: String
    projected: Bool
    presentation: NodePresentation
    palette: NodePalette
    transaction: String?
    default_editor: String
}

NodePresentation: struct {
    label: String
    glyph: String
    hover: String
    accent: String
    header: String
    style_archetype: String
    layout_family: String
    shape: String
}

NodePalette: struct {
    visible: Bool
    insertable: Bool
    category: String
    rank: Int
    rank_terms: [String]
}

NODE_TRANSACTIONS: ["edit_inline_expr", "insert_branch", "insert_switch", "insert_loop", "insert_fallible_rail", "insert_call"]

node_presentation: fn(label: String, glyph: String, hover: String, accent: String, header: String, style_archetype: String, layout_family: String, shape: String) -> NodePresentation Never! {
    NodePresentation{label: label, glyph: glyph, hover: hover, accent: accent, header: header, style_archetype: style_archetype, layout_family: layout_family, shape: shape}
}

node_palette: fn(visible: Bool, insertable: Bool, category: String, rank: Int, rank_terms: [String]) -> NodePalette Never! {
    NodePalette{visible: visible, insertable: insertable, category: category, rank: rank, rank_terms: rank_terms}
}

node_descriptor: fn(id: String, kind: String, archetype: String, presentation: NodePresentation, palette: NodePalette, transaction: String?, default_editor: String) -> NodeDescriptor Never! {
    NodeDescriptor{id: id, kind: kind, archetype: archetype, projected: true, presentation: presentation, palette: palette, transaction: transaction, default_editor: default_editor}
}

node_descriptors: fn() -> [NodeDescriptor] Never! {
    [NodeDescriptor]{
        node_descriptor("entry", "entry", "entry", node_presentation("Entry", "ƒ", "Starts this function.", "archetype", "archetype", "entry", "entry", "node"), node_palette(false, false, "", 0, [String]{}), None, "function_signature"),
        node_descriptor("binding", "binding", "function_exec", node_presentation("Set variable", "•", "Creates a local variable.", "type", "#2c333d", "control", "normal", "node"), node_palette(false, false, "Variables", 0, ["binding", "local"]), None, "inline_expr"),
        node_descriptor("assignment", "assign", "function_exec", node_presentation("Set variable", "•", "Changes a variable.", "type", "#2c333d", "control", "normal", "node"), node_palette(false, false, "Variables", 0, ["assign", "set"]), None, "inline_expr"),
        node_descriptor("return", "return", "control", node_presentation("Control", "⏎", "Returns a value from this function.", "#7dd3a6", "archetype", "control", "exit", "node"), node_palette(false, false, "Execution", 0, ["return", "exit"]), None, "inline_expr"),
        node_descriptor("defer_close", "defer_close", "control", node_presentation("Control", "↩", "Closes this resource when the scope exits.", "archetype", "archetype", "control", "exit", "node"), node_palette(false, false, "Execution", 0, ["defer", "close", "cleanup"]), None, "inline_expr"),
        node_descriptor("branch", "branch", "control", node_presentation("Control", "◇", "Chooses which path runs next.", "archetype", "archetype", "control", "control", "node"), node_palette(true, true, "Execution", 80, ["if", "else", "branch"]), Val("insert_branch"), "inline_expr"),
        node_descriptor("dispatch", "function", "control", node_presentation("Control", "◇", "Chooses a path by matching a value.", "archetype", "archetype", "control", "control", "node"), node_palette(true, true, "Execution", 78, ["switch", "match", "dispatch"]), Val("insert_switch"), "pattern_arm"),
        node_descriptor("loop", "loop", "control", node_presentation("Control", "↻", "Repeats work.", "archetype", "archetype", "control", "control", "node"), node_palette(true, true, "Execution", 76, ["loop", "repeat", "for", "while"]), Val("insert_loop"), "inline_expr"),
        node_descriptor("flow", "flow", "control", node_presentation("Control", "◇", "Changes loop control flow.", "archetype", "archetype", "control", "control", "node"), node_palette(false, false, "Execution", 0, ["break", "continue"]), None, "none"),
        node_descriptor("yield", "yield", "function_exec", node_presentation("Function", "ƒ", "Yields a stream value.", "archetype", "archetype", "function_exec", "normal", "node"), node_palette(false, false, "Execution", 0, ["yield", "stream"]), None, "inline_expr"),
        node_descriptor("variable_get", "variable_get", "value", node_presentation("Value", "•", "Reads a variable.", "type", "type", "value", "value", "capsule"), node_palette(true, false, "Variables", 84, ["get", "read", "variable"]), None, "inline_expr"),
        node_descriptor("constant", "constant", "value", node_presentation("Literal", "•", "Uses a fixed value.", "type", "type", "value", "value", "capsule"), node_palette(false, false, "Values", 0, ["literal", "constant", "value"]), None, "inline_value"),
        node_descriptor("function_exec", "function", "function_exec", node_presentation("Function", "ƒ", "Calls a function.", "archetype", "archetype", "function_exec", "normal", "node"), node_palette(true, true, "Project", 72, ["call", "function"]), Val("insert_call"), "function_pins"),
        node_descriptor("function_pure", "function", "function_pure", node_presentation("Pure function", "ƒ", "Calls a pure function.", "archetype", "archetype", "function_pure", "normal", "node"), node_palette(true, true, "Project", 74, ["call", "pure", "function"]), Val("insert_call"), "function_pins"),
        node_descriptor("variant", "variant", "function_pure", node_presentation("Pure function", "ƒ", "Creates an enum variant.", "archetype", "archetype", "function_pure", "normal", "node"), node_palette(false, false, "Values", 0, ["enum", "variant"]), None, "function_pins"),
        node_descriptor("fallible", "fallible", "control", node_presentation("Control", "◇", "Routes a fallible result.", "archetype", "archetype", "control", "control", "node"), node_palette(true, true, "Execution", 70, ["fallible", "error", "result", "question"]), Val("insert_fallible_rail"), "fallback"),
        node_descriptor("switched", "switched", "control", node_presentation("Statement state", "◉", "Controls whether this statement runs.", "archetype", "archetype", "control", "control", "node"), node_palette(false, false, "Execution", 0, [String]{}), None, "none"),
        node_descriptor("expression", "expr", "function_pure", node_presentation("Pure function", "ƒ", "Computes a value.", "archetype", "archetype", "function_pure", "normal", "node"), node_palette(false, false, "Values", 0, ["expression", "value"]), None, "inline_expr"),
    }
}

descriptor_for: fn(kind: String, archetype: String) -> NodeDescriptor Never! {
    loop descriptor in node_descriptors() {
        if descriptor.kind == kind && descriptor.archetype == archetype -> return descriptor
    }
    panic("missing Canvas node descriptor for {kind}/{archetype}")
}

descriptor_for_id: fn(id: String) -> NodeDescriptor Never! {
    loop descriptor in node_descriptors() {
        if descriptor.id == id -> return descriptor
    }
    panic("missing Canvas node descriptor `{id}`")
}

insert_descriptor_id: fn(transaction: String, pure: Bool) -> String Never! {
    descriptor := if transaction == "insert_call" -> descriptor_for_id(if pure -> "function_pure" else -> "function_exec") else -> descriptor_for_transaction(transaction)
    if !descriptor.palette.insertable -> panic("Canvas action descriptor `{descriptor.id}` is not insertable")
    descriptor.id
}

descriptor_for_transaction: fn(transaction: String) -> NodeDescriptor Never! {
    loop descriptor in node_descriptors() {
        if descriptor.transaction == Val(transaction) -> return descriptor
    }
    panic("missing Canvas node descriptor transaction `{transaction}`")
}

palette_rank_fields: fn(id: String) -> String Never! {
    descriptor: descriptor_for_id(id)
    ",\"rank\":{descriptor.palette.rank},\"rank_terms\":[{json_strs(descriptor.palette.rank_terms)}]"
}

catalog_json: fn() -> String Never! {
    descriptors: node_descriptors()
    if node_catalog_problem(descriptors) == .Val(problem) -> panic("invalid Canvas node catalog: {problem}")
    rows := [String]{}
    loop descriptor in descriptors -> rows.push(descriptor_json(descriptor))
    "[{rows.join(",")}]"
}

// The first catalog invariant `descriptors` breaks, or None.
node_catalog_problem: fn(descriptors: [NodeDescriptor]) -> String? Never! {
    ids := [String:Bool]{}
    identities := [String:Bool]{}
    loop descriptor in descriptors {
        if descriptor.id == "" || ids.has_key(descriptor.id) -> return Val("missing or duplicate id `{descriptor.id}`")
        ids[descriptor.id] = true
        identity: "{descriptor.kind}/{descriptor.archetype}"
        if identities.has_key(identity) -> return Val("duplicate identity `{identity}`")
        identities[identity] = true
        if !descriptor.projected && !descriptor.palette.insertable -> return Val("orphaned descriptor `{descriptor.id}`")
        if descriptor.palette.insertable != (descriptor.transaction != None) -> return Val("insertable/transaction mismatch for `{descriptor.id}`")
        if descriptor.palette.insertable && (!descriptor.palette.visible || descriptor.palette.category == "") -> return Val("non-visible insertable descriptor `{descriptor.id}`")
        if descriptor.transaction == .Val(transaction) && !NODE_TRANSACTIONS.contains(transaction) -> return Val("unsupported transaction `{transaction}` for `{descriptor.id}`")
    }
    None
}

descriptor_json: fn(descriptor: NodeDescriptor) -> String Never! {
    presentation: descriptor.presentation
    palette: descriptor.palette
    transaction: if descriptor.transaction == .Val(value) -> json_str(value) else -> "null"
    "{{\"id\":{json_str(descriptor.id)},\"kind\":{json_str(descriptor.kind)},\"archetype\":{json_str(descriptor.archetype)},\"projected\":{descriptor.projected},\"presentation\":{{\"label\":{json_str(presentation.label)},\"glyph\":{json_str(presentation.glyph)},\"hover\":{json_str(presentation.hover)},\"accent\":{json_str(presentation.accent)},\"header\":{json_str(presentation.header)},\"style_archetype\":{json_str(presentation.style_archetype)},\"layout_family\":{json_str(presentation.layout_family)},\"shape\":{json_str(presentation.shape)}}},\"palette\":{{\"visible\":{palette.visible},\"insertable\":{palette.insertable},\"category\":{json_str(palette.category)},\"rank\":{palette.rank},\"rank_terms\":[{json_strs(palette.rank_terms)}]}},\"transaction\":{transaction},\"default_editor\":{json_str(descriptor.default_editor)}}}"
}
