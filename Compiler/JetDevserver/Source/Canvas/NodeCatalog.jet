use std.collections.[HashSet]
use jet_devserver.Canvas.ValidationJson.[json_str]

// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:5
pub struct NodeDescriptor {
    pub id: String; pub kind: String; pub archetype: String
    projected: Bool; presentation: PresentationFacts; palette: PaletteFacts
    pub transaction: String?; default_editor: String
}
// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:16
struct PresentationFacts {
    label: String; glyph: String; hover: String; accent: String; header: String
    style_archetype: String; layout_family: String; shape: String
}
// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:27
struct PaletteFacts {
    visible: Bool; insertable: Bool; category: String; rank: I32; rank_terms: [String]
}
// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:35
fn presentation(label: String, glyph: String, hover: String, accent: String, header: String, style_archetype: String, layout_family: String, shape: String) -> PresentationFacts {
    PresentationFacts { label: label, glyph: glyph, hover: hover, accent: accent, header: header, style_archetype: style_archetype, layout_family: layout_family, shape: shape }
}
// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:57
fn palette(visible: Bool, insertable: Bool, category: String, rank: I32, rank_terms: [String]) -> PaletteFacts {
    PaletteFacts { visible: visible, insertable: insertable, category: category, rank: rank, rank_terms: rank_terms }
}
