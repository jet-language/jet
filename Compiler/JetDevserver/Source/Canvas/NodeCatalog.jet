// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:436
pub fn descriptor_for(kind: String, archetype: String) -> &NodeDescriptor {
    validate_catalog() catch message { panic("invalid Canvas node catalog: {message}") }
    NODE_DESCRIPTORS.iter().find((descriptor) -> descriptor.kind == kind && descriptor.archetype == archetype)
        .unwrap_or_else(() -> panic("missing Canvas node descriptor for {kind}/{archetype}"))
}
// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:444
pub fn descriptor_for_id(id: String) -> &NodeDescriptor {
    validate_catalog() catch message { panic("invalid Canvas node catalog: {message}") }
    NODE_DESCRIPTORS.iter().find((descriptor) -> descriptor.id == id)
        .unwrap_or_else(() -> panic("missing Canvas node descriptor `{id}`"))
}
// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:452
pub fn insert_descriptor_id(transaction: String, pure: Bool) -> String {
    descriptor := if transaction == "insert_call" -> descriptor_for_id(if pure -> "function_pure" else "function_exec") else
        NODE_DESCRIPTORS.iter().find((descriptor) -> descriptor.transaction == .Val(transaction))
            .unwrap_or_else(() -> panic("missing Canvas node descriptor transaction `{transaction}`"))
    assert(descriptor.palette.insertable, "Canvas action descriptor `{descriptor.id}` is not insertable")
    descriptor.id
}
// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:476
pub fn palette_rank_fields(id: String) -> String {
    descriptor := descriptor_for_id(id)
    terms := descriptor.palette.rank_terms.iter().map((term) -> json_str(term)).collect().join(",")
    ",\"rank\":{descriptor.palette.rank},\"rank_terms\":[{terms}]"
}
// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:491
pub fn catalog_json() -> String {
    validate_catalog() catch message { panic("invalid Canvas node catalog: {message}") }
    "[{NODE_DESCRIPTORS.iter().map((descriptor) -> descriptor_json(descriptor)).collect().join(",")}]"
}
// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:503
fn validate_catalog() -> Unit Err! {
    ids := HashSet.new()
    // GATE #4499: retain exact pair equality/hash for catalog identities.
    identities := HashSet.new()
    for descriptor in NODE_DESCRIPTORS {
        if descriptor.id.is_empty() || !ids.insert(descriptor.id) -> throw "missing or duplicate id `{descriptor.id}`"
        if !identities.insert((descriptor.kind, descriptor.archetype)) -> throw "duplicate identity `{descriptor.kind}/{descriptor.archetype}`"
        if !descriptor.projected && !descriptor.palette.insertable -> throw "orphaned descriptor `{descriptor.id}`"
        if descriptor.palette.insertable != descriptor.transaction.is_some() -> throw "insertable/transaction mismatch for `{descriptor.id}`"
        if descriptor.palette.insertable && (!descriptor.palette.visible || descriptor.palette.category.is_empty()) -> throw "non-visible insertable descriptor `{descriptor.id}`"
        if descriptor.transaction == .Val(transaction) {
            if !["edit_inline_expr", "insert_branch", "insert_switch", "insert_loop", "insert_fallible_rail", "insert_call"].contains(transaction) ->
                throw "unsupported transaction `{transaction}` for `{descriptor.id}`"
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/node_catalog.rs:553
fn descriptor_json(descriptor: &NodeDescriptor) -> String {
    projected := if descriptor.projected -> "true" else "false"
    visible := if descriptor.palette.visible -> "true" else "false"
    insertable := if descriptor.palette.insertable -> "true" else "false"
    terms := descriptor.palette.rank_terms.iter().map((term) -> json_str(term)).collect().join(",")
    transaction := descriptor.transaction.map((value) -> json_str(value)).unwrap_or_else(() -> "null")
    "{{\"id\":{json_str(descriptor.id)},\"kind\":{json_str(descriptor.kind)},\"archetype\":{json_str(descriptor.archetype)},\"projected\":{projected},\"presentation\":{{\"label\":{json_str(descriptor.presentation.label)},\"glyph\":{json_str(descriptor.presentation.glyph)},\"hover\":{json_str(descriptor.presentation.hover)},\"accent\":{json_str(descriptor.presentation.accent)},\"header\":{json_str(descriptor.presentation.header)},\"style_archetype\":{json_str(descriptor.presentation.style_archetype)},\"layout_family\":{json_str(descriptor.presentation.layout_family)},\"shape\":{json_str(descriptor.presentation.shape)}}},\"palette\":{{\"visible\":{visible},\"insertable\":{insertable},\"category\":{json_str(descriptor.palette.category)},\"rank\":{descriptor.palette.rank},\"rank_terms\":[{terms}]}},\"transaction\":{transaction},\"default_editor\":{json_str(descriptor.default_editor)}}}"
}
