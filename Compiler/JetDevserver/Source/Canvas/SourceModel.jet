fn write_new(path: OSPath, bytes: [U8]) -> Result<Unit, Error> {
    (parent, name) :: open_parent(path)?
    file := create_new_at(parent, name, MODE_NEW_FILE)?
    if file.write_all(bytes).and_then((_) -> file.sync_all()) is .Err(error) { _ :: remove_at(parent, name); return .Err(error) }
    require_regular(file)
}
