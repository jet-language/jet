fn replace_if_unchanged(path: OSPath, expected: [U8]?, candidate: [U8]?) -> Result<ReplaceResult, Error> {
    target :: open_target(path)?
    current :: target.current.as_ref()
    matches :: if expected is { .Some(expected) -> current.is_some_and((current) -> current.bytes == expected); .None -> current.is_none() }
    if !matches -> return .Ok(.Conflict)
    if candidate is {
        .Some(candidate) if current.is_some_and((current) -> current.bytes != candidate) -> target.replace(candidate, current.map((current) -> current.mode))?
        .Some(_) -> {}
        .None if current.is_some() -> target.remove()?
        .None -> {}
    }
    .Ok(.Applied)
}
// Rust: crates/jet-devserver/src/Canvas/source_model.rs:264
fn open_target(path: OSPath) -> Result<Target, Error> {
    (parent, name) :: open_parent(path)?
    current :: if open_file_at(parent, name, O_RDONLY) is {
        .Ok(file) -> { file := file; .Some(read_opened_file(&file, () -> .Ok(()))?) }
        .Err(error) if error.kind() == ErrorKind.NotFound -> .None
        .Err(error) -> return .Err(error)
    }
    .Ok(Target(parent: parent, name: name, current: current))
}
