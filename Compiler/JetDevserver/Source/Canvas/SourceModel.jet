// Canvas source files, read and replaced through held directories so no path
// component, and no final name, is ever followed through a symbolic link.
use {
    source_files: core.files
    source_sys: core.sys
    jet_foundation.[sha256_hex]
}

// The bytes a Canvas source read may return: the devserver response bound.
SOURCE_MAX_BYTES: 67108864
SOURCE_NEW_FILE_MODE: 438
SOURCE_TEMP_ATTEMPTS: 100

// Why a Canvas source path could not be read or written.
#Error
CanvasSourceError: struct { message: String }

canvas_source_error: fn(message: String) -> CanvasSourceError Never! {
    CanvasSourceError{message: message}
}

#Error
SourceWriteError: enum {
    Conflict
    Failed(error: CanvasSourceError)
}

ReplaceResult: enum {
    Applied
    Conflict
}

source_revision: fn(src: String) -> String Never! { "sha256-{sha256_hex(src)}" }

read_source_without_symlinks: fn(path: String) -> String CanvasSourceError! {
    bytes: read_file_without_symlinks(path)
    String.from_bytes(bytes) ?? return Err(canvas_source_error("Canvas source `{path}` is not UTF-8 text"))
}

read_file_without_symlinks: fn(path: String) -> [U8] CanvasSourceError! {
    held: source_open_parent(path)
    current: source_read_current(held.parent, held.name)
    file: current ?? return Err(canvas_source_error("Canvas source `{path}` does not exist"))
    Ok(file.bytes)
}

// Create every missing directory of `path`, refusing link components.
ensure_no_symlink_directory: fn(path: String) CanvasSourceError! {
    directory := source_open_base(path)
    loop name in source_components(path) {
        if directory.entry_stat(name) == {
            .Ok(_) -> {}
            .Err(_) -> {
                if directory.create_directory(name) == {
                    .Ok(_) -> {}
                    .Err(.AlreadyExists(_)) -> {}
                    .Err(error) -> { return Err(canvas_source_error("couldn't create Canvas directory `{name}`: {error}")) }
                }
            }
        }
        directory = directory.open_directory(name) ?? return Err(canvas_source_error("Canvas paths must not traverse symlinks: `{name}`: {err}"))
    }
    Ok()
}

// Create `path` with `bytes`; an existing entry, link or not, is refused.
write_new_file_without_symlinks: fn(path: String, bytes: [U8]) CanvasSourceError! {
    held: source_open_parent(path)
    writer := held.parent.create(held.name, if_exists: .Refuse, mode: Val(SOURCE_NEW_FILE_MODE)) ?? return Err(canvas_source_error("couldn't create Canvas source `{path}`: {err}"))
    if source_write_all(writer, bytes) == .Err(error) {
        source_remove_quietly(held.parent, held.name)
        return Err(error)
    }
    Ok()
}

// Canvas source transactions run on the devserver's one request task, so a
// transaction is the action itself; there is no second writer to exclude.
with_source_transaction: fn<T>(action: fn() -> T SourceWriteError!) -> T SourceWriteError! {
    action()
}

write_source_if_unchanged: fn(path: String, expected: String, candidate: String) SourceWriteError! {
    replace_source_if_unchanged_locked(path, Val(expected), Val(candidate))
}

// Replace (or, with no candidate, remove) `path` when its bytes are exactly
// `expected` (or, with no expectation, when it does not exist).
replace_source_if_unchanged_locked: fn(path: String, expected: String?, candidate: String?) SourceWriteError! {
    result: source_replace_if_unchanged(path, expected, candidate) ?? return Err(SourceWriteError.Failed{error: err})
    if result == .Conflict -> return Err(SourceWriteError.Conflict)
    Ok()
}

source_replace_if_unchanged: fn(path: String, expected: String?, candidate: String?) -> ReplaceResult CanvasSourceError! {
    held: source_open_parent(path)
    current: source_read_current(held.parent, held.name)
    matches: if expected == {
        .Val(text) -> if current == {
            .Val(file) -> file.bytes == text.bytes()
            else -> false
        }
        else -> current == None
    }
    if !matches -> return Ok(ReplaceResult.Conflict)
    if candidate == {
        .Val(text) -> {
            if current == {
                .Val(file) -> {
                    if file.bytes == text.bytes() -> return Ok(ReplaceResult.Applied)
                    source_replace(held, text.bytes(), Val(file.mode))
                }
                else -> source_replace(held, text.bytes(), None)
            }
        }
        else -> {
            if current != None -> held.parent.remove(held.name) ?? return Err(canvas_source_error("couldn't remove Canvas source `{path}`: {err}"))
        }
    }
    Ok(ReplaceResult.Applied)
}

// The held parent directory of a source path and the final name in it.
SourceTarget: struct {
    parent: Directory
    name: String
}

SourceCurrentFile: struct {
    bytes: [U8]
    mode: Int
}

source_open_base: fn(path: String) -> Directory CanvasSourceError! {
    base: if path.starts_with("/") -> "/" else -> "."
    source_files.open_directory(base) ?? return Err(canvas_source_error("couldn't open Canvas base directory `{base}`: {err}"))
}

// The normal components of `path`; `..` is refused, `.` and empty are skipped.
source_components: fn(path: String) -> [String] CanvasSourceError! {
    names := [String]{}
    loop part in path.split("/") {
        if part == "" || part == "." -> next
        if part == ".." -> return Err(canvas_source_error("Canvas paths must not contain parent components"))
        names.push(part)
    }
    Ok(names)
}

source_open_parent: fn(path: String) -> SourceTarget CanvasSourceError! {
    names: source_components(path)
    if names.len() == 0 || path.ends_with("/") -> return Err(canvas_source_error("Canvas source path has no file name"))
    parent := source_open_base(path)
    loop index in 0..<names.len() - 1 {
        parent = parent.open_directory(names[index]) ?? return Err(canvas_source_error("Canvas source paths must not traverse symlinks: `{names[index]}`: {err}"))
    }
    Ok(SourceTarget{parent: parent, name: names[names.len() - 1]})
}

// The regular, single-link file `name` in `parent`, read within the response
// bound; None when it does not exist. A file replaced or relinked during the
// read is refused.
source_read_current: fn(parent: Directory, name: String) -> SourceCurrentFile? CanvasSourceError! {
    if parent.entry_stat(name) == .Err(_) -> return Ok(None)
    reader := parent.open(name) ?? return Err(canvas_source_error("Canvas source paths must not traverse symlinks: `{name}`: {err}"))
    before: reader.stat() ?? return Err(canvas_source_error("couldn't inspect Canvas source `{name}`: {err}"))
    source_require_regular(before, name)
    if before.size > SOURCE_MAX_BYTES -> return Err(canvas_source_error("file exceeds the devserver response limit"))
    bytes := [U8]{}
    loop {
        chunk: reader.read(SOURCE_MAX_BYTES + 1 - bytes.len()) ?? return Err(canvas_source_error("couldn't read Canvas source `{name}`: {err}"))
        if chunk.len() == 0 -> break
        loop byte in chunk -> bytes.push(byte)
        if bytes.len() > SOURCE_MAX_BYTES -> return Err(canvas_source_error("file exceeds the devserver response limit"))
    }
    after: reader.stat() ?? return Err(canvas_source_error("couldn't inspect Canvas source `{name}`: {err}"))
    if after.id != before.id || !after.is_file || after.links != 1 -> return Err(canvas_source_error("Canvas source changed while it was being read"))
    Ok(Val(SourceCurrentFile{bytes: bytes, mode: before.mode}))
}

source_require_regular: fn(stat: Stat, name: String) CanvasSourceError! {
    if !stat.is_file -> return Err(canvas_source_error("Canvas source path `{name}` is not a regular file"))
    if stat.links != 1 -> return Err(canvas_source_error("Canvas source file `{name}` must not be a hard link"))
    Ok()
}

source_write_all: fn(writer: &FileWriter, bytes: [U8]) CanvasSourceError! {
    writer.write_all(bytes) ?? return Err(canvas_source_error("couldn't write Canvas source `{writer.path}`: {err}"))
    writer.fsync() ?? return Err(canvas_source_error("couldn't sync Canvas source `{writer.path}`: {err}"))
    Ok()
}

// Write `bytes` to a fresh temporary beside the target, then rename it over
// the target inside the held parent, keeping the replaced file's mode.
source_replace: fn(target: SourceTarget, bytes: [U8], mode: Int?) CanvasSourceError! {
    file_mode: if mode == {
        .Val(bits) -> bits.bit_and(4095)
        else -> SOURCE_NEW_FILE_MODE
    }
    pid: source_sys.pid()
    temporary := ""
    loop attempt in 0..<SOURCE_TEMP_ATTEMPTS {
        name: ".{target.name}.canvas-{pid}-{attempt}.tmp"
        if target.parent.create(name, if_exists: .Refuse, mode: Val(file_mode)) == {
            .Ok(created) -> {
                writer := created
                if source_write_all(writer, bytes) == .Err(error) {
                    source_remove_quietly(target.parent, name)
                    return Err(error)
                }
                if mode != None -> writer.set_mode(file_mode) ?? return Err(canvas_source_error("couldn't set Canvas source mode: {err}"))
                temporary = name
                break
            }
            .Err(.AlreadyExists(_)) -> { next }
            .Err(error) -> { return Err(canvas_source_error("couldn't create a Canvas source temporary file: {error}")) }
        }
    }
    if temporary == "" -> return Err(canvas_source_error("could not allocate a Canvas source temporary file"))
    if target.parent.rename(temporary, target.name) == .Err(error) {
        source_remove_quietly(target.parent, temporary)
        return Err(canvas_source_error("couldn't replace Canvas source `{target.name}`: {error}"))
    }
    // The rename is done; a failed directory sync only weakens durability.
    if target.parent.fsync() == {
        .Err(_) -> {}
        else -> {}
    }
    Ok()
}

// Remove a temporary this module created; the original failure is reported.
source_remove_quietly: fn(parent: Directory, name: String) Never! {
    if parent.remove(name) == {
        .Err(_) -> {}
        else -> {}
    }
}
