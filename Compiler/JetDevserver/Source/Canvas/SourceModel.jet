}
// Rust: crates/jet-devserver/src/Canvas/source_model.rs:349
fn open_parent(path: OSPath) -> Result<(File, CString), Error> {
    components :: path.components().collect()
    name :: if components.last() is .Some(.Normal(name)) { name } else { return .Err(Error.new(ErrorKind.InvalidInput, "Canvas source path has no file name")) }
    parent := open_base(path.is_absolute())?
    for component in components[..components.len() - 1] {
        parent = if component is {
            .RootDir | .CurDir -> parent
            .ParentDir -> return .Err(Error.new(ErrorKind.InvalidInput, "Canvas paths must not contain parent components"))
            .Normal(name) -> open_directory_at(parent, name)?
            .Prefix(_) -> return .Err(Error.new(ErrorKind.InvalidInput, "Canvas source path has an unsupported prefix"))
        }
    }
    .Ok((parent, c_name(name)?))
}
