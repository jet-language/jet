use {
    core.files.[OSPath]
    std.fmt.[format]
    jet_driver.Diagnostics.[Diagnostic, Span, TextEdit, ReportPath, render_all, render_all_json]
    AST: jet_driver.AST
    jet_driver.AST.[Expr]
    jet_semindex.[SemIndex, SourceSpan, CallableSignatureFact]
    semindex: jet_semindex
    jet_devserver.Canvas.GraphJson.[add_wire_with_span]
    jet_devserver.Canvas.ProjectScan.[project_file]
    jet_devserver.Canvas.QueryActions.[canvas_authority_context]
    jet_devserver.Canvas.EditActions.[EDIT_SCHEMA_VERSION]
    jet_devserver.Canvas.GraphProjection.[GraphBuilder, NodeQueryRef, Projection]
    jet_devserver.Canvas.SchemaApi.[ACTION_SCHEMA_VERSION, PROJECT_SCHEMA_VERSION, QUERY_SCHEMA_VERSION]
    jet_devserver.Canvas.SourceModel.[read_source_without_symlinks, source_revision]
    jet_devserver.Canvas.ValidationJson.[json_str, span_json]
    jet_foundation.[Diagnostic, Expr, Span, TextEdit]
    jetpack_foundation.[ReportPath]
}

graph_id: fn(module_display: String, f: &AST.Func) -> String {
    file: OSPath.new(module_display).file_name().and_then((s) -> s.to_str()).unwrap_or(module_display)
    "fn:{file}::{f.name}@{f.name_span.start}-{f.name_span.end}"
}

span_through_closing_parens: fn(src: String, span: Span) -> SourceSpan {
    text: src.get(span.start..span.end) ?? return SourceSpan(start: span.start, end: span.end)
    opens: text.bytes().filter((byte) -> byte == 40).count()
    closes := text.bytes().filter((byte) -> byte == 41).count()
    end := span.end
    loop closes < opens && src.as_bytes().get(end) == .Some(41) {
        end += 1
        closes += 1
    }
    SourceSpan(start: span.start, end: end)
}

graph_id_name_span: fn(graph_id: String) -> SourceSpan? {
    (_, range): graph_id.rsplit_once('@')
    (start, end): range.split_once('-')
    .Some(SourceSpan(start: start.parse().ok()?, end: end.parse().ok()?))
}

function_signature_span: fn(src: String, name_span: SourceSpan) -> SourceSpan Err! {
    start: line_start(src, name_span.start)
    brace_rel: src[name_span.end.min(src.len())..<src.len()].find('{') ?? return .Err(edit_error("not_found", "Canvas function signature no longer has a body"))
    end := name_span.end + brace_rel
    loop end > start && src.as_bytes()[end - 1].is_ascii_whitespace() { end -= 1 }
    .Ok(SourceSpan(start: start, end: end))
}

insert_offset: fn(src: String, f: &AST.Func) -> Usize {
    if f.body.first() == .Val(first) {
        first_start: first.span().start
        line: line_start(src, first_start)
        if src[line..first_start].contains('{') -> return first_start
        return line
    }
    line_after(src, f.name_span.end)
}

line_start: fn(src: String, offset: Usize) -> Usize {
    src[0..<offset.min(src.len())].rfind('\n').map((i) -> i + 1).unwrap_or(0)
}

line_after: fn(src: String, offset: Usize) -> Usize {
    src[offset.min(src.len())..<src.len()].find('\n').map((i) -> offset + i + 1).unwrap_or(src.len())
}

indentation_at: fn(src: String, offset: Usize) -> String {
    start: line_start(src, offset)
    src[start..offset.min(src.len())].chars().take_while((c) -> c == ' ' || c == '\t').collect()
}

assignment_title: fn(target: AST.LValue, op: AST.BinOp?) -> String {
    op_text: op.map((op) -> "{op}=").unwrap_or("=")
    if target is {
        .Local(name: name, ..) -> "{name} {op_text}"
        .Index(..) -> "index {op_text}"
        .Field(field: field, ..) -> ".{field} {op_text}"
    }
}

lvalue_type: fn(g: GraphBuilder, target: AST.LValue) -> String {
    if target is {
        .Local(name: name, ..) -> g.local_types.get(name).cloned().unwrap_or("unknown")
        .Index(..) | .Field(..) -> "unknown"
    }
}

expr_title: fn(expr: Expr) -> String {
    if expr is {
        .StructLit(..) -> "construct"
        .EnumLit(..) -> "variant"
        .Lambda(_) -> "lambda"
        .If(..) -> "if expression"
        .ListLit(_, _, _) -> "list"
        .MapLit(_, _, _) -> "map"
        .TupleLit(_, _, _, _) -> "tuple"
        .Index(..) -> "index"
        .Slice(..) -> "slice"
        .CallValue(..) -> "call value"
        .Deref(_, _, _) | .RawOf(_, _, _) | .PtrFromAddr(..) -> "unsafe expr"
        .OrFallback(..) -> "fallback"
        .PatternTest(..) -> "pattern test"
        .Try(_, _, _, _, _) -> "fallible"
        _ -> "expression"
    }
}

starts_uppercase: fn(s: String) -> Bool {
    s.chars().next().map((c) -> c.is_uppercase()).unwrap_or(false)
}

binding_type: fn(g: GraphBuilder, name: String, b: AST.Binding) -> String {
    b.ty.as_ref().map((ty) -> ty.name()).or_else(() -> g.local_types.get(name).cloned()).unwrap_or("unknown")
}

expr_type: fn(g: GraphBuilder, index: SemIndex, expr: Expr) -> String {
    if expr is {
        .Int(_, _, _, _, _) -> "Int"
        .Float(_, _, is_f32, _, _) -> if is_f32 -> "F32" else -> "Float"
        .Bool(_, _, _) -> "Bool"
        .Str(_, _, _) -> "String"
        .Char(_, _, _) -> "Char"
        .Ident(name, _, _) -> {
            if g.local_types.get(name) == .Val(ty) -> return ty.clone()
            loop definition in index.definitions() {
                if definition.name != name -> next
                if definition.kind == .Function(params: params, ret: ret, ..) {
                    param_text: params.iter().map(((_, ty)) -> ty.as_str()).collect().join(", ")
                    ret_text: ret.as_ref().map((ty) -> " {ty}").unwrap_or_default()
                    return "fn({param_text}){ret_text}"
                }
            }
            "unknown"
        }
        .Binary(op, left, _, _) -> if op_is_bool(op) -> "Bool" else -> expr_type(g, index, left)
        .Call(c, _) -> call_ret(index, c.name).unwrap_or("unknown")
        .MethodCall(..) -> "unknown"
        .Try(inner, _, _, _, _) -> {
            ty := expr_type(g, index, inner).trim_end_matches('?') // #4303
            ty.to_string()
        }
        _ -> "unknown"
    }
}

op_is_bool: fn(op: AST.BinOp) -> Bool {
    if op is {
        .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .And | .Or -> true
        _ -> false
    }
}

call_ret: fn(index: SemIndex, name: String) -> String? {
    loop d in index.definitions() {
        if d.name == name {
            if d.kind == .Function(ret: ret, ..) {
                if ret == .Val(value) -> return .Some(value.clone())
            }
        }
    }
    .None
}

callable_signature_for_name: fn(index: SemIndex, function: String) -> CallableSignatureFact? {
    loop definition in index.definitions() {
        if definition.name == function && definition.kind == .Function(..) {
            return definition.callable_signature.as_ref()
        }
    }
    .None
}

effect_badges: fn(index: SemIndex, function: String) -> [String] {
    if callable_signature_for_name(index, function) == .Val(signature) {
        return if signature.effects is {
            .Checked(effects) -> if effects.is_empty() -> [] else -> ["effects"]
            .Unavailable(_) -> ["effects_unavailable"]
        }
    }
    if index.effect_of(function) == .Val(effects) {
        if !effects.direct.is_empty() || !effects.inferred.is_empty() -> return ["effects"]
        return []
    }
    ["effects_unavailable"]
}

call_has_effects: fn(index: SemIndex, function: String) -> Bool {
    if callable_signature_for_name(index, function) == .Val(signature) {
        return if signature.effects is {
            .Checked(effects) -> !effects.is_empty()
            .Unavailable(_) -> true
        }
    }
    index.effect_of(function).map((effects) -> !effects.direct.is_empty() || !effects.inferred.is_empty()).unwrap_or(true)
}

pure_leaf: fn(expr: Expr) -> Bool {
    if expr is {
        .Str(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) | .Ident(_, _, _) | .Field(_, _, _, _) | .OptField(..) | .Absent(_, _) | .Todo(..) -> true
        .Unary(_, inner, _, _) | .Paren(inner, _, _) | .Copy(inner, _, _) -> pure_leaf(inner)
        .Binary(_, left, right, _) -> pure_leaf(left) && pure_leaf(right)
        .CompareChain(operands: operands, ..) -> operands.iter().all((operand) -> pure_leaf(operand))
        .ListLit(_, _, _) -> false
        .MapLit(items, _, _) -> items.iter().all(((k, v)) -> pure_leaf(k) && pure_leaf(v))
        .TupleLit(items, _, _, _) -> items.iter().all(((_, e)) -> pure_leaf(e))
        .Ok(inner, _, _) | .Err(inner, _, _) | .Present(inner, _, _) -> pure_leaf(inner)
        _ -> false
    }
}

wire_ident_refs: fn(g: &GraphBuilder, expr: &Expr, input_pin: String) {
    if expr == .Ident(name, span, _) {
        if g.local_pins.get(name).cloned() == .Val(out) {
            add_wire_with_span(g, out, input_pin, "data", .Some(SourceSpan(start: span.start, end: span.end)))
        }
    }
}

snippet: fn(src: String, span: Span) -> String {
    text := src.get(span.start..span.end).unwrap_or("").trim() // #4303
    text.to_string()
}

edit: fn(span: SourceSpan, text: String) -> TextEdit {
    TextEdit(span: Span.new(span.start, span.end), new_text: text.to_string())
}

edit_ok: fn(changed: Bool, path: &OSPath) -> String {
    src: read_source_without_symlinks(path).unwrap_or_default()
    edit_ok_source(changed, src)
}

edit_ok_source: fn(changed: Bool, src: String) -> String {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"changed\":{if changed { "true" } else { "false" }},\"revision\":{json_str(source_revision(src))},\"source_text\":{json_str(src)}}}"
}

preview_ok: fn(before: String, after: String) -> String {
    "{{\"protocol\":\"jet.canvas.preview\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"changed\":{if before != after { "true" } else { "false" }},\"diff\":{json_str(simple_diff(before, after))},\"after_revision\":{json_str(source_revision(after))}}}"
}

canvas_action_preview_ok: fn(path: OSPath, before: String, after: String, action_id: String, callee: String) -> String {
    authority: canvas_authority_context(path)
    "{{\"protocol\":\"jet.canvas.action\",\"schema_version\":{ACTION_SCHEMA_VERSION},\"ok\":true,\"changed\":{if before != after { "true" } else { "false" }},\"action_id\":{json_str(action_id)},\"callee\":{json_str(callee)},\"engine\":\"checked+jit\",\"execution\":\"preview\",\"writes\":\"source_transaction_only\",\"authority\":[{json_str(authority.grant)}],\"audit\":{{\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"hash\":{json_str(source_revision(after))},\"touched_files\":[{json_str(authority.touched_file)}],\"diagnostics\":[]}},\"diff\":{json_str(simple_diff(before, after))},\"after_revision\":{json_str(source_revision(after))}}}"
}

query_ok: fn(op: String, src: String, results_json: String, extra_fields: String) -> String {
    "{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{QUERY_SCHEMA_VERSION},\"ok\":true,\"op\":{json_str(op)},\"revision\":{json_str(source_revision(src))},\"results\":{results_json},{extra_fields} }}"
}

query_result_json: fn(kind: String, title: String, symbol: String, module_path: String, span: SourceSpan, node: &NodeQueryRef?, src: String) -> String {
    (graph_id, node_id, node_kind): if node is {
        .Some(n) -> (n.graph_id.as_str(), n.node_id.as_str(), n.kind.as_str())
        .None -> ("", "", "")
    }
    "{{\"kind\":{json_str(kind)},\"title\":{json_str(title)},\"symbol\":{json_str(symbol)},\"module_path\":{json_str(module_path)},\"graph_id\":{json_str(graph_id)},\"node_id\":{json_str(node_id)},\"node_kind\":{json_str(node_kind)},\"source_span\":{span_json(span)},\"line\":{line_number_for(src, span.start)},\"excerpt\":{json_str(source_line_for(src, span.start))}}}"
}

open_query_context: fn(path: OSPath, src: String) -> (Projection, SemIndex) Err! {
    projection: project_file(path).map_err((diags) -> query_diagnostics_error(path, src, diags))
    index: semindex.open(path).map_err((e) -> query_error("check", e.to_string()))
    .Ok((projection, index))
}

node_for_span: fn(projection: Projection, span: SourceSpan) -> NodeQueryRef? {
    projection.node_refs.iter().filter((node) -> spans_overlap(node.span, span)).min_by_key((node) -> node.span.end.saturating_sub(node.span.start)).cloned()
}

nearest_node: fn(projection: Projection, offset: Usize) -> NodeQueryRef? {
    projection.node_refs.iter().min_by_key((node) -> {
        if offset < node.span.start -> node.span.start - offset else -> offset.saturating_sub(node.span.end)
    }).cloned()
}

spans_overlap: fn(a: SourceSpan, b: SourceSpan) -> Bool {
    a.start <= b.end && b.start <= a.end
}

contains_ci: fn(text: String, needle: String) -> Bool {
    text.to_ascii_lowercase().contains(needle.to_ascii_lowercase())
}

text_matches: fn(src: String, needle: String) -> [SourceSpan] {
    out := [SourceSpan]{}
    if needle.is_empty() -> return out
    hay: src.to_ascii_lowercase()
    lower_needle: needle.to_ascii_lowercase()
    offset := 0
    loop {
        pos: hay[offset..<hay.len()].find(lower_needle) ?? break
        start: offset + pos
        end: start + lower_needle.len()
        out.push(SourceSpan(start: start, end: end))
        offset = end
    }
    out
}

dedupe_results: fn(results: &[String]) {
    seen := [String]{}
    results.retain((r) -> {
        if seen.iter().any((s) -> s == r) { false } else {
            seen.push(r.clone())
            true
        }
    })
}

line_number_for: fn(src: String, offset: Usize) -> Usize {
    boundary: floor_char_boundary(src, offset)
    src[0..<boundary].bytes().filter((b) -> b == 10).count() + 1
}

source_line_for: fn(src: String, offset: Usize) -> String {
    boundary: floor_char_boundary(src, offset)
    start: src[0..<boundary].rfind('\n').map((i) -> i + 1).unwrap_or(0)
    end: src[boundary..<src.len()].find('\n').map((i) -> boundary + i).unwrap_or(src.len())
    text := src[start..end].trim() // #4303
    text.to_string()
}

floor_char_boundary: fn(src: String, offset: Usize) -> Usize {
    boundary := offset.min(src.len())
    loop boundary > 0 && !src.is_char_boundary(boundary) { boundary -= 1 }
    boundary
}

simple_diff: fn(before: String, after: String) -> String {
    before_lines: before.lines().collect()
    after_lines: after.lines().collect()
    out := "--- before\n+++ after\n".to_string()
    loop line in before_lines {
        if !after_lines.contains(line) {
            out.push('-')
            out.push_str(line)
            out.push('\n')
        }
    }
    loop line in after_lines {
        if !before_lines.contains(line) {
            out.push('+')
            out.push_str(line)
            out.push('\n')
        }
    }
    out
}

edit_error: fn(kind: String, message: String) -> String {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)}}}"
}

edit_conflict: fn(message: String, current_revision: String) -> String {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"ok\":false,\"kind\":\"conflict\",\"message\":{json_str(message)},\"current_revision\":{json_str(current_revision)}}}"
}

edit_error_with_diagnostics: fn(kind: String, message: String, path: &OSPath, src: String, diags: &[Diagnostic]) -> String {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)},\"revision\":{json_str(source_revision(src))},\"diagnostic_revision\":{json_str(source_revision(src))},\"diagnostics\":[{diagnostics_json(path, src, diags)}]}}"
}

query_error: fn(kind: String, message: String) -> String {
    "{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{QUERY_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)}}}"
}

query_error_with_diagnostics: fn(kind: String, message: String, path: &OSPath, src: String, diags: &[Diagnostic]) -> String {
    "{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{QUERY_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)},\"revision\":{json_str(source_revision(src))},\"diagnostic_revision\":{json_str(source_revision(src))},\"diagnostics\":[{diagnostics_json(path, src, diags)}]}}"
}

project_edit_ok_with_audit: fn(op: String, preview: Bool, changed: Bool, before_revision: String, after_revision: String, touched_files: String, diff: String, audit: String) -> String {
    game_audit: if audit.is_empty() -> "" else -> ",\"game_selection\":{audit}"
    "{{\"protocol\":\"jet.canvas.project.edit\",\"schema_version\":{PROJECT_SCHEMA_VERSION},\"ok\":true,\"op\":{json_str(op)},\"preview\":{if preview { "true" } else { "false" }},\"changed\":{if changed { "true" } else { "false" }},\"project_revision\":{json_str(before_revision)},\"after_project_revision\":{json_str(after_revision)},\"writes\":{if preview { ""preview_only"" } else { ""source_transaction"" }},\"authority\":[\"canvas.source_edit:project\"],\"audit\":{{\"touched_files\":[{touched_files}],\"diagnostics\":[]{game_audit}}},\"diff\":{json_str(diff)}}}"
}

project_edit_error: fn(kind: String, message: String) -> String {
    "{{\"protocol\":\"jet.canvas.project.edit\",\"schema_version\":{PROJECT_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)}}}"
}

project_edit_conflict: fn(message: String, current_revision: String) -> String {
    "{{\"protocol\":\"jet.canvas.project.edit\",\"schema_version\":{PROJECT_SCHEMA_VERSION},\"ok\":false,\"kind\":\"conflict\",\"message\":{json_str(message)},\"current_revision\":{json_str(current_revision)}}}"
}

diagnostics_error: fn(path: OSPath, src: String, diags: [Diagnostic]) -> String {
    edit_error_with_diagnostics("diagnostic", render_all(path.display().to_string(), src, diags), path, src, diags)
}

query_diagnostics_error: fn(path: OSPath, src: String, diags: [Diagnostic]) -> String {
    query_error_with_diagnostics("diagnostic", render_all(path.display().to_string(), src, diags), path, src, diags)
}

diagnostics_json: fn(path: OSPath, src: String, diags: [Diagnostic]) -> String {
    render_all_json(ReportPath.from_path(path), src, diags).lines().collect().join(",")
}
