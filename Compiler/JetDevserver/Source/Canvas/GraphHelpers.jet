use {
    core.files.[OSPath]
    jet_foundation.[
        BinOp, Binding, DIAGNOSTIC_LINT, Diagnostic, Expr, Func, LValue, Span, TextEdit,
        diagnostic_render_all, diagnostic_source_column, diagnostic_source_line, diagnostic_source_position,
        diagnostic_source_texts, type_name,
    ]
    jet_parser.[jfmt_bin_op_spell, jfmt_stmt_span]
    jet_semindex.[CallableSignatureFact, SemIndex, SourceSpan, semindex_open]
}

// A projection and the semantic index of one file, opened together.
QueryContext: struct {
    projection: Projection
    index: SemIndex
}

graph_id: fn(module_display: String, f: Func) -> String Never! {
    file: if module_display.cut_last("/") == .Val(parts) -> parts.after else -> module_display
    "fn:{file}::{f.name}@{f.name_span.start}-{f.name_span.end}"
}

span_through_closing_parens: fn(src: String, span: Span) -> SourceSpan Never! {
    if span.start < 0 || span.end > src.len() || span.start > span.end -> return SourceSpan{start: span.start, end: span.end}
    bytes: src.bytes()
    opens := 0
    closes := 0
    loop i in span.start..<span.end {
        if bytes[i] == 40 -> opens += 1
        if bytes[i] == 41 -> closes += 1
    }
    end := span.end
    loop closes < opens && end < bytes.len() && bytes[end] == 41 {
        end += 1
        closes += 1
    }
    SourceSpan{start: span.start, end: end}
}

graph_id_name_span: fn(graph_id: String) -> SourceSpan? Never! {
    range: graph_id.cut_last("@") ?? return None
    parts: range.after.split_once("-") ?? return None
    start: parts.before.to_int() ?? return None
    end: parts.after.to_int() ?? return None
    Val(SourceSpan{start: start, end: end})
}

function_signature_span: fn(src: String, name_span: SourceSpan) -> SourceSpan String! {
    start: line_start(src, name_span.start)
    from: if name_span.end < src.len() -> name_span.end else -> src.len()
    brace_rel: src.slice(from, src.len()).index_of("{{") ?? return Err(edit_error("not_found", "Canvas function signature no longer has a body"))
    bytes: src.bytes()
    end := from + brace_rel
    loop end > start && is_space_byte(Int.from_u8(bytes[end - 1])) -> end -= 1
    Ok(SourceSpan{start: start, end: end})
}

is_space_byte: fn(byte: Int) -> Bool Never! {
    byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 12
}

insert_offset: fn(src: String, f: Func) -> Int Never! {
    if f.body.len() > 0 {
        first_start: jfmt_stmt_span(f.body[0]).start
        line: line_start(src, first_start)
        if src.slice(line, first_start).contains("{{") -> return first_start
        return line
    }
    line_after(src, f.name_span.end)
}

line_start: fn(src: String, offset: Int) -> Int Never! {
    limit: if offset < src.len() -> offset else -> src.len()
    if src.slice(0, limit).last_index_of("\n") == .Val(i) -> return i + 1
    0
}

line_after: fn(src: String, offset: Int) -> Int Never! {
    from: if offset < src.len() -> offset else -> src.len()
    if src.slice(from, src.len()).index_of("\n") == .Val(i) -> return from + i + 1
    src.len()
}

indentation_at: fn(src: String, offset: Int) -> String Never! {
    start: line_start(src, offset)
    limit: if offset < src.len() -> offset else -> src.len()
    bytes: src.bytes()
    end := start
    loop end < limit && (bytes[end] == 32 || bytes[end] == 9) -> end += 1
    src.slice(start, end)
}

assignment_title: fn(target: LValue, op: BinOp?) -> String Never! {
    op_text: if op == .Val(value) -> "{jfmt_bin_op_spell(value)}=" else -> "="
    if target == {
        .Local(name, _) -> "{name} {op_text}"
        .Index(_, _, _, _) -> "index {op_text}"
        .Field(_, field, _) -> ".{field} {op_text}"
    }
}

lvalue_type: fn(g: GraphBuilder, target: LValue) -> String Never! {
    if target == .Local(name, _) && g.local_types.has_key(name) -> return g.local_types[name]
    "unknown"
}

expr_title: fn(expr: Expr) -> String Never! {
    if expr == {
        .StructLit(_, _, _, _, _, _, _, _) -> "construct"
        .EnumLit(_, _, _, _, _, _, _) -> "variant"
        .Lambda(_, _) -> "lambda"
        .If(_, _, _, _, _, _, _) -> "if expression"
        .ListLit(_, _, _) -> "list"
        .MapLit(_, _, _) -> "map"
        .TupleLit(_, _, _, _) -> "tuple"
        .Index(_, _, _, _, _) -> "index"
        .Slice(_, _, _, _, _, _) -> "slice"
        .CallValue(_, _, _, _) -> "call value"
        .Deref(_, _, _) -> "unsafe expr"
        .RawOf(_, _, _) -> "unsafe expr"
        .PtrFromAddr(_, _, _, _, _, _) -> "unsafe expr"
        .OrFallback(_, _, _, _, _) -> "fallback"
        .PatternTest(_, _, _, _) -> "pattern test"
        .Try(_, _, _, _, _) -> "fallible"
        else -> "expression"
    }
}

starts_uppercase: fn(s: String) -> Bool Never! {
    bytes: s.bytes()
    bytes.len() > 0 && bytes[0] >= 65 && bytes[0] <= 90
}

binding_type: fn(g: GraphBuilder, name: String, b: Binding) -> String Never! {
    if b.ty == .Val(ty) -> return type_name(ty)
    if g.local_types.has_key(name) -> return g.local_types[name]
    "unknown"
}

expr_type: fn(g: GraphBuilder, index: SemIndex, expr: Expr) -> String Never! {
    if expr == {
        .Int(_, _, _, _, _) -> "Int"
        .Float(_, _, is_f32, _, _) -> if is_f32 -> "F32" else -> "Float"
        .Bool(_, _, _) -> "Bool"
        .Str(_, _, _) -> "String"
        .Char(_, _, _) -> "Char"
        .Ident(name, _, _) -> ident_type(g, index, name)
        .Binary(op, left, _, _, _) -> if op_is_bool(op) -> "Bool" else -> expr_type(g, index, left)
        .Call(call, _) -> call_ret(index, call.name) ?? "unknown"
        .Try(inner, _, _, _, _) -> expr_type(g, index, inner).remove_suffix("?")
        else -> "unknown"
    }
}

ident_type: fn(g: GraphBuilder, index: SemIndex, name: String) -> String Never! {
    if g.local_types.has_key(name) -> return g.local_types[name]
    loop definition in index.definitions() {
        if definition.name != name -> next
        if definition.kind == .Function(params, _, ret) {
            param_text: loop param in params -> param.ty
            ret_text: if ret == .Val(value) -> " {value}" else -> ""
            return "fn({param_text.join(", ")}){ret_text}"
        }
    }
    "unknown"
}

op_is_bool: fn(op: BinOp) -> Bool Never! {
    if op == {
        .Eq -> true
        .Ne -> true
        .Lt -> true
        .Le -> true
        .Gt -> true
        .Ge -> true
        .And -> true
        .Or -> true
        else -> false
    }
}

call_ret: fn(index: SemIndex, name: String) -> String? Never! {
    loop definition in index.definitions() {
        if definition.name == name && definition.kind == .Function(_, _, ret) && ret == .Val(value) -> return Val(value)
    }
    None
}

callable_signature_for_name: fn(index: SemIndex, function: String) -> CallableSignatureFact? Never! {
    loop definition in index.definitions() {
        if definition.name == function && definition.kind == .Function(_, _, _) -> return definition.callable_signature
    }
    None
}

effect_badges: fn(index: SemIndex, function: String) -> [String] Never! {
    if callable_signature_for_name(index, function) == .Val(signature) {
        if signature.effects == {
            .Checked(effects) -> return if effects.len() == 0 -> [String]{} else -> [String]{"effects"}
            .Unavailable(_) -> return [String]{"effects_unavailable"}
        }
    }
    if index.effect_of(function) == .Val(facts) {
        loop fact in facts {
            if fact.direct.len() > 0 || fact.inferred.len() > 0 -> return [String]{"effects"}
        }
        return [String]{}
    }
    [String]{"effects_unavailable"}
}

call_has_effects: fn(index: SemIndex, function: String) -> Bool Never! {
    if callable_signature_for_name(index, function) == .Val(signature) {
        if signature.effects == {
            .Checked(effects) -> return effects.len() > 0
            .Unavailable(_) -> return true
        }
    }
    facts: index.effect_of(function) ?? return true
    loop fact in facts {
        if fact.direct.len() > 0 || fact.inferred.len() > 0 -> return true
    }
    false
}

pure_leaf: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Str(_, _, _) -> true
        .Int(_, _, _, _, _) -> true
        .Float(_, _, _, _, _) -> true
        .Bool(_, _, _) -> true
        .Char(_, _, _) -> true
        .Ident(_, _, _) -> true
        .Field(_, _, _, _) -> true
        .OptField(_, _, _, _, _, _) -> true
        .Absent(_, _) -> true
        .Todo(_, _, _) -> true
        .Unary(_, inner, _, _) -> pure_leaf(inner)
        .Paren(inner, _, _) -> pure_leaf(inner)
        .Copy(inner, _, _) -> pure_leaf(inner)
        .Binary(_, left, right, _, _) -> pure_leaf(left) && pure_leaf(right)
        .CompareChain(operands, _, _, _, _) -> {
            loop operand in operands {
                if !pure_leaf(operand) -> return false
            }
            true
        }
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                if !pure_leaf(entry.key) || !pure_leaf(entry.value) -> return false
            }
            true
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields {
                if !pure_leaf(field.value) -> return false
            }
            true
        }
        .Ok(inner, _, _) -> pure_leaf(inner)
        .Err(inner, _, _) -> pure_leaf(inner)
        .Present(inner, _, _) -> pure_leaf(inner)
        else -> false
    }
}

wire_ident_refs: fn(g: &GraphBuilder, expr: Expr, input_pin: String) {
    if expr == .Ident(name, span, _) && g.local_pins.has_key(name) {
        add_wire_with_span(g, g.local_pins[name], input_pin, "data", Val(SourceSpan{start: span.start, end: span.end}))
    }
}

snippet: fn(src: String, span: Span) -> String Never! {
    if span.start < 0 || span.end > src.len() || span.start > span.end -> return ""
    src.slice(span.start, span.end).trim()
}

edit: fn(span: SourceSpan, text: String) -> TextEdit Never! {
    TextEdit{span: Span{start: span.start, end: span.end}, new_text: text}
}

json_bool: fn(value: Bool) -> String Never! {
    if value -> "true" else -> "false"
}

edit_ok: fn(changed: Bool, path: String) -[FS]> String Never! {
    src: read_source_without_symlinks(path) ?? ""
    edit_ok_source(changed, src)
}

edit_ok_source: fn(changed: Bool, src: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"changed\":{json_bool(changed)},\"revision\":{json_str(source_revision(src))},\"source_text\":{json_str(src)}}}"
}

preview_ok: fn(before: String, after: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.preview\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"changed\":{json_bool(before != after)},\"diff\":{json_str(simple_diff(before, after))},\"after_revision\":{json_str(source_revision(after))}}}"
}

canvas_action_preview_ok: fn(path: String, before: String, after: String, action_id: String, callee: String) -[FS]> String Never! {
    authority: canvas_authority_context(path)
    "{{\"protocol\":\"jet.canvas.action\",\"schema_version\":{ACTION_SCHEMA_VERSION},\"ok\":true,\"changed\":{json_bool(before != after)},\"action_id\":{json_str(action_id)},\"callee\":{json_str(callee)},\"engine\":\"checked+jit\",\"execution\":\"preview\",\"writes\":\"source_transaction_only\",\"authority\":[{json_str(authority.grant)}],\"audit\":{{\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"hash\":{json_str(source_revision(after))},\"touched_files\":[{json_str(authority.touched_file)}],\"diagnostics\":[]}},\"diff\":{json_str(simple_diff(before, after))},\"after_revision\":{json_str(source_revision(after))}}}"
}

query_ok: fn(op: String, src: String, results_json: String, extra_fields: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{QUERY_SCHEMA_VERSION},\"ok\":true,\"op\":{json_str(op)},\"revision\":{json_str(source_revision(src))},\"results\":{results_json},{extra_fields} }}"
}

query_result_json: fn(kind: String, title: String, symbol: String, module_path: String, span: SourceSpan, node: NodeQueryRef?, src: String) -> String Never! {
    graph_id := ""
    node_id := ""
    node_kind := ""
    if node == .Val(found) {
        graph_id = found.graph_id
        node_id = found.node_id
        node_kind = found.kind
    }
    "{{\"kind\":{json_str(kind)},\"title\":{json_str(title)},\"symbol\":{json_str(symbol)},\"module_path\":{json_str(module_path)},\"graph_id\":{json_str(graph_id)},\"node_id\":{json_str(node_id)},\"node_kind\":{json_str(node_kind)},\"source_span\":{span_json(span)},\"line\":{line_number_for(src, span.start)},\"excerpt\":{json_str(source_line_for(src, span.start))}}}"
}

open_query_context: fn(path: String, src: String) -[FS, Env]> QueryContext String! {
    projection: project_file(path) ?? return Err(query_diagnostics_error(path, src, err))
    index: semindex_open(OSPath.from(path)) ?? return Err(query_error("check", "{err}"))
    Ok(QueryContext{projection: projection, index: index})
}

node_for_span: fn(projection: Projection, span: SourceSpan) -> NodeQueryRef? Never! {
    best := NodeQueryRef?{None}
    best_width := 0
    loop node in projection.node_refs {
        if !spans_overlap(node.span, span) -> next
        width: if node.span.end > node.span.start -> node.span.end - node.span.start else -> 0
        if best == None || width < best_width {
            best = Val(node)
            best_width = width
        }
    }
    best
}

nearest_node: fn(projection: Projection, offset: Int) -> NodeQueryRef? Never! {
    best := NodeQueryRef?{None}
    best_distance := 0
    loop node in projection.node_refs {
        distance: if {
            offset < node.span.start -> node.span.start - offset
            offset > node.span.end -> offset - node.span.end
            else -> 0
        }
        if best == None || distance < best_distance {
            best = Val(node)
            best_distance = distance
        }
    }
    best
}

spans_overlap: fn(a: SourceSpan, b: SourceSpan) -> Bool Never! {
    a.start <= b.end && b.start <= a.end
}

contains_ci: fn(text: String, needle: String) -> Bool Never! {
    text.to_ascii_lower().contains(needle.to_ascii_lower())
}

text_matches: fn(src: String, needle: String) -> [SourceSpan] Never! {
    out := [SourceSpan]{}
    if needle.is_empty() -> return out
    hay: src.to_ascii_lower()
    lower_needle: needle.to_ascii_lower()
    offset := 0
    loop offset <= hay.len() {
        pos: hay.slice(offset, hay.len()).index_of(lower_needle) ?? break
        start: offset + pos
        end: start + lower_needle.len()
        out.push(SourceSpan{start: start, end: end})
        offset = end
    }
    out
}

dedupe_results: fn(results: &[String]) {
    seen := [String:Bool]{}
    kept := [String]{}
    loop result in results {
        if seen.has_key(result) -> next
        seen[result] = true
        kept.push(result)
    }
    results = kept
}

line_number_for: fn(src: String, offset: Int) -> Int Never! {
    limit: if offset < src.len() -> offset else -> src.len()
    bytes: src.bytes()
    count := 1
    loop i in 0..<limit {
        if bytes[i] == 10 -> count += 1
    }
    count
}

source_line_for: fn(src: String, offset: Int) -> String Never! {
    start: line_start(src, offset)
    from: if offset < src.len() -> offset else -> src.len()
    end: if src.slice(from, src.len()).index_of("\n") == .Val(i) -> from + i else -> src.len()
    src.slice(start, end).trim()
}

simple_diff: fn(before: String, after: String) -> String Never! {
    before_lines: before.lines().to_list()
    after_lines: after.lines().to_list()
    before_set := [String:Bool]{}
    after_set := [String:Bool]{}
    loop line in before_lines -> before_set[line] = true
    loop line in after_lines -> after_set[line] = true
    out := "--- before\n+++ after\n"
    loop line in before_lines {
        if !after_set.has_key(line) -> out = "{out}-{line}\n"
    }
    loop line in after_lines {
        if !before_set.has_key(line) -> out = "{out}+{line}\n"
    }
    out
}

edit_error: fn(kind: String, message: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)}}}"
}

edit_conflict: fn(message: String, current_revision: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"ok\":false,\"kind\":\"conflict\",\"message\":{json_str(message)},\"current_revision\":{json_str(current_revision)}}}"
}

edit_error_with_diagnostics: fn(kind: String, message: String, path: String, src: String, diags: [Diagnostic]) -> String Never! {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)},\"revision\":{json_str(source_revision(src))},\"diagnostic_revision\":{json_str(source_revision(src))},\"diagnostics\":[{diagnostics_json(path, src, diags)}]}}"
}

query_error: fn(kind: String, message: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{QUERY_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)}}}"
}

query_error_with_diagnostics: fn(kind: String, message: String, path: String, src: String, diags: [Diagnostic]) -> String Never! {
    "{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{QUERY_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)},\"revision\":{json_str(source_revision(src))},\"diagnostic_revision\":{json_str(source_revision(src))},\"diagnostics\":[{diagnostics_json(path, src, diags)}]}}"
}

project_edit_ok_with_audit: fn(op: String, preview: Bool, changed: Bool, before_revision: String, after_revision: String, touched_files: String, diff: String, audit: String) -> String Never! {
    game_audit: if audit.is_empty() -> "" else -> ",\"game_selection\":{audit}"
    writes: if preview -> "\"preview_only\"" else -> "\"source_transaction\""
    "{{\"protocol\":\"jet.canvas.project.edit\",\"schema_version\":{PROJECT_SCHEMA_VERSION},\"ok\":true,\"op\":{json_str(op)},\"preview\":{json_bool(preview)},\"changed\":{json_bool(changed)},\"project_revision\":{json_str(before_revision)},\"after_project_revision\":{json_str(after_revision)},\"writes\":{writes},\"authority\":[\"canvas.source_edit:project\"],\"audit\":{{\"touched_files\":[{touched_files}],\"diagnostics\":[]{game_audit}}},\"diff\":{json_str(diff)}}}"
}

project_edit_error: fn(kind: String, message: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.project.edit\",\"schema_version\":{PROJECT_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)}}}"
}

project_edit_conflict: fn(message: String, current_revision: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.project.edit\",\"schema_version\":{PROJECT_SCHEMA_VERSION},\"ok\":false,\"kind\":\"conflict\",\"message\":{json_str(message)},\"current_revision\":{json_str(current_revision)}}}"
}

diagnostics_error: fn(path: String, src: String, diags: [Diagnostic]) -> String Never! {
    edit_error_with_diagnostics("diagnostic", diagnostic_render_all(path, src, diags, false), path, src, diags)
}

query_diagnostics_error: fn(path: String, src: String, diags: [Diagnostic]) -> String Never! {
    query_error_with_diagnostics("diagnostic", diagnostic_render_all(path, src, diags, false), path, src, diags)
}

// One report object per diagnostic: what Canvas shows beside a refused edit.
diagnostics_json: fn(path: String, src: String, diags: [Diagnostic]) -> String Never! {
    sources := diagnostic_source_texts()
    reports: loop diagnostic in diags -> {
        severity: if diagnostic.severity == DIAGNOSTIC_LINT -> "warning" else -> "error"
        position: if diagnostic.span == .Val(span) -> {
            at: diagnostic_source_position(sources, diagnostic.origin, src)
            "\"line\":{diagnostic_source_line(sources.texts[at], span.start)},\"col\":{diagnostic_source_column(sources.texts[at], span.start)},\"span\":{{\"start\":{span.start},\"end\":{span.end}}}"
        } else -> "\"line\":null,\"col\":null,\"span\":null"
        "{{\"severity\":{json_str(severity)},\"code\":{json_str(diagnostic.code)},\"what\":{json_str(diagnostic.what)},\"why\":{json_str(diagnostic.why)},\"fix\":{json_str(diagnostic.fix)},\"file\":{json_str(path)},{position}}}"
    }
    reports.join(",")
}
