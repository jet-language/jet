// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:16
pub fn graph_id(module_display: String, f: &AST.Func) -> String {
    file :: OSPath.new(module_display).file_name().and_then((s) -> s.to_str()).unwrap_or(module_display)
    format("fn:{}::{}@{}-{}", file, f.name, f.name_span.start, f.name_span.end)
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:27
pub fn span_through_closing_parens(src: String, span: Span) -> SourceSpan {
    text :: src.get(span.start..span.end) ?? return SourceSpan(start: span.start, end: span.end)
    opens :: text.bytes().filter((byte) -> byte == 40).count()
    closes := text.bytes().filter((byte) -> byte == 41).count()
    end := span.end
    loop closes < opens && src.as_bytes().get(end) == .Some(41) {
        end += 1
        closes += 1
    }
    SourceSpan(start: span.start, end: end)
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:44
pub fn graph_id_name_span(graph_id: String) -> SourceSpan? {
    (_, range) :: graph_id.rsplit_once('@')?
    (start, end) :: range.split_once('-')?
    .Some(SourceSpan(start: start.parse().ok()?, end: end.parse().ok()?))
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:53
pub fn function_signature_span(src: String, name_span: SourceSpan) -> SourceSpan Err! {
    start :: line_start(src, name_span.start)
    brace_rel :: src[name_span.end.min(src.len())..].find('{') ?? return .Err(edit_error("not_found", "Canvas function signature no longer has a body"))
    end := name_span.end + brace_rel
    loop end > start && src.as_bytes()[end - 1].is_ascii_whitespace() { end -= 1 }
    .Ok(SourceSpan(start: start, end: end))
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:71
pub fn insert_offset(src: String, f: &AST.Func) -> Usize {
    if first :: f.body.first() {
        first_start :: first.span().start
        line :: line_start(src, first_start)
        if src[line..first_start].contains('{') -> return first_start
        return line
    }
    line_after(src, f.name_span.end)
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:83
pub fn line_start(src: String, offset: Usize) -> Usize {
    src[..offset.min(src.len())].rfind('\n').map((i) -> i + 1).unwrap_or(0)
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:90
pub fn line_after(src: String, offset: Usize) -> Usize {
    src[offset.min(src.len())..].find('\n').map((i) -> offset + i + 1).unwrap_or(src.len())
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:97
pub fn indentation_at(src: String, offset: Usize) -> String {
    start :: line_start(src, offset)
    src[start..offset.min(src.len())].chars().take_while((c) -> c == ' ' || c == '\t').collect()
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:105
pub fn assignment_title(target: &AST.LValue, op: AST.BinOp?) -> String {
    op_text :: op.map((op) -> format("{:?}=", op)).unwrap_or("=")
    if target is {
        .Local(name: name, ..) -> format("{} {}", name, op_text)
        .Index(..) -> format("index {}", op_text)
        .Field(field: field, ..) -> format(".{} {}", field, op_text)
    }
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:116
pub fn lvalue_type(g: &GraphBuilder, target: &AST.LValue) -> String {
    if target is {
        .Local(name: name, ..) -> g.local_types.get(name).cloned().unwrap_or("unknown")
        .Index(..) | .Field(..) -> "unknown"
    }
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:127
pub fn expr_title(expr: &Expr) -> String {
    if expr is {
        .StructLit(..) -> "construct"
        .EnumLit(..) -> "variant"
        .Lambda(_) -> "lambda"
        .If(..) -> "if expression"
        .ListLit(_, _) -> "list"
        .MapLit(_, _) -> "map"
        .TupleLit(_, _, _) -> "tuple"
        .Index(..) -> "index"
        .Slice(..) -> "slice"
        .CallValue(..) -> "call value"
        .Deref(_, _) | .RawOf(_, _) | .PtrFromAddr(..) -> "unsafe expr"
        .OrFallback(..) -> "fallback"
        .PatternTest(..) -> "pattern test"
        .Try(_, _, _, _) -> "fallible"
        _ -> "expression"
    }
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:147
pub fn starts_uppercase(s: String) -> Bool {
    s.chars().next().map((c) -> c.is_uppercase()).unwrap_or(false)
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:151
pub fn binding_type(g: &GraphBuilder, name: String, b: &AST.Binding) -> String {
    b.ty.as_ref().map((ty) -> ty.name()).or_else(() -> g.local_types.get(name).cloned()).unwrap_or("unknown")
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:158
pub fn expr_type(g: &GraphBuilder, index: &SemIndex, expr: &Expr) -> String {
    if expr is {
        .Int(_, _, _, _) -> "Int"
        .Float(_, _, is_f32, _) -> if is_f32 { "F32" } else { "Float" }
        .Bool(_, _) -> "Bool"
        .Str(_, _) -> "String"
        .Char(_, _) -> "Char"
        .Ident(name, _) -> {
            if ty :: g.local_types.get(name) -> return ty.clone()
            loop definition in index.definitions() {
                if definition.name != name -> continue
                if definition.kind is .Function(params: params, ret: ret, ..) {
                    param_text :: params.iter().map(((_, ty)) -> ty.as_str()).collect::<[String]>().join(", ")
                    ret_text :: ret.as_ref().map((ty) -> format(" {}", ty)).unwrap_or_default()
                    return format("fn({}){}", param_text, ret_text)
                }
            }
            "unknown"
        }
        .Binary(op, left, _, _) -> if op_is_bool(op) { "Bool" } else { expr_type(g, index, left) }
        .Call(c) -> call_ret(index, c.name).unwrap_or("unknown")
        .MethodCall(resolved_ret: resolved_ret, ..) -> resolved_ret.as_ref().map((ty) -> ty.name()).unwrap_or("unknown")
        .Try(inner, _, _, _) -> {
            ty := expr_type(g, index, inner).trim_end_matches('?') // #4303
            ty.to_string()
        }
        _ -> "unknown"
    }
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:208
fn op_is_bool(op: AST.BinOp) -> Bool {
    if op is {
        .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .And | .Or -> true
        _ -> false
    }
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:222
pub fn call_ret(index: &SemIndex, name: String) -> String? {
    loop d in index.definitions() {
        if d.name == name {
            if d.kind is .Function(ret: ret, ..) {
                if value :: ret -> return .Some(value.clone())
            }
        }
    }
    .None
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:233
fn callable_signature_for_name(index: &SemIndex, function: String) -> &CallableSignatureFact? {
    loop definition in index.definitions() {
        if definition.name == function && definition.kind is .Function(..) {
            return definition.callable_signature.as_ref()
        }
    }
    .None
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:247
pub fn effect_badges(index: &SemIndex, function: String) -> [String] {
    if signature :: callable_signature_for_name(index, function) {
        return if signature.effects is {
            .Checked(effects) -> if effects.is_empty() { [] } else { ["effects"] }
            .Unavailable(_) -> ["effects_unavailable"]
        }
    }
    if effects :: index.effect_of(function) {
        if !effects.direct.is_empty() || !effects.inferred.is_empty() -> return ["effects"]
        return []
    }
    ["effects_unavailable"]
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:268
pub fn call_has_effects(index: &SemIndex, function: String) -> Bool {
    if signature :: callable_signature_for_name(index, function) {
        return if signature.effects is {
            .Checked(effects) -> !effects.is_empty()
            .Unavailable(_) -> true
        }
    }
    index.effect_of(function).map((effects) -> !effects.direct.is_empty() || !effects.inferred.is_empty()).unwrap_or(true)
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:281
pub fn pure_leaf(expr: &Expr) -> Bool {
    if expr is {
        .Str(_, _) | .Int(_, _, _, _) | .Float(_, _, _, _) | .Bool(_, _) | .Char(_, _) | .Ident(_, _) | .Field(_, _, _) | .OptField(..) | .Absent(_) | .Todo(..) -> true
        .Unary(_, inner, _) | .Paren(inner, _) | .Copy(inner, _) -> pure_leaf(inner)
        .Binary(_, left, right, _) -> pure_leaf(left) && pure_leaf(right)
        .CompareChain(operands: operands, ..) -> operands.iter().all((operand) -> pure_leaf(operand))
        .ListLit(_, _) -> false
        .MapLit(items, _) -> items.iter().all(((k, v)) -> pure_leaf(k) && pure_leaf(v))
        .TupleLit(items, _, _) -> items.iter().all(((_, e)) -> pure_leaf(e))
        .Ok(inner, _) | .Err(inner, _) | .Present(inner, _) -> pure_leaf(inner)
        _ -> false
    }
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:304
pub fn wire_ident_refs(g: &GraphBuilder, expr: &Expr, input_pin: String) -> {
    if expr is .Ident(name, span) {
        if out :: g.local_pins.get(name).cloned() {
            add_wire_with_span(g, out, input_pin, "data", .Some(SourceSpan(start: span.start, end: span.end)))
        }
    }
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:312
pub fn snippet(src: String, span: Span) -> String {
    text := src.get(span.start..span.end).unwrap_or("").trim() // #4303
    text.to_string()
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:319
pub fn edit(span: SourceSpan, text: String) -> TextEdit {
    TextEdit(span: Span.new(span.start, span.end), new_text: text.to_string())
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:326
pub fn edit_ok(changed: Bool, path: &OSPath) -> String {
    src :: read_source_without_symlinks(path).unwrap_or_default()
    edit_ok_source(changed, src)
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:331
pub fn edit_ok_source(changed: Bool, src: String) -> String {
    format("{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{},\"changed\":{},\"revision\":{},\"source_text\":{}}}", EDIT_SCHEMA_VERSION, if changed { "true" } else { "false" }, json_str(source_revision(src)), json_str(src))
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:341
pub fn preview_ok(before: String, after: String) -> String {
    format("{{\"protocol\":\"jet.canvas.preview\",\"schema_version\":{},\"changed\":{},\"diff\":{},\"after_revision\":{}}}", EDIT_SCHEMA_VERSION, if before != after { "true" } else { "false" }, json_str(simple_diff(before, after)), json_str(source_revision(after)))
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:351
pub fn canvas_action_preview_ok(path: &OSPath, before: String, after: String, action_id: String, callee: String) -> String {
    authority :: canvas_authority_context(path)
    format("{{\"protocol\":\"jet.canvas.action\",\"schema_version\":{},\"ok\":true,\"changed\":{},\"action_id\":{},\"callee\":{},\"engine\":\"checked-tir+jit\",\"execution\":\"preview\",\"writes\":\"source_transaction_only\",\"authority\":[{}],\"audit\":{{\"package_id\":{},\"version\":{},\"hash\":{},\"touched_files\":[{}],\"diagnostics\":[]}},\"diff\":{},\"after_revision\":{}}}", ACTION_SCHEMA_VERSION, if before != after { "true" } else { "false" }, json_str(action_id), json_str(callee), json_str(authority.grant), json_str(authority.package_id), json_str(authority.version), json_str(source_revision(after)), json_str(authority.touched_file), json_str(simple_diff(before, after)), json_str(source_revision(after)))
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:375
pub fn query_ok(op: String, src: String, results_json: String, extra_fields: String) -> String {
    format("{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{},\"ok\":true,\"op\":{},\"revision\":{},\"results\":{},{} }}", QUERY_SCHEMA_VERSION, json_str(op), json_str(source_revision(src)), results_json, extra_fields)
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:386
pub fn query_result_json(kind: String, title: String, symbol: String, module_path: String, span: SourceSpan, node: &NodeQueryRef?, src: String) -> String {
    (graph_id, node_id, node_kind) :: if node is {
        .Some(n) -> (n.graph_id.as_str(), n.node_id.as_str(), n.kind.as_str())
        .None -> ("", "", "")
    }
    format("{{\"kind\":{},\"title\":{},\"symbol\":{},\"module_path\":{},\"graph_id\":{},\"node_id\":{},\"node_kind\":{},\"source_span\":{},\"line\":{},\"excerpt\":{}}}", json_str(kind), json_str(title), json_str(symbol), json_str(module_path), json_str(graph_id), json_str(node_id), json_str(node_kind), span_json(span), line_number_for(src, span.start), json_str(source_line_for(src, span.start)))
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:414
pub fn open_query_context(path: &OSPath, src: String) -> (Projection, SemIndex) Err! {
    projection :: project_file(path).map_err((diags) -> query_diagnostics_error(path, src, diags))?
    index :: semindex.open(path).map_err((e) -> query_error("check", e.to_string()))?
    .Ok((projection, index))
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:421
pub fn node_for_span(projection: &Projection, span: SourceSpan) -> NodeQueryRef? {
    projection.node_refs.iter().filter((node) -> spans_overlap(node.span, span)).min_by_key((node) -> node.span.end.saturating_sub(node.span.start)).cloned()
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:430
pub fn nearest_node(projection: &Projection, offset: Usize) -> NodeQueryRef? {
    projection.node_refs.iter().min_by_key((node) -> {
        if offset < node.span.start { node.span.start - offset } else { offset.saturating_sub(node.span.end) }
    }).cloned()
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:444
pub fn spans_overlap(a: SourceSpan, b: SourceSpan) -> Bool {
    a.start <= b.end && b.start <= a.end
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:448
pub fn contains_ci(text: String, needle: String) -> Bool {
    text.to_ascii_lowercase().contains(needle.to_ascii_lowercase())
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:453
pub fn text_matches(src: String, needle: String) -> [SourceSpan] {
    out: [SourceSpan] := []
    if needle.is_empty() -> return out
    hay :: src.to_ascii_lowercase()
    lower_needle :: needle.to_ascii_lowercase()
    offset := 0
    loop {
        pos :: hay[offset..].find(lower_needle) ?? break
        start :: offset + pos
        end :: start + lower_needle.len()
        out.push(SourceSpan(start: start, end: end))
        offset = end
    }
    out
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:470
pub fn dedupe_results(results: &[String]) -> {
    seen: [String] := []
    results.retain((r) -> {
        if seen.iter().any((s) -> s == r) { false } else {
            seen.push(r.clone())
            true
        }
    })
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:482
fn line_number_for(src: String, offset: Usize) -> Usize {
    boundary :: floor_char_boundary(src, offset)
    src[..boundary].bytes().filter((b) -> b == 10).count() + 1
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:487
fn source_line_for(src: String, offset: Usize) -> String {
    boundary :: floor_char_boundary(src, offset)
    start :: src[..boundary].rfind('\n').map((i) -> i + 1).unwrap_or(0)
    end :: src[boundary..].find('\n').map((i) -> boundary + i).unwrap_or(src.len())
    text := src[start..end].trim() // #4303
    text.to_string()
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:497
fn floor_char_boundary(src: String, offset: Usize) -> Usize {
    boundary := offset.min(src.len())
    loop boundary > 0 && !src.is_char_boundary(boundary) { boundary -= 1 }
    boundary
}

// Rust: crates/jet-devserver/src/Canvas/graph_helpers.rs:505
pub fn simple_diff(before: String, after: String) -> String {
    before_lines :: before.lines().collect::<[String]>()
    after_lines :: after.lines().collect::<[String]>()
    out := "--- before\n+++ after\n".to_string()
    loop line in before_lines {
        if !after_lines.contains(line) {
            out.push('-')
            out.push_str(line)
            out.push('\n')
        }
    }
    loop line in after_lines {
        if !before_lines.contains(line) {
            out.push('+')
            out.push_str(line)
            out.push('\n')
        }
    }
    out
}

