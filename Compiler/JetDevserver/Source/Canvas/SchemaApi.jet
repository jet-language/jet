// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:1052
fn apply_transaction_json_inner(path: OSPath, request: String) -> String Err! {
    path :: if source_id :: json_string_field(request, "source_id") {
        project_path_for_source_id(path, source_id).ok_or_else(() -> edit_error("not_found", "Canvas source_id must name a projected Jet source file"))?
    } else { path.to_path_buf() }
    edit_transaction.apply_transaction_json(path, request)
}
