// The Canvas machine API: every graph, project, query, proof, command, edit
// and debug request answers as one `jet.status/v1` envelope whose `canvas`
// field carries the Canvas protocol payload.
use {
    schema_files: core.files
    schema_process: core.process
    schema_sys: core.sys
    schema_time: core.time
    jet_canvas.[GRAPH_SCHEMA_VERSION, QUERY_SCHEMA_VERSION, json_bool, json_str, query_error, read_source_without_symlinks, source_revision]
    jet_debug.[render_event_observations]
    jet_foundation.[DIAGNOSTIC_ERROR, Diagnostic, Span, diagnostic_render_all, foundation_parse_protocol_json_with_limit]
    jet_lsp.[LSPChecker, LSPOverlay]
    jet_pkg_model.[WorkspaceDeclarationCache]
    jetpack_foundation.[FILE_EXT, StatusEnvelope]
}

EDIT_SCHEMA_VERSION: 1

ACTION_SCHEMA_VERSION: 1

PROJECT_SCHEMA_VERSION: 1

CORE_CATALOG_SCHEMA_VERSION: 1

PROOF_SCHEMA_VERSION: 1

// Generated Canvas catalogs may exceed the default untrusted-input ceiling.
CANVAS_PAYLOAD_LIMIT: 16777216

canvas_machine_output: fn(action: String, ok: Bool, payload: String) -> String Never! {
    trimmed: payload.trim()
    value: foundation_parse_protocol_json_with_limit(trimmed, CANVAS_PAYLOAD_LIMIT) ?? Dyn.Text(trimmed)
    StatusEnvelope.new(action, ok).with_field("canvas", value).json() ?? query_error("render", err.message)
}

canvas_machine_success: fn(action: String, payload: String) -> String Never! {
    canvas_machine_output(action, true, payload)
}

canvas_machine_error: fn(action: String, payload: String) -> String Never! {
    canvas_machine_output(action, false, payload)
}

graph_json_for_file: fn(checker: LSPChecker, path: String) -> String Err! {
    projection: project_file(checker, path) ?? return Err(graph_json_error_for_file(path, err.diagnostics))
    Ok(canvas_machine_success("canvas.graph", projection.json))
}

graph_json_error_for_file: fn(path: String, diags: [Diagnostic]) -> String {
    src: read_source_without_symlinks(path) ?? ""
    canvas_machine_error("canvas.graph", query_error("diagnostic", diagnostic_render_all(path, src, diags, false)))
}

graph_json_for_entry_source: fn(checker: LSPChecker, entry: String, source_id: String?) -> String Err! {
    path: resolve_entry_source_path(entry, source_id) ?? return Err(canvas_machine_error("canvas.graph", err.message))
    graph_json_for_file(checker, path)
}

graph_json_for_entry_source_with_live_pid: fn(checker: LSPChecker, entry: String, source_id: String?, pid: Int) -> String Err! {
    snapshot: live_inspect_read(pid) ?? return Err(canvas_machine_error("canvas.graph", query_error("live", err.message)))
    runtime_events: runtime_events_json(snapshot) ?? return Err(canvas_machine_error("canvas.graph", err.message))
    path: resolve_entry_source_path(entry, source_id) ?? return Err(canvas_machine_error("canvas.graph", err.message))
    context: project_file_context(checker, path, Val(runtime_events)) ?? return Err(graph_json_error_for_file(path, err.diagnostics))
    Ok(canvas_machine_success("canvas.graph", context.projection.json))
}

// One field of a runtime event observation: `key` is its observation word,
// `name` its Canvas JSON member, and `text` marks a quoted value.
RuntimeEventField: struct {
    name: String
    key: String
    text: Bool
}

runtime_event_fields: fn() -> [RuntimeEventField] Never! {
    [RuntimeEventField]{
        RuntimeEventField{name: "sequence", key: "sequence", text: false},
        RuntimeEventField{name: "source", key: "source", text: true},
        RuntimeEventField{name: "event_id", key: "event", text: false},
        RuntimeEventField{name: "owner_id", key: "owner", text: false},
        RuntimeEventField{name: "subscription_id", key: "subscription", text: false},
        RuntimeEventField{name: "dispatch_id", key: "dispatch", text: false},
        RuntimeEventField{name: "lifecycle", key: "lifecycle", text: true},
        RuntimeEventField{name: "queued", key: "queued", text: false},
        RuntimeEventField{name: "blocked", key: "blocked", text: false},
        RuntimeEventField{name: "running", key: "running", text: false},
        RuntimeEventField{name: "capacity", key: "capacity", text: false},
        RuntimeEventField{name: "overflow", key: "overflow", text: true},
        RuntimeEventField{name: "priority", key: "priority", text: false},
        RuntimeEventField{name: "failure", key: "failure", text: true},
        RuntimeEventField{name: "terminal", key: "terminal", text: true},
    }
}

// The Canvas JSON of one `key=value` observation line; None when a field is
// missing.
runtime_event_json: fn(line: String) -> String? Never! {
    values := [String:String]{}
    loop word in debug_words(line) {
        pair: word.split_once("=") ?? next
        values[pair.before] = pair.after
    }
    members := [String]{}
    loop field in runtime_event_fields() {
        value: values.get(field.key) ?? return None
        rendered: if field.text -> json_str(value) else -> value
        members.push("\"{field.name}\":{rendered}")
    }
    Val("{{{members.join(",")}}}")
}

runtime_events_json: fn(snapshot: String) -> String Err! {
    rendered: render_event_observations(snapshot) ?? return Err(query_error("live", err.message))
    events := [String]{}
    loop line in debug_lines(rendered) {
        event: runtime_event_json(line) ?? return Err(query_error("live", "runtime event observation is incomplete"))
        events.push(event)
    }
    Ok("{{\"source_truth\":\"executed_runtime_observations\",\"events\":[{events.join(",")}]}}")
}

// The project source file `source_id` names, relative to the entry's project.
project_path_for_source_id: fn(entry: String, source_id: String) -> String? {
    wanted: clean_project_rel_path(source_id) ?? return None
    if !wanted.ends_with(".{FILE_EXT}") -> return None
    ctx: project_context_for_entry(entry)
    loop file in ctx.files {
        if file.kind == "source" && file.path == wanted {
            return Val(schema_files.join(ctx.project_root, file.path))
        }
    }
    candidate: schema_files.join(ctx.project_root, wanted)
    info: schema_files.stat(candidate) ?? return None
    if !info.is_file -> return None
    if validate_project_path(ctx.project_root, candidate, wanted) == .Err(_) -> return None
    loop root in project_source_roots(ctx) {
        if path_is_within(candidate, root) -> return Val(candidate)
    }
    None
}

resolve_entry_source_path: fn(entry: String, source_id: String?) -> String Err! {
    id: source_id ?? return Ok(entry)
    path: project_path_for_source_id(entry, id) ?? return Err(query_error("not_found", "Canvas source_id must name a projected Jet source file"))
    Ok(path)
}

project_source_roots: fn(ctx: ProjectContext) -> [String] {
    if ctx.workspace_root == .Val(workspace_root) {
        cache := WorkspaceDeclarationCache.new()
        view: workspace_view(cache, workspace_root)
        if !view.source_failed && view.members.len() > 0 {
            roots: loop member in view.members -> schema_files.join(workspace_root, member.path)
            return roots
        }
    }
    if ctx.manifest_root == .Val(root) -> return [String]{root}
    if ctx.ecosystem_root == .Val(root) -> return [String]{root}
    [String]{entry_parent(ctx.entry_path)}
}

project_capabilities_json: fn(packages: String, targets: String, environment: EnvProjectJSON) -> String Never! {
    target_text: "{packages}{targets}".lower()
    service: environment.services != "" || target_text.contains("\"kind\":\"service\"") || target_text.contains("\"target\":\"service\"")
    has_checked_output := false
    checked_kinds: [String]{"library", "executable", "service", "check", "environment", "image", "bundle", "system", "fleet"}
    loop kind in checked_kinds {
        if target_text.contains("\"kind\":\"{kind}\"") -> has_checked_output = true
    }
    runtime_output: !has_checked_output || target_text.contains("\"kind\":\"executable\"") || target_text.contains("\"kind\":\"service\"") || service
    designer: target_text.contains("\"kind\":\"ui\"") || target_text.contains("\"kind\":\"game\"") || target_text.contains("\"target\":\"ui\"") || target_text.contains("\"target\":\"game\"")
    preview: designer || target_text.contains("\"target\":\"web\"")
    capabilities := [String]{"\"graph\":true", "\"code\":true", "\"diagnostics\":true"}
    if runtime_output -> capabilities.push("\"runtime_output\":true")
    if runtime_output && !preview -> capabilities.push("\"terminal\":true")
    if service -> capabilities.push("\"service\":true")
    if preview -> capabilities.push("\"preview\":true")
    if designer -> capabilities.push("\"designer\":true")
    "{{{capabilities.join(",")}}}"
}

project_json_for_entry: fn(path: String) -> String {
    canvas_machine_success("canvas.project", project_json_for_entry_inner(path))
}

project_json_for_entry_inner: fn(path: String) -> String {
    ctx: project_context_for_entry(path)
    workspace_json: workspace_project_json(ctx.project_root, ctx.workspace_root)
    packages_json: packages_project_json(ctx.project_root, ctx.entry_path, ctx.manifest_root, ctx.ecosystem_root, ctx.workspace_root)
    targets_json: targets_project_json(ctx.project_root, ctx.entry_path, ctx.manifest_root, ctx.ecosystem_root, ctx.workspace_root)
    files: loop file in ctx.files -> "{{\"path\":{json_str(file.path)},\"revision\":{json_str(file.revision)},\"kind\":{json_str(file.kind)}}}"
    locks_json: lock_project_json(ctx.project_root)
    environment: env_project_json(ctx.project_root)
    capabilities_json: project_capabilities_json(packages_json, targets_json, environment)
    diagnostics := [String]{}
    if ctx.authority_diagnostic == .Val(diagnostic) -> diagnostics.push(diagnostic_json(diagnostic))
    if environment.diagnostics != "" -> diagnostics.push(environment.diagnostics)
    mode: if {
        ctx.workspace_root != None -> "workspace"
        ctx.manifest_root != None || ctx.ecosystem_root != None -> "package"
        else -> "single_file"
    }
    state_policy: "{{\"semantic\":\"source\",\"local\":[\"tabs\",\"viewport\",\"selection\",\"breakpoints\",\"watches\",\"comment_boxes\",\"staged_nodes\"],\"shared_visual\":\"source-anchored-comments\"}}"
    "{{\"protocol\":\"jet.canvas.project\",\"schema_version\":{PROJECT_SCHEMA_VERSION},\"project_root\":{json_str(ctx.project_root)},\"project_revision\":{json_str(ctx.project_revision)},\"entry\":{json_str(rel_path(ctx.project_root, ctx.entry_path))},\"mode\":{json_str(mode)},\"capabilities\":{capabilities_json},\"workspace\":{workspace_json},\"packages\":[{packages_json}],\"targets\":[{targets_json}],\"outputs\":[{targets_json}],\"envs\":[{environment.envs}],\"services\":[{environment.services}],\"files\":[{files.join(",")}],\"locks\":[{locks_json}],\"diagnostics\":[{diagnostics.join(",")}],\"source_control\":{{\"truth\":\"git-text\"}},\"state_policy\":{state_policy}}}"
}

apply_project_transaction_json: fn(checker: LSPChecker, path: String, request: String) -> String Err! {
    payload: apply_project_transaction_payload(checker, path, request) ?? return Err(canvas_machine_error("canvas.project.edit", err.message))
    Ok(canvas_machine_success("canvas.project.edit", payload))
}

apply_project_transaction_payload: fn(checker: LSPChecker, path: String, request: String) -> String Err! {
    ctx: project_context_for_entry(path)
    if ctx.authority_diagnostic == .Val(diagnostic) {
        return Err(project_edit_error("stale", diagnostic.what))
    }
    if (json_int_field(request, "schema_version") ?? 0) != PROJECT_SCHEMA_VERSION {
        return Err(project_edit_error("schema", "Canvas project transaction schema_version must be 1"))
    }
    project_revision: required_project_string(request, "project_revision")
    if project_revision != ctx.project_revision {
        return Err(project_edit_conflict("project changed since this Canvas transaction was drawn", ctx.project_revision))
    }
    op: required_project_string(request, "op")
    touched: required_project_touched_files(request)
    validate_touched_project_files(ctx, touched)
    if op == {
        "add_dependency" -> return apply_project_add_dependency(checker, ctx, request, touched)
        "remove_dependency" -> return apply_project_remove_dependency(checker, ctx, request, touched)
        "edit_pkg_field" -> return apply_project_edit_pkg_field(checker, ctx, request, touched)
        "edit_game_selection" -> return apply_project_edit_game_selection(checker, ctx, request, touched)
        "add_target" -> return apply_project_add_target(checker, ctx, request, touched)
        "create_package" -> return apply_project_create_package(checker, ctx, request, touched)
        "add_workspace_member" -> return apply_project_add_workspace_member(checker, ctx, request, touched)
        "add_env_service" -> return apply_project_add_env_service(checker, ctx, request, touched)
        "rename_binding" | "rename_function" -> return apply_project_rename(checker, ctx, request, touched)
        else -> {}
    }
    Err(project_edit_error("unsupported", "unknown Canvas project transaction operation"))
}

// The source at `path`, refused unless it is still the revision the request
// was drawn against.
current_query_source: fn(path: String, request: String) -> String Err! {
    src: read_source_without_symlinks(path) ?? return Err(query_error("io", err.message))
    revision: required_query_string(request, "revision")
    if revision != source_revision(src) {
        return Err(query_error("conflict", "source changed since this Canvas graph was drawn"))
    }
    Ok(src)
}

query_json_for_file_inner: fn(checker: LSPChecker, path: String, request: String) -> String Err! {
    src: current_query_source(path, request)
    if (json_int_field(request, "schema_version") ?? 0) != QUERY_SCHEMA_VERSION {
        return Err(query_error("schema", "Canvas query schema_version must be 1"))
    }
    op: required_query_string(request, "op")
    if op == {
        "find" | "project_search" -> {
            query: required_query_string(request, "query")
            return canvas_find(checker, path, src, query)
        }
        "references" -> {
            symbol: required_query_string(request, "symbol")
            return canvas_references(checker, path, src, symbol)
        }
        "source_to_graph" -> {
            start: json_int_field(request, "start") ?? 0
            end: json_int_field(request, "end") ?? start
            return canvas_source_to_graph(checker, path, src, Span{start: start, end: end})
        }
        "preview_rename" -> {
            symbol: required_query_string(request, "symbol")
            to: required_query_string(request, "to")
            validate_query_ident(to)
            return canvas_preview_rename(checker, path, src, symbol, to)
        }
        "actions" | "palette_entries" -> return canvas_actions(checker, path, src)
        "core_catalog" | "corelib_catalog" -> return canvas_core_catalog_query(src, request)
        else -> {}
    }
    Err(query_error("unsupported", "unknown Canvas query operation"))
}

query_json_for_entry: fn(checker: LSPChecker, entry: String, request: String) -> String Err! {
    payload: query_json_for_entry_inner(checker, entry, request) ?? return Err(canvas_machine_error("canvas.query", err.message))
    Ok(canvas_machine_success("canvas.query", payload))
}

query_json_for_entry_inner: fn(checker: LSPChecker, entry: String, request: String) -> String Err! {
    path: resolve_entry_source_path(entry, json_string_field(request, "source_id"))
    if (json_int_field(request, "schema_version") ?? 0) != QUERY_SCHEMA_VERSION {
        return Err(query_error("schema", "Canvas query schema_version must be 1"))
    }
    op: json_string_field(request, "op") ?? ""
    expected_project_revision: json_string_field(request, "project_revision")
    if op == "project_search" {
        src: current_query_source(path, request)
        query: required_query_string(request, "query")
        return canvas_project_find(checker, entry, path, src, query, expected_project_revision)
    }
    if op == "references" {
        src: current_query_source(path, request)
        symbol: required_query_string(request, "symbol")
        return canvas_project_references(checker, entry, path, src, symbol, expected_project_revision)
    }
    if op == "preview_rename" && expected_project_revision != None {
        src: current_query_source(path, request)
        symbol: required_query_string(request, "symbol")
        to: required_query_string(request, "to")
        validate_query_ident(to)
        return canvas_project_preview_rename(checker, entry, path, src, symbol, to, expected_project_revision)
    }
    query_json_for_file_inner(checker, path, request)
}

core_catalog_json_for_entry: fn(entry: String, query: String) -> String Err! {
    src: read_source_without_symlinks(entry) ?? return Err(canvas_machine_error("canvas.core_catalog", query_error("io", err.message)))
    payload: canvas_core_catalog(src, query) ?? return Err(canvas_machine_error("canvas.core_catalog", err.message))
    Ok(canvas_machine_success("canvas.core_catalog", payload))
}

// The Git text state of one project file.
GitFileState: struct {
    status: String
    diff: String
    dirty: Bool
}

git_file_state: fn(root: String, path: String, src: String) -> GitFileState {
    rel: git_relative_path(root, path)
    status: (git_output(root, [String]{"status", "--porcelain", "--", rel}) ?? "").trim()
    tracked: git_output(root, [String]{"ls-files", "--error-unmatch", "--", rel}) != None
    diff: if {
        tracked -> git_output(root, [String]{"diff", "--", rel}) ?? ""
        schema_files.exists(path) -> untracked_diff(rel, src)
        else -> ""
    }
    GitFileState{status: status, diff: diff, dirty: status != "" || diff.trim() != ""}
}

source_control_json_for_entry: fn(path: String) -> String {
    canvas_machine_success("canvas.source_control", source_control_json_for_entry_inner(path))
}

source_control_json_for_entry_inner: fn(path: String) -> String {
    ctx: project_context_for_entry(path)
    root: git_root(path)
    dirty_files := 0
    statuses := [String]{}
    files := [String]{}
    loop file in ctx.files {
        abs: schema_files.join(ctx.project_root, file.path)
        src: read_source_without_symlinks(abs) ?? ""
        state := GitFileState{status: "", diff: "", dirty: false}
        if root == .Val(git) -> state = git_file_state(git, abs, src)
        if state.dirty -> dirty_files += 1
        if state.status != "" -> statuses.push(state.status)
        files.push("{{\"path\":{json_str(file.path)},\"revision\":{json_str(file.revision)},\"kind\":{json_str(file.kind)},\"available\":{json_bool(root != None)},\"dirty\":{json_bool(state.dirty)},\"status\":{json_str(state.status)},\"diff\":{json_str(state.diff)}}}")
    }
    history := [String]{}
    if root == .Val(git) {
        log: git_output(git, [String]{"log", "--oneline", "-5", "--", git_relative_path(git, path)}) ?? ""
        loop line in debug_lines(log) -> history.push(json_str(line))
    }
    entry_src: read_source_without_symlinks(path) ?? ""
    "{{\"protocol\":\"jet.canvas.source_control\",\"schema_version\":1,\"ok\":true,\"revision\":{json_str(source_revision(entry_src))},\"project_revision\":{json_str(ctx.project_revision)},\"project_root\":{json_str(ctx.project_root)},\"available\":{json_bool(root != None)},\"dirty\":{json_bool(dirty_files > 0)},\"dirty_files\":{dirty_files},\"status\":{json_str(statuses.join("\n"))},\"diff\":\"\",\"history\":[{history.join(",")}],\"files\":[{files.join(",")}]}}"
}

proof_json_for_entry_with_receipt: fn(checker: LSPChecker, entry: String, source_id: String?, command_receipt: String?) -> String Err! {
    payload: proof_payload(checker, entry, source_id, command_receipt) ?? return Err(canvas_machine_error("canvas.proof", err.message))
    Ok(canvas_machine_success("canvas.proof", payload))
}

proof_payload: fn(checker: LSPChecker, entry: String, source_id: String?, command_receipt: String?) -> String Err! {
    path: resolve_entry_source_path(entry, source_id)
    src: read_source_without_symlinks(path) ?? return Err(query_error("io", err.message))
    revision: source_revision(src)
    check: if project_file(checker, path) == {
        .Ok(_) -> "{{\"state\":\"ok\",\"diagnostics_count\":0,\"message\":\"front end check passed\"}}"
        .Err(failure) -> "{{\"state\":\"diagnostic\",\"diagnostics_count\":{failure.diagnostics.len()},\"message\":{json_str(diagnostic_render_all(path, src, failure.diagnostics, false))}}}"
    }
    git := "{{\"truth\":\"git-text\",\"available\":false,\"dirty\":false,\"status\":\"not a Git worktree\"}}"
    if git_root(path) == .Val(root) {
        state: git_file_state(root, path, src)
        git = "{{\"truth\":\"git-text\",\"available\":true,\"dirty\":{json_bool(state.dirty)},\"status\":{json_str(state.status)}}}"
    }
    receipt: command_receipt ?? ""
    receipt_current: receipt != "" && receipt.contains("\"revision\":\"{revision}\"")
    command_receipts: if receipt_current -> "{{\"state\":\"current\",\"receipt\":{receipt}}}" else -> "{{\"state\":\"missing\",\"reason\":\"no Canvas command authority receipt has run for this source revision\"}}"
    proof: if receipt_current -> "{{\"state\":\"current\",\"stale\":false,\"reasons\":[]}}" else -> "{{\"state\":\"missing\",\"stale\":true,\"reasons\":[\"no check/build/run receipt for this source revision\"]}}"
    Ok("{{\"protocol\":\"jet.canvas.proof\",\"schema_version\":{PROOF_SCHEMA_VERSION},\"ok\":true,\"source_id\":{json_str(source_id ?? path)},\"source_path\":{json_str(path)},\"revision\":{json_str(revision)},\"check\":{check},\"source_control\":{git},\"debug\":{{\"state\":\"local-only\",\"persistence\":\"local-source-span\"}},\"command_receipts\":{command_receipts},\"proof\":{proof}}}")
}

// The `jet` command a Canvas command action runs, and what it may write.
CommandPlan: struct {
    title: String
    args: [String]
    writes: String
    requires_confirmation: Bool
}

command_plan: fn(action_id: String, source: String, request: String) -> CommandPlan? Never! {
    plan := if action_id == {
        "canvas.command:run" -> CommandPlan{title: "Run program", args: [String]{"run", source}, writes: "none", requires_confirmation: false}
        "canvas.command:check" -> CommandPlan{title: "Check project", args: [String]{"check", source}, writes: "none", requires_confirmation: false}
        "canvas.command:test" -> CommandPlan{title: "Test project", args: [String]{"test", source}, writes: "test_outputs", requires_confirmation: true}
        "canvas.command:build" -> CommandPlan{title: "Build project", args: [String]{"build", source}, writes: "build_outputs", requires_confirmation: true}
        "canvas.command:service.start" -> CommandPlan{title: "Start service", args: [String]{"services", "up"}, writes: "service_process", requires_confirmation: true}
        else -> {
            return None
        }
    }
    if action_id == "canvas.command:run" {
        output: json_string_field(request, "output") ?? ""
        if output != "" -> plan.args.push("--output={output}")
        target: json_string_field(request, "target") ?? ""
        if target != "" -> plan.args.push("--target={target}")
    }
    Val(plan)
}

// What one Canvas command run reported.
CommandOutcome: struct {
    success: Bool
    // None when a signal ended the command.
    exit_code: Int?
    stdout: String
    stderr: String
    diagnostics: String
}

command_receipt_json_for_entry: fn(checker: LSPChecker, entry: String, request: String) -> String Err! {
    payload: command_receipt_payload(checker, entry, request) ?? return Err(canvas_machine_error("canvas.command_receipt", err.message))
    Ok(canvas_machine_success("canvas.command_receipt", payload))
}

command_receipt_payload: fn(checker: LSPChecker, entry: String, request: String) -> String Err! {
    source_id: json_string_field(request, "source_id")
    source_path: resolve_entry_source_path(entry, source_id)
    src: read_source_without_symlinks(source_path) ?? return Err(query_error("io", err.message))
    revision: required_string(request, "revision")
    if revision != source_revision(src) {
        return Err(query_error("conflict", "source changed since this Canvas command was approved"))
    }
    action_id: required_string(request, "action_id")
    authority: canvas_authority_context(source_path)
    source_label: source_id ?? rel_path(project_context_for_entry(entry).project_root, source_path)
    plan: command_plan(action_id, authority.touched_file, request) ?? return Err(query_error("unsupported", "Canvas command execution only supports run, check, test, build, and service.start receipts"))
    if plan.requires_confirmation && !(json_bool_field(request, "confirmed") ?? false) {
        return Err(query_error("confirmation_required", "this Canvas command writes outputs or starts a service and needs confirmed:true"))
    }
    started: schema_time.instant()
    check_src: json_string_field(request, "source_text") ?? src
    outcome := CommandOutcome{success: false, exit_code: None, stdout: "", stderr: "", diagnostics: ""}
    if action_id == "canvas.command:check" {
        outcome = check_command_outcome(checker, source_path, check_src)
    } else { outcome = run_jet_command(authority.project_root, plan.args) }
    elapsed_ms: started.elapsed().ns /% 1000000
    exit_code: if outcome.exit_code == .Val(code) -> "{code}" else -> "null"
    command := [String]{json_str("jet")}
    loop arg in plan.args -> command.push(json_str(arg))
    Ok("{{\"protocol\":\"jet.canvas.command_receipt\",\"schema_version\":1,\"ok\":true,\"action_id\":{json_str(action_id)},\"title\":{json_str(plan.title)},\"source_id\":{json_str(source_label)},\"revision\":{json_str(revision)},\"checked_revision\":{json_str(source_revision(check_src))},\"command\":[{command.join(",")}],\"writes\":{json_str(plan.writes)},\"success\":{json_bool(outcome.success)},\"exit_code\":{exit_code},\"elapsed_ms\":{elapsed_ms},\"stdout\":{json_str(outcome.stdout)},\"stderr\":{json_str(outcome.stderr)},\"diagnostics\":[{outcome.diagnostics}]}}")
}

// The check command checks `src` as the text of `path` in its project.
check_command_outcome: fn(checker: LSPChecker, path: String, src: String) -> CommandOutcome {
    checked: checker.check(path, [LSPOverlay]{LSPOverlay{path: canonical_path(path), source: src}})
    errors := [Diagnostic]{}
    loop diagnostic in checked.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> errors.push(diagnostic)
    }
    if errors.len() == 0 {
        return CommandOutcome{success: true, exit_code: Val(0), stdout: "", stderr: "", diagnostics: ""}
    }
    CommandOutcome{success: false, exit_code: Val(1), stdout: "", stderr: diagnostic_render_all(path, src, errors, false), diagnostics: diagnostics_json(path, src, errors)}
}

// Runs the running `jet` with `args` in `cwd`, its output bounded.
run_jet_command: fn(cwd: String, args: [String]) -> CommandOutcome Err! {
    argv: [String]{schema_sys.executable(), ...args}
    receipt: schema_process.cmd(argv).cwd(cwd).stdout(.Capture).stderr(.Capture).output_limit(MAX_DEBUG_CHILD_OUTPUT_BYTES).run() ?? return Err(query_error("resource_limit", "{err}"))
    exit_code: if receipt.signal == None -> Val(receipt.code) else -> None
    Ok(CommandOutcome{success: receipt.success, exit_code: exit_code, stdout: receipt.output, stderr: receipt.errors, diagnostics: ""})
}

apply_transaction_json: fn(checker: LSPChecker, path: String, request: String) -> String Err! {
    payload: apply_transaction_payload(checker, path, request) ?? return Err(canvas_machine_error("canvas.edit", err.message))
    Ok(canvas_machine_success("canvas.edit", payload))
}

apply_transaction_payload: fn(checker: LSPChecker, path: String, request: String) -> String Err! {
    target := path
    if json_string_field(request, "source_id") == .Val(source_id) {
        target = project_path_for_source_id(path, source_id) ?? return Err(edit_error("not_found", "Canvas source_id must name a projected Jet source file"))
    }
    apply_edit_transaction(checker, target, request)
}

debug_session_json_for_entry_with_sessions_and_host: fn(checker: LSPChecker, entry: String, request: String, sessions: &DebugSessions, host: &PausedEvaluateHost) -> String Err! {
    path: resolve_entry_source_path(entry, json_string_field(request, "source_id")) ?? return Err(canvas_machine_error("canvas.debug", err.message))
    payload: debug_session_payload(checker, path, request, sessions, host) ?? return Err(canvas_machine_error("canvas.debug", err.body))
    Ok(canvas_machine_success("canvas.debug", payload))
}

// Ends session `id` after its source went stale; the session is dropped either
// way, so a failed paused-stop hand-off leaves nothing to keep.
discard_stale_debug_session: fn(sessions: &DebugSessions, host: &PausedEvaluateHost, id: String) {
    sessions.stale_paused_session(host, id).drop("the stale session is discarded either way")
    sessions.discard(id).drop("a session already gone has nothing to discard")
}

// Ends session `id` after a failed or refused step; as above, the session is
// dropped either way.
discard_debug_session: fn(sessions: &DebugSessions, host: &PausedEvaluateHost, id: String) {
    sessions.clear_paused_session(host, id).drop("the failed session is discarded either way")
    sessions.discard(id).drop("a session already gone has nothing to discard")
}

debug_session_payload: fn(checker: LSPChecker, path: String, request: String, sessions: &DebugSessions, host: &PausedEvaluateHost) -> String CanvasDebugError! {
    session_id: json_string_field(request, "session_id")
    src: read_source_without_symlinks(path) ?? {
        if session_id == .Val(id) -> discard_stale_debug_session(sessions, host, id)
        return Err(canvas_debug_error("io", err.message))
    }
    revision: required_debug_string(request, "revision")
    if (json_int_field(request, "schema_version") ?? 0) != DEBUG_SCHEMA_VERSION {
        return Err(canvas_debug_error("schema", "Canvas debug schema_version must be 1"))
    }
    source_id: required_debug_string(request, "source_id")
    requested_tier: DebugTier.parse(json_string_field(request, "tier"))
    current_revision: source_revision(src)
    if json_bool_field(request, "stop") ?? false {
        id: required_debug_string(request, "session_id")
        tier: sessions.stop(path, revision, current_revision, id, requested_tier) ?? {
            if revision != current_revision {
                sessions.stale_paused_session(host, id).drop("the stop failure is reported instead")
            }
            return Err(err)
        }
        sessions.clear_paused_session(host, id)
        return Ok(debug_stop_ok(src, id, tier, source_id))
    }
    if revision != current_revision {
        if session_id == .Val(id) -> discard_stale_debug_session(sessions, host, id)
        return Err(canvas_debug_error("conflict", "source changed since this Canvas debug state was drawn"))
    }
    requested_lines: json_int_array(request, "breakpoints")
    stale_breakpoints := [String]{}
    anchors: json_string_array(request, "breakpoint_spans")
    validate_debug_breakpoint_anchors(anchors)
    candidates := [Int]{}
    loop line in requested_lines -> candidates.push(line)
    loop anchor in anchors {
        if line_from_anchor(src, anchor) == .Val(line) -> candidates.push(line) else {
            stale_breakpoints.push(anchor)
        }
    }
    line_count: debug_lines(src).len()
    candidates.sort()
    breakpoint_lines := [Int]{}
    loop line in candidates {
        if line < 1 || line > line_count {
            stale_breakpoints.push("line:{line}")
            next
        }
        if breakpoint_lines.len() == 0 || breakpoint_lines[breakpoint_lines.len() - 1] != line {
            breakpoint_lines.push(line)
        }
    }
    watches: json_string_array(request, "watches")
    commands: json_string_array(request, "commands")
    validate_debug_limits(commands, breakpoint_lines, watches)
    if session_id == .Val(id) -> sessions.resume_paused_session(host, id)
    execution: sessions.execute(path, source_id, revision, session_id, commands, breakpoint_lines, watches, requested_tier) ?? {
        if session_id == .Val(id) -> discard_debug_session(sessions, host, id)
        return Err(err)
    }
    if execution.status == .Failed {
        sessions.clear_paused_session(host, execution.id).drop("the failed run is reported instead")
        return Err(canvas_debug_error("diagnostic", execution.transcript))
    }
    current_src: read_source_without_symlinks(path) ?? {
        discard_stale_debug_session(sessions, host, execution.id)
        return Err(canvas_debug_error("io", "couldn't re-read debug source: {err.message}"))
    }
    if current_src != src {
        discard_stale_debug_session(sessions, host, execution.id)
        return Err(canvas_debug_error("conflict", "source changed while this Canvas debug command was running; the source was kept"))
    }
    projection: project_file(checker, path) ?? {
        discard_debug_session(sessions, host, execution.id)
        return Err(CanvasDebugError{body: debug_diagnostics_error(path, src, err.diagnostics)})
    }
    if json_string_field(projection.json, "source_id") != Val(source_id) {
        discard_debug_session(sessions, host, execution.id)
        return Err(canvas_debug_error("conflict", "Canvas projection source_id does not match the debug request"))
    }
    if execution.status != .Running {
        sessions.clear_paused_session(host, execution.id).drop("a finished run has no paused stop to keep")
    }
    Ok(
        debug_ok(
            DebugOkRequest{
                src: src,
                graph_json: projection.json,
                transcript: execution.transcript,
                snapshot: execution.snapshot,
                status: execution.status,
                session_id: execution.id,
                tier: execution.tier,
                source_id: source_id,
                breakpoint_lines: breakpoint_lines,
                stale_breakpoints: stale_breakpoints,
                watches: watches,
            },
        ),
    )
}
