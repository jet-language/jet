// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:125
fn runtime_events_json(snapshot: String) -> String Err! {
    rendered :: render_event_observations(snapshot).map_err((message) -> query_error("live", message))?
    events: [String] := []
    for line in rendered.lines() {
        fields: [String:String] :: line.split_whitespace().filter_map((field) -> field.split_once('=')).collect()
        number :: (key) -> fields.get(key).copied().ok_or_else(() -> query_error("live", "runtime event observation is incomplete"))
        text :: (key) -> number(key).map(json_str)
        events.push(format("{{\"sequence\":{},\"source\":{},\"event_id\":{},\"owner_id\":{},\"subscription_id\":{},\"dispatch_id\":{},\"lifecycle\":{},\"queued\":{},\"blocked\":{},\"running\":{},\"capacity\":{},\"overflow\":{},\"priority\":{},\"failure\":{},\"terminal\":{}}}", number("sequence")?, text("source")?, number("event")?, number("owner")?, number("subscription")?, number("dispatch")?, text("lifecycle")?, number("queued")?, number("blocked")?, number("running")?, number("capacity")?, text("overflow")?, number("priority")?, text("failure")?, text("terminal")?))
    }
    .Ok(format("{{\"source_truth\":\"executed_runtime_observations\",\"events\":[{}]}}", events.join(",")))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:169
pub fn project_path_for_source_id(entry: OSPath, source_id: String) -> OSPath? {
    run_compiler_work(() -> project_path_for_source_id_on_compiler_stack(entry, source_id))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:176
fn project_path_for_source_id_on_compiler_stack(entry: OSPath, source_id: String) -> OSPath? {
    wanted :: clean_project_rel_path(source_id).ok()?
    if OSPath.new(wanted).extension().and_then((e) -> e.to_str()) != .Some(Syntax.FILE_EXT) -> return .None
    ctx :: project_context_for_entry(entry)
    if file :: ctx.files.iter().find((f) -> f.kind == "source" && f.path.trim_start_matches("./") == wanted) {
        path :: ctx.project_root.join(file.path)
        return ctx.parts.should_index(path).then_some(path)
    }
    candidate :: ctx.project_root.join(wanted)
    if candidate.is_file() && candidate.extension().and_then((e) -> e.to_str()) == .Some(Syntax.FILE_EXT) && validate_project_path(ctx.project_root, candidate, wanted).is_ok() && project_source_roots(ctx).iter().any((root) -> canonical_path(candidate).starts_with(canonical_path(root))) && ctx.parts.should_index(candidate) -> return .Some(candidate)
    .None
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:205
fn resolve_entry_source_path(entry: OSPath, source_id: String?) -> OSPath Err! {
    id :: source_id ?? return .Ok(entry.to_path_buf())
    project_path_for_source_id(entry, id).ok_or_else(() -> query_error("not_found", "Canvas source_id must name a projected Jet source file"))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:217
fn project_source_roots(ctx: &ProjectContext) -> [OSPath] {
    if workspace_root :: ctx.workspace_root {
        if WorkspaceFile.load_checked(workspace_root) is .Some(.Ok(snapshot)) -> return snapshot.plan.members.into_iter().map((member) -> workspace_root.join(member.path)).collect()
    }
    if root :: ctx.manifest_root -> return [root]
    if root :: ctx.ecosystem_root -> return [root]
    [ctx.entry_path.parent().unwrap_or_else(() -> OSPath.new(".")).to_path_buf()]
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:241
fn project_capabilities_json(packages: String, targets: String, environment: &EnvProjectJson) -> String {
    target_text :: format("{}{}", packages, targets).to_ascii_lowercase()
    service :: !environment.services.is_empty() || target_text.contains("\"kind\":\"service\"") || target_text.contains("\"target\":\"service\"")
    has_checked_output :: ["\"kind\":\"library\"", "\"kind\":\"executable\"", "\"kind\":\"service\"", "\"kind\":\"check\"", "\"kind\":\"environment\"", "\"kind\":\"image\"", "\"kind\":\"bundle\"", "\"kind\":\"system\"", "\"kind\":\"fleet\""].iter().any((kind) -> target_text.contains(kind))
    runtime_output :: !has_checked_output || target_text.contains("\"kind\":\"executable\"") || target_text.contains("\"kind\":\"service\"") || service
    preview :: target_text.contains("\"target\":\"web\"") || target_text.contains("\"kind\":\"ui\"") || target_text.contains("\"kind\":\"game\"") || target_text.contains("\"target\":\"ui\"") || target_text.contains("\"target\":\"game\"")
    designer :: target_text.contains("\"kind\":\"ui\"") || target_text.contains("\"kind\":\"game\"") || target_text.contains("\"target\":\"ui\"") || target_text.contains("\"target\":\"game\"")
    capabilities := ["\"graph\":true", "\"code\":true", "\"diagnostics\":true"]
    if runtime_output -> capabilities.push("\"runtime_output\":true")
    if runtime_output && !preview -> capabilities.push("\"terminal\":true")
    if service -> capabilities.push("\"service\":true")
    if preview -> capabilities.push("\"preview\":true")
    if designer -> capabilities.push("\"designer\":true")
    format("{{{}}}", capabilities.join(","))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:296
pub fn project_json_for_entry(path: OSPath) -> String {
