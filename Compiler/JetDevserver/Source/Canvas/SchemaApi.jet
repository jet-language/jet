pub fn debug_session_json_for_file_with_sessions(path: OSPath, request: String, sessions: &DebugSessions) -> String Err! {
    debug_session_json_for_file_with_sessions_inner(path, request, sessions, .None).map((payload) -> canvas_machine_success("canvas.debug", payload)).map_err((error) -> canvas_machine_error("canvas.debug", error))
