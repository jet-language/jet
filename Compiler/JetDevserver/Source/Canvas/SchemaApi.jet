// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:1121
fn debug_session_json_for_file_with_sessions_inner(path: OSPath, request: String, sessions: &DebugSessions, paused_evaluate: (&PausedEvaluateHost)?) -> String Err! {
    paused_evaluate := paused_evaluate
    src :: if read_source_without_symlinks(path) is {
        .Ok(src) -> src
        .Err(error) -> {
            if id :: json_string_field(request, "session_id") {
                if host :: paused_evaluate.as_mut() { _ :: sessions.stale_paused_session(host, id) }
                sessions.discard(id)
            }
            return .Err(debug_error("io", error.to_string()))
        }
    }
    revision :: required_debug_string(request, "revision")?
    schema :: json_usize_field(request, "schema_version").unwrap_or(0)
    if schema != DEBUG_SCHEMA_VERSION as Usize -> return .Err(debug_error("schema", "Canvas debug schema_version must be 1"))
    source_id :: required_debug_string(request, "source_id")?
    session_id :: json_string_field(request, "session_id")
    requested_tier :: DebugTier.parse(json_string_field(request, "tier"))?
    if json_bool_field(request, "stop").unwrap_or(false) {
        id :: required_debug_string(request, "session_id")?
        current_revision :: source_revision(src)
        tier :: if sessions.stop(path, revision, current_revision, id, requested_tier) is {
            .Ok(tier) -> tier
            .Err(error) -> {
                if revision != current_revision {
                    if host :: paused_evaluate.as_mut() { _ :: sessions.stale_paused_session(host, id) }
                }
                return .Err(error)
            }
        }
        if host :: paused_evaluate.as_mut() -> sessions.clear_paused_session(host, id)?
        return .Ok(debug_stop_ok(src, id, tier, source_id))
    }
    if revision != source_revision(src) {
        if id :: session_id {
            if host :: paused_evaluate.as_mut() { _ :: sessions.stale_paused_session(host, id) }
            sessions.discard(id)
        }
        return .Err(debug_error("conflict", "source changed since this Canvas debug state was drawn"))
    }
    breakpoint_lines := json_usize_array(request, "breakpoints")
    stale_breakpoints: [String] := []
    breakpoint_anchors :: json_string_array(request, "breakpoint_spans")
    validate_debug_breakpoint_anchors(breakpoint_anchors)?
    for anchor in breakpoint_anchors {
        if line :: line_from_anchor(src, anchor) { breakpoint_lines.push(line) }
        else { stale_breakpoints.push(anchor) }
    }
    breakpoint_lines.retain((line) -> {
        if line > 0 && line <= src.lines().count() { true }
        else { stale_breakpoints.push(format("line:{}", line)); false }
    })
    breakpoint_lines.sort_unstable()
    breakpoint_lines.dedup()
    watches :: json_string_array(request, "watches")
    commands :: json_string_array(request, "commands")
    validate_debug_limits(commands, breakpoint_lines, watches)?
    if id :: session_id {
        if host :: paused_evaluate.as_mut() -> sessions.resume_paused_session(host, id)?
    }
    execution :: if sessions.execute(path, source_id, revision, session_id, commands, breakpoint_lines, watches, requested_tier) is {
        .Ok(execution) -> execution
        .Err(error) -> {
            if id :: session_id {
                if host :: paused_evaluate.as_mut() { _ :: sessions.clear_paused_session(host, id) }
                sessions.discard(id)
            }
            return .Err(error)
        }
    }
    if execution.status == SessionStatus.Failed {
        if host :: paused_evaluate.as_mut() { _ :: sessions.clear_paused_session(host, execution.id) }
        return .Err(debug_error("diagnostic", execution.transcript))
    }
    current_src :: if read_source_without_symlinks(path) is {
        .Ok(current_src) -> current_src
        .Err(error) -> {
            if host :: paused_evaluate.as_mut() { _ :: sessions.stale_paused_session(host, execution.id) }
            sessions.discard(execution.id)
            return .Err(debug_error("io", format("couldn't re-read debug source: {}", error)))
        }
    }
    if current_src != src {
        if host :: paused_evaluate.as_mut() { _ :: sessions.stale_paused_session(host, execution.id) }
        sessions.discard(execution.id)
        return .Err(debug_error("conflict", "source changed while this Canvas debug command was running; the source was kept"))
    }
    projection :: if project_file(path) is {
        .Ok(projection) -> projection
        .Err(diags) -> {
            if host :: paused_evaluate.as_mut() { _ :: sessions.clear_paused_session(host, execution.id) }
            sessions.discard(execution.id)
            return .Err(debug_diagnostics_error(path, src, diags))
        }
    }
    projected_source_id :: json_string_field(projection.json, "source_id")
    if projected_source_id != .Some(source_id) {
        if host :: paused_evaluate.as_mut() { _ :: sessions.clear_paused_session(host, execution.id) }
        sessions.discard(execution.id)
        return .Err(debug_error("conflict", "Canvas projection source_id does not match the debug request"))
    }
    if execution.status != SessionStatus.Running {
        if host :: paused_evaluate.as_mut() { _ :: sessions.clear_paused_session(host, execution.id) }
    }
    .Ok(debug_ok(src, projection.json, execution.transcript, execution.snapshot, execution.status, execution.id, execution.tier, source_id, breakpoint_lines, stale_breakpoints, watches))
}
