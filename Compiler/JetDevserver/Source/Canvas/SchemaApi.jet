// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:303
fn project_json_for_entry_inner(path: OSPath) -> String {
    ctx :: project_context_for_entry(path)
    entry_rel :: rel_path(ctx.project_root, path)
    workspace_json :: workspace_project_json(ctx.project_root, ctx.workspace_root)
    packages_json :: packages_project_json(ctx.project_root, ctx.entry_path, ctx.manifest_root, ctx.ecosystem_root, ctx.workspace_root)
    targets_json :: targets_project_json(ctx.project_root, ctx.entry_path, ctx.manifest_root, ctx.ecosystem_root, ctx.workspace_root)
    files_json :: ctx.files.iter().map((f) -> format("{{\"path\":{},\"revision\":{},\"kind\":{}}}", json_str(f.path), json_str(f.revision), json_str(f.kind))).collect().join(",")
    parts_json :: ctx.parts.parts.iter().map((part) -> format("{{\"name\":{},\"path\":{},\"state\":{}}}", json_str(part.canonical_name()), json_str(rel_path(ctx.project_root, part.path)), json_str(part.state.name()))).collect().join(",")
    part_conflicts_json :: ctx.parts.conflicts.iter().map((conflict) -> {
        paths :: conflict.paths.iter().map((path) -> json_str(rel_path(ctx.project_root, path))).collect().join(",")
        format("{{\"name\":{},\"paths\":[{}]}}", json_str(conflict.canonical_name()), paths)
    }).collect().join(",")
    locks_json :: lock_project_json(ctx.project_root)
    env_projection :: env_project_json(ctx.project_root)
    capabilities_json :: project_capabilities_json(packages_json, targets_json, env_projection)
    diagnostics :: [ctx.authority_diagnostic.map(diagnostic_json).unwrap_or_default(), env_projection.diagnostics].into_iter().filter((diagnostic) -> !diagnostic.is_empty()).collect().join(",")
    mode :: if ctx.workspace_root.is_some() { "workspace" } else if ctx.manifest_root.is_some() || ctx.ecosystem_root.is_some() { "package" } else { "single_file" }
    format("{{\"protocol\":\"jet.canvas.project\",\"schema_version\":{},\"project_root\":{},\"project_revision\":{},\"entry\":{},\"mode\":{},\"capabilities\":{},\"workspace\":{},\"packages\":[{}],\"targets\":[{}],\"outputs\":[{}],\"envs\":[{}],\"services\":[{}],\"files\":[{}],\"parts\":[{}],\"part_conflicts\":[{}],\"locks\":[{}],\"diagnostics\":[{}],\"source_control\":{{\"truth\":\"git-text\"}},\"state_policy\":{{\"semantic\":\"source\",\"local\":[\"tabs\",\"viewport\",\"selection\",\"breakpoints\",\"watches\",\"comment_boxes\",\"staged_nodes\"],\"shared_visual\":\"source-anchored-comments\"}}}}", PROJECT_SCHEMA_VERSION, json_str(ctx.project_root.display().to_string()), json_str(ctx.project_revision), json_str(entry_rel), json_str(mode), capabilities_json, workspace_json, packages_json, targets_json, targets_json, env_projection.envs, env_projection.services, files_json, parts_json, part_conflicts_json, locks_json, diagnostics)
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:411
pub fn apply_project_transaction_json(path: OSPath, request: String) -> String Err! {
    run_compiler_work(() -> apply_project_transaction_json_inner(path, request)).map((payload) -> canvas_machine_success("canvas.project.edit", payload)).map_err((error) -> canvas_machine_error("canvas.project.edit", error))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:417
fn apply_project_transaction_json_inner(path: OSPath, request: String) -> String Err! {
    ctx :: project_context_for_entry(path)
    if diagnostic :: ctx.authority_diagnostic -> return .Err(project_edit_error("stale", diagnostic.what))
    schema :: json_usize_field(request, "schema_version").unwrap_or(0)
    if schema != PROJECT_SCHEMA_VERSION as Usize -> return .Err(project_edit_error("schema", "Canvas project transaction schema_version must be 1"))
    project_revision :: required_project_string(request, "project_revision")?
    if project_revision != ctx.project_revision -> return .Err(project_edit_conflict("project changed since this Canvas transaction was drawn", ctx.project_revision))
    op :: required_project_string(request, "op")?
    touched :: required_project_touched_files(request)?
    validate_touched_project_files(ctx, touched)?
    if op is {
        "add_dependency" -> apply_project_add_dependency(ctx, request, touched)
        "remove_dependency" -> apply_project_remove_dependency(ctx, request, touched)
        "edit_pkg_field" -> apply_project_edit_pkg_field(ctx, request, touched)
        "edit_game_selection" -> apply_project_edit_game_selection(ctx, request, touched)
        "add_target" -> apply_project_add_target(ctx, request, touched)
        "create_package" -> apply_project_create_package(ctx, request, touched)
        "add_workspace_member" -> apply_project_add_workspace_member(ctx, request, touched)
        "add_env_service" -> apply_project_add_env_service(ctx, request, touched)
        "rename_binding" | "rename_function" -> apply_project_rename(ctx, request, touched)
        _ -> .Err(project_edit_error("unsupported", "unknown Canvas project transaction operation"))
    }
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:457
pub fn query_json_for_file(path: OSPath, request: String) -> String Err! {
    run_compiler_work(() -> query_json_for_file_inner(path, request)).map((payload) -> canvas_machine_success("canvas.query", payload)).map_err((error) -> canvas_machine_error("canvas.query", error))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:463
fn query_json_for_file_inner(path: OSPath, request: String) -> String Err! {
    src :: read_source_without_symlinks(path).map_err((e) -> query_error("io", e.to_string()))?
    revision :: required_query_string(request, "revision")?
    if revision != source_revision(src) -> return .Err(query_error("conflict", "source changed since this Canvas graph was drawn"))
    schema :: json_usize_field(request, "schema_version").unwrap_or(0)
    if schema != QUERY_SCHEMA_VERSION as Usize -> return .Err(query_error("schema", "Canvas query schema_version must be 1"))
    op :: required_query_string(request, "op")?
    if op is {
        "find" | "project_search" -> canvas_find(path, src, required_query_string(request, "query")?)
        "references" -> canvas_references(path, src, required_query_string(request, "symbol")?)
        "source_to_graph" -> {
            start :: json_usize_field(request, "start").unwrap_or(0)
            end :: json_usize_field(request, "end").unwrap_or(start)
            canvas_source_to_graph(path, src, SourceSpan(start: start, end: end))
        }
        "preview_rename" -> {
            symbol :: required_query_string(request, "symbol")?
            to :: required_query_string(request, "to")?
            validate_query_ident(to)?
            canvas_preview_rename(path, src, symbol, to)
        }
        "actions" | "palette_entries" -> canvas_actions(path, src)
        "core_catalog" | "corelib_catalog" -> canvas_core_catalog_query(path, src, request)
        _ -> .Err(query_error("unsupported", "unknown Canvas query operation"))
    }
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:507
pub fn query_json_for_entry(entry: OSPath, request: String) -> String Err! {
    run_compiler_work(() -> query_json_for_entry_inner(entry, request)).map((payload) -> canvas_machine_success("canvas.query", payload)).map_err((error) -> canvas_machine_error("canvas.query", error))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:513
fn query_json_for_entry_inner(entry: OSPath, request: String) -> String Err! {
    source_id :: json_string_field(request, "source_id")
    path :: resolve_entry_source_path(entry, source_id)?
    schema :: json_usize_field(request, "schema_version").unwrap_or(0)
    if schema != QUERY_SCHEMA_VERSION as Usize -> return .Err(query_error("schema", "Canvas query schema_version must be 1"))
    op :: json_string_field(request, "op")
    expected_project_revision :: json_string_field(request, "project_revision")
    if op == .Some("project_search") {
        src :: read_source_without_symlinks(path).map_err((e) -> query_error("io", e.to_string()))?
        revision :: required_query_string(request, "revision")?
        if revision != source_revision(src) -> return .Err(query_error("conflict", "source changed since this Canvas graph was drawn"))
        return canvas_project_find(entry, path, src, required_query_string(request, "query")?, expected_project_revision)
    }
    if op == .Some("references") {
        src :: read_source_without_symlinks(path).map_err((e) -> query_error("io", e.to_string()))?
        revision :: required_query_string(request, "revision")?
        if revision != source_revision(src) -> return .Err(query_error("conflict", "source changed since this Canvas graph was drawn"))
        return canvas_project_references(entry, path, src, required_query_string(request, "symbol")?, expected_project_revision)
    }
    if op == .Some("preview_rename") && expected_project_revision.is_some() {
        src :: read_source_without_symlinks(path).map_err((e) -> query_error("io", e.to_string()))?
        revision :: required_query_string(request, "revision")?
        if revision != source_revision(src) -> return .Err(query_error("conflict", "source changed since this Canvas graph was drawn"))
        symbol :: required_query_string(request, "symbol")?
        to :: required_query_string(request, "to")?
        validate_query_ident(to)?
        return canvas_project_preview_rename(entry, path, src, symbol, to, expected_project_revision)
    }
    query_json_for_file_inner(path, request)
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:588
pub fn core_catalog_json_for_entry(entry: OSPath, query: String) -> String Err! {
    result :: (() -> {
        path :: resolve_entry_source_path(entry, .None)?
        src :: read_source_without_symlinks(path).map_err((e) -> query_error("io", e.to_string()))?
        canvas_core_catalog(path, src, query)
    })()
    result.map((payload) -> canvas_machine_success("canvas.core_catalog", payload)).map_err((error) -> canvas_machine_error("canvas.core_catalog", error))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:601
pub fn source_control_json_for_file(path: OSPath) -> String {
    payload :: source_control_json_for_file_inner(path)
    canvas_machine_success("canvas.source_control", payload)
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:606
fn source_control_json_for_file_inner(path: OSPath) -> String {
    src :: read_source_without_symlinks(path).unwrap_or_default()
    semantic_ops :: semantic_ops_json(path, src)
    root :: git_root(path) ?? return format("{{\"protocol\":\"jet.canvas.source_control\",\"schema_version\":1,\"ok\":true,\"revision\":{},\"available\":false,\"dirty\":false,\"status\":{},\"diff\":{},\"history\":[],\"semantic_ops\":[{}]}}", json_str(source_revision(src)), json_str("not a Git worktree"), json_str(""), semantic_ops)
    rel :: git_relative_path(root, path)
    status :: git_output(root, ["status", "--porcelain", "--", rel]).unwrap_or_default()
    tracked :: git_output(root, ["ls-files", "--error-unmatch", "--", rel]).is_some()
    diff :: if tracked { git_output(root, ["diff", "--", rel]).unwrap_or_default() } else if path.exists() { untracked_diff(rel, src) } else { "" }
    log :: git_output(root, ["log", "--oneline", "-5", "--", rel]).unwrap_or_default()
    history :: log.lines().map(json_str).collect().join(",")
    dirty :: !status.trim().is_empty() || !diff.trim().is_empty()
    format("{{\"protocol\":\"jet.canvas.source_control\",\"schema_version\":1,\"ok\":true,\"revision\":{},\"available\":true,\"dirty\":{},\"status\":{},\"diff\":{},\"history\":[{}],\"semantic_ops\":[{}]}}", json_str(source_revision(src)), if dirty { "true" } else { "false" }, json_str(status.trim()), json_str(diff), history, semantic_ops)
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:646
fn semantic_ops_json(path: OSPath, source: String) -> String {
    source_hash :: SHA256.sha256_hex(source.as_bytes())
    semantic_ops_for_file(path, source_hash).iter().map(semantic_op_json).collect().join(",")
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:655
fn semantic_op_json(op: &SemanticOp) -> String {
    optional :: (value: String?) -> value.map(json_str).unwrap_or("null")
    targets :: op.targets.iter().map((target) -> format("{{\"stable_id\":{},\"before\":{},\"after\":{},\"kind\":{},\"module_path\":{}}}", json_str(target.stable_id), json_str(target.before), json_str(target.after), json_str(target.kind), json_str(target.module_path))).collect().join(",")
    format("{{\"kind\":{},\"rule_id\":{},\"from\":{},\"to\":{},\"node\":{},\"match\":{},\"replace\":{},\"targets\":[{}]}}", json_str(op.kind), optional(op.rule_id), optional(op.from), optional(op.to), optional(op.node), optional(op.match_template), optional(op.replace_template), targets)
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:691
pub fn source_control_json_for_entry(path: OSPath) -> String {
    payload :: run_compiler_work(() -> source_control_json_for_entry_inner(path))
    canvas_machine_success("canvas.source_control", payload)
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:696
fn source_control_json_for_entry_inner(path: OSPath) -> String {
    ctx :: project_context_for_entry(path)
    root :: git_root(path)
    dirty_files := 0
    statuses: [String] := []
    files :: ctx.files.iter().map((file) -> {
        abs :: ctx.project_root.join(file.path)
        src :: read_source_without_symlinks(abs).unwrap_or_default()
        status := ""
        diff := ""
        dirty := false
        if root :: root {
            git_rel :: git_relative_path(root, abs)
            status = git_output(root, ["status", "--porcelain", "--", git_rel]).unwrap_or_default()
            tracked :: git_output(root, ["ls-files", "--error-unmatch", "--", git_rel]).is_some()
            diff = if tracked { git_output(root, ["diff", "--", git_rel]).unwrap_or_default() } else if abs.exists() { untracked_diff(git_rel, src) } else { "" }
            dirty = !status.trim().is_empty() || !diff.trim().is_empty()
            if !status.trim().is_empty() {
                trimmed := status.trim() // #4303
                statuses.push(trimmed.to_string())
            }
        }
        if dirty -> dirty_files += 1
        semantic_ops :: semantic_ops_json(abs, src)
        format("{{\"path\":{},\"revision\":{},\"kind\":{},\"available\":{},\"dirty\":{},\"status\":{},\"diff\":{},\"semantic_ops\":[{}]}}", json_str(file.path), json_str(file.revision), json_str(file.kind), if root.is_some() { "true" } else { "false" }, if dirty { "true" } else { "false" }, json_str(status.trim()), json_str(diff), semantic_ops)
    }).collect().join(",")
    entry_src :: read_source_without_symlinks(path).unwrap_or_default()
    history :: root.and_then((root) -> {
        rel :: git_relative_path(root, path)
        git_output(root, ["log", "--oneline", "-5", "--", rel])
    }).unwrap_or_default().lines().map(json_str).collect().join(",")
    format("{{\"protocol\":\"jet.canvas.source_control\",\"schema_version\":1,\"ok\":true,\"revision\":{},\"project_revision\":{},\"project_root\":{},\"available\":{},\"dirty\":{},\"dirty_files\":{},\"status\":{},\"diff\":{},\"history\":[{}],\"files\":[{}]}}", json_str(source_revision(entry_src)), json_str(ctx.project_revision), json_str(ctx.project_root.display().to_string()), if root.is_some() { "true" } else { "false" }, if dirty_files > 0 { "true" } else { "false" }, dirty_files, json_str(statuses.join("\n")), json_str(""), history, files)
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:775
pub fn proof_json_for_entry(entry: OSPath, source_id: String?) -> String Err! {
    proof_json_for_entry_with_receipt(entry, source_id, .None)
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:779
pub fn proof_json_for_entry_with_receipt(entry: OSPath, source_id: String?, command_receipt: String?) -> String Err! {
    proof_json_for_entry_with_receipt_inner(entry, source_id, command_receipt).map((payload) -> canvas_machine_success("canvas.proof", payload)).map_err((error) -> canvas_machine_error("canvas.proof", error))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:789
fn proof_json_for_entry_with_receipt_inner(entry: OSPath, source_id: String?, command_receipt: String?) -> String Err! {
    path :: resolve_entry_source_path(entry, source_id)?
    src :: read_source_without_symlinks(path).map_err((e) -> query_error("io", e.to_string()))?
    revision :: source_revision(src)
    check :: if project_file(path) is {
        .Ok(_) -> "{\"state\":\"ok\",\"diagnostics_count\":0,\"message\":\"front end check passed\"}"
        .Err(diags) -> {
            message :: render_all(path.display().to_string(), src, diags)
            format("{{\"state\":\"diagnostic\",\"diagnostics_count\":{},\"message\":{}}}", diags.len(), json_str(message))
        }
    }
    (git_available, git_dirty, git_status) :: if root :: git_root(path) {
        rel :: git_relative_path(root, path)
        status :: git_output(root, ["status", "--porcelain", "--", rel]).unwrap_or_default()
        tracked :: git_output(root, ["ls-files", "--error-unmatch", "--", rel]).is_some()
        diff :: if tracked { git_output(root, ["diff", "--", rel]).unwrap_or_default() } else if path.exists() { untracked_diff(rel, src) } else { "" }
        trimmed := status.trim() // #4303
        ("true", if !trimmed.is_empty() || !diff.trim().is_empty() { "true" } else { "false" }, trimmed.to_string())
    } else { ("false", "false", "not a Git worktree") }
    source_label :: source_id.unwrap_or_else(() -> path.display().to_string())
    receipt_current :: command_receipt.map((receipt) -> receipt.contains(format("\"revision\":\"{}\"", revision))).unwrap_or(false)
    command_receipts :: if receipt_current { format("{{\"state\":\"current\",\"receipt\":{}}}", command_receipt.unwrap_or("{}")) } else { "{\"state\":\"missing\",\"reason\":\"no Canvas command authority receipt has run for this source revision\"}" }
    proof :: if receipt_current { "{\"state\":\"current\",\"stale\":false,\"reasons\":[]}" } else { "{\"state\":\"missing\",\"stale\":true,\"reasons\":[\"no check/build/run receipt for this source revision\"]}" }
    budget_root :: Loader.find_manifest_root(path.parent().unwrap_or(OSPath.new("."))).unwrap_or_else(() -> path.parent().unwrap_or(OSPath.new(".")).to_path_buf())
    budget_path :: path.strip_prefix(budget_root).unwrap_or(path).to_string_lossy().replace('\\', "/")
    budget_digest :: SHA256.sha256_hex(src.as_bytes())
    budgets :: BudgetView.read_compatible(budget_root, [(budget_path, budget_digest)])
    budget_reports :: budgets.facts.iter().map((fact) -> format("{{\"budget_id\":{},\"enforcement\":{},\"evidence\":{},\"evidence_id\":{},\"outcome\":{},\"report_id\":{},\"statistical\":{}}}", json_str(fact.budget_id), json_str(fact.enforcement), json_str(fact.evidence), json_str(fact.evidence_id), json_str(fact.outcome), json_str(fact.report_id), fact.statistical)).collect().join(",")
    budget_rejected :: budgets.rejected.iter().map(json_str).collect().join(",")
    .Ok(format("{{\"protocol\":\"jet.canvas.proof\",\"schema_version\":{},\"ok\":true,\"source_id\":{},\"source_path\":{},\"revision\":{},\"check\":{},\"source_control\":{{\"truth\":\"git-text\",\"available\":{},\"dirty\":{},\"status\":{}}},\"debug\":{{\"state\":\"local-only\",\"persistence\":\"local-source-span\"}},\"command_receipts\":{},\"budget_reports\":{{\"mode\":\"read_only\",\"reports\":[{}],\"rejected\":[{}]}},\"proof\":{}}}", PROOF_SCHEMA_VERSION, json_str(source_label), json_str(path.display().to_string()), json_str(revision), check, git_available, git_dirty, json_str(git_status), command_receipts, budget_reports, budget_rejected, proof))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:894
pub fn command_receipt_json_for_entry(entry: OSPath, request: String) -> String Err! {
    command_receipt_json_for_entry_inner(entry, request).map((payload) -> canvas_machine_success("canvas.command_receipt", payload)).map_err((error) -> canvas_machine_error("canvas.command_receipt", error))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:900
fn command_receipt_json_for_entry_inner(entry: OSPath, request: String) -> String Err! {
    source_id :: json_string_field(request, "source_id")
    source_path :: resolve_entry_source_path(entry, source_id)?
    src :: read_source_without_symlinks(source_path).map_err((e) -> query_error("io", e.to_string()))?
    revision :: required_string(request, "revision")?
    if revision != source_revision(src) -> return .Err(query_error("conflict", "source changed since this Canvas command was approved"))
    action_id :: required_string(request, "action_id")?
    authority :: canvas_authority_context(source_path)
    source :: authority.touched_file
    source_label :: source_id.unwrap_or_else(() -> {
        ctx :: project_context_for_entry(entry)
        rel_path(ctx.project_root, source_path)
    })
    (label, args, writes, requires_confirmation) :: if action_id is {
        "canvas.command:run" -> ("Run program", ["run", source], "none", false)
        "canvas.command:check" -> ("Check project", ["check", source], "none", false)
        "canvas.command:test" -> ("Test project", ["test", source], "test_outputs", true)
        "canvas.command:build" -> ("Build project", ["build", source], "build_outputs", true)
        "canvas.command:service.start" -> ("Start service", ["services", "up"], "service_process", true)
        _ -> return .Err(query_error("unsupported", "Canvas command execution only supports run, check, test, build, and service.start receipts"))
    }
    args := args
    if action_id == "canvas.command:run" {
        if output :: json_string_field(request, "output").filter((value) -> !value.is_empty()) -> args.push(format("--output={}", output))
        if target :: json_string_field(request, "target").filter((value) -> !value.is_empty()) -> args.push(format("--target={}", target))
    }
    if requires_confirmation && !json_bool_field(request, "confirmed").unwrap_or(false) -> return .Err(query_error("confirmation_required", "this Canvas command writes outputs or starts a service and needs confirmed:true"))
    started :: Instant.now() // GATE #4494
    source_override :: json_string_field(request, "source_text")
    check_src :: source_override.unwrap_or(src)
    check_revision :: source_revision(check_src)
    (success, exit_code, stdout, stderr, diagnostics) :: if action_id == "canvas.command:check" {
        abs :: canonical_path(source_path)
        overlay :: source_override.map((text) -> (abs, text))
        (diags, _bundle, _facts) :: Driver.check_file_with_effect_facts(source_path.display().to_string(), overlay, true)
        errors :: diags.iter().filter((d) -> d.severity == Severity.Error).cloned().collect()
        if errors.is_empty() { (true, .Some(0), "", "", "") }
        else { (false, .Some(1), "", render_all(source_path.display().to_string(), check_src, errors), diagnostics_json(source_path, check_src, errors)) }
    } else {
        output :: run_jet_command(authority.project_root, args)?
        out := String.from_utf8_lossy(output.stdout) // #4303
        err := String.from_utf8_lossy(output.stderr) // #4303
        (output.status.success(), output.status.code(), out.to_string(), err.to_string(), "")
    }
    elapsed_ms :: started.elapsed().as_millis()
    display := ["jet"]
    display.extend(args.iter().map((arg) -> arg.to_string()))
    command :: display.iter().map(json_str).collect().join(",")
    .Ok(format("{{\"protocol\":\"jet.canvas.command_receipt\",\"schema_version\":1,\"ok\":true,\"action_id\":{},\"title\":{},\"source_id\":{},\"revision\":{},\"checked_revision\":{},\"command\":[{}],\"writes\":{},\"success\":{},\"exit_code\":{},\"elapsed_ms\":{},\"stdout\":{},\"stderr\":{},\"diagnostics\":[{}]}}", json_str(action_id), json_str(label), json_str(source_label), json_str(revision), json_str(check_revision), command, json_str(writes), if success { "true" } else { "false" }, exit_code.map((c) -> c.to_string()).unwrap_or("null"), elapsed_ms, json_str(stdout), json_str(stderr), diagnostics))
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:1029
fn run_jet_command(cwd: OSPath, args: [String]) -> Output Err! {
    if current_exe() is .Ok(exe) {
        command := Command.new(exe) // GATE #4494
        command.args(args).current_dir(cwd)
        if command_output_bounded(&command, MAX_CHILD_OUTPUT_BYTES) is {
            .Ok(output) -> return .Ok(output)
            .Err(error) if error.kind() == ErrorKind.NotFound -> {} // GATE #4409
            .Err(error) -> return .Err(query_error("resource_limit", error.to_string()))
        }
    }
    command := Command.new("jet") // GATE #4494
    command.args(args).current_dir(cwd)
    command_output_bounded(&command, MAX_CHILD_OUTPUT_BYTES).map_err((error) -> query_error("resource_limit", error.to_string()))
}
