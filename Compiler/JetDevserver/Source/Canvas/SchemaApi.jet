pub fn apply_transaction_json(path: OSPath, request: String) -> String Err! {
    apply_transaction_json_inner(path, request).map((payload) -> canvas_machine_success("canvas.edit", payload)).map_err((error) -> canvas_machine_error("canvas.edit", error))
