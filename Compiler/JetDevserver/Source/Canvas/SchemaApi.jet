// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:61
fn canvas_machine_output(action: String, ok: Bool, payload: String) -> String {
    payload := payload.trim() // #4303
    value :: parse_json_with_limit(payload, CANVAS_PAYLOAD_LIMIT).ok().and_then((tree) -> StatusValue.from_data_tree(tree).ok()).unwrap_or_else(() -> StatusValue.String(payload.to_string()))
    StatusEnvelope.new(action, ok).with_field("canvas", value).json()
}
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:72
fn canvas_machine_success(action: String, payload: String) -> String { canvas_machine_output(action, true, payload) }
// Rust: crates/jet-devserver/src/Canvas/schema_api.rs:76
fn canvas_machine_error(action: String, payload: String) -> String { canvas_machine_output(action, false, payload) }
