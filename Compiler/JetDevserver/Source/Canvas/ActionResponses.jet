// The response bodies of Canvas edits, previews, actions, queries, and
// project transactions.
use {
    jet_canvas.[
        NodeQueryRef, Projection, QUERY_SCHEMA_VERSION, is_space_byte, json_bool, json_str, line_start, query_error, read_source_without_symlinks, source_revision,
        span_json,
    ]
    jet_foundation.[
        DIAGNOSTIC_LINT, Diagnostic, Span, TextEdit, diagnostic_render_all, diagnostic_source_column, diagnostic_source_line, diagnostic_source_position,
        diagnostic_source_texts,
    ]
    jet_lsp.[LSPChecker]
    jet_semindex.[SemIndex]
}

// A projection and the semantic index of one file, opened together, with the
// entry module's callable exports and game calls the action catalog reads.
QueryContext: struct {
    projection: Projection
    index: SemIndex
    callable_exports: [CanvasCallableExport]
    game_facts: [CanvasGameFact]
}

graph_id_name_span: fn(graph_id: String) -> Span? Never! {
    range: graph_id.cut_last("@") ?? return None
    parts: range.after.split_once("-") ?? return None
    start: parts.before.to_int() ?? return None
    end: parts.after.to_int() ?? return None
    Val(Span{start: start, end: end})
}

function_signature_span: fn(src: String, name_span: Span) -> Span Err! {
    start: line_start(src, name_span.start)
    from: if name_span.end < src.len() -> name_span.end else -> src.len()
    brace_rel: src.slice(from, src.len()).index_of("{{") ?? return Err(edit_error("not_found", "Canvas function signature no longer has a body"))
    bytes: src.bytes()
    end := from + brace_rel
    loop end > start && is_space_byte(Int{bytes[end - 1]}) -> end -= 1
    Ok(Span{start: start, end: end})
}

indentation_at: fn(src: String, offset: Int) -> String Never! {
    start: line_start(src, offset)
    limit: if offset < src.len() -> offset else -> src.len()
    bytes: src.bytes()
    end := start
    loop end < limit && (bytes[end] == 32 || bytes[end] == 9) -> end += 1
    src.slice(start, end)
}

edit: fn(span: Span, text: String) -> TextEdit Never! {
    TextEdit{span: span, new_text: text}
}

spans_overlap: fn(a: Span, b: Span) -> Bool Never! {
    a.start <= b.end && b.start <= a.end
}

text_matches: fn(src: String, needle: String) -> [Span] Never! {
    out := [Span]{}
    if needle.is_empty() -> return out
    hay: src.to_ascii_lower()
    lower_needle: needle.to_ascii_lower()
    offset := 0
    loop offset <= hay.len() {
        pos: hay.slice(offset, hay.len()).index_of(lower_needle) ?? break
        start: offset + pos
        end: start + lower_needle.len()
        out.push(Span{start: start, end: end})
        offset = end
    }
    out
}

edit_ok: fn(changed: Bool, path: String) -[FS]> String Never! {
    src: read_source_without_symlinks(path) ?? ""
    edit_ok_source(changed, src)
}

edit_ok_source: fn(changed: Bool, src: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"changed\":{json_bool(changed)},\"revision\":{json_str(source_revision(src))},\"source_text\":{json_str(src)}}}"
}

preview_ok: fn(before: String, after: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.preview\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"changed\":{json_bool(before != after)},\"diff\":{json_str(simple_diff(before, after))},\"after_revision\":{json_str(source_revision(after))}}}"
}

canvas_action_preview_ok: fn(path: String, before: String, after: String, action_id: String, callee: String) -[Env, FS]> String Never! {
    authority: canvas_authority_context(path)
    "{{\"protocol\":\"jet.canvas.action\",\"schema_version\":{ACTION_SCHEMA_VERSION},\"ok\":true,\"changed\":{json_bool(before != after)},\"action_id\":{json_str(action_id)},\"callee\":{json_str(callee)},\"engine\":\"checked+jit\",\"execution\":\"preview\",\"writes\":\"source_transaction_only\",\"authority\":[{json_str(authority.grant)}],\"audit\":{{\"package_id\":{json_str(authority.package_id)},\"version\":{json_str(authority.version)},\"hash\":{json_str(source_revision(after))},\"touched_files\":[{json_str(authority.touched_file)}],\"diagnostics\":[]}},\"diff\":{json_str(simple_diff(before, after))},\"after_revision\":{json_str(source_revision(after))}}}"
}

query_ok: fn(op: String, src: String, results_json: String, extra_fields: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{QUERY_SCHEMA_VERSION},\"ok\":true,\"op\":{json_str(op)},\"revision\":{json_str(source_revision(src))},\"results\":{results_json},{extra_fields} }}"
}

query_result_json: fn(kind: String, title: String, symbol: String, module_path: String, span: Span, node: NodeQueryRef?, src: String) -> String Never! {
    graph_id := ""
    node_id := ""
    node_kind := ""
    if node == .Val(found) {
        graph_id = found.graph_id
        node_id = found.node_id
        node_kind = found.kind
    }
    "{{\"kind\":{json_str(kind)},\"title\":{json_str(title)},\"symbol\":{json_str(symbol)},\"module_path\":{json_str(module_path)},\"graph_id\":{json_str(graph_id)},\"node_id\":{json_str(node_id)},\"node_kind\":{json_str(node_kind)},\"source_span\":{span_json(span)},\"line\":{line_number_for(src, span.start)},\"excerpt\":{json_str(source_line_for(src, span.start))}}}"
}

open_query_context: fn(checker: LSPChecker, path: String, src: String) -> QueryContext Err! {
    project_file_context(checker, path, None) ?? return Err(query_diagnostics_error(path, src, err.diagnostics))
}

node_for_span: fn(projection: Projection, span: Span) -> NodeQueryRef? Never! {
    best := NodeQueryRef?{None}
    best_width := 0
    loop node in projection.node_refs {
        if !spans_overlap(node.span, span) -> next
        width: if node.span.end > node.span.start -> node.span.end - node.span.start else -> 0
        if best == None || width < best_width {
            best = Val(node)
            best_width = width
        }
    }
    best
}

nearest_node: fn(projection: Projection, offset: Int) -> NodeQueryRef? Never! {
    best := NodeQueryRef?{None}
    best_distance := 0
    loop node in projection.node_refs {
        distance: if {
            offset < node.span.start -> node.span.start - offset
            offset > node.span.end -> offset - node.span.end
            else -> 0
        }
        if best == None || distance < best_distance {
            best = Val(node)
            best_distance = distance
        }
    }
    best
}

contains_ci: fn(text: String, needle: String) -> Bool Never! {
    text.to_ascii_lower().contains(needle.to_ascii_lower())
}

// Keeps the first of each equal result, in order.
dedupe_results: fn(results: &[String]) {
    index := 0
    loop index < results.len() {
        seen := false
        loop earlier in 0..<index {
            if results[earlier] == results[index] -> seen = true
        }
        if seen {
            _ := results.remove(index, .Slot)
        } else {
            index += 1
        }
    }
}

line_number_for: fn(src: String, offset: Int) -> Int Never! {
    limit: if offset < src.len() -> offset else -> src.len()
    bytes: src.bytes()
    count := 1
    loop i in 0..<limit {
        if bytes[i] == 10 -> count += 1
    }
    count
}

source_line_for: fn(src: String, offset: Int) -> String Never! {
    start: line_start(src, offset)
    from: if offset < src.len() -> offset else -> src.len()
    end: if src.slice(from, src.len()).index_of("\n") == .Val(i) -> from + i else -> src.len()
    src.slice(start, end).trim()
}

simple_diff: fn(before: String, after: String) -> String Never! {
    before_lines: before.lines()
    after_lines: after.lines()
    before_set := [String:Bool]{}
    after_set := [String:Bool]{}
    loop line in before_lines -> before_set[line] = true
    loop line in after_lines -> after_set[line] = true
    out := "--- before\n+++ after\n"
    loop line in before_lines {
        if !after_set.has_key(line) -> out = "{out}-{line}\n"
    }
    loop line in after_lines {
        if !before_set.has_key(line) -> out = "{out}+{line}\n"
    }
    out
}

edit_error: fn(kind: String, message: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)}}}"
}

edit_conflict: fn(message: String, current_revision: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"ok\":false,\"kind\":\"conflict\",\"message\":{json_str(message)},\"current_revision\":{json_str(current_revision)}}}"
}

edit_error_with_diagnostics: fn(kind: String, message: String, path: String, src: String, diags: [Diagnostic]) -> String Never! {
    "{{\"protocol\":\"jet.canvas.edit\",\"schema_version\":{EDIT_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)},\"revision\":{json_str(source_revision(src))},\"diagnostic_revision\":{json_str(source_revision(src))},\"diagnostics\":[{diagnostics_json(path, src, diags)}]}}"
}

query_error_with_diagnostics: fn(kind: String, message: String, path: String, src: String, diags: [Diagnostic]) -> String Never! {
    "{{\"protocol\":\"jet.canvas.query\",\"schema_version\":{QUERY_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)},\"revision\":{json_str(source_revision(src))},\"diagnostic_revision\":{json_str(source_revision(src))},\"diagnostics\":[{diagnostics_json(path, src, diags)}]}}"
}

project_edit_ok_with_audit: fn(op: String, preview: Bool, changed: Bool, before_revision: String, after_revision: String, touched_files: String, diff: String, audit: String) -> String Never! {
    game_audit: if audit.is_empty() -> "" else -> ",\"game_selection\":{audit}"
    writes: if preview -> "\"preview_only\"" else -> "\"source_transaction\""
    "{{\"protocol\":\"jet.canvas.project.edit\",\"schema_version\":{PROJECT_SCHEMA_VERSION},\"ok\":true,\"op\":{json_str(op)},\"preview\":{json_bool(preview)},\"changed\":{json_bool(changed)},\"project_revision\":{json_str(before_revision)},\"after_project_revision\":{json_str(after_revision)},\"writes\":{writes},\"authority\":[\"canvas.source_edit:project\"],\"audit\":{{\"touched_files\":[{touched_files}],\"diagnostics\":[]{game_audit}}},\"diff\":{json_str(diff)}}}"
}

project_edit_error: fn(kind: String, message: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.project.edit\",\"schema_version\":{PROJECT_SCHEMA_VERSION},\"ok\":false,\"kind\":{json_str(kind)},\"message\":{json_str(message)}}}"
}

project_edit_conflict: fn(message: String, current_revision: String) -> String Never! {
    "{{\"protocol\":\"jet.canvas.project.edit\",\"schema_version\":{PROJECT_SCHEMA_VERSION},\"ok\":false,\"kind\":\"conflict\",\"message\":{json_str(message)},\"current_revision\":{json_str(current_revision)}}}"
}

diagnostics_error: fn(path: String, src: String, diags: [Diagnostic]) -> String Never! {
    edit_error_with_diagnostics("diagnostic", diagnostic_render_all(path, src, diags, false), path, src, diags)
}

query_diagnostics_error: fn(path: String, src: String, diags: [Diagnostic]) -> String Never! {
    query_error_with_diagnostics("diagnostic", diagnostic_render_all(path, src, diags, false), path, src, diags)
}

// One report object per diagnostic: what Canvas shows beside a refused edit.
diagnostics_json: fn(path: String, src: String, diags: [Diagnostic]) -> String Never! {
    sources := diagnostic_source_texts()
    reports: loop diagnostic in diags -> {
        severity: if diagnostic.severity == DIAGNOSTIC_LINT -> "warning" else -> "error"
        position: if diagnostic.span == .Val(span) -> {
            at: diagnostic_source_position(sources, diagnostic.origin, src)
            "\"line\":{diagnostic_source_line(sources.texts[at], span.start)},\"col\":{diagnostic_source_column(sources.texts[at], span.start)},\"span\":{{\"start\":{span.start},\"end\":{span.end}}}"
        } else -> "\"line\":null,\"col\":null,\"span\":null"
        "{{\"severity\":{json_str(severity)},\"code\":{json_str(diagnostic.code)},\"what\":{json_str(diagnostic.what)},\"why\":{json_str(diagnostic.why)},\"fix\":{json_str(diagnostic.fix)},\"file\":{json_str(path)},{position}}}"
    }
    reports.join(",")
}
