// Statement and expression projection of the canonical Canvas graph.
use {
    jet_foundation.[Binding, Expr, Span, Stmt, SwitchArm, access_sigil, expr_span, policy_key_name]
    jet_parser.[jfmt_bin_op_spell, jfmt_is_subjectless_guard, jfmt_uses_classic_if_spelling]
    jet_semindex.[SemIndex, semindex_callable]
}

// A dispatch arm's pattern text and its byte offset inside the arm condition.
ArmPatternFragment: struct {
    text: String
    offset: Int
}

project_stmt_block: fn(g: &GraphBuilder, index: SemIndex, src: String, stmts: [Stmt], base: Int, x: Int, y: Int) {
    cursor_y := y
    loop (i, stmt) in stmts {
        project_stmt(g, index, src, stmt, base + i + 1, x, cursor_y)
        cursor_y += stmt_row_step(stmt)
    }
}

// A list initializer's multi-input body grows with item count; retain enough
// spacing for its data providers before the next sibling statement.
stmt_row_step: fn(stmt: Stmt) -> Int Never! {
    items := 0
    if stmt == .Val(b) -> items = multi_input_item_count(b.init) else if stmt == .Assign(_, _, _, value) {
        items = multi_input_item_count(value)
    }
    extra: if items > 2 -> items - 2 else -> 0
    130 + extra * 55
}

multi_input_item_count: fn(expr: Expr) -> Int Never! {
    if expr == .ListLit(items, _, _) -> return items.len()
    0
}

set_node_meta: fn(g: &GraphBuilder, node_id: String, meta_json: String?) {
    loop i in 0..<g.nodes.len() {
        if g.nodes[i].id == node_id {
            g.nodes[i].meta_json = meta_json
            return
        }
    }
}

project_stmt: fn(g: &GraphBuilder, index: SemIndex, src: String, stmt: Stmt, ordinal: Int, x: Int, y: Int) {
    if stmt == {
        .Val(b) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:binding"
            ty: binding_type(g, b.name, b)
            add_node(g, node_id, "binding", b.name, binding_source_span(src, b), x, y, [String]{"local"}, [String]{"rename_binding", "edit_inline_expr", "source_jump"})
            set_node_meta(g, node_id, meta_attr_json(b.meta))
            input_pin: add_pin(g, node_id, "value", "input", ty, "", false)
            output_pin: add_pin(g, node_id, b.name, "output", ty, "", false)
            g.local_pins[b.name] = output_pin
            g.local_types[b.name] = ty
            init_span: if b.pattern == None -> binding_init_span(src, b) else -> expr_span(b.init)
            connect_expr_to_input_with_span(g, index, src, b.init, init_span, ordinal, "init", node_id, input_pin, x - 220, y)
        }
        .Assign(target, op, _, value) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:assign"
            ty: lvalue_type(g, target)
            add_node(g, node_id, "assignment", assignment_title(target, op), lvalue_span(target), x, y, [String]{"write"}, [String]{"edit_inline_expr", "source_jump"})
            input: add_pin(g, node_id, "value", "input", ty, "", false)
            output: add_pin(g, node_id, "target", "output", ty, "&", false)
            connect_expr_to_input(g, index, src, value, ordinal, "value", node_id, input, x - 220, y)
            if target == .Local(name, _) {
                g.local_pins[name] = output
                g.local_types[name] = ty
            }
        }
        .Expr(e) -> { _ := project_expr_node(g, index, src, e, ordinal, x, y, true) }
        .DeferClose(close, span) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:defer_close"
            add_node(g, node_id, "defer_close", "defer close", span, x, y, [String]{"cleanup"}, [String]{"source_jump"})
            add_inline(g, node_id, ordinal, "close", src, expr_span(close))
        }
        .Return(value, span) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:return"
            add_node(g, node_id, "return", "return", span, x, y, [String]{"exit"}, [String]{"source_jump"})
            if value == .Val(e) {
                input: add_pin(g, node_id, "value", "input", expr_type(g, index, e), "", false)
                connect_expr_to_input(g, index, src, e, ordinal, "value", node_id, input, x - 220, y)
            }
        }
        .While(cond, body, span, _, _) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:loop"
            add_node(g, node_id, "loop", "loop", span, x, y, [String]{"control"}, [String]{"edit_inline_expr", "source_jump"})
            add_inline(g, node_id, ordinal, "cond", src, expr_span(cond))
            project_stmt_block(g, index, src, body, ordinal * 100 + 15, x + 230, y + 70)
        }
        .Loop(body, span, _, _) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:loop"
            add_node(g, node_id, "loop", "loop", span, x, y, [String]{"control"}, [String]{"source_jump"})
            project_stmt_block(g, index, src, body, ordinal * 100 + 20, x + 230, y + 70)
        }
        .CountedLoop(init, cond, step, body, span, _, _) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:counted_loop"
            add_node(g, node_id, "loop", "counted loop", span, x, y, [String]{"control"}, [String]{"add_pattern_arm", "edit_inline_expr", "source_jump"})
            initializer_span: Span{start: init.name_span.start, end: expr_span(init.init).end}
            init_pin: add_pin(g, node_id, "initializer", "input", "Value", "", false)
            connect_expr_to_input_with_span(g, index, src, init.init, initializer_span, ordinal * 10, "initializer", node_id, init_pin, x - 220, y)
            cond_pin: add_pin(g, node_id, "condition", "input", "Bool", "", false)
            connect_expr_to_input(g, index, src, cond, ordinal * 10 + 1, "condition", node_id, cond_pin, x - 220, y + 30)
            add_inline(g, node_id, ordinal, "cond", src, expr_span(cond))
            if step == .Val(afterthought) {
                connect_afterthought(g, index, src, afterthought, ordinal, node_id, x, y)
            }
            project_stmt_block(g, index, src, body, ordinal * 100 + 30, x + 230, y + 200)
        }
        .For(var, _, var2, kind, body, span, _, _, _) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:for"
            add_node(g, node_id, "loop", "loop {var}", span, x, y, [String]{"control"}, [String]{"source_jump"})
            iter_ty: if kind == {
                .Range(_, _, _, _) -> "Int"
                .In(_, _) -> "iterable"
            }
            output: add_pin(g, node_id, var, "output", iter_ty, "", false)
            g.local_pins[var] = output
            g.local_types[var] = iter_ty
            if var2 == .Val(second) {
                second_output: add_pin(g, node_id, second.name, "output", iter_ty, "", false)
                g.local_pins[second.name] = second_output
                g.local_types[second.name] = iter_ty
            }
            if kind == {
                .Range(start, end, stride, _) -> {
                    start_pin: add_pin(g, node_id, "range_start", "input", "Int", "", false)
                    connect_expr_to_input(g, index, src, start, ordinal * 10, "range_start", node_id, start_pin, x - 220, y)
                    end_pin: add_pin(g, node_id, "range_end", "input", "Int", "", false)
                    connect_expr_to_input(g, index, src, end, ordinal * 10 + 1, "range_end", node_id, end_pin, x - 220, y + 30)
                    if stride == .Val(value) {
                        stride_pin: add_pin(g, node_id, "stride", "input", "Int", "", false)
                        connect_expr_to_input(g, index, src, value, ordinal * 10 + 2, "stride", node_id, stride_pin, x - 220, y + 60)
                    }
                }
                .In(collection, stride) -> {
                    source_pin: add_pin(g, node_id, "source", "input", "Iterable", "", false)
                    connect_expr_to_input(g, index, src, collection, ordinal * 10, "source", node_id, source_pin, x - 220, y)
                    if stride == .Val(value) {
                        stride_pin: add_pin(g, node_id, "stride", "input", "Int", "", false)
                        connect_expr_to_input(g, index, src, value, ordinal * 10 + 1, "stride", node_id, stride_pin, x - 220, y + 30)
                    }
                }
            }
            project_stmt_block(g, index, src, body, ordinal * 100 + 40, x + 230, y + 70)
        }
        .Switch(subject, arms, else_body, span) | .ComptimeSwitch(subject, arms, else_body, span) -> {
            project_switch(g, index, src, subject, arms, else_body, span, ordinal, x, y)
        }
        .Break(span) | .Continue(span) | .BreakLabel(_, span) | .ContinueLabel(_, span) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:flow"
            add_node(g, node_id, "flow", snippet(src, span), span, x, y, [String]{"control"}, [String]{"source_jump"})
        }
        .BreakValue(value, span) | .BreakLabelValue(_, _, value, span) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:flow"
            add_node(g, node_id, "flow", "break", span, x, y, [String]{"control"}, [String]{"source_jump"})
            input: add_pin(g, node_id, "value", "input", expr_type(g, index, value), "", false)
            connect_expr_to_input(g, index, src, value, ordinal, "value", node_id, input, x - 220, y)
        }
        .Unsafe(audit, _, body, span) -> {
            region_id: "{g.graph_id}:region:{ordinal}:unsafe"
            region_title: audit ?? "#Unsafe"
            g.regions.push("{{\"region_id\":{json_str(region_id)},\"kind\":\"unsafe\",\"title\":{json_str(region_title)},\"source_span\":{span_json(span)}}}")
            project_stmt_block(g, index, src, body, ordinal * 100 + 95, x + 230, y + 70)
        }
        .Impure(reason, _, body, span) -> {
            add_region(g, ordinal, "impure", reason ?? "#Impure", span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 100, x + 230, y + 70)
        }
        .Reactive(body, span) -> {
            add_region(g, ordinal, "reactive", "#Reactive", span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 110, x + 230, y + 70)
        }
        .Shield(body, span) -> {
            add_region(g, ordinal, "shield", "#Shield", span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 115, x + 230, y + 70)
        }
        .Defer(body, span) -> {
            add_region(g, ordinal, "defer", "defer", span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 115, x + 230, y + 70)
        }
        .Switched(marker, body, span) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:switched"
            // A marker with arguments names the condition menu's one entry.
            sigil: "#"
            badge: if marker.args.len() > 0 -> "{sigil}{marker.name}(.Release)" else -> "{sigil}{marker.name}"
            add_node(g, node_id, "switched", badge, span, x, y, [String]{badge}, [String]{"toggle_switch_state", "source_jump"})
            project_stmt_block(g, index, src, body, ordinal * 100 + 125, x + 230, y + 70)
        }
        .Region(name, _, body, span) -> {
            add_region(g, ordinal, "region", name, span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 130, x + 230, y + 70)
        }
        .Policy(declarations, body, span) -> {
            keys := [String]{}
            loop declaration in declarations -> keys.push(policy_key_name(declaration.key))
            add_region(g, ordinal, "policy", "#Policy({keys.join(", ")})", span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 135, x + 230, y + 70)
        }
        .TaskGroup(name, _, _, body, span) -> {
            add_region(g, ordinal, "task.group", name, span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 140, x + 230, y + 70)
        }
        .Layout(name, _, body, span) -> {
            add_region(g, ordinal, "layout", name, span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 150, x + 230, y + 70)
        }
        .AuthorityScope(caps, _, binding, body, span) -> {
            granted := [String]{}
            loop cap in caps -> granted.push(cap.name)
            binding_name := String?{None}
            if binding == .Val(handle) -> binding_name = Val(handle.name)
            add_authority_region(g, ordinal, "authority: {granted.join(", ")}", [String]{}, granted, [String]{}, binding_name, span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 160, x + 230, y + 70)
        }
        .ComptimeIf(cond, _, then_body, else_body, span, _) -> {
            add_region(g, ordinal, "comptime_if", "#if", span)
            node_id: "{g.graph_id}:stmt:{ordinal}:comptime_if"
            add_node(g, node_id, "branch", "#if", span, x, y, [String]{"comptime"}, [String]{"edit_inline_expr", "source_jump"})
            add_inline(g, node_id, ordinal, "cond", src, expr_span(cond))
            project_stmt_block(g, index, src, then_body, ordinal * 100 + 170, x + 230, y + 70)
            if else_body == .Val(body) {
                project_stmt_block(g, index, src, body, ordinal * 100 + 180, x + 460, y + 70)
            }
        }
        .ComptimeBlock(body, _, span) -> {
            add_region(g, ordinal, "comptime", "comptime", span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 190, x + 230, y + 70)
        }
        .ContextBlock(_, body, span) | .Live(body, span) | .AssumeDet(_, _, body, span) | .Transact(_, _, body, _, span) -> {
            add_region(g, ordinal, "scope", "scope", span)
            project_stmt_block(g, index, src, body, ordinal * 100 + 200, x + 230, y + 70)
        }
        .Yield(value, span) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:yield"
            add_node(g, node_id, "yield", "yield", span, x, y, [String]{"stream"}, [String]{"source_jump"})
            input: add_pin(g, node_id, "value", "input", expr_type(g, index, value), "", false)
            connect_expr_to_input(g, index, src, value, ordinal, "value", node_id, input, x - 220, y)
        }
        .ScopeMember(name, _, args, _, body, _, _, span) -> {
            node_id: "{g.graph_id}:stmt:{ordinal}:scope_member:{name}"
            add_node(g, node_id, "function_exec", ".{name}", span, x, y, [String]{"scope"}, [String]{"source_jump"})
            loop (i, arg) in args {
                add_inline(g, node_id, ordinal, "arg{i + 1}", src, expr_span(arg))
            }
            project_stmt_block(g, index, src, body, ordinal * 100 + 210, x + 230, y + 70)
        }
    }
}

// The step of a counted loop feeds the loop node's `afterthought` input.
connect_afterthought: fn(g: &GraphBuilder, index: SemIndex, src: String, step: Stmt, ordinal: Int, node_id: String, x: Int, y: Int) {
    value := Expr?{None}
    value_span := Span{start: 0, end: 0}
    if step == .Assign(target, _, _, assigned) {
        value = Val(assigned)
        value_span = Span{start: lvalue_span(target).start, end: expr_source_end(assigned)}
    } else if step == .Expr(expression) {
        value = Val(expression)
        value_span = expr_span(expression)
    }
    afterthought: value ?? return
    pin: add_pin(g, node_id, "afterthought", "input", "Value", "", false)
    connect_expr_to_input_with_span(g, index, src, afterthought, value_span, ordinal * 10 + 2, "afterthought", node_id, pin, x - 220, y + 60)
}

project_switch: fn(g: &GraphBuilder, index: SemIndex, src: String, subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, ordinal: Int, x: Int, y: Int) {
    subjectless: jfmt_is_subjectless_guard(subject, span)
    if subjectless && switch_was_classic_if(src, arms, span) {
        project_classic_if(g, index, src, arms[0], else_body, span, ordinal, x, y)
        return
    }
    node_id: "{g.graph_id}:stmt:{ordinal}:dispatch"
    add_node(g, node_id, "dispatch", if subjectless -> "if guards" else -> "if ==", span, x, y, [String]{"control"}, [String]{"add_pattern_arm", "edit_inline_expr", "source_jump"})
    pattern_type := String?{None}
    if !subjectless -> pattern_type = Val(expr_type(g, index, subject)) else if arms.len() > 0 {
        pattern_type = pattern_subject_type(g, index, arms[0].cond)
    }
    if pattern_type == .Val(ty) {
        set_node_meta(g, node_id, Val("{{\"pattern_type\":{json_str(ty)}}}"))
    }
    if !subjectless {
        subject_pin: add_pin(g, node_id, "subject", "input", expr_type(g, index, subject), "", false)
        connect_expr_to_input(g, index, src, subject, ordinal, "subject", node_id, subject_pin, x - 220, y)
    }
    loop (i, arm) in arms {
        arm_name: "arm{i + 1}"
        _ := add_arm_pin(g, node_id, arm_name, dispatch_arm_pattern_label(src, arm.cond), dispatch_arm_pattern_span(src, arm.cond))
        add_inline(g, node_id, ordinal, arm_name, src, expr_span(arm.cond))
        project_stmt_block(g, index, src, arm.body, ordinal * 100 + 50 + i * 20, x + 230 + i * 180, y + 100)
    }
    if else_body == .Val(body) {
        project_stmt_block(g, index, src, body, ordinal * 100 + 90, x + 460, y + 230)
    }
}

// A classic `if cond { }` (or `if x == .A(a) { }`) projects as one branch node.
project_classic_if: fn(g: &GraphBuilder, index: SemIndex, src: String, arm: SwitchArm, else_body: [Stmt]?, span: Span, ordinal: Int, x: Int, y: Int) {
    node_id: "{g.graph_id}:stmt:{ordinal}:branch"
    is_pattern_test: arm.cond == .PatternTest(_, _, _, _)
    affordances := [String]{"edit_inline_expr", "source_jump"}
    if is_pattern_test -> affordances.push("add_pattern_arm")
    add_node(g, node_id, "branch", if is_pattern_test -> "if ==" else -> "if", span, x, y, [String]{"control"}, affordances)
    if pattern_subject_type(g, index, arm.cond) == .Val(ty) {
        set_node_meta(g, node_id, Val("{{\"pattern_type\":{json_str(ty)}}}"))
    }
    cond: add_pin(g, node_id, "cond", "input", "Bool", "", false)
    if is_pattern_test {
        _ := add_arm_pin(g, node_id, "arm1", pattern_pin_label(src, arm.cond), pattern_arm_edit_span(src, arm.cond))
    }
    connect_expr_to_input(g, index, src, arm.cond, ordinal, "cond", node_id, cond, x - 220, y)
    project_stmt_block(g, index, src, arm.body, ordinal * 100 + 10, x + 230, y + 70)
    project_classic_switch_else(g, index, src, else_body, ordinal, x + 460, y + 70)
}

switch_was_classic_if: fn(src: String, arms: [SwitchArm], span: Span) -> Bool Never! {
    if arms.len() == 0 -> return false
    jfmt_uses_classic_if_spelling(src.bytes(), span, expr_span(arms[0].cond))
}

pattern_subject_type: fn(g: GraphBuilder, index: SemIndex, cond: Expr) -> String? Never! {
    if cond == .PatternTest(subject, _, _, _) -> return Val(expr_type(g, index, subject))
    None
}

pattern_pin_label: fn(src: String, expr: Expr) -> String Never! {
    balanced: balance_closing_parens(snippet(src, expr_span(expr)))
    if expr == .PatternTest(_, _, _, _) {
        if balanced.index_of("==") == .Val(pos) -> return balanced.slice(pos, balanced.len()).trim()
        return "== {balanced}"
    }
    balanced
}

// Dispatch arm labels omit the leading enum-variant dot and carry no ==.
dispatch_arm_pattern_label: fn(src: String, expr: Expr) -> String Never! {
    balanced: balance_closing_parens(dispatch_arm_pattern_fragment(src, expr).text.trim())
    if balanced.starts_with(".") -> return balanced.remove_prefix(".")
    balanced
}

dispatch_arm_pattern_span: fn(src: String, expr: Expr) -> Span Never! {
    start: expr_span(expr).start
    fragment: dispatch_arm_pattern_fragment(src, expr)
    Span{start: start + fragment.offset, end: start + fragment.offset + fragment.text.len()}
}

dispatch_arm_pattern_fragment: fn(src: String, expr: Expr) -> ArmPatternFragment Never! {
    span: expr_span(expr)
    source: if span.start >= 0 && span.start <= span.end && span.end <= src.len() -> src.slice(span.start, span.end) else -> ""
    fragment := source.trim_start()
    offset := source.len() - fragment.len()
    if fragment.index_of("==") == .Val(pos) {
        after_cmp: fragment.slice(pos + 2, fragment.len())
        after_space: after_cmp.trim_start()
        if after_space.starts_with("{{") {
            offset += pos + 2 + after_cmp.len() - after_space.len()
            fragment = after_space
        }
    }
    if fragment.starts_with("{{") {
        after_open: fragment.slice(1, fragment.len())
        offset += 1
        fragment = after_open.trim_start()
        offset += after_open.len() - fragment.len()
    }
    if fragment.last_index_of("->") == .Val(arrow) {
        after_arrow: fragment.slice(arrow + 2, fragment.len())
        if after_arrow.last_index_of("}}") == .Val(close) {
            after_body: after_arrow.slice(close + 1, after_arrow.len())
            offset += arrow + 2 + close + 1
            fragment = after_body.trim_start()
            offset += after_body.len() - fragment.len()
        }
    }
    ArmPatternFragment{text: fragment.trim_end(), offset: offset}
}

// The pattern of a `subject == pattern` test, through any closing parens the
// parser left outside its span.
pattern_arm_edit_span: fn(src: String, expr: Expr) -> Span Never! {
    span: expr_span(expr)
    if expr == .PatternTest(_, _, _, _) && span.start >= 0 && span.start <= span.end && span.end <= src.len() {
        if src.slice(span.start, span.end).index_of("==") == .Val(pos) {
            bytes: src.bytes()
            start := span.start + pos + 2
            loop start < span.end && is_space_byte(Int.from_u8(bytes[start])) -> start += 1
            return span_through_closing_parens(src, Span{start: start, end: span.end})
        }
    }
    span
}

balance_closing_parens: fn(s: String) -> String Never! {
    opens := 0
    closes := 0
    loop byte in s.bytes() {
        b: Int.from_u8(byte)
        if b == 40 -> opens += 1
        if b == 41 -> closes += 1
    }
    out := s
    loop _ in closes..<opens -> out = "{out})"
    out
}

project_classic_switch_else: fn(g: &GraphBuilder, index: SemIndex, src: String, else_body: [Stmt]?, ordinal: Int, x: Int, y: Int) {
    body: else_body ?? return
    if body.len() == 1 && body[0] == .Switch(subject, arms, _, span) {
        if jfmt_is_subjectless_guard(subject, span) && switch_was_classic_if(src, arms, span) {
            project_stmt(g, index, src, body[0], ordinal * 100 + 60, x, y)
            return
        }
    }
    project_stmt_block(g, index, src, body, ordinal * 100 + 70, x, y)
}

connect_expr_to_input: fn(g: &GraphBuilder, index: SemIndex, src: String, expr: Expr, ordinal: Int, role: String, owner_node_id: String, input_pin: String, x: Int, y: Int) {
    connect_expr_to_input_with_span(g, index, src, expr, expr_span(expr), ordinal, role, owner_node_id, input_pin, x, y)
}

// Compound-assignment sema gives the binary node the target span; its
// original right-hand side retains the actual source end.
expr_source_end: fn(expr: Expr) -> Int Never! {
    if expr == .Binary(_, left, right, _, _) {
        left_end: expr_source_end(left)
        right_end: expr_source_end(right)
        return if left_end > right_end -> left_end else -> right_end
    }
    expr_span(expr).end
}

binding_source_span: fn(src: String, binding: Binding) -> Span Never! {
    bytes: src.bytes()
    init_end := expr_source_end(binding.init)
    loop init_end < bytes.len() && is_space_byte(Int.from_u8(bytes[init_end])) -> init_end += 1
    if init_end < bytes.len() && Int.from_u8(bytes[init_end]) == 40 -> init_end += 1
    init_span: span_through_closing_parens(src, Span{start: expr_span(binding.init).start, end: init_end})
    Span{start: binding.name_span.start, end: init_span.end}
}

binding_init_span: fn(src: String, binding: Binding) -> Span Never! {
    end: expr_source_end(binding.init)
    start := if binding.sigil_span == .Val(sigil) -> sigil.end else -> expr_span(binding.init).start
    bytes: src.bytes()
    loop start < end && start < bytes.len() && is_space_byte(Int.from_u8(bytes[start])) {
        start += 1
    }
    Span{start: start, end: end}
}

connect_expr_to_input_with_span: fn(g: &GraphBuilder, index: SemIndex, src: String, expr: Expr, inline_span: Span, ordinal: Int, role: String, owner_node_id: String, input_pin: String, x: Int, y: Int) {
    provider_y: data_provider_y(y, ordinal)
    if project_value_node(g, index, src, expr, ordinal, role, x, provider_y) == .Val(value_pin) {
        add_inline(g, owner_node_id, ordinal, role, src, inline_span)
        add_wire_with_span(g, value_pin, input_pin, "data", Val(expr_span(expr)))
        return
    }
    if pure_leaf(expr) && !(expr == .Binary(_, _, _, _, _)) {
        add_inline(g, owner_node_id, ordinal, role, src, inline_span)
        wire_ident_refs(g, expr, input_pin)
        return
    }
    out: project_expr_node(g, index, src, expr, ordinal, x, provider_y, false) ?? return
    variant_method: expr == .MethodCall(_, method, _, _, _, _, _) && starts_uppercase(method)
    if details_composite_expr(expr) || expr == .EnumLit(_, _, _, _, _, _, _) || variant_method {
        add_inline(g, owner_node_id, ordinal, role, src, inline_span)
    }
    add_wire_with_span(g, out, input_pin, "data", Val(expr_span(expr)))
}

details_composite_expr: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .ListLit(_, _, _) | .MapLit(_, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .TupleLit(_, _, _, _) | .Present(_, _, _) | .Ok(_, _, _) | .Err(_, _, _) -> true
        else -> false
    }
}

data_provider_y: fn(y: Int, ordinal: Int) -> Int Never! { y + 96 + (ordinal % 2) * 18 }

project_value_node: fn(g: &GraphBuilder, index: SemIndex, src: String, expr: Expr, ordinal: Int, role: String, x: Int, y: Int) -> String? {
    if expr == .Place(inner, _, _, _) {
        return project_value_node(g, index, src, inner, ordinal, role, x, y)
    }
    if expr == .Ident(name, span, _) {
        key: getter_key(index, name, span)
        if g.getter_pins.get(key) == .Val(existing) -> return Val(existing)
        base_node_id: "{g.graph_id}:value:get:{canvas_ident_fragment(name)}"
        node_id := base_node_id
        loop node in g.nodes {
            if node.id == base_node_id && node.span != span {
                node_id = "{base_node_id}:{span.start}-{span.end}"
                break
            }
        }
        ty: expr_type(g, index, expr)
        add_node(g, node_id, "variable_get", name, span, x, y, [String]{"read"}, [String]{"edit_inline_expr", "source_jump"})
        pin: add_pin(g, node_id, name, "output", ty, "", false)
        g.getter_pins[key] = pin
        return Val(pin)
    }
    constant: if expr == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Str(_, _, _) | .Char(_, _, _) | .Absent(_, _) | .Todo(_, _, _) -> true
        else -> false
    }
    if !constant -> return None
    span: expr_span(expr)
    node_id: "{g.graph_id}:value:{ordinal}:{role}:{span.start}-{span.end}"
    add_node(g, node_id, "constant", snippet(src, span), span, x, y, [String]{"const"}, [String]{"edit_inline_expr", "source_jump"})
    Val(add_pin(g, node_id, "value", "output", expr_type(g, index, expr), "", false))
}

// A getter is shared by every read of the same definition.
getter_key: fn(index: SemIndex, name: String, span: Span) -> String Never! {
    loop reference in index.references {
        if reference.span != span || reference.name != name -> next
        target: reference.target ?? break
        return "{name}@{target.module_path}:{target.def_span.start}:{target.def_span.end}"
    }
    "{name}@{span.start}:{span.end}"
}

// Whether the method named at `span` resolves to a callable with no effects.
method_is_pure: fn(index: SemIndex, span: Span) -> Bool Never! {
    loop reference in index.references {
        if reference.span != span -> next
        target: reference.target ?? return false
        loop definition in index.definitions {
            found: definition.def
            if found.module_path != target.module_path || found.def_span != target.def_span -> next
            callable: semindex_callable(found) ?? return false
            effects: callable.effects ?? return false
            return effects.len() == 0
        }
        return false
    }
    false
}

canvas_ident_fragment: fn(name: String) -> String Never! {
    parts := [String]{}
    loop character in name.chars() {
        text: "{character}"
        parts.push(if text == "_" || text.is_alphabetic() || text.is_numeric() -> text else -> "_")
    }
    parts.join("")
}

project_expr_node: fn(g: &GraphBuilder, index: SemIndex, src: String, expr: Expr, ordinal: Int, x: Int, y: Int, exec_context: Bool) -> String? {
    if expr == .Binary(op, left, right, span, _) {
        node_id: "{g.graph_id}:expr:{ordinal}:operator:{span.start}-{span.end}"
        add_node(g, node_id, "expression", jfmt_bin_op_spell(op), span, x, y, [String]{}, [String]{"edit_inline_expr", "source_jump"})
        add_inline(g, node_id, ordinal, "value", src, span)
        left_input: add_pin(g, node_id, "left", "input", expr_type(g, index, left), "", false)
        connect_expr_to_input(g, index, src, left, ordinal * 1000 + 1, "left", node_id, left_input, x - 220, y)
        right_input: add_pin(g, node_id, "right", "input", expr_type(g, index, right), "", false)
        connect_expr_to_input(g, index, src, right, ordinal * 1000 + 2, "right", node_id, right_input, x - 220, y + 74)
        return Val(add_pin(g, node_id, "result", "output", expr_type(g, index, expr), "", false))
    }
    if expr == .Call(call, _) {
        node_id: "{g.graph_id}:expr:{ordinal}:call:{call.name}"
        archetype: if exec_context || call_has_effects(index, call.name) -> "function_exec" else -> "function_pure"
        add_node(g, node_id, archetype, call.name, call.name_span, x, y, effect_badges(index, call.name), [String]{"insert_call", "source_jump"})
        loop (i, arg) in call.args {
            input: add_pin(g, node_id, "arg{i + 1}", "input", expr_type(g, index, arg.expr), access_sigil(arg.convention), false)
            connect_expr_to_input(g, index, src, arg.expr, ordinal * 1000 + i + 1, "arg{i + 1}", node_id, input, x - 220, y + i * 74)
        }
        ret: call_ret(index, call.name) ?? "Void"
        return Val(add_pin(g, node_id, "result", "output", ret, "", ret.ends_with("?")))
    }
    if expr == .MethodCall(receiver, method, method_span, _, _, args, _) {
        node_id: "{g.graph_id}:expr:{ordinal}:method:{method}"
        variant_like: starts_uppercase(method)
        archetype: if variant_like || method_is_pure(index, method_span) -> "function_pure" else -> "function_exec"
        title: if variant_like -> method else -> ".{method}"
        is_game_asset: (method == "image" || method == "sound") && game_assets_receiver(receiver)
        affordances := [String]{"insert_call", "source_jump"}
        if is_game_asset || method == "component" -> affordances.push("edit_game_selection")
        add_node(g, node_id, if variant_like -> "variant" else -> archetype, title, method_span, x, y, [String]{}, affordances)
        recv_pin: add_pin(g, node_id, "self", "input", expr_type(g, index, receiver), "", false)
        connect_expr_to_input(g, index, src, receiver, ordinal * 1000 + 1, "self", node_id, recv_pin, x - 220, y)
        loop (i, arg) in args {
            input: add_pin(g, node_id, "arg{i + 1}", "input", expr_type(g, index, arg.expr), access_sigil(arg.convention), false)
            connect_expr_to_input(g, index, src, arg.expr, ordinal * 1000 + i + 2, "arg{i + 1}", node_id, input, x - 220, y + (i + 1) * 74)
        }
        return Val(add_pin(g, node_id, "result", "output", "unknown", "", false))
    }
    if expr == .Try(inner, span, _, _, _) {
        node_id: "{g.graph_id}:expr:{ordinal}:fallible"
        add_node(g, node_id, "fallible", "?", span, x, y, [String]{"fallible"}, [String]{"add_fallback_rail", "source_jump"})
        input: add_pin(g, node_id, "value", "input", expr_type(g, index, inner), "", true)
        if project_expr_node(g, index, src, inner, ordinal, x - 180, y, false) == .Val(out) {
            add_wire(g, out, input, "fallible")
        }
        return Val(add_pin(g, node_id, "ok", "output", "unknown", "", false))
    }
    if expr == .OrFallback(value, _, _, _, _) {
        return project_expr_node(g, index, src, value, ordinal, x, y, exec_context)
    }
    if expr == .ListLit(items, span, _) {
        node_id: "{g.graph_id}:expr:{ordinal}:list"
        add_node(g, node_id, "expression", "list", span, x, y, [String]{"multi-input"}, [String]{"append_multi_input", "edit_inline_expr", "source_jump"})
        loop (i, item) in items {
            input: add_pin(g, node_id, "item{i + 1}", "input", expr_type(g, index, item), "", false)
            set_pin_source_span(g, input, expr_span(item))
            set_pin_append(g, input, "remove_multi_input_element", i)
            connect_expr_to_input(g, index, src, item, ordinal * 1000 + i + 1, "item{i + 1}", node_id, input, x - 220, y + i * 74)
        }
        return Val(add_pin(g, node_id, "value", "output", expr_type(g, index, expr), "", false))
    }
    node_id: "{g.graph_id}:expr:{ordinal}:expr"
    span: expr_span(expr)
    add_node(g, node_id, "expression", expr_title(expr), span, x, y, [String]{"expression"}, [String]{"edit_inline_expr", "source_jump"})
    add_inline(g, node_id, ordinal, "value", src, span)
    Val(add_pin(g, node_id, "value", "output", expr_type(g, index, expr), "", false))
}
