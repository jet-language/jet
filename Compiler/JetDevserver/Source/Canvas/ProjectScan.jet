// The Canvas project around one entry file: its roots, the authority-checked
// files Canvas may edit, and the project JSON the panels read. A Canvas file
// is checked through the host's `LSPChecker`, so the devserver never builds a
// compile request of its own.
use {
    scan_files: core.files
    scan_paths: core.files.path
    jet_canvas.[json_bool, json_optional_str, json_str, json_strs, source_revision]
    jet_driver.[jet_driver_has_errors]
    jet_env_model.[DevServicePlan, envmodel_evaluate_env, envmodel_workspace_evaluate_checked_source, envmodel_workspace_load_checked_source]
    jet_foundation.[Diagnostic, sha256_hex_bytes]
    jet_lsp.[LSPChecker, LSPOverlay]
    jet_pkg_model.[
        AuthorityError,
        AuthorityResolver,
        CheckedFile,
        EnvironmentFact,
        ManifestError,
        OutputPayload,
        PackageFacts,
        ServiceFact,
        WorkspaceDeclarationCache,
        WorkspacePlan,
        WorkspacePlanMember,
        WorkspaceSource,
        WorkspaceSourceRole,
        pkg_dependency_views,
        pkg_extract_inline_package,
        pkg_find_manifest_root_checked,
        pkg_manifest_path_checked,
        pkg_output_kind_name,
        pkg_package_facts_for_entry,
        pkg_package_facts_for_root,
        pkg_package_target_views,
        pkg_target_profile_views,
    ]
    jetpack_foundation.[ENV_FILE, JETPACK_PROMPT_LABEL, PACKAGE_FILE, UNIFIED_LOCK_FILE, WORKSPACE_FILE]
}

// Why a Canvas file has no projection: the authority refusal or the check's
// diagnostics.
#Error
ProjectFileError: struct {
    diagnostics: [Diagnostic]
}

project_file_error: fn(diagnostic: Diagnostic) -> ProjectFileError Never! {
    ProjectFileError{diagnostics: [Diagnostic]{diagnostic}}
}

ProjectFileRec: struct {
    path: String
    revision: String
    kind: String
}

ProjectContext: struct {
    entry_path: String
    project_root: String
    manifest_root: String?
    ecosystem_root: String?
    workspace_root: String?
    files: [ProjectFileRec]
    project_revision: String
    authority_diagnostic: Diagnostic?
}

TouchedProjectFile: struct {
    path: String
    revision: String
}

ProjectChange: struct {
    path: String
    rel: String
    before: String
    after: String
    existed: Bool
}

WorkspaceBoundary: struct {
    root: String
    member_root: String?
    malformed: Bool
    diagnostic: Diagnostic?
}

// The workspace source at a root and, for an index source, its evaluated
// members. `source_failed` marks a source that could not be resolved at all.
WorkspaceView: struct {
    source_path: String?
    members: [WorkspacePlanMember]
    diagnostic: Diagnostic?
    source_failed: Bool
}

ProjectFiles: struct {
    records: [ProjectFileRec]
    diagnostic: Diagnostic?
}

EnvProjectJSON: struct {
    envs: String
    services: String
    diagnostics: String
}

project_file: fn(checker: LSPChecker, path: String) -> Projection ProjectFileError! {
    context: project_file_context(checker, path, None)
    Ok(context.projection)
}

// Check one Canvas file with its authority-read text overlaid, then project
// it with the semantic index that check built. An error diagnostic refuses.
project_file_context: fn(checker: LSPChecker, path: String, runtime_events: String?) -> QueryContext ProjectFileError! {
    resolver: AuthorityResolver.open(entry_parent(path)) ?? return Err(project_file_error(err.diagnostic()))
    checked: resolver.checked_file(scan_files.basename(path)) ?? return Err(project_file_error(err.diagnostic()))
    src: checked.text() ?? return Err(project_file_error(err.diagnostic()))
    resolver.revalidate_file(checked) ?? return Err(project_file_error(err.diagnostic()))
    result: checker.check(path, [LSPOverlay]{LSPOverlay{path: path, source: src}})
    if jet_driver_has_errors(result.diagnostics) {
        return Err(ProjectFileError{diagnostics: result.diagnostics})
    }
    index: result.index ?? return Err(ProjectFileError{diagnostics: result.diagnostics})
    resolver.revalidate_file(checked) ?? return Err(project_file_error(err.diagnostic()))
    source_id: rel_path(project_context_for_entry(path).project_root, checked.path)
    Ok(project_checked(path, source_id, src, result.modules, index, runtime_events))
}

project_context_for_entry: fn(path: String) -> ProjectContext {
    cache := WorkspaceDeclarationCache.new()
    entry_path: absolute_entry_path(path)
    entry_dir: entry_parent(entry_path)
    boundary: find_workspace_boundary(cache, entry_dir)
    workspace_root := String?{None}
    boundary_diagnostic := Diagnostic?{None}
    if boundary == .Val(found) {
        if found.malformed || found.member_root != None || same_path(entry_dir, found.root) {
            workspace_root = Val(found.root)
        }
        boundary_diagnostic = found.diagnostic
    }
    manifest_diagnostic := Diagnostic?{None}
    manifest_root := String?{None}
    if pkg_find_manifest_root_checked(cache, entry_dir) == {
        .Ok(found) -> manifest_root = found
        .Err(error) -> manifest_diagnostic = Val(error.diagnostic)
    }
    if manifest_root == .Val(manifest) {
        if boundary == .Val(found) {
            if !manifest_in_boundary(entry_dir, manifest, found) -> manifest_root = None
        }
    }
    ecosystem_diagnostic := Diagnostic?{None}
    ecosystem_root := manifest_root
    if workspace_root == .Val(root) {
        if pkg_manifest_path_checked(root) == {
            .Ok(found) -> {
                if found != None -> ecosystem_root = Val(root)
            }
            .Err(error) -> ecosystem_diagnostic = Val(error.diagnostic)
        }
    }
    project_root := entry_dir
    if ecosystem_root == .Val(root) -> project_root = root
    if manifest_root == .Val(root) -> project_root = root
    if workspace_root == .Val(root) -> project_root = root
    collected: collect_project_files(cache, project_root, entry_path, manifest_root, ecosystem_root, workspace_root)
    authority_diagnostic := boundary_diagnostic
    if ecosystem_diagnostic != None -> authority_diagnostic = ecosystem_diagnostic
    if manifest_diagnostic != None -> authority_diagnostic = manifest_diagnostic
    if collected.diagnostic != None -> authority_diagnostic = collected.diagnostic
    if pkg_package_facts_for_entry(cache, entry_path) == .Err(error) {
        authority_diagnostic = Val(error.diagnostic)
    }
    ProjectContext{
        entry_path: entry_path,
        project_root: project_root,
        manifest_root: manifest_root,
        ecosystem_root: ecosystem_root,
        workspace_root: workspace_root,
        files: collected.records,
        project_revision: project_revision_from_files(collected.records),
        authority_diagnostic: authority_diagnostic,
    }
}

// A manifest above the entry belongs to the project only inside the
// workspace boundary: within the entry's member, or the workspace's own
// manifest when the entry sits at the workspace root.
manifest_in_boundary: fn(entry_dir: String, manifest: String, boundary: WorkspaceBoundary) -> Bool {
    if boundary.member_root == .Val(member_root) -> return path_is_within(manifest, member_root)
    if same_path(entry_dir, boundary.root) -> return same_path(manifest, boundary.root)
    path_is_within(manifest, boundary.root) && !same_path(manifest, boundary.root)
}

absolute_entry_path: fn(path: String) -> String {
    parent: entry_parent(path)
    if scan_files.is_abs(path) -> return scan_files.join(parent, scan_files.basename(path))
    base: scan_files.canonicalize(parent) ?? {
        cwd: scan_files.cwd() ?? return scan_files.join(parent, scan_files.basename(path))
        scan_files.join(cwd, parent)
    }
    scan_files.join(base, scan_files.basename(path))
}

// The directory holding `path`; `.` for a bare file name.
entry_parent: fn(path: String) -> String Never! {
    parent: scan_files.dirname(path)
    if parent == "" -> "." else -> parent
}

// The parent of a directory, or None at the filesystem root.
parent_dir: fn(dir: String) -> String? Never! {
    parent: scan_files.dirname(dir)
    if parent == "" || parent == dir -> return None
    Val(parent)
}

// The nearest workspace source above `start`. A refused root or source is a
// malformed boundary carrying its diagnostic.
find_workspace_boundary: fn(cache: &WorkspaceDeclarationCache, start: String) -> WorkspaceBoundary? {
    opened: AuthorityResolver.open(start) ?? {
        if err.is_missing() -> return None
        return Val(malformed_boundary(start, err.diagnostic()))
    }
    dir := opened.root
    loop {
        resolver: AuthorityResolver.open(dir) ?? {
            if !err.is_missing() -> return Val(malformed_boundary(dir, err.diagnostic()))
            dir = parent_dir(dir) ?? return None
            next
        }
        source := WorkspaceSource?{None}
        if resolver.resolve_workspace_source(cache) == {
            .Ok(found) -> source = found
            .Err(error) -> return Val(malformed_boundary(resolver.root, error.workspace_diagnostic()))
        }
        if source == .Val(found) -> return Val(workspace_boundary(resolver, start, found))
        dir = parent_dir(resolver.root) ?? return None
    }
}

malformed_boundary: fn(root: String, diagnostic: Diagnostic) -> WorkspaceBoundary Never! {
    WorkspaceBoundary{root: root, member_root: None, malformed: true, diagnostic: Val(diagnostic)}
}

// The boundary a resolved workspace source draws: an authority source is the
// boundary itself, and an index places the entry in its deepest member.
workspace_boundary: fn(resolver: AuthorityResolver, start: String, source: WorkspaceSource) -> WorkspaceBoundary {
    plan: envmodel_workspace_evaluate_checked_source(source, resolver) ?? return malformed_boundary(resolver.root, err.diagnostic)
    if source.role == WorkspaceSourceRole.Authority {
        return WorkspaceBoundary{root: resolver.root, member_root: None, malformed: false, diagnostic: None}
    }
    if matching_member_root(resolver, start, plan) == {
        .Ok(member_root) -> WorkspaceBoundary{root: resolver.root, member_root: member_root, malformed: false, diagnostic: None}
        .Err(error) -> malformed_boundary(resolver.root, error.diagnostic())
    }
}

// The deepest checked member directory that holds the entry directory.
matching_member_root: fn(resolver: AuthorityResolver, entry_dir: String, plan: WorkspacePlan) -> String? AuthorityError! {
    entry_resolver: AuthorityResolver.open(entry_dir)
    best := String?{None}
    best_depth := -1
    loop member in plan.members {
        directory: resolver.checked_directory(member.path)
        resolver.revalidate_directory(directory)
        depth: directory.path.split("/").to_list().len()
        if depth > best_depth && scan_paths.is_relative_to(scan_paths.of(entry_resolver.root), scan_paths.of(directory.path)) {
            best = Val(directory.path)
            best_depth = depth
        }
    }
    resolver.revalidate_root()
    Ok(best)
}

path_is_within: fn(path: String, root: String) -> Bool {
    real_path: comparable_path(path) ?? return false
    real_root: comparable_path(root) ?? return false
    scan_paths.is_relative_to(scan_paths.of(real_path), scan_paths.of(real_root))
}

same_path: fn(left: String, right: String) -> Bool {
    real_left: comparable_path(left) ?? return false
    real_right: comparable_path(right) ?? return false
    real_left == real_right
}

comparable_path: fn(path: String) -> String? {
    if scan_files.canonicalize(path) == .Ok(real) -> return Val(real)
    if AuthorityResolver.open(path) == .Ok(resolver) -> return Val(resolver.root)
    None
}

within_any: fn(path: String, roots: [String]) -> Bool {
    loop root in roots {
        if path_is_within(path, root) -> return true
    }
    false
}

// The workspace source at `root`, and an index source's evaluated members.
workspace_view: fn(cache: &WorkspaceDeclarationCache, root: String) -> WorkspaceView {
    resolver: AuthorityResolver.open(root) ?? {
        return WorkspaceView{source_path: None, members: [WorkspacePlanMember]{}, diagnostic: Val(err.diagnostic()), source_failed: true}
    }
    source: if resolver.resolve_workspace_source(cache) == {
        .Val(found) -> found
        .None -> return WorkspaceView{source_path: None, members: [WorkspacePlanMember]{}, diagnostic: None, source_failed: false}
        .Err(error) -> return WorkspaceView{source_path: None, members: [WorkspacePlanMember]{}, diagnostic: Val(error.workspace_diagnostic()), source_failed: true}
    }
    path: source.path
    if source.role != WorkspaceSourceRole.Index {
        return WorkspaceView{source_path: Val(path), members: [WorkspacePlanMember]{}, diagnostic: None, source_failed: false}
    }
    snapshot: envmodel_workspace_load_checked_source(resolver, source) ?? {
        return WorkspaceView{source_path: Val(path), members: [WorkspacePlanMember]{}, diagnostic: Val(err.diagnostic), source_failed: false}
    }
    WorkspaceView{source_path: Val(path), members: snapshot.plan.members, diagnostic: None, source_failed: false}
}

// The project's own files, each read through the project's authority root:
// the entry, env.jet, the package and workspace manifests, the lock and the
// discovered sources. The first refusal is the project's diagnostic.
collect_project_files: fn(cache: &WorkspaceDeclarationCache, project_root: String, entry_path: String, manifest_root: String?, ecosystem_root: String?, workspace_root: String?) -> ProjectFiles {
    paths := [String:Bool]{}
    diagnostic := Diagnostic?{None}
    push_existing(paths, entry_path)
    push_existing(paths, scan_files.join(project_root, ENV_FILE))
    if manifest_root == .Val(root) -> push_existing(paths, scan_files.join(root, PACKAGE_FILE))
    if ecosystem_root == .Val(root) -> push_existing(paths, scan_files.join(root, PACKAGE_FILE))
    workspace_source := ""
    fallback_workspace := ""
    member_roots := [String]{}
    if workspace_root == .Val(root) {
        view: workspace_view(cache, root)
        if view.source_path == .Val(source_path) {
            workspace_source = source_path
            push_existing(paths, source_path)
        }
        push_existing(paths, scan_files.join(root, UNIFIED_LOCK_FILE))
        loop member in view.members {
            member_root: scan_files.join(root, member.path)
            push_existing(paths, scan_files.join(member_root, PACKAGE_FILE))
            member_roots.push(member_root)
        }
        if view.source_failed -> fallback_workspace = scan_files.join(root, WORKSPACE_FILE)
        if view.diagnostic != None -> diagnostic = view.diagnostic
    }
    resolver: AuthorityResolver.open(project_root) ?? return ProjectFiles{records: [ProjectFileRec]{}, diagnostic: Val(err.diagnostic())}
    discovered: resolver.discover_source_files() ?? {
        keep_first(diagnostic, err.diagnostic())
        [CheckedFile]{}
    }
    loop file in discovered {
        if file.path == fallback_workspace -> next
        if workspace_root != None && !within_any(file.path, member_roots) -> next
        paths[file.path] = true
    }
    records := [ProjectFileRec]{}
    loop path in sorted_keys(paths) {
        relative: resolver.relative_path(path) ?? {
            keep_first(diagnostic, err.diagnostic())
            next
        }
        checked: resolver.checked_file(relative) ?? {
            keep_first(diagnostic, err.diagnostic())
            next
        }
        resolver.revalidate_file(checked) ?? {
            keep_first(diagnostic, err.diagnostic())
            next
        }
        name: scan_files.basename(path)
        kind: if {
            name == PACKAGE_FILE -> "package"
            path == workspace_source -> "workspace"
            name == ENV_FILE -> "env"
            relative == UNIFIED_LOCK_FILE -> "lock"
            else -> "source"
        }
        records.push(ProjectFileRec{path: relative, revision: "sha256-{sha256_hex_bytes(checked.bytes)}", kind: kind})
    }
    ProjectFiles{records: records, diagnostic: diagnostic}
}

keep_first: fn(slot: &Diagnostic?, diagnostic: Diagnostic) {
    if slot == None -> slot = Val(diagnostic)
}

// A path that is present (a missing path is skipped); a regular file with
// more than one hard link is skipped, since Canvas never edits through one.
push_existing: fn(paths: &[String:Bool], path: String) {
    info: scan_files.stat(path) ?? {
        if err == .NotFound(_) {
            return
        }
        paths[path] = true
        return
    }
    if info.is_file && info.links != 1 {
        return
    }
    paths[path] = true
}

project_revision_from_files: fn(records: [ProjectFileRec]) -> String Never! {
    rows: loop record in records -> "{record.path}\n{record.revision}\n{record.kind}\n"
    source_revision(rows.join(""))
}

// `path` relative to `root`; a path outside the root is kept as written.
rel_path: fn(root: String, path: String) -> String Never! {
    if path == root -> return ""
    prefix: if root.ends_with("/") -> root else -> "{root}/"
    path.removeprefix(prefix)
}

// One project-level diagnostic in the Canvas report shape.
diagnostic_json: fn(diagnostic: Diagnostic) -> String Never! {
    diagnostics_json(diagnostic.source_path ?? "", "", [Diagnostic]{diagnostic})
}

workspace_project_json: fn(project_root: String, workspace_root: String?) -> String {
    root: workspace_root ?? return "null"
    cache := WorkspaceDeclarationCache.new()
    view: workspace_view(cache, root)
    source_path := ""
    if view.source_path == .Val(path) -> source_path = rel_path(project_root, path) else if view.source_failed {
        fallback: scan_files.join(root, WORKSPACE_FILE)
        if scan_files.stat(fallback) == .Ok(_) -> source_path = rel_path(project_root, fallback)
    }
    members: loop member in view.members -> "{{\"name\":{json_str(member.name)},\"path\":{json_str(member.path)}}}"
    diagnostics: if view.diagnostic == .Val(diagnostic) -> diagnostic_json(diagnostic) else -> ""
    "{{\"path\":{json_str(source_path)},\"members\":[{members.join(",")}],\"diagnostics\":[{diagnostics}]}}"
}

// The project's package directories: the manifest and ecosystem roots and the
// workspace members, or the entry's own directory when it carries an inline
// Package.
project_package_dirs: fn(cache: &WorkspaceDeclarationCache, entry_path: String, manifest_root: String?, ecosystem_root: String?, workspace_root: String?) -> [String] {
    dirs := [String:Bool]{}
    if manifest_root == .Val(root) -> dirs[root] = true
    if ecosystem_root == .Val(root) -> dirs[root] = true
    if workspace_root == .Val(root) {
        loop member in workspace_view(cache, root).members {
            dirs[scan_files.join(root, member.path)] = true
        }
    }
    if dirs.len() > 0 -> return sorted_keys(dirs)
    inline: inline_entry_dir(entry_path) ?? return [String]{}
    [String]{inline}
}

packages_project_json: fn(project_root: String, entry_path: String, manifest_root: String?, ecosystem_root: String?, workspace_root: String?) -> String {
    cache := WorkspaceDeclarationCache.new()
    rows: loop dir in project_package_dirs(cache, entry_path, manifest_root, ecosystem_root, workspace_root) -> package_project_json(cache, project_root, entry_path, dir)
    rows.join(",")
}

targets_project_json: fn(project_root: String, entry_path: String, manifest_root: String?, ecosystem_root: String?, workspace_root: String?) -> String {
    cache := WorkspaceDeclarationCache.new()
    rows := [String]{}
    loop dir in project_package_dirs(cache, entry_path, manifest_root, ecosystem_root, workspace_root) {
        loop row in package_targets_json(cache, project_root, entry_path, dir) -> rows.push(row)
    }
    rows.join(",")
}

inline_entry_dir: fn(entry_path: String) -> String? {
    source: scan_files.read(entry_path) ?? return None
    if pkg_extract_inline_package(source) == {
        .Val(_) -> Val(entry_parent(entry_path))
        .None | .Err(_) -> None
    }
}

// The entry's own Package when it lies in `dir`, else the Package rooted at
// `dir`.
canonical_package_facts: fn(cache: &WorkspaceDeclarationCache, dir: String, entry_path: String) -> PackageFacts ManifestError! {
    if path_is_within(entry_path, dir) {
        entry_facts: pkg_package_facts_for_entry(cache, entry_path)
        if entry_facts == .Val(facts) -> return Ok(facts)
    }
    found: pkg_package_facts_for_root(cache, dir)
    facts: found ?? return Err(ManifestError{diagnostic: AuthorityError.Missing{path: scan_files.join(dir, PACKAGE_FILE), cause: "no canonical Package"}.diagnostic()})
    Ok(facts)
}

canonical_package_error: fn(project_root: String, dir: String, diagnostic: Diagnostic) -> String {
    base: scan_files.basename(dir)
    name: if base == "" -> "package" else -> base
    "{{\"path\":{json_str(rel_path(project_root, dir))},\"manifest\":{json_str(rel_path(project_root, scan_files.join(dir, PACKAGE_FILE)))},\"name\":{json_str(name)},\"version\":\"\",\"target\":\"native\",\"deps\":[],\"targets\":[],\"outputs\":[],\"environments\":[],\"effects_enabled\":false,\"diagnostics\":[{diagnostic_json(diagnostic)}]}}"
}

output_payload_json: fn(payload: OutputPayload) -> String Never! {
    if payload == {
        .Null -> "null"
        .Bool(value) -> json_bool(value)
        .Number(value) -> value
        .String(value) -> json_str(value)
        .Array(values) -> {
            items: loop value in values -> output_payload_json(value)
            "[{items.join(",")}]"
        }
        .Object(values) -> {
            names := values.keys().to_list()
            names.sort()
            fields: loop name in names -> "{json_str(name)}:{output_payload_json(values[name])}"
            "{{{fields.join(",")}}}"
        }
    }
}

// An output's kind, entry, payload and provenance fields.
output_fields_json: fn(facts: PackageFacts, name: String) -> String Never! {
    output: facts.outputs[name]
    field: "outputs.{name}"
    "\"kind\":{json_str(pkg_output_kind_name(output.kind))},\"entry\":{json_optional_str(output.entry)},\"payload\":{output_payload_json(output.payload)},\"provenance\":[{json_strs(facts.field_provenance(field))}]"
}

sorted_output_names: fn(facts: PackageFacts) -> [String] Never! {
    names := facts.outputs.keys().to_list()
    names.sort()
    names
}

package_targets_json: fn(cache: &WorkspaceDeclarationCache, project_root: String, entry_path: String, dir: String) -> [String] {
    facts: canonical_package_facts(cache, dir, entry_path) ?? return [String]{canonical_package_error(project_root, dir, err.diagnostic)}
    head: "\"package\":{json_str(facts.name)},\"package_path\":{json_str(rel_path(project_root, dir))},\"manifest\":{json_str(rel_path(project_root, scan_files.join(dir, PACKAGE_FILE)))}"
    rows := [String]{}
    loop name in sorted_output_names(facts) {
        rows.push("{{{head},\"target\":{json_str(facts.outputs[name].name)},{output_fields_json(facts, name)}}}")
    }
    loop view in pkg_package_target_views(facts.packages) {
        loop kind in view.targets {
            rows.push("{{{head},\"target\":{json_str(kind)},\"kind\":{json_str(kind)},\"entry\":null,\"payload\":null,\"provenance\":null}}")
        }
    }
    rows
}

package_project_json: fn(cache: &WorkspaceDeclarationCache, project_root: String, entry_path: String, dir: String) -> String {
    facts: canonical_package_facts(cache, dir, entry_path) ?? return canonical_package_error(project_root, dir, err.diagnostic)
    deps: loop view in pkg_dependency_views(facts.deps) -> "{{\"name\":{json_str(view.name)},\"source\":{json_str(view.source)}}}"
    profiles: loop view in pkg_target_profile_views(facts.targets) -> "{{\"name\":{json_str(view.name)},\"profile\":{json_str(view.profile)}}}"
    package_targets := [String]{}
    outputs := [String]{}
    loop name in sorted_output_names(facts) {
        output_name: json_str(facts.outputs[name].name)
        outputs.push("{{\"name\":{output_name},{output_fields_json(facts, name)}}}")
        package_targets.push(output_name)
    }
    loop package in facts.packages {
        package_name: json_str(package.name)
        if !package_targets.contains(package_name) -> package_targets.push(package_name)
    }
    environment_names := facts.environments.keys().to_list()
    environment_names.sort()
    environments: loop key in environment_names -> environment_fact_json(facts.environments[key])
    members: loop member in facts.members -> member.path()
    "{{\"path\":{json_str(rel_path(project_root, dir))},\"manifest\":{json_str(rel_path(project_root, scan_files.join(dir, PACKAGE_FILE)))},\"name\":{json_str(facts.name)},\"version\":{json_optional_str(facts.version)},\"targets\":[{profiles.join(",")}],\"package_targets\":[{package_targets.join(",")}],\"deps\":[{deps.join(",")}],\"outputs\":[{outputs.join(",")}],\"environments\":[{environments.join(",")}],\"configs\":[{json_strs(facts.configs)}],\"members\":[{json_strs(members)}],\"package_facts\":null,\"workspace_overlays\":null,\"effects_enabled\":false,\"diagnostics\":[]}}"
}

environment_fact_json: fn(environment: EnvironmentFact) -> String Never! {
    service_names := environment.services.keys().to_list()
    service_names.sort()
    services: loop name in service_names -> service_fact_json(name, environment.services[name])
    secret_names := environment.secrets.keys().to_list()
    secret_names.sort()
    "{{\"name\":{json_str(environment.name)},\"tools\":[{json_strs(environment.tools)}],\"services\":[{services.join(",")}],\"secrets\":[{json_strs(secret_names)}]}}"
}

service_fact_json: fn(name: String, service: ServiceFact) -> String Never! {
    "{{\"name\":{json_str(name)},\"enable\":{json_bool(service.enable)},\"ports\":[{ints_json(service.ports)}],\"ready\":{json_optional_str(service.ready)}}}"
}

ints_json: fn(values: [Int]) -> String Never! {
    items: loop value in values -> "{value}"
    items.join(",")
}

// The project's env.jet plan as the env and service panels read it. A missing
// env.jet is no plan; any other refusal is the panel's diagnostic.
env_project_json: fn(project_root: String) -> EnvProjectJSON {
    resolver: AuthorityResolver.open(project_root) ?? return env_refusal(err)
    checked: resolver.checked_file(ENV_FILE) ?? return env_refusal(err)
    src: checked.text() ?? return env_refusal(err)
    resolver.revalidate_file(checked) ?? return env_refusal(err)
    plan: envmodel_evaluate_env(src, project_root) ?? return env_failure(err.diagnostic)
    resolver.revalidate_file(checked) ?? return env_refusal(err)
    reload: if plan.lifecycle.reload == {
        .Never -> "never"
        .Prompt -> "prompt"
        .Watch(_, _) -> "watch"
    }
    prompt: plan.prompt ?? JETPACK_PROMPT_LABEL
    secrets: loop secret in plan.secrets -> secret.name
    presets: loop preset in plan.presets -> preset.name
    languages: loop language in plan.languages -> language.name
    services: loop service in plan.dev_services -> dev_service_json(service)
    envs: "{{\"path\":{json_str(ENV_FILE)},\"prompt\":{json_str(prompt)},\"environments\":[{json_strs(plan.environment_names)}],\"sources\":[{json_strs(plan.source_files)}],\"presets\":[{json_strs(presets)}],\"languages\":[{json_strs(languages)}],\"reload\":{json_str(reload)},\"packages\":[{json_strs(plan.package_refs)}],\"secrets\":[{json_strs(secrets)}],\"diagnostics\":[]}}"
    EnvProjectJSON{envs: envs, services: services.join(","), diagnostics: ""}
}

env_refusal: fn(error: AuthorityError) -> EnvProjectJSON Never! {
    if error.is_missing() -> return EnvProjectJSON{envs: "", services: "", diagnostics: ""}
    env_failure(error.diagnostic())
}

env_failure: fn(diagnostic: Diagnostic) -> EnvProjectJSON Never! {
    EnvProjectJSON{envs: "", services: "", diagnostics: diagnostic_json(diagnostic)}
}

dev_service_json: fn(service: DevServicePlan) -> String Never! {
    run: if service.run == .Val(args) -> "[{json_strs(args)}]" else -> "null"
    shutdown: if service.shutdown == {
        .Val(.Kill) -> "\"Kill\""
        .Val(.Term(_)) -> "\"Term\""
        .None -> "null"
    }
    extra: loop field in service.extra -> "{{\"key\":{json_str(field.name)},\"value\":{json_str(field.value)}}}"
    "{{\"name\":{json_str(service.name)},\"enable\":{json_bool(service.enable)},\"ports\":[{ints_json(service.ports)}],\"run\":{run},\"shutdown\":{shutdown},\"data_dir\":{json_optional_str(service.data_dir)},\"ready\":{json_optional_str(service.ready)},\"after\":[{json_strs(service.after)}],\"before_start\":[{json_strs(service.before_start)}],\"extra\":[{extra.join(",")}],\"source\":{json_str(ENV_FILE)}}}"
}

lock_project_json: fn(project_root: String) -> String {
    resolver: AuthorityResolver.open(project_root) ?? return ""
    lock: resolver.checked_file(UNIFIED_LOCK_FILE) ?? return ""
    revision: "sha256-{sha256_hex_bytes(lock.bytes)}"
    resolver.revalidate_file(lock) ?? return ""
    "{{\"path\":{json_str(rel_path(project_root, lock.path))},\"revision\":{json_str(revision)},\"kind\":\"unified\"}}"
}
