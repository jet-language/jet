// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:13
pub fn project_file(path: &OSPath) -> Projection Err! [Diagnostic] { project_file_with_runtime(path, .None) }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:17
pub fn project_file_with_runtime(path: &OSPath, runtime_events: String?) -> Projection Err! [Diagnostic] {
    jet_driver.run_compiler_work(() -> project_file_with_runtime_on_compiler_stack(path, runtime_events)) // GATE #4494: compiler worker stack.
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:29
fn project_file_with_runtime_on_compiler_stack(path: &OSPath, runtime_events: String?) -> Projection Err! [Diagnostic] {
    path_str := path.to_string_lossy()
    root := path.parent().unwrap_or_else(() -> OSPath.new("."))
    resolver := AuthorityResolver.open(root) catch error { throw [error.diagnostic()] }
    file_name := path.file_name().unwrap_or_else(() -> {
        throw [AuthorityError.Invalid { path: path.to_path_buf(), detail: "source entry has no file name" }.diagnostic()]
    })
    checked := resolver.checked_file(OSPath.new(file_name)) catch error { throw [error.diagnostic()] }
    resolver.revalidate_file(checked) catch error { throw [error.diagnostic()] }
    src := checked.text() catch error { throw [error.diagnostic()] }
    package_facts := jet_semindex.package_facts_for_entry(path) catch error { throw [jet_semindex.package_facts_diagnostic(path, error)] }
    (diags, bundle, facts) := jet_driver.Driver.check_file_with_effect_facts(path_str, .Val((checked.path, src)), true)
    errors := diags.iter().filter((d) -> d.severity == .Error).cloned().collect()
    if !errors.is_empty() -> throw errors
    bundle := bundle.unwrap_or_else(() -> { throw diags })
    workspace_overlay_policy := jet_semindex.workspace_overlay_policy_for_entry(path) catch diagnostic { throw [diagnostic] }
    resolver.revalidate_file(checked) catch error { throw [error.diagnostic()] }
    source_id := rel_path(project_context_for_entry(path).project_root, checked.path)
    project_checked(path, source_id, src, bundle, facts, package_facts, workspace_overlay_policy, runtime_events)
}
