// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:127
pub fn project_context_for_entry(path: &OSPath) -> ProjectContext {
    entry_path := absolute_entry_path(path)
    entry_dir := entry_path.parent().unwrap_or_else(() -> OSPath.new("."))
    workspace_boundary := find_workspace_boundary(entry_dir)
    workspace_root := workspace_boundary.as_ref().filter((boundary) -> boundary.malformed || boundary.member_root.is_some() || same_path(entry_dir, boundary.root)).map((boundary) -> boundary.root.clone())
    manifest_diagnostic: Diagnostic? := .None
    manifest_root := jet_driver.Loader.find_manifest_root_checked(entry_dir) catch diagnostic { manifest_diagnostic = .Val(diagnostic); .None }
    manifest_root = manifest_root.filter((manifest) -> {
        if workspace_boundary == .None -> return true
        boundary := workspace_boundary.as_ref().unwrap()
        match boundary.member_root {
            .Val(member_root) -> path_is_within(manifest, member_root)
            .None -> if same_path(entry_dir, boundary.root) -> same_path(manifest, boundary.root) else path_is_within(manifest, boundary.root) && !same_path(manifest, boundary.root)
        }
    })
    ecosystem_diagnostic: Diagnostic? := .None
    workspace_ecosystem_root: OSPath? := .None
    if workspace_root == .Val(root) {
        resolver := AuthorityResolver.open(root).map((value) -> .Val(value)) catch error {
            if !error.is_missing() -> ecosystem_diagnostic = .Val(error.diagnostic())
            .None
        }
        if resolver == .Val(resolver) {
            manifest := resolver.checked_manifest(OSPath.new(".")).map((value) -> .Val(value)) catch error {
                if !error.is_missing() -> ecosystem_diagnostic = .Val(error.diagnostic())
                .None
            }
            if manifest == .Val(manifest) {
                resolver.revalidate_file(manifest.file) catch error { ecosystem_diagnostic = .Val(error.diagnostic()) }
                if ecosystem_diagnostic.is_none() -> workspace_ecosystem_root = .Val(root.to_path_buf())
            }
        }
    }
    ecosystem_root := workspace_ecosystem_root.or_else(() -> manifest_root.clone())
    project_root := workspace_root.as_ref().or(manifest_root.as_ref()).or(ecosystem_root.as_ref()).unwrap_or(entry_dir).to_path_buf()
    (files, collection_diagnostic) := collect_project_files(project_root, entry_path, manifest_root, ecosystem_root, workspace_root)
    parts := jet_driver.ProjectParts.scan(project_root)
    project_revision := project_revision_from_files(files)
    package_diagnostic := jet_semindex.package_facts_for_entry(entry_path).err().map((error) -> jet_semindex.package_facts_diagnostic(entry_path, error))
    ProjectContext { entry_path: entry_path, project_root: project_root, manifest_root: manifest_root, ecosystem_root: ecosystem_root, workspace_root: workspace_root, files: files, parts: parts, project_revision: project_revision,
        authority_diagnostic: package_diagnostic.or(collection_diagnostic).or(manifest_diagnostic).or(ecosystem_diagnostic).or_else(() -> workspace_boundary.as_ref().and_then((boundary) -> boundary.diagnostic.clone())) }
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:218
fn absolute_entry_path(path: &OSPath) -> OSPath {
    if path.is_absolute() -> return path.to_path_buf()
    parent := path.parent().filter((parent) -> !parent.as_os_str().is_empty()).unwrap_or_else(() -> OSPath.new("."))
    base := fs.canonicalize(parent).or_else((_) -> std.env.current_dir().map((cwd) -> cwd.join(parent))).unwrap_or_else((_) -> parent.to_path_buf())
    path.file_name().map((name) -> base.join(name)).unwrap_or(base)
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:232
fn find_workspace_boundary(start: &OSPath) -> WorkspaceBoundary? {
    resolver := AuthorityResolver.open(start) catch error {
        if error.is_missing() -> return .None
        return .Val(WorkspaceBoundary { root: start.to_path_buf(), member_root: .None, malformed: true, diagnostic: .Val(error.diagnostic()) })
    }
    dir := resolver.root().to_path_buf()
    loop {
        resolver := AuthorityResolver.open(dir) catch error {
            if error.is_missing() {
                if dir.parent() == .Val(parent) { dir = parent.to_path_buf(); continue }
                return .None
            }
            return .Val(WorkspaceBoundary { root: dir, member_root: .None, malformed: true, diagnostic: .Val(error.diagnostic()) })
        }
        dir = resolver.root().to_path_buf()
        source := resolver.resolve_workspace_source() catch error {
            return .Val(WorkspaceBoundary { root: dir, member_root: .None, malformed: true, diagnostic: .Val(error.workspace_diagnostic()) })
        }
        if source == .Val(source) {
            diagnostic: Diagnostic? := .None
            resolver.revalidate_source(source) catch error { diagnostic = .Val(error.diagnostic()) }
            plan: WorkspacePlan? := .None
            if diagnostic.is_none() {
                plan = jet_env_model.WorkspaceFile.evaluate_checked_source(source, resolver).map((value) -> .Val(value)) catch d { diagnostic = .Val(d); .None }
            }
            if plan.is_some() {
                resolver.revalidate_source(source) catch error { plan = .None; diagnostic = .Val(error.diagnostic()) }
            }
            if source.role == .Authority -> return .Val(WorkspaceBoundary { root: dir, member_root: .None, malformed: diagnostic.is_some(), diagnostic: diagnostic })
            if plan.is_none() -> return .Val(WorkspaceBoundary { root: dir, member_root: .None, malformed: true, diagnostic: diagnostic })
            member_root := matching_member_root(resolver, start, plan.unwrap()) catch d {
                return .Val(WorkspaceBoundary { root: dir, member_root: .None, malformed: true, diagnostic: .Val(d) })
            }
            return .Val(WorkspaceBoundary { root: dir, member_root: member_root, malformed: false, diagnostic: .None })
        }
        if dir.parent() == .Val(parent) -> dir = parent.to_path_buf() else return .None
    }
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:331
fn matching_member_root(resolver: &AuthorityResolver, entry_dir: &OSPath, plan: &WorkspacePlan) -> OSPath? Err! Diagnostic {
    entry_resolver := AuthorityResolver.open(entry_dir) catch error { throw error.diagnostic() }
    entry_path := entry_resolver.root().to_path_buf()
    matches := []
    for member in plan.members {
        matches.push(resolver.checked_directory(OSPath.new(member.path)) catch error { throw error.diagnostic() })
    }
    for member in matches -> resolver.revalidate_directory(member) catch error { throw error.diagnostic() }
    matches.sort_by_key((member) -> member.path.components().count())
    result := matches.into_iter().filter((member) -> entry_path.starts_with(member.path)).map((member) -> member.path).last()
    resolver.revalidate_root() catch error { throw error.diagnostic() }
    result
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:364
fn path_is_within(path: &OSPath, root: &OSPath) -> Bool { comparable_path(path).zip(comparable_path(root)).is_some_and((pair) -> pair.0.starts_with(pair.1)) }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:370
fn same_path(left: &OSPath, right: &OSPath) -> Bool { comparable_path(left).zip(comparable_path(right)).is_some_and((pair) -> pair.0 == pair.1) }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:376
fn comparable_path(path: &OSPath) -> OSPath? { fs.canonicalize(path).ok().or_else(() -> AuthorityResolver.open(path).ok().map((resolver) -> resolver.root().to_path_buf())) }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:387
fn collect_project_files(project_root: &OSPath, entry_path: &OSPath, manifest_root: OSPath?, ecosystem_root: OSPath?, workspace_root: OSPath?) -> ([ProjectFileRec], Diagnostic?) {
    paths: [OSPath] := []; authority_diagnostic: Diagnostic? := .None
    workspace_source_failed := false; workspace_member_roots: [OSPath] := []
    resolver := AuthorityResolver.open(project_root).map((value) -> .Val(value)) catch error { authority_diagnostic = .Val(error.diagnostic()); .None }
    workspace_source: (AuthorityResolver, WorkspaceSource)? := .None
    if workspace_root == .Val(root) {
        workspace_source = workspace_source_path(root) catch diagnostic { authority_diagnostic = .Val(diagnostic); workspace_source_failed = true; .None }
    }
    push_existing(&paths, entry_path); push_existing(&paths, project_root.join(Syntax.ENV_FILE))
    if manifest_root == .Val(root) -> push_existing(&paths, root.join(Syntax.PACKAGE_FILE))
    if ecosystem_root == .Val(root) -> push_existing(&paths, root.join(Syntax.PACKAGE_FILE))
    if workspace_root == .Val(root) {
        if workspace_source == .Val(pair) -> push_existing(&paths, pair.1.path)
        push_existing(&paths, root.join(Syntax.UNIFIED_LOCK_FILE))
        if workspace_source == .Val((source_resolver, source)) {
            if source.role == .Index {
                snapshot := workspace_snapshot_for_source(source_resolver, source).map((value) -> .Val(value)) catch diagnostic { authority_diagnostic = .Val(diagnostic); .None }
                if snapshot == .Val(snapshot) {
                    for member in snapshot.plan.members {
                        member_dir := root.join(member.path); workspace_member_roots.push(member_dir.clone())
                        push_existing(&paths, member_dir.join(Syntax.PACKAGE_FILE))
                    }
                }
            }
        }
    }
    if resolver == .Val(resolver) {
        source_files := resolver.discover_source_files().map((value) -> .Val(value)) catch error { authority_diagnostic.get_or_insert_with(() -> error.diagnostic()); .None }
        if source_files == .Val(source_files) {
            paths.extend(source_files.into_iter().filter_map((file) -> {
                is_fallback_workspace := workspace_source_failed && workspace_root.is_some_and((root) -> file.path == root.join(Syntax.WORKSPACE_FILE))
                is_declared_workspace_source := workspace_root.is_none() || workspace_member_roots.iter().any((member_root) -> path_is_within(file.path, member_root))
                if is_declared_workspace_source && !is_fallback_workspace -> .Val(file.path) else .None
            }))
        }
    }
    authority_root := resolver.as_ref().map((resolver) -> resolver.root()).unwrap_or(project_root)
    paths.sort(); paths.dedup(); files: [ProjectFileRec] := []
    for path in paths {
        if resolver.is_none() -> break
        resolver := resolver.as_ref().unwrap()
        relative := path.strip_prefix(authority_root) catch _ { authority_diagnostic.get_or_insert_with(() -> AuthorityError.Escapes(path.clone()).diagnostic()); continue }
        checked := resolver.checked_file(relative) catch error { authority_diagnostic.get_or_insert_with(() -> error.diagnostic()); continue }
        resolver.revalidate_file(checked) catch error { authority_diagnostic.get_or_insert_with(() -> error.diagnostic()); continue }
        kind := if path.file_name().and_then((n) -> n.to_str()) == .Val(Syntax.PACKAGE_FILE) -> "package"
            else if workspace_source.as_ref().is_some_and((pair) -> path == pair.1.path) -> "workspace"
            else if path.file_name().and_then((n) -> n.to_str()) == .Val(Syntax.ENV_FILE) -> "env"
            else if rel_path(authority_root, path) == Syntax.UNIFIED_LOCK_FILE -> "lock" else "source"
        resolver.revalidate_file(checked) catch error { authority_diagnostic.get_or_insert_with(() -> error.diagnostic()); continue }
        files.push(ProjectFileRec { path: rel_path(authority_root, path), revision: "sha256-{SHA256.sha256_hex(checked.bytes)}", kind: kind.to_string() })
    }
    (files, authority_diagnostic)
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:532
fn workspace_source_path(root: &OSPath) -> (AuthorityResolver, WorkspaceSource)? Err! Diagnostic {
    resolver := AuthorityResolver.open(root) catch error { throw error.diagnostic() }
    source := resolver.resolve_workspace_source() catch error { throw error.workspace_diagnostic() }
    source.map((source) -> (resolver, source))
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:551
fn workspace_snapshot_for_source(resolver: &AuthorityResolver, source: &WorkspaceSource) -> WorkspaceSnapshot Err! Diagnostic { jet_env_model.WorkspaceFile.load_checked_source(resolver, source.clone()) }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:558
fn push_existing(paths: &[OSPath], path: &OSPath) -> Unit {
    metadata := fs.symlink_metadata(path) catch error {
        if error.kind() != std.io.ErrorKind.NotFound -> paths.push(path.to_path_buf()) // GATE #4409: NotFound only.
        return
    }
    if metadata.is_file() && !is_single_link_file(metadata) -> return
    paths.push(path.to_path_buf())
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:567
fn is_single_link_file(metadata: &fs.Metadata) -> Bool {
    if !metadata.is_file() -> return false
    // GATE #4483 selected-target dispatch; #4494 native link count.
    if core.sys.target.selected_family() == "unix" -> return metadata.nlink() == 1
    if core.sys.target.selected_os() == "windows" -> return metadata.number_of_links() == 1
    false
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:588
pub fn project_revision_from_files(files: &[ProjectFileRec]) -> String {
    acc := String.new()
    for file in files { acc.push_str(file.path); acc.push('\n'); acc.push_str(file.revision); acc.push('\n'); acc.push_str(file.kind); acc.push('\n') }
    source_revision(acc)
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:601
pub fn workspace_project_json(project_root: &OSPath, workspace_root: OSPath?) -> String {
    if workspace_root.is_none() -> return "null"
    root := workspace_root.unwrap()
    source := workspace_source_path(root) catch diagnostic {
        source_path := root.join(Syntax.WORKSPACE_FILE).symlink_metadata().ok().map((_) -> rel_path(project_root, root.join(Syntax.WORKSPACE_FILE))).unwrap_or_default()
        return "{{\"path\":{json_str(source_path)},\"members\":[],\"diagnostics\":[{diagnostic_json(diagnostic)}]}}"
    }
    source_path := source.as_ref().map((pair) -> rel_path(project_root, pair.1.path)).unwrap_or_default()
    members := ""
    if source == .Val((resolver, source)) {
        if source.role == .Index {
            snapshot := workspace_snapshot_for_source(resolver, source) catch diagnostic {
                return "{{\"path\":{json_str(source_path)},\"members\":[],\"diagnostics\":[{diagnostic_json(diagnostic)}]}}"
            }
            members = snapshot.plan.members.iter().map((m) -> "{{\"name\":{json_str(m.name)},\"path\":{json_str(m.path)}}}").collect().join(",")
        }
    }
    "{{\"path\":{json_str(source_path)},\"members\":[{members}],\"diagnostics\":[]}}"
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:661
pub fn packages_project_json(project_root: &OSPath, entry_path: &OSPath, manifest_root: OSPath?, ecosystem_root: OSPath?, workspace_root: OSPath?) -> String {
    dirs := package_dirs(manifest_root, ecosystem_root, workspace_root) catch diagnostic {
        if workspace_root.is_some() -> package_dirs_without_workspace(manifest_root, ecosystem_root) else return projection_diagnostic_json(diagnostic)
    }
    if dirs.is_empty() { if inline_entry_dir(entry_path) == .Val(dir) -> dirs.push(dir) }
    dirs.sort(); dirs.dedup()
    dirs.iter().filter_map((dir) -> package_project_json(project_root, entry_path, dir)).collect().join(",")
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:691
fn package_dirs(manifest_root: OSPath?, ecosystem_root: OSPath?, workspace_root: OSPath?) -> [OSPath] Err! Diagnostic {
    dirs := package_dirs_without_workspace(manifest_root, ecosystem_root)
    if workspace_root == .Val(root) {
        if workspace_source_path(root)? == .Val((resolver, source)) {
            if source.role == .Index {
                snapshot := workspace_snapshot_for_source(resolver, source)?
                for member in snapshot.plan.members -> dirs.push(root.join(member.path))
            }
        }
    }
    dirs.sort(); dirs.dedup(); dirs
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:712
fn package_dirs_without_workspace(manifest_root: OSPath?, ecosystem_root: OSPath?) -> [OSPath] {
    dirs: [OSPath] := []
    if manifest_root == .Val(root) -> dirs.push(root.to_path_buf())
    if ecosystem_root == .Val(root) -> dirs.push(root.to_path_buf())
    dirs.sort(); dirs.dedup(); dirs
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:728
pub fn targets_project_json(project_root: &OSPath, entry_path: &OSPath, manifest_root: OSPath?, ecosystem_root: OSPath?, workspace_root: OSPath?) -> String {
    dirs := package_dirs(manifest_root, ecosystem_root, workspace_root) catch diagnostic {
        if workspace_root.is_some() -> package_dirs_without_workspace(manifest_root, ecosystem_root) else return projection_diagnostic_json(diagnostic)
    }
    if dirs.is_empty() { if inline_entry_dir(entry_path) == .Val(dir) -> dirs.push(dir) }
    dirs.sort(); dirs.dedup()
    dirs.iter().filter_map((dir) -> package_targets_project_json(project_root, entry_path, dir)).flatten().collect().join(",")
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:756
fn package_targets_project_json(project_root: &OSPath, entry_path: &OSPath, dir: &OSPath) -> [String]? { canonical_package_targets_project_json(project_root, entry_path, dir) }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:764
fn package_project_json(project_root: &OSPath, entry_path: &OSPath, dir: &OSPath) -> String? { canonical_package_project_json(project_root, entry_path, dir) }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:767
fn inline_entry_dir(entry_path: &OSPath) -> OSPath? {
    source := fs.read_to_string(entry_path).ok()?
    package := Package.extract_inline_package(source) catch _ { return entry_path.parent().map((path) -> path.to_path_buf()) }
    if package.is_none() -> .None else entry_path.parent().map((path) -> path.to_path_buf())
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:775
fn canonical_package_facts(dir: &OSPath, entry_path: &OSPath) -> Package.PackageFacts Err! {
    if entry_path.parent().is_some_and((parent) -> path_is_within(entry_path, dir) || same_path(parent, dir)) {
        if jet_semindex.package_facts_for_entry(entry_path)? == .Val(facts) -> return facts
    }
    facts := Package.PackageFacts.load_checked(dir) catch error { throw error.to_string() }
    facts.unwrap_or_else(() -> { throw "canonical Package `{dir.join(Syntax.PACKAGE_FILE).display()}` is missing" })
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:799
fn projection_diagnostic_json(diagnostic: &Diagnostic) -> String { "{{\"diagnostics\":[{diagnostic_json(diagnostic)}]}}" }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:803
fn canonical_package_error(project_root: &OSPath, entry_path: &OSPath, dir: &OSPath, error: String) -> String {
    diagnostic := jet_semindex.package_facts_diagnostic(entry_path, error)
    name := dir.file_name().and_then((name) -> name.to_str()).unwrap_or("package")
    "{{\"path\":{json_str(rel_path(project_root, dir))},\"manifest\":{json_str(rel_path(project_root, dir.join(Syntax.PACKAGE_FILE)))},\"name\":{json_str(name)},\"version\":\"\",\"target\":\"native\",\"deps\":[],\"targets\":[],\"outputs\":[],\"environments\":[],\"effects_enabled\":false,\"diagnostics\":[{diagnostic_json(diagnostic)}]}}"
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:819
fn output_kind_label(kind: &Package.PackageOutputKind) -> String {
    match kind { .Library -> "library"; .Executable -> "executable"; .Service -> "service"; .Check -> "check"; .Environment -> "environment"; .Image -> "image"; .Bundle -> "bundle"; .System -> "system"; .Fleet -> "fleet" }
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:834
fn output_payload_json(payload: &Package.OutputPayload) -> String {
    match payload {
        .Null -> "null"
        .Bool(value) -> value.to_string()
        .Number(value) -> value.clone()
        .String(value) -> json_str(value)
        .Array(values) -> "[{values.iter().map((value) -> output_payload_json(value)).collect().join(",")}]"
        .Object(values) -> {
            keys := values.keys().collect(); keys.sort()
            fields := keys.iter().map((name) -> "{json_str(name)}:{output_payload_json(values[name])}").collect().join(",")
            "{{{fields}}}"
        }
    }
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:860
fn field_provenance_json(facts: &Package.PackageFacts, field: String) -> String { "[{facts.field_provenance(field).iter().map((origin) -> json_str(origin)).collect().join(",")}]" }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:872
fn canonical_outputs_json(facts: &Package.PackageFacts) -> String {
    keys := facts.outputs.keys().collect(); keys.sort()
    keys.iter().map((name) -> {
        output := facts.outputs[name]
        "{{\"name\":{json_str(output.name)},\"kind\":{json_str(output_kind_label(output.kind))},\"entry\":{json_optional_str(output.entry)},\"payload\":{output_payload_json(output.payload)},\"provenance\":{field_provenance_json(facts, "outputs.{name}")}}}"
    }).collect().join(",")
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:890
fn canonical_environments_json(facts: &Package.PackageFacts) -> String {
    keys := facts.environments.keys().collect(); keys.sort()
    keys.iter().map((key) -> {
        environment := facts.environments[key]
        service_keys := environment.services.keys().collect(); service_keys.sort()
        services := service_keys.iter().map((name) -> {
            service := environment.services[name]
            ports := service.ports.iter().map((port) -> port.to_string()).collect().join(",")
            "{{\"name\":{json_str(name)},\"enable\":{service.enable},\"ports\":[{ports}],\"ready\":{json_optional_str(service.ready)}}}"
        }).collect().join(",")
        tools := environment.tools.iter().map((tool) -> json_str(tool)).collect().join(",")
        secret_keys := environment.secrets.keys().collect(); secret_keys.sort()
        secrets := secret_keys.iter().map((name) -> json_str(name)).collect().join(",")
        "{{\"name\":{json_str(environment.name)},\"tools\":[{tools}],\"services\":[{services}],\"secrets\":[{secrets}]}}"
    }).collect().join(",")
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:936
fn canonical_package_targets_project_json(project_root: &OSPath, entry_path: &OSPath, dir: &OSPath) -> [String]? {
    facts := canonical_package_facts(dir, entry_path) catch error { return .Val([canonical_package_error(project_root, entry_path, dir, error)]) }
    package_path := rel_path(project_root, dir); manifest_rel := rel_path(project_root, dir.join(Syntax.PACKAGE_FILE))
    keys := facts.outputs.keys().collect(); keys.sort()
    targets := keys.iter().map((name) -> {
        output := facts.outputs[name]
        "{{\"package\":{json_str(facts.name)},\"package_path\":{json_str(package_path)},\"manifest\":{json_str(manifest_rel)},\"target\":{json_str(output.name)},\"kind\":{json_str(output_kind_label(output.kind))},\"entry\":{json_optional_str(output.entry)},\"payload\":{output_payload_json(output.payload)},\"provenance\":{field_provenance_json(facts, "outputs.{name}")}}}"
    }).collect()
    for package in facts.packages {
        for target in package.targets {
            kind := legacy_target_label(target)
            targets.push("{{\"package\":{json_str(facts.name)},\"package_path\":{json_str(package_path)},\"manifest\":{json_str(manifest_rel)},\"target\":{json_str(kind)},\"kind\":{json_str(kind)},\"entry\":null,\"payload\":null,\"provenance\":null}}")
        }
    }
    .Val(targets)
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:987
fn legacy_target_label(target: &Package.Target) -> String { match target { .Library -> "library"; .Executable -> "executable"; .Test -> "test"; .Example -> "example"; .Plugin { .. } -> "plugin" } }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:998
fn canonical_package_project_json(project_root: &OSPath, entry_path: &OSPath, dir: &OSPath) -> String? {
    facts := canonical_package_facts(dir, entry_path) catch error { return .Val(canonical_package_error(project_root, entry_path, dir, error)) }
    diagnostics := "[]"
    policy := jet_semindex.workspace_overlay_policy_for_entry(dir.join(Syntax.PACKAGE_FILE)) catch diagnostic { diagnostics = "[{diagnostic_json(diagnostic)}]"; .None }
    workspace_overlays := policy.map((policy) -> jet_semindex.workspace_overlay_policy_json(policy)).unwrap_or_else(() -> "null")
    dep_keys := facts.deps.keys().collect(); dep_keys.sort()
    deps := dep_keys.iter().map((name) -> "{{\"name\":{json_str(name)},\"source\":{json_str(Package.dep_display_redacted(facts.deps[name]))}}}").collect().join(",")
    target_profiles := facts.targets.iter().map((selection) -> "{{\"name\":{json_str(selection.name)},\"profile\":{json_str(selection.profile.as_str())}}}").collect().join(",")
    output_keys := facts.outputs.keys().collect(); output_keys.sort()
    package_targets := output_keys.iter().map((key) -> facts.outputs[key].name.clone()).collect()
    for package in facts.packages -> if !package_targets.iter().any((name) -> name == package.name) -> package_targets.push(package.name.clone())
    package_targets_json := package_targets.iter().map((name) -> json_str(name)).collect().join(",")
    configs := facts.configs.iter().map((name) -> json_str(name)).collect().join(",")
    members := facts.members.iter().map((member) -> json_str(match member { .Path(path) -> path; .Find(path) -> path })).collect().join(",")
    .Val("{{\"path\":{json_str(rel_path(project_root, dir))},\"manifest\":{json_str(rel_path(project_root, dir.join(Syntax.PACKAGE_FILE)))},\"name\":{json_str(facts.name)},\"version\":{json_optional_str(facts.version)},\"targets\":[{target_profiles}],\"package_targets\":[{package_targets_json}],\"deps\":[{deps}],\"outputs\":[{canonical_outputs_json(facts)}],\"environments\":[{canonical_environments_json(facts)}],\"configs\":[{configs}],\"members\":[{members}],\"package_facts\":{jet_semindex.package_facts_json(facts)},\"workspace_overlays\":{workspace_overlays},\"effects_enabled\":false,\"diagnostics\":{diagnostics}}}")
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:1096
pub struct EnvProjectJson { pub envs: String; pub services: String; pub diagnostics: String }
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:1102
pub fn env_project_json(project_root: &OSPath) -> EnvProjectJson {
    resolver := AuthorityResolver.open(project_root) catch error {
        return EnvProjectJson { envs: "", services: "", diagnostics: if error.is_missing() -> "" else diagnostic_json(error.diagnostic()) }
    }
    checked := resolver.checked_file(OSPath.new(Syntax.ENV_FILE)) catch error {
        return EnvProjectJson { envs: "", services: "", diagnostics: if error.is_missing() -> "" else diagnostic_json(error.diagnostic()) }
    }
    src := checked.text() catch error { return EnvProjectJson { envs: "", services: "", diagnostics: diagnostic_json(error.diagnostic()) } }
    resolver.revalidate_file(checked) catch error { return EnvProjectJson { envs: "", services: "", diagnostics: diagnostic_json(error.diagnostic()) } }
    plan := jet_env_model.ModuleEval.evaluate_env(src, project_root) catch d { return EnvProjectJson { envs: "", services: "", diagnostics: diagnostic_json(d) } }
    resolver.revalidate_file(checked) catch error { return EnvProjectJson { envs: "", services: "", diagnostics: diagnostic_json(error.diagnostic()) } }
    packages := plan.package_refs.iter().map((p) -> json_str(p)).collect().join(",")
    secrets := plan.secrets.iter().map((s) -> json_str(s.name)).collect().join(",")
    services := plan.dev_services.iter().map((service) -> dev_service_project_json(service)).collect().join(",")
    environments := plan.environment_names.iter().map((name) -> json_str(name)).collect().join(",")
    sources := plan.source_files.iter().map((path) -> json_str(path)).collect().join(",")
    presets := plan.presets.iter().map((preset) -> json_str(preset.name)).collect().join(",")
    languages := plan.languages.iter().map((language) -> json_str(language.name)).collect().join(",")
    reload := match plan.lifecycle.reload { .Never -> "never"; .Prompt -> "prompt"; .Watch { .. } -> "watch" }
    prompt := plan.prompt.unwrap_or(Syntax.JETPACK_PROMPT_LABEL)
    EnvProjectJson { envs: "{{\"path\":{json_str(Syntax.ENV_FILE)},\"prompt\":{json_str(prompt)},\"environments\":[{environments}],\"sources\":[{sources}],\"presets\":[{presets}],\"languages\":[{languages}],\"reload\":{json_str(reload)},\"packages\":[{packages}],\"secrets\":[{secrets}],\"diagnostics\":[]}}", services: services, diagnostics: "" }
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:1238
fn dev_service_project_json(service: &jet_env_model.ModuleEval.DevServicePlan) -> String {
    ports := service.ports.iter().map((port) -> port.to_string()).collect().join(",")
    extra_keys := service.extra.keys().collect(); extra_keys.sort()
    extra := extra_keys.iter().map((key) -> "{{\"key\":{json_str(key)},\"value\":{json_str(service.extra[key])}}}").collect().join(",")
    run := service.run.as_ref().map((args) -> "[{args.iter().map((arg) -> json_str(arg)).collect().join(",")}]").unwrap_or_else(() -> "null")
    shutdown := service.shutdown.as_ref().map((policy) -> match policy { .Kill -> "Kill"; .Term { .. } -> "Term" })
    after := "[{service.after.iter().map((name) -> json_str(name)).collect().join(",")}]"
    before_start := "[{service.before_start.iter().map((name) -> json_str(name)).collect().join(",")}]"
    "{{\"name\":{json_str(service.name)},\"enable\":{service.enable},\"ports\":[{ports}],\"run\":{run},\"shutdown\":{shutdown.map((value) -> json_str(value)).unwrap_or_else(() -> "null")},\"data_dir\":{json_optional_str(service.data_dir)},\"ready\":{json_optional_str(service.ready)},\"after\":{after},\"before_start\":{before_start},\"extra\":[{extra}],\"source\":{json_str(Syntax.ENV_FILE)}}}"
}
// Rust: crates/jet-devserver/src/Canvas/project_scan.rs:1308
pub fn lock_project_json(project_root: &OSPath) -> String {
    resolver := AuthorityResolver.open(project_root) catch _ { return "" }
    lock := resolver.checked_file(OSPath.new(Syntax.UNIFIED_LOCK_FILE)) catch _ { return "" }
    revision := "sha256-{SHA256.sha256_hex(lock.bytes)}"
    resolver.revalidate_file(lock) catch _ { return "" }
    "{{\"path\":{json_str(rel_path(project_root, lock.path))},\"revision\":{json_str(revision)},\"kind\":\"unified\"}}"
}
