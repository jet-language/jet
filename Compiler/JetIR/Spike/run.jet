// The spike's process entry: `jet ir ...` runs the slot IR route
// (Source/Spike.jet), every other command the production CLI
// (Compiler/JetCli/run.jet).
use core.process as process
use jet_cli.[jet_cli_main]

fn run() {
    args :: process.args()
    if args.len() > 0 && args[0] == "ir" -> process.exit(ir_spike_main(args))
    process.exit(jet_cli_main(args))
}
