// `jet ir build` / `jet ir run`: the executable of a file through the slot
// IR at O0, onto the existing object writer, runtime pack and static linker
// (Host.jet `jet_cli_native_back` links the same inputs in the same order).
// Traced as `ir.build`, `ir.x64`, `ir.object`, `ir.link`.
use core.files as cli_files
use jet_foundation.[CompilerThreads]
use jet_driver.[JetDriverVerbOutput, JET_DRIVER_EXIT_OK]
use jet_backend.[x64_link_executable]
use jet_cli.[JET_CLI_RUNTIME_KEY_FILE, JET_CLI_RUNTIME_PACK_FILE, JetCLITraceSink, jet_cli_authority_report, jet_cli_build_failed, jet_cli_exec, jet_cli_runtime_dir, jet_cli_runtime_key, jet_cli_stem, jet_cli_why]
use jet_ir.[IRBuildFailure, IRFunction, IROp, ir_x64_compile_module, ir_x64_object]

// The executable `executable` of `file`, or the report that stopped it.
// Every IR build failure, then every selection failure, is listed (exit 2).
fn ir_spike_native(file: String, executable: String, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    if ir_spike_front(file, trace_sink) == {
        .Stopped(output) -> { return output }
        .Ready(input) -> {
            if jet_cli_authority_report(file, input.source, false, "build", input.authority) == .Val(refusal) -> return refusal
            threads :: input.threads.copy()
            return ir_spike_native_input(file, ^input, threads, executable, trace_sink)
        }
    }
}

fn ir_spike_native_input(file: String, input: ^IRSpikeInput, threads: CompilerThreads, executable: String, trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    built := ir_spike_build_ir(^input, false, trace_sink)
    // Collect-all: a function the builder failed becomes one Unreachable, so
    // selection still runs over the whole module and reports its own rows.
    rows := [String]{}
    loop failure in built.failures {
        &rows.push("ir.build {failure.name} [{failure.key}]: {ir_spike_field(failure.message)} at {failure.source_file}:{failure.span.start}..{failure.span.end}")
        if built.program.function_rows.get(failure.key) == .Val(id) -> ir_spike_unreachable(&built.program.functions[id])
    }
    if trace_sink == .Val(sink) -> sink.begin("ir.x64", "", -1, -1)
    compiled :: ir_x64_compile_module(built.program, threads)
    if trace_sink == .Val(sink) -> sink.end("ir.x64", compiled.functions.len())
    loop error in compiled.errors -> &rows.push("ir.x64 {ir_spike_field(error)}")
    if rows.len() > 0 -> return ir_spike_route_failed(file, rows)
    if trace_sink == .Val(sink) -> sink.begin("ir.object", "", -1, -1)
    object := ir_x64_object(built.program, compiled, built.program.entry)
    if trace_sink == .Val(sink) -> sink.end("ir.object", compiled.functions.len())
    if object.errors.len() > 0 {
        object_rows :: loop error in object.errors -> "ir.object {ir_spike_field(error)}"
        return ir_spike_route_failed(file, object_rows)
    }
    object_path :: "{executable}.o"
    cli_files.write_bytes(object_path, object.bytes) ?? return jet_cli_build_failed("couldn't write {object_path}: {err}", jet_cli_why("E2105"), "check that the build directory is writable", false)
    runtime_dir :: jet_cli_runtime_dir()
    key :: jet_cli_runtime_key(runtime_dir) ?? return jet_cli_build_failed("couldn't read the Jet runtime key {runtime_dir}/{JET_CLI_RUNTIME_KEY_FILE}", jet_cli_why("E2105"), "package the runtime beside jet with `Tools/packaging/prebuild-runtime.sh <jet>`, which writes the key and the runtime pack", false)
    runtime_path :: "{runtime_dir}/{key}/{JET_CLI_RUNTIME_PACK_FILE}"
    runtime :: cli_files.read_bytes(runtime_path) ?? return jet_cli_build_failed("couldn't read the Jet runtime {runtime_path}: {err}", jet_cli_why("E2105"), "package the runtime beside jet with `Tools/packaging/prebuild-runtime.sh <jet>`, which writes the runtime pack and object", false)
    names := [String]{object_path, runtime_path}
    bytes := [[U8]]{^object.bytes, ^runtime}
    if trace_sink == .Val(sink) -> sink.begin("ir.link", "", -1, -1)
    image :: x64_link_executable(names, ^bytes)
    if trace_sink == .Val(sink) -> sink.end("ir.link", names.len())
    if image.errors.len() > 0 {
        link_rows :: loop error in image.errors -> "ir.link {ir_spike_field(error)}"
        return ir_spike_route_failed(file, link_rows)
    }
    cli_files.write_bytes(executable, image.bytes) ?? return jet_cli_build_failed("couldn't write {executable}: {err}", jet_cli_why("E2105"), "check that the build directory is writable", false)
    cli_files.set_mode(executable, 0o755) ?? return jet_cli_build_failed("couldn't make {executable} executable: {err}", jet_cli_why("E2105"), "check that the build directory is writable", false)
    JetDriverVerbOutput{stdout: "", stderr: "", exit_code: JET_DRIVER_EXIT_OK}
}

// The body of a function the builder failed: one Unreachable (its slots and
// parameters stay, so its callers' calls still select).
fn ir_spike_unreachable(function: &IRFunction) Never! {
    function.op = [IROp]{IROp.Unreachable}
    function.dst = [Int]{-1}
    function.a = [Int]{-1}
    function.b = [Int]{-1}
    function.c = [Int]{-1}
    function.code_line = [Int]{0}
    function.args = [Int]{}
    function.open = [Int]{}
}

// Exit 2 with every failure row of the route, one per line.
fn ir_spike_route_failed(file: String, rows: [String]) -> JetDriverVerbOutput Never! {
    listed := ""
    loop row in rows -> listed = "{listed}  {row}\n"
    JetDriverVerbOutput{stdout: "", stderr: "error: the slot IR route can't build `{file}` ({rows.len()} failures):\n{listed}", exit_code: IR_SPIKE_EXIT_FAILURES}
}

// `jet ir run FILE [ARGS...]`: build `<root>/.jet/build/<stem>.ir`, then
// run it on this process's streams with `program_args`, as `jet run` does.
fn ir_spike_run(file: String, program_args: [String], trace_sink: JetCLITraceSink?) -> JetDriverVerbOutput {
    if ir_spike_front(file, trace_sink) == {
        .Stopped(output) -> { return output }
        .Ready(input) -> {
            if jet_cli_authority_report(file, input.source, false, "run", input.authority) == .Val(refusal) -> return refusal
            threads :: input.threads.copy()
            build_dir :: "{input.root}/.jet/build"
            cli_files.create_dir_all(build_dir) ?? return jet_cli_build_failed("couldn't create the build directory {build_dir}: {err}", jet_cli_why("E2105"), "check that the project directory is writable", false)
            binary :: "{build_dir}/{jet_cli_stem(file)}.ir"
            built :: ir_spike_native_input(file, ^input, threads, binary, trace_sink)
            if built.exit_code != JET_DRIVER_EXIT_OK -> return built
            return jet_cli_exec(binary, program_args, false)
        }
    }
}
