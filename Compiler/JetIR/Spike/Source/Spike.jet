// `jet ir`: the slot IR route beside the ordinary compiler until the cutover.
// It compiles a file exactly as `jet build` does up to MIR lowering
// (Pipeline `jet_driver_lowering_inputs`), then builds the IR from the
// checked functions lowering would read.
//   jet ir census [--all] FILE...   one TSV row per IR build failure, then a
//                                   histogram of the failure messages
//   jet ir dump FILE                the IR text of every built function
//   jet ir build FILE -o EXE        the executable through the IR (O0)
//   jet ir run FILE [ARGS...]       build to .jet/build/<stem>.ir, then run it
// `--trace=FILE` traces any of them (`ir.build`, `ir.x64`, `ir.object`,
// `ir.link` beside the driver's phases).
// Built as its own package (Compiler/JetIR/Spike/package.jet), beside the
// default CLI (Compiler/JetCli), never instead of it.
use core.files as cli_files
use core.term as cli_term
use jet_foundation.[CompilerThreads, SymbolKind, TConstantDef, TFunc, TTypeDef, compiler_transfer_rows, symbol_id]
use jet_driver.[JetDriverCompileMode, JetDriverCompileTarget, JetDriverVerbOutput, JET_DRIVER_EXIT_OK, JET_DRIVER_EXIT_USAGE, JET_DRIVER_EXIT_USER_ERROR, jet_driver_lowering_inputs, jet_driver_present_diagnostics, jet_driver_report_problems]
use jet_cli.[JetCLIAuthority, JetCLIOverlay, JetCLIPrepared, JetCLITraceSink, jet_cli_errors, jet_cli_ice, jet_cli_policy_authority, jet_cli_prepare_overlays, jet_cli_prepared_file_count, jet_cli_source_invocation, jet_cli_trace_boxed, jet_cli_trace_sink, jet_cli_with_invocation]
use jet_ir.[IRBuildFailure, IRBuildResult, ir_build_all, ir_build_program, ir_function_text]

// The exit status of a route whose IR build or selection reported failures.
IR_SPIKE_EXIT_FAILURES :: 2

// What the IR builder reads for one entry file: the checked functions MIR
// lowering would read, every checked module's type declarations (module
// order), and the key of the entry module's `fn run`; with the compile's
// threads, its first source root (where `.jet/build` lives), the entry's
// source and the application authority (Authority.jet) its run requires.
struct IRSpikeInput {
    functions: [TFunc]
    type_defs: [TTypeDef]
    constants: [TConstantDef]
    entry_key: String
    threads: CompilerThreads
    root: String
    source: String
    authority: JetCLIAuthority
}

enum IRSpikeFront {
    Ready(input: IRSpikeInput)
    // The report that stopped the compile (a refusal, errors, an internal problem).
    Stopped(output: JetDriverVerbOutput)
}

// `jet ir ...`: `args` is the process argv without the program name, so
// args[0] is "ir".
fn ir_spike_main(args: [String]) -> Int {
    if args.len() < 2 -> return ir_spike_usage()
    verb :: args[1]
    files := [String]{}
    every_function := false
    trace := String?{None}
    output := String?{None}
    index := 2
    loop index < args.len() {
        argument :: args[index]
        if argument == "--all" {
            every_function = true
        } else if argument.starts_with("--trace=") {
            trace = Val(argument.slice(8..<argument.len()))
        } else if argument == "-o" && index + 1 < args.len() {
            index += 1
            output = Val(args[index])
        } else {
            &files.push(argument)
        }
        index += 1
    }
    trace_sink :: jet_cli_trace_sink(trace)
    if verb == "census" && files.len() > 0 -> return ir_spike_census(files, every_function, trace_sink)
    if verb == "dump" && files.len() == 1 -> return ir_spike_dump(files[0], trace_sink)
    if verb == "build" && files.len() == 1 && output != None {
        built :: ir_spike_native(files[0], output ?? "", trace_sink)
        ir_spike_write(built.stdout, built.stderr)
        return built.exit_code
    }
    if verb == "run" && files.len() > 0 {
        program_args := [String]{}
        loop at in 1..<files.len() -> &program_args.push(files[at])
        ran :: ir_spike_run(files[0], program_args, trace_sink)
        ir_spike_write(ran.stdout, ran.stderr)
        return ran.exit_code
    }
    ir_spike_usage()
}

fn ir_spike_usage() -> Int {
    ir_spike_write("", "usage: jet ir census [--all] [--trace=FILE] FILE...\n       jet ir dump [--trace=FILE] FILE\n       jet ir build [--trace=FILE] FILE -o EXE\n       jet ir run [--trace=FILE] FILE [ARGS...]\n")
    JET_DRIVER_EXIT_USAGE
}

fn ir_spike_write(stdout: String, stderr: String) {
    if stdout.len() > 0 {
        out := cli_term.stdout()
        &out.write(stdout).drop("jet ir stdout")
    }
    if stderr.len() > 0 {
        err_handle := cli_term.stderr()
        &err_handle.write(stderr).drop("jet ir stderr")
    }
}

// The compile of `file` up to MIR lowering, traced through `trace_sink`
// (`sources`, the driver's phases, `lower` = Core pruning only).
fn ir_spike_front(file: String, trace_sink: JetCLITraceSink?) -> IRSpikeFront {
    if trace_sink == .Val(sink) -> sink.begin("sources", "", -1, -1)
    prepared :: jet_cli_prepare_overlays(file, file, [JetCLIOverlay]{}, false, None, JetDriverCompileMode.Program)
    if trace_sink == .Val(sink) -> sink.end("sources", jet_cli_prepared_file_count(prepared))
    if ^prepared == {
        .Refused(output) -> { return IRSpikeFront.Stopped{output: output} }
        .Prepared(request, snapshot) -> {
            selected := request
            selected.target = JetDriverCompileTarget.Native
            selected.trace_sink = jet_cli_trace_boxed(trace_sink)
            // copy: a three-field row; the request moves into the compiler below.
            threads :: selected.compiler_threads.copy()
            root :: if snapshot.roots.len() > 0 -> snapshot.roots[0].canonical_path else -> "."
            front := jet_driver_lowering_inputs(^selected, None)
            if front.compile.internal_problem == .Val(problem) -> return IRSpikeFront.Stopped{output: jet_cli_ice(problem)}
            errors :: jet_driver_present_diagnostics(jet_cli_errors(front.compile.diagnostics), snapshot, front.compile.generated_source_files)
            source :: cli_files.read(file) ?? ""
            if errors.len() > 0 {
                return IRSpikeFront.Stopped{output: JetDriverVerbOutput{stdout: "", stderr: jet_driver_report_problems(file, source, errors, false, true), exit_code: JET_DRIVER_EXIT_USER_ERROR}}
            }
            inputs := ^front.inputs ?? return IRSpikeFront.Stopped{output: jet_cli_ice("the Jet compiler stopped before lowering `{file}`")}
            type_defs := [TTypeDef]{}
            constants := [TConstantDef]{}
            loop index in 0..<inputs.modules.len() {
                compiler_transfer_rows<TTypeDef>(&type_defs, &inputs.modules[index].declarations.type_defs)
                compiler_transfer_rows<TConstantDef>(&constants, &inputs.modules[index].declarations.constants)
            }
            entry_key :: symbol_id(SymbolKind.Function, inputs.entry_module_identity, "", "run").key
            authority := jet_cli_policy_authority(ir_spike_required_effects(inputs.functions, entry_key), front.compile.authority_policy)
            jet_cli_with_invocation(&authority, jet_cli_source_invocation(source, None))
            return IRSpikeFront.Ready{input: IRSpikeInput{functions: ^inputs.functions, type_defs: ^type_defs, constants: ^constants, entry_key: entry_key, threads: threads, root: root, source: source, authority: authority}}
        }
    }
}

// Authority.jet `jet_cli_entry_required_effects` over the checked functions:
// the direct effects of every function the entry reaches along checked call
// edges (the same TIR effect facts MIR lowering copies into its functions).
fn ir_spike_required_effects(functions: [TFunc], entry_key: String) -> [String] Never! {
    by_key := [String:Int]{}
    loop (index, function) in functions {
        if by_key.get(function.key) == None -> by_key[function.key] = index
    }
    pending := [Int]{}
    if by_key.get(entry_key) == .Val(entry) -> &pending.push(entry)
    seen := [Int:Bool]{}
    required := [String]{}
    loop pending.len() > 0 {
        index :: &pending.pop() ?? break
        if seen.get(index) != None -> next
        seen[index] = true
        loop effect_name in functions[index].effects.direct -> &required.push(effect_name)
        loop edge in functions[index].effects.call_edges {
            if by_key.get(edge) == .Val(callee) -> &pending.push(callee)
        }
    }
    required
}

// The IR of `input`: from its entry, or of every checked function
// (`every_function`), traced as `ir.build`.
fn ir_spike_build_ir(input: ^IRSpikeInput, every_function: Bool, trace_sink: JetCLITraceSink?) -> IRBuildResult {
    owned := ^input
    if trace_sink == .Val(sink) -> sink.begin("ir.build", "", -1, -1)
    built :: if every_function -> ir_build_all(^owned.functions, ^owned.type_defs, ^owned.constants) else -> ir_build_program(^owned.functions, ^owned.type_defs, ^owned.constants, owned.entry_key)
    if trace_sink == .Val(sink) -> sink.end("ir.build", built.program.functions.len())
    built
}

// One line of a TSV field: tabs and line breaks become spaces.
fn ir_spike_field(text: String) -> String Never! {
    text.replace("\t", " ").replace("\n", " ")
}

fn ir_spike_failure_row(file: String, failure: IRBuildFailure) -> String Never! {
    "{file}\t{ir_spike_field(failure.key)}\t{ir_spike_field(failure.name)}\t{ir_spike_field(failure.message)}\t{failure.source_file}:{failure.span.start}..{failure.span.end}\n"
}

// `jet ir census`: per file, one row per IR build failure
// (file, function key, name, message, source_file:span), or one `-` row
// naming why the compile stopped; then `#\tcount\tmessage` rows, most
// frequent first. Exit 0 when every file built, else 2.
fn ir_spike_census(files: [String], every_function: Bool, trace_sink: JetCLITraceSink?) -> Int {
    counts := [String:Int]{}
    order := [String]{}
    failed := 0
    loop file in files {
        rows := ""
        if ir_spike_front(file, trace_sink) == {
            .Stopped(output) -> {
                lines :: output.stderr.split("\n").to_list()
                first :: if lines.len() > 0 -> lines[0] else -> ""
                message :: "compile stopped: {ir_spike_field(first)}"
                rows = "{file}\t-\t-\t{message}\t-\n"
                ir_spike_count(&counts, &order, "compile stopped")
                failed += 1
            }
            .Ready(input) -> {
                built :: ir_spike_build_ir(^input, every_function, trace_sink)
                if built.failures.len() > 0 -> failed += 1
                loop failure in built.failures {
                    rows = "{rows}{ir_spike_failure_row(file, failure)}"
                    ir_spike_count(&counts, &order, ir_spike_field(failure.message))
                }
                built_count :: built.program.functions.len() - built.failures.len()
                summary :: if built.failures.len() == 0 -> "ok {built_count} functions" else -> "built {built_count} functions, failed {built.failures.len()}"
                rows = "{rows}{file}\t-\t-\t{summary}\t-\n"
            }
        }
        ir_spike_write(rows, "")
    }
    ranked := order
    // Most frequent first; ties keep first-seen order (insertion sort).
    loop index in 1..<ranked.len() {
        at := index
        loop at > 0 && (counts.get(ranked[at]) ?? 0) > (counts.get(ranked[at - 1]) ?? 0) {
            held :: ranked[at - 1]
            ranked[at - 1] = ranked[at]
            ranked[at] = held
            at -= 1
        }
    }
    histogram := ""
    loop message in ranked -> histogram = "{histogram}#\t{counts.get(message) ?? 0}\t{message}\n"
    ir_spike_write("{histogram}#\tfiles {files.len()}, failed {failed}\n", "")
    if failed > 0 -> IR_SPIKE_EXIT_FAILURES else -> JET_DRIVER_EXIT_OK
}

fn ir_spike_count(counts: &[String:Int], order: &[String], message: String) Never! {
    seen :: counts.get(message) ?? 0
    if seen == 0 -> &order.push(message)
    counts[message] = seen + 1
}

// `jet ir dump FILE`: the text of every function the build reached, then
// its failures. Exit 0 when the build has none, else 2.
fn ir_spike_dump(file: String, trace_sink: JetCLITraceSink?) -> Int {
    if ir_spike_front(file, trace_sink) == {
        .Stopped(output) -> {
            ir_spike_write(output.stdout, output.stderr)
            return output.exit_code
        }
        .Ready(input) -> {
            built :: ir_spike_build_ir(^input, false, trace_sink)
            loop function in built.program.functions -> ir_spike_write("{ir_function_text(built.program, function)}\n\n", "")
            failures := ""
            loop failure in built.failures -> failures = "{failures}{ir_spike_failure_row(file, failure)}"
            ir_spike_write("", failures)
            return if built.failures.len() > 0 -> IR_SPIKE_EXIT_FAILURES else -> JET_DRIVER_EXIT_OK
        }
    }
}
