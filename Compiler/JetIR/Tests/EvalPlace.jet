// Whether a debugger's condition may run in the program (EvalPlace.jet
// ir_eval_place_refusal): it may write only its own stack and the blocks it
// allocates, and may not take a reference, call a function value or run an
// `#FFI(asm)` template, in its own code or in a function it calls.
use jet_ir.[IRAsmLeaf, IRFunction, IRModule, IROp, IRSlotKind, IR_STOP_TRAP_KEY, ir_args, ir_emit, ir_eval_place_refusal, ir_function_new, ir_intern_name, ir_module_new, ir_slot]

place_test_fn: fn(name: String, params: Int, temps: Int) -> IRFunction {
    f := ir_function_new(name, name, name, "probe.jet", 1)
    loop _ in 0..<params -> _ := ir_slot(f, 0, IRSlotKind.Param, -1, 1)
    loop _ in 0..<temps -> _ := ir_slot(f, 0, IRSlotKind.Temp, -1, 1)
    f
}

place_test_call: fn(f: &IRFunction, callee: Int, args: [Int]) {
    start: ir_args(f, args)
    _ := ir_emit(f, IROp.Call, -1, callee, start, args.len(), 1)
}

// A condition (row 0) of one parameter that compares it, then does what
// `body` adds; row 1 is what it calls.
place_test_module: fn(body: &&IRFunction, callee: &&IRFunction) -> IRModule {
    m := ir_module_new()
    m.functions.push(body.move())
    m.functions.push(callee.move())
    m
}

#Test("a condition that reads and writes its own stack runs in the program") {
    f := place_test_fn("condition", 1, 3)
    _ := ir_emit(f, IROp.StackAddress, 1, -1, -1, -1, 1)
    _ := ir_emit(f, IROp.Offset, 2, 1, 8, -1, 1)
    _ := ir_emit(f, IROp.Store, -1, 2, 0, 0, 1)
    _ := ir_emit(f, IROp.Load, 3, 2, 0, -1, 1)
    _ := ir_emit(f, IROp.Return, -1, 3, -1, -1, 1)
    callee := place_test_fn("unused", 0, 0)
    m := place_test_module(f.move(), callee.move())
    assert_eq(ir_eval_place_refusal(m, 0), "")
}

#Test("a write through a parameter's address keeps the condition out of the program") {
    f := place_test_fn("condition", 1, 1)
    _ := ir_emit(f, IROp.Const, 1, 7, -1, -1, 1)
    _ := ir_emit(f, IROp.Store, -1, 0, 0, 1, 1)
    callee := place_test_fn("unused", 0, 0)
    m := place_test_module(f.move(), callee.move())
    assert_eq(ir_eval_place_refusal(m, 0), "it writes memory it did not take on its own stack or allocate")
}

#Test("a slot that once holds another address is not the condition's own") {
    f := place_test_fn("condition", 1, 1)
    _ := ir_emit(f, IROp.StackAddress, 1, -1, -1, -1, 1)
    _ := ir_emit(f, IROp.Copy, 1, 0, -1, -1, 1)
    _ := ir_emit(f, IROp.Store, -1, 1, 0, 0, 1)
    callee := place_test_fn("unused", 0, 0)
    m := place_test_module(f.move(), callee.move())
    assert_eq(ir_eval_place_refusal(m, 0), "it writes memory it did not take on its own stack or allocate")
}

#Test("a function the condition calls is checked as the condition is, and named") {
    f := place_test_fn("condition", 1, 0)
    place_test_call(f, 1, [Int]{0})
    callee := place_test_fn("helper", 1, 0)
    _ := ir_emit(callee, IROp.CallIndirect, -1, 0, -1, 0, 1)
    m := place_test_module(f.move(), callee.move())
    assert_eq(ir_eval_place_refusal(m, 0), "it calls a function value (in `helper`)")
}

#Test("a stop poll the condition calls runs in the program; an `#FFI(asm)` function doesn't") {
    f := place_test_fn("condition", 0, 0)
    place_test_call(f, 1, [Int]{})
    poll := ir_function_new("jet_ir_stop_trap", IR_STOP_TRAP_KEY, "jet_ir_stop_trap", "", 0)
    poll.asm = Val(IRAsmLeaf{code: [U8]{}, regs: [Int]{}, result: 0})
    m := place_test_module(f.move(), poll.move())
    assert_eq(ir_eval_place_refusal(m, 0), "")
    leaf := place_test_fn("raw_store", 0, 0)
    leaf.asm = Val(IRAsmLeaf{code: [U8]{0x90}, regs: [Int]{}, result: 0})
    m.functions[1] = leaf
    assert_eq(ir_eval_place_refusal(m, 0), "it runs the `#FFI(asm)` function `raw_store`")
}

#Test("an inline retain keeps the condition out of the program; another runtime call doesn't") {
    f := place_test_fn("condition", 1, 0)
    callee := place_test_fn("unused", 0, 0)
    m := place_test_module(f.move(), callee.move())
    slow: ir_intern_name(m, "jet_int_mod")
    retain: ir_intern_name(m, "jet_rt_block_retain")
    start: ir_args(m.functions[0], [Int]{0})
    _ := ir_emit(m.functions[0], IROp.CallRuntime, -1, slow, start, 1, 1)
    assert_eq(ir_eval_place_refusal(m, 0), "")
    again: ir_args(m.functions[0], [Int]{0})
    _ := ir_emit(m.functions[0], IROp.CallRuntime, -1, retain, again, 1, 1)
    assert_eq(ir_eval_place_refusal(m, 0), "it takes a reference")
}

#Test("a condition writes a block it allocated and releases it in the program") {
    f := place_test_fn("condition", 1, 3)
    callee := place_test_fn("unused", 0, 0)
    m := place_test_module(f.move(), callee.move())
    alloc: ir_intern_name(m, "jet_rt_alloc_value")
    release: ir_intern_name(m, "jet_rt_block_release")
    sizes: ir_args(m.functions[0], [Int]{0, 0})
    _ := ir_emit(m.functions[0], IROp.CallRuntime, 1, alloc, sizes, 2, 1)
    _ := ir_emit(m.functions[0], IROp.Offset, 2, 1, 8, -1, 1)
    _ := ir_emit(m.functions[0], IROp.Store, -1, 2, 0, 0, 1)
    block: ir_args(m.functions[0], [Int]{1})
    _ := ir_emit(m.functions[0], IROp.CallRuntime, 3, release, block, 1, 1)
    assert_eq(ir_eval_place_refusal(m, 0), "")
    // Another routine's result is not a block the condition allocated.
    other: ir_intern_name(m, "jet_int_mod")
    _ := ir_emit(m.functions[0], IROp.CallRuntime, 3, other, block, 1, 1)
    _ := ir_emit(m.functions[0], IROp.Store, -1, 3, 0, 0, 1)
    assert_eq(ir_eval_place_refusal(m, 0), "it writes memory it did not take on its own stack or allocate")
}
