// Derived ==, compare and ordered operators on payload-free enums (a tag
// compare, BuildExpr ir_tag_method), on a payload enum and on a struct.

Color: enum {
    Red
    Green
    Blue
}

Level: enum {
    Low
    Mid
    High
    Max
}

Shape: enum {
    Dot
    Circle(Int)
    Square(Int)
}

Pair: struct {
    c: Color
    n: Int
}

color_index: fn(c: Color) -> Int {
    if c == {
        .Red -> 0
        .Green -> 1
        .Blue -> 2
    }
}

level_index: fn(l: Level) -> Int {
    if l == {
        .Low -> 0
        .Mid -> 1
        .High -> 2
        .Max -> 3
    }
}

pick: fn(i: Int) -> Color {
    if i %% 3 == {
        0 -> .Red
        1 -> .Green
        else -> .Blue
    }
}

level: fn(i: Int) -> Level {
    if i %% 4 == {
        0 -> .Low
        1 -> .Mid
        2 -> .High
        else -> .Max
    }
}

order: fn(a: Int, b: Int) -> Ordering {
    if a < b -> return Ordering.Less
    if a > b -> return Ordering.Greater
    Ordering.Equal
}

generic_eq: fn<T: Equatable>(a: T, b: T) -> Bool {
    a == b
}

run: fn() {
    bad := 0
    total := 0
    loop i in 0..<9 {
        loop j in 0..<9 {
            a: pick(i)
            b: pick(j)
            ai: color_index(a)
            bi: color_index(b)
            if (a == b) != (ai == bi) -> bad += 1
            if (a != b) != (ai != bi) -> bad += 1
            if (a < b) != (ai < bi) -> bad += 1
            if (a <= b) != (ai <= bi) -> bad += 1
            if (a > b) != (ai > bi) -> bad += 1
            if (a >= b) != (ai >= bi) -> bad += 1
            if a.compare(b) != order(ai, bi) -> bad += 1
            if generic_eq(a, b) != (ai == bi) -> bad += 1
            la: level(i)
            lb: level(j)
            if (la == lb) != (level_index(la) == level_index(lb)) -> bad += 1
            if (la != lb) != (level_index(la) != level_index(lb)) -> bad += 1
            if a.compare(b) == .Less -> total += 1
            pa: Pair{c: a, n: j}
            pb: Pair{c: b, n: i}
            if (pa < pb) != (ai < bi || (ai == bi && j < i)) -> bad += 1
            if (pa == pb) != (ai == bi && i == j) -> bad += 1
        }
    }
    s: Shape.Circle(3)
    t: Shape.Square(1)
    print("{bad} {total} {s < t} {s == t} {Shape.Dot < s} {Color.Blue > Color.Red} {Color.Green.compare(Color.Green):Debug} {Level.Max == Level.Max}")
    colors := [Color]{.Blue, .Red, .Green, .Red, .Blue}
    &colors.sort()
    print("{colors:Debug}")
}
