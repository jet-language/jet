// A List buffer of a power-of-two stride grows through capacities whose
// header and slots fill a power-of-two block: no capacity leaves room for one
// more slot in its block. Any other stride doubles from 4.
use {
    jet_ir.[IR_HEAP_BLOCK_HEADER, ir_list_growth]
}

block_of: fn(bytes: Int) -> Int {
    block := 32
    loop block < bytes -> block = block * 2
    block
}

#Test("list growth fills its block") {
    loop stride in ([Int]{1, 2, 4, 8, 16, 32, 64, 128, 256}) {
        growth: ir_list_growth(stride)
        capacity := growth.first
        assert(capacity >= 4)
        loop _ in 0..<20 {
            used: capacity * stride + IR_HEAP_BLOCK_HEADER
            block: block_of(used)
            assert(used + stride > block)
            capacity = capacity * 2 + growth.step
        }
    }
}

#Test("list growth of other strides doubles from 4") {
    loop stride in ([Int]{0, 3, 12, 24, 40, 72}) {
        growth: ir_list_growth(stride)
        assert(growth.first == 4)
        assert(growth.step == 0)
    }
}
