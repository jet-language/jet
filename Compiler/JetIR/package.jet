// The slot IR between the checked program and machine code: the data model,
// the builder from checked TIR, and x86-64 selection onto the existing encoder
// and object writer. Not a member of the compiler workspace (nor of
// Compiler/Bootstrap/sources.list) until it becomes the default path.
name: "jet_ir"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../JetFoundation,
    jet_backend: ../JetBackend,
    jet_codegen: ../JetCodegen,
    jet_sema: ../JetSema,
}
