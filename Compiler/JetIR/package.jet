// The slot IR between the checked program and machine code: the data model,
// the builder from checked TIR with its Core, Prelude and runtime route
// tables, the IR optimizer, and x86-64 selection onto the JetBackend encoder
// and object writer.
name: "jet_ir"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../JetFoundation,
    jet_backend: ../JetBackend,
    jet_sema: ../JetSema,
}
