// The IR builder's Iter<T>: an owned runtime JetIter handle, distinct from
// the List walk. Adapters hand the handle to the runtime; `next` borrows it,
// so later pulls see the remainder. The runtime kernels own adapter
// semantics; the builder only marshals typed slots through a nine-word
// element descriptor and helper functions built once per type (lazy.clone,
// lazy.drop, lazy.equal, lazy.show, lazy.compare, lazy.callback).

use jet_foundation.[AccessConvention, BodyCallArg, Span, Type, TClosureOp, TLocal, TypeTupleField, name_rows_set, name_rows_value, type_carrier_identity]

// The C export of an Iter route symbol: `jet_iter_take` is
// jet_rt_native_iter_take.
fn ir_lazy_runtime_symbol(symbol: String) -> String Never! {
    bytes :: symbol.bytes()
    tail :: String.from_bytes(bytes.slice(4, bytes.len())) ?? panic("runtime symbol is not UTF-8")
    "jet_rt_native_{runtime_abi_atom(tail)}"
}

// The declaration row a nominal type names.
fn ir_lazy_definition(p: IRProgram, ty: Type) -> Int? Never! {
    name :: ir_nominal_name(ty) ?? return None
    ir_type_def(p, name)
}

// `ty` without its tags and through distinct types and aliases.
fn ir_lazy_storage(p: IRProgram, ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> return ir_lazy_storage(p, inner)
        else -> {}
    }
    if ir_lazy_definition(p, ty) == .Val(row) {
        if p.types[row].kind == {
            .Distinct(base, _) | .Alias(base) -> return ir_lazy_storage(p, base)
            else -> {}
        }
    }
    ty.copy()
}

// The high kind-word bit of an inline Int? Option descriptor (kind 7).
IR_LAZY_INLINE_OPTION :: 4294967296

// The descriptor kind word the runtime dispatches show, equality and ordering
// on. A fixed-width integer carries its bit width in the high 32 bits; 11 is
// a zero-size payload.
fn ir_lazy_kind(m: &IRModule, p: IRProgram, ty: Type) -> Int Never! {
    if ir_type_size(&m, p, ty) == 0 -> return 11
    if ty == {
        .Int -> return 1
        .IntN(signed, bits) -> return (if signed -> 2 else -> 3) + bits * 4294967296
        .Float -> return 4
        .String -> return 5
        .List(_) -> return 6
        .Option(_) -> return 7
        .Result(_, _) -> return 8
        .Bool -> return 9
        .Char -> return 10
        .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> return ir_lazy_kind(&m, p, inner)
        else -> {}
    }
    if ir_lazy_definition(p, ty) == .Val(row) {
        if p.types[row].kind == {
            .Distinct(base, _) | .Alias(base) -> return ir_lazy_kind(&m, p, base)
            else -> {}
        }
    }
    0
}

// Whether the descriptor of `ty` has clone glue: a single-use declaration, an
// Iter or a handle without a clone does not. One `seen` set shared by the
// whole walk visits each type once; a type already seen adds nothing to the
// conjunction.
fn ir_lazy_can_clone(m: &IRModule, p: IRProgram, ty: Type, seen: &[String:Bool]) -> Bool Never! {
    if ir_lazy_definition(p, ty) == .Val(row) {
        if p.types[row].single_use -> return false
        if p.types[row].kind == {
            .Distinct(base, _) | .Alias(base) -> return ir_lazy_can_clone(&m, p, base, &seen)
            else -> {}
        }
    }
    if ty == {
        .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> return ir_lazy_can_clone(&m, p, inner, &seen)
        else -> {}
    }
    if ir_iter_element(ty) != None -> return false
    if ir_value_type(&m, p, ty) == .Val(row) {
        if ir_is_handle(m, row) -> return m.types[row].clone != ""
    }
    key :: type_carrier_identity(ty)
    if seen.get(key) != None -> return true
    seen[key] = true
    storage :: ir_lazy_storage(p, ty)
    if storage == {
        .List(inner) | .Option(inner) -> return ir_lazy_can_clone(&m, p, inner, &seen)
        .Map(key_ty, _, value_ty) -> return ir_lazy_can_clone(&m, p, key_ty, &seen) && ir_lazy_can_clone(&m, p, value_ty, &seen)
        .Result(ok, err) -> return ir_lazy_can_clone(&m, p, ok, &seen) && ir_lazy_can_clone(&m, p, err, &seen)
        .Tuple(fields) -> {
            loop field in fields {
                if !ir_lazy_can_clone(&m, p, field.ty, &seen) -> return false
            }
        }
        else -> {}
    }
    if ir_lazy_definition(p, storage) == .Val(row) {
        if p.types[row].kind == {
            .Struct(fields, _) -> {
                loop field in fields {
                    if !field.computed && !ir_lazy_can_clone(&m, p, field.ty, &seen) -> return false
                }
            }
            .Enum(variants, _) -> {
                loop variant in variants {
                    if variant.payload == {
                        .Single(inner) -> { if !ir_lazy_can_clone(&m, p, inner, &seen) -> return false }
                        .Named(fields) -> {
                            loop field in fields {
                                if !field.computed && !ir_lazy_can_clone(&m, p, field.ty, &seen) -> return false
                            }
                        }
                        .Unit -> {}
                    }
                }
            }
            else -> {}
        }
    }
    true
}

fn ir_lazy_type_can_clone(m: &IRModule, p: IRProgram, ty: Type) -> Bool Never! {
    seen := [String:Bool]{}
    ir_lazy_can_clone(&m, p, ty, &seen)
}

// ---------------------------------------------------------------------------
// Helper functions. Each takes the addresses of native element slots, not the
// values.

// The id of lazy helper `role` for `ty`, built on first use; -1 with `b`
// failed when its body cannot be built.
fn ir_lazy_helper(m: &IRModule, p: IRProgram, b: &IRBuilder, role: String, ty: Type, span: Span) -> Int Never! {
    key :: "lazy.{role}<{type_carrier_identity(ty)}>"
    if name_rows_value(m.function_rows, key) == .Val(known) {
        if known < 0 -> return ir_fail_slot(&b, span, "lazy.{role} of {ir_type_name(ty)}")
        return known
    }
    id :: m.functions.len()
    &m.functions.push(ir_hashed_function("lazy.{role}", key, "jet_ir_lazy_{role}_", "", 0))
    name_rows_set(&m.function_rows, key, id)
    a := ir_builder_new(m.functions[id].copy())
    if role == "clone" {
        ir_lazy_clone_body(&m, p, &a, ty, span)
    } else if role == "drop" {
        ir_lazy_drop_body(&m, p, &a, ty, span)
    } else if role == "retire" {
        ir_lazy_retire_body(&m, p, &a, ty, span)
    } else if role == "equal" {
        ir_lazy_equal_body(&m, p, &a, ty, span)
    } else if role == "show" {
        ir_lazy_show_body(&m, p, &a, ty, IRRender.Show, span)
    } else if role == "debug" {
        ir_lazy_show_body(&m, p, &a, ty, IRRender.Debug, span)
    } else if role == "release" {
        ir_task_release_body(&m, &a)
    } else if role == "line_next" {
        ir_line_next_body(&m, p, &a, ty, span)
    } else if role == "line_release" {
        ir_line_release_body(&m, p, &a, ty, span)
    } else if role == "line_clone" {
        ir_line_clone_body(&m, p, &a, ty, span)
    } else if role == "compare" {
        ir_lazy_compare_body(&m, p, &a, ty, span)
    } else {
        ir_lazy_callback_body(&m, p, &a, ty, role == "callback_write", role == "carried", span)
    }
    failed :: ir_failed(a)
    message :: a.error.copy()
    ir_resolve_deferred(&m, p, &a)
    m.functions[id] = ^a.f
    if failed {
        name_rows_set(&m.function_rows, key, -1)
        return ir_fail_slot(&b, span, message)
    }
    id
}

fn ir_lazy_address(m: &IRModule, b: &IRBuilder, id: Int) -> Int Never! {
    pointer_row :: ir_pointer_row(&m)
    address :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.FunctionAddress, address, id, -1, -1, b.line)
    address
}

// lazy.clone(source, target): a copy of the stored value that owns its own
// storage.
fn ir_lazy_clone_body(m: &IRModule, p: IRProgram, a: &IRBuilder, ty: Type, span: Span) Never! {
    pointer_row :: ir_pointer_row(&m)
    source :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "source"))
    target :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "target"))
    row :: ir_value_type(&m, p, ty) ?? return ir_fail(&a, span, "type {ir_type_name(ty)}")
    value :: ir_load_at(&m, &a, source, 0, row)
    if value >= 0 {
        copied :: ir_copy_value(&m, p, &a, value, span)
        ir_store_at(&m, p, &a, target, 0, copied)
    }
    ir_emit(&a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// lazy.drop(slot): drops the stored value.
fn ir_lazy_drop_body(m: &IRModule, p: IRProgram, a: &IRBuilder, ty: Type, span: Span) Never! {
    pointer_row :: ir_pointer_row(&m)
    source :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "slot"))
    row :: ir_value_type(&m, p, ty) ?? return ir_fail(&a, span, "type {ir_type_name(ty)}")
    value :: ir_load_at(&m, &a, source, 0, row)
    if value >= 0 && ir_has_drop(m, a, value) -> ir_emit(&a.f, IROp.Drop, -1, value, -1, -1, a.line)
    ir_emit(&a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// lazy.retire(slot): closes the stored value, then drops it, as a variable's
// scope end does (Build.jet ir_drop_bindings: ir_close_now, then the drop). The
// owner of a value with no variable of its own (the cell of a Shared, the
// storage of a core.mem allocator) runs it; lazy.drop alone never runs a Close
// method.
fn ir_lazy_retire_body(m: &IRModule, p: IRProgram, a: &IRBuilder, ty: Type, span: Span) Never! {
    pointer_row :: ir_pointer_row(&m)
    source :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "slot"))
    row :: ir_value_type(&m, p, ty) ?? return ir_fail(&a, span, "type {ir_type_name(ty)}")
    value :: ir_load_at(&m, &a, source, 0, row)
    if value >= 0 {
        glue :: ir_close_glue(&m, p, &a, row, false, span)
        if ir_failed(a) -> return
        if glue >= 0 -> ir_close_call(&a, glue, value)
        if ir_has_drop(m, a, value) -> ir_emit(&a.f, IROp.Drop, -1, value, -1, -1, a.line)
    }
    ir_emit(&a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// lazy.equal(left, right) -> Bool.
fn ir_lazy_equal_body(m: &IRModule, p: IRProgram, a: &IRBuilder, ty: Type, span: Span) Never! {
    pointer_row :: ir_pointer_row(&m)
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    a.f.result = bool_row
    left_slot :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "left"))
    right_slot :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "right"))
    row :: ir_value_type(&m, p, ty) ?? return ir_fail(&a, span, "type {ir_type_name(ty)}")
    left :: ir_load_at(&m, &a, left_slot, 0, row)
    right :: ir_load_at(&m, &a, right_slot, 0, row)
    same := -1
    if left < 0 {
        same = ir_int_constant(&m, &a, bool_row, 1)
    } else {
        same = ir_equal(&m, p, &a, left, right, span)
    }
    ir_emit(&a.f, IROp.Return, -1, same, -1, -1, a.line)
}

// lazy.show(slot) -> String: the value rendered for display in an owned
// String; lazy.debug renders it through Debug.
fn ir_lazy_show_body(m: &IRModule, p: IRProgram, a: &IRBuilder, ty: Type, mode: IRRender, span: Span) Never! {
    pointer_row :: ir_pointer_row(&m)
    string_row :: ir_string_row(&m)
    a.f.result = string_row
    slot :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "slot"))
    row :: ir_value_type(&m, p, ty) ?? return ir_fail(&a, span, "type {ir_type_name(ty)}")
    value :: ir_load_at(&m, &a, slot, 0, row)
    text :: ir_render(&m, p, &a, ty, value, mode, span)
    if ir_failed(a) || text < 0 -> return
    fresh :: a.fresh[text]
    owned :: if fresh -> text else -> ir_runtime(&m, &a, "jet_rt_string_clone", [Int]{text}, string_row)
    ir_emit(&a.f, IROp.Return, -1, owned, -1, -1, a.line)
}

// lazy.compare(left, right) -> -1, 0 or 1.
fn ir_lazy_compare_body(m: &IRModule, p: IRProgram, a: &IRBuilder, ty: Type, span: Span) Never! {
    pointer_row :: ir_pointer_row(&m)
    word_row :: ir_word_row(&m)
    a.f.result = word_row
    left_slot :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "left"))
    right_slot :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "right"))
    row :: ir_value_type(&m, p, ty) ?? return ir_fail(&a, span, "type {ir_type_name(ty)}")
    left :: ir_load_at(&m, &a, left_slot, 0, row)
    if left < 0 {
        zero :: ir_word_const(&m, &a, 0)
        ir_emit(&a.f, IROp.Return, -1, zero, -1, -1, a.line)
        return
    }
    kind :: ir_kind_of(m, a, left)
    if kind == .Pointer || kind == .Aggregate || ir_option_inline(m, row) -> return ir_fail(&a, span, "ordering of {ir_type_name(ty)} is not lowered at O0 yet")
    right :: ir_load_at(&m, &a, right_slot, 0, row)
    less := -1
    greater := -1
    if kind == .String {
        order :: ir_runtime(&m, &a, "jet_rt_string_compare", [Int]{left, right}, word_row)
        zero :: ir_word_const(&m, &a, 0)
        less = ir_bool_op(&m, &a, IROp.Lt, order, zero)
        greater = ir_bool_op(&m, &a, IROp.Gt, order, zero)
    } else {
        less = ir_bool_op(&m, &a, IROp.Lt, left, right)
        greater = ir_bool_op(&m, &a, IROp.Gt, left, right)
    }
    ir_open_if(&a.f, less, a.line)
    minus :: ir_word_const(&m, &a, -1)
    ir_emit(&a.f, IROp.Return, -1, minus, -1, -1, a.line)
    ir_end(&a.f, a.line)
    ir_open_if(&a.f, greater, a.line)
    plus :: ir_word_const(&m, &a, 1)
    ir_emit(&a.f, IROp.Return, -1, plus, -1, -1, a.line)
    ir_end(&a.f, a.line)
    equal :: ir_word_const(&m, &a, 0)
    ir_emit(&a.f, IROp.Return, -1, equal, -1, -1, a.line)
}

// The checked convention of parameter `index` of the function type `ty`; Read
// when none is set.
fn ir_lazy_access(ty: Type, index: Int) -> AccessConvention Never! {
    if ir_untag(ty) == .Fn(_, _, _, _, metadata, _) {
        if metadata == .Val(known) {
            if index < known.conventions.len() -> return known.conventions[index]
        }
    }
    AccessConvention.Read
}

// lazy.callback(env, one slot per parameter, out) -> consumed mask: reads
// each argument from its slot, calls the closure box and writes the result
// into `out`. An IR closure never owns its parameters, so the kernel keeps
// every input: the mask is 0. lazy.callback_write (`lend_write`) lends a
// write parameter its slot itself (a host write callback edits the value a
// Shared or Cell lends in place). `unwrap` (the lazy.carried role): a closure
// value of a `T Never!` function hands back its Result carrier, and `out`
// gets its Ok payload (ir_lazy_closure_method's items are the success type).
fn ir_lazy_callback_body(m: &IRModule, p: IRProgram, a: &IRBuilder, ty: Type, lend_write: Bool, unwrap: Bool, span: Span) Never! {
    pointer_row :: ir_pointer_row(&m)
    word_row :: ir_word_row(&m)
    a.f.result = word_row
    params := [Type]{}
    returned := Type?{None}
    if ir_untag(ty) == .Fn(fn_params, fn_ret, _, _, _, _) {
        params = fn_params
        returned = fn_ret
    } else {
        return ir_fail(&a, span, "lazy callback through {ir_type_name(ty)}")
    }
    env :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "env"))
    inputs := [Int]{}
    loop index in 0..<params.len() {
        &inputs.push(ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "_{index}")))
    }
    out :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "out"))
    args := [Int]{}
    loop (index, param) in params {
        row :: ir_value_type(&m, p, param) ?? return ir_fail(&a, span, "type {ir_type_name(param)}")
        if ir_lazy_access(ty, index) == .Write {
            // The kernels lend their inputs as shared slots: no mutable cell.
            if !lend_write -> return ir_fail(&a, span, "Iter borrowed callback argument {index} requires a mutable host input")
            // A write parameter of a non-aggregate type is its slot's
            // address (BuildExpr.jet ir_param_slot); an aggregate's value is
            // its address already.
            if m.types[row].kind != .Aggregate {
                &args.push(inputs[index])
                next
            }
        }
        value :: ir_load_at(&m, &a, inputs[index], 0, row)
        if value < 0 -> return ir_fail(&a, span, "Unit argument of a lazy callback")
        &args.push(value)
    }
    result_row := -1
    success := Type?{None}
    if returned == .Val(ret) {
        if !ir_unit_type(ret) && !ir_never_type(ret) {
            result_row = ir_value_type(&m, p, ret) ?? return ir_fail(&a, span, "type {ir_type_name(ret)}")
            if unwrap -> success = ir_never_carrier_success(ret)
        }
    }
    result :: ir_call_closure(&m, &a, env, args, result_row)
    stored := result
    if success == .Val(payload) && result >= 0 {
        payload_row :: ir_value_type(&m, p, payload) ?? return ir_fail(&a, span, "type {ir_type_name(payload)}")
        a.fresh[result] = true
        stored = ir_box_take(&m, p, &a, result, 8, payload_row)
    }
    if stored >= 0 -> ir_store_at(&m, p, &a, out, 0, stored)
    mask :: ir_word_const(&m, &a, 0)
    ir_emit(&a.f, IROp.Return, -1, mask, -1, -1, a.line)
}

// A host write callback's parameter is a write parameter (its lambda's
// host_param_conventions, ir_build_lambda): its checked call metadata, which
// lazy.callback_write needs to lend the parameter the host's own slot. None
// for a callback with read parameters.
fn ir_host_write_metadata(p: IRProgram, b: IRBuilder, callback: Int) -> FunctionCallMetadata? Never! {
    if ir_body_node(p, b, callback).kind == .Lambda(lambda) && lambda.host_param_conventions != None {
        if ir_lambda_function_type(lambda) == .Fn(_, _, _, _, metadata, _) -> return metadata
    }
    None
}

// ---------------------------------------------------------------------------
// Descriptors.

fn ir_lazy_store_word(m: &IRModule, b: &IRBuilder, base: Int, offset: Int, value: Int) Never! {
    word :: ir_word_const(&m, &b, value)
    ir_emit(&b.f, IROp.Store, -1, base, offset, word, b.line)
}

// The element descriptor of `ty` in frame storage: nine words stride, clone,
// drop, show, eq, cmp, kind, child0, child1; a List or Option names its
// element's descriptor, a Result its Ok and Err ones. The runtime copies the
// tree before the frame goes away. -1 with `b` failed when `ty` has no
// layout.
fn ir_lazy_meta(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    pointer_row :: ir_pointer_row(&m)
    descriptor :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.StackAddress, descriptor, 72, 8, -1, b.line)
    stride :: ir_list_stride(m, row)
    has_drop :: m.types[row].drop != ""
    // An inline Int? carrier is no box: the runtime's iter_unbox reads its
    // word (JetRuntime Iter.jet ITER_INLINE_OPTION).
    kind :: ir_lazy_kind(&m, p, ty) + (if ir_option_inline(m, row) -> IR_LAZY_INLINE_OPTION else -> 0)
    zero :: ir_word_const(&m, &b, 0)
    clone := zero
    if ir_lazy_type_can_clone(&m, p, ty) {
        id :: ir_lazy_helper(&m, p, &b, "clone", ty, span)
        if id < 0 -> return -1
        clone = ir_lazy_address(&m, &b, id)
    }
    // A value the IR never drops has no drop glue for the runtime either.
    drop := zero
    if has_drop {
        id :: ir_lazy_helper(&m, p, &b, "drop", ty, span)
        if id < 0 -> return -1
        drop = ir_lazy_address(&m, &b, id)
    }
    line :: b.line
    ir_lazy_store_word(&m, &b, descriptor, 0, stride)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 8, clone, line)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 16, drop, line)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 24, zero, line)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 32, zero, line)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 40, zero, line)
    ir_lazy_store_word(&m, &b, descriptor, 48, kind)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 56, zero, line)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 64, zero, line)
    storage :: ir_lazy_storage(p, ty)
    if storage == {
        .List(inner) | .Option(inner) -> {
            child :: ir_lazy_meta(&m, p, &b, inner, span)
            if child < 0 -> return -1
            ir_emit(&b.f, IROp.Store, -1, descriptor, 56, child, line)
        }
        .Result(ok, err) -> {
            ok_meta :: ir_lazy_meta(&m, p, &b, ok, span)
            if ok_meta < 0 -> return -1
            err_meta :: ir_lazy_meta(&m, p, &b, err, span)
            if err_meta < 0 -> return -1
            ir_emit(&b.f, IROp.Store, -1, descriptor, 56, ok_meta, line)
            ir_emit(&b.f, IROp.Store, -1, descriptor, 64, err_meta, line)
        }
        else -> {}
    }
    descriptor
}

// Registers the `role` trait bridge (show, equal or compare) of descriptor
// `meta`; only a checked operation requiring it does.
fn ir_lazy_meta_trait(m: &IRModule, p: IRProgram, b: &IRBuilder, meta: Int, ty: Type, role: String, span: Span) Never! {
    offset :: if role == "show" || role == "debug" -> 24 else if role == "equal" -> 32 else -> 40
    id :: ir_lazy_helper(&m, p, &b, role, ty, span)
    if id < 0 -> return
    callback :: ir_lazy_address(&m, &b, id)
    ir_emit(&b.f, IROp.Store, -1, meta, offset, callback, b.line)
}

// ---------------------------------------------------------------------------
// Operands.

// The runtime took over the Iter in `slot`: a fresh temporary is no longer
// the frame's to drop; a variable moved into the route is cleared, so its
// scope-end drop (jet_rt_native_iter_drop, null-safe) does nothing.
fn ir_lazy_consumed(m: &IRModule, b: &IRBuilder, slot: Int) Never! {
    if slot < 0 -> return
    if b.fresh[slot] {
        b.fresh[slot] = false
        return
    }
    if ir_has_drop(m, b, slot) -> ir_emit(&b.f, IROp.Const, slot, 0, -1, -1, b.line)
}

// A runtime route that takes over the Iter in `taken` (-1: none), whatever
// its outcome: the slot is cleared (ir_lazy_consumed) before the route's stop
// check, so a stop edge never drops an Iter the runtime already owns.
fn ir_lazy_runtime(m: &IRModule, b: &IRBuilder, symbol: String, args: [Int], ty: Int, taken: Int) -> Int Never! {
    dst :: if ty >= 0 -> ir_fresh_temp(&m, &b, ty) else -> -1
    start :: ir_args(&b.f, args)
    ir_emit(&b.f, IROp.CallRuntime, dst, ir_intern_name(&m, symbol), start, args.len(), b.line)
    ir_lazy_consumed(&m, &b, taken)
    if ir_route_can_stop(symbol) -> ir_stop_check(&m, &b)
    dst
}

// A count operand as a native word: an exact Int narrowed; the List receiver
// of `indexes()` gives its length.
fn ir_lazy_count(m: &IRModule, b: &IRBuilder, value: Int, span: Span) -> Int Never! {
    if value < 0 -> return ir_fail_slot(&b, span, "Iter count without a value")
    kind :: ir_kind_of(m, b, value)
    if kind == .Aggregate {
        length :: ir_load_word(&m, &b, value, 0)
        ir_release(&m, &b, value)
        return length
    }
    native :: ir_native_index(&m, &b, value, span)
    ir_release(&m, &b, value)
    native
}

// The address of a value the runtime reads by address: an aggregate is its
// own, any other value is written into frame storage.
fn ir_lazy_value_slot(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    if value >= 0 && ir_kind_of(m, b, value) == .Aggregate -> return value
    size :: if value >= 0 -> m.types[b.f.slot_type[value]].size else -> 0
    pointer_row :: ir_pointer_row(&m)
    slot :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.StackAddress, slot, ir_align8(size), 8, -1, b.line)
    if value >= 0 -> ir_emit(&b.f, IROp.Store, -1, slot, 0, value, b.line)
    slot
}

// The `by_value` flag for an owned operand: 1 for a fresh value the runtime
// takes over (no longer the frame's to drop), 0 for one it copies.
fn ir_lazy_moved(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    fresh :: value >= 0 && b.fresh[value]
    flag :: ir_word_const(&m, &b, if fresh -> 1 else -> 0)
    if fresh -> b.fresh[value] = false
    flag
}

// Whether the type of `row` is a List whose items have no clone glue (a
// handle without a clone, a single-use value, an Iter, or a value holding
// one): such a List is uniquely owned by construction.
fn ir_list_items_lack_clone(m: &IRModule, p: IRProgram, row: Int) -> Bool Never! {
    if ir_untag(m.types[row].ty) == {
        .List(inner) -> !ir_lazy_type_can_clone(&m, p, inner)
        else -> false
    }
}

// Whether the type of `row` has no clone glue: a handle without a clone, a
// single-use value, an Iter, or a List, struct or tuple holding one.
fn ir_row_lacks_clone(m: &IRModule, p: IRProgram, row: Int) -> Bool Never! {
    ty :: ir_untag(m.types[row].ty)
    !ir_lazy_type_can_clone(&m, p, ty)
}

// An Iter over `list` (jet_rt_native_iter_from_list), `meta` its element
// descriptor: a fresh List's header moves in; any other's items are cloned.
// Items without clone glue have no clone path: their List is uniquely owned
// by construction (sema), so lowering one that is not fresh is an internal
// error (I2), never a runtime call through a null clone.
fn ir_lazy_iter_from_list(m: &IRModule, p: IRProgram, b: &IRBuilder, list: Int, element: Type, meta: Int, row: Int, span: Span) -> Int Never! {
    if !(list >= 0 && b.fresh[list]) && !ir_lazy_type_can_clone(&m, p, element) -> return ir_fail_slot(&b, span, "an Iter over a shared [{ir_type_name(element)}], whose items have no clone")
    moved :: ir_lazy_moved(&m, &b, list)
    ir_runtime(&m, &b, "jet_rt_native_iter_from_list", [Int]{list, meta, moved}, row)
}

fn ir_lazy_slot_type(m: IRModule, b: IRBuilder, slot: Int) -> Type Never! {
    if slot < 0 -> return Type.Named{name: "Unit"}
    m.types[b.f.slot_type[slot]].ty.copy()
}

// `list.lazy()`: an Iter over the List's elements; a fresh List's header is
// taken over, any other's elements are cloned. An inline `[T#N]` gives a
// fresh List copy of it (ir_list_operand).
fn ir_lazy_from_list(m: &IRModule, p: IRProgram, b: &IRBuilder, lent: Int, row: Int, span: Span) -> Int Never! {
    list :: ir_list_operand(&m, p, &b, lent, span)
    list_ty :: ir_lazy_slot_type(m, b, list)
    element := Type?{None}
    if ir_untag(list_ty) == .List(inner) -> element = Val(inner)
    elem :: element ?? return ir_fail_slot(&b, span, "Iter source {ir_type_name(list_ty)} is not a List")
    meta :: ir_lazy_meta(&m, p, &b, elem, span)
    if meta < 0 -> return -1
    ir_lazy_iter_from_list(&m, p, &b, list, elem, meta, row, span)
}

// ---------------------------------------------------------------------------
// Routes.

fn ir_lazy_plain(symbol: String) -> Bool Never! {
    symbol == "jet_iter_to_list" || symbol == "jet_iter_collect" || symbol == "jet_iter_first" || symbol == "jet_iter_next" || symbol == "jet_iter_len" || symbol == "jet_iter_is_empty" || symbol == "jet_iter_shuffle" || symbol == "jet_iter_average_int" || symbol == "jet_iter_average_float"
}

fn ir_lazy_counted(symbol: String) -> Bool Never! {
    symbol == "jet_iter_take" || symbol == "jet_iter_skip" || symbol == "jet_iter_step_by" || symbol == "jet_iter_drop_last" || symbol == "jet_iter_repeat" || symbol == "jet_iter_cycle"
}

fn ir_lazy_nested(symbol: String) -> Bool Never! {
    symbol == "jet_iter_chunks" || symbol == "jet_iter_windows" || symbol == "jet_iter_flatten" || symbol == "jet_iter_some"
}

fn ir_lazy_compared(symbol: String) -> Bool Never! {
    symbol == "jet_iter_dedup" || symbol == "jet_iter_is_sorted" || symbol == "jet_iter_join" || symbol == "jet_iter_compare" || symbol == "jet_iter_last_index_of" || symbol == "jet_iter_intersperse"
}

// Whether ir_lazy_route builds the route `symbol` over a first operand of
// type `source_ty`.
fn ir_lazy_symbol(symbol: String, source_ty: Type) -> Bool Never! {
    if symbol == "jet_iter_empty" || symbol == "jet_iter_indexes" || symbol == "jet_iter_enumerate" -> return true
    if symbol == "jet_iter_from_vec" || symbol == "jet_iter_string_split" || symbol == "jet_iter_string_rsplit" -> return true
    if symbol == "jet_list_try_collect" && ir_untag(source_ty) == .List(_) -> return true
    if ir_iter_element(source_ty) == None -> return false
    symbol == "jet_list_sum" || symbol == "jet_list_sum_fixed_f64" || symbol == "jet_list_product" || ir_lazy_plain(symbol) || ir_lazy_counted(symbol) || ir_lazy_nested(symbol) || ir_lazy_compared(symbol) || symbol == "jet_std_io_progress_iter" || symbol == "jet_list_try_collect" || symbol == "jet_iter_split_at"
}

// A static Core call of an Iter route: its arguments as checked, without the
// I64 narrowing of other Core operands (ir_lazy_route narrows counts). None
// when `symbol` is not one.
fn ir_lazy_core_call(m: &IRModule, p: IRProgram, b: &IRBuilder, symbol: String, ty: Type, args: [Int], span: Span) -> Int? Never! {
    source_ty :: if args.len() > 0 -> ir_ty(p, b, args[0]) else -> Type.Named{name: "Unit"}
    if !ir_lazy_symbol(symbol, source_ty) -> return None
    operands := [Int]{}
    loop arg in args {
        slot :: ir_expr(&m, p, &b, arg)
        if ir_failed(b) -> return Val(-1)
        &operands.push(slot)
    }
    Val(ir_lazy_route(&m, p, &b, symbol, ty, operands, span))
}

// Iter builtins lowered over the List under them rather than through an
// Iter: `xs.last_index_of(item)` scans the List from its end
// (ir_list_route), and `xs.cycle(n).to_list()` on a List of scalars fills
// the List in place (ir_lazy_cycle_list). None for any other builtin.
fn ir_lazy_fused(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, operation: TBuiltinOp, args: [Int], span: Span) -> Int? Never! {
    if operation == .IterLastIndexOf && args.len() == 1 && ir_body_node(p, b, receiver).kind == .BuiltinMethod(list_value, lazy_operation, _) {
        if lazy_operation == .ListLazy && ir_untag(ir_ty(p, b, list_value)) == .List(element) && ir_type_size(&m, p, element) > 0 {
            list :: ir_expr(&m, p, &b, list_value)
            if ir_failed(b) -> return Val(-1)
            needle :: ir_expr(&m, p, &b, args[0])
            if ir_failed(b) -> return Val(-1)
            return ir_route_inline(&m, p, &b, "jet_list_last_index_of", [Int]{list, needle}, ty, span)
        }
    }
    if (operation == .IterToList || operation == .IterCollect) && args.len() == 0 && ir_body_node(p, b, receiver).kind == .BuiltinMethod(cycled, cycle_operation, cycle_args) {
        if cycle_operation == .IterCycle && cycle_args.len() == 1 && ir_body_node(p, b, cycled).kind == .BuiltinMethod(source_list, source_operation, _) {
            if source_operation == .ListLazy && ir_untag(ir_ty(p, b, source_list)) == .List(item) && ir_untag(ty) == .List(_) && ir_lazy_scalar(&m, p, item) {
                return Val(ir_lazy_cycle_list(&m, p, &b, source_list, cycle_args[0], item, ty, span))
            }
        }
    }
    None
}

// Whether values of `ty` are scalars: copies no drop can observe.
fn ir_lazy_scalar(m: &IRModule, p: IRProgram, ty: Type) -> Bool Never! {
    row :: ir_value_type(&m, p, ty) ?? return false
    kind :: m.types[row].kind
    kind == .Bool || kind == .Int || kind == .Word || kind == .Float || kind == .Float32 || kind == .Char
}

// `xs.cycle(n).to_list()`: the first max(n, 0) elements of xs repeated, none
// when xs is empty, copied into one buffer of exactly that many elements. A
// count past what memory holds asks for 2^62 bytes, which fails as the
// Iter's growing buffer would. A one-element xs fills the buffer with that
// element, read once: the buffer is a fresh allocation, so no store to it
// changes xs. Each store has the one value (OptReduce.jet's fill), and a
// List whose length is a constant keeps only its own arm.
fn ir_lazy_cycle_list(m: &IRModule, p: IRProgram, b: &IRBuilder, list_value: Int, count_value: Int, element: Type, ty: Type, span: Span) -> Int Never! {
    result_row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    row :: ir_value_type(&m, p, element) ?? return ir_type_fail(&b, span, element)
    list :: ir_expr(&m, p, &b, list_value)
    if ir_failed(b) -> return -1
    counted :: ir_expr(&m, p, &b, count_value)
    if ir_failed(b) -> return -1
    count :: ir_lazy_count(&m, &b, counted, span)
    if ir_failed(b) -> return -1
    stride :: ir_list_stride(m, row)
    word_row :: ir_word_row(&m)
    length :: ir_list_length(&m, &b, list)
    source :: ir_list_data(&m, &b, list)
    zero :: ir_word_const(&m, &b, 0)
    total :: ir_temp(&m, &b, word_row)
    ir_emit(&b.f, IROp.Const, total, 0, -1, -1, b.line)
    some :: ir_bool_op(&m, &b, IROp.Lt, zero, length)
    ir_open_if(&b.f, some, b.line)
    positive :: ir_bool_op(&m, &b, IROp.Lt, zero, count)
    ir_open_if(&b.f, positive, b.line)
    ir_emit(&b.f, IROp.Copy, total, count, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    out :: ir_list_empty(&m, &b, result_row)
    data :: ir_temp(&m, &b, word_row)
    ir_emit(&b.f, IROp.Const, data, 0, -1, -1, b.line)
    filled :: ir_bool_op(&m, &b, IROp.Ne, total, zero)
    ir_open_if(&b.f, filled, b.line)
    bytes :: ir_temp(&m, &b, word_row)
    ir_emit(&b.f, IROp.Const, bytes, 1 << 62, -1, -1, b.line)
    limit :: ir_word_const(&m, &b, (1 << 62) /% stride)
    fits :: ir_bool_op(&m, &b, IROp.Le, total, limit)
    ir_open_if(&b.f, fits, b.line)
    width :: ir_word_const(&m, &b, stride)
    wanted :: ir_word_op(&m, &b, IROp.Mul, total, width)
    ir_emit(&b.f, IROp.Copy, bytes, wanted, -1, -1, b.line)
    ir_end(&b.f, b.line)
    eight :: ir_word_const(&m, &b, 8)
    storage :: ir_runtime(&m, &b, "jet_rt_alloc", [Int]{bytes, eight}, word_row)
    ir_emit(&b.f, IROp.Copy, data, storage, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_route_list_header(&m, &b, out, 0, data, total)
    at :: ir_temp(&m, &b, word_row)
    ir_emit(&b.f, IROp.Const, at, 0, -1, -1, b.line)
    one :: ir_word_const(&m, &b, 1)
    single :: ir_bool_op(&m, &b, IROp.Eq, length, one)
    ir_open_if(&b.f, single, b.line)
    only :: ir_load_at(&m, &b, source, 0, row)
    fill :: ir_count_open(&m, &b, total)
    copied :: ir_copy_value(&m, p, &b, only, span)
    target :: ir_element_address(&m, &b, data, fill, stride)
    ir_store_at(&m, p, &b, target, 0, copied)
    ir_count_close(&m, &b, fill)
    ir_else(&b.f, b.line)
    index :: ir_count_open(&m, &b, total)
    from :: ir_element_address(&m, &b, source, at, stride)
    item :: ir_load_at(&m, &b, from, 0, row)
    duplicate :: ir_copy_value(&m, p, &b, item, span)
    to :: ir_element_address(&m, &b, data, index, stride)
    ir_store_at(&m, p, &b, to, 0, duplicate)
    ir_emit(&b.f, IROp.Add, at, at, one, IR_OVERFLOW_WRAP, b.line)
    wrapped :: ir_bool_op(&m, &b, IROp.Eq, at, length)
    ir_open_if(&b.f, wrapped, b.line)
    ir_emit(&b.f, IROp.Const, at, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_count_close(&m, &b, index)
    ir_end(&b.f, b.line)
    ir_release(&m, &b, list)
    out
}

// An Iter route over evaluated operands, the source first. Every route takes
// the source Iter over; other owned operands go by value when fresh, borrowed
// ones are released afterwards.
fn ir_lazy_route(m: &IRModule, p: IRProgram, b: &IRBuilder, symbol: String, ty: Type, operands: [Int], span: Span) -> Int Never! {
    result_row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    pointer_row :: ir_pointer_row(&m)
    word_row :: ir_word_row(&m)
    if symbol == "jet_iter_empty" || symbol == "jet_iter_indexes" || symbol == "jet_iter_enumerate" {
        elem :: ir_iter_element(ty) ?? return ir_fail_slot(&b, span, "Iter route {symbol} has no checked element type")
        meta :: ir_lazy_meta(&m, p, &b, elem, span)
        if meta < 0 -> return -1
        call_args := [Int]{}
        if symbol == "jet_iter_indexes" {
            if operands.len() != 1 -> return ir_fail_slot(&b, span, "Iter indexes has no checked count")
            count :: ir_lazy_count(&m, &b, operands[0], span)
            if ir_failed(b) -> return -1
            &call_args.push(count)
        } else if symbol == "jet_iter_enumerate" {
            if operands.len() != 2 || operands[0] < 0 || operands[1] < 0 -> return ir_fail_slot(&b, span, "Iter enumerate has no checked callback")
            closure_ty :: ir_lazy_slot_type(m, b, operands[1])
            id :: ir_lazy_helper(&m, p, &b, "callback", closure_ty, span)
            if id < 0 -> return -1
            callback :: ir_lazy_address(&m, &b, id)
            handed :: ir_closure_handover(&m, p, &b, operands[1], span)
            if handed.held < 0 -> return -1
            release :: handed.release
            &call_args.push(operands[0])
            &call_args.push(handed.held)
            &call_args.push(callback)
            &call_args.push(release)
        }
        &call_args.push(meta)
        out :: ir_lazy_runtime(&m, &b, ir_lazy_runtime_symbol(symbol), call_args, result_row, if symbol == "jet_iter_enumerate" -> operands[0] else -> -1)
        return out
    }
    if operands.len() == 0 || operands[0] < 0 -> return ir_fail_slot(&b, span, "Iter route {symbol} has no checked source")
    source :: operands[0]
    if symbol == "jet_iter_from_vec" -> return ir_lazy_from_list(&m, p, &b, source, result_row, span)
    if symbol == "jet_iter_string_split" || symbol == "jet_iter_string_rsplit" {
        if operands.len() != 2 -> return ir_fail_slot(&b, span, "String Iter source {symbol} has no checked separator")
        elem :: ir_iter_element(ty) ?? return ir_fail_slot(&b, span, "String Iter source {symbol} has no checked element type")
        meta :: ir_lazy_meta(&m, p, &b, elem, span)
        if meta < 0 -> return -1
        out :: ir_runtime(&m, &b, ir_lazy_runtime_symbol(symbol), [Int]{source, operands[1], meta}, result_row)
        ir_release(&m, &b, source)
        ir_release(&m, &b, operands[1])
        return out
    }
    source_ty :: ir_lazy_slot_type(m, b, source)
    list_source :: (symbol == "jet_list_try_collect" || symbol == "jet_iter_split_at") && ir_untag(source_ty) == .List(_)
    element := ir_iter_element(source_ty)
    handle := source
    if list_source {
        if ir_untag(source_ty) == .List(inner) -> element = Val(inner)
        handle = ir_lazy_from_list(&m, p, &b, source, pointer_row, span)
        if handle < 0 -> return -1
    }
    elem :: element ?? return ir_fail_slot(&b, span, "Iter route {symbol} over {ir_type_name(source_ty)}")
    if symbol == "jet_list_sum" || symbol == "jet_list_sum_fixed_f64" || symbol == "jet_list_product" {
        // The remaining items drain into a List the List reduction folds in
        // order.
        if operands.len() != 1 -> return ir_fail_slot(&b, span, "Iter {symbol} with arguments")
        list_row :: ir_value_type(&m, p, Type.List{element: elem}) ?? return ir_fail_slot(&b, span, "type [{ir_type_name(elem)}]")
        list :: ir_list_empty(&m, &b, list_row)
        _ :: ir_lazy_runtime(&m, &b, "jet_rt_native_iter_to_list", [Int]{handle, list}, -1, handle)
        return ir_route(&m, p, &b, symbol, [Int]{list}, [Bool]{true}, ty, span)
    }
    if symbol == "jet_iter_to_list" || symbol == "jet_iter_collect" {
        out :: ir_list_empty(&m, &b, result_row)
        _ :: ir_lazy_runtime(&m, &b, "jet_rt_native_iter_to_list", [Int]{handle, out}, -1, handle)
        return out
    }
    splits :: symbol == "jet_iter_split_at"
    compared :: ir_lazy_compared(symbol)
    collects :: symbol == "jet_list_try_collect"
    by_address :: symbol == "jet_iter_intersperse" || symbol == "jet_iter_last_index_of"
    call_args := [Int]{handle}
    if ir_lazy_counted(symbol) || symbol == "jet_iter_chunks" || symbol == "jet_iter_windows" || splits {
        if operands.len() != 2 -> return ir_fail_slot(&b, span, "Iter route {symbol} has no checked count")
        count :: ir_lazy_count(&m, &b, operands[1], span)
        if ir_failed(b) -> return -1
        &call_args.push(count)
    } else {
        loop index in 1..<operands.len() {
            value :: operands[index]
            if value < 0 -> return ir_fail_slot(&b, span, "Iter route {symbol} operand without a value")
            slot :: if by_address -> ir_lazy_value_slot(&m, &b, value) else -> value
            &call_args.push(slot)
        }
    }
    if ir_lazy_nested(symbol) {
        output :: ir_iter_element(ty) ?? return ir_fail_slot(&b, span, "Iter adapter {symbol} has no checked output element")
        output_meta :: ir_lazy_meta(&m, p, &b, output, span)
        if output_meta < 0 -> return -1
        &call_args.push(output_meta)
    } else if compared {
        meta :: ir_lazy_meta(&m, p, &b, elem, span)
        if meta < 0 -> return -1
        if symbol == "jet_iter_join" -> ir_lazy_meta_trait(&m, p, &b, meta, elem, "show", span)
        if symbol == "jet_iter_dedup" || symbol == "jet_iter_last_index_of" -> ir_lazy_meta_trait(&m, p, &b, meta, elem, "equal", span)
        if symbol == "jet_iter_is_sorted" || symbol == "jet_iter_compare" -> ir_lazy_meta_trait(&m, p, &b, meta, elem, "compare", span)
        if ir_failed(b) -> return -1
        &call_args.push(meta)
        if symbol == "jet_iter_compare" {
            // The runtime snapshots the other operand from a List header; an
            // Iter operand is drained into a fresh List the runtime takes over.
            if operands.len() != 2 -> return ir_fail_slot(&b, span, "Iter compare has no checked operand")
            other :: operands[1]
            other_ty :: ir_lazy_slot_type(m, b, other)
            if ir_iter_element(other_ty) == .Val(other_elem) {
                list_row :: ir_value_type(&m, p, Type.List{element: other_elem}) ?? return ir_fail_slot(&b, span, "type [{ir_type_name(other_elem)}]")
                drained :: ir_list_empty(&m, &b, list_row)
                _ :: ir_lazy_runtime(&m, &b, "jet_rt_native_iter_to_list", [Int]{other, drained}, -1, other)
                call_args[1] = drained
                taken :: ir_word_const(&m, &b, 1)
                &call_args.push(taken)
            } else {
                &call_args.push(ir_lazy_moved(&m, &b, other))
            }
        } else if by_address {
            if operands.len() != 2 -> return ir_fail_slot(&b, span, "Iter route {symbol} has no checked value")
            &call_args.push(ir_lazy_moved(&m, &b, operands[1]))
        }
    } else if collects {
        result_ty :: ir_untag(ty)
        if result_ty == .Result(ok, err) {
            ok_meta :: ir_lazy_meta(&m, p, &b, ok, span)
            if ok_meta < 0 -> return -1
            err_meta :: ir_lazy_meta(&m, p, &b, err, span)
            if err_meta < 0 -> return -1
            &call_args.push(ok_meta)
            &call_args.push(err_meta)
        } else if result_ty == .Option(ok) {
            ok_meta :: ir_lazy_meta(&m, p, &b, ok, span)
            if ok_meta < 0 -> return -1
            &call_args.push(ok_meta)
            &call_args.push(ir_word_const(&m, &b, 0))
        } else {
            return ir_fail_slot(&b, span, "Iter try_collect has no checked failure carrier output")
        }
    } else if splits {
        fields := [TypeTupleField]{}
        if ir_untag(ty) == .Tuple(pair) -> fields = pair
        members :: ir_tuple_members(&m, p, fields) ?? return ir_type_fail(&b, span, ty)
        if members.len() != 2 -> return ir_fail_slot(&b, span, "Iter split_at has no checked pair of Lists")
        size :: m.types[result_row].size
        out :: ir_fresh_temp(&m, &b, result_row)
        ir_emit(&b.f, IROp.StackAddress, out, size, 8, -1, b.line)
        &call_args.push(out)
        &call_args.push(ir_word_const(&m, &b, members[0].offset))
        &call_args.push(ir_word_const(&m, &b, members[1].offset))
        _ :: ir_lazy_runtime(&m, &b, "jet_rt_native_iter_split_at", call_args, -1, handle)
        return out
    }
    runtime :: if symbol == "jet_std_io_progress_iter" -> "jet_rt_native_iter_progress" else if collects -> "jet_rt_native_iter_try_collect" else -> ir_lazy_runtime_symbol(symbol)
    out := -1
    if symbol == "jet_iter_len" || symbol == "jet_iter_compare" {
        native :: ir_lazy_runtime(&m, &b, runtime, call_args, word_row, handle)
        out = ir_runtime(&m, &b, "jet_int_owned_from_i64", [Int]{native}, result_row)
    } else if ir_option_inline(m, result_row) {
        // The runtime answers its generic Option box (ir_option_unbox).
        box_row :: ir_pointer_row(&m)
        boxed :: ir_lazy_runtime(&m, &b, runtime, call_args, box_row, handle)
        out = ir_option_unbox(&m, &b, boxed, result_row)
    } else {
        out = ir_lazy_runtime(&m, &b, runtime, call_args, result_row, handle)
    }
    loop index in 1..<operands.len() -> ir_release(&m, &b, operands[index])
    out
}

// ---------------------------------------------------------------------------
// Closure adapters.

// The single-callback Iter adapters over an Iter source.
fn ir_lazy_callback_route(symbol: String) -> Bool Never! {
    symbol == "jet_iter_map" || symbol == "jet_iter_map_mut" || symbol == "jet_iter_try_map" || symbol == "jet_iter_try_filter" || symbol == "jet_iter_filter" || symbol == "jet_iter_take_while" || symbol == "jet_iter_skip_while" || symbol == "jet_iter_flat_map" || symbol == "jet_iter_filter_map" || symbol == "jet_iter_dedup_by" || symbol == "jet_iter_chunk_while" || symbol == "jet_iter_is_sorted_by"
}

// The List routes built as an Iter adapter over the List.
fn ir_lazy_list_callback_route(symbol: String) -> Bool Never! {
    symbol == "jet_list_take_while_iter" || symbol == "jet_list_skip_while_iter" || symbol == "jet_list_filter_map_iter"
}

// Whether ir_lazy_closure_method builds `operation` on a receiver of
// `receiver_ty`: any operation on an Iter, and the List operations whose
// route makes an Iter.
fn ir_lazy_closure_receiver(receiver_ty: Type, operation: TClosureOp) -> Bool Never! {
    if ir_iter_element(receiver_ty) != None -> return true
    if ir_untag(receiver_ty) == {
        .List(_) | .FixedList(_, _) -> {}
        else -> return false
    }
    operation == .TakeWhile || operation == .SkipWhile || operation == .FilterMap || operation == .IsSortedBy
}

// `iter.map(f)`, `list.filter_map(f)`, ...: the runtime adapter over the
// source Iter (a List source first becomes one) with the closure box, its
// lazy.callback, its release helper (the adapter owns the box) and the output
// descriptor. A closure value of a `T Never!` function returns its Result
// carrier: the adapter sees the Ok payload (lazy.carried), and a checked
// `Iter<U> Never!` (a map over it) is the adapter in an Ok box.
fn ir_lazy_closure_method(m: &IRModule, p: IRProgram, b: &IRBuilder, checked_ty: Type, receiver: Int, operation: TClosureOp, args: [Int], span: Span) -> Int Never! {
    result_ty :: ir_never_carrier_success(checked_ty) ?? checked_ty
    receiver_type :: ir_ty(p, b, receiver)
    receiver_ty :: receiver_type
    if ir_iter_element(receiver_ty) != None {
        if operation == .Any || operation == .All || operation == .Position -> return ir_lazy_search(&m, p, &b, checked_ty, receiver, operation, args, span)
    }
    route :: ir_closure_route(operation, receiver_ty)
    symbol :: route.symbol
    scans :: symbol == "jet_iter_scan"
    list_source :: ir_lazy_list_callback_route(symbol) || (symbol == "jet_iter_is_sorted_by" && ir_iter_element(receiver_ty) == None)
    if !scans && !ir_lazy_callback_route(symbol) && !list_source -> return ir_fail_slot(&b, span, "closure method {ir_closure_op_name(operation)} on {ir_type_name(receiver_type)}")
    expected :: if scans -> 2 else -> 1
    if args.len() != expected -> return ir_fail_slot(&b, span, "Iter closure adapter {symbol} has no single checked callback")
    closure_expr :: args[args.len() - 1]
    closure_ty :: ir_ty(p, b, closure_expr)
    closure_ret := Type?{None}
    if ir_untag(closure_ty) == .Fn(_, fn_ret, _, _, _, _) -> closure_ret = fn_ret
    carried_ret :: if closure_ret == .Val(ret) -> ir_never_carrier_success(ret) else -> None
    carried :: carried_ret != None && !scans && symbol != "jet_iter_filter_map" && symbol != "jet_list_filter_map_iter"
    result_row :: ir_value_type(&m, p, result_ty) ?? return ir_type_fail(&b, span, result_ty)
    pointer_row :: ir_pointer_row(&m)
    source := ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || source < 0 -> return -1
    seed_slot := -1
    seed_meta := -1
    seed_moved := -1
    if scans {
        seed :: ir_expr(&m, p, &b, args[0])
        if ir_failed(b) -> return -1
        seed_slot = ir_lazy_value_slot(&m, &b, seed)
        subst_ty :: ir_ty(p, b, args[0])
        seed_meta = ir_lazy_meta(&m, p, &b, subst_ty, span)
        if seed_meta < 0 -> return -1
        seed_moved = ir_lazy_moved(&m, &b, seed)
    }
    if list_source {
        source = ir_lazy_from_list(&m, p, &b, source, pointer_row, span)
        if source < 0 -> return -1
    }
    expr_closure :: ir_expr(&m, p, &b, closure_expr)
    if ir_failed(b) || expr_closure < 0 -> return -1
    id :: ir_lazy_helper(&m, p, &b, if carried -> "carried" else -> "callback", closure_ty, span)
    if id < 0 -> return -1
    callback :: ir_lazy_address(&m, &b, id)
    handed :: ir_closure_handover(&m, p, &b, expr_closure, span)
    if handed.held < 0 -> return -1
    closure :: handed.held
    release :: handed.release
    if scans {
        elem :: ir_iter_element(result_ty) ?? return ir_fail_slot(&b, span, "Iter scan has no checked output element")
        output_meta :: ir_lazy_meta(&m, p, &b, elem, span)
        if output_meta < 0 -> return -1
        out :: ir_lazy_runtime(&m, &b, "jet_rt_native_iter_scan", [Int]{source, seed_slot, seed_meta, seed_moved, closure, callback, release, output_meta}, result_row, source)
        return out
    }
    returned := if carried -> carried_ret else -> closure_ret
    output := ir_iter_element(result_ty)
    if returned != None -> output = returned
    output_ty :: output ?? return ir_fail_slot(&b, span, "Iter closure adapter {symbol} has no checked callback result")
    // I3 (ir_check_callback_element): map's items are what its callback
    // makes, filter_map's the present or Ok payload of it.
    if returned == .Val(made) && ir_iter_element(result_ty) == .Val(item) {
        method := ""
        payload := Type?{None}
        if symbol == "jet_iter_map" || symbol == "jet_iter_map_mut" {
            method = "map"
            payload = Val(made)
        }
        if symbol == "jet_iter_filter_map" || symbol == "jet_list_filter_map_iter" {
            method = "filter_map"
            if ir_untag(made) == {
                .Option(inner) | .Result(inner, _) -> payload = Val(inner)
                else -> {}
            }
        }
        if payload == .Val(built) {
            item_row :: ir_value_type(&m, p, item) ?? return ir_type_fail(&b, span, item)
            if !ir_check_callback_element(&m, p, &b, method, item_row, built, span) -> return -1
        }
    }
    meta :: ir_lazy_meta(&m, p, &b, output_ty, span)
    if meta < 0 -> return -1
    if symbol == "jet_iter_dedup_by" -> ir_lazy_meta_trait(&m, p, &b, meta, output_ty, "equal", span)
    if symbol == "jet_iter_is_sorted_by" -> ir_lazy_meta_trait(&m, p, &b, meta, output_ty, "compare", span)
    if ir_failed(b) -> return -1
    runtime :: if symbol == "jet_list_take_while_iter" -> "jet_rt_native_iter_take_while" else if symbol == "jet_list_skip_while_iter" -> "jet_rt_native_iter_skip_while" else if symbol == "jet_list_filter_map_iter" -> "jet_rt_native_iter_filter_map" else -> ir_lazy_runtime_symbol(symbol)
    call_args := [Int]{source, closure, callback, release, meta}
    if symbol == "jet_iter_chunk_while" {
        chunk :: ir_iter_element(result_ty) ?? return ir_fail_slot(&b, span, "Iter chunk_while has no checked output element")
        chunk_meta :: ir_lazy_meta(&m, p, &b, chunk, span)
        if chunk_meta < 0 -> return -1
        &call_args.push(chunk_meta)
    }
    out := -1
    if ir_option_inline(m, result_row) {
        // The runtime answers its generic Option box (ir_option_unbox).
        box_row :: ir_pointer_row(&m)
        boxed :: ir_lazy_runtime(&m, &b, runtime, call_args, box_row, source)
        out = ir_option_unbox(&m, &b, boxed, result_row)
    } else {
        out = ir_lazy_runtime(&m, &b, runtime, call_args, result_row, source)
    }
    if ir_never_carrier_success(checked_ty) != None -> return ir_result_box(&m, p, &b, checked_ty, true, out)
    out
}

// `iter.any(f)` / `iter.all(f)` / `iter.position(f)`: each item is pulled
// (jet_rt_native_iter_next), lent to the predicate and its Option box
// dropped; the first decision ends the pulls, so no later item reaches an
// upstream adapter callback. A fresh Iter is dropped afterwards; a held one
// stays its owner's.
fn ir_lazy_search(m: &IRModule, p: IRProgram, b: &IRBuilder, result_ty: Type, receiver: Int, operation: TClosureOp, args: [Int], span: Span) -> Int Never! {
    receiver_ty :: ir_ty(p, b, receiver)
    element_ty :: ir_iter_element(receiver_ty) ?? return ir_fail_slot(&b, span, "closure method {ir_closure_op_name(operation)} on {ir_type_name(receiver_ty)}")
    if args.len() != 1 -> return ir_fail_slot(&b, span, "Iter {ir_closure_op_name(operation)} has no single checked callback")
    position :: operation == .Position
    all :: operation == .All
    result_row :: ir_value_type(&m, p, result_ty) ?? return ir_type_fail(&b, span, result_ty)
    row :: ir_value_type(&m, p, element_ty) ?? return ir_type_fail(&b, span, element_ty)
    slot_ty :: Type.Option{inner: element_ty}
    slot_row :: ir_value_type(&m, p, slot_ty) ?? return ir_type_fail(&b, span, slot_ty)
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    int_row :: ir_type_row(&m, Type.Int) ?? 0
    source :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || source < 0 -> return -1
    callback :: ir_expr(&m, p, &b, args[0])
    if ir_failed(b) || callback < 0 -> return -1
    zero :: ir_word_const(&m, &b, 0)
    one :: ir_word_const(&m, &b, 1)
    index :: ir_word_const(&m, &b, 0)
    // Position: the matching index, -1 while none; any/all: the decision.
    decided :: if position -> ir_word_const(&m, &b, -1) else -> ir_temp(&m, &b, bool_row)
    if !position -> ir_emit(&b.f, IROp.Const, decided, if all -> 1 else -> 0, -1, -1, b.line)
    exit :: ir_open(&b.f, IROp.Block, b.line)
    _ :: ir_open(&b.f, IROp.Loop, b.line)
    // An Int item's slot is no Option box: the item is dropped and the
    // runtime's 8-byte block freed.
    word_slot :: ir_option_inline(m, slot_row)
    pull_row :: if word_slot -> ir_pointer_row(&m) else -> slot_row
    pulled :: ir_runtime(&m, &b, "jet_rt_native_iter_next", [Int]{source}, pull_row)
    more :: ir_bool_op(&m, &b, IROp.Ne, pulled, zero)
    ir_exit_unless(&m, &b, more, exit)
    item :: ir_load_at(&m, &b, pulled, 0, row)
    keep :: ir_call_closure(&m, &b, callback, [Int]{item}, bool_row)
    if word_slot {
        if ir_has_drop(m, b, item) -> ir_emit(&b.f, IROp.Drop, -1, item, -1, -1, b.line)
        eight :: ir_word_const(&m, &b, 8)
        ir_free(&m, &b, pulled, eight)
    } else {
        ir_release(&m, &b, pulled)
    }
    stop := keep
    if all {
        no :: ir_int_constant(&m, &b, bool_row, 0)
        stop = ir_bool_op(&m, &b, IROp.Eq, keep, no)
    }
    ir_open_if(&b.f, stop, b.line)
    if position {
        ir_emit(&b.f, IROp.Copy, decided, index, -1, -1, b.line)
    } else {
        ir_emit(&b.f, IROp.Const, decided, if all -> 0 else -> 1, -1, -1, b.line)
    }
    ir_emit(&b.f, IROp.Br, -1, 2, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_emit(&b.f, IROp.Add, index, index, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    ir_release(&m, &b, source)
    ir_release(&m, &b, callback)
    if !position -> return decided
    // Some(index) holds the exact Int; None is the Option's none.
    result :: ir_fresh_temp(&m, &b, result_row)
    ir_option_none(&m, &b, result)
    found :: ir_bool_op(&m, &b, IROp.Ge, decided, zero)
    ir_open_if(&b.f, found, b.line)
    exact :: ir_runtime(&m, &b, "jet_int_owned_from_i64", [Int]{decided}, int_row)
    int_size :: ir_type_size(&m, p, Type.Int)
    made :: ir_option_make(&m, p, &b, result_row, exact, int_size)
    ir_option_set(&m, &b, result, made)
    ir_end(&b.f, b.line)
    result
}

// ---------------------------------------------------------------------------
// Pulls and loops.

// The place under the borrows and moves of a receiver.
fn ir_lazy_place(p: IRProgram, b: IRBuilder, value: Int) -> Int Never! {
    kind :: ir_body_node(p, b, value).kind
    if kind == .Borrow(place, _) -> return ir_lazy_place(p, b, place)
    if kind == .Move(inner) -> return ir_lazy_place(p, b, inner)
    value
}

// `&iter.next()`: the next item in an Option box, pulled through the shared
// handle the variable keeps. The pull changes the handle's state, not the
// owner's pointer: nothing is written back.
fn ir_lazy_next(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, span: Span) -> Int Never! {
    place :: ir_lazy_place(p, b, receiver)
    place_ty :: ir_ty(p, b, place)
    if ir_iter_element(place_ty) == None -> return ir_fail_slot(&b, span, "next on {ir_type_name(place_ty)}")
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    handle :: ir_expr(&m, p, &b, place)
    if ir_failed(b) || handle < 0 -> return -1
    if !ir_option_inline(m, row) {
        out :: ir_runtime(&m, &b, "jet_rt_native_iter_next", [Int]{handle}, row)
        ir_release(&m, &b, handle)
        return out
    }
    // An Int item arrives in the runtime's 8-byte block (null at the end).
    pointer_row :: ir_pointer_row(&m)
    pulled :: ir_runtime(&m, &b, "jet_rt_native_iter_next", [Int]{handle}, pointer_row)
    ir_release(&m, &b, handle)
    ir_option_unbox(&m, &b, pulled, row)
}

// `loop x in iter` / `loop (i, x) in iter`: the runtime cursor takes the Iter
// over and is an owned binding of the loop's scope, dropped when the scope
// closes or the function returns. Each step copies the current item into
// frame storage. An item with a drop is taken by value (Sema's ForIn
// by_value): the body owns it, may move it out (`close(^ticket)`), and the
// step's scope drops what is left; any other item is a copy the advance
// drops.
fn ir_lazy_walk(m: &IRModule, p: IRProgram, b: &IRBuilder, label: String?, variable: TLocal, variable_two: TLocal?, collection: Int, step: Int?, body: [Int], span: Span) Never! {
    collection_ty :: ir_ty(p, b, collection)
    element_ty :: ir_iter_element(collection_ty) ?? return ir_fail(&b, span, "loop over {ir_type_name(collection_ty)}")
    row :: ir_value_type(&m, p, element_ty) ?? return ir_fail(&b, span, "type {ir_type_name(element_ty)}")
    source :: ir_expr(&m, p, &b, collection)
    if ir_failed(b) || source < 0 -> return
    stride := -1
    if step == .Val(node) {
        stride = ir_expr(&m, p, &b, node)
        if ir_failed(b) || stride < 0 -> return
    }
    ir_lazy_walk_source(&m, p, &b, label, variable, variable_two, source, row, stride, body, span)
}

// Whether `loop x in ^xs` (or a walk of a fresh List) takes the List's
// items over: the List is moved or fresh, and its items close (a Close
// method or a move-only handle at any depth) or are move-only handles. A
// step's item can't share such a value with the List (a byte copy shares the
// handle uncounted, so both would close it, #6415); the walk moves each item
// out instead (ir_list_walk_taken).
fn ir_list_walk_takes(m: &IRModule, p: IRProgram, b: &IRBuilder, collection_ty: Type, list: Int, row: Int, span: Span) -> Bool Never! {
    listed :: ir_untag(collection_ty) == .List(_)
    if !listed -> return false
    if !b.fresh[list] && !ir_movable_binding(b, list) -> return false
    if ir_close_handle(m, row) -> return true
    ir_close_glue(&m, p, &b, row, false, span) >= 0
}

// The walk of a List whose items it takes over (ir_list_walk_takes): the
// List moves into an Iter (jet_rt_native_iter_from_list), walked as any
// other, whose item each step owns: the body may move it out (`^x`), and the
// step's scope closes and drops what is left. The items a `break`, `return`
// or stop leaves in the Iter close as a scope end would close them (the
// descriptor's drop is lazy.retire), when the cursor drops.
fn ir_list_walk_taken(m: &IRModule, p: IRProgram, b: &IRBuilder, label: String?, variable: TLocal, variable_two: TLocal?, collection_ty: Type, list: Int, row: Int, body: [Int], span: Span) Never! {
    element :: m.types[row].ty.copy()
    ir_close_disarm(&b, list)
    owned :: ir_own(&m, p, &b, list)
    meta :: ir_lazy_meta(&m, p, &b, element, span)
    if meta < 0 -> return
    glue :: ir_close_glue(&m, p, &b, row, false, span)
    if ir_failed(b) -> return
    if glue >= 0 {
        retire :: ir_lazy_helper(&m, p, &b, "retire", element, span)
        if retire < 0 -> return
        address :: ir_lazy_address(&m, &b, retire)
        ir_emit(&b.f, IROp.Store, -1, meta, 16, address, b.line)
    }
    iter_ty :: Type.Apply{name: "Iter", args: [Type]{element}}
    iter_row :: ir_value_type(&m, p, iter_ty) ?? return ir_fail(&b, span, "loop over {ir_type_name(collection_ty)}")
    source :: ir_lazy_iter_from_list(&m, p, &b, owned, element, meta, iter_row, span)
    if source < 0 -> return
    ir_lazy_walk_source(&m, p, &b, label, variable, variable_two, source, row, -1, body, span)
}

// `loop line in reader.lines()` / `loop line in io.stdin().lines()` /
// `loop line in child.stdout.lines()`: the runtime line source `export`
// (jet_rt_native_iter_{file,stdin,process}_lines) wraps the FileReader,
// StdinHandle or process stream as an `Iter<String>` through a borrowed
// adapter32 (IterSources.jet): the handle, lazy.line_next, lazy.line_release
// and, for a process stream only, lazy.line_clone. A fresh handle is moved
// into it (read lazily). A kept file or stdin handle is borrowed, and the
// runtime drains it at init (iter_line_source); a kept process stream is
// cloned at init, so the Iter holds the shared pipe and reads it lazily. The
// Iter is then walked as any other.
fn ir_lines_walk(m: &IRModule, p: IRProgram, b: &IRBuilder, label: String?, variable: TLocal, variable_two: TLocal?, collection: Int, export: String, body: [Int], span: Span) Never! {
    iter_ty :: Type.Apply{name: "Iter", args: [Type]{Type.String}}
    iter_row :: ir_value_type(&m, p, iter_ty) ?? return ir_fail(&b, span, "type {ir_type_name(iter_ty)}")
    row :: ir_string_row(&m)
    handle_ty :: ir_ty(p, b, ir_lazy_place(p, b, collection))
    next_helper :: ir_lazy_helper(&m, p, &b, "line_next", handle_ty, span)
    if next_helper < 0 -> return
    release_helper :: ir_lazy_helper(&m, p, &b, "line_release", handle_ty, span)
    if release_helper < 0 -> return
    shared :: export == "jet_rt_native_iter_process_lines"
    clone_helper :: if shared -> ir_lazy_helper(&m, p, &b, "line_clone", handle_ty, span) else -> -1
    if ir_failed(b) -> return
    handle :: ir_expr(&m, p, &b, collection)
    if ir_failed(b) || handle < 0 -> return
    meta :: ir_lazy_meta(&m, p, &b, Type.String, span)
    if ir_failed(b) -> return
    moved :: ir_lazy_moved(&m, &b, handle)
    pointer_row :: ir_pointer_row(&m)
    adapter :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.StackAddress, adapter, 32, 8, -1, b.line)
    ir_emit(&b.f, IROp.Store, -1, adapter, 0, handle, b.line)
    next_address :: ir_lazy_address(&m, &b, next_helper)
    release_address :: ir_lazy_address(&m, &b, release_helper)
    clone_address :: if shared -> ir_lazy_address(&m, &b, clone_helper) else -> ir_word_const(&m, &b, 0)
    ir_emit(&b.f, IROp.Store, -1, adapter, 8, next_address, b.line)
    ir_emit(&b.f, IROp.Store, -1, adapter, 16, release_address, b.line)
    ir_emit(&b.f, IROp.Store, -1, adapter, 24, clone_address, b.line)
    source :: ir_runtime(&m, &b, export, [Int]{adapter, moved, meta}, iter_row)
    ir_release(&m, &b, handle)
    ir_lazy_walk_source(&m, p, &b, label, variable, variable_two, source, row, -1, body, span)
}

// lazy.line_next(payload, output) -> 0 at end, 1 with the moved line in
// `output`, -1 stopped: one call of the handle's Core line reader
// (ir_line_reader_key), a method on the handle or, for a process stream, a
// function that reads the handle as its one parameter. A read error panics
// with its display at <core.prelude>:0, as CollectionIoSources.rs's jet_panic
// does; a panic a task publishes returns, and the source stops.
fn ir_line_next_body(m: &IRModule, p: IRProgram, a: &IRBuilder, handle_ty: Type, span: Span) Never! {
    pointer_row :: ir_pointer_row(&m)
    word_row :: ir_word_row(&m)
    a.f.result = word_row
    handle_row :: ir_value_type(&m, p, handle_ty) ?? return ir_fail(&a, span, "type {ir_type_name(handle_ty)}")
    payload :: ir_new_slot(&a, handle_row, IRSlotKind.Param, ir_intern_name(&m, "payload"))
    output :: ir_new_slot(&a, pointer_row, IRSlotKind.Param, ir_intern_name(&m, "output"))
    key :: ir_line_reader_key(p.functions, handle_ty)
    row :: ir_function_row(p, key) ?? return ir_fail(&a, span, "line reader of {ir_type_name(handle_ty)}")
    access :: ir_receiver_access(p.functions[row].kind)
    result := -1
    if access == "static" {
        params :: p.functions[row].params
        if params.len() != 1 || params[0].convention != .Read -> return ir_fail(&a, span, "line reader {key} that does not read one handle")
        callee :: ir_function_row_id(&m, p, row, [Type]{}) ?? return ir_fail(&a, span, "call of {key}")
        returned :: ir_executable_return(p.functions[row]) ?? return ir_fail(&a, span, "line reader {key} without a result")
        result_row :: ir_value_type(&m, p, returned) ?? return ir_fail(&a, span, "type {ir_type_name(returned)}")
        result = ir_fresh_temp(&m, &a, result_row)
        start :: ir_args(&a.f, [Int]{payload})
        ir_emit(&a.f, IROp.Call, result, callee, start, 1, a.line)
        ir_stop_check(&m, &a)
    } else {
        receiver := payload
        // An Aggregate handle's slot is its own storage, the receiver of a
        // write method as it is (ir_place_address); a word handle is boxed.
        if access == "write" {
            if m.types[handle_row].kind != .Aggregate {
                receiver = ir_temp(&m, &a, pointer_row)
                ir_emit(&a.f, IROp.StackAddress, receiver, 8, 8, -1, a.line)
                ir_emit(&a.f, IROp.Store, -1, receiver, 0, payload, a.line)
            }
        } else if access != "read" {
            return ir_fail(&a, span, "line reader receiver {access}")
        }
        result = ir_call(&m, p, &a, key, [Type]{}, receiver, [IRWriteBack]{}, [BodyCallArg]{}, span)
    }
    if ir_failed(a) || result < 0 -> return
    result_ty :: m.types[a.f.slot_type[result]].ty
    line_ty := Type.String
    error_ty := Type.String
    if ir_untag(result_ty) == .Result(ok, err) {
        line_ty = ok
        error_ty = err
    } else {
        return ir_fail(&a, span, "line reader result {ir_type_name(result_ty)}")
    }
    option_row :: ir_value_type(&m, p, line_ty) ?? return ir_fail(&a, span, "type {ir_type_name(line_ty)}")
    error_row :: ir_value_type(&m, p, error_ty) ?? return ir_fail(&a, span, "type {ir_type_name(error_ty)}")
    ok :: ir_result_is_ok(&m, &a, result)
    ir_open_if(&a.f, ok, a.line)
    option :: ir_box_take(&m, p, &a, result, 8, option_row)
    present :: ir_option_is_some(&m, &a, option)
    ir_open_if(&a.f, present, a.line)
    string_row :: ir_string_row(&m)
    line :: ir_box_take(&m, p, &a, option, 0, string_row)
    ir_store_at(&m, p, &a, output, 0, line)
    a.fresh[line] = false
    moved :: ir_word_const(&m, &a, 1)
    ir_emit(&a.f, IROp.Return, -1, moved, -1, -1, a.line)
    ir_end(&a.f, a.line)
    eof :: ir_word_const(&m, &a, 0)
    ir_emit(&a.f, IROp.Return, -1, eof, -1, -1, a.line)
    ir_end(&a.f, a.line)
    error :: ir_box_take(&m, p, &a, result, 8, error_row)
    text :: ir_render(&m, p, &a, error_ty, error, IRRender.Display, span)
    if ir_failed(a) || text < 0 -> return
    data :: ir_load_word(&m, &a, text, 0)
    length :: ir_load_word(&m, &a, text, 8)
    _ :: ir_runtime(&m, &a, "jet_rt_panic_message", [Int]{data, length}, -1)
    if text != error -> ir_release(&m, &a, text)
    ir_release(&m, &a, error)
    stopped :: ir_word_const(&m, &a, -1)
    ir_emit(&a.f, IROp.Return, -1, stopped, -1, -1, a.line)
}

// lazy.line_release(payload): drops the handle an owned line source holds,
// once, when the Iter is dropped (IterSources.jet release16).
fn ir_line_release_body(m: &IRModule, p: IRProgram, a: &IRBuilder, handle_ty: Type, span: Span) Never! {
    handle_row :: ir_value_type(&m, p, handle_ty) ?? return ir_fail(&a, span, "type {ir_type_name(handle_ty)}")
    payload :: ir_new_slot(&a, handle_row, IRSlotKind.Param, ir_intern_name(&m, "payload"))
    if ir_has_drop(m, a, payload) -> ir_emit(&a.f, IROp.Drop, -1, payload, -1, -1, a.line)
    ir_emit(&a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// lazy.line_clone(payload) -> payload: the line source's own reference to a
// kept process stream, taken at init (IterSources.jet clone24). The source
// then holds the shared pipe, and line_release drops this reference.
fn ir_line_clone_body(m: &IRModule, p: IRProgram, a: &IRBuilder, handle_ty: Type, span: Span) Never! {
    handle_row :: ir_value_type(&m, p, handle_ty) ?? return ir_fail(&a, span, "type {ir_type_name(handle_ty)}")
    a.f.result = handle_row
    payload :: ir_new_slot(&a, handle_row, IRSlotKind.Param, ir_intern_name(&m, "payload"))
    copied :: ir_copy_value(&m, p, &a, payload, span)
    a.fresh[copied] = false
    ir_emit(&a.f, IROp.Return, -1, copied, -1, -1, a.line)
}

// The cursor walk of the Iter in `source`, whose items have type row `row`.
// With a `stride` slot (`loop x in items, n`) the body runs on every n-th
// item from the first; the items between are still pulled, as step_by pulls
// them.
fn ir_lazy_walk_source(m: &IRModule, p: IRProgram, b: &IRBuilder, label: String?, variable: TLocal, variable_two: TLocal?, source: Int, row: Int, stride: Int, body: [Int], span: Span) Never! {
    pointer_row :: ir_pointer_row(&m)
    word_row :: ir_word_row(&m)
    int_row :: ir_type_row(&m, Type.Int) ?? 0
    cursor_row :: ir_intern_type(&m, "iter_cursor", ir_owned_layout(IRTypeKind.Pointer, Type.Named{name: "IterCursor"}, "jet_rt_native_iter_cursor_drop", ""))
    storage_size :: ir_align8(m.types[row].size)
    has_value :: m.types[row].kind != .Unit
    ir_scope_open(&b)
    one :: ir_word_const(&m, &b, 1)
    zero :: ir_word_const(&m, &b, 0)
    cursor :: ir_lazy_runtime(&m, &b, "jet_rt_native_iter_cursor_init", [Int]{source, one, zero}, cursor_row, source)
    b.fresh[cursor] = false
    &b.bindings.push(IRBinding{name: "", slot: cursor, owned: true})
    index :: ir_word_const(&m, &b, 0)
    countdown :: if stride >= 0 -> ir_word_const(&m, &b, 0) else -> -1
    exit :: ir_open(&b.f, IROp.Block, b.line)
    _ :: ir_open(&b.f, IROp.Loop, b.line)
    present :: ir_runtime(&m, &b, "jet_rt_native_iter_cursor_test", [Int]{cursor}, word_row)
    more :: ir_bool_op(&m, &b, IROp.Ne, present, zero)
    ir_exit_unless(&m, &b, more, exit)
    step_block :: ir_open(&b.f, IROp.Block, b.line)
    ir_scope_open(&b)
    mark :: b.bindings.len()
    &b.loops.push(IRLoopFrame{label: label, exit: exit, next: step_block, mark: mark, guards: b.statement_guards.len()})
    if countdown >= 0 {
        between :: ir_bool_op(&m, &b, IROp.Ne, countdown, zero)
        ir_open_if(&b.f, between, b.line)
        skip :: ir_depth(b.f, step_block)
        ir_emit(&b.f, IROp.Br, -1, skip, -1, -1, b.line)
        ir_end(&b.f, b.line)
        ir_emit(&b.f, IROp.Copy, countdown, stride, -1, -1, b.line)
    }
    item := -1
    owned :: has_value && m.types[row].drop != ""
    if has_value {
        slot :: ir_temp(&m, &b, pointer_row)
        ir_emit(&b.f, IROp.StackAddress, slot, storage_size, 8, -1, b.line)
        _ :: ir_runtime(&m, &b, "jet_rt_native_iter_cursor_value", [Int]{cursor, slot, if owned -> one else -> zero}, -1)
        item = ir_load_at(&m, &b, slot, 0, row)
        b.fresh[item] = false
    }
    if variable_two == .Val(second) {
        position :: ir_new_slot(&b, int_row, IRSlotKind.Local, ir_intern_name(&m, variable.name))
        ir_emit(&b.f, IROp.Copy, position, index, -1, -1, b.line)
        _ :: ir_binder_holds(&m, p, &b, variable, position, span)
        &b.bindings.push(IRBinding{name: variable.name, slot: position})
        if item >= 0 {
            _ :: ir_binder_holds(&m, p, &b, second, item, span)
            &b.bindings.push(IRBinding{name: second.name, slot: item, owned: owned})
            if owned -> ir_close_arm(&m, p, &b, item, false, span)
        }
    } else if item >= 0 {
        _ :: ir_binder_holds(&m, p, &b, variable, item, span)
        &b.bindings.push(IRBinding{name: variable.name, slot: item, owned: owned})
        if owned -> ir_close_arm(&m, p, &b, item, false, span)
    }
    ir_stmts(&m, p, &b, body)
    _ :: &b.loops.pop()
    ir_scope_close(&m, &b)
    ir_end(&b.f, b.line)
    if countdown >= 0 -> ir_emit(&b.f, IROp.Sub, countdown, countdown, one, IR_OVERFLOW_WRAP, b.line)
    _ :: ir_runtime(&m, &b, "jet_rt_native_iter_cursor_advance", [Int]{cursor}, -1)
    ir_emit(&b.f, IROp.Add, index, index, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    ir_scope_close(&m, &b)
}

// ---------------------------------------------------------------------------
// Shared<T> (Transaction.jet): an owned runtime cell handle over the value's
// native slot; a guard is an owned runtime permit whose payload is the cell's
// slot itself.

// `Shared.new(value)` (and a local `Cell.new(value)`, the same native cell):
// the cell takes over an owned copy of the value from its native slot, with
// the element descriptor and the destructor its last release runs: the
// descriptor's drop role, or lazy.retire when the value closes (a Close of
// the value or of a part), so the cell closes its value exactly once, when
// it retires.
fn ir_shared_new(m: &IRModule, p: IRProgram, b: &IRBuilder, inputs: [Int], shared_ty: Type, span: Span) -> Int Never! {
    cell_inner :: ir_local_cell_inner(shared_ty)
    inner :: if ir_untag(shared_ty) == .Shared(value) -> value else if cell_inner == .Val(value) -> value else -> { return ir_fail_slot(&b, span, "Shared.new producing {ir_type_name(shared_ty)}") }
    if inputs.len() != 1 || inputs[0] < 0 -> return ir_fail_slot(&b, span, "Shared.new with {inputs.len()} arguments")
    row :: ir_value_type(&m, p, shared_ty) ?? return ir_type_fail(&b, span, shared_ty)
    value :: inputs[0]
    owned :: if b.fresh[value] -> value else -> ir_copy_value(&m, p, &b, value, span)
    if ir_failed(b) -> return -1
    b.fresh[owned] = false
    slot :: ir_lazy_value_slot(&m, &b, owned)
    meta :: ir_lazy_meta(&m, p, &b, inner, span)
    if meta < 0 -> return -1
    pointer_row :: ir_pointer_row(&m)
    inner_row :: ir_value_type(&m, p, inner) ?? return ir_type_fail(&b, span, inner)
    glue :: ir_close_glue(&m, p, &b, inner_row, false, span)
    if ir_failed(b) -> return -1
    drop := -1
    if glue >= 0 {
        retire :: ir_lazy_helper(&m, p, &b, "retire", inner, span)
        if retire < 0 -> return -1
        drop = ir_lazy_address(&m, &b, retire)
    } else {
        drop = ir_temp(&m, &b, pointer_row)
        ir_emit(&b.f, IROp.Load, drop, meta, 16, -1, b.line)
    }
    ir_runtime(&m, &b, "jet_rt_native_shared_new", [Int]{slot, meta, drop}, row)
}

// `shared.guard_read()` / `shared.guard_edit()`: the runtime takes the lock
// and hands back the permit; the guard's checked read/edit provenance must
// match the method.
fn ir_shared_guard(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, editable: Bool, span: Span) -> Int Never! {
    if ir_shared_guard_editable(ty) != Val((editable)) -> return ir_fail_slot(&b, span, "Shared guard acquisition without its checked read/edit provenance")
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    shared :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || shared < 0 -> return -1
    guard :: ir_runtime(&m, &b, if editable -> "jet_rt_native_shared_guard_edit" else -> "jet_rt_native_shared_guard_read", [Int]{shared}, row)
    ir_release(&m, &b, shared)
    guard
}

// What a `SharedSnapshot<T, U>` is laid out as: a retained handle of the
// cell it was captured from, the committed revision it saw, and the
// captured value.
fn ir_shared_snapshot_carrier(inner: Type, captured: Type) -> Type Never! {
    Type.Tuple{fields: [TypeTupleField]{
        TypeTupleField{name: "owner", ty: Type.Shared{inner: inner}},
        TypeTupleField{name: "revision", ty: Type.IntN{signed: true, bits: 64}},
        TypeTupleField{name: "value", ty: captured},
    }}
}

// The `T` and captured `U` of a `SharedSnapshot<T, U>`.
fn ir_shared_snapshot_args(ty: Type) -> [Type]? Never! {
    if ir_untag(ty) == .Apply(name, args) {
        if name == "SharedSnapshot" && args.len() == 2 -> return Val(args.copy())
    }
    None
}

// `shared.capture()` / `shared.capture(value -> projection)`: under one read
// permit, an owned copy of the value (or the projection's result) paired
// with the committed revision it was read at.
fn ir_shared_capture(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, args: [Int], span: Span) -> Int Never! {
    snapshot_args :: ir_shared_snapshot_args(ty) ?? return ir_fail_slot(&b, span, "Shared capture producing {ir_type_name(ty)}")
    captured_ty :: snapshot_args[1].copy()
    receiver_ty :: ir_ty(p, b, receiver)
    inner :: if ir_untag(receiver_ty) == .Shared(value) -> value else -> { return ir_fail_slot(&b, span, "Shared capture of {ir_type_name(receiver_ty)}") }
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    inner_row :: ir_value_type(&m, p, inner) ?? return ir_type_fail(&b, span, inner)
    captured_row :: ir_value_type(&m, p, captured_ty) ?? return ir_type_fail(&b, span, captured_ty)
    owner :: ir_member_of_row(&m, p, row, "owner") ?? return ir_type_fail(&b, span, ty)
    revision_member :: ir_member_of_row(&m, p, row, "revision") ?? return ir_type_fail(&b, span, ty)
    value_member :: ir_member_of_row(&m, p, row, "value") ?? return ir_type_fail(&b, span, ty)
    shared :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || shared < 0 -> return -1
    closure := -1
    if args.len() == 1 {
        closure = ir_expr(&m, p, &b, args[0])
        if ir_failed(b) || closure < 0 -> return -1
    }
    pointer_row :: ir_pointer_row(&m)
    word_row :: ir_word_row(&m)
    permit :: ir_runtime(&m, &b, "jet_rt_native_shared_guard_read", [Int]{shared}, pointer_row)
    payload :: ir_runtime(&m, &b, "jet_rt_native_shared_read_guard_deref", [Int]{permit}, pointer_row)
    revision :: ir_runtime(&m, &b, "jet_rt_native_shared_guard_revision", [Int]{permit}, word_row)
    view :: ir_load_at(&m, &b, payload, 0, inner_row)
    value := -1
    if closure >= 0 {
        closure_ty :: ir_ty(p, b, args[0])
        value = ir_call_callback(&m, p, &b, closure, closure_ty, [Int]{view}, captured_row, span)
        if ir_failed(b) -> return -1
        value = ir_own(&m, p, &b, value)
    } else if view >= 0 {
        value = ir_copy_value(&m, p, &b, view, span)
    }
    _ :: ir_runtime(&m, &b, "jet_rt_native_shared_read_guard_drop", [Int]{permit}, -1)
    snapshot :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, snapshot, m.types[row].size, 8, -1, b.line)
    handle :: ir_runtime(&m, &b, "jet_rt_native_shared_clone", [Int]{shared}, owner.ty)
    ir_store_at(&m, p, &b, snapshot, owner.offset, handle)
    ir_emit(&b.f, IROp.Store, -1, snapshot, revision_member.offset, revision, b.line)
    if value >= 0 {
        b.fresh[value] = true
        ir_store_at(&m, p, &b, snapshot, value_member.offset, value)
    }
    if closure >= 0 -> ir_release(&m, &b, closure)
    ir_release(&m, &b, shared)
    snapshot
}

// `shared.try_replace(snapshot, value)`: the runtime publishes the value
// only when the snapshot was captured from this cell at its current committed
// revision (jet_rt_native_shared_try_replace); a rejected value is dropped
// here. The snapshot is consumed either way. Exhausted revisions stop in the
// runtime, so the result is always `Ok`.
fn ir_shared_try_replace(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, args: [Int], span: Span) -> Int Never! {
    if args.len() != 2 -> return ir_fail_slot(&b, span, "Shared try_replace with {args.len()} arguments")
    receiver_ty :: ir_ty(p, b, receiver)
    inner :: if ir_untag(receiver_ty) == .Shared(value) -> value else -> { return ir_fail_slot(&b, span, "Shared try_replace on {ir_type_name(receiver_ty)}") }
    inner_row :: ir_value_type(&m, p, inner) ?? return ir_type_fail(&b, span, inner)
    snapshot_ty :: ir_ty(p, b, args[0])
    snapshot_row :: ir_value_type(&m, p, snapshot_ty) ?? return ir_type_fail(&b, span, snapshot_ty)
    owner :: ir_member_of_row(&m, p, snapshot_row, "owner") ?? return ir_type_fail(&b, span, snapshot_ty)
    revision_member :: ir_member_of_row(&m, p, snapshot_row, "revision") ?? return ir_type_fail(&b, span, snapshot_ty)
    shared :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || shared < 0 -> return -1
    taken :: ir_expr(&m, p, &b, args[0])
    if ir_failed(b) || taken < 0 -> return -1
    snapshot :: ir_own(&m, p, &b, taken)
    value :: ir_value_as(&m, p, &b, args[1], inner_row, span)
    if ir_failed(b) -> return -1
    owned :: ir_own(&m, p, &b, value)
    slot :: ir_lazy_value_slot(&m, &b, owned)
    pointer_row :: ir_pointer_row(&m)
    word_row :: ir_word_row(&m)
    cell :: ir_load_at(&m, &b, snapshot, owner.offset, pointer_row)
    revision :: ir_load_at(&m, &b, snapshot, revision_member.offset, word_row)
    published :: ir_runtime(&m, &b, "jet_rt_native_shared_try_replace", [Int]{shared, cell, revision, slot}, word_row)
    zero :: ir_word_const(&m, &b, 0)
    if owned >= 0 && ir_has_drop(m, b, owned) {
        rejected :: ir_bool_op(&m, &b, IROp.Eq, published, zero)
        ir_open_if(&b.f, rejected, b.line)
        ir_emit(&b.f, IROp.Drop, -1, owned, -1, -1, b.line)
        ir_end(&b.f, b.line)
    }
    if owned >= 0 -> b.fresh[owned] = false
    accepted :: ir_bool_op(&m, &b, IROp.Ne, published, zero)
    ir_release(&m, &b, snapshot)
    ir_release(&m, &b, shared)
    ir_result_box(&m, p, &b, ty, true, accepted)
}

// `shared.field` (the SharedAccess.jet desugar to `shared.read` with a
// one-parameter callback; a write through the cell desugars to `shared.edit`): the runtime takes the read lock and runs the
// closure through lazy.callback over the cell's slot; the callback writes its
// owned result into `out`, an inline result straight into its own frame
// storage. A local Cell's `cell.read`/`cell.edit` runs the same over its
// native cell, a Cell guard's `read`/`edit` through `runtime`
// jet_rt_native_cell_guard_with over the value its token lends.
fn ir_shared_read(m: &IRModule, p: IRProgram, b: &IRBuilder, result_ty: Type, receiver: Int, args: [Int], access: String, runtime: String, span: Span) -> Int Never! {
    if args.len() != 1 -> return ir_fail_slot(&b, span, "{access} with {args.len()} arguments")
    closure_ty :: ir_ty(p, b, args[0])
    arity :: if ir_untag(closure_ty) == .Fn(params, _, _, _, _, _) -> params.len() else -> -1
    if arity != 1 -> return ir_fail_slot(&b, span, "{access} callback {ir_type_name(closure_ty)}")
    unit :: ir_unit_type(result_ty) || ir_never_type(result_ty)
    // Sema checks the callback against the read's result but erases that
    // result from a Shared callback's type (SharedAccess.jet
    // sema_shared_access_host_callback_type); lazy.callback stores into `out`
    // only for a callback type with a result, so the helper takes it back.
    write_metadata :: ir_host_write_metadata(p, b, args[0])
    callback_ty := closure_ty
    if ir_untag(closure_ty) == .Fn(fn_params, fn_ret, effect_bound, param_contract, call_metadata, return_view_provenance) {
        callback_ty = Type.Fn{params: fn_params, ret: if unit -> fn_ret else -> Val(result_ty.copy()), effect_bound: effect_bound, param_contract: param_contract, call_metadata: if write_metadata != None -> write_metadata else -> call_metadata, return_view_provenance: return_view_provenance}
    }
    row :: if unit -> -1 else -> ir_value_type(&m, p, result_ty) ?? return ir_type_fail(&b, span, result_ty)
    shared :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || shared < 0 -> return -1
    closure :: ir_expr(&m, p, &b, args[0])
    if ir_failed(b) || closure < 0 -> return -1
    id :: ir_lazy_helper(&m, p, &b, if write_metadata != None -> "callback_write" else -> "callback", callback_ty, span)
    if id < 0 -> return -1
    invoke :: ir_lazy_address(&m, &b, id)
    inline :: row >= 0 && m.types[row].kind == .Aggregate
    result := -1
    out := -1
    if inline {
        result = ir_fresh_temp(&m, &b, row)
        ir_emit(&b.f, IROp.StackAddress, result, ir_align8(m.types[row].size), 8, -1, b.line)
        out = result
    } else {
        out = ir_out_slot(&m, &b, 1)
    }
    _ :: ir_runtime(&m, &b, runtime, [Int]{shared, closure, invoke, out}, -1)
    if row >= 0 && !inline {
        result = ir_load_at(&m, &b, out, 0, row)
        b.fresh[result] = true
    }
    ir_release(&m, &b, shared)
    ir_release(&m, &b, closure)
    result
}

// `a.same(b)` over two `Shared<T>` handles: one cell exactly when the handles
// are equal.
fn ir_shared_same(m: &IRModule, p: IRProgram, b: &IRBuilder, receiver: Int, other: Int, span: Span) -> Int Never! {
    other_ty :: ir_ty(p, b, other)
    other_shared :: if ir_untag(other_ty) == .Shared(_) -> true else -> false
    if !other_shared -> return ir_fail_slot(&b, span, "Shared.same with {ir_type_name(other_ty)}")
    left :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || left < 0 -> return -1
    right :: ir_expr(&m, p, &b, other)
    if ir_failed(b) || right < 0 -> return -1
    same :: ir_bool_op(&m, &b, IROp.Eq, left, right)
    ir_release(&m, &b, left)
    ir_release(&m, &b, right)
    same
}

// `shared.downgrade()` / `shared.strong_count()` over the borrowed cell:
// jet_rt_native_shared_downgrade takes one weak count and hands back the
// cell as the `Shared.Weak<T>`; jet_rt_shared_owner_strong_count answers
// the live strong owners as a native word, made an exact Int.
fn ir_shared_owner_word(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, method: String, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    shared :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || shared < 0 -> return -1
    result := -1
    if method == "downgrade" {
        result = ir_runtime(&m, &b, "jet_rt_native_shared_downgrade", [Int]{shared}, row)
    } else {
        word_row :: ir_word_row(&m)
        count :: ir_runtime(&m, &b, "jet_rt_shared_owner_strong_count", [Int]{shared}, word_row)
        result = ir_runtime(&m, &b, "jet_int_owned_from_i64", [Int]{count}, row)
    }
    ir_release(&m, &b, shared)
    result
}

// `weak.upgrade()`: a new strong owner of the cell while a strong owner
// lives (jet_rt_native_shared_weak_upgrade writes it to `out` and answers
// true), else None.
fn ir_shared_upgrade(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    shared_ty :: if ir_untag(ty) == .Option(inner) -> inner else -> { return ir_fail_slot(&b, span, "Shared.Weak.upgrade producing {ir_type_name(ty)}") }
    shared_row :: ir_value_type(&m, p, shared_ty) ?? return ir_type_fail(&b, span, shared_ty)
    weak :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || weak < 0 -> return -1
    out :: ir_out_slot(&m, &b, 1)
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    live :: ir_runtime(&m, &b, "jet_rt_native_shared_weak_upgrade", [Int]{weak, out}, bool_row)
    result :: ir_temp(&m, &b, row)
    ir_option_none(&m, &b, result)
    ir_open_if(&b.f, live, b.line)
    shared :: ir_load_at(&m, &b, out, 0, shared_row)
    b.fresh[shared] = true
    size :: m.types[shared_row].size
    made :: ir_option_make(&m, p, &b, row, shared, size)
    ir_option_set(&m, &b, result, made)
    ir_end(&b.f, b.line)
    ir_release(&m, &b, weak)
    b.fresh[result] = true
    result
}

// `guard.value`: the permit's payload is the cell's slot, read in place (an
// aggregate is its address); the guard keeps owning it.
fn ir_shared_guard_value(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, guard: Int, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    payload :: ir_shared_guard_payload(&m, p, &b, guard, span)
    if payload < 0 -> return -1
    ir_load_at(&m, &b, payload, 0, row)
}

// The address of the cell's slot a guard lends: an edit permit's through
// jet_rt_native_shared_edit_guard_edit, a read permit's through
// jet_rt_native_shared_read_guard_deref. -1 with `b` failed on an error.
fn ir_shared_guard_payload(m: &IRModule, p: IRProgram, b: &IRBuilder, guard: Int, span: Span) -> Int Never! {
    editable :: ir_shared_guard_editable(ir_ty(p, b, guard)) ?? return ir_fail_slot(&b, span, "Shared guard dereference without its checked read/edit provenance")
    held :: ir_expr(&m, p, &b, guard)
    if ir_failed(b) || held < 0 -> return -1
    pointer_row :: ir_pointer_row(&m)
    payload :: ir_runtime(&m, &b, if editable -> "jet_rt_native_shared_edit_guard_edit" else -> "jet_rt_native_shared_read_guard_deref", [Int]{held}, pointer_row)
    if b.fresh[held] {
        b.fresh[held] = false
        ir_hold_statement_guard(&b, held, -1, true)
    }
    b.fresh[payload] = false
    payload
}

// ---------------------------------------------------------------------------
// The local `Cell<T>` (Sema SharedOwner.jet): a native Shared cell
// (ir_shared_new), aliased by every copy of its handle. Its guards are cell
// guard tokens (JetRuntime Shared.jet jet_rt_native_cell_guard): one Guard40
// permit and the address of the value it lends.

// A cell guard token over the cell `cell` for one access, released by
// ir_cell_access_end as soon as the access is done (never held across a
// callback, so a nested access cannot wait on it).
fn ir_cell_access(m: &IRModule, b: &IRBuilder, cell: Int, editable: Bool) -> Int Never! {
    pointer_row :: ir_pointer_row(&m)
    mode :: ir_word_const(&m, &b, if editable -> 1 else -> 0)
    ir_runtime(&m, &b, "jet_rt_native_cell_guard", [Int]{cell, mode}, pointer_row)
}

fn ir_cell_access_end(m: &IRModule, b: &IRBuilder, token: Int) Never! {
    _ :: ir_runtime(&m, &b, "jet_rt_native_cell_guard_drop", [Int]{token}, -1)
}

// The address of the value the cell guard token `token` lends (borrowed).
fn ir_cell_address(m: &IRModule, b: &IRBuilder, token: Int) -> Int Never! {
    pointer_row :: ir_pointer_row(&m)
    address :: ir_runtime(&m, &b, "jet_rt_native_cell_guard_address", [Int]{token}, pointer_row)
    b.fresh[address] = false
    address
}

// A method of a local Cell, or of a Cell guard when ir_cell_guard_editable
// answers for the receiver.
fn ir_cell_method(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, method: String, args: [Int], span: Span) -> Int Never! {
    receiver_ty :: ir_ty(p, b, receiver)
    guard :: ir_cell_guard_editable(receiver_ty)
    inner :: ir_cell_value_type(receiver_ty) ?? return ir_fail_slot(&b, span, "Cell method {method} of {ir_type_name(receiver_ty)}")
    if guard == None {
        if method == "cell.read" || method == "cell.edit" -> return ir_shared_read(&m, p, &b, ty, receiver, args, method, if method == "cell.edit" -> "jet_rt_native_shared_edit" else -> "jet_rt_native_shared_read", span)
        if (method == "guard_read" || method == "guard_edit") && args.len() == 0 -> return ir_cell_guard(&m, p, &b, ty, receiver, method == "guard_edit", span)
        if method == "get_or_set" && args.len() == 1 -> return ir_cell_get_or_set(&m, p, &b, ty, inner, receiver, args[0], span)
    } else if method == "cell_read_guard.read" || method == "cell_edit_guard.read" || method == "cell_edit_guard.edit" {
        return ir_shared_read(&m, p, &b, ty, receiver, args, method, "jet_rt_native_cell_guard_with", span)
    }
    if method == "get" && args.len() == 0 -> return ir_cell_get(&m, p, &b, ty, receiver, guard != None, span)
    if (method == "set" || method == "replace") && args.len() == 1 && guard != (Val(false)) -> return ir_cell_store(&m, p, &b, inner, receiver, args[0], guard != None, method == "replace", span)
    ir_fail_slot(&b, span, "Cell method {method} of {ir_type_name(receiver_ty)}")
}

// `cell.guard_read()` / `cell.guard_edit()`: an owned guard token.
fn ir_cell_guard(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, editable: Bool, span: Span) -> Int Never! {
    if ir_cell_guard_editable(ty) != (Val(editable)) -> return ir_fail_slot(&b, span, "Cell guard producing {ir_type_name(ty)}")
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    cell :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || cell < 0 -> return -1
    mode :: ir_word_const(&m, &b, if editable -> 1 else -> 0)
    token :: ir_runtime(&m, &b, "jet_rt_native_cell_guard", [Int]{cell, mode}, row)
    ir_release(&m, &b, cell)
    token
}

// `cell.get()` / `guard.get()`: a copy of the value, read under a read
// access of its own (a guard reads under the permit it holds).
fn ir_cell_get(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, guarded: Bool, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    holder :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || holder < 0 -> return -1
    token :: if guarded -> holder else -> ir_cell_access(&m, &b, holder, false)
    address :: ir_cell_address(&m, &b, token)
    value :: ir_load_at(&m, &b, address, 0, row)
    copied :: if value < 0 -> -1 else -> ir_copy_value(&m, p, &b, value, span)
    if !guarded -> ir_cell_access_end(&m, &b, token)
    ir_release(&m, &b, holder)
    copied
}

// `cell.set(value)` / `guard.set(value)` drop the value they overwrite;
// `replace` moves it out to its caller. The value is built before the edit
// access is taken.
fn ir_cell_store(m: &IRModule, p: IRProgram, b: &IRBuilder, inner: Type, receiver: Int, value: Int, guarded: Bool, replace: Bool, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, inner) ?? return ir_type_fail(&b, span, inner)
    value_ty :: ir_ty(p, b, value)
    slot :: ir_value_as(&m, p, &b, value, row, span)
    if ir_failed(b) -> return -1
    holder :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || holder < 0 -> return -1
    token :: if guarded -> holder else -> ir_cell_access(&m, &b, holder, true)
    address :: ir_cell_address(&m, &b, token)
    result := -1
    if replace {
        old :: ir_load_at(&m, &b, address, 0, row)
        if old >= 0 && m.types[row].kind == .Aggregate {
            result = ir_fresh_temp(&m, &b, row)
            ir_emit(&b.f, IROp.StackAddress, result, ir_align8(m.types[row].size), 8, -1, b.line)
            ir_emit(&b.f, IROp.CopyBytes, -1, result, old, m.types[row].size, b.line)
        } else if old >= 0 {
            result = old
            b.fresh[result] = true
        }
        ir_store_at(&m, p, &b, address, 0, slot)
    } else {
        ir_assign_at(&m, p, &b, address, row, None, slot, value_ty, false, span)
    }
    if !guarded -> ir_cell_access_end(&m, &b, token)
    ir_release(&m, &b, holder)
    result
}

// `cell.get_or_set(make)` on a `Cell<T?>`: an absent value is made by the
// callback with no access held (it may read the cell), then stored; the
// result is a copy of the present payload.
fn ir_cell_get_or_set(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, inner: Type, receiver: Int, initializer: Int, span: Span) -> Int Never! {
    option_row :: ir_value_type(&m, p, inner) ?? return ir_type_fail(&b, span, inner)
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    cell :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || cell < 0 -> return -1
    closure :: ir_expr(&m, p, &b, initializer)
    if ir_failed(b) || closure < 0 -> return -1
    probe :: ir_cell_access(&m, &b, cell, false)
    probed :: ir_cell_address(&m, &b, probe)
    current :: ir_load_at(&m, &b, probed, 0, option_row)
    present :: ir_option_is_some(&m, &b, current)
    ir_cell_access_end(&m, &b, probe)
    _ :: ir_open_if(&b.f, present, b.line)
    ir_else(&b.f, b.line)
    made_value :: ir_call_closure(&m, &b, closure, [Int]{}, row)
    payload_size :: m.types[row].size
    made :: ir_option_make(&m, p, &b, option_row, made_value, payload_size)
    editor :: ir_cell_access(&m, &b, cell, true)
    edited :: ir_cell_address(&m, &b, editor)
    ir_assign_at(&m, p, &b, edited, option_row, None, made, inner, false, span)
    ir_cell_access_end(&m, &b, editor)
    ir_end(&b.f, b.line)
    reader :: ir_cell_access(&m, &b, cell, false)
    filled_address :: ir_cell_address(&m, &b, reader)
    filled :: ir_load_at(&m, &b, filled_address, 0, option_row)
    payload :: ir_option_payload(&m, &b, filled, row)
    result :: ir_copy_value(&m, p, &b, payload, span)
    ir_cell_access_end(&m, &b, reader)
    ir_release(&m, &b, closure)
    ir_release(&m, &b, cell)
    result
}

// `guard.map(path)` / `guard.split(left, right)` (THostCall.CellGuardProject):
// a new token per field path, each lending the field's address under the
// receiver's one permit (jet_rt_native_cell_guard_project); `split` pairs
// two. The receiver's own token releases here, the permit with the last
// projection.
fn ir_cell_guard_project(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, paths: [[String]], span: Span) -> Int Never! {
    receiver_ty :: ir_ty(p, b, receiver)
    inner :: ir_cell_value_type(receiver_ty) ?? return ir_fail_slot(&b, span, "Cell guard projection of {ir_type_name(receiver_ty)}")
    inner_row :: ir_value_type(&m, p, inner) ?? return ir_type_fail(&b, span, inner)
    guard_rows := [Int]{}
    members := [IRMember]{}
    if paths.len() == 1 {
        guard_row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
        &guard_rows.push(guard_row)
    } else if ir_untag(ty) == .Tuple(fields) {
        members = ir_tuple_members(&m, p, fields) ?? return ir_type_fail(&b, span, ty)
        loop member in members -> &guard_rows.push(member.ty)
    }
    if guard_rows.len() != paths.len() -> return ir_fail_slot(&b, span, "Cell guard projection of {paths.len()} paths producing {ir_type_name(ty)}")
    token :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || token < 0 -> return -1
    pointer_row :: ir_pointer_row(&m)
    projected := [Int]{}
    loop (index, path) in paths {
        address := ir_cell_address(&m, &b, token)
        row := inner_row
        loop name in path {
            member :: ir_member_of_row(&m, p, row, name) ?? return ir_fail_slot(&b, span, "Cell guard projection .{name} of {ir_type_name(m.types[row].ty)}")
            if member.boxed -> return ir_fail_slot(&b, span, "Cell guard projection .{name} through a recursive edge of {ir_type_name(m.types[row].ty)}")
            next :: ir_temp(&m, &b, pointer_row)
            ir_emit(&b.f, IROp.Offset, next, address, member.offset, -1, b.line)
            address = next
            row = member.ty
        }
        &projected.push(ir_runtime(&m, &b, "jet_rt_native_cell_guard_project", [Int]{token, address}, guard_rows[index]))
    }
    ir_release(&m, &b, token)
    if paths.len() == 1 -> return projected[0]
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    storage :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
    loop (index, slot) in projected -> ir_store_at(&m, p, &b, storage, members[index].offset, slot)
    storage
}
