use jet_foundation.[name_rows_value]

// Whether the debugger may run a breakpoint's condition in the program
// itself, at the breakpoint, rather than stopping the program to evaluate
// it at each hit (JetDebug NativePlace.jet). The debugger places the
// condition's function and every function it calls or drops through
// afresh, next to the program's code, and the runtime's routines that
// build, render, compare and drop text afresh from the runtime pack. It
// sends their allocations to a scratch arena of their own, emptied at each
// hit, and each of their other runtime calls back to it, which then
// evaluates that hit as before. So what the condition may not do is what
// that code does inline, read here from the functions as built: write
// memory other than its own stack or a block it allocated (a Store,
// StreamStore or CopyBytes through any other address), take a reference
// (the inline retain), change an atomic in place, copy or drop a String it
// did not make, run an `#FFI(asm)` template, or call a function value,
// whose code it can't place. A release is left to it: with no retain, a
// release gives up only a block the code allocated itself, in the arena,
// whose free goes back to the arena. The stop polls are placed too, and
// their routine is a runtime call.

// Why the expression function `row` of `m` can't run in the program, "" when
// it can: the first thing it, or a function it calls, does inline that the
// program would see.
ir_eval_place_refusal: fn(m: IRModule, row: Int) -> String Never! {
    seen := [Int:Bool]{}
    pending := [Int]{row}
    loop pending.len() > 0 {
        id: pending.pop() ?? -1
        if id < 0 || id >= m.functions.len() || seen.has_key(id) -> next
        seen[id] = true
        f: m.functions[id]
        if ir_stop_key(f.key) -> next
        place: if id == row -> "" else -> " (in `{f.name}`)"
        if f.asm != None -> return "it runs the `#FFI(asm)` function `{f.name}`"
        own: ir_eval_place_own(m, f, false)
        made: ir_eval_place_own(m, f, true)
        loop at in 0..<f.op.len() {
            if f.op[at] == {
                .Store | .StreamStore | .CopyBytes -> {
                    address: f.a[at]
                    if address < 0 || address >= own.len() || !own[address] {
                        return "it writes memory it did not take on its own stack or allocate{place}"
                    }
                }
                .CallIndirect -> return "it calls a function value{place}"
                .Call -> pending.push(f.a[at])
                .CallRuntime -> {
                    symbol: if f.a[at] >= 0 && f.a[at] < m.names.len() -> m.names[f.a[at]] else -> ""
                    if ir_x64_inline_atomic(m, f, at) != "" -> return "it uses an atomic{place}"
                    if symbol == "jet_rt_block_retain" -> return "it takes a reference{place}"
                }
                .Copy | .Drop -> {
                    slot: f.a[at]
                    if slot >= 0 && slot < f.slot_type.len() && f.slot_type[slot] >= 0 && f.slot_type[slot] < m.types.len() {
                        ty: m.types[f.slot_type[slot]]
                        if ty.kind == .String && ty.drop != "" && !made[slot] {
                            return "it copies or drops a String it did not make{place}"
                        }
                        // A drop routine the module builds (a List's, a
                        // box's) is placed and called as a function is.
                        if f.op[at] == .Drop && ty.drop != "" {
                            if name_rows_value(m.function_rows, ty.drop) == .Val(glue) {
                                pending.push(glue)
                            }
                        }
                    }
                }
                .Nop | .Const | .ConstText | .ConstBigInt | .Move | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .FunctionAddress | .DataAddress | .Load | .StackAddress | .Offset | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig -> {}
            }
        }
    }
    ""
}

// The runtime routines that allocate, which the debugger sends to the
// placed code's arena.
IR_EVAL_PLACE_ALLOCS: [String]{"jet_rt_alloc", "jet_rt_alloc_value"}

// Which slots of `f` (of `m`) only ever hold an address on its own stack or
// in a block it allocated: each write of one is a StackAddress, a call of an
// allocating routine (IR_EVAL_PLACE_ALLOCS), or an Offset, Copy or Move of
// such a slot. With `text`, which only ever hold text the code made: each
// write of one is a ConstText (static text, which a copy or drop leaves
// be), a runtime call's result (text a routine placed with the code made
// in the arena; a call of any other calls out before it returns), or a
// Copy or Move of such a slot. Each slot written starts as one, and loses
// it at a write that isn't.
ir_eval_place_own: fn(m: IRModule, f: IRFunction, text: Bool) -> [Bool] Never! {
    count: f.slot_type.len()
    own := loop _ in 0..<count -> false
    loop at in 0..<f.op.len() {
        if f.dst[at] >= 0 && f.dst[at] < count -> own[f.dst[at]] = true
    }
    loop slot in 0..<count {
        if slot < f.slot_kind.len() && f.slot_kind[slot] == IRSlotKind.Param -> own[slot] = false
    }
    changed := true
    loop changed {
        changed = false
        loop at in 0..<f.op.len() {
            dst: f.dst[at]
            if dst < 0 || dst >= count || !own[dst] -> next
            source: f.a[at]
            op: f.op[at]
            moved: op == IROp.Copy || op == IROp.Move || (!text && op == IROp.Offset)
            made: if text -> op == IROp.ConstText || op == IROp.CallRuntime else -> op == IROp.StackAddress || (op == IROp.CallRuntime && source >= 0 && source < m.names.len() && IR_EVAL_PLACE_ALLOCS.contains(m.names[source]))
            kept: made || (moved && source >= 0 && source < count && own[source])
            if !kept {
                own[dst] = false
                changed = true
            }
        }
    }
    own
}
