// Drops at last use: on every level, compile-time code
// included, a String's Drop moves back to just after the last instruction
// that reads or writes the String, so its memory goes back before the code
// that follows runs. ir_drop_early runs on the module just before selection,
// ahead of ir_tail_calls; at O0 each body's Drops move in the one pass over
// the bodies after its inline Int facts and IR Lint (Opt.jet
// ir_opt_o0_bodies) instead.
//
// A String is memory only: its Drop frees bytes and nothing can observe when.
// Close values, #MustFinish values, guards, task handles and defers are never
// Strings, so they keep scope-end timing and last-first order.
//
// A Drop moves back over the instructions of its own block:
//   - plain instructions that do not touch the String;
//   - constructs that do not touch it and do not branch or return;
//   - stop polls (on a stop, a stop poll's If drops what is live, then
//     returns or leaves an inlined body).
// It stops at the String's previous reference, or at a branch, a return or
// the start of its block. When that reference is followed by its stop poll,
// the Drop goes after the poll instead. Each stop poll it moves over no longer
// drops the String, because by then the String is already gone. The moved Drop
// takes the line of that last reference, so the line table shows where the
// String is freed.
//
// A String keeps its Drops where they were built if any instruction might
// leave a pointer into it:
//   - a Copy, Move, Store, Return, Load, Offset or CopyBytes of it;
//   - an indirect call;
//   - a result that is not a plain value (a raw address, String data, a view).
// So a String whose address `mem.address_of` or a string-data leaf takes
// lives until its block ends.
use jet_foundation.[CompilerThreads, Type, compiler_threads_joined, compiler_threads_partition]

// One function's moved Drops: per Drop the slot, the instruction it now goes
// before and its line; and per instruction whether it goes (a moved Drop at
// its old place, or a stop poll's Drop of a String already dropped).
IRDropPlan: struct {
    slots: [Int],
    to: [Int],
    lines: [Int],
    kill: [Bool],
}

// Planning and moving a function's Drops costs about this much per IR
// instruction on one thread (timed as x64 selection admission's costs are).
IR_DROP_EARLY_NS_PER_INSTRUCTION: 30

// Each function's plan and rewrite read only its own body and the module's
// types and names, so the functions split into consecutive parts
// (compiler_threads_partition by size), one thread each, as many as x64
// selection admission (ir_x64_admit) gives the module's instructions at
// IR_DROP_EARLY_NS_PER_INSTRUCTION. Every thread reads the module's other
// rows, which none writes, and owns its part; the parts come back in order,
// so every body is the same for any thread count. A module whose bodies
// already dropped early (IRModule.dropped_early) stays as it is.
ir_drop_early: fn(m: ^IRModule, threads: CompilerThreads) Never! {
    if m.dropped_early {
        return
    }
    m.dropped_early = true
    poll: ir_keyed_function(m, IR_STOP_POLL_KEY) ?? -1
    trap: ir_keyed_function(m, IR_STOP_TRAP_KEY) ?? -1
    turn: ir_keyed_function(m, IR_STOP_TURN_KEY) ?? -1
    count: m.functions.len()
    ^weights: [Int]{}
    ^total: 0
    loop f in m.functions {
        weights.push(1 + f.op.len())
        total += 1 + f.op.len()
    }
    workers: ir_x64_admit(threads, count, total, IR_DROP_EARLY_NS_PER_INSTRUCTION)
    if workers <= 1 {
        loop id in 0..<count {
            if m.functions[id].asm != None -> next
            plan: ir_drop_plan(m, m.functions[id], poll, trap, turn)
            if plan.slots.len() > 0 -> ir_drop_apply(m.functions[id], plan)
        }
        return
    }
    bounds: compiler_threads_partition(weights, workers)
    ^built: ir_drop_plan_ranges(m, bounds, poll, trap, turn, 0)
    loop part in built.move() {
        loop item in part.move() {
            m.functions[item.id].op = item.code.op.move()
            m.functions[item.id].dst = item.code.dst.move()
            m.functions[item.id].a = item.code.a.move()
            m.functions[item.id].b = item.code.b.move()
            m.functions[item.id].c = item.code.c.move()
            m.functions[item.id].code_line = item.code.line.move()
        }
    }
}

IRDropBuilt: struct {
    id: Int,
    code: IROptCode,
}

ir_drop_plan_range: fn(m: IRModule, start: Int, end: Int, poll: Int, trap: Int, turn: Int) -> [IRDropBuilt] Never! {
    ^built: [IRDropBuilt]{}
    loop id in start..<end {
        if m.functions[id].asm != None -> next
        ^plan: ir_drop_plan(m, m.functions[id], poll, trap, turn)
        if plan.slots.len() > 0 {
            built.push(IRDropBuilt{id: id, code: ir_drop_build_code(m.functions[id], plan)})
        }
    }
    built
}

ir_drop_plan_ranges: fn(m: IRModule, bounds: [Int], poll: Int, trap: Int, turn: Int, at: Int) -> [[IRDropBuilt]] Never! {
    ^done: [[IRDropBuilt]]{}
    last: bounds.len() - 2
    if at > last -> return done
    if at == last {
        done.push(ir_drop_plan_range(m, bounds[at], bounds[at + 1], poll, trap, turn))
        return done
    }
    task.group ir_drop_early_group {
        head: task ir_drop_plan_range(m, bounds[at], bounds[at + 1], poll, trap, turn)
        rest: ir_drop_plan_ranges(m, bounds, poll, trap, turn, at + 1)
        done.push(compiler_threads_joined(head))
        loop rows in rest.move() -> done.push(rows)
    }
    done
}

ir_drop_plan: fn(m: IRModule, f: IRFunction, poll: Int, trap: Int, turn: Int) -> IRDropPlan Never! {
    n: f.op.len()
    ^plan: IRDropPlan{slots: [Int]{}, to: [Int]{}, lines: [Int]{}, kill: [Bool]{}}
    count: f.slot_type.len()
    ^has_string_drop: false
    loop at in 0..<n {
        if f.op[at] == .Drop {
            slot: f.a[at]
            if slot >= 0 && slot < count {
                type_row: f.slot_type[slot]
                if m.types[type_row].kind == .String && m.types[type_row].drop != "" {
                    has_string_drop = true
                    break
                }
            }
        }
    }
    if !has_string_drop -> return plan
    // Per instruction: the If of the stop poll holding it, -1 for none.
    ^stop: [Int]{}
    loop _ in 0..<n -> stop.push(-1)
    loop at in 0..<n {
        if f.op[at] != .If || stop[at] >= 0 || !ir_drop_stop_edge(m, f, at, poll, trap, turn) {
            next
        }
        loop inner in at..<(f.c[at] + 1) -> stop[inner] = at
    }
    ^eligible: [Bool]{}
    ^dropped: [Bool]{}
    loop slot in 0..<count {
        type_row: f.slot_type[slot]
        eligible.push(m.types[type_row].kind == .String && m.types[type_row].drop != "")
        dropped.push(false)
    }
    ^reads: [Int]{}
    ^any: false
    loop at in 0..<n {
        if stop[at] >= 0 -> next
        if f.op[at] == .Drop {
            slot: f.a[at]
            if slot >= 0 && slot < count && eligible[slot] {
                dropped[slot] = true
                any = true
            }
            next
        }
        ir_x64_reads_into(f, at, reads)
        loop slot in reads {
            if slot < 0 || slot >= count || !eligible[slot] -> next
            if !ir_drop_borrows_only(m, f, at) -> eligible[slot] = false
        }
    }
    if !any -> return plan
    // Per slot that may move, its references outside stop polls, in order.
    ^refs: [[Int]]{}
    loop _ in 0..<count -> refs.push([Int]{})
    loop at in 0..<n {
        if stop[at] >= 0 -> next
        ir_x64_reads_into(f, at, reads)
        loop slot in reads {
            if slot >= 0 && slot < count && eligible[slot] && dropped[slot] -> refs[slot].push(at)
        }
        written: ir_x64_write(f, at)
        if written >= 0 && written < count && eligible[written] && dropped[written] {
            refs[written].push(at)
        }
    }
    // Per construct opener: whether the construct branches or returns
    // (outside its stop polls).
    ^blocked: [Bool]{}
    loop _ in 0..<n -> blocked.push(false)
    ^open: [Int]{}
    loop at in 0..<n {
        if f.op[at] == {
            .Block | .Loop | .If -> { open.push(at) }
            .End -> { _: open.pop() }
            .Br | .BrIf | .Return | .Unreachable -> {
                if stop[at] < 0 {
                    loop opener in open -> blocked[opener] = true
                }
            }
            .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Else | .Sqrt | .IntBig | .StreamStore -> {}
        }
    }
    loop _ in 0..<n -> plan.kill.push(false)
    loop at in 0..<n {
        if f.op[at] != .Drop || stop[at] >= 0 -> next
        slot: f.a[at]
        if slot < 0 || slot >= count || !eligible[slot] -> next
        ^previous: -1
        loop reference in refs[slot] {
            if reference < at -> previous = reference
        }
        reached: ir_drop_target(f, stop, blocked, previous, at)
        // After the stop poll of the last reference, not between them.
        ^to: reached
        if to < at && f.op[to] == .Call && (f.a[to] == poll || f.a[to] == trap || f.a[to] == turn) && to + 1 < n && stop[to + 1] == to + 1 {
            to = f.c[to + 1] + 1
        }
        if to >= at -> next
        plan.slots.push(slot)
        plan.to.push(to)
        plan.lines.push(if previous >= 0 && reached == previous + 1 -> f.code_line[previous] else -> f.code_line[at])
        plan.kill[at] = true
        loop inner in to..<at {
            if stop[inner] >= 0 && f.op[inner] == .Drop && f.a[inner] == slot {
                plan.kill[inner] = true
            }
        }
    }
    plan
}

// Whether instruction `at`, reading a String, leaves nothing pointing into
// it: it is not a Copy, Move, Store, StreamStore, Return, Load, Offset,
// CopyBytes or indirect call, and its result is nothing, a plain value or a
// new String.
ir_drop_borrows_only: fn(m: IRModule, f: IRFunction, at: Int) -> Bool Never! {
    if f.op[at] == {
        .Copy | .Move | .Store | .StreamStore | .Return | .Load | .Offset | .CopyBytes | .CallIndirect -> return false
        .Concat -> return true
        .Nop | .Const | .ConstText | .ConstBigInt | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Call | .CallRuntime | .FunctionAddress | .DataAddress | .StackAddress | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Unreachable | .Sqrt | .IntBig -> {}
    }
    dst: f.dst[at]
    if dst < 0 -> return true
    if m.types[f.slot_type[dst]].kind == {
        .Unit | .Bool | .Int | .Float | .Float32 | .Char -> true
        .Word | .String | .Pointer | .Aggregate -> false
    }
}

// Whether the If at `opener` is a stop poll's edge:
//   - it follows `call s <- poll`;
//   - it holds only Drops (inside the runtime cleanup scope when it has any)
//     and Moves of words (a Loop's own slot handed back before a Br out of
//     it, OptSplit.jet), which touch no String;
//   - it leaves by a Return of nothing, or by a Br when an inlined call's
//     poll leaves the inlined body.
ir_drop_stop_edge: fn(m: IRModule, f: IRFunction, opener: Int, poll: Int, trap: Int, turn: Int) -> Bool Never! {
    if opener < 1 || f.b[opener] >= 0 -> return false
    check: opener - 1
    if f.op[check] != .Call || (f.a[check] != poll && f.a[check] != trap && f.a[check] != turn) || f.dst[check] != f.a[opener] {
        return false
    }
    end: f.c[opener]
    if end - 1 <= opener -> return false
    last: end - 1
    if f.op[last] != .Br && (f.op[last] != .Return || f.a[last] >= 0) -> return false
    loop at in (opener + 1)..<last {
        if f.op[at] == .Drop -> next
        if f.op[at] == .CallRuntime && (m.names[f.a[at]] == "jet_rt_cleanup_enter" || m.names[f.a[at]] == "jet_rt_cleanup_leave") {
            next
        }
        if f.op[at] == .Move && ir_drop_word(m, f, f.dst[at]) && ir_drop_word(m, f, f.a[at]) -> next
        return false
    }
    true
}

// Whether `slot` holds a word (a Bool, an Int, a Word or a Pointer).
ir_drop_word: fn(m: IRModule, f: IRFunction, slot: Int) -> Bool Never! {
    if slot < 0 || slot >= f.slot_type.len() -> return false
    if m.types[f.slot_type[slot]].kind == {
        .Bool | .Int | .Word | .Pointer -> true
        .Unit | .Float | .Float32 | .Char | .String | .Aggregate -> false
    }
}

// Where the Drop at `at` can go: the instruction it can go before, moving
// back over its block's instructions after `previous` (its slot's last
// reference before it) that are not branches, returns or openers, and over
// stop polls and constructs that neither branch nor hold `previous`.
ir_drop_target: fn(f: IRFunction, stop: [Int], blocked: [Bool], previous: Int, at: Int) -> Int Never! {
    ^back: at - 1
    loop back > previous {
        if f.op[back] == {
            .End -> {
                opener: f.a[back]
                if stop[back] < 0 && (blocked[opener] || opener <= previous) -> return back + 1
                back = opener - 1
            }
            .Block | .Loop | .If | .Else | .Br | .BrIf | .Return | .Unreachable -> return back + 1
            .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Sqrt | .IntBig | .StreamStore -> back -= 1
        }
    }
    back + 1
}

// Rewrites `f` by `plan`: each moved Drop goes before its new instruction,
// and every instruction the plan kills goes.
ir_drop_apply: fn(f: ^IRFunction, plan: IRDropPlan) Never! {
    ^code: ir_drop_build_code(f, plan)
    f.op = code.op.move()
    f.dst = code.dst.move()
    f.a = code.a.move()
    f.b = code.b.move()
    f.c = code.c.move()
    f.code_line = code.line.move()
}

// Single-pass DropEarly rewrite + Nop removal + structural link repair, safe
// to run read-only on worker threads.
ir_drop_build_code: fn(f: IRFunction, plan: IRDropPlan) -> IROptCode Never! {
    n: f.op.len()
    // Per instruction the moved Drops before it, chained.
    ^head: [Int]{}
    head.try_reserve(n) ?? ()
    loop _ in 0..<n -> head.push(-1)
    ^chain: [Int]{}
    chain.try_reserve(plan.to.len()) ?? ()
    loop k in 0..<plan.to.len() {
        chain.push(head[plan.to[k]])
        head[plan.to[k]] = k
    }
    ^code: IROptCode{op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, line: [Int]{}}
    ^open: [I64]{}
    loop at in 0..<n {
        ^k: head[at]
        loop k >= 0 {
            ir_opt_code_put(code, .Drop, -1, plan.slots[k], -1, -1, plan.lines[k])
            k = chain[k]
        }
        if plan.kill[at] -> next
        op: f.op[at]
        if op == .Nop -> next
        kept: code.op.len()
        ir_opt_code_put(code, op, f.dst[at], f.a[at], f.b[at], f.c[at], f.code_line[at])
        if op == .Block || op == .Loop -> open.push(I64{kept}) else if op == .If {
            code.b[kept] = -1
            open.push(I64{kept})
        } else if op == .Else { code.b[Int{open[open.len() - 1]}] = kept } else if op == .End {
            opener: Int{ir_construct_closed(open)}
            code.a[kept] = opener
            if code.op[opener] == .If {
                code.c[opener] = kept
                if code.b[opener] >= 0 -> code.a[code.b[opener]] = kept
            } else { code.a[opener] = kept }
        }
    }
    code
}

// Reusable per-worker scratch for zero-allocation O0 early-drop planning.
IRDropScratch: struct {
    stop: [Int],
    eligible: [Bool],
    dropped: [Bool],
    last_ref: [Int],
    reads: [Int],
    blocked: [Bool],
    open: [Int],
    kill: [Bool],
    slots: [Int],
    to: [Int],
    lines: [Int],
    head: [Int],
    chain: [Int],
    has_moves: Bool,
    // Upper bound on the frame bytes O0 emission adds past the slot homes:
    // StackAddress storage and aggregate call results (ir_drop_frame_bytes).
    frame_bytes: Int,
}

ir_drop_scratch_new: fn() -> IRDropScratch Never! {
    IRDropScratch{
        stop: [Int]{},
        eligible: [Bool]{},
        dropped: [Bool]{},
        last_ref: [Int]{},
        reads: [Int]{},
        blocked: [Bool]{},
        open: [Int]{},
        kill: [Bool]{},
        slots: [Int]{},
        to: [Int]{},
        lines: [Int]{},
        head: [Int]{},
        chain: [Int]{},
        has_moves: false,
        frame_bytes: 0,
    }
}

// The most frame bytes O0 emission (X64Patch.jet) adds at instruction `at`
// past the slot homes: a StackAddress's aligned storage, or the aligned
// result storage of a call whose result is an aggregate.
#Inline(Always) ir_drop_frame_bytes: fn(fast: IRX64FastModule, f: IRFunction, at: Int, op: IROp) -> Int Never! {
    if op == .StackAddress -> return ir_x64_storage_size(f, at) + 16
    if op != .Call && op != .CallIndirect && op != .CallRuntime -> return 0
    dst: f.dst[at]
    if dst < 0 -> return 0
    row: f.slot_type[dst]
    if fast.type_kind[row] != O0_KIND_AGGREGATE -> return 0
    fast.type_size[row] + 24
}

// Zero-allocation early-drop planner using flat reusable worker scratch `s`.
// Produces bit-for-bit identical move lists (`slots`, `to`, `lines`, `kill`)
// to `ir_drop_plan`, and also accumulates `s.frame_bytes` during its
// initial O(N) scan so O0 codegen needs no separate pre-pass for stack checks.
ir_drop_plan_into: fn(s: ^IRDropScratch, m: IRModule, fast: IRX64FastModule, f: IRFunction, poll: Int, trap: Int, turn: Int) Never! {
    n: f.op.len()
    count: f.slot_type.len()
    s.has_moves = false
    s.frame_bytes = 0
    ^has_string_drop: false
    loop at in 0..<n {
        op: f.op[at]
        if op == .Drop {
            slot: f.a[at]
            if slot >= 0 && slot < count && fast.type_is_str_drop[f.slot_type[slot]] {
                has_string_drop = true
            }
        } else { s.frame_bytes += ir_drop_frame_bytes(fast, f, at, op) }
    }
    if !has_string_drop {
        return
    }
    if s.stop.len() < n {
        s.stop.try_reserve(n) ?? ()
        s.blocked.try_reserve(n) ?? ()
        s.kill.try_reserve(n) ?? ()
        s.head.try_reserve(n) ?? ()
        loop s.stop.len() < n {
            s.stop.push(-1)
            s.blocked.push(false)
            s.kill.push(false)
            s.head.push(-1)
        }
    }
    if s.eligible.len() < count {
        s.eligible.try_reserve(count) ?? ()
        s.dropped.try_reserve(count) ?? ()
        s.last_ref.try_reserve(count) ?? ()
        loop s.eligible.len() < count {
            s.eligible.push(false)
            s.dropped.push(false)
            s.last_ref.push(-1)
        }
    }
    loop i in 0..<n {
        s.stop[i] = -1
        s.blocked[i] = false
        s.kill[i] = false
    }
    loop at in 0..<n {
        if f.op[at] != .If || s.stop[at] >= 0 || !ir_drop_stop_edge(m, f, at, poll, trap, turn) {
            next
        }
        loop inner in at..<(f.c[at] + 1) -> s.stop[inner] = at
    }
    loop slot in 0..<count {
        s.eligible[slot] = fast.type_is_str_drop[f.slot_type[slot]]
        s.dropped[slot] = false
        s.last_ref[slot] = -1
    }
    if s.open.len() > 0 -> s.open.clear()
    ^any: false
    loop at in 0..<n {
        op: f.op[at]
        if op == .Block || op == .Loop || op == .If -> s.open.push(at) else if op == .End {
            _: s.open.pop()
        } else if op == .Br || op == .BrIf || op == .Return || op == .Unreachable {
            if s.stop[at] < 0 {
                loop opener in s.open -> s.blocked[opener] = true
            }
        }
        if s.stop[at] >= 0 -> next
        if op == .Drop {
            slot: f.a[at]
            if slot >= 0 && slot < count && s.eligible[slot] {
                s.dropped[slot] = true
                any = true
            }
            next
        }
        ir_x64_reads_into(f, at, s.reads)
        loop slot in s.reads {
            if slot < 0 || slot >= count || !s.eligible[slot] -> next
            if !ir_drop_borrows_only(m, f, at) -> s.eligible[slot] = false
        }
    }
    if !any {
        return
    }
    if s.slots.len() > 0 -> s.slots.clear()
    if s.to.len() > 0 -> s.to.clear()
    if s.lines.len() > 0 -> s.lines.clear()
    if s.chain.len() > 0 -> s.chain.clear()
    loop at in 0..<n {
        if s.stop[at] >= 0 -> next
        op: f.op[at]
        if op == .Drop {
            slot: f.a[at]
            if slot >= 0 && slot < count && s.eligible[slot] {
                previous: s.last_ref[slot]
                reached: ir_drop_target(f, s.stop, s.blocked, previous, at)
                ^to: reached
                if to < at && f.op[to] == .Call && (f.a[to] == poll || f.a[to] == trap || f.a[to] == turn) && to + 1 < n && s.stop[to + 1] == to + 1 {
                    to = f.c[to + 1] + 1
                }
                if to < at {
                    s.slots.push(slot)
                    s.to.push(to)
                    s.lines.push(if previous >= 0 && reached == previous + 1 -> f.code_line[previous] else -> f.code_line[at])
                    s.kill[at] = true
                    loop inner in to..<at {
                        if s.stop[inner] >= 0 && f.op[inner] == .Drop && f.a[inner] == slot {
                            s.kill[inner] = true
                        }
                    }
                }
                if s.dropped[slot] -> s.last_ref[slot] = at
            }
            next
        }
        ir_x64_reads_into(f, at, s.reads)
        loop slot in s.reads {
            if slot >= 0 && slot < count && s.eligible[slot] && s.dropped[slot] {
                s.last_ref[slot] = at
            }
        }
        written: ir_x64_write(f, at)
        if written >= 0 && written < count && s.eligible[written] && s.dropped[written] {
            s.last_ref[written] = at
        }
    }
    if s.slots.len() == 0 {
        return
    }
    s.has_moves = true
    loop i in 0..<n -> s.head[i] = -1
    loop k in 0..<s.to.len() {
        target: s.to[k]
        s.chain.push(s.head[target])
        s.head[target] = k
    }
}

#Test("ir_drop_plan_into matches ir_drop_plan including multi-drop slots") {
    ^m: ir_module_new()
    str_row: ir_scalar_type_row(m, Type.String)
    m.types[str_row].drop = "jet_rt_string_drop"
    i64_row: ir_scalar_type_row(m, Type.IntN{signed: true, bits: 64})
    ^f: ir_function_new("multi_drop", "test:drop.multi", "", "drop.jet", 1)
    s0: ir_slot(f, str_row, IRSlotKind.Local, ir_intern_name(m, "s0"), 1)
    x: ir_slot(f, i64_row, IRSlotKind.Local, ir_intern_name(m, "x"), 2)
    t1: ir_slot(f, i64_row, IRSlotKind.Temp, -1, 0)
    ^_: ir_emit(f, IROp.ConstText, s0, 0, -1, -1, 1)
    ^_: ir_emit(f, IROp.Const, x, 1, -1, -1, 2)
    ^_: ir_emit(f, IROp.Add, t1, x, x, IR_OVERFLOW_WRAP, 3)
    ^_: ir_emit(f, IROp.Drop, -1, s0, -1, -1, 4)
    ^_: ir_emit(f, IROp.ConstText, s0, 0, -1, -1, 5)
    ^_: ir_emit(f, IROp.Add, x, t1, x, IR_OVERFLOW_WRAP, 6)
    ^_: ir_emit(f, IROp.Add, t1, x, x, IR_OVERFLOW_WRAP, 7)
    ^_: ir_emit(f, IROp.Drop, -1, s0, -1, -1, 8)
    ^_: ir_emit(f, IROp.Return, -1, -1, -1, -1, 9)
    ^flags: [Bool]{}
    loop t in m.types -> flags.push(t.kind == .String && t.drop != "")
    expected: ir_drop_plan(m, f, -1, -1, -1)
    fast: ir_x64_fast_module_new(m, false)
    assert_eq(fast.type_is_str_drop, flags)
    ^scratch: ir_drop_scratch_new()
    ir_drop_plan_into(scratch, m, fast, f, -1, -1, -1)
    assert(scratch.has_moves)
    assert_eq(scratch.slots, expected.slots)
    assert_eq(scratch.to, expected.to)
    assert_eq(scratch.lines, expected.lines)
    loop i in 0..<f.op.len() -> assert_eq(scratch.kill[i], expected.kill[i])
}
