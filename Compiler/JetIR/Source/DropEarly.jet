// Drops at last use (D-DROP-ASAP1): on every level, compile-time code
// included, a String's Drop moves back to just after the last instruction
// that reads or writes the String, so its memory goes back before the code
// that follows runs. ir_drop_early runs on the module just before selection,
// ahead of ir_tail_calls.
//
// A String is memory only: its Drop frees bytes and nothing can observe when.
// Close values, #MustFinish values, guards, task handles and defers are never
// Strings, so they keep scope-end timing and last-first order.
//
// A Drop moves back over the instructions of its own block:
//   - plain instructions that do not touch the String;
//   - constructs that do not touch it and do not branch or return;
//   - stop polls (on a stop, a stop poll's If drops what is live, then
//     returns or leaves an inlined body).
// It stops at the String's previous reference, or at a branch, a return or
// the start of its block. When that reference is followed by its stop poll,
// the Drop goes after the poll instead. Each stop poll it moves over no longer
// drops the String, because by then the String is already gone. The moved Drop
// takes the line of that last reference, so the line table shows where the
// String is freed.
//
// A String keeps its Drops where they were built if any instruction might
// leave a pointer into it:
//   - a Copy, Move, Store, Return, Load, Offset or CopyBytes of it;
//   - an indirect call;
//   - a result that is not a plain value (a raw address, String data, a view).
// So a String whose address `mem.address_of` or a string-data leaf takes
// lives until its block ends.

use jet_foundation.[name_rows_value]

// One function's moved Drops: per Drop the slot, the instruction it now goes
// before and its line; and per instruction whether it goes (a moved Drop at
// its old place, or a stop poll's Drop of a String already dropped).
struct IRDropPlan {
    slots: [Int]
    to: [Int]
    lines: [Int]
    kill: [Bool]
}

fn ir_drop_early(m: &IRModule) Never! {
    poll :: name_rows_value(m.function_rows, IR_STOP_POLL_KEY) ?? -1
    trap :: name_rows_value(m.function_rows, IR_STOP_TRAP_KEY) ?? -1
    loop id in 0..<m.functions.len() {
        if m.functions[id].asm != None -> next
        plan :: ir_drop_plan(m, m.functions[id], poll, trap)
        if plan.slots.len() > 0 -> ir_drop_apply(&m.functions[id], plan)
    }
}

fn ir_drop_plan(m: IRModule, f: IRFunction, poll: Int, trap: Int) -> IRDropPlan Never! {
    n :: f.op.len()
    plan := IRDropPlan{slots: [Int]{}, to: [Int]{}, lines: [Int]{}, kill: [Bool]{}}
    // Per instruction: the If of the stop poll holding it, -1 for none.
    stop := [Int]{}
    loop _ in 0..<n -> &stop.push(-1)
    found := false
    loop at in 0..<n {
        if f.op[at] == .Drop -> found = true
        if f.op[at] != .If || stop[at] >= 0 || !ir_drop_stop_edge(m, f, at, poll, trap) -> next
        loop inner in at..<(f.c[at] + 1) -> stop[inner] = at
    }
    if !found -> return plan
    count :: f.slot_type.len()
    eligible := [Bool]{}
    dropped := [Bool]{}
    loop slot in 0..<count {
        row :: m.types[f.slot_type[slot]]
        &eligible.push(row.kind == .String && row.drop != "")
        &dropped.push(false)
    }
    reads := [Int]{}
    any := false
    loop at in 0..<n {
        if stop[at] >= 0 -> next
        if f.op[at] == .Drop {
            slot :: f.a[at]
            if slot >= 0 && slot < count && eligible[slot] {
                dropped[slot] = true
                any = true
            }
            next
        }
        ir_x64_reads_into(f, at, &reads)
        loop slot in reads {
            if slot < 0 || slot >= count || !eligible[slot] -> next
            if !ir_drop_borrows_only(m, f, at) -> eligible[slot] = false
        }
    }
    if !any -> return plan
    // Per slot that may move, its references outside stop polls, in order.
    refs := [[Int]]{}
    loop _ in 0..<count -> &refs.push([Int]{})
    loop at in 0..<n {
        if stop[at] >= 0 -> next
        ir_x64_reads_into(f, at, &reads)
        loop slot in reads {
            if slot >= 0 && slot < count && eligible[slot] && dropped[slot] -> &refs[slot].push(at)
        }
        written :: ir_x64_write(f, at)
        if written >= 0 && written < count && eligible[written] && dropped[written] -> &refs[written].push(at)
    }
    // Per construct opener: whether the construct branches or returns
    // (outside its stop polls).
    blocked := [Bool]{}
    loop _ in 0..<n -> &blocked.push(false)
    open := [Int]{}
    loop at in 0..<n {
        if f.op[at] == {
            .Block | .Loop | .If -> &open.push(at)
            .End -> {
                _ :: &open.pop()
            }
            .Br | .BrIf | .Return | .Unreachable -> {
                if stop[at] < 0 {
                    loop opener in open -> blocked[opener] = true
                }
            }
            else -> {}
        }
    }
    loop _ in 0..<n -> &plan.kill.push(false)
    loop at in 0..<n {
        if f.op[at] != .Drop || stop[at] >= 0 -> next
        slot :: f.a[at]
        if slot < 0 || slot >= count || !eligible[slot] -> next
        previous := -1
        loop reference in refs[slot] {
            if reference < at -> previous = reference
        }
        reached :: ir_drop_target(f, stop, blocked, previous, at)
        // After the stop poll of the last reference, not between them.
        to := reached
        if to < at && f.op[to] == .Call && (f.a[to] == poll || f.a[to] == trap) && to + 1 < n && stop[to + 1] == to + 1 -> to = f.c[to + 1] + 1
        if to >= at -> next
        &plan.slots.push(slot)
        &plan.to.push(to)
        &plan.lines.push(if previous >= 0 && reached == previous + 1 -> f.code_line[previous] else -> f.code_line[at])
        plan.kill[at] = true
        loop inner in to..<at {
            if stop[inner] >= 0 && f.op[inner] == .Drop && f.a[inner] == slot -> plan.kill[inner] = true
        }
    }
    plan
}

// Whether instruction `at`, reading a String, leaves nothing pointing into
// it: it is not a Copy, Move, Store, Return, Load, Offset, CopyBytes or
// indirect call, and its result is nothing, a plain value or a new String.
fn ir_drop_borrows_only(m: IRModule, f: IRFunction, at: Int) -> Bool Never! {
    if f.op[at] == {
        .Copy | .Move | .Store | .Return | .Load | .Offset | .CopyBytes | .CallIndirect -> return false
        .Concat -> return true
        else -> {}
    }
    dst :: f.dst[at]
    if dst < 0 -> return true
    if m.types[f.slot_type[dst]].kind == {
        .Unit | .Bool | .Int | .Float | .Float32 | .Char -> true
        else -> false
    }
}

// Whether the If at `opener` is a stop poll's edge:
//   - it follows `call s <- poll`;
//   - it holds only Drops (inside the runtime cleanup scope when it has any)
//     and Moves of words (a Loop's own slot handed back before a Br out of
//     it, OptSplit.jet), which touch no String;
//   - it leaves by a Return of nothing, or by a Br when an inlined call's
//     poll leaves the inlined body.
fn ir_drop_stop_edge(m: IRModule, f: IRFunction, opener: Int, poll: Int, trap: Int) -> Bool Never! {
    if opener < 1 || f.b[opener] >= 0 -> return false
    check :: opener - 1
    if f.op[check] != .Call || (f.a[check] != poll && f.a[check] != trap) || f.dst[check] != f.a[opener] -> return false
    end :: f.c[opener]
    if end - 1 <= opener -> return false
    last :: end - 1
    if f.op[last] != .Br && (f.op[last] != .Return || f.a[last] >= 0) -> return false
    loop at in (opener + 1)..<last {
        if f.op[at] == .Drop -> next
        if f.op[at] == .CallRuntime && (m.names[f.a[at]] == "jet_rt_cleanup_enter" || m.names[f.a[at]] == "jet_rt_cleanup_leave") -> next
        if f.op[at] == .Move && ir_drop_word(m, f, f.dst[at]) && ir_drop_word(m, f, f.a[at]) -> next
        return false
    }
    true
}

// Whether `slot` holds a word (a Bool, an Int, a Word or a Pointer).
fn ir_drop_word(m: IRModule, f: IRFunction, slot: Int) -> Bool Never! {
    if slot < 0 || slot >= f.slot_type.len() -> return false
    if m.types[f.slot_type[slot]].kind == {
        .Bool | .Int | .Word | .Pointer -> true
        else -> false
    }
}

// Where the Drop at `at` can go: the instruction it can go before, moving
// back over its block's instructions after `previous` (its slot's last
// reference before it) that are not branches, returns or openers, and over
// stop polls and constructs that neither branch nor hold `previous`.
fn ir_drop_target(f: IRFunction, stop: [Int], blocked: [Bool], previous: Int, at: Int) -> Int Never! {
    back := at - 1
    loop back > previous {
        if f.op[back] == {
            .End -> {
                opener :: f.a[back]
                if stop[back] < 0 && (blocked[opener] || opener <= previous) -> return back + 1
                back = opener - 1
            }
            .Block | .Loop | .If | .Else | .Br | .BrIf | .Return | .Unreachable -> return back + 1
            else -> back -= 1
        }
    }
    back + 1
}

// Rewrites `f` by `plan`: each moved Drop goes before its new instruction,
// and every instruction the plan kills goes.
fn ir_drop_apply(f: &IRFunction, plan: IRDropPlan) Never! {
    n :: f.op.len()
    // Per instruction the moved Drops before it, chained.
    head := [Int]{}
    loop _ in 0..<n -> &head.push(-1)
    chain := [Int]{}
    loop k in 0..<plan.to.len() {
        &chain.push(head[plan.to[k]])
        head[plan.to[k]] = k
    }
    code := IROptCode{op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, line: [Int]{}}
    loop at in 0..<n {
        k := head[at]
        loop k >= 0 {
            ir_opt_code_put(&code, .Drop, -1, plan.slots[k], -1, -1, plan.lines[k])
            k = chain[k]
        }
        if !plan.kill[at] -> ir_opt_code_put(&code, f.op[at], f.dst[at], f.a[at], f.b[at], f.c[at], f.code_line[at])
    }
    f.op = ^code.op
    f.dst = ^code.dst
    f.a = ^code.a
    f.b = ^code.b
    f.c = ^code.c
    f.code_line = ^code.line
    ir_opt_compact(&f)
}
