// Inlining (O1, O2): bottom-up over the call graph (Opt.jet
// ir_opt_bottom_up), so a callee is cloned in its final, already simplified
// form and wrapper chains collapse into their callers. A direct Call is
// replaced by the callee's body when the callee is not recursive, its cost
// (ir_opt_inline_cost) is at most the level's callee limit and the caller's
// budget still covers it, the caller's real growth (ir_opt_size) stays
// within the level's cap, it never writes a parameter, it reveals no fixed
// value (IRFunction.slot_fixed) to a call whose result is public, it is not
// a last-owner routine (BuildOwn.jet IR_LAST_OWNER: one shared copy the drop
// sites call), it doesn't read `context.trace` (the trace names the
// reading function's own frame, on every tier), and its stops name the
// caller's source file (selection
// reports a stop at the function's file, so a callee whose arithmetic can
// stop is inlined only into its own file). At O2
// a callee with one direct call site in the module is inlined there up to a
// larger limit, outside the budget: its body then sees the caller's
// arguments (constants, ranges), and the copy adds at most its own size.
//
// The body sits in a Block of its own. Parameters read the call's argument
// slots (a parameter the body writes takes its argument into a slot of its
// own first); every other callee slot is a
// new slot of the caller. `return v` becomes a move of v into the call's
// result slot (an aggregate result: fresh frame storage and a copy of its
// bytes, as the call's result storage) and a Br out of that Block. Lines of
// a callee from another file become the call's line. The body's code lines
// name the inline site it came from (IRFunction.inline_sites, which also
// keeps the call's line), so a reader of the IR (the emission check's
// declassified verdicts) still finds it after the Block goes: a mark that
// changes no pass's view of the code. The debug info makes each site an
// inlined frame (X64Select.jet ir_x64_inline_ranges, Dwarf.jet).
//
// The stop point the call left after itself (`stopped := poll(); if
// stopped { E }`, past the call's drops) tests only what the call reported
// (X64Select.jet ir_x64_stop_point). A quiet body (ir_opt_inline_quiet)
// reports none, so that stop point goes with the call: the inlined loop
// body is the one the direct spelling builds, and the loop's own turn poll
// stays at its head rather than folding into the leftover one
// (OptStops.jet ir_opt_fold_polls). A glue's call made from a Drop
// (OptGlue.jet ir_opt_glue_site) left no stop point: the poll after it is
// that of the call or construct before the Drop, and stays.
//
// A callee marked `#Inline(Always)` (IRFunction.inline_always) is inlined
// before every other pass, on every tier (O0, O1, O2 and a compile-time
// batch) and under every `inline` value (ir_opt_inline_marked_module), at
// every call site, with no size limit and no budget. It may write a
// parameter, and its stops may lie in another file: they report at the
// call's line. The mark is a guarantee, not a hint. Sema refuses a mark
// that can't keep it: a marked function that calls itself or another marked
// function calling back (E0917), is taken as a value (E0918), is too large
// (E0919), reveals a fixed value with `#Scrub` (E1016), reads
// `context.trace` (E1017) or has a foreign body (E1021: `#FFI(c)`,
// `#FFI(asm)` or `#Import(c)`). An asm leaf, a host provider and a
// last-owner routine are the compiler's own and never marked. A marked call
// left after this pass is a compiler bug: IR Lint's `call.marked` rule
// (Lint.jet) stops the build. Under `inline: always_marked` or `off`
// (IROptInline.Marked) the bottom-up walk takes no other callee.
//
// Each site taken is one IROptReport.inlines row with the reason it was
// taken; `jet inspect choices` lists them as its inlining choices.
use jet_foundation.[CompilerThreads, Type, compiler_threads_admit, compiler_threads_joined, compiler_threads_partition, compiler_threads_single, compiler_transfer_rows, name_column_set]

IR_OPT_INLINE_CALLEE_O1: 40

IR_OPT_INLINE_BUDGET_O1: 200

IR_OPT_INLINE_CALLEE_O2: 60

IR_OPT_INLINE_BUDGET_O2: 400

// The real instructions (ir_opt_size) the budgeted inlines may add to one
// caller, half again the budget: cold arms cost nothing against the budget,
// but their copies still grow the code.
IR_OPT_INLINE_GROWTH_O1: 300

IR_OPT_INLINE_GROWTH_O2: 600

// A once-called callee (O2), and the caller size past which none is taken.
IR_OPT_INLINE_ONCE_O2: 1500

IR_OPT_INLINE_ONCE_CALLER_O2: 3000

// The size limit of a marked callee: none.
IR_OPT_INLINE_MARKED: 1000000000

// One call site inlining took (IROptReport.inlines): the caller's source file
// and the call's line, the caller, the callee, and why the site was taken.
IROptInlined: struct {
    file: String,
    line: Int,
    caller: String,
    callee: String,
    reason: String,
}

// `caller`'s body with its selected call sites inlined, None when it selects
// none. `bodies[g]` holds function g's final body (one row), or no row when
// g's size is past ir_opt_inline_reach (it is never inlined); the caller's
// own row and the rows of recursive functions are never read. `sites[g]`
// counts the direct calls of g in the module; `once_called` takes the
// once-called ones (O2). `inline` says which callees are taken: Auto by
// size, Marked every `#Inline(Always)` one past the size limits and nothing
// else (ir_opt_inline_marked_module).
ir_opt_inline_build: fn(m: IRModule, bodies: [[IRFunction]], caller: IRFunction, recursive: [Bool], sites: [Int], once_called: Bool, level: Int, inline: IROptInline, report: ^IROptReport) -> IRFunction? Never! {
    limit: if level >= 2 -> IR_OPT_INLINE_CALLEE_O2 else -> IR_OPT_INLINE_CALLEE_O1
    ^budget: if level >= 2 -> IR_OPT_INLINE_BUDGET_O2 else -> IR_OPT_INLINE_BUDGET_O1
    ^growth: if level >= 2 -> IR_OPT_INLINE_GROWTH_O2 else -> IR_OPT_INLINE_GROWTH_O1
    ^grown: ir_opt_size(caller)
    ^selected_sites: [Bool]{}
    ^any: false
    loop at in 0..<caller.op.len() {
        ^selected: false
        ^reason: ""
        if inline == .Marked {
            selected = caller.op[at] == .Call && ir_opt_inline_marked(bodies, caller.a[at]) && ir_opt_inline_size(m, bodies, caller, at, recursive, IR_OPT_INLINE_MARKED) >= 0
            if selected -> reason = "marked #Inline(Always)"
        } else {
            once: once_called && caller.op[at] == .Call && caller.a[at] >= 0 && caller.a[at] < sites.len() && sites[caller.a[at]] == 1
            cost: if caller.op[at] != .Call -> -1 else if once -> ir_opt_inline_size(m, bodies, caller, at, recursive, IR_OPT_INLINE_ONCE_O2) else -> ir_opt_inline_size(m, bodies, caller, at, recursive, limit)
            size: if cost >= 0 -> ir_opt_size(bodies[caller.a[at]][0]) else -> 0
            if cost >= 0 && once && cost > limit {
                selected = grown + size <= IR_OPT_INLINE_ONCE_CALLER_O2
                if selected {
                    reason = "its only call, size {size} within the once-called limit {IR_OPT_INLINE_ONCE_O2}"
                }
            } else if cost >= 0 {
                selected = cost <= budget && size <= growth
                if selected {
                    reason = "cost {cost} within the O{level} limit {limit}, the caller's remaining budget {budget} and its growth {growth}"
                    budget -= cost
                    growth -= size
                }
            }
            if selected -> grown += size
        }
        // A selected site is spliced below: its row goes to the report now.
        if selected {
            any = true
            report.inlines.push(IROptInlined{file: caller.source_file.copy(), line: ir_code_line_source(caller.code_line[at]), caller: caller.name.copy(), callee: bodies[caller.a[at]][0].name.copy(), reason: reason.move()})
        }
        selected_sites.push(selected)
    }
    if !any -> return None
    ^out: ir_function_new(caller.name, caller.key, caller.symbol, caller.source_file, caller.line)
    out.inline_always = caller.inline_always
    out.symbol_hash = caller.symbol_hash
    out.cold = caller.cold
    out.host_symbol = caller.host_symbol.copy()
    out.frame_bound = caller.frame_bound
    out.max_depth = caller.max_depth
    out.stack_check = caller.stack_check
    out.inline_sites = caller.inline_sites.copy()
    // The rows are shared, not copied: no pass writes them.
    out.call_sites = caller.call_sites
    loop slot in 0..<caller.slot_type.len() {
        ^_: ir_slot(out, caller.slot_type[slot], caller.slot_kind[slot], caller.slot_name[slot], caller.slot_line[slot])
        out.slot_site[slot] = caller.slot_site[slot]
        out.slot_formal[slot] = caller.slot_formal[slot]
    }
    out.slot_fixed = caller.slot_fixed.copy()
    out.result = caller.result
    loop value in caller.args -> out.args.push(value)
    loop value in caller.binds -> out.binds.push(value)
    loop value in caller.scattered -> out.scattered.push(value)
    poll: ir_interned_name(m, IR_STOP_POLL_KEY) ?? -2
    // The stop point after a quiet site goes (its poll through its If's End).
    ^skip_from: -1
    ^skip_to: -1
    loop at in 0..<caller.op.len() {
        if at >= skip_from && at <= skip_to -> next
        if selected_sites[at] {
            ir_opt_splice(m, out, caller, at, bodies[caller.a[at]][0])
            report.inlined_calls += 1
            ^after: at + 1
            loop after < caller.op.len() && caller.op[after] == .Drop -> after += 1
            callee: caller.a[at]
            if ir_opt_stops_any_poll(caller, poll, poll, after) && ir_opt_inline_quiet(m, bodies[callee][0]) && !ir_opt_glue_site(m, caller, bodies[callee][0].key, at) {
                skip_from = after
                skip_to = caller.c[after + 1]
            }
        } else {
            ^_: ir_emit(out, caller.op[at], caller.dst[at], caller.a[at], caller.b[at], caller.c[at], caller.code_line[at])
        }
    }
    ir_opt_compact(out)
    Val(out)
}

// The cost (ir_opt_inline_cost) of the callee of the Call at `at` when it
// may be inlined there, else -1. An asm leaf's code is its template, never
// IR to inline; a host provider leaf (IR.jet IR_HOST_PROVIDER) or a runtime
// provider hook (IRFunction.host_symbol) stays a call its host or program
// can replace. A marked callee also takes a body that writes a
// parameter (ir_opt_splice gives it a slot of its own), an argument or
// result of another type row of the same layout, and a stop in another
// file (the stop reports at the call's line).
ir_opt_inline_size: fn(m: IRModule, bodies: [[IRFunction]], caller: IRFunction, at: Int, recursive: [Bool], limit: Int) -> Int Never! {
    callee_id: caller.a[at]
    if callee_id < 0 || callee_id >= bodies.len() || recursive[callee_id] || bodies[callee_id].len() == 0 {
        return -1
    }
    callee: bodies[callee_id][0]
    if callee.asm != None -> return -1
    if callee.host_symbol != "" -> return -1
    // A last-owner routine stays one shared copy (BuildOwn.jet IR_LAST_OWNER).
    if callee.name == IR_LAST_OWNER && callee.source_file == "" -> return -1
    if caller.c[at] != callee.param_count -> return -1
    if caller.dst[at] >= 0 && (callee.result < 0 || !ir_opt_inline_rows_fit(m, callee, caller.slot_type[caller.dst[at]], callee.result)) {
        return -1
    }
    // A callee holding a fixed value (IRFunction.slot_fixed) whose result
    // the call does not hold as fixed reveals it (a `#Scrub` routine):
    // inlined, IR Lint's fixed rule would follow the value on past it.
    if caller.dst[at] >= 0 && !caller.slot_fixed[caller.dst[at]] && ir_timing_marked(callee) {
        return -1
    }
    // A parameter becomes the call's argument slot: same type rows only,
    // unless the callee is marked.
    loop slot in 0..<callee.param_count {
        if !ir_opt_inline_rows_fit(m, callee, caller.slot_type[caller.args[caller.b[at] + slot]], callee.slot_type[slot]) {
            return -1
        }
    }
    cost: ir_opt_inline_cost(m, callee)
    if cost > limit -> return -1
    loop k in 0..<callee.op.len() {
        written: ir_x64_write(callee, k)
        if written >= 0 && written < callee.param_count && !callee.inline_always -> return -1
        if callee.source_file != caller.source_file && !callee.inline_always && ir_opt_located(m, callee, k) {
            return -1
        }
        if ir_opt_calls_route(m, callee, k, "jet_rt_context_trace") -> return -1
    }
    cost
}

// Whether a value of type row `row` may stand for one of row `wanted` in
// an inlined body of `callee`: the same row, or for a marked callee a row
// of the same layout (the same kind, and for a word or an aggregate the
// same size), as a call's argument and result may be.
ir_opt_inline_rows_fit: fn(m: IRModule, callee: IRFunction, row: Int, wanted: Int) -> Bool Never! {
    if row == wanted -> return true
    if !callee.inline_always || m.types[row].kind != m.types[wanted].kind -> return false
    kind: m.types[row].kind
    (kind != .Word && kind != .Aggregate) || m.types[row].size == m.types[wanted].size
}

// The size inlining weighs: `f`'s instructions that do something
// (ir_opt_size), less those in its cold arms, each of which counts as its
// one If. A cold arm is the arm of an If with no Else that either ends in
// Unreachable (a failed bounds check, unwrap or assertion, a panic: control
// never comes back from it, and selection lays it out after the epilogue)
// or tests what the stop poll or trap just before it returned (the stop
// edge's cleanup and return). Every inlined copy carries these arms, but no
// pass through the code runs them, so a small checked helper costs what its
// hot path does. ir_opt_inline_build caps the real growth they add.
ir_opt_inline_cost: fn(m: IRModule, f: IRFunction) -> Int Never! {
    poll: ir_interned_name(m, IR_STOP_POLL_KEY) ?? -2
    trap: ir_interned_name(m, IR_STOP_TRAP_KEY) ?? -2
    turn: ir_interned_name(m, IR_STOP_TURN_KEY) ?? -2
    ^cost: 0
    ^at: 0
    loop at < f.op.len() {
        if f.op[at] != .Nop && f.op[at] != .End -> cost += 1
        cold: f.op[at] == .If && f.b[at] < 0 && f.c[at] > at + 1 && (f.op[f.c[at] - 1] == .Unreachable || (at > 0 && f.op[at - 1] == .Call && (f.a[at - 1] == poll || f.a[at - 1] == trap || f.a[at - 1] == turn) && f.dst[at - 1] >= 0 && f.a[at] == f.dst[at - 1]))
        at = if cold -> f.c[at] + 1 else -> at + 1
    }
    cost
}

// The largest ir_opt_inline_cost of `callee` that ir_opt_inline_build may
// inline at one of its call sites: the once-called limit for a callee
// called once (`once_called`, O2), else the level's callee limit. Under
// `inline` Marked the bottom-up walk inlines none (-1): the marked callees
// are already in (ir_opt_inline_marked_module).
ir_opt_inline_reach: fn(sites: [Int], callee: Int, once_called: Bool, level: Int, inline: IROptInline) -> Int Never! {
    if inline == .Marked -> return -1
    if once_called && callee >= 0 && callee < sites.len() && sites[callee] == 1 {
        return IR_OPT_INLINE_ONCE_O2
    }
    if level >= 2 -> IR_OPT_INLINE_CALLEE_O2 else -> IR_OPT_INLINE_CALLEE_O1
}

// Whether function `callee` has a body here and is marked `#Inline(Always)`.
ir_opt_inline_marked: fn(bodies: [[IRFunction]], callee: Int) -> Bool Never! {
    callee >= 0 && callee < bodies.len() && bodies[callee].len() > 0 && bodies[callee][0].inline_always
}

// Every direct call of an `#Inline(Always)` callee in `m` replaced by the
// callee's body (ir_opt_inline_build, `marked`), before every other pass on
// every tier. A marked callee is done before each function that calls it
// (a depth-first walk of the marked calls), so the copy it lends holds no
// marked call of its own; then every unmarked function that calls one. A
// marked callee its own marked calls reach again is recursive and stays a
// call (sema refuses such a cycle, E0917). Each site taken is one row of
// `report`. The module is marked done (IRModule.marked_inlined): a second
// run leaves it as it is, and IR Lint holds it to no marked call left.
ir_opt_inline_marked_module: fn(m: ^IRModule, report: ^IROptReport, threads: CompilerThreads{compiler_threads_single()}) Never! {
    if m.marked_inlined {
        return
    }
    m.marked_inlined = true
    count: m.functions.len()
    ^marked: [Bool]{}
    marked.try_reserve(count) ?? ()
    ^marked_ids: [Int]{}
    ^weights: [Int]{}
    weights.try_reserve(count) ?? ()
    ^total: 0
    loop (id, f) in m.functions {
        marked.push(f.inline_always)
        if f.inline_always -> marked_ids.push(id)
        w: 1 + f.op.len()
        weights.push(w)
        total += w
    }
    if marked_ids.len() == 0 {
        return
    }
    // Only marked callees are ever read from `bodies` under IROptInline.Marked.
    ^bodies: [[IRFunction]]{}
    bodies.try_reserve(count) ?? ()
    loop _ in 0..<count -> bodies.push([IRFunction]{})
    loop id in marked_ids -> bodies[id].push(m.functions[id])
    ^view: ir_opt_view(m, [String]{})
    ^state: [Int]{}
    ^recursive: [Bool]{}
    state.try_reserve(count) ?? ()
    recursive.try_reserve(count) ?? ()
    loop _ in 0..<count {
        state.push(0)
        recursive.push(false)
    }
    ^marked_order: [Int]{}
    loop id in marked_ids {
        if state[id] == 0 {
            ir_opt_inline_marked_walk(bodies, marked, id, state, recursive, marked_order)
        }
    }
    loop id in marked_order {
        if !ir_opt_inline_marked_calls(bodies[id][0], marked) -> next
        body: bodies[id].pop() ?? panic("the IR optimizer has no body for function {id}")
        out: ir_opt_inline_build(view, bodies, body, recursive, [Int]{}, false, 0, IROptInline.Marked, report) ?? body.move()
        bodies[id].push(out)
        m.functions[id] = bodies[id][0]
    }
    // Find unmarked callers that directly call any marked callee, in parallel
    // when the module admits threads, reading m.functions in place.
    workers: compiler_threads_admit(threads, count, total, IR_OPT_MIN_INSTRUCTIONS_PER_THREAD, 0, 0)
    ^callers: [Int]{}
    if workers <= 1 {
        loop id in 0..<count {
            if !marked[id] && ir_opt_inline_marked_calls(m.functions[id], marked) {
                callers.push(id)
            }
        }
    } else {
        bounds: compiler_threads_partition(weights, workers)
        found_parts: ir_opt_marked_find_ranges(m.functions, marked, bounds, 0)
        loop part in found_parts {
            loop id in part -> callers.push(id)
        }
    }
    if callers.len() == 0 {
        ir_opt_unview(m, view)
        return
    }
    if workers <= 1 || callers.len() < 32 {
        loop id in callers {
            if ir_opt_inline_build(view, bodies, m.functions[id], recursive, [Int]{}, false, 0, IROptInline.Marked, report) == .Val(out) {
                m.functions[id] = out.move()
            }
        }
    } else {
        ^caller_weights: [Int]{}
        caller_weights.try_reserve(callers.len()) ?? ()
        loop id in callers -> caller_weights.push(weights[id])
        cworkers: if workers > callers.len() -> callers.len() else -> workers
        cbounds: compiler_threads_partition(caller_weights, cworkers)
        ^rebuilt_parts: ir_opt_marked_build_ranges(view, bodies, m.functions, callers, recursive, cbounds, 0)
        loop part in rebuilt_parts.move() {
            loop item in part.move() {
                if item.body == .Val(out) -> m.functions[item.id] = out.move()
                report.inlined_calls += item.inlined_calls
                loop row in item.inlines.move() -> report.inlines.push(row)
            }
        }
    }
    ir_opt_unview(m, view)
}

IROptMarkedRebuilt: struct {
    id: Int,
    body: IRFunction?,
    inlines: [IROptInlined],
    inlined_calls: Int,
}

ir_opt_marked_find_range: fn(functions: [IRFunction], marked: [Bool], start: Int, end: Int) -> [Int] Never! {
    ^found: [Int]{}
    loop id in start..<end {
        if !marked[id] && ir_opt_inline_marked_calls(functions[id], marked) -> found.push(id)
    }
    found
}

ir_opt_marked_find_ranges: fn(functions: [IRFunction], marked: [Bool], bounds: [Int], at: Int) -> [[Int]] Never! {
    ^done: [[Int]]{}
    last: bounds.len() - 2
    if at > last -> return done
    if at == last {
        done.push(ir_opt_marked_find_range(functions, marked, bounds[at], bounds[at + 1]))
        return done
    }
    task.group ir_opt_marked_find_group {
        head: task ir_opt_marked_find_range(functions, marked, bounds[at], bounds[at + 1])
        rest: ir_opt_marked_find_ranges(functions, marked, bounds, at + 1)
        done.push(compiler_threads_joined(head))
        loop rows in rest.move() -> done.push(rows)
    }
    done
}

ir_opt_marked_build_range: fn(view: IRModule, bodies: [[IRFunction]], functions: [IRFunction], callers: [Int], recursive: [Bool], start: Int, end: Int) -> [IROptMarkedRebuilt] Never! {
    ^built: [IROptMarkedRebuilt]{}
    built.try_reserve(end - start) ?? ()
    loop at in start..<end {
        id: callers[at]
        ^local: ir_opt_report(0)
        out: ir_opt_inline_build(view, bodies, functions[id], recursive, [Int]{}, false, 0, IROptInline.Marked, local)
        built.push(IROptMarkedRebuilt{id: id, body: out, inlines: local.inlines.move(), inlined_calls: local.inlined_calls})
    }
    built
}

ir_opt_marked_build_ranges: fn(view: IRModule, bodies: [[IRFunction]], functions: [IRFunction], callers: [Int], recursive: [Bool], bounds: [Int], at: Int) -> [[IROptMarkedRebuilt]] Never! {
    ^done: [[IROptMarkedRebuilt]]{}
    last: bounds.len() - 2
    if at > last -> return done
    if at == last {
        done.push(ir_opt_marked_build_range(view, bodies, functions, callers, recursive, bounds[at], bounds[at + 1]))
        return done
    }
    task.group ir_opt_marked_build_group {
        head: task ir_opt_marked_build_range(view, bodies, functions, callers, recursive, bounds[at], bounds[at + 1])
        rest: ir_opt_marked_build_ranges(view, bodies, functions, callers, recursive, bounds, at + 1)
        done.push(compiler_threads_joined(head))
        loop rows in rest.move() -> done.push(rows)
    }
    done
}

// Per name row of `m`, whether any function calls it via CallRuntime, scanned
// in parallel over consecutive function ranges.
ir_opt_runtime_called: fn(m: IRModule, threads: CompilerThreads) -> [Bool] Never! {
    name_count: m.names.len()
    fn_count: m.functions.len()
    ^weights: [Int]{}
    weights.try_reserve(fn_count) ?? ()
    ^total: 0
    loop f in m.functions {
        w: 1 + f.op.len()
        weights.push(w)
        total += w
    }
    workers: compiler_threads_admit(threads, fn_count, total, IR_OPT_MIN_INSTRUCTIONS_PER_THREAD, 0, 0)
    if workers <= 1 -> return ir_opt_runtime_called_range(m.functions, 0, fn_count, name_count)
    bounds: compiler_threads_partition(weights, workers)
    parts: ir_opt_runtime_called_ranges(m.functions, bounds, name_count, 0)
    ^called: [Bool]{}
    called.try_reserve(name_count) ?? ()
    loop _ in 0..<name_count -> called.push(false)
    loop part in parts {
        loop (row, hit) in part {
            if hit -> called[row] = true
        }
    }
    called
}

ir_opt_runtime_called_range: fn(functions: [IRFunction], start: Int, end: Int, name_count: Int) -> [Bool] Never! {
    ^called: [Bool]{}
    called.try_reserve(name_count) ?? ()
    loop _ in 0..<name_count -> called.push(false)
    loop index in start..<end {
        f: functions[index]
        loop (at, op) in f.op {
            if op == .CallRuntime -> called[f.a[at]] = true
        }
    }
    called
}

ir_opt_runtime_called_ranges: fn(functions: [IRFunction], bounds: [Int], name_count: Int, at: Int) -> [[Bool]] Never! {
    ^done: [[Bool]]{}
    last: bounds.len() - 2
    if at > last -> return done
    if at == last {
        done.push(ir_opt_runtime_called_range(functions, bounds[at], bounds[at + 1], name_count))
        return done
    }
    task.group ir_opt_runtime_called_group {
        head: task ir_opt_runtime_called_range(functions, bounds[at], bounds[at + 1], name_count)
        rest: ir_opt_runtime_called_ranges(functions, bounds, name_count, at + 1)
        done.push(compiler_threads_joined(head))
        loop rows in rest.move() -> done.push(rows)
    }
    done
}

// The census of the marked calls left in `m`: each Call whose callee is
// `#Inline(Always)`. Once ir_opt_inline_marked_module ran it is 0 on every
// tier (only a cycle of marked calls keeps one, and sema refuses the cycle,
// E0917); `jet build`, `jet run` and `jet test` trace it as the counter
// `ir.opt.marked_calls` (JetCLI Host.jet jet_cli_native_program).
ir_opt_marked_calls: fn(m: IRModule) -> Int Never! {
    fn_count: m.functions.len()
    ^marked: [Bool]{}
    marked.try_reserve(fn_count) ?? ()
    ^any: false
    loop f in m.functions {
        marked.push(f.inline_always)
        if f.inline_always -> any = true
    }
    if !any -> return 0
    ^count: 0
    loop f in m.functions {
        loop (at, code) in f.op {
            if code != .Call -> next
            callee: f.a[at]
            if callee >= 0 && callee < fn_count && marked[callee] -> count += 1
        }
    }
    count
}

// Marked function `id` and the marked callees it reaches, each after the
// ones it calls, onto `order`. `state[g]` is 0 before g's walk, 1 during it
// and 2 after; a marked call of a function still being walked closes a
// cycle, so that callee is `recursive`.
ir_opt_inline_marked_walk: fn(bodies: [[IRFunction]], marked: [Bool], id: Int, state: ^[Int], recursive: ^[Bool], order: ^[Int]) Never! {
    state[id] = 1
    f: bodies[id][0]
    loop at in 0..<f.op.len() {
        if f.op[at] != .Call -> next
        callee: f.a[at]
        if callee < 0 || callee >= marked.len() || !marked[callee] -> next
        if state[callee] == 1 -> recursive[callee] = true
        if state[callee] == 0 {
            ir_opt_inline_marked_walk(bodies, marked, callee, state, recursive, order)
        }
    }
    state[id] = 2
    order.push(id)
}

// Whether body `f` calls a function `marked` holds.
ir_opt_inline_marked_calls: fn(f: IRFunction, marked: [Bool]) -> Bool Never! {
    loop at in 0..<f.op.len() {
        if f.op[at] == .Call && f.a[at] >= 0 && f.a[at] < marked.len() && marked[f.a[at]] {
            return true
        }
    }
    false
}

// Whether body `f` can report no stop to a caller: it calls no function
// (no body, stop point or value), and no instruction's selection publishes
// a stop of its own (OptStops.jet ir_opt_stops_quiet). A runtime routine's
// stop with no poll after it in the body is not reported to the caller
// either (OptStops.jet ir_opt_stops_starts): the next poll observes it.
ir_opt_inline_quiet: fn(m: IRModule, f: IRFunction) -> Bool Never! {
    loop at in 0..<f.op.len() {
        op: f.op[at]
        if op == .Call || op == .CallIndirect || !ir_opt_stops_quiet(m, f, at) -> return false
    }
    true
}

// Whether selection reports a stop of instruction `at` at the function's
// own source file and line (X64Select: stop_if, located routes, shift stops).
// A division by a constant other than 0 and -1 (ir_opt_divisor) reports
// none: it can neither divide by zero nor overflow.
ir_opt_located: fn(m: IRModule, f: IRFunction, at: Int) -> Bool Never! {
    op: f.op[at]
    if op != .Add && op != .Sub && op != .Mul && op != .Div && op != .Rem && op != .FloorDiv && op != .Mod && op != .Shl && op != .Shr && op != .Neg {
        return false
    }
    division: op == .Div || op == .Rem || op == .FloorDiv || op == .Mod
    if division && ir_opt_divisor(f, at) == .Val(divisor) && divisor != 0 && divisor != -1 {
        return false
    }
    kind: ir_x64_type(m, f, f.a[at]).kind
    if kind == {
        .Int -> division || op == .Shl || op == .Shr
        .Word -> division || f.c[at] != IR_OVERFLOW_WRAP
        .Unit | .Bool | .Float | .Float32 | .Char | .String | .Pointer | .Aggregate -> false
    }
}

// The divisor of the division at `at` when selection knows it as a
// constant: a temporary whose one write is a Const (X64Alloc.jet
// ir_x64_allocate's `consts`).
ir_opt_divisor: fn(f: IRFunction, at: Int) -> Int? Never! {
    slot: f.b[at]
    if slot < f.param_count || slot >= f.slot_kind.len() || f.slot_kind[slot] != .Temp {
        return None
    }
    ^found: Int?{None}
    loop k in 0..<f.op.len() {
        if ir_x64_write(f, k) != slot -> next
        if found != None || f.op[k] != .Const -> return None
        found = Val(f.a[k])
    }
    found
}

// The callee's body in place of the Call at `at` of `caller`, appended to `f`.
// A parameter the body writes takes its argument into a slot of its own
// first, so the caller's argument keeps its value: a copy, or a move of a
// value with a drop (one the call hands over). One it never writes reads its
// argument; a named slot of its own, never written, is bound to that
// argument (IRFunction.binds), which holds its value over the body. The
// callee's slots belong to the new inline site (IRFunction.slot_site), and
// the slots standing for its parameters stay parameters of that site
// (IRFunction.slot_formal). Only debug information reads either.
ir_opt_splice: fn(m: IRModule, f: ^IRFunction, caller: IRFunction, at: Int, callee: IRFunction) Never! {
    site_line: caller.code_line[at]
    f.frame_bound = ir_frame_bound_add(f.frame_bound, callee.frame_bound)
    same_file: callee.source_file == caller.source_file
    ^written: (loop _ in 0..<callee.param_count -> false)
    loop k in 0..<callee.op.len() {
        slot: ir_x64_write(callee, k)
        if slot >= 0 && slot < callee.param_count -> written[slot] = true
    }
    // This body is a new inline site in the call's own one; the callee's
    // sites nest in it, renumbered as `f`'s (`sites`: by callee site).
    ^sites: [Int]{f.inline_sites.len() /% IR_INLINE_SITE_WORDS + 1}
    f.inline_sites.push(caller.a[at])
    f.inline_sites.push(ir_code_line_site(site_line))
    f.inline_sites.push(ir_code_line_source(site_line))
    loop row in 0..<(callee.inline_sites.len() /% IR_INLINE_SITE_WORDS) {
        word: IR_INLINE_SITE_WORDS * row
        sites.push(f.inline_sites.len() /% IR_INLINE_SITE_WORDS + 1)
        f.inline_sites.push(callee.inline_sites[word])
        f.inline_sites.push(sites[callee.inline_sites[word + 1]])
        f.inline_sites.push(callee.inline_sites[word + 2])
    }
    ^map: [Int]{}
    loop slot in 0..<callee.slot_type.len() {
        // A body from another file has the call's lines, which a local's
        // own line would be read against: only its parameters keep names.
        kept: same_file || slot < callee.param_count || callee.slot_formal[slot]
        name: if kept -> callee.slot_name[slot] else -> -1
        line: if kept -> callee.slot_line[slot] else -> 0
        if slot < callee.param_count {
            argument: caller.args[caller.b[at] + slot]
            if !written[slot] {
                map.push(argument)
                if name < 0 -> next
                named: ir_slot(f, callee.slot_type[slot], IRSlotKind.Local, name, line)
                f.slot_site[named] = sites[0]
                f.slot_formal[named] = true
                f.binds.push(named)
                f.binds.push(argument)
                next
            }
            own: ir_slot(f, callee.slot_type[slot], IRSlotKind.Local, name, line)
            f.slot_fixed[own] = callee.slot_fixed[slot]
            f.slot_site[own] = sites[0]
            f.slot_formal[own] = true
            transfer: if m.types[callee.slot_type[slot]].drop == "" -> IROp.Copy else -> IROp.Move
            ^_: ir_emit(f, transfer, own, argument, -1, -1, site_line)
            map.push(own)
            next
        }
        added: ir_slot(f, callee.slot_type[slot], callee.slot_kind[slot], name, line)
        f.slot_fixed[added] = callee.slot_fixed[slot]
        f.slot_site[added] = sites[callee.slot_site[slot]]
        f.slot_formal[added] = callee.slot_formal[slot]
        map.push(added)
    }
    loop pair in 0..<(callee.binds.len() /% 2) {
        f.binds.push(map[callee.binds[2 * pair]])
        f.binds.push(map[callee.binds[2 * pair + 1]])
    }
    // A scattered address is a local of the callee's (never a parameter,
    // whose map is the caller's argument).
    loop slot in callee.scattered {
        if slot >= callee.param_count -> f.scattered.push(map[slot])
    }
    dst: caller.dst[at]
    callee_facts: ir_opt_facts(callee)
    ^_: ir_emit(f, IROp.Block, -1, -1, -1, -1, site_line)
    ^depth: 0
    loop k in 0..<callee.op.len() {
        op: callee.op[k]
        line: ir_code_line_at(if same_file -> callee.code_line[k] else -> site_line, sites[ir_code_line_site(callee.code_line[k])])
        if op == .Return {
            value: callee.a[k]
            if value >= 0 && dst >= 0 {
                // Frame storage of the inlined body is the caller's now: the
                // result can be that storage itself, like call-site storage.
                own: value >= callee.param_count && callee_facts.defs[value] == 1 && callee.op[callee_facts.def_at[value]] == .StackAddress
                ir_opt_result(m, f, dst, map[value], own, line)
            }
            ^_: ir_emit(f, IROp.Br, -1, depth, -1, -1, line)
            next
        }
        if op == .End -> depth -= 1
        ir_opt_emit_mapped(f, callee, k, map, line)
        if op == .Block || op == .Loop || op == .If -> depth += 1
    }
    ^_: ir_emit(f, IROp.End, -1, -1, -1, -1, site_line)
}

// The call's result slot `dst` takes the returned `value`: a move, or for an
// aggregate not in the inlined body's own frame storage (`own`) a copy of
// its bytes into fresh frame storage, as the call's result storage.
ir_opt_result: fn(m: IRModule, f: ^IRFunction, dst: Int, value: Int, own: Bool, line: Int) Never! {
    ty: ir_x64_type(m, f, dst)
    if ty.kind == .Aggregate && !own {
        ^_: ir_emit(f, IROp.StackAddress, dst, ty.size, ty.align, -1, line)
        ^_: ir_emit(f, IROp.CopyBytes, -1, dst, value, ty.size, line)
        return
    }
    ^_: ir_emit(f, IROp.Move, dst, value, -1, -1, line)
}

// Callee instruction `k` with its slots through `map` (its argument list
// copied into `f`'s args pool).
ir_opt_emit_mapped: fn(f: ^IRFunction, callee: IRFunction, k: Int, map: [Int], line: Int) Never! {
    op: callee.op[k]
    dst: if callee.dst[k] >= 0 -> map[callee.dst[k]] else -> -1
    ^a: callee.a[k]
    ^b: callee.b[k]
    ^c: callee.c[k]
    if op == {
        .Copy | .Move | .Drop | .Close | .Neg | .Not | .Sqrt | .IntBig | .Convert | .Load | .Offset | .If | .BrIf | .CallIndirect -> {
            a = map[a]
        }
        .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Concat | .CopyBytes -> {
            a = map[a]
            b = map[b]
        }
        .Store | .StreamStore -> {
            a = map[a]
            c = map[c]
        }
        .Nop | .Const | .ConstText | .ConstBigInt | .Call | .CallRuntime | .FunctionAddress | .DataAddress | .StackAddress | .Block | .Loop | .Else | .End | .Br | .Return | .Unreachable -> {}
    }
    if op == .Call || op == .CallRuntime || op == .CallIndirect {
        start: f.args.len()
        loop index in b..<(b + c) -> f.args.push(map[callee.args[index]])
        b = start
    }
    ^_: ir_emit(f, op, dst, a, b, c, line)
}

#Test("The inline cost leaves out fail arms and stop edges, not other Ifs") {
    ^m: ir_module_new()
    poll: ir_stop_poll(m, IR_STOP_POLL_KEY)
    name_column_set(m.name_rows_keys, m.name_rows, IR_STOP_POLL_KEY, poll)
    int: ir_scalar_type_row(m, Type.Int)
    flag: ir_scalar_type_row(m, Type.Bool)
    ^f: ir_function_new("f", "test:cost.jet.f", "", "cost.jet", 1)
    n: ir_slot(f, int, IRSlotKind.Param, -1, 1)
    f.result = int
    bad: ir_slot(f, flag, IRSlotKind.Temp, -1, 0)
    zero: ir_slot(f, int, IRSlotKind.Temp, -1, 0)
    ^_: ir_emit(f, IROp.Lt, bad, n, n, -1, 2)
    // A fail arm: its four instructions count as its If.
    ^_: ir_open_if(f, bad, 2)
    loop _ in 0..<3 -> ^_: ir_emit(f, IROp.Const, zero, 0, -1, -1, 2)
    ^_: ir_emit(f, IROp.Unreachable, -1, -1, -1, -1, 2)
    ir_end(f, 2)
    // A stop edge after the poll: its Return counts as its If.
    stopped: ir_slot(f, flag, IRSlotKind.Temp, -1, 0)
    none: ir_args(f, [Int]{})
    ^_: ir_emit(f, IROp.Call, stopped, poll, none, 0, 3)
    ^_: ir_open_if(f, stopped, 3)
    ^_: ir_emit(f, IROp.Return, -1, -1, -1, -1, 3)
    ir_end(f, 3)
    // An If whose arm falls through counts in full.
    ^_: ir_open_if(f, bad, 4)
    ^_: ir_emit(f, IROp.Const, zero, 1, -1, -1, 4)
    ir_end(f, 4)
    ^_: ir_emit(f, IROp.Return, -1, n, -1, -1, 5)
    assert_eq(ir_opt_size(f), 12)
    assert_eq(ir_opt_inline_cost(m, f), 7)
}

// The calls left in a caller of `g` once `g` (whose body is one `op` of its
// Int parameter with itself, returned) is inlined into it: the call is
// followed by its stop point. None when `g` was not inlined.
ir_opt_inline_test_calls_left: fn(op: IROp) -> Int? Never! {
    ^m: ir_module_new()
    poll: ir_stop_poll(m, IR_STOP_POLL_KEY)
    name_column_set(m.name_rows_keys, m.name_rows, IR_STOP_POLL_KEY, poll)
    int: ir_scalar_type_row(m, Type.Int)
    flag: ir_scalar_type_row(m, Type.Bool)
    ^g: ir_function_new("g", "test:quiet.jet.g", "", "quiet.jet", 1)
    n: ir_slot(g, int, IRSlotKind.Param, -1, 1)
    g.result = int
    v: ir_slot(g, int, IRSlotKind.Temp, -1, 0)
    ^_: ir_emit(g, op, v, n, n, -1, 2)
    ^_: ir_emit(g, IROp.Return, -1, v, -1, -1, 2)
    ^f: ir_function_new("f", "test:quiet.jet.f", "", "quiet.jet", 4)
    x: ir_slot(f, int, IRSlotKind.Param, -1, 4)
    f.result = int
    r: ir_slot(f, int, IRSlotKind.Temp, -1, 0)
    stopped: ir_slot(f, flag, IRSlotKind.Temp, -1, 0)
    passed: ir_args(f, [Int]{x})
    ^_: ir_emit(f, IROp.Call, r, poll + 1, passed, 1, 5)
    none: ir_args(f, [Int]{})
    ^_: ir_emit(f, IROp.Call, stopped, poll, none, 0, 5)
    ^_: ir_open_if(f, stopped, 5)
    ^_: ir_emit(f, IROp.Return, -1, -1, -1, -1, 5)
    ir_end(f, 5)
    ^_: ir_emit(f, IROp.Return, -1, r, -1, -1, 6)
    bodies: [[IRFunction]]{[IRFunction]{}, [IRFunction]{g.move()}, [IRFunction]{}}
    ^report: ir_opt_report(1)
    out: ir_opt_inline_build(m, bodies, f, [Bool]{false, false, false}, [Int]{0, 1, 0}, false, 1, IROptInline.Auto, report) ?? return None
    ^calls: 0
    loop code in out.op {
        if code == .Call -> calls += 1
    }
    Val(calls)
}

#Test("An inlined quiet body takes the stop point after its call with it") {
    // An Int add publishes no stop: the poll tested only what g reported.
    assert_eq(ir_opt_inline_test_calls_left(IROp.Add), Val(0))
    // An Int shift can stop, and the poll after the body delivers it.
    assert_eq(ir_opt_inline_test_calls_left(IROp.Shl), Val(1))
}

// keep(z) calls h, then drops its Zone z (a String) through the glue,
// the Drop already the glue's call (OptGlue.jet ir_opt_glue_calls), and
// then polls: h's stop point, past z's drop. The glue is quiet and is
// inlined, and the poll that delivers h's stop stays.
#Test("An inlined glue leaves the stop point after it to the call before the Drop") {
    ^m: ir_module_new()
    poll: ir_stop_poll(m, IR_STOP_POLL_KEY)
    name_column_set(m.name_rows_keys, m.name_rows, IR_STOP_POLL_KEY, poll)
    text: ir_scalar_type_row(m, Type.String)
    flag: ir_scalar_type_row(m, Type.Bool)
    zone_tid: ir_module_intern_tid(m, Type.Named{name: "Zone"})
    zone: ir_intern_type(m, "Zone", ir_layout(IRTypeKind.Aggregate, zone_tid, 8, 8, IRClass.Memory, false, 0, "#drop<Zone>"))
    ^glue: ir_hashed_function("drop", "#drop<Zone>", "jet_ir_drop_", "", 0)
    held: ir_slot(glue, zone, IRSlotKind.Param, ir_intern_name(m, "value"), 0)
    name: ir_slot(glue, text, IRSlotKind.Temp, -1, 0)
    ^_: ir_emit(glue, IROp.Load, name, held, 0, -1, 0)
    ^_: ir_emit(glue, IROp.Drop, -1, name, -1, -1, 0)
    ^_: ir_emit(glue, IROp.Return, -1, -1, -1, -1, 0)
    ^keep: ir_function_new("keep", "test:glue.jet.keep", "", "glue.jet", 1)
    z: ir_slot(keep, zone, IRSlotKind.Param, ir_intern_name(m, "z"), 1)
    stopped: ir_slot(keep, flag, IRSlotKind.Temp, -1, 0)
    none: ir_args(keep, [Int]{})
    ^_: ir_emit(keep, IROp.Call, -1, poll + 1, none, 0, 2)
    dropped: ir_args(keep, [Int]{z})
    ^_: ir_emit(keep, IROp.Call, -1, poll + 2, dropped, 1, 2)
    ^_: ir_emit(keep, IROp.Call, stopped, poll, none, 0, 2)
    ^_: ir_open_if(keep, stopped, 2)
    ^_: ir_emit(keep, IROp.Return, -1, -1, -1, -1, 2)
    ir_end(keep, 2)
    ^_: ir_emit(keep, IROp.Return, -1, -1, -1, -1, 3)
    bodies: [[IRFunction]]{[IRFunction]{}, [IRFunction]{}, [IRFunction]{glue.move()}}
    ^report: ir_opt_report(1)
    out: ir_opt_inline_build(m, bodies, keep, [Bool]{false, false, false}, [Int]{0, 1, 1}, false, 1, IROptInline.Auto, report) ?? panic("the glue was not inlined")
    assert_eq(report.inlined_calls, 1)
    ^polls: 0
    loop at in 0..<out.op.len() {
        if out.op[at] == .Call && out.a[at] == poll -> polls += 1
    }
    assert_eq(polls, 1)
}

// Function `name` of marked.jet, marked `#Inline(Always)`: its Int
// parameter passed to function `callee`, whose result it returns.
ir_opt_inline_test_caller: fn(name: String, callee: Int, int: Int) -> IRFunction Never! {
    ^f: ir_function_new(name, "test:marked.jet.{name}", "", "marked.jet", 4)
    f.inline_always = true
    x: ir_slot(f, int, IRSlotKind.Param, -1, 4)
    f.result = int
    r: ir_slot(f, int, IRSlotKind.Temp, -1, 0)
    passed: ir_args(f, [Int]{x})
    ^_: ir_emit(f, IROp.Call, r, callee, passed, 1, 5)
    ^_: ir_emit(f, IROp.Return, -1, r, -1, -1, 6)
    f
}

ir_opt_inline_test_calls: fn(f: IRFunction) -> Int Never! {
    ^calls: 0
    loop code in f.op {
        if code == .Call -> calls += 1
    }
    calls
}

#Test("Every marked call is inlined, each marked callee first; a cycle of marked calls stays a call") {
    ^m: ir_module_new()
    int: ir_scalar_type_row(m, Type.Int)
    ^g: ir_function_new("g", "test:marked.jet.g", "", "marked.jet", 1)
    g.inline_always = true
    n: ir_slot(g, int, IRSlotKind.Param, -1, 1)
    g.result = int
    v: ir_slot(g, int, IRSlotKind.Temp, -1, 0)
    ^_: ir_emit(g, IROp.Add, v, n, n, -1, 2)
    ^_: ir_emit(g, IROp.Return, -1, v, -1, -1, 2)
    m.functions.push(g)
    // Marked h calls marked g, unmarked f calls h, and marked a and b call
    // each other.
    m.functions.push(ir_opt_inline_test_caller("h", 0, int))
    ^f: ir_opt_inline_test_caller("f", 1, int)
    f.inline_always = false
    m.functions.push(f)
    m.functions.push(ir_opt_inline_test_caller("a", 4, int))
    m.functions.push(ir_opt_inline_test_caller("b", 3, int))
    ^report: ir_opt_report(0)
    // h calls g, f calls h, and a and b call each other.
    assert_eq(ir_opt_marked_calls(m), 4)
    ir_opt_inline_marked_module(m, report)
    // Only the cycle sema refuses (E0917) keeps its two marked calls.
    assert_eq(ir_opt_marked_calls(m), 2)
    assert_eq(ir_opt_inline_test_calls(m.functions[1]), 0)
    // f takes h's copy, which already holds g's body.
    assert_eq(ir_opt_inline_test_calls(m.functions[2]), 0)
    // a is the cycle's head: b keeps its call of a, and a takes b's copy.
    assert_eq(ir_opt_inline_test_calls(m.functions[3]), 1)
    assert_eq(ir_opt_inline_test_calls(m.functions[4]), 1)
    // IR Lint stops a build on each one, naming the call site in source,
    // the inlined copy's too.
    ^marked_rows: 0
    loop finding in ir_lint_module(m, "ir.opt", compiler_threads_single()) {
        if finding.rule == IR_LINT_CALL_MARKED {
            marked_rows += 1
            assert(finding.message.contains(" at marked.jet:5 left after the marked calls were inlined"))
        }
    }
    assert_eq(marked_rows, 2)
    assert_eq(report.inlined_calls, 3)
    assert_eq(report.inlines.len(), 3)
    assert_eq("{report.inlines[0].caller} {report.inlines[0].callee} {report.inlines[0].reason}", "h g marked #Inline(Always)")
    assert_eq("{report.inlines[1].caller} {report.inlines[1].callee}", "a b")
    assert_eq("{report.inlines[2].caller} {report.inlines[2].callee} {report.inlines[2].line}", "f h 5")
}

// What becomes of the call of g (the module's first function) in f (its
// second), both taken out of `m`: the cost ir_opt_inline_size gives it with
// g unmarked and then marked (-1: refused), and, marked, f's body after
// ir_opt_inline_build: its calls, the Moves out of f's parameter, the
// instructions that write that parameter, and each instruction's line. None
// when `m` lacks f or g, or g was not inlined.
IROptInlineTestSplice: struct {
    unmarked: Int,
    marked: Int,
    calls: Int,
    param_moves: Int,
    param_writes: Int,
    lines: [Int],
}

ir_opt_inline_test_splice: fn(m: ^IRModule) -> IROptInlineTestSplice? Never! {
    f: m.functions.pop() ?? return None
    ^g: m.functions.pop() ?? return None
    ^at: -1
    loop k in 0..<f.op.len() {
        if f.op[k] == .Call -> at = k
    }
    g.inline_always = false
    ^bodies: [[IRFunction]]{[IRFunction]{g.move()}, [IRFunction]{}}
    recursive: [Bool]{false, false}
    unmarked: ir_opt_inline_size(m, bodies, f, at, recursive, 1000)
    bodies[0][0].inline_always = true
    marked: ir_opt_inline_size(m, bodies, f, at, recursive, 1000)
    ^report: ir_opt_report(0)
    out: ir_opt_inline_build(m, bodies, f, recursive, [Int]{}, false, 0, IROptInline.Marked, report) ?? return None
    assert_eq(report.inlined_calls, 1)
    ^param_moves: 0
    ^param_writes: 0
    ^lines: [Int]{}
    loop k in 0..<out.op.len() {
        if out.op[k] == .Move && out.a[k] == 0 -> param_moves += 1
        if ir_x64_write(out, k) == 0 -> param_writes += 1
        lines.push(ir_code_line_source(out.code_line[k]))
    }
    Val(IROptInlineTestSplice{unmarked: unmarked, marked: marked, calls: ir_opt_inline_test_calls(out), param_moves: param_moves, param_writes: param_writes, lines: lines.move()})
}

// A module of g, `file`'s function of one parameter of row `param` whose
// value `body` makes from it, returned, then unmarked f of marked.jet,
// whose parameter and result have row `arg`, which returns g's result for
// its parameter. None when `param` or `arg` has no type row.
ir_opt_inline_test_module: fn(file: String, body: IROp, write_param: Bool, param: Type, arg: Type) -> IRModule? Never! {
    ^m: ir_module_new()
    row: ir_type_row(m, param) ?? return None
    passed: ir_type_row(m, arg) ?? return None
    ^g: ir_function_new("g", "test:{file}.g", "", file, 1)
    n: ir_slot(g, row, IRSlotKind.Param, -1, 1)
    g.result = row
    v: ir_slot(g, row, IRSlotKind.Temp, -1, 0)
    ^_: ir_emit(g, body, if write_param -> n else -> v, n, n, -1, 2)
    ^_: ir_emit(g, IROp.Return, -1, if write_param -> n else -> v, -1, -1, 3)
    m.functions.push(g)
    ^f: ir_opt_inline_test_caller("f", 0, passed)
    f.inline_always = false
    m.functions.push(f)
    Val(m)
}

#Test("A marked callee is inlined though it writes its parameter") {
    ^m: ir_opt_inline_test_module("marked.jet", IROp.Add, true, Type.Int, Type.Int) ?? panic("no type rows")
    splice: ir_opt_inline_test_splice(m) ?? panic("g was not inlined")
    // Unmarked, the written parameter refuses it.
    assert_eq(splice.unmarked, -1)
    assert(splice.marked >= 0)
    assert_eq(splice.calls, 0)
    // The body doubles a slot of its own, a move of f's parameter, which no
    // instruction writes.
    assert_eq(splice.param_moves, 1)
    assert_eq(splice.param_writes, 0)
}

#Test("A marked callee is inlined though it can stop in another file") {
    // g of other.jet divides its parameter by itself, a stop located there.
    ^m: ir_opt_inline_test_module("other.jet", IROp.FloorDiv, false, Type.Int, Type.Int) ?? panic("no type rows")
    splice: ir_opt_inline_test_splice(m) ?? panic("g was not inlined")
    // Unmarked, the stop in another file refuses it.
    assert_eq(splice.unmarked, -1)
    assert(splice.marked >= 0)
    assert_eq(splice.calls, 0)
    // The body's lines of other.jet become the call's line in marked.jet,
    // where its stop reports.
    loop line in splice.lines -> assert(line != 2 && line != 3)
}

#Test("A marked callee is inlined though its argument has another type row of the same layout") {
    // g takes and returns an I64; f passes and returns a U64, a word of the
    // same size.
    ^m: ir_opt_inline_test_module("marked.jet", IROp.BitOr, false, Type.IntN{signed: true, bits: 64}, Type.IntN{signed: false, bits: 64}) ?? panic("no type rows")
    splice: ir_opt_inline_test_splice(m) ?? panic("g was not inlined")
    // Unmarked, only the same row may stand for the parameter.
    assert_eq(splice.unmarked, -1)
    assert(splice.marked >= 0)
    assert_eq(splice.calls, 0)
}

#Test("A last-owner routine is never marked, and a marked caller of it is still inlined") {
    ^m: ir_module_new()
    int: ir_scalar_type_row(m, Type.Int)
    // Made as BuildOwn.jet makes every last-owner routine: one shared copy
    // the drop sites call, unmarked.
    ^last: ir_hashed_function(IR_LAST_OWNER, "#box.last<test>", "jet_ir_last_", "", 0)
    assert(!last.inline_always)
    n: ir_slot(last, int, IRSlotKind.Param, -1, 0)
    last.result = int
    ^_: ir_emit(last, IROp.Return, -1, n, -1, -1, 0)
    m.functions.push(last)
    // Marked h calls the routine, and unmarked f calls h.
    m.functions.push(ir_opt_inline_test_caller("h", 0, int))
    ^f: ir_opt_inline_test_caller("f", 1, int)
    f.inline_always = false
    m.functions.push(f)
    ^report: ir_opt_report(0)
    ir_opt_inline_marked_module(m, report)
    // f holds h's body, and with it the one call of the shared routine.
    assert_eq(report.inlined_calls, 1)
    assert_eq(ir_opt_inline_test_calls(m.functions[2]), 1)
    loop k in 0..<m.functions[2].op.len() {
        if m.functions[2].op[k] == .Call -> assert_eq(m.functions[2].a[k], 0)
    }
}

// Whether the FloorDiv of an Int parameter by `divisor` (a constant, or the
// parameter itself when None) is located.
ir_opt_inline_test_located: fn(divisor: Int?) -> Bool Never! {
    ^m: ir_module_new()
    int: ir_scalar_type_row(m, Type.Int)
    ^g: ir_function_new("g", "test:kernel.jet.g", "", "kernel.jet", 1)
    n: ir_slot(g, int, IRSlotKind.Param, -1, 1)
    g.result = int
    ^by: n
    if divisor == .Val(value) {
        by = ir_slot(g, int, IRSlotKind.Temp, -1, 0)
        ^_: ir_emit(g, IROp.Const, by, value, -1, -1, 2)
    }
    v: ir_slot(g, int, IRSlotKind.Temp, -1, 0)
    at: ir_emit(g, IROp.FloorDiv, v, n, by, -1, 2)
    ^_: ir_emit(g, IROp.Return, -1, v, -1, -1, 2)
    ir_opt_located(m, g, at)
}

#Test("A division by a constant other than 0 and -1 reports no stop of its own") {
    assert_eq(ir_opt_inline_test_located(Val(8)), false)
    assert_eq(ir_opt_inline_test_located(Val(7)), false)
    assert_eq(ir_opt_inline_test_located(Val(0)), true)
    assert_eq(ir_opt_inline_test_located(Val(-1)), true)
    assert_eq(ir_opt_inline_test_located(None), true)
}

// bump(by) = total, total := 8 + by, inlined into run(n), whose own `by` is
// n + 1: at O1 and O2 run's `by` and bump's `total` are folded into the
// temporaries that compute them (IRFunction.binds) and bump's `by` reads
// run's argument, yet each is located over the code that reads its value,
// and the inlined two are locals of the inline site, not of run.
#Test("An inlined body's parameter and folded locals are located in its inline site") {
    loop level in 1..<3 {
        ^m: ir_module_new()
        word: ir_scalar_type_row(m, Type.IntN{signed: true, bits: 64})
        ^g: ir_function_new("bump", "test:bump.jet.bump", "", "bump.jet", 1)
        by: ir_slot(g, word, IRSlotKind.Param, ir_intern_name(m, "by"), 1)
        g.result = word
        eight: ir_slot(g, word, IRSlotKind.Temp, -1, 0)
        ^_: ir_emit(g, IROp.Const, eight, 8, -1, -1, 2)
        sum: ir_slot(g, word, IRSlotKind.Temp, -1, 0)
        ^_: ir_emit(g, IROp.Add, sum, eight, by, IR_OVERFLOW_WRAP, 2)
        total: ir_slot(g, word, IRSlotKind.Local, ir_intern_name(m, "total"), 2)
        ^_: ir_emit(g, IROp.Move, total, sum, -1, -1, 2)
        ^_: ir_emit(g, IROp.Return, -1, total, -1, -1, 3)
        ^f: ir_function_new("run", "test:bump.jet.run", "", "bump.jet", 5)
        n: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "n"), 5)
        f.result = word
        one: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
        ^_: ir_emit(f, IROp.Const, one, 1, -1, -1, 6)
        more: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
        ^_: ir_emit(f, IROp.Add, more, n, one, IR_OVERFLOW_WRAP, 6)
        mine: ir_slot(f, word, IRSlotKind.Local, ir_intern_name(m, "by"), 6)
        ^_: ir_emit(f, IROp.Move, mine, more, -1, -1, 6)
        got: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
        passed: ir_args(f, [Int]{mine})
        ^_: ir_emit(f, IROp.Call, got, 0, passed, 1, 7)
        ^_: ir_emit(f, IROp.Return, -1, got, -1, -1, 7)
        m.entry = 1
        ir_function_bind(m, g.key, 0)
        ir_function_bind(m, f.key, 1)
        m.functions.push(g)
        m.functions.push(f)
        ^options: ir_opt_options(level)
        options.verify = true
        report: ir_optimize_module(m, options, compiler_threads_single())
        assert_eq(report.lint.len(), 0)
        assert_eq(report.inlined_calls, 1)
        compiled: ir_x64_compile_function(m, ir_x64_tables(m), 1)
        assert(compiled.errors.is_empty())
        names: [String]{"by", "by", "total", "total"}
        loop (row, site) in ([Int]{0, 1, 1, 0}) {
            ^located: false
            loop range in compiled.debug.ranges {
                variable: compiled.variables[range.variable]
                if variable.name == names[row] && variable.site == site -> located = true
            }
            assert(located == (site == 1 || row == 0), "O{level}: {names[row]} of site {site}")
        }
    }
}

// square(i) = i * i, inlined into sum(n), which passes its loop variable `i`
// and writes it again each pass: at O1 and O2 square's `i` is a parameter
// of the inline site, bound to sum's `i`, and located only over the site's
// code, where sum's `i` still holds the value passed. Sum's own `i` stays a
// local of sum.
#Test("An inlined parameter bound to a variable written again is located only in its site") {
    loop level in 1..<3 {
        ^m: ir_module_new()
        word: ir_scalar_type_row(m, Type.IntN{signed: true, bits: 64})
        truth: ir_scalar_type_row(m, Type.Bool)
        ^g: ir_function_new("square", "test:sum.jet.square", "", "sum.jet", 1)
        i: ir_slot(g, word, IRSlotKind.Param, ir_intern_name(m, "i"), 1)
        g.result = word
        product: ir_slot(g, word, IRSlotKind.Temp, -1, 0)
        ^_: ir_emit(g, IROp.Mul, product, i, i, IR_OVERFLOW_WRAP, 1)
        ^_: ir_emit(g, IROp.Return, -1, product, -1, -1, 1)
        ^f: ir_function_new("sum", "test:sum.jet.sum", "", "sum.jet", 3)
        n: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "n"), 3)
        f.result = word
        total: ir_slot(f, word, IRSlotKind.Local, ir_intern_name(m, "total"), 4)
        counter: ir_slot(f, word, IRSlotKind.Local, ir_intern_name(m, "i"), 5)
        done: ir_slot(f, truth, IRSlotKind.Temp, -1, 0)
        got: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
        one: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
        ^_: ir_emit(f, IROp.Const, total, 0, -1, -1, 4)
        ^_: ir_emit(f, IROp.Const, counter, 0, -1, -1, 5)
        ^_: ir_emit(f, IROp.Block, -1, 12, -1, -1, 5)
        ^_: ir_emit(f, IROp.Loop, -1, 11, -1, -1, 5)
        ^_: ir_emit(f, IROp.Ge, done, counter, n, -1, 5)
        ^_: ir_emit(f, IROp.BrIf, -1, done, 1, -1, 5)
        passed: ir_args(f, [Int]{counter})
        ^_: ir_emit(f, IROp.Call, got, 0, passed, 1, 6)
        ^_: ir_emit(f, IROp.Add, total, total, got, IR_OVERFLOW_WRAP, 7)
        ^_: ir_emit(f, IROp.Const, one, 1, -1, -1, 5)
        ^_: ir_emit(f, IROp.Add, counter, counter, one, IR_OVERFLOW_WRAP, 5)
        ^_: ir_emit(f, IROp.Br, -1, 0, -1, -1, 5)
        ^_: ir_emit(f, IROp.End, -1, 3, -1, -1, 5)
        ^_: ir_emit(f, IROp.End, -1, 2, -1, -1, 5)
        ^_: ir_emit(f, IROp.Return, -1, total, -1, -1, 9)
        m.entry = 1
        ir_function_bind(m, g.key, 0)
        ir_function_bind(m, f.key, 1)
        m.functions.push(g)
        m.functions.push(f)
        ^options: ir_opt_options(level)
        options.verify = true
        report: ir_optimize_module(m, options, compiler_threads_single())
        assert_eq(report.lint.len(), 0)
        assert_eq(report.inlined_calls, 1)
        compiled: ir_x64_compile_function(m, ir_x64_tables(m), 1)
        assert(compiled.errors.is_empty())
        ^formal: false
        ^local: false
        loop variable in compiled.variables {
            if variable.name != "i" -> next
            if variable.site == 1 -> formal = variable.parameter
            if variable.site == 0 -> local = !variable.parameter
        }
        assert(formal, "O{level}: square's i is a parameter of its site")
        assert(local, "O{level}: sum's i is a local")
        ^low: -1
        ^high: -1
        loop run in compiled.debug.inlines {
            if run.site != 1 -> next
            if low < 0 || run.start < low -> low = run.start
            if run.end > high -> high = run.end
        }
        assert(low >= 0, "O{level}: the inline site has code")
        ^located: false
        loop range in compiled.debug.ranges {
            variable: compiled.variables[range.variable]
            if variable.name != "i" || variable.site != 1 -> next
            located = true
            assert(range.start >= low && range.end <= high, "O{level}: square's i at [{range.start}, {range.end}) outside its site's code [{low}, {high})")
        }
        assert(located, "O{level}: square's i is located in its site")
    }
}
