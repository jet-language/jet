// Program-owned mains (#6328). The executable's `main` normally runs the
// entry under the process root (JetRuntime Main.jet jet_rt_main): a stop (a
// panic, a numeric stop, a failed require, process.exit) is published to
// the root, every generated frame leaves by its stop edge running its
// cleanup (Build.jet ir_stop_check), and then the root writes the captured
// report and exits with the stop's code.
//
// A program whose stop edges run no cleanup a process exit could observe
// (they only write and free memory and return: ir_entry_quiet) and whose
// runtime routes all behave the same with no root (IR_ROOT_FREE_ROUTES)
// gets the same result from a stop without the root. The runtime writes
// the same report straight to fd 2, after the same stdout flush, and exits
// with the same code (JetRuntime Trap.jet, report domain 0). The fatal
// signal reports are the same too. Such a program keeps no stop point, so
// its module is built as the runtime library's is (IRModule.stop_points
// false). It runs under a main of its own (JetBackend Image/Object.jet
// x64_object_main): host startup, then jet_rt_main_owned_start (the fault
// handlers), the entry, the stdout flush and status 0. The decision reads
// only the built module, so every tier that builds the executable from it
// makes the same one.

use jet_foundation.[name_rows_value]

// The runtime routes whose behaviour doesn't depend on the process root:
// output and formatting, memory, the numeric, bounds, require and panic
// stops (Trap.jet: with no root the report goes straight to fd 2), the
// exact Int arithmetic (Int.jet: a big result allocates; a zero divisor or
// a negative exponent is int_stop, the numeric stop's report, and the
// scheduler is read only after it), the failed entry's exit
// (JourneyTLS.jet), the fixed-timing host admission (HostTiming.jet: a CPUID
// probe, then the failed entry's exit), the backtrace mode, the sentry's
// release switch (Sentry.jet: a word of the sentry root runtime init
// allocates) and the cleanup
// scopes (with no root no stop is ever pending). The program's value
// allocations and moves (Alloc.jet jet_rt_alloc_value, jet_rt_move_enter;
// Text.jet jet_rt_string_builder_value, jet_rt_string_append_value,
// jet_rt_string_serve, jet_rt_string_move) are memory too: a program with a
// `#Context(allocator:)` block has a root (jet_ctx_push_allocator and
// jet_ctx_push_arena are not here), so with none no carrier serves or
// moves. jet_rt_process_entry_return only marks the end of a rooted
// process, so an owned main drops its calls.
// Int shifts are not here: jet_int_shl/shr read the scheduler on every call.
//
// The generated CLI parser's routes (#6328 S2) are root-free too: the
// arguments (HostStartup.jet: the owned main captures them first, as
// jet_rt_main's startup does), the Int parse, the fixed-width check (its
// stop is int_stop's), the overflow stop (Trap.jet: the panic message's
// path), the UTF-8 decode, its error's message read (TextGlue.jet: a clone
// of the stored message, as jet_rt_string_clone) and its error's drop, the
// terminal probes, the raw stdio write (Core term's stdio_write and eprint:
// the same buffered stdout and stdout-then-fd-2 writes with or without a
// root), the journey origin and the test-fault probe (Jet TLS, a fault
// schedule only a test arms), the session status (0 with no stop pending,
// and with no root none ever is) and process.exit (with no root,
// HostProcess.jet runs the exit handlers, flushes and exits at once; under
// the root the same steps run after the stop edges, which an owned main's do
// nothing observable on).
IR_ROOT_FREE_ROUTES: #run { [String]{
    "jet_char_len",
    "jet_fault_should_fail",
    "jet_int_add",
    "jet_int_bit_and",
    "jet_int_bit_or",
    "jet_int_bit_xor",
    "jet_int_checked_fixed",
    "jet_int_compare",
    "jet_int_div",
    "jet_int_div_euclid",
    "jet_int_floor_div",
    "jet_int_mod",
    "jet_int_mul",
    "jet_int_owned_from_i64",
    "jet_int_owned_to_i64",
    "jet_int_parse",
    "jet_int_pow",
    "jet_int_rem",
    "jet_int_rem_euclid",
    "jet_int_sub",
    "jet_journey_origin",
    "jet_journey_reset",
    "jet_rt_alloc",
    "jet_rt_alloc_8",
    "jet_rt_alloc_value",
    "jet_rt_alloc_value_grow",
    "jet_rt_block_inherit_zero",
    "jet_rt_block_release",
    "jet_rt_block_retain",
    "jet_rt_block_unique",
    "jet_rt_bool_to_string",
    "jet_rt_cleanup_enter",
    "jet_rt_cleanup_leave",
    "jet_rt_entry_error_exit",
    "jet_rt_entry_error_exit_err",
    "jet_rt_fault_backtrace",
    "jet_rt_fixed_shift_stop",
    "jet_rt_float_to_string",
    "jet_rt_free",
    "jet_rt_free_8",
    "jet_rt_handle_drop_utf8_error",
    "jet_rt_i64_to_string",
    "jet_rt_int_clone",
    "jet_rt_int_drop",
    "jet_rt_int_to_string",
    "jet_rt_list_bounds_stop",
    "jet_rt_mem_fill",
    "jet_rt_mem_move",
    "jet_rt_move_enter",
    "jet_rt_move_enter_at",
    "jet_rt_move_leave",
    "jet_rt_move_needed",
    "jet_rt_numeric_stop",
    "jet_rt_panic_message",
    "jet_rt_panic_overflow",
    "jet_rt_process_entry_return",
    "jet_rt_record_get_utf8_error_message",
    "jet_rt_require_stop",
    "jet_rt_sentry_set_release",
    "jet_rt_session_propagate",
    "jet_rt_string_append",
    "jet_rt_string_append_value",
    "jet_rt_string_builder_finish",
    "jet_rt_string_builder_new",
    "jet_rt_string_builder_push",
    "jet_rt_string_builder_push_static",
    "jet_rt_string_builder_value",
    "jet_rt_string_clear",
    "jet_rt_string_clone",
    "jet_rt_string_drop",
    "jet_rt_string_eq",
    "jet_rt_string_from_static",
    "jet_rt_string_move",
    "jet_rt_string_serve",
    "jet_rt_timing_admit",
    "jet_rt_u64_to_string",
    "jet_rt_unreachable",
    "jet_std_io_args",
    "jet_std_process_exit",
    "jet_string_bytes",
    "jet_string_from_bytes",
    "jet_term_stderr_is_terminal",
    "jet_term_stdio_put_text_raw",
    "jet_term_stdout_is_terminal",
    "jet_term_write_stdout_line",
} }

// The runtime routes a stop edge or a drop routine may call with nothing a
// process exit could observe: they free memory, or enter and leave a
// cleanup scope (an owned main drops those).
IR_ENTRY_QUIET_ROUTES: #run { [String]{
    "jet_rt_block_release",
    "jet_rt_cleanup_enter",
    "jet_rt_cleanup_leave",
    "jet_rt_free",
    "jet_rt_free_8",
    "jet_rt_handle_drop_utf8_error",
    "jet_rt_int_drop",
    "jet_rt_string_drop",
} }

// Why the entry of `m` needs the process root: the first function, in
// module order, that calls a route outside IR_ROOT_FREE_ROUTES or has a
// stop point without its stop edge, else the first that cleans up on a
// stop edge. Returns "" when the program can own its main.
ir_entry_root_need: fn(m: IRModule) -> String Never! {
    if m.entry < 0 -> return "the module has no program entry"
    free := [String:Bool]{}
    loop route in IR_ROOT_FREE_ROUTES -> free[route.copy()] = true
    poll: name_rows_value(m.function_rows, IR_STOP_POLL_KEY) ?? -1
    trap: name_rows_value(m.function_rows, IR_STOP_TRAP_KEY) ?? -1
    turn: name_rows_value(m.function_rows, IR_STOP_TURN_KEY) ?? -1
    // Each stop edge as (function, its first instruction, its End).
    edges := [Int]{}
    seeds := [Int]{}
    loop (id, f) in m.functions {
        if f.asm != None -> next
        loop at in 0..<f.op.len() {
            if f.op[at] == .CallRuntime {
                symbol: m.names[f.a[at]]
                if free.get(symbol) == None -> return "`{f.name}` calls the runtime route `{symbol}`"
                next
            }
            if f.op[at] != .Call || f.a[at] < 0 || (f.a[at] != poll && f.a[at] != trap && f.a[at] != turn) -> next
            if at + 1 >= f.op.len() || f.op[at + 1] != .If || f.a[at + 1] != f.dst[at] || f.b[at + 1] >= 0 -> return "`{f.name}` has a stop point without its stop edge"
            edges.push(id)
            edges.push(at + 2)
            edges.push(f.c[at + 1])
            loop k in (at + 2)..<f.c[at + 1] {
                if f.op[k] == .Call && f.a[k] >= 0 -> seeds.push(f.a[k])
            }
        }
    }
    quiet: ir_entry_quiet_functions(m, seeds)
    edge := 0
    loop edge < edges.len() {
        f: m.functions[edges[edge]]
        loop k in edges[edge + 1]..<edges[edge + 2] {
            if !ir_entry_quiet(m, f, k, quiet) -> return "`{f.name}` cleans up on a stop edge"
        }
        edge += 3
    }
    ""
}

// What ir_entry_quiet_functions found: per type row of `m` its drop
// routine's function (-1: it drops nothing a process exit could observe,
// -2: its routine is missing), and per function whether running it does
// nothing a process exit could observe.
IREntryQuiet: struct { glue: [Int], functions: [Bool] }

// Whether instruction `at` of `f` (on a stop edge, or in a function one
// reaches) does nothing a process exit could observe: it is no indirect
// call, close or unreachable; a call of an IR_ENTRY_QUIET_ROUTES route; a
// call of a function `quiet` marks; or a drop of a type that drops nothing
// or whose drop routine `quiet` marks.
ir_entry_quiet: fn(m: IRModule, f: IRFunction, at: Int, quiet: IREntryQuiet) -> Bool Never! {
    if f.op[at] == {
        .CallIndirect | .Close | .Unreachable -> false
        .Call -> f.a[at] >= 0 && f.a[at] < quiet.functions.len() && quiet.functions[f.a[at]]
        .CallRuntime -> {
            symbol: m.names[f.a[at]]
            loop route in IR_ENTRY_QUIET_ROUTES {
                if route == symbol -> return true
            }
            false
        }
        .Drop -> {
            glue: quiet.glue[f.slot_type[f.a[at]]]
            glue == -1 || (glue >= 0 && quiet.functions[glue])
        }
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Sqrt | .IntBig | .StreamStore -> true
    }
}

// Which functions of `m` do nothing a process exit could observe, among
// `seeds` (the functions stop edges call), the drop routines (BuildOwn.jet
// ir_drop_glue; a type with none, an Int and a String drop quietly) and
// every function those call or drop through; any other function counts as
// not quiet, and so does an `#FFI(asm)` leaf (a stop point among them).
// They start quiet and lose it until nothing changes, so a recursive
// type's routine, or a routine calling one outlined part of it (a buffer's
// last-owner release), counts as quiet when its cycle does nothing else.
ir_entry_quiet_functions: fn(m: IRModule, seeds: [Int]) -> IREntryQuiet Never! {
    q := IREntryQuiet{glue: [Int]{}, functions: [Bool]{}}
    loop _ in m.functions -> q.functions.push(false)
    seen := q.functions.copy()
    work := seeds.copy()
    loop row in m.types {
        id: if row.drop == "" || row.kind == .Int || row.kind == .String -> -1 else -> name_rows_value(m.function_rows, row.drop) ?? -2
        q.glue.push(id)
        if id >= 0 -> work.push(id)
    }
    members := [Int]{}
    loop work.len() > 0 {
        id: work.pop() ?? -1
        if id < 0 || id >= m.functions.len() || seen[id] -> next
        seen[id] = true
        f: m.functions[id]
        if f.asm != None -> next
        q.functions[id] = true
        members.push(id)
        loop at in 0..<f.op.len() {
            if f.op[at] == .Call -> work.push(f.a[at])
            if f.op[at] == .Drop && q.glue[f.slot_type[f.a[at]]] >= 0 -> work.push(q.glue[f.slot_type[f.a[at]]])
        }
    }
    changed := true
    loop changed {
        changed = false
        loop id in members {
            if !q.functions[id] -> next
            f: m.functions[id]
            loop at in 0..<f.op.len() {
                if !ir_entry_quiet(m, f, at, q) {
                    q.functions[id] = false
                    changed = true
                    break
                }
            }
        }
    }
    q
}

// The root-free routes that read the calling thread's block (JetRuntime
// Thread.jet) even when nothing allocated: the journey's and the fault
// schedule's Jet TLS, the task control word process.exit and the
// session status read (Scheduler.jet scheduler_control_current: 0 on an
// attached thread with no root), and the `context.<field>` reads of the
// context record and the thread index (Context.jet). The runtime attaches a
// thread exactly when the program links the allocator's cached front doors
// or Jet TLS (jet_rt_thread_init's guards), and these routes need neither,
// so a main that calls one attaches its thread itself.
// Every other root-free route reads a thread block only behind the
// allocator or the report probe (Scheduler.jet scheduler_report_base),
// both of which take an unattached thread. The cleanup scopes don't stay:
// with no task control (only the root and tasks make one) their shield and
// session flags are untouched and the saved word is 0 (Scheduler.jet
// jet_rt_cleanup_enter/leave), so an owned main drops their calls and links
// none of the deadline delivery behind the shield's leave.
IR_OWNED_ATTACH_ROUTES: #run { [String]{
    "jet_ctx_deadline_ms",
    "jet_ctx_deadline_present",
    "jet_ctx_thread",
    "jet_fault_should_fail",
    "jet_journey_origin",
    "jet_journey_reset",
    "jet_rt_session_propagate",
    "jet_std_process_exit",
} }

// The root-free routes besides print that may write stdout (through its
// buffer, HostStdio.jet host_stdout_write). A main that calls one keeps
// print's buffered writer, so their lines stay in program order.
IR_OWNED_STDOUT_ROUTES: #run { [String]{
    "jet_term_stdio_put_text_raw",
} }

// Decides the main of the program `m` (built by ir_build_program) and
// returns why it keeps the process root, or "" when it owns its main: then
// every stop point, every jet_rt_process_entry_return call and every cleanup
// scope goes, the module has no stop points and `owned_main` is set, and
// `owned_attach` when it calls an IR_OWNED_ATTACH_ROUTES route. Its
// process.exit calls jet_std_process_exit_owned, which publishes no stop
// (there is no root to take one). Unless it calls an IR_OWNED_STDOUT_ROUTES
// route, its print calls jet_term_write_stdout_line_direct: no other route
// it may call writes stdout and it runs no test capture, so its lines need
// no buffer.
ir_entry_own: fn(m: &IRModule) -> String Never! {
    need: ir_entry_root_need(m)
    if need != "" -> return need
    poll: name_rows_value(m.function_rows, IR_STOP_POLL_KEY) ?? -1
    trap: name_rows_value(m.function_rows, IR_STOP_TRAP_KEY) ?? -1
    turn: name_rows_value(m.function_rows, IR_STOP_TURN_KEY) ?? -1
    entry_return: name_rows_value(m.name_rows, "jet_rt_process_entry_return") ?? -1
    buffered := false
    loop route in IR_OWNED_STDOUT_ROUTES {
        row: name_rows_value(m.name_rows, route) ?? -1
        if row >= 0 && ir_entry_calls(m, row) -> buffered = true
    }
    print: if buffered -> -1 else -> name_rows_value(m.name_rows, "jet_term_write_stdout_line") ?? -1
    direct: if print >= 0 -> ir_intern_name(m, "jet_term_write_stdout_line_direct") else -> -1
    exit: name_rows_value(m.name_rows, "jet_std_process_exit") ?? -1
    exit_owned: if exit >= 0 -> ir_intern_name(m, "jet_std_process_exit_owned") else -> -1
    redirect := [Int]{}
    loop _ in 0..<m.names.len() -> redirect.push(-1)
    if print >= 0 -> redirect[print] = direct
    if exit >= 0 -> redirect[exit] = exit_owned
    cleanup: IRCleanupRoutes{enter: name_rows_value(m.name_rows, "jet_rt_cleanup_enter") ?? -1, leave: name_rows_value(m.name_rows, "jet_rt_cleanup_leave") ?? -1}
    attach := [Bool]{}
    loop _ in 0..<m.names.len() -> attach.push(false)
    loop route in IR_OWNED_ATTACH_ROUTES {
        row: name_rows_value(m.name_rows, route) ?? -1
        if row >= 0 -> attach[row] = true
    }
    if exit >= 0 -> attach[exit_owned] = true
    loop id in 0..<m.functions.len() {
        if m.functions[id].asm != None -> next
        ir_entry_own_strip(m.functions[id], poll, trap, turn, entry_return, redirect, cleanup)
        loop (at, op) in m.functions[id].op {
            if op == .CallRuntime && attach[m.functions[id].a[at]] -> m.owned_attach = true
        }
    }
    m.stop_points = false
    m.owned_main = true
    ""
}

// Whether a function of `m` calls the runtime route of name row `row`.
ir_entry_calls: fn(m: IRModule, row: Int) -> Bool Never! {
    loop f in m.functions {
        if f.asm != None -> next
        loop (at, op) in f.op {
            if op == .CallRuntime && f.a[at] == row -> return true
        }
    }
    false
}

// The name rows of jet_rt_cleanup_enter and jet_rt_cleanup_leave (-1: not
// called).
IRCleanupRoutes: struct {
    enter: Int
    leave: Int
}

// Removes the stop points of `f` (each poll with its stop edge), its
// jet_rt_process_entry_return calls (`entry_return`, a name row) and its
// cleanup scopes (an enter's saved word becomes the 0 it returns with no
// control), and points each runtime call whose name row `redirect` maps
// (-1: none) at the owned main's route.
ir_entry_own_strip: fn(f: &IRFunction, poll: Int, trap: Int, turn: Int, entry_return: Int, redirect: [Int], cleanup: IRCleanupRoutes) Never! {
    removed := false
    at := 0
    loop at < f.op.len() {
        if f.op[at] == .CallRuntime && (f.a[at] == entry_return || f.a[at] == cleanup.leave || (f.a[at] == cleanup.enter && f.dst[at] < 0)) {
            ir_opt_kill(f, at)
            removed = true
        } else if f.op[at] == .CallRuntime && f.a[at] == cleanup.enter {
            f.op[at] = .Const
            f.a[at] = 0
            f.b[at] = -1
            f.c[at] = -1
        } else if f.op[at] == .CallRuntime && f.a[at] < redirect.len() && redirect[f.a[at]] >= 0 {
            f.a[at] = redirect[f.a[at]]
        } else if f.op[at] == .Call && f.a[at] >= 0 && (f.a[at] == poll || f.a[at] == trap || f.a[at] == turn) {
            end: f.c[at + 1]
            loop k in at..<(end + 1) -> ir_opt_kill(f, k)
            removed = true
            at = end
        }
        at += 1
    }
    if removed -> ir_opt_compact(f)
}
