// Dependency-tracked reactive values (I8: one carrier on every tier). A
// Signal<T>, Derived<T> or Computed<T> is the runtime's reactive cell handle
// and an Effect its observer handle (Compiler/JetRuntime/Source/Reactive.jet);
// the Core declarations' fields (`value`, `version`, `last`, `active`) are
// untracked reads of the same carriers, and their struct literals build new
// ones, so the Core/Reactive/Reactive.jet value API keeps its meaning. A
// derived/effect body is the moved closure box the runtime retains, invoked
// through the typed lazy.callback helper and released once.

use jet_foundation.[Span, BodyHandleOp, BodyLambda, BodyStructFieldValue, Type, type_carrier_identity]

IR_REACTIVE_CORE_PREFIX: "<corelib>/core.reactive::"

// "Signal", "Derived", "Computed" or "Effect" for the Core reactive carrier
// `ty`, None for any other type (a program's own `Signal` declaration too).
ir_reactive_kind: fn(p: IRProgram, ty: Type) -> String? Never! {
    name := ""
    arity := 0
    if ir_untag(ty) == {
        .Named(named) -> name = named
        .Apply(applied, args) -> {
            name = applied
            arity = args.len()
        }
        else -> return None
    }
    short := name
    if ir_type_def(p, name) == .Val(row) {
        key: p.types[row].key
        if !key.starts_with(IR_REACTIVE_CORE_PREFIX) {
            // Sema names the reactive Effect bare, the leaf the compiler-owned
            // core.Effect enum also keys as; the Core declaration decides.
            if name != "Effect" || (!key.starts_with("<corelib>/") && key != name) -> return None
            if ir_type_def(p, "{IR_REACTIVE_CORE_PREFIX}Effect") == None -> return None
        }
        short = ir_short_name(key)
        if name == "Effect" -> short = name
    } else if name.starts_with(IR_REACTIVE_CORE_PREFIX) {
        short = ir_short_name(name)
    }
    if short == "Effect" && arity == 0 -> return Val(short)
    if (short == "Signal" || short == "Derived" || short == "Computed") && arity == 1 -> return Val(short)
    None
}

ir_reactive_type: fn(p: IRProgram, ty: Type) -> Bool Never! { ir_reactive_kind(p, ty) != None }

// The owned handle row: a copy shares the cell (or adds an Effect owner).
ir_reactive_row: fn(m: &IRModule, p: IRProgram, ty: Type) -> Int Never! {
    if (ir_reactive_kind(p, ty) ?? "") == "Effect" {
        return ir_intern_type(m, type_carrier_identity(ty), ir_owned_layout(IRTypeKind.Pointer, ty, "jet_rt_handle_drop_jet_reactive_effect", "jet_rt_handle_clone_jet_reactive_effect"))
    }
    ir_intern_type(m, type_carrier_identity(ty), ir_owned_layout(IRTypeKind.Pointer, ty, "jet_rt_handle_drop_jet_reactive_cell", "jet_rt_handle_clone_jet_reactive_cell"))
}

ir_reactive_element: fn(ty: Type) -> Type Never! {
    args: ir_type_args(ir_untag(ty))
    if args.len() == 1 -> return args[0].copy()
    Type.Named{name: "Unit"}
}

// The address of an owned copy of `value` the runtime takes over.
ir_reactive_moved_slot: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, value: Int, span: Span) -> Int Never! {
    owned: if b.fresh[value] -> value else -> ir_copy_value(m, p, b, value, span)
    if ir_failed(b) -> return -1
    b.fresh[owned] = false
    ir_lazy_value_slot(m, b, owned)
}

// A new cell over the value of node `value` at version `version` (an exact
// Int slot the runtime borrows).
ir_reactive_cell_new: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, value: Int, version: Int, span: Span) -> Int Never! {
    row: ir_reactive_row(m, p, ty)
    element: ir_reactive_element(ty)
    slot := ir_word_const(m, b, 0)
    if !ir_unit_type(element) {
        payload: ir_expr(m, p, b, value)
        if ir_failed(b) || payload < 0 -> return -1
        slot = ir_reactive_moved_slot(m, p, b, payload, span)
        if ir_failed(b) -> return -1
    }
    meta: ir_lazy_meta(m, p, b, element, span)
    if meta < 0 -> return -1
    cell: ir_runtime(m, b, "jet_reactive_cell_new", [Int]{slot, meta, version}, row)
    b.fresh[cell] = true
    cell
}

ir_reactive_field_value: fn(fields: [BodyStructFieldValue], name: String) -> Int? Never! {
    loop field in fields {
        if field.field.name == name -> return Val(field.value)
    }
    None
}

// `Signal<T>{value, version}` and its Derived/Computed kin build a new cell;
// `Effect{last, active}` a bodiless observer.
ir_reactive_literal: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, fields: [BodyStructFieldValue], span: Span) -> Int Never! {
    kind: ir_reactive_kind(p, ty) ?? return ir_fail_slot(b, span, "struct literal of {ir_type_name(ty)}")
    if kind == "Effect" {
        last_node: ir_reactive_field_value(fields, "last") ?? return ir_fail_slot(b, span, "Effect literal without last")
        active_node: ir_reactive_field_value(fields, "active") ?? return ir_fail_slot(b, span, "Effect literal without active")
        last: ir_expr(m, p, b, last_node)
        if ir_failed(b) || last < 0 -> return -1
        active: ir_expr(m, p, b, active_node)
        if ir_failed(b) || active < 0 -> return -1
        row: ir_reactive_row(m, p, ty)
        observer: ir_runtime(m, b, "jet_reactive_effect_value", [Int]{last, active}, row)
        b.fresh[observer] = true
        ir_release(m, b, last)
        return observer
    }
    value_node: ir_reactive_field_value(fields, "value") ?? return ir_fail_slot(b, span, "{kind} literal without value")
    version_node: ir_reactive_field_value(fields, "version") ?? return ir_fail_slot(b, span, "{kind} literal without version")
    version: ir_expr(m, p, b, version_node)
    if ir_failed(b) || version < 0 -> return -1
    cell: ir_reactive_cell_new(m, p, b, ty, value_node, version, span)
    ir_release(m, b, version)
    cell
}

// A value the runtime writes to frame storage through `export(handle, out)`.
ir_reactive_read: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, handle: Int, export: String, span: Span) -> Int Never! {
    if ir_unit_type(ty) {
        zero: ir_word_const(m, b, 0)
        _: ir_runtime(m, b, export, [Int]{handle, zero}, -1)
        return -1
    }
    row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    // The runtime writes one descriptor stride (at least a word).
    stride: ir_align8(ir_list_stride(m, row))
    bytes: if stride < 8 -> 8 else -> stride
    if m.types[row].kind == .Aggregate {
        storage: ir_fresh_temp(m, b, row)
        ir_emit(b.f, IROp.StackAddress, storage, bytes, 8, -1, b.line)
        _: ir_runtime(m, b, export, [Int]{handle, storage}, -1)
        return storage
    }
    out: ir_out_slot(m, b, bytes.div_euclid(8))
    _: ir_runtime(m, b, export, [Int]{handle, out}, -1)
    value: ir_load_at(m, b, out, 0, row)
    b.fresh[value] = true
    value
}

// `.value` / `.version` of a cell and `.last` / `.active` of an Effect:
// untracked reads.
ir_reactive_field: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, field: String, span: Span) -> Int Never! {
    kind: ir_reactive_kind(p, ir_ty(p, b, receiver)) ?? return ir_fail_slot(b, span, "field: struct {field}")
    handle: ir_expr(m, p, b, receiver)
    if ir_failed(b) || handle < 0 -> return -1
    result := -1
    if kind == "Effect" {
        export: if field == {
            "last" -> "jet_reactive_effect_last"
            "active" -> "jet_reactive_effect_active"
            else -> { return ir_fail_slot(b, span, "Effect field {field}") }
        }
        row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
        result = ir_runtime(m, b, export, [Int]{handle}, row)
        b.fresh[result] = true
    } else if field == "version" {
        row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
        result = ir_runtime(m, b, "jet_reactive_cell_version", [Int]{handle}, row)
        b.fresh[result] = true
    } else if field == "value" {
        result = ir_reactive_read(m, p, b, ty, handle, "jet_reactive_cell_peek", span)
    } else {
        return ir_fail_slot(b, span, "{kind} field {field}")
    }
    ir_release(m, b, handle)
    result
}

// The body closure of `executable` handed to the runtime: (env, invoke,
// release).
ir_reactive_body: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, executable: BodyLambda, span: Span) -> [Int] Never! {
    closure_ty: ir_lambda_function_type(executable)
    env: ir_lambda(m, p, b, closure_ty, executable, span)
    if ir_failed(b) || env < 0 -> return [Int]{}
    invoke_id: ir_lazy_helper(m, p, b, "callback", closure_ty, span)
    if invoke_id < 0 -> return [Int]{}
    invoke: ir_lazy_address(m, b, invoke_id)
    handed: ir_closure_handover(m, p, b, env, span)
    if handed.held < 0 -> return [Int]{}
    [Int]{handed.held, invoke, handed.release}
}

// `reactive.derived(body)` / `reactive.computed(body)`.
ir_reactive_derived: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, executable: BodyLambda, span: Span) -> Int Never! {
    kind: ir_reactive_kind(p, ty) ?? ""
    if kind != "Derived" && kind != "Computed" -> return ir_fail_slot(b, span, "reactive.derived producing {ir_type_name(ty)}")
    body := ir_reactive_body(m, p, b, executable, span)
    if body.len() != 3 -> return -1
    meta: ir_lazy_meta(m, p, b, ir_reactive_element(ty), span)
    if meta < 0 -> return -1
    body.push(meta)
    row: ir_reactive_row(m, p, ty)
    cell: ir_runtime(m, b, "jet_reactive_derived_new", body, row)
    b.fresh[cell] = true
    cell
}

// `reactive.autorun(body)`: the Effect handle owning the observer.
ir_reactive_effect: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, executable: BodyLambda, span: Span) -> Int Never! {
    if (ir_reactive_kind(p, ty) ?? "") != "Effect" -> return ir_fail_slot(b, span, "reactive.autorun producing {ir_type_name(ty)}")
    body: ir_reactive_body(m, p, b, executable, span)
    if body.len() != 3 -> return -1
    row: ir_reactive_row(m, p, ty)
    observer: ir_runtime(m, b, "jet_reactive_effect", body, row)
    b.fresh[observer] = true
    observer
}

// `#Reactive { body }` and `ui.reactive_render(body)`: an effect the thread
// retains, re-run whenever a signal its last run read changes.
ir_reactive_rooted: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, executable: BodyLambda, span: Span) -> Int Never! {
    body: ir_reactive_body(m, p, b, executable, span)
    if body.len() != 3 -> return -1
    _: ir_runtime(m, b, "jet_reactive_effect_rooted", body, -1)
    return -1
}

// `ui.button(label, shortcut:, accessible_label:) { on_click }`: the runtime
// node keeps the handler in its click registry. The label is borrowed, the
// accessible label crosses as its Option box (0 for None), and a present
// shortcut as its UIShortcut record made for the call and dropped after it
// (record.out; 0 for None).
ir_ui_button_click: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, label: Int, shortcut: Int, accessible_label: Int, executable: BodyLambda, span: Span) -> Int Never! {
    operands := [Int]{}
    sources: [Int]{label, shortcut, accessible_label}
    loop operand in sources {
        // An absent Option crosses as 0 without lowering its type: the
        // program may not declare UIShortcut at all.
        absent: ir_body_node(p, b, operand).kind == .Absent
        slot: if absent -> ir_word_const(m, b, 0) else -> ir_expr(m, p, b, operand)
        if ir_failed(b) || slot < 0 -> return -1
        operands.push(slot)
    }
    args := operands.copy()
    record := -1
    if ir_body_node(p, b, shortcut).kind != .Absent {
        option_ty: ir_ty(p, b, shortcut)
        payload_ty: if ir_untag(option_ty) == .Option(inner) -> inner else -> { return ir_fail_slot(b, span, "ui.button shortcut of {ir_type_name(option_ty)}") }
        payload_row: ir_value_type(m, p, payload_ty) ?? return ir_type_fail(b, span, payload_ty)
        pointer_row: ir_pointer_row(m)
        record = ir_temp(m, b, pointer_row)
        ir_emit(b.f, IROp.Const, record, 0, -1, -1, b.line)
        present: ir_option_is_some(m, b, operands[1])
        ir_open_if(b.f, present, b.line)
        payload: ir_option_payload(m, b, operands[1], payload_row)
        made: ir_record_out(m, p, b, payload_ty, payload, span)
        if made < 0 -> return -1
        ir_emit(b.f, IROp.Copy, record, made, -1, -1, b.line)
        ir_end(b.f, b.line)
        args[1] = record
    }
    body: ir_reactive_body(m, p, b, executable, span)
    if body.len() != 3 -> return -1
    loop word in body { args.push(word) }
    row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    node: ir_runtime(m, b, "jet_ui_button_on_click", args, row)
    if record >= 0 {
        _: ir_runtime(m, b, "jet_rt_handle_drop_jet_ui_shortcut", [Int]{record}, -1)
    }
    loop slot in operands { ir_release(m, b, slot) }
    b.fresh[node] = true
    node
}

// The Signal/Derived/Computed `get`/`set` and Effect `unsubscribe` /
// `is_active` handle methods; None leaves any other to ir_handle_method.
ir_reactive_method: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, operation: BodyHandleOp, args: [Int], span: Span) -> Int? Never! {
    if operation == {
        .ReactiveGet | .ReactiveSet | .ReactiveEffectMethod -> {}
        else -> return None
    }
    kind: ir_reactive_kind(p, ir_ty(p, b, receiver)) ?? return None
    handle: ir_expr(m, p, b, receiver)
    if ir_failed(b) || handle < 0 -> return Val(-1)
    result := -1
    if operation == .ReactiveEffectMethod {
        if kind != "Effect" -> return Val(ir_fail_slot(b, span, "Effect method on {kind}"))
        if ir_unit_type(ty) {
            _: ir_runtime(m, b, "jet_reactive_effect_unsubscribe", [Int]{handle}, -1)
        } else {
            row: ir_value_type(m, p, ty) ?? return Val(ir_type_fail(b, span, ty))
            result = ir_runtime(m, b, "jet_reactive_effect_active", [Int]{handle}, row)
        }
    } else if operation == .ReactiveSet {
        if kind != "Signal" || args.len() != 1 -> return Val(ir_fail_slot(b, span, "{kind}.set with {args.len()} arguments"))
        slot := ir_word_const(m, b, 0)
        if !ir_unit_type(ir_reactive_element(ir_ty(p, b, receiver))) {
            value: ir_expr(m, p, b, args[0])
            if ir_failed(b) || value < 0 -> return Val(-1)
            slot = ir_reactive_moved_slot(m, p, b, value, span)
            if ir_failed(b) -> return Val(-1)
        }
        _: ir_runtime(m, b, "jet_reactive_cell_set", [Int]{handle, slot}, -1)
    } else {
        if kind == "Effect" || args.len() != 0 -> return Val(ir_fail_slot(b, span, "{kind}.get with {args.len()} arguments"))
        result = ir_reactive_read(m, p, b, ty, handle, "jet_reactive_cell_get", span)
    }
    ir_release(m, b, handle)
    Val(result)
}
