// Canonical lowering for closed checked builtin-method operations.
use jet_foundation.[
    BUILTIN_METHOD_ROWS,
    BuiltinMethodReceiver,
    CollectionReceivers,
    TBuiltinOp,
    TFailureCarrier,
    Type,
    builtin_byte_buffer_row,
    builtin_method_receiver_accepts,
    sema_collection_family,
    sema_collection_kind,
]

// A builtin's route: the runtime symbol it calls, its operand count and which
// operands it borrows.
IRBuiltinRoute: struct {
    symbol: String,
    arity: Int,
    borrow_mask: [Bool],
}

ir_builtin_route_row: fn(symbol: String, arity: Int, borrow_mask: [Bool]) -> IRBuiltinRoute Never! {
    IRBuiltinRoute{symbol: symbol, arity: arity, borrow_mask: borrow_mask}
}

ir_builtin_untag: fn(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) -> return ir_builtin_untag(inner)
        // copy: the untagged type is a new owned Type. Otherwise it equals `ty`, the caller's
        // checked type (a read parameter), which stays on the checked node.
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return ty.copy()
    }
}

ir_builtin_string_receiver: fn(ty: Type) -> Bool Never! { ir_builtin_untag(ty) == Type.String }

// The collection family of a builtin's receiver, by the classifier sema
// checked the call with (sema_collection_kind), so a route names no Core
// type.
ir_builtin_family: fn(receiver: Type) -> CollectionReceivers? Never! {
    kind: sema_collection_kind(receiver) ?? return None
    Val(sema_collection_family(kind))
}

ir_builtin_iter_receiver: fn(ty: Type) -> Bool Never! {
    ir_builtin_family(ty) == Val(CollectionReceivers.Iter)
}

// A builtin whose route depends on its receiver: a String, an inline range
// and a Range value (BUILTIN_METHOD_ROWS) keep their own runtime functions;
// a collection takes its family's.
ir_builtin_route_for_receiver: fn(operation: TBuiltinOp, receiver: Type, carrier: TFailureCarrier) -> IRBuiltinRoute Never! {
    if ir_builtin_string_receiver(receiver) {
        if operation == TBuiltinOp.LenList {
            return ir_builtin_route_row("jet_char_len", 1, [Bool]{true})
        }
        if operation == TBuiltinOp.IsEmpty {
            return ir_builtin_route_row("jet_string_is_empty", 1, [Bool]{true})
        }
        if operation == TBuiltinOp.Contains {
            return ir_builtin_route_row("jet_string_contains", 2, [Bool]{true, true})
        }
        if operation == TBuiltinOp.StartsWith {
            return ir_builtin_route_row("jet_string_starts_with", 2, [Bool]{true, true})
        }
        if operation == TBuiltinOp.EndsWith {
            return ir_builtin_route_row("jet_string_ends_with", 2, [Bool]{true, true})
        }
    }
    if operation == TBuiltinOp.Contains {
        if ir_builtin_untag(receiver) == .InlineRange(_, _, _) {
            return ir_builtin_route_row("jet_range_contains", 2, [Bool]{true, false})
        }
        if builtin_method_receiver_accepts(BuiltinMethodReceiver.Range, receiver) {
            return ir_builtin_route_row("jet_range_value_contains", 2, [Bool]{true, false})
        }
    }
    family: ir_builtin_family(receiver)
    // A view reads like the List it windows.
    list: family == Val(CollectionReceivers.List) || family == Val(CollectionReceivers.View)
    if operation == {
        .Clear -> {
            if family == Val(CollectionReceivers.Set) {
                return ir_builtin_route_row("std::collections::HashSet::clear", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Rank) {
                return ir_builtin_route_row("std::collections::BTreeSet::clear", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Tally) || family == Val(CollectionReceivers.Map) {
                return ir_builtin_route_row("std::collections::HashMap::clear", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Cache) {
                return ir_builtin_route_row("JetCache::clear", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Queue) {
                return ir_builtin_route_row("std::collections::VecDeque::clear", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.PriorityQueue) {
                return ir_builtin_route_row("std::collections::BinaryHeap::clear", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Bits) {
                return ir_builtin_route_row("JetBitSet::clear", 1, [Bool]{true})
            }
            return ir_builtin_route_row("jet_list_clear", 1, [Bool]{true})
        }
        .LenList -> {
            if list -> return ir_builtin_route_row("jet_list_len", 1, [Bool]{true})
            if family == Val(CollectionReceivers.Map) {
                return ir_builtin_route_row("jet_map_len", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Iter) {
                return ir_builtin_route_row("jet_iter_len", 1, [Bool]{false})
            }
            if family == Val(CollectionReceivers.Set) {
                return ir_builtin_route_row("jet_set_len", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Rank) {
                return ir_builtin_route_row("jet_sorted_set_len", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.PriorityQueue) {
                return ir_builtin_route_row("jet_priority_queue_len", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Cache) {
                return ir_builtin_route_row("jet_lru_len", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Tally) {
                return ir_builtin_route_row("jet_bag_len", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Queue) {
                return ir_builtin_route_row("jet_deque_len", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Bits) {
                return ir_builtin_route_row("jet_bit_set_len", 1, [Bool]{true})
            }
        }
        .IsEmpty -> {
            if list -> return ir_builtin_route_row("jet_list_is_empty", 1, [Bool]{true})
            if family == Val(CollectionReceivers.Map) {
                return ir_builtin_route_row("jet_map_is_empty", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Iter) {
                return ir_builtin_route_row("jet_iter_is_empty", 1, [Bool]{false})
            }
            if family == Val(CollectionReceivers.Set) {
                return ir_builtin_route_row("jet_set_is_empty", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Rank) {
                return ir_builtin_route_row("jet_sorted_set_is_empty", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.PriorityQueue) {
                return ir_builtin_route_row("jet_priority_queue_is_empty", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Cache) {
                return ir_builtin_route_row("jet_lru_is_empty", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Tally) {
                return ir_builtin_route_row("jet_bag_is_empty", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Queue) {
                return ir_builtin_route_row("jet_deque_is_empty", 1, [Bool]{true})
            }
            if family == Val(CollectionReceivers.Bits) {
                return ir_builtin_route_row("jet_bit_set_is_empty", 1, [Bool]{true})
            }
        }
        .GetList -> {
            if list -> return ir_builtin_route_row("jet_list_get_opt", 2, [Bool]{true, false})
        }
        .GetMap -> {
            if family == Val(CollectionReceivers.Map) {
                return ir_builtin_route_row("jet_map_get_opt", 2, [Bool]{true, true})
            }
        }
        .ContainsKey -> {
            if family == Val(CollectionReceivers.Map) {
                return ir_builtin_route_row("jet_map_has_key", 2, [Bool]{true, true})
            }
            if family == Val(CollectionReceivers.Cache) {
                return ir_builtin_route_row("jet_lru_has", 2, [Bool]{true, true})
            }
        }
        .Max(float) -> {
            if !float {
                if family == Val(CollectionReceivers.Set) {
                    return ir_builtin_route_row("jet_set_max", 1, [Bool]{true})
                }
                return ir_builtin_route_row("jet_list_max", 1, [Bool]{false})
            }
        }
        .First -> {
            if list -> return ir_builtin_route_row("jet_list_first", 1, [Bool]{true})
            if family == Val(CollectionReceivers.Iter) {
                return ir_builtin_route_row("jet_iter_first", 1, [Bool]{false})
            }
            if family == Val(CollectionReceivers.Rank) {
                return ir_builtin_route_row("jet_sorted_set_first", 1, [Bool]{true})
            }
        }
        .Last -> {
            if list -> return ir_builtin_route_row("jet_list_last", 1, [Bool]{true})
            if family == Val(CollectionReceivers.Rank) {
                return ir_builtin_route_row("jet_sorted_set_last", 1, [Bool]{true})
            }
        }
        .Contains -> {
            if list -> return ir_builtin_route_row("jet_list_contains", 2, [Bool]{true, true})
            if family == Val(CollectionReceivers.Set) {
                return ir_builtin_route_row("jet_set_has", 2, [Bool]{true, true})
            }
            if family == Val(CollectionReceivers.Bits) {
                return ir_builtin_route_row("jet_bit_set_has", 2, [Bool]{true, false})
            }
            if family == Val(CollectionReceivers.Rank) {
                return ir_builtin_route_row("std::collections::BTreeSet::contains", 2, [Bool]{true, true})
            }
        }
        .StartsWith -> return ir_builtin_route_row("jet_list_starts_with", 2, [Bool]{true, true})
        .EndsWith -> return ir_builtin_route_row("jet_list_ends_with", 2, [Bool]{true, true})
        .ListUnion -> {
            if family == Val(CollectionReceivers.List) {
                return ir_builtin_route_row("jet_list_union", 2, [Bool]{true, true})
            }
        }
        .ListIntersection -> {
            if family == Val(CollectionReceivers.List) {
                return ir_builtin_route_row("jet_list_intersection", 2, [Bool]{true, true})
            }
        }
        .ListDifference -> {
            if family == Val(CollectionReceivers.List) {
                return ir_builtin_route_row("jet_list_difference", 2, [Bool]{true, true})
            }
        }
        .ListRandom -> {
            if family == Val(CollectionReceivers.List) {
                return ir_builtin_route_row("jet_list_random", 1, [Bool]{true})
            }
        }
        .MapFromKeys -> {
            ty := ir_builtin_untag(receiver)
            key := ty
            if ty == {
                .List(inner) -> { key = ir_builtin_untag(inner) }
                .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
            }
            if ty == {
                .FixedList(inner, _) -> { key = ir_builtin_untag(inner) }
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
            }
            symbol := if key == {
                .String -> "jet_map_from_keys_kernel"
                .Int | .IntN(_, _) -> "jet_map_from_keys_int"
                .Float | .Bool | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> "jet_map_from_keys_composite"
            }
            return ir_builtin_route_row(symbol, 2, [Bool]{false, false})
        }
        .AtomicMethod(_) | .LenString | .Push | .ListTryNew | .ListTryWithCapacity | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .StringEdit(_) | .Pop | .PriorityQueuePop | .InsertMap | .AddNewMap | .MapUpdate | .MapMerge | .MapMergeWith | .InsertList | .RemoveMap | .RemoveList(_, _) | .CountList | .Counts | .ExtendList | .ConcatList | .IndexOf | .Reverse | .SwapList | .ListFill | .Sort | .SortDesc | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Flatten | .Intersperse | .Unzip | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .StringWithCapacity | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ToString | .Take | .Skip | .IterToList | .IterCollect | .ListLazy | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterNext | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapContainsValue | .MapPopFirst | .ListReplace | .Indexed | .Indexes | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .SetFrom | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetPop | .SetReplace | .SetSort | .SetShuffle | .SortedSetFrom | .SortedSetInsert | .SortedSetRemove | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .PriorityQueueRemove(_, _) | .KeyOrdered(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .LRUCapacity | .LRUKeys | .BitSetAdd | .BitSetRemove | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferWrite(_) | .ByteBufferToBytes | .ByteBufferMethod(_) | .ByteBufferWithCapacity | .BagAdd | .BagRemove | .BagHas | .BagCount | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeDelete | .DequeToList | .DequeJoin | .DequeReverse | .DequeSplit | .DequeFrom | .TryCollect | .ViewNew(_) | .SplitWrite | .GetDisjointWrite | .ListFillRepeat -> {}
    }
    panic("checked receiver-sensitive TBuiltinOp has no canonical route for its receiver type")
}

ir_builtin_container_route: fn(operation: TBuiltinOp) -> IRBuiltinRoute Never! {
    if operation == {
        .SetFrom -> return ir_builtin_route_row("jet_set_from", 1, [Bool]{false})
        .SetToList -> return ir_builtin_route_row("jet_set_to_list", 1, [Bool]{true})
        .SetSort -> return ir_builtin_route_row("jet_set_sort", 1, [Bool]{true})
        .SetEqual -> return ir_builtin_route_row("jet_set_equal", 2, [Bool]{true, true})
        .SetFirst -> return ir_builtin_route_row("jet_set_first", 1, [Bool]{true})
        .SetValues -> return ir_builtin_route_row("jet_set_values", 1, [Bool]{true})
        .SetPop -> return ir_builtin_route_row("jet_set_pop_kernel", 2, [Bool]{true, true})
        .SetReplace -> return ir_builtin_route_row("jet_set_replace_kernel", 2, [Bool]{true, false})
        .SetInsert -> return ir_builtin_route_row("jet_set_insert", 2, [Bool]{true, false})
        .SetUpdate -> return ir_builtin_route_row("jet_set_update", 2, [Bool]{true, true})
        .SetDifferenceUpdate -> return ir_builtin_route_row("jet_set_difference_update", 2, [Bool]{true, true})
        .SetIntersectionUpdate -> return ir_builtin_route_row("jet_set_intersection_update", 2, [Bool]{true, true})
        .SetSymmetricDifferenceUpdate -> return ir_builtin_route_row("jet_set_symmetric_difference_update", 2, [Bool]{true, true})
        .SetRemove -> return ir_builtin_route_row("jet_set_remove", 2, [Bool]{true, false})
        .SetUnion -> return ir_builtin_route_row("jet_set_union", 2, [Bool]{true, true})
        .SetIntersection -> return ir_builtin_route_row("jet_set_intersection", 2, [Bool]{true, true})
        .SetDifference -> return ir_builtin_route_row("jet_set_difference", 2, [Bool]{true, true})
        .SetSymmetricDifference -> return ir_builtin_route_row("jet_set_symmetric_difference", 2, [Bool]{true, true})
        .SetIsSubset -> return ir_builtin_route_row("jet_set_is_subset", 2, [Bool]{true, true})
        .SetIsSuperset -> return ir_builtin_route_row("jet_set_is_superset", 2, [Bool]{true, true})
        .SetIsDisjoint -> return ir_builtin_route_row("jet_set_is_disjoint", 2, [Bool]{true, true})
        .SortedSetFrom -> return ir_builtin_route_row("jet_sorted_set_from", 1, [Bool]{false})
        .SortedSetToList -> return ir_builtin_route_row("jet_sorted_set_to_list", 1, [Bool]{true})
        .SortedSetInsert -> return ir_builtin_route_row("jet_sorted_set_insert", 2, [Bool]{true, false})
        .SortedSetRemove -> return ir_builtin_route_row("jet_sorted_set_remove", 2, [Bool]{true, false})
        .SortedSetUnion -> return ir_builtin_route_row("jet_sorted_set_union", 2, [Bool]{true, true})
        .SortedSetIntersection -> return ir_builtin_route_row("jet_sorted_set_intersection", 2, [Bool]{true, true})
        .SortedSetDifference -> return ir_builtin_route_row("jet_sorted_set_difference", 2, [Bool]{true, true})
        .SortedSetSymmetricDifference -> return ir_builtin_route_row("jet_sorted_set_symmetric_difference", 2, [Bool]{true, true})
        .SortedSetIsSubset -> return ir_builtin_route_row("jet_sorted_set_is_subset", 2, [Bool]{true, true})
        .SortedSetIsSuperset -> return ir_builtin_route_row("jet_sorted_set_is_superset", 2, [Bool]{true, true})
        .SortedSetIsDisjoint -> return ir_builtin_route_row("jet_sorted_set_is_disjoint", 2, [Bool]{true, true})
        .PriorityQueueFrom -> return ir_builtin_route_row("jet_priority_queue_from", 1, [Bool]{false})
        .PriorityQueuePeek -> return ir_builtin_route_row("jet_priority_queue_peek", 1, [Bool]{true})
        .PriorityQueueToSortedList -> return ir_builtin_route_row("jet_priority_queue_to_sorted_list", 1, [Bool]{true})
        .PriorityQueueRemove(_, mode) -> {
            if mode == {
                .Value -> return ir_builtin_route_row("jet_priority_queue_remove_value", 2, [Bool]{true, false})
                .Slot -> return ir_builtin_route_row("jet_priority_queue_remove_slot_canonical", 2, [Bool]{true, false})
                .Dynamic -> panic("dynamic priority queue removal requires structural lowering")
            }
        }
        .LRUPut -> return ir_builtin_route_row("jet_lru_put", 3, [Bool]{true, false, false})
        .LRUAddNew -> return ir_builtin_route_row("jet_lru_add_new", 3, [Bool]{true, false, false})
        .LRUGet -> return ir_builtin_route_row("jet_lru_get", 2, [Bool]{true, true})
        .LRUKeys -> return ir_builtin_route_row("jet_lru_keys", 1, [Bool]{true})
        .BitSetAdd -> return ir_builtin_route_row("jet_bitset_add", 2, [Bool]{true, false})
        .LRUCapacity -> return ir_builtin_route_row("JetCache::capacity", 1, [Bool]{true})
        .LRURemove -> return ir_builtin_route_row("JetCache::remove", 2, [Bool]{true, true})
        .BitSetRemove -> return ir_builtin_route_row("jet_bitset_remove", 2, [Bool]{true, false})
        .BitSetCount -> return ir_builtin_route_row("jet_bit_set_count", 1, [Bool]{true})
        .BitSetToList -> return ir_builtin_route_row("jet_bit_set_to_list", 1, [Bool]{true})
        .BagAdd -> return ir_builtin_route_row("jet_bag_add", 2, [Bool]{true, false})
        .BagRemove -> return ir_builtin_route_row("jet_bag_remove", 2, [Bool]{true, false})
        .BagHas -> return ir_builtin_route_row("jet_bag_has", 2, [Bool]{true, true})
        .BagCount -> return ir_builtin_route_row("jet_bag_count", 2, [Bool]{true, true})
        .DequePushFront -> return ir_builtin_route_row("jet_deque_push_front", 2, [Bool]{true, false})
        .DequePushBack -> return ir_builtin_route_row("jet_deque_push_back", 2, [Bool]{true, false})
        .DequePopFront -> return ir_builtin_route_row("jet_deque_pop_front_kernel", 1, [Bool]{true})
        .DequePopBack -> return ir_builtin_route_row("jet_deque_pop_back_kernel", 1, [Bool]{true})
        .DequePeekFront -> return ir_builtin_route_row("jet_deque_peek_front", 1, [Bool]{true})
        .DequePeekBack -> return ir_builtin_route_row("jet_deque_peek_back", 1, [Bool]{true})
        .DequeContains -> return ir_builtin_route_row("jet_deque_contains", 2, [Bool]{true, true})
        .DequeDelete -> return ir_builtin_route_row("jet_deque_delete", 2, [Bool]{true, false})
        .DequeToList -> return ir_builtin_route_row("jet_deque_to_list", 1, [Bool]{true})
        .DequeJoin -> return ir_builtin_route_row("jet_deque_join", 2, [Bool]{true, true})
        .DequeReverse -> return ir_builtin_route_row("jet_deque_reverse", 1, [Bool]{true})
        .DequeSplit -> return ir_builtin_route_row("jet_deque_split", 2, [Bool]{true, false})
        .DequeFrom -> return ir_builtin_route_row("jet_deque_from", 1, [Bool]{false})
        .AtomicMethod(_) | .LenString | .LenList | .IsEmpty | .Push | .ListTryNew | .ListTryWithCapacity | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .StringEdit(_) | .Pop | .PriorityQueuePop | .InsertMap | .AddNewMap | .MapUpdate | .MapMerge | .MapMergeWith | .InsertList | .RemoveMap | .RemoveList(_, _) | .CountList | .Counts | .ExtendList | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .Reverse | .SwapList | .ListFill | .Sort | .SortDesc | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Flatten | .Intersperse | .Unzip | .Clear | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .StringWithCapacity | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .Take | .Skip | .IterToList | .IterCollect | .ListLazy | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterNext | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .MapPopFirst | .ListReplace | .Indexed | .Indexes | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .SetCapacity | .SetShuffle | .KeyOrdered(_, _) | .ByteBufferFrom | .ByteBufferWrite(_) | .ByteBufferToBytes | .ByteBufferMethod(_) | .ByteBufferWithCapacity | .DequeCapacity | .DequeGet | .TryCollect | .ViewNew(_) | .SplitWrite | .GetDisjointWrite | .ListFillRepeat -> {}
    }
    panic("checked container TBuiltinOp has no canonical Prelude route")
}

ir_builtin_route_plan: fn(operation: TBuiltinOp, receiver: Type, result: Type, carrier: TFailureCarrier) -> IRBuiltinRoute Never! {
    if operation == {
        // ir_builtin lowers an Atomic method (ir_atomic_method) before it
        // looks for a route.
        .AtomicMethod(_) -> panic("a checked Atomic method lowers through ir_atomic_method, never a route")
        .LenString -> return ir_builtin_route_row("jet_char_len", 1, [Bool]{true})
        .LenList | .IsEmpty | .GetMap | .GetList | .First | .Last | .Contains | .ContainsKey | .MapFromKeys | .ListUnion | .ListIntersection | .ListDifference | .ListRandom -> return ir_builtin_route_for_receiver(operation, receiver, carrier)
        // Sema checks each of these on the one collection family whose
        // COLLECTION_OPERATIONS row lowers to it.
        .DequeCapacity -> return ir_builtin_route_row("jet_deque_capacity", 1, [Bool]{true})
        .SetCapacity -> return ir_builtin_route_row("jet_set_capacity", 1, [Bool]{true})
        .SetShuffle -> return ir_builtin_route_row("jet_set_shuffle", 1, [Bool]{true})
        // Float extrema use the collection sort order, so a NaN
        // item is the greatest value and never the least.
        .Max(float) -> {
            if float -> return ir_builtin_route_row("jet_list_max_float", 1, [Bool]{false})
            return ir_builtin_route_for_receiver(operation, receiver, carrier)
        }
        .Push -> {
            if ir_builtin_family(receiver) == Val(CollectionReceivers.PriorityQueue) {
                return ir_builtin_route_row("std::collections::BinaryHeap::push", 2, [Bool]{true, false})
            }
            return ir_builtin_route_row("jet_list_push", 2, [Bool]{true, false})
        }
        .ListTryNew -> return ir_builtin_route_row("jet_list_try_new", 1, [Bool]{false})
        .ListTryWithCapacity -> return ir_builtin_route_row("jet_list_try_with_capacity", 2, [Bool]{false, false})
        .TryPush -> return ir_builtin_route_row("jet_list_try_push", 2, [Bool]{true, false})
        .TryReserve -> return ir_builtin_route_row("jet_list_try_reserve", 2, [Bool]{true, false})
        .TryInsertMap -> return ir_builtin_route_row("jet_map_try_insert", 3, [Bool]{true, false, false})
        .TryStringPush -> return ir_builtin_route_row("jet_string_try_push", 2, [Bool]{true, true})
        // ir_builtin lowers an in-place String edit (ir_string_edit) before
        // it looks for a route.
        .StringEdit(_) -> panic("a checked String edit lowers through ir_string_edit, never a route")
        .Pop -> return ir_builtin_route_row("jet_list_pop_kernel", 1, [Bool]{true})
        .IterNext -> return ir_builtin_route_row("jet_iter_next", 1, [Bool]{true})
        .PriorityQueuePop -> return ir_builtin_route_row("jet_priority_queue_pop_kernel", 1, [Bool]{true})
        .InsertMap -> return ir_builtin_route_row("jet_map_insert", 3, [Bool]{true, false, false})
        .AddNewMap -> return ir_builtin_route_row("jet_map_add_new", 3, [Bool]{true, false, false})
        .MapUpdate -> return ir_builtin_route_row("jet_map_update_all", 2, [Bool]{true, true})
        .MapMerge -> return ir_builtin_route_row("jet_map_merge", 2, [Bool]{true, true})
        .MapMergeWith -> return ir_builtin_route_row("jet_map_merge_with", 3, [Bool]{true, true, false})
        .InsertList -> return ir_builtin_route_row("jet_list_insert", 3, [Bool]{true, false, false})
        .RemoveMap -> return ir_builtin_route_row("jet_map_pop_kernel", 2, [Bool]{true, true})
        .RemoveList(_, mode) -> {
            if mode == {
                .Value -> return ir_builtin_route_row("jet_list_remove_value", 2, [Bool]{true, false})
                .Slot -> return ir_builtin_route_row("jet_list_remove_slot", 2, [Bool]{true, false})
                .Dynamic -> panic("dynamic list removal requires structural lowering")
            }
        }
        .CountList -> return ir_builtin_route_row("jet_list_count", 2, [Bool]{true, true})
        .Counts -> return ir_builtin_route_row("jet_list_counts", 1, [Bool]{false})
        .ExtendList -> return ir_builtin_route_row("jet_list_extend", 2, [Bool]{true, false})
        .ConcatList -> return ir_builtin_route_row("jet_list_concat", 2, [Bool]{true, true})
        .IndexOf -> return ir_builtin_route_row("jet_list_index_of", 2, [Bool]{true, true})
        .Reverse -> return ir_builtin_route_row("jet_list_reverse", 1, [Bool]{true})
        .SwapList -> return ir_builtin_route_row("jet_list_swap", 3, [Bool]{true, false, false})
        .ListFill -> return ir_builtin_route_row("jet_list_fill", 3, [Bool]{true, true, true})
        .ListFillRepeat -> return ir_builtin_route_row("jet_list_fill_repeat", 3, [Bool]{true, true, true})
        .Sort -> return ir_builtin_route_row("jet_list_sort", 1, [Bool]{true})
        .SortDesc -> return ir_builtin_route_row("jet_list_sort_desc", 1, [Bool]{true})
        .OrderingThen -> return ir_builtin_route_row("jet_ordering_then", 2, [Bool]{true, true})
        .OrderingReverse -> return ir_builtin_route_row("jet_ordering_reverse", 1, [Bool]{true})
        .JoinSep -> {
            if ir_builtin_iter_receiver(receiver) {
                return ir_builtin_route_row("jet_iter_join", 2, [Bool]{false, true})
            }
            return ir_builtin_route_row("jet_list_join", 2, [Bool]{true, true})
        }
        .Sum(fixed, float) -> {
            if fixed && float {
                return ir_builtin_route_row("jet_list_sum_fixed_f32", 1, [Bool]{false})
            }
            if fixed -> return ir_builtin_route_row("jet_list_sum_fixed_f64", 1, [Bool]{false})
            return ir_builtin_route_row("jet_list_sum", 1, [Bool]{false})
        }
        .Product(fixed) -> {
            if !fixed -> return ir_builtin_route_row("jet_list_product", 1, [Bool]{false})
        }
        .Min(float) -> {
            if float -> return ir_builtin_route_row("jet_list_min_float", 1, [Bool]{false})
            return ir_builtin_route_row("jet_list_min", 1, [Bool]{false})
        }
        .Flatten -> {
            if ir_builtin_iter_receiver(receiver) {
                return ir_builtin_route_row("jet_iter_flatten", 1, [Bool]{false})
            }
            return ir_builtin_route_row("jet_list_flatten", 1, [Bool]{false})
        }
        .Intersperse -> return ir_builtin_route_row("jet_iter_intersperse", 2, [Bool]{false, false})
        .Clear -> return ir_builtin_route_for_receiver(operation, receiver, carrier)
        .Bytes(owned) -> {
            if owned -> return ir_builtin_route_row("jet_string_bytes", 1, [Bool]{false})
            return ir_builtin_route_row("jet_string_bytes", 1, [Bool]{true})
        }
        .StringFromBytes -> return ir_builtin_route_row("jet_string_from_bytes", 1, [Bool]{true})
        .StringFromBytesLossy -> return ir_builtin_route_row("jet_string_from_bytes_lossy", 1, [Bool]{true})
        .StringWithCapacity -> return ir_builtin_route_row("jet_rt_string_with_capacity", 1, [Bool]{false})
        .Trim -> return ir_builtin_route_row("jet_unicode_trim", 1, [Bool]{true})
        .TrimStart -> return ir_builtin_route_row("jet_text_trim_start", 1, [Bool]{true})
        .TrimEnd -> return ir_builtin_route_row("jet_text_trim_end", 1, [Bool]{true})
        // `pad_start`/`pad_end` are `rjust`/`ljust`: one runtime pad route each.
        .PadStart -> return ir_builtin_route_row("jet_text_pad_start_ref", 3, [Bool]{true, true, true})
        .PadEnd -> return ir_builtin_route_row("jet_text_pad_end_ref", 3, [Bool]{true, true, true})
        .StringIndexOf -> return ir_builtin_route_row("jet_unicode_index_of", 2, [Bool]{true, true})
        .StringCount -> return ir_builtin_route_row("jet_unicode_count", 2, [Bool]{true, true})
        .StringIsAlphabetic -> return ir_builtin_route_row("jet_text_is_alphabetic", 1, [Bool]{true})
        .StringIsNumeric -> return ir_builtin_route_row("jet_text_is_numeric", 1, [Bool]{true})
        .StringIsWhitespace -> return ir_builtin_route_row("jet_text_is_whitespace", 1, [Bool]{true})
        .StringIsASCII -> return ir_builtin_route_row("jet_text_unicode_is_ascii", 1, [Bool]{true})
        .StringToTitle -> return ir_builtin_route_row("jet_text_title", 1, [Bool]{true})
        .Split -> return ir_builtin_route_row("jet_iter_string_split", 2, [Bool]{true, true})
        .Lines -> return ir_builtin_route_row("jet_string_lines", 1, [Bool]{true})
        .Chars -> return ir_builtin_route_row("jet_string_chars", 1, [Bool]{true})
        .ParseInt -> return ir_builtin_route_row("jet_std::jet_int_parse", 1, [Bool]{true})
        .ParseFloat -> return ir_builtin_route_row("jet_std::jet_float_parse", 1, [Bool]{true})
        .IntToRadix -> return ir_builtin_route_row("jet_std::jet_int_to_radix", 2, [Bool]{false, false})
        .IntFromRadix -> return ir_builtin_route_row("jet_std::jet_int_from_radix", 2, [Bool]{true, false})
        .ToUpper -> return ir_builtin_route_row("jet_unicode_upper", 1, [Bool]{true})
        .ToLower -> return ir_builtin_route_row("jet_unicode_lower", 1, [Bool]{true})
        .ToASCIILower -> return ir_builtin_route_row("jet_text_ascii_lower", 1, [Bool]{true})
        .ToASCIIUpper -> return ir_builtin_route_row("jet_text_ascii_upper", 1, [Bool]{true})
        .Slice(_) -> return ir_builtin_route_row("jet_string_slice_builtin", 3, [Bool]{true, false, false})
        .After -> return ir_builtin_route_row("jet_string_after", 2, [Bool]{true, true})
        .Before -> return ir_builtin_route_row("jet_string_before", 2, [Bool]{true, true})
        .TrimView -> return ir_builtin_route_row("jet_unicode_trim_view", 1, [Bool]{true})
        .AfterView -> return ir_builtin_route_row("jet_string_after_view", 2, [Bool]{true, true})
        .BeforeView -> return ir_builtin_route_row("jet_string_before_view", 2, [Bool]{true, true})
        .Keys -> return ir_builtin_route_row("jet_map_keys", 1, [Bool]{true})
        .Values -> return ir_builtin_route_row("jet_map_values", 1, [Bool]{true})
        .MapTopN -> return ir_builtin_route_row("jet_map_top_n", 2, [Bool]{true, false})
        .MapToList -> return ir_builtin_route_row("jet_map_to_list", 1, [Bool]{true})
        .MapMin -> return ir_builtin_route_row("jet_map_min_value_kernel", 1, [Bool]{true})
        .MapMax -> return ir_builtin_route_row("jet_map_max_value_kernel", 1, [Bool]{true})
        .MapPopFirst -> return ir_builtin_route_row("jet_map_pop_first", 1, [Bool]{true})
        .MapEqual -> return ir_builtin_route_row("jet_map_equal", 2, [Bool]{true, true})
        .MapFirst -> return ir_builtin_route_row("jet_map_first_key", 1, [Bool]{true})
        .MapIntersection -> return ir_builtin_route_row("jet_map_intersection", 2, [Bool]{true, true})
        .MapSliceKeys -> return ir_builtin_route_row("jet_map_slice_keys_kernel", 2, [Bool]{true, false})
        .MapContainsValue -> return ir_builtin_route_row("jet_map_contains_value", 2, [Bool]{true, true})
        .DequeGet -> return ir_builtin_route_row("jet_deque_get", 2, [Bool]{true, false})
        .StringSplitOnce -> return ir_builtin_route_row("jet_unicode_split_once", 2, [Bool]{true, true})
        .StringCutLast -> return ir_builtin_route_row("jet_unicode_cut_last", 2, [Bool]{true, true})
        .SplitWrite -> return ir_builtin_route_row("jet_split_write", 2, [Bool]{true, false})
        .GetDisjointWrite -> return ir_builtin_route_row("jet_get_disjoint_write", 2, [Bool]{true, true})
        .ViewNew(_) -> return ir_builtin_route_row("jet_view_new", 4, [Bool]{true, false, false, false})
        .ListMinMax -> return ir_builtin_route_row("jet_list_min_max", 1, [Bool]{true})
        .Indexes -> return ir_builtin_route_row("jet_iter_indexes", 1, [Bool]{false})
        .Indexed -> return ir_builtin_route_row("jet_iter_enumerate", 2, [Bool]{false, false})
        .IterSplit -> return ir_builtin_route_row("jet_iter_split_at", 3, [Bool]{false, false, false})
        .SetFrom | .SetToList | .SetSort | .SetEqual | .SetFirst | .SetValues | .SetPop | .SetReplace | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SortedSetFrom | .SortedSetToList | .SortedSetInsert | .SortedSetRemove | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .PriorityQueueRemove(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .LRUCapacity | .LRUKeys | .BitSetAdd | .BitSetRemove | .BitSetCount | .BitSetToList | .BagAdd | .BagRemove | .BagHas | .BagCount | .DequeFrom | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequePeekFront | .DequePeekBack | .DequeContains | .DequeDelete | .DequeToList | .DequeJoin | .DequeSplit | .DequeReverse -> return ir_builtin_container_route(operation)
        .OptionZip(_) | .Zip(_, _, _, _, _, _) | .Unzip -> panic("checked structural builtin requires its dedicated non-route lowering")
        .TryCollect | .IterToList | .IterCollect | .ListLazy | .Take | .Skip | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare -> return ir_builtin_iter_route(operation, receiver, carrier)
        .StringMethod(symbol) -> return ir_builtin_string_method_route(symbol)
        .ByteBufferMethod(symbol) | .ByteBufferWrite(symbol) -> return ir_builtin_byte_buffer_route(symbol)
        .ByteBufferToBytes -> return ir_builtin_route_row("JetByteBuffer::to_bytes", 1, [Bool]{true})
        .ByteBufferFrom -> return ir_builtin_route_row("JetByteBuffer::from", 1, [Bool]{true})
        .ByteBufferWithCapacity -> return ir_builtin_route_row("JetByteBuffer::with_capacity", 1, [Bool]{true})
        .Repeat -> return ir_builtin_route_row("jet_string_repeat", 2, [Bool]{true, false})
        .ListSlice -> return ir_builtin_route_row("jet_list_slice", 3, [Bool]{true, false, false})
        .ListBinarySearch -> return ir_builtin_route_row("jet_list_binary_search", 2, [Bool]{true, true})
        .ListEqual -> return ir_builtin_route_row("jet_list_equal", 2, [Bool]{true, true})
        .ListReplace -> return ir_builtin_route_row("jet_list_replace", 3, [Bool]{true, false, false})
        .StartsWith | .EndsWith | .Replace | .ToString | .KeyOrdered(_, _) -> {}
    }
    ir_builtin_route_for_receiver(operation, receiver, carrier)
}

ir_builtin_iter_route: fn(operation: TBuiltinOp, receiver: Type, carrier: TFailureCarrier) -> IRBuiltinRoute Never! {
    if operation == {
        .ListLazy -> {
            is_list_receiver := if ir_builtin_untag(receiver) == {
                .List(_) | .FixedList(_, _) -> true
                .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
            }
            if is_list_receiver {
                return ir_builtin_route_row("jet_iter_from_vec", 1, [Bool]{false})
            }
            panic("checked ListLazy builtin has a non-list receiver")
        }
        // One collector for lists and iterators: `[T E!]` becomes `[T] E!`.
        .TryCollect -> return ir_builtin_route_row("jet_list_try_collect", 1, [Bool]{false})
        .AtomicMethod(_) | .LenString | .LenList | .IsEmpty | .Push | .ListTryNew | .ListTryWithCapacity | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .StringEdit(_) | .Pop | .PriorityQueuePop | .InsertMap | .AddNewMap | .MapUpdate | .MapMerge | .MapMergeWith | .InsertList | .RemoveMap | .RemoveList(_, _) | .CountList | .Counts | .ExtendList | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .Reverse | .SwapList | .ListFill | .Sort | .SortDesc | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Flatten | .Intersperse | .Unzip | .Clear | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .StringWithCapacity | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .Take | .Skip | .IterToList | .IterCollect | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterNext | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .MapPopFirst | .ListReplace | .Indexed | .Indexes | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .SetFrom | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetPop | .SetReplace | .SetSort | .SetShuffle | .SortedSetFrom | .SortedSetInsert | .SortedSetRemove | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .PriorityQueueRemove(_, _) | .KeyOrdered(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .LRUCapacity | .LRUKeys | .BitSetAdd | .BitSetRemove | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferWrite(_) | .ByteBufferToBytes | .ByteBufferMethod(_) | .ByteBufferWithCapacity | .BagAdd | .BagRemove | .BagHas | .BagCount | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeDelete | .DequeToList | .DequeJoin | .DequeReverse | .DequeSplit | .DequeFrom | .ViewNew(_) | .SplitWrite | .GetDisjointWrite | .ListFillRepeat -> {}
    }
    if !ir_builtin_iter_receiver(receiver) {
        panic("checked iterator builtin has a non-iterator receiver")
    }
    if operation == {
        .IterToList -> return ir_builtin_route_row("jet_iter_to_list", 1, [Bool]{false})
        .IterCollect -> return ir_builtin_route_row("jet_iter_collect", 1, [Bool]{false})
        .Take -> return ir_builtin_route_row("jet_iter_take", 2, [Bool]{false, false})
        .Skip -> return ir_builtin_route_row("jet_iter_skip", 2, [Bool]{false, false})
        .StepBy -> return ir_builtin_route_row("jet_iter_step_by", 2, [Bool]{false, false})
        .Dedup -> return ir_builtin_route_row("jet_iter_dedup", 1, [Bool]{false})
        .Chunks -> return ir_builtin_route_row("jet_iter_chunks", 2, [Bool]{false, false})
        .Windows -> return ir_builtin_route_row("jet_iter_windows", 2, [Bool]{false, false})
        .Flatten -> return ir_builtin_route_row("jet_iter_flatten", 1, [Bool]{false})
        .Intersperse -> return ir_builtin_route_row("jet_iter_intersperse", 2, [Bool]{false, false})
        .IterRepeat -> return ir_builtin_route_row("jet_iter_repeat", 2, [Bool]{false, false})
        .IterCycle -> return ir_builtin_route_row("jet_iter_cycle", 2, [Bool]{false, false})
        .IterDropLast -> return ir_builtin_route_row("jet_iter_drop_last", 2, [Bool]{false, false})
        .IterShuffle -> return ir_builtin_route_row("jet_iter_shuffle", 1, [Bool]{false})
        .IterIsSorted -> return ir_builtin_route_row("jet_iter_is_sorted", 1, [Bool]{false})
        .IterLastIndexOf -> return ir_builtin_route_row("jet_iter_last_index_of", 2, [Bool]{false, false})
        .IterAverage(float) -> {
            if float -> return ir_builtin_route_row("jet_iter_average_float", 1, [Bool]{false})
            return ir_builtin_route_row("jet_iter_average_int", 1, [Bool]{false})
        }
        .IterCompare -> return ir_builtin_route_row("jet_iter_compare", 2, [Bool]{false, false})
        .AtomicMethod(_) | .LenString | .LenList | .IsEmpty | .Push | .ListTryNew | .ListTryWithCapacity | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .StringEdit(_) | .Pop | .PriorityQueuePop | .InsertMap | .AddNewMap | .MapUpdate | .MapMerge | .MapMergeWith | .InsertList | .RemoveMap | .RemoveList(_, _) | .CountList | .Counts | .ExtendList | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .Reverse | .SwapList | .ListFill | .Sort | .SortDesc | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Unzip | .Clear | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .StringWithCapacity | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .ListLazy | .IterNext | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .MapPopFirst | .ListReplace | .Indexed | .Indexes | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .SetFrom | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetPop | .SetReplace | .SetSort | .SetShuffle | .SortedSetFrom | .SortedSetInsert | .SortedSetRemove | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .PriorityQueueRemove(_, _) | .KeyOrdered(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .LRUCapacity | .LRUKeys | .BitSetAdd | .BitSetRemove | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferWrite(_) | .ByteBufferToBytes | .ByteBufferMethod(_) | .ByteBufferWithCapacity | .BagAdd | .BagRemove | .BagHas | .BagCount | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeDelete | .DequeToList | .DequeJoin | .DequeReverse | .DequeSplit | .DequeFrom | .TryCollect | .ViewNew(_) | .SplitWrite | .GetDisjointWrite | .ListFillRepeat -> panic("checked iterator operation has no canonical route")
    }
}

// A String method's route is the runtime symbol its BUILTIN_METHOD_ROWS row
// names, taking the receiver and the row's parameters. Every operand is
// borrowed but expandtabs's tab size, which that runtime function takes by
// value.
ir_builtin_string_method_route: fn(symbol: String) -> IRBuiltinRoute Never! {
    arity := 0
    loop row in BUILTIN_METHOD_ROWS {
        if row.lowering == .Builtin(operation) && operation == .StringMethod(row_symbol) && row_symbol == symbol {
            arity = row.parameters.len() + 1
            break
        }
    }
    if arity == 0 -> panic("checked StringMethod `{symbol}` has no row in BUILTIN_METHOD_ROWS")
    mask := [Bool]{}
    loop index in 0..<arity -> mask.push(index == 0 || symbol != "jet_text_expandtabs")
    ir_builtin_route_row(symbol, arity, mask)
}

// A Bytes method's route is the runtime symbol its BUILTIN_METHOD_ROWS row
// names, taking the receiver and the row's parameters. Every operand is
// borrowed (an index or count is read from its exact Int) but a written
// scalar, which the runtime takes by value.
ir_builtin_byte_buffer_route: fn(symbol: String) -> IRBuiltinRoute Never! {
    row: builtin_byte_buffer_row(symbol)
    mask := [Bool]{true}
    writes := false
    if row.lowering == .Builtin(operation) && operation == .ByteBufferWrite(_) -> writes = true
    loop parameter in row.parameters -> mask.push(!writes || parameter == .List(_))
    ir_builtin_route_row(symbol, mask.len(), mask)
}
