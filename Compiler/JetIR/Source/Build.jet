// The IR builder: checked functions to IR. A construct the builder does not
// handle yet fails its function with one message naming the construct; the
// module build keeps going and reports every failure (collect-all).
use {
    jet_backend.[X64_DEBUG_ITEMS_DROP_SYMBOL]
    jet_foundation.[CORE_BUILTINS_MODULE, MODULE_CORE_PREFIX, CompilerThreads, CompilerTraceSink, DeclID, DeclTable, Interner, TYPE_ID_POINTER, TypeID, decl_table_find, ModuleID, SourceFile, Span, SymbolID, SymbolTable, Type, TypeTupleField, TConstantDef, NodeKind, TExprType, TFailureCarrier, FnBody, TFuncKind, TGenericParam, TImplDef, BodyLambda, TLocal, TTryConvert, TTypeDef, NameVisibility, compiler_take_rows, compiler_threads_admit, compiler_threads_joined, compiler_threads_taken, compiler_threads_partition, compiler_threads_single, compiler_transfer_rows, interner_empty, symbol_table, type_carrier_identity, type_structural_args, type_structural_head_names, BodyNode, BodyTree, StmtKind, body_fixed_timing, body_node, body_node_index, body_tree_new, module_none, BodyParameter, TEffectFacts, TEffectSpan, TWebParamReconstruction, body_stmt, body_type, body_type_id, symbol_is_local, symbol_local_keys_text, symbol_none, symbol_table_key, NameTable, name_column, name_column_get, name_column_set, name_column_set_first, name_column_table, name_column_value, name_count, name_find, name_index, name_intern, name_pair_find_slot, name_pair_slot, name_table_sized, OWNED_TRAITS, owned_trait_arithmetic, owned_trait_operator_hook, ir_host_value_name]
    jet_sema.[SemaCheckedForeignFunction, sema_inference_substitute_type]
}

IRBuildFailure: struct {
    key: String,
    name: String,
    message: String,
    source_file: String,
    span: Span,
}

IRBuildResult: struct {
    program: IRModule,
    failures: [IRBuildFailure],
}

// A build that hands its checked program back (ir_build_roots_in): the
// program serves the next build over the same declarations.
IRBuildKept: struct {
    result: IRBuildResult,
    program: IRProgram,
}

// A visible name: `slot` holds the variable named `name`. `indirect` is the
// type row of the value when `slot` holds its address (a write parameter, or
// a variable a closure writes, kept in a frame cell); -1: the slot is the
// variable itself. `owned`: the variable owns its value, which is dropped
// when its scope ends (every other holder of the value has its own copy).
// `symbol`: the checked symbol of a variable that has one (an id of its body's
// tree; symbol_none: none). `write`: an
// aggregate write parameter (or receiver), whose slot addresses the caller's
// storage, so a whole-value assignment writes there. `carrier`: the carrier
// box slot a payload binding was read from (-1: none). `live`: for an owned
// variable some paths moved and others kept, the Bool slot that holds
// whether it still holds its value (-1: it does wherever it owns it).
// `cleanup`: an entry that names no variable but a `defer` body, its row in
// IRBuilder.defers, which runs where the entry would drop (-1: none).
IRBinding: struct {
    name: String,
    slot: Int,
    indirect: Int{-1},
    owned: Bool{false},
    symbol: SymbolID{symbol_none()},
    write: Bool{false},
    carrier: Int{-1},
    live: Int{-1},
    cleanup: Int{-1},
}

// A write argument passed through a frame cell: after the call the variable
// `slot` reads its value back from `cell`. A temporary given the cell as its
// place (`ends`) ends once read back (ir_write_backs).
IRWriteBack: struct {
    cell: Int,
    slot: Int,
    ends: Bool{false},
    link_mode: Int{0},
}

// An open loop: `exit` is the Block that `break` leaves, `next` the
// construct that `next` (continue) leaves or restarts; `mark` the bindings
// visible when it opened (leaving it drops the owned ones declared since);
// `guards` the statement guards held when it opened (leaving it drops the
// ones taken since, ir_exit_statement_guards).
// A valued loop (`x: loop { ... break v }`) writes its break value into
// `value` (-1: a statement loop). `edge` is the word each `break` sets to
// tell its path apart where the loop's exits meet (ir_loop_edge; -1: none).
IRLoopFrame: struct {
    label: String?,
    exit: Int,
    next: Int,
    mark: Int,
    guards: Int,
    value: Int{-1},
    edge: Int{-1},
}

// A `break` out of the loop whose edge word is `edge`: the id it set that
// word to and the ownership where it left of the variables bound before
// the loop (IRLoopFrame.mark), which its drops left as they were.
IRLoopEdge: struct {
    edge: Int,
    id: Int,
    states: [IROwnState],
}

// A guard a temporary in the statement being built took, or a temporary
// with cleanup lent to a read parameter (IRBuilder statement_guards): its
// slot, and where it was taken: the innermost open construct then (-1:
// none) and, for an If, its Else then (-1: the then part), so an early exit
// ends it only where it is held. `glue` closes the temporary first (-1: it
// only drops); `drops` is whether its type has a drop.
IRStatementGuard: struct {
    slot: Int,
    opener: Int,
    part: Int,
    glue: Int{-1},
    drops: Bool{true},
}

// An open `.expect_fail` region (BuildTests.jet ir_scope_member): `scope`
// the slot holding its scope id, `exit` the Block a caught stop leaves,
// `mark` the bindings and `transactions` the open #Transact blocks when it
// opened.
IRCatchFrame: struct {
    scope: Int,
    exit: Int,
    mark: Int,
    transactions: Int,
}

// A `#Memo` function's store (BuildMemo.jet): `cell` the slot holding its
// static cell's address, `entry` the slot holding the entry a miss opened
// (the arguments' copies at `offsets`, typed `rows`; the result at
// `value_offset`; `size` bytes in all), `bound` its entry bound (-1: none).
IRMemo: struct {
    cell: Int,
    entry: Int,
    rows: [Int],
    offsets: [Int],
    value_offset: Int,
    size: Int,
    bound: Int,
}

// Per-function build state. `fresh[slot]` marks a temporary that holds a
// value nobody else owns yet (a call result, a built String): a borrowing
// consumer drops it after use.
IRBuilder: struct {
    f: IRFunction,
    bindings: [IRBinding],
    scopes: [Int],
    loops: [IRLoopFrame],
    fresh: [Bool],
    // The subject slots of the open switches (innermost last).
    subjects: [Int],
    // Pattern bindings of the condition being built, bound when its If opens.
    pending: [IRPending],
    // The address a write window's inline Option subject was read from, by
    // the subject slot (BuildExpr.jet ir_borrow): its payload binds there.
    windows: [Int:Int]{[Int:Int]{}},
    // The allocator storage an allocator view was read from, by the view
    // slot (BuildAllocators.jet): a variable bound to the view aliases it.
    views: [Int:Int]{[Int:Int]{}},
    line: Int,
    error: String,
    error_span: Span,
    // The function's executable return (None: Unit), its failure carrier, and
    // whether it hands back the plain success of a `T Never!` carrier.
    ret: Type?,
    failure: TFailureCarrier,
    plain: Bool,
    // Variables some closure of this body writes: they live in frame cells
    // from their declaration, so every read sees the closure's writes.
    cells: [String],
    // Calls emitted where the program is only read (display impls): their
    // callee ids are resolved when the function is done.
    deferred: [IRDeferredCall],
    // The variables that close their values when their scopes end, the
    // values read out of such a value, and the parts moved out of one
    // (BuildOwn.jet).
    closes: [IRClose],
    places: [IRPlace],
    moved: [IRMovedPart],
    part_closes: [IRPartClose],
    // The open `#Transact` blocks (innermost last) an early exit unwinds.
    transactions: [IRTxFrame],
    // The `defer` bodies built so far, by IRBinding.cleanup row.
    defers: [[Int]]{[[Int]]{}},
    // The open contract scopes (innermost last) whose `post` clauses a
    // return checks.
    contracts: [IRContractFrame],
    // The variable slot an explicit move (`x.move()`) just read (-1: none): that
    // read moves even where a plain read of the variable would share.
    moving: Int{-1},
    // The Bool slot the arm of a masked branch being built runs under (-1:
    // none): an assignment there keeps its old value where it is false
    // (BuildMask.jet).
    mask: Int{-1},
    // A function with masked early returns (BuildMask.jet ir_masked_exits):
    // the Bool variable no masked return has run yet and the variable
    // holding the value one chose (-1: none), and whether the code being
    // built may run after one, so its assignments are masked by `live`.
    live: Int{-1},
    exit_value: Int{-1},
    exiting: Bool{false},
    // Per type of the checked body's type table, whether it is fixed
    // (BuildMask.jet ir_fixed_types; empty when none is): a scalar slot of
    // such a type is marked fixed (IRFunction.slot_fixed).
    fixed_ids: [U32:Bool]{[U32:Bool]{}},
    // The `#Impure` blocks open around the code being built: a build host
    // call made inside one may touch the ambient world (ir_host_method).
    impure: Int{0},
    // The checked function this body is built from, by its row in the
    // program's functions (None: glue, built from none), whose body
    // (ir_builder_body) holds the nodes and statements it reads; and the
    // nodes and statements the builder made itself (ir_node, ir_stmt_node)
    // with the next node id it hands out.
    row: Int?{None},
    made: BodyTree{BodyTree{nodes: [BodyNode]{}, stmts: [StmtKind]{}, expr_types: [TExprType]{}}},
    next_node: Int{IR_FIRST_NODE_ID},
    // How many closures of each kind this body created so far, at the
    // kind's id in `lambdas_keys` (ir_closure_key).
    lambdas_keys: NameTable{name_column_table()},
    lambdas: [Int]{name_column()},
    // Building a stop edge (ir_stop_return): its cleanup checks for no stop.
    stopping: Bool{false},
    // A body the runtime calls for a status word and trusts without a stop
    // check of its own (a line source's next: IterSources.jet
    // iter_source_pull): its stop edges return -1, the stopped status, not
    // whatever the last call left in the result register.
    stop_status: Bool{false},
    // The open `.expect_fail` regions (innermost last) whose catch a stop
    // edge tries first (ir_stop_catches).
    catches: [IRCatchFrame]{[IRCatchFrame]{}},
    // A `#Memo` function's result store: each return files its result
    // (ir_memo_file).
    memo: IRMemo?{None},
    // The slot and instruction counts where the innermost open
    // `#Context(allocator: a)` block of this body began (0 with none open:
    // all of this body's frame is younger than every block open when it
    // runs): storage it reserved after them is younger than the block
    // (BuildRoutes.jet ir_list_grow_buffer).
    young_slots: Int{0},
    young_ops: Int{0},
    // Building the program entry itself (IRProgram.entry, not a lambda or a
    // generic instance in it): its end and each return first report the
    // entry returning (ir_entry_ending), so its drops can leave the heap to
    // the kernel (#5478).
    entry: Bool{false},
    // The checked program, set while a `#Transact` block with snapshots is
    // built (ir_transact): its stop edges restore them (ir_stop_return),
    // which builds their Rollback calls and assignments.
    program: IRProgram?{None},
    // What a failed bounds check of this body does (ir_checked_address):
    // the program's mode in a function of a module IRChecks names, else Fatal.
    bounds: IRBoundsMode{IRBoundsMode.Fatal},
    // The index nodes (AutoVectorizationFacts.proven_indexes) of the loops
    // being built (ir_range_loop), each with the row of its loop's proof
    // (IRFunction.loop_proofs; -1: the loop is done): the access at such an
    // index has no bounds check (ir_checked_element).
    proven_index: [Int:Int]{[Int:Int]{}},
    // Guards taken by a temporary in the statement being built
    // (`store.guard_edit().value.items[key] = text`), and temporaries with
    // cleanup lent to a read parameter (`show(open("x"))`): they end with
    // the statement (ir_stmt), or on an early exit out of it
    // (ir_exit_statement_guards).
    statement_guards: [IRStatementGuard]{[IRStatementGuard]{}},
    // How many constructs were open when the statement being built began
    // (-1: none is being built). A temporary made deeper, in a branch or a
    // loop condition of the statement, ends where it is made instead
    // (ir_close_temporary).
    statement_depth: Int{-1},
    // Values the body only borrows, which it never closes (ir_lent): a
    // `Val`/`Ok`/`Err` carrier or aggregate built around a value it does not
    // own (a variable or parameter, or another lent value), the result of a
    // call that returns a view (`-> T from self | x`), and any part, binding
    // or `?` payload of a lent value. Their owner closes them.
    lent: [Int:Bool]{[Int:Bool]{}},
    // The instance this body builds (IRInstance; none for a body that is no
    // generic instance).
    instance: IRInstance{IRInstance{names: [String]{}, args: [Type]{}}},
    // The failures of the statements of the body's outermost block kept so
    // far (ir_stmt_collecting), and the binders those statements declared,
    // whose later reads follow from those failures.
    failures: [IRFailureRow]{[IRFailureRow]{}},
    poisoned: [String]{[String]{}},
    // A generator's producer body (BuildGenerator.jet): the slot holding its
    // runtime state, which each `yield` hands its value to (-1: no producer).
    generator: Int{-1},
    // The `Err(...)` nodes a `return` being built hands back from the tail of
    // a valued `if` or block (ir_return): building one starts its failure's
    // journey there, as `return Err(...)` does.
    origins: [Int]{[Int]{}},
    // The probe a Map entry update made before building its value
    // (BuildMaps.jet ir_map_update): a `get` of that map and key in the value
    // answers from the entry it found.
    probe: IRMapProbe?{None},
    // The `Let` of a Map group update being built (BuildMaps.jet
    // ir_map_take_fuses; -1: none): its `group` binds the write window of
    // the map's entry (ir_map_take).
    map_take: Int{-1},
    // The stores of the group updates being built (`map[key] = group`):
    // the window already wrote the entry, so each builds nothing.
    map_stores: [Int]{[Int]{}},
    // The statement being built spawns a grouped task the next statement
    // joins first (BuildCoreClosures.jet ir_spawn_joined_next): its spawn
    // defers the task to that join (ir_task_spawn).
    spawn_joined: Bool{false},
    // A task body (ir_task_spawn) or a narrowing function-value adapter
    // (ir_fn_widen): a failure that leaves it stops as `panic` does, which a
    // task's join reports as TaskFailure.Panicked (ir_try_failure).
    failure_stops: Bool{false},
    // The breaks built so far (ir_loop_jump), whose ownership meets that of
    // their loop's other exits after it (ir_loop_join).
    loop_edges: [IRLoopEdge]{[IRLoopEdge]{}},
    // A `??` or `?` that reads its operand's success straight from a Result
    // route's words (ir_expr_split): `split_armed` holds from the operand's
    // dispatch to the closing route call of its handle method or Core call
    // (ir_handle_method, ir_core_call_routed), never across its receiver,
    // its arguments (ir_expr) or a dedicated builder that may branch around
    // or use its route call. That call, of type `split_ty`, leaves its
    // selector and out words in `split` instead of a Result box
    // (BuildRoutes.jet ir_route_result). `split` holds at most that one
    // call; it is a list so the `??` or `?` pops it out of the builder
    // without a copy.
    split_armed: Bool{false},
    split_ty: Type{Type.Int},
    split: [IRRouteSplit]{[IRRouteSplit]{}},
    // The operand of the `??` whose payload a place-borrowing Let binds
    // (JetSema PlaceBorrows.jet; -1: none): ir_or_fallback lends the payload
    // where its place holds it instead of copying it into a value of its own.
    or_lend: Int{-1},
}

// One failure of a body: its message and the span it names.
IRFailureRow: struct {
    message: String,
    span: Span,
}

// The entry `found` (negative: none) a probe of the map in slot `map` for the
// key in slot `key` found.
IRMapProbe: struct {
    map: Int,
    key: Int,
    found: Int,
}

// A generic instance being built: the type parameters it binds
// (ir_generic_names), their arguments, and sema's types of its checked
// function's tree at those arguments, row for row with the tree's type table
// (jet_sema sema_instance_types). The builder reads an instance type by row
// and never substitutes one (ir_fact_type).
IRInstance: struct {
    names: [String],
    args: [Type],
}

// The Call at instruction `at` of function `function` (-1: the function
// being built) names the checked function `key` applied to `args`.
IRDeferredCall: struct {
    at: Int,
    key: String,
    function: Int{-1},
    args: [Type]{[Type]{}},
}

// The `bounds` build option (JetFoundation BuildOptions.jet): what a failed
// list bounds check does. Fatal stops the program (ir_list_bounds_stop);
// Report writes the failure (ir_list_bounds_report) and goes on with the
// access; Off drops the check.
IRBoundsMode: enum {
    Fatal,
    Report,
    Off,
}

// The runtime checks a program keeps, and what else of the build options the
// builder reads. `bounds` holds in the functions of `modules` (module
// identities: the code the built package wrote). Every other function keeps
// Fatal, so a dependency's function, generic or not, keeps its writer's check
// wherever it is instantiated or inlined. `backtrace` is the `backtrace`
// build option (ir_entry_function passes it to the runtime); `keep` the
// `dead_code: keep` option: every non-generic function of `modules` is built
// as a root next to the entry (ir_build_program).
IRChecks: struct {
    bounds: IRBoundsMode,
    modules: [U32:Bool],
    backtrace: IRBacktrace,
    keep: Bool,
    // The entry package's `allocator:` policy: Val(cap) wraps the system
    // heap in the counting allocator capped at `cap` bytes (0: no cap), so a
    // fallible allocation past the cap fails (ir_entry_function passes it to
    // jet_rt_program_allocator_configure); None keeps the system heap.
    counting: Int?{None},
    // The jobs the program's first word can select ahead of
    // the entry; the entry function calls each (ir_entry_function). The word
    // of a `passthrough_jobs` job (an `.Internal` one, or one with typed
    // arguments) is an ordinary program argument. Under `unknown_jobs` (an
    // entry that parses no argv of its own) and a job that is not stripped,
    // any other first word is the unknown-job report (E1294), which lists
    // `declared_jobs`.
    jobs: [IRJob]{[IRJob]{}},
    passthrough_jobs: [String]{[String]{}},
    declared_jobs: [String]{[String]{}},
    unknown_jobs: Bool{false},
    // `--checked-alloc` (the `checked_alloc` build option): the entry calls
    // jet_rt_alloc_check_link, so the link keeps the runtime's checked heap
    // (ir_checked_alloc_link).
    checked_alloc: Bool{false},
    // `zones: strip`: the image keeps no core.perf zone sites
    // (IRModule.zones_stripped).
    zones_stripped: Bool{false},
    // `jet run --observe`: the entry calls jet_rt_observe_link, so the link
    // keeps the runtime's observation start (ir_observe_link).
    observe: Bool{false},
    // The entry package's `log:` field and `jet run --log`: the level
    // filters the entry passes to the runtime (ir_log_configure).
    log_package: String{""},
    log_flag: String{""},
    // The entry package's name in a program that links the device store
    // (JetRuntime World.jet): the entry passes it to the runtime first, which
    // keeps the store under it (ir_device_package).
    entry_package: String{""},
    // The entry package's `policy.harden` or the `hardened` profile: a
    // release build keeps the memory sentry (ir_checks_sentries), and when
    // a function holds a `timing: .Fixed` value, the entry first calls
    // jet_rt_timing_admit, which ends the program on an unconfirmed host
    // (ir_timing_admitted).
    harden: Bool{false},
    // A release build (the `release` or `hardened` profile): an
    // `#Off(.Release)` body emits no code (ir_stmt).
    release: Bool{false},
    // `--deep-checks`: the checked functions whose `#On(.Deep)` bodies emit
    // code (ir_deep_checks_on), bound at their key's id in `deep_keys`;
    // every other one emits none.
    deep_keys: NameTable{name_column_table()},
    deep: [Int]{name_column()},
    // A program bound to the prelinked runtime image that carries Core's
    // code (#6328 c22 S7b-1, JetCLI Host.jet jet_cli_native_executable):
    // the image's Core exports. Its direct calls of an exported Core
    // function call the image's code (ir_core_bound) and its Core cells are
    // the image's (ir_core_cells_bind), when its functions build as the
    // library's (ir_core_image_fits). None builds every Core function it
    // calls.
    core: IRCoreImage?{None},
    // A build with debug information: each DebugView implementation's
    // `debug_view` is built as a root next to the entry (ir_build_program),
    // so a debugger can call it on a stopped program's value.
    debug_views: Bool{false},
    // The program's `#Export(c)` definitions of the runtime's provider hooks
    // (JetFoundation RUNTIME_PROVIDER_HOOKS), a scheduler provider's run
    // queue: each is built as a root beside the entry (ir_build_program) and
    // is a global symbol of the program's object (IRModule.hooks), so the
    // link binds the runtime's calls of the hook to it.
    hooks: [IRLibraryExportRow]{[IRLibraryExportRow]{}},
    // Checked function keys built as roots beside the entry
    // (ir_build_program): a debugger's evaluated expression, which nothing
    // in the program calls.
    roots: [String]{[String]{}},
    // The runtime routes the runtime's stops receipt proves deliver no stop
    // (JetCLI Host.jet jet_cli_runtime_quiet_routes), which no stop poll
    // follows (ir_route_can_stop); empty without a receipt.
    quiet_routes: NameTable{name_table_sized(2)},
    // Sorted newline-separated runtime exports and stopping exports bytes
    // (shared read-only across wave workers without building a NameTable).
    quiet_exports: [U8]{[U8]{}},
    quiet_stops: [U8]{[U8]{}},
    // A debugger's evaluation against a running O0 image (ir_held_program):
    // the program functions, by key, that the image holds under their own
    // symbol (ir_symbol_name), which no other function shares. A direct
    // call of one calls the image's code there and builds no body for it
    // (ir_held_bound). Empty builds every function it calls.
    held: NameTable{name_table_sized(2)},
}

// An argv-selectable job: the checked function `key` that the program word
// `name` runs instead of the entry. A `stripped` job is one a release build
// does not ship (any but `#Job(.Ship)`): its word is an unknown job.
IRJob: struct {
    key: String,
    name: String,
    stripped: Bool,
}

// The `backtrace` build option: what a native fault report prints after its
// first line (JetRuntime Fault.jet). Its word is the order here, the value
// jet_rt_fault_backtrace takes.
IRBacktrace: enum {
    Full,
    Brief,
    Off,
}

ir_checks_stock: fn() -> IRChecks Never! {
    IRChecks{bounds: IRBoundsMode.Fatal, modules: [U32:Bool]{}, backtrace: IRBacktrace.Full, keep: false}
}

// The checks of the resolved `bounds` value (`fatal`, `report` or `off`),
// `backtrace` value (`full`, `brief` or `off`) and `dead_code` value
// (`remove` or `keep`) over `modules`.
ir_checks_of: fn(bounds: String, backtrace: String, dead_code: String, modules: [U32:Bool]) -> IRChecks Never! {
    mode: if bounds == {
        "fatal" -> IRBoundsMode.Fatal
        "report" -> IRBoundsMode.Report
        "off" -> IRBoundsMode.Off
        else -> panic("`{bounds}` is not a value of the `bounds` build option")
    }
    trace: if backtrace == {
        "full" -> IRBacktrace.Full
        "brief" -> IRBacktrace.Brief
        "off" -> IRBacktrace.Off
        else -> panic("`{backtrace}` is not a value of the `backtrace` build option")
    }
    IRChecks{bounds: mode, modules: modules, backtrace: trace, keep: dead_code == "keep"}
}

// The bounds mode of a body built from `function` (glue's names no module:
// Fatal).
ir_bounds_mode: fn(p: IRProgram, function: FnBody) -> IRBoundsMode Never! {
    if p.checks.bounds == .Fatal || p.checks.modules.get(function.module_identity.id) == None {
        return IRBoundsMode.Fatal
    }
    p.checks.bounds
}

// Do the `#On(.Deep)` bodies of `function` emit code: the compile's
// `--deep-checks` request selects it (glue's names no key: none).
ir_deep_checks_on: fn(p: IRProgram, function: FnBody) -> Bool Never! {
    name_column_get(p.checks.deep_keys, p.checks.deep, function.key) != None
}

// The checked program the builder reads: the checked functions every IR
// function id may name, by key, and the checked type declarations, by key
// and by name. It is read-only while functions are built; the build state
// (queue, instances, substitution) lives in IRModule. A generic function is
// built once per distinct list of concrete type arguments (monomorphized).
IRProgram: struct {
    functions: [FnBody],
    // The body a glue builder reads (ir_builder_body): glue is built from no
    // checked function, so its one body is empty (ir_glue_body).
    glue: [FnBody]{[FnBody]{ir_glue_body()}},
    // Each function key's first row in `functions` (ir_first_function_rows).
    rows: IRFunctionRows,
    // The run's symbol table: the key of each run-wide SymbolID a checked
    // declaration or body names (ir_symbol_key).
    symbols: SymbolTable,
    // The compilation's hash-consed type and name interner (TypeIDs.jet).
    interner: Interner,
    types: [TTypeDef],
    type_rows_keys: NameTable,
    type_rows: [Int],
    // Checked constants (ConstRef / CtLit values): each key's row in
    // `constant_defs`, at the key's id in `constants_keys`
    // (ir_constant_row). A read borrows the row in place; the column holds
    // no definition, so neither a read nor a landed value copies one.
    constants_keys: NameTable,
    constants: [Int],
    constant_defs: [TConstantDef],
    // A selected Display (`display`), Printable (`show`) or user Comparable
    // (`compare`) implementation method by "<trait>|<rendered type key>"
    // (at the key's id in `render_impls_keys`).
    render_impls_keys: NameTable,
    render_impls: [Int],
    // The selected Close implementation method (`close`) by rendered type
    // key.
    close_methods_keys: NameTable,
    close_methods: [Int],
    // The implementation methods a dynamic trait call may select, by
    // (trait, method) (function rows; see ir_trait_methods).
    trait_methods: IRTraitMethods{IRTraitMethods{}},
    // The host target's trait implementations, read once by
    // ir_program_declared: the traits each implementing method serves, by
    // "<module>|<owner key>|<method>" (`impl_slots` rows of `impl_traits`),
    // and the Display, Printable, Close and user Comparable implementations
    // (`impl_methods`) whose methods ir_program_bind selects among the bound
    // functions.
    impl_slots_keys: NameTable,
    impl_slots: [Int],
    impl_traits: [[String]],
    impl_methods: [IRImplMethod],
    // The payload key of each type a trait implementation is declared for
    // (ir_trait_key_table, read by ir_trait_key), found once by
    // ir_program_declared.
    trait_keys: IRTraitKeys{IRTraitKeys{}},
    // The host target's trait implementations that declare no method (an
    // empty trait's): no function names their owner, so ir_trait_implementers
    // reads the owner here.
    empty_impls: [IREmptyImpl]{[IREmptyImpl]{}},
    // The generic instances (`Box<Int>`) the bound functions box as values
    // of each trait, by the trait's short name (ir_trait_boxed): an
    // implementation for the generic owner (`impl Box.Shape`) serves each one
    // a trait value may hold.
    trait_boxed: IRTraitBoxed{IRTraitBoxed{}},
    // Where a `#Context(print: …)` block sets a print style (BuildTraits.jet
    // IRPrintStyle), None when none does: Print then renders as Show, with
    // no style lookup (BuildTypes.jet ir_print_style_find).
    print_style: IRPrintStyle?{None},
    // The checked source files' bytes and line starts by row, and each
    // path's row at its id in `source_rows_keys`: a source location reads
    // the file in place.
    source_bytes: [[U8]],
    source_lines: [[Int]],
    source_rows_keys: NameTable{name_column_table()},
    source_rows: [Int]{name_column()},
    // The checked foreign functions a call may name: each function key's
    // row in `foreign_rows`, at the key's id in `foreign_keys`.
    foreign_keys: NameTable{name_column_table()},
    foreign: [Int]{name_column()},
    // The intrinsics by function key (BuildLibrary.jet): a call of one is
    // its machine operation, never a call. A program has Core's
    // (ir_core_intrinsics); a runtime library adds its own.
    intrinsics: IRIntrinsics{ir_intrinsics()},
    // Cutover B L2b: by DeclID row, each declaration's first function row
    // (-1: none) and its checked foreign row in `foreign_rows` (-1: none).
    // A direct call (NodeKind.Call) finds its callee here, by no key.
    decl_rows: [Int]{[Int]{}},
    decl_foreign: [Int]{[Int]{}},
    foreign_rows: [SemaCheckedForeignFunction]{[SemaCheckedForeignFunction]{}},
    // The C handle types the foreign functions name, by nominal name, with
    // their close (BuildForeign.jet ir_foreign_handle_row): each name's row
    // of `foreign_handle_rows` at its id in `foreign_handles_keys`.
    foreign_handles_keys: NameTable{name_column_table()},
    foreign_handles: [Int]{name_column()},
    foreign_handle_rows: [IRForeignHandle]{[IRForeignHandle]{}},
    // Whether the modules built from it check for a runtime stop after each
    // call that can deliver one (IRModule.stop_points); false only for the
    // runtime library (ir_build_library).
    stop_points: Bool{true},
    // Whether `#FFI(asm)` leaves may be the runtime's closed rails (the fiber
    // switch, GS base write and signal return, X64/InlineAsm.jet): true only for a library
    // that defines the fiber entry the switch starts fresh stacks in
    // (ir_build_library), never for a program.
    asm_rails: Bool{false},
    // Whether `#Unsafe` scopes enter the runtime sentry and raw accesses are
    // checked by it (BuildSentry.jet): for a program or test image, as its
    // checks have it (ir_checks_sentries, in ir_build_program and
    // ir_build_tests); false for the runtime library the sentry is part of
    // and for compile-time evaluation.
    sentries: Bool{false},
    // Whether the modules built from it serve the program's own values
    // (IRModule.user_values): a program, test or Core image, whatever its
    // checks; false for the runtime library and compile-time evaluation.
    user_values: Bool{false},
    // Whether the modules built from it list their zone sites in a table the
    // runtime patches (IRModule.zone_table): every module an image links (a
    // program, test, library or Core); false for a debugger's held
    // evaluation and compile-time evaluation, whose sites test the zones
    // word.
    zone_table: Bool{false},
    // Whether each checked `#Pre`/`#Post` clause reports its outcome to the
    // runtime's contract records (BuildContracts.jet ir_contract,
    // JetRuntime TestContracts.jet): true only for a test image
    // (ir_build_tests), whose records `jet prove` reads.
    contract_records: Bool{false},
    // `jet test --coverage`: the functions whose entry records its line
    // (ir_coverage_probe); empty for every other build.
    coverage: IRCoverage{ir_coverage()},
    // The ordinal of each `task` spawn site among its file's spawn sites in
    // source order, by "{source file}:{span start}"
    // (ir_program_scan_bodies_apply), at
    // the site's id in `spawn_sites_keys`: the "spawn site N" of task
    // reports.
    spawn_sites_keys: NameTable{name_column_table()},
    spawn_sites: [Int]{name_column()},
    // The function rows of the Core functions that fill a jet_builtins role
    // (FnBody.role), in row order, found once by ir_program_bind: a precise
    // operation or a decode finds its helper among them (ir_core_role_row).
    core_roles: [Int]{[Int]{}},
    // The declared hook and decision points that no handler can reach, by
    // constant row (`constants`), found once by ir_program_bind
    // (ir_quiet_points): every read of one is the receiver of a `run`, so no
    // code attaches a handler, and each run is its fallback (ir_hook_run) or
    // its own payload, continued (ir_decision_hook_run). The Core library
    // keeps only the points no program can name (BuildCore.jet
    // ir_core_quiet_points).
    quiet_points: [Int:Bool]{[Int:Bool]{}},
    // Whether this program's code computes compile-time values (comptime
    // items, not a build invocation): outside an `#Impure` block, a Core
    // call that reads ambient host or process state with no system call the
    // comptime child's filter could refuse is refused when evaluation
    // reaches it (ir_comptime_ambient_refusal).
    comptime_values: Bool{false},
    // Whether this program is a build invocation (fn build, fn dev) the
    // evaluator runs in its runtime child: each Core or function call inside
    // an `#Impure` block is bracketed by the host routes `Impure.enter` and
    // `Impure.leave` (ir_core_call, ir_call_row_emit), so when the package
    // holds `Meta.Host` the child admits the file calls it makes, and a
    // system call the child's filter refuses there is that block's Tier-2
    // effect, not an unsupported one.
    invocation: Bool{false},
    // The program entry's function row (ir_build_program; -1: no entry): its
    // returns tell the runtime the process is ending (ir_emit_return).
    entry: Int{-1},
    // The runtime checks the built functions keep (ir_bounds_mode).
    checks: IRChecks{IRChecks{bounds: IRBoundsMode.Fatal, modules: [U32:Bool]{}, backtrace: IRBacktrace.Full, keep: false}},
}

// A Display, Printable, Close or user Comparable implementation: the
// method it selects, its trait's short name and its owner's rendered type key.
IRImplMethod: struct {
    method: String,
    trait_short: String,
    owner_key: String,
}

// A trait implementation that declares no method: its trait's short name
// and its owner type.
IREmptyImpl: struct {
    trait_short: String,
    owner: Type,
}

// The checked source files' text by path, each path once: `texts[id]` holds
// the text of the path at id `id` of `keys` (id 0, the empty path, holds "").
// The driver gathers them (ir_source_texts); ir_program_new indexes them.
IRSourceTexts: struct {
    keys: NameTable{name_column_table()},
    texts: [String]{[String]{""}},
}

// The texts of `files`, the first file's of each path.
ir_source_texts: fn(files: [SourceFile]) -> IRSourceTexts Never! {
    sources := IRSourceTexts{keys: name_column_table(files.len()), texts: [String]{""}}
    loop file in files {
        if name_find(sources.keys, file.path) != None -> next
        _ := name_intern(sources.keys, file.path)
        sources.texts.push(file.source)
    }
    sources
}

// The text of checked source `path`, if `sources` holds it.
ir_source_text: fn(sources: IRSourceTexts, path: String) -> String? Never! {
    found: name_find(sources.keys, path) ?? return None
    Val(sources.texts[name_index(found)])
}

// The checked source files as rows of bytes and line starts:
// IRProgram's `source_bytes`, `source_lines`, `source_rows_keys` and
// `source_rows`.
IRSourceIndex: struct {
    bytes: [[U8]],
    lines: [[Int]],
    keys: NameTable,
    rows: [Int],
}

// The source bytes (all files) worth indexing on a thread of their own
// (ir_program_new): the index is one scan and copy of each byte, the work
// the driver keeps on its thread below JET_DRIVER_INLINE_SCAN_MIN_BYTES.
IR_SOURCE_INDEX_MIN_BYTES: 262144

ir_source_index: fn(sources: IRSourceTexts) -> IRSourceIndex Never! {
    count: sources.texts.len()
    index := IRSourceIndex{bytes: [[U8]]{}, lines: [[Int]]{}, keys: name_column_table(count), rows: name_column(count)}
    loop id in 1..<count {
        bytes := sources.texts[id].bytes()
        name_column_set(index.keys, index.rows, sources.keys.texts[id], index.bytes.len())
        index.lines.push(ir_source_line_starts(bytes))
        index.bytes.push(bytes)
    }
    index
}

// The `source_bytes` / `source_lines` row of checked source `path`.
ir_source_row: fn(p: IRProgram, path: String) -> Int? Never! { name_column_get(p.source_rows_keys, p.source_rows, path) }

// The byte offset each line of `bytes` starts at.
ir_source_line_starts: fn(bytes: [U8]) -> [Int] Never! {
    starts := [Int]{0}
    loop (at, byte) in bytes {
        if byte == (U8{10}) -> starts.push(at + 1)
    }
    starts
}

// The 1-based line holding byte `offset` of `path`; None when the file is not
// a checked source.
ir_source_line_of: fn(p: IRProgram, path: String, offset: Int) -> Int? Never! {
    row: ir_source_row(p, path) ?? return None
    low := I64{0}
    high := I64{p.source_lines[row].len()}
    loop low < high {
        middle: Int{(low + high) >> I64{1}}
        if p.source_lines[row][middle] <= offset -> low = I64{middle} + I64{1} else {
            high = I64{middle}
        }
    }
    Val(Int{low})
}

// The 1-based character column of byte `offset` of `path`: 1 when the file is
// not a checked source, None when the offset falls outside it.
ir_source_column: fn(p: IRProgram, path: String, offset: Int) -> Int? Never! {
    row: ir_source_row(p, path) ?? return Val(1)
    if offset < 0 || offset > p.source_bytes[row].len() -> return None
    column := I64{1}
    at := I64{offset}
    zero: I64{0}
    loop at > zero {
        at -= I64{1}
        byte: p.source_bytes[row][Int{at}]
        if byte == (U8{10}) -> break
        if byte < (U8{128}) || byte >= (U8{192}) -> column += I64{1}
    }
    Val(Int{column})
}

// Line `line` of `path` without its line break: "" when the file is not a
// checked source; None when the line is outside it or not UTF-8.
ir_source_line_text: fn(p: IRProgram, path: String, line: Int) -> String? Never! {
    row: ir_source_row(p, path) ?? return Val("")
    if line < 1 || line > p.source_lines[row].len() -> return None
    start: p.source_lines[row][line - 1]
    end := start
    loop end < p.source_bytes[row].len() && p.source_bytes[row][end] != (U8{10}) -> end += 1
    if end > start && p.source_bytes[row][end - 1] == (U8{13}) -> end -= 1
    text := [U8]{}
    loop at in start..<end -> text.push(p.source_bytes[row][at])
    Val(String.from_bytes(text) ?? return None)
}

// A function waiting to be built: its checked row, IR id and type
// arguments, or the lambda job it builds (`lambda` >= 0).
IRQueued: struct {
    row: Int,
    id: Int,
    args: [Type],
    lambda: Int{-1},
}

// A lambda body to build as its own function: the box holds its captures
// at their offsets; the instance it was created under; the checked
// function whose tree holds its nodes and the nodes the creating builder
// made (IRBuilder `row`, `made`, `next_node`); whether it is a task body or
// an adapter narrowing a failing function value (ir_fn_widen), which both
// stop on a failure that leaves them (IRBuilder `failure_stops`).
IRLambdaJob: struct {
    lambda: BodyLambda,
    captures: [IRCaptureSlot],
    source_file: String,
    line: Int,
    instance: IRInstance,
    row: Int?,
    made: BodyTree,
    next_node: Int,
    task_body: Bool{false},
    narrows: Bool{false},
}

// One closure capture: the name the body reads, its byte offset in the box,
// its value type row, whether the box holds its address (a capture the
// body writes) instead of its value, and whether the body owns the value (a
// task body, which runs once: ir_build_lambda) instead of the box.
IRCaptureSlot: struct {
    name: String,
    offset: Int,
    row: Int,
    by_ref: Bool,
    // The row the box owns and drops when it isn't `row`, the row the body
    // reads: a window the lambda keeps past its owner is held as a List of
    // its elements, read through the same header.
    owned_row: Int{-1},
    body_owned: Bool{false},
    // The close glue of a capture taken from its variable or owned by a
    // task body (-1: nothing closes): the release helper runs it for a
    // capture the box took, and for a body-owned one when the body never
    // started.
    close: Int{-1},
}

// A program with no checked input and an empty interner, for a module built
// standalone (unit tests): its types intern into the module's own interner
// (ir_intern_tid).
ir_program_standalone: fn() -> IRProgram Never! {
    ir_program_declared([TTypeDef]{}, [TImplDef]{}, [TConstantDef]{}, [FnBody]{}, symbol_table(), interner_empty())
}

ir_program_new: fn(functions: ^^[FnBody], decls: DeclTable, symbols: ^^SymbolTable, interner: ^^Interner, type_defs: ^^[TTypeDef], impl_defs: ^^[TImplDef], sources: ^^IRSourceTexts, constant_defs: ^^[TConstantDef], threads: CompilerThreads{compiler_threads_single()}) -> IRProgram Never! {
    owned_sources: sources.move()
    programs := [IRProgram]{}
    // Past IR_SOURCE_INDEX_MIN_BYTES the sources are indexed on their own
    // thread while the declarations bind; fewer are indexed here first.
    total := 0
    loop text in owned_sources.texts -> total += text.count_bytes()
    if total < IR_SOURCE_INDEX_MIN_BYTES {
        index := ir_source_index(owned_sources)
        p := ir_program_declared(type_defs, impl_defs, constant_defs, functions, symbols, interner)
        ir_program_bind(p, functions, decls, threads, skip_signature_unions: true)
        ir_program_take_sources(p, index.move())
        return p
    }
    task.group ir_program_sources {
        indexing: task ir_source_index(owned_sources)
        p := ir_program_declared(type_defs, impl_defs, constant_defs, functions, symbols, interner)
        ir_program_bind(p, functions, decls, threads, skip_signature_unions: true)
        index := compiler_threads_joined(indexing)
        ir_program_take_sources(p, index.move())
        programs.push(p)
    }
    compiler_threads_taken(programs)
}

// `p` reads its checked sources' text and lines from `index`
// (ir_source_index): a line a statement starts on, a column, a line's text.
ir_program_take_sources: fn(p: ^IRProgram, index: ^^IRSourceIndex) Never! {
    p.source_bytes = index.bytes.move()
    p.source_lines = index.lines.move()
    p.source_rows_keys = index.keys.move()
    p.source_rows = index.rows.move()
}

// Each function key of a checked function list and its first row there:
// `rows` holds the row at the key's id in `keys`.
IRFunctionRows: struct {
    keys: NameTable,
    rows: [Int],
}

// Each function key of `functions` to its first row, filled in one pass in
// row order. Its readers only look keys up, so no String sort orders it.
ir_first_function_rows: fn(functions: [FnBody]) -> IRFunctionRows Never! {
    table := IRFunctionRows{keys: name_column_table(functions.len()), rows: name_column(functions.len())}
    loop (index, function) in functions -> name_column_set_first(table.keys, table.rows, function.key, index)
    table
}

// The first row of function `key` in `table`.
ir_function_rows_get: fn(table: IRFunctionRows, key: String) -> Int? Never! { name_column_get(table.keys, table.rows, key) }

// The first row of the checked function `key` (IRProgram.rows).
ir_function_row: fn(p: IRProgram, key: String) -> Int? Never! { ir_function_rows_get(p.rows, key) }

// The key of the run-wide symbol `id` (IRProgram.symbols).
ir_symbol_key: fn(p: IRProgram, id: SymbolID) -> String Never! { symbol_table_key(p.symbols, id) }

// The key of symbol `id` a node of the builder's body names: a local of its
// checked function's tree (built from the body's key bytes), or a run-wide
// one.
ir_body_symbol_key: fn(p: IRProgram, b: IRBuilder, id: SymbolID) -> String Never! {
    if !symbol_is_local(id) -> return symbol_table_key(p.symbols, id)
    symbol_local_keys_text(ir_builder_body(p, b.row)[0].tree.symbols, id)
}

// A program over the checked declarations with no function bound yet
// (ir_program_bind binds them): the constants by key, the types with the
// compiler-owned ones and the union types the declarations and `functions`'
// signatures name, the host target's trait implementations, and the run's
// `symbols`.
ir_program_declared: fn(type_defs: ^^[TTypeDef], impl_defs: ^^[TImplDef], constant_defs: ^^[TConstantDef], functions: [FnBody], symbols: ^^SymbolTable, interner: ^^Interner) -> IRProgram Never! {
    types := type_defs.move()
    ir_add_compiler_owned_types(types)
    ir_add_union_types(types, functions, interner)
    // A type row by its key, then by its name where no key names one. A
    // jet_builtins record (`LockIdentity`) claims its name first: no program
    // can name it. A bare name is otherwise a Core spelling (a Core signature
    // or record row, a Core body checked once for every program), and program
    // code spells its own types by their keys, so a Core declaration or a
    // compiler-owned row claims a name before a program type of that name. A
    // unit type a program's unit family mints (`Meter`) is the exception: unit
    // literals spell it bare, so it claims its name ahead of the Prelude's.
    // No declaration claims a compiler value's host word (`Compiler`, `Code`):
    // that bare spelling is the host value, and a library type of that name,
    // private or not, is reached by its key alone.
    builtins: "{MODULE_CORE_PREFIX}{CORE_BUILTINS_MODULE}."
    families: ir_unit_family_rows(types)
    type_rows_keys := name_column_table(types.len() * 2)
    type_rows := name_column(types.len() * 2)
    tier1 := [Int]{}
    tier2 := [Int]{}
    tier3 := [Int]{}
    tier4 := [Int]{}
    loop (index, definition) in types {
        name_column_set_first(type_rows_keys, type_rows, definition.key, index)
        if ir_host_value_name(definition.name) -> next
        if {
            definition.key.starts_with(builtins) -> tier1.push(index)
            definition.key.starts_with(MODULE_CORE_PREFIX) || definition.key == definition.name -> {
                tier3.push(index)
            }
            ir_unit_minted_row(definition, types, families) -> tier2.push(index)
            else -> tier4.push(index)
        }
    }
    loop index in tier1 -> name_column_set_first(type_rows_keys, type_rows, types[index].name, index)
    loop index in tier2 -> name_column_set_first(type_rows_keys, type_rows, types[index].name, index)
    loop index in tier3 -> name_column_set_first(type_rows_keys, type_rows, types[index].name, index)
    loop index in tier4 -> name_column_set_first(type_rows_keys, type_rows, types[index].name, index)
    impls: impl_defs.move()
    // A constant by its key, then by the symbol key a ConstRef names
    // (TConstantDef.symbol_key); the first definition of a key holds it.
    // Each trait constant of an implementation is one more constant, keyed
    // by ir_trait_constant_key alone.
    defs := constant_defs.move()
    loop implementation in impls {
        trait_name: if implementation.trait_ref == .Val(name) -> name else if implementation.trait_name == .Val(name) -> name else -> ""
        if trait_name == "" || implementation.constants.len() == 0 -> next
        if implementation.target_os == .Val(os) {
            if os != .Linux -> next
        }
        owner: ir_type_identity(type_rows_keys, type_rows, types, implementation.self_type)
        loop constant in implementation.constants {
            defs.push(TConstantDef{module_identity: implementation.module_identity, key: ir_trait_constant_key(ir_short_name(trait_name), owner, constant.name), name: "{owner}.{constant.name}", span: constant.span, visibility: NameVisibility.Public, ty: constant.ty.copy(), is_comptime: true, is_storage: false, value: constant.value.copy()})
        }
    }
    // Each constant's key and name to its first row.
    constants_keys := name_column_table(defs.len() * 2)
    constants := name_column(defs.len() * 2)
    loop (index, definition) in defs {
        name_column_set_first(constants_keys, constants, definition.key, index)
        if definition.symbol_key != "" -> name_column_set_first(constants_keys, constants, definition.symbol_key, index)
    }
    // The Display, Printable, Close and KeyBy implementations of the host
    // target, and the user Comparable ones (a derived Comparable orders
    // structurally). Every trait implementation's type, with the first
    // candidate payload key of its identity, is one of `implementers`
    // (ir_trait_key_table). Every trait implementation of the host target
    // also names its methods' traits for ir_trait_methods, and one that
    // declares no method names its owner for ir_trait_implementers.
    impl_slots_keys := name_column_table()
    impl_slots := name_column()
    impl_traits := [[String]]{}
    impl_methods := [IRImplMethod]{}
    implementers := [{identity: String, first: Int}]{}
    empty_impls := [IREmptyImpl]{}
    loop implementation in impls.move() {
        trait_name: if implementation.trait_ref == .Val(name) -> name else if implementation.trait_name == .Val(name) -> name else -> ""
        if trait_name == "" -> next
        identity := ir_type_identity(type_rows_keys, type_rows, types, implementation.self_type)
        first: ir_trait_key_hash(identity, 0)
        implementers.push({identity: identity.move(), first: first})
        if implementation.target_os == .Val(os) {
            if os != .Linux -> next
        }
        trait_short: ir_short_name(trait_name)
        owner_key: ir_render_type_key(type_rows_keys, type_rows, types, implementation.self_type)
        loop key in implementation.methods {
            slot_key: "{implementation.module_identity.id}|{owner_key}|{ir_impl_method_leaf(key)}"
            slot := name_column_value(impl_slots_keys, impl_slots, slot_key) ?? -1
            if slot < 0 {
                slot = impl_traits.len()
                name_column_set(impl_slots_keys, impl_slots, slot_key, slot)
                impl_traits.push([String]{})
            }
            impl_traits[slot].push(trait_short.copy())
        }
        if implementation.methods.len() == 0 {
            empty_impls.push(IREmptyImpl{trait_short: ir_short_name(trait_name), owner: implementation.self_type.move()})
        }
        method: if trait_short == {
            "Display" -> "display"
            "Printable" -> "show"
            "Close" -> "close"
            "Comparable" -> if implementation.compiler_generated -> "" else -> "compare"
            "KeyBy" -> "key"
            else -> ""
        }
        if method == "" -> next
        impl_methods.push(IRImplMethod{method: method, trait_short: trait_short, owner_key: owner_key})
    }
    IRProgram{functions: [FnBody]{}, rows: IRFunctionRows{keys: name_column_table(), rows: name_column()}, symbols: symbols.move(), interner: interner.move(), types: types.move(), type_rows_keys: type_rows_keys, type_rows: type_rows, constants_keys: constants_keys, constants: constants, constant_defs: defs.move(), render_impls_keys: name_column_table(), render_impls: name_column(), close_methods_keys: name_column_table(), close_methods: name_column(), impl_slots_keys: impl_slots_keys, impl_slots: impl_slots, impl_traits: impl_traits, impl_methods: impl_methods, trait_keys: ir_trait_key_table(implementers), empty_impls: empty_impls, source_bytes: [[U8]]{}, source_lines: [[Int]]{}}
}

// Binds `functions` to `p` in place of the functions it had: their rows,
// the union types their signatures name that `p` lacks, and the
// implementation methods and trait method tables that name function rows.
// `decls` is the run's declaration table their direct calls name.
// The declarations stay, so one declared program serves many builds.
ir_program_bind_parallel: fn(p: ^IRProgram, owned: [FnBody], decls: DeclTable, workers: Int, threads: CompilerThreads) -> IRBodyScanPart Never! {
    symbols_ref: p.symbols
    interner_ref: p.interner
    type_rows_keys_ref: p.type_rows_keys
    type_rows_ref: p.type_rows
    types_ref: p.types
    impl_slots_keys_ref: p.impl_slots_keys
    impl_slots_ref: p.impl_slots
    impl_traits_ref: p.impl_traits
    owner_methods_keys := name_column_table()
    owner_methods := name_column()
    render_impls_keys := name_column_table()
    render_impls := name_column()
    close_methods_keys := name_column_table()
    close_methods := name_column()
    core_roles := [Int]{}
    decl_parts := [IRBindDeclPart]{}
    check_boxed := [Bool]{}
    check_boxed.try_reserve(owned.len()) ?? ()
    loop index in 0..<owned.len() {
        check_boxed.push(owned[index].generic_params.len() == 0 && ir_owner_binders(p, owned[index]).len() == 0)
    }
    scanned := IRBodyScanPart{spawns: [IRBodyScanSpawn]{}, boxed: [IRBodyScanBoxed]{}}
    task.group ir_program_bind_tasks {
        t_rows: task ir_first_function_rows(owned)
        t_traits: task ir_trait_methods(owned, symbols_ref, type_rows_keys_ref, type_rows_ref, types_ref, impl_slots_keys_ref, impl_slots_ref, impl_traits_ref)
        t_decls: task ir_bind_decl_parts(owned, decls, symbols_ref, workers)
        t_intrinsics: task ir_core_intrinsics(owned)
        t_scan: task ir_body_scan_collect(owned, check_boxed, interner_ref, threads)
        loop (index, function) in owned {
            if function.role != "" -> core_roles.push(index)
            if function.name != "display" && function.name != "show" && function.name != "close" && function.name != "compare" && function.name != "key" {
                next
            }
            if function.kind == {
                .TopLevel -> {}
                .Method(_, owner_type) -> {
                    key: "{function.name}||{ir_render_type_key(type_rows_keys_ref, type_rows_ref, types_ref, owner_type)}"
                    name_column_set_first(owner_methods_keys, owner_methods, key, index)
                }
                .TraitMethod(_, _, owner_type, trait_name, _) -> {
                    trait_short: ir_short_name(symbol_table_key(symbols_ref, trait_name))
                    owner_key: ir_render_type_key(type_rows_keys_ref, type_rows_ref, types_ref, owner_type)
                    key: "{function.name}|{trait_short}|{owner_key}"
                    name_column_set_first(owner_methods_keys, owner_methods, key, index)
                    selected: (trait_short == "Display" && function.name == "display") || (trait_short == "Printable" && function.name == "show")
                    if selected {
                        render_key: "{trait_short}|{owner_key}"
                        name_column_set_first(render_impls_keys, render_impls, render_key, index)
                    }
                }
            }
        }
        loop implementation in p.impl_methods {
            row: name_column_value(owner_methods_keys, owner_methods, "{implementation.method}|{implementation.trait_short}|{implementation.owner_key}") ?? name_column_value(owner_methods_keys, owner_methods, "{implementation.method}||{implementation.owner_key}") ?? -1
            if row < 0 -> next
            if implementation.trait_short == "Close" {
                name_column_set_first(close_methods_keys, close_methods, implementation.owner_key, row)
            } else {
                render_key: "{implementation.trait_short}|{implementation.owner_key}"
                name_column_set_first(render_impls_keys, render_impls, render_key, row)
            }
        }
        p.rows = compiler_threads_joined(t_rows)
        p.trait_methods = compiler_threads_joined(t_traits)
        decl_parts = compiler_threads_joined(t_decls)
        p.intrinsics = compiler_threads_joined(t_intrinsics)
        scanned = compiler_threads_joined(t_scan)
    }
    decl_rows := (loop _ in 0..<decls.rows.len() -> -1)
    loop part in decl_parts {
        loop i in 0..<part.decl_indices.len() {
            d: part.decl_indices[i]
            if decl_rows[d] < 0 -> decl_rows[d] = part.fn_rows[i]
        }
    }
    p.decl_rows = decl_rows.move()
    p.decl_foreign = [Int]{}
    p.foreign_keys = name_column_table()
    p.foreign = name_column()
    p.foreign_rows = [SemaCheckedForeignFunction]{}
    loop operator_trait in OWNED_TRAITS {
        if !owned_trait_arithmetic(operator_trait.name) -> next
        trait_short: operator_trait.name
        hook: owned_trait_operator_hook(trait_short) ?? next
        loop index in p.trait_methods.rows[ir_trait_method_slot(p.trait_methods, trait_short, hook)] {
            if owned[index].params.len() != 1 -> next
            if owned[index].kind == {
                .Method(_, owner) -> {
                    ir_operator_hook_key(p, render_impls_keys, render_impls, trait_short, owner, owned[index].params[0].ty, index)
                }
                .TraitMethod(_, _, owner, _, _) -> {
                    ir_operator_hook_key(p, render_impls_keys, render_impls, trait_short, owner, owned[index].params[0].ty, index)
                }
                .TopLevel -> {}
            }
        }
    }
    p.render_impls_keys = render_impls_keys
    p.render_impls = render_impls
    p.close_methods_keys = close_methods_keys
    p.close_methods = close_methods
    p.core_roles = core_roles
    scanned
}

ir_program_bind: fn(p: ^IRProgram, functions: ^^[FnBody], decls: DeclTable, threads: CompilerThreads{compiler_threads_single()}, skip_signature_unions: Bool{false}) Never! {
    owned := functions.move()
    ir_declared_owners(owned, p.types)
    if !skip_signature_unions -> ir_add_signature_union_types(p.types, p.type_rows_keys, p.type_rows, owned, p.interner)
    workers: compiler_threads_admit(threads, owned.len(), owned.len(), 1024, 0, 0)
    if workers > 1 {
        scanned := ir_program_bind_parallel(p, owned, decls, workers, threads)
        p.functions = owned.move()
        p.quiet_points = ir_quiet_points(p)
        ir_program_scan_bodies_apply(p, scanned.spawns, scanned.boxed, scanned.print)
        return
    }
    rows: ir_first_function_rows(owned)
    // An implementation method is checked as its owner's method of that name
    // (a TraitMethod when its trait resolves in the implementing module,
    // else a plain Method).
    owner_methods_keys := name_column_table()
    owner_methods := name_column()
    render_impls_keys := name_column_table()
    render_impls := name_column()
    loop (index, function) in owned {
        if function.name != "display" && function.name != "show" && function.name != "close" && function.name != "compare" && function.name != "key" {
            next
        }
        if function.kind == {
            .TopLevel -> {}
            .Method(_, owner_type) -> {
                key: "{function.name}||{ir_render_type_key(p.type_rows_keys, p.type_rows, p.types, owner_type)}"
                name_column_set_first(owner_methods_keys, owner_methods, key, index)
            }
            .TraitMethod(_, _, owner_type, trait_name, _) -> {
                trait_short: ir_short_name(ir_symbol_key(p, trait_name))
                owner_key: ir_render_type_key(p.type_rows_keys, p.type_rows, p.types, owner_type)
                key: "{function.name}|{trait_short}|{owner_key}"
                name_column_set_first(owner_methods_keys, owner_methods, key, index)
                selected: (trait_short == "Display" && function.name == "display") || (trait_short == "Printable" && function.name == "show")
                if selected {
                    render_key: "{trait_short}|{owner_key}"
                    name_column_set_first(render_impls_keys, render_impls, render_key, index)
                }
            }
        }
    }
    close_methods_keys := name_column_table()
    close_methods := name_column()
    loop implementation in p.impl_methods {
        row: name_column_value(owner_methods_keys, owner_methods, "{implementation.method}|{implementation.trait_short}|{implementation.owner_key}") ?? name_column_value(owner_methods_keys, owner_methods, "{implementation.method}||{implementation.owner_key}") ?? -1
        if row < 0 -> next
        if implementation.trait_short == "Close" {
            name_column_set_first(close_methods_keys, close_methods, implementation.owner_key, row)
        } else {
            render_key: "{implementation.trait_short}|{implementation.owner_key}"
            name_column_set_first(render_impls_keys, render_impls, render_key, row)
        }
    }
    p.trait_methods = ir_trait_methods(owned, p.symbols, p.type_rows_keys, p.type_rows, p.types, p.impl_slots_keys, p.impl_slots, p.impl_traits)
    // A generic `T: Add` body's `+` (ir_operator_impl) runs the
    // instantiation's hook for its own right-hand type: a method of the
    // owner's operator-trait implementation, local trait or Core's.
    loop operator_trait in OWNED_TRAITS {
        if !owned_trait_arithmetic(operator_trait.name) -> next
        trait_short: operator_trait.name
        hook: owned_trait_operator_hook(trait_short) ?? next
        loop index in p.trait_methods.rows[ir_trait_method_slot(p.trait_methods, trait_short, hook)] {
            if owned[index].params.len() != 1 -> next
            if owned[index].kind == {
                .Method(_, owner) -> {
                    ir_operator_hook_key(p, render_impls_keys, render_impls, trait_short, owner, owned[index].params[0].ty, index)
                }
                .TraitMethod(_, _, owner, _, _) -> {
                    ir_operator_hook_key(p, render_impls_keys, render_impls, trait_short, owner, owned[index].params[0].ty, index)
                }
                .TopLevel -> {}
            }
        }
    }
    core_roles := [Int]{}
    loop (index, function) in owned {
        if function.role != "" -> core_roles.push(index)
    }
    p.functions = owned.move()
    p.quiet_points = ir_quiet_points(p)
    p.rows = rows
    ir_program_scan_bodies(p, threads)
    ir_program_bind_decls(p, decls)
    p.render_impls_keys = render_impls_keys
    p.render_impls = render_impls
    p.close_methods_keys = close_methods_keys
    p.close_methods = close_methods
    p.core_roles = core_roles
    p.intrinsics = ir_core_intrinsics(p.functions)
}

// The function row of the Core function that fills jet_builtins role `role`
// (`AbsF32`), when the program holds it.
ir_core_role_row: fn(p: IRProgram, role: String) -> Int? {
    loop row in p.core_roles {
        if p.functions[row].role == role -> return Val(row)
    }
    None
}

// Core's builder intrinsics, by role: a call of the Core function that fills
// jet_builtins role `role` is its operation, never a call
// (ir_intrinsic_call). Each such role's name starts with `Inline`. The
// core.math bit copies (InlineFloatBits, InlineFloatFromBits, InlineF32Bits,
// InlineF32FromBits; Core/Math/Math.jet) are the runtime bitcasts'
// frame-word copy on every tier and in compile-time evaluation, so Core's
// bit work stays in I64 where Int to_bits would box, and a signaling NaN
// keeps its bits; InlineFloatSqrt is the IEEE square root and InlineFloatFma
// the runtime's fma, which x86-64 builds as one instruction behind an FMA3
// probe. Their Jet bodies are only what a compiler without this table (the
// seed) runs. The core.mem rows (Core/Mem/Mem.jet) are the raw
// List layout and bulk List moves, volatile and streaming access, the raw
// pointer steps, and the raw block copy and fill at the call's one type
// argument, and the raw heap allocation and release, the memory sentry's
// account of an OS mapping, a region's reserve and release of fresh pages,
// and `context.allocator`'s take, give and room of a block, which take none.
IRCoreIntrinsicRow: struct {
    role: String,
    intrinsic: IRRuntimeIntrinsic,
}

IR_CORE_INTRINSICS: [IRCoreIntrinsicRow]{
    IRCoreIntrinsicRow{role: "InlineFloatBits", intrinsic: IRRuntimeIntrinsic.FloatBits},
    IRCoreIntrinsicRow{role: "InlineFloatFromBits", intrinsic: IRRuntimeIntrinsic.FloatFromBits},
    IRCoreIntrinsicRow{role: "InlineFloatSqrt", intrinsic: IRRuntimeIntrinsic.FloatSqrt},
    IRCoreIntrinsicRow{role: "InlineFloatFma", intrinsic: IRRuntimeIntrinsic.FloatFma},
    IRCoreIntrinsicRow{role: "InlineF32Bits", intrinsic: IRRuntimeIntrinsic.F32Bits},
    IRCoreIntrinsicRow{role: "InlineF32FromBits", intrinsic: IRRuntimeIntrinsic.F32FromBits},
    IRCoreIntrinsicRow{role: "InlineTypeSize", intrinsic: IRRuntimeIntrinsic.TypeSize},
    IRCoreIntrinsicRow{role: "InlineListCapacity", intrinsic: IRRuntimeIntrinsic.ListCapacity},
    IRCoreIntrinsicRow{role: "InlineListReserveExact", intrinsic: IRRuntimeIntrinsic.ListReserveExact},
    IRCoreIntrinsicRow{role: "InlineListAppend", intrinsic: IRRuntimeIntrinsic.ListAppend},
    IRCoreIntrinsicRow{role: "InlineListCopy", intrinsic: IRRuntimeIntrinsic.ListCopy},
    IRCoreIntrinsicRow{role: "InlineVolatileRead", intrinsic: IRRuntimeIntrinsic.VolatileRead},
    IRCoreIntrinsicRow{role: "InlineVolatileWrite", intrinsic: IRRuntimeIntrinsic.VolatileWrite},
    IRCoreIntrinsicRow{role: "InlineStreamStore", intrinsic: IRRuntimeIntrinsic.StreamStore},
    IRCoreIntrinsicRow{role: "InlinePtrOffset", intrinsic: IRRuntimeIntrinsic.PtrOffset},
    IRCoreIntrinsicRow{role: "InlinePtrByteOffset", intrinsic: IRRuntimeIntrinsic.PtrByteOffset},
    IRCoreIntrinsicRow{role: "InlineViewFromRaw", intrinsic: IRRuntimeIntrinsic.ViewFromRaw},
    IRCoreIntrinsicRow{role: "InlineMemCopy", intrinsic: IRRuntimeIntrinsic.MemCopy},
    IRCoreIntrinsicRow{role: "InlineMemFill", intrinsic: IRRuntimeIntrinsic.MemFill},
    IRCoreIntrinsicRow{role: "InlineAllocRaw", intrinsic: IRRuntimeIntrinsic.AllocRaw},
    IRCoreIntrinsicRow{role: "InlineFreeRaw", intrinsic: IRRuntimeIntrinsic.FreeRaw},
    IRCoreIntrinsicRow{role: "InlineMapped", intrinsic: IRRuntimeIntrinsic.Mapped},
    IRCoreIntrinsicRow{role: "InlineUnmapping", intrinsic: IRRuntimeIntrinsic.Unmapping},
    IRCoreIntrinsicRow{role: "InlineRegionReserve", intrinsic: IRRuntimeIntrinsic.RegionReserve},
    IRCoreIntrinsicRow{role: "InlineRegionRelease", intrinsic: IRRuntimeIntrinsic.RegionRelease},
    IRCoreIntrinsicRow{role: "InlineContextTake", intrinsic: IRRuntimeIntrinsic.ContextTake},
    IRCoreIntrinsicRow{role: "InlineContextGive", intrinsic: IRRuntimeIntrinsic.ContextGive},
    IRCoreIntrinsicRow{role: "InlineContextRoom", intrinsic: IRRuntimeIntrinsic.ContextRoom},
}

// The checked Core functions that fill an IR_CORE_INTRINSICS role, by
// function key, each of its operation's shape.
ir_core_intrinsics: fn(functions: [FnBody]) -> IRIntrinsics Never! {
    intrinsics := ir_intrinsics()
    loop function in functions {
        if !ir_core_inline_role(function.role) -> next
        loop row in IR_CORE_INTRINSICS {
            if row.role != function.role -> next
            if ir_core_intrinsic_shaped(function, row.intrinsic) {
                ir_intrinsics_put(intrinsics, function.key, row.intrinsic.copy())
            }
        }
    }
    intrinsics
}

// A bitcast reads its one scalar, and the square root its one Float and fma
// its three; a core.mem layout, access, pointer or
// block operation is generic over the one type its call instantiates, a raw
// View over its element and owner types, the
// raw heap pair is not, a region's reserve reads its size and its release
// the address and size, and a context block's take reads its size and
// align, its give and room the address.
ir_core_intrinsic_shaped: fn(function: FnBody, intrinsic: IRRuntimeIntrinsic) -> Bool Never! {
    if intrinsic == {
        .FloatBits -> ir_bitcast_signature(function, true)
        .FloatFromBits -> ir_bitcast_signature(function, false)
        .FloatSqrt -> ir_float_op_signature(function, 1)
        .FloatFma -> ir_float_op_signature(function, 3)
        .F32Bits -> ir_f32_bits_signature(function, true)
        .F32FromBits -> ir_f32_bits_signature(function, false)
        .TypeSize | .ListCapacity | .ListReserveExact | .ListAppend | .ListCopy | .VolatileRead | .VolatileWrite | .StreamStore | .PtrOffset | .PtrByteOffset | .MemCopy | .MemFill -> function.generic_params.len() == 1
        .ViewFromRaw -> function.generic_params.len() == 2
        .AllocRaw | .FreeRaw -> function.generic_params.len() == 0
        .RegionReserve | .ContextRoom -> ir_intrinsic_signature(function, 1)
        .RegionRelease | .ContextTake | .ContextGive | .Mapped | .Unmapping -> ir_intrinsic_signature(function, 2)
        .FunctionAddress(_) | .StaticText | .FaultReport -> false
    }
}

// Selects function `index` as `owner`'s `trait_short` hook for the
// right-hand type `rhs` (ir_operator_impl), unless one is selected already.
ir_operator_hook_key: fn(p: IRProgram, render_impls_keys: ^NameTable, render_impls: ^[Int], trait_short: String, owner: Type, rhs: Type, index: Int) Never! {
    key: "{trait_short}|{ir_render_type_key(p.type_rows_keys, p.type_rows, p.types, owner)}|{ir_render_type_key(p.type_rows_keys, p.type_rows, p.types, rhs)}"
    name_column_set_first(render_impls_keys, render_impls, key, index)
}

// The bound functions' DeclID rows over `decls` (IRProgram.decl_rows): a
// key's first function row, as `rows` holds it.
ir_program_bind_decls: fn(p: ^IRProgram, decls: DeclTable) Never! {
    decl_rows := (loop _ in 0..<decls.rows.len() -> -1)
    loop (row, function) in p.functions {
        if decl_table_find(decls, p.symbols, function.key) == .Val(id) {
            if decl_rows[id.row.index()] < 0 -> decl_rows[id.row.index()] = row
        }
    }
    p.decl_rows = decl_rows.move()
    p.decl_foreign = [Int]{}
    p.foreign_keys = name_column_table()
    p.foreign = name_column()
    p.foreign_rows = [SemaCheckedForeignFunction]{}
}

IRBindDeclPart: struct {
    decl_indices: [Int],
    fn_rows: [Int],
}

ir_bind_decl_range: fn(functions: [FnBody], decls: DeclTable, symbols: SymbolTable, start: Int, end: Int) -> IRBindDeclPart Never! {
    decl_indices := [Int]{}
    fn_rows := [Int]{}
    loop row in start..<end {
        if decl_table_find(decls, symbols, functions[row].key) == .Val(id) {
            decl_indices.push(id.row.index())
            fn_rows.push(row)
        }
    }
    IRBindDeclPart{decl_indices: decl_indices.move(), fn_rows: fn_rows.move()}
}

ir_bind_decl_threads: fn(functions: [FnBody], decls: DeclTable, symbols: SymbolTable, starts: [Int], ends: [Int], at: Int) -> [IRBindDeclPart] Never! {
    if at >= starts.len() -> return [IRBindDeclPart]{}
    if at + 1 == starts.len() {
        return [IRBindDeclPart]{ir_bind_decl_range(functions, decls, symbols, starts[at], ends[at])}
    }
    out := [IRBindDeclPart]{}
    task.group ir_bind_decl_group {
        head: task ir_bind_decl_range(functions, decls, symbols, starts[at], ends[at])
        rest := ir_bind_decl_threads(functions, decls, symbols, starts, ends, at + 1)
        out.push(compiler_threads_joined(head))
        compiler_transfer_rows<IRBindDeclPart>(out, rest)
    }
    out
}

ir_bind_decl_parts: fn(functions: [FnBody], decls: DeclTable, symbols: SymbolTable, workers: Int) -> [IRBindDeclPart] Never! {
    count: functions.len()
    starts := [Int]{}
    ends := [Int]{}
    loop w in 0..<workers {
        s: (w * count) /% workers
        e: ((w + 1) * count) /% workers
        if s < e {
            starts.push(s)
            ends.push(e)
        }
    }
    ir_bind_decl_threads(functions, decls, symbols, starts, ends, 0)
}

// The function row of declaration `id` (-1: no bound function).
ir_decl_row: fn(p: IRProgram, id: DeclID) -> Int Never! {
    index: id.row.index()
    if index >= p.decl_rows.len() -> return -1
    p.decl_rows[index]
}

// The `foreign_rows` row of declaration `id` (-1: not a checked foreign
// function).
ir_decl_foreign: fn(p: IRProgram, id: DeclID) -> Int Never! {
    index: id.row.index()
    if index >= p.decl_foreign.len() -> return -1
    p.decl_foreign[index]
}

// A method's owner arrives spelled as its module names it (`Parser`), while
// every other type the checked program names is its declaration key
// (`<module>.Parser`). Each owner becomes the key of the type of that name
// declared in the method's own module, so same-named types of two modules
// keep their own methods, layouts and Display, Close and codec rows. An owner
// declared elsewhere (an implementation of another module's type) is already
// spelled by its key or alias and stays as it is.
ir_declared_owners: fn(functions: ^[FnBody], types: [TTypeDef]) Never! {
    // Only a name some method's owner spells is ever looked up, so only the
    // types of those names are keyed.
    owners := name_table_sized(64)
    loop index in 0..<functions.len() {
        name: ir_declared_owner_name(functions[index].kind) ?? next
        _ := name_intern(owners, name)
    }
    if name_count(owners) == 0 {
        return
    }
    declared: ir_declared_owner_rows(owners, types)
    loop index in 0..<functions.len() -> ir_declared_owner_rekey(functions[index], declared, types)
}

// ir_declared_owners for the one function `function`.
ir_declared_function_owner: fn(function: ^FnBody, types: [TTypeDef]) Never! {
    name: ir_declared_owner_name(function.kind) ?? return
    owners := name_table_sized(4)
    _ := name_intern(owners, name)
    ir_declared_owner_rekey(function, ir_declared_owner_rows(owners, types), types)
}

// The rows in `types` of the names `owners` holds, by their key scoped to
// the declaring module (ir_declared_owner looks them up).
IRDeclaredOwnerRows: struct {
    keys: NameTable,
    rows: [Int],
}

ir_declared_owner_rows: fn(owners: NameTable, types: [TTypeDef]) -> IRDeclaredOwnerRows Never! {
    declared_keys := name_column_table()
    declared := name_column()
    loop (index, definition) in types {
        if name_find(owners, definition.name) == None -> next
        scoped: "{definition.module_identity.id}|{definition.name}"
        name_column_set_first(declared_keys, declared, scoped, index)
    }
    IRDeclaredOwnerRows{keys: declared_keys.move(), rows: declared.move()}
}

// Rekeys the owner of method `function` to its declared type's key, when
// `declared` holds it.
ir_declared_owner_rekey: fn(function: ^FnBody, declared: IRDeclaredOwnerRows, types: [TTypeDef]) Never! {
    if function.kind == {
        .Method(convention, owner_type) -> {
            owner: ir_declared_owner(declared.keys, declared.rows, types, function.module_identity, owner_type) ?? return
            function.kind = TFuncKind.Method{self_convention: convention, owner_type: owner}
        }
        .TraitMethod(is_unsafe, convention, owner_type, trait_name, codec) -> {
            owner: ir_declared_owner(declared.keys, declared.rows, types, function.module_identity, owner_type) ?? return
            function.kind = TFuncKind.TraitMethod{is_unsafe: is_unsafe, self_convention: convention, owner_type: owner, trait_name: trait_name, serde_codec: codec}
        }
        .TopLevel -> {}
    }
}

// The name a method's owner spells (ir_declared_owner looks up), or None
// for a top-level function or an owner that is not a nominal type.
ir_declared_owner_name: fn(kind: TFuncKind) -> String? Never! {
    if kind == {
        .Method(_, owner) -> ir_nominal_name(owner)
        .TraitMethod(_, _, owner, _, _) -> ir_nominal_name(owner)
        .TopLevel -> None
    }
}

// `owner` named by the key of its declaration in `module_identity`, or None
// when that module declares no type of its name.
ir_declared_owner: fn(declared_keys: NameTable, declared: [Int], types: [TTypeDef], module_identity: ModuleID, owner: Type) -> Type? Never! {
    if owner == {
        .Named(name) -> {
            row: name_column_value(declared_keys, declared, "{module_identity.id}|{name}") ?? return None
            return Val(Type.Named{name: types[row].key.copy()})
        }
        .Apply(name, args) -> {
            row: name_column_value(declared_keys, declared, "{module_identity.id}|{name}") ?? return None
            return Val(Type.Apply{name: types[row].key.copy(), args: args.copy()})
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
}

// IRProgram.quiet_points of `p`: the immutable declared hook and decision
// points (ir_point_type) that the program reads only as the receiver of a
// Hook or DecisionHook `run`. No read of such a point reaches an `on`, a
// `once` or an `on_priority`, nor passes it along to code that could, so no
// handler is ever attached: each Hook run returns its own fallback, and each
// DecisionHook run continues with its own payload.
ir_quiet_points: fn(p: IRProgram) -[]> [Int:Bool] {
    has_point := false
    loop definition in p.constant_defs {
        if !definition.is_storage && ir_point_type(p, definition.ty) {
            has_point = true
            break
        }
    }
    if !has_point -> return [Int:Bool]{}
    // Constant rows read as a `run`'s receiver, and read any other way.
    run := [Int:Bool]{}
    other := [Int:Bool]{}
    loop function in p.functions {
        receivers := [Int:Bool]{}
        loop node in function.tree.nodes {
            if node.kind == .HandleMethod(receiver, operation, _) {
                if operation == .EventMethod(route) && (route == "jet_std.JetHook.run" || route == "jet_std.JetDecisionHook.run") {
                    receivers[receiver] = true
                }
            }
        }
        loop node in function.tree.nodes {
            if node.kind == .ConstRef(symbol) {
                key: if symbol_is_local(symbol) -> symbol_local_keys_text(function.tree.symbols, symbol) else -> symbol_table_key(p.symbols, symbol)
                row: ir_constant_row(p, key) ?? next
                if receivers.get(node.id) != None -> run[row] = true else -> other[row] = true
            }
        }
    }
    quiet := [Int:Bool]{}
    loop (row, _) in run {
        if other.get(row) != None -> next
        definition: p.constant_defs[row]
        if ir_point_type(p, definition.ty) && !definition.is_storage -> quiet[row] = true
    }
    quiet
}

IR_BODY_SCAN_MIN_NODES_PER_THREAD: 40000

IRBodyScanPart: struct {
    spawns: [IRBodyScanSpawn],
    boxed: [IRBodyScanBoxed],
    print: IRPrintStyle?{None},
}

ir_body_scan_range: fn(functions: [FnBody], check_boxed: [Bool], interner: Interner, start: Int, end: Int) -> IRBodyScanPart Never! {
    spawns := [IRBodyScanSpawn]{}
    boxed := [IRBodyScanBoxed]{}
    print := IRPrintStyle?{None}
    loop row in start..<end {
        ir_scan_function_nodes(row, functions[row], check_boxed[row], interner, spawns, boxed, print)
    }
    IRBodyScanPart{spawns: spawns.move(), boxed: boxed.move(), print: print}
}

ir_body_scan_parts: fn(functions: [FnBody], check_boxed: [Bool], interner: Interner, bounds: [Int], part: Int) -> [IRBodyScanPart] Never! {
    if part >= bounds.len() - 2 {
        return [IRBodyScanPart]{ir_body_scan_range(functions, check_boxed, interner, bounds[part], bounds[part + 1])}
    }
    parts := [IRBodyScanPart]{}
    task.group ir_body_scan_threads {
        head: task ir_body_scan_range(functions, check_boxed, interner, bounds[part], bounds[part + 1])
        rest := ir_body_scan_parts(functions, check_boxed, interner, bounds, part + 1)
        first: compiler_threads_joined(head)
        parts.push(first)
        loop row in rest.move() -> parts.push(row)
    }
    parts
}

// ir_trait_identity over the type rows `type_rows` (at the key's id in
// `type_rows_keys`) of `types`, before a program holds them
// (ir_program_declared).
ir_type_identity: fn(type_rows_keys: NameTable, type_rows: [Int], types: [TTypeDef], ty: Type) -> String Never! {
    plain: ir_untag(ty)
    if plain == .Named(_) -> return ir_render_type_key(type_rows_keys, type_rows, types, plain)
    type_carrier_identity(plain)
}

ir_body_scan_collect: fn(functions: [FnBody], check_boxed: [Bool], interner: Interner, threads: CompilerThreads) -> IRBodyScanPart Never! {
    count: functions.len()
    weights := [Int]{}
    weights.try_reserve(count) ?? ()
    total := 0
    loop index in 0..<count {
        nodes: 1 + functions[index].tree.nodes.len()
        weights.push(nodes)
        total += nodes
    }
    workers: compiler_threads_admit(threads, count, total, IR_BODY_SCAN_MIN_NODES_PER_THREAD, 0, 0)
    spawns := [IRBodyScanSpawn]{}
    candidates := [IRBodyScanBoxed]{}
    print := IRPrintStyle?{None}
    if workers <= 1 {
        loop row in 0..<count {
            ir_scan_function_nodes(row, functions[row], check_boxed[row], interner, spawns, candidates, print)
        }
    } else {
        bounds: compiler_threads_partition(weights, workers)
        parts := ir_body_scan_parts(functions, check_boxed, interner, bounds, 0)
        loop part in parts.move() {
            loop s in part.spawns -> spawns.push(s)
            loop c in part.boxed.move() -> candidates.push(c)
            if print == None -> print = part.print
        }
    }
    IRBodyScanPart{spawns: spawns.move(), boxed: candidates.move(), print: print}
}

// The spawn sites of each file (p.spawn_sites): the reports number a file's
// spawn sites 0, 1, ... in source order, keyed by the spawned body's span
// start (the checker's site is the `task` word, which a `task.all` shares).
// `print` is where a block sets a print style (p.print_style).
ir_program_scan_bodies_apply: fn(p: ^IRProgram, spawns: [IRBodyScanSpawn], candidates: ^^[IRBodyScanBoxed], print: IRPrintStyle?) Never! {
    files := name_column_table()
    starts := [[Int]]{[Int]{}}
    loop s in spawns {
        id: name_index(name_intern(files, p.functions[s.fn_row].source_file))
        loop starts.len() <= id -> starts.push([Int]{})
        starts[id].push(s.start)
    }
    sites_keys := name_column_table(spawns.len())
    sites := name_column(spawns.len())
    loop (id, file) in files.texts {
        starts[id].sort()
        ordinal := 0
        loop start in starts[id] {
            key: "{file}:{start}"
            if name_column_get(sites_keys, sites, key) != None -> next
            name_column_set(sites_keys, sites, key, ordinal)
            ordinal += 1
        }
    }
    p.spawn_sites_keys = sites_keys
    p.spawn_sites = sites
    boxed := IRTraitBoxed{}
    seen := name_table_sized(8)
    loop c in candidates.move() { ir_trait_boxed_put_short(p, boxed, seen, c.concrete, c.short) }
    p.trait_boxed = boxed
    p.print_style = print
}

// Single-pass (parallel across `threads` for large modules) scan of every
// function's AST nodes for both `p.spawn_sites` and `p.trait_boxed`.
ir_program_scan_bodies: fn(p: ^IRProgram, threads: CompilerThreads) Never! {
    count: p.functions.len()
    check_boxed := [Bool]{}
    check_boxed.try_reserve(count) ?? ()
    loop index in 0..<count {
        check_boxed.push(p.functions[index].generic_params.len() == 0 && ir_owner_binders(p, p.functions[index]).len() == 0)
    }
    scanned := ir_body_scan_collect(p.functions, check_boxed, p.interner, threads)
    ir_program_scan_bodies_apply(p, scanned.spawns, scanned.boxed, scanned.print)
}

// `definition` takes over `p`'s constant rows of its key and its symbol key
// (a compile-time value landed after the program was declared), each not
// taken over yet (`taken`, which it joins): a key's first landed row stands.
// Both keys name the one definition it appends. A computed row
// (TConstantDef.item_function) stands only for its build and joins no
// `taken`: its constant's value takes over once it lands.
ir_program_put_constant: fn(p: ^IRProgram, definition: ^^TConstantDef, taken_keys: ^NameTable, taken: ^[Int]) Never! {
    owned := definition.move()
    computed: owned.item_function != ""
    by_name: owned.symbol_key != "" && name_column_get(taken_keys, taken, owned.symbol_key) == None
    by_key: name_column_get(taken_keys, taken, owned.key) == None
    if !by_name && !by_key {
        return
    }
    row: p.constant_defs.len()
    if by_name {
        if !computed -> name_column_set(taken_keys, taken, owned.symbol_key, row)
        name_column_set(p.constants_keys, p.constants, owned.symbol_key, row)
    }
    if by_key {
        if !computed -> name_column_set(taken_keys, taken, owned.key, row)
        name_column_set(p.constants_keys, p.constants, owned.key, row)
    }
    p.constant_defs.push(owned)
}

// The `constant_defs` row of constant `key` (its key or its name).
ir_constant_row: fn(p: IRProgram, key: String) -> Int? Never! { name_column_get(p.constants_keys, p.constants, key) }

// An empty module ready to build `p`'s functions (no function queued yet).
ir_module_for: fn(p: IRProgram) -> IRModule Never! {
    m := ir_module_new()
    loop _ in 0..<p.functions.len() -> m.ids.push(-1)
    m.stop_points = p.stop_points
    m.user_values = p.user_values
    m.alloc_types = p.checks.checked_alloc
    m.zones_stripped = p.checks.zones_stripped
    m.zone_table = p.zone_table
    if p.checks.quiet_exports.len() > 0 {
        m.quiet_exports = p.checks.quiet_exports
        m.quiet_stops = p.checks.quiet_stops
    } else { m.quiet_routes = p.checks.quiet_routes.copy() }
    m
}

// The implementation methods of every trait by (trait, method): `rows` at
// the id `ids` gives the pair's slot over `names` (name_pair_slot); id 0
// holds none.
IRTraitMethods: struct {
    names: NameTable{name_table_sized(16)},
    ids: [Int:Int]{[Int:Int]{}},
    rows: [[Int]]{[[Int]]{[Int]{}}},
}

// The id of (`trait_name`, `method`) in `methods`: 0, whose row is empty,
// when no method has it.
ir_trait_method_slot: fn(methods: IRTraitMethods, trait_name: String, method: String) -> Int Never! {
    key: name_pair_find_slot(methods.names, trait_name, method) ?? return 0
    methods.ids.get(key) ?? 0
}

// The implementation methods of every trait by (trait, method): an
// implementation's method is the same-module method of that name on the
// implementation's owner. It is checked as a TraitMethod when its trait
// resolves in the implementing module, else as a plain Method of the owner,
// which `impl_slots` (by "<module>|<owner key>|<method>") and `impl_traits`
// name the traits of; `symbols` holds the TraitMethods' trait keys.
ir_trait_methods: fn(functions: [FnBody], symbols: SymbolTable, type_rows_keys: NameTable, type_rows: [Int], types: [TTypeDef], impl_slots_keys: NameTable, impl_slots: [Int], impl_traits: [[String]]) -> IRTraitMethods Never! {
    methods := IRTraitMethods{}
    loop (index, function) in functions {
        traits := [String]{}
        if function.kind == {
            .TraitMethod(_, _, _, trait_name, _) -> {
                traits.push(ir_short_name(symbol_table_key(symbols, trait_name)))
            }
            .Method(_, owner_type) -> {
                owner_key: ir_render_type_key(type_rows_keys, type_rows, types, owner_type)
                slot: name_column_value(impl_slots_keys, impl_slots, "{function.module_identity.id}|{owner_key}|{function.name}") ?? -1
                if slot >= 0 {
                    loop trait_short in impl_traits[slot] -> traits.push(trait_short.copy())
                }
            }
            .TopLevel -> {}
        }
        loop trait_short in traits {
            key: name_pair_slot(methods.names, trait_short, function.name)
            id: methods.ids.get(key) ?? methods.rows.len()
            if id == methods.rows.len() {
                methods.ids[key] = id
                methods.rows.push([Int]{})
            }
            methods.rows[id].push(index)
        }
    }
    methods
}

// The last segment of a qualified key (`trait:<m>.Display` is `Display`):
// what follows its last `.` or `:`.
ir_short_name: fn(key: String) -> String Never! {
    bytes: key.bytes()
    at := bytes.len()
    loop at > 0 {
        byte: bytes[at - 1]
        if byte == (U8{46}) || byte == (U8{58}) -> break
        at -= 1
    }
    if at == 0 -> return key.copy()
    String.from_bytes(bytes.slice(at, bytes.len())) ?? key.copy()
}

// The declaration a nominal type name or key names.
ir_type_def: fn(p: IRProgram, name: String) -> Int? Never! { name_column_value(p.type_rows_keys, p.type_rows, name) }

// `ty` with each nominal head spelled by its identity key (ir_identity_key): a
// type named by its key (`module.Name`) and by its name (`Name`) is one type,
// so two checked types are the same type when their keyed spellings are
// equal. A nominal with no type row (a runtime or host carrier) keeps its
// spelling.
ir_keyed_nominals: fn(p: IRProgram, ty: Type) -> Type Never! {
    if ty == {
        .Named(name) -> Type.Named{name: ir_identity_key(p, name)}
        .Apply(name, args) -> Type.Apply{name: ir_identity_key(p, name), args: loop arg in args -> ir_keyed_nominals(p, arg)}
        .List(inner) -> Type.List{element: ir_keyed_nominals(p, inner)}
        .Shared(inner) -> Type.Shared{inner: ir_keyed_nominals(p, inner)}
        .Option(inner) -> Type.Option{inner: ir_keyed_nominals(p, inner)}
        // copy: `key_span` is a payload of read parameter `ty`; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: ir_keyed_nominals(p, key), key_span: key_span.copy(), value: ir_keyed_nominals(p, value)}
        .Result(ok, err) -> Type.Result{ok: ir_keyed_nominals(p, ok), err: ir_keyed_nominals(p, err)}
        // copy: `len` is a payload of read parameter `ty`; field `len` of the new Type.FixedList owns this one
        .FixedList(elem, len) -> Type.FixedList{elem: ir_keyed_nominals(p, elem), len: len.copy()}
        // copy: `marker` is a payload of read parameter `ty`; field `marker` of the new Type.Tagged owns this one
        .Tagged(marker, inner) -> Type.Tagged{marker: marker.copy(), inner: ir_keyed_nominals(p, inner)}
        .Union(members) -> Type.Union{members: loop member in members -> ir_keyed_nominals(p, member)}
        .Case(name, payload) -> Type.Case{name: name, payload: ir_keyed_nominals(p, payload)}
        .Tuple(fields) -> Type.Tuple{fields: loop field in fields -> TypeTupleField{name: field.name, ty: ir_keyed_nominals(p, field.ty)}}
        // copy: a type with no nominal head is returned as a new tree; the
        // caller keeps the read parameter.
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> ty.copy()
    }
}

ir_nominal_key: fn(p: IRProgram, name: String) -> String Never! {
    row: ir_type_def(p, name) ?? return name.copy()
    p.types[row].key.copy()
}

// ir_nominal_key for type identity: a Core declaration whose leaf a
// compiler-owned row still holds under the bare name (a compiler-owned Core
// record, or a Core enum leaf more than one loaded Core source declares) keys
// as that leaf, so the two spellings of one Core type are one type.
ir_identity_key: fn(p: IRProgram, name: String) -> String Never! {
    key: ir_nominal_key(p, name)
    if !key.starts_with("<corelib>/") -> return key
    leaf: ir_short_name(key)
    if ir_type_def(p, leaf) == .Val(owned) && p.types[owned].key == leaf -> return leaf
    key
}

// The IR id of the checked function `key` applied to `type_args` (concrete
// types: the instance's own), queueing it on first use.
ir_function_id: fn(m: ^IRModule, p: IRProgram, key: String, type_args: [Type]) -> Int? Never! {
    row: ir_function_row(p, key) ?? return None
    ir_function_row_id(m, p, row, type_args)
}

// ir_function_id of the checked function at row `row`.
ir_function_row_id: fn(m: ^IRModule, p: IRProgram, row: Int, type_args: [Type]) -> Int? Never! {
    // A Core stand-in has no body to build: only calls bound to the Core
    // image reach it.
    if p.functions[row].stand_in -> return None
    if type_args.len() == 0 && m.ids[row] >= 0 -> return Val(m.ids[row])
    if type_args.len() == 0 || (p.functions[row].generic_params.len() == 0 && ir_owner_binders(p, p.functions[row]).len() == 0) {
        if m.ids[row] >= 0 -> return Val(m.ids[row])
        id: m.functions.len()
        made := ir_function_new(p.functions[row].name, p.functions[row].key, ir_symbol_name(p.functions[row]), p.functions[row].source_file, p.functions[row].line)
        made.inline_always = p.functions[row].is_inline_always
        made.frame_bound = p.functions[row].frame_bound
        made.max_depth = p.functions[row].max_depth
        m.functions.push(made)
        ir_function_bind(m, p.functions[row].key, id)
        m.ids[row] = id
        m.queue.push(IRQueued{row: row, id: id, args: [Type]{}})
        return Val(id)
    }
    // An instance binds every one of its type parameters.
    if type_args.len() != ir_generic_names(p, p.functions[row]).len() -> return None
    spelled: loop arg in type_args -> type_carrier_identity(arg)
    concrete: type_args.copy()
    instance: "{p.functions[row].key}<{spelled.join(", ")}>"
    if name_column_value(m.instances_keys, m.instances, instance) == .Val(known) -> return Val(known)
    id: m.functions.len()
    made := ir_hashed_function(p.functions[row].name, instance, "{ir_symbol_name(p.functions[row])}__", p.functions[row].source_file, p.functions[row].line)
    made.inline_always = p.functions[row].is_inline_always
    made.max_depth = p.functions[row].max_depth
    m.functions.push(made)
    ir_function_bind(m, instance, id)
    name_column_set(m.instances_keys, m.instances, instance, id)
    m.queue.push(IRQueued{row: row, id: id, args: concrete})
    Val(id)
}

// The type parameters an instance of `function` binds, in order: those its
// owner's pattern binds (a method of a generic type, `Pair<T>`), then its
// own.
ir_generic_names: fn(p: IRProgram, function: FnBody) -> [String] Never! {
    names := [String]{}
    loop binder in ir_owner_binders(p, function) -> names.push(binder.name)
    loop parameter in function.generic_params -> names.push(parameter.name)
    names
}

// A type parameter of a generic owner a method binds, at argument `index`
// of its owner pattern.
IROwnerBinder: struct {
    index: Int,
    name: String,
}

// The owner type parameters a method of a generic type declaration binds:
// each argument of its owner pattern that is one of the declaration's
// parameters the method does not shadow with its own (`impl Pair<Int>`
// binds none). A structural impl's method (`impl [T#N].Trait`) binds each
// parameter of its head. None for any other function.
ir_owner_binders: fn(p: IRProgram, function: FnBody) -> [IROwnerBinder] Never! {
    binders := [IROwnerBinder]{}
    owner: if function.kind == {
        .Method(_, owner_type) | .TraitMethod(_, _, owner_type, _, _) -> ir_untag(owner_type)
        .TopLevel -> {
            return binders
        }
    }
    if owner == .Apply(owner_name, args) {
        row: ir_type_def(p, owner_name) ?? return binders
        declared: p.types[row].generic_params
        if declared.len() != args.len() -> return binders
        loop (index, arg) in args {
            name: ir_type_parameter_name(arg) ?? next
            if !ir_declares(declared, name) || ir_declares(function.generic_params, name) -> next
            binders.push(IROwnerBinder{index: index, name: name})
        }
    }
    if type_structural_head_names(owner) == .Val(names) {
        loop (index, name) in names {
            if ir_declares(function.generic_params, name) -> next
            binders.push(IROwnerBinder{index: index, name: name})
        }
    }
    binders
}

ir_type_parameter_name: fn(ty: Type) -> String? Never! {
    if ty == .Named(name) -> return Val(name)
    if ty == .Apply(name, args) {
        if args.len() == 0 -> return Val(name)
    }
    None
}

ir_declares: fn(params: [TGenericParam], name: String) -> Bool Never! {
    loop parameter in params {
        if parameter.name == name -> return true
    }
    false
}

// The owner arguments an instance of `function` binds for its owner type
// `owner` (`[Int]` for `Pair<T>` at `Pair<Int>`, `[Int, 4]` for `[T#N]` at
// `[Int#4]`): None when `owner` does not spell them.
ir_owner_args: fn(p: IRProgram, function: FnBody, owner: Type) -> [Type]? Never! {
    args := [Type]{}
    binders: ir_owner_binders(p, function)
    if binders.len() == 0 -> return Val(args)
    actual: type_structural_args(ir_untag(owner)) ?? ir_type_args(owner)
    loop binder in binders {
        if binder.index >= actual.len() -> return None
        args.push(actual[binder.index].copy())
    }
    Val(args)
}

// The checked return type `declared` of `function` (sema's row for it in
// the instance a call builds), as the type a call of it produces: the plain
// success of a `T Never!` carrier it hands back directly (ir_plain_return).
ir_executable_return_in: fn(function: FnBody, declared: Type?) -> Type? Never! {
    if ir_plain_return(function) == None -> return declared.copy()
    if declared == .Val(written) -> return ir_never_carrier_success(written)
    None
}

// Fact type `ty` of the builder's checked function (a binder's, a call's
// type argument, a signature's, a lambda's) in the instance being built:
// sema's row for it (IRInstance). None when sema published no row for a type
// that names one of the instance's type parameters.
ir_fact_type: fn(p: IRProgram, b: IRBuilder, ty: Type) -> Type? Never! {
    if b.instance.names.len() == 0 -> return Val(ty.copy())
    Val(sema_inference_substitute_type(ty, b.instance.names, b.instance.args))
}

// ir_fact_type, failing the body (a missing checked fact) when sema
// published no row for `ty`.
ir_fact: fn(p: IRProgram, b: ^IRBuilder, ty: Type, span: Span) -> Type Never! {
    if ir_fact_type(p, b, ty) == .Val(found) -> return found
    ir_fail(b, span, "missing checked fact: no instance row for {ir_type_name(ty)}")
    ty.copy()
}

// ir_fact of each of `types`.
ir_facts: fn(p: IRProgram, b: ^IRBuilder, types: [Type], span: Span) -> [Type] Never! {
    loop ty in types -> ir_fact(p, b, ty, span)
}

// Failure carrier `failure` (a function's, a lambda's or a `?`'s) with each
// type ir_fact reads.
ir_fact_failure: fn(p: IRProgram, b: ^IRBuilder, failure: TFailureCarrier, span: Span) -> TFailureCarrier Never! {
    if failure == {
        .Result(success, error) -> return TFailureCarrier.Result{success: ir_fact(p, b, success, span), error: ir_fact(p, b, error, span)}
        .Optional(value) -> return TFailureCarrier.Optional{value: ir_fact(p, b, value, span)}
        .Diverges(value) -> return TFailureCarrier.Diverges{value: ir_fact(p, b, value, span)}
        .Infallible -> return TFailureCarrier.Infallible
    }
}

// Error conversion `conversion` of a `?` with each type ir_fact reads.
ir_fact_conversion: fn(p: IRProgram, b: ^IRBuilder, conversion: TTryConvert, span: Span) -> TTryConvert Never! {
    if conversion == .Typed(fn_name, source, target) {
        return TTryConvert.Typed{fn_name: fn_name.copy(), source: ir_fact(p, b, source, span), target: ir_fact(p, b, target, span)}
    }
    conversion.copy()
}

// Signature type `ty` of checked function `row` (a parameter's or its
// return) in its instance at `args` (concrete): sema's row for it
// (jet_sema sema_instance_type), `ty` itself when it names none of the
// callee's type parameters, and otherwise a failure of the body.
ir_callee_fact: fn(p: IRProgram, b: ^IRBuilder, row: Int, args: [Type], ty: Type, span: Span) -> Type Never! {
    if args.len() == 0 -> return ty.copy()
    names: ir_generic_names(p, p.functions[row])
    sema_inference_substitute_type(ty, names, args)
}

// The object symbol of a function: its Jet path, its module and name joined
// by `.` (`prog.fib`), so native tools that print the symbol table (nm,
// perf, gdb) show Jet names, and `fib_sum` in `prog` stays apart from `sum`
// in `prog_fib`. A byte that is no letter, digit, `_` or `.` becomes `_`.
ir_symbol_name: fn(function: FnBody) -> String Never! {
    bytes := [U8]{}
    loop byte in "{function.module_name}.{function.name}".bytes() {
        kept: (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte == 46
        bytes.push(if kept -> byte else -> U8{95})
    }
    String.from_bytes(bytes) ?? function.name.copy()
}

// Builds the entry `entry_key` and every function it reaches, on up to
// `threads` threads (BuildWaves.jet). `type_defs`, `impls` and `constants`
// are the checked modules' type, implementation and constant declarations,
// in module order; `sources` the checked source files' text (the
// source locations of journeys and contract reports); `foreign` the checked
// foreign functions; `checks` the runtime checks the program's functions
// keep (ir_bounds_mode). Under `dead_code: keep` (checks.keep) every
// non-generic function of checks.modules is a root too, so the image carries
// the package's unreached functions; with checks.debug_views each
// non-generic DebugView implementation's `debug_view` is one, so a debugger
// can call it, and the drop of the [DebugItem] list they return is kept as
// X64_DEBUG_ITEMS_DROP_SYMBOL, so the debugger gives back the list a view
// it called returned; each runtime provider hook the program defines
// (checks.hooks) is one, which the object exports (IRModule.hooks). With
// `trace_sink` the build's steps are
// spans inside the host's `ir.build`: `ir.build.program` (the checked
// program's tables), the steps of ir_build_waves_parted, and
// `ir.build.core_cells`.
ir_build_program: fn(functions: ^^[FnBody], decls: DeclTable, symbols: ^^SymbolTable, interner: ^^Interner, type_defs: ^^[TTypeDef], impls: ^^[TImplDef], sources: ^^IRSourceTexts, constants: ^^[TConstantDef], foreign: ^^[SemaCheckedForeignFunction], entry_key: String, checks: IRChecks, threads: CompilerThreads, trace_sink: CompilerTraceSink?) -> IRBuildResult Never! {
    if trace_sink == .Val(sink) -> sink.begin("ir.build.program", "", -1, -1)
    p := ir_program_new(functions, decls, symbols, interner, type_defs, impls, sources, constants, threads)
    p.checks = checks
    p.zone_table = true
    p.sentries = ir_checks_sentries(checks)
    p.user_values = true
    if !ir_core_image_fits(p) -> p.checks.core = None
    ir_foreign_index(p, foreign, decls)
    row: ir_function_row(p, entry_key) ?? {
        if trace_sink == .Val(sink) -> sink.end("ir.build.program", -1)
        failures := [IRBuildFailure]{IRBuildFailure{key: entry_key, name: entry_key, message: "the entry function is not among the checked functions", source_file: "", span: Span{start: 0, end: 0}}}
        return IRBuildResult{program: ir_module_for(p), failures: failures}
    }
    p.entry = row
    roots := [IRWaveJob]{IRWaveJob{key: p.functions[row].key.copy(), row: row, args: [Type]{}, lambda: -1, part: -1, local: -1}}
    kept_rows := [Int]{}
    if p.checks.keep {
        loop kept in 0..<p.functions.len() {
            if kept != row && p.checks.modules.get(p.functions[kept].module_identity.id) != None {
                kept_rows.push(kept)
            }
        }
    }
    if p.checks.debug_views {
        loop kept in p.trait_methods.rows[ir_trait_method_slot(p.trait_methods, "DebugView", "debug_view")] {
            taken: p.checks.keep && p.checks.modules.get(p.functions[kept].module_identity.id) != None
            if kept != row && !taken -> kept_rows.push(kept)
        }
    }
    loop hook in p.checks.hooks {
        hook_row: ir_function_row(p, hook.key) ?? next
        if hook_row != row && !kept_rows.contains(hook_row) -> kept_rows.push(hook_row)
    }
    loop key in p.checks.roots {
        root_row: ir_function_row(p, key) ?? next
        if root_row != row && !kept_rows.contains(root_row) -> kept_rows.push(root_row)
    }
    kept_keys := [String]{}
    loop kept in kept_rows {
        if p.functions[kept].generic_params.len() > 0 || ir_owner_binders(p, p.functions[kept]).len() > 0 || ir_intrinsic_of(p, p.functions[kept].key) != None {
            next
        }
        roots.push(IRWaveJob{key: p.functions[kept].key.copy(), row: kept, args: [Type]{}, lambda: -1, part: -1, local: -1})
        kept_keys.push(p.functions[kept].key.copy())
    }
    if trace_sink == .Val(sink) -> sink.end("ir.build.program", p.functions.len())
    release_program: !p.checks.debug_views
    waves: ir_build_waves_kept(p, roots, true, threads, trace_sink, release_program: release_program)
    built := waves.result.move()
    loop key in kept_keys {
        at: name_column_get(built.program.function_rows_keys, built.program.function_rows, key) ?? next
        built.program.kept.push(at)
    }
    loop hook in waves.program.checks.hooks.move() {
        at: name_column_get(built.program.function_rows_keys, built.program.function_rows, hook.key) ?? next
        built.program.hooks.push(IRLibraryExport{function: at, symbol: hook.symbol, init_priority: -1, fini_priority: -1, guards: [Int]{}})
    }
    if waves.program.checks.debug_views {
        loop view in waves.program.trait_methods.rows[ir_trait_method_slot(waves.program.trait_methods, "DebugView", "debug_view")] {
            at: name_column_get(built.program.function_rows_keys, built.program.function_rows, waves.program.functions[view].key) ?? next
            items: built.program.functions[at].result
            if items >= 0 && built.program.types[items].drop != "" {
                built.program.kept.push(ir_cell_drop(built.program, X64_DEBUG_ITEMS_DROP_SYMBOL, items))
            }
            break
        }
    }
    if trace_sink == .Val(sink) -> sink.begin("ir.build.core_cells", "", -1, -1)
    if waves.program.checks.core == .Val(image) -> ir_core_cells_bind(built.program, image)
    if trace_sink == .Val(sink) -> sink.end("ir.build.core_cells", -1)
    built
}

// Builds the functions `root_keys` name in `program` (ir_program_new, or
// ir_program_declared and ir_program_bind) and every function they reach,
// as ir_build_root_rows does.
ir_build_roots_in: fn(program: ^^IRProgram, root_keys: [String], threads: CompilerThreads) -> IRBuildKept Never! {
    p := program.move()
    rows := [Int]{}
    failures := [IRBuildFailure]{}
    loop key in root_keys {
        row: ir_function_row(p, key) ?? {
            failures.push(IRBuildFailure{key: key.copy(), name: key.copy(), message: "the root function is not among the checked functions", source_file: "", span: Span{start: 0, end: 0}})
            next
        }
        rows.push(row)
    }
    if failures.len() > 0 {
        empty := ir_module_for(p)
        return IRBuildKept{result: IRBuildResult{program: empty.move(), failures: failures}, program: p.move()}
    }
    ir_build_root_rows(p, rows, threads)
}

// Builds the functions at `rows` of `program` and every function they
// reach, as ir_build_program does, with no program entry: compile-time
// evaluation runs each root itself. The program comes back with the build.
ir_build_root_rows: fn(program: ^^IRProgram, rows: [Int], threads: CompilerThreads) -> IRBuildKept Never! {
    roots: ir_build_root_jobs(program, rows)
    ir_build_waves_kept(program, roots, false, threads, None)
}

// The build jobs of the functions at `rows` of `program`, roots of a build.
ir_build_root_jobs: fn(program: IRProgram, rows: [Int]) -> [IRWaveJob] Never! {
    loop row in rows -> IRWaveJob{key: program.functions[row].key.copy(), row: row, args: [Type]{}, lambda: -1, part: -1, local: -1}
}

// A debugger's evaluations against a running program image (JetCLI
// DebugCompile.jet): `program`, the program's checked functions declared
// and bound once (ir_program_new), held under `checks`, so each evaluation
// only puts and builds its root (ir_build_held_root). Under `bind` (an O0
// image, whose every non-generic function the build kept), a direct call of
// a held function the image holds calls the image's code (IRChecks.held,
// ir_held_symbols).
ir_held_program: fn(program: ^^IRProgram, decls: DeclTable, foreign: ^^[SemaCheckedForeignFunction], checks: IRChecks, bind: Bool{false}) -> IRProgram Never! {
    p := program.move()
    p.checks = checks
    p.sentries = ir_checks_sentries(p.checks)
    p.user_values = true
    if !ir_core_image_fits(p) -> p.checks.core = None
    ir_foreign_index(p, foreign, decls)
    if bind -> p.checks.held = ir_held_symbols(p.functions)
    p
}

// The keys of the non-generic functions of `functions` whose symbol
// (ir_symbol_name) no other function of them has: the image's symbol of
// that name is theirs.
ir_held_symbols: fn(functions: [FnBody]) -> NameTable Never! {
    names: loop function in functions -> if function.generic_params.len() > 0 -> "" else -> ir_symbol_name(function)
    // How many of the functions have each symbol, by its id in `symbols`.
    symbols := name_table_sized(names.len() + 1)
    counts := [Int]{0}
    loop name in names {
        if name == "" -> next
        row: name_index(name_intern(symbols, name))
        if row == counts.len() -> counts.push(1) else -> counts[row] = counts[row] + 1
    }
    held := name_table_sized(names.len() + 1)
    loop (index, name) in names {
        if name == "" -> next
        id: name_find(symbols, name) ?? next
        if counts[name_index(id)] == 1 -> _ := name_intern(held, functions[index].key)
    }
    held
}

// Whether the image holds the function of key `key` under its own symbol
// (IRChecks.held).
ir_held_holds: fn(checks: IRChecks, key: String) -> Bool Never! {
    name_find(checks.held, key) != None
}

// Whether a build binds the image's functions (IRChecks.held).
ir_held_binds: fn(checks: IRChecks) -> Bool Never! { name_count(checks.held) > 1 }

// The source path a held build's root reads its lines from
// (ir_build_held_root).
IR_HELD_ROOT_SOURCE: "<eval>"

// Builds `root` in held program `program` (ir_held_program) with every
// function it reaches but those the image holds (ir_held_bound), with no
// program entry, its Core and program cells the image's. The root takes the
// row of its key, a former evaluation's, else a new last one; the program
// comes back with the build for the next evaluation. The root's spans count
// in its own `text`, which no checked file holds, so its file is
// IR_HELD_ROOT_SOURCE, whose source is `text`.
ir_build_held_root: fn(program: ^^IRProgram, root: ^^FnBody, text: String, threads: CompilerThreads) -> IRBuildKept Never! {
    p := program.move()
    ir_held_source_put(p, IR_HELD_ROOT_SOURCE, text)
    function := root.move()
    ir_declared_function_owner(function, p.types)
    ir_add_function_union_types(p.types, p.type_rows_keys, p.type_rows, function, p.interner)
    function.source_file = IR_HELD_ROOT_SOURCE
    row: ir_function_row(p, function.key) ?? p.functions.len()
    if {
        row < p.functions.len() -> p.functions[row] = function.move()
        else -> {
            name_column_set(p.rows.keys, p.rows.rows, function.key, row)
            p.functions.push(function.move())
        }
    }
    // A build that binds the image's functions (ir_held_symbols) builds the
    // root and the few functions it reaches that the image doesn't hold: on
    // this thread, not on the threads the program's size admits
    // (ir_build_waves_kept).
    roots: ir_build_root_jobs(p, [Int]{row})
    kept := if ir_held_binds(p.checks) -> ir_build_waves_parted(p, roots, false, 1, None) else -> ir_build_waves_kept(p, roots, false, threads, None)
    if kept.program.checks.core == .Val(image) -> ir_core_cells_bind(kept.result.program, image)
    // The program's own cells are the running image's (a debuggable image
    // exports them, ir_debug_cell_exports), not copies placed beside the
    // evaluation.
    ir_debug_cells_bind(kept.result.program)
    // copy: the build moved the program's Interner into the merged module,
    // whose lowering reads it, and the held program's next check and build
    // read it too: a superset of the one it held, as IR-made types append.
    kept.program.interner = kept.result.program.interner[0].copy()
    kept
}

// Puts `text` as the source of the file `file` of held program `program`,
// in place of any it had.
ir_held_source_put: fn(program: ^IRProgram, file: String, text: String) Never! {
    bytes: text.bytes()
    if {
        ir_source_row(program, file) == .Val(row) -> {
            program.source_lines[row] = ir_source_line_starts(bytes)
            program.source_bytes[row] = bytes.move()
        }
        else -> {
            name_column_set(program.source_rows_keys, program.source_rows, file, program.source_bytes.len())
            program.source_lines.push(ir_source_line_starts(bytes))
            program.source_bytes.push(bytes.move())
        }
    }
}

// Appends `function`, a function of the program's source that a held check
// appended to its registration as declaration `decl` (JetDriver
// jet_driver_held_eval_append), to held program `program`
// (ir_held_program), as one of its own: a direct call of `decl` calls it,
// and under IRChecks.held the image's code of it, when no other function
// of the program has its symbol (ir_held_symbols). Its spans count in its
// own `text`, which no checked file holds, so its file is
// IR_HELD_ROOT_SOURCE followed by its key, whose source is `text`. Its row.
ir_held_append: fn(program: ^IRProgram, function: ^^FnBody, decl: DeclID, text: String) -> Int Never! {
    appended := function.move()
    ir_declared_function_owner(appended, program.types)
    ir_add_function_union_types(program.types, program.type_rows_keys, program.type_rows, appended, program.interner)
    appended.source_file = "{IR_HELD_ROOT_SOURCE}{appended.key}"
    ir_held_source_put(program, appended.source_file, text)
    if ir_held_binds(program.checks) {
        symbol: ir_symbol_name(appended)
        alone := true
        loop other in program.functions {
            if ir_symbol_name(other) == symbol -> alone = false
        }
        if alone -> _ := name_intern(program.checks.held, appended.key)
    }
    row: program.functions.len()
    name_column_set(program.rows.keys, program.rows.rows, appended.key, row)
    index: decl.row.index()
    loop program.decl_rows.len() <= index -> program.decl_rows.push(-1)
    program.decl_rows[index] = row
    program.functions.push(appended.move())
    row
}

// The function the executable starts: `entry` itself when it takes nothing,
// returns nothing, the `backtrace` build option is the stock `full`, the
// program allocator the system heap, no job is selectable, the build is
// neither checked nor observed, sets no log filter, links no device store
// and keeps the sentry, otherwise a generated `entry` function. It first
// turns the runtime's sentry off in a build without it
// (ir_sentry_release_link), links a checked build's checked heap
// (ir_checked_alloc_link) and an observed build's observation start
// (ir_observe_link), passes the log filters (ir_log_configure) and the
// device store's package (ir_device_package), a `brief` or `off` backtrace to
// the runtime (jet_rt_fault_backtrace, the IRBacktrace word) and a counting
// program allocator's cap (jet_rt_program_allocator_configure,
// IRChecks.counting), then runs the job the program's
// first word names (jet_rt_entry_job_selected over
// IRChecks.jobs), reports any other job word as unknown (E1294,
// ir_entry_unknown_job) or else runs `entry`, through ir_entry_call.
ir_entry_function: fn(m: ^IRModule, p: IRProgram, entry: Int, failures: ^[IRBuildFailure]) -> Int Never! {
    row: m.functions[entry].result
    if m.functions[entry].param_count > 0 || (row < 0 && p.checks.backtrace == .Full && p.checks.counting == None && p.checks.jobs.len() == 0 && !p.checks.checked_alloc && !p.checks.observe && p.checks.log_package == "" && p.checks.log_flag == "" && p.checks.entry_package == "" && !ir_timing_admitted(p) && p.sentries) {
        return entry
    }
    ty: if row >= 0 -> ir_row_ty(m, p, row) else -> Type.Named{name: "Unit"}
    key: "{m.functions[entry].key}{IR_ENTRY_WRAPPER_SUFFIX}"
    id: m.functions.len()
    m.functions.push(ir_function_new("entry", key, "{m.functions[entry].symbol}__entry", m.functions[entry].source_file, m.functions[entry].line))
    ir_function_bind(m, key, id)
    b := ir_builder_new(m.functions[id].copy())
    b.line = m.functions[entry].line
    span: Span{start: 0, end: 0}
    ir_sentry_release_link(m, p, b)
    ir_checked_alloc_link(m, p, b)
    if ir_timing_admitted(p) -> _: ir_runtime(m, b, "jet_rt_timing_admit", [Int]{}, -1)
    ir_observe_link(m, p, b)
    ir_log_configure(m, p, b)
    ir_device_package(m, p, b)
    if p.checks.backtrace != .Full {
        mode: if p.checks.backtrace == .Brief -> 1 else -> 2
        word: ir_word_const(m, b, mode)
        _: ir_runtime(m, b, "jet_rt_fault_backtrace", [Int]{word}, -1)
    }
    if p.checks.counting == .Val(cap) {
        counting: ir_word_const(m, b, 1)
        limit: ir_word_const(m, b, cap)
        _: ir_runtime(m, b, "jet_rt_program_allocator_configure", [Int]{counting, limit}, -1)
    }
    loop job in p.checks.jobs -> ir_entry_job(m, p, b, job, p.checks.declared_jobs, span)
    selectable := false
    loop job in p.checks.jobs {
        if !job.stripped -> selectable = true
    }
    if p.checks.unknown_jobs && selectable {
        loop name in p.checks.passthrough_jobs {
            ir_entry_passthrough(m, p, b, name, entry, row, ty, span)
        }
        ir_entry_unknown_job(m, b, p.checks.declared_jobs)
    }
    ir_entry_call(m, p, b, entry, row, ty, span)
    ir_emit(b.f, IROp.Return, -1, -1, -1, -1, b.line)
    if b.error != "" {
        failures.push(IRBuildFailure{key: key, name: "entry", message: b.error, source_file: m.functions[entry].source_file, span: b.error_span})
    }
    ir_resolve_deferred(m, p, b)
    m.functions[id] = b.f.move()
    id
}

// The suffix ir_entry_function adds to the key of the entry it runs.
IR_ENTRY_WRAPPER_SUFFIX: "#entry"

// The key of the entry a generated entry function runs, when `key` is one's.
ir_entry_wrapped_key: fn(key: String) -> String? Never! {
    if !key.ends_with(IR_ENTRY_WRAPPER_SUFFIX) -> return None
    Val(key.remove_suffix(IR_ENTRY_WRAPPER_SUFFIX))
}

// Whether the entry admits the host first: the entry package sets
// `policy.harden` and a function holds a `timing: .Fixed` value. The
// runtime (JetRuntime HostTiming.jet jet_rt_timing_admit) ends the program
// with the reason on a host its vendor does not confirm.
ir_timing_admitted: fn(p: IRProgram) -> Bool Never! {
    p.checks.harden && body_fixed_timing(p.functions)
}

// A `--checked-alloc` build's entry (or test harness main) first calls
// jet_rt_alloc_check_link: the call keeps the runtime's checked heap in the
// link (JetRuntime Alloc.jet alloc_check_linked).
ir_checked_alloc_link: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder) Never! {
    if !p.checks.checked_alloc {
        return
    }
    word: ir_word_row(m)
    _: ir_runtime(m, b, "jet_rt_alloc_check_link", [Int]{}, word)
}

// A `jet run --observe` build's entry first calls jet_rt_observe_link: the
// call keeps the runtime's observation start in the link, so a program with
// no task, channel, live value or event still publishes its run (JetRuntime
// ObserveLive.jet jet_rt_observe_start_init).
ir_observe_link: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder) Never! {
    if !p.checks.observe {
        return
    }
    word: ir_word_row(m)
    _: ir_runtime(m, b, "jet_rt_observe_link", [Int]{}, word)
}

// An entry package with a `log:` field, or a `jet run --log` build, passes
// both level filters to the runtime first (JetRuntime RouteALog.jet
// jet_rt_log_configure), which takes the two texts.
ir_log_configure: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder) Never! {
    if p.checks.log_package == "" && p.checks.log_flag == "" {
        return
    }
    string_row: ir_string_row(m)
    package_args: ir_static_text(m, b, p.checks.log_package)
    package: ir_runtime(m, b, "jet_rt_string_from_static", package_args, string_row)
    flag_args: ir_static_text(m, b, p.checks.log_flag)
    flag: ir_runtime(m, b, "jet_rt_string_from_static", flag_args, string_row)
    _: ir_runtime(m, b, "jet_rt_log_configure", [Int]{package, flag}, -1)
}

// A program that links the device store passes its entry package's name to
// the runtime first (JetRuntime World.jet jet_rt_entry_package_set), which
// takes the text and keeps the store's files under it.
ir_device_package: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder) Never! {
    if p.checks.entry_package == "" {
        return
    }
    string_row: ir_string_row(m)
    args: ir_static_text(m, b, p.checks.entry_package)
    package: ir_runtime(m, b, "jet_rt_string_from_static", args, string_row)
    _: ir_runtime(m, b, "jet_rt_entry_package_set", [Int]{package}, -1)
}

// The branch of the entry function that runs `job` when the program's first
// word names it, and returns. A job a release build strips (`job.stripped`)
// is not built: its word ends the process with the unknown-job report
// (E1294, listing `declared`) and the `#Job(.Ship)` fix.
ir_entry_job: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, job: IRJob, declared: [String], span: Span) Never! {
    job_row: ir_function_row(p, job.key) ?? return ir_fail(b, span, "the job {job.name} is not among the checked functions")
    function: p.functions[job_row]
    ir_entry_word_if(m, b, job.name)
    if job.stripped {
        message: ir_static_text(m, b, "unknown command `{job.name}` (Jet.UnknownJob: no job named `{job.name}`; declared jobs: {declared.join(", ")}): a release binary runs only `#Job(.Ship)` jobs; mark `{job.name}` `#Job(.Ship)` to ship it")
        string_row: ir_string_row(m)
        text: ir_runtime(m, b, "jet_rt_string_from_static", message, string_row)
        _: ir_runtime(m, b, "jet_rt_entry_error_exit", [Int]{text}, -1)
        ir_emit(b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
    } else {
        returned: if function.ret == .Val(written) -> Val(ir_fact(p, b, written, function.source_span)) else -> Type?{None}
        job_ty: ir_executable_return_in(function, returned) ?? Type.Named{name: "Unit"}
        job_result := -1
        if !ir_unit_type(job_ty) && !ir_never_type(job_ty) {
            job_result = ir_value_type(m, p, job_ty) ?? return ir_fail(b, function.source_span, "job result type {ir_type_name(job_ty)}")
        }
        callee: ir_function_row_id(m, p, job_row, [Type]{}) ?? return ir_fail(b, function.source_span, "the job {job.name}")
        ir_entry_call(m, p, b, callee, job_result, job_ty, span)
        ir_emit(b.f, IROp.Return, -1, -1, -1, -1, b.line)
    }
    ir_end(b.f, b.line)
}

// Opens the branch taken when the program's first word is `name`
// (jet_rt_entry_job_selected).
ir_entry_word_if: fn(m: ^IRModule, b: ^IRBuilder, name: String) Never! {
    text: ir_static_text(m, b, name)
    word_row: ir_word_row(m)
    selected: ir_runtime(m, b, "jet_rt_entry_job_selected", text, word_row)
    zero: ir_word_const(m, b, 0)
    chosen: ir_bool_op(m, b, IROp.Ne, selected, zero)
    ir_open_if(b.f, chosen, b.line)
}

// The branch for the word of a job argv can't select (IRChecks
// passthrough_jobs): the word is an ordinary program argument, so the entry
// runs ahead of the unknown-job report.
ir_entry_passthrough: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, name: String, entry: Int, row: Int, ty: Type, span: Span) Never! {
    ir_entry_word_if(m, b, name)
    ir_entry_call(m, p, b, entry, row, ty, span)
    ir_emit(b.f, IROp.Return, -1, -1, -1, -1, b.line)
    ir_end(b.f, b.line)
}

// After the job branches: a first word that is not a flag and names no job
// ends the process with the unknown-job report (E1294),
// which lists `declared` (jet_rt_entry_job_unknown); without one the entry
// runs.
ir_entry_unknown_job: fn(m: ^IRModule, b: ^IRBuilder, declared: [String]) Never! {
    prefix: ir_static_text(m, b, "Jet.UnknownJob: no job named `")
    suffix: ir_static_text(m, b, "`; the first program word must name a `#Job fn`; declared jobs: {declared.join(", ")}")
    operands := [Int]{}
    loop operand in prefix -> operands.push(operand)
    loop operand in suffix -> operands.push(operand)
    _: ir_runtime(m, b, "jet_rt_entry_job_unknown", operands, -1)
}

// Calls the program's start `callee` (the entry or a selected job) with
// result row `row` (-1: none) of type `ty`, and handles its failure carrier:
// an `Err` ends the process with the error's report and exit status 1 (the
// default `Err` through jet_rt_entry_error_exit_err, any other error through
// its Printable text and jet_rt_entry_error_exit), a `None` with "entry
// returned no value"; success drops the result.
ir_entry_call: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, callee: Int, row: Int, ty: Type, span: Span) Never! {
    result: if row >= 0 -> ir_fresh_temp(m, b, row) else -> -1
    operands: ir_args(b.f, [Int]{})
    ir_emit(b.f, IROp.Call, result, callee, operands, 0, b.line)
    ir_stop_check(m, b)
    if ir_untag(ty) == {
        .Result(_, err_ty) -> {
            // A kept `T Never!` carrier never holds an Err.
            if !ir_never_type(err_ty) {
                verdict: ir_load_word(m, b, result, 0)
                zero: ir_word_const(m, b, 0)
                failed: ir_bool_op(m, b, IROp.Eq, verdict, zero)
                ir_open_if(b.f, failed, b.line)
                err_row: ir_value_type(m, p, err_ty) ?? ir_pointer_row(m)
                error: ir_load_at(m, b, result, 8, err_row)
                if ir_default_err(p, err_ty) {
                    _: ir_runtime(m, b, "jet_rt_entry_error_exit_err", [Int]{error}, -1)
                } else {
                    text: ir_render(m, p, b, err_ty, error, IRRender.Show, span)
                    _: ir_runtime(m, b, "jet_rt_entry_error_exit", [Int]{text}, -1)
                }
                ir_emit(b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
                ir_end(b.f, b.line)
            }
        }
        .Option(_) -> {
            if m.types[row].kind != .Pointer && !ir_option_inline(m, row) {
                ir_fail(b, span, "an entry returning {ir_type_name(ty)}")
            }
            null: ir_temp_like(m, b, result)
            ir_option_none(m, b, null)
            absent: ir_bool_op(m, b, IROp.Eq, result, null)
            ir_open_if(b.f, absent, b.line)
            message: ir_static_text(m, b, "entry returned no value")
            string_row: ir_string_row(m)
            text: ir_runtime(m, b, "jet_rt_string_from_static", message, string_row)
            _: ir_runtime(m, b, "jet_rt_entry_error_exit", [Int]{text}, -1)
            ir_emit(b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
            ir_end(b.f, b.line)
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    if result >= 0 -> ir_release(m, b, result)
}

// Builds every checked non-generic function (a library or a coverage
// census) on up to `threads` threads; generic functions are built per
// instance their callers reach.
ir_build_all: fn(functions: ^^[FnBody], decls: DeclTable, symbols: ^^SymbolTable, interner: ^^Interner, type_defs: ^^[TTypeDef], impls: ^^[TImplDef], sources: ^^IRSourceTexts, constants: ^^[TConstantDef], foreign: ^^[SemaCheckedForeignFunction], threads: CompilerThreads) -> IRBuildResult Never! {
    p := ir_program_new(functions, decls, symbols, interner, type_defs, impls, sources, constants)
    ir_foreign_index(p, foreign, decls)
    roots := [IRWaveJob]{}
    loop row in 0..<p.functions.len() {
        if p.functions[row].generic_params.len() > 0 || ir_owner_binders(p, p.functions[row]).len() > 0 {
            next
        }
        if ir_intrinsic_of(p, p.functions[row].key) != None -> next
        roots.push(IRWaveJob{key: p.functions[row].key.copy(), row: row, args: [Type]{}, lambda: -1, part: -1, local: -1})
    }
    ir_build_waves(p, roots, false, threads)
}

// Builds the queued functions from queue row `from` on; returns the queue's end.
ir_build_queue: fn(m: ^IRModule, p: IRProgram, failures: ^[IRBuildFailure], from: Int) -> Int Never! {
    cursor := from
    loop cursor < m.queue.len() {
        queued: m.queue[cursor].copy()
        cursor += 1
        ir_build_queued(m, p, failures, queued)
    }
    cursor
}

// Builds the body of one queued function (a checked function or instance,
// or a lambda job) into its row.
ir_build_queued: fn(m: ^IRModule, p: IRProgram, failures: ^[IRBuildFailure], queued: IRQueued) Never! {
    b := ir_builder_new(m.functions[queued.id].copy())
    if queued.lambda >= 0 {
        job: m.lambdas[queued.lambda].copy()
        b.instance = job.instance
        ir_builder_from(p, b, job.row)
        b.made = job.made
        b.next_node = job.next_node
        ir_build_lambda(m, p, b, job)
        ir_keep_failures(failures, b, m.functions[queued.id].key, m.functions[queued.id].name, job.source_file, job.lambda.source_span)
        ir_resolve_deferred(m, p, b)
        m.functions[queued.id] = b.f.move()
        return
    }
    if queued.args.len() > 0 {
        names: ir_generic_names(p, p.functions[queued.row])
        b.instance = IRInstance{names: names, args: queued.args.copy()}
    }
    ir_builder_from(p, b, Val(queued.row))
    b.entry = queued.row == p.entry && queued.args.len() == 0
    ir_build_function(m, p, b, p.functions[queued.row])
    ir_keep_failures(failures, b, m.functions[queued.id].key, p.functions[queued.row].name, p.functions[queued.row].source_file, p.functions[queued.row].source_span)
    ir_resolve_deferred(m, p, b)
    m.functions[queued.id] = b.f.move()
}

// One IRBuildFailure per failure of body `b` (IRBuilder.failures, then the
// failure that ended its build); `whole` is the span of a failure that names
// none.
ir_keep_failures: fn(failures: ^[IRBuildFailure], b: IRBuilder, key: String, name: String, source_file: String, whole: Span) Never! {
    loop row in b.failures {
        failures.push(IRBuildFailure{key: key.copy(), name: name.copy(), message: row.message.copy(), source_file: source_file.copy(), span: if row.span.end > 0 -> row.span else -> whole})
    }
    if b.error != "" {
        failures.push(IRBuildFailure{key: key.copy(), name: name.copy(), message: b.error.copy(), source_file: source_file.copy(), span: if b.error_span.end > 0 -> b.error_span else -> whole})
    }
}

ir_builder_new: fn(f: ^^IRFunction) -> IRBuilder Never! {
    IRBuilder{f: f.move(), bindings: [IRBinding]{}, scopes: [Int]{}, loops: [IRLoopFrame]{}, fresh: [Bool]{}, subjects: [Int]{}, pending: [IRPending]{}, line: 0, error: "", error_span: Span{start: 0, end: 0}, ret: None, failure: TFailureCarrier.Infallible, plain: false, cells: [String]{}, deferred: [IRDeferredCall]{}, closes: [IRClose]{}, places: [IRPlace]{}, moved: [IRMovedPart]{}, part_closes: [IRPartClose]{}, transactions: [IRTxFrame]{}, contracts: [IRContractFrame]{}}
}

// Makes `b` build from checked function `row` (None: glue): the body its
// reads come from (ir_builder_body) and the bounds mode it builds under.
ir_builder_from: fn(p: IRProgram, b: ^IRBuilder, row: Int?) Never! {
    b.row = row
    b.bounds = ir_bounds_mode(p, ir_builder_body(p, row)[0])
}

// The body a builder built from `row` (IRBuilder `row`) reads: its checked
// function's, or glue's empty one (IRProgram `glue`). A one-row view of `p`,
// so a read copies nothing.
ir_builder_body: fn(p: IRProgram, row: Int?) -> View<FnBody> Never! from p {
    if row == .Val(at) -> return p.functions[at..at]
    p.glue[0..0]
}

// The body of glue, which is built from no checked function: no node,
// statement, mask or scope region, and no module, key or local symbol.
ir_glue_body: fn() -> FnBody Never! {
    FnBody{
        name: "",
        module_name: "",
        module_identity: module_none(),
        key: "",
        source_file: "",
        source_span: Span{start: 0, end: 0},
        failure_carrier: TFailureCarrier.Infallible,
        effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}},
        web_bucket: None,
        web_marker: None,
        visibility: NameVisibility.Private,
        foreign: None,
        params: [BodyParameter]{},
        web_param_reconstructions: [TWebParamReconstruction]{},
        ret: None,
        gc_return: false,
        gc_scope: false,
        return_view_provenance: None,
        generic_params: [TGenericParam]{},
        is_main: false,
        line: 0,
        synthetic: false,
        is_unsafe: false,
        unsafe_gate: None,
        is_pure: false,
        memo_bound: None,
        memo_unbounded: false,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_inline: false,
        is_inline_always: false,
        is_scalar: false,
        kernel_proof: None,
        uses_stack_sentry: false,
        body: [Int]{},
        kind: TFuncKind.TopLevel,
        tree: body_tree_new(),
    }
}

// The first id of the nodes a builder makes itself (ir_node), far below the
// function-local ids the checker and the flattener (TEXPR_FIRST_FLAT_ID) hand out.
IR_FIRST_NODE_ID: -1099511627776

// The first index of the statements a builder makes itself (ir_stmt_node),
// far above any checked body's statement count.
IR_FIRST_STMT_INDEX: 1099511627776

// Node `id`: a row of the builder's checked function tree, or a node the
// builder made (ir_node).
ir_body_node: fn(p: IRProgram, b: IRBuilder, id: Int) -> BodyNode Never! {
    if id <= IR_FIRST_NODE_ID -> return b.made.nodes[ir_made_node_index(id)].copy()
    body_node(ir_builder_body(p, b.row)[0].tree, id)
}

// Statement `index`: a statement of the builder's checked function tree, or
// one the builder made (ir_stmt_node).
ir_body_stmt: fn(p: IRProgram, b: IRBuilder, index: Int) -> StmtKind Never! {
    if index >= IR_FIRST_STMT_INDEX -> return b.made.stmts[index - IR_FIRST_STMT_INDEX].copy()
    body_stmt(ir_builder_body(p, b.row)[0].tree, index)
}

// The index of builder-made node `id` in `made.nodes` and `made.expr_types`
// (IRBuilder `made`): ir_node hands the ids out downward from
// IR_FIRST_NODE_ID as it pushes both rows.
ir_made_node_index: fn(id: Int) -> Int Never! { IR_FIRST_NODE_ID - id }

// Span of node `id` without cloning its NodeKind payload.
ir_body_node_span: fn(p: IRProgram, b: IRBuilder, id: Int) -> Span Never! {
    if id <= IR_FIRST_NODE_ID -> return b.made.nodes[ir_made_node_index(id)].span
    tree: ir_builder_body(p, b.row)[0].tree
    tree.nodes[body_node_index(tree, id)].span
}

// Span of statement `index` without cloning its StmtKind payload.
ir_body_stmt_span: fn(p: IRProgram, b: IRBuilder, index: Int) -> Span Never! {
    if index >= IR_FIRST_STMT_INDEX {
        return ir_stmt_kind_span(b.made.stmts[index - IR_FIRST_STMT_INDEX])
    }
    ir_stmt_kind_span(ir_builder_body(p, b.row)[0].tree.stmts[index])
}

ir_body_node_is_local: fn(p: IRProgram, b: IRBuilder, id: Int) -> Bool Never! {
    if id <= IR_FIRST_NODE_ID -> return b.made.nodes[ir_made_node_index(id)].kind == .Local(_)
    tree: ir_builder_body(p, b.row)[0].tree
    tree.nodes[body_node_index(tree, id)].kind == .Local(_)
}

ir_body_node_is_int_lit: fn(p: IRProgram, b: IRBuilder, id: Int) -> Bool Never! {
    if id <= IR_FIRST_NODE_ID {
        return b.made.nodes[ir_made_node_index(id)].kind == .IntLit(_, _)
    }
    tree: ir_builder_body(p, b.row)[0].tree
    tree.nodes[body_node_index(tree, id)].kind == .IntLit(_, _)
}

ir_body_node_int_lit: fn(p: IRProgram, b: IRBuilder, id: Int) -> Int? Never! {
    if id <= IR_FIRST_NODE_ID {
        if b.made.nodes[ir_made_node_index(id)].kind == .IntLit(value, _) -> return Val(value)
        return None
    }
    tree: ir_builder_body(p, b.row)[0].tree
    if tree.nodes[body_node_index(tree, id)].kind == .IntLit(value, _) {
        return Val(value)
    }
    None
}

ir_body_node_is_uninit: fn(p: IRProgram, b: IRBuilder, id: Int) -> Bool Never! {
    if id <= IR_FIRST_NODE_ID -> return b.made.nodes[ir_made_node_index(id)].kind == .Uninit
    tree: ir_builder_body(p, b.row)[0].tree
    tree.nodes[body_node_index(tree, id)].kind == .Uninit
}

ir_body_node_is_move: fn(p: IRProgram, b: IRBuilder, id: Int) -> Bool Never! {
    if id <= IR_FIRST_NODE_ID -> return b.made.nodes[ir_made_node_index(id)].kind == .Move(_)
    tree: ir_builder_body(p, b.row)[0].tree
    tree.nodes[body_node_index(tree, id)].kind == .Move(_)
}

ir_body_node_is_slice: fn(p: IRProgram, b: IRBuilder, id: Int) -> Bool Never! {
    if id <= IR_FIRST_NODE_ID {
        return b.made.nodes[ir_made_node_index(id)].kind == .Slice(_, _, _, _, _)
    }
    tree: ir_builder_body(p, b.row)[0].tree
    tree.nodes[body_node_index(tree, id)].kind == .Slice(_, _, _, _, _)
}

ir_body_node_borrow_inner: fn(p: IRProgram, b: IRBuilder, id: Int) -> Int? Never! {
    if id <= IR_FIRST_NODE_ID {
        if b.made.nodes[ir_made_node_index(id)].kind == .Borrow(inner, _) -> return Val(inner)
        return None
    }
    tree: ir_builder_body(p, b.row)[0].tree
    if tree.nodes[body_node_index(tree, id)].kind == .Borrow(inner, _) {
        return Val(inner)
    }
    None
}

ir_body_node_write_borrow_inner: fn(p: IRProgram, b: IRBuilder, id: Int) -> Int? Never! {
    if id <= IR_FIRST_NODE_ID {
        if b.made.nodes[ir_made_node_index(id)].kind == .Borrow(inner, access) && access == .Write {
            return Val(inner)
        }
        return None
    }
    tree: ir_builder_body(p, b.row)[0].tree
    if tree.nodes[body_node_index(tree, id)].kind == .Borrow(inner, access) && access == .Write {
        return Val(inner)
    }
    None
}

ir_body_node_or_fallback_operand: fn(p: IRProgram, b: IRBuilder, id: Int) -> Int? Never! {
    if id <= IR_FIRST_NODE_ID {
        if b.made.nodes[ir_made_node_index(id)].kind == .OrFallback(operand, _, _) {
            return Val(operand)
        }
        return None
    }
    tree: ir_builder_body(p, b.row)[0].tree
    if tree.nodes[body_node_index(tree, id)].kind == .OrFallback(operand, _, _) {
        return Val(operand)
    }
    None
}

ir_body_node_is_split_call: fn(p: IRProgram, b: IRBuilder, id: Int) -> Bool Never! {
    if id <= IR_FIRST_NODE_ID {
        idx: ir_made_node_index(id)
        return b.made.nodes[idx].kind == .HandleMethod(_, _, _) || b.made.nodes[idx].kind == .CoreCall(_, _, _, _, _, _)
    }
    tree: ir_builder_body(p, b.row)[0].tree
    idx: body_node_index(tree, id)
    tree.nodes[idx].kind == .HandleMethod(_, _, _) || tree.nodes[idx].kind == .CoreCall(_, _, _, _, _, _)
}

ir_body_node_is_no_else: fn(p: IRProgram, b: IRBuilder, id: Int) -> Bool Never! {
    if id <= IR_FIRST_NODE_ID {
        if b.made.nodes[ir_made_node_index(id)].kind == .Never(reason, _) {
            return reason == "no else arm"
        }
        return false
    }
    tree: ir_builder_body(p, b.row)[0].tree
    if tree.nodes[body_node_index(tree, id)].kind == .Never(reason, _) {
        return reason == "no else arm"
    }
    false
}

ir_body_stmts_is_no_else: fn(p: IRProgram, b: IRBuilder, stmts: [Int]) -> Bool Never! {
    if stmts.len() != 1 -> return false
    id: stmts[0]
    if id >= IR_FIRST_STMT_INDEX {
        if b.made.stmts[id - IR_FIRST_STMT_INDEX] == .ExprStmt(val, _) {
            return ir_body_node_is_no_else(p, b, val)
        }
        return false
    }
    if ir_builder_body(p, b.row)[0].tree.stmts[id] == .ExprStmt(val, _) {
        return ir_body_node_is_no_else(p, b, val)
    }
    false
}

ir_shape_has_no_binds: fn(shape: BodyPatternShape) -> Bool Never! {
    if shape == .Absent(_) -> return true
    if shape == .Variant(_, bindings, _, _) {
        loop binding in bindings {
            if binding != .Wildcard -> return false
        }
        return true
    }
    if shape == .Or(alternatives, _) {
        loop alt in alternatives {
            if !ir_shape_has_no_binds(alt) -> return false
        }
        return true
    }
    false
}

ir_expr_is_pure_atom_in: fn(p: IRProgram, b: IRBuilder, node: BodyNode) -> Bool Never! {
    if node.kind == .Local(_) -> return true
    if node.kind == .EnumLit(_, _, _) -> return true
    if node.kind == .IntLit(_, _) -> return true
    if node.kind == .BoolLit(_) -> return true
    if node.kind == .CharLit(_) -> return true
    if node.kind == .Absent -> return true
    if node.kind == .Field(recv, _) -> return ir_expr_is_pure_atom(p, b, recv)
    false
}

ir_expr_is_pure_atom: fn(p: IRProgram, b: IRBuilder, id: Int) -> Bool Never! {
    if id <= IR_FIRST_NODE_ID {
        return ir_expr_is_pure_atom_in(p, b, b.made.nodes[ir_made_node_index(id)])
    }
    tree: ir_builder_body(p, b.row)[0].tree
    ir_expr_is_pure_atom_in(p, b, tree.nodes[body_node_index(tree, id)])
}

ir_expr_is_pure_tag_test_in: fn(p: IRProgram, b: IRBuilder, node: BodyNode) -> Bool Never! {
    if node.kind == .BoolLit(_) -> return true
    if node.kind == .PatternMatches(subj, pat) {
        return ir_expr_is_pure_atom(p, b, subj) && ir_shape_has_no_binds(pat.shape)
    }
    if node.kind == .Binary(op, _, _, lhs, rhs) {
        if op == .Or || op == .And {
            return ir_expr_is_pure_tag_test(p, b, lhs) && ir_expr_is_pure_tag_test(p, b, rhs)
        }
        if op == .Eq || op == .Ne {
            return ir_expr_is_pure_atom(p, b, lhs) && ir_expr_is_pure_atom(p, b, rhs)
        }
    }
    false
}

ir_expr_is_pure_tag_test: fn(p: IRProgram, b: IRBuilder, id: Int) -> Bool Never! {
    if id <= IR_FIRST_NODE_ID {
        return ir_expr_is_pure_tag_test_in(p, b, b.made.nodes[ir_made_node_index(id)])
    }
    tree: ir_builder_body(p, b.row)[0].tree
    ir_expr_is_pure_tag_test_in(p, b, tree.nodes[body_node_index(tree, id)])
}

ir_cond_is_pure_no_binds: fn(p: IRProgram, b: IRBuilder, cond: BodyIfCond) -> Bool Never! {
    if cond == {
        .Plain(value) -> ir_expr_is_pure_tag_test(p, b, value)
        .And(left, right) -> ir_cond_is_pure_no_binds(p, b, left) && ir_cond_is_pure_no_binds(p, b, right)
        .IfLet(pattern, subject) -> ir_expr_is_pure_atom(p, b, subject) && ir_shape_has_no_binds(pattern.shape)
    }
}

// The checked type of `value`: its row in the expression-type column of the
// builder's body (in an instance, sema's row at the instance: IRInstance), or
// of the nodes the builder made (ir_node).
ir_ty: fn(m: IRModule, p: IRProgram, b: IRBuilder, value: Int) -> Type Never! {
    if value <= IR_FIRST_NODE_ID -> return ir_tid_syntax(m, p, b.made.expr_types[ir_made_node_index(value)].ty)
    ty: body_type(p.interner, ir_builder_body(p, b.row)[0].tree, value)
    if b.instance.names.len() == 0 -> return ty
    sema_inference_substitute_type(ty, b.instance.names, b.instance.args)
}

// Fast TypeID lookup of node `value` without constructing a Type on the non-generic path.
ir_ty_id: fn(m: ^IRModule, p: IRProgram, b: IRBuilder, value: Int) -> TypeID Never! {
    if value <= IR_FIRST_NODE_ID -> return b.made.expr_types[ir_made_node_index(value)].ty
    tree: ir_builder_body(p, b.row)[0].tree
    if b.instance.names.len() == 0 -> return body_type_id(tree, value)
    ir_intern_tid(m, p, sema_inference_substitute_type(body_type(p.interner, tree, value), b.instance.names, b.instance.args))
}

// The layout row of node `value`'s checked type (ir_ty_id, ir_value_type_id).
ir_node_row: fn(m: ^IRModule, p: IRProgram, b: IRBuilder, value: Int) -> Int? Never! {
    tid: ir_ty_id(m, p, b, value)
    ir_value_type_id(m, p, tid)
}

// A node the builder makes itself (a desugared step), typed `ty` under the
// next builder id.
ir_node: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, ty: Type, kind: NodeKind, span: Span) -> Int Never! {
    id: b.next_node
    b.next_node -= 1
    tid: ir_intern_tid(m, p, ty)
    b.made.expr_types.push(TExprType{id: id, ty: tid})
    b.made.nodes.push(BodyNode{id: id, kind: kind, span: span})
    id
}

// A statement the builder makes itself (a desugared step).
ir_stmt_node: fn(b: ^IRBuilder, statement: StmtKind) -> Int Never! {
    b.made.stmts.push(statement.copy())
    IR_FIRST_STMT_INDEX + b.made.stmts.len() - 1
}

ir_resolve_deferred: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder) Never! {
    loop call in b.deferred {
        callee: ir_function_id(m, p, call.key, call.args) ?? -1
        if call.function >= 0 -> m.functions[call.function].a[call.at] = callee else {
            b.f.a[call.at] = callee
        }
    }
    ir_resolve_part_closes(m, p, b)
}

// A payload binding a condition introduces: `slot` (named `name`) receives
// the payload at byte `offset` of the carrier box `subject` once the test holds.
// `selector`: the variant (or Result side) the payload belongs to, -1 for a
// struct member or an Option's payload (BuildOwn.jet IRPartStep).
// `boxed`: the member at `offset` is a recursive edge's wrapper box holding the payload.
// `loaded`: an or-pattern already loaded `slot` in its matching alternative.
// `window`: the subject is a write window (`if ^place == ...`), so the name
// binds the payload's storage and an assignment to it lands in the box.
IRPending: struct {
    name: String,
    slot: Int,
    subject: Int,
    offset: Int,
    selector: Int{-1},
    boxed: Bool{false},
    loaded: Bool{false},
    window: Bool{false},
}

// Opens the If of a condition and binds its pending payloads in it.
ir_open_condition: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, test: Int) Never! {
    ir_open_if(b.f, test, b.line)
    ir_bind_pending(m, p, b)
}

ir_bind_pending: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder) Never! {
    pending: b.pending
    b.pending = [IRPending]{}
    loop row in pending {
        // An aggregate payload is already bound by address (ir_pending_load).
        // A window's subject is already its holder's own box
        // (ir_window_subject), and so is a recursive edge's wrapper in it:
        // the name binds the payload's storage, the wrapper's for an edge.
        row_type: b.f.slot_type[row.slot]
        subject_row: b.f.slot_type[row.subject]
        // A view Result's Ok names a view of its allocator's storage.
        if row.selector == 1 && ir_view_result(ir_row_ty(m, p, subject_row)) {
            ir_bind_view_result(m, p, b, row.name, row.subject, row_type)
            next
        }
        if row.window && ir_option_inline(m, subject_row) {
            // An inline Option's payload is its word (zero-extended, so a
            // payload store of its own width keeps it): the name binds the
            // word's storage at the window's place.
            address: b.windows.get(row.subject) ?? -1
            if address < 0 {
                ir_fail(b, Span{start: 0, end: 0}, "a write window into an inline {ir_type_name(ir_row_ty(m, p, subject_row))} without its place")
                next
            }
            b.bindings.push(IRBinding{name: row.name, slot: address, indirect: row_type})
            next
        }
        // A recursive edge's counted wrapper may be shared by copies of
        // the struct holding it: a window writes through its holder's own.
        if row.window && row.boxed && !row.loaded {
            _: ir_wrapper_unique(m, p, b, row.subject, IRMember{name: "", offset: row.offset, ty: row_type, boxed: true})
        }
        if row.window && !row.loaded && m.types[row_type].kind != .Aggregate {
            pointer_row: ir_pointer_row(m)
            address: ir_temp(m, b, pointer_row)
            ir_emit(b.f, if row.boxed -> IROp.Load else -> IROp.Offset, address, row.subject, row.offset, -1, b.line)
            b.bindings.push(IRBinding{name: row.name, slot: address, indirect: row_type})
            next
        }
        if !row.loaded -> ir_pending_load(m, b, row, row.slot)
        ir_close_note(m, p, b, row.slot, row.subject, IRPartStep{selector: row.selector, offset: row.offset})
        b.bindings.push(IRBinding{name: row.name, slot: row.slot, carrier: if row.boxed -> -1 else -> row.subject})
    }
}

// Marks the pending payload bindings from `from` on, those of a test on
// `subject`, as write windows when the subject is one (`^place`).
ir_pending_windows: fn(p: IRProgram, b: ^IRBuilder, subject: Int, from: Int) Never! {
    write := false
    if ir_body_node(p, b, subject).kind == .Borrow(_, access) -> write = access == .Write
    if !write {
        return
    }
    loop index in from..<b.pending.len() {
        row: b.pending[index]
        b.pending[index] = IRPending{name: row.name.copy(), slot: row.slot, subject: row.subject, offset: row.offset, selector: row.selector, boxed: row.boxed, loaded: row.loaded, window: true}
    }
}

// Loads the payload `row` names into `slot`.
ir_pending_load: fn(m: ^IRModule, b: ^IRBuilder, row: IRPending, slot: Int) Never! {
    // An inline Option's payload is its own word (ir_option_payload).
    if ir_option_inline(m, b.f.slot_type[row.subject]) {
        ir_emit(b.f, IROp.Move, slot, row.subject, -1, -1, b.line)
        return
    }
    op: if m.types[b.f.slot_type[slot]].kind == .Aggregate -> IROp.Offset else -> IROp.Load
    if row.boxed {
        pointer_row: ir_pointer_row(m)
        wrapper: ir_temp(m, b, pointer_row)
        ir_emit(b.f, IROp.Load, wrapper, row.subject, row.offset, -1, b.line)
        ir_emit(b.f, op, slot, wrapper, 0, -1, b.line)
    } else { ir_emit(b.f, op, slot, row.subject, row.offset, -1, b.line) }
}

ir_fail: fn(b: ^IRBuilder, span: Span, message: String) Never! {
    if b.error != "" {
        return
    }
    b.error = message
    b.error_span = span
}

ir_failed: fn(b: IRBuilder) -> Bool Never! { b.error != "" }

// Returns `slot` (-1: nothing) after releasing the guards the statements
// being built hold and dropping every owned variable. Code after the
// Return in the same block is dead, so the variables keep the ownership
// they had: the paths that go on past the enclosing branch see it. A
// `defer` body runs among the drops and may assign the returned variable,
// so the value leaves as the return computed it.
ir_emit_return: fn(m: ^IRModule, b: ^IRBuilder, slot: Int) Never! {
    states: ir_own_states(b, b.bindings.len())
    if slot >= 0 {
        b.fresh[slot] = false
        // The returned value leaves with the caller; its variable keeps nothing.
        ir_disown(b, slot)
    }
    ir_close_disarm(b, slot)
    ir_exit_statement_guards(b, 0)
    ir_entry_ending(m, b)
    result := slot
    if slot >= 0 && ir_defers_open(b) {
        result = ir_temp(m, b, b.f.slot_type[slot])
        ir_emit(b.f, IROp.Copy, result, slot, -1, -1, b.line)
    }
    ir_drop_bindings(m, b, 0)
    ir_emit(b.f, IROp.Return, -1, result, -1, -1, b.line)
    ir_set_own_states(b, states)
}

// Whether a `defer` body is registered in an open block.
ir_defers_open: fn(b: IRBuilder) -> Bool Never! {
    loop binding in b.bindings {
        if binding.cleanup >= 0 -> return true
    }
    false
}

// The program entry is about to drop its variables and return: the runtime
// learns the process is ending (jet_rt_process_entry_return), so those
// drops free nothing (#5478). Its user cleanup (closes, guards) still runs.
ir_entry_ending: fn(m: ^IRModule, b: ^IRBuilder) Never! {
    if b.entry -> _: ir_runtime(m, b, "jet_rt_process_entry_return", [Int]{}, -1)
}

// Takes the guard `held` a temporary of the statement being built
// dereferences, or holds a temporary with cleanup closed by `glue` (-1:
// none; `drops`: its type has a drop): it ends with the statement (ir_stmt)
// or an early exit out of it (ir_exit_statement_guards).
ir_hold_statement_guard: fn(b: ^IRBuilder, held: Int, glue: Int, drops: Bool) Never! {
    opener: if b.f.open.len() > 0 -> b.f.open[b.f.open.len() - 1] else -> -1
    part: if opener >= 0 && b.f.op[opener] == .If -> b.f.b[opener] else -> -1
    b.statement_guards.push(IRStatementGuard{slot: held, opener: opener, part: part, glue: glue, drops: drops})
}

// An early exit (a return, `?`, or a break/next out of a loop whose frame
// kept `mark`) skips the ends of the statements being built, where ir_stmt
// releases their guards and temporaries: it ends those taken since `mark`,
// latest first. One taken on a branch the exit is not on is not held there.
// The statements keep them for the paths that go on.
ir_exit_statement_guards: fn(b: ^IRBuilder, mark: Int) Never! {
    index := b.statement_guards.len() - 1
    loop index >= mark {
        guard: b.statement_guards[index]
        index -= 1
        if !ir_statement_guard_held(b.f, guard) -> next
        if guard.glue >= 0 -> ir_close_call(b, guard.glue, guard.slot)
        if guard.drops -> ir_emit(b.f, IROp.Drop, -1, guard.slot, -1, -1, b.line)
    }
}

// Whether the code being emitted runs after `guard` was taken on every
// path: the construct it was taken in is still open, in the same part.
ir_statement_guard_held: fn(f: IRFunction, guard: IRStatementGuard) -> Bool Never! {
    if guard.opener < 0 -> return true
    if !f.open.contains(guard.opener) -> return false
    f.op[guard.opener] != .If || f.b[guard.opener] == guard.part
}

// Drops the owned variables among bindings[mark..], latest first; a
// variable that still owns a value that closes closes it first. The
// variables a `defer close` closes close before all of them, the latest
// defer first (ir_close_deferred). An alias of a variable (a pinned
// argument, a place read in place) closes nothing: its variable does. A
// `defer` body runs in its entry's place among the drops (ir_run_defer).
ir_drop_bindings: fn(m: ^IRModule, b: ^IRBuilder, mark: Int) Never! {
    ir_close_deferred(b, mark)
    index := b.bindings.len() - 1
    loop index >= mark {
        binding: b.bindings[index]
        alias: ir_binding_is_alias(b, index)
        index -= 1
        if binding.cleanup >= 0 {
            ir_run_defer(m, b, binding.cleanup)
            next
        }
        if binding.indirect < 0 && !alias && !ir_close_is_deferred(b, binding.slot) {
            ir_close_now(b, binding.slot)
        }
        if !binding.owned -> next
        ir_drop_binding(m, b, binding)
    }
}

// Whether bindings[index] names the slot of an earlier variable: an alias
// that never owns the value it reads.
ir_binding_is_alias: fn(b: IRBuilder, index: Int) -> Bool Never! {
    slot: b.bindings[index].slot
    if slot < 0 || b.bindings[index].indirect >= 0 -> return false
    loop earlier in 0..<index {
        if b.bindings[earlier].slot == slot && b.bindings[earlier].indirect < 0 -> return true
    }
    false
}

// Drops the value the owned variable `binding` holds; one some paths moved
// drops only where its live flag holds.
ir_drop_binding: fn(m: ^IRModule, b: ^IRBuilder, binding: IRBinding) Never! {
    if binding.live >= 0 -> ir_open_if(b.f, binding.live, b.line)
    value: ir_read_binding(m, b, binding)
    ir_emit(b.f, IROp.Drop, -1, value, -1, -1, b.line)
    if binding.live >= 0 -> ir_end(b.f, b.line)
}

// `slot` as a value its new holder owns: a fresh value moves; a variable's
// own aggregate moves (the variable stops owning it, and the slot reads as
// fresh to the holder that stores it); an aggregate another holder keeps
// is shared (a byte copy whose buffers gain an owner, ir_copy_value); any
// other read of a place another holder keeps is copied through its type's
// runtime clone. A value with a drop and no clone (a file or socket handle,
// or an aggregate holding one) moves: the variable it is read from stops
// owning it, so its scope-end drop cannot release what the new holder keeps.
ir_own: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, slot: Int) -> Int Never! {
    if slot < 0 || b.fresh[slot] || !ir_has_drop(m, b, slot) -> return slot
    row: b.f.slot_type[slot]
    if m.types[row].kind == .Aggregate && m.types[row].drop == ir_drop_key(m, row) {
        if ir_movable_binding(b, slot) {
            ir_disown(b, slot)
            b.fresh[slot] = true
            return slot
        }
        // Sema reads a variable holding an aggregate with no clone (a List
        // of handles, a struct or tuple holding one) as a move, its last use
        // (E0121 on any later one), so the variable gives it up as `x.move()` does
        // and its closing parts no longer end it.
        if ir_owned_binding(b, slot) && ir_row_lacks_clone(m, p, row) {
            ir_close_disarm(b, slot)
            ir_disown(b, slot)
            b.fresh[slot] = true
            return slot
        }
        // `x.move()` of a payload bound from the Option or Result box a variable
        // owns (`if warm.move() == { .Val(list) -> keep(list) }`) moves the
        // payload out of the box the same way (ir_payload_take).
        if b.moving == slot && ir_row_lacks_clone(m, p, row) {
            taken: ir_payload_take(m, p, b, slot)
            if taken >= 0 -> return taken
        }
        // Any other shared List whose items have no clone glue is an internal
        // error (I2): a by-value walk of a shared buffer clones each item
        // (jet_rt_native_iter_from_list), and there is no clone to call.
        if ir_list_items_lack_clone(m, p, row) {
            return ir_fail_slot(b, Span{start: 0, end: 0}, "a shared {ir_type_name(ir_row_ty(m, p, row))}, whose items have no clone")
        }
        return ir_copy_value(m, p, b, slot, Span{start: 0, end: 0})
    }
    symbol: m.types[row].clone
    if symbol == "" {
        ir_disown(b, slot)
        return slot
    }
    // `x.move()` moves the variable's own value: the variable stops owning it, so
    // the new holder alone ends it (#6584). A second owner of a box whose
    // payload has no clone would share that payload (I2), and a payload
    // moved out of it later (ir_payload_take) needs the box's only owner.
    if ir_movable_binding(b, slot) {
        ir_disown(b, slot)
        b.fresh[slot] = true
        return slot
    }
    ir_clone(m, b, slot, row)
}

// The payload binding in `slot` moved out (`x.move()`) of the Option or Result box
// in `carrier` that a variable owns on every path here, as a value of its own
// (ir_box_hand_over): the box hands it over, and the variable stops holding
// the box on this path, so neither its drop nor its closing parts reach the
// payload. -1 when `slot` is no such binding.
ir_payload_take: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, slot: Int) -> Int Never! {
    index := b.bindings.len() - 1
    loop index >= 0 && b.bindings[index].slot != slot -> index -= 1
    if index < 0 -> return -1
    binding: b.bindings[index]
    carrier: binding.carrier
    if binding.owned || binding.indirect >= 0 || carrier < 0 || !ir_owned_binding(b, carrier) {
        return -1
    }
    carrier_row: b.f.slot_type[carrier]
    if !ir_box_row(m, carrier_row) -> return -1
    if ir_untag(ir_row_ty(m, p, carrier_row)) == {
        .Option(_) | .Result(_, _) -> {}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return -1
    }
    ir_close_disarm(b, slot)
    ir_close_disarm(b, carrier)
    ir_disown(b, carrier)
    carrier_bytes: ir_box_bytes(m, p, carrier_row)
    ir_box_hand_over(m, p, b, carrier, slot, b.f.slot_type[slot], carrier_bytes)
}

// `x.f.move()` (or `x.f.g.move()`) of a variable that owns its value on every path here:
// the member's bytes move to the new holder, and the variable's copy of them
// is zeroed in place (ir_zero_drops), which its drop glue, a write of the
// member and a whole reassignment all skip, so only the new holder ends what
// the member held (#6584). A member with no clone glue (a FileReader, or a
// struct holding one) moves the same way: a move copies no payload, and the
// in-place read it would otherwise be leaves its handles to the owner's scope
// end, after a `close` or a consuming call already ended the value. -2 for
// any other place, which `.move()` reads as a variable's value (ir_own).
ir_move_member: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, place: Int, span: Span) -> Int Never! {
    node: ir_body_node(p, b, place).kind
    if node == .Field(receiver, field) {
        member: ir_owned_member(m, p, b, receiver, field.name) ?? return -2
        row: member.ty
        if m.types[row].drop == "" || !ir_zeroable(m, p, row) -> return -2
        base: ir_expr(m, p, b, receiver)
        if ir_failed(b) || base < 0 -> return -1
        read: ir_member_read(m, b, base, member)
        ir_close_note(m, p, b, read, base, IRPartStep{selector: -1, offset: member.offset})
        ir_close_disarm(b, read)
        taken := read
        if m.types[row].kind == .Aggregate {
            taken = ir_temp(m, b, row)
            ir_emit(b.f, IROp.StackAddress, taken, m.types[row].size, 8, -1, b.line)
            ir_emit(b.f, IROp.CopyBytes, -1, taken, read, m.types[row].size, b.line)
        }
        ir_zero_drops(m, p, b, base, member.offset, row)
        b.fresh[taken] = true
        return taken
    }
    -2
}

// The receiver of a `^^self` method call, which consumes it: a member of a
// variable moves out of it (ir_move_member), and a variable's own value
// moves as `x.move()` does, so the callee's drop of `self` is its only end (#6584).
ir_move_receiver: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, receiver: Int, span: Span) -> Int Never! {
    taken: ir_move_member(m, p, b, receiver, span)
    if taken != -2 -> return taken
    slot: ir_expr(m, p, b, receiver)
    if ir_body_node(p, b, receiver).kind == .Local(_) -> b.moving = slot
    slot
}

// The inline member `name` of the value `receiver` reads: a variable that
// owns it on every path here, or an inline member of one. None for any other.
ir_owned_member: fn(m: ^IRModule, p: IRProgram, b: IRBuilder, receiver: Int, name: String) -> IRMember? Never! {
    ty: ir_ty(m, p, b, receiver)
    if ir_reactive_type(p, ty) || ir_default_err(p, ty) || ir_pin_target(p, ty) != None {
        return None
    }
    row: ir_value_type(m, p, ty) ?? return None
    if m.types[row].kind != .Aggregate -> return None
    member: ir_member_of_row(m, p, row, name) ?? return None
    if member.boxed -> return None
    node: ir_body_node(p, b, receiver).kind
    if node == .Local(local) {
        if local.persist_key != None -> return None
        binding: ir_lookup_local(b, local) ?? return None
        if !ir_owned_binding(b, binding.slot) -> return None
        return Val(member)
    }
    if node == .Field(inner, field) {
        _: ir_owned_member(m, p, b, inner, field.name) ?? return None
        return Val(member)
    }
    None
}

// Whether a value of type row `row` zeroed in place holds nothing its drop
// ends: a null handle, box, trait value, Shared, function value or String, an
// inline Int or a word that drops as one (an `Int?`), a counted buffer of
// capacity 0, or a tuple or struct of those. A Shared's drop
// (jet_rt_native_shared_drop) skips a null cell, and a function value's
// (jet_ir_closure_drop) a null box.
ir_zeroable: fn(m: ^IRModule, p: IRProgram, row: Int) -> Bool Never! {
    kind: m.types[row].kind
    if m.types[row].drop == "" || kind == .Int || kind == .String || m.types[row].drop == "jet_rt_int_drop" {
        return true
    }
    if kind == .Pointer {
        return ir_box_row(m, row) || ir_trait_row(m, row) || ir_link_row(m, row) || ir_is_handle(m, row) || m.types[row].drop == "jet_rt_native_shared_drop" || m.types[row].clone == ir_closure_share()
    }
    if kind != .Aggregate || ir_atomic_scalar(ir_row_ty(m, p, row)) != None -> return false
    if ir_counted_entry(m, p, row) != None -> return true
    members: ir_inline_members(m, p, row) ?? return false
    loop member in members {
        if member.boxed || !ir_zeroable(m, p, member.ty) -> return false
    }
    true
}

// Zeroes what the drop of the value of type row `row` at byte `offset` of
// `base` would end (ir_zeroable): its words, and a counted buffer's length
// and capacity.
ir_zero_drops: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, base: Int, offset: Int, row: Int) Never! {
    if m.types[row].drop == "" {
        return
    }
    if m.types[row].kind != .Aggregate {
        zero: ir_word_const(m, b, 0)
        ir_emit(b.f, IROp.Store, -1, base, offset, zero, b.line)
        return
    }
    if ir_counted_entry(m, p, row) != None {
        zero: ir_word_const(m, b, 0)
        ir_emit(b.f, IROp.Store, -1, base, offset, zero, b.line)
        ir_emit(b.f, IROp.Store, -1, base, offset + 8, zero, b.line)
        if ir_ordered_header(m, p, row) {
            ir_emit(b.f, IROp.Store, -1, base, offset + 24, zero, b.line)
        }
        return
    }
    members: ir_inline_members(m, p, row) ?? return
    loop member in members -> ir_zero_drops(m, p, b, base, offset + member.offset, member.ty)
}

// Whether a variable owns the value in `slot` (its own storage) on every
// path that reaches here.
ir_owned_binding: fn(b: IRBuilder, slot: Int) -> Bool Never! {
    ir_owned_binding_index(b, slot) >= 0
}

ir_owned_binding_index: fn(b: IRBuilder, slot: Int) -> Int Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        binding: b.bindings[index]
        if binding.slot == slot && binding.indirect < 0 && binding.owned && binding.live < 0 {
            return index
        }
        index -= 1
    }
    -1
}

// The live flag of the variable owning `slot` where only some paths kept
// its value (-1: none).
ir_live_flag: fn(b: IRBuilder, slot: Int) -> Int Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        binding: b.bindings[index]
        if binding.slot == slot && binding.indirect < 0 && binding.owned -> return binding.live
        index -= 1
    }
    -1
}

// Whether a read of the variable owning `slot` may move its value to a new
// holder: only an explicit `x.move()` does. Sema does not mark a plain read as a
// last use (`sym(Item.F{value: f})` followed by a read of `f` is a plain
// read too), so a plain read shares: a byte copy whose buffers and boxes
// gain an owner, which the variable's own scope-end drop gives back.
ir_movable_binding: fn(b: IRBuilder, slot: Int) -> Bool Never! {
    if ir_owned_binding_index(b, slot) < 0 -> return false
    b.moving == slot
}

// The owned variables whose value is in `slot` no longer own it.
ir_disown: fn(b: ^IRBuilder, slot: Int) Never! {
    loop index in 0..<b.bindings.len() {
        binding: b.bindings[index]
        if binding.slot != slot || binding.indirect >= 0 || !binding.owned -> next
        b.bindings[index] = IRBinding{name: binding.name.copy(), slot: binding.slot, indirect: binding.indirect, owned: false, symbol: binding.symbol, write: binding.write, carrier: binding.carrier}
    }
}

// The variable `binding` names owns the value in its slot again (a move
// out of it was followed by an assignment), on every path.
ir_reown: fn(b: ^IRBuilder, binding: IRBinding) Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        row: b.bindings[index]
        if row.slot == binding.slot && row.indirect < 0 && row.name == binding.name {
            ir_set_own_state(b, index, IROwnState{owned: true})
            return
        }
        index -= 1
    }
}

// A variable's ownership on one path: whether it owns its value, and its
// live flag (IRBinding.live).
IROwnState: struct {
    owned: Bool,
    live: Int{-1},
}

// The ownership of the variables bound before `count`.
ir_own_states: fn(b: IRBuilder, count: Int) -> [IROwnState] Never! {
    states: loop index in 0..<count -> IROwnState{owned: b.bindings[index].owned, live: b.bindings[index].live}
    states
}

ir_set_own_state: fn(b: ^IRBuilder, index: Int, state: IROwnState) Never! {
    row: b.bindings[index]
    if row.owned == state.owned && row.live == state.live {
        return
    }
    b.bindings[index] = IRBinding{name: row.name.copy(), slot: row.slot, indirect: row.indirect, owned: state.owned, symbol: row.symbol, write: row.write, carrier: row.carrier, live: state.live, cleanup: row.cleanup}
}

// Restores the ownership `states` of the variables bound before it.
ir_set_own_states: fn(b: ^IRBuilder, states: [IROwnState]) Never! {
    loop index in 0..<states.len() {
        if index >= b.bindings.len() -> break
        ir_set_own_state(b, index, states[index])
    }
}

// Where the two paths of an If on `test` meet: the bindings hold the else
// path's ownership, `then_states` the then path's. A path that leaves passes
// the other's ownership on unchanged.
ir_meet_paths: fn(m: ^IRModule, b: ^IRBuilder, test: Int, then_states: [IROwnState], then_leaves: Bool, else_leaves: Bool) Never! {
    if else_leaves -> return ir_set_own_states(b, then_states)
    if then_leaves {
        return
    }
    else_states: ir_own_states(b, then_states.len())
    ir_join_owned(m, b, test, then_states, else_states)
}

// A variable one path moved and the other kept still owns its value
// through a live flag each path sets, which its drop tests.
ir_join_owned: fn(m: ^IRModule, b: ^IRBuilder, test: Int, then_states: [IROwnState], else_states: [IROwnState]) Never! {
    joined := [Int]{}
    loop index in 0..<then_states.len() {
        if index >= b.bindings.len() -> break
        kept: then_states[index]
        other: else_states[index]
        if kept.owned == other.owned && kept.live == other.live -> ir_set_own_state(b, index, kept) else if !kept.owned && !other.owned {
            ir_set_own_state(b, index, IROwnState{owned: false})
        } else { joined.push(index) }
    }
    if joined.len() == 0 {
        return
    }
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    lives := [Int]{}
    loop _ in joined -> lives.push(ir_temp(m, b, bool_row))
    ir_open_if(b.f, test, b.line)
    loop (at, index) in joined -> ir_live_set(b, lives[at], then_states[index])
    ir_else(b.f, b.line)
    loop (at, index) in joined -> ir_live_set(b, lives[at], else_states[index])
    ir_end(b.f, b.line)
    loop (at, index) in joined {
        ir_set_own_state(b, index, IROwnState{owned: true, live: lives[at]})
    }
}

// Ends an If whose then path built user code (a pattern's payload value or
// nested test, a later alternative) and whose else path builds nothing,
// opened when the bindings held `before`. A variable the then path moved
// still owns its value on the else path, through a live flag each path sets
// as ir_join_owned does, but set here, on the paths themselves: a pattern
// test rewrites the Bool the If tested, so no test is left to join on after
// it. Where the then path changed nothing, this is the If's end alone.
ir_end_tested: fn(m: ^IRModule, b: ^IRBuilder, before: [IROwnState]) Never! {
    then_states: ir_own_states(b, before.len())
    joined := [Int]{}
    loop index in 0..<before.len() {
        kept: then_states[index]
        other: before[index]
        if kept.owned == other.owned && kept.live == other.live -> next
        if {
            !kept.owned && !other.owned -> ir_set_own_state(b, index, IROwnState{owned: false})
            else -> joined.push(index)
        }
    }
    if joined.len() == 0 -> return ir_end(b.f, b.line)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    lives := [Int]{}
    loop _ in joined -> lives.push(ir_temp(m, b, bool_row))
    loop (at, index) in joined -> ir_live_set(b, lives[at], then_states[index])
    ir_else(b.f, b.line)
    loop (at, index) in joined -> ir_live_set(b, lives[at], before[index])
    ir_end(b.f, b.line)
    loop (at, index) in joined {
        ir_set_own_state(b, index, IROwnState{owned: true, live: lives[at]})
    }
}

// Before a loop's exit Block opens: its edge word (IRLoopFrame.edge), 0 on
// the path that leaves at its test, when a variable bound before it has a
// drop, so a `break` may leave it owning other than that path does;
// else -1.
ir_loop_edge: fn(m: ^IRModule, b: ^IRBuilder) -> Int Never! {
    loop index in 0..<b.bindings.len() {
        binding: b.bindings[index]
        if binding.indirect < 0 && binding.slot >= 0 && ir_has_drop(m, b, binding.slot) {
            return ir_word_const(m, b, 0)
        }
    }
    -1
}

// After a loop's exit Block ends, where its exits meet: each `break` to it
// (IRLoopEdge, with edge word `edge`) and, when `tested` (the loop has a
// test), the path that left there, whose ownership the bindings hold. A
// loop without a test takes its first break's ownership as that path's. A
// variable the exits disagree on still owns its value through a live flag
// each exit's edge word selects, as ir_join_owned does for an If's two.
ir_loop_join: fn(m: ^IRModule, b: ^IRBuilder, edge: Int, tested: Bool) Never! {
    if edge < 0 {
        return
    }
    rows := [Int]{}
    loop at in 0..<b.loop_edges.len() {
        if b.loop_edges[at].edge == edge -> rows.push(at)
    }
    if rows.len() == 0 {
        return
    }
    first := 0
    if !tested {
        loop index in 0..<b.loop_edges[rows[0]].states.len() {
            if index >= b.bindings.len() -> break
            state: b.loop_edges[rows[0]].states[index]
            ir_set_own_state(b, index, state)
        }
        first = 1
    }
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    count: b.loop_edges[rows[0]].states.len()
    loop index in 0..<count {
        if index >= b.bindings.len() -> break
        base: IROwnState{owned: b.bindings[index].owned, live: b.bindings[index].live}
        differs := false
        held := base.owned
        loop at in first..<rows.len() {
            state: b.loop_edges[rows[at]].states[index]
            if state.owned != base.owned || state.live != base.live -> differs = true
            if state.owned -> held = true
        }
        if !differs -> next
        if !held {
            ir_set_own_state(b, index, IROwnState{owned: false})
            next
        }
        live: ir_temp(m, b, bool_row)
        ir_live_set(b, live, base)
        loop at in first..<rows.len() {
            state: b.loop_edges[rows[at]].states[index]
            if state.owned == base.owned && state.live == base.live -> next
            id: ir_word_const(m, b, b.loop_edges[rows[at]].id)
            taken: ir_bool_op(m, b, IROp.Eq, edge, id)
            ir_open_if(b.f, taken, b.line)
            ir_live_set(b, live, state)
            ir_end(b.f, b.line)
        }
        ir_set_own_state(b, index, IROwnState{owned: true, live: live})
    }
}

// Sets the live flag `live` to whether a variable in `state` holds its value.
ir_live_set: fn(b: ^IRBuilder, live: Int, state: IROwnState) Never! {
    if state.owned && state.live >= 0 -> ir_emit(b.f, IROp.Copy, live, state.live, -1, -1, b.line) else {
        ir_emit(b.f, IROp.Const, live, if state.owned -> 1 else -> 0, -1, -1, b.line)
    }
}

// The storage at `address` now holds the bytes of the aggregate `value`
// and owns them: a fresh value or a variable's own value moves there (the
// variable stops owning it); so does a variable's aggregate with no clone,
// which sema reads as a move (ir_own), or the copy would share a box and
// its handles with the variable, whose scope-end drop alone would end them
// after the new holder wrote or closed its copy. Any other holder's value is
// shared, its buffers gaining an owner (ir_copy_fixup).
ir_aggregate_take: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, value: Int, address: Int) Never! {
    if b.fresh[value] {
        b.fresh[value] = false
        return
    }
    row: b.f.slot_type[value]
    if ir_movable_binding(b, value) || (ir_owned_binding(b, value) && ir_row_lacks_clone(m, p, row)) {
        return ir_disown(b, value)
    }
    ir_copy_fixup(m, p, b, row, address)
}

// The most instructions one function's build may emit. A build that passes
// it fails like any unsupported construct (its function is not built and
// the census records it) instead of growing until the process dies.
IR_BUILD_INSTRUCTION_BUDGET: 1000000

ir_new_slot: fn(b: ^IRBuilder, ty: Int, kind: IRSlotKind, name: Int) -> Int Never! {
    emitted: b.f.op.len()
    if emitted > IR_BUILD_INSTRUCTION_BUDGET {
        ir_fail(b, Span{start: 0, end: 0}, "budget exceeded: {emitted} instructions (budget {IR_BUILD_INSTRUCTION_BUDGET})")
    }
    b.fresh.push(false)
    ir_slot(b.f, ty, kind, name, b.line)
}

ir_temp: fn(m: ^IRModule, b: ^IRBuilder, ty: Int) -> Int Never! {
    ir_new_slot(b, ty, IRSlotKind.Temp, -1)
}

ir_fresh_temp: fn(m: ^IRModule, b: ^IRBuilder, ty: Int) -> Int Never! {
    slot: ir_temp(m, b, ty)
    b.fresh[slot] = true
    slot
}

// A temporary of `slot`'s type.
ir_temp_like: fn(m: ^IRModule, b: ^IRBuilder, slot: Int) -> Int Never! {
    ty: b.f.slot_type[slot]
    ir_temp(m, b, ty)
}

ir_fresh_like: fn(m: ^IRModule, b: ^IRBuilder, slot: Int) -> Int Never! {
    ty: b.f.slot_type[slot]
    ir_fresh_temp(m, b, ty)
}

ir_kind_of: fn(m: IRModule, b: IRBuilder, slot: Int) -> IRTypeKind Never! {
    m.types[b.f.slot_type[slot]].kind
}

ir_has_drop: fn(m: IRModule, b: IRBuilder, slot: Int) -> Bool Never! {
    m.types[b.f.slot_type[slot]].drop != ""
}

// Drops `slot` when it is a fresh temporary of a type with a drop.
ir_release: fn(m: ^IRModule, b: ^IRBuilder, slot: Int) Never! {
    if slot < 0 || !b.fresh[slot] {
        return
    }
    if ir_has_drop(m, b, slot) -> ir_emit(b.f, IROp.Drop, -1, slot, -1, -1, b.line)
    b.fresh[slot] = false
}

// After the call that wrote them, each write-back's slot reads its value back
// from its cell, and a temporary that was given the cell as its place ends.
ir_write_backs: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, backs: [IRWriteBack], span: Span) Never! {
    loop back in backs {
        if back.link_mode == IR_LINK_BACK_WRITE {
            ir_link_write_leave(m, b, back.cell)
            if back.ends && ir_has_drop(m, b, back.cell) {
                ir_emit(b.f, IROp.Drop, -1, back.cell, -1, -1, b.line)
            }
            next
        }
        if back.link_mode == IR_LINK_BACK_READ {
            ir_link_read_leave(m, b, back.cell)
            if back.ends && ir_has_drop(m, b, back.cell) {
                ir_emit(b.f, IROp.Drop, -1, back.cell, -1, -1, b.line)
            }
            next
        }
        ir_emit(b.f, IROp.Load, back.slot, back.cell, 0, -1, b.line)
        if back.ends {
            ir_close_temporary(m, p, b, back.slot, span)
            ir_release(m, b, back.slot)
        }
    }
}

// ---------------------------------------------------------------------------
// Names and scopes.

ir_scope_open: fn(b: ^IRBuilder) Never! { b.scopes.push(b.bindings.len()) }

// Closes the innermost scope: its owned variables are dropped, latest first.
ir_scope_close: fn(m: ^IRModule, b: ^IRBuilder) Never! {
    mark: b.scopes.pop() ?? 0
    ir_drop_bindings(m, b, mark)
    loop b.bindings.len() > mark -> _: b.bindings.pop()
}

ir_lookup_binding: fn(b: IRBuilder, name: String) -> IRBinding? Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        if b.bindings[index].name == name -> return Val(b.bindings[index].copy())
        index -= 1
    }
    None
}

// The binding a read of `local` names: the variable of its checked symbol
// when it has one (a default argument reads an earlier argument's pin
// under the parameter's name), else the latest of its name.
ir_lookup_local: fn(b: IRBuilder, local: TLocal) -> IRBinding? Never! {
    if local.symbol_id == .Val(symbol) {
        index := b.bindings.len() - 1
        loop index >= 0 {
            if b.bindings[index].symbol == symbol -> return Val(b.bindings[index].copy())
            index -= 1
        }
    }
    ir_lookup_binding(b, local.name)
}

// The value of a visible variable: a write parameter's is read through its address.
ir_read_binding: fn(m: ^IRModule, b: ^IRBuilder, binding: IRBinding) -> Int Never! {
    if binding.indirect < 0 -> return binding.slot
    value: ir_temp(m, b, binding.indirect)
    ir_emit(b.f, IROp.Load, value, binding.slot, 0, -1, b.line)
    value
}

// Writes `value` into `slot`: a move for a type with a drop, else a copy.
ir_store: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, slot: Int, value: Int) Never! {
    ir_close_disarm(b, value)
    if ir_kind_of(m, b, value) == .Aggregate && !b.fresh[value] {
        // An aggregate read from another place gets storage of its own.
        value_row: b.f.slot_type[value]
        size: m.types[value_row].size
        ir_emit(b.f, IROp.StackAddress, slot, size, m.types[value_row].align, -1, b.line)
        ir_emit(b.f, IROp.CopyBytes, -1, slot, value, size, b.line)
        ir_aggregate_take(m, p, b, value, slot)
        return
    }
    owned: ir_own(m, p, b, value)
    op: if ir_has_drop(m, b, owned) || ir_kind_of(m, b, owned) == .Aggregate -> IROp.Move else -> IROp.Copy
    ir_emit(b.f, op, slot, owned, -1, -1, b.line)
    b.fresh[owned] = false
}

// `Br` out of the Block `exit` unless `test` holds.
ir_exit_unless: fn(m: ^IRModule, b: ^IRBuilder, test: Int, exit: Int) Never! {
    negated: ir_temp_like(m, b, test)
    ir_emit(b.f, IROp.Not, negated, test, -1, -1, b.line)
    depth: ir_depth(b.f, exit)
    ir_emit(b.f, IROp.BrIf, -1, negated, depth, -1, b.line)
}

ir_fail_slot: fn(b: ^IRBuilder, span: Span, message: String) -> Int Never! {
    ir_fail(b, span, message)
    return -1
}

ir_type_fail: fn(b: ^IRBuilder, span: Span, ty: Type) -> Int Never! {
    ir_fail_slot(b, span, "type {ir_type_name(ty)}")
}

// A runtime route call with a fresh result of type row `ty` (-1: none).
// A route that can deliver a runtime stop is followed by its stop check.
ir_runtime: fn(m: ^IRModule, b: ^IRBuilder, symbol: String, args: [Int], ty: Int) -> Int Never! {
    dst: if ty >= 0 -> ir_fresh_temp(m, b, ty) else -> -1
    start: ir_args(b.f, args)
    ir_emit(b.f, IROp.CallRuntime, dst, ir_intern_name(m, symbol), start, args.len(), b.line)
    if ir_route_can_stop(m, symbol) -> ir_stop_check(m, b)
    dst
}

// Stop points (Docs/Research/jet-backend-design-2026-10-01.md "Stop
// points"). A runtime stop (a panic, a trap, process.exit, a delivered
// cancellation) is published on the thread's task control, and the call
// that published it returns; nothing unwinds through generated frames.
// Each call that can deliver one is followed by a check: stopped, the
// function leaves by its stop edge, which runs the cleanup a return would
// (closes, drops, guards, open transactions) with the stop masked, then
// returns with no result written. Every frame up to the boundary that
// takes the stop (jet_rt_main's root, a task's runner) cleans up in turn.

// Whether runtime route `symbol` can deliver a stop: every route but those
// the runtime's stops receipt proves never publish one (IRModule.quiet_routes,
// BuildLibrary.jet ir_stop_exports), so without a receipt, and for a Core
// export or any symbol the runtime does not export, every call polls.
ir_route_can_stop: fn(m: IRModule, symbol: String) -> Bool Never! {
    if symbol == "" -> return true
    if m.quiet_exports.len() > 0 {
        bytes: symbol.bytes()
        return !ir_sorted_lines_contains(m.quiet_exports, bytes) || ir_sorted_lines_contains(m.quiet_stops, bytes)
    }
    name_find(m.quiet_routes, symbol) == None
}

// Whether `row` is a line in newline-separated sorted `bytes` (zero-alloc
// binary search over byte slices).
ir_sorted_lines_contains: fn(bytes: [U8], row: [U8]) -> Bool Never! {
    low := 0
    high := bytes.len()
    loop low < high {
        start := low + (high - low).div_euclid(2)
        loop start > low && bytes[start - 1] != (U8{10}) -> start -= 1
        end := start
        loop end < high && bytes[end] != (U8{10}) -> end += 1
        at := 0
        order := 0
        loop start + at < end && at < row.len() {
            if bytes[start + at] != row[at] {
                order = if bytes[start + at] < row[at] -> -1 else -> 1
                break
            }
            at += 1
        }
        if order == 0 {
            order = if {
                start + at < end -> 1
                at < row.len() -> -1
                else -> 0
            }
        }
        if order == 0 -> return true
        if order < 0 -> low = end + 1 else -> high = start
    }
    false
}

// After a call that can deliver a stop: the poll (IR_STOP_POLL_KEY) returns
// whether a stop was delivered (jet_rt_session_propagate when the thread's
// task control holds one, which is zero while a cleanup or shield masks it,
// or when the task is under a strong pause), and true takes the stop edge.
// The edge's own cleanup has none. The selector keeps the call and a branch
// hot and lays the edge out cold (X64Select ir_x64_stop_point).
ir_stop_check: fn(m: ^IRModule, b: ^IRBuilder) Never! {
    if !m.stop_points || b.stopping {
        return
    }
    ir_stop_point(m, b, IR_STOP_POLL_KEY)
}

// The check every user loop's iteration starts with: a turn poll
// (IR_STOP_TURN_KEY) whether or not the body calls anything, so a task
// paused with `pause(mode: .CheckLoops)` stops at its next iteration, and a
// cancel of it or its passed deadline is delivered there (JetRuntime
// Scheduler.jet scheduler_check_loops, jet_rt_session_turn). At the start
// of the body rather than at its back branch, so an iteration a `next` ends
// early is checked too. Every loop form that lowers to a Loop (BuildExpr.jet,
// BuildLazy.jet) emits it right after pushing its IRLoopFrame. The passes
// treat it as any other poll that checks no call, except that a poll it
// folds into becomes a turn poll (OptStops.jet ir_opt_fold_polls); the
// branch back to the head keeps one per iteration. On x86-64 and the web
// target, a check that follows no call reads only the runtime's armed word
// before it calls the poll, and on x86-64 the poll keeps every register but
// rax (X64Select.jet ir_x64_stop_point, ir_x64_stop_poll; JetWeb Select.jet
// web_stop_point).
ir_loop_check: fn(m: ^IRModule, b: ^IRBuilder) Never! {
    if !m.stop_points || b.stopping {
        return
    }
    ir_stop_point(m, b, IR_STOP_TURN_KEY)
}

// The check a body starts with, before its first statement: the turn poll
// ir_loop_check puts at each iteration, its index kept in the function
// (IRFunction.entry_check). A recursion that runs no loop meets it at each
// entry, so a cancel of a task busy in one, or its passed deadline, is
// delivered there as it is at a loop's turn. ir_recursion_checks removes
// it from every body that is not recursive once the module is built.
ir_entry_check: fn(m: ^IRModule, b: ^IRBuilder) Never! {
    if !m.stop_points || b.stopping {
        return
    }
    b.f.entry_check = b.f.op.len()
    ir_stop_point(m, b, IR_STOP_TURN_KEY)
}

// Keeps the entry checks (ir_entry_check) of the bodies that can call
// themselves only: a body on a cycle of calls (Opt.jet ir_opt_bottom_up).
// A call through a function value (CallIndirect) counts as a call of every
// function whose address the module takes (FunctionAddress), through one
// extra node after the functions. Every other body's entry check goes
// before any pass reads the module, and every body's index is reset. In a
// module with stop points (whose bodies run on threads the runtime attached)
// the same cycles mark the bodies that start with the stack check
// (IRFunction.stack_check): only the bodies on a cycle, so a leaf, a body
// that only calls the runtime, and one that calls through a function value
// whose callees never call back take none. Every function value's callee
// is taken here: closures, adapters, release helpers and runners all store
// a FunctionAddress, and static data holds no function's address. Each
// body's calls and, once the cycles are known, its removal read only its
// own instructions, so the functions split into consecutive parts
// (compiler_threads_partition by size), at most `workers` of at least
// IR_OPT_MIN_INSTRUCTIONS_PER_THREAD instructions each.
ir_recursion_checks: fn(m: ^IRModule, workers: Int) Never! {
    total := 0
    loop f in m.functions -> total += 1 + f.op.len()
    admitted := if workers < 1 -> 1 else -> workers
    loop admitted > 1 && admitted * IR_OPT_MIN_INSTRUCTIONS_PER_THREAD > total -> admitted -= 1
    ir_recursion_checks_parted(m, admitted)
}

// ir_recursion_checks on `workers` parts: the calls of each part on a thread
// of its own (reading `m.functions` in place without moving it), the cycles
// on this one over every part's calls in function order, then the removals
// on the parts' threads (or in place when single-threaded or no entry checks).
ir_recursion_checks_parted: fn(m: ^IRModule, workers: Int) Never! {
    count: m.functions.len()
    checked := false
    weights := [Int]{}
    weights.try_reserve(count) ?? ()
    loop f in m.functions {
        if f.entry_check >= 0 -> checked = true
        weights.push(1 + f.op.len())
    }
    if !checked && !m.stop_points {
        return
    }
    calls := OptCalls{start: [Int]{}, to: [Int]{}}
    calls.start.try_reserve(count + 2) ?? ()
    taken := [Int]{}
    bounds := [Int]{}
    if workers <= 1 {
        loop row in 0..<count {
            calls.start.push(calls.to.len())
            ir_recursion_calls(m.functions[row], count, calls.to, taken)
        }
    } else {
        bounds = compiler_threads_partition(weights, workers)
        scans := ir_recursion_scan_ranges(m.functions, bounds, count, 0)
        total_to := 0
        loop at in 0..<scans.len() -> total_to += scans[at].calls.len()
        calls.to.try_reserve(total_to) ?? ()
        loop at in 0..<scans.len() {
            base: calls.to.len()
            from := 0
            loop end in scans[at].ends {
                calls.start.push(base + from)
                from = end
            }
            compiler_transfer_rows<Int>(calls.to, scans[at].calls)
            compiler_transfer_rows<Int>(taken, scans[at].taken)
        }
    }
    calls.start.push(calls.to.len())
    compiler_transfer_rows<Int>(calls.to, taken)
    calls.start.push(calls.to.len())
    order: ir_opt_bottom_up(calls)
    if workers <= 1 || !checked {
        loop id in 0..<count {
            ir_recursion_entry(m.functions[id], order.recursive, id, m.stop_points)
        }
        return
    }
    // Parts leave the list last-first: part `workers - 1` pops first.
    parts := [IRRecursionPart]{}
    part := workers - 1
    loop part >= 0 {
        rows := [IRFunction]{}
        loop m.functions.len() > bounds[part] {
            row: m.functions.pop() ?? break
            rows.push(row)
        }
        rows.reverse()
        parts.push(IRRecursionPart{functions: rows.move(), start: bounds[part], stacks: m.stop_points, calls: [Int]{}, ends: [Int]{}, taken: [Int]{}})
        part -= 1
    }
    parts.reverse()
    parts = ir_recursion_walks(count, order.recursive, parts.move())
    loop at in 0..<parts.len() {
        m.functions.extend(compiler_take_rows<IRFunction>(parts[at].functions))
    }
}

IRRecursionScan: struct {
    calls: [Int],
    ends: [Int],
    taken: [Int],
}

ir_recursion_scan_range: fn(functions: [IRFunction], start: Int, end: Int, count: Int) -> IRRecursionScan Never! {
    calls := [Int]{}
    ends := [Int]{}
    ends.try_reserve(end - start) ?? ()
    taken := [Int]{}
    loop row in start..<end {
        ir_recursion_calls(functions[row], count, calls, taken)
        ends.push(calls.len())
    }
    IRRecursionScan{calls: calls.move(), ends: ends.move(), taken: taken.move()}
}

ir_recursion_scan_ranges: fn(functions: [IRFunction], bounds: [Int], count: Int, at: Int) -> [IRRecursionScan] Never! {
    end: if at + 1 < bounds.len() -> bounds[at + 1] else -> count
    if at + 1 >= bounds.len() {
        return [IRRecursionScan]{ir_recursion_scan_range(functions, bounds[at], end, count)}
    }
    scans := [IRRecursionScan]{}
    task.group ir_recursion_scan_threads {
        head: task ir_recursion_scan_range(functions, bounds[at], end, count)
        rest: ir_recursion_scan_ranges(functions, bounds, count, at + 1)
        scans.push(compiler_threads_joined(head))
        loop item in rest -> scans.push(item)
    }
    scans
}

// One thread's functions of ir_recursion_checks, in order, from function
// `start`, and whether they take stack checks (the module's stop points):
// per function the functions it calls (calls[ends[row - 1]..<ends[row]],
// from 0 for the first; the module's function count stands for a call
// through a function value), and the functions whose address any of them
// takes.
IRRecursionPart: struct {
    functions: [IRFunction],
    start: Int,
    stacks: Bool,
    calls: [Int],
    ends: [Int],
    taken: [Int],
}

// Walks `parts` (ir_recursion_part), in part order: the last part on its
// own thread, the ones before it the same way, and the first on this one.
ir_recursion_walks: fn(count: Int, recursive: [Bool], parts: ^^[IRRecursionPart]) -> [IRRecursionPart] Never! {
    rest := parts.move()
    last: rest.pop() ?? return rest
    if rest.len() == 0 {
        rest.push(ir_recursion_part(count, recursive, last.move()))
        return rest
    }
    done := [IRRecursionPart]{}
    task.group ir_recursion_threads {
        head: task ir_recursion_part(count, recursive, last.move())
        done = ir_recursion_walks(count, recursive, rest.move())
        done.push(compiler_threads_joined(head))
    }
    done
}

// One part's walk: its functions' calls while `recursive` is empty, else
// their stack checks and the removal of their entry checks.
ir_recursion_part: fn(count: Int, recursive: [Bool], part: ^^IRRecursionPart) -> IRRecursionPart Never! {
    walked := part.move()
    start: walked.start
    scanning: recursive.len() == 0
    loop row in 0..<walked.functions.len() {
        if scanning {
            ir_recursion_calls(walked.functions[row], count, walked.calls, walked.taken)
            walked.ends.push(walked.calls.len())
            next
        }
        ir_recursion_entry(walked.functions[row], recursive, start + row, walked.stacks)
    }
    walked
}

// Appends the functions `f` calls to `calls` (`count` once for its calls
// through a function value) and those whose address it takes to `taken`.
ir_recursion_calls: fn(f: IRFunction, count: Int, calls: ^[Int], taken: ^[Int]) Never! {
    indirect := false
    loop at in 0..<f.op.len() {
        op: f.op[at]
        callee: f.a[at]
        if op == .CallIndirect -> indirect = true
        if (op == .Call || op == .FunctionAddress) && callee >= 0 && callee < count {
            if op == .Call -> calls.push(callee) else -> taken.push(callee)
        }
    }
    if indirect -> calls.push(count)
}

// Marks the stack check of `f`, function `id`, when `stacks` holds and
// `recursive` marks it; resets its entry check index and removes that
// check unless `recursive` marks it, with the slots only the check used
// (ir_recursion_drop_slots).
ir_recursion_entry: fn(f: ^IRFunction, recursive: [Bool], id: Int, stacks: Bool) Never! {
    if stacks -> f.stack_check = recursive[id]
    at: f.entry_check
    if at < 0 {
        return
    }
    f.entry_check = -1
    if recursive[id] {
        return
    }
    end: f.c[at + 1]
    written := [Int]{}
    loop k in at..<(end + 1) {
        row: IR_LINT_OPS[ir_op_code(f.op[k])]
        if ir_role_is_slot(row.dst) && f.dst[k] >= 0 -> written.push(f.dst[k])
        ir_opt_kill(f, k)
    }
    ir_opt_compact(f)
    ir_recursion_drop_slots(f, written)
}

// Whether an instruction field of `role` (IR_LINT_OPS) holds a slot.
ir_role_is_slot: fn(role: IRLintRole) -> Bool Never! { role == .Slot || role == .SlotOrNone }

// After ir_recursion_entry removes a body's entry check: each slot of
// `written` (what the removed instructions wrote: the poll's result, the
// stop edge's temporaries) that is no parameter and that nothing left reads
// or writes goes, and every later slot moves down over it, so the body
// holds and numbers its slots as if the check had never been built.
ir_recursion_drop_slots: fn(f: ^IRFunction, written: [Int]) Never! {
    count: f.slot_type.len()
    dropped := [Bool]{}
    dropped.try_reserve(count) ?? ()
    loop _ in 0..<count -> dropped.push(false)
    any := false
    min_w := count
    max_w := -1
    loop slot in written {
        if slot >= f.param_count && slot < count {
            dropped[slot] = true
            any = true
            if slot < min_w -> min_w = slot
            if slot > max_w -> max_w = slot
        }
    }
    if !any {
        return
    }
    inst_count: f.op.len()
    loop at in 0..<inst_count {
        op: f.op[at]
        d: f.dst[at]
        a: f.a[at]
        b: f.b[at]
        c: f.c[at]
        if op == .Call || op == .CallRuntime || op == .CallIndirect {
            if d >= min_w && d <= max_w -> dropped[d] = false
            if op == .CallIndirect && a >= min_w && a <= max_w -> dropped[a] = false
            loop k in b..<(b + c) {
                arg: f.args[k]
                if arg >= min_w && arg <= max_w -> dropped[arg] = false
            }
            next
        }
        if (d < min_w || d > max_w) && (a < min_w || a > max_w) && (b < min_w || b > max_w) && (c < min_w || c > max_w) {
            next
        }
        if op == {
            .Nop | .Block | .Loop | .Else | .End | .Br | .Unreachable -> {}
            .Const | .ConstText | .ConstBigInt | .FunctionAddress | .DataAddress | .StackAddress -> {
                if d >= min_w && d <= max_w -> dropped[d] = false
            }
            .Copy | .Move | .Neg | .Not | .Convert | .Load | .Offset | .Sqrt | .IntBig -> {
                if d >= min_w && d <= max_w -> dropped[d] = false
                if a >= min_w && a <= max_w -> dropped[a] = false
            }
            .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Concat -> {
                if d >= min_w && d <= max_w -> dropped[d] = false
                if a >= min_w && a <= max_w -> dropped[a] = false
                if b >= min_w && b <= max_w -> dropped[b] = false
            }
            .Drop | .Close | .If | .BrIf | .Return -> {
                if a >= min_w && a <= max_w -> dropped[a] = false
            }
            .CopyBytes -> {
                if a >= min_w && a <= max_w -> dropped[a] = false
                if b >= min_w && b <= max_w -> dropped[b] = false
            }
            .Store | .StreamStore -> {
                if a >= min_w && a <= max_w -> dropped[a] = false
                if c >= min_w && c <= max_w -> dropped[c] = false
            }
            .Call | .CallRuntime | .CallIndirect -> {}
        }
    }
    loop slot in f.splits {
        if slot >= min_w && slot <= max_w -> dropped[slot] = false
    }
    loop slot in f.binds {
        if slot >= min_w && slot <= max_w -> dropped[slot] = false
    }
    loop slot in f.scattered {
        if slot >= min_w && slot <= max_w -> dropped[slot] = false
    }
    renamed := [Int]{}
    renamed.try_reserve(count) ?? ()
    kept := 0
    loop slot in 0..<count {
        if dropped[slot] {
            renamed.push(-1)
            next
        }
        renamed.push(kept)
        kept += 1
    }
    if kept == count {
        return
    }
    loop at in 0..<inst_count {
        op: f.op[at]
        if op == {
            .Nop | .Block | .Loop | .Else | .End | .Br | .Unreachable -> {}
            .Const | .ConstText | .ConstBigInt | .FunctionAddress | .DataAddress | .StackAddress -> {
                d: f.dst[at]
                if d >= min_w -> f.dst[at] = renamed[d]
            }
            .Call | .CallRuntime -> {
                d: f.dst[at]
                if d >= min_w -> f.dst[at] = renamed[d]
            }
            .CallIndirect -> {
                d: f.dst[at]
                if d >= min_w -> f.dst[at] = renamed[d]
                a: f.a[at]
                if a >= min_w -> f.a[at] = renamed[a]
            }
            .Copy | .Move | .Neg | .Not | .Convert | .Load | .Offset | .Sqrt | .IntBig -> {
                d: f.dst[at]
                if d >= min_w -> f.dst[at] = renamed[d]
                a: f.a[at]
                if a >= min_w -> f.a[at] = renamed[a]
            }
            .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Concat -> {
                d: f.dst[at]
                if d >= min_w -> f.dst[at] = renamed[d]
                a: f.a[at]
                if a >= min_w -> f.a[at] = renamed[a]
                b: f.b[at]
                if b >= min_w -> f.b[at] = renamed[b]
            }
            .Drop | .Close | .If | .BrIf | .Return -> {
                a: f.a[at]
                if a >= min_w -> f.a[at] = renamed[a]
            }
            .CopyBytes -> {
                a: f.a[at]
                if a >= min_w -> f.a[at] = renamed[a]
                b: f.b[at]
                if b >= min_w -> f.b[at] = renamed[b]
            }
            .Store | .StreamStore -> {
                a: f.a[at]
                if a >= min_w -> f.a[at] = renamed[a]
                c: f.c[at]
                if c >= min_w -> f.c[at] = renamed[c]
            }
        }
    }
    loop k in 0..<f.args.len() {
        arg: f.args[k]
        if arg >= min_w -> f.args[k] = renamed[arg]
    }
    loop k in 0..<f.splits.len() {
        s: f.splits[k]
        if s >= min_w -> f.splits[k] = renamed[s]
    }
    loop k in 0..<f.binds.len() {
        s: f.binds[k]
        if s >= min_w -> f.binds[k] = renamed[s]
    }
    loop k in 0..<f.scattered.len() {
        s: f.scattered[k]
        if s >= min_w -> f.scattered[k] = renamed[s]
    }
    write := 0
    loop slot in 0..<count {
        if dropped[slot] -> next
        if write != slot {
            f.slot_type[write] = f.slot_type[slot]
            f.slot_kind[write] = f.slot_kind[slot]
            f.slot_name[write] = f.slot_name[slot]
            f.slot_line[write] = f.slot_line[slot]
            f.slot_fixed[write] = f.slot_fixed[slot]
            f.slot_site[write] = f.slot_site[slot]
            f.slot_formal[write] = f.slot_formal[slot]
        }
        write += 1
    }
    loop f.slot_type.len() > kept {
        _ := f.slot_type.pop()
        _ := f.slot_kind.pop()
        _ := f.slot_name.pop()
        _ := f.slot_line.pop()
        _ := f.slot_fixed.pop()
        _ := f.slot_site.pop()
        _ := f.slot_formal.pop()
    }
}

// Clears the drop of the slot a field of `role` holds.
ir_slot_kept: fn(dropped: ^[Bool], role: IRLintRole, value: Int) Never! {
    if ir_role_is_slot(role) && value >= 0 && value < dropped.len() -> dropped[value] = false
}

// A field of `role` holding `value`, with its slot renamed.
ir_slot_renamed: fn(renamed: [Int], role: IRLintRole, value: Int) -> Int Never! {
    if !ir_role_is_slot(role) || value < 0 || value >= renamed.len() -> return value
    renamed[value]
}

// f0 calls itself; f1 calls f2, which calls through a function value and
// takes f1's address, so the two are a cycle; f3 calls f0; f4 is the poll.
// Each entry check is the poll's call, an If and its End. With stop points
// the bodies on a cycle take stack checks.
#Test("recursion checks keep the entry checks of recursive bodies only, on any number of parts") {
    loop stops in ([Bool]{false, true}) {
        loop workers in 1..<5 {
            m := ir_module_new()
            m.stop_points = stops
            loop id in 0..<5 {
                f := ir_function_new("f{id}", "test:recursion.jet.f{id}", "f{id}", "recursion.jet", 1)
                if id < 4 {
                    f.entry_check = ir_emit(f, IROp.Call, 0, 4, -1, 0, 1)
                    _: ir_emit(f, IROp.If, -1, 0, -1, 2, 1)
                    _: ir_emit(f, IROp.End, -1, 1, -1, -1, 1)
                }
                if id == {
                    0 | 3 -> { _: ir_emit(f, IROp.Call, -1, 0, -1, 0, 1) }
                    1 -> { _: ir_emit(f, IROp.Call, -1, 2, -1, 0, 1) }
                    2 -> {
                        _: ir_emit(f, IROp.FunctionAddress, 1, 1, -1, -1, 1)
                        _: ir_emit(f, IROp.CallIndirect, -1, 1, -1, 0, 1)
                    }
                    else -> {}
                }
                m.functions.push(f)
            }
            ir_recursion_checks_parted(m, workers)
            sizes: loop f in m.functions -> f.op.len()
            assert_eq(sizes, [Int]{4, 4, 5, 1, 0})
            loop f in m.functions -> assert_eq(f.entry_check, -1)
            assert_eq(m.functions[3].op[0], IROp.Call)
            assert_eq(m.functions[3].a[0], 0)
            checks: loop f in m.functions -> f.stack_check
            assert_eq(checks, [Bool]{stops, stops, stops, false, false})
        }
    }
}

// A removed entry check takes the slots only it used: f0's parameter is s0,
// the poll's result s1, the stop edge's temporary s2 and its body's sum s3;
// f1 is the poll. Without the check the sum is s1, reading the parameter.
// f2 calls itself, so it keeps its check and its slots.
#Test("a removed entry check leaves no slot of its own behind") {
    m := ir_module_new()
    loop id in 0..<3 {
        if id == 1 {
            m.functions.push(ir_function_new("f1", "test:slots.jet.f1", "f1", "slots.jet", 1))
            next
        }
        f := ir_function_new("f{id}", "test:slots.jet.f{id}", "f{id}", "slots.jet", 1)
        param: ir_slot(f, 0, IRSlotKind.Param, -1, 1)
        stopped: ir_slot(f, 0, IRSlotKind.Temp, -1, 2)
        status: ir_slot(f, 0, IRSlotKind.Temp, -1, 3)
        sum: ir_slot(f, 0, IRSlotKind.Temp, -1, 4)
        f.entry_check = ir_emit(f, IROp.Call, stopped, 1, -1, 0, 1)
        _: ir_emit(f, IROp.If, -1, stopped, -1, 4, 1)
        _: ir_emit(f, IROp.Const, status, -1, -1, -1, 1)
        _: ir_emit(f, IROp.Return, -1, status, -1, -1, 1)
        _: ir_emit(f, IROp.End, -1, 1, -1, -1, 1)
        _: ir_emit(f, IROp.Add, sum, param, param, 0, 1)
        if id == 2 -> _: ir_emit(f, IROp.Call, -1, 2, -1, 0, 1)
        _: ir_emit(f, IROp.Return, -1, sum, -1, -1, 1)
        m.functions.push(f)
    }
    ir_recursion_checks_parted(m, 1)
    plain: m.functions[0]
    assert_eq(plain.op.len(), 2)
    assert_eq(plain.op[0], IROp.Add)
    assert_eq(plain.dst[0], 1)
    assert_eq(plain.a[0], 0)
    assert_eq(plain.b[0], 0)
    assert_eq(plain.a[1], 1)
    assert_eq(plain.slot_line, [Int]{1, 4})
    assert_eq(plain.slot_kind.len(), 2)
    assert_eq(plain.slot_fixed.len(), 2)
    assert_eq(plain.slot_site.len(), 2)
    recursive: m.functions[2]
    assert_eq(recursive.op.len(), 8)
    assert_eq(recursive.slot_line, [Int]{1, 2, 3, 4})
    assert_eq(recursive.dst[5], 3)
}

// A body that calls through a function value takes no stack check when no
// callee whose address the module takes calls back into it: `apply` calls
// the value it takes from `leaf`, which calls nothing.
#Test("a call through a function value takes the stack check only on a cycle") {
    m := ir_module_new()
    m.stop_points = true
    caller := ir_function_new("apply", "test:apply.jet.apply", "apply", "apply.jet", 1)
    _: ir_emit(caller, IROp.FunctionAddress, 0, 1, -1, -1, 1)
    _: ir_emit(caller, IROp.CallIndirect, -1, 0, -1, 0, 1)
    m.functions.push(caller)
    m.functions.push(ir_function_new("leaf", "test:apply.jet.leaf", "leaf", "apply.jet", 1))
    ir_recursion_checks_parted(m, 1)
    assert(!m.functions[0].stack_check)
    assert(!m.functions[1].stack_check)
}

// After instruction `at`, a user operation whose slow path can publish a
// numeric stop: its stop edge, through the trap poll (IR_STOP_TRAP_KEY),
// which the selector enters only from that slow path, so the hot path has
// no poll.
ir_stop_trap: fn(m: ^IRModule, b: ^IRBuilder, at: Int) Never! {
    if !m.stop_points || b.stopping || !ir_op_can_stop(m, b.f, at) {
        return
    }
    ir_stop_point(m, b, IR_STOP_TRAP_KEY)
}

// Whether user operation `at` has a slow path that can publish a numeric
// stop (X64Select): an integer division (by zero), a fixed-width operation
// that traps on overflow or on a shift count out of range, an exact Int
// shift (a negative count).
ir_op_can_stop: fn(m: IRModule, f: IRFunction, at: Int) -> Bool Never! {
    op: f.op[at]
    kind: m.types[f.slot_type[f.a[at]]].kind
    trap: kind == .Word && f.c[at] != IR_OVERFLOW_WRAP
    if op == {
        .Div | .Rem | .FloorDiv | .Mod -> kind == .Int || kind == .Word
        .Shl | .Shr -> kind == .Int || trap
        .Add | .Sub | .Mul | .Neg -> trap
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .BitAnd | .BitOr | .BitXor | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> false
    }
}

// `stopped := poll(); if stopped { stop edge }`, with poll `key`. The edge
// runs the scope's deferred statements, which move the builder's line to
// theirs; the code after the stop point is still the statement's that
// raised it, so its line comes back (a bounds stop later in the statement
// names that statement's line and column).
ir_stop_point: fn(m: ^IRModule, b: ^IRBuilder, key: String) Never! {
    line: b.line
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    stopped: ir_temp(m, b, bool_row)
    poll: ir_stop_poll(m, key)
    start: ir_args(b.f, [Int]{})
    ir_emit(b.f, IROp.Call, stopped, poll, start, 0, line)
    ir_open_if(b.f, stopped, line)
    ir_stop_catches(m, b)
    ir_stop_return(m, b)
    b.line = line
    ir_end(b.f, line)
}

// In an `.expect_fail` region, a stop edge first offers the stop to each
// open region, innermost first (jet_rt_test_catch_for_scope): a caught stop
// drops the variables the region declared, under one runtime cleanup scope
// (the stop stays pending until the region's catch_boundary), and leaves the
// region.
ir_stop_catches: fn(m: ^IRModule, b: ^IRBuilder) Never! {
    if b.catches.len() == 0 {
        return
    }
    b.stopping = true
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    word_row: ir_word_row(m)
    index := b.catches.len() - 1
    loop index >= 0 {
        frame: b.catches[index]
        index -= 1
        if ir_tx_frames_hold_state(b.transactions, frame.transactions) {
            ir_fail(b, Span{start: 0, end: 0}, "an `.expect_fail` stop edge out of a #Transact block")
            break
        }
        caught: ir_runtime(m, b, "jet_rt_test_catch_for_scope", [Int]{frame.scope}, bool_row)
        ir_open_if(b.f, caught, b.line)
        ir_tx_leave_sentries(m, b, frame.transactions)
        saved: ir_runtime(m, b, "jet_rt_cleanup_enter", [Int]{}, word_row)
        states: ir_own_states(b, b.bindings.len())
        ir_drop_bindings(m, b, frame.mark)
        ir_set_own_states(b, states)
        _: ir_runtime(m, b, "jet_rt_cleanup_leave", [Int]{saved}, -1)
        depth: ir_depth(b.f, frame.exit)
        ir_emit(b.f, IROp.Br, -1, depth, -1, -1, b.line)
        ir_end(b.f, b.line)
    }
    b.stopping = false
}

// A stop poll: true when the thread's task control holds a stop and its
// routine (ir_stop_routine) delivers it. Its code is the selector's
// (X64Select ir_x64_stop_poll); the three keys' differ only in the routine.
// Built once per module, by key.
ir_stop_poll: fn(m: ^IRModule, key: String) -> Int Never! {
    found: ir_keyed_function(m, key) ?? -1
    if found >= 0 -> return found
    name: if {
        key == IR_STOP_TRAP_KEY -> "jet_ir_stop_trap"
        key == IR_STOP_TURN_KEY -> "jet_ir_stop_turn"
        else -> "jet_ir_stop_poll"
    }
    f := ir_function_new(name, key, name, "", 0)
    f.result = ir_type_row(m, Type.Bool) ?? 0
    // An asm leaf with no template: never inlined.
    f.asm = Val(IRAsmLeaf{code: [U8]{}, regs: [Int]{}, result: 0})
    id: m.functions.len()
    m.functions.push(f)
    ir_function_bind(m, key, id)
    id
}

// `name(cell)`, built into `m`: drops the value of the type row `ty`, which
// has a drop, held in `cell`: an aggregate's bytes are the cell, else its
// word. A debugger that calls a function in a stopped program calls this
// once it has read the result the function left in `cell`, so the
// references the result holds are given back.
ir_cell_drop: fn(m: ^IRModule, name: String, ty: Int) -> Int Never! {
    d := ir_function_new(name, name, name, "", 0)
    cell: ir_slot(d, ir_pointer_row(m), IRSlotKind.Param, ir_intern_name(m, "cell"), 0)
    value: ir_slot(d, ty, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(d, if m.types[ty].kind == .Aggregate -> IROp.Offset else -> IROp.Load, value, cell, 0, -1, 0)
    _ := ir_emit(d, IROp.Drop, -1, value, -1, -1, 0)
    _ := ir_emit(d, IROp.Return, -1, -1, -1, -1, 0)
    id: m.functions.len()
    ir_function_bind(m, name, id)
    m.functions.push(d)
    id
}

// The stack mark of a `#Context(allocator: a)` block (BuildTransact.jet
// ir_context_block): its caller's stack pointer, `lea rax, [rbp + 16]` in
// the leaf's own frame. The frames of the functions the block's code calls
// lie below it; the caller's frame and the older ones above. Its result
// register is the template's own, so it is never inlined, and it is built
// once per module.
ir_stack_mark: fn(m: ^IRModule) -> Int Never! {
    found: ir_keyed_function(m, IR_STACK_MARK_KEY) ?? -1
    if found >= 0 -> return found
    name: "jet_ir_stack_mark"
    f := ir_function_new(name, IR_STACK_MARK_KEY, name, "", 0)
    f.result = ir_word_row(m)
    f.asm = Val(IRAsmLeaf{code: [U8]{U8{72}, U8{141}, U8{69}, U8{16}}, regs: [Int]{}, result: -1})
    id: m.functions.len()
    m.functions.push(f)
    ir_function_bind(m, IR_STACK_MARK_KEY, id)
    id
}

// The stop edge: the cleanup of a return from here (each open
// transaction's snapshots restored, latest first, then its Stm and handle
// dropped, whose rollback hooks run, as ir_tx_unwind does; then every owned
// variable's close and drop), inside one runtime cleanup scope, then a
// return with no result written (no caller reads it: its own stop check
// comes first), or -1 from a stop_status body.
ir_stop_return: fn(m: ^IRModule, b: ^IRBuilder) Never! {
    if ir_stop_cleans(b) {
        b.stopping = true
        word_row: ir_word_row(m)
        saved: ir_runtime(m, b, "jet_rt_cleanup_enter", [Int]{}, word_row)
        states: ir_own_states(b, b.bindings.len())
        // A restore's own code must not unwind again.
        open: b.transactions
        b.transactions = [IRTxFrame]{}
        program: b.program.copy()
        index := open.len() - 1
        loop index >= 0 {
            frame: open[index]
            index -= 1
            if frame.snapshots.len() > 0 && program == .Val(p) {
                position := frame.snapshots.len() - 1
                loop position >= 0 {
                    ir_tx_restore(m, p, b, frame.snapshots[position], Span{start: 0, end: 0})
                    position -= 1
                }
            }
            // Cleared, as ir_tx_unwind does, so the binding drops below find
            // null: a second drop of the handle ran the rollback hooks again.
            if frame.stm >= 0 {
                ir_emit(b.f, IROp.Drop, -1, frame.stm, -1, -1, b.line)
                ir_emit(b.f, IROp.Const, frame.stm, 0, -1, -1, b.line)
            }
            if frame.handle >= 0 {
                ir_emit(b.f, IROp.Drop, -1, frame.handle, -1, -1, b.line)
                ir_emit(b.f, IROp.Const, frame.handle, 0, -1, -1, b.line)
            }
            ir_tx_leave_scopes(m, b, frame)
        }
        b.transactions = open
        ir_drop_bindings(m, b, 0)
        ir_set_own_states(b, states)
        _: ir_runtime(m, b, "jet_rt_cleanup_leave", [Int]{saved}, -1)
        b.stopping = false
    }
    if b.stop_status {
        stopped: ir_word_const(m, b, -1)
        ir_emit(b.f, IROp.Return, -1, stopped, -1, -1, b.line)
        return
    }
    ir_emit(b.f, IROp.Return, -1, -1, -1, -1, b.line)
}

// Whether a stop edge from here has cleanup to run.
ir_stop_cleans: fn(b: IRBuilder) -> Bool Never! {
    if b.transactions.len() > 0 || b.closes.len() > 0 -> return true
    loop binding in b.bindings {
        if binding.owned || binding.cleanup >= 0 -> return true
    }
    false
}

// The static text pair (data address, byte length) of `text`.
ir_static_text: fn(m: ^IRModule, b: ^IRBuilder, text: String) -> [Int] Never! {
    pointer_row: ir_pointer_row(m)
    pointer: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.DataAddress, pointer, ir_intern_text(m, text), -1, -1, b.line)
    word_row: ir_word_row(m)
    length: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Const, length, text.bytes().len(), -1, -1, b.line)
    [Int]{pointer, length}
}

ir_pointer_row: fn(m: ^IRModule) -> Int Never! {
    ir_intern_type(m, "pointer", ir_layout(IRTypeKind.Pointer, TYPE_ID_POINTER, 8, 8, IRClass.Pointer, false, 64, ""))
}

ir_word_row: fn(m: ^IRModule) -> Int Never! {
    ir_type_row(m, Type.IntN{signed: true, bits: 64}) ?? 0
}

// The row of the word or pointer a heap allocation answers, `row` (the word
// or pointer row), for storage serving values of type `ty` (a List's
// buffer, a Map's table, a wrapper): in a `--checked-alloc` build
// (IRModule.alloc_types) `row`'s layout over IR_ALLOC_TYPE of `ty`, so x86-64
// selection names `ty` at the call (X64Select.jet ir_x64_alloc_type); else
// `row` itself, so any other build's IR is unchanged. A box answers its box
// row, which names its type already.
ir_alloc_row: fn(m: ^IRModule, p: IRProgram, row: Int, ty: Type) -> Int Never! {
    ir_alloc_row_holding(m, p, row, ty, -1)
}

// ir_alloc_row of storage whose block holds values laid out as row `held`
// (-1: bytes of no known layout), which the call's DWARF type points at
// (IRModule.alloc_held).
ir_alloc_row_holding: fn(m: ^IRModule, p: IRProgram, row: Int, ty: Type, held: Int) -> Int Never! {
    if !m.alloc_types -> return row
    layout := m.types[row].copy()
    layout.ty = ir_intern_tid(m, p, Type.Apply{name: IR_ALLOC_TYPE, args: [Type]{ir_untag(ty)}})
    interned: ir_intern_type(m, "{IR_ALLOC_TYPE}:{type_carrier_identity(ty)}", layout)
    if held >= 0 && m.alloc_held.get(interned) == None -> m.alloc_held[interned] = held
    interned
}

// ir_alloc_row for storage serving values of type row `served` (-1: none,
// `row` itself): a List's block holds its elements, a struct's or tuple's
// its members.
ir_alloc_row_of: fn(m: ^IRModule, p: IRProgram, row: Int, served: Int) -> Int Never! {
    if !m.alloc_types || served < 0 -> return row
    ty: ir_row_ty(m, p, served)
    held: if {
        m.list_elements.get(served) != None -> m.list_elements.get(served) ?? -1
        m.debug_members.get(served) != None -> served
        else -> -1
    }
    ir_alloc_row_holding(m, p, row, ty, held)
}

// The row of the word a List buffer of element row `element` answers
// (ir_alloc_row of the List type; -1: an untyped buffer, the word row).
ir_list_alloc_row: fn(m: ^IRModule, p: IRProgram, element: Int) -> Int Never! {
    word_row: ir_word_row(m)
    if !m.alloc_types || element < 0 -> return word_row
    list: Type.List{element: ir_row_ty(m, p, element)}
    ir_alloc_row_holding(m, p, word_row, list, element)
}

// What allocation word `row` serves (ir_alloc_row): the type's Jet spelling
// and the row its block holds values laid out as (-1: none known).
IRAllocServed: struct {
    name: String,
    held: Int,
}

// None for a row that is no allocation word. Read once the module's types
// are in its own interner (a merged or standalone module).
ir_alloc_served: fn(m: IRModule, row: Int) -> IRAllocServed? Never! {
    if ir_module_row_ty(m, row) == .Apply(name, args) {
        if name == IR_ALLOC_TYPE && args.len() == 1 {
            return Val(IRAllocServed{name: ir_type_name(args[0]), held: m.alloc_held.get(row) ?? -1})
        }
    }
    None
}

// Only a `--checked-alloc` module's allocation words name what they serve,
// each laid out as the plain row it stands for.
#Test("an allocation word names the type its storage serves only in a checked-alloc module") {
    m := ir_module_new()
    p: ir_program_standalone()
    word: ir_word_row(m)
    pointer: ir_pointer_row(m)
    assert(ir_list_alloc_row(m, p, word) == word)
    assert(ir_alloc_row_of(m, p, pointer, word) == pointer)
    m.alloc_types = true
    buffer: ir_list_alloc_row(m, p, word)
    assert(buffer != word && ir_list_alloc_row(m, p, word) == buffer)
    assert(m.types[buffer].kind == m.types[word].kind && m.types[buffer].size == 8 && m.types[buffer].bits == m.types[word].bits)
    served := ""
    if ir_module_row_ty(m, buffer) == .Apply(name, args) && args.len() == 1 && args[0] == .List(element) {
        served = "{name} {ir_type_name(element)}"
    }
    assert(served == ("{IR_ALLOC_TYPE} I64"))
    assert((m.alloc_held.get(buffer) ?? -1) == word)
    held: ir_alloc_served(m, buffer) ?? IRAllocServed{name: "", held: -1}
    assert(held.name == "[I64]" && held.held == word && ir_alloc_served(m, word) == None)
    wrapper: ir_alloc_row_of(m, p, pointer, word)
    assert(wrapper != pointer && wrapper != buffer && m.types[wrapper].kind == .Pointer)
    assert(ir_alloc_row_of(m, p, pointer, -1) == pointer && ir_list_alloc_row(m, p, -1) == word)
}

ir_string_row: fn(m: ^IRModule) -> Int Never! { ir_type_row(m, Type.String) ?? 0 }

// A source location argument triple: (path address, path length, line).
ir_location: fn(m: ^IRModule, b: ^IRBuilder, line: Int) -> [Int] Never! {
    path: b.f.source_file
    args := ir_static_text(m, b, path)
    word_row: ir_word_row(m)
    slot: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Const, slot, line, -1, -1, b.line)
    args.push(slot)
    args
}

// A member of the aggregate at `base`: a nested aggregate is its address,
// a scalar a load (not owned: the aggregate keeps it); a recursive edge is
// read through its wrapper box.
ir_member_read: fn(m: ^IRModule, b: ^IRBuilder, base: Int, member: IRMember) -> Int Never! {
    holder := base
    offset := member.offset
    if member.boxed {
        pointer_row: ir_pointer_row(m)
        holder = ir_temp(m, b, pointer_row)
        ir_emit(b.f, IROp.Load, holder, base, member.offset, -1, b.line)
        offset = 0
    }
    slot: ir_temp(m, b, member.ty)
    if m.types[member.ty].kind == .Aggregate {
        ir_emit(b.f, IROp.Offset, slot, holder, offset, -1, b.line)
    } else { ir_emit(b.f, IROp.Load, slot, holder, offset, -1, b.line) }
    slot
}

// Writes `value` into the member of the aggregate at `base`; a recursive
// edge gets a wrapper box of its own (ir_wrapper_alloc: `place` -1 for an
// aggregate being built, else the address of the storage holding it). A
// variable's value moved in here is no longer closed by its scope: the
// aggregate closes it.
ir_member_write: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, base: Int, member: IRMember, value: Int, place: Int) Never! {
    ir_close_disarm(b, value)
    holder := base
    offset := member.offset
    if member.boxed {
        size: m.types[member.ty].size
        holder = ir_wrapper_alloc(m, p, b, if size < 8 -> 8 else -> size, place, member.ty)
        ir_emit(b.f, IROp.Store, -1, base, member.offset, holder, b.line)
        offset = 0
    }
    if m.types[member.ty].kind == .Aggregate {
        address: ir_temp(m, b, member.ty)
        ir_emit(b.f, IROp.Offset, address, holder, offset, -1, b.line)
        ir_emit(b.f, IROp.CopyBytes, -1, address, value, m.types[member.ty].size, b.line)
        ir_aggregate_take(m, p, b, value, address)
        return
    }
    owned: ir_own(m, p, b, value)
    ir_emit(b.f, IROp.Store, -1, holder, offset, owned, b.line)
    b.fresh[owned] = false
}

// The member `name` of the struct an aggregate slot holds.
ir_member_of: fn(m: ^IRModule, p: IRProgram, b: IRBuilder, base: Int, name: String) -> IRMember? Never! {
    ir_member_of_row(m, p, b.f.slot_type[base], name)
}

// The member `name` of the struct (or tuple) of type row `row`.
ir_member_of_row: fn(m: ^IRModule, p: IRProgram, row: Int, name: String) -> IRMember? Never! {
    ty: ir_untag(ir_row_ty(m, p, row))
    members := [IRMember]{}
    if ty == .Tuple(fields) -> members = ir_tuple_members(m, p, fields) ?? return None else {
        nominal: ir_nominal_name(ty) ?? return None
        definition: ir_type_def(p, nominal) ?? return None
        members = ir_struct_members(m, p, definition, ir_type_args(ty)) ?? return None
    }
    loop member in members {
        if member.name == name -> return Val(member)
    }
    None
}

ir_truncate_bindings: fn(b: ^IRBuilder, mark: Int) Never! {
    loop b.bindings.len() > mark -> _: b.bindings.pop()
}

// A Bool slot: whether the Result box `value` holds Ok (selector word 1).
ir_result_is_ok: fn(m: ^IRModule, b: ^IRBuilder, value: Int) -> Int Never! {
    word: ir_word_row(m)
    selector: ir_temp(m, b, word)
    ir_emit(b.f, IROp.Load, selector, value, 0, -1, b.line)
    one: ir_temp(m, b, word)
    ir_emit(b.f, IROp.Const, one, 1, -1, -1, b.line)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    test: ir_temp(m, b, bool_row)
    ir_emit(b.f, IROp.Eq, test, selector, one, -1, b.line)
    test
}

// The discriminant of an enum value: a payload-free enum is its variant
// index, a payload enum's box holds it at 0.
ir_enum_tag_of: fn(m: ^IRModule, b: ^IRBuilder, value: Int) -> Int Never! {
    if m.types[b.f.slot_type[value]].kind != .Pointer -> return value
    ir_load_word(m, b, value, 0)
}

// Writes `value` into member `member` of the storage at `base`; a recursive
// edge gets a wrapper box of its own.
ir_member_store: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, base: Int, member: IRMember, value: Int) Never! {
    if !member.boxed -> return ir_store_at(m, p, b, base, member.offset, value)
    size: m.types[member.ty].size
    wrapper: ir_wrapper_alloc(m, p, b, size, -1, member.ty)
    ir_store_at(m, p, b, wrapper, 0, value)
    ir_emit(b.f, IROp.Store, -1, base, member.offset, wrapper, b.line)
}

// The value of member `member` of the storage at `base` (through its
// wrapper box for a recursive edge; -1 for Unit).
ir_member_value: fn(m: ^IRModule, b: ^IRBuilder, base: Int, member: IRMember) -> Int Never! {
    if !member.boxed -> return ir_load_at(m, b, base, member.offset, member.ty)
    pointer_row: ir_pointer_row(m)
    wrapper: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.Load, wrapper, base, member.offset, -1, b.line)
    ir_load_at(m, b, wrapper, 0, member.ty)
}

ir_word_const: fn(m: ^IRModule, b: ^IRBuilder, value: Int) -> Int Never! {
    word_row: ir_word_row(m)
    slot: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Const, slot, value, -1, -1, b.line)
    slot
}

// A wrapping native word operation (addresses, counts, indexes).
ir_word_op: fn(m: ^IRModule, b: ^IRBuilder, op: IROp, left: Int, right: Int) -> Int Never! {
    word_row: ir_word_row(m)
    slot: ir_temp(m, b, word_row)
    ir_emit(b.f, op, slot, left, right, IR_OVERFLOW_WRAP, b.line)
    slot
}

ir_bool_op: fn(m: ^IRModule, b: ^IRBuilder, op: IROp, left: Int, right: Int) -> Int Never! {
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    slot: ir_temp(m, b, bool_row)
    ir_emit(b.f, op, slot, left, right, -1, b.line)
    slot
}

ir_load_word: fn(m: ^IRModule, b: ^IRBuilder, base: Int, offset: Int) -> Int Never! {
    word_row: ir_word_row(m)
    slot: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Load, slot, base, offset, -1, b.line)
    slot
}

// Storage of `size` bytes for a value of row `row`: a box of a box row in a
// program's module (IRModule.user_values) comes from the allocator a
// `#Context(allocator: a)` block serves values from (jet_rt_alloc_value,
// BuildMove.jet), any other from the heap (jet_rt_alloc(bytes, 8)).
ir_box_alloc: fn(m: ^IRModule, b: ^IRBuilder, size: Int, row: Int) -> Int Never! {
    bytes: ir_word_const(m, b, ir_align8(size))
    ir_box_alloc_sized(m, b, bytes, row)
}

// ir_box_alloc of the word-multiple byte count the word slot `bytes` holds.
ir_box_alloc_sized: fn(m: ^IRModule, b: ^IRBuilder, bytes: Int, row: Int) -> Int Never! {
    align: ir_word_const(m, b, 8)
    symbol: if m.user_values && ir_box_row(m, row) -> "jet_rt_alloc_value" else -> "jet_rt_alloc"
    boxed: ir_runtime(m, b, symbol, [Int]{bytes, align}, row)
    b.fresh[boxed] = m.types[row].drop != ""
    boxed
}

// A recursive edge's wrapper box of `size` bytes for a value of type row
// `served`: in a program's module from the allocator of the holder whose
// storage `place` addresses (jet_rt_alloc_value_grow; -1: a holder being
// built, whose allocator is the current one), else the heap.
ir_wrapper_alloc: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, size: Int, place: Int, served: Int) -> Int Never! {
    plain: ir_pointer_row(m)
    pointer_row: ir_alloc_row_of(m, p, plain, served)
    if !m.user_values -> return ir_box_alloc(m, b, size, pointer_row)
    bytes: ir_word_const(m, b, ir_align8(size))
    if place < 0 {
        align: ir_word_const(m, b, 8)
        return ir_runtime(m, b, "jet_rt_alloc_value", [Int]{bytes, align}, pointer_row)
    }
    none: ir_word_const(m, b, 0)
    ir_runtime(m, b, "jet_rt_alloc_value_grow", [Int]{bytes, none, place}, pointer_row)
}

// The copy of the box of box row `row`, or the wrapper (the pointer row),
// `old` of `size` bytes its holder makes its own: in a program's module from
// the allocator that served `old` (jet_rt_alloc_value_grow), the holder's or
// an older one, else the heap.
ir_box_replica: fn(m: ^IRModule, b: ^IRBuilder, size: Int, old: Int, row: Int) -> Int Never! {
    bytes: ir_word_const(m, b, ir_align8(size))
    ir_box_replica_sized(m, b, bytes, old, row)
}

// ir_box_replica of the word-multiple byte count the word slot `bytes`
// holds.
ir_box_replica_sized: fn(m: ^IRModule, b: ^IRBuilder, bytes: Int, old: Int, row: Int) -> Int Never! {
    if !m.user_values || (row != ir_pointer_row(m) && !ir_box_row(m, row)) {
        return ir_box_alloc_sized(m, b, bytes, row)
    }
    replica: ir_runtime(m, b, "jet_rt_alloc_value_grow", [Int]{bytes, old, old}, row)
    b.fresh[replica] = m.types[row].drop != ""
    replica
}

// A List buffer of exactly `bytes` bytes for elements of row `element` (-1:
// untyped), from where ir_box_alloc takes a box's in a program's module.
// Unlike a box it is not rounded up: every List buffer is released as
// capacity * stride (the List drop, ir_release_moved_buffer), and a free
// must name the allocation's own size.
ir_list_buffer_alloc: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, bytes: Int, element: Int) -> Int Never! {
    size: ir_word_const(m, b, bytes)
    ir_list_buffer_sized(m, p, b, size, element)
}

// ir_list_buffer_alloc of the byte count in slot `size`.
ir_list_buffer_sized: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, size: Int, element: Int) -> Int Never! {
    word_row: ir_list_alloc_row(m, p, element)
    align: ir_word_const(m, b, 8)
    ir_runtime(m, b, if m.user_values -> "jet_rt_alloc_value" else -> "jet_rt_alloc", [Int]{size, align}, word_row)
}

// Writes `value` at byte `offset` of the storage at `base`: an aggregate's
// bytes are copied, a Unit value takes no bytes.
ir_store_at: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, base: Int, offset: Int, value: Int) Never! {
    if value < 0 {
        return
    }
    kind: ir_kind_of(m, b, value)
    if kind == .Unit {
        return
    }
    ir_close_disarm(b, value)
    if kind == .Aggregate {
        address: ir_temp_like(m, b, value)
        ir_emit(b.f, IROp.Offset, address, base, offset, -1, b.line)
        value_row: b.f.slot_type[value]
        size: m.types[value_row].size
        ir_emit(b.f, IROp.CopyBytes, -1, address, value, size, b.line)
        ir_aggregate_take(m, p, b, value, address)
        return
    }
    owned: ir_own(m, p, b, value)
    ir_emit(b.f, IROp.Store, -1, base, offset, owned, b.line)
    b.fresh[owned] = false
}

// The value of type row `row` at byte `offset` of the storage at `base`
// (an aggregate is its address there; -1 for Unit).
ir_load_at: fn(m: ^IRModule, b: ^IRBuilder, base: Int, offset: Int, row: Int) -> Int Never! {
    kind: m.types[row].kind
    if kind == .Unit -> return -1
    slot: ir_temp(m, b, row)
    ir_emit(b.f, if kind == .Aggregate -> IROp.Offset else -> IROp.Load, slot, base, offset, -1, b.line)
    slot
}

// A new Result box of type `ty` holding `payload` (-1: Unit) as Ok or Err
// (an Ok() payload word is 0). A view Result's Ok is an allocator view,
// held without an owner (ir_view_result_store); its Err box keeps a 0
// storage address.
ir_result_box: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, ty: Type, success: Bool, payload: Int) -> Int Never! {
    line: b.line
    row: ir_value_type(m, p, ty) ?? ir_pointer_row(m)
    widest := 0
    if ir_untag(ty) == .Result(ok_ty, err_ty) {
        ok_size: ir_type_size(m, p, ok_ty)
        err_size: ir_type_size(m, p, err_ty)
        widest = ir_align8(if ok_size > err_size -> ok_size else -> err_size)
    }
    tail: if ir_view_result(ty) -> ir_view_result_tail(m, p, ty) else -> -1
    boxed: ir_box_alloc(m, b, if tail >= 0 -> tail + 8 else -> 8 + ir_align8(widest), row)
    selector: ir_word_const(m, b, if success -> 1 else -> 0)
    ir_emit(b.f, IROp.Store, -1, boxed, 0, selector, line)
    if payload >= 0 && success && tail >= 0 {
        ir_view_result_store(m, b, boxed, payload, tail)
        return boxed
    }
    if payload >= 0 -> ir_store_at(m, p, b, boxed, 8, payload) else {
        zero: ir_word_const(m, b, 0)
        ir_emit(b.f, IROp.Store, -1, boxed, 8, zero, line)
    }
    if tail >= 0 {
        none: ir_word_const(m, b, 0)
        ir_emit(b.f, IROp.Store, -1, boxed, tail, none, line)
    }
    boxed
}

// `expression` as a value of type row `row`: a plain `T Never!` call result
// is boxed into `Ok` where its carrier is wanted, and a Result box is
// unwrapped where its plain success is.
ir_value_as: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, expression: Int, row: Int, span: Span) -> Int Never! {
    if !ir_is_result(ir_row_ty(m, p, row)) {
        if ir_body_node(p, b, expression).kind == .Ok(inner) {
            return ir_value_as(m, p, b, inner, row, span)
        }
    }
    slot: ir_expr(m, p, b, expression)
    if ir_failed(b) || slot < 0 -> return slot
    ir_adapt(m, p, b, slot, row, span)
}

ir_adapt: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, slot: Int, row: Int, span: Span) -> Int Never! {
    have: b.f.slot_type[slot]
    if have == row -> return slot
    // A function value standing for its fallible or infallible form returns
    // through a converting closure (BuildRoutes ir_fn_widen).
    if ir_fn_widens(m, p, have, row) -> return ir_fn_widen(m, p, b, slot, row, span)
    // A `Never` value (a call that does not return, as `?? fatal()`) ends
    // the path; what follows is unreached.
    if ir_never_type(ir_row_ty(m, p, have)) {
        ir_emit(b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
        target_ty: ir_row_ty(m, p, row)
        return ir_unreachable_value(m, p, b, target_ty)
    }
    want_box: ir_is_result(ir_row_ty(m, p, row))
    have_box: ir_is_result(ir_row_ty(m, p, have))
    if want_box && !have_box {
        target: ir_row_ty(m, p, row)
        return ir_result_box(m, p, b, target, true, slot)
    }
    if have_box && !want_box {
        // A view Result's Ok is a view of its allocator's storage.
        if ir_view_result(ir_row_ty(m, p, have)) -> return ir_view_result_payload(m, p, b, slot, row)
        // A fresh Result box hands its payload over (ir_box_take).
        if b.fresh[slot] -> return ir_box_take(m, p, b, slot, 8, row)
        return ir_load_at(m, b, slot, 8, row)
    }
    // A Result box of another size (an Ok or Err payload narrower or wider)
    // is reboxed: a box is freed with its own type's size (ir_box_bytes).
    if have_box && want_box && ir_box_bytes(m, p, have) != ir_box_bytes(m, p, row) {
        return ir_result_rebox(m, p, b, slot, row, span)
    }
    // A member value where its structural union is wanted (a `[A | B]`
    // literal's element) is boxed as that member's variant (widen_to_union).
    // A smaller union, whose every member sema found in the wanted one, is
    // re-tagged member by member into it (ir_union_rewiden).
    union_ty: ir_row_ty(m, p, row)
    member_ty: ir_row_ty(m, p, have)
    if ir_untag(union_ty) == .Union(_) {
        if ir_untag(member_ty) == .Union(_) {
            return ir_union_rewiden_fresh(m, p, b, slot, member_ty, union_ty, span)
        }
        return ir_union_box(m, p, b, slot, member_ty, union_ty, span)
    }
    // A record where one of the same named members in another order is
    // wanted is rebuilt member by member in the wanted order.
    if ir_untag(union_ty) == .Tuple(want_fields) {
        if ir_untag(member_ty) == .Tuple(have_fields) {
            if ir_record_member_order_differs(want_fields, have_fields) {
                return ir_record_reorder(m, p, b, slot, have_fields, want_fields, row, span)
            }
        }
    }
    // An inline `[T#N]` where a `[T]` is wanted is a List copy of it; no
    // other value stands for an inline `[T#N]`.
    have_fixed: ir_fixed_count(m, have) != None
    want_fixed: ir_fixed_count(m, row) != None
    if have_fixed && !want_fixed && ir_list_element_of(m, p, row) != None {
        return ir_fixed_bridge(m, p, b, slot, row, span)
    }
    if have_fixed != want_fixed {
        return ir_fail_slot(b, span, "a value of {ir_type_name(ir_row_ty(m, p, have))} where {ir_type_name(ir_row_ty(m, p, row))} is expected")
    }
    if m.types[have].kind == m.types[row].kind && m.types[have].size == m.types[row].size {
        return slot
    }
    ir_fail_slot(b, span, "a value of {ir_type_name(ir_row_ty(m, p, have))} where {ir_type_name(ir_row_ty(m, p, row))} is expected")
}

// Whether two records list their members in different orders.
ir_record_member_order_differs: fn(want_fields: [TypeTupleField], have_fields: [TypeTupleField]) -> Bool Never! {
    if want_fields.len() != have_fields.len() -> return false
    loop (index, field) in want_fields {
        if field.name != have_fields[index].name -> return true
    }
    false
}

// The record `slot` (members `have_fields`) as a fresh record of row `row`
// (the same named members, `want_fields`, in another order): each member
// is owned into the new record at its own name. Releases `slot`.
ir_record_reorder: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, slot: Int, have_fields: [TypeTupleField], want_fields: [TypeTupleField], row: Int, span: Span) -> Int Never! {
    have_row: b.f.slot_type[slot]
    have_members: ir_tuple_members(m, p, have_fields) ?? return ir_fail_slot(b, span, "layout of {ir_type_name(ir_row_ty(m, p, have_row))}")
    want_members: ir_tuple_members(m, p, want_fields) ?? return ir_fail_slot(b, span, "layout of {ir_type_name(ir_row_ty(m, p, row))}")
    storage: ir_fresh_temp(m, b, row)
    ir_emit(b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
    loop member in want_members {
        source: loop candidate in have_members {
            if candidate.name == member.name {
                break candidate
            }
        } ?? return ir_fail_slot(b, span, "record member {member.name} of {ir_type_name(ir_row_ty(m, p, row))}")
        loaded: ir_load_at(m, b, slot, source.offset, source.ty)
        owned: ir_own(m, p, b, loaded)
        ir_member_write(m, p, b, storage, member, owned, -1)
    }
    ir_release(m, b, slot)
    storage
}

// The Result box `slot` as a new box of the Result row `row`: the selector
// word and the Ok or Err payload (adapted to `row`'s) move over; a fresh
// `slot` is released with its own size.
ir_result_rebox: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, slot: Int, row: Int, span: Span) -> Int Never! {
    have_raw: ir_row_ty(m, p, b.f.slot_type[slot])
    want_raw: ir_row_ty(m, p, row)
    have_ty: ir_untag(have_raw)
    want_ty: ir_untag(want_raw)
    from := [Type]{}
    to := [Type]{}
    if have_ty == .Result(ok, err) -> from = [Type]{ok.copy(), err.copy()}
    if want_ty == .Result(ok, err) -> to = [Type]{ok.copy(), err.copy()}
    if from.len() != 2 || to.len() != 2 {
        return ir_fail_slot(b, span, "a value of {ir_type_name(have_raw)} where {ir_type_name(want_raw)} is expected")
    }
    // A view Result's Ok is its allocator's: no other box takes it, and a
    // view Result holds no other Ok; only an Err moves between them.
    if (ir_view_result(have_raw) || ir_view_result(want_raw)) && !ir_never_type(from[0]) {
        return ir_fail_slot(b, span, "a value of {ir_type_name(have_raw)} where {ir_type_name(want_raw)} is expected")
    }
    boxed: ir_result_box(m, p, b, want_raw, true, -1)
    selector: ir_load_word(m, b, slot, 0)
    ir_emit(b.f, IROp.Store, -1, boxed, 0, selector, b.line)
    is_ok: ir_result_is_ok(m, b, slot)
    ir_open_if(b.f, is_ok, b.line)
    loop side in 0..<2 {
        if side == 1 -> ir_else(b.f, b.line)
        // A `Never` side (an `Err(e)` literal's Ok) is never selected.
        if ir_never_type(from[side]) {
            ir_emit(b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
            next
        }
        from_row: ir_value_type(m, p, from[side]) ?? return ir_type_fail(b, span, from[side])
        to_row: ir_value_type(m, p, to[side]) ?? return ir_type_fail(b, span, to[side])
        payload: ir_load_at(m, b, slot, 8, from_row)
        if payload >= 0 {
            moved: if from_row == to_row -> payload else -> ir_adapt(m, p, b, payload, to_row, span)
            if ir_failed(b) -> return -1
            ir_store_at(m, p, b, boxed, 8, moved)
        } else if m.types[to_row].kind != .Unit {
            return ir_fail_slot(b, span, "a Unit payload where {ir_type_name(to[side])} is expected")
        }
    }
    ir_end(b.f, b.line)
    ir_release(m, b, slot)
    b.fresh[boxed] = true
    boxed
}

// An Option of an Int (or a type laid out as one), or of a scalar with no
// drop whose words stay below 2^62 (a Bool, a Char, an unsigned word of up to
// 62 bits, a payload-free enum), is one word, not a box (BuildTypes.jet
// ir_value_type_laid): the payload's own word when present,
// IR_OPTION_INT_NONE when absent. That word is never a payload: an inline Int
// lies in [-2^62, 2^62 - 1], a big Int is 2^62 | the address of its node
// (JetRuntime Int.jet int_tag), a heap or data address and never null, and a
// scalar's word is zero-extended below 2^62. An Int payload's drop and clone
// are the Int's (the runtime's pass the niche by); a scalar's has neither.
IR_OPTION_INT_NONE: 4611686018427387904

ir_option_inline: fn(m: IRModule, row: Int) -> Bool Never! { m.types[row].option_word }

// The word of an absent Option of row `row`: null for a box or an optional
// raw pointer.
ir_option_none_word: fn(m: IRModule, row: Int) -> Int Never! {
    if m.types[row].option_null -> return 0
    if ir_option_inline(m, row) -> return IR_OPTION_INT_NONE
    0
}

// Sets the Option `slot` absent.
ir_option_none: fn(m: ^IRModule, b: ^IRBuilder, slot: Int) Never! {
    none: ir_option_none_word(m, b.f.slot_type[slot])
    ir_emit(b.f, IROp.Const, slot, none, -1, -1, b.line)
}

// A new absent Option of row `row`.
ir_option_none_temp: fn(m: ^IRModule, b: ^IRBuilder, row: Int) -> Int Never! {
    slot: ir_temp(m, b, row)
    ir_option_none(m, b, slot)
    slot
}

ir_option_is_some: fn(m: ^IRModule, b: ^IRBuilder, value: Int) -> Int Never! {
    null: ir_temp_like(m, b, value)
    ir_option_none(m, b, null)
    ir_bool_op(m, b, IROp.Ne, value, null)
}

// The present Option `value`'s payload of row `row`, borrowed: the word
// itself for an inline Option, else the box's payload at 0.
ir_option_payload: fn(m: ^IRModule, b: ^IRBuilder, value: Int, row: Int) -> Int Never! {
    if !ir_option_inline(m, b.f.slot_type[value]) -> return ir_load_at(m, b, value, 0, row)
    slot: ir_temp(m, b, row)
    ir_emit(b.f, IROp.Move, slot, value, -1, -1, b.line)
    slot
}

// Makes the inline Option `result` present with `value`, which it owns
// from here (a copy when `value` was only borrowed).
ir_option_inline_into: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, result: Int, value: Int) Never! {
    owned: ir_own(m, p, b, value)
    ir_emit(b.f, IROp.Move, result, owned, -1, -1, b.line)
    b.fresh[owned] = false
}

// A new present inline Option of row `row` owning `value` (fresh, like a
// new box).
ir_option_inline_wrap: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, row: Int, value: Int) -> Int Never! {
    slot: ir_fresh_temp(m, b, row)
    ir_option_inline_into(m, p, b, slot, value)
    slot
}

// A new present Option of row `row` owning `value`: an inline word, or a
// box of `size` payload bytes holding it.
ir_option_make: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, row: Int, value: Int, size: Int) -> Int Never! {
    if ir_option_inline(m, row) -> return ir_option_inline_wrap(m, p, b, row, value)
    boxed: ir_box_alloc(m, b, size, row)
    ir_store_at(m, p, b, boxed, 0, value)
    boxed
}

// Hands the new Option `made` (ir_option_make) to `result`: a box's Copy
// aliases it; an inline word moves, as a Copy would clone its Int.
ir_option_set: fn(m: ^IRModule, b: ^IRBuilder, result: Int, made: Int) Never! {
    if ir_option_inline(m, b.f.slot_type[made]) {
        ir_emit(b.f, IROp.Move, result, made, -1, -1, b.line)
        b.fresh[made] = false
        return
    }
    ir_emit(b.f, IROp.Copy, result, made, -1, -1, b.line)
}

// The inline Option of row `row` a runtime result `boxed` stands for: the
// runtime's generic Option is a fresh 8-byte block owning the payload (null
// when absent). The payload moves out and the block is freed. A scalar is
// read at its own width: the block's other bytes are not its.
ir_option_unbox: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, boxed: Int, row: Int) -> Int Never! {
    out: ir_fresh_temp(m, b, row)
    ir_option_none(m, b, out)
    item_row := row
    if m.types[row].drop == "" && ir_untag(ir_row_ty(m, p, row)) == .Option(inner) {
        item_row = ir_value_type(m, p, inner) ?? row
    }
    zero: ir_word_const(m, b, 0)
    present: ir_bool_op(m, b, IROp.Ne, boxed, zero)
    ir_open_if(b.f, present, b.line)
    item: ir_load_at(m, b, boxed, 0, item_row)
    ir_emit(b.f, IROp.Move, out, item, -1, -1, b.line)
    eight: ir_word_const(m, b, 8)
    ir_free(m, b, boxed, eight)
    ir_end(b.f, b.line)
    out
}

// The address of element `index` (a native word) of the buffer `data`.
ir_element_address: fn(m: ^IRModule, b: ^IRBuilder, data: Int, index: Int, stride: Int) -> Int Never! {
    width: ir_word_const(m, b, stride)
    offset: ir_word_op(m, b, IROp.Mul, index, width)
    ir_word_op(m, b, IROp.Add, data, offset)
}

// The address of the elements of the list at `list` as a native word: a
// List's data word, an inline `[T#N]`'s own storage (ir_fixed_shape).
ir_list_data: fn(m: ^IRModule, b: ^IRBuilder, list: Int) -> Int Never! {
    if ir_fixed_count(m, b.f.slot_type[list]) != None {
        word_row: ir_word_row(m)
        data: ir_temp(m, b, word_row)
        ir_emit(b.f, IROp.Offset, data, list, 0, -1, b.line)
        return data
    }
    ir_load_word(m, b, list, 16)
}

// The length of the list at `list` as a native word: a List's len word, an
// inline `[T#N]`'s N.
ir_list_length: fn(m: ^IRModule, b: ^IRBuilder, list: Int) -> Int Never! {
    if ir_fixed_count(m, b.f.slot_type[list]) == .Val(count) -> return ir_word_const(m, b, count)
    ir_load_word(m, b, list, 0)
}

// An open walk over a list: its native index and the element at it. A walk
// over an Iter (ir_pull_open) also has the block its item was pulled into:
// an Option box, or the runtime's 8-byte block for an inline Option.
IRWalk: struct {
    index: Int,
    item: Int,
    pulled: Int{-1},
    inline: Bool{false},
}

// Opens a loop over the elements of the list at `list` in order;
// ir_walk_close advances and closes it.
ir_walk_open: fn(m: ^IRModule, b: ^IRBuilder, list: Int, row: Int) -> IRWalk Never! {
    stride: ir_list_stride(m, row)
    length: ir_list_length(m, b, list)
    data: ir_list_data(m, b, list)
    index: ir_word_const(m, b, 0)
    exit: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    more: ir_bool_op(m, b, IROp.Lt, index, length)
    ir_exit_unless(m, b, more, exit)
    address: ir_element_address(m, b, data, index, stride)
    item: ir_load_at(m, b, address, 0, row)
    IRWalk{index: index, item: item}
}

ir_walk_close: fn(m: ^IRModule, b: ^IRBuilder, walk: IRWalk) Never! {
    ir_walk_leave(m, b, walk)
    one: ir_word_const(m, b, 1)
    ir_emit(b.f, IROp.Add, walk.index, walk.index, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
}

// Ends the item an Iter walk pulled: at each step's close, and before a
// break out of the walk. A List walk lends its elements, so nothing ends.
ir_walk_leave: fn(m: ^IRModule, b: ^IRBuilder, walk: IRWalk) Never! {
    if walk.pulled < 0 {
        return
    }
    if !walk.inline {
        if ir_has_drop(m, b, walk.pulled) {
            ir_emit(b.f, IROp.Drop, -1, walk.pulled, -1, -1, b.line)
        }
        return
    }
    if walk.item >= 0 && ir_has_drop(m, b, walk.item) {
        ir_emit(b.f, IROp.Drop, -1, walk.item, -1, -1, b.line)
    }
    eight: ir_word_const(m, b, 8)
    ir_free(m, b, walk.pulled, eight)
}

// Opens a loop over the elements of the list at `list` from the last to the
// first; ir_walk_back_close closes it.
ir_walk_back_open: fn(m: ^IRModule, b: ^IRBuilder, list: Int, row: Int) -> IRWalk Never! {
    stride: ir_list_stride(m, row)
    length: ir_list_length(m, b, list)
    data: ir_list_data(m, b, list)
    word_row: ir_word_row(m)
    index: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, index, length, -1, -1, b.line)
    zero: ir_word_const(m, b, 0)
    exit: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    more: ir_bool_op(m, b, IROp.Lt, zero, index)
    ir_exit_unless(m, b, more, exit)
    one: ir_word_const(m, b, 1)
    ir_emit(b.f, IROp.Sub, index, index, one, IR_OVERFLOW_WRAP, b.line)
    address: ir_element_address(m, b, data, index, stride)
    item: ir_load_at(m, b, address, 0, row)
    IRWalk{index: index, item: item}
}

ir_walk_back_close: fn(b: ^IRBuilder) Never! {
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
}

// A List of the element slots `elements` in fresh frame storage (an inline
// `[T#N]` holds them in that storage itself).
ir_list_from: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, row: Int, element_row: Int, elements: [Int]) -> Int Never! {
    stride: ir_list_stride(m, element_row)
    storage: ir_fresh_temp(m, b, row)
    if ir_fixed_count(m, row) != None {
        ir_emit(b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
        loop (index, slot) in elements -> ir_store_at(m, p, b, storage, index * stride, slot)
        return storage
    }
    ir_emit(b.f, IROp.StackAddress, storage, 24, 8, -1, b.line)
    count: ir_word_const(m, b, elements.len())
    ir_emit(b.f, IROp.Store, -1, storage, 0, count, b.line)
    ir_emit(b.f, IROp.Store, -1, storage, 8, count, b.line)
    if elements.len() == 0 {
        none: ir_word_const(m, b, 0)
        ir_emit(b.f, IROp.Store, -1, storage, 16, none, b.line)
        return storage
    }
    data: ir_list_buffer_alloc(m, p, b, elements.len() * stride, element_row)
    loop (index, slot) in elements -> ir_store_at(m, p, b, data, index * stride, slot)
    ir_emit(b.f, IROp.Store, -1, storage, 16, data, b.line)
    storage
}

// The inline `[T#N]` at `slot` as a new List of the List type row `row`
// holding a copy of its N elements.
ir_fixed_bridge: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, slot: Int, row: Int, span: Span) -> Int Never! {
    have: b.f.slot_type[slot]
    count: ir_fixed_count(m, have) ?? return ir_fail_slot(b, span, "a List copy of {ir_type_name(ir_row_ty(m, p, have))}")
    element_row: ir_list_element_of(m, p, row) ?? return ir_fail_slot(b, span, "a List copy as {ir_type_name(ir_row_ty(m, p, row))}")
    bytes: count * ir_list_stride(m, element_row)
    storage: ir_fresh_temp(m, b, row)
    ir_emit(b.f, IROp.StackAddress, storage, 24, 8, -1, b.line)
    length: ir_word_const(m, b, count)
    ir_emit(b.f, IROp.Store, -1, storage, 0, length, b.line)
    ir_emit(b.f, IROp.Store, -1, storage, 8, length, b.line)
    if count == 0 {
        none: ir_word_const(m, b, 0)
        ir_emit(b.f, IROp.Store, -1, storage, 16, none, b.line)
        return storage
    }
    data: ir_list_buffer_alloc(m, p, b, bytes, element_row)
    source: ir_list_data(m, b, slot)
    ir_emit(b.f, IROp.CopyBytes, -1, data, source, bytes, b.line)
    ir_emit(b.f, IROp.Store, -1, storage, 16, data, b.line)
    storage
}

// The elements of `bridge`, an ir_fixed_bridge List a write went through,
// back into the inline `[T#N]` at `slot`; then the List ends.
ir_fixed_store_back: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, slot: Int, bridge: Int) Never! {
    count: ir_fixed_count(m, b.f.slot_type[slot]) ?? return
    element_row: ir_list_element_of(m, p, b.f.slot_type[bridge]) ?? return
    if count > 0 {
        data: ir_load_word(m, b, bridge, 16)
        target: ir_list_data(m, b, slot)
        ir_emit(b.f, IROp.CopyBytes, -1, target, data, count * ir_list_stride(m, element_row), b.line)
    }
    ir_release(m, b, bridge)
}

// An exact Int list position as a native word (jet_int_owned_to_i64).
ir_native_index: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, position: Int, span: Span) -> Int Never! {
    kind: ir_kind_of(m, b, position)
    if kind == .Int {
        word_row: ir_word_row(m)
        return ir_runtime(m, b, "jet_int_owned_to_i64", [Int]{position}, word_row)
    }
    pos_row: b.f.slot_type[position]
    if kind == .Word && m.types[pos_row].size == 8 -> return position
    ir_fail_slot(b, span, "list position of {ir_row_ty(m, p, pos_row)}")
}

// The address of element `index` of the list at `list`, after the bounds
// check (ir_list_bounds_stop). An access at an index sema's loop proof keeps
// inside its fixed list (IRBuilder.proven_index) has no check: the proof is
// the check. A literal index inside an inline `[T#N]` is its element's
// fixed offset.
ir_checked_element: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, list: Int, index: Int, row: Int, span: Span) -> Int Never! {
    proof: b.proven_index.get(index) ?? -1
    if ir_fixed_count(m, b.f.slot_type[list]) == .Val(count) {
        if ir_body_node(p, b, index).kind == .IntLit(value, _) {
            if value >= 0 && value < count {
                if proof >= 0 -> b.f.loop_proofs[proof].lowered += 1
                word_row: ir_word_row(m)
                address: ir_temp(m, b, word_row)
                ir_emit(b.f, IROp.Offset, address, list, value * ir_list_stride(m, row), -1, b.line)
                return address
            }
        }
    }
    position: ir_expr(m, p, b, index)
    if ir_failed(b) || position < 0 -> return -1
    native: ir_native_index(m, p, b, position, span)
    if ir_failed(b) -> return -1
    if proof >= 0 {
        b.f.loop_proofs[proof].lowered += 1
        data: ir_list_data(m, b, list)
        stride: ir_list_stride(m, row)
        return ir_element_address(m, b, data, native, stride)
    }
    ir_checked_address(m, p, b, list, native, row, span)
}

// The address of element `native` (a native word) of the list at `list`,
// after the bounds check the builder's mode keeps (IRBuilder.bounds): Fatal
// stops at a failed check (the stop's caret under `span`), Report reports it
// and goes on, Off has none.
ir_checked_address: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, list: Int, native: Int, row: Int, span: Span) -> Int Never! {
    if b.bounds != .Off {
        length: ir_list_length(m, b, list)
        bad: ir_index_order(m, b, IROp.Ge, native, length)
        ir_open_if(b.f, bad, b.line)
        if b.bounds == .Report -> ir_list_bounds_report(m, b, length, native) else {
            ir_list_bounds_stop(m, p, b, length, native, span)
        }
        ir_end(b.f, b.line)
    }
    data: ir_list_data(m, b, list)
    stride: ir_list_stride(m, row)
    ir_element_address(m, b, data, native, stride)
}

// The comparison `op` of the signed word index `native` with a list length,
// on the index's U64 bits: a negative index is past every length, so
// `native < length` alone keeps it inside 0..<length.
ir_index_order: fn(m: ^IRModule, b: ^IRBuilder, op: IROp, native: Int, length: Int) -> Int Never! {
    unsigned_row: ir_type_row(m, Type.IntN{signed: false, bits: 64}) ?? 0
    bits: ir_copy_word(m, b, native, unsigned_row)
    ir_bool_op(m, b, op, bits, length)
}

// A copy of the value in `slot` that owns its own storage: a value with a
// runtime clone through it, an aggregate byte for byte with every buffer and
// cloned part of its own at any depth (BuildOwn.jet ir_copy_fixup).
ir_copy_value: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, slot: Int, span: Span) -> Int Never! {
    row: b.f.slot_type[slot]
    kind: m.types[row].kind
    clone: m.types[row].clone
    ir_close_disarm(b, slot)
    if clone != "" -> return ir_clone(m, b, slot, row)
    if kind == .Aggregate {
        storage: ir_fresh_temp(m, b, row)
        ir_emit(b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
        ir_emit(b.f, IROp.CopyBytes, -1, storage, slot, m.types[row].size, b.line)
        ir_copy_fixup(m, p, b, row, storage)
        return storage
    }
    duplicate: ir_temp_like(m, b, slot)
    ir_emit(b.f, IROp.Copy, duplicate, slot, -1, -1, b.line)
    duplicate
}

// An integer constant of type row `row`: an exact Int outside the inline
// range is built by the runtime (jet_int_owned_from_i64).
ir_int_constant: fn(m: ^IRModule, b: ^IRBuilder, row: Int, value: Int) -> Int Never! {
    if m.types[row].kind == .Int && !ir_int_inline(value) {
        raw: ir_word_const(m, b, value)
        return ir_runtime(m, b, "jet_int_owned_from_i64", [Int]{raw}, row)
    }
    slot: ir_temp(m, b, row)
    ir_emit(b.f, IROp.Const, slot, value, -1, -1, b.line)
    slot
}

// The 64-bit word of the exact Int in slot `value`, read back through a frame
// cell: an inline Int's value, or a big Int's tagged handle.
ir_int_word: fn(m: ^IRModule, b: ^IRBuilder, value: Int) -> Int Never! {
    pointer_row: ir_pointer_row(m)
    cell: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.StackAddress, cell, 8, 8, -1, b.line)
    ir_emit(b.f, IROp.Store, -1, cell, 0, value, b.line)
    ir_load_word(m, b, cell, 0)
}

// Whether the exact Int whose word (ir_int_word) is `bits` is inline: bits 62
// and 63 agree (Int.jet int_inline). A Bool slot. Every Int in the inline
// range is inline, so an inline value lies inside every bound past that range.
ir_int_word_inline: fn(m: ^IRModule, b: ^IRBuilder, bits: Int) -> Int Never! {
    sixty_two: ir_word_const(m, b, 62)
    sixty_three: ir_word_const(m, b, 63)
    top: ir_word_op(m, b, IROp.Shr, bits, sixty_two)
    sign: ir_word_op(m, b, IROp.Shr, bits, sixty_three)
    ir_bool_op(m, b, IROp.Eq, top, sign)
}

// An empty List of type row `row` in fresh frame storage (a PriorityQueue's
// or a Rank's header with its native order word).
ir_list_empty: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, row: Int) -> Int Never! {
    ordered: ir_ordered_header(m, p, row)
    storage: ir_fresh_temp(m, b, row)
    ir_emit(b.f, IROp.StackAddress, storage, if ordered -> 32 else -> 24, 8, -1, b.line)
    zero: ir_word_const(m, b, 0)
    ir_emit(b.f, IROp.Store, -1, storage, 0, zero, b.line)
    ir_emit(b.f, IROp.Store, -1, storage, 8, zero, b.line)
    ir_emit(b.f, IROp.Store, -1, storage, 16, zero, b.line)
    if ordered -> ir_emit(b.f, IROp.Store, -1, storage, 24, zero, b.line)
    storage
}

// A slot standing for the value of an expression control never leaves
// (after an Unreachable): -1 for Unit, else an unwritten temporary.
ir_unreachable_value: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, ty: Type) -> Int Never! {
    if ir_unit_type(ty) || ir_never_type(ty) -> return -1
    row: ir_value_type(m, p, ty) ?? return -1
    if m.types[row].kind == .Unit -> return -1
    slot: ir_temp(m, b, row)
    if m.types[row].kind == .Aggregate {
        ir_emit(b.f, IROp.StackAddress, slot, m.types[row].size, 8, -1, b.line)
    }
    slot
}
