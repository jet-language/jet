// The IR builder: checked TIR functions to IR. Every construct keeps the
// meaning the retired native lowering gave it: the same runtime routes,
// argument orders and source locations, so a program behaves the same as it
// did there. A construct the builder does not
// handle yet fails its function with one message naming the construct; the
// module build keeps going and reports every failure (collect-all).

use jet_foundation.[CompilerThreads, Span, Type, TypeTupleField, BodyCallArg, TConstantDef, NodeKind, TExprType, TFailureCarrier, FnBody, TGenericParam, TImplDef, BodyLambda, TLocal, TTypeDef, tir_expr_type, type_carrier_identity, BodyNode, BodyTree, StmtKind, body_node, body_stmt]
use jet_sema.[SemaCheckedForeignFunction]

struct IRBuildFailure {
    key: String
    name: String
    message: String
    source_file: String
    span: Span
}

struct IRBuildResult {
    program: IRModule
    failures: [IRBuildFailure]
}

// A visible name: `slot` holds the variable named `name`. `indirect` is the
// type row of the value when `slot` holds its address (a write parameter, or
// a variable a closure writes, kept in a frame cell); -1: the slot is the
// variable itself. `owned`: the variable owns its value, which is dropped
// when its scope ends (every other holder of the value has its own copy).
// `symbol`: the checked symbol key of a variable that has one. `write`: an
// aggregate write parameter (or receiver), whose slot addresses the caller's
// storage, so a whole-value assignment writes there. `carrier`: the carrier
// box slot a payload binding was read from (-1: none). `live`: for an owned
// variable some paths moved and others kept, the Bool slot that holds
// whether it still holds its value (-1: it does wherever it owns it).
struct IRBinding { name: String, slot: Int, indirect: Int{-1}, owned: Bool{false}, symbol: String{""}, write: Bool{false}, carrier: Int{-1}, live: Int{-1} }

// A write argument passed through a frame cell: after the call the variable
// `slot` reads its value back from `cell`.
struct IRWriteBack { cell: Int, slot: Int }

// An open loop: `exit` is the Block that `break` leaves, `next` the
// construct that `next` (continue) leaves or restarts; `mark` the bindings
// visible when it opened (leaving it drops the owned ones declared since).
// A valued loop (`x :: loop { ... break v }`) writes its break value into
// `value` (-1: a statement loop).
struct IRLoopFrame { label: String?, exit: Int, next: Int, mark: Int, value: Int{-1} }

// Per-function build state. `fresh[slot]` marks a temporary that holds a
// value nobody else owns yet (a call result, a built String): a borrowing
// consumer drops it after use.
struct IRBuilder {
    f: IRFunction
    bindings: [IRBinding]
    scopes: [Int]
    loops: [IRLoopFrame]
    fresh: [Bool]
    // The subject slots of the open switches (innermost last).
    subjects: [Int]
    // Pattern bindings of the condition being built, bound when its If opens.
    pending: [IRPending]
    line: Int
    error: String
    error_span: Span
    // The function's executable return (None: Unit), its failure carrier, and
    // whether it hands back the plain success of a `T Never!` carrier.
    ret: Type?
    failure: TFailureCarrier
    plain: Bool
    // Variables some closure of this body writes: they live in frame cells
    // from their declaration, so every read sees the closure's writes.
    cells: [String]
    // Calls emitted where the program is only read (display impls): their
    // callee ids are resolved when the function is done.
    deferred: [IRDeferredCall]
    // The variables that close their values when their scopes end (BuildOwn.jet).
    closes: [IRClose]
    // The open `#Transact` blocks (innermost last) an early exit unwinds.
    transactions: [IRTxFrame]
    // The open contract scopes (innermost last) whose `post` clauses a
    // return checks.
    contracts: [IRContractFrame]
    // The variable slot an explicit move (`^x`) just read (-1: none): that
    // read moves even where a plain read of the variable would share.
    moving: Int{-1}
    // The `#Impure` blocks open around the code being built: a build host
    // call made inside one may touch the ambient world (ir_host_method).
    impure: Int{0}
    // The checked function whose body tree (FnBody.tree) holds the nodes and
    // statements this body reads (-1: glue with no checked body), and the
    // nodes and statements the builder made itself (ir_node, ir_stmt_node)
    // with the next node id it hands out.
    row: Int{-1}
    made: BodyTree{BodyTree{nodes: [BodyNode]{}, stmts: [StmtKind]{}, expr_types: [TExprType]{}}}
    next_node: Int{IR_FIRST_NODE_ID}
    // The closures this body created so far, by key base (ir_lambda).
    lambdas: [String:Int]
}

// The Call at instruction `at` of function `function` (-1: the function
// being built) names the checked function `key` applied to `args`.
struct IRDeferredCall { at: Int, key: String, function: Int{-1}, args: [Type]{[Type]{}} }

// The checked program the builder reads: the checked functions every IR
// function id may name, by key, and the checked type declarations, by key
// and by name. It is read-only while functions are built; the build state
// (queue, instances, substitution) lives in IRModule. A generic function is
// built once per distinct list of concrete type arguments (monomorphized as
// the old path's Mono pass does).
struct IRProgram {
    functions: [FnBody]
    rows: [String:Int]
    types: [TTypeDef]
    type_rows: [String:Int]
    // Checked constants by key (ConstRef / CtLit values).
    constants: [String:TConstantDef]
    // A selected Display (`display`), Printable (`show`) or user Comparable
    // (`compare`) implementation method by "<trait>|<rendered type key>"
    // (Lower Display.jet render rows, Maps.jet lower_order_user_impl).
    render_impls: [String:Int]
    // The selected Close implementation method (`close`) by rendered type
    // key (Lower Values.jet lower_close_index).
    close_methods: [String:Int]
    // The implementation methods a dynamic trait call may select, by
    // "<trait>|<method>" (function rows; see ir_trait_methods).
    trait_methods: [String:[Int]]
    // The checked source files' bytes and line starts by row, and each
    // path's row: a source location reads the file in place.
    source_bytes: [[U8]]
    source_lines: [[Int]]
    source_rows: [String:Int]
    // The checked foreign functions a call may name, by function key.
    foreign: [String:SemaCheckedForeignFunction]
    // A runtime library's intrinsics by function key (BuildLibrary.jet):
    // a call of one is its machine operation, never a call.
    intrinsics: [String:IRRuntimeIntrinsic]
}

// The checked source files (`path` -> text) as rows of bytes and line
// starts (codegen Builder.jet jet_codegen_source_index).
fn ir_source_index(p: &IRProgram, sources: ^[String:String]) Never! {
    loop (path, text) in ^sources {
        if p.source_rows.get(path) != None -> next
        bytes := text.bytes()
        starts := [Int]{0}
        loop (index, byte) in bytes {
            if byte == (U8{10}) -> &starts.push(index + 1)
        }
        p.source_rows[path] = p.source_bytes.len()
        &p.source_bytes.push(^bytes)
        &p.source_lines.push(^starts)
    }
}

// The 1-based line holding byte `offset` of `path` (codegen
// jet_codegen_line_of); None when the file is not a checked source.
fn ir_source_line_of(p: IRProgram, path: String, offset: Int) -> Int? Never! {
    row :: p.source_rows.get(path) ?? return None
    low := 0
    high := p.source_lines[row].len()
    loop low < high {
        middle :: (low + high) /% 2
        if p.source_lines[row][middle] <= offset -> low = middle + 1 else -> high = middle
    }
    Val(low)
}

// The 1-based character column of byte `offset` of `path` (codegen
// jet_codegen_source_column_at): 1 when the file is not a checked source,
// None when the offset falls outside it.
fn ir_source_column(p: IRProgram, path: String, offset: Int) -> Int? Never! {
    row :: p.source_rows.get(path) ?? return Val(1)
    if offset < 0 || offset > p.source_bytes[row].len() -> return None
    column := 1
    at := offset
    loop at > 0 && p.source_bytes[row][at - 1] != (U8{10}) {
        at -= 1
        if p.source_bytes[row][at] < (U8{128}) || p.source_bytes[row][at] >= (U8{192}) -> column += 1
    }
    Val(column)
}

// Line `line` of `path` without its line break (codegen
// jet_codegen_source_location): "" when the file is not a checked source;
// None when the line is outside it or not UTF-8.
fn ir_source_line_text(p: IRProgram, path: String, line: Int) -> String? Never! {
    row :: p.source_rows.get(path) ?? return Val("")
    if line < 1 || line > p.source_lines[row].len() -> return None
    start :: p.source_lines[row][line - 1]
    end := start
    loop end < p.source_bytes[row].len() && p.source_bytes[row][end] != (U8{10}) -> end += 1
    if end > start && p.source_bytes[row][end - 1] == (U8{13}) -> end -= 1
    text := [U8]{}
    loop at in start..<end -> &text.push(p.source_bytes[row][at])
    Val(String.from_bytes(text) ?? return None)
}

// A function waiting to be built: its checked row, IR id and type
// arguments, or the lambda job it builds (`lambda` >= 0).
struct IRQueued { row: Int, id: Int, args: [Type], lambda: Int{-1} }

// A lambda body to build as its own function: the box holds its captures
// at their offsets; the instance substitution it was created under; the
// checked function whose tree holds its nodes and the nodes the creating
// builder made (IRBuilder `row`, `made`, `next_node`).
struct IRLambdaJob {
    lambda: BodyLambda
    captures: [IRCaptureSlot]
    source_file: String
    line: Int
    subst_names: [String]
    subst_types: [Type]
    row: Int
    made: BodyTree
    next_node: Int
}

// One closure capture: the name the body reads, its byte offset in the box,
// its value type row, and whether the box holds its address (a capture the
// body writes) instead of its value.
struct IRCaptureSlot { name: String, offset: Int, row: Int, by_ref: Bool }

fn ir_program_new(functions: ^[FnBody], type_defs: ^[TTypeDef], impl_defs: ^[TImplDef], sources: ^[String:String], constant_defs: ^[TConstantDef]) -> IRProgram Never! {
    constants := [String:TConstantDef]{}
    loop definition in ^constant_defs {
        if constants.get(definition.key) == None -> constants[definition.key] = definition
        // A ConstRef names `constant:<module>::<name>`.
        qualified :: "constant:{definition.module_identity}::{definition.name}"
        if constants.get(qualified) == None -> constants[qualified] = definition
    }
    owned := ^functions
    rows := [String:Int]{}
    loop (index, function) in owned {
        if rows.get(function.key) == None -> rows[function.key] = index
    }
    types := ^type_defs
    ir_add_compiler_owned_types(&types)
    ir_add_union_types(&types, owned)
    type_rows := [String:Int]{}
    loop (index, definition) in types {
        if type_rows.get(definition.key) == None -> type_rows[definition.key] = index
    }
    loop (index, definition) in types {
        if type_rows.get(definition.name) == None -> type_rows[definition.name] = index
    }
    // An implementation method is checked as its owner's method of that name
    // (a TraitMethod when its trait resolves in the implementing module,
    // else a plain Method, as codegen jet_codegen_impl_method_matches reads it).
    owner_methods := [String:Int]{}
    render_impls := [String:Int]{}
    loop (index, function) in owned {
        if function.name != "display" && function.name != "show" && function.name != "close" && function.name != "compare" -> next
        if function.kind == {
            .TopLevel -> {}
            .Method(_, owner_type) -> {
                key :: "{function.name}||{ir_render_type_key(type_rows, types, owner_type)}"
                if owner_methods.get(key) == None -> owner_methods[key] = index
            }
            .TraitMethod(_, _, owner_type, trait_name, _) -> {
                trait_short :: ir_short_name(trait_name.key)
                owner_key :: ir_render_type_key(type_rows, types, owner_type)
                key :: "{function.name}|{trait_short}|{owner_key}"
                if owner_methods.get(key) == None -> owner_methods[key] = index
                selected :: (trait_short == "Display" && function.name == "display") || (trait_short == "Printable" && function.name == "show")
                if selected {
                    render_key :: "{trait_short}|{owner_key}"
                    if render_impls.get(render_key) == None -> render_impls[render_key] = index
                }
            }
        }
    }
    // The Display, Printable and Close implementations of the host target
    // (Lower lower_render_impl_applies, lower_close_index), and the user
    // Comparable ones (a derived Comparable orders structurally: Lower
    // lower_order_user_impl). Every trait implementation of the host target
    // also names its methods' traits for ir_trait_methods.
    close_methods := [String:Int]{}
    impl_slots := [String:Int]{}
    impl_traits := [[String]]{}
    loop implementation in ^impl_defs {
        trait_name :: if implementation.trait_ref == .Val(name) -> name else if implementation.trait_name == .Val(name) -> name else -> ""
        if trait_name == "" -> next
        if implementation.target_os == .Val(os) {
            if os != .Linux -> next
        }
        trait_short :: ir_short_name(trait_name)
        owner_key :: ir_render_type_key(type_rows, types, implementation.self_type)
        loop key in implementation.methods {
            slot_key :: "{implementation.module_identity}|{owner_key}|{ir_impl_method_leaf(key)}"
            slot := impl_slots.get(slot_key) ?? -1
            if slot < 0 {
                slot = impl_traits.len()
                impl_slots[slot_key] = slot
                &impl_traits.push([String]{})
            }
            &impl_traits[slot].push(trait_short.copy())
        }
        method :: if trait_short == {
            "Display" -> "display"
            "Printable" -> "show"
            "Close" -> "close"
            "Comparable" -> if implementation.compiler_generated -> "" else -> "compare"
            else -> ""
        }
        if method == "" -> next
        row :: owner_methods.get("{method}|{trait_short}|{owner_key}") ?? owner_methods.get("{method}||{owner_key}") ?? -1
        if row < 0 -> next
        if trait_short == "Close" {
            if close_methods.get(owner_key) == None -> close_methods[owner_key] = row
        } else {
            render_key :: "{trait_short}|{owner_key}"
            if render_impls.get(render_key) == None -> render_impls[render_key] = row
        }
    }
    trait_methods :: ir_trait_methods(owned, type_rows, types, impl_slots, impl_traits)
    p := IRProgram{functions: ^owned, rows: rows, types: ^types, type_rows: type_rows, constants: constants, render_impls: render_impls, close_methods: close_methods, trait_methods: trait_methods, source_bytes: [[U8]]{}, source_lines: [[Int]]{}, source_rows: [String:Int]{}, foreign: [String:SemaCheckedForeignFunction]{}, intrinsics: [String:IRRuntimeIntrinsic]{}}
    ir_source_index(&p, ^sources)
    p
}

// An empty module ready to build `p`'s functions (no function queued yet).
fn ir_module_for(p: IRProgram) -> IRModule Never! {
    m := ir_module_new()
    loop _ in 0..<p.functions.len() -> &m.ids.push(-1)
    m
}

// The implementation methods of every trait by "<trait>|<method>" (codegen
// jet_codegen_lower_impl_definition): an implementation's method is the
// same-module method of that name on the implementation's owner. It is
// checked as a TraitMethod when its trait resolves in the implementing
// module, else as a plain Method of the owner, which `impl_slots` (by
// "<module>|<owner key>|<method>") and `impl_traits` name the traits of.
fn ir_trait_methods(functions: [FnBody], type_rows: [String:Int], types: [TTypeDef], impl_slots: [String:Int], impl_traits: [[String]]) -> [String:[Int]] Never! {
    slots := [String:Int]{}
    keys := [String]{}
    rows := [[Int]]{}
    loop (index, function) in functions {
        traits := [String]{}
        if function.kind == {
            .TraitMethod(_, _, _, trait_name, _) -> &traits.push(ir_short_name(trait_name.key))
            .Method(_, owner_type) -> {
                owner_key :: ir_render_type_key(type_rows, types, owner_type)
                slot :: impl_slots.get("{function.module_identity}|{owner_key}|{function.name}") ?? -1
                if slot >= 0 {
                    loop trait_short in impl_traits[slot] -> &traits.push(trait_short.copy())
                }
            }
            .TopLevel -> {}
        }
        loop trait_short in traits {
            key :: "{trait_short}|{function.name}"
            slot := slots.get(key) ?? -1
            if slot < 0 {
                slot = rows.len()
                slots[key] = slot
                &keys.push(key)
                &rows.push([Int]{})
            }
            &rows[slot].push(index)
        }
    }
    methods := [String:[Int]]{}
    loop (slot, key) in keys -> methods[key] = rows[slot]
    methods
}

// The last segment of a qualified key (`trait:<m>::Display` is `Display`).
fn ir_short_name(key: String) -> String Never! {
    short := key
    separators :: [String]{"::", ".", ":"}
    loop separator in separators {
        parts :: short.split(separator).to_list()
        short = parts[parts.len() - 1]
    }
    short
}

// The declaration a nominal type name or key names.
fn ir_type_def(p: IRProgram, name: String) -> Int? Never! {
    p.type_rows.get(name)
}

// The IR id of the checked function `key` applied to `type_args` (written
// in the current instance's terms), queueing it on first use.
fn ir_function_id(m: &IRModule, p: IRProgram, key: String, type_args: [Type]) -> Int? Never! {
    row :: p.rows.get(key) ?? return None
    function :: p.functions[row]
    if type_args.len() == 0 || (function.generic_params.len() == 0 && ir_owner_binders(p, function).len() == 0) {
        if m.ids[row] >= 0 -> return Val(m.ids[row])
        id :: m.functions.len()
        &m.functions.push(ir_function_new(function.name, function.key, ir_symbol_name(function), function.source_file, function.line))
        m.function_rows[function.key] = id
        m.ids[row] = id
        &m.queue.push(IRQueued{row: row, id: id, args: [Type]{}})
        return Val(id)
    }
    // An instance binds every one of its type parameters.
    if type_args.len() != ir_generic_names(p, function).len() -> return None
    concrete := [Type]{}
    spelled := [String]{}
    loop arg in type_args {
        &concrete.push(ir_subst(m, arg))
        &spelled.push(type_carrier_identity(concrete[concrete.len() - 1]))
    }
    instance :: "{function.key}<{spelled.join(", ")}>"
    if m.instances.get(instance) == .Val(known) -> return Val(known)
    id :: m.functions.len()
    &m.functions.push(ir_function_new(function.name, instance, "{ir_symbol_name(function)}__{ir_key_hash(instance)}", function.source_file, function.line))
    m.function_rows[instance] = id
    m.instances[instance] = id
    &m.queue.push(IRQueued{row: row, id: id, args: concrete})
    Val(id)
}

// The type parameters an instance of `function` binds, in order: those its
// owner's pattern binds (a method of a generic type, `Pair<T>`), then its
// own (codegen jet_codegen_checked_method_return_type).
fn ir_generic_names(p: IRProgram, function: FnBody) -> [String] Never! {
    names := [String]{}
    loop binder in ir_owner_binders(p, function) -> &names.push(binder.name)
    loop parameter in function.generic_params -> &names.push(parameter.name)
    names
}

// A type parameter of a generic owner a method binds, at argument `index`
// of its owner pattern.
struct IROwnerBinder { index: Int, name: String }

// The owner type parameters a method of a generic type declaration binds:
// each argument of its owner pattern that is one of the declaration's
// parameters the method does not shadow with its own (`impl Pair<Int>`
// binds none). None for any other function.
fn ir_owner_binders(p: IRProgram, function: FnBody) -> [IROwnerBinder] Never! {
    binders := [IROwnerBinder]{}
    owner :: if function.kind == {
        .Method(_, owner_type) | .TraitMethod(_, _, owner_type, _, _) -> ir_untag(owner_type)
        .TopLevel -> { return binders }
    }
    if owner == .Apply(owner_name, args) {
        row :: ir_type_def(p, owner_name) ?? return binders
        declared :: p.types[row].generic_params
        if declared.len() != args.len() -> return binders
        loop (index, arg) in args {
            name :: ir_type_parameter_name(arg) ?? next
            if !ir_declares(declared, name) || ir_declares(function.generic_params, name) -> next
            &binders.push(IROwnerBinder{index: index, name: name})
        }
    }
    binders
}

fn ir_type_parameter_name(ty: Type) -> String? Never! {
    if ty == .Named(name) -> return Val(name)
    if ty == .Apply(name, args) {
        if args.len() == 0 -> return Val(name)
    }
    None
}

fn ir_declares(params: [TGenericParam], name: String) -> Bool Never! {
    loop parameter in params {
        if parameter.name == name -> return true
    }
    false
}

// The owner arguments an instance of `function` binds for its owner type
// `owner` (`[Int]` for `Pair<T>` at `Pair<Int>`): None when `owner` does
// not spell them.
fn ir_owner_args(p: IRProgram, function: FnBody, owner: Type) -> [Type]? Never! {
    args := [Type]{}
    binders :: ir_owner_binders(p, function)
    if binders.len() == 0 -> return Val(args)
    actual :: ir_type_args(owner)
    loop binder in binders {
        if binder.index >= actual.len() -> return None
        &args.push(actual[binder.index].copy())
    }
    Val(args)
}

// The owner arguments a static call of `function` binds when its owner is
// written without them (`Box.new(7)`): what the call's type `ty` and its
// arguments' types give the owner parameters in the method's signature.
// None when they leave one unbound.
fn ir_infer_owner_args(p: IRProgram, b: IRBuilder, function: FnBody, ty: Type, args: [BodyCallArg]) -> [Type]? Never! {
    names := [String]{}
    bound := [Type?]{}
    loop binder in ir_owner_binders(p, function) {
        &names.push(binder.name)
        &bound.push(None)
    }
    if function.ret == .Val(ret) -> ir_bind_names(names, ret, ty, &bound)
    loop (index, param) in function.params {
        if index < args.len() -> ir_bind_names(names, param.ty, ir_ty(p, b, args[index].value), &bound)
    }
    inferred := [Type]{}
    loop slot in bound {
        found :: slot ?? return None
        &inferred.push(found)
    }
    Val(inferred)
}

// Binds each of `names` not yet in `bound` to what `actual` holds where
// `pattern` (written with them) names it.
fn ir_bind_names(names: [String], pattern: Type, actual: Type, bound: &[Type?]) Never! {
    if ir_type_parameter_name(pattern) == .Val(name) {
        loop (index, parameter) in names {
            if parameter == name && bound[index] == None -> bound[index] = Val(ir_untag(actual))
        }
        return
    }
    concrete :: ir_untag(actual)
    if pattern == {
        .Apply(_, args) -> {
            if concrete == .Apply(_, actuals) {
                if actuals.len() == args.len() {
                    loop (index, arg) in args -> ir_bind_names(names, arg, actuals[index], &bound)
                }
            }
        }
        .List(element) -> {
            if concrete == .List(actual_element) -> ir_bind_names(names, element, actual_element, &bound)
        }
        .Option(inner) -> {
            if concrete == .Option(actual_inner) -> ir_bind_names(names, inner, actual_inner, &bound)
        }
        .Result(ok, err) -> {
            if concrete == .Result(actual_ok, actual_err) {
                ir_bind_names(names, ok, actual_ok, &bound)
                ir_bind_names(names, err, actual_err, &bound)
            }
        }
        .Tagged(_, inner) -> ir_bind_names(names, inner, concrete, &bound)
        else -> {}
    }
}

// `ty` in the terms of the instance being built.
fn ir_subst(m: IRModule, ty: Type) -> Type Never! {
    if m.subst_names.len() == 0 -> return ty.copy()
    ir_subst_in(m.subst_names, m.subst_types, ty)
}

// `ty` with each type parameter `names[i]` replaced by `types[i]`.
fn ir_subst_in(names: [String], types: [Type], ty: Type) -> Type Never! {
    if ty == {
        .Named(name) -> {
            loop (index, parameter) in names {
                if parameter == name -> return types[index].copy()
            }
            return ty.copy()
        }
        .Apply(name, args) -> {
            if args.len() == 0 {
                loop (index, parameter) in names {
                    if parameter == name -> return types[index].copy()
                }
                return ty.copy()
            }
            return Type.Apply{name: name, args: ir_subst_list(names, types, args)}
        }
        .List(element) -> return Type.List{element: ir_subst_in(names, types, element)}
        .Option(inner) -> return Type.Option{inner: ir_subst_in(names, types, inner)}
        .Result(ok, err) -> return Type.Result{ok: ir_subst_in(names, types, ok), err: ir_subst_in(names, types, err)}
        .Shared(inner) -> return Type.Shared{inner: ir_subst_in(names, types, inner)}
        .Map(key, key_span, value) -> return Type.Map{key: ir_subst_in(names, types, key), key_span: key_span, value: ir_subst_in(names, types, value)}
        .Tagged(marker, inner) -> return Type.Tagged{marker: marker, inner: ir_subst_in(names, types, inner)}
        .FixedList(elem, len) -> return Type.FixedList{elem: ir_subst_in(names, types, elem), len: len}
        .Union(members) -> return Type.Union{members: ir_subst_list(names, types, members)}
        .Tuple(fields) -> {
            mapped := [TypeTupleField]{}
            loop field in fields -> &mapped.push(TypeTupleField{name: field.name, ty: ir_subst_in(names, types, field.ty)})
            return Type.Tuple{fields: mapped}
        }
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            mapped_ret := Type?{None}
            if ret == .Val(returned) -> mapped_ret = Val(ir_subst_in(names, types, returned))
            return Type.Fn{params: ir_subst_list(names, types, params), ret: mapped_ret, effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        else -> return ty.copy()
    }
}

fn ir_subst_list(names: [String], types: [Type], list: [Type]) -> [Type] Never! {
    mapped := [Type]{}
    loop item in list -> &mapped.push(ir_subst_in(names, types, item))
    mapped
}

// The object symbol of a function: its module and name, made a C identifier.
fn ir_symbol_name(function: FnBody) -> String Never! {
    bytes := [U8]{}
    loop byte in "{function.module_name}.{function.name}".bytes() {
        alphanumeric :: (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
        &bytes.push(if alphanumeric -> byte else -> U8{95})
    }
    String.from_bytes(bytes) ?? function.name.copy()
}

// Builds the entry `entry_key` and every function it reaches, on up to
// `threads` threads (BuildWaves.jet). `type_defs`, `impls` and `constants`
// are the checked modules' type, implementation and constant declarations,
// in module order; `sources` the checked source files' text by path (the
// source locations of journeys and contract reports); `foreign` the checked
// foreign functions.
fn ir_build_program(functions: ^[FnBody], type_defs: ^[TTypeDef], impls: ^[TImplDef], sources: ^[String:String], constants: ^[TConstantDef], foreign: ^[SemaCheckedForeignFunction], entry_key: String, threads: CompilerThreads) -> IRBuildResult Never! {
    p := ir_program_new(^functions, ^type_defs, ^impls, ^sources, ^constants)
    ir_foreign_index(&p, ^foreign)
    row :: p.rows.get(entry_key) ?? {
        failures := [IRBuildFailure]{IRBuildFailure{key: entry_key, name: entry_key, message: "the entry function is not among the checked functions", source_file: "", span: Span{start: 0, end: 0}}}
        return IRBuildResult{program: ir_module_for(p), failures: failures}
    }
    roots := [IRWaveJob]{IRWaveJob{key: p.functions[row].key.copy(), row: row, args: [Type]{}, lambda: -1, part: -1, local: -1}}
    ir_build_waves(^p, ^roots, true, threads)
}

// Builds the functions `root_keys` name and every function they reach, as
// ir_build_program does, with no program entry: compile-time evaluation runs
// each root itself.
fn ir_build_roots(functions: ^[FnBody], type_defs: ^[TTypeDef], impls: ^[TImplDef], sources: ^[String:String], constants: ^[TConstantDef], foreign: ^[SemaCheckedForeignFunction], root_keys: [String], threads: CompilerThreads) -> IRBuildResult Never! {
    p := ir_program_new(^functions, ^type_defs, ^impls, ^sources, ^constants)
    ir_foreign_index(&p, ^foreign)
    roots := [IRWaveJob]{}
    failures := [IRBuildFailure]{}
    loop key in root_keys {
        row :: p.rows.get(key) ?? {
            &failures.push(IRBuildFailure{key: key.copy(), name: key.copy(), message: "the root function is not among the checked functions", source_file: "", span: Span{start: 0, end: 0}})
            next
        }
        &roots.push(IRWaveJob{key: p.functions[row].key.copy(), row: row, args: [Type]{}, lambda: -1, part: -1, local: -1})
    }
    if failures.len() > 0 -> return IRBuildResult{program: ir_module_for(p), failures: failures}
    ir_build_waves(^p, ^roots, false, threads)
}

// The function the executable starts: `entry` itself when it takes nothing
// and returns nothing, otherwise a generated `entry` function that calls it
// and handles its failure carrier as Lower's entry helper does
// (Lower/Entry.jet lower_entry_function): an `Err` ends the process with the
// error's report and exit status 1 (the default `Err` through
// jet_rt_entry_error_exit_err, any other error through its Printable text
// and jet_rt_entry_error_exit), a `None` with "entry returned no value";
// success drops the result and returns.
fn ir_entry_function(m: &IRModule, p: IRProgram, entry: Int, failures: &[IRBuildFailure]) -> Int Never! {
    row :: m.functions[entry].result
    if row < 0 || m.functions[entry].param_count > 0 -> return entry
    ty :: m.types[row].ty.copy()
    key :: "{m.functions[entry].key}#entry"
    id :: m.functions.len()
    &m.functions.push(ir_function_new("entry", key, "{m.functions[entry].symbol}__entry", m.functions[entry].source_file, m.functions[entry].line))
    m.function_rows[key] = id
    b := ir_builder_new(m.functions[id].copy())
    b.line = m.functions[entry].line
    span :: Span{start: 0, end: 0}
    result :: ir_fresh_temp(&m, &b, row)
    operands :: ir_args(&b.f, [Int]{})
    ir_emit(&b.f, IROp.Call, result, entry, operands, 0, b.line)
    if ir_untag(ty) == {
        .Result(_, err_ty) -> {
            // A kept `T Never!` carrier never holds an Err.
            if !ir_never_type(err_ty) {
                verdict :: ir_load_word(&m, &b, result, 0)
                zero :: ir_word_const(&m, &b, 0)
                failed :: ir_bool_op(&m, &b, IROp.Eq, verdict, zero)
                ir_open_if(&b.f, failed, b.line)
                err_row :: ir_value_type(&m, p, err_ty) ?? ir_pointer_row(&m)
                error :: ir_load_at(&m, &b, result, 8, err_row)
                if ir_default_err(p, err_ty) {
                    _ :: ir_runtime(&m, &b, "jet_rt_entry_error_exit_err", [Int]{error}, -1)
                } else {
                    text :: ir_render(&m, p, &b, err_ty, error, IRRender.Show, span)
                    _ :: ir_runtime(&m, &b, "jet_rt_entry_error_exit", [Int]{text}, -1)
                }
                ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
                ir_end(&b.f, b.line)
            }
        }
        .Option(_) -> {
            if m.types[row].kind != .Pointer -> ir_fail(&b, span, "an entry returning {ir_type_name(ty)}")
            null :: ir_temp_like(&m, &b, result)
            ir_emit(&b.f, IROp.Const, null, 0, -1, -1, b.line)
            absent :: ir_bool_op(&m, &b, IROp.Eq, result, null)
            ir_open_if(&b.f, absent, b.line)
            message :: ir_static_text(&m, &b, "entry returned no value")
            string_row :: ir_string_row(&m)
            text :: ir_runtime(&m, &b, "jet_rt_string_from_static", message, string_row)
            _ :: ir_runtime(&m, &b, "jet_rt_entry_error_exit", [Int]{text}, -1)
            ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
            ir_end(&b.f, b.line)
        }
        else -> {}
    }
    ir_release(&m, &b, result)
    ir_emit(&b.f, IROp.Return, -1, -1, -1, -1, b.line)
    if b.error != "" {
        &failures.push(IRBuildFailure{key: key, name: "entry", message: b.error, source_file: m.functions[entry].source_file, span: b.error_span})
    }
    ir_resolve_deferred(&m, p, &b)
    m.functions[id] = ^b.f
    id
}

// Builds every checked non-generic function (a library or a coverage
// census) on up to `threads` threads; generic functions are built per
// instance their callers reach.
fn ir_build_all(functions: ^[FnBody], type_defs: ^[TTypeDef], impls: ^[TImplDef], sources: ^[String:String], constants: ^[TConstantDef], foreign: ^[SemaCheckedForeignFunction], threads: CompilerThreads) -> IRBuildResult Never! {
    p := ir_program_new(^functions, ^type_defs, ^impls, ^sources, ^constants)
    ir_foreign_index(&p, ^foreign)
    roots := [IRWaveJob]{}
    loop row in 0..<p.functions.len() {
        if p.functions[row].generic_params.len() > 0 || ir_owner_binders(p, p.functions[row]).len() > 0 -> next
        &roots.push(IRWaveJob{key: p.functions[row].key.copy(), row: row, args: [Type]{}, lambda: -1, part: -1, local: -1})
    }
    ir_build_waves(^p, ^roots, false, threads)
}

// Builds the queued functions from queue row `from` on; returns the queue's end.
fn ir_build_queue(m: &IRModule, p: IRProgram, failures: &[IRBuildFailure], from: Int) -> Int Never! {
    cursor := from
    loop cursor < m.queue.len() {
        queued :: m.queue[cursor].copy()
        cursor += 1
        ir_build_queued(&m, p, &failures, queued)
    }
    m.subst_names = [String]{}
    m.subst_types = [Type]{}
    cursor
}

// Builds the body of one queued function (a checked function or instance,
// or a lambda job) into its row.
fn ir_build_queued(m: &IRModule, p: IRProgram, failures: &[IRBuildFailure], queued: IRQueued) Never! {
    b := ir_builder_new(m.functions[queued.id].copy())
    if queued.lambda >= 0 {
        job :: m.lambdas[queued.lambda].copy()
        m.subst_names = job.subst_names
        m.subst_types = job.subst_types
        b.row = job.row
        b.made = job.made
        b.next_node = job.next_node
        ir_build_lambda(&m, p, &b, job)
        if b.error != "" {
            &failures.push(IRBuildFailure{key: m.functions[queued.id].key, name: m.functions[queued.id].name, message: b.error, source_file: job.source_file, span: if b.error_span.end > 0 -> b.error_span else -> job.lambda.source_span})
        }
        ir_resolve_deferred(&m, p, &b)
        m.functions[queued.id] = ^b.f
        return
    }
    // copy: the checked function is read while later calls queue more rows.
    function :: p.functions[queued.row].copy()
    m.subst_names = if queued.args.len() > 0 -> ir_generic_names(p, function) else -> [String]{}
    m.subst_types = queued.args.copy()
    b.row = queued.row
    ir_build_function(&m, p, &b, function)
    if b.error != "" {
        &failures.push(IRBuildFailure{key: m.functions[queued.id].key, name: function.name, message: b.error, source_file: function.source_file, span: if b.error_span.end > 0 -> b.error_span else -> function.source_span})
    }
    ir_resolve_deferred(&m, p, &b)
    m.functions[queued.id] = ^b.f
}

fn ir_builder_new(f: ^IRFunction) -> IRBuilder Never! {
    IRBuilder{f: ^f, bindings: [IRBinding]{}, scopes: [Int]{}, loops: [IRLoopFrame]{}, fresh: [Bool]{}, subjects: [Int]{}, pending: [IRPending]{}, line: 0, error: "", error_span: Span{start: 0, end: 0}, ret: None, failure: TFailureCarrier.Infallible, plain: false, cells: [String]{}, deferred: [IRDeferredCall]{}, closes: [IRClose]{}, transactions: [IRTxFrame]{}, contracts: [IRContractFrame]{}, lambdas: [String:Int]{}}
}

// The first id of the nodes a builder makes itself (ir_node), far below the
// function-local ids the checker and tir_function_seal hand out.
IR_FIRST_NODE_ID :: -1099511627776

// The first index of the statements a builder makes itself (ir_stmt_node),
// far above any checked body's statement count.
IR_FIRST_STMT_INDEX :: 1099511627776

// Node `id`: a row of the builder's checked function tree, or a node the
// builder made (ir_node).
fn ir_body_node(p: IRProgram, b: IRBuilder, id: Int) -> BodyNode Never! {
    if id <= IR_FIRST_NODE_ID {
        loop node in b.made.nodes {
            if node.id == id -> return node.copy()
        }
        panic("{b.f.name}: builder node {id} was never made")
    }
    if b.row < 0 -> panic("{b.f.name}: node {id} read without a checked body")
    body_node(p.functions[b.row].tree, id)
}

// Statement `index`: a statement of the builder's checked function tree, or
// one the builder made (ir_stmt_node).
fn ir_body_stmt(p: IRProgram, b: IRBuilder, index: Int) -> StmtKind Never! {
    if index >= IR_FIRST_STMT_INDEX -> return b.made.stmts[index - IR_FIRST_STMT_INDEX].copy()
    if b.row < 0 -> panic("{b.f.name}: statement {index} read without a checked body")
    body_stmt(p.functions[b.row].tree, index)
}

// The checked type of `value`: its row in the expression-type column of the
// builder's checked function, or of the nodes the builder made (ir_node).
fn ir_ty(p: IRProgram, b: IRBuilder, value: Int) -> Type Never! {
    if value <= IR_FIRST_NODE_ID {
        loop row in b.made.expr_types {
            if row.id == value -> return row.ty.copy()
        }
    } else if b.row >= 0 {
        if tir_expr_type(p.functions[b.row].tree.expr_types, value) == .Val(ty) -> return ty
    }
    panic("{b.f.name}: node {value} has no expression-type row")
}

// A node the builder makes itself (a desugared step), typed `ty` under the
// next builder id.
fn ir_node(b: &IRBuilder, ty: Type, kind: NodeKind, span: Span) -> Int Never! {
    id :: b.next_node
    b.next_node -= 1
    &b.made.expr_types.push(TExprType{id: id, ty: ty})
    &b.made.nodes.push(BodyNode{id: id, kind: kind, span: span})
    id
}

// A statement the builder makes itself (a desugared step).
fn ir_stmt_node(b: &IRBuilder, statement: StmtKind) -> Int Never! {
    &b.made.stmts.push(statement)
    IR_FIRST_STMT_INDEX + b.made.stmts.len() - 1
}

fn ir_resolve_deferred(m: &IRModule, p: IRProgram, b: &IRBuilder) Never! {
    loop call in b.deferred {
        callee :: ir_function_id(&m, p, call.key, call.args) ?? -1
        if call.function >= 0 {
            m.functions[call.function].a[call.at] = callee
        } else {
            b.f.a[call.at] = callee
        }
    }
}

// A payload binding a condition introduces: `slot` (named `name`) receives
// the payload at byte `offset` of the carrier box `subject` once the test holds.
// `boxed`: the member at `offset` is a recursive edge's wrapper box holding the payload.
// `loaded`: an or-pattern already loaded `slot` in its matching alternative.
// `window`: the subject is a write window (`if &place == ...`), so the name
// binds the payload's storage and an assignment to it lands in the box.
struct IRPending { name: String, slot: Int, subject: Int, offset: Int, boxed: Bool{false}, loaded: Bool{false}, window: Bool{false} }

// Opens the If of a condition and binds its pending payloads in it.
fn ir_open_condition(m: &IRModule, p: IRProgram, b: &IRBuilder, test: Int) Never! {
    ir_open_if(&b.f, test, b.line)
    ir_bind_pending(&m, p, &b)
}

fn ir_bind_pending(m: &IRModule, p: IRProgram, b: &IRBuilder) Never! {
    pending :: b.pending
    b.pending = [IRPending]{}
    loop row in pending {
        // A window into a variable's own box writes a box only it holds
        // (Lower lower_box_make_unique); a copy sharing the box keeps its
        // payload. The subject is unique before any payload address is taken.
        if row.window && !row.loaded && ir_owned_binding(b, row.subject) -> ir_box_make_unique(&m, p, &b, row.subject)
    }
    loop row in pending {
        // An aggregate payload is already bound by address (ir_pending_load).
        row_type :: b.f.slot_type[row.slot]
        if row.window && !row.boxed && !row.loaded && m.types[row_type].kind != .Aggregate {
            pointer_row :: ir_pointer_row(&m)
            address :: ir_temp(&m, &b, pointer_row)
            ir_emit(&b.f, IROp.Offset, address, row.subject, row.offset, -1, b.line)
            &b.bindings.push(IRBinding{name: row.name, slot: address, indirect: row_type})
            next
        }
        if !row.loaded -> ir_pending_load(&m, &b, row, row.slot)
        &b.bindings.push(IRBinding{name: row.name, slot: row.slot, carrier: if row.boxed -> -1 else -> row.subject})
    }
}

// Marks the pending payload bindings from `from` on, those of a test on
// `subject`, as write windows when the subject is one (`&place`).
fn ir_pending_windows(p: IRProgram, b: &IRBuilder, subject: Int, from: Int) Never! {
    write := false
    if ir_body_node(p, b, subject).kind == .Borrow(_, access) -> write = access == .Write
    if !write -> return
    loop index in from..<b.pending.len() {
        row :: b.pending[index]
        b.pending[index] = IRPending{name: row.name.copy(), slot: row.slot, subject: row.subject, offset: row.offset, boxed: row.boxed, loaded: row.loaded, window: true}
    }
}

// Loads the payload `row` names into `slot`.
fn ir_pending_load(m: &IRModule, b: &IRBuilder, row: IRPending, slot: Int) Never! {
    op :: if m.types[b.f.slot_type[slot]].kind == .Aggregate -> IROp.Offset else -> IROp.Load
    if row.boxed {
        pointer_row :: ir_pointer_row(&m)
        wrapper :: ir_temp(&m, &b, pointer_row)
        ir_emit(&b.f, IROp.Load, wrapper, row.subject, row.offset, -1, b.line)
        ir_emit(&b.f, op, slot, wrapper, 0, -1, b.line)
    } else {
        ir_emit(&b.f, op, slot, row.subject, row.offset, -1, b.line)
    }
}

fn ir_fail(b: &IRBuilder, span: Span, message: String) Never! {
    if b.error != "" -> return
    b.error = message
    b.error_span = span
}

fn ir_failed(b: IRBuilder) -> Bool Never! { b.error != "" }

// Returns `slot` (-1: nothing) after dropping every owned variable. Code
// after the Return in the same block is dead, so the variables keep the
// ownership they had: the paths that go on past the enclosing branch see it.
fn ir_emit_return(m: &IRModule, b: &IRBuilder, slot: Int) Never! {
    states :: ir_own_states(b, b.bindings.len())
    if slot >= 0 {
        b.fresh[slot] = false
        // The returned value leaves with the caller; its variable keeps nothing.
        ir_disown(&b, slot)
    }
    ir_close_disarm(&b, slot)
    ir_drop_bindings(&m, &b, 0)
    ir_emit(&b.f, IROp.Return, -1, slot, -1, -1, b.line)
    ir_set_own_states(&b, states)
}

// Drops the owned variables among bindings[mark..], latest first; a
// variable that still owns a value that closes closes it first.
fn ir_drop_bindings(m: &IRModule, b: &IRBuilder, mark: Int) Never! {
    index := b.bindings.len() - 1
    loop index >= mark {
        binding :: b.bindings[index]
        index -= 1
        if binding.indirect < 0 -> ir_close_now(&b, binding.slot)
        if !binding.owned -> next
        ir_drop_binding(&m, &b, binding)
    }
}

// Drops the value the owned variable `binding` holds; one some paths moved
// drops only where its live flag holds.
fn ir_drop_binding(m: &IRModule, b: &IRBuilder, binding: IRBinding) Never! {
    if binding.live >= 0 -> ir_open_if(&b.f, binding.live, b.line)
    value :: ir_read_binding(&m, &b, binding)
    ir_emit(&b.f, IROp.Drop, -1, value, -1, -1, b.line)
    if binding.live >= 0 -> ir_end(&b.f, b.line)
}

// `slot` as a value its new holder owns: a fresh value moves; a variable's
// own aggregate moves (the variable stops owning it, and the slot reads as
// fresh to the holder that stores it); an aggregate another holder keeps
// is shared (a byte copy whose buffers gain an owner, ir_copy_value); any
// other read of a place another holder keeps is copied through its type's
// runtime clone. A value with a drop and no clone (a file or socket handle)
// moves: the variable it is read from stops owning it, so its scope-end
// drop cannot release what the new holder keeps (Lower's moved-binding
// drop flag).
fn ir_own(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int) -> Int Never! {
    if slot < 0 || b.fresh[slot] || !ir_has_drop(m, b, slot) -> return slot
    row :: b.f.slot_type[slot]
    if m.types[row].kind == .Aggregate && m.types[row].drop == ir_drop_key(m, row) {
        if ir_movable_binding(b, slot) {
            ir_disown(&b, slot)
            b.fresh[slot] = true
            return slot
        }
        return ir_copy_value(&m, p, &b, slot, Span{start: 0, end: 0})
    }
    symbol :: m.types[row].clone
    if symbol == "" {
        ir_disown(&b, slot)
        return slot
    }
    ir_clone(&m, &b, slot, row)
}

// Whether a variable owns the value in `slot` (its own storage) on every
// path that reaches here.
fn ir_owned_binding(b: IRBuilder, slot: Int) -> Bool Never! {
    ir_owned_binding_index(b, slot) >= 0
}

fn ir_owned_binding_index(b: IRBuilder, slot: Int) -> Int Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        binding :: b.bindings[index]
        if binding.slot == slot && binding.indirect < 0 && binding.owned && binding.live < 0 -> return index
        index -= 1
    }
    -1
}

// The live flag of the variable owning `slot` where only some paths kept
// its value (-1: none).
fn ir_live_flag(b: IRBuilder, slot: Int) -> Int Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        binding :: b.bindings[index]
        if binding.slot == slot && binding.indirect < 0 && binding.owned -> return binding.live
        index -= 1
    }
    -1
}

// Whether a read of the variable owning `slot` may move its value to a new
// holder: only an explicit `^x` does. Sema does not mark a plain read as a
// last use (`sym(Item.F{value: f})` followed by a read of `f` is a plain
// read too), so a plain read shares: a byte copy whose buffers and boxes
// gain an owner, which the variable's own scope-end drop gives back.
fn ir_movable_binding(b: IRBuilder, slot: Int) -> Bool Never! {
    if ir_owned_binding_index(b, slot) < 0 -> return false
    b.moving == slot
}

// The owned variables whose value is in `slot` no longer own it.
fn ir_disown(b: &IRBuilder, slot: Int) Never! {
    loop index in 0..<b.bindings.len() {
        binding :: b.bindings[index]
        if binding.slot != slot || binding.indirect >= 0 || !binding.owned -> next
        b.bindings[index] = IRBinding{name: binding.name.copy(), slot: binding.slot, indirect: binding.indirect, owned: false, symbol: binding.symbol.copy(), write: binding.write, carrier: binding.carrier}
    }
}

// The variable `binding` names owns the value in its slot again (a move
// out of it was followed by an assignment), on every path.
fn ir_reown(b: &IRBuilder, binding: IRBinding) Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        row :: b.bindings[index]
        if row.slot == binding.slot && row.indirect < 0 && row.name == binding.name {
            ir_set_own_state(&b, index, IROwnState{owned: true})
            return
        }
        index -= 1
    }
}

// A variable's ownership on one path: whether it owns its value, and its
// live flag (IRBinding.live).
struct IROwnState { owned: Bool, live: Int{-1} }

// The ownership of the variables bound before `count`.
fn ir_own_states(b: IRBuilder, count: Int) -> [IROwnState] Never! {
    states := [IROwnState]{}
    loop index in 0..<count {
        &states.push(IROwnState{owned: b.bindings[index].owned, live: b.bindings[index].live})
    }
    states
}

fn ir_set_own_state(b: &IRBuilder, index: Int, state: IROwnState) Never! {
    row :: b.bindings[index]
    if row.owned == state.owned && row.live == state.live -> return
    b.bindings[index] = IRBinding{name: row.name.copy(), slot: row.slot, indirect: row.indirect, owned: state.owned, symbol: row.symbol.copy(), write: row.write, carrier: row.carrier, live: state.live}
}

// Restores the ownership `states` of the variables bound before it.
fn ir_set_own_states(b: &IRBuilder, states: [IROwnState]) Never! {
    loop index in 0..<states.len() {
        if index >= b.bindings.len() -> break
        ir_set_own_state(&b, index, states[index])
    }
}

// Where the two paths of an If on `test` meet: the bindings hold the else
// path's ownership, `then_states` the then path's. A path that leaves passes
// the other's ownership on unchanged.
fn ir_meet_paths(m: &IRModule, b: &IRBuilder, test: Int, then_states: [IROwnState], then_leaves: Bool, else_leaves: Bool) Never! {
    if else_leaves -> return ir_set_own_states(&b, then_states)
    if then_leaves -> return
    else_states :: ir_own_states(b, then_states.len())
    ir_join_owned(&m, &b, test, then_states, else_states)
}

// A variable one path moved and the other kept still owns its value
// through a live flag each path sets, which its drop tests (Lower's
// moved-binding drop flag).
fn ir_join_owned(m: &IRModule, b: &IRBuilder, test: Int, then_states: [IROwnState], else_states: [IROwnState]) Never! {
    joined := [Int]{}
    loop index in 0..<then_states.len() {
        if index >= b.bindings.len() -> break
        kept :: then_states[index]
        other :: else_states[index]
        if kept.owned == other.owned && kept.live == other.live {
            ir_set_own_state(&b, index, kept)
        } else if !kept.owned && !other.owned {
            ir_set_own_state(&b, index, IROwnState{owned: false})
        } else {
            &joined.push(index)
        }
    }
    if joined.len() == 0 -> return
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    lives := [Int]{}
    loop _ in joined -> &lives.push(ir_temp(&m, &b, bool_row))
    ir_open_if(&b.f, test, b.line)
    loop (at, index) in joined -> ir_live_set(&b, lives[at], then_states[index])
    ir_else(&b.f, b.line)
    loop (at, index) in joined -> ir_live_set(&b, lives[at], else_states[index])
    ir_end(&b.f, b.line)
    loop (at, index) in joined -> ir_set_own_state(&b, index, IROwnState{owned: true, live: lives[at]})
}

// Sets the live flag `live` to whether a variable in `state` holds its value.
fn ir_live_set(b: &IRBuilder, live: Int, state: IROwnState) Never! {
    if state.owned && state.live >= 0 {
        ir_emit(&b.f, IROp.Copy, live, state.live, -1, -1, b.line)
    } else {
        ir_emit(&b.f, IROp.Const, live, if state.owned -> 1 else -> 0, -1, -1, b.line)
    }
}

// The storage at `address` now holds the bytes of the aggregate `value`
// and owns them: a fresh value or a variable's own value moves there (the
// variable stops owning it); any other holder's value is shared, its
// buffers gaining an owner (ir_copy_fixup).
fn ir_aggregate_take(m: &IRModule, p: IRProgram, b: &IRBuilder, value: Int, address: Int) Never! {
    if b.fresh[value] {
        b.fresh[value] = false
        return
    }
    if ir_movable_binding(b, value) -> return ir_disown(&b, value)
    row :: b.f.slot_type[value]
    ir_copy_fixup(&m, p, &b, row, address)
}

// The most instructions one function's build may emit. A build that passes
// it fails like any unsupported construct (its function is not built and
// the census records it) instead of growing until the process dies.
IR_BUILD_INSTRUCTION_BUDGET :: 1000000

fn ir_new_slot(b: &IRBuilder, ty: Int, kind: IRSlotKind, name: Int) -> Int Never! {
    emitted :: b.f.op.len()
    if emitted > IR_BUILD_INSTRUCTION_BUDGET -> ir_fail(&b, Span{start: 0, end: 0}, "budget exceeded: {emitted} instructions (budget {IR_BUILD_INSTRUCTION_BUDGET})")
    &b.fresh.push(false)
    ir_slot(&b.f, ty, kind, name, b.line)
}

fn ir_temp(m: &IRModule, b: &IRBuilder, ty: Int) -> Int Never! {
    ir_new_slot(&b, ty, IRSlotKind.Temp, -1)
}

fn ir_fresh_temp(m: &IRModule, b: &IRBuilder, ty: Int) -> Int Never! {
    slot :: ir_temp(&m, &b, ty)
    b.fresh[slot] = true
    slot
}
// A temporary of `slot`'s type.
fn ir_temp_like(m: &IRModule, b: &IRBuilder, slot: Int) -> Int Never! {
    ty :: b.f.slot_type[slot]
    ir_temp(&m, &b, ty)
}

fn ir_fresh_like(m: &IRModule, b: &IRBuilder, slot: Int) -> Int Never! {
    ty :: b.f.slot_type[slot]
    ir_fresh_temp(&m, &b, ty)
}

fn ir_kind_of(m: IRModule, b: IRBuilder, slot: Int) -> IRTypeKind Never! {
    m.types[b.f.slot_type[slot]].kind
}

fn ir_has_drop(m: IRModule, b: IRBuilder, slot: Int) -> Bool Never! {
    m.types[b.f.slot_type[slot]].drop != ""
}

// Drops `slot` when it is a fresh temporary of a type with a drop.
fn ir_release(m: &IRModule, b: &IRBuilder, slot: Int) Never! {
    if slot < 0 || !b.fresh[slot] -> return
    if ir_has_drop(m, b, slot) -> ir_emit(&b.f, IROp.Drop, -1, slot, -1, -1, b.line)
    b.fresh[slot] = false
}

// ---------------------------------------------------------------------------
// Names and scopes.

fn ir_scope_open(b: &IRBuilder) Never! {
    &b.scopes.push(b.bindings.len())
}

// Closes the innermost scope: its owned variables are dropped, latest first.
fn ir_scope_close(m: &IRModule, b: &IRBuilder) Never! {
    mark :: &b.scopes.pop() ?? 0
    ir_drop_bindings(&m, &b, mark)
    loop b.bindings.len() > mark {
        _ :: &b.bindings.pop()
    }
}

fn ir_lookup(b: IRBuilder, name: String) -> Int? Never! {
    binding :: ir_lookup_binding(b, name) ?? return None
    Val(binding.slot)
}

fn ir_lookup_binding(b: IRBuilder, name: String) -> IRBinding? Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        if b.bindings[index].name == name -> return Val(b.bindings[index].copy())
        index -= 1
    }
    None
}

// The binding a read of `local` names: the variable of its checked symbol
// when it has one (a default argument reads an earlier argument's pin
// under the parameter's name), else the latest of its name.
fn ir_lookup_local(b: IRBuilder, local: TLocal) -> IRBinding? Never! {
    if local.symbol_id == .Val(symbol) {
        index := b.bindings.len() - 1
        loop index >= 0 {
            if b.bindings[index].symbol == symbol.key -> return Val(b.bindings[index].copy())
            index -= 1
        }
    }
    ir_lookup_binding(b, local.name)
}

// The value of a visible variable: a write parameter's is read through its address.
fn ir_read_binding(m: &IRModule, b: &IRBuilder, binding: IRBinding) -> Int Never! {
    if binding.indirect < 0 -> return binding.slot
    value :: ir_temp(&m, &b, binding.indirect)
    ir_emit(&b.f, IROp.Load, value, binding.slot, 0, -1, b.line)
    value
}

// Writes `value` into `slot`: a move for a type with a drop, else a copy.
fn ir_store(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int, value: Int) Never! {
    ir_close_disarm(&b, value)
    if ir_kind_of(m, b, value) == .Aggregate && !b.fresh[value] {
        // An aggregate read from another place gets storage of its own.
        value_row :: b.f.slot_type[value]
        row :: m.types[value_row]
        ir_emit(&b.f, IROp.StackAddress, slot, row.size, row.align, -1, b.line)
        ir_emit(&b.f, IROp.CopyBytes, -1, slot, value, row.size, b.line)
        ir_aggregate_take(&m, p, &b, value, slot)
        return
    }
    owned :: ir_own(&m, p, &b, value)
    op :: if ir_has_drop(m, b, owned) || ir_kind_of(m, b, owned) == .Aggregate -> IROp.Move else -> IROp.Copy
    ir_emit(&b.f, op, slot, owned, -1, -1, b.line)
    b.fresh[owned] = false
}

// `Br` out of the Block `exit` unless `test` holds.
fn ir_exit_unless(m: &IRModule, b: &IRBuilder, test: Int, exit: Int) Never! {
    negated :: ir_temp_like(&m, &b, test)
    ir_emit(&b.f, IROp.Not, negated, test, -1, -1, b.line)
    depth :: ir_depth(b.f, exit)
    ir_emit(&b.f, IROp.BrIf, -1, negated, depth, -1, b.line)
}

fn ir_fail_slot(b: &IRBuilder, span: Span, message: String) -> Int Never! {
    ir_fail(&b, span, message)
    return -1
}

fn ir_type_fail(b: &IRBuilder, span: Span, ty: Type) -> Int Never! {
    ir_fail_slot(&b, span, "type {ir_type_name(ty)}")
}

// A runtime route call with a fresh result of type row `ty` (-1: none).
fn ir_runtime(m: &IRModule, b: &IRBuilder, symbol: String, args: [Int], ty: Int) -> Int Never! {
    dst :: if ty >= 0 -> ir_fresh_temp(&m, &b, ty) else -> -1
    start :: ir_args(&b.f, args)
    ir_emit(&b.f, IROp.CallRuntime, dst, ir_intern_name(&m, symbol), start, args.len(), b.line)
    dst
}

// The static text pair (data address, byte length) of `text`.
fn ir_static_text(m: &IRModule, b: &IRBuilder, text: String) -> [Int] Never! {
    pointer_row :: ir_pointer_row(&m)
    pointer :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.DataAddress, pointer, ir_intern_text(&m, text), -1, -1, b.line)
    word_row :: ir_word_row(&m)
    length :: ir_temp(&m, &b, word_row)
    ir_emit(&b.f, IROp.Const, length, text.bytes().len(), -1, -1, b.line)
    [Int]{pointer, length}
}

fn ir_pointer_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "pointer", ir_layout(IRTypeKind.Pointer, Type.Named{name: "Pointer"}, 8, 8, IRClass.Pointer, false, 64, ""))
}

fn ir_word_row(m: &IRModule) -> Int Never! {
    ir_type_row(&m, Type.IntN{signed: true, bits: 64}) ?? 0
}

fn ir_string_row(m: &IRModule) -> Int Never! {
    ir_type_row(&m, Type.String) ?? 0
}

// A source location argument triple: (path address, path length, line), as
// lower_location passes it.
fn ir_location(m: &IRModule, b: &IRBuilder, line: Int) -> [Int] Never! {
    path :: b.f.source_file
    args := ir_static_text(&m, &b, path)
    word_row :: ir_word_row(&m)
    slot :: ir_temp(&m, &b, word_row)
    ir_emit(&b.f, IROp.Const, slot, line, -1, -1, b.line)
    &args.push(slot)
    args
}

// A member of the aggregate at `base`: a nested aggregate is its address,
// a scalar a load (not owned: the aggregate keeps it); a recursive edge is
// read through its wrapper box.
fn ir_member_read(m: &IRModule, b: &IRBuilder, base: Int, member: IRMember) -> Int Never! {
    holder := base
    offset := member.offset
    if member.boxed {
        pointer_row :: ir_pointer_row(&m)
        holder = ir_temp(&m, &b, pointer_row)
        ir_emit(&b.f, IROp.Load, holder, base, member.offset, -1, b.line)
        offset = 0
    }
    slot :: ir_temp(&m, &b, member.ty)
    if m.types[member.ty].kind == .Aggregate {
        ir_emit(&b.f, IROp.Offset, slot, holder, offset, -1, b.line)
    } else {
        ir_emit(&b.f, IROp.Load, slot, holder, offset, -1, b.line)
    }
    slot
}

// Writes `value` into the member of the aggregate at `base`; a recursive
// edge gets a wrapper box of its own. A variable's value moved in here is
// no longer closed by its scope: the aggregate closes it.
fn ir_member_write(m: &IRModule, p: IRProgram, b: &IRBuilder, base: Int, member: IRMember, value: Int) Never! {
    ir_close_disarm(&b, value)
    holder := base
    offset := member.offset
    if member.boxed {
        pointer_row :: ir_pointer_row(&m)
        size :: m.types[member.ty].size
        holder = ir_box_alloc(&m, &b, if size < 8 -> 8 else -> size, pointer_row)
        ir_emit(&b.f, IROp.Store, -1, base, member.offset, holder, b.line)
        offset = 0
    }
    if m.types[member.ty].kind == .Aggregate {
        address :: ir_temp(&m, &b, member.ty)
        ir_emit(&b.f, IROp.Offset, address, holder, offset, -1, b.line)
        ir_emit(&b.f, IROp.CopyBytes, -1, address, value, m.types[member.ty].size, b.line)
        ir_aggregate_take(&m, p, &b, value, address)
        return
    }
    owned :: ir_own(&m, p, &b, value)
    ir_emit(&b.f, IROp.Store, -1, holder, offset, owned, b.line)
    b.fresh[owned] = false
}

// The member `name` of the struct an aggregate slot holds.
fn ir_member_of(m: &IRModule, p: IRProgram, b: IRBuilder, base: Int, name: String) -> IRMember? Never! {
    ty :: ir_untag(m.types[b.f.slot_type[base]].ty)
    members := [IRMember]{}
    if ty == .Tuple(fields) {
        members = ir_tuple_members(&m, p, fields) ?? return None
    } else {
        nominal :: ir_nominal_name(ty) ?? return None
        row :: ir_type_def(p, nominal) ?? return None
        members = ir_struct_members(&m, p, row, ir_type_args(ty)) ?? return None
    }
    loop member in members {
        if member.name == name -> return Val(member)
    }
    None
}

fn ir_truncate_bindings(b: &IRBuilder, mark: Int) Never! {
    loop b.bindings.len() > mark {
        _ :: &b.bindings.pop()
    }
}

// A Bool slot: whether the Result box `value` holds Ok (selector word 1).
fn ir_result_is_ok(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    word :: ir_word_row(&m)
    selector :: ir_temp(&m, &b, word)
    ir_emit(&b.f, IROp.Load, selector, value, 0, -1, b.line)
    one :: ir_temp(&m, &b, word)
    ir_emit(&b.f, IROp.Const, one, 1, -1, -1, b.line)
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    test :: ir_temp(&m, &b, bool_row)
    ir_emit(&b.f, IROp.Eq, test, selector, one, -1, b.line)
    test
}

// The discriminant of an enum value: a payload-free enum is its variant
// index, a payload enum's box holds it at 0.
fn ir_enum_tag_of(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    if m.types[b.f.slot_type[value]].kind != .Pointer -> return value
    ir_load_word(&m, &b, value, 0)
}

// Writes `value` into member `member` of the storage at `base`; a recursive
// edge gets a wrapper box of its own.
fn ir_member_store(m: &IRModule, p: IRProgram, b: &IRBuilder, base: Int, member: IRMember, value: Int) Never! {
    if !member.boxed -> return ir_store_at(&m, p, &b, base, member.offset, value)
    size :: m.types[member.ty].size
    pointer_row :: ir_pointer_row(&m)
    wrapper :: ir_box_alloc(&m, &b, size, pointer_row)
    ir_store_at(&m, p, &b, wrapper, 0, value)
    ir_emit(&b.f, IROp.Store, -1, base, member.offset, wrapper, b.line)
}

// The value of member `member` of the storage at `base` (through its
// wrapper box for a recursive edge; -1 for Unit).
fn ir_member_value(m: &IRModule, b: &IRBuilder, base: Int, member: IRMember) -> Int Never! {
    if !member.boxed -> return ir_load_at(&m, &b, base, member.offset, member.ty)
    pointer_row :: ir_pointer_row(&m)
    wrapper :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.Load, wrapper, base, member.offset, -1, b.line)
    ir_load_at(&m, &b, wrapper, 0, member.ty)
}

fn ir_word_const(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    word_row :: ir_word_row(&m)
    slot :: ir_temp(&m, &b, word_row)
    ir_emit(&b.f, IROp.Const, slot, value, -1, -1, b.line)
    slot
}

// A wrapping native word operation (addresses, counts, indexes).
fn ir_word_op(m: &IRModule, b: &IRBuilder, op: IROp, left: Int, right: Int) -> Int Never! {
    word_row :: ir_word_row(&m)
    slot :: ir_temp(&m, &b, word_row)
    ir_emit(&b.f, op, slot, left, right, IR_OVERFLOW_WRAP, b.line)
    slot
}

fn ir_bool_op(m: &IRModule, b: &IRBuilder, op: IROp, left: Int, right: Int) -> Int Never! {
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    slot :: ir_temp(&m, &b, bool_row)
    ir_emit(&b.f, op, slot, left, right, -1, b.line)
    slot
}

fn ir_load_word(m: &IRModule, b: &IRBuilder, base: Int, offset: Int) -> Int Never! {
    word_row :: ir_word_row(&m)
    slot :: ir_temp(&m, &b, word_row)
    ir_emit(&b.f, IROp.Load, slot, base, offset, -1, b.line)
    slot
}

// Heap storage of `size` bytes (Lower lower_alloc_bytes: jet_rt_alloc(bytes, 8)).
fn ir_box_alloc(m: &IRModule, b: &IRBuilder, size: Int, row: Int) -> Int Never! {
    bytes :: ir_word_const(&m, &b, ir_align8(size))
    align :: ir_word_const(&m, &b, 8)
    boxed :: ir_runtime(&m, &b, "jet_rt_alloc", [Int]{bytes, align}, row)
    b.fresh[boxed] = m.types[row].drop != ""
    boxed
}

// A List buffer of exactly `bytes` bytes (jet_rt_alloc(bytes, 8)). Unlike a
// box it is not rounded up: every List buffer is released as capacity *
// stride (the List drop, ir_release_moved_buffer), and a free must name the
// allocation's own size.
fn ir_list_buffer_alloc(m: &IRModule, b: &IRBuilder, bytes: Int) -> Int Never! {
    word_row :: ir_word_row(&m)
    size :: ir_word_const(&m, &b, bytes)
    align :: ir_word_const(&m, &b, 8)
    ir_runtime(&m, &b, "jet_rt_alloc", [Int]{size, align}, word_row)
}

// Writes `value` at byte `offset` of the storage at `base`: an aggregate's
// bytes are copied, a Unit value takes no bytes.
fn ir_store_at(m: &IRModule, p: IRProgram, b: &IRBuilder, base: Int, offset: Int, value: Int) Never! {
    if value < 0 -> return
    kind :: ir_kind_of(m, b, value)
    if kind == .Unit -> return
    ir_close_disarm(&b, value)
    if kind == .Aggregate {
        address :: ir_temp_like(&m, &b, value)
        ir_emit(&b.f, IROp.Offset, address, base, offset, -1, b.line)
        value_row :: b.f.slot_type[value]
        size :: m.types[value_row].size
        ir_emit(&b.f, IROp.CopyBytes, -1, address, value, size, b.line)
        ir_aggregate_take(&m, p, &b, value, address)
        return
    }
    owned :: ir_own(&m, p, &b, value)
    ir_emit(&b.f, IROp.Store, -1, base, offset, owned, b.line)
    b.fresh[owned] = false
}

// The value of type row `row` at byte `offset` of the storage at `base`
// (an aggregate is its address there; -1 for Unit).
fn ir_load_at(m: &IRModule, b: &IRBuilder, base: Int, offset: Int, row: Int) -> Int Never! {
    kind :: m.types[row].kind
    if kind == .Unit -> return -1
    slot :: ir_temp(&m, &b, row)
    ir_emit(&b.f, if kind == .Aggregate -> IROp.Offset else -> IROp.Load, slot, base, offset, -1, b.line)
    slot
}

// A new Result box of type `ty` holding `payload` (-1: Unit) as Ok or Err
// (Lower lower_result_box; an Ok(()) payload word is 0).
fn ir_result_box(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, success: Bool, payload: Int) -> Int Never! {
    line :: b.line
    row :: ir_value_type(&m, p, ty) ?? ir_pointer_row(&m)
    widest := 0
    if ir_untag(ty) == .Result(ok_ty, err_ty) {
        ok_size :: ir_type_size(&m, p, ok_ty)
        err_size :: ir_type_size(&m, p, err_ty)
        widest = ir_align8(if ok_size > err_size -> ok_size else -> err_size)
    }
    boxed :: ir_box_alloc(&m, &b, 8 + ir_align8(widest), row)
    selector :: ir_word_const(&m, &b, if success -> 1 else -> 0)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, selector, line)
    if payload >= 0 {
        ir_store_at(&m, p, &b, boxed, 8, payload)
    } else {
        zero :: ir_word_const(&m, &b, 0)
        ir_emit(&b.f, IROp.Store, -1, boxed, 8, zero, line)
    }
    boxed
}

// `expression` as a value of type row `row`: a plain `T Never!` call result
// is boxed into `Ok` where its carrier is wanted, and a Result box is
// unwrapped where its plain success is (codegen
// jet_codegen_reconcile_plain_call_return, jet_codegen_lower_return_value).
fn ir_value_as(m: &IRModule, p: IRProgram, b: &IRBuilder, expression: Int, row: Int, span: Span) -> Int Never! {
    if !ir_is_result(m.types[row].ty) {
        if ir_body_node(p, b, expression).kind == .Ok(inner) -> return ir_value_as(&m, p, &b, inner, row, span)
    }
    slot :: ir_expr(&m, p, &b, expression)
    if ir_failed(b) || slot < 0 -> return slot
    ir_adapt(&m, p, &b, slot, row, span)
}

fn ir_adapt(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int, row: Int, span: Span) -> Int Never! {
    have :: b.f.slot_type[slot]
    if have == row -> return slot
    // A function value standing for its fallible or infallible form returns
    // through a converting closure (BuildRoutes ir_fn_widen).
    if ir_fn_widens(m, have, row) -> return ir_fn_widen(&m, p, &b, slot, row, span)
    // A `Never` value (a call that does not return, as `?? fatal()`) ends
    // the path; what follows is unreached.
    if ir_never_type(m.types[have].ty) {
        ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
        target_ty :: m.types[row].ty
        return ir_unreachable_value(&m, p, &b, target_ty)
    }
    want_box :: ir_is_result(m.types[row].ty)
    have_box :: ir_is_result(m.types[have].ty)
    if want_box && !have_box {
        target :: m.types[row].ty
        return ir_result_box(&m, p, &b, target, true, slot)
    }
    if have_box && !want_box {
        // A fresh Result box hands its payload over (ir_box_take).
        if b.fresh[slot] -> return ir_box_take(&m, p, &b, slot, 8, row)
        return ir_load_at(&m, &b, slot, 8, row)
    }
    // A Result box of another size (an Ok or Err payload narrower or wider)
    // is reboxed: a box is freed with its own type's size (ir_box_bytes).
    if have_box && want_box && ir_box_bytes(&m, p, have) != ir_box_bytes(&m, p, row) -> return ir_result_rebox(&m, p, &b, slot, row, span)
    // A member value where its structural union is wanted (a `[A | B]`
    // literal's element) is boxed as that member's variant (widen_to_union).
    union_ty :: m.types[row].ty
    member_ty :: m.types[have].ty
    if ir_untag(union_ty) == .Union(_) {
        widens := true
        if ir_untag(member_ty) == .Union(_) -> widens = false
        if widens -> return ir_union_box(&m, p, &b, slot, member_ty, union_ty, span)
    }
    if m.types[have].kind == m.types[row].kind && m.types[have].size == m.types[row].size -> return slot
    ir_fail_slot(&b, span, "a value of {ir_type_name(m.types[have].ty)} where {ir_type_name(m.types[row].ty)} is expected")
}

// The Result box `slot` as a new box of the Result row `row`: the selector
// word and the Ok or Err payload (adapted to `row`'s) move over; a fresh
// `slot` is released with its own size.
fn ir_result_rebox(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int, row: Int, span: Span) -> Int Never! {
    have_raw :: m.types[b.f.slot_type[slot]].ty
    want_raw :: m.types[row].ty
    have_ty :: ir_untag(have_raw)
    want_ty :: ir_untag(want_raw)
    from := [Type]{}
    to := [Type]{}
    if have_ty == .Result(ok, err) -> from = [Type]{ok.copy(), err.copy()}
    if want_ty == .Result(ok, err) -> to = [Type]{ok.copy(), err.copy()}
    if from.len() != 2 || to.len() != 2 -> return ir_fail_slot(&b, span, "a value of {ir_type_name(have_raw)} where {ir_type_name(want_raw)} is expected")
    boxed :: ir_result_box(&m, p, &b, want_raw, true, -1)
    selector :: ir_load_word(&m, &b, slot, 0)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, selector, b.line)
    is_ok :: ir_result_is_ok(&m, &b, slot)
    ir_open_if(&b.f, is_ok, b.line)
    loop side in 0..<2 {
        if side == 1 -> ir_else(&b.f, b.line)
        // A `Never` side (an `Err(e)` literal's Ok) is never selected.
        if ir_never_type(from[side]) {
            ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
            next
        }
        from_row :: ir_value_type(&m, p, from[side]) ?? return ir_type_fail(&b, span, from[side])
        to_row :: ir_value_type(&m, p, to[side]) ?? return ir_type_fail(&b, span, to[side])
        payload :: ir_load_at(&m, &b, slot, 8, from_row)
        if payload >= 0 {
            moved :: if from_row == to_row -> payload else -> ir_adapt(&m, p, &b, payload, to_row, span)
            if ir_failed(b) -> return -1
            ir_store_at(&m, p, &b, boxed, 8, moved)
        } else if m.types[to_row].kind != .Unit {
            return ir_fail_slot(&b, span, "a Unit payload where {ir_type_name(to[side])} is expected")
        }
    }
    ir_end(&b.f, b.line)
    ir_release(&m, &b, slot)
    b.fresh[boxed] = true
    boxed
}

fn ir_option_is_some(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    null :: ir_temp_like(&m, &b, value)
    ir_emit(&b.f, IROp.Const, null, 0, -1, -1, b.line)
    ir_bool_op(&m, &b, IROp.Ne, value, null)
}

// The address of element `index` (a native word) of the buffer `data`.
fn ir_element_address(m: &IRModule, b: &IRBuilder, data: Int, index: Int, stride: Int) -> Int Never! {
    width :: ir_word_const(&m, &b, stride)
    offset :: ir_word_op(&m, &b, IROp.Mul, index, width)
    ir_word_op(&m, &b, IROp.Add, data, offset)
}

// An open walk over a list: its native index and the element at it.
struct IRWalk { index: Int, item: Int }

// Opens a loop over the elements of the list at `list` in order;
// ir_walk_close advances and closes it.
fn ir_walk_open(m: &IRModule, b: &IRBuilder, list: Int, row: Int) -> IRWalk Never! {
    stride :: ir_list_stride(m, row)
    length :: ir_load_word(&m, &b, list, 0)
    data :: ir_load_word(&m, &b, list, 16)
    index :: ir_word_const(&m, &b, 0)
    exit :: ir_open(&b.f, IROp.Block, b.line)
    _ :: ir_open(&b.f, IROp.Loop, b.line)
    more :: ir_bool_op(&m, &b, IROp.Lt, index, length)
    ir_exit_unless(&m, &b, more, exit)
    address :: ir_element_address(&m, &b, data, index, stride)
    item :: ir_load_at(&m, &b, address, 0, row)
    IRWalk{index: index, item: item}
}

fn ir_walk_close(m: &IRModule, b: &IRBuilder, walk: IRWalk) Never! {
    one :: ir_word_const(&m, &b, 1)
    ir_emit(&b.f, IROp.Add, walk.index, walk.index, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
}

// A List of the element slots `elements` in fresh frame storage.
fn ir_list_from(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int, element_row: Int, elements: [Int]) -> Int Never! {
    stride :: ir_list_stride(m, element_row)
    storage :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, storage, 24, 8, -1, b.line)
    count :: ir_word_const(&m, &b, elements.len())
    ir_emit(&b.f, IROp.Store, -1, storage, 0, count, b.line)
    ir_emit(&b.f, IROp.Store, -1, storage, 8, count, b.line)
    if elements.len() == 0 {
        none :: ir_word_const(&m, &b, 0)
        ir_emit(&b.f, IROp.Store, -1, storage, 16, none, b.line)
        return storage
    }
    data :: ir_list_buffer_alloc(&m, &b, elements.len() * stride)
    loop (index, slot) in elements -> ir_store_at(&m, p, &b, data, index * stride, slot)
    ir_emit(&b.f, IROp.Store, -1, storage, 16, data, b.line)
    storage
}

// An exact Int list position as a native word (jet_int_owned_to_i64).
fn ir_native_index(m: &IRModule, b: &IRBuilder, position: Int, span: Span) -> Int Never! {
    kind :: ir_kind_of(m, b, position)
    if kind == .Int {
        word_row :: ir_word_row(&m)
        return ir_runtime(&m, &b, "jet_int_owned_to_i64", [Int]{position}, word_row)
    }
    row :: m.types[b.f.slot_type[position]]
    if kind == .Word && row.size == 8 -> return position
    ir_fail_slot(&b, span, "list position of {row.ty}")
}

// The address of element `index` of the list at `list`, after the bounds
// check (jet_rt_panic_list_bounds(length, index)).
fn ir_checked_element(m: &IRModule, p: IRProgram, b: &IRBuilder, list: Int, index: Int, row: Int, span: Span) -> Int Never! {
    position :: ir_expr(&m, p, &b, index)
    if ir_failed(b) || position < 0 -> return -1
    native :: ir_native_index(&m, &b, position, span)
    if ir_failed(b) -> return -1
    ir_checked_address(&m, &b, list, native, row)
}

// The address of element `native` (a native word) of the list at `list`,
// after the bounds check.
fn ir_checked_address(m: &IRModule, b: &IRBuilder, list: Int, native: Int, row: Int) -> Int Never! {
    length :: ir_load_word(&m, &b, list, 0)
    zero :: ir_word_const(&m, &b, 0)
    bad :: ir_bool_op(&m, &b, IROp.Ge, native, length)
    negative :: ir_bool_op(&m, &b, IROp.Lt, native, zero)
    ir_open_if(&b.f, negative, b.line)
    ir_emit(&b.f, IROp.Const, bad, 1, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_open_if(&b.f, bad, b.line)
    _ :: ir_runtime(&m, &b, "jet_rt_panic_list_bounds", [Int]{length, native}, -1)
    ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
    ir_end(&b.f, b.line)
    data :: ir_load_word(&m, &b, list, 16)
    stride :: ir_list_stride(m, row)
    ir_element_address(&m, &b, data, native, stride)
}

// A copy of the value in `slot` that owns its own storage: a value with a
// runtime clone through it, an aggregate byte for byte with every buffer and
// cloned part of its own at any depth (BuildOwn.jet ir_copy_fixup).
fn ir_copy_value(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int, span: Span) -> Int Never! {
    row :: b.f.slot_type[slot]
    kind :: m.types[row].kind
    clone :: m.types[row].clone
    ir_close_disarm(&b, slot)
    if clone != "" -> return ir_clone(&m, &b, slot, row)
    if kind == .Aggregate {
        storage :: ir_fresh_temp(&m, &b, row)
        ir_emit(&b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
        ir_emit(&b.f, IROp.CopyBytes, -1, storage, slot, m.types[row].size, b.line)
        ir_copy_fixup(&m, p, &b, row, storage)
        return storage
    }
    duplicate :: ir_temp_like(&m, &b, slot)
    ir_emit(&b.f, IROp.Copy, duplicate, slot, -1, -1, b.line)
    duplicate
}

// An integer constant of type row `row`: an exact Int outside the inline
// range is built by the runtime (jet_int_owned_from_i64).
fn ir_int_constant(m: &IRModule, b: &IRBuilder, row: Int, value: Int) -> Int Never! {
    if m.types[row].kind == .Int && !ir_int_inline(value) {
        raw :: ir_word_const(&m, &b, value)
        return ir_runtime(&m, &b, "jet_int_owned_from_i64", [Int]{raw}, row)
    }
    slot :: ir_temp(&m, &b, row)
    ir_emit(&b.f, IROp.Const, slot, value, -1, -1, b.line)
    slot
}

// An empty List of type row `row` in fresh frame storage.
fn ir_list_empty(m: &IRModule, b: &IRBuilder, row: Int) -> Int Never! {
    storage :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, storage, 24, 8, -1, b.line)
    zero :: ir_word_const(&m, &b, 0)
    ir_emit(&b.f, IROp.Store, -1, storage, 0, zero, b.line)
    ir_emit(&b.f, IROp.Store, -1, storage, 8, zero, b.line)
    ir_emit(&b.f, IROp.Store, -1, storage, 16, zero, b.line)
    storage
}

// A slot standing for the value of an expression control never leaves
// (after an Unreachable): -1 for Unit, else an unwritten temporary.
fn ir_unreachable_value(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type) -> Int Never! {
    if ir_unit_type(ty) || ir_never_type(ty) -> return -1
    row :: ir_value_type(&m, p, ty) ?? return -1
    if m.types[row].kind == .Unit -> return -1
    slot :: ir_temp(&m, &b, row)
    if m.types[row].kind == .Aggregate -> ir_emit(&b.f, IROp.StackAddress, slot, m.types[row].size, 8, -1, b.line)
    slot
}
