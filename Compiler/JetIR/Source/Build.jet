// The IR builder: checked TIR functions (exactly what codegen consumes) to
// IR. Every construct means what the old TIR -> MIR -> LIR path makes of it:
// the same runtime routes, argument orders and source locations, so a
// program behaves the same on both paths. A construct the builder does not
// handle yet fails its function with one message naming the construct; the
// module build keeps going and reports every failure (collect-all).

use jet_foundation.[AccessConvention, CoreCallRecord, Span, Type, TypeTupleField, TBinaryOp, TBuiltinOp, TCallArg, TClosureOp, TComptimeValue, TConstantDef, TEnumPayload, TExpr, TExprKind, TFailureCarrier, TFunc, TFuncKind, TIfCond, TIndexKind, TLambda, TLocal, TMatchArm, TMixedArm, TNestedPattern, TNumericOp, TOrFallback, TPanicLoc, TPatternBinding, TPatternShape, TRangeArm, TRequireKind, TStmt, TStrFormat, TStrPart, TTryConvert, TTypeDef, tir_builtin_mutates_receiver, tir_each_expr_child, tir_each_stmt_list_child, type_carrier_identity]
use jet_backend.[LowerRouteCarrier, lower_float_constant_bits, lower_int_inline, lower_runtime_route]
use jet_codegen.[jet_codegen_builtin_route_plan, jet_codegen_canonical_core_record, jet_codegen_failure_carrier_for_type]

struct IRBuildFailure {
    key: String
    name: String
    message: String
    source_file: String
    span: Span
}

struct IRBuildResult {
    program: IRModule
    failures: [IRBuildFailure]
}

// A visible name: `slot` holds the variable named `name`. `indirect` is the
// type row of the value when `slot` holds its address (a write parameter, or
// a variable a closure writes, kept in a frame cell); -1: the slot is the
// variable itself. `owned`: the variable owns its value, which is dropped
// when its scope ends (every other holder of the value has its own copy).
struct IRBinding { name: String, slot: Int, indirect: Int{-1}, owned: Bool{false} }

// A write argument passed through a frame cell: after the call the variable
// `slot` reads its value back from `cell`.
struct IRWriteBack { cell: Int, slot: Int }

// An open loop: `exit` is the Block that `break` leaves, `next` the
// construct that `next` (continue) leaves or restarts; `mark` the bindings
// visible when it opened (leaving it drops the owned ones declared since).
struct IRLoopFrame { label: String?, exit: Int, next: Int, mark: Int }

// Per-function build state. `fresh[slot]` marks a temporary that holds a
// value nobody else owns yet (a call result, a built String): a borrowing
// consumer drops it after use.
struct IRBuilder {
    f: IRFunction
    bindings: [IRBinding]
    scopes: [Int]
    loops: [IRLoopFrame]
    fresh: [Bool]
    // The subject slots of the open switches (innermost last).
    subjects: [Int]
    // Pattern bindings of the condition being built, bound when its If opens.
    pending: [IRPending]
    line: Int
    error: String
    error_span: Span
    // The function's executable return (None: Unit), its failure carrier, and
    // whether it hands back the plain success of a `T Never!` carrier.
    ret: Type?
    failure: TFailureCarrier
    plain: Bool
    // Variables some closure of this body writes: they live in frame cells
    // from their declaration, so every read sees the closure's writes.
    cells: [String]
    // Calls emitted where the program is only read (display impls): their
    // callee ids are resolved when the function is done.
    deferred: [IRDeferredCall]
}

// The Call at instruction `at` names the checked function `key`.
struct IRDeferredCall { at: Int, key: String }

// The checked functions every IR function id may name, by key, and the
// checked type declarations, by key and by name. A generic function is
// built once per distinct list of concrete type arguments (monomorphized as
// the old path's Mono pass does); `subst_names`/`subst_types` are the type
// parameters of the instance being built and their arguments.
struct IRProgram {
    functions: [TFunc]
    rows: [String:Int]
    // Function row -> IR function id (-1 not yet queued) of a non-generic function.
    ids: [Int]
    // Instance key (function key and type arguments) -> IR function id.
    instances: [String:Int]
    queue: [IRQueued]
    types: [TTypeDef]
    type_rows: [String:Int]
    subst_names: [String]
    subst_types: [Type]
    // Checked constants by key (ConstRef / CtLit values).
    constants: [String:TConstantDef]
    lambdas: [IRLambdaJob]
    // A selected Display (`display`) or Printable (`show`) implementation
    // method by "<trait>|<rendered type key>" (Lower Display.jet render rows).
    render_impls: [String:Int]
}

// A function waiting to be built: its checked row, IR id and type
// arguments, or the lambda job it builds (`lambda` >= 0).
struct IRQueued { row: Int, id: Int, args: [Type], lambda: Int{-1} }

// A lambda body to build as its own function: the box holds its captures
// at their offsets; the instance substitution it was created under.
struct IRLambdaJob {
    lambda: TLambda
    captures: [IRCaptureSlot]
    source_file: String
    line: Int
    subst_names: [String]
    subst_types: [Type]
}

// One closure capture: the name the body reads, its byte offset in the box,
// its value type row, and whether the box holds its address (a capture the
// body writes) instead of its value.
struct IRCaptureSlot { name: String, offset: Int, row: Int, by_ref: Bool }

fn ir_program_new(functions: ^[TFunc], type_defs: ^[TTypeDef], constant_defs: ^[TConstantDef]) -> IRProgram Never! {
    constants := [String:TConstantDef]{}
    loop definition in ^constant_defs {
        if constants.get(definition.key) == None -> constants[definition.key] = definition
        // A ConstRef names `constant:<module>::<name>`.
        qualified :: "constant:{definition.module_identity}::{definition.name}"
        if constants.get(qualified) == None -> constants[qualified] = definition
    }
    owned := ^functions
    rows := [String:Int]{}
    ids := [Int]{}
    loop (index, function) in owned {
        if rows.get(function.key) == None -> rows[function.key] = index
        &ids.push(-1)
    }
    types := ^type_defs
    type_rows := [String:Int]{}
    loop (index, definition) in types {
        if type_rows.get(definition.key) == None -> type_rows[definition.key] = index
    }
    loop (index, definition) in types {
        if type_rows.get(definition.name) == None -> type_rows[definition.name] = index
    }
    render_impls := [String:Int]{}
    loop (index, function) in owned {
        if function.kind == .TraitMethod(_, _, owner_type, trait_name, _) {
            trait_short :: ir_short_name(trait_name.key)
            selected :: (trait_short == "Display" && function.name == "display") || (trait_short == "Printable" && function.name == "show")
            if selected && function.generic_params.len() == 0 {
                key :: "{trait_short}|{ir_render_type_key(type_rows, types, owner_type)}"
                if render_impls.get(key) == None -> render_impls[key] = index
            }
        }
    }
    IRProgram{functions: ^owned, rows: rows, ids: ids, instances: [String:Int]{}, queue: [IRQueued]{}, types: ^types, type_rows: type_rows, subst_names: [String]{}, subst_types: [Type]{}, constants: constants, lambdas: [IRLambdaJob]{}, render_impls: render_impls}
}

// The last segment of a qualified key (`trait:<m>::Display` is `Display`).
fn ir_short_name(key: String) -> String Never! {
    short := key
    separators :: [String]{"::", ".", ":"}
    loop separator in separators {
        parts :: short.split(separator).to_list()
        short = parts[parts.len() - 1]
    }
    short
}

// A rendered type's identity: its declaration key when it names one.
fn ir_render_type_key(type_rows: [String:Int], types: [TTypeDef], ty: Type) -> String Never! {
    plain :: ir_untag(ty)
    if plain == .Named(name) {
        if type_rows.get(name) == .Val(row) -> return "decl:{types[row].key}"
    }
    type_carrier_identity(plain)
}

// The declaration a nominal type name or key names.
fn ir_type_def(p: IRProgram, name: String) -> Int? Never! {
    p.type_rows.get(name)
}

// The IR id of the checked function `key` applied to `type_args` (written
// in the current instance's terms), queueing it on first use.
fn ir_function_id(m: &IRModule, p: &IRProgram, key: String, type_args: [Type]) -> Int? Never! {
    row :: p.rows.get(key) ?? return None
    function :: p.functions[row]
    if type_args.len() == 0 || function.generic_params.len() == 0 {
        if p.ids[row] >= 0 -> return Val(p.ids[row])
        id :: m.functions.len()
        &m.functions.push(ir_function_new(function.name, function.key, ir_symbol_name(function), function.source_file, function.line))
        m.function_rows[function.key] = id
        p.ids[row] = id
        &p.queue.push(IRQueued{row: row, id: id, args: [Type]{}})
        return Val(id)
    }
    concrete := [Type]{}
    spelled := [String]{}
    loop arg in type_args {
        &concrete.push(ir_subst(p, arg))
        &spelled.push(type_carrier_identity(concrete[concrete.len() - 1]))
    }
    instance :: "{function.key}<{spelled.join(", ")}>"
    if p.instances.get(instance) == .Val(known) -> return Val(known)
    id :: m.functions.len()
    &m.functions.push(ir_function_new(function.name, instance, "{ir_symbol_name(function)}__{id}", function.source_file, function.line))
    m.function_rows[instance] = id
    p.instances[instance] = id
    &p.queue.push(IRQueued{row: row, id: id, args: concrete})
    Val(id)
}

fn ir_generic_names(function: TFunc) -> [String] Never! {
    names := [String]{}
    loop parameter in function.generic_params -> &names.push(parameter.name)
    names
}

// `ty` in the terms of the instance being built.
fn ir_subst(p: IRProgram, ty: Type) -> Type Never! {
    if p.subst_names.len() == 0 -> return ty.copy()
    ir_subst_in(p.subst_names, p.subst_types, ty)
}

// `ty` with each type parameter `names[i]` replaced by `types[i]`.
fn ir_subst_in(names: [String], types: [Type], ty: Type) -> Type Never! {
    if ty == {
        .Named(name) -> {
            loop (index, parameter) in names {
                if parameter == name -> return types[index].copy()
            }
            return ty.copy()
        }
        .Apply(name, args) -> {
            if args.len() == 0 {
                loop (index, parameter) in names {
                    if parameter == name -> return types[index].copy()
                }
                return ty.copy()
            }
            return Type.Apply{name: name, args: ir_subst_list(names, types, args)}
        }
        .List(element) -> return Type.List{element: ir_subst_in(names, types, element)}
        .Option(inner) -> return Type.Option{inner: ir_subst_in(names, types, inner)}
        .Result(ok, err) -> return Type.Result{ok: ir_subst_in(names, types, ok), err: ir_subst_in(names, types, err)}
        .Shared(inner) -> return Type.Shared{inner: ir_subst_in(names, types, inner)}
        .Map(key, key_span, value) -> return Type.Map{key: ir_subst_in(names, types, key), key_span: key_span, value: ir_subst_in(names, types, value)}
        .Tagged(marker, inner) -> return Type.Tagged{marker: marker, inner: ir_subst_in(names, types, inner)}
        .FixedList(elem, len) -> return Type.FixedList{elem: ir_subst_in(names, types, elem), len: len}
        .Union(members) -> return Type.Union{members: ir_subst_list(names, types, members)}
        .Tuple(fields) -> {
            mapped := [TypeTupleField]{}
            loop field in fields -> &mapped.push(TypeTupleField{name: field.name, ty: ir_subst_in(names, types, field.ty)})
            return Type.Tuple{fields: mapped}
        }
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            mapped_ret := Type?{None}
            if ret == .Val(returned) -> mapped_ret = Val(ir_subst_in(names, types, returned))
            return Type.Fn{params: ir_subst_list(names, types, params), ret: mapped_ret, effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        else -> return ty.copy()
    }
}

fn ir_subst_list(names: [String], types: [Type], list: [Type]) -> [Type] Never! {
    mapped := [Type]{}
    loop item in list -> &mapped.push(ir_subst_in(names, types, item))
    mapped
}

// The object symbol of a function: its module and name, made a C identifier.
fn ir_symbol_name(function: TFunc) -> String Never! {
    bytes := [U8]{}
    loop byte in "{function.module_name}.{function.name}".bytes() {
        alphanumeric :: (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
        &bytes.push(if alphanumeric -> byte else -> U8{95})
    }
    String.from_bytes(bytes) ?? function.name.copy()
}

// Builds the entry `entry_key` and every function it reaches.
// `type_defs` and `constants` are the checked modules' type and constant
// declarations, in module order.
fn ir_build_program(functions: ^[TFunc], type_defs: ^[TTypeDef], constants: ^[TConstantDef], entry_key: String) -> IRBuildResult Never! {
    m := ir_module_new()
    p := ir_program_new(^functions, ^type_defs, ^constants)
    failures := [IRBuildFailure]{}
    entry := ir_function_id(&m, &p, entry_key, [Type]{}) ?? {
        &failures.push(IRBuildFailure{key: entry_key, name: entry_key, message: "the entry function is not among the checked functions", source_file: "", span: Span{start: 0, end: 0}})
        return IRBuildResult{program: m, failures: failures}
    }
    m.entry = entry
    ir_build_queue(&m, &p, &failures)
    IRBuildResult{program: m, failures: failures}
}

// Builds every checked non-generic function (a library or a coverage
// census); generic functions are built per instance their callers reach.
fn ir_build_all(functions: ^[TFunc], type_defs: ^[TTypeDef], constants: ^[TConstantDef]) -> IRBuildResult Never! {
    m := ir_module_new()
    p := ir_program_new(^functions, ^type_defs, ^constants)
    failures := [IRBuildFailure]{}
    loop row in 0..<p.functions.len() {
        if p.functions[row].generic_params.len() > 0 -> next
        key :: p.functions[row].key
        _ :: ir_function_id(&m, &p, key, [Type]{})
    }
    ir_build_queue(&m, &p, &failures)
    IRBuildResult{program: m, failures: failures}
}

fn ir_build_queue(m: &IRModule, p: &IRProgram, failures: &[IRBuildFailure]) Never! {
    next := 0
    loop next < p.queue.len() {
        queued :: p.queue[next].copy()
        next += 1
        b := ir_builder_new(m.functions[queued.id].copy())
        if queued.lambda >= 0 {
            job :: p.lambdas[queued.lambda].copy()
            p.subst_names = job.subst_names
            p.subst_types = job.subst_types
            ir_build_lambda(&m, &p, &b, job)
            if b.error != "" {
                &failures.push(IRBuildFailure{key: m.functions[queued.id].key, name: m.functions[queued.id].name, message: b.error, source_file: job.source_file, span: if b.error_span.end > 0 -> b.error_span else -> job.lambda.source_span})
            }
            ir_resolve_deferred(&m, &p, &b)
            m.functions[queued.id] = ^b.f
            next
        }
        // copy: the checked function is read while later calls queue more rows.
        function :: p.functions[queued.row].copy()
        p.subst_names = if queued.args.len() > 0 -> ir_generic_names(function) else -> [String]{}
        p.subst_types = queued.args
        ir_build_function(&m, &p, &b, function)
        if b.error != "" {
            &failures.push(IRBuildFailure{key: m.functions[queued.id].key, name: function.name, message: b.error, source_file: function.source_file, span: if b.error_span.end > 0 -> b.error_span else -> function.source_span})
        }
        ir_resolve_deferred(&m, &p, &b)
        m.functions[queued.id] = ^b.f
    }
    p.subst_names = [String]{}
    p.subst_types = [Type]{}
}

fn ir_builder_new(f: ^IRFunction) -> IRBuilder Never! {
    IRBuilder{f: ^f, bindings: [IRBinding]{}, scopes: [Int]{}, loops: [IRLoopFrame]{}, fresh: [Bool]{}, subjects: [Int]{}, pending: [IRPending]{}, line: 0, error: "", error_span: Span{start: 0, end: 0}, ret: None, failure: TFailureCarrier.Infallible, plain: false, cells: [String]{}, deferred: [IRDeferredCall]{}}
}

fn ir_resolve_deferred(m: &IRModule, p: &IRProgram, b: &IRBuilder) Never! {
    loop call in b.deferred {
        b.f.a[call.at] = ir_function_id(&m, &p, call.key, [Type]{}) ?? -1
    }
}

// A payload binding a condition introduces: `slot` (named `name`) receives
// the payload at byte `offset` of the carrier box `subject` once the test holds.
// `boxed`: the member at `offset` is a recursive edge's wrapper box holding the payload.
struct IRPending { name: String, slot: Int, subject: Int, offset: Int, boxed: Bool{false} }

// Opens the If of a condition and binds its pending payloads in it.
fn ir_open_condition(m: &IRModule, b: &IRBuilder, test: Int) Never! {
    ir_open_if(&b.f, test, b.line)
    ir_bind_pending(&m, &b)
}

fn ir_bind_pending(m: &IRModule, b: &IRBuilder) Never! {
    loop row in b.pending {
        op :: if m.types[b.f.slot_type[row.slot]].kind == .Aggregate -> IROp.Offset else -> IROp.Load
        if row.boxed {
            wrapper :: ir_temp(&m, &b, ir_pointer_row(&m))
            ir_emit(&b.f, IROp.Load, wrapper, row.subject, row.offset, -1, b.line)
            ir_emit(&b.f, op, row.slot, wrapper, 0, -1, b.line)
        } else {
            ir_emit(&b.f, op, row.slot, row.subject, row.offset, -1, b.line)
        }
        &b.bindings.push(IRBinding{name: row.name, slot: row.slot})
    }
    b.pending = [IRPending]{}
}

fn ir_fail(b: &IRBuilder, span: Span, message: String) Never! {
    if b.error != "" -> return
    b.error = message
    b.error_span = span
}

fn ir_failed(b: IRBuilder) -> Bool Never! { b.error != "" }

fn ir_build_function(m: &IRModule, p: &IRProgram, b: &IRBuilder, function: TFunc) Never! {
    b.line = function.line
    if function.generic_params.len() > 0 && p.subst_types.len() == 0 -> return ir_fail(&b, function.source_span, "generic function without type arguments")
    if function.foreign != None -> return ir_fail(&b, function.source_span, "foreign function")
    if function.failure_carrier == .Diverges(_) -> return ir_fail(&b, function.source_span, "diverging function")
    b.failure = function.failure_carrier
    if function.kind == {
        .TopLevel -> {}
        .Method(_, owner_type) | .TraitMethod(_, _, owner_type, _, _) -> {
            // An implementation's method is built for its concrete receiver
            // like an inherent one; a call naming it is a direct call.
            receiver :: ir_receiver_access(function.kind)
            if receiver != "static" {
                if ir_param_slot(&m, p, &b, owner_type, receiver == "write", receiver == "move", "self") == None -> return ir_fail(&b, function.source_span, "method receiver type {ir_type_name(owner_type)}")
            }
        }
    }
    loop param in function.params {
        if ir_param_slot(&m, p, &b, param.ty, param.convention == .Write, param.convention == .Move, param.local.name) == None -> return ir_fail(&b, param.span, "parameter type {ir_type_name(param.ty)}")
    }
    b.cells = ir_mutable_captures(function.body)
    ir_cell_params(&m, &b)
    b.plain = ir_plain_return(function) != None
    executable :: ir_executable_return(function)
    if executable == .Val(ret) {
        if !ir_unit_type(ret) {
            result_row :: ir_value_type(&m, p, ret) ?? return ir_fail(&b, function.source_span, "result type {ir_type_name(ret)}")
            b.f.result = result_row
        }
    }
    b.ret = executable
    ir_stmts(&m, &p, &b, function.body)
    if ir_failed(b) -> return
    ir_return_fallthrough(&m, &p, &b)
}

// A parameter (or receiver) slot bound to `name`: a write parameter of a
// non-aggregate type is the address of the caller's variable.
fn ir_param_slot(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, write: Bool, owned: Bool, name: String) -> Int? Never! {
    row :: ir_value_type(&m, p, ty) ?? return None
    if write && m.types[row].kind != .Aggregate {
        slot :: ir_new_slot(&b, ir_pointer_row(&m), IRSlotKind.Param, ir_intern_name(&m, name))
        &b.bindings.push(IRBinding{name: name, slot: slot, indirect: row})
        return Val(slot)
    }
    slot :: ir_new_slot(&b, row, IRSlotKind.Param, ir_intern_name(&m, name))
    &b.bindings.push(IRBinding{name: name, slot: slot, owned: owned && m.types[row].drop != ""})
    Val(slot)
}

// The parameters a closure of the body writes move into frame cells.
fn ir_cell_params(m: &IRModule, b: &IRBuilder) Never! {
    if b.cells.len() == 0 -> return
    loop index in 0..<b.bindings.len() {
        binding :: b.bindings[index]
        if binding.indirect >= 0 || !b.cells.contains(binding.name) -> next
        if ir_kind_of(m, b, binding.slot) == .Aggregate -> next
        _ :: ir_cell_binding(&m, &b, binding.name)
    }
}

// The names of the variables a closure in `body` captures to write.
fn ir_mutable_captures(body: [TStmt]) -> [String] Never! {
    names := [String]{}
    tir_each_stmt_list_child(body, (expression: TExpr) -> ir_collect_mutable_captures(expression, &names))
    names
}

fn ir_collect_mutable_captures(expression: TExpr, names: &[String]) Never! {
    if expression.kind == .Lambda(lambda) | .LambdaValue(lambda) {
        loop name in lambda.capture_facts.mutable {
            if !names.contains(name) -> &names.push(name)
        }
    }
    tir_each_expr_child(expression, (child: TExpr) -> ir_collect_mutable_captures(child, &names))
}

// A `Never`-tagged or pattern-tagged type without its tags.
fn ir_untag(ty: Type) -> Type Never! {
    if ty == .Tagged(_, inner) -> return ir_untag(inner)
    ty.copy()
}

fn ir_never_type(ty: Type) -> Bool Never! {
    ir_untag(ty) == (Type.Named{name: "Never"})
}

// The success of a `T Never!` carrier.
fn ir_never_carrier_success(ty: Type) -> Type? Never! {
    if ir_untag(ty) == .Result(ok, err) {
        if ir_never_type(err) -> return Val(ok)
    }
    None
}

// A top-level infallible function whose written failure set is empty
// (`T Never!`) returns its success value directly; its checked body and its
// call sites keep the `Result<T, Never>` carrier (codegen
// jet_codegen_plain_return).
fn ir_plain_return(function: TFunc) -> Type? Never! {
    if function.kind != .TopLevel -> return None
    if function.failure_carrier != .Infallible -> return None
    if function.foreign != None || function.gc_return || function.synthetic -> return None
    if function.body.len() > 0 {
        if function.body[0] == .ContractScope(_, _, _, _, _) -> return None
    }
    declared :: function.ret ?? return None
    success :: ir_never_carrier_success(declared) ?? return None
    if ir_never_type(success) -> return None
    Val(success)
}

// The type a call of `function` produces.
fn ir_executable_return(function: TFunc) -> Type? Never! {
    if ir_plain_return(function) == .Val(success) -> return Val(success)
    function.ret
}

// The end of a body: a Unit success of a Result carrier (or of a kept
// `Unit Never!` carrier) hands back `Ok(())`, a Unit function returns, and
// any other function cannot get here.
fn ir_return_fallthrough(m: &IRModule, p: &IRProgram, b: &IRBuilder) Never! {
    if b.f.result < 0 {
        ir_emit_return(&m, &b, -1)
        return
    }
    ret :: b.ret ?? Type.Named{name: "Unit"}
    if ir_untag(ret) == .Result(ok, _) {
        if ir_unit_type(ir_untag(ok)) {
            boxed :: ir_result_box(&m, p, &b, ret, true, -1)
            ir_emit_return(&m, &b, boxed)
            return
        }
    }
    ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
}

// Returns `slot` (-1: nothing) after dropping every owned variable.
fn ir_emit_return(m: &IRModule, b: &IRBuilder, slot: Int) Never! {
    if slot >= 0 -> b.fresh[slot] = false
    ir_drop_bindings(&m, &b, 0)
    ir_emit(&b.f, IROp.Return, -1, slot, -1, -1, b.line)
}

// Drops the owned variables among bindings[mark..], latest first.
fn ir_drop_bindings(m: &IRModule, b: &IRBuilder, mark: Int) Never! {
    index := b.bindings.len() - 1
    loop index >= mark {
        binding :: b.bindings[index]
        index -= 1
        if !binding.owned -> next
        value :: ir_read_binding(&m, &b, binding)
        ir_emit(&b.f, IROp.Drop, -1, value, -1, -1, b.line)
    }
}

// `slot` as a value its new holder owns: a fresh value moves; a read of a
// place another holder keeps is copied when its type has a drop (an exact
// Int or a String: their runtime clone).
fn ir_own(m: &IRModule, b: &IRBuilder, slot: Int) -> Int Never! {
    if slot < 0 || b.fresh[slot] || !ir_has_drop(m, b, slot) -> return slot
    kind :: ir_kind_of(m, b, slot)
    symbol :: if kind == .String -> "jet_rt_string_clone" else if kind == .Int -> "jet_rt_int_clone" else -> ""
    if symbol == "" -> return slot
    row :: b.f.slot_type[slot]
    ir_runtime(&m, &b, symbol, [Int]{slot}, row)
}

fn ir_new_slot(b: &IRBuilder, ty: Int, kind: IRSlotKind, name: Int) -> Int Never! {
    &b.fresh.push(false)
    ir_slot(&b.f, ty, kind, name, b.line)
}

fn ir_temp(m: &IRModule, b: &IRBuilder, ty: Int) -> Int Never! {
    ir_new_slot(&b, ty, IRSlotKind.Temp, -1)
}

fn ir_fresh_temp(m: &IRModule, b: &IRBuilder, ty: Int) -> Int Never! {
    slot :: ir_temp(&m, &b, ty)
    b.fresh[slot] = true
    slot
}
// A temporary of `slot`'s type.
fn ir_temp_like(m: &IRModule, b: &IRBuilder, slot: Int) -> Int Never! {
    ty :: b.f.slot_type[slot]
    ir_temp(&m, &b, ty)
}

fn ir_fresh_like(m: &IRModule, b: &IRBuilder, slot: Int) -> Int Never! {
    ty :: b.f.slot_type[slot]
    ir_fresh_temp(&m, &b, ty)
}

// ---------------------------------------------------------------------------
// Types.

fn ir_layout(kind: IRTypeKind, ty: Type, size: Int, align: Int, class: IRClass, signed: Bool, bits: Int, drop: String) -> IRType Never! {
    IRType{ty: ty, kind: kind, size: size, align: align, class: class, signed: signed, bits: bits, drop: drop}
}

// The type row of a checked type, or None when the builder cannot lay it out yet.
fn ir_type_row(m: &IRModule, ty: Type) -> Int? Never! {
    row :: if ty == {
        .Int -> ir_layout(IRTypeKind.Int, ty, 8, 8, IRClass.Integer, true, 64, "jet_rt_int_drop")
        .Bool -> ir_layout(IRTypeKind.Bool, ty, 1, 1, IRClass.Integer, false, 8, "")
        .Float -> ir_layout(IRTypeKind.Float, ty, 8, 8, IRClass.Float, true, 64, "")
        .Float32 -> ir_layout(IRTypeKind.Float32, ty, 4, 4, IRClass.Float, true, 32, "")
        .Char -> ir_layout(IRTypeKind.Char, ty, 8, 8, IRClass.Integer, false, 32, "")
        .String -> ir_layout(IRTypeKind.String, ty, 8, 8, IRClass.Pointer, false, 64, "jet_rt_string_drop")
        .IntN(signed, bits) -> {
            if bits > 64 { return None }
            // Packed at its width in aggregates (Lower Values.jet packed IntN).
            ir_layout(IRTypeKind.Word, ty, bits /% 8, bits /% 8, IRClass.Integer, signed, bits, "")
        }
        .InlineRange(base, _, _) -> { return ir_type_row(&m, base) }
        .Tagged(_, inner) -> { return ir_type_row(&m, inner) }
        .Named(name) -> {
            if name != "Unit" && name != "()" && name != "Never" { return None }
            ir_layout(IRTypeKind.Unit, ty, 0, 1, IRClass.Integer, false, 0, "")
        }
        .Tuple(fields) -> {
            if fields.len() != 0 { return None }
            ir_layout(IRTypeKind.Unit, ty, 0, 1, IRClass.Integer, false, 0, "")
        }
        else -> { return None }
    }
    Val(ir_intern_type(&m, type_carrier_identity(ty), row))
}

// ir_type_row extended to declared types: a payload-free enum is its
// discriminant word (Lower LowerRepr.Discriminant: the variant index), a
// distinct type or alias is its base.
fn ir_value_type(m: &IRModule, p: IRProgram, written: Type) -> Int? Never! {
    ir_value_type_in(&m, p, written, [String]{})
}

// ir_value_type while the structs `laying` (declaration keys) are being laid
// out: one of them reached again through a pointer (an Option, Result or List
// member) is already known to lay out; reached inline it has no finite size.
fn ir_value_type_in(m: &IRModule, p: IRProgram, written: Type, laying: [String]) -> Int? Never! {
    ty :: ir_subst(p, written)
    if ir_type_row(&m, ty) == .Val(row) -> return Val(row)
    if ty == .Tagged(_, inner) -> return ir_value_type_in(&m, p, inner, laying)
    if ty == .InlineRange(base, _, _) -> return ir_value_type_in(&m, p, base, laying)
    if ty == .Option(inner) {
        // A box pointer, null when absent (Lower LowerRepr.Boxed); its payload
        // lies at offset 0.
        if !ir_pointee_lays_out(&m, p, inner, laying) -> return None
        return Val(ir_intern_type(&m, type_carrier_identity(ty), ir_layout(IRTypeKind.Pointer, ty, 8, 8, IRClass.Pointer, false, 64, "")))
    }
    if ty == .Result(ok, err) {
        // A box pointer: selector word at 0 (Ok 1, Err 0), payload at 8.
        if !ir_pointee_lays_out(&m, p, ok, laying) || !ir_pointee_lays_out(&m, p, err, laying) -> return None
        return Val(ir_intern_type(&m, type_carrier_identity(ty), ir_layout(IRTypeKind.Pointer, ty, 8, 8, IRClass.Pointer, false, 64, "")))
    }
    if ty == .List(element) {
        // The address of an inline header: len at 0, cap at 8, element data
        // at 16 (Lower Lists.jet); cap 0 is a frozen buffer.
        if !ir_pointee_lays_out(&m, p, element, laying) -> return None
        return Val(ir_intern_type(&m, type_carrier_identity(ty), ir_layout(IRTypeKind.Aggregate, ty, 24, 8, IRClass.Pointer, false, 64, "")))
    }
    if ty == .Fn(_, _, _, _, _, _) {
        // A closure box pointer (Lower Closures.jet): reference count at 0,
        // code address at 8, release helper at 16, captures from 24.
        return Val(ir_intern_type(&m, type_carrier_identity(ty), ir_layout(IRTypeKind.Pointer, ty, 8, 8, IRClass.Pointer, false, 64, "")))
    }
    if ty == .Tuple(fields) {
        members :: ir_tuple_members_in(&m, p, fields, laying) ?? return None
        size :: ir_struct_size(m, members)
        return Val(ir_intern_type(&m, type_carrier_identity(ty), ir_layout(IRTypeKind.Aggregate, ty, if size < 8 -> 8 else -> size, 8, IRClass.Pointer, false, 64, "")))
    }
    name :: if ty == {
        .Named(name) -> name
        .Apply(name, args) -> { if args.len() > 0 { return None }
            name }
        else -> { return None }
    }
    row :: ir_type_def(p, name) ?? return None
    definition :: p.types[row]
    if definition.generic_params.len() > 0 -> return None
    if definition.kind == {
        .Enum(variants, _) -> {
            loop variant in variants {
                if variant.payload != .Unit {
                    // A heap box: discriminant word at 0, the variant's
                    // payload members from 8 (Lower Values.jet lower_variant_members).
                    return Val(ir_intern_type(&m, "enum:{definition.key}", ir_layout(IRTypeKind.Pointer, ty, 8, 8, IRClass.Pointer, false, 64, "")))
                }
            }
            return Val(ir_intern_type(&m, "enum:{definition.key}", ir_layout(IRTypeKind.Word, ty, 8, 8, IRClass.Integer, true, 64, "")))
        }
        .Struct(_, _) -> {
            if laying.contains(definition.key) -> return None
            members :: ir_struct_members_in(&m, p, row, laying) ?? return None
            size :: ir_struct_size(m, members)
            return Val(ir_intern_type(&m, "struct:{definition.key}", ir_layout(IRTypeKind.Aggregate, ty, if size < 8 -> 8 else -> size, 8, IRClass.Pointer, false, 64, "")))
        }
        .Distinct(base, _) -> { return ir_value_type_in(&m, p, base, laying) }
        .Alias(target) -> { return ir_value_type_in(&m, p, target, laying) }
        else -> { return None }
    }
}

// Whether the value a pointer member points at lays out: a struct already
// being laid out does (the pointer breaks the cycle).
fn ir_pointee_lays_out(m: &IRModule, p: IRProgram, written: Type, laying: [String]) -> Bool Never! {
    if laying.len() > 0 {
        if ir_nominal_name(ir_untag(ir_subst(p, written))) == .Val(name) {
            if ir_type_def(p, name) == .Val(row) {
                if laying.contains(p.types[row].key) -> return true
            }
        }
    }
    ir_value_type_in(&m, p, written, laying) != None
}

// The declared payload-free enum an IR slot type stands for, if any.
fn ir_enum_def(m: IRModule, p: IRProgram, ty: Int) -> Int? Never! {
    name :: if m.types[ty].ty == {
        .Named(name) -> name
        .Apply(name, _) -> name
        else -> { return None }
    }
    row :: ir_type_def(p, name) ?? return None
    if p.types[row].kind == .Enum(_, _) -> return Val(row)
    None
}

// The index of variant `name` of the enum declaration `row`, by its name or
// the last segment of its key.
fn ir_variant_index(p: IRProgram, row: Int, name: String) -> Int? Never! {
    if p.types[row].kind == .Enum(variants, _) {
        short := name
        separators :: [String]{"::", ".", ":"}
        loop separator in separators {
            parts :: short.split(separator).to_list()
            short = parts[parts.len() - 1]
        }
        loop (index, variant) in variants {
            if variant.name == short -> return Val(index)
        }
    }
    None
}

fn ir_unit_type(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Unit" || name == "()"
        .Tuple(fields) -> fields.len() == 0
        else -> false
    }
}

fn ir_kind_of(m: IRModule, b: IRBuilder, slot: Int) -> IRTypeKind Never! {
    m.types[b.f.slot_type[slot]].kind
}

fn ir_has_drop(m: IRModule, b: IRBuilder, slot: Int) -> Bool Never! {
    m.types[b.f.slot_type[slot]].drop != ""
}

// Drops `slot` when it is a fresh temporary of a type with a drop.
fn ir_release(m: &IRModule, b: &IRBuilder, slot: Int) Never! {
    if slot < 0 || !b.fresh[slot] -> return
    if ir_has_drop(m, b, slot) -> ir_emit(&b.f, IROp.Drop, -1, slot, -1, -1, b.line)
    b.fresh[slot] = false
}

// ---------------------------------------------------------------------------
// Names and scopes.

fn ir_scope_open(b: &IRBuilder) Never! {
    &b.scopes.push(b.bindings.len())
}

// Closes the innermost scope: its owned variables are dropped, latest first.
fn ir_scope_close(m: &IRModule, b: &IRBuilder) Never! {
    mark :: &b.scopes.pop() ?? 0
    ir_drop_bindings(&m, &b, mark)
    loop b.bindings.len() > mark {
        _ :: &b.bindings.pop()
    }
}

fn ir_lookup(b: IRBuilder, name: String) -> Int? Never! {
    binding :: ir_lookup_binding(b, name) ?? return None
    Val(binding.slot)
}

fn ir_lookup_binding(b: IRBuilder, name: String) -> IRBinding? Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        if b.bindings[index].name == name -> return Val(b.bindings[index].copy())
        index -= 1
    }
    None
}

// The value of a visible variable: a write parameter's is read through its address.
fn ir_read_binding(m: &IRModule, b: &IRBuilder, binding: IRBinding) -> Int Never! {
    if binding.indirect < 0 -> return binding.slot
    value :: ir_temp(&m, &b, binding.indirect)
    ir_emit(&b.f, IROp.Load, value, binding.slot, 0, -1, b.line)
    value
}

// ---------------------------------------------------------------------------
// Statements.

fn ir_stmts(m: &IRModule, p: &IRProgram, b: &IRBuilder, body: [TStmt]) Never! {
    ir_scope_open(&b)
    loop statement in body {
        if ir_failed(b) -> break
        ir_stmt(&m, &p, &b, statement)
    }
    ir_scope_close(&m, &b)
}

fn ir_stmt(m: &IRModule, p: &IRProgram, b: &IRBuilder, statement: TStmt) Never! {
    if statement == {
        .LineMarker(line) -> b.line = line
        .SourceSpan(_) -> {}
        .Let(local, let_ty, init, gc, _, span) -> {
            if gc != None -> return ir_fail(&b, span, "GC-promoted binding")
            if local.deref || local.address_lifetime != None || local.persist_key != None -> return ir_fail(&b, span, "addressed or persistent binding")
            if let_ty == .Annotated(_, wrapper) {
                if wrapper != .Plain -> return ir_fail(&b, span, "wrapped binding")
            }
            value :: ir_expr(&m, &p, &b, init)
            if ir_failed(b) -> return
            if ir_unit_type(init.ty) || value < 0 {
                return
            }
            ty :: b.f.slot_type[value]
            slot :: ir_new_slot(&b, ty, IRSlotKind.Local, ir_intern_name(&m, local.name))
            ir_store(&m, &b, slot, value)
            &b.bindings.push(IRBinding{name: local.name, slot: slot, owned: ir_has_drop(m, b, slot)})
            // A variable a closure writes lives in a frame cell from here on.
            if b.cells.contains(local.name) && ir_kind_of(m, b, slot) != .Aggregate {
                _ :: ir_cell_binding(&m, &b, local.name)
            }
        }
        .Assign(place, op, value, line, span) -> {
            if line > 0 -> b.line = line
            if place == .Expr(target_place) {
                return ir_assign_place(&m, &p, &b, target_place, op, value, span)
            }
            binding :: if place == {
                .Local(local) -> ir_lookup_binding(b, local.name) ?? { return ir_fail(&b, span, "assignment to unknown local {local.name}") }
                .Expr(_) -> { return ir_fail(&b, span, "assignment place") }
            }
            right :: ir_expr(&m, &p, &b, value)
            if ir_failed(b) -> return
            current :: ir_read_binding(&m, &b, binding)
            result := right
            if op == .Val(binary) {
                left_ty :: m.types[b.f.slot_type[current]].ty
                site :: b.line
                result = ir_binary(&m, &p, &b, binary, false, site, left_ty, current, right, value.ty, span)
                ir_release(&m, &b, right)
                if ir_failed(b) -> return
            }
            if result < 0 -> return
            // The variable's old value ends here when it owns it (a write
            // parameter's or cell's holder owns the value behind the address).
            owned :: ir_own(&m, &b, result)
            if (binding.owned || binding.indirect >= 0) && ir_has_drop(m, b, current) -> ir_emit(&b.f, IROp.Drop, -1, current, -1, -1, b.line)
            if binding.indirect >= 0 {
                ir_emit(&b.f, IROp.Store, -1, binding.slot, 0, owned, b.line)
                b.fresh[owned] = false
                return
            }
            ir_store(&m, &b, binding.slot, owned)
        }
        .ExprStmt(value, _) -> {
            result :: ir_expr(&m, &p, &b, value)
            if ir_failed(b) -> return
            ir_release(&m, &b, result)
        }
        .Return(value, span) -> ir_return(&m, &p, &b, value, span)
        .If(condition, then_body, else_body, _, span) -> {
            ir_scope_open(&b)
            mark :: b.bindings.len()
            test :: ir_condition(&m, &p, &b, condition, span)
            if ir_failed(b) -> return
            ir_open_condition(&m, &b, test)
            ir_stmts(&m, &p, &b, then_body)
            if else_body == .Val(otherwise) {
                ir_else(&b.f, b.line)
                ir_truncate_bindings(&b, mark)
                ir_stmts(&m, &p, &b, otherwise)
            }
            ir_end(&b.f, b.line)
            ir_scope_close(&m, &b)
        }
        .Loop(label, body, _) -> {
            exit :: ir_open(&b.f, IROp.Block, b.line)
            top :: ir_open(&b.f, IROp.Loop, b.line)
            &b.loops.push(IRLoopFrame{label: label, exit: exit, next: top, mark: b.bindings.len()})
            ir_stmts(&m, &p, &b, body)
            _ :: &b.loops.pop()
            ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
            ir_end(&b.f, b.line)
            ir_end(&b.f, b.line)
        }
        .While(label, condition, body, span) -> {
            exit :: ir_open(&b.f, IROp.Block, b.line)
            top :: ir_open(&b.f, IROp.Loop, b.line)
            test :: ir_expr(&m, &p, &b, condition)
            if ir_failed(b) -> return
            ir_exit_unless(&m, &b, test, exit)
            &b.loops.push(IRLoopFrame{label: label, exit: exit, next: top, mark: b.bindings.len()})
            ir_stmts(&m, &p, &b, body)
            _ :: &b.loops.pop()
            ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
            ir_end(&b.f, b.line)
            ir_end(&b.f, b.line)
        }
        .ForRange(label, local, start, end, step, exclusive, body, _, span) -> ir_range_loop(&m, &p, &b, label, local, start, end, step, exclusive, body, span)
        .Range(label, variable, source, start, end, step, exclusive, _, body, span) -> {
            if source != None -> return ir_fail(&b, span, "range loop over a source collection")
            ir_range_loop(&m, &p, &b, label, variable, start, end, step, exclusive, body, span)
        }
        .Break(label, span) -> {
            frame :: ir_loop_frame(b, label) ?? return ir_fail(&b, span, "break outside a loop")
            ir_drop_bindings(&m, &b, frame.mark)
            ir_emit(&b.f, IROp.Br, -1, ir_depth(b.f, frame.exit), -1, -1, b.line)
        }
        .Continue(label, span) -> {
            frame :: ir_loop_frame(b, label) ?? return ir_fail(&b, span, "next outside a loop")
            ir_drop_bindings(&m, &b, frame.mark)
            ir_emit(&b.f, IROp.Br, -1, ir_depth(b.f, frame.next), -1, -1, b.line)
        }
        .Inline(body, _) | .Region(body, _) -> ir_stmts(&m, &p, &b, body)
        .Contract(_) -> ir_fail(&b, Span{start: 0, end: 0}, "statement Contract")
        .ContractScope(_, _, _, _, span) -> ir_fail(&b, span, "statement ContractScope")
        .RefutableBind(_, _, _, span) -> ir_fail(&b, span, "statement RefutableBind")
        .TupleDestructure(_, _, _, _, span) -> ir_fail(&b, span, "statement TupleDestructure")
        .StructDestructure(_, _, _, _, span) -> ir_fail(&b, span, "statement StructDestructure")
        .ListDestructure(_, _, _, _, _, _, span) -> ir_fail(&b, span, "statement ListDestructure")
        .CountedLoop(label, init, condition, step, _, body, span) -> {
            ir_scope_open(&b)
            ir_stmt(&m, &p, &b, init)
            if ir_failed(b) -> return
            exit :: ir_open(&b.f, IROp.Block, b.line)
            _ :: ir_open(&b.f, IROp.Loop, b.line)
            test :: ir_expr(&m, &p, &b, condition)
            if ir_failed(b) -> return
            ir_exit_unless(&m, &b, test, exit)
            step_block :: ir_open(&b.f, IROp.Block, b.line)
            &b.loops.push(IRLoopFrame{label: label, exit: exit, next: step_block, mark: b.bindings.len()})
            ir_stmts(&m, &p, &b, body)
            _ :: &b.loops.pop()
            ir_end(&b.f, b.line)
            if step == .Val(advance) -> ir_stmt(&m, &p, &b, advance)
            ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
            ir_end(&b.f, b.line)
            ir_end(&b.f, b.line)
            ir_scope_close(&m, &b)
        }
        .TaskGroup(_, _, _, span) -> ir_fail(&b, span, "statement TaskGroup")
        .DeferClose(_, _, _, span) -> ir_fail(&b, span, "statement DeferClose")
        .BreakValue(_, _, span) -> ir_fail(&b, span, "statement BreakValue")
        .Match(subject, arms, _, span) -> ir_match(&m, &p, &b, subject, arms, None, span)
        .EnumMatch(subject, arms, else_body, _, span) -> ir_match(&m, &p, &b, subject, arms, else_body, span)
        .RangeSwitch(subject, arms, else_body, span) -> ir_range_switch(&m, &p, &b, subject, arms, else_body, span)
        .IndexAssign(uninit, base, index, is_map, value, span) -> {
            if is_map || uninit -> return ir_fail(&b, span, "statement IndexAssign on a map or fixed list")
            ir_list_index_assign(&m, &p, &b, base, index, value, span)
        }
        .IndexFieldAssign(_, span) -> ir_fail(&b, span, "statement IndexFieldAssign")
        .IndexHookAssign(_, _, _, _, span) -> ir_fail(&b, span, "statement IndexHookAssign")
        .MathSwizzleAssign(_, _, _, _, span) -> ir_fail(&b, span, "statement MathSwizzleAssign")
        .ForIn(label, variable, variable_two, _, collection, step, method_kind, columnar, _, _, body, span) -> {
            if method_kind != None || step != None || columnar -> return ir_fail(&b, span, "statement ForIn over a method, step or columns")
            ir_list_walk(&m, &p, &b, label, variable, variable_two, collection, body, span)
        }
        .DebugOnly(_, span) -> ir_fail(&b, span, "statement DebugOnly")
        .MixedSwitch(subject, _, arms, else_body, span) -> ir_mixed_switch(&m, &p, &b, subject, arms, else_body, span)
        .Unsafe(_, _) -> ir_fail(&b, Span{start: 0, end: 0}, "statement Unsafe")
        .UnsafeBlock(_, _, span) -> ir_fail(&b, span, "statement UnsafeBlock")
        .SentryPolicy(_, _, span) -> ir_fail(&b, span, "statement SentryPolicy")
        .Impure(_, span) -> ir_fail(&b, span, "statement Impure")
        .Reactive(_, span) -> ir_fail(&b, span, "statement Reactive")
        .Layout(_, _, _, span) -> ir_fail(&b, span, "statement Layout")
        .ContextBlock(_, _, span) -> ir_fail(&b, span, "statement ContextBlock")
        .Live(_, span) -> ir_fail(&b, span, "statement Live")
        .Shield(_, span) -> ir_fail(&b, span, "statement Shield")
        .ScopeMember(_, _, span) -> ir_fail(&b, span, "statement ScopeMember")
        .Transact(_, _, _, _, span) -> ir_fail(&b, span, "statement Transact")
        .GCEdit(_, _, _, _, _, _, span) -> ir_fail(&b, span, "statement GCEdit")
        .SplitViews(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, span) -> ir_fail(&b, span, "statement SplitViews")
        .Erased(_, _, _) -> {}
        .InvariantViolation(construct, span) -> ir_fail(&b, span, "checked invariant violation: {construct}")
    }
}

// `receiver.field (op)= value` through the aggregate's storage.
fn ir_assign_place(m: &IRModule, p: &IRProgram, b: &IRBuilder, place: TExpr, op: TBinaryOp?, value: TExpr, span: Span) Never! {
    if place.kind == .Field(receiver, field) {
        base :: ir_expr(&m, &p, &b, receiver)
        if ir_failed(b) -> return
        if base < 0 || ir_kind_of(m, b, base) != .Aggregate -> return ir_fail(&b, span, "assignment to a field of {ir_type_name(receiver.ty)}")
        member :: ir_member_of(&m, p, b, base, field.name) ?? return ir_fail(&b, span, "assignment to field {field.name}")
        right :: ir_expr(&m, &p, &b, value)
        if ir_failed(b) -> return
        result := right
        if op == .Val(binary) {
            current :: ir_member_read(&m, &b, base, member)
            site :: b.line
            result = ir_binary(&m, &p, &b, binary, false, site, field.ty, current, right, value.ty, span)
            ir_release(&m, &b, right)
            if ir_failed(b) -> return
        }
        if m.types[member.ty].drop != "" {
            old :: ir_member_read(&m, &b, base, member)
            ir_emit(&b.f, IROp.Drop, -1, old, -1, -1, b.line)
        }
        ir_member_write(&m, &b, base, member, result)
        return
    }
    ir_fail(&b, span, "assignment to {ir_expr_kind_name(place.kind)} place")
}

// Writes `value` into `slot`: a move for a type with a drop, else a copy.
fn ir_store(m: &IRModule, b: &IRBuilder, slot: Int, value: Int) Never! {
    if ir_kind_of(m, b, value) == .Aggregate && !b.fresh[value] {
        // An aggregate read from another place gets storage of its own.
        row :: m.types[b.f.slot_type[value]]
        ir_emit(&b.f, IROp.StackAddress, slot, row.size, row.align, -1, b.line)
        ir_emit(&b.f, IROp.CopyBytes, -1, slot, value, row.size, b.line)
        return
    }
    owned :: ir_own(&m, &b, value)
    op :: if ir_has_drop(m, b, owned) || ir_kind_of(m, b, owned) == .Aggregate -> IROp.Move else -> IROp.Copy
    ir_emit(&b.f, op, slot, owned, -1, -1, b.line)
    b.fresh[owned] = false
}

// `Br` out of the Block `exit` unless `test` holds.
fn ir_exit_unless(m: &IRModule, b: &IRBuilder, test: Int, exit: Int) Never! {
    negated :: ir_temp_like(&m, &b, test)
    ir_emit(&b.f, IROp.Not, negated, test, -1, -1, b.line)
    ir_emit(&b.f, IROp.BrIf, -1, negated, ir_depth(b.f, exit), -1, b.line)
}

fn ir_loop_frame(b: IRBuilder, label: String?) -> IRLoopFrame? Never! {
    index := b.loops.len() - 1
    loop index >= 0 {
        frame :: b.loops[index]
        if label == None || frame.label == label -> return Val(frame)
        index -= 1
    }
    None
}

// `loop i in start..end`: the bounds are evaluated once; `next` leaves the
// body's Block to the step.
fn ir_range_loop(m: &IRModule, p: &IRProgram, b: &IRBuilder, label: String?, local: TLocal, start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool, body: [TStmt], span: Span) Never! {
    if start.ty != Type.Int || end.ty != Type.Int -> return ir_fail(&b, span, "range loop over {ir_type_name(start.ty)}")
    first :: ir_expr(&m, &p, &b, start)
    last :: ir_expr(&m, &p, &b, end)
    if ir_failed(b) -> return
    by := -1
    descending := false
    if step == .Val(stride) {
        literal := 0
        if stride.kind == .IntLit(value, _) -> literal = value
        if stride.kind == .Unary(op, operand) {
            if op != .Not && operand.kind == .IntLit(value, _) -> literal = -value
        }
        if literal == 0 -> return ir_fail(&b, span, "range loop with a computed or zero step")
        descending = literal < 0
        by = ir_expr(&m, &p, &b, stride)
    } else {
        by = ir_temp_like(&m, &b, first)
        ir_emit(&b.f, IROp.Const, by, 1, -1, -1, b.line)
    }
    ir_scope_open(&b)
    counter_ty :: b.f.slot_type[first]
    counter :: ir_new_slot(&b, counter_ty, IRSlotKind.Local, ir_intern_name(&m, local.name))
    ir_emit(&b.f, IROp.Copy, counter, first, -1, -1, b.line)
    &b.bindings.push(IRBinding{name: local.name, slot: counter})
    exit :: ir_open(&b.f, IROp.Block, b.line)
    _ :: ir_open(&b.f, IROp.Loop, b.line)
    test :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
    compare :: if descending -> (if exclusive -> IROp.Gt else -> IROp.Ge) else -> (if exclusive -> IROp.Lt else -> IROp.Le)
    ir_emit(&b.f, compare, test, counter, last, -1, b.line)
    ir_exit_unless(&m, &b, test, exit)
    step_block :: ir_open(&b.f, IROp.Block, b.line)
    &b.loops.push(IRLoopFrame{label: label, exit: exit, next: step_block, mark: b.bindings.len()})
    ir_stmts(&m, &p, &b, body)
    _ :: &b.loops.pop()
    ir_end(&b.f, b.line)
    ir_emit(&b.f, IROp.Add, counter, counter, by, IR_OVERFLOW_TRAP, b.line)
    ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    ir_scope_close(&m, &b)
}

// A Bool slot holding an `if` condition.
fn ir_condition(m: &IRModule, p: &IRProgram, b: &IRBuilder, condition: TIfCond, span: Span) -> Int Never! {
    if condition == {
        .Plain(value) -> return ir_expr(&m, &p, &b, value)
        .And(left, right) -> {
            first :: ir_condition(&m, &p, &b, left, span)
            if ir_failed(b) -> return -1
            result :: ir_temp_like(&m, &b, first)
            ir_emit(&b.f, IROp.Copy, result, first, -1, -1, b.line)
            ir_open_condition(&m, &b, first)
            second :: ir_condition(&m, &p, &b, right, span)
            if ir_failed(b) -> return -1
            ir_emit(&b.f, IROp.Copy, result, second, -1, -1, b.line)
            ir_end(&b.f, b.line)
            return result
        }
        .WithPrelude(prelude, inner) -> {
            loop statement in prelude {
                if ir_failed(b) -> return -1
                ir_stmt(&m, &p, &b, statement)
            }
            return ir_condition(&m, &p, &b, inner, span)
        }
        .IfLet(pattern, subject) -> return ir_option_test(&m, &p, &b, pattern.shape, subject, span)
        .IsNone(subject) -> return ir_option_test(&m, &p, &b, TPatternShape.Absent{span: span}, subject, span)
        .Matches(pattern, subject) -> return ir_option_test(&m, &p, &b, pattern.shape, subject, span)
    }
    -1
}

// ---------------------------------------------------------------------------
// Expressions. Each returns the slot holding the value (-1 for Unit).

fn ir_expr(m: &IRModule, p: &IRProgram, b: &IRBuilder, expression: TExpr) -> Int Never! {
    if ir_failed(b) -> return -1
    span :: expression.span
    if expression.kind == {
        .IntLit(value, _) -> {
            ty :: ir_value_type(&m, p, expression.ty) ?? return ir_type_fail(&b, span, expression.ty)
            return ir_int_constant(&m, &b, ty, value)
        }
        .BoolLit(value) -> {
            slot :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
            ir_emit(&b.f, IROp.Const, slot, if value -> 1 else -> 0, -1, -1, b.line)
            return slot
        }
        .CharLit(value) -> {
            slot :: ir_temp(&m, &b, ir_type_row(&m, Type.Char) ?? 0)
            ir_emit(&b.f, IROp.Const, slot, value, -1, -1, b.line)
            return slot
        }
        .FloatLit(value) -> {
            ty :: ir_type_row(&m, expression.ty) ?? return ir_type_fail(&b, span, expression.ty)
            slot :: ir_temp(&m, &b, ty)
            ir_emit(&b.f, IROp.Const, slot, lower_float_constant_bits(value, expression.ty == Type.Float32), -1, -1, b.line)
            return slot
        }
        .StrLit(parts) -> return ir_string(&m, &p, &b, parts, span)
        .Unit -> return -1
        .Local(local) -> {
            binding :: ir_lookup_binding(b, local.name) ?? return ir_fail_slot(&b, span, "read of unknown local {local.name}")
            return ir_read_binding(&m, &b, binding)
        }
        .Move(value) -> {
            slot :: ir_expr(&m, &p, &b, value)
            return slot
        }
        .Print(value) -> {
            ir_print(&m, &p, &b, value, span)
            return -1
        }
        .Binary(op, overflow, line, lhs, rhs) -> {
            if line > 0 -> b.line = line
            if op == .And || op == .Or -> return ir_short_circuit(&m, &p, &b, op == .And, lhs, rhs)
            left :: ir_expr(&m, &p, &b, lhs)
            right :: ir_expr(&m, &p, &b, rhs)
            if ir_failed(b) -> return -1
            result :: ir_binary(&m, &p, &b, op, overflow, line, lhs.ty, left, right, rhs.ty, span)
            ir_release(&m, &b, left)
            ir_release(&m, &b, right)
            return result
        }
        .Unary(op, operand) -> {
            value :: ir_expr(&m, &p, &b, operand)
            if ir_failed(b) -> return -1
            kind :: ir_kind_of(m, b, value)
            if op == .Not {
                if kind != .Bool -> return ir_fail_slot(&b, span, "`!` on {ir_type_name(operand.ty)}")
                slot :: ir_temp_like(&m, &b, value)
                ir_emit(&b.f, IROp.Not, slot, value, -1, -1, b.line)
                return slot
            }
            if kind != .Int && kind != .Float && kind != .Float32 -> return ir_fail_slot(&b, span, "negation of {ir_type_name(operand.ty)}")
            slot :: if kind == .Int -> ir_fresh_like(&m, &b, value) else -> ir_temp_like(&m, &b, value)
            ir_emit(&b.f, IROp.Neg, slot, value, -1, IR_OVERFLOW_TRAP, b.line)
            ir_release(&m, &b, value)
            return slot
        }
        .Call(callee, type_args, args) -> {
            return ir_call(&m, &p, &b, callee.key, type_args, -1, [IRWriteBack]{}, args, span)
        }
        .MethodCall(receiver, method, type_args, args) -> {
            if type_args.len() > 0 && p.rows.get(method.symbol.key) == None -> return ir_fail_slot(&b, span, "generic method call outside the checked program")
            row :: p.rows.get(method.symbol.key) ?? return ir_fail_slot(&b, span, "method call outside the checked program (trait dispatch?): {method.name}")
            receiver_access :: ir_receiver_access(p.functions[row].kind)
            if receiver_access == "static" -> return ir_call(&m, &p, &b, method.symbol.key, type_args, -1, [IRWriteBack]{}, args, span)
            backs := [IRWriteBack]{}
            self_slot :: if receiver_access == "write" -> ir_place_address(&m, &p, &b, receiver, &backs, span) else -> ir_expr(&m, &p, &b, receiver)
            if ir_failed(b) -> return -1
            if self_slot < 0 -> return ir_fail_slot(&b, span, "Unit receiver")
            return ir_call(&m, &p, &b, method.symbol.key, type_args, self_slot, backs, args, span)
        }
        .IfExpr(cond, then_body, then_value, else_body, else_value) -> {
            ir_scope_open(&b)
            mark :: b.bindings.len()
            test :: ir_condition(&m, &p, &b, cond, span)
            if ir_failed(b) -> return -1
            unit :: ir_unit_type(expression.ty) || ir_never_type(expression.ty)
            result := -1
            if !unit {
                ty :: ir_value_type(&m, p, expression.ty) ?? return ir_type_fail(&b, span, expression.ty)
                result = ir_temp(&m, &b, ty)
            }
            ir_open_condition(&m, &b, test)
            ir_branch_value(&m, &p, &b, then_body, then_value, result)
            ir_else(&b.f, b.line)
            ir_truncate_bindings(&b, mark)
            ir_branch_value(&m, &p, &b, else_body, else_value, result)
            ir_end(&b.f, b.line)
            ir_scope_close(&m, &b)
            if result >= 0 -> b.fresh[result] = ir_has_drop(m, b, result)
            return result
        }
        .InlineBlock(body) -> {
            if ir_unit_type(expression.ty) || body.len() == 0 {
                ir_stmts(&m, &p, &b, body)
                return -1
            }
            // A valued block: its statements, then its last expression's value.
            ir_scope_open(&b)
            loop index in 0..<(body.len() - 1) {
                if ir_failed(b) -> break
                ir_stmt(&m, &p, &b, body[index])
            }
            value := -1
            if body[body.len() - 1] == .ExprStmt(tail, _) {
                // The value outlives the block's variables.
                value = ir_own(&m, &b, ir_expr(&m, &p, &b, tail))
            } else {
                ir_stmt(&m, &p, &b, body[body.len() - 1])
            }
            ir_scope_close(&m, &b)
            return value
        }
        .ExplicitCopy(value) | .Clone(value, _) -> {
            slot :: ir_expr(&m, &p, &b, value)
            if ir_failed(b) || slot < 0 -> return slot
            return ir_copy_value(&m, p, &b, slot, span)
        }
        .StructLit(fields, extra) -> {
            if extra != None -> return ir_fail_slot(&b, span, "struct literal with host extras")
            ty :: ir_value_type(&m, p, expression.ty) ?? return ir_type_fail(&b, span, expression.ty)
            if m.types[ty].kind != .Aggregate -> return ir_fail_slot(&b, span, "struct literal of {ir_type_name(expression.ty)}")
            storage :: ir_fresh_temp(&m, &b, ty)
            ir_emit(&b.f, IROp.StackAddress, storage, m.types[ty].size, 8, -1, b.line)
            loop field in fields {
                if field.boxed -> return ir_fail_slot(&b, span, "boxed struct field")
                member :: ir_member_of(&m, p, b, storage, field.field.name) ?? return ir_fail_slot(&b, span, "struct field {field.field.name}")
                value :: ir_expr(&m, &p, &b, field.value)
                if ir_failed(b) -> return -1
                if value < 0 -> return ir_fail_slot(&b, span, "Unit struct field")
                ir_member_write(&m, &b, storage, member, value)
            }
            return storage
        }
        .Field(receiver, field) -> {
            base :: ir_expr(&m, &p, &b, receiver)
            if ir_failed(b) -> return -1
            if base < 0 || ir_kind_of(m, b, base) != .Aggregate -> return ir_fail_slot(&b, span, "field of {ir_type_name(receiver.ty)}")
            member :: ir_member_of(&m, p, b, base, field.name) ?? return ir_fail_slot(&b, span, "field {field.name} of {ir_type_name(receiver.ty)}")
            return ir_member_read(&m, &b, base, member)
        }
        .HostCall(call) -> {
            if call == .SwitchSubjectValue {
                subject :: if b.subjects.len() > 0 -> b.subjects[b.subjects.len() - 1] else -> -1
                if subject < 0 -> return ir_fail_slot(&b, span, "switch subject outside a switch")
                return subject
            }
            if call == .SwitchSubjectField(name) {
                subject :: if b.subjects.len() > 0 -> b.subjects[b.subjects.len() - 1] else -> -1
                if subject < 0 || ir_kind_of(m, b, subject) != .Aggregate -> return ir_fail_slot(&b, span, "switch subject field {name} outside a struct switch")
                member :: ir_member_of(&m, p, b, subject, name) ?? return ir_fail_slot(&b, span, "switch subject field {name}")
                return ir_member_read(&m, &b, subject, member)
            }
            if call == .ComptimeInput(builtin, path) {
                // A comptime input (embed_file, embed_bytes, find) the checked
                // program names by its literal; the evaluator answers it.
                row :: ir_value_type(&m, p, expression.ty) ?? return ir_type_fail(&b, span, expression.ty)
                builtin_text :: ir_temp(&m, &b, ir_string_row(&m))
                ir_emit(&b.f, IROp.ConstText, builtin_text, ir_intern_text(&m, builtin), -1, -1, b.line)
                path_text :: ir_temp(&m, &b, ir_string_row(&m))
                ir_emit(&b.f, IROp.ConstText, path_text, ir_intern_text(&m, path), -1, -1, b.line)
                return ir_runtime(&m, &b, "jet_comptime_input", [Int]{builtin_text, path_text}, row)
            }
            if call == .TupleIndex(base, index) {
                tuple :: ir_expr(&m, &p, &b, base)
                if ir_failed(b) -> return -1
                fields :: if ir_untag(ir_subst(p, base.ty)) == .Tuple(fields) -> fields else -> { return ir_fail_slot(&b, span, "tuple index of {ir_type_name(base.ty)}") }
                members :: ir_tuple_members(&m, p, fields) ?? return ir_type_fail(&b, span, base.ty)
                if tuple < 0 || index < 0 || index >= members.len() -> return ir_fail_slot(&b, span, "tuple index {index} of {ir_type_name(base.ty)}")
                return ir_member_read(&m, &b, tuple, members[index])
            }
            return ir_fail_slot(&b, span, "host call {ir_host_call_name(call)}")
        }
        .EnumLit(enum_type, variant, payload) -> return ir_enum_value(&m, &p, &b, expression.ty, enum_type, variant, payload, span)
        .EnumCtor(owner, variant, payload) -> return ir_enum_value(&m, &p, &b, expression.ty, owner.key, variant.key, payload, span)
        .Present(value) -> return ir_present(&m, &p, &b, expression.ty, value, span)
        .Absent -> {
            row :: ir_value_type(&m, p, expression.ty) ?? return ir_type_fail(&b, span, expression.ty)
            slot :: ir_temp(&m, &b, row)
            ir_emit(&b.f, IROp.Const, slot, 0, -1, -1, b.line)
            return slot
        }
        .Ok(value) -> return ir_result_ctor(&m, &p, &b, expression.ty, value, true, span)
        .Err(value) -> return ir_result_ctor(&m, &p, &b, expression.ty, value, false, span)
        .Try(value, conversion, _) -> return ir_try(&m, &p, &b, value, conversion, span)
        // The context note only annotates an error's report on its way out.
        .TryWithContext(inner, _, conversion, _, _, _) -> return ir_try(&m, &p, &b, inner, conversion, span)
        .OrFallback(value, fallback, ambient) -> return ir_or_fallback(&m, &p, &b, expression.ty, value, fallback, ambient, span)
        .ConstRef(symbol) -> return ir_constant(&m, &p, &b, expression.ty, symbol.key, span)
        .CtLit(value) -> return ir_comptime(&m, &p, &b, expression.ty, value, span)
        .ListLit(values) -> return ir_list_literal(&m, &p, &b, expression.ty, values, span)
        .List(values, coercion) -> {
            if coercion != None -> return ir_fail_slot(&b, span, "list literal with a trait coercion")
            return ir_list_literal(&m, &p, &b, expression.ty, values, span)
        }
        .IndexRead(base, index, is_map, uninit, line) -> {
            if is_map || uninit -> return ir_fail_slot(&b, span, "index read of a map or fixed list")
            if line > 0 -> b.line = line
            return ir_list_index(&m, &p, &b, base, index, span)
        }
        .BuiltinMethod(receiver, operation, args) -> return ir_builtin(&m, &p, &b, expression.ty, receiver, operation, args, span)
        .RequireStop(kind, location, always_stops) -> return ir_require_stop(&m, &p, &b, kind, location, always_stops, span)
        .ClosureMethod(receiver, operation, args) -> return ir_closure_method(&m, &p, &b, expression.ty, receiver, operation, args, span)
        .Index(base, index, kind, _, _, _) -> {
            if kind != .List && kind != .FixedListProof -> return ir_fail_slot(&b, span, "index of kind {kind}")
            return ir_list_index(&m, &p, &b, base, index, span)
        }
        .Lambda(value) | .LambdaValue(value) -> return ir_lambda(&m, &p, &b, expression.ty, value, span)
        .IndirectCall(callee, type_args, args, signature) -> {
            if type_args.len() > 0 -> return ir_fail_slot(&b, span, "generic indirect call")
            return ir_indirect_call(&m, &p, &b, callee, args, signature, span)
        }
        .Tuple(values) -> {
            names := [String]{}
            loop index in 0..<values.len() -> &names.push("{index}")
            return ir_tuple_literal(&m, &p, &b, expression.ty, names, values, span)
        }
        .TupleLit(_, fields) -> {
            names := [String]{}
            values := [TExpr]{}
            loop field in fields {
                &names.push(field.name)
                &values.push(field.value)
            }
            return ir_tuple_literal(&m, &p, &b, expression.ty, names, values, span)
        }
        .CoreCall(record, args, _, type_args, widen_to_vec, _, _) -> return ir_core_call(&m, &p, &b, expression.ty, record, args, type_args, widen_to_vec, span)
        .NumericMethod(receiver, operation) -> return ir_numeric_method(&m, &p, &b, expression.ty, receiver, operation, span)
        .Never(reason) -> {
            // codegen jet_codegen_lower_never: Lower stops through jet_rt_unreachable.
            _ :: ir_runtime(&m, &b, "jet_rt_unreachable", ir_static_text(&m, &b, reason), -1)
            ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
            return ir_unreachable_value(&m, p, &b, expression.ty)
        }
        .PatternMatches(subject, pattern) -> {
            // A test only (codegen lowers the pattern condition without binding).
            pending :: b.pending.len()
            test :: ir_option_test(&m, &p, &b, pattern.shape, subject, span)
            loop b.pending.len() > pending {
                _ :: &b.pending.pop()
            }
            return test
        }
        .Unreachable(line) -> {
            if line > 0 -> b.line = line
            ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
            return ir_unreachable_value(&m, p, &b, expression.ty)
        }
        else -> return ir_fail_slot(&b, span, "expression {ir_expr_kind_name(expression.kind)}")
    }
}

fn ir_fail_slot(b: &IRBuilder, span: Span, message: String) -> Int Never! {
    ir_fail(&b, span, message)
    return -1
}

fn ir_type_fail(b: &IRBuilder, span: Span, ty: Type) -> Int Never! {
    ir_fail_slot(&b, span, "type {ir_type_name(ty)}")
}

// The arm of a valued `if`: its statements, then its value into `result`.
fn ir_branch_value(m: &IRModule, p: &IRProgram, b: &IRBuilder, body: [TStmt], value: TExpr, result: Int) Never! {
    ir_scope_open(&b)
    loop statement in body {
        if ir_failed(b) -> break
        ir_stmt(&m, &p, &b, statement)
    }
    target_row :: if result >= 0 -> b.f.slot_type[result] else -> -1
    slot :: if result >= 0 -> ir_value_as(&m, &p, &b, value, target_row, value.span) else -> ir_expr(&m, &p, &b, value)
    if !ir_failed(b) && result >= 0 && slot >= 0 -> ir_store(&m, &b, result, slot)
    if !ir_failed(b) && result < 0 -> ir_release(&m, &b, slot)
    ir_scope_close(&m, &b)
}

// `a && b` / `a || b`: `b` runs only when `a` does not decide.
fn ir_short_circuit(m: &IRModule, p: &IRProgram, b: &IRBuilder, is_and: Bool, lhs: TExpr, rhs: TExpr) -> Int Never! {
    left :: ir_expr(&m, &p, &b, lhs)
    if ir_failed(b) -> return -1
    result :: ir_temp_like(&m, &b, left)
    ir_emit(&b.f, IROp.Copy, result, left, -1, -1, b.line)
    test := left
    if !is_and {
        test = ir_temp_like(&m, &b, left)
        ir_emit(&b.f, IROp.Not, test, left, -1, -1, b.line)
    }
    ir_open_if(&b.f, test, b.line)
    right :: ir_expr(&m, &p, &b, rhs)
    if ir_failed(b) -> return -1
    ir_emit(&b.f, IROp.Copy, result, right, -1, -1, b.line)
    ir_end(&b.f, b.line)
    result
}

// A runtime route call with a fresh result of type row `ty` (-1: none).
fn ir_runtime(m: &IRModule, b: &IRBuilder, symbol: String, args: [Int], ty: Int) -> Int Never! {
    dst :: if ty >= 0 -> ir_fresh_temp(&m, &b, ty) else -> -1
    start :: ir_args(&b.f, args)
    ir_emit(&b.f, IROp.CallRuntime, dst, ir_intern_name(&m, symbol), start, args.len(), b.line)
    dst
}

// The static text pair (data address, byte length) of `text`.
fn ir_static_text(m: &IRModule, b: &IRBuilder, text: String) -> [Int] Never! {
    pointer :: ir_temp(&m, &b, ir_pointer_row(&m))
    ir_emit(&b.f, IROp.DataAddress, pointer, ir_intern_text(&m, text), -1, -1, b.line)
    length :: ir_temp(&m, &b, ir_word_row(&m))
    ir_emit(&b.f, IROp.Const, length, text.bytes().len(), -1, -1, b.line)
    [Int]{pointer, length}
}

fn ir_pointer_row(m: &IRModule) -> Int Never! {
    ir_intern_type(&m, "pointer", ir_layout(IRTypeKind.Pointer, Type.Named{name: "Pointer"}, 8, 8, IRClass.Pointer, false, 64, ""))
}

fn ir_word_row(m: &IRModule) -> Int Never! {
    ir_type_row(&m, Type.IntN{signed: true, bits: 64}) ?? 0
}

fn ir_string_row(m: &IRModule) -> Int Never! {
    ir_type_row(&m, Type.String) ?? 0
}

// A source location argument triple: (path address, path length, line), as
// lower_location passes it.
fn ir_location(m: &IRModule, b: &IRBuilder, line: Int) -> [Int] Never! {
    path :: b.f.source_file
    args := ir_static_text(&m, &b, path)
    slot :: ir_temp(&m, &b, ir_word_row(&m))
    ir_emit(&b.f, IROp.Const, slot, line, -1, -1, b.line)
    &args.push(slot)
    args
}

// A string literal: an immortal static text when every part is literal,
// else a runtime builder fed each part (Lower lower_build_string).
fn ir_string(m: &IRModule, p: &IRProgram, b: &IRBuilder, parts: [TStrPart], span: Span) -> Int Never! {
    literal := ""
    all_literal := true
    loop part in parts {
        if part == {
            .Literal(text) -> literal = "{literal}{text}"
            .Interpolation(_, _) -> all_literal = false
        }
    }
    if all_literal {
        slot :: ir_temp(&m, &b, ir_string_row(&m))
        ir_emit(&b.f, IROp.ConstText, slot, ir_intern_text(&m, literal), -1, -1, b.line)
        return slot
    }
    builder :: ir_runtime(&m, &b, "jet_rt_string_builder_new", [Int]{}, ir_pointer_row(&m))
    b.fresh[builder] = false
    loop part in parts {
        if part == {
            .Literal(text) -> {
                args := [Int]{builder}
                loop arg in ir_static_text(&m, &b, text) -> &args.push(arg)
                _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push_static", args, -1)
            }
            .Interpolation(value, format) -> {
                debug :: if format == {
                    .Display -> false
                    .Debug -> true
                    else -> { return ir_fail_slot(&b, span, "interpolation format {format}") }
                }
                slot :: ir_expr(&m, &p, &b, value)
                if ir_failed(b) -> return -1
                text :: ir_render(&m, p, &b, value.ty, slot, if debug -> IRRender.Debug else -> IRRender.Display, span)
                if ir_failed(b) -> return -1
                _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
                ir_release(&m, &b, text)
                ir_release(&m, &b, slot)
            }
        }
    }
    ir_runtime(&m, &b, "jet_rt_string_builder_finish", [Int]{builder}, ir_string_row(&m))
}

enum IRRender { Display Show Debug }

// The String showing `slot` (Lower lower_render_value): a String renders as
// itself (not fresh); scalars through their runtime formatter (fresh).
fn ir_render(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, slot: Int, mode: IRRender, span: Span) -> Int Never! {
    if ir_unit_type(ty) {
        builder :: ir_runtime(&m, &b, "jet_rt_string_builder_new", [Int]{}, ir_pointer_row(&m))
        b.fresh[builder] = false
        ir_push_static(&m, &b, builder, "()")
        return ir_runtime(&m, &b, "jet_rt_string_builder_finish", [Int]{builder}, ir_string_row(&m))
    }
    if slot < 0 -> return ir_fail_slot(&b, span, "display of {ir_type_name(ty)} without a value")
    selected :: ir_render_impl(&m, p, &b, slot, mode)
    if selected >= 0 -> return selected
    kind :: ir_kind_of(m, b, slot)
    if kind == .String {
        if mode != .Debug -> return slot
        return ir_runtime(&m, &b, "jet_rt_require_debug_string", [Int]{slot}, ir_string_row(&m))
    }
    if kind == .Aggregate || ir_carrier_type(ty) || ir_enum_def(m, p, b.f.slot_type[slot]) != None {
        builder :: ir_runtime(&m, &b, "jet_rt_string_builder_new", [Int]{}, ir_pointer_row(&m))
        b.fresh[builder] = false
        ir_render_push(&m, p, &b, builder, slot, mode, false, span)
        return ir_runtime(&m, &b, "jet_rt_string_builder_finish", [Int]{builder}, ir_string_row(&m))
    }
    row :: m.types[b.f.slot_type[slot]]
    symbol :: if kind == {
        .Int -> "jet_rt_int_to_string"
        .Char -> "jet_rt_char_to_string"
        .Word -> if row.signed -> "jet_rt_i64_to_string" else -> "jet_rt_u64_to_string"
        .Bool -> "jet_rt_bool_to_string"
        .Float -> if mode == .Debug -> "jet_rt_float_debug" else -> "jet_rt_float_to_string"
        .Float32 -> if mode == .Debug -> "jet_rt_float32_debug" else -> "jet_rt_float32_to_string"
        else -> { return ir_fail_slot(&b, span, "display of {ir_type_name(ty)}") }
    }
    ir_runtime(&m, &b, symbol, [Int]{slot}, ir_string_row(&m))
}

fn ir_push_static(m: &IRModule, b: &IRBuilder, builder: Int, text: String) Never! {
    args := [Int]{builder}
    loop arg in ir_static_text(&m, &b, text) -> &args.push(arg)
    _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push_static", args, -1)
}

// The owned String a selected Display (`display`) or Printable (`show`)
// implementation makes of `slot` (Lower lower_render_value; Debug never uses
// one), or -1 when none is selected.
fn ir_render_impl(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int, mode: IRRender) -> Int Never! {
    if mode == .Debug || p.render_impls.len() == 0 -> return -1
    trait_short :: if mode == .Show -> "Printable" else -> "Display"
    row :: p.render_impls.get("{trait_short}|{ir_render_type_key(p.type_rows, p.types, m.types[b.f.slot_type[slot]].ty)}") ?? return -1
    function :: p.functions[row]
    returned :: ir_executable_return(function) ?? return -1
    result_row :: ir_value_type(&m, p, returned) ?? return -1
    dst :: ir_fresh_temp(&m, &b, result_row)
    start :: ir_args(&b.f, [Int]{slot})
    at :: ir_emit(&b.f, IROp.Call, dst, -1, start, 1, b.line)
    &b.deferred.push(IRDeferredCall{at: at, key: function.key})
    text :: ir_adapt(&m, p, &b, dst, ir_string_row(&m), Span{start: 0, end: 0})
    if text != dst -> b.fresh[text] = true
    text
}

// Pushes the rendering of `slot` onto `builder` (Lower lower_render_push /
// lower_render_member_push when `member`: a String member renders quoted).
fn ir_render_push(m: &IRModule, p: IRProgram, b: &IRBuilder, builder: Int, slot: Int, mode: IRRender, member: Bool, span: Span) Never! {
    kind :: ir_kind_of(m, b, slot)
    ty :: m.types[b.f.slot_type[slot]].ty
    selected :: ir_render_impl(&m, p, &b, slot, mode)
    if selected >= 0 {
        _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, selected}, -1)
        ir_release(&m, &b, selected)
        return
    }
    if kind == .String && member {
        quoted :: ir_runtime(&m, &b, "jet_rt_require_debug_string", [Int]{slot}, ir_string_row(&m))
        _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, quoted}, -1)
        ir_release(&m, &b, quoted)
        return
    }
    if ir_untag(ty) == .Option(payload) {
        ir_render_option(&m, p, &b, builder, slot, payload, mode, span)
        return
    }
    if ir_untag(ty) == .Result(ok, err) {
        ir_render_result(&m, p, &b, builder, slot, ok, err, mode, span)
        return
    }
    if ir_untag(ty) == .List(element) {
        ir_render_list(&m, p, &b, builder, slot, element, mode, span)
        return
    }
    if ir_enum_def(m, p, b.f.slot_type[slot]) == .Val(row) {
        if p.types[row].kind == .Enum(variants, methods) {
            if ir_render_hook(methods) -> return ir_fail(&b, span, "enum with a show hook")
            discriminant :: ir_enum_tag_of(&m, &b, slot)
            opened := 0
            loop (index, variant) in variants {
                index_slot :: ir_temp_like(&m, &b, discriminant)
                ir_emit(&b.f, IROp.Const, index_slot, index, -1, -1, b.line)
                test :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
                ir_emit(&b.f, IROp.Eq, test, discriminant, index_slot, -1, b.line)
                ir_open_if(&b.f, test, b.line)
                members :: ir_variant_members(&m, p, row, index) ?? return ir_fail(&b, span, "display of variant {variant.name}")
                if variant.payload == {
                    .Unit -> ir_push_static(&m, &b, builder, ir_render_name(variant.name))
                    .Single(_) -> {
                        ir_push_static(&m, &b, builder, "{ir_render_name(variant.name)}(")
                        ir_render_push_value_member(&m, p, &b, builder, ir_member_value(&m, &b, slot, members[0]), mode, span)
                        ir_push_static(&m, &b, builder, ")")
                    }
                    .Named(_) -> ir_render_record(&m, p, &b, builder, slot, variant.name, members, mode, span)
                }
                ir_else(&b.f, b.line)
                opened += 1
            }
            ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
            loop _ in 0..<opened -> ir_end(&b.f, b.line)
        }
        return
    }
    if kind == .Aggregate && ir_untag(ty) == .Tuple(fields) {
        members :: ir_tuple_members(&m, p, fields) ?? return ir_fail(&b, span, "display of {ir_type_name(ty)}")
        ir_push_static(&m, &b, builder, "(")
        loop (index, field) in members {
            if index > 0 -> ir_push_static(&m, &b, builder, ", ")
            ir_render_push_value_member(&m, p, &b, builder, ir_member_read(&m, &b, slot, field), mode, span)
        }
        if members.len() == 1 -> ir_push_static(&m, &b, builder, ",")
        ir_push_static(&m, &b, builder, ")")
        return
    }
    if kind == .Aggregate {
        name :: ir_nominal_name(ty) ?? return ir_fail(&b, span, "display of {ir_type_name(ty)}")
        row :: ir_type_def(p, name) ?? return ir_fail(&b, span, "display of {ir_type_name(ty)}")
        if p.types[row].kind == .Struct(_, methods) {
            if ir_render_hook(methods) -> return ir_fail(&b, span, "struct with a show hook")
        }
        members :: ir_struct_members(&m, p, row) ?? return ir_fail(&b, span, "display of {ir_type_name(ty)}")
        ir_render_record(&m, p, &b, builder, slot, p.types[row].name, members, mode, span)
        return
    }
    text :: ir_render(&m, p, &b, ty, slot, mode, span)
    if ir_failed(b) -> return
    _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
    if text != slot -> ir_release(&m, &b, text)
}

// Whether a declaration's methods include a source display hook.
fn ir_render_hook(methods: [String]) -> Bool Never! {
    loop method in methods {
        if method == "show" || method == "display" || method == "debug" -> return true
    }
    false
}

// Lower lower_render_name: a generated `__jet_` prefix is not shown.
fn ir_render_name(name: String) -> String Never! {
    if !name.starts_with("__jet_") -> return name.copy()
    bytes :: name.bytes()
    String.from_bytes(bytes.slice(6, bytes.len())) ?? name.copy()
}

fn ir_nominal_name(ty: Type) -> String? Never! {
    if ty == {
        .Named(name) -> Val(name)
        .Apply(name, _) -> Val(name)
        else -> None
    }
}

// One stored struct member: its byte offset and type row.
// `boxed`: a recursive edge whose storage is a wrapper box pointer holding
// the value; `redact`: Debug display hides it.
struct IRMember { name: String, offset: Int, ty: Int, boxed: Bool{false}, redact: Bool{false} }

// The stored members of struct declaration `row` at their natural offsets
// (Lower Values.jet lower_inline_size: each member at its own alignment,
// computed fields take no bytes); None when a member cannot be laid out or
// is a recursive (boxed) edge.
fn ir_struct_members(m: &IRModule, p: IRProgram, row: Int) -> [IRMember]? Never! {
    ir_struct_members_in(&m, p, row, [String]{})
}

fn ir_struct_members_in(m: &IRModule, p: IRProgram, row: Int, laying: [String]) -> [IRMember]? Never! {
    definition :: p.types[row]
    if definition.kind == .Struct(fields, _) {
        inner := laying
        &inner.push(definition.key)
        members := [IRMember]{}
        offset := 0
        loop field in fields {
            if field.computed -> next
            if definition.boxed_edges.contains(field.name) -> return None
            ty :: ir_value_type_in(&m, p, field.ty, inner) ?? return None
            size :: m.types[ty].size
            align :: if m.types[ty].kind == .Aggregate -> 8 else -> m.types[ty].align
            if size > 0 && align > 0 && offset % align != 0 -> offset += align - offset % align
            &members.push(IRMember{name: field.name, offset: offset, ty: ty, redact: field.redact})
            offset += size
        }
        return Val(members)
    }
    None
}

// The bytes of a struct of `members`, rounded to 8.
fn ir_struct_size(m: IRModule, members: [IRMember]) -> Int Never! {
    size := 0
    loop member in members {
        end :: member.offset + m.types[member.ty].size
        if end > size -> size = end
    }
    if size % 8 != 0 -> size += 8 - size % 8
    size
}

// A member of the aggregate at `base`: a nested aggregate is its address,
// a scalar a load (not owned: the aggregate keeps it).
fn ir_member_read(m: &IRModule, b: &IRBuilder, base: Int, member: IRMember) -> Int Never! {
    slot :: ir_temp(&m, &b, member.ty)
    if m.types[member.ty].kind == .Aggregate {
        ir_emit(&b.f, IROp.Offset, slot, base, member.offset, -1, b.line)
    } else {
        ir_emit(&b.f, IROp.Load, slot, base, member.offset, -1, b.line)
    }
    slot
}

// Writes `value` into the member of the aggregate at `base`.
fn ir_member_write(m: &IRModule, b: &IRBuilder, base: Int, member: IRMember, value: Int) Never! {
    if m.types[member.ty].kind == .Aggregate {
        address :: ir_temp(&m, &b, member.ty)
        ir_emit(&b.f, IROp.Offset, address, base, member.offset, -1, b.line)
        ir_emit(&b.f, IROp.CopyBytes, -1, address, value, m.types[member.ty].size, b.line)
        b.fresh[value] = false
        return
    }
    owned :: ir_own(&m, &b, value)
    ir_emit(&b.f, IROp.Store, -1, base, member.offset, owned, b.line)
    b.fresh[owned] = false
}

// The member `name` of the struct an aggregate slot holds.
fn ir_member_of(m: &IRModule, p: IRProgram, b: IRBuilder, base: Int, name: String) -> IRMember? Never! {
    ty :: ir_untag(m.types[b.f.slot_type[base]].ty)
    members := [IRMember]{}
    if ty == .Tuple(fields) {
        members = ir_tuple_members(&m, p, fields) ?? return None
    } else {
        nominal :: ir_nominal_name(ty) ?? return None
        row :: ir_type_def(p, nominal) ?? return None
        members = ir_struct_members(&m, p, row) ?? return None
    }
    loop member in members {
        if member.name == name -> return Val(member)
    }
    None
}

// The members of a tuple type at their natural offsets (as a struct of
// its fields, in their canonical order).
fn ir_tuple_members(m: &IRModule, p: IRProgram, fields: [TypeTupleField]) -> [IRMember]? Never! {
    ir_tuple_members_in(&m, p, fields, [String]{})
}

fn ir_tuple_members_in(m: &IRModule, p: IRProgram, fields: [TypeTupleField], laying: [String]) -> [IRMember]? Never! {
    members := [IRMember]{}
    offset := 0
    loop field in fields {
        ty :: ir_value_type_in(&m, p, field.ty, laying) ?? return None
        size :: m.types[ty].size
        align :: if m.types[ty].kind == .Aggregate -> 8 else -> m.types[ty].align
        if size > 0 && align > 0 && offset % align != 0 -> offset += align - offset % align
        &members.push(IRMember{name: field.name, offset: offset, ty: ty})
        offset += size
    }
    Val(members)
}

// `print(value)`: its shown text to stdout with a line end and a flush
// (Lower semantic Print: jet_term_write_stdout_line(text, flush 1)).
fn ir_print(m: &IRModule, p: &IRProgram, b: &IRBuilder, value: TExpr, span: Span) Never! {
    slot :: ir_expr(&m, &p, &b, value)
    if ir_failed(b) -> return
    text :: ir_render(&m, p, &b, value.ty, slot, IRRender.Show, span)
    if ir_failed(b) -> return
    flush :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
    ir_emit(&b.f, IROp.Const, flush, 1, -1, -1, b.line)
    _ :: ir_runtime(&m, &b, "jet_term_write_stdout_line", [Int]{text, flush}, -1)
    if text != slot -> ir_release(&m, &b, text)
    ir_release(&m, &b, slot)
}

fn ir_binary_op(op: TBinaryOp) -> IROp? Never! {
    if op == {
        .Add -> Val(IROp.Add)
        .Sub -> Val(IROp.Sub)
        .Mul -> Val(IROp.Mul)
        .Div -> Val(IROp.Div)
        .Rem -> Val(IROp.Rem)
        .FloorDiv -> Val(IROp.FloorDiv)
        .Mod -> Val(IROp.Mod)
        .BitAnd -> Val(IROp.BitAnd)
        .BitOr -> Val(IROp.BitOr)
        .BitXor -> Val(IROp.BitXor)
        .Shl -> Val(IROp.Shl)
        .Shr -> Val(IROp.Shr)
        .Eq -> Val(IROp.Eq)
        .Ne -> Val(IROp.Ne)
        .Lt -> Val(IROp.Lt)
        .Le -> Val(IROp.Le)
        .Gt -> Val(IROp.Gt)
        .Ge -> Val(IROp.Ge)
        else -> None
    }
}

fn ir_compare_op(op: TBinaryOp) -> Bool Never! {
    op == .Eq || op == .Ne || op == .Lt || op == .Le || op == .Gt || op == .Ge
}

fn ir_route_member(op: TBinaryOp) -> String Never! {
    if op == {
        .Div -> "div"
        .Rem -> "rem"
        .FloorDiv -> "floor_div"
        .Mod -> "mod"
        .Pow -> "pow"
        .Shl -> "shl"
        .Shr -> "shr"
        .Add -> "add"
        .Sub -> "sub"
        .Mul -> "mul"
        else -> ""
    }
}

// `left op right` (codegen jet_codegen_binary_dispatch + Lower lower_binary):
// exact Int `+ - *` and comparisons are IR ops (inline with a big-integer
// spill); its other operators call their located Prelude route; a fixed
// width with overflow checking (or a trapping op) calls jet_<w>_trap_<op>.
fn ir_binary(m: &IRModule, p: &IRProgram, b: &IRBuilder, op: TBinaryOp, overflow: Bool, line: Int, left_ty: Type, left: Int, right: Int, right_ty: Type, span: Span) -> Int Never! {
    if left < 0 || right < 0 -> return ir_fail_slot(&b, span, "binary operator on Unit")
    kind :: ir_kind_of(m, b, left)
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    site :: if line > 0 -> line else -> b.line
    if ir_compare_op(op) {
        if kind == .String && op != .Eq && op != .Ne -> return ir_fail_slot(&b, span, "String ordering comparison")
        if kind != .Int && kind != .Word && kind != .Bool && kind != .Char && kind != .Float && kind != .Float32 && kind != .String -> return ir_fail_slot(&b, span, "comparison of {ir_type_name(left_ty)}")
        dst :: ir_temp(&m, &b, bool_row)
        ir_emit(&b.f, ir_binary_op(op) ?? IROp.Eq, dst, left, right, -1, site)
        return dst
    }
    if op == .Compare -> return ir_fail_slot(&b, span, "three-way comparison")
    if kind == .String {
        if op != .Add || right_ty != Type.String -> return ir_fail_slot(&b, span, "String operator {op}")
        dst :: ir_fresh_like(&m, &b, left)
        ir_emit(&b.f, IROp.Concat, dst, left, right, -1, site)
        return dst
    }
    if kind == .Int {
        // Exact Int `+ - *` and bit operators are IR ops (inline with a
        // big-integer spill in the selector); the rest call located routes.
        if op == .Add || op == .Sub || op == .Mul || op == .BitAnd || op == .BitOr || op == .BitXor || op == .Shl || op == .Shr {
            dst :: ir_fresh_like(&m, &b, left)
            ir_emit(&b.f, ir_binary_op(op) ?? IROp.Add, dst, left, right, IR_OVERFLOW_TRAP, site)
            return dst
        }
        member :: ir_route_member(op)
        if member == "" -> return ir_fail_slot(&b, span, "exact Int operator {op}")
        args := [Int]{left, right}
        loop arg in ir_location(&m, &b, site) -> &args.push(arg)
        result_ty :: b.f.slot_type[left]
        return ir_runtime(&m, &b, "jet_int_{member}", args, result_ty)
    }
    if kind == .Word {
        trapping :: op == .Rem || op == .FloorDiv || op == .Mod || op == .Pow
        bitwise :: op == .BitAnd || op == .BitOr || op == .BitXor
        if op == .Pow -> return ir_fail_slot(&b, span, "fixed-width power")
        ir_op :: ir_binary_op(op) ?? return ir_fail_slot(&b, span, "fixed-width operator {op}")
        // The old trap routes (jet_<w>_trap_<op>) are native checked operators.
        policy :: if (overflow || trapping) && !bitwise -> IR_OVERFLOW_TRAP else -> IR_OVERFLOW_WRAP
        dst :: ir_temp_like(&m, &b, left)
        ir_emit(&b.f, ir_op, dst, left, right, policy, site)
        return dst
    }
    if kind == .Float || kind == .Float32 {
        if op != .Add && op != .Sub && op != .Mul && op != .Div -> return ir_fail_slot(&b, span, "Float operator {op}")
        dst :: ir_temp_like(&m, &b, left)
        ir_emit(&b.f, ir_binary_op(op) ?? IROp.Add, dst, left, right, -1, site)
        return dst
    }
    ir_fail_slot(&b, span, "operator {op} on {ir_type_name(left_ty)}")
}

// A call of a checked user function: arguments in order; a fresh argument
// passed to a read parameter is dropped after the call, one passed to a
// move parameter belongs to the callee. A write argument passes the address
// of its place; `backs` (the receiver's, then each argument's) read frame
// cells back into their variables after the call. The result has the
// callee's executable return type.
fn ir_call(m: &IRModule, p: &IRProgram, b: &IRBuilder, key: String, type_args: [Type], receiver: Int, receiver_backs: [IRWriteBack], args: [TCallArg], span: Span) -> Int Never! {
    row :: p.rows.get(key) ?? return ir_fail_slot(&b, span, "call of a function outside the checked program: {key}")
    callee :: ir_function_id(&m, &p, key, type_args) ?? return ir_fail_slot(&b, span, "call of {key}")
    params :: p.functions[row].params
    // The callee's parameter and return types in concrete terms.
    names :: if type_args.len() > 0 -> ir_generic_names(p.functions[row]) else -> [String]{}
    concrete := [Type]{}
    loop arg in type_args -> &concrete.push(ir_subst(p, arg))
    if params.len() != args.len() -> return ir_fail_slot(&b, span, "call with defaulted or variadic arguments")
    slots := [Int]{}
    moves := [Bool]{}
    backs := receiver_backs
    if receiver >= 0 {
        &slots.push(if ir_receiver_access(p.functions[row].kind) == "move" -> ir_own(&m, &b, receiver) else -> receiver)
        &moves.push(ir_receiver_access(p.functions[row].kind) == "move")
    }
    loop (index, arg) in args {
        if arg.fn_coerce != None || arg.widen_to_vec || arg.widen_to_union != None || arg.box_as_trait != None || arg.spread -> return ir_fail_slot(&b, span, "coerced call argument")
        if params[index].convention == .Write || arg.mut_borrow {
            address :: ir_place_address(&m, &p, &b, arg.value, &backs, span)
            if ir_failed(b) -> return -1
            &slots.push(address)
            &moves.push(false)
            next
        }
        param_ty :: if names.len() > 0 -> ir_subst_in(names, concrete, params[index].ty) else -> params[index].ty
        param_row :: ir_value_type(&m, p, param_ty) ?? return ir_fail_slot(&b, span, "argument type {ir_type_name(param_ty)}")
        slot :: ir_value_as(&m, &p, &b, arg.value, param_row, span)
        if ir_failed(b) -> return -1
        if slot < 0 -> return ir_fail_slot(&b, span, "Unit call argument")
        &slots.push(if params[index].convention == .Move -> ir_own(&m, &b, slot) else -> slot)
        &moves.push(params[index].convention == .Move)
    }
    dst := -1
    written_return :: ir_executable_return(p.functions[row]) ?? Type.Named{name: "Unit"}
    returned :: if names.len() > 0 -> ir_subst_in(names, concrete, written_return) else -> written_return
    if !ir_unit_type(returned) {
        result :: ir_value_type(&m, p, returned) ?? return ir_type_fail(&b, span, returned)
        dst = ir_fresh_temp(&m, &b, result)
    }
    start :: ir_args(&b.f, slots)
    ir_emit(&b.f, IROp.Call, dst, callee, start, slots.len(), b.line)
    loop back in backs -> ir_emit(&b.f, IROp.Load, back.slot, back.cell, 0, -1, b.line)
    loop (index, slot) in slots {
        if moves[index] {
            b.fresh[slot] = false
        } else {
            ir_release(&m, &b, slot)
        }
    }
    dst
}

// The address of a write place: an aggregate variable is its storage, a
// forwarded write parameter its caller's address, any other variable a frame
// cell read back after the call (`backs`), a struct member its address.
fn ir_place_address(m: &IRModule, p: &IRProgram, b: &IRBuilder, place: TExpr, backs: &[IRWriteBack], span: Span) -> Int Never! {
    if place.kind == .Borrow(inner, _) -> return ir_place_address(&m, &p, &b, inner, &backs, span)
    if place.kind == .Move(inner) -> return ir_place_address(&m, &p, &b, inner, &backs, span)
    if place.kind == .Local(local) {
        binding :: ir_lookup_binding(b, local.name) ?? return ir_fail_slot(&b, span, "write of unknown local {local.name}")
        if binding.indirect >= 0 || ir_kind_of(m, b, binding.slot) == .Aggregate -> return binding.slot
        row :: m.types[b.f.slot_type[binding.slot]]
        cell :: ir_temp(&m, &b, ir_pointer_row(&m))
        ir_emit(&b.f, IROp.StackAddress, cell, if row.size < 8 -> 8 else -> row.size, 8, -1, b.line)
        ir_emit(&b.f, IROp.Store, -1, cell, 0, binding.slot, b.line)
        &backs.push(IRWriteBack{cell: cell, slot: binding.slot})
        return cell
    }
    if place.kind == .Field(receiver, field) {
        base :: ir_place_address(&m, &p, &b, receiver, &backs, span)
        if ir_failed(b) -> return -1
        if ir_kind_of(m, b, base) != .Aggregate -> return ir_fail_slot(&b, span, "write of a field of {ir_type_name(receiver.ty)}")
        member :: ir_member_of(&m, p, b, base, field.name) ?? return ir_fail_slot(&b, span, "write of field {field.name}")
        address :: if m.types[member.ty].kind == .Aggregate -> ir_temp(&m, &b, member.ty) else -> ir_temp(&m, &b, ir_pointer_row(&m))
        ir_emit(&b.f, IROp.Offset, address, base, member.offset, -1, b.line)
        return address
    }
    ir_fail_slot(&b, span, "write place {ir_expr_kind_name(place.kind)}")
}

// A method's receiver convention: "read", "write", "move" or "static" (no
// receiver).
fn ir_receiver_access(kind: TFuncKind) -> String Never! {
    convention :: if kind == {
        .Method(convention, _) -> convention
        .TraitMethod(_, convention, _, _, _) -> convention
        .TopLevel -> { return "static" }
    }
    access :: convention ?? return "static"
    if access == {
        .Read -> "read"
        .Write -> "write"
        .Move -> "move"
    }
}

// ---------------------------------------------------------------------------
// Switches. Each arm is one If of the chain; its Else holds the next test,
// and the last Else the fallback. The subject is evaluated once.

// `lo <= subject && subject <= hi` as one Bool slot.
fn ir_in_range(m: &IRModule, b: &IRBuilder, subject: Int, lo: Int, hi: Int) -> Int Never! {
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    low :: ir_temp_like(&m, &b, subject)
    ir_emit(&b.f, IROp.Const, low, lo, -1, -1, b.line)
    high :: ir_temp_like(&m, &b, subject)
    ir_emit(&b.f, IROp.Const, high, hi, -1, -1, b.line)
    result :: ir_temp(&m, &b, bool_row)
    ir_emit(&b.f, IROp.Ge, result, subject, low, -1, b.line)
    ir_open_if(&b.f, result, b.line)
    ir_emit(&b.f, IROp.Le, result, subject, high, -1, b.line)
    ir_end(&b.f, b.line)
    result
}

fn ir_range_switch(m: &IRModule, p: &IRProgram, b: &IRBuilder, subject: TExpr, arms: [TRangeArm], else_body: [TStmt], span: Span) Never! {
    value :: ir_expr(&m, &p, &b, subject)
    if ir_failed(b) -> return
    kind :: ir_kind_of(m, b, value)
    if kind != .Int && kind != .Word && kind != .Char -> return ir_fail(&b, span, "range switch on {ir_type_name(subject.ty)}")
    opened := 0
    loop arm in arms {
        test :: ir_in_range(&m, &b, value, arm.lo, arm.hi)
        ir_open_if(&b.f, test, b.line)
        ir_stmts(&m, &p, &b, arm.body)
        ir_else(&b.f, b.line)
        opened += 1
        if ir_failed(b) -> return
    }
    ir_stmts(&m, &p, &b, else_body)
    loop _ in 0..<opened -> ir_end(&b.f, b.line)
    ir_release(&m, &b, value)
}

fn ir_mixed_switch(m: &IRModule, p: &IRProgram, b: &IRBuilder, subject: TExpr, arms: [TMixedArm], else_body: [TStmt]?, span: Span) Never! {
    value :: ir_expr(&m, &p, &b, subject)
    if ir_failed(b) -> return
    &b.subjects.push(value)
    opened := 0
    loop arm in arms {
        test :: ir_expr(&m, &p, &b, arm.condition)
        if ir_failed(b) -> return
        ir_open_if(&b.f, test, b.line)
        ir_stmts(&m, &p, &b, arm.body)
        ir_else(&b.f, b.line)
        opened += 1
        if ir_failed(b) -> return
    }
    if else_body == .Val(body) -> ir_stmts(&m, &p, &b, body)
    loop _ in 0..<opened -> ir_end(&b.f, b.line)
    _ :: &b.subjects.pop()
    ir_release(&m, &b, value)
}

// A Bool slot: whether `subject` matches `shape`. Payload bindings become
// pending (bound when the condition's If opens); a nested payload pattern,
// value or range is tested on the payload once the outer test holds.
fn ir_pattern_test(m: &IRModule, p: &IRProgram, b: &IRBuilder, subject: Int, shape: TPatternShape, span: Span) -> Int Never! {
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    if shape == {
        .Variant(variant, bindings, _, _) -> {
            subject_type :: b.f.slot_type[subject]
            row :: ir_enum_def(m, p, subject_type) ?? return ir_fail_slot(&b, span, "variant pattern on a non-enum subject")
            index :: ir_variant_index(p, row, variant) ?? return ir_fail_slot(&b, span, "variant pattern {variant} not in its enum")
            discriminant :: ir_enum_tag_of(&m, &b, subject)
            index_slot :: ir_temp_like(&m, &b, discriminant)
            ir_emit(&b.f, IROp.Const, index_slot, index, -1, -1, b.line)
            result :: ir_temp(&m, &b, bool_row)
            ir_emit(&b.f, IROp.Eq, result, discriminant, index_slot, -1, b.line)
            if bindings.len() > 0 {
                members :: ir_variant_members(&m, p, row, index) ?? return ir_fail_slot(&b, span, "variant pattern {variant} payload")
                loop (position, binding) in bindings {
                    if position >= members.len() -> return ir_fail_slot(&b, span, "variant pattern {variant} with more bindings than members")
                    member :: members[position]
                    if binding == {
                        .Wildcard -> {}
                        .Bind(name, _) -> {
                            if name != "_" {
                                slot :: ir_new_slot(&b, member.ty, IRSlotKind.Local, ir_intern_name(&m, name))
                                &b.pending.push(IRPending{name: name, slot: slot, subject: subject, offset: member.offset, boxed: member.boxed})
                            }
                        }
                        else -> {
                            ir_open_if(&b.f, result, b.line)
                            payload :: ir_member_value(&m, &b, subject, member)
                            test :: ir_binding_test(&m, &p, &b, payload, binding, span)
                            if ir_failed(b) -> return -1
                            ir_emit(&b.f, IROp.Copy, result, test, -1, -1, b.line)
                            ir_end(&b.f, b.line)
                        }
                    }
                }
            }
            return result
        }
        .Range(lo, hi, _) -> return ir_in_range(&m, &b, subject, lo, hi)
        .Or(alternatives, _) -> {
            result :: ir_temp(&m, &b, bool_row)
            ir_emit(&b.f, IROp.Const, result, 0, -1, -1, b.line)
            opened := 0
            loop alternative in alternatives {
                test :: ir_pattern_test(&m, &p, &b, subject, alternative, span)
                if ir_failed(b) -> return -1
                ir_emit(&b.f, IROp.Copy, result, test, -1, -1, b.line)
                not_matched :: ir_temp(&m, &b, bool_row)
                ir_emit(&b.f, IROp.Not, not_matched, test, -1, -1, b.line)
                ir_open_if(&b.f, not_matched, b.line)
                opened += 1
            }
            loop _ in 0..<opened -> ir_end(&b.f, b.line)
            return result
        }
        .Present(_, _, _, _) | .Absent(_) | .Ok(_, _, _, _) | .Err(_, _, _, _) -> return ir_carrier_shape_test(&m, &p, &b, subject, shape, span)
        .Struct(fields, _, _) -> {
            if ir_kind_of(m, b, subject) != .Aggregate -> return ir_fail_slot(&b, span, "struct pattern on {m.types[b.f.slot_type[subject]].ty}")
            result :: ir_temp(&m, &b, bool_row)
            ir_emit(&b.f, IROp.Const, result, 1, -1, -1, b.line)
            loop field in fields {
                if field == {
                    .Bind(name, local, _) -> {
                        member :: ir_member_of(&m, p, b, subject, name) ?? return ir_fail_slot(&b, span, "struct pattern field {name}")
                        if local != "_" && local != "" && m.types[member.ty].kind != .Unit {
                            slot :: ir_new_slot(&b, member.ty, IRSlotKind.Local, ir_intern_name(&m, local))
                            &b.pending.push(IRPending{name: local, slot: slot, subject: subject, offset: member.offset})
                        }
                    }
                    .Value(name, value, _) -> {
                        member :: ir_member_of(&m, p, b, subject, name) ?? return ir_fail_slot(&b, span, "struct pattern field {name}")
                        ir_open_if(&b.f, result, b.line)
                        test :: ir_binding_test(&m, &p, &b, ir_member_read(&m, &b, subject, member), TPatternBinding.Value{value: value}, span)
                        if ir_failed(b) -> return -1
                        ir_emit(&b.f, IROp.Copy, result, test, -1, -1, b.line)
                        ir_end(&b.f, b.line)
                    }
                    .Nested(name, nested, _) -> {
                        member :: ir_member_of(&m, p, b, subject, name) ?? return ir_fail_slot(&b, span, "struct pattern field {name}")
                        ir_open_if(&b.f, result, b.line)
                        test :: ir_binding_test(&m, &p, &b, ir_member_read(&m, &b, subject, member), TPatternBinding.Nested{pattern: nested}, span)
                        if ir_failed(b) -> return -1
                        ir_emit(&b.f, IROp.Copy, result, test, -1, -1, b.line)
                        ir_end(&b.f, b.line)
                    }
                }
            }
            return result
        }
        else -> return ir_fail_slot(&b, span, "pattern {ir_shape_name(shape)}")
    }
}

// The test of a payload sub-pattern on the payload slot `payload`: a nested
// shape, an equal value, or a range.
fn ir_binding_test(m: &IRModule, p: &IRProgram, b: &IRBuilder, payload: Int, binding: TPatternBinding, span: Span) -> Int Never! {
    if payload < 0 -> return ir_fail_slot(&b, span, "payload pattern on a Unit payload")
    if binding == {
        .Nested(pattern) -> return ir_pattern_test(&m, &p, &b, payload, pattern.shape, span)
        .Range(lo, hi) -> return ir_in_range(&m, &b, payload, lo, hi)
        .Value(value) -> {
            payload_row :: b.f.slot_type[payload]
            expected :: ir_value_as(&m, &p, &b, value, payload_row, span)
            if ir_failed(b) -> return -1
            site :: b.line
            payload_ty :: m.types[payload_row].ty
            test :: ir_binary(&m, &p, &b, TBinaryOp.Eq, false, site, payload_ty, payload, expected, value.ty, span)
            ir_release(&m, &b, expected)
            return test
        }
        else -> return ir_fail_slot(&b, span, "payload pattern {ir_binding_name(binding)}")
    }
}

fn ir_match(m: &IRModule, p: &IRProgram, b: &IRBuilder, subject: TExpr, arms: [TMatchArm], else_body: [TStmt]?, span: Span) Never! {
    value :: ir_subject(&m, &p, &b, subject, span)
    if ir_failed(b) -> return
    &b.subjects.push(value)
    opened := 0
    loop arm in arms {
        mark :: b.bindings.len()
        test :: ir_pattern_test(&m, &p, &b, value, arm.pattern.shape, span)
        if ir_failed(b) -> return
        ir_open_condition(&m, &b, test)
        ir_stmts(&m, &p, &b, arm.body)
        ir_else(&b.f, b.line)
        ir_truncate_bindings(&b, mark)
        opened += 1
        if ir_failed(b) -> return
    }
    if else_body == .Val(body) -> ir_stmts(&m, &p, &b, body)
    loop _ in 0..<opened -> ir_end(&b.f, b.line)
    _ :: &b.subjects.pop()
    ir_release(&m, &b, value)
}

fn ir_truncate_bindings(b: &IRBuilder, mark: Int) Never! {
    loop b.bindings.len() > mark {
        _ :: &b.bindings.pop()
    }
}

// A switch or pattern subject: a plain `T Never!` call result is boxed
// into the carrier its checked type names.
fn ir_subject(m: &IRModule, p: &IRProgram, b: &IRBuilder, subject: TExpr, span: Span) -> Int Never! {
    if ir_carrier_type(subject.ty) {
        row :: ir_value_type(&m, p, subject.ty) ?? return ir_type_fail(&b, span, subject.ty)
        return ir_value_as(&m, &p, &b, subject, row, span)
    }
    ir_expr(&m, &p, &b, subject)
}

// The test of an `if` pattern condition on `subject`.
fn ir_option_test(m: &IRModule, p: &IRProgram, b: &IRBuilder, shape: TPatternShape, subject: TExpr, span: Span) -> Int Never! {
    if !ir_carrier_type(subject.ty) {
        value :: ir_expr(&m, &p, &b, subject)
        if ir_failed(b) || value < 0 -> return ir_fail_slot(&b, span, "pattern condition on {ir_type_name(subject.ty)}")
        return ir_pattern_test(&m, &p, &b, value, shape, span)
    }
    value :: ir_subject(&m, &p, &b, subject, span)
    if ir_failed(b) -> return -1
    ir_carrier_shape_test(&m, &p, &b, value, shape, span)
}

fn ir_carrier_type(ty: Type) -> Bool Never! {
    if ir_untag(ty) == {
        .Option(_) | .Result(_, _) -> true
        else -> false
    }
}

// The test of an Option or Result shape on the carrier box `value`
// (codegen OptionIsSome / ResultIsOk); a payload binding is bound when the
// If opens (IRPending).
fn ir_carrier_shape_test(m: &IRModule, p: &IRProgram, b: &IRBuilder, value: Int, shape: TPatternShape, span: Span) -> Int Never! {
    carrier :: ir_untag(m.types[b.f.slot_type[value]].ty)
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    if carrier == .Option(payload) {
        null :: ir_temp_like(&m, &b, value)
        ir_emit(&b.f, IROp.Const, null, 0, -1, -1, b.line)
        test :: ir_temp(&m, &b, bool_row)
        if shape == {
            .Absent(_) -> ir_emit(&b.f, IROp.Eq, test, value, null, -1, b.line)
            .Present(binding, _, inner, _) -> {
                ir_emit(&b.f, IROp.Ne, test, value, null, -1, b.line)
                ir_pend(&m, p, &b, binding, value, 0, payload, span)
                ir_refine_payload(&m, &p, &b, test, value, 0, payload, inner, span)
            }
            else -> return ir_fail_slot(&b, span, "pattern {ir_shape_name(shape)} on an Option")
        }
        return test
    }
    if carrier == .Result(ok, err) {
        is_ok :: ir_result_is_ok(&m, &b, value)
        if shape == {
            .Ok(binding, _, inner, _) -> {
                ir_pend(&m, p, &b, binding, value, 8, ok, span)
                ir_refine_payload(&m, &p, &b, is_ok, value, 8, ok, inner, span)
                return is_ok
            }
            .Err(binding, _, inner, _) -> {
                ir_pend(&m, p, &b, binding, value, 8, err, span)
                test :: ir_temp(&m, &b, bool_row)
                ir_emit(&b.f, IROp.Not, test, is_ok, -1, -1, b.line)
                ir_refine_payload(&m, &p, &b, test, value, 8, err, inner, span)
                return test
            }
            else -> return ir_fail_slot(&b, span, "pattern {ir_shape_name(shape)} on a Result")
        }
    }
    ir_fail_slot(&b, span, "pattern {ir_shape_name(shape)} on {ir_type_name(carrier)}")
}

// Narrows the Bool `test` by a nested payload pattern: once it holds, the
// payload at `offset` of the box `value` must match `inner` too.
fn ir_refine_payload(m: &IRModule, p: &IRProgram, b: &IRBuilder, test: Int, value: Int, offset: Int, payload: Type, inner: TNestedPattern?, span: Span) Never! {
    nested :: inner ?? return
    row :: ir_value_type(&m, p, payload) ?? return ir_fail(&b, span, "payload type {ir_type_name(payload)}")
    ir_open_if(&b.f, test, b.line)
    slot :: ir_load_at(&m, &b, value, offset, row)
    inner_test :: ir_binding_test(&m, &p, &b, slot, TPatternBinding.Nested{pattern: nested}, span)
    if ir_failed(b) -> return
    ir_emit(&b.f, IROp.Copy, test, inner_test, -1, -1, b.line)
    ir_end(&b.f, b.line)
}

fn ir_pend(m: &IRModule, p: IRProgram, b: &IRBuilder, binding: String, subject: Int, offset: Int, payload: Type, span: Span) Never! {
    if binding == "" || binding == "_" -> return
    row :: ir_value_type(&m, p, payload) ?? return ir_fail(&b, span, "payload type {ir_type_name(payload)}")
    if m.types[row].kind == .Unit -> return
    slot :: ir_new_slot(&b, row, IRSlotKind.Local, ir_intern_name(&m, binding))
    &b.pending.push(IRPending{name: binding, slot: slot, subject: subject, offset: offset})
}

// A Bool slot: whether the Result box `value` holds Ok (selector word 1).
fn ir_result_is_ok(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    word :: ir_word_row(&m)
    selector :: ir_temp(&m, &b, word)
    ir_emit(&b.f, IROp.Load, selector, value, 0, -1, b.line)
    one :: ir_temp(&m, &b, word)
    ir_emit(&b.f, IROp.Const, one, 1, -1, -1, b.line)
    test :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
    ir_emit(&b.f, IROp.Eq, test, selector, one, -1, b.line)
    test
}

// The discriminant of an enum value: a payload-free enum is its variant
// index, a payload enum's box holds it at 0.
fn ir_enum_tag_of(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    if m.types[b.f.slot_type[value]].kind != .Pointer -> return value
    ir_load_word(&m, &b, value, 0)
}

// The payload members of variant `index` of the enum declaration `row`,
// laid out from byte 8 (Lower Values.jet lower_variant_members); a
// recursive edge holds an 8-byte wrapper box pointer.
fn ir_variant_members(m: &IRModule, p: IRProgram, row: Int, index: Int) -> [IRMember]? Never! {
    definition :: p.types[row]
    members := [IRMember]{}
    if definition.kind == .Enum(variants, _) {
        variant :: variants[index]
        names := [String]{}
        types := [Type]{}
        edges := [String]{}
        redacts := [Bool]{}
        if variant.payload == {
            .Unit -> {}
            .Single(inner) -> {
                &names.push(variant.name)
                &types.push(inner)
                &edges.push(variant.name)
                &redacts.push(false)
            }
            .Named(fields) -> {
                loop field in fields {
                    if field.computed -> next
                    &names.push(field.name)
                    &types.push(field.ty)
                    &edges.push("{variant.name}.{field.name}")
                    &redacts.push(field.redact)
                }
            }
        }
        offset := 8
        loop (position, name) in names {
            ty :: ir_value_type(&m, p, types[position]) ?? return None
            boxed :: definition.boxed_edges.contains(edges[position])
            size :: if boxed -> 8 else -> m.types[ty].size
            align :: if boxed || m.types[ty].kind == .Aggregate -> 8 else -> m.types[ty].align
            if size > 0 && align > 0 && offset % align != 0 -> offset += align - offset % align
            &members.push(IRMember{name: name, offset: offset, ty: ty, boxed: boxed, redact: redacts[position]})
            offset += size
        }
    }
    Val(members)
}

// Lower lower_enum_box_size: the end of the widest variant, in whole words.
fn ir_enum_box_size(m: &IRModule, p: IRProgram, row: Int) -> Int? Never! {
    end := 8
    if p.types[row].kind == .Enum(variants, _) {
        loop index in 0..<variants.len() {
            members :: ir_variant_members(&m, p, row, index) ?? return None
            loop member in members {
                size :: if member.boxed -> 8 else -> m.types[member.ty].size
                if member.offset + size > end -> end = member.offset + size
            }
        }
    }
    Val(ir_align8(end))
}

// An enum value: a payload-free enum's variant index (Lower
// lower_discriminant), else a new box with the discriminant and payload.
fn ir_enum_value(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, owner: String, variant: String, payload: TEnumPayload, span: Span) -> Int Never! {
    slot_type :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    row :: ir_type_def(p, owner) ?? ir_enum_def(m, p, slot_type) ?? return ir_fail_slot(&b, span, "enum {owner} without a declaration")
    index :: ir_variant_index(p, row, variant) ?? return ir_fail_slot(&b, span, "variant {variant} not in {owner}")
    if m.types[slot_type].kind != .Pointer {
        if payload != .Unit -> return ir_fail_slot(&b, span, "payload for a payload-free enum")
        slot :: ir_temp(&m, &b, slot_type)
        ir_emit(&b.f, IROp.Const, slot, index, -1, -1, b.line)
        return slot
    }
    members :: ir_variant_members(&m, p, row, index) ?? return ir_fail_slot(&b, span, "payload of {variant}")
    size :: ir_enum_box_size(&m, p, row) ?? return ir_fail_slot(&b, span, "layout of {owner}")
    values := [Int]{}
    targets := [IRMember]{}
    if payload == {
        .Unit -> {}
        .Positional(args) -> {
            if args.len() != members.len() -> return ir_fail_slot(&b, span, "variant {variant} with {args.len()} of {members.len()} payload values")
            loop (position, arg) in args {
                slot :: ir_value_as(&m, &p, &b, arg.value, members[position].ty, span)
                if ir_failed(b) -> return -1
                &values.push(slot)
                &targets.push(members[position])
            }
        }
        .Named(fields) -> {
            loop field in fields {
                found := -1
                loop (position, member) in members {
                    if member.name == field.name -> found = position
                }
                if found < 0 -> return ir_fail_slot(&b, span, "variant {variant} has no member {field.name}")
                slot :: ir_value_as(&m, &p, &b, field.value.value, members[found].ty, span)
                if ir_failed(b) -> return -1
                &values.push(slot)
                &targets.push(members[found])
            }
        }
    }
    boxed :: ir_box_alloc(&m, &b, size, slot_type)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, ir_word_const(&m, &b, index), b.line)
    loop (position, value) in values -> ir_member_store(&m, &b, boxed, targets[position], value)
    boxed
}

// Writes `value` into member `member` of the storage at `base`; a recursive
// edge gets a wrapper box of its own.
fn ir_member_store(m: &IRModule, b: &IRBuilder, base: Int, member: IRMember, value: Int) Never! {
    if !member.boxed -> return ir_store_at(&m, &b, base, member.offset, value)
    size :: m.types[member.ty].size
    pointer_row :: ir_pointer_row(&m)
    wrapper :: ir_box_alloc(&m, &b, size, pointer_row)
    ir_store_at(&m, &b, wrapper, 0, value)
    ir_emit(&b.f, IROp.Store, -1, base, member.offset, wrapper, b.line)
}

// The value of member `member` of the storage at `base` (through its
// wrapper box for a recursive edge; -1 for Unit).
fn ir_member_value(m: &IRModule, b: &IRBuilder, base: Int, member: IRMember) -> Int Never! {
    if !member.boxed -> return ir_load_at(&m, &b, base, member.offset, member.ty)
    wrapper :: ir_temp(&m, &b, ir_pointer_row(&m))
    ir_emit(&b.f, IROp.Load, wrapper, base, member.offset, -1, b.line)
    ir_load_at(&m, &b, wrapper, 0, member.ty)
}

// A member of a record, tuple or variant (Lower lower_render_member_push:
// a String member renders quoted).
fn ir_render_push_value_member(m: &IRModule, p: IRProgram, b: &IRBuilder, builder: Int, value: Int, mode: IRRender, span: Span) Never! {
    if value < 0 -> return ir_push_static(&m, &b, builder, "()")
    ir_render_push(&m, p, &b, builder, value, mode, true, span)
}

// `Name { a: 1, b: "x" }` (Lower lower_render_record; Debug redacts).
fn ir_render_record(m: &IRModule, p: IRProgram, b: &IRBuilder, builder: Int, base: Int, name: String, members: [IRMember], mode: IRRender, span: Span) Never! {
    ir_push_static(&m, &b, builder, "{ir_render_name(name)} {{")
    loop (index, member) in members {
        ir_push_static(&m, &b, builder, "{if index == 0 -> " " else -> ", "}{ir_render_name(member.name)}: ")
        if mode == .Debug && member.redact {
            ir_push_static(&m, &b, builder, "[redacted]")
            next
        }
        ir_render_push_value_member(&m, p, &b, builder, ir_member_value(&m, &b, base, member), mode, span)
        if ir_failed(b) -> return
    }
    ir_push_static(&m, &b, builder, if members.len() == 0 -> "}}" else -> " }}")
}

// ---------------------------------------------------------------------------
// Carriers. An Option is a box pointer (null when absent, payload at 0); a
// Result a box with its selector word at 0 (Ok 1, Err 0) and its payload at
// 8 (Lower Values.jet lower_option_box_size / lower_result_box_size).

fn ir_is_result(ty: Type) -> Bool Never! {
    if ir_untag(ty) == .Result(_, _) -> return true
    false
}

fn ir_is_option(ty: Type) -> Bool Never! {
    if ir_untag(ty) == .Option(_) -> return true
    false
}

fn ir_align8(size: Int) -> Int Never! {
    if size < 8 -> return 8
    if size % 8 != 0 -> return size + 8 - size % 8
    size
}

fn ir_type_size(m: &IRModule, p: IRProgram, ty: Type) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return 8
    m.types[row].size
}

fn ir_word_const(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    slot :: ir_temp(&m, &b, ir_word_row(&m))
    ir_emit(&b.f, IROp.Const, slot, value, -1, -1, b.line)
    slot
}

// A wrapping native word operation (addresses, counts, indexes).
fn ir_word_op(m: &IRModule, b: &IRBuilder, op: IROp, left: Int, right: Int) -> Int Never! {
    slot :: ir_temp(&m, &b, ir_word_row(&m))
    ir_emit(&b.f, op, slot, left, right, IR_OVERFLOW_WRAP, b.line)
    slot
}

fn ir_bool_op(m: &IRModule, b: &IRBuilder, op: IROp, left: Int, right: Int) -> Int Never! {
    slot :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
    ir_emit(&b.f, op, slot, left, right, -1, b.line)
    slot
}

fn ir_load_word(m: &IRModule, b: &IRBuilder, base: Int, offset: Int) -> Int Never! {
    slot :: ir_temp(&m, &b, ir_word_row(&m))
    ir_emit(&b.f, IROp.Load, slot, base, offset, -1, b.line)
    slot
}

// Heap storage of `size` bytes (Lower lower_alloc_bytes: jet_rt_alloc(bytes, 8)).
fn ir_box_alloc(m: &IRModule, b: &IRBuilder, size: Int, row: Int) -> Int Never! {
    bytes :: ir_word_const(&m, &b, ir_align8(size))
    align :: ir_word_const(&m, &b, 8)
    boxed :: ir_runtime(&m, &b, "jet_rt_alloc", [Int]{bytes, align}, row)
    b.fresh[boxed] = false
    boxed
}

// Writes `value` at byte `offset` of the storage at `base`: an aggregate's
// bytes are copied, a Unit value takes no bytes.
fn ir_store_at(m: &IRModule, b: &IRBuilder, base: Int, offset: Int, value: Int) Never! {
    if value < 0 -> return
    kind :: ir_kind_of(m, b, value)
    if kind == .Unit -> return
    if kind == .Aggregate {
        address :: ir_temp_like(&m, &b, value)
        ir_emit(&b.f, IROp.Offset, address, base, offset, -1, b.line)
        ir_emit(&b.f, IROp.CopyBytes, -1, address, value, m.types[b.f.slot_type[value]].size, b.line)
        b.fresh[value] = false
        return
    }
    owned :: ir_own(&m, &b, value)
    ir_emit(&b.f, IROp.Store, -1, base, offset, owned, b.line)
    b.fresh[owned] = false
}

// The value of type row `row` at byte `offset` of the storage at `base`
// (an aggregate is its address there; -1 for Unit).
fn ir_load_at(m: &IRModule, b: &IRBuilder, base: Int, offset: Int, row: Int) -> Int Never! {
    kind :: m.types[row].kind
    if kind == .Unit -> return -1
    slot :: ir_temp(&m, &b, row)
    ir_emit(&b.f, if kind == .Aggregate -> IROp.Offset else -> IROp.Load, slot, base, offset, -1, b.line)
    slot
}

// A new Result box of type `ty` holding `payload` (-1: Unit) as Ok or Err
// (Lower lower_result_box; an Ok(()) payload word is 0).
fn ir_result_box(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, success: Bool, payload: Int) -> Int Never! {
    line :: b.line
    row :: ir_value_type(&m, p, ty) ?? ir_pointer_row(&m)
    widest := 0
    if ir_untag(ty) == .Result(ok_ty, err_ty) {
        ok_size :: ir_type_size(&m, p, ok_ty)
        err_size :: ir_type_size(&m, p, err_ty)
        widest = ir_align8(if ok_size > err_size -> ok_size else -> err_size)
    }
    boxed :: ir_box_alloc(&m, &b, 8 + ir_align8(widest), row)
    selector :: ir_word_const(&m, &b, if success -> 1 else -> 0)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, selector, line)
    if payload >= 0 {
        ir_store_at(&m, &b, boxed, 8, payload)
    } else {
        zero :: ir_word_const(&m, &b, 0)
        ir_emit(&b.f, IROp.Store, -1, boxed, 8, zero, line)
    }
    boxed
}

fn ir_present(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, value: TExpr, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    inner_row := -1
    if ir_untag(ty) == .Option(inner) {
        inner_row = ir_value_type(&m, p, inner) ?? return ir_type_fail(&b, span, inner)
    }
    if inner_row < 0 -> return ir_fail_slot(&b, span, "Present of {ir_type_name(ty)}")
    slot :: ir_value_as(&m, &p, &b, value, inner_row, span)
    if ir_failed(b) -> return -1
    inner_size :: m.types[inner_row].size
    boxed :: ir_box_alloc(&m, &b, inner_size, row)
    ir_store_at(&m, &b, boxed, 0, slot)
    boxed
}

fn ir_result_ctor(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, value: TExpr, success: Bool, span: Span) -> Int Never! {
    payload_row := -1
    if ir_untag(ty) == .Result(ok_ty, err_ty) {
        payload_row = ir_value_type(&m, p, if success -> ok_ty else -> err_ty) ?? -1
    }
    if payload_row < 0 -> return ir_fail_slot(&b, span, "Result constructor of {ir_type_name(ty)}")
    slot :: ir_value_as(&m, &p, &b, value, payload_row, span)
    if ir_failed(b) -> return -1
    ir_result_box(&m, p, &b, ty, success, slot)
}

// `expression` as a value of type row `row`: a plain `T Never!` call result
// is boxed into `Ok` where its carrier is wanted, and a Result box is
// unwrapped where its plain success is (codegen
// jet_codegen_reconcile_plain_call_return, jet_codegen_lower_return_value).
fn ir_value_as(m: &IRModule, p: &IRProgram, b: &IRBuilder, expression: TExpr, row: Int, span: Span) -> Int Never! {
    if !ir_is_result(m.types[row].ty) {
        if expression.kind == .Ok(inner) -> return ir_value_as(&m, &p, &b, inner, row, span)
    }
    slot :: ir_expr(&m, &p, &b, expression)
    if ir_failed(b) || slot < 0 -> return slot
    ir_adapt(&m, p, &b, slot, row, span)
}

fn ir_adapt(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int, row: Int, span: Span) -> Int Never! {
    have :: b.f.slot_type[slot]
    if have == row -> return slot
    want_box :: ir_is_result(m.types[row].ty)
    have_box :: ir_is_result(m.types[have].ty)
    if want_box && !have_box {
        target :: m.types[row].ty
        return ir_result_box(&m, p, &b, target, true, slot)
    }
    if have_box && !want_box -> return ir_load_at(&m, &b, slot, 8, row)
    if m.types[have].kind == m.types[row].kind && m.types[have].size == m.types[row].size -> return slot
    ir_fail_slot(&b, span, "a value of {ir_type_name(m.types[have].ty)} where {ir_type_name(m.types[row].ty)} is expected")
}

// `return value`: a Unit executable return only evaluates it; any other
// return hands back the value as the executable return type.
fn ir_return(m: &IRModule, p: &IRProgram, b: &IRBuilder, value: TExpr?, span: Span) Never! {
    returned :: value ?? return ir_return_fallthrough(&m, &p, &b)
    if b.f.result < 0 {
        payload := returned
        if returned.kind == .Ok(inner) -> payload = inner
        slot :: ir_expr(&m, &p, &b, payload)
        if ir_failed(b) -> return
        ir_release(&m, &b, slot)
        if b.ret != None && !b.plain -> return ir_return_fallthrough(&m, &p, &b)
        ir_emit_return(&m, &b, -1)
        return
    }
    result_row :: b.f.result
    slot :: ir_value_as(&m, &p, &b, returned, result_row, span)
    if ir_failed(b) -> return
    if slot < 0 -> return ir_fail(&b, span, "return of a value without a slot")
    ir_emit_return(&m, &b, ir_own(&m, &b, slot))
}

fn ir_option_is_some(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    null :: ir_temp_like(&m, &b, value)
    ir_emit(&b.f, IROp.Const, null, 0, -1, -1, b.line)
    ir_bool_op(&m, &b, IROp.Ne, value, null)
}

// `value?` (codegen jet_codegen_lower_try_value): the success payload, or
// the failure handed back to the caller. A plain `T Never!` call result is
// its own success.
fn ir_try(m: &IRModule, p: &IRProgram, b: &IRBuilder, value: TExpr, conversion: TTryConvert, span: Span) -> Int Never! {
    subject :: ir_expr(&m, &p, &b, value)
    if ir_failed(b) || subject < 0 -> return subject
    held :: m.types[b.f.slot_type[subject]].ty
    expected :: ir_untag(value.ty)
    if expected == .Result(ok_ty, err_ty) {
        if !ir_is_result(held) -> return subject
        failed :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
        ir_emit(&b.f, IROp.Not, failed, ir_result_is_ok(&m, &b, subject), -1, -1, b.line)
        ir_open_if(&b.f, failed, b.line)
        ir_try_failure(&m, p, &b, subject, true, conversion == .Never || ir_never_type(err_ty), conversion, span)
        ir_end(&b.f, b.line)
        if ir_failed(b) -> return -1
        ok_row :: ir_value_type(&m, p, ok_ty) ?? return ir_type_fail(&b, span, ok_ty)
        return ir_load_at(&m, &b, subject, 8, ok_row)
    }
    if expected == .Option(inner) {
        if !ir_is_option(held) -> return subject
        absent :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
        ir_emit(&b.f, IROp.Not, absent, ir_option_is_some(&m, &b, subject), -1, -1, b.line)
        ir_open_if(&b.f, absent, b.line)
        ir_try_failure(&m, p, &b, subject, false, false, conversion, span)
        ir_end(&b.f, b.line)
        if ir_failed(b) -> return -1
        inner_row :: ir_value_type(&m, p, inner) ?? return ir_type_fail(&b, span, inner)
        return ir_load_at(&m, &b, subject, 0, inner_row)
    }
    subject
}

// The failure edge of `?`: an impossible failure is unreachable; a Result
// carrier hands the Err box back unchanged; an Option carrier returns None.
fn ir_try_failure(m: &IRModule, p: IRProgram, b: &IRBuilder, subject: Int, is_result: Bool, never: Bool, conversion: TTryConvert, span: Span) Never! {
    if never {
        ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
        return
    }
    if b.failure == .Result(_, _) {
        if !is_result -> return ir_fail(&b, span, "`?` on an Option in a Result function")
        if conversion != .NoConversion -> return ir_fail(&b, span, "`?` with error conversion {ir_conversion_name(conversion)}")
        ir_emit_return(&m, &b, subject)
        return
    }
    optional := b.failure == .Optional(_)
    if b.plain {
        if b.ret == .Val(ret) {
            if ir_is_option(ret) -> optional = true
        }
    }
    if optional && !is_result && b.f.result >= 0 {
        result_row :: b.f.result
        null :: ir_temp(&m, &b, result_row)
        ir_emit(&b.f, IROp.Const, null, 0, -1, -1, b.line)
        ir_emit_return(&m, &b, null)
        return
    }
    ir_fail(&b, span, "`?` without a matching failure carrier")
}

// `value ?? fallback` (codegen jet_codegen_lower_or_fallback).
fn ir_or_fallback(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, value: TExpr, fallback: TOrFallback, ambient: TLocal?, span: Span) -> Int Never! {
    subject :: ir_expr(&m, &p, &b, value)
    if ir_failed(b) || subject < 0 -> return subject
    held :: m.types[b.f.slot_type[subject]].ty
    expected :: ir_untag(value.ty)
    offset := 0
    payload_ty := Type.Int
    error_ty := Type.Int
    is_result := false
    if expected == .Result(ok_ty, err_ty) {
        if !ir_is_result(held) -> return subject
        is_result = true
        offset = 8
        payload_ty = ok_ty
        error_ty = err_ty
    } else if expected == .Option(inner) {
        if !ir_is_option(held) -> return subject
        payload_ty = inner
    } else {
        return ir_fail_slot(&b, span, "`??` on {ir_type_name(value.ty)}")
    }
    result := -1
    if !ir_unit_type(ty) && !ir_never_type(ty) {
        row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
        result = ir_temp(&m, &b, row)
    }
    payload_row :: ir_value_type(&m, p, payload_ty) ?? return ir_type_fail(&b, span, payload_ty)
    test :: if is_result -> ir_result_is_ok(&m, &b, subject) else -> ir_option_is_some(&m, &b, subject)
    ir_open_if(&b.f, test, b.line)
    payload :: ir_load_at(&m, &b, subject, offset, payload_row)
    if result >= 0 && payload >= 0 {
        target_row :: b.f.slot_type[result]
        adapted :: ir_adapt(&m, p, &b, payload, target_row, span)
        if ir_failed(b) -> return -1
        ir_store(&m, &b, result, adapted)
    }
    ir_else(&b.f, b.line)
    // The fallback sees the failure's error under the ambient binding
    // (codegen jet_codegen_lower_fallback_failure).
    mark :: b.bindings.len()
    if ambient == .Val(local) {
        if !is_result -> return ir_fail_slot(&b, span, "`??` ambient error binding on an Option")
        error_row :: ir_value_type(&m, p, error_ty) ?? return ir_type_fail(&b, span, error_ty)
        error :: ir_load_at(&m, &b, subject, 8, error_row)
        if error >= 0 -> &b.bindings.push(IRBinding{name: local.name, slot: error})
    }
    ir_fallback_route(&m, &p, &b, fallback, result, span)
    ir_truncate_bindings(&b, mark)
    ir_end(&b.f, b.line)
    if result >= 0 -> b.fresh[result] = ir_has_drop(m, b, result)
    result
}

fn ir_fallback_route(m: &IRModule, p: &IRProgram, b: &IRBuilder, fallback: TOrFallback, result: Int, span: Span) Never! {
    if fallback == {
        .Value(alternative) -> {
            target_row :: if result >= 0 -> b.f.slot_type[result] else -> -1
            slot :: if result >= 0 -> ir_value_as(&m, &p, &b, alternative, target_row, span) else -> ir_expr(&m, &p, &b, alternative)
            if ir_failed(b) -> return
            if result >= 0 && slot >= 0 -> ir_store(&m, &b, result, slot)
            if result < 0 -> ir_release(&m, &b, slot)
        }
        .Return(returned) -> ir_return(&m, &p, &b, returned, span)
        .Panic(message, location) -> {
            slot :: ir_expr(&m, &p, &b, message)
            if ir_failed(b) -> return
            text :: ir_render(&m, p, &b, message.ty, slot, IRRender.Display, span)
            if ir_failed(b) -> return
            ir_stop(&m, &p, &b, 2, text, ir_word_const(&m, &b, 0), ir_word_const(&m, &b, 0), location)
        }
        .Break -> ir_loop_jump(&m, &b, None, true, span)
        .Continue -> ir_loop_jump(&m, &b, None, false, span)
        .BreakLabel(label) -> ir_loop_jump(&m, &b, Val(label), true, span)
        .ContinueLabel(label) -> ir_loop_jump(&m, &b, Val(label), false, span)
    }
}

fn ir_loop_jump(m: &IRModule, b: &IRBuilder, label: String?, exit: Bool, span: Span) Never! {
    frame :: ir_loop_frame(b, label) ?? return ir_fail(&b, span, "break or next outside a loop")
    ir_drop_bindings(&m, &b, frame.mark)
    ir_emit(&b.f, IROp.Br, -1, ir_depth(b.f, if exit -> frame.exit else -> frame.next), -1, -1, b.line)
}

// A rendered value (-1: Unit) onto `builder`.
fn ir_render_push_value(m: &IRModule, p: IRProgram, b: &IRBuilder, builder: Int, value: Int, mode: IRRender, span: Span) Never! {
    if value < 0 -> return ir_push_static(&m, &b, builder, "()")
    ir_render_push(&m, p, &b, builder, value, mode, false, span)
}

// Lower Display.jet: absent is "None" in Debug and "null" otherwise; a
// present payload renders bare, as `Val(...)` in Debug.
fn ir_render_option(m: &IRModule, p: IRProgram, b: &IRBuilder, builder: Int, slot: Int, payload: Type, mode: IRRender, span: Span) Never! {
    row :: ir_value_type(&m, p, payload) ?? return ir_fail(&b, span, "display of an Option of {ir_type_name(payload)}")
    absent :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
    ir_emit(&b.f, IROp.Not, absent, ir_option_is_some(&m, &b, slot), -1, -1, b.line)
    ir_open_if(&b.f, absent, b.line)
    ir_push_static(&m, &b, builder, if mode == .Debug -> "None" else -> "null")
    ir_else(&b.f, b.line)
    if mode == .Debug -> ir_push_static(&m, &b, builder, "Val(")
    ir_render_push_value(&m, p, &b, builder, ir_load_at(&m, &b, slot, 0, row), mode, span)
    if mode == .Debug -> ir_push_static(&m, &b, builder, ")")
    ir_end(&b.f, b.line)
}

// Lower Display.jet: a clean error (Never or Absent) renders like an
// Option; otherwise `Err(e)` / `Ok(v)`.
fn ir_render_result(m: &IRModule, p: IRProgram, b: &IRBuilder, builder: Int, slot: Int, ok_ty: Type, err_ty: Type, mode: IRRender, span: Span) Never! {
    ok_row :: ir_value_type(&m, p, ok_ty) ?? return ir_fail(&b, span, "display of a Result of {ir_type_name(ok_ty)}")
    err_row :: ir_value_type(&m, p, err_ty) ?? return ir_fail(&b, span, "display of a Result error {ir_type_name(err_ty)}")
    clean :: ir_never_type(err_ty) || ir_untag(err_ty) == (Type.Named{name: "Absent"})
    failed :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
    ir_emit(&b.f, IROp.Not, failed, ir_result_is_ok(&m, &b, slot), -1, -1, b.line)
    ir_open_if(&b.f, failed, b.line)
    if clean {
        ir_push_static(&m, &b, builder, if mode == .Debug -> "None" else -> "null")
    } else {
        ir_push_static(&m, &b, builder, "Err(")
        ir_render_push_value(&m, p, &b, builder, ir_load_at(&m, &b, slot, 8, err_row), mode, span)
        ir_push_static(&m, &b, builder, ")")
    }
    ir_else(&b.f, b.line)
    if !clean || mode == .Debug -> ir_push_static(&m, &b, builder, if clean -> "Val(" else -> "Ok(")
    ir_render_push_value(&m, p, &b, builder, ir_load_at(&m, &b, slot, 8, ok_row), mode, span)
    if !clean || mode == .Debug -> ir_push_static(&m, &b, builder, ")")
    ir_end(&b.f, b.line)
}

// `[a, b]`, each element in the list's own mode (Lower Display.jet).
fn ir_render_list(m: &IRModule, p: IRProgram, b: &IRBuilder, builder: Int, slot: Int, element: Type, mode: IRRender, span: Span) Never! {
    row :: ir_value_type(&m, p, element) ?? return ir_fail(&b, span, "display of a List of {ir_type_name(element)}")
    ir_push_static(&m, &b, builder, "[")
    walk :: ir_walk_open(&m, &b, slot, row)
    later :: ir_bool_op(&m, &b, IROp.Ne, walk.index, ir_word_const(&m, &b, 0))
    ir_open_if(&b.f, later, b.line)
    ir_push_static(&m, &b, builder, ", ")
    ir_end(&b.f, b.line)
    ir_render_push_value(&m, p, &b, builder, walk.item, mode, span)
    ir_walk_close(&m, &b, walk)
    ir_push_static(&m, &b, builder, "]")
}

// ---------------------------------------------------------------------------
// Lists: the address of a 24-byte header (len, cap, data); elements lie at
// data + index * stride (Lower Lists.jet).

// Lower lower_list_stride: a fixed-width integer or Float32 is packed at its
// width; any other element takes its size rounded up to whole words.
fn ir_list_stride(m: IRModule, row: Int) -> Int Never! {
    kind :: m.types[row].kind
    if kind == .Word || kind == .Float32 -> return m.types[row].size
    ir_align8(m.types[row].size)
}

// The element type row of a List slot.
fn ir_list_element(m: &IRModule, p: IRProgram, b: IRBuilder, list: Int) -> Int? Never! {
    if ir_untag(m.types[b.f.slot_type[list]].ty) == .List(element) -> return ir_value_type(&m, p, element)
    None
}

// The address of element `index` (a native word) of the buffer `data`.
fn ir_element_address(m: &IRModule, b: &IRBuilder, data: Int, index: Int, stride: Int) -> Int Never! {
    width :: ir_word_const(&m, &b, stride)
    ir_word_op(&m, &b, IROp.Add, data, ir_word_op(&m, &b, IROp.Mul, index, width))
}

// An open walk over a list: its native index and the element at it.
struct IRWalk { index: Int, item: Int }

// Opens a loop over the elements of the list at `list` in order;
// ir_walk_close advances and closes it.
fn ir_walk_open(m: &IRModule, b: &IRBuilder, list: Int, row: Int) -> IRWalk Never! {
    stride :: ir_list_stride(m, row)
    length :: ir_load_word(&m, &b, list, 0)
    data :: ir_load_word(&m, &b, list, 16)
    index :: ir_word_const(&m, &b, 0)
    exit :: ir_open(&b.f, IROp.Block, b.line)
    _ :: ir_open(&b.f, IROp.Loop, b.line)
    ir_exit_unless(&m, &b, ir_bool_op(&m, &b, IROp.Lt, index, length), exit)
    item :: ir_load_at(&m, &b, ir_element_address(&m, &b, data, index, stride), 0, row)
    IRWalk{index: index, item: item}
}

fn ir_walk_close(m: &IRModule, b: &IRBuilder, walk: IRWalk) Never! {
    one :: ir_word_const(&m, &b, 1)
    ir_emit(&b.f, IROp.Add, walk.index, walk.index, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
}

fn ir_list_literal(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, values: [TExpr], span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    element_row := -1
    if ir_untag(ty) == .List(element) {
        element_row = ir_value_type(&m, p, element) ?? -1
    }
    if element_row < 0 -> return ir_fail_slot(&b, span, "list literal of {ir_type_name(ty)}")
    elements := [Int]{}
    loop value in values {
        slot :: ir_value_as(&m, &p, &b, value, element_row, span)
        if ir_failed(b) -> return -1
        &elements.push(slot)
    }
    ir_list_from(&m, &b, row, element_row, elements)
}

// A List of the element slots `elements` in fresh frame storage.
fn ir_list_from(m: &IRModule, b: &IRBuilder, row: Int, element_row: Int, elements: [Int]) -> Int Never! {
    stride :: ir_list_stride(m, element_row)
    storage :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, storage, 24, 8, -1, b.line)
    count :: ir_word_const(&m, &b, elements.len())
    ir_emit(&b.f, IROp.Store, -1, storage, 0, count, b.line)
    ir_emit(&b.f, IROp.Store, -1, storage, 8, count, b.line)
    if elements.len() == 0 {
        ir_emit(&b.f, IROp.Store, -1, storage, 16, ir_word_const(&m, &b, 0), b.line)
        return storage
    }
    data :: ir_box_alloc(&m, &b, elements.len() * stride, ir_word_row(&m))
    loop (index, slot) in elements -> ir_store_at(&m, &b, data, index * stride, slot)
    ir_emit(&b.f, IROp.Store, -1, storage, 16, data, b.line)
    storage
}

// An exact Int list position as a native word (jet_int_owned_to_i64).
fn ir_native_index(m: &IRModule, b: &IRBuilder, position: Int, span: Span) -> Int Never! {
    kind :: ir_kind_of(m, b, position)
    if kind == .Int -> return ir_runtime(&m, &b, "jet_int_owned_to_i64", [Int]{position}, ir_word_row(&m))
    if kind == .Word && m.types[b.f.slot_type[position]].size == 8 -> return position
    ir_fail_slot(&b, span, "list position of {m.types[b.f.slot_type[position]].ty}")
}

// The address of element `index` of the list at `list`, after the bounds
// check (jet_rt_panic_list_bounds(length, index)).
fn ir_checked_element(m: &IRModule, p: &IRProgram, b: &IRBuilder, list: Int, index: TExpr, row: Int, span: Span) -> Int Never! {
    position :: ir_expr(&m, &p, &b, index)
    if ir_failed(b) || position < 0 -> return -1
    native :: ir_native_index(&m, &b, position, span)
    if ir_failed(b) -> return -1
    length :: ir_load_word(&m, &b, list, 0)
    zero :: ir_word_const(&m, &b, 0)
    bad :: ir_bool_op(&m, &b, IROp.Ge, native, length)
    ir_open_if(&b.f, ir_bool_op(&m, &b, IROp.Lt, native, zero), b.line)
    ir_emit(&b.f, IROp.Const, bad, 1, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_open_if(&b.f, bad, b.line)
    _ :: ir_runtime(&m, &b, "jet_rt_panic_list_bounds", [Int]{length, native}, -1)
    ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
    ir_end(&b.f, b.line)
    data :: ir_load_word(&m, &b, list, 16)
    ir_element_address(&m, &b, data, native, ir_list_stride(m, row))
}

fn ir_list_index(m: &IRModule, p: &IRProgram, b: &IRBuilder, base: TExpr, index: TExpr, span: Span) -> Int Never! {
    list :: ir_expr(&m, &p, &b, base)
    if ir_failed(b) || list < 0 -> return -1
    row :: ir_list_element(&m, p, b, list) ?? return ir_fail_slot(&b, span, "index read of {ir_type_name(base.ty)}")
    address :: ir_checked_element(&m, &p, &b, list, index, row, span)
    if ir_failed(b) -> return -1
    ir_load_at(&m, &b, address, 0, row)
}

fn ir_list_index_assign(m: &IRModule, p: &IRProgram, b: &IRBuilder, base: TExpr, index: TExpr, value: TExpr, span: Span) Never! {
    list :: ir_expr(&m, &p, &b, base)
    if ir_failed(b) || list < 0 -> return
    row :: ir_list_element(&m, p, b, list) ?? return ir_fail(&b, span, "index write of {ir_type_name(base.ty)}")
    address :: ir_checked_element(&m, &p, &b, list, index, row, span)
    if ir_failed(b) -> return
    slot :: ir_value_as(&m, &p, &b, value, row, span)
    if ir_failed(b) -> return
    ir_store_at(&m, &b, address, 0, slot)
}

// `loop x in xs` / `loop (i, x) in xs` over a List: an index walk.
fn ir_list_walk(m: &IRModule, p: &IRProgram, b: &IRBuilder, label: String?, variable: TLocal, variable_two: TLocal?, collection: TExpr, body: [TStmt], span: Span) Never! {
    list :: ir_expr(&m, &p, &b, collection)
    if ir_failed(b) || list < 0 -> return
    row :: ir_list_element(&m, p, b, list) ?? return ir_fail(&b, span, "loop over {ir_type_name(collection.ty)}")
    stride :: ir_list_stride(m, row)
    ir_scope_open(&b)
    length :: ir_load_word(&m, &b, list, 0)
    data :: ir_load_word(&m, &b, list, 16)
    index :: ir_word_const(&m, &b, 0)
    exit :: ir_open(&b.f, IROp.Block, b.line)
    _ :: ir_open(&b.f, IROp.Loop, b.line)
    ir_exit_unless(&m, &b, ir_bool_op(&m, &b, IROp.Lt, index, length), exit)
    step_block :: ir_open(&b.f, IROp.Block, b.line)
    &b.loops.push(IRLoopFrame{label: label, exit: exit, next: step_block, mark: b.bindings.len()})
    item :: ir_load_at(&m, &b, ir_element_address(&m, &b, data, index, stride), 0, row)
    if variable_two == .Val(second) {
        position :: ir_new_slot(&b, ir_type_row(&m, Type.Int) ?? 0, IRSlotKind.Local, ir_intern_name(&m, variable.name))
        ir_emit(&b.f, IROp.Copy, position, index, -1, -1, b.line)
        &b.bindings.push(IRBinding{name: variable.name, slot: position})
        if item >= 0 -> &b.bindings.push(IRBinding{name: second.name, slot: item})
    } else if item >= 0 {
        &b.bindings.push(IRBinding{name: variable.name, slot: item})
    }
    ir_stmts(&m, &p, &b, body)
    _ :: &b.loops.pop()
    ir_end(&b.f, b.line)
    one :: ir_word_const(&m, &b, 1)
    ir_emit(&b.f, IROp.Add, index, index, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    ir_scope_close(&m, &b)
}

// A copy of the value in `slot` that owns its own storage: Strings and
// exact Ints through their runtime clone, a List with a buffer of its own,
// any other aggregate byte for byte.
fn ir_copy_value(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int, span: Span) -> Int Never! {
    row :: b.f.slot_type[slot]
    kind :: m.types[row].kind
    if kind == .String -> return ir_runtime(&m, &b, "jet_rt_string_clone", [Int]{slot}, row)
    if kind == .Int -> return ir_runtime(&m, &b, "jet_rt_int_clone", [Int]{slot}, row)
    if kind == .Aggregate {
        storage :: ir_fresh_temp(&m, &b, row)
        ir_emit(&b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
        ir_emit(&b.f, IROp.CopyBytes, -1, storage, slot, m.types[row].size, b.line)
        if ir_list_element(&m, p, b, slot) == .Val(element_row) {
            length :: ir_load_word(&m, &b, slot, 0)
            bytes :: ir_word_op(&m, &b, IROp.Mul, length, ir_word_const(&m, &b, ir_list_stride(m, element_row)))
            ir_emit(&b.f, IROp.Store, -1, storage, 8, length, b.line)
            align :: ir_word_const(&m, &b, 8)
            data :: ir_runtime(&m, &b, "jet_rt_alloc", [Int]{ir_word_op(&m, &b, IROp.Add, bytes, align), align}, ir_word_row(&m))
            _ :: ir_runtime(&m, &b, "jet_rt_mem_move", [Int]{data, ir_load_word(&m, &b, slot, 16), bytes}, -1)
            ir_emit(&b.f, IROp.Store, -1, storage, 16, data, b.line)
        }
        return storage
    }
    duplicate :: ir_temp_like(&m, &b, slot)
    ir_emit(&b.f, IROp.Copy, duplicate, slot, -1, -1, b.line)
    duplicate
}

// `list.push(value)`: grows the buffer to twice its capacity (at least 4)
// when full, then stores the element at `len` (Lower lower_helper_list_push).
fn ir_list_push(m: &IRModule, b: &IRBuilder, list: Int, row: Int, value: Int) Never! {
    stride :: ir_list_stride(m, row)
    width :: ir_word_const(&m, &b, stride)
    length :: ir_load_word(&m, &b, list, 0)
    capacity :: ir_load_word(&m, &b, list, 8)
    ir_open_if(&b.f, ir_bool_op(&m, &b, IROp.Eq, length, capacity), b.line)
    grown :: ir_word_op(&m, &b, IROp.Add, capacity, capacity)
    four :: ir_word_const(&m, &b, 4)
    ir_open_if(&b.f, ir_bool_op(&m, &b, IROp.Lt, grown, four), b.line)
    ir_emit(&b.f, IROp.Copy, grown, four, -1, -1, b.line)
    ir_end(&b.f, b.line)
    align :: ir_word_const(&m, &b, 8)
    data :: ir_runtime(&m, &b, "jet_rt_alloc", [Int]{ir_word_op(&m, &b, IROp.Mul, grown, width), align}, ir_word_row(&m))
    _ :: ir_runtime(&m, &b, "jet_rt_mem_move", [Int]{data, ir_load_word(&m, &b, list, 16), ir_word_op(&m, &b, IROp.Mul, length, width)}, -1)
    ir_emit(&b.f, IROp.Store, -1, list, 16, data, b.line)
    ir_emit(&b.f, IROp.Store, -1, list, 8, grown, b.line)
    ir_end(&b.f, b.line)
    address :: ir_element_address(&m, &b, ir_load_word(&m, &b, list, 16), length, stride)
    ir_store_at(&m, &b, address, 0, value)
    ir_emit(&b.f, IROp.Store, -1, list, 0, ir_word_op(&m, &b, IROp.Add, length, ir_word_const(&m, &b, 1)), b.line)
}

// Builtin methods (codegen jet_codegen_builtin_route_plan): Lists inline,
// Strings through the runtime routes the old path calls.
fn ir_builtin(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, receiver: TExpr, operation: TBuiltinOp, args: [TExpr], span: Span) -> Int Never! {
    subject :: ir_expr(&m, &p, &b, receiver)
    if ir_failed(b) || subject < 0 -> return -1
    kind :: ir_kind_of(m, b, subject)
    element := -1
    if ir_list_element(&m, p, b, subject) == .Val(row) -> element = row
    operands := [Int]{subject}
    loop arg in args {
        slot :: ir_expr(&m, &p, &b, arg)
        if ir_failed(b) -> return -1
        &operands.push(slot)
    }
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    int_row :: ir_type_row(&m, Type.Int) ?? 0
    if element >= 0 {
        if operation == {
            .LenList -> return ir_load_at(&m, &b, subject, 0, int_row)
            .IsEmpty -> return ir_bool_op(&m, &b, IROp.Eq, ir_load_word(&m, &b, subject, 0), ir_word_const(&m, &b, 0))
            .Push -> {
                if operands.len() != 2 || operands[1] < 0 -> return ir_fail_slot(&b, span, "push without a value")
                value :: ir_adapt(&m, p, &b, operands[1], element, span)
                if ir_failed(b) -> return -1
                ir_list_push(&m, &b, subject, element, value)
                return -1
            }
            .Clear -> {
                ir_emit(&b.f, IROp.Store, -1, subject, 0, ir_word_const(&m, &b, 0), b.line)
                return -1
            }
            .JoinSep -> {
                if operands.len() != 2 -> return ir_fail_slot(&b, span, "join without a separator")
                separator :: operands[1]
                builder :: ir_runtime(&m, &b, "jet_rt_string_builder_new", [Int]{}, ir_pointer_row(&m))
                b.fresh[builder] = false
                walk :: ir_walk_open(&m, &b, subject, element)
                later :: ir_bool_op(&m, &b, IROp.Ne, walk.index, ir_word_const(&m, &b, 0))
                ir_open_if(&b.f, later, b.line)
                _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, separator}, -1)
                ir_end(&b.f, b.line)
                ir_render_push_value(&m, p, &b, builder, walk.item, IRRender.Show, span)
                ir_walk_close(&m, &b, walk)
                return ir_runtime(&m, &b, "jet_rt_string_builder_finish", [Int]{builder}, ir_string_row(&m))
            }
            else -> {}
        }
    }
    if kind == .String {
        // Lower lower_string_method calls these exports directly; every other
        // String builtin crosses its runtime route.
        symbol :: if operation == {
            .LenString -> "jet_char_len"
            .IsEmpty -> "jet_string_is_empty"
            .Contains -> "jet_string_contains"
            .StartsWith -> "jet_string_starts_with"
            .EndsWith -> "jet_string_ends_with"
            else -> ""
        }
        if symbol != "" {
            result_row :: if operation == .LenString -> int_row else -> bool_row
            result :: ir_runtime(&m, &b, symbol, operands, result_row)
            loop operand in operands -> ir_release(&m, &b, operand)
            return result
        }
    }
    ir_builtin_route(&m, &p, &b, ty, receiver.ty, operation, operands, span)
}

// A builtin method through its canonical route (codegen
// jet_codegen_builtin_route_plan, Lower lower_route_call).
fn ir_builtin_route(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, receiver_ty: Type, operation: TBuiltinOp, operands: [Int], span: Span) -> Int Never! {
    if operation == {
        .OptionZip(_, _) | .Zip(_, _, _, _, _, _, _) | .Unzip(_) | .Indexes | .ListMinMax(_) | .Indexed(_) | .MapToList(_) | .IterSplit(_) | .ToString
        | .RemoveList(_, _) | .PriorityQueueRemove(_, _) | .MapNew | .SetCopy | .BitSetNew | .ByteBufferNew | .BagLen | .AtomicMethod(_) | .ViewNew(_) | .ViewMutNew(_) | .ComputeViewNew(_) | .ComputeViewMutNew(_) -> return ir_fail_slot(&b, span, "builtin {ir_builtin_name(operation)}")
        else -> {}
    }
    if tir_builtin_mutates_receiver(operation) -> return ir_fail_slot(&b, span, "mutating builtin {ir_builtin_name(operation)} on {receiver_ty}")
    route :: jet_codegen_builtin_route_plan(operation, receiver_ty, ty, jet_codegen_failure_carrier_for_type(ty))
    if route.arity != operands.len() -> return ir_fail_slot(&b, span, "builtin {ir_builtin_name(operation)} with {operands.len()} of {route.arity} operands")
    result :: if ir_unit_type(ty) || ir_never_type(ty) -> Type.Named{name: "Unit"} else -> ty
    ir_route(&m, &p, &b, route.symbol, operands, route.borrow_mask, result, span)
}

// A tuple value in fresh frame storage: each value at the member of its
// name, or of its position when the type names it otherwise.
fn ir_tuple_literal(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, names: [String], values: [TExpr], span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    members := [IRMember]{}
    if ir_untag(ir_subst(p, ty)) == .Tuple(fields) {
        members = ir_tuple_members(&m, p, fields) ?? return ir_type_fail(&b, span, ty)
    }
    if members.len() != values.len() -> return ir_fail_slot(&b, span, "tuple literal of {ir_type_name(ty)}")
    slots := [Int]{}
    loop (index, value) in values {
        member := members[index]
        loop candidate in members {
            if candidate.name == names[index] -> member = candidate
        }
        slot :: ir_value_as(&m, &p, &b, value, member.ty, span)
        if ir_failed(b) -> return -1
        &slots.push(slot)
    }
    storage :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
    loop (index, slot) in slots {
        member := members[index]
        loop candidate in members {
            if candidate.name == names[index] -> member = candidate
        }
        ir_store_at(&m, &b, storage, member.offset, slot)
    }
    storage
}

// ---------------------------------------------------------------------------
// Closures (Lower Closures.jet layout): a heap box with its reference count
// at 0, its code address at 8, a release helper at 16 (none yet) and the
// captures from 24. The code takes the box as its hidden first parameter. A
// capture the body writes is held by address: its variable becomes a frame
// cell from the closure's creation on.

fn ir_lambda(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, lambda: TLambda, span: Span) -> Int Never! {
    if lambda.executable == .SharedBlock(_) -> return ir_fail_slot(&b, span, "shared-block lambda")
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    captures := [IRCaptureSlot]{}
    offset := 24
    loop capture in lambda.captures {
        binding :: ir_lookup_binding(b, capture.source) ?? ir_lookup_binding(b, capture.local.name) ?? return ir_fail_slot(&b, span, "capture of unknown local {capture.source}")
        by_ref :: lambda.capture_facts.mutable.contains(capture.source) || lambda.capture_facts.mutable.contains(capture.local.name)
        value_row :: if binding.indirect >= 0 -> binding.indirect else -> b.f.slot_type[binding.slot]
        size :: if by_ref -> 8 else -> ir_align8(m.types[value_row].size)
        &captures.push(IRCaptureSlot{name: capture.local.name, offset: offset, row: value_row, by_ref: by_ref})
        offset += size
    }
    boxed :: ir_box_alloc(&m, &b, offset, row)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, ir_word_const(&m, &b, 1), b.line)
    ir_emit(&b.f, IROp.Store, -1, boxed, 16, ir_word_const(&m, &b, 0), b.line)
    loop (index, capture) in lambda.captures {
        slot :: captures[index]
        source :: if ir_lookup_binding(b, capture.source) != None -> capture.source else -> capture.local.name
        binding :: ir_lookup_binding(b, source) ?? return -1
        if slot.by_ref {
            address :: if binding.indirect >= 0 || m.types[slot.row].kind == .Aggregate -> binding.slot else -> ir_cell_binding(&m, &b, source)
            ir_emit(&b.f, IROp.Store, -1, boxed, slot.offset, address, b.line)
        } else {
            ir_store_at(&m, &b, boxed, slot.offset, ir_read_binding(&m, &b, binding))
        }
    }
    id :: m.functions.len()
    &m.functions.push(ir_function_new("{b.f.name}.lambda{id}", "{b.f.key}#lambda@{span.start}", "{b.f.symbol}__lambda{id}", b.f.source_file, b.line))
    &p.lambdas.push(IRLambdaJob{lambda: lambda, captures: captures, source_file: b.f.source_file, line: b.line, subst_names: p.subst_names, subst_types: p.subst_types})
    &p.queue.push(IRQueued{row: -1, id: id, args: [Type]{}, lambda: p.lambdas.len() - 1})
    code :: ir_temp(&m, &b, ir_pointer_row(&m))
    ir_emit(&b.f, IROp.FunctionAddress, code, id, -1, -1, b.line)
    ir_emit(&b.f, IROp.Store, -1, boxed, 8, code, b.line)
    boxed
}

// Moves the variable `name` into a frame cell and rebinds it to the cell's
// address; returns the address.
fn ir_cell_binding(m: &IRModule, b: &IRBuilder, name: String) -> Int Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        if b.bindings[index].name == name -> break
        index -= 1
    }
    slot :: b.bindings[index].slot
    row :: b.f.slot_type[slot]
    size :: m.types[row].size
    cell :: ir_temp(&m, &b, ir_pointer_row(&m))
    ir_emit(&b.f, IROp.StackAddress, cell, if size < 8 -> 8 else -> size, 8, -1, b.line)
    ir_emit(&b.f, IROp.Store, -1, cell, 0, slot, b.line)
    b.bindings[index] = IRBinding{name: name, slot: cell, indirect: row, owned: b.bindings[index].owned}
    cell
}

fn ir_build_lambda(m: &IRModule, p: &IRProgram, b: &IRBuilder, job: IRLambdaJob) Never! {
    lambda :: job.lambda
    b.line = job.line
    span :: lambda.source_span
    env :: ir_new_slot(&b, ir_pointer_row(&m), IRSlotKind.Param, ir_intern_name(&m, "closure"))
    loop (index, ty) in lambda.param_types {
        name :: if index < lambda.source_params.len() -> lambda.source_params[index] else -> "_{index}"
        if ir_param_slot(&m, p, &b, ty, false, false, name) == None -> return ir_fail(&b, span, "lambda parameter type {ir_type_name(ty)}")
    }
    loop capture in job.captures {
        aggregate :: m.types[capture.row].kind == .Aggregate
        if capture.by_ref {
            address :: ir_temp(&m, &b, if aggregate -> capture.row else -> ir_pointer_row(&m))
            ir_emit(&b.f, IROp.Load, address, env, capture.offset, -1, b.line)
            &b.bindings.push(IRBinding{name: capture.name, slot: address, indirect: if aggregate -> -1 else -> capture.row})
        } else {
            address :: ir_temp(&m, &b, if aggregate -> capture.row else -> ir_pointer_row(&m))
            ir_emit(&b.f, IROp.Offset, address, env, capture.offset, -1, b.line)
            &b.bindings.push(IRBinding{name: capture.name, slot: address, indirect: if aggregate -> -1 else -> capture.row})
        }
    }
    if lambda.executable == {
        .Expr(value) -> {
            names := [String]{}
            ir_collect_mutable_captures(value, &names)
            b.cells = names
        }
        .Block(body) | .SharedBlock(body) -> b.cells = ir_mutable_captures(body)
    }
    b.failure = lambda.failure_carrier
    b.ret = lambda.ret
    if lambda.ret == .Val(ret) {
        if !ir_unit_type(ret) && !ir_never_type(ret) {
            result_row :: ir_value_type(&m, p, ret) ?? return ir_fail(&b, span, "lambda result type {ir_type_name(ret)}")
            b.f.result = result_row
        }
    }
    if lambda.executable == {
        .Expr(value) -> ir_return(&m, &p, &b, Val(value), span)
        .Block(body) -> {
            ir_stmts(&m, &p, &b, body)
            if !ir_failed(b) -> ir_return_fallthrough(&m, &p, &b)
        }
        .SharedBlock(_) -> ir_fail(&b, span, "shared-block lambda")
    }
}

// A call through a closure box: its code with the box as the hidden first
// argument (Lower Closures.jet).
fn ir_indirect_call(m: &IRModule, p: &IRProgram, b: &IRBuilder, callee: TExpr, args: [TCallArg], signature: Type, span: Span) -> Int Never! {
    params := [Type]{}
    returned := Type?{None}
    if ir_untag(ir_subst(p, signature)) == .Fn(fn_params, fn_ret, _, _, _, _) {
        params = fn_params
        returned = fn_ret
    } else {
        return ir_fail_slot(&b, span, "indirect call through {ir_type_name(signature)}")
    }
    if params.len() != args.len() -> return ir_fail_slot(&b, span, "indirect call with defaulted or variadic arguments")
    boxed :: ir_expr(&m, &p, &b, callee)
    if ir_failed(b) || boxed < 0 -> return -1
    slots := [Int]{boxed}
    loop (index, arg) in args {
        if arg.mut_borrow || arg.fn_coerce != None || arg.spread -> return ir_fail_slot(&b, span, "write or coerced argument of an indirect call")
        row :: ir_value_type(&m, p, params[index]) ?? return ir_fail_slot(&b, span, "argument type {params[index]}")
        slot :: ir_value_as(&m, &p, &b, arg.value, row, span)
        if ir_failed(b) -> return -1
        if slot < 0 -> return ir_fail_slot(&b, span, "Unit argument of an indirect call")
        &slots.push(slot)
    }
    code :: ir_temp(&m, &b, ir_pointer_row(&m))
    ir_emit(&b.f, IROp.Load, code, boxed, 8, -1, b.line)
    dst := -1
    if returned == .Val(ret) {
        if !ir_unit_type(ret) && !ir_never_type(ret) {
            result_row :: ir_value_type(&m, p, ret) ?? return ir_type_fail(&b, span, ret)
            dst = ir_fresh_temp(&m, &b, result_row)
        }
    }
    start :: ir_args(&b.f, slots)
    ir_emit(&b.f, IROp.CallIndirect, dst, code, start, slots.len(), b.line)
    loop (index, slot) in slots {
        if index > 0 -> ir_release(&m, &b, slot)
    }
    dst
}

// An integer constant of type row `row`: an exact Int outside the inline
// range is built by the runtime (jet_int_owned_from_i64).
fn ir_int_constant(m: &IRModule, b: &IRBuilder, row: Int, value: Int) -> Int Never! {
    if m.types[row].kind == .Int && !lower_int_inline(value) {
        raw :: ir_word_const(&m, &b, value)
        return ir_runtime(&m, &b, "jet_int_owned_from_i64", [Int]{raw}, row)
    }
    slot :: ir_temp(&m, &b, row)
    ir_emit(&b.f, IROp.Const, slot, value, -1, -1, b.line)
    slot
}

// A checked constant read: its compile-time value, built in place
// (codegen jet_codegen_lower_constant_reference copies a known value into
// each use).
fn ir_constant(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, key: String, span: Span) -> Int Never! {
    if p.rows.get(key) != None -> return ir_fail_slot(&b, span, "named function as a value")
    definition :: p.constants.get(key) ?? return ir_fail_slot(&b, span, "constant {key} without a declaration")
    ir_comptime(&m, &p, &b, ty, definition.value, span)
}

// A compile-time value of type `ty`.
fn ir_comptime(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, value: TComptimeValue, span: Span) -> Int Never! {
    if value == .Unit -> return -1
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    if value == {
        .Int(number) -> return ir_int_constant(&m, &b, row, number)
        .Bool(flag) -> return ir_int_constant(&m, &b, row, if flag -> 1 else -> 0)
        .Char(code) -> return ir_int_constant(&m, &b, row, code)
        .Float(number, _) -> return ir_int_constant(&m, &b, row, lower_float_constant_bits(number, m.types[row].kind == .Float32))
        .String(text) -> {
            slot :: ir_temp(&m, &b, row)
            ir_emit(&b.f, IROp.ConstText, slot, ir_intern_text(&m, text), -1, -1, b.line)
            return slot
        }
        .BigInt(decimal) -> {
            slot :: ir_fresh_temp(&m, &b, row)
            ir_emit(&b.f, IROp.ConstBigInt, slot, ir_intern_name(&m, decimal), -1, -1, b.line)
            return slot
        }
        .Present(inner) -> {
            if ir_untag(ty) == .Option(inner_ty) {
                inner_row :: ir_value_type(&m, p, inner_ty) ?? return ir_type_fail(&b, span, inner_ty)
                payload :: ir_comptime(&m, &p, &b, inner_ty, inner, span)
                if ir_failed(b) -> return -1
                inner_size :: m.types[inner_row].size
                boxed :: ir_box_alloc(&m, &b, inner_size, row)
                ir_store_at(&m, &b, boxed, 0, payload)
                return boxed
            }
            return ir_fail_slot(&b, span, "present constant of {ir_type_name(ty)}")
        }
        .List(values) -> {
            if ir_untag(ty) == .List(element) {
                element_row :: ir_value_type(&m, p, element) ?? return ir_type_fail(&b, span, element)
                elements := [Int]{}
                loop item in values {
                    slot :: ir_comptime(&m, &p, &b, element, item, span)
                    if ir_failed(b) -> return -1
                    &elements.push(slot)
                }
                return ir_list_from(&m, &b, row, element_row, elements)
            }
            return ir_fail_slot(&b, span, "list constant of {ir_type_name(ty)}")
        }
        else -> return ir_fail_slot(&b, span, "constant value {ir_comptime_name(value)}")
    }
}

fn ir_comptime_name(value: TComptimeValue) -> String Never! {
    text := "{value}"
    separators :: [String]{"(", "{{", " "}
    loop separator in separators {
        parts :: text.split(separator).to_list()
        text = parts[0]
    }
    text
}

// ---------------------------------------------------------------------------
// Program stops (Lower Require.jet): require / require_eq / panic report
// through jet_rt_require_stop(ordinal, descriptor, message, left, right,
// locals), which does not return. The 88-byte descriptor holds the path,
// line, function, source line, column, caret and the rendered context text.

fn ir_require_stop(m: &IRModule, p: &IRProgram, b: &IRBuilder, kind: TRequireKind, location: TPanicLoc, always_stops: Bool, span: Span) -> Int Never! {
    if kind == {
        .Require(test, message) -> {
            condition :: ir_expr(&m, &p, &b, test)
            if ir_failed(b) || condition < 0 -> return -1
            if !always_stops {
                failed :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
                ir_emit(&b.f, IROp.Not, failed, condition, -1, -1, b.line)
                ir_open_if(&b.f, failed, b.line)
            }
            text := -1
            if message == .Val(value) {
                slot :: ir_expr(&m, &p, &b, value)
                if ir_failed(b) -> return -1
                text = ir_render(&m, p, &b, value.ty, slot, IRRender.Display, span)
            } else {
                text = ir_temp(&m, &b, ir_string_row(&m))
                ir_emit(&b.f, IROp.ConstText, text, ir_intern_text(&m, "condition failed"), -1, -1, b.line)
            }
            if ir_failed(b) -> return -1
            null :: ir_word_const(&m, &b, 0)
            ir_stop(&m, &p, &b, 0, text, null, null, location)
            if !always_stops -> ir_end(&b.f, b.line)
        }
        .RequireEq(left, right) -> {
            left_slot :: ir_expr(&m, &p, &b, left)
            right_slot :: ir_expr(&m, &p, &b, right)
            if ir_failed(b) || left_slot < 0 || right_slot < 0 -> return -1
            site :: b.line
            equal :: ir_binary(&m, &p, &b, TBinaryOp.Eq, false, site, left.ty, left_slot, right_slot, right.ty, span)
            if ir_failed(b) -> return -1
            if !always_stops {
                failed :: ir_temp(&m, &b, ir_type_row(&m, Type.Bool) ?? 0)
                ir_emit(&b.f, IROp.Not, failed, equal, -1, -1, b.line)
                ir_open_if(&b.f, failed, b.line)
            }
            left_text :: ir_render(&m, p, &b, left.ty, left_slot, IRRender.Debug, span)
            right_text :: ir_render(&m, p, &b, right.ty, right_slot, IRRender.Debug, span)
            if ir_failed(b) -> return -1
            ir_stop(&m, &p, &b, 1, ir_word_const(&m, &b, 0), left_text, right_text, location)
            if !always_stops -> ir_end(&b.f, b.line)
        }
        .Panic(message) -> {
            slot :: ir_expr(&m, &p, &b, message)
            if ir_failed(b) -> return -1
            text :: ir_render(&m, p, &b, message.ty, slot, IRRender.Display, span)
            if ir_failed(b) -> return -1
            null :: ir_word_const(&m, &b, 0)
            ir_stop(&m, &p, &b, 2, text, null, null, location)
        }
    }
    -1
}

// The stop call itself (then unreachable).
fn ir_stop(m: &IRModule, p: &IRProgram, b: &IRBuilder, ordinal: Int, message: Int, left: Int, right: Int, location: TPanicLoc) Never! {
    locals := ir_word_const(&m, &b, 0)
    if location.locals.len() > 0 {
        builder :: ir_runtime(&m, &b, "jet_rt_string_builder_new", [Int]{}, ir_pointer_row(&m))
        b.fresh[builder] = false
        loop (index, local) in location.locals {
            binding :: ir_lookup_binding(b, local.local.name) ?? return ir_fail(&b, Span{start: 0, end: 0}, "panic report local {local.display_name} is not visible")
            value :: ir_read_binding(&m, &b, binding)
            value_ty :: m.types[b.f.slot_type[value]].ty
            text :: ir_render(&m, p, &b, value_ty, value, IRRender.Debug, Span{start: 0, end: 0})
            if ir_failed(b) -> return
            ir_push_static(&m, &b, builder, "{if index > 0 -> ", " else -> ""}{local.display_name} = ")
            _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
        }
        locals = ir_runtime(&m, &b, "jet_rt_string_builder_finish", [Int]{builder}, ir_string_row(&m))
    }
    descriptor :: ir_temp(&m, &b, ir_pointer_row(&m))
    ir_emit(&b.f, IROp.StackAddress, descriptor, 88, 8, -1, b.line)
    ir_store_text(&m, &b, descriptor, 0, location.file)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 16, ir_word_const(&m, &b, location.line), b.line)
    function_name :: b.f.name
    ir_store_text(&m, &b, descriptor, 24, function_name)
    ir_store_text(&m, &b, descriptor, 40, location.source_line)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 56, ir_word_const(&m, &b, location.column), b.line)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 64, ir_word_const(&m, &b, location.caret), b.line)
    ir_store_text(&m, &b, descriptor, 72, ir_stop_context(location.file, location, b.f.name))
    _ :: ir_runtime(&m, &b, "jet_rt_require_stop", [Int]{ir_word_const(&m, &b, ordinal), descriptor, message, left, right, locals}, -1)
    ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
}

// A static text's (address, length) pair at `offset` of the storage at `base`.
fn ir_store_text(m: &IRModule, b: &IRBuilder, base: Int, offset: Int, text: String) Never! {
    pair :: ir_static_text(&m, &b, text)
    ir_emit(&b.f, IROp.Store, -1, base, offset, pair[0], b.line)
    ir_emit(&b.f, IROp.Store, -1, base, offset + 8, pair[1], b.line)
}

// Lower lower_require_context_text: the report's static context, with the
// runtime's exact spacing.
fn ir_stop_context(path: String, location: TPanicLoc, function: String) -> String Never! {
    out := [U8]{}
    if path != "" {
        heading :: if function == "" -> "  --> {path}:{location.line}\n" else -> "  --> {path}:{location.line} in {function}\n"
        loop byte in heading.bytes() -> &out.push(byte)
    }
    if location.source_line != "" {
        digits :: "{location.line}".bytes().len()
        loop _ in 0..<(digits + 3) -> &out.push(U8{32})
        loop byte in "|\n{location.line} | {location.source_line}\n".bytes() -> &out.push(byte)
        loop _ in 0..<(digits + 3) -> &out.push(U8{32})
        &out.push(U8{124})
        &out.push(U8{32})
        loop _ in 0..<(if location.column > 0 -> location.column - 1 else -> 0) -> &out.push(U8{32})
        loop _ in 0..<(if location.caret > 0 -> location.caret else -> 1) -> &out.push(U8{94})
        &out.push(U8{10})
    }
    String.from_bytes(out) ?? ""
}

// ---------------------------------------------------------------------------
// List closure methods (codegen ClosureMethods.jet routes jet_list_map,
// jet_list_filter, ...), expanded inline over the list with each element
// passed to the closure box.

fn ir_call_closure(m: &IRModule, b: &IRBuilder, boxed: Int, args: [Int], result_row: Int) -> Int Never! {
    code :: ir_temp(&m, &b, ir_pointer_row(&m))
    ir_emit(&b.f, IROp.Load, code, boxed, 8, -1, b.line)
    operands := [Int]{boxed}
    loop arg in args -> &operands.push(arg)
    dst :: if result_row >= 0 && m.types[result_row].kind != .Unit -> ir_fresh_temp(&m, &b, result_row) else -> -1
    start :: ir_args(&b.f, operands)
    ir_emit(&b.f, IROp.CallIndirect, dst, code, start, operands.len(), b.line)
    dst
}

// An empty List of type row `row` in fresh frame storage.
fn ir_list_empty(m: &IRModule, b: &IRBuilder, row: Int) -> Int Never! {
    storage :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, storage, 24, 8, -1, b.line)
    zero :: ir_word_const(&m, &b, 0)
    ir_emit(&b.f, IROp.Store, -1, storage, 0, zero, b.line)
    ir_emit(&b.f, IROp.Store, -1, storage, 8, zero, b.line)
    ir_emit(&b.f, IROp.Store, -1, storage, 16, zero, b.line)
    storage
}

fn ir_closure_method(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, receiver: TExpr, operation: TClosureOp, args: [TExpr], span: Span) -> Int Never! {
    list :: ir_expr(&m, &p, &b, receiver)
    if ir_failed(b) || list < 0 -> return -1
    element :: ir_list_element(&m, p, b, list) ?? return ir_fail_slot(&b, span, "closure method {ir_closure_op_name(operation)} on {ir_type_name(receiver.ty)}")
    operands := [Int]{}
    loop arg in args {
        slot :: ir_expr(&m, &p, &b, arg)
        if ir_failed(b) -> return -1
        &operands.push(slot)
    }
    if operands.len() == 0 -> return ir_fail_slot(&b, span, "closure method without a closure")
    callback :: operands[operands.len() - 1]
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    result_row :: if ir_unit_type(ty) -> -1 else -> ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    if operation == {
        .Each | .EachRef -> {
            walk :: ir_walk_open(&m, &b, list, element)
            _ :: ir_call_closure(&m, &b, callback, [Int]{walk.item}, -1)
            ir_walk_close(&m, &b, walk)
            return -1
        }
        .Map -> {
            result :: ir_list_empty(&m, &b, result_row)
            mapped_row :: ir_list_element(&m, p, b, result) ?? return ir_fail_slot(&b, span, "map result {ir_type_name(ty)}")
            walk :: ir_walk_open(&m, &b, list, element)
            ir_list_push(&m, &b, result, mapped_row, ir_call_closure(&m, &b, callback, [Int]{walk.item}, mapped_row))
            ir_walk_close(&m, &b, walk)
            return result
        }
        .Filter -> {
            result :: ir_list_empty(&m, &b, result_row)
            walk :: ir_walk_open(&m, &b, list, element)
            keep :: ir_call_closure(&m, &b, callback, [Int]{walk.item}, bool_row)
            ir_open_if(&b.f, keep, b.line)
            ir_list_push(&m, &b, result, element, walk.item)
            ir_end(&b.f, b.line)
            ir_walk_close(&m, &b, walk)
            return result
        }
        .Any | .All -> {
            any :: operation == .Any
            result :: ir_temp(&m, &b, bool_row)
            ir_emit(&b.f, IROp.Const, result, if any -> 0 else -> 1, -1, -1, b.line)
            walk :: ir_walk_open(&m, &b, list, element)
            test :: ir_call_closure(&m, &b, callback, [Int]{walk.item}, bool_row)
            decided :: if any -> test else -> ir_bool_op(&m, &b, IROp.Eq, test, ir_int_constant(&m, &b, bool_row, 0))
            ir_open_if(&b.f, decided, b.line)
            ir_emit(&b.f, IROp.Const, result, if any -> 1 else -> 0, -1, -1, b.line)
            ir_emit(&b.f, IROp.Br, -1, 2, -1, -1, b.line)
            ir_end(&b.f, b.line)
            ir_walk_close(&m, &b, walk)
            return result
        }
        .CountWhere -> {
            count :: ir_word_const(&m, &b, 0)
            walk :: ir_walk_open(&m, &b, list, element)
            test :: ir_call_closure(&m, &b, callback, [Int]{walk.item}, bool_row)
            ir_open_if(&b.f, test, b.line)
            ir_emit(&b.f, IROp.Add, count, count, ir_word_const(&m, &b, 1), IR_OVERFLOW_WRAP, b.line)
            ir_end(&b.f, b.line)
            ir_walk_close(&m, &b, walk)
            result :: ir_temp(&m, &b, result_row)
            ir_emit(&b.f, IROp.Copy, result, count, -1, -1, b.line)
            return result
        }
        .Fold -> {
            if operands.len() != 2 -> return ir_fail_slot(&b, span, "fold without an initial value")
            accumulator :: ir_temp(&m, &b, result_row)
            ir_store(&m, &b, accumulator, ir_adapt(&m, p, &b, operands[0], result_row, span))
            walk :: ir_walk_open(&m, &b, list, element)
            next_value :: ir_call_closure(&m, &b, callback, [Int]{accumulator, walk.item}, result_row)
            ir_store(&m, &b, accumulator, next_value)
            ir_walk_close(&m, &b, walk)
            return accumulator
        }
        .Find -> {
            result :: ir_temp(&m, &b, result_row)
            ir_emit(&b.f, IROp.Const, result, 0, -1, -1, b.line)
            walk :: ir_walk_open(&m, &b, list, element)
            test :: ir_call_closure(&m, &b, callback, [Int]{walk.item}, bool_row)
            ir_open_if(&b.f, test, b.line)
            element_size :: m.types[element].size
            boxed :: ir_box_alloc(&m, &b, element_size, result_row)
            ir_store_at(&m, &b, boxed, 0, walk.item)
            ir_emit(&b.f, IROp.Copy, result, boxed, -1, -1, b.line)
            ir_emit(&b.f, IROp.Br, -1, 2, -1, -1, b.line)
            ir_end(&b.f, b.line)
            ir_walk_close(&m, &b, walk)
            return result
        }
        else -> return ir_fail_slot(&b, span, "closure method {ir_closure_op_name(operation)}")
    }
}

fn ir_closure_op_name(operation: TClosureOp) -> String Never! {
    text := "{operation}"
    separators :: [String]{"(", "{{", " "}
    loop separator in separators {
        parts :: text.split(separator).to_list()
        text = parts[0]
    }
    text
}

// ---------------------------------------------------------------------------
// Runtime routes (Lower Routes.jet lower_route_call / lower_route_result):
// Core calls, Prelude conversions and builtin methods call the runtime's
// C-ABI export of their route (RuntimeRoutes.jet). Each argument crosses as
// its route carrier: a Word is the exact-Int carrier word (a fixed-width
// integer is boxed into one for the call), a List its data pointer and
// length. A List result comes back as its length with its data in an out
// slot; an Option or Result result as a tag word with its payload in one
// zeroed out slot, from which the builder makes its own box.

// `inputs[i]` is an argument slot; `borrowed[i]` whether the route only reads
// it (a fresh borrowed argument is dropped after the call; a consumed one
// belongs to the route, so a read of another holder's value is copied first).
fn ir_route(m: &IRModule, p: &IRProgram, b: &IRBuilder, symbol: String, inputs: [Int], borrowed: [Bool], result: Type, span: Span) -> Int Never! {
    name :: ir_route_symbol(symbol)
    route :: lower_runtime_route(name) ?? return ir_fail_slot(&b, span, "runtime route {name}")
    if route.params.len() != inputs.len() -> return ir_fail_slot(&b, span, "runtime route {name} takes {route.params.len()} arguments, not {inputs.len()}")
    args := [Int]{}
    loop (index, slot) in inputs {
        &args.push(if index < borrowed.len() && !borrowed[index] -> ir_own(&m, &b, slot) else -> slot)
    }
    lowered := [Int]{}
    temporaries := [Int]{}
    loop (index, slot) in args {
        carrier :: route.params[index]
        if carrier == .Unit -> next
        if slot < 0 -> return ir_fail_slot(&b, span, "runtime route {name} argument {index} without a value")
        kind :: ir_kind_of(m, b, slot)
        if carrier == {
            .Word -> {
                if kind == .Int {
                    &lowered.push(slot)
                } else if kind == .Word {
                    row :: m.types[b.f.slot_type[slot]]
                    if !row.signed && row.bits == 64 -> return ir_fail_slot(&b, span, "runtime route {name} U64 argument")
                    exact :: ir_runtime(&m, &b, "jet_int_owned_from_i64", [Int]{slot}, ir_type_row(&m, Type.Int) ?? 0)
                    &lowered.push(exact)
                    &temporaries.push(exact)
                } else {
                    return ir_fail_slot(&b, span, "runtime route {name} Word argument of {m.types[b.f.slot_type[slot]].ty}")
                }
            }
            .Flag -> {
                if kind != .Bool -> return ir_fail_slot(&b, span, "runtime route {name} Flag argument of {m.types[b.f.slot_type[slot]].ty}")
                &lowered.push(slot)
            }
            .Float -> {
                if kind != .Float -> return ir_fail_slot(&b, span, "runtime route {name} Float argument of {m.types[b.f.slot_type[slot]].ty}")
                &lowered.push(slot)
            }
            .Text -> {
                if kind != .String -> return ir_fail_slot(&b, span, "runtime route {name} Text argument of {m.types[b.f.slot_type[slot]].ty}")
                &lowered.push(slot)
            }
            .Tag(_, variants) -> {
                row :: ir_enum_def(m, p, b.f.slot_type[slot]) ?? return ir_fail_slot(&b, span, "runtime route {name} Tag argument of {m.types[b.f.slot_type[slot]].ty}")
                if kind != .Word || ir_variant_names(p, row) != variants -> return ir_fail_slot(&b, span, "runtime route {name} Tag argument of {m.types[b.f.slot_type[slot]].ty}")
                &lowered.push(slot)
            }
            .List(element) -> {
                if ir_list_element(&m, p, b, slot) == None -> return ir_fail_slot(&b, span, "runtime route {name} List argument of {m.types[b.f.slot_type[slot]].ty}")
                if element == .List(_) || element == .Handle(_) -> return ir_fail_slot(&b, span, "runtime route {name} List of {element}")
                &lowered.push(ir_load_word(&m, &b, slot, 16))
                &lowered.push(ir_load_word(&m, &b, slot, 0))
            }
            else -> return ir_fail_slot(&b, span, "runtime route {name} argument carrier {carrier}")
        }
    }
    dst := -1
    if route.result == {
        .Plain(carrier) -> dst = ir_route_plain(&m, p, &b, route.export, lowered, carrier, result, span)
        .Option(some) -> dst = ir_route_option(&m, p, &b, route.export, lowered, some, result, span)
        .Result(ok, err) -> dst = ir_route_result(&m, p, &b, route.export, lowered, ok, err, result, span)
        .Tuple(_) -> return ir_fail_slot(&b, span, "runtime route {name} with a tuple result")
    }
    if ir_failed(b) -> return -1
    loop temporary in temporaries -> ir_release(&m, &b, temporary)
    loop (index, slot) in args {
        if slot < 0 -> next
        if index < borrowed.len() && !borrowed[index] {
            b.fresh[slot] = false
        } else {
            ir_release(&m, &b, slot)
        }
    }
    dst
}

// Lower Strings.jet lower_route_symbol: a view route is its owned twin.
fn ir_route_symbol(symbol: String) -> String Never! {
    if symbol == "jet_string_after_view" -> return "jet_string_after"
    if symbol == "jet_string_before_view" -> return "jet_string_before"
    if symbol == "jet_string_trim_view" || symbol == "jet_unicode_trim_view" -> return "jet_unicode_trim"
    symbol.copy()
}

// The variant names of the enum declaration `row`, comma-joined.
fn ir_variant_names(p: IRProgram, row: Int) -> String Never! {
    names := [String]{}
    if p.types[row].kind == .Enum(variants, _) {
        loop variant in variants -> &names.push(variant.name)
    }
    names.join(",")
}

// A zeroed frame out slot of `words` words.
fn ir_out_slot(m: &IRModule, b: &IRBuilder, words: Int) -> Int Never! {
    slot :: ir_temp(&m, &b, ir_pointer_row(&m))
    ir_emit(&b.f, IROp.StackAddress, slot, 8 * words, 8, -1, b.line)
    zero :: ir_word_const(&m, &b, 0)
    loop index in 0..<words -> ir_emit(&b.f, IROp.Store, -1, slot, 8 * index, zero, b.line)
    slot
}

fn ir_address_at(m: &IRModule, b: &IRBuilder, base: Int, offset: Int) -> Int Never! {
    address :: ir_temp(&m, &b, ir_pointer_row(&m))
    ir_emit(&b.f, IROp.Offset, address, base, offset, -1, b.line)
    address
}

fn ir_route_plain(m: &IRModule, p: IRProgram, b: &IRBuilder, export: String, args: [Int], carrier: LowerRouteCarrier, result: Type, span: Span) -> Int Never! {
    if carrier == .Unit {
        _ :: ir_runtime(&m, &b, export, args, -1)
        return -1
    }
    row :: ir_value_type(&m, p, result) ?? return ir_type_fail(&b, span, result)
    if carrier == .List(element) {
        if element == .List(_) || element == .Handle(_) -> return ir_fail_slot(&b, span, "runtime route {export} List of {element} result")
        out :: ir_out_slot(&m, &b, 1)
        call_args := args
        &call_args.push(out)
        length :: ir_runtime(&m, &b, export, call_args, ir_word_row(&m))
        storage :: ir_fresh_temp(&m, &b, row)
        ir_emit(&b.f, IROp.StackAddress, storage, 24, 8, -1, b.line)
        ir_route_list_header(&m, &b, storage, 0, ir_load_word(&m, &b, out, 0), length)
        return storage
    }
    if carrier == .Handle(_) || carrier == .HandleMut(_) || carrier == .Option(_) -> return ir_fail_slot(&b, span, "runtime route {export} result carrier {carrier}")
    ir_runtime(&m, &b, export, args, row)
}

// A List header (len, cap, data) at `offset` of `base` from a route's
// (data, length) pair.
fn ir_route_list_header(m: &IRModule, b: &IRBuilder, base: Int, offset: Int, data: Int, length: Int) Never! {
    ir_emit(&b.f, IROp.Store, -1, base, offset, length, b.line)
    ir_emit(&b.f, IROp.Store, -1, base, offset + 8, length, b.line)
    ir_emit(&b.f, IROp.Store, -1, base, offset + 16, data, b.line)
}

// The payload a route wrote to `out` stored at `offset` of the box `base`.
fn ir_route_store_payload(m: &IRModule, p: IRProgram, b: &IRBuilder, base: Int, offset: Int, payload: Type, carrier: LowerRouteCarrier, out: Int, span: Span) Never! {
    if carrier == .Unit -> return
    if carrier == .List(_) -> return ir_route_list_header(&m, &b, base, offset, ir_load_word(&m, &b, out, 0), ir_load_word(&m, &b, out, 8))
    if carrier == .Handle(_) || carrier == .HandleMut(_) || carrier == .Option(_) -> return ir_fail(&b, span, "runtime route payload carrier {carrier}")
    row :: ir_value_type(&m, p, payload) ?? return ir_fail(&b, span, "payload type {payload}")
    value :: ir_temp(&m, &b, row)
    ir_emit(&b.f, IROp.Load, value, out, 0, -1, b.line)
    ir_emit(&b.f, IROp.Store, -1, base, offset, value, b.line)
}

fn ir_route_option(m: &IRModule, p: IRProgram, b: &IRBuilder, export: String, args: [Int], some: LowerRouteCarrier, result: Type, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, result) ?? return ir_type_fail(&b, span, result)
    payload :: if ir_untag(result) == .Option(inner) -> inner else -> { return ir_fail_slot(&b, span, "runtime route {export} Option result as {result}") }
    list :: some == .List(_)
    out :: ir_out_slot(&m, &b, if list -> 2 else -> 1)
    call_args := args
    &call_args.push(out)
    if list -> &call_args.push(ir_address_at(&m, &b, out, 8))
    selector :: ir_runtime(&m, &b, export, call_args, ir_word_row(&m))
    boxed :: ir_temp(&m, &b, row)
    ir_emit(&b.f, IROp.Const, boxed, 0, -1, -1, b.line)
    ir_open_if(&b.f, ir_bool_op(&m, &b, IROp.Ne, selector, ir_word_const(&m, &b, 0)), b.line)
    present :: ir_box_alloc(&m, &b, if list -> 24 else -> ir_type_size(&m, p, payload), row)
    ir_route_store_payload(&m, p, &b, present, 0, payload, some, out, span)
    ir_emit(&b.f, IROp.Copy, boxed, present, -1, -1, b.line)
    ir_end(&b.f, b.line)
    b.fresh[boxed] = true
    boxed
}

fn ir_route_result(m: &IRModule, p: IRProgram, b: &IRBuilder, export: String, args: [Int], ok: LowerRouteCarrier, err: LowerRouteCarrier, result: Type, span: Span) -> Int Never! {
    ok_ty := Type.Int
    err_ty := Type.Int
    if ir_untag(result) == .Result(success, failure) {
        ok_ty = success
        err_ty = failure
    } else {
        return ir_fail_slot(&b, span, "runtime route {export} Result result as {result}")
    }
    list :: ok == .List(_) || err == .List(_)
    out :: ir_out_slot(&m, &b, if list -> 2 else -> 1)
    call_args := args
    if ok != .Unit {
        &call_args.push(out)
        if ok == .List(_) -> &call_args.push(ir_address_at(&m, &b, out, 8))
    }
    if err != .Unit {
        &call_args.push(out)
        if err == .List(_) -> &call_args.push(ir_address_at(&m, &b, out, 8))
    }
    selector :: ir_runtime(&m, &b, export, call_args, ir_word_row(&m))
    boxed :: ir_result_box(&m, p, &b, result, true, -1)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, selector, b.line)
    ir_open_if(&b.f, ir_bool_op(&m, &b, IROp.Ne, selector, ir_word_const(&m, &b, 0)), b.line)
    ir_route_store_payload(&m, p, &b, boxed, 8, ok_ty, ok, out, span)
    ir_else(&b.f, b.line)
    ir_route_store_payload(&m, p, &b, boxed, 8, err_ty, err, out, span)
    ir_end(&b.f, b.line)
    b.fresh[boxed] = true
    boxed
}

// A Core call (codegen CoreCall -> Lower lower_route_call): its checked
// arguments to the record's runtime route.
fn ir_core_call(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, record: CoreCallRecord, args: [TExpr], type_args: [Type], widen: [Bool], span: Span) -> Int Never! {
    canonical :: jet_codegen_canonical_core_record(record)
    if type_args.len() > 0 -> return ir_fail_slot(&b, span, "generic Core call {canonical.module_name}.{canonical.member}")
    loop flag in widen {
        if flag -> return ir_fail_slot(&b, span, "Core call {canonical.module_name}.{canonical.member} widening a fixed list")
    }
    symbol :: if canonical.symbol == {
        .Prelude(name) -> name
        .Rust(name) -> name
        .SourceOwned -> { return ir_fail_slot(&b, span, "source-owned Core call {canonical.module_name}.{canonical.member}") }
    }
    slots := [Int]{}
    loop arg in args {
        slot :: ir_expr(&m, &p, &b, arg)
        if ir_failed(b) -> return -1
        &slots.push(slot)
    }
    result :: if ir_unit_type(ty) || ir_never_type(ty) -> Type.Named{name: "Unit"} else -> ty
    ir_route(&m, &p, &b, symbol, slots, canonical.signature.borrow_mask, result, span)
}

// A slot standing for the value of an expression control never leaves
// (after an Unreachable): -1 for Unit, else an unwritten temporary.
fn ir_unreachable_value(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type) -> Int Never! {
    if ir_unit_type(ty) || ir_never_type(ty) -> return -1
    row :: ir_value_type(&m, p, ty) ?? return -1
    if m.types[row].kind == .Unit -> return -1
    slot :: ir_temp(&m, &b, row)
    if m.types[row].kind == .Aggregate -> ir_emit(&b.f, IROp.StackAddress, slot, m.types[row].size, 8, -1, b.line)
    slot
}

// ---------------------------------------------------------------------------
// Numeric methods (codegen jet_codegen_lower_numeric_method; Lower
// Convert.jet lower_convert_numeric / lower_convert_prelude).

fn ir_numeric_method(m: &IRModule, p: &IRProgram, b: &IRBuilder, ty: Type, receiver: TExpr, operation: TNumericOp, span: Span) -> Int Never! {
    target :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    if operation == .CheckedIntToFixed(_, _, _, _) {
        // A sized literal that fits is the fixed word itself (Lower
        // lower_fixed_literal_word): no exact Int is built, nothing runs.
        if ir_int_literal(receiver) == .Val(value) {
            if ir_fixed_fits(m.types[target], value) -> return ir_int_constant(&m, &b, target, value)
        }
    }
    value :: ir_expr(&m, &p, &b, receiver)
    if ir_failed(b) || value < 0 -> return -1
    if operation == {
        .CastAs(_) -> return ir_numeric_cast(&m, p, &b, value, target, span)
        .ToShow -> return ir_render(&m, p, &b, receiver.ty, value, IRRender.Display, span)
        .InlineRange(_, _, checked) -> {
            if checked -> return ir_fail_slot(&b, span, "checked inline-range conversion")
            return ir_copy_value(&m, p, &b, value, span)
        }
        .CheckedIntToFixed(host_kind, _, _, line) -> {
            if ir_kind_of(m, b, value) != .Int || m.types[target].kind != .Word -> return ir_fail_slot(&b, span, "checked fixed conversion of {ir_type_name(receiver.ty)}")
            args := [Int]{value, ir_int_constant(&m, &b, ir_type_row(&m, Type.Int) ?? 0, host_kind)}
            loop arg in ir_location(&m, &b, if line > 0 -> line else -> b.line) -> &args.push(arg)
            result :: ir_runtime(&m, &b, ir_route_export("jet_std::jet_int_checked_fixed"), args, target)
            ir_release(&m, &b, value)
            return result
        }
        else -> return ir_fail_slot(&b, span, "numeric method {ir_numeric_op_name(operation)}")
    }
}

// The C export of a Prelude route symbol (its last `::` segment when the
// route table has no row).
fn ir_route_export(symbol: String) -> String Never! {
    if lower_runtime_route(symbol) == .Val(route) -> return route.export
    parts :: symbol.split("::").to_list()
    parts[parts.len() - 1].copy()
}

// The value of an integer literal expression (`5`, `-5`).
fn ir_int_literal(expression: TExpr) -> Int? Never! {
    if expression.kind == .IntLit(value, _) -> return Val(value)
    if expression.kind == .Unary(op, operand) {
        if op == .Neg && operand.kind == .IntLit(value, _) -> return Val(0 - value)
    }
    None
}

// Whether `value` is in the range of the fixed-width row `row`.
fn ir_fixed_fits(row: IRType, value: Int) -> Bool Never! {
    if row.kind != .Word || row.bits > 64 -> return false
    if row.bits == 64 -> return row.signed || value >= 0
    lowest :: if row.signed -> 0 - (1 << (row.bits - 1)) else -> 0
    highest :: if row.signed -> (1 << (row.bits - 1)) - 1 else -> (1 << row.bits) - 1
    value >= lowest && value <= highest
}

// A NumericCast (Lower lower_convert_numeric) between scalar rows: exact Int
// to exact Int is an owned copy; a fixed integer that already is the target's
// value is copied, a narrowing one re-read at the target width through a
// frame cell (Rust `as`); a narrow word or Char is its exact Int; I64 and
// exact Int cross through the owned runtime adapters.
fn ir_numeric_cast(m: &IRModule, p: IRProgram, b: &IRBuilder, value: Int, target: Int, span: Span) -> Int Never! {
    source :: m.types[b.f.slot_type[value]]
    destination :: m.types[target]
    if source.kind == .Int && destination.kind == .Int -> return ir_copy_value(&m, p, &b, value, span)
    if source.kind == .Word && destination.kind == .Word {
        same :: destination.bits == 64 || (destination.bits > source.bits && (destination.signed || !source.signed)) || (destination.bits == source.bits && destination.signed == source.signed)
        result :: ir_temp(&m, &b, target)
        if same {
            ir_emit(&b.f, IROp.Copy, result, value, -1, -1, b.line)
            return result
        }
        cell :: ir_temp(&m, &b, ir_pointer_row(&m))
        ir_emit(&b.f, IROp.StackAddress, cell, 8, 8, -1, b.line)
        ir_emit(&b.f, IROp.Store, -1, cell, 0, value, b.line)
        ir_emit(&b.f, IROp.Load, result, cell, 0, -1, b.line)
        return result
    }
    if source.kind == .Word && destination.kind == .Int {
        if source.bits < 64 {
            result :: ir_temp(&m, &b, target)
            ir_emit(&b.f, IROp.Copy, result, value, -1, -1, b.line)
            return result
        }
        if source.signed -> return ir_runtime(&m, &b, "jet_int_owned_from_i64", [Int]{value}, target)
        return ir_fail_slot(&b, span, "U64 to Int conversion")
    }
    if source.kind == .Char && destination.kind == .Int {
        result :: ir_temp(&m, &b, target)
        ir_emit(&b.f, IROp.Copy, result, value, -1, -1, b.line)
        return result
    }
    if source.kind == .Int && destination.kind == .Word && destination.bits == 64 && destination.signed {
        return ir_runtime(&m, &b, "jet_int_owned_to_i64", [Int]{value}, target)
    }
    if source.kind == .Int && destination.kind == .Float -> return ir_runtime(&m, &b, "jet_int_owned_to_f64", [Int]{value}, target)
    ir_fail_slot(&b, span, "numeric conversion from {ir_type_name(source.ty)} to {ir_type_name(destination.ty)}")
}

fn ir_numeric_op_name(operation: TNumericOp) -> String Never! {
    text := "{operation}"
    separators :: [String]{"(", "{{", " "}
    loop separator in separators {
        parts :: text.split(separator).to_list()
        text = parts[0]
    }
    text
}
