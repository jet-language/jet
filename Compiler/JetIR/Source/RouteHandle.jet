// Closed Prelude routing and ordinary IR lowering for checked BodyHandleOp nodes.
// Special expression families stay with their structural IR builders.
use jet_foundation.[
    Effect,
    TFailureCarrier,
    BodyHandleOp,
    Type,
    type_name,
]

IRHandleRoute: struct {
    closure_method: Bool,
    module_name: String,
    member: String,
    symbol: String,
    borrow_mask: [Bool],
    effect_kind: Effect?,
}

ir_handle_route: fn(closure_method: Bool, module_name: String, member: String, symbol: String, borrow_mask: [Bool], route_effect: Effect?) -> IRHandleRoute Never! {
    IRHandleRoute{closure_method: closure_method, module_name: module_name, member: member, symbol: symbol, borrow_mask: borrow_mask, effect_kind: route_effect}
}

ir_handle_h: fn(member: String, symbol: String, borrow_mask: [Bool], route_effect: Effect?) -> IRHandleRoute Never! {
    ir_handle_route(false, "core.handle", member, symbol, borrow_mask, route_effect)
}

ir_handle_core: fn(module_name: String, member: String, symbol: String, borrow_mask: [Bool], route_effect: Effect?) -> IRHandleRoute Never! {
    ir_handle_route(false, module_name, member, symbol, borrow_mask, route_effect)
}

ir_handle_type_without_tags: fn(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) | .InlineRange(inner, _, _) -> return ir_handle_type_without_tags(inner)
        // copy: the untagged type is a new owned Type. Otherwise it equals `ty`, the caller's
        // checked type (a read parameter), which stays on its node.
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return ty.copy()
    }
}

ir_handle_nominal_name: fn(ty: Type) -> String Never! {
    if ir_handle_type_without_tags(ty) == {
        .Named(name) | .Apply(name, _) -> return name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> panic("checked route requires a nominal receiver type")
    }
}

ir_handle_event_route: fn(receiver: Type, method: String, carrier: TFailureCarrier) -> IRHandleRoute? {
    name := ir_handle_nominal_name(receiver)
    if name == {
        "Event" | "AsyncEvent" | "Hook" | "DecisionHook" | "Subscription" | "EventScope" | "EventTrace" | "DispatchReport" -> {}
        else -> return None
    }
    symbol := ""
    mask := [Bool]{}
    if name == {
        "Event" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetEvent::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetEvent::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "emit" -> {
                    symbol = "jet_std::JetEvent::emit"
                    mask = [Bool]{true, false}
                }
                "listener_count" | "trace" -> {
                    symbol = "jet_std::JetEvent::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "AsyncEvent" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetAsyncEvent::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetAsyncEvent::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "emit_async" -> {
                    symbol = if carrier == {
                        .Result(_, _) -> "jet_std::JetAsyncEvent::emit_async_result"
                        .Infallible | .Optional(_) | .Diverges(_) -> "jet_std::JetAsyncEvent::emit_async"
                    }
                    mask = [Bool]{true, false}
                }
                "close" | "listener_count" | "queued_count" | "running_count" | "blocked_count" -> {
                    symbol = "jet_std::JetAsyncEvent::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "Hook" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetHook::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetHook::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "run" -> {
                    symbol = "jet_std::JetHook::run"
                    mask = [Bool]{true, false, false}
                }
                "listener_count" | "trace" -> {
                    symbol = "jet_std::JetHook::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "DecisionHook" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetDecisionHook::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetDecisionHook::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "run" -> {
                    symbol = "jet_std::JetDecisionHook::run"
                    mask = [Bool]{true, false}
                }
                "listener_count" -> {
                    symbol = "jet_std::JetDecisionHook::listener_count"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "Subscription" -> {
            if method == {
                "unsubscribe" -> {
                    symbol = "jet_std::JetSubscription::unsubscribe"
                    mask = [Bool]{true}
                }
                "is_active" -> {
                    symbol = "jet_std::JetSubscription::active"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "EventScope" -> {
            if method == {
                "cancel" -> {
                    symbol = "jet_std::JetEventScope::cancel"
                    mask = [Bool]{true}
                }
                "active_count" -> {
                    symbol = "jet_std::JetEventScope::active_count"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "EventTrace" -> {
            if method == {
                "summary" | "delivered" | "queued" | "dropped" -> {
                    symbol = "jet_std::JetEventTrace::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "DispatchReport" -> {
            if method == {
                "state" | "accepted" | "failures" | "trace" -> {
                    symbol = "jet_std::JetDispatchReport::{method}"
                    mask = [Bool]{true}
                }
                "delivered_handlers" -> {
                    symbol = "jet_std::JetDispatchReport::delivered_handlers"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        else -> return None
    }
    Val(ir_handle_route(true, "core.event", method, symbol, mask, None))
}

ir_handle_dynamic_route: fn(operation: BodyHandleOp, receiver: Type, argument_count: Int, carrier: TFailureCarrier) -> IRHandleRoute? {
    if operation == {
        .MathMethod(type_name, method) -> {
            // Sema (Calls/Geometry.jet sema_call_try_geometry) checked the
            // Transform method's name and arity; the receiver is the one
            // borrowed argument.
            mask := [Bool]{true}
            loop _ in 0..<argument_count -> mask.push(false)
            return Val(ir_handle_route(false, "core.math", "geometry.{type_name}.{method}", "jet_math_{type_name}_{method}", mask, None))
        }
        .EventMethod(method) -> return ir_handle_event_route(receiver, method, carrier)
        .ProcessSpecMethod(method, declared_count) -> {
            if declared_count != argument_count -> return None
            if method == {
                "cwd" -> return Val(ir_handle_h("process.spec.cwd", "jet_process_spec_cwd", [Bool]{false, true}, None))
                "arg" -> return Val(ir_handle_h("process.spec.arg", "jet_process_spec_arg", [Bool]{false, true}, None))
                "args_extend" -> return Val(ir_handle_h("process.spec.args_extend", "jet_process_spec_args_extend", [Bool]{false, true}, None))
                "env" -> return Val(ir_handle_h("process.spec.env", "jet_process_spec_env", [Bool]{false, true, true}, None))
                "env_remove" -> return Val(ir_handle_h("process.spec.env_remove", "jet_process_spec_env_remove", [Bool]{false, true}, None))
                "env_clear" -> return Val(ir_handle_h("process.spec.env_clear", "jet_process_spec_env_clear", [Bool]{false}, None))
                "stdin" -> return Val(ir_handle_h("process.spec.stdin", "jet_process_spec_stdin", [Bool]{false, true}, None))
                "stdout" -> return Val(ir_handle_h("process.spec.stdout", "jet_process_spec_stdout", [Bool]{false, true}, None))
                "stderr" -> return Val(ir_handle_h("process.spec.stderr", "jet_process_spec_stderr", [Bool]{false, true}, None))
                "timeout" -> return Val(ir_handle_h("process.spec.timeout", "jet_process_spec_timeout", [Bool]{false, true}, None))
                "output_limit" -> return Val(ir_handle_h("process.spec.output_limit", "jet_process_spec_output_limit", [Bool]{false, false}, None))
                "cpu_time_limit" -> return Val(ir_handle_h("process.spec.cpu_time_limit", "jet_process_spec_cpu_time_limit", [Bool]{false, true}, None))
                "memory_limit" -> return Val(ir_handle_h("process.spec.memory_limit", "jet_process_spec_memory_limit", [Bool]{false, false}, None))
                "memory_scope" -> return Val(ir_handle_h("process.spec.memory_scope", "jet_process_spec_memory_scope", [Bool]{false, false}, None))
                "open_file_limit" -> return Val(ir_handle_h("process.spec.open_file_limit", "jet_process_spec_open_file_limit", [Bool]{false, false}, None))
                "cpu_affinity" -> return Val(ir_handle_h("process.spec.cpu_affinity", "jet_process_spec_cpu_affinity", [Bool]{false, true}, None))
                "io_priority" -> return Val(ir_handle_h("process.spec.io_priority", "jet_process_spec_io_priority", [Bool]{false, false}, None))
                "io_idle" -> return Val(ir_handle_h("process.spec.io_idle", "jet_process_spec_io_idle", [Bool]{false}, None))
                "detached" -> return Val(ir_handle_h("process.spec.detached", "jet_process_spec_detached", [Bool]{false}, None))
                "terminal" -> {
                    if argument_count == 0 {
                        return Val(ir_handle_h("process.spec.terminal", "jet_process_spec_terminal", [Bool]{false}, None))
                    }
                    if argument_count == 1 {
                        return Val(ir_handle_h("process.spec.terminal_with_policy", "jet_process_spec_terminal_with_policy", [Bool]{false, true}, None))
                    }
                    return None
                }
                "under" -> return Val(ir_handle_h("process.spec.under", "jet_std_process_spec_under", [Bool]{false, true}, None))
                "plan" -> return Val(ir_handle_h("process.spec.plan", "jet_process_spec_plan", [Bool]{true}, None))
                "run" -> return Val(ir_handle_h("process.spec.run", "jet_process_spec_run", [Bool]{true}, Val(Effect.Exec)))
                "run_checked" -> return Val(ir_handle_h("process.spec.run_checked", "jet_process_spec_run_checked", [Bool]{true}, Val(Effect.Exec)))
                "spawn" -> return Val(ir_handle_h("process.spec.spawn", "jet_process_spec_spawn", [Bool]{true}, Val(Effect.Exec)))
                else -> return None
            }
        }
        .HTTPServerMethod(kind, method) -> {
            if kind == "WsConn" {
                if method == {
                    "send_text" -> return Val(ir_handle_h("ws.send_text", "jet_ws_send_text", [Bool]{true, true}, Val(Effect.Net)))
                    "recv" -> return Val(ir_handle_h("ws.recv", "jet_ws_recv", [Bool]{true}, Val(Effect.Net)))
                    "send_bytes" -> return Val(ir_handle_h("ws.send_bytes", "jet_ws_send_binary", [Bool]{true, true}, Val(Effect.Net)))
                    "close" -> return Val(ir_handle_h("ws.close", "jet_ws_close", [Bool]{true, false, true}, Val(Effect.Net)))
                    else -> return None
                }
            }
            if kind == "WsMessage" {
                if method == {
                    "is_text" -> return Val(ir_handle_h("ws.message_is_text", "jet_ws_message_is_text", [Bool]{true}, None))
                    "is_binary" -> return Val(ir_handle_h("ws.message_is_binary", "jet_ws_message_is_binary", [Bool]{true}, None))
                    "is_close" -> return Val(ir_handle_h("ws.message_is_close", "jet_ws_message_is_close", [Bool]{true}, None))
                    "text" -> return Val(ir_handle_h("ws.message_text", "jet_ws_message_text", [Bool]{true}, None))
                    "bytes" -> return Val(ir_handle_h("ws.message_bytes", "jet_ws_message_bytes", [Bool]{true}, None))
                    else -> return None
                }
            }
            return None
        }
        .Hardware(_) | .DurationNew(_, _) | .FileReaderReadLine | .FileReaderRead(_) | .FileReaderSeek | .FileReaderPath | .MappedFileWindow | .MappedFileWindowLen | .MappedFileLines | .LinesIter | .MappedFileLen | .MappedFileIsEmpty | .FileWriterWriteLine | .FileWriterFlush | .FileWriterWriteAll | .FileWriterFsync | .FileWriterPath | .JSONLReaderNext | .JSONLWriterWrite | .JSONLWriterFlush | .JSONLWriterFinish | .DataStreamNext | .XMLReaderNext | .XMLWriterWrite | .XMLWriterFlush | .XMLWriterFinish | .StdinReadLine | .StdoutWrite | .StdoutWriteLine | .StdoutWriteBytes | .StdoutFlush | .StdoutIsTTY | .StderrWrite | .StderrWriteLine | .StderrWriteBytes | .StderrFlush | .StderrIsTTY | .WorldNow | .WorldAdvance | .WorldWaitIdle | .WorldHistory | .RealtimeNextDeadline | .RealtimeReceipt | .RealtimeCancel | .RealtimeIsCancelled | .GameSceneNew | .GameReplayRecord | .GameBackendHeadless | .GameBackendShouldContinue | .GameBackendPresent | .GameSceneOnFrame(_, _) | .GameSceneComponent | .GameSceneQuery | .GameAssetsImage | .GameAssetsSound | .GameInputBind | .GameInputPressed | .RNGInt | .RNGFloat | .RNGFloatRange | .RNGBool | .RNGBoolP | .RNGNormal | .RNGExponential | .RNGBytes | .RNGSplit | .RNGPick | .RNGWeightedPick | .RNGSample | .RNGShuffle | .DurationIn | .DurationIsZero | .DurationTotalSeconds | .DurationDifference | .TestSuiteRun | .TestSetting | .DurationAbs | .DurationNegated | .DurationSign | .DurationTotalIn | .DurationRound | .DurationNsValue | .DurationScale | .DurationDivide | .AllocAlloc | .AllocTryAlloc | .AllocReset | .PreciseMethod(_, _) | .TCPListenerAccept | .TCPListenerAcceptDeadline | .TCPListenerLocalAddr | .TCPStreamRead | .TCPStreamPeerAddr | .TCPStreamLocalAddr | .TCPStreamClose | .TCPStreamReadBytes(_) | .TCPStreamReadBytesDeadline(_) | .TCPStreamReadText | .TCPStreamReadTextDeadline | .TCPStreamWriteBytes | .TCPStreamWriteBytesDeadline | .TCPStreamWriteAllBytes | .TCPStreamWriteAllBytesDeadline | .TCPStreamWriteText | .TCPStreamWriteTextDeadline | .TCPStreamShutdown | .TCPStreamReady | .UDPSocketReady | .UDPSocketClose | .UDPSocketReceiveDeadline | .UDPSocketSendToDeadline | .UnixListenerAcceptDeadline | .UnixStreamReadDeadline(_) | .UnixStreamWriteAllDeadline | .UnixStreamReady | .UnixStreamClose | .UnixStreamSetTimeout | .HTTPClientNew | .ArgsSpecFlag | .ArgsSpecFlagShort | .ArgsSpecOption | .ArgsSpecOptionShort | .ArgsSpecOptionDefault | .ArgsSpecOptionEnv | .ArgsSpecOptionInt | .ArgsSpecOptionFloat | .ArgsSpecOptionChoice | .ArgsSpecRepeat | .ArgsSpecRequiredOption | .ArgsSpecPositional | .ArgsSpecDescription | .ArgsSpecSubcommand | .ArgsSpecVersion | .ArgsSpecCompletion | .ArgsSpecHelp | .ArgsSpecParse | .ArgsSpecParseOrExit | .ParsedArgsFlag | .ParsedArgsOption | .ParsedArgsOptionInt | .ParsedArgsOptionFloat | .ParsedArgsOptions | .ParsedArgsSubcommand | .ParsedArgsPositional | .TerminalSessionResize | .ProcessStdinWrite | .ProcessStdinWriteText | .ProcessStdinClose | .ProcessStdinWriteAll | .ProcessStdoutRead | .ProcessStderrRead | .ReflectValueRead(_) | .ReflectValueFields | .ReflectFieldName | .ReflectFieldValue | .TaskJoin | .TaskDetach | .TaskPause | .TaskResume | .TaskCancel | .ChannelReceive | .ChannelTryReceive | .ChannelIsTimer | .ChannelIsInterval | .ChannelIsCancelled | .ChannelIsReady | .ChannelDelayMs | .ChannelClose | .SenderSend | .ReactiveGet | .ReactiveSet | .ReactiveEffectMethod | .LayoutMethod(_) | .HTTPClientMethod(_, _) | .DynField | .DynAt | .DynInt | .DynText | .DynBool | .DynFloat | .DynToText | .DynEqualUnordered | .DynDecode(_, _) | .DynIndexKey(_, _) | .DynIndexAt(_, _) | .DynGetKey | .DynGetAt | .DynHas | .DynKeys | .DynLen(_, _) | .DynRemove | .DynBinary(_, _, _) | .DynCompare(_, _, _) | .DynSetPath(_, _, _) | .SerdeEncode(_) | .JSONField | .JSONAt | .JSONInt | .JSONText | .JSONBool | .JSONFloat | .JSONToText | .JSONEqualUnordered | .PathFrom | .PathHome | .PathJoin | .PathParent | .PathExtension | .PathStem | .PathNormalize | .PathIsWithin | .PathToString | .PathWalk | .PluginInvoke(_, _) | .ReaderOver(_) | .ReaderReadU8 | .ReaderReadI8 | .ReaderReadU16Le | .ReaderReadU16Be | .ReaderReadI16Le | .ReaderReadI16Be | .ReaderReadU32Le | .ReaderReadU32Be | .ReaderReadI32Le | .ReaderReadI32Be | .ReaderReadU64Le | .ReaderReadU64Be | .ReaderReadI64Le | .ReaderReadI64Be | .ReaderReadF32Le | .ReaderReadF32Be | .ReaderReadF64Le | .ReaderReadF64Be | .ReaderPeek | .ReaderSeek | .ReaderSkip | .ReaderTake | .ReaderRemaining | .ReaderAtEnd | .CursorOver | .CursorTakeUntil | .CursorSkipWs | .CursorTakePattern(_, _) | .ReaderTakePattern(_, _) | .ProcessLines -> None
    }
}

ir_general_handle_route: fn(operation: BodyHandleOp, receiver: Type, argument_count: Int, carrier: TFailureCarrier) -> IRHandleRoute? {
    dynamic := ir_handle_dynamic_route(operation, receiver, argument_count, carrier)
    if dynamic != None -> return dynamic
    if operation == {
        .DurationNew(unit, is_float) -> {
            symbol := if is_float -> "jet_duration_from_float" else -> "jet_duration_from_int"
            return Val(ir_handle_core("core.time", "duration_new", symbol, [Bool]{false, false}, None))
        }
        .FileReaderReadLine -> return Val(ir_handle_h("file_reader.read_line", "jet_std_file_reader_read_line", [Bool]{true}, Val(Effect.FS)))
        .FileReaderRead(into) -> return Val(if into -> ir_handle_h("file_reader.read_into", "jet_std_file_reader_read_into", [Bool]{true, true, false}, Val(Effect.FS)) else -> ir_handle_h("file_reader.read", "jet_std_file_reader_read", [Bool]{true, false}, Val(Effect.FS)))
        .FileReaderSeek -> return Val(ir_handle_h("file_reader.seek", "jet_std_file_reader_seek", [Bool]{true, false}, Val(Effect.FS)))
        .FileReaderPath -> return Val(ir_handle_h("file_reader.path", "jet_std_file_reader_path", [Bool]{true}, None))
        .MappedFileWindow -> return Val(ir_handle_h("mapped_file.window", "jet_std_fs_map_window_view", [Bool]{true, true, true}, Val(Effect.FS)))
        .MappedFileWindowLen -> return Val(ir_handle_h("mapped_file.window_len", "jet_std_fs_map_window_len_view", [Bool]{true, true, true}, Val(Effect.FS)))
        .MappedFileLen -> return Val(ir_handle_h("mapped_file.len", "jet_std_fs_map_len", [Bool]{true}, None))
        .MappedFileIsEmpty -> return Val(ir_handle_h("mapped_file.is_empty", "jet_std_fs_map_is_empty", [Bool]{true}, None))
        .FileWriterWriteLine -> return Val(ir_handle_h("file_writer.write_line", "jet_std_file_writer_write_line", [Bool]{true, true}, Val(Effect.FS)))
        .FileWriterFlush -> return Val(ir_handle_h("file_writer.flush", "jet_std_file_writer_flush", [Bool]{true}, Val(Effect.FS)))
        .FileWriterWriteAll -> return Val(ir_handle_h("file_writer.write_all", "jet_std_file_writer_write_all", [Bool]{true, true}, Val(Effect.FS)))
        .FileWriterFsync -> return Val(ir_handle_h("file_writer.fsync", "jet_std_file_writer_fsync", [Bool]{true}, Val(Effect.FS)))
        .FileWriterPath -> return Val(ir_handle_h("file_writer.path", "jet_std_file_writer_path", [Bool]{true}, None))
        .JSONLReaderNext -> return Val(ir_handle_h("jsonl_reader.next", "jet_enc_jsonl_reader_next", [Bool]{true}, Val(Effect.IO)))
        .JSONLWriterWrite -> return Val(ir_handle_h("jsonl_writer.write", "jet_enc_jsonl_writer_write", [Bool]{true, false}, Val(Effect.IO)))
        .JSONLWriterFlush -> return Val(ir_handle_h("jsonl_writer.flush", "jet_enc_jsonl_writer_flush", [Bool]{true}, Val(Effect.IO)))
        .JSONLWriterFinish -> return Val(ir_handle_h("jsonl_writer.finish", "jet_enc_jsonl_writer_finish", [Bool]{true}, Val(Effect.IO)))
        .DataStreamNext -> return Val(ir_handle_h("data_stream.next", "jet_data_stream_next", [Bool]{true}, Val(Effect.IO)))
        .XMLReaderNext -> return Val(ir_handle_h("xml_reader.next", "jet_enc_xml_reader_next", [Bool]{true}, Val(Effect.IO)))
        .XMLWriterWrite -> return Val(ir_handle_h("xml_writer.write", "jet_enc_xml_writer_write", [Bool]{true, false}, Val(Effect.IO)))
        .XMLWriterFlush -> return Val(ir_handle_h("xml_writer.flush", "jet_enc_xml_writer_flush", [Bool]{true}, Val(Effect.IO)))
        .XMLWriterFinish -> return Val(ir_handle_h("xml_writer.finish", "jet_enc_xml_writer_finish", [Bool]{true}, Val(Effect.IO)))
        .StdinReadLine -> return Val(ir_handle_h("stdin.read_line", "jet_std_io_stdin_read_line", [Bool]{true}, Val(Effect.IO)))
        .StdoutWrite -> return Val(ir_handle_h("stdout.write", "jet_std_io_stdout_write", [Bool]{true, true}, Val(Effect.IO)))
        .StdoutWriteLine -> return Val(ir_handle_h("stdout.write_line", "jet_std_io_stdout_write_line", [Bool]{true, true}, Val(Effect.IO)))
        .StdoutWriteBytes -> return Val(ir_handle_h("stdout.write_bytes", "jet_std_io_stdout_write_bytes", [Bool]{true, true}, Val(Effect.IO)))
        .StdoutFlush -> return Val(ir_handle_h("stdout.flush", "jet_std_io_stdout_flush", [Bool]{true}, Val(Effect.IO)))
        .StdoutIsTTY -> return Val(ir_handle_h("stdout.is_tty", "jet_std_io_stdout_is_tty", [Bool]{true}, Val(Effect.IO)))
        .StderrWrite -> return Val(ir_handle_h("stderr.write", "jet_std_io_stderr_write", [Bool]{true, true}, Val(Effect.IO)))
        .StderrWriteLine -> return Val(ir_handle_h("stderr.write_line", "jet_std_io_stderr_write_line", [Bool]{true, true}, Val(Effect.IO)))
        .StderrWriteBytes -> return Val(ir_handle_h("stderr.write_bytes", "jet_std_io_stderr_write_bytes", [Bool]{true, true}, Val(Effect.IO)))
        .StderrFlush -> return Val(ir_handle_h("stderr.flush", "jet_std_io_stderr_flush", [Bool]{true}, Val(Effect.IO)))
        .StderrIsTTY -> return Val(ir_handle_h("stderr.is_tty", "jet_std_io_stderr_is_tty", [Bool]{true}, Val(Effect.IO)))
        .TestSuiteRun -> return Val(ir_handle_h("test_suite.run", "jet_test_suite_run", [Bool]{true}, None))
        .TestSetting -> return Val(ir_handle_h("test_suite.setting", "jet_test_setting", [Bool]{true, true, true}, None))
        .WorldNow -> return Val(ir_handle_h("deterministic_world.now", "jet_world_now", [Bool]{true}, Val(Effect.Time)))
        .WorldAdvance -> return Val(ir_handle_h("deterministic_world.advance", "jet_world_advance", [Bool]{true, true}, Val(Effect.Time)))
        .WorldWaitIdle -> return Val(ir_handle_h("deterministic_world.wait_idle", "jet_world_wait_idle", [Bool]{true}, Val(Effect.Time)))
        .WorldHistory -> return Val(ir_handle_h("deterministic_world.history", "jet_world_history", [Bool]{true}, None))
        .RealtimeNextDeadline -> return Val(ir_handle_h("realtime.next_deadline", "jet_rt_next_deadline", [Bool]{true}, None))
        .RealtimeReceipt -> return Val(ir_handle_h("realtime.receipt", "jet_rt_receipt", [Bool]{true}, None))
        .RealtimeCancel -> return Val(ir_handle_h("realtime.cancel", "jet_rt_cancel", [Bool]{false}, Val(Effect.Time)))
        .RealtimeIsCancelled -> return Val(ir_handle_h("realtime.is_cancelled", "jet_rt_is_cancelled", [Bool]{true}, None))
        .RNGInt -> return Val(ir_handle_h("rng.int", "jet_rng_int", [Bool]{true, false, false}, Val(Effect.Rand)))
        .RNGFloat -> return Val(ir_handle_h("rng.float", "jet_rng_float", [Bool]{true}, Val(Effect.Rand)))
        .RNGFloatRange -> return Val(ir_handle_h("rng.float_range", "jet_rng_float_range", [Bool]{true, false, false}, Val(Effect.Rand)))
