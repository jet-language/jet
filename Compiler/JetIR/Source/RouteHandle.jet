        .StderrIsTTY -> return Val(ir_handle_h("stderr.is_tty", "jet_std_io_stderr_is_tty", [Bool]{true}, Val(Effect.IO)))
        .TestSuiteRun -> return Val(ir_handle_h("test_suite.run", "jet_test_suite_run", [Bool]{true}, None))
