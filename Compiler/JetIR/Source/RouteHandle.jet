        .HistoryRNGBelow -> return Val(ir_handle_h("history_rng.below", "jet_testing_history_rng_below", [Bool]{true, false}, Val(Effect.Rand)))
        .GameSceneNew -> return Val(ir_handle_h("game.scene_new", "jet_game_scene_new", [Bool]{true}, None))
        .GameReplayRecord -> return Val(ir_handle_h("game.replay_record", "jet_game_replay_record", [Bool]{true}, None))
