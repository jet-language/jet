// Closed Prelude routing and ordinary IR lowering for checked BodyHandleOp nodes.
// Special expression families stay with their structural IR builders.
use jet_foundation.[
    BodyHandleOp,
    Type,
]

// A checked handle operation's runtime export and the borrow mask of its
// operands.
IRHandleRoute: struct {
    symbol: String,
    borrow_mask: [Bool],
}

ir_handle_h: fn(symbol: String, borrow_mask: [Bool]) -> IRHandleRoute Never! {
    IRHandleRoute{symbol: symbol, borrow_mask: borrow_mask}
}

ir_handle_type_without_tags: fn(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) | .InlineRange(inner, _, _) -> return ir_handle_type_without_tags(inner)
        // copy: the untagged type is a new owned Type. Otherwise it equals `ty`, the caller's
        // checked type (a read parameter), which stays on its node.
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return ty.copy()
    }
}

ir_general_handle_route: fn(operation: BodyHandleOp, receiver: Type) -> IRHandleRoute? {
    if operation == {
        .DurationNew(unit, is_float) -> {
            symbol := if is_float -> "jet_duration_from_float" else -> "jet_duration_from_int"
            return Val(ir_handle_h(symbol, [Bool]{false, false}))
        }
        .FileReaderReadLine -> return Val(ir_handle_h("jet_std_file_reader_read_line", [Bool]{true}))
        .FileReaderRead(into) -> return Val(if into -> ir_handle_h("jet_std_file_reader_read_into", [Bool]{true, true, false}) else -> ir_handle_h("jet_std_file_reader_read", [Bool]{true, false}))
        .FileReaderSeek -> return Val(ir_handle_h("jet_std_file_reader_seek", [Bool]{true, false}))
        .FileReaderPath -> return Val(ir_handle_h("jet_std_file_reader_path", [Bool]{true}))
        .MappedFileWindow -> return Val(ir_handle_h("jet_std_fs_map_window_view", [Bool]{true, true, true}))
        .MappedFileWindowLen -> return Val(ir_handle_h("jet_std_fs_map_window_len_view", [Bool]{true, true, true}))
        .MappedFileLen -> return Val(ir_handle_h("jet_std_fs_map_len", [Bool]{true}))
        .MappedFileIsEmpty -> return Val(ir_handle_h("jet_std_fs_map_is_empty", [Bool]{true}))
        .FileWriterWriteLine -> return Val(ir_handle_h("jet_std_file_writer_write_line", [Bool]{true, true}))
        .FileWriterFlush -> return Val(ir_handle_h("jet_std_file_writer_flush", [Bool]{true}))
        .FileWriterWriteAll -> return Val(ir_handle_h("jet_std_file_writer_write_all", [Bool]{true, true}))
        .FileWriterFsync -> return Val(ir_handle_h("jet_std_file_writer_fsync", [Bool]{true}))
        .FileWriterPath -> return Val(ir_handle_h("jet_std_file_writer_path", [Bool]{true}))
        .JSONLReaderNext -> return Val(ir_handle_h("jet_enc_jsonl_reader_next", [Bool]{true}))
        .JSONLWriterWrite -> return Val(ir_handle_h("jet_enc_jsonl_writer_write", [Bool]{true, false}))
        .JSONLWriterFlush -> return Val(ir_handle_h("jet_enc_jsonl_writer_flush", [Bool]{true}))
        .JSONLWriterFinish -> return Val(ir_handle_h("jet_enc_jsonl_writer_finish", [Bool]{true}))
        .DataStreamNext -> return Val(ir_handle_h("jet_data_stream_next", [Bool]{true}))
        .XMLReaderNext -> return Val(ir_handle_h("jet_enc_xml_reader_next", [Bool]{true}))
        .XMLWriterWrite -> return Val(ir_handle_h("jet_enc_xml_writer_write", [Bool]{true, false}))
        .XMLWriterFlush -> return Val(ir_handle_h("jet_enc_xml_writer_flush", [Bool]{true}))
        .XMLWriterFinish -> return Val(ir_handle_h("jet_enc_xml_writer_finish", [Bool]{true}))
        .StdinReadLine -> return Val(ir_handle_h("jet_std_io_stdin_read_line", [Bool]{true}))
        .StdoutWrite -> return Val(ir_handle_h("jet_std_io_stdout_write", [Bool]{true, true}))
        .StdoutWriteLine -> return Val(ir_handle_h("jet_std_io_stdout_write_line", [Bool]{true, true}))
        .StdoutWriteBytes -> return Val(ir_handle_h("jet_std_io_stdout_write_bytes", [Bool]{true, true}))
        .StdoutFlush -> return Val(ir_handle_h("jet_std_io_stdout_flush", [Bool]{true}))
        .StdoutIsTTY -> return Val(ir_handle_h("jet_std_io_stdout_is_tty", [Bool]{true}))
        .StderrWrite -> return Val(ir_handle_h("jet_std_io_stderr_write", [Bool]{true, true}))
        .StderrWriteLine -> return Val(ir_handle_h("jet_std_io_stderr_write_line", [Bool]{true, true}))
        .StderrWriteBytes -> return Val(ir_handle_h("jet_std_io_stderr_write_bytes", [Bool]{true, true}))
        .StderrFlush -> return Val(ir_handle_h("jet_std_io_stderr_flush", [Bool]{true}))
        .StderrIsTTY -> return Val(ir_handle_h("jet_std_io_stderr_is_tty", [Bool]{true}))
        .TestSuiteRun -> return Val(ir_handle_h("jet_test_suite_run", [Bool]{true}))
        .TestSetting -> return Val(ir_handle_h("jet_test_setting", [Bool]{true, true, true}))
        .RealtimeNextDeadline -> return Val(ir_handle_h("jet_rt_next_deadline", [Bool]{true}))
        .RealtimeReceipt -> return Val(ir_handle_h("jet_rt_receipt", [Bool]{true}))
        .RealtimeCancel -> return Val(ir_handle_h("jet_rt_cancel", [Bool]{false}))
        .RealtimeIsCanceled -> return Val(ir_handle_h("jet_rt_is_canceled", [Bool]{true}))
        .GameSceneNew -> return Val(ir_handle_h("jet_game_scene_new", [Bool]{true}))
        .GameReplayRecord -> return Val(ir_handle_h("jet_game_replay_record", [Bool]{true}))
        .GameBackendHeadless -> return Val(ir_handle_h("jet_game_backend_headless", [Bool]{}))
        .GameBackendShouldContinue -> return Val(ir_handle_h("jet_game_backend_should_continue", [Bool]{true}))
        .GameBackendPresent -> return Val(ir_handle_h("jet_game_backend_present", [Bool]{true}))
        .GameSceneOnFrame(_, _) -> return Val(ir_handle_h("jet_game_scene_on_frame", [Bool]{true, false, false, false}))
        .GameSceneComponent -> return Val(ir_handle_h("jet_game_scene_component", [Bool]{true, true}))
        .GameSceneQuery -> return Val(ir_handle_h("jet_game_scene_query", [Bool]{true, true}))
        .GameAssetsImage -> return Val(ir_handle_h("jet_game_assets_image", [Bool]{true, true}))
        .GameAssetsSound -> return Val(ir_handle_h("jet_game_assets_sound", [Bool]{true, true}))
        .GameInputBind -> return Val(ir_handle_h("jet_game_input_bind", [Bool]{true, true, true}))
        .GameInputPressed -> return Val(ir_handle_h("jet_game_input_pressed", [Bool]{true, true}))
        .DurationIn -> return Val(ir_handle_h("jet_duration_in", [Bool]{true, true}))
        .DurationIsZero -> return Val(ir_handle_h("jet_duration_is_zero", [Bool]{true}))
        .DurationTotalSeconds -> return Val(ir_handle_h("jet_duration_total_seconds", [Bool]{true}))
        .DurationDifference -> return Val(ir_handle_h("jet_duration_difference", [Bool]{true, true}))
        .DurationAbs -> return Val(ir_handle_h("jet_duration_abs", [Bool]{true}))
        .DurationNegated -> return Val(ir_handle_h("jet_duration_negated", [Bool]{true}))
        .DurationSign -> return Val(ir_handle_h("jet_duration_sign", [Bool]{true}))
        .DurationTotalIn -> return Val(ir_handle_h("jet_duration_total_in", [Bool]{true, true}))
        .DurationRound -> return Val(ir_handle_h("jet_duration_round", [Bool]{true, true, true, true}))
        .DurationScale -> return Val(ir_handle_h("jet_duration_scale", [Bool]{true, true}))
        .DurationDivide -> return Val(ir_handle_h("jet_duration_divide", [Bool]{true, true}))
        .TerminalSessionResize -> return Val(ir_handle_h("jet_terminal_session_resize", [Bool]{true, true}))
        .ProcessStdinWrite -> return Val(ir_handle_h("jet_process_stdin_write", [Bool]{true, true}))
        .ProcessStdinWriteText -> return Val(ir_handle_h("jet_process_stdin_write_text", [Bool]{true, true}))
        .ProcessStdinClose -> return Val(ir_handle_h("jet_process_stdin_close", [Bool]{true}))
        .ProcessStdinWriteAll -> return Val(ir_handle_h("jet_process_stdin_write_all", [Bool]{true, true}))
        .ProcessStdoutRead -> return Val(ir_handle_h("jet_process_stdout_read", [Bool]{true, false}))
        .ProcessStderrRead -> return Val(ir_handle_h("jet_process_stderr_read", [Bool]{true, false}))
        .PathFrom -> return Val(ir_handle_h("jet_path_from", [Bool]{true}))
        .PathToString -> return Val(ir_handle_h("jet_path_to_string", [Bool]{true}))
        .PathHome -> return Val(ir_handle_h("jet_path_home", [Bool]{}))
        .PathJoin -> return Val(ir_handle_h("jet_path_join", [Bool]{true, true}))
        .PathParent -> return Val(ir_handle_h("jet_path_parent", [Bool]{true}))
        .PathExtension -> return Val(ir_handle_h("jet_path_extension", [Bool]{true}))
        .PathStem -> return Val(ir_handle_h("jet_path_stem", [Bool]{true}))
        .PathNormalize -> return Val(ir_handle_h("jet_path_normalize", [Bool]{true}))
        .PathIsWithin -> return Val(ir_handle_h("jet_path_is_within", [Bool]{true, true}))
        .PathWalk -> return Val(ir_handle_h("jet_path_walk", [Bool]{true}))
        .ReaderOver(owned) -> {
            symbol := if owned -> "jet_reader_over_owned" else -> "jet_reader_over"
            mask := if owned -> [Bool]{false, false} else -> [Bool]{true, false}
            return Val(ir_handle_h(symbol, mask))
        }
        .ReaderReadU8 -> return Val(ir_handle_h("jet_reader_read_u8", [Bool]{true}))
        .ReaderReadI8 -> return Val(ir_handle_h("jet_reader_read_i8", [Bool]{true}))
        .ReaderReadU16Le -> return Val(ir_handle_h("jet_reader_read_u16_le", [Bool]{true}))
        .ReaderReadU16Be -> return Val(ir_handle_h("jet_reader_read_u16_be", [Bool]{true}))
        .ReaderReadI16Le -> return Val(ir_handle_h("jet_reader_read_i16_le", [Bool]{true}))
        .ReaderReadI16Be -> return Val(ir_handle_h("jet_reader_read_i16_be", [Bool]{true}))
        .ReaderReadU32Le -> return Val(ir_handle_h("jet_reader_read_u32_le", [Bool]{true}))
        .ReaderReadU32Be -> return Val(ir_handle_h("jet_reader_read_u32_be", [Bool]{true}))
        .ReaderReadI32Le -> return Val(ir_handle_h("jet_reader_read_i32_le", [Bool]{true}))
        .ReaderReadI32Be -> return Val(ir_handle_h("jet_reader_read_i32_be", [Bool]{true}))
        .ReaderReadU64Le -> return Val(ir_handle_h("jet_reader_read_u64_le", [Bool]{true}))
        .ReaderReadU64Be -> return Val(ir_handle_h("jet_reader_read_u64_be", [Bool]{true}))
        .ReaderReadI64Le -> return Val(ir_handle_h("jet_reader_read_i64_le", [Bool]{true}))
        .ReaderReadI64Be -> return Val(ir_handle_h("jet_reader_read_i64_be", [Bool]{true}))
        .ReaderReadF32Le -> return Val(ir_handle_h("jet_reader_read_f32_le", [Bool]{true}))
        .ReaderReadF32Be -> return Val(ir_handle_h("jet_reader_read_f32_be", [Bool]{true}))
        .ReaderReadF64Le -> return Val(ir_handle_h("jet_reader_read_f64_le", [Bool]{true}))
        .ReaderReadF64Be -> return Val(ir_handle_h("jet_reader_read_f64_be", [Bool]{true}))
        .ReaderPeek -> return Val(ir_handle_h("jet_reader_peek", [Bool]{true}))
        .ReaderSeek -> return Val(ir_handle_h("jet_reader_seek", [Bool]{true, false}))
        .ReaderSkip -> return Val(ir_handle_h("jet_reader_skip", [Bool]{true, false}))
        .ReaderTake -> return Val(ir_handle_h("jet_reader_take", [Bool]{true, false, false}))
        .ReaderRemaining -> return Val(ir_handle_h("jet_reader_remaining", [Bool]{true}))
        .ReaderAtEnd -> return Val(ir_handle_h("jet_reader_at_end", [Bool]{true}))
        .CursorOver -> return Val(ir_handle_h("jet_cursor_over", [Bool]{true}))
        .CursorTakeUntil -> return Val(ir_handle_h("jet_cursor_take_until", [Bool]{true, true}))
        .CursorSkipWs -> return Val(ir_handle_h("jet_cursor_skip_ws", [Bool]{true}))
        .ReflectValueRead(symbol) -> return Val(ir_handle_h(symbol, [Bool]{true}))
        .ReflectValueFields -> return Val(ir_handle_h("jet_jit_reflect_fields", [Bool]{true}))
        .ReflectFieldName -> return Val(ir_handle_h("jet_jit_reflect_field_name", [Bool]{true}))
        .ReflectFieldValue -> return Val(ir_handle_h("jet_jit_reflect_field_value", [Bool]{true}))
        .DynField | .DynAt | .DynInt | .DynText | .DynBool | .DynFloat | .DynToText | .DynEqualUnordered | .DynDecode(_, _) | .SerdeEncode(_) | .JSONField | .JSONAt | .JSONInt | .JSONText | .JSONBool | .JSONFloat | .JSONToText | .JSONEqualUnordered | .ReaderTakePattern(_, _) | .CursorTakePattern(_, _) | .ReactiveGet | .ReactiveSet | .ReactiveEffectMethod | .Hardware(_) | .ProcessLines -> return None
        // ir_handle_method lowers task control (ir_task_detach,
        // ir_task_control) and every channel endpoint method
        // (ir_channel_method) before it asks for a route.
        .TaskDetach | .TaskPause | .TaskResume | .TaskCancel | .ChannelReceive | .ChannelTryReceive | .ChannelIsTimer | .ChannelIsInterval | .ChannelIsCanceled | .ChannelIsReady | .ChannelDelayMs | .SenderSend | .ChannelClose -> return None
        .MappedFileLines | .LinesIter | .DurationNsValue | .AllocAlloc | .AllocTryAlloc | .AllocReset | .PreciseMethod(_, _) | .TaskJoin | .EventMethod(_) | .LayoutMethod(_) | .DynIndexKey(_, _) | .DynIndexAt(_, _) | .DynGetKey | .DynGetAt | .DynHas | .DynKeys | .DynLen(_, _) | .DynRemove | .DynBinary(_, _, _) | .DynCompare(_, _, _) | .DynSetPath(_, _, _) | .PluginInvoke(_, _) -> return None
    }
}
