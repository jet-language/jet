// Closed Prelude routing and ordinary IR lowering for checked BodyHandleOp nodes.
// Special expression families stay with their structural IR builders.
use jet_foundation.[
    TFailureCarrier,
    BodyHandleOp,
    Type,
    type_name,
]

// A checked handle operation's runtime export and the borrow mask of its
// operands; `closure_method` marks the event routes, whose handler argument
// crosses as a retained closure box.
IRHandleRoute: struct {
    closure_method: Bool,
    symbol: String,
    borrow_mask: [Bool],
}

ir_handle_h: fn(symbol: String, borrow_mask: [Bool]) -> IRHandleRoute Never! {
    IRHandleRoute{closure_method: false, symbol: symbol, borrow_mask: borrow_mask}
}

ir_handle_type_without_tags: fn(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) | .InlineRange(inner, _, _) -> return ir_handle_type_without_tags(inner)
        // copy: the untagged type is a new owned Type. Otherwise it equals `ty`, the caller's
        // checked type (a read parameter), which stays on its node.
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return ty.copy()
    }
}

ir_handle_nominal_name: fn(ty: Type) -> String Never! {
    if ir_handle_type_without_tags(ty) == {
        .Named(name) | .Apply(name, _) -> return name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> panic("checked route requires a nominal receiver type")
    }
}

ir_handle_event_route: fn(receiver: Type, method: String, carrier: TFailureCarrier) -> IRHandleRoute? {
    name := ir_handle_nominal_name(receiver)
    if name == {
        "Event" | "AsyncEvent" | "Hook" | "DecisionHook" | "Subscription" | "EventScope" | "EventTrace" | "DispatchReport" -> {}
        else -> return None
    }
    symbol := ""
    mask := [Bool]{}
    if name == {
        "Event" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetEvent::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetEvent::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "emit" -> {
                    symbol = "jet_std::JetEvent::emit"
                    mask = [Bool]{true, false}
                }
                "listener_count" | "trace" -> {
                    symbol = "jet_std::JetEvent::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "AsyncEvent" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetAsyncEvent::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetAsyncEvent::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "emit_async" -> {
                    symbol = if carrier == {
                        .Result(_, _) -> "jet_std::JetAsyncEvent::emit_async_result"
                        .Infallible | .Optional(_) | .Diverges(_) -> "jet_std::JetAsyncEvent::emit_async"
                    }
                    mask = [Bool]{true, false}
                }
                "close" | "listener_count" | "queued_count" | "running_count" | "blocked_count" -> {
                    symbol = "jet_std::JetAsyncEvent::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "Hook" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetHook::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetHook::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "run" -> {
                    symbol = "jet_std::JetHook::run"
                    mask = [Bool]{true, false, false}
                }
                "listener_count" | "trace" -> {
                    symbol = "jet_std::JetHook::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "DecisionHook" -> {
            if method == {
                "on" | "once" -> {
                    symbol = "jet_std::JetDecisionHook::{method}"
                    mask = [Bool]{true, true, false}
                }
                "on_priority" -> {
                    symbol = "jet_std::JetDecisionHook::on_priority"
                    mask = [Bool]{true, true, false, false}
                }
                "run" -> {
                    symbol = "jet_std::JetDecisionHook::run"
                    mask = [Bool]{true, false}
                }
                "listener_count" -> {
                    symbol = "jet_std::JetDecisionHook::listener_count"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "Subscription" -> {
            if method == {
                "unsubscribe" -> {
                    symbol = "jet_std::JetSubscription::unsubscribe"
                    mask = [Bool]{true}
                }
                "is_active" -> {
                    symbol = "jet_std::JetSubscription::active"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "EventScope" -> {
            if method == {
                "cancel" -> {
                    symbol = "jet_std::JetEventScope::cancel"
                    mask = [Bool]{true}
                }
                "active_count" -> {
                    symbol = "jet_std::JetEventScope::active_count"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "EventTrace" -> {
            if method == {
                "summary" | "delivered" | "queued" | "dropped" -> {
                    symbol = "jet_std::JetEventTrace::{method}"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        "DispatchReport" -> {
            if method == {
                "state" | "accepted" | "failures" | "trace" -> {
                    symbol = "jet_std::JetDispatchReport::{method}"
                    mask = [Bool]{true}
                }
                "delivered_handlers" -> {
                    symbol = "jet_std::JetDispatchReport::delivered_handlers"
                    mask = [Bool]{true}
                }
                else -> return None
            }
        }
        else -> return None
    }
    Val(IRHandleRoute{closure_method: true, symbol: symbol, borrow_mask: mask})
}

ir_handle_dynamic_route: fn(operation: BodyHandleOp, receiver: Type, argument_count: Int, carrier: TFailureCarrier) -> IRHandleRoute? {
    if operation == {
        .MathMethod(type_name, method) -> {
            // Sema (Calls/Geometry.jet sema_call_try_geometry) checked the
            // Transform method's name and arity; the receiver is the one
            // borrowed argument.
            mask := [Bool]{true}
            loop _ in 0..<argument_count -> mask.push(false)
            return Val(ir_handle_h("jet_math_{type_name}_{method}", mask))
        }
        .EventMethod(method) -> return ir_handle_event_route(receiver, method, carrier)
        .ProcessSpecMethod(method, declared_count) -> {
            if declared_count != argument_count -> return None
            if method == {
                "cwd" -> return Val(ir_handle_h("jet_process_spec_cwd", [Bool]{false, true}))
                "arg" -> return Val(ir_handle_h("jet_process_spec_arg", [Bool]{false, true}))
                "args_extend" -> return Val(ir_handle_h("jet_process_spec_args_extend", [Bool]{false, true}))
                "env" -> return Val(ir_handle_h("jet_process_spec_env", [Bool]{false, true, true}))
                "env_remove" -> return Val(ir_handle_h("jet_process_spec_env_remove", [Bool]{false, true}))
                "env_clear" -> return Val(ir_handle_h("jet_process_spec_env_clear", [Bool]{false}))
                "stdin" -> return Val(ir_handle_h("jet_process_spec_stdin", [Bool]{false, true}))
                "stdout" -> return Val(ir_handle_h("jet_process_spec_stdout", [Bool]{false, true}))
                "stderr" -> return Val(ir_handle_h("jet_process_spec_stderr", [Bool]{false, true}))
                "timeout" -> return Val(ir_handle_h("jet_process_spec_timeout", [Bool]{false, true}))
                "output_limit" -> return Val(ir_handle_h("jet_process_spec_output_limit", [Bool]{false, false}))
                "cpu_time_limit" -> return Val(ir_handle_h("jet_process_spec_cpu_time_limit", [Bool]{false, true}))
                "memory_limit" -> return Val(ir_handle_h("jet_process_spec_memory_limit", [Bool]{false, false}))
                "memory_scope" -> return Val(ir_handle_h("jet_process_spec_memory_scope", [Bool]{false, false}))
                "open_file_limit" -> return Val(ir_handle_h("jet_process_spec_open_file_limit", [Bool]{false, false}))
                "cpu_affinity" -> return Val(ir_handle_h("jet_process_spec_cpu_affinity", [Bool]{false, true}))
                "io_priority" -> return Val(ir_handle_h("jet_process_spec_io_priority", [Bool]{false, false}))
                "io_idle" -> return Val(ir_handle_h("jet_process_spec_io_idle", [Bool]{false}))
                "detached" -> return Val(ir_handle_h("jet_process_spec_detached", [Bool]{false}))
                "terminal" -> {
                    if argument_count == 0 {
                        return Val(ir_handle_h("jet_process_spec_terminal", [Bool]{false}))
                    }
                    if argument_count == 1 {
                        return Val(ir_handle_h("jet_process_spec_terminal_with_policy", [Bool]{false, true}))
                    }
                    return None
                }
                "under" -> return Val(ir_handle_h("jet_std_process_spec_under", [Bool]{false, true}))
                "plan" -> return Val(ir_handle_h("jet_process_spec_plan", [Bool]{true}))
                "run" -> return Val(ir_handle_h("jet_process_spec_run", [Bool]{true}))
                "run_checked" -> return Val(ir_handle_h("jet_process_spec_run_checked", [Bool]{true}))
                "spawn" -> return Val(ir_handle_h("jet_process_spec_spawn", [Bool]{true}))
                else -> return None
            }
        }
        .HTTPServerMethod(kind, method) -> {
            if kind == "WsConn" {
                if method == {
                    "send_text" -> return Val(ir_handle_h("jet_ws_send_text", [Bool]{true, true}))
                    "recv" -> return Val(ir_handle_h("jet_ws_recv", [Bool]{true}))
                    "send_bytes" -> return Val(ir_handle_h("jet_ws_send_binary", [Bool]{true, true}))
                    "close" -> return Val(ir_handle_h("jet_ws_close", [Bool]{true, false, true}))
                    else -> return None
                }
            }
            if kind == "WsMessage" {
                if method == {
                    "is_text" -> return Val(ir_handle_h("jet_ws_message_is_text", [Bool]{true}))
                    "is_binary" -> return Val(ir_handle_h("jet_ws_message_is_binary", [Bool]{true}))
                    "is_close" -> return Val(ir_handle_h("jet_ws_message_is_close", [Bool]{true}))
                    "text" -> return Val(ir_handle_h("jet_ws_message_text", [Bool]{true}))
                    "bytes" -> return Val(ir_handle_h("jet_ws_message_bytes", [Bool]{true}))
                    else -> return None
                }
            }
            return None
        }
        .Hardware(_) | .DurationNew(_, _) | .FileReaderReadLine | .FileReaderRead(_) | .FileReaderSeek | .FileReaderPath | .MappedFileWindow | .MappedFileWindowLen | .MappedFileLines | .LinesIter | .MappedFileLen | .MappedFileIsEmpty | .FileWriterWriteLine | .FileWriterFlush | .FileWriterWriteAll | .FileWriterFsync | .FileWriterPath | .JSONLReaderNext | .JSONLWriterWrite | .JSONLWriterFlush | .JSONLWriterFinish | .DataStreamNext | .XMLReaderNext | .XMLWriterWrite | .XMLWriterFlush | .XMLWriterFinish | .StdinReadLine | .StdoutWrite | .StdoutWriteLine | .StdoutWriteBytes | .StdoutFlush | .StdoutIsTTY | .StderrWrite | .StderrWriteLine | .StderrWriteBytes | .StderrFlush | .StderrIsTTY | .WorldNow | .WorldAdvance | .WorldWaitIdle | .WorldHistory | .RealtimeNextDeadline | .RealtimeReceipt | .RealtimeCancel | .RealtimeIsCancelled | .GameSceneNew | .GameReplayRecord | .GameBackendHeadless | .GameBackendShouldContinue | .GameBackendPresent | .GameSceneOnFrame(_, _) | .GameSceneComponent | .GameSceneQuery | .GameAssetsImage | .GameAssetsSound | .GameInputBind | .GameInputPressed | .RNGInt | .RNGFloat | .RNGFloatRange | .RNGBool | .RNGBoolP | .RNGNormal | .RNGExponential | .RNGBytes | .RNGSplit | .RNGPick | .RNGWeightedPick | .RNGSample | .RNGShuffle | .DurationIn | .DurationIsZero | .DurationTotalSeconds | .DurationDifference | .TestSuiteRun | .TestSetting | .DurationAbs | .DurationNegated | .DurationSign | .DurationTotalIn | .DurationRound | .DurationNsValue | .DurationScale | .DurationDivide | .AllocAlloc | .AllocTryAlloc | .AllocReset | .PreciseMethod(_, _) | .TCPListenerAccept | .TCPListenerAcceptDeadline | .TCPListenerLocalAddr | .TCPStreamRead | .TCPStreamPeerAddr | .TCPStreamLocalAddr | .TCPStreamClose | .TCPStreamReadBytes(_) | .TCPStreamReadBytesDeadline(_) | .TCPStreamReadText | .TCPStreamReadTextDeadline | .TCPStreamWriteBytes | .TCPStreamWriteBytesDeadline | .TCPStreamWriteAllBytes | .TCPStreamWriteAllBytesDeadline | .TCPStreamWriteText | .TCPStreamWriteTextDeadline | .TCPStreamShutdown | .TCPStreamReady | .UDPSocketReady | .UDPSocketClose | .UDPSocketReceiveDeadline | .UDPSocketSendToDeadline | .UnixListenerAcceptDeadline | .UnixStreamReadDeadline(_) | .UnixStreamWriteAllDeadline | .UnixStreamReady | .UnixStreamClose | .UnixStreamSetTimeout | .HTTPClientNew | .ArgsSpecFlag | .ArgsSpecFlagShort | .ArgsSpecOption | .ArgsSpecOptionShort | .ArgsSpecOptionDefault | .ArgsSpecOptionEnv | .ArgsSpecOptionInt | .ArgsSpecOptionFloat | .ArgsSpecOptionChoice | .ArgsSpecRepeat | .ArgsSpecRequiredOption | .ArgsSpecPositional | .ArgsSpecDescription | .ArgsSpecSubcommand | .ArgsSpecVersion | .ArgsSpecCompletion | .ArgsSpecHelp | .ArgsSpecParse | .ArgsSpecParseOrExit | .ParsedArgsFlag | .ParsedArgsOption | .ParsedArgsOptionInt | .ParsedArgsOptionFloat | .ParsedArgsOptions | .ParsedArgsSubcommand | .ParsedArgsPositional | .TerminalSessionResize | .ProcessStdinWrite | .ProcessStdinWriteText | .ProcessStdinClose | .ProcessStdinWriteAll | .ProcessStdoutRead | .ProcessStderrRead | .ReflectValueRead(_) | .ReflectValueFields | .ReflectFieldName | .ReflectFieldValue | .TaskJoin | .TaskDetach | .TaskPause | .TaskResume | .TaskCancel | .ChannelReceive | .ChannelTryReceive | .ChannelIsTimer | .ChannelIsInterval | .ChannelIsCancelled | .ChannelIsReady | .ChannelDelayMs | .ChannelClose | .SenderSend | .ReactiveGet | .ReactiveSet | .ReactiveEffectMethod | .LayoutMethod(_) | .HTTPClientMethod(_, _) | .DynField | .DynAt | .DynInt | .DynText | .DynBool | .DynFloat | .DynToText | .DynEqualUnordered | .DynDecode(_, _) | .DynIndexKey(_, _) | .DynIndexAt(_, _) | .DynGetKey | .DynGetAt | .DynHas | .DynKeys | .DynLen(_, _) | .DynRemove | .DynBinary(_, _, _) | .DynCompare(_, _, _) | .DynSetPath(_, _, _) | .SerdeEncode(_) | .JSONField | .JSONAt | .JSONInt | .JSONText | .JSONBool | .JSONFloat | .JSONToText | .JSONEqualUnordered | .PathFrom | .PathHome | .PathJoin | .PathParent | .PathExtension | .PathStem | .PathNormalize | .PathIsWithin | .PathToString | .PathWalk | .PluginInvoke(_, _) | .ReaderOver(_) | .ReaderReadU8 | .ReaderReadI8 | .ReaderReadU16Le | .ReaderReadU16Be | .ReaderReadI16Le | .ReaderReadI16Be | .ReaderReadU32Le | .ReaderReadU32Be | .ReaderReadI32Le | .ReaderReadI32Be | .ReaderReadU64Le | .ReaderReadU64Be | .ReaderReadI64Le | .ReaderReadI64Be | .ReaderReadF32Le | .ReaderReadF32Be | .ReaderReadF64Le | .ReaderReadF64Be | .ReaderPeek | .ReaderSeek | .ReaderSkip | .ReaderTake | .ReaderRemaining | .ReaderAtEnd | .CursorOver | .CursorTakeUntil | .CursorSkipWs | .CursorTakePattern(_, _) | .ReaderTakePattern(_, _) | .ProcessLines -> None
    }
}

ir_general_handle_route: fn(operation: BodyHandleOp, receiver: Type, argument_count: Int, carrier: TFailureCarrier) -> IRHandleRoute? {
    dynamic := ir_handle_dynamic_route(operation, receiver, argument_count, carrier)
    if dynamic != None -> return dynamic
    if operation == {
        .DurationNew(unit, is_float) -> {
            symbol := if is_float -> "jet_duration_from_float" else -> "jet_duration_from_int"
            return Val(ir_handle_h(symbol, [Bool]{false, false}))
        }
        .FileReaderReadLine -> return Val(ir_handle_h("jet_std_file_reader_read_line", [Bool]{true}))
        .FileReaderRead(into) -> return Val(if into -> ir_handle_h("jet_std_file_reader_read_into", [Bool]{true, true, false}) else -> ir_handle_h("jet_std_file_reader_read", [Bool]{true, false}))
        .FileReaderSeek -> return Val(ir_handle_h("jet_std_file_reader_seek", [Bool]{true, false}))
        .FileReaderPath -> return Val(ir_handle_h("jet_std_file_reader_path", [Bool]{true}))
        .MappedFileWindow -> return Val(ir_handle_h("jet_std_fs_map_window_view", [Bool]{true, true, true}))
        .MappedFileWindowLen -> return Val(ir_handle_h("jet_std_fs_map_window_len_view", [Bool]{true, true, true}))
        .MappedFileLen -> return Val(ir_handle_h("jet_std_fs_map_len", [Bool]{true}))
        .MappedFileIsEmpty -> return Val(ir_handle_h("jet_std_fs_map_is_empty", [Bool]{true}))
        .FileWriterWriteLine -> return Val(ir_handle_h("jet_std_file_writer_write_line", [Bool]{true, true}))
        .FileWriterFlush -> return Val(ir_handle_h("jet_std_file_writer_flush", [Bool]{true}))
        .FileWriterWriteAll -> return Val(ir_handle_h("jet_std_file_writer_write_all", [Bool]{true, true}))
        .FileWriterFsync -> return Val(ir_handle_h("jet_std_file_writer_fsync", [Bool]{true}))
        .FileWriterPath -> return Val(ir_handle_h("jet_std_file_writer_path", [Bool]{true}))
        .JSONLReaderNext -> return Val(ir_handle_h("jet_enc_jsonl_reader_next", [Bool]{true}))
        .JSONLWriterWrite -> return Val(ir_handle_h("jet_enc_jsonl_writer_write", [Bool]{true, false}))
        .JSONLWriterFlush -> return Val(ir_handle_h("jet_enc_jsonl_writer_flush", [Bool]{true}))
        .JSONLWriterFinish -> return Val(ir_handle_h("jet_enc_jsonl_writer_finish", [Bool]{true}))
        .DataStreamNext -> return Val(ir_handle_h("jet_data_stream_next", [Bool]{true}))
        .XMLReaderNext -> return Val(ir_handle_h("jet_enc_xml_reader_next", [Bool]{true}))
        .XMLWriterWrite -> return Val(ir_handle_h("jet_enc_xml_writer_write", [Bool]{true, false}))
        .XMLWriterFlush -> return Val(ir_handle_h("jet_enc_xml_writer_flush", [Bool]{true}))
        .XMLWriterFinish -> return Val(ir_handle_h("jet_enc_xml_writer_finish", [Bool]{true}))
        .StdinReadLine -> return Val(ir_handle_h("jet_std_io_stdin_read_line", [Bool]{true}))
        .StdoutWrite -> return Val(ir_handle_h("jet_std_io_stdout_write", [Bool]{true, true}))
        .StdoutWriteLine -> return Val(ir_handle_h("jet_std_io_stdout_write_line", [Bool]{true, true}))
        .StdoutWriteBytes -> return Val(ir_handle_h("jet_std_io_stdout_write_bytes", [Bool]{true, true}))
        .StdoutFlush -> return Val(ir_handle_h("jet_std_io_stdout_flush", [Bool]{true}))
        .StdoutIsTTY -> return Val(ir_handle_h("jet_std_io_stdout_is_tty", [Bool]{true}))
        .StderrWrite -> return Val(ir_handle_h("jet_std_io_stderr_write", [Bool]{true, true}))
        .StderrWriteLine -> return Val(ir_handle_h("jet_std_io_stderr_write_line", [Bool]{true, true}))
        .StderrWriteBytes -> return Val(ir_handle_h("jet_std_io_stderr_write_bytes", [Bool]{true, true}))
        .StderrFlush -> return Val(ir_handle_h("jet_std_io_stderr_flush", [Bool]{true}))
        .StderrIsTTY -> return Val(ir_handle_h("jet_std_io_stderr_is_tty", [Bool]{true}))
        .TestSuiteRun -> return Val(ir_handle_h("jet_test_suite_run", [Bool]{true}))
        .TestSetting -> return Val(ir_handle_h("jet_test_setting", [Bool]{true, true, true}))
        .WorldNow -> return Val(ir_handle_h("jet_world_now", [Bool]{true}))
        .WorldAdvance -> return Val(ir_handle_h("jet_world_advance", [Bool]{true, true}))
        .WorldWaitIdle -> return Val(ir_handle_h("jet_world_wait_idle", [Bool]{true}))
        .WorldHistory -> return Val(ir_handle_h("jet_world_history", [Bool]{true}))
        .RealtimeNextDeadline -> return Val(ir_handle_h("jet_rt_next_deadline", [Bool]{true}))
        .RealtimeReceipt -> return Val(ir_handle_h("jet_rt_receipt", [Bool]{true}))
        .RealtimeCancel -> return Val(ir_handle_h("jet_rt_cancel", [Bool]{false}))
        .RealtimeIsCancelled -> return Val(ir_handle_h("jet_rt_is_cancelled", [Bool]{true}))
        .RNGInt -> return Val(ir_handle_h("jet_rng_int", [Bool]{true, false, false}))
        .RNGFloat -> return Val(ir_handle_h("jet_rng_float", [Bool]{true}))
        .RNGFloatRange -> return Val(ir_handle_h("jet_rng_float_range", [Bool]{true, false, false}))
        .RNGBool -> return Val(ir_handle_h("jet_rng_bool", [Bool]{true}))
        .RNGBoolP -> return Val(ir_handle_h("jet_rng_bool_p", [Bool]{true, false}))
        .RNGNormal -> return Val(ir_handle_h("jet_rng_normal", [Bool]{true, false, false}))
        .RNGExponential -> return Val(ir_handle_h("jet_rng_exponential", [Bool]{true, false}))
        .RNGBytes -> return Val(ir_handle_h("jet_rng_bytes", [Bool]{true, false}))
        .RNGSplit -> return Val(ir_handle_h("jet_rng_split", [Bool]{true}))
        .RNGPick -> return Val(ir_handle_h("jet_rng_pick", [Bool]{true, true}))
        .RNGWeightedPick -> return Val(ir_handle_h("jet_rng_weighted_pick", [Bool]{true, true, true}))
        .RNGSample -> return Val(ir_handle_h("jet_rng_sample", [Bool]{true, true, false}))
        .RNGShuffle -> return Val(ir_handle_h("jet_rng_shuffle", [Bool]{true, true}))
        .GameSceneNew -> return Val(ir_handle_h("jet_game_scene_new", [Bool]{true}))
        .GameReplayRecord -> return Val(ir_handle_h("jet_game_replay_record", [Bool]{true}))
        .GameBackendHeadless -> return Val(ir_handle_h("jet_game_backend_headless", [Bool]{}))
        .GameBackendShouldContinue -> return Val(ir_handle_h("jet_game_backend_should_continue", [Bool]{true}))
        .GameBackendPresent -> return Val(ir_handle_h("jet_game_backend_present", [Bool]{true}))
        .GameSceneOnFrame(_, _) -> return Val(ir_handle_h("jet_game_scene_on_frame", [Bool]{true, false, false, false}))
        .GameSceneComponent -> return Val(ir_handle_h("jet_game_scene_component", [Bool]{true, true}))
        .GameSceneQuery -> return Val(ir_handle_h("jet_game_scene_query", [Bool]{true, true}))
        .GameAssetsImage -> return Val(ir_handle_h("jet_game_assets_image", [Bool]{true, true}))
        .GameAssetsSound -> return Val(ir_handle_h("jet_game_assets_sound", [Bool]{true, true}))
        .GameInputBind -> return Val(ir_handle_h("jet_game_input_bind", [Bool]{true, true, true}))
        .GameInputPressed -> return Val(ir_handle_h("jet_game_input_pressed", [Bool]{true, true}))
        .DurationIn -> return Val(ir_handle_h("jet_duration_in", [Bool]{true, true}))
        .DurationIsZero -> return Val(ir_handle_h("jet_duration_is_zero", [Bool]{true}))
        .DurationTotalSeconds -> return Val(ir_handle_h("jet_duration_total_seconds", [Bool]{true}))
        .DurationDifference -> return Val(ir_handle_h("jet_duration_difference", [Bool]{true, true}))
        .DurationAbs -> return Val(ir_handle_h("jet_duration_abs", [Bool]{true}))
        .DurationNegated -> return Val(ir_handle_h("jet_duration_negated", [Bool]{true}))
        .DurationSign -> return Val(ir_handle_h("jet_duration_sign", [Bool]{true}))
        .DurationTotalIn -> return Val(ir_handle_h("jet_duration_total_in", [Bool]{true, true}))
        .DurationRound -> return Val(ir_handle_h("jet_duration_round", [Bool]{true, true, true, true}))
        .DurationScale -> return Val(ir_handle_h("jet_duration_scale", [Bool]{true, true}))
        .DurationDivide -> return Val(ir_handle_h("jet_duration_divide", [Bool]{true, true}))
        .TCPListenerAccept -> return Val(ir_handle_h("jet_net_tcp_accept", [Bool]{true}))
        .TCPListenerAcceptDeadline -> return Val(ir_handle_h("jet_net_tcp_accept_deadline", [Bool]{true, true}))
        .TCPListenerLocalAddr -> return Val(ir_handle_h("jet_net_listener_local_addr", [Bool]{true}))
        .TCPStreamRead -> return Val(ir_handle_h("jet_net_tcp_read", [Bool]{true}))
        .TCPStreamPeerAddr -> return Val(ir_handle_h("jet_net_tcp_peer_addr", [Bool]{true}))
        .TCPStreamLocalAddr -> return Val(ir_handle_h("jet_net_tcp_local_addr", [Bool]{true}))
