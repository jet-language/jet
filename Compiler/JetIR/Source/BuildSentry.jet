use jet_foundation.[TUnsafeGate]

// ---------------------------------------------------------------------------
// The memory sentry (JetRuntime Sentry.jet) under a program or test image
// (IRProgram.sentries). An `#Unsafe` block enters a sentry gate naming its
// file, line and audit text, saved in a stack area the block's exits restore
// (ir_tx_leave_scopes). A function that takes raw addresses opens a sentry
// stack frame, and each `*x` / `mem.address_of(place)` registers the
// storage it names in it, so a pointer that outlives the frame faults. A
// raw read or a volatile access is checked against the gate in force (a
// caller's, inside an `#Unsafe` function) and stops the run on a fault;
// outside an enabled gate the check passes.
//
// A dev build keeps the sentry at every optimization level. A release
// build keeps it only when it is hardened (`policy.harden` or the
// `hardened` profile, IRChecks.harden); an ordinary release build emits no
// sentry call and turns the runtime's allocator sentry off at its start
// (ir_sentry_release_link).

// Whether a program or test image built under `checks` keeps the sentry.
ir_checks_sentries: fn(checks: IRChecks) -> Bool Never! {
    !checks.release || checks.harden
}

// The first step of an image without the sentry: the runtime's allocators
// stop registering, quarantining and poisoning storage for it
// (jet_rt_sentry_set_release).
ir_sentry_release_link: fn(m: &IRModule, p: IRProgram, b: &IRBuilder) Never! {
    if p.sentries -> return
    on: ir_word_const(m, b, 1)
    _: ir_runtime(m, b, "jet_rt_sentry_set_release", [Int]{on}, -1)
}

// `#Unsafe("audit") { body }`: the body runs under its gate.
ir_unsafe_scope: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, gate: TUnsafeGate, body: [Int]) Never! {
    if !p.sentries {
        ir_stmts(m, p, b, body)
        return
    }
    save: ir_sentry_save(m, b)
    file: ir_static_text(m, b, gate.file)
    reason: ir_static_text(m, b, gate.reason)
    enabled: ir_word_const(m, b, if gate.enabled -> 1 else -> 0)
    fenced: ir_word_const(m, b, if gate.fenced -> 1 else -> 0)
    line: ir_word_const(m, b, gate.line)
    _: ir_runtime(m, b, "jet_rt_sentry_scope_enter", [Int]{save, enabled, fenced, file[0], file[1], line, reason[0], reason[1]}, -1)
    ir_sentry_body(m, p, b, save, body)
}

// `#Policy(sentries: …) { body }`: the body runs with the gate's checks on
// or off.
ir_sentry_policy: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, enabled: Bool, body: [Int]) Never! {
    if !p.sentries {
        ir_stmts(m, p, b, body)
        return
    }
    save: ir_sentry_save(m, b)
    flag: ir_word_const(m, b, if enabled -> 1 else -> 0)
    _: ir_runtime(m, b, "jet_rt_sentry_policy_enter", [Int]{save, flag}, -1)
    ir_sentry_body(m, p, b, save, body)
}

// The stack save area of the gate a scope replaces: seven words.
ir_sentry_save: fn(m: &IRModule, b: &IRBuilder) -> Int Never! {
    pointer_row: ir_pointer_row(m)
    save: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.StackAddress, save, 56, 8, -1, b.line)
    save
}

// A gate's body as its own scope: its bindings drop before the replaced
// gate comes back, and an early exit restores it (IRTxFrame.sentry).
ir_sentry_body: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, save: Int, body: [Int]) Never! {
    b.transactions.push(IRTxFrame{handle: -1, stm: -1, snapshots: [IRTxSnapshot]{}, loops: b.loops.len(), shield: false, deadline: -1, sentry: save})
    ir_scope_open(b)
    ir_stmts(m, p, b, body)
    if ir_failed(b) -> return
    ir_scope_close(m, b)
    _: b.transactions.pop()
    _: ir_runtime(m, b, "jet_rt_sentry_scope_leave", [Int]{save}, -1)
}

// On entry to a function that takes raw addresses: its sentry stack frame,
// left by every return and stop edge (IRTxFrame.sentry_frame).
ir_sentry_frame: fn(m: &IRModule, p: IRProgram, b: &IRBuilder) Never! {
    if !p.sentries || b.row < 0 -> return
    if !ir_nodes_take_raw_addresses(p.functions[b.row].tree.nodes) -> return
    word_row: ir_word_row(m)
    frame: ir_runtime(m, b, "jet_rt_sentry_frame_enter", [Int]{}, word_row)
    b.transactions.push(IRTxFrame{handle: -1, stm: -1, snapshots: [IRTxSnapshot]{}, loops: 0, shield: false, deadline: -1, sentry_frame: frame})
}

ir_nodes_take_raw_addresses: fn(nodes: [BodyNode]) -> Bool Never! {
    loop node in nodes {
        if node.kind == .RawOf(_) || node.kind == .RawAddressOf(_) -> return true
    }
    false
}

// The storage of row `row` at `address` (a local's, a place's) joins the
// current sentry stack frame until it leaves.
ir_sentry_register: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, address: Int, row: Int) Never! {
    if !p.sentries -> return
    bytes: m.types[row].size
    size: ir_word_const(m, b, bytes)
    _: ir_runtime(m, b, "jet_rt_sentry_register_stack_allocation", [Int]{address, size}, -1)
}

// The address a raw access of row `row` at `pointer` uses: the sentry
// checks it first and stops on a fault, reporting `operation` ("": a plain
// `read`).
ir_sentry_access: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, pointer: Int, row: Int, operation: String) -> Int Never! {
    if !p.sentries || m.types[row].kind == .Unit -> return pointer
    bytes: m.types[row].size
    alignment: m.types[row].align
    size: ir_word_const(m, b, bytes)
    align: ir_word_const(m, b, alignment)
    pointer_row: ir_pointer_row(m)
    if operation == "" -> return ir_runtime(m, b, "jet_rt_sentry_read", [Int]{pointer, size, align}, pointer_row)
    name: ir_static_text(m, b, operation)
    ir_runtime(m, b, "jet_rt_sentry_access", [Int]{pointer, size, align, name[0], name[1]}, pointer_row)
}

// The word address of a raw access of `bytes` bytes (a word above zero) at
// `pointer`, aligned as row `row`: the sentry checks the whole range first
// and stops on a fault, reporting `operation`.
ir_sentry_range: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, pointer: Int, bytes: Int, row: Int, operation: String) -> Int Never! {
    word_row: ir_word_row(m)
    address: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, address, pointer, -1, -1, b.line)
    if !p.sentries -> return address
    alignment: m.types[row].align
    align: ir_word_const(m, b, alignment)
    name: ir_static_text(m, b, operation)
    ir_runtime(m, b, "jet_rt_sentry_access", [Int]{address, bytes, align, name[0], name[1]}, word_row)
}

// `core.mem.volatile_read<T>(pointer)` / `core.mem.volatile_write<T>(pointer,
// value)`: one load or store of T at the pointer, checked under the
// operation's own name. The written value moves into the pointee.
ir_core_volatile: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, member: String, args: [Int], type_args: [Type], span: Span) -> Int Never! {
    writes: member == "volatile_write"
    arity: if writes -> 2 else -> 1
    if type_args.len() != 1 || args.len() != arity -> return ir_fail_slot(b, span, "core.mem.{member} without its checked element type and arguments")
    element_ty: type_args[0].copy()
    row: ir_value_type(m, p, element_ty) ?? return ir_type_fail(b, span, element_ty)
    pointer: ir_expr(m, p, b, args[0])
    if ir_failed(b) || pointer < 0 -> return -1
    if !writes {
        address: ir_sentry_access(m, p, b, pointer, row, member)
        return ir_load_at(m, b, address, 0, row)
    }
    value := ir_expr(m, p, b, args[1])
    if ir_failed(b) -> return -1
    address: ir_sentry_access(m, p, b, pointer, row, member)
    drops: m.types[row].drop != ""
    if value >= 0 && drops && !b.fresh[value] -> value = ir_clone(m, b, value, row)
    ir_store_at(m, p, b, address, 0, value)
    return -1
}

// `core.mem.copy<T>(to, from, count)` / `core.mem.fill<T>(to, value,
// count)`: the `count` Ts at `to` become the `count` at `from`, as one move
// of their bytes, so the two ranges may overlap (jet_rt_mem_move), or copies
// of `value`. Nothing runs on the Ts a copy duplicates or either overwrites.
// A count of zero or less touches nothing. Under the sentry each whole range
// is checked first under the operation's name, so a range that runs past
// live storage stops before any byte moves.
ir_core_mem_block: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, member: String, args: [Int], type_args: [Type], span: Span) -> Int Never! {
    if type_args.len() != 1 || args.len() != 3 -> return ir_fail_slot(b, span, "core.mem.{member} without its checked element type and arguments")
    element_ty: type_args[0].copy()
    row: ir_value_type(m, p, element_ty) ?? return ir_type_fail(b, span, element_ty)
    target: ir_expr(m, p, b, args[0])
    if ir_failed(b) || target < 0 -> return -1
    second: ir_expr(m, p, b, args[1])
    if ir_failed(b) || second < 0 -> return -1
    counted: ir_expr(m, p, b, args[2])
    if ir_failed(b) || counted < 0 -> return -1
    count: ir_native_index(m, b, counted, span)
    if ir_failed(b) -> return -1
    ir_release(m, b, counted)
    stride: ir_list_stride(m, row)
    copies: member == "copy"
    if stride > 0 {
        zero: ir_word_const(m, b, 0)
        any: ir_bool_op(m, b, IROp.Lt, zero, count)
        ir_open_if(b.f, any, b.line)
        width: ir_word_const(m, b, stride)
        total: ir_word_op(m, b, IROp.Mul, count, width)
        to: ir_sentry_range(m, p, b, target, total, row, member)
        if copies {
            from: ir_sentry_range(m, p, b, second, total, row, member)
            _: ir_runtime(m, b, "jet_rt_mem_move", [Int]{to, from, total}, -1)
        } else {
            ir_core_mem_fill(m, p, b, to, second, row, count, total)
        }
        ir_end(b.f, b.line)
    }
    if !copies -> ir_release(m, b, second)
    return -1
}

// A fill's stores at the word address `to`: plain data (no drop, nothing
// ir_copy_needs) as one runtime fill of the value's bytes (JetRuntime
// Collections.jet jet_rt_mem_fill), any other value as a copy of it stored
// in each place.
ir_core_mem_fill: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, to: Int, value: Int, row: Int, count: Int, total: Int) Never! {
    stride: ir_list_stride(m, row)
    if !ir_copy_needs(m, p, row) && m.types[row].drop == "" {
        // An aggregate's slot is its storage already; any other value is
        // stored raw into a frame cell, which takes no ownership of it.
        aggregate: ir_kind_of(m, b, value) == .Aggregate
        source: if aggregate -> ir_address_at(m, b, value, 0) else -> ir_out_slot(m, b, (stride + 7) /% 8)
        if !aggregate -> ir_emit(b.f, IROp.Store, -1, source, 0, value, b.line)
        width: ir_word_const(m, b, stride)
        _: ir_runtime(m, b, "jet_rt_mem_fill", [Int]{to, source, width, total}, -1)
        return
    }
    index: ir_count_open(m, b, count)
    place: ir_element_address(m, b, to, index, stride)
    item: ir_clone(m, b, value, row)
    ir_store_at(m, p, b, place, 0, item)
    ir_count_close(m, b, index)
}
