// Simplify (O1, O2): per function, to a fixed point (at most
// IR_OPT_SIMPLIFY_ROUNDS rounds), each round one sweep of every rewrite and
// then compaction:
//   fold        constants of Int (inline range), fixed-width words (wrap or
//               no fold when it would trap), Bool and Char through + - *,
//               unary minus, `not` and comparisons (a value against itself
//               too, never Float); the identities x+0, 0+x, x-0, x*1, 1*x,
//               x|0, x^0, x<<0, x>>0, x/1, x&-1, x&x, x|x (a copy) and x*0,
//               0*x, x&0, x-x, x^x (zero); an If or BrIf on a constant keeps
//               only the arm it takes; the checked fixed-width conversion
//               (jet_int_checked_fixed) of an Int masked by a constant,
//               `x & c` with c >= 0 inside the kind, is a Move (an inline
//               Int is its i64 bits); `(x /% k) * k` with k = 2^j >= 2, of
//               an Int or a signed word, is `x & -k`
//   unreachable everything after a Br, Return or Unreachable up to the end
//               of its region
//   fuse        `t = a <cmp> b; n = not t` becomes `n = a <inverse> b` when t
//               has no other reader (never for Float: NaN compares false both
//               ways)
//   branch      a Bool from `&&` or `||` read only by the branch after it
//               becomes branches on its two operands (ir_opt_short_circuits)
//   common      `x = <op> a b` repeating an earlier `y = <op> a b` whose
//               value still holds is `x = move y`; no comparison or `not`,
//               which fuse into their branch (ir_opt_common)
//   propagate   a slot written once by a Move/Copy of a slot written once
//               reads its source directly
//   address     an address written once by `p = offset t k` folds into its
//               readers: an Offset, Load or Store through p adds k to its own
//               byte offset and reads t, a CopyBytes operand p with k = 0
//               reads t
//   coalesce    `t = <op>; ...; x = move/copy t` writes x directly when t is a
//               temporary read only there and nothing between touches x
//   dead        an instruction without effects whose result nobody reads (a
//               division or remainder by a positive constant among them);
//               the drop of an exact Int that holds an inline constant or a
//               value masked by a nonnegative constant
//   structure   a `br 0` that falls through anyway; empty Block, Loop and If;
//               a Block no Br targets
// The address sums below are no sweep of it: Opt.jet ir_opt_function moves
// them once per function, last (ir_opt_sink_addresses).

use {
    jet_backend.[X64_RDI, X64_RSI]
    jet_foundation.[Type, compiler_threads_single, name_rows_set, name_rows_value]
}

IR_OPT_SIMPLIFY_ROUNDS :: 8

fn ir_opt_simplify(m: IRModule, f: &IRFunction, report: &IROptReport) Never! {
    round := 0
    fixed :: name_rows_value(m.name_rows, "jet_int_checked_fixed") ?? -2
    loop round < IR_OPT_SIMPLIFY_ROUNDS {
        // The facts stay true until a sweep changes the function, so they
        // are computed again only after one does (most sweeps change
        // nothing, and the last round none).
        facts := ir_opt_facts(f)
        changed := ir_opt_fold(m, &f, facts, fixed, &report)
        changed += ir_opt_unreachable(&f, &report)
        if changed > 0 -> facts = ir_opt_facts(f)
        step := ir_opt_fuse_compares(m, &f, facts, &report)
        if step > 0 -> facts = ir_opt_facts(f)
        changed += step
        step = ir_opt_common(m, &f, facts)
        if step > 0 -> facts = ir_opt_facts(f)
        changed += step
        step = ir_opt_propagate(m, &f, facts, &report)
        if step > 0 -> facts = ir_opt_facts(f)
        changed += step
        step = ir_opt_addresses(&f, facts)
        if step > 0 -> facts = ir_opt_facts(f)
        changed += step
        step = ir_opt_coalesce(&f, facts, &report)
        if step > 0 -> facts = ir_opt_facts(f)
        changed += step
        changed += ir_opt_dead(m, &f, facts, &report)
        changed += ir_opt_structure(&f, &report)
        changed += ir_opt_unwrap(&f)
        ir_opt_compact(&f)
        changed += ir_opt_short_circuits(&f, &report)
        if changed == 0 -> break
        round += 1
    }
}

// The layout of `slot`'s type (kind, width, signedness; no type tree copy).
fn ir_opt_type(m: IRModule, f: IRFunction, slot: Int) -> IRX64Shape Never! {
    ir_x64_type(m, f, slot)
}

fn ir_opt_structural(op: IROp) -> Bool Never! {
    op == .Block || op == .Loop || op == .If || op == .Else || op == .End || op == .Br || op == .BrIf || op == .Return || op == .Unreachable
}

fn ir_opt_is_compare(op: IROp) -> Bool Never! {
    op == .Eq || op == .Ne || op == .Lt || op == .Le || op == .Gt || op == .Ge
}

fn ir_opt_inverse(op: IROp) -> IROp Never! {
    if op == {
        .Eq -> IROp.Ne
        .Ne -> IROp.Eq
        .Lt -> IROp.Ge
        .Le -> IROp.Gt
        .Gt -> IROp.Le
        else -> IROp.Lt
    }
}

// The matching End of every opener and the Else of every If (-1 when none),
// by instruction index, over the current (Nop-holding) instruction list.
struct OptNesting {
    end: [Int]
    els: [Int]
}

fn ir_opt_nesting(f: IRFunction) -> OptNesting Never! {
    end := [Int]{}
    els := [Int]{}
    loop _ in 0..<f.op.len() {
        &end.push(-1)
        &els.push(-1)
    }
    open := [Int]{}
    loop at in 0..<f.op.len() {
        if f.op[at] == {
            .Block | .Loop | .If -> &open.push(at)
            .Else -> els[open[open.len() - 1]] = at
            .End -> {
                opener :: &open.pop() ?? panic("ir_opt_nesting: End without an open construct")
                end[opener] = at
            }
            else -> {}
        }
    }
    OptNesting{end: end, els: els}
}

// ---------------------------------------------------------------------------
// Constant folding.

// `value` as a word of `ty`, or None when it is out of range and `trap`
// (the operation stops at run time), or when it would be an unsigned 64-bit
// carrier above the signed range (left to selection).
fn ir_opt_word(ty: IRX64Shape, value: Int, trap: Bool) -> Int? Never! {
    bits :: if ty.bits > 0 && ty.bits < 64 -> ty.bits else -> 64
    lo :: if ty.signed -> 0 - (1 << (bits - 1)) else -> 0
    hi :: if ty.signed || bits == 64 -> (1 << (bits - 1)) - 1 else -> (1 << bits) - 1
    if value >= lo && value <= hi -> return Val(value)
    if trap -> return None
    span :: 1 << bits
    wrapped := value % span
    if wrapped < 0 -> wrapped += span
    if ty.signed && wrapped > hi -> wrapped -= span
    if wrapped < lo || wrapped > hi -> return None
    Val(wrapped)
}

// The folded value of `op` over constants of `ty`, or None.
fn ir_opt_fold_value(ty: IRX64Shape, op: IROp, left: Int, right: Int, trap: Bool) -> Int? Never! {
    if ir_opt_is_compare(op) {
        if ty.kind != .Int && ty.kind != .Word && ty.kind != .Bool && ty.kind != .Char -> return None
        // An unsigned 64-bit word constant above the signed range is not folded.
        if ty.kind == .Word && !ty.signed && (left < 0 || right < 0) -> return None
        holds :: if op == {
            .Eq -> left == right
            .Ne -> left != right
            .Lt -> left < right
            .Le -> left <= right
            .Gt -> left > right
            else -> left >= right
        }
        return Val(if holds -> 1 else -> 0)
    }
    if ty.kind != .Int && ty.kind != .Word -> return None
    exact :: if op == {
        .Add -> left + right
        .Sub -> left - right
        else -> left * right
    }
    if ty.kind == .Int {
        if ir_int_inline(exact) -> return Val(exact)
        return None
    }
    ir_opt_word(ty, exact, trap)
}

fn ir_opt_set_const(f: &IRFunction, at: Int, value: Int) Never! {
    f.op[at] = .Const
    f.a[at] = value
    f.b[at] = -1
    f.c[at] = -1
}

fn ir_opt_set_copy(f: &IRFunction, at: Int, source: Int) Never! {
    if f.dst[at] == source -> return ir_opt_kill(&f, at)
    f.op[at] = .Copy
    f.a[at] = source
    f.b[at] = -1
    f.c[at] = -1
}

fn ir_opt_fold(m: IRModule, f: &IRFunction, facts: OptFacts, fixed: Int, report: &IROptReport) -> Int Never! {
    nesting :: ir_opt_nesting(f)
    changed := 0
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        if op == .If || op == .BrIf {
            value :: ir_opt_const_at(f, facts, f.a[at], at) ?? next
            ir_opt_fold_branch(&f, nesting, at, value != 0)
            report.branches_folded += 1
            changed += 1
            next
        }
        if op == .Not {
            ty :: ir_opt_type(m, f, f.a[at])
            if ty.kind != .Bool -> next
            value :: ir_opt_const_at(f, facts, f.a[at], at) ?? next
            ir_opt_set_const(&f, at, if value != 0 -> 0 else -> 1)
            report.folded += 1
            changed += 1
            next
        }
        if op == .Neg {
            ty :: ir_opt_type(m, f, f.a[at])
            value :: ir_opt_const_at(f, facts, f.a[at], at) ?? next
            folded := Int?{None}
            if ty.kind == .Int && ir_int_inline(0 - value) -> folded = Val(0 - value)
            if ty.kind == .Word && ty.signed -> folded = ir_opt_word(ty, 0 - value, f.c[at] != IR_OVERFLOW_WRAP)
            result :: folded ?? next
            ir_opt_set_const(&f, at, result)
            report.folded += 1
            changed += 1
            next
        }
        if op == .CallRuntime {
            if f.a[at] != fixed || f.c[at] != 5 || f.dst[at] < 0 -> next
            value :: f.args[f.b[at]]
            if ir_opt_type(m, f, value).kind != .Int -> next
            mask :: ir_opt_masked_at(f, facts, value, at) ?? next
            kind :: ir_opt_const_at(f, facts, f.args[f.b[at] + 1], at) ?? next
            if mask > ir_opt_fixed_high(kind) -> next
            f.op[at] = .Move
            f.a[at] = value
            f.b[at] = -1
            f.c[at] = -1
            report.folded += 1
            changed += 1
            next
        }
        arithmetic :: op == .Add || op == .Sub || op == .Mul
        bitwise :: op == .BitAnd || op == .BitOr || op == .BitXor
        // Shifts and division only through their identities (x<<0, x>>0, x/1).
        identity_only :: op == .Shl || op == .Shr || op == .Div
        if !arithmetic && !bitwise && !identity_only && !ir_opt_is_compare(op) -> next
        ty :: ir_opt_type(m, f, f.a[at])
        if ty.kind != .Int && ty.kind != .Word && ty.kind != .Bool && ty.kind != .Char -> next
        left_slot :: f.a[at]
        right_slot :: f.b[at]
        if ir_opt_is_compare(op) && left_slot == right_slot {
            // A value against itself (never Float: NaN).
            ir_opt_set_const(&f, at, if op == .Eq || op == .Le || op == .Ge -> 1 else -> 0)
            report.folded += 1
            changed += 1
            next
        }
        left :: ir_opt_const_at(f, facts, left_slot, at)
        right :: ir_opt_const_at(f, facts, right_slot, at)
        has_l :: left != None
        has_r :: right != None
        l :: left ?? 0
        r :: right ?? 0
        if has_l && has_r && !bitwise && !identity_only {
            value :: ir_opt_fold_value(ty, op, l, r, f.c[at] != IR_OVERFLOW_WRAP) ?? next
            ir_opt_set_const(&f, at, value)
            report.folded += 1
            changed += 1
            next
        }
        if op == .Mul && ir_opt_floor_multiple(&f, facts, at, ty) {
            report.folded += 1
            changed += 1
            next
        }
        if ir_opt_is_compare(op) || (ty.kind != .Int && ty.kind != .Word) -> next
        // Identities: the other operand's value (a copy), or zero. `& -1`
        // only where -1 is every bit (Int, signed words).
        all_ones :: ty.kind == .Int || ty.signed
        zero_l :: has_l && l == 0
        zero_r :: has_r && r == 0
        if (op == .Add || op == .Sub || op == .BitOr || op == .BitXor) && zero_r {
            ir_opt_set_copy(&f, at, left_slot)
        } else if (op == .Add || op == .BitOr || op == .BitXor) && zero_l {
            ir_opt_set_copy(&f, at, right_slot)
        } else if op == .Mul && has_r && r == 1 {
            ir_opt_set_copy(&f, at, left_slot)
        } else if op == .Mul && has_l && l == 1 {
            ir_opt_set_copy(&f, at, right_slot)
        } else if (op == .Mul || op == .BitAnd) && (zero_l || zero_r) {
            ir_opt_set_const(&f, at, 0)
        } else if (op == .Sub || op == .BitXor) && left_slot == right_slot {
            ir_opt_set_const(&f, at, 0)
        } else if (op == .BitAnd || op == .BitOr) && left_slot == right_slot {
            ir_opt_set_copy(&f, at, left_slot)
        } else if (op == .Shl || op == .Shr) && zero_r {
            ir_opt_set_copy(&f, at, left_slot)
        } else if op == .Div && has_r && r == 1 {
            ir_opt_set_copy(&f, at, left_slot)
        } else if op == .BitAnd && all_ones && has_r && r == -1 {
            ir_opt_set_copy(&f, at, left_slot)
        } else if op == .BitAnd && all_ones && has_l && l == -1 {
            ir_opt_set_copy(&f, at, right_slot)
        } else {
            next
        }
        report.folded += 1
        changed += 1
    }
    changed
}

// `(x /% k) * k` with k = 2^j >= 2, of an Int or a signed word, is `x & -k`:
// the floored quotient times k is x with its low j bits cleared, in two's
// complement (Int.jet int_bitwise) for a negative or big x too. The Mul at
// `at` becomes that BitAnd when its other operand's one write is that
// FloorDiv of x by the constant k, x keeps its value from there to the Mul,
// and k's constant is read by the Mul only (it becomes -k). The FloorDiv,
// then unread, goes as dead code. The BitAnd of an Int is exact
// (OptRange.jet proves its operands inline); of a word it cannot overflow.
fn ir_opt_floor_multiple(f: &IRFunction, facts: OptFacts, at: Int, ty: IRX64Shape) -> Bool Never! {
    if ty.kind != .Int && !(ty.kind == .Word && ty.signed) -> return false
    loop side in 0..<2 {
        quotient :: if side == 0 -> f.a[at] else -> f.b[at]
        factor :: if side == 0 -> f.b[at] else -> f.a[at]
        k :: ir_opt_const_at(f, facts, factor, at) ?? next
        if k < 2 || k.bit_and(k - 1) != 0 || facts.uses[factor] != 1 -> next
        def :: ir_opt_reaching_def(f, facts, quotient, at)
        if def < 0 || f.op[def] != .FloorDiv -> next
        divisor :: ir_opt_const_at(f, facts, f.b[def], def) ?? next
        x :: f.a[def]
        if divisor != k || x == quotient || !ir_opt_unchanged(f, facts, x, def, at) -> next
        f.a[facts.def_at[factor]] = 0 - k
        f.op[at] = .BitAnd
        f.a[at] = x
        f.b[at] = factor
        f.c[at] = if ty.kind == .Word -> IR_OVERFLOW_WRAP else -> IR_OVERFLOW_TRAP
        return true
    }
    false
}

// Whether slot `x` holds at instruction `at` the value it had at `from`
// (before `at`, in the same region): no instruction between them writes it.
// A scalar slot changes only by an instruction writing it (a binding the
// code takes the address of lives in a cell of its own).
fn ir_opt_unchanged(f: IRFunction, facts: OptFacts, x: Int, from: Int, at: Int) -> Bool Never! {
    if from >= at || facts.region[from] != facts.region[at] -> return false
    loop between in (from + 1)..<at {
        if ir_x64_write(f, between) == x -> return false
    }
    true
}

// The constant c >= 0 an Int `slot` is masked by at instruction `at`, when
// its single reaching write is `x & c` (or `c & x`): the value lies in
// [0, c], an inline Int.
fn ir_opt_masked_at(f: IRFunction, facts: OptFacts, slot: Int, at: Int) -> Int? Never! {
    def :: ir_opt_reaching_def(f, facts, slot, at)
    if def < 0 || f.op[def] != .BitAnd -> return None
    right :: ir_opt_const_at(f, facts, f.b[def], def) ?? -1
    if right >= 0 -> return Val(right)
    left :: ir_opt_const_at(f, facts, f.a[def], def) ?? -1
    if left >= 0 -> return Val(left)
    None
}

// The largest value of jet_int_checked_fixed's `kind` (0..3 the signed
// 8..64-bit integers, 4..7 the unsigned ones; OptRange ir_range_fixed_kind),
// or -1 for none.
fn ir_opt_fixed_high(kind: Int) -> Int Never! {
    if kind == {
        0 -> 127
        1 -> 32767
        2 -> 2147483647
        3 -> 9223372036854775807
        4 -> 255
        5 -> 65535
        6 -> 4294967295
        7 -> 9223372036854775807
        else -> -1
    }
}

// An If or BrIf at `at` whose condition is the constant `taken`.
fn ir_opt_fold_branch(f: &IRFunction, nesting: OptNesting, at: Int, taken: Bool) Never! {
    if f.op[at] == .BrIf {
        if !taken -> return ir_opt_kill(&f, at)
        depth :: f.b[at]
        f.op[at] = .Br
        f.a[at] = depth
        f.b[at] = -1
        return
    }
    end :: nesting.end[at]
    other :: nesting.els[at]
    if taken {
        // The then-part stays as a Block (a Br inside counts it the same).
        f.op[at] = .Block
        f.a[at] = -1
        if other >= 0 {
            loop k in other..<end -> ir_opt_kill(&f, k)
        }
        return
    }
    if other < 0 {
        loop k in at..<(end + 1) -> ir_opt_kill(&f, k)
        return
    }
    f.op[at] = .Block
    f.a[at] = -1
    loop k in (at + 1)..<(other + 1) -> ir_opt_kill(&f, k)
}

// ---------------------------------------------------------------------------
// Unreachable code.

fn ir_opt_unreachable(f: &IRFunction, report: &IROptReport) -> Int Never! {
    removed := 0
    at := 0
    loop at < f.op.len() {
        op :: f.op[at]
        at += 1
        if op != .Br && op != .Return && op != .Unreachable -> next
        depth := 0
        loop at < f.op.len() {
            next_op :: f.op[at]
            if next_op == .Nop {
                at += 1
                next
            }
            if (next_op == .Else || next_op == .End) && depth == 0 -> break
            if next_op == .Block || next_op == .Loop || next_op == .If -> depth += 1
            if next_op == .End -> depth -= 1
            ir_opt_kill(&f, at)
            removed += 1
            at += 1
        }
    }
    report.unreachable_removed += removed
    removed
}

// ---------------------------------------------------------------------------
// Compare fusion.

// `t := a < b; x := !t` is `x := a >= b` when every write of `t` is such a
// compare that a Not reads right after (only Nops between) and those Nots
// are its only reads: each compare's value then reaches its own Not alone
// (a loop OptVersion.jet copied writes and tests the same slot twice).
fn ir_opt_fuse_compares(m: IRModule, f: &IRFunction, facts: OptFacts, report: &IROptReport) -> Int Never! {
    changed := 0
    pairs := [Int]{}
    loop _ in 0..<f.slot_type.len() -> &pairs.push(0)
    loop at in 1..<f.op.len() {
        if f.op[at] == .Not && f.a[at] >= 0 && ir_opt_fused_def(f, at) >= 0 -> pairs[f.a[at]] = pairs[f.a[at]] + 1
    }
    loop at in 1..<f.op.len() {
        if f.op[at] != .Not -> next
        tested :: f.a[at]
        if tested < f.param_count || facts.defs[tested] != pairs[tested] || facts.uses[tested] != pairs[tested] -> next
        def :: ir_opt_fused_def(f, at)
        if def < 0 -> next
        kind :: ir_opt_type(m, f, f.a[def]).kind
        if kind == .Float || kind == .Float32 -> next
        f.op[at] = ir_opt_inverse(f.op[def])
        f.a[at] = f.a[def]
        f.b[at] = f.b[def]
        f.c[at] = f.c[def]
        ir_opt_kill(&f, def)
        report.compares_fused += 1
        changed += 1
    }
    changed
}

// The compare into the slot Not `at` reads, with only Nops between them;
// -1 when there is none.
fn ir_opt_fused_def(f: IRFunction, at: Int) -> Int Never! {
    k := at - 1
    loop k >= 0 && f.op[k] == .Nop {
        k -= 1
    }
    if k < 0 || f.dst[k] != f.a[at] || !ir_opt_is_compare(f.op[k]) -> return -1
    k
}

// ---------------------------------------------------------------------------
// Short circuits as branches.

// `r = c1 && c2` and `r = c1 || c2` as built (BuildExpr.jet
// ir_short_circuit) are `r = copy c1; if c1 { B; r = c2 }` and
// `r = copy c1; t = not c1; if t { B; r = c2 }`. When the only reader of r
// is the If or BrIf right after that If (directly, or through one
// `n = not r`), that branch tests c1 and c2 itself and r is never a value:
//   and, If X [Else Y]: if c1 { B; r = c2; if r { X } }; with Y,
//                       block { if c1 { B; r = c2; if r { X; br 2 } }; Y }
//   or,  If X:          block { if t { B; r = c2; s = not r; br_if s 1 }; X }
//   or,  If X Else Y:   block { block { br_if c1 0; B; r = c2; br_if r 0;
//                       Y; br 1 }; X }
//   and, BrIf d:        if c1 { B; r = c2; br_if r d+1 }
//   or,  BrIf d:        br_if c1 d; B; r = c2; br_if r d
// A negated If swaps X and Y. A negated BrIf branches when c1 or c2 decides
// false: `and` is br_if (not c1) d; B; r = c2; br_if (not r) d, and `or` is
// if t { B; r = c2; br_if (not r) d+1 }. Every Not right after a compare
// then becomes the inverse compare (ir_opt_fuse_compares), and a compare
// read only by the branch after it leaves its result in the flags
// (X64Select.jet ir_x64_fusable). The Br depths inside B, X and Y that
// leave them count the constructs they gained or lost; a Br in B that
// leaves the If itself (skipping `r = c2`) keeps the Bool. Returns the
// rewrites.
//
// A pass over the function. A rewrite changes the reads and writes of its
// own r, c1, t and n and of the Bools it adds, and moves B, X and Y whole
// (Br depths aside). Only an earlier short circuit's r can be its c1 (of
// `(a && b) && c`), and the rewrites one at a time, first to last, never
// look back before the Copy they rewrote; so every short circuit those
// rewrites reach stood in the function as it came, but one a rewrite
// exposes: when c2 is `r = not r2` and r2 is the short circuit ending right
// before it (`a && !(b && c)`), the rewrite leaves r one write and puts the
// test of r right after that Not, so the short circuit r2 closes now has
// its negated branch. The first pass finds the short circuits on the
// function's facts and nesting and rebuilds it once, each short circuit
// where the walk reaches its Copy. The walk meets them in the order the
// one-at-a-time rewrites did, gives each its Bools in that order, and
// shifts a moved Br by every range it leaves, outermost first: the rows are
// the ones those rewrites made. Each later pass takes just the short
// circuits the one before exposed, until it exposes none.
fn ir_opt_short_circuits(f: &IRFunction, report: &IROptReport) -> Int Never! {
    exposed := [Int]{}
    total := ir_opt_short_pass(&f, &report, &exposed, true)
    loop exposed.len() > 0 {
        found :: ir_opt_short_pass(&f, &report, &exposed, false)
        if found == 0 -> break
        total += found
    }
    total
}

// One pass of ir_opt_short_circuits: every short circuit on `first`, else
// those whose negated branch tests an r in `exposed`. `exposed` comes back
// as the r of each rewritten short circuit whose c2 is a Not of the short
// circuit ending right before it.
fn ir_opt_short_pass(f: &IRFunction, report: &IROptReport, exposed: &[Int], first: Bool) -> Int Never! {
    count :: f.op.len()
    facts :: ir_opt_facts(f)
    nesting :: ir_opt_nesting(f)
    wanted := [Bool]{}
    if !first {
        loop _ in 0..<f.slot_kind.len() -> &wanted.push(false)
        loop slot in exposed -> wanted[slot] = true
    }
    &exposed.clear()
    seeds := [Int]{}
    loop _ in 0..<count -> &seeds.push(-1)
    found := 0
    loop at in 1..<count {
        if f.op[at] == .If && ir_opt_short_circuit_at(f, facts, nesting, at) {
            end :: nesting.end[at]
            if !first && (f.op[end + 1] != .Not || !wanted[f.dst[end + 1]]) -> next
            seeds[ir_opt_short_circuit_copy(f, at)] = at
            found += 1
            last :: end - 1
            if f.op[last] == .Not && f.op[last - 1] == .End -> &exposed.push(f.dst[last])
        }
    }
    if found == 0 -> return 0
    open := [Int]{}
    depth := 0
    loop at in 0..<count {
        op :: f.op[at]
        if op == .End || op == .Else -> depth -= 1
        &open.push(depth)
        if op == .Block || op == .Loop || op == .If || op == .Else -> depth += 1
    }
    plan :: OptShortPlan{nesting: ^nesting, seeds: ^seeds, open: ^open}
    rows := OptRows{op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, line: [Int]{}}
    levels := [OptShift]{}
    ir_opt_short_moved(&rows, &f, plan, &levels, 0, count, 0)
    f.op = ^rows.op
    f.dst = ^rows.dst
    f.a = ^rows.a
    f.b = ^rows.b
    f.c = ^rows.c
    f.code_line = ^rows.line
    ir_opt_compact(&f)
    report.short_circuits += found
    found
}

// The short circuits of one pass: the nesting of the function as it came,
// per instruction the If of the short circuit whose Copy it is (-1 for
// none), and the constructs open at it (an Else or End counted closed).
struct OptShortPlan {
    nesting: OptNesting
    seeds: [Int]
    open: [Int]
}

// A moved range: the constructs open at its first instruction, and how many
// constructs deeper each Br leaving it lands.
struct OptShift {
    open: Int
    shift: Int
}

// The Copy writing r before If `at` (r = copy c1), or -1 when `at` does not
// open a short circuit.
fn ir_opt_short_circuit_copy(f: IRFunction, at: Int) -> Int Never! {
    tested :: f.a[at]
    prev :: at - 1
    if f.op[prev] == .Not && f.dst[prev] == tested {
        if prev < 1 -> return -1
        seed :: prev - 1
        if (f.op[seed] == .Copy || f.op[seed] == .Move) && f.a[seed] == f.a[prev] -> return seed
        return -1
    }
    copied :: (f.op[prev] == .Copy || f.op[prev] == .Move) && f.a[prev] == tested
    if copied -> prev else -> -1
}

// The Not `n = not r` read only by the branch after it, at `at`; -1 when
// `at` is no such Not.
fn ir_opt_short_circuit_not(f: IRFunction, facts: OptFacts, at: Int, r: Int) -> Int Never! {
    if at + 1 >= f.op.len() || f.op[at] != .Not || f.a[at] != r -> return -1
    n :: f.dst[at]
    if n < f.param_count || f.slot_kind[n] != .Temp || facts.defs[n] != 1 || facts.uses[n] != 1 -> return -1
    if (f.op[at + 1] != .If && f.op[at + 1] != .BrIf) || f.a[at + 1] != n -> return -1
    at
}

fn ir_opt_short_circuit_at(f: IRFunction, facts: OptFacts, nesting: OptNesting, at: Int) -> Bool Never! {
    if at < 1 || nesting.els[at] >= 0 -> return false
    seed :: ir_opt_short_circuit_copy(f, at)
    if seed < 0 -> return false
    is_or :: seed != at - 1
    if is_or && (facts.defs[f.a[at]] != 1 || facts.uses[f.a[at]] != 1) -> return false
    r :: f.dst[seed]
    c1 :: f.a[seed]
    end :: nesting.end[at]
    last :: end - 1
    if r < f.param_count || r == c1 || f.slot_kind[r] != .Temp || facts.defs[r] != 2 || facts.uses[r] != 1 -> return false
    if last <= at || ir_opt_structural(f.op[last]) || ir_x64_write(f, last) != r -> return false
    branch := end + 1
    if branch >= f.op.len() -> return false
    if f.op[branch] == .Not {
        negation :: ir_opt_short_circuit_not(f, facts, branch, r)
        if negation < 0 -> return false
        branch = negation + 1
    } else if (f.op[branch] != .If && f.op[branch] != .BrIf) || f.a[branch] != r {
        return false
    }
    // A Br in B that leaves the If itself skips `r = c2`.
    depth := 0
    loop k in (at + 1)..<last {
        op :: f.op[k]
        if op == .End || op == .Else -> depth -= 1
        if op == .Br && f.a[k] == depth -> return false
        if op == .BrIf && f.b[k] == depth -> return false
        if op == .Block || op == .Loop || op == .If || op == .Else -> depth += 1
    }
    true
}

// The instruction rows of a function being rebuilt (Ir_opt_compact
// recomputes the structural indexes).
struct OptRows {
    op: [IROp]
    dst: [Int]
    a: [Int]
    b: [Int]
    c: [Int]
    line: [Int]
}

fn ir_opt_row(rows: &OptRows, op: IROp, dst: Int, a: Int, b: Int, c: Int, line: Int) Never! {
    &rows.op.push(op)
    &rows.dst.push(dst)
    &rows.a.push(a)
    &rows.b.push(b)
    &rows.c.push(c)
    &rows.line.push(line)
}

// Instructions `from..<to` of `f` onto `rows`, each Br that leaves the
// range `shift` constructs deeper on top of what the ranges around it
// (`levels`, outermost first) shift it, and each short circuit whose Copy
// is among them rewritten.
fn ir_opt_short_moved(rows: &OptRows, f: &IRFunction, plan: OptShortPlan, levels: &[OptShift], from: Int, to: Int, shift: Int) Never! {
    if from >= to -> return
    &levels.push(OptShift{open: plan.open[from], shift: shift})
    k := from
    loop k < to {
        at :: plan.seeds[k]
        if at >= 0 {
            k = ir_opt_short_circuit_rewrite(&rows, &f, plan, &levels, at)
            next
        }
        op :: f.op[k]
        a := f.a[k]
        b := f.b[k]
        if op == .Br -> a = ir_opt_short_depth(plan, levels, k, a)
        if op == .BrIf -> b = ir_opt_short_depth(plan, levels, k, b)
        ir_opt_row(&rows, op, f.dst[k], a, b, f.c[k], f.code_line[k])
        k += 1
    }
    _ := &levels.pop()
}

// Br depth `depth` of instruction `k` once every range in `levels` moved it:
// a range shifts it when it leaves the range, judged on the depth as the
// ranges around that one left it.
fn ir_opt_short_depth(plan: OptShortPlan, levels: [OptShift], k: Int, depth: Int) -> Int Never! {
    out := depth
    loop level in levels {
        if out >= plan.open[k] - level.open -> out += level.shift
    }
    out
}

// A fresh Bool temporary of `like`'s type.
fn ir_opt_bool_temp(f: &IRFunction, like: Int) -> Int Never! {
    ir_slot(&f, f.slot_type[like], IRSlotKind.Temp, -1, 0)
}

// Short circuit If `at` rewritten onto `rows`; returns the instruction
// after its branch. Its Bools come first, as rewriting it alone would make
// them before any short circuit inside it.
fn ir_opt_short_circuit_rewrite(rows: &OptRows, f: &IRFunction, plan: OptShortPlan, levels: &[OptShift], at: Int) -> Int Never! {
    seed :: ir_opt_short_circuit_copy(f, at)
    is_or :: seed != at - 1
    r :: f.dst[seed]
    c1 :: f.a[seed]
    t :: f.a[at]
    end :: plan.nesting.end[at]
    line :: f.code_line[at]
    negated :: f.op[end + 1] == .Not
    branch :: if negated -> end + 2 else -> end + 1
    // `t = not c1` stays for the forms that test t; dead code drops it
    // where they do not.
    if is_or -> ir_opt_short_moved(&rows, &f, plan, &levels, seed + 1, at, 0)
    if f.op[branch] == .BrIf {
        d :: ir_opt_short_depth(plan, levels, branch, f.b[branch])
        if is_or == negated {
            // and: c1 && c2; negated or: !c1 && !c2. Both branch inside If.
            test :: if negated -> ir_opt_bool_temp(&f, r) else -> r
            ir_opt_row(&rows, IROp.If, -1, t, -1, -1, line)
            ir_opt_short_moved(&rows, &f, plan, &levels, at + 1, end, 0)
            if negated -> ir_opt_row(&rows, IROp.Not, test, r, -1, -1, line)
            ir_opt_row(&rows, IROp.BrIf, -1, test, d + 1, -1, line)
            ir_opt_row(&rows, IROp.End, -1, -1, -1, -1, line)
        } else {
            // or: c1 || c2; negated and: !c1 || !c2. Branch on either.
            first :: if negated -> ir_opt_bool_temp(&f, r) else -> c1
            test :: if negated -> ir_opt_bool_temp(&f, r) else -> r
            if negated -> ir_opt_row(&rows, IROp.Not, first, c1, -1, -1, line)
            ir_opt_row(&rows, IROp.BrIf, -1, first, d, -1, line)
            ir_opt_short_moved(&rows, &f, plan, &levels, at + 1, end, -1)
            if negated -> ir_opt_row(&rows, IROp.Not, test, r, -1, -1, line)
            ir_opt_row(&rows, IROp.BrIf, -1, test, d, -1, line)
        }
        return branch + 1
    }
    close :: plan.nesting.end[branch]
    els :: plan.nesting.els[branch]
    then_end :: if els >= 0 -> els else -> close
    // The arm r true runs, and the arm r false runs.
    yes_from := branch + 1
    yes_to := then_end
    no_from := if els >= 0 -> els + 1 else -> close
    no_to := close
    if negated {
        yes_from = no_from
        yes_to = no_to
        no_from = branch + 1
        no_to = then_end
    }
    if !is_or && no_from == no_to {
        ir_opt_row(&rows, IROp.If, -1, c1, -1, -1, line)
        ir_opt_short_moved(&rows, &f, plan, &levels, at + 1, end, 0)
        ir_opt_row(&rows, IROp.If, -1, r, -1, -1, line)
        ir_opt_short_moved(&rows, &f, plan, &levels, yes_from, yes_to, 1)
        ir_opt_row(&rows, IROp.End, -1, -1, -1, -1, line)
        ir_opt_row(&rows, IROp.End, -1, -1, -1, -1, line)
    } else if !is_or {
        ir_opt_short_blocks(&rows, 1, c1, line)
        ir_opt_row(&rows, IROp.If, -1, c1, -1, -1, line)
        ir_opt_short_moved(&rows, &f, plan, &levels, at + 1, end, 1)
        if yes_from == yes_to {
            ir_opt_row(&rows, IROp.BrIf, -1, r, 1, -1, line)
        } else {
            ir_opt_row(&rows, IROp.If, -1, r, -1, -1, line)
            ir_opt_short_moved(&rows, &f, plan, &levels, yes_from, yes_to, 2)
            ir_opt_row(&rows, IROp.Br, -1, 2, -1, -1, line)
            ir_opt_row(&rows, IROp.End, -1, -1, -1, -1, line)
        }
        ir_opt_row(&rows, IROp.End, -1, -1, -1, -1, line)
        ir_opt_short_moved(&rows, &f, plan, &levels, no_from, no_to, 0)
        ir_opt_row(&rows, IROp.End, -1, -1, -1, -1, line)
    } else if no_from == no_to {
        skip :: ir_opt_bool_temp(&f, r)
        ir_opt_short_blocks(&rows, 1, c1, line)
        ir_opt_row(&rows, IROp.If, -1, t, -1, -1, line)
        ir_opt_short_moved(&rows, &f, plan, &levels, at + 1, end, 1)
        ir_opt_row(&rows, IROp.Not, skip, r, -1, -1, line)
        ir_opt_row(&rows, IROp.BrIf, -1, skip, 1, -1, line)
        ir_opt_row(&rows, IROp.End, -1, -1, -1, -1, line)
        ir_opt_short_moved(&rows, &f, plan, &levels, yes_from, yes_to, 0)
        ir_opt_row(&rows, IROp.End, -1, -1, -1, -1, line)
    } else {
        ir_opt_short_blocks(&rows, 2, c1, line)
        ir_opt_row(&rows, IROp.BrIf, -1, c1, 0, -1, line)
        ir_opt_short_moved(&rows, &f, plan, &levels, at + 1, end, 1)
        ir_opt_row(&rows, IROp.BrIf, -1, r, 0, -1, line)
        ir_opt_short_moved(&rows, &f, plan, &levels, no_from, no_to, 1)
        ir_opt_row(&rows, IROp.Br, -1, 1, -1, -1, line)
        ir_opt_row(&rows, IROp.End, -1, -1, -1, -1, line)
        ir_opt_short_moved(&rows, &f, plan, &levels, yes_from, yes_to, 0)
        ir_opt_row(&rows, IROp.End, -1, -1, -1, -1, line)
    }
    close + 1
}

// `count` Block openers onto `rows`, placed before the comparison that
// writes `c1` (and the `not c1` after it) when those are the last rows: the
// branch on c1 then follows its comparison directly, so the comparison's
// flags feed the branch (X64Select ir_x64_fusable). A Block opener runs
// nothing, so the rows it now encloses run as before.
fn ir_opt_short_blocks(rows: &OptRows, count: Int, c1: Int, line: Int) Never! {
    total :: rows.op.len()
    tail := total
    if tail > 0 && rows.op[tail - 1] == .Not && rows.a[tail - 1] == c1 -> tail -= 1
    if tail > 0 && ir_opt_is_compare(rows.op[tail - 1]) && rows.dst[tail - 1] == c1 {
        tail -= 1
    } else {
        tail = total
    }
    moved := OptRows{op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, line: [Int]{}}
    loop k in tail..<total -> ir_opt_row(&moved, rows.op[k], rows.dst[k], rows.a[k], rows.b[k], rows.c[k], rows.line[k])
    loop _ in tail..<total {
        _ := &rows.op.pop()
        _ := &rows.dst.pop()
        _ := &rows.a.pop()
        _ := &rows.b.pop()
        _ := &rows.c.pop()
        _ := &rows.line.pop()
    }
    loop _ in 0..<count -> ir_opt_row(&rows, IROp.Block, -1, -1, -1, -1, line)
    loop k in 0..<moved.op.len() -> ir_opt_row(&rows, moved.op[k], moved.dst[k], moved.a[k], moved.b[k], moved.c[k], moved.line[k])
}

// ---------------------------------------------------------------------------
// Copy propagation: `x = move/copy y` where x is written only there and y
// is a parameter or written once before it, and the Move/Copy reaches every
// read of x: the reads of x read y, and the Move/Copy goes. A Copy of a
// value with a drop is a clone and stays. A y written more than once
// qualifies when x's one read is the instruction right after the
// Move/Copy: nothing runs between them, so y still holds the value there
// (the `r2 = r` an outer short circuit leaves between an inner one's End
// and the branch on it).

fn ir_opt_propagate(m: IRModule, f: &IRFunction, facts: OptFacts, report: &IROptReport) -> Int Never! {
    count :: f.slot_type.len()
    replace := [Int]{}
    loop _ in 0..<count -> &replace.push(-1)
    killed := [Bool]{}
    loop _ in 0..<f.op.len() -> &killed.push(false)
    any := false
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        if op != .Move && op != .Copy -> next
        x :: f.dst[at]
        y :: f.a[at]
        if x == y || x < f.param_count || facts.defs[x] != 1 -> next
        if f.slot_type[x] != f.slot_type[y] -> next
        if op == .Copy && m.types[f.slot_type[y]].drop != "" -> next
        // y keeps the value it had at the Move for as long as x is read.
        if !ir_opt_propagate_adjacent(m, f, facts, at, x, y) {
            if y >= f.param_count && ir_opt_reaching_def(f, facts, y, at) < 0 -> next
            if y < f.param_count && facts.defs[y] != 1 -> next
        }
        replace[x] = y
        killed[at] = true
        any = true
    }
    if !any -> return 0
    // Every read of a replaced slot must be reached by its Move/Copy.
    reads := [Int]{}
    loop at in 0..<f.op.len() {
        ir_x64_reads_into(f, at, &reads)
        loop slot in reads {
            if slot < 0 || replace[slot] < 0 -> next
            if ir_opt_reaching_def(f, facts, slot, at) < 0 {
                killed[facts.def_at[slot]] = false
                replace[slot] = -1
            }
        }
    }
    // A source that is itself replaced resolves to its own source (chains).
    loop slot in 0..<count {
        target := replace[slot]
        steps := 0
        loop target >= 0 && replace[target] >= 0 && steps < count {
            target = replace[target]
            steps += 1
        }
        if target >= 0 -> replace[slot] = target
    }
    changed := 0
    loop at in 0..<f.op.len() {
        if killed[at] {
            ir_opt_kill(&f, at)
            changed += 1
            next
        }
        ir_opt_rename_reads(&f, at, replace)
    }
    report.copies_coalesced += changed
    changed
}

// Whether `x = move/copy y` at `at` has x's only read in instruction
// `at + 1`, y is written more than once (so no Move/Copy of this sweep
// replaces y itself) and its type has no drop.
fn ir_opt_propagate_adjacent(m: IRModule, f: IRFunction, facts: OptFacts, at: Int, x: Int, y: Int) -> Bool Never! {
    if facts.uses[x] != 1 || facts.defs[y] == 1 || at + 1 >= f.op.len() -> return false
    if m.types[f.slot_type[y]].drop != "" -> return false
    reads := [Int]{}
    ir_x64_reads_into(f, at + 1, &reads)
    reads.contains(x)
}

// Rewrites the slots instruction `at` reads through `replace` (-1: kept).
fn ir_opt_rename_reads(f: &IRFunction, at: Int, replace: [Int]) Never! {
    op :: f.op[at]
    if op == {
        .Copy | .Move | .Drop | .Close | .Neg | .Not | .Sqrt | .IntBig | .Convert | .Load | .Offset | .If | .BrIf -> f.a[at] = ir_opt_renamed(replace, f.a[at])
        .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Concat | .CopyBytes -> {
            f.a[at] = ir_opt_renamed(replace, f.a[at])
            f.b[at] = ir_opt_renamed(replace, f.b[at])
        }
        .Store -> {
            f.a[at] = ir_opt_renamed(replace, f.a[at])
            f.c[at] = ir_opt_renamed(replace, f.c[at])
        }
        .Return -> f.a[at] = ir_opt_renamed(replace, f.a[at])
        .Call | .CallRuntime | .CallIndirect -> {
            if op == .CallIndirect -> f.a[at] = ir_opt_renamed(replace, f.a[at])
            loop index in f.b[at]..<(f.b[at] + f.c[at]) -> f.args[index] = ir_opt_renamed(replace, f.args[index])
        }
        else -> {}
    }
}

fn ir_opt_renamed(replace: [Int], slot: Int) -> Int Never! {
    if slot < 0 || slot >= replace.len() || replace[slot] < 0 -> return slot
    replace[slot]
}

// ---------------------------------------------------------------------------
// Common values: `x = <op> a b`, x written only there, where an earlier
// `y = <op> a b` (the same op and fields) gives y its value at x's
// instruction and a and b each hold there the value they held at it (a
// parameter written only at entry, or a slot whose one write reaches both),
// becomes `x = move y`, which propagate then folds into x's readers. The op
// is arithmetic, Neg, Sqrt or Offset of a result without a drop: it reads
// only its operands and writes only x, and IEEE rounding gives a Float the
// same bits both times. Comparisons and Not stay: selection fuses each into
// the branch that reads it, where a shared Bool would live in a register or
// home and be tested again.
// One that can stop stopped at the
// first already. The table keeps per (op, fields) the latest instruction,
// so a twin in an arm the later one cannot see gives way to it.

fn ir_opt_common(m: IRModule, f: &IRFunction, facts: OptFacts) -> Int Never! {
    seen := [Int:Int]{}
    changed := 0
    loop at in 0..<f.op.len() {
        key :: ir_opt_common_key(m, f, facts, at)
        if key < 0 -> next
        twin :: seen.get(key) ?? -1
        seen[key] = at
        if twin < 0 -> next
        x :: f.dst[at]
        y :: f.dst[twin]
        if f.slot_type[x] != f.slot_type[y] || ir_opt_reaching_def(f, facts, y, at) != twin -> next
        if !ir_opt_holds(f, facts, f.a[at], twin, at) -> next
        if ir_x64_read_form(f.op[at]) == IR_X64_READS_AB && !ir_opt_holds(f, facts, f.b[at], twin, at) -> next
        f.op[at] = IROp.Move
        f.a[at] = y
        f.b[at] = -1
        f.c[at] = -1
        seen[key] = twin
        changed += 1
    }
    changed
}

// The table key of instruction `at` for ir_opt_common, -1 when it is no
// candidate: its op's code and fields packed in 53 bits.
fn ir_opt_common_key(m: IRModule, f: IRFunction, facts: OptFacts, at: Int) -> Int Never! {
    code :: ir_opt_common_code(f.op[at])
    if code == 0 -> return -1
    x :: f.dst[at]
    if x < f.param_count || facts.defs[x] != 1 || m.types[f.slot_type[x]].drop != "" -> return -1
    a :: f.a[at]
    b :: f.b[at]
    c :: f.c[at]
    limit :: 1 << 20
    if a < 0 || a >= limit || b < -1 || b >= limit || c < -1 || c > 14 -> return -1
    ((code * (limit * 2) + a + 1) * (limit * 2) + b + 1) * 16 + c + 1
}

// ir_opt_common's code of `op`, 0 for none.
fn ir_opt_common_code(op: IROp) -> Int Never! {
    if op == {
        .Add -> 1
        .Sub -> 2
        .Mul -> 3
        .Div -> 4
        .Rem -> 5
        .FloorDiv -> 6
        .Mod -> 7
        .BitAnd -> 8
        .BitOr -> 9
        .BitXor -> 10
        .Shl -> 11
        .Shr -> 12
        .Neg -> 13
        .Sqrt -> 14
        .Offset -> 15
        else -> 0
    }
}

// Whether operand `slot` holds at `at` the value it held at `twin`.
fn ir_opt_holds(f: IRFunction, facts: OptFacts, slot: Int, twin: Int, at: Int) -> Bool Never! {
    if slot < 0 -> return false
    if slot < f.param_count -> return facts.defs[slot] == 1
    def :: ir_opt_reaching_def(f, facts, slot, twin)
    def >= 0 && ir_opt_reaching_def(f, facts, slot, at) == def
}

// ---------------------------------------------------------------------------
// Address folding. The readers keep reading the same bytes: t holds at each
// reader the value it had at the Offset (a parameter written only at entry,
// or its one write reaches the reader), and p is then dead.

fn ir_opt_addresses(f: &IRFunction, facts: OptFacts) -> Int Never! {
    changed := 0
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        if op == .Offset || op == .Load || op == .Store {
            def :: ir_opt_address_def(f, facts, f.a[at], at)
            if def < 0 -> next
            f.b[at] = f.b[at] + f.b[def]
            f.a[at] = f.a[def]
            changed += 1
        } else if op == .CopyBytes {
            target :: ir_opt_address_def(f, facts, f.a[at], at)
            if target >= 0 && f.b[target] == 0 {
                f.a[at] = f.a[target]
                changed += 1
            }
            source :: ir_opt_address_def(f, facts, f.b[at], at)
            if source >= 0 && f.b[source] == 0 {
                f.b[at] = f.a[source]
                changed += 1
            }
        }
    }
    changed
}

// The `offset slot <- t k` that gives address `slot` its value at `at`,
// when t holds there the value it had at that Offset; -1 otherwise.
fn ir_opt_address_def(f: IRFunction, facts: OptFacts, slot: Int, at: Int) -> Int Never! {
    if slot < 0 -> return -1
    def :: ir_opt_reaching_def(f, facts, slot, at)
    if def < 0 || f.op[def] != .Offset -> return -1
    base :: f.a[def]
    if base < 0 || base == slot -> return -1
    if base < f.param_count -> return if facts.defs[base] == 1 -> def else -> -1
    if ir_opt_reaching_def(f, facts, base, at) < 0 -> return -1
    def
}

// ---------------------------------------------------------------------------
// Coalescing.

fn ir_opt_coalesce(f: &IRFunction, facts: OptFacts, report: &IROptReport) -> Int Never! {
    changed := 0
    reads := [Int]{}
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        if op != .Move && op != .Copy -> next
        t :: f.a[at]
        x :: f.dst[at]
        if t == x || t < f.param_count || f.slot_kind[t] != .Temp -> next
        if facts.defs[t] != 1 || facts.uses[t] != 1 || f.slot_type[t] != f.slot_type[x] -> next
        def :: facts.def_at[t]
        if def < 0 || def >= at || f.dst[def] != t -> next
        clean := true
        loop k in (def + 1)..<at {
            if ir_opt_structural(f.op[k]) || ir_x64_write(f, k) == x {
                clean = false
                break
            }
            ir_x64_reads_into(f, k, &reads)
            loop slot in reads {
                if slot == x -> clean = false
            }
            if !clean -> break
        }
        if !clean -> next
        f.dst[def] = x
        ir_opt_kill(&f, at)
        report.copies_coalesced += 1
        changed += 1
    }
    changed
}

// ---------------------------------------------------------------------------
// Address sums.

// The last pass of each function (Opt.jet ir_opt_function): a wrapping word
// Add whose one reader is the address of a later memory access moves to just
// before that access, and a wrapping word Mul whose one reader is such a sum
// moves to just before the sum. A memory access is a Load, a Store, or a
// call of an inline template (an `#FFI(asm)` leaf, keyed "<key>#asm")
// through its first argument. Only plain instructions may sit between: no
// structured control, no call of a body, runtime routine or stop poll, and
// none writes the moved instruction's operands or result, so its operands
// hold the same values at the new place. Nothing then holds the sum across
// the instructions between, and it sits where an addressing mode can take it
// (X64Select ir_x64_indexed). Pure word arithmetic moves within one
// straight-line run, so the program means the same on every target.
// Instructions are visited last first: a move shifts only instructions after
// the one moved. `keys` are the module's function keys by id.
fn ir_opt_sink_addresses(m: IRModule, keys: [String], f: &IRFunction) -> Int Never! {
    facts :: ir_opt_facts(f)
    changed := 0
    reads := [Int]{}
    at := f.op.len() - 1
    loop at >= 0 {
        to :: ir_opt_sink_target(m, keys, f, facts, at, &reads)
        if to > at + 1 {
            ir_opt_rotate(&f, at, to - 1)
            changed += 1
        }
        at -= 1
    }
    changed
}

// The reader instruction `at` moves next to (ir_opt_sink_addresses), else -1.
fn ir_opt_sink_target(m: IRModule, keys: [String], f: IRFunction, facts: OptFacts, at: Int, reads: &[Int]) -> Int Never! {
    op :: f.op[at]
    if (op != .Add && op != .Mul) || f.c[at] != IR_OVERFLOW_WRAP -> return -1
    sum :: f.dst[at]
    if sum < f.param_count || facts.defs[sum] != 1 || facts.uses[sum] != 1 -> return -1
    if ir_opt_type(m, f, sum).kind != .Word -> return -1
    left :: f.a[at]
    right :: f.b[at]
    k := at + 1
    loop k < f.op.len() {
        if ir_opt_structural(f.op[k]) -> return -1
        ir_x64_reads_into(f, k, &reads)
        loop slot in reads {
            if slot == sum -> return if ir_opt_addresses_at(keys, f, op, sum, k) -> k else -> -1
        }
        if !ir_opt_plain(keys, f, k) -> return -1
        written :: ir_x64_write(f, k)
        if written >= 0 && (written == left || written == right || written == sum) -> return -1
        k += 1
    }
    return -1
}

// Whether instruction `k` reads `slot` as the address of a memory access
// (`op` Add), or as an operand of a wrapping Add that addresses the access
// right after it (`op` Mul).
fn ir_opt_addresses_at(keys: [String], f: IRFunction, op: IROp, slot: Int, k: Int) -> Bool Never! {
    if op == .Add -> return ir_opt_access_address(keys, f, k) == slot
    if f.op[k] != .Add || f.c[k] != IR_OVERFLOW_WRAP || k + 1 >= f.op.len() -> return false
    ir_opt_access_address(keys, f, k + 1) == f.dst[k]
}

// The address slot memory access `k` reads, else -1.
fn ir_opt_access_address(keys: [String], f: IRFunction, k: Int) -> Int Never! {
    op :: f.op[k]
    if op == .Load || op == .Store -> return f.a[k]
    if ir_opt_template_call(keys, f, k) && f.c[k] >= 1 -> return f.args[f.b[k]]
    return -1
}

// Whether instruction `k` calls an inline template: an `#FFI(asm)` leaf
// other than the stop poll and trap, which the selector calls.
fn ir_opt_template_call(keys: [String], f: IRFunction, k: Int) -> Bool Never! {
    if f.op[k] != .Call || f.a[k] < 0 || f.a[k] >= keys.len() -> return false
    key :: keys[f.a[k]]
    key.ends_with("#asm") && key != IR_STOP_POLL_KEY && key != IR_STOP_TRAP_KEY
}

// Whether instruction `k` calls nothing but an inline template: no body,
// runtime routine, release (Drop, Close) or runtime-backed operation.
fn ir_opt_plain(keys: [String], f: IRFunction, k: Int) -> Bool Never! {
    op :: f.op[k]
    if op == .Call -> return ir_opt_template_call(keys, f, k)
    op != .CallRuntime && op != .CallIndirect && op != .Drop && op != .Close && op != .Concat && op != .CopyBytes && op != .IntBig && op != .ConstBigInt
}

// Moves instruction `from` to `to` (> from); the ones between move up one.
fn ir_opt_rotate(f: &IRFunction, from: Int, to: Int) Never! {
    op :: f.op[from]
    dst :: f.dst[from]
    a :: f.a[from]
    b :: f.b[from]
    c :: f.c[from]
    line :: f.code_line[from]
    loop k in from..<to {
        f.op[k] = f.op[k + 1]
        f.dst[k] = f.dst[k + 1]
        f.a[k] = f.a[k + 1]
        f.b[k] = f.b[k + 1]
        f.c[k] = f.c[k + 1]
        f.code_line[k] = f.code_line[k + 1]
    }
    f.op[to] = op
    f.dst[to] = dst
    f.a[to] = a
    f.b[to] = b
    f.c[to] = c
    f.code_line[to] = line
}

// ---------------------------------------------------------------------------
// Dead code.

// Whether instruction `at` does nothing but write its result.
fn ir_opt_removable(m: IRModule, f: IRFunction, at: Int) -> Bool Never! {
    op :: f.op[at]
    if op == {
        .Const | .ConstText | .ConstBigInt | .DataAddress | .FunctionAddress | .StackAddress | .Offset | .Load | .Not | .Sqrt | .IntBig | .Convert | .Concat | .Copy | .Move -> return true
        .Eq | .Ne | .Lt | .Le | .Gt | .Ge -> return true
        .Add | .Sub | .Mul | .Neg | .BitAnd | .BitOr | .BitXor | .Div | .Shl | .Shr -> {
            kind :: ir_opt_type(m, f, f.a[at]).kind
            if kind == .Float || kind == .Float32 -> return op != .BitAnd && op != .BitOr && op != .BitXor && op != .Shl && op != .Shr
            if kind == .Int -> return op != .Div && op != .Shl && op != .Shr
            if kind == .Word {
                if op == .BitAnd || op == .BitOr || op == .BitXor -> return true
                if op == .Div -> return false
                return f.c[at] == IR_OVERFLOW_WRAP
            }
            return false
        }
        else -> return false
    }
}

// `facts` are the function's as it is now; each sweep after one that removed
// something reads new ones.
fn ir_opt_dead(m: IRModule, f: &IRFunction, facts: OptFacts, report: &IROptReport) -> Int Never! {
    total := ir_opt_dead_sweep(m, &f, facts)
    removed := total
    loop removed > 0 {
        fresh :: ir_opt_facts(f)
        removed = ir_opt_dead_sweep(m, &f, fresh)
        total += removed
    }
    report.dead_removed += total
    total
}

fn ir_opt_dead_sweep(m: IRModule, f: &IRFunction, facts: OptFacts) -> Int Never! {
    removed := 0
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        if op == .Drop {
            slot :: f.a[at]
            if ir_opt_type(m, f, slot).kind == .Int && (ir_opt_const_at(f, facts, slot, at) != None || ir_opt_masked_at(f, facts, slot, at) != None) {
                ir_opt_kill(&f, at)
                removed += 1
            }
            next
        }
        dst :: f.dst[at]
        if dst < 0 || facts.uses[dst] != 0 -> next
        if !ir_opt_removable(m, f, at) && !ir_opt_quiet_division(m, f, facts, at) -> next
        ir_opt_kill(&f, at)
        removed += 1
    }
    removed
}

// A division or remainder of an Int or a word by a positive constant: it
// cannot stop (no zero divisor, no MIN / -1), so unread it only writes its
// result.
fn ir_opt_quiet_division(m: IRModule, f: IRFunction, facts: OptFacts, at: Int) -> Bool Never! {
    op :: f.op[at]
    if op != .Div && op != .Rem && op != .FloorDiv && op != .Mod -> return false
    kind :: ir_opt_type(m, f, f.a[at]).kind
    if kind != .Int && kind != .Word -> return false
    divisor :: ir_opt_const_at(f, facts, f.b[at], at) ?? return false
    divisor > 0
}

// ---------------------------------------------------------------------------
// Structure: `br 0` that only falls through, and empty constructs.

fn ir_opt_next_live(f: IRFunction, from: Int) -> Int Never! {
    at := from
    loop at < f.op.len() && f.op[at] == .Nop {
        at += 1
    }
    at
}

fn ir_opt_structure(f: &IRFunction, report: &IROptReport) -> Int Never! {
    changed := 0
    open := [Int]{}
    at := 0
    loop at < f.op.len() {
        op :: f.op[at]
        if op == {
            .Block | .Loop | .If -> {
                after :: ir_opt_next_live(f, at + 1)
                if after < f.op.len() && f.op[after] == .End {
                    ir_opt_kill(&f, at)
                    ir_opt_kill(&f, after)
                    changed += 1
                    at = after + 1
                    next
                }
                if op == .If && after < f.op.len() && f.op[after] == .Else {
                    closing :: ir_opt_next_live(f, after + 1)
                    if closing < f.op.len() && f.op[closing] == .End {
                        ir_opt_kill(&f, at)
                        ir_opt_kill(&f, after)
                        ir_opt_kill(&f, closing)
                        changed += 1
                        at = closing + 1
                        next
                    }
                }
                &open.push(at)
            }
            .End -> _ := &open.pop()
            .Br -> {
                if f.a[at] == 0 && open.len() > 0 {
                    target :: f.op[open[open.len() - 1]]
                    after :: ir_opt_next_live(f, at + 1)
                    if after < f.op.len() && target != .Loop && (f.op[after] == .End || (f.op[after] == .Else && target == .If)) {
                        ir_opt_kill(&f, at)
                        changed += 1
                    }
                }
            }
            else -> {}
        }
        at += 1
    }
    report.unreachable_removed += changed
    changed
}

// A Block no Br targets is only nesting: it goes, and every Br inside it
// that leaves past it counts one construct fewer. One Block at a time, in
// order, each over the depths the previous ones left.
fn ir_opt_unwrap(f: &IRFunction) -> Int Never! {
    nesting :: ir_opt_nesting(f)
    changed := 0
    loop at in 0..<f.op.len() {
        if f.op[at] != .Block -> next
        end :: nesting.end[at]
        targeted := false
        depth := 0
        loop k in (at + 1)..<end {
            op :: f.op[k]
            if op == .End -> depth -= 1
            if op == .Br && f.a[k] == depth -> targeted = true
            if op == .BrIf && f.b[k] == depth -> targeted = true
            if op == .Block || op == .Loop || op == .If -> depth += 1
            if targeted -> break
        }
        if targeted -> next
        depth = 0
        loop k in (at + 1)..<end {
            op :: f.op[k]
            if op == .End -> depth -= 1
            if op == .Br && f.a[k] > depth -> f.a[k] = f.a[k] - 1
            if op == .BrIf && f.b[k] > depth -> f.b[k] = f.b[k] - 1
            if op == .Block || op == .Loop || op == .If -> depth += 1
        }
        ir_opt_kill(&f, at)
        ir_opt_kill(&f, end)
        changed += 1
    }
    changed
}

// even(x) = x /% 2 * 2 == x over an Int: at O1 and O2 the product is
// `x & -2`, and IR Lint finds nothing after any pass.
#Test("A floored quotient times its power-of-two divisor is the dividend masked") {
    loop level in 1..<3 {
        m := ir_module_new()
        exact :: ir_type_row(&m, Type.Int) ?? panic("no Int row")
        flag :: ir_type_row(&m, Type.Bool) ?? panic("no Bool row")
        g := ir_function_new("even", "test:even.jet::even", "", "even.jet", 1)
        x :: ir_slot(&g, exact, IRSlotKind.Param, ir_intern_name(&m, "x"), 1)
        g.result = flag
        two :: ir_slot(&g, exact, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Const, two, 2, -1, -1, 2)
        half :: ir_slot(&g, exact, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.FloorDiv, half, x, two, IR_OVERFLOW_TRAP, 2)
        factor :: ir_slot(&g, exact, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Const, factor, 2, -1, -1, 2)
        twice :: ir_slot(&g, exact, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Mul, twice, half, factor, IR_OVERFLOW_TRAP, 2)
        _ := ir_emit(&g, IROp.Drop, -1, half, -1, -1, 2)
        same :: ir_slot(&g, flag, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Eq, same, twice, x, -1, 2)
        _ := ir_emit(&g, IROp.Drop, -1, twice, -1, -1, 2)
        _ := ir_emit(&g, IROp.Return, -1, same, -1, -1, 2)
        m.entry = 0
        name_rows_set(&m.function_rows, g.key, 0)
        &m.functions.push(g)
        options := ir_opt_options(level)
        options.verify = true
        report :: ir_optimize_module(&m, options, compiler_threads_single())
        assert_eq(report.lint.len(), 0)
        f :: m.functions[0]
        masks := 0
        loop at in 0..<f.op.len() {
            assert(f.op[at] != .Mul)
            if f.op[at] == .BitAnd && f.a[at] == x -> masks += 1
        }
        assert(masks > 0)
    }
}

// hyp(x, y) = (x*x + y*y) * sqrt(x*x + y*y) over Floats, the sum spelled
// twice: at O1 and O2 the second x*x, y*y and sum are the first ones, so
// three Muls and one Add are left, and IR Lint finds nothing after any pass.
#Test("A Float value computed again from the same operands is the first one") {
    loop level in 1..<3 {
        m := ir_module_new()
        float :: ir_type_row(&m, Type.Float) ?? panic("no Float row")
        g := ir_function_new("hyp", "test:hyp.jet::hyp", "", "hyp.jet", 1)
        x :: ir_slot(&g, float, IRSlotKind.Param, ir_intern_name(&m, "x"), 1)
        y :: ir_slot(&g, float, IRSlotKind.Param, ir_intern_name(&m, "y"), 1)
        g.result = float
        sums := [Int]{}
        loop _ in 0..<2 {
            xx :: ir_slot(&g, float, IRSlotKind.Temp, -1, 0)
            _ := ir_emit(&g, IROp.Mul, xx, x, x, -1, 2)
            yy :: ir_slot(&g, float, IRSlotKind.Temp, -1, 0)
            _ := ir_emit(&g, IROp.Mul, yy, y, y, -1, 2)
            sum :: ir_slot(&g, float, IRSlotKind.Temp, -1, 0)
            _ := ir_emit(&g, IROp.Add, sum, xx, yy, -1, 2)
            &sums.push(sum)
        }
        root :: ir_slot(&g, float, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Sqrt, root, sums[1], -1, -1, 2)
        out :: ir_slot(&g, float, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Mul, out, sums[0], root, -1, 2)
        _ := ir_emit(&g, IROp.Return, -1, out, -1, -1, 2)
        m.entry = 0
        name_rows_set(&m.function_rows, g.key, 0)
        &m.functions.push(g)
        options := ir_opt_options(level)
        options.verify = true
        report :: ir_optimize_module(&m, options, compiler_threads_single())
        assert_eq(report.lint.len(), 0)
        f :: m.functions[0]
        muls := 0
        adds := 0
        loop op in f.op {
            if op == .Mul -> muls += 1
            if op == .Add -> adds += 1
        }
        assert_eq(muls, 3)
        assert_eq(adds, 1)
    }
}

// `if p && q -> return 1; if p || q -> return 2; 0` as ir_short_circuit
// builds it: at O1 and O2 every branch tests p or q (or `not p`), no Bool
// copy is left, and IR Lint finds nothing after any pass.
#Test("A short-circuit Bool read only by a branch becomes branches on its operands") {
    loop level in 1..<3 {
        m := ir_module_new()
        exact :: ir_type_row(&m, Type.Int) ?? panic("no Int row")
        flag :: ir_type_row(&m, Type.Bool) ?? panic("no Bool row")
        g := ir_function_new("pick", "test:pick.jet::pick", "", "pick.jet", 1)
        p :: ir_slot(&g, flag, IRSlotKind.Param, ir_intern_name(&m, "p"), 1)
        q :: ir_slot(&g, flag, IRSlotKind.Param, ir_intern_name(&m, "q"), 1)
        g.result = exact
        both :: ir_slot(&g, flag, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Copy, both, p, -1, -1, 2)
        _ := ir_open_if(&g, p, 2)
        _ := ir_emit(&g, IROp.Copy, both, q, -1, -1, 2)
        ir_end(&g, 2)
        _ := ir_open_if(&g, both, 2)
        one :: ir_slot(&g, exact, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Const, one, 1, -1, -1, 2)
        _ := ir_emit(&g, IROp.Return, -1, one, -1, -1, 2)
        ir_end(&g, 2)
        either :: ir_slot(&g, flag, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Copy, either, p, -1, -1, 3)
        unset :: ir_slot(&g, flag, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Not, unset, p, -1, -1, 3)
        _ := ir_open_if(&g, unset, 3)
        _ := ir_emit(&g, IROp.Copy, either, q, -1, -1, 3)
        ir_end(&g, 3)
        _ := ir_open_if(&g, either, 3)
        two :: ir_slot(&g, exact, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Const, two, 2, -1, -1, 3)
        _ := ir_emit(&g, IROp.Return, -1, two, -1, -1, 3)
        ir_end(&g, 3)
        zero :: ir_slot(&g, exact, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Const, zero, 0, -1, -1, 4)
        _ := ir_emit(&g, IROp.Return, -1, zero, -1, -1, 4)
        m.entry = 0
        name_rows_set(&m.function_rows, g.key, 0)
        &m.functions.push(g)
        options := ir_opt_options(level)
        options.verify = true
        report :: ir_optimize_module(&m, options, compiler_threads_single())
        assert_eq(report.lint.len(), 0)
        assert_eq(report.short_circuits, 2)
        f :: m.functions[0]
        loop at in 0..<f.op.len() {
            assert(f.op[at] != .Copy && f.op[at] != .Move)
            if f.op[at] == .If || f.op[at] == .BrIf -> assert(f.a[at] != both && f.a[at] != either)
        }
    }
}

// copy(p, q, i) stores at p + i the word loaded from q + i and hands p + q
// with it to an `#FFI(asm)` leaf, all three sums computed first: at O1 and
// O2 each sum sits right before the access it addresses, and IR Lint finds
// nothing after any pass.
#Test("An address sum moves to just before the access it addresses") {
    loop level in 1..<3 {
        m := ir_module_new()
        word :: ir_type_row(&m, Type.IntN{signed: true, bits: 64}) ?? panic("no I64 row")
        g := ir_function_new("copy", "test:copy.jet::copy", "", "copy.jet", 1)
        p :: ir_slot(&g, word, IRSlotKind.Param, ir_intern_name(&m, "p"), 1)
        q :: ir_slot(&g, word, IRSlotKind.Param, ir_intern_name(&m, "q"), 1)
        i :: ir_slot(&g, word, IRSlotKind.Param, ir_intern_name(&m, "i"), 1)
        g.result = word
        target :: ir_slot(&g, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Add, target, p, i, IR_OVERFLOW_WRAP, 2)
        source :: ir_slot(&g, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Add, source, q, i, IR_OVERFLOW_WRAP, 2)
        both :: ir_slot(&g, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Add, both, p, q, IR_OVERFLOW_WRAP, 2)
        value :: ir_slot(&g, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&g, IROp.Load, value, source, 0, -1, 2)
        _ := ir_emit(&g, IROp.Store, -1, target, 0, value, 2)
        args :: ir_args(&g, [Int]{both, value})
        _ := ir_emit(&g, IROp.Call, -1, 1, args, 2, 3)
        _ := ir_emit(&g, IROp.Return, -1, value, -1, -1, 3)
        put := ir_function_new("put", "test:put#asm", "", "copy.jet", 1)
        _ := ir_slot(&put, word, IRSlotKind.Param, ir_intern_name(&m, "address"), 1)
        _ := ir_slot(&put, word, IRSlotKind.Param, ir_intern_name(&m, "value"), 1)
        put.asm = Val(IRAsmLeaf{code: [U8]{0x48, 0x89, 0x37}, regs: [Int]{X64_RDI, X64_RSI}, result: -1})
        m.entry = 0
        name_rows_set(&m.function_rows, g.key, 0)
        &m.functions.push(g)
        name_rows_set(&m.function_rows, put.key, 1)
        &m.functions.push(put)
        options := ir_opt_options(level)
        options.verify = true
        report :: ir_optimize_module(&m, options, compiler_threads_single())
        assert_eq(report.lint.len(), 0)
        f :: m.functions[0]
        accesses := 0
        loop at in 1..<f.op.len() {
            address :: if f.op[at] == .Load || f.op[at] == .Store -> f.a[at] else if f.op[at] == .Call -> f.args[f.b[at]] else -> -1
            if address >= 0 {
                assert(f.op[at - 1] == .Add && f.dst[at - 1] == address)
                accesses += 1
            }
        }
        assert_eq(accesses, 3)
    }
}
