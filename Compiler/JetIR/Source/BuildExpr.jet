// The IR builder's statements and expressions: function bodies, scopes and
// loops, calls, switches and patterns, carriers (`?`, `??`, returns),
// closures, constants and program stops (Build.jet holds the shared state).

use jet_foundation.[AccessConvention, Span, SymbolID, Type, TBinaryOp, TBinaryPatternPart, TBuiltinOp, TCallArg, TComptimeEnumArg, TComptimeField, TComptimeKey, TComptimeMapEntry, TComptimeValue, TDestructureBinding, TEnumArg, TEnumPayload, TExpr, TExprKind, TForInMethod, TFunc, TFuncKind, THandleOp, TIfCond, TLambda, TListSpreadPart, TLocal, TMatchArm, TMethodRef, TMixedArm, TNestedPattern, TNumericOp, TOrFallback, TPanicLoc, TPattern, TPatternBinding, TPatternShape, TRangeArm, TRequireKind, TStaticOwner, TStmt, TStrPart, TStructFieldValue, TTryConvert, TypeTupleField, measure_literal_value, tir_each_expr_child, tir_each_stmt_list_child, tir_generated_local, tir_user_local, type_carrier_identity]

fn ir_build_function(m: &IRModule, p: IRProgram, b: &IRBuilder, function: TFunc) Never! {
    b.line = function.line
    if function.generic_params.len() > 0 && m.subst_types.len() == 0 -> return ir_fail(&b, function.source_span, "generic function without type arguments")
    if function.foreign != None -> return ir_fail(&b, function.source_span, "foreign function")
    if p.intrinsics.get(function.key) != None -> return ir_fail(&b, function.source_span, "runtime intrinsic {function.name} is only called, never a function value")
    b.failure = function.failure_carrier
    if function.kind == {
        .TopLevel -> {}
        .Method(_, owner_type) | .TraitMethod(_, _, owner_type, _, _) -> {
            // An implementation's method is built for its concrete receiver
            // like an inherent one; a call naming it is a direct call.
            receiver :: ir_receiver_access(function.kind)
            if receiver != "static" {
                if ir_param_slot(&m, p, &b, owner_type, receiver == "write", receiver == "move", "self") == None -> return ir_fail(&b, function.source_span, "method receiver type {ir_type_name(owner_type)}")
            }
        }
    }
    loop param in function.params {
        if ir_param_slot(&m, p, &b, param.ty, param.convention == .Write, param.convention == .Move, param.local.name) == None -> return ir_fail(&b, param.span, "parameter type {ir_type_name(param.ty)}")
    }
    ir_arm_params(&m, p, &b, function)
    b.cells = ir_mutable_captures(function.body)
    ir_cell_params(&m, &b)
    b.plain = ir_plain_return(function) != None
    executable :: ir_executable_return(function)
    if executable == .Val(ret) {
        if !ir_unit_type(ret) && !ir_never_type(ret) {
            result_row :: ir_value_type(&m, p, ret) ?? return ir_fail(&b, function.source_span, "result type {ir_type_name(ret)}")
            b.f.result = result_row
        }
    }
    b.ret = executable
    ir_stmts(&m, p, &b, function.body)
    if ir_failed(b) -> return
    ir_return_fallthrough(&m, p, &b)
}

// A parameter (or receiver) slot bound to `name`: a write parameter of a
// non-aggregate type is the address of the caller's variable.
fn ir_param_slot(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, write: Bool, owned: Bool, name: String) -> Int? Never! {
    row :: ir_value_type(&m, p, ty) ?? return None
    if write && m.types[row].kind != .Aggregate {
        slot :: ir_new_slot(&b, ir_pointer_row(&m), IRSlotKind.Param, ir_intern_name(&m, name))
        &b.bindings.push(IRBinding{name: name, slot: slot, indirect: row})
        return Val(slot)
    }
    slot :: ir_new_slot(&b, row, IRSlotKind.Param, ir_intern_name(&m, name))
    &b.bindings.push(IRBinding{name: name, slot: slot, owned: owned && m.types[row].drop != "", write: write})
    Val(slot)
}

// The variables a body owns from its start close what they still own when
// the body ends: a move parameter and a move receiver, and the receiver of
// a type's own close method, which closes only its parts.
fn ir_arm_params(m: &IRModule, p: IRProgram, b: &IRBuilder, function: TFunc) Never! {
    receiver :: ir_receiver_access(function.kind)
    at := 0
    if receiver != "static" {
        if b.bindings.len() == 0 -> return
        self_slot :: b.bindings[0].slot
        own_close := false
        if function.name == "close" && b.bindings[0].indirect < 0 {
            row :: p.rows.get(function.key) ?? -1
            own_close = row >= 0 && ir_close_method(m, p, b.f.slot_type[self_slot]) == row
        }
        if own_close {
            ir_close_arm(&m, p, &b, self_slot, true, function.source_span)
        } else if receiver == "move" && b.bindings[0].indirect < 0 {
            ir_close_arm(&m, p, &b, self_slot, false, function.source_span)
        }
        at = 1
    }
    loop param in function.params {
        if at >= b.bindings.len() -> return
        slot :: b.bindings[at].slot
        indirect :: b.bindings[at].indirect
        at += 1
        if param.convention == .Move && indirect < 0 -> ir_close_arm(&m, p, &b, slot, false, param.span)
    }
}

// The parameters a closure of the body writes move into frame cells.
fn ir_cell_params(m: &IRModule, b: &IRBuilder) Never! {
    if b.cells.len() == 0 -> return
    loop index in 0..<b.bindings.len() {
        binding :: b.bindings[index]
        if binding.indirect >= 0 || !b.cells.contains(binding.name) -> next
        if ir_kind_of(m, b, binding.slot) == .Aggregate -> next
        _ :: ir_cell_binding(&m, &b, binding.name)
    }
}

// The names of the variables a closure in `body` captures to write.
fn ir_mutable_captures(body: [TStmt]) -> [String] Never! {
    names := [String]{}
    tir_each_stmt_list_child(body, (expression: TExpr) -> ir_collect_mutable_captures(expression, &names))
    names
}

fn ir_collect_mutable_captures(expression: TExpr, names: &[String]) Never! {
    if expression.kind == .Lambda(lambda) {
        loop name in lambda.capture_facts.mutable {
            if !names.contains(name) -> &names.push(name)
        }
    }
    tir_each_expr_child(expression, (child: TExpr) -> ir_collect_mutable_captures(child, &names))
}

// A top-level infallible function whose written failure set is empty
// (`T Never!`) returns its success value directly; its checked body and its
// call sites keep the `Result<T, Never>` carrier (codegen
// jet_codegen_plain_return).
fn ir_plain_return(function: TFunc) -> Type? Never! {
    if function.kind != .TopLevel -> return None
    if function.failure_carrier != .Infallible -> return None
    if function.foreign != None || function.gc_return || function.synthetic -> return None
    if function.body.len() > 0 {
        if function.body[0] == .ContractScope(_, _, _, _, _) -> return None
    }
    declared :: function.ret ?? return None
    success :: ir_never_carrier_success(declared) ?? return None
    if ir_never_type(success) -> return None
    Val(success)
}

// The type a call of `function` produces.
fn ir_executable_return(function: TFunc) -> Type? Never! {
    if ir_plain_return(function) == .Val(success) -> return Val(success)
    function.ret
}

// The end of a body: a Unit success of a Result carrier (or of a kept
// `Unit Never!` carrier) hands back `Ok(())`, a Unit function returns, and
// any other function cannot get here.
fn ir_return_fallthrough(m: &IRModule, p: IRProgram, b: &IRBuilder) Never! {
    // A diverging (`-> Never`) body cannot end (codegen terminates it
    // Unreachable).
    if b.failure == .Diverges(_) {
        ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
        return
    }
    if b.f.result < 0 {
        ir_return_slot(&m, p, &b, -1, Span{start: 0, end: 0})
        return
    }
    ret :: b.ret ?? Type.Named{name: "Unit"}
    if ir_untag(ret) == .Result(ok, _) {
        if ir_unit_type(ir_untag(ok)) {
            boxed :: ir_result_box(&m, p, &b, ret, true, -1)
            ir_return_slot(&m, p, &b, boxed, Span{start: 0, end: 0})
            return
        }
    }
    ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
}

// ---------------------------------------------------------------------------
// Statements.

fn ir_stmts(m: &IRModule, p: IRProgram, b: &IRBuilder, body: [TStmt]) Never! {
    // A block that leaves (return, break, next or a Never statement) never
    // reaches what follows it: there an outer variable keeps the ownership
    // it had before the block.
    states :: ir_own_states(b, if ir_stmts_leave(p, b, body) -> b.bindings.len() else -> 0)
    ir_scope_open(&b)
    loop statement in body {
        if ir_failed(b) -> break
        ir_stmt(&m, p, &b, statement)
    }
    ir_scope_close(&m, &b)
    ir_set_own_states(&b, states)
}

// Whether `body` always leaves through its last statement.
fn ir_stmts_leave(p: IRProgram, b: IRBuilder, body: [TStmt]) -> Bool Never! {
    index := body.len() - 1
    loop index >= 0 {
        if body[index] == {
            .Return(_, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> return true
            .ExprStmt(value, _) -> return ir_never_type(ir_ty(p, b, value))
            else -> return false
        }
    }
    false
}

fn ir_stmt(m: &IRModule, p: IRProgram, b: &IRBuilder, statement: TStmt) Never! {
    // An explicit move is taken by the statement that reads it.
    b.moving = -1
    if statement == {
        .Let(local, let_ty, init, _, _, span) -> {
            // `name := &place` binds an alias of the place, never a copy (codegen
            // Statements.jet TStmt.Let alias_place): a write borrow's edits reach
            // the owner. A range borrow keeps its View value below.
            if local.address_lifetime == None && local.persist_key == None && init.kind == .Borrow(borrowed, _) {
                if local.deref || !(borrowed.kind == .Slice(_, _, _, _, _)) -> return ir_bind_pin(&m, p, &b, local, init, span)
            }
            if local.deref || local.address_lifetime != None || local.persist_key != None -> return ir_fail(&b, span, "addressed or persistent binding")
            // A GC-promoted or automatic-root binding binds as a plain local
            // (codegen only marks the root, which Lower never reads); codegen
            // rejects a Resource wrapper outright.
            if let_ty == .Annotated(_, wrapper) {
            }
            init_ty :: ir_ty(p, b, init)
            if init.kind == .Uninit -> return ir_bind_uninit(&m, p, &b, local, init_ty, span)
            value :: ir_expr(&m, p, &b, init)
            if ir_failed(b) -> return
            if ir_unit_type(ir_ty(p, b, init)) || value < 0 {
                return
            }
            // A place sema proved stays unchanged while the binding lives
            // (TLocal.place_borrow) is read in place: the binding aliases its
            // value like a read pin and never owns it, so every use that hands
            // the value on copies it (ir_own). Only for a value that copies as
            // a share or a clone and never closes.
            if local.place_borrow && !b.fresh[value] && ir_place_borrow_type(&m, p, &b, value, span) {
                symbol :: if local.symbol_id == .Val(id) -> id.key else -> ""
                &b.bindings.push(IRBinding{name: local.name, slot: value, symbol: symbol})
                return
            }
            ir_bind_local(&m, p, &b, local, value)
            bound :: b.bindings[b.bindings.len() - 1].slot
            ir_close_arm(&m, p, &b, bound, false, span)
        }
        .Assign(place, op, value, line, span) -> {
            if line > 0 -> b.line = line
            if place == .Expr(target_place) {
                return ir_assign_place(&m, p, &b, target_place, op, value, span)
            }
            binding :: if place == {
                .Local(local) -> ir_lookup_local(b, local) ?? { return ir_fail(&b, span, "assignment to unknown local {local.name}") }
                .Expr(_) -> { return ir_fail(&b, span, "assignment place") }
            }
            right :: ir_expr(&m, p, &b, value)
            if ir_failed(b) -> return
            current :: ir_read_binding(&m, &b, binding)
            result := right
            if op == .Val(binary) {
                left_ty :: m.types[b.f.slot_type[current]].ty
                site :: b.line
                value_ty :: ir_ty(p, b, value)
                result = ir_binary(&m, p, &b, binary, false, site, left_ty, current, right, value_ty, span)
                ir_release(&m, &b, right)
                if ir_failed(b) -> return
            }
            if result < 0 -> return
            // The variable's old value ends here when it owns it (a write
            // parameter's or cell's holder owns the value behind the address).
            owned :: ir_own(&m, p, &b, result)
            if binding.write && ir_kind_of(m, b, binding.slot) == .Aggregate {
                // The caller's value is replaced in place: its old value
                // ends here, the new one's bytes move into its storage.
                if ir_has_drop(m, b, binding.slot) -> ir_emit(&b.f, IROp.Drop, -1, binding.slot, -1, -1, b.line)
                size :: m.types[b.f.slot_type[binding.slot]].size
                ir_emit(&b.f, IROp.CopyBytes, -1, binding.slot, owned, size, b.line)
                b.fresh[owned] = false
                return
            }
            // The right side may have moved the old value out (`x = f(^x)`,
            // `x = [T]{T{part: x}}`): only a value the variable still owns ends.
            still :: ir_owned_binding(b, binding.slot)
            if (still || binding.indirect >= 0) && ir_has_drop(m, b, current) {
                ir_emit(&b.f, IROp.Drop, -1, current, -1, -1, b.line)
            } else if ir_live_flag(b, binding.slot) >= 0 && ir_has_drop(m, b, current) {
                // Some paths moved it: the old value ends where it was kept.
                live :: ir_live_flag(b, binding.slot)
                ir_open_if(&b.f, live, b.line)
                ir_emit(&b.f, IROp.Drop, -1, current, -1, -1, b.line)
                ir_end(&b.f, b.line)
            }
            if binding.indirect >= 0 {
                ir_emit(&b.f, IROp.Store, -1, binding.slot, 0, owned, b.line)
                b.fresh[owned] = false
                return
            }
            // A variable that closes its value closes the old one first.
            ir_close_now(&b, binding.slot)
            if ir_kind_of(m, b, binding.slot) == .Aggregate {
                ir_assign_aggregate(&m, &b, binding.slot, owned, still)
            } else {
                ir_store(&m, p, &b, binding.slot, owned)
            }
            // The variable owns its new value again.
            if binding.owned -> ir_reown(&b, binding)
            ir_close_rearm(&b, binding.slot)
        }
        .ExprStmt(value, _) -> {
            result :: ir_expr(&m, p, &b, value)
            if ir_failed(b) -> return
            ir_release(&m, &b, result)
        }
        .Return(value, span) -> ir_return(&m, p, &b, value, span)
        .If(condition, then_body, else_body, _, span) -> {
            ir_scope_open(&b)
            named :: b.bindings.len()
            test :: ir_condition(&m, p, &b, condition, span)
            if ir_failed(b) -> return
            // The boxes the condition holds are hidden variables of the
            // If's scope (ir_hold); the paths start after them.
            mark :: b.bindings.len()
            // Each path starts from the ownership before the If; where they
            // meet ir_join_owned reconciles what each moved.
            before :: ir_own_states(b, mark)
            ir_open_condition(&m, p, &b, test)
            ir_stmts(&m, p, &b, then_body)
            then_states :: ir_own_states(b, mark)
            ir_truncate_bindings(&b, mark)
            ir_set_own_states(&b, before)
            else_leaves := false
            if else_body == .Val(otherwise) {
                ir_else(&b.f, b.line)
                ir_hide_condition_names(&b, named, mark)
                ir_stmts(&m, p, &b, otherwise)
                else_leaves = ir_stmts_leave(p, b, otherwise)
            }
            ir_end(&b.f, b.line)
            then_leaves :: ir_stmts_leave(p, b, then_body)
            ir_meet_paths(&m, &b, test, then_states, then_leaves, else_leaves)
            ir_scope_close(&m, &b)
        }
        .Loop(label, body, _) -> {
            exit :: ir_open(&b.f, IROp.Block, b.line)
            top :: ir_open(&b.f, IROp.Loop, b.line)
            &b.loops.push(IRLoopFrame{label: label, exit: exit, next: top, mark: b.bindings.len()})
            ir_stmts(&m, p, &b, body)
            _ :: &b.loops.pop()
            ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
            ir_end(&b.f, b.line)
            ir_end(&b.f, b.line)
        }
        .While(label, condition, body, span) -> {
            exit :: ir_open(&b.f, IROp.Block, b.line)
            top :: ir_open(&b.f, IROp.Loop, b.line)
            test :: ir_expr(&m, p, &b, condition)
            if ir_failed(b) -> return
            ir_exit_unless(&m, &b, test, exit)
            &b.loops.push(IRLoopFrame{label: label, exit: exit, next: top, mark: b.bindings.len()})
            ir_stmts(&m, p, &b, body)
            _ :: &b.loops.pop()
            ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
            ir_end(&b.f, b.line)
            ir_end(&b.f, b.line)
        }
        .ForRange(label, local, start, end, step, exclusive, body, _, span) -> ir_range_loop(&m, p, &b, label, local, start, end, step, exclusive, body, span)
        .Range(label, variable, source, start, end, step, exclusive, _, body, span) -> {
            if source == .Val(collection) -> return ir_range_value_loop(&m, p, &b, label, variable, collection, step, body, span)
            ir_range_loop(&m, p, &b, label, variable, start, end, step, exclusive, body, span)
        }
        .Break(label, span) -> {
            frame :: ir_loop_frame(b, label) ?? return ir_fail(&b, span, "break outside a loop")
            ir_tx_unwind_loop(&m, p, &b, frame.exit, span)
            ir_drop_bindings(&m, &b, frame.mark)
            depth :: ir_depth(b.f, frame.exit)
            ir_emit(&b.f, IROp.Br, -1, depth, -1, -1, b.line)
        }
        .Continue(label, span) -> {
            frame :: ir_loop_frame(b, label) ?? return ir_fail(&b, span, "next outside a loop")
            ir_tx_unwind_loop(&m, p, &b, frame.exit, span)
            ir_drop_bindings(&m, &b, frame.mark)
            depth :: ir_depth(b.f, frame.next)
            ir_emit(&b.f, IROp.Br, -1, depth, -1, -1, b.line)
        }
        .Inline(body, _) | .Region(body, _) -> ir_stmts(&m, p, &b, body)
        .Contract(contract) -> ir_contract(&m, p, &b, contract)
        .ContractScope(pre, body, post, result, span) -> ir_contract_scope(&m, p, &b, pre, body, post, result, span)
        .RefutableBind(pattern, init, fallback, span) -> ir_refutable_bind(&m, p, &b, pattern, init, fallback, span)
        .TupleDestructure(_, init, _, binds, span) | .StructDestructure(_, init, _, binds, span) -> ir_field_destructure(&m, p, &b, init, binds, span)
        .ListDestructure(_, init, count, line, elements, span) -> {
            if line > 0 -> b.line = line
            ir_list_destructure(&m, p, &b, init, count, elements, span)
        }
        .CountedLoop(label, init, condition, step, _, body, span) -> {
            ir_scope_open(&b)
            ir_stmt(&m, p, &b, init)
            if ir_failed(b) -> return
            exit :: ir_open(&b.f, IROp.Block, b.line)
            _ :: ir_open(&b.f, IROp.Loop, b.line)
            test :: ir_expr(&m, p, &b, condition)
            if ir_failed(b) -> return
            ir_exit_unless(&m, &b, test, exit)
            step_block :: ir_open(&b.f, IROp.Block, b.line)
            &b.loops.push(IRLoopFrame{label: label, exit: exit, next: step_block, mark: b.bindings.len()})
            ir_stmts(&m, p, &b, body)
            _ :: &b.loops.pop()
            ir_end(&b.f, b.line)
            if step == .Val(advance) -> ir_stmt(&m, p, &b, advance)
            ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
            ir_end(&b.f, b.line)
            ir_end(&b.f, b.line)
            ir_scope_close(&m, &b)
        }
        .TaskGroup(group, limit, body, span) -> ir_task_group(&m, p, &b, group, limit, body, span)
        .DeferClose(close, _, span) -> ir_defer_close(&m, p, &b, close, span)
        .BreakValue(label, value, span) -> {
            frame :: ir_loop_frame(b, label) ?? return ir_fail(&b, span, "break outside a loop")
            if frame.value < 0 -> return ir_fail(&b, span, "break with a value out of a statement loop")
            target_row :: b.f.slot_type[frame.value]
            slot :: ir_value_as(&m, p, &b, value, target_row, span)
            if ir_failed(b) -> return
            if slot >= 0 -> ir_store(&m, p, &b, frame.value, slot)
            ir_tx_unwind_loop(&m, p, &b, frame.exit, span)
            ir_drop_bindings(&m, &b, frame.mark)
            depth :: ir_depth(b.f, frame.exit)
            ir_emit(&b.f, IROp.Br, -1, depth, -1, -1, b.line)
        }
        .Match(subject, arms, _, span) -> ir_match(&m, p, &b, subject, arms, None, span)
        .EnumMatch(subject, arms, else_body, _, span) -> ir_match(&m, p, &b, subject, arms, else_body, span)
        .RangeSwitch(subject, arms, else_body, span) -> ir_range_switch(&m, p, &b, subject, arms, else_body, span)
        .ForIn(label, variable, variable_two, source, collection, step, method_kind, columnar, _, _, body, span) -> {
            // `loop c in s.chars()`: codegen streams the scalars
            // (MIRLoopSourceKind.Chars); the walk of the checked `s.chars()`
            // list visits the same Chars in the same order.
            chars :: method_kind == (Val(TForInMethod.Chars)) && ir_untag(ir_ty(p, b, collection)) == .List(_)
            file_lines :: method_kind == (Val(TForInMethod.LinesFile))
            lines :: file_lines || method_kind == (Val(TForInMethod.LinesStdin))
            received :: method_kind == (Val(TForInMethod.ChannelReceiver))
            if (method_kind != None && !chars && !lines && !received) || step != None || columnar -> return ir_fail(&b, span, "statement ForIn over a method, step or columns")
            // `loop line in handle.lines()` reads its source, the handle
            // (Sema sema_stmt_for_in_source); `collection` is the checked
            // `lines()` call, which has no function of its own.
            if lines -> return ir_lines_walk(&m, p, &b, label, variable, variable_two, source, file_lines, body, span)
            if received -> return ir_channel_walk(&m, p, &b, label, variable, variable_two, collection, body, span)
            if ir_iter_element(ir_subst(m, ir_ty(p, b, collection))) != None -> return ir_lazy_walk(&m, p, &b, label, variable, variable_two, collection, body, span)
            ir_list_walk(&m, p, &b, label, variable, variable_two, collection, body, span)
        }
        // Scopes whose markers lower to nothing outside a sentry build
        // (Lower lower_scope): their body runs as a plain scope.
        .DebugOnly(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Live(body, _) -> ir_stmts(&m, p, &b, body)
        // An `#Impure` body is a plain scope whose build host calls may
        // touch the ambient world (ir_host_method).
        .Impure(body, _) -> {
            b.impure += 1
            ir_stmts(&m, p, &b, body)
            b.impure -= 1
        }
        .MixedSwitch(subject, _, arms, else_body, span) -> ir_mixed_switch(&m, p, &b, subject, arms, else_body, span)
        .Reactive(_, span) -> ir_fail(&b, span, "statement Reactive")
        .Layout(_, _, _, span) -> ir_fail(&b, span, "statement Layout")
        .ContextBlock(_, _, span) -> ir_fail(&b, span, "statement ContextBlock")
        .Shield(body, _) -> ir_shield(&m, p, &b, body)
        // Test scope members (codegen jet_codegen_lower_scope_member): a
        // `.setup` body runs in the enclosing scope, so its bindings stay
        // visible after it; a `.measure` body runs as a plain scope (no
        // runtime action, Lower lower_test_scope_member). `.expect_fail`,
        // `.timeout` and `.skip` need the runtime's test scope rail.
        .ScopeMember(kind, body, span) -> {
            if kind == {
                .Setup -> {
                    loop inner in body {
                        if ir_failed(b) -> break
                        ir_stmt(&m, p, &b, inner)
                    }
                }
                .Measure -> ir_stmts(&m, p, &b, body)
                else -> ir_fail(&b, span, "statement ScopeMember")
            }
        }
        .Transact(handle, snapshots, stm, body, span) -> ir_transact(&m, p, &b, handle, snapshots, stm, body, span)
        .GCEdit(_, _, _, _, _, _, span) -> ir_fail(&b, span, "statement GCEdit")
    }
}

// `pattern :: init else { fallback }` (codegen
// jet_codegen_lower_refutable_bind): the fallback runs when the pattern
// misses; on a match the pattern's names stay bound after the statement.
fn ir_refutable_bind(m: &IRModule, p: IRProgram, b: &IRBuilder, pattern: TPattern, init: TExpr, fallback: [TStmt], span: Span) Never! {
    // The tested box lives as long as the names bound from it: a hidden
    // variable owns it (ir_hold), which the fallback's exit drops too.
    test :: ir_option_test(&m, p, &b, pattern.shape, init, span)
    if ir_failed(b) -> return
    pending :: b.pending
    b.pending = [IRPending]{}
    ir_open_if(&b.f, test, b.line)
    ir_else(&b.f, b.line)
    ir_stmts(&m, p, &b, fallback)
    ir_end(&b.f, b.line)
    b.pending = pending
    ir_bind_pending(&m, p, &b)
}

// A new variable `local` holding `value` (a Let's binding); a variable a
// closure writes lives in a frame cell from here on.
fn ir_bind_local(m: &IRModule, p: IRProgram, b: &IRBuilder, local: TLocal, value: Int) Never! {
    ty :: b.f.slot_type[value]
    slot :: ir_new_slot(&b, ty, IRSlotKind.Local, ir_intern_name(&m, local.name))
    ir_store(&m, p, &b, slot, value)
    symbol :: if local.symbol_id == .Val(id) -> id.key else -> ""
    &b.bindings.push(IRBinding{name: local.name, slot: slot, owned: ir_has_drop(m, b, slot), symbol: symbol})
    if b.cells.contains(local.name) && ir_kind_of(m, b, slot) != .Aggregate {
        _ :: ir_cell_binding(&m, &b, local.name)
    }
}

// Whether a read of the place in `slot` can stand for a copy of it: a value
// with no drop, an aggregate whose drop is its own glue (ir_own shares it),
// or a value with a runtime clone; never one that closes.
fn ir_place_borrow_type(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int, span: Span) -> Bool Never! {
    row :: b.f.slot_type[slot]
    if ir_close_glue(&m, p, &b, row, false, span) >= 0 || ir_failed(b) -> return false
    if m.types[row].drop == "" -> return true
    if m.types[row].kind == .Aggregate -> return m.types[row].drop == ir_drop_key(m, row)
    m.types[row].clone != ""
}

// The aggregate variable at `slot` takes the owned value `value` (an
// assignment): its bytes move into storage the variable keeps, never a
// rebind to `value`'s storage. That storage is a temporary's whose site can
// run again while the variable lives: in a loop, `x = f(x)` would hand the
// next call the variable's storage as both argument and result, and the drop
// of the old value would end the new one. A variable that still owns its
// value is overwritten in place (its old value has ended); one whose value
// moved out gets storage of its own here, as the moved value's storage may
// still be its new holder's.
fn ir_assign_aggregate(m: &IRModule, b: &IRBuilder, slot: Int, value: Int, owns: Bool) Never! {
    ir_close_disarm(&b, value)
    b.fresh[value] = false
    // `x = x` (or a block whose tail is `x`): the value is already in place.
    if value == slot -> return
    row :: m.types[b.f.slot_type[slot]]
    if !owns -> ir_emit(&b.f, IROp.StackAddress, slot, row.size, row.align, -1, b.line)
    ir_emit(&b.f, IROp.CopyBytes, -1, slot, value, row.size, b.line)
}

// A pinned borrowed argument or receiver (`pin = &place`, sema's
// evaluation-order pin): an alias of the place, as codegen's
// jet_codegen_lower_local_place binds it, which never owns the value. A
// read aliases the place's value; a write aliases an aggregate's storage.
fn ir_bind_pin(m: &IRModule, p: IRProgram, b: &IRBuilder, local: TLocal, init: TExpr, span: Span) Never! {
    init_ty :: ir_ty(p, b, init)
    access :: if init.kind == .Borrow(_, borrowed) -> borrowed else -> AccessConvention.Read
    value :: ir_expr(&m, p, &b, init)
    if ir_failed(b) || value < 0 -> return
    // A borrow of a temporary owns that temporary: the pin keeps it.
    if b.fresh[value] -> return ir_bind_local(&m, p, &b, local, value)
    if access != .Read && ir_kind_of(m, b, value) != .Aggregate {
        if local.deref -> return ir_fail(&b, span, "write pin of {ir_type_name(init_ty)}")
        // A user binding of `&box` (an Option or enum box, written through its
        // payload) aliases the box itself, which the place keeps owning.
        if ir_box_row(m, b.f.slot_type[value]) {
            value_row :: b.f.slot_type[value]
            alias_name :: ir_intern_name(&m, local.name)
            alias :: ir_new_slot(&b, value_row, IRSlotKind.Local, alias_name)
            ir_emit(&b.f, IROp.Move, alias, value, -1, -1, b.line)
            symbol :: if local.symbol_id == .Val(id) -> id.key else -> ""
            &b.bindings.push(IRBinding{name: local.name, slot: alias, symbol: symbol})
            return ir_close_arm(&m, p, &b, alias, false, span)
        }
        ir_bind_local(&m, p, &b, local, value)
        bound :: b.bindings[b.bindings.len() - 1].slot
        return ir_close_arm(&m, p, &b, bound, false, span)
    }
    symbol :: if local.symbol_id == .Val(id) -> id.key else -> ""
    &b.bindings.push(IRBinding{name: local.name, slot: value, symbol: symbol, write: access != .Read})
}

// `task.group(group) { .. }` (codegen jet_codegen_lower_task_group, Lower
// lower_task_group_new): `group` owns the runtime JetTaskGroup from
// JetTaskGroup.new() or .with_limit(limit); the block's end closes it
// (jet_rt_native_task_group_close joins its children), and its drop joins
// them on an early exit.
fn ir_task_group(m: &IRModule, p: IRProgram, b: &IRBuilder, group: TLocal, limit: TExpr?, body: [TStmt], span: Span) Never! {
    group_ty :: Type.Named{name: "Group"}
    row :: ir_value_type(&m, p, group_ty) ?? {
        _ :: ir_type_fail(&b, span, group_ty)
        return
    }
    args := [Int]{}
    symbol := "jet_rt_native_task_group_new"
    if limit == .Val(count) {
        operation :: TNumericOp.CheckedIntToFixed{host_kind: 3, line: b.line}
        converted :: ir_node(&b, Type.IntN{signed: true, bits: 64}, TExprKind.NumericMethod{receiver: count, operation: operation}, count.span)
        value :: ir_expr(&m, p, &b, converted)
        if ir_failed(b) || value < 0 -> return
        &args.push(value)
        symbol = "jet_rt_native_task_group_with_limit"
    }
    handle :: ir_runtime(&m, &b, symbol, args, row)
    ir_scope_open(&b)
    ir_bind_local(&m, p, &b, group, handle)
    binding :: ir_lookup_local(b, group) ?? return ir_fail(&b, span, "task group {group.name} without its binding")
    ir_stmts(&m, p, &b, body)
    if ir_failed(b) -> return
    _ :: ir_runtime(&m, &b, "jet_rt_native_task_group_close", [Int]{binding.slot}, -1)
    ir_scope_close(&m, &b)
}

// `task.all` / `task.any` / `task.race` over tasks (codegen
// jet_codegen_lower_task_group_value, Lower Tasks.jet:188 lower_task_group;
// `kind` 0 all, 1 any, 2 race as lower_task_kind): the runtime takes the
// owned List of Task handles (leaving an empty header). `all` joins them
// into the Result box's List payload, failing fast with a TaskFailure;
// `any` and `race` store the winner's result and cancel and drain the rest.
// A named tuple of Tasks joins into the tuple of their results (Lower
// lower_task_tuple_all); only `all` has a carrier for it.
fn ir_task_group_value(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, tasks: TExpr, kind: Int, span: Span) -> Int Never! {
    task_ty :: ir_ty(p, b, tasks)
    operation :: if {
        kind == 0 -> "task.all"
        kind == 1 -> "task.any"
        else -> "task.race"
    }
    result_ty :: ir_subst(m, ty)
    ok_ty := Type.Int
    err_ty := Type.Int
    if ir_untag(result_ty) == .Result(success, failure) {
        ok_ty = success
        err_ty = failure
    } else {
        return ir_fail_slot(&b, span, "{operation} result {ir_type_name(ty)}")
    }
    tasks_ty :: ir_untag(ir_subst(m, task_ty))
    if kind != 0 && tasks_ty == .Tuple(_) -> return ir_fail_slot(&b, span, "heterogeneous {operation} has no single success carrier")
    value :: ir_expr(&m, p, &b, tasks)
    if ir_failed(b) || value < 0 -> return -1
    if tasks_ty == .Tuple(fields) {
        if !b.fresh[value] -> return ir_fail_slot(&b, span, "task.all over a borrowed tuple")
        members :: ir_tuple_members(&m, p, fields) ?? return ir_fail_slot(&b, span, "task.all tuple {ir_type_name(task_ty)} has no layout")
        outputs := [IRMember]{}
        if ir_untag(ok_ty) == .Tuple(results) {
            outputs = ir_tuple_members(&m, p, results) ?? return ir_fail_slot(&b, span, "task.all tuple result {ir_type_name(ok_ty)} has no layout")
        }
        if outputs.len() != members.len() -> return ir_fail_slot(&b, span, "task.all tuple success arity does not match its handles")
        handles :: ir_out_slot(&m, &b, members.len())
        offsets :: ir_out_slot(&m, &b, members.len())
        loop (index, member) in members {
            target := -1
            loop output in outputs {
                if output.name == member.name -> target = output.offset
            }
            if target < 0 -> return ir_fail_slot(&b, span, "task.all tuple result has no member {member.name}")
            handle :: ir_load_word(&m, &b, value, member.offset)
            ir_emit(&b.f, IROp.Store, -1, handles, index * 8, handle, b.line)
            offset_word :: ir_word_const(&m, &b, target)
            ir_emit(&b.f, IROp.Store, -1, offsets, index * 8, offset_word, b.line)
        }
        b.fresh[value] = false
        count :: ir_word_const(&m, &b, members.len())
        mode :: ir_word_const(&m, &b, 0)
        return ir_task_outcome(&m, p, &b, "jet_rt_native_task_all_tuple", [Int]{handles, count, mode, offsets}, result_ty, err_ty, span)
    }
    element := Type.Int
    if tasks_ty == .List(inner) {
        element = inner
    } else {
        return ir_fail_slot(&b, span, "{operation} over {ir_type_name(task_ty)}")
    }
    body :: ir_task_element(element) ?? return ir_fail_slot(&b, span, "{operation} over task bodies {ir_type_name(element)}")
    body_meta :: ir_lazy_meta(&m, p, &b, body, span)
    if body_meta < 0 -> return -1
    ok_meta :: ir_lazy_meta(&m, p, &b, ok_ty, span)
    if ok_meta < 0 -> return -1
    group_kind :: ir_word_const(&m, &b, kind)
    zero :: ir_word_const(&m, &b, 0)
    boxed :: ir_task_outcome(&m, p, &b, "jet_rt_native_task_group", [Int]{group_kind, zero, value, zero, body_meta, zero, zero, ok_meta}, result_ty, err_ty, span)
    ir_release(&m, &b, value)
    boxed
}

// A runtime task outcome `export(args..., out) -> verdict` as a Result box
// whose payload `out` addresses (Lower Tasks.jet:264 lower_task_outcome): a
// failure's runtime record (TaskFailure) is rebuilt in its declared layout;
// a handle error stays the handle.
fn ir_task_outcome(m: &IRModule, p: IRProgram, b: &IRBuilder, export: String, args: [Int], result_ty: Type, err_ty: Type, span: Span) -> Int Never! {
    err_row :: ir_value_type(&m, p, err_ty) ?? return ir_type_fail(&b, span, err_ty)
    boxed :: ir_result_box(&m, p, &b, result_ty, true, -1)
    out :: ir_address_at(&m, &b, boxed, 8)
    call_args := args
    &call_args.push(out)
    word_row :: ir_word_row(&m)
    verdict :: ir_runtime(&m, &b, export, call_args, word_row)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, verdict, b.line)
    if !ir_is_handle(m, err_row) {
        zero :: ir_word_const(&m, &b, 0)
        failed :: ir_bool_op(&m, &b, IROp.Eq, verdict, zero)
        ir_open_if(&b.f, failed, b.line)
        ir_route_record_in(&m, p, &b, boxed, 8, err_ty, out, span)
        ir_end(&b.f, b.line)
    }
    b.fresh[boxed] = true
    boxed
}

// `name := T{ uninit }` (codegen InitializeUninit): the variable's storage
// without a value; checking proves every read follows a write. A scalar
// starts as zero; a fixed list `[T#N]{ uninit }` is the List of its N
// unwritten elements (Lower lower_initialize_uninit).
fn ir_bind_uninit(m: &IRModule, p: IRProgram, b: &IRBuilder, local: TLocal, ty: Type, span: Span) Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_fail(&b, span, "uninitialized {ir_type_name(ty)}")
    slot :: ir_new_slot(&b, row, IRSlotKind.Local, ir_intern_name(&m, local.name))
    size :: m.types[row].size
    align :: m.types[row].align
    if m.types[row].kind == .Aggregate {
        ir_emit(&b.f, IROp.StackAddress, slot, size, align, -1, b.line)
    } else {
        ir_emit(&b.f, IROp.Const, slot, 0, -1, -1, b.line)
    }
    if ir_untag(ty) == .FixedList(element, measure) {
        count :: measure_literal_value(measure) ?? return ir_fail(&b, span, "uninitialized {ir_type_name(ty)} without a literal length")
        element_row :: ir_value_type(&m, p, element) ?? return ir_fail(&b, span, "uninitialized {ir_type_name(ty)}")
        length :: ir_word_const(&m, &b, count)
        ir_emit(&b.f, IROp.Store, -1, slot, 0, length, b.line)
        ir_emit(&b.f, IROp.Store, -1, slot, 8, length, b.line)
        stride :: ir_list_stride(m, element_row)
        data :: if count == 0 -> ir_word_const(&m, &b, 0) else -> ir_list_buffer_alloc(&m, &b, count * stride)
        ir_emit(&b.f, IROp.Store, -1, slot, 16, data, b.line)
    }
    symbol :: if local.symbol_id == .Val(id) -> id.key else -> ""
    fixed :: ir_untag(ty) == .FixedList(_, _)
    &b.bindings.push(IRBinding{name: local.name, slot: slot, owned: fixed && ir_has_drop(m, b, slot), symbol: symbol})
    if b.cells.contains(local.name) && m.types[row].kind != .Aggregate {
        _ :: ir_cell_binding(&m, &b, local.name)
    }
}

// `(a, b) :: init` / `{x, y} :: init` (codegen
// jet_codegen_lower_field_destructure): each name binds its own copy of the
// field it names; a fresh subject ends after the copies.
fn ir_field_destructure(m: &IRModule, p: IRProgram, b: &IRBuilder, init: TExpr, binds: [TDestructureBinding], span: Span) Never! {
    init_ty :: ir_ty(p, b, init)
    subject :: ir_expr(&m, p, &b, init)
    if ir_failed(b) -> return
    if subject < 0 || ir_kind_of(m, b, subject) != .Aggregate -> return ir_fail(&b, span, "destructure of {ir_type_name(init_ty)}")
    loop binding in binds {
        member :: ir_member_of(&m, p, b, subject, binding.field) ?? return ir_fail(&b, span, "destructure field {binding.field} of {ir_type_name(init_ty)}")
        value :: ir_member_value(&m, &b, subject, member)
        if value >= 0 -> ir_bind_local(&m, p, &b, binding.local, value)
    }
    ir_release(&m, &b, subject)
}

// `[a, b] :: init` (codegen jet_codegen_lower_list_destructure): the first
// `count` names each bind a copy of the element at their position, after
// its bounds check.
fn ir_list_destructure(m: &IRModule, p: IRProgram, b: &IRBuilder, init: TExpr, count: Int, elements: [TLocal], span: Span) Never! {
    init_ty :: ir_ty(p, b, init)
    list :: ir_expr(&m, p, &b, init)
    if ir_failed(b) || list < 0 -> return
    row :: ir_list_element(&m, p, b, list) ?? return ir_fail(&b, span, "list destructure of {ir_type_name(init_ty)}")
    loop (index, local) in elements {
        if index >= count -> break
        position :: ir_word_const(&m, &b, index)
        address :: ir_checked_address(&m, &b, list, position, row)
        value :: ir_load_at(&m, &b, address, 0, row)
        if value >= 0 -> ir_bind_local(&m, p, &b, local, value)
    }
    ir_release(&m, &b, list)
}

// `receiver.field (op)= value` through the aggregate's storage, and
// `list[index] (op)= value` through the element's. The value comes first,
// then the place (codegen jet_codegen_lower_index_assign and its Assign
// lowering): a value that grows a List on the place's path, or keeps a copy
// of it, must not find the place's address or unique buffer already taken.
fn ir_assign_place(m: &IRModule, p: IRProgram, b: &IRBuilder, place: TExpr, op: TBinaryOp?, value: TExpr, span: Span) Never! {
    value_ty :: ir_ty(p, b, value)
    if place.kind == .Field(receiver, field) {
        right :: ir_expr(&m, p, &b, value)
        if ir_failed(b) -> return
        base :: ir_write_base(&m, p, &b, receiver, span)
        if ir_failed(b) -> return
        receiver_ty :: ir_ty(p, b, receiver)
        if base < 0 || ir_kind_of(m, b, base) != .Aggregate -> return ir_fail(&b, span, "assignment to a field of {ir_type_name(receiver_ty)}")
        member :: ir_member_of(&m, p, b, base, field.name) ?? return ir_fail(&b, span, "assignment to field {field.name}")
        result := right
        if op == .Val(binary) {
            current :: ir_member_read(&m, &b, base, member)
            site :: b.line
            result = ir_binary(&m, p, &b, binary, false, site, field.ty, current, right, value_ty, span)
            ir_release(&m, &b, right)
            if ir_failed(b) -> return
        }
        // A recursive edge's old value stays in its wrapper box, which copies
        // of the aggregate share; the write gives this one a new wrapper.
        if !member.boxed && m.types[member.ty].drop != "" {
            old :: ir_member_read(&m, &b, base, member)
            ir_emit(&b.f, IROp.Drop, -1, old, -1, -1, b.line)
        }
        glue :: ir_close_glue(&m, p, &b, member.ty, false, span)
        if glue >= 0 {
            old :: ir_member_value(&m, &b, base, member)
            ir_close_call(&b, glue, old)
        }
        ir_member_write(&m, p, &b, base, member, result)
        return
    }
    if place.kind == .Index(base, index, kind, _, _, _) {
        if kind == .Map -> return ir_map_index_assign(&m, p, &b, base, index, op, value, span)
        if kind != .List && kind != .FixedListProof -> return ir_fail(&b, span, "assignment to an index of kind {kind}")
        return ir_list_index_assign(&m, p, &b, base, index, op, value, false, span)
    }
    if place.kind == .Local(local) {
        if local.persist_key == .Val(key) -> return ir_storage_assign(&m, p, &b, key, op, value, span)
    }
    ir_fail(&b, span, "assignment to {ir_expr_kind_name(place.kind)} place")
}

// `storage (op)= value` for module storage `key` (Lower lower_static_walk):
// the value, then the read-modify-write through the storage cell.
fn ir_storage_assign(m: &IRModule, p: IRProgram, b: &IRBuilder, key: String, op: TBinaryOp?, value: TExpr, span: Span) Never! {
    value_ty :: ir_ty(p, b, value)
    definition :: p.constants.get(key) ?? return ir_fail(&b, span, "module storage {key} without a declaration")
    if !definition.is_storage -> return ir_fail(&b, span, "assignment to module constant {definition.name}")
    right :: ir_expr(&m, p, &b, value)
    if ir_failed(b) || right < 0 -> return
    address :: ir_storage_address(&m, p, &b, definition, span)
    if address < 0 -> return
    result := right
    if op == .Val(binary) {
        row :: ir_value_type(&m, p, definition.ty) ?? return ir_fail(&b, span, "module storage {definition.name} of {ir_type_name(definition.ty)}")
        current :: ir_load_at(&m, &b, address, 0, row)
        site :: b.line
        result = ir_binary(&m, p, &b, binary, false, site, definition.ty, current, right, value_ty, span)
        ir_release(&m, &b, right)
        if ir_failed(b) -> return
    }
    ir_store_at(&m, p, &b, address, 0, result)
}

fn ir_loop_frame(b: IRBuilder, label: String?) -> IRLoopFrame? Never! {
    index := b.loops.len() - 1
    loop index >= 0 {
        frame :: b.loops[index]
        if label == None || frame.label == label -> return Val(frame)
        index -= 1
    }
    None
}

// `loop i in start..end by step` (codegen jet_codegen_lower_numeric_range_loop
// over the runtime cursor, Collections.jet jet_loop_range_init /
// jet_loop_range_has_next): the bounds and step are evaluated once; a zero
// step stops the program; a positive step walks up to the end, a negative
// one down to it. A literal step fixes the direction; a computed one tests
// its sign each round. `next` leaves the body's Block to the step.
fn ir_range_loop(m: &IRModule, p: IRProgram, b: &IRBuilder, label: String?, local: TLocal, start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool, body: [TStmt], span: Span) Never! {
    start_ty :: ir_ty(p, b, start)
    end_ty :: ir_ty(p, b, end)
    if start_ty != Type.Int || end_ty != Type.Int -> return ir_fail(&b, span, "range loop over {ir_type_name(start_ty)}")
    first :: ir_expr(&m, p, &b, start)
    last :: ir_expr(&m, p, &b, end)
    if ir_failed(b) -> return
    by := -1
    descending := false
    // The step's sign when only the running program knows it.
    ascending := -1
    if step == .Val(stride) {
        stride_ty :: ir_ty(p, b, stride)
        if stride_ty != Type.Int -> return ir_fail(&b, span, "range loop step of {ir_type_name(stride_ty)}")
        literal := 0
        if stride.kind == .IntLit(value, _) -> literal = value
        if stride.kind == .Unary(op, operand) {
            if op != .Not && operand.kind == .IntLit(value, _) -> literal = -value
        }
        descending = literal < 0
        by = ir_expr(&m, p, &b, stride)
        if ir_failed(b) -> return
        if literal == 0 {
            zero :: ir_const_like(&m, &b, by, 0)
            stopped :: ir_bool_op(&m, &b, IROp.Eq, by, zero)
            ir_open_if(&b.f, stopped, b.line)
            message :: ir_static_text(&m, &b, "range loop stride must not be zero")
            _ :: ir_runtime(&m, &b, "jet_rt_panic_message", message, -1)
            ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
            ir_end(&b.f, b.line)
            ascending = ir_bool_op(&m, &b, IROp.Gt, by, zero)
        }
    } else {
        by = ir_temp_like(&m, &b, first)
        ir_emit(&b.f, IROp.Const, by, 1, -1, -1, b.line)
    }
    ir_scope_open(&b)
    counter_ty :: b.f.slot_type[first]
    counter :: ir_new_slot(&b, counter_ty, IRSlotKind.Local, ir_intern_name(&m, local.name))
    ir_emit(&b.f, IROp.Copy, counter, first, -1, -1, b.line)
    &b.bindings.push(IRBinding{name: local.name, slot: counter})
    exit :: ir_open(&b.f, IROp.Block, b.line)
    _ :: ir_open(&b.f, IROp.Loop, b.line)
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    test :: ir_temp(&m, &b, bool_row)
    up :: if exclusive -> IROp.Lt else -> IROp.Le
    down :: if exclusive -> IROp.Gt else -> IROp.Ge
    if ascending >= 0 {
        ir_open_if(&b.f, ascending, b.line)
        ir_emit(&b.f, up, test, counter, last, -1, b.line)
        ir_else(&b.f, b.line)
        ir_emit(&b.f, down, test, counter, last, -1, b.line)
        ir_end(&b.f, b.line)
    } else {
        ir_emit(&b.f, if descending -> down else -> up, test, counter, last, -1, b.line)
    }
    ir_exit_unless(&m, &b, test, exit)
    step_block :: ir_open(&b.f, IROp.Block, b.line)
    &b.loops.push(IRLoopFrame{label: label, exit: exit, next: step_block, mark: b.bindings.len()})
    ir_stmts(&m, p, &b, body)
    _ :: &b.loops.pop()
    ir_end(&b.f, b.line)
    ir_emit(&b.f, IROp.Add, counter, counter, by, IR_OVERFLOW_TRAP, b.line)
    ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    ir_scope_close(&m, &b)
}

// `loop n in band` over a Range value (Lower lower_range_cursor_init): the
// Ints from its `start` up to its `end`, the end included unless the value
// is `exclusive`.
fn ir_range_value_loop(m: &IRModule, p: IRProgram, b: &IRBuilder, label: String?, local: TLocal, collection: TExpr, step: TExpr?, body: [TStmt], span: Span) Never! {
    collection_ty :: ir_ty(p, b, collection)
    if step != None -> return ir_fail(&b, span, "stepped loop over a Range value")
    range :: ir_expr(&m, p, &b, collection)
    if ir_failed(b) || range < 0 -> return
    if ir_kind_of(m, b, range) != .Aggregate -> return ir_fail(&b, span, "range loop over {ir_type_name(collection_ty)}")
    start_member :: ir_member_of(&m, p, b, range, "start") ?? return ir_fail(&b, span, "range loop over {ir_type_name(collection_ty)}")
    end_member :: ir_member_of(&m, p, b, range, "end") ?? return ir_fail(&b, span, "range loop over {ir_type_name(collection_ty)}")
    exclusive_member :: ir_member_of(&m, p, b, range, "exclusive") ?? return ir_fail(&b, span, "range loop over {ir_type_name(collection_ty)}")
    first :: ir_member_value(&m, &b, range, start_member)
    last :: ir_member_value(&m, &b, range, end_member)
    exclusive :: ir_member_value(&m, &b, range, exclusive_member)
    if first < 0 || last < 0 || exclusive < 0 || ir_kind_of(m, b, first) != .Int || ir_kind_of(m, b, last) != .Int -> return ir_fail(&b, span, "range loop over {ir_type_name(collection_ty)}")
    // An inclusive end walks one further.
    bound :: ir_temp_like(&m, &b, last)
    ir_emit(&b.f, IROp.Copy, bound, last, -1, -1, b.line)
    inclusive :: ir_temp_like(&m, &b, exclusive)
    ir_emit(&b.f, IROp.Not, inclusive, exclusive, -1, -1, b.line)
    ir_open_if(&b.f, inclusive, b.line)
    one :: ir_const_like(&m, &b, last, 1)
    ir_emit(&b.f, IROp.Add, bound, bound, one, IR_OVERFLOW_TRAP, b.line)
    ir_end(&b.f, b.line)
    by :: ir_const_like(&m, &b, first, 1)
    ir_scope_open(&b)
    counter_ty :: b.f.slot_type[first]
    counter :: ir_new_slot(&b, counter_ty, IRSlotKind.Local, ir_intern_name(&m, local.name))
    ir_emit(&b.f, IROp.Copy, counter, first, -1, -1, b.line)
    &b.bindings.push(IRBinding{name: local.name, slot: counter})
    exit :: ir_open(&b.f, IROp.Block, b.line)
    _ :: ir_open(&b.f, IROp.Loop, b.line)
    more :: ir_bool_op(&m, &b, IROp.Lt, counter, bound)
    ir_exit_unless(&m, &b, more, exit)
    step_block :: ir_open(&b.f, IROp.Block, b.line)
    &b.loops.push(IRLoopFrame{label: label, exit: exit, next: step_block, mark: b.bindings.len()})
    ir_stmts(&m, p, &b, body)
    _ :: &b.loops.pop()
    ir_end(&b.f, b.line)
    ir_emit(&b.f, IROp.Add, counter, counter, by, IR_OVERFLOW_TRAP, b.line)
    ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    ir_scope_close(&m, &b)
    ir_release(&m, &b, range)
}

// A Bool slot holding an `if` condition.
fn ir_condition(m: &IRModule, p: IRProgram, b: &IRBuilder, condition: TIfCond, span: Span) -> Int Never! {
    if condition == {
        .Plain(value) -> return ir_expr(&m, p, &b, value)
        .And(left, right) -> {
            first :: ir_condition(&m, p, &b, left, span)
            if ir_failed(b) -> return -1
            result :: ir_temp_like(&m, &b, first)
            ir_emit(&b.f, IROp.Copy, result, first, -1, -1, b.line)
            ir_open_condition(&m, p, &b, first)
            bound :: b.bindings.len()
            second :: ir_condition(&m, p, &b, right, span)
            if ir_failed(b) -> return -1
            ir_emit(&b.f, IROp.Copy, result, second, -1, -1, b.line)
            // A box the second test holds (ir_hold) is null where the first
            // test failed, so its drop does nothing there.
            hidden := [Int]{}
            loop index in bound..<b.bindings.len() {
                binding :: b.bindings[index]
                if binding.name == "" && binding.owned && binding.indirect < 0 -> &hidden.push(binding.slot)
            }
            if hidden.len() > 0 {
                ir_else(&b.f, b.line)
                loop slot in hidden -> ir_emit(&b.f, IROp.Const, slot, 0, -1, -1, b.line)
            }
            ir_end(&b.f, b.line)
            return result
        }
        .IfLet(pattern, subject) -> return ir_option_test(&m, p, &b, pattern.shape, subject, span)
    }
    -1
}

// ---------------------------------------------------------------------------
// Expressions. Each returns the slot holding the value (-1 for Unit).

fn ir_expr(m: &IRModule, p: IRProgram, b: &IRBuilder, expression: TExpr) -> Int Never! {
    expression_ty :: ir_ty(p, b, expression)
    if ir_failed(b) -> return -1
    span :: expression.span
    if expression.kind == {
        .IntLit(value, _) -> {
            ty :: ir_value_type(&m, p, expression_ty) ?? return ir_type_fail(&b, span, expression_ty)
            return ir_int_constant(&m, &b, ty, value)
        }
        .BoolLit(value) -> {
            bool_row :: ir_type_row(&m, Type.Bool) ?? 0
            slot :: ir_temp(&m, &b, bool_row)
            ir_emit(&b.f, IROp.Const, slot, if value -> 1 else -> 0, -1, -1, b.line)
            return slot
        }
        .CharLit(value) -> {
            char_row :: ir_type_row(&m, Type.Char) ?? 0
            slot :: ir_temp(&m, &b, char_row)
            ir_emit(&b.f, IROp.Const, slot, value, -1, -1, b.line)
            return slot
        }
        .FloatLit(value) -> {
            ty :: ir_type_row(&m, expression_ty) ?? return ir_type_fail(&b, span, expression_ty)
            slot :: ir_temp(&m, &b, ty)
            ir_emit(&b.f, IROp.Const, slot, ir_float_constant_bits(value, expression_ty == Type.Float32), -1, -1, b.line)
            return slot
        }
        .StrLit(parts) -> return ir_string(&m, p, &b, parts, span)
        .Unit -> return -1
        .Local(local) -> {
            binding :: ir_lookup_local(b, local) ?? return ir_fail_slot(&b, span, "read of unknown local {local.name}")
            return ir_read_binding(&m, &b, binding)
        }
        .Move(value) -> {
            slot :: ir_expr(&m, p, &b, value)
            b.moving = slot
            return slot
        }
        .Drop(value) -> return ir_drop_value(&m, p, &b, value, span)
        .Close(value) -> return ir_close_value(&m, p, &b, expression_ty, value, span)
        .Print(value) -> {
            ir_print(&m, p, &b, value, span)
            return -1
        }
        .Binary(op, overflow, line, lhs, rhs) -> {
            if line > 0 -> b.line = line
            if op == .And || op == .Or -> return ir_short_circuit(&m, p, &b, op == .And, lhs, rhs)
            left :: ir_expr(&m, p, &b, lhs)
            right :: ir_expr(&m, p, &b, rhs)
            if ir_failed(b) -> return -1
            lhs_ty :: ir_ty(p, b, lhs)
            rhs_ty :: ir_ty(p, b, rhs)
            result :: ir_binary(&m, p, &b, op, overflow, line, lhs_ty, left, right, rhs_ty, span)
            ir_release(&m, &b, left)
            ir_release(&m, &b, right)
            return result
        }
        .CompareChain(operands, operators, hooks) -> return ir_compare_chain(&m, p, &b, operands, operators, hooks, span)
        .Unary(op, operand) -> {
            value :: ir_expr(&m, p, &b, operand)
            if ir_failed(b) -> return -1
            kind :: ir_kind_of(m, b, value)
            if op == .Not {
                if kind == .Int || kind == .Word {
                    // `bit_not` (Lower lower_unary): an exact Int is `-v - 1`,
                    // its bits xor -1; a fixed width flips only its own bits.
                    row :: b.f.slot_type[value]
                    signed :: m.types[row].signed
                    bits :: m.types[row].bits
                    ones :: ir_const_like(&m, &b, value, if kind == .Word && !signed -> ir_word_max(false, bits) else -> -1)
                    slot :: if kind == .Int -> ir_fresh_like(&m, &b, value) else -> ir_temp_like(&m, &b, value)
                    ir_emit(&b.f, IROp.BitXor, slot, value, ones, if kind == .Int -> IR_OVERFLOW_TRAP else -> IR_OVERFLOW_WRAP, b.line)
                    ir_release(&m, &b, value)
                    return slot
                }
                operand_ty :: ir_ty(p, b, operand)
                if kind != .Bool -> return ir_fail_slot(&b, span, "`!` on {ir_type_name(operand_ty)}")
                slot :: ir_temp_like(&m, &b, value)
                ir_emit(&b.f, IROp.Not, slot, value, -1, -1, b.line)
                return slot
            }
            if kind == .Word {
                // Fixed-width negation is the checked `0 - v` (Lower
                // lower_unary): it stops on signed MIN or a nonzero unsigned
                // operand with the subtraction's overflow message.
                zero :: ir_const_like(&m, &b, value, 0)
                slot :: ir_temp_like(&m, &b, value)
                ir_emit(&b.f, IROp.Sub, slot, zero, value, IR_OVERFLOW_TRAP, b.line)
                return slot
            }
            operand_type :: ir_ty(p, b, operand)
            if kind != .Int && kind != .Float && kind != .Float32 -> return ir_fail_slot(&b, span, "negation of {ir_type_name(operand_type)}")
            slot :: if kind == .Int -> ir_fresh_like(&m, &b, value) else -> ir_temp_like(&m, &b, value)
            ir_emit(&b.f, IROp.Neg, slot, value, -1, IR_OVERFLOW_TRAP, b.line)
            ir_release(&m, &b, value)
            return slot
        }
        .Call(callee, type_args, args) -> {
            return ir_call(&m, p, &b, callee.key, type_args, -1, [IRWriteBack]{}, args, span)
        }
        .MethodCall(receiver, method, type_args, args) -> {
            if ir_trait_receiver(m, p, ir_ty(p, b, receiver), method) -> return ir_trait_call(&m, p, &b, receiver, method, type_args, args, expression_ty, span)
            key :: ir_method_key(m, p, ir_ty(p, b, receiver), method)
            if type_args.len() > 0 && p.rows.get(key) == None -> return ir_fail_slot(&b, span, "generic method call outside the checked program")
            row :: p.rows.get(key) ?? return ir_fail_slot(&b, span, "method call outside the checked program: {method.name}")
            receiver_access :: ir_receiver_access(p.functions[row].kind)
            // A method of a generic type is built for the receiver's instance.
            receiver_ty :: ir_ty(p, b, receiver)
            all := ir_owner_args(p, p.functions[row], ir_subst(m, receiver_ty)) ?? return ir_fail_slot(&b, span, "method {method.name} on {ir_type_name(receiver_ty)}, which does not spell its owner's type arguments")
            loop arg in type_args -> &all.push(arg)
            if receiver_access == "static" {
                value :: ir_call(&m, p, &b, key, all, -1, [IRWriteBack]{}, args, span)
                return ir_trait_propagate(&m, p, &b, method, value, expression_ty, span)
            }
            backs := [IRWriteBack]{}
            self_slot :: if receiver_access == "write" -> ir_place_address(&m, p, &b, receiver, &backs, span) else -> ir_expr(&m, p, &b, receiver)
            if ir_failed(b) -> return -1
            if self_slot < 0 -> return ir_fail_slot(&b, span, "Unit receiver")
            value :: ir_call(&m, p, &b, key, all, self_slot, backs, args, span)
            return ir_trait_propagate(&m, p, &b, method, value, expression_ty, span)
        }
        .IfExpr(cond, then_body, then_value, else_body, else_value) -> {
            ir_scope_open(&b)
            named :: b.bindings.len()
            test :: ir_condition(&m, p, &b, cond, span)
            mark :: b.bindings.len()
            if ir_failed(b) -> return -1
            unit :: ir_unit_type(expression_ty) || ir_never_type(expression_ty)
            result := -1
            if !unit {
                ty :: ir_value_type(&m, p, expression_ty) ?? return ir_type_fail(&b, span, expression_ty)
                result = ir_temp(&m, &b, ty)
            }
            before :: ir_own_states(b, mark)
            ir_open_condition(&m, p, &b, test)
            ir_branch_value(&m, p, &b, then_body, then_value, result)
            then_states :: ir_own_states(b, mark)
            ir_else(&b.f, b.line)
            ir_truncate_bindings(&b, mark)
            ir_hide_condition_names(&b, named, mark)
            ir_set_own_states(&b, before)
            ir_branch_value(&m, p, &b, else_body, else_value, result)
            ir_end(&b.f, b.line)
            then_leaves :: ir_stmts_leave(p, b, then_body) || ir_never_type(ir_ty(p, b, then_value))
            else_leaves :: ir_stmts_leave(p, b, else_body) || ir_never_type(ir_ty(p, b, else_value))
            ir_meet_paths(&m, &b, test, then_states, then_leaves, else_leaves)
            ir_scope_close(&m, &b)
            if result >= 0 -> b.fresh[result] = ir_has_drop(m, b, result)
            return result
        }
        .InlineBlock(body) -> {
            if ir_unit_type(expression_ty) || body.len() == 0 {
                ir_stmts(&m, p, &b, body)
                return -1
            }
            // A valued block: its statements, then its last expression's value.
            ir_scope_open(&b)
            loop index in 0..<(body.len() - 1) {
                if ir_failed(b) -> break
                ir_stmt(&m, p, &b, body[index])
            }
            value := -1
            if body[body.len() - 1] == .ExprStmt(tail, _) {
                // The value outlives the block's variables: a variable it
                // moves out of no longer closes it at the block's end.
                tail_value :: ir_expr(&m, p, &b, tail)
                ir_close_disarm(&b, tail_value)
                value = ir_own(&m, p, &b, tail_value)
            } else if body[body.len() - 1] == .Loop(label, loop_body, _) {
                value = ir_loop_value(&m, p, &b, expression_ty, label, loop_body, span)
            } else {
                ir_stmt(&m, p, &b, body[body.len() - 1])
            }
            ir_scope_close(&m, &b)
            return value
        }
        .ExplicitCopy(value) | .Clone(value, _) -> {
            slot :: ir_expr(&m, p, &b, value)
            if ir_failed(b) || slot < 0 -> return slot
            return ir_copy_value(&m, p, &b, slot, span)
        }
        .MaterializeView(value) -> return ir_materialize_view(&m, p, &b, expression_ty, value, span)
        .StructLit(fields) -> {
            if ir_default_err(p, expression_ty) -> return ir_default_err_literal(&m, p, &b, expression_ty, fields, span)
            ty :: ir_value_type(&m, p, expression_ty) ?? return ir_type_fail(&b, span, expression_ty)
            if ir_word_record(m, p, ty) == .Val(record) {
                if fields.len() != 1 || fields[0].field.name != record.field -> return ir_fail_slot(&b, span, "struct literal of {ir_type_name(expression_ty)}")
                value :: ir_expr(&m, p, &b, fields[0].value)
                if ir_failed(b) -> return -1
                if value < 0 || ir_kind_of(m, b, value) != .Int -> return ir_fail_slot(&b, span, "struct literal of {ir_type_name(expression_ty)}")
                return ir_word_record_new(&m, &b, record, value, ty)
            }
            if m.types[ty].kind != .Aggregate -> return ir_fail_slot(&b, span, "struct literal of {ir_type_name(expression_ty)}")
            storage :: ir_fresh_temp(&m, &b, ty)
            ir_emit(&b.f, IROp.StackAddress, storage, m.types[ty].size, 8, -1, b.line)
            loop field in fields {
                member :: ir_member_of(&m, p, b, storage, field.field.name) ?? return ir_fail_slot(&b, span, "struct field {field.field.name}")
                // A member of a field's structural union is boxed as that
                // union (codegen widens the checked field value the same way).
                value :: ir_value_as(&m, p, &b, field.value, member.ty, span)
                if ir_failed(b) -> return -1
                if value < 0 -> return ir_fail_slot(&b, span, "Unit struct field")
                ir_member_write(&m, p, &b, storage, member, value)
            }
            return storage
        }
        .Field(receiver, field) -> {
            if ir_default_err(p, ir_ty(p, b, receiver)) -> return ir_default_err_field(&m, p, &b, expression_ty, receiver, field.name, span)
            base :: ir_expr(&m, p, &b, receiver)
            if ir_failed(b) -> return -1
            if base >= 0 && ir_kind_of(m, b, base) == .Pointer {
                if ir_process_member(&m, p, ir_ty(p, b, receiver), field.name) == .Val(member) -> return ir_member_read(&m, &b, base, member)
                if ir_word_record(m, p, b.f.slot_type[base]) == .Val(record) {
                    if record.field == field.name {
                        int_row :: ir_value_type(&m, p, expression_ty) ?? return ir_type_fail(&b, span, expression_ty)
                        exact :: ir_runtime(&m, &b, record.getter, [Int]{base}, int_row)
                        ir_release(&m, &b, base)
                        return exact
                    }
                }
                receiver_ty :: ir_ty(p, b, receiver)
                lent :: ir_handle_field(&m, p, &b, receiver_ty, base, field.name, expression_ty, span)
                if lent != -2 -> return lent
            }
            receiver_type :: ir_ty(p, b, receiver)
            if base >= 0 && ir_host_value_row(m, p, b.f.slot_type[base]) != None -> return ir_host_field(&m, p, &b, expression_ty, base, field.name, span)
            if base < 0 || ir_kind_of(m, b, base) != .Aggregate -> return ir_fail_slot(&b, span, "field of {ir_type_name(receiver_type)}")
            member :: ir_member_of(&m, p, b, base, field.name) ?? return ir_fail_slot(&b, span, "field {field.name} of {ir_type_name(receiver_type)}")
            return ir_member_read(&m, &b, base, member)
        }
        .SharedGuardValue(guard) -> return ir_shared_guard_value(&m, p, &b, expression_ty, guard, span)
        .HostCall(call) -> {
            if call == .SwitchSubjectValue {
                subject :: if b.subjects.len() > 0 -> b.subjects[b.subjects.len() - 1] else -> -1
                if subject < 0 -> return ir_fail_slot(&b, span, "switch subject outside a switch")
                return subject
            }
            if call == .ComptimeInput(builtin, path) {
                // A comptime input (embed_file, embed_bytes, find) the checked
                // program names by its literal; the evaluator answers it.
                row :: ir_value_type(&m, p, expression_ty) ?? return ir_type_fail(&b, span, expression_ty)
                string_row :: ir_string_row(&m)
                builtin_text :: ir_temp(&m, &b, string_row)
                ir_emit(&b.f, IROp.ConstText, builtin_text, ir_intern_text(&m, builtin), -1, -1, b.line)
                path_text :: ir_temp(&m, &b, string_row)
                ir_emit(&b.f, IROp.ConstText, path_text, ir_intern_text(&m, path), -1, -1, b.line)
                return ir_runtime(&m, &b, "jet_comptime_input", [Int]{builtin_text, path_text}, row)
            }
            if call == .TupleIndex(base, index) {
                tuple :: ir_expr(&m, p, &b, base)
                if ir_failed(b) -> return -1
                base_ty :: ir_ty(p, b, base)
                fields :: if ir_untag(ir_subst(m, base_ty)) == .Tuple(fields) -> fields else -> { return ir_fail_slot(&b, span, "tuple index of {ir_type_name(base_ty)}") }
                members :: ir_tuple_members(&m, p, fields) ?? return ir_type_fail(&b, span, base_ty)
                if tuple < 0 || index < 0 || index >= members.len() -> return ir_fail_slot(&b, span, "tuple index {index} of {ir_type_name(base_ty)}")
                return ir_member_read(&m, &b, tuple, members[index])
            }
            if call == .NumericBounds(bound_ty, member) -> return ir_numeric_bound(&m, &b, expression_ty, bound_ty, member, span)
            if call == .Method(receiver, method, args) {
                if ir_untag(ir_subst(m, ir_ty(p, b, receiver))) == .Shared(_) {
                    if (method == "guard_read" || method == "guard_edit") && args.len() == 0 -> return ir_shared_guard(&m, p, &b, expression_ty, receiver, method == "guard_edit", span)
                    if method == "shared.read" -> return ir_shared_read(&m, p, &b, expression_ty, receiver, args, span)
                    if method == "same" && args.len() == 1 -> return ir_shared_same(&m, p, &b, receiver, args[0], span)
                }
                host_receiver_ty :: ir_ty(p, b, receiver)
                receiver_row :: ir_value_type(&m, p, host_receiver_ty) ?? return ir_type_fail(&b, span, host_receiver_ty)
                if ir_host_value_row(m, p, receiver_row) == .Val(owner) -> return ir_host_method(&m, p, &b, expression_ty, owner, method, receiver, args, span)
            }
            return ir_fail_slot(&b, span, "host call {ir_host_call_name(call)}")
        }
        .PreciseBuiltin(type_name, function, args) -> return ir_precise_builtin(&m, p, &b, expression_ty, type_name, function, args, span)
        .EnumLit(enum_type, variant, payload) -> return ir_enum_value(&m, p, &b, expression_ty, enum_type, variant, payload, span)
        .EnumCtor(owner, variant, payload) -> return ir_enum_value(&m, p, &b, expression_ty, owner.key, variant.key, payload, span)
        .JSONLit(variant, argument, _) -> return ir_json_literal(&m, p, &b, expression_ty, variant, argument, span)
        .Present(value) -> return ir_present(&m, p, &b, expression_ty, value, span)
        .Absent -> {
            row :: ir_value_type(&m, p, expression_ty) ?? return ir_type_fail(&b, span, expression_ty)
            slot :: ir_temp(&m, &b, row)
            ir_emit(&b.f, IROp.Const, slot, 0, -1, -1, b.line)
            return slot
        }
        .Ok(value) -> return ir_result_ctor(&m, p, &b, expression_ty, value, true, span)
        .Err(value) -> return ir_result_ctor(&m, p, &b, expression_ty, value, false, span)
        .Try(value, conversion, _) -> return ir_try(&m, p, &b, value, conversion, None, span)
        .TryWithContext(inner, note, conversion, file, line, function) -> {
            fresh :: ir_try_starts_failure(p, b, inner)
            return ir_try(&m, p, &b, inner, conversion, Val(IRTrySite{note: note, file: file, line: line, function: function, fresh: fresh}), span)
        }
        .OrFallback(value, fallback, ambient) -> return ir_or_fallback(&m, p, &b, expression_ty, value, fallback, ambient, span)
        .ConstRef(symbol) -> return ir_constant(&m, p, &b, expression_ty, symbol.key, span)
        .CtLit(value) -> return ir_comptime(&m, p, &b, expression_ty, value, span)
        .ListLit(values) -> return ir_list_literal(&m, p, &b, expression_ty, values, span)
        .List(values, coercion) -> {
            if coercion == .Val(target) {
                boxed :: ir_trait_boxes(&b, values, target)
                return ir_list_literal(&m, p, &b, expression_ty, boxed, span)
            }
            return ir_list_literal(&m, p, &b, expression_ty, values, span)
        }
        .BuiltinMethod(receiver, operation, args) -> return ir_builtin(&m, p, &b, expression_ty, receiver, operation, args, span)
        .RequireStop(kind, location, always_stops) -> return ir_require_stop(&m, p, &b, kind, location, always_stops, span)
        .ClosureMethod(receiver, operation, args) -> return ir_closure_method(&m, p, &b, expression_ty, receiver, operation, args, span)
        .Index(base, index, kind, _, _, _) -> {
            if kind == .Map -> return ir_map_index(&m, p, &b, base, index, span)
            if kind != .List && kind != .FixedListProof -> return ir_fail_slot(&b, span, "index of kind {kind}")
            return ir_list_index(&m, p, &b, base, index, span)
        }
        .Lambda(value) -> return ir_lambda(&m, p, &b, expression_ty, value, span)
        .FnValue(kind) -> return ir_fn_value(&m, p, &b, expression_ty, kind, span)
        .IndirectCall(callee, type_args, args, signature) -> {
            if type_args.len() > 0 -> return ir_fail_slot(&b, span, "generic indirect call")
            return ir_indirect_call(&m, p, &b, callee, args, signature, span)
        }
        .Tuple(values) -> {
            names := [String]{}
            loop index in 0..<values.len() -> &names.push("{index}")
            return ir_tuple_literal(&m, p, &b, expression_ty, names, values, span)
        }
        .CoreCall(record, args, _, type_args, widen_to_vec, _) -> return ir_core_call(&m, p, &b, expression_ty, record, args, type_args, widen_to_vec, span)
        .NumericMethod(receiver, operation) -> return ir_numeric_method(&m, p, &b, expression_ty, receiver, operation, span)
        .Never(reason) -> {
            // codegen jet_codegen_lower_never: Lower stops through jet_rt_unreachable.
            message :: ir_static_text(&m, &b, reason)
            _ :: ir_runtime(&m, &b, "jet_rt_unreachable", message, -1)
            ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
            return ir_unreachable_value(&m, p, &b, expression_ty)
        }
        .PatternMatches(subject, pattern) -> {
            // A test only (codegen lowers the pattern condition without binding).
            pending :: b.pending.len()
            bound :: b.bindings.len()
            test :: ir_option_test(&m, p, &b, pattern.shape, subject, span)
            loop b.pending.len() > pending {
                _ :: &b.pending.pop()
            }
            ir_drop_bindings(&m, &b, bound)
            ir_truncate_bindings(&b, bound)
            return test
        }
        .StaticCall(owner, owner_type, method, type_args, args) -> return ir_static_call(&m, p, &b, expression_ty, owner, owner_type, method, type_args, args, span)
        .Map(entries) | .MapLit(entries) -> return ir_map_literal(&m, p, &b, expression_ty, entries, span)
        .OptField(base, member, flatten) -> return ir_optional_field(&m, p, &b, expression_ty, base, member, flatten, span)
        .OptMethodCall(base, binding, call, flatten) -> return ir_optional_call(&m, p, &b, expression_ty, base, binding, call, flatten, span)
        .ListSpread(parts) -> return ir_list_spread(&m, p, &b, expression_ty, parts, span)
        .Slice(base, start, end, range, location) -> return ir_slice(&m, p, &b, expression_ty, base, start, end, range, location, span)
        .Range(start, end, exclusive) -> return ir_range_value(&m, p, &b, expression_ty, start, end, exclusive, span)
        .Borrow(value, access) -> return ir_borrow(&m, p, &b, expression_ty, value, access, span)
        .OverflowOpt(prefix, operation, line, lhs, rhs) -> return ir_overflow_opt(&m, p, &b, expression_ty, prefix, operation, line, lhs, rhs, span)
        .NumericBinaryMethod(receiver, operation, argument) -> return ir_numeric_euclid(&m, p, &b, expression_ty, receiver, operation, argument, span)
        .HandleMethod(receiver, operation, args) -> return ir_handle_method(&m, p, &b, expression_ty, receiver, operation, args, span)
        .CoreClosureCall(kind) -> return ir_core_closure_call(&m, p, &b, expression_ty, kind, span)
        .SelectWait(table, nonblocking) -> return ir_select_wait(&m, p, &b, expression_ty, table, nonblocking, span)
        .OptionLift2(function, left, right) -> return ir_option_lift2(&m, p, &b, expression_ty, function, left, right, span)
        .TaskGroupAll(tasks) -> return ir_task_group_value(&m, p, &b, expression_ty, tasks, 0, span)
        .TaskGroupAny(tasks) -> return ir_task_group_value(&m, p, &b, expression_ty, tasks, 1, span)
        .TaskGroupRace(tasks) -> return ir_task_group_value(&m, p, &b, expression_ty, tasks, 2, span)
        .TraitBox(value, target) -> return ir_trait_box(&m, p, &b, value, target, span)
        // A distinct value lays out as its base, so construction and raw
        // extraction are the value itself (codegen: a Transparent convert).
        .DistinctCtor(argument) | .DistinctRaw(argument) -> return ir_expr(&m, p, &b, argument)
        .DistinctConvert(_, argument, operation, range, fallible) -> return ir_distinct_convert(&m, p, &b, expression_ty, argument, operation, range, fallible, span)
        else -> return ir_fail_slot(&b, span, "expression {ir_expr_kind_name(expression.kind)}")
    }
}

// `consume(x)` (codegen: a Drop of `^x`, a move to nowhere): the value's
// cleanup runs now. An owned variable's binding stops owning it, so its
// scope-end drop does not run a second time; a fresh value drops in place.
// A payload binding's value ends with its carrier box's last owner.
fn ir_drop_value(m: &IRModule, p: IRProgram, b: &IRBuilder, value: TExpr, span: Span) -> Int Never! {
    value_ty :: ir_ty(p, b, value)
    if value.kind == .Local(local) {
        binding :: ir_lookup_local(b, local) ?? return ir_fail_slot(&b, span, "drop of unknown local {local.name}")
        if binding.indirect < 0 && ir_closes(b, binding.slot) {
            // A value that closes closes now, and its scope no longer closes it.
            ir_close_now(&b, binding.slot)
            ir_close_disarm(&b, binding.slot)
        }
        if !ir_has_drop(m, b, binding.slot) && binding.indirect < 0 -> return -1
        if !binding.owned && binding.indirect < 0 && ir_payload_binding(m, b, binding.carrier) {
            // The carrier box drops a payload it holds with its last owner;
            // one only a reader drops (a handle) moves out and ends here.
            if !ir_glue_drops(m, b.f.slot_type[binding.slot]) -> ir_emit(&b.f, IROp.Drop, -1, binding.slot, -1, -1, b.line)
            return -1
        }
        if !binding.owned || binding.indirect >= 0 -> return ir_fail_slot(&b, span, "drop of {local.name}, which the function does not own")
        ir_drop_binding(&m, &b, binding)
        loop index in 0..<b.bindings.len() {
            if b.bindings[index].slot == binding.slot {
                b.bindings[index] = IRBinding{name: binding.name.copy(), slot: binding.slot, indirect: binding.indirect, owned: false, symbol: binding.symbol.copy()}
            }
        }
        return -1
    }
    slot :: ir_expr(&m, p, &b, value)
    if ir_failed(b) || slot < 0 || !ir_has_drop(m, b, slot) -> return -1
    if !b.fresh[slot] -> return ir_fail_slot(&b, span, "drop of a held {ir_type_name(value_ty)}")
    ir_emit(&b.f, IROp.Drop, -1, slot, -1, -1, b.line)
    b.fresh[slot] = false
    return -1
}

// Whether a binding read from carrier `carrier` is a payload of a counted
// box (an Option, Result, union or payload enum box).
fn ir_payload_binding(m: IRModule, b: IRBuilder, carrier: Int) -> Bool Never! {
    carrier >= 0 && ir_box_row(m, b.f.slot_type[carrier])
}

// `close(^x)` (codegen jet_codegen_lower_close): a Core file owner, an
// arena or a handle closes by its drop; a type's own Close method runs
// through the variable's close glue, which its scope then no longer runs.
// Either way it is `consume(x)` with a Unit result.
fn ir_close_value(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, inner: TExpr, span: Span) -> Int Never! {
    if !ir_unit_type(ty) -> return ir_fail_slot(&b, span, "close with a {ir_type_name(ty)} result")
    name :: ir_nominal_name(ir_untag(ir_subst(m, ir_ty(p, b, inner)))) ?? ""
    if name == "DBLease" || name == "DBConnection" || name == "DBScope" -> return ir_fail_slot(&b, span, "close of {name}")
    value :: if inner.kind == .Move(moved) -> moved else -> inner
    ir_drop_value(&m, p, &b, value, span)
}

// `defer close(^x)` (codegen jet_codegen_register_defer_close): the
// resource closes at every exit of its scope. A variable whose value closes
// is armed to close there from its binding on, so the defer arms it only
// when its binding did not.
fn ir_defer_close(m: &IRModule, p: IRProgram, b: &IRBuilder, close: TExpr, span: Span) Never! {
    inner :: if close.kind == .Close(value) -> value else -> { return ir_fail(&b, span, "deferred {ir_expr_kind_name(close.kind)}") }
    resource :: if inner.kind == .Move(moved) -> moved else -> inner
    local :: if resource.kind == .Local(named) -> named else -> { return ir_fail(&b, span, "deferred close of {ir_expr_kind_name(resource.kind)}") }
    binding :: ir_lookup_local(b, local) ?? return ir_fail(&b, span, "deferred close of unknown local {local.name}")
    if binding.indirect >= 0 -> return ir_fail(&b, span, "deferred close of the write parameter {local.name}")
    if !ir_closes(b, binding.slot) -> ir_close_arm(&m, p, &b, binding.slot, false, span)
    if ir_failed(b) || ir_closes(b, binding.slot) -> return
    // Nothing in the value has a Close method: its drop at the scope end
    // is the close (a Core file owner or a handle).
    if !ir_has_drop(m, b, binding.slot) -> ir_fail(&b, span, "deferred close of {local.name}, which neither closes nor drops")
}

// A runtime-handle method (codegen jet_codegen_lower_general_handle_method,
// Lower's HandleMethod route call): the receiver then the arguments cross
// the operation's closed Prelude route; a static constructor (`Path.from`)
// passes its arguments only. Forms codegen or Lower lower specially (Task,
// channel and Transaction handles, the native Dyn tree, HTTP, Serde, DB,
// ...) and closure, mutating or frame-scheduled forms are not built here.
fn ir_handle_method(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: TExpr, operation: THandleOp, args: [TExpr], span: Span) -> Int Never! {
    if operation == .TaskDetach -> return ir_task_detach(&m, p, &b, receiver, span)
    if operation == .TaskJoin -> return ir_task_join(&m, p, &b, ty, receiver, span)
    if operation == .DynLen(site, location) -> return ir_dyn_len(&m, p, &b, ty, receiver, site, location, span)
    if ir_dyn_method(&m, p, &b, ty, receiver, operation, args, span) == .Val(result) -> return result
    if ir_channel_method(&m, p, &b, ty, receiver, operation, args, span) == .Val(result) -> return result
    if ir_event_method(&m, p, &b, ty, receiver, operation, args, span) == .Val(result) -> return result
    if operation == .SerdeEncode -> return ir_serde_encode(&m, p, &b, ty, receiver, span)
    dedicated :: if operation == {
        .Hardware(_) | .CursorTakePattern(_, _) | .ReaderTakePattern(_, _) | .EmailMethod(_) | .PluginInvoke(_, _) | .MathMethod(_, _, _) -> true
        .HTTPReqField(_) | .HTTPRespField(_) | .HTTPRespHeader | .HTTPClientMethod(_, _) | .HTTPRouterRegister(_, _, _, _, _, _) | .HTTPServerMethod(_, _) -> true
        .DynIndexKey(_, _) | .DynIndexAt(_, _) | .DynGetKey | .DynGetAt | .DynHas | .DynKeys | .DynLen(_, _) | .DynRemove | .DynBinary(_, _, _) | .DynCompare(_, _, _) | .DynSetPath(_, _, _) | .DynDecode(_) -> true
        // ir_dyn_method lowered key lookups, indexing, keys, path writes,
        // remove, decode and the scalar, Field and At reads on the canonical
        // Dyn; another receiver of them, and the operator forms (the runtime
        // has no jet_dyn_binary / jet_dyn_compare), have no route here.
        .DynField | .DynAt | .DynInt | .DynText | .DynBool | .DynFloat -> true
        .JSONField | .JSONAt | .JSONInt | .JSONText | .JSONBool | .JSONFloat -> true
        .DBValueInt | .DBValueFloat | .DBValueText | .DBValueBool | .DBValueBlob | .DBValueIsNull | .DBQuery(_) | .DBQueryOne(_) | .DBExecute(_) -> true
        .GameSceneOnFrame(_, _) | .TaskJoin | .TaskDetach -> true
        else -> false
    }
    if dedicated -> return ir_fail_slot(&b, span, "handle method {ir_handle_op_name(operation)}")
    // to_text and equal_unordered on a Dyn cross the encoding.dyn data
    // route (codegen jet_codegen_data_handle_route) with the Dyn as a tree.
    data_symbol :: if operation == {
        .DynToText | .JSONToText -> "jet_dyn_to_text"
        .DynEqualUnordered | .JSONEqualUnordered -> "jet_dyn_equal_unordered"
        else -> ""
    }
    if data_symbol != "" {
        operands := [Int]{}
        subject :: ir_expr(&m, p, &b, receiver)
        if ir_failed(b) -> return -1
        &operands.push(subject)
        mask := [Bool]{true}
        loop arg in args {
            slot :: ir_expr(&m, p, &b, arg)
            if ir_failed(b) -> return -1
            &operands.push(slot)
            &mask.push(true)
        }
        return ir_route(&m, p, &b, data_symbol, operands, mask, ty, span)
    }
    carrier :: ir_failure_carrier_for_type(ty)
    route :: ir_general_handle_route(operation, ir_ty(p, b, receiver), args.len(), carrier) ?? return ir_fail_slot(&b, span, "handle method {ir_handle_op_name(operation)} without a closed route")
    // A mutating receiver (codegen jet_codegen_handle_receiver_is_mutating)
    // still crosses as its handle: the route mutates the runtime value
    // behind it (Lower Routes.jet lower_route_args, a HandleMut carrier).
    if route.closure_method -> return ir_fail_slot(&b, span, "handle method {route.member} with a closure")
    if route.symbol == "jet_dyn_remove" || route.symbol == "jet_dyn_set_path" -> return ir_fail_slot(&b, span, "handle method {route.symbol}")
    special :: ir_nominal_name(ir_untag(ir_subst(m, ir_ty(p, b, receiver)))) ?? ""
    if special == "Task" || special == "Sender" || special == "Receiver" || special == "Transaction" -> return ir_fail_slot(&b, span, "{special} handle method {route.member}")
    static_call :: if operation == {
        .TLSClientConfigDefault | .TLSRootCertificatesFromPEM | .TLSClientIdentityFromPEM | .HTTPClientNew | .PathFrom | .PathHome | .CursorOver | .ReaderOver(_) -> true
        else -> false
    }
    inputs := [Int]{}
    if !static_call {
        slot :: ir_expr(&m, p, &b, receiver)
        if ir_failed(b) -> return -1
        &inputs.push(slot)
    }
    if operation == .DurationNew(unit, _) {
        // The checked unit crosses as its DurationUnit tag (codegen
        // jet_codegen_lower_general_handle_method).
        unit_def :: ir_type_def(p, "DurationUnit") ?? return ir_fail_slot(&b, span, "DurationUnit without its declaration")
        unit_index :: ir_variant_index(p, unit_def, unit) ?? return ir_fail_slot(&b, span, "DurationUnit without {unit}")
        unit_row :: ir_value_type(&m, p, Type.Named{name: "DurationUnit"}) ?? return ir_type_fail(&b, span, Type.Named{name: "DurationUnit"})
        unit_tag :: ir_temp(&m, &b, unit_row)
        ir_emit(&b.f, IROp.Const, unit_tag, unit_index, -1, -1, b.line)
        &inputs.push(unit_tag)
    }
    loop arg in args {
        slot :: ir_expr(&m, p, &b, arg)
        if ir_failed(b) -> return -1
        &inputs.push(slot)
    }
    if inputs.len() != route.borrow_mask.len() -> return ir_fail_slot(&b, span, "handle method {route.member} with {inputs.len()} of {route.borrow_mask.len()} operands")
    result :: if ir_unit_type(ty) || ir_never_type(ty) -> Type.Named{name: "Unit"} else -> ty
    ir_route(&m, p, &b, route.symbol, inputs, route.borrow_mask, result, span)
}

fn ir_handle_op_name(operation: THandleOp) -> String Never! {
    text := "{operation}"
    separators :: [String]{"(", "{{", " "}
    loop separator in separators {
        parts :: text.split(separator).to_list()
        text = parts[0]
    }
    text
}

// `a.div_euclid(b)` / `a.rem_euclid(b)` on exact Ints (codegen
// jet_codegen_lower_numeric_binary_method, Lower lower_numeric_euclid): the
// located runtime route jet_int_{div,rem}_euclid (Lower's inline fast path
// computes the same value).
fn ir_numeric_euclid(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: TExpr, operation: TNumericOp, argument: TExpr, span: Span) -> Int Never! {
    receiver_ty :: ir_ty(p, b, receiver)
    remainder :: if operation == {
        .EuclideanDiv -> false
        .EuclideanRem -> true
        else -> { return ir_fail_slot(&b, span, "binary numeric operation other than div_euclid/rem_euclid") }
    }
    left :: ir_expr(&m, p, &b, receiver)
    right :: ir_expr(&m, p, &b, argument)
    if ir_failed(b) -> return -1
    if left < 0 || right < 0 || ir_kind_of(m, b, left) != .Int || ir_kind_of(m, b, right) != .Int -> return ir_fail_slot(&b, span, "Euclidean arithmetic on {ir_type_name(receiver_ty)}")
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    if m.types[row].kind != .Int -> return ir_fail_slot(&b, span, "Euclidean arithmetic producing {ir_type_name(ty)}")
    args := [Int]{left, right}
    site :: b.line
    loop arg in ir_location(&m, &b, site) -> &args.push(arg)
    result :: ir_runtime(&m, &b, if remainder -> "jet_int_rem_euclid" else -> "jet_int_div_euclid", args, row)
    ir_release(&m, &b, left)
    ir_release(&m, &b, right)
    result
}

// `a.wrapping_add(b)` and the other overflow policies (codegen
// jet_codegen_lower_overflow_opt; Lower lower_numeric_overflow and
// lower_narrow_overflow), inline at the word's own width. An unbounded Int's
// wrapping or saturating form is its exact operator; a checked form is an
// Option box (None on overflow); a policy form stops as the trapping operator
// does, at the call's line.
fn ir_overflow_opt(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, prefix: String, operation: String, line: Int, lhs: TExpr, rhs: TExpr, span: Span) -> Int Never! {
    lhs_ty :: ir_ty(p, b, lhs)
    rhs_ty :: ir_ty(p, b, rhs)
    if line > 0 -> b.line = line
    left :: ir_expr(&m, p, &b, lhs)
    right :: ir_expr(&m, p, &b, rhs)
    if ir_failed(b) -> return -1
    name :: "{prefix}_{operation}"
    if left < 0 || right < 0 -> return ir_fail_slot(&b, span, "overflow policy {name} on Unit")
    if ir_kind_of(m, b, left) == .Int {
        if prefix != "wrapping" && prefix != "saturating" -> return ir_fail_slot(&b, span, "overflow policy {name} on Int")
        op :: if operation == {
            "add" -> TBinaryOp.Add
            "sub" -> TBinaryOp.Sub
            "mul" -> TBinaryOp.Mul
            "div" -> TBinaryOp.Div
            "rem" -> TBinaryOp.Rem
            else -> { return ir_fail_slot(&b, span, "overflow policy {name} on Int") }
        }
        result :: ir_binary(&m, p, &b, op, false, line, lhs_ty, left, right, rhs_ty, span)
        ir_release(&m, &b, left)
        ir_release(&m, &b, right)
        return result
    }
    if ir_kind_of(m, b, left) != .Word || b.f.slot_type[right] != b.f.slot_type[left] -> return ir_fail_slot(&b, span, "overflow policy {name} on {ir_type_name(lhs_ty)}")
    signed :: m.types[b.f.slot_type[left]].signed
    bits :: m.types[b.f.slot_type[left]].bits
    if prefix == "rotate_left" || prefix == "rotate_right" {
        if operation != "rotate" -> return ir_fail_slot(&b, span, "overflow policy {name}")
        if signed && bits < 64 -> return ir_fail_slot(&b, span, "overflow policy {prefix} on {ir_type_name(lhs_ty)}")
        return ir_rotate(&m, &b, prefix == "rotate_left", left, right, signed, bits)
    }
    op :: if operation == {
        "add" -> IROp.Add
        "sub" -> IROp.Sub
        "mul" -> IROp.Mul
        "div" -> IROp.Div
        "rem" -> IROp.Rem
        else -> { return ir_fail_slot(&b, span, "overflow policy {name} on {ir_type_name(lhs_ty)}") }
    }
    if prefix == "wrapping" || prefix == "checked_policy" {
        // Division by zero stops under either policy; a policy's overflow
        // stops with the trapping operator's message.
        dst :: ir_temp_like(&m, &b, left)
        ir_emit(&b.f, op, dst, left, right, if prefix == "wrapping" -> IR_OVERFLOW_WRAP else -> IR_OVERFLOW_TRAP, b.line)
        return dst
    }
    checked :: prefix == "checked"
    if !checked && prefix != "saturating" -> return ir_fail_slot(&b, span, "overflow policy {name}")
    if op == .Div || op == .Rem -> return ir_overflow_division(&m, p, &b, ty, checked, op, left, right, signed, bits, span)
    value :: ir_temp_like(&m, &b, left)
    ir_emit(&b.f, op, value, left, right, IR_OVERFLOW_WRAP, b.line)
    overflowed :: ir_overflowed(&m, &b, op, left, right, value, signed, bits)
    if checked {
        result :: ir_checked_open(&m, p, &b, ty, overflowed, span)
        if result < 0 -> return -1
        return ir_checked_close(&m, p, &b, result, value)
    }
    limit :: ir_saturation_limit(&m, &b, op, left, right, signed, bits)
    result :: ir_temp_like(&m, &b, left)
    ir_open_if(&b.f, overflowed, b.line)
    ir_emit(&b.f, IROp.Copy, result, limit, -1, -1, b.line)
    ir_else(&b.f, b.line)
    ir_emit(&b.f, IROp.Copy, result, value, -1, -1, b.line)
    ir_end(&b.f, b.line)
    result
}

// A constant of `like`'s type.
fn ir_const_like(m: &IRModule, b: &IRBuilder, like: Int, value: Int) -> Int Never! {
    slot :: ir_temp_like(&m, &b, like)
    ir_emit(&b.f, IROp.Const, slot, value, -1, -1, b.line)
    slot
}

// The range of a fixed-width word of `bits` (a 64-bit unsigned maximum is
// the all-ones word).
fn ir_word_min(signed: Bool, bits: Int) -> Int Never! {
    if !signed -> return 0
    if bits >= 64 -> return -9223372036854775807 - 1
    0 - (1 << (bits - 1))
}

fn ir_word_max(signed: Bool, bits: Int) -> Int Never! {
    if bits >= 64 -> return if signed -> 9223372036854775807 else -> -1
    if signed -> return (1 << (bits - 1)) - 1
    (1 << bits) - 1
}

// Whether `left op right` (Add, Sub, Mul) left the word's range, given its
// wrapped `value`: unsigned add wraps below `left`, unsigned sub borrows when
// `left < right`, signed add/sub overflow when the operands agree in sign
// against the result, and a product overflowed unless it divides back.
fn ir_overflowed(m: &IRModule, b: &IRBuilder, op: IROp, left: Int, right: Int, value: Int, signed: Bool, bits: Int) -> Int Never! {
    if op == .Add || op == .Sub {
        if !signed {
            if op == .Add -> return ir_bool_op(&m, &b, IROp.Lt, value, left)
            return ir_bool_op(&m, &b, IROp.Lt, left, right)
        }
        first :: ir_temp_like(&m, &b, left)
        ir_emit(&b.f, IROp.BitXor, first, if op == .Add -> right else -> left, if op == .Add -> value else -> right, IR_OVERFLOW_WRAP, b.line)
        second :: ir_temp_like(&m, &b, left)
        ir_emit(&b.f, IROp.BitXor, second, left, value, IR_OVERFLOW_WRAP, b.line)
        both :: ir_temp_like(&m, &b, left)
        ir_emit(&b.f, IROp.BitAnd, both, first, second, IR_OVERFLOW_WRAP, b.line)
        zero :: ir_const_like(&m, &b, left, 0)
        return ir_bool_op(&m, &b, IROp.Lt, both, zero)
    }
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    flag :: ir_temp(&m, &b, bool_row)
    ir_emit(&b.f, IROp.Const, flag, 0, -1, -1, b.line)
    zero :: ir_const_like(&m, &b, left, 0)
    nonzero :: ir_bool_op(&m, &b, IROp.Ne, left, zero)
    ir_open_if(&b.f, nonzero, b.line)
    if signed {
        // MIN * -1 is the one product a -1 divisor cannot divide back.
        minus_one :: ir_const_like(&m, &b, left, -1)
        negates :: ir_bool_op(&m, &b, IROp.Eq, left, minus_one)
        ir_open_if(&b.f, negates, b.line)
        minimum :: ir_const_like(&m, &b, left, ir_word_min(true, bits))
        ir_emit(&b.f, IROp.Eq, flag, right, minimum, -1, b.line)
        ir_else(&b.f, b.line)
        ir_product_check(&m, &b, flag, left, right, value)
        ir_end(&b.f, b.line)
    } else {
        ir_product_check(&m, &b, flag, left, right, value)
    }
    ir_end(&b.f, b.line)
    flag
}

// flag = value / left != right (left is neither 0 nor -1).
fn ir_product_check(m: &IRModule, b: &IRBuilder, flag: Int, left: Int, right: Int, value: Int) Never! {
    quotient :: ir_temp_like(&m, &b, left)
    ir_emit(&b.f, IROp.Div, quotient, value, left, IR_OVERFLOW_WRAP, b.line)
    ir_emit(&b.f, IROp.Ne, flag, quotient, right, -1, b.line)
}

// A saturating result's bound: an unsigned difference floors at 0, any
// other unsigned result caps at the maximum; a signed one goes to MIN when
// the exact result is negative (`left < 0`, or the operands' signs differ
// for a product), else to MAX.
fn ir_saturation_limit(m: &IRModule, b: &IRBuilder, op: IROp, left: Int, right: Int, signed: Bool, bits: Int) -> Int Never! {
    if !signed -> return ir_const_like(&m, &b, left, if op == .Sub -> 0 else -> ir_word_max(false, bits))
    zero :: ir_const_like(&m, &b, left, 0)
    negative := ir_bool_op(&m, &b, IROp.Lt, left, zero)
    if op == .Mul {
        right_negative :: ir_bool_op(&m, &b, IROp.Lt, right, zero)
        negative = ir_bool_op(&m, &b, IROp.Ne, negative, right_negative)
    }
    limit :: ir_temp_like(&m, &b, left)
    ir_open_if(&b.f, negative, b.line)
    ir_emit(&b.f, IROp.Const, limit, ir_word_min(true, bits), -1, -1, b.line)
    ir_else(&b.f, b.line)
    ir_emit(&b.f, IROp.Const, limit, ir_word_max(true, bits), -1, -1, b.line)
    ir_end(&b.f, b.line)
    limit
}

// Checked and saturating Div/Rem: a zero divisor is None (checked) or
// stops (saturating, as the wrapping operator does); signed MIN / -1 is None
// (checked) or MAX (saturating), and its remainder is 0.
fn ir_overflow_division(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, checked: Bool, op: IROp, left: Int, right: Int, signed: Bool, bits: Int, span: Span) -> Int Never! {
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    special :: ir_temp(&m, &b, bool_row)
    ir_emit(&b.f, IROp.Const, special, 0, -1, -1, b.line)
    if signed && op == .Div {
        minimum :: ir_const_like(&m, &b, left, ir_word_min(true, bits))
        at_minimum :: ir_bool_op(&m, &b, IROp.Eq, left, minimum)
        ir_open_if(&b.f, at_minimum, b.line)
        minus_one :: ir_const_like(&m, &b, left, -1)
        ir_emit(&b.f, IROp.Eq, special, right, minus_one, -1, b.line)
        ir_end(&b.f, b.line)
    }
    if !checked {
        value :: ir_temp_like(&m, &b, left)
        ir_open_if(&b.f, special, b.line)
        ir_emit(&b.f, IROp.Const, value, ir_word_max(true, bits), -1, -1, b.line)
        ir_else(&b.f, b.line)
        ir_emit(&b.f, op, value, left, right, IR_OVERFLOW_WRAP, b.line)
        ir_end(&b.f, b.line)
        return value
    }
    zero :: ir_const_like(&m, &b, left, 0)
    is_zero :: ir_bool_op(&m, &b, IROp.Eq, right, zero)
    ir_open_if(&b.f, is_zero, b.line)
    ir_emit(&b.f, IROp.Const, special, 1, -1, -1, b.line)
    ir_end(&b.f, b.line)
    result :: ir_checked_open(&m, p, &b, ty, special, span)
    if result < 0 -> return -1
    value :: ir_temp_like(&m, &b, left)
    ir_emit(&b.f, op, value, left, right, IR_OVERFLOW_WRAP, b.line)
    ir_checked_close(&m, p, &b, result, value)
}

// A checked result of Option type `ty`: None when `failed`; the caller
// computes the value in the open Else and ir_checked_close boxes it
// (Lower lower_numeric_finish: an 8-byte box, null for None).
fn ir_checked_open(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, failed: Int, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    if m.types[row].kind != .Pointer -> return ir_fail_slot(&b, span, "checked overflow result {ir_type_name(ty)}")
    result :: ir_temp(&m, &b, row)
    ir_open_if(&b.f, failed, b.line)
    ir_emit(&b.f, IROp.Const, result, 0, -1, -1, b.line)
    ir_else(&b.f, b.line)
    result
}

fn ir_checked_close(m: &IRModule, p: IRProgram, b: &IRBuilder, result: Int, value: Int) -> Int Never! {
    row :: b.f.slot_type[result]
    boxed :: ir_box_alloc(&m, &b, 8, row)
    ir_store_at(&m, p, &b, boxed, 0, value)
    ir_emit(&b.f, IROp.Copy, result, boxed, -1, -1, b.line)
    ir_end(&b.f, b.line)
    b.fresh[result] = ir_has_drop(m, b, result)
    result
}

// rotate_left / rotate_right (Lower lower_numeric_overflow's rotate and
// lower_narrow_rotate): the count modulo the width, the two shifted halves
// or-ed (a zero count shifts the other half by the full width, which the
// machine shift masks to the value itself or a narrow word cuts to 0). A
// signed 64-bit count must not be negative; its halves shift as U64.
fn ir_rotate(m: &IRModule, b: &IRBuilder, left_rotate: Bool, value: Int, count: Int, signed: Bool, bits: Int) -> Int Never! {
    if signed {
        zero :: ir_const_like(&m, &b, count, 0)
        negative :: ir_bool_op(&m, &b, IROp.Lt, count, zero)
        ir_open_if(&b.f, negative, b.line)
        site :: b.line
        args := ir_location(&m, &b, site)
        loop arg in ir_static_text(&m, &b, "A rotation count cannot be negative") -> &args.push(arg)
        _ :: ir_runtime(&m, &b, "jet_rt_numeric_stop", args, -1)
        ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
        ir_end(&b.f, b.line)
    }
    // The halves shift logically: a signed word shifts as its U64 bits.
    unsigned_row :: ir_type_row(&m, Type.IntN{signed: false, bits: 64}) ?? 0
    word := value
    if signed {
        word = ir_temp(&m, &b, unsigned_row)
        ir_emit(&b.f, IROp.Copy, word, value, -1, -1, b.line)
    }
    mask :: ir_const_like(&m, &b, word, bits - 1)
    amount :: ir_temp_like(&m, &b, word)
    counted :: if signed -> ir_copy_word(&m, &b, count, unsigned_row) else -> count
    ir_emit(&b.f, IROp.BitAnd, amount, counted, mask, IR_OVERFLOW_WRAP, b.line)
    width :: ir_const_like(&m, &b, word, bits)
    reverse :: ir_temp_like(&m, &b, word)
    ir_emit(&b.f, IROp.Sub, reverse, width, amount, IR_OVERFLOW_WRAP, b.line)
    first :: ir_temp_like(&m, &b, word)
    ir_emit(&b.f, if left_rotate -> IROp.Shl else -> IROp.Shr, first, word, amount, IR_OVERFLOW_WRAP, b.line)
    second :: ir_temp_like(&m, &b, word)
    ir_emit(&b.f, if left_rotate -> IROp.Shr else -> IROp.Shl, second, word, reverse, IR_OVERFLOW_WRAP, b.line)
    rotated :: ir_temp_like(&m, &b, word)
    ir_emit(&b.f, IROp.BitOr, rotated, first, second, IR_OVERFLOW_WRAP, b.line)
    if !signed -> return rotated
    result :: ir_temp_like(&m, &b, value)
    ir_emit(&b.f, IROp.Copy, result, rotated, -1, -1, b.line)
    result
}

// `slot`'s word bits as a word of type row `row`.
fn ir_copy_word(m: &IRModule, b: &IRBuilder, slot: Int, row: Int) -> Int Never! {
    bits :: ir_temp(&m, &b, row)
    ir_emit(&b.f, IROp.Copy, bits, slot, -1, -1, b.line)
    bits
}

// An owner-qualified call (codegen StaticCalls.jet): a user type's static
// method is a direct call of its checked function (a generic owner's type
// arguments lead the method's own); a Prelude owner's crosses its runtime
// route `<path>::<member>` with the arguments' borrow mask.
fn ir_static_call(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, owner: TStaticOwner, owner_type: Type?, method: TMethodRef, type_args: [Type], args: [TCallArg], span: Span) -> Int Never! {
    if owner == .Prelude(rooted, path, _) {
        if method.trait_owner != None -> return ir_fail_slot(&b, span, "trait-qualified Prelude static call {path}.{method.name}")
        member :: method.operator_identity ?? method.name
        if path == "core.data.plot" && member == "column" -> return ir_fail_slot(&b, span, "Prelude static call core.data.plot.column")
        if rooted && path == "JetAtomic" && member == "new" -> return ir_atomic_new(&m, p, &b, ty, args, span)
        symbol := "{path}::{member}"
        if rooted && path == "JetAuthority" {
            if member == "from_rights" -> symbol = "jet_authority_from_rights"
            if member == "workspace" -> symbol = "jet_authority_workspace"
            if member == "with" -> symbol = "jet_authority_with"
            if member == "without" -> symbol = "jet_authority_without"
        }
        slots := [Int]{}
        borrowed := [Bool]{}
        loop arg in args {
            // A function value already is its closure (Lower ignores
            // fn_coercion); a `[T#N]` is carried as the List it widens to.
            if arg.widen_to_union != None || arg.box_as_trait != None || arg.spread -> return ir_fail_slot(&b, span, "coerced Prelude static call argument")
            value :: ir_expr(&m, p, &b, arg.value)
            if ir_failed(b) -> return -1
            // A moved widening is a copy: the caller keeps its own array.
            moved_widening :: arg.widen_to_vec && !arg.borrow && !arg.mut_borrow && value >= 0 && !b.fresh[value]
            slot :: if moved_widening -> ir_copy_value(&m, p, &b, value, span) else -> value
            &slots.push(slot)
            &borrowed.push(arg.borrow || arg.mut_borrow)
        }
        result :: if ir_unit_type(ty) || ir_never_type(ty) -> Type.Named{name: "Unit"} else -> ty
        return ir_route(&m, p, &b, symbol, slots, borrowed, result, span)
    }
    row :: p.rows.get(method.symbol.key) ?? return ir_fail_slot(&b, span, "static call outside the checked program: {method.name}")
    function :: p.functions[row]
    expected :: function.generic_params.len()
    if expected > 0 && type_args.len() > 0 && type_args.len() != expected -> return ir_fail_slot(&b, span, "static call of {method.name} with {type_args.len()} of {expected} type arguments")
    // The owner's arguments: what the call's types give them (`Box.new(7)`),
    // else the ones the owner is written with (`Box<Int>.empty()`).
    all := [Type]{}
    if ir_infer_owner_args(p, b, function, ty, args) == .Val(inferred) {
        all = inferred
    } else {
        written :: owner_type ?? return ir_fail_slot(&b, span, "static call of {method.name} leaves its owner's type arguments unbound")
        all = ir_owner_args(p, function, written) ?? return ir_fail_slot(&b, span, "static call of {method.name} leaves its owner's type arguments unbound")
    }
    loop arg in type_args -> &all.push(arg)
    ir_call(&m, p, &b, method.symbol.key, all, -1, [IRWriteBack]{}, args, span)
}

// The arm of a valued `if`: its statements, then its value into `result`.
fn ir_branch_value(m: &IRModule, p: IRProgram, b: &IRBuilder, body: [TStmt], value: TExpr, result: Int) Never! {
    ir_scope_open(&b)
    loop statement in body {
        if ir_failed(b) -> break
        ir_stmt(&m, p, &b, statement)
    }
    target_row :: if result >= 0 -> b.f.slot_type[result] else -> -1
    slot :: if result >= 0 -> ir_value_as(&m, p, &b, value, target_row, value.span) else -> ir_expr(&m, p, &b, value)
    if !ir_failed(b) && result >= 0 && slot >= 0 -> ir_store(&m, p, &b, result, slot)
    if !ir_failed(b) && result < 0 -> ir_release(&m, &b, slot)
    ir_scope_close(&m, &b)
}

// A loop ending a valued block (codegen jet_codegen_lower_loop_value): each
// `break v` writes `v` into the result and leaves the loop.
fn ir_loop_value(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, label: String?, body: [TStmt], span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    result :: ir_temp(&m, &b, row)
    exit :: ir_open(&b.f, IROp.Block, b.line)
    top :: ir_open(&b.f, IROp.Loop, b.line)
    &b.loops.push(IRLoopFrame{label: label, exit: exit, next: top, mark: b.bindings.len(), value: result})
    ir_stmts(&m, p, &b, body)
    _ :: &b.loops.pop()
    ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    b.fresh[result] = ir_has_drop(m, b, result)
    result
}

// `a && b` / `a || b`: `b` runs only when `a` does not decide.
fn ir_short_circuit(m: &IRModule, p: IRProgram, b: &IRBuilder, is_and: Bool, lhs: TExpr, rhs: TExpr) -> Int Never! {
    left :: ir_expr(&m, p, &b, lhs)
    if ir_failed(b) -> return -1
    result :: ir_temp_like(&m, &b, left)
    ir_emit(&b.f, IROp.Copy, result, left, -1, -1, b.line)
    test := left
    if !is_and {
        test = ir_temp_like(&m, &b, left)
        ir_emit(&b.f, IROp.Not, test, left, -1, -1, b.line)
    }
    ir_open_if(&b.f, test, b.line)
    right :: ir_expr(&m, p, &b, rhs)
    if ir_failed(b) -> return -1
    ir_emit(&b.f, IROp.Copy, result, right, -1, -1, b.line)
    ir_end(&b.f, b.line)
    result
}

// A string literal: an immortal static text when every part is literal,
// else a runtime builder fed each part (Lower lower_build_string).
fn ir_string(m: &IRModule, p: IRProgram, b: &IRBuilder, parts: [TStrPart], span: Span) -> Int Never! {
    literal := ""
    all_literal := true
    loop part in parts {
        if part == {
            .Literal(text) -> literal = "{literal}{text}"
            .Interpolation(_, _) -> all_literal = false
        }
    }
    if all_literal {
        string_row :: ir_string_row(&m)
        slot :: ir_temp(&m, &b, string_row)
        ir_emit(&b.f, IROp.ConstText, slot, ir_intern_text(&m, literal), -1, -1, b.line)
        return slot
    }
    pointer_row :: ir_pointer_row(&m)
    builder :: ir_runtime(&m, &b, "jet_rt_string_builder_new", [Int]{}, pointer_row)
    b.fresh[builder] = false
    loop part in parts {
        if part == {
            .Literal(text) -> {
                args := [Int]{builder}
                loop arg in ir_static_text(&m, &b, text) -> &args.push(arg)
                _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push_static", args, -1)
            }
            .Interpolation(value, format) -> {
                // `{x:Fixed(n)}` / `{x:Grouped(n)}` of a Float: the
                // core.text.fmt kernel the reference lowers it to
                // (jet_fmt_decimal / jet_fmt_grouped, host i64 precision).
                kernel :: if format == {
                    .Fixed(_) -> "jet_fmt_decimal"
                    .Grouped(_) -> "jet_fmt_grouped"
                    else -> ""
                }
                precision :: if format == {
                    .Fixed(digits) | .Grouped(digits) -> digits
                    else -> 0
                }
                if kernel != "" && ir_untag(ir_subst(m, ir_ty(p, b, value))) == .Float {
                    slot :: ir_expr(&m, p, &b, value)
                    if ir_failed(b) -> return -1
                    digits :: ir_word_const(&m, &b, precision)
                    string_row :: ir_string_row(&m)
                    text :: ir_runtime(&m, &b, kernel, [Int]{slot, digits}, string_row)
                    _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
                    ir_release(&m, &b, text)
                    ir_release(&m, &b, slot)
                    next
                }
                // Every other selector is its Core/Text/Fmt.jet helper.
                if format != .Display && format != .Debug {
                    text :: ir_string_format(&m, p, &b, value, format, span)
                    if ir_failed(b) || text < 0 -> return -1
                    _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
                    ir_release(&m, &b, text)
                    next
                }
                debug :: format == .Debug
                slot :: ir_expr(&m, p, &b, value)
                if ir_failed(b) -> return -1
                value_type :: ir_ty(p, b, value)
                text :: ir_render(&m, p, &b, value_type, slot, if debug -> IRRender.Debug else -> IRRender.Display, span)
                if ir_failed(b) -> return -1
                _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
                ir_release(&m, &b, text)
                ir_release(&m, &b, slot)
            }
        }
    }
    string_row :: ir_string_row(&m)
    ir_runtime(&m, &b, "jet_rt_string_builder_finish", [Int]{builder}, string_row)
}

// `print(value)`: its shown text to stdout with a line end and a flush
// (Lower semantic Print: jet_term_write_stdout_line(text, flush 1)).
fn ir_print(m: &IRModule, p: IRProgram, b: &IRBuilder, value: TExpr, span: Span) Never! {
    value_ty :: ir_ty(p, b, value)
    slot :: ir_expr(&m, p, &b, value)
    if ir_failed(b) -> return
    text :: ir_render(&m, p, &b, value_ty, slot, IRRender.Show, span)
    if ir_failed(b) -> return
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    flush :: ir_temp(&m, &b, bool_row)
    ir_emit(&b.f, IROp.Const, flush, 1, -1, -1, b.line)
    _ :: ir_runtime(&m, &b, "jet_term_write_stdout_line", [Int]{text, flush}, -1)
    if text != slot -> ir_release(&m, &b, text)
    ir_release(&m, &b, slot)
}

// A call of a checked user function: arguments in order; a fresh argument
// passed to a read parameter is dropped after the call, one passed to a
// move parameter belongs to the callee. A write argument passes the address
// of its place; `backs` (the receiver's, then each argument's) read frame
// cells back into their variables after the call. The result has the
// callee's executable return type.
fn ir_call(m: &IRModule, p: IRProgram, b: &IRBuilder, key: String, type_args: [Type], receiver: Int, receiver_backs: [IRWriteBack], args: [TCallArg], span: Span) -> Int Never! {
    if p.intrinsics.get(key) == .Val(intrinsic) -> return ir_intrinsic_call(&m, p, &b, intrinsic, args, span)
    if p.foreign.get(key) == .Val(foreign) -> return ir_foreign_call(&m, p, &b, foreign, args, span)
    row :: p.rows.get(key) ?? return ir_fail_slot(&b, span, "call of a function outside the checked program: {key}")
    callee :: ir_function_id(&m, p, key, type_args) ?? return ir_fail_slot(&b, span, "call of {key}")
    params :: p.functions[row].params
    // The callee's parameter and return types in concrete terms.
    names :: if type_args.len() > 0 -> ir_generic_names(p, p.functions[row]) else -> [String]{}
    concrete := [Type]{}
    loop arg in type_args -> &concrete.push(ir_subst(m, arg))
    if params.len() != args.len() -> return ir_fail_slot(&b, span, "call with defaulted or variadic arguments")
    slots := [Int]{}
    moves := [Bool]{}
    backs := receiver_backs
    if receiver >= 0 {
        if ir_receiver_access(p.functions[row].kind) == "move" -> ir_close_disarm(&b, receiver)
        &slots.push(if ir_receiver_access(p.functions[row].kind) == "move" -> ir_own(&m, p, &b, receiver) else -> receiver)
        &moves.push(ir_receiver_access(p.functions[row].kind) == "move")
    }
    loop (index, arg) in args {
        // A function value already is its closure (Lower ignores
        // fn_coercion); a widened `[T#N]` is the List it is carried as, and
        // a move parameter's ir_own copies it.
        if arg.spread -> return ir_fail_slot(&b, span, "coerced call argument")
        if params[index].convention == .Write || arg.mut_borrow {
            address :: ir_place_address(&m, p, &b, arg.value, &backs, span)
            if ir_failed(b) -> return -1
            &slots.push(address)
            &moves.push(false)
            next
        }
        param_ty :: if names.len() > 0 -> ir_subst_in(names, concrete, params[index].ty) else -> params[index].ty
        param_row :: ir_value_type(&m, p, param_ty) ?? return ir_fail_slot(&b, span, "argument type {ir_type_name(param_ty)}")
        slot := -1
        if arg.box_as_trait == .Val(target) {
            slot = ir_trait_box(&m, p, &b, arg.value, target, span)
        } else if arg.widen_to_union == .Val(union_ty) {
            slot = ir_widen_union(&m, p, &b, arg.value, union_ty, span)
        } else {
            slot = ir_value_as(&m, p, &b, arg.value, param_row, span)
        }
        if ir_failed(b) -> return -1
        if slot < 0 -> return ir_fail_slot(&b, span, "Unit call argument")
        if params[index].convention == .Move -> ir_close_disarm(&b, slot)
        &slots.push(if params[index].convention == .Move -> ir_own(&m, p, &b, slot) else -> slot)
        &moves.push(params[index].convention == .Move)
    }
    dst := -1
    written_return :: ir_executable_return(p.functions[row]) ?? Type.Named{name: "Unit"}
    returned :: if names.len() > 0 -> ir_subst_in(names, concrete, written_return) else -> written_return
    if !ir_unit_type(returned) {
        result :: ir_value_type(&m, p, returned) ?? return ir_type_fail(&b, span, returned)
        dst = ir_fresh_temp(&m, &b, result)
    }
    start :: ir_args(&b.f, slots)
    ir_emit(&b.f, IROp.Call, dst, callee, start, slots.len(), b.line)
    loop back in backs -> ir_emit(&b.f, IROp.Load, back.slot, back.cell, 0, -1, b.line)
    loop (index, slot) in slots {
        if moves[index] {
            b.fresh[slot] = false
        } else {
            ir_release(&m, &b, slot)
        }
    }
    dst
}

// A precise numeric builtin (`Fraction`/`Decimal`/`Complex` arithmetic and
// conversions) calls its core.math source helper, as codegen
// jet_codegen_lower_precise_builtin does; when the program holds no core.math
// (the type is then its runtime handle) it is the `jet_<type>_<function>`
// route, its constructors taking their arguments by value.
fn ir_precise_builtin(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, type_name: String, function: String, args: [TExpr], span: Span) -> Int Never! {
    helper :: ir_precise_source_helper(type_name, function) ?? ""
    key :: "function:<corelib>/core.math::{helper}"
    if helper == "" || p.rows.get(key) == None {
        type_key :: if type_name == {
            "Decimal" -> "decimal"
            "Fraction" -> "fraction"
            "Complex" -> "complex"
            "Measurement" -> "measurement"
            else -> { return ir_fail_slot(&b, span, "precise builtin {type_name}.{function}") }
        }
        by_value :: function == "new" || function == "from_parts" || (function.starts_with("from_") && function != "from_str")
        slots := [Int]{}
        borrowed := [Bool]{}
        loop argument in args {
            slot :: ir_expr(&m, p, &b, argument)
            if ir_failed(b) -> return -1
            &slots.push(slot)
            &borrowed.push(!by_value)
        }
        return ir_route(&m, p, &b, "jet_{type_key}_{function}", slots, borrowed, ty, span)
    }
    call_args := [TCallArg]{}
    loop argument in args {
        // copy: `argument` is an element of read parameter `args`, which keeps the original; the call argument owns this one
        &call_args.push(TCallArg{value: argument.copy(), template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false})
    }
    ir_call(&m, p, &b, key, [Type]{}, -1, [IRWriteBack]{}, call_args, span)
}

// The storage a write through `place` reaches: a path through a List element
// or a Map entry goes through ir_place_address, which gives each List and Map
// on the way a buffer of its own, then reads a scalar or box place's value
// from its address; any other place is its value.
fn ir_write_base(m: &IRModule, p: IRProgram, b: &IRBuilder, place: TExpr, span: Span) -> Int Never! {
    if !ir_place_has_index(place) -> return ir_expr(&m, p, &b, place)
    backs := [IRWriteBack]{}
    address :: ir_place_address(&m, p, &b, place, &backs, span)
    if ir_failed(b) || address < 0 || ir_kind_of(m, b, address) == .Aggregate -> return address
    place_ty :: ir_ty(p, b, place)
    row :: ir_value_type(&m, p, place_ty) ?? return ir_type_fail(&b, span, place_ty)
    ir_load_at(&m, &b, address, 0, row)
}

fn ir_place_has_index(place: TExpr) -> Bool Never! {
    if place.kind == {
        .Borrow(inner, _) -> return ir_place_has_index(inner)
        .Move(inner) -> return ir_place_has_index(inner)
        .Field(receiver, _) -> return ir_place_has_index(receiver)
        .Index(_, _, kind, _, _, _) -> return kind == .List || kind == .FixedListProof || kind == .Map
        else -> return false
    }
}

// The address of a write place: an aggregate variable is its storage, a
// forwarded write parameter its caller's address, any other variable a frame
// cell read back after the call (`backs`), a struct member or a list element
// its address.
fn ir_place_address(m: &IRModule, p: IRProgram, b: &IRBuilder, place: TExpr, backs: &[IRWriteBack], span: Span) -> Int Never! {
    place_ty :: ir_ty(p, b, place)
    if place.kind == .Borrow(inner, _) -> return ir_place_address(&m, p, &b, inner, &backs, span)
    if place.kind == .Move(inner) -> return ir_place_address(&m, p, &b, inner, &backs, span)
    if place.kind == .Local(local) {
        binding :: ir_lookup_local(b, local) ?? return ir_fail_slot(&b, span, "write of unknown local {local.name}")
        if binding.indirect >= 0 || ir_kind_of(m, b, binding.slot) == .Aggregate -> return binding.slot
        row :: m.types[b.f.slot_type[binding.slot]]
        pointer_row :: ir_pointer_row(&m)
        cell :: ir_temp(&m, &b, pointer_row)
        ir_emit(&b.f, IROp.StackAddress, cell, if row.size < 8 -> 8 else -> row.size, 8, -1, b.line)
        ir_emit(&b.f, IROp.Store, -1, cell, 0, binding.slot, b.line)
        &backs.push(IRWriteBack{cell: cell, slot: binding.slot})
        return cell
    }
    if place.kind == .Field(receiver, field) {
        base :: ir_place_address(&m, p, &b, receiver, &backs, span)
        if ir_failed(b) -> return -1
        receiver_ty :: ir_ty(p, b, receiver)
        if ir_kind_of(m, b, base) != .Aggregate -> return ir_fail_slot(&b, span, "write of a field of {ir_type_name(receiver_ty)}")
        member :: ir_member_of(&m, p, b, base, field.name) ?? return ir_fail_slot(&b, span, "write of field {field.name}")
        pointer_row :: ir_pointer_row(&m)
        holder := base
        offset := member.offset
        if member.boxed {
            // A recursive edge's value lives in its wrapper box; a write
            // place gets a wrapper of its own, since a copy of the
            // aggregate shares the old one.
            size :: m.types[member.ty].size
            width :: if size < 8 -> 8 else -> size
            old :: ir_temp(&m, &b, pointer_row)
            ir_emit(&b.f, IROp.Load, old, base, member.offset, -1, b.line)
            holder = ir_box_alloc(&m, &b, width, pointer_row)
            ir_emit(&b.f, IROp.CopyBytes, -1, holder, old, width, b.line)
            ir_emit(&b.f, IROp.Store, -1, base, member.offset, holder, b.line)
            // The new wrapper is one more owner of the value's buffers.
            ir_copy_fixup_at(&m, p, &b, member.ty, holder, 0)
            offset = 0
        }
        address :: if m.types[member.ty].kind == .Aggregate -> ir_temp(&m, &b, member.ty) else -> ir_temp(&m, &b, pointer_row)
        ir_emit(&b.f, IROp.Offset, address, holder, offset, -1, b.line)
        return address
    }
    if place.kind == .Index(base, index, kind, _, _, _) {
        if kind == .Map -> return ir_map_place_address(&m, p, &b, base, index, &backs, span)
        // `&list[i]`: the checked element's address.
        if kind != .List && kind != .FixedListProof -> return ir_fail_slot(&b, span, "write of an index of kind {kind}")
        list :: ir_place_address(&m, p, &b, base, &backs, span)
        if ir_failed(b) -> return -1
        base_ty :: ir_ty(p, b, base)
        if ir_kind_of(m, b, list) != .Aggregate -> return ir_fail_slot(&b, span, "write of an index of {ir_type_name(base_ty)}")
        ir_make_unique(&m, p, &b, list)
        row :: ir_list_element(&m, p, b, list) ?? return ir_fail_slot(&b, span, "write of an index of {ir_type_name(base_ty)}")
        element :: ir_checked_element(&m, p, &b, list, index, row, span)
        if ir_failed(b) || m.types[row].kind != .Aggregate -> return element
        address :: ir_temp(&m, &b, row)
        ir_emit(&b.f, IROp.Offset, address, element, 0, -1, b.line)
        return address
    }
    if place.kind == .SharedGuardValue(guard) {
        // `&guard.value`: the cell's slot itself, written in place.
        payload :: ir_shared_guard_payload(&m, p, &b, guard, span)
        if payload < 0 -> return -1
        row :: ir_value_type(&m, p, place_ty) ?? return ir_type_fail(&b, span, place_ty)
        pointer_row :: ir_pointer_row(&m)
        address :: if m.types[row].kind == .Aggregate -> ir_temp(&m, &b, row) else -> ir_temp(&m, &b, pointer_row)
        ir_emit(&b.f, IROp.Offset, address, payload, 0, -1, b.line)
        return address
    }
    // `f(make())` into a write parameter: the call's fresh aggregate result is
    // its own place, which the call releases after the callee wrote it; a
    // literal (`f(&[...])`) is one too.
    temporary :: if place.kind == {
        .Call(_, _, _) | .MethodCall(_, _, _, _) | .StaticCall(_, _, _, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) -> true
        .List(_, _) | .ListLit(_) | .Tuple(_) | .Map(_) | .MapLit(_) -> true
        else -> false
    }
    if temporary {
        value :: ir_expr(&m, p, &b, place)
        if ir_failed(b) || value < 0 -> return -1
        if ir_kind_of(m, b, value) == .Aggregate -> return ir_own(&m, p, &b, value)
        return ir_fail_slot(&b, span, "write place {ir_expr_kind_name(place.kind)} of {ir_type_name(place_ty)}")
    }
    ir_fail_slot(&b, span, "write place {ir_expr_kind_name(place.kind)}")
}

// A method's receiver convention: "read", "write", "move" or "static" (no
// receiver).
fn ir_receiver_access(kind: TFuncKind) -> String Never! {
    convention :: if kind == {
        .Method(convention, _) -> convention
        .TraitMethod(_, convention, _, _, _) -> convention
        .TopLevel -> { return "static" }
    }
    access :: convention ?? return "static"
    if access == {
        .Read -> "read"
        .Write -> "write"
        .Move -> "move"
    }
}

// ---------------------------------------------------------------------------
// The default `Err` (Lower NativeErr.jet): the runtime's own JetErr handle.

// `Err{message, code, cause, ...}` (Lower lower_native_err_construct): the
// fields in source order, then jet_rt_record_new_jet_err(message, code,
// cause), which clones the message and the code box's text and takes the
// cause handle out of its Option box. Any other field (the private metadata)
// is evaluated and released: the runtime keeps its own fresh state.
fn ir_default_err_literal(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, fields: [TStructFieldValue], span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    message := -1
    code := -1
    cause := -1
    others := [Int]{}
    loop field in fields {
        value :: ir_expr(&m, p, &b, field.value)
        if ir_failed(b) -> return -1
        if field.field.name == "message" {
            message = value
        } else if field.field.name == "code" {
            code = value
        } else if field.field.name == "cause" {
            cause = value
        } else {
            &others.push(value)
        }
    }
    if message < 0 || code < 0 || cause < 0 -> return ir_fail_slot(&b, span, "default Err literal without message, code and cause")
    loop other in others -> ir_release(&m, &b, other)
    // The cause handle: moved out of an owned box (the box is freed), cloned
    // out of a borrowed one.
    pointer_row :: ir_pointer_row(&m)
    taken :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.Const, taken, 0, -1, -1, b.line)
    present :: ir_option_is_some(&m, &b, cause)
    ir_open_if(&b.f, present, b.line)
    handle :: ir_load_word(&m, &b, cause, 0)
    if b.fresh[cause] {
        ir_emit(&b.f, IROp.Copy, taken, handle, -1, -1, b.line)
        bytes :: ir_word_const(&m, &b, 8)
        align :: ir_word_const(&m, &b, 8)
        _ :: ir_runtime(&m, &b, "jet_rt_free", [Int]{cause, bytes, align}, -1)
    } else {
        cloned :: ir_runtime(&m, &b, "jet_rt_handle_clone_jet_err", [Int]{handle}, pointer_row)
        ir_emit(&b.f, IROp.Copy, taken, cloned, -1, -1, b.line)
    }
    ir_end(&b.f, b.line)
    b.fresh[cause] = false
    result :: ir_runtime(&m, &b, "jet_rt_record_new_jet_err", [Int]{message, code, taken}, row)
    ir_release(&m, &b, message)
    ir_release(&m, &b, code)
    result
}

// `error.message` / `.code` / `.cause` of a default `Err` (Lower
// lower_native_err_field, lower_record_load_value): an owned copy through
// jet_rt_record_get_jet_err_<field>; an optional field's getter writes its
// payload to an out word and reports presence, and the value gets a new box.
fn ir_default_err_field(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: TExpr, name: String, span: Span) -> Int Never! {
    if name != "message" && name != "code" && name != "cause" -> return ir_fail_slot(&b, span, "field {name} of the default Err")
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    error :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || error < 0 -> return -1
    getter :: "jet_rt_record_get_jet_err_{name}"
    if name == "message" {
        text :: ir_runtime(&m, &b, getter, [Int]{error}, row)
        ir_release(&m, &b, error)
        return text
    }
    out :: ir_out_slot(&m, &b, 1)
    zero :: ir_word_const(&m, &b, 0)
    word_row :: ir_word_row(&m)
    presence :: ir_runtime(&m, &b, getter, [Int]{error, out}, word_row)
    boxed :: ir_temp(&m, &b, row)
    ir_emit(&b.f, IROp.Const, boxed, 0, -1, -1, b.line)
    some :: ir_bool_op(&m, &b, IROp.Ne, presence, zero)
    ir_open_if(&b.f, some, b.line)
    present :: ir_box_alloc(&m, &b, 8, row)
    payload :: ir_load_word(&m, &b, out, 0)
    ir_emit(&b.f, IROp.Store, -1, present, 0, payload, b.line)
    ir_emit(&b.f, IROp.Copy, boxed, present, -1, -1, b.line)
    ir_end(&b.f, b.line)
    b.fresh[boxed] = true
    ir_release(&m, &b, error)
    boxed
}

// ---------------------------------------------------------------------------
// Switches. Each arm is one If of the chain; its Else holds the next test,
// and the last Else the fallback. The subject is evaluated once.

// `lo <= subject && subject <= hi` as one Bool slot.
fn ir_in_range(m: &IRModule, b: &IRBuilder, subject: Int, lo: Int, hi: Int) -> Int Never! {
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    low :: ir_temp_like(&m, &b, subject)
    ir_emit(&b.f, IROp.Const, low, lo, -1, -1, b.line)
    high :: ir_temp_like(&m, &b, subject)
    ir_emit(&b.f, IROp.Const, high, hi, -1, -1, b.line)
    result :: ir_temp(&m, &b, bool_row)
    ir_emit(&b.f, IROp.Ge, result, subject, low, -1, b.line)
    ir_open_if(&b.f, result, b.line)
    ir_emit(&b.f, IROp.Le, result, subject, high, -1, b.line)
    ir_end(&b.f, b.line)
    result
}

fn ir_range_switch(m: &IRModule, p: IRProgram, b: &IRBuilder, subject: TExpr, arms: [TRangeArm], else_body: [TStmt], span: Span) Never! {
    subject_ty :: ir_ty(p, b, subject)
    value :: ir_expr(&m, p, &b, subject)
    if ir_failed(b) -> return
    kind :: ir_kind_of(m, b, value)
    if kind != .Int && kind != .Word && kind != .Char -> return ir_fail(&b, span, "range switch on {ir_type_name(subject_ty)}")
    opened := 0
    loop arm in arms {
        test :: ir_in_range(&m, &b, value, arm.lo, arm.hi)
        ir_open_if(&b.f, test, b.line)
        ir_stmts(&m, p, &b, arm.body)
        ir_else(&b.f, b.line)
        opened += 1
        if ir_failed(b) -> return
    }
    ir_stmts(&m, p, &b, else_body)
    loop _ in 0..<opened -> ir_end(&b.f, b.line)
    ir_release(&m, &b, value)
}

fn ir_mixed_switch(m: &IRModule, p: IRProgram, b: &IRBuilder, subject: TExpr, arms: [TMixedArm], else_body: [TStmt]?, span: Span) Never! {
    value :: ir_expr(&m, p, &b, subject)
    if ir_failed(b) -> return
    &b.subjects.push(value)
    opened := 0
    loop arm in arms {
        test :: ir_expr(&m, p, &b, arm.condition)
        if ir_failed(b) -> return
        ir_open_if(&b.f, test, b.line)
        ir_stmts(&m, p, &b, arm.body)
        ir_else(&b.f, b.line)
        opened += 1
        if ir_failed(b) -> return
    }
    if else_body == .Val(body) -> ir_stmts(&m, p, &b, body)
    loop _ in 0..<opened -> ir_end(&b.f, b.line)
    _ :: &b.subjects.pop()
    ir_release(&m, &b, value)
}

// A Bool slot: whether `subject` matches `shape`. Payload bindings become
// pending (bound when the condition's If opens); a nested payload pattern,
// value or range is tested on the payload once the outer test holds.
fn ir_pattern_test(m: &IRModule, p: IRProgram, b: &IRBuilder, subject: Int, shape: TPatternShape, span: Span) -> Int Never! {
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    if shape == {
        .Variant(variant, bindings, leading_dot, variant_span) -> {
            subject_type :: b.f.slot_type[subject]
            subject_args :: ir_row_args(m, subject_type)
            row :: ir_enum_def(m, p, subject_type) ?? return ir_fail_slot(&b, span, "variant pattern on a non-enum subject")
            leaves :: ir_group_leaves(p, row, variant)
            if leaves.len() > 0 {
                alternatives := [TPatternShape]{}
                loop leaf in leaves -> &alternatives.push(TPatternShape.Variant{variant: leaf, bindings: bindings, leading_dot: leading_dot, span: variant_span})
                return ir_pattern_test(&m, p, &b, subject, TPatternShape.Or{alternatives: alternatives, span: variant_span}, span)
            }
            index :: ir_variant_index(p, row, variant) ?? return ir_fail_slot(&b, span, "variant pattern {variant} not in its enum")
            discriminant :: ir_enum_tag_of(&m, &b, subject)
            index_slot :: ir_temp_like(&m, &b, discriminant)
            ir_emit(&b.f, IROp.Const, index_slot, index, -1, -1, b.line)
            result :: ir_temp(&m, &b, bool_row)
            ir_emit(&b.f, IROp.Eq, result, discriminant, index_slot, -1, b.line)
            if bindings.len() > 0 {
                members :: ir_variant_members(&m, p, row, subject_args, index) ?? return ir_fail_slot(&b, span, "variant pattern {variant} payload")
                loop (position, binding) in bindings {
                    if position >= members.len() -> return ir_fail_slot(&b, span, "variant pattern {variant} with more bindings than members")
                    member :: members[position]
                    if binding == {
                        .Wildcard -> {}
                        .Bind(name, _) -> {
                            if name != "_" {
                                slot :: ir_new_slot(&b, member.ty, IRSlotKind.Local, ir_intern_name(&m, name))
                                &b.pending.push(IRPending{name: name, slot: slot, subject: subject, offset: member.offset, boxed: member.boxed})
                            }
                        }
                        else -> {
                            ir_open_if(&b.f, result, b.line)
                            payload :: ir_member_value(&m, &b, subject, member)
                            test :: ir_binding_test(&m, p, &b, payload, binding, span)
                            if ir_failed(b) -> return -1
                            ir_emit(&b.f, IROp.Copy, result, test, -1, -1, b.line)
                            ir_end(&b.f, b.line)
                        }
                    }
                }
            }
            return result
        }
        .Range(lo, hi, _) -> return ir_in_range(&m, &b, subject, lo, hi)
        .Or(alternatives, _) -> {
            // Each alternative binds the same names at its own payload
            // offsets: the matching one loads them into the first
            // alternative's slots, which the arm then binds.
            result :: ir_temp(&m, &b, bool_row)
            ir_emit(&b.f, IROp.Const, result, 0, -1, -1, b.line)
            opened := 0
            leading := [IRPending]{}
            loop (index, alternative) in alternatives {
                before :: b.pending.len()
                test :: ir_pattern_test(&m, p, &b, subject, alternative, span)
                if ir_failed(b) -> return -1
                rows := [IRPending]{}
                loop at in before..<b.pending.len() -> &rows.push(b.pending[at].copy())
                loop b.pending.len() > before {
                    _ :: &b.pending.pop()
                }
                if rows.len() > 0 {
                    ir_open_if(&b.f, test, b.line)
                    loop row in rows {
                        target := row.slot
                        if index > 0 {
                            loop kept in leading {
                                if kept.name == row.name -> target = kept.slot
                            }
                        }
                        ir_pending_load(&m, &b, row, target)
                    }
                    ir_end(&b.f, b.line)
                }
                if index == 0 -> leading = rows
                ir_emit(&b.f, IROp.Copy, result, test, -1, -1, b.line)
                not_matched :: ir_temp(&m, &b, bool_row)
                ir_emit(&b.f, IROp.Not, not_matched, test, -1, -1, b.line)
                ir_open_if(&b.f, not_matched, b.line)
                opened += 1
            }
            loop _ in 0..<opened -> ir_end(&b.f, b.line)
            loop row in leading -> &b.pending.push(IRPending{name: row.name, slot: row.slot, subject: row.subject, offset: row.offset, boxed: row.boxed, loaded: true})
            return result
        }
        .Present(_, _, _, _) | .Absent(_) | .Ok(_, _, _, _) | .Err(_, _, _, _) -> return ir_carrier_shape_test(&m, p, &b, subject, shape, span)
        .Struct(fields, _) -> {
            if ir_kind_of(m, b, subject) != .Aggregate -> return ir_fail_slot(&b, span, "struct pattern on {m.types[b.f.slot_type[subject]].ty}")
            result :: ir_temp(&m, &b, bool_row)
            ir_emit(&b.f, IROp.Const, result, 1, -1, -1, b.line)
            loop field in fields {
                if field == {
                    .Bind(name, local, _) -> {
                        member :: ir_member_of(&m, p, b, subject, name) ?? return ir_fail_slot(&b, span, "struct pattern field {name}")
                        if local != "_" && local != "" && m.types[member.ty].kind != .Unit {
                            slot :: ir_new_slot(&b, member.ty, IRSlotKind.Local, ir_intern_name(&m, local))
                            &b.pending.push(IRPending{name: local, slot: slot, subject: subject, offset: member.offset, boxed: member.boxed})
                        }
                    }
                    .Value(name, value, _) -> {
                        member :: ir_member_of(&m, p, b, subject, name) ?? return ir_fail_slot(&b, span, "struct pattern field {name}")
                        ir_open_if(&b.f, result, b.line)
                        payload :: ir_member_read(&m, &b, subject, member)
                        test :: ir_binding_test(&m, p, &b, payload, TPatternBinding.Value{value: value}, span)
                        if ir_failed(b) -> return -1
                        ir_emit(&b.f, IROp.Copy, result, test, -1, -1, b.line)
                        ir_end(&b.f, b.line)
                    }
                    .Nested(name, nested, _) -> {
                        member :: ir_member_of(&m, p, b, subject, name) ?? return ir_fail_slot(&b, span, "struct pattern field {name}")
                        ir_open_if(&b.f, result, b.line)
                        payload :: ir_member_read(&m, &b, subject, member)
                        test :: ir_binding_test(&m, p, &b, payload, TPatternBinding.Nested{pattern: nested}, span)
                        if ir_failed(b) -> return -1
                        ir_emit(&b.f, IROp.Copy, result, test, -1, -1, b.line)
                        ir_end(&b.f, b.line)
                    }
                }
            }
            return result
        }
        .Text(parts, _) -> return ir_text_pattern_test(&m, p, &b, subject, parts, span)
        .Binary(parts, _) -> return ir_binary_pattern_test(&m, p, &b, subject, parts, span)
        else -> return ir_fail_slot(&b, span, "pattern {ir_shape_name(shape)}")
    }
}

// The Bool test of a binary pattern on the `[U8]` `subject` (Lower
// lower_scan_match): one 64-byte descriptor row per part
// [tag, a, b, width, destination, storage, scratch, scratch] for
// `jet_rt_binary_pattern_match`. A bit field captures into its own zeroed
// frame cell at its packed width; the rest capture receives a List header
// box. Only a match writes them, and the names bind from those cells.
fn ir_binary_pattern_test(m: &IRModule, p: IRProgram, b: &IRBuilder, subject: Int, parts: [TBinaryPatternPart], span: Span) -> Int Never! {
    element :: ir_list_element(&m, p, b, subject) ?? return ir_fail_slot(&b, span, "binary pattern on a non-List subject")
    if m.types[element].kind != .Word || m.types[element].bits != 8 || m.types[element].signed -> return ir_fail_slot(&b, span, "binary pattern on a non-[U8] subject")
    word :: ir_word_row(&m)
    pointer :: ir_pointer_row(&m)
    rows :: ir_out_slot(&m, &b, 8 * parts.len())
    pending := [IRPending]{}
    loop (index, part) in parts {
        at :: 64 * index
        selector := 17
        a := -1
        c := -1
        width := 8
        storage := 5
        destination := -1
        if part == {
            .Literal(value) -> {
                selector = 16
                width = 0
                storage = 0
                data :: ir_intern_bytes(&m, value)
                address :: ir_temp(&m, &b, pointer)
                ir_emit(&b.f, IROp.DataAddress, address, data, -1, -1, b.line)
                a = address
                c = ir_word_const(&m, &b, value.len())
            }
            .Bits(name, bits, big_endian, ty, _) -> {
                a = ir_word_const(&m, &b, bits)
                c = ir_word_const(&m, &b, if big_endian -> 0 else -> 1)
                if name != "" && name != "_" {
                    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
                    if m.types[row].kind != .Word -> return ir_fail_slot(&b, span, "binary bit capture of {ir_type_name(ty)}")
                    stored :: m.types[row].bits
                    width = if stored <= 8 -> 1 else if stored <= 16 -> 2 else if stored <= 32 -> 4 else -> 8
                    storage = 0
                    destination = ir_out_slot(&m, &b, 1)
                    slot :: ir_new_slot(&b, row, IRSlotKind.Local, ir_intern_name(&m, name))
                    &pending.push(IRPending{name: name, slot: slot, subject: destination, offset: 0})
                }
            }
            .Rest(name, ty, _) -> {
                selector = 18
                if name != "" && name != "_" {
                    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
                    width = 1
                    storage = 6
                    destination = ir_out_slot(&m, &b, 1)
                    slot :: ir_new_slot(&b, row, IRSlotKind.Local, ir_intern_name(&m, name))
                    // The runtime writes a List header box; the binding is
                    // the List it holds.
                    &pending.push(IRPending{name: name, slot: slot, subject: destination, offset: 0, boxed: true})
                }
            }
        }
        tag_word :: ir_word_const(&m, &b, selector)
        width_word :: ir_word_const(&m, &b, width)
        storage_word :: ir_word_const(&m, &b, storage)
        line :: b.line
        ir_emit(&b.f, IROp.Store, -1, rows, at, tag_word, line)
        if a >= 0 -> ir_emit(&b.f, IROp.Store, -1, rows, at + 8, a, line)
        if c >= 0 -> ir_emit(&b.f, IROp.Store, -1, rows, at + 16, c, line)
        ir_emit(&b.f, IROp.Store, -1, rows, at + 24, width_word, line)
        if destination >= 0 -> ir_emit(&b.f, IROp.Store, -1, rows, at + 32, destination, line)
        ir_emit(&b.f, IROp.Store, -1, rows, at + 40, storage_word, line)
    }
    data :: ir_load_word(&m, &b, subject, 16)
    length :: ir_load_word(&m, &b, subject, 0)
    stride :: ir_word_const(&m, &b, 1)
    count :: ir_word_const(&m, &b, parts.len())
    hit :: ir_runtime(&m, &b, "jet_rt_binary_pattern_match", [Int]{data, length, stride, rows, count}, word)
    zero :: ir_word_const(&m, &b, 0)
    test :: ir_bool_op(&m, &b, IROp.Ne, hit, zero)
    loop row in pending -> &b.pending.push(row)
    test
}

// The test of a payload sub-pattern on the payload slot `payload`: a nested
// shape, an equal value, or a range.
fn ir_binding_test(m: &IRModule, p: IRProgram, b: &IRBuilder, payload: Int, binding: TPatternBinding, span: Span) -> Int Never! {
    if payload < 0 -> return ir_fail_slot(&b, span, "payload pattern on a Unit payload")
    if binding == {
        .Nested(pattern) -> return ir_pattern_test(&m, p, &b, payload, pattern.shape, span)
        .Range(lo, hi) -> return ir_in_range(&m, &b, payload, lo, hi)
        .Value(value) -> {
            payload_row :: b.f.slot_type[payload]
            expected :: ir_value_as(&m, p, &b, value, payload_row, span)
            if ir_failed(b) -> return -1
            site :: b.line
            payload_ty :: m.types[payload_row].ty
            value_ty :: ir_ty(p, b, value)
            test :: ir_binary(&m, p, &b, TBinaryOp.Eq, false, site, payload_ty, payload, expected, value_ty, span)
            ir_release(&m, &b, expected)
            return test
        }
        else -> return ir_fail_slot(&b, span, "payload pattern {ir_binding_name(binding)}")
    }
}

fn ir_match(m: &IRModule, p: IRProgram, b: &IRBuilder, subject: TExpr, arms: [TMatchArm], else_body: [TStmt]?, span: Span) Never! {
    value :: ir_subject(&m, p, &b, subject, span)
    if ir_failed(b) -> return
    &b.subjects.push(value)
    // Each arm starts from the ownership before the match; the arms' paths
    // meet innermost first as their Ifs close (ir_meet_paths).
    before :: ir_own_states(b, b.bindings.len())
    tests := [Int]{}
    arm_states := [[IROwnState]]{}
    arm_leaves := [Bool]{}
    loop arm in arms {
        mark :: b.bindings.len()
        test :: ir_pattern_test(&m, p, &b, value, arm.pattern.shape, span)
        if ir_failed(b) -> return
        ir_pending_windows(&b, subject, 0)
        ir_open_condition(&m, p, &b, test)
        ir_stmts(&m, p, &b, arm.body)
        &tests.push(test)
        &arm_states.push(ir_own_states(b, before.len()))
        &arm_leaves.push(ir_stmts_leave(p, b, arm.body))
        ir_else(&b.f, b.line)
        ir_truncate_bindings(&b, mark)
        ir_set_own_states(&b, before)
        if ir_failed(b) -> return
    }
    rest_leaves := false
    if else_body == .Val(body) {
        ir_stmts(&m, p, &b, body)
        rest_leaves = ir_stmts_leave(p, b, body)
    }
    index := tests.len() - 1
    loop index >= 0 {
        ir_end(&b.f, b.line)
        ir_meet_paths(&m, &b, tests[index], arm_states[index], arm_leaves[index], rest_leaves)
        rest_leaves = rest_leaves && arm_leaves[index]
        index -= 1
    }
    _ :: &b.subjects.pop()
    ir_release(&m, &b, value)
}

// A switch or pattern subject: a plain `T Never!` call result is boxed
// into the carrier its checked type names.
fn ir_subject(m: &IRModule, p: IRProgram, b: &IRBuilder, subject: TExpr, span: Span) -> Int Never! {
    if ir_carrier_type(ir_ty(p, b, subject)) {
        subject_ty :: ir_ty(p, b, subject)
        row :: ir_value_type(&m, p, subject_ty) ?? return ir_type_fail(&b, span, subject_ty)
        return ir_value_as(&m, p, &b, subject, row, span)
    }
    ir_expr(&m, p, &b, subject)
}

// The test of an `if` pattern condition on `subject`. A fresh carrier box
// tested is held (ir_hold) for the payload bindings borrowing it.
fn ir_option_test(m: &IRModule, p: IRProgram, b: &IRBuilder, shape: TPatternShape, subject: TExpr, span: Span) -> Int Never! {
    subject_ty :: ir_ty(p, b, subject)
    if !ir_carrier_type(subject_ty) {
        value :: ir_expr(&m, p, &b, subject)
        if ir_failed(b) || value < 0 -> return ir_fail_slot(&b, span, "pattern condition on {ir_type_name(subject_ty)}")
        ir_hold(m, &b, value)
        from :: b.pending.len()
        test :: ir_pattern_test(&m, p, &b, value, shape, span)
        ir_pending_windows(&b, subject, from)
        return test
    }
    value :: ir_subject(&m, p, &b, subject, span)
    if ir_failed(b) -> return -1
    ir_hold(m, &b, value)
    from :: b.pending.len()
    test :: ir_carrier_shape_test(&m, p, &b, value, shape, span)
    ir_pending_windows(&b, subject, from)
    test
}

// A fresh box `value` a test reads becomes a hidden variable of the open
// scope: every exit (scope end, return, break) drops it, after the names
// bound from its payload end.
fn ir_hold(m: IRModule, b: &IRBuilder, value: Int) Never! {
    if value < 0 || !b.fresh[value] || !ir_box_row(m, b.f.slot_type[value]) -> return
    b.fresh[value] = false
    &b.bindings.push(IRBinding{name: "", slot: value, owned: true})
}

// The names a condition bound in bindings `from..<to` (payloads of `&&`'s
// earlier tests) hold only on the path where it held: the else path no
// longer sees them, while the hidden boxes they borrow stay held.
fn ir_hide_condition_names(b: &IRBuilder, from: Int, to: Int) Never! {
    loop index in from..<to {
        binding :: b.bindings[index]
        if binding.name == "" -> next
        b.bindings[index] = IRBinding{name: " condition", slot: binding.slot, indirect: binding.indirect, owned: binding.owned, symbol: "", write: binding.write, carrier: binding.carrier, live: binding.live}
    }
}

// The test of an Option or Result shape on the carrier box `value`
// (codegen OptionIsSome / ResultIsOk); a payload binding is bound when the
// If opens (IRPending).
fn ir_carrier_shape_test(m: &IRModule, p: IRProgram, b: &IRBuilder, value: Int, shape: TPatternShape, span: Span) -> Int Never! {
    carrier :: ir_untag(m.types[b.f.slot_type[value]].ty)
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    if carrier == .Option(payload) {
        null :: ir_temp_like(&m, &b, value)
        ir_emit(&b.f, IROp.Const, null, 0, -1, -1, b.line)
        test :: ir_temp(&m, &b, bool_row)
        if shape == {
            .Absent(_) -> ir_emit(&b.f, IROp.Eq, test, value, null, -1, b.line)
            .Present(binding, _, inner, _) -> {
                ir_emit(&b.f, IROp.Ne, test, value, null, -1, b.line)
                ir_pend(&m, p, &b, binding, value, 0, payload, span)
                ir_refine_payload(&m, p, &b, test, value, 0, payload, inner, span)
            }
            // Either shape: each alternative's test in turn.
            .Or(_, _) -> return ir_pattern_test(&m, p, &b, value, shape, span)
            else -> return ir_fail_slot(&b, span, "pattern {ir_shape_name(shape)} on an Option")
        }
        return test
    }
    if carrier == .Result(ok, err) {
        is_ok :: ir_result_is_ok(&m, &b, value)
        if shape == {
            .Ok(binding, _, inner, _) -> {
                ir_pend(&m, p, &b, binding, value, 8, ok, span)
                ir_refine_payload(&m, p, &b, is_ok, value, 8, ok, inner, span)
                return is_ok
            }
            .Err(binding, _, inner, _) -> {
                ir_pend(&m, p, &b, binding, value, 8, err, span)
                test :: ir_temp(&m, &b, bool_row)
                ir_emit(&b.f, IROp.Not, test, is_ok, -1, -1, b.line)
                ir_refine_payload(&m, p, &b, test, value, 8, err, inner, span)
                return test
            }
            .Or(_, _) -> return ir_pattern_test(&m, p, &b, value, shape, span)
            else -> return ir_fail_slot(&b, span, "pattern {ir_shape_name(shape)} on a Result")
        }
    }
    ir_fail_slot(&b, span, "pattern {ir_shape_name(shape)} on {ir_type_name(carrier)}")
}

// Narrows the Bool `test` by a nested payload pattern: once it holds, the
// payload at `offset` of the box `value` must match `inner` too.
fn ir_refine_payload(m: &IRModule, p: IRProgram, b: &IRBuilder, test: Int, value: Int, offset: Int, payload: Type, inner: TNestedPattern?, span: Span) Never! {
    nested :: inner ?? return
    row :: ir_value_type(&m, p, payload) ?? return ir_fail(&b, span, "payload type {ir_type_name(payload)}")
    ir_open_if(&b.f, test, b.line)
    slot :: ir_load_at(&m, &b, value, offset, row)
    inner_test :: ir_binding_test(&m, p, &b, slot, TPatternBinding.Nested{pattern: nested}, span)
    if ir_failed(b) -> return
    ir_emit(&b.f, IROp.Copy, test, inner_test, -1, -1, b.line)
    ir_end(&b.f, b.line)
}

fn ir_pend(m: &IRModule, p: IRProgram, b: &IRBuilder, binding: String, subject: Int, offset: Int, payload: Type, span: Span) Never! {
    if binding == "" || binding == "_" -> return
    row :: ir_value_type(&m, p, payload) ?? return ir_fail(&b, span, "payload type {ir_type_name(payload)}")
    if m.types[row].kind == .Unit -> return
    slot :: ir_new_slot(&b, row, IRSlotKind.Local, ir_intern_name(&m, binding))
    &b.pending.push(IRPending{name: binding, slot: slot, subject: subject, offset: offset})
}

// An enum value: a payload-free enum's variant index (Lower
// lower_discriminant), else a new box with the discriminant and payload.
fn ir_enum_value(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, owner: String, variant: String, payload: TEnumPayload, span: Span) -> Int Never! {
    slot_type :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    row :: ir_type_def(p, owner) ?? ir_enum_def(m, p, slot_type) ?? return ir_fail_slot(&b, span, "enum {owner} without a declaration")
    index :: ir_variant_index(p, row, variant) ?? return ir_fail_slot(&b, span, "variant {variant} not in {owner}")
    if m.types[slot_type].kind != .Pointer {
        if payload != .Unit -> return ir_fail_slot(&b, span, "payload for a payload-free enum")
        slot :: ir_temp(&m, &b, slot_type)
        ir_emit(&b.f, IROp.Const, slot, index, -1, -1, b.line)
        return slot
    }
    slot_args :: ir_row_args(m, slot_type)
    members :: ir_variant_members(&m, p, row, slot_args, index) ?? return ir_fail_slot(&b, span, "payload of {variant}")
    size :: ir_enum_box_size(&m, p, row, slot_args) ?? return ir_fail_slot(&b, span, "layout of {owner}")
    values := [Int]{}
    targets := [IRMember]{}
    if payload == {
        .Unit -> {}
        .Positional(args) -> {
            if args.len() != members.len() -> return ir_fail_slot(&b, span, "variant {variant} with {args.len()} of {members.len()} payload values")
            loop (position, arg) in args {
                slot :: ir_value_as(&m, p, &b, arg.value, members[position].ty, span)
                if ir_failed(b) -> return -1
                &values.push(slot)
                &targets.push(members[position])
            }
        }
        .Named(fields) -> {
            loop field in fields {
                found := -1
                loop (position, member) in members {
                    if member.name == field.name -> found = position
                }
                if found < 0 -> return ir_fail_slot(&b, span, "variant {variant} has no member {field.name}")
                slot :: ir_value_as(&m, p, &b, field.value.value, members[found].ty, span)
                if ir_failed(b) -> return -1
                &values.push(slot)
                &targets.push(members[found])
            }
        }
    }
    boxed :: ir_box_alloc(&m, &b, size, slot_type)
    discriminant :: ir_word_const(&m, &b, index)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, discriminant, b.line)
    loop (position, value) in values -> ir_member_store(&m, p, &b, boxed, targets[position], value)
    boxed
}

// `Dyn.Null`, `Dyn.Array(items)`, ... (codegen jet_codegen_lower_json_literal):
// the native Dyn enum's variant over its payload, which the box stores as
// its own (a borrowed payload is cloned, as codegen's `clone_arg` copy). An
// Object over a map literal of Dyn values is the `(key, value)` pair List in
// literal order (codegen jet_codegen_lower_ordered_object_encode, whose
// encode of a Dyn value is that value); one over another container encodes
// and is not built.
fn ir_json_literal(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, variant: String, argument: TExpr?, span: Span) -> Int Never! {
    if argument == None -> return ir_enum_value(&m, p, &b, ty, "Dyn", variant, TEnumPayload.Unit, span)
    value := argument
    map_entries :: if value.kind == {
        .MapLit(entries) | .Map(entries) -> Val(entries)
        else -> None
    }
    if variant == "Object" && map_entries == .Val(entries) {
        pair_ty :: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: Type.String}, TypeTupleField{name: "value", ty: ty}}}
        pairs := [TExpr]{}
        loop entry in entries {
            // A value spelled through another name of the Dyn declaration
            // is that Dyn (codegen encodes it, which is the value itself).
            key_ty :: ir_ty(p, b, entry.key)
            value_ty :: ir_ty(p, b, entry.value)
            if ir_untag(key_ty) != Type.String || ir_dyn_def(p, value_ty) == None -> return ir_fail_slot(&b, span, "Dyn.Object entry {ir_type_name(key_ty)}: {ir_type_name(value_ty)}")
            &pairs.push(ir_node(&b, pair_ty, TExprKind.Tuple{values: [TExpr]{entry.key, entry.value}}, span))
        }
        value = ir_node(&b, Type.List{element: pair_ty}, TExprKind.ListLit{values: pairs}, span)
    }
    if variant == "Object" && ir_untag(ir_ty(p, b, value)) == .Map(_, _, _) -> return ir_dyn_object_encode(&m, p, &b, ty, value, span)
    value_type :: ir_ty(p, b, value)
    if variant == "Object" && !(ir_untag(value_type) == .List(_)) -> return ir_fail_slot(&b, span, "Dyn.Object over {ir_type_name(value_type)}")
    ir_enum_value(&m, p, &b, ty, "Dyn", variant, TEnumPayload.Positional{args: [TEnumArg]{TEnumArg{value: value}}}, span)
}

// `Dyn.Object(map)` over a map value (codegen
// jet_codegen_lower_container_encode): the `(key, value.encode())` pair List
// in the map's iteration order, built by a loop over the map, as the Object
// payload.
fn ir_dyn_object_encode(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, value: TExpr, span: Span) -> Int Never! {
    value_ty :: ir_ty(p, b, value)
    key_ty :: if ir_untag(value_ty) == .Map(key, _, _) -> key else -> Type.Int
    element :: if ir_untag(value_ty) == .Map(_, _, item) -> item else -> Type.Int
    if ir_untag(key_ty) != Type.String -> return ir_fail_slot(&b, span, "Dyn.Object over {ir_type_name(value_ty)}")
    pair_ty :: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: Type.String}, TypeTupleField{name: "value", ty: ty}}}
    output_ty :: Type.List{element: pair_ty}
    output_row :: ir_value_type(&m, p, output_ty) ?? return ir_type_fail(&b, span, output_ty)
    ir_scope_open(&b)
    source :: ir_expr(&m, p, &b, value)
    if ir_failed(b) || source < 0 {
        ir_scope_close(&m, &b)
        return -1
    }
    source_local :: tir_generated_local("encode_source_{source}", span)
    &b.bindings.push(IRBinding{name: source_local.name.copy(), slot: source, owned: b.fresh[source] && ir_has_drop(m, b, source)})
    b.fresh[source] = false
    // The pair List leaves the scope as the payload: its binding never owns it.
    output :: ir_list_empty(&m, &b, output_row)
    b.fresh[output] = false
    output_local :: tir_generated_local("encode_output_{output}", span)
    &b.bindings.push(IRBinding{name: output_local.name.copy(), slot: output})
    key_local :: tir_user_local("encode_key_{output}", span)
    item_local :: tir_user_local("encode_value_{output}", span)
    key_expr :: ir_node(&b, Type.String, TExprKind.Local{local: key_local}, span)
    item_expr :: ir_node(&b, element, TExprKind.Local{local: item_local}, span)
    encoded :: ir_node(&b, ty, TExprKind.HandleMethod{receiver: item_expr, operation: THandleOp.SerdeEncode, args: [TExpr]{}}, span)
    pair :: ir_node(&b, pair_ty, TExprKind.Tuple{values: [TExpr]{key_expr, encoded}}, span)
    output_expr :: ir_node(&b, output_ty, TExprKind.Local{local: output_local}, span)
    push :: ir_node(&b, Type.Named{name: "Unit"}, TExprKind.BuiltinMethod{receiver: output_expr, operation: TBuiltinOp.Push, args: [TExpr]{pair}}, span)
    source_ty :: value_ty
    source_expr :: ir_node(&b, source_ty, TExprKind.Local{local: source_local}, span)
    walk :: TStmt.ForIn{label: None, variable: key_local, variable_two: Val(item_local), source: source_expr, collection: source_expr, step: None, method_kind: None, columnar: false, by_value: false, source_stable: false, body: [TStmt]{TStmt.ExprStmt{value: push, span: span}}, span: span}
    ir_stmt(&m, p, &b, walk)
    ir_scope_close(&m, &b)
    if ir_failed(b) -> return -1
    b.fresh[output] = true
    ir_dyn_box(&m, p, &b, ty, "Object", output, span)
}

// `Dyn.<variant>(payload)` over an already built single payload, which the
// box takes.
fn ir_dyn_box(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, variant: String, payload: Int, span: Span) -> Int Never! {
    slot_type :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    row :: ir_type_def(p, "Dyn") ?? ir_enum_def(m, p, slot_type) ?? return ir_fail_slot(&b, span, "enum Dyn without a declaration")
    index :: ir_variant_index(p, row, variant) ?? return ir_fail_slot(&b, span, "variant {variant} not in Dyn")
    slot_args :: ir_row_args(m, slot_type)
    members :: ir_variant_members(&m, p, row, slot_args, index) ?? return ir_fail_slot(&b, span, "payload of {variant}")
    if members.len() != 1 -> return ir_fail_slot(&b, span, "Dyn.{variant} with {members.len()} payload values")
    size :: ir_enum_box_size(&m, p, row, slot_args) ?? return ir_fail_slot(&b, span, "layout of Dyn")
    boxed :: ir_box_alloc(&m, &b, size, slot_type)
    discriminant :: ir_word_const(&m, &b, index)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, discriminant, b.line)
    ir_member_store(&m, p, &b, boxed, members[0], payload)
    boxed
}

fn ir_present(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, value: TExpr, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    inner_row := -1
    if ir_untag(ty) == .Option(inner) {
        inner_row = ir_value_type(&m, p, inner) ?? return ir_type_fail(&b, span, inner)
    }
    if inner_row < 0 -> return ir_fail_slot(&b, span, "Present of {ir_type_name(ty)}")
    slot :: ir_value_as(&m, p, &b, value, inner_row, span)
    if ir_failed(b) -> return -1
    inner_size :: m.types[inner_row].size
    boxed :: ir_box_alloc(&m, &b, inner_size, row)
    ir_store_at(&m, p, &b, boxed, 0, slot)
    boxed
}

fn ir_result_ctor(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, value: TExpr, success: Bool, span: Span) -> Int Never! {
    payload_row := -1
    if ir_untag(ty) == .Result(ok_ty, err_ty) {
        payload_row = ir_value_type(&m, p, if success -> ok_ty else -> err_ty) ?? -1
    }
    if payload_row < 0 -> return ir_fail_slot(&b, span, "Result constructor of {ir_type_name(ty)}")
    slot :: ir_value_as(&m, p, &b, value, payload_row, span)
    if ir_failed(b) -> return -1
    ir_result_box(&m, p, &b, ty, success, slot)
}

// `return value`: a Unit executable return only evaluates it; any other
// return hands back the value as the executable return type. A returned
// `Err(...)` is where its failure starts: the journey's origin (codegen
// Statements.jet `.Return`, jet_codegen_lower_journey_origin).
fn ir_return(m: &IRModule, p: IRProgram, b: &IRBuilder, value: TExpr?, span: Span) Never! {
    returned :: value ?? return ir_return_fallthrough(&m, p, &b)
    if b.f.result < 0 {
        payload := returned
        if returned.kind == .Ok(inner) -> payload = inner
        slot :: ir_expr(&m, p, &b, payload)
        if ir_failed(b) -> return
        ir_release(&m, &b, slot)
        if b.ret != None && !b.plain -> return ir_return_fallthrough(&m, p, &b)
        ir_return_slot(&m, p, &b, -1, span)
        return
    }
    result_row :: b.f.result
    slot :: ir_value_as(&m, p, &b, returned, result_row, span)
    if ir_failed(b) -> return
    if slot < 0 -> return ir_fail(&b, span, "return of a value without a slot")
    if returned.kind == .Err(_) {
        ir_journey_origin(&m, p, &b, returned.span)
        if ir_failed(b) -> return
    }
    owned :: ir_own(&m, p, &b, slot)
    ir_return_slot(&m, p, &b, owned, span)
}

// A `?` site that joins the failure's journey (TryWithContext): its source
// location, its `?(note)`, and whether the operand's failure starts at this
// site (`fresh`, codegen jet_codegen_try_operand_starts_failure).
struct IRTrySite { note: TExpr?, file: String, line: Int, function: String, fresh: Bool }

// A Core call runs no program code, so its failure starts at the call; one
// that takes a callback may carry a failure out of program code instead.
fn ir_try_starts_failure(p: IRProgram, b: IRBuilder, operand: TExpr) -> Bool Never! {
    if operand.kind == .CoreCall(_, args, _, _, _, _) {
        loop arg in args {
            if ir_ty(p, b, arg) == .Fn(_, _, _, _, _, _) -> return false
        }
        return true
    }
    false
}

// `value?` (codegen jet_codegen_lower_try_value): the success payload, or
// the failure handed back to the caller. A plain `T Never!` call result is
// its own success. At a journey `site` the success edge drops the journey
// an earlier, handled failure left.
fn ir_try(m: &IRModule, p: IRProgram, b: &IRBuilder, value: TExpr, conversion: TTryConvert, site: IRTrySite?, span: Span) -> Int Never! {
    value_ty :: ir_ty(p, b, value)
    subject :: ir_expr(&m, p, &b, value)
    if ir_failed(b) || subject < 0 -> return subject
    ir_try_slot(&m, p, &b, subject, value_ty, conversion, site, span)
}

// `?` on the value in `subject`, of checked type `carrier`. A fresh carrier
// hands its success payload over (ir_box_take); a held one lends it.
fn ir_try_slot(m: &IRModule, p: IRProgram, b: &IRBuilder, subject: Int, carrier: Type, conversion: TTryConvert, site: IRTrySite?, span: Span) -> Int Never! {
    held :: m.types[b.f.slot_type[subject]].ty
    expected :: ir_untag(carrier)
    was_fresh :: b.fresh[subject]
    owned_subject :: was_fresh && ir_box_row(m, b.f.slot_type[subject])
    if expected == .Result(ok_ty, err_ty) {
        if !ir_is_result(held) -> return subject
        bool_row :: ir_type_row(&m, Type.Bool) ?? 0
        failed :: ir_temp(&m, &b, bool_row)
        is_ok :: ir_result_is_ok(&m, &b, subject)
        ir_emit(&b.f, IROp.Not, failed, is_ok, -1, -1, b.line)
        ir_open_if(&b.f, failed, b.line)
        ir_try_failure(&m, p, &b, subject, true, conversion == .Never || ir_never_type(err_ty), conversion, site, span)
        ir_end(&b.f, b.line)
        if ir_failed(b) -> return -1
        b.fresh[subject] = was_fresh
        if site != None {
            _ :: ir_runtime(&m, &b, "jet_journey_reset", [Int]{}, -1)
        }
        ok_row :: ir_value_type(&m, p, ok_ty) ?? return ir_type_fail(&b, span, ok_ty)
        if owned_subject -> return ir_box_take(&m, p, &b, subject, 8, ok_row)
        return ir_load_at(&m, &b, subject, 8, ok_row)
    }
    if expected == .Option(inner) {
        if !ir_is_option(held) -> return subject
        bool_row :: ir_type_row(&m, Type.Bool) ?? 0
        absent :: ir_temp(&m, &b, bool_row)
        present :: ir_option_is_some(&m, &b, subject)
        ir_emit(&b.f, IROp.Not, absent, present, -1, -1, b.line)
        ir_open_if(&b.f, absent, b.line)
        ir_try_failure(&m, p, &b, subject, false, false, conversion, site, span)
        ir_end(&b.f, b.line)
        if ir_failed(b) -> return -1
        b.fresh[subject] = was_fresh
        if site != None {
            _ :: ir_runtime(&m, &b, "jet_journey_reset", [Int]{}, -1)
        }
        inner_row :: ir_value_type(&m, p, inner) ?? return ir_type_fail(&b, span, inner)
        if owned_subject -> return ir_box_take(&m, p, &b, subject, 0, inner_row)
        return ir_load_at(&m, &b, subject, 0, inner_row)
    }
    subject
}

// The journey routes' source-site arguments in ABI order: file, line,
// column, function (codegen jet_codegen_try_site_values); the column is
// that of `span` in the building function's source.
fn ir_journey_site(m: &IRModule, p: IRProgram, b: &IRBuilder, file: String, line: Int, function: String, span: Span) -> [Int] Never! {
    if line < 1 || line > 4294967295 {
        ir_fail(&b, span, "journey site line {line} is outside the supported source range")
        return [Int]{}
    }
    column :: ir_source_column(p, b.f.source_file, span.start) ?? {
        ir_fail(&b, span, "journey site span falls outside its source")
        return [Int]{}
    }
    string_row :: ir_string_row(&m)
    file_text :: ir_temp(&m, &b, string_row)
    ir_emit(&b.f, IROp.ConstText, file_text, ir_intern_text(&m, file), -1, -1, b.line)
    line_word :: ir_word_const(&m, &b, line)
    column_word :: ir_word_const(&m, &b, column)
    function_text :: ir_temp(&m, &b, string_row)
    ir_emit(&b.f, IROp.ConstText, function_text, ir_intern_text(&m, function), -1, -1, b.line)
    [Int]{file_text, line_word, column_word, function_text}
}

// A returned `Err(...)` at `span` starts the journey (codegen
// jet_codegen_lower_journey_origin) at the span's line.
fn ir_journey_origin(m: &IRModule, p: IRProgram, b: &IRBuilder, span: Span) Never! {
    file :: b.f.source_file.copy()
    name :: b.f.name.copy()
    line :: ir_source_line_of(p, file, span.start) ?? 1
    values :: ir_journey_site(&m, p, &b, file, line, name, span)
    if ir_failed(b) -> return
    _ :: ir_runtime(&m, &b, "jet_journey_origin", values, -1)
}

// The hop of the failure edge at `site`: a failure that starts here drops
// the journey an earlier, handled failure left; then the site joins the
// journey, or, for a `?(note)` whose error is the default `Err`, becomes a
// context frame of `error` (codegen jet_codegen_lower_try_context). Returns
// the error the edge hands on: `error`, or the framed copy that replaces
// it.
fn ir_journey_hop(m: &IRModule, p: IRProgram, b: &IRBuilder, site: IRTrySite, error: Int, framed: Bool, span: Span) -> Int Never! {
    if site.fresh {
        _ :: ir_runtime(&m, &b, "jet_journey_reset", [Int]{}, -1)
    }
    values := ir_journey_site(&m, p, &b, site.file, site.line, site.function, span)
    if ir_failed(b) -> return -1
    note := -1
    if site.note == .Val(text) {
        note = ir_expr(&m, p, &b, text)
        if ir_failed(b) -> return -1
    } else {
        text_row :: ir_string_row(&m)
        note = ir_temp(&m, &b, text_row)
        ir_emit(&b.f, IROp.ConstText, note, ir_intern_text(&m, ""), -1, -1, b.line)
    }
    if framed {
        error_row :: b.f.slot_type[error]
        arguments := [Int]{error}
        loop value in values -> &arguments.push(value)
        &arguments.push(note)
        framed_error :: ir_runtime(&m, &b, "jet_err_with_context_frame", arguments, error_row)
        b.fresh[framed_error] = true
        ir_release(&m, &b, note)
        ir_release(&m, &b, error)
        return framed_error
    }
    &values.push(note)
    _ :: ir_runtime(&m, &b, "jet_journey_frame_text", values, -1)
    ir_release(&m, &b, note)
    error
}

// The failure edge of `?`: an impossible failure is unreachable; a Result
// carrier hands the Err box back, its error converted as `?` asks; an
// Option carrier returns None. A journey `site` joins the journey first.
fn ir_try_failure(m: &IRModule, p: IRProgram, b: &IRBuilder, subject: Int, is_result: Bool, never: Bool, conversion: TTryConvert, site: IRTrySite?, span: Span) Never! {
    if never {
        ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
        return
    }
    carrier :: b.failure.copy()
    if carrier == .Result(success, error) {
        if !is_result -> return ir_fail(&b, span, "`?` on an Option in a Result function")
        returned :: ir_try_reraise(&m, p, &b, subject, conversion, site, success, error, span)
        if ir_failed(b) -> return
        // An Err box another holder keeps leaves with one more owner.
        owned_error :: ir_own(&m, p, &b, returned)
        ir_return_slot(&m, p, &b, owned_error, span)
        return
    }
    optional := b.failure == .Optional(_)
    if b.plain {
        if b.ret == .Val(ret) {
            if ir_is_option(ret) -> optional = true
        }
    }
    // A Result here is a trait call's propagated carrier (ir_trait_propagate):
    // its failure leaves an Option function as None, as codegen's does.
    if optional && b.f.result >= 0 {
        if site == .Val(at) {
            _ :: ir_journey_hop(&m, p, &b, at, -1, false, span)
            if ir_failed(b) -> return
        }
        ir_release(&m, &b, subject)
        result_row :: b.f.result
        null :: ir_temp(&m, &b, result_row)
        ir_emit(&b.f, IROp.Const, null, 0, -1, -1, b.line)
        ir_return_slot(&m, p, &b, null, span)
        return
    }
    // An infallible or diverging function's failure edge is dead (codegen
    // jet_codegen_lower_try_value `.Infallible` / `.Diverges`).
    if b.failure == .Infallible || b.failure == .Diverges(_) {
        ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
        return
    }
    ir_fail(&b, span, "`?` without a matching failure carrier")
}

// `value ?? fallback` (codegen jet_codegen_lower_or_fallback).
fn ir_or_fallback(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, value: TExpr, fallback: TOrFallback, ambient: TLocal?, span: Span) -> Int Never! {
    value_ty :: ir_ty(p, b, value)
    subject :: ir_expr(&m, p, &b, value)
    if ir_failed(b) || subject < 0 -> return subject
    held :: m.types[b.f.slot_type[subject]].ty
    expected :: ir_untag(value_ty)
    offset := 0
    payload_ty := Type.Int
    error_ty := Type.Int
    is_result := false
    if expected == .Result(ok_ty, err_ty) {
        if !ir_is_result(held) -> return subject
        is_result = true
        offset = 8
        payload_ty = ok_ty
        error_ty = err_ty
    } else if expected == .Option(inner) {
        if !ir_is_option(held) -> return subject
        payload_ty = inner
    } else {
        return ir_fail_slot(&b, span, "`??` on {ir_type_name(value_ty)}")
    }
    result := -1
    if !ir_unit_type(ty) && !ir_never_type(ty) {
        row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
        result = ir_temp(&m, &b, row)
    }
    payload_row :: ir_value_type(&m, p, payload_ty) ?? return ir_type_fail(&b, span, payload_ty)
    // A fresh carrier hands a present payload over (ir_box_take) and is
    // dropped once the fallback has run.
    owned_subject :: b.fresh[subject] && ir_box_row(m, b.f.slot_type[subject])
    test :: if is_result -> ir_result_is_ok(&m, &b, subject) else -> ir_option_is_some(&m, &b, subject)
    ir_open_if(&b.f, test, b.line)
    payload :: if owned_subject -> ir_box_take(&m, p, &b, subject, offset, payload_row) else -> ir_load_at(&m, &b, subject, offset, payload_row)
    if result >= 0 && payload >= 0 {
        target_row :: b.f.slot_type[result]
        adapted :: ir_adapt(&m, p, &b, payload, target_row, span)
        if ir_failed(b) -> return -1
        ir_store(&m, p, &b, result, adapted)
    } else {
        ir_release(&m, &b, payload)
    }
    ir_else(&b.f, b.line)
    // The fallback sees the failure's error under the ambient binding
    // (codegen jet_codegen_lower_fallback_failure).
    mark :: b.bindings.len()
    if ambient == .Val(local) {
        if !is_result -> return ir_fail_slot(&b, span, "`??` ambient error binding on an Option")
        error_row :: ir_value_type(&m, p, error_ty) ?? return ir_type_fail(&b, span, error_ty)
        error :: ir_load_at(&m, &b, subject, 8, error_row)
        if error >= 0 -> &b.bindings.push(IRBinding{name: local.name, slot: error})
    }
    ir_fallback_route(&m, p, &b, fallback, result, span)
    ir_truncate_bindings(&b, mark)
    if owned_subject {
        b.fresh[subject] = true
        ir_release(&m, &b, subject)
    }
    ir_end(&b.f, b.line)
    if result >= 0 -> b.fresh[result] = ir_has_drop(m, b, result)
    result
}

// `base?.member` (codegen jet_codegen_lower_optional_field): an absent base
// stays absent; a present one's member, in a new Option box unless the
// member is itself the optional result (`flatten`).
fn ir_optional_field(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, base: TExpr, member: String, flatten: Bool, span: Span) -> Int Never! {
    base_ty :: ir_ty(p, b, base)
    inner_ty := Type.Int
    if ir_untag(base_ty) == .Option(inner) {
        inner_ty = inner
    } else {
        return ir_fail_slot(&b, span, "optional field of {ir_type_name(base_ty)}")
    }
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    inner_row :: ir_value_type(&m, p, inner_ty) ?? return ir_type_fail(&b, span, inner_ty)
    subject :: ir_expr(&m, p, &b, base)
    if ir_failed(b) || subject < 0 -> return -1
    result :: ir_temp(&m, &b, row)
    ir_emit(&b.f, IROp.Const, result, 0, -1, -1, b.line)
    present :: ir_option_is_some(&m, &b, subject)
    ir_open_if(&b.f, present, b.line)
    unwrapped :: ir_load_at(&m, &b, subject, 0, inner_row)
    if unwrapped < 0 || ir_kind_of(m, b, unwrapped) != .Aggregate -> return ir_fail_slot(&b, span, "optional field {member} of {ir_type_name(inner_ty)}")
    field :: ir_member_of(&m, p, b, unwrapped, member) ?? return ir_fail_slot(&b, span, "optional field {member} of {ir_type_name(inner_ty)}")
    selected :: ir_member_value(&m, &b, unwrapped, field)
    if selected < 0 -> return ir_fail_slot(&b, span, "optional field {member} of Unit")
    ir_optional_wrap(&m, p, &b, result, selected, flatten, span)
    ir_end(&b.f, b.line)
    ir_release(&m, &b, subject)
    b.fresh[result] = ir_has_drop(m, b, result)
    result
}

// `base?.method(args)` (codegen jet_codegen_lower_optional_method_call): the
// call runs only on a present base, with `binding` naming its payload; its
// value in a new Option box unless it is itself the optional result.
fn ir_optional_call(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, base: TExpr, binding: TLocal, call: TExpr, flatten: Bool, span: Span) -> Int Never! {
    base_ty :: ir_ty(p, b, base)
    inner_ty := Type.Int
    if ir_untag(base_ty) == .Option(inner) {
        inner_ty = inner
    } else {
        return ir_fail_slot(&b, span, "optional method call on {ir_type_name(base_ty)}")
    }
    row := -1
    if !ir_unit_type(ty) && !ir_never_type(ty) {
        value_row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
        row = value_row
    }
    inner_row :: ir_value_type(&m, p, inner_ty) ?? return ir_type_fail(&b, span, inner_ty)
    subject :: ir_expr(&m, p, &b, base)
    if ir_failed(b) || subject < 0 -> return -1
    result :: if row >= 0 -> ir_temp(&m, &b, row) else -> -1
    if result >= 0 -> ir_emit(&b.f, IROp.Const, result, 0, -1, -1, b.line)
    present :: ir_option_is_some(&m, &b, subject)
    ir_open_if(&b.f, present, b.line)
    mark :: b.bindings.len()
    unwrapped :: ir_load_at(&m, &b, subject, 0, inner_row)
    if unwrapped >= 0 -> &b.bindings.push(IRBinding{name: binding.name, slot: unwrapped})
    called :: ir_expr(&m, p, &b, call)
    if ir_failed(b) -> return -1
    if result >= 0 && called >= 0 {
        ir_optional_wrap(&m, p, &b, result, called, flatten, span)
    } else {
        ir_release(&m, &b, called)
    }
    ir_truncate_bindings(&b, mark)
    ir_end(&b.f, b.line)
    ir_release(&m, &b, subject)
    if result >= 0 -> b.fresh[result] = ir_has_drop(m, b, result)
    result
}

// Writes the present value of an optional chain into `result`: `value`
// itself when it is the Option (`flatten`), else a new box holding an owned
// copy of it.
fn ir_optional_wrap(m: &IRModule, p: IRProgram, b: &IRBuilder, result: Int, value: Int, flatten: Bool, span: Span) Never! {
    owned :: if ir_kind_of(m, b, value) == .Aggregate && !b.fresh[value] -> ir_copy_value(&m, p, &b, value, span) else -> value
    if flatten -> return ir_store(&m, p, &b, result, owned)
    size :: m.types[b.f.slot_type[owned]].size
    option_row :: b.f.slot_type[result]
    boxed :: ir_box_alloc(&m, &b, size, option_row)
    ir_store_at(&m, p, &b, boxed, 0, owned)
    ir_emit(&b.f, IROp.Copy, result, boxed, -1, -1, b.line)
}

fn ir_fallback_route(m: &IRModule, p: IRProgram, b: &IRBuilder, fallback: TOrFallback, result: Int, span: Span) Never! {
    if fallback == {
        .Value(alternative) -> {
            target_row :: if result >= 0 -> b.f.slot_type[result] else -> -1
            slot :: if result >= 0 -> ir_value_as(&m, p, &b, alternative, target_row, span) else -> ir_expr(&m, p, &b, alternative)
            if ir_failed(b) -> return
            if result >= 0 && slot >= 0 -> ir_store(&m, p, &b, result, slot)
            if result < 0 -> ir_release(&m, &b, slot)
        }
        .Return(returned) -> ir_return(&m, p, &b, returned, span)
        .Panic(message, location) -> {
            slot :: ir_expr(&m, p, &b, message)
            if ir_failed(b) -> return
            message_ty :: ir_ty(p, b, message)
            text :: ir_render(&m, p, &b, message_ty, slot, IRRender.Display, span)
            if ir_failed(b) -> return
            left :: ir_word_const(&m, &b, 0)
            right :: ir_word_const(&m, &b, 0)
            ir_stop(&m, p, &b, 2, text, left, right, ir_report_location(p, location))
        }
        .Break -> ir_loop_jump(&m, p, &b, None, true, span)
        .Continue -> ir_loop_jump(&m, p, &b, None, false, span)
        .BreakLabel(label) -> ir_loop_jump(&m, p, &b, Val(label), true, span)
        .ContinueLabel(label) -> ir_loop_jump(&m, p, &b, Val(label), false, span)
    }
}

fn ir_loop_jump(m: &IRModule, p: IRProgram, b: &IRBuilder, label: String?, exit: Bool, span: Span) Never! {
    frame :: ir_loop_frame(b, label) ?? return ir_fail(&b, span, "break or next outside a loop")
    ir_tx_unwind_loop(&m, p, &b, frame.exit, span)
    ir_drop_bindings(&m, &b, frame.mark)
    depth :: ir_depth(b.f, if exit -> frame.exit else -> frame.next)
    ir_emit(&b.f, IROp.Br, -1, depth, -1, -1, b.line)
}

fn ir_list_literal(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, values: [TExpr], span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    element_row := -1
    // A `[T#N]` literal is the List of its N elements (codegen BuildList).
    if ir_untag(ty) == {
        .List(element) | .FixedList(element, _) -> element_row = ir_value_type(&m, p, element) ?? -1
        else -> {}
    }
    if element_row < 0 -> return ir_fail_slot(&b, span, "list literal of {ir_type_name(ty)}")
    elements := [Int]{}
    loop value in values {
        slot :: ir_value_as(&m, p, &b, value, element_row, span)
        if ir_failed(b) -> return -1
        &elements.push(slot)
    }
    ir_list_from(&m, p, &b, row, element_row, elements)
}

// `[a, ..xs, b]` (codegen jet_codegen_lower_list_spread): a new List of
// each element part's value and a copy of every element of each spread
// list, in order.
fn ir_list_spread(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, parts: [TListSpreadPart], span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    element_row := -1
    if ir_untag(ty) == .List(element) {
        element_row = ir_value_type(&m, p, element) ?? -1
    }
    if element_row < 0 -> return ir_fail_slot(&b, span, "list spread of {ir_type_name(ty)}")
    list :: ir_list_empty(&m, &b, row)
    loop part in parts {
        if part == {
            .Element(value) -> {
                slot :: ir_value_as(&m, p, &b, value, element_row, span)
                if ir_failed(b) -> return -1
                ir_list_push(&m, p, &b, list, element_row, slot)
            }
            .Spread(value) -> {
                source :: ir_expr(&m, p, &b, value)
                if ir_failed(b) || source < 0 -> return -1
                value_ty :: ir_ty(p, b, value)
                source_row :: ir_list_element(&m, p, b, source) ?? return ir_fail_slot(&b, span, "list spread of {ir_type_name(value_ty)}")
                if source_row != element_row -> return ir_fail_slot(&b, span, "list spread of {ir_type_name(value_ty)} into {ir_type_name(ty)}")
                walk :: ir_walk_open(&m, &b, source, element_row)
                element :: if ir_kind_of(m, b, walk.item) == .Aggregate -> ir_copy_value(&m, p, &b, walk.item, span) else -> walk.item
                ir_list_push(&m, p, &b, list, element_row, element)
                ir_walk_close(&m, &b, walk)
                ir_release(&m, &b, source)
            }
        }
    }
    list
}

fn ir_list_index(m: &IRModule, p: IRProgram, b: &IRBuilder, base: TExpr, index: TExpr, span: Span) -> Int Never! {
    base_ty :: ir_ty(p, b, base)
    list :: ir_expr(&m, p, &b, base)
    if ir_failed(b) || list < 0 -> return -1
    row :: ir_list_element(&m, p, b, list) ?? return ir_fail_slot(&b, span, "index read of {ir_type_name(base_ty)}")
    address :: ir_checked_element(&m, p, &b, list, index, row, span)
    if ir_failed(b) -> return -1
    ir_load_at(&m, &b, address, 0, row)
}

// `list[index] (op)= value`: the element's old value ends when replaced; an
// `initializing` write fills a slot of `[T#N]{ uninit }` that holds none.
// The value comes before the place (ir_assign_place): a value that grows the
// List would leave an element address in its old buffer, and one that keeps
// a copy of it would share the buffer made unique for the write.
fn ir_list_index_assign(m: &IRModule, p: IRProgram, b: &IRBuilder, base: TExpr, index: TExpr, op: TBinaryOp?, value: TExpr, initializing: Bool, span: Span) Never! {
    value_ty :: ir_ty(p, b, value)
    base_ty :: ir_ty(p, b, base)
    list_row :: ir_value_type(&m, p, base_ty) ?? return ir_fail(&b, span, "index write of {ir_type_name(base_ty)}")
    row :: ir_list_element_of(&m, p, list_row) ?? return ir_fail(&b, span, "index write of {ir_type_name(base_ty)}")
    slot := ir_value_as(&m, p, &b, value, row, span)
    if ir_failed(b) -> return
    list :: ir_write_base(&m, p, &b, base, span)
    ir_make_unique(&m, p, &b, list)
    if ir_failed(b) || list < 0 -> return
    address :: ir_checked_element(&m, p, &b, list, index, row, span)
    if ir_failed(b) || slot < 0 -> return
    current := -1
    if op == .Val(binary) {
        current = ir_load_at(&m, &b, address, 0, row)
        site :: b.line
        right :: slot
        element_ty :: m.types[row].ty
        slot = ir_binary(&m, p, &b, binary, false, site, element_ty, current, right, value_ty, span)
        ir_release(&m, &b, right)
        if ir_failed(b) -> return
    }
    if m.types[row].drop != "" && !initializing {
        old :: if current >= 0 -> current else -> ir_load_at(&m, &b, address, 0, row)
        ir_emit(&b.f, IROp.Drop, -1, old, -1, -1, b.line)
    }
    ir_store_at(&m, p, &b, address, 0, slot)
}

// `loop x in xs` / `loop (i, x) in xs` over a List: an index walk.
fn ir_list_walk(m: &IRModule, p: IRProgram, b: &IRBuilder, label: String?, variable: TLocal, variable_two: TLocal?, collection: TExpr, body: [TStmt], span: Span) Never! {
    collection_ty :: ir_ty(p, b, collection)
    list :: ir_expr(&m, p, &b, collection)
    if ir_failed(b) || list < 0 -> return
    row :: ir_list_element(&m, p, b, list) ?? return ir_fail(&b, span, "loop over {ir_type_name(collection_ty)}")
    stride :: ir_list_stride(m, row)
    ir_scope_open(&b)
    length :: ir_load_word(&m, &b, list, 0)
    data :: ir_load_word(&m, &b, list, 16)
    index :: ir_word_const(&m, &b, 0)
    exit :: ir_open(&b.f, IROp.Block, b.line)
    _ :: ir_open(&b.f, IROp.Loop, b.line)
    more :: ir_bool_op(&m, &b, IROp.Lt, index, length)
    ir_exit_unless(&m, &b, more, exit)
    step_block :: ir_open(&b.f, IROp.Block, b.line)
    &b.loops.push(IRLoopFrame{label: label, exit: exit, next: step_block, mark: b.bindings.len()})
    address :: ir_element_address(&m, &b, data, index, stride)
    item :: ir_load_at(&m, &b, address, 0, row)
    map_shape := IRMapShape?{None}
    if ir_map_entry_type(collection_ty) != None -> map_shape = ir_map_shape(&m, p, b.f.slot_type[list])
    if variable_two == .Val(second) && map_shape == .Val(shape) {
        // `loop (k, v) in map`: the entry's key and value.
        key :: ir_load_at(&m, &b, item, shape.key.offset, shape.key.ty)
        value :: ir_load_at(&m, &b, item, shape.value.offset, shape.value.ty)
        if key >= 0 -> &b.bindings.push(IRBinding{name: variable.name, slot: key})
        if value >= 0 -> &b.bindings.push(IRBinding{name: second.name, slot: value})
    } else if variable_two == .Val(second) {
        position :: ir_new_slot(&b, ir_type_row(&m, Type.Int) ?? 0, IRSlotKind.Local, ir_intern_name(&m, variable.name))
        ir_emit(&b.f, IROp.Copy, position, index, -1, -1, b.line)
        &b.bindings.push(IRBinding{name: variable.name, slot: position})
        if item >= 0 -> &b.bindings.push(IRBinding{name: second.name, slot: item})
    } else if item >= 0 {
        &b.bindings.push(IRBinding{name: variable.name, slot: item})
    }
    ir_stmts(&m, p, &b, body)
    _ :: &b.loops.pop()
    ir_end(&b.f, b.line)
    one :: ir_word_const(&m, &b, 1)
    ir_emit(&b.f, IROp.Add, index, index, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(&b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    ir_scope_close(&m, &b)
}

// A tuple value in fresh frame storage: each value at the member of its
// name, or of its position when the type names it otherwise.
fn ir_tuple_literal(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, names: [String], values: [TExpr], span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    members := [IRMember]{}
    if ir_untag(ir_subst(m, ty)) == .Tuple(fields) {
        members = ir_tuple_members(&m, p, fields) ?? return ir_type_fail(&b, span, ty)
    }
    if members.len() != values.len() -> return ir_fail_slot(&b, span, "tuple literal of {ir_type_name(ty)}")
    slots := [Int]{}
    loop (index, value) in values {
        member := members[index]
        loop candidate in members {
            if candidate.name == names[index] -> member = candidate
        }
        slot :: ir_value_as(&m, p, &b, value, member.ty, span)
        if ir_failed(b) -> return -1
        &slots.push(slot)
    }
    storage :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
    loop (index, slot) in slots {
        member := members[index]
        loop candidate in members {
            if candidate.name == names[index] -> member = candidate
        }
        ir_store_at(&m, p, &b, storage, member.offset, slot)
    }
    storage
}

// `base[start..end]` (codegen jet_codegen_lower_slice, Lower lower_slice): the
// runtime checks the bounds and picks the stop; a String slices through
// jet_rt_string_slice_range, a List's window header is a View as is and
// gets a buffer of its own as a List.
fn ir_slice(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, base: TExpr, start: TExpr, end: TExpr, range: TExpr?, location: TPanicLoc, span: Span) -> Int Never! {
    base_ty :: ir_ty(p, b, base)
    receiver := base
    if base.kind == .Clone(inner, _) -> receiver = inner
    if ir_untag(ir_ty(p, b, receiver)) == .Apply(name, view_args) {
        if (name == "View" || name == "ViewMut") && view_args.len() == 1 {
            // A declared view's subrange reborrows its owner.
            args :: if range == .Val(range_expr) -> [TExpr]{range_expr} else -> [TExpr]{start, end}
            view_type :: Type.Apply{name: "View", args: [Type]{view_args[0]}}
            view :: ir_node(&b, view_type, TExprKind.BuiltinMethod{receiver: receiver, operation: TBuiltinOp.ViewNew{line: location.line}, args: args}, span)
            return ir_expr(&m, p, &b, view)
        }
    }
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    source :: ir_expr(&m, p, &b, base)
    if ir_failed(b) || source < 0 -> return -1
    text :: ir_untag(base_ty) == Type.String
    bounds :: ir_slice_bounds(&m, p, &b, start, end, range, text, span)
    if ir_failed(b) || bounds.len() != 3 -> return -1
    if location.line > 0 -> b.line = location.line
    args := [Int]{source}
    loop bound in bounds -> &args.push(bound)
    if text {
        loop value in ir_location(&m, &b, location.line) -> &args.push(value)
        result :: ir_runtime(&m, &b, "jet_rt_string_slice_range", args, row)
        ir_release(&m, &b, source)
        return result
    }
    element_row :: ir_list_element(&m, p, b, source) ?? return ir_fail_slot(&b, span, "slice of {ir_type_name(base_ty)}")
    view :: ir_is_view(ty)
    window :: ir_list_window(&m, &b, row, source, element_row, bounds, location.line, view)
    if view -> return window
    // A window borrows the source's buffer, so the List gets one of its own.
    owned :: ir_list_clone(&m, p, &b, window, element_row, row)
    ir_release(&m, &b, source)
    owned
}

// The window header of a List or View `source` over the native `bounds`
// (Lower lower_slice_window): the runtime checks them and picks the stop;
// a View's window keeps borrowing the source buffer.
fn ir_list_window(m: &IRModule, b: &IRBuilder, row: Int, source: Int, element_row: Int, bounds: [Int], line: Int, view: Bool) -> Int Never! {
    stop_args := [Int]{bounds[0], bounds[1], bounds[2], ir_load_word(&m, &b, source, 0)}
    loop value in ir_location(&m, &b, line) -> &stop_args.push(value)
    word_row :: ir_word_row(&m)
    stop :: ir_runtime(&m, &b, if view -> "jet_rt_view_end" else -> "jet_rt_slice_end", stop_args, word_row)
    window :: ir_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, window, 24, 8, -1, b.line)
    length :: ir_word_op(&m, &b, IROp.Sub, stop, bounds[0])
    ir_emit(&b.f, IROp.Store, -1, window, 0, length, b.line)
    none :: ir_word_const(&m, &b, 0)
    ir_emit(&b.f, IROp.Store, -1, window, 8, none, b.line)
    data :: ir_load_word(&m, &b, source, 16)
    stride :: ir_list_stride(m, element_row)
    first :: ir_element_address(&m, &b, data, bounds[0], stride)
    ir_emit(&b.f, IROp.Store, -1, window, 16, first, b.line)
    window
}

// `base.view(range)` / a declared view's subrange (Lower lower_view_new):
// the View window of the List or View receiver, which it borrows.
fn ir_view_new(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: TExpr, args: [TExpr], line: Int, span: Span) -> Int Never! {
    receiver_ty :: ir_ty(p, b, receiver)
    if ir_view_element(ty) == None -> return ir_fail_slot(&b, span, "a view of type {ir_type_name(ty)}")
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    source :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || source < 0 -> return -1
    element_row :: ir_list_element(&m, p, b, source) ?? return ir_fail_slot(&b, span, "a view of {ir_type_name(receiver_ty)}")
    // copy: `args[0]` stays in the read parameter `args`; the optional range owns this one
    bounds :: if args.len() == {
        1 -> ir_slice_bounds(&m, p, &b, args[0], args[0], Val(args[0].copy()), false, span)
        2 -> ir_slice_bounds(&m, p, &b, args[0], args[1], None, false, span)
        else -> { return ir_fail_slot(&b, span, "a view with {args.len()} bounds") }
    }
    if ir_failed(b) || bounds.len() != 3 -> return -1
    if line > 0 -> b.line = line
    ir_list_window(&m, &b, row, source, element_row, bounds, line, true)
}

fn ir_is_view(ty: Type) -> Bool Never! {
    if ir_untag(ty) == .Apply(name, args) -> return name == "View" && args.len() == 1
    false
}

// A view (or fixed list) copied out as the owned collection `ty` (codegen
// jet_codegen_collection_materialize_view): the source's header read as
// `ty`'s, its elements copied, and a fresh owned source dropped.
fn ir_materialize_view(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, value: TExpr, span: Span) -> Int Never! {
    value_ty :: ir_ty(p, b, value)
    slot :: ir_expr(&m, p, &b, value)
    if ir_failed(b) || slot < 0 -> return slot
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    have :: b.f.slot_type[slot]
    source := slot
    if have != row {
        if m.types[have].kind != m.types[row].kind || m.types[have].size != m.types[row].size -> return ir_fail_slot(&b, span, "view {ir_type_name(value_ty)} materialized as {ir_type_name(ty)}")
        source = ir_temp(&m, &b, row)
        ir_emit(&b.f, IROp.Copy, source, slot, -1, -1, b.line)
    }
    // A view borrows its owner's buffer, so the List gets one of its own.
    copied :: if ir_list_element(&m, p, b, source) == .Val(element_row) -> ir_list_clone(&m, p, &b, source, element_row, row) else -> ir_copy_value(&m, p, &b, source, span)
    ir_release(&m, &b, slot)
    copied
}

// A slice's (start, end, exclusive) as native words and a Bool (Lower
// lower_slice_bounds): a Range value's fields, or the bare bounds with the
// kernel's own stop (exclusive for a String, inclusive for a List).
fn ir_slice_bounds(m: &IRModule, p: IRProgram, b: &IRBuilder, start: TExpr, end: TExpr, range: TExpr?, text: Bool, span: Span) -> [Int] Never! {
    bounds := [Int]{}
    if range == .Val(range_expr) {
        value :: ir_expr(&m, p, &b, range_expr)
        if ir_failed(b) || value < 0 -> return bounds
        range_expr_ty :: ir_ty(p, b, range_expr)
        if ir_kind_of(m, b, value) != .Aggregate -> return ir_fail_bounds(&b, span, "slice range of {ir_type_name(range_expr_ty)}")
        names :: [String]{"start", "end", "exclusive"}
        loop name in names {
            range_expr_type :: ir_ty(p, b, range_expr)
            member :: ir_member_of(&m, p, b, value, name) ?? return ir_fail_bounds(&b, span, "slice range of {ir_type_name(range_expr_type)} without {name}")
            &bounds.push(ir_member_value(&m, &b, value, member))
        }
    } else {
        operands :: [TExpr]{start, end}
        loop bound in operands {
            value :: ir_expr(&m, p, &b, bound)
            if ir_failed(b) || value < 0 -> return [Int]{}
            &bounds.push(value)
        }
        bool_row :: ir_type_row(&m, Type.Bool) ?? 0
        flag :: ir_temp(&m, &b, bool_row)
        ir_emit(&b.f, IROp.Const, flag, if text -> 1 else -> 0, -1, -1, b.line)
        &bounds.push(flag)
    }
    loop index in 0..<2 {
        bounds[index] = ir_native_index(&m, &b, bounds[index], span)
    }
    if ir_failed(b) -> return [Int]{}
    bounds
}

fn ir_fail_bounds(b: &IRBuilder, span: Span, message: String) -> [Int] Never! {
    ir_fail(&b, span, message)
    [Int]{}
}

// `start..end` / `start..<end` as a value (codegen
// jet_codegen_lower_range_value): a Range struct of its bounds and stop.
fn ir_range_value(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, start: TExpr, end: TExpr, exclusive: Bool, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    if m.types[row].kind != .Aggregate -> return ir_fail_slot(&b, span, "range value of {ir_type_name(ty)}")
    first :: ir_expr(&m, p, &b, start)
    if ir_failed(b) -> return -1
    last :: ir_expr(&m, p, &b, end)
    if ir_failed(b) -> return -1
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    flag :: ir_temp(&m, &b, bool_row)
    ir_emit(&b.f, IROp.Const, flag, if exclusive -> 1 else -> 0, -1, -1, b.line)
    storage :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
    names :: [String]{"start", "end", "exclusive"}
    values :: [Int]{first, last, flag}
    loop (index, name) in names {
        member :: ir_member_of(&m, p, b, storage, name) ?? return ir_fail_slot(&b, span, "range value of {ir_type_name(ty)} without {name}")
        ir_store_at(&m, p, &b, storage, member.offset, values[index])
    }
    storage
}

// `&place` / `&write place` as a value: a read of a list window is the View
// over the list's storage (codegen jet_codegen_list_read_view); any other
// read is the place's value, which its holder keeps; a written aggregate is
// the address of its storage.
fn ir_borrow(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, value: TExpr, access: AccessConvention, span: Span) -> Int Never! {
    value_ty :: ir_ty(p, b, value)
    if access == .Read {
        if value.kind == .Slice(base, start, end, range, location) {
            if ir_is_view(ty) -> return ir_slice(&m, p, &b, ty, base, start, end, range, location, span)
        }
        return ir_expr(&m, p, &b, value)
    }
    if access == .Write {
        if value.kind == .Slice(base, start, end, range, location) {
            view_ty :: if ir_untag(ir_ty(p, b, base)) == .List(element) -> Type.Apply{name: "View", args: [Type]{element}} else -> ty
            return ir_slice(&m, p, &b, view_ty, base, start, end, range, location, span)
        }
        place :: ir_write_base(&m, p, &b, value, span)
        if ir_failed(b) || place < 0 -> return place
        if ir_kind_of(m, b, place) == .Aggregate -> return place
        // An Option or enum box is written through its payload in place
        // (`if &x == .Variant(payload) -> ... &payload`); a call's write
        // argument goes through ir_place_address instead.
        if ir_kind_of(m, b, place) == .Pointer {
            place_row :: b.f.slot_type[place]
            if ir_is_option(value_ty) || ir_enum_def(m, p, place_row) != None -> return place
        }
    }
    ir_fail_slot(&b, span, "borrow {access} of {ir_type_name(value_ty)}")
}

// ---------------------------------------------------------------------------
// Closures (Lower Closures.jet layout): a heap box with its reference count
// at 0, its code address at 8, a release helper at 16 (none yet) and the
// captures from 24. The code takes the box as its hidden first parameter. A
// capture the body writes is held by address: its variable becomes a frame
// cell from the closure's creation on.
//
// The lambda's function is keyed by its enclosing function, its own source
// span and its occurrence there: the merge shares functions by key, and the
// branches of a `task.all` share one call span, so a key from the call span
// would hand every branch the first branch's body.

fn ir_lambda(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, lambda: TLambda, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    captures := [IRCaptureSlot]{}
    offset := 24
    loop capture in lambda.captures {
        binding :: ir_lookup_binding(b, capture.source) ?? ir_lookup_binding(b, capture.local.name) ?? return ir_fail_slot(&b, span, "capture of unknown local {capture.source}")
        by_ref :: lambda.capture_facts.mutable.contains(capture.source) || lambda.capture_facts.mutable.contains(capture.local.name)
        value_row :: if binding.indirect >= 0 -> binding.indirect else -> b.f.slot_type[binding.slot]
        size :: if by_ref -> 8 else -> ir_align8(m.types[value_row].size)
        &captures.push(IRCaptureSlot{name: capture.local.name, offset: offset, row: value_row, by_ref: by_ref})
        offset += size
    }
    boxed :: ir_box_alloc(&m, &b, offset, row)
    one :: ir_word_const(&m, &b, 1)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, one, b.line)
    none :: ir_word_const(&m, &b, 0)
    ir_emit(&b.f, IROp.Store, -1, boxed, 16, none, b.line)
    loop (index, capture) in lambda.captures {
        slot :: captures[index]
        source :: if ir_lookup_binding(b, capture.source) != None -> capture.source else -> capture.local.name
        binding :: ir_lookup_binding(b, source) ?? return -1
        if slot.by_ref {
            address :: if binding.indirect >= 0 || m.types[slot.row].kind == .Aggregate -> binding.slot else -> ir_cell_binding(&m, &b, source)
            ir_emit(&b.f, IROp.Store, -1, boxed, slot.offset, address, b.line)
        } else {
            // A capture copies the variable, which stays its own owner.
            captured :: ir_read_binding(&m, &b, binding)
            kept :: if m.types[b.f.slot_type[captured]].kind == .Aggregate -> ir_copy_value(&m, p, &b, captured, span) else -> captured
            ir_store_at(&m, p, &b, boxed, slot.offset, kept)
        }
    }
    id :: m.functions.len()
    base_key :: "{b.f.key}#lambda@{lambda.source_span.start}..{lambda.source_span.end}"
    occurrence :: b.lambdas.get(base_key) ?? 0
    b.lambdas[base_key] = occurrence + 1
    lambda_key :: if occurrence == 0 -> base_key else -> "{base_key}#{occurrence}"
    &m.functions.push(ir_function_new("{b.f.name}.lambda@{lambda.source_span.start}", lambda_key, "{b.f.symbol}__lambda_{ir_key_hash(lambda_key)}", b.f.source_file, b.line))
    &m.lambdas.push(IRLambdaJob{lambda: lambda, captures: captures, source_file: b.f.source_file, line: b.line, subst_names: m.subst_names, subst_types: m.subst_types, row: b.row, nodes: b.nodes, next_node: b.next_node})
    &m.queue.push(IRQueued{row: -1, id: id, args: [Type]{}, lambda: m.lambdas.len() - 1})
    pointer_row :: ir_pointer_row(&m)
    code :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.FunctionAddress, code, id, -1, -1, b.line)
    ir_emit(&b.f, IROp.Store, -1, boxed, 8, code, b.line)
    boxed
}

// Moves the variable `name` into a frame cell and rebinds it to the cell's
// address; returns the address.
fn ir_cell_binding(m: &IRModule, b: &IRBuilder, name: String) -> Int Never! {
    index := b.bindings.len() - 1
    loop index >= 0 {
        if b.bindings[index].name == name -> break
        index -= 1
    }
    slot :: b.bindings[index].slot
    row :: b.f.slot_type[slot]
    size :: m.types[row].size
    pointer_row :: ir_pointer_row(&m)
    cell :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.StackAddress, cell, if size < 8 -> 8 else -> size, 8, -1, b.line)
    ir_emit(&b.f, IROp.Store, -1, cell, 0, slot, b.line)
    b.bindings[index] = IRBinding{name: name, slot: cell, indirect: row, owned: b.bindings[index].owned, symbol: b.bindings[index].symbol, live: b.bindings[index].live}
    cell
}

fn ir_build_lambda(m: &IRModule, p: IRProgram, b: &IRBuilder, job: IRLambdaJob) Never! {
    lambda :: job.lambda
    b.line = job.line
    span :: lambda.source_span
    env :: ir_new_slot(&b, ir_pointer_row(&m), IRSlotKind.Param, ir_intern_name(&m, "closure"))
    loop (index, ty) in lambda.param_types {
        name :: if index < lambda.source_params.len() -> lambda.source_params[index] else -> "_{index}"
        if ir_param_slot(&m, p, &b, ty, false, false, name) == None -> return ir_fail(&b, span, "lambda parameter type {ir_type_name(ty)}")
    }
    loop capture in job.captures {
        aggregate :: m.types[capture.row].kind == .Aggregate
        if capture.by_ref {
            pointer_row :: ir_pointer_row(&m)
            address :: ir_temp(&m, &b, if aggregate -> capture.row else -> pointer_row)
            ir_emit(&b.f, IROp.Load, address, env, capture.offset, -1, b.line)
            // A captured aggregate is the outer variable's storage: a whole
            // assignment in the body writes through it.
            &b.bindings.push(IRBinding{name: capture.name, slot: address, indirect: if aggregate -> -1 else -> capture.row, write: aggregate})
        } else {
            pointer_row :: ir_pointer_row(&m)
            address :: ir_temp(&m, &b, if aggregate -> capture.row else -> pointer_row)
            ir_emit(&b.f, IROp.Offset, address, env, capture.offset, -1, b.line)
            &b.bindings.push(IRBinding{name: capture.name, slot: address, indirect: if aggregate -> -1 else -> capture.row})
        }
    }
    if lambda.executable == {
        .Expr(value) -> {
            names := [String]{}
            ir_collect_mutable_captures(value, &names)
            b.cells = names
        }
        .Block(body) -> b.cells = ir_mutable_captures(body)
    }
    b.failure = lambda.failure_carrier
    b.ret = lambda.ret
    if lambda.ret == .Val(ret) {
        if !ir_unit_type(ret) && !ir_never_type(ret) {
            result_row :: ir_value_type(&m, p, ret) ?? return ir_fail(&b, span, "lambda result type {ir_type_name(ret)}")
            b.f.result = result_row
        }
    }
    if lambda.executable == {
        .Expr(value) -> ir_return(&m, p, &b, Val(value), span)
        .Block(body) -> {
            ir_stmts(&m, p, &b, body)
            if !ir_failed(b) -> ir_return_fallthrough(&m, p, &b)
        }
    }
}

// A call through a closure box: its code with the box as the hidden first
// argument (Lower Closures.jet).
fn ir_indirect_call(m: &IRModule, p: IRProgram, b: &IRBuilder, callee: TExpr, args: [TCallArg], signature: Type, span: Span) -> Int Never! {
    params := [Type]{}
    returned := Type?{None}
    if ir_untag(ir_subst(m, signature)) == .Fn(fn_params, fn_ret, _, _, _, _) {
        params = fn_params
        returned = fn_ret
    } else {
        return ir_fail_slot(&b, span, "indirect call through {ir_type_name(signature)}")
    }
    if params.len() != args.len() -> return ir_fail_slot(&b, span, "indirect call with defaulted or variadic arguments")
    boxed :: ir_expr(&m, p, &b, callee)
    if ir_failed(b) || boxed < 0 -> return -1
    slots := [Int]{boxed}
    loop (index, arg) in args {
        if arg.mut_borrow || arg.spread -> return ir_fail_slot(&b, span, "write or spread argument of an indirect call")
        row :: ir_value_type(&m, p, params[index]) ?? return ir_fail_slot(&b, span, "argument type {params[index]}")
        slot :: ir_value_as(&m, p, &b, arg.value, row, span)
        if ir_failed(b) -> return -1
        if slot < 0 -> return ir_fail_slot(&b, span, "Unit argument of an indirect call")
        &slots.push(slot)
    }
    pointer_row :: ir_pointer_row(&m)
    code :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.Load, code, boxed, 8, -1, b.line)
    dst := -1
    if returned == .Val(ret) {
        if !ir_unit_type(ret) && !ir_never_type(ret) {
            result_row :: ir_value_type(&m, p, ret) ?? return ir_type_fail(&b, span, ret)
            dst = ir_fresh_temp(&m, &b, result_row)
        }
    }
    start :: ir_args(&b.f, slots)
    ir_emit(&b.f, IROp.CallIndirect, dst, code, start, slots.len(), b.line)
    loop (index, slot) in slots {
        if index > 0 -> ir_release(&m, &b, slot)
    }
    dst
}

// A checked constant read: a borrow of its static object (BuildStatic.jet)
// when its value freezes, else its compile-time value built in place. A
// read of module storage loads its cell.
fn ir_constant(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, key: String, span: Span) -> Int Never! {
    if p.rows.get(key) != None -> return ir_function_value(&m, p, &b, ty, key, span)
    definition :: p.constants.get(key) ?? return ir_fail_slot(&b, span, "constant {key} without a declaration")
    if definition.is_storage {
        address :: ir_storage_address(&m, p, &b, definition, span)
        if address < 0 -> return -1
        row :: ir_value_type(&m, p, definition.ty) ?? return ir_type_fail(&b, span, definition.ty)
        return ir_load_at(&m, &b, address, 0, row)
    }
    borrowed :: ir_static_read(&m, p, &b, ty, key, definition.value)
    if borrowed >= 0 -> return borrowed
    ir_comptime(&m, p, &b, ty, definition.value, span)
}

// A named function used as a value of the function type `ty`: a closure
// box (no captures) whose code is an adapter taking the box first, then the
// value's parameters, and calling the function (Lower Closures.jet: a
// function value is the closure of a thunk). One adapter per function and
// value type.
fn ir_function_value(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, key: String, span: Span) -> Int Never! {
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    signature :: ir_untag(ir_subst(m, ty))
    params := [Type]{}
    returned := Type?{None}
    if signature == .Fn(fn_params, fn_ret, _, _, _, _) {
        params = fn_params
        returned = fn_ret
    } else {
        return ir_fail_slot(&b, span, "named function as a value of {ir_type_name(ty)}")
    }
    adapter_key :: "{key}#value<{type_carrier_identity(signature)}>"
    adapter := m.function_rows.get(adapter_key) ?? -1
    if adapter < 0 {
        function_row :: p.rows.get(key) ?? return ir_fail_slot(&b, span, "named function {key} outside the checked program")
        function :: p.functions[function_row].copy()
        if function.generic_params.len() > 0 -> return ir_fail_slot(&b, span, "generic named function as a value")
        if function.params.len() != params.len() -> return ir_fail_slot(&b, span, "named function {function.name} as a value of {params.len()} parameters")
        // Every row is known before the adapter is registered, so a value
        // the builder cannot make leaves no half-built function behind.
        value_rows := [Int]{}
        loop param in params {
            value_row :: ir_value_type(&m, p, param) ?? return ir_fail_slot(&b, span, "named function value parameter type {ir_type_name(param)}")
            &value_rows.push(value_row)
        }
        param_rows := [Int]{}
        loop param in function.params {
            if param.convention == .Write -> return ir_fail_slot(&b, span, "named function {function.name} with a write parameter as a value")
            param_row :: ir_value_type(&m, p, param.ty) ?? return ir_fail_slot(&b, span, "named function value parameter type {ir_type_name(param.ty)}")
            &param_rows.push(param_row)
        }
        result_row := -1
        if returned == .Val(ret) {
            if !ir_unit_type(ret) && !ir_never_type(ret) {
                ret_row :: ir_value_type(&m, p, ret) ?? return ir_type_fail(&b, span, ret)
                result_row = ret_row
            }
        }
        callee_return :: ir_executable_return(function) ?? Type.Named{name: "Unit"}
        callee_row := -1
        if !ir_unit_type(callee_return) && !ir_never_type(callee_return) {
            callee_ret_row :: ir_value_type(&m, p, callee_return) ?? return ir_type_fail(&b, span, callee_return)
            callee_row = callee_ret_row
        }
        target :: ir_function_id(&m, p, key, [Type]{}) ?? return ir_fail_slot(&b, span, "named function {function.name} as a value")
        adapter = m.functions.len()
        &m.functions.push(ir_function_new("{function.name}.value", adapter_key, "{ir_symbol_name(function)}__value_{ir_key_hash(adapter_key)}", function.source_file, function.line))
        m.function_rows[adapter_key] = adapter
        a := ir_builder_new(m.functions[adapter].copy())
        a.line = function.line
        _ :: ir_new_slot(&a, ir_pointer_row(&m), IRSlotKind.Param, ir_intern_name(&m, "closure"))
        values := [Int]{}
        loop (index, value_row) in value_rows -> &values.push(ir_new_slot(&a, value_row, IRSlotKind.Param, ir_intern_name(&m, function.params[index].local.name)))
        a.f.result = result_row
        // The value's caller keeps its arguments: a move parameter of the
        // function gets its own copy.
        arguments := [Int]{}
        loop (index, param) in function.params {
            value :: ir_adapt(&m, p, &a, values[index], param_rows[index], span)
            &arguments.push(if param.convention == .Move -> ir_own(&m, p, &a, value) else -> value)
        }
        dst :: if callee_row >= 0 -> ir_fresh_temp(&m, &a, callee_row) else -> -1
        operands :: ir_args(&a.f, arguments)
        ir_emit(&a.f, IROp.Call, dst, target, operands, arguments.len(), a.line)
        result := -1
        if result_row >= 0 && dst >= 0 -> result = ir_adapt(&m, p, &a, dst, result_row, span)
        if a.error != "" {
            ir_emit(&a.f, IROp.Unreachable, -1, -1, -1, -1, a.line)
            m.functions[adapter] = ^a.f
            return ir_fail_slot(&b, span, a.error)
        }
        ir_emit(&a.f, IROp.Return, -1, result, -1, -1, a.line)
        m.functions[adapter] = ^a.f
    }
    boxed :: ir_box_alloc(&m, &b, 24, row)
    one :: ir_word_const(&m, &b, 1)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, one, b.line)
    none :: ir_word_const(&m, &b, 0)
    ir_emit(&b.f, IROp.Store, -1, boxed, 16, none, b.line)
    pointer_row :: ir_pointer_row(&m)
    code :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.FunctionAddress, code, adapter, -1, -1, b.line)
    ir_emit(&b.f, IROp.Store, -1, boxed, 8, code, b.line)
    boxed
}

// A compile-time value of type `ty`.
fn ir_comptime(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, value: TComptimeValue, span: Span) -> Int Never! {
    if value == .Unit -> return -1
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    if value == {
        .Int(number) -> return ir_int_constant(&m, &b, row, number)
        .Bool(flag) -> return ir_int_constant(&m, &b, row, if flag -> 1 else -> 0)
        .Char(code) -> return ir_int_constant(&m, &b, row, code)
        .Float(number, _) -> {
            narrow :: m.types[row].kind == .Float32
            return ir_int_constant(&m, &b, row, ir_float_constant_bits(number, narrow))
        }
        .String(text) -> {
            slot :: ir_temp(&m, &b, row)
            ir_emit(&b.f, IROp.ConstText, slot, ir_intern_text(&m, text), -1, -1, b.line)
            return slot
        }
        .BigInt(decimal) -> {
            // A U64 beyond the exact-Int range keeps its decimal; its word
            // destination takes the bit pattern (Lower ir_constant_u64_bits).
            if m.types[row].kind == .Word -> return ir_int_constant(&m, &b, row, ir_constant_u64_bits(decimal))
            slot :: ir_fresh_temp(&m, &b, row)
            ir_emit(&b.f, IROp.ConstBigInt, slot, ir_intern_name(&m, decimal), -1, -1, b.line)
            return slot
        }
        .Present(inner) -> {
            if ir_untag(ty) == .Option(inner_ty) {
                inner_row :: ir_value_type(&m, p, inner_ty) ?? return ir_type_fail(&b, span, inner_ty)
                payload :: ir_comptime(&m, p, &b, inner_ty, inner, span)
                if ir_failed(b) -> return -1
                inner_size :: m.types[inner_row].size
                boxed :: ir_box_alloc(&m, &b, inner_size, row)
                ir_store_at(&m, p, &b, boxed, 0, payload)
                return boxed
            }
            return ir_fail_slot(&b, span, "present constant of {ir_type_name(ty)}")
        }
        .List(values) -> {
            if ir_untag(ty) == .List(element) {
                element_row :: ir_value_type(&m, p, element) ?? return ir_type_fail(&b, span, element)
                elements := [Int]{}
                loop item in values {
                    slot :: ir_comptime(&m, p, &b, element, item, span)
                    if ir_failed(b) -> return -1
                    &elements.push(slot)
                }
                return ir_list_from(&m, p, &b, row, element_row, elements)
            }
            return ir_fail_slot(&b, span, "list constant of {ir_type_name(ty)}")
        }
        .Struct(_, fields) -> return ir_comptime_struct(&m, p, &b, ty, row, fields, span)
        .Map(entries) -> return ir_comptime_map(&m, p, &b, ty, row, entries, span)
        .Enum(_, variant, args) -> return ir_comptime_enum(&m, p, &b, ty, row, variant, args, span)
        .Bytes(bytes) -> return ir_comptime_bytes(&m, p, &b, ty, row, bytes, span)
        .Failed(report) -> {
            // Lower lower_constant_tree_value: a told failure is an Err box,
            // a clean failure of an Option is None.
            if report == .Told(told) {
                if ir_untag(ty) == .Result(_, err_ty) {
                    payload :: ir_comptime(&m, p, &b, err_ty, told, span)
                    if ir_failed(b) -> return -1
                    return ir_result_box(&m, p, &b, ty, false, payload)
                }
            } else if m.types[row].kind == .Pointer && ir_untag(ty) == .Option(_) {
                slot :: ir_temp(&m, &b, row)
                ir_emit(&b.f, IROp.Const, slot, 0, -1, -1, b.line)
                return slot
            }
            return ir_fail_slot(&b, span, "failed constant of {ir_type_name(ty)}")
        }
        else -> return ir_fail_slot(&b, span, "constant value {ir_comptime_name(value)}")
    }
}

// A Map constant (Lower lower_constant_map_fill): an empty header, then each
// entry set in order through map.set, which orders the keys and retires
// duplicates.
fn ir_comptime_map(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, row: Int, entries: [TComptimeMapEntry], span: Span) -> Int Never! {
    shape :: ir_map_shape(&m, p, row) ?? return ir_fail_slot(&b, span, "map constant of {ir_type_name(ty)}")
    key_ty :: m.types[shape.key.ty].ty.copy()
    value_ty :: m.types[shape.value.ty].ty.copy()
    map :: ir_list_empty(&m, &b, row)
    loop entry in entries {
        key :: ir_comptime(&m, p, &b, key_ty, ir_comptime_key_value(entry.key), span)
        value :: ir_comptime(&m, p, &b, value_ty, entry.value, span)
        if ir_failed(b) -> return -1
        if key < 0 || value < 0 -> return ir_fail_slot(&b, span, "Unit map constant entry")
        ir_map_set(&m, p, &b, row, map, key, value)
    }
    map
}

// A map constant's key as the compile-time value it builds from (Lower
// lower_constant_key).
fn ir_comptime_key_value(key: TComptimeKey) -> TComptimeValue Never! {
    if key == {
        .Int(value) -> TComptimeValue.Int{value: value}
        .BigInt(decimal) -> TComptimeValue.BigInt{decimal: decimal}
        .String(value) -> TComptimeValue.String{value: value}
        .Bool(value) -> TComptimeValue.Bool{value: value}
        .Char(value) -> TComptimeValue.Char{value: value}
        .Tuple(fields) -> TComptimeValue.Struct{type_name: "Tuple", fields: loop field in fields -> TComptimeField{name: field.name, value: ir_comptime_key_value(field.key)}}
        .Struct(name, fields) -> TComptimeValue.Struct{type_name: name, fields: loop field in fields -> TComptimeField{name: field.name, value: ir_comptime_key_value(field.key)}}
        .Enum(name, variant) -> TComptimeValue.Enum{type_name: name, variant: variant, args: [TComptimeEnumArg]{}}
    }
}

// A struct (or tuple) constant in fresh frame storage, each member built
// from its compile-time value.
fn ir_comptime_struct(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, row: Int, fields: [TComptimeField], span: Span) -> Int Never! {
    if m.types[row].kind != .Aggregate -> return ir_fail_slot(&b, span, "struct constant of {ir_type_name(ty)}")
    storage :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
    loop field in fields {
        member :: ir_member_of(&m, p, b, storage, field.name) ?? return ir_fail_slot(&b, span, "struct constant field {field.name}")
        field_ty :: ir_declared_field_type(m, p, ty, field.name) ?? return ir_fail_slot(&b, span, "struct constant field {field.name}")
        value :: ir_comptime(&m, p, &b, field_ty, field.value, span)
        if ir_failed(b) -> return -1
        if value >= 0 -> ir_member_write(&m, p, &b, storage, member, value)
    }
    storage
}

// An enum constant: a payload-free enum's variant index, else a new box
// with the discriminant and each payload member's compile-time value
// (positional, or by member name).
fn ir_comptime_enum(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, slot_type: Int, variant: String, args: [TComptimeEnumArg], span: Span) -> Int Never! {
    nominal :: ir_nominal_name(ir_untag(ir_subst(m, ty))) ?? return ir_fail_slot(&b, span, "enum constant of {ir_type_name(ty)}")
    row :: ir_type_def(p, nominal) ?? ir_enum_def(m, p, slot_type) ?? return ir_fail_slot(&b, span, "enum constant of {ir_type_name(ty)}")
    index :: ir_variant_index(p, row, variant) ?? return ir_fail_slot(&b, span, "variant {variant} not in {nominal}")
    if m.types[slot_type].kind != .Pointer {
        if args.len() > 0 -> return ir_fail_slot(&b, span, "payload for a payload-free enum constant")
        return ir_int_constant(&m, &b, slot_type, index)
    }
    names := [String]{}
    types := [Type]{}
    if p.types[row].kind == .Enum(variants, _) {
        if variants[index].payload == {
            .Unit -> {}
            .Single(inner) -> {
                &names.push(variants[index].name)
                &types.push(inner)
            }
            .Named(fields) -> {
                loop field in fields {
                    if field.computed -> next
                    &names.push(field.name)
                    &types.push(field.ty)
                }
            }
        }
    }
    slot_args :: ir_row_args(m, slot_type)
    members :: ir_variant_members(&m, p, row, slot_args, index) ?? return ir_fail_slot(&b, span, "payload of {variant}")
    if members.len() != types.len() -> return ir_fail_slot(&b, span, "payload of {variant}")
    size :: ir_enum_box_size(&m, p, row, slot_args) ?? return ir_fail_slot(&b, span, "layout of {nominal}")
    values := [Int]{}
    targets := [IRMember]{}
    loop (position, arg) in args {
        target := position
        if arg.name == .Val(name) {
            target = -1
            loop (candidate, member_name) in names {
                if member_name == name -> target = candidate
            }
        }
        if target < 0 || target >= members.len() -> return ir_fail_slot(&b, span, "variant {variant} constant member {position}")
        slot :: ir_comptime(&m, p, &b, types[target], arg.value, span)
        if ir_failed(b) -> return -1
        &values.push(slot)
        &targets.push(members[target])
    }
    boxed :: ir_box_alloc(&m, &b, size, slot_type)
    discriminant :: ir_word_const(&m, &b, index)
    ir_emit(&b.f, IROp.Store, -1, boxed, 0, discriminant, b.line)
    loop (position, value) in values -> ir_member_store(&m, p, &b, boxed, targets[position], value)
    boxed
}

// A byte-list constant: a new buffer of its own filled from a read-only
// data row (the list may be mutated like any other).
fn ir_comptime_bytes(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, row: Int, bytes: [U8], span: Span) -> Int Never! {
    element_row := -1
    if ir_untag(ir_subst(m, ty)) == .List(element) {
        element_row = ir_value_type(&m, p, element) ?? -1
    }
    if element_row < 0 || m.types[element_row].kind != .Word || m.types[element_row].size != 1 -> return ir_fail_slot(&b, span, "byte constant of {ir_type_name(ty)}")
    if bytes.len() == 0 -> return ir_list_empty(&m, &b, row)
    storage :: ir_fresh_temp(&m, &b, row)
    ir_emit(&b.f, IROp.StackAddress, storage, 24, 8, -1, b.line)
    count :: ir_word_const(&m, &b, bytes.len())
    ir_emit(&b.f, IROp.Store, -1, storage, 0, count, b.line)
    ir_emit(&b.f, IROp.Store, -1, storage, 8, count, b.line)
    data :: ir_list_buffer_alloc(&m, &b, bytes.len())
    pointer_row :: ir_pointer_row(&m)
    source :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.DataAddress, source, ir_intern_bytes(&m, bytes), -1, -1, b.line)
    _ :: ir_runtime(&m, &b, "jet_rt_mem_move", [Int]{data, source, count}, -1)
    ir_emit(&b.f, IROp.Store, -1, storage, 16, data, b.line)
    storage
}

fn ir_comptime_name(value: TComptimeValue) -> String Never! {
    text := "{value}"
    separators :: [String]{"(", "{{", " "}
    loop separator in separators {
        parts :: text.split(separator).to_list()
        text = parts[0]
    }
    text
}

// ---------------------------------------------------------------------------
// Program stops (Lower Require.jet): require / require_eq / panic report
// through jet_rt_require_stop(ordinal, descriptor, message, left, right,
// locals), which does not return. The 88-byte descriptor holds the path,
// line, function, source line, column, caret and the rendered context text.

// A checked stop location with its report source (Rust capture_panic_loc):
// sema locates the stop by file, line and 1-based byte column; the line's
// text, trailing whitespace trimmed, and its character column come from the
// checked source this program holds.
fn ir_report_location(p: IRProgram, location: TPanicLoc) -> TPanicLoc Never! {
    // copy: the report's location is the caller's own; the checked expression keeps its location.
    located := location.copy()
    if location.source_line != "" || location.line < 1 -> return located
    text :: ir_source_line_text(p, location.file, location.line) ?? return located
    bytes :: text.bytes()
    column := 1
    at := 0
    loop at + 1 < location.column && at < bytes.len() {
        if bytes[at] < (U8{128}) || bytes[at] >= (U8{192}) -> column += 1
        at += 1
    }
    located.source_line = text.trim_end()
    located.column = column
    located
}

fn ir_require_stop(m: &IRModule, p: IRProgram, b: &IRBuilder, kind: TRequireKind, location: TPanicLoc, always_stops: Bool, span: Span) -> Int Never! {
    report :: ir_report_location(p, location)
    if kind == {
        .Require(test, message) -> {
            condition :: ir_expr(&m, p, &b, test)
            if ir_failed(b) || condition < 0 -> return -1
            if !always_stops {
                bool_row :: ir_type_row(&m, Type.Bool) ?? 0
                failed :: ir_temp(&m, &b, bool_row)
                ir_emit(&b.f, IROp.Not, failed, condition, -1, -1, b.line)
                ir_open_if(&b.f, failed, b.line)
            }
            text := -1
            if message == .Val(value) {
                slot :: ir_expr(&m, p, &b, value)
                if ir_failed(b) -> return -1
                value_ty :: ir_ty(p, b, value)
                text = ir_render(&m, p, &b, value_ty, slot, IRRender.Display, span)
            } else {
                string_row :: ir_string_row(&m)
                text = ir_temp(&m, &b, string_row)
                ir_emit(&b.f, IROp.ConstText, text, ir_intern_text(&m, "condition failed"), -1, -1, b.line)
            }
            if ir_failed(b) -> return -1
            null :: ir_word_const(&m, &b, 0)
            ir_stop(&m, p, &b, 0, text, null, null, report)
            if !always_stops -> ir_end(&b.f, b.line)
        }
        .RequireEq(left, right) -> {
            left_slot :: ir_expr(&m, p, &b, left)
            right_slot :: ir_expr(&m, p, &b, right)
            if ir_failed(b) || left_slot < 0 || right_slot < 0 -> return -1
            site :: b.line
            left_ty :: ir_ty(p, b, left)
            right_ty :: ir_ty(p, b, right)
            equal :: ir_binary(&m, p, &b, TBinaryOp.Eq, false, site, left_ty, left_slot, right_slot, right_ty, span)
            if ir_failed(b) -> return -1
            if !always_stops {
                bool_row :: ir_type_row(&m, Type.Bool) ?? 0
                failed :: ir_temp(&m, &b, bool_row)
                ir_emit(&b.f, IROp.Not, failed, equal, -1, -1, b.line)
                ir_open_if(&b.f, failed, b.line)
            }
            left_text :: ir_render(&m, p, &b, left_ty, left_slot, IRRender.Debug, span)
            right_text :: ir_render(&m, p, &b, right_ty, right_slot, IRRender.Debug, span)
            if ir_failed(b) -> return -1
            code :: ir_word_const(&m, &b, 0)
            ir_stop(&m, p, &b, 1, code, left_text, right_text, report)
            if !always_stops -> ir_end(&b.f, b.line)
        }
        .Panic(message) -> {
            slot :: ir_expr(&m, p, &b, message)
            if ir_failed(b) -> return -1
            message_ty :: ir_ty(p, b, message)
            text :: ir_render(&m, p, &b, message_ty, slot, IRRender.Display, span)
            if ir_failed(b) -> return -1
            null :: ir_word_const(&m, &b, 0)
            ir_stop(&m, p, &b, 2, text, null, null, report)
        }
    }
    -1
}

// The stop call itself (then unreachable).
fn ir_stop(m: &IRModule, p: IRProgram, b: &IRBuilder, ordinal: Int, message: Int, left: Int, right: Int, location: TPanicLoc) Never! {
    locals := ir_word_const(&m, &b, 0)
    if location.locals.len() > 0 {
        pointer_row :: ir_pointer_row(&m)
        builder :: ir_runtime(&m, &b, "jet_rt_string_builder_new", [Int]{}, pointer_row)
        b.fresh[builder] = false
        loop (index, local) in location.locals {
            binding :: ir_lookup_binding(b, local.local.name) ?? return ir_fail(&b, Span{start: 0, end: 0}, "panic report local {local.display_name} is not visible")
            value :: ir_read_binding(&m, &b, binding)
            value_ty :: m.types[b.f.slot_type[value]].ty
            text :: ir_render(&m, p, &b, value_ty, value, IRRender.Debug, Span{start: 0, end: 0})
            if ir_failed(b) -> return
            ir_push_static(&m, &b, builder, "{if index > 0 -> ", " else -> ""}{local.display_name} = ")
            _ :: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
        }
        string_row :: ir_string_row(&m)
        locals = ir_runtime(&m, &b, "jet_rt_string_builder_finish", [Int]{builder}, string_row)
    }
    pointer_row :: ir_pointer_row(&m)
    descriptor :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.StackAddress, descriptor, 88, 8, -1, b.line)
    ir_store_text(&m, &b, descriptor, 0, location.file)
    line :: ir_word_const(&m, &b, location.line)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 16, line, b.line)
    function_name :: b.f.name
    ir_store_text(&m, &b, descriptor, 24, function_name)
    ir_store_text(&m, &b, descriptor, 40, location.source_line)
    column :: ir_word_const(&m, &b, location.column)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 56, column, b.line)
    caret :: ir_word_const(&m, &b, location.caret)
    ir_emit(&b.f, IROp.Store, -1, descriptor, 64, caret, b.line)
    context :: ir_stop_context(location.file, location, function_name)
    ir_store_text(&m, &b, descriptor, 72, context)
    stop_ordinal :: ir_word_const(&m, &b, ordinal)
    _ :: ir_runtime(&m, &b, "jet_rt_require_stop", [Int]{stop_ordinal, descriptor, message, left, right, locals}, -1)
    ir_emit(&b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
}

// A static text's (address, length) pair at `offset` of the storage at `base`.
fn ir_store_text(m: &IRModule, b: &IRBuilder, base: Int, offset: Int, text: String) Never! {
    pair :: ir_static_text(&m, &b, text)
    ir_emit(&b.f, IROp.Store, -1, base, offset, pair[0], b.line)
    ir_emit(&b.f, IROp.Store, -1, base, offset + 8, pair[1], b.line)
}

// Lower lower_require_context_text: the report's static context, with the
// runtime's exact spacing.
fn ir_stop_context(path: String, location: TPanicLoc, function: String) -> String Never! {
    out := [U8]{}
    if path != "" {
        heading :: if function == "" -> "  --> {path}:{location.line}\n" else -> "  --> {path}:{location.line} in {function}\n"
        loop byte in heading.bytes() -> &out.push(byte)
    }
    if location.source_line != "" {
        digits :: "{location.line}".bytes().len()
        loop _ in 0..<(digits + 3) -> &out.push(U8{32})
        loop byte in "|\n{location.line} | {location.source_line}\n".bytes() -> &out.push(byte)
        loop _ in 0..<(digits + 3) -> &out.push(U8{32})
        &out.push(U8{124})
        &out.push(U8{32})
        loop _ in 0..<(if location.column > 0 -> location.column - 1 else -> 0) -> &out.push(U8{32})
        loop _ in 0..<(if location.caret > 0 -> location.caret else -> 1) -> &out.push(U8{94})
        &out.push(U8{10})
    }
    String.from_bytes(out) ?? ""
}
