// Distinct conversion: a distinct value lays out as its base, so a conversion
// reaches the base; a declared integer range is checked by the inline_range
// route.

use jet_foundation.[Span, TIntegerBounds, TNumericOp, Type]

// `value.as(Name)` and the other conversions into a distinct type: a cast
// reaches the base first; a fallible cast with a range checks it, one
// without is Ok; every other conversion is the numeric method's.
fn ir_distinct_convert(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, argument: Int, operation: TNumericOp, range: TIntegerBounds?, fallible: Bool, span: Span) -> Int Never! {
    if operation == {
        .CastAs(_) -> {}
        else -> return ir_numeric_method(&m, p, &b, ty, argument, operation, span)
    }
    success := ir_subst(m, ty)
    if fallible {
        if ir_untag(success) == .Result(ok_ty, _) {
            success = ok_ty
        } else {
            return ir_fail_slot(&b, span, "fallible distinct conversion into {ir_type_name(ty)}")
        }
    }
    value :: ir_expr(&m, p, &b, argument)
    if ir_failed(b) || value < 0 -> return -1
    if fallible && range == .Val(bounds) {
        int_row :: ir_type_row(&m, Type.Int) ?? 0
        exact := value
        if ir_kind_of(m, b, value) != .Int {
            exact = ir_numeric_cast(&m, p, &b, value, int_row, span)
            ir_release(&m, &b, value)
        }
        return ir_distinct_in_range(&m, p, &b, ty, exact, bounds.lo, bounds.hi, span)
    }
    target :: ir_value_type(&m, p, success) ?? return ir_type_fail(&b, span, success)
    cast := value
    if b.f.slot_type[value] != target {
        cast = ir_numeric_cast(&m, p, &b, value, target, span)
        ir_release(&m, &b, value)
    }
    if fallible -> return ir_result_box(&m, p, &b, ty, true, cast)
    cast
}

fn ir_distinct_in_range(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, value: Int, low: Int, high: Int, span: Span) -> Int Never! {
    int_row :: ir_type_row(&m, Type.Int) ?? 0
    lo :: ir_int_constant(&m, &b, int_row, low)
    hi :: ir_int_constant(&m, &b, int_row, high)
    ir_route(&m, p, &b, "jet_inline_range_from_int", [Int]{value, lo, hi}, [Bool]{false, false, false}, ty, span)
}
