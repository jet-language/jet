// Copy-and-patch x86-64 code generator for O0 (`IRModule.fast_o0`): emits
// compact, fast-executing machine code in a single forward pass over each
// function's IR instructions by copying pre-encoded x86-64 stencils and
// patching fixed holes in place.
//
// Zero register allocator, zero live-range/loop-nesting analysis, zero
// per-function NameTable pre-scan, zero dying pass, zero pad hash-dedup, and
// zero branch relaxation. A single O(N) write-count scan folds single-write
// Temp `Const` and `StackAddress`/`Offset` slots to zero frame bytes so most
// remaining slots fit compact 1-byte `[rbp + disp8]` encodings, and stop
// edges live out-of-line after the epilogue to keep hot code dense in L1I.
use {
    jet_foundation.[Type, compiler_take_rows, name_rows_value]
    jet_backend.[
        X64CallArgument,
        X64CallSite,
        X64CompiledFunction,
        X64DataID,
        X64DebugLocation,
        X64DebugVariable,
        X64FunctionDebug,
        X64FunctionID,
        X64InlineRange,
        X64LineRow,
        X64Reloc,
        X64RelocTarget,
        X64VariableRange,
        X64_FUNCTION_ALIGN,
        X64_RBP,
        X64_RSP,
        dwarf_cfa_advance,
        dwarf_cfa_def_cfa,
        dwarf_cfa_def_cfa_offset,
        dwarf_cfa_def_cfa_register,
        dwarf_cfa_offset,
        dwarf_cfa_remember_state,
        dwarf_cfa_restore_state,
        dwarf_cfa_same_value,
        x64_dwarf_register,
        x64_fits_i32,
    ]
}

// ---------------------------------------------------------------------------
// Pre-encoded x86-64 stencils (compact disp8 forms for [-128..127] and disp32
// forms for wider frames).

// push rbp; mov rbp, rsp; sub rsp, imm32@7
PATCH_PROLOGUE: [U8]{0x55, 0x48, 0x89, 0xe5, 0x48, 0x81, 0xec, 0, 0, 0, 0}

// lea r11, [rsp + disp32@4]; cmp r11, gs:[disp32@13]; jb rel32@19
PATCH_STACK_CHECK: [U8]{0x4c, 0x8d, 0x9c, 0x24, 0, 0, 0, 0, 0x65, 0x4c, 0x3b, 0x1c, 0x25, 0, 0, 0, 0, 0x0f, 0x82, 0, 0, 0, 0}

// xor edx, edx; leave; ret
PATCH_EPILOGUE: [U8]{0x31, 0xd2, 0xc9, 0xc3}

// xor edx, edx; sfence; leave; ret
PATCH_EPILOGUE_SFENCE: [U8]{0x31, 0xd2, 0x0f, 0xae, 0xf8, 0xc9, 0xc3}

// mov edx, 1; leave; ret
PATCH_STOP_EXIT: [U8]{0xba, 1, 0, 0, 0, 0xc9, 0xc3}

// mov edx, 1; sfence; leave; ret
PATCH_STOP_EXIT_SFENCE: [U8]{0xba, 1, 0, 0, 0, 0x0f, 0xae, 0xf8, 0xc9, 0xc3}

// mov qword [rbp+disp8@3], imm32@4  /  [rbp+disp32@3], imm32@7
PATCH_CONST_I32_8: [U8]{0x48, 0xc7, 0x45, 0, 0, 0, 0, 0}

PATCH_CONST_I32: [U8]{0x48, 0xc7, 0x85, 0, 0, 0, 0, 0, 0, 0, 0}

// movabs rax, imm64@2; mov [rbp+disp8@13], rax  /  disp32@13
PATCH_CONST_I64_8: [U8]{0x48, 0xb8, 0, 0, 0, 0, 0, 0, 0, 0, 0x48, 0x89, 0x45, 0}

PATCH_CONST_I64: [U8]{0x48, 0xb8, 0, 0, 0, 0, 0, 0, 0, 0, 0x48, 0x89, 0x85, 0, 0, 0, 0}

// mov rax, [rbp+A@3]; mov [rbp+DST@7], rax (8 bytes!)
PATCH_COPY_SLOT_8: [U8]{0x48, 0x8b, 0x45, 0, 0x48, 0x89, 0x45, 0}

PATCH_COPY_SLOT: [U8]{0x48, 0x8b, 0x85, 0, 0, 0, 0, 0x48, 0x89, 0x85, 0, 0, 0, 0}

// lea rax, [rip+rel32@3]; mov [rbp+DST@10], rax (11B disp8 / 14B disp32)
PATCH_LEA_RIP_SLOT_8: [U8]{0x48, 0x8d, 0x05, 0, 0, 0, 0, 0x48, 0x89, 0x45, 0}

PATCH_LEA_RIP_SLOT: [U8]{0x48, 0x8d, 0x05, 0, 0, 0, 0, 0x48, 0x89, 0x85, 0, 0, 0, 0}

// lea rax, [rip+rel32@3]; mov rax, [rax]; mov [rbp+DST@13], rax
PATCH_STATIC_INT_8: [U8]{0x48, 0x8d, 0x05, 0, 0, 0, 0, 0x48, 0x8b, 0x00, 0x48, 0x89, 0x45, 0}

PATCH_STATIC_INT: [U8]{0x48, 0x8d, 0x05, 0, 0, 0, 0, 0x48, 0x8b, 0x00, 0x48, 0x89, 0x85, 0, 0, 0, 0}

// lea rax, [rbp+STACK@3]; mov [rbp+DST@10], rax
PATCH_STACK_ADDR: [U8]{0x48, 0x8d, 0x85, 0, 0, 0, 0, 0x48, 0x89, 0x85, 0, 0, 0, 0}

// Compact disp8 wrapping 64-bit ALU (12 bytes!): mov rax,[rbp+A@3]; op@5 rax,[rbp+B@7]; mov [rbp+DST@11],rax
PATCH_ALU64_WRAP_8: [U8]{0x48, 0x8b, 0x45, 0, 0x48, 0x03, 0x45, 0, 0x48, 0x89, 0x45, 0}

PATCH_ALU64_WRAP: [U8]{0x48, 0x8b, 0x85, 0, 0, 0, 0, 0x48, 0x03, 0x85, 0, 0, 0, 0, 0x48, 0x89, 0x85, 0, 0, 0, 0}

// Compact disp8 Word compare (18 bytes!): A@3, B@7, CC@9, DST@17
PATCH_CMP_WORD_8: [U8]{0x48, 0x8b, 0x45, 0, 0x48, 0x3b, 0x45, 0, 0x0f, 0x90, 0xc0, 0x0f, 0xb6, 0xc0, 0x48, 0x89, 0x45, 0}

PATCH_CMP_WORD: [U8]{0x48, 0x8b, 0x85, 0, 0, 0, 0, 0x48, 0x3b, 0x85, 0, 0, 0, 0, 0x0f, 0x90, 0xc0, 0x0f, 0xb6, 0xc0, 0x48, 0x89, 0x85, 0, 0, 0, 0}

// Compact disp8 Exact Int Copy (24 bytes): A@3, CALL@16, DST@23
PATCH_INT_CLONE_8: [U8]{
    0x48,
    0x8b,
    0x45,
    0,
    0x48,
    0x89,
    0xc2,
    0x48,
    0x01,
    0xd2,
    0x71,
    0x08,
    0x48,
    0x89,
    0xc7,
    0xe8,
    0,
    0,
    0,
    0,
    0x48,
