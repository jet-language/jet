// ---------------------------------------------------------------------------
// Low-level patch primitives.

#Inline(Always) patch_emit: fn(code: &[U8], stencil: [U8]) -> Int Never! {
    base: code.len()
    code.extend(stencil[0..<stencil.len()])
    base
}

#Inline(Always) patch_i32: fn(code: &[U8], at: Int, value: Int) Never! {
    code[at] = U8{value & 255}
    code[at + 1] = U8{(value >> 8) & 255}
    code[at + 2] = U8{(value >> 16) & 255}
    code[at + 3] = U8{(value >> 24) & 255}
}

#Inline(Always) patch_i64: fn(code: &[U8], at: Int, value: Int) Never! {
    patch_i32(code, at, value)
    patch_i32(code, at + 4, value >> 32)
}

#Inline(Always) patch_rel32: fn(code: &[U8], site: Int, target: Int) Never! {
    patch_i32(code, site, target - (site + 4))
}

#Inline(Always) patch_push_i32: fn(code: &[U8], value: Int) Never! {
    code.push(U8{value & 255})
    code.push(U8{(value >> 8) & 255})
    code.push(U8{(value >> 16) & 255})
    code.push(U8{(value >> 24) & 255})
}

#Inline(Always) patch_push_i64: fn(code: &[U8], value: Int) Never! {
    patch_push_i32(code, value)
    patch_push_i32(code, value >> 32)
}

#Inline(Always) patch_fits_i8: fn(v: Int) -> Bool Never! { v >= -128 && v <= 127 }

// ---------------------------------------------------------------------------
// Patch emitter state.

IRPatchCold: struct {
    kind: IRX64ColdKind,
    sites: [Int],
    resume: Int,
    symbol: String,
    left: Int,
    right: Int,
    right_imm: Int,
    dst: Int,
    cc: Int,
    text: Int,
    direction: Int,
    unsigned: Int,
    width: Int,
    line: Int,
    pad: Int,
    at: Int,
    falls: Bool{false},
    drop0: Int{-1},
    drop1: Int{-1},
}

IRPatchStopEdge: struct {
    branch: Int,
    end: Int,
    sites: [Int],
    resume: Int,
    open: [Int],
    heads: [Int],
    offset: Int,
}

IRPatchZoneStub: struct {
    at: Int,
    site: Int,
    resume: Int,
    symbol: String,
    dst: Int,
}

IRPatchEmitter: struct {
    code: [U8],
    relocs: [X64Reloc],
    local_relocs: [Int],
    uses: IRX64Uses,
    use_lengths: [Int],
    file_text_row: Int,
    stop_text_rows: [Int],
    fma_row: Int,
    header_keys: [Int],
    header_vals: [Int],
    int_keys: [Int],
    int_text_vals: [Int],
    int_static_vals: [Int],
    // Reusable per-worker analysis & frame tables (zero per-function allocs):
    classes: [IRX64Class],
    starts: [Int],
    ends: [Int],
    first_writes: [Bool],
    writes: [Int],
    last_write: [Int],
    roots: [Int],
    shifts: [Int],
    temp_homes: [Int],
    temp_ends: [Int],
    loop_starts: [Int],
    loop_ends: [Int],
    inner: [Int],
    heads: [Int],
    parents: [Int],
    open_loops: [Int],
    homes: [Int],
    is_const: [Bool],
    const_val: [Int],
    frames: [Int],
    depth: Int,
    result_home: Int,
    result_storage: Int,
    // Structured control stack:
    ctrl_open: [Int],
    ctrl_head: [Int],
    ctrl_false: [Int],
    ctrl_end_head: [Int],
    ctrl_end_tail: [Int],
    end_sites: [Int],
    end_next: [Int],
    end_of: [Int],
    returns: [Int],
    stop_returns: [Int],
    stop_edges: [IRPatchStopEdge],
    suffix_slot: [Int],
    suffix_next: [Int],
    suffix_off: [Int],
    tails: [Int],
    colds: [IRPatchCold],
    zone_sites: [Int],
    zone_stubs: [IRPatchZoneStub],
    stub_ends: [Int],
    lines: [X64LineRow],
    call_rows: [X64LineRow],
    call_returns: [Int],
    calls: [X64CallSite],
    alloc_relocs: [Int],
    alloc_rows: [Int],
    errors: [String],
    fused_slot: Int,
    fused_cc: Int,
    routed_at: Int,
    skip_to: Int,
    in_stop_edge: Bool,
    below: Int,
    dynamic: Bool,
    has_stream: Bool,
    in_stub: Bool,
    at: Int,
    has_drop_plan: Bool,
    has_drop_kill: Bool,
    drop_head: [Int],
    drop_chain: [Int],
    drop_slots: [Int],
    drop_lines: [Int],
    drop_kill: [Bool],
}

ir_patch_emitter_new: fn() -> IRPatchEmitter Never! {
    IRPatchEmitter{
        code: [U8]{},
        relocs: [X64Reloc]{},
        local_relocs: [Int]{},
        uses: IRX64Uses{},
        use_lengths: [Int]{},
        file_text_row: -1,
        stop_text_rows: [Int]{-1, -1, -1, -1, -1},
        fma_row: -1,
        header_keys: [Int]{},
        header_vals: [Int]{},
        int_keys: [Int]{},
        int_text_vals: [Int]{},
        int_static_vals: [Int]{},
        classes: [IRX64Class]{},
        starts: [Int]{},
        ends: [Int]{},
        first_writes: [Bool]{},
        writes: [Int]{},
        last_write: [Int]{},
        roots: [Int]{},
        shifts: [Int]{},
        temp_homes: [Int]{},
        temp_ends: [Int]{},
        loop_starts: [Int]{},
        loop_ends: [Int]{},
        inner: [Int]{},
        heads: [Int]{},
        parents: [Int]{},
        open_loops: [Int]{},
        homes: [Int]{},
        is_const: [Bool]{},
        const_val: [Int]{},
        frames: [Int]{},
        depth: 0,
        result_home: 0,
        result_storage: -1,
        ctrl_open: [Int]{},
        ctrl_head: [Int]{},
        ctrl_false: [Int]{},
        ctrl_end_head: [Int]{},
        ctrl_end_tail: [Int]{},
        end_sites: [Int]{},
        end_next: [Int]{},
        end_of: [Int]{},
        returns: [Int]{},
        stop_returns: [Int]{},
        stop_edges: [IRPatchStopEdge]{},
        suffix_slot: [Int]{},
        suffix_next: [Int]{},
        suffix_off: [Int]{},
        tails: [Int]{},
        colds: [IRPatchCold]{},
        zone_sites: [Int]{},
        zone_stubs: [IRPatchZoneStub]{},
        stub_ends: [Int]{},
        lines: [X64LineRow]{},
        call_rows: [X64LineRow]{},
        call_returns: [Int]{},
        calls: [X64CallSite]{},
        alloc_relocs: [Int]{},
        alloc_rows: [Int]{},
        errors: [String]{},
        fused_slot: -1,
        fused_cc: -1,
        routed_at: -2,
        skip_to: -1,
        in_stop_edge: false,
        below: 0,
        dynamic: false,
        has_stream: false,
        in_stub: false,
        at: -1,
        has_drop_plan: false,
        has_drop_kill: false,
        drop_head: [Int]{},
        drop_chain: [Int]{},
        drop_slots: [Int]{},
        drop_lines: [Int]{},
        drop_kill: [Bool]{},
    }
}

patch_emitter_reset: fn(p: &IRPatchEmitter, op_count: Int, slot_count: Int) Never! {
    code := [U8]{}
    code.try_reserve(op_count * 12 + 64) ?? panic("reserve failed")
    p.code = code.move()
    p.relocs = [X64Reloc]{}
    p.local_relocs = [Int]{}
    p.uses = IRX64Uses{}
    if p.use_lengths.len() > 0 -> p.use_lengths.clear()
    p.file_text_row = -1
    loop i in 0..<5 -> p.stop_text_rows[i] = -1
    p.fma_row = -1
    if p.header_keys.len() > 0 -> p.header_keys.clear()
    if p.header_vals.len() > 0 -> p.header_vals.clear()
    if p.int_keys.len() > 0 -> p.int_keys.clear()
    if p.int_text_vals.len() > 0 -> p.int_text_vals.clear()
    if p.int_static_vals.len() > 0 -> p.int_static_vals.clear()
    if p.classes.len() < slot_count {
        p.classes.try_reserve(slot_count) ?? panic("reserve failed")
        p.starts.try_reserve(slot_count) ?? panic("reserve failed")
        p.ends.try_reserve(slot_count) ?? panic("reserve failed")
        p.first_writes.try_reserve(slot_count) ?? panic("reserve failed")
        p.writes.try_reserve(slot_count) ?? panic("reserve failed")
        p.last_write.try_reserve(slot_count) ?? panic("reserve failed")
        p.roots.try_reserve(slot_count) ?? panic("reserve failed")
        p.shifts.try_reserve(slot_count) ?? panic("reserve failed")
        p.homes.try_reserve(slot_count) ?? panic("reserve failed")
        p.is_const.try_reserve(slot_count) ?? panic("reserve failed")
        p.const_val.try_reserve(slot_count) ?? panic("reserve failed")
        p.frames.try_reserve(slot_count) ?? panic("reserve failed")
        loop p.classes.len() < slot_count {
            p.classes.push(IRX64Class.Empty)
            p.starts.push(0)
            p.ends.push(-1)
            p.first_writes.push(false)
            p.writes.push(0)
            p.last_write.push(-1)
            p.roots.push(-1)
            p.shifts.push(0)
            p.homes.push(0)
            p.is_const.push(false)
            p.const_val.push(0)
            p.frames.push(0)
        }
    }
    if p.temp_homes.len() > 0 -> p.temp_homes.clear()
    if p.temp_ends.len() > 0 -> p.temp_ends.clear()
    if p.loop_starts.len() > 0 -> p.loop_starts.clear()
    if p.loop_ends.len() > 0 -> p.loop_ends.clear()
    if p.parents.len() > 0 -> p.parents.clear()
    if p.open_loops.len() > 0 -> p.open_loops.clear()
    p.depth = 0
    p.result_home = 0
    p.result_storage = -1
    if p.ctrl_open.len() > 0 -> p.ctrl_open.clear()
    if p.ctrl_head.len() > 0 -> p.ctrl_head.clear()
    if p.ctrl_false.len() > 0 -> p.ctrl_false.clear()
    if p.ctrl_end_head.len() > 0 -> p.ctrl_end_head.clear()
    if p.ctrl_end_tail.len() > 0 -> p.ctrl_end_tail.clear()
    if p.end_sites.len() > 0 -> p.end_sites.clear()
    if p.end_next.len() > 0 -> p.end_next.clear()
    if p.end_of.len() < op_count {
        p.end_of.try_reserve(op_count) ?? panic("reserve failed")
        loop p.end_of.len() < op_count -> p.end_of.push(-1)
    }
    loop i in 0..<op_count -> p.end_of[i] = -1
    if p.returns.len() > 0 -> p.returns.clear()
    if p.stop_returns.len() > 0 -> p.stop_returns.clear()
    if p.stop_edges.len() > 0 -> p.stop_edges.clear()
    if p.suffix_slot.len() > 0 -> p.suffix_slot.clear()
    if p.suffix_next.len() > 0 -> p.suffix_next.clear()
    if p.suffix_off.len() > 0 -> p.suffix_off.clear()
    if p.tails.len() > 0 -> p.tails.clear()
    if p.colds.len() > 0 -> p.colds.clear()
    if p.zone_sites.len() > 0 -> p.zone_sites.clear()
    if p.zone_stubs.len() > 0 -> p.zone_stubs.clear()
    p.stub_ends = [Int]{}
    p.lines = [X64LineRow]{}
    if p.call_rows.len() > 0 -> p.call_rows.clear()
    if p.call_returns.len() > 0 -> p.call_returns.clear()
    p.calls = [X64CallSite]{}
    if p.alloc_relocs.len() > 0 -> p.alloc_relocs.clear()
    if p.alloc_rows.len() > 0 -> p.alloc_rows.clear()
    p.errors = [String]{}
    p.fused_slot = -1
    p.fused_cc = -1
    p.routed_at = -2
    p.skip_to = -1
    p.in_stop_edge = false
    p.has_drop_plan = false
    p.has_drop_kill = false
    p.below = 0
    p.dynamic = false
    p.has_stream = false
    p.in_stub = false
    p.at = -1
}

// ---------------------------------------------------------------------------
// Lazy per-function data/text use registration (zero pre-scan, zero NameTable).

patch_add_use: fn(p: &IRPatchEmitter, kind: &&IRX64UseKind, data: Int, text: &&String, length: Int) -> Int Never! {
    id: IR_X64_LOCAL_DATA + p.uses.kinds.len()
    p.uses.kinds.push(kind)
    p.uses.data.push(data)
    p.uses.texts.push(text)
    p.use_lengths.push(length)
    id
}

patch_use_len: fn(p: &IRPatchEmitter, local_id: Int) -> Int Never! {
    p.use_lengths[local_id - IR_X64_LOCAL_DATA]
}

patch_file_text: fn(p: &IRPatchEmitter, f: IRFunction) -> Int Never! {
    if p.file_text_row >= 0 -> return p.file_text_row
    id: patch_add_use(p, IRX64UseKind.Text, -1, "{f.source_file}", f.source_file.bytes().len())
    p.file_text_row = id
    id
}

patch_stop_text: fn(p: &IRPatchEmitter, kind: Int) -> Int Never! {
    existing: p.stop_text_rows[kind]
    if existing >= 0 -> return existing
    msg: if kind == {
        0 -> ir_x64_overflow_message("add")
        1 -> ir_x64_overflow_message("sub")
        2 -> ir_x64_overflow_message("mul")
        3 -> ir_x64_overflow_message("div")
        else -> IR_X64_DIVIDED_BY_ZERO
    }
    id: patch_add_use(p, IRX64UseKind.Text, -1, "{msg}", msg.bytes().len())
    p.stop_text_rows[kind] = id
    id
}

patch_header_row: fn(p: &IRPatchEmitter, data_row: Int) -> Int Never! {
    loop (i, key) in p.header_keys {
        if key == data_row -> return p.header_vals[i]
    }
    id: patch_add_use(p, IRX64UseKind.Header, data_row, "", 24)
    p.header_keys.push(data_row)
    p.header_vals.push(id)
    id
}

patch_bigint_rows: fn(p: &IRPatchEmitter, name_row: Int, text: String) -> {text_id: Int, static_id: Int} Never! {
    loop (i, key) in p.int_keys {
        if key == name_row -> return {text_id: p.int_text_vals[i], static_id: p.int_static_vals[i]}
    }
    tid: patch_add_use(p, IRX64UseKind.Text, -1, "{text}", text.bytes().len())
    sid := -1
    if ir_x64_static_int_fits(text) {
        sid = patch_add_use(p, IRX64UseKind.StaticInt, -1, "{text}", 8)
    }
    p.int_keys.push(name_row)
    p.int_text_vals.push(tid)
    p.int_static_vals.push(sid)
    {text_id: tid, static_id: sid}
}

patch_reloc_data: fn(p: &IRPatchEmitter, at: Int, id: Int) Never! {
    if id >= IR_X64_LOCAL_DATA -> p.local_relocs.push(p.relocs.len())
    p.relocs.push(X64Reloc{at: at, target: X64RelocTarget.Data{id: X64DataID{value: id}}})
}

patch_reloc_fn: fn(p: &IRPatchEmitter, at: Int, id: Int) Never! {
    p.relocs.push(X64Reloc{at: at, target: X64RelocTarget.Function{id: X64FunctionID{value: id}}})
}

patch_reloc_rt: fn(p: &IRPatchEmitter, at: Int, symbol: String) Never! {
    p.relocs.push(X64Reloc{at: at, target: X64RelocTarget.Runtime{symbol: symbol}})
}

patch_reloc_rt_data: fn(p: &IRPatchEmitter, at: Int, symbol: String) Never! {
    p.relocs.push(X64Reloc{at: at, target: X64RelocTarget.RuntimeData{symbol: symbol}})
}

// ---------------------------------------------------------------------------
// Compact disp8 / disp32 / folded-const / folded-frame register load & store.

patch_mov_ri: fn(p: &IRPatchEmitter, reg: Int, value: Int) Never! {
    if value == 0 {
        // Note: preserves flags? No, callers that need flag preservation do not use value==0 here,
        // wait: mov reg32, 0 is safer when flags matter; keep mov r32, imm32 (5B) so flags are untouched!
    }
    if value >= 0 && value <= 4294967295 {
        if reg >= 8 -> p.code.push(U8{0x41})
        p.code.push(U8{0xb8 + (reg & 7)})
        patch_push_i32(p.code, value)
    } else if x64_fits_i32(value) {
        p.code.push(U8{if reg >= 8 -> 0x49 else -> 0x48})
        p.code.push(U8{0xc7})
        p.code.push(U8{0xc0 | (reg & 7)})
        patch_push_i32(p.code, value)
    } else {
        p.code.push(U8{if reg >= 8 -> 0x49 else -> 0x48})
        p.code.push(U8{0xb8 + (reg & 7)})
        patch_push_i64(p.code, value)
    }
}

patch_lea_rbp: fn(p: &IRPatchEmitter, reg: Int, disp: Int) Never! {
    p.code.push(U8{if reg >= 8 -> 0x4c else -> 0x48})
    p.code.push(U8{0x8d})
    if patch_fits_i8(disp) {
        p.code.push(U8{0x45 | ((reg & 7) << 3)})
        p.code.push(U8{disp & 255})
    } else {
        p.code.push(U8{0x85 | ((reg & 7) << 3)})
        patch_push_i32(p.code, disp)
    }
}

patch_load_rbp: fn(p: &IRPatchEmitter, reg: Int, disp: Int) Never! {
    if disp == 0 {
        if reg >= 8 -> p.code.push(U8{0x45})
        p.code.push(U8{0x31})
        p.code.push(U8{0xc0 | ((reg & 7) << 3) | (reg & 7)})
        return
    }
    p.code.push(U8{if reg >= 8 -> 0x4c else -> 0x48})
    p.code.push(U8{0x8b})
    if patch_fits_i8(disp) {
        p.code.push(U8{0x45 | ((reg & 7) << 3)})
        p.code.push(U8{disp & 255})
    } else {
        p.code.push(U8{0x85 | ((reg & 7) << 3)})
        patch_push_i32(p.code, disp)
    }
}

patch_load_slot: fn(p: &IRPatchEmitter, reg: Int, slot: Int) Never! {
    if p.is_const[slot] {
        patch_mov_ri(p, reg, p.const_val[slot])
        return
    }
    if p.frames[slot] != 0 {
        patch_lea_rbp(p, reg, p.frames[slot])
        return
    }
    patch_load_rbp(p, reg, p.homes[slot])
}

patch_store_rbp: fn(p: &IRPatchEmitter, disp: Int, reg: Int) Never! {
    if disp == 0 {
        return
    }
    p.code.push(U8{if reg >= 8 -> 0x4c else -> 0x48})
    p.code.push(U8{0x89})
    if patch_fits_i8(disp) {
        p.code.push(U8{0x45 | ((reg & 7) << 3)})
        p.code.push(U8{disp & 255})
    } else {
        p.code.push(U8{0x85 | ((reg & 7) << 3)})
        patch_push_i32(p.code, disp)
    }
}

patch_store_slot: fn(p: &IRPatchEmitter, slot: Int, reg: Int) Never! {
    patch_store_rbp(p, p.homes[slot], reg)
}

patch_lea_rip: fn(p: &IRPatchEmitter, reg: Int) -> Int Never! {
    p.code.push(U8{if reg >= 8 -> 0x4c else -> 0x48})
    p.code.push(U8{0x8d})
    p.code.push(U8{((reg & 7) << 3) | 5})
    site: p.code.len()
    patch_push_i32(p.code, 0)
    site
}

patch_load_rip: fn(p: &IRPatchEmitter, reg: Int) -> Int Never! {
    p.code.push(U8{if reg >= 8 -> 0x4c else -> 0x48})
    p.code.push(U8{0x8b})
    p.code.push(U8{((reg & 7) << 3) | 5})
    site: p.code.len()
    patch_push_i32(p.code, 0)
    site
}

patch_load_xmm: fn(p: &IRPatchEmitter, single: Bool, xmm: Int, disp: Int) Never! {
    p.code.push(U8{if single -> 0xf3 else -> 0xf2})
    if xmm >= 8 -> p.code.push(U8{0x44})
    p.code.push(U8{0x0f})
    p.code.push(U8{0x10})
    if patch_fits_i8(disp) {
        p.code.push(U8{0x45 | ((xmm & 7) << 3)})
        p.code.push(U8{disp & 255})
    } else {
        p.code.push(U8{0x85 | ((xmm & 7) << 3)})
        patch_push_i32(p.code, disp)
    }
}

patch_store_xmm: fn(p: &IRPatchEmitter, single: Bool, disp: Int, xmm: Int) Never! {
    if disp == 0 {
        return
    }
    if single {
        if patch_fits_i8(disp) {
            b: patch_emit(p.code, PATCH_CONST_I32_8)
            p.code[b + 3] = U8{disp & 255}
        } else {
            b: patch_emit(p.code, PATCH_CONST_I32)
            patch_i32(p.code, b + 3, disp)
        }
    }
    p.code.push(U8{if single -> 0xf3 else -> 0xf2})
    if xmm >= 8 -> p.code.push(U8{0x44})
    p.code.push(U8{0x0f})
    p.code.push(U8{0x11})
    if patch_fits_i8(disp) {
        p.code.push(U8{0x45 | ((xmm & 7) << 3)})
        p.code.push(U8{disp & 255})
    } else {
        p.code.push(U8{0x85 | ((xmm & 7) << 3)})
        patch_push_i32(p.code, disp)
    }
}

// Emit ModRM + displacement for `[base + disp]` where base is rax(0), rdx(2), rbp(5), or r10(10).
patch_mem_modrm: fn(code: &[U8], reg: Int, base: Int, disp: Int) Never! {
    rm: base & 7
    r: (reg & 7) << 3
    if disp == 0 && rm != 5 -> code.push(U8{r | rm}) else if patch_fits_i8(disp) {
        code.push(U8{0x40 | r | rm})
        code.push(U8{disp & 255})
    } else {
        code.push(U8{0x80 | r | rm})
        patch_push_i32(code, disp)
    }
}

patch_alu_rax_imm: fn(p: &IRPatchEmitter, ext: Int, imm: Int) Never! {
    p.code.push(U8{0x48})
    if patch_fits_i8(imm) {
        p.code.push(U8{0x83})
        p.code.push(U8{0xc0 | (ext << 3)})
        p.code.push(U8{imm & 255})
    } else {
        p.code.push(U8{0x81})
        p.code.push(U8{0xc0 | (ext << 3)})
        patch_push_i32(p.code, imm)
    }
}

patch_narrow: fn(p: &IRPatchEmitter, reg: Int, signed: Bool, bits: Int) Never! {
    if bits <= 0 || bits >= 64 {
        return
    }
    shift: 64 - bits
    rex: if reg >= 8 -> 0x49 else -> 0x48
    p.code.push(U8{rex})
    p.code.push(U8{0xc1})
    p.code.push(U8{0xe0 | (reg & 7)})
    p.code.push(U8{shift})
    p.code.push(U8{rex})
    p.code.push(U8{0xc1})
    p.code.push(U8{(if signed -> 0xf8 else -> 0xe8) | (reg & 7)})
    p.code.push(U8{shift})
}

patch_normalize: fn(p: &IRPatchEmitter, ty: IRType, reg: Int) Never! {
    if ty.kind == .Bool {
        if reg >= 8 -> p.code.push(U8{0x45}) else if reg >= 4 -> p.code.push(U8{0x40})
        p.code.push(U8{0x0f})
        p.code.push(U8{0xb6})
        p.code.push(U8{0xc0 | ((reg & 7) << 3) | (reg & 7)})
        return
    }
    if ty.kind == .Word {
        bits: if ty.bits > 0 -> ty.bits else -> 64
        patch_narrow(p, reg, ty.signed, bits)
        return
    }
    if ty.kind == .Float32 -> patch_narrow(p, reg, false, 32)
}

patch_jmp: fn(p: &IRPatchEmitter) -> Int Never! {
    p.code.push(U8{0xe9})
    site: p.code.len()
    patch_push_i32(p.code, 0)
    site
}

patch_jmp_to: fn(p: &IRPatchEmitter, target: Int) Never! {
    site: patch_jmp(p)
    patch_rel32(p.code, site, target)
}

patch_jcc: fn(p: &IRPatchEmitter, cc: Int) -> Int Never! {
    p.code.push(U8{0x0f})
    p.code.push(U8{0x80 + cc})
    site: p.code.len()
    patch_push_i32(p.code, 0)
    site
}

// Copies `size` bytes from [from_base + from_disp] to [to_base + to_disp] (bases are rax(0), rdx(2), rbp(5)).
patch_copy_bytes_mem: fn(p: &IRPatchEmitter, from_base: Int, from_disp: Int, to_base: Int, to_disp: Int, size: Int) Never! {
    if size <= 0 {
        return
    }
    if size > 64 {
        // lea rsi, [from_base + from_disp]; lea rdi, [to_base + to_disp]; mov ecx, size; rep movsb
        p.code.push(U8{0x48})
        p.code.push(U8{0x8d})
        patch_mem_modrm(p.code, 6, from_base, from_disp)
        p.code.push(U8{0x48})
        p.code.push(U8{0x8d})
        patch_mem_modrm(p.code, 7, to_base, to_disp)
        patch_mov_ri(p, 1, size)
        p.code.push(U8{0xf3})
        p.code.push(U8{0xa4})
        return
    }
    off := 0
    loop off + 8 <= size {
        p.code.push(U8{0x4c})
        p.code.push(U8{0x8b})
        patch_mem_modrm(p.code, 11, from_base, from_disp + off)
        p.code.push(U8{0x4c})
        p.code.push(U8{0x89})
        patch_mem_modrm(p.code, 11, to_base, to_disp + off)
        off += 8
    }
    loop off < size {
        p.code.push(U8{0x44})
        p.code.push(U8{0x0f})
        p.code.push(U8{0xb6})
        patch_mem_modrm(p.code, 11, from_base, from_disp + off)
        p.code.push(U8{0x41})
        p.code.push(U8{0x88})
        patch_mem_modrm(p.code, 11, to_base, to_disp + off)
        off += 1
    }
}

patch_cold_new: fn(kind: IRX64ColdKind, sites: [Int]) -> IRPatchCold Never! {
    IRPatchCold{kind: kind, sites: sites, resume: -1, symbol: "", left: -1, right: -1, right_imm: 0, dst: -1, cc: 0, text: -1, direction: 0, unsigned: 0, width: 0, line: 0, pad: -1, at: -1}
}

patch_stop_if: fn(p: &IRPatchEmitter, f: IRFunction, at: Int, cc: Int, stop_kind: Int) Never! {
    site: patch_jcc(p, cc)
    cold := patch_cold_new(IRX64ColdKind.Stop, [Int]{site})
    cold.text = patch_stop_text(p, stop_kind)
    cold.line = ir_code_line_source(f.code_line[at])
    cold.at = at
    p.colds.push(cold)
}

patch_cc: fn(op: IROp, unsigned: Bool) -> Int Never! {
    if op == {
        .Eq -> 4
        .Ne -> 5
        .Lt -> if unsigned -> 2 else -> 12
        .Le -> if unsigned -> 6 else -> 14
        .Gt -> if unsigned -> 7 else -> 15
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> if unsigned -> 3 else -> 13
    }
}

patch_slot_class: fn(m: IRModule, f: IRFunction, slot: Int) -> IRX64Class Never! {
    ir_x64_row_class(m, f.slot_type[slot])
}

patch_call_out: fn(p: &IRPatchEmitter, f: IRFunction, target: X64RelocTarget, indirect: Bool, alloc_row: Int) Never! {
    if p.has_stream {
        p.code.push(U8{0x0f})
        p.code.push(U8{0xae})
        p.code.push(U8{0xf8})
    }
    start: p.code.len()
    if indirect {
        p.dynamic = true
        p.code.push(U8{0x41})
        p.code.push(U8{0xff})
        p.code.push(U8{0xd2})
    } else {
        p.code.push(U8{0xe8})
        site: p.code.len()
        patch_push_i32(p.code, 0)
        p.relocs.push(X64Reloc{at: site, target: target})
        if alloc_row >= 0 {
            p.alloc_relocs.push(p.relocs.len() - 1)
            p.alloc_rows.push(alloc_row)
        }
    }
    at: p.at
    if at >= 0 && at < f.code_line.len() {
        row: ir_code_line_call(f.code_line[at])
        word: IR_CALL_SITE_WORDS * (row - 1)
        if row != 0 && word + 1 < f.call_sites.len() {
            p.call_rows.push(X64LineRow{at: start, line: f.call_sites[word], column: f.call_sites[word + 1], call: true})
            p.call_returns.push(p.code.len())
        }
    }
}

// Whether comparison/not `at`'s Bool result is consumed only by the immediately
// following If/BrIf (or a Not feeding that If/BrIf) after `after_at`, so it can
// stay in CPU flags.
patch_fusable_after: fn(f: IRFunction, p: &IRPatchEmitter, at: Int, after_at: Int) -> Bool Never! {
    next_at: after_at + 1
    if next_at >= f.op.len() -> return false
    dst: f.dst[at]
    if dst < f.param_count || f.slot_kind[dst] != .Temp || p.ends[dst] != next_at || f.a[next_at] != dst {
        return false
    }
    if f.op[next_at] == .If || f.op[next_at] == .BrIf -> return true
    f.op[next_at] == .Not && patch_fusable_after(f, p, next_at, next_at)
}

patch_fusable: fn(f: IRFunction, p: &IRPatchEmitter, at: Int) -> Bool Never! {
    patch_fusable_after(f, p, at, at)
}

// Absorbs immediately following exact-Int Drop instructions of `at`'s operands
// (when the hot path already proved them inline, their Drop is a no-op on the
// hot path and only runs in the cold slow path!).
patch_operand_drops: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) -> {d0: Int, d1: Int, end_at: Int} Never! {
    d0 := -1
    d1 := -1
    end_at := at
    next_at := at + 1
    loop next_at < f.op.len() && f.op[next_at] == .Drop {
        slot: f.a[next_at]
        if (slot != f.a[at] && slot != f.b[at]) || slot == f.dst[at] || slot == d0 || slot == d1 {
            break
        }
        ty: m.types[f.slot_type[slot]]
        if ty.kind != .Int || ty.drop == "" -> break
        if d0 < 0 -> d0 = slot else -> d1 = slot
        end_at = next_at
        next_at += 1
    }
    if end_at > at -> p.skip_to = end_at
    {d0: d0, d1: d1, end_at: end_at}
}

patch_located_stops: fn(p: &IRPatchEmitter, f: IRFunction, cold_at: Int, cold_right: Int) -> Bool Never! {
    if cold_at < 0 || cold_right < 0 || !p.is_const[cold_right] -> return true
    op: f.op[cold_at]
    if (op == .Div || op == .Rem || op == .FloorDiv || op == .Mod) && p.const_val[cold_right] != 0 {
        return false
    }
    true
}

// ---------------------------------------------------------------------------
// Call, tail jump, memory, arithmetic, control emitters.

patch_call: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, target: X64RelocTarget, indirect: Int, args: [Int], start: Int, count: Int, dst: Int, alloc_row: Int) Never! {
    sret := false
    storage := 0
    if dst >= 0 {
        dst_ty: m.types[f.slot_type[dst]]
        if dst_ty.kind == .Aggregate {
            sret = true
            align: if dst_ty.align > 16 -> 16 else if dst_ty.align < 8 -> 8 else -> dst_ty.align
            p.depth = ir_x64_align(p.depth + ir_x64_align(dst_ty.size, 8), align)
            storage = 0 - p.depth
        }
    }
    general := if sret -> 1 else -> 0
    floats := 0
    places := [Int]{}
    stacked := [Int]{}
    loop pos in start..<(start + count) {
        cls: patch_slot_class(m, f, args[pos])
        if cls == .Empty {
            places.push(-2)
            next
        }
        if cls == .Float && floats < 8 {
            places.push(16 + floats)
            floats += 1
            next
        }
        if cls != .Float && general < 6 {
            places.push(IR_X64_ARGUMENT_REGISTERS[general])
            general += 1
            next
        }
        places.push(-1)
        stacked.push(pos)
    }
    pad: stacked.len() % 2
    pushed_bytes: 8 * (stacked.len() + pad)
    if pushed_bytes > p.below -> p.below = pushed_bytes
    if pad == 1 {
        p.code.push(U8{0x48})
        p.code.push(U8{0x83})
        p.code.push(U8{0xec})
        p.code.push(U8{8})
    }
    idx := stacked.len() - 1
    loop idx >= 0 {
        patch_load_slot(p, 11, args[stacked[idx]])
        p.code.push(U8{0x41})
        p.code.push(U8{0x53})
        idx -= 1
    }
    loop (row, place) in places {
        slot: args[start + row]
        if place >= 16 {
            patch_load_xmm(p, m.types[f.slot_type[slot]].kind == .Float32, place - 16, p.homes[slot])
        } else if place >= 0 { patch_load_slot(p, place, slot) }
    }
    if sret -> patch_lea_rbp(p, 7, storage)
    if indirect >= 0 -> patch_load_slot(p, 10, indirect)
    rows_before: p.call_rows.len()
    patch_call_out(p, f, target, indirect >= 0, alloc_row)
    if p.call_rows.len() > rows_before {
        kept := [X64CallArgument]{}
        loop (row, place) in places {
            if place >= 0 && place < 16 {
                slot: args[start + row]
                if p.is_const[slot] {
                    kept.push(X64CallArgument{reg: place, value: X64DebugLocation.Constant{value: p.const_val[slot]}})
                } else if p.frames[slot] != 0 {
                    kept.push(X64CallArgument{reg: place, value: X64DebugLocation.FrameAddress{offset: p.frames[slot]}})
                } else if p.homes[slot] != 0 {
                    kept.push(X64CallArgument{reg: place, value: X64DebugLocation.Frame{offset: p.homes[slot]}})
                }
            }
        }
        if !kept.is_empty() {
            p.calls.push(X64CallSite{at: p.call_returns[rows_before], line: p.call_rows[rows_before].line, column: p.call_rows[rows_before].column, arguments: kept})
        }
    }
    if pushed_bytes > 0 {
        p.code.push(U8{0x48})
        if patch_fits_i8(pushed_bytes) {
            p.code.push(U8{0x83})
            p.code.push(U8{0xc4})
            p.code.push(U8{pushed_bytes & 255})
        } else {
            p.code.push(U8{0x81})
            p.code.push(U8{0xc4})
            patch_push_i32(p.code, pushed_bytes)
        }
    }
    if dst < 0 {
        return
    }
    if sret {
        patch_lea_rbp(p, 0, storage)
        patch_store_slot(p, dst, 0)
        return
    }
    dst_ty: m.types[f.slot_type[dst]]
    cls: ir_x64_row_class(m, f.slot_type[dst])
    if cls == .General {
        patch_normalize(p, dst_ty, 0)
        patch_store_slot(p, dst, 0)
    } else if cls == .Float { patch_store_xmm(p, dst_ty.kind == .Float32, p.homes[dst], 0) }
}

patch_tail_jump: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    general := 0
    floats := 0
    loop pos in f.b[at]..<(f.b[at] + f.c[at]) {
        slot: f.args[pos]
        cls: patch_slot_class(m, f, slot)
        if cls == .Empty -> next
        if cls == .Float {
            if floats >= 8 {
                p.errors.push("{f.name}: tail call with a stack argument")
                return
            }
            patch_load_xmm(p, m.types[f.slot_type[slot]].kind == .Float32, floats, p.homes[slot])
            floats += 1
            next
        }
        if general >= 6 {
            p.errors.push("{f.name}: tail call with a stack argument")
            return
        }
        patch_load_slot(p, IR_X64_ARGUMENT_REGISTERS[general], slot)
        general += 1
    }
    if p.has_stream {
        p.code.push(U8{0x0f})
        p.code.push(U8{0xae})
        p.code.push(U8{0xf8})
    }
    p.code.push(U8{0xc9})
    p.tails.push(p.code.len())
    site: patch_jmp(p)
    patch_reloc_fn(p, site, f.a[at])
}

patch_emit_load: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    dst: f.dst[at]
    ty: m.types[f.slot_type[dst]]
    if ty.kind == .Unit {
        return
    }
    addr: f.a[at]
    base := 0
    off := f.b[at]
    if p.frames[addr] != 0 {
        base = 5
        off = p.frames[addr] + off
    } else { patch_load_slot(p, 0, addr) }
    if !x64_fits_i32(off) {
        p.errors.push("{f.name}: offset {off} does not fit a displacement")
        return
    }
    width: if ty.kind == .Bool -> 1 else if ty.kind == .Float32 -> 4 else if ty.kind == .Word && (ty.size == 1 || ty.size == 2 || ty.size == 4) -> ty.size else -> 8
    if width == 8 {
        p.code.push(U8{0x48})
        p.code.push(U8{0x8b})
        patch_mem_modrm(p.code, 0, base, off)
    } else if width == 4 {
        if ty.kind == .Word && ty.signed {
            p.code.push(U8{0x48})
            p.code.push(U8{0x63})
        } else { p.code.push(U8{0x8b}) }
        patch_mem_modrm(p.code, 0, base, off)
    } else if width == 2 {
        if ty.kind == .Word && ty.signed {
            p.code.push(U8{0x48})
            p.code.push(U8{0x0f})
            p.code.push(U8{0xbf})
        } else {
            p.code.push(U8{0x0f})
            p.code.push(U8{0xb7})
        }
        patch_mem_modrm(p.code, 0, base, off)
    } else {
        if ty.kind == .Word && ty.signed {
            p.code.push(U8{0x48})
            p.code.push(U8{0x0f})
            p.code.push(U8{0xbe})
        } else {
            p.code.push(U8{0x0f})
            p.code.push(U8{0xb6})
        }
        patch_mem_modrm(p.code, 0, base, off)
    }
    patch_store_slot(p, dst, 0)
}

patch_emit_store: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int, stream: Bool) Never! {
    val: f.c[at]
    ty: m.types[f.slot_type[val]]
    if ty.kind == .Unit {
        return
    }
    addr: f.a[at]
    base := 0
    off := f.b[at]
    if p.frames[addr] != 0 {
        base = 5
        off = p.frames[addr] + off
    } else { patch_load_slot(p, 0, addr) }
    if !x64_fits_i32(off) {
        p.errors.push("{f.name}: offset {off} does not fit a displacement")
        return
    }
    width: if ty.kind == .Bool -> 1 else if ty.kind == .Float32 -> 4 else if ty.kind == .Word && (ty.size == 1 || ty.size == 2 || ty.size == 4) -> ty.size else -> 8
    if stream && (width == 8 || width == 4) {
        p.has_stream = true
        patch_load_slot(p, 1, val)
        if width == 8 -> p.code.push(U8{0x48})
        p.code.push(U8{0x0f})
        p.code.push(U8{0xc3})
        patch_mem_modrm(p.code, 1, base, off)
        return
    }
    // Immediate store for folded Const values
    if p.is_const[val] && (width < 8 || x64_fits_i32(p.const_val[val])) {
        v: p.const_val[val]
        if width == 8 {
            p.code.push(U8{0x48})
            p.code.push(U8{0xc7})
            patch_mem_modrm(p.code, 0, base, off)
            patch_push_i32(p.code, v)
        } else if width == 4 {
            p.code.push(U8{0xc7})
            patch_mem_modrm(p.code, 0, base, off)
            patch_push_i32(p.code, v)
        } else if width == 2 {
            p.code.push(U8{0x66})
            p.code.push(U8{0xc7})
            patch_mem_modrm(p.code, 0, base, off)
            p.code.push(U8{v & 255})
            p.code.push(U8{(v >> 8) & 255})
        } else {
            p.code.push(U8{0xc6})
            patch_mem_modrm(p.code, 0, base, off)
            p.code.push(U8{v & 255})
        }
        return
    }
    patch_load_slot(p, 1, val)
    if width == 8 {
        p.code.push(U8{0x48})
        p.code.push(U8{0x89})
    } else if width == 4 { p.code.push(U8{0x89}) } else if width == 2 {
        p.code.push(U8{0x66})
        p.code.push(U8{0x89})
    } else { p.code.push(U8{0x88}) }
    patch_mem_modrm(p.code, 1, base, off)
}

patch_floor_adjust: fn(p: &IRPatchEmitter, op: IROp) Never! {
    p.code.push(U8{0x48})
    p.code.push(U8{0x85})
    p.code.push(U8{0xd2})
    exact: patch_jcc(p, 4)
    p.code.push(U8{0x49})
    p.code.push(U8{0x89})
    p.code.push(U8{0xd3})
    p.code.push(U8{0x49})
    p.code.push(U8{0x31})
    p.code.push(U8{0xcb})
    same: patch_jcc(p, 9)
    if op == .FloorDiv {
        p.code.push(U8{0x48})
        p.code.push(U8{0x83})
        p.code.push(U8{0xe8})
        p.code.push(U8{0x01})
    } else {
        p.code.push(U8{0x48})
        p.code.push(U8{0x01})
        p.code.push(U8{0xca})
    }
    done: p.code.len()
    patch_rel32(p.code, exact, done)
    patch_rel32(p.code, same, done)
}

patch_range_check: fn(p: &IRPatchEmitter, f: IRFunction, at: Int, signed: Bool, bits: Int, stop_kind: Int) Never! {
    p.code.push(U8{0x48})
    p.code.push(U8{0x89})
    p.code.push(U8{0xc2})
    patch_narrow(p, 2, signed, bits)
    p.code.push(U8{0x48})
    p.code.push(U8{0x39})
    p.code.push(U8{0xc2})
    patch_stop_if(p, f, at, 5, stop_kind)
}

patch_word_binary: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int, ty: IRType, positive_div: Bool) Never! {
    op: f.op[at]
    sa: f.a[at]
    sb: f.b[at]
    dst: f.dst[at]
    ha: p.homes[sa]
    hb: p.homes[sb]
    hd: p.homes[dst]
    unsigned: ty.kind == .Bool || ty.kind == .Char || ty.kind == .Pointer || (ty.kind == .Word && !ty.signed)
    if op == .Eq || op == .Ne || op == .Lt || op == .Le || op == .Gt || op == .Ge {
        cc: patch_cc(op, unsigned)
        fused: patch_fusable(f, p, at)
        if !fused && !p.is_const[sa] && p.frames[sa] == 0 && !p.is_const[sb] && p.frames[sb] == 0 && patch_fits_i8(ha) && patch_fits_i8(hb) && patch_fits_i8(hd) && ha != 0 && hb != 0 && hd != 0 {
            b: patch_emit(p.code, PATCH_CMP_WORD_8)
            p.code[b + 3] = U8{ha & 255}
            p.code[b + 7] = U8{hb & 255}
            p.code[b + 9] = U8{0x90 + cc}
            p.code[b + 17] = U8{hd & 255}
            p.fused_slot = dst
            p.fused_cc = cc
            return
        }
        patch_load_slot(p, 0, sa)
        if p.is_const[sb] && x64_fits_i32(p.const_val[sb]) {
            v: p.const_val[sb]
            if v == 0 {
                p.code.push(U8{0x48})
                p.code.push(U8{0x85})
                p.code.push(U8{0xc0})
            } else { patch_alu_rax_imm(p, 7, v) }
        } else if !p.is_const[sb] && p.frames[sb] == 0 && hb != 0 && patch_fits_i8(hb) {
            p.code.push(U8{0x48})
            p.code.push(U8{0x3b})
            p.code.push(U8{0x45})
            p.code.push(U8{hb & 255})
        } else {
            patch_load_slot(p, 1, sb)
            p.code.push(U8{0x48})
            p.code.push(U8{0x39})
            p.code.push(U8{0xc8})
        }
        if !fused {
            p.code.push(U8{0x0f})
            p.code.push(U8{0x90 + cc})
            p.code.push(U8{0xc0})
            p.code.push(U8{0x0f})
            p.code.push(U8{0xb6})
            p.code.push(U8{0xc0})
            patch_store_slot(p, dst, 0)
        }
        p.fused_slot = dst
        p.fused_cc = cc
        return
    }
    bits: if ty.kind == .Word && ty.bits > 0 -> ty.bits else -> 64
    trap: f.c[at] != IR_OVERFLOW_WRAP && f.c[at] != IR_OVERFLOW_NONNEG
    has_imm: p.is_const[sb] && x64_fits_i32(p.const_val[sb])
    // Fast-path 64-bit wrapping ALU & bitwise ops on disp8 frame slots!
    if (op == .BitAnd || op == .BitOr || op == .BitXor) || ((op == .Add || op == .Sub) && bits == 64 && !trap) {
        if !has_imm && !p.is_const[sa] && p.frames[sa] == 0 && !p.is_const[sb] && p.frames[sb] == 0 && patch_fits_i8(ha) && patch_fits_i8(hb) && patch_fits_i8(hd) && ha != 0 && hb != 0 && hd != 0 {
            b: patch_emit(p.code, PATCH_ALU64_WRAP_8)
            p.code[b + 3] = U8{ha & 255}
            p.code[b + 5] = U8{if op == .Add -> 0x03 else if op == .Sub -> 0x2b else if op == .BitAnd -> 0x23 else if op == .BitOr -> 0x0b else -> 0x33}
            p.code[b + 7] = U8{hb & 255}
            p.code[b + 11] = U8{hd & 255}
            return
        }
        patch_load_slot(p, 0, sa)
        if has_imm {
            ext: if op == .Add -> 0 else if op == .Sub -> 5 else if op == .BitAnd -> 4 else if op == .BitOr -> 1 else -> 6
            patch_alu_rax_imm(p, ext, p.const_val[sb])
        } else {
            patch_load_slot(p, 1, sb)
            p.code.push(U8{0x48})
            p.code.push(U8{if op == .Add -> 0x01 else if op == .Sub -> 0x29 else if op == .BitAnd -> 0x21 else if op == .BitOr -> 0x09 else -> 0x31})
            p.code.push(U8{0xc8})
        }
        patch_store_slot(p, dst, 0)
        return
    }
    if op == .Shl || op == .Shr {
        patch_load_slot(p, 0, sa)
        if p.is_const[sb] && p.const_val[sb] >= 0 && p.const_val[sb] < bits {
            cnt: p.const_val[sb]
            p.code.push(U8{0x48})
            p.code.push(U8{0xc1})
            p.code.push(U8{if op == .Shl -> 0xe0 else if unsigned -> 0xe8 else -> 0xf8})
            p.code.push(U8{cnt & 63})
            if op == .Shl -> patch_narrow(p, 0, !unsigned, bits)
            patch_store_slot(p, dst, 0)
            return
        }
        patch_load_slot(p, 1, sb)
        if trap {
            p.code.push(U8{0x48})
            p.code.push(U8{0x83})
            p.code.push(U8{0xf9})
            p.code.push(U8{bits})
            site: patch_jcc(p, 3)
            cold := patch_cold_new(IRX64ColdKind.ShiftStop, [Int]{site})
            cold.right = sb
            cold.direction = if op == .Shl -> 0 else -> 1
            cold.unsigned = if unsigned -> 1 else -> 0
            cold.width = bits
            cold.line = ir_code_line_source(f.code_line[at])
            cold.at = at
            p.colds.push(cold)
        }
        if op == .Shl {
            p.code.push(U8{0x48})
            p.code.push(U8{0xd3})
            p.code.push(U8{0xe0})
            patch_narrow(p, 0, !unsigned, bits)
        } else {
            p.code.push(U8{0x48})
            p.code.push(U8{0xd3})
            p.code.push(U8{if unsigned -> 0xe8 else -> 0xf8})
        }
        patch_store_slot(p, dst, 0)
        return
    }
    patch_load_slot(p, 0, sa)
    if op == .Add || op == .Sub || op == .Mul {
        stop_kind: if op == .Add -> 0 else if op == .Sub -> 1 else -> 2
        if has_imm && !(op == .Mul && unsigned && bits == 64 && trap) {
            v: p.const_val[sb]
            if op == .Mul {
                p.code.push(U8{0x48})
                if patch_fits_i8(v) {
                    p.code.push(U8{0x6b})
                    p.code.push(U8{0xc0})
                    p.code.push(U8{v & 255})
                } else {
                    p.code.push(U8{0x69})
                    p.code.push(U8{0xc0})
                    patch_push_i32(p.code, v)
                }
            } else { patch_alu_rax_imm(p, if op == .Add -> 0 else -> 5, v) }
        } else {
            patch_load_slot(p, 1, sb)
            if op == .Add {
                p.code.push(U8{0x48})
                p.code.push(U8{0x01})
                p.code.push(U8{0xc8})
            } else if op == .Sub {
                p.code.push(U8{0x48})
                p.code.push(U8{0x29})
                p.code.push(U8{0xc8})
            } else if unsigned && bits == 64 {
                p.code.push(U8{0x48})
                p.code.push(U8{0xf7})
                p.code.push(U8{0xe1})
            } else {
                p.code.push(U8{0x48})
                p.code.push(U8{0x0f})
                p.code.push(U8{0xaf})
                p.code.push(U8{0xc1})
            }
        }
        if bits == 64 {
            if trap {
                cc: if unsigned && op != .Mul -> 2 else -> 0
                patch_stop_if(p, f, at, cc, stop_kind)
            }
        } else if trap { patch_range_check(p, f, at, !unsigned, bits, stop_kind) } else {
            patch_narrow(p, 0, !unsigned, bits)
        }
        patch_store_slot(p, dst, 0)
        return
    }
    // Div / Rem / FloorDiv / Mod
    patch_load_slot(p, 1, sb)
    rem: op == .Rem || op == .Mod
    if positive_div {
        p.code.push(U8{0x48})
        p.code.push(U8{0x99})
        p.code.push(U8{0x48})
        p.code.push(U8{0xf7})
        p.code.push(U8{0xf9})
        if op == .FloorDiv || op == .Mod -> patch_floor_adjust(p, op)
        if rem -> patch_store_slot(p, dst, 2) else -> patch_store_slot(p, dst, 0)
        return
    }
    p.code.push(U8{0x48})
    p.code.push(U8{0x85})
    p.code.push(U8{0xc9})
    patch_stop_if(p, f, at, 4, 4)
    if unsigned {
        p.code.push(U8{0x31})
        p.code.push(U8{0xd2})
        p.code.push(U8{0x48})
        p.code.push(U8{0xf7})
        p.code.push(U8{0xf1})
        if rem -> patch_store_slot(p, dst, 2) else -> patch_store_slot(p, dst, 0)
        return
    }
    p.code.push(U8{0x48})
    p.code.push(U8{0x83})
    p.code.push(U8{0xf9})
    p.code.push(U8{0xff})
    divide: patch_jcc(p, 5)
    if rem {
        p.code.push(U8{0x31})
        p.code.push(U8{0xc0})
    } else {
        if trap {
            patch_mov_ri(p, 2, ir_x64_signed_min(bits))
            p.code.push(U8{0x48})
            p.code.push(U8{0x39})
            p.code.push(U8{0xd0})
            patch_stop_if(p, f, at, 4, 3)
        }
        p.code.push(U8{0x48})
        p.code.push(U8{0xf7})
        p.code.push(U8{0xd8})
        patch_narrow(p, 0, true, bits)
    }
    done_jmp: patch_jmp(p)
    patch_rel32(p.code, divide, p.code.len())
    p.code.push(U8{0x48})
    p.code.push(U8{0x99})
    p.code.push(U8{0x48})
    p.code.push(U8{0xf7})
    p.code.push(U8{0xf9})
    if op == .FloorDiv || op == .Mod -> patch_floor_adjust(p, op)
    if rem {
        p.code.push(U8{0x48})
        p.code.push(U8{0x89})
        p.code.push(U8{0xd0})
    }
    patch_rel32(p.code, done_jmp, p.code.len())
    patch_store_slot(p, dst, 0)
}

patch_exact_binary: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    op: f.op[at]
    sa: f.a[at]
    sb: f.b[at]
    dst: f.dst[at]
    a_const: p.is_const[sa]
    b_const: p.is_const[sb]
    b_imm: b_const && x64_fits_i32(p.const_val[sb])
    if op == .Eq || op == .Ne || op == .Lt || op == .Le || op == .Gt || op == .Ge {
        cc: patch_cc(op, false)
        // Eq / Ne against a constant compares raw words (big ints never equal inline constants).
        words: (op == .Eq || op == .Ne) && (a_const || b_const)
        drops: if !words && !p.in_stop_edge -> patch_operand_drops(p, m, f, at) else -> {d0: -1, d1: -1, end_at: at}
        fused: patch_fusable_after(f, p, at, drops.end_at)
        sites := [Int]{}
        patch_load_slot(p, 0, sa)
        if !words && !a_const {
            t1: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
            sites.push(t1 + 8)
        }
        if b_imm {
            v: p.const_val[sb]
            if v == 0 {
                p.code.push(U8{0x48})
                p.code.push(U8{0x85})
                p.code.push(U8{0xc0})
            } else { patch_alu_rax_imm(p, 7, v) }
        } else {
            patch_load_slot(p, 1, sb)
            if !words && !b_const {
                t2: patch_emit(p.code, PATCH_TEST_INLINE_RCX)
                sites.push(t2 + 8)
            }
            p.code.push(U8{0x48})
            p.code.push(U8{0x39})
            p.code.push(U8{0xc8})
        }
        if !fused {
            p.code.push(U8{0x0f})
            p.code.push(U8{0x90 + cc})
            p.code.push(U8{0xc0})
            p.code.push(U8{0x0f})
            p.code.push(U8{0xb6})
            p.code.push(U8{0xc0})
            patch_store_slot(p, dst, 0)
        }
        p.fused_slot = dst
        p.fused_cc = cc
        if sites.is_empty() {
            return
        }
        cold := patch_cold_new(IRX64ColdKind.Compare, sites)
        cold.resume = p.code.len()
        cold.left = sa
        cold.right = sb
        cold.dst = if fused -> -1 else -> dst
        cold.cc = cc
        cold.at = at
        cold.drop0 = drops.d0
        cold.drop1 = drops.d1
        p.colds.push(cold)
        return
    }
    if op == .Add || op == .Sub || op == .Mul {
        policy: f.c[at]
        left_inline: a_const || policy == IR_OVERFLOW_OPERANDS || policy == IR_OVERFLOW_LEFT
        right_inline: b_const || policy == IR_OVERFLOW_OPERANDS || policy == IR_OVERFLOW_RIGHT
        drops: if !p.in_stop_edge -> patch_operand_drops(p, m, f, at) else -> {d0: -1, d1: -1, end_at: at}
        sites := [Int]{}
        patch_load_slot(p, 0, sa)
        if !left_inline {
            t1: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
            sites.push(t1 + 8)
        }
        if op != .Mul && b_imm {
            patch_alu_rax_imm(p, if op == .Add -> 0 else -> 5, p.const_val[sb])
        } else {
            patch_load_slot(p, 1, sb)
            if !right_inline {
                t2: patch_emit(p.code, PATCH_TEST_INLINE_RCX)
                sites.push(t2 + 8)
            }
            if op == .Add {
                p.code.push(U8{0x48})
                p.code.push(U8{0x01})
                p.code.push(U8{0xc8})
            } else if op == .Sub {
                p.code.push(U8{0x48})
                p.code.push(U8{0x29})
                p.code.push(U8{0xc8})
            } else {
                p.code.push(U8{0x48})
                p.code.push(U8{0x0f})
                p.code.push(U8{0xaf})
                p.code.push(U8{0xc1})
                sites.push(patch_jcc(p, 0))
            }
        }
        tr: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
        sites.push(tr + 8)
        patch_store_slot(p, dst, 0)
        cold := patch_cold_new(IRX64ColdKind.Route, sites)
        cold.resume = p.code.len()
        cold.symbol = if op == .Add -> "jet_int_add" else if op == .Sub -> "jet_int_sub" else -> "jet_int_mul"
        cold.left = sa
        cold.right = sb
        cold.dst = dst
        cold.at = at
        cold.drop0 = drops.d0
        cold.drop1 = drops.d1
        p.colds.push(cold)
        return
    }
    if op == .BitAnd || op == .BitOr || op == .BitXor {
        drops: if !p.in_stop_edge -> patch_operand_drops(p, m, f, at) else -> {d0: -1, d1: -1, end_at: at}
        sites := [Int]{}
        patch_load_slot(p, 0, sa)
        if !a_const {
            t1: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
            sites.push(t1 + 8)
        }
        if b_imm {
            patch_alu_rax_imm(p, if op == .BitAnd -> 4 else if op == .BitOr -> 1 else -> 6, p.const_val[sb])
        } else {
            patch_load_slot(p, 1, sb)
            if !b_const {
                t2: patch_emit(p.code, PATCH_TEST_INLINE_RCX)
                sites.push(t2 + 8)
            }
            p.code.push(U8{0x48})
            p.code.push(U8{if op == .BitAnd -> 0x21 else if op == .BitOr -> 0x09 else -> 0x31})
            p.code.push(U8{0xc8})
        }
        patch_store_slot(p, dst, 0)
        if sites.is_empty() {
            return
        }
        cold := patch_cold_new(IRX64ColdKind.Route, sites)
        cold.resume = p.code.len()
        cold.symbol = if op == .BitAnd -> "jet_int_bit_and" else if op == .BitOr -> "jet_int_bit_or" else -> "jet_int_bit_xor"
        cold.left = sa
        cold.right = sb
        cold.dst = dst
        cold.at = at
        cold.drop0 = drops.d0
        cold.drop1 = drops.d1
        p.colds.push(cold)
        return
    }
    if op == .Div || op == .Rem || op == .FloorDiv || op == .Mod {
        sites := [Int]{}
        patch_load_slot(p, 0, sa)
        if !a_const {
            t1: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
            sites.push(t1 + 8)
        }
        patch_load_slot(p, 1, sb)
        if !b_const {
            t2: patch_emit(p.code, PATCH_TEST_INLINE_RCX)
            sites.push(t2 + 8)
        }
        if !b_const || p.const_val[sb] == 0 || p.const_val[sb] == -1 {
            p.code.push(U8{0x48})
            p.code.push(U8{0x8d})
            p.code.push(U8{0x51})
            p.code.push(U8{0x01})
            p.code.push(U8{0x48})
            p.code.push(U8{0x83})
            p.code.push(U8{0xfa})
            p.code.push(U8{0x01})
            sites.push(patch_jcc(p, 6))
        }
        p.code.push(U8{0x48})
        p.code.push(U8{0x99})
        p.code.push(U8{0x48})
        p.code.push(U8{0xf7})
        p.code.push(U8{0xf9})
        if op == .FloorDiv || op == .Mod -> patch_floor_adjust(p, op)
        if op == .Rem || op == .Mod -> patch_store_slot(p, dst, 2) else {
            patch_store_slot(p, dst, 0)
        }
        if sites.is_empty() {
            return
        }
        cold := patch_cold_new(IRX64ColdKind.LocatedRoute, sites)
        cold.resume = p.code.len()
        cold.symbol = ir_x64_division_symbol(op)
        cold.left = sa
        cold.right = sb
        cold.dst = dst
        cold.line = ir_code_line_source(f.code_line[at])
        cold.at = at
        p.colds.push(cold)
        return
    }
    // Exact Int Shl / Shr
    left_shift: op == .Shl
    sites := [Int]{}
    patch_load_slot(p, 0, sa)
    if !a_const {
        t1: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
        sites.push(t1 + 8)
    }
    patch_load_slot(p, 1, sb)
    if !b_const {
        t2: patch_emit(p.code, PATCH_TEST_INLINE_RCX)
        sites.push(t2 + 8)
    }
    limit: if left_shift -> 63 else -> 64
    if !b_const || p.const_val[sb] < 0 || p.const_val[sb] >= limit {
        p.code.push(U8{0x48})
        p.code.push(U8{0x83})
        p.code.push(U8{0xf9})
        p.code.push(U8{limit})
        sites.push(patch_jcc(p, 3))
    }
    if left_shift {
        p.code.push(U8{0x48})
        p.code.push(U8{0x89})
        p.code.push(U8{0xc2})
        p.code.push(U8{0x48})
        p.code.push(U8{0xd3})
        p.code.push(U8{0xe2})
        p.code.push(U8{0x49})
        p.code.push(U8{0x89})
        p.code.push(U8{0xd3})
        p.code.push(U8{0x49})
        p.code.push(U8{0xd3})
        p.code.push(U8{0xfb})
        p.code.push(U8{0x49})
        p.code.push(U8{0x39})
        p.code.push(U8{0xc3})
        sites.push(patch_jcc(p, 5))
        p.code.push(U8{0x48})
        p.code.push(U8{0x89})
        p.code.push(U8{0xd0})
        tr: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
        sites.push(tr + 8)
    } else {
        p.code.push(U8{0x48})
        p.code.push(U8{0xd3})
        p.code.push(U8{0xf8})
    }
    patch_store_slot(p, dst, 0)
    if sites.is_empty() {
        return
    }
    cold := patch_cold_new(IRX64ColdKind.LocatedRoute, sites)
    cold.resume = p.code.len()
    cold.symbol = if left_shift -> "jet_int_shl" else -> "jet_int_shr"
    cold.left = sa
    cold.right = sb
    cold.dst = dst
    cold.line = ir_code_line_source(f.code_line[at])
    cold.at = at
    p.colds.push(cold)
}

patch_float_binary: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int, single: Bool) Never! {
    op: f.op[at]
    ha: p.homes[f.a[at]]
    hb: p.homes[f.b[at]]
    hd: p.homes[f.dst[at]]
    if op == .Rem {
        patch_call(p, m, f, X64RelocTarget.Runtime{symbol: if single -> "fmodf" else -> "fmod"}, -1, [Int]{f.a[at], f.b[at]}, 0, 2, f.dst[at], -1)
        return
    }
    if op == .Eq || op == .Ne || op == .Lt || op == .Le || op == .Gt || op == .Ge {
        patch_load_xmm(p, single, 0, ha)
        patch_load_xmm(p, single, 1, hb)
        if !single -> p.code.push(U8{0x66})
        p.code.push(U8{0x0f})
        p.code.push(U8{0x2e})
        p.code.push(U8{if op == .Lt || op == .Le -> 0xc8 else -> 0xc1})
        if op == .Eq {
            p.code.push(U8{0x0f})
            p.code.push(U8{0x94})
            p.code.push(U8{0xc0})
            p.code.push(U8{0x0f})
            p.code.push(U8{0x9b})
            p.code.push(U8{0xc1})
            p.code.push(U8{0x20})
            p.code.push(U8{0xc8})
        } else if op == .Ne {
            p.code.push(U8{0x0f})
            p.code.push(U8{0x95})
            p.code.push(U8{0xc0})
            p.code.push(U8{0x0f})
            p.code.push(U8{0x9a})
            p.code.push(U8{0xc1})
            p.code.push(U8{0x08})
            p.code.push(U8{0xc8})
        } else {
            p.code.push(U8{0x0f})
            p.code.push(U8{if op == .Gt || op == .Lt -> 0x97 else -> 0x93})
            p.code.push(U8{0xc0})
        }
        p.code.push(U8{0x0f})
        p.code.push(U8{0xb6})
        p.code.push(U8{0xc0})
        patch_store_slot(p, f.dst[at], 0)
        return
    }
    fop: if op == .Add -> 0x58 else if op == .Sub -> 0x5c else if op == .Mul -> 0x59 else -> 0x5e
    patch_load_xmm(p, single, 0, ha)
    p.code.push(U8{if single -> 0xf3 else -> 0xf2})
    p.code.push(U8{0x0f})
    p.code.push(U8{fop})
    patch_mem_modrm(p.code, 0, 5, hb)
    if op == .FloorDiv {
        patch_call_out(p, f, X64RelocTarget.Runtime{symbol: if single -> "floorf" else -> "floor"}, false, -1)
    }
    patch_store_xmm(p, single, hd, 0)
}

patch_string_binary: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    op: f.op[at]
    patch_load_slot(p, 7, f.a[at])
    patch_load_slot(p, 6, f.b[at])
    if op == .Eq || op == .Ne {
        patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_string_eq"}, false, -1)
        p.code.push(U8{0x0f})
        p.code.push(U8{0xb6})
        p.code.push(U8{0xc0})
        if op == .Ne {
            p.code.push(U8{0x48})
            p.code.push(U8{0x83})
            p.code.push(U8{0xf0})
            p.code.push(U8{0x01})
        }
        patch_store_slot(p, f.dst[at], 0)
        return
    }
    patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_string_compare"}, false, -1)
    cc: patch_cc(op, false)
    p.code.push(U8{0x48})
    p.code.push(U8{0x83})
    p.code.push(U8{0xf8})
    p.code.push(U8{0x00})
    p.code.push(U8{0x0f})
    p.code.push(U8{0x90 + cc})
    p.code.push(U8{0xc0})
    p.code.push(U8{0x0f})
    p.code.push(U8{0xb6})
    p.code.push(U8{0xc0})
    patch_store_slot(p, f.dst[at], 0)
    p.fused_slot = f.dst[at]
    p.fused_cc = cc
}

patch_neg: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    sa: f.a[at]
    dst: f.dst[at]
    ty: m.types[f.slot_type[sa]]
    if ty.kind == .Int {
        sites := [Int]{}
        patch_load_slot(p, 1, sa)
        if !p.is_const[sa] {
            t1: patch_emit(p.code, PATCH_TEST_INLINE_RCX)
            sites.push(t1 + 8)
        }
        p.code.push(U8{0x31})
        p.code.push(U8{0xc0})
        p.code.push(U8{0x48})
        p.code.push(U8{0x29})
        p.code.push(U8{0xc8})
        tr: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
        sites.push(tr + 8)
        patch_store_slot(p, dst, 0)
        cold := patch_cold_new(IRX64ColdKind.Route, sites)
        cold.resume = p.code.len()
        cold.symbol = "jet_int_sub"
        cold.left = -1
        cold.right = sa
        cold.dst = dst
        cold.at = at
        p.colds.push(cold)
        return
    }
    if ty.kind == .Float || ty.kind == .Float32 {
        patch_load_slot(p, 0, sa)
        patch_mov_ri(p, 1, if ty.kind == .Float32 -> 2147483648 else -> IR_X64_INT_MIN)
        p.code.push(U8{0x48})
        p.code.push(U8{0x31})
        p.code.push(U8{0xc8})
        patch_store_slot(p, dst, 0)
        return
    }
    patch_load_slot(p, 0, sa)
    bits: if ty.bits > 0 -> ty.bits else -> 64
    trap: f.c[at] != IR_OVERFLOW_WRAP
    if trap && !ty.signed {
        p.code.push(U8{0x48})
        p.code.push(U8{0x85})
        p.code.push(U8{0xc0})
        patch_stop_if(p, f, at, 5, 1)
    }
    p.code.push(U8{0x48})
    p.code.push(U8{0xf7})
    p.code.push(U8{0xd8})
    if trap && ty.signed {
        if bits == 64 -> patch_stop_if(p, f, at, 0, 1) else {
            patch_range_check(p, f, at, true, bits, 1)
        }
    }
    patch_narrow(p, 0, ty.signed, bits)
    patch_store_slot(p, dst, 0)
}

patch_not: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int, prev_fused_slot: Int, prev_fused_cc: Int) Never! {
    sa: f.a[at]
    dst: f.dst[at]
    ty: m.types[f.slot_type[sa]]
    if ty.kind == .Bool && prev_fused_slot == sa && sa >= 0 {
        inv: if prev_fused_cc % 2 == 0 -> prev_fused_cc + 1 else -> prev_fused_cc - 1
        if patch_fusable(f, p, at) {
            p.fused_slot = dst
            p.fused_cc = inv
            return
        }
        p.code.push(U8{0x0f})
        p.code.push(U8{0x90 + inv})
        p.code.push(U8{0xc0})
        p.code.push(U8{0x0f})
        p.code.push(U8{0xb6})
        p.code.push(U8{0xc0})
        patch_store_slot(p, dst, 0)
        return
    }
    patch_load_slot(p, 0, sa)
    if ty.kind == .Bool {
        p.code.push(U8{0x48})
        p.code.push(U8{0x83})
        p.code.push(U8{0xf0})
        p.code.push(U8{0x01})
        patch_store_slot(p, dst, 0)
        return
    }
    if ty.kind == .Word {
        p.code.push(U8{0x48})
        p.code.push(U8{0x83})
        p.code.push(U8{0xf0})
        p.code.push(U8{0xff})
        if !ty.signed -> patch_narrow(p, 0, false, if ty.bits > 0 -> ty.bits else -> 64)
        patch_store_slot(p, dst, 0)
        return
    }
    sites := [Int]{}
    if !p.is_const[sa] {
        t1: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
        sites.push(t1 + 8)
    }
    p.code.push(U8{0x48})
    p.code.push(U8{0x83})
    p.code.push(U8{0xf0})
    p.code.push(U8{0xff})
    patch_store_slot(p, dst, 0)
    if sites.is_empty() {
        return
    }
    cold := patch_cold_new(IRX64ColdKind.Route, sites)
    cold.resume = p.code.len()
    cold.symbol = "jet_int_bit_xor"
    cold.left = sa
    cold.right = -1
    cold.right_imm = -1
    cold.dst = dst
    cold.at = at
    p.colds.push(cold)
}

patch_sqrt: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    single: m.types[f.slot_type[f.a[at]]].kind == .Float32
    patch_load_xmm(p, single, 0, p.homes[f.a[at]])
    p.code.push(U8{if single -> 0xf3 else -> 0xf2})
    p.code.push(U8{0x0f})
    p.code.push(U8{0x51})
    p.code.push(U8{0xc0})
    patch_store_xmm(p, single, p.homes[f.dst[at]], 0)
}

patch_int_big: fn(p: &IRPatchEmitter, f: IRFunction, at: Int) Never! {
    bits: f.b[at]
    patch_load_slot(p, 0, f.a[at])
    p.code.push(U8{0x48})
    p.code.push(U8{0x89})
    p.code.push(U8{0xc2})
    cc := 5
    if bits == IR_INT_INLINE_BITS {
        p.code.push(U8{0x48})
        p.code.push(U8{0x01})
        p.code.push(U8{0xd2})
        cc = 0
    } else {
        sh: 64 - bits
        p.code.push(U8{0x48})
        p.code.push(U8{0xc1})
        p.code.push(U8{0xe2})
        p.code.push(U8{sh})
        p.code.push(U8{0x48})
        p.code.push(U8{0xc1})
        p.code.push(U8{0xfa})
        p.code.push(U8{sh})
        p.code.push(U8{0x48})
        p.code.push(U8{0x39})
        p.code.push(U8{0xc2})
    }
    p.code.push(U8{0x0f})
    p.code.push(U8{0x90 + cc})
    p.code.push(U8{0xc0})
    p.code.push(U8{0x0f})
    p.code.push(U8{0xb6})
    p.code.push(U8{0xc0})
    patch_store_slot(p, f.dst[at], 0)
    p.fused_slot = f.dst[at]
    p.fused_cc = cc
}

patch_convert: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    from: m.types[f.slot_type[f.a[at]]]
    to: m.types[f.slot_type[f.dst[at]]]
    ha: p.homes[f.a[at]]
    hd: p.homes[f.dst[at]]
    f_from: from.kind == .Float || from.kind == .Float32
    f_to: to.kind == .Float || to.kind == .Float32
    if f_from && to.kind == .Word {
        patch_load_xmm(p, from.kind == .Float32, 0, ha)
        p.code.push(U8{if from.kind == .Float32 -> 0xf3 else -> 0xf2})
        p.code.push(U8{0x48})
        p.code.push(U8{0x0f})
        p.code.push(U8{0x2c})
        p.code.push(U8{0xc0})
        patch_normalize(p, to, 0)
        patch_store_slot(p, f.dst[at], 0)
        return
    }
    if from.kind == .Word && f_to {
        patch_load_slot(p, 0, f.a[at])
        p.code.push(U8{if to.kind == .Float32 -> 0xf3 else -> 0xf2})
        p.code.push(U8{0x48})
        p.code.push(U8{0x0f})
        p.code.push(U8{0x2a})
        p.code.push(U8{0xc0})
        patch_store_xmm(p, to.kind == .Float32, hd, 0)
        return
    }
    if f_from && f_to {
        patch_load_xmm(p, from.kind == .Float32, 0, ha)
        if from.kind == .Float32 && to.kind == .Float {
            p.code.push(U8{0xf3})
            p.code.push(U8{0x0f})
            p.code.push(U8{0x5a})
            p.code.push(U8{0xc0})
        } else if from.kind == .Float && to.kind == .Float32 {
            p.code.push(U8{0xf2})
            p.code.push(U8{0x0f})
            p.code.push(U8{0x5a})
            p.code.push(U8{0xc0})
        }
        patch_store_xmm(p, to.kind == .Float32, hd, 0)
    }
}

patch_transfer: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    src: f.a[at]
    dst: f.dst[at]
    ty: m.types[f.slot_type[src]]
    if f.op[at] == .Copy && ty.drop != "" && ty.kind != .Aggregate && !ir_clone_shares(ty.clone) {
        if ty.kind == .Int || ty.clone == "jet_rt_int_clone" {
            if p.is_const[src] {
                patch_load_slot(p, 0, src)
                patch_store_slot(p, dst, 0)
                return
            }
            if !p.in_stop_edge && p.frames[src] == 0 && patch_fits_i8(p.homes[src]) && patch_fits_i8(p.homes[dst]) && p.homes[src] != 0 && p.homes[dst] != 0 {
                b: patch_emit(p.code, PATCH_INT_CLONE_8)
                p.code[b + 3] = U8{p.homes[src] & 255}
                patch_reloc_rt(p, b + 16, "jet_rt_int_clone")
                p.code[b + 23] = U8{p.homes[dst] & 255}
                return
            }
            if p.in_stop_edge {
                patch_load_slot(p, 7, src)
                patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_int_clone"}, false, -1)
                patch_store_slot(p, dst, 0)
                return
            }
            b: patch_emit(p.code, PATCH_INT_CLONE)
            patch_i32(p.code, b + 3, p.homes[src])
            patch_reloc_rt(p, b + 19, "jet_rt_int_clone")
            patch_i32(p.code, b + 26, p.homes[dst])
            return
        }
        if ty.kind == .String {
            if p.in_stop_edge {
                patch_load_slot(p, 7, src)
                patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_string_clone"}, false, -1)
                patch_store_slot(p, dst, 0)
                return
            }
            patch_load_slot(p, 0, src)
            hb: patch_emit(p.code, PATCH_STR_CLONE_HEAD)
            patch_store_slot(p, dst, 0)
            ib: patch_emit(p.code, if m.single_thread -> PATCH_STR_INC_ST else -> PATCH_STR_INC_MT)
            cold := patch_cold_new(IRX64ColdKind.Route, [Int]{hb + 9, hb + 22})
            cold.resume = p.code.len()
            cold.symbol = "jet_rt_string_clone"
            cold.left = src
            cold.dst = dst
            cold.at = at
            p.colds.push(cold)
            ovf := patch_cold_new(IRX64ColdKind.Route, [Int]{ib + (if m.single_thread -> 6 else -> 7)})
            ovf.resume = p.code.len()
            ovf.symbol = "jet_rt_panic_overflow"
            ovf.at = at
            p.colds.push(ovf)
            return
        }
        p.errors.push("{f.name}: Copy of {ir_kind_name(ty.kind)} with drop {ty.drop} has no clone route")
        return
    }
    if src == dst || ty.kind == .Unit {
        return
    }
    if !p.is_const[src] && p.frames[src] == 0 && patch_fits_i8(p.homes[src]) && patch_fits_i8(p.homes[dst]) && p.homes[src] != 0 && p.homes[dst] != 0 {
        b: patch_emit(p.code, PATCH_COPY_SLOT_8)
        p.code[b + 3] = U8{p.homes[src] & 255}
        p.code[b + 7] = U8{p.homes[dst] & 255}
        return
    }
    patch_load_slot(p, 0, src)
    patch_store_slot(p, dst, 0)
}

patch_drop: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    slot: f.a[at]
    if f.op[at] == .Close {
        patch_call(p, m, f, X64RelocTarget.Runtime{symbol: m.names[f.b[at]]}, -1, [Int]{slot}, 0, 1, -1, -1)
        return
    }
    patch_drop_slot(p, m, f, slot, at)
}

patch_drop_slot: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, slot: Int, at: Int) Never! {
    ty: m.types[f.slot_type[slot]]
    drop: ty.drop
    if drop == "" {
        return
    }
    // Inside out-of-line stop edges (which only run on panic/cancel), emit a
    // compact 9-byte direct call instead of 50-byte inline refcount + cold stub!
    if p.in_stop_edge {
        if (ty.kind == .Int || drop == "jet_rt_int_drop") && p.is_const[slot] {
            return
        }
        patch_load_slot(p, 7, slot)
        if name_rows_value(m.function_rows, drop) == .Val(id) {
            patch_call_out(p, f, X64RelocTarget.Function{id: X64FunctionID{value: id}}, false, -1)
        } else { patch_call_out(p, f, X64RelocTarget.Runtime{symbol: drop}, false, -1) }
        return
    }
    if ty.kind == .Int || drop == "jet_rt_int_drop" {
        if p.is_const[slot] {
            return
        }
        if p.frames[slot] == 0 && patch_fits_i8(p.homes[slot]) && p.homes[slot] != 0 {
            b: patch_emit(p.code, PATCH_INT_DROP_8)
            p.code[b + 3] = U8{p.homes[slot] & 255}
            patch_reloc_rt(p, b + 13, drop)
            return
        }
        b: patch_emit(p.code, PATCH_INT_DROP)
        patch_i32(p.code, b + 3, p.homes[slot])
        patch_reloc_rt(p, b + 16, drop)
        return
    }
    if ty.kind == .String && drop == "jet_rt_string_drop" {
        patch_load_slot(p, 0, slot)
        b: patch_emit(p.code, if m.single_thread -> PATCH_STR_DROP_BODY_ST else -> PATCH_STR_DROP_BODY_MT)
        cold := patch_cold_new(IRX64ColdKind.Route, [Int]{b + 24, b + (if m.single_thread -> 39 else -> 41)})
        cold.resume = p.code.len()
        cold.symbol = "jet_rt_string_drop"
        cold.left = slot
        cold.at = at
        p.colds.push(cold)
        return
    }
    if name_rows_value(m.function_rows, drop) == .Val(id) {
        patch_call(p, m, f, X64RelocTarget.Function{id: X64FunctionID{value: id}}, -1, [Int]{slot}, 0, 1, -1, -1)
        return
    }
    patch_call(p, m, f, X64RelocTarget.Runtime{symbol: drop}, -1, [Int]{slot}, 0, 1, -1, -1)
}

patch_call_runtime: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    symbol: m.names[f.a[at]]
    dst: f.dst[at]
    leaf: f.c[at] == 1 && dst >= 0
    alloc_row: ir_x64_alloc_type(m, f, dst, symbol)
    atomic: ir_x64_inline_atomic(m, f, at)
    if atomic != "" {
        start: f.b[at]
        place: f.args[start]
        base := 10
        disp := 0
        if p.frames[place] != 0 {
            base = 5
            disp = p.frames[place]
        } else { patch_load_slot(p, 10, place) }
        if atomic == "init" {
            patch_load_slot(p, 0, f.args[start + 1])
            p.code.push(U8{if base == 10 -> 0x49 else -> 0x48})
            p.code.push(U8{0x89})
            patch_mem_modrm(p.code, 0, base, disp)
        } else if atomic == "load" {
            p.code.push(U8{if base == 10 -> 0x49 else -> 0x48})
            p.code.push(U8{0x8b})
            patch_mem_modrm(p.code, 0, base, disp)
            patch_store_slot(p, dst, 0)
        } else if atomic == "store" {
            patch_load_slot(p, 0, f.args[start + 1])
            p.code.push(U8{if base == 10 -> 0x49 else -> 0x48})
            p.code.push(U8{0x87})
            patch_mem_modrm(p.code, 0, base, disp)
        } else if atomic == "add" {
            patch_load_slot(p, 0, f.args[start + 1])
            p.code.push(U8{0xf0})
            p.code.push(U8{if base == 10 -> 0x49 else -> 0x48})
            p.code.push(U8{0x0f})
            p.code.push(U8{0xc1})
            patch_mem_modrm(p.code, 0, base, disp)
            if dst >= 0 -> patch_store_slot(p, dst, 0)
        } else {
            patch_load_slot(p, 0, f.args[start + 1])
            patch_load_slot(p, 1, f.args[start + 2])
            p.code.push(U8{0xf0})
            p.code.push(U8{if base == 10 -> 0x49 else -> 0x48})
            p.code.push(U8{0x0f})
            p.code.push(U8{0xb1})
            patch_mem_modrm(p.code, 1, base, disp)
            if dst >= 0 {
                p.code.push(U8{0x0f})
                p.code.push(U8{0x94})
                p.code.push(U8{0xc0})
                p.code.push(U8{0x0f})
                p.code.push(U8{0xb6})
                p.code.push(U8{0xc0})
                patch_store_slot(p, dst, 0)
                p.fused_slot = dst
                p.fused_cc = 4
            }
        }
        return
    }
    if leaf && symbol == "jet_rt_block_unique" {
        patch_load_slot(p, 0, f.args[f.b[at]])
        _ := patch_emit(p.code, PATCH_BLOCK_UNIQUE_BODY)
        patch_store_slot(p, dst, 0)
        p.fused_slot = dst
        p.fused_cc = 4
        return
    }
    if f.c[at] == 1 && dst < 0 && symbol == "jet_rt_block_retain" {
        patch_load_slot(p, 0, f.args[f.b[at]])
        b: patch_emit(p.code, if m.single_thread -> PATCH_BLOCK_RETAIN_BODY_ST else -> PATCH_BLOCK_RETAIN_BODY_MT)
        ovf := patch_cold_new(IRX64ColdKind.Route, [Int]{b + (if m.single_thread -> 15 else -> 16)})
        ovf.resume = p.code.len()
        ovf.symbol = "jet_rt_panic_overflow"
        ovf.at = at
        p.colds.push(ovf)
        return
    }
    if leaf && symbol == "jet_rt_block_release" {
        block: f.args[f.b[at]]
        patch_load_slot(p, 0, block)
        p.code.push(U8{0x48})
        p.code.push(U8{0x8b})
        p.code.push(U8{0x48})
        p.code.push(U8{0xe8})
        p.code.push(U8{0x48})
        p.code.push(U8{0x83})
        p.code.push(U8{0xf9})
        p.code.push(U8{0x01})
        last: patch_jcc(p, 4)
        p.code.push(U8{0x48})
        p.code.push(U8{0x85})
        p.code.push(U8{0xc9})
        immortal: patch_jcc(p, 8)
        p.code.push(U8{0x48})
        p.code.push(U8{0xc1})
        p.code.push(U8{0xe9})
        p.code.push(U8{62})
        marked: patch_jcc(p, 5)
        if !m.single_thread -> p.code.push(U8{0xf0})
        p.code.push(U8{0x48})
        p.code.push(U8{0xff})
        p.code.push(U8{0x48})
        p.code.push(U8{0xe8})
        shared: patch_jcc(p, 5)
        patch_rel32(p.code, last, p.code.len())
        flag: patch_load_rip(p, 1)
        patch_reloc_rt_data(p, flag, IR_X64_PROCESS_ENDING_SYMBOL)
        p.code.push(U8{0x48})
        p.code.push(U8{0x85})
        p.code.push(U8{0xc9})
        done_at: p.code.len()
        patch_rel32(p.code, immortal, done_at)
        patch_rel32(p.code, shared, done_at)
        p.code.push(U8{0x0f})
        p.code.push(U8{0x94})
        p.code.push(U8{0xc0})
        p.code.push(U8{0x0f})
        p.code.push(U8{0xb6})
        p.code.push(U8{0xc0})
        patch_store_slot(p, dst, 0)
        cold := patch_cold_new(IRX64ColdKind.Release, [Int]{marked})
        cold.resume = p.code.len()
        cold.left = block
        cold.dst = dst
        cold.at = at
        p.colds.push(cold)
        return
    }
    if leaf && (symbol == "jet_int_owned_to_i64" || symbol == "jet_rt_int_clone") {
        val: f.args[f.b[at]]
        p.routed_at = at
        if p.is_const[val] {
            patch_load_slot(p, 0, val)
            patch_store_slot(p, dst, 0)
            return
        }
        patch_load_slot(p, 0, val)
        t1: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
        patch_store_slot(p, dst, 0)
        cold := patch_cold_new(IRX64ColdKind.Route, [Int]{t1 + 8})
        cold.resume = p.code.len()
        cold.symbol = symbol
        cold.left = val
        cold.dst = dst
        cold.at = at
        p.colds.push(cold)
        return
    }
    if leaf && (symbol == "jet_int_owned_from_i64" || (symbol == "jet_std_math_to_bits" && m.types[f.slot_type[f.args[f.b[at]]]].kind == .Float && patch_slot_class(m, f, dst) == .General)) {
        val: f.args[f.b[at]]
        p.routed_at = at
        patch_load_slot(p, 0, val)
        t1: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
        patch_store_slot(p, dst, 0)
        cold := patch_cold_new(IRX64ColdKind.Route, [Int]{t1 + 8})
        cold.resume = p.code.len()
        cold.symbol = "jet_int_owned_from_i64"
        cold.left = val
        cold.dst = dst
        cold.at = at
        p.colds.push(cold)
        return
    }
    if leaf && symbol == "jet_std_math_from_bits" && m.types[f.slot_type[dst]].kind == .Float && patch_slot_class(m, f, f.args[f.b[at]]) == .General {
        val: f.args[f.b[at]]
        p.routed_at = at
        patch_load_slot(p, 0, val)
        if p.is_const[val] {
            patch_store_slot(p, dst, 0)
            return
        }
        t1: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
        patch_store_slot(p, dst, 0)
        cold := patch_cold_new(IRX64ColdKind.Call, [Int]{t1 + 8})
        cold.resume = p.code.len()
        cold.symbol = symbol
        cold.left = at
        cold.at = at
        p.colds.push(cold)
        return
    }
    if (symbol == "jet_int_checked_fixed" || symbol == "jet_int_native_i64_at") && dst >= 0 && patch_slot_class(m, f, dst) == .General {
        native: symbol == "jet_int_native_i64_at"
        if f.c[at] == (if native -> 4 else -> 5) {
            val: f.args[f.b[at]]
            kind_slot: if native -> -1 else -> f.args[f.b[at] + 1]
            if patch_slot_class(m, f, val) == .General && (native || (kind_slot >= 0 && p.is_const[kind_slot])) {
                kind: if native -> 3 else -> p.const_val[kind_slot]
                if kind >= 0 && kind <= 7 {
                    p.routed_at = at
                    sites := [Int]{}
                    patch_load_slot(p, 0, val)
                    if !p.is_const[val] {
                        t1: patch_emit(p.code, PATCH_TEST_INLINE_RAX)
                        sites.push(t1 + 8)
                    }
                    if kind == 0 || kind == 1 || kind == 2 || kind == 6 {
                        p.code.push(U8{0x48})
                        p.code.push(U8{0x89})
                        p.code.push(U8{0xc2})
                        patch_narrow(p, 2, kind != 6, if kind == 6 -> 32 else -> 8 << kind)
                        p.code.push(U8{0x48})
                        p.code.push(U8{0x39})
                        p.code.push(U8{0xc2})
                        sites.push(patch_jcc(p, 5))
                    } else if kind == 4 || kind == 5 {
                        patch_alu_rax_imm(p, 7, if kind == 4 -> 255 else -> 65535)
                        sites.push(patch_jcc(p, 7))
                    } else if kind == 7 {
                        p.code.push(U8{0x48})
                        p.code.push(U8{0x85})
                        p.code.push(U8{0xc0})
                        sites.push(patch_jcc(p, 8))
                    }
                    patch_store_slot(p, dst, 0)
                    if sites.is_empty() {
                        return
                    }
                    cold := patch_cold_new(IRX64ColdKind.Call, sites)
                    cold.resume = p.code.len()
                    cold.symbol = symbol
                    cold.left = at
                    cold.at = at
                    p.colds.push(cold)
                    return
                }
            }
        }
    }
    if symbol == "jet_int_checked_widen" && f.c[at] == 4 && dst >= 0 && m.types[f.slot_type[dst]].kind == .Float {
        val: f.args[f.b[at]]
        single_slot: f.args[f.b[at] + 1]
        if patch_slot_class(m, f, val) == .General && single_slot >= 0 && p.is_const[single_slot] {
            p.routed_at = at
            patch_load_slot(p, 0, val)
            p.code.push(U8{0x48})
            p.code.push(U8{0x89})
            p.code.push(U8{0xc2})
            p.code.push(U8{0x48})
            p.code.push(U8{0xc1})
            p.code.push(U8{0xfa})
            p.code.push(U8{if p.const_val[single_slot] != 0 -> 24 else -> 53})
            p.code.push(U8{0x48})
            p.code.push(U8{0x83})
            p.code.push(U8{0xc2})
            p.code.push(U8{0x01})
            p.code.push(U8{0x48})
            p.code.push(U8{0x83})
            p.code.push(U8{0xfa})
            p.code.push(U8{0x01})
            s_out: patch_jcc(p, 7)
            // cvtsi2sd xmm0, rax
            p.code.push(U8{0xf2})
            p.code.push(U8{0x48})
            p.code.push(U8{0x0f})
            p.code.push(U8{0x2a})
            p.code.push(U8{0xc0})
            patch_store_xmm(p, false, p.homes[dst], 0)
            cold := patch_cold_new(IRX64ColdKind.Call, [Int]{s_out})
            cold.resume = p.code.len()
            cold.symbol = symbol
            cold.left = at
            cold.at = at
            p.colds.push(cold)
            return
        }
    }
    if symbol == "jet_perf_zone_open_named" || symbol == "jet_perf_zone_close" || (!m.zones_stripped && (symbol == "jet_perf_frame" || symbol == "jet_perf_plot_float")) {
        if p.in_stub {
            patch_call(p, m, f, X64RelocTarget.Runtime{symbol: symbol}, -1, f.args, f.b[at], f.c[at], dst, alloc_row)
            return
        }
        if dst >= 0 {
            hd: p.homes[dst]
            if patch_fits_i8(hd) {
                b: patch_emit(p.code, PATCH_CONST_I32_8)
                p.code[b + 3] = U8{hd & 255}
            } else {
                b: patch_emit(p.code, PATCH_CONST_I32)
                patch_i32(p.code, b + 3, hd)
            }
        }
        if m.zones_stripped {
            return
        }
        if m.zone_table {
            site: patch_jmp(p)
            p.zone_sites.push(site)
            p.zone_stubs.push(IRPatchZoneStub{at: at, site: site, resume: p.code.len(), symbol: symbol, dst: dst})
            return
        }
        p.code.push(U8{0x41})
        p.code.push(U8{0x53})
        flag: patch_load_rip(p, 11)
        patch_reloc_rt_data(p, flag, IR_X64_PERF_ZONES_SYMBOL)
        p.code.push(U8{0x4d})
        p.code.push(U8{0x85})
        p.code.push(U8{0xdb})
        p.code.push(U8{0x41})
        p.code.push(U8{0x5b})
        skip: patch_jcc(p, 4)
        patch_call(p, m, f, X64RelocTarget.Runtime{symbol: symbol}, -1, f.args, f.b[at], f.c[at], dst, alloc_row)
        patch_rel32(p.code, skip, p.code.len())
        return
    }
    // Align-8 fast entries using folded Const info!
    if (symbol == "jet_rt_alloc" || symbol == "jet_rt_alloc_value") && f.c[at] == 2 {
        al_slot: f.args[f.b[at] + 1]
        if p.is_const[al_slot] && p.const_val[al_slot] == 8 {
            patch_call(p, m, f, X64RelocTarget.Runtime{symbol: "{symbol}_8"}, -1, f.args, f.b[at], 1, dst, alloc_row)
            return
        }
    }
    if symbol == "jet_rt_free" && f.c[at] == 3 {
        al_slot: f.args[f.b[at] + 2]
        if p.is_const[al_slot] && p.const_val[al_slot] == 8 {
            patch_call(p, m, f, X64RelocTarget.Runtime{symbol: "jet_rt_free_8"}, -1, f.args, f.b[at], 2, dst, alloc_row)
            return
        }
    }
    patch_call(p, m, f, X64RelocTarget.Runtime{symbol: symbol}, -1, f.args, f.b[at], f.c[at], dst, alloc_row)
}

// ---------------------------------------------------------------------------
// Structured control helpers.

patch_ctrl_open: fn(p: &IRPatchEmitter, at: Int, head: Int, false_site: Int) Never! {
    p.ctrl_open.push(at)
    p.ctrl_head.push(head)
    p.ctrl_false.push(false_site)
    p.ctrl_end_head.push(-1)
    p.ctrl_end_tail.push(-1)
}

patch_ctrl_push_end: fn(p: &IRPatchEmitter, row: Int, site: Int) Never! {
    idx: p.end_sites.len()
    p.end_sites.push(site)
    p.end_next.push(-1)
    tail: p.ctrl_end_tail[row]
    if tail < 0 -> p.ctrl_end_head[row] = idx else -> p.end_next[tail] = idx
    p.ctrl_end_tail[row] = idx
}

patch_ctrl_branch: fn(p: &IRPatchEmitter, f: IRFunction, at: Int, depth: Int, conditional: Bool, cond_slot: Int) Never! {
    row: p.ctrl_open.len() - 1 - depth
    if row < 0 {
        p.errors.push("{f.name}: branch depth {depth} leaves the function")
        return
    }
    site := -1
    if conditional {
        if p.fused_slot == cond_slot && cond_slot >= 0 {
            cc: p.fused_cc
            p.fused_slot = -1
            site = patch_jcc(p, cc)
        } else if p.is_const[cond_slot] {
            if p.const_val[cond_slot] == 0 {
                return
            }
            site = patch_jmp(p)
        } else {
            hc: p.homes[cond_slot]
            if patch_fits_i8(hc) {
                b: patch_emit(p.code, PATCH_BRIF_TRUTH_8)
                p.code[b + 3] = U8{hc & 255}
                site = b + 7
            } else {
                b: patch_emit(p.code, PATCH_BRIF_TRUTH)
                patch_i32(p.code, b + 3, hc)
                site = b + 10
            }
        }
    } else { site = patch_jmp(p) }
    if p.ctrl_head[row] >= 0 {
        patch_rel32(p.code, site, p.ctrl_head[row])
        return
    }
    if p.end_of[p.ctrl_open[row]] >= 0 {
        patch_rel32(p.code, site, p.end_of[p.ctrl_open[row]])
        return
    }
    patch_ctrl_push_end(p, row, site)
}

patch_ctrl_end: fn(p: &IRPatchEmitter, f: IRFunction, at: Int) Never! {
    if p.ctrl_open.len() == 0 {
        p.errors.push("{f.name}: End without an open construct")
        return
    }
    here: p.code.len()
    row: p.ctrl_open.len() - 1
    p.end_of[p.ctrl_open[row]] = here
    if p.ctrl_false[row] >= 0 -> patch_rel32(p.code, p.ctrl_false[row], here)
    idx := p.ctrl_end_head[row]
    loop idx >= 0 {
        patch_rel32(p.code, p.end_sites[idx], here)
        idx = p.end_next[idx]
    }
    _ := p.ctrl_open.pop()
    _ := p.ctrl_head.pop()
    _ := p.ctrl_false.pop()
    _ := p.ctrl_end_head.pop()
    _ := p.ctrl_end_tail.pop()
}

// ---------------------------------------------------------------------------
// Single-instruction dispatch.

patch_emit_op: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int) Never! {
    op: f.op[at]
    dst: f.dst[at]
    prev_fused_slot: p.fused_slot
    prev_fused_cc: p.fused_cc
    p.fused_slot = -1
    p.fused_cc = -1
    // Folded single-write Temp Const or StackAddress/Offset emits 0 bytes!
    if dst >= 0 && (p.is_const[dst] || p.frames[dst] != 0) {
        return
    }
    if op == {
        .Nop -> {}
        .Const -> {
            if dst < 0 || p.homes[dst] == 0 {
                return
            }
            val: f.a[at]
            hd: p.homes[dst]
            if x64_fits_i32(val) {
                if patch_fits_i8(hd) {
                    b: patch_emit(p.code, PATCH_CONST_I32_8)
                    p.code[b + 3] = U8{hd & 255}
                    patch_i32(p.code, b + 4, val)
                } else {
                    b: patch_emit(p.code, PATCH_CONST_I32)
                    patch_i32(p.code, b + 3, hd)
                    patch_i32(p.code, b + 7, val)
                }
            } else {
                if patch_fits_i8(hd) {
                    b: patch_emit(p.code, PATCH_CONST_I64_8)
                    patch_i64(p.code, b + 2, val)
                    p.code[b + 13] = U8{hd & 255}
                } else {
                    b: patch_emit(p.code, PATCH_CONST_I64)
                    patch_i64(p.code, b + 2, val)
                    patch_i32(p.code, b + 13, hd)
                }
            }
        }
        .ConstText -> {
            data_row: f.a[at]
            if data_row < 0 || data_row >= m.data.len() {
                p.errors.push("{f.name}: data row {data_row} has no text header")
                return
            }
            hdr: patch_header_row(p, data_row)
            hd: p.homes[dst]
            if patch_fits_i8(hd) {
                b: patch_emit(p.code, PATCH_LEA_RIP_SLOT_8)
                patch_reloc_data(p, b + 3, hdr)
                p.code[b + 10] = U8{hd & 255}
            } else {
                b: patch_emit(p.code, PATCH_LEA_RIP_SLOT)
                patch_reloc_data(p, b + 3, hdr)
                patch_i32(p.code, b + 10, hd)
            }
        }
        .ConstBigInt -> {
            name_row: f.a[at]
            if name_row < 0 || name_row >= m.names.len() {
                p.errors.push("{f.name}: name {name_row} is not interned")
                return
            }
            rows: patch_bigint_rows(p, name_row, m.names[name_row])
            hd: p.homes[dst]
            if rows.static_id >= 0 {
                if patch_fits_i8(hd) {
                    b: patch_emit(p.code, PATCH_STATIC_INT_8)
                    patch_reloc_data(p, b + 3, rows.static_id)
                    p.code[b + 13] = U8{hd & 255}
                } else {
                    b: patch_emit(p.code, PATCH_STATIC_INT)
                    patch_reloc_data(p, b + 3, rows.static_id)
                    patch_i32(p.code, b + 13, hd)
                }
                return
            }
            site: patch_lea_rip(p, 7)
            patch_reloc_data(p, site, rows.text_id)
            text_len: patch_use_len(p, rows.text_id)
            patch_mov_ri(p, 6, text_len)
            patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_int_from_static"}, false, -1)
            patch_store_slot(p, dst, 0)
        }
        .Copy | .Move -> patch_transfer(p, m, f, at)
        .Drop | .Close -> patch_drop(p, m, f, at)
        .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge -> {
            ty: m.types[f.slot_type[f.a[at]]]
            if ty.kind == {
                .Int -> {
                    if ir_overflow_wraps(f.c[at]) {
                        patch_word_binary(p, m, f, at, IRType{ty: ty.ty, kind: .Word, class: .Integer, size: 8, align: 8, signed: true, bits: 64, drop: "", clone: ""}, true)
                    } else { patch_exact_binary(p, m, f, at) }
                }
                .Float | .Float32 -> { patch_float_binary(p, m, f, at, ty.kind == .Float32) }
                .String -> patch_string_binary(p, m, f, at)
                .Word | .Bool | .Char | .Pointer -> patch_word_binary(p, m, f, at, ty, false)
                .Unit | .Aggregate -> {
                    p.errors.push("{f.name}: no arithmetic on {ir_kind_name(ty.kind)}")
                }
            }
        }
        .Neg -> { patch_neg(p, m, f, at) }
        .Not -> { patch_not(p, m, f, at, prev_fused_slot, prev_fused_cc) }
        .Sqrt -> { patch_sqrt(p, m, f, at) }
        .IntBig -> { patch_int_big(p, f, at) }
        .Convert -> { patch_convert(p, m, f, at) }
        .Concat -> {
            patch_call(p, m, f, X64RelocTarget.Runtime{symbol: if f.c[at] == 1 -> "jet_rt_string_concat_value" else -> "jet_rt_string_concat"}, -1, [Int]{f.a[at], f.b[at]}, 0, 2, dst, -1)
        }
        .Call -> {
            if f.a[at] < 0 || f.a[at] >= m.functions.len() {
                p.errors.push("{f.name}: function {f.a[at]} is not in the module")
                return
            }
            if at + 1 < f.op.len() && f.op[at + 1] == .Return && f.b[at + 1] == IR_TAIL_JUMP {
                patch_tail_jump(p, m, f, at)
                return
            }
            if !p.in_stop_edge && f.c[at] == 1 && dst < 0 && m.functions[f.a[at]].key.starts_with("#unique<") {
                header: f.args[f.b[at]]
                if header >= 0 && patch_slot_class(m, f, header) == .General {
                    patch_load_slot(p, 0, header)
                    b: patch_emit(p.code, PATCH_UNIQUE_BODY)
                    shared := patch_cold_new(IRX64ColdKind.Unique, [Int]{b + 24})
                    shared.resume = p.code.len()
                    shared.left = at
                    shared.right = -1
                    shared.at = at
                    p.colds.push(shared)
                    rare := patch_cold_new(IRX64ColdKind.Unique, [Int]{b + 9})
                    rare.resume = p.code.len()
                    rare.left = at
                    rare.right = header
                    rare.at = at
                    p.colds.push(rare)
                    return
                }
            }
            if m.functions[f.a[at]].asm == .Val(leaf) && !ir_stop_key(m.functions[f.a[at]].key) {
                if ir_x64_asm_inlinable(m, f, leaf, f.args, f.b[at], f.c[at], dst) {
                    loop pos in 0..<f.c[at] {
                        patch_load_slot(p, leaf.regs[pos], f.args[f.b[at] + pos])
                    }
                    if p.has_stream {
                        p.code.push(U8{0x0f})
                        p.code.push(U8{0xae})
                        p.code.push(U8{0xf8})
                    }
                    p.code.extend(leaf.code[0..<leaf.code.len()])
                    if dst >= 0 {
                        if leaf.result > 0 {
                            p.code.push(U8{if leaf.result >= 8 -> 0x4c else -> 0x48})
                            p.code.push(U8{0x89})
                            p.code.push(U8{0xc0 | ((leaf.result & 7) << 3)})
                        }
                        patch_normalize(p, m.types[f.slot_type[dst]], 0)
                        patch_store_slot(p, dst, 0)
                    }
                    return
                }
            }
            patch_call(p, m, f, X64RelocTarget.Function{id: X64FunctionID{value: f.a[at]}}, -1, f.args, f.b[at], f.c[at], dst, -1)
        }
        .CallRuntime -> { patch_call_runtime(p, m, f, at) }
        .CallIndirect -> {
            patch_call(p, m, f, X64RelocTarget.Runtime{symbol: ""}, f.a[at], f.args, f.b[at], f.c[at], dst, -1)
        }
        .FunctionAddress -> {
            hd: p.homes[dst]
            if patch_fits_i8(hd) {
                b: patch_emit(p.code, PATCH_LEA_RIP_SLOT_8)
                patch_reloc_fn(p, b + 3, f.a[at])
                p.code[b + 10] = U8{hd & 255}
            } else {
                b: patch_emit(p.code, PATCH_LEA_RIP_SLOT)
                patch_reloc_fn(p, b + 3, f.a[at])
                patch_i32(p.code, b + 10, hd)
            }
        }
        .DataAddress -> {
            hd: p.homes[dst]
            b: if patch_fits_i8(hd) -> patch_emit(p.code, PATCH_LEA_RIP_SLOT_8) else -> patch_emit(p.code, PATCH_LEA_RIP_SLOT)
            if m.core_cells.get(f.a[at]) == .Val(symbol) -> patch_reloc_rt_data(p, b + 3, symbol) else {
                patch_reloc_data(p, b + 3, f.a[at])
            }
            if patch_fits_i8(hd) -> p.code[b + 10] = U8{hd & 255} else {
                patch_i32(p.code, b + 10, hd)
            }
        }
        .Load -> { patch_emit_load(p, m, f, at) }
        .Store -> { patch_emit_store(p, m, f, at, false) }
        .StreamStore -> { patch_emit_store(p, m, f, at, true) }
        .Offset -> {
            sa: f.a[at]
            off: f.b[at]
            if p.frames[sa] != 0 && x64_fits_i32(p.frames[sa] + off) {
                patch_lea_rbp(p, 0, p.frames[sa] + off)
                patch_store_slot(p, dst, 0)
                return
            }
            patch_load_slot(p, 0, sa)
            if off != 0 {
                if x64_fits_i32(off) {
                    p.code.push(U8{0x48})
                    p.code.push(U8{0x8d})
                    patch_mem_modrm(p.code, 0, 0, off)
                } else {
                    patch_mov_ri(p, 1, off)
                    p.code.push(U8{0x48})
                    p.code.push(U8{0x01})
                    p.code.push(U8{0xc8})
                }
            }
            patch_store_slot(p, dst, 0)
        }
        .CopyBytes -> {
            to_slot: f.a[at]
            from_slot: f.b[at]
            to_base := 0
            to_disp := 0
            from_base := 2
            from_disp := 0
            if p.frames[to_slot] != 0 {
                to_base = 5
                to_disp = p.frames[to_slot]
            } else { patch_load_slot(p, 0, to_slot) }
            if p.frames[from_slot] != 0 {
                from_base = 5
                from_disp = p.frames[from_slot]
            } else { patch_load_slot(p, 2, from_slot) }
            patch_copy_bytes_mem(p, from_base, from_disp, to_base, to_disp, f.c[at])
        }
        .StackAddress -> {
            if dst >= 0 && dst == p.result_storage {
                patch_load_rbp(p, 0, p.result_home)
                patch_store_slot(p, dst, 0)
                return
            }
            size: ir_x64_storage_size(f, at)
            align: if {
                f.b[at] > 16 -> 16
                f.b[at] < 1 -> 1
                else -> f.b[at]
            }
            p.depth = ir_x64_align(p.depth + size, align)
            storage: 0 - p.depth
            patch_lea_rbp(p, 0, storage)
            patch_store_slot(p, dst, 0)
        }
        .Block -> { patch_ctrl_open(p, at, -1, -1) }
        .Loop -> { patch_ctrl_open(p, at, p.code.len(), -1) }
        .If -> {
            false_site := -1
            if prev_fused_slot == f.a[at] && f.a[at] >= 0 {
                inv: if prev_fused_cc % 2 == 0 -> prev_fused_cc + 1 else -> prev_fused_cc - 1
                false_site = patch_jcc(p, inv)
            } else if p.is_const[f.a[at]] {
                if p.const_val[f.a[at]] == 0 -> false_site = patch_jmp(p)
            } else {
                ha: p.homes[f.a[at]]
                if patch_fits_i8(ha) {
                    b: patch_emit(p.code, PATCH_IF_TRUTH_8)
                    p.code[b + 3] = U8{ha & 255}
                    false_site = b + 7
                } else {
                    b: patch_emit(p.code, PATCH_IF_TRUTH)
                    patch_i32(p.code, b + 3, ha)
                    false_site = b + 10
                }
            }
            patch_ctrl_open(p, at, -1, false_site)
        }
        .Else -> {
            if p.ctrl_open.len() == 0 {
                p.errors.push("{f.name}: Else without an If")
                return
            }
            row: p.ctrl_open.len() - 1
            site: patch_jmp(p)
            patch_ctrl_push_end(p, row, site)
            if p.ctrl_false[row] >= 0 -> patch_rel32(p.code, p.ctrl_false[row], p.code.len())
            p.ctrl_false[row] = -1
        }
        .End -> { patch_ctrl_end(p, f, at) }
        .Br -> { patch_ctrl_branch(p, f, at, f.a[at], false, -1) }
        .BrIf -> {
            p.fused_slot = prev_fused_slot
            p.fused_cc = prev_fused_cc
            patch_ctrl_branch(p, f, at, f.b[at], true, f.a[at])
            p.fused_slot = -1
            p.fused_cc = -1
        }
        .Return -> {
            if f.b[at] == IR_TAIL_JUMP {
                return
            }
            slot: f.a[at]
            if slot >= 0 {
                if p.result_home != 0 {
                    if slot != p.result_storage {
                        if p.frames[slot] != 0 {
                            patch_load_rbp(p, 0, p.result_home)
                            patch_copy_bytes_mem(p, 5, p.frames[slot], 0, 0, m.types[f.result].size)
                        } else {
                            patch_load_slot(p, 2, slot)
                            patch_load_rbp(p, 0, p.result_home)
                            patch_copy_bytes_mem(p, 2, 0, 0, 0, m.types[f.result].size)
                        }
                    }
                    patch_load_rbp(p, 0, p.result_home)
                } else {
                    cls: patch_slot_class(m, f, slot)
                    if cls == .General -> patch_load_slot(p, 0, slot) else if cls == .Float {
                        patch_load_xmm(p, m.types[f.slot_type[slot]].kind == .Float32, 0, p.homes[slot])
                    }
                }
            }
            if p.in_stop_edge -> p.stop_returns.push(patch_jmp(p)) else if at < f.op.len() - 1 {
                p.returns.push(patch_jmp(p))
            }
        }
        .Unreachable -> {
            p.code.push(U8{0x0f})
            p.code.push(U8{0x0b})
        }
    }
}

// ---------------------------------------------------------------------------
// Out-of-line stop points & O(N) suffix-trie stop-edge sharing.

patch_stop_edge_is_bare_return: fn(p: &IRPatchEmitter, f: IRFunction, branch: Int, end_idx: Int) -> Bool Never! {
    if end_idx <= branch + 1 -> return false
    last: end_idx - 1
    if f.op[last] != .Return || f.a[last] >= 0 || f.b[last] == IR_TAIL_JUMP -> return false
    if end_idx == branch + 2 -> return true
    if !p.has_drop_kill -> return false
    loop k in (branch + 1)..<last {
        if f.op[k] == .Nop || p.drop_kill[k] -> next
        return false
    }
    true
}

patch_stop_edge_is_drop_chain: fn(f: IRFunction, branch: Int, end_idx: Int) -> Bool Never! {
    if end_idx <= branch + 1 -> return false
    if f.op[end_idx - 1] != .Return || f.a[end_idx - 1] >= 0 || f.b[end_idx - 1] == IR_TAIL_JUMP {
        return false
    }
    loop k in (branch + 1)..<(end_idx - 1) {
        op: f.op[k]
        if op != .Drop && op != .Nop -> return false
    }
    true
}

patch_in_loop: fn(p: &IRPatchEmitter, f: IRFunction) -> Bool Never! {
    loop opener in p.ctrl_open {
        if f.op[opener] == .Loop -> return true
    }
    false
}

patch_emit_armed_poll: fn(p: &IRPatchEmitter, at: Int, edge_id: Int, armed: Bool) Never! {
    sites := [Int]{}
    if armed {
        flag: patch_load_rip(p, 0)
        patch_reloc_rt_data(p, flag, IR_X64_CHECKS_ARMED_SYMBOL)
        p.code.push(U8{0x48})
        p.code.push(U8{0x85})
        p.code.push(U8{0xc0})
        sites.push(patch_jcc(p, 5))
    }
    cold := patch_cold_new(IRX64ColdKind.Poll, sites)
    cold.resume = p.code.len()
    cold.left = at
    cold.pad = edge_id
    cold.at = at
    p.colds.push(cold)
}

patch_emit_stop_quiet: fn(p: &IRPatchEmitter, bits: Int) -> [Int] Never! {
    _ := patch_emit(p.code, PATCH_STOP_QUIET_GS)
    quiet := [Int]{}
    enter := [Int]{}
    // test rax, rax; jz quiet
    p.code.push(U8{0x48})
    p.code.push(U8{0x85})
    p.code.push(U8{0xc0})
    quiet.push(patch_jcc(p, 4))
    // cmp qword gs:[448], 0; jnz enter
    _ := patch_emit(p.code, PATCH_STOP_QUIET_TURN)
    enter.push(patch_jcc(p, 5))
    // mov rax, [rax + 16]; test rax, rax; jz quiet
    p.code.push(U8{0x48})
    p.code.push(U8{0x8b})
    p.code.push(U8{0x40})
    p.code.push(U8{16})
    p.code.push(U8{0x48})
    p.code.push(U8{0x85})
    p.code.push(U8{0xc0})
    quiet.push(patch_jcc(p, 4))
    // test qword [rax + 24], bits; jnz enter
    p.code.push(U8{0x48})
    p.code.push(U8{0xf7})
    p.code.push(U8{0x40})
    p.code.push(U8{24})
    patch_push_i32(p.code, bits)
    enter.push(patch_jcc(p, 5))
    // mov rax, [rax + 32]; test rax, rax; jz quiet
    p.code.push(U8{0x48})
    p.code.push(U8{0x8b})
    p.code.push(U8{0x40})
    p.code.push(U8{32})
    p.code.push(U8{0x48})
    p.code.push(U8{0x85})
    p.code.push(U8{0xc0})
    quiet.push(patch_jcc(p, 4))
    here: p.code.len()
    loop site in enter -> patch_rel32(p.code, site, here)
    quiet
}

patch_stop_point: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, at: Int, poll: Int, trap: Int, turn: Int, traps: Int) -> Int Never! {
    if f.op[at] != .Call || f.a[at] < 0 || (f.a[at] != poll && f.a[at] != trap && f.a[at] != turn) {
        return -1
    }
    branch: at + 1
    stopped: f.dst[at]
    if stopped < 0 || branch >= f.op.len() || f.op[branch] != .If || f.a[branch] != stopped || f.b[branch] >= 0 || p.ends[stopped] != branch {
        return -1
    }
    end_idx: f.c[branch]
    bare_ret: patch_stop_edge_is_bare_return(p, f, branch, end_idx)
    if f.a[at] == trap {
        has_trap := false
        loop idx in traps..<p.colds.len() {
            k: p.colds[idx].kind
            ca: p.colds[idx].at
            cr: p.colds[idx].right
            if k == .Stop || k == .ShiftStop || (k == .LocatedRoute && patch_located_stops(p, f, ca, cr)) {
                has_trap = true
                break
            }
        }
        if !has_trap -> return end_idx
        if bare_ret -> return end_idx
        edge_id: p.stop_edges.len()
        loop idx in traps..<p.colds.len() {
            k: p.colds[idx].kind
            ca: p.colds[idx].at
            cr: p.colds[idx].right
            if k == .Stop || k == .ShiftStop || (k == .LocatedRoute && patch_located_stops(p, f, ca, cr)) {
                p.colds[idx].pad = edge_id
            }
        }
        p.end_of[branch] = p.code.len()
        simple_edge: patch_stop_edge_is_drop_chain(f, branch, end_idx) || patch_cleanup_edge(p, m, f, branch, end_idx).ok
        p.stop_edges.push(
            IRPatchStopEdge{
                branch: branch,
                end: end_idx,
                sites: [Int]{},
                resume: p.code.len(),
                open: if simple_edge -> [Int]{} else -> p.ctrl_open,
                heads: if simple_edge -> [Int]{} else -> p.ctrl_head,
                offset: -1,
            },
        )
        return end_idx
    }
    // poll or turn
    edge_id := -1
    if !bare_ret -> edge_id = p.stop_edges.len()
    hot_site := -1
    routed: at > 0 && p.routed_at == at - 1 && p.colds.len() - traps <= 1
    if at > 0 && ir_x64_call_reports(m, f, at - 1) {
        p.code.push(U8{0x85})
        p.code.push(U8{0xd2})
        hot_site = patch_jcc(p, 5)
        if f.a[at] == turn -> patch_emit_armed_poll(p, at, edge_id, true)
    } else if routed || (f.a[at] == turn && (at == 0 || f.op[at - 1] == .Loop)) || !ir_opt_polls_checks_call(m, f, poll, trap, turn, at) {
        falls: routed && p.colds.len() > traps
        if falls -> p.colds[traps].falls = true
        patch_emit_armed_poll(p, at, edge_id, !falls || f.a[at] == turn)
    } else {
        skips := [Int]{}
        if patch_in_loop(p, f) || f.stack_check {
            skips = patch_emit_stop_quiet(p, ir_stop_attention(m.functions[f.a[at]].key))
        }
        patch_call_out(p, f, X64RelocTarget.Function{id: X64FunctionID{value: f.a[at]}}, false, -1)
        p.code.push(U8{0x48})
        p.code.push(U8{0x85})
        p.code.push(U8{0xc0})
        hot_site = patch_jcc(p, 5)
        quiet: p.code.len()
        loop skip in skips -> patch_rel32(p.code, skip, quiet)
    }
    p.end_of[branch] = p.code.len()
    if bare_ret {
        if hot_site >= 0 -> p.stop_returns.push(hot_site)
        return end_idx
    }
    sites: if hot_site >= 0 -> [Int]{hot_site} else -> [Int]{}
    simple_edge: patch_stop_edge_is_drop_chain(f, branch, end_idx) || patch_cleanup_edge(p, m, f, branch, end_idx).ok
    p.stop_edges.push(
        IRPatchStopEdge{
            branch: branch,
            end: end_idx,
            sites: sites,
            resume: p.code.len(),
            open: if simple_edge -> [Int]{} else -> p.ctrl_open,
            heads: if simple_edge -> [Int]{} else -> p.ctrl_head,
            offset: -1,
        },
    )
    end_idx
}

patch_cleanup_edge: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, branch: Int, end_idx: Int) -> {ok: Bool, first: Int, leave: Int, token: Int} Never! {
    none: {ok: false, first: -1, leave: -1, token: -1}
    last: end_idx - 1
    if last <= branch + 2 -> return none
    if f.op[last] != .Return || f.a[last] >= 0 || f.b[last] == IR_TAIL_JUMP -> return none
    first := branch + 1
    loop first < last && (f.op[first] == .Nop || (p.has_drop_kill && p.drop_kill[first])) {
        first += 1
    }
    leave := last - 1
    loop leave > first && (f.op[leave] == .Nop || (p.has_drop_kill && p.drop_kill[leave])) {
        leave -= 1
    }
    if leave <= first -> return none
    if f.op[first] != .CallRuntime || f.op[leave] != .CallRuntime -> return none
    if m.names[f.a[first]] != "jet_rt_cleanup_enter" || m.names[f.a[leave]] != "jet_rt_cleanup_leave" {
        return none
    }
    token: f.dst[first]
    if token < 0 || f.slot_kind[token] != .Temp || p.starts[token] != first || p.ends[token] != leave {
        return none
    }
    if f.c[leave] != 1 || f.args[f.b[leave]] != token -> return none
    depth := 0
    loop k in (first + 1)..<leave {
        op: f.op[k]
        if op == {
            .If -> depth += 1
            .End -> {
                depth -= 1
                if depth < 0 -> return none
            }
            .Else -> {
                if depth <= 0 -> return none
            }
            .Block | .Loop | .Br | .BrIf | .Return | .Unreachable -> return none
            .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Sqrt | .IntBig | .StreamStore -> {}
        }
    }
    if depth != 0 -> return none
    {ok: true, first: first, leave: leave, token: token}
}

patch_group_slot_eq: fn(p: &IRPatchEmitter, s1: Int, e1: Int, s2: Int, e2: Int, a: Int, b: Int) -> Bool Never! {
    if a == b -> return true
    if a < 0 || b < 0 -> return false
    // Two internal temps written at the same relative op inside their group with the same frame home.
    sa: p.starts[a]
    sb: p.starts[b]
    if sa >= s1 && sa < e1 && sb >= s2 && sb < e2 && (sa - s1) == (sb - s2) {
        if p.is_const[a] && p.is_const[b] && p.const_val[a] == p.const_val[b] -> return true
        if !p.is_const[a] && !p.is_const[b] && p.frames[a] == p.frames[b] && p.homes[a] == p.homes[b] {
            return true
        }
    }
    false
}

patch_group_eq: fn(p: &IRPatchEmitter, f: IRFunction, s1: Int, e1: Int, s2: Int, e2: Int) -> Bool Never! {
    len: e1 - s1
    if len != e2 - s2 -> return false
    if len == 1 && f.op[s1] == .Drop && f.op[s2] == .Drop -> return f.a[s1] == f.a[s2]
    loop d in 0..<len {
        k1: s1 + d
        k2: s2 + d
        op: f.op[k1]
        if op != f.op[k2] -> return false
        if op == {
            .Drop -> {
                if !patch_group_slot_eq(p, s1, e1, s2, e2, f.a[k1], f.a[k2]) -> return false
            }
            .Close -> {
                if f.b[k1] != f.b[k2] || !patch_group_slot_eq(p, s1, e1, s2, e2, f.a[k1], f.a[k2]) {
                    return false
                }
            }
            .Const -> {
                if f.a[k1] != f.a[k2] || !patch_group_slot_eq(p, s1, e1, s2, e2, f.dst[k1], f.dst[k2]) {
                    return false
                }
            }
            .Load | .Offset -> {
                if f.b[k1] != f.b[k2] || f.c[k1] != f.c[k2] || !patch_group_slot_eq(p, s1, e1, s2, e2, f.a[k1], f.a[k2]) || !patch_group_slot_eq(p, s1, e1, s2, e2, f.dst[k1], f.dst[k2]) {
                    return false
                }
            }
            .Copy | .Move | .Not -> {
                if !patch_group_slot_eq(p, s1, e1, s2, e2, f.a[k1], f.a[k2]) || !patch_group_slot_eq(p, s1, e1, s2, e2, f.dst[k1], f.dst[k2]) {
                    return false
                }
            }
            .BitAnd | .BitOr | .BitXor | .Eq | .Ne | .Lt | .Le | .Gt | .Ge -> {
                if f.c[k1] != f.c[k2] || !patch_group_slot_eq(p, s1, e1, s2, e2, f.a[k1], f.a[k2]) || !patch_group_slot_eq(p, s1, e1, s2, e2, f.b[k1], f.b[k2]) || !patch_group_slot_eq(p, s1, e1, s2, e2, f.dst[k1], f.dst[k2]) {
                    return false
                }
            }
            .If -> {
                if (f.b[k1] >= 0) != (f.b[k2] >= 0) || (f.c[k1] - s1) != (f.c[k2] - s2) || !patch_group_slot_eq(p, s1, e1, s2, e2, f.a[k1], f.a[k2]) {
                    return false
                }
            }
            .Else | .End | .Nop -> {}
            .Call | .CallRuntime -> {
                if f.a[k1] != f.a[k2] || f.c[k1] != f.c[k2] || !patch_group_slot_eq(p, s1, e1, s2, e2, f.dst[k1], f.dst[k2]) {
                    return false
                }
                loop j in 0..<f.c[k1] {
                    if !patch_group_slot_eq(p, s1, e1, s2, e2, f.args[f.b[k1] + j], f.args[f.b[k2] + j]) {
                        return false
                    }
                }
            }
            .ConstText | .ConstBigInt | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .Shl | .Shr | .Neg | .Convert | .Concat | .CallIndirect | .FunctionAddress | .DataAddress | .Store | .StackAddress | .CopyBytes | .Block | .Loop | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> return false
        }
    }
    true
}

patch_group_hash: fn(f: IRFunction, s: Int, e: Int) -> Int Never! {
    len: e - s
    if len == 1 && f.op[s] == .Drop -> return 1 + f.a[s] * 31
    h := len * 1315423911
    loop k in s..<e {
        op: f.op[k]
        tag: if op == {
            .Drop -> 1
            .Close -> 2
            .If -> 3
            .Else -> 4
            .End -> 5
            .Load -> 6
            .Const -> 7
            .BitAnd -> 8
            .Eq -> 9
            .Ne -> 10
            .Call -> 11
            .CallRuntime -> 12
            .Nop | .ConstText | .ConstBigInt | .Copy | .Move | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitOr | .BitXor | .Shl | .Shr | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .CallIndirect | .FunctionAddress | .DataAddress | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> 13
        }
        h = (h * 33 + tag) & 2147483647
        if op == .Drop || op == .Close -> h = (h * 33 + f.a[k]) & 2147483647
    }
    h
}

patch_suffix_find: fn(p: &IRPatchEmitter, slot: Int, next_off: Int) -> Int Never! {
    loop i in 0..<p.suffix_slot.len() {
        if p.suffix_slot[i] == slot && p.suffix_next[i] == next_off -> return p.suffix_off[i]
    }
    -1
}

// Emit out-of-line stop edges after the epilogue & exit in reverse order so
// both `jet_rt_cleanup_enter..leave` cleanup edges and simple drop chains
// share suffixes (and identical full edges) in O(N) total code size.
patch_emit_stop_edges: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, exit: Int) Never! {
    if p.stop_edges.is_empty() {
        return
    }
    p.in_stop_edge = true
    p.at = -1
    shared_tok_home := 0
    leave_off := -1
    // Cleanup-group suffix trie: (hash, next_off, start, end) -> code offset.
    g_hash := [Int]{}
    g_next := [Int]{}
    g_start := [Int]{}
    g_end := [Int]{}
    g_off := [Int]{}
    // Identical full-cleanup-edge cache: body_off -> enter_off.
    enter_body := [Int]{}
    enter_off := [Int]{}
    idx := p.stop_edges.len() - 1
    loop idx >= 0 {
        branch: p.stop_edges[idx].branch
        end_idx: p.stop_edges[idx].end
        info: patch_cleanup_edge(p, m, f, branch, end_idx)
        if info.ok {
            if leave_off < 0 {
                p.depth += 8
                shared_tok_home = 0 - p.depth
                leave_off = p.code.len()
                patch_load_rbp(p, 7, shared_tok_home)
                patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_cleanup_leave"}, false, -1)
                patch_jmp_to(p, exit)
            }
            // Split (info.first + 1 ..< info.leave) into self-contained top-level groups.
            gs := [Int]{}
            ge := [Int]{}
            k := info.first + 1
            loop k < info.leave {
                if f.op[k] == .Nop || (p.has_drop_kill && p.drop_kill[k]) {
                    k += 1
                    next
                }
                start_k: k
                if f.op[k] == .Drop || f.op[k] == .Close -> k += 1 else {
                    depth := 0
                    loop k < info.leave {
                        op: f.op[k]
                        k += 1
                        if op == .If -> depth += 1 else if op == .End {
                            depth -= 1
                            if depth == 0 -> break
                        } else if depth == 0 && (op == .Drop || op == .Close) { break }
                    }
                }
                // Merge with previous group if any op in [start_k..k) reads a temp defined earlier inside the edge.
                merged := false
                if gs.len() > 0 {
                    loop u in start_k..<k {
                        form: ir_x64_read_form(f.op[u])
                        if form != IR_X64_READS_NONE {
                            a: f.a[u]
                            if form != IR_X64_READS_ARGS && a >= 0 && p.starts[a] > info.first && p.starts[a] < start_k {
                                merged = true
                                break
                            }
                            if form == IR_X64_READS_AB && f.b[u] >= 0 && p.starts[f.b[u]] > info.first && p.starts[f.b[u]] < start_k {
                                merged = true
                                break
                            }
                        }
                    }
                }
                if merged -> ge[ge.len() - 1] = k else {
                    gs.push(start_k)
                    ge.push(k)
                }
            }
            // Match longest suffix from the back against g_*.
            tail_off := leave_off
            prefix_len := gs.len()
            loop prefix_len > 0 {
                s: gs[prefix_len - 1]
                e: ge[prefix_len - 1]
                h: patch_group_hash(f, s, e)
                found := -1
                loop gi in 0..<g_hash.len() {
                    if g_hash[gi] == h && g_next[gi] == tail_off && patch_group_eq(p, f, s, e, g_start[gi], g_end[gi]) {
                        found = g_off[gi]
                        break
                    }
                }
                if found < 0 -> break
                tail_off = found
                prefix_len -= 1
            }
            if prefix_len == 0 {
                cached := -1
                loop ei in 0..<enter_body.len() {
                    if enter_body[ei] == tail_off {
                        cached = enter_off[ei]
                        break
                    }
                }
                if cached >= 0 {
                    p.stop_edges[idx].offset = cached
                    loop s in p.stop_edges[idx].sites -> patch_rel32(p.code, s, cached)
                } else {
                    here: p.code.len()
                    p.stop_edges[idx].offset = here
                    loop s in p.stop_edges[idx].sites -> patch_rel32(p.code, s, here)
                    patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_cleanup_enter"}, false, -1)
                    patch_store_rbp(p, shared_tok_home, 0)
                    patch_jmp_to(p, tail_off)
                    enter_body.push(tail_off)
                    enter_off.push(here)
                }
            } else {
                here: p.code.len()
                p.stop_edges[idx].offset = here
                loop s in p.stop_edges[idx].sites -> patch_rel32(p.code, s, here)
                patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_cleanup_enter"}, false, -1)
                patch_store_rbp(p, shared_tok_home, 0)
                body_start: p.code.len()
                enter_body.push(body_start)
                enter_off.push(here)
                offs := [Int]{}
                p.ctrl_open = [Int]{}
                p.ctrl_head = [Int]{}
                p.ctrl_false = [Int]{}
                p.ctrl_end_head = [Int]{}
                p.ctrl_end_tail = [Int]{}
                loop pos in 0..<prefix_len {
                    offs.push(p.code.len())
                    p.fused_slot = -1
                    p.fused_cc = -1
                    loop u in gs[pos]..<ge[pos] {
                        if p.has_drop_kill && p.drop_kill[u] -> next
                        ir_x64_debug_line(p.lines, p.code.len(), ir_code_line_source(f.code_line[u]))
                        patch_emit_op(p, m, f, u)
                    }
                }
                patch_jmp_to(p, tail_off)
                next_off := tail_off
                pos := prefix_len - 1
                loop pos >= 0 {
                    s: gs[pos]
                    e: ge[pos]
                    off: offs[pos]
                    g_hash.push(patch_group_hash(f, s, e))
                    g_next.push(next_off)
                    g_start.push(s)
                    g_end.push(e)
                    g_off.push(off)
                    next_off = off
                    pos -= 1
                }
            }
            idx -= 1
            next
        }
        if patch_stop_edge_is_drop_chain(f, branch, end_idx) {
            drops := [Int]{}
            loop k in (branch + 1)..<(end_idx - 1) {
                if f.op[k] == .Drop && !(p.has_drop_kill && p.drop_kill[k]) -> drops.push(k)
            }
            tail_off := exit
            prefix_len := drops.len()
            loop prefix_len > 0 {
                slot: f.a[drops[prefix_len - 1]]
                found: patch_suffix_find(p, slot, tail_off)
                if found < 0 -> break
                tail_off = found
                prefix_len -= 1
            }
            if prefix_len == 0 {
                p.stop_edges[idx].offset = tail_off
                loop s in p.stop_edges[idx].sites -> patch_rel32(p.code, s, tail_off)
            } else {
                entry_off: p.code.len()
                p.stop_edges[idx].offset = entry_off
                loop s in p.stop_edges[idx].sites -> patch_rel32(p.code, s, entry_off)
                offs := [Int]{}
                loop pos in 0..<prefix_len {
                    k: drops[pos]
                    offs.push(p.code.len())
                    ir_x64_debug_line(p.lines, p.code.len(), ir_code_line_source(f.code_line[k]))
                    patch_drop(p, m, f, k)
                }
                patch_jmp_to(p, tail_off)
                next_off := tail_off
                pos := prefix_len - 1
                loop pos >= 0 {
                    slot: f.a[drops[pos]]
                    off: offs[pos]
                    p.suffix_slot.push(slot)
                    p.suffix_next.push(next_off)
                    p.suffix_off.push(off)
                    next_off = off
                    pos -= 1
                }
            }
            idx -= 1
            next
        }
        here: p.code.len()
        p.stop_edges[idx].offset = here
        loop s in p.stop_edges[idx].sites -> patch_rel32(p.code, s, here)
        p.ctrl_open = p.stop_edges[idx].open
        p.ctrl_head = p.stop_edges[idx].heads
        p.ctrl_false = [Int]{}
        p.ctrl_end_head = [Int]{}
        p.ctrl_end_tail = [Int]{}
        loop _ in 0..<p.ctrl_open.len() {
            p.ctrl_false.push(-1)
            p.ctrl_end_head.push(-1)
            p.ctrl_end_tail.push(-1)
        }
        p.fused_slot = -1
        p.fused_cc = -1
        patch_ctrl_open(p, branch, -1, -1)
        loop k in (branch + 1)..<end_idx {
            if p.has_drop_kill && p.drop_kill[k] -> next
            ir_x64_debug_line(p.lines, p.code.len(), ir_code_line_source(f.code_line[k]))
            patch_emit_op(p, m, f, k)
        }
        patch_ctrl_end(p, f, end_idx)
        // If edge fell through (no Return/Br/Unreachable at end), jump back to resume.
        last_op: f.op[end_idx - 1]
        if last_op != .Return && last_op != .Br && last_op != .Unreachable {
            patch_jmp_to(p, p.stop_edges[idx].resume)
        }
        idx -= 1
    }
    p.in_stop_edge = false
}

// ---------------------------------------------------------------------------
// Cold slow paths & stack-grow path.

patch_cold_target: fn(p: &IRPatchEmitter, pad: Int, exit: Int) -> Int Never! {
    if pad >= 0 && pad < p.stop_edges.len() && p.stop_edges[pad].offset >= 0 {
        return p.stop_edges[pad].offset
    }
    exit
}

patch_emit_cold_drop: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, slot: Int) Never! {
    if slot < 0 {
        return
    }
    drop: m.types[f.slot_type[slot]].drop
    if drop == "" {
        return
    }
    patch_load_slot(p, 7, slot)
    patch_call_out(p, f, X64RelocTarget.Runtime{symbol: drop}, false, -1)
}

patch_emit_colds: fn(p: &IRPatchEmitter, m: IRModule, f: IRFunction, exit: Int) Never! {
    loop cold in p.colds {
        p.at = if cold.kind == .Poll || cold.kind == .Release -> -1 else -> cold.at
        here: p.code.len()
        loop site in cold.sites -> patch_rel32(p.code, site, here)
        if cold.kind == {
            .Route -> {
                if cold.left >= 0 -> patch_load_slot(p, 7, cold.left) else -> patch_mov_ri(p, 7, 0)
                if cold.right >= 0 -> patch_load_slot(p, 6, cold.right) else if cold.right_imm != 0 {
                    patch_mov_ri(p, 6, cold.right_imm)
                }
                patch_call_out(p, f, X64RelocTarget.Runtime{symbol: cold.symbol}, false, -1)
                if cold.dst >= 0 -> patch_store_slot(p, cold.dst, 0)
                if cold.drop0 >= 0 || cold.drop1 >= 0 {
                    p.at = -1
                    patch_emit_cold_drop(p, m, f, cold.drop0)
                    patch_emit_cold_drop(p, m, f, cold.drop1)
                }
                if !cold.falls -> patch_jmp_to(p, cold.resume)
            }
            .LocatedRoute -> {
                path: patch_file_text(p, f)
                patch_load_slot(p, 7, cold.left)
                patch_load_slot(p, 6, cold.right)
                site: patch_lea_rip(p, 2)
                patch_reloc_data(p, site, path)
                path_len: patch_use_len(p, path)
                patch_mov_ri(p, 1, path_len)
                patch_mov_ri(p, 8, cold.line)
                patch_call_out(p, f, X64RelocTarget.Runtime{symbol: cold.symbol}, false, -1)
                if m.stop_points && patch_located_stops(p, f, cold.at, cold.right) {
                    if 16 > p.below -> p.below = 16
                    p.code.push(U8{0x50})
                    p.code.push(U8{0x50})
                    patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_session_propagate"}, false, -1)
                    p.code.push(U8{0x48})
                    p.code.push(U8{0x85})
                    p.code.push(U8{0xc0})
                    p.code.push(U8{0x58})
                    p.code.push(U8{0x58})
                    stopped: patch_jcc(p, 5)
                    tgt: patch_cold_target(p, cold.pad, exit)
                    patch_rel32(p.code, stopped, tgt)
                }
                patch_store_slot(p, cold.dst, 0)
                if !cold.falls -> patch_jmp_to(p, cold.resume)
            }
            .Compare -> {
                patch_load_slot(p, 7, cold.left)
                patch_load_slot(p, 6, cold.right)
                patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_int_compare"}, false, -1)
                if cold.drop0 >= 0 || cold.drop1 >= 0 {
                    if 16 > p.below -> p.below = 16
                    p.code.push(U8{0x50})
                    p.code.push(U8{0x50})
                    p.at = -1
                    patch_emit_cold_drop(p, m, f, cold.drop0)
                    patch_emit_cold_drop(p, m, f, cold.drop1)
                    p.code.push(U8{0x58})
                    p.code.push(U8{0x58})
                }
                p.code.push(U8{0x48})
                p.code.push(U8{0x83})
                p.code.push(U8{0xf8})
                p.code.push(U8{0x00})
                if cold.dst >= 0 {
                    p.code.push(U8{0x0f})
                    p.code.push(U8{0x90 + cold.cc})
                    p.code.push(U8{0xc0})
                    p.code.push(U8{0x0f})
                    p.code.push(U8{0xb6})
                    p.code.push(U8{0xc0})
                    patch_store_slot(p, cold.dst, 0)
                }
                if !cold.falls -> patch_jmp_to(p, cold.resume)
            }
            .Release -> {
                patch_load_slot(p, 7, cold.left)
                patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_block_release"}, false, -1)
                p.code.push(U8{0x0f})
                p.code.push(U8{0xb6})
                p.code.push(U8{0xc0})
                patch_store_slot(p, cold.dst, 0)
                if !cold.falls -> patch_jmp_to(p, cold.resume)
            }
            .Stop -> {
                path: patch_file_text(p, f)
                s_path: patch_lea_rip(p, 7)
                patch_reloc_data(p, s_path, path)
                path_len: patch_use_len(p, path)
                patch_mov_ri(p, 6, path_len)
                patch_mov_ri(p, 2, cold.line)
                s_msg: patch_lea_rip(p, 1)
                patch_reloc_data(p, s_msg, cold.text)
                msg_len: patch_use_len(p, cold.text)
                patch_mov_ri(p, 8, msg_len)
                patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_numeric_stop"}, false, -1)
                tgt: patch_cold_target(p, cold.pad, exit)
                if m.stop_points -> patch_jmp_to(p, tgt) else {
                    p.code.push(U8{0x0f})
                    p.code.push(U8{0x0b})
                }
            }
            .ShiftStop -> {
                path: patch_file_text(p, f)
                patch_mov_ri(p, 7, cold.direction)
                patch_load_slot(p, 6, cold.right)
                patch_mov_ri(p, 2, cold.unsigned)
                patch_mov_ri(p, 1, cold.width)
                s_path: patch_lea_rip(p, 8)
                patch_reloc_data(p, s_path, path)
                path_len: patch_use_len(p, path)
                patch_mov_ri(p, 9, path_len)
                if 16 > p.below -> p.below = 16
                p.code.push(U8{0x48})
                p.code.push(U8{0x83})
                p.code.push(U8{0xec})
                p.code.push(U8{8})
                patch_mov_ri(p, 11, cold.line)
                p.code.push(U8{0x41})
                p.code.push(U8{0x53})
                patch_call_out(p, f, X64RelocTarget.Runtime{symbol: "jet_rt_fixed_shift_stop"}, false, -1)
                tgt: patch_cold_target(p, cold.pad, exit)
                if tgt != exit {
                    p.code.push(U8{0x48})
                    p.code.push(U8{0x83})
                    p.code.push(U8{0xc4})
                    p.code.push(U8{16})
                }
                if m.stop_points -> patch_jmp_to(p, tgt) else {
                    p.code.push(U8{0x0f})
                    p.code.push(U8{0x0b})
                }
            }
            .Poll -> {
                at: cold.left
                patch_call_out(p, f, X64RelocTarget.Function{id: X64FunctionID{value: f.a[at]}}, false, -1)
                p.code.push(U8{0x48})
                p.code.push(U8{0x85})
                p.code.push(U8{0xc0})
                stopped: patch_jcc(p, 5)
                tgt: patch_cold_target(p, cold.pad, exit)
                patch_rel32(p.code, stopped, tgt)
                patch_jmp_to(p, cold.resume)
            }
            .Unique -> {
                at: cold.left
                quiet := [Int]{}
                if cold.right >= 0 {
                    quiet.push(patch_jcc(p, 8))
                    patch_load_slot(p, 0, cold.right)
                    p.code.push(U8{0x48})
                    p.code.push(U8{0x8b})
                    p.code.push(U8{0x08})
                    p.code.push(U8{0x48})
                    p.code.push(U8{0x85})
                    p.code.push(U8{0xc9})
                    quiet.push(patch_jcc(p, 4))
                }
                patch_call(p, m, f, X64RelocTarget.Function{id: X64FunctionID{value: f.a[at]}}, -1, f.args, f.b[at], f.c[at], -1, -1)
                patch_jmp_to(p, cold.resume)
                if quiet.len() > 0 {
                    written: p.code.len()
                    loop s in quiet -> patch_rel32(p.code, s, written)
                    p.code.push(U8{0x31})
                    p.code.push(U8{0xd2})
                    patch_jmp_to(p, cold.resume)
                }
            }
            .Call | .Fma -> {
                at: cold.left
                patch_call(p, m, f, X64RelocTarget.Runtime{symbol: cold.symbol}, -1, f.args, f.b[at], f.c[at], f.dst[at], -1)
                if !cold.falls -> patch_jmp_to(p, cold.resume)
            }
        }
    }
}

patch_stack_save_restore: fn(p: &IRPatchEmitter, base: Int, save: Bool) Never! {
    loop (i, reg) in IR_X64_ARGUMENT_REGISTERS {
        disp: 0 - 8 * (i + 1)
        rex: (if reg >= 8 -> 0x4c else -> 0x48) | (if base >= 8 -> 1 else -> 0)
        p.code.push(U8{rex})
        p.code.push(U8{if save -> 0x89 else -> 0x8b})
        p.code.push(U8{0x80 | ((reg & 7) << 3) | (base & 7)})
        patch_push_i32(p.code, disp)
    }
    loop xmm in 0..<8 {
        disp: 0 - 64 - 16 * xmm
        p.code.push(U8{0xf2})
        if base >= 8 -> p.code.push(U8{0x41})
        p.code.push(U8{0x0f})
        p.code.push(U8{if save -> 0x11 else -> 0x10})
        p.code.push(U8{0x80 | (xmm << 3) | (base & 7)})
        patch_push_i32(p.code, disp)
    }
}

patch_stack_grow: fn(p: &IRPatchEmitter, row: Int, entered: Int, frame: Int, stacked: Int) -> IRX64Grow Never! {
    start: p.code.len()
    b: patch_emit(p.code, PATCH_PROLOGUE)
    patch_i32(p.code, b + 7, IR_X64_STACK_SAVES)
    pushed: start + 1
    based: start + 4
    patch_stack_save_restore(p, 5, true)
    copied: 32 + 16 * ((stacked + 1) /% 2)
    patch_mov_ri(p, 7, frame + copied + 64)
    p.code.push(U8{0x48})
    p.code.push(U8{0x89})
    p.code.push(U8{0xe6})
    cb: patch_emit(p.code, PATCH_CALL_REL)
    patch_reloc_rt(p, cb + 1, "jet_rt_stack_grow")
    p.code.push(U8{0x48})
    p.code.push(U8{0x85})
    p.code.push(U8{0xc0})
    in_place: patch_jcc(p, 4)
    p.code.push(U8{0x4c})
    p.code.push(U8{0x8b})
    p.code.push(U8{0x5d})
    p.code.push(U8{8})
    p.code.push(U8{0x4c})
    p.code.push(U8{0x89})
    p.code.push(U8{0x58})
    p.code.push(U8{0xf8})
    p.code.push(U8{0x4c})
    p.code.push(U8{0x8b})
    p.code.push(U8{0x5d})
    p.code.push(U8{0})
    p.code.push(U8{0x4c})
    p.code.push(U8{0x89})
    p.code.push(U8{0x58})
    p.code.push(U8{0xf0})
    patch_mov_ri(p, 11, IR_X64_STACK_BRIDGE)
    p.code.push(U8{0x4c})
    p.code.push(U8{0x89})
    p.code.push(U8{0x58})
    p.code.push(U8{0xe8})
    p.code.push(U8{0x48})
    p.code.push(U8{0x89})
    p.code.push(U8{0x68})
    p.code.push(U8{0xe0})
    loop k in 0..<stacked {
        patch_load_rbp(p, 11, 16 + 8 * k)
        p.code.push(U8{0x4c})
        p.code.push(U8{0x89})
        p.code.push(U8{0x98})
        patch_push_i32(p.code, 8 * k - copied)
    }
    p.code.push(U8{0x49})
    p.code.push(U8{0x89})
    p.code.push(U8{0xeb})
    p.code.push(U8{0x48})
    p.code.push(U8{0x8d})
    p.code.push(U8{0xa0})
    patch_push_i32(p.code, 0 - copied)
    p.code.push(U8{0x48})
    p.code.push(U8{0x8d})
    p.code.push(U8{0x68})
    p.code.push(U8{0xf0})
    patch_stack_save_restore(p, 11, false)
    again: patch_emit(p.code, PATCH_CALL_REL)
    patch_reloc_fn(p, again + 1, row)
    p.code.push(U8{0x48})
    p.code.push(U8{0x8b})
    p.code.push(U8{0xac})
    p.code.push(U8{0x24})
    patch_push_i32(p.code, copied - 32)
    p.code.push(U8{0x48})
    p.code.push(U8{0x8d})
    p.code.push(U8{0xa5})
    patch_push_i32(p.code, 0 - IR_X64_STACK_SAVES)
    p.code.push(U8{0x48})
    p.code.push(U8{0x89})
    p.code.push(U8{0x04})
    p.code.push(U8{0x24})
    p.code.push(U8{0x48})
    p.code.push(U8{0x89})
    p.code.push(U8{0x54})
    p.code.push(U8{0x24})
    p.code.push(U8{8})
    p.code.push(U8{0xf2})
    p.code.push(U8{0x0f})
    p.code.push(U8{0x11})
    p.code.push(U8{0x44})
    p.code.push(U8{0x24})
    p.code.push(U8{16})
    p.code.push(U8{0xf2})
    p.code.push(U8{0x0f})
    p.code.push(U8{0x11})
    p.code.push(U8{0x4c})
    p.code.push(U8{0x24})
    p.code.push(U8{24})
    shrunk: patch_emit(p.code, PATCH_CALL_REL)
    patch_reloc_rt(p, shrunk + 1, "jet_rt_stack_shrink")
    p.code.push(U8{0x48})
    p.code.push(U8{0x8b})
    p.code.push(U8{0x04})
    p.code.push(U8{0x24})
    p.code.push(U8{0x48})
    p.code.push(U8{0x8b})
    p.code.push(U8{0x54})
    p.code.push(U8{0x24})
    p.code.push(U8{8})
    p.code.push(U8{0xf2})
    p.code.push(U8{0x0f})
    p.code.push(U8{0x10})
    p.code.push(U8{0x44})
    p.code.push(U8{0x24})
    p.code.push(U8{16})
    p.code.push(U8{0xf2})
    p.code.push(U8{0x0f})
    p.code.push(U8{0x10})
    p.code.push(U8{0x4c})
    p.code.push(U8{0x24})
    p.code.push(U8{24})
    p.code.push(U8{0xc9})
    returned: p.code.len()
    p.code.push(U8{0xc3})
    resumed: p.code.len()
    patch_rel32(p.code, in_place, resumed)
    patch_stack_save_restore(p, 5, false)
    p.code.push(U8{0xc9})
    left: p.code.len()
    patch_jmp_to(p, entered)
    IRX64Grow{start: start, pushed: pushed, based: based, returned: returned, resumed: resumed, left: left}
}

// ---------------------------------------------------------------------------
// Main entry point for copy-and-patch O0 function compilation.

ir_x64_patch_function: fn(m: IRModule, row: Int, poll: Int, trap: Int, turn: Int) -> IRX64FunctionResult Never! {
    p := ir_patch_emitter_new()
    ir_x64_patch_function_in(m, row, poll, trap, turn, p)
}

ir_x64_patch_function_in: fn(m: IRModule, row: Int, poll: Int, trap: Int, turn: Int, p: &IRPatchEmitter) -> IRX64FunctionResult Never! {
    f: m.functions[row]
    slot_count: f.slot_type.len()
    op_count: f.op.len()
    patch_emitter_reset(p, op_count, slot_count)
    // 1. Single O(N) liveness + write scan into pre-sized per-worker buffers
    //    (zero .clear() drop loops, 32-slot temp_homes reuse, result_storage,
    //    Const & transitive StackAddress folding).
    loop slot in 0..<slot_count {
        p.classes[slot] = ir_x64_row_class(m, f.slot_type[slot])
        if slot < f.param_count {
            p.starts[slot] = -1
            p.ends[slot] = -1
            p.first_writes[slot] = true
        } else {
            p.starts[slot] = op_count
            p.ends[slot] = -1
            p.first_writes[slot] = false
        }
        p.writes[slot] = 0
        p.last_write[slot] = -1
    }
    has_string_drop := false
    need_drop_early: !m.dropped_early
    loop at in 0..<op_count {
        op: f.op[at]
        if op == .Loop {
            p.loop_starts.push(at)
            p.loop_ends.push(f.a[at])
        } else if op == .StreamStore { p.has_stream = true } else if need_drop_early && !has_string_drop && op == .Drop {
            ds: f.a[at]
            if ds >= 0 && ds < slot_count {
                dty: f.slot_type[ds]
                if m.types[dty].kind == .String && m.types[dty].drop != "" -> has_string_drop = true
            }
        }
        form: ir_x64_read_form(op)
        if form != IR_X64_READS_NONE {
            a: f.a[at]
            if form != IR_X64_READS_ARGS && (form != IR_X64_READS_RESULT || a >= 0) {
                if a >= 0 && a < slot_count {
                    if at < p.starts[a] {
                        p.starts[a] = at
                        p.first_writes[a] = false
                    }
                    if at > p.ends[a] -> p.ends[a] = at
                }
            }
            if form == IR_X64_READS_AB {
                b: f.b[at]
                if b >= 0 && b < slot_count {
                    if at < p.starts[b] {
                        p.starts[b] = at
                        p.first_writes[b] = false
                    }
                    if at > p.ends[b] -> p.ends[b] = at
                }
            } else if form == IR_X64_READS_AC {
                c: f.c[at]
                if c >= 0 && c < slot_count {
                    if at < p.starts[c] {
                        p.starts[c] = at
                        p.first_writes[c] = false
                    }
                    if at > p.ends[c] -> p.ends[c] = at
                }
            } else if form == IR_X64_READS_ARGS || form == IR_X64_READS_A_ARGS {
                first_arg: f.b[at]
                loop index in first_arg..<(first_arg + f.c[at]) {
                    slot: f.args[index]
                    if slot >= 0 && slot < slot_count {
                        if at < p.starts[slot] {
                            p.starts[slot] = at
                            p.first_writes[slot] = false
                        }
                        if at > p.ends[slot] -> p.ends[slot] = at
                    }
                }
            }
        }
        written: ir_x64_write(f, at)
        if written >= 0 && written < slot_count {
            if at < p.starts[written] {
                p.starts[written] = at
                p.first_writes[written] = true
            }
            if at > p.ends[written] -> p.ends[written] = at
            p.writes[written] = p.writes[written] + 1
            p.last_write[written] = at
        }
    }
    if has_string_drop {
        plan := ir_drop_plan(m, f, poll, trap, turn)
        if plan.slots.len() > 0 {
            p.has_drop_plan = true
            p.has_drop_kill = true
            if p.drop_head.len() < op_count {
                p.drop_head.try_reserve(op_count) ?? panic("reserve failed")
                loop p.drop_head.len() < op_count -> p.drop_head.push(-1)
            }
            loop i in 0..<op_count -> p.drop_head[i] = -1
            p.drop_slots = plan.slots.move()
            p.drop_lines = plan.lines.move()
            p.drop_kill = plan.kill.move()
            p.drop_chain = [Int]{}
            p.drop_chain.try_reserve(plan.to.len()) ?? panic("reserve failed")
            loop k in 0..<plan.to.len() {
                target: plan.to[k]
                p.drop_chain.push(p.drop_head[target])
                p.drop_head[target] = k
            }
        }
    }
    has_addressed := false
    loop slot in 0..<slot_count {
        def: p.last_write[slot]
        is_c: slot >= f.param_count && f.slot_kind[slot] == .Temp && p.writes[slot] == 1 && def >= 0 && f.op[def] == .Const && p.classes[slot] == .General
        p.is_const[slot] = is_c
        p.const_val[slot] = if is_c -> f.a[def] else -> 0
        is_a: slot >= f.param_count && f.slot_kind[slot] == .Temp && p.writes[slot] == 1 && def >= 0 && f.op[def] == .StackAddress && p.classes[slot] == .General
        if is_a {
            has_addressed = true
            p.roots[slot] = slot
        } else { p.roots[slot] = -1 }
        p.shifts[slot] = 0
    }
    p.result_storage = ir_x64_result_storage(m, f, p.last_write, p.writes)
    if p.result_storage >= 0 -> p.roots[p.result_storage] = -1
    if has_addressed {
        derived := true
        loop derived {
            derived = false
            loop slot in 0..<slot_count {
                def: p.last_write[slot]
                if p.roots[slot] >= 0 || def < 0 || slot < f.param_count || p.writes[slot] != 1 || p.classes[slot] != .General {
                    next
                }
                dop: f.op[def]
                if dop != .Copy && dop != .Move && dop != .Offset -> next
                source: f.a[def]
                if source < 0 || source >= slot_count || p.roots[source] < 0 -> next
                type_row: f.slot_type[source]
                if dop == .Copy && m.types[type_row].drop != "" && m.types[type_row].kind != .Aggregate {
                    next
                }
                root: p.roots[source]
                shift: p.shifts[source] + (if dop == .Offset -> f.b[def] else -> 0)
                if shift < 0 || shift >= ir_x64_storage_size(f, p.last_write[root]) -> next
                p.roots[slot] = root
                p.shifts[slot] = shift
                derived = true
            }
        }
    }
    if p.loop_starts.len() > 0 {
        if p.inner.len() < op_count {
            p.inner.try_reserve(op_count) ?? panic("reserve failed")
            p.heads.try_reserve(op_count) ?? panic("reserve failed")
            loop p.inner.len() < op_count {
                p.inner.push(-1)
                p.heads.push(-1)
            }
        }
        nested := true
        loop at in 0..<op_count {
            loop p.open_loops.len() > 0 && p.loop_ends[p.open_loops[p.open_loops.len() - 1]] < at {
                _ := p.open_loops.pop()
            }
            holder: if p.open_loops.len() > 0 -> p.open_loops[p.open_loops.len() - 1] else -> -1
            p.inner[at] = holder
            if f.op[at] == .Loop {
                lrow: p.parents.len()
                p.heads[at] = lrow
                p.parents.push(holder)
                if p.loop_ends[lrow] <= at || p.loop_ends[lrow] >= op_count || (holder >= 0 && p.loop_ends[lrow] > p.loop_ends[holder]) {
                    nested = false
                }
                p.open_loops.push(lrow)
            } else { p.heads[at] = -1 }
        }
        loop slot in 0..<slot_count {
            if p.starts[slot] > p.ends[slot] || p.ends[slot] < 0 -> next
            changed := true
            loop changed {
                changed = false
                if nested {
                    lrow := if p.starts[slot] >= 0 -> p.inner[p.starts[slot]] else -> -1
                    loop lrow >= 0 {
                        if ir_x64_grow_range(p.starts, p.ends, slot, p.loop_starts[lrow], p.loop_ends[lrow], p.first_writes[slot]) {
                            changed = true
                        }
                        lrow = p.parents[lrow]
                    }
                    lrow = if p.heads[p.ends[slot]] >= 0 -> p.heads[p.ends[slot]] else -> p.inner[p.ends[slot]]
                    loop lrow >= 0 {
                        if ir_x64_grow_range(p.starts, p.ends, slot, p.loop_starts[lrow], p.loop_ends[lrow], p.first_writes[slot]) {
                            changed = true
                        }
                        lrow = p.parents[lrow]
                    }
                } else {
                    loop lrow in 0..<p.loop_starts.len() {
                        if ir_x64_grow_range(p.starts, p.ends, slot, p.loop_starts[lrow], p.loop_ends[lrow], p.first_writes[slot]) {
                            changed = true
                        }
                    }
                }
            }
        }
    }
    // Allocate compact stack homes first (reusing up to 32 disjoint temp homes
    // so almost every slot stays in 4-byte disp8 `[-128..-8]`!), then result_home,
    // then StackAddress storage buffers.
    loop slot in 0..<slot_count {
        s: p.starts[slot]
        if p.is_const[slot] || p.roots[slot] >= 0 || s > p.ends[slot] || p.classes[slot] == .Empty {
            p.homes[slot] = 0
            next
        }
        if f.slot_name[slot] < 0 {
            reused := 0
            loop k in 0..<p.temp_ends.len() {
                if p.temp_ends[k] < s {
                    reused = p.temp_homes[k]
                    p.temp_ends[k] = p.ends[slot]
                    break
                }
            }
            if reused < 0 {
                p.homes[slot] = reused
                next
            }
            p.depth += 8
            disp: 0 - p.depth
            p.homes[slot] = disp
            if p.temp_homes.len() < 32 {
                p.temp_homes.push(disp)
                p.temp_ends.push(p.ends[slot])
            }
        } else {
            p.depth += 8
            p.homes[slot] = 0 - p.depth
        }
    }
    if f.result >= 0 && m.types[f.result].kind == .Aggregate {
        p.depth += 8
        p.result_home = 0 - p.depth
    }
    loop slot in 0..<slot_count -> p.frames[slot] = 0
    if has_addressed {
        loop slot in 0..<slot_count {
            if p.roots[slot] == slot {
                def: p.last_write[slot]
                size: ir_x64_storage_size(f, def)
                align: if {
                    f.b[def] > 16 -> 16
                    f.b[def] < 1 -> 1
                    else -> f.b[def]
                }
                p.depth = ir_x64_align(p.depth + size, align)
                p.frames[slot] = 0 - p.depth
            }
        }
        loop slot in 0..<slot_count {
            root: p.roots[slot]
            if root >= 0 && root != slot -> p.frames[slot] = p.frames[root] + p.shifts[slot]
        }
    }
    if f.line > 0 -> p.lines.push(X64LineRow{at: 0, line: f.line})
    // 2. Optional stack check (back-patched after single pass).
    stack_frame_site := -1
    grow_site := -1
    if f.stack_check {
        sb: patch_emit(p.code, PATCH_STACK_CHECK)
        stack_frame_site = sb + 4
        patch_i32(p.code, sb + 13, IR_X64_STACK_LIMIT)
        grow_site = sb + 19
    }
    entered: p.code.len()
    // 3. Prologue stencil (sub rsp imm32 back-patched after single pass).
    pro_base: patch_emit(p.code, PATCH_PROLOGUE)
    pushed: pro_base + 1
    based: pro_base + 4
    sub_rsp_site: pro_base + 7
    // 4. Import parameters into their frame homes.
    general := 0
    floats := 0
    stacked := 0
    if p.result_home != 0 {
        patch_store_rbp(p, p.result_home, 7)
        general = 1
    }
    loop slot in 0..<f.param_count {
        cls: p.classes[slot]
        if cls == .Empty -> next
        ty: m.types[f.slot_type[slot]]
        if cls == .Float && floats < 8 {
            patch_store_xmm(p, ty.kind == .Float32, p.homes[slot], floats)
            floats += 1
            next
        }
        if cls != .Float && general < 6 {
            reg: IR_X64_ARGUMENT_REGISTERS[general]
            patch_normalize(p, ty, reg)
            patch_store_rbp(p, p.homes[slot], reg)
            general += 1
            next
        }
        patch_load_rbp(p, 0, 16 + 8 * stacked)
        stacked += 1
        if cls != .Float -> patch_normalize(p, ty, 0)
        patch_store_rbp(p, p.homes[slot], 0)
    }
    body: p.code.len()
    if f.line > 0 -> ir_x64_debug_line(p.lines, body, f.line)
    // 5. Single forward pass over all IR instructions.
    traps := 0
    at := 0
    loop at < op_count {
        if p.has_drop_plan {
            dk := p.drop_head[at]
            if dk >= 0 {
                p.fused_slot = -1
                p.fused_cc = -1
                loop dk >= 0 {
                    ir_x64_debug_line(p.lines, p.code.len(), ir_code_line_source(p.drop_lines[dk]))
                    patch_drop_slot(p, m, f, p.drop_slots[dk], -1)
                    dk = p.drop_chain[dk]
                }
            }
        }
        if at <= p.skip_to || (p.has_drop_kill && p.drop_kill[at]) {
            at += 1
            next
        }
        p.at = at
        ir_x64_debug_line(p.lines, p.code.len(), ir_code_line_source(f.code_line[at]))
        stop_end: patch_stop_point(p, m, f, at, poll, trap, turn, traps)
        traps = p.colds.len()
        if stop_end > at {
            p.fused_slot = -1
            p.fused_cc = -1
            at = stop_end + 1
            next
        }
        patch_emit_op(p, m, f, at)
        at += 1
    }
    p.at = -1
    if p.ctrl_open.len() > 0 {
        p.errors.push("{f.name}: {p.ctrl_open.len()} structured constructs are never closed")
    }
    // 6. Epilogue & stop exit stencils.
    epilogue: p.code.len()
    _ := patch_emit(p.code, if p.has_stream -> PATCH_EPILOGUE_SFENCE else -> PATCH_EPILOGUE)
    ret_at: p.code.len() - 1
    exit := epilogue
    need_exit := p.stop_returns.len() > 0 || (m.stop_points && p.stop_edges.len() > 0)
    if !need_exit && m.stop_points {
        loop cold in p.colds {
            if cold.kind == .Stop || cold.kind == .ShiftStop || cold.kind == .LocatedRoute || cold.kind == .Poll {
                need_exit = true
                break
            }
        }
    }
    if need_exit {
        exit = p.code.len()
        _ := patch_emit(p.code, if p.has_stream -> PATCH_STOP_EXIT_SFENCE else -> PATCH_STOP_EXIT)
    }
    // 7. Out-of-line stop edges, zone stubs, and cold slow paths.
    patch_emit_stop_edges(p, m, f, exit)
    loop site in p.returns -> patch_rel32(p.code, site, epilogue)
    loop site in p.stop_returns -> patch_rel32(p.code, site, exit)
    if p.zone_stubs.len() > 0 {
        p.in_stub = true
        loop stub in p.zone_stubs {
            patch_rel32(p.code, stub.site, p.code.len())
            p.at = stub.at
            patch_call(p, m, f, X64RelocTarget.Runtime{symbol: stub.symbol}, -1, f.args, f.b[stub.at], f.c[stub.at], stub.dst, -1)
            patch_jmp_to(p, stub.resume)
            p.stub_ends.push(p.code.len())
        }
        p.in_stub = false
    }
    patch_emit_colds(p, m, f, exit)
    // 8. Back-patch frame size & optional stack grow path.
    frame_bytes: ir_x64_align(p.depth, 16)
    patch_i32(p.code, sub_rsp_site, frame_bytes)
    grow := IRX64Grow{start: -1, pushed: -1, based: -1, returned: -1, resumed: -1, left: -1}
    if grow_site >= 0 {
        patch_i32(p.code, stack_frame_site, 0 - (16 + frame_bytes))
        grow = patch_stack_grow(p, row, entered, 16 + frame_bytes + p.below, stacked)
        patch_rel32(p.code, grow_site, grow.start)
    }
    // 9. Patch zone sites to off-by-default `test eax, imm32` (0xa9).
    zones := [Int]{}
    loop site in p.zone_sites {
        at_site: site - 1
        zones.push(at_site)
        p.code[at_site] = U8{0xa9}
    }
    // 10. Merge call rows into line table if any.
    if !p.call_rows.is_empty() {
        merged := [X64LineRow]{}
        next_row := 0
        statement := 0
        loop (k, call) in p.call_rows {
            loop next_row < p.lines.len() && p.lines[next_row].at <= call.at {
                statement = p.lines[next_row].line
                merged.push(p.lines[next_row])
                next_row += 1
            }
            if call.line <= 0 -> next
            merged.push(X64LineRow{at: call.at, line: call.line, column: call.column, call: true})
            back: p.call_returns[k]
            resumed: (next_row < p.lines.len() && p.lines[next_row].at == back) || (k + 1 < p.call_rows.len() && p.call_rows[k + 1].at == back && p.call_rows[k + 1].line > 0)
            if statement > 0 && !resumed {
                merged.push(X64LineRow{at: back, line: statement, call: true})
            }
        }
        loop next_row < p.lines.len() {
            merged.push(p.lines[next_row])
            next_row += 1
        }
        p.lines = merged
    }
    // 11. Minimal CFI for standard frame + tail jumps + ret + optional grow path.
    cfi := [U8]{}
    dwarf_cfa_advance(cfi, 0, pushed)
    dwarf_cfa_def_cfa_offset(cfi, 16)
    dwarf_cfa_offset(cfi, x64_dwarf_register(X64_RBP), 2)
    dwarf_cfa_advance(cfi, pushed, based)
    dwarf_cfa_def_cfa_register(cfi, x64_dwarf_register(X64_RBP))
    cfa_at := based
    loop jump in p.tails {
        dwarf_cfa_advance(cfi, cfa_at, jump)
        dwarf_cfa_remember_state(cfi)
        dwarf_cfa_def_cfa(cfi, x64_dwarf_register(X64_RSP), 8)
        dwarf_cfa_same_value(cfi, x64_dwarf_register(X64_RBP))
        dwarf_cfa_advance(cfi, jump, jump + 5)
        dwarf_cfa_restore_state(cfi)
        cfa_at = jump + 5
    }
    dwarf_cfa_advance(cfi, cfa_at, ret_at)
    dwarf_cfa_remember_state(cfi)
    dwarf_cfa_def_cfa(cfi, x64_dwarf_register(X64_RSP), 8)
    dwarf_cfa_same_value(cfi, x64_dwarf_register(X64_RBP))
    dwarf_cfa_advance(cfi, ret_at, ret_at + 1)
    dwarf_cfa_restore_state(cfi)
    if grow.start >= 0 {
        dwarf_cfa_advance(cfi, ret_at + 1, grow.start)
        dwarf_cfa_def_cfa(cfi, x64_dwarf_register(X64_RSP), 8)
        dwarf_cfa_same_value(cfi, x64_dwarf_register(X64_RBP))
        dwarf_cfa_advance(cfi, grow.start, grow.pushed)
        dwarf_cfa_def_cfa_offset(cfi, 16)
        dwarf_cfa_offset(cfi, x64_dwarf_register(X64_RBP), 2)
        dwarf_cfa_advance(cfi, grow.pushed, grow.based)
        dwarf_cfa_def_cfa_register(cfi, x64_dwarf_register(X64_RBP))
        dwarf_cfa_advance(cfi, grow.based, grow.returned)
        dwarf_cfa_remember_state(cfi)
        dwarf_cfa_def_cfa(cfi, x64_dwarf_register(X64_RSP), 8)
        dwarf_cfa_same_value(cfi, x64_dwarf_register(X64_RBP))
        dwarf_cfa_advance(cfi, grow.returned, grow.resumed)
        dwarf_cfa_restore_state(cfi)
        dwarf_cfa_advance(cfi, grow.resumed, grow.left)
        dwarf_cfa_def_cfa(cfi, x64_dwarf_register(X64_RSP), 8)
        dwarf_cfa_same_value(cfi, x64_dwarf_register(X64_RBP))
    }
    // 12. Flat debug variables over [body..epilogue].
    variables := [X64DebugVariable]{}
    ranges := [X64VariableRange]{}
    loop slot in 0..<slot_count {
        name_id: f.slot_name[slot]
        if name_id < 0 -> next
        if p.homes[slot] == 0 && p.frames[slot] == 0 && !p.is_const[slot] -> next
        ty: m.types[f.slot_type[slot]]
        var_id: variables.len()
        variables.push(
            X64DebugVariable{
                name: m.names[name_id],
                ty: f.slot_type[slot],
                parameter: slot < f.param_count || f.slot_formal[slot],
                line: f.slot_line[slot],
                indirect: ty.kind == .Aggregate,
                site: f.slot_site[slot],
            },
        )
        if epilogue > body {
            loc: if {
                p.is_const[slot] -> X64DebugLocation.Constant{value: p.const_val[slot]}
                p.frames[slot] != 0 -> X64DebugLocation.FrameAddress{offset: p.frames[slot]}
                else -> X64DebugLocation.Frame{offset: p.homes[slot]}
            }
            ranges.push(X64VariableRange{variable: var_id, start: body, end: epilogue, location: loc})
        }
    }
    allocs: loop (k, reloc) in p.alloc_relocs -> X64AllocSite{at: p.relocs[reloc].at + 4, ty: p.alloc_rows[k]}
    name: if {
        f.symbol != "" -> f.symbol
        f.key != "" -> f.key
        else -> f.name
    }
    IRX64FunctionResult{
        function: X64CompiledFunction{
            id: X64FunctionID{value: row},
            name: name,
            code: compiler_take_rows<U8>(p.code),
            relocs: compiler_take_rows<X64Reloc>(p.relocs),
            align: X64_FUNCTION_ALIGN,
            zones: zones.move(),
            zone_ends: compiler_take_rows<Int>(p.stub_ends),
        },
        debug: X64FunctionDebug{
            lines: compiler_take_rows<X64LineRow>(p.lines),
            body: body,
            cfi: cfi.move(),
            ranges: ranges.move(),
            stack: 16 + frame_bytes + p.below,
            dynamic: p.dynamic,
            inlines: [X64InlineRange]{},
            allocs: allocs,
            calls: compiler_take_rows<X64CallSite>(p.calls),
        },
        variables: variables.move(),
        errors: compiler_take_rows<String>(p.errors),
        log: [String]{},
        uses: IRX64Uses{
            kinds: compiler_take_rows<IRX64UseKind>(p.uses.kinds),
            data: compiler_take_rows<Int>(p.uses.data),
            texts: compiler_take_rows<String>(p.uses.texts),
        },
        local_relocs: compiler_take_rows<Int>(p.local_relocs),
    }
}

#Test("copy-and-patch O0 stencils compile arithmetic, control flow, and folded constants cleanly") {
    m := ir_module_new()
    m.fast_o0 = true
    i64_row: ir_type_row(m, Type.IntN{signed: true, bits: 64}) ?? panic("no I64 row")
    bool_row: ir_type_row(m, Type.Bool) ?? panic("no Bool row")
    f := ir_function_new("sum", "test:patch.jet.sum", "", "patch.jet", 1)
    a: ir_slot(f, i64_row, IRSlotKind.Param, ir_intern_name(m, "a"), 1)
    b: ir_slot(f, i64_row, IRSlotKind.Param, ir_intern_name(m, "b"), 1)
    f.result = i64_row
    one: ir_slot(f, i64_row, IRSlotKind.Temp, -1, 0)
    out: ir_slot(f, i64_row, IRSlotKind.Temp, -1, 0)
    cond: ir_slot(f, bool_row, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Const, one, 1, -1, -1, 2)
    _ := ir_emit(f, IROp.Add, out, a, one, IR_OVERFLOW_WRAP, 2)
    _ := ir_emit(f, IROp.Lt, cond, a, b, IR_OVERFLOW_WRAP, 3)
    if_at: ir_open_if(f, cond, 3)
    _ := ir_emit(f, IROp.Sub, out, out, b, IR_OVERFLOW_WRAP, 4)
    ir_end(f, 5)
    _ := ir_emit(f, IROp.Return, -1, out, -1, -1, 6)
    _ := if_at
    row: m.functions.len()
    m.functions.push(f)
    res: ir_x64_patch_function(m, row, -1, -1, -1)
    assert_eq(res.errors.len(), 0)
    assert(res.function.code.len() > 20)
    assert(res.variables.len() == 2)
}
