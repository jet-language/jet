// Copy-and-patch x86-64 code generator for O0 (`IRModule.fast_o0`): emits
// compact machine code in a single forward pass over each function's IR
// instructions by stamping toolchain-generated x86-64 stencils from
// `X64StencilData.jet` directly into a reusable worker byte buffer.
//
// Zero register allocator, zero live-range/loop-nesting pre-pass, zero
// per-function NameTable pre-scan, zero dying pass, zero branch relaxation,
// zero per-call/per-cold heap allocations, and zero runtime string copies in
// relocations. O(slots) home assignment keeps slots 0..15 in disp8, a sound
// `rax` accumulator eliminates redundant stack loads across adjacent ops, an
// epoch-stamped per-block constant table preserves immediate/align-8 fast
// paths, and out-of-line stop edges keep hot code dense in L1I.
use {
    jet_foundation.[Type, compiler_take_rows]
    jet_backend.[
        X64CallSite,
        X64CompiledFunction,
        X64DebugLocation,
        X64DebugVariable,
        X64FunctionDebug,
        X64FunctionID,
        X64InlineRange,
        X64LineRow,
        X64Reloc,
        X64VariableRange,
        X64_FUNCTION_ALIGN,
        X64_RBP,
        X64_RSP,
        dwarf_cfa_advance,
        dwarf_cfa_def_cfa,
        dwarf_cfa_def_cfa_offset,
        dwarf_cfa_def_cfa_register,
        dwarf_cfa_offset,
        dwarf_cfa_remember_state,
        dwarf_cfa_restore_state,
        dwarf_cfa_same_value,
        x64_dwarf_register,
        x64_fits_i32,
        x64_reloc_data,
        x64_reloc_function,
        x64_reloc_runtime,
        x64_reloc_runtime_data,
        x64_reloc_runtime_data_id,
        x64_reloc_runtime_id,
    ]
}

// ---------------------------------------------------------------------------
// Reusable buffer growth & fixed-hole patch primitives.

patch_grow_code: fn(p: &IRPatchEmitter, need: Int) Never! {
    min_cap: p.pos + need
    cap := p.code.len()
    if cap < 16384 -> cap = 16384
    loop cap < min_cap -> cap = cap * 2
    p.code.try_reserve(cap) ?? panic("reserve failed")
    loop p.code.len() < cap -> p.code.push(U8{0})
}

#Inline(Always) patch_ensure: fn(p: &IRPatchEmitter, need: Int) Never! {
    if p.pos + need > p.code.len() -> patch_grow_code(p, need)
}

#Inline(Always) patch_rel32: fn(code: &[U8], site: Int, target: Int) Never! {
    o0_patch_i32(code, site, target - (site + 4))
}

#Inline(Always) patch_fits_i8: fn(v: Int) -> Bool Never! { v >= -128 && v <= 127 }

#Inline(Always) patch_is_const: fn(p: IRPatchEmitter, slot: Int) -> Bool Never! {
    slot >= 0 && p.const_epoch[slot] == p.block_epoch
}

#Inline(Always) patch_cf_barrier: fn(p: &IRPatchEmitter) Never! {
    p.block_epoch += 1
    p.rax_slot = -1
    p.fused_slot = -1
    p.fused_cc = -1
}

// ---------------------------------------------------------------------------
// Flat SoA cold, stop-edge, and zone-stub records (zero nested heap arrays).

IRPatchCold: struct {
    kind: IRX64ColdKind,
    site_start: Int,
    site_len: Int,
    resume: Int,
    sym_id: Int,
    left: Int,
    right: Int,
    right_imm: Int,
    right_nonzero_const: Bool,
    dst: Int,
    cc: Int,
    text: Int,
    direction: Int,
    unsigned: Int,
    width: Int,
    line: Int,
    pad: Int,
    at: Int,
    falls: Bool{false},
    drop0: Int{-1},
    drop1: Int{-1},
}

IRPatchStopEdge: struct {
    branch: Int,
    end: Int,
    site: Int,
    resume: Int,
    open_start: Int,
    open_len: Int,
    offset: Int,
}

IRPatchZoneStub: struct {
    at: Int,
    site: Int,
    resume: Int,
    sym_id: Int,
    name_row: Int,
    dst: Int,
}

IRPatchEmitter: struct {
    code: [U8],
    pos: Int,
    relocs: [X64Reloc],
    local_relocs: [Int],
    uses: IRX64Uses,
    use_lengths: [Int],
    file_text_row: Int,
    stop_text_rows: [Int],
    header_keys: [Int],
    header_vals: [Int],
    int_keys: [Int],
    int_text_vals: [Int],
    int_static_vals: [Int],
    // Reusable per-worker frame & per-block constant state:
    homes: [Int],
    const_epoch: [Int],
    const_val: [Int],
    block_epoch: Int,
    rax_slot: Int,
    depth: Int,
    result_home: Int,
    // Structured control stack:
    ctrl_open: [Int],
    ctrl_head: [Int],
    ctrl_false: [Int],
    ctrl_end_head: [Int],
    ctrl_end_tail: [Int],
    end_sites: [Int],
    end_next: [Int],
    end_of: [Int],
    returns: [Int],
    stop_returns: [Int],
    stop_edges: [IRPatchStopEdge],
    edge_open: [Int],
    edge_heads: [Int],
    suffix_slot: [Int],
    suffix_next: [Int],
    suffix_off: [Int],
    tails: [Int],
    colds: [IRPatchCold],
    cold_sites: [Int],
    zone_sites: [Int],
    zone_stubs: [IRPatchZoneStub],
    stub_ends: [Int],
    lines: [X64LineRow],
    call_rows: [X64LineRow],
    call_returns: [Int],
    alloc_relocs: [Int],
    alloc_rows: [Int],
    errors: [String],
    // Reusable scratch for call args, stop edges, and early drops:
    call_places: [Int],
    call_stacked: [Int],
    g_hash: [Int],
    g_next: [Int],
    g_start: [Int],
    g_end: [Int],
    g_off: [Int],
    enter_body: [Int],
    enter_off: [Int],
    edge_gs: [Int],
    edge_ge: [Int],
    edge_offs: [Int],
    edge_drops: [Int],
    edge_def_epoch: [Int],
    edge_def_cur: Int,
    quiet_sites: [Int],
    enter_sites: [Int],
    drop: IRDropScratch,
    fused_slot: Int,
    fused_cc: Int,
    routed_at: Int,
    skip_to: Int,
    in_stop_edge: Bool,
    below: Int,
    dynamic: Bool,
    has_stream: Bool,
    in_stub: Bool,
    at: Int,
}

ir_patch_emitter_new: fn() -> IRPatchEmitter Never! {
    code := [U8]{}
    code.try_reserve(16384) ?? panic("reserve failed")
    loop _ in 0..<16384 -> code.push(U8{0})
    IRPatchEmitter{
        code: code.move(),
        pos: 0,
        relocs: [X64Reloc]{},
        local_relocs: [Int]{},
        uses: IRX64Uses{},
        use_lengths: [Int]{},
        file_text_row: -1,
        stop_text_rows: [Int]{-1, -1, -1, -1, -1},
        header_keys: [Int]{},
        header_vals: [Int]{},
        int_keys: [Int]{},
        int_text_vals: [Int]{},
        int_static_vals: [Int]{},
        homes: [Int]{},
        const_epoch: [Int]{},
        const_val: [Int]{},
        block_epoch: 1,
        rax_slot: -1,
        depth: 0,
        result_home: 0,
        ctrl_open: [Int]{},
        ctrl_head: [Int]{},
        ctrl_false: [Int]{},
        ctrl_end_head: [Int]{},
        ctrl_end_tail: [Int]{},
        end_sites: [Int]{},
        end_next: [Int]{},
        end_of: [Int]{},
        returns: [Int]{},
        stop_returns: [Int]{},
        stop_edges: [IRPatchStopEdge]{},
        edge_open: [Int]{},
        edge_heads: [Int]{},
        suffix_slot: [Int]{},
        suffix_next: [Int]{},
        suffix_off: [Int]{},
        tails: [Int]{},
        colds: [IRPatchCold]{},
        cold_sites: [Int]{},
        zone_sites: [Int]{},
        zone_stubs: [IRPatchZoneStub]{},
        stub_ends: [Int]{},
        lines: [X64LineRow]{},
        call_rows: [X64LineRow]{},
        call_returns: [Int]{},
        alloc_relocs: [Int]{},
        alloc_rows: [Int]{},
        errors: [String]{},
        call_places: [Int]{},
        call_stacked: [Int]{},
        g_hash: [Int]{},
        g_next: [Int]{},
        g_start: [Int]{},
        g_end: [Int]{},
        g_off: [Int]{},
        enter_body: [Int]{},
        enter_off: [Int]{},
        edge_gs: [Int]{},
        edge_ge: [Int]{},
        edge_offs: [Int]{},
        edge_drops: [Int]{},
        edge_def_epoch: [Int]{},
        edge_def_cur: 1,
        quiet_sites: [Int]{},
        enter_sites: [Int]{},
        drop: ir_drop_scratch_new(),
        fused_slot: -1,
        fused_cc: -1,
        routed_at: -2,
        skip_to: -1,
        in_stop_edge: false,
        below: 0,
        dynamic: false,
        has_stream: false,
        in_stub: false,
        at: -1,
    }
}

patch_emitter_reset: fn(p: &IRPatchEmitter, op_count: Int, slot_count: Int) Never! {
    p.pos = 0
    if p.relocs.len() > 0 -> p.relocs.clear()
    if p.local_relocs.len() > 0 -> p.local_relocs.clear()
    p.uses = IRX64Uses{}
    if p.use_lengths.len() > 0 -> p.use_lengths.clear()
    p.file_text_row = -1
    loop i in 0..<5 -> p.stop_text_rows[i] = -1
    if p.header_keys.len() > 0 -> p.header_keys.clear()
    if p.header_vals.len() > 0 -> p.header_vals.clear()
    if p.int_keys.len() > 0 -> p.int_keys.clear()
    if p.int_text_vals.len() > 0 -> p.int_text_vals.clear()
    if p.int_static_vals.len() > 0 -> p.int_static_vals.clear()
    if p.homes.len() < slot_count {
        p.homes.try_reserve(slot_count) ?? panic("reserve failed")
        p.const_epoch.try_reserve(slot_count) ?? panic("reserve failed")
        p.const_val.try_reserve(slot_count) ?? panic("reserve failed")
        p.edge_def_epoch.try_reserve(slot_count) ?? panic("reserve failed")
        loop p.homes.len() < slot_count {
            p.homes.push(0)
            p.const_epoch.push(0)
            p.const_val.push(0)
            p.edge_def_epoch.push(0)
        }
    }
    p.block_epoch += 1
    p.rax_slot = -1
    p.depth = 0
    p.result_home = 0
    if p.ctrl_open.len() > 0 -> p.ctrl_open.clear()
    if p.ctrl_head.len() > 0 -> p.ctrl_head.clear()
    if p.ctrl_false.len() > 0 -> p.ctrl_false.clear()
    if p.ctrl_end_head.len() > 0 -> p.ctrl_end_head.clear()
    if p.ctrl_end_tail.len() > 0 -> p.ctrl_end_tail.clear()
    if p.end_sites.len() > 0 -> p.end_sites.clear()
    if p.end_next.len() > 0 -> p.end_next.clear()
    if p.end_of.len() < op_count {
        p.end_of.try_reserve(op_count) ?? panic("reserve failed")
        loop p.end_of.len() < op_count -> p.end_of.push(-1)
    }
    loop i in 0..<op_count -> p.end_of[i] = -1
    if p.returns.len() > 0 -> p.returns.clear()
    if p.stop_returns.len() > 0 -> p.stop_returns.clear()
    if p.stop_edges.len() > 0 -> p.stop_edges.clear()
    if p.edge_open.len() > 0 -> p.edge_open.clear()
    if p.edge_heads.len() > 0 -> p.edge_heads.clear()
    if p.suffix_slot.len() > 0 -> p.suffix_slot.clear()
    if p.suffix_next.len() > 0 -> p.suffix_next.clear()
    if p.suffix_off.len() > 0 -> p.suffix_off.clear()
    if p.tails.len() > 0 -> p.tails.clear()
    if p.colds.len() > 0 -> p.colds.clear()
    if p.cold_sites.len() > 0 -> p.cold_sites.clear()
    if p.zone_sites.len() > 0 -> p.zone_sites.clear()
    if p.zone_stubs.len() > 0 -> p.zone_stubs.clear()
    if p.stub_ends.len() > 0 -> p.stub_ends.clear()
    if p.lines.len() > 0 -> p.lines.clear()
    if p.call_rows.len() > 0 -> p.call_rows.clear()
    if p.call_returns.len() > 0 -> p.call_returns.clear()
    if p.alloc_relocs.len() > 0 -> p.alloc_relocs.clear()
    if p.alloc_rows.len() > 0 -> p.alloc_rows.clear()
    if p.errors.len() > 0 -> p.errors.clear()
    p.fused_slot = -1
    p.fused_cc = -1
    p.routed_at = -2
    p.skip_to = -1
    p.in_stop_edge = false
    p.below = 0
    p.dynamic = false
    p.has_stream = false
    p.in_stub = false
    p.at = -1
}

// ---------------------------------------------------------------------------
// Lazy per-function data/text use registration & zero-copy relocations.

patch_add_use: fn(p: &IRPatchEmitter, kind: &&IRX64UseKind, data: Int, text: &&String, length: Int) -> Int Never! {
    id: IR_X64_LOCAL_DATA + p.uses.kinds.len()
    p.uses.kinds.push(kind)
    p.uses.data.push(data)
    p.uses.texts.push(text)
    p.use_lengths.push(length)
    id
}

patch_use_len: fn(p: &IRPatchEmitter, local_id: Int) -> Int Never! {
    p.use_lengths[local_id - IR_X64_LOCAL_DATA]
}

patch_file_text: fn(p: &IRPatchEmitter, f: IRFunction) -> Int Never! {
    if p.file_text_row >= 0 -> return p.file_text_row
    id: patch_add_use(p, IRX64UseKind.Text, -1, "{f.source_file}", f.source_file.bytes().len())
    p.file_text_row = id
    id
}

patch_stop_text: fn(p: &IRPatchEmitter, kind: Int) -> Int Never! {
    existing: p.stop_text_rows[kind]
    if existing >= 0 -> return existing
    msg: if kind == {
        0 -> ir_x64_overflow_message("add")
        1 -> ir_x64_overflow_message("sub")
        2 -> ir_x64_overflow_message("mul")
        3 -> ir_x64_overflow_message("div")
        else -> IR_X64_DIVIDED_BY_ZERO
    }
    id: patch_add_use(p, IRX64UseKind.Text, -1, "{msg}", msg.bytes().len())
    p.stop_text_rows[kind] = id
    id
}

patch_header_row: fn(p: &IRPatchEmitter, data_row: Int) -> Int Never! {
    loop (i, key) in p.header_keys {
        if key == data_row -> return p.header_vals[i]
    }
    id: patch_add_use(p, IRX64UseKind.Header, data_row, "", 24)
    p.header_keys.push(data_row)
    p.header_vals.push(id)
    id
}

patch_bigint_rows: fn(p: &IRPatchEmitter, name_row: Int, text: String) -> {text_id: Int, static_id: Int} Never! {
    loop (i, key) in p.int_keys {
        if key == name_row -> return {text_id: p.int_text_vals[i], static_id: p.int_static_vals[i]}
    }
    tid: patch_add_use(p, IRX64UseKind.Text, -1, "{text}", text.bytes().len())
    sid := -1
    if ir_x64_static_int_fits(text) {
        sid = patch_add_use(p, IRX64UseKind.StaticInt, -1, "{text}", 8)
    }
    p.int_keys.push(name_row)
    p.int_text_vals.push(tid)
    p.int_static_vals.push(sid)
    {text_id: tid, static_id: sid}
}

#Inline(Always) patch_reloc_data: fn(p: &IRPatchEmitter, at: Int, id: Int) Never! {
    if id >= IR_X64_LOCAL_DATA -> p.local_relocs.push(p.relocs.len())
    p.relocs.push(x64_reloc_data(at, id))
}

#Inline(Always) patch_reloc_fn: fn(p: &IRPatchEmitter, at: Int, id: Int) Never! {
    p.relocs.push(x64_reloc_function(at, id))
}

#Inline(Always) patch_make_rt: fn(fast: IRX64FastModule, at: Int, sym_id: Int) -> X64Reloc Never! {
    if fast.use_indexed_rt -> x64_reloc_runtime_id(at, sym_id) else -> x64_reloc_runtime(at, fast.runtime_symbols[sym_id])
}

#Inline(Always) patch_make_rt_data: fn(fast: IRX64FastModule, at: Int, sym_id: Int) -> X64Reloc Never! {
    if fast.use_indexed_rt -> x64_reloc_runtime_data_id(at, sym_id) else -> x64_reloc_runtime_data(at, fast.runtime_symbols[sym_id])
}

#Inline(Always) patch_reloc_rt_id: fn(p: &IRPatchEmitter, fast: IRX64FastModule, at: Int, sym_id: Int) Never! {
    p.relocs.push(patch_make_rt(fast, at, sym_id))
}

#Inline(Always) patch_reloc_rt_data_id: fn(p: &IRPatchEmitter, fast: IRX64FastModule, at: Int, sym_id: Int) Never! {
    p.relocs.push(patch_make_rt_data(fast, at, sym_id))
}

#Inline(Always) patch_make_rt_name: fn(fast: IRX64FastModule, m: IRModule, at: Int, name_row: Int) -> X64Reloc Never! {
    sid: fast.name_rt_sym_id[name_row]
    if sid >= 0 -> patch_make_rt(fast, at, sid) else -> x64_reloc_runtime(at, m.names[name_row])
}

// ---------------------------------------------------------------------------
// Stencil-backed register load, store, move, immediate, normalize & branch.

patch_mov_ri: fn(p: &IRPatchEmitter, reg: Int, value: Int) Never! {
    patch_ensure(p, 10)
    if reg == 0 -> p.rax_slot = -1
    if value >= 0 && value <= 4294967295 {
        p.pos = if reg == {
            0 -> o0_st_mov32_rax_i32(p.code, p.pos, value)
            1 -> o0_st_mov32_rcx_i32(p.code, p.pos, value)
            2 -> o0_st_mov32_rdx_i32(p.code, p.pos, value)
            6 -> o0_st_mov32_rsi_i32(p.code, p.pos, value)
            7 -> o0_st_mov32_rdi_i32(p.code, p.pos, value)
            8 -> o0_st_mov32_r8_i32(p.code, p.pos, value)
            9 -> o0_st_mov32_r9_i32(p.code, p.pos, value)
            10 -> o0_st_mov32_r10_i32(p.code, p.pos, value)
            else -> o0_st_mov32_r11_i32(p.code, p.pos, value)
        }
        return
    }
    p.pos = if reg == {
        0 -> o0_st_mov64_rax_i64(p.code, p.pos, value)
        1 -> o0_st_mov64_rcx_i64(p.code, p.pos, value)
        2 -> o0_st_mov64_rdx_i64(p.code, p.pos, value)
        6 -> o0_st_mov64_rsi_i64(p.code, p.pos, value)
        7 -> o0_st_mov64_rdi_i64(p.code, p.pos, value)
        8 -> o0_st_mov64_r8_i64(p.code, p.pos, value)
        9 -> o0_st_mov64_r9_i64(p.code, p.pos, value)
        10 -> o0_st_mov64_r10_i64(p.code, p.pos, value)
        else -> o0_st_mov64_r11_i64(p.code, p.pos, value)
    }
}

patch_lea_rbp: fn(p: &IRPatchEmitter, reg: Int, disp: Int) Never! {
    patch_ensure(p, 8)
    if reg == 0 -> p.rax_slot = -1
    if patch_fits_i8(disp) {
        p.pos = if reg == {
            0 -> o0_st_lea_rax_8(p.code, p.pos, disp)
            1 -> o0_st_lea_rcx_8(p.code, p.pos, disp)
            2 -> o0_st_lea_rdx_8(p.code, p.pos, disp)
            6 -> o0_st_lea_rsi_8(p.code, p.pos, disp)
            7 -> o0_st_lea_rdi_8(p.code, p.pos, disp)
            8 -> o0_st_lea_r8_8(p.code, p.pos, disp)
            9 -> o0_st_lea_r9_8(p.code, p.pos, disp)
            10 -> o0_st_lea_r10_8(p.code, p.pos, disp)
            else -> o0_st_lea_r11_8(p.code, p.pos, disp)
        }
        return
    }
    p.pos = if reg == {
        0 -> o0_st_lea_rax_32(p.code, p.pos, disp)
        1 -> o0_st_lea_rcx_32(p.code, p.pos, disp)
        2 -> o0_st_lea_rdx_32(p.code, p.pos, disp)
        6 -> o0_st_lea_rsi_32(p.code, p.pos, disp)
        7 -> o0_st_lea_rdi_32(p.code, p.pos, disp)
        8 -> o0_st_lea_r8_32(p.code, p.pos, disp)
        9 -> o0_st_lea_r9_32(p.code, p.pos, disp)
        10 -> o0_st_lea_r10_32(p.code, p.pos, disp)
        else -> o0_st_lea_r11_32(p.code, p.pos, disp)
    }
}

patch_load_rbp: fn(p: &IRPatchEmitter, reg: Int, disp: Int) Never! {
    patch_ensure(p, 8)
    if disp == 0 {
        if reg == 0 -> p.rax_slot = -1
        p.pos = if reg == {
            0 -> o0_st_zero_rax(p.code, p.pos)
            1 -> o0_st_zero_rcx(p.code, p.pos)
            2 -> o0_st_zero_rdx(p.code, p.pos)
            6 -> o0_st_zero_rsi(p.code, p.pos)
            7 -> o0_st_zero_rdi(p.code, p.pos)
            8 -> o0_st_zero_r8(p.code, p.pos)
            9 -> o0_st_zero_r9(p.code, p.pos)
            10 -> o0_st_zero_r10(p.code, p.pos)
            else -> o0_st_zero_r11(p.code, p.pos)
        }
        return
    }
    if patch_fits_i8(disp) {
        p.pos = if reg == {
            0 -> o0_st_load_rax_8(p.code, p.pos, disp)
            1 -> o0_st_load_rcx_8(p.code, p.pos, disp)
            2 -> o0_st_load_rdx_8(p.code, p.pos, disp)
            6 -> o0_st_load_rsi_8(p.code, p.pos, disp)
            7 -> o0_st_load_rdi_8(p.code, p.pos, disp)
            8 -> o0_st_load_r8_8(p.code, p.pos, disp)
            9 -> o0_st_load_r9_8(p.code, p.pos, disp)
            10 -> o0_st_load_r10_8(p.code, p.pos, disp)
            else -> o0_st_load_r11_8(p.code, p.pos, disp)
        }
        return
    }
    p.pos = if reg == {
        0 -> o0_st_load_rax_32(p.code, p.pos, disp)
        1 -> o0_st_load_rcx_32(p.code, p.pos, disp)
        2 -> o0_st_load_rdx_32(p.code, p.pos, disp)
        6 -> o0_st_load_rsi_32(p.code, p.pos, disp)
        7 -> o0_st_load_rdi_32(p.code, p.pos, disp)
        8 -> o0_st_load_r8_32(p.code, p.pos, disp)
        9 -> o0_st_load_r9_32(p.code, p.pos, disp)
        10 -> o0_st_load_r10_32(p.code, p.pos, disp)
        else -> o0_st_load_r11_32(p.code, p.pos, disp)
    }
}

patch_load_slot: fn(p: &IRPatchEmitter, reg: Int, slot: Int) Never! {
    if patch_is_const(p, slot) {
        patch_mov_ri(p, reg, p.const_val[slot])
        return
    }
    if reg == 0 {
        if p.rax_slot == slot -> return
        h: p.homes[slot]
        patch_load_rbp(p, 0, h)
        p.rax_slot = if h != 0 -> slot else -> -1
        return
    }
    patch_load_rbp(p, reg, p.homes[slot])
}

patch_store_rbp: fn(p: &IRPatchEmitter, disp: Int, reg: Int) Never! {
    if disp == 0 -> return
    patch_ensure(p, 8)
    if patch_fits_i8(disp) {
        p.pos = if reg == {
            0 -> o0_st_store_rax_8(p.code, p.pos, disp)
            1 -> o0_st_store_rcx_8(p.code, p.pos, disp)
            2 -> o0_st_store_rdx_8(p.code, p.pos, disp)
            6 -> o0_st_store_rsi_8(p.code, p.pos, disp)
            7 -> o0_st_store_rdi_8(p.code, p.pos, disp)
            8 -> o0_st_store_r8_8(p.code, p.pos, disp)
            9 -> o0_st_store_r9_8(p.code, p.pos, disp)
            10 -> o0_st_store_r10_8(p.code, p.pos, disp)
            else -> o0_st_store_r11_8(p.code, p.pos, disp)
        }
        return
    }
    p.pos = if reg == {
        0 -> o0_st_store_rax_32(p.code, p.pos, disp)
        1 -> o0_st_store_rcx_32(p.code, p.pos, disp)
        2 -> o0_st_store_rdx_32(p.code, p.pos, disp)
        6 -> o0_st_store_rsi_32(p.code, p.pos, disp)
        7 -> o0_st_store_rdi_32(p.code, p.pos, disp)
        8 -> o0_st_store_r8_32(p.code, p.pos, disp)
        9 -> o0_st_store_r9_32(p.code, p.pos, disp)
        10 -> o0_st_store_r10_32(p.code, p.pos, disp)
        else -> o0_st_store_r11_32(p.code, p.pos, disp)
    }
}

patch_store_slot: fn(p: &IRPatchEmitter, slot: Int, reg: Int) Never! {
    p.const_epoch[slot] = 0
    h: p.homes[slot]
    patch_store_rbp(p, h, reg)
    if reg == 0 {
        p.rax_slot = if h != 0 -> slot else -> -1
    } else if p.rax_slot == slot {
        p.rax_slot = -1
    }
}

patch_lea_rip: fn(p: &IRPatchEmitter, reg: Int) -> Int Never! {
    patch_ensure(p, 8)
    if reg == 0 -> p.rax_slot = -1
    base: p.pos
    p.pos = if reg == {
        0 -> o0_st_lea_rip_rax(p.code, base)
        1 -> o0_st_lea_rip_rcx(p.code, base)
        2 -> o0_st_lea_rip_rdx(p.code, base)
        7 -> o0_st_lea_rip_rdi(p.code, base)
        8 -> o0_st_lea_rip_r8(p.code, base)
        else -> o0_st_lea_rip_r11(p.code, base)
    }
    base + 3
}

patch_load_rip: fn(p: &IRPatchEmitter, reg: Int) -> Int Never! {
    patch_ensure(p, 8)
    if reg == 0 -> p.rax_slot = -1
    base: p.pos
    p.pos = if reg == {
        0 -> o0_st_load_rip_rax(p.code, base)
        1 -> o0_st_load_rip_rcx(p.code, base)
        else -> o0_st_load_rip_r11(p.code, base)
    }
    base + 3
}

patch_load_xmm: fn(p: &IRPatchEmitter, single: Bool, xmm: Int, disp: Int) Never! {
    patch_ensure(p, 10)
    if single {
        if patch_fits_i8(disp) {
            p.pos = if xmm == {
                0 -> o0_st_load_xmm0_f32_8(p.code, p.pos, disp)
                1 -> o0_st_load_xmm1_f32_8(p.code, p.pos, disp)
                2 -> o0_st_load_xmm2_f32_8(p.code, p.pos, disp)
                3 -> o0_st_load_xmm3_f32_8(p.code, p.pos, disp)
                4 -> o0_st_load_xmm4_f32_8(p.code, p.pos, disp)
                5 -> o0_st_load_xmm5_f32_8(p.code, p.pos, disp)
                6 -> o0_st_load_xmm6_f32_8(p.code, p.pos, disp)
                else -> o0_st_load_xmm7_f32_8(p.code, p.pos, disp)
            }
            return
        }
        p.pos = if xmm == {
            0 -> o0_st_load_xmm0_f32_32(p.code, p.pos, disp)
            1 -> o0_st_load_xmm1_f32_32(p.code, p.pos, disp)
            2 -> o0_st_load_xmm2_f32_32(p.code, p.pos, disp)
            3 -> o0_st_load_xmm3_f32_32(p.code, p.pos, disp)
            4 -> o0_st_load_xmm4_f32_32(p.code, p.pos, disp)
            5 -> o0_st_load_xmm5_f32_32(p.code, p.pos, disp)
            6 -> o0_st_load_xmm6_f32_32(p.code, p.pos, disp)
            else -> o0_st_load_xmm7_f32_32(p.code, p.pos, disp)
        }
        return
    }
    if patch_fits_i8(disp) {
        p.pos = if xmm == {
            0 -> o0_st_load_xmm0_f64_8(p.code, p.pos, disp)
            1 -> o0_st_load_xmm1_f64_8(p.code, p.pos, disp)
            2 -> o0_st_load_xmm2_f64_8(p.code, p.pos, disp)
            3 -> o0_st_load_xmm3_f64_8(p.code, p.pos, disp)
            4 -> o0_st_load_xmm4_f64_8(p.code, p.pos, disp)
            5 -> o0_st_load_xmm5_f64_8(p.code, p.pos, disp)
            6 -> o0_st_load_xmm6_f64_8(p.code, p.pos, disp)
            else -> o0_st_load_xmm7_f64_8(p.code, p.pos, disp)
        }
        return
    }
    p.pos = if xmm == {
        0 -> o0_st_load_xmm0_f64_32(p.code, p.pos, disp)
        1 -> o0_st_load_xmm1_f64_32(p.code, p.pos, disp)
        2 -> o0_st_load_xmm2_f64_32(p.code, p.pos, disp)
        3 -> o0_st_load_xmm3_f64_32(p.code, p.pos, disp)
        4 -> o0_st_load_xmm4_f64_32(p.code, p.pos, disp)
        5 -> o0_st_load_xmm5_f64_32(p.code, p.pos, disp)
        6 -> o0_st_load_xmm6_f64_32(p.code, p.pos, disp)
        else -> o0_st_load_xmm7_f64_32(p.code, p.pos, disp)
    }
}

patch_store_xmm: fn(p: &IRPatchEmitter, single: Bool, disp: Int, xmm: Int) Never! {
    if disp == 0 -> return
    patch_ensure(p, 24)
    if single {
        if patch_fits_i8(disp) {
            p.pos = o0_st_const_i32_8(p.code, p.pos, disp, 0)
            p.pos = if xmm == {
                0 -> o0_st_store_xmm0_f32_8(p.code, p.pos, disp)
                1 -> o0_st_store_xmm1_f32_8(p.code, p.pos, disp)
                2 -> o0_st_store_xmm2_f32_8(p.code, p.pos, disp)
                3 -> o0_st_store_xmm3_f32_8(p.code, p.pos, disp)
                4 -> o0_st_store_xmm4_f32_8(p.code, p.pos, disp)
                5 -> o0_st_store_xmm5_f32_8(p.code, p.pos, disp)
                6 -> o0_st_store_xmm6_f32_8(p.code, p.pos, disp)
                else -> o0_st_store_xmm7_f32_8(p.code, p.pos, disp)
            }
            return
        }
        p.pos = o0_st_const_i32_32(p.code, p.pos, disp, 0)
        p.pos = if xmm == {
            0 -> o0_st_store_xmm0_f32_32(p.code, p.pos, disp)
            1 -> o0_st_store_xmm1_f32_32(p.code, p.pos, disp)
            2 -> o0_st_store_xmm2_f32_32(p.code, p.pos, disp)
            3 -> o0_st_store_xmm3_f32_32(p.code, p.pos, disp)
            4 -> o0_st_store_xmm4_f32_32(p.code, p.pos, disp)
            5 -> o0_st_store_xmm5_f32_32(p.code, p.pos, disp)
            6 -> o0_st_store_xmm6_f32_32(p.code, p.pos, disp)
            else -> o0_st_store_xmm7_f32_32(p.code, p.pos, disp)
        }
        return
    }
    if patch_fits_i8(disp) {
        p.pos = if xmm == {
            0 -> o0_st_store_xmm0_f64_8(p.code, p.pos, disp)
            1 -> o0_st_store_xmm1_f64_8(p.code, p.pos, disp)
            2 -> o0_st_store_xmm2_f64_8(p.code, p.pos, disp)
            3 -> o0_st_store_xmm3_f64_8(p.code, p.pos, disp)
            4 -> o0_st_store_xmm4_f64_8(p.code, p.pos, disp)
            5 -> o0_st_store_xmm5_f64_8(p.code, p.pos, disp)
            6 -> o0_st_store_xmm6_f64_8(p.code, p.pos, disp)
            else -> o0_st_store_xmm7_f64_8(p.code, p.pos, disp)
        }
        return
    }
    p.pos = if xmm == {
        0 -> o0_st_store_xmm0_f64_32(p.code, p.pos, disp)
        1 -> o0_st_store_xmm1_f64_32(p.code, p.pos, disp)
        2 -> o0_st_store_xmm2_f64_32(p.code, p.pos, disp)
        3 -> o0_st_store_xmm3_f64_32(p.code, p.pos, disp)
        4 -> o0_st_store_xmm4_f64_32(p.code, p.pos, disp)
        5 -> o0_st_store_xmm5_f64_32(p.code, p.pos, disp)
        6 -> o0_st_store_xmm6_f64_32(p.code, p.pos, disp)
        else -> o0_st_store_xmm7_f64_32(p.code, p.pos, disp)
    }
}

patch_alu_rax_imm: fn(p: &IRPatchEmitter, ext: Int, imm: Int) Never! {
    patch_ensure(p, 8)
    if ext != 7 -> p.rax_slot = -1
    if patch_fits_i8(imm) {
        p.pos = if ext == {
            0 -> o0_st_add_rax_i8(p.code, p.pos, imm)
            1 -> o0_st_or_rax_i8(p.code, p.pos, imm)
            4 -> o0_st_and_rax_i8(p.code, p.pos, imm)
            5 -> o0_st_sub_rax_i8(p.code, p.pos, imm)
            6 -> o0_st_xor_rax_i8(p.code, p.pos, imm)
            else -> o0_st_cmp_rax_i8(p.code, p.pos, imm)
        }
        return
    }
    p.pos = if ext == {
        0 -> o0_st_add_rax_i32(p.code, p.pos, imm)
        1 -> o0_st_or_rax_i32(p.code, p.pos, imm)
        4 -> o0_st_and_rax_i32(p.code, p.pos, imm)
        5 -> o0_st_sub_rax_i32(p.code, p.pos, imm)
        6 -> o0_st_xor_rax_i32(p.code, p.pos, imm)
        else -> o0_st_cmp_rax_i32(p.code, p.pos, imm)
    }
}

patch_narrow: fn(p: &IRPatchEmitter, reg: Int, signed: Bool, bits: Int) Never! {
    if bits <= 0 || bits >= 64 -> return
    patch_ensure(p, 10)
    if reg == 0 -> p.rax_slot = -1
    sh: 64 - bits
    if signed {
        p.pos = if reg == {
            0 -> o0_st_narrow_s_rax(p.code, p.pos, sh)
            1 -> o0_st_narrow_s_rcx(p.code, p.pos, sh)
            2 -> o0_st_narrow_s_rdx(p.code, p.pos, sh)
            6 -> o0_st_narrow_s_rsi(p.code, p.pos, sh)
            7 -> o0_st_narrow_s_rdi(p.code, p.pos, sh)
            8 -> o0_st_narrow_s_r8(p.code, p.pos, sh)
            else -> o0_st_narrow_s_r9(p.code, p.pos, sh)
        }
        return
    }
    p.pos = if reg == {
        0 -> o0_st_narrow_u_rax(p.code, p.pos, sh)
        1 -> o0_st_narrow_u_rcx(p.code, p.pos, sh)
        2 -> o0_st_narrow_u_rdx(p.code, p.pos, sh)
        6 -> o0_st_narrow_u_rsi(p.code, p.pos, sh)
        7 -> o0_st_narrow_u_rdi(p.code, p.pos, sh)
        8 -> o0_st_narrow_u_r8(p.code, p.pos, sh)
        else -> o0_st_narrow_u_r9(p.code, p.pos, sh)
    }
}

patch_normalize_row: fn(p: &IRPatchEmitter, fast: IRX64FastModule, type_row: Int, reg: Int) Never! {
    k: fast.type_kind[type_row]
    if k == O0_KIND_BOOL {
        patch_ensure(p, 6)
        if reg == 0 -> p.rax_slot = -1
        p.pos = if reg == {
            0 -> o0_st_movzx8_rax(p.code, p.pos)
            1 -> o0_st_movzx8_rcx(p.code, p.pos)
            2 -> o0_st_movzx8_rdx(p.code, p.pos)
            6 -> o0_st_movzx8_rsi(p.code, p.pos)
            7 -> o0_st_movzx8_rdi(p.code, p.pos)
            8 -> o0_st_movzx8_r8(p.code, p.pos)
            else -> o0_st_movzx8_r9(p.code, p.pos)
        }
        return
    }
    if k == O0_KIND_WORD {
        patch_narrow(p, reg, fast.type_signed[type_row], fast.type_bits[type_row])
        return
    }
    if k == O0_KIND_FLOAT32 -> patch_narrow(p, reg, false, 32)
}

#Inline(Always) patch_jmp: fn(p: &IRPatchEmitter) -> Int Never! {
    patch_ensure(p, 6)
    base: p.pos
    p.pos = o0_st_jmp_rel32(p.code, base)
    base + 1
}

#Inline(Always) patch_jmp_to: fn(p: &IRPatchEmitter, target: Int) Never! {
    site: patch_jmp(p)
    patch_rel32(p.code, site, target)
}

#Inline(Always) patch_jcc: fn(p: &IRPatchEmitter, cc: Int) -> Int Never! {
    patch_ensure(p, 6)
    base: p.pos
    p.pos = o0_st_jcc_rel32(p.code, base, cc)
    base + 2
}

// Copies `size` bytes from [rdx] to [rax]. Clobbers rax/rcx/rdx/rsi/rdi/r11.
patch_copy_bytes_rdx_to_rax: fn(p: &IRPatchEmitter, size: Int) Never! {
    if size <= 0 -> return
    p.rax_slot = -1
    if size > 64 {
        patch_ensure(p, 24)
        p.pos = o0_st_mov_rsi_rdx(p.code, p.pos)
        p.pos = o0_st_mov_rdi_rax(p.code, p.pos)
        patch_mov_ri(p, 1, size)
        patch_ensure(p, 4)
        p.pos = o0_st_rep_movsb(p.code, p.pos)
        return
    }
    off := 0
    loop off + 8 <= size {
        patch_ensure(p, 16)
        if off == 0 {
            p.pos = o0_st_copy8_0(p.code, p.pos)
        } else if patch_fits_i8(off) {
            p.pos = o0_st_copy8_8(p.code, p.pos, off)
        } else {
            p.pos = o0_st_copy8_32(p.code, p.pos, off)
        }
        off += 8
    }
    loop off < size {
        patch_ensure(p, 16)
        if off == 0 {
            p.pos = o0_st_copy1_0(p.code, p.pos)
        } else if patch_fits_i8(off) {
            p.pos = o0_st_copy1_8(p.code, p.pos, off)
        } else {
            p.pos = o0_st_copy1_32(p.code, p.pos, off)
        }
        off += 1
    }
}

// ---------------------------------------------------------------------------
// Flat SoA cold-record construction (zero heap allocations).

patch_cold_new: fn(kind: IRX64ColdKind, site_start: Int, site_len: Int) -> IRPatchCold Never! {
    IRPatchCold{
        kind: kind,
        site_start: site_start,
        site_len: site_len,
        resume: -1,
        sym_id: -1,
        left: -1,
        right: -1,
        right_imm: 0,
        right_nonzero_const: false,
        dst: -1,
        cc: 0,
        text: -1,
        direction: 0,
        unsigned: 0,
        width: 0,
        line: 0,
        pad: -1,
        at: -1,
    }
}

patch_stop_if: fn(p: &IRPatchEmitter, f: IRFunction, at: Int, cc: Int, stop_kind: Int) Never! {
    s_start: p.cold_sites.len()
    p.cold_sites.push(patch_jcc(p, cc))
    cold := patch_cold_new(IRX64ColdKind.Stop, s_start, 1)
    cold.text = patch_stop_text(p, stop_kind)
    cold.line = ir_code_line_source(f.code_line[at])
    cold.at = at
    p.colds.push(cold)
}

patch_cc: fn(op: IROp, unsigned: Bool) -> Int Never! {
    if op == {
        .Eq -> 4
        .Ne -> 5
        .Lt -> if unsigned -> 2 else -> 12
        .Le -> if unsigned -> 6 else -> 14
        .Gt -> if unsigned -> 7 else -> 15
        .Ge -> if unsigned -> 3 else -> 13
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> 4
    }
}

patch_call_out: fn(p: &IRPatchEmitter, f: IRFunction, target: X64Reloc, indirect: Bool, alloc_row: Int) Never! {
    patch_ensure(p, 12)
    p.rax_slot = -1
    if p.has_stream -> p.pos = o0_st_sfence(p.code, p.pos)
    start: p.pos
    if indirect {
        p.dynamic = true
        p.pos = o0_st_call_r10(p.code, p.pos)
    } else {
        base: p.pos
        p.pos = o0_st_call_rel32(p.code, base)
        p.relocs.push(X64Reloc{at: base + 1, kind: target.kind, target: target.target, symbol: target.symbol})
        if alloc_row >= 0 {
            p.alloc_relocs.push(p.relocs.len() - 1)
            p.alloc_rows.push(alloc_row)
        }
    }
    at: p.at
    if at >= 0 && at < f.code_line.len() {
        row: ir_code_line_call(f.code_line[at])
        word: IR_CALL_SITE_WORDS * (row - 1)
        if row != 0 && word + 1 < f.call_sites.len() {
            p.call_rows.push(X64LineRow{at: start, line: f.call_sites[word], column: f.call_sites[word + 1], call: true})
            p.call_returns.push(p.pos)
        }
    }
}

// Absorbs immediately following exact-Int Drop instructions of `at`'s operands
// (when the hot path already proved them inline, their Drop is a no-op on the
// hot path and only runs in the cold slow path!).
patch_operand_drops: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int) -> {d0: Int, d1: Int, end_at: Int} Never! {
    d0 := -1
    d1 := -1
    end_at := at
    next_at := at + 1
    loop next_at < f.op.len() && f.op[next_at] == .Drop {
        slot: f.a[next_at]
        if (slot != f.a[at] && slot != f.b[at]) || slot == f.dst[at] || slot == d0 || slot == d1 {
            break
        }
        trow: f.slot_type[slot]
        if fast.type_kind[trow] != O0_KIND_INT || !fast.type_has_drop[trow] -> break
        if d0 < 0 -> d0 = slot else -> d1 = slot
        end_at = next_at
        next_at += 1
    }
    if end_at > at -> p.skip_to = end_at
    {d0: d0, d1: d1, end_at: end_at}
}

patch_located_stops_cold: fn(f: IRFunction, cold: IRPatchCold) -> Bool Never! {
    if cold.at < 0 || cold.right < 0 || !cold.right_nonzero_const -> return true
    op: f.op[cold.at]
    if op == .Div || op == .Rem || op == .FloorDiv || op == .Mod -> return false
    true
}

// ---------------------------------------------------------------------------
// Call, tail jump, memory, arithmetic, control emitters.

patch_call: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, target: X64Reloc, indirect: Int, args: [Int], start: Int, count: Int, dst: Int, alloc_row: Int) Never! {
    sret := false
    storage := 0
    if dst >= 0 {
        dst_trow: f.slot_type[dst]
        if fast.type_kind[dst_trow] == O0_KIND_AGGREGATE {
            sret = true
            a0: fast.type_align[dst_trow]
            align: if a0 > 16 -> 16 else if a0 < 8 -> 8 else -> a0
            p.depth = ir_x64_align(p.depth + ir_x64_align(fast.type_size[dst_trow], 8), align)
            storage = 0 - p.depth
        }
    }
    general := if sret -> 1 else -> 0
    floats := 0
    if p.call_places.len() > 0 -> p.call_places.clear()
    if p.call_stacked.len() > 0 -> p.call_stacked.clear()
    loop pos in start..<(start + count) {
        cls: fast.type_class[f.slot_type[args[pos]]]
        if cls == O0_CLS_EMPTY {
            p.call_places.push(-2)
            next
        }
        if cls == O0_CLS_FLOAT && floats < 8 {
            p.call_places.push(16 + floats)
            floats += 1
            next
        }
        if cls != O0_CLS_FLOAT && general < 6 {
            p.call_places.push(IR_X64_ARGUMENT_REGISTERS[general])
            general += 1
            next
        }
        p.call_places.push(-1)
        p.call_stacked.push(pos)
    }
    n_stacked: p.call_stacked.len()
    pad: n_stacked % 2
    pushed_bytes: 8 * (n_stacked + pad)
    if pushed_bytes > p.below -> p.below = pushed_bytes
    if pad == 1 {
        patch_ensure(p, 4)
        p.pos = o0_st_sub_rsp_i8(p.code, p.pos, 8)
    }
    idx := n_stacked - 1
    loop idx >= 0 {
        patch_load_slot(p, 11, args[p.call_stacked[idx]])
        patch_ensure(p, 4)
        p.pos = o0_st_push_r11(p.code, p.pos)
        idx -= 1
    }
    loop row in 0..<p.call_places.len() {
        place: p.call_places[row]
        slot: args[start + row]
        if place >= 16 {
            patch_load_xmm(p, fast.type_kind[f.slot_type[slot]] == O0_KIND_FLOAT32, place - 16, p.homes[slot])
        } else if place >= 0 {
            patch_load_slot(p, place, slot)
        }
    }
    if sret -> patch_lea_rbp(p, 7, storage)
    if indirect >= 0 -> patch_load_slot(p, 10, indirect)
    patch_call_out(p, f, target, indirect >= 0, alloc_row)
    if pushed_bytes > 0 {
        patch_ensure(p, 8)
        if patch_fits_i8(pushed_bytes) {
            p.pos = o0_st_add_rsp_i8(p.code, p.pos, pushed_bytes)
        } else {
            p.pos = o0_st_add_rsp_i32(p.code, p.pos, pushed_bytes)
        }
    }
    if dst < 0 -> return
    if sret {
        patch_lea_rbp(p, 0, storage)
        patch_store_slot(p, dst, 0)
        return
    }
    dst_trow: f.slot_type[dst]
    cls: fast.type_class[dst_trow]
    if cls == O0_CLS_GENERAL {
        patch_normalize_row(p, fast, dst_trow, 0)
        patch_store_slot(p, dst, 0)
    } else if cls == O0_CLS_FLOAT {
        p.const_epoch[dst] = 0
        patch_store_xmm(p, fast.type_kind[dst_trow] == O0_KIND_FLOAT32, p.homes[dst], 0)
    }
}

patch_tail_jump: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int) Never! {
    general := 0
    floats := 0
    loop pos in f.b[at]..<(f.b[at] + f.c[at]) {
        slot: f.args[pos]
        trow: f.slot_type[slot]
        cls: fast.type_class[trow]
        if cls == O0_CLS_EMPTY -> next
        if cls == O0_CLS_FLOAT {
            if floats >= 8 {
                p.errors.push("{f.name}: tail call with a stack argument")
                return
            }
            patch_load_xmm(p, fast.type_kind[trow] == O0_KIND_FLOAT32, floats, p.homes[slot])
            floats += 1
            next
        }
        if general >= 6 {
            p.errors.push("{f.name}: tail call with a stack argument")
            return
        }
        patch_load_slot(p, IR_X64_ARGUMENT_REGISTERS[general], slot)
        general += 1
    }
    patch_ensure(p, 12)
    if p.has_stream -> p.pos = o0_st_sfence(p.code, p.pos)
    p.pos = o0_st_leave(p.code, p.pos)
    p.tails.push(p.pos)
    site: patch_jmp(p)
    patch_reloc_fn(p, site, f.a[at])
    p.rax_slot = -1
}

patch_emit_load: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int) Never! {
    dst: f.dst[at]
    trow: f.slot_type[dst]
    k: fast.type_kind[trow]
    if k == O0_KIND_UNIT -> return
    off: f.b[at]
    if !x64_fits_i32(off) {
        p.errors.push("{f.name}: offset {off} does not fit a displacement")
        return
    }
    patch_load_slot(p, 0, f.a[at])
    patch_ensure(p, 12)
    p.rax_slot = -1
    sz: fast.type_size[trow]
    width: if k == O0_KIND_BOOL -> 1 else if k == O0_KIND_FLOAT32 -> 4 else if k == O0_KIND_WORD && (sz == 1 || sz == 2 || sz == 4) -> sz else -> 8
    signed: k == O0_KIND_WORD && fast.type_signed[trow]
    if width == 8 {
        if off == 0 -> p.pos = o0_st_load_field_i64_0(p.code, p.pos)
        else if patch_fits_i8(off) -> p.pos = o0_st_load_field_i64_8(p.code, p.pos, off)
        else -> p.pos = o0_st_load_field_i64_32(p.code, p.pos, off)
    } else if width == 4 {
        if signed {
            if off == 0 -> p.pos = o0_st_load_field_i32_0(p.code, p.pos)
            else if patch_fits_i8(off) -> p.pos = o0_st_load_field_i32_8(p.code, p.pos, off)
            else -> p.pos = o0_st_load_field_i32_32(p.code, p.pos, off)
        } else {
            if off == 0 -> p.pos = o0_st_load_field_u32_0(p.code, p.pos)
            else if patch_fits_i8(off) -> p.pos = o0_st_load_field_u32_8(p.code, p.pos, off)
            else -> p.pos = o0_st_load_field_u32_32(p.code, p.pos, off)
        }
    } else if width == 2 {
        if signed {
            if off == 0 -> p.pos = o0_st_load_field_i16_0(p.code, p.pos)
            else if patch_fits_i8(off) -> p.pos = o0_st_load_field_i16_8(p.code, p.pos, off)
            else -> p.pos = o0_st_load_field_i16_32(p.code, p.pos, off)
        } else {
            if off == 0 -> p.pos = o0_st_load_field_u16_0(p.code, p.pos)
            else if patch_fits_i8(off) -> p.pos = o0_st_load_field_u16_8(p.code, p.pos, off)
            else -> p.pos = o0_st_load_field_u16_32(p.code, p.pos, off)
        }
    } else {
        if signed {
            if off == 0 -> p.pos = o0_st_load_field_i8_0(p.code, p.pos)
            else if patch_fits_i8(off) -> p.pos = o0_st_load_field_i8_8(p.code, p.pos, off)
            else -> p.pos = o0_st_load_field_i8_32(p.code, p.pos, off)
        } else {
            if off == 0 -> p.pos = o0_st_load_field_u8_0(p.code, p.pos)
            else if patch_fits_i8(off) -> p.pos = o0_st_load_field_u8_8(p.code, p.pos, off)
            else -> p.pos = o0_st_load_field_u8_32(p.code, p.pos, off)
        }
    }
    patch_store_slot(p, dst, 0)
    if k == O0_KIND_FLOAT || k == O0_KIND_FLOAT32 -> p.rax_slot = -1
}

patch_emit_store: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int, stream: Bool) Never! {
    val: f.c[at]
    trow: f.slot_type[val]
    k: fast.type_kind[trow]
    if k == O0_KIND_UNIT -> return
    off: f.b[at]
    if !x64_fits_i32(off) {
        p.errors.push("{f.name}: offset {off} does not fit a displacement")
        return
    }
    patch_load_slot(p, 0, f.a[at])
    patch_load_slot(p, 1, val)
    patch_ensure(p, 12)
    sz: fast.type_size[trow]
    width: if k == O0_KIND_BOOL -> 1 else if k == O0_KIND_FLOAT32 -> 4 else if k == O0_KIND_WORD && (sz == 1 || sz == 2 || sz == 4) -> sz else -> 8
    if stream && (width == 8 || width == 4) {
        p.has_stream = true
        if width == 8 {
            if off == 0 -> p.pos = o0_st_movnti_0(p.code, p.pos)
            else if patch_fits_i8(off) -> p.pos = o0_st_movnti_8(p.code, p.pos, off)
            else -> p.pos = o0_st_movnti_32(p.code, p.pos, off)
        } else {
            if off == 0 -> p.pos = o0_st_movnti4_0(p.code, p.pos)
            else if patch_fits_i8(off) -> p.pos = o0_st_movnti4_8(p.code, p.pos, off)
            else -> p.pos = o0_st_movnti4_32(p.code, p.pos, off)
        }
        return
    }
    if width == 8 {
        if off == 0 -> p.pos = o0_st_store_field_8_0(p.code, p.pos)
        else if patch_fits_i8(off) -> p.pos = o0_st_store_field_8_8(p.code, p.pos, off)
        else -> p.pos = o0_st_store_field_8_32(p.code, p.pos, off)
    } else if width == 4 {
        if off == 0 -> p.pos = o0_st_store_field_4_0(p.code, p.pos)
        else if patch_fits_i8(off) -> p.pos = o0_st_store_field_4_8(p.code, p.pos, off)
        else -> p.pos = o0_st_store_field_4_32(p.code, p.pos, off)
    } else if width == 2 {
        if off == 0 -> p.pos = o0_st_store_field_2_0(p.code, p.pos)
        else if patch_fits_i8(off) -> p.pos = o0_st_store_field_2_8(p.code, p.pos, off)
        else -> p.pos = o0_st_store_field_2_32(p.code, p.pos, off)
    } else {
        if off == 0 -> p.pos = o0_st_store_field_1_0(p.code, p.pos)
        else if patch_fits_i8(off) -> p.pos = o0_st_store_field_1_8(p.code, p.pos, off)
        else -> p.pos = o0_st_store_field_1_32(p.code, p.pos, off)
    }
}

patch_floor_adjust: fn(p: &IRPatchEmitter, op: IROp) Never! {
    patch_ensure(p, 32)
    p.pos = o0_st_test_rdx_rdx(p.code, p.pos)
    exact: patch_jcc(p, 4)
    p.pos = o0_st_mov_r11_rdx(p.code, p.pos)
    p.pos = o0_st_xor_r11_rcx(p.code, p.pos)
    same: patch_jcc(p, 9)
    if op == .FloorDiv {
        p.pos = o0_st_sub_rax_i8(p.code, p.pos, 1)
    } else {
        p.pos = o0_st_add_rdx_rcx(p.code, p.pos)
    }
    done: p.pos
    patch_rel32(p.code, exact, done)
    patch_rel32(p.code, same, done)
}

patch_range_check: fn(p: &IRPatchEmitter, f: IRFunction, at: Int, signed: Bool, bits: Int, stop_kind: Int) Never! {
    patch_ensure(p, 24)
    p.pos = o0_st_mov_rdx_rax(p.code, p.pos)
    patch_narrow(p, 2, signed, bits)
    patch_ensure(p, 12)
    p.pos = o0_st_cmp_rdx_rax(p.code, p.pos)
    patch_stop_if(p, f, at, 5, stop_kind)
}

patch_word_binary: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int, kind: U8, signed: Bool, bits: Int, positive_div: Bool) Never! {
    op: f.op[at]
    sa: f.a[at]
    sb: f.b[at]
    dst: f.dst[at]
    hb: p.homes[sb]
    unsigned: kind == O0_KIND_BOOL || kind == O0_KIND_CHAR || kind == O0_KIND_POINTER || (kind == O0_KIND_WORD && !signed)
    if op == .Eq || op == .Ne || op == .Lt || op == .Le || op == .Gt || op == .Ge {
        cc: patch_cc(op, unsigned)
        patch_load_slot(p, 0, sa)
        if patch_is_const(p, sb) && x64_fits_i32(p.const_val[sb]) {
            v: p.const_val[sb]
            if v == 0 {
                patch_ensure(p, 4)
                p.pos = o0_st_test_rax_rax(p.code, p.pos)
            } else {
                patch_alu_rax_imm(p, 7, v)
            }
        } else if !patch_is_const(p, sb) && hb != 0 {
            patch_ensure(p, 8)
            if patch_fits_i8(hb) -> p.pos = o0_st_cmp_rax_m8(p.code, p.pos, hb)
            else -> p.pos = o0_st_cmp_rax_m32(p.code, p.pos, hb)
        } else {
            patch_load_slot(p, 1, sb)
            patch_ensure(p, 4)
            p.pos = o0_st_cmp_rax_rcx(p.code, p.pos)
        }
        patch_ensure(p, 8)
        p.pos = o0_st_setcc_rax(p.code, p.pos, cc)
        p.rax_slot = -1
        patch_store_slot(p, dst, 0)
        p.fused_slot = dst
        p.fused_cc = cc
        return
    }
    trap: f.c[at] != IR_OVERFLOW_WRAP && f.c[at] != IR_OVERFLOW_NONNEG
    has_imm: patch_is_const(p, sb) && x64_fits_i32(p.const_val[sb])
    if (op == .BitAnd || op == .BitOr || op == .BitXor) || ((op == .Add || op == .Sub) && bits == 64 && !trap) {
        patch_load_slot(p, 0, sa)
        p.rax_slot = -1
        if has_imm {
            ext: if op == .Add -> 0 else if op == .Sub -> 5 else if op == .BitAnd -> 4 else if op == .BitOr -> 1 else -> 6
            patch_alu_rax_imm(p, ext, p.const_val[sb])
        } else if !patch_is_const(p, sb) && hb != 0 {
            patch_ensure(p, 8)
            if patch_fits_i8(hb) {
                p.pos = if op == .Add -> o0_st_add_rax_m8(p.code, p.pos, hb) else if op == .Sub -> o0_st_sub_rax_m8(p.code, p.pos, hb) else if op == .BitAnd -> o0_st_and_rax_m8(p.code, p.pos, hb) else if op == .BitOr -> o0_st_or_rax_m8(p.code, p.pos, hb) else -> o0_st_xor_rax_m8(p.code, p.pos, hb)
            } else {
                p.pos = if op == .Add -> o0_st_add_rax_m32(p.code, p.pos, hb) else if op == .Sub -> o0_st_sub_rax_m32(p.code, p.pos, hb) else if op == .BitAnd -> o0_st_and_rax_m32(p.code, p.pos, hb) else if op == .BitOr -> o0_st_or_rax_m32(p.code, p.pos, hb) else -> o0_st_xor_rax_m32(p.code, p.pos, hb)
            }
        } else {
            patch_load_slot(p, 1, sb)
            patch_ensure(p, 4)
            p.pos = if op == .Add -> o0_st_add_rax_rcx(p.code, p.pos) else if op == .Sub -> o0_st_sub_rax_rcx(p.code, p.pos) else if op == .BitAnd -> o0_st_and_rax_rcx(p.code, p.pos) else if op == .BitOr -> o0_st_or_rax_rcx(p.code, p.pos) else -> o0_st_xor_rax_rcx(p.code, p.pos)
        }
        patch_store_slot(p, dst, 0)
        return
    }
    if op == .Shl || op == .Shr {
        patch_load_slot(p, 0, sa)
        p.rax_slot = -1
        if patch_is_const(p, sb) && p.const_val[sb] >= 0 && p.const_val[sb] < bits {
            cnt: p.const_val[sb] & 63
            patch_ensure(p, 6)
            if op == .Shl {
                p.pos = o0_st_shl_rax_i8(p.code, p.pos, cnt)
                patch_narrow(p, 0, !unsigned, bits)
            } else if unsigned {
                p.pos = o0_st_shr_rax_i8(p.code, p.pos, cnt)
            } else {
                p.pos = o0_st_sar_rax_i8(p.code, p.pos, cnt)
            }
            patch_store_slot(p, dst, 0)
            return
        }
        patch_load_slot(p, 1, sb)
        if trap {
            patch_ensure(p, 12)
            p.pos = o0_st_cmp_rcx_i8(p.code, p.pos, bits)
            s_start: p.cold_sites.len()
            p.cold_sites.push(patch_jcc(p, 3))
            cold := patch_cold_new(IRX64ColdKind.ShiftStop, s_start, 1)
            cold.right = sb
            cold.direction = if op == .Shl -> 0 else -> 1
            cold.unsigned = if unsigned -> 1 else -> 0
            cold.width = bits
            cold.line = ir_code_line_source(f.code_line[at])
            cold.at = at
            p.colds.push(cold)
        }
        patch_ensure(p, 4)
        if op == .Shl {
            p.pos = o0_st_shl_rax_cl(p.code, p.pos)
            patch_narrow(p, 0, !unsigned, bits)
        } else if unsigned {
            p.pos = o0_st_shr_rax_cl(p.code, p.pos)
        } else {
            p.pos = o0_st_sar_rax_cl(p.code, p.pos)
        }
        patch_store_slot(p, dst, 0)
        if trap -> p.rax_slot = -1
        return
    }
    patch_load_slot(p, 0, sa)
    p.rax_slot = -1
    if op == .Add || op == .Sub || op == .Mul {
        stop_kind: if op == .Add -> 0 else if op == .Sub -> 1 else -> 2
        if has_imm && !(op == .Mul && unsigned && bits == 64 && trap) {
            v: p.const_val[sb]
            if op == .Mul {
                patch_ensure(p, 8)
                if patch_fits_i8(v) -> p.pos = o0_st_imul_rax_i8(p.code, p.pos, v)
                else -> p.pos = o0_st_imul_rax_i32(p.code, p.pos, v)
            } else {
                patch_alu_rax_imm(p, if op == .Add -> 0 else -> 5, v)
            }
        } else {
            patch_load_slot(p, 1, sb)
            patch_ensure(p, 6)
            if op == .Add -> p.pos = o0_st_add_rax_rcx(p.code, p.pos)
            else if op == .Sub -> p.pos = o0_st_sub_rax_rcx(p.code, p.pos)
            else if unsigned && bits == 64 -> p.pos = o0_st_mul_rcx(p.code, p.pos)
            else -> p.pos = o0_st_imul_rax_rcx(p.code, p.pos)
        }
        if bits == 64 {
            if trap {
                cc: if unsigned && op != .Mul -> 2 else -> 0
                patch_stop_if(p, f, at, cc, stop_kind)
            }
        } else if trap {
            patch_range_check(p, f, at, !unsigned, bits, stop_kind)
        } else {
            patch_narrow(p, 0, !unsigned, bits)
        }
        patch_store_slot(p, dst, 0)
        if trap -> p.rax_slot = -1
        return
    }
    // Div / Rem / FloorDiv / Mod
    patch_load_slot(p, 1, sb)
    rem: op == .Rem || op == .Mod
    if positive_div {
        patch_ensure(p, 8)
        p.pos = o0_st_cqo_idiv_rcx(p.code, p.pos)
        if op == .FloorDiv || op == .Mod -> patch_floor_adjust(p, op)
        if rem -> patch_store_slot(p, dst, 2) else -> patch_store_slot(p, dst, 0)
        if rem -> p.rax_slot = -1
        return
    }
    patch_ensure(p, 8)
    p.pos = o0_st_test_rcx_rcx(p.code, p.pos)
    patch_stop_if(p, f, at, 4, 4)
    if unsigned {
        patch_ensure(p, 8)
        p.pos = o0_st_div_rcx(p.code, p.pos)
        if rem -> patch_store_slot(p, dst, 2) else -> patch_store_slot(p, dst, 0)
        p.rax_slot = -1
        return
    }
    patch_ensure(p, 12)
    p.pos = o0_st_cmp_rcx_i8(p.code, p.pos, -1)
    divide: patch_jcc(p, 5)
    if rem {
        patch_ensure(p, 4)
        p.pos = o0_st_zero_rax(p.code, p.pos)
    } else {
        if trap {
            patch_mov_ri(p, 2, ir_x64_signed_min(bits))
            patch_ensure(p, 4)
            p.pos = o0_st_cmp_rax_rdx(p.code, p.pos)
            patch_stop_if(p, f, at, 4, 3)
        }
        patch_ensure(p, 4)
        p.pos = o0_st_neg_rax(p.code, p.pos)
        patch_narrow(p, 0, true, bits)
    }
    done_jmp: patch_jmp(p)
    patch_rel32(p.code, divide, p.pos)
    patch_ensure(p, 8)
    p.pos = o0_st_cqo_idiv_rcx(p.code, p.pos)
    if op == .FloorDiv || op == .Mod -> patch_floor_adjust(p, op)
    if rem {
        patch_ensure(p, 4)
        p.pos = o0_st_mov_rax_rdx(p.code, p.pos)
    }
    patch_rel32(p.code, done_jmp, p.pos)
    patch_store_slot(p, dst, 0)
    p.rax_slot = -1
}

patch_exact_binary: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int) Never! {
    op: f.op[at]
    sa: f.a[at]
    sb: f.b[at]
    dst: f.dst[at]
    a_const: patch_is_const(p, sa)
    b_const: patch_is_const(p, sb)
    b_imm: b_const && x64_fits_i32(p.const_val[sb])
    if op == .Eq || op == .Ne || op == .Lt || op == .Le || op == .Gt || op == .Ge {
        cc: patch_cc(op, false)
        words: (op == .Eq || op == .Ne) && (a_const || b_const)
        drops: if !words && !p.in_stop_edge -> patch_operand_drops(p, fast, f, at) else -> {d0: -1, d1: -1, end_at: at}
        s_start: p.cold_sites.len()
        patch_load_slot(p, 0, sa)
        if !words && !a_const {
            patch_ensure(p, 16)
            t1: p.pos
            p.pos = o0_st_test_inline_rax(p.code, t1)
            p.cold_sites.push(t1 + 8)
        }
        if b_imm {
            v: p.const_val[sb]
            if v == 0 {
                patch_ensure(p, 4)
                p.pos = o0_st_test_rax_rax(p.code, p.pos)
            } else {
                patch_alu_rax_imm(p, 7, v)
            }
        } else {
            patch_load_slot(p, 1, sb)
            if !words && !b_const {
                patch_ensure(p, 16)
                t2: p.pos
                p.pos = o0_st_test_inline_rcx(p.code, t2)
                p.cold_sites.push(t2 + 8)
            }
            patch_ensure(p, 4)
            p.pos = o0_st_cmp_rax_rcx(p.code, p.pos)
        }
        patch_ensure(p, 8)
        p.pos = o0_st_setcc_rax(p.code, p.pos, cc)
        p.rax_slot = -1
        patch_store_slot(p, dst, 0)
        p.fused_slot = dst
        p.fused_cc = cc
        s_len: p.cold_sites.len() - s_start
        if s_len == 0 -> return
        p.rax_slot = -1
        cold := patch_cold_new(IRX64ColdKind.Compare, s_start, s_len)
        cold.resume = p.pos
        cold.left = sa
        cold.right = sb
        cold.dst = dst
        cold.cc = cc
        cold.at = at
        cold.drop0 = drops.d0
        cold.drop1 = drops.d1
        p.colds.push(cold)
        return
    }
    if op == .Add || op == .Sub || op == .Mul {
        policy: f.c[at]
        left_inline: a_const || policy == IR_OVERFLOW_OPERANDS || policy == IR_OVERFLOW_LEFT
        right_inline: b_const || policy == IR_OVERFLOW_OPERANDS || policy == IR_OVERFLOW_RIGHT
        drops: if !p.in_stop_edge -> patch_operand_drops(p, fast, f, at) else -> {d0: -1, d1: -1, end_at: at}
        s_start: p.cold_sites.len()
        patch_load_slot(p, 0, sa)
        if !left_inline {
            patch_ensure(p, 16)
            t1: p.pos
            p.pos = o0_st_test_inline_rax(p.code, t1)
            p.cold_sites.push(t1 + 8)
        }
        p.rax_slot = -1
        if op != .Mul && b_imm {
            patch_alu_rax_imm(p, if op == .Add -> 0 else -> 5, p.const_val[sb])
        } else {
            patch_load_slot(p, 1, sb)
            if !right_inline {
                patch_ensure(p, 16)
                t2: p.pos
                p.pos = o0_st_test_inline_rcx(p.code, t2)
                p.cold_sites.push(t2 + 8)
            }
            patch_ensure(p, 12)
            if op == .Add {
                p.pos = o0_st_add_rax_rcx(p.code, p.pos)
            } else if op == .Sub {
                p.pos = o0_st_sub_rax_rcx(p.code, p.pos)
            } else {
                p.pos = o0_st_imul_rax_rcx(p.code, p.pos)
                p.cold_sites.push(patch_jcc(p, 0))
            }
        }
        patch_ensure(p, 16)
        tr: p.pos
        p.pos = o0_st_test_inline_rax(p.code, tr)
        p.cold_sites.push(tr + 8)
        patch_store_slot(p, dst, 0)
        p.rax_slot = -1
        cold := patch_cold_new(IRX64ColdKind.Route, s_start, p.cold_sites.len() - s_start)
        cold.resume = p.pos
        cold.sym_id = if op == .Add -> O0_RT_INT_ADD else if op == .Sub -> O0_RT_INT_SUB else -> O0_RT_INT_MUL
        cold.left = sa
        cold.right = sb
        cold.dst = dst
        cold.at = at
        cold.drop0 = drops.d0
        cold.drop1 = drops.d1
        p.colds.push(cold)
        return
    }
    if op == .BitAnd || op == .BitOr || op == .BitXor {
        drops: if !p.in_stop_edge -> patch_operand_drops(p, fast, f, at) else -> {d0: -1, d1: -1, end_at: at}
        s_start: p.cold_sites.len()
        patch_load_slot(p, 0, sa)
        if !a_const {
            patch_ensure(p, 16)
            t1: p.pos
            p.pos = o0_st_test_inline_rax(p.code, t1)
            p.cold_sites.push(t1 + 8)
        }
        p.rax_slot = -1
        if b_imm {
            patch_alu_rax_imm(p, if op == .BitAnd -> 4 else if op == .BitOr -> 1 else -> 6, p.const_val[sb])
        } else {
            patch_load_slot(p, 1, sb)
            if !b_const {
                patch_ensure(p, 16)
                t2: p.pos
                p.pos = o0_st_test_inline_rcx(p.code, t2)
                p.cold_sites.push(t2 + 8)
            }
            patch_ensure(p, 4)
            p.pos = if op == .BitAnd -> o0_st_and_rax_rcx(p.code, p.pos) else if op == .BitOr -> o0_st_or_rax_rcx(p.code, p.pos) else -> o0_st_xor_rax_rcx(p.code, p.pos)
        }
        patch_store_slot(p, dst, 0)
        s_len: p.cold_sites.len() - s_start
        if s_len == 0 -> return
        p.rax_slot = -1
        cold := patch_cold_new(IRX64ColdKind.Route, s_start, s_len)
        cold.resume = p.pos
        cold.sym_id = if op == .BitAnd -> O0_RT_INT_BIT_AND else if op == .BitOr -> O0_RT_INT_BIT_OR else -> O0_RT_INT_BIT_XOR
        cold.left = sa
        cold.right = sb
        cold.dst = dst
        cold.at = at
        cold.drop0 = drops.d0
        cold.drop1 = drops.d1
        p.colds.push(cold)
        return
    }
    if op == .Div || op == .Rem || op == .FloorDiv || op == .Mod {
        s_start: p.cold_sites.len()
        patch_load_slot(p, 0, sa)
        if !a_const {
            patch_ensure(p, 16)
            t1: p.pos
            p.pos = o0_st_test_inline_rax(p.code, t1)
            p.cold_sites.push(t1 + 8)
        }
        patch_load_slot(p, 1, sb)
        if !b_const {
            patch_ensure(p, 16)
            t2: p.pos
            p.pos = o0_st_test_inline_rcx(p.code, t2)
            p.cold_sites.push(t2 + 8)
        }
        if !b_const || p.const_val[sb] == 0 || p.const_val[sb] == -1 {
            patch_ensure(p, 16)
            p.pos = o0_st_lea_rdx_rcx_1(p.code, p.pos)
            p.pos = o0_st_cmp_rdx_i8(p.code, p.pos, 1)
            p.cold_sites.push(patch_jcc(p, 6))
        }
        p.rax_slot = -1
        patch_ensure(p, 8)
        p.pos = o0_st_cqo_idiv_rcx(p.code, p.pos)
        if op == .FloorDiv || op == .Mod -> patch_floor_adjust(p, op)
        if op == .Rem || op == .Mod -> patch_store_slot(p, dst, 2) else -> patch_store_slot(p, dst, 0)
        p.rax_slot = -1
        s_len: p.cold_sites.len() - s_start
        if s_len == 0 -> return
        cold := patch_cold_new(IRX64ColdKind.LocatedRoute, s_start, s_len)
        cold.resume = p.pos
        cold.sym_id = if op == .Div -> O0_RT_INT_DIV else if op == .Rem -> O0_RT_INT_REM else if op == .FloorDiv -> O0_RT_INT_FLOORDIV else -> O0_RT_INT_MOD
        cold.left = sa
        cold.right = sb
        cold.right_nonzero_const = b_const && p.const_val[sb] != 0
        cold.dst = dst
        cold.line = ir_code_line_source(f.code_line[at])
        cold.at = at
        p.colds.push(cold)
        return
    }
    // Exact Int Shl / Shr
    left_shift: op == .Shl
    s_start: p.cold_sites.len()
    patch_load_slot(p, 0, sa)
    if !a_const {
        patch_ensure(p, 16)
        t1: p.pos
        p.pos = o0_st_test_inline_rax(p.code, t1)
        p.cold_sites.push(t1 + 8)
    }
    patch_load_slot(p, 1, sb)
    if !b_const {
        patch_ensure(p, 16)
        t2: p.pos
        p.pos = o0_st_test_inline_rcx(p.code, t2)
        p.cold_sites.push(t2 + 8)
    }
    limit: if left_shift -> 63 else -> 64
    if !b_const || p.const_val[sb] < 0 || p.const_val[sb] >= limit {
        patch_ensure(p, 12)
        p.pos = o0_st_cmp_rcx_i8(p.code, p.pos, limit)
        p.cold_sites.push(patch_jcc(p, 3))
    }
    p.rax_slot = -1
    if left_shift {
        patch_ensure(p, 40)
        p.pos = o0_st_mov_rdx_rax(p.code, p.pos)
        p.pos = o0_st_shl_rdx_cl(p.code, p.pos)
        p.pos = o0_st_mov_r11_rdx(p.code, p.pos)
        p.pos = o0_st_sar_r11_cl(p.code, p.pos)
        p.pos = o0_st_cmp_r11_rax(p.code, p.pos)
        p.cold_sites.push(patch_jcc(p, 5))
        p.pos = o0_st_mov_rax_rdx(p.code, p.pos)
        tr: p.pos
        p.pos = o0_st_test_inline_rax(p.code, tr)
        p.cold_sites.push(tr + 8)
    } else {
        patch_ensure(p, 4)
        p.pos = o0_st_sar_rax_cl(p.code, p.pos)
    }
    patch_store_slot(p, dst, 0)
    s_len: p.cold_sites.len() - s_start
    if s_len == 0 -> return
    p.rax_slot = -1
    cold := patch_cold_new(IRX64ColdKind.LocatedRoute, s_start, s_len)
    cold.resume = p.pos
    cold.sym_id = if left_shift -> O0_RT_INT_SHL else -> O0_RT_INT_SHR
    cold.left = sa
    cold.right = sb
    cold.dst = dst
    cold.line = ir_code_line_source(f.code_line[at])
    cold.at = at
    p.colds.push(cold)
}

patch_float_binary: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int, single: Bool) Never! {
    op: f.op[at]
    ha: p.homes[f.a[at]]
    hb: p.homes[f.b[at]]
    dst: f.dst[at]
    hd: p.homes[dst]
    if op == .Rem {
        patch_load_xmm(p, single, 0, ha)
        patch_load_xmm(p, single, 1, hb)
        patch_call_out(p, f, patch_make_rt(fast, 0, if single -> O0_RT_FMODF else -> O0_RT_FMOD), false, -1)
        p.const_epoch[dst] = 0
        patch_store_xmm(p, single, hd, 0)
        return
    }
    if op == .Eq || op == .Ne || op == .Lt || op == .Le || op == .Gt || op == .Ge {
        patch_load_xmm(p, single, 0, ha)
        patch_load_xmm(p, single, 1, hb)
        patch_ensure(p, 24)
        p.rax_slot = -1
        if op == .Lt || op == .Le {
            p.pos = if single -> o0_st_ucomiss_10(p.code, p.pos) else -> o0_st_ucomisd_10(p.code, p.pos)
        } else {
            p.pos = if single -> o0_st_ucomiss_01(p.code, p.pos) else -> o0_st_ucomisd_01(p.code, p.pos)
        }
        if op == .Eq {
            p.pos = o0_st_float_eq_flags(p.code, p.pos)
            patch_store_slot(p, dst, 0)
            return
        }
        if op == .Ne {
            p.pos = o0_st_float_ne_flags(p.code, p.pos)
            patch_store_slot(p, dst, 0)
            return
        }
        cc: if op == .Gt || op == .Lt -> 7 else -> 3
        p.pos = o0_st_setcc_rax(p.code, p.pos, cc)
        patch_store_slot(p, dst, 0)
        p.fused_slot = dst
        p.fused_cc = cc
        return
    }
    patch_load_xmm(p, single, 0, ha)
    patch_ensure(p, 12)
    if single {
        if patch_fits_i8(hb) {
            p.pos = if op == .Add -> o0_st_f32_add_m8(p.code, p.pos, hb) else if op == .Sub -> o0_st_f32_sub_m8(p.code, p.pos, hb) else if op == .Mul -> o0_st_f32_mul_m8(p.code, p.pos, hb) else -> o0_st_f32_div_m8(p.code, p.pos, hb)
        } else {
            p.pos = if op == .Add -> o0_st_f32_add_m32(p.code, p.pos, hb) else if op == .Sub -> o0_st_f32_sub_m32(p.code, p.pos, hb) else if op == .Mul -> o0_st_f32_mul_m32(p.code, p.pos, hb) else -> o0_st_f32_div_m32(p.code, p.pos, hb)
        }
    } else {
        if patch_fits_i8(hb) {
            p.pos = if op == .Add -> o0_st_f64_add_m8(p.code, p.pos, hb) else if op == .Sub -> o0_st_f64_sub_m8(p.code, p.pos, hb) else if op == .Mul -> o0_st_f64_mul_m8(p.code, p.pos, hb) else -> o0_st_f64_div_m8(p.code, p.pos, hb)
        } else {
            p.pos = if op == .Add -> o0_st_f64_add_m32(p.code, p.pos, hb) else if op == .Sub -> o0_st_f64_sub_m32(p.code, p.pos, hb) else if op == .Mul -> o0_st_f64_mul_m32(p.code, p.pos, hb) else -> o0_st_f64_div_m32(p.code, p.pos, hb)
        }
    }
    if op == .FloorDiv {
        patch_call_out(p, f, patch_make_rt(fast, 0, if single -> O0_RT_FLOORF else -> O0_RT_FLOOR), false, -1)
    }
    p.const_epoch[dst] = 0
    patch_store_xmm(p, single, hd, 0)
}

patch_string_binary: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int) Never! {
    op: f.op[at]
    dst: f.dst[at]
    patch_load_slot(p, 7, f.a[at])
    patch_load_slot(p, 6, f.b[at])
    if op == .Eq || op == .Ne {
        patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_STRING_EQ), false, -1)
        patch_ensure(p, 10)
        p.pos = o0_st_movzx8_rax(p.code, p.pos)
        if op == .Ne -> p.pos = o0_st_xor_rax_i8(p.code, p.pos, 1)
        patch_store_slot(p, dst, 0)
        return
    }
    patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_STRING_COMPARE), false, -1)
    cc: patch_cc(op, false)
    patch_ensure(p, 12)
    p.pos = o0_st_cmp_rax_i8(p.code, p.pos, 0)
    p.pos = o0_st_setcc_rax(p.code, p.pos, cc)
    patch_store_slot(p, dst, 0)
    p.fused_slot = dst
    p.fused_cc = cc
}

patch_neg: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int) Never! {
    sa: f.a[at]
    dst: f.dst[at]
    trow: f.slot_type[sa]
    k: fast.type_kind[trow]
    if k == O0_KIND_INT {
        s_start: p.cold_sites.len()
        patch_load_slot(p, 1, sa)
        if !patch_is_const(p, sa) {
            patch_ensure(p, 16)
            t1: p.pos
            p.pos = o0_st_test_inline_rcx(p.code, t1)
            p.cold_sites.push(t1 + 8)
        }
        patch_ensure(p, 24)
        p.rax_slot = -1
        p.pos = o0_st_zero_rax(p.code, p.pos)
        p.pos = o0_st_sub_rax_rcx(p.code, p.pos)
        tr: p.pos
        p.pos = o0_st_test_inline_rax(p.code, tr)
        p.cold_sites.push(tr + 8)
        patch_store_slot(p, dst, 0)
        p.rax_slot = -1
        cold := patch_cold_new(IRX64ColdKind.Route, s_start, p.cold_sites.len() - s_start)
        cold.resume = p.pos
        cold.sym_id = O0_RT_INT_SUB
        cold.left = -1
        cold.right = sa
        cold.dst = dst
        cold.at = at
        p.colds.push(cold)
        return
    }
    if k == O0_KIND_FLOAT || k == O0_KIND_FLOAT32 {
        patch_load_slot(p, 0, sa)
        patch_mov_ri(p, 1, if k == O0_KIND_FLOAT32 -> 2147483648 else -> IR_X64_INT_MIN)
        patch_ensure(p, 4)
        p.rax_slot = -1
        p.pos = o0_st_xor_rax_rcx(p.code, p.pos)
        patch_store_slot(p, dst, 0)
        p.rax_slot = -1
        return
    }
    patch_load_slot(p, 0, sa)
    p.rax_slot = -1
    bits: fast.type_bits[trow]
    signed: fast.type_signed[trow]
    trap: f.c[at] != IR_OVERFLOW_WRAP
    if trap && !signed {
        patch_ensure(p, 4)
        p.pos = o0_st_test_rax_rax(p.code, p.pos)
        patch_stop_if(p, f, at, 5, 1)
    }
    patch_ensure(p, 4)
    p.pos = o0_st_neg_rax(p.code, p.pos)
    if trap && signed {
        if bits == 64 -> patch_stop_if(p, f, at, 0, 1)
        else -> patch_range_check(p, f, at, true, bits, 1)
    }
    patch_narrow(p, 0, signed, bits)
    patch_store_slot(p, dst, 0)
    if trap -> p.rax_slot = -1
}

patch_not: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int) Never! {
    sa: f.a[at]
    dst: f.dst[at]
    trow: f.slot_type[sa]
    k: fast.type_kind[trow]
    patch_load_slot(p, 0, sa)
    p.rax_slot = -1
    if k == O0_KIND_BOOL {
        patch_ensure(p, 4)
        p.pos = o0_st_xor_rax_i8(p.code, p.pos, 1)
        patch_store_slot(p, dst, 0)
        return
    }
    if k == O0_KIND_WORD {
        patch_ensure(p, 4)
        p.pos = o0_st_xor_rax_i8(p.code, p.pos, -1)
        if !fast.type_signed[trow] -> patch_narrow(p, 0, false, fast.type_bits[trow])
        patch_store_slot(p, dst, 0)
        return
    }
    s_start: p.cold_sites.len()
    if !patch_is_const(p, sa) {
        patch_ensure(p, 16)
        t1: p.pos
        p.pos = o0_st_test_inline_rax(p.code, t1)
        p.cold_sites.push(t1 + 8)
    }
    patch_ensure(p, 4)
    p.pos = o0_st_xor_rax_i8(p.code, p.pos, -1)
    patch_store_slot(p, dst, 0)
    s_len: p.cold_sites.len() - s_start
    if s_len == 0 -> return
    p.rax_slot = -1
    cold := patch_cold_new(IRX64ColdKind.Route, s_start, s_len)
    cold.resume = p.pos
    cold.sym_id = O0_RT_INT_BIT_XOR
    cold.left = sa
    cold.right = -1
    cold.right_imm = -1
    cold.dst = dst
    cold.at = at
    p.colds.push(cold)
}

patch_sqrt: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int) Never! {
    single: fast.type_kind[f.slot_type[f.a[at]]] == O0_KIND_FLOAT32
    dst: f.dst[at]
    patch_load_xmm(p, single, 0, p.homes[f.a[at]])
    patch_ensure(p, 6)
    p.pos = if single -> o0_st_f32_sqrt(p.code, p.pos) else -> o0_st_f64_sqrt(p.code, p.pos)
    p.const_epoch[dst] = 0
    patch_store_xmm(p, single, p.homes[dst], 0)
}

patch_int_big: fn(p: &IRPatchEmitter, f: IRFunction, at: Int) Never! {
    bits: f.b[at]
    dst: f.dst[at]
    patch_load_slot(p, 0, f.a[at])
    patch_ensure(p, 28)
    p.rax_slot = -1
    p.pos = o0_st_mov_rdx_rax(p.code, p.pos)
    cc := 5
    if bits == IR_INT_INLINE_BITS {
        p.pos = o0_st_add_rdx_rdx(p.code, p.pos)
        cc = 0
    } else {
        sh: 64 - bits
        p.pos = o0_st_shl_rdx_i8(p.code, p.pos, sh)
        p.pos = o0_st_sar_rdx_i8(p.code, p.pos, sh)
        p.pos = o0_st_cmp_rdx_rax(p.code, p.pos)
    }
    p.pos = o0_st_setcc_rax(p.code, p.pos, cc)
    patch_store_slot(p, dst, 0)
    p.fused_slot = dst
    p.fused_cc = cc
}

patch_convert: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, at: Int) Never! {
    from_row: f.slot_type[f.a[at]]
    to_row: f.slot_type[f.dst[at]]
    fk: fast.type_kind[from_row]
    tk: fast.type_kind[to_row]
    ha: p.homes[f.a[at]]
    dst: f.dst[at]
    hd: p.homes[dst]
    f_from: fk == O0_KIND_FLOAT || fk == O0_KIND_FLOAT32
    f_to: tk == O0_KIND_FLOAT || tk == O0_KIND_FLOAT32
    if f_from && tk == O0_KIND_WORD {
        patch_load_xmm(p, fk == O0_KIND_FLOAT32, 0, ha)
        patch_ensure(p, 8)
        p.rax_slot = -1
        p.pos = if fk == O0_KIND_FLOAT32 -> o0_st_cvttss2si(p.code, p.pos) else -> o0_st_cvttsd2si(p.code, p.pos)
        patch_normalize_row(p, fast, to_row, 0)
        patch_store_slot(p, dst, 0)
        return
    }
    if fk == O0_KIND_WORD && f_to {
        patch_load_slot(p, 0, f.a[at])
        patch_ensure(p, 8)
        p.pos = if tk == O0_KIND_FLOAT32 -> o0_st_cvtsi2ss(p.code, p.pos) else -> o0_st_cvtsi2sd(p.code, p.pos)
        p.const_epoch[dst] = 0
        patch_store_xmm(p, tk == O0_KIND_FLOAT32, hd, 0)
        return
    }
    if f_from && f_to {
        patch_load_xmm(p, fk == O0_KIND_FLOAT32, 0, ha)
        patch_ensure(p, 6)
        if fk == O0_KIND_FLOAT32 && tk == O0_KIND_FLOAT -> p.pos = o0_st_cvtss2sd(p.code, p.pos)
        else if fk == O0_KIND_FLOAT && tk == O0_KIND_FLOAT32 -> p.pos = o0_st_cvtsd2ss(p.code, p.pos)
        p.const_epoch[dst] = 0
        patch_store_xmm(p, tk == O0_KIND_FLOAT32, hd, 0)
    }
}

patch_transfer: fn(p: &IRPatchEmitter, fast: IRX64FastModule, m: IRModule, f: IRFunction, at: Int) Never! {
    src: f.a[at]
    dst: f.dst[at]
    trow: f.slot_type[src]
    k: fast.type_kind[trow]
    if f.op[at] == .Copy && fast.type_copy_clones[trow] {
        if fast.type_clone_is_int[trow] {
            if patch_is_const(p, src) {
                v: p.const_val[src]
                patch_load_slot(p, 0, src)
                patch_store_slot(p, dst, 0)
                p.const_epoch[dst] = p.block_epoch
                p.const_val[dst] = v
                return
            }
            if p.in_stop_edge {
                patch_load_slot(p, 7, src)
                patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_INT_CLONE), false, -1)
                patch_store_slot(p, dst, 0)
                return
            }
            hs: p.homes[src]
            hd: p.homes[dst]
            patch_ensure(p, 36)
            p.const_epoch[dst] = 0
            p.rax_slot = -1
            b: p.pos
            if patch_fits_i8(hs) && patch_fits_i8(hd) && hs != 0 && hd != 0 {
                p.pos = o0_st_int_clone_8(p.code, b, hs, hd)
                patch_reloc_rt_id(p, fast, b + 16, O0_RT_INT_CLONE)
            } else {
                p.pos = o0_st_int_clone_32(p.code, b, hs, hd)
                patch_reloc_rt_id(p, fast, b + 19, O0_RT_INT_CLONE)
            }
            return
        }
        if k == O0_KIND_STRING {
            if p.in_stop_edge {
                patch_load_slot(p, 7, src)
                patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_STRING_CLONE), false, -1)
                patch_store_slot(p, dst, 0)
                return
            }
            patch_load_slot(p, 0, src)
            patch_ensure(p, 48)
            hb: p.pos
            p.pos = o0_st_str_clone_head(p.code, hb)
            patch_store_slot(p, dst, 0)
            ib: p.pos
            p.pos = if m.single_thread -> o0_st_str_inc_st(p.code, ib) else -> o0_st_str_inc_mt(p.code, ib)
            p.rax_slot = -1
            s1: p.cold_sites.len()
            p.cold_sites.push(hb + 9)
            p.cold_sites.push(hb + 22)
            cold := patch_cold_new(IRX64ColdKind.Route, s1, 2)
            cold.resume = p.pos
            cold.sym_id = O0_RT_STRING_CLONE
            cold.left = src
            cold.dst = dst
            cold.at = at
            p.colds.push(cold)
            s2: p.cold_sites.len()
            p.cold_sites.push(ib + (if m.single_thread -> 6 else -> 7))
            ovf := patch_cold_new(IRX64ColdKind.Route, s2, 1)
            ovf.resume = p.pos
            ovf.sym_id = O0_RT_PANIC_OVERFLOW
            ovf.at = at
            p.colds.push(ovf)
            return
        }
        ty: m.types[trow]
        p.errors.push("{f.name}: Copy of {ir_kind_name(ty.kind)} with drop {ty.drop} has no clone route")
        return
    }
    if src == dst || k == O0_KIND_UNIT -> return
    if patch_is_const(p, src) {
        v: p.const_val[src]
        hd: p.homes[dst]
        patch_ensure(p, 20)
        if x64_fits_i32(v) {
            if patch_fits_i8(hd) -> p.pos = o0_st_const_i32_8(p.code, p.pos, hd, v)
            else -> p.pos = o0_st_const_i32_32(p.code, p.pos, hd, v)
            if p.rax_slot == dst -> p.rax_slot = -1
        } else {
            if patch_fits_i8(hd) -> p.pos = o0_st_const_i64_8(p.code, p.pos, hd, v)
            else -> p.pos = o0_st_const_i64_32(p.code, p.pos, hd, v)
            p.rax_slot = dst
        }
        p.const_epoch[dst] = p.block_epoch
        p.const_val[dst] = v
        return
    }
    hs: p.homes[src]
    hd: p.homes[dst]
    if p.rax_slot == src && hd != 0 {
        patch_store_slot(p, dst, 0)
        return
    }
    if patch_fits_i8(hs) && patch_fits_i8(hd) && hs != 0 && hd != 0 {
        patch_ensure(p, 10)
        p.const_epoch[dst] = 0
        p.pos = o0_st_copy_8(p.code, p.pos, hs, hd)
        p.rax_slot = if fast.type_class[trow] == O0_CLS_GENERAL -> dst else -> -1
        return
    }
    patch_load_slot(p, 0, src)
    patch_store_slot(p, dst, 0)
    if fast.type_class[trow] != O0_CLS_GENERAL -> p.rax_slot = -1
}

patch_drop: fn(p: &IRPatchEmitter, fast: IRX64FastModule, m: IRModule, f: IRFunction, at: Int) Never! {
    slot: f.a[at]
    if f.op[at] == .Close {
        patch_load_slot(p, 7, slot)
        patch_call_out(p, f, patch_make_rt_name(fast, m, 0, f.b[at]), false, -1)
        return
    }
    patch_drop_slot(p, fast, m, f, slot, at)
}

patch_drop_slot: fn(p: &IRPatchEmitter, fast: IRX64FastModule, m: IRModule, f: IRFunction, slot: Int, at: Int) Never! {
    trow: f.slot_type[slot]
    if !fast.type_has_drop[trow] -> return
    if p.in_stop_edge {
        if fast.type_drop_is_int[trow] && patch_is_const(p, slot) -> return
        patch_load_slot(p, 7, slot)
        fid: fast.type_drop_fn[trow]
        if fid >= 0 {
            patch_call_out(p, f, x64_reloc_function(0, fid), false, -1)
        } else {
            patch_call_out(p, f, patch_make_rt(fast, 0, fast.type_drop_rt_id[trow]), false, -1)
        }
        return
    }
    if fast.type_drop_is_int[trow] {
        if patch_is_const(p, slot) -> return
        h: p.homes[slot]
        rt_id: fast.type_drop_rt_id[trow]
        patch_ensure(p, 24)
        p.rax_slot = -1
        b: p.pos
        if patch_fits_i8(h) && h != 0 {
            p.pos = o0_st_int_drop_8(p.code, b, h)
            patch_reloc_rt_id(p, fast, b + 13, rt_id)
        } else {
            p.pos = o0_st_int_drop_32(p.code, b, h)
            patch_reloc_rt_id(p, fast, b + 16, rt_id)
        }
        return
    }
    if fast.type_drop_is_str_rt[trow] {
        patch_load_slot(p, 0, slot)
        patch_ensure(p, 52)
        b: p.pos
        p.pos = if m.single_thread -> o0_st_str_drop_st(p.code, b) else -> o0_st_str_drop_mt(p.code, b)
        p.rax_slot = -1
        s_start: p.cold_sites.len()
        p.cold_sites.push(b + 24)
        p.cold_sites.push(b + (if m.single_thread -> 39 else -> 41))
        cold := patch_cold_new(IRX64ColdKind.Route, s_start, 2)
        cold.resume = p.pos
        cold.sym_id = O0_RT_STRING_DROP
        cold.left = slot
        cold.at = at
        p.colds.push(cold)
        return
    }
    patch_load_slot(p, 7, slot)
    fid: fast.type_drop_fn[trow]
    if fid >= 0 {
        patch_call_out(p, f, x64_reloc_function(0, fid), false, -1)
    } else {
        patch_call_out(p, f, patch_make_rt(fast, 0, fast.type_drop_rt_id[trow]), false, -1)
    }
}

patch_call_runtime: fn(p: &IRPatchEmitter, fast: IRX64FastModule, m: IRModule, f: IRFunction, at: Int) Never! {
    name_row: f.a[at]
    tag: fast.name_rt_tag[name_row]
    dst: f.dst[at]
    alloc_row: if dst >= 0 && fast.name_is_alloc[name_row] && fast.type_is_alloc_row[f.slot_type[dst]] -> f.slot_type[dst] else -> -1
    if tag == O0_RTTAG_PLAIN {
        patch_call(p, fast, f, patch_make_rt_name(fast, m, 0, name_row), -1, f.args, f.b[at], f.c[at], dst, alloc_row)
        return
    }
    if tag >= O0_RTTAG_ATOMIC_INIT && tag <= O0_RTTAG_ATOMIC_CAS {
        arity: if tag == O0_RTTAG_ATOMIC_LOAD -> 1 else if tag == O0_RTTAG_ATOMIC_CAS -> 3 else -> 2
        if f.c[at] == arity {
            start: f.b[at]
            patch_load_slot(p, 10, f.args[start])
            if tag == O0_RTTAG_ATOMIC_INIT {
                patch_load_slot(p, 0, f.args[start + 1])
                patch_ensure(p, 6)
                p.pos = o0_st_atomic_r10_init(p.code, p.pos)
            } else if tag == O0_RTTAG_ATOMIC_LOAD {
                patch_ensure(p, 6)
                p.rax_slot = -1
                p.pos = o0_st_atomic_r10_load(p.code, p.pos)
                patch_store_slot(p, dst, 0)
            } else if tag == O0_RTTAG_ATOMIC_STORE {
                patch_load_slot(p, 0, f.args[start + 1])
                patch_ensure(p, 6)
                p.rax_slot = -1
                p.pos = o0_st_atomic_r10_store(p.code, p.pos)
            } else if tag == O0_RTTAG_ATOMIC_ADD {
                patch_load_slot(p, 0, f.args[start + 1])
                patch_ensure(p, 8)
                p.rax_slot = -1
                p.pos = o0_st_atomic_r10_add(p.code, p.pos)
                if dst >= 0 -> patch_store_slot(p, dst, 0)
            } else {
                patch_load_slot(p, 0, f.args[start + 1])
                patch_load_slot(p, 1, f.args[start + 2])
                patch_ensure(p, 16)
                p.rax_slot = -1
                p.pos = o0_st_atomic_r10_cas(p.code, p.pos)
                if dst >= 0 {
                    p.pos = o0_st_setcc_rax(p.code, p.pos, 4)
                    patch_store_slot(p, dst, 0)
                    p.fused_slot = dst
                    p.fused_cc = 4
                }
            }
            return
        }
    }
    leaf: f.c[at] == 1 && dst >= 0
    if leaf && tag == O0_RTTAG_BLOCK_UNIQUE {
        patch_load_slot(p, 0, f.args[f.b[at]])
        patch_ensure(p, 28)
        p.rax_slot = -1
        p.pos = o0_st_block_unique(p.code, p.pos)
        patch_store_slot(p, dst, 0)
        p.fused_slot = dst
        p.fused_cc = 4
        return
    }
    if f.c[at] == 1 && dst < 0 && tag == O0_RTTAG_BLOCK_RETAIN {
        patch_load_slot(p, 0, f.args[f.b[at]])
        patch_ensure(p, 24)
        b: p.pos
        p.pos = if m.single_thread -> o0_st_block_retain_st(p.code, b) else -> o0_st_block_retain_mt(p.code, b)
        p.rax_slot = -1
        s_start: p.cold_sites.len()
        p.cold_sites.push(b + (if m.single_thread -> 15 else -> 16))
        ovf := patch_cold_new(IRX64ColdKind.Route, s_start, 1)
        ovf.resume = p.pos
        ovf.sym_id = O0_RT_PANIC_OVERFLOW
        ovf.at = at
        p.colds.push(ovf)
        return
    }
    if leaf && tag == O0_RTTAG_BLOCK_RELEASE {
        block: f.args[f.b[at]]
        patch_load_slot(p, 0, block)
        patch_ensure(p, 64)
        b: p.pos
        p.rax_slot = -1
        p.pos = if m.single_thread -> o0_st_block_release_st(p.code, b) else -> o0_st_block_release_mt(p.code, b)
        marked_at: b + 29
        flag_at: b + (if m.single_thread -> 46 else -> 47)
        patch_reloc_rt_data_id(p, fast, flag_at, O0_RT_PROCESS_ENDING)
        patch_store_slot(p, dst, 0)
        p.rax_slot = -1
        s_start: p.cold_sites.len()
        p.cold_sites.push(marked_at)
        cold := patch_cold_new(IRX64ColdKind.Release, s_start, 1)
        cold.resume = p.pos
        cold.left = block
        cold.dst = dst
        cold.at = at
        p.colds.push(cold)
        return
    }
    if leaf && (tag == O0_RTTAG_INT_TO_I64 || tag == O0_RTTAG_INT_CLONE) {
        val: f.args[f.b[at]]
        p.routed_at = at
        if patch_is_const(p, val) {
            patch_load_slot(p, 0, val)
            patch_store_slot(p, dst, 0)
            return
        }
        patch_load_slot(p, 0, val)
        patch_ensure(p, 16)
        t1: p.pos
        p.pos = o0_st_test_inline_rax(p.code, t1)
        patch_store_slot(p, dst, 0)
        p.rax_slot = -1
        s_start: p.cold_sites.len()
        p.cold_sites.push(t1 + 8)
        cold := patch_cold_new(IRX64ColdKind.Route, s_start, 1)
        cold.resume = p.pos
        cold.sym_id = fast.name_rt_sym_id[name_row]
        cold.left = val
        cold.dst = dst
        cold.at = at
        p.colds.push(cold)
        return
    }
    if leaf && (tag == O0_RTTAG_INT_FROM_I64 || (tag == O0_RTTAG_MATH_TO_BITS && fast.type_kind[f.slot_type[f.args[f.b[at]]]] == O0_KIND_FLOAT && fast.type_class[f.slot_type[dst]] == O0_CLS_GENERAL)) {
        val: f.args[f.b[at]]
        p.routed_at = at
        patch_load_slot(p, 0, val)
        patch_ensure(p, 16)
        t1: p.pos
        p.pos = o0_st_test_inline_rax(p.code, t1)
        patch_store_slot(p, dst, 0)
        p.rax_slot = -1
        s_start: p.cold_sites.len()
        p.cold_sites.push(t1 + 8)
        cold := patch_cold_new(IRX64ColdKind.Route, s_start, 1)
        cold.resume = p.pos
        cold.sym_id = O0_RT_INT_OWNED_FROM_I64
        cold.left = val
        cold.dst = dst
        cold.at = at
        p.colds.push(cold)
        return
    }
    if leaf && tag == O0_RTTAG_MATH_FROM_BITS && fast.type_kind[f.slot_type[dst]] == O0_KIND_FLOAT && fast.type_class[f.slot_type[f.args[f.b[at]]]] == O0_CLS_GENERAL {
        val: f.args[f.b[at]]
        p.routed_at = at
        patch_load_slot(p, 0, val)
        if patch_is_const(p, val) {
            patch_store_slot(p, dst, 0)
            p.rax_slot = -1
            return
        }
        patch_ensure(p, 16)
        t1: p.pos
        p.pos = o0_st_test_inline_rax(p.code, t1)
        patch_store_slot(p, dst, 0)
        p.rax_slot = -1
        s_start: p.cold_sites.len()
        p.cold_sites.push(t1 + 8)
        cold := patch_cold_new(IRX64ColdKind.Call, s_start, 1)
        cold.resume = p.pos
        cold.sym_id = fast.name_rt_sym_id[name_row]
        cold.left = at
        cold.at = at
        p.colds.push(cold)
        return
    }
    if (tag == O0_RTTAG_INT_CHECKED_FIXED || tag == O0_RTTAG_INT_NATIVE_I64) && dst >= 0 && fast.type_class[f.slot_type[dst]] == O0_CLS_GENERAL {
        native: tag == O0_RTTAG_INT_NATIVE_I64
        if f.c[at] == (if native -> 4 else -> 5) {
            val: f.args[f.b[at]]
            kind_slot: if native -> -1 else -> f.args[f.b[at] + 1]
            if fast.type_class[f.slot_type[val]] == O0_CLS_GENERAL && (native || patch_is_const(p, kind_slot)) {
                kind: if native -> 3 else -> p.const_val[kind_slot]
                if kind >= 0 && kind <= 7 {
                    p.routed_at = at
                    s_start: p.cold_sites.len()
                    patch_load_slot(p, 0, val)
                    if !patch_is_const(p, val) {
                        patch_ensure(p, 16)
                        t1: p.pos
                        p.pos = o0_st_test_inline_rax(p.code, t1)
                        p.cold_sites.push(t1 + 8)
                    }
                    if kind == 0 || kind == 1 || kind == 2 || kind == 6 {
                        patch_ensure(p, 24)
                        p.pos = o0_st_mov_rdx_rax(p.code, p.pos)
                        patch_narrow(p, 2, kind != 6, if kind == 6 -> 32 else -> 8 << kind)
                        patch_ensure(p, 10)
                        p.pos = o0_st_cmp_rdx_rax(p.code, p.pos)
                        p.cold_sites.push(patch_jcc(p, 5))
                    } else if kind == 4 || kind == 5 {
                        patch_alu_rax_imm(p, 7, if kind == 4 -> 255 else -> 65535)
                        p.cold_sites.push(patch_jcc(p, 7))
                    } else if kind == 7 {
                        patch_ensure(p, 10)
                        p.pos = o0_st_test_rax_rax(p.code, p.pos)
                        p.cold_sites.push(patch_jcc(p, 8))
                    }
                    patch_store_slot(p, dst, 0)
                    s_len: p.cold_sites.len() - s_start
                    if s_len == 0 -> return
                    p.rax_slot = -1
                    cold := patch_cold_new(IRX64ColdKind.Call, s_start, s_len)
                    cold.resume = p.pos
                    cold.sym_id = fast.name_rt_sym_id[name_row]
                    cold.left = at
                    cold.at = at
                    p.colds.push(cold)
                    return
                }
            }
        }
    }
    if tag == O0_RTTAG_INT_CHECKED_WIDEN && f.c[at] == 4 && dst >= 0 && fast.type_kind[f.slot_type[dst]] == O0_KIND_FLOAT {
        val: f.args[f.b[at]]
        single_slot: f.args[f.b[at] + 1]
        if fast.type_class[f.slot_type[val]] == O0_CLS_GENERAL && patch_is_const(p, single_slot) {
            p.routed_at = at
            patch_load_slot(p, 0, val)
            patch_ensure(p, 32)
            p.pos = o0_st_mov_rdx_rax(p.code, p.pos)
            p.pos = o0_st_sar_rdx_i8(p.code, p.pos, if p.const_val[single_slot] != 0 -> 24 else -> 53)
            p.pos = o0_st_add_rdx_i8(p.code, p.pos, 1)
            p.pos = o0_st_cmp_rdx_i8(p.code, p.pos, 1)
            s_start: p.cold_sites.len()
            p.cold_sites.push(patch_jcc(p, 7))
            p.pos = o0_st_cvtsi2sd(p.code, p.pos)
            p.const_epoch[dst] = 0
            patch_store_xmm(p, false, p.homes[dst], 0)
            p.rax_slot = -1
            cold := patch_cold_new(IRX64ColdKind.Call, s_start, 1)
            cold.resume = p.pos
            cold.sym_id = fast.name_rt_sym_id[name_row]
            cold.left = at
            cold.at = at
            p.colds.push(cold)
            return
        }
    }
    if tag == O0_RTTAG_ZONE_OPEN || tag == O0_RTTAG_ZONE_CLOSE || (!m.zones_stripped && (tag == O0_RTTAG_ZONE_FRAME || tag == O0_RTTAG_ZONE_PLOT)) {
        if p.in_stub {
            patch_call(p, fast, f, patch_make_rt(fast, 0, fast.name_rt_sym_id[name_row]), -1, f.args, f.b[at], f.c[at], dst, alloc_row)
            return
        }
        if dst >= 0 {
            hd: p.homes[dst]
            patch_ensure(p, 12)
            p.const_epoch[dst] = 0
            if patch_fits_i8(hd) -> p.pos = o0_st_const_i32_8(p.code, p.pos, hd, 0)
            else -> p.pos = o0_st_const_i32_32(p.code, p.pos, hd, 0)
            if p.rax_slot == dst -> p.rax_slot = -1
        }
        if m.zones_stripped -> return
        if m.zone_table {
            // Off-by-default `test eax, imm32` site; the runtime flips it to `jmp rel32`.
            patch_ensure(p, 6)
            zone_base: p.pos
            p.pos = o0_st_zone_site(p.code, zone_base)
            site: zone_base + 1
            p.zone_sites.push(site)
            p.zone_stubs.push(IRPatchZoneStub{at: at, site: site, resume: p.pos, sym_id: fast.name_rt_sym_id[name_row], name_row: name_row, dst: dst})
            p.rax_slot = -1
            return
        }
        patch_ensure(p, 24)
        p.pos = o0_st_push_r11(p.code, p.pos)
        flag: patch_load_rip(p, 11)
        patch_reloc_rt_data_id(p, fast, flag, O0_RT_PERF_ZONES)
        p.pos = o0_st_test_r11_r11(p.code, p.pos)
        p.pos = o0_st_pop_r11(p.code, p.pos)
        skip: patch_jcc(p, 4)
        patch_call(p, fast, f, patch_make_rt(fast, 0, fast.name_rt_sym_id[name_row]), -1, f.args, f.b[at], f.c[at], dst, alloc_row)
        patch_rel32(p.code, skip, p.pos)
        p.rax_slot = -1
        return
    }
    // Align-8 fast entries using per-block Const info!
    if (tag == O0_RTTAG_ALLOC || tag == O0_RTTAG_ALLOC_VALUE) && f.c[at] == 2 {
        al_slot: f.args[f.b[at] + 1]
        if patch_is_const(p, al_slot) && p.const_val[al_slot] == 8 {
            sid: if tag == O0_RTTAG_ALLOC -> O0_RT_ALLOC_8 else -> O0_RT_ALLOC_VALUE_8
            patch_call(p, fast, f, patch_make_rt(fast, 0, sid), -1, f.args, f.b[at], 1, dst, alloc_row)
            return
        }
    }
    if tag == O0_RTTAG_FREE && f.c[at] == 3 {
        al_slot: f.args[f.b[at] + 2]
        if patch_is_const(p, al_slot) && p.const_val[al_slot] == 8 {
            patch_call(p, fast, f, patch_make_rt(fast, 0, O0_RT_FREE_8), -1, f.args, f.b[at], 2, dst, alloc_row)
            return
        }
    }
    patch_call(p, fast, f, patch_make_rt_name(fast, m, 0, name_row), -1, f.args, f.b[at], f.c[at], dst, alloc_row)
}

// ---------------------------------------------------------------------------
// Structured control helpers.

patch_ctrl_open: fn(p: &IRPatchEmitter, at: Int, head: Int, false_site: Int) Never! {
    p.ctrl_open.push(at)
    p.ctrl_head.push(head)
    p.ctrl_false.push(false_site)
    p.ctrl_end_head.push(-1)
    p.ctrl_end_tail.push(-1)
}

patch_ctrl_push_end: fn(p: &IRPatchEmitter, row: Int, site: Int) Never! {
    idx: p.end_sites.len()
    p.end_sites.push(site)
    p.end_next.push(-1)
    tail: p.ctrl_end_tail[row]
    if tail < 0 -> p.ctrl_end_head[row] = idx else -> p.end_next[tail] = idx
    p.ctrl_end_tail[row] = idx
}

patch_ctrl_branch: fn(p: &IRPatchEmitter, f: IRFunction, at: Int, depth: Int, conditional: Bool, cond_slot: Int) Never! {
    row: p.ctrl_open.len() - 1 - depth
    if row < 0 {
        p.errors.push("{f.name}: branch depth {depth} leaves the function")
        return
    }
    site := -1
    if conditional {
        if p.fused_slot == cond_slot && cond_slot >= 0 {
            cc: p.fused_cc
            p.fused_slot = -1
            site = patch_jcc(p, cc)
        } else if patch_is_const(p, cond_slot) {
            if p.const_val[cond_slot] == 0 {
                patch_cf_barrier(p)
                return
            }
            site = patch_jmp(p)
        } else {
            hc: p.homes[cond_slot]
            patch_ensure(p, 16)
            b: p.pos
            if patch_fits_i8(hc) {
                p.pos = o0_st_brif_truth_8(p.code, b, hc)
                site = b + 7
            } else {
                p.pos = o0_st_brif_truth_32(p.code, b, hc)
                site = b + 10
            }
        }
    } else {
        site = patch_jmp(p)
    }
    patch_cf_barrier(p)
    if p.ctrl_head[row] >= 0 {
        patch_rel32(p.code, site, p.ctrl_head[row])
        return
    }
    if p.end_of[p.ctrl_open[row]] >= 0 {
        patch_rel32(p.code, site, p.end_of[p.ctrl_open[row]])
        return
    }
    patch_ctrl_push_end(p, row, site)
}

patch_ctrl_end: fn(p: &IRPatchEmitter, f: IRFunction, at: Int) Never! {
    if p.ctrl_open.len() == 0 {
        p.errors.push("{f.name}: End without an open construct")
        return
    }
    patch_cf_barrier(p)
    here: p.pos
    row: p.ctrl_open.len() - 1
    p.end_of[p.ctrl_open[row]] = here
    if p.ctrl_false[row] >= 0 -> patch_rel32(p.code, p.ctrl_false[row], here)
    idx := p.ctrl_end_head[row]
    loop idx >= 0 {
        patch_rel32(p.code, p.end_sites[idx], here)
        idx = p.end_next[idx]
    }
    _ := p.ctrl_open.pop()
    _ := p.ctrl_head.pop()
    _ := p.ctrl_false.pop()
    _ := p.ctrl_end_head.pop()
    _ := p.ctrl_end_tail.pop()
}

// ---------------------------------------------------------------------------
// Single-instruction dispatch.

patch_emit_op: fn(p: &IRPatchEmitter, fast: IRX64FastModule, m: IRModule, f: IRFunction, at: Int) Never! {
    op: f.op[at]
    dst: f.dst[at]
    prev_fused_slot: p.fused_slot
    prev_fused_cc: p.fused_cc
    p.fused_slot = -1
    p.fused_cc = -1
    if op == {
        .Nop -> {}
        .Const -> {
            if dst < 0 || p.homes[dst] == 0 -> return
            val: f.a[at]
            hd: p.homes[dst]
            patch_ensure(p, 20)
            if x64_fits_i32(val) {
                if patch_fits_i8(hd) -> p.pos = o0_st_const_i32_8(p.code, p.pos, hd, val)
                else -> p.pos = o0_st_const_i32_32(p.code, p.pos, hd, val)
                if p.rax_slot == dst -> p.rax_slot = -1
            } else {
                if patch_fits_i8(hd) -> p.pos = o0_st_const_i64_8(p.code, p.pos, hd, val)
                else -> p.pos = o0_st_const_i64_32(p.code, p.pos, hd, val)
                p.rax_slot = if fast.type_class[f.slot_type[dst]] == O0_CLS_GENERAL -> dst else -> -1
            }
            if fast.type_class[f.slot_type[dst]] == O0_CLS_GENERAL {
                p.const_epoch[dst] = p.block_epoch
                p.const_val[dst] = val
            } else {
                p.const_epoch[dst] = 0
            }
        }
        .ConstText -> {
            data_row: f.a[at]
            if data_row < 0 || data_row >= m.data.len() {
                p.errors.push("{f.name}: data row {data_row} has no text header")
                return
            }
            hdr: patch_header_row(p, data_row)
            hd: p.homes[dst]
            patch_ensure(p, 16)
            p.const_epoch[dst] = 0
            b: p.pos
            if patch_fits_i8(hd) -> p.pos = o0_st_lea_rip_slot_8(p.code, b, hd)
            else -> p.pos = o0_st_lea_rip_slot_32(p.code, b, hd)
            patch_reloc_data(p, b + 3, hdr)
            p.rax_slot = if hd != 0 -> dst else -> -1
        }
        .ConstBigInt -> {
            name_row: f.a[at]
            if name_row < 0 || name_row >= m.names.len() {
                p.errors.push("{f.name}: name {name_row} is not interned")
                return
            }
            rows: patch_bigint_rows(p, name_row, m.names[name_row])
            hd: p.homes[dst]
            if rows.static_id >= 0 {
                patch_ensure(p, 20)
                p.const_epoch[dst] = 0
                b: p.pos
                if patch_fits_i8(hd) -> p.pos = o0_st_static_int_8(p.code, b, hd)
                else -> p.pos = o0_st_static_int_32(p.code, b, hd)
                patch_reloc_data(p, b + 3, rows.static_id)
                p.rax_slot = if hd != 0 -> dst else -> -1
                return
            }
            site: patch_lea_rip(p, 7)
            patch_reloc_data(p, site, rows.text_id)
            text_len: patch_use_len(p, rows.text_id)
            patch_mov_ri(p, 6, text_len)
            patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_INT_FROM_STATIC), false, -1)
            patch_store_slot(p, dst, 0)
        }
        .Copy | .Move -> patch_transfer(p, fast, m, f, at)
        .Drop | .Close -> patch_drop(p, fast, m, f, at)
        .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge -> {
            trow: f.slot_type[f.a[at]]
            k: fast.type_kind[trow]
            if k == O0_KIND_INT {
                if ir_overflow_wraps(f.c[at]) {
                    patch_word_binary(p, fast, f, at, O0_KIND_WORD, true, 64, true)
                } else {
                    patch_exact_binary(p, fast, f, at)
                }
            } else if k == O0_KIND_FLOAT || k == O0_KIND_FLOAT32 {
                patch_float_binary(p, fast, f, at, k == O0_KIND_FLOAT32)
            } else if k == O0_KIND_STRING {
                patch_string_binary(p, fast, f, at)
            } else if k == O0_KIND_WORD || k == O0_KIND_BOOL || k == O0_KIND_CHAR || k == O0_KIND_POINTER {
                patch_word_binary(p, fast, f, at, k, fast.type_signed[trow], fast.type_bits[trow], false)
            } else {
                p.errors.push("{f.name}: no arithmetic on {ir_kind_name(m.types[trow].kind)}")
            }
        }
        .Neg -> patch_neg(p, fast, f, at)
        .Not -> patch_not(p, fast, f, at)
        .Sqrt -> patch_sqrt(p, fast, f, at)
        .IntBig -> patch_int_big(p, f, at)
        .Convert -> patch_convert(p, fast, f, at)
        .Concat -> {
            patch_load_slot(p, 7, f.a[at])
            patch_load_slot(p, 6, f.b[at])
            patch_call_out(p, f, patch_make_rt(fast, 0, if f.c[at] == 1 -> O0_RT_STRING_CONCAT_VALUE else -> O0_RT_STRING_CONCAT), false, -1)
            patch_store_slot(p, dst, 0)
        }
        .Call -> {
            callee: f.a[at]
            if callee < 0 || callee >= m.functions.len() {
                p.errors.push("{f.name}: function {callee} is not in the module")
                return
            }
            if at + 1 < f.op.len() && f.op[at + 1] == .Return && f.b[at + 1] == IR_TAIL_JUMP {
                patch_tail_jump(p, fast, f, at)
                return
            }
            if !p.in_stop_edge && f.c[at] == 1 && dst < 0 && fast.fn_is_unique[callee] {
                header: f.args[f.b[at]]
                if header >= 0 && fast.type_class[f.slot_type[header]] == O0_CLS_GENERAL {
                    patch_load_slot(p, 0, header)
                    patch_ensure(p, 36)
                    b: p.pos
                    p.pos = o0_st_unique_body(p.code, b)
                    p.rax_slot = -1
                    s1: p.cold_sites.len()
                    p.cold_sites.push(b + 24)
                    shared := patch_cold_new(IRX64ColdKind.Unique, s1, 1)
                    shared.resume = p.pos
                    shared.left = at
                    shared.right = -1
                    shared.at = at
                    p.colds.push(shared)
                    s2: p.cold_sites.len()
                    p.cold_sites.push(b + 9)
                    rare := patch_cold_new(IRX64ColdKind.Unique, s2, 1)
                    rare.resume = p.pos
                    rare.left = at
                    rare.right = header
                    rare.at = at
                    p.colds.push(rare)
                    return
                }
            }
            // G2: preserve inline #FFI(asm) call sites for normal callers.
            if fast.fn_has_asm[callee] && !fast.fn_is_stop[callee] {
                if m.functions[callee].asm == .Val(leaf) && ir_x64_asm_inlinable(m, f, leaf, f.args, f.b[at], f.c[at], dst) {
                    loop pos in 0..<f.c[at] {
                        patch_load_slot(p, leaf.regs[pos], f.args[f.b[at] + pos])
                    }
                    patch_ensure(p, leaf.code.len() + 12)
                    if p.has_stream -> p.pos = o0_st_sfence(p.code, p.pos)
                    p.rax_slot = -1
                    loop b_byte in leaf.code {
                        p.code[p.pos] = b_byte
                        p.pos += 1
                    }
                    if dst >= 0 {
                        if leaf.result > 0 {
                            patch_ensure(p, 4)
                            p.pos = if leaf.result == {
                                1 -> o0_st_mov_rax_rcx(p.code, p.pos)
                                2 -> o0_st_mov_rax_rdx(p.code, p.pos)
                                6 -> o0_st_mov_rax_rsi(p.code, p.pos)
                                7 -> o0_st_mov_rax_rdi(p.code, p.pos)
                                8 -> o0_st_mov_rax_r8(p.code, p.pos)
                                9 -> o0_st_mov_rax_r9(p.code, p.pos)
                                10 -> o0_st_mov_rax_r10(p.code, p.pos)
                                else -> o0_st_mov_rax_r11(p.code, p.pos)
                            }
                        }
                        patch_normalize_row(p, fast, f.slot_type[dst], 0)
                        patch_store_slot(p, dst, 0)
                    }
                    return
                }
            }
            patch_call(p, fast, f, x64_reloc_function(0, callee), -1, f.args, f.b[at], f.c[at], dst, -1)
        }
        .CallRuntime -> patch_call_runtime(p, fast, m, f, at)
        .CallIndirect -> patch_call(p, fast, f, x64_reloc_function(0, -1), f.a[at], f.args, f.b[at], f.c[at], dst, -1)
        .FunctionAddress -> {
            hd: p.homes[dst]
            patch_ensure(p, 16)
            p.const_epoch[dst] = 0
            b: p.pos
            if patch_fits_i8(hd) -> p.pos = o0_st_lea_rip_slot_8(p.code, b, hd)
            else -> p.pos = o0_st_lea_rip_slot_32(p.code, b, hd)
            patch_reloc_fn(p, b + 3, f.a[at])
            p.rax_slot = if hd != 0 -> dst else -> -1
        }
        .DataAddress -> {
            hd: p.homes[dst]
            patch_ensure(p, 16)
            p.const_epoch[dst] = 0
            b: p.pos
            if patch_fits_i8(hd) -> p.pos = o0_st_lea_rip_slot_8(p.code, b, hd)
            else -> p.pos = o0_st_lea_rip_slot_32(p.code, b, hd)
            drow: f.a[at]
            rt_id: if drow >= 0 && drow < fast.data_core_cell_rt_id.len() -> fast.data_core_cell_rt_id[drow] else -> -1
            if rt_id >= 0 -> patch_reloc_rt_data_id(p, fast, b + 3, rt_id)
            else -> patch_reloc_data(p, b + 3, drow)
            p.rax_slot = if hd != 0 -> dst else -> -1
        }
        .Load -> patch_emit_load(p, fast, f, at)
        .Store -> patch_emit_store(p, fast, f, at, false)
        .StreamStore -> patch_emit_store(p, fast, f, at, true)
        .Offset -> {
            patch_load_slot(p, 0, f.a[at])
            off: f.b[at]
            if off != 0 {
                p.rax_slot = -1
                if patch_fits_i8(off) {
                    patch_ensure(p, 6)
                    p.pos = o0_st_lea_rax_rax_8(p.code, p.pos, off)
                } else if x64_fits_i32(off) {
                    patch_ensure(p, 8)
                    p.pos = o0_st_lea_rax_rax_32(p.code, p.pos, off)
                } else {
                    patch_mov_ri(p, 1, off)
                    patch_ensure(p, 4)
                    p.pos = o0_st_add_rax_rcx(p.code, p.pos)
                }
            }
            patch_store_slot(p, dst, 0)
        }
        .CopyBytes -> {
            patch_load_slot(p, 0, f.a[at])
            patch_load_slot(p, 2, f.b[at])
            patch_copy_bytes_rdx_to_rax(p, f.c[at])
        }
        .StackAddress -> {
            size: ir_x64_storage_size(f, at)
            align: if {
                f.b[at] > 16 -> 16
                f.b[at] < 1 -> 1
                else -> f.b[at]
            }
            p.depth = ir_x64_align(p.depth + size, align)
            storage: 0 - p.depth
            patch_lea_rbp(p, 0, storage)
            patch_store_slot(p, dst, 0)
        }
        .Block -> {
            patch_cf_barrier(p)
            patch_ctrl_open(p, at, -1, -1)
        }
        .Loop -> {
            patch_cf_barrier(p)
            patch_ctrl_open(p, at, p.pos, -1)
        }
        .If -> {
            cond: f.a[at]
            false_site := -1
            if prev_fused_slot == cond && cond >= 0 {
                inv: if prev_fused_cc % 2 == 0 -> prev_fused_cc + 1 else -> prev_fused_cc - 1
                false_site = patch_jcc(p, inv)
            } else if patch_is_const(p, cond) {
                if p.const_val[cond] == 0 -> false_site = patch_jmp(p)
            } else {
                ha: p.homes[cond]
                patch_ensure(p, 16)
                b: p.pos
                if patch_fits_i8(ha) {
                    p.pos = o0_st_if_truth_8(p.code, b, ha)
                    false_site = b + 7
                } else {
                    p.pos = o0_st_if_truth_32(p.code, b, ha)
                    false_site = b + 10
                }
            }
            patch_cf_barrier(p)
            patch_ctrl_open(p, at, -1, false_site)
        }
        .Else -> {
            if p.ctrl_open.len() == 0 {
                p.errors.push("{f.name}: Else without an If")
                return
            }
            row: p.ctrl_open.len() - 1
            site: patch_jmp(p)
            patch_ctrl_push_end(p, row, site)
            if p.ctrl_false[row] >= 0 -> patch_rel32(p.code, p.ctrl_false[row], p.pos)
            p.ctrl_false[row] = -1
            patch_cf_barrier(p)
        }
        .End -> patch_ctrl_end(p, f, at)
        .Br -> patch_ctrl_branch(p, f, at, f.a[at], false, -1)
        .BrIf -> {
            p.fused_slot = prev_fused_slot
            p.fused_cc = prev_fused_cc
            patch_ctrl_branch(p, f, at, f.b[at], true, f.a[at])
        }
        .Return -> {
            if f.b[at] == IR_TAIL_JUMP -> return
            slot: f.a[at]
            if slot >= 0 {
                if p.result_home != 0 {
                    patch_load_slot(p, 2, slot)
                    patch_load_rbp(p, 0, p.result_home)
                    p.rax_slot = -1
                    patch_copy_bytes_rdx_to_rax(p, fast.type_size[f.result])
                    patch_load_rbp(p, 0, p.result_home)
                    p.rax_slot = -1
                } else {
                    trow: f.slot_type[slot]
                    cls: fast.type_class[trow]
                    if cls == O0_CLS_GENERAL -> patch_load_slot(p, 0, slot)
                    else if cls == O0_CLS_FLOAT -> patch_load_xmm(p, fast.type_kind[trow] == O0_KIND_FLOAT32, 0, p.homes[slot])
                }
            }
            if p.in_stop_edge -> p.stop_returns.push(patch_jmp(p))
            else if at < f.op.len() - 1 -> p.returns.push(patch_jmp(p))
            patch_cf_barrier(p)
        }
        .Unreachable -> {
            patch_ensure(p, 4)
            p.pos = o0_st_ud2(p.code, p.pos)
            patch_cf_barrier(p)
        }
    }
}

// ---------------------------------------------------------------------------
// Out-of-line stop points & O(N) suffix-trie stop-edge sharing (G1 compliant).

patch_stop_edge_is_bare_return: fn(p: &IRPatchEmitter, f: IRFunction, branch: Int, end_idx: Int) -> Bool Never! {
    if end_idx <= branch + 1 -> return false
    last: end_idx - 1
    if f.op[last] != .Return || f.a[last] >= 0 || f.b[last] == IR_TAIL_JUMP -> return false
    if end_idx == branch + 2 -> return true
    if !p.drop.has_moves -> return false
    loop k in (branch + 1)..<last {
        if f.op[k] == .Nop || p.drop.kill[k] -> next
        return false
    }
    true
}

patch_stop_edge_is_drop_chain: fn(f: IRFunction, branch: Int, end_idx: Int) -> Bool Never! {
    if end_idx <= branch + 1 -> return false
    if f.op[end_idx - 1] != .Return || f.a[end_idx - 1] >= 0 || f.b[end_idx - 1] == IR_TAIL_JUMP {
        return false
    }
    loop k in (branch + 1)..<(end_idx - 1) {
        op: f.op[k]
        if op != .Drop && op != .Nop -> return false
    }
    true
}

patch_in_loop: fn(p: &IRPatchEmitter, f: IRFunction) -> Bool Never! {
    loop opener in p.ctrl_open {
        if f.op[opener] == .Loop -> return true
    }
    false
}

// The stencil twin of X64Select.jet ir_x64_armed_poll: with `counted` the
// hot path first spends one step of the runtime's step word and enters the
// slow path once the word is below zero.
patch_emit_armed_poll: fn(p: &IRPatchEmitter, fast: IRX64FastModule, at: Int, edge_id: Int, armed: Bool, counted: Bool{false}) Never! {
    s_start: p.cold_sites.len()
    if counted {
        patch_ensure(p, 13)
        b: p.pos
        p.pos = o0_st_step_spend(p.code, b)
        patch_reloc_rt_data_id(p, fast, b + 3, O0_RT_COMPTIME_STEPS)
        p.cold_sites.push(b + 9)
    }
    if armed {
        patch_ensure(p, 20)
        b: p.pos
        p.pos = o0_st_armed_poll(p.code, b)
        p.rax_slot = -1
        patch_reloc_rt_data_id(p, fast, b + 3, O0_RT_CHECKS_ARMED)
        p.cold_sites.push(b + 12)
    }
    cold := patch_cold_new(IRX64ColdKind.Poll, s_start, p.cold_sites.len() - s_start)
    cold.resume = p.pos
    cold.left = at
    cold.pad = edge_id
    cold.at = at
    p.colds.push(cold)
}

patch_emit_stop_quiet: fn(p: &IRPatchEmitter, bits: Int) Never! {
    if p.quiet_sites.len() > 0 -> p.quiet_sites.clear()
    if p.enter_sites.len() > 0 -> p.enter_sites.clear()
    patch_ensure(p, 80)
    p.rax_slot = -1
    p.pos = o0_st_stop_quiet_gs(p.code, p.pos)
    p.pos = o0_st_test_rax_rax(p.code, p.pos)
    p.quiet_sites.push(patch_jcc(p, 4))
    p.pos = o0_st_stop_quiet_turn(p.code, p.pos)
    p.enter_sites.push(patch_jcc(p, 5))
    p.pos = o0_st_load_rax_rax_8(p.code, p.pos, 16)
    p.pos = o0_st_test_rax_rax(p.code, p.pos)
    p.quiet_sites.push(patch_jcc(p, 4))
    p.pos = o0_st_test_rax24_i32(p.code, p.pos, bits)
    p.enter_sites.push(patch_jcc(p, 5))
    p.pos = o0_st_load_rax_rax_8(p.code, p.pos, 32)
    p.pos = o0_st_test_rax_rax(p.code, p.pos)
    p.quiet_sites.push(patch_jcc(p, 4))
    here: p.pos
    loop site in p.enter_sites -> patch_rel32(p.code, site, here)
}

patch_push_stop_edge: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, branch: Int, end_idx: Int, hot_site: Int) Never! {
    simple_edge: patch_stop_edge_is_drop_chain(f, branch, end_idx) || patch_cleanup_edge(p, fast, f, branch, end_idx).ok
    o_start: p.edge_open.len()
    o_len := 0
    if !simple_edge {
        o_len = p.ctrl_open.len()
        loop i in 0..<o_len {
            p.edge_open.push(p.ctrl_open[i])
            p.edge_heads.push(p.ctrl_head[i])
        }
    }
    p.stop_edges.push(
        IRPatchStopEdge{
            branch: branch,
            end: end_idx,
            site: hot_site,
            resume: p.pos,
            open_start: o_start,
            open_len: o_len,
            offset: -1,
        },
    )
}

// G1a: uses O(1) anonymous-temp check instead of p.ends[stopped] != branch.
patch_stop_point: fn(p: &IRPatchEmitter, fast: IRX64FastModule, m: IRModule, f: IRFunction, at: Int, poll: Int, trap: Int, turn: Int, traps: Int) -> Int Never! {
    if f.op[at] != .Call || f.a[at] < 0 || (f.a[at] != poll && f.a[at] != trap && f.a[at] != turn) {
        return -1
    }
    branch: at + 1
    stopped: f.dst[at]
    if stopped < 0 || f.slot_kind[stopped] != .Temp || f.slot_name[stopped] >= 0 || branch >= f.op.len() || f.op[branch] != .If || f.a[branch] != stopped || f.b[branch] >= 0 {
        return -1
    }
    end_idx: f.c[branch]
    bare_ret: patch_stop_edge_is_bare_return(p, f, branch, end_idx)
    if f.a[at] == trap {
        has_trap := false
        loop idx in traps..<p.colds.len() {
            k: p.colds[idx].kind
            if k == .Stop || k == .ShiftStop || (k == .LocatedRoute && patch_located_stops_cold(f, p.colds[idx])) {
                has_trap = true
                break
            }
        }
        if !has_trap -> return end_idx
        if bare_ret -> return end_idx
        edge_id: p.stop_edges.len()
        loop idx in traps..<p.colds.len() {
            k: p.colds[idx].kind
            if k == .Stop || k == .ShiftStop || (k == .LocatedRoute && patch_located_stops_cold(f, p.colds[idx])) {
                p.colds[idx].pad = edge_id
            }
        }
        p.end_of[branch] = p.pos
        patch_push_stop_edge(p, fast, f, branch, end_idx, -1)
        return end_idx
    }
    // poll or turn
    edge_id := if bare_ret -> -1 else -> p.stop_edges.len()
    hot_site := -1
    routed: at > 0 && p.routed_at == at - 1 && p.colds.len() - traps <= 1
    if at > 0 && ir_x64_call_reports(m, f, at - 1) {
        patch_ensure(p, 10)
        b: p.pos
        p.pos = o0_st_stop_jne_edx(p.code, b)
        hot_site = b + 4
        if f.a[at] == turn {
            patch_emit_armed_poll(p, fast, at, edge_id, true, counted: m.step_count)
        }
    } else if routed || (f.a[at] == turn && (at == 0 || f.op[at - 1] == .Loop)) || !ir_opt_polls_checks_call(m, f, poll, trap, turn, at) {
        falls: routed && p.colds.len() > traps
        if falls -> p.colds[traps].falls = true
        patch_emit_armed_poll(p, fast, at, edge_id, !falls || f.a[at] == turn, counted: m.step_count && f.a[at] == turn)
    } else {
        // A turn that counts steps spends one first; once the word is below
        // zero it calls the turn poll past the quiet tests, and the poll
        // enters its routine (X64Select.jet ir_x64_stop_poll).
        spent := -1
        if m.step_count && f.a[at] == turn {
            patch_ensure(p, 13)
            b: p.pos
            p.pos = o0_st_step_spend(p.code, b)
            patch_reloc_rt_data_id(p, fast, b + 3, O0_RT_COMPTIME_STEPS)
            spent = b + 9
        }
        has_quiet: patch_in_loop(p, f) || f.stack_check
        if has_quiet {
            patch_emit_stop_quiet(p, ir_stop_attention(m.functions[f.a[at]].key))
        }
        if spent >= 0 -> patch_rel32(p.code, spent, p.pos)
        patch_call_out(p, f, x64_reloc_function(0, f.a[at]), false, -1)
        patch_ensure(p, 10)
        p.pos = o0_st_test_rax_rax(p.code, p.pos)
        hot_site = patch_jcc(p, 5)
        if has_quiet {
            quiet: p.pos
            loop skip in p.quiet_sites -> patch_rel32(p.code, skip, quiet)
        }
    }
    p.end_of[branch] = p.pos
    if bare_ret {
        if hot_site >= 0 -> p.stop_returns.push(hot_site)
        return end_idx
    }
    patch_push_stop_edge(p, fast, f, branch, end_idx, hot_site)
    end_idx
}

// G1b: validates cleanup token locally inside (first+1)..<leave without p.starts/p.ends.
patch_cleanup_edge: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, branch: Int, end_idx: Int) -> {ok: Bool, first: Int, leave: Int, token: Int} Never! {
    none: {ok: false, first: -1, leave: -1, token: -1}
    last: end_idx - 1
    if last <= branch + 2 -> return none
    if f.op[last] != .Return || f.a[last] >= 0 || f.b[last] == IR_TAIL_JUMP -> return none
    first := branch + 1
    loop first < last && (f.op[first] == .Nop || (p.drop.has_moves && p.drop.kill[first])) {
        first += 1
    }
    leave := last - 1
    loop leave > first && (f.op[leave] == .Nop || (p.drop.has_moves && p.drop.kill[leave])) {
        leave -= 1
    }
    if leave <= first -> return none
    if f.op[first] != .CallRuntime || f.op[leave] != .CallRuntime -> return none
    if fast.name_rt_tag[f.a[first]] != O0_RTTAG_CLEANUP_ENTER || fast.name_rt_tag[f.a[leave]] != O0_RTTAG_CLEANUP_LEAVE {
        return none
    }
    token: f.dst[first]
    if token < f.param_count || f.slot_kind[token] != .Temp || f.slot_name[token] >= 0 -> return none
    if f.c[leave] != 1 || f.args[f.b[leave]] != token -> return none
    depth := 0
    loop k in (first + 1)..<leave {
        if f.dst[k] == token -> return none
        op: f.op[k]
        form: ir_x64_read_form(op)
        if form != IR_X64_READS_NONE {
            if form != IR_X64_READS_ARGS && f.a[k] == token -> return none
            if form == IR_X64_READS_AB && f.b[k] == token -> return none
            if form == IR_X64_READS_AC && f.c[k] == token -> return none
            if form == IR_X64_READS_ARGS || form == IR_X64_READS_A_ARGS {
                loop arg_i in f.b[k]..<(f.b[k] + f.c[k]) {
                    if f.args[arg_i] == token -> return none
                }
            }
        }
        if op == {
            .If -> depth += 1
            .End -> {
                depth -= 1
                if depth < 0 -> return none
            }
            .Else -> {
                if depth <= 0 -> return none
            }
            .Block | .Loop | .Br | .BrIf | .Return | .Unreachable -> return none
            .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Sqrt | .IntBig | .StreamStore -> {}
        }
    }
    if depth != 0 -> return none
    {ok: true, first: first, leave: leave, token: token}
}

// G1c: compares cleanup-group slots locally without p.starts.
patch_group_eq: fn(f: IRFunction, s1: Int, e1: Int, s2: Int, e2: Int) -> Bool Never! {
    len: e1 - s1
    if len != e2 - s2 -> return false
    if len == 1 && f.op[s1] == .Drop && f.op[s2] == .Drop -> return f.a[s1] == f.a[s2]
    loop d in 0..<len {
        k1: s1 + d
        k2: s2 + d
        op: f.op[k1]
        if op != f.op[k2] -> return false
        if op == {
            .Drop -> if f.a[k1] != f.a[k2] -> return false
            .Close -> if f.b[k1] != f.b[k2] || f.a[k1] != f.a[k2] -> return false
            .Const -> if f.a[k1] != f.a[k2] || f.dst[k1] != f.dst[k2] -> return false
            .Load | .Offset -> if f.b[k1] != f.b[k2] || f.c[k1] != f.c[k2] || f.a[k1] != f.a[k2] || f.dst[k1] != f.dst[k2] -> return false
            .Copy | .Move | .Not -> if f.a[k1] != f.a[k2] || f.dst[k1] != f.dst[k2] -> return false
            .BitAnd | .BitOr | .BitXor | .Eq | .Ne | .Lt | .Le | .Gt | .Ge -> if f.c[k1] != f.c[k2] || f.a[k1] != f.a[k2] || f.b[k1] != f.b[k2] || f.dst[k1] != f.dst[k2] -> return false
            .If -> if (f.b[k1] >= 0) != (f.b[k2] >= 0) || (f.c[k1] - s1) != (f.c[k2] - s2) || f.a[k1] != f.a[k2] -> return false
            .Else | .End | .Nop -> {}
            .Call | .CallRuntime -> {
                if f.a[k1] != f.a[k2] || f.c[k1] != f.c[k2] || f.dst[k1] != f.dst[k2] -> return false
                loop j in 0..<f.c[k1] {
                    if f.args[f.b[k1] + j] != f.args[f.b[k2] + j] -> return false
                }
            }
            .ConstText | .ConstBigInt | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .Shl | .Shr | .Neg | .Convert | .Concat | .CallIndirect | .FunctionAddress | .DataAddress | .Store | .StackAddress | .CopyBytes | .Block | .Loop | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> return false
        }
    }
    true
}

patch_group_hash: fn(f: IRFunction, s: Int, e: Int) -> Int Never! {
    len: e - s
    if len == 1 && f.op[s] == .Drop -> return 1 + f.a[s] * 31
    h := len * 1315423911
    loop k in s..<e {
        op: f.op[k]
        tag: if op == {
            .Drop -> 1
            .Close -> 2
            .If -> 3
            .Else -> 4
            .End -> 5
            .Load -> 6
            .Const -> 7
            .BitAnd -> 8
            .Eq -> 9
            .Ne -> 10
            .Call -> 11
            .CallRuntime -> 12
            .Nop | .ConstText | .ConstBigInt | .Copy | .Move | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitOr | .BitXor | .Shl | .Shr | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .CallIndirect | .FunctionAddress | .DataAddress | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> 13
        }
        h = (h * 33 + tag) & 2147483647
        if op == .Drop || op == .Close -> h = (h * 33 + f.a[k]) & 2147483647
    }
    h
}

patch_suffix_find: fn(p: &IRPatchEmitter, slot: Int, next_off: Int) -> Int Never! {
    loop i in 0..<p.suffix_slot.len() {
        if p.suffix_slot[i] == slot && p.suffix_next[i] == next_off -> return p.suffix_off[i]
    }
    -1
}

// G1d: out-of-line stop edges with reusable scratch and local edge_def_epoch.
patch_emit_stop_edges: fn(p: &IRPatchEmitter, fast: IRX64FastModule, m: IRModule, f: IRFunction, exit: Int) Never! {
    if p.stop_edges.is_empty() -> return
    p.in_stop_edge = true
    p.at = -1
    shared_tok_home := 0
    leave_off := -1
    if p.g_hash.len() > 0 -> p.g_hash.clear()
    if p.g_next.len() > 0 -> p.g_next.clear()
    if p.g_start.len() > 0 -> p.g_start.clear()
    if p.g_end.len() > 0 -> p.g_end.clear()
    if p.g_off.len() > 0 -> p.g_off.clear()
    if p.enter_body.len() > 0 -> p.enter_body.clear()
    if p.enter_off.len() > 0 -> p.enter_off.clear()
    idx := p.stop_edges.len() - 1
    loop idx >= 0 {
        patch_cf_barrier(p)
        branch: p.stop_edges[idx].branch
        end_idx: p.stop_edges[idx].end
        hot_site: p.stop_edges[idx].site
        info: patch_cleanup_edge(p, fast, f, branch, end_idx)
        if info.ok {
            if leave_off < 0 {
                p.depth += 8
                shared_tok_home = 0 - p.depth
                leave_off = p.pos
                patch_load_rbp(p, 7, shared_tok_home)
                patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_CLEANUP_LEAVE), false, -1)
                patch_jmp_to(p, exit)
            }
            if p.edge_gs.len() > 0 -> p.edge_gs.clear()
            if p.edge_ge.len() > 0 -> p.edge_ge.clear()
            p.edge_def_cur += 1
            cur_ep: p.edge_def_cur
            k := info.first + 1
            loop k < info.leave {
                if f.op[k] == .Nop || (p.drop.has_moves && p.drop.kill[k]) {
                    k += 1
                    next
                }
                start_k: k
                if f.op[k] == .Drop || f.op[k] == .Close -> k += 1 else {
                    depth := 0
                    loop k < info.leave {
                        op: f.op[k]
                        k += 1
                        if op == .If -> depth += 1 else if op == .End {
                            depth -= 1
                            if depth == 0 -> break
                        } else if depth == 0 && (op == .Drop || op == .Close) {
                            break
                        }
                    }
                }
                merged := false
                if p.edge_gs.len() > 0 {
                    loop u in start_k..<k {
                        form: ir_x64_read_form(f.op[u])
                        if form != IR_X64_READS_NONE {
                            a: f.a[u]
                            if form != IR_X64_READS_ARGS && a >= 0 && p.edge_def_epoch[a] == cur_ep {
                                merged = true
                                break
                            }
                            if form == IR_X64_READS_AB && f.b[u] >= 0 && p.edge_def_epoch[f.b[u]] == cur_ep {
                                merged = true
                                break
                            }
                        }
                    }
                }
                loop u in start_k..<k {
                    w: f.dst[u]
                    if w >= 0 -> p.edge_def_epoch[w] = cur_ep
                }
                if merged -> p.edge_ge[p.edge_ge.len() - 1] = k else {
                    p.edge_gs.push(start_k)
                    p.edge_ge.push(k)
                }
            }
            tail_off := leave_off
            prefix_len := p.edge_gs.len()
            loop prefix_len > 0 {
                s: p.edge_gs[prefix_len - 1]
                e: p.edge_ge[prefix_len - 1]
                h: patch_group_hash(f, s, e)
                found := -1
                loop gi in 0..<p.g_hash.len() {
                    if p.g_hash[gi] == h && p.g_next[gi] == tail_off && patch_group_eq(f, s, e, p.g_start[gi], p.g_end[gi]) {
                        found = p.g_off[gi]
                        break
                    }
                }
                if found < 0 -> break
                tail_off = found
                prefix_len -= 1
            }
            if prefix_len == 0 {
                cached := -1
                loop ei in 0..<p.enter_body.len() {
                    if p.enter_body[ei] == tail_off {
                        cached = p.enter_off[ei]
                        break
                    }
                }
                if cached >= 0 {
                    p.stop_edges[idx].offset = cached
                    if hot_site >= 0 -> patch_rel32(p.code, hot_site, cached)
                } else {
                    here: p.pos
                    p.stop_edges[idx].offset = here
                    if hot_site >= 0 -> patch_rel32(p.code, hot_site, here)
                    patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_CLEANUP_ENTER), false, -1)
                    patch_store_rbp(p, shared_tok_home, 0)
                    patch_jmp_to(p, tail_off)
                    p.enter_body.push(tail_off)
                    p.enter_off.push(here)
                }
            } else {
                here: p.pos
                p.stop_edges[idx].offset = here
                if hot_site >= 0 -> patch_rel32(p.code, hot_site, here)
                patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_CLEANUP_ENTER), false, -1)
                patch_store_rbp(p, shared_tok_home, 0)
                body_start: p.pos
                p.enter_body.push(body_start)
                p.enter_off.push(here)
                if p.edge_offs.len() > 0 -> p.edge_offs.clear()
                if p.ctrl_open.len() > 0 -> p.ctrl_open.clear()
                if p.ctrl_head.len() > 0 -> p.ctrl_head.clear()
                if p.ctrl_false.len() > 0 -> p.ctrl_false.clear()
                if p.ctrl_end_head.len() > 0 -> p.ctrl_end_head.clear()
                if p.ctrl_end_tail.len() > 0 -> p.ctrl_end_tail.clear()
                loop pos in 0..<prefix_len {
                    p.edge_offs.push(p.pos)
                    patch_cf_barrier(p)
                    loop u in p.edge_gs[pos]..<p.edge_ge[pos] {
                        if p.drop.has_moves && p.drop.kill[u] -> next
                        ir_x64_debug_line(p.lines, p.pos, ir_code_line_source(f.code_line[u]))
                        patch_emit_op(p, fast, m, f, u)
                    }
                }
                patch_jmp_to(p, tail_off)
                next_off := tail_off
                pos := prefix_len - 1
                loop pos >= 0 {
                    s: p.edge_gs[pos]
                    e: p.edge_ge[pos]
                    off: p.edge_offs[pos]
                    p.g_hash.push(patch_group_hash(f, s, e))
                    p.g_next.push(next_off)
                    p.g_start.push(s)
                    p.g_end.push(e)
                    p.g_off.push(off)
                    next_off = off
                    pos -= 1
                }
            }
            idx -= 1
            next
        }
        if patch_stop_edge_is_drop_chain(f, branch, end_idx) {
            if p.edge_drops.len() > 0 -> p.edge_drops.clear()
            loop k in (branch + 1)..<(end_idx - 1) {
                if f.op[k] == .Drop && !(p.drop.has_moves && p.drop.kill[k]) -> p.edge_drops.push(k)
            }
            tail_off := exit
            prefix_len := p.edge_drops.len()
            loop prefix_len > 0 {
                slot: f.a[p.edge_drops[prefix_len - 1]]
                found: patch_suffix_find(p, slot, tail_off)
                if found < 0 -> break
                tail_off = found
                prefix_len -= 1
            }
            if prefix_len == 0 {
                p.stop_edges[idx].offset = tail_off
                if hot_site >= 0 -> patch_rel32(p.code, hot_site, tail_off)
            } else {
                entry_off: p.pos
                p.stop_edges[idx].offset = entry_off
                if hot_site >= 0 -> patch_rel32(p.code, hot_site, entry_off)
                if p.edge_offs.len() > 0 -> p.edge_offs.clear()
                loop pos in 0..<prefix_len {
                    k: p.edge_drops[pos]
                    p.edge_offs.push(p.pos)
                    ir_x64_debug_line(p.lines, p.pos, ir_code_line_source(f.code_line[k]))
                    patch_drop(p, fast, m, f, k)
                }
                patch_jmp_to(p, tail_off)
                next_off := tail_off
                pos := prefix_len - 1
                loop pos >= 0 {
                    slot: f.a[p.edge_drops[pos]]
                    off: p.edge_offs[pos]
                    p.suffix_slot.push(slot)
                    p.suffix_next.push(next_off)
                    p.suffix_off.push(off)
                    next_off = off
                    pos -= 1
                }
            }
            idx -= 1
            next
        }
        here: p.pos
        p.stop_edges[idx].offset = here
        if hot_site >= 0 -> patch_rel32(p.code, hot_site, here)
        if p.ctrl_open.len() > 0 -> p.ctrl_open.clear()
        if p.ctrl_head.len() > 0 -> p.ctrl_head.clear()
        if p.ctrl_false.len() > 0 -> p.ctrl_false.clear()
        if p.ctrl_end_head.len() > 0 -> p.ctrl_end_head.clear()
        if p.ctrl_end_tail.len() > 0 -> p.ctrl_end_tail.clear()
        o_start: p.stop_edges[idx].open_start
        o_len: p.stop_edges[idx].open_len
        loop i in 0..<o_len {
            p.ctrl_open.push(p.edge_open[o_start + i])
            p.ctrl_head.push(p.edge_heads[o_start + i])
            p.ctrl_false.push(-1)
            p.ctrl_end_head.push(-1)
            p.ctrl_end_tail.push(-1)
        }
        patch_cf_barrier(p)
        patch_ctrl_open(p, branch, -1, -1)
        loop k in (branch + 1)..<end_idx {
            if p.drop.has_moves && p.drop.kill[k] -> next
            ir_x64_debug_line(p.lines, p.pos, ir_code_line_source(f.code_line[k]))
            patch_emit_op(p, fast, m, f, k)
        }
        patch_ctrl_end(p, f, end_idx)
        last_op: f.op[end_idx - 1]
        if last_op != .Return && last_op != .Br && last_op != .Unreachable {
            patch_jmp_to(p, p.stop_edges[idx].resume)
        }
        idx -= 1
    }
    p.in_stop_edge = false
}

// ---------------------------------------------------------------------------
// Cold slow paths & stack-grow path.

patch_cold_target: fn(p: &IRPatchEmitter, pad: Int, exit: Int) -> Int Never! {
    if pad >= 0 && pad < p.stop_edges.len() && p.stop_edges[pad].offset >= 0 {
        return p.stop_edges[pad].offset
    }
    exit
}

patch_emit_cold_drop: fn(p: &IRPatchEmitter, fast: IRX64FastModule, f: IRFunction, slot: Int) Never! {
    if slot < 0 -> return
    trow: f.slot_type[slot]
    if !fast.type_has_drop[trow] -> return
    patch_load_slot(p, 7, slot)
    fid: fast.type_drop_fn[trow]
    if fid >= 0 {
        patch_call_out(p, f, x64_reloc_function(0, fid), false, -1)
    } else {
        patch_call_out(p, f, patch_make_rt(fast, 0, fast.type_drop_rt_id[trow]), false, -1)
    }
}

patch_emit_colds: fn(p: &IRPatchEmitter, fast: IRX64FastModule, m: IRModule, f: IRFunction, exit: Int) Never! {
    loop cold in p.colds {
        patch_cf_barrier(p)
        p.at = if cold.kind == .Poll || cold.kind == .Release -> -1 else -> cold.at
        here: p.pos
        loop k in cold.site_start..<(cold.site_start + cold.site_len) {
            patch_rel32(p.code, p.cold_sites[k], here)
        }
        if cold.kind == {
            .Route -> {
                if cold.left >= 0 -> patch_load_slot(p, 7, cold.left) else -> patch_mov_ri(p, 7, 0)
                if cold.right >= 0 -> patch_load_slot(p, 6, cold.right) else if cold.right_imm != 0 {
                    patch_mov_ri(p, 6, cold.right_imm)
                }
                patch_call_out(p, f, patch_make_rt(fast, 0, cold.sym_id), false, -1)
                if cold.dst >= 0 -> patch_store_slot(p, cold.dst, 0)
                if cold.drop0 >= 0 || cold.drop1 >= 0 {
                    p.at = -1
                    patch_emit_cold_drop(p, fast, f, cold.drop0)
                    patch_emit_cold_drop(p, fast, f, cold.drop1)
                }
                if !cold.falls -> patch_jmp_to(p, cold.resume)
            }
            .LocatedRoute -> {
                path: patch_file_text(p, f)
                patch_load_slot(p, 7, cold.left)
                patch_load_slot(p, 6, cold.right)
                site: patch_lea_rip(p, 2)
                patch_reloc_data(p, site, path)
                path_len: patch_use_len(p, path)
                patch_mov_ri(p, 1, path_len)
                patch_mov_ri(p, 8, cold.line)
                patch_call_out(p, f, patch_make_rt(fast, 0, cold.sym_id), false, -1)
                if m.stop_points && patch_located_stops_cold(f, cold) {
                    if 16 > p.below -> p.below = 16
                    patch_ensure(p, 4)
                    p.pos = o0_st_push_rax2(p.code, p.pos)
                    patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_SESSION_PROPAGATE), false, -1)
                    patch_ensure(p, 12)
                    p.pos = o0_st_test_rax_rax(p.code, p.pos)
                    p.pos = o0_st_pop_rax2(p.code, p.pos)
                    stopped: patch_jcc(p, 5)
                    tgt: patch_cold_target(p, cold.pad, exit)
                    patch_rel32(p.code, stopped, tgt)
                }
                patch_store_slot(p, cold.dst, 0)
                if !cold.falls -> patch_jmp_to(p, cold.resume)
            }
            .Compare -> {
                patch_load_slot(p, 7, cold.left)
                patch_load_slot(p, 6, cold.right)
                patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_INT_COMPARE), false, -1)
                if cold.drop0 >= 0 || cold.drop1 >= 0 {
                    if 16 > p.below -> p.below = 16
                    patch_ensure(p, 4)
                    p.pos = o0_st_push_rax2(p.code, p.pos)
                    p.at = -1
                    patch_emit_cold_drop(p, fast, f, cold.drop0)
                    patch_emit_cold_drop(p, fast, f, cold.drop1)
                    patch_ensure(p, 4)
                    p.pos = o0_st_pop_rax2(p.code, p.pos)
                }
                patch_ensure(p, 12)
                p.pos = o0_st_cmp_rax_i8(p.code, p.pos, 0)
                if cold.dst >= 0 {
                    p.pos = o0_st_setcc_rax(p.code, p.pos, cold.cc)
                    patch_store_slot(p, cold.dst, 0)
                }
                if !cold.falls -> patch_jmp_to(p, cold.resume)
            }
            .Release -> {
                patch_load_slot(p, 7, cold.left)
                patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_BLOCK_RELEASE), false, -1)
                patch_ensure(p, 6)
                p.pos = o0_st_movzx8_rax(p.code, p.pos)
                patch_store_slot(p, cold.dst, 0)
                if !cold.falls -> patch_jmp_to(p, cold.resume)
            }
            .Stop -> {
                path: patch_file_text(p, f)
                s_path: patch_lea_rip(p, 7)
                patch_reloc_data(p, s_path, path)
                path_len: patch_use_len(p, path)
                patch_mov_ri(p, 6, path_len)
                patch_mov_ri(p, 2, cold.line)
                s_msg: patch_lea_rip(p, 1)
                patch_reloc_data(p, s_msg, cold.text)
                msg_len: patch_use_len(p, cold.text)
                patch_mov_ri(p, 8, msg_len)
                patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_NUMERIC_STOP), false, -1)
                tgt: patch_cold_target(p, cold.pad, exit)
                if m.stop_points -> patch_jmp_to(p, tgt) else {
                    patch_ensure(p, 4)
                    p.pos = o0_st_ud2(p.code, p.pos)
                }
            }
            .ShiftStop -> {
                path: patch_file_text(p, f)
                patch_mov_ri(p, 7, cold.direction)
                patch_load_slot(p, 6, cold.right)
                patch_mov_ri(p, 2, cold.unsigned)
                patch_mov_ri(p, 1, cold.width)
                s_path: patch_lea_rip(p, 8)
                patch_reloc_data(p, s_path, path)
                path_len: patch_use_len(p, path)
                patch_mov_ri(p, 9, path_len)
                if 16 > p.below -> p.below = 16
                patch_ensure(p, 6)
                p.pos = o0_st_sub_rsp_i8(p.code, p.pos, 8)
                patch_mov_ri(p, 11, cold.line)
                patch_ensure(p, 4)
                p.pos = o0_st_push_r11(p.code, p.pos)
                patch_call_out(p, f, patch_make_rt(fast, 0, O0_RT_FIXED_SHIFT_STOP), false, -1)
                tgt: patch_cold_target(p, cold.pad, exit)
                if tgt != exit {
                    patch_ensure(p, 6)
                    p.pos = o0_st_add_rsp_i8(p.code, p.pos, 16)
                }
                if m.stop_points -> patch_jmp_to(p, tgt) else {
                    patch_ensure(p, 4)
                    p.pos = o0_st_ud2(p.code, p.pos)
                }
            }
            .Poll -> {
                at: cold.left
                patch_call_out(p, f, x64_reloc_function(0, f.a[at]), false, -1)
                patch_ensure(p, 10)
                p.pos = o0_st_test_rax_rax(p.code, p.pos)
                stopped: patch_jcc(p, 5)
                tgt: patch_cold_target(p, cold.pad, exit)
                patch_rel32(p.code, stopped, tgt)
                patch_jmp_to(p, cold.resume)
            }
            .Unique -> {
                at: cold.left
                q0 := -1
                q1 := -1
                if cold.right >= 0 {
                    q0 = patch_jcc(p, 8)
                    patch_load_slot(p, 0, cold.right)
                    patch_ensure(p, 10)
                    p.pos = o0_st_load_rcx_rax_0(p.code, p.pos)
                    p.pos = o0_st_test_rcx_rcx(p.code, p.pos)
                    q1 = patch_jcc(p, 4)
                }
                patch_call(p, fast, f, x64_reloc_function(0, f.a[at]), -1, f.args, f.b[at], f.c[at], -1, -1)
                patch_jmp_to(p, cold.resume)
                if q0 >= 0 {
                    written: p.pos
                    patch_rel32(p.code, q0, written)
                    patch_rel32(p.code, q1, written)
                    patch_ensure(p, 4)
                    p.pos = o0_st_zero_rdx(p.code, p.pos)
                    patch_jmp_to(p, cold.resume)
                }
            }
            .Call | .Fma -> {
                at: cold.left
                patch_call(p, fast, f, patch_make_rt(fast, 0, cold.sym_id), -1, f.args, f.b[at], f.c[at], f.dst[at], -1)
                if !cold.falls -> patch_jmp_to(p, cold.resume)
            }
        }
    }
}

patch_stack_grow: fn(p: &IRPatchEmitter, fast: IRX64FastModule, row: Int, entered: Int, frame: Int, stacked: Int) -> IRX64Grow Never! {
    patch_ensure(p, 512 + stacked * 20)
    start: p.pos
    p.pos = o0_st_prologue(p.code, start, IR_X64_STACK_SAVES)
    pushed: start + 1
    based: start + 4
    p.pos = o0_st_stack_save_rbp(p.code, p.pos)
    copied: 32 + 16 * ((stacked + 1) /% 2)
    patch_mov_ri(p, 7, frame + copied + 64)
    p.pos = o0_st_mov_rsi_rsp(p.code, p.pos)
    cb: p.pos
    p.pos = o0_st_call_rel32(p.code, cb)
    patch_reloc_rt_id(p, fast, cb + 1, O0_RT_STACK_GROW)
    p.pos = o0_st_test_rax_rax(p.code, p.pos)
    in_place: patch_jcc(p, 4)
    p.pos = o0_st_stack_bridge(p.code, p.pos, IR_X64_STACK_BRIDGE)
    loop k in 0..<stacked {
        patch_load_rbp(p, 11, 16 + 8 * k)
        patch_ensure(p, 12)
        p.pos = o0_st_store_rax_r11_32(p.code, p.pos, 8 * k - copied)
    }
    patch_ensure(p, 256)
    p.pos = o0_st_stack_switch(p.code, p.pos, 0 - copied)
    p.pos = o0_st_stack_restore_r11(p.code, p.pos)
    again: p.pos
    p.pos = o0_st_call_rel32(p.code, again)
    patch_reloc_fn(p, again + 1, row)
    p.pos = o0_st_stack_after(p.code, p.pos, copied - 32, 0 - IR_X64_STACK_SAVES)
    shrunk: p.pos
    p.pos = o0_st_call_rel32(p.code, shrunk)
    patch_reloc_rt_id(p, fast, shrunk + 1, O0_RT_STACK_SHRINK)
    p.pos = o0_st_stack_tail(p.code, p.pos)
    returned: p.pos - 1
    resumed: p.pos
    patch_rel32(p.code, in_place, resumed)
    p.pos = o0_st_stack_restore_rbp(p.code, p.pos)
    p.pos = o0_st_leave(p.code, p.pos)
    left: p.pos
    patch_jmp_to(p, entered)
    IRX64Grow{start: start, pushed: pushed, based: based, returned: returned, resumed: resumed, left: left}
}

// ---------------------------------------------------------------------------
// Main entry point for copy-and-patch O0 function compilation.

ir_x64_patch_function: fn(m: IRModule, row: Int, poll: Int, trap: Int, turn: Int) -> IRX64FunctionResult Never! {
    p := ir_patch_emitter_new()
    fast := ir_x64_fast_module_new(m, false)
    ir_x64_patch_function_in(m, fast, row, poll, trap, turn, p)
}

ir_x64_patch_function_in: fn(m: IRModule, fast: IRX64FastModule, row: Int, poll: Int, trap: Int, turn: Int, p: &IRPatchEmitter) -> IRX64FunctionResult Never! {
    f: m.functions[row]
    slot_count: f.slot_type.len()
    op_count: f.op.len()
    patch_emitter_reset(p, op_count, slot_count)
    // 1. O(slots) direct home assignment: skip Unit slots; slots 0..15 fit disp8.
    loop slot in 0..<slot_count {
        if fast.type_class[f.slot_type[slot]] == O0_CLS_EMPTY {
            p.homes[slot] = 0
        } else {
            p.depth += 8
            p.homes[slot] = 0 - p.depth
        }
    }
    if f.result >= 0 && fast.type_kind[f.result] == O0_KIND_AGGREGATE {
        p.depth += 8
        p.result_home = 0 - p.depth
    }
    // Zero-allocation early-drop planning (+ the frame bytes emission adds, for G3).
    if !m.dropped_early {
        ir_drop_plan_into(p.drop, m, fast, f, poll, trap, turn)
    } else {
        p.drop.has_moves = false
        p.drop.frame_bytes = 0
        loop at in 0..<op_count -> p.drop.frame_bytes += ir_drop_frame_bytes(fast, f, at, f.op[at])
    }
    if f.line > 0 -> p.lines.push(X64LineRow{at: 0, line: f.line})
    // 2. Stack check prefix (G3: f.stack_check OR the frame bound > 32768).
    stack_frame_site := -1
    grow_site := -1
    if f.stack_check || p.depth + p.drop.frame_bytes > 32768 {
        patch_ensure(p, 28)
        sb: p.pos
        p.pos = o0_st_stack_check_large(p.code, sb, 0, IR_X64_STACK_LIMIT)
        stack_frame_site = sb + 4
        grow_site = sb + 19
    }
    entered: p.pos
    // 3. Prologue stencil (sub rsp imm32 back-patched after single pass).
    patch_ensure(p, 16)
    pro_base: p.pos
    p.pos = o0_st_prologue(p.code, pro_base, 0)
    pushed: pro_base + 1
    based: pro_base + 4
    sub_rsp_site: pro_base + 7
    // 4. Import parameters into their fixed frame homes.
    general := 0
    floats := 0
    stacked := 0
    if p.result_home != 0 {
        patch_store_rbp(p, p.result_home, 7)
        general = 1
    }
    loop slot in 0..<f.param_count {
        trow: f.slot_type[slot]
        cls: fast.type_class[trow]
        if cls == O0_CLS_EMPTY -> next
        if cls == O0_CLS_FLOAT && floats < 8 {
            patch_store_xmm(p, fast.type_kind[trow] == O0_KIND_FLOAT32, p.homes[slot], floats)
            floats += 1
            next
        }
        if cls != O0_CLS_FLOAT && general < 6 {
            reg: IR_X64_ARGUMENT_REGISTERS[general]
            patch_normalize_row(p, fast, trow, reg)
            patch_store_rbp(p, p.homes[slot], reg)
            general += 1
            next
        }
        patch_load_rbp(p, 0, 16 + 8 * stacked)
        p.rax_slot = -1
        stacked += 1
        if cls != O0_CLS_FLOAT -> patch_normalize_row(p, fast, trow, 0)
        patch_store_rbp(p, p.homes[slot], 0)
    }
    p.rax_slot = -1
    body: p.pos
    if f.line > 0 -> ir_x64_debug_line(p.lines, body, f.line)
    // 5. Single forward pass over all IR instructions.
    traps := 0
    at := 0
    loop at < op_count {
        if p.drop.has_moves {
            dk := p.drop.head[at]
            if dk >= 0 {
                p.fused_slot = -1
                p.fused_cc = -1
                p.rax_slot = -1
                loop dk >= 0 {
                    ir_x64_debug_line(p.lines, p.pos, ir_code_line_source(p.drop.lines[dk]))
                    patch_drop_slot(p, fast, m, f, p.drop.slots[dk], -1)
                    dk = p.drop.chain[dk]
                }
            }
        }
        if at <= p.skip_to || (p.drop.has_moves && p.drop.kill[at]) {
            at += 1
            next
        }
        p.at = at
        ir_x64_debug_line(p.lines, p.pos, ir_code_line_source(f.code_line[at]))
        stop_end: patch_stop_point(p, fast, m, f, at, poll, trap, turn, traps)
        traps = p.colds.len()
        if stop_end > at {
            p.fused_slot = -1
            p.fused_cc = -1
            p.rax_slot = -1
            at = stop_end + 1
            next
        }
        patch_emit_op(p, fast, m, f, at)
        at += 1
    }
    p.at = -1
    if p.ctrl_open.len() > 0 {
        p.errors.push("{f.name}: {p.ctrl_open.len()} structured constructs are never closed")
    }
    // 6. Epilogue & stop exit stencils.
    patch_ensure(p, 24)
    epilogue: p.pos
    p.pos = if p.has_stream -> o0_st_epilogue_sfence(p.code, p.pos) else -> o0_st_epilogue(p.code, p.pos)
    ret_at: p.pos - 1
    exit := epilogue
    need_exit := p.stop_returns.len() > 0 || (m.stop_points && p.stop_edges.len() > 0)
    if !need_exit && m.stop_points {
        loop cold in p.colds {
            if cold.kind == .Stop || cold.kind == .ShiftStop || cold.kind == .LocatedRoute || cold.kind == .Poll {
                need_exit = true
                break
            }
        }
    }
    if need_exit {
        exit = p.pos
        p.pos = if p.has_stream -> o0_st_stop_exit_sfence(p.code, p.pos) else -> o0_st_stop_exit(p.code, p.pos)
    }
    // 7. Out-of-line stop edges, zone stubs, and cold slow paths.
    patch_emit_stop_edges(p, fast, m, f, exit)
    loop site in p.returns -> patch_rel32(p.code, site, epilogue)
    loop site in p.stop_returns -> patch_rel32(p.code, site, exit)
    if p.zone_stubs.len() > 0 {
        p.in_stub = true
        loop stub in p.zone_stubs {
            patch_cf_barrier(p)
            patch_rel32(p.code, stub.site, p.pos)
            p.at = stub.at
            reloc: if stub.sym_id >= 0 -> patch_make_rt(fast, 0, stub.sym_id) else -> x64_reloc_runtime(0, m.names[stub.name_row])
            patch_call(p, fast, f, reloc, -1, f.args, f.b[stub.at], f.c[stub.at], stub.dst, -1)
            patch_jmp_to(p, stub.resume)
            p.stub_ends.push(p.pos)
        }
        p.in_stub = false
    }
    patch_emit_colds(p, fast, m, f, exit)
    // 8. Back-patch frame size & optional stack grow path.
    frame_bytes: ir_x64_align(p.depth, 16)
    o0_patch_i32(p.code, sub_rsp_site, frame_bytes)
    grow := IRX64Grow{start: -1, pushed: -1, based: -1, returned: -1, resumed: -1, left: -1}
    if grow_site >= 0 {
        o0_patch_i32(p.code, stack_frame_site, 0 - (16 + frame_bytes))
        grow = patch_stack_grow(p, fast, row, entered, 16 + frame_bytes + p.below, stacked)
        patch_rel32(p.code, grow_site, grow.start)
    }
    // 9. Zone site opcodes (stamped as off-by-default `test eax, imm32`).
    zones := [Int]{}
    loop site in p.zone_sites -> zones.push(site - 1)
    // 10. Merge call rows into line table if any.
    if !p.call_rows.is_empty() {
        merged := [X64LineRow]{}
        merged.try_reserve(p.lines.len() + p.call_rows.len() * 2) ?? panic("reserve failed")
        next_row := 0
        statement := 0
        loop (k, call) in p.call_rows {
            loop next_row < p.lines.len() && p.lines[next_row].at <= call.at {
                statement = p.lines[next_row].line
                merged.push(p.lines[next_row])
                next_row += 1
            }
            if call.line <= 0 -> next
            merged.push(X64LineRow{at: call.at, line: call.line, column: call.column, call: true})
            back: p.call_returns[k]
            resumed: (next_row < p.lines.len() && p.lines[next_row].at == back) || (k + 1 < p.call_rows.len() && p.call_rows[k + 1].at == back && p.call_rows[k + 1].line > 0)
            if statement > 0 && !resumed {
                merged.push(X64LineRow{at: back, line: statement, call: true})
            }
        }
        loop next_row < p.lines.len() {
            merged.push(p.lines[next_row])
            next_row += 1
        }
        p.lines = merged.move()
    }
    // 11. Standard frame CFI (+ tail jumps + ret + optional grow path).
    cfi := [U8]{}
    dwarf_cfa_advance(cfi, 0, pushed)
    dwarf_cfa_def_cfa_offset(cfi, 16)
    dwarf_cfa_offset(cfi, x64_dwarf_register(X64_RBP), 2)
    dwarf_cfa_advance(cfi, pushed, based)
    dwarf_cfa_def_cfa_register(cfi, x64_dwarf_register(X64_RBP))
    cfa_at := based
    loop jump in p.tails {
        dwarf_cfa_advance(cfi, cfa_at, jump)
        dwarf_cfa_remember_state(cfi)
        dwarf_cfa_def_cfa(cfi, x64_dwarf_register(X64_RSP), 8)
        dwarf_cfa_same_value(cfi, x64_dwarf_register(X64_RBP))
        dwarf_cfa_advance(cfi, jump, jump + 5)
        dwarf_cfa_restore_state(cfi)
        cfa_at = jump + 5
    }
    dwarf_cfa_advance(cfi, cfa_at, ret_at)
    dwarf_cfa_remember_state(cfi)
    dwarf_cfa_def_cfa(cfi, x64_dwarf_register(X64_RSP), 8)
    dwarf_cfa_same_value(cfi, x64_dwarf_register(X64_RBP))
    dwarf_cfa_advance(cfi, ret_at, ret_at + 1)
    dwarf_cfa_restore_state(cfi)
    if grow.start >= 0 {
        dwarf_cfa_advance(cfi, ret_at + 1, grow.start)
        dwarf_cfa_def_cfa(cfi, x64_dwarf_register(X64_RSP), 8)
        dwarf_cfa_same_value(cfi, x64_dwarf_register(X64_RBP))
        dwarf_cfa_advance(cfi, grow.start, grow.pushed)
        dwarf_cfa_def_cfa_offset(cfi, 16)
        dwarf_cfa_offset(cfi, x64_dwarf_register(X64_RBP), 2)
        dwarf_cfa_advance(cfi, grow.pushed, grow.based)
        dwarf_cfa_def_cfa_register(cfi, x64_dwarf_register(X64_RBP))
        dwarf_cfa_advance(cfi, grow.based, grow.returned)
        dwarf_cfa_remember_state(cfi)
        dwarf_cfa_def_cfa(cfi, x64_dwarf_register(X64_RSP), 8)
        dwarf_cfa_same_value(cfi, x64_dwarf_register(X64_RBP))
        dwarf_cfa_advance(cfi, grow.returned, grow.resumed)
        dwarf_cfa_restore_state(cfi)
        dwarf_cfa_advance(cfi, grow.resumed, grow.left)
        dwarf_cfa_def_cfa(cfi, x64_dwarf_register(X64_RSP), 8)
        dwarf_cfa_same_value(cfi, x64_dwarf_register(X64_RBP))
    }
    // 12. Flat fixed-frame debug variables over [body..epilogue] (no O0 call sites).
    variables := [X64DebugVariable]{}
    ranges := [X64VariableRange]{}
    loop slot in 0..<slot_count {
        name_id: f.slot_name[slot]
        if name_id < 0 -> next
        if p.homes[slot] == 0 -> next
        var_id: variables.len()
        variables.push(
            X64DebugVariable{
                name: m.names[name_id],
                ty: f.slot_type[slot],
                parameter: slot < f.param_count || f.slot_formal[slot],
                line: f.slot_line[slot],
                indirect: fast.type_kind[f.slot_type[slot]] == O0_KIND_AGGREGATE,
                site: f.slot_site[slot],
            },
        )
        if epilogue > body {
            ranges.push(X64VariableRange{variable: var_id, start: body, end: epilogue, location: X64DebugLocation.Frame{offset: p.homes[slot]}})
        }
    }
    allocs: loop (k, reloc) in p.alloc_relocs -> X64AllocSite{at: p.relocs[reloc].at + 4, ty: p.alloc_rows[k]}
    // Materialize exact code bytes from reusable worker buffer in one memcpy.
    code_out := [U8]{}
    code_out.try_reserve(p.pos) ?? panic("reserve failed")
    code_out.extend(p.code[0..<p.pos])
    name: if {
        f.symbol != "" -> f.symbol
        f.key != "" -> f.key
        else -> f.name
    }
    IRX64FunctionResult{
        function: X64CompiledFunction{
            id: X64FunctionID{value: row},
            name: name,
            code: code_out.move(),
            relocs: compiler_take_rows<X64Reloc>(p.relocs),
            align: X64_FUNCTION_ALIGN,
            zones: zones.move(),
            zone_ends: compiler_take_rows<Int>(p.stub_ends),
        },
        debug: X64FunctionDebug{
            lines: compiler_take_rows<X64LineRow>(p.lines),
            body: body,
            cfi: cfi.move(),
            ranges: ranges.move(),
            stack: 16 + frame_bytes + p.below,
            dynamic: p.dynamic,
            inlines: [X64InlineRange]{},
            allocs: allocs,
            calls: [X64CallSite]{},
        },
        variables: variables.move(),
        errors: compiler_take_rows<String>(p.errors),
        log: [String]{},
        uses: IRX64Uses{
            kinds: compiler_take_rows<IRX64UseKind>(p.uses.kinds),
            data: compiler_take_rows<Int>(p.uses.data),
            texts: compiler_take_rows<String>(p.uses.texts),
        },
        local_relocs: compiler_take_rows<Int>(p.local_relocs),
    }
}

#Test("copy-and-patch O0 stencils compile arithmetic, control flow, and folded constants cleanly") {
    m := ir_module_new()
    m.fast_o0 = true
    i64_row: ir_type_row(m, Type.IntN{signed: true, bits: 64}) ?? panic("no I64 row")
    bool_row: ir_type_row(m, Type.Bool) ?? panic("no Bool row")
    f := ir_function_new("sum", "test:patch.jet.sum", "", "patch.jet", 1)
    a: ir_slot(f, i64_row, IRSlotKind.Param, ir_intern_name(m, "a"), 1)
    b: ir_slot(f, i64_row, IRSlotKind.Param, ir_intern_name(m, "b"), 1)
    f.result = i64_row
    one: ir_slot(f, i64_row, IRSlotKind.Temp, -1, 0)
    out: ir_slot(f, i64_row, IRSlotKind.Temp, -1, 0)
    cond: ir_slot(f, bool_row, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Const, one, 1, -1, -1, 2)
    _ := ir_emit(f, IROp.Add, out, a, one, IR_OVERFLOW_WRAP, 2)
    _ := ir_emit(f, IROp.Lt, cond, a, b, IR_OVERFLOW_WRAP, 3)
    if_at: ir_open_if(f, cond, 3)
    _ := ir_emit(f, IROp.Sub, out, out, b, IR_OVERFLOW_WRAP, 4)
    ir_end(f, 5)
    _ := ir_emit(f, IROp.Return, -1, out, -1, -1, 6)
    _ := if_at
    row: m.functions.len()
    m.functions.push(f)
    compiled: ir_x64_patch_function(m, row, -1, -1, -1)
    assert(compiled.errors.is_empty())
    assert(compiled.function.code.len() > 20)
    assert(O0_STENCIL_COUNT >= 300)
}
