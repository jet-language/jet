// The IR builder's Maps: a Map is a List of its (key, value) entry tuples,
// the same 24-byte header (len, cap, data); iteration, display and every
// ordered read see the entries in BTreeMap order. Its operations are helper
// functions built once per Map type (map.find, map.set, map.add, map.get,
// map.remove, map.insert, and for a hashed Map map.order, map.merge,
// map.settle, map.rebuild, map.grow).
//
// A Map whose keys hash (exact Int, word and String keys, ir_map_hashed)
// keeps a hash index behind its counted buffer's `cap` entries: a trailer of
// the sorted count `s`, the slot mask (slots - 1, the slots a power of two of
// at least twice the capacity and 8), then the slots. Entries [0, s) are in
// ascending key order; a new key is appended after them, and the tail is
// merged in when a write site settles it or a frozen buffer is copied
// (map.rebuild); growing the buffer (map.grow) keeps the tail where it is,
// so a Map only ever read by key never sorts. A slot is 0 when empty, else
// (tag << 32) | (position + 1), the tag the
// key's 31-bit hash (ir_map_tag), found by linear probing from tag & mask; a
// removal shifts the later entries down and the probe run back, so no slot
// ever names a removed entry. A read that needs key order gets the entries
// merged into a temporary buffer (map.order); a read never writes the Map. A
// frozen buffer (capacity 0: static, empty) has no trailer: its entries are
// all in order, found by binary search, as every Map of other keys is.

use jet_foundation.[Span, Type, TBinaryOp, BodyMapEntry, BodyOrFallback, StmtKind, TypeTupleField, TPanicLoc, TPanicLocal, body_each_expr_child, body_each_stmt_child, name_rows_set, name_rows_value, symbol_none, type_carrier_identity]

// The entry tuple `(key: K, value: V)` of a Map type, None for any other.
ir_map_entry_type: fn(ty: Type) -> Type? Never! {
    if ir_untag(ty) == .Map(key, _, value) {
        return Val(Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: key}, TypeTupleField{name: "value", ty: value}}})
    }
    None
}

// The row of a Map type whose keys have an order the builder knows and
// whose keys and values lay out (the entries live behind the header's
// buffer pointer, so a struct being laid out may hold a Map of itself).
ir_map_row: fn(m: &IRModule, p: IRProgram, ty: Type, laying: [String]) -> Int? Never! {
    if ir_untag(ty) == .Map(key, _, value) {
        if !ir_pointee_lays_out(m, p, key, laying) || !ir_pointee_lays_out(m, p, value, laying) -> return None
        if ir_unit_type(ir_untag(value)) -> return None
        key_row: ir_value_type_in(m, p, key, laying) ?? return None
        if ir_map_key_kind(m, key_row) == "" -> return None
        interned: ir_intern_type(m, type_carrier_identity(ty), ir_layout(IRTypeKind.Aggregate, ty, 24, 8, IRClass.Pointer, false, 64, ""))
        return Val(ir_mark_counted(m, interned))
    }
    None
}

// One Map type's entry layout and key order ("int": exact Int, "string":
// byte order, "word"/"uword": a signed/unsigned word's integer order,
// "order": a tuple, List or Option of ordered members, the Rust derived Ord).
IRMapShape: struct { entry: Int, entry_ty: Type, key: IRMember, value: IRMember, value_ty: Type, stride: Int, kind: String }

ir_map_shape: fn(m: &IRModule, p: IRProgram, map_row: Int) -> IRMapShape? Never! {
    entry_ty: ir_map_entry_type(m.types[map_row].ty) ?? return None
    fields: if entry_ty == .Tuple(fields) -> fields else -> { return None }
    entry: ir_value_type(m, p, entry_ty) ?? return None
    members: ir_tuple_members(m, p, fields) ?? return None
    if members.len() != 2 -> return None
    Val(IRMapShape{entry: entry, entry_ty: entry_ty, key: members[0], value: members[1], value_ty: fields[1].ty, stride: ir_list_stride(m, entry), kind: ir_map_key_kind(m, members[0].ty)})
}

ir_map_key_kind: fn(m: IRModule, row: Int) -> String Never! {
    if m.types[row].kind == {
        .Int -> "int"
        .String -> "string"
        .Word -> if m.types[row].signed -> "word" else -> "uword"
        .Char | .Bool -> "word"
        .Aggregate | .Pointer -> if ir_ordered_type(m.types[row].ty) -> "order" else -> ""
        .Unit | .Float | .Float32 -> ""
    }
}

// True when ir_order_into orders `ty`: a tuple, List or Option, or a
// declared struct or enum, which sema checked Comparable, by its helper or
// its user Comparable impl.
ir_ordered_type: fn(ty: Type) -> Bool Never! {
    if ir_untag(ty) == {
        .Int | .String | .Bool | .Char -> true
        .IntN(_, _) -> true
        .Option(inner) -> ir_ordered_type(inner)
        .List(element) -> ir_ordered_type(element)
        .Tuple(fields) -> {
            loop field in fields {
                if !ir_ordered_type(field.ty) -> return false
            }
            true
        }
        .Named(_) | .Apply(_, _) -> true
        .Float | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// `left < right` and `left == right` for two keys.
IRMapOrder: struct { less: Int, same: Int }

ir_map_order: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, kind: String, left: Int, right: Int) -> IRMapOrder Never! {
    if kind == "string" || kind == "order" {
        word_row: ir_word_row(m)
        order: if kind == "string" -> ir_runtime(m, b, "jet_rt_string_compare", [Int]{left, right}, word_row) else -> ir_order_sign(m, p, b, left, right, Span{start: 0, end: 0})
        zero: ir_word_const(m, b, 0)
        return IRMapOrder{less: ir_bool_op(m, b, IROp.Lt, order, zero), same: ir_bool_op(m, b, IROp.Eq, order, zero)}
    }
    IRMapOrder{less: ir_bool_op(m, b, IROp.Lt, left, right), same: ir_bool_op(m, b, IROp.Eq, left, right)}
}

// Whether a Map of `shape` keeps a hash index in its buffer's trailer: its
// keys hash (ir_map_tag) and its entries are whole words, so the trailer
// after them is word aligned.
ir_map_hashed: fn(shape: IRMapShape) -> Bool Never! {
    hashing: shape.kind == "int" || shape.kind == "word" || shape.kind == "uword" || shape.kind == "string"
    hashing && shape.stride %% 8 == 0
}

// Whether the type row `row` is a Map, Set or Rank row with a hash index
// (ir_map_hashed).
ir_map_row_hashed: fn(m: &IRModule, p: IRProgram, row: Int) -> Bool Never! {
    shape: ir_keyed_shape(m, p, row) ?? return false
    ir_map_hashed(shape)
}

// The entry layout of the Map row `row`, or of the Set or Rank row `row`
// (ir_set_shape: the key alone); None for any other row.
ir_keyed_shape: fn(m: &IRModule, p: IRProgram, row: Int) -> IRMapShape? Never! {
    if ir_map_entry_type(m.types[row].ty) != None -> return ir_map_shape(m, p, row)
    ir_set_shape(m, p, row)
}

// The id of Map helper `name` of the Map, Set or Rank type row `map_row`,
// built on first use.
ir_map_helper: fn(m: &IRModule, p: IRProgram, map_row: Int, name: String) -> Int Never! {
    key: "{name}<{type_carrier_identity(m.types[map_row].ty)}>"
    if name_rows_value(m.function_rows, key) == .Val(known) -> return known
    shape: ir_keyed_shape(m, p, map_row) ?? panic("Map helper {name} of a type without a Map shape")
    id: m.functions.len()
    symbol: ir_map_helper_symbol(name)
    m.functions.push(ir_hashed_function(name, key, "jet_ir_map_{symbol}_", "", 0))
    name_rows_set(m.function_rows, key, id)
    a := ir_builder_new(m.functions[id].copy())
    map: ir_new_slot(a, map_row, IRSlotKind.Param, ir_intern_name(m, "map"))
    if name == "map.order" {
        ir_map_order_body(m, p, a, shape, map_row, map)
    } else if name == "map.settle" {
        ir_map_settle_body(m, p, a, map_row, map)
    } else if name == "map.merge" {
        target: ir_new_slot(a, ir_word_row(m), IRSlotKind.Param, ir_intern_name(m, "target"))
        ir_map_merge_body(m, p, a, shape, map, target)
    } else if name == "map.rebuild" || name == "map.grow" {
        capacity: ir_new_slot(a, ir_word_row(m), IRSlotKind.Param, ir_intern_name(m, "capacity"))
        ir_map_rebuild_body(m, p, a, shape, map_row, map, capacity, name == "map.rebuild")
    } else {
        probe_key: ir_new_slot(a, shape.key.ty, IRSlotKind.Param, ir_intern_name(m, "key"))
        if name == "map.find" {
            if ir_map_hashed(shape) {
                ir_map_probe_body(m, p, a, shape, map, probe_key)
            } else {
                ir_map_find_body(m, p, a, shape, map, probe_key)
            }
        } else if name == "map.set" || name == "map.insert" {
            value: ir_new_slot(a, shape.value.ty, IRSlotKind.Param, ir_intern_name(m, "value"))
            option_row: if name == "map.insert" -> ir_value_type(m, p, Type.Option{inner: shape.value_ty}) ?? -1 else -> -1
            ir_map_insert_body(m, p, a, shape, map_row, map, probe_key, value, option_row)
        } else if name == "map.add" {
            value: ir_new_slot(a, shape.value.ty, IRSlotKind.Param, ir_intern_name(m, "value"))
            ir_map_add_body(m, p, a, shape, map_row, map, probe_key, value)
        } else {
            option_row: ir_value_type(m, p, Type.Option{inner: shape.value_ty}) ?? -1
            ir_map_take_body(m, p, a, shape, map_row, map, probe_key, option_row, name == "map.remove")
        }
    }
    ir_resolve_deferred(m, p, a)
    m.functions[id] = a.f.move()
    id
}

// The symbol stem of Map helper `name` (jet_ir_map_<stem>_<hash>).
ir_map_helper_symbol: fn(name: String) -> String Never! {
    if name == {
        "map.find" -> "find"
        "map.set" -> "set"
        "map.add" -> "add"
        "map.get" -> "get"
        "map.remove" -> "remove"
        "map.order" -> "order"
        "map.settle" -> "settle"
        "map.merge" -> "merge"
        "map.rebuild" -> "rebuild"
        "map.grow" -> "grow"
        else -> "insert"
    }
}

// Binary search over the ascending entries: the entry's index, or -1 - the
// insertion point when the key is absent.
ir_map_find_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map: Int, key: Int) Never! {
    a.f.result = ir_word_row(m)
    low: ir_map_search(m, p, a, shape, map, key)
    minus_one: ir_word_const(m, a, -1)
    insertion: ir_word_op(m, a, IROp.Sub, minus_one, low)
    ir_emit(a.f, IROp.Return, -1, insertion, -1, -1, a.line)
}

// The binary search of ir_map_find_body: returns the index of an entry
// whose key is `key`; falls through with the insertion point.
ir_map_search: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map: Int, key: Int) -> Int Never! {
    length: ir_load_word(m, a, map, 0)
    data: ir_load_word(m, a, map, 16)
    low: ir_word_const(m, a, 0)
    word_row: ir_word_row(m)
    high: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, high, length, -1, -1, a.line)
    exit: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    open: ir_bool_op(m, a, IROp.Lt, low, high)
    ir_exit_unless(m, a, open, exit)
    span_sum: ir_word_op(m, a, IROp.Add, low, high)
    one: ir_word_const(m, a, 1)
    middle: ir_word_op(m, a, IROp.Shr, span_sum, one)
    entry: ir_element_address(m, a, data, middle, shape.stride)
    probe: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
    order: ir_map_order(m, p, a, shape.kind, probe, key)
    ir_open_if(a.f, order.same, a.line)
    ir_emit(a.f, IROp.Return, -1, middle, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_open_if(a.f, order.less, a.line)
    ir_emit(a.f, IROp.Add, low, middle, one, IR_OVERFLOW_WRAP, a.line)
    ir_else(a.f, a.line)
    ir_emit(a.f, IROp.Copy, high, middle, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    low
}

// The 31-bit hash tag of the key `key` of a hashed Map: a String's runtime
// hash (jet_string_hash); a word key's bits (zero-extended from its width)
// or an exact Int's inline word, times the 64-bit golden ratio, the high
// half folded into the low. Every big Int hashes as 0: an Int in the inline
// range is always inline (Int.jet int_pack), so equal keys hash equal.
ir_map_tag: fn(m: &IRModule, a: &IRBuilder, shape: IRMapShape, key: Int) -> Int Never! {
    word_row: ir_word_row(m)
    low_bits: ir_word_const(m, a, 2147483647)
    if shape.kind == "string" {
        hash: ir_runtime(m, a, "jet_string_hash", [Int]{key}, word_row)
        return ir_word_op(m, a, IROp.BitAnd, hash, low_bits)
    }
    pointer_row: ir_pointer_row(m)
    cell: ir_temp(m, a, pointer_row)
    ir_emit(a.f, IROp.StackAddress, cell, 8, 8, -1, a.line)
    zero: ir_word_const(m, a, 0)
    ir_emit(a.f, IROp.Store, -1, cell, 0, zero, a.line)
    ir_emit(a.f, IROp.Store, -1, cell, 0, key, a.line)
    bits: ir_load_word(m, a, cell, 0)
    word := bits
    if shape.kind == "int" {
        // Inline when bits 62 and 63 agree (int_inline).
        sixty_two: ir_word_const(m, a, 62)
        sixty_three: ir_word_const(m, a, 63)
        top: ir_word_op(m, a, IROp.Shr, bits, sixty_two)
        sign: ir_word_op(m, a, IROp.Shr, bits, sixty_three)
        fits: ir_bool_op(m, a, IROp.Eq, top, sign)
        word = ir_temp(m, a, word_row)
        ir_emit(a.f, IROp.Copy, word, zero, -1, -1, a.line)
        ir_open_if(a.f, fits, a.line)
        ir_emit(a.f, IROp.Copy, word, bits, -1, -1, a.line)
        ir_end(a.f, a.line)
    }
    golden: ir_word_const(m, a, -7046029254386353131)
    mixed: ir_word_op(m, a, IROp.Mul, word, golden)
    thirty_two: ir_word_const(m, a, 32)
    high: ir_word_op(m, a, IROp.Shr, mixed, thirty_two)
    folded: ir_word_op(m, a, IROp.BitXor, mixed, high)
    ir_word_op(m, a, IROp.BitAnd, folded, low_bits)
}

// The address of the trailer of a hashed Map's counted buffer `data` of
// `capacity` entries: its sorted count at 0, its mask at 8, slot `i` at
// 16 + 8 * i.
ir_map_trailer: fn(m: &IRModule, a: &IRBuilder, shape: IRMapShape, data: Int, capacity: Int) -> Int Never! {
    ir_element_address(m, a, data, capacity, shape.stride)
}

// The address of slot `at` of the trailer at `trailer`.
ir_map_slot_address: fn(m: &IRModule, a: &IRBuilder, trailer: Int, at: Int) -> Int Never! {
    sixteen: ir_word_const(m, a, 16)
    slots: ir_word_op(m, a, IROp.Add, trailer, sixteen)
    ir_element_address(m, a, slots, at, 8)
}

// The bytes of a hashed Map's counted buffer of `capacity` entries whose
// index has mask `mask`: the entries, the two trailer words, the slots.
ir_map_block_bytes: fn(m: &IRModule, a: &IRBuilder, shape: IRMapShape, capacity: Int, mask: Int) -> Int Never! {
    width: ir_word_const(m, a, shape.stride)
    entries: ir_word_op(m, a, IROp.Mul, capacity, width)
    three: ir_word_const(m, a, 3)
    words: ir_word_op(m, a, IROp.Add, mask, three)
    eight: ir_word_const(m, a, 8)
    trailer: ir_word_op(m, a, IROp.Mul, words, eight)
    ir_word_op(m, a, IROp.Add, entries, trailer)
}

// The bytes a hashed Map's counted buffer `data` of `capacity` entries
// takes (its mask read from its trailer); `capacity` itself for any other
// row's buffer of entries of `stride` bytes.
ir_buffer_bytes: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int, data: Int, capacity: Int, stride: Int) -> Int Never! {
    if ir_map_row_hashed(m, p, row) {
        shape: ir_keyed_shape(m, p, row) ?? panic("hashed Map row without a Map shape")
        trailer: ir_map_trailer(m, b, shape, data, capacity)
        mask: ir_load_word(m, b, trailer, 8)
        return ir_map_block_bytes(m, b, shape, capacity, mask)
    }
    width: ir_word_const(m, b, stride)
    ir_word_op(m, b, IROp.Mul, capacity, width)
}

// map.find of a hashed Map: the entry's index, -1 when the key is absent. A
// frozen buffer is searched; a counted one probes its index from the tag's
// home slot to the first empty one.
ir_map_probe_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map: Int, key: Int) Never! {
    word_row: ir_word_row(m)
    a.f.result = word_row
    zero: ir_word_const(m, a, 0)
    one: ir_word_const(m, a, 1)
    minus_one: ir_word_const(m, a, -1)
    capacity: ir_load_word(m, a, map, 8)
    frozen: ir_bool_op(m, a, IROp.Le, capacity, zero)
    ir_open_if(a.f, frozen, a.line)
    _: ir_map_search(m, p, a, shape, map, key)
    ir_emit(a.f, IROp.Return, -1, minus_one, -1, -1, a.line)
    ir_end(a.f, a.line)
    data: ir_load_word(m, a, map, 16)
    hash: ir_map_tag(m, a, shape, key)
    trailer: ir_map_trailer(m, a, shape, data, capacity)
    mask: ir_load_word(m, a, trailer, 8)
    at: ir_word_op(m, a, IROp.BitAnd, hash, mask)
    thirty_two: ir_word_const(m, a, 32)
    low_half: ir_word_const(m, a, 4294967295)
    exit: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    slot_at: ir_map_slot_address(m, a, trailer, at)
    slot: ir_load_word(m, a, slot_at, 0)
    occupied: ir_bool_op(m, a, IROp.Ne, slot, zero)
    ir_exit_unless(m, a, occupied, exit)
    slot_tag: ir_word_op(m, a, IROp.Shr, slot, thirty_two)
    same_tag: ir_bool_op(m, a, IROp.Eq, slot_tag, hash)
    ir_open_if(a.f, same_tag, a.line)
    numbered: ir_word_op(m, a, IROp.BitAnd, slot, low_half)
    position: ir_word_op(m, a, IROp.Sub, numbered, one)
    entry: ir_element_address(m, a, data, position, shape.stride)
    probe: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
    same: ir_bool_op(m, a, IROp.Eq, probe, key)
    ir_open_if(a.f, same, a.line)
    ir_emit(a.f, IROp.Return, -1, position, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    following: ir_word_op(m, a, IROp.Add, at, one)
    ir_emit(a.f, IROp.BitAnd, at, following, mask, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Return, -1, minus_one, -1, -1, a.line)
}

// Records entry `position` under tag `hash` in the index of the trailer at
// `trailer`: the first empty slot from the tag's home.
ir_map_slot_insert: fn(m: &IRModule, a: &IRBuilder, trailer: Int, hash: Int, position: Int) Never! {
    zero: ir_word_const(m, a, 0)
    one: ir_word_const(m, a, 1)
    mask: ir_load_word(m, a, trailer, 8)
    at: ir_word_op(m, a, IROp.BitAnd, hash, mask)
    placed: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    slot_at: ir_map_slot_address(m, a, trailer, at)
    slot: ir_load_word(m, a, slot_at, 0)
    taken: ir_bool_op(m, a, IROp.Ne, slot, zero)
    ir_exit_unless(m, a, taken, placed)
    following: ir_word_op(m, a, IROp.Add, at, one)
    ir_emit(a.f, IROp.BitAnd, at, following, mask, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    thirty_two: ir_word_const(m, a, 32)
    high: ir_word_op(m, a, IROp.Shl, hash, thirty_two)
    numbered: ir_word_op(m, a, IROp.Add, position, one)
    entry: ir_word_op(m, a, IROp.BitOr, high, numbered)
    free_at: ir_map_slot_address(m, a, trailer, at)
    ir_emit(a.f, IROp.Store, -1, free_at, 0, entry, a.line)
}

// Takes entry `position` (hashed under tag `hash`) out of the index of the
// trailer at `trailer` as the entries after it shift down one place: its
// slot empties, the probe run after it shifts back over the hole (each
// slot whose home is not cyclically after the hole), every later position
// drops by one, and so does the sorted count when the entry was in order.
ir_map_slot_remove: fn(m: &IRModule, a: &IRBuilder, trailer: Int, hash: Int, position: Int) Never! {
    word_row: ir_word_row(m)
    zero: ir_word_const(m, a, 0)
    one: ir_word_const(m, a, 1)
    thirty_two: ir_word_const(m, a, 32)
    low_half: ir_word_const(m, a, 4294967295)
    numbered: ir_word_op(m, a, IROp.Add, position, one)
    mask: ir_load_word(m, a, trailer, 8)
    hole: ir_word_op(m, a, IROp.BitAnd, hash, mask)
    found: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    slot_at: ir_map_slot_address(m, a, trailer, hole)
    slot: ir_load_word(m, a, slot_at, 0)
    names: ir_word_op(m, a, IROp.BitAnd, slot, low_half)
    other: ir_bool_op(m, a, IROp.Ne, names, numbered)
    ir_exit_unless(m, a, other, found)
    following: ir_word_op(m, a, IROp.Add, hole, one)
    ir_emit(a.f, IROp.BitAnd, hole, following, mask, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    scan: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, scan, hole, -1, -1, a.line)
    shifted: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    next_scan: ir_word_op(m, a, IROp.Add, scan, one)
    ir_emit(a.f, IROp.BitAnd, scan, next_scan, mask, IR_OVERFLOW_WRAP, a.line)
    moving_at: ir_map_slot_address(m, a, trailer, scan)
    moving: ir_load_word(m, a, moving_at, 0)
    run: ir_bool_op(m, a, IROp.Ne, moving, zero)
    ir_exit_unless(m, a, run, shifted)
    moving_tag: ir_word_op(m, a, IROp.Shr, moving, thirty_two)
    home: ir_word_op(m, a, IROp.BitAnd, moving_tag, mask)
    from_home: ir_word_op(m, a, IROp.Sub, scan, home)
    home_distance: ir_word_op(m, a, IROp.BitAnd, from_home, mask)
    from_hole: ir_word_op(m, a, IROp.Sub, scan, hole)
    hole_distance: ir_word_op(m, a, IROp.BitAnd, from_hole, mask)
    fills: ir_bool_op(m, a, IROp.Ge, home_distance, hole_distance)
    ir_open_if(a.f, fills, a.line)
    hole_at: ir_map_slot_address(m, a, trailer, hole)
    ir_emit(a.f, IROp.Store, -1, hole_at, 0, moving, a.line)
    ir_emit(a.f, IROp.Copy, hole, scan, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    emptied_at: ir_map_slot_address(m, a, trailer, hole)
    ir_emit(a.f, IROp.Store, -1, emptied_at, 0, zero, a.line)
    // Positions after the removed entry move down one.
    every: ir_word_const(m, a, 0)
    renumbered: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    within: ir_bool_op(m, a, IROp.Le, every, mask)
    ir_exit_unless(m, a, within, renumbered)
    each_at: ir_map_slot_address(m, a, trailer, every)
    each: ir_load_word(m, a, each_at, 0)
    each_number: ir_word_op(m, a, IROp.BitAnd, each, low_half)
    later: ir_bool_op(m, a, IROp.Gt, each_number, numbered)
    ir_open_if(a.f, later, a.line)
    lowered: ir_word_op(m, a, IROp.Sub, each, one)
    ir_emit(a.f, IROp.Store, -1, each_at, 0, lowered, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Add, every, every, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    sorted: ir_load_word(m, a, trailer, 0)
    ordered: ir_bool_op(m, a, IROp.Lt, position, sorted)
    ir_open_if(a.f, ordered, a.line)
    fewer: ir_word_op(m, a, IROp.Sub, sorted, one)
    ir_emit(a.f, IROp.Store, -1, trailer, 0, fewer, a.line)
    ir_end(a.f, a.line)
}

// The sorted count of a hashed Map: every entry of a frozen buffer, the
// trailer's count of a counted one.
ir_map_sorted: fn(m: &IRModule, a: &IRBuilder, shape: IRMapShape, map: Int) -> Int Never! {
    word_row: ir_word_row(m)
    length: ir_load_word(m, a, map, 0)
    capacity: ir_load_word(m, a, map, 8)
    sorted: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, sorted, length, -1, -1, a.line)
    zero: ir_word_const(m, a, 0)
    counted: ir_bool_op(m, a, IROp.Gt, capacity, zero)
    ir_open_if(a.f, counted, a.line)
    data: ir_load_word(m, a, map, 16)
    trailer: ir_map_trailer(m, a, shape, data, capacity)
    kept: ir_load_word(m, a, trailer, 0)
    ir_emit(a.f, IROp.Copy, sorted, kept, -1, -1, a.line)
    ir_end(a.f, a.line)
    sorted
}

// map.merge(map, target): byte copies of the hashed Map's entries in key
// order at `target` (room for its length): the sorted entries merged with
// the appended tail, whose positions are merge sorted by key first.
ir_map_merge_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map: Int, target: Int) Never! {
    word_row: ir_word_row(m)
    zero: ir_word_const(m, a, 0)
    one: ir_word_const(m, a, 1)
    eight: ir_word_const(m, a, 8)
    width: ir_word_const(m, a, shape.stride)
    length: ir_load_word(m, a, map, 0)
    data: ir_load_word(m, a, map, 16)
    sorted: ir_map_sorted(m, a, shape, map)
    tail: ir_word_op(m, a, IROp.Sub, length, sorted)
    clean: ir_bool_op(m, a, IROp.Eq, tail, zero)
    ir_open_if(a.f, clean, a.line)
    bytes: ir_word_op(m, a, IROp.Mul, length, width)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{target, data, bytes}, -1)
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
    ir_end(a.f, a.line)
    // Two arrays of the tail's positions: the merge sort's source and output.
    tail_bytes: ir_word_op(m, a, IROp.Mul, tail, eight)
    both_bytes: ir_word_op(m, a, IROp.Add, tail_bytes, tail_bytes)
    first: ir_runtime(m, a, "jet_rt_alloc", [Int]{both_bytes, eight}, word_row)
    second: ir_word_op(m, a, IROp.Add, first, tail_bytes)
    fill: ir_word_const(m, a, 0)
    filled: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    unfilled: ir_bool_op(m, a, IROp.Lt, fill, tail)
    ir_exit_unless(m, a, unfilled, filled)
    fill_at: ir_element_address(m, a, first, fill, 8)
    position: ir_word_op(m, a, IROp.Add, sorted, fill)
    ir_emit(a.f, IROp.Store, -1, fill_at, 0, position, a.line)
    ir_emit(a.f, IROp.Add, fill, fill, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    // Bottom-up merge sort of the positions by key, runs of `run` doubling.
    source: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, source, first, -1, -1, a.line)
    output: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, output, second, -1, -1, a.line)
    run: ir_word_const(m, a, 1)
    passes: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    unsorted: ir_bool_op(m, a, IROp.Lt, run, tail)
    ir_exit_unless(m, a, unsorted, passes)
    start: ir_word_const(m, a, 0)
    pairs: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    more_pairs: ir_bool_op(m, a, IROp.Lt, start, tail)
    ir_exit_unless(m, a, more_pairs, pairs)
    middle: ir_word_op(m, a, IROp.Add, start, run)
    ir_map_clamp(m, a, middle, tail)
    span_end: ir_word_op(m, a, IROp.Add, middle, run)
    ir_map_clamp(m, a, span_end, tail)
    left: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, left, start, -1, -1, a.line)
    right: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, right, middle, -1, -1, a.line)
    out: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, out, start, -1, -1, a.line)
    merged: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    more_out: ir_bool_op(m, a, IROp.Lt, out, span_end)
    ir_exit_unless(m, a, more_out, merged)
    left_first: ir_map_takes_left(m, p, a, shape, data, source, left, middle, source, right, span_end)
    out_at: ir_element_address(m, a, output, out, 8)
    ir_open_if(a.f, left_first, a.line)
    left_at: ir_element_address(m, a, source, left, 8)
    left_position: ir_load_word(m, a, left_at, 0)
    ir_emit(a.f, IROp.Store, -1, out_at, 0, left_position, a.line)
    ir_emit(a.f, IROp.Add, left, left, one, IR_OVERFLOW_WRAP, a.line)
    ir_else(a.f, a.line)
    right_at: ir_element_address(m, a, source, right, 8)
    right_position: ir_load_word(m, a, right_at, 0)
    ir_emit(a.f, IROp.Store, -1, out_at, 0, right_position, a.line)
    ir_emit(a.f, IROp.Add, right, right, one, IR_OVERFLOW_WRAP, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Add, out, out, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Copy, start, span_end, -1, -1, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    swap: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, swap, source, -1, -1, a.line)
    ir_emit(a.f, IROp.Copy, source, output, -1, -1, a.line)
    ir_emit(a.f, IROp.Copy, output, swap, -1, -1, a.line)
    ir_emit(a.f, IROp.Add, run, run, run, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    // The sorted entries and the sorted tail, merged into `target`.
    prefix: ir_word_const(m, a, 0)
    taken: ir_word_const(m, a, 0)
    written: ir_word_const(m, a, 0)
    copied: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    more: ir_bool_op(m, a, IROp.Lt, written, length)
    ir_exit_unless(m, a, more, copied)
    from: ir_temp(m, a, word_row)
    prefix_first: ir_map_takes_left(m, p, a, shape, data, -1, prefix, sorted, source, taken, tail)
    ir_open_if(a.f, prefix_first, a.line)
    ir_emit(a.f, IROp.Copy, from, prefix, -1, -1, a.line)
    ir_emit(a.f, IROp.Add, prefix, prefix, one, IR_OVERFLOW_WRAP, a.line)
    ir_else(a.f, a.line)
    taken_at: ir_element_address(m, a, source, taken, 8)
    tail_position: ir_load_word(m, a, taken_at, 0)
    ir_emit(a.f, IROp.Copy, from, tail_position, -1, -1, a.line)
    ir_emit(a.f, IROp.Add, taken, taken, one, IR_OVERFLOW_WRAP, a.line)
    ir_end(a.f, a.line)
    entry: ir_element_address(m, a, data, from, shape.stride)
    landing: ir_element_address(m, a, target, written, shape.stride)
    ir_emit(a.f, IROp.CopyBytes, -1, landing, entry, shape.stride, a.line)
    ir_emit(a.f, IROp.Add, written, written, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    ir_free(m, a, first, both_bytes)
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// `value` = min(value, limit), in place.
ir_map_clamp: fn(m: &IRModule, a: &IRBuilder, value: Int, limit: Int) Never! {
    over: ir_bool_op(m, a, IROp.Gt, value, limit)
    ir_open_if(a.f, over, a.line)
    ir_emit(a.f, IROp.Copy, value, limit, -1, -1, a.line)
    ir_end(a.f, a.line)
}

// Whether a merge takes its left run's next entry: the right run [right,
// right_end) is spent, or the left run [left, left_end) is not and its key
// is the lesser. A run's item `i` is entry `i` itself when its array is -1,
// else the entry whose position is word `i` of the array.
ir_map_takes_left: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, data: Int, left_array: Int, left: Int, left_end: Int, right_array: Int, right: Int, right_end: Int) -> Int Never! {
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    takes: ir_temp(m, a, bool_row)
    ir_emit(a.f, IROp.Const, takes, 1, -1, -1, a.line)
    right_open: ir_bool_op(m, a, IROp.Lt, right, right_end)
    ir_open_if(a.f, right_open, a.line)
    ir_emit(a.f, IROp.Const, takes, 0, -1, -1, a.line)
    left_open: ir_bool_op(m, a, IROp.Lt, left, left_end)
    ir_open_if(a.f, left_open, a.line)
    left_key: ir_map_run_key(m, a, shape, data, left_array, left)
    right_key: ir_map_run_key(m, a, shape, data, right_array, right)
    order: ir_map_order(m, p, a, shape.kind, left_key, right_key)
    ir_emit(a.f, IROp.Copy, takes, order.less, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    takes
}

// The key of item `index` of a merge run (ir_map_takes_left).
ir_map_run_key: fn(m: &IRModule, a: &IRBuilder, shape: IRMapShape, data: Int, array: Int, index: Int) -> Int Never! {
    position := index
    if array >= 0 {
        at: ir_element_address(m, a, array, index, 8)
        position = ir_load_word(m, a, at, 0)
    }
    entry: ir_element_address(m, a, data, position, shape.stride)
    ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
}

// map.order(map) -> the address of the hashed Map's entries in key order:
// its own buffer when frozen or when every entry is in order, else a fresh
// buffer of byte copies (map.merge) the caller frees.
ir_map_order_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map_row: Int, map: Int) Never! {
    word_row: ir_word_row(m)
    a.f.result = word_row
    length: ir_load_word(m, a, map, 0)
    data: ir_load_word(m, a, map, 16)
    sorted: ir_map_sorted(m, a, shape, map)
    clean: ir_bool_op(m, a, IROp.Eq, sorted, length)
    ir_open_if(a.f, clean, a.line)
    ir_emit(a.f, IROp.Return, -1, data, -1, -1, a.line)
    ir_end(a.f, a.line)
    width: ir_word_const(m, a, shape.stride)
    bytes: ir_word_op(m, a, IROp.Mul, length, width)
    eight: ir_word_const(m, a, 8)
    view: ir_runtime(m, a, "jet_rt_alloc", [Int]{bytes, eight}, word_row)
    _: ir_map_call(m, p, a, map_row, "map.merge", [Int]{map, view}, -1)
    ir_emit(a.f, IROp.Return, -1, view, -1, -1, a.line)
}

// map.settle(map): a hashed Map whose own variable reads it in key order
// merges its tail in place first, so that read and the ones after it walk
// its buffer: made unique, then rebuilt at its capacity.
ir_map_settle_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, map_row: Int, map: Int) Never! {
    shape: ir_keyed_shape(m, p, map_row) ?? panic("map.settle of a type without a Map shape")
    length: ir_load_word(m, a, map, 0)
    sorted: ir_map_sorted(m, a, shape, map)
    dirty: ir_bool_op(m, a, IROp.Ne, sorted, length)
    ir_open_if(a.f, dirty, a.line)
    ir_make_unique(m, p, a, map)
    capacity: ir_load_word(m, a, map, 8)
    _: ir_map_call(m, p, a, map_row, "map.rebuild", [Int]{map, capacity}, -1)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// map.rebuild(map, capacity): moves the hashed Map's entries, in key order,
// into a fresh counted buffer of `capacity` (at least its length) entries
// with a fresh index, every entry sorted; the old buffer's owner is the
// caller, which made it unique (a counted one is freed, its entries moved).
// map.grow (`merge` false) moves them as they lie, the sorted count kept:
// the appended tail stays unsorted until an ordered read merges it.
ir_map_rebuild_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map_row: Int, map: Int, capacity: Int, merge: Bool) Never! {
    word_row: ir_word_row(m)
    zero: ir_word_const(m, a, 0)
    one: ir_word_const(m, a, 1)
    eight: ir_word_const(m, a, 8)
    length: ir_load_word(m, a, map, 0)
    old_capacity: ir_load_word(m, a, map, 8)
    old_data: ir_load_word(m, a, map, 16)
    slots: ir_word_const(m, a, 8)
    wanted: ir_word_op(m, a, IROp.Add, capacity, capacity)
    sized: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    short: ir_bool_op(m, a, IROp.Lt, slots, wanted)
    ir_exit_unless(m, a, short, sized)
    ir_emit(a.f, IROp.Add, slots, slots, slots, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    mask: ir_word_op(m, a, IROp.Sub, slots, one)
    bytes: ir_map_block_bytes(m, a, shape, capacity, mask)
    fresh: ir_runtime(m, a, "jet_rt_alloc", [Int]{bytes, eight}, word_row)
    sorted := length
    if merge {
        _: ir_map_call(m, p, a, map_row, "map.merge", [Int]{map, fresh}, -1)
    } else {
        sorted = ir_map_sorted(m, a, shape, map)
        width: ir_word_const(m, a, shape.stride)
        moved: ir_word_op(m, a, IROp.Mul, length, width)
        _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{fresh, old_data, moved}, -1)
    }
    trailer: ir_map_trailer(m, a, shape, fresh, capacity)
    ir_emit(a.f, IROp.Store, -1, trailer, 0, sorted, a.line)
    ir_emit(a.f, IROp.Store, -1, trailer, 8, mask, a.line)
    cleared: ir_word_const(m, a, 0)
    emptied: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    uncleared: ir_bool_op(m, a, IROp.Lt, cleared, slots)
    ir_exit_unless(m, a, uncleared, emptied)
    cleared_at: ir_map_slot_address(m, a, trailer, cleared)
    ir_emit(a.f, IROp.Store, -1, cleared_at, 0, zero, a.line)
    ir_emit(a.f, IROp.Add, cleared, cleared, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    indexed: ir_word_const(m, a, 0)
    hashed: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    unhashed: ir_bool_op(m, a, IROp.Lt, indexed, length)
    ir_exit_unless(m, a, unhashed, hashed)
    entry: ir_element_address(m, a, fresh, indexed, shape.stride)
    key: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
    hash: ir_map_tag(m, a, shape, key)
    ir_map_slot_insert(m, a, trailer, hash, indexed)
    ir_emit(a.f, IROp.Add, indexed, indexed, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    counted: ir_bool_op(m, a, IROp.Gt, old_capacity, zero)
    ir_open_if(a.f, counted, a.line)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    last: ir_runtime(m, a, "jet_rt_block_release", [Int]{old_data}, bool_row)
    ir_open_if(a.f, last, a.line)
    old_trailer: ir_map_trailer(m, a, shape, old_data, old_capacity)
    old_mask: ir_load_word(m, a, old_trailer, 8)
    old_bytes: ir_map_block_bytes(m, a, shape, old_capacity, old_mask)
    ir_free(m, a, old_data, old_bytes)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Store, -1, map, 16, fresh, a.line)
    ir_emit(a.f, IROp.Store, -1, map, 8, capacity, a.line)
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// Moves the key and value in: an existing key keeps its entry key (the
// incoming one is dropped) and its value is replaced, dropped by map.set and
// returned in an Option box by map.insert (null when the key was new). A
// Map's entries are the heap's, so what they hold moves there first
// (BuildMove.jet).
ir_map_insert_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map_row: Int, map: Int, key: Int, value: Int, option_row: Int) Never! {
    a.f.result = option_row
    ir_move_heap(m, p, a, value)
    word_row: ir_word_row(m)
    index: ir_map_call(m, p, a, map_row, "map.find", [Int]{map, key}, word_row)
    none: ir_word_const(m, a, 0)
    present: ir_bool_op(m, a, IROp.Ge, index, none)
    ir_open_if(a.f, present, a.line)
    ir_map_replace_value(m, p, a, shape, map, key, value, index, option_row)
    ir_map_place_new(m, p, a, shape, map_row, map, key, value, index)
    null := -1
    if option_row >= 0 {
        null = ir_temp(m, a, option_row)
        ir_option_none(m, a, null)
    }
    ir_emit(a.f, IROp.Return, -1, null, -1, -1, a.line)
}

// map.add: an existing key's entry is left as it is, and the helper returns
// that entry's index so the caller keeps the key and value; a new key goes
// in as map.set puts it, its value moved to the heap first as map.set moves
// it, and the helper returns -1.
ir_map_add_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map_row: Int, map: Int, key: Int, value: Int) Never! {
    word_row: ir_word_row(m)
    a.f.result = word_row
    index: ir_map_call(m, p, a, map_row, "map.find", [Int]{map, key}, word_row)
    none: ir_word_const(m, a, 0)
    present: ir_bool_op(m, a, IROp.Ge, index, none)
    ir_open_if(a.f, present, a.line)
    ir_emit(a.f, IROp.Return, -1, index, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_move_heap(m, p, a, value)
    ir_map_place_new(m, p, a, shape, map_row, map, key, value, index)
    absent: ir_word_const(m, a, -1)
    ir_emit(a.f, IROp.Return, -1, absent, -1, -1, a.line)
}

// Puts in a key the Map at `map` doesn't hold; `index` is what map.find
// returned for it (-1 - the insertion point on a sorted Map). The key moves
// to the heap first; the caller has moved the value.
ir_map_place_new: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map_row: Int, map: Int, key: Int, value: Int, index: Int) Never! {
    ir_move_heap(m, p, a, key)
    if ir_map_hashed(shape) {
        // A new key goes after the last entry, out of order until a
        // rebuild merges it in.
        length: ir_load_word(m, a, map, 0)
        capacity: ir_load_word(m, a, map, 8)
        full: ir_bool_op(m, a, IROp.Ge, length, capacity)
        ir_open_if(a.f, full, a.line)
        grown: ir_word_op(m, a, IROp.Add, length, length)
        four: ir_word_const(m, a, 4)
        small: ir_bool_op(m, a, IROp.Lt, grown, four)
        ir_open_if(a.f, small, a.line)
        ir_emit(a.f, IROp.Copy, grown, four, -1, -1, a.line)
        ir_end(a.f, a.line)
        _: ir_map_call(m, p, a, map_row, "map.grow", [Int]{map, grown}, -1)
        ir_end(a.f, a.line)
        hash: ir_map_tag(m, a, shape, key)
        room: ir_load_word(m, a, map, 16)
        room_capacity: ir_load_word(m, a, map, 8)
        target: ir_element_address(m, a, room, length, shape.stride)
        a.fresh[key] = true
        ir_store_at(m, p, a, target, shape.key.offset, key)
        a.fresh[value] = true
        ir_store_at(m, p, a, target, shape.value.offset, value)
        one: ir_word_const(m, a, 1)
        grown_length: ir_word_op(m, a, IROp.Add, length, one)
        ir_emit(a.f, IROp.Store, -1, map, 0, grown_length, a.line)
        trailer: ir_map_trailer(m, a, shape, room, room_capacity)
        ir_map_slot_insert(m, a, trailer, hash, length)
    } else {
        minus_one: ir_word_const(m, a, -1)
        point: ir_word_op(m, a, IROp.Sub, minus_one, index)
        length: ir_list_reserve(m, a, map, shape.entry)
        room: ir_load_word(m, a, map, 16)
        target: ir_element_address(m, a, room, point, shape.stride)
        one: ir_word_const(m, a, 1)
        after: ir_word_op(m, a, IROp.Add, point, one)
        shifted: ir_element_address(m, a, room, after, shape.stride)
        moved: ir_word_op(m, a, IROp.Sub, length, point)
        width: ir_word_const(m, a, shape.stride)
        bytes: ir_word_op(m, a, IROp.Mul, moved, width)
        _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{shifted, target, bytes}, -1)
        a.fresh[key] = true
        ir_store_at(m, p, a, target, shape.key.offset, key)
        a.fresh[value] = true
        ir_store_at(m, p, a, target, shape.value.offset, value)
        grown: ir_word_op(m, a, IROp.Add, length, one)
        ir_emit(a.f, IROp.Store, -1, map, 0, grown, a.line)
    }
}

// map.set and map.insert on a key the Map at `map` holds at `index`: the
// value is replaced and the incoming key dropped.
ir_map_replace_value: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map: Int, key: Int, value: Int, index: Int, option_row: Int) Never! {
    entries: ir_load_word(m, a, map, 16)
    entry: ir_element_address(m, a, entries, index, shape.stride)
    old := -1
    if option_row >= 0 && ir_option_inline(m, option_row) {
        // The old value moves out into the inline Option.
        replaced: ir_load_at(m, a, entry, shape.value.offset, shape.value.ty)
        old = ir_temp(m, a, option_row)
        ir_emit(a.f, IROp.Move, old, replaced, -1, -1, a.line)
    } else if option_row >= 0 {
        value_size: m.types[shape.value.ty].size
        old = ir_box_alloc(m, a, value_size, option_row)
        source: ir_address_at(m, a, entry, shape.value.offset)
        ir_emit(a.f, IROp.CopyBytes, -1, old, source, ir_align8(value_size), a.line)
    } else if m.types[shape.value.ty].drop != "" {
        replaced: ir_load_at(m, a, entry, shape.value.offset, shape.value.ty)
        ir_emit(a.f, IROp.Drop, -1, replaced, -1, -1, a.line)
    }
    a.fresh[value] = true
    ir_store_at(m, p, a, entry, shape.value.offset, value)
    if m.types[shape.key.ty].drop != "" -> ir_emit(a.f, IROp.Drop, -1, key, -1, -1, a.line)
    ir_emit(a.f, IROp.Return, -1, old, -1, -1, a.line)
    ir_end(a.f, a.line)
}

// The value under a borrowed key in an Option box (null when absent): map.get
// copies it, map.remove moves it out, drops the entry's key and closes the
// gap.
ir_map_take_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, map_row: Int, map: Int, key: Int, option_row: Int, removes: Bool) Never! {
    a.f.result = option_row
    word_row: ir_word_row(m)
    index: ir_map_call(m, p, a, map_row, "map.find", [Int]{map, key}, word_row)
    none: ir_word_const(m, a, 0)
    absent: ir_bool_op(m, a, IROp.Lt, index, none)
    ir_open_if(a.f, absent, a.line)
    null: ir_temp(m, a, option_row)
    ir_option_none(m, a, null)
    ir_emit(a.f, IROp.Return, -1, null, -1, -1, a.line)
    ir_end(a.f, a.line)
    data: ir_load_word(m, a, map, 16)
    entry: ir_element_address(m, a, data, index, shape.stride)
    word_option: ir_option_inline(m, option_row)
    value_size: m.types[shape.value.ty].size
    boxed: if word_option -> ir_temp(m, a, option_row) else -> ir_box_alloc(m, a, value_size, option_row)
    if !removes {
        stored: ir_load_at(m, a, entry, shape.value.offset, shape.value.ty)
        copied: ir_copy_value(m, p, a, stored, Span{start: 0, end: 0})
        if word_option {
            ir_emit(a.f, IROp.Move, boxed, copied, -1, -1, a.line)
        } else {
            ir_store_at(m, p, a, boxed, 0, copied)
        }
        ir_emit(a.f, IROp.Return, -1, boxed, -1, -1, a.line)
        return
    }
    if word_option {
        taken: ir_load_at(m, a, entry, shape.value.offset, shape.value.ty)
        ir_emit(a.f, IROp.Move, boxed, taken, -1, -1, a.line)
    } else {
        source: ir_address_at(m, a, entry, shape.value.offset)
        ir_emit(a.f, IROp.CopyBytes, -1, boxed, source, ir_align8(value_size), a.line)
    }
    hash := -1
    if ir_map_hashed(shape) {
        removed_probe: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
        hash = ir_map_tag(m, a, shape, removed_probe)
    }
    if m.types[shape.key.ty].drop != "" {
        removed_key: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
        ir_emit(a.f, IROp.Drop, -1, removed_key, -1, -1, a.line)
    }
    length: ir_load_word(m, a, map, 0)
    one: ir_word_const(m, a, 1)
    last: ir_word_op(m, a, IROp.Sub, length, one)
    after: ir_word_op(m, a, IROp.Add, index, one)
    from: ir_element_address(m, a, data, after, shape.stride)
    moved: ir_word_op(m, a, IROp.Sub, last, index)
    width: ir_word_const(m, a, shape.stride)
    bytes: ir_word_op(m, a, IROp.Mul, moved, width)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{entry, from, bytes}, -1)
    ir_emit(a.f, IROp.Store, -1, map, 0, last, a.line)
    if hash >= 0 {
        capacity: ir_load_word(m, a, map, 8)
        counted: ir_bool_op(m, a, IROp.Gt, capacity, none)
        ir_open_if(a.f, counted, a.line)
        trailer: ir_map_trailer(m, a, shape, data, capacity)
        ir_map_slot_remove(m, a, trailer, hash, index)
        ir_end(a.f, a.line)
    }
    ir_emit(a.f, IROp.Return, -1, boxed, -1, -1, a.line)
}

// A call of Map helper `name` with result row `result` (-1: none).
ir_map_call: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, map_row: Int, name: String, args: [Int], result: Int) -> Int Never! {
    callee: ir_map_helper(m, p, map_row, name)
    dst: if result >= 0 -> ir_fresh_temp(m, b, result) else -> -1
    operands: ir_args(b.f, args)
    ir_emit(b.f, IROp.Call, dst, callee, operands, args.len(), b.line)
    ir_stop_check(m, b)
    dst
}

// The index of the entry map.set just added to the Map at `map` after
// map.find missed with `found`: a hashed Map appends it, any other inserts it
// at the insertion point -1 - found.
ir_map_added_index: fn(m: &IRModule, b: &IRBuilder, shape: IRMapShape, map: Int, found: Int) -> Int Never! {
    if ir_map_hashed(shape) {
        length: ir_load_word(m, b, map, 0)
        one: ir_word_const(m, b, 1)
        return ir_word_op(m, b, IROp.Sub, length, one)
    }
    minus_one: ir_word_const(m, b, -1)
    ir_word_op(m, b, IROp.Sub, minus_one, found)
}

// Room for one more element of the list at `list`: grows its buffer to twice
// its capacity (at least 4) when full; returns the length.
ir_list_reserve: fn(m: &IRModule, b: &IRBuilder, list: Int, row: Int) -> Int Never! {
    stride: ir_list_stride(m, row)
    width: ir_word_const(m, b, stride)
    length: ir_load_word(m, b, list, 0)
    capacity: ir_load_word(m, b, list, 8)
    full: ir_bool_op(m, b, IROp.Ge, length, capacity)
    ir_open_if(b.f, full, b.line)
    grown: ir_word_op(m, b, IROp.Add, capacity, capacity)
    four: ir_word_const(m, b, 4)
    small: ir_bool_op(m, b, IROp.Lt, grown, four)
    ir_open_if(b.f, small, b.line)
    ir_emit(b.f, IROp.Copy, grown, four, -1, -1, b.line)
    ir_end(b.f, b.line)
    align: ir_word_const(m, b, 8)
    bytes: ir_word_op(m, b, IROp.Mul, grown, width)
    word_row: ir_word_row(m)
    data: ir_runtime(m, b, "jet_rt_alloc", [Int]{bytes, align}, word_row)
    old_data: ir_load_word(m, b, list, 16)
    used: ir_word_op(m, b, IROp.Mul, length, width)
    _: ir_runtime(m, b, "jet_rt_mem_move", [Int]{data, old_data, used}, -1)
    ir_release_moved_buffer(m, b, old_data, data, capacity, stride)
    ir_emit(b.f, IROp.Store, -1, list, 16, data, b.line)
    ir_emit(b.f, IROp.Store, -1, list, 8, grown, b.line)
    ir_end(b.f, b.line)
    length
}

// `[k: v, ...]` (BuildMap): an empty header, then each entry added in order.
// Adding an entry looks up its key's slot (map.add), and that same lookup
// finds a key an earlier entry holds: the literal then stops, naming the key
// and both entries, instead of replacing the value. A hashed Map holds the
// entries in the order they were added, so the found index is the earlier
// entry; for any other Map the stop compares the key with the earlier
// entries' keys. Only the stop does any work beyond the lookup.
ir_map_literal: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, entries: [BodyMapEntry], span: Span) -> Int Never! {
    row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    shape: ir_map_shape(m, p, row) ?? return ir_fail_slot(b, span, "map literal of {ir_type_name(ty)}")
    line: b.line
    map: ir_list_empty(m, b, row)
    word_row: ir_word_row(m)
    second: ir_temp(m, b, word_row)
    unset: ir_word_const(m, b, -1)
    ir_emit(b.f, IROp.Copy, second, unset, -1, -1, b.line)
    held: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, held, unset, -1, -1, b.line)
    keys := [Int]{}
    built: ir_open(b.f, IROp.Block, b.line)
    loop index in 0..<entries.len() {
        key: ir_value_as(m, p, b, entries[index].key, shape.key.ty, span)
        value: ir_value_as(m, p, b, entries[index].value, shape.value.ty, span)
        if ir_failed(b) -> return -1
        if key < 0 || value < 0 -> return ir_fail_slot(b, span, "Unit map entry")
        owned_key: ir_own(m, p, b, key)
        owned_value: ir_own(m, p, b, value)
        found: ir_map_call(m, p, b, row, "map.add", [Int]{map, owned_key, owned_value}, word_row)
        b.fresh[owned_key] = false
        b.fresh[owned_value] = false
        keys.push(owned_key)
        none: ir_word_const(m, b, 0)
        present: ir_bool_op(m, b, IROp.Ge, found, none)
        ir_open_if(b.f, present, b.line)
        position: ir_word_const(m, b, index)
        ir_emit(b.f, IROp.Copy, second, position, -1, -1, b.line)
        ir_emit(b.f, IROp.Copy, held, found, -1, -1, b.line)
        ir_end(b.f, b.line)
        leave: ir_depth(b.f, built)
        ir_emit(b.f, IROp.BrIf, -1, present, leave, -1, b.line)
    }
    ir_end(b.f, b.line)
    b.line = line
    none: ir_word_const(m, b, 0)
    repeated: ir_bool_op(m, b, IROp.Ge, second, none)
    ir_open_if(b.f, repeated, b.line)
    if !ir_map_literal_stop(m, p, b, shape, map, keys, second, held) -> return -1
    ir_end(b.f, b.line)
    map
}

// The stop of a map literal whose entry `second` repeats the key of the entry
// at index `held` of the Map at `map`: the message names the key and both
// entries, counted from 1. False when the key has no debug text.
ir_map_literal_stop: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, shape: IRMapShape, map: Int, keys: [Int], second: Int, held: Int) -> Bool Never! {
    entries: ir_load_word(m, b, map, 16)
    entry: ir_element_address(m, b, entries, held, shape.stride)
    key: ir_load_at(m, b, entry, shape.key.offset, shape.key.ty)
    word_row: ir_word_row(m)
    first: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, first, held, -1, -1, b.line)
    if !ir_map_hashed(shape) {
        search: ir_open(b.f, IROp.Block, b.line)
        loop index in 0..<keys.len() {
            position: ir_word_const(m, b, index)
            ir_emit(b.f, IROp.Copy, first, position, -1, -1, b.line)
            earlier: ir_bool_op(m, b, IROp.Lt, position, second)
            ir_exit_unless(m, b, earlier, search)
            same: ir_map_order(m, p, b, shape.kind, keys[index], key).same
            match_depth: ir_depth(b.f, search)
            ir_emit(b.f, IROp.BrIf, -1, same, match_depth, -1, b.line)
        }
        ir_end(b.f, b.line)
    }
    pointer_row: ir_pointer_row(m)
    builder: ir_runtime(m, b, "jet_rt_string_builder_new", [Int]{}, pointer_row)
    b.fresh[builder] = false
    ir_push_static(m, b, builder, "the map literal has the key ")
    if !ir_map_push_key_text(m, p, b, shape, builder, key) -> return false
    ir_push_static(m, b, builder, " twice: in entry ")
    ir_map_literal_push_count(m, b, builder, first)
    ir_push_static(m, b, builder, " and in entry ")
    ir_map_literal_push_count(m, b, builder, second)
    string_row: ir_string_row(m)
    message: ir_runtime(m, b, "jet_rt_string_builder_finish", [Int]{builder}, string_row)
    null: ir_word_const(m, b, 0)
    report: ir_line_report(p, b)
    ir_stop(m, p, b, 2, message, null, null, report)
    true
}

// Pushes entry index `index` counted from 1.
ir_map_literal_push_count: fn(m: &IRModule, b: &IRBuilder, builder: Int, index: Int) Never! {
    one: ir_word_const(m, b, 1)
    count: ir_word_op(m, b, IROp.Add, index, one)
    string_row: ir_string_row(m)
    text: ir_runtime(m, b, "jet_rt_i64_to_string", [Int]{count}, string_row)
    _: ir_runtime(m, b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
}

// Pushes the debug text of `key`, a key of the map `shape` describes, onto
// `builder`; false when rendering it failed.
ir_map_push_key_text: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, shape: IRMapShape, builder: Int, key: Int) -> Bool Never! {
    key_ty: m.types[shape.key.ty].ty.copy()
    text: ir_render(m, p, b, key_ty, key, IRRender.Debug, Span{start: 0, end: 0})
    if ir_failed(b) -> return false
    _: ir_runtime(m, b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
    true
}

// Moves owned copies of `key` and `value` into the map at `map`.
ir_map_set: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int, map: Int, key: Int, value: Int) Never! {
    owned_key: ir_own(m, p, b, key)
    owned_value: ir_own(m, p, b, value)
    _: ir_map_call(m, p, b, row, "map.set", [Int]{map, owned_key, owned_value}, -1)
    b.fresh[owned_key] = false
    b.fresh[owned_value] = false
}

// A runtime index stop at the builder's current line (jet_index_map_ref): the
// line's source quoted, its caret at the line start.
ir_line_report: fn(p: IRProgram, b: IRBuilder) -> TPanicLoc Never! {
    ir_report_location(p, TPanicLoc{file: b.f.source_file.copy(), source_line: "", line: b.line, column: 0, caret: 0, function: "", locals: [TPanicLocal]{}})
}

// The address of the value stored under `key` in the map at `map`; a missing
// key stops at the current line with the key's debug text (jet_index_map_ref).
ir_map_value_address: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int, map: Int, key: Int) -> Int Never! {
    shape: ir_map_shape(m, p, row) ?? return -1
    word_row: ir_word_row(m)
    found: ir_map_call(m, p, b, row, "map.find", [Int]{map, key}, word_row)
    none: ir_word_const(m, b, 0)
    absent: ir_bool_op(m, b, IROp.Lt, found, none)
    ir_open_if(b.f, absent, b.line)
    pointer_row: ir_pointer_row(m)
    builder: ir_runtime(m, b, "jet_rt_string_builder_new", [Int]{}, pointer_row)
    b.fresh[builder] = false
    ir_push_static(m, b, builder, "the map has no entry for key ")
    if !ir_map_push_key_text(m, p, b, shape, builder, key) -> return -1
    string_row: ir_string_row(m)
    message: ir_runtime(m, b, "jet_rt_string_builder_finish", [Int]{builder}, string_row)
    null: ir_word_const(m, b, 0)
    report: ir_line_report(p, b)
    ir_stop(m, p, b, 2, message, null, null, report)
    ir_end(b.f, b.line)
    entries: ir_load_word(m, b, map, 16)
    entry: ir_element_address(m, b, entries, found, shape.stride)
    ir_address_at(m, b, entry, shape.value.offset)
}

// `map[key]` read as a value (borrowed: the map keeps it).
ir_map_index: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, base: Int, index: Int, span: Span) -> Int Never! {
    base_ty: ir_ty(p, b, base)
    map: ir_expr(m, p, b, base)
    if ir_failed(b) || map < 0 -> return -1
    row: b.f.slot_type[map]
    shape: ir_map_shape(m, p, row) ?? return ir_fail_slot(b, span, "map index of {ir_type_name(base_ty)}")
    key: ir_value_as(m, p, b, index, shape.key.ty, span)
    if ir_failed(b) || key < 0 -> return -1
    address: ir_map_value_address(m, p, b, row, map, key)
    ir_release(m, b, key)
    read: ir_load_at(m, b, address, 0, shape.value.ty)
    ir_end_read_base(m, p, b, map, read, span)
}

// `&map[key]` as a write place: the key's value in the map's own buffer (a
// missing key stops, as a read does). An aggregate value is its storage's
// address, any other the address of its word (ir_place_address).
ir_map_place_address: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, base: Int, index: Int, backs: &[IRWriteBack], span: Span) -> Int Never! {
    base_ty: ir_ty(p, b, base)
    map: ir_place_address(m, p, b, base, backs, span)
    if ir_failed(b) -> return -1
    if map < 0 || ir_kind_of(m, b, map) != .Aggregate -> return ir_fail_slot(b, span, "write of a map entry of {ir_type_name(base_ty)}")
    ir_make_unique(m, p, b, map)
    row: b.f.slot_type[map]
    shape: ir_map_shape(m, p, row) ?? return ir_fail_slot(b, span, "write of a map entry of {ir_type_name(base_ty)}")
    key: ir_value_as(m, p, b, index, shape.key.ty, span)
    if ir_failed(b) || key < 0 -> return -1
    value: ir_map_value_address(m, p, b, row, map, key)
    ir_release(m, b, key)
    if m.types[shape.value.ty].kind != .Aggregate -> return value
    address: ir_temp(m, b, shape.value.ty)
    ir_emit(b.f, IROp.Offset, address, value, 0, -1, b.line)
    address
}

// `map[key] (op)= value`: inserts or replaces the key's entry; a compound
// assignment updates the value in place. The value comes before the place
// (ir_assign_place), and the place is a write base (ir_write_base): a Map
// inside a List element writes that List's own buffer, never a shared one.
ir_map_index_assign: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, base: Int, index: Int, op: TBinaryOp?, value: Int, span: Span) Never! {
    base_ty: ir_ty(p, b, base)
    written_row: ir_value_type(m, p, base_ty) ?? return ir_fail(b, span, "map index write of {ir_type_name(base_ty)}")
    written: ir_map_shape(m, p, written_row) ?? return ir_fail(b, span, "map index write of {ir_type_name(base_ty)}")
    if op == None && ir_map_update_fuses(m, p, b, written, base, index, value) -> return ir_map_update(m, p, b, base, index, value, span)
    right: ir_value_as(m, p, b, value, written.value.ty, span)
    if ir_failed(b) -> return
    map: ir_write_base(m, p, b, base, span)
    if ir_failed(b) || map < 0 -> return
    ir_make_unique(m, p, b, map)
    row: b.f.slot_type[map]
    shape: ir_map_shape(m, p, row) ?? return ir_fail(b, span, "map index write of {ir_type_name(base_ty)}")
    key: ir_value_as(m, p, b, index, shape.key.ty, span)
    if ir_failed(b) || key < 0 || right < 0 -> return
    binary: op ?? {
        ir_map_close_replaced(m, p, b, row, shape, map, key, span)
        if ir_failed(b) -> return
        return ir_map_set(m, p, b, row, map, key, right)
    }
    address: ir_map_value_address(m, p, b, row, map, key)
    ir_release(m, b, key)
    current: ir_load_at(m, b, address, 0, shape.value.ty)
    site: b.line
    value_ty: m.types[shape.value.ty].ty
    value_type: ir_ty(p, b, value)
    result: ir_binary(m, p, b, binary, ir_assign_overflow(binary), site, value_ty, current, right, value_type, span)
    ir_release(m, b, right)
    if ir_failed(b) -> return
    if m.types[shape.value.ty].drop != "" -> ir_emit(b.f, IROp.Drop, -1, current, -1, -1, b.line)
    ir_store_at(m, p, b, address, 0, result)
}

// `map[key] = value` over a present key: the entry's old value closes first,
// as a field write closes it; map.set then drops it.
ir_map_close_replaced: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int, shape: IRMapShape, map: Int, key: Int, span: Span) Never! {
    glue: ir_close_glue(m, p, b, shape.value.ty, false, span)
    if glue < 0 -> return
    word: ir_word_row(m)
    found: ir_map_call(m, p, b, row, "map.find", [Int]{map, key}, word)
    none: ir_word_const(m, b, 0)
    present: ir_bool_op(m, b, IROp.Ge, found, none)
    ir_open_if(b.f, present, b.line)
    entries: ir_load_word(m, b, map, 16)
    entry: ir_element_address(m, b, entries, found, shape.stride)
    old: ir_load_at(m, b, entry, shape.value.offset, shape.value.ty)
    ir_close_call(b, glue, old)
    ir_end(b.f, b.line)
}

// Whether `base[index] = value` is one probe (ir_map_update): the map is a
// variable, the key and value only read (ir_map_update_reads), the value
// gets a key of the map, and key and value are words a store moves (no
// aggregate, none without a clone).
ir_map_update_fuses: fn(m: IRModule, p: IRProgram, b: IRBuilder, shape: IRMapShape, base: Int, index: Int, value: Int) -> Bool Never! {
    if ir_body_node(p, b, base).kind == {
        .Local(_) -> {}
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> return false
    }
    if !ir_map_update_word(m, shape.key.ty) || !ir_map_update_word(m, shape.value.ty) -> return false
    ir_map_update_reads(p, b, index) >= 0 && ir_map_update_reads(p, b, value) > 0
}

ir_map_update_word: fn(m: IRModule, row: Int) -> Bool Never! {
    kind: m.types[row].kind
    kind != .Aggregate && kind != .Unit && (m.types[row].drop == "" || m.types[row].clone != "")
}

// The number of Map `get`s in node `id` when evaluating it only reads
// (literals, variables, primitive arithmetic and comparisons, `??` with a
// value fallback, Map `get`); -1 when it may write or call anything else.
ir_map_update_reads: fn(p: IRProgram, b: IRBuilder, id: Int) -> Int Never! {
    node: ir_body_node(p, b, id)
    reads: if node.kind == {
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .Local(_) -> 0
        .Binary(_, _, _, lhs, rhs) -> {
            if !ir_map_update_primitive(ir_ty(p, b, lhs)) || !ir_map_update_primitive(ir_ty(p, b, rhs)) -> return -1
            ir_map_update_both(ir_map_update_reads(p, b, lhs), ir_map_update_reads(p, b, rhs))
        }
        .Unary(_, operand) -> if ir_map_update_primitive(ir_ty(p, b, operand)) -> ir_map_update_reads(p, b, operand) else -> -1
        .OrFallback(value, fallback, _) -> if fallback == .Value(other) -> ir_map_update_both(ir_map_update_reads(p, b, value), ir_map_update_reads(p, b, other)) else -> -1
        .BuiltinMethod(receiver, operation, args) -> {
            if operation != .GetMap || args.len() != 1 -> return -1
            ir_map_update_both(ir_map_update_both(ir_map_update_reads(p, b, receiver), ir_map_update_reads(p, b, args[0])), 1)
        }
        .Borrow(place, _) -> ir_map_update_reads(p, b, place)
        .Clone(value, _) -> ir_map_update_reads(p, b, value)
        .StrLit(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .CompareChain(_, _, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> -1
    }
    reads
}

ir_map_update_both: fn(left: Int, right: Int) -> Int Never! {
    if left < 0 || right < 0 -> return -1
    left + right
}

// Whether `ty` is a number, Bool or Char, whose operators are instructions.
ir_map_update_primitive: fn(ty: Type) -> Bool Never! {
    code: ir_scalar_code(ty)
    (code >= 0 && code <= 4) || code >= 10
}

// `map[key] = value` as one probe (ir_map_update_fuses): the key is found
// first and a `get` of it in the value answers from that entry
// (ir_map_probed). A found entry takes the value in place, its key never
// copied; a missing key is set as ir_map_set sets it. Key and value only
// read, so building them before the value, not after as
// ir_map_index_assign does, is the same program.
ir_map_update: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, base: Int, index: Int, value: Int, span: Span) Never! {
    base_ty: ir_ty(p, b, base)
    map: ir_write_base(m, p, b, base, span)
    if ir_failed(b) || map < 0 -> return
    ir_make_unique(m, p, b, map)
    row: b.f.slot_type[map]
    shape: ir_map_shape(m, p, row) ?? return ir_fail(b, span, "map index write of {ir_type_name(base_ty)}")
    key: ir_value_as(m, p, b, index, shape.key.ty, span)
    if ir_failed(b) || key < 0 -> return
    word_row: ir_word_row(m)
    found: ir_map_call(m, p, b, row, "map.find", [Int]{map, key}, word_row)
    b.probe = Val(IRMapProbe{map: map, key: key, found: found})
    right: ir_value_as(m, p, b, value, shape.value.ty, span)
    b.probe = None
    if ir_failed(b) || right < 0 -> return
    owned: ir_own(m, p, b, right)
    glue: ir_close_glue(m, p, b, shape.value.ty, false, span)
    if ir_failed(b) -> return
    none: ir_word_const(m, b, 0)
    present: ir_bool_op(m, b, IROp.Ge, found, none)
    ir_open_if(b.f, present, b.line)
    entries: ir_load_word(m, b, map, 16)
    entry: ir_element_address(m, b, entries, found, shape.stride)
    if glue >= 0 || m.types[shape.value.ty].drop != "" {
        old: ir_load_at(m, b, entry, shape.value.offset, shape.value.ty)
        if glue >= 0 -> ir_close_call(b, glue, old)
        if m.types[shape.value.ty].drop != "" -> ir_emit(b.f, IROp.Drop, -1, old, -1, -1, b.line)
    }
    ir_emit(b.f, IROp.Store, -1, entry, shape.value.offset, owned, b.line)
    if b.fresh[key] && ir_has_drop(m, b, key) -> ir_emit(b.f, IROp.Drop, -1, key, -1, -1, b.line)
    ir_else(b.f, b.line)
    owned_key: ir_own(m, p, b, key)
    _: ir_map_call(m, p, b, row, "map.set", [Int]{map, owned_key, owned}, -1)
    ir_end(b.f, b.line)
    b.fresh[key] = false
    b.fresh[owned_key] = false
    b.fresh[owned] = false
}

// The entry a probe of `map` for `key` found (ir_map_update), if one did.
ir_map_probed: fn(b: IRBuilder, map: Int, key: Int) -> Int? Never! {
    probe: b.probe ?? return None
    if probe.map == map && probe.key == key -> return Val(probe.found)
    None
}

// `map.get(key)` from the entry `found` a probe found: a copy of its value,
// absent when `found` is negative (as map.get answers).
ir_map_found_option: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, shape: IRMapShape, map: Int, found: Int, option_row: Int) -> Int Never! {
    result: ir_fresh_temp(m, b, option_row)
    ir_option_none(m, b, result)
    none: ir_word_const(m, b, 0)
    present: ir_bool_op(m, b, IROp.Ge, found, none)
    ir_open_if(b.f, present, b.line)
    entries: ir_load_word(m, b, map, 16)
    entry: ir_element_address(m, b, entries, found, shape.stride)
    stored: ir_load_at(m, b, entry, shape.value.offset, shape.value.ty)
    copied: ir_copy_value(m, p, b, stored, Span{start: 0, end: 0})
    made: ir_option_make(m, p, b, option_row, copied, m.types[shape.value.ty].size)
    ir_option_set(m, b, result, made)
    ir_end(b.f, b.line)
    result
}

// The parts of a group update (ir_map_take_fuses): the map's variable, the
// group's variable and the variable the key reads (ir_map_take_name), and
// the key node of the `get`.
IRMapTake: struct { map: String, group: String, key_root: String, key: Int }

// The index in `body` of the store of the group update statement `at`
// starts (-1: none). A group update is `group := map.get(key) ?? fallback`,
// statements, then `map[key] = group`. It builds as the write window
// `group := &map[key]`, a missing key first seeded with the fallback
// (ir_map_take), and its store builds nothing: each write of `group` lands
// in the map's entry, so growing a group row by row is linear in the group,
// not a copy of it per row. That is the same program when only `group` can
// see the entry until the store. The map is a variable this frame owns (no
// parameter, capture or frame cell), no closure of the body names it and no
// transaction holds the update (ir_map_take_let): a return, a failure or a
// stop that leaves the frame between the take and the store ends the map
// unread, as it ends the group it would have stored. The statements between
// never name the map, never `break` or `next` past the store, never write
// the key's variable and never move the group out (ir_map_take_stmt_ok);
// nothing after the store names the group.
// JetSema's L0534 (Statements.jet sema_stmt_map_group_moved) matches the
// same shape in the source and stays silent on it.
ir_map_take_fuses: fn(p: IRProgram, b: IRBuilder, body: [Int], at: Int) -> Int Never! {
    if at + 1 >= body.len() -> return -1
    update: ir_map_take_let(p, b, body[at]) ?? return -1
    index := at + 1
    loop index < body.len() {
        statement: ir_body_stmt(p, b, body[index])
        if statement == .Assign(place, op, value, _, _) {
            if op == None && ir_map_take_store(p, b, update, place, value) {
                if !ir_map_take_stmts_ok(p, b, update, body, at + 1, index, true) -> return -1
                if !ir_map_take_stmts_ok(p, b, update, body, index + 1, body.len(), false) -> return -1
                return index
            }
        }
        index += 1
    }
    -1
}

// The group update `statement` starts, when it is `group := map.get(key) ??
// fallback` binding a plain variable, with `map` a variable this frame owns
// that no closure of the body names and `key` a variable or a field of one.
ir_map_take_let: fn(p: IRProgram, b: IRBuilder, statement: Int) -> IRMapTake? Never! {
    if ir_body_stmt(p, b, statement) == .Let(local, _, init, _, _, _) {
        if local.generated || local.deref || local.place_borrow || local.address_lifetime != None || local.persist_key != None -> return None
        if b.cells.contains(local.name) || b.transactions.len() > 0 -> return None
        if ir_body_node(p, b, init).kind == .OrFallback(value, _, _) {
            if ir_body_node(p, b, value).kind == .BuiltinMethod(receiver, operation, args) {
                if operation != .GetMap || args.len() != 1 -> return None
                key_root: ir_map_take_key_root(p, b, args[0]) ?? return None
                if b.cells.contains(key_root.name) -> return None
                map: ir_map_take_owned(p, b, receiver) ?? return None
                return Val(IRMapTake{map: map, group: ir_map_take_name(local), key_root: ir_map_take_name(key_root), key: args[0]})
            }
        }
    }
    None
}

// The variable a group update's map reads (ir_map_take_name), when it is a
// variable of this frame that still owns its Map, lends it to nothing, lives
// in no frame cell and no closure of the body names.
ir_map_take_owned: fn(p: IRProgram, b: IRBuilder, receiver: Int) -> String? Never! {
    local: ir_map_take_variable(p, b, receiver) ?? return None
    if b.cells.contains(local.name) -> return None
    binding: ir_lookup_local(b, local) ?? return None
    slot: binding.slot
    if binding.indirect >= 0 || binding.write || !binding.owned -> return None
    if b.f.slot_kind[slot] != .Local || !ir_owned_binding(b, slot) || ir_lent(b, slot) -> return None
    name: ir_map_take_name(local)
    if ir_map_take_captured(p, b, name) -> return None
    Val(name)
}

// Whether a closure of the body names the variable `name`.
ir_map_take_captured: fn(p: IRProgram, b: IRBuilder, name: String) -> Bool Never! {
    found := false
    if b.row >= 0 {
        loop node in p.functions[b.row].tree.nodes {
            if node.kind == .Lambda(_) -> body_each_expr_child(p.functions[b.row].tree, node, fn(child: Int) { ir_map_take_note(p, b, child, name, found) })
        }
        loop node in b.made.nodes {
            if node.kind == .Lambda(_) -> body_each_expr_child(p.functions[b.row].tree, node, fn(child: Int) { ir_map_take_note(p, b, child, name, found) })
        }
    } else {
        loop node in b.made.nodes {
            if node.kind == .Lambda(_) -> body_each_expr_child(b.made, node, fn(child: Int) { ir_map_take_note(p, b, child, name, found) })
        }
    }
    found
}

// Sets `found` when node `id` or a node inside it reads the variable `name`.
ir_map_take_note: fn(p: IRProgram, b: IRBuilder, id: Int, name: String, found: &Bool) Never! {
    if found -> return
    node: ir_body_node(p, b, id)
    if node.kind == .Local(local) {
        if ir_map_take_name(local) == name {
            found = true
            return
        }
    }
    if b.row >= 0 {
        body_each_expr_child(p.functions[b.row].tree, node, fn(child: Int) { ir_map_take_note(p, b, child, name, found) })
    } else {
        body_each_expr_child(b.made, node, fn(child: Int) { ir_map_take_note(p, b, child, name, found) })
    }
}

// Whether statements `from..<to` of `body` keep a group update's window
// sound: `between` its take and its store they never name the map, never
// leave the block early, never write the key's variable and never move the
// group out; after the store they never name the group.
ir_map_take_stmts_ok: fn(p: IRProgram, b: IRBuilder, update: IRMapTake, body: [Int], from: Int, to: Int, between: Bool) -> Bool Never! {
    loop index in from..<to {
        statement: body[index]
        if !ir_map_take_stmt_ok(p, b, update, statement, between) -> return false
        bad := false
        kind: ir_body_stmt(p, b, statement)
        if b.row >= 0 {
            body_each_stmt_child(p.functions[b.row].tree, kind, fn(expression: Int) { ir_map_take_node_ok(p, b, update, expression, between, bad) })
        } else {
            body_each_stmt_child(b.made, kind, fn(expression: Int) { ir_map_take_node_ok(p, b, update, expression, between, bad) })
        }
        if bad -> return false
    }
    true
}

// The statement rules of ir_map_take_stmts_ok, through the statements
// nested in `statement` (its expressions are ir_map_take_node_ok's).
ir_map_take_stmt_ok: fn(p: IRProgram, b: IRBuilder, update: IRMapTake, statement: Int, between: Bool) -> Bool Never! {
    kind: ir_body_stmt(p, b, statement)
    if kind == {
        .Return(_, _) -> return true
        // After the store, leaving the block ends the group too.
        .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> return !between
        .Contract(_) | .ContractScope(_, _, _, _, _) | .Let(_, _, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .ExprStmt(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .If(_, _, _, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .Inline(_, _) | .DebugOnly(_, _) | .DeepCheck(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .Defer(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> {}
    }
    nested: ir_map_take_nested(kind) ?? return false
    if kind == .Assign(place, _, _, _, _) {
        root := ""
        if place == .Local(local) -> root = ir_map_take_name(local)
        if place == .Expr(target) -> root = ir_map_take_root(p, b, target) ?? ""
        if between && (root == update.map || root == update.key_root) -> return false
        if !between && root == update.group -> return false
    }
    loop inner in nested {
        if !ir_map_take_stmt_ok(p, b, update, inner, between) -> return false
    }
    true
}

// The statements nested in `kind`: an `if`'s, a `match`'s or a loop's
// bodies; None for a statement a group update does not look into (one that
// leaves the block early among them).
ir_map_take_nested: fn(kind: StmtKind) -> [Int]? Never! {
    nested := [Int]{}
    if kind == {
        .Let(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .ExprStmt(_, _) -> {}
        .If(_, then_body, else_body, _, _) -> {
            loop inner in then_body -> nested.push(inner)
            if else_body == .Val(other) {
                loop inner in other -> nested.push(inner)
            }
        }
        .Loop(_, body, _) | .While(_, _, body, _) | .Inline(body, _) | .DebugOnly(body, _) | .DeepCheck(body, _) -> {
            loop inner in body -> nested.push(inner)
        }
        .ForIn(_, _, _, _, _, _, _, _, _, _, body, _) -> {
            loop inner in body -> nested.push(inner)
        }
        .ForRange(_, _, _, _, _, _, body, _, _) -> {
            loop inner in body -> nested.push(inner)
        }
        .Range(_, _, _, _, _, _, _, _, body, _) -> {
            loop inner in body -> nested.push(inner)
        }
        .CountedLoop(_, _, _, _, _, body, _) -> {
            loop inner in body -> nested.push(inner)
        }
        .Match(_, arms, _, _) -> {
            loop arm in arms {
                loop inner in arm.body -> nested.push(inner)
            }
        }
        .EnumMatch(_, arms, else_body, _, _) -> {
            loop arm in arms {
                loop inner in arm.body -> nested.push(inner)
            }
            if else_body == .Val(other) {
                loop inner in other -> nested.push(inner)
            }
        }
        .Contract(_) | .ContractScope(_, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .RangeSwitch(_, _, _, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .Defer(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> return None
    }
    Val(nested)
}

// Sets `bad` when node `id` or a node inside it breaks a group update's
// window (ir_map_take_stmts_ok): `between` the take and the store, a read
// of the map, a fallback that jumps past the store, a block of statements
// inside an expression (which may), a raw address, a write or move of the
// key's variable or a move of the group; after the store, a read of the
// group.
ir_map_take_node_ok: fn(p: IRProgram, b: IRBuilder, update: IRMapTake, id: Int, between: Bool, bad: &Bool) Never! {
    if bad -> return
    node: ir_body_node(p, b, id)
    if !between {
        if node.kind == .Local(local) {
            if ir_map_take_name(local) == update.group -> bad = true
        }
    } else {
        if node.kind == {
            .Local(local) -> bad = ir_map_take_name(local) == update.map
            .InlineBlock(_) | .RawOf(_) | .RawAddressOf(_) -> bad = true
            .OrFallback(_, fallback, _) -> {
                if fallback == {
                    .Break | .Continue | .BreakLabel(_) | .ContinueLabel(_) -> bad = true
                    .Value(_) | .Return(_) | .Panic(_, _) -> {}
                }
            }
            .IfExpr(_, then_body, _, else_body, _) -> bad = then_body.len() > 0 || else_body.len() > 0
            .Move(value) -> {
                root: ir_map_take_root(p, b, value) ?? ""
                bad = root == update.group || root == update.key_root
            }
            .Borrow(place, access) -> bad = access != .Read && (ir_map_take_root(p, b, place) ?? "") == update.key_root
            .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Unit | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
        }
    }
    if bad -> return
    if b.row >= 0 {
        body_each_expr_child(p.functions[b.row].tree, node, fn(child: Int) { ir_map_take_node_ok(p, b, update, child, between, bad) })
    } else {
        body_each_expr_child(b.made, node, fn(child: Int) { ir_map_take_node_ok(p, b, update, child, between, bad) })
    }
}

// The variable a place or key node `id` reads (ir_map_take_name), through
// fields, elements, borrows, moves and copies.
ir_map_take_root: fn(p: IRProgram, b: IRBuilder, id: Int) -> String? Never! {
    if ir_body_node(p, b, id).kind == {
        .Local(local) -> return Val(ir_map_take_name(local))
        .Field(receiver, _) | .Borrow(receiver, _) | .Move(receiver) | .Clone(receiver, _) | .ExplicitCopy(receiver) -> return ir_map_take_root(p, b, receiver)
        .Index(base, _, _, _, _, _) -> return ir_map_take_root(p, b, base)
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> return None
    }
}

// The variable key node `id` reads, when it is that variable or a field of
// one.
ir_map_take_key_root: fn(p: IRProgram, b: IRBuilder, id: Int) -> TLocal? Never! {
    if ir_body_node(p, b, id).kind == {
        .Local(local) -> return Val(local)
        .Field(receiver, _) -> return ir_map_take_key_root(p, b, receiver)
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> return None
    }
}

// Whether key nodes `left` and `right` read the same variable and fields.
ir_map_take_same: fn(p: IRProgram, b: IRBuilder, left: Int, right: Int) -> Bool Never! {
    other: ir_body_node(p, b, right)
    if ir_body_node(p, b, left).kind == {
        .Local(local) -> {
            if other.kind == .Local(again) -> return ir_map_take_name(local) == ir_map_take_name(again)
            return false
        }
        .Field(receiver, field) -> {
            if other.kind == .Field(again, same) -> return field.name == same.name && ir_map_take_same(p, b, receiver, again)
            return false
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> return false
    }
}

// The variable node `id` is, through a borrow, move or copy of it.
ir_map_take_variable: fn(p: IRProgram, b: IRBuilder, id: Int) -> TLocal? Never! {
    if ir_body_node(p, b, id).kind == {
        .Local(local) -> return Val(local)
        .Borrow(place, _) | .Move(place) | .Clone(place, _) -> return ir_map_take_variable(p, b, place)
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> return None
    }
}

ir_map_take_name: fn(local: TLocal) -> String Never! {
    if local.symbol_id == .Val(id) -> return "{local.name}/{id.id}"
    local.name
}

// Whether `place = value` is `map[key] = group` for the update's map, key
// and group.
ir_map_take_store: fn(p: IRProgram, b: IRBuilder, update: IRMapTake, place: BodyPlace, value: Int) -> Bool Never! {
    if place == .Expr(target) {
        if ir_body_node(p, b, target).kind == .Index(base, index, _, _, _, _) {
            map: ir_map_take_variable(p, b, base) ?? return false
            group: ir_map_take_variable(p, b, value) ?? return false
            return ir_map_take_name(map) == update.map && ir_map_take_name(group) == update.group && ir_map_take_same(p, b, index, update.key)
        }
    }
    false
}

// `local := map.get(key) ?? fallback` of a group update (ir_map_take_fuses):
// `local` binds the write window of the key's entry, which a missing key
// first gets with the fallback's value (a fallback that stops leaves).
ir_map_take: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, local: TLocal, init: Int, span: Span) Never! {
    ir_stmt_line(p, b, span)
    receiver := -1
    index := -1
    fallback := BodyOrFallback.Value{value: -1}
    if ir_body_node(p, b, init).kind == .OrFallback(value, alternative, _) {
        fallback = alternative
        if ir_body_node(p, b, value).kind == .BuiltinMethod(base, _, args) {
            receiver = base
            index = args[0]
        }
    }
    if receiver < 0 -> return ir_fail(b, span, "map group update")
    base_ty: ir_ty(p, b, receiver)
    map: ir_write_base(m, p, b, receiver, span)
    if ir_failed(b) || map < 0 -> return
    ir_make_unique(m, p, b, map)
    row: b.f.slot_type[map]
    shape: ir_map_shape(m, p, row) ?? return ir_fail(b, span, "map group update of {ir_type_name(base_ty)}")
    key: ir_value_as(m, p, b, index, shape.key.ty, span)
    if ir_failed(b) || key < 0 -> return
    value_row: shape.value.ty
    word_row: ir_word_row(m)
    found: ir_map_call(m, p, b, row, "map.find", [Int]{map, key}, word_row)
    at: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, at, found, -1, -1, b.line)
    none: ir_word_const(m, b, 0)
    present: ir_bool_op(m, b, IROp.Ge, found, none)
    // The fallback runs where the key is missing: a variable it moves still
    // owns its value where the key is present (ir_meet_paths).
    before: ir_own_states(b, b.bindings.len())
    ir_open_if(b.f, present, b.line)
    if b.fresh[key] && ir_has_drop(m, b, key) -> ir_emit(b.f, IROp.Drop, -1, key, -1, -1, b.line)
    ir_else(b.f, b.line)
    if fallback == .Value(_) {
        seed: ir_temp(m, b, value_row)
        ir_fallback_route(m, p, b, fallback, seed, span)
        if ir_failed(b) -> return
        b.fresh[seed] = ir_has_drop(m, b, seed)
        ir_map_set(m, p, b, row, map, key, seed)
        point: ir_map_added_index(m, b, shape, map, found)
        ir_emit(b.f, IROp.Copy, at, point, -1, -1, b.line)
    } else {
        ir_fallback_route(m, p, b, fallback, -1, span)
        if ir_failed(b) -> return
    }
    ir_end(b.f, b.line)
    fallback_leaves: ir_fallback_leaves(p, b, fallback)
    ir_meet_paths(m, b, present, before, false, fallback_leaves)
    b.fresh[key] = false
    entries: ir_load_word(m, b, map, 16)
    entry: ir_element_address(m, b, entries, at, shape.stride)
    value: ir_address_at(m, b, entry, shape.value.offset)
    symbol: if local.symbol_id == .Val(id) -> id else -> symbol_none()
    if m.types[value_row].kind != .Aggregate {
        b.bindings.push(IRBinding{name: local.name, slot: value, indirect: value_row, symbol: symbol})
        return
    }
    address: ir_temp(m, b, value_row)
    ir_emit(b.f, IROp.Offset, address, value, 0, -1, b.line)
    b.bindings.push(IRBinding{name: local.name, slot: address, symbol: symbol, write: true})
}

// `[k: v, ...]` in display: `[:]` when empty; keys and values render as
// themselves.
ir_render_map: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, builder: Int, slot: Int, mode: IRRender, span: Span) Never! {
    row: b.f.slot_type[slot]
    shape: ir_map_shape(m, p, row) ?? return ir_fail(b, span, "display of {ir_type_name(m.types[row].ty)}")
    length: ir_load_word(m, b, slot, 0)
    zero: ir_word_const(m, b, 0)
    empty: ir_bool_op(m, b, IROp.Eq, length, zero)
    ir_open_if(b.f, empty, b.line)
    ir_push_static(m, b, builder, "[:]")
    ir_else(b.f, b.line)
    ir_push_static(m, b, builder, "[")
    ordered: ir_map_ordered(m, p, b, slot)
    walk: ir_walk_open(m, b, ordered, shape.entry)
    first: ir_word_const(m, b, 0)
    later: ir_bool_op(m, b, IROp.Ne, walk.index, first)
    ir_open_if(b.f, later, b.line)
    ir_push_static(m, b, builder, ", ")
    ir_end(b.f, b.line)
    key: ir_load_at(m, b, walk.item, shape.key.offset, shape.key.ty)
    ir_render_push_value(m, p, b, builder, key, mode, span)
    ir_push_static(m, b, builder, ": ")
    value: ir_load_at(m, b, walk.item, shape.value.offset, shape.value.ty)
    ir_render_push_value(m, p, b, builder, value, mode, span)
    ir_walk_close(m, b, walk)
    ir_map_ordered_end(m, b, slot, ordered)
    ir_push_static(m, b, builder, "]")
    ir_end(b.f, b.line)
}

// The entries of the Map at `map` in key order, as a List header (len, cap,
// data) to walk (ir_walk_open). A hashed Map's is a [U8] header owning its
// map.order buffer (capacity 0 when that is the Map's own), held by a
// variable binding so that any exit drops it, as ir_map_ordered_end does on
// the way out; any other Map is its own.
ir_map_ordered: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, map: Int) -> Int Never! {
    row: b.f.slot_type[map]
    shape: ir_keyed_shape(m, p, row) ?? return map
    if !ir_map_hashed(shape) -> return map
    word_row: ir_word_row(m)
    bytes_ty: Type.List{element: Type.IntN{signed: false, bits: 8}}
    bytes_row: ir_value_type(m, p, bytes_ty) ?? return ir_type_fail(b, Span{start: 0, end: 0}, bytes_ty)
    view: ir_map_call(m, p, b, row, "map.order", [Int]{map}, word_row)
    header: ir_list_empty(m, b, bytes_row)
    b.fresh[header] = false
    length: ir_load_word(m, b, map, 0)
    data: ir_load_word(m, b, map, 16)
    ir_emit(b.f, IROp.Store, -1, header, 0, length, b.line)
    ir_emit(b.f, IROp.Store, -1, header, 16, view, b.line)
    copied: ir_bool_op(m, b, IROp.Ne, view, data)
    ir_open_if(b.f, copied, b.line)
    width: ir_word_const(m, b, shape.stride)
    bytes: ir_word_op(m, b, IROp.Mul, length, width)
    ir_emit(b.f, IROp.Store, -1, header, 8, bytes, b.line)
    ir_end(b.f, b.line)
    b.bindings.push(IRBinding{name: "map.ordered", slot: header, owned: true})
    header
}

// Drops the ordered header `header` of the Map at `map` (ir_map_ordered).
ir_map_ordered_end: fn(m: &IRModule, b: &IRBuilder, map: Int, header: Int) Never! {
    if header == map || !ir_owned_binding(b, header) -> return
    ir_emit(b.f, IROp.Drop, -1, header, -1, -1, b.line)
    ir_disown(b, header)
}

// Before a walk of the hashed Map at `map` that expression `collection`
// reads: a variable that owns it and may write it (a `:=` binding, a write
// parameter) settles it (map.settle), its out-of-order entries merged into
// its own buffer, so the walk reads that buffer instead of a sorted copy.
ir_map_settle_for: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, collection: Int, map: Int) Never! {
    row: b.f.slot_type[map]
    shape: ir_keyed_shape(m, p, row) ?? return
    if !ir_map_hashed(shape) -> return
    if ir_body_node(p, b, collection).kind == .Local(local) {
        binding: ir_lookup_local(b, local) ?? return
        if binding.slot != map || binding.indirect >= 0 -> return
        owner: local.mutable && binding.owned && binding.live < 0
        if owner || binding.write {
            _: ir_map_call(m, p, b, row, "map.settle", [Int]{map}, -1)
        }
    }
}

// Whether the `loop (k, v) in table.move()` walk (Sema's ForIn by_value) of
// the Map at `map`, or a walk of a fresh Map, takes its entries over
// (ir_map_walk_take): a part of an entry closes or is a move-only handle
// (ir_map_part_closes), which a step can't share with the Map (a byte copy
// shares it uncounted, so both would end it).
ir_map_walk_takes: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, map: Int, paired: Bool, by_value: Bool, span: Span) -> Bool Never! {
    if !paired || !(b.fresh[map] || (by_value && ir_owned_binding(b, map))) -> return false
    shape: ir_map_shape(m, p, b.f.slot_type[map]) ?? return false
    key: ir_map_part_closes(m, p, b, shape.key.ty, span)
    value: ir_map_part_closes(m, p, b, shape.value.ty, span)
    !ir_failed(b) && (key || value)
}

// Moves the Map at `map` into the walk that takes its entries
// (ir_map_walk_takes), as `table.move()` moves it, and returns the walk's own
// holder of it, an owned binding of the walk's scope. Its buffer is made
// unique, a hashed Map settled (map.settle) into key order, and the entries
// reversed in place (ir_map_reverse_entries), so each step takes the last one,
// in key order, and shortens the Map past it (ir_map_walk_entry). On any exit
// the holder closes the entries no step took in key order, from the last one
// (ir_map_rest_glue), and its drop ends them.
ir_map_walk_take: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, map: Int, span: Span) -> Int Never! {
    row: b.f.slot_type[map]
    shape: ir_map_shape(m, p, row) ?? return ir_fail_slot(b, span, "walk of {ir_type_name(m.types[row].ty)}")
    ir_close_disarm(b, map)
    if !b.fresh[map] -> b.moving = map
    owned: ir_own(m, p, b, map)
    if ir_failed(b) -> return -1
    holder: ir_temp(m, b, row)
    ir_emit(b.f, IROp.StackAddress, holder, m.types[row].size, 8, -1, b.line)
    ir_emit(b.f, IROp.CopyBytes, -1, holder, owned, m.types[row].size, b.line)
    b.fresh[owned] = false
    b.fresh[holder] = false
    b.bindings.push(IRBinding{name: "", slot: holder, owned: true})
    ir_make_unique(m, p, b, holder)
    if ir_map_hashed(shape) {
        _: ir_map_call(m, p, b, row, "map.settle", [Int]{holder}, -1)
    }
    ir_map_reverse_entries(m, b, shape, holder)
    glue: ir_map_rest_glue(m, p, b, row, shape, span)
    if glue >= 0 {
        word_row: ir_word_row(m)
        armed: ir_new_slot(b, word_row, IRSlotKind.Local, -1)
        ir_emit(b.f, IROp.Const, armed, 1, -1, -1, b.line)
        flag: ir_type_row(m, Type.Bool) ?? 0
        b.closes.push(IRClose{slot: holder, armed: armed, glue: glue, members_only: false, flag: flag})
    }
    holder
}

// The IR function closing what a walk that takes the entries of a Map of type
// row `row` left of it (ir_map_walk_take): its entries, reversed in place,
// from the last one, so they close in key order as the Map's own close
// (ir_close_glue) closes them; -1 when nothing in an entry closes.
ir_map_rest_glue: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int, shape: IRMapShape, span: Span) -> Int Never! {
    key: "#close.rest<{ir_row_key(m, row)}>"
    known: name_rows_value(m.close_glue, key) ?? -3
    if known == -2 {
        message: ir_helper_error(m, key) ?? panic("a failed close glue lost its message")
        ir_fail(b, span, message)
        return -1
    }
    if known != -3 -> return known
    entry: ir_close_glue(m, p, b, shape.entry, false, span)
    if entry < 0 {
        name_rows_set(m.close_glue, key, -1)
        return -1
    }
    id: m.functions.len()
    m.functions.push(ir_hashed_function("close", key, "jet_ir_close_", "", 0))
    name_rows_set(m.function_rows, key, id)
    name_rows_set(m.close_glue, key, id)
    a := ir_builder_new(m.functions[id].copy())
    value_name: ir_intern_name(m, "value")
    value: ir_new_slot(a, row, IRSlotKind.Param, value_name)
    length: ir_load_word(m, a, value, 0)
    data: ir_load_word(m, a, value, 16)
    zero: ir_word_const(m, a, 0)
    one: ir_word_const(m, a, 1)
    index: ir_word_const(m, a, 0)
    ir_emit(a.f, IROp.Copy, index, length, -1, -1, a.line)
    done: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    more: ir_bool_op(m, a, IROp.Gt, index, zero)
    ir_exit_unless(m, a, more, done)
    ir_emit(a.f, IROp.Sub, index, index, one, IR_OVERFLOW_WRAP, a.line)
    address: ir_element_address(m, a, data, index, shape.stride)
    item: ir_load_at(m, a, address, 0, shape.entry)
    ir_close_call(a, entry, item)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    if a.error != "" {
        ir_emit(a.f, IROp.Unreachable, -1, -1, -1, -1, a.line)
        failure: a.error.copy()
        m.functions[id] = a.f.move()
        name_rows_set(m.close_glue, key, -2)
        ir_helper_failed(m, key, failure.copy())
        ir_fail(b, span, failure)
        return -1
    }
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
    m.functions[id] = a.f.move()
    id
}

// Whether a value of type row `row` closes or is a move-only handle, as the
// items a List walk takes over (ir_list_walk_takes).
ir_map_part_closes: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int, span: Span) -> Bool Never! {
    if ir_close_handle(m, row) -> return true
    ir_close_glue(m, p, b, row, false, span) >= 0
}

// Reverses the entries of the unique Map at `map` in place. Only a walk that
// takes them (ir_map_walk_take) reorders them: the Map's index no longer
// finds them, and nothing looks one up again.
ir_map_reverse_entries: fn(m: &IRModule, b: &IRBuilder, shape: IRMapShape, map: Int) Never! {
    length: ir_load_word(m, b, map, 0)
    data: ir_load_word(m, b, map, 16)
    one: ir_word_const(m, b, 1)
    low: ir_word_const(m, b, 0)
    high: ir_word_const(m, b, 0)
    ir_emit(b.f, IROp.Sub, high, length, one, IR_OVERFLOW_WRAP, b.line)
    pointer_row: ir_pointer_row(m)
    scratch: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.StackAddress, scratch, shape.stride, 8, -1, b.line)
    done: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    more: ir_bool_op(m, b, IROp.Lt, low, high)
    ir_exit_unless(m, b, more, done)
    front: ir_element_address(m, b, data, low, shape.stride)
    back: ir_element_address(m, b, data, high, shape.stride)
    ir_emit(b.f, IROp.CopyBytes, -1, scratch, front, shape.stride, b.line)
    ir_emit(b.f, IROp.CopyBytes, -1, front, back, shape.stride, b.line)
    ir_emit(b.f, IROp.CopyBytes, -1, back, scratch, shape.stride, b.line)
    ir_emit(b.f, IROp.Add, low, low, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(b.f, IROp.Sub, high, high, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
}

// The entry step `index` of a walk that takes the `length` entries of the
// Map at `map` (ir_map_walk_take) reads: the last one left in `data`, which
// the Map stops holding.
ir_map_walk_entry: fn(m: &IRModule, b: &IRBuilder, map: Int, data: Int, length: Int, index: Int, stride: Int) -> Int Never! {
    one: ir_word_const(m, b, 1)
    left: ir_word_op(m, b, IROp.Sub, length, index)
    last: ir_word_op(m, b, IROp.Sub, left, one)
    ir_emit(b.f, IROp.Store, -1, map, 0, last, b.line)
    ir_element_address(m, b, data, last, stride)
}

// The `part` of the entry at `item` a step of a Map walk binds: read in
// place, or, when the step `takes` the entry (ir_map_walk_takes), the step's
// own value, an aggregate copied out of the entry.
ir_map_walk_part: fn(m: &IRModule, b: &IRBuilder, item: Int, part: IRMember, takes: Bool) -> Int Never! {
    read: ir_load_at(m, b, item, part.offset, part.ty)
    if !takes || read < 0 -> return read
    taken := read
    if m.types[part.ty].kind == .Aggregate {
        taken = ir_temp(m, b, part.ty)
        ir_emit(b.f, IROp.StackAddress, taken, m.types[part.ty].size, 8, -1, b.line)
        ir_emit(b.f, IROp.CopyBytes, -1, taken, read, m.types[part.ty].size, b.line)
    }
    b.fresh[taken] = false
    taken
}

// Empties the index of the hashed Map at `map` after its entries are gone.
ir_map_clear_index: fn(m: &IRModule, b: &IRBuilder, shape: IRMapShape, map: Int) Never! {
    zero: ir_word_const(m, b, 0)
    capacity: ir_load_word(m, b, map, 8)
    counted: ir_bool_op(m, b, IROp.Gt, capacity, zero)
    ir_open_if(b.f, counted, b.line)
    data: ir_load_word(m, b, map, 16)
    trailer: ir_map_trailer(m, b, shape, data, capacity)
    ir_emit(b.f, IROp.Store, -1, trailer, 0, zero, b.line)
    mask: ir_load_word(m, b, trailer, 8)
    cleared: ir_word_const(m, b, 0)
    emptied: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    within: ir_bool_op(m, b, IROp.Le, cleared, mask)
    ir_exit_unless(m, b, within, emptied)
    cleared_at: ir_map_slot_address(m, b, trailer, cleared)
    ir_emit(b.f, IROp.Store, -1, cleared_at, 0, zero, b.line)
    one: ir_word_const(m, b, 1)
    ir_emit(b.f, IROp.Add, cleared, cleared, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
}

// A Map builtin by its route symbol: len, is_empty, has_key, get (an owned
// copy), insert (the replaced value), try_insert (it in a Result), remove
// (the removed value), keys / values (an Iter), top_n (a ranked List of
// entries), update and setdefault (in place); `ty` is the result type. None
// when the builder does not lower `symbol` on Maps.
ir_map_builtin: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, symbol: String, subject: Int, operands: [Int], span: Span) -> Int? Never! {
    row: b.f.slot_type[subject]
    shape: ir_map_shape(m, p, row) ?? return None
    if symbol == "jet_map_len" {
        int_row: ir_type_row(m, Type.Int) ?? 0
        return Val(ir_load_at(m, b, subject, 0, int_row))
    }
    if symbol == "jet_map_is_empty" {
        length: ir_load_word(m, b, subject, 0)
        zero: ir_word_const(m, b, 0)
        return Val(ir_bool_op(m, b, IROp.Eq, length, zero))
    }
    if symbol == "jet_map_keys" || symbol == "jet_map_values" {
        if operands.len() != 1 -> return Val(ir_fail_slot(b, span, "Map {symbol} with {operands.len() - 1} arguments"))
        return Val(ir_map_view(m, p, b, ty, shape, subject, symbol == "jet_map_keys", span))
    }
    if symbol == "jet_map_top_n" {
        if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Map top_n without a count"))
        return Val(ir_map_top_n(m, p, b, ty, shape, subject, operands[1], span))
    }
    // `clear()`: each entry drops and the map is left empty; its buffer stays
    // for later inserts, as the priority queue's `clear` does.
    if symbol == "std::collections::HashMap::clear" {
        if operands.len() != 1 -> return Val(ir_fail_slot(b, span, "Map clear with {operands.len() - 1} arguments"))
        if m.types[shape.entry].drop != "" {
            walk: ir_walk_open(m, b, subject, shape.entry)
            ir_emit(b.f, IROp.Drop, -1, walk.item, -1, -1, b.line)
            ir_walk_close(m, b, walk)
        }
        zero: ir_word_const(m, b, 0)
        ir_emit(b.f, IROp.Store, -1, subject, 0, zero, b.line)
        if ir_map_hashed(shape) -> ir_map_clear_index(m, b, shape, subject)
        return Val(-1)
    }
    // `equal(other)` is the maps' equality; `merge(other)` is a copy of the
    // receiver with each entry of `other` set as a copy: the right side wins
    // (each key once, so the walk's order is never seen).
    if symbol == "jet_map_equal" || symbol == "jet_map_merge" {
        if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Map {symbol} with {operands.len() - 1} arguments"))
        other: ir_adapt(m, p, b, operands[1], row, span)
        if ir_failed(b) -> return Val(-1)
        if symbol == "jet_map_equal" {
            same: ir_equal(m, p, b, subject, other, span)
            ir_release(m, b, other)
            return Val(same)
        }
        target: ir_copy_value(m, p, b, subject, span)
        // The copy shares the receiver's buffer until it is the target's own.
        ir_make_unique(m, p, b, target)
        walk: ir_walk_open(m, b, other, shape.entry)
        key: ir_load_at(m, b, walk.item, shape.key.offset, shape.key.ty)
        value: ir_load_at(m, b, walk.item, shape.value.offset, shape.value.ty)
        ir_map_set(m, p, b, row, target, key, value)
        ir_walk_close(m, b, walk)
        ir_release(m, b, other)
        return Val(target)
    }
    // `update(other)`: each entry of `other` set in the receiver as a copy,
    // in place, the right side winning as in `merge`. The checker keeps
    // `other` from being the receiver itself (E0204).
    if symbol == "jet_map_update_all" {
        if operands.len() != 2 || operands[1] < 0 {
            return Val(ir_fail_slot(b, span, "Map update with {operands.len() - 1} arguments"))
        }
        other: ir_adapt(m, p, b, operands[1], row, span)
        if ir_failed(b) -> return Val(-1)
        walk: ir_walk_open(m, b, other, shape.entry)
        key: ir_load_at(m, b, walk.item, shape.key.offset, shape.key.ty)
        value: ir_load_at(m, b, walk.item, shape.value.offset, shape.value.ty)
        ir_map_set(m, p, b, row, subject, key, value)
        ir_walk_close(m, b, walk)
        ir_release(m, b, other)
        return Val(-1)
    }
    if symbol == "jet_map_first_key" || symbol == "jet_map_min_value_kernel" || symbol == "jet_map_max_value_kernel" {
        if operands.len() != 1 -> return Val(ir_fail_slot(b, span, "Map {symbol} with {operands.len() - 1} arguments"))
        return Val(ir_map_pick(m, p, b, ty, shape, subject, symbol, span))
    }
    if symbol == "jet_map_merge_with" {
        if operands.len() != 3 || operands[1] < 0 || operands[2] < 0 -> return Val(ir_fail_slot(b, span, "Map merge_with with {operands.len() - 1} arguments"))
        other: ir_adapt(m, p, b, operands[1], row, span)
        if ir_failed(b) -> return Val(-1)
        return Val(ir_map_merge_with(m, p, b, shape, row, subject, other, operands[2], span))
    }
    // `to_list()` / `items()`: the `(key, value)` entries in key order, as
    // copies.
    if symbol == "jet_map_to_list" {
        if operands.len() != 1 -> return Val(ir_fail_slot(b, span, "Map to_list with {operands.len() - 1} arguments"))
        result_row: ir_value_type(m, p, ty) ?? return Val(ir_type_fail(b, span, ty))
        result: ir_list_empty(m, b, result_row)
        if ir_list_element(m, p, b, result) != Val(shape.entry) -> return Val(ir_fail_slot(b, span, "Map to_list entries as {ir_type_name(ty)}"))
        ordered: ir_map_ordered(m, p, b, subject)
        walk: ir_walk_open(m, b, ordered, shape.entry)
        ir_list_push(m, p, b, result, shape.entry, walk.item)
        ir_walk_close(m, b, walk)
        ir_map_ordered_end(m, b, subject, ordered)
        return Val(result)
    }
    // `intersection(other)`: a new Map of copies of the receiver's entries
    // whose key `other` holds too.
    if symbol == "jet_map_intersection" {
        if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Map intersection without an operand"))
        other: ir_adapt(m, p, b, operands[1], row, span)
        if ir_failed(b) -> return Val(-1)
        target: ir_list_empty(m, b, row)
        walk: ir_walk_open(m, b, subject, shape.entry)
        key: ir_load_at(m, b, walk.item, shape.key.offset, shape.key.ty)
        word_row: ir_word_row(m)
        found: ir_map_call(m, p, b, row, "map.find", [Int]{other, key}, word_row)
        none: ir_word_const(m, b, 0)
        shared: ir_bool_op(m, b, IROp.Ge, found, none)
        ir_open_if(b.f, shared, b.line)
        value: ir_load_at(m, b, walk.item, shape.value.offset, shape.value.ty)
        ir_map_set(m, p, b, row, target, key, value)
        ir_end(b.f, b.line)
        ir_walk_close(m, b, walk)
        ir_release(m, b, other)
        return Val(target)
    }
    // `contains_value(v)`: whether an entry's value equals `v`.
    if symbol == "jet_map_contains_value" {
        if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Map contains_value without a value"))
        needle: ir_adapt(m, p, b, operands[1], shape.value.ty, span)
        if ir_failed(b) -> return Val(-1)
        bool_row: ir_type_row(m, Type.Bool) ?? 0
        found: ir_temp(m, b, bool_row)
        ir_emit(b.f, IROp.Const, found, 0, -1, -1, b.line)
        walk: ir_walk_open(m, b, subject, shape.entry)
        value: ir_load_at(m, b, walk.item, shape.value.offset, shape.value.ty)
        same: ir_route_equal(m, p, b, value, needle, span)
        if ir_failed(b) -> return Val(-1)
        ir_open_if(b.f, same, b.line)
        ir_emit(b.f, IROp.Const, found, 1, -1, -1, b.line)
        ir_emit(b.f, IROp.Br, -1, 2, -1, -1, b.line)
        ir_end(b.f, b.line)
        ir_walk_close(m, b, walk)
        ir_release(m, b, needle)
        return Val(found)
    }
    // `pop_first()`: the least key's entry leaves the map, its value the
    // result; None when the map is empty.
    if symbol == "jet_map_pop_first" {
        if operands.len() != 1 -> return Val(ir_fail_slot(b, span, "Map pop_first with {operands.len() - 1} arguments"))
        option_row: ir_value_type(m, p, Type.Option{inner: shape.value_ty}) ?? return Val(ir_fail_slot(b, span, "map builtin {symbol} result"))
        result: ir_fresh_temp(m, b, option_row)
        ir_option_none(m, b, result)
        length: ir_load_word(m, b, subject, 0)
        zero: ir_word_const(m, b, 0)
        present: ir_bool_op(m, b, IROp.Gt, length, zero)
        ir_open_if(b.f, present, b.line)
        data: ir_load_word(m, b, subject, 16)
        pointer_row: ir_pointer_row(m)
        chosen: ir_temp(m, b, pointer_row)
        ir_emit(b.f, IROp.Copy, chosen, data, -1, -1, b.line)
        if ir_map_hashed(shape) {
            // The appended entries are out of order: the least of all.
            walk: ir_walk_open(m, b, subject, shape.entry)
            entry: ir_element_address(m, b, data, walk.index, shape.stride)
            candidate: ir_load_at(m, b, entry, shape.key.offset, shape.key.ty)
            incumbent: ir_load_at(m, b, chosen, shape.key.offset, shape.key.ty)
            order: ir_map_order(m, p, b, shape.kind, candidate, incumbent)
            ir_open_if(b.f, order.less, b.line)
            ir_emit(b.f, IROp.Copy, chosen, entry, -1, -1, b.line)
            ir_end(b.f, b.line)
            ir_walk_close(m, b, walk)
        }
        least: ir_load_at(m, b, chosen, shape.key.offset, shape.key.ty)
        probe: ir_copy_value(m, p, b, least, span)
        removed: ir_map_call(m, p, b, row, "map.remove", [Int]{subject, probe}, option_row)
        ir_option_set(m, b, result, removed)
        ir_release(m, b, probe)
        ir_end(b.f, b.line)
        return Val(result)
    }
    // `slice(keys)`: a new Map of copies of the entries under the listed keys.
    if symbol == "jet_map_slice_keys_kernel" {
        if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Map slice without keys"))
        keys: operands[1]
        keys_name: ir_type_name(m.types[b.f.slot_type[keys]].ty)
        if ir_list_element(m, p, b, keys) != Val(shape.key.ty) -> return Val(ir_fail_slot(b, span, "Map slice keys of {keys_name}"))
        target: ir_list_empty(m, b, row)
        word_row: ir_word_row(m)
        walk: ir_walk_open(m, b, keys, shape.key.ty)
        found: ir_map_call(m, p, b, row, "map.find", [Int]{subject, walk.item}, word_row)
        none: ir_word_const(m, b, 0)
        held: ir_bool_op(m, b, IROp.Ge, found, none)
        ir_open_if(b.f, held, b.line)
        entries: ir_load_word(m, b, subject, 16)
        entry: ir_element_address(m, b, entries, found, shape.stride)
        value: ir_load_at(m, b, entry, shape.value.offset, shape.value.ty)
        ir_map_set(m, p, b, row, target, walk.item, value)
        ir_end(b.f, b.line)
        ir_walk_close(m, b, walk)
        return Val(target)
    }
    keyed: symbol == "jet_map_has_key" || symbol == "jet_map_get_opt" || symbol == "jet_map_pop_kernel"
    if !keyed && symbol != "jet_map_insert" && symbol != "jet_map_try_insert" && symbol != "jet_map_add_new" && symbol != "jet_map_setdefault" {
        return None
    }
    if operands.len() < 2 || operands[1] < 0 {
        return Val(ir_fail_slot(b, span, "map builtin {symbol} without a key"))
    }
    key: ir_adapt(m, p, b, operands[1], shape.key.ty, span)
    if ir_failed(b) -> return Val(-1)
    option_row: ir_value_type(m, p, Type.Option{inner: shape.value_ty}) ?? return Val(ir_fail_slot(b, span, "map builtin {symbol} result"))
    if symbol == "jet_map_insert" {
        if operands.len() != 3 || operands[2] < 0 -> return Val(ir_fail_slot(b, span, "map insert without a value"))
        value: ir_adapt(m, p, b, operands[2], shape.value.ty, span)
        owned_key: ir_own(m, p, b, key)
        owned_value: ir_own(m, p, b, value)
        old: ir_map_call(m, p, b, row, "map.insert", [Int]{subject, owned_key, owned_value}, option_row)
        b.fresh[owned_key] = false
        b.fresh[owned_value] = false
        return Val(old)
    }
    // `try_insert(key, value)`: `insert` in a Result, as `String.try_push`:
    // Err(AllocError) naming one entry's bytes, with the Map untouched and the
    // key and value dropped, when the allocation-failure hook refuses; else
    // Ok holding the replaced value.
    if symbol == "jet_map_try_insert" {
        if operands.len() != 3 || operands[2] < 0 {
            return Val(ir_fail_slot(b, span, "map try_insert without a value"))
        }
        err_ty: if ir_untag(ty) == .Result(_, err) -> err else -> {
            return Val(ir_fail_slot(b, span, "try_insert without its checked Result"))

        }
        result_row: ir_value_type(m, p, ty) ?? return Val(ir_type_fail(b, span, ty))
        value: ir_adapt(m, p, b, operands[2], shape.value.ty, span)
        if ir_failed(b) -> return Val(-1)
        owned_key: ir_own(m, p, b, key)
        owned_value: ir_own(m, p, b, value)
        string_row: ir_string_row(m)
        int_row: ir_type_row(m, Type.Int) ?? 0
        bool_row: ir_type_row(m, Type.Bool) ?? 0
        pointer_row: ir_pointer_row(m)
        result: ir_fresh_temp(m, b, result_row)
        refused: ir_runtime(m, b, "jet_fault_should_fail_allocation", [Int]{}, bool_row)
        ir_open_if(b.f, refused, b.line)
        ir_release(m, b, owned_key)
        ir_release(m, b, owned_value)
        requested: ir_int_constant(m, b, int_row, shape.stride)
        map_text: ir_static_text(m, b, "Map")
        allocator: ir_runtime(m, b, "jet_rt_string_from_static", map_text, string_row)
        record: ir_runtime(m, b, "jet_rt_record_new_alloc_error", [Int]{requested, allocator}, pointer_row)
        ir_release(m, b, requested)
        ir_release(m, b, allocator)
        failed: ir_result_box(m, p, b, ty, false, -1)
        ir_record_in(m, p, b, err_ty, record, failed, 8, span)
        ir_emit(b.f, IROp.Copy, result, failed, -1, -1, b.line)
        b.fresh[failed] = false
        ir_else(b.f, b.line)
        old: ir_map_call(m, p, b, row, "map.insert", [Int]{subject, owned_key, owned_value}, option_row)
        inserted: ir_result_box(m, p, b, ty, true, old)
        ir_emit(b.f, IROp.Copy, result, inserted, -1, -1, b.line)
        b.fresh[inserted] = false
        ir_end(b.f, b.line)
        b.fresh[owned_key] = false
        b.fresh[owned_value] = false
        return Val(result)
    }
    // `add_new(key, value)`: inserts only under a missing key, whether it was
    // missing; the copies made for the insert are dropped when the key is
    // there.
    if symbol == "jet_map_add_new" {
        if operands.len() != 3 || operands[2] < 0 -> return Val(ir_fail_slot(b, span, "map add_new without a value"))
        value: ir_adapt(m, p, b, operands[2], shape.value.ty, span)
        if ir_failed(b) -> return Val(-1)
        owned_key: ir_own(m, p, b, key)
        owned_value: ir_own(m, p, b, value)
        word_row: ir_word_row(m)
        found: ir_map_call(m, p, b, row, "map.find", [Int]{subject, owned_key}, word_row)
        zero: ir_word_const(m, b, 0)
        missing: ir_bool_op(m, b, IROp.Lt, found, zero)
        ir_open_if(b.f, missing, b.line)
        old: ir_map_call(m, p, b, row, "map.insert", [Int]{subject, owned_key, owned_value}, option_row)
        ir_release(m, b, old)
        ir_else(b.f, b.line)
        ir_release(m, b, owned_key)
        ir_release(m, b, owned_value)
        ir_end(b.f, b.line)
        b.fresh[owned_key] = false
        b.fresh[owned_value] = false
        return Val(missing)
    }
    // `setdefault(key, default)`: inserts a copy of the key with the default
    // only under a missing key (the default is dropped otherwise), then gives
    // a copy of the value the key holds.
    if symbol == "jet_map_setdefault" {
        if operands.len() != 3 || operands[2] < 0 {
            return Val(ir_fail_slot(b, span, "map setdefault without a default"))
        }
        value: ir_adapt(m, p, b, operands[2], shape.value.ty, span)
        if ir_failed(b) -> return Val(-1)
        owned_value: ir_own(m, p, b, value)
        word_row: ir_word_row(m)
        found: ir_map_call(m, p, b, row, "map.find", [Int]{subject, key}, word_row)
        zero: ir_word_const(m, b, 0)
        missing: ir_bool_op(m, b, IROp.Lt, found, zero)
        ir_open_if(b.f, missing, b.line)
        // The key stays for the lookup below, so the map takes a copy.
        owned_key: ir_copy_value(m, p, b, key, span)
        _: ir_map_call(m, p, b, row, "map.set", [Int]{subject, owned_key, owned_value}, -1)
        b.fresh[owned_key] = false
        ir_else(b.f, b.line)
        ir_release(m, b, owned_value)
        ir_end(b.f, b.line)
        b.fresh[owned_value] = false
        held: ir_map_call(m, p, b, row, "map.find", [Int]{subject, key}, word_row)
        entries: ir_load_word(m, b, subject, 16)
        entry: ir_element_address(m, b, entries, held, shape.stride)
        stored: ir_load_at(m, b, entry, shape.value.offset, shape.value.ty)
        result: ir_copy_value(m, p, b, stored, span)
        ir_release(m, b, key)
        return Val(result)
    }
    result := -1
    if symbol == "jet_map_has_key" {
        word_row: ir_word_row(m)
        found: ir_map_call(m, p, b, row, "map.find", [Int]{subject, key}, word_row)
        none: ir_word_const(m, b, 0)
        result = ir_bool_op(m, b, IROp.Ge, found, none)
    } else if symbol == "jet_map_get_opt" && ir_map_probed(b, subject, key) != None {
        found: ir_map_probed(b, subject, key) ?? -1
        result = ir_map_found_option(m, p, b, shape, subject, found, option_row)
    } else {
        result = ir_map_call(m, p, b, row, if symbol == "jet_map_get_opt" -> "map.get" else -> "map.remove", [Int]{subject, key}, option_row)
    }
    ir_release(m, b, key)
    Val(result)
}

// `map.keys()` / `map.values()`: a List of copies of the entries' keys
// (values), in key order, handed to the runtime Iter by value; later map
// writes never reach it.
ir_map_view: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, shape: IRMapShape, map: Int, keys: Bool, span: Span) -> Int Never! {
    member: if keys -> shape.key else -> shape.value
    item_ty: m.types[member.ty].ty
    if m.types[member.ty].kind == .Unit -> return ir_fail_slot(b, span, "Map view of {ir_type_name(item_ty)}")
    result_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    list_row: ir_value_type(m, p, Type.List{element: item_ty}) ?? return ir_fail_slot(b, span, "type [{ir_type_name(item_ty)}]")
    items: ir_list_empty(m, b, list_row)
    ordered: ir_map_ordered(m, p, b, map)
    walk: ir_walk_open(m, b, ordered, shape.entry)
    item: ir_load_at(m, b, walk.item, member.offset, member.ty)
    ir_list_push(m, p, b, items, member.ty, item)
    ir_walk_close(m, b, walk)
    ir_map_ordered_end(m, b, map, ordered)
    meta: ir_lazy_meta(m, p, b, item_ty, span)
    if meta < 0 -> return -1
    ir_lazy_iter_from_list(m, p, b, items, item_ty, meta, result_row, span)
}

// `map.first_key()` / `map.min_value()` / `map.max_value()`: a copy of the
// chosen key or value in an Option box, None when the map is empty. min keeps
// the first least value, max the last greatest (Iterator::min / max).
ir_map_pick: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, shape: IRMapShape, map: Int, symbol: String, span: Span) -> Int Never! {
    keyed: symbol == "jet_map_first_key"
    member: if keyed -> shape.key else -> shape.value
    kind: ir_map_key_kind(m, member.ty)
    if !keyed && kind == "" -> return ir_fail_slot(b, span, "Map {symbol} of {ir_type_name(shape.value_ty)} values")
    result_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    pointer_row: ir_pointer_row(m)
    result: ir_fresh_temp(m, b, result_row)
    ir_option_none(m, b, result)
    // A hashed Map's least key is found by a scan, its appended entries
    // being out of order; ties between values that order equal yet differ
    // need the key order.
    source: if !keyed && kind == "order" -> ir_map_ordered(m, p, b, map) else -> map
    length: ir_load_word(m, b, source, 0)
    zero: ir_word_const(m, b, 0)
    present: ir_bool_op(m, b, IROp.Gt, length, zero)
    ir_open_if(b.f, present, b.line)
    data: ir_load_word(m, b, source, 16)
    chosen: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.Copy, chosen, data, -1, -1, b.line)
    if !keyed || ir_map_hashed(shape) {
        walk: ir_walk_open(m, b, source, shape.entry)
        entry: ir_element_address(m, b, data, walk.index, shape.stride)
        candidate: ir_load_at(m, b, entry, member.offset, member.ty)
        incumbent: ir_load_at(m, b, chosen, member.offset, member.ty)
        order: ir_map_order(m, p, b, kind, candidate, incumbent)
        // first_key and min replace on candidate < incumbent; max unless
        // candidate < incumbent.
        replace := order.less
        if symbol == "jet_map_max_value_kernel" {
            no: ir_word_const(m, b, 0)
            replace = ir_bool_op(m, b, IROp.Eq, order.less, no)
        }
        ir_open_if(b.f, replace, b.line)
        ir_emit(b.f, IROp.Copy, chosen, entry, -1, -1, b.line)
        ir_end(b.f, b.line)
        ir_walk_close(m, b, walk)
    }
    item: ir_load_at(m, b, chosen, member.offset, member.ty)
    size: m.types[member.ty].size
    made: ir_option_make(m, p, b, result_row, item, size)
    ir_option_set(m, b, result, made)
    ir_end(b.f, b.line)
    ir_map_ordered_end(m, b, map, source)
    result
}

// `map.merge_with(other, conflict)`: a copy of the receiver with each entry
// of `other`, in key order, set as a copy; a key both hold gets
// `conflict(key, left value, right value)`, the callback borrowing its
// arguments, and the left value it replaces ends.
ir_map_merge_with: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, shape: IRMapShape, row: Int, subject: Int, other: Int, callback: Int, span: Span) -> Int Never! {
    word_row: ir_word_row(m)
    target: ir_copy_value(m, p, b, subject, span)
    // The copy shares the receiver's buffer until it is the target's own.
    ir_make_unique(m, p, b, target)
    ordered: ir_map_ordered(m, p, b, other)
    walk: ir_walk_open(m, b, ordered, shape.entry)
    key: ir_load_at(m, b, walk.item, shape.key.offset, shape.key.ty)
    value: ir_load_at(m, b, walk.item, shape.value.offset, shape.value.ty)
    found: ir_map_call(m, p, b, row, "map.find", [Int]{target, key}, word_row)
    zero: ir_word_const(m, b, 0)
    shared: ir_bool_op(m, b, IROp.Ge, found, zero)
    ir_open_if(b.f, shared, b.line)
    data: ir_load_word(m, b, target, 16)
    entry: ir_element_address(m, b, data, found, shape.stride)
    left: ir_load_at(m, b, entry, shape.value.offset, shape.value.ty)
    merged: ir_call_closure(m, b, callback, [Int]{key, left, value}, shape.value.ty)
    if left >= 0 && ir_has_drop(m, b, left) -> ir_emit(b.f, IROp.Drop, -1, left, -1, -1, b.line)
    ir_store_at(m, p, b, entry, shape.value.offset, merged)
    ir_else(b.f, b.line)
    ir_map_set(m, p, b, row, target, key, value)
    ir_end(b.f, b.line)
    ir_walk_close(m, b, walk)
    ir_map_ordered_end(m, b, other, ordered)
    ir_release(m, b, other)
    ir_release(m, b, callback)
    target
}

// `map.top_n(n)` (list.rank_entries): the entries ordered by descending
// value, ties by ascending key, the first max(n, 0) copied into a new List
// of `(key, value)` entries. Keys are unique, so the order is total.
// A heap of the keep = min(max(n, 0), len) best entry positions, with the
// lowest ranked at its root, takes each later entry that ranks above that
// root; heapsort then orders it best first: O(len log keep) comparisons and
// O(keep) extra words.
ir_map_top_n: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, shape: IRMapShape, map: Int, count: Int, span: Span) -> Int Never! {
    value_kind: ir_map_key_kind(m, shape.value.ty)
    if value_kind == "" || shape.stride %% 8 != 0 -> return ir_fail_slot(b, span, "Map top_n over {ir_type_name(shape.value_ty)} values is not lowered at O0 yet")
    result_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    result: ir_list_empty(m, b, result_row)
    if ir_list_element(m, p, b, result) != Val(shape.entry) -> return ir_fail_slot(b, span, "Map top_n entries as {ir_type_name(ty)}")
    limit: ir_native_index(m, b, count, span)
    if ir_failed(b) -> return -1
    word_row: ir_word_row(m)
    length: ir_load_word(m, b, map, 0)
    data: ir_load_word(m, b, map, 16)
    eight: ir_word_const(m, b, 8)
    one: ir_word_const(m, b, 1)
    zero: ir_word_const(m, b, 0)
    keep: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, keep, limit, -1, -1, b.line)
    negative: ir_bool_op(m, b, IROp.Lt, keep, zero)
    ir_open_if(b.f, negative, b.line)
    ir_emit(b.f, IROp.Copy, keep, zero, -1, -1, b.line)
    ir_end(b.f, b.line)
    over: ir_bool_op(m, b, IROp.Gt, keep, length)
    ir_open_if(b.f, over, b.line)
    ir_emit(b.f, IROp.Copy, keep, length, -1, -1, b.line)
    ir_end(b.f, b.line)
    heap_words: ir_word_op(m, b, IROp.Mul, keep, eight)
    heap_bytes: ir_word_op(m, b, IROp.Add, heap_words, eight)
    heap: ir_runtime(m, b, "jet_rt_alloc", [Int]{heap_bytes, eight}, word_row)
    // With nothing to keep no entry is read.
    scan_end: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, scan_end, length, -1, -1, b.line)
    none: ir_bool_op(m, b, IROp.Eq, keep, zero)
    ir_open_if(b.f, none, b.line)
    ir_emit(b.f, IROp.Copy, scan_end, zero, -1, -1, b.line)
    ir_end(b.f, b.line)
    size: ir_word_const(m, b, 0)
    at: ir_word_const(m, b, 0)
    scanned: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    more: ir_bool_op(m, b, IROp.Lt, at, scan_end)
    ir_exit_unless(m, b, more, scanned)
    filling: ir_bool_op(m, b, IROp.Lt, size, keep)
    ir_open_if(b.f, filling, b.line)
    // The new position rises past every parent that ranks above it.
    hole: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, hole, size, -1, -1, b.line)
    risen: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    below_root: ir_bool_op(m, b, IROp.Gt, hole, zero)
    ir_exit_unless(m, b, below_root, risen)
    up: ir_word_op(m, b, IROp.Sub, hole, one)
    parent: ir_word_op(m, b, IROp.Shr, up, one)
    parent_at: ir_element_address(m, b, heap, parent, 8)
    parent_entry: ir_load_word(m, b, parent_at, 0)
    rises: ir_map_top_above(m, p, b, shape, value_kind, data, parent_entry, at)
    ir_exit_unless(m, b, rises, risen)
    hole_at: ir_element_address(m, b, heap, hole, 8)
    ir_emit(b.f, IROp.Store, -1, hole_at, 0, parent_entry, b.line)
    ir_emit(b.f, IROp.Copy, hole, parent, -1, -1, b.line)
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
    landing: ir_element_address(m, b, heap, hole, 8)
    ir_emit(b.f, IROp.Store, -1, landing, 0, at, b.line)
    ir_emit(b.f, IROp.Add, size, size, one, IR_OVERFLOW_WRAP, b.line)
    ir_else(b.f, b.line)
    lowest: ir_load_word(m, b, heap, 0)
    replaces: ir_map_top_above(m, p, b, shape, value_kind, data, at, lowest)
    ir_open_if(b.f, replaces, b.line)
    ir_map_top_sink(m, p, b, shape, value_kind, data, heap, keep, at)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
    ir_emit(b.f, IROp.Add, at, at, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
    // Heapsort: the root moves to the end of the shrinking heap, so the
    // array ends best first.
    rest: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, rest, size, -1, -1, b.line)
    ordered: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    several: ir_bool_op(m, b, IROp.Gt, rest, one)
    ir_exit_unless(m, b, several, ordered)
    ir_emit(b.f, IROp.Sub, rest, rest, one, IR_OVERFLOW_WRAP, b.line)
    worst: ir_load_word(m, b, heap, 0)
    last_at: ir_element_address(m, b, heap, rest, 8)
    last: ir_load_word(m, b, last_at, 0)
    ir_map_top_sink(m, p, b, shape, value_kind, data, heap, rest, last)
    ir_emit(b.f, IROp.Store, -1, last_at, 0, worst, b.line)
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
    taken: ir_word_const(m, b, 0)
    copying: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    wanted: ir_bool_op(m, b, IROp.Lt, taken, size)
    ir_exit_unless(m, b, wanted, copying)
    ranked_at: ir_element_address(m, b, heap, taken, 8)
    ranked: ir_load_word(m, b, ranked_at, 0)
    entry: ir_element_address(m, b, data, ranked, shape.stride)
    written: ir_list_reserve(m, b, result, shape.entry)
    room: ir_load_word(m, b, result, 16)
    target: ir_element_address(m, b, room, written, shape.stride)
    key: ir_load_at(m, b, entry, shape.key.offset, shape.key.ty)
    ir_store_at(m, p, b, target, shape.key.offset, key)
    value: ir_load_at(m, b, entry, shape.value.offset, shape.value.ty)
    ir_store_at(m, p, b, target, shape.value.offset, value)
    grown: ir_word_op(m, b, IROp.Add, written, one)
    ir_emit(b.f, IROp.Store, -1, result, 0, grown, b.line)
    ir_emit(b.f, IROp.Add, taken, taken, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
    ir_free(m, b, heap, heap_bytes)
    result
}

// Whether the entry at position `first` ranks above the one at `second` in
// top_n order: a greater value, or an equal value and a smaller key.
ir_map_top_above: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, shape: IRMapShape, value_kind: String, data: Int, first: Int, second: Int) -> Int Never! {
    upper: ir_element_address(m, b, data, first, shape.stride)
    lower: ir_element_address(m, b, data, second, shape.stride)
    upper_value: ir_load_at(m, b, upper, shape.value.offset, shape.value.ty)
    lower_value: ir_load_at(m, b, lower, shape.value.offset, shape.value.ty)
    values: ir_map_order(m, p, b, value_kind, lower_value, upper_value)
    above: ir_temp_like(m, b, values.less)
    ir_emit(b.f, IROp.Copy, above, values.less, -1, -1, b.line)
    ir_open_if(b.f, values.same, b.line)
    upper_key: ir_load_at(m, b, upper, shape.key.offset, shape.key.ty)
    lower_key: ir_load_at(m, b, lower, shape.key.offset, shape.key.ty)
    keys: ir_map_order(m, p, b, shape.kind, upper_key, lower_key)
    ir_emit(b.f, IROp.Copy, above, keys.less, -1, -1, b.line)
    ir_end(b.f, b.line)
    above
}

// Puts entry position `item` at the root of the `count`-position heap at
// `heap` and sinks it below every child that ranks under it, so the root
// again holds the lowest ranked position.
ir_map_top_sink: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, shape: IRMapShape, value_kind: String, data: Int, heap: Int, count: Int, item: Int) Never! {
    word_row: ir_word_row(m)
    one: ir_word_const(m, b, 1)
    hole: ir_word_const(m, b, 0)
    sunk: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    doubled: ir_word_op(m, b, IROp.Add, hole, hole)
    left: ir_word_op(m, b, IROp.Add, doubled, one)
    has_child: ir_bool_op(m, b, IROp.Lt, left, count)
    ir_exit_unless(m, b, has_child, sunk)
    child: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, child, left, -1, -1, b.line)
    left_at: ir_element_address(m, b, heap, left, 8)
    left_entry: ir_load_word(m, b, left_at, 0)
    child_entry: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.Copy, child_entry, left_entry, -1, -1, b.line)
    right: ir_word_op(m, b, IROp.Add, left, one)
    has_right: ir_bool_op(m, b, IROp.Lt, right, count)
    ir_open_if(b.f, has_right, b.line)
    right_at: ir_element_address(m, b, heap, right, 8)
    right_entry: ir_load_word(m, b, right_at, 0)
    right_lower: ir_map_top_above(m, p, b, shape, value_kind, data, left_entry, right_entry)
    ir_open_if(b.f, right_lower, b.line)
    ir_emit(b.f, IROp.Copy, child, right, -1, -1, b.line)
    ir_emit(b.f, IROp.Copy, child_entry, right_entry, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
    sinks: ir_map_top_above(m, p, b, shape, value_kind, data, item, child_entry)
    ir_exit_unless(m, b, sinks, sunk)
    hole_at: ir_element_address(m, b, heap, hole, 8)
    ir_emit(b.f, IROp.Store, -1, hole_at, 0, child_entry, b.line)
    ir_emit(b.f, IROp.Copy, hole, child, -1, -1, b.line)
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
    landing: ir_element_address(m, b, heap, hole, 8)
    ir_emit(b.f, IROp.Store, -1, landing, 0, item, b.line)
}

// `Map.from_keys(keys, default)`: every key, in List order, set to a copy of
// the default (a later duplicate key replacing the earlier entry). The caller
// keeps `keys` and `fallback`.
ir_map_from_keys: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, keys: Int, fallback: Int, result: Type, span: Span) -> Int Never! {
    row: ir_value_type(m, p, result) ?? return ir_type_fail(b, span, result)
    shape: ir_map_shape(m, p, row) ?? return ir_fail_slot(b, span, "Map.from_keys into {ir_type_name(result)} is not lowered at O0 yet")
    if m.types[shape.value.ty].kind == .Unit -> return ir_fail_slot(b, span, "Map.from_keys with a {ir_type_name(shape.value_ty)} default is not lowered at O0 yet")
    keys_ty: m.types[b.f.slot_type[keys]].ty
    key_element: ir_list_element(m, p, b, keys)
    if key_element != Val(shape.key.ty) -> return ir_fail_slot(b, span, "Map.from_keys over {ir_type_name(keys_ty)}")
    value: ir_adapt(m, p, b, fallback, shape.value.ty, span)
    if ir_failed(b) -> return -1
    // Every entry takes a copy: the default itself stays the caller's.
    was_fresh: b.fresh[value]
    b.fresh[value] = false
    map: ir_list_empty(m, b, row)
    walk: ir_walk_open(m, b, keys, shape.key.ty)
    ir_map_set(m, p, b, row, map, walk.item, value)
    ir_walk_close(m, b, walk)
    b.fresh[value] = was_fresh
    if value != fallback -> ir_release(m, b, value)
    map
}
