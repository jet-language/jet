// The IR builder's PriorityQueue<T>: the List header (len at 0, cap at 8,
// element data at 16) and an order word at 24. Order word 0 is the element's
// native order: a binary min-heap whose swaps move bytes, never clone. push,
// heapify and pop are helper functions built once per PriorityQueue type
// (priority_queue.push, priority_queue.heapify, priority_queue.pop), as are
// the List sorts (list.sort, list.sort_desc). Canonical order is
// lowest-first: to_sorted_list, remove and rendering see the ascending sort,
// the order `PriorityQueue.by(key)` pops in.
//
// `PriorityQueue.by(key)` and its `by_desc` / `from_by` forms keep a key
// order instead: the order word holds a `before(left, right)` function value
// (ir_key_order) and the elements lie in pop order, index 0 popping next and
// equal keys in insertion order. push inserts after every element that does
// not order after it, pop takes index 0, and canonical order is storage
// order. The same helpers branch on the order word, so a queue's operations
// never depend on which constructor made it.

use jet_foundation.[Span, TBuiltinOp, Type, name_rows_set, name_rows_value, type_carrier_identity]

// The element of a `PriorityQueue<T>`.
ir_priority_queue_element: fn(ty: Type) -> Type? Never! {
    if ir_untag(ty) == .Apply(name, args) {
        if name == "PriorityQueue" && args.len() == 1 -> return Val(args[0].copy())
    }
    None
}

// Whether the counted header row `row` carries an order word at 24: a
// PriorityQueue's or a Rank's.
ir_ordered_header: fn(m: IRModule, row: Int) -> Bool Never! {
    ty: m.types[row].ty
    ir_priority_queue_element(ty) != None || ir_rank_type(ty)
}

// The element row of the PriorityQueue type row `heap_row`.
ir_priority_queue_row: fn(m: &IRModule, p: IRProgram, heap_row: Int) -> Int? Never! {
    elem: ir_priority_queue_element(m.types[heap_row].ty) ?? return None
    ir_value_type(m, p, elem)
}

// The element order of a queue or sort helper: "" when the element has no
// native order, so only a key order applies.
ir_heap_kind: fn(m: IRModule, elem_row: Int) -> String Never! {
    if m.types[elem_row].kind == .Float -> return "float"
    ir_map_key_kind(m, elem_row)
}

// The id of PriorityQueue or List sort helper `name` over the header type
// row `row` with element row `elem_row`, built on first use. Its deferred
// calls (a user Comparable implementation) resolve before it is stored.
ir_heap_helper: fn(m: &IRModule, p: IRProgram, row: Int, elem_row: Int, name: String) -> Int Never! {
    key: "{name}<{type_carrier_identity(m.types[row].ty)}>"
    if name_rows_value(m.function_rows, key) == .Val(known) -> return known
    kind: ir_heap_kind(m, elem_row)
    id: m.functions.len()
    symbol: name.split(".").to_list().join("_")
    m.functions.push(ir_hashed_function(name, key, "jet_ir_{symbol}_", "", 0))
    name_rows_set(m.function_rows, key, id)
    a := ir_builder_new(m.functions[id].copy())
    heap: ir_new_slot(a, row, IRSlotKind.Param, ir_intern_name(m, "heap"))
    if name == "priority_queue.push" {
        value: ir_new_slot(a, elem_row, IRSlotKind.Param, ir_intern_name(m, "value"))
        ir_priority_queue_push_body(m, p, a, kind, heap, elem_row, value)
    } else if name == "priority_queue.heapify" {
        ir_priority_queue_heapify_body(m, p, a, kind, heap, elem_row)
    } else if name == "priority_queue.pop" {
        elem_ty: m.types[elem_row].ty
        option_row: ir_value_type(m, p, Type.Option{inner: elem_ty}) ?? panic("PriorityQueue pop without an Option row")
        ir_priority_queue_pop_body(m, p, a, kind, heap, elem_row, option_row)
    } else if name == "priority_queue.key_sort" {
        ir_list_sort_body(m, p, a, kind, heap, elem_row, false, true)
    } else {
        ir_list_sort_body(m, p, a, kind, heap, elem_row, name == "list.sort_desc", false)
    }
    ir_resolve_deferred(m, p, a)
    m.functions[id] = a.f.move()
    id
}

// A call of helper `name` with result row `result` (-1: none).
ir_heap_call: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int, elem_row: Int, name: String, args: [Int], result: Int) -> Int Never! {
    callee: ir_heap_helper(m, p, row, elem_row, name)
    dst: if result >= 0 -> ir_fresh_temp(m, b, result) else -> -1
    operands: ir_args(b.f, args)
    ir_emit(b.f, IROp.Call, dst, callee, operands, args.len(), b.line)
    ir_stop_check(m, b)
    dst
}

// Swaps the elements at `left` and `right` through the frame slot `scratch`.
ir_heap_swap: fn(m: &IRModule, a: &IRBuilder, left: Int, right: Int, width: Int, scratch: Int) Never! {
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{scratch, left, width}, -1)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{left, right, width}, -1)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{right, scratch, width}, -1)
}

// Sifts the element at `start` up while it orders below its parent; every
// comparison reads live element storage.
ir_heap_sift_up: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, kind: String, data: Int, start: Int, elem_row: Int) Never! {
    stride: ir_list_stride(m, elem_row)
    width: ir_word_const(m, a, stride)
    scratch: ir_out_slot(m, a, (stride + 7) /% 8)
    zero: ir_word_const(m, a, 0)
    one: ir_word_const(m, a, 1)
    word_row: ir_word_row(m)
    at: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, at, start, -1, -1, a.line)
    exit: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    more: ir_bool_op(m, a, IROp.Gt, at, zero)
    ir_exit_unless(m, a, more, exit)
    previous: ir_word_op(m, a, IROp.Sub, at, one)
    parent: ir_word_op(m, a, IROp.Shr, previous, one)
    parent_at: ir_element_address(m, a, data, parent, stride)
    child_at: ir_element_address(m, a, data, at, stride)
    left: ir_load_at(m, a, parent_at, 0, elem_row)
    right: ir_load_at(m, a, child_at, 0, elem_row)
    order: ir_map_order(m, p, a, kind, right, left)
    ir_exit_unless(m, a, order.less, exit)
    ir_heap_swap(m, a, child_at, parent_at, width, scratch)
    ir_emit(a.f, IROp.Copy, at, parent, -1, -1, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
}

// Sifts the element at `start` down within the first `length` elements while
// a child orders below it, swapping with the lesser child (the left one on a
// tie).
ir_heap_sift_down: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, kind: String, data: Int, start: Int, length: Int, elem_row: Int) Never! {
    stride: ir_list_stride(m, elem_row)
    width: ir_word_const(m, a, stride)
    scratch: ir_out_slot(m, a, (stride + 7) /% 8)
    one: ir_word_const(m, a, 1)
    two: ir_word_const(m, a, 2)
    word_row: ir_word_row(m)
    at: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, at, start, -1, -1, a.line)
    best: ir_temp(m, a, word_row)
    exit: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    doubled: ir_word_op(m, a, IROp.Mul, at, two)
    child: ir_word_op(m, a, IROp.Add, doubled, one)
    more: ir_bool_op(m, a, IROp.Lt, child, length)
    ir_exit_unless(m, a, more, exit)
    ir_emit(a.f, IROp.Copy, best, child, -1, -1, a.line)
    sibling: ir_word_op(m, a, IROp.Add, child, one)
    has_right: ir_bool_op(m, a, IROp.Lt, sibling, length)
    ir_open_if(a.f, has_right, a.line)
    left_at: ir_element_address(m, a, data, child, stride)
    right_at: ir_element_address(m, a, data, sibling, stride)
    left: ir_load_at(m, a, left_at, 0, elem_row)
    right: ir_load_at(m, a, right_at, 0, elem_row)
    order: ir_map_order(m, p, a, kind, right, left)
    ir_open_if(a.f, order.less, a.line)
    ir_emit(a.f, IROp.Copy, best, sibling, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    parent_at: ir_element_address(m, a, data, at, stride)
    child_at: ir_element_address(m, a, data, best, stride)
    parent_value: ir_load_at(m, a, parent_at, 0, elem_row)
    child_value: ir_load_at(m, a, child_at, 0, elem_row)
    parent_order: ir_map_order(m, p, a, kind, child_value, parent_value)
    ir_exit_unless(m, a, parent_order.less, exit)
    ir_heap_swap(m, a, parent_at, child_at, width, scratch)
    ir_emit(a.f, IROp.Copy, at, best, -1, -1, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
}

// The order word of the queue header `heap` and whether it is a key order;
// an element without a native order has only key orders.
ir_heap_order: fn(m: &IRModule, a: &IRBuilder, heap: Int) -> (order: Int, keyed: Int) Never! {
    pointer_row: ir_pointer_row(m)
    order: ir_load_at(m, a, heap, 24, pointer_row)
    none: ir_word_const(m, a, 0)
    (order: order, keyed: ir_bool_op(m, a, IROp.Ne, order, none))
}

// priority_queue.push(heap, value): under a key order, the value moves in
// after every element its key does not order before (equal keys keep
// insertion order); under the native order it is taken over at the end and
// sifts up.
ir_priority_queue_push_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, kind: String, heap: Int, elem_row: Int, value: Int) Never! {
    length: ir_list_reserve(m, a, heap, elem_row)
    data: ir_load_word(m, a, heap, 16)
    stride: ir_list_stride(m, elem_row)
    one: ir_word_const(m, a, 1)
    count: ir_word_op(m, a, IROp.Add, length, one)
    heap_order: ir_heap_order(m, a, heap)
    if kind != "" -> ir_open_if(a.f, heap_order.keyed, a.line)
    word_row: ir_word_row(m)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    at: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Const, at, 0, -1, -1, a.line)
    found: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    more: ir_bool_op(m, a, IROp.Lt, at, length)
    ir_exit_unless(m, a, more, found)
    item_at: ir_element_address(m, a, data, at, stride)
    item: ir_load_at(m, a, item_at, 0, elem_row)
    earlier: ir_call_closure(m, a, heap_order.order, [Int]{value, item}, bool_row)
    later: ir_temp(m, a, bool_row)
    ir_emit(a.f, IROp.Not, later, earlier, -1, -1, a.line)
    ir_exit_unless(m, a, later, found)
    ir_emit(a.f, IROp.Add, at, at, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    slot_at: ir_element_address(m, a, data, at, stride)
    after: ir_word_op(m, a, IROp.Add, at, one)
    moved_to: ir_element_address(m, a, data, after, stride)
    tail: ir_word_op(m, a, IROp.Sub, length, at)
    width: ir_word_const(m, a, stride)
    tail_bytes: ir_word_op(m, a, IROp.Mul, tail, width)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{moved_to, slot_at, tail_bytes}, -1)
    a.fresh[value] = true
    ir_store_at(m, p, a, slot_at, 0, value)
    ir_emit(a.f, IROp.Store, -1, heap, 0, count, a.line)
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
    if kind == "" -> return
    ir_end(a.f, a.line)
    address: ir_element_address(m, a, data, length, stride)
    a.fresh[value] = true
    ir_store_at(m, p, a, address, 0, value)
    ir_emit(a.f, IROp.Store, -1, heap, 0, count, a.line)
    ir_heap_sift_up(m, p, a, kind, data, length, elem_row)
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// priority_queue.heapify(heap): sifts every parent down, the last first.
ir_priority_queue_heapify_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, kind: String, heap: Int, elem_row: Int) Never! {
    length: ir_load_word(m, a, heap, 0)
    data: ir_load_word(m, a, heap, 16)
    one: ir_word_const(m, a, 1)
    parents: ir_word_op(m, a, IROp.Shr, length, one)
    counted: ir_word_const(m, a, 0)
    exit: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    more: ir_bool_op(m, a, IROp.Lt, counted, parents)
    ir_exit_unless(m, a, more, exit)
    last_parent: ir_word_op(m, a, IROp.Sub, parents, one)
    at: ir_word_op(m, a, IROp.Sub, last_parent, counted)
    ir_heap_sift_down(m, p, a, kind, data, at, length, elem_row)
    ir_emit(a.f, IROp.Add, counted, counted, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// priority_queue.pop(heap): the first element moves into an Option box (null
// when empty). Under a key order the rest move down one place; under the
// native order the last element moves to the root and sifts down.
ir_priority_queue_pop_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, kind: String, heap: Int, elem_row: Int, option_row: Int) Never! {
    a.f.result = option_row
    length: ir_load_word(m, a, heap, 0)
    zero: ir_word_const(m, a, 0)
    empty: ir_bool_op(m, a, IROp.Eq, length, zero)
    ir_open_if(a.f, empty, a.line)
    null: ir_temp(m, a, option_row)
    ir_option_none(m, a, null)
    ir_emit(a.f, IROp.Return, -1, null, -1, -1, a.line)
    ir_end(a.f, a.line)
    data: ir_load_word(m, a, heap, 16)
    result: ir_element_option(m, p, a, data, elem_row, option_row, true)
    one: ir_word_const(m, a, 1)
    last: ir_word_op(m, a, IROp.Sub, length, one)
    ir_emit(a.f, IROp.Store, -1, heap, 0, last, a.line)
    stride: ir_list_stride(m, elem_row)
    width: ir_word_const(m, a, stride)
    heap_order: ir_heap_order(m, a, heap)
    if kind != "" -> ir_open_if(a.f, heap_order.keyed, a.line)
    second: ir_element_address(m, a, data, one, stride)
    rest: ir_word_op(m, a, IROp.Mul, last, width)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{data, second, rest}, -1)
    ir_emit(a.f, IROp.Return, -1, result, -1, -1, a.line)
    if kind == "" -> return
    ir_end(a.f, a.line)
    // With one element, the copied stale slot lies outside the live prefix.
    tail: ir_element_address(m, a, data, last, stride)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{data, tail, width}, -1)
    ir_heap_sift_down(m, p, a, kind, data, zero, last, elem_row)
    ir_emit(a.f, IROp.Return, -1, result, -1, -1, a.line)
}

// list.sort / list.sort_desc: a bottom-up merge sort. Runs of `width`
// elements merge pairwise from one buffer into the other (the list's data and
// a scratch buffer of the same length, swapping roles each pass); a merge
// takes the right run's element only when it orders strictly before the left
// run's (strictly after it for sort_desc), so equal elements keep their input
// order. Elements move as bytes; nothing is cloned or dropped. A Float list
// (kind "float") orders by ir_float_total_key, f64::total_cmp's order.
// priority_queue.key_sort (`keyed`) sorts a queue header into pop order: the
// right run's element goes first only when its `before` (the order word)
// says so.
ir_list_sort_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, kind: String, list: Int, elem_row: Int, descending: Bool, keyed: Bool) Never! {
    order_box: if keyed -> ir_heap_order(m, a, list).order else -> -1
    stride: ir_list_stride(m, elem_row)
    stride_word: ir_word_const(m, a, stride)
    length: ir_load_word(m, a, list, 0)
    data: ir_load_word(m, a, list, 16)
    one: ir_word_const(m, a, 1)
    several: ir_bool_op(m, a, IROp.Gt, length, one)
    ir_open_if(a.f, several, a.line)
    word_row: ir_word_row(m)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    bytes: ir_word_op(m, a, IROp.Mul, length, stride_word)
    align: ir_word_const(m, a, 8)
    scratch: ir_runtime(m, a, "jet_rt_alloc", [Int]{bytes, align}, word_row)
    width: ir_word_const(m, a, 1)
    source: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, source, data, -1, -1, a.line)
    target: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, target, scratch, -1, -1, a.line)
    passes: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    unsorted: ir_bool_op(m, a, IROp.Lt, width, length)
    ir_exit_unless(m, a, unsorted, passes)
    lo: ir_word_const(m, a, 0)
    runs: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    remaining: ir_bool_op(m, a, IROp.Lt, lo, length)
    ir_exit_unless(m, a, remaining, runs)
    mid: ir_word_op(m, a, IROp.Add, lo, width)
    mid_over: ir_bool_op(m, a, IROp.Gt, mid, length)
    ir_open_if(a.f, mid_over, a.line)
    ir_emit(a.f, IROp.Copy, mid, length, -1, -1, a.line)
    ir_end(a.f, a.line)
    hi: ir_word_op(m, a, IROp.Add, mid, width)
    hi_over: ir_bool_op(m, a, IROp.Gt, hi, length)
    ir_open_if(a.f, hi_over, a.line)
    ir_emit(a.f, IROp.Copy, hi, length, -1, -1, a.line)
    ir_end(a.f, a.line)
    left_index: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, left_index, lo, -1, -1, a.line)
    right_index: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, right_index, mid, -1, -1, a.line)
    k: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, k, lo, -1, -1, a.line)
    merging: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    filling: ir_bool_op(m, a, IROp.Lt, k, hi)
    ir_exit_unless(m, a, filling, merging)
    take_right: ir_temp(m, a, bool_row)
    ir_emit(a.f, IROp.Const, take_right, 0, -1, -1, a.line)
    left_open: ir_bool_op(m, a, IROp.Lt, left_index, mid)
    ir_open_if(a.f, left_open, a.line)
    right_open: ir_bool_op(m, a, IROp.Lt, right_index, hi)
    ir_open_if(a.f, right_open, a.line)
    left_at: ir_element_address(m, a, source, left_index, stride)
    right_at: ir_element_address(m, a, source, right_index, stride)
    if keyed {
        left_item: ir_load_at(m, a, left_at, 0, elem_row)
        right_item: ir_load_at(m, a, right_at, 0, elem_row)
        earlier: ir_call_closure(m, a, order_box, [Int]{right_item, left_item}, bool_row)
        ir_emit(a.f, IROp.Copy, take_right, earlier, -1, -1, a.line)
    } else {
        float: kind == "float"
        left: if float -> ir_float_total_key(m, a, left_at) else -> ir_load_at(m, a, left_at, 0, elem_row)
        right: if float -> ir_float_total_key(m, a, right_at) else -> ir_load_at(m, a, right_at, 0, elem_row)
        order_kind: if float -> "word" else -> kind
        order: if descending -> ir_map_order(m, p, a, order_kind, left, right) else -> ir_map_order(m, p, a, order_kind, right, left)
        ir_emit(a.f, IROp.Copy, take_right, order.less, -1, -1, a.line)
    }
    ir_end(a.f, a.line)
    ir_else(a.f, a.line)
    ir_emit(a.f, IROp.Const, take_right, 1, -1, -1, a.line)
    ir_end(a.f, a.line)
    slot_at: ir_element_address(m, a, target, k, stride)
    ir_open_if(a.f, take_right, a.line)
    right_from: ir_element_address(m, a, source, right_index, stride)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{slot_at, right_from, stride_word}, -1)
    ir_emit(a.f, IROp.Add, right_index, right_index, one, IR_OVERFLOW_WRAP, a.line)
    ir_else(a.f, a.line)
    left_from: ir_element_address(m, a, source, left_index, stride)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{slot_at, left_from, stride_word}, -1)
    ir_emit(a.f, IROp.Add, left_index, left_index, one, IR_OVERFLOW_WRAP, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Add, k, k, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Copy, lo, hi, -1, -1, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Add, width, width, width, IR_OVERFLOW_WRAP, a.line)
    swapped: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, swapped, source, -1, -1, a.line)
    ir_emit(a.f, IROp.Copy, source, target, -1, -1, a.line)
    ir_emit(a.f, IROp.Copy, target, swapped, -1, -1, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    // The sorted elements are in `source`; they move home when that is the
    // scratch buffer, which is then released.
    away: ir_bool_op(m, a, IROp.Ne, source, data)
    ir_open_if(a.f, away, a.line)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{data, source, bytes}, -1)
    ir_end(a.f, a.line)
    _: ir_runtime(m, a, "jet_rt_free", [Int]{scratch, bytes, align}, -1)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// The signed word whose order is f64::total_cmp's for the Float at
// `address` (ir_float_total_bits).
ir_float_total_key: fn(m: &IRModule, a: &IRBuilder, address: Int) -> Int Never! {
    word_row: ir_word_row(m)
    bits: ir_load_at(m, a, address, 0, word_row)
    ir_float_total_bits(m, a, bits)
}

// The Float or Float32 in slot `value` as its total-order word: IEEE 754
// totalOrder, -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < NaN. A Float32
// widens to Float first, which keeps its order.
ir_float_total_value: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, value: Int, span: Span) -> Int Never! {
    floating := value
    if m.types[b.f.slot_type[value]].kind == .Float32 {
        float_row: ir_value_type(m, p, Type.Float) ?? return ir_type_fail(b, span, Type.Float)
        floating = ir_temp(m, b, float_row)
        ir_emit(b.f, IROp.Convert, floating, value, -1, -1, b.line)
    }
    word_row: ir_word_row(m)
    bits: ir_reinterpret(m, b, floating, word_row)
    ir_float_total_bits(m, b, bits)
}

// The Float bits `bits` (a signed word) as the word whose order is
// f64::total_cmp's: every bit but the sign flips when the sign is set
// (negative values and -NaN reverse their magnitude order).
ir_float_total_bits: fn(m: &IRModule, a: &IRBuilder, bits: Int) -> Int Never! {
    word_row: ir_word_row(m)
    key: ir_temp(m, a, word_row)
    ir_emit(a.f, IROp.Copy, key, bits, -1, -1, a.line)
    zero: ir_word_const(m, a, 0)
    negative: ir_bool_op(m, a, IROp.Lt, bits, zero)
    ir_open_if(a.f, negative, a.line)
    magnitude: ir_word_const(m, a, 9223372036854775807)
    ir_emit(a.f, IROp.BitXor, key, bits, magnitude, IR_OVERFLOW_WRAP, a.line)
    ir_end(a.f, a.line)
    key
}

// `xs.sort()` / `xs.sort_desc()` on the List at `list` in place, or on a
// write window over a list's range (a View header over the owner's storage):
// the element needs a native order.
ir_list_sort: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, list: Int, elem_row: Int, descending: Bool, span: Span) -> Int Never! {
    list_row: b.f.slot_type[list]
    list_ty: m.types[list_row].ty
    is_list: if ir_untag(list_ty) == {
        .List(_) -> true
        .Apply(name, args) -> (name == "View" || name == "ViewMut") && args.len() == 1
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
    if !is_list -> return ir_fail_slot(b, span, "sort of {ir_type_name(list_ty)}")
    float: m.types[elem_row].kind == .Float
    if !float && ir_map_key_kind(m, elem_row) == "" -> return ir_fail_slot(b, span, "List sort of {ir_type_name(m.types[elem_row].ty)} is not lowered at O0 yet")
    helper: if descending -> "list.sort_desc" else -> "list.sort"
    _: ir_heap_call(m, p, b, list_row, elem_row, helper, [Int]{list}, -1)
    return -1
}

// The copy of the queue in canonical order (to_sorted_list, rendering):
// lowest-first under the native order, storage order under a key order.
ir_priority_queue_sorted: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, heap: Int, elem_row: Int, span: Span) -> Int Never! {
    elem_ty: m.types[elem_row].ty
    list_row: ir_value_type(m, p, Type.List{element: elem_ty}) ?? return ir_fail_slot(b, span, "type [{ir_type_name(elem_ty)}]")
    sorted: ir_list_clone(m, p, b, heap, elem_row, list_row)
    if ir_heap_native_open(m, b, heap, elem_row) {
        _: ir_heap_call(m, p, b, list_row, elem_row, "list.sort", [Int]{sorted}, -1)
        ir_end(b.f, b.line)
    }
    sorted
}

// Opens an If over the native order of the queue header `heap`; false (and
// nothing opened) when its element has no native order.
ir_heap_native_open: fn(m: &IRModule, b: &IRBuilder, heap: Int, elem_row: Int) -> Bool Never! {
    if ir_heap_kind(m, elem_row) == "" -> return false
    heap_order: ir_heap_order(m, b, heap)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    native: ir_temp(m, b, bool_row)
    ir_emit(b.f, IROp.Not, native, heap_order.keyed, -1, -1, b.line)
    ir_open_if(b.f, native, b.line)
    true
}

// `PriorityQueue.by(key)` / `by_desc(key)` and `Rank`'s (`from`: the
// `from_by(xs, key)` forms, `subject` the source List and `operands[1]` the
// key): an empty header, or the source's elements, under the key order of
// `key` (ir_key_order). A queue's source sorts into pop order stably, so
// equal keys keep their input order; a Rank's source elements are inserted
// in order, later duplicates dropped.
ir_key_ordered: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, descending: Bool, from: Bool, subject: Int, operands: [Int], span: Span) -> Int Never! {
    header_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    if from && (operands.len() != 2 || operands[1] < 0) -> return ir_fail_slot(b, span, "from_by without a key")
    key: if from -> operands[1] else -> subject
    if ir_rank_type(ty) {
        shape: ir_set_shape(m, p, header_row) ?? return ir_fail_slot(b, span, "key-ordered construction of {ir_type_name(ty)}")
        rank_order: ir_key_order(m, p, b, key, shape.key.ty, descending, span)
        if ir_failed(b) -> return -1
        if from -> return ir_set_from(m, p, b, ty, subject, rank_order, span)
        rank: ir_list_empty(m, b, header_row)
        ir_emit(b.f, IROp.Store, -1, rank, 24, rank_order, b.line)
        return rank
    }
    elem_row: ir_priority_queue_row(m, p, header_row) ?? return ir_fail_slot(b, span, "key-ordered construction of {ir_type_name(ty)}")
    order: ir_key_order(m, p, b, key, elem_row, descending, span)
    if ir_failed(b) -> return -1
    header := -1
    if !from {
        header = ir_list_empty(m, b, header_row)
    } else if ir_list_element(m, p, b, subject) != Val(elem_row) {
        return ir_fail_slot(b, span, "from_by source is not its element List")
    } else if b.fresh[subject] {
        header = ir_list_empty(m, b, header_row)
        ir_emit(b.f, IROp.CopyBytes, -1, header, subject, 24, b.line)
        b.fresh[subject] = false
    } else {
        header = ir_list_clone(m, p, b, subject, elem_row, header_row)
    }
    ir_emit(b.f, IROp.Store, -1, header, 24, order, b.line)
    if from {
        _: ir_heap_call(m, p, b, header_row, elem_row, "priority_queue.key_sort", [Int]{header}, -1)
    }
    header
}

// The `before(left, right)` function value of the key function in `key`:
// a box owning the key at 24 whose code (key_order.before) calls it on both
// elements and compares the keys natively, reversed for `descending`. The
// box is fresh; the header that stores it owns it.
ir_key_order: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, key: Int, elem_row: Int, descending: Bool, span: Span) -> Int Never! {
    closure_ty: m.types[b.f.slot_type[key]].ty.copy()
    ret: ir_closure_result(closure_ty) ?? return ir_fail_slot(b, span, "key function {ir_type_name(closure_ty)} without a result")
    key_ty: ir_never_carrier_success(ret) ?? ret
    key_row: ir_value_type(m, p, key_ty) ?? return ir_type_fail(b, span, key_ty)
    if ir_heap_kind(m, key_row) == "" -> return ir_fail_slot(b, span, "key {ir_type_name(key_ty)} has no native order")
    helper: ir_key_order_helper(m, p, closure_ty, elem_row, key_row, descending)
    elem_ty: m.types[elem_row].ty
    before_ty: Type.Fn{params: [Type]{elem_ty.copy(), elem_ty.copy()}, ret: Val(Type.Bool), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    row: ir_closure_row(m, before_ty)
    held: ir_own(m, p, b, key)
    captures: [IRCaptureSlot]{IRCaptureSlot{name: "key", offset: 24, row: b.f.slot_type[held], by_ref: false}}
    boxed: ir_closure_box(m, b, row, 32, captures)
    ir_store_at(m, p, b, boxed, 24, held)
    b.fresh[held] = false
    pointer_row: ir_pointer_row(m)
    code: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.FunctionAddress, code, helper, -1, -1, b.line)
    ir_emit(b.f, IROp.Store, -1, boxed, 8, code, b.line)
    b.fresh[boxed] = false
    boxed
}

// key_order.before(boxed, left, right): whether `left`'s key orders before
// `right`'s (after it when `descending`), the key function at 24 of the box.
// One per key function type and direction.
ir_key_order_helper: fn(m: &IRModule, p: IRProgram, closure_ty: Type, elem_row: Int, key_row: Int, descending: Bool) -> Int Never! {
    key: "key_order.before<{type_carrier_identity(closure_ty)}|{if descending -> "desc" else -> "asc"}>"
    if name_rows_value(m.function_rows, key) == .Val(known) -> return known
    id: m.functions.len()
    m.functions.push(ir_hashed_function("key_order.before", key, "jet_ir_key_order_before_", "", 0))
    name_rows_set(m.function_rows, key, id)
    a := ir_builder_new(m.functions[id].copy())
    pointer_row: ir_pointer_row(m)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    boxed: ir_new_slot(a, pointer_row, IRSlotKind.Param, ir_intern_name(m, "boxed"))
    left: ir_new_slot(a, elem_row, IRSlotKind.Param, ir_intern_name(m, "left"))
    right: ir_new_slot(a, elem_row, IRSlotKind.Param, ir_intern_name(m, "right"))
    a.f.result = bool_row
    span: Span{start: 0, end: 0}
    function_row: ir_closure_row(m, closure_ty)
    function: ir_load_at(m, a, boxed, 24, function_row)
    left_key: ir_call_callback(m, p, a, function, closure_ty, [Int]{left}, key_row, span)
    right_key: ir_call_callback(m, p, a, function, closure_ty, [Int]{right}, key_row, span)
    float: m.types[key_row].kind == .Float
    kind: if float -> "word" else -> ir_map_key_kind(m, key_row)
    left_word: if float -> ir_key_order_float(m, p, a, left_key) else -> left_key
    right_word: if float -> ir_key_order_float(m, p, a, right_key) else -> right_key
    order: if descending -> ir_map_order(m, p, a, kind, right_word, left_word) else -> ir_map_order(m, p, a, kind, left_word, right_word)
    before: ir_temp(m, a, bool_row)
    ir_emit(a.f, IROp.Copy, before, order.less, -1, -1, a.line)
    if m.types[key_row].drop != "" {
        ir_emit(a.f, IROp.Drop, -1, left_key, -1, -1, a.line)
        ir_emit(a.f, IROp.Drop, -1, right_key, -1, -1, a.line)
    }
    a.fresh[left_key] = false
    a.fresh[right_key] = false
    ir_emit(a.f, IROp.Return, -1, before, -1, -1, a.line)
    ir_resolve_deferred(m, p, a)
    m.functions[id] = a.f.move()
    id
}

// The total-order word of the Float key in `value` (ir_float_total_key).
ir_key_order_float: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, value: Int) -> Int Never! {
    spill: ir_out_slot(m, a, 1)
    ir_store_at(m, p, a, spill, 0, value)
    ir_float_total_key(m, a, spill)
}

// `PriorityQueue.from(source)` / `source.to_priority_queue()`: a fresh List
// gives its buffer up, any other's elements are copied; then the heap is
// built in place.
ir_priority_queue_from: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, source: Int, span: Span) -> Int Never! {
    heap_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    elem_row: ir_priority_queue_row(m, p, heap_row) ?? return ir_fail_slot(b, span, "PriorityQueue construction of {ir_type_name(ty)}")
    if ir_map_key_kind(m, elem_row) == "" -> return ir_fail_slot(b, span, "PriorityQueue element {ir_type_name(m.types[elem_row].ty)} has no native Ord")
    if ir_list_element(m, p, b, source) != Val(elem_row) -> return ir_fail_slot(b, span, "PriorityQueue source is not its element List")
    heap := -1
    if b.fresh[source] {
        heap = ir_list_empty(m, b, heap_row)
        ir_emit(b.f, IROp.CopyBytes, -1, heap, source, 24, b.line)
        b.fresh[source] = false
    } else {
        heap = ir_list_clone(m, p, b, source, elem_row, heap_row)
    }
    _: ir_heap_call(m, p, b, heap_row, elem_row, "priority_queue.heapify", [Int]{heap}, -1)
    heap
}

// `PriorityQueue.new()` (the Prelude std::collections::BinaryHeap::new
// route): an empty header.
ir_priority_queue_new: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, inputs: [Int], result: Type, span: Span) -> Int Never! {
    if inputs.len() != 0 -> return ir_fail_slot(b, span, "PriorityQueue.new with {inputs.len()} arguments")
    heap_row: ir_value_type(m, p, result) ?? return ir_type_fail(b, span, result)
    elem_row: ir_priority_queue_row(m, p, heap_row) ?? return ir_fail_slot(b, span, "PriorityQueue construction of {ir_type_name(result)}")
    if ir_map_key_kind(m, elem_row) == "" -> return ir_fail_slot(b, span, "PriorityQueue element {ir_type_name(m.types[elem_row].ty)} has no native Ord")
    ir_list_empty(m, b, heap_row)
}

// A PriorityQueue builtin: from, len, is_empty, push, clear, remove,
// to_sorted_list, peek and pop.
ir_priority_queue_builtin: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, operation: TBuiltinOp, subject: Int, operands: [Int], span: Span) -> Int Never! {
    if operation == .PriorityQueueFrom {
        if operands.len() != 1 -> return ir_fail_slot(b, span, "PriorityQueue.from with {operands.len() - 1} arguments")
        return ir_priority_queue_from(m, p, b, ty, subject, span)
    }
    heap_row: b.f.slot_type[subject]
    elem_row: ir_priority_queue_row(m, p, heap_row) ?? return ir_fail_slot(b, span, "PriorityQueue builtin on {ir_type_name(m.types[heap_row].ty)}")
    if operation == {
        .LenList -> {
            int_row: ir_type_row(m, Type.Int) ?? 0
            return ir_load_at(m, b, subject, 0, int_row)
        }
        .IsEmpty -> {
            length: ir_load_word(m, b, subject, 0)
            zero: ir_word_const(m, b, 0)
            return ir_bool_op(m, b, IROp.Eq, length, zero)
        }
        .Push -> {
            if operands.len() != 2 || operands[1] < 0 -> return ir_fail_slot(b, span, "push without a value")
            value: ir_adapt(m, p, b, operands[1], elem_row, span)
            if ir_failed(b) -> return -1
            offered: ir_own(m, p, b, value)
            _: ir_heap_call(m, p, b, heap_row, elem_row, "priority_queue.push", [Int]{subject, offered}, -1)
            b.fresh[offered] = false
            return -1
        }
        .Clear -> {
            if m.types[elem_row].drop != "" {
                walk: ir_walk_open(m, b, subject, elem_row)
                ir_emit(b.f, IROp.Drop, -1, walk.item, -1, -1, b.line)
                ir_walk_close(m, b, walk)
            }
            zero: ir_word_const(m, b, 0)
            ir_emit(b.f, IROp.Store, -1, subject, 0, zero, b.line)
            return -1
        }
        .PriorityQueueRemove(_, mode) -> {
            arity: if mode == .Dynamic -> 3 else -> 2
            if operands.len() != arity || operands[1] < 0 || operands[arity - 1] < 0 -> return ir_fail_slot(b, span, "remove without an operand")
            selector: if mode == .Dynamic -> operands[2] else -> -1
            // Canonical removal slots are lowest-first, not physical heap
            // slots; an ascending sequence is itself a valid min-heap. A key
            // order's storage is already canonical.
            if ir_heap_native_open(m, b, subject, elem_row) {
                _: ir_heap_call(m, p, b, heap_row, elem_row, "list.sort", [Int]{subject}, -1)
                ir_end(b.f, b.line)
            }
            return ir_list_remove(m, p, b, ty, subject, elem_row, operands[1], mode, selector, span)
        }
        .PriorityQueueToSortedList -> return ir_priority_queue_sorted(m, p, b, subject, elem_row, span)
        .PriorityQueuePeek -> {
            option_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
            found: ir_fresh_temp(m, b, option_row)
            ir_option_none(m, b, found)
            length: ir_load_word(m, b, subject, 0)
            zero: ir_word_const(m, b, 0)
            present: ir_bool_op(m, b, IROp.Gt, length, zero)
            ir_open_if(b.f, present, b.line)
            data: ir_load_word(m, b, subject, 16)
            copied: ir_element_option(m, p, b, data, elem_row, option_row, false)
            ir_option_set(m, b, found, copied)
            ir_end(b.f, b.line)
            return found
        }
        .PriorityQueuePop -> {
            option_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
            return ir_heap_call(m, p, b, heap_row, elem_row, "priority_queue.pop", [Int]{subject}, option_row)
        }
        .AtomicMethod(_) | .LenString | .ListTryNew | .ListTryWithCapacity | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .Pop | .InsertMap | .AddNewMap | .MapSetDefault | .MapUpdate | .MapMerge | .MapMergeWith | .InsertList | .RemoveMap | .RemoveList(_, _) | .CountList | .Counts | .ExtendList | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .Reverse | .SwapList | .ListFill | .Sort | .SortDesc | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Flatten | .Intersperse | .Unzip | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .Take | .Skip | .IterToList | .IterCollect | .ListLazy | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterNext | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .MapPopFirst | .ListReplace | .Indexed | .Indexes | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .SetFrom | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetPop | .SetReplace | .SetSort | .SetShuffle | .SortedSetFrom | .SortedSetInsert | .SortedSetRemove | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .KeyOrdered(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .LRUCapacity | .LRUKeys | .BitSetAdd | .BitSetRemove | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferWrite(_) | .ByteBufferToBytes | .ByteBufferMethod(_) | .ByteBufferWithCapacity | .BagAdd | .BagRemove | .BagHas | .BagCount | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeDelete | .DequeToList | .DequeJoin | .DequeReverse | .DequeSplit | .DequeFrom | .TryCollect | .ViewNew(_) | .SplitWrite | .GetDisjointWrite | .ListFillRepeat -> return ir_fail_slot(b, span, "PriorityQueue builtin {ir_builtin_name(operation)}")
    }
}
