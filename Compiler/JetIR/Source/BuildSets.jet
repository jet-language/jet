// The IR builder's Set<T> and Rank<T>: the Map<T, Unit> carrier, a 24-byte
// header (len, cap, data) over the keys. A Unit value has no bytes, so an
// entry is the key alone. Keys that hash (BuildMaps ir_map_hashed) keep the
// Map's hash index in the buffer's trailer: a new key is appended and found
// by a probe, and a read in key order merges the appended tail
// (ir_map_ordered). Any other Set keeps its keys in ascending order and
// finds them by binary search. Set's iteration order is unspecified, Rank's
// is the key order; both see the ascending keys. Lookups, insertion,
// removal and equality are helper functions built once per Set type
// (set.find, set.insert, set.take, set.remove, set.equal).
//
// A Rank's header adds an order word at 24: 0 for the element's native
// order, else a key constructor's `before` function value (ir_key_order).
// Under a key order the entries are always all in that order, equal keys in
// insertion order: a new key moves in at its key position (a hashed Rank's
// index is then rebuilt and its sorted count is its length, so nothing ever
// merges), and an unhashed Rank finds a key by a linear scan.
//
// A Set of a small fieldless enum has no header: it is stored as bits
// (ir_bit_set_def, at the end of this file).

use jet_foundation.[Span, Type, jet_layout_one_bit_shift, name_rows_set, name_rows_value, type_carrier_identity]

// The entry layout of the Set type row `set_row`: the key at offset 0 of a
// key-sized entry; None when its keys have no order the builder knows.
ir_set_shape: fn(m: &IRModule, p: IRProgram, set_row: Int) -> IRMapShape? Never! {
    elem: ir_set_element(ir_untag(m.types[set_row].ty)) ?? return None
    if ir_bit_set_def(p, m.types[set_row].ty) != None -> return None
    key_row: ir_value_type(m, p, elem) ?? return None
    kind: ir_map_key_kind(m, key_row)
    if kind == "" -> return None
    member: IRMember{name: "key", offset: 0, ty: key_row}
    Val(IRMapShape{entry: key_row, entry_ty: elem.copy(), key: member.copy(), value: member, value_ty: Type.Named{name: "Unit"}, stride: ir_list_stride(m, key_row), kind: kind})
}

// Whether `ty` is a Rank, whose header carries an order word at 24.
ir_rank_type: fn(ty: Type) -> Bool Never! {
    if ir_untag(ty) == .Apply(name, args) {
        if name == "Rank" && args.len() == 1 -> return true
    }
    false
}

// set.find of an unhashed Rank under a key order (its order word set),
// returning from the helper: the index of the entry equal to `key`, else
// -1 - its key position (ir_set_key_point). A native order falls through to
// the binary search.
ir_set_keyed_find: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, set: Int, key: Int) Never! {
    word_row: ir_word_row(m)
    a.f.result = word_row
    rank_order: ir_heap_order(m, a, set)
    ir_open_if(a.f, rank_order.keyed, a.line)
    length: ir_load_word(m, a, set, 0)
    data: ir_load_word(m, a, set, 16)
    one: ir_word_const(m, a, 1)
    at: ir_word_const(m, a, 0)
    done: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    more: ir_bool_op(m, a, IROp.Lt, at, length)
    ir_exit_unless(m, a, more, done)
    entry: ir_element_address(m, a, data, at, shape.stride)
    item: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
    same: ir_map_order(m, p, a, shape.kind, item, key).same
    ir_open_if(a.f, same, a.line)
    ir_emit(a.f, IROp.Return, -1, at, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Add, at, at, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    point: ir_set_key_point(m, a, shape, set, key, rank_order.order)
    minus_one: ir_word_const(m, a, -1)
    insertion: ir_word_op(m, a, IROp.Sub, minus_one, point)
    ir_emit(a.f, IROp.Return, -1, insertion, -1, -1, a.line)
    ir_end(a.f, a.line)
}

// The key position of `key` in the Rank `set` under the key order `order`:
// after every entry whose key `key`'s does not order before, so equal keys
// keep insertion order.
ir_set_key_point: fn(m: &IRModule, a: &IRBuilder, shape: IRMapShape, set: Int, key: Int, order: Int) -> Int Never! {
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    length: ir_load_word(m, a, set, 0)
    data: ir_load_word(m, a, set, 16)
    one: ir_word_const(m, a, 1)
    at: ir_word_const(m, a, 0)
    found: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    more: ir_bool_op(m, a, IROp.Lt, at, length)
    ir_exit_unless(m, a, more, found)
    entry: ir_element_address(m, a, data, at, shape.stride)
    item: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
    earlier: ir_call_closure(m, a, order, [Int]{key, item}, bool_row)
    later: ir_temp(m, a, bool_row)
    ir_emit(a.f, IROp.Not, later, earlier, -1, -1, a.line)
    ir_exit_unless(m, a, later, found)
    ir_emit(a.f, IROp.Add, at, at, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    at
}

// The new `key` into the hashed Rank `set` under the key order `order`,
// returning true from set.insert: room made as for an append (map.grow
// keeps the entries, all in order, in place), the key moved in at its key
// position, then the index rebuilt over the shifted positions with every
// entry counted sorted.
ir_set_keyed_place: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, set_row: Int, set: Int, key: Int, order: Int) Never! {
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    length: ir_load_word(m, a, set, 0)
    ir_set_hashed_room(m, p, a, set_row, set, length)
    point: ir_set_key_point(m, a, shape, set, key, order)
    room: ir_load_word(m, a, set, 16)
    room_capacity: ir_load_word(m, a, set, 8)
    target: ir_element_address(m, a, room, point, shape.stride)
    one: ir_word_const(m, a, 1)
    after: ir_word_op(m, a, IROp.Add, point, one)
    shifted: ir_element_address(m, a, room, after, shape.stride)
    moved: ir_word_op(m, a, IROp.Sub, length, point)
    width: ir_word_const(m, a, shape.stride)
    bytes: ir_word_op(m, a, IROp.Mul, moved, width)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{shifted, target, bytes}, -1)
    a.fresh[key] = true
    ir_store_at(m, p, a, target, 0, key)
    grown: ir_word_op(m, a, IROp.Add, length, one)
    ir_emit(a.f, IROp.Store, -1, set, 0, grown, a.line)
    ir_map_clear_index(m, a, shape, set)
    trailer: ir_map_trailer(m, a, shape, room, room_capacity)
    indexed: ir_word_const(m, a, 0)
    hashed: ir_open(a.f, IROp.Block, a.line)
    _: ir_open(a.f, IROp.Loop, a.line)
    unhashed: ir_bool_op(m, a, IROp.Lt, indexed, grown)
    ir_exit_unless(m, a, unhashed, hashed)
    entry: ir_element_address(m, a, room, indexed, shape.stride)
    stored: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
    hash: ir_map_tag(m, a, shape, stored)
    ir_map_slot_insert(m, a, trailer, hash, indexed)
    ir_emit(a.f, IROp.Add, indexed, indexed, one, IR_OVERFLOW_WRAP, a.line)
    ir_emit(a.f, IROp.Br, -1, 0, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_end(a.f, a.line)
    ir_emit(a.f, IROp.Store, -1, trailer, 0, grown, a.line)
    added: ir_int_constant(m, a, bool_row, 1)
    ir_emit(a.f, IROp.Return, -1, added, -1, -1, a.line)
}

// Grows the hashed Set `set` of `length` entries when it is full: map.grow
// at twice its length, at least 4.
ir_set_hashed_room: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, set_row: Int, set: Int, length: Int) Never! {
    capacity: ir_load_word(m, a, set, 8)
    full: ir_bool_op(m, a, IROp.Ge, length, capacity)
    ir_open_if(a.f, full, a.line)
    grown: ir_word_op(m, a, IROp.Add, length, length)
    four: ir_word_const(m, a, 4)
    small: ir_bool_op(m, a, IROp.Lt, grown, four)
    ir_open_if(a.f, small, a.line)
    ir_emit(a.f, IROp.Copy, grown, four, -1, -1, a.line)
    ir_end(a.f, a.line)
    _: ir_map_call(m, p, a, set_row, "map.grow", [Int]{set, grown}, -1)
    ir_end(a.f, a.line)
}

// An empty header of the Set type row `set_row`; a Rank's takes `like`'s
// order, whose function value gains it as an owner.
ir_set_empty_like: fn(m: &IRModule, b: &IRBuilder, set_row: Int, like: Int) -> Int Never! {
    target: ir_list_empty(m, b, set_row)
    if !ir_rank_type(m.types[set_row].ty) -> return target
    order: ir_load_word(m, b, like, 24)
    zero: ir_word_const(m, b, 0)
    keyed: ir_bool_op(m, b, IROp.Ne, order, zero)
    ir_open_if(b.f, keyed, b.line)
    _: ir_runtime(m, b, "jet_rt_native_closure_retain", [Int]{order}, -1)
    ir_emit(b.f, IROp.Store, -1, target, 24, order, b.line)
    ir_end(b.f, b.line)
    target
}

// The id of Set helper `name` of the Set type row `set_row`, built on first use.
ir_set_helper: fn(m: &IRModule, p: IRProgram, set_row: Int, name: String) -> Int Never! {
    key: "{name}<{type_carrier_identity(m.types[set_row].ty)}>"
    if name_rows_value(m.function_rows, key) == .Val(known) -> return known
    shape: ir_set_shape(m, p, set_row) ?? panic("Set helper {name} of a type without a Set shape")
    id: m.functions.len()
    symbol: if name == "set.find" -> "find" else if name == "set.insert" -> "insert" else if name == "set.take" -> "take" else if name == "set.remove" -> "remove" else -> "equal"
    m.functions.push(ir_hashed_function(name, key, "jet_ir_set_{symbol}_", "", 0))
    name_rows_set(m.function_rows, key, id)
    a := ir_builder_new(m.functions[id].copy())
    set: ir_new_slot(a, set_row, IRSlotKind.Param, ir_intern_name(m, "set"))
    if name == "set.equal" {
        other: ir_new_slot(a, set_row, IRSlotKind.Param, ir_intern_name(m, "other"))
        ir_set_equal_body(m, p, a, shape, set_row, set, other)
    } else {
        probe_key: ir_new_slot(a, shape.key.ty, IRSlotKind.Param, ir_intern_name(m, "key"))
        if name == "set.find" {
            if ir_map_hashed(shape) {
                ir_map_probe_body(m, p, a, shape, set, probe_key)
            } else {
                if ir_rank_type(m.types[set_row].ty) -> ir_set_keyed_find(m, p, a, shape, set, probe_key)
                ir_map_find_body(m, p, a, shape, set, probe_key)
            }
        } else if name == "set.insert" {
            ir_set_insert_body(m, p, a, shape, set_row, set, probe_key)
        } else {
            option_row: if name == "set.take" -> ir_value_type(m, p, Type.Option{inner: shape.entry_ty}) ?? -1 else -> -1
            ir_set_take_body(m, p, a, shape, set_row, set, probe_key, option_row)
        }
    }
    ir_resolve_deferred(m, p, a)
    m.functions[id] = a.f.move()
    id
}

// A call of Set helper `name` with result row `result` (-1: none).
ir_set_call: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, set_row: Int, name: String, args: [Int], result: Int) -> Int Never! {
    callee: ir_set_helper(m, p, set_row, name)
    dst: if result >= 0 -> ir_fresh_temp(m, b, result) else -> -1
    operands: ir_args(b.f, args)
    ir_emit(b.f, IROp.Call, dst, callee, operands, args.len(), b.line)
    ir_stop_check(m, b)
    dst
}

// Moves the key in and returns true; a key already present keeps its entry,
// drops the offered one and returns false (map.set with a Unit value). A
// hashed Set appends the key, out of order until a rebuild merges it in,
// and a hashed Rank under a key order places it (ir_set_keyed_place); any
// other inserts it at its insertion point.
ir_set_insert_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, set_row: Int, set: Int, key: Int) Never! {
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    a.f.result = bool_row
    word_row: ir_word_row(m)
    index: ir_set_call(m, p, a, set_row, "set.find", [Int]{set, key}, word_row)
    none: ir_word_const(m, a, 0)
    present: ir_bool_op(m, a, IROp.Ge, index, none)
    ir_open_if(a.f, present, a.line)
    if m.types[shape.key.ty].drop != "" -> ir_emit(a.f, IROp.Drop, -1, key, -1, -1, a.line)
    kept: ir_int_constant(m, a, bool_row, 0)
    ir_emit(a.f, IROp.Return, -1, kept, -1, -1, a.line)
    ir_end(a.f, a.line)
    if ir_map_hashed(shape) {
        if ir_rank_type(m.types[set_row].ty) {
            rank_order: ir_heap_order(m, a, set)
            ir_open_if(a.f, rank_order.keyed, a.line)
            ir_set_keyed_place(m, p, a, shape, set_row, set, key, rank_order.order)
            ir_end(a.f, a.line)
        }
        length: ir_load_word(m, a, set, 0)
        ir_set_hashed_room(m, p, a, set_row, set, length)
        hash: ir_map_tag(m, a, shape, key)
        room: ir_load_word(m, a, set, 16)
        room_capacity: ir_load_word(m, a, set, 8)
        target: ir_element_address(m, a, room, length, shape.stride)
        a.fresh[key] = true
        ir_store_at(m, p, a, target, 0, key)
        one: ir_word_const(m, a, 1)
        grown_length: ir_word_op(m, a, IROp.Add, length, one)
        ir_emit(a.f, IROp.Store, -1, set, 0, grown_length, a.line)
        trailer: ir_map_trailer(m, a, shape, room, room_capacity)
        ir_map_slot_insert(m, a, trailer, hash, length)
        appended: ir_int_constant(m, a, bool_row, 1)
        ir_emit(a.f, IROp.Return, -1, appended, -1, -1, a.line)
        return
    }
    minus_one: ir_word_const(m, a, -1)
    point: ir_word_op(m, a, IROp.Sub, minus_one, index)
    length: ir_list_reserve(m, a, set, shape.entry)
    room: ir_load_word(m, a, set, 16)
    target: ir_element_address(m, a, room, point, shape.stride)
    one: ir_word_const(m, a, 1)
    after: ir_word_op(m, a, IROp.Add, point, one)
    shifted: ir_element_address(m, a, room, after, shape.stride)
    moved: ir_word_op(m, a, IROp.Sub, length, point)
    width: ir_word_const(m, a, shape.stride)
    bytes: ir_word_op(m, a, IROp.Mul, moved, width)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{shifted, target, bytes}, -1)
    a.fresh[key] = true
    ir_store_at(m, p, a, target, 0, key)
    grown: ir_word_op(m, a, IROp.Add, length, one)
    ir_emit(a.f, IROp.Store, -1, set, 0, grown, a.line)
    added: ir_int_constant(m, a, bool_row, 1)
    ir_emit(a.f, IROp.Return, -1, added, -1, -1, a.line)
}

// The stored key under a borrowed probe: set.take moves it into an Option box
// (null when absent), set.remove (`option_row` -1) drops it; both close the
// gap, and a hashed Set takes the key out of its index too. map.remove
// cannot express this: it drops the key and returns the Unit value.
ir_set_take_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, set_row: Int, set: Int, key: Int, option_row: Int) Never! {
    discard: option_row < 0
    a.f.result = option_row
    word_row: ir_word_row(m)
    index: ir_set_call(m, p, a, set_row, "set.find", [Int]{set, key}, word_row)
    none: ir_word_const(m, a, 0)
    absent: ir_bool_op(m, a, IROp.Lt, index, none)
    ir_open_if(a.f, absent, a.line)
    if discard {
        ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
    } else {
        null: ir_temp(m, a, option_row)
        ir_option_none(m, a, null)
        ir_emit(a.f, IROp.Return, -1, null, -1, -1, a.line)
    }
    ir_end(a.f, a.line)
    data: ir_load_word(m, a, set, 16)
    entry: ir_element_address(m, a, data, index, shape.stride)
    hash := -1
    if ir_map_hashed(shape) {
        stored: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
        hash = ir_map_tag(m, a, shape, stored)
    }
    boxed := -1
    if discard {
        if m.types[shape.key.ty].drop != "" {
            removed_key: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
            ir_emit(a.f, IROp.Drop, -1, removed_key, -1, -1, a.line)
        }
    } else if ir_option_inline(m, option_row) {
        taken: ir_load_at(m, a, entry, shape.key.offset, shape.key.ty)
        boxed = ir_temp(m, a, option_row)
        ir_emit(a.f, IROp.Move, boxed, taken, -1, -1, a.line)
    } else {
        key_size: m.types[shape.key.ty].size
        boxed = ir_box_alloc(m, a, key_size, option_row)
        ir_emit(a.f, IROp.CopyBytes, -1, boxed, entry, ir_align8(key_size), a.line)
    }
    length: ir_load_word(m, a, set, 0)
    one: ir_word_const(m, a, 1)
    last: ir_word_op(m, a, IROp.Sub, length, one)
    after: ir_word_op(m, a, IROp.Add, index, one)
    from: ir_element_address(m, a, data, after, shape.stride)
    moved: ir_word_op(m, a, IROp.Sub, last, index)
    width: ir_word_const(m, a, shape.stride)
    bytes: ir_word_op(m, a, IROp.Mul, moved, width)
    _: ir_runtime(m, a, "jet_rt_mem_move", [Int]{entry, from, bytes}, -1)
    ir_emit(a.f, IROp.Store, -1, set, 0, last, a.line)
    if hash >= 0 {
        capacity: ir_load_word(m, a, set, 8)
        counted: ir_bool_op(m, a, IROp.Gt, capacity, none)
        ir_open_if(a.f, counted, a.line)
        trailer: ir_map_trailer(m, a, shape, data, capacity)
        ir_map_slot_remove(m, a, trailer, hash, index)
        ir_end(a.f, a.line)
    }
    ir_emit(a.f, IROp.Return, -1, boxed, -1, -1, a.line)
}

// Equal lengths and the same key at every position of the ascending entries;
// for a hashed Set, whose entries are not in key order, or when either Rank
// has a key order (equality ignores the orders), each left key held by the
// right Set.
ir_set_equal_body: fn(m: &IRModule, p: IRProgram, a: &IRBuilder, shape: IRMapShape, set_row: Int, left: Int, right: Int) Never! {
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    a.f.result = bool_row
    left_len: ir_load_word(m, a, left, 0)
    right_len: ir_load_word(m, a, right, 0)
    differ: ir_bool_op(m, a, IROp.Ne, left_len, right_len)
    ir_open_if(a.f, differ, a.line)
    unequal: ir_int_constant(m, a, bool_row, 0)
    ir_emit(a.f, IROp.Return, -1, unequal, -1, -1, a.line)
    ir_end(a.f, a.line)
    if ir_map_hashed(shape) {
        word_row: ir_word_row(m)
        zero: ir_word_const(m, a, 0)
        keys: ir_walk_open(m, a, left, shape.entry)
        found: ir_set_call(m, p, a, set_row, "set.find", [Int]{right, keys.item}, word_row)
        missing: ir_bool_op(m, a, IROp.Lt, found, zero)
        ir_open_if(a.f, missing, a.line)
        lacks: ir_int_constant(m, a, bool_row, 0)
        ir_emit(a.f, IROp.Return, -1, lacks, -1, -1, a.line)
        ir_end(a.f, a.line)
        ir_walk_close(m, a, keys)
        held: ir_int_constant(m, a, bool_row, 1)
        ir_emit(a.f, IROp.Return, -1, held, -1, -1, a.line)
        return
    }
    if ir_rank_type(m.types[set_row].ty) {
        left_order: ir_load_word(m, a, left, 24)
        right_order: ir_load_word(m, a, right, 24)
        orders: ir_word_op(m, a, IROp.BitOr, left_order, right_order)
        zero: ir_word_const(m, a, 0)
        keyed: ir_bool_op(m, a, IROp.Ne, orders, zero)
        ir_open_if(a.f, keyed, a.line)
        word_row: ir_word_row(m)
        member: ir_walk_open(m, a, left, shape.entry)
        found: ir_set_call(m, p, a, set_row, "set.find", [Int]{right, member.item}, word_row)
        absent: ir_bool_op(m, a, IROp.Lt, found, zero)
        ir_open_if(a.f, absent, a.line)
        missing: ir_int_constant(m, a, bool_row, 0)
        ir_emit(a.f, IROp.Return, -1, missing, -1, -1, a.line)
        ir_end(a.f, a.line)
        ir_walk_close(m, a, member)
        held: ir_int_constant(m, a, bool_row, 1)
        ir_emit(a.f, IROp.Return, -1, held, -1, -1, a.line)
        ir_end(a.f, a.line)
    }
    right_data: ir_load_word(m, a, right, 16)
    walk: ir_walk_open(m, a, left, shape.entry)
    other: ir_element_address(m, a, right_data, walk.index, shape.stride)
    probe: ir_load_at(m, a, other, 0, shape.key.ty)
    order: ir_map_order(m, p, a, shape.kind, walk.item, probe)
    ir_open_if(a.f, order.same, a.line)
    ir_else(a.f, a.line)
    mismatch: ir_int_constant(m, a, bool_row, 0)
    ir_emit(a.f, IROp.Return, -1, mismatch, -1, -1, a.line)
    ir_end(a.f, a.line)
    ir_walk_close(m, a, walk)
    same: ir_int_constant(m, a, bool_row, 1)
    ir_emit(a.f, IROp.Return, -1, same, -1, -1, a.line)
}

// A List of copies of the Set's keys in key order.
ir_set_list: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, shape: IRMapShape, set: Int, list_row: Int) -> Int Never! {
    out: ir_list_empty(m, b, list_row)
    ordered: ir_map_ordered(m, p, b, set)
    walk: ir_walk_open(m, b, ordered, shape.entry)
    ir_list_push(m, p, b, out, shape.key.ty, walk.item)
    ir_walk_close(m, b, walk)
    ir_map_ordered_end(m, b, set, ordered)
    out
}

// Inserts into `target` a copy of each key of `from` that `probe` holds
// (`held`) or lacks, in `from`'s order.
ir_set_keep_keys: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, set_row: Int, shape: IRMapShape, from: Int, probe: Int, target: Int, held: Bool, span: Span) Never! {
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    word_row: ir_word_row(m)
    walk: ir_walk_open(m, b, from, shape.key.ty)
    found: ir_set_call(m, p, b, set_row, "set.find", [Int]{probe, walk.item}, word_row)
    none: ir_word_const(m, b, 0)
    keep: ir_bool_op(m, b, if held -> IROp.Ge else -> IROp.Lt, found, none)
    ir_open_if(b.f, keep, b.line)
    key: ir_copy_value(m, p, b, walk.item, span)
    _: ir_set_call(m, p, b, set_row, "set.insert", [Int]{target, key}, bool_row)
    b.fresh[key] = false
    ir_end(b.f, b.line)
    ir_walk_close(m, b, walk)
}

// Inserts into `target` a copy of each key of `from`.
ir_set_add_keys: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, set_row: Int, shape: IRMapShape, from: Int, target: Int, span: Span) Never! {
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    walk: ir_walk_open(m, b, from, shape.key.ty)
    key: ir_copy_value(m, p, b, walk.item, span)
    _: ir_set_call(m, p, b, set_row, "set.insert", [Int]{target, key}, bool_row)
    b.fresh[key] = false
    ir_walk_close(m, b, walk)
}

// `rank.first()` / `rank.last()`: a copy of the least (greatest) key in an
// Option box, None when the Rank is empty.
ir_set_end: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, shape: IRMapShape, set: Int, last: Bool, span: Span) -> Int Never! {
    result_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    result: ir_fresh_temp(m, b, result_row)
    ir_option_none(m, b, result)
    length: ir_load_word(m, b, set, 0)
    zero: ir_word_const(m, b, 0)
    ordered: ir_map_ordered(m, p, b, set)
    present: ir_bool_op(m, b, IROp.Gt, length, zero)
    ir_open_if(b.f, present, b.line)
    data: ir_load_word(m, b, ordered, 16)
    index := zero
    if last {
        one: ir_word_const(m, b, 1)
        word_row: ir_word_row(m)
        index = ir_temp(m, b, word_row)
        ir_emit(b.f, IROp.Sub, index, length, one, IR_OVERFLOW_WRAP, b.line)
    }
    entry: ir_element_address(m, b, data, index, shape.stride)
    key: ir_load_at(m, b, entry, shape.key.offset, shape.key.ty)
    size: m.types[shape.key.ty].size
    made: ir_option_make(m, p, b, result_row, key, size)
    ir_option_set(m, b, result, made)
    ir_end(b.f, b.line)
    ir_map_ordered_end(m, b, set, ordered)
    result
}

// `Set.new()` / `Rank.new()` (the Prelude std::collections::HashSet::new /
// BTreeSet::new route): an empty header.
ir_set_new: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, inputs: [Int], result: Type, span: Span) -> Int Never! {
    if inputs.len() != 0 -> return ir_fail_slot(b, span, "Set.new with {inputs.len()} arguments")
    set_row: ir_value_type(m, p, result) ?? return ir_type_fail(b, span, result)
    if ir_bit_set_def(p, result) != None {
        empty: ir_word_const(m, b, 0)
        return ir_bit_set_make(m, b, set_row, empty)
    }
    if ir_set_shape(m, p, set_row) == None -> return ir_fail_slot(b, span, "Set construction of {ir_type_name(result)}")
    ir_list_empty(m, b, set_row)
}

// `Set.from(source)` / `source.to_set()`: each element inserted in order,
// later duplicates dropped. A fresh List gives its elements up, from a
// buffer of its own, which is then retired (ir_list_retire); any other's
// are copied. An Iter is drained into a List first, as Iter.to_list is.
// `order` (-1: the native order) is a Rank's fresh key order, which the new
// header owns (Rank.from_by).
ir_set_from: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, source: Int, order: Int, span: Span) -> Int Never! {
    set_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    if ir_bit_set_def(p, ty) != None -> return ir_bit_set_from(m, p, b, ty, set_row, source, span)
    shape: ir_set_shape(m, p, set_row) ?? return ir_fail_slot(b, span, "Set construction of {ir_type_name(ty)}")
    elem: shape.entry_ty
    source_ty: ir_lazy_slot_type(m, b, source)
    list := source
    moved := b.fresh[source]
    if ir_iter_element(source_ty) != None {
        list_row: ir_value_type(m, p, Type.List{element: elem}) ?? return ir_fail_slot(b, span, "type [{ir_type_name(elem)}]")
        list = ir_list_empty(m, b, list_row)
        _: ir_lazy_runtime(m, b, "jet_rt_native_iter_to_list", [Int]{source, list}, -1, source)
        moved = true
    } else if ir_list_element(m, p, b, source) != Val(shape.key.ty) {
        return ir_fail_slot(b, span, "Set construction source {ir_type_name(source_ty)} is not its element List")
    }
    if moved -> ir_make_unique(m, p, b, list)
    set: ir_list_empty(m, b, set_row)
    if order >= 0 -> ir_emit(b.f, IROp.Store, -1, set, 24, order, b.line)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    walk: ir_walk_open(m, b, list, shape.key.ty)
    key: if moved -> walk.item else -> ir_copy_value(m, p, b, walk.item, span)
    _: ir_set_call(m, p, b, set_row, "set.insert", [Int]{set, key}, bool_row)
    b.fresh[key] = false
    ir_walk_close(m, b, walk)
    if moved {
        // The taken List gave every element to the Set.
        capacity: ir_load_word(m, b, list, 8)
        zero: ir_word_const(m, b, 0)
        owns: ir_bool_op(m, b, IROp.Gt, capacity, zero)
        ir_open_if(b.f, owns, b.line)
        ir_list_retire(m, b, list, shape.key.ty, capacity)
        ir_end(b.f, b.line)
    }
    b.fresh[list] = false
    set
}

// A Rank route by its Set equivalent.
ir_set_symbol: fn(symbol: String) -> String Never! {
    if symbol == {
        "jet_sorted_set_from" -> "jet_set_from"
        "jet_sorted_set_to_list" -> "jet_set_to_list"
        "jet_sorted_set_len" -> "jet_set_len"
        "jet_sorted_set_is_empty" -> "jet_set_is_empty"
        "jet_sorted_set_first" -> "jet_set_first"
        "jet_sorted_set_last" -> "jet_set_last"
        "jet_sorted_set_insert" -> "jet_set_insert"
        "jet_sorted_set_remove" -> "jet_set_remove"
        "jet_sorted_set_union" -> "jet_set_union"
        "jet_sorted_set_intersection" -> "jet_set_intersection"
        "jet_sorted_set_difference" -> "jet_set_difference"
        "jet_sorted_set_symmetric_difference" -> "jet_set_symmetric_difference"
        "jet_sorted_set_is_subset" -> "jet_set_is_subset"
        "jet_sorted_set_is_superset" -> "jet_set_is_superset"
        "jet_sorted_set_is_disjoint" -> "jet_set_is_disjoint"
        "std::collections::BTreeSet::contains" -> "jet_set_has"
        else -> symbol
    }
}

// A Set builtin by its route symbol: from, len, capacity, is_empty, first,
// last, max, shuffle, to_list, sort, values, has, insert/add, remove, pop,
// replace, clear, equal, union, intersection, difference,
// symmetric_difference, their in-place `_update` forms and `update`,
// is_subset, is_superset and is_disjoint; None when the builder does not
// lower `symbol` on Sets.
ir_set_builtin: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, route: String, subject: Int, operands: [Int], span: Span) -> Int? Never! {
    symbol: ir_set_symbol(route)
    if symbol == "jet_set_from" || symbol == "jet_iter_to_set" {
        if operands.len() != 1 -> return None
        return Val(ir_set_from(m, p, b, ty, subject, -1, span))
    }
    set_row: b.f.slot_type[subject]
    if ir_bit_set_def(p, m.types[set_row].ty) == .Val(definition) -> return ir_bit_set_builtin(m, p, b, ty, route, symbol, set_row, definition, subject, operands, span)
    shape: ir_set_shape(m, p, set_row) ?? return None
    if symbol == "jet_set_len" || symbol == "jet_set_capacity" {
        int_row: ir_type_row(m, Type.Int) ?? 0
        return Val(ir_load_at(m, b, subject, if symbol == "jet_set_capacity" -> 8 else -> 0, int_row))
    }
    if symbol == "jet_set_is_empty" {
        length: ir_load_word(m, b, subject, 0)
        zero: ir_word_const(m, b, 0)
        return Val(ir_bool_op(m, b, IROp.Eq, length, zero))
    }
    // A Set's first key is its least, as its iteration order is ascending.
    if symbol == "jet_set_first" || symbol == "jet_set_last" || symbol == "jet_set_max" {
        if operands.len() != 1 -> return None
        return Val(ir_set_end(m, p, b, ty, shape, subject, symbol != "jet_set_first", span))
    }
    // `shuffle()`: a fresh List of copies of the keys in the Iter shuffle's order.
    if symbol == "jet_set_shuffle" {
        if operands.len() != 1 -> return None
        list_row: ir_value_type(m, p, ty) ?? return Val(ir_type_fail(b, span, ty))
        listed: ir_set_list(m, p, b, shape, subject, list_row)
        return Val(ir_set_shuffled(m, p, b, shape.entry_ty, listed, list_row, span))
    }
    if symbol == "jet_set_to_list" || symbol == "jet_set_sort" || symbol == "jet_set_values" {
        if operands.len() != 1 -> return None
        result_row: ir_value_type(m, p, ty) ?? return Val(ir_type_fail(b, span, ty))
        if symbol != "jet_set_values" -> return Val(ir_set_list(m, p, b, shape, subject, result_row))
        list_row: ir_value_type(m, p, Type.List{element: shape.entry_ty}) ?? return Val(ir_fail_slot(b, span, "type [{ir_type_name(shape.entry_ty)}]"))
        listed: ir_set_list(m, p, b, shape, subject, list_row)
        return Val(ir_set_values(m, p, b, shape.entry_ty, listed, result_row, span))
    }
    if symbol == "jet_set_equal" {
        if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Set equal without an operand"))
        bool_row: ir_type_row(m, Type.Bool) ?? 0
        return Val(ir_set_call(m, p, b, set_row, "set.equal", [Int]{subject, operands[1]}, bool_row))
    }
    // `union(other)` is a copy of the receiver with a copy of each key of
    // `other` inserted; `intersection(other)` (`difference(other)`) a new Set
    // of copies of the receiver's keys `other` holds (lacks), in the
    // receiver's order; `symmetric_difference(other)` the difference both ways.
    // A Rank result keeps the receiver's order.
    if symbol == "jet_set_union" || symbol == "jet_set_intersection" || symbol == "jet_set_difference" || symbol == "jet_set_symmetric_difference" {
        if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Set {route} without an operand"))
        other: ir_adapt(m, p, b, operands[1], set_row, span)
        if ir_failed(b) -> return Val(-1)
        target := -1
        if symbol == "jet_set_union" {
            target = ir_copy_value(m, p, b, subject, span)
            // The copy shares the receiver's buffer until it is its own.
            ir_make_unique(m, p, b, target)
            ir_set_add_keys(m, p, b, set_row, shape, other, target, span)
        } else {
            target = ir_set_empty_like(m, b, set_row, subject)
            ir_set_keep_keys(m, p, b, set_row, shape, subject, other, target, symbol == "jet_set_intersection", span)
            if symbol == "jet_set_symmetric_difference" -> ir_set_keep_keys(m, p, b, set_row, shape, other, subject, target, false, span)
        }
        ir_release(m, b, other)
        b.fresh[target] = true
        return Val(target)
    }
    // The in-place forms, each walking `other` (never the receiver it
    // writes; the checker keeps `other` from being the receiver, E0204):
    // `update(other)` inserts a copy of each key of `other`,
    // `difference_update(other)` removes them, and
    // `symmetric_difference_update(other)` removes those the receiver holds
    // and inserts a copy of the rest. `intersection_update(other)` first
    // gathers copies of the receiver's keys `other` lacks, then removes them.
    if symbol == "jet_set_update" || symbol == "jet_set_difference_update" || symbol == "jet_set_symmetric_difference_update" || symbol == "jet_set_intersection_update" {
        if operands.len() != 2 || operands[1] < 0 {
            return Val(ir_fail_slot(b, span, "Set {route} without an operand"))
        }
        other: ir_adapt(m, p, b, operands[1], set_row, span)
        if ir_failed(b) -> return Val(-1)
        if symbol == {
            "jet_set_update" -> ir_set_add_keys(m, p, b, set_row, shape, other, subject, span)
            "jet_set_intersection_update" -> {
                lacking: ir_set_empty_like(m, b, set_row, subject)
                ir_set_keep_keys(m, p, b, set_row, shape, subject, other, lacking, false, span)
                walk: ir_walk_open(m, b, lacking, shape.key.ty)
                _: ir_set_call(m, p, b, set_row, "set.remove", [Int]{subject, walk.item}, -1)
                ir_walk_close(m, b, walk)
                b.fresh[lacking] = true
                ir_release(m, b, lacking)
            }
            "jet_set_difference_update" -> {
                walk: ir_walk_open(m, b, other, shape.key.ty)
                _: ir_set_call(m, p, b, set_row, "set.remove", [Int]{subject, walk.item}, -1)
                ir_walk_close(m, b, walk)
            }
            else -> {
                walk: ir_walk_open(m, b, other, shape.key.ty)
                word_row: ir_word_row(m)
                found: ir_set_call(m, p, b, set_row, "set.find", [Int]{subject, walk.item}, word_row)
                none: ir_word_const(m, b, 0)
                held: ir_bool_op(m, b, IROp.Ge, found, none)
                ir_open_if(b.f, held, b.line)
                _: ir_set_call(m, p, b, set_row, "set.remove", [Int]{subject, walk.item}, -1)
                ir_else(b.f, b.line)
                bool_row: ir_type_row(m, Type.Bool) ?? 0
                key: ir_copy_value(m, p, b, walk.item, span)
                _: ir_set_call(m, p, b, set_row, "set.insert", [Int]{subject, key}, bool_row)
                b.fresh[key] = false
                ir_end(b.f, b.line)
                ir_walk_close(m, b, walk)
            }
        }
        ir_release(m, b, other)
        return Val(-1)
    }
    // `is_subset(other)`: `other` holds every receiver key; `is_superset(other)`
    // the converse; `is_disjoint(other)`: it holds none of them.
    if symbol == "jet_set_is_subset" || symbol == "jet_set_is_superset" || symbol == "jet_set_is_disjoint" {
        if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Set {route} without an operand"))
        other: ir_adapt(m, p, b, operands[1], set_row, span)
        if ir_failed(b) -> return Val(-1)
        superset: symbol == "jet_set_is_superset"
        bool_row: ir_type_row(m, Type.Bool) ?? 0
        word_row: ir_word_row(m)
        result: ir_temp(m, b, bool_row)
        yes: ir_int_constant(m, b, bool_row, 1)
        ir_emit(b.f, IROp.Copy, result, yes, -1, -1, b.line)
        walk: ir_walk_open(m, b, if superset -> other else -> subject, shape.key.ty)
        found: ir_set_call(m, p, b, set_row, "set.find", [Int]{if superset -> subject else -> other, walk.item}, word_row)
        none: ir_word_const(m, b, 0)
        broken: ir_bool_op(m, b, if symbol == "jet_set_is_disjoint" -> IROp.Ge else -> IROp.Lt, found, none)
        ir_open_if(b.f, broken, b.line)
        no: ir_int_constant(m, b, bool_row, 0)
        ir_emit(b.f, IROp.Copy, result, no, -1, -1, b.line)
        ir_end(b.f, b.line)
        ir_walk_close(m, b, walk)
        ir_release(m, b, other)
        return Val(result)
    }
    // `clear()`: each key drops and the Set is left empty; its buffer stays
    // for later inserts, as the Map's `clear` does.
    if symbol == "std::collections::HashSet::clear" || symbol == "std::collections::BTreeSet::clear" {
        if operands.len() != 1 -> return Val(ir_fail_slot(b, span, "Set clear with {operands.len() - 1} arguments"))
        if m.types[shape.key.ty].drop != "" {
            walk: ir_walk_open(m, b, subject, shape.entry)
            ir_emit(b.f, IROp.Drop, -1, walk.item, -1, -1, b.line)
            ir_walk_close(m, b, walk)
        }
        zero: ir_word_const(m, b, 0)
        ir_emit(b.f, IROp.Store, -1, subject, 0, zero, b.line)
        if ir_map_hashed(shape) -> ir_map_clear_index(m, b, shape, subject)
        return Val(-1)
    }
    keyed: symbol == "jet_set_remove" || symbol == "jet_set_pop_kernel" || symbol == "jet_set_replace_kernel"
    if !keyed && symbol != "jet_set_has" && symbol != "jet_set_insert" -> return None
    if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Set builtin {route} without a key"))
    key: ir_adapt(m, p, b, operands[1], shape.key.ty, span)
    if ir_failed(b) -> return Val(-1)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    if symbol == "jet_set_remove" {
        _: ir_set_call(m, p, b, set_row, "set.remove", [Int]{subject, key}, -1)
        ir_release(m, b, key)
        return Val(-1)
    }
    if symbol == "jet_set_pop_kernel" || symbol == "jet_set_replace_kernel" {
        // replace takes the stored key out, then moves the offered one in.
        option_row: ir_value_type(m, p, Type.Option{inner: shape.entry_ty}) ?? return Val(ir_fail_slot(b, span, "Set builtin {route} result"))
        taken: ir_set_call(m, p, b, set_row, "set.take", [Int]{subject, key}, option_row)
        if symbol == "jet_set_replace_kernel" {
            offered: ir_own(m, p, b, key)
            _: ir_set_call(m, p, b, set_row, "set.insert", [Int]{subject, offered}, bool_row)
            b.fresh[offered] = false
        } else {
            ir_release(m, b, key)
        }
        return Val(taken)
    }
    if symbol == "jet_set_insert" {
        offered: ir_own(m, p, b, key)
        added: ir_set_call(m, p, b, set_row, "set.insert", [Int]{subject, offered}, bool_row)
        b.fresh[offered] = false
        return Val(added)
    }
    word_row: ir_word_row(m)
    found: ir_set_call(m, p, b, set_row, "set.find", [Int]{subject, key}, word_row)
    none: ir_word_const(m, b, 0)
    present: ir_bool_op(m, b, IROp.Ge, found, none)
    ir_release(m, b, key)
    Val(present)
}

// `shuffle()` over `items`, a fresh List of copies of a Set's keys: a fresh
// List of them in the Iter shuffle's order.
ir_set_shuffled: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, elem: Type, items: Int, list_row: Int, span: Span) -> Int Never! {
    iter_ty: Type.Apply{name: "Iter", args: [Type]{elem.copy()}}
    iter_row: ir_value_type(m, p, iter_ty) ?? return ir_type_fail(b, span, iter_ty)
    meta: ir_lazy_meta(m, p, b, elem, span)
    if meta < 0 -> return -1
    source: ir_lazy_iter_from_list(m, p, b, items, elem, meta, iter_row, span)
    if source < 0 -> return -1
    shuffled: ir_runtime(m, b, "jet_rt_native_iter_shuffle", [Int]{source}, iter_row)
    ir_lazy_consumed(m, b, source)
    out: ir_list_empty(m, b, list_row)
    _: ir_runtime(m, b, "jet_rt_native_iter_to_list", [Int]{shuffled, out}, -1)
    ir_lazy_consumed(m, b, shuffled)
    b.fresh[out] = true
    out
}

// `values()` over `items`, a fresh List of copies of a Set's keys: the
// Iter of type row `iter_row` over them.
ir_set_values: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, elem: Type, items: Int, iter_row: Int, span: Span) -> Int Never! {
    meta: ir_lazy_meta(m, p, b, elem, span)
    if meta < 0 -> return -1
    ir_lazy_iter_from_list(m, p, b, items, elem, meta, iter_row, span)
}

// A Set of a fieldless enum of 1 to 64 cases with no type parameters is
// stored as bits: one word whose bit i is case i in declaration order (a
// payload-free enum value is its case index). The word sits in an 8-byte
// aggregate, so a write lands in place; it owns nothing, so a copy is a
// byte copy and a drop does nothing. Its ascending key order is the case
// order. `bits()` and `Set<E>.from_bits(n)` cross the word as a U64, a
// `#Specified` enum's cases each as their own single-bit value.

// The enum definition of a Set stored as bits, None for any other type.
ir_bit_set_def: fn(p: IRProgram, ty: Type) -> Int? Never! {
    if ir_untag(ty) == .Apply(name, args) {
        if name != "Set" || args.len() != 1 -> return None
        if ir_untag(args[0]) == .Apply(_, _) -> return None
        enum_name: ir_nominal_name(ir_untag(args[0])) ?? return None
        definition: ir_type_def(p, enum_name) ?? return None
        if p.types[definition].generic_params.len() > 0 -> return None
        if p.types[definition].kind == .Enum(variants, _) {
            if variants.len() == 0 || variants.len() > 64 -> return None
            loop variant in variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(_) | .Named(_) -> return None
                }
            }
            return Val(definition)
        }
    }
    None
}

// The case count of the enum definition `definition`.
ir_bit_set_cases: fn(p: IRProgram, definition: Int) -> Int Never! {
    if p.types[definition].kind == .Enum(variants, _) -> return variants.len()
    0
}

// The bit each case of the `#Specified` enum `definition` crosses as, by
// case index; None when a case value is not one bit (sema refuses it).
ir_bit_set_shifts: fn(p: IRProgram, definition: Int) -> [Int]? Never! {
    shifts := [Int]{}
    if p.types[definition].kind == .Enum(variants, _) {
        loop variant in variants {
            value: variant.discriminant ?? return None
            shifts.push(jet_layout_one_bit_shift(value) ?? return None)
        }
    }
    Val(shifts)
}

// A fresh Set of type row `set_row` stored as the bits `word`.
ir_bit_set_make: fn(m: &IRModule, b: &IRBuilder, set_row: Int, word: Int) -> Int Never! {
    set: ir_fresh_temp(m, b, set_row)
    ir_emit(b.f, IROp.StackAddress, set, 8, 8, -1, b.line)
    ir_emit(b.f, IROp.Store, -1, set, 0, word, b.line)
    set
}

// The word `1 << shift`.
ir_bit_set_bit: fn(m: &IRModule, b: &IRBuilder, shift: Int) -> Int Never! {
    one: ir_word_const(m, b, 1)
    ir_word_op(m, b, IROp.Shl, one, shift)
}

IRBitWalk: struct {
    // The case index, a word counting up from 0.
    index: Int
    done: Int
}

// Opens a walk over the cases whose bit `word` holds, in case order; inside
// it, `index` is the case index. ir_bit_walk_close ends it.
ir_bit_walk_open: fn(m: &IRModule, b: &IRBuilder, word: Int, cases: Int) -> IRBitWalk Never! {
    index: ir_word_const(m, b, 0)
    zero: ir_word_const(m, b, 0)
    one: ir_word_const(m, b, 1)
    limit: ir_word_const(m, b, cases)
    done: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    more: ir_bool_op(m, b, IROp.Lt, index, limit)
    ir_exit_unless(m, b, more, done)
    shifted: ir_word_op(m, b, IROp.Shr, word, index)
    held: ir_word_op(m, b, IROp.BitAnd, shifted, one)
    present: ir_bool_op(m, b, IROp.Ne, held, zero)
    ir_open_if(b.f, present, b.line)
    IRBitWalk{index: index, done: done}
}

ir_bit_walk_close: fn(m: &IRModule, b: &IRBuilder, walk: IRBitWalk) Never! {
    ir_end(b.f, b.line)
    one: ir_word_const(m, b, 1)
    ir_emit(b.f, IROp.Add, walk.index, walk.index, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
}

// A fresh List of type row `list_row` of the cases whose bit `word` holds,
// in case order.
ir_bit_set_list: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, word: Int, cases: Int, elem_row: Int, list_row: Int) -> Int Never! {
    out: ir_list_empty(m, b, list_row)
    walk: ir_bit_walk_open(m, b, word, cases)
    key: ir_temp(m, b, elem_row)
    ir_emit(b.f, IROp.Copy, key, walk.index, -1, -1, b.line)
    ir_list_push(m, p, b, out, elem_row, key)
    ir_bit_walk_close(m, b, walk)
    out
}

// `Set.from(source)` / `source.to_set()` of a Set stored as bits: the bit
// of each element of the List or Iter `source`.
ir_bit_set_from: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, set_row: Int, source: Int, span: Span) -> Int Never! {
    elem: ir_set_element(ir_untag(ty)) ?? return ir_type_fail(b, span, ty)
    elem_row: ir_value_type(m, p, elem) ?? return ir_type_fail(b, span, elem)
    source_ty: ir_lazy_slot_type(m, b, source)
    list := source
    if ir_iter_element(source_ty) != None {
        list_row: ir_value_type(m, p, Type.List{element: elem.copy()}) ?? return ir_fail_slot(b, span, "type [{ir_type_name(elem)}]")
        list = ir_list_empty(m, b, list_row)
        _: ir_lazy_runtime(m, b, "jet_rt_native_iter_to_list", [Int]{source, list}, -1, source)
    } else if ir_list_element(m, p, b, source) != Val(elem_row) {
        return ir_fail_slot(b, span, "Set construction source {ir_type_name(source_ty)} is not its element List")
    }
    word: ir_word_const(m, b, 0)
    walk: ir_walk_open(m, b, list, elem_row)
    index: ir_enum_tag_of(m, b, walk.item)
    bit: ir_bit_set_bit(m, b, index)
    ir_emit(b.f, IROp.BitOr, word, word, bit, IR_OVERFLOW_WRAP, b.line)
    ir_walk_close(m, b, walk)
    ir_release(m, b, list)
    ir_bit_set_make(m, b, set_row, word)
}

// `set.bits()` (the Prelude std::collections::HashSet::bits route): the
// word as a U64, each present case of a `#Specified` enum as its own value.
ir_bit_set_bits: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, inputs: [Int], result: Type, span: Span) -> Int Never! {
    if inputs.len() != 1 || inputs[0] < 0 -> return ir_fail_slot(b, span, "Set.bits with {inputs.len()} arguments")
    set_ty: m.types[b.f.slot_type[inputs[0]]].ty
    definition: ir_bit_set_def(p, set_ty) ?? return ir_fail_slot(b, span, "bits of {ir_type_name(set_ty)}")
    row: ir_value_type(m, p, result) ?? return ir_type_fail(b, span, result)
    word: ir_load_word(m, b, inputs[0], 0)
    out: ir_temp(m, b, row)
    if !p.types[definition].specified {
        ir_emit(b.f, IROp.Copy, out, word, -1, -1, b.line)
        return out
    }
    shifts: ir_bit_set_shifts(p, definition) ?? return ir_fail_slot(b, span, "bits of {ir_type_name(set_ty)}, whose case values are not single bits")
    total: ir_word_const(m, b, 0)
    zero: ir_word_const(m, b, 0)
    loop (index, shift) in shifts {
        position: ir_word_const(m, b, index)
        case_bit: ir_bit_set_bit(m, b, position)
        held: ir_word_op(m, b, IROp.BitAnd, word, case_bit)
        present: ir_bool_op(m, b, IROp.Ne, held, zero)
        ir_open_if(b.f, present, b.line)
        shift_word: ir_word_const(m, b, shift)
        own: ir_bit_set_bit(m, b, shift_word)
        ir_emit(b.f, IROp.BitOr, total, total, own, IR_OVERFLOW_WRAP, b.line)
        ir_end(b.f, b.line)
    }
    ir_emit(b.f, IROp.Copy, out, total, -1, -1, b.line)
    out
}

// `Set<E>.from_bits(n)` (the Prelude std::collections::HashSet::from_bits
// route): the Set whose bits `n` gives, each case of a `#Specified` enum by
// its own value; None when `n` has a bit no case stands for.
ir_bit_set_from_bits: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, inputs: [Int], result: Type, span: Span) -> Int Never! {
    if inputs.len() != 1 || inputs[0] < 0 -> return ir_fail_slot(b, span, "Set.from_bits with {inputs.len()} arguments")
    option_row: ir_value_type(m, p, result) ?? return ir_type_fail(b, span, result)
    set_ty: if ir_untag(result) == .Option(inner) -> inner.copy() else -> return ir_fail_slot(b, span, "Set.from_bits of {ir_type_name(result)}")
    definition: ir_bit_set_def(p, set_ty) ?? return ir_fail_slot(b, span, "Set.from_bits of {ir_type_name(set_ty)}")
    set_row: ir_value_type(m, p, set_ty) ?? return ir_type_fail(b, span, set_ty)
    given: inputs[0]
    cases: ir_bit_set_cases(p, definition)
    zero: ir_word_const(m, b, 0)
    ones: ir_word_const(m, b, -1)
    word: ir_word_const(m, b, 0)
    known: ir_word_const(m, b, -1)
    if !p.types[definition].specified {
        ir_emit(b.f, IROp.Copy, word, given, -1, -1, b.line)
        if cases < 64 {
            one: ir_word_const(m, b, 1)
            cases_word: ir_word_const(m, b, cases)
            past: ir_bit_set_bit(m, b, cases_word)
            ir_emit(b.f, IROp.Sub, known, past, one, IR_OVERFLOW_WRAP, b.line)
        }
    } else {
        shifts: ir_bit_set_shifts(p, definition) ?? return ir_fail_slot(b, span, "Set.from_bits of {ir_type_name(set_ty)}, whose case values are not single bits")
        ir_emit(b.f, IROp.Copy, known, zero, -1, -1, b.line)
        loop (index, shift) in shifts {
            shift_word: ir_word_const(m, b, shift)
            own: ir_bit_set_bit(m, b, shift_word)
            ir_emit(b.f, IROp.BitOr, known, known, own, IR_OVERFLOW_WRAP, b.line)
            held: ir_word_op(m, b, IROp.BitAnd, given, own)
            present: ir_bool_op(m, b, IROp.Ne, held, zero)
            ir_open_if(b.f, present, b.line)
            position: ir_word_const(m, b, index)
            case_bit: ir_bit_set_bit(m, b, position)
            ir_emit(b.f, IROp.BitOr, word, word, case_bit, IR_OVERFLOW_WRAP, b.line)
            ir_end(b.f, b.line)
        }
    }
    unknown: ir_word_op(m, b, IROp.BitXor, known, ones)
    stray: ir_word_op(m, b, IROp.BitAnd, given, unknown)
    valid: ir_bool_op(m, b, IROp.Eq, stray, zero)
    out: ir_fresh_temp(m, b, option_row)
    ir_option_none(m, b, out)
    ir_open_if(b.f, valid, b.line)
    set: ir_bit_set_make(m, b, set_row, word)
    made: ir_option_make(m, p, b, option_row, set, 8)
    ir_option_set(m, b, out, made)
    ir_end(b.f, b.line)
    out
}

// A Set builtin on a Set stored as bits (ir_set_builtin's symbols).
ir_bit_set_builtin: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, route: String, symbol: String, set_row: Int, definition: Int, subject: Int, operands: [Int], span: Span) -> Int? Never! {
    elem: ir_set_element(ir_untag(m.types[set_row].ty)) ?? return None
    elem_row: ir_value_type(m, p, elem) ?? return Val(ir_type_fail(b, span, elem))
    cases: ir_bit_set_cases(p, definition)
    int_row: ir_type_row(m, Type.Int) ?? 0
    zero: ir_word_const(m, b, 0)
    word: ir_load_word(m, b, subject, 0)
    if symbol == "jet_set_capacity" -> return Val(ir_int_constant(m, b, int_row, cases))
    if symbol == "jet_set_len" {
        count: ir_word_const(m, b, 0)
        walk: ir_bit_walk_open(m, b, word, cases)
        one: ir_word_const(m, b, 1)
        ir_emit(b.f, IROp.Add, count, count, one, IR_OVERFLOW_WRAP, b.line)
        ir_bit_walk_close(m, b, walk)
        length: ir_temp(m, b, int_row)
        ir_emit(b.f, IROp.Copy, length, count, -1, -1, b.line)
        return Val(length)
    }
    if symbol == "jet_set_is_empty" -> return Val(ir_bool_op(m, b, IROp.Eq, word, zero))
    if symbol == "jet_set_first" || symbol == "jet_set_last" || symbol == "jet_set_max" {
        if operands.len() != 1 -> return None
        result_row: ir_value_type(m, p, ty) ?? return Val(ir_type_fail(b, span, ty))
        found: ir_word_const(m, b, -1)
        walk: ir_bit_walk_open(m, b, word, cases)
        if symbol == "jet_set_first" {
            unset: ir_bool_op(m, b, IROp.Lt, found, zero)
            ir_open_if(b.f, unset, b.line)
            ir_emit(b.f, IROp.Copy, found, walk.index, -1, -1, b.line)
            ir_end(b.f, b.line)
        } else {
            ir_emit(b.f, IROp.Copy, found, walk.index, -1, -1, b.line)
        }
        ir_bit_walk_close(m, b, walk)
        result: ir_fresh_temp(m, b, result_row)
        ir_option_none(m, b, result)
        present: ir_bool_op(m, b, IROp.Ge, found, zero)
        ir_open_if(b.f, present, b.line)
        key: ir_temp(m, b, elem_row)
        ir_emit(b.f, IROp.Copy, key, found, -1, -1, b.line)
        made: ir_option_make(m, p, b, result_row, key, m.types[elem_row].size)
        ir_option_set(m, b, result, made)
        ir_end(b.f, b.line)
        return Val(result)
    }
    if symbol == "jet_set_shuffle" || symbol == "jet_set_to_list" || symbol == "jet_set_sort" || symbol == "jet_set_values" {
        if operands.len() != 1 -> return None
        result_row: ir_value_type(m, p, ty) ?? return Val(ir_type_fail(b, span, ty))
        list_row := result_row
        if symbol == "jet_set_values" {
            list_row = ir_value_type(m, p, Type.List{element: elem.copy()}) ?? return Val(ir_fail_slot(b, span, "type [{ir_type_name(elem)}]"))
        }
        items: ir_bit_set_list(m, p, b, word, cases, elem_row, list_row)
        if symbol == "jet_set_shuffle" -> return Val(ir_set_shuffled(m, p, b, elem, items, result_row, span))
        if symbol == "jet_set_values" -> return Val(ir_set_values(m, p, b, elem, items, result_row, span))
        return Val(items)
    }
    paired: symbol == "jet_set_equal" || symbol == "jet_set_union" || symbol == "jet_set_intersection" || symbol == "jet_set_difference" || symbol == "jet_set_symmetric_difference" || symbol == "jet_set_is_subset" || symbol == "jet_set_is_superset" || symbol == "jet_set_is_disjoint"
    if paired {
        if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Set {route} without an operand"))
        other: ir_adapt(m, p, b, operands[1], set_row, span)
        if ir_failed(b) -> return Val(-1)
        theirs: ir_load_word(m, b, other, 0)
        ir_release(m, b, other)
        shared: ir_word_op(m, b, IROp.BitAnd, word, theirs)
        if symbol == {
            "jet_set_equal" -> return Val(ir_bool_op(m, b, IROp.Eq, word, theirs))
            "jet_set_is_subset" -> return Val(ir_bool_op(m, b, IROp.Eq, shared, word))
            "jet_set_is_superset" -> return Val(ir_bool_op(m, b, IROp.Eq, shared, theirs))
            "jet_set_is_disjoint" -> return Val(ir_bool_op(m, b, IROp.Eq, shared, zero))
            "jet_set_union" -> {
                joined: ir_word_op(m, b, IROp.BitOr, word, theirs)
                return Val(ir_bit_set_make(m, b, set_row, joined))
            }
            "jet_set_intersection" -> return Val(ir_bit_set_make(m, b, set_row, shared))
            "jet_set_symmetric_difference" -> {
                either: ir_word_op(m, b, IROp.BitXor, word, theirs)
                return Val(ir_bit_set_make(m, b, set_row, either))
            }
            else -> {
                left: ir_word_op(m, b, IROp.BitXor, word, shared)
                return Val(ir_bit_set_make(m, b, set_row, left))
            }
        }
    }
    if symbol == "std::collections::HashSet::clear" {
        if operands.len() != 1 -> return Val(ir_fail_slot(b, span, "Set clear with {operands.len() - 1} arguments"))
        ir_emit(b.f, IROp.Store, -1, subject, 0, zero, b.line)
        return Val(-1)
    }
    keyed: symbol == "jet_set_has" || symbol == "jet_set_insert" || symbol == "jet_set_remove" || symbol == "jet_set_pop_kernel" || symbol == "jet_set_replace_kernel"
    if !keyed -> return None
    if operands.len() != 2 || operands[1] < 0 -> return Val(ir_fail_slot(b, span, "Set builtin {route} without a key"))
    key: ir_adapt(m, p, b, operands[1], elem_row, span)
    if ir_failed(b) -> return Val(-1)
    index: ir_enum_tag_of(m, b, key)
    bit: ir_bit_set_bit(m, b, index)
    held: ir_word_op(m, b, IROp.BitAnd, word, bit)
    present: ir_bool_op(m, b, IROp.Ne, held, zero)
    if symbol == "jet_set_has" -> return Val(present)
    updated: if symbol == "jet_set_insert" || symbol == "jet_set_replace_kernel" -> ir_word_op(m, b, IROp.BitOr, word, bit) else -> ir_word_op(m, b, IROp.BitXor, word, held)
    ir_emit(b.f, IROp.Store, -1, subject, 0, updated, b.line)
    if symbol == "jet_set_insert" -> return Val(ir_bool_op(m, b, IROp.Eq, held, zero))
    if symbol == "jet_set_remove" -> return Val(-1)
    // pop and replace give back the key the Set held.
    option_row: ir_value_type(m, p, Type.Option{inner: elem.copy()}) ?? return Val(ir_fail_slot(b, span, "Set builtin {route} result"))
    result: ir_fresh_temp(m, b, option_row)
    ir_option_none(m, b, result)
    ir_open_if(b.f, present, b.line)
    made: ir_option_make(m, p, b, option_row, key, m.types[elem_row].size)
    ir_option_set(m, b, result, made)
    ir_end(b.f, b.line)
    Val(result)
}
