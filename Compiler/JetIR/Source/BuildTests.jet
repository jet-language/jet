// The native unit-test harness (`jet test`): the selected checked tests and
// Check Outputs built with every function they reach, plus the generated
// callbacks and entry that run them through the test runtime. The parent
// (JetCli NativeTests.jet) owns selection, order and the final report; a
// child streams one complete record per test before exiting, so a fatal child
// cannot erase completed outcomes.
//
// Per test:
//   test.invoke(env) -> String?  calls the body; null on success, else the
//                                failure message (a Result error's Debug
//                                text, or "test returned no value" for None).
//                                A property body's env is the property
//                                context: each parameter is generated from
//                                it and the rendered inputs handed over
//                                before the call.
//   test.unit(env) -> outcome    jet_rt_test_unit(name, expected, env, invoke),
//                                jet_rt_test_property for a property body
//                                (JetRuntime TestProperty.jet)
// and one shared test.release(env), a no-op (the environment is null).
// The entry `main`:
//   JET_NATIVE_TEST_REPORT_PATH set: report the outcome file and exit
//   (jet_rt_test_read, jet_rt_test_finish_wire; exit 1 when a test failed).
//   Otherwise: call the package's `test: fn(t: Test)` with a fresh suite; with
//   TEST_SETTINGS_PLAN_ENV set that is `jet test`'s plan step (the calls
//   have written their settings) and it exits 0. Then read
//   JET_NATIVE_TEST_RECORDS_PATH (exit 103 without it), open it for the
//   contract records (jet_rt_test_contracts_open), spawn each selected
//   test (only `JET_NATIVE_TEST_ID`'s when set) and append its record
//   `JET_NATIVE_TEST <id>\n<wire>\n`, streaming each serially or joining all
//   after spawning; then, unfiltered, run each Check Output once. A checked
//   `#Pre`/`#Post` clause's first hold and every failure append
//   `JET_NATIVE_CONTRACT <held> <length>\n<site>\n` to that file as they
//   happen (JetRuntime TestContracts.jet).

use {
    jet_foundation.[BodyScopeMemberKind, DeclTable, Span, TConstantDef, FnBody, TEST_SETTINGS_PLAN_ENV, TImplDef, TPanicLoc, TPanicLocal, TTypeDef, Type, measure_literal_value, name_rows_set]
    jet_sema.[SemaCheckedForeignFunction]
}

// One test the harness runs: its checked function `key`, the identity `id`
// its outcome record carries, its report name, whether it must fail and the
// canonical `#Test(faults: [...])` selectors it runs under.
IRTestCase: struct { id: Int, key: String, name: String, expected_failure: Bool, faults: [String]{[]} }

// A selected Check Output: its name and its checked zero-argument function.
IROutputCheck: struct { name: String, key: String }

// The harness `jet test` runs: `tests` in run order, then (unfiltered) each
// of `checks`. `serial` streams each test's record before spawning the next;
// otherwise every test is spawned before any is joined. `stock`
// (`--show-default`) never calls the package's `test: fn`. `coverage` (`jet
// test --coverage`) names the functions whose entry records its line, by
// checked key (IRProgram.coverage).
IRTestHarness: struct { tests: [IRTestCase], checks: [IROutputCheck], serial: Bool, stock: Bool{false}, coverage: [String:Int]{[String:Int]{}} }

// Builds `harness` and every function it reaches, keeping `checks`
// (ir_bounds_mode).
ir_build_tests: fn(functions: &&[FnBody], decls: DeclTable, type_defs: &&[TTypeDef], impls: &&[TImplDef], sources: &&[String:String], constants: &&[TConstantDef], foreign: &&[SemaCheckedForeignFunction], harness: IRTestHarness, checks: IRChecks) -> IRBuildResult Never! {
    p := ir_program_new(functions, decls, type_defs, impls, sources, constants)
    p.checks = checks
    p.sentries = true
    p.contract_records = true
    p.coverage = harness.coverage.copy()
    ir_foreign_index(p, foreign, decls)
    m := ir_module_for(p)
    failures := [IRBuildFailure]{}
    bodies := [Int]{}
    loop test in harness.tests {
        id: ir_function_id(m, p, test.key, [Type]{}) ?? -1
        if id < 0 -> failures.push(IRBuildFailure{key: test.key, name: test.name, message: "the test function is not among the checked functions", source_file: "", span: Span{start: 0, end: 0}})
        // A stop in the body names the test as its source
        // does, not by its checked key (`<module>::test::<name>@<span>`).
        if id >= 0 -> m.functions[id].name = "test \"{test.name}\""
        bodies.push(id)
    }
    check_ids := [Int]{}
    loop check in harness.checks {
        id: ir_function_id(m, p, check.key, [Type]{}) ?? -1
        if id < 0 -> failures.push(IRBuildFailure{key: check.key, name: check.name, message: "the output check function is not among the checked functions", source_file: "", span: Span{start: 0, end: 0}})
        check_ids.push(id)
    }
    if failures.len() > 0 -> return IRBuildResult{program: m, failures: failures}
    override: if harness.stock -> -1 else -> ir_test_override(m, p)
    built: ir_build_queue(m, p, failures, 0)
    m.entry = ir_test_main(m, p, harness, bodies, check_ids, override, failures)
    // The functions the harness's renders reached (a Printable impl).
    _: ir_build_queue(m, p, failures, built)
    ir_drop_glues(m, p)
    IRBuildResult{program: ir_merge_serial(m), failures: failures}
}

// `jet test --coverage`: a probed function's entry hands its line to the
// runtime (JetRuntime Coverage.jet), which records the first entry of each
// line in the test process.
ir_coverage_probe: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, function: FnBody) Never! {
    line: p.coverage.get(function.key) ?? return
    word: ir_word_const(m, b, line)
    _: ir_runtime(m, b, "jet_rt_coverage_function", [Int]{word}, -1)
}

// The package's `test: fn(t: Test)`, when it has one: the project's test
// entry, called with the suite before the harness runs the discovered tests,
// unless the harness is the stock one. -1 when there is none.
ir_test_override: fn(m: &IRModule, p: IRProgram) -> Int Never! {
    key: ir_test_override_key(p.functions)
    if key == "" -> return -1
    ir_function_id(m, p, key, [Type]{}) ?? -1
}

// The key of the package's `test: fn(t: Test)` among `functions`, "" when
// there is none; `jet test` announces the override it runs.
ir_test_override_key: fn(functions: [FnBody]) -> String Never! {
    loop function in functions {
        if function.name != "test" || function.params.len() != 1 || function.generic_params.len() > 0 || function.module_name.starts_with("core") -> next
        top_level: if function.kind == {
            .TopLevel -> true
            .Method(_, _) | .TraitMethod(_, _, _, _, _) -> false
        }
        if !top_level -> next
        name: ir_nominal_name(ir_untag(function.params[0].ty)) ?? next
        if ir_short_name(name) != "Test" -> next
        return function.key.copy()
    }
    ""
}

// A generated harness function: `name`, keyed and symbolled after the
// function `from` (`suffix` appended), at its source location; a shared
// helper (`from` < 0) is keyed `jet_ir_test_<suffix>`.
ir_test_function: fn(m: &IRModule, name: String, from: Int, suffix: String) -> Int Never! {
    key := "jet_ir_test_{suffix}"
    symbol := key.copy()
    source_file := ""
    line := 0
    if from >= 0 {
        key = "{m.functions[from].key}#test.{suffix}"
        symbol = "{m.functions[from].symbol}__test_{suffix}"
        source_file = m.functions[from].source_file.copy()
        line = m.functions[from].line
    }
    id: m.functions.len()
    function: ir_function_new(name, key, symbol, source_file, line)
    m.functions.push(function)
    name_rows_set(m.function_rows, key, id)
    id
}

// Ends a generated function: records its failure, resolves its deferred
// calls and stores it.
ir_test_finish: fn(m: &IRModule, p: IRProgram, b: &&IRBuilder, id: Int, failures: &[IRBuildFailure]) Never! {
    built := b.move()
    if built.error != "" {
        failures.push(IRBuildFailure{key: m.functions[id].key, name: m.functions[id].name, message: built.error, source_file: m.functions[id].source_file, span: built.error_span})
    }
    ir_resolve_deferred(m, p, built)
    m.functions[id] = built.f.move()
}

// Drops `slot` when its type has a drop, leaving its freshness alone.
ir_test_drop: fn(m: &IRModule, b: &IRBuilder, slot: Int) Never! {
    if slot >= 0 && ir_has_drop(m, b, slot) -> ir_emit(b.f, IROp.Drop, -1, slot, -1, -1, b.line)
}

// A fresh owned String of `text`.
ir_test_text: fn(m: &IRModule, b: &IRBuilder, text: String) -> Int Never! {
    string_row: ir_string_row(m)
    pair: ir_static_text(m, b, text)
    ir_runtime(m, b, "jet_rt_string_from_static", pair, string_row)
}

ir_test_bool: fn(m: &IRModule, b: &IRBuilder, value: Bool) -> Int Never! {
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    slot: ir_temp(m, b, bool_row)
    ir_emit(b.f, IROp.Const, slot, if value -> 1 else -> 0, -1, -1, b.line)
    slot
}

// The environment variable `name`: a String slot, null when it is unset.
// String drop accepts null; every other read is guarded by its presence.
ir_test_env: fn(m: &IRModule, b: &IRBuilder, name: String) -> Int Never! {
    pointer_row: ir_pointer_row(m)
    word_row: ir_word_row(m)
    key: ir_test_text(m, b, name)
    slot: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.StackAddress, slot, 8, 8, -1, b.line)
    zero: ir_word_const(m, b, 0)
    ir_emit(b.f, IROp.Store, -1, slot, 0, zero, b.line)
    _: ir_runtime(m, b, "jet_std_env_get", [Int]{key, slot}, word_row)
    ir_test_drop(m, b, key)
    string_row: ir_string_row(m)
    ir_load_at(m, b, slot, 0, string_row)
}

// Whether the pointer-sized `value` is not null: compared as a raw word,
// since a String `!=` is a text comparison. The word is a Move, a plain
// transfer (a String Copy clones, which a null text cannot).
ir_test_present: fn(m: &IRModule, b: &IRBuilder, value: Int) -> Int Never! {
    pointer_row: ir_pointer_row(m)
    word: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.Move, word, value, -1, -1, b.line)
    null: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.Const, null, 0, -1, -1, b.line)
    ir_bool_op(m, b, IROp.Ne, word, null)
}

// Ends the process with `code`.
ir_test_exit: fn(m: &IRModule, b: &IRBuilder, code: Int) Never! {
    status: ir_word_const(m, b, code)
    _: ir_runtime(m, b, "jet_std_process_exit", [Int]{status}, -1)
    ir_emit(b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
}

// test.invoke(env) for the test body `body`.
ir_test_invoke: fn(m: &IRModule, p: IRProgram, body: Int, failures: &[IRBuildFailure]) -> Int Never! {
    id: ir_test_function(m, "test.invoke", body, "invoke")
    b := ir_builder_new(m.functions[id].copy())
    b.line = m.functions[body].line
    span: Span{start: 0, end: 0}
    pointer_row: ir_pointer_row(m)
    string_row: ir_string_row(m)
    env_name: ir_intern_name(m, "env")
    env: ir_new_slot(b, pointer_row, IRSlotKind.Param, env_name)
    b.f.result = pointer_row
    no_args: [Int]{}
    null: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.Const, null, 0, -1, -1, b.line)
    result := -1
    if m.functions[body].param_count > 0 {
        result = ir_test_property_call(m, p, b, body, env, span)
    } else {
        row: m.functions[body].result
        if row >= 0 && m.types[row].kind != .Unit -> result = ir_temp(m, b, row)
        operands: ir_args(b.f, no_args)
        ir_emit(b.f, IROp.Call, result, body, operands, 0, b.line)
        ir_stop_check(m, b)
    }
    if result >= 0 && !ir_failed(b) {
        row: b.f.slot_type[result]
        ty: m.types[row].ty.copy()
        if ir_untag(ty) == {
            .Result(_, err_ty) -> {
                // A kept `T Never!` carrier never holds an Err.
                if !ir_never_type(err_ty) {
                    verdict: ir_load_word(m, b, result, 0)
                    zero: ir_word_const(m, b, 0)
                    failed: ir_bool_op(m, b, IROp.Eq, verdict, zero)
                    ir_open_if(b.f, failed, b.line)
                    err_row: ir_value_type(m, p, err_ty) ?? pointer_row
                    error: ir_load_at(m, b, result, 8, err_row)
                    text: ir_render(m, p, b, err_ty, error, IRRender.Debug, span)
                    // The returned message outlives the dropped carrier.
                    owned: if text >= 0 && b.fresh[text] -> text else -> ir_runtime(m, b, "jet_rt_string_clone", [Int]{text}, string_row)
                    ir_test_drop(m, b, result)
                    owned_word: ir_test_message_word(m, b, owned)
                    ir_emit(b.f, IROp.Return, -1, owned_word, -1, -1, b.line)
                    ir_end(b.f, b.line)
                }
            }
            .Option(_) -> {
                if m.types[row].kind != .Pointer && !ir_option_inline(m, row) {
                    ir_fail(b, span, "a test returning {ir_type_name(ty)}")
                } else {
                    absent: ir_is_null(m, b, result)
                    ir_open_if(b.f, absent, b.line)
                    message: ir_test_text(m, b, "test returned no value")
                    message_word: ir_test_message_word(m, b, message)
                    ir_emit(b.f, IROp.Return, -1, message_word, -1, -1, b.line)
                    ir_end(b.f, b.line)
                }
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ir_fail(b, span, "native unit test body does not return Unit or its checked failure carrier")
        }
        ir_test_drop(m, b, result)
    }
    ir_emit(b.f, IROp.Return, -1, null, -1, -1, b.line)
    ir_test_finish(m, p, b, id, failures)
    id
}

// The pointer word test.invoke returns for the owned failure message `text`:
// the String moves out as its header pointer, which the test runtime takes.
ir_test_message_word: fn(m: &IRModule, b: &IRBuilder, text: Int) -> Int Never! {
    pointer_row: ir_pointer_row(m)
    word: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.Move, word, text, -1, -1, b.line)
    word
}

// The call of property body `body` on parameters generated from the property
// context `ctx`. A case whose values fail one of the property's `#Pre`
// clauses is rejected (ir_test_property_reject) before anything else. The
// rendered inputs (`name = value, …`) go to the context first, so a failing
// case reports them. The result is owned by the caller, -1 for Unit.
ir_test_property_call: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, body: Int, ctx: Int, span: Span) -> Int Never! {
    row: ir_function_row(p, m.functions[body].key) ?? return ir_fail_slot(b, span, "a property test outside the checked program")
    params: p.functions[row].params
    values := [Int]{}
    loop param in params {
        value: ir_test_generate(m, p, b, ctx, param.ty, span)
        if ir_failed(b) -> return -1
        values.push(value)
    }
    ir_test_property_reject(m, p, b, row, ctx, values)
    if ir_failed(b) -> return -1
    pointer_row: ir_pointer_row(m)
    string_row: ir_string_row(m)
    builder: ir_runtime(m, b, "jet_rt_string_builder_new", [Int]{}, pointer_row)
    b.fresh[builder] = false
    loop (index, param) in params {
        if index > 0 -> ir_push_static(m, b, builder, ", ")
        ir_push_static(m, b, builder, "{param.name} = ")
        ir_render_push(m, p, b, builder, values[index], IRRender.Debug, true, span)
        if ir_failed(b) -> return -1
    }
    text: ir_runtime(m, b, "jet_rt_string_builder_finish", [Int]{builder}, string_row)
    _: ir_runtime(m, b, "jet_rt_test_property_inputs", [Int]{ctx, text}, -1)
    b.fresh[text] = false
    result: ir_call_row_values(m, p, b, row, values, span)
    if result >= 0 -> b.fresh[result] = false
    result
}

// The property `row`'s `#Pre` clauses over its generated parameter `values`
// (borrowed): when one fails, the case is rejected
// (jet_rt_test_property_reject) and test.invoke returns without calling the
// body. The clauses read the property's own tree, so they build with its row
// and its parameters bound to the values.
ir_test_property_reject: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int, ctx: Int, values: [Int]) Never! {
    pre: p.functions[row].pre
    if pre.len() == 0 -> return
    outer_row: b.row
    outer_bounds: b.bounds
    b.row = row
    b.bounds = ir_bounds_mode(p, row)
    mark: b.bindings.len()
    loop (index, param) in p.functions[row].params {
        symbol: if param.local.symbol_id == .Val(id) -> id.key else -> ""
        b.bindings.push(IRBinding{name: param.local.name, slot: values[index], owned: false, symbol: symbol})
    }
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    pointer_row: ir_pointer_row(m)
    loop clause in pre {
        condition: ir_expr(m, p, b, clause.condition)
        if ir_failed(b) || condition < 0 -> break
        rejected: ir_temp(m, b, bool_row)
        ir_emit(b.f, IROp.Not, rejected, condition, -1, -1, b.line)
        ir_open_if(b.f, rejected, b.line)
        _: ir_runtime(m, b, "jet_rt_test_property_reject", [Int]{ctx}, -1)
        loop value in values {
            if b.fresh[value] -> ir_test_drop(m, b, value)
        }
        null: ir_temp(m, b, pointer_row)
        ir_emit(b.f, IROp.Const, null, 0, -1, -1, b.line)
        ir_emit(b.f, IROp.Return, -1, null, -1, -1, b.line)
        ir_end(b.f, b.line)
    }
    ir_truncate_bindings(b, mark)
    b.row = outer_row
    b.bounds = outer_bounds
}

// A value of the property parameter type `ty` drawn from the context `ctx`
// (JetRuntime TestProperty.jet): fresh where its type owns storage. An
// integer stays within ±2^62.
ir_test_generate: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ctx: Int, ty: Type, span: Span) -> Int Never! {
    row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    word_row: ir_word_row(m)
    limit: 4611686018427387904
    untagged: ir_untag(ty)
    if untagged == .Int -> return ir_test_generate_word(m, p, b, ctx, 0 - limit, limit, row, span)
    if untagged == .InlineRange(_, lo, hi) {
        return ir_test_generate_word(m, p, b, ctx, if lo < 0 - limit -> 0 - limit else -> lo, if hi > limit -> limit else -> hi, row, span)
    }
    if untagged == .IntN(signed, bits) {
        top: if signed -> (if bits >= 64 -> limit else -> (1 << (bits - 1)) - 1) else -> (if bits >= 63 -> limit else -> (1 << bits) - 1)
        bottom: if !signed -> 0 else if bits >= 64 -> 0 - limit else -> 0 - (1 << (bits - 1))
        return ir_test_generate_word(m, p, b, ctx, bottom, top, row, span)
    }
    if untagged == .Bool {
        two: ir_word_const(m, b, 2)
        drawn: ir_runtime(m, b, "jet_rt_test_property_draw", [Int]{ctx, two}, word_row)
        zero: ir_word_const(m, b, 0)
        return ir_bool_op(m, b, IROp.Ne, drawn, zero)
    }
    if untagged == .Char -> return ir_runtime(m, b, "jet_rt_test_property_char", [Int]{ctx}, row)
    if untagged == .String -> return ir_runtime(m, b, "jet_rt_test_property_string", [Int]{ctx}, row)
    if untagged == .Float -> return ir_runtime(m, b, "jet_rt_test_property_float", [Int]{ctx}, row)
    if untagged == .Float32 {
        float_row: ir_type_row(m, Type.Float) ?? return ir_type_fail(b, span, Type.Float)
        wide: ir_runtime(m, b, "jet_rt_test_property_float", [Int]{ctx}, float_row)
        return ir_numeric_cast(m, p, b, wide, row, span)
    }
    if untagged == .List(element) {
        bound: ir_word_const(m, b, 17)
        count: ir_runtime(m, b, "jet_rt_test_property_draw", [Int]{ctx, bound}, word_row)
        return ir_test_generate_list(m, p, b, ctx, row, element, count, span)
    }
    if untagged == .FixedList(element, measure) {
        length: measure_literal_value(measure) ?? return ir_fail_slot(b, span, "a property input of {ir_type_name(ty)} without a literal length")
        count: ir_word_const(m, b, length)
        // An inline `[T#N]` takes the elements of a drawn List.
        if ir_fixed_list_row(m, p, row) == .Val(list_row) {
            drawn: ir_test_generate_list(m, p, b, ctx, list_row, element, count, span)
            if ir_failed(b) || drawn < 0 -> return -1
            storage: ir_fresh_temp(m, b, row)
            ir_emit(b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
            ir_fixed_store_back(m, p, b, storage, drawn)
            return storage
        }
        return ir_test_generate_list(m, p, b, ctx, row, element, count, span)
    }
    if untagged == .Option(inner) {
        inner_row: ir_value_type(m, p, inner) ?? return ir_type_fail(b, span, inner)
        result: ir_option_none_temp(m, b, row)
        two: ir_word_const(m, b, 2)
        drawn: ir_runtime(m, b, "jet_rt_test_property_draw", [Int]{ctx, two}, word_row)
        zero: ir_word_const(m, b, 0)
        present: ir_bool_op(m, b, IROp.Ne, drawn, zero)
        ir_open_if(b.f, present, b.line)
        value: ir_test_generate(m, p, b, ctx, inner, span)
        if ir_failed(b) -> return -1
        size: m.types[inner_row].size
        made: ir_option_make(m, p, b, row, value, size)
        ir_option_set(m, b, result, made)
        ir_end(b.f, b.line)
        b.fresh[result] = true
        return result
    }
    ir_fail_slot(b, span, "a property input of {ir_type_name(ty)}")
}

// An integer of type row `row` in lo...hi.
ir_test_generate_word: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ctx: Int, lo: Int, hi: Int, row: Int, span: Span) -> Int Never! {
    low: ir_word_const(m, b, lo)
    high: ir_word_const(m, b, hi)
    word_row: ir_word_row(m)
    drawn: ir_runtime(m, b, "jet_rt_test_property_word", [Int]{ctx, low, high}, word_row)
    ir_numeric_cast(m, p, b, drawn, row, span)
}

// A List of type row `row` holding `count` (a word slot) generated
// `element`s, in fresh frame storage.
ir_test_generate_list: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ctx: Int, row: Int, element: Type, count: Int, span: Span) -> Int Never! {
    element_row: ir_value_type(m, p, element) ?? return ir_type_fail(b, span, element)
    list: ir_list_empty(m, b, row)
    index: ir_count_open(m, b, count)
    value: ir_test_generate(m, p, b, ctx, element, span)
    if ir_failed(b) -> return -1
    ir_list_push(m, p, b, list, element_row, value)
    ir_count_close(m, b, index)
    list
}

// test.unit(env) for `test`, whose body is `body`: the canonical test rail
// over its test.invoke.
ir_test_unit: fn(m: &IRModule, p: IRProgram, test: IRTestCase, body: Int, failures: &[IRBuildFailure]) -> Int Never! {
    invoke: ir_test_invoke(m, p, body, failures)
    id: ir_test_function(m, "test.unit", body, "unit")
    b := ir_builder_new(m.functions[id].copy())
    b.line = m.functions[body].line
    pointer_row: ir_pointer_row(m)
    env_name: ir_intern_name(m, "env")
    env: ir_new_slot(b, pointer_row, IRSlotKind.Param, env_name)
    b.f.result = pointer_row
    name: ir_test_text(m, b, test.name)
    expected: ir_test_bool(m, b, test.expected_failure)
    code: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.FunctionAddress, code, invoke, -1, -1, b.line)
    property: m.functions[body].param_count > 0
    outcome := -1
    if test.faults.len() > 0 {
        selectors: ir_test_text(m, b, test.faults.join("\n"))
        flag: ir_test_bool(m, b, property)
        outcome = ir_runtime(m, b, "jet_rt_test_unit_faults", [Int]{name, expected, env, code, selectors, flag}, pointer_row)
        ir_test_drop(m, b, selectors)
    } else {
        symbol: if property -> "jet_rt_test_property" else -> "jet_rt_test_unit"
        outcome = ir_runtime(m, b, symbol, [Int]{name, expected, env, code}, pointer_row)
    }
    ir_test_drop(m, b, name)
    ir_emit(b.f, IROp.Return, -1, outcome, -1, -1, b.line)
    ir_test_finish(m, p, b, id, failures)
    id
}

// test.release(env): the harness spawns with a null environment, so it owns
// nothing.
ir_test_release: fn(m: &IRModule, p: IRProgram, failures: &[IRBuildFailure]) -> Int Never! {
    id: ir_test_function(m, "test.release", -1, "release")
    b := ir_builder_new(m.functions[id].copy())
    pointer_row: ir_pointer_row(m)
    env_name: ir_intern_name(m, "env")
    _: ir_new_slot(b, pointer_row, IRSlotKind.Param, env_name)
    ir_emit(b.f, IROp.Return, -1, -1, -1, -1, b.line)
    ir_test_finish(m, p, b, id, failures)
    id
}

// Appends `text` to the records file `path`; a write failure is a protocol
// failure (exit 103), never a failure of the joined test.
ir_test_append: fn(m: &IRModule, b: &IRBuilder, path: Int, text: Int) Never! {
    pointer_row: ir_pointer_row(m)
    word_row: ir_word_row(m)
    string_row: ir_string_row(m)
    error_slot: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.StackAddress, error_slot, 8, 8, -1, b.line)
    status: ir_runtime(m, b, "jet_rt_test_append", [Int]{path, text, error_slot}, word_row)
    zero: ir_word_const(m, b, 0)
    failed: ir_bool_op(m, b, IROp.Eq, status, zero)
    ir_open_if(b.f, failed, b.line)
    error: ir_load_at(m, b, error_slot, 0, pointer_row)
    message: ir_runtime(m, b, "jet_rt_handle_show_io_error", [Int]{error}, string_row)
    _: ir_runtime(m, b, "jet_rt_test_eprint", [Int]{message}, -1)
    _: ir_runtime(m, b, "jet_rt_handle_drop_io_error", [Int]{error}, -1)
    ir_test_drop(m, b, message)
    ir_test_exit(m, b, 103)
    ir_end(b.f, b.line)
}

// Joins the spawned test `handle` and appends its record.
ir_test_stream: fn(m: &IRModule, b: &IRBuilder, handle: Int, id: Int, path: Int) Never! {
    pointer_row: ir_pointer_row(m)
    string_row: ir_string_row(m)
    outcome: ir_runtime(m, b, "jet_rt_test_join", [Int]{handle}, pointer_row)
    wire: ir_runtime(m, b, "jet_rt_test_outcome_wire", [Int]{outcome}, string_row)
    ir_push_static(m, b, wire, "\n")
    identity: ir_test_text(m, b, "JET_NATIVE_TEST {id}\n")
    ir_test_append(m, b, path, identity)
    ir_test_append(m, b, path, wire)
    ir_test_drop(m, b, identity)
    ir_test_drop(m, b, wire)
}

// Reporter mode: reads the parent's outcome file `path`, prints the
// canonical report and exits 1 when a test failed.
ir_test_report: fn(m: &IRModule, b: &IRBuilder, path: Int) Never! {
    pointer_row: ir_pointer_row(m)
    word_row: ir_word_row(m)
    string_row: ir_string_row(m)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    cells: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.StackAddress, cells, 16, 8, -1, b.line)
    error_slot: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.Offset, error_slot, cells, 8, -1, b.line)
    status: ir_runtime(m, b, "jet_rt_test_read", [Int]{path, cells, error_slot}, word_row)
    ir_test_drop(m, b, path)
    zero: ir_word_const(m, b, 0)
    failed: ir_bool_op(m, b, IROp.Eq, status, zero)
    ir_open_if(b.f, failed, b.line)
    error: ir_load_at(m, b, cells, 8, pointer_row)
    text: ir_runtime(m, b, "jet_rt_handle_show_io_error", [Int]{error}, string_row)
    _: ir_runtime(m, b, "jet_rt_handle_drop_io_error", [Int]{error}, -1)
    _: ir_runtime(m, b, "jet_rt_entry_error_exit", [Int]{text}, -1)
    ir_emit(b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
    ir_end(b.f, b.line)
    wire: ir_load_at(m, b, cells, 0, string_row)
    ok: ir_runtime(m, b, "jet_rt_test_finish_wire", [Int]{wire}, bool_row)
    ir_test_drop(m, b, wire)
    rejected: ir_temp(m, b, bool_row)
    ir_emit(b.f, IROp.Not, rejected, ok, -1, -1, b.line)
    ir_open_if(b.f, rejected, b.line)
    ir_test_exit(m, b, 1)
    ir_end(b.f, b.line)
}

// Calls the package's `test: fn(t: Test)` (`override`) with a fresh suite.
ir_test_call_override: fn(m: &IRModule, b: &IRBuilder, override: Int) Never! {
    pointer_row: ir_pointer_row(m)
    suite: ir_runtime(m, b, "jet_test_suite_new", [Int]{}, pointer_row)
    row: m.functions[override].result
    result: if row < 0 || m.types[row].kind == .Unit -> -1 else -> ir_temp(m, b, row)
    operands: ir_args(b.f, [Int]{suite})
    ir_emit(b.f, IROp.Call, result, override, operands, 1, b.line)
    ir_stop_check(m, b)
    ir_test_drop(m, b, result)
    _: ir_runtime(m, b, "jet_rt_handle_drop_jet_test_suite", [Int]{suite}, -1)
}

// The generated function that runs the Check Output `check` (function
// `function`) once: a Bool `false` stops the program, any other result is
// dropped unclassified. It carries the check function's name, which the
// stop report shows.
ir_test_check: fn(m: &IRModule, p: IRProgram, check: IROutputCheck, function: Int, failures: &[IRBuildFailure]) -> Int Never! {
    name: m.functions[function].name.copy()
    id: ir_test_function(m, name, function, "check")
    b := ir_builder_new(m.functions[id].copy())
    b.line = m.functions[function].line
    span: Span{start: 0, end: 0}
    if m.functions[function].param_count > 0 {
        ir_fail(b, span, "native output check {check.name} requires a checked zero-argument top-level function")
    } else {
        row: m.functions[function].result
        result: if row < 0 || m.types[row].kind == .Unit -> -1 else -> ir_temp(m, b, row)
        operands: ir_args(b.f, [Int]{})
        ir_emit(b.f, IROp.Call, result, function, operands, 0, b.line)
        ir_stop_check(m, b)
        if result >= 0 && m.types[row].kind == .Bool {
            bool_row: ir_type_row(m, Type.Bool) ?? 0
            rejected: ir_temp(m, b, bool_row)
            ir_emit(b.f, IROp.Not, rejected, result, -1, -1, b.line)
            ir_open_if(b.f, rejected, b.line)
            message: ir_test_text(m, b, "output check {check.name}")
            null: ir_word_const(m, b, 0)
            location: TPanicLoc{file: m.functions[function].source_file.copy(), source_line: "", line: m.functions[function].line, column: 0, caret: 0, function: name, locals: [TPanicLocal]{}}
            ir_stop(m, p, b, 2, message, null, null, location)
            ir_end(b.f, b.line)
        }
        ir_test_drop(m, b, result)
    }
    ir_emit(b.f, IROp.Return, -1, -1, -1, -1, b.line)
    ir_test_finish(m, p, b, id, failures)
    id
}

// The harness entry `main` (see the head of this file).
ir_test_main: fn(m: &IRModule, p: IRProgram, harness: IRTestHarness, bodies: [Int], check_ids: [Int], override: Int, failures: &[IRBuildFailure]) -> Int Never! {
    units := [Int]{}
    loop (index, test) in harness.tests -> units.push(ir_test_unit(m, p, test, bodies[index], failures))
    release_id: ir_test_release(m, p, failures)
    check_helpers := [Int]{}
    loop (index, check) in harness.checks -> check_helpers.push(ir_test_check(m, p, check, check_ids[index], failures))
    id: ir_test_function(m, "main", -1, "main")
    b := ir_builder_new(m.functions[id].copy())
    pointer_row: ir_pointer_row(m)
    ir_checked_alloc_link(m, p, b)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    report_path: ir_test_env(m, b, "JET_NATIVE_TEST_REPORT_PATH")
    reporting: ir_test_present(m, b, report_path)
    ir_open_if(b.f, reporting, b.line)
    ir_test_report(m, b, report_path)
    ir_emit(b.f, IROp.Return, -1, -1, -1, -1, b.line)
    ir_end(b.f, b.line)
    if override >= 0 {
        ir_test_call_override(m, b, override)
        plan: ir_test_env(m, b, TEST_SETTINGS_PLAN_ENV)
        planning: ir_test_present(m, b, plan)
        ir_test_drop(m, b, plan)
        ir_open_if(b.f, planning, b.line)
        ir_test_exit(m, b, 0)
        ir_end(b.f, b.line)
    }
    records_path: ir_test_env(m, b, "JET_NATIVE_TEST_RECORDS_PATH")
    present: ir_test_present(m, b, records_path)
    missing: ir_temp(m, b, bool_row)
    ir_emit(b.f, IROp.Not, missing, present, -1, -1, b.line)
    ir_open_if(b.f, missing, b.line)
    ir_test_exit(m, b, 103)
    ir_end(b.f, b.line)
    // The checked contract clauses append their first hold and first failure
    // to the same records file (BuildContracts.jet ir_contract).
    _: ir_runtime(m, b, "jet_rt_test_contracts_open", [Int]{records_path}, -1)
    selected: ir_test_env(m, b, "JET_NATIVE_TEST_ID")
    filtered: ir_test_present(m, b, selected)
    tasks: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.StackAddress, tasks, 8 * (harness.tests.len() + 1), 8, -1, b.line)
    release: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.FunctionAddress, release, release_id, -1, -1, b.line)
    null: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.Const, null, 0, -1, -1, b.line)
    loop (index, test) in harness.tests {
        ir_emit(b.f, IROp.Store, -1, tasks, index * 8, null, b.line)
        // Unfiltered, every test runs; filtered, only the one named.
        run: ir_test_bool(m, b, true)
        ir_open_if(b.f, filtered, b.line)
        name: ir_test_text(m, b, "{test.id}")
        equal: ir_runtime(m, b, "jet_rt_string_eq", [Int]{selected, name}, bool_row)
        ir_test_drop(m, b, name)
        ir_emit(b.f, IROp.Copy, run, equal, -1, -1, b.line)
        ir_end(b.f, b.line)
        ir_open_if(b.f, run, b.line)
        code: ir_temp(m, b, pointer_row)
        ir_emit(b.f, IROp.FunctionAddress, code, units[index], -1, -1, b.line)
        handle: ir_runtime(m, b, "jet_rt_test_spawn", [Int]{null, code, release}, pointer_row)
        if harness.serial {
            ir_test_stream(m, b, handle, test.id, records_path)
        } else {
            ir_emit(b.f, IROp.Store, -1, tasks, index * 8, handle, b.line)
        }
        ir_end(b.f, b.line)
    }
    if !harness.serial {
        loop (index, test) in harness.tests {
            handle: ir_load_at(m, b, tasks, index * 8, pointer_row)
            exists: ir_test_present(m, b, handle)
            ir_open_if(b.f, exists, b.line)
            ir_test_stream(m, b, handle, test.id, records_path)
            ir_end(b.f, b.line)
        }
    }
    // Checks observe the process state the test bodies left. A selected
    // fatal-recovery child runs only its test, never the checks.
    if check_helpers.len() > 0 {
        unfiltered: ir_temp(m, b, bool_row)
        ir_emit(b.f, IROp.Not, unfiltered, filtered, -1, -1, b.line)
        ir_open_if(b.f, unfiltered, b.line)
        loop helper in check_helpers {
            operands: ir_args(b.f, [Int]{})
            ir_emit(b.f, IROp.Call, -1, helper, operands, 0, b.line)
            ir_stop_check(m, b)
        }
        ir_end(b.f, b.line)
    }
    ir_test_drop(m, b, selected)
    ir_test_drop(m, b, records_path)
    ir_emit(b.f, IROp.Return, -1, -1, -1, -1, b.line)
    ir_test_finish(m, p, b, id, failures)
    id
}

// A test's scope members (JetRuntime TestScope.jet), each region scoped by
// a frame address of its own as its scope id:
//   `.setup { … }`        runs in the enclosing scope (its bindings stay);
//   `.measure { … }`      the runtime's measurement loop (ir_measure_scope);
//   `.expect_fail(code?, message:?) { … }`  enter_scope(scope, code, message),
//                         the body, whose stop edges first try
//                         catch_for_scope (ir_stop_catches) and on a catch
//                         leave to the region's end; there catch_boundary,
//                         then leave_scope: no stop code is the unmet
//                         expectation (expect_fail_unmet stops);
//   `.timeout(d) { … }`   timeout_enter(scope, d.ns), the body, then
//                         timeout_leave: past its limit, timeout_failure;
//   `.skip { … }`         the body never runs; skip_scope(whole test: the
//                         member is the body's first statement).
ir_scope_member: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, statement: Int, kind: BodyScopeMemberKind, body: [Int], span: Span) Never! {
    if kind == {
        .Setup -> {
            loop inner in body {
                if ir_failed(b) -> break
                ir_stmt(m, p, b, inner)
            }
        }
        .Measure -> ir_measure_scope(m, p, b, body)
        .Skip -> {
            whole: b.row >= 0 && p.functions[b.row].body.len() > 0 && p.functions[b.row].body[0] == statement
            bool_row: ir_type_row(m, Type.Bool) ?? 0
            flag: ir_temp(m, b, bool_row)
            ir_emit(b.f, IROp.Const, flag, if whole -> 1 else -> 0, -1, -1, b.line)
            _: ir_runtime(m, b, "jet_rt_test_skip_scope", [Int]{flag}, -1)
        }
        .Timeout(duration) -> {
            word_row: ir_word_row(m)
            int_row: ir_type_row(m, Type.Int) ?? 0
            value: ir_expr(m, p, b, duration)
            if ir_failed(b) || value < 0 -> return
            ns: ir_runtime(m, b, "jet_rt_record_get_duration_ns", [Int]{value}, int_row)
            limit: ir_runtime(m, b, "jet_int_owned_to_i64", [Int]{ns}, word_row)
            ir_release(m, b, ns)
            ir_release(m, b, value)
            scope: ir_out_slot(m, b, 1)
            _: ir_runtime(m, b, "jet_rt_test_timeout_enter", [Int]{scope, limit}, -1)
            ir_stmts(m, p, b, body)
            if ir_failed(b) -> return
            timer: ir_out_slot(m, b, 2)
            bool_row: ir_type_row(m, Type.Bool) ?? 0
            timed: ir_runtime(m, b, "jet_rt_test_timeout_leave", [Int]{scope, timer}, bool_row)
            ir_open_if(b.f, timed, b.line)
            elapsed: ir_load_word(m, b, timer, 0)
            bound: ir_load_word(m, b, timer, 8)
            late: ir_bool_op(m, b, IROp.Gt, elapsed, bound)
            ir_open_if(b.f, late, b.line)
            _: ir_runtime(m, b, "jet_rt_test_timeout_failure", [Int]{elapsed, bound}, -1)
            ir_end(b.f, b.line)
            ir_end(b.f, b.line)
        }
        .ExpectFail(code, message) -> {
            word_row: ir_word_row(m)
            expected: if code == .Val(text) -> ir_dyn_text(m, b, text) else -> ir_word_const(m, b, 0)
            expected_message: if message == .Val(text) -> ir_dyn_text(m, b, text) else -> ir_word_const(m, b, 0)
            scope: ir_out_slot(m, b, 1)
            _: ir_runtime(m, b, "jet_rt_test_expect_fail_enter_scope", [Int]{scope, expected, expected_message}, -1)
            exit: ir_open(b.f, IROp.Block, b.line)
            b.catches.push(IRCatchFrame{scope: scope, exit: exit, mark: b.bindings.len(), transactions: b.transactions.len()})
            ir_stmts(m, p, b, body)
            _: b.catches.pop()
            ir_end(b.f, b.line)
            if ir_failed(b) -> return
            _: ir_runtime(m, b, "jet_rt_test_catch_boundary", [Int]{scope}, -1)
            stopped: ir_runtime(m, b, "jet_rt_test_expect_fail_leave_scope", [Int]{scope}, word_row)
            zero: ir_word_const(m, b, 0)
            unmet: ir_bool_op(m, b, IROp.Eq, stopped, zero)
            ir_open_if(b.f, unmet, b.line)
            _: ir_runtime(m, b, "jet_rt_test_expect_fail_unmet", [Int]{expected, expected_message}, -1)
            ir_end(b.f, b.line)
            _: ir_runtime(m, b, "jet_rt_string_drop", [Int]{stopped}, -1)
        }
    }
}
