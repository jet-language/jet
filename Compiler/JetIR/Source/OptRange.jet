// Integer ranges (pass "range"; at O0 the one pass, Opt.jet
// ir_opt_module_facts), on a function's SSA form before it leaves SSA: the
// range [lo, hi] of every Int and word value (a 64-bit word by its signed
// bits), and from it the reads that can never meet a big integer and the
// comparisons the ranges decide.
//
// A constant is itself; Copy and Move keep their operand's range; Add, Sub,
// Mul and Neg are interval arithmetic; FloorDiv, Div, Mod and Rem by a
// positive divisor and BitAnd with a constant bound their result (a
// nonnegative constant from above, a negative one from below by the bits it
// clears); a phi is the union of its arguments, each read at the end of its
// edge's block; anything else (a parameter, a load, a call) is unbounded.
// A word narrower than 64 bits lies in its type's bounds; only a constant,
// a copy or a phi inside them narrows it further.
// A read is narrowed by the compares deciding the branches that dominate it:
// an If's arms and a BrIf's fall-through (below `br_if !(i < n)`, `i < n`),
// and by the IntBig guards (OptVersion.jet) whose failure it lies below
// (below `br_if int_big(x, bits)`, x is inline and within `bits` signed
// bits).
// The ranges are an ascending fixpoint in which a phi bound still growing
// after IR_RANGE_WIDEN rounds widens to unbounded, then IR_RANGE_NARROW
// descending rounds win back the bounds the loop tests imply.
//
// A bound is an inline Int (only a word constant past them is not), so
// ranging allocates no big integers. The sentinels IR_RANGE_LOW and
// IR_RANGE_HIGH are the ends of the inline Ints [-2^62, 2^62 - 1]. A low
// bound at IR_RANGE_LOW, or a high bound at IR_RANGE_HIGH, means unbounded,
// unless the range is marked inline (IRRange.inline); then every bound is
// taken as written. A range is inline when it is marked or lies strictly
// between the sentinels. An inline word range is exact for its bits (word
// arithmetic on it cannot wrap). The mark comes from a failed IntBig guard,
// a constant, a copy, a phi of inline arguments, a bit operation of inline
// operands and a division of an inline dividend by an inline positive
// divisor. A computed bound past a sentinel stops at it, which keeps it a
// bound on that side. An unsigned word's comparison or division is read
// through the ranges only when its operands are nonnegative.
//
// An inline Int (bits 63 and 62 agree, X64Select) is the i64 itself and owns
// nothing. For an Int whose range is inline: its
// Drop is nothing (a Nop), its Copy is a Move, and jet_int_owned_to_i64,
// jet_int_native_i64_at or jet_rt_int_clone of it is a Move, as is
// jet_int_checked_fixed of it when
// it lies inside the fixed-width kind (the stop poll after that call, which
// nothing can reach now, goes); an Int Add, Sub or Mul whose operands and
// result are inline, a word Add, Sub or Mul whose operands and result are
// inline and inside the word's type (an unsigned word's all nonnegative), a
// Div, Rem, FloorDiv or Mod of inline Int operands by a positive divisor,
// an Int BitAnd, BitOr or BitXor of inline operands (its result is inline
// too), a word Shl or Shr whose count lies inside 0..<bits, and an Int
// comparison of inline operands, are marked IR_OVERFLOW_WRAP (X64Select:
// the plain instruction, for such a division no divisor checks, and for
// such a shift no count check, so no jet_rt_fixed_shift_stop; the trap poll
// after a word operation or the division, which nothing can reach now,
// goes); such an Int Div or Rem of a nonnegative dividend is marked
// IR_OVERFLOW_NONNEG instead (X64Select drops its negative-dividend
// correction). An Int Add, Sub or Mul of inline operands
// whose result may not be inline is marked IR_OVERFLOW_OPERANDS (X64Select
// tests only the result), and one with a single operand proven inline
// IR_OVERFLOW_LEFT or IR_OVERFLOW_RIGHT (X64Select skips that operand's
// test). An IntBig of an inline Int is false. A FloorDiv or Mod of a
// nonnegative dividend by a positive divisor other than a constant 2^k, Int
// or word, inline or not, is the Div or Rem. A comparison the ranges decide
// (an Int's by whichever bounds it has, even one-sided), or the comparisons
// dominating it decide (ir_range_implied), becomes its constant. Returns
// the rewritten instructions; `f` and `s` stay one SSA form but for the
// stop points gone (Opt.jet ir_opt_ssa then ranges the function once more).

use jet_foundation.[name_rows_value]

// The sentinels: the ends of the inline Ints.
IR_RANGE_LOW: -4611686018427387904
IR_RANGE_HIGH: 4611686018427387903
IR_RANGE_WIDEN: 3
IR_RANGE_ROUNDS: 40
IR_RANGE_NARROW: 2
// Dominating blocks a read's narrowing looks through, and the largest form
// analyzed (values).
IR_RANGE_DEPTH: 64
IR_RANGE_VALUES: 20000

IRRange: struct {
    known: Bool
    lo: Int
    hi: Int
    // Whether the value is an inline Int (a word: by its signed bits), each
    // bound then taken as written, even at a sentinel.
    inline: Bool
}

IRRanges: struct {
    // Per value: whether it has a range (an Int or a word), whether it is
    // an Int, whether it is an unsigned word, whether it is a word narrower
    // than 64 bits (its range is its type's: its arithmetic wraps or stops
    // at its width), its type's bounds, and its range so far.
    ranged: [Bool]
    exact: [Bool]
    unsigned: [Bool]
    narrow: [Bool]
    cap_lo: [Int]
    cap_hi: [Int]
    known: [Bool]
    lo: [Int]
    hi: [Int]
    inline: [Bool]
    // Per block: the value of the condition its entry decides (-1: none),
    // whether the condition holds there (else it fails), and the nearest
    // block at or above it in the dominator tree that decides one (-1:
    // none).
    cond: [Int]
    holds: [Bool]
    up: [Int]
    // Per value: the block of its write, and whether a deciding condition
    // compares it (else no branch narrows it).
    home: [Int]
    tested: [Bool]
    // Per value: whether it is a load of a List header's length (its first
    // word), a count of elements held in memory.
    lengths: [Bool]
}

ir_range_top: fn() -> IRRange Never! {
    IRRange{known: true, lo: IR_RANGE_LOW, hi: IR_RANGE_HIGH, inline: false}
}

ir_range_none: fn() -> IRRange Never! {
    IRRange{known: false, lo: 0, hi: 0, inline: false}
}

ir_range_make: fn(lo: Int, hi: Int) -> IRRange Never! {
    IRRange{known: true, lo: if lo <= IR_RANGE_LOW -> IR_RANGE_LOW else -> lo, hi: if hi >= IR_RANGE_HIGH -> IR_RANGE_HIGH else -> hi, inline: false}
}

// Value `value`'s range so far.
ir_range_so_far: fn(r: IRRanges, value: Int) -> IRRange Never! {
    IRRange{known: r.known[value], lo: r.lo[value], hi: r.hi[value], inline: r.inline[value]}
}

ir_range_inline: fn(r: IRRange) -> Bool Never! {
    r.known && r.lo <= r.hi && (r.inline || (r.lo > IR_RANGE_LOW && r.hi < IR_RANGE_HIGH))
}

// Whether every value of `r` is an inline Int of `bits` signed bits (an
// IntBig of that width is false).
ir_range_within: fn(r: IRRange, bits: Int) -> Bool Never! {
    if bits >= IR_INT_INLINE_BITS -> return ir_range_inline(r)
    r.known && r.lo <= r.hi && r.lo >= 0 - (1 << (bits - 1)) && r.hi <= (1 << (bits - 1)) - 1
}

ir_range_bounded: fn(r: IRRange) -> Bool Never! {
    r.inline || (r.lo > IR_RANGE_LOW && r.hi < IR_RANGE_HIGH)
}

ir_range_has_lo: fn(r: IRRange) -> Bool Never! {
    r.inline || r.lo > IR_RANGE_LOW
}

ir_range_has_hi: fn(r: IRRange) -> Bool Never! {
    r.inline || r.hi < IR_RANGE_HIGH
}

// x + y for bounds x and y, stopped at the sentinels.
ir_range_add: fn(x: Int, y: Int) -> Int Never! {
    if x > 0 && y > 0 && x > IR_RANGE_HIGH - y -> return IR_RANGE_HIGH
    if x < 0 && y < 0 && x < IR_RANGE_LOW - y -> return IR_RANGE_LOW
    x + y
}

// x * y for bounds x and y, stopped at the sentinels.
ir_range_mul: fn(x: Int, y: Int) -> Int Never! {
    if x == 0 || y == 0 -> return 0
    over: if (x < 0) == (y < 0) -> IR_RANGE_HIGH else -> IR_RANGE_LOW
    if x == IR_RANGE_LOW || y == IR_RANGE_LOW -> return over
    x_size: if x < 0 -> 0 - x else -> x
    y_size: if y < 0 -> 0 - y else -> y
    if x_size > IR_RANGE_HIGH /% y_size -> return over
    x * y
}

// -x for a bound x, stopped at IR_RANGE_HIGH (-IR_RANGE_LOW is past it).
ir_range_neg: fn(x: Int) -> Int Never! {
    if x <= IR_RANGE_LOW -> IR_RANGE_HIGH else -> 0 - x
}

// Whether x + y for inline bounds x and y is itself inline (ir_range_add
// stops nothing).
ir_range_fits: fn(x: Int, y: Int) -> Bool Never! {
    if x > 0 && y > 0 -> return x <= IR_RANGE_HIGH - y
    if x < 0 && y < 0 -> return x >= IR_RANGE_LOW - y
    true
}

// Whether a + b (or a - b) of inline operands has inline bounds on both
// ends: ir_range_binary then gives them as they are, so the sum is inline.
ir_range_sum_inline: fn(op: IROp, a: IRRange, b: IRRange) -> Bool Never! {
    if !ir_range_inline(a) || !ir_range_inline(b) -> return false
    if op == .Add -> return ir_range_fits(a.lo, b.lo) && ir_range_fits(a.hi, b.hi)
    if op != .Sub || b.lo <= IR_RANGE_LOW -> return false
    ir_range_fits(a.lo, 0 - b.hi) && ir_range_fits(a.hi, 0 - b.lo)
}

// Whether value `used` (-1: none) has a range.
ir_range_has: fn(s: IRSsa, r: IRRanges, used: Int) -> Bool Never! {
    used >= 0 && r.ranged[ir_ssa_find(s, used)]
}

ir_range_is_compare: fn(op: IROp) -> Bool Never! {
    op == .Lt || op == .Le || op == .Gt || op == .Ge || op == .Eq || op == .Ne
}

// Whether function `f` has an Int or word slot (a value with a range).
ir_range_wanted: fn(m: IRModule, f: IRFunction) -> Bool Never! {
    loop row in f.slot_type {
        kind: m.types[row].kind
        if kind == .Int || kind == .Word -> return true
    }
    false
}

// Whether instruction `at` loads a List header's length: its first word,
// through a slot of a List type.
ir_range_length_load: fn(m: IRModule, f: IRFunction, at: Int) -> Bool Never! {
    if f.op[at] != .Load || f.b[at] != 0 || f.a[at] < 0 || f.a[at] >= f.slot_type.len() -> return false
    ir_untag(m.types[f.slot_type[f.a[at]]].ty) == .List(_)
}

ir_opt_int_facts: fn(m: IRModule, f: &IRFunction, s: &IRSsa) -> Int Never! {
    count: s.val_slot.len()
    if count == 0 || count > IR_RANGE_VALUES -> return 0
    r := IRRanges{ranged: [Bool]{}, exact: [Bool]{}, unsigned: [Bool]{}, narrow: [Bool]{}, cap_lo: [Int]{}, cap_hi: [Int]{}, known: [Bool]{}, lo: [Int]{}, hi: [Int]{}, inline: [Bool]{}, cond: [Int]{}, holds: [Bool]{}, up: [Int]{}, home: [Int]{}, tested: [Bool]{}, lengths: [Bool]{}}
    any := false
    loop value in 0..<count {
        ty: m.types[f.slot_type[s.val_slot[value]]]
        exact: ty.kind == .Int
        word: ty.kind == .Word
        narrow: word && ty.bits > 0 && ty.bits < 64
        if exact || word -> any = true
        r.ranged.push(exact || word)
        r.exact.push(exact)
        r.unsigned.push(word && !ty.signed)
        r.narrow.push(narrow)
        cap_lo: if {
            !narrow -> IR_RANGE_LOW
            ty.signed -> 0 - (1 << (ty.bits - 1))
            else -> 0
        }
        cap_hi: if {
            !narrow -> IR_RANGE_HIGH
            ty.signed -> (1 << (ty.bits - 1)) - 1
            else -> (1 << ty.bits) - 1
        }
        r.cap_lo.push(cap_lo)
        r.cap_hi.push(cap_hi)
        r.known.push(false)
        r.lo.push(0)
        r.hi.push(0)
        r.inline.push(false)
        kind: s.val_kind[value]
        home: if kind == .Def -> s.block[s.val_at[value]] else if kind == .Phi -> s.join_block[s.phi_join[s.val_at[value]]] else -> 0
        r.home.push(home)
        r.tested.push(false)
        r.lengths.push((exact || word) && !narrow && kind == .Def && ir_range_length_load(m, f, s.val_at[value]))
    }
    if !any -> return 0
    loop _ in 0..<s.preds.len() {
        r.cond.push(-1)
        r.holds.push(false)
        r.up.push(-1)
    }
    ir_range_conditions(f, s, r)
    // Ascending rounds, widening late phi growth.
    round := 0
    changed := true
    loop changed && round < IR_RANGE_ROUNDS {
        changed = false
        loop value in 0..<count {
            if !r.ranged[value] || ir_ssa_find(s, value) != value -> next
            got: ir_range_eval(f, s, r, value)
            if !got.known -> next
            if !r.known[value] {
                r.known[value] = true
                r.lo[value] = got.lo
                r.hi[value] = got.hi
                r.inline[value] = got.inline
                changed = true
                next
            }
            // The union: inline when both sides are.
            mark: ir_range_inline(ir_range_so_far(r, value)) && ir_range_inline(got)
            lo := if got.lo < r.lo[value] -> got.lo else -> r.lo[value]
            hi := if got.hi > r.hi[value] -> got.hi else -> r.hi[value]
            if lo == r.lo[value] && hi == r.hi[value] && mark == r.inline[value] -> next
            if s.val_kind[value] == .Phi && round >= IR_RANGE_WIDEN {
                if lo < r.lo[value] -> lo = IR_RANGE_LOW
                if hi > r.hi[value] -> hi = IR_RANGE_HIGH
            }
            r.lo[value] = lo
            r.hi[value] = hi
            r.inline[value] = mark
            changed = true
        }
        round += 1
    }
    if changed -> return 0
    // Descending rounds from the post-fixpoint, and again from the bounds
    // of the counted loops' accumulators.
    ir_range_descend(f, s, r, count)
    if ir_range_counted(f, s, r) -> ir_range_descend(f, s, r, count)
    ir_range_rewrite(m, f, s, r)
}

ir_range_descend: fn(f: IRFunction, s: IRSsa, r: &IRRanges, count: Int) Never! {
    loop _ in 0..<IR_RANGE_NARROW {
        loop value in 0..<count {
            if !r.ranged[value] || !r.known[value] || ir_ssa_find(s, value) != value -> next
            got: ir_range_eval(f, s, r, value)
            if !got.known || got.lo > got.hi -> next
            // The intersection: inline when either side is.
            mark: ir_range_inline(ir_range_so_far(r, value)) || ir_range_inline(got)
            if got.lo > r.lo[value] -> r.lo[value] = got.lo
            if got.hi < r.hi[value] -> r.hi[value] = got.hi
            r.inline[value] = mark
        }
    }
}

// The accumulators of counted loops: a signed phi still unbounded whose
// join has two edges, on one of them (the back edge) its own value plus d,
// where a bounded signed phi of the same join (the counter) gets its own
// value plus 1. Each pass of the back edge adds 1 to the counter and d to
// the accumulator, so after k passes the accumulator lies within its entry
// value plus k times d's range, where k is at most the counter's high bound
// less its entry's low bound. Returns whether any accumulator was bounded.
ir_range_counted: fn(f: IRFunction, s: IRSsa, r: &IRRanges) -> Bool Never! {
    found := false
    loop value in 0..<r.ranged.len() {
        if !ir_range_counted_phi(s, r, value) || ir_range_bounded(ir_range_so_far(r, value)) -> next
        phi: s.val_at[value]
        join: s.phi_join[phi]
        if s.join_edges[join].len() != 2 -> next
        loop back in 0..<2 {
            add: ir_range_step(f, s, r, value, ir_ssa_phi_arg(s, phi, back))
            if add < 0 -> next
            d: ir_range_step_by(f, s, r, value, add)
            if !d.known || !ir_range_bounded(d) -> next
            entry: 1 - back
            start: ir_range_at(f, s, r, ir_ssa_phi_arg(s, phi, entry), s.edge_block[s.join_edges[join][entry]])
            if !start.known || !ir_range_bounded(start) -> next
            passes: ir_range_passes(f, s, r, join, back)
            if passes < 0 || passes >= IR_RANGE_HIGH -> next
            step_lo: if d.lo < 0 -> ir_range_mul(passes, d.lo) else -> 0
            step_hi: if d.hi > 0 -> ir_range_mul(passes, d.hi) else -> 0
            if step_lo <= IR_RANGE_LOW || step_hi >= IR_RANGE_HIGH -> next
            lo: ir_range_add(start.lo, step_lo)
            hi: ir_range_add(start.hi, step_hi)
            if lo > r.lo[value] -> r.lo[value] = lo
            if hi < r.hi[value] -> r.hi[value] = hi
            found = true
        }
    }
    found
}

// Whether value `value` is a known phi of a signed 64-bit word or an Int.
ir_range_counted_phi: fn(s: IRSsa, r: IRRanges, value: Int) -> Bool Never! {
    r.ranged[value] && !r.narrow[value] && !r.unsigned[value] && r.known[value] && s.val_kind[value] == .Phi && ir_ssa_find(s, value) == value
}

// The most passes the back edge `back` of `join` can make in a row: over
// the counters of the join (ir_range_counted), the fewest; -1 when none is.
ir_range_passes: fn(f: IRFunction, s: IRSsa, r: IRRanges, join: Int, back: Int) -> Int Never! {
    best := -1
    entry: 1 - back
    loop value in 0..<r.ranged.len() {
        if !ir_range_counted_phi(s, r, value) || s.phi_join[s.val_at[value]] != join || !ir_range_bounded(ir_range_so_far(r, value)) -> next
        phi: s.val_at[value]
        add: ir_range_step(f, s, r, value, ir_ssa_phi_arg(s, phi, back))
        if add < 0 -> next
        c: ir_range_step_by(f, s, r, value, add)
        if !c.known || c.lo != 1 || c.hi != 1 -> next
        start: ir_range_at(f, s, r, ir_ssa_phi_arg(s, phi, entry), s.edge_block[s.join_edges[join][entry]])
        if !start.known || !ir_range_bounded(start) -> next
        passes: if {
            r.hi[value] < start.lo -> 0
            start.lo <= IR_RANGE_LOW -> IR_RANGE_HIGH
            else -> ir_range_add(r.hi[value], 0 - start.lo)
        }
        if best < 0 || passes < best -> best = passes
    }
    best
}

// The Add that value `used` holds, through Copies and Moves of its own kind,
// when one of its operands is (so held) the phi `value`: its instruction,
// else -1.
ir_range_step: fn(f: IRFunction, s: IRSsa, r: IRRanges, value: Int, used: Int) -> Int Never! {
    if used < 0 -> return -1
    held: ir_range_held(f, s, r, ir_ssa_find(s, used))
    if s.val_kind[held] != .Def -> return -1
    at: s.val_at[held]
    if f.op[at] != .Add || s.use_a[at] < 0 || s.use_b[at] < 0 -> return -1
    if ir_range_held(f, s, r, ir_ssa_find(s, s.use_a[at])) == value || ir_range_held(f, s, r, ir_ssa_find(s, s.use_b[at])) == value -> return at
    return -1
}

// The range of the operand of Add `at` (ir_range_step) that is not phi
// `value`, read where the Add is.
ir_range_step_by: fn(f: IRFunction, s: IRSsa, r: IRRanges, value: Int, at: Int) -> IRRange Never! {
    other: if ir_range_held(f, s, r, ir_ssa_find(s, s.use_a[at])) == value -> s.use_b[at] else -> s.use_a[at]
    if !ir_range_has(s, r, other) -> return ir_range_none()
    ir_range_at(f, s, r, other, s.block[at])
}

// The value `value` copies, through Copies and Moves between two Ints or
// two signed 64-bit words.
ir_range_held: fn(f: IRFunction, s: IRSsa, r: IRRanges, value_in: Int) -> Int Never! {
    value := value_in
    steps := 0
    loop steps < IR_RANGE_DEPTH && s.val_kind[value] == .Def {
        at: s.val_at[value]
        if !(f.op[at] == .Copy || f.op[at] == .Move) || s.use_a[at] < 0 -> return value
        from: ir_ssa_find(s, s.use_a[at])
        if !r.ranged[from] || r.narrow[from] || r.narrow[value] || r.unsigned[from] || r.unsigned[value] || r.exact[from] != r.exact[value] -> return value
        value = from
        steps += 1
    }
    value
}

// Each block entered through a decided branch: an If's arms, a BrIf's
// fall-through; then each block's nearest deciding dominator (blocks are
// numbered after their immediate dominators).
ir_range_conditions: fn(f: IRFunction, s: IRSsa, r: &IRRanges) Never! {
    loop at in 0..<f.op.len() {
        if s.block[at] < 0 || at + 1 >= f.op.len() -> next
        op: f.op[at]
        if op == .If && s.use_a[at] >= 0 {
            ir_range_decide(f, s, r, at + 1, s.use_a[at], true)
            if f.b[at] >= 0 && f.b[at] + 1 < f.op.len() -> ir_range_decide(f, s, r, f.b[at] + 1, s.use_a[at], false)
            // An If without an Else whose body never falls through (a stop
            // point): the code after its End runs only when the condition
            // failed (ir_range_decide's one-predecessor test).
            if f.b[at] < 0 && f.c[at] + 1 < f.op.len() -> ir_range_decide(f, s, r, f.c[at] + 1, s.use_a[at], false)
        }
        if op == .BrIf && s.use_a[at] >= 0 -> ir_range_decide(f, s, r, at + 1, s.use_a[at], false)
    }
    loop block in 1..<s.preds.len() {
        if r.cond[block] >= 0 {
            r.up[block] = block
        } else if s.idom[block] >= 0 && s.idom[block] < block {
            r.up[block] = r.up[s.idom[block]]
        }
    }
}

// Block `at`'s entry decides `cond`; the values the comparison under its
// Nots compares are tested (ir_range_narrow reads through the same Nots).
ir_range_decide: fn(f: IRFunction, s: IRSsa, r: &IRRanges, at: Int, cond: Int, holds: Bool) Never! {
    block: s.block[at]
    if block <= 0 || s.preds[block].len() != 1 -> return
    r.cond[block] = ir_ssa_find(s, cond)
    r.holds[block] = holds
    test := r.cond[block]
    loop s.val_kind[test] == .Def {
        def: s.val_at[test]
        op: f.op[def]
        if op == .Not && s.use_a[def] >= 0 {
            test = ir_ssa_find(s, s.use_a[def])
            next
        }
        if op == .IntBig && s.use_a[def] >= 0 -> r.tested[ir_ssa_find(s, s.use_a[def])] = true
        if ir_range_is_compare(op) && s.use_a[def] >= 0 && s.use_b[def] >= 0 {
            r.tested[ir_ssa_find(s, s.use_a[def])] = true
            r.tested[ir_ssa_find(s, s.use_b[def])] = true
        }
        break
    }
}

// The range of value `used` read in `block`, narrowed by the decided
// branches dominating it below the value's write: up to IR_RANGE_DEPTH of
// them, nearest first.
ir_range_at: fn(f: IRFunction, s: IRSsa, r: IRRanges, used: Int, block: Int) -> IRRange Never! {
    if used < 0 -> return ir_range_top()
    value: ir_ssa_find(s, used)
    if !r.ranged[value] || s.val_kind[value] == .Undef -> return ir_range_top()
    if !r.known[value] -> return ir_range_none()
    out := ir_range_so_far(r, value)
    if !r.tested[value] || block <= 0 -> return out
    home: r.home[value]
    at := r.up[block]
    steps := 0
    loop out.known && at > 0 && steps < IR_RANGE_DEPTH {
        if home >= 0 && ir_ssa_dominates(s, at, home) -> break
        out = ir_range_narrow(f, s, r, out.lo, out.hi, out.inline, value, r.cond[at], r.holds[at])
        at = if s.idom[at] >= 0 && s.idom[at] < at -> r.up[s.idom[at]] else -> -1
        steps += 1
    }
    out
}

// [lo_in, hi_in] (the range of `value`, inline as `inline_in` says)
// narrowed by condition `cond` holding or not; unknown when nothing is left.
ir_range_narrow: fn(f: IRFunction, s: IRSsa, r: IRRanges, lo_in: Int, hi_in: Int, inline_in: Bool, value: Int, cond: Int, holds: Bool) -> IRRange Never! {
    same: IRRange{known: true, lo: lo_in, hi: hi_in, inline: inline_in}
    if s.val_kind[cond] != .Def -> return same
    at: s.val_at[cond]
    op: f.op[at]
    if op == .Not && s.use_a[at] >= 0 -> return ir_range_narrow(f, s, r, lo_in, hi_in, inline_in, value, ir_ssa_find(s, s.use_a[at]), !holds)
    // Below a failed IntBig guard of `value`, it is inline: its bounds hold
    // as written, within the guard's width.
    if op == .IntBig {
        if holds || s.use_a[at] < 0 || ir_ssa_find(s, s.use_a[at]) != value || !r.exact[value] -> return same
        lo := lo_in
        hi := hi_in
        if f.b[at] < IR_INT_INLINE_BITS {
            width_lo: 0 - (1 << (f.b[at] - 1))
            width_hi: (1 << (f.b[at] - 1)) - 1
            if lo < width_lo -> lo = width_lo
            if hi > width_hi -> hi = width_hi
        }
        if lo > hi -> return ir_range_none()
        return IRRange{known: true, lo: lo, hi: hi, inline: true}
    }
    if !ir_range_is_compare(op) || s.use_a[at] < 0 || s.use_b[at] < 0 -> return same
    left: ir_ssa_find(s, s.use_a[at])
    right: ir_ssa_find(s, s.use_b[at])
    if left == right -> return same
    if left != value && right != value -> return same
    other: if left == value -> right else -> left
    if !r.ranged[other] || !r.known[other] || s.val_kind[other] == .Undef -> return same
    // An unsigned order is the signed one on nonnegative operands only.
    if (r.unsigned[value] || r.unsigned[other]) && (lo_in < 0 || r.lo[other] < 0) -> return same
    // value `rel` other.
    rel := if left == value -> op else -> ir_range_swap(op)
    if !holds -> rel = ir_range_negate(rel)
    // A side holds as written when its range is inline or it is not at its
    // sentinel; the narrowed range is inline when both its sides do.
    other_lo: r.inline[other] || r.lo[other] > IR_RANGE_LOW
    other_hi: r.inline[other] || r.hi[other] < IR_RANGE_HIGH
    lo := lo_in
    hi := hi_in
    real_lo := inline_in || lo_in > IR_RANGE_LOW
    real_hi := inline_in || hi_in < IR_RANGE_HIGH
    if rel == {
        .Lt -> {
            if other_hi && r.hi[other] > IR_RANGE_LOW && r.hi[other] - 1 <= hi {
                hi = r.hi[other] - 1
                real_hi = true
            }
        }
        .Le -> {
            if other_hi && r.hi[other] <= hi {
                hi = r.hi[other]
                real_hi = true
            }
        }
        .Gt -> {
            if other_lo && r.lo[other] < IR_RANGE_HIGH && r.lo[other] + 1 >= lo {
                lo = r.lo[other] + 1
                real_lo = true
            }
        }
        .Ge -> {
            if other_lo && r.lo[other] >= lo {
                lo = r.lo[other]
                real_lo = true
            }
        }
        .Eq -> {
            if other_hi && r.hi[other] <= hi {
                hi = r.hi[other]
                real_hi = true
            }
            if other_lo && r.lo[other] >= lo {
                lo = r.lo[other]
                real_lo = true
            }
        }
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Ne | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> {}
    }
    if lo > hi -> return ir_range_none()
    IRRange{known: true, lo: lo, hi: hi, inline: real_lo && real_hi}
}

// `a op b` as `b op' a`.
ir_range_swap: fn(op: IROp) -> IROp Never! {
    if op == {
        .Lt -> IROp.Gt
        .Le -> IROp.Ge
        .Gt -> IROp.Lt
        .Ge -> IROp.Le
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> op
    }
}

ir_range_negate: fn(op: IROp) -> IROp Never! {
    if op == {
        .Lt -> IROp.Ge
        .Le -> IROp.Gt
        .Gt -> IROp.Le
        .Ge -> IROp.Lt
        .Eq -> IROp.Ne
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Ne | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> IROp.Eq
    }
}

// The range of `value`'s write. A narrow word's is its type's unless it is a
// constant, a copy or a phi already inside the type (its arithmetic wraps or
// stops at its width, and a copy into it from a wider value truncates).
ir_range_eval: fn(f: IRFunction, s: IRSsa, r: IRRanges, value: Int) -> IRRange Never! {
    if !r.narrow[value] -> return ir_range_write(f, s, r, value)
    cap: ir_range_make(r.cap_lo[value], r.cap_hi[value])
    kind: s.val_kind[value]
    if kind != .Def && kind != .Phi -> return cap
    if kind == .Def {
        op: f.op[s.val_at[value]]
        if op != .Const && op != .Copy && op != .Move -> return cap
    }
    got: ir_range_write(f, s, r, value)
    if got.known && (got.lo < cap.lo || got.hi > cap.hi) -> return cap
    got
}

ir_range_write: fn(f: IRFunction, s: IRSsa, r: IRRanges, value: Int) -> IRRange Never! {
    kind: s.val_kind[value]
    if kind == .Phi -> return ir_range_phi(f, s, r, s.val_at[value])
    if kind != .Def -> return ir_range_top()
    // Memory holds fewer than 2^62 - 1 elements of any list.
    if r.lengths[value] -> return ir_range_make(0, IR_RANGE_HIGH - 1)
    at: s.val_at[value]
    block: s.block[at]
    op: f.op[at]
    if op == {
        // A constant inside the inline Ints (an Int constant always is) is
        // an inline one.
        .Const -> {
            c: f.a[at]
            if c < IR_RANGE_LOW || c > IR_RANGE_HIGH -> return ir_range_make(c, c)
            IRRange{known: true, lo: c, hi: c, inline: true}
        }
        .Copy | .Move -> {
            if !ir_range_has(s, r, s.use_a[at]) -> return ir_range_top()
            a: ir_range_at(f, s, r, s.use_a[at], block)
            // An unsigned 64-bit word past 2^63 is negative in its bits.
            if a.known && a.lo < 0 && r.unsigned[ir_ssa_find(s, s.use_a[at])] && !r.unsigned[value] -> return ir_range_top()
            a
        }
        .Neg -> {
            if !ir_range_has(s, r, s.use_a[at]) -> return ir_range_top()
            a: ir_range_at(f, s, r, s.use_a[at], block)
            if !a.known -> return a
            ir_range_make(if !ir_range_has_hi(a) -> IR_RANGE_LOW else -> ir_range_neg(a.hi), if !ir_range_has_lo(a) || a.lo <= IR_RANGE_LOW -> IR_RANGE_HIGH else -> 0 - a.lo)
        }
        .Add | .Sub | .Mul | .FloorDiv | .Div | .Mod | .Rem | .BitAnd -> {
            if !ir_range_has(s, r, s.use_a[at]) || !ir_range_has(s, r, s.use_b[at]) -> return ir_range_top()
            a: ir_range_at(f, s, r, s.use_a[at], block)
            b: ir_range_at(f, s, r, s.use_b[at], block)
            if !a.known || !b.known -> return ir_range_none()
            // A bit operation of inline operands is inline; so is a division
            // of an inline dividend by an inline positive divisor, which is no
            // larger than the dividend (a remainder, than the divisor), and a
            // sum or difference whose bounds are inline.
            mark: ir_range_inline(a) && ir_range_inline(b)
            if op == .BitAnd {
                masked: ir_range_mask(a, b)
                return IRRange{known: masked.known, lo: masked.lo, hi: masked.hi, inline: masked.known && mark}
            }
            // An unsigned word divides its bits as unsigned.
            division: op == .FloorDiv || op == .Div || op == .Mod || op == .Rem
            if division && r.unsigned[value] && a.lo < 0 -> return ir_range_top()
            got := ir_range_binary(op, a, b)
            // Two nonnegative Int factors, not both bounded: at least the
            // product of their low bounds.
            if op == .Mul && r.exact[value] && !(ir_range_bounded(a) && ir_range_bounded(b)) && ir_range_has_lo(a) && ir_range_has_lo(b) && a.lo >= 0 && b.lo >= 0 -> got = ir_range_make(ir_range_mul(a.lo, b.lo), IR_RANGE_HIGH)
            IRRange{known: got.known, lo: got.lo, hi: got.hi, inline: got.known && ((division && mark && b.lo > 0) || ir_range_sum_inline(op, a, b))}
        }
        .BitOr | .BitXor | .Shl | .Shr -> {
            if !ir_range_has(s, r, s.use_a[at]) || !ir_range_has(s, r, s.use_b[at]) -> return ir_range_top()
            a: ir_range_at(f, s, r, s.use_a[at], block)
            b: ir_range_at(f, s, r, s.use_b[at], block)
            if !a.known || !b.known -> return ir_range_none()
            if op == .BitOr || op == .BitXor -> return ir_range_bits(op, a, b)
            ir_range_shift(op, a, b)
        }
        .Nop | .ConstText | .ConstBigInt | .Drop | .Close | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> ir_range_top()
    }
}

// `a & b`: within [0, c] when either side is a constant c >= 0. With a
// constant c < 0 the other side loses at most the bits ~c holds: within
// [lo + c + 1, hi], and for c = -2^j, which rounds down to a multiple of
// 2^j, within [lo & c, hi & c].
ir_range_mask: fn(a: IRRange, b: IRRange) -> IRRange Never! {
    if b.lo == b.hi && b.lo >= 0 -> return ir_range_make(0, b.lo)
    if a.lo == a.hi && a.lo >= 0 -> return ir_range_make(0, a.lo)
    if a.lo >= 0 && b.lo >= 0 -> return ir_range_make(0, if a.hi < b.hi -> a.hi else -> b.hi)
    if b.lo == b.hi && b.lo < 0 && b.lo > IR_RANGE_LOW -> return ir_range_cleared(a, b.lo)
    if a.lo == a.hi && a.lo < 0 && a.lo > IR_RANGE_LOW -> return ir_range_cleared(b, a.lo)
    ir_range_top()
}

// `a & c` for a constant c < 0 (ir_range_mask); an unbounded end stays so.
ir_range_cleared: fn(a: IRRange, c: Int) -> IRRange Never! {
    power: 0 - c
    rounds: power.bit_and(power - 1) == 0
    lo := IR_RANGE_LOW
    if ir_range_has_lo(a) -> lo = if rounds -> a.lo.bit_and(c) else -> ir_range_add(a.lo, c + 1)
    hi := IR_RANGE_HIGH
    if ir_range_has_hi(a) -> hi = if rounds -> a.hi.bit_and(c) else -> a.hi
    ir_range_make(lo, hi)
}

// `a | b` and `a ^ b` of nonnegative sides with high bounds: within
// [0, 2^k - 1] for the least k whose 2^k exceeds both highs; an `|` is no
// smaller than either side.
ir_range_bits: fn(op: IROp, a: IRRange, b: IRRange) -> IRRange Never! {
    if !ir_range_has_lo(a) || !ir_range_has_lo(b) || a.lo < 0 || b.lo < 0 || !ir_range_has_hi(a) || !ir_range_has_hi(b) -> return ir_range_top()
    high: if a.hi > b.hi -> a.hi else -> b.hi
    ones := 0
    loop ones < high {
        ones = ones * 2 + 1
    }
    low: if {
        op != .BitOr -> 0
        a.lo > b.lo -> a.lo
        else -> b.lo
    }
    ir_range_make(low, ones)
}

// `a << n` and `a >> n` of a nonnegative `a` by counts within [0, 62]: its
// ends shifted. To the left the high end stays below the sentinels, so no
// bit leaves even a wrapping word's 64 and the shift is exact; to the right
// a nonnegative word shifts alike signed or not.
ir_range_shift: fn(op: IROp, a: IRRange, n: IRRange) -> IRRange Never! {
    if !ir_range_has_lo(a) || a.lo < 0 || !ir_range_bounded(n) || n.lo < 0 || n.hi > 62 -> return ir_range_top()
    if op == .Shr -> return ir_range_make(a.lo >> n.hi, if ir_range_has_hi(a) -> a.hi >> n.lo else -> IR_RANGE_HIGH)
    if !ir_range_has_hi(a) || a.hi > (IR_RANGE_HIGH >> n.hi) -> return ir_range_top()
    ir_range_make(a.lo << n.lo, a.hi << n.hi)
}

// A pixel's lanes: a byte or'd with a byte shifted into the second, a
// 16-bit word shifted back down, and the cases no range survives (a side
// that may be negative, a count past 62, a high end the shift would push
// past the sentinels).
#Test("Ranges of or, xor and shifts of nonnegative words") {
    byte: ir_range_make(0, 255)
    eight: ir_range_make(8, 8)
    high: ir_range_shift(IROp.Shl, ir_range_make(1, 255), eight)
    assert_eq(high.lo, 256)
    assert_eq(high.hi, 65280)
    both: ir_range_bits(IROp.BitOr, byte, high)
    assert_eq(both.lo, 256)
    assert_eq(both.hi, 65535)
    flipped: ir_range_bits(IROp.BitXor, byte, high)
    assert_eq(flipped.lo, 0)
    assert_eq(flipped.hi, 65535)
    down: ir_range_shift(IROp.Shr, both, eight)
    assert_eq(down.lo, 1)
    assert_eq(down.hi, 255)
    assert(!ir_range_has_lo(ir_range_bits(IROp.BitOr, ir_range_make(-1, 3), byte)))
    assert(!ir_range_has_hi(ir_range_shift(IROp.Shl, byte, ir_range_make(0, 63))))
    assert(!ir_range_has_hi(ir_range_shift(IROp.Shl, ir_range_make(0, IR_RANGE_HIGH - 1), eight)))
}

ir_range_binary: fn(op: IROp, a: IRRange, b: IRRange) -> IRRange Never! {
    if op == {
        .Add -> ir_range_make(if !(ir_range_has_lo(a) && ir_range_has_lo(b)) -> IR_RANGE_LOW else -> ir_range_add(a.lo, b.lo), if !(ir_range_has_hi(a) && ir_range_has_hi(b)) -> IR_RANGE_HIGH else -> ir_range_add(a.hi, b.hi))
        // -b.hi stops at IR_RANGE_HIGH, below it: still a low bound.
        .Sub -> ir_range_make(if !(ir_range_has_lo(a) && ir_range_has_hi(b)) -> IR_RANGE_LOW else -> ir_range_add(a.lo, ir_range_neg(b.hi)), if !(ir_range_has_hi(a) && ir_range_has_lo(b)) || b.lo <= IR_RANGE_LOW -> IR_RANGE_HIGH else -> ir_range_add(a.hi, 0 - b.lo))
        .Mul -> {
            if !ir_range_bounded(a) || !ir_range_bounded(b) -> return ir_range_top()
            p1: ir_range_mul(a.lo, b.lo)
            p2: ir_range_mul(a.lo, b.hi)
            p3: ir_range_mul(a.hi, b.lo)
            p4: ir_range_mul(a.hi, b.hi)
            lo := p1
            hi := p1
            corners: [Int]{p2, p3, p4}
            loop p in corners {
                if p < lo -> lo = p
                if p > hi -> hi = p
            }
            ir_range_make(lo, hi)
        }
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> {
            // By a positive divisor only.
            if b.lo <= 0 -> return ir_range_top()
            if op == .Mod || op == .Rem {
                // A floored remainder takes the divisor's sign.
                if !ir_range_has_hi(b) {
                    if a.lo >= 0 -> return ir_range_make(0, a.hi)
                    return if op == .Mod -> ir_range_make(0, IR_RANGE_HIGH) else -> ir_range_top()
                }
                c: b.hi
                if a.lo >= 0 -> return ir_range_make(0, if a.hi < c - 1 -> a.hi else -> c - 1)
                if op == .Mod -> return ir_range_make(0, c - 1)
                return ir_range_make(1 - c, c - 1)
            }
            least: b.lo
            lo: if {
                !ir_range_has_lo(a) -> IR_RANGE_LOW
                a.lo >= 0 -> if !ir_range_has_hi(b) -> 0 else -> a.lo /% b.hi
                else -> a.lo /% least
            }
            hi: if !ir_range_has_hi(a) -> IR_RANGE_HIGH else if a.hi >= 0 -> a.hi /% least else -> 0
            ir_range_make(lo, hi)
        }
    }
}

// A phi: the union of its arguments at the ends of their edges' blocks.
ir_range_phi: fn(f: IRFunction, s: IRSsa, r: IRRanges, phi: Int) -> IRRange Never! {
    join: s.phi_join[phi]
    out := ir_range_none()
    loop k in 0..<s.join_edges[join].len() {
        edge: s.join_edges[join][k]
        arg: ir_ssa_phi_arg(s, phi, k)
        if !ir_range_has(s, r, arg) -> return ir_range_top()
        got: ir_range_at(f, s, r, arg, s.edge_block[edge])
        if !got.known -> next
        if !out.known {
            out = got
            next
        }
        mark: ir_range_inline(out) && ir_range_inline(got)
        if got.lo < out.lo -> out.lo = got.lo
        if got.hi > out.hi -> out.hi = got.hi
        out.inline = mark
    }
    out
}

// Whether comparison `op` of `a` and `b` is decided: 1 true, 0 false, -1
// not decided.
ir_range_decided: fn(op: IROp, a: IRRange, b: IRRange) -> Int Never! {
    if op == {
        .Lt -> {
            if a.hi < b.lo -> return 1
            if a.lo >= b.hi -> return 0
        }
        .Le -> {
            if a.hi <= b.lo -> return 1
            if a.lo > b.hi -> return 0
        }
        .Gt -> {
            if a.lo > b.hi -> return 1
            if a.hi <= b.lo -> return 0
        }
        .Ge -> {
            if a.lo >= b.hi -> return 1
            if a.hi < b.lo -> return 0
        }
        .Eq -> {
            if a.lo == a.hi && b.lo == b.hi && a.lo == b.lo -> return 1
            if a.hi < b.lo || b.hi < a.lo -> return 0
        }
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Ne | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> {
            if a.lo == a.hi && b.lo == b.hi && a.lo == b.lo -> return 0
            if a.hi < b.lo || b.hi < a.lo -> return 1
        }
    }
    -1
}

// Whether comparison `op` of `a` and `b` is decided by the bounds they
// have (ir_range_has_lo, ir_range_has_hi; a missing one lies past every
// value): 1, 0 or -1. Only an Int's bounds hold past the inline Ints (a
// word's arithmetic can wrap there), so a range that is not inline decides
// only an Int comparison (`exact`). An unsigned comparison is read through
// them only when both sides are nonnegative.
ir_range_settled: fn(op: IROp, a: IRRange, b: IRRange, exact: Bool, unsigned: Bool) -> Int Never! {
    if !a.known || !b.known || a.lo > a.hi || b.lo > b.hi -> return -1
    if !exact && !(ir_range_inline(a) && ir_range_inline(b)) -> return -1
    if unsigned && !(ir_range_has_lo(a) && a.lo >= 0 && ir_range_has_lo(b) && b.lo >= 0) -> return -1
    ir_range_decided(op, ir_range_open(a), ir_range_open(b))
}

// Range `a` with each end it lacks moved past the sentinels.
ir_range_open: fn(a: IRRange) -> IRRange Never! {
    IRRange{known: true, lo: if ir_range_has_lo(a) -> a.lo else -> IR_RANGE_LOW - 1, hi: if ir_range_has_hi(a) -> a.hi else -> IR_RANGE_HIGH + 1, inline: false}
}

// The rewrites the ranges prove (the header comment).
ir_range_rewrite: fn(m: IRModule, f: &IRFunction, s: &IRSsa, r: IRRanges) -> Int Never! {
    to_i64: name_rows_value(m.name_rows, "jet_int_owned_to_i64") ?? -2
    clone: name_rows_value(m.name_rows, "jet_rt_int_clone") ?? -2
    fixed: name_rows_value(m.name_rows, "jet_int_checked_fixed") ?? -2
    native: name_rows_value(m.name_rows, "jet_int_native_i64_at") ?? -2
    poll: name_rows_value(m.name_rows, IR_STOP_POLL_KEY) ?? -2
    trap: name_rows_value(m.name_rows, IR_STOP_TRAP_KEY) ?? -2
    rewritten := 0
    // Per value, the first load of the same read-only parameter word (-1:
    // none), built at the first comparison the ranges leave open.
    loads := [Int]{}
    loop at in 0..<f.op.len() {
        block: s.block[at]
        if block < 0 -> next
        op: f.op[at]
        if op == .Drop && ir_range_has(s, r, s.use_a[at]) && r.exact[ir_ssa_find(s, s.use_a[at])] && ir_range_inline(ir_range_at(f, s, r, s.use_a[at], block)) {
            f.op[at] = .Nop
            f.a[at] = -1
            s.use_a[at] = -1
            rewritten += 1
            next
        }
        if op == .IntBig && f.dst[at] >= 0 && ir_range_has(s, r, s.use_a[at]) && r.exact[ir_ssa_find(s, s.use_a[at])] && ir_range_within(ir_range_at(f, s, r, s.use_a[at], block), f.b[at]) {
            f.op[at] = .Const
            f.a[at] = 0
            f.b[at] = -1
            s.use_a[at] = -1
            rewritten += 1
            next
        }
        if op == .Copy && ir_range_has(s, r, s.use_a[at]) && r.exact[ir_ssa_find(s, s.use_a[at])] && f.dst[at] >= 0 && f.slot_type[f.dst[at]] == f.slot_type[f.a[at]] && ir_range_inline(ir_range_at(f, s, r, s.use_a[at], block)) {
            f.op[at] = .Move
            rewritten += 1
            next
        }
        if (op == .Add || op == .Sub || op == .Mul) && f.c[at] != IR_OVERFLOW_WRAP && f.c[at] >= IR_OVERFLOW_TRAP && ir_range_has(s, r, s.use_a[at]) && ir_range_has(s, r, s.use_b[at]) {
            left: ir_ssa_find(s, s.use_a[at])
            right: ir_ssa_find(s, s.use_b[at])
            if r.exact[left] != r.exact[right] -> next
            a: ir_range_at(f, s, r, left, block)
            b: ir_range_at(f, s, r, right, block)
            result: ir_range_binary(op, a, b)
            if !ir_range_inline(a) || !ir_range_inline(b) {
                // One exact operand proven inline: its test goes.
                if r.exact[left] && f.c[at] == IR_OVERFLOW_TRAP && (ir_range_inline(a) || ir_range_inline(b)) {
                    f.c[at] = if ir_range_inline(a) -> IR_OVERFLOW_LEFT else -> IR_OVERFLOW_RIGHT
                    rewritten += 1
                }
                next
            }
            if !ir_range_inline(result) && !ir_range_sum_inline(op, a, b) {
                if r.exact[left] && f.c[at] != IR_OVERFLOW_OPERANDS {
                    f.c[at] = IR_OVERFLOW_OPERANDS
                    rewritten += 1
                }
                next
            }
            if !r.exact[left] && !ir_range_word_fits(r, left, a, b, result) -> next
            f.c[at] = IR_OVERFLOW_WRAP
            rewritten += 1
            ir_range_drop_point(f, trap, at + 1)
            next
        }
        if (op == .Div || op == .Rem || op == .FloorDiv || op == .Mod) && f.c[at] == IR_OVERFLOW_TRAP && ir_range_has(s, r, s.use_a[at]) && ir_range_has(s, r, s.use_b[at]) {
            left: ir_ssa_find(s, s.use_a[at])
            right: ir_ssa_find(s, s.use_b[at])
            if r.exact[left] != r.exact[right] -> next
            a: ir_range_at(f, s, r, left, block)
            b: ir_range_at(f, s, r, right, block)
            // A nonnegative dividend's floored quotient and remainder by a
            // positive divisor are its truncated ones, big or not, word or
            // not. By a constant 2^k the floored ones stay: a shift and a
            // mask, where the truncated ones of a signed word adjust for a
            // negative dividend (X64Select ir_x64_power_division).
            truncates: a.known && b.known && a.lo >= 0 && b.lo > 0 && !(b.lo == b.hi && b.lo.bit_and(b.lo - 1) == 0)
            if truncates && op == .FloorDiv -> f.op[at] = .Div
            if truncates && op == .Mod -> f.op[at] = .Rem
            if f.op[at] != op -> rewritten += 1
            // An Int by a positive divisor: nothing stops, and the result is
            // no larger than the dividend. (A word division keeps its
            // divisor checks: X64Select skips them for an Int only.)
            if !r.exact[left] || !ir_range_inline(a) || !ir_range_inline(b) || b.lo <= 0 -> next
            nonneg: a.known && a.lo >= 0 && (f.op[at] == .Div || f.op[at] == .Rem)
            f.c[at] = if nonneg -> IR_OVERFLOW_NONNEG else -> IR_OVERFLOW_WRAP
            rewritten += 1
            ir_range_drop_point(f, trap, at + 1)
            next
        }
        if (op == .BitAnd || op == .BitOr || op == .BitXor) && f.c[at] != IR_OVERFLOW_WRAP && ir_range_has(s, r, s.use_a[at]) && ir_range_has(s, r, s.use_b[at]) {
            left: ir_ssa_find(s, s.use_a[at])
            right: ir_ssa_find(s, s.use_b[at])
            if !r.exact[left] || !r.exact[right] -> next
            if !ir_range_inline(ir_range_at(f, s, r, left, block)) || !ir_range_inline(ir_range_at(f, s, r, right, block)) -> next
            f.c[at] = IR_OVERFLOW_WRAP
            rewritten += 1
            next
        }
        if (op == .Shl || op == .Shr) && f.c[at] == IR_OVERFLOW_TRAP && ir_range_has(s, r, s.use_b[at]) {
            shifted: m.types[f.slot_type[f.a[at]]]
            if shifted.kind != .Word -> next
            width: if shifted.bits > 0 && shifted.bits < 64 -> shifted.bits else -> 64
            count: ir_range_at(f, s, r, ir_ssa_find(s, s.use_b[at]), block)
            if !ir_range_inline(count) || count.lo < 0 || count.hi >= width -> next
            f.c[at] = IR_OVERFLOW_WRAP
            rewritten += 1
            ir_range_drop_point(f, trap, at + 1)
            next
        }
        if ir_range_is_compare(op) && f.dst[at] >= 0 && ir_range_has(s, r, s.use_a[at]) && ir_range_has(s, r, s.use_b[at]) {
            left: ir_ssa_find(s, s.use_a[at])
            right: ir_ssa_find(s, s.use_b[at])
            a: ir_range_at(f, s, r, left, block)
            b: ir_range_at(f, s, r, right, block)
            unsigned: r.unsigned[left] || r.unsigned[right]
            ranged: ir_range_inline(a) && ir_range_inline(b) && !(unsigned && (a.lo < 0 || b.lo < 0))
            decided := ir_range_settled(op, a, b, r.exact[left] && r.exact[right], unsigned)
            if decided < 0 {
                if loads.len() == 0 -> loads = ir_range_loads(m, f, s)
                decided = ir_range_implied(f, s, r, loads, to_i64, op, left, right, block)
            }
            if decided >= 0 {
                f.op[at] = .Const
                f.a[at] = decided
                f.b[at] = -1
                f.c[at] = -1
                s.use_a[at] = -1
                s.use_b[at] = -1
                rewritten += 1
                next
            }
            if ranged && r.exact[left] && r.exact[right] && f.c[at] != IR_OVERFLOW_WRAP {
                f.c[at] = IR_OVERFLOW_WRAP
                rewritten += 1
            }
            next
        }
        if op == .CallRuntime && f.dst[at] >= 0 && ((f.c[at] == 1 && (f.a[at] == to_i64 || f.a[at] == clone)) || (f.c[at] == 4 && f.a[at] == native)) {
            used: s.use_args[f.b[at]]
            native_call: f.c[at] == 4
            if !ir_range_has(s, r, used) || !r.exact[ir_ssa_find(s, used)] || !ir_range_inline(ir_range_at(f, s, r, used, block)) -> next
            f.op[at] = .Move
            f.a[at] = f.args[f.b[at]]
            f.b[at] = -1
            f.c[at] = -1
            s.use_a[at] = used
            rewritten += 1
            // A native index call that is gone delivers no stop either.
            if native_call -> ir_range_drop_point(f, poll, at + 1)
            next
        }
        if op == .CallRuntime && f.a[at] == fixed && f.c[at] == 5 && f.dst[at] >= 0 {
            used: s.use_args[f.b[at]]
            if !ir_range_has(s, r, used) || !r.exact[ir_ssa_find(s, used)] -> next
            a: ir_range_at(f, s, r, used, block)
            bounds: ir_range_fixed_kind(f, s, s.use_args[f.b[at] + 1])
            if !ir_range_inline(a) || !bounds.known || a.lo < bounds.lo || a.hi > bounds.hi -> next
            f.op[at] = .Move
            f.a[at] = f.args[f.b[at]]
            f.b[at] = -1
            f.c[at] = -1
            s.use_a[at] = used
            rewritten += 1
            // The call is gone, and with it the stop it could deliver.
            ir_range_drop_point(f, poll, at + 1)
        }
    }
    rewritten
}

// Whether a word Add, Sub or Mul of `a` and `b` (inline ranges) into
// `result` (inline) stays inside the type of value `left`: then neither
// the 64-bit overflow nor a narrow word's range check can fire. An
// unsigned word is read through its ranges only when nothing is negative.
ir_range_word_fits: fn(r: IRRanges, left: Int, a: IRRange, b: IRRange, result: IRRange) -> Bool Never! {
    if result.lo < r.cap_lo[left] || result.hi > r.cap_hi[left] -> return false
    !r.unsigned[left] || (a.lo >= 0 && b.lo >= 0 && result.lo >= 0)
}

// Per value, the first load of the same word of a parameter aggregate whose
// word nothing in the function writes (-1: none). Only Loads, and Stores to
// other words, reach such a parameter, so no one else (a `&` parameter is
// exclusive) writes its bytes while the function runs, and two loads of
// one offset read one value (a list's length tested by a loop and again by
// an index check). A load of any other word is the value a Store put there
// just before it (ir_range_stored).
ir_range_loads: fn(m: IRModule, f: IRFunction, s: IRSsa) -> [Int] Never! {
    count: s.val_slot.len()
    loads := [Int]{}
    open := [Bool]{}
    loop value in 0..<count {
        loads.push(-1)
        open.push(s.val_kind[value] == .Param && m.types[f.slot_type[s.val_slot[value]]].kind == .Aggregate)
    }
    // The words Stores write, as (base, offset) pairs.
    stored_bases := [Int]{}
    stored_offsets := [Int]{}
    loop at in 0..<f.op.len() {
        if f.op[at] == .Store && s.use_a[at] >= 0 {
            stored_bases.push(ir_ssa_find(s, s.use_a[at]))
            stored_offsets.push(f.b[at])
        } else if f.op[at] != .Load && s.use_a[at] >= 0 {
            open[ir_ssa_find(s, s.use_a[at])] = false
        }
        if s.use_b[at] >= 0 -> open[ir_ssa_find(s, s.use_b[at])] = false
        if s.use_c[at] >= 0 -> open[ir_ssa_find(s, s.use_c[at])] = false
    }
    loop used in s.use_args {
        if used >= 0 -> open[ir_ssa_find(s, used)] = false
    }
    bases := [Int]{}
    offsets := [Int]{}
    firsts := [Int]{}
    loop at in 0..<f.op.len() {
        if f.op[at] != .Load || s.block[at] < 0 || s.def[at] < 0 || s.use_a[at] < 0 || f.dst[at] < 0 -> next
        base: ir_ssa_find(s, s.use_a[at])
        if m.types[f.slot_type[f.dst[at]]].size != 8 -> next
        if !open[base] {
            loads[s.def[at]] = ir_range_stored(m, f, s, at)
            next
        }
        written := false
        loop k in 0..<stored_bases.len() {
            if stored_bases[k] == base && stored_offsets[k] > f.b[at] - 8 && stored_offsets[k] < f.b[at] + 8 -> written = true
        }
        if written -> next
        value: s.def[at]
        first := value
        loop k in 0..<bases.len() {
            if bases[k] == base && offsets[k] == f.b[at] -> first = firsts[k]
        }
        if first == value {
            bases.push(base)
            offsets.push(f.b[at])
            firsts.push(value)
        }
        loads[value] = first
    }
    loads
}

// The value the Store of the same word of the same base before Load `at`
// put there, earlier in its block with nothing between that can write that
// word: Loads, Consts, Nops, Stores to other words of the base and, for
// word 0, the `#unique<..>` call on the base (BuildOwn.jet
// ir_unique_helper writes only a header's words 8 and 16: the list keeps
// its length). Only an 8-byte Store of the load's type counts. -1 when
// there is none.
ir_range_stored: fn(m: IRModule, f: IRFunction, s: IRSsa, at: Int) -> Int Never! {
    base: ir_ssa_find(s, s.use_a[at])
    offset: f.b[at]
    block: s.block[at]
    k := at - 1
    loop k >= 0 && s.block[k] == block {
        op: f.op[k]
        if op == .Store && s.use_a[k] >= 0 && ir_ssa_find(s, s.use_a[k]) == base {
            if f.b[k] == offset {
                if s.use_c[k] < 0 || f.c[k] < 0 || f.slot_type[f.c[k]] != f.slot_type[f.dst[at]] -> return -1
                return ir_ssa_find(s, s.use_c[k])
            }
            if f.b[k] > offset - 8 && f.b[k] < offset + 8 -> return -1
        } else if op == .Call {
            if offset != 0 || !ir_range_unique_call(m, f, s, k, base) -> return -1
        } else if op != .Load && op != .Const && op != .Nop {
            return -1
        }
        k -= 1
    }
    -1
}

// Whether Call `at` calls the `#unique<..>` helper of the type of its one
// argument, value `base`: as the optimizer's module view names it (Opt.jet
// ir_opt_view), or a whole module by its key.
ir_range_unique_call: fn(m: IRModule, f: IRFunction, s: IRSsa, at: Int, base: Int) -> Bool Never! {
    if f.c[at] != 1 || f.dst[at] >= 0 || s.use_args[f.b[at]] < 0 || ir_ssa_find(s, s.use_args[f.b[at]]) != base -> return false
    row: f.slot_type[f.args[f.b[at]]]
    helper := name_rows_value(m.name_rows, "#unique@{row}") ?? -1
    if helper < 0 && row < m.type_keys.len() -> helper = name_rows_value(m.function_rows, "#unique<{ir_row_key(m, row)}>") ?? -1
    helper >= 0 && helper == f.a[at]
}

// The value `used` reads, through the steps that keep its number: a Copy or
// Move between two words of 64 bits, two Ints, or from an Int proven inline
// into a word; jet_int_owned_to_i64, which returns only its operand's
// number; a load of a read-only parameter word as that word's first load,
// and of a word a Store put just before as the stored value
// (ir_range_loads). A step lands only on a signed value, so the root's
// number is the value's (an unsigned value's when the root is nonnegative).
ir_range_root: fn(f: IRFunction, s: IRSsa, r: IRRanges, loads: [Int], to_i64: Int, used: Int) -> Int Never! {
    value := ir_ssa_find(s, used)
    steps := 0
    loop steps < IR_RANGE_DEPTH && s.val_kind[value] == .Def && !r.narrow[value] {
        at: s.val_at[value]
        op: f.op[at]
        from := -1
        if op == .Load {
            first: loads[value]
            if first < 0 || first == value || !r.ranged[first] || r.unsigned[first] -> return value
            value = first
            steps += 1
            next
        }
        if (op == .Copy || op == .Move) && s.use_a[at] >= 0 {
            from = ir_ssa_find(s, s.use_a[at])
            if r.exact[from] && !r.exact[value] && !ir_range_inline(ir_range_at(f, s, r, from, s.block[at])) -> return value
            if !r.exact[from] && r.exact[value] -> return value
        }
        if op == .CallRuntime && f.a[at] == to_i64 && f.c[at] == 1 && s.use_args[f.b[at]] >= 0 -> from = ir_ssa_find(s, s.use_args[f.b[at]])
        if from < 0 || !r.ranged[from] || r.narrow[from] || r.unsigned[from] -> return value
        value = from
        steps += 1
    }
    value
}

// Whether the decided branches dominating `block` (ir_range_at's walk)
// settle `left op right`: a deciding comparison of the same roots
// (ir_range_root) and the relation it gives. 1 or 0; -1 when none does.
ir_range_implied: fn(f: IRFunction, s: IRSsa, r: IRRanges, loads: [Int], to_i64: Int, op: IROp, left: Int, right: Int, block: Int) -> Int Never! {
    if block <= 0 -> return -1
    l: ir_range_root(f, s, r, loads, to_i64, left)
    rr: ir_range_root(f, s, r, loads, to_i64, right)
    if l == rr -> return -1
    unsigned: r.unsigned[left] || r.unsigned[right]
    at := r.up[block]
    steps := 0
    loop at > 0 && steps < IR_RANGE_DEPTH {
        decided: ir_range_implied_by(f, s, r, loads, to_i64, op, l, rr, unsigned, r.cond[at], r.holds[at])
        if decided >= 0 -> return decided
        at = if s.idom[at] >= 0 && s.idom[at] < at -> r.up[s.idom[at]] else -> -1
        steps += 1
    }
    -1
}

// `l op rr` (roots; `unsigned`: the comparison reads unsigned words) under
// condition `cond` holding or not: a signed comparison of the same roots,
// or of one of them and a root y that the other's number is at least
// (ir_range_covers): `l < y` (or `<=`, `==`) and `rr >= y` give `l < rr`
// (`l <= rr`). Its relation carries to unsigned words when the operands are
// nonnegative, or for `<` / `<=` when the smaller is (a negative larger one
// is above every nonnegative word).
ir_range_implied_by: fn(f: IRFunction, s: IRSsa, r: IRRanges, loads: [Int], to_i64: Int, op: IROp, l: Int, rr: Int, unsigned: Bool, cond_in: Int, holds_in: Bool) -> Int Never! {
    cond := cond_in
    holds := holds_in
    loop s.val_kind[cond] == .Def && f.op[s.val_at[cond]] == .Not && s.use_a[s.val_at[cond]] >= 0 {
        cond = ir_ssa_find(s, s.use_a[s.val_at[cond]])
        holds = !holds
    }
    if s.val_kind[cond] != .Def -> return -1
    at: s.val_at[cond]
    if !ir_range_is_compare(f.op[at]) || s.use_a[at] < 0 || s.use_b[at] < 0 -> return -1
    x: ir_ssa_find(s, s.use_a[at])
    y: ir_ssa_find(s, s.use_b[at])
    if !r.ranged[x] || !r.ranged[y] || r.unsigned[x] || r.unsigned[y] -> return -1
    rx: ir_range_root(f, s, r, loads, to_i64, x)
    ry: ir_range_root(f, s, r, loads, to_i64, y)
    rel := if holds -> f.op[at] else -> ir_range_negate(f.op[at])
    if rx == rr && ry == l {
        rel = ir_range_swap(rel)
    } else if rx != l || ry != rr {
        near: if rx == l || rx == rr -> rx else -> ry
        if near != l && near != rr -> return -1
        far: if near == rx -> ry else -> rx
        // `near through far`, and `far <= other`.
        through := if near == rx -> rel else -> ir_range_swap(rel)
        if through == .Eq -> through = .Le
        if through != .Lt && through != .Le -> return -1
        if !ir_range_covers(f, s, r, loads, to_i64, if near == l -> rr else -> l, far) -> return -1
        rel = if near == l -> through else -> ir_range_swap(through)
    }
    if unsigned && rel != .Eq && rel != .Ne {
        low_l: r.known[l] && r.lo[l] >= 0
        low_r: r.known[rr] && r.lo[rr] >= 0
        smaller_low: if rel == .Lt || rel == .Le -> low_l else -> low_r
        if !(low_l && low_r) && !smaller_low -> return -1
    }
    if ir_range_implies(rel, op) -> return 1
    if ir_range_implies(rel, ir_range_negate(op)) -> return 0
    return -1
}

// Whether the number of root `value` is at least that of root `y`: it is
// `y`, or a phi each of whose arguments has root `y` or, at the end of its
// edge, a low bound at or above `y`'s high bound there (ir_range_edge_top).
// That is a clamp's: below `len := 0; if 0 < n { len = n }`, `len >= n`.
ir_range_covers: fn(f: IRFunction, s: IRSsa, r: IRRanges, loads: [Int], to_i64: Int, value: Int, y: Int) -> Bool Never! {
    if value == y -> return true
    if s.val_kind[value] != .Phi -> return false
    phi: s.val_at[value]
    join: s.phi_join[phi]
    loop k in 0..<s.join_edges[join].len() {
        arg: ir_ssa_phi_arg(s, phi, k)
        if !ir_range_has(s, r, arg) -> return false
        if ir_range_root(f, s, r, loads, to_i64, arg) == y -> next
        edge: s.join_edges[join][k]
        got: ir_range_at(f, s, r, arg, s.edge_block[edge])
        // An edge nothing reaches (ir_range_phi leaves it out too).
        if !got.known -> next
        top: ir_range_edge_top(f, s, r, loads, to_i64, y, edge)
        if !ir_range_has_lo(got) || top > IR_RANGE_HIGH || got.lo < top -> return false
    }
    true
}

// The high bound of root `y`'s number at the end of edge `edge`: the least
// one that the comparisons settled there put on a value with root `y`
// (ir_range_top_by): the edge's own (an If's false branch, a BrIf's taken
// one) and the decided branches dominating its block. IR_RANGE_HIGH + 1
// when none bounds it.
ir_range_edge_top: fn(f: IRFunction, s: IRSsa, r: IRRanges, loads: [Int], to_i64: Int, y: Int, edge: Int) -> Int Never! {
    block: s.edge_block[edge]
    top := IR_RANGE_HIGH + 1
    at: s.edge_at[edge]
    if s.edge_kind[edge] == .IfFalse && f.a[at] >= 0 && f.op[f.a[at]] == .If && s.use_a[f.a[at]] >= 0 {
        top = ir_range_top_by(f, s, r, loads, to_i64, y, ir_ssa_find(s, s.use_a[f.a[at]]), false, block)
    }
    if s.edge_kind[edge] == .BrIf && f.op[at] == .BrIf && s.use_a[at] >= 0 {
        top = ir_range_top_by(f, s, r, loads, to_i64, y, ir_ssa_find(s, s.use_a[at]), true, block)
    }
    up := if block > 0 -> r.up[block] else -> -1
    steps := 0
    loop up > 0 && steps < IR_RANGE_DEPTH {
        got: ir_range_top_by(f, s, r, loads, to_i64, y, r.cond[up], r.holds[up], block)
        if got < top -> top = got
        up = if s.idom[up] >= 0 && s.idom[up] < up -> r.up[s.idom[up]] else -> -1
        steps += 1
    }
    top
}

// The high bound condition `cond` holding or not (through its Nots) puts on
// root `y`'s number: a signed comparison of a value with root `y` and one
// whose range read in `block` has a high bound. IR_RANGE_HIGH + 1 when it
// puts none.
ir_range_top_by: fn(f: IRFunction, s: IRSsa, r: IRRanges, loads: [Int], to_i64: Int, y: Int, cond_in: Int, holds_in: Bool, block: Int) -> Int Never! {
    none: IR_RANGE_HIGH + 1
    cond := cond_in
    holds := holds_in
    loop s.val_kind[cond] == .Def && f.op[s.val_at[cond]] == .Not && s.use_a[s.val_at[cond]] >= 0 {
        cond = ir_ssa_find(s, s.use_a[s.val_at[cond]])
        holds = !holds
    }
    if s.val_kind[cond] != .Def -> return none
    at: s.val_at[cond]
    if !ir_range_is_compare(f.op[at]) || s.use_a[at] < 0 || s.use_b[at] < 0 -> return none
    x: ir_ssa_find(s, s.use_a[at])
    z: ir_ssa_find(s, s.use_b[at])
    if !r.ranged[x] || !r.ranged[z] || r.unsigned[x] || r.unsigned[z] -> return none
    // `y rel other`.
    rel := if holds -> f.op[at] else -> ir_range_negate(f.op[at])
    other := z
    if ir_range_root(f, s, r, loads, to_i64, z) == y {
        rel = ir_range_swap(rel)
        other = x
    } else if ir_range_root(f, s, r, loads, to_i64, x) != y {
        return none
    }
    b: ir_range_at(f, s, r, other, block)
    if !b.known || !ir_range_has_hi(b) -> return none
    if rel == {
        .Lt -> b.hi - 1
        .Le | .Eq -> b.hi
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Ne | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> none
    }
}

// Whether `a rel b` makes `a op b` true.
ir_range_implies: fn(rel: IROp, op: IROp) -> Bool Never! {
    if rel == op -> return true
    if rel == {
        .Lt -> op == .Le || op == .Ne
        .Gt -> op == .Ge || op == .Ne
        .Eq -> op == .Le || op == .Ge
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Ne | .Le | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> false
    }
}

// The stop point at `at` (Build.jet ir_stop_point: the call of `key`, the
// trap or the stop poll, then the If on what it returned, with no Else), if
// one is there, becomes Nops.
ir_range_drop_point: fn(f: &IRFunction, key: Int, at: Int) Never! {
    if key < 0 || at + 1 >= f.op.len() || f.op[at] != .Call || f.a[at] != key || f.dst[at] < 0 -> return
    branch: at + 1
    if f.op[branch] != .If || f.a[branch] != f.dst[at] || f.b[branch] >= 0 -> return
    end: f.c[branch]
    loop k in at..<(end + 1) -> ir_opt_kill(f, k)
}

// How many stop points (calls of the trap or the stop poll) `f` has.
ir_range_traps: fn(m: IRModule, f: IRFunction) -> Int Never! {
    poll: name_rows_value(m.name_rows, IR_STOP_POLL_KEY) ?? -2
    trap: name_rows_value(m.name_rows, IR_STOP_TRAP_KEY) ?? -2
    count := 0
    loop at in 0..<f.op.len() {
        if f.op[at] == .Call && (f.a[at] == trap || f.a[at] == poll) -> count += 1
    }
    count
}

// The values jet_int_checked_fixed passes for its constant `kind` (value
// `used`): 0..3 the signed 8..64-bit integers, 4..7 the unsigned ones.
ir_range_fixed_kind: fn(f: IRFunction, s: IRSsa, used: Int) -> IRRange Never! {
    if used < 0 -> return ir_range_none()
    value: ir_ssa_find(s, used)
    if s.val_kind[value] != .Def || f.op[s.val_at[value]] != .Const -> return ir_range_none()
    kind: f.a[s.val_at[value]]
    if kind == {
        0 -> ir_range_make(-128, 127)
        1 -> ir_range_make(-32768, 32767)
        2 -> ir_range_make(-2147483648, 2147483647)
        3 -> ir_range_top()
        4 -> ir_range_make(0, 255)
        5 -> ir_range_make(0, 65535)
        6 -> ir_range_make(0, 4294967295)
        7 -> ir_range_make(0, IR_RANGE_HIGH)
        else -> ir_range_none()
    }
}
