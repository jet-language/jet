// Masked branches. Sema masks a branch on a `timing: .Fixed` value when every
// arm is total (JetSema Taint.jet sema_taint_total_expr): no arm stops, calls
// or writes memory, and an arm leaves only by a last `return` (an early
// return, below). The span of each such branch is in its
// function's FnBody.masked. The builder builds a masked branch with no jump.
// Both arms run, each under the Bool that it would have run under
// (IRBuilder.mask: the branch's test, or its negation, and-ed with the
// enclosing mask). An assignment in an arm keeps the variable's old value
// where that Bool fails, and an `if` value keeps the selected arm's value.
// Each selection is `other ^ ((chosen ^ other) & mask)`: a Bool is its own
// mask, and a fixed-width word's mask is `0 - (test & 1)`, all ones or zero.
// Only fixed-width integers and Bool are selected. Sema's totality admits
// nothing else that could flow out of an arm. Each masked branch is a row of
// IRFunction.masked, which `jet inspect decisions` lists
// (ir_masked_branch_rows).
//
// The fixed bit (IRFunction.slot_fixed): the builder marks each scalar slot
// (a Word, Bool or Char) that holds a value of a fixed-tagged checked type
// (FnBody.fixed_tags), a parameter, an expression's result or an element read
// out of a list whose elements are fixed (a compared element's checked type
// drops the tag), but not one a constant makes. IR Lint follows the values
// computed from these after the build and after each pass (Lint.jet
// ir_lint_fixed).

use jet_foundation.[BodyIfCond, BodyPlace, body_stmt, body_type_id, FnBody, Span, TBinaryOp, Type]

// Which types of the checked body's type table are fixed (IRBuilder.fixed_ids).
// An instance's types are its own, so it marks none.
ir_fixed_types: fn(b: &IRBuilder, function: FnBody) Never! {
    if function.fixed_tags.len() == 0 || b.instance.names.len() > 0 -> return
    loop ty in function.tree.types.types -> b.fixed_ids.push(ir_fixed_type(function.fixed_tags, ty))
}

// Whether `ty` carries one of `fixed_tags` on its own value.
ir_fixed_type: fn(fixed_tags: [String], ty: Type) -> Bool Never! {
    if ty == .Tagged(marker, inner) {
        if marker == .User(name) {
            if fixed_tags.contains(name) -> return true
        }
        return ir_fixed_type(fixed_tags, inner)
    }
    false
}

// Marks `slot` fixed when it is a scalar and the instruction just built did
// not make it a constant.
ir_fix_slot: fn(m: IRModule, b: &IRBuilder, slot: Int) Never! {
    kind: m.types[b.f.slot_type[slot]].kind
    if kind != .Word && kind != .Bool && kind != .Char -> return
    last: b.f.op.len() - 1
    if last >= 0 && b.f.dst[last] == slot && b.f.op[last] == .Const -> return
    b.f.slot_fixed[slot] = true
}

// Marks `slot`, the value of node `expression`, when the node's checked
// type is fixed or the node reads an element of a list of fixed elements.
ir_fix_expr: fn(m: IRModule, p: IRProgram, b: &IRBuilder, expression: Int, slot: Int) Never! {
    if slot < 0 || b.row < 0 || b.fixed_ids.len() == 0 || expression <= IR_FIRST_NODE_ID -> return
    function: p.functions[b.row]
    id: body_type_id(function.tree, expression)
    if id < b.fixed_ids.len() && b.fixed_ids[id] {
        ir_fix_slot(m, b, slot)
        return
    }
    if ir_body_node(p, b, expression).kind == .Index(base, _, kind, _, _, _) {
        if (kind != .List && kind != .FixedListProof) || base <= IR_FIRST_NODE_ID -> return
        if ir_fixed_element(function.fixed_tags, function.tree.types.types[body_type_id(function.tree, base)]) -> ir_fix_slot(m, b, slot)
    }
}

// Whether `ty` is a list (tagged or not) whose elements are fixed.
ir_fixed_element: fn(fixed_tags: [String], ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(_, inner) -> return ir_fixed_element(fixed_tags, inner)
        .List(element) -> return ir_fixed_type(fixed_tags, element)
        .FixedList(element, _) -> return ir_fixed_type(fixed_tags, element)
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
    }
}

// Whether the branch at `span` of the function being built is masked.
ir_masked_branch: fn(p: IRProgram, b: IRBuilder, span: Span) -> Bool Never! {
    if b.row < 0 -> return false
    loop masked in p.functions[b.row].masked {
        if masked.start == span.start && masked.end == span.end -> return true
    }
    false
}

// The Bool an arm of a masked branch runs under: `test` (`!test` when
// `negate`) and-ed with the enclosing mask.
ir_mask_arm: fn(m: &IRModule, b: &IRBuilder, test: Int, negate: Bool) -> Int Never! {
    value := test
    if negate {
        value = ir_temp_like(m, b, test)
        ir_emit(b.f, IROp.Not, value, test, -1, -1, b.line)
    }
    if b.mask < 0 -> return value
    both: ir_temp_like(m, b, test)
    ir_emit(b.f, IROp.BitAnd, both, value, b.mask, IR_OVERFLOW_WRAP, b.line)
    both
}

// `chosen` where the Bool `test` holds, else `other`, with no jump. The two
// share one type row.
ir_mask_select: fn(m: &IRModule, b: &IRBuilder, test: Int, chosen: Int, other: Int, span: Span) -> Int Never! {
    kind: ir_kind_of(m, b, other)
    if kind != .Word && kind != .Bool -> return ir_fail_slot(b, span, "a masked branch selects a {ir_kind_name(kind)} value; only a fixed-width integer or a Bool can be masked")
    if b.f.slot_type[chosen] != b.f.slot_type[other] -> return ir_fail_slot(b, span, "a masked branch selects between two types")
    mask := test
    if kind == .Word {
        bit: ir_copy_word(m, b, test, b.f.slot_type[other])
        one: ir_const_like(m, b, other, 1)
        low: ir_temp_like(m, b, other)
        ir_emit(b.f, IROp.BitAnd, low, bit, one, IR_OVERFLOW_WRAP, b.line)
        zero: ir_const_like(m, b, other, 0)
        mask = ir_temp_like(m, b, other)
        ir_emit(b.f, IROp.Sub, mask, zero, low, IR_OVERFLOW_WRAP, b.line)
    }
    differ: ir_temp_like(m, b, other)
    ir_emit(b.f, IROp.BitXor, differ, chosen, other, IR_OVERFLOW_WRAP, b.line)
    kept: ir_temp_like(m, b, other)
    ir_emit(b.f, IROp.BitAnd, kept, differ, mask, IR_OVERFLOW_WRAP, b.line)
    result: ir_temp_like(m, b, other)
    ir_emit(b.f, IROp.BitXor, result, other, kept, IR_OVERFLOW_WRAP, b.line)
    result
}

// The test of a masked branch: a plain Bool. Sema masks no pattern test.
ir_mask_test: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, condition: BodyIfCond, span: Span) -> Int Never! {
    if condition == .Plain(value) {
        b.f.masked.push(ir_source_line_of(p, b.f.source_file, span.start) ?? b.line)
        return ir_expr(m, p, b, value)
    }
    ir_fail_slot(b, span, "a masked branch tests a pattern")
}

// A masked statement `if`: each arm's statements under its Bool.
ir_masked_if: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, condition: BodyIfCond, then_body: [Int], else_body: [Int]?, span: Span) Never! {
    test: ir_mask_test(m, p, b, condition, span)
    if ir_failed(b) -> return
    outer: b.mask
    b.mask = ir_mask_arm(m, b, test, false)
    ir_scope_open(b)
    ir_stmts(m, p, b, then_body)
    ir_scope_close(m, b)
    b.mask = outer
    if else_body == .Val(otherwise) {
        b.mask = ir_mask_arm(m, b, test, true)
        ir_scope_open(b)
        ir_stmts(m, p, b, otherwise)
        ir_scope_close(m, b)
        b.mask = outer
    }
}

// A masked `if` value: both arms' values, then the selected one.
ir_masked_if_value: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, condition: BodyIfCond, then_body: [Int], then_value: Int, else_body: [Int], else_value: Int, ty: Type, span: Span) -> Int Never! {
    test: ir_mask_test(m, p, b, condition, span)
    if ir_failed(b) -> return -1
    unit: ir_unit_type(ty) || ir_never_type(ty)
    chosen := -1
    other := -1
    if !unit {
        row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
        chosen = ir_temp(m, b, row)
        other = ir_temp(m, b, row)
    }
    outer: b.mask
    b.mask = ir_mask_arm(m, b, test, false)
    ir_branch_value(m, p, b, then_body, then_value, chosen)
    b.mask = outer
    b.mask = ir_mask_arm(m, b, test, true)
    ir_branch_value(m, p, b, else_body, else_value, other)
    b.mask = outer
    if unit || ir_failed(b) -> return -1
    ir_mask_select(m, b, test, chosen, other, span)
}

// `x = v` (or `x op= v`) in an arm of a masked branch: `x` keeps its old
// value where the arm's Bool fails.
ir_masked_assign: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, place: BodyPlace, op: TBinaryOp?, value: Int, span: Span) Never! {
    binding: if place == {
        .Local(local) -> ir_lookup_local(b, local) ?? { return ir_fail(b, span, "assignment to unknown local {local.name}") }
        .Expr(_) -> { return ir_fail(b, span, "a masked branch writes a place that is not a variable") }
    }
    current: ir_read_binding(m, b, binding)
    right: ir_expr(m, p, b, value)
    if ir_failed(b) -> return
    result := right
    if op == .Val(binary) {
        left_ty: m.types[b.f.slot_type[current]].ty
        right_ty: ir_ty(p, b, value)
        result = ir_binary(m, p, b, binary, ir_assign_overflow(binary), b.line, left_ty, current, right, right_ty, span)
        if ir_failed(b) || result < 0 -> return
    }
    now: ir_masked_now(m, b)
    kept: ir_mask_select(m, b, now, result, current, span)
    if ir_failed(b) -> return
    if binding.indirect >= 0 {
        ir_emit(b.f, IROp.Store, -1, binding.slot, 0, kept, b.line)
        b.fresh[kept] = false
        return
    }
    ir_store(m, p, b, binding.slot, kept)
}

// Early returns from masked branches. Sema masks an `if` with no else whose
// arms return (JetSema Taint.jet sema_taint_settle_exits) when everything the
// return would skip is total too. Such a function keeps two variables from
// its start: `live` (no masked return has run yet) and the value the first
// masked return chose. A masked return keeps its value where its arm's Bool
// and `live` hold, then clears `live` there. The code after it still runs:
// in every loop of the function (its body may run again after one), every
// assignment also keeps its old value where `live` is false. Every return
// of the function gives the chosen value where `live` is false.
ir_masked_exits: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, function: FnBody) Never! {
    // The checked body the builder reads (ir_body_stmt, ir_masked_branch):
    // an early return is the last statement of a masked `if`'s arm.
    if b.row < 0 -> return
    row: b.row
    found := false
    loop statement in p.functions[row].tree.stmts {
        if statement == .If(_, then_body, _, _, span) {
            if then_body.len() > 0 && ir_masked_branch(p, b, span) {
                last: body_stmt(p.functions[row].tree, then_body[then_body.len() - 1])
                if last == .Return(_, _) -> found = true
            }
        }
    }
    if !found -> return
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    b.live = ir_new_slot(b, bool_row, IRSlotKind.Local, ir_intern_name(m, "masked.live"))
    ir_emit(b.f, IROp.Const, b.live, 1, -1, -1, b.line)
    if b.f.result < 0 -> return
    kind: m.types[b.f.result].kind
    if kind != .Word && kind != .Bool -> return ir_fail(b, function.source_span, "a masked branch returns a {ir_kind_name(kind)} value; only a fixed-width integer or a Bool can be masked")
    b.exit_value = ir_new_slot(b, b.f.result, IRSlotKind.Local, ir_intern_name(m, "masked.result"))
    ir_emit(b.f, IROp.Const, b.exit_value, 0, -1, -1, b.line)
}

// Entering a loop in a function with masked returns: its body may run again
// after one, so its assignments are masked from the start.
ir_masked_loop: fn(b: &IRBuilder) Never! {
    if b.live >= 0 -> b.exiting = true
}

// Whether an assignment here keeps its old value where a Bool fails.
ir_masking: fn(b: IRBuilder) -> Bool Never! {
    b.mask >= 0 || (b.live >= 0 && b.exiting)
}

// The Bool the code being built runs under: the arm's mask and-ed with
// `live` once a masked return may have run, read where it is used.
ir_masked_now: fn(m: &IRModule, b: &IRBuilder) -> Int Never! {
    live: b.live
    mask: b.mask
    if live < 0 || !b.exiting -> return mask
    if mask < 0 -> return live
    both: ir_temp_like(m, b, live)
    ir_emit(b.f, IROp.BitAnd, both, mask, live, IR_OVERFLOW_WRAP, b.line)
    both
}

// `return value` in an arm of a masked branch.
ir_masked_return: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, value: Int?, span: Span) Never! {
    live: b.live
    chosen: b.exit_value
    if live < 0 -> return ir_fail(b, span, "a masked branch returns")
    b.exiting = true
    now: ir_masked_now(m, b)
    if value == .Val(returned) {
        if chosen < 0 -> return ir_fail(b, span, "a masked branch returns a value from a function without one")
        row: b.f.result
        slot: ir_value_as(m, p, b, returned, row, span)
        if ir_failed(b) -> return
        kept: ir_mask_select(m, b, now, slot, chosen, span)
        if ir_failed(b) -> return
        ir_emit(b.f, IROp.Copy, chosen, kept, -1, -1, b.line)
    }
    gone: ir_temp_like(m, b, live)
    ir_emit(b.f, IROp.Not, gone, now, -1, -1, b.line)
    still: ir_temp_like(m, b, live)
    ir_emit(b.f, IROp.BitAnd, still, live, gone, IR_OVERFLOW_WRAP, b.line)
    ir_emit(b.f, IROp.Copy, live, still, -1, -1, b.line)
}

// The value a return of a function with masked returns gives: `slot` while
// `live`, else the value the masked return chose.
ir_masked_result: fn(m: &IRModule, b: &IRBuilder, slot: Int, span: Span) -> Int Never! {
    live: b.live
    chosen: b.exit_value
    if live < 0 || chosen < 0 -> return slot
    ir_mask_select(m, b, live, slot, chosen, span)
}
