// Jet IR: the one intermediate form between the checked program and machine
// code. One flat arena per function, no SSA: a slot is a mutable typed
// variable, every instruction reads slots and writes at most one slot, and
// control flow is structured (Block, Loop, If/Else, End, Br, BrIf, Return).
// Storage is struct-of-arrays with integer ids: no per-instruction or
// per-slot heap allocation, and an instruction's operands are three Int
// fields plus one shared args pool for variable-length operand lists.
//
// Instruction operands (`dst`, `a`, `b`, `c`; -1 when unused):
//   Nop                                        nothing
//   Const        dst  a=value                  Int/IntN/Bool (0|1)/Char value,
//                                              Float/Float32 IEEE bits; an exact
//                                              Int constant is inline (fits 62 bits)
//   ConstText    dst  a=data row               the immortal static String of the
//                                              data row's bytes (its drop is a no-op)
//   ConstBigInt  dst  a=name (decimal text)    exact Int outside the inline range
//   Copy         dst  a=slot                   duplicate of a copyable value
//   Move         dst  a=slot                   ownership transfer; `a` is dead after
//   Drop         a=slot                        runs the value's drop; dead after
//   Close        a=slot b=name (close routine) runs the routine on the slot; dead after
//   Add Sub Mul Div Rem FloorDiv Mod           dst  a=left b=right c=overflow
//   BitAnd BitOr BitXor Shl Shr                (IR_OVERFLOW_*); the left operand's
//                                              slot type selects the semantics:
//                                              exact Int spills to big integers,
//                                              IntN traps or wraps per `c`,
//                                              Float is IEEE
//   Eq Ne Lt Le Gt Ge                          dst(Bool) a=left b=right
//   Neg Not                                    dst  a=operand
//   Concat       dst  a=left b=right           String + String (new owned String)
//   Call         dst? a=function b=args c=count
//   CallRuntime  dst? a=name (symbol) b=args c=count
//   CallIndirect dst? a=callee slot b=args c=count
//   FunctionAddress dst a=function
//   DataAddress  dst  a=data row
//   Load         dst  a=base pointer slot b=byte offset
//   Store        a=base pointer slot b=byte offset c=value slot
//   StackAddress dst  a=size b=align           frame storage, live to return
//                                              (one area per instruction)
//   Offset       dst  a=pointer slot b=bytes   the address a + b
//   CopyBytes    a=dst pointer b=src pointer c=byte count
// Load and Store move the value slot's layout (IRType.size bytes, sign- or
// zero-extended per IRType.signed for a Word). An Aggregate slot holds a
// pointer to the value's bytes: an Aggregate parameter is the caller's
// pointer; a call with an Aggregate result passes caller frame storage as
// the hidden first argument and its dst receives that pointer; returning
// an Aggregate copies its bytes through the hidden pointer.
//   Block        a=index of its End
//   Loop         a=index of its End            Br to a Loop restarts it
//   If           a=condition slot b=index of its Else (-1) c=index of its End
//   Else         a=index of its End
//   End          a=index of its opener
//   Br           a=depth                       0 = innermost open Block/Loop/If;
//                                              leaves a Block/If past its End,
//                                              restarts a Loop
//   BrIf         a=condition slot b=depth
//   Return       a=slot (-1 for none)
//   Unreachable                                control never gets here
//
// Calls and runtime routes use the System V ABI of the existing x86-64
// selector; runtime symbols are the old backend's, so a program behaves the
// same on both paths.

use jet_foundation.[Type, mir_sha256_hex]

enum IROp {
    Nop
    Const
    ConstText
    ConstBigInt
    Copy
    Move
    Drop
    Close
    Add
    Sub
    Mul
    Div
    Rem
    FloorDiv
    Mod
    BitAnd
    BitOr
    BitXor
    Shl
    Shr
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
    Neg
    Not
    Concat
    Call
    CallRuntime
    CallIndirect
    FunctionAddress
    DataAddress
    Load
    Store
    StackAddress
    Offset
    CopyBytes
    Block
    Loop
    If
    Else
    End
    Br
    BrIf
    Return
    Unreachable
}

// Overflow policy of an arithmetic op on a fixed-width integer (`c`).
IR_OVERFLOW_TRAP :: 0
IR_OVERFLOW_WRAP :: 1

// What a slot holds. `Int` is Jet's exact integer (an inline word whose bits
// 63 and 62 agree, else a big-integer handle); `Word` a fixed-width integer
// (IRType.bits, IRType.signed); `Pointer` a raw address or an owned heap
// carrier the runtime manages (String, List, boxes); `Aggregate` bytes
// passed by hidden pointer (IRType.size).
enum IRTypeKind { Unit Bool Int Word Float Float32 Char String Pointer Aggregate }

// System V class of one value, as LIRABIClass.
enum IRClass { Integer Pointer Float Memory }

// One interned type row: the checked type and its machine layout.
// `drop` is the runtime symbol that ends a value's life ("" when trivial).
struct IRType {
    ty: Type
    kind: IRTypeKind
    size: Int
    align: Int
    class: IRClass
    signed: Bool
    bits: Int
    drop: String
}

enum IRSlotKind { Param Local Temp }

// One function's arena. Slots 0..<param_count are the parameters in order.
// `slot_name` is an interned name (-1 for a temporary); `slot_line` the
// source line a variable is declared on (0 none); `line[i]` the source line
// of instruction i (0 none). `result` is a type row, -1 for none.
struct IRFunction {
    name: String
    key: String
    symbol: String
    source_file: String
    line: Int
    param_count: Int
    result: Int
    slot_type: [Int]
    slot_kind: [IRSlotKind]
    slot_name: [Int]
    slot_line: [Int]
    op: [IROp]
    dst: [Int]
    a: [Int]
    b: [Int]
    c: [Int]
    code_line: [Int]
    args: [Int]
    // Open structured-control instructions while building (indexes into `op`).
    open: [Int]
}

// The program: interned types and names, read-only data rows, functions.
// `function_rows` maps a function key to its id (row of `functions`);
// `entry` is the program entry (`fn run`), -1 for a library.
struct IRModule {
    types: [IRType]
    type_rows: [String:Int]
    names: [String]
    name_rows: [String:Int]
    data: [[U8]]
    data_rows: [String:Int]
    functions: [IRFunction]
    function_rows: [String:Int]
    entry: Int
}

fn ir_module_new() -> IRModule Never! {
    IRModule{types: [IRType]{}, type_rows: [String:Int]{}, names: [String]{}, name_rows: [String:Int]{}, data: [[U8]]{}, data_rows: [String:Int]{}, functions: [IRFunction]{}, function_rows: [String:Int]{}, entry: -1}
}

fn ir_kind_name(kind: IRTypeKind) -> String Never! {
    if kind == {
        .Unit -> "Unit"
        .Bool -> "Bool"
        .Int -> "Int"
        .Word -> "Word"
        .Float -> "Float"
        .Float32 -> "Float32"
        .Char -> "Char"
        .String -> "String"
        .Pointer -> "Pointer"
        .Aggregate -> "Aggregate"
    }
}

// The row of `row`'s type, interned by its kind, layout and display key.
fn ir_intern_type(m: &IRModule, key: String, row: IRType) -> Int Never! {
    full :: "{ir_kind_name(row.kind)}:{row.size}:{row.bits}:{row.signed}:{key}"
    found :: m.type_rows.get(full) ?? -1
    if found >= 0 -> return found
    id :: m.types.len()
    &m.types.push(row)
    m.type_rows[full] = id
    id
}

fn ir_intern_name(m: &IRModule, text: String) -> Int Never! {
    found :: m.name_rows.get(text) ?? -1
    if found >= 0 -> return found
    id :: m.names.len()
    &m.names.push(text)
    m.name_rows[text] = id
    id
}

// A read-only data row holding `text`'s bytes (shared by equal texts).
fn ir_intern_text(m: &IRModule, text: String) -> Int Never! {
    found :: m.data_rows.get(text) ?? -1
    if found >= 0 -> return found
    id :: m.data.len()
    &m.data.push(text.bytes())
    m.data_rows[text] = id
    id
}

fn ir_function_new(name: String, key: String, symbol: String, source_file: String, line: Int) -> IRFunction Never! {
    IRFunction{
        name: name, key: key, symbol: symbol, source_file: source_file, line: line,
        param_count: 0, result: -1,
        slot_type: [Int]{}, slot_kind: [IRSlotKind]{}, slot_name: [Int]{}, slot_line: [Int]{},
        op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, code_line: [Int]{}, args: [Int]{},
        open: [Int]{},
    }
}

// A new slot of type row `ty`; parameters must be added first, in order.
fn ir_slot(f: &IRFunction, ty: Int, kind: IRSlotKind, name: Int, line: Int) -> Int Never! {
    id :: f.slot_type.len()
    &f.slot_type.push(ty)
    &f.slot_kind.push(kind)
    &f.slot_name.push(name)
    &f.slot_line.push(line)
    if kind == .Param -> f.param_count += 1
    id
}

fn ir_emit(f: &IRFunction, op: IROp, dst: Int, a: Int, b: Int, c: Int, line: Int) -> Int Never! {
    at :: f.op.len()
    &f.op.push(op)
    &f.dst.push(dst)
    &f.a.push(a)
    &f.b.push(b)
    &f.c.push(c)
    &f.code_line.push(line)
    at
}

// Appends an operand list to the args pool; returns its start.
fn ir_args(f: &IRFunction, values: [Int]) -> Int Never! {
    start :: f.args.len()
    loop value in values -> &f.args.push(value)
    start
}

// Opens a Block or Loop; ir_end closes the innermost open construct.
fn ir_open(f: &IRFunction, op: IROp, line: Int) -> Int Never! {
    at :: ir_emit(&f, op, -1, -1, -1, -1, line)
    &f.open.push(at)
    at
}

fn ir_open_if(f: &IRFunction, condition: Int, line: Int) -> Int Never! {
    at :: ir_emit(&f, IROp.If, -1, condition, -1, -1, line)
    &f.open.push(at)
    at
}

// The Else of the innermost open If.
fn ir_else(f: &IRFunction, line: Int) Never! {
    opener :: f.open[f.open.len() - 1]
    f.b[opener] = ir_emit(&f, IROp.Else, -1, -1, -1, -1, line)
}

fn ir_end(f: &IRFunction, line: Int) Never! {
    opener :: &f.open.pop() ?? panic("ir_end without an open construct")
    end :: ir_emit(&f, IROp.End, -1, opener, -1, -1, line)
    if f.op[opener] == .If {
        f.c[opener] = end
        if f.b[opener] >= 0 -> f.a[f.b[opener]] = end
    } else {
        f.a[opener] = end
    }
}

// The Br depth that reaches the open construct at instruction `target`.
fn ir_depth(f: IRFunction, target: Int) -> Int Never! {
    depth := 0
    index := f.open.len() - 1
    loop index >= 0 {
        if f.open[index] == target -> return depth
        depth += 1
        index -= 1
    }
    panic("ir_depth: {target} is not open")
}

fn ir_op_name(op: IROp) -> String Never! {
    if op == {
        .Nop -> "nop"
        .Const -> "const"
        .ConstText -> "const_text"
        .ConstBigInt -> "const_bigint"
        .Copy -> "copy"
        .Move -> "move"
        .Drop -> "drop"
        .Close -> "close"
        .Add -> "add"
        .Sub -> "sub"
        .Mul -> "mul"
        .Div -> "div"
        .Rem -> "rem"
        .FloorDiv -> "floordiv"
        .Mod -> "mod"
        .BitAnd -> "bitand"
        .BitOr -> "bitor"
        .BitXor -> "bitxor"
        .Shl -> "shl"
        .Shr -> "shr"
        .Eq -> "eq"
        .Ne -> "ne"
        .Lt -> "lt"
        .Le -> "le"
        .Gt -> "gt"
        .Ge -> "ge"
        .Neg -> "neg"
        .Not -> "not"
        .Concat -> "concat"
        .Call -> "call"
        .CallRuntime -> "call_runtime"
        .CallIndirect -> "call_indirect"
        .FunctionAddress -> "function_address"
        .DataAddress -> "data_address"
        .Load -> "load"
        .Store -> "store"
        .StackAddress -> "stack_address"
        .Offset -> "offset"
        .CopyBytes -> "copy_bytes"
        .Block -> "block"
        .Loop -> "loop"
        .If -> "if"
        .Else -> "else"
        .End -> "end"
        .Br -> "br"
        .BrIf -> "br_if"
        .Return -> "return"
        .Unreachable -> "unreachable"
    }
}

// Text form for dumps and diffs: one line per slot, then one per
// instruction, indented by structured nesting. Names and data resolve
// through `m`, so the text is the function's content.
fn ir_function_text(m: IRModule, f: IRFunction) -> String Never! {
    lines := [String]{"fn {f.name} [{f.key}] params={f.param_count} result={f.result}"}
    loop slot in 0..<f.slot_type.len() {
        name :: if f.slot_name[slot] >= 0 -> m.names[f.slot_name[slot]] else -> "_"
        kind :: if f.slot_kind[slot] == {
            .Param -> "param"
            .Local -> "local"
            .Temp -> "temp"
        }
        ty :: m.types[f.slot_type[slot]]
        &lines.push("  s{slot} {kind} {name}: {ir_kind_name(ty.kind)}/{ty.size}")
    }
    depth := 1
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        if op == .End || op == .Else -> depth -= 1
        pad := ""
        loop _ in 0..<depth -> pad = "{pad}  "
        text := "{pad}{at}: {ir_op_name(op)}"
        if f.dst[at] >= 0 -> text = "{text} s{f.dst[at]} <-"
        if op == .CallRuntime -> text = "{text} {m.names[f.a[at]]}" else -> text = "{text} {f.a[at]} {f.b[at]} {f.c[at]}"
        if op == .Call || op == .CallRuntime || op == .CallIndirect {
            operands := [String]{}
            loop index in f.b[at]..<(f.b[at] + f.c[at]) -> &operands.push("s{f.args[index]}")
            text = "{text} ({operands.join(", ")})"
        }
        if op == .Call && f.a[at] >= 0 && f.a[at] < m.functions.len() -> text = "{text} ; {m.functions[f.a[at]].key}"
        &lines.push(text)
        if op == .Block || op == .Loop || op == .If || op == .Else -> depth += 1
    }
    lines.join("\n")
}

// The function's content key: SHA-256 of its text form, which spells every
// interned id by content.
fn ir_function_hash(m: IRModule, f: IRFunction) -> String Never! {
    mir_sha256_hex(ir_function_text(m, f))
}
