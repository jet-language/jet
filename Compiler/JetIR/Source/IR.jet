// Jet IR: the one intermediate form between the checked program and machine
// code. One flat arena per function, no SSA: a slot is a mutable typed
// variable, every instruction reads slots and writes at most one slot, and
// control flow is structured (Block, Loop, If/Else, End, Br, BrIf, Return).
// Storage is struct-of-arrays with integer ids: no per-instruction or
// per-slot heap allocation, and an instruction's operands are three Int
// fields plus one shared args pool for variable-length operand lists.
//
// Instruction operands (`dst`, `a`, `b`, `c`; -1 when unused):
//   Nop                                        nothing
//   Const        dst  a=value                  Int/IntN/Bool (0|1)/Char value,
//                                              Float/Float32 IEEE bits; an exact
//                                              Int constant is inline (fits 62 bits)
//   ConstText    dst  a=data row               the immortal static String of the
//                                              data row's bytes (its drop is a no-op)
//   ConstBigInt  dst  a=name (decimal text)    exact Int outside the inline range
//   Copy         dst  a=slot                   duplicate of a copyable value
//   Move         dst  a=slot                   ownership transfer; `a` is dead after
//   Drop         a=slot                        runs the value's drop; dead after
//   Close        a=slot b=name (close routine) runs the routine on the slot; dead after
//   Add Sub Mul Div Rem FloorDiv Mod           dst  a=left b=right c=overflow
//   BitAnd BitOr BitXor Shl Shr                (IR_OVERFLOW_*); the left operand's
//                                              slot type selects the semantics:
//                                              exact Int spills to big integers,
//                                              IntN traps or wraps per `c`,
//                                              Float is IEEE
//   Eq Ne Lt Le Gt Ge                          dst(Bool) a=left b=right
//   Neg Not                                    dst  a=operand
//   Sqrt         dst  a=operand                IEEE square root of a Float or
//                                              Float32 (correctly rounded)
//   IntBig       dst(Bool) a=Int slot b=bits   whether the exact Int is a big
//                                              integer or an inline word outside
//                                              the signed `b`-bit range
//                                              (2..=IR_INT_INLINE_BITS, which is
//                                              every inline word; a pass's
//                                              guard; Build emits none)
//   Convert      dst  a=operand                numeric conversion by the slot
//                                              types: Float/Float32 to a Word
//                                              truncates toward zero (signed
//                                              64-bit, then wrapped to the
//                                              Word; NaN and out of range give
//                                              the minimum), a Word to a Float
//                                              reads the word as signed 64-bit
//                                              and rounds to nearest, Float to
//                                              Float32 rounds, Float32 to Float
//                                              is exact
//   Concat       dst  a=left b=right           String + String (new owned String)
//   Call         dst? a=function b=args c=count
//   CallRuntime  dst? a=name (symbol) b=args c=count
//   CallIndirect dst? a=callee slot b=args c=count
//                                              a function value's call: its
//                                              code's row is IR_CODE_TYPE over
//                                              the function type, the args its
//                                              box then its parameters; any
//                                              other callee is a plain pointer
//   FunctionAddress dst a=function
//   DataAddress  dst  a=data row
//   Load         dst  a=base pointer slot b=byte offset
//   Store        a=base pointer slot b=byte offset c=value slot
//   StreamStore  a=base pointer slot b=byte offset c=value slot
//                                              Store's write without filling the
//                                              cache (non-temporal) where the
//                                              target has such a store for the
//                                              value's width, else a Store. Every
//                                              function holding one fences those
//                                              writes before each call and its
//                                              return, so no other code observes
//                                              them out of order
//   StackAddress dst  a=size b=align           frame storage, live to return
//                                              (one area per instruction)
//   Offset       dst  a=pointer slot b=bytes   the address a + b
//   CopyBytes    a=dst pointer b=src pointer c=byte count
// Load and Store move the value slot's layout (IRType.size bytes, sign- or
// zero-extended per IRType.signed for a Word). An Aggregate slot holds a
// pointer to the value's bytes: an Aggregate parameter is the caller's
// pointer; a call with an Aggregate result passes caller frame storage as
// the hidden first argument and its dst receives that pointer; returning
// an Aggregate copies its bytes through the hidden pointer.
//   Block        a=index of its End
//   Loop         a=index of its End            Br to a Loop restarts it
//   If           a=condition slot b=index of its Else (-1) c=index of its End
//   Else         a=index of its End
//   End          a=index of its opener
//   Br           a=depth                       0 = innermost open Block/Loop/If;
//                                              leaves a Block/If past its End,
//                                              restarts a Loop
//   BrIf         a=condition slot b=depth
//   Return       a=slot (-1 for none)
//   Unreachable                                control never gets here
//
// Calls and runtime routes use the System V ABI of the existing x86-64
// selector; runtime symbols are the old backend's, so a program behaves the
// same on both paths.

use jet_foundation.[NameRows, TComptimeValue, Type, TypeTable, name_rows, name_rows_get, name_rows_hash, name_rows_set, name_rows_set_hashed, name_rows_value, sha256_bytes, sha256_hex, sha256_hex_bytes, stable_id]

IROp: enum {
    Nop
    Const
    ConstText
    ConstBigInt
    Copy
    Move
    Drop
    Close
    Add
    Sub
    Mul
    Div
    Rem
    FloorDiv
    Mod
    BitAnd
    BitOr
    BitXor
    Shl
    Shr
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
    Neg
    Not
    Convert
    Concat
    Call
    CallRuntime
    CallIndirect
    FunctionAddress
    DataAddress
    Load
    Store
    StackAddress
    Offset
    CopyBytes
    Block
    Loop
    If
    Else
    End
    Br
    BrIf
    Return
    Unreachable
    Sqrt
    IntBig
    StreamStore
}

// Overflow policy of an arithmetic op on a fixed-width integer (`c`).
// IR_OVERFLOW_OPERANDS marks an exact Int Add, Sub or Mul whose operands
// are proven inline Ints but whose result may not be (OptRange.jet): only
// the result is tested. IR_OVERFLOW_LEFT and IR_OVERFLOW_RIGHT mark one
// whose left or right operand alone is proven inline: that operand's test
// goes, the other's and the result's stay. IR_OVERFLOW_NONNEG marks an
// exact Int Div or Rem that wraps as IR_OVERFLOW_WRAP does and whose
// dividend is also proven nonnegative (OptRange.jet): its truncated quotient
// needs no correction for a negative dividend (X64Select).
IR_OVERFLOW_TRAP: 0
IR_OVERFLOW_WRAP: 1
IR_OVERFLOW_OPERANDS: 2
IR_OVERFLOW_LEFT: 3
IR_OVERFLOW_RIGHT: 4
IR_OVERFLOW_NONNEG: 5

// Whether overflow policy `c` wraps: the plain machine instruction, with no
// test of an operand or the result.
ir_overflow_wraps: fn(c: Int) -> Bool Never! {
    c == IR_OVERFLOW_WRAP || c == IR_OVERFLOW_NONNEG
}

// The stop polls (Build.jet ir_stop_poll): after a call, and after a user
// operation whose slow path can publish a numeric stop.
IR_STOP_POLL_KEY: "jet_ir_stop_poll#asm"
IR_STOP_TRAP_KEY: "jet_ir_stop_trap#asm"

// What a slot holds. `Int` is Jet's exact integer (an inline word whose bits
// 63 and 62 agree, else a big-integer handle); `Word` a fixed-width integer
// (IRType.bits, IRType.signed); `Pointer` a raw address or an owned heap
// carrier the runtime manages (String, List, boxes); `Aggregate` bytes
// passed by hidden pointer (IRType.size).
IRTypeKind: enum { Unit Bool Int Word Float Float32 Char String Pointer Aggregate }

// The System V class of one value.
IRClass: enum { Integer Pointer Float Memory }

// One interned type row: the checked type and its machine layout.
// `drop` is the runtime symbol that ends a value's life ("" when trivial);
// `clone` the one that makes an owned copy of it ("" when none: a value
// with a drop and no clone only moves). `option_word` marks an Option laid
// out as one word, not a box (Build.jet IR_OPTION_INT_NONE).
IRType: struct {
    ty: Type
    kind: IRTypeKind
    size: Int
    align: Int
    class: IRClass
    signed: Bool
    bits: Int
    drop: String
    clone: String{""}
    option_word: Bool{false}
}

IRSlotKind: enum { Param Local Temp }

// IntBig's width for the test that an exact Int is inline at all (its
// bits 63 and 62 agree).
IR_INT_INLINE_BITS: 63

// The checked type name of a function value's code word: the row of the
// word a closure box holds at 8 is a Pointer of type
// `Apply(IR_CODE_TYPE, [the function type])` (BuildCoreClosures.jet
// ir_code_row), so IR Lint checks a CallIndirect through it against that
// signature.
IR_CODE_TYPE: "#code"

// One function's arena. Slots 0..<param_count are the parameters in order.
// `slot_name` is an interned name (-1 for a temporary); `slot_line` the
// source line a variable is declared on (0 none); `line[i]` the source line
// of instruction i (0 none). `result` is a type row, -1 for none. `asm` is
// an `#FFI(asm)` leaf's assembled template (BuildForeign.jet ir_asm_call):
// such a function has Word parameters, no instructions, and its machine
// code is the template's (X64Select.jet ir_x64_asm_function).
// `inline_always` marks a function its source marks `#Inline(Always)`, the
// callees the `inline: always_marked` build option inlines (OptInline.jet).
// `symbol_hash` is the stable id of `key` that ends `symbol` (0: the symbol
// carries no hash; ir_hashed_function).
IRFunction: struct {
    name: String
    key: String
    symbol: String
    source_file: String
    line: Int
    param_count: Int
    result: Int
    slot_type: [Int]
    slot_kind: [IRSlotKind]
    slot_name: [Int]
    slot_line: [Int]
    op: [IROp]
    dst: [Int]
    a: [Int]
    b: [Int]
    c: [Int]
    // Each instruction's source line; from bit 32 up, the inline site it
    // came from (ir_code_line_site; 0: the function's own code).
    code_line: [Int]
    args: [Int]
    // Open structured-control instructions while building (indexes into `op`).
    open: [Int]
    asm: IRAsmLeaf?
    inline_always: Bool
    symbol_hash: U64
    // The counted loops of this body sema's loop proof covers, as built
    // (ir_range_loop).
    loop_proofs: [IRLoopProof]{[IRLoopProof]{}}
    // The source line of each masked branch of this body, as built
    // (BuildMask.jet).
    masked: [Int]{[Int]{}}
    // Code that runs at most once and off the program's work (Opt.jet
    // ir_opt_mark_cold): optimized for size.
    cold: Bool{false}
    // The C symbol a host defines in this runtime export's place
    // (IR_HOST_PROVIDER, set by ir_build_library), else empty.
    host_symbol: String{""}
    // The inline sites of the body (OptInline.jet ir_opt_splice), two words
    // each: the function inlined there and the site it sits in (0: the
    // function's own code). Site s (from 1) is words 2s - 2 and 2s - 1.
    inline_sites: [Int]{[Int]{}}
    // Per slot, whether it holds a `timing: .Fixed` value: the builder marks
    // each scalar slot whose checked type carries a fixed tag
    // (BuildMask.jet ir_fix_slot), a pass that copies a slot copies its bit,
    // and IR Lint follows the values computed from these (Lint.jet
    // ir_lint_fixed). ir_slot adds every slot unmarked.
    slot_fixed: [Bool]{[Bool]{}}
}

// The leaves of the UI provider seam (JetRuntime UiHostProvider.jet), by C
// symbol: the native runtime defines them headless, and a host with its own
// provider (the web, JetWeb Host.jet web_host_functions) defines them in
// their place at every call (JetWeb Select.jet web_direct_call). Inlining
// never takes one (OptInline.jet), so every call stays one the host can
// replace.
IR_HOST_PROVIDER: [String]{
    "jet_ui_provider_capability", "jet_ui_provider_clipboard_get", "jet_ui_provider_clipboard_set",
    "jet_ui_provider_dialog_request", "jet_ui_provider_dialog_result", "jet_ui_provider_event_pop", "jet_ui_provider_key_claim", "jet_ui_provider_take",
}

// One counted loop sema proved (AutoVectorizationFacts, JetSema
// LoopFacts.jet), as its function's build lowered it: its line and index,
// the facts sema recorded, how many list accesses sema proved in bounds
// (`recorded`) and how many of those the build lowered with no bounds check
// (`lowered`). A loop lowers one scalar round per index.
IRLoopProof: struct {
    line: Int
    local: String
    extent: Int
    element: String
    no_aliasing: Bool
    no_early_exit: Bool
    effect_free: Bool
    independent: Bool
    recorded: Int
    lowered: Int
}

// One row per loop proof of `m`'s functions (`jet inspect decisions`, taken
// before the optimizer inlines any): where the loop is, the facts sema
// recorded, and how it lowered.
ir_loop_proof_rows: fn(m: IRModule) -> [String] Never! {
    rows := [String]{}
    loop function in m.functions {
        loop proof in function.loop_proofs {
            facts: "aliasing-free {proof.no_aliasing}, no early exit {proof.no_early_exit}, effect-free {proof.effect_free}, independent {proof.independent}"
            rows.push("loop {function.name} {function.source_file}:{proof.line} `{proof.local}` below {proof.extent} of {proof.element}: {facts}; lowered scalar, proven accesses {proof.recorded}, unchecked {proof.lowered}")
        }
    }
    rows
}

// One row per masked branch of `m`'s functions (`jet inspect decisions`,
// taken before the optimizer inlines any): a branch on a `timing: .Fixed`
// value whose arms both run, the result chosen with a masked select.
ir_masked_branch_rows: fn(m: IRModule) -> [String] Never! {
    rows := [String]{}
    loop function in m.functions {
        loop line in function.masked -> rows.push("masked {function.name} {function.source_file}:{line}: both arms run, the result is a masked select")
    }
    rows
}

// An assembled `#FFI(asm)` template: its bytes, the register operand i is
// bound to (`regs[i]`), and the register holding its result (-1 for none).
IRAsmLeaf: struct {
    code: [U8]
    regs: [Int]
    result: Int
}

// A word of a static object (IRModule.data_relocs) that holds an address:
// data row `target` plus `addend` bytes, or (`text`) the immortal String of
// data row `target`'s bytes, the same value a ConstText of that row gives.
IRDataReloc: struct { offset: Int, target: Int, addend: Int, text: Bool }

// The program: interned types and names, read-only data rows, functions.
// Every String-keyed table is a hashed `NameRows` (JetFoundation AST/Names:
// one hash and one compare per lookup); a table whose values are lists keys
// an index into a list column beside it.
// `type_keys[row]` is type row `row`'s intern key (ir_row_key);
// `key_rows` indexes `key_lists`, the rows ir_intern_type gave each display
// key (they differ in layout), so a repeated intern compares layouts, not keys.
// `data_relocs` names the data rows that are static objects (8-byte
// aligned; BuildStatic.jet) and the words in them that hold an address;
// `constant_rows` maps "<constant key>|<type key>" to the static object
// holding that constant's value (-1: it is built at each read).
// `function_rows` maps a function key to its id (row of `functions`);
// `entry` is the program entry (`run: fn`), -1 for a library. `layouts`,
// `layout_low`, `struct_members`, `variant_members`, `enum_sizes`,
// `handle_rows`, `value_types` and `value_rows` are the builder's layout memo
// (BuildTypes.jet ir_struct_row, ir_struct_members, ir_variant_members,
// ir_enum_box_size, ir_handle_row, ir_value_type_in): a
// struct instance's row by identity (-1 when it does not lay out) and its
// resolved members (an index into `member_lists`), an enum instance variant's
// members (likewise) by "<declaration row>|<identity>#<index>" and its box
// size by "<declaration row>|<identity>",
// each type interned in `value_types`, by its index, with no struct being
// laid out (-1: none; -2: being laid out). `close_free` holds
// the type rows BuildOwn.jet ir_close_parts_reach proved free of a Close
// method at any depth. `scalar_rows` holds the row of each scalar checked
// type by its BuildTypes.jet ir_scalar_code (-1: not interned yet).
// The build state (Build.jet): `ids` maps a checked function row to the IR
// function id of the non-generic function (-1: not queued yet), `instances`
// a generic instance's key (function key and type arguments) to its id;
// `queue` holds the functions waiting to be built and `lambdas` the lambda
// bodies they build; `close_glue` the close glue built per glue key
// (BuildOwn.jet; -1: the type closes nothing, -2: its glue failed);
// `helper_errors` the message of a helper whose body failed (an index into
// `helper_messages`), by helper key, which every later use reports again;
// `trait_keys` a boxed trait value's
// payload key by concrete type identity (BuildTraits.jet ir_trait_key).
// `stop_points`: calls that can deliver a
// runtime stop are followed by a stop check (Build.jet ir_stop_check); the
// runtime library manages its own stops and has none, nor has a program that
// owns its main. `owned_main`: the program's entry runs under a main of its
// own, with no process root (EntryOwned.jet ir_entry_own). `owned_attach`:
// that main attaches its thread first (IR_OWNED_ATTACH_ROUTES).
// `single_thread`: the program provably never runs a second thread (JetCli
// Host.jet jet_cli_single_thread), so x86-64 selection updates its RC
// counts without the lock prefix; false for the runtime library.
// `debug_directory`: the compilation directory the image's DWARF records
// ("": the working directory), which relative source paths (a fault
// report's) resolve from. `host_literals`: the compile-time literals that are
// compiler values (BuildTypes.jet ir_host_literal), by the key their host
// route names, which the compiler answers from the built module.
// `struct_fields`: the merged module's struct members, one
// `field <identity> <offset> <size> <member> <type>` line per stored member
// of each struct the program reached (BuildMerge.jet ir_merge), for the
// emission log; `<type>` is the member's checked type (`box` for a boxed
// one), last since it may hold spaces.
IRModule: struct {
    types: [IRType]
    type_keys: [String]
    type_rows: NameRows
    key_rows: NameRows
    key_lists: [[Int]]
    names: [String]
    name_rows: NameRows
    data: [[U8]]
    data_rows: NameRows
    data_relocs: [Int:[IRDataReloc]]
    constant_rows: NameRows
    functions: [IRFunction]
    function_rows: NameRows
    entry: Int
    // The rows `dead_code: keep` builds as roots beside `entry`
    // (ir_build_program): the object keeps them though nothing calls them.
    kept: [Int]{[Int]{}}
    layouts: NameRows
    layout_low: Int
    struct_members: NameRows
    variant_members: NameRows
    member_lists: [[IRMember]]
    enum_sizes: NameRows
    handle_rows: NameRows
    value_types: TypeTable{TypeTable{}}
    value_rows: [Int]{[Int]{}}
    close_free: [Int:Bool]
    scalar_rows: [Int]
    ids: [Int]
    instances: NameRows
    queue: [IRQueued]
    lambdas: [IRLambdaJob]
    close_glue: NameRows
    helper_errors: NameRows
    helper_messages: [String]
    trait_keys: NameRows
    stop_points: Bool{false}
    owned_main: Bool{false}
    owned_attach: Bool{false}
    single_thread: Bool{false}
    debug_directory: String{""}
    host_literals: [String:TComptimeValue]{[String:TComptimeValue]{}}
    struct_fields: [String]{[String]{}}
}

ir_module_new: fn() -> IRModule Never! {
    IRModule{types: [IRType]{}, type_keys: [String]{}, type_rows: name_rows(), key_rows: name_rows(), key_lists: [[Int]]{}, names: [String]{}, name_rows: name_rows(), data: [[U8]]{}, data_rows: name_rows(), data_relocs: [Int:[IRDataReloc]]{}, constant_rows: name_rows(), functions: [IRFunction]{}, function_rows: name_rows(), entry: -1, layouts: name_rows(), layout_low: 0, struct_members: name_rows(), variant_members: name_rows(), member_lists: [[IRMember]]{}, enum_sizes: name_rows(), handle_rows: name_rows(), close_free: [Int:Bool]{}, scalar_rows: [Int]{}, ids: [Int]{}, instances: name_rows(), queue: [IRQueued]{}, lambdas: [IRLambdaJob]{}, close_glue: name_rows(), helper_errors: name_rows(), helper_messages: [String]{}, trait_keys: name_rows()}
}

ir_kind_name: fn(kind: IRTypeKind) -> String Never! {
    if kind == {
        .Unit -> "Unit"
        .Bool -> "Bool"
        .Int -> "Int"
        .Word -> "Word"
        .Float -> "Float"
        .Float32 -> "Float32"
        .Char -> "Char"
        .String -> "String"
        .Pointer -> "Pointer"
        .Aggregate -> "Aggregate"
    }
}

// The row of `row`'s type, interned by its kind, layout and display key.
ir_intern_type: fn(m: &IRModule, key: String, row: IRType) -> Int Never! {
    hash: name_rows_hash(key)
    listed: name_rows_get(m.key_rows, key, hash) ?? -1
    if listed >= 0 {
        loop index in m.key_lists[listed] {
            if m.types[index].kind == row.kind && m.types[index].size == row.size && m.types[index].bits == row.bits && m.types[index].signed == row.signed -> return index
        }
    }
    full: "{ir_kind_name(row.kind)}:{row.size}:{row.bits}:{row.signed}:{key}"
    full_hash: name_rows_hash(full)
    found := name_rows_get(m.type_rows, full, full_hash) ?? -1
    if found < 0 {
        found = m.types.len()
        m.types.push(row.copy())
        m.type_keys.push(full.copy())
        name_rows_set_hashed(m.type_rows, full, full_hash, found)
    }
    if listed >= 0 {
        m.key_lists[listed].push(found)
    } else {
        name_rows_set_hashed(m.key_rows, key, hash, m.key_lists.len())
        m.key_lists.push([Int]{found})
    }
    found
}

// A type row's identity by content (its ir_intern_type key): the same in
// every module that interns the type, whatever row it got there. Helper
// keys spell a type row by it, never by the row.
ir_row_key: fn(m: IRModule, row: Int) -> String Never! {
    m.type_keys[row].copy()
}

// A function whose symbol is `prefix` and then its key's 64-bit stable
// FNV-1a id as 16 lowercase hex digits, so a helper's or instance's symbol
// does not depend on the order the build reached it in. Two keys can hash
// alike; ir_merge stops the build when two merged functions do.
ir_hashed_function: fn(name: String, key: String, prefix: String, source_file: String, line: Int) -> IRFunction Never! {
    hash: stable_id("ir.symbol", key)
    symbol := [U8]{}
    symbol.try_reserve(prefix.len() + 16) ?? panic("symbol allocation failed")
    loop byte in prefix.bytes() -> symbol.push(byte)
    // Most significant nibble first: each rotate brings the next one down.
    rest := hash
    loop _ in 0..<16 {
        rest = rest.rotate_left(4)
        nibble: Int.from_u64(rest.bit_and(U64{15}))
        symbol.push(if nibble < 10 -> U8{48 + nibble} else -> U8{87 + nibble})
    }
    made := ir_function_new(name, key, String.from_bytes(symbol) ?? panic("symbol bytes are UTF-8"), source_file, line)
    made.symbol_hash = hash
    made
}

ir_intern_name: fn(m: &IRModule, text: String) -> Int Never! {
    hash: name_rows_hash(text)
    found: name_rows_get(m.name_rows, text, hash) ?? -1
    if found >= 0 -> return found
    id: m.names.len()
    name_rows_set_hashed(m.name_rows, text, hash, id)
    m.names.push(text.copy())
    id
}

// A read-only data row holding `text`'s bytes (shared by equal texts).
ir_intern_text: fn(m: &IRModule, text: String) -> Int Never! {
    hash: name_rows_hash(text)
    found: name_rows_get(m.data_rows, text, hash) ?? -1
    if found >= 0 -> return found
    id: m.data.len()
    m.data.push(text.bytes())
    name_rows_set_hashed(m.data_rows, text, hash, id)
    id
}

// A read-only data row holding `bytes` (shared by equal byte strings: keyed
// by length and digest, linear in the bytes however large the table).
ir_intern_bytes: fn(m: &IRModule, bytes: [U8]) -> Int Never! {
    key: "bytes:{bytes.len()}:{sha256_hex_bytes(sha256_bytes(bytes[0..<bytes.len()]))}"
    hash: name_rows_hash(key)
    found: name_rows_get(m.data_rows, key, hash) ?? -1
    if found >= 0 -> return found
    id: m.data.len()
    m.data.push(bytes.copy())
    name_rows_set_hashed(m.data_rows, key, hash, id)
    id
}

// Records `message` as the failure of helper `key`, which every later use
// of the helper reports again (ir_helper_error).
ir_helper_failed: fn(m: &IRModule, key: String, message: String) Never! {
    name_rows_set(m.helper_errors, key, m.helper_messages.len())
    m.helper_messages.push(message.copy())
}

ir_helper_error: fn(m: IRModule, key: String) -> String? Never! {
    index: name_rows_value(m.helper_errors, key) ?? return None
    Val(m.helper_messages[index].copy())
}

// The members memoized under `memo` in `table` (an index into
// m.member_lists), if any.
ir_members_memo: fn(m: IRModule, table: NameRows, memo: String) -> [IRMember]? Never! {
    index: name_rows_value(table, memo) ?? return None
    Val(m.member_lists[index].copy())
}

ir_function_new: fn(name: String, key: String, symbol: String, source_file: String, line: Int) -> IRFunction Never! {
    IRFunction{
        name: name, key: key, symbol: symbol, source_file: source_file, line: line,
        param_count: 0, result: -1,
        slot_type: [Int]{}, slot_kind: [IRSlotKind]{}, slot_name: [Int]{}, slot_line: [Int]{},
        op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, code_line: [Int]{}, args: [Int]{},
        open: [Int]{}, asm: None, inline_always: false, symbol_hash: U64{0},
    }
}

// A new slot of type row `ty`; parameters must be added first, in order.
ir_slot: fn(f: &IRFunction, ty: Int, kind: IRSlotKind, name: Int, line: Int) -> Int Never! {
    id: f.slot_type.len()
    f.slot_type.push(ty)
    f.slot_kind.push(kind.copy())
    f.slot_name.push(name)
    f.slot_line.push(line)
    f.slot_fixed.push(false)
    if kind == .Param -> f.param_count += 1
    id
}

ir_emit: fn(f: &IRFunction, op: IROp, dst: Int, a: Int, b: Int, c: Int, line: Int) -> Int Never! {
    at: f.op.len()
    f.op.push(op.copy())
    f.dst.push(dst)
    f.a.push(a)
    f.b.push(b)
    f.c.push(c)
    f.code_line.push(line)
    at
}

// Code line bit 32 (IRFunction.code_line): the inline site starts there.
IR_CODE_LINE_SITE: 4294967296

// The source line of code line `line`, without its inline site.
ir_code_line_source: fn(line: Int) -> Int Never! {
    if line >= IR_CODE_LINE_SITE -> line %% IR_CODE_LINE_SITE else -> line
}

// The inline site of code line `line` (IRFunction.inline_sites), 0 for the
// function's own code.
ir_code_line_site: fn(line: Int) -> Int Never! {
    if line >= IR_CODE_LINE_SITE -> line /% IR_CODE_LINE_SITE else -> 0
}

// Code line `line`'s source line at inline site `site`. A line below 0
// names no source line and takes no site.
ir_code_line_at: fn(line: Int, site: Int) -> Int Never! {
    source: ir_code_line_source(line)
    if source < 0 -> source else -> source + site * IR_CODE_LINE_SITE
}

// Appends an operand list to the args pool; returns its start.
ir_args: fn(f: &IRFunction, values: [Int]) -> Int Never! {
    start: f.args.len()
    loop value in values -> f.args.push(value)
    start
}

// Opens a Block or Loop; ir_end closes the innermost open construct.
ir_open: fn(f: &IRFunction, op: IROp, line: Int) -> Int Never! {
    at: ir_emit(f, op, -1, -1, -1, -1, line)
    f.open.push(at)
    at
}

ir_open_if: fn(f: &IRFunction, condition: Int, line: Int) -> Int Never! {
    at: ir_emit(f, IROp.If, -1, condition, -1, -1, line)
    f.open.push(at)
    at
}

// The Else of the innermost open If.
ir_else: fn(f: &IRFunction, line: Int) Never! {
    opener: f.open[f.open.len() - 1]
    f.b[opener] = ir_emit(f, IROp.Else, -1, -1, -1, -1, line)
}

ir_end: fn(f: &IRFunction, line: Int) Never! {
    opener: f.open.pop() ?? panic("ir_end without an open construct")
    end: ir_emit(f, IROp.End, -1, opener, -1, -1, line)
    if f.op[opener] == .If {
        f.c[opener] = end
        if f.b[opener] >= 0 -> f.a[f.b[opener]] = end
    } else {
        f.a[opener] = end
    }
}

// The Br depth that reaches the open construct at instruction `target`.
ir_depth: fn(f: IRFunction, target: Int) -> Int Never! {
    depth := 0
    index := f.open.len() - 1
    loop index >= 0 {
        if f.open[index] == target -> return depth
        depth += 1
        index -= 1
    }
    panic("ir_depth: {target} is not open")
}

ir_op_name: fn(op: IROp) -> String Never! {
    if op == {
        .Nop -> "nop"
        .Const -> "const"
        .ConstText -> "const_text"
        .ConstBigInt -> "const_bigint"
        .Copy -> "copy"
        .Move -> "move"
        .Drop -> "drop"
        .Close -> "close"
        .Add -> "add"
        .Sub -> "sub"
        .Mul -> "mul"
        .Div -> "div"
        .Rem -> "rem"
        .FloorDiv -> "floordiv"
        .Mod -> "mod"
        .BitAnd -> "bitand"
        .BitOr -> "bitor"
        .BitXor -> "bitxor"
        .Shl -> "shl"
        .Shr -> "shr"
        .Eq -> "eq"
        .Ne -> "ne"
        .Lt -> "lt"
        .Le -> "le"
        .Gt -> "gt"
        .Ge -> "ge"
        .Neg -> "neg"
        .Not -> "not"
        .Convert -> "convert"
        .Concat -> "concat"
        .Call -> "call"
        .CallRuntime -> "call_runtime"
        .CallIndirect -> "call_indirect"
        .FunctionAddress -> "function_address"
        .DataAddress -> "data_address"
        .Load -> "load"
        .Store -> "store"
        .StackAddress -> "stack_address"
        .Offset -> "offset"
        .CopyBytes -> "copy_bytes"
        .Block -> "block"
        .Loop -> "loop"
        .If -> "if"
        .Else -> "else"
        .End -> "end"
        .Br -> "br"
        .BrIf -> "br_if"
        .Return -> "return"
        .Unreachable -> "unreachable"
        .Sqrt -> "sqrt"
        .IntBig -> "int_big"
        .StreamStore -> "stream_store"
    }
}

// The op's position in IROp, for keys built of Ints.
ir_op_code: fn(op: IROp) -> Int Never! {
    if op == {
        .Nop -> 0
        .Const -> 1
        .ConstText -> 2
        .ConstBigInt -> 3
        .Copy -> 4
        .Move -> 5
        .Drop -> 6
        .Close -> 7
        .Add -> 8
        .Sub -> 9
        .Mul -> 10
        .Div -> 11
        .Rem -> 12
        .FloorDiv -> 13
        .Mod -> 14
        .BitAnd -> 15
        .BitOr -> 16
        .BitXor -> 17
        .Shl -> 18
        .Shr -> 19
        .Eq -> 20
        .Ne -> 21
        .Lt -> 22
        .Le -> 23
        .Gt -> 24
        .Ge -> 25
        .Neg -> 26
        .Not -> 27
        .Convert -> 28
        .Concat -> 29
        .Call -> 30
        .CallRuntime -> 31
        .CallIndirect -> 32
        .FunctionAddress -> 33
        .DataAddress -> 34
        .Load -> 35
        .Store -> 36
        .StackAddress -> 37
        .Offset -> 38
        .CopyBytes -> 39
        .Block -> 40
        .Loop -> 41
        .If -> 42
        .Else -> 43
        .End -> 44
        .Br -> 45
        .BrIf -> 46
        .Return -> 47
        .Unreachable -> 48
        .Sqrt -> 49
        .IntBig -> 50
        .StreamStore -> 51
    }
}

// Text form for dumps and diffs: one line per slot (a fixed one ends in
// `fixed`, IRFunction.slot_fixed), then one per instruction, indented by
// structured nesting. Names and data resolve through `m`, so the text is
// the function's content.
ir_function_text: fn(m: IRModule, f: IRFunction) -> String Never! {
    lines := [String]{"fn {f.name} [{f.key}] params={f.param_count} result={f.result}"}
    if f.asm == .Val(leaf) {
        code: loop byte in leaf.code -> "{byte}"
        regs: loop register in leaf.regs -> "{register}"
        lines.push("  asm regs=[{regs.join(",")}] result={leaf.result} code=[{code.join(",")}]")
    }
    loop slot in 0..<f.slot_type.len() {
        name: if f.slot_name[slot] >= 0 -> m.names[f.slot_name[slot]] else -> "_"
        kind: if f.slot_kind[slot] == {
            .Param -> "param"
            .Local -> "local"
            .Temp -> "temp"
        }
        ty: m.types[f.slot_type[slot]]
        fixed: if f.slot_fixed[slot] -> " fixed" else -> ""
        lines.push("  s{slot} {kind} {name}: {ir_kind_name(ty.kind)}/{ty.size}{fixed}")
    }
    depth := 1
    loop at in 0..<f.op.len() {
        op: f.op[at]
        if op == .End || op == .Else -> depth -= 1
        pad := ""
        loop _ in 0..<depth -> pad = "{pad}  "
        text := "{pad}{at}: {ir_op_name(op)}"
        if f.dst[at] >= 0 -> text = "{text} s{f.dst[at]} <-"
        if op == .CallRuntime -> text = "{text} {m.names[f.a[at]]}" else -> text = "{text} {f.a[at]} {f.b[at]} {f.c[at]}"
        if op == .Call || op == .CallRuntime || op == .CallIndirect {
            operands := [String]{}
            loop index in f.b[at]..<(f.b[at] + f.c[at]) -> operands.push("s{f.args[index]}")
            text = "{text} ({operands.join(", ")})"
        }
        if op == .Call && f.a[at] >= 0 && f.a[at] < m.functions.len() -> text = "{text} ; {m.functions[f.a[at]].key}"
        lines.push(text)
        if op == .Block || op == .Loop || op == .If || op == .Else -> depth += 1
    }
    lines.join("\n")
}

// The function's content key: SHA-256 of its text form, which spells every
// interned id by content.
ir_function_hash: fn(m: IRModule, f: IRFunction) -> String Never! {
    sha256_hex(ir_function_text(m, f))
}
