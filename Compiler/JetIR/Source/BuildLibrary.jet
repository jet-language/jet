// The native library feed (the runtime pack's Jet object): the checked
// functions of a program rooted at the entry module's `#Export(c)`
// functions, never at a startup entry (a `run: fn` is one more export when
// it is `#Export(c)`). Its exports are exactly those rows under the C
// export law; no list, name heuristic or source scan selects them. The
// lifecycle list (Compiler/JetRuntime/lifecycle.list) only orders the
// constructor/destructor hooks among them. The runtime's intrinsics (float
// bit casts, static texts, export addresses, the fault report's machine
// code) are recognized by name and validated by signature here; ir_call
// builds each call of one as its machine operation (ir_intrinsic_call).
use {
    jet_backend.[LINK_FAULT_REPORT, X64DataExport, X64_ALLOC_ROOT_SYMBOL, X64_DEBUG_EVAL_STORAGE, X64_OBSERVE_ROOT_SYMBOL, x64_debug_eval_symbol]
    jet_foundation.[Interner, AccessConvention, CompilerThreads, DeclTable, NameTable, RUNTIME_PROVIDER_HOOKS, Span, BodyCallArg, SymbolTable, TConstantDef, FnBody, TImplDef, TTypeDef, Type, foundation_json_quote, name_column, name_column_get, name_column_set, name_column_table, name_column_value]
    jet_sema.[SemaCheckedForeignFunction]
}

// One `#Export(c)` row of the entry module: its checked function's key and
// its C symbol.
IRLibraryExportRow: struct {
    key: String,
    symbol: String,
}

// One global symbol of the library object: IR function `function`, its
// constructor/destructor priority (-1: not a hook), and the data rows of
// its hook's guards (none: an unconditional hook; ir_lifecycle_rows).
IRLibraryExport: struct {
    function: Int,
    symbol: String,
    init_priority: Int,
    fini_priority: Int,
    guards: [Int],
}

// The C ABI of an export: the layout of each parameter and of its result
// (None: void), as the runtime ABI receipt records it.
IRExportLayout: struct {
    size: Int,
    align: Int,
    class: String,
}

IRExportABI: struct {
    symbol: String,
    parameters: [IRExportLayout],
    result: IRExportLayout?,
}

// `errors` are the export, lifecycle and intrinsic problems (the module is
// empty when there is any); `failures` the functions the builder could not
// build. `abis` is sorted by symbol. `data` are the global data symbols of
// the library object: the runtime storage a program's inline code reads.
IRLibraryResult: struct {
    program: IRModule,
    failures: [IRBuildFailure],
    errors: [String],
    exports: [IRLibraryExport],
    data: [X64DataExport],
    abis: [IRExportABI],
}

IRRuntimeIntrinsic: enum {
    FloatBits,
    FloatFromBits,
    FunctionAddress(key: String),
    StaticText,
    FaultReport,
    TypeSize,
    ListCapacity,
    ListReserveExact,
    ListAppend,
    ListCopy,
    VolatileRead,
    VolatileWrite,
    StreamStore,
    PtrOffset,
    PtrByteOffset,
    ViewFromRaw,
    MemCopy,
    MemFill,
    AllocRaw,
    FreeRaw,
    Mapped,
    Unmapping,
    RegionReserve,
    RegionRelease,
    ContextTake,
    ContextGive,
    ContextRoom,
}

// The IEEE bits of a Float as an I64, and back.
// The code address of the exported function `key`.
// The immortal String of a literal (the value a ConstText gives).
// A call of the fault report the linker writes (ir_fault_report_call).
// Core's core.mem operations at their instance's one type argument
// (Build.jet IR_CORE_INTRINSICS): the List stride, a List's capacity,
// an exact List reserve, a List's bulk append from and copy out to a raw
// pointer, a volatile load or store, a streaming store,
// a raw pointer's step by elements or by bytes, a raw block copy or fill;
// a View over raw elements, at its element and owner type arguments;
// and, with no type argument, a raw heap allocation and its release, the
// memory sentry's account of a fresh and of a going OS mapping, a
// region's reserve and release of fresh pages, and `context.allocator`'s
// take, give and room of a block.

IRIntrinsicShape: enum {
    FloatBits,
    FloatFromBits,
    FunctionAddress(symbol: String, arity: Int),
    StaticText,
    FaultReport,
}

// The intrinsics of a program by function key (IRProgram.intrinsics): each
// key's row of `values` at its id in `keys`.
IRIntrinsics: struct {
    keys: NameTable,
    rows: [Int],
    values: [IRRuntimeIntrinsic],
}

ir_intrinsics: fn() -> IRIntrinsics Never! {
    IRIntrinsics{keys: name_column_table(), rows: name_column(), values: [IRRuntimeIntrinsic]{}}
}

// Makes function `key` the intrinsic `intrinsic`, in place of any it was.
ir_intrinsics_put: fn(table: &IRIntrinsics, key: String, intrinsic: &&IRRuntimeIntrinsic) Never! {
    if name_column_get(table.keys, table.rows, key) == .Val(row) {
        table.values[row] = intrinsic.move()
        return
    }
    name_column_set(table.keys, table.rows, key, table.values.len())
    table.values.push(intrinsic.move())
}

// The intrinsic function `key` of `p` is, if it is one.
ir_intrinsic_of: fn(p: IRProgram, key: String) -> IRRuntimeIntrinsic? Never! {
    row: name_column_get(p.intrinsics.keys, p.intrinsics.rows, key) ?? return None
    Val(p.intrinsics.values[row])
}

IRIntrinsicSpec: struct {
    name: String,
    shape: IRIntrinsicShape,
}

IRLifecycle: struct {
    init_priority: Int,
    fini_priority: Int,
    guards: [String],
}

// The lifecycle rows by export symbol (ir_lifecycle_rows): each symbol's
// row of `hooks` at its id in `keys`.
IRLifecycles: struct {
    keys: NameTable,
    rows: [Int],
    hooks: [IRLifecycle],
}

// The lifecycle row of export `symbol`, if it has one.
ir_lifecycle_of: fn(lifecycle: IRLifecycles, symbol: String) -> IRLifecycle? Never! {
    row: name_column_get(lifecycle.keys, lifecycle.rows, symbol) ?? return None
    Val(lifecycle.hooks[row])
}

// The one reviewed recognizer table; every address row uses the same
// I64-only target validation.
ir_runtime_intrinsic_specs: fn() -> [IRIntrinsicSpec] Never! {
    [IRIntrinsicSpec]{
        {name: "rt_f64_bits", shape: .FloatBits},
        {name: "rt_f64_from_bits", shape: .FloatFromBits},
        {name: "rt_static_text", shape: .StaticText},
        {name: "rt_thread_entry_address", shape: .FunctionAddress{symbol: "jet_rt_thread_entry", arity: 1}},
        {name: "rt_tls_shared_destructor_address", shape: .FunctionAddress{symbol: "jet_rt_tls_shared_destructor", arity: 2}},
        {name: "rt_layout_registry_drop_address", shape: .FunctionAddress{symbol: "jet_rt_layout_registry_drop", arity: 1}},
        {name: "rt_scheduler_worker_address", shape: .FunctionAddress{symbol: "jet_rt_scheduler_worker", arity: 1}},
        {name: "rt_fiber_entry_address", shape: .FunctionAddress{symbol: "jet_rt_fiber_entry", arity: 1}},
        {name: "rt_fiber_lot_wait_address", shape: .FunctionAddress{symbol: "jet_rt_fiber_lot_wait", arity: 4}},
        {name: "rt_fiber_lot_wake_address", shape: .FunctionAddress{symbol: "jet_rt_fiber_lot_wake", arity: 3}},
        {name: "rt_fiber_park_slot_address", shape: .FunctionAddress{symbol: "jet_rt_fiber_park_slot", arity: 3}},
        {name: "rt_fiber_ready_address", shape: .FunctionAddress{symbol: "jet_rt_fiber_ready", arity: 1}},
        {name: "rt_async_entry_invoke_address", shape: .FunctionAddress{symbol: "jet_async_entry_invoke", arity: 2}},
        {name: "rt_async_entry_release_address", shape: .FunctionAddress{symbol: "jet_async_entry_release", arity: 1}},
        {name: "rt_scheduler_timer_address", shape: .FunctionAddress{symbol: "jet_rt_scheduler_timer", arity: 1}},
        {name: "rt_scheduler_monitor_address", shape: .FunctionAddress{symbol: "jet_rt_scheduler_monitor", arity: 1}},
        {name: "rt_comptime_serve_stop_address", shape: .FunctionAddress{symbol: "jet_rt_comptime_serve_stop", arity: 5}},
        {name: "rt_task_exit_run_address", shape: .FunctionAddress{symbol: "jet_rt_task_exit_run", arity: 1}},
        {name: "rt_observe_exit_address", shape: .FunctionAddress{symbol: "jet_rt_observe_exit", arity: 1}},
        {name: "rt_replay_take_turn_address", shape: .FunctionAddress{symbol: "jet_rt_replay_take_turn", arity: 2}},
        {name: "rt_replay_output_verify_address", shape: .FunctionAddress{symbol: "jet_rt_replay_output_verify", arity: 5}},
        {name: "rt_task_exit_settle_address", shape: .FunctionAddress{symbol: "jet_rt_task_exit_settle", arity: 1}},
        {name: "rt_test_capture_print_address", shape: .FunctionAddress{symbol: "jet_rt_test_capture_print_hook", arity: 1}},
        {name: "rt_main_stopped_address", shape: .FunctionAddress{symbol: "jet_rt_main_stopped", arity: 2}},
        {name: "rt_process_stop_claim_address", shape: .FunctionAddress{symbol: "jet_rt_process_stop_claim", arity: 1}},
        {name: "rt_debug_root_stop_address", shape: .FunctionAddress{symbol: "jet_rt_debug_root_stop", arity: 1}},
        {name: "rt_host_env_capture_address", shape: .FunctionAddress{symbol: "jet_rt_host_env_capture", arity: 1}},
        {name: "rt_secret_scrub_address", shape: .FunctionAddress{symbol: "jet_rt_secret_scrub", arity: 1}},
        {name: "rt_alloc_check_take_address", shape: .FunctionAddress{symbol: "jet_rt_alloc_check_take", arity: 2}},
        {name: "rt_alloc_check_give_address", shape: .FunctionAddress{symbol: "jet_rt_alloc_check_give", arity: 3}},
        {name: "rt_alloc_check_sweep_address", shape: .FunctionAddress{symbol: "jet_rt_alloc_check_sweep", arity: 1}},
        {name: "rt_observe_writer_address", shape: .FunctionAddress{symbol: "jet_rt_observe_writer", arity: 1}},
        {name: "rt_observe_start_address", shape: .FunctionAddress{symbol: "jet_rt_observe_start", arity: 1}},
        {name: "rt_log_start_address", shape: .FunctionAddress{symbol: "jet_rt_log_start", arity: 1}},
        {name: "rt_task_panic_publish_address", shape: .FunctionAddress{symbol: "jet_rt_task_panic_publish", arity: 2}},
        {name: "rt_trap_root_address", shape: .FunctionAddress{symbol: "jet_rt_trap_root", arity: 4}},
        {name: "rt_test_scope_record_stop_address", shape: .FunctionAddress{symbol: "jet_rt_test_scope_record_stop", arity: 4}},
        {name: "rt_observe_raw_channels_address", shape: .FunctionAddress{symbol: "jet_rt_observe_raw_channels", arity: 1}},
        {name: "rt_observe_raw_values_address", shape: .FunctionAddress{symbol: "jet_rt_observe_raw_values", arity: 1}},
        {name: "rt_observe_raw_events_address", shape: .FunctionAddress{symbol: "jet_rt_observe_raw_events", arity: 1}},
        {name: "rt_observe_raw_games_address", shape: .FunctionAddress{symbol: "jet_rt_observe_raw_games", arity: 1}},
        {name: "rt_test_capture_abort_address", shape: .FunctionAddress{symbol: "jet_rt_test_capture_abort", arity: 2}},
        {name: "rt_test_suite_state_drop_address", shape: .FunctionAddress{symbol: "jet_rt_test_suite_state_drop", arity: 2}},
        {name: "rt_fault_allocation_drop_address", shape: .FunctionAddress{symbol: "jet_rt_fault_allocation_drop", arity: 2}},
        {name: "rt_fault_check_address", shape: .FunctionAddress{symbol: "jet_rt_fault_check", arity: 1}},
        {name: "rt_context_on_stop_address", shape: .FunctionAddress{symbol: "jet_rt_context_on_stop", arity: 5}},
        {name: "rt_scheduler_pause_park_address", shape: .FunctionAddress{symbol: "jet_rt_scheduler_pause_park", arity: 1}},
        {name: "rt_crypto_entropy_drop_address", shape: .FunctionAddress{symbol: "jet_rt_crypto_entropy_drop", arity: 2}},
        {name: "rt_log_state_drop_address", shape: .FunctionAddress{symbol: "jet_rt_log_state_drop", arity: 2}},
        {name: "rt_journey_destructor_address", shape: .FunctionAddress{symbol: "jet_rt_journey_destructor", arity: 2}},
        {name: "rt_session_tls_destructor_address", shape: .FunctionAddress{symbol: "jet_rt_session_tls_destructor", arity: 2}},
        {name: "rt_world_monotonic_provider_address", shape: .FunctionAddress{symbol: "jet_rt_world_monotonic_provider", arity: 1}},
        {name: "rt_net_poller_worker_address", shape: .FunctionAddress{symbol: "jet_rt_net_poller_worker", arity: 1}},
        {name: "rt_net_unix_connect_worker_address", shape: .FunctionAddress{symbol: "jet_rt_net_unix_connect_worker", arity: 1}},
        {name: "rt_process_execution_worker_address", shape: .FunctionAddress{symbol: "jet_rt_process_execution_worker", arity: 1}},
        {name: "rt_process_spawn_child_address", shape: .FunctionAddress{symbol: "jet_rt_process_spawn_child", arity: 1}},
        {name: "rt_process_signal_mark_address", shape: .FunctionAddress{symbol: "jet_rt_process_signal_mark", arity: 1}},
        {name: "rt_process_signal_restore_address", shape: .FunctionAddress{symbol: "jet_rt_process_signal_restore", arity: 0}},
        {name: "rt_process_signal_dispatcher_address", shape: .FunctionAddress{symbol: "jet_rt_process_signal_dispatcher", arity: 1}},
        {name: "rt_process_signal_interrupts_address", shape: .FunctionAddress{symbol: "jet_rt_process_signal_interrupts", arity: 1}},
        {name: "rt_signal_mark_address", shape: .FunctionAddress{symbol: "jet_rt_signal_mark", arity: 1}},
        {name: "rt_signal_dispatcher_address", shape: .FunctionAddress{symbol: "jet_rt_signal_dispatcher", arity: 1}},
        {name: "rt_thread_synccall_address", shape: .FunctionAddress{symbol: "jet_rt_thread_synccall_signal", arity: 1}},
        {name: "rt_interval_worker_address", shape: .FunctionAddress{symbol: "jet_rt_interval_worker", arity: 1}},
        {name: "rt_after_worker_address", shape: .FunctionAddress{symbol: "jet_rt_after_worker", arity: 1}},
        {name: "rt_timer_int_drop_address", shape: .FunctionAddress{symbol: "jet_rt_timer_int_drop", arity: 1}},
        {name: "rt_realtime_worker_address", shape: .FunctionAddress{symbol: "jet_rt_native_realtime_worker", arity: 1}},
        {name: "rt_fault_signal_address", shape: .FunctionAddress{symbol: "jet_rt_fault_signal", arity: 3}},
        {name: "rt_mapped_lease_break_address", shape: .FunctionAddress{symbol: "jet_rt_mapped_lease_break", arity: 3}},
        {name: "rt_perf_samples_signal_address", shape: .FunctionAddress{symbol: "jet_rt_perf_samples_signal", arity: 3}},
        {name: "rt_perf_zone_turn_address", shape: .FunctionAddress{symbol: "jet_rt_perf_zone_turn", arity: 1}},
        {name: "rt_iter_channel_pull_address", shape: .FunctionAddress{symbol: "jet_rt_native_iter_channel_pull", arity: 2}},
        {name: "rt_iter_channel_release_address", shape: .FunctionAddress{symbol: "jet_rt_native_iter_channel_release", arity: 1}},
        {name: "rt_iter_progress_pull_address", shape: .FunctionAddress{symbol: "jet_rt_native_iter_progress_pull", arity: 2}},
        {name: "rt_iter_progress_release_address", shape: .FunctionAddress{symbol: "jet_rt_native_iter_progress_release", arity: 1}},
        {name: "rt_generator_pull_address", shape: .FunctionAddress{symbol: "jet_rt_native_generator_pull", arity: 2}},
        {name: "rt_generator_release_address", shape: .FunctionAddress{symbol: "jet_rt_native_generator_release", arity: 1}},
        {name: "rt_fault_print", shape: .FaultReport},
    }
}

// Whether `name` is a recognizer row of ir_runtime_intrinsic_specs: a library
// build lowers each call of that function as its own operation, so the
// function's checked body is a stand-in whose value no caller sees (#6777).
ir_runtime_intrinsic: fn(name: String) -> Bool Never! {
    if !name.starts_with("rt_") -> return false
    loop spec in ir_runtime_intrinsic_specs() {
        if spec.name == name -> return true
    }
    false
}

// Builds the library of `rows` (the entry module's `#Export(c)` rows, in
// declaration order) and every function they reach, on up to `threads`
// threads (ir_build_waves); the other inputs as ir_build_program's. A row
// whose function does not satisfy the C export law is not an export.
// `lifecycle_rows` are the lines of the lifecycle list (ir_lifecycle_rows).
ir_build_library: fn(functions: &&[FnBody], decls: DeclTable, symbols: &&SymbolTable, interner: &&Interner, type_defs: &&[TTypeDef], impls: &&[TImplDef], sources: &&IRSourceTexts, constants: &&[TConstantDef], foreign: &&[SemaCheckedForeignFunction], rows: [IRLibraryExportRow], lifecycle_rows: [String], threads: CompilerThreads) -> IRLibraryResult Never! {
    p := ir_program_new(functions, decls, symbols, interner, type_defs, impls, sources, constants, threads)
    ir_foreign_index(p, foreign, decls)
    p.stop_points = false
    p.zone_table = true
    exports := [IRLibraryExportRow]{}
    export_rows := [Int]{}
    // The wave build's roots: each export's checked function, in row order.
    jobs := [IRWaveJob]{}
    unchecked := 0
    outside := 0
    loop row in rows {
        index: ir_function_row(p, row.key) ?? {
            unchecked += 1
            next
        }
        if !ir_c_export_law(p.functions[index]) {
            outside += 1
            next
        }
        exports.push(IRLibraryExportRow{key: row.key, symbol: row.symbol})
        export_rows.push(index)
        jobs.push(IRWaveJob{key: row.key, row: index, args: [Type]{}, lambda: -1, part: -1, local: -1})
    }
    if exports.len() == 0 {
        return ir_library_failed([String]{"the checked NativeLibrary artifact has no #Export(c) functions ({rows.len()} export rows: {unchecked} without a checked function, {outside} outside the C export law)"})
    }
    // Every export problem is collected, so one run lists them all.
    problems := [String]{}
    export_symbols_keys := name_column_table(exports.len())
    export_symbols := name_column(exports.len())
    export_keys_keys := name_column_table(exports.len())
    export_keys := name_column(exports.len())
    loop (index, row) in exports {
        if name_column_get(export_symbols_keys, export_symbols, row.symbol) != None {
            problems.push("duplicate checked export symbol {row.symbol}")
        } else { name_column_set(export_symbols_keys, export_symbols, row.symbol, index) }
        if name_column_get(export_keys_keys, export_keys, row.key) != None {
            problems.push("duplicate checked export function {row.symbol}")
        } else { name_column_set(export_keys_keys, export_keys, row.key, index) }
        loop problem in ir_export_signature_problems(p.functions[export_rows[index]]) {
            problems.push("export {row.symbol} {problem}")
        }
        if row.symbol == "jet_rt_alloc_init" && !ir_void_hook(p.functions[export_rows[index]]) {
            problems.push("jet_rt_alloc_init must take no parameters and return nothing")
        }
    }
    if problems.len() > 0 -> return ir_library_failed(problems)
    lifecycle := IRLifecycles{keys: name_column_table(), rows: name_column(), hooks: [IRLifecycle]{}}
    lifecycle_problem: ir_lifecycle_rows(lifecycle_rows, lifecycle)
    if lifecycle_problem != "" -> return ir_library_failed([String]{lifecycle_problem})
    hooked := 0
    loop (index, row) in exports {
        hook: ir_lifecycle_of(lifecycle, row.symbol) ?? next
        hooked += 1
        if !ir_lifecycle_hook(p.functions[export_rows[index]], hook) {
            return ir_library_failed([String]{"runtime lifecycle export {row.symbol} must return nothing and take no parameters, or, as an init hook, the init array's (argc, argv, envp) as three I64"})
        }
    }
    if hooked != lifecycle.hooks.len() {
        return ir_library_failed([String]{"a runtime lifecycle row names no checked #Export(c) function"})
    }
    intrinsics := p.intrinsics.move()
    bits := false
    from_bits := false
    rails := false
    loop spec in ir_runtime_intrinsic_specs() {
        selected := false
        loop function in p.functions {
            if function.name != spec.name -> next
            if selected {
                return ir_library_failed([String]{"ambiguous checked runtime intrinsic {spec.name}"})
            }
            selected = true
            if spec.shape == {
                .StaticText -> {
                    if !ir_intrinsic_signature(function, 1) || function.params[0].convention != AccessConvention.Read || ir_untag(function.params[0].ty) != Type.String || !ir_i64_type(ir_executable_return(function)) {
                        return ir_library_failed([String]{"runtime intrinsic rt_static_text must read one String and return I64"})
                    }
                    ir_intrinsics_put(intrinsics, function.key, IRRuntimeIntrinsic.StaticText)
                }
                .FloatBits -> {
                    if !ir_bitcast_signature(function, true) {
                        return ir_library_failed([String]{"runtime bitcast {spec.name} has an invalid checked scalar signature"})
                    }
                    bits = true
                    ir_intrinsics_put(intrinsics, function.key, IRRuntimeIntrinsic.FloatBits)
                }
                .FloatFromBits -> {
                    if !ir_bitcast_signature(function, false) {
                        return ir_library_failed([String]{"runtime bitcast {spec.name} has an invalid checked scalar signature"})
                    }
                    from_bits = true
                    ir_intrinsics_put(intrinsics, function.key, IRRuntimeIntrinsic.FloatFromBits)
                }
                .FunctionAddress(symbol, arity) -> {
                    if !ir_intrinsic_signature(function, 0) || !ir_i64_type(ir_executable_return(function)) {
                        return ir_library_failed([String]{"runtime intrinsic {spec.name} has an invalid checked scalar signature"})
                    }
                    target := String?{None}
                    loop (index, row) in exports {
                        if row.symbol != symbol -> next
                        if !ir_address_target_signature(p.functions[export_rows[index]], arity) {
                            return ir_library_failed([String]{"runtime address target {symbol} must export an infallible C function with {arity} I64 parameters and an I64 result"})
                        }
                        target = Val(row.key)
                    }
                    key: target ?? return ir_library_failed([String]{"runtime intrinsic {spec.name} requires #Export(c) {symbol}"})
                    ir_intrinsics_put(intrinsics, function.key, IRRuntimeIntrinsic.FunctionAddress{key: key})
                    if symbol == "jet_rt_fiber_entry" -> rails = true
                }
                .FaultReport -> {
                    if !ir_address_target_signature(function, IR_X64_ARGUMENT_REGISTERS.len()) {
                        return ir_library_failed([String]{"runtime intrinsic {spec.name} must read six I64 values and return I64"})
                    }
                    ir_intrinsics_put(intrinsics, function.key, IRRuntimeIntrinsic.FaultReport)
                }
            }
        }
    }
    if bits != from_bits {
        return ir_library_failed([String]{"runtime bitcast definitions must be present as one validated pair"})
    }
    p.intrinsics = intrinsics.move()
    p.asm_rails = rails
    kept: ir_build_waves_kept(p, jobs, false, threads, None)
    built: kept.result.move()
    m := built.program.move()
    if built.failures.len() > 0 {
        return IRLibraryResult{program: m, failures: built.failures.move(), errors: [String]{}, exports: [IRLibraryExport]{}, data: [X64DataExport]{}, abis: [IRExportABI]{}}
    }
    p = kept.program.move()
    // Each export's function in the merged module.
    roots := [Int]{}
    loop row in exports {
        id: name_column_get(m.function_rows_keys, m.function_rows, row.key) ?? return ir_library_failed([String]{"export {row.symbol} names a missing checked function"})
        roots.push(id)
    }
    // No export reaches its own runtime route: that would be a construct in
    // its body lowered to a call of the routine it defines, which recurses
    // without end (a sized literal that missed the fold once made
    // jet_int_checked_fixed call itself). Every such export is reported.
    recursive := [String]{}
    loop (index, row) in exports {
        if ir_calls_own_route(m, roots[index], row.symbol) {
            recursive.push("runtime export {row.symbol} calls its own runtime route {row.symbol}: a construct in its body lowers to the routine it defines")
        }
    }
    if recursive.len() > 0 -> return ir_library_failed(recursive)
    globals := [IRLibraryExport]{}
    abis := [IRExportABI]{}
    guard_problems := [String]{}
    loop (index, row) in exports {
        hook: ir_lifecycle_of(lifecycle, row.symbol) ?? IRLifecycle{init_priority: -1, fini_priority: -1, guards: [String]{}}
        guards := [Int]{}
        loop name in hook.guards {
            guard: ir_lifecycle_guard(m, p, name)
            if guard < 0 {
                guard_problems.push("runtime lifecycle export {row.symbol}: guard `{name}` is no module storage the library reads")
            } else if !ir_names_data(m, roots[index], guard) {
                guard_problems.push("runtime lifecycle export {row.symbol}: guard `{name}` is no state the hook sets up")
            } else { guards.push(guard) }
        }
        globals.push(IRLibraryExport{function: roots[index], symbol: row.symbol, init_priority: hook.init_priority, fini_priority: hook.fini_priority, guards: guards.move()})
        if IR_HOST_PROVIDER.contains(row.symbol) || RUNTIME_PROVIDER_HOOKS.contains(row.symbol) {
            m.functions[roots[index]].host_symbol = row.symbol.copy()
        }
        abis.push(ir_export_abi(m, roots[index], row.symbol))
    }
    if guard_problems.len() > 0 -> return ir_library_failed(guard_problems)
    abis.sort_by(fn(left: IRExportABI, right: IRExportABI) { left.symbol <=> right.symbol })
    // The process-ending flag the inline block release reads (X64Select.jet
    // ir_x64_block_release), the armed word a loop's stop poll reads
    // (X64Select.jet ir_x64_stop_point), the step word a counted turn spends
    // (IR_X64_COMPTIME_STEPS_STORAGE), the zones word a zone site tests
    // (X64Select.jet ir_x64_zone_site), the task registry's root and the
    // allocator's root the debugger reads (X64_OBSERVE_ROOT_SYMBOL,
    // X64_ALLOC_ROOT_SYMBOL) and the words the debugger writes around an
    // evaluation (X64_DEBUG_EVAL_STORAGE), when this library holds them.
    data := [X64DataExport]{}
    ending: ir_lifecycle_guard(m, p, IR_X64_PROCESS_ENDING_STORAGE)
    if ending >= 0 -> data.push(X64DataExport{data: ending, symbol: IR_X64_PROCESS_ENDING_SYMBOL})
    armed: ir_lifecycle_guard(m, p, IR_X64_CHECKS_ARMED_STORAGE)
    if armed >= 0 -> data.push(X64DataExport{data: armed, symbol: IR_X64_CHECKS_ARMED_SYMBOL})
    steps: ir_lifecycle_guard(m, p, IR_X64_COMPTIME_STEPS_STORAGE)
    if steps >= 0 -> data.push(X64DataExport{data: steps, symbol: IR_X64_COMPTIME_STEPS_SYMBOL})
    zones: ir_lifecycle_guard(m, p, IR_X64_PERF_ZONES_STORAGE)
    if zones >= 0 -> data.push(X64DataExport{data: zones, symbol: IR_X64_PERF_ZONES_SYMBOL})
    observed: ir_lifecycle_guard(m, p, IR_OBSERVE_ROOT_STORAGE)
    if observed >= 0 -> data.push(X64DataExport{data: observed, symbol: X64_OBSERVE_ROOT_SYMBOL})
    allocator: ir_lifecycle_guard(m, p, IR_ALLOC_ROOT_STORAGE)
    if allocator >= 0 -> data.push(X64DataExport{data: allocator, symbol: X64_ALLOC_ROOT_SYMBOL})
    loop name in X64_DEBUG_EVAL_STORAGE {
        word: ir_lifecycle_guard(m, p, name)
        if word >= 0 -> data.push(X64DataExport{data: word, symbol: x64_debug_eval_symbol(name)})
    }
    IRLibraryResult{program: m, failures: [IRBuildFailure]{}, errors: [String]{}, exports: globals, data: data, abis: abis}
}

// The runtime's task registry root (JetRuntime Observe.jet observe_root),
// which the runtime object exports as X64_OBSERVE_ROOT_SYMBOL.
IR_OBSERVE_ROOT_STORAGE: "observe_root"

// The runtime allocator's root (JetRuntime Alloc.jet alloc_root), which the
// runtime object exports as X64_ALLOC_ROOT_SYMBOL.
IR_ALLOC_ROOT_STORAGE: "alloc_root"

ir_library_failed: fn(errors: [String]) -> IRLibraryResult Never! {
    IRLibraryResult{program: ir_module_new(), failures: [IRBuildFailure]{}, errors: errors, exports: [IRLibraryExport]{}, data: [X64DataExport]{}, abis: [IRExportABI]{}}
}

// Whether IR function `id` has a CallRuntime of `symbol`.
ir_calls_own_route: fn(m: IRModule, id: Int, symbol: String) -> Bool Never! {
    own: ir_interned_name(m, symbol) ?? return false
    f: m.functions[id]
    loop at in 0..<f.op.len() {
        if f.op[at] == .CallRuntime && f.a[at] == own -> return true
    }
    false
}

// The C ABI of export `symbol`, IR function `id`: its parameters' and
// result's layouts by their IR type rows (a Float row is passed in the
// Float class, every other row in the Integer class).
ir_export_abi: fn(m: IRModule, id: Int, symbol: String) -> IRExportABI Never! {
    f: m.functions[id]
    parameters: loop slot in 0..<f.param_count -> ir_export_layout(m.types[f.slot_type[slot]])
    result := IRExportLayout?{None}
    if f.result >= 0 && m.types[f.result].kind != .Unit {
        result = Val(ir_export_layout(m.types[f.result]))
    }
    IRExportABI{symbol: symbol, parameters: parameters, result: result}
}

ir_export_layout: fn(row: IRType) -> IRExportLayout Never! {
    IRExportLayout{size: row.size, align: row.align, class: if row.class == .Float -> "Float" else -> "Integer"}
}

ir_export_layout_json: fn(layout: IRExportLayout) -> String Never! {
    "{{\"size\":{layout.size},\"align\":{layout.align},\"class\":{foundation_json_quote(layout.class)}}}"
}

// The runtime ABI receipt (`<prefix>.abi.json`): one row per export.
ir_export_abi_json: fn(rows: [IRExportABI]) -> String Never! {
    encoded := [String]{}
    loop row in rows {
        parameters: loop layout in row.parameters -> ir_export_layout_json(layout)
        result: if row.result == .Val(layout) -> ir_export_layout_json(layout) else -> "null"
        encoded.push("{{\"symbol\":{foundation_json_quote(row.symbol)},\"parameters\":[{parameters.join(",")}],\"result\":{result}}}")
    }
    "[{encoded.join(",")}]"
}

// The symbols whose call can run code beside the calling thread: a new
// thread (the raw clone `#FFI(asm)` leaf, JetBackend OS/Linux.jet; a process
// spawn's vfork-style clone counts too), a signal handler that returns into
// the code it interrupted (ProcessSignal.jet), a loaded library. A C symbol
// counts where the IR calls it, an asm leaf by its own name.
IR_THREAD_START_SYMBOLS: [String]{"os_clone_i64", "signal", "dlopen"}

// The thread receipt of a library (`<prefix>.threads`): the exports whose
// call can reach an IR_THREAD_START_SYMBOLS call, or a CallRuntime of a
// symbol `receipt` names (the runtime's receipt, for the Core library that
// calls into it, JetCLI CoreLibrary.jet), through direct calls, the runtime routes
// the library itself defines and the function addresses it takes, sorted.
// A lifecycle hook that can reach one runs whenever its program keeps one
// of the hook's guards (ir_lifecycle_rows), so every export that can reach
// a guard's storage is listed too; the receipt is just "*" when such a hook
// has no guard, since every program that links the library runs it.
// A CallRuntime's name is looked up once, at its first call, and a guard
// reads the functions that take its address, so no call searches the
// receipt again and no guard scans every DataAddress.
ir_thread_exports: fn(m: IRModule, exports: [IRLibraryExport], receipt: [String]) -> [String] Never! {
    count: m.functions.len()
    defined_keys := name_column_table(exports.len())
    defined := name_column(exports.len())
    loop row in exports -> name_column_set(defined_keys, defined, row.symbol, row.function)
    // Per name row, the export function a CallRuntime of it reaches (-1:
    // none; -2: not looked up yet) and whether it can start a thread.
    name_callees := [Int]{}
    name_starts := [Bool]{}
    loop _ in m.names {
        name_callees.push(-2)
        name_starts.push(false)
    }
    callers := [[Int]]{}
    loop _ in 0..<count -> callers.push([Int]{})
    // Per data row, the functions that take its address (DataAddress), in
    // function order; a row past the last one taken has none.
    takers := [[Int]]{}
    reaches := [Bool]{}
    work := [Int]{}
    loop (id, f) in m.functions {
        starts := f.asm != None && IR_THREAD_START_SYMBOLS.contains(f.name)
        loop (at, op) in f.op {
            callee := -1
            if op == .Call || op == .FunctionAddress -> callee = f.a[at]
            if op == .CallRuntime {
                name: f.a[at]
                if name_callees[name] == -2 {
                    text: m.names[name]
                    name_starts[name] = IR_THREAD_START_SYMBOLS.contains(text) || receipt.contains(text)
                    name_callees[name] = name_column_get(defined_keys, defined, text) ?? -1
                }
                if name_starts[name] -> starts = true
                callee = name_callees[name]
            }
            if op == .DataAddress && f.a[at] >= 0 {
                data: f.a[at]
                loop data >= takers.len() -> takers.push([Int]{})
                takers[data].push(id)
            }
            if callee >= 0 && callee < count -> callers[callee].push(id)
        }
        reaches.push(starts)
        if starts -> work.push(id)
    }
    guarded := [Bool]{}
    loop _ in exports -> guarded.push(false)
    head := 0
    loop {
        loop head < work.len() {
            id: work[head]
            head += 1
            loop caller in callers[id] {
                if reaches[caller] -> next
                reaches[caller] = true
                work.push(caller)
            }
        }
        // A hook that can reach a thread start: whatever keeps its guard
        // storage runs it.
        added := false
        loop (index, row) in exports {
            if guarded[index] || !reaches[row.function] || (row.init_priority < 0 && row.fini_priority < 0) {
                next
            }
            if row.guards.len() == 0 -> return [String]{"*"}
            guarded[index] = true
            loop data in row.guards {
                if data < 0 || data >= takers.len() -> next
                loop id in takers[data] {
                    if reaches[id] -> next
                    reaches[id] = true
                    work.push(id)
                    added = true
                }
            }
        }
        if !added -> break
    }
    ir_reached_exports(exports, reaches)
}

// The symbols of `exports` whose function `reaches` marks, sorted: a
// receipt's rows.
ir_reached_exports: fn(exports: [IRLibraryExport], reaches: [Bool]) -> [String] Never! {
    symbols := [String]{}
    loop row in exports {
        if reaches[row.function] -> symbols.push(row.symbol.copy())
    }
    symbols.sort()
    symbols
}

// The runtime function that publishes a stop to a task's control block
// (JetRuntime Scheduler.jet): every stop a runtime route delivers, the
// task's own or one another task or thread publishes for it, is published
// there.
IR_STOP_PUBLISH: "scheduler_control_publish"

// The runtime functions that end the process rather than publish a stop
// the calling program takes: allocation failure and the checked heap's
// misuse report (JetRuntime Alloc.jet), a capacity overflow (a sequence's,
// a text's or an owner count's), an invalid box layout and an internal
// defect (Trap.jet). The stops receipt never goes through them, so a route
// that can stop only by one of them takes no poll.
IR_STOP_FATAL: [String]{"alloc_out_of_memory", "alloc_check_fail", "rt_seq_capacity_overflow_stop", "rt_trap_invalid_box_layout", "jet_rt_unreachable"}

// The runtime functions that run a program's memory hooks: a context
// allocator's handler and its release and the checked heap's allocation
// observers (JetRuntime Alloc.jet), a value's clone and drop glue
// (Collections.jet), a context value's release (Context.jet) and an error
// payload's release (Err.jet). A stop that hook publishes stays pending and
// arms the loops' polls (Scheduler.jet scheduler_hook_checks_arm), and the
// program takes it at its next stop check (an allocation it interrupts
// takes its buffer from the program heap), so allocation, freeing, cloning
// and dropping take no poll after them. The stops receipt never goes
// through these functions.
IR_STOP_DEFERRED: [String]{"alloc_user_call", "alloc_user_drop", "jet_rt_alloc_check_take", "jet_rt_alloc_check_give", "coll_slot_clone", "coll_slot_drop", "context_values_release", "err_payload_release"}

// The runtime functions whose called code word runs no program code: the
// vDSO's clock_gettime, kernel code (JetRuntime Sync.jet sync_clock_read),
// and the frame walk's `mov rax, rbp; ret` stub (Alloc.jet
// alloc_frames_key). So a clock read, or a system call counted under
// `jet perf run` (HostProcess.jet host_syscall), takes no poll after it.
IR_STOP_LEAF_CODE: [String]{"sync_clock_read", "alloc_frames_key"}

// The start of the name of each `#FFI(asm)` leaf that calls the code
// address its first argument holds (JetBackend OS/Linux.jet).
IR_ADDRESS_CALL_PREFIX: "os_call"

// Where a code word comes from, as ir_code_sources traces a slot back: a
// function's address, the word at offset 0 of module storage (a rail
// cell), a parameter of the function, or anything else.
IRCodeSource: enum {
    Function,
    Cell,
    Param,
    Unknown,
}

// A code word's origin: its source, and at `at` the function's id, the rail
// cell's data row or the parameter's index (-1 for Unknown).
IRCodeOrigin: struct {
    kind: IRCodeSource,
    at: Int,
}

// An IRCodeFlow's role: the code word is called. Any other role is the data
// row of the rail cell the word is stored in.
IR_CODE_CALLED: -1

// A code word function `function` calls or stores (`role`), from `source`.
IRCodeFlow: struct {
    function: Int,
    source: IRCodeOrigin,
    role: Int,
}

// The stops receipt of the runtime library `m` (`<prefix>.stops`): the
// exports whose call can publish a stop, sorted, after whose call a
// program polls (Build.jet ir_route_can_stop). It is read from the library
// as built, before the optimizer's inlining folds the functions it names.
// An export can stop when it reaches IR_STOP_PUBLISH through direct calls,
// the routes the library defines and the code words it calls, never
// through an IR_STOP_FATAL function or an IR_STOP_DEFERRED hook. A called
// code word is traced back in its function (ir_code_sources): a function's
// address calls that function; a rail cell calls each function whose
// address the library stores in it; a parameter calls what each caller
// passes there. A word from anywhere else (a closure's code, a word a call
// returned), a cell whose address escapes or that holds any other word, a
// word an export or an address-taken function is passed, and a function a
// program or host may define in an export's place (IRFunction.host_symbol)
// can run program code, which can stop. A C symbol the library calls is a
// leaf, and so is the code word an IR_STOP_LEAF_CODE function calls; a
// thread, signal handler or fiber it starts publishes no stop to its
// caller. Empty when the library defines no IR_STOP_PUBLISH (a runtime
// fixture's unit without the scheduler), so none of its exports can stop.
ir_stop_exports: fn(m: IRModule, exports: [IRLibraryExport]) -> [String] Never! {
    count: m.functions.len()
    // Per name row, the export function a CallRuntime of it reaches (-1: a
    // C symbol).
    name_callees := loop _ in m.names -> -1
    loop row in exports {
        if ir_interned_name(m, row.symbol) == .Val(at) -> name_callees[at] = row.function
    }
    writes: loop f in m.functions -> ir_slot_writes(f)
    // Per function and parameter, the uses of the code word passed there,
    // grown until every caller's flows are known.
    uses := [[[Int]]]{}
    loop f in m.functions {
        params := loop _ in 0..<f.param_count -> [Int]{}
        if f.asm != None && f.name.starts_with(IR_ADDRESS_CALL_PREFIX) && f.param_count > 0 {
            params[0].push(IR_CODE_CALLED)
        }
        uses.push(params.move())
    }
    flows := [IRCodeFlow]{}
    loop {
        flows.clear()
        loop id in 0..<count -> ir_code_flows(m, id, writes[id], uses, name_callees, flows)
        grown := false
        loop flow in flows {
            if flow.source.kind == IRCodeSource.Param {
                index: flow.source.at
                if !uses[flow.function][index].contains(flow.role) {
                    uses[flow.function][index].push(flow.role)
                    grown = true
                }
            }
        }
        if !grown -> break
    }
    callers := loop _ in 0..<count -> [Int]{}
    roots := loop f in m.functions -> f.host_symbol != ""
    entries := loop f in m.functions -> f.host_symbol != ""
    loop row in exports -> entries[row.function] = true
    installs := loop _ in m.data -> [Int]{}
    tainted := loop _ in m.data -> false
    reads := [Int]{}
    loop (id, f) in m.functions {
        loop (at, op) in f.op {
            callee := -1
            if op == .Call -> callee = f.a[at]
            if op == .CallRuntime -> callee = name_callees[f.a[at]]
            if callee >= 0 && callee < count -> callers[callee].push(id)
            if op == .FunctionAddress && f.a[at] >= 0 && f.a[at] < count -> entries[f.a[at]] = true
            // A cell's address read by anything but a Load, the base of a
            // Store or a copy escapes: the code it holds is unknown.
            if op == .Load || op == .Copy || op == .Move -> next
            ir_x64_reads_into(f, at, reads)
            loop (index, slot) in reads {
                if (op == .Store || op == .StreamStore) && index == 0 -> next
                data: ir_code_cell(f, writes[id], slot)
                if data >= 0 && data < tainted.len() -> tainted[data] = true
            }
        }
    }
    // An IR_STOP_LEAF_CODE function's code word call is a leaf.
    leaf_code: loop f in m.functions -> IR_STOP_LEAF_CODE.contains(f.name)
    // A function that calls the code word a rail cell holds, and beside it
    // the cell's data row.
    called_by := [Int]{}
    called_cells := [Int]{}
    loop flow in flows {
        at: flow.source.at
        if flow.source.kind == {
            .Function -> {
                if at < 0 || at >= count -> next
                if flow.role == IR_CODE_CALLED -> callers[at].push(flow.function) else {
                    installs[flow.role].push(at)
                }
            }
            .Cell -> {
                if flow.role == IR_CODE_CALLED && leaf_code[flow.function] -> next
                if flow.role == IR_CODE_CALLED {
                    called_by.push(flow.function)
                    called_cells.push(at)
                } else { tainted[flow.role] = true }
            }
            .Param -> {}
            .Unknown -> {
                if {
                    flow.role != IR_CODE_CALLED -> tainted[flow.role] = true
                    !leaf_code[flow.function] -> roots[flow.function] = true
                    else -> {}
                }
            }
        }
    }
    // An export's or address-taken function's parameter holds whatever its
    // caller passes, which the library cannot see.
    loop (id, params) in uses {
        if !entries[id] -> next
        loop param_uses in params {
            loop role in param_uses {
                if role == IR_CODE_CALLED -> roots[id] = true else -> tainted[role] = true
            }
        }
    }
    loop (pair, caller) in called_by {
        data: called_cells[pair]
        if data < 0 || data >= tainted.len() || tainted[data] -> roots[caller] = true else {
            loop callee in installs[data] -> callers[callee].push(caller)
        }
    }
    // A route reaches no stop through a fatal function or a deferred hook.
    fatal: loop f in m.functions -> IR_STOP_FATAL.contains(f.name) || IR_STOP_DEFERRED.contains(f.name)
    published := false
    reaches := [Bool]{}
    work := [Int]{}
    loop (id, f) in m.functions {
        sink: f.name == IR_STOP_PUBLISH
        if sink -> published = true
        starts: (sink || roots[id]) && !fatal[id]
        reaches.push(starts)
        if starts -> work.push(id)
    }
    if !published -> return [String]{}
    head := 0
    loop head < work.len() {
        id: work[head]
        head += 1
        loop caller in callers[id] {
            if reaches[caller] || fatal[caller] -> next
            reaches[caller] = true
            work.push(caller)
        }
    }
    ir_reached_exports(exports, reaches)
}

// Per slot of `f`, the instructions that write it.
ir_slot_writes: fn(f: IRFunction) -> [[Int]] Never! {
    writes := loop _ in f.slot_type -> [Int]{}
    loop at in 0..<f.op.len() {
        slot: ir_x64_write(f, at)
        if slot >= 0 && slot < writes.len() -> writes[slot].push(at)
    }
    writes
}

// The data row of the module storage whose address slot `slot` of `f`
// holds wherever it is read (a DataAddress, or a copy of one), else -1;
// `writes` is f's ir_slot_writes.
ir_code_cell: fn(f: IRFunction, writes: [[Int]], slot: Int) -> Int Never! {
    row := -1
    seen := [Int]{}
    work := [Int]{slot}
    loop {
        at := work.pop() ?? break
        if seen.contains(at) -> next
        seen.push(at)
        if at < f.param_count || at >= writes.len() || writes[at].len() == 0 -> return -1
        loop index in writes[at] {
            op: f.op[index]
            if op == .Copy || op == .Move -> work.push(f.a[index]) else if op == .DataAddress && (row < 0 || row == f.a[index]) {
                row = f.a[index]
            } else { return -1 }
        }
    }
    row
}

// Where the code word slot `slot` of `f` holds can come from, traced back
// through copies and numeric conversions to each write of it; a parameter
// is its own source. A constant 0 is no code.
ir_code_sources: fn(f: IRFunction, writes: [[Int]], slot: Int) -> [IRCodeOrigin] Never! {
    found := [IRCodeOrigin]{}
    seen := [Int]{}
    work := [Int]{slot}
    loop {
        at := work.pop() ?? break
        if at < 0 || at >= writes.len() {
            found.push(IRCodeOrigin{kind: IRCodeSource.Unknown, at: -1})
            next
        }
        if seen.contains(at) -> next
        seen.push(at)
        if at < f.param_count -> found.push(IRCodeOrigin{kind: IRCodeSource.Param, at: at})
        loop index in writes[at] {
            op: f.op[index]
            if op == .Copy || op == .Move || op == .Convert -> work.push(f.a[index]) else if op == .FunctionAddress {
                found.push(IRCodeOrigin{kind: IRCodeSource.Function, at: f.a[index]})
            } else if op == .Load && f.b[index] == 0 && ir_code_cell(f, writes, f.a[index]) >= 0 {
                found.push(IRCodeOrigin{kind: IRCodeSource.Cell, at: ir_code_cell(f, writes, f.a[index])})
            } else if op != .Const || f.a[index] != 0 {
                found.push(IRCodeOrigin{kind: IRCodeSource.Unknown, at: -1})
            }
        }
    }
    found
}

// The code word flows of function `id` onto `flows`: the word each address
// call calls (an IR_ADDRESS_CALL_PREFIX leaf's first argument, any
// argument a callee's parameter calls or stores as `uses` has it, a
// CallIndirect's callee) and the word each Store puts in a rail cell, by
// their sources. `writes` is the function's ir_slot_writes and
// `name_callees` the function a CallRuntime of each name row reaches.
ir_code_flows: fn(m: IRModule, id: Int, writes: [[Int]], uses: [[[Int]]], name_callees: [Int], flows: &[IRCodeFlow]) Never! {
    f: m.functions[id]
    loop (at, op) in f.op {
        if op == .CallIndirect -> ir_code_flow(f, id, writes, f.a[at], IR_CODE_CALLED, flows) else if op == .Store && f.b[at] == 0 {
            data: ir_code_cell(f, writes, f.a[at])
            if data >= 0 -> ir_code_flow(f, id, writes, f.c[at], data, flows)
        } else if op == .Call || op == .CallRuntime {
            callee: if op == .Call -> f.a[at] else -> name_callees[f.a[at]]
            if callee < 0 || callee >= uses.len() -> next
            loop (index, param_uses) in uses[callee] {
                if index >= f.c[at] -> break
                loop role in param_uses {
                    ir_code_flow(f, id, writes, f.args[f.b[at] + index], role, flows)
                }
            }
        }
    }
}

ir_code_flow: fn(f: IRFunction, id: Int, writes: [[Int]], slot: Int, role: Int, flows: &[IRCodeFlow]) Never! {
    loop source in ir_code_sources(f, writes, slot) {
        flows.push(IRCodeFlow{function: id, source: source, role: role})
    }
}

// Ordered process-lifecycle hooks of the library object. Each row is
// `<symbol> init <priority> [<guards>]` or `<symbol> fini <priority>
// [<guards>]`; the symbol must be one of the `#Export(c)` rows and take no
// parameters and return nothing. The rows order constructors/destructors;
// they never select exports. Guards (comma-separated) name the module
// storage the hook sets up its service's state in: a linked program runs
// the hook exactly when it keeps one of them, once per
// kept guard, so a guarded hook starts idempotently. Returns the first
// problem, else "".
ir_lifecycle_rows: fn(lines: [String], lifecycle: &IRLifecycles) -> String Never! {
    loop line in lines {
        text: line.trim()
        if text == "" || text.starts_with("#") -> next
        fields := [String]{}
        loop field in text.copy().split(" ").to_list() {
            if field != "" -> fields.push(field)
        }
        if (fields.len() != 3 && fields.len() != 4) || (fields[1] != "init" && fields[1] != "fini") {
            return "invalid runtime lifecycle row `{text}`"
        }
        priority: Int.parse(fields[2]) ?? return "invalid runtime lifecycle priority in `{text}`"
        if priority < 0 || priority > 65535 {
            return "runtime lifecycle priority must be in 0..65535 in `{text}`"
        }
        if name_column_get(lifecycle.keys, lifecycle.rows, fields[0]) != None {
            return "duplicate runtime lifecycle row `{fields[0]}`"
        }
        guards := [String]{}
        if fields.len() == 4 {
            loop name in fields[3].split(",").to_list() {
                if name == "" || guards.contains(name) {
                    return "invalid runtime lifecycle guards in `{text}`"
                }
                guards.push(name)
            }
        }
        name_column_set(lifecycle.keys, lifecycle.rows, fields[0], lifecycle.hooks.len())
        lifecycle.hooks.push(if fields[1] == "init" -> IRLifecycle{init_priority: priority, fini_priority: -1, guards: guards} else -> IRLifecycle{init_priority: -1, fini_priority: priority, guards: guards})
    }
    ""
}

// The data row of the library's module storage named `name` (one 8-byte
// cell, BuildStatic.jet ir_storage_address), or -1 when no storage has that
// name, more than one does, or no built function reads or writes it.
ir_lifecycle_guard: fn(m: IRModule, p: IRProgram, name: String) -> Int Never! {
    found := -1
    loop definition in p.constant_defs {
        if !definition.is_storage || definition.name != name -> next
        if found != -1 -> return -1
        found = name_column_value(m.constant_rows_keys, m.constant_rows, "storage:{definition.key}") ?? -2
    }
    if found < 0 -> return -1
    found
}

// Whether IR function `id`, or a function it calls or takes the address of
// (code it installs), takes the address of data row `row`: the hook sets
// that state up.
ir_names_data: fn(m: IRModule, id: Int, row: Int) -> Bool Never! {
    seen := [Int:Bool]{}
    seen[id] = true
    work := [Int]{id}
    loop work.len() > 0 {
        next_id: work.pop() ?? break
        f: m.functions[next_id]
        loop at in 0..<f.op.len() {
            if f.op[at] == .DataAddress && f.a[at] == row -> return true
            callee: f.a[at]
            if (f.op[at] == .Call || f.op[at] == .FunctionAddress) && callee >= 0 && callee < m.functions.len() && seen.get(callee) == None {
                seen[callee] = true
                work.push(callee)
            }
        }
    }
    false
}

// The C primitive `ty` is: "Int", "Float", "Bool",
// "Text", "F32" or a fixed-width "I<n>"/"U<n>"; None when it is none.
ir_c_primitive: fn(ty: Type) -> String? Never! {
    if ir_untag(ty) == {
        .Int -> return Val("Int")
        .Float -> return Val("Float")
        .Bool -> return Val("Bool")
        .String -> return Val("Text")
        .Float32 -> return Val("F32")
        .IntN(signed, bits) -> {
            if bits == 8 || bits == 16 || bits == 32 || bits == 64 {
                return Val(if signed -> "I{bits}" else -> "U{bits}")
            }
        }
        .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

ir_top_level: fn(function: FnBody) -> Bool Never! {
    if function.kind == {
        .TopLevel -> true
        .Method(_, _) | .TraitMethod(_, _, _, _, _) -> false
    }
}

ir_infallible: fn(function: FnBody) -> Bool Never! {
    if function.failure_carrier == {
        .Infallible -> true
        .Result(_, _) | .Optional(_) | .Diverges(_) -> false
    }
}

// Whether the value an export publishes exists: the
// success value of a Result carrier or the plain return; an Optional or
// diverging carrier has no C result.
ir_c_export_has_result: fn(function: FnBody) -> Bool Never! {
    if function.failure_carrier == {
        .Infallible | .Result(_, _) -> true
        .Optional(_) | .Diverges(_) -> false
    }
}

// That published value's type (a `T Never!` function publishes T, its
// executable return); None for void (a unit result).
ir_c_export_result: fn(function: FnBody) -> Type? Never! {
    if function.failure_carrier == {
        .Result(success, _) -> {
            if ir_unit_type(success) -> return None
            return Val(success)
        }
        .Infallible | .Optional(_) | .Diverges(_) -> {}
    }
    ty: ir_executable_return(function) ?? return None
    if ir_unit_type(ty) -> return None
    Val(ty)
}

// The C export law: a monomorphic top-level
// function whose every parameter and published result is one C primitive.
ir_c_export_law: fn(function: FnBody) -> Bool Never! {
    if !ir_top_level(function) || function.generic_params.len() != 0 -> return false
    loop param in function.params {
        if ir_c_primitive(param.ty) == None -> return false
    }
    if !ir_c_export_has_result(function) -> return false
    result: ir_c_export_result(function) ?? return true
    ir_c_primitive(result) != None
}

// Why the native object writer cannot export a C primitive of type `ty`
// (None: it can). Text needs the JetText bridge and F32 has no native
// lowering, so the writer refuses them by name rather than emitting a wrong
// C ABI. An exact Int crosses as its one-word Jet Int carrier (the runtime's
// list-index seam, jet_rt_panic_list_bounds), as the old writer passed it.
ir_export_native_type: fn(ty: Type) -> String? Never! {
    primitive: ir_c_primitive(ty) ?? return Val("{ir_type_name(ty)} is not a C primitive")
    if primitive == "Text" || primitive == "F32" {
        return Val("{primitive} is not lowered by the native runtime object writer")
    }
    None
}

// The native object has no generated boundary, so an export is an
// infallible top-level C function: by-value primitive parameters and a
// primitive or void result. Every problem of the signature is listed. Sema
// refuses every export that can fail (E3203: sema_guest_check_surfaces for
// a declared carrier, sema_guest_check_export_failures for an inferred one),
// so a carrier here is a compiler defect.
ir_export_signature_problems: fn(function: FnBody) -> [String] Never! {
    problems := [String]{}
    if !ir_top_level(function) || function.generic_params.len() != 0 {
        problems.push("is not a monomorphic top-level function")
    }
    if !ir_infallible(function) {
        panic("checked C export `{function.name}` has a failure carrier; sema refuses it with E3203")
    }
    loop param in function.params {
        if param.convention == AccessConvention.Write {
            problems.push("parameter `{param.name}` is written; C exports take primitives by value")
            next
        }
        problem: ir_export_native_type(param.ty) ?? next
        problems.push("parameter `{param.name}`: {problem}")
    }
    if ir_c_export_result(function) == .Val(result) {
        if ir_export_native_type(result) == .Val(problem) -> problems.push("result: {problem}")
    }
    problems
}

// A lifecycle hook: no parameters, no result.
ir_void_hook: fn(function: FnBody) -> Bool Never! {
    function.params.len() == 0 && ir_c_export_result(function) == None
}

// A lifecycle hook: no result, and no parameters or, for an init-only hook,
// the (argc, argv, envp) every startup's init-array loop calls an entry with
// (glibc's convention, which JetBackend Image/StaticLink.jet's startups
// keep), as three I64.
ir_lifecycle_hook: fn(function: FnBody, hook: IRLifecycle) -> Bool Never! {
    if ir_void_hook(function) -> return true
    if ir_c_export_result(function) != None || hook.fini_priority >= 0 || function.params.len() != 3 {
        return false
    }
    loop param in function.params {
        if (ir_c_primitive(param.ty) ?? "") != "I64" -> return false
    }
    true
}

// A runtime-only ordinary Jet reference function of `count` parameters
// that an intrinsic may replace: never a mismatched declaration.
ir_intrinsic_signature: fn(function: FnBody, count: Int) -> Bool Never! {
    function.foreign == None && ir_top_level(function) && function.generic_params.len() == 0 && ir_infallible(function) && function.params.len() == count
}

ir_i64_type: fn(ty: Type?) -> Bool Never! {
    written: ty ?? return false
    if ir_untag(written) == .IntN(signed, bits) -> return signed && bits == 64
    false
}

ir_float_type: fn(ty: Type?) -> Bool Never! {
    written: ty ?? return false
    if ir_untag(written) == {
        .Float -> true
        .Int | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// rt_f64_bits reads a Float and returns I64 (`to_bits`); rt_f64_from_bits
// the reverse.
ir_bitcast_signature: fn(function: FnBody, to_bits: Bool) -> Bool Never! {
    if !ir_intrinsic_signature(function, 1) || function.params[0].convention != AccessConvention.Read {
        return false
    }
    input: function.params[0].ty
    if to_bits -> return ir_float_type(Val(input)) && ir_i64_type(ir_executable_return(function))
    ir_i64_type(Val(input)) && ir_float_type(ir_executable_return(function))
}

// `arity` read I64 parameters and an I64 result: the export an address
// intrinsic names, and rt_fault_print.
ir_address_target_signature: fn(function: FnBody, arity: Int) -> Bool Never! {
    if !ir_intrinsic_signature(function, arity) -> return false
    loop param in function.params {
        if param.convention != AccessConvention.Read || !ir_i64_type(Val(param.ty)) -> return false
    }
    ir_i64_type(ir_executable_return(function))
}

// A call of runtime intrinsic `intrinsic` at its instance `type_args`, built
// as its operation. rt_static_text of a literal is the literal's immortal
// String (the ConstText of its data row) as an I64; a bit cast stores its
// operand in a frame word and loads it back in the other class; an address
// intrinsic is the FunctionAddress of its export; rt_fault_print is a call of
// the fault report the linker writes; a core.mem operation is its inline
// lowering (BuildRoutes.jet ir_core_list_leaf, ir_core_stream_store,
// ir_core_region, BuildSentry.jet ir_core_volatile, ir_core_mem_block,
// ir_core_list_append, ir_core_list_copy, ir_core_alloc_raw and
// ir_core_free_raw, BuildExpr.jet ir_core_ptr_step and
// ir_core_view_from_raw).
ir_intrinsic_call: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, intrinsic: IRRuntimeIntrinsic, type_args: [Type], args: [BodyCallArg], span: Span) -> Int Never! {
    word_row: ir_word_row(m)
    float_row: ir_type_row(m, Type.Float) ?? return ir_fail_slot(b, span, "type Float")
    if intrinsic == {
        .StaticText -> ir_static_text_call(m, p, b, args, word_row, span)
        .FloatBits -> ir_bitcast(m, p, b, args, float_row, word_row, span)
        .FloatFromBits -> ir_bitcast(m, p, b, args, word_row, float_row, span)
        .FunctionAddress(key) -> ir_address_call(m, p, b, key, args, word_row, span)
        .FaultReport -> ir_fault_report_call(m, p, b, args, word_row, span)
        .TypeSize | .ListCapacity | .ListReserveExact -> ir_core_list_leaf(m, p, b, intrinsic, ir_intrinsic_nodes(args), type_args, span)
        .ListAppend -> ir_core_list_append(m, p, b, ir_intrinsic_nodes(args), type_args, span)
        .ListCopy -> ir_core_list_copy(m, p, b, ir_intrinsic_nodes(args), type_args, span)
        .VolatileRead -> ir_core_volatile(m, p, b, "volatile_read", ir_intrinsic_nodes(args), type_args, span)
        .VolatileWrite -> ir_core_volatile(m, p, b, "volatile_write", ir_intrinsic_nodes(args), type_args, span)
        .StreamStore -> ir_core_stream_store(m, p, b, ir_intrinsic_nodes(args), type_args, span)
        .PtrOffset -> ir_core_ptr_step(m, p, b, false, ir_intrinsic_nodes(args), type_args, span)
        .PtrByteOffset -> ir_core_ptr_step(m, p, b, true, ir_intrinsic_nodes(args), type_args, span)
        .ViewFromRaw -> ir_core_view_from_raw(m, p, b, ir_intrinsic_nodes(args), type_args, span)
        .MemCopy -> ir_core_mem_block(m, p, b, "copy", ir_intrinsic_nodes(args), type_args, span)
        .MemFill -> ir_core_mem_block(m, p, b, "fill", ir_intrinsic_nodes(args), type_args, span)
        .AllocRaw -> ir_core_alloc_raw(m, p, b, ir_intrinsic_nodes(args), span)
        .FreeRaw -> ir_core_free_raw(m, p, b, ir_intrinsic_nodes(args), span)
        .Mapped | .Unmapping -> ir_core_mapping(m, p, b, intrinsic == IRRuntimeIntrinsic.Mapped, ir_intrinsic_nodes(args), span)
        .RegionReserve | .RegionRelease -> ir_core_region(m, p, b, intrinsic, ir_intrinsic_nodes(args), span)
        .ContextTake | .ContextGive | .ContextRoom -> ir_core_context_block(m, p, b, intrinsic, ir_intrinsic_nodes(args), span)
    }
}

// The argument expression nodes of an intrinsic call, in order.
ir_intrinsic_nodes: fn(args: [BodyCallArg]) -> [Int] Never! {
    nodes := [Int]{}
    loop arg in args -> nodes.push(arg.value)
    nodes
}

// A call of rt_fault_print: a C call of LINK_FAULT_REPORT, the native fault
// report the static linker writes into each image (JetBackend
// Image/StaticLink.jet link_fault_report, from JetRuntime
// Assets/FaultReport/), its six I64 arguments and I64 result in the C
// argument and result registers. It never stops: the report is the last
// thing a faulting process runs.
ir_fault_report_call: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, args: [BodyCallArg], word_row: Int, span: Span) -> Int Never! {
    if args.len() != IR_X64_ARGUMENT_REGISTERS.len() {
        return ir_fail_slot(b, span, "rt_fault_print reads six I64 values")
    }
    values := [Int]{}
    loop arg in args {
        value: ir_value_as(m, p, b, arg.value, word_row, span)
        if ir_failed(b) -> return -1
        values.push(value)
    }
    out: ir_temp(m, b, word_row)
    start: ir_args(b.f, values)
    ir_emit(b.f, IROp.CallRuntime, out, ir_intern_name(m, LINK_FAULT_REPORT), start, values.len(), b.line)
    out
}

ir_static_text_call: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, args: [BodyCallArg], word_row: Int, span: Span) -> Int Never! {
    if args.len() != 1 -> return ir_fail_slot(b, span, "rt_static_text is literal-only")
    parts: if ir_body_node(p, b, args[0].value).kind == {
        .StrLit(written) -> written
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {
            return ir_fail_slot(b, span, "rt_static_text is literal-only")
        }
    }
    literal := ""
    loop part in parts {
        if part == {
            .Literal(text) -> literal = "{literal}{text}"
            .Interpolation(_, _) -> return ir_fail_slot(b, span, "rt_static_text is literal-only")
        }
    }
    slot: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.ConstText, slot, ir_intern_text(m, literal), -1, -1, b.line)
    slot
}

ir_address_call: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, key: String, args: [BodyCallArg], word_row: Int, span: Span) -> Int Never! {
    if args.len() != 0 {
        return ir_fail_slot(b, span, "a runtime address intrinsic takes no arguments")
    }
    target: ir_function_id(m, p, key, [Type]{}) ?? return ir_fail_slot(b, span, "runtime address target {key} is not among the checked functions")
    slot: ir_temp(m, b, word_row)
    ir_emit(b.f, IROp.FunctionAddress, slot, target, -1, -1, b.line)
    slot
}

// The bits of the one argument (of row `input`) as a value of row `output`.
ir_bitcast: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, args: [BodyCallArg], input: Int, output: Int, span: Span) -> Int Never! {
    if args.len() != 1 -> return ir_fail_slot(b, span, "a runtime bitcast reads one value")
    value: ir_value_as(m, p, b, args[0].value, input, span)
    if ir_failed(b) -> return -1
    ir_reinterpret(m, b, value, output)
}

// The bits of scalar slot `value` as a fresh value of row `output`: stored
// in a frame word, loaded back in the other class.
ir_reinterpret: fn(m: &IRModule, b: &IRBuilder, value: Int, output: Int) -> Int Never! {
    pointer_row: ir_pointer_row(m)
    area: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.StackAddress, area, 8, 8, -1, b.line)
    ir_emit(b.f, IROp.Store, -1, area, 0, value, b.line)
    out: ir_temp(m, b, output)
    ir_emit(b.f, IROp.Load, out, area, 0, -1, b.line)
    out
}
