// Optimization levels over the slot IR: IR in, IR out, between the builder
// and x86-64 selection. Level 0 (`jet run`, `jet dev`, compile-time code)
// leaves the module as built; level 1 (`jet build`) inlines small direct
// callees bottom-up over the call graph (drop glue too, `glue`) and
// simplifies every function;
// level 2 (`--release`) first hoists calls making a list's buffer its own
// out of Loops (`unique`), and after Simplify adds scalar replacement of
// frame aggregates (also of ones whose address is only lent out,
// `promote`), simplifies again, and runs each function through SSA
// (Ssa.jet, SsaOut.jet). Both levels end by moving stop points right after
// their calls (`stops`, OptStops.jet).
//
// Every pass keeps the program's meaning exactly, on every level: runtime
// calls, drops, stores and stops stay in order (but Int and word drops,
// which move past a stop point to keep it next to its call); a fold that
// would wrap or trap is not done; Float is never folded. A pass that needs
// to know where a slot gets its value uses the structured nesting (OptFacts below)
// instead of an SSA form: a slot with exactly one write reaches every read
// in a region that the write's region encloses, after the write.
//
// Selection reads every operand of an instruction before it writes the
// instruction's result (the builder already emits `add s <- s, one`), so a
// pass may make a result slot equal to an operand slot.

use jet_foundation.[CompilerThreads, compiler_take_rows, compiler_threads_admit, compiler_threads_failure_text, compiler_transfer_rows]

// What the optimizer runs: the level, the passes `disabled` names (to
// bisect a difference to one pass: "unique", "once", "scalar", "promote", "range", "ssa", "stops", "glue"), whether every SSA
// form is verified (`verify`), whether every SSA value leaves SSA in a
// fresh slot (`stress`, which exercises the moves out of SSA), and the
// name of the functions whose IR before and after the passes the report
// carries (`dump`, "" for none).
struct IROptOptions {
    level: Int
    disabled: [String]
    verify: Bool
    stress: Bool
    dump: String
}

fn ir_opt_options(level: Int) -> IROptOptions Never! {
    IROptOptions{level: level, disabled: [String]{}, verify: false, stress: false, dump: ""}
}

// Options from the environment's values: JET_OPT_DISABLE (pass names,
// comma-separated), JET_OPT_SSA_VERIFY and JET_OPT_SSA_STRESS ("1": on),
// JET_OPT_DUMP (a function name).
fn ir_opt_options_from(level: Int, disable: String?, verify: String?, stress: String?, dump: String?) -> IROptOptions Never! {
    disabled := [String]{}
    if disable == .Val(text) {
        loop name in text.split(",") {
            trimmed :: name.trim()
            if trimmed != "" -> &disabled.push(trimmed)
        }
    }
    IROptOptions{level: level, disabled: ^disabled, verify: (verify ?? "") == "1", stress: (stress ?? "") == "1", dump: dump ?? ""}
}

fn ir_opt_enabled(options: IROptOptions, pass: String) -> Bool Never! {
    loop name in options.disabled {
        if name == pass -> return false
    }
    true
}

// What the passes changed in a module, summed over its functions.
struct IROptReport {
    level: Int
    inlined_calls: Int
    direct_calls: Int
    folded: Int
    branches_folded: Int
    compares_fused: Int
    copies_coalesced: Int
    dead_removed: Int
    unreachable_removed: Int
    aggregates_replaced: Int
    unique_hoisted: Int
    int_facts: Int
    ssa_functions: Int
    ssa_changed: Int
    ssa_moves: Int
    ssa_fresh: Int
    instructions_before: Int
    instructions_after: Int
    // IROptOptions.dump: each dumped function's IR before and after its passes.
    dumps: [String]
}

fn ir_opt_report(level: Int) -> IROptReport Never! {
    IROptReport{level: level, inlined_calls: 0, direct_calls: 0, folded: 0, branches_folded: 0, compares_fused: 0, copies_coalesced: 0, dead_removed: 0, unreachable_removed: 0, aggregates_replaced: 0, unique_hoisted: 0, int_facts: 0, ssa_functions: 0, ssa_changed: 0, ssa_moves: 0, ssa_fresh: 0, instructions_before: 0, instructions_after: 0, dumps: [String]{}}
}

fn ir_opt_report_text(r: IROptReport) -> String Never! {
    text := "O{r.level}: instructions {r.instructions_before} -> {r.instructions_after}, inlined {r.inlined_calls}, direct calls {r.direct_calls}, folded {r.folded}, branches {r.branches_folded}, fused compares {r.compares_fused}, coalesced {r.copies_coalesced}, dead {r.dead_removed}, unreachable {r.unreachable_removed}, scalar-replaced {r.aggregates_replaced}, unique hoisted {r.unique_hoisted}, inline Int facts {r.int_facts}, ssa {r.ssa_functions} (rewritten {r.ssa_changed}, moves {r.ssa_moves}, fresh slots {r.ssa_fresh})"
    loop dump in r.dumps -> text = "{text}\n{dump}"
    text
}

fn ir_opt_report_add(total: &IROptReport, part: IROptReport) Never! {
    total.inlined_calls += part.inlined_calls
    total.direct_calls += part.direct_calls
    total.folded += part.folded
    total.branches_folded += part.branches_folded
    total.compares_fused += part.compares_fused
    total.copies_coalesced += part.copies_coalesced
    total.dead_removed += part.dead_removed
    total.unreachable_removed += part.unreachable_removed
    total.aggregates_replaced += part.aggregates_replaced
    total.unique_hoisted += part.unique_hoisted
    total.int_facts += part.int_facts
    total.ssa_functions += part.ssa_functions
    total.ssa_changed += part.ssa_changed
    total.ssa_moves += part.ssa_moves
    total.ssa_fresh += part.ssa_fresh
    loop dump in part.dumps -> &total.dumps.push(dump)
}

// Optimizing threads (compiler_threads_admit): a thread is admitted for at
// least this many IR instructions of a wave, so a small wave runs on the
// calling thread.
IR_OPT_MIN_INSTRUCTIONS_PER_THREAD :: 20000

// Optimizes `m` in place at `options.level` (0, 1 or 2), on as many threads
// as `threads` admits. The functions run in waves of the bottom-up call graph
// (ir_opt_waves): a function's passes read only its own body and the final
// bodies of its non-recursive callees, which all sit in earlier waves, so
// the functions of one wave are independent and every body is the one the
// single-threaded Tarjan walk produces, for any thread count.
fn ir_optimize_module(m: &IRModule, options: IROptOptions, threads: CompilerThreads) -> IROptReport Never! {
    level :: options.level
    report := ir_opt_report(level)
    loop f in m.functions -> report.instructions_before += ir_opt_size(f)
    if level <= 0 {
        report.instructions_after = report.instructions_before
        return report
    }
    if options.dump != "" {
        loop f in m.functions {
            if f.name == options.dump -> &report.dumps.push("before {ir_function_text(m, f)}")
        }
    }
    functions := [IRFunction]{}
    compiler_transfer_rows<IRFunction>(&functions, &m.functions)
    glue :: ir_opt_enabled(options, "glue")
    loop id in 0..<functions.len() {
        ir_opt_direct_calls(&functions[id], &report)
        if glue -> ir_opt_glue_calls(&functions[id], m)
    }
    order := ir_opt_bottom_up(functions)
    waves :: ir_opt_waves(functions, order)
    weights := [Int]{}
    loop f in functions -> &weights.push(1 + f.op.len())
    // Each body moves into a one-row list, so a pass takes its function out
    // and puts it back while the others stay readable; the passes read only
    // the type rows of the module, which move beside the bodies, and the
    // ids of the runtime routes they know (ir_opt_routes).
    bodies := [[IRFunction]]{}
    loop functions.len() > 0 {
        row := &functions.pop() ?? { break }
        &bodies.push([IRFunction]{^row})
    }
    &bodies.reverse()
    view := ir_module_new()
    compiler_transfer_rows<IRType>(&view.types, &m.types)
    loop route in ir_opt_routes() {
        id :: m.name_rows.get(route) ?? -1
        if id >= 0 -> view.name_rows[route] = id
    }
    sites :: ir_opt_call_sites(bodies)
    inputs :: shared IROptInputs{views: [IRModule]{^view}, bodies: ^bodies, recursive: ^order.recursive, sites: ^sites, options: options.copy()}
    loop wave in waves {
        total := 0
        loop id in wave -> total += weights[id]
        workers :: compiler_threads_admit(threads, wave.len(), total, IR_OPT_MIN_INSTRUCTIONS_PER_THREAD, 0, 0)
        if workers <= 1 {
            ir_opt_wave_inline(inputs, wave, &report)
            next
        }
        store :: shared IROptStore{work: ir_opt_wave_take(inputs, wave), done: [[IRFunction]]{}, next: 0}
        ir_opt_store_open(store, wave.len())
        part :: ir_opt_claimers(inputs, store, workers) ?? panic("the IR optimizing threads failed")
        ir_opt_report_add(&report, part)
        ir_opt_wave_put(inputs, store, wave)
    }
    back := ir_opt_take_inputs(inputs)
    view_back := &back.views.pop() ?? panic("the IR optimizer lost the module's type rows")
    compiler_transfer_rows<IRType>(&m.types, &view_back.types)
    loop back.bodies.len() > 0 {
        row := &back.bodies.pop() ?? { break }
        body := &row.pop() ?? panic("the IR optimizer lost a function body")
        &functions.push(^body)
    }
    &functions.reverse()
    compiler_transfer_rows<IRFunction>(&m.functions, &functions)
    loop f in m.functions {
        report.instructions_after += ir_opt_size(f)
        if options.dump != "" && f.name == options.dump -> &report.dumps.push("after {ir_function_text(m, f)}")
    }
    report
}

// The runtime routes a pass recognizes by name (OptUnique.jet, OptRange.jet).
fn ir_opt_routes() -> [String] Never! {
    [String]{"jet_rt_alloc", "jet_rt_mem_move", "jet_rt_block_release", "jet_rt_free", "jet_int_owned_to_i64", "jet_rt_int_clone", "jet_int_checked_fixed"}
}

// Whether instruction `at` calls the runtime route `route`.
fn ir_opt_calls_route(m: IRModule, f: IRFunction, at: Int, route: String) -> Bool Never! {
    f.op[at] == .CallRuntime && f.a[at] == (m.name_rows.get(route) ?? -2)
}

// One function's passes: at level 2 uniqueness hoisting, then inlining its
// callees' final bodies (`bodies`; the drop glue it calls, OptGlue.jet, and
// a glue call left is a Drop again), then Simplify, at level 2 scalar
// replacement, Simplify again and the SSA round trip, and last the stop
// points after their calls.
fn ir_opt_function(m: IRModule, bodies: [[IRFunction]], f: ^IRFunction, recursive: [Bool], sites: [Int], options: IROptOptions, report: &IROptReport) -> IRFunction Never! {
    level :: options.level
    body := ^f
    if level >= 2 && ir_opt_enabled(options, "unique") -> report.unique_hoisted += ir_opt_hoist_unique(m, &body, bodies)
    out := ir_opt_inline_build(m, bodies, body, recursive, sites, level >= 2 && ir_opt_enabled(options, "once"), level, &report) ?? ^body
    if ir_opt_enabled(options, "glue") -> ir_opt_glue_drops(&out, m, bodies)
    ir_opt_simplify(m, &out, &report)
    if level >= 2 {
        if ir_opt_enabled(options, "scalar") {
            replaced :: ir_opt_scalar_replace(m, &out, ir_opt_enabled(options, "promote"))
            report.aggregates_replaced += replaced
            if replaced > 0 -> ir_opt_simplify(m, &out, &report)
        }
        if ir_opt_enabled(options, "ssa") -> ir_opt_ssa(m, &out, options, &report)
    }
    if ir_opt_enabled(options, "stops") -> ir_opt_stops_after_calls(&out, m, bodies)
    out
}

// The SSA round trip: build, verify when asked, the inline Int facts
// (OptRange.jet), and back to slots. No pass on the form gives a value a
// new slot (the facts only drop reads, fold a compare into its own slot or
// keep a read's slot), so the slot code stays valid as it is, and leaving
// SSA (SsaOut.jet) runs only for verify and stress, which exercise it.
// Without either, a function the facts cannot touch (no Int or word slot,
// or "range" off) builds no form.
fn ir_opt_ssa(m: IRModule, f: &IRFunction, options: IROptOptions, report: &IROptReport) Never! {
    if f.op.len() == 0 -> return
    ranges :: ir_opt_enabled(options, "range") && ir_range_wanted(m, f)
    if !ranges && !options.verify && !options.stress -> return
    s := ir_ssa_build(f)
    if options.verify {
        errors :: ir_ssa_verify(f, s)
        if errors.len() > 0 -> panic("the SSA form of {f.key} is invalid: {errors.join("; ")}")
    }
    facts :: if ranges -> ir_opt_int_facts(m, &f, &s) else -> 0
    report.int_facts += facts
    report.ssa_functions += 1
    if options.verify || options.stress {
        stats :: ir_ssa_out(m, &f, s, options.stress)
        if stats.changed {
            report.ssa_changed += 1
            report.ssa_moves += stats.moves
            report.ssa_fresh += stats.fresh
        }
    }
    // The comparisons the ranges decided leave constant branches and Nops.
    if facts > 0 -> ir_opt_simplify(m, &f, &report)
}

// The waves of the bottom-up order: a function's wave is one past the
// latest wave of the non-recursive callees it calls directly (0 for none),
// and each wave lists its functions in the bottom-up order.
fn ir_opt_waves(functions: [IRFunction], order: OptOrder) -> [[Int]] Never! {
    wave := [Int]{}
    loop _ in functions -> &wave.push(-1)
    waves := [[Int]]{}
    loop id in order.order {
        at := 0
        loop k in 0..<functions[id].op.len() {
            if functions[id].op[k] != .Call -> next
            callee :: functions[id].a[k]
            if callee < 0 || callee >= functions.len() || callee == id || order.recursive[callee] -> next
            if wave[callee] + 1 > at -> at = wave[callee] + 1
        }
        wave[id] = at
        loop waves.len() <= at -> &waves.push([Int]{})
        &waves[at].push(id)
    }
    waves
}

// What every optimizing thread reads and nothing writes while a wave runs:
// the module's type rows (in a module of their own), every function's body
// (a one-row list; the wave's own rows are empty while it runs), which
// functions are recursive, how many direct call sites each has, and the
// level.
struct IROptInputs {
    views: [IRModule]
    bodies: [[IRFunction]]
    recursive: [Bool]
    sites: [Int]
    options: IROptOptions
}

// Per function, the direct Calls of it in the whole module.
fn ir_opt_call_sites(bodies: [[IRFunction]]) -> [Int] Never! {
    sites := [Int]{}
    loop _ in bodies -> &sites.push(0)
    loop row in bodies {
        loop f in row {
            loop at in 0..<f.op.len() {
                callee :: f.a[at]
                if f.op[at] == .Call && callee >= 0 && callee < sites.len() -> sites[callee] = sites[callee] + 1
            }
        }
    }
    sites
}

// A wave's bodies (`work[k]` the wave's k-th function, empty once claimed),
// their optimized bodies by the same position, and the next position to claim.
struct IROptStore {
    work: [[IRFunction]]
    done: [[IRFunction]]
    next: Int
}

// A wave on the calling thread: each body out of its row, through its passes, back.
fn ir_opt_wave_inline(inputs: Shared<IROptInputs>, wave: [Int], report: &IROptReport) {
    permit := inputs.guard_edit()
    loop id in wave {
        body := &permit.value.bodies[id].pop() ?? panic("the IR optimizer has no body for function {id}")
        optimized := ir_opt_function(permit.value.views[0], permit.value.bodies, ^body, permit.value.recursive, permit.value.sites, permit.value.options, &report)
        &permit.value.bodies[id].push(^optimized)
    }
}

// The wave's bodies move out of their rows, in wave order.
fn ir_opt_wave_take(inputs: Shared<IROptInputs>, wave: [Int]) -> [[IRFunction]] {
    permit := inputs.guard_edit()
    work := [[IRFunction]]{}
    loop id in wave {
        body := &permit.value.bodies[id].pop() ?? panic("the IR optimizer has no body for function {id}")
        &work.push([IRFunction]{^body})
    }
    work
}

fn ir_opt_store_open(store: Shared<IROptStore>, count: Int) {
    permit := store.guard_edit()
    loop _ in 0..<count -> &permit.value.done.push([IRFunction]{})
}

// The optimized bodies move back into their rows.
fn ir_opt_wave_put(inputs: Shared<IROptInputs>, store: Shared<IROptStore>, wave: [Int]) {
    results := store.guard_edit()
    permit := inputs.guard_edit()
    loop (k, id) in wave {
        body := &results.value.done[k].pop() ?? panic("the IR optimizer lost the body of function {id}")
        &permit.value.bodies[id].push(^body)
    }
}

// Runs `tasks` optimizing threads, one task each; returns their reports' sum.
fn ir_opt_claimers(inputs: Shared<IROptInputs>, store: Shared<IROptStore>, tasks: Int) -> IROptReport {
    if tasks <= 0 -> return ir_opt_report(0)
    total := ir_opt_report(0)
    task.group ir_opt_threads {
        head :: task ir_opt_claimed(inputs, store)
        rest :: ir_opt_claimers(inputs, store, tasks - 1)
        ir_opt_report_add(&total, rest)
        part :: head.join() ?? ir_opt_stopped(err)
        ir_opt_report_add(&total, part)
    }
    total
}

// A stopped optimizing thread: its panic text, re-raised unchanged.
fn ir_opt_stopped(failure: TaskFailure) -> IROptReport Never! {
    panic(compiler_threads_failure_text(failure))
}

// One thread: claims the wave's next body and optimizes it until none is left.
fn ir_opt_claimed(inputs: Shared<IROptInputs>, store: Shared<IROptStore>) -> IROptReport {
    reads :: inputs.guard_read()
    report := ir_opt_report(0)
    loop {
        claimed := ir_opt_claim(store)
        body := &claimed.body.pop() ?? { break }
        optimized := ir_opt_function(reads.value.views[0], reads.value.bodies, ^body, reads.value.recursive, reads.value.sites, reads.value.options, &report)
        ir_opt_settle(store, claimed.at, ^optimized)
    }
    report
}

// A claimed position of the wave and its body (empty: nothing left).
struct IROptClaim {
    at: Int
    body: [IRFunction]
}

fn ir_opt_claim(store: Shared<IROptStore>) -> IROptClaim {
    permit := store.guard_edit()
    at :: permit.value.next
    if at >= permit.value.work.len() -> return IROptClaim{at: -1, body: [IRFunction]{}}
    permit.value.next = at + 1
    IROptClaim{at: at, body: compiler_take_rows<IRFunction>(&permit.value.work[at])}
}

fn ir_opt_settle(store: Shared<IROptStore>, at: Int, optimized: ^IRFunction) {
    permit := store.guard_edit()
    &permit.value.done[at].push(^optimized)
}

fn ir_opt_take_inputs(inputs: Shared<IROptInputs>) -> IROptInputs {
    permit := inputs.guard_edit()
    IROptInputs{views: compiler_take_rows<IRModule>(&permit.value.views), bodies: compiler_take_rows<[IRFunction]>(&permit.value.bodies), recursive: [Bool]{}, sites: [Int]{}, options: permit.value.options.copy()}
}

// Instructions that do something (Nop and End excluded): the size inlining
// measures.
fn ir_opt_size(f: IRFunction) -> Int Never! {
    count := 0
    loop op in f.op {
        if op != .Nop && op != .End -> count += 1
    }
    count
}

// ---------------------------------------------------------------------------
// Facts over one function: who writes and reads each slot, and the region
// (function body, Block body, Loop body, If then-part, Else part) each
// instruction sits in. Openers, Else and End belong to the enclosing region.

struct OptFacts {
    // Writes per slot; parameters count one write at entry.
    defs: [Int]
    // The one write of a slot written once (-1 for a parameter: the entry).
    def_at: [Int]
    // Reads per slot.
    uses: [Int]
    // Region of each instruction, and each region's enclosing region (-1 for
    // the function body, region 0).
    region: [Int]
    parent: [Int]
}

fn ir_opt_facts(f: IRFunction) -> OptFacts Never! {
    count :: f.slot_type.len()
    defs := [Int]{}
    def_at := [Int]{}
    uses := [Int]{}
    loop slot in 0..<count {
        &defs.push(if slot < f.param_count -> 1 else -> 0)
        &def_at.push(-1)
        &uses.push(0)
    }
    region := [Int]{}
    parent := [Int]{-1}
    open := [Int]{0}
    reads := [Int]{}
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        if op == .Else || op == .End -> _ := &open.pop()
        &region.push(open[open.len() - 1])
        if op == .Block || op == .Loop || op == .If || op == .Else {
            &parent.push(open[open.len() - 1])
            &open.push(parent.len() - 1)
        }
        ir_x64_reads_into(f, at, &reads)
        loop slot in reads {
            if slot >= 0 && slot < count -> uses[slot] = uses[slot] + 1
        }
        written :: ir_x64_write(f, at)
        if written >= 0 && written < count {
            defs[written] = defs[written] + 1
            def_at[written] = at
        }
    }
    OptFacts{defs: defs, def_at: def_at, uses: uses, region: region, parent: parent}
}

// Whether region `outer` encloses (or is) region `inner`.
fn ir_opt_encloses(facts: OptFacts, outer: Int, inner: Int) -> Bool Never! {
    at := inner
    loop at >= 0 {
        if at == outer -> return true
        at = facts.parent[at]
    }
    false
}

// The instruction that gives `slot` its value at instruction `at`: the
// slot's one write when that write comes first and its region encloses
// `at`'s; -1 when there is none or the slot is a parameter.
fn ir_opt_reaching_def(f: IRFunction, facts: OptFacts, slot: Int, at: Int) -> Int Never! {
    if slot < f.param_count || facts.defs[slot] != 1 -> return -1
    def :: facts.def_at[slot]
    if def < 0 || def >= at -> return -1
    if !ir_opt_encloses(facts, facts.region[def], facts.region[at]) -> return -1
    def
}

// The constant `slot` holds at instruction `at`, when a single `Const`
// write reaches it.
fn ir_opt_const_at(f: IRFunction, facts: OptFacts, slot: Int, at: Int) -> Int? Never! {
    if slot < 0 -> return None
    def :: ir_opt_reaching_def(f, facts, slot, at)
    if def < 0 || f.op[def] != .Const -> return None
    Val(f.a[def])
}

// ---------------------------------------------------------------------------
// Compaction: drops the Nops and recomputes every structural index (Block,
// Loop and Else `a`, If `b`/`c`, End `a`) from the nesting. Br depths count
// open constructs, so they stay valid as long as a pass removes a construct
// only together with every Br inside it.

fn ir_opt_compact(f: &IRFunction) Never! {
    op := [IROp]{}
    dst := [Int]{}
    a := [Int]{}
    b := [Int]{}
    c := [Int]{}
    line := [Int]{}
    loop at in 0..<f.op.len() {
        if f.op[at] == .Nop -> next
        &op.push(f.op[at])
        &dst.push(f.dst[at])
        &a.push(f.a[at])
        &b.push(f.b[at])
        &c.push(f.c[at])
        &line.push(f.code_line[at])
    }
    open := [Int]{}
    loop at in 0..<op.len() {
        if op[at] == {
            .Block | .Loop -> &open.push(at)
            .If -> {
                b[at] = -1
                &open.push(at)
            }
            .Else -> b[open[open.len() - 1]] = at
            .End -> {
                opener :: &open.pop() ?? panic("ir_opt_compact: End without an open construct")
                a[at] = opener
                if op[opener] == .If {
                    c[opener] = at
                    if b[opener] >= 0 -> a[b[opener]] = at
                } else {
                    a[opener] = at
                }
            }
            else -> {}
        }
    }
    f.op = ^op
    f.dst = ^dst
    f.a = ^a
    f.b = ^b
    f.c = ^c
    f.code_line = ^line
}

// Turns instruction `at` into a Nop.
fn ir_opt_kill(f: &IRFunction, at: Int) Never! {
    f.op[at] = .Nop
    f.dst[at] = -1
    f.a[at] = -1
    f.b[at] = -1
    f.c[at] = -1
}

// ---------------------------------------------------------------------------
// Direct calls: a CallIndirect through a slot whose one write is the
// FunctionAddress of a module function is a Call of that function (same
// arguments, same ABI), which inlining can then see.

fn ir_opt_direct_calls(f: &IRFunction, report: &IROptReport) Never! {
    facts :: ir_opt_facts(f)
    loop at in 0..<f.op.len() {
        if f.op[at] != .CallIndirect -> next
        def :: ir_opt_reaching_def(f, facts, f.a[at], at)
        if def < 0 || f.op[def] != .FunctionAddress -> next
        f.op[at] = .Call
        f.a[at] = f.a[def]
        report.direct_calls += 1
    }
}

// ---------------------------------------------------------------------------
// The call graph bottom-up (Tarjan's strongly connected components, callees
// before callers). A function in a component of more than one function, or
// that calls itself, is recursive and never inlined.

struct OptOrder {
    order: [Int]
    recursive: [Bool]
}

struct OptTarjan {
    edges: [[Int]]
    index: [Int]
    low: [Int]
    on_stack: [Bool]
    stack: [Int]
    next_index: Int
    order: [Int]
    recursive: [Bool]
}

fn ir_opt_bottom_up(functions: [IRFunction]) -> OptOrder Never! {
    edges := [[Int]]{}
    self_call := [Bool]{}
    loop f in functions {
        out := [Int]{}
        calls_self := false
        loop at in 0..<f.op.len() {
            if f.op[at] != .Call -> next
            callee :: f.a[at]
            if callee < 0 || callee >= functions.len() -> next
            if callee == edges.len() -> calls_self = true
            &out.push(callee)
        }
        &edges.push(^out)
        &self_call.push(calls_self)
    }
    count :: functions.len()
    t := OptTarjan{edges: ^edges, index: [Int]{}, low: [Int]{}, on_stack: [Bool]{}, stack: [Int]{}, next_index: 0, order: [Int]{}, recursive: [Bool]{}}
    loop _ in 0..<count {
        &t.index.push(-1)
        &t.low.push(0)
        &t.on_stack.push(false)
        &t.recursive.push(false)
    }
    loop node in 0..<count {
        if t.index[node] < 0 -> ir_opt_tarjan_visit(&t, node)
    }
    loop node in 0..<count {
        if self_call[node] -> t.recursive[node] = true
    }
    OptOrder{order: ^t.order, recursive: ^t.recursive}
}

// Iterative Tarjan visit from `root` (the compiler's own call graphs are deep).
fn ir_opt_tarjan_visit(t: &OptTarjan, root: Int) Never! {
    work := [Int]{root}
    edge := [Int]{0}
    t.index[root] = t.next_index
    t.low[root] = t.next_index
    t.next_index += 1
    &t.stack.push(root)
    t.on_stack[root] = true
    loop work.len() > 0 {
        top :: work.len() - 1
        node :: work[top]
        if edge[top] < t.edges[node].len() {
            callee :: t.edges[node][edge[top]]
            edge[top] = edge[top] + 1
            if t.index[callee] < 0 {
                t.index[callee] = t.next_index
                t.low[callee] = t.next_index
                t.next_index += 1
                &t.stack.push(callee)
                t.on_stack[callee] = true
                &work.push(callee)
                &edge.push(0)
            } else if t.on_stack[callee] && t.index[callee] < t.low[node] {
                t.low[node] = t.index[callee]
            }
            next
        }
        _ := &work.pop()
        _ := &edge.pop()
        if work.len() > 0 {
            caller :: work[work.len() - 1]
            if t.low[node] < t.low[caller] -> t.low[caller] = t.low[node]
        }
        if t.low[node] == t.index[node] {
            component := [Int]{}
            loop t.stack.len() > 0 {
                member :: &t.stack.pop() ?? break
                t.on_stack[member] = false
                &component.push(member)
                if member == node -> break
            }
            loop member in component {
                if component.len() > 1 -> t.recursive[member] = true
                &t.order.push(member)
            }
        }
    }
}
