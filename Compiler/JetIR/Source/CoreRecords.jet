// Complete checked top-level functions into backend-neutral IR.
use {
    jet_foundation.[AccessConvention, Interner, CORE_CALLS, CallablePolicy, CallablePolicyChain, CoreCallRecord, CoreCapabilityContract, FunctionCallMetadata, FunctionDefaultRef, AuthorityDecision, ModuleID, NameVisibility, Span, TEffectFacts, TEffectSpan, TFailureCarrier, FnBody, TFuncKind, TGenericParam, BodyLambda, BodyParameter, TWebParamReconstruction, Type, body_tree_new, core_call_key, type_identity_key, body_type]
    jet_sema.[
        SemaComptimeItemRequest,
    ]
}

// The method leaf of an impl method key, without an operator `<Rhs>` suffix:
// what follows the key's last `.` or `:` (symbol_key_text).
ir_impl_method_leaf: fn(key: String) -> String Never! {
    bytes: key.bytes()
    end := bytes.len()
    if end > 0 && (Int{bytes[end - 1]}) == 62 {
        depth := 0
        position := end - 1
        loop position >= 0 {
            byte: Int{bytes[position]}
            if byte == 62 -> depth += 1
            if byte == 60 {
                depth -= 1
                if depth == 0 {
                    end = position
                    break
                }
            }
            position -= 1
        }
    }
    start := end
    loop start > 0 {
        byte: Int{bytes[start - 1]}
        if byte == 46 || byte == 58 -> break
        start -= 1
    }
    String.from_bytes(bytes[start..<end].copy()) ?? ""
}

ir_string_rows_equal: fn(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index] != right[index] -> return false
        index += 1
    }
    true
}

ir_bool_rows_equal: fn(left: [Bool], right: [Bool]) -> Bool Never! {
    if left.len() != right.len() -> return false
    index := 0
    loop index < left.len() {
        if left[index] != right[index] -> return false
        index += 1
    }
    true
}

ir_core_capability_equal: fn(left: CoreCapabilityContract, right: CoreCapabilityContract) -> Bool Never! {
    left.kind == right.kind && left.provider == right.provider && left.fallback == right.fallback && left.failure == right.failure
}

ir_authority_decisions_equal: fn(left: AuthorityDecision?, right: AuthorityDecision?) -> Bool Never! {
    if left == None -> return right == None
    if right == None -> return false
    first: left
    second: right
    first.import.id == second.import.id && first.import.operation == second.import.operation && first.import.required_right == second.import.required_right && ir_string_rows_equal(first.import.parameter_type_ids, second.import.parameter_type_ids) && first.import.result_type_id == second.import.result_type_id && first.authority_argument == second.authority_argument && first.inherited == second.inherited
}

ir_core_records_match: fn(left: CoreCallRecord, right: CoreCallRecord) -> Bool Never! {
    if left.module_name != right.module_name || left.member != right.member || !ir_string_rows_equal(left.receiver_types, right.receiver_types) {
        return false
    }
    if left.signature.arity != right.signature.arity || left.signature.max_arity != right.signature.max_arity || !ir_bool_rows_equal(left.signature.borrow_mask, right.signature.borrow_mask) {
        return false
    }
    if left.fallibility != right.fallibility || !ir_string_rows_equal(left.effects, right.effects) {
        return false
    }
    if left.pure_route != right.pure_route || left.symbol != right.symbol -> return false
    if left.coverage.bits != right.coverage.bits || left.aot_direct != right.aot_direct -> return false
    if !ir_core_capability_equal(left.capability, right.capability) -> return false
    ir_authority_decisions_equal(left.authority, right.authority)
}

ir_canonical_core_record: fn(record: CoreCallRecord) -> CoreCallRecord? Never! {
    ir_canonical_core_record_in(CORE_CALLS, record)
}

// The registry is a read parameter, so the scan reads its rows in place.
// CORE_CALLS holds one row per key (core_call_rows), so the scan stops at
// the first. None when no row has the record's key or its row disagrees
// with the record.
ir_canonical_core_record_in: fn(rows: [CoreCallRecord], record: CoreCallRecord) -> CoreCallRecord? Never! {
    key := core_call_key(record)
    loop candidate in rows {
        if core_call_key(candidate) == key {
            if !ir_core_records_match(candidate, record) -> return None
            return Val(candidate)
        }
    }
    None
}

ir_lambda_function_type: fn(lambda: BodyLambda) -> Type Never! {
    metadata := FunctionCallMetadata?{None}
    if lambda.host_param_conventions != None {
        conventions: lambda.host_param_conventions ?? [AccessConvention]{}
        metadata = Val(FunctionCallMetadata{
            names: [String]{},
            defaults: [FunctionDefaultRef?]{},
            variadic: [Bool]{},
            conventions: conventions,
            policies: CallablePolicyChain{policies: [CallablePolicy]{}},
        })
    }
    Type.Fn{params: lambda.param_types, ret: lambda.ret, effect_bound: None, param_contract: None, call_metadata: metadata, return_view_provenance: None}
}

// The synthetic function a comptime item lowers as, with an empty body the
// caller fills with the item's expression.
ir_comptime_item_shell: fn(module_identity: ModuleID, module_name: String, key: String, source_file: String, span: Span, result_type: Type) -> FnBody Never! {
    FnBody{
        name: "__comptime_item",
        module_name: module_name,
        module_identity: module_identity,
        key: key,
        source_file: source_file,
        source_span: span,
        failure_carrier: TFailureCarrier.Infallible,
        effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}},
        web_bucket: None,
        web_marker: None,
        visibility: NameVisibility.Private,
        foreign: None,
        params: [BodyParameter]{},
        web_param_reconstructions: [TWebParamReconstruction]{},
        ret: Val(result_type),
        gc_return: false,
        gc_scope: false,
        return_view_provenance: None,
        generic_params: [TGenericParam]{},
        is_main: false,
        line: 0,
        synthetic: true,
        is_unsafe: false,
        unsafe_gate: None,
        is_pure: false,
        memo_bound: None,
        memo_unbounded: false,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_inline: false,
        is_inline_always: false,
        is_scalar: false,
        kernel_proof: None,
        uses_stack_sentry: false,
        body: [Int]{},
        kind: TFuncKind.TopLevel,
        tree: body_tree_new(),
    }
}

// `module_name` is the item's module identity text: the function's module
// name and its key's prefix.
ir_comptime_item_function: fn(interner: Interner, request: SemaComptimeItemRequest, module_name: String) -> FnBody {
    result_type := body_type(interner, request.expression.tree, request.expression.root)
    if request.expected_type == .Val(expected) {
        if type_identity_key(expected) != type_identity_key(result_type) {
            panic("checked comptime item result disagrees with its expected type")
        }
        result_type = expected
    }
    ir_comptime_item_shell(request.module_identity, module_name, ir_comptime_item_key(module_name, request.key), request.source_file, request.span, result_type)
}

// The key of the item function of comptime item `key` in module
// `module_name` (ir_comptime_item_function).
ir_comptime_item_key: fn(module_name: String, key: String) -> String Never! {
    "{module_name}.__comptime_item.{key}"
}

// The next unclaimed part of a dynamically scheduled lowering, taken with
// one atomic add; every claiming thread reads the queue in place.
IRPartQueue: struct {
    next: Atomic<Int>,
}
