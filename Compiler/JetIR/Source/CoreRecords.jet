// Complete checked top-level functions into backend-neutral IR.
use {
    jet_foundation.[AccessConvention, Interner, CallablePolicy, CallablePolicyChain, FunctionCallMetadata, FunctionDefaultRef, ModuleID, NameVisibility, Span, TEffectFacts, TEffectSpan, TFailureCarrier, FnBody, TFuncKind, TGenericParam, BodyLambda, BodyParameter, TWebParamReconstruction, Type, body_tree_new, type_identity_key, body_type]
    jet_sema.[
        SemaComptimeItemRequest,
    ]
}

// The method leaf of an impl method key, without an operator `<Rhs>` suffix:
// what follows the key's last `.` or `:` (symbol_key_text).
ir_impl_method_leaf: fn(key: String) -> String Never! {
    bytes: key.bytes()
    ^end: bytes.len()
    if end > 0 && (Int{bytes[end - 1]}) == 62 {
        ^depth: 0
        ^position: end - 1
        loop position >= 0 {
            byte: Int{bytes[position]}
            if byte == 62 -> depth += 1
            if byte == 60 {
                depth -= 1
                if depth == 0 {
                    end = position
                    break
                }
            }
            position -= 1
        }
    }
    ^start: end
    loop start > 0 {
        byte: Int{bytes[start - 1]}
        if byte == 46 || byte == 58 -> break
        start -= 1
    }
    String.from_bytes(bytes[start..<end].copy()) ?? ""
}


ir_lambda_function_type: fn(lambda: BodyLambda) -> Type Never! {
    ^metadata: FunctionCallMetadata?{None}
    if lambda.host_param_conventions != None {
        conventions: lambda.host_param_conventions ?? [AccessConvention]{}
        metadata = Val(FunctionCallMetadata{
            names: [String]{},
            defaults: [FunctionDefaultRef?]{},
            variadic: [Bool]{},
            conventions: conventions,
            policies: CallablePolicyChain{policies: [CallablePolicy]{}},
        })
    }
    Type.Fn{params: lambda.param_types, ret: lambda.ret, effect_bound: None, param_contract: None, call_metadata: metadata, return_view_provenance: None}
}

// The synthetic function a comptime item lowers as, with an empty body the
// caller fills with the item's expression.
ir_comptime_item_shell: fn(module_identity: ModuleID, module_name: String, key: String, source_file: String, span: Span, result_type: Type) -> FnBody Never! {
    FnBody{
        name: "__comptime_item",
        module_name: module_name,
        module_identity: module_identity,
        key: key,
        source_file: source_file,
        source_span: span,
        failure_carrier: TFailureCarrier.Infallible,
        effects: TEffectFacts{direct: [String]{}, solved: [String]{}, call_edges: [String]{}, maximal: false, direct_spans: [TEffectSpan]{}},
        web_bucket: None,
        web_marker: None,
        visibility: NameVisibility.Private,
        foreign: None,
        params: [BodyParameter]{},
        web_param_reconstructions: [TWebParamReconstruction]{},
        ret: Val(result_type),
        gc_return: false,
        gc_scope: false,
        return_view_provenance: None,
        generic_params: [TGenericParam]{},
        is_main: false,
        line: 0,
        synthetic: true,
        is_unsafe: false,
        unsafe_gate: None,
        is_pure: false,
        memo_bound: None,
        memo_unbounded: false,
        is_reactive: false,
        reactive_upgrades: [String]{},
        is_inline: false,
        is_inline_always: false,
        is_scalar: false,
        kernel_proof: None,
        uses_stack_sentry: false,
        body: [Int]{},
        kind: TFuncKind.TopLevel,
        tree: body_tree_new(),
    }
}

// `module_name` is the item's module identity text: the function's module
// name and its key's prefix.
ir_comptime_item_function: fn(interner: Interner, request: SemaComptimeItemRequest, module_name: String) -> FnBody {
    ^result_type: body_type(interner, request.expression.tree, request.expression.root)
    if request.expected_type == .Val(expected) {
        if type_identity_key(expected) != type_identity_key(result_type) {
            panic("checked comptime item result disagrees with its expected type")
        }
        result_type = expected
    }
    ir_comptime_item_shell(request.module_identity, module_name, ir_comptime_item_key(module_name, request.key), request.source_file, request.span, result_type)
}

// The key of the item function of comptime item `key` in module
// `module_name` (ir_comptime_item_function).
ir_comptime_item_key: fn(module_name: String, key: String) -> String Never! {
    "{module_name}.__comptime_item.{key}"
}

// The next unclaimed part of a dynamically scheduled lowering, taken with
// one atomic add; every claiming thread reads the queue in place.
IRPartQueue: struct {
    next: Atomic<Int>,
}
