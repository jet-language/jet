    }
    if args.len() == 1 {
        mode_ty: ir_ty(p, b, args[0])
        if ir_untag(mode_ty) != .Int -> return ir_fail_slot(b, span, "Task.pause mode of type {ir_type_name(mode_ty)}")
        mode: ir_expr(m, p, b, args[0])
        if ir_failed(b) || mode < 0 -> return -1
        word_row: ir_word_row(m)
        raw: ir_runtime(m, b, "jet_int_owned_to_i64", [Int]{mode}, word_row)
        ir_release(m, b, mode)
        operands.push(raw)
        symbol = "jet_rt_native_task_pause_with_mode"
    }
    _: ir_runtime(m, b, symbol, operands, -1)
    ir_release(m, b, handle)
    return -1
}
// `task.join()`: the runtime takes the handle over, waits for the task and
// writes the body's outcome into the Result box (jet_rt_native_task_join
// without flattening).
ir_task_join: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, result_ty: Type, receiver: Int, span: Span) -> Int Never! {
    err_ty := Type.Int
    if ir_untag(result_ty) == .Result(_, failure) {
        err_ty = failure
    } else {
        return ir_fail_slot(b, span, "Task.join result {ir_type_name(result_ty)}")
    }
    handle: ir_expr(m, p, b, receiver)
    if ir_failed(b) || handle < 0 -> return -1
    flatten: ir_word_const(m, b, 0)
    boxed: ir_task_outcome(m, p, b, "jet_rt_native_task_join", [Int]{handle, flatten}, result_ty, err_ty, span)
    ir_lazy_consumed(m, b, handle)
    boxed
}
