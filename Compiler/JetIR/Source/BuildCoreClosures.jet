// The IR builder's closure boxes and Core closure calls: the counted box
// every function value is, `task` spawns and `core.mem.scope.guard`, with the
// owned runtime Task handle and the ScopeGuard carrier they produce.

use jet_foundation.[Span, BodyCallArg, BodyCoreClosureKind, BodyHandleOp, BodyLambda, TAllocCtor, Type, function_param_writes, name_rows_set, name_rows_value, type_carrier_identity]

// The element of a `Task<T>`.
ir_task_element: fn(ty: Type) -> Type? Never! {
    if ir_untag(ty) == .Apply(name, args) {
        if name == "Task" && args.len() == 1 -> return Val(args[0].copy())
    }
    None
}

// Whether `ty` is the ScopeGuard `core.mem.scope.guard` returns.
ir_scope_guard_type: fn(ty: Type) -> Bool Never! {
    if ir_untag(ty) == {
        .Named(name) -> name == "ScopeGuard"
        .Apply(name, args) -> name == "ScopeGuard" && args.len() == 0
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The row of a Task handle: an owned runtime JetTask whose drop joins or
// detaches it.
ir_task_row: fn(m: &IRModule, ty: Type) -> Int Never! {
    ir_intern_type(m, type_carrier_identity(ty), ir_owned_layout(IRTypeKind.Pointer, ty, "jet_rt_native_task_drop", ""))
}

// The row of a ScopeGuard: the callback's closure box, whose drop (the
// generated jet_ir_scope_guard_drop) runs the callback, then retires the box.
ir_scope_guard_row: fn(m: &IRModule, ty: Type) -> Int Never! {
    symbol: "jet_ir_scope_guard_drop"
    if name_rows_value(m.function_rows, symbol) == None {
        // The function key is its symbol, so x64 resolves the row's drop
        // symbol to this module function.
        id: m.functions.len()
        m.functions.push(ir_function_new("scope.guard.drop", symbol, symbol, "", 0))
        name_rows_set(m.function_rows, symbol, id)
        a := ir_builder_new(m.functions[id].copy())
        pointer_row: ir_pointer_row(m)
        guard: ir_new_slot(a, pointer_row, IRSlotKind.Param, ir_intern_name(m, "guard"))
        _: ir_call_closure(m, a, guard, [Int]{}, -1)
        ir_closure_unref(m, a, guard)
        ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
        m.functions[id] = a.f.move()
    }
    ir_intern_type(m, "ScopeGuard", ir_owned_layout(IRTypeKind.Pointer, ty, symbol, ""))
}

// Retires one reference to the closure box `boxed`; the last owner runs the
// box's release helper at 16 when it has one.
ir_closure_unref: fn(m: &IRModule, b: &IRBuilder, boxed: Int) Never! {
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    pointer_row: ir_pointer_row(m)
    last: ir_runtime(m, b, "jet_rt_native_closure_unref", [Int]{boxed}, bool_row)
    ir_open_if(b.f, last, b.line)
    helper: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.Load, helper, boxed, 16, -1, b.line)
    none: ir_word_const(m, b, 0)
    present: ir_bool_op(m, b, IROp.Ne, helper, none)
    ir_open_if(b.f, present, b.line)
    start: ir_args(b.f, [Int]{boxed})
    ir_emit(b.f, IROp.CallIndirect, -1, helper, start, 1, b.line)
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
}

// ---------------------------------------------------------------------------
// Function values: a heap box with its count word at 0, its code at 8, its
// release helper at 16 and the captures from 24. Every function value is a
// counted owner of its box: a copy is one more owner of the same box
// (jet_rt_native_closure_retain), a drop retires one (jet_ir_closure_drop),
// and the last owner runs the release helper, which drops the captures the
// box owns and frees it.

// The clone key of a function value row: a copy retains the box (ir_clone).
ir_closure_share: fn() -> String Never! { "#closure.share" }

// The row of a function value of type `ty`, whose drop is the generated
// jet_ir_closure_drop (a null box holds nothing).
ir_closure_row: fn(m: &IRModule, ty: Type) -> Int Never! {
    symbol: "jet_ir_closure_drop"
    if name_rows_value(m.function_rows, symbol) == None {
        // The function key is its symbol, so x64 resolves the row's drop
        // symbol to this module function.
        id: m.functions.len()
        m.functions.push(ir_function_new("closure.drop", symbol, symbol, "", 0))
        name_rows_set(m.function_rows, symbol, id)
        a := ir_builder_new(m.functions[id].copy())
        pointer_row: ir_pointer_row(m)
        boxed: ir_new_slot(a, pointer_row, IRSlotKind.Param, ir_intern_name(m, "boxed"))
        none: ir_word_const(m, a, 0)
        present: ir_bool_op(m, a, IROp.Ne, boxed, none)
        ir_open_if(a.f, present, a.line)
        ir_closure_unref(m, a, boxed)
        ir_end(a.f, a.line)
        ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
        m.functions[id] = a.f.move()
    }
    ir_intern_type(m, type_carrier_identity(ty), ir_owned_layout(IRTypeKind.Pointer, ty, symbol, ir_closure_share()))
}

// The row of the code word a function value of type `ty` holds at 8: a
// Pointer whose checked type is IR_CODE_TYPE over `ty`, so IR Lint checks a
// CallIndirect through it against the signature. A written parameter is
// passed by its address, so the row keys its mark (`fn(&[Int])` code is not
// `fn([Int])` code). A box of any other type (a scope guard's, a hook's)
// holds a plain pointer.
ir_code_row: fn(m: &IRModule, ty: Type) -> Int Never! {
    if ir_untag(ty) == .Fn(params, _, _, _, metadata, _) {
        code_ty: Type.Apply{name: IR_CODE_TYPE, args: [Type]{ir_untag(ty)}}
        written := ""
        loop index in 0..<params.len() {
            if function_param_writes(metadata, index) -> written = "{written}&{index}"
        }
        return ir_intern_type(m, "{IR_CODE_TYPE}:{type_carrier_identity(ty)}{written}", ir_layout(IRTypeKind.Pointer, code_ty, 8, 8, IRClass.Pointer, false, 64, ""))
    }
    ir_pointer_row(m)
}

// Whether the value in `slot` is a function value.
ir_closure_slot: fn(m: IRModule, b: IRBuilder, slot: Int) -> Bool Never! {
    slot >= 0 && m.types[b.f.slot_type[slot]].clone == ir_closure_share()
}

// A new box of `bytes` bytes (row `row`) holding one owner and the release
// helper of its capture shape; the caller stores the code at 8 and the
// captures (`captures`: by value, or a held place's address).
ir_closure_box: fn(m: &IRModule, b: &IRBuilder, row: Int, bytes: Int, captures: [IRCaptureSlot]) -> Int Never! {
    boxed: ir_box_alloc(m, b, bytes, row)
    one: ir_word_const(m, b, 1)
    ir_emit(b.f, IROp.Store, -1, boxed, 0, one, b.line)
    pointer_row: ir_pointer_row(m)
    release_id: ir_closure_release(m, bytes, captures)
    release: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.FunctionAddress, release, release_id, -1, -1, b.line)
    ir_emit(b.f, IROp.Store, -1, boxed, 16, release, b.line)
    boxed
}

// The release helper of a box of `bytes` bytes with `captures`: drops each
// capture the box owns as an aggregate's glue drops its members
// (ir_glue_drops), never a held place, then frees the box. One per capture
// shape.
ir_closure_release: fn(m: &IRModule, bytes: Int, captures: [IRCaptureSlot]) -> Int Never! {
    owned := [IRCaptureSlot]{}
    key := "#closure.release<{ir_align8(bytes)}"
    loop capture in captures {
        dropped: if capture.owned_row >= 0 -> capture.owned_row else -> capture.row
        if capture.by_ref || !ir_glue_drops(m, dropped) -> next
        key = "{key}|{capture.offset}:{ir_row_key(m, dropped)}"
        owned.push(IRCaptureSlot{name: capture.name.copy(), offset: capture.offset, row: dropped, by_ref: false})
    }
    key = "{key}>"
    known: name_rows_value(m.function_rows, key) ?? -1
    if known >= 0 -> return known
    id: m.functions.len()
    m.functions.push(ir_hashed_function("closure.release", key, "jet_ir_closure_release_", "", 0))
    name_rows_set(m.function_rows, key, id)
    a := ir_builder_new(m.functions[id].copy())
    boxed: ir_new_slot(a, ir_pointer_row(m), IRSlotKind.Param, ir_intern_name(m, "boxed"))
    loop capture in owned {
        value: ir_load_at(m, a, boxed, capture.offset, capture.row)
        ir_emit(a.f, IROp.Drop, -1, value, -1, -1, a.line)
    }
    size: ir_word_const(m, a, ir_align8(bytes))
    ir_free(m, a, boxed, size)
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
    m.functions[id] = a.f.move()
    id
}

// The function value in `closure` handed to the runtime, which keeps it past
// the call and retires it once through the returned release helper
// (lazy.release): a fresh box moves over, a held one gains an owner for it.
// (-1, -1) with `b` failed on an error.
ir_closure_handover: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, closure: Int, span: Span) -> (held: Int, release: Int) Never! {
    closure_ty: m.types[b.f.slot_type[closure]].ty.copy()
    held: if b.fresh[closure] -> closure else -> ir_copy_value(m, p, b, closure, span)
    if ir_failed(b) -> return (held: -1, release: -1)
    b.fresh[held] = false
    release_id: ir_lazy_helper(m, p, b, "release", closure_ty, span)
    if release_id < 0 -> return (held: -1, release: -1)
    (held: held, release: ir_lazy_address(m, b, release_id))
}

// Ends the function value in `slot` when it is a fresh temporary a call
// only lent (ir_release).
ir_release_closure: fn(m: &IRModule, b: &IRBuilder, slot: Int) Never! {
    if ir_closure_slot(m, b, slot) -> ir_release(m, b, slot)
}

// task.release(env): drops the task body's closure box once the task is done
// with it.
ir_task_release_body: fn(m: &IRModule, a: &IRBuilder) Never! {
    pointer_row: ir_pointer_row(m)
    env: ir_new_slot(a, pointer_row, IRSlotKind.Param, ir_intern_name(m, "env"))
    ir_closure_unref(m, a, env)
    ir_emit(a.f, IROp.Return, -1, -1, -1, -1, a.line)
}

// A Core closure call by kind; the kinds other than `task`, `scope.guard`
// and the transaction hooks are not built here.
ir_core_closure_call: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, kind: BodyCoreClosureKind, span: Span) -> Int Never! {
    if kind == {
        .Spawn(group, site, label, executable) -> {
            named: label ?? ir_spawn_label(p, b, executable)
            return ir_task_spawn(m, p, b, ty, group, site, named, executable, span)
        }
        .Guard(executable) -> return ir_scope_guard(m, p, b, ty, executable, span)
        .OnCommit(handle_name, executable) -> return ir_transaction_hook(m, p, b, handle_name, executable, true, span)
        .OnRollback(handle_name, executable) -> return ir_transaction_hook(m, p, b, handle_name, executable, false, span)
        .ReactiveDerived(executable) -> return ir_reactive_derived(m, p, b, ty, executable, span)
        .ReactiveEffect(executable) -> return ir_reactive_effect(m, p, b, ty, executable, span)
        .UIReactiveRender(executable) -> return ir_reactive_rooted(m, p, b, executable, span)
        .UIClickSlot(executable) -> return ir_ui_click_slot(m, p, b, ty, executable, span)
        .Realtime(_, _, _) | .UITextInputOnDrop(_, _, _) -> return ir_fail_slot(b, span, "Core closure call {ir_core_closure_name(kind)}")
    }
}

ir_core_closure_name: fn(kind: BodyCoreClosureKind) -> String Never! {
    text := "{kind}"
    separators: [String]{"(", "{{", " "}
    loop separator in separators {
        parts: text.split(separator).to_list()
        text = parts[0]
    }
    text
}

// `task body` / `group.spawn(body)`: the body becomes a zero-parameter
// closure whose result is the checked Task element (3698-3727); the runtime
// takes the box over with its task.body (lazy.callback) and task.release
// helpers and the result's descriptor. A grouped spawn joins its group.
ir_task_spawn: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, task_ty: Type, group: Int?, site: Int, label: String, executable: BodyLambda, span: Span) -> Int Never! {
    element: ir_task_element(task_ty) ?? return ir_fail_slot(b, span, "spawn producing {ir_type_name(task_ty)}")
    task_row: ir_value_type(m, p, task_ty) ?? return ir_type_fail(b, span, task_ty)
    group_slot := -1
    if group == .Val(group_value) {
        group_slot = ir_expr(m, p, b, group_value)
        if ir_failed(b) || group_slot < 0 -> return -1
    }
    int_row: ir_type_row(m, Type.Int) ?? 0
    ordinal: p.spawn_sites.get("{b.f.source_file}:{executable.source_span.start}") ?? site
    site_slot: ir_int_constant(m, b, int_row, ordinal)
    string_row: ir_string_row(m)
    label_slot: ir_temp(m, b, string_row)
    label_text: ir_intern_text(m, label)
    ir_emit(b.f, IROp.ConstText, label_slot, label_text, -1, -1, b.line)
    checked := executable
    checked.ret = if element == (Type.Named{name: "Unit"}) -> None else -> Val(element.copy())
    checked.failure_carrier = ir_failure_carrier_for_type(element)
    closure_ty: ir_lambda_function_type(checked)
    env: ir_lambda(m, p, b, closure_ty, checked, span)
    if ir_failed(b) || env < 0 -> return -1
    // ir_lambda queued the body's job last.
    m.lambdas[m.lambdas.len() - 1].task_body = true
    invoke_id: ir_lazy_helper(m, p, b, "callback", closure_ty, span)
    if invoke_id < 0 -> return -1
    invoke: ir_lazy_address(m, b, invoke_id)
    handed: ir_closure_handover(m, p, b, env, span)
    if handed.held < 0 -> return -1
    release: handed.release
    meta: ir_lazy_meta(m, p, b, element, span)
    if meta < 0 -> return -1
    // A fallible body's error descriptor shows through Debug.
    if ir_untag(element) == .Result(_, err) {
        pointer_row: ir_pointer_row(m)
        child: ir_temp(m, b, pointer_row)
        ir_emit(b.f, IROp.Load, child, meta, 64, -1, b.line)
        ir_lazy_meta_trait(m, p, b, child, err, "debug", span)
        if ir_failed(b) -> return -1
    }
    args := [Int]{}
    if group_slot >= 0 -> args.push(group_slot)
    args.push(site_slot)
    args.push(label_slot)
    args.push(handed.held)
    args.push(invoke)
    args.push(release)
    args.push(meta)
    spawned: ir_runtime(m, b, if group_slot >= 0 -> "jet_rt_native_group_spawn" else -> "jet_rt_native_task_spawn", args, task_row)
    if group_slot >= 0 -> ir_release(m, b, group_slot)
    spawned
}

// The label of a task the checker named none: the called function's name
// when the body is one direct call (`task boom()`, which the checker may wrap
// in a `?` passing the call's failure on), else none (the runtime shows
// `task@<site>`).
ir_spawn_label: fn(p: IRProgram, b: IRBuilder, executable: BodyLambda) -> String Never! {
    if executable.executable == .Expr(value) {
        id := value
        loop {
            if ir_body_node(p, b, id).kind == {
                .Call(callee, _, _) -> {
                    row: ir_decl_row(p, callee)
                    if row >= 0 -> return p.functions[row].name.copy()
                    return ""
                }
                .Try(inner, _, _) -> { id = inner }
                .TryWithContext(inner, _, _, _, _, _) -> { id = inner }
                .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> return ""
            }
        }
    }
    ""
}

// `core.mem.scope.guard(callback)`: the callback's closure box, reowned as
// the ScopeGuard whose scope-end drop runs it.
ir_scope_guard: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, executable: BodyLambda, span: Span) -> Int Never! {
    closure_ty: ir_lambda_function_type(executable)
    env: ir_lambda(m, p, b, closure_ty, executable, span)
    if ir_failed(b) || env < 0 -> return -1
    guard_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    guard: ir_fresh_temp(m, b, guard_row)
    ir_emit(b.f, IROp.Copy, guard, env, -1, -1, b.line)
    b.fresh[env] = false
    guard
}

// `mem.Arena.new(capacity:)`, `mem.Bump.new(capacity:)`, `mem.Pool.new(slots:)`,
// `mem.Fixed.new(size:)` and `mem.Fixed.over(buffer)`: the owned runtime
// allocator handle (JetRuntime MemStorage.jet). A size argument crosses as
// its native word. `Fixed.new` backs the allocator with `size` bytes of this
// frame; `Fixed.over` with the written `[U8#N]` buffer's elements.
ir_alloc_new: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, ctor: TAllocCtor, args: [BodyCallArg], span: Span) -> Int Never! {
    row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    word_row: ir_word_row(m)
    if ctor == .Fixed(size) {
        pointer_row: ir_pointer_row(m)
        data: ir_temp(m, b, pointer_row)
        ir_emit(b.f, IROp.StackAddress, data, ir_align8(size), 8, -1, b.line)
        length: ir_word_const(m, b, size)
        return ir_runtime(m, b, "jet_rt_mem_fixed_storage_over", [Int]{data, length}, row)
    }
    if ctor == .FixedOver {
        if args.len() != 1 -> return ir_fail_slot(b, span, "Fixed.over with {args.len()} arguments")
        buffer_ty: ir_ty(p, b, args[0].value)
        element_ty: if ir_untag(buffer_ty) == .FixedList(element, _) -> element else -> { return ir_fail_slot(b, span, "Fixed.over buffer of type {ir_type_name(buffer_ty)}") }
        element_row: ir_value_type(m, p, element_ty) ?? return ir_type_fail(b, span, element_ty)
        buffer: ir_expr(m, p, b, args[0].value)
        if ir_failed(b) || buffer < 0 -> return -1
        count: ir_list_length(m, b, buffer)
        stride_bytes: ir_list_stride(m, element_row)
        stride: ir_word_const(m, b, stride_bytes)
        length: ir_temp(m, b, word_row)
        ir_emit(b.f, IROp.Mul, length, count, stride, IR_OVERFLOW_WRAP, b.line)
        data: ir_list_data(m, b, buffer)
        return ir_runtime(m, b, "jet_rt_mem_fixed_storage_over", [Int]{data, length}, row)
    }
    if args.len() > 1 -> return ir_fail_slot(b, span, "allocator constructor with {args.len()} arguments")
    if args.len() == 0 {
        symbol: if ctor == {
            .Arena -> "jet_arena_new"
            .Bump -> "jet_bump_new"
            .Pool | .Fixed(_) | .FixedOver -> "jet_rt_mem_pool_storage_new"
        }
        return ir_runtime(m, b, symbol, [Int]{}, row)
    }
    size: ir_expr(m, p, b, args[0].value)
    if ir_failed(b) || size < 0 -> return -1
    native := size
    if ir_kind_of(m, b, size) == .Int {
        native = ir_runtime(m, b, "jet_int_owned_to_i64", [Int]{size}, word_row)
        ir_release(m, b, size)
    }
    symbol: if ctor == {
        .Arena -> "jet_arena_with_capacity"
        .Bump -> "jet_bump_with_capacity"
        .Pool | .Fixed(_) | .FixedOver -> "jet_pool_with_slots"
    }
    ir_runtime(m, b, symbol, [Int]{native}, row)
}

// `task.detach()`: the runtime takes the handle over and lets the task run
// on unsupervised.
ir_task_detach: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, receiver: Int, span: Span) -> Int Never! {
    handle: ir_expr(m, p, b, receiver)
    if ir_failed(b) || handle < 0 -> return -1
    _: ir_lazy_runtime(m, b, "jet_rt_native_task_detach", [Int]{handle}, -1, handle)
    return -1
}

// `task.pause()`, `task.pause(mode)`, `task.resume()` and `task.cancel()`:
// control-plane hooks over the borrowed handle (JetRuntime Task.jet
// jet_rt_native_task_pause / _pause_with_mode / _resume / _cancel). They
// return nothing and the caller keeps the handle.
ir_task_control: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, receiver: Int, operation: BodyHandleOp, args: [Int], span: Span) -> Int Never! {
    handle: ir_expr(m, p, b, receiver)
    if ir_failed(b) || handle < 0 -> return -1
    operands := [Int]{handle}
    symbol := if operation == {
        .TaskPause -> "jet_rt_native_task_pause"
        .TaskResume -> "jet_rt_native_task_resume"
