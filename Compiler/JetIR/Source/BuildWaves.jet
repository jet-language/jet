// The parallel module build: the build queue runs in waves, and each wave's
// functions build on threads, each thread into a module of its own (a part).
// The jobs are the functions the serial queue would build, in its order: a
// wave is every job the previous wave queued, and the functions a job
// queues join the next wave in job order, each key once. A thread builds
// the jobs it claims in job order, so it reaches what the serial build does
// at that job or something an earlier job already queued. A lambda body
// builds in the part that built its enclosing function (its capture layout
// lives there). Every part interns its own types, names, data and helpers;
// BuildMerge.jet merges the parts by content and numbers every row by first
// use from the jobs, so the module is the same at any thread count.

use jet_foundation.[CompilerThreads, Type, compiler_take_rows, compiler_threads_admit, compiler_threads_failure_text]

// Build threads (compiler_threads_admit): checked functions per thread.
IR_BUILD_MIN_FUNCTIONS_PER_THREAD :: 512
// A wave runs on one thread per this many claimable jobs.
IR_BUILD_MIN_JOBS_PER_THREAD :: 16

// A function to build: the checked function `row` (instance `args`) or
// lambda job `lambda` of part `part`; `part` and `local` (its id there)
// are known once it is built (a lambda's when it is queued).
struct IRWaveJob {
    key: String
    row: Int
    args: [Type]
    lambda: Int
    part: Int
    local: Int
}

// One job built: its global index, its id in the part, the jobs it queued
// (in order) and its failures.
struct IRWaveBuilt {
    index: Int
    local: Int
    found: [IRWaveJob]
    failures: [IRBuildFailure]
}

// The building threads' read-only inputs: the checked program and the
// wave's jobs (global index `first` on); per part, the positions of its
// lambda jobs, and the positions any part may claim.
struct IRWaveInputs {
    programs: [IRProgram]
    jobs: [IRWaveJob]
    first: Int
    pinned: [[Int]]
    free: [Int]
}

// A part's module, kept across waves, and the wave's builds in its order.
struct IRWaveWorker {
    modules: [IRModule]
    built: [IRWaveBuilt]
}

// The next claimable rank: a claiming part takes a read guard once and
// claims rank after rank with one atomic add.
struct IRWaveQueue { next: Atomic<Int> }

// The wave build state: every job in job order; the index of a plain
// function's job (no type arguments, not a lambda: its key is its checked
// row's, ir_function_id) by that row, and of any other job by key; and the
// failures by order key (2 * job index; the entry's sits before the jobs
// its report queued).
struct IRWaves {
    jobs: [IRWaveJob]
    row_jobs: [Int]
    keyed_jobs: [String:Int]
    failures: [Int:[IRBuildFailure]]
    parts: Int
}

// Builds the jobs `roots` (checked functions, in order) and every function
// they reach on up to `threads` threads; with `entry`, roots[0] is the
// program entry (ir_entry_function), built after the first drain.
fn ir_build_waves(program: ^IRProgram, roots: ^[IRWaveJob], entry: Bool, threads: CompilerThreads) -> IRBuildResult Never! {
    kept := ir_build_waves_kept(^program, ^roots, entry, threads)
    ^kept.result
}

// ir_build_waves, handing the checked program back with the build.
fn ir_build_waves_kept(program: ^IRProgram, roots: ^[IRWaveJob], entry: Bool, threads: CompilerThreads) -> IRBuildKept Never! {
    p := ^program
    count :: compiler_threads_admit(threads, p.functions.len(), p.functions.len(), IR_BUILD_MIN_FUNCTIONS_PER_THREAD, 0, 0)
    slots := [Shared<IRWaveWorker>]{}
    loop _ in 0..<count {
        slot :: shared IRWaveWorker{modules: [IRModule]{ir_module_for(p)}, built: [IRWaveBuilt]{}}
        &slots.push(slot)
    }
    w := IRWaves{jobs: ^roots, row_jobs: [Int]{}, keyed_jobs: [String:Int]{}, failures: [Int:[IRBuildFailure]]{}, parts: count}
    loop _ in 0..<p.functions.len() -> &w.row_jobs.push(-1)
    loop index in 0..<w.jobs.len() -> ir_waves_note(&w, index)
    inputs :: shared IRWaveInputs{programs: [IRProgram]{^p}, jobs: [IRWaveJob]{}, first: 0, pinned: [[Int]]{}, free: [Int]{}}
    from :: ir_waves_drain(inputs, slots, &w, 0)
    entry_root := IRMergeRoot{part: -1, local: -1}
    if entry {
        entry_root = ir_waves_entry(inputs, slots, &w)
        _ :: ir_waves_drain(inputs, slots, &w, from)
    }
    _ := ir_waves_glues(inputs, slots, 0) ?? panic("the IR build threads failed")
    roots_merged := [IRMergeRoot]{}
    loop index in 0..<w.jobs.len() -> &roots_merged.push(IRMergeRoot{part: w.jobs[index].part, local: w.jobs[index].local})
    entry_index := -1
    if entry {
        entry_index = roots_merged.len()
        &roots_merged.push(entry_root)
    }
    parts := [IRModule]{}
    loop slot in slots -> &parts.extend(ir_waves_take_modules(slot))
    failures := [IRBuildFailure]{}
    loop order in 0..<(2 * w.jobs.len()) {
        if w.failures.get(order) == .Val(listed) -> &failures.extend(listed)
    }
    merged := ir_merge(^parts, roots_merged, entry_index)
    IRBuildKept{result: IRBuildResult{program: ^merged, failures: failures}, program: ir_waves_take_program(inputs)}
}

fn ir_waves_take_program(inputs: Shared<IRWaveInputs>) -> IRProgram Never! {
    held := inputs.guard_edit()
    program := &held.value.programs.pop() ?? panic("the IR build lost its checked program")
    ^program
}

fn ir_waves_take_modules(slot: Shared<IRWaveWorker>) -> [IRModule] {
    held := slot.guard_edit()
    compiler_take_rows<IRModule>(&held.value.modules)
}

fn ir_waves_take_built(slot: Shared<IRWaveWorker>) -> [IRWaveBuilt] {
    held := slot.guard_edit()
    compiler_take_rows<IRWaveBuilt>(&held.value.built)
}

// Builds waves from job `from` until no job is left; returns the job count.
fn ir_waves_drain(inputs: Shared<IRWaveInputs>, slots: [Shared<IRWaveWorker>], w: &IRWaves, from: Int) -> Int Never! {
    first := from
    loop first < w.jobs.len() {
        last :: w.jobs.len()
        ir_waves_wave(inputs, slots, &w, first, last)
        first = last
    }
    first
}

// Builds jobs first..<last: hands the wave to the parts, runs them, then
// records where each job was built and queues what they found, in job order.
fn ir_waves_wave(inputs: Shared<IRWaveInputs>, slots: [Shared<IRWaveWorker>], w: &IRWaves, first: Int, last: Int) Never! {
    pinned := [[Int]]{}
    loop _ in 0..<w.parts -> &pinned.push([Int]{})
    free := [Int]{}
    loop index in first..<last {
        position :: index - first
        if w.jobs[index].lambda >= 0 {
            &pinned[w.jobs[index].part].push(position)
        } else {
            &free.push(position)
        }
    }
    claimers := w.parts
    loop claimers > 1 && claimers * IR_BUILD_MIN_JOBS_PER_THREAD > free.len() -> claimers -= 1
    runs := [Int]{}
    loop part in 0..<w.parts {
        if part < claimers || pinned[part].len() > 0 -> &runs.push(part)
    }
    ir_waves_hand(inputs, w.jobs, first, last, ^pinned, ^free)
    queue :: shared IRWaveQueue{next: 0}
    if runs.len() == 1 {
        _ := ir_wave_worker(inputs, slots[runs[0]], queue, runs[0], true)
    } else {
        _ := ir_wave_tasks(inputs, slots, queue, runs, claimers, 0) ?? panic("the IR build threads failed")
    }
    found := [[IRWaveJob]]{}
    loop _ in first..<last -> &found.push([IRWaveJob]{})
    loop part in 0..<slots.len() {
        built := ir_waves_take_built(slots[part])
        loop at in 0..<built.len() {
            index :: built[at].index
            w.jobs[index].part = part
            w.jobs[index].local = built[at].local
            found[index - first] = compiler_take_rows<IRWaveJob>(&built[at].found)
            ir_waves_fail(&w, 2 * index, &built[at].failures)
        }
    }
    loop at in 0..<found.len() -> ir_waves_queue(&w, &found[at])
}

// Hands the wave's jobs and claim lists to the threads.
fn ir_waves_hand(inputs: Shared<IRWaveInputs>, jobs: [IRWaveJob], first: Int, last: Int, pinned: ^[[Int]], free: ^[Int]) {
    permit := inputs.guard_edit()
    permit.value.jobs = [IRWaveJob]{}
    loop index in first..<last -> &permit.value.jobs.push(jobs[index].copy())
    permit.value.first = first
    permit.value.pinned = ^pinned
    permit.value.free = ^free
}

// Queues the jobs `found` (in order) not queued yet.
fn ir_waves_queue(w: &IRWaves, found: &[IRWaveJob]) Never! {
    loop job in compiler_take_rows<IRWaveJob>(&found) {
        if ir_waves_known(w, job) -> next
        index :: w.jobs.len()
        &w.jobs.push(job)
        ir_waves_note(&w, index)
    }
}

// Whether `job` builds a plain function, found by its checked row.
fn ir_waves_plain(job: IRWaveJob) -> Bool {
    job.lambda < 0 && job.args.len() == 0
}

// Whether a job of `job`'s function is queued.
fn ir_waves_known(w: IRWaves, job: IRWaveJob) -> Bool Never! {
    if ir_waves_plain(job) -> return w.row_jobs[job.row] >= 0
    w.keyed_jobs.get(job.key) != None
}

// Records job `index` as its function's job unless one is recorded.
fn ir_waves_note(w: &IRWaves, index: Int) Never! {
    if ir_waves_known(w, w.jobs[index]) -> return
    if ir_waves_plain(w.jobs[index]) {
        row :: w.jobs[index].row
        w.row_jobs[row] = index
    } else {
        w.keyed_jobs[w.jobs[index].key.copy()] = index
    }
}

fn ir_waves_fail(w: &IRWaves, order: Int, failures: &[IRBuildFailure]) Never! {
    if failures.len() == 0 -> return
    listed := w.failures.get(order) ?? [IRBuildFailure]{}
    &listed.extend(compiler_take_rows<IRBuildFailure>(&failures))
    w.failures[order] = ^listed
}

// Builds the program entry (ir_entry_function) in the part that built
// roots[0] and queues the functions its error report reached; returns its
// merge root.
fn ir_waves_entry(inputs: Shared<IRWaveInputs>, slots: [Shared<IRWaveWorker>], w: &IRWaves) -> IRMergeRoot Never! {
    part :: w.jobs[0].part
    built := ir_waves_entry_in(inputs, slots[part], part, w.jobs[0].local)
    order :: 2 * w.jobs.len() - 1
    ir_waves_fail(&w, order, &built.failures)
    ir_waves_queue(&w, &built.found)
    IRMergeRoot{part: part, local: built.local}
}

fn ir_waves_entry_in(inputs: Shared<IRWaveInputs>, slot: Shared<IRWaveWorker>, part: Int, entry: Int) -> IRWaveBuilt {
    reads :: inputs.guard_read()
    held := slot.guard_edit()
    ir_wave_entry(&held.value.modules[0], reads.value.programs[0], part, entry)
}

fn ir_wave_entry(m: &IRModule, p: IRProgram, part: Int, entry: Int) -> IRWaveBuilt Never! {
    m.subst_names = [String]{}
    m.subst_types = [Type]{}
    before :: m.queue.len()
    failures := [IRBuildFailure]{}
    local :: ir_entry_function(&m, p, entry, &failures)
    IRWaveBuilt{index: -1, local: local, found: ir_wave_found(m, part, before), failures: failures}
}

// Runs a part task per entry of `runs` (from `at`); the first `claimers`
// parts claim jobs, every one builds its lambda jobs. Returns the builds.
fn ir_wave_tasks(inputs: Shared<IRWaveInputs>, slots: [Shared<IRWaveWorker>], queue: Shared<IRWaveQueue>, runs: [Int], claimers: Int, at: Int) -> Int {
    if at >= runs.len() -> return 0
    built := 0
    task.group ir_build_threads {
        head :: task ir_wave_worker(inputs, slots[runs[at]], queue, runs[at], runs[at] < claimers)
        built = ir_wave_tasks(inputs, slots, queue, runs, claimers, at + 1)
        built += head.join() ?? ir_wave_stopped(err)
    }
    built
}

// A stopped build thread: its panic text, re-raised unchanged so an internal
// error reads the same with any thread count.
fn ir_wave_stopped(failure: TaskFailure) -> Int Never! {
    panic(compiler_threads_failure_text(failure))
}

// One part: builds the jobs it claims and its lambda jobs, in job order.
fn ir_wave_worker(inputs: Shared<IRWaveInputs>, slot: Shared<IRWaveWorker>, queue: Shared<IRWaveQueue>, part: Int, claims: Bool) -> Int {
    reads :: inputs.guard_read()
    held := slot.guard_edit()
    ranks :: queue.guard_read()
    pinned :: reads.value.pinned[part].copy()
    pin := 0
    built := 0
    loop claims {
        claimed :: ranks.value.next.add(1)
        if claimed >= reads.value.free.len() -> break
        position :: reads.value.free[claimed]
        loop pin < pinned.len() && pinned[pin] < position {
            ir_wave_build(&held.value, reads.value, part, pinned[pin])
            pin += 1
            built += 1
        }
        ir_wave_build(&held.value, reads.value, part, position)
        built += 1
    }
    loop pin < pinned.len() {
        ir_wave_build(&held.value, reads.value, part, pinned[pin])
        pin += 1
        built += 1
    }
    built
}

fn ir_wave_build(worker: &IRWaveWorker, inputs: IRWaveInputs, part: Int, position: Int) Never! {
    built := ir_wave_job(&worker.modules[0], inputs.programs[0], inputs.jobs[position], part)
    built.index = inputs.first + position
    &worker.built.push(^built)
}

// Builds `job` in part `part`'s module: a checked function's id there first
// (its stub, when an earlier job only referenced it), then its body.
fn ir_wave_job(m: &IRModule, p: IRProgram, job: IRWaveJob, part: Int) -> IRWaveBuilt Never! {
    local := job.local
    if job.lambda < 0 {
        m.subst_names = [String]{}
        m.subst_types = [Type]{}
        local = ir_function_id(&m, p, p.functions[job.row].key, job.args) ?? panic("an IR build job names no checked function")
        if m.functions[local].key != job.key -> panic("IR build job {job.key} rebuilt as {m.functions[local].key}")
    }
    before :: m.queue.len()
    failures := [IRBuildFailure]{}
    ir_build_queued(&m, p, &failures, IRQueued{row: job.row, id: local, args: job.args.copy(), lambda: job.lambda})
    IRWaveBuilt{index: -1, local: local, found: ir_wave_found(m, part, before), failures: failures}
}

// The functions queued in part `part` from queue row `before` on, as jobs.
fn ir_wave_found(m: IRModule, part: Int, before: Int) -> [IRWaveJob] Never! {
    found := [IRWaveJob]{}
    loop at in before..<m.queue.len() {
        id :: m.queue[at].id
        lambda :: m.queue[at].lambda
        &found.push(IRWaveJob{key: m.functions[id].key.copy(), row: m.queue[at].row, args: m.queue[at].args.copy(), lambda: lambda, part: if lambda >= 0 -> part else -> -1, local: if lambda >= 0 -> id else -> -1})
    }
    found
}

// Builds the drop glue of every part's types (ir_drop_glues), a task per
// part from `at` on.
fn ir_waves_glues(inputs: Shared<IRWaveInputs>, slots: [Shared<IRWaveWorker>], at: Int) -> Int {
    if at >= slots.len() -> return 0
    if at == slots.len() - 1 -> return ir_wave_glues(inputs, slots[at])
    done := 0
    task.group ir_build_threads {
        head :: task ir_wave_glues(inputs, slots[at])
        done = ir_waves_glues(inputs, slots, at + 1)
        done += head.join() ?? ir_wave_stopped(err)
    }
    done
}

fn ir_wave_glues(inputs: Shared<IRWaveInputs>, slot: Shared<IRWaveWorker>) -> Int {
    reads :: inputs.guard_read()
    held := slot.guard_edit()
    ir_drop_glues(&held.value.modules[0], reads.value.programs[0])
    1
}
