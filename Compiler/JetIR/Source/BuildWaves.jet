// The parallel module build: one queue of jobs, the functions the serial
// queue would build, that every build thread claims from and adds to. Each
// thread builds into a module of its own (a part); a job is built the moment
// a thread claims it, with no wave barrier, and the functions it queued join
// the queue, each key once. A lambda body builds in the part that built its
// enclosing function (its capture layout lives there). Every part interns its
// own types, names, data and helpers; BuildMerge.jet merges the parts by
// content and numbers every row by first use in a walk from the jobs taken in
// key order, so the module is the same whichever thread built a job and in
// whatever order the jobs were built.
use jet_foundation.[interner_empty, CompilerThreads, CompilerTraceSink, FnBody, NameTable, TConstantDef, TImplDef, TTypeDef, Type, compiler_take_rows, compiler_threads_failure_text, compiler_threads_joined, name_column, name_column_set, name_column_table, name_column_value, symbol_table]

// Building one checked function's body costs about this on one thread, so the
// build admits threads by x64 selection admission (ir_x64_admit) with each
// function one unit: a compile-time closure of a few hundred functions builds
// on several threads, not on one. Measured from a sampled profile of `jet
// build --profile dev Compiler` on 16 CPUs: 160 µs per function over the
// compiler's 52,317 (8,460 ms of part samples) and 200 µs over a
// 2,026-function comptime build (406 ms).
IR_BUILD_NS_PER_FUNCTION: 160000

// A function to build: the checked function `row` (instance `args`) or
// lambda job `lambda` of part `part`; `part` and `local` (its id there)
// are known once it is built (a lambda's when it is queued).
IRWaveJob: struct {
    key: String,
    row: Int,
    args: [Type],
    lambda: Int,
    part: Int,
    local: Int,
}

// One job built: its queue index, its id in the part, the jobs it queued
// (in order) and its failures.
IRWaveBuilt: struct {
    index: Int,
    local: Int,
    found: [IRWaveJob],
    failures: [IRBuildFailure],
}

// The building threads' read-only input: the checked program.
IRWaveInputs: struct {
    programs: [IRProgram],
}

// A part's module, kept across the build, its builds in claim order, and
// its merge input once it is built (ir_merge_prepare).
IRWaveWorker: struct {
    modules: [IRModule],
    built: [IRWaveBuilt],
    preps: [IRMergePrep],
}

// The queue the parts share: every job in the order it was queued; the jobs
// any part may claim, and per part its lambda jobs, each list claimed in
// order; how many queued jobs are unclaimed and how many parts are building
// (the build is done when both are zero); the job of a plain function (no
// type arguments, not a lambda: its key is its checked row's, ir_function_id)
// by that row, and of any other job by key.
IRBuildQueue: struct {
    jobs: [IRWaveJob],
    claimable: [Int],
    claimed: Int,
    own: [[Int]],
    own_claimed: [Int],
    waiting: Int,
    busy: Int,
    row_jobs: [Int],
    keyed_jobs_keys: NameTable,
    keyed_jobs: [Int],
}

// Rung after jobs are queued, when a part stops building and when a part
// fails: an idle part spins on it, not on the queue's lock. `stopped` is
// set once a part fails, and every part then ends (ir_build_parts); each
// part's seat holds the queue index of the job it is building (-1: none).
IRBuildBell: struct {
    rings: Atomic<Int>,
    stopped: Atomic<Int>,
    seats: [IRBuildSeat],
}

IRBuildSeat: struct {
    job: Atomic<Int>,
}

// How parts ended: the jobs they built, and the first failed part's panic
// text (empty when none failed) with the queue index of the job it was
// building (-1: it failed between jobs).
IRBuildPartsEnd: struct {
    built: Int,
    stop: String,
    job: Int,
}

// A part's batch claim: the claimed jobs' queue indices and copies, whether
// the step added new jobs to the queue, whether the part is building now,
// whether it just stopped, and whether the build is done.
IRBuildClaim: struct {
    indices: [Int],
    jobs: [IRWaveJob],
    added: Bool,
    busy: Bool,
    idled: Bool,
    done: Bool,
}

// Builds the jobs `roots` (checked functions, in order) and every function
// they reach on up to `threads` threads; with `entry`, roots[0] is the
// program entry (ir_entry_function), built after the first drain.
ir_build_waves: fn(program: ^^IRProgram, roots: ^^[IRWaveJob], entry: Bool, threads: CompilerThreads) -> IRBuildResult Never! {
    kept := ir_build_waves_kept(program, roots, entry, threads, None)
    kept.result.move()
}

// More than 12 independent IRModule parts duplicates types, helpers, and drop
// glues across every extra part without adding wall-time speedup (ir.build
// averages ~8 cores), inflating peak RSS by ~400 MiB and merge work. Measured
// again at 32 threads on the 1.09M-line compiler corpus: as many parts as
// threads doubled ir.build's CPU (15.7 s to 29.5 s) for no wall gain.
IR_BUILD_MAX_PARTS: 12

// ir_build_waves, handing the checked program back with the build, on as
// many parts as the threads admit for the program's functions
// (ir_x64_admit), at most IR_BUILD_MAX_PARTS. The merge takes the jobs in
// rank order, whichever part built each (ir_build_waves_finish), so the build
// is the same for any part count.
ir_build_waves_kept: fn(program: ^^IRProgram, roots: ^^[IRWaveJob], entry: Bool, threads: CompilerThreads, trace_sink: CompilerTraceSink?, release_program: Bool{false}) -> IRBuildKept Never! {
    admitted: ir_x64_admit(threads, program.functions.len(), program.functions.len(), IR_BUILD_NS_PER_FUNCTION)
    count: if admitted > IR_BUILD_MAX_PARTS -> IR_BUILD_MAX_PARTS else -> admitted
    ir_build_waves_parted(program, roots, entry, count, trace_sink, release_program: release_program)
}

// ir_build_waves_kept on `count` parts. A part that fails ends the build,
// which panics naming the function the part was building; one part runs on
// the calling thread, where the failing job's own panic ends it. With
// `trace_sink` each step is a span: `ir.build.parts` (the jobs on every
// part), `ir.build.entry` (the entry and what it reaches), `ir.build.glues`,
// `ir.build.order` (the jobs ranked and the parts gathered), ir_merge's
// steps and `ir.build.recursion`.
ir_build_waves_parted: fn(program: ^^IRProgram, roots: ^^[IRWaveJob], entry: Bool, count: Int, trace_sink: CompilerTraceSink?, release_program: Bool{false}) -> IRBuildKept Never! {
    p := program.move()
    slots := [Shared<IRWaveWorker>]{}
    own := [[Int]]{}
    own_claimed := [Int]{}
    seats := [IRBuildSeat]{}
    loop _ in 0..<count {
        slot: Shared{IRWaveWorker{modules: [IRModule]{ir_module_for(p)}, built: [IRWaveBuilt]{}, preps: [IRMergePrep]{}}}
        slots.push(slot)
        own.push([Int]{})
        own_claimed.push(0)
        seats.push(IRBuildSeat{job: -1})
    }
    row_jobs := [Int]{}
    loop _ in 0..<p.functions.len() -> row_jobs.push(-1)
    queue: Shared{IRBuildQueue{jobs: [IRWaveJob]{}, claimable: [Int]{}, claimed: 0, own: own.move(), own_claimed: own_claimed.move(), waiting: 0, busy: 0, row_jobs: row_jobs.move(), keyed_jobs_keys: name_column_table(), keyed_jobs: name_column()}}
    bell: Shared{IRBuildBell{rings: 0, stopped: 0, seats: seats.move()}}
    ir_build_queue_add(queue, roots)
    rooted: ir_build_queue_count(queue)
    inputs: Shared{IRWaveInputs{programs: [IRProgram]{p.move()}}}
    if trace_sink == .Val(sink) -> sink.begin("ir.build.parts", "", -1, count)
    ended := ir_build_parts(inputs, slots, queue, bell, 0) ?? panic("the IR build threads failed")
    if ended.stop != "" -> panic(ir_build_stop_text(ir_build_queue_jobs(queue), ended))
    if trace_sink == .Val(sink) -> sink.end("ir.build.parts", ended.built)
    entry_root := IRMergeRoot{part: -1, local: -1}
    entry_failures := [IRBuildFailure]{}
    if entry {
        if trace_sink == .Val(sink) -> sink.begin("ir.build.entry", "", -1, -1)
        part := 0
        local := -1
        loop part < slots.len() {
            local = ir_build_local(slots[part], 0)
            if local >= 0 -> break
            part += 1
        }
        if local < 0 -> panic("the IR build lost its entry job")
        built := ir_waves_entry_in(inputs, slots[part], part, local)
        entry_root = IRMergeRoot{part: part, local: built.local}
        entry_failures = compiler_take_rows<IRBuildFailure>(built.failures)
        reached := compiler_take_rows<IRWaveJob>(built.found)
        ir_build_queue_add(queue, reached)
        ended = ir_build_parts(inputs, slots, queue, bell, 0) ?? panic("the IR build threads failed")
        if ended.stop != "" -> panic(ir_build_stop_text(ir_build_queue_jobs(queue), ended))
        if trace_sink == .Val(sink) -> sink.end("ir.build.entry", ended.built)
    }
    if trace_sink == .Val(sink) -> sink.begin("ir.build.glues", "", -1, -1)
    glues: ir_waves_glues(inputs, slots, 0) ?? panic("the IR build threads failed")
    if trace_sink == .Val(sink) -> sink.end("ir.build.glues", glues)
    jobs := ir_build_queue_jobs(queue)
    built_parts := [[IRWaveBuilt]]{}
    parts := [IRModule]{}
    preps := [IRMergePrep]{}
    loop slot in slots {
        built_parts.push(ir_waves_take_built(slot))
        parts.extend(ir_waves_take_modules(slot))
        preps.extend(ir_waves_take_preps(slot))
    }
    if release_program {
        old_program := ir_waves_take_program(inputs)
        base_interner := old_program.interner.move()
        old_program.interner = interner_empty()
        kept_program := ir_program_declared([TTypeDef]{}, [TImplDef]{}, [TConstantDef]{}, [FnBody]{}, symbol_table(), interner_empty())
        empty_checks := kept_program.checks.move()
        kept_program.checks = old_program.checks.move()
        old_program.checks = empty_checks.move()
        // Split old_program.functions across 4 parallel drop tasks so the
        // checked ASTs (~1 GB) finish freeing during ir.build.order /
        // ir.merge.group / ir.merge.walk, before ir.merge.functions peaks.
        fns := compiler_take_rows<FnBody>(old_program.functions)
        n: fns.len()
        q1 := [FnBody]{}
        q2 := [FnBody]{}
        q3 := [FnBody]{}
        if n >= 256 {
            cut: n.div_euclid(4)
            loop fns.len() > cut * 3 -> q3.push(fns.pop() ?? break)
            loop fns.len() > cut * 2 -> q2.push(fns.pop() ?? break)
            loop fns.len() > cut -> q1.push(fns.pop() ?? break)
        }
        result_box := [IRBuildResult]{}
        task.group ir_build_drop_program {
            d0: task ^^old_program { old_program.types.len() }
            d1: task ^^fns { fns.len() }
            d2: task ^^q1 { q1.len() }
            d3: task ^^q2 { q2.len() }
            d4: task ^^q3 { q3.len() }
            result_box.push(ir_build_waves_finish(jobs.move(), built_parts.move(), parts.move(), preps.move(), base_interner.move(), rooted, entry, entry_root.move(), entry_failures.move(), trace_sink))
            _: compiler_threads_joined(d0)
            _: compiler_threads_joined(d1)
            _: compiler_threads_joined(d2)
            _: compiler_threads_joined(d3)
            _: compiler_threads_joined(d4)
        }
        finished := result_box.pop() ?? panic("the IR build lost its merged result")
        return IRBuildKept{result: finished.move(), program: kept_program.move()}
    }
    program_out := ir_waves_take_program(inputs)
    base_interner := program_out.interner.move()
    program_out.interner = interner_empty()
    finished := ir_build_waves_finish(jobs.move(), built_parts.move(), parts.move(), preps.move(), base_interner.move(), rooted, entry, entry_root.move(), entry_failures.move(), trace_sink)
    IRBuildKept{result: finished.move(), program: program_out.move()}
}

ir_build_waves_finish: fn(owned_jobs: ^^[IRWaveJob], owned_built: ^^[[IRWaveBuilt]], owned_parts: ^^[IRModule], owned_preps: ^^[IRMergePrep], base_interner: ^^Interner, rooted: Int, entry: Bool, entry_root: ^^IRMergeRoot, entry_failures: ^^[IRBuildFailure], trace_sink: CompilerTraceSink?) -> IRBuildResult Never! {
    if trace_sink == .Val(sink) -> sink.begin("ir.build.order", "", -1, -1)
    jobs := owned_jobs.move()
    built_parts := owned_built.move()
    parts := owned_parts.move()
    preps := owned_preps.move()
    failed := [[IRBuildFailure]]{}
    loop _ in 0..<jobs.len() -> failed.push([IRBuildFailure]{})
    loop part in 0..<built_parts.len() {
        loop at in 0..<built_parts[part].len() {
            index: built_parts[part][at].index
            jobs[index].part = part
            jobs[index].local = built_parts[part][at].local
            failed[index] = compiler_take_rows<IRBuildFailure>(built_parts[part][at].failures)
        }
    }
    // The roots in their order, then the functions they reached in key order,
    // not queue order: the queue order depends on which thread reached a
    // function first. (Each key is queued once. `sort_by`, as `sort()` leaves
    // a list of named tuples in place.)
    later := [{key: String, index: Int}]{}
    loop index in rooted..<jobs.len() -> later.push({key: jobs[index].key.copy(), index: index})
    later.sort_by(fn(left: {key: String, index: Int}, right: {key: String, index: Int}) { left.key <=> right.key })
    ranked := [Int]{}
    loop index in 0..<rooted -> ranked.push(index)
    loop row in later -> ranked.push(row.index)
    roots_merged := [IRMergeRoot]{}
    failures := [IRBuildFailure]{}
    loop index in ranked {
        roots_merged.push(IRMergeRoot{part: jobs[index].part, local: jobs[index].local})
        failures.extend(compiler_take_rows<IRBuildFailure>(failed[index]))
    }
    failures.extend(entry_failures.move())
    entry_index := -1
    if entry {
        entry_index = roots_merged.len()
        roots_merged.push(entry_root.move())
    }
    if trace_sink == .Val(sink) -> sink.end("ir.build.order", jobs.len())
    merged := ir_merge_with(parts.move(), preps.move(), roots_merged, entry_index, base_interner.move(), true, trace_sink)
    IRBuildResult{program: merged.move(), failures: failures}
}

ir_waves_take_program: fn(inputs: Shared<IRWaveInputs>) -> IRProgram Never! {
    held := inputs.guard_edit()
    program := held.value.programs.pop() ?? panic("the IR build lost its checked program")
    program.move()
}

ir_waves_take_modules: fn(slot: Shared<IRWaveWorker>) -> [IRModule] {
    held := slot.guard_edit()
    compiler_take_rows<IRModule>(held.value.modules)
}

ir_waves_take_preps: fn(slot: Shared<IRWaveWorker>) -> [IRMergePrep] {
    held := slot.guard_edit()
    compiler_take_rows<IRMergePrep>(held.value.preps)
}

ir_waves_take_built: fn(slot: Shared<IRWaveWorker>) -> [IRWaveBuilt] {
    held := slot.guard_edit()
    compiler_take_rows<IRWaveBuilt>(held.value.built)
}

// The id in `slot`'s part of the function job `index` built, -1 when the
// part did not build it.
ir_build_local: fn(slot: Shared<IRWaveWorker>, index: Int) -> Int {
    held := slot.guard_edit()
    loop row in held.value.built {
        if row.index == index -> return row.local
    }
    -1
}

ir_build_queue_jobs: fn(queue: Shared<IRBuildQueue>) -> [IRWaveJob] {
    held := queue.guard_edit()
    compiler_take_rows<IRWaveJob>(held.value.jobs)
}

ir_build_queue_count: fn(queue: Shared<IRBuildQueue>) -> Int {
    held := queue.guard_read()
    held.value.jobs.len()
}

// Queues the jobs `found` (in order) not queued yet: a lambda job for the
// part that queued it, any other for any part.
ir_build_queue_add: fn(queue: Shared<IRBuildQueue>, found: ^^[IRWaveJob]) {
    rows := found.move()
    held := queue.guard_edit()
    loop job in compiler_take_rows<IRWaveJob>(rows) {
        if ir_build_known(held.value, job) -> next
        index: held.value.jobs.len()
        part: job.part
        lambda: job.lambda >= 0
        held.value.jobs.push(job)
        ir_build_note(held.value, index)
        if lambda -> held.value.own[part].push(index) else -> held.value.claimable.push(index)
        held.value.waiting += 1
    }
}

// Whether `job` builds a plain function, found by its checked row.
ir_waves_plain: fn(job: IRWaveJob) -> Bool { job.lambda < 0 && job.args.len() == 0 }

// Whether a job of `job`'s function is queued.
ir_build_known: fn(q: IRBuildQueue, job: IRWaveJob) -> Bool Never! {
    if ir_waves_plain(job) -> return q.row_jobs[job.row] >= 0
    name_column_value(q.keyed_jobs_keys, q.keyed_jobs, job.key) != None
}

// Records job `index` as its function's job.
ir_build_note: fn(q: ^IRBuildQueue, index: Int) Never! {
    if ir_waves_plain(q.jobs[index]) {
        row: q.jobs[index].row
        q.row_jobs[row] = index
    } else { name_column_set(q.keyed_jobs_keys, q.keyed_jobs, q.jobs[index].key, index) }
}

// Part `part`'s fused queue step: queues `found` (discovered by its previous
// batch), then claims up to 8 jobs (own lambda jobs first) under a single lock
// acquisition so workers avoid lock contention on every function.
ir_build_step: fn(queue: Shared<IRBuildQueue>, part: Int, busy: Bool, found: ^^[IRWaveJob]) -> IRBuildClaim {
    rows := found.move()
    held := queue.guard_edit()
    added := false
    loop job in compiler_take_rows<IRWaveJob>(rows) {
        if ir_build_known(held.value, job) -> next
        index: held.value.jobs.len()
        job_part: job.part
        lambda: job.lambda >= 0
        held.value.jobs.push(job)
        ir_build_note(held.value, index)
        if lambda -> held.value.own[job_part].push(index) else -> held.value.claimable.push(index)
        held.value.waiting += 1
        added = true
    }
    own_avail: held.value.own[part].len() - held.value.own_claimed[part]
    shared_avail: held.value.claimable.len() - held.value.claimed
    parts_count: held.value.own.len()
    want: if {
        own_avail > 0 -> if own_avail > 8 -> 8 else -> own_avail
        shared_avail >= parts_count * 16 -> 8
        shared_avail >= parts_count * 4 -> 4
        else -> 1
    }
    indices := [Int]{}
    jobs := [IRWaveJob]{}
    loop indices.len() < want {
        index := -1
        taken: held.value.own_claimed[part]
        if taken < held.value.own[part].len() {
            index = held.value.own[part][taken]
            held.value.own_claimed[part] = taken + 1
        } else if held.value.claimed < held.value.claimable.len() {
            index = held.value.claimable[held.value.claimed]
            held.value.claimed += 1
        }
        if index < 0 -> break
        held.value.waiting -= 1
        indices.push(index)
        jobs.push(held.value.jobs[index].copy())
    }
    if indices.len() > 0 {
        if !busy -> held.value.busy += 1
        return IRBuildClaim{indices: indices.move(), jobs: jobs.move(), added: added, busy: true, idled: false, done: false}
    }
    if busy -> held.value.busy -= 1
    IRBuildClaim{indices: [Int]{}, jobs: [IRWaveJob]{}, added: added, busy: false, idled: busy, done: held.value.waiting == 0 && held.value.busy == 0}
}

// Runs a part per slot from `at` on, each on a task of its own that this
// thread watches, until the queue is drained or a part fails; returns how
// they ended. A failed part never rings for the jobs it held, so its
// watcher stops the build and rings: the parts waiting on it end instead
// of spinning forever. A build of one part runs it on the calling thread,
// so a small program starts no thread; a failure there is the job's own
// panic, which no watcher names.
ir_build_parts: fn(inputs: Shared<IRWaveInputs>, slots: [Shared<IRWaveWorker>], queue: Shared<IRBuildQueue>, bell: Shared<IRBuildBell>, at: Int) -> IRBuildPartsEnd {
    if slots.len() == 1 && at == 0 -> return ir_build_part(inputs, slots[0], queue, bell, 0)
    ended := IRBuildPartsEnd{built: 0, stop: "", job: -1}
    if at >= slots.len() -> return ended
    task.group ir_build_threads {
        head: task ir_build_part(inputs, slots[at], queue, bell, at)
        rest: task ir_build_parts(inputs, slots, queue, bell, at + 1)
        ended = head.join() ?? IRBuildPartsEnd{built: 0, stop: compiler_threads_failure_text(err), job: -1}
        if ended.stop != "" {
            rings: bell.guard_read()
            ended.job = rings.value.seats[at].job.load()
            rings.value.stopped.store(1)
            _: rings.value.rings.add(1)
        }
        later := compiler_threads_joined(rest)
        ended.built += later.built
        if ended.stop == "" {
            ended.stop = later.stop.move()
            ended.job = later.job
        }
    }
    ended
}

// A failed part's panic text with the function it was building, so an
// internal error reads the same on any count of parts above one.
ir_build_stop_text: fn(jobs: [IRWaveJob], ended: IRBuildPartsEnd) -> String {
    if ended.job < 0 -> return "the IR build stopped: {ended.stop}"
    "the IR build of {jobs[ended.job].key} stopped: {ended.stop}"
}

// One part: claims and builds batches of jobs, queueing what each batch found
// in the same lock step, until no job is unclaimed and no part is building,
// or a part failed.
ir_build_part: fn(inputs: Shared<IRWaveInputs>, slot: Shared<IRWaveWorker>, queue: Shared<IRBuildQueue>, bell: Shared<IRBuildBell>, part: Int) -> IRBuildPartsEnd {
    reads: inputs.guard_read()
    held := slot.guard_edit()
    rings: bell.guard_read()
    busy := false
    built := 0
    pending_found := [IRWaveJob]{}
    loop {
        // The rings are read before the stop: a stop set after this test
        // rings after the read, so the spin below sees it.
        seen: rings.value.rings.load()
        if rings.value.stopped.load() != 0 -> break
        claim := ir_build_step(queue, part, busy, pending_found.move())
        pending_found = [IRWaveJob]{}
        busy = claim.busy
        // Ring whenever new jobs were added or this part just idled.
        if claim.added || claim.idled -> _: rings.value.rings.add(1)
        if claim.done -> break
        if claim.indices.len() == 0 {
            loop rings.value.rings.load() == seen {

            }
            next
        }
        batch_indices := claim.indices.move()
        batch_jobs := claim.jobs.move()
        batch_indices.reverse()
        batch_jobs.reverse()
        loop batch_indices.len() > 0 {
            if rings.value.stopped.load() != 0 -> break
            idx: batch_indices.pop() ?? break
            job := batch_jobs.pop() ?? break
            rings.value.seats[part].job.store(idx)
            made := ir_wave_job(held.value.modules[0], reads.value.programs[0], job, part)
            rings.value.seats[part].job.store(-1)
            made.index = idx
            found := compiler_take_rows<IRWaveJob>(made.found)
            held.value.built.push(made)
            built += 1
            if found.len() > 0 -> pending_found.extend(found)
        }
    }
    IRBuildPartsEnd{built: built, stop: "", job: -1}
}

ir_waves_entry_in: fn(inputs: Shared<IRWaveInputs>, slot: Shared<IRWaveWorker>, part: Int, entry: Int) -> IRWaveBuilt {
    reads: inputs.guard_read()
    held := slot.guard_edit()
    ir_wave_entry(held.value.modules[0], reads.value.programs[0], part, entry)
}

ir_wave_entry: fn(m: ^IRModule, p: IRProgram, part: Int, entry: Int) -> IRWaveBuilt Never! {
    before: m.queue.len()
    failures := [IRBuildFailure]{}
    local: ir_entry_function(m, p, entry, failures)
    IRWaveBuilt{index: -1, local: local, found: ir_wave_found(m, part, before), failures: failures}
}

// Builds `job` in part `part`'s module: a checked function's id there first
// (its stub, when an earlier job only referenced it), then its body.
ir_wave_job: fn(m: ^IRModule, p: IRProgram, job: IRWaveJob, part: Int) -> IRWaveBuilt Never! {
    local := job.local
    if job.lambda < 0 {
        local = ir_function_id(m, p, p.functions[job.row].key, job.args) ?? panic("an IR build job names no checked function")
        if m.functions[local].key != job.key {
            panic("IR build job {job.key} rebuilt as {m.functions[local].key}")
        }
    }
    before: m.queue.len()
    failures := [IRBuildFailure]{}
    ir_build_queued(m, p, failures, IRQueued{row: job.row, id: local, args: job.args.copy(), lambda: job.lambda})
    IRWaveBuilt{index: -1, local: local, found: ir_wave_found(m, part, before), failures: failures}
}

// The functions queued in part `part` from queue row `before` on, as jobs.
ir_wave_found: fn(m: IRModule, part: Int, before: Int) -> [IRWaveJob] Never! {
    found := [IRWaveJob]{}
    loop at in before..<m.queue.len() {
        id: m.queue[at].id
        lambda: m.queue[at].lambda
        found.push(IRWaveJob{key: m.functions[id].key.copy(), row: m.queue[at].row, args: m.queue[at].args.copy(), lambda: lambda, part: if lambda >= 0 -> part else -> -1, local: if lambda >= 0 -> id else -> -1})
    }
    found
}

// Describes every part's variant types (ir_debug_variants), builds their
// drop glue (ir_drop_glues), then the part's merge input
// (ir_merge_prepare), a task per part from `at` on.
ir_waves_glues: fn(inputs: Shared<IRWaveInputs>, slots: [Shared<IRWaveWorker>], at: Int) -> Int {
    if at >= slots.len() -> return 0
    if at == slots.len() - 1 -> return ir_wave_glues(inputs, slots[at])
    done := 0
    task.group ir_build_threads {
        head: task ir_wave_glues(inputs, slots[at])
        done = ir_waves_glues(inputs, slots, at + 1)
        done += compiler_threads_joined(head)
    }
    done
}

ir_wave_glues: fn(inputs: Shared<IRWaveInputs>, slot: Shared<IRWaveWorker>) -> Int {
    reads: inputs.guard_read()
    held := slot.guard_edit()
    ir_debug_variants(held.value.modules[0], reads.value.programs[0])
    ir_drop_glues(held.value.modules[0], reads.value.programs[0])
    held.value.preps.push(ir_merge_prepare(held.value.modules[0]))
    ir_module_drop_build_memos(held.value.modules[0])
    1
}

// A build of one job naming a checked function the program does not hold:
// the part that claims it fails, and on more than one part the others are
// left with nothing to claim while it is counted as building.
ir_build_stop_test_run: fn(count: Int) -> String Never! {
    p := ir_program_declared([TTypeDef]{}, [TImplDef]{}, [TConstantDef]{}, [FnBody]{}, symbol_table(), interner_empty())
    roots := [IRWaveJob]{IRWaveJob{key: "test:stop.jet.gone", row: 0, args: [Type]{Type.Int}, lambda: -1, part: -1, local: -1}}
    kept := ir_build_waves_parted(p.move(), roots.move(), false, count, None)
    "the build ended with {kept.result.failures.len()} failures"
}

#Test("a build part that fails ends the build, naming the function it was building") {
    loop count in 2..<4 {
        stop := ""
        task.group ir_build_stop_test {
            run: task ir_build_stop_test_run(count)
            stop = run.join() ?? compiler_threads_failure_text(err)
        }
        assert(stop.contains("the IR build of test:stop.jet.gone stopped: "), stop)
    }
}

// One part runs on the calling thread, so the build's stop is the job's own:
// reading row 0 of a program that holds no function.
#Test("a one-part build runs on the calling thread, so its failure is the job's own") {
    stop := ""
    task.group ir_build_stop_test {
        run: task ir_build_stop_test_run(1)
        stop = run.join() ?? compiler_threads_failure_text(err)
    }
    assert(stop.contains("position 0 doesn't exist") && !stop.contains("the IR build of"), stop)
}
