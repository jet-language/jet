// Core source-body reachability: which imported Core source bodies a program
// builds.
use {
    jet_foundation.[
        BodyHandleOp,
        BodyLambda,
        BodyNode,
        BodyStrPart,
        BodyTree,
        CompilerThreads,
        CompilerTraceSink,
        FnBody,
        NodeKind,
        StmtKind,
        TExprType,
        TFuncKind,
        body_each_expr_child,
        body_each_stmt_child,
        body_node,
        body_node_index,
        body_type,
        checked_expr_type_id,
        compiler_take_rows,
        compiler_threads_admit,
        compiler_threads_failure_text,
        compiler_threads_partition,
        compiler_transfer_rows,
        TStrFormat,
        TTryConvert,
        core_identity_in_module,
        foundation_byte_text,
    ]
    jet_foundation.[DeclTable, Interner, ModuleID, NameTable, Span, SymbolTable, Type, TypeID, decl_table_find, decl_table_key, interner_empty, module_is_core, name_column, name_column_set_first, name_column_table, name_count, name_find, name_index, name_intern, name_table_sized, symbol_key, type_syntax]
}

ir_core_reach_is_top_level: fn(kind: TFuncKind) -> Bool Never! {
    if kind == {
        .TopLevel -> true
        .Method(_, _) | .TraitMethod(_, _, _, _, _) -> false
    }
}

// Whether a function is a derived Encode/Decode method: a compiler-generated
// `encode`/`decode`/`__read`/`encode_stored`/`decode_stored` method. Sema
// checks one only when a codec requirement demands it, and its callers reach
// it through an owner-type lookup during instance lowering (`value.encode()`
// inside `json.to_string<T>`, `__Decoding.read<T, …>`), never by a key in a
// body, so a checked one is rooted.
ir_core_reach_generated_codec: fn(function: FnBody) -> Bool Never! {
    function.synthetic && !ir_core_reach_is_top_level(function.kind) && (function.name == "encode" || function.name == "decode" || function.name == "__read" || function.name == "encode_stored" || function.name == "decode_stored")
}

// Source-owned selector policy. Both reachability and expression lowering
// use this map, so the exact helper emitted by a selector is rooted.
ir_string_format_member: fn(ty: Type, format: TStrFormat) -> String? Never! {
    integer: ir_string_format_integer(ty)
    if format == {
        .Display | .Debug | .Number -> None
        .Pretty -> Val("pretty")
        .Fixed(_) -> Val(if integer -> "fixed_int" else -> "decimal")
        .Grouped(_) -> Val(if integer -> "grouped_int_fixed" else -> "grouped")
        .Hex(_) -> Val(if integer -> "hex" else -> "hex_decimal")
        .Bin -> Val(if integer -> "bin" else -> "bin_decimal")
        .Oct -> Val(if integer -> "oct" else -> "oct_decimal")
        .Sci(_) -> Val("sci")
        .Percent(_) -> Val("percent")
        .Pad(_, _) -> Val("pad")
        .PadLeft(_, _) -> Val("pad_left")
        .Unit(_) -> Val("quantity")
    }
}

// Whether a checked source path names the Core file `relative` (`Core/...`).
// A Core unit outside the entry root keeps its canonical or `<corelib>/`
// prefixed path (`jet_driver_display_path`), so `relative` is its suffix.
ir_core_source_path: fn(path: String, relative: String) -> Bool Never! {
    path == relative || path.ends_with("/{relative}")
}

// Whether a function with these header fields is a Core/Text/Fmt.jet
// selector helper (ir_string_format_member). `core`: whether its module is
// a Core module (module_is_core).
ir_string_format_source: fn(core: Bool, source_file: String, kind: TFuncKind) -> Bool Never! {
    core && ir_core_source_path(source_file, "Core/Text/Fmt.jet") && ir_core_reach_is_top_level(kind)
}

// Whether a function with these header fields is one of the core.term
// print-style helpers `print` calls by name (BuildTypes.jet
// ir_print_style_row): a top-level `__print_` function of Core/Term/Term.jet.
ir_print_style_source: fn(core: Bool, source_file: String, kind: TFuncKind, name: String) -> Bool Never! {
    core && ir_core_source_path(source_file, "Core/Term/Term.jet") && ir_core_reach_is_top_level(kind) && name.starts_with("__print_")
}

// A `#Context(print: …)` block roots the print-style helpers: only a program
// that sets a style prints through them, and any other prints as Show.
ir_print_style_keys: fn(functions: [FnBody], keys: &[String]) Never! {
    loop function in functions {
        if ir_print_style_source(module_is_core(function.module_identity), function.source_file, function.kind, function.name) {
            ir_core_reach_add(keys, function.key)
        }
    }
}

// The Core/Encoding/Encoding.jet decode helpers Dyn decode and
// `FieldError.under` call by name (BuildDyn.jet ir_dyn_decode,
// ir_decode_under).
ir_codec_decode_helpers: fn() -> [String] Never! {
    [String]{"__decode_list", "__decode_fixed_list", "__decode_bytes", "__decode_f32", "__decode_option", "__decode_map", "__decode_dyn", "__decode_under"}
}

// Whether a function with these header fields is one of those helpers.
ir_codec_decode_source: fn(core: Bool, source_file: String, kind: TFuncKind, name: String) -> Bool Never! {
    if !core || !ir_core_source_path(source_file, "Core/Encoding/Encoding.jet") || !ir_core_reach_is_top_level(kind) {
        return false
    }
    loop helper in ir_codec_decode_helpers() {
        if helper == name -> return true
    }
    false
}

// The Core/Args/Args.jet helper a checked `ArgsSpec` / `ParsedArgs` method
// calls by name (BuildExpr.jet ir_args_method), or None for another
// operation.
ir_args_helper: fn(operation: BodyHandleOp) -> String? Never! {
    if operation == {
        .ArgsSpecFlag -> Val("__args_flag")
        .ArgsSpecFlagShort -> Val("__args_flag_short")
        .ArgsSpecOption -> Val("__args_option")
        .ArgsSpecOptionShort -> Val("__args_option_short")
        .ArgsSpecOptionDefault -> Val("__args_option_default")
        .ArgsSpecOptionEnv -> Val("__args_option_env")
        .ArgsSpecOptionInt -> Val("__args_option_int")
        .ArgsSpecOptionFloat -> Val("__args_option_float")
        .ArgsSpecOptionChoice -> Val("__args_option_choice")
        .ArgsSpecRepeat -> Val("__args_repeat")
        .ArgsSpecRequiredOption -> Val("__args_required_option")
        .ArgsSpecPositional -> Val("__args_positional")
        .ArgsSpecDescription -> Val("__args_description")
        .ArgsSpecSubcommand -> Val("__args_subcommand")
        .ArgsSpecVersion -> Val("__args_version")
        .ArgsSpecCompletion -> Val("__args_completion")
        .ArgsSpecHelp -> Val("__args_help")
        .ArgsSpecParse -> Val("__args_parse")
        .ArgsSpecParseOrExit -> Val("__args_parse_or_exit")
        .ParsedArgsFlag -> Val("__parsed_flag")
        .ParsedArgsOption -> Val("__parsed_option")
        .ParsedArgsOptionInt -> Val("__parsed_option_int")
        .ParsedArgsOptionFloat -> Val("__parsed_option_float")
        .ParsedArgsOptions -> Val("__parsed_options")
        .ParsedArgsPositional -> Val("__parsed_positional")
        .ParsedArgsSubcommand -> Val("__parsed_subcommand")
        .Hardware(_) | .DurationNew(_, _) | .FileReaderReadLine | .FileReaderRead(_) | .FileReaderSeek | .FileReaderPath | .MappedFileWindow | .MappedFileWindowLen | .MappedFileLines | .LinesIter | .MappedFileLen | .MappedFileIsEmpty | .FileWriterWriteLine | .FileWriterFlush | .FileWriterWriteAll | .FileWriterFsync | .FileWriterPath | .JSONLReaderNext | .JSONLWriterWrite | .JSONLWriterFlush | .JSONLWriterFinish | .DataStreamNext | .XMLReaderNext | .XMLWriterWrite | .XMLWriterFlush | .XMLWriterFinish | .StdinReadLine | .StdoutWrite | .StdoutWriteLine | .StdoutWriteBytes | .StdoutFlush | .StdoutIsTTY | .StderrWrite | .StderrWriteLine | .StderrWriteBytes | .StderrFlush | .StderrIsTTY | .WorldNow | .WorldAdvance | .WorldWaitIdle | .WorldHistory | .RealtimeNextDeadline | .RealtimeReceipt | .RealtimeCancel | .RealtimeIsCanceled | .GameSceneNew | .GameReplayRecord | .GameBackendHeadless | .GameBackendShouldContinue | .GameBackendPresent | .GameSceneOnFrame(_, _) | .GameSceneComponent | .GameSceneQuery | .GameAssetsImage | .GameAssetsSound | .GameInputBind | .GameInputPressed | .RNGInt | .RNGFloat | .RNGFloatRange | .RNGBool | .RNGBoolP | .RNGNormal | .RNGExponential | .RNGBytes | .RNGSplit | .RNGPick | .RNGWeightedPick | .RNGSample | .RNGShuffle | .DurationIn | .DurationIsZero | .DurationTotalSeconds | .DurationDifference | .TestSuiteRun | .TestSetting | .DurationAbs | .DurationNegated | .DurationSign | .DurationTotalIn | .DurationRound | .DurationNsValue | .DurationScale | .DurationDivide | .AllocAlloc | .AllocTryAlloc | .AllocReset | .PreciseMethod(_, _) | .TCPListenerAccept | .TCPListenerAcceptDeadline | .TCPListenerLocalAddr | .TCPStreamRead | .TCPStreamPeerAddr | .TCPStreamLocalAddr | .TCPStreamClose | .TCPStreamReadBytes(_) | .TCPStreamReadBytesDeadline(_) | .TCPStreamReadText | .TCPStreamReadTextDeadline | .TCPStreamWriteBytes | .TCPStreamWriteBytesDeadline | .TCPStreamWriteAllBytes | .TCPStreamWriteAllBytesDeadline | .TCPStreamWriteText | .TCPStreamWriteTextDeadline | .TCPStreamShutdown | .TCPStreamReady | .UDPSocketReady | .UDPSocketClose | .UDPSocketReceiveDeadline | .UDPSocketSendToDeadline | .UnixListenerAcceptDeadline | .UnixStreamReadDeadline(_) | .UnixStreamWriteAllDeadline | .UnixStreamReady | .UnixStreamClose | .UnixStreamSetTimeout | .TerminalSessionResize | .ProcessStdinWrite | .ProcessStdinWriteText | .ProcessStdinClose | .ProcessStdinWriteAll | .ProcessStdoutRead | .ProcessStderrRead | .ReflectValueRead(_) | .ReflectValueFields | .ReflectFieldName | .ReflectFieldValue | .TaskJoin | .TaskDetach | .TaskPause | .TaskResume | .TaskCancel | .ChannelReceive | .ChannelTryReceive | .ChannelIsTimer | .ChannelIsInterval | .ChannelIsCanceled | .ChannelIsReady | .ChannelDelayMs | .ChannelClose | .SenderSend | .MathMethod(_, _) | .ReactiveGet | .ReactiveSet | .ReactiveEffectMethod | .EventMethod(_) | .LayoutMethod(_) | .DynField | .DynAt | .DynInt | .DynText | .DynBool | .DynFloat | .DynToText | .DynEqualUnordered | .DynDecode(_, _) | .DynIndexKey(_, _) | .DynIndexAt(_, _) | .DynGetKey | .DynGetAt | .DynHas | .DynKeys | .DynLen(_, _) | .DynRemove | .DynBinary(_, _, _) | .DynCompare(_, _, _) | .DynSetPath(_, _, _) | .SerdeEncode(_) | .JSONField | .JSONAt | .JSONInt | .JSONText | .JSONBool | .JSONFloat | .JSONToText | .JSONEqualUnordered | .PathFrom | .PathHome | .PathJoin | .PathParent | .PathExtension | .PathStem | .PathNormalize | .PathIsWithin | .PathToString | .PathWalk | .PluginInvoke(_, _) | .ReaderOver(_) | .ReaderReadU8 | .ReaderReadI8 | .ReaderReadU16Le | .ReaderReadU16Be | .ReaderReadI16Le | .ReaderReadI16Be | .ReaderReadU32Le | .ReaderReadU32Be | .ReaderReadI32Le | .ReaderReadI32Be | .ReaderReadU64Le | .ReaderReadU64Be | .ReaderReadI64Le | .ReaderReadI64Be | .ReaderReadF32Le | .ReaderReadF32Be | .ReaderReadF64Le | .ReaderReadF64Be | .ReaderPeek | .ReaderSeek | .ReaderSkip | .ReaderTake | .ReaderRemaining | .ReaderAtEnd | .CursorOver | .CursorTakeUntil | .CursorSkipWs | .CursorTakePattern(_, _) | .ReaderTakePattern(_, _) | .ProcessLines -> None
    }
}

// Whether a function with these header fields is one of those helpers.
ir_args_source: fn(core: Bool, source_file: String, kind: TFuncKind, name: String) -> Bool Never! {
    core && ir_core_source_path(source_file, "Core/Args/Args.jet") && ir_core_reach_is_top_level(kind) && (name.starts_with("__args_") || name.starts_with("__parsed_"))
}

ir_precise_source_family: fn(name: String, owner: String, prefix: String) -> Bool Never! {
    if !name.starts_with(prefix) -> return false
    helper: ir_precise_source_helper(owner, name.slice(prefix.len(), name.len())) ?? return false
    helper == name
}

// The precise type (`Fraction`, `Decimal`, `Complex`) whose registry family
// holds `name` (`__fraction_add`), or None. Only a value of that type runs
// the family.
ir_precise_source_family_owner: fn(name: String) -> String? Never! {
    if ir_precise_source_family(name, "Fraction", "__fraction_") -> return Val("Fraction")
    if ir_precise_source_family(name, "Decimal", "__decimal_") -> return Val("Decimal")
    if ir_precise_source_family(name, "Complex", "__complex_") -> return Val("Complex")
    None
}

// A precise operation (the Int and Float `abs` helpers and the Fraction,
// Decimal and Complex registry) or a fallible unit conversion lowers to its
// `Core/Math/Math.jet` helper by name from sites with no keyed call:
// registered `core.math.fraction`/`decimal` constructors, constants,
// synthesized operations and checked unit conversions. That closed registry
// is rooted, not every `__` helper in the file. The typed `abs` and the Float
// and F32 powers are jet_builtins roles instead (ir_precise_source_target).
ir_precise_source_name: fn(name: String) -> Bool Never! {
    loop owner in ["Int", "Float"] {
        if (ir_precise_source_helper(owner, "abs") ?? "") == name -> return true
    }
    if name == ir_unit_conversion_helper(false) || name == ir_unit_conversion_helper(true) {
        return true
    }
    ir_precise_source_family_owner(name) != None
}

// A precise-operation source helper, by its registered name, or a Core
// function that fills a jet_builtins role (FnBody.role), which lowering finds
// by that role.
ir_precise_source_target: fn(function: FnBody) -> Bool Never! {
    (function.role != "" && module_is_core(function.module_identity)) || (ir_core_reach_is_top_level(function.kind) && ir_precise_source_function(module_is_core(function.module_identity), function.source_file, function.name))
}

// Whether a top-level Core function with these header fields is one of the
// precise-operation source helpers (ir_precise_source_name).
ir_precise_source_function: fn(core: Bool, source_file: String, name: String) -> Bool Never! {
    core && ir_core_source_path(source_file, "Core/Math/Math.jet") && ir_precise_source_name(name)
}

// Whether a top-level Core function with these header fields is one lowering
// keeps by name, with no keyed call in a kept caller's checked body: a
// Fmt.jet selector helper, an Encoding.jet decode helper, an Args.jet
// helper, a core.term print-style helper, a precise-operation source helper
// or a core.process line reader (ir_process_line_reader). A compile that
// lowers checks each up front under Core demand (driver
// jet_driver_core_lowering_roots), since no checked body names it.
ir_core_lowered_by_name: fn(core: Bool, source_file: String, name: String) -> Bool Never! {
    top: TFuncKind.TopLevel
    if ir_string_format_source(core, source_file, top) || ir_codec_decode_source(core, source_file, top, name) || ir_args_source(core, source_file, top, name) || ir_print_style_source(core, source_file, top, name) || ir_precise_source_function(core, source_file, name) {
        return true
    }
    ir_core_process_source(core, source_file) && (name == ir_process_line_reader("ProcessStdoutStream") || name == ir_process_line_reader("ProcessStderrStream"))
}

// Whether a function with these header fields is core.process's, whose one
// source is Core/Process/Process.jet.
ir_core_process_source: fn(core: Bool, source_file: String) -> Bool Never! {
    core && ir_core_source_path(source_file, "Core/Process/Process.jet")
}

// The core.process function that reads one line of a child's stream of
// owner type `owner` (ProcessStdoutStream / ProcessStderrStream), or "".
ir_process_line_reader: fn(owner: String) -> String Never! {
    if owner == "ProcessStdoutStream" -> "__stdout_next_line" else if owner == "ProcessStderrStream" -> "__stderr_next_line" else -> ""
}

// Whether an authored inherent Core method named `name` is one lowering
// selects by its owner type, with no keyed call in a kept caller's checked
// body: the renderers and the comparison Build.jet's owner tables take
// (`display`, `show`, `debug`, `compare`, `close`), a line reader
// (ir_line_reader_key) and an encoding reader's `next`
// (ir_encoding_reader_next_key). A compile that lowers checks each up front
// under Core demand (driver jet_driver_core_lowering_roots). `debug` is the
// user Debug implementation ir_render_debug_impl selects for `{value:Debug}`;
// unrooted, a Core type's own `impl Debug` is pruned and the value renders in
// the derived struct form instead.
ir_core_method_lowered_by_owner: fn(name: String) -> Bool Never! {
    name == "display" || name == "show" || name == "debug" || name == "compare" || name == "close" || name == "read_line" || name == "next"
}

// The `__Decoding` reads of Core/Encoding/Encoding.jet that lowering selects
// by a `__Decoding.read` call's target (BuildDyn.jet ir_decoding_read), with
// no keyed call in a checked body. A compile that lowers checks each up front
// under Core demand (driver jet_driver_core_lowering_roots).
ir_decoding_reads: fn() -> [String] Never! {
    [String]{"read_list", "read_option", "read_map", "read_int", "read_bool", "read_float", "read_string"}
}

// Whether method `name` of Core nominal `owner` in module `module_identity`
// is one of those reads.
ir_core_decoding_read: fn(module_identity: String, owner: String, name: String) -> Bool Never! {
    if owner != "__Decoding" || !core_identity_in_module(module_identity, "core.encoding") {
        return false
    }
    loop read in ir_decoding_reads() {
        if read == name -> return true
    }
    false
}

ir_core_reach_add: fn(keys: &[String], key: String) Never! {
    if key != "" -> keys.push(key.copy())
}

ir_core_reach_lambda_keys: fn(interner: Interner, tree: BodyTree, value: BodyLambda, functions: [FnBody], keys: &[String]) Never! {
    if value.executable == {
        .Block(body) -> { ir_core_reach_stmt_keys(interner, tree, body, functions, keys) }
        .Expr(_) -> {}
    }
}

// The Core function `loop line in handle.lines()` reads each line with
// (jet_std_file_reader_read_line / jet_std_io_stdin_read_line / the process
// stream line readers): the Core `read_line` whose owner is the handle's type,
// FileReader or StdinHandle, or core.process `__stdout_next_line` /
// `__stderr_next_line` for a child's ProcessStdoutStream / ProcessStderrStream;
// "" when the program holds none.
ir_line_reader_key: fn(functions: [FnBody], handle: Type) -> String Never! {
    owner: ir_line_reader_owner(handle)
    if owner == "" -> return ""
    stream: ir_process_line_reader(owner)
    loop function in functions {
        if stream != "" {
            if function.name == stream && ir_core_process_source(module_is_core(function.module_identity), function.source_file) {
                return function.key.copy()
            }
            next
        }
        if function.name != "read_line" || !module_is_core(function.module_identity) -> next
        if function.kind == .Method(_, owner_type) {
            if ir_line_reader_owner(owner_type) == owner -> return function.key.copy()
        }
    }
    ""
}

// The unqualified nominal name of `ty`, or "".
ir_line_reader_owner: fn(ty: Type) -> String Never! {
    name: ir_nominal_name(ir_untag(ty)) ?? return ""
    parts: name.split(".").to_list()
    parts[parts.len() - 1].copy()
}

// The key of encoding reader `reader`'s Core `next` method, which a loop over
// it calls each step (TForInMethod.EncodingReader), or "".
ir_encoding_reader_next_key: fn(functions: [FnBody], reader: Type) -> String Never! {
    owner: ir_line_reader_owner(reader)
    if owner == "" -> return ""
    loop function in functions {
        if function.name != "next" || !module_is_core(function.module_identity) -> next
        if function.kind == .Method(_, owner_type) {
            if ir_line_reader_owner(owner_type) == owner -> return function.key.copy()
        }
    }
    ""
}

// A line or encoding reader loop has no keyed NodeKind.Call: it roots its
// handle's line reader (ir_line_reader_key) or its reader's `next`
// (ir_encoding_reader_next_key) from the checked function inventory, and the
// ordinary reachability walk retains their dependencies.
ir_core_reach_one_stmt_keys: fn(interner: Interner, tree: BodyTree, statement: Int, functions: [FnBody], keys: &[String]) Never! {
    if tree.stmts[statement] == {
        .ForIn(_, _, _, source, collection, _, method, _, _, _, body, _) -> {
            if method == .Val(kind) && (kind == .LinesFile || kind == .LinesStdin || kind == .LinesProcessStream) {
                ir_core_reach_add(keys, ir_line_reader_key(functions, body_type(interner, tree, source)))
            }
            if method == .Val(kind) {
                if kind == .EncodingReader(_) {
                    ir_core_reach_add(keys, ir_encoding_reader_next_key(functions, body_type(interner, tree, collection)))
                }
            }
            ir_core_reach_stmt_keys(interner, tree, body, functions, keys)
        }
        .ContractScope(_, body, _, _, _) | .TaskGroup(_, _, body, _) | .Loop(_, body, _) | .While(_, _, body, _) | .ForRange(_, _, _, _, _, _, body, _, _) | .Range(_, _, _, _, _, _, _, _, body, _) -> {
            ir_core_reach_stmt_keys(interner, tree, body, functions, keys)
        }
        .Inline(body, _) | .DebugOnly(body, _) | .DeepCheck(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Defer(body, _) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Layout(_, _, body, _) | .ScopeMember(_, body, _) | .Transact(_, _, _, body, _) | .Unsafe(_, body) -> {
            ir_core_reach_stmt_keys(interner, tree, body, functions, keys)
        }
        .ContextBlock(guards, body, _) -> {
            loop guard in guards {
                if guard.field == "print" -> ir_print_style_keys(functions, keys)
            }
            ir_core_reach_stmt_keys(interner, tree, body, functions, keys)
        }
        .RefutableBind(_, _, body, _) -> { ir_core_reach_stmt_keys(interner, tree, body, functions, keys) }
        .If(_, then_body, else_body, _, _) -> {
            ir_core_reach_stmt_keys(interner, tree, then_body, functions, keys)
            if else_body == .Val(body) -> ir_core_reach_stmt_keys(interner, tree, body, functions, keys)
        }
        .CountedLoop(_, init, _, step, _, body, _) -> {
            ir_core_reach_one_stmt_keys(interner, tree, init, functions, keys)
            if step == .Val(value) -> ir_core_reach_one_stmt_keys(interner, tree, value, functions, keys)
            ir_core_reach_stmt_keys(interner, tree, body, functions, keys)
        }
        .Match(_, arms, _, _) -> {
            loop arm in arms -> ir_core_reach_stmt_keys(interner, tree, arm.body, functions, keys)
        }
        .EnumMatch(_, arms, else_body, _, _) -> {
            loop arm in arms -> ir_core_reach_stmt_keys(interner, tree, arm.body, functions, keys)
            if else_body == .Val(body) -> ir_core_reach_stmt_keys(interner, tree, body, functions, keys)
        }
        .MixedSwitch(_, _, arms, else_body, _) -> {
            loop arm in arms -> ir_core_reach_stmt_keys(interner, tree, arm.body, functions, keys)
            if else_body == .Val(body) -> ir_core_reach_stmt_keys(interner, tree, body, functions, keys)
        }
        .RangeSwitch(_, arms, body, _) -> {
            loop arm in arms -> ir_core_reach_stmt_keys(interner, tree, arm.body, functions, keys)
            ir_core_reach_stmt_keys(interner, tree, body, functions, keys)
        }
        .Reactive(value, _) -> { ir_core_reach_lambda_keys(interner, tree, value, functions, keys) }
        .GCEdit(_, _, _, _, _, edited, _) -> {
            ir_core_reach_one_stmt_keys(interner, tree, edited, functions, keys)
        }
        .Contract(_) | .Let(_, _, _, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .DeferClose(_, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> {}
    }
}

ir_core_reach_stmt_keys: fn(interner: Interner, tree: BodyTree, statements: [Int], functions: [FnBody], keys: &[String]) Never! {
    loop statement in statements -> ir_core_reach_one_stmt_keys(interner, tree, statement, functions, keys)
}

// The function keys one checked expression names directly; a direct call's
// callee row (`decl_rows` by its DeclID row) goes straight to `targets`.
// Children are walked by the caller.
ir_core_reach_expr_keys: fn(interner: Interner, tree: BodyTree, expression: Int, functions: [FnBody], symbols: SymbolTable, keys: &[String], source_keys: IRReachSources, decl_rows: [Int], targets: &[Int]) Never! {
    if tree.nodes[body_node_index(tree, expression)].kind == {
        .Call(callee, _, args) -> {
            index: callee.row.index()
            if index < decl_rows.len() && decl_rows[index] >= 0 -> targets.push(decl_rows[index])
            loop argument in args {
                loop item in argument.template_items {
                    ir_core_reach_add(keys, symbol_key(symbols, tree.symbols, item))
                }
            }
        }
        .MethodCall(_, method, _, args) -> {
            ir_core_reach_add(keys, symbol_key(symbols, tree.symbols, method.symbol))
            loop argument in args {
                loop item in argument.template_items {
                    ir_core_reach_add(keys, symbol_key(symbols, tree.symbols, item))
                }
            }
        }
        .StaticCall(_, _, method, _, args) -> {
            ir_core_reach_add(keys, symbol_key(symbols, tree.symbols, method.symbol))
            loop argument in args {
                loop item in argument.template_items {
                    ir_core_reach_add(keys, symbol_key(symbols, tree.symbols, item))
                }
            }
        }
        .Index(_, _, _, _, checked_call, _) -> {
            if checked_call == Val(symbol) {
                ir_core_reach_add(keys, symbol_key(symbols, tree.symbols, symbol))
            }
        }
        // assert_eq's authored `equal`/`compare` hook (ir_require_eq_hook).
        .RequireStop(kind, _, _) -> {
            if kind == .RequireEq(_, _, hook) {
                if hook == .Val(method) {
                    ir_core_reach_add(keys, symbol_key(symbols, tree.symbols, method.symbol))
                }
            }
        }
        .FnValue(kind) -> {
            if kind == .NamedFn(function, _) {
                if function == .Val(id) {
                    index: id.row.index()
                    if index < decl_rows.len() && decl_rows[index] >= 0 {
                        targets.push(decl_rows[index])
                    }
                }
            }
        }
        // A function named as a value checks as a constant reference.
        .ConstRef(symbol) -> { ir_core_reach_add(keys, symbol_key(symbols, tree.symbols, symbol)) }
        // Interpolation selectors call their source formatter by name with no
        // keyed call.
        .StrLit(parts) -> {
            loop part in parts {
                if part == .Interpolation(value, format) {
                    member: ir_string_format_member(body_type(interner, tree, value), format) ?? next
                    key: ir_core_reach_source_key(source_keys, member) ?? next
                    ir_core_reach_add(keys, key)
                }
            }
        }
        // `tree.decode<T>()` of a container and `FieldError.under` call their
        // Core decode helper by name; a helper's own `decode<Item>` reaches
        // the others, so a decode site roots them all. An `ArgsSpec` /
        // `ParsedArgs` method calls its Core/Args/Args.jet helper by name.
        // The ambient `input` (LinesIter) reads each line with its receiver's
        // Core `read_line` (__InputLines).
        .HandleMethod(receiver, operation, _) -> {
            if operation == .DynDecode(_, _) {
                loop name in ir_codec_decode_helpers() {
                    ir_core_reach_add(keys, ir_core_reach_source_key(source_keys, name) ?? "")
                }
            }
            if operation == .LinesIter {
                ir_core_reach_add(keys, ir_line_reader_key(functions, body_type(interner, tree, receiver)))
            }
            if ir_args_helper(operation) == .Val(helper) {
                ir_core_reach_add(keys, ir_core_reach_source_key(source_keys, helper) ?? "")
            }
        }
        .DecodeUnder(_, _) -> {
            ir_core_reach_add(keys, ir_core_reach_source_key(source_keys, "__decode_under") ?? "")
        }
        .InlineBlock(body) -> { ir_core_reach_stmt_keys(interner, tree, body, functions, keys) }
        .Lambda(value) -> { ir_core_reach_lambda_keys(interner, tree, value, functions, keys) }
        .IfExpr(_, then_body, _, else_body, _) -> {
            ir_core_reach_stmt_keys(interner, tree, then_body, functions, keys)
            ir_core_reach_stmt_keys(interner, tree, else_body, functions, keys)
        }
        .GlobalShared(initializer, _) -> {
            index: initializer.row.index()
            if index < decl_rows.len() && decl_rows[index] >= 0 -> targets.push(decl_rows[index])
        }
        // A `?` calls its declared error conversion (`impl Source -> Target`)
        // by key, with no call node.
        .Try(_, conversion, _) -> { ir_named_conversion_key(conversion, keys) }
        .TryWithContext(_, _, conversion, _, _, _) -> ir_named_conversion_key(conversion, keys)
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .Local(_) | .Unit | .Uninit | .CtLit(_) | .TraitConst(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .BuiltinMethod(_, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
}

// Every function key one checked function body names, including its
// parameter defaults, which call sites lower from the callee; its direct
// calls' callee rows go to `targets`. The expressions are walked from a
// work list, so each node's visitor closure captures only the list (a
// closure box per node is still allocated; it stays one word of capture).
ir_core_reach_function_keys: fn(interner: Interner, function: FnBody, functions: [FnBody], symbols: SymbolTable, source_keys: IRReachSources, decl_rows: [Int], targets: &[Int]) -> [String] Never! {
    keys := [String]{}
    ir_core_reach_stmt_keys(interner, function.tree, function.body, functions, keys)
    pending := [Int]{}
    loop parameter in function.params {
        if parameter.default == Val(value) -> pending.push(value)
    }
    loop statement in function.body {
        ir_core_reach_statement_roots(function.tree, statement, pending)
    }
    loop pending.len() > 0 {
        expression: pending.pop() ?? break
        ir_core_reach_expr_keys(interner, function.tree, expression, functions, symbols, keys, source_keys, decl_rows, targets)
        ir_core_reach_expr_children(function.tree, expression, pending)
    }
    keys
}

// The expressions directly under statement `statement` (and its nested
// statements), appended to `pending`.
ir_core_reach_statement_roots: fn(tree: BodyTree, statement: Int, pending: &[Int]) Never! {
    body_each_stmt_child(tree, tree.stmts[statement], fn(child: Int) { pending.push(child) })
}

// The child expressions of `expression`, appended to `pending`.
ir_core_reach_expr_children: fn(tree: BodyTree, expression: Int, pending: &[Int]) Never! {
    body_each_expr_child(tree, tree.nodes[body_node_index(tree, expression)], fn(child: Int) { pending.push(child) })
}

// The `Core/Math/Math.jet` helper one checked expression lowers to by name: a
// precise operation or method, a typed `abs`, a registered
// `core.math.fraction`/`decimal` constructor, or a fallible unit conversion.
ir_precise_expr_helper: fn(expression: BodyNode) -> String? Never! {
    if expression.kind == {
        .UnitConvert(_, _, _, rounding, fallible, _, _, _) -> if fallible -> Val(ir_unit_conversion_helper(rounding != None)) else -> None
        .PreciseBuiltin(owner, operation, _) -> ir_precise_source_helper(owner, operation)
        .HandleMethod(_, operation, _) -> if operation == .PreciseMethod(owner, method) -> ir_precise_source_helper(owner, method) else -> None
        .MathBuiltin(owner, operation, _) -> if owner == "Int" || owner == "Complex" || operation == "abs" -> ir_precise_source_helper(owner, operation) else -> None
        .CoreCall(record, _, _, _, _, _) -> {
            canonical: ir_canonical_core_record(record)
            if canonical.module_name != "core.math" -> return None
            if canonical.member == "fraction" -> return ir_precise_source_helper("Fraction", "new")
            if canonical.member == "decimal" {
                return ir_precise_source_helper("Decimal", "from_str")
            }
            None
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> None
    }
}

// The distinct precise source helpers a checked body and its root expressions
// lower to: by name, and by the jet_builtins role whose Core function they
// run. A comptime closure holds only explicitly called functions, so it adds
// these (`jet_driver_comptime_function_closure`).
IRPreciseHelpers: struct {
    names: [String],
    roles: [String],
}

ir_precise_helper_names: fn(interner: Interner, tree: BodyTree, roots: [Int], body: [Int]) -> IRPreciseHelpers Never! {
    found := IRPreciseHelpers{names: [String]{}, roles: [String]{}}
    loop root in roots -> ir_precise_tree_names(interner, tree, root, found)
    loop statement in body {
        body_each_stmt_child(tree, tree.stmts[statement], fn(child: Int) { ir_precise_tree_names(interner, tree, child, found) })
    }
    found
}

// The jet_builtins role a precise expression's Core function fills (a typed
// `abs`), or None.
ir_precise_expr_role: fn(expression: BodyNode) -> String? Never! {
    if expression.kind == .PreciseBuiltin(owner, operation, _) {
        return ir_precise_source_role(owner, operation)
    }
    if expression.kind == .MathBuiltin(owner, operation, _) {
        return ir_precise_source_role(owner, operation)
    }
    if expression.kind == .HandleMethod(_, operation, _) {
        if operation == .PreciseMethod(owner, method) {
            return ir_precise_source_role(owner, method)
        }
    }
    None
}

// The Core power role a Float or F32 `value.pow(y)` of type `ty` calls
// (BuildTypes ir_binary), added once; nothing for an integer power.
ir_precise_power_name: fn(ty: Type, found: &IRPreciseHelpers) Never! {
    bare: ir_untag(ty)
    owner := ""
    if bare == Type.Float -> owner = "Float"
    if bare == Type.Float32 -> owner = "F32"
    role: ir_precise_source_role(owner, "pow") ?? return
    if !found.roles.contains(role) -> found.roles.push(role)
}

// The precise helpers one checked expression and every expression below it
// lower to, each added once, read in place (body_each_expr_child).
// Functions an expression tree names that Sema records no call fact for: a
// function named as a value (`probe: pkg_lua_render_probe`), a direct call
// Sema rewrote to its Core source function (`math.sqrt(x)` checks as the
// `core.math.sqrt` Core row, then calls `Core/Math/Math.jet` `sqrt`), and the
// declared error conversion a `?` calls (`impl Source -> Target`). A
// compile-time body queues each for lowering itself. Each key once, in tree order.
ir_named_function_keys: fn(tree: BodyTree, roots: [Int], body: [Int], decls: DeclTable, symbols: SymbolTable) -> [String] Never! {
    keys := [String]{}
    loop root in roots -> ir_named_function_tree(tree, root, keys, decls, symbols)
    loop statement in body {
        body_each_stmt_child(tree, tree.stmts[statement], fn(child: Int) { ir_named_function_tree(tree, child, keys, decls, symbols) })
    }
    keys
}

ir_named_function_tree: fn(tree: BodyTree, expression: Int, keys: &[String], decls: DeclTable, symbols: SymbolTable) Never! {
    idx: body_node_index(tree, expression)
    if tree.nodes[idx].kind == {
        .ConstRef(symbol) -> {
            key: symbol_key(symbols, tree.symbols, symbol)
            if key.starts_with("function:") && !keys.contains(key) -> keys.push(key)
        }
        .Call(callee, _, _) -> {
            key: decl_table_key(decls, symbols, callee)
            if key.starts_with("function:") && !keys.contains(key) -> keys.push(key)
        }
        .Try(_, conversion, _) -> { ir_named_conversion_key(conversion, keys) }
        .TryWithContext(_, _, conversion, _, _, _) -> ir_named_conversion_key(conversion, keys)
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
    body_each_expr_child(tree, tree.nodes[idx], fn(child: Int) { ir_named_function_tree(tree, child, keys, decls, symbols) })
}

ir_named_conversion_key: fn(conversion: TTryConvert, keys: &[String]) Never! {
    key: if conversion == {
        .Typed(key, _, _) | .TypedIntoUnion(key, _, _, _, _) -> key
        .NoConversion | .Never | .DefaultErr | .WidenUnion(_, _) | .RewidenUnion(_) -> {
            return
        }
    }
    if !keys.contains(key) -> keys.push(key.copy())
}

// A type whose Encode (`encode`) or Decode (`decode`) implementation a
// checked body and its root expressions reach by owner type: every
// `tree.decode<T>()` target decodes, every `value.encode()` receiver encodes,
// and every type argument of a generic call does either (a codec such as
// `cbor.to_bytes_canonical<T>` encodes its `T` inside the instance). Their
// lowering calls the implementation by owner type and a container's
// Core/Encoding/Encoding.jet helper by name (ir_dyn_decode, ir_serde_encode),
// and Sema records no call fact for either, so a compile-time body queues
// them itself (jet_driver_comptime_codec_refs).
IRComptimeCodecTarget: struct {
    ty: Type,
    encode: Bool,
    decode: Bool,
}

ir_comptime_codec_targets: fn(interner: Interner, tree: BodyTree, roots: [Int], body: [Int]) -> [IRComptimeCodecTarget] Never! {
    targets := [IRComptimeCodecTarget]{}
    loop root in roots -> ir_comptime_codec_tree(interner, tree, root, targets)
    loop statement in body {
        body_each_stmt_child(tree, tree.stmts[statement], fn(child: Int) { ir_comptime_codec_tree(interner, tree, child, targets) })
    }
    targets
}

ir_comptime_codec_tree: fn(interner: Interner, tree: BodyTree, expression: Int, targets: &[IRComptimeCodecTarget]) Never! {
    idx: body_node_index(tree, expression)
    if tree.nodes[idx].kind == {
        .HandleMethod(receiver, operation, _) -> {
            if operation == .DynDecode(target, _) {
                targets.push(IRComptimeCodecTarget{ty: target.copy(), encode: false, decode: true})
            }
            if operation == .SerdeEncode(_) {
                if checked_expr_type_id(tree.expr_types, receiver) == .Val(type_id) {
                    targets.push(IRComptimeCodecTarget{ty: type_syntax(interner, type_id), encode: true, decode: false})
                }
            }
        }
        .Call(_, type_args, _) -> {
            loop arg in type_args {
                targets.push(IRComptimeCodecTarget{ty: arg.copy(), encode: true, decode: true})
            }
        }
        .MethodCall(_, _, type_args, _) -> {
            loop arg in type_args {
                targets.push(IRComptimeCodecTarget{ty: arg.copy(), encode: true, decode: true})
            }
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
    body_each_expr_child(tree, tree.nodes[idx], fn(child: Int) { ir_comptime_codec_tree(interner, tree, child, targets) })
}

// The type ids of every expression a checked body and its root expressions
// hold, each once. A value of a Close type runs its owner's `close` when it
// is closed or dropped, and a value of a Display or Printable type renders
// through its owner's `display` or `show`; lowering calls both by owner type
// with no call fact, so a compile-time body queues those methods itself
// (jet_driver_comptime_owner_refs).
ir_comptime_expression_types: fn(tree: BodyTree, roots: [Int], body: [Int]) -> [TypeID] Never! {
    seen := [U32:Bool]{}
    ids := [TypeID]{}
    loop root in roots -> ir_comptime_expression_types_tree(tree, root, seen, ids)
    loop statement in body {
        body_each_stmt_child(tree, tree.stmts[statement], fn(child: Int) { ir_comptime_expression_types_tree(tree, child, seen, ids) })
    }
    ids
}

ir_comptime_expression_types_tree: fn(tree: BodyTree, expression: Int, seen: &[U32:Bool], ids: &[TypeID]) Never! {
    if checked_expr_type_id(tree.expr_types, expression) == .Val(type_id) {
        if !seen.has_key(type_id.id) {
            seen[type_id.id] = true
            ids.push(type_id)
        }
    }
    body_each_expr_child(tree, tree.nodes[body_node_index(tree, expression)], fn(child: Int) { ir_comptime_expression_types_tree(tree, child, seen, ids) })
}

// A Fraction division also tests its divisor (ir_precise_division), and a
// Float or F32 `value.pow(y)` calls its power (ir_precise_power_name). A value
// of a precise type may render (an interpolation, `print`, a List's text),
// and its rendering calls its owner's `to_string` helper by name
// (ir_render_push).
ir_precise_tree_names: fn(interner: Interner, tree: BodyTree, expression: Int, found: &IRPreciseHelpers) Never! {
    idx: body_node_index(tree, expression)
    helper: ir_precise_expr_helper(tree.nodes[idx])
    if helper == .Val(name) {
        if !found.names.contains(name) -> found.names.push(name)
    }
    if ir_precise_expr_role(tree.nodes[idx]) == .Val(role) {
        if !found.roles.contains(role) -> found.roles.push(role)
    }
    if tree.nodes[idx].kind == .PreciseBuiltin(owner, operation, _) {
        if owner == "Fraction" && operation == "div" {
            zero_test: ir_precise_source_helper("Fraction", "is_zero") ?? ""
            if zero_test != "" && !found.names.contains(zero_test) -> found.names.push(zero_test)
        }
    }
    if tree.nodes[idx].kind == .Binary(op, _, _, _, _) {
        if op == .Pow -> ir_precise_power_name(body_type(interner, tree, expression), found)
    }
    if checked_expr_type_id(tree.expr_types, expression) == .Val(type_id) {
        owners := [String]{}
        ir_precise_rendered_owners(type_syntax(interner, type_id), owners)
        loop owner in owners {
            rendering: ir_precise_source_helper(owner, "to_string") ?? next
            if !found.names.contains(rendering) -> found.names.push(rendering)
        }
    }
    body_each_expr_child(tree, tree.nodes[idx], fn(child: Int) { ir_precise_tree_names(interner, tree, child, found) })
}

// The core.math precise types (`Decimal`, `Fraction`, `Complex`) a value of
// `ty` holds directly or as an element, each added once.
ir_precise_rendered_owners: fn(ty: Type, owners: &[String]) Never! {
    if ty == {
        .Named(name) -> {
            short: ir_short_name(name)
            if short != "Decimal" && short != "Fraction" && short != "Complex" {
                return
            }
            if name != short && !name.ends_with("core.math.{short}") && !name.ends_with("core.math.{short}") {
                return
            }
            if !owners.contains(short) -> owners.push(short)
        }
        .Apply(_, args) -> {
            loop arg in args -> ir_precise_rendered_owners(arg, owners)
        }
        .List(element) -> { ir_precise_rendered_owners(element, owners) }
        .FixedList(element, _) -> { ir_precise_rendered_owners(element, owners) }
        .Option(inner) -> { ir_precise_rendered_owners(inner, owners) }
        .Shared(inner) -> ir_precise_rendered_owners(inner, owners)
        .Tagged(_, inner) | .Case(_, inner) -> { ir_precise_rendered_owners(inner, owners) }
        .Map(key, _, value) -> {
            ir_precise_rendered_owners(key, owners)
            ir_precise_rendered_owners(value, owners)
        }
        .Result(ok, err) -> {
            ir_precise_rendered_owners(ok, owners)
            ir_precise_rendered_owners(err, owners)
        }
        .Tuple(fields) -> {
            loop field in fields -> ir_precise_rendered_owners(field.ty, owners)
        }
        .Union(members) -> {
            loop member in members -> ir_precise_rendered_owners(member, owners)
        }
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> {}
    }
}

// Reachability precedes concrete instance lowering. A checked generic/operator
// target keeps its declaration, without stripping the owner's own arguments.
ir_core_reach_template_key: fn(key: String) -> String Never! {
    bytes: key.bytes()
    if bytes.len() == 0 || (Int{bytes[bytes.len() - 1]}) != 62 -> return key.copy()
    depth := 0
    position := bytes.len() - 1
    loop position >= 0 {
        byte: Int{bytes[position]}
        if byte == 62 -> depth += 1
        if byte == 60 {
            depth -= 1
            if depth == 0 -> return foundation_byte_text(bytes, 0, position)
        }
        position -= 1
    }
    key.copy()
}

// Which checked functions to lower: one flag per row of `functions`, read in
// place (never copied). Only rows flagged in `candidates` take part: every
// candidate outside `core_module_identities` is a root, and a top-level
// candidate of a listed module (Core source, including a compiler-private
// part's receiver function, a dependency package, or under `dead_code:
// remove` the entry package's own) is kept only when a kept body names it or
// its key is in `rooted_keys` (the entry package's entry, jobs and exports;
// Pipeline.jet jet_driver_entry_root_keys). Authored Core
// methods stay rooted because Codegen resolves their implicit uses (`close`,
// `display`, index hooks, trait dispatch) by owner type rather than by a key
// in the caller's body. The closed precise-operation source registry
// (`ir_precise_source_target`) is rooted. A compiler-generated Core method
// (`FnBody.synthetic`: a Prelude/Derives.jet `Equatable`/`Comparable` body)
// is not a root: it is kept only when a kept body names it (sema rewrites
// `==`/`<` on its owner into a keyed method call). An unreached derive then
// loses its impl row, so no impl is emitted for a runtime-backed Core carrier
// (`Cursor` -> `JetCursor`, `URL`/`MIME` -> `jet_std`). A derived
// Encode/Decode body is the exception: sema checks it only on demand, and
// lowering finds it by owner type (ir_core_reach_generated_codec), so it is
// rooted.
//
// The bodies are read in waves on the threads `threads` admits
// (ir_core_reach_root_targets): first the roots' bodies, nearly every kept
// body, then the bodies of the rows the last wave reached first, until a
// wave reaches no new row. Reachability is a closure, so the flags are the
// same for any thread count. `functions` and `symbols` (the run's table, its
// one row, which names the methods and constants a body reaches) leave for
// the threads and come back unchanged. `decls` is the run's declaration
// table the direct calls name. A body that reads a constant whose landed
// value holds named functions (`held`, `f: double` in a folded record)
// reaches them, as it reaches a function it names as a value: the program
// makes each function value where it reads the constant (ir_comptime). In a
// traced compile the calling thread reports the rows read so far to
// `trace_sink` as `lower` progress, of the candidate rows: a candidate no
// kept body names is never read, so the count can end below the total.
ir_reachable_core_rows: fn(functions: &[FnBody], decls: DeclTable, symbols: &[SymbolTable], interners: &[Interner], candidates: &&[Bool], core_module_identities: [ModuleID], rooted_keys: NameTable, held: &&IRReachHeld, threads: CompilerThreads, trace_sink: CompilerTraceSink?) -> [Bool] {
    if core_module_identities.len() == 0 -> return candidates
    core_modules := [U32:Bool]{}
    loop identity in core_module_identities -> core_modules[identity.id] = true
    // Each candidate key's first row (a hashed map: only looked up).
    by_key := IRFunctionRows{keys: name_column_table(), rows: name_column()}
    reachable := [Bool]{}
    roots := [Int]{}
    weights := [Int]{}
    // Each row's source bytes, a wave's weight per row.
    sizes := [Int]{}
    // The Core source helpers a lowering calls by name, with no keyed call:
    // Fmt.jet selector helpers, Encoding.jet decode helpers and the Args.jet
    // `ArgsSpec` / `ParsedArgs` method helpers.
    source_keys := IRReachSources{names: name_table_sized(64), keys: [String]{""}}
    // A declaration's first candidate row by DeclID row (-1: none).
    decl_rows := (loop _ in 0..<decls.rows.len() -> -1)
    candidate_count := 0
    decl_workers: compiler_threads_admit(threads, functions.len(), functions.len(), 1024, 0, 0)
    if decl_workers <= 1 {
        loop (index, function) in functions {
            sizes.push(function.source_span.end - function.source_span.start)
            if !candidates[index] {
                reachable.push(false)
                next
            }
            candidate_count += 1
            name_column_set_first(by_key.keys, by_key.rows, function.key, index)
            if decl_table_find(decls, symbols[0], function.key) == .Val(id) {
                if decl_rows[id.row.index()] < 0 -> decl_rows[id.row.index()] = index
            }
            core: module_is_core(function.module_identity)
            if ir_string_format_source(core, function.source_file, function.kind) || ir_codec_decode_source(core, function.source_file, function.kind, function.name) || ir_args_source(core, function.source_file, function.kind, function.name) {
                ir_core_reach_source_set(source_keys, function.name, function.key)
            }
            rooted: !core_modules.has_key(function.module_identity.id) || ir_core_reach_has(rooted_keys, function.key) || (!ir_core_reach_is_top_level(function.kind) && !function.synthetic) || ir_core_reach_generated_codec(function) || ir_precise_source_target(function)
            reachable.push(rooted)
            if rooted {
                roots.push(index)
                weights.push(sizes[index])
            }
        }
    } else {
        decl_parts := [IRCoreReachDeclPart]{}
        task.group ir_core_reach_decl_init {
            decl_task: task ir_core_reach_decl_parts(functions, decls, symbols[0], candidates, decl_workers)
            loop (index, function) in functions {
                sizes.push(function.source_span.end - function.source_span.start)
                if !candidates[index] {
                    reachable.push(false)
                    next
                }
                candidate_count += 1
                name_column_set_first(by_key.keys, by_key.rows, function.key, index)
                core: module_is_core(function.module_identity)
                if ir_string_format_source(core, function.source_file, function.kind) || ir_codec_decode_source(core, function.source_file, function.kind, function.name) || ir_args_source(core, function.source_file, function.kind, function.name) {
                    ir_core_reach_source_set(source_keys, function.name, function.key)
                }
                rooted: !core_modules.has_key(function.module_identity.id) || ir_core_reach_has(rooted_keys, function.key) || (!ir_core_reach_is_top_level(function.kind) && !function.synthetic) || ir_core_reach_generated_codec(function) || ir_precise_source_target(function)
                reachable.push(rooted)
                if rooted {
                    roots.push(index)
                    weights.push(sizes[index])
                }
            }
            decl_parts = decl_task.join() ?? panic(compiler_threads_failure_text(err))
        }
        loop part in decl_parts {
            loop i in 0..<part.decl_indices.len() {
                d: part.decl_indices[i]
                if decl_rows[d] < 0 -> decl_rows[d] = part.fn_rows[i]
            }
        }
    }
    // Each function a held constant names, as its candidate row (-1: none).
    held_rows := [Int]{}
    loop key in held.functions {
        target := ir_function_rows_get(by_key, key)
        if target == None -> target = ir_function_rows_get(by_key, ir_core_reach_template_key(key))
        held_rows.push(target ?? -1)
    }
    slot: Shared{IRReachShared{functions: [[FnBody]]{compiler_take_rows<FnBody>(functions)}, symbols: compiler_take_rows<SymbolTable>(symbols), interners: compiler_take_rows<Interner>(interners), by_key: [IRFunctionRows]{by_key.move()}, source_keys: [IRReachSources]{source_keys.move()}, decl_rows: decl_rows.move(), held: [IRReachHeld]{held}, held_rows: held_rows.move()}}
    read := 0
    loop {
        reached := [Int]{}
        loop target in ir_core_reach_root_targets(slot, roots, weights, threads, IRReachProgress{read: read, total: candidate_count}, trace_sink) {
            if !reachable[target] {
                reachable[target] = true
                reached.push(target)
            }
        }
        read += roots.len()
        if reached.len() == 0 -> break
        weights = (loop row in reached -> sizes[row])
        roots = reached.move()
    }
    if trace_sink == .Val(sink) -> sink.progress("lower", read, candidate_count)
    permit: slot.guard_edit()
    back := permit.value.functions.pop() ?? panic("the checked functions left the reachability state")
    compiler_transfer_rows<FnBody>(functions, back)
    compiler_transfer_rows<SymbolTable>(symbols, permit.value.symbols)
    compiler_transfer_rows<Interner>(interners, permit.value.interners)
    reachable
}

IRCoreReachDeclPart: struct {
    decl_indices: [Int],
    fn_rows: [Int],
}

ir_core_reach_decl_range: fn(functions: [FnBody], decls: DeclTable, symbols: SymbolTable, candidates: [Bool], start: Int, end: Int) -> IRCoreReachDeclPart Never! {
    decl_indices := [Int]{}
    fn_rows := [Int]{}
    loop index in start..<end {
        if !candidates[index] -> next
        if decl_table_find(decls, symbols, functions[index].key) == .Val(id) {
            decl_indices.push(id.row.index())
            fn_rows.push(index)
        }
    }
    IRCoreReachDeclPart{decl_indices: decl_indices.move(), fn_rows: fn_rows.move()}
}

ir_core_reach_decl_threads: fn(functions: [FnBody], decls: DeclTable, symbols: SymbolTable, candidates: [Bool], starts: [Int], ends: [Int], at: Int) -> [IRCoreReachDeclPart] {
    if at >= starts.len() -> return [IRCoreReachDeclPart]{}
    if at + 1 == starts.len() {
        return [IRCoreReachDeclPart]{ir_core_reach_decl_range(functions, decls, symbols, candidates, starts[at], ends[at])}
    }
    out := [IRCoreReachDeclPart]{}
    task.group ir_core_reach_decl_group {
        head: task ir_core_reach_decl_range(functions, decls, symbols, candidates, starts[at], ends[at])
        rest := ir_core_reach_decl_threads(functions, decls, symbols, candidates, starts, ends, at + 1)
        out.push(head.join() ?? panic(compiler_threads_failure_text(err)))
        compiler_transfer_rows<IRCoreReachDeclPart>(out, rest)
    }
    out
}

ir_core_reach_decl_parts: fn(functions: [FnBody], decls: DeclTable, symbols: SymbolTable, candidates: [Bool], workers: Int) -> [IRCoreReachDeclPart] {
    count: functions.len()
    starts := [Int]{}
    ends := [Int]{}
    loop w in 0..<workers {
        s: (w * count) /% workers
        e: ((w + 1) * count) /% workers
        if s < e {
            starts.push(s)
            ends.push(e)
        }
    }
    ir_core_reach_decl_threads(functions, decls, symbols, candidates, starts, ends, 0)
}

// The Core source helpers a lowering calls by name (ir_reachable_core_rows):
// a helper name's id in `names` indexes its function key in `keys` (id 0,
// the empty name, holds "").
IRReachSources: struct {
    names: NameTable,
    keys: [String],
}

// Records `key` as the function key of source helper `name`; a later
// helper of the same name replaces it.
ir_core_reach_source_set: fn(sources: &IRReachSources, name: String, key: String) Never! {
    id: name_index(name_intern(sources.names, name))
    if id < sources.keys.len() {
        sources.keys[id] = key
        return
    }
    // copy: the checked function keeps its key; the table holds its own.
    sources.keys.push(key.copy())
}

// The function key of source helper `name`, if a candidate defines it.
ir_core_reach_source_key: fn(sources: IRReachSources, name: String) -> String? Never! {
    found: name_find(sources.names, name) ?? return None
    id: name_index(found)
    if id == 0 -> return None
    Val(sources.keys[id])
}

// Whether `table` holds `text` (id 0, the pre-interned empty name, is never
// held).
ir_core_reach_has: fn(table: NameTable, text: String) -> Bool Never! {
    found: name_find(table, text) ?? return false
    name_index(found) > 0
}

// The functions each landed constant's value names, by constant key
// (ir_reachable_core_rows): the constant `constants` interns as id `id`
// names the function keys `functions[starts[id - 1]..<ends[id - 1]]`.
IRReachHeld: struct {
    constants: NameTable{name_table_sized(2)},
    starts: [Int]{[Int]{}},
    ends: [Int]{[Int]{}},
    functions: [String]{[String]{}},
}

// Records that constant `key`'s landed value names the functions
// `functions` interns, but the empty name. A value that names none records
// nothing; a later record of the same constant replaces its functions.
ir_reach_held_add: fn(held: &IRReachHeld, key: String, functions: &&NameTable) Never! {
    if name_count(functions) <= 1 {
        return
    }
    id: name_index(name_intern(held.constants, key))
    if id == 0 {
        return
    }
    start: held.functions.len()
    loop text in functions.texts.move() {
        if text != "" -> held.functions.push(text)
    }
    if id > held.starts.len() {
        held.starts.push(start)
        held.ends.push(held.functions.len())
        return
    }
    held.starts[id - 1] = start
    held.ends[id - 1] = held.functions.len()
}

// The row of constant `key` in `held`'s starts and ends, -1 when its value
// names no function.
ir_reach_held_row: fn(held: IRReachHeld, key: String) -> Int Never! {
    found: name_find(held.constants, key) ?? return -1
    name_index(found) - 1
}

// What every reachability thread reads: the checked functions, the run's
// symbol table, their rows by key, the by-name source helpers' keys and the
// functions each constant's landed value holds, each the one row of its
// list, the function rows by DeclID row, and the candidate row of each
// held function (-1: none).
IRReachShared: struct {
    functions: [[FnBody]],
    symbols: [SymbolTable],
    interners: [Interner],
    by_key: [IRFunctionRows],
    source_keys: [IRReachSources],
    decl_rows: [Int],
    held: [IRReachHeld],
    held_rows: [Int],
}

// Where a wave stands in the trace's `lower` progress: the rows the waves
// before it read, of `total` candidate rows.
IRReachProgress: struct {
    read: Int,
    total: Int,
}

// The rows one part of a wave names: its number and the rows.
IRReachPart: struct {
    part: Int,
    targets: [Int],
}

// A wave's source bytes per admitted reachability thread.
IR_REACH_MIN_BYTES_PER_THREAD: 65536

// Parts per admitted reachability thread: a thread that drew light bodies
// claims more while another reads a heavy one.
IR_REACH_PARTS_PER_THREAD: 4

// The calling thread reports `lower` progress every this many rows of a
// wave; the trace throttles it further by time.
IR_REACH_PROGRESS_STRIDE: 64

// Every row the bodies of rows `rows` (one wave) name, read on the threads
// `threads` admits for their source bytes (`weights`, one per row), in
// consecutive parts each thread claims until none is left, joined in part
// order.
ir_core_reach_root_targets: fn(slot: Shared<IRReachShared>, rows: [Int], weights: [Int], threads: CompilerThreads, progress: IRReachProgress, trace_sink: CompilerTraceSink?) -> [Int] {
    total := 0
    loop weight in weights -> total += weight
    workers: compiler_threads_admit(threads, weights.len(), total, IR_REACH_MIN_BYTES_PER_THREAD, 0, 0)
    count := workers * IR_REACH_PARTS_PER_THREAD
    if count > weights.len() -> count = weights.len()
    if workers <= 1 || count <= 1 {
        return ir_core_reach_part_targets(slot, rows, 0, weights.len(), progress, trace_sink)
    }
    bounds: compiler_threads_partition(weights, count)
    queue: IRPartQueue{next: 0}
    parts := [[Int]]{}
    loop _ in 0..<count -> parts.push([Int]{})
    ir_core_reach_claimers(slot, rows, bounds, queue, 0, workers, parts, progress, trace_sink)
    targets := [Int]{}
    loop part in 0..<count -> targets.extend(compiler_take_rows<Int>(parts[part]))
    targets
}

// Runs claiming threads `from..<workers`, one task each and the last on this
// thread, the one that reports `lower` progress to `trace_sink`, and moves
// every part a thread returned into `parts`.
ir_core_reach_claimers: fn(slot: Shared<IRReachShared>, rows: [Int], bounds: [Int], queue: IRPartQueue, from: Int, workers: Int, parts: &[[Int]], progress: IRReachProgress, trace_sink: CompilerTraceSink?) {
    if from >= workers - 1 {
        own := ir_core_reach_claimed(slot, rows, bounds, queue, progress, trace_sink)
        ir_core_reach_place(own, parts)
        return
    }
    task.group core_reach_threads {
        head: task ir_core_reach_claimed(slot, rows, bounds, queue, progress, None)
        ir_core_reach_claimers(slot, rows, bounds, queue, from + 1, workers, parts, progress, trace_sink)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        ir_core_reach_place(claimed, parts)
    }
}

// Moves each claimed part's rows into its row of `parts`.
ir_core_reach_place: fn(claimed: &[IRReachPart], parts: &[[Int]]) {
    loop claimed.len() > 0 {
        done := claimed.pop() ?? break
        parts[done.part] = compiler_take_rows<Int>(done.targets)
    }
}

// One thread: the rows named by the parts it claims until none is left.
ir_core_reach_claimed: fn(slot: Shared<IRReachShared>, rows: [Int], bounds: [Int], queue: IRPartQueue, progress: IRReachProgress, trace_sink: CompilerTraceSink?) -> [IRReachPart] {
    claimed := [IRReachPart]{}
    loop {
        part: queue.next.add(1)
        if part >= bounds.len() - 1 -> break
        claimed.push(IRReachPart{part: part, targets: ir_core_reach_part_targets(slot, rows, bounds[part], bounds[part + 1], progress, trace_sink)})
    }
    claimed
}

// The rows that rows `rows[first..<last]` name, in row order. Given the
// trace sink, every IR_REACH_PROGRESS_STRIDE-th row reports the rows read
// so far: the waves' before this one and this one's up to the row.
ir_core_reach_part_targets: fn(slot: Shared<IRReachShared>, rows: [Int], first: Int, last: Int, progress: IRReachProgress, trace_sink: CompilerTraceSink?) -> [Int] {
    inputs: slot.guard_read()
    targets := [Int]{}
    loop position in first..<last {
        if position %% IR_REACH_PROGRESS_STRIDE == 0 {
            if trace_sink == .Val(sink) {
                sink.progress("lower", progress.read + position, progress.total)
            }
        }
        // Passed straight through: a local binding of the guarded rows would copy them.
        ir_core_reach_row_targets(inputs.value.interners[0], inputs.value.functions[0], inputs.value.symbols[0], inputs.value.by_key[0], inputs.value.source_keys[0], inputs.value.decl_rows, inputs.value.held[0], inputs.value.held_rows, rows[position], targets)
    }
    targets
}

// The rows checked function row `row` names (a direct call's by its
// DeclID row; others by key, or by their generic declaration's key), and
// the candidate rows (`held_rows`) of the functions held by each constant
// it reads (`held`), appended to `targets`.
ir_core_reach_row_targets: fn(interner: Interner, functions: [FnBody], symbols: SymbolTable, by_key: IRFunctionRows, source_keys: IRReachSources, decl_rows: [Int], held: IRReachHeld, held_rows: [Int], row: Int, targets: &[Int]) Never! {
    loop key in ir_core_reach_function_keys(interner, functions[row], functions, symbols, source_keys, decl_rows, targets) {
        target := ir_function_rows_get(by_key, key)
        if target == None -> target = ir_function_rows_get(by_key, ir_core_reach_template_key(key))
        if target == .Val(found) -> targets.push(found)
        constant: ir_reach_held_row(held, key)
        if constant < 0 -> next
        loop index in held.starts[constant]..<held.ends[constant] {
            if held_rows[index] >= 0 -> targets.push(held_rows[index])
        }
    }
}

#Test("Precise reachability roots the closed source registry at any Core path") {
    assert(ir_precise_source_name("abs"))
    assert(ir_precise_source_name("__fraction_new"))
    assert(ir_precise_source_name("__decimal_to_fraction"))
    assert(ir_precise_source_name("__complex_abs"))
    assert(!ir_precise_source_name("__decimal_normalized"))
    assert(!ir_precise_source_name("__fraction_"))
    assert(ir_core_source_path("Core/Math/Math.jet", "Core/Math/Math.jet"))
    assert(ir_core_source_path("/toolchain/Core/Math/Math.jet", "Core/Math/Math.jet"))
    assert(ir_core_source_path("<corelib>/Core/Text/Fmt.jet", "Core/Text/Fmt.jet"))
    assert(!ir_core_source_path("/toolchain/MyCore/text/fmt.jet", "Core/Text/Fmt.jet"))
}

#Test("A comptime closure finds the precise helper a nested literal lowers to") {
    span: Span{start: 0, end: 1}
    spelling: BodyNode{id: 0, kind: NodeKind.StrLit{parts: [BodyStrPart]{BodyStrPart.Literal{text: "9007199254740992.0"}}}, span: span}
    decimal: BodyNode{id: 1, kind: NodeKind.PreciseBuiltin{type_name: "Decimal", function: "from_str", args: [Int]{0}}, span: span}
    converted: BodyNode{id: 2, kind: NodeKind.PreciseBuiltin{type_name: "Decimal", function: "to_float", args: [Int]{1}}, span: span}
    tree: BodyTree{nodes: [BodyNode]{spelling, decimal, converted}, stmts: [StmtKind]{}, expr_types: [TExprType]{}}
    found: ir_precise_helper_names(interner_empty(), tree, [Int]{2}, [Int]{})
    assert_eq(found.names.len(), 2)
    assert(found.names.contains("__decimal_to_float"))
    assert(found.names.contains("__decimal_from_str"))
    assert_eq(found.roles.len(), 0)
}

#Test("A comptime closure finds the role a typed abs runs") {
    span: Span{start: 0, end: 1}
    value: BodyNode{id: 0, kind: NodeKind.FloatLit{value: 1.5}, span: span}
    absolute: BodyNode{id: 1, kind: NodeKind.MathBuiltin{type_name: "F32", function: "abs", args: [Int]{0}}, span: span}
    tree: BodyTree{nodes: [BodyNode]{value, absolute}, stmts: [StmtKind]{}, expr_types: [TExprType]{}}
    found: ir_precise_helper_names(interner_empty(), tree, [Int]{1}, [Int]{})
    assert_eq(found.roles, [String]{"AbsF32"})
}
