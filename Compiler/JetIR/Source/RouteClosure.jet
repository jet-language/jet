// Lower checked TClosureOp expressions through their canonical Prelude routes.
use jet_foundation.[
    Effect,
    MIRPreludeABI,
    TClosureOp,
    Type,
]

struct IRClosureRoute {
    module_name: String
    member: String
    symbol: String
    arity: Int
    borrow_mask: [Bool]
    effect_kind: Effect?
    abi: MIRPreludeABI
}

fn ir_closure_route_row(module_name: String, member: String, symbol: String, arity: Int, borrow_mask: [Bool], route_effect: Effect?, abi: MIRPreludeABI) -> IRClosureRoute Never! {
    IRClosureRoute{module_name: module_name, member: member, symbol: symbol, arity: arity, borrow_mask: borrow_mask, effect_kind: route_effect, abi: abi}
}

fn ir_closure_receiver_kind(receiver: Type) -> String? {
    if receiver == {
        .Tagged(_, inner) -> return ir_closure_receiver_kind(inner)
        .List(_) | .FixedList(_, _) -> return Val("list")
        .Option(_) -> return Val("option")
        .Map(_, _, _) -> return Val("map")
        .Apply(name, args) -> {
            if args.len() == 1 && (name == "Iter" || name == "ViewIter") -> return Val("iter")
            if args.len() == 1 && (name == "View" || name == "ViewMut" || name == "ComputeViewMut") -> return Val("view")
            if name == "Tally" -> return Val("bag")
            return None
        }
        else -> return None
    }
}

fn ir_collection_closure_route(operation: TClosureOp, receiver: Type) -> IRClosureRoute Never! {
    kind :: ir_closure_receiver_kind(receiver) ?? panic("checked closure operation has an unsupported receiver type")
    if operation == {
        .Map -> {
            // #4566 slice 5: the eager list map kernels borrow their source.
            if kind == "list" -> return ir_closure_route_row("core.list", "map", "jet_list_map", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return ir_closure_route_row("core.iter", "map", "jet_iter_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .MapMut -> {
            if kind == "list" -> return ir_closure_route_row("core.list", "map_mut", "jet_list_map_mut", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return ir_closure_route_row("core.iter", "map_mut", "jet_iter_map_mut", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .TryMap -> {
            if kind == "list" -> return ir_closure_route_row("core.list", "try_map", "jet_list_try_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return ir_closure_route_row("core.iter", "try_map", "jet_iter_try_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "view" -> return ir_closure_route_row("core.view", "try_map", "jet_view_try_map", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        }
        .Filter -> {
            if kind == "list" -> return ir_closure_route_row("core.list", "filter", "jet_list_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return ir_closure_route_row("core.iter", "filter", "jet_iter_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .FilterMap -> {
            if kind == "list" -> return ir_closure_route_row("core.list", "filter_map", "jet_list_filter_map_iter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return ir_closure_route_row("core.iter", "filter_map", "jet_iter_filter_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .TryFilter -> {
            if kind == "list" -> return ir_closure_route_row("core.list", "try_filter", "jet_list_try_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return ir_closure_route_row("core.iter", "try_filter", "jet_iter_try_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "view" -> return ir_closure_route_row("core.view", "try_filter", "jet_view_try_filter", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        }
        .Each | .EachMut -> {
            if kind == "list" || kind == "iter" {
                if operation == TClosureOp.Each -> return ir_closure_route_row("core.list", "each", "jet_list_each", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
                return ir_closure_route_row("core.list", "each_mut", "jet_list_each_mut", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            }
        }
        .Find -> {
            if kind == "list" || kind == "iter" -> return ir_closure_route_row("core.list", "find", "jet_list_find", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .Any -> {
            if kind == "list" || kind == "iter" -> return ir_closure_route_row("core.list", "any", "jet_list_any", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .All -> {
            if kind == "list" || kind == "iter" -> return ir_closure_route_row("core.list", "all", "jet_list_all", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .Reduce -> {
            if kind == "list" || kind == "iter" -> return ir_closure_route_row("core.list", "reduce", "jet_list_reduce", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        }
        .TakeWhile -> {
            if kind == "list" -> return ir_closure_route_row("core.list", "take_while", "jet_list_take_while_iter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return ir_closure_route_row("core.iter", "take_while", "jet_iter_take_while", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .SkipWhile -> {
            if kind == "list" -> return ir_closure_route_row("core.list", "skip_while", "jet_list_skip_while_iter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return ir_closure_route_row("core.iter", "skip_while", "jet_iter_skip_while", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .FlatMap -> {
            if kind == "list" -> return ir_closure_route_row("core.list", "flat_map", "jet_list_flat_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return ir_closure_route_row("core.iter", "flat_map", "jet_iter_flat_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .Position -> {
            if kind == "list" || kind == "iter" -> return ir_closure_route_row("core.list", "position", "jet_list_position", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .MinBy -> {
            if kind == "list" || kind == "iter" -> return ir_closure_route_row("core.list", "min_by", "jet_list_min_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .MaxBy -> {
            if kind == "list" || kind == "iter" -> return ir_closure_route_row("core.list", "max_by", "jet_list_max_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .GroupBy -> {
            if kind == "list" || kind == "iter" -> return ir_closure_route_row("core.list", "group_by", "jet_list_group_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .CountBy -> {
            if kind == "list" || kind == "iter" -> return ir_closure_route_row("core.list", "count_by", "jet_list_count_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        }
        .Scan -> {
            if kind == "list" -> return ir_closure_route_row("core.list", "scan", "jet_list_scan_iter", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
            if kind == "iter" -> return ir_closure_route_row("core.iter", "scan", "jet_iter_scan", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        }
        .OptionMap -> {
            if kind == "option" -> return ir_closure_route_row("core.option", "map", "jet_option_map_ref", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        }
        .BagAny -> {
            if kind == "bag" -> return ir_closure_route_row("core.bag", "any", "jet_bag_any", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        }
        else -> {}
    }
    panic("checked closure operation has no canonical Prelude route for its receiver")
}

fn ir_closure_route(operation: TClosureOp, receiver: Type) -> IRClosureRoute Never! {
    if operation == {
        .EditDisjoint -> return ir_closure_route_row("core.collections", "edit_disjoint", "jet_edit_disjoint", 3, [Bool]{true, true, false}, None, MIRPreludeABI.Value)
        .EachMap -> return ir_closure_route_row("core.map", "each", "jet_map_each", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .MapAny -> return ir_closure_route_row("core.map", "any", "jet_map_any", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .MapAll -> return ir_closure_route_row("core.map", "all", "jet_map_all", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .MapFilter -> return ir_closure_route_row("core.map", "filter", "jet_map_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .MapMap -> return ir_closure_route_row("core.map", "map", "jet_map_map_values", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .MapFold -> return ir_closure_route_row("core.map", "fold", "jet_map_fold", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        .MapFlatMap -> return ir_closure_route_row("core.map", "flat_map", "jet_map_flat_map", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .ListBinarySearchBy -> return ir_closure_route_row("core.list", "binary_search_by", "jet_list_binary_search_by", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .ListMinMaxBy -> return ir_closure_route_row("core.list", "min_max_by", "jet_list_min_max_by", 2, [Bool]{true, false}, None, MIRPreludeABI.Aggregate)
        .CountWhere -> return ir_closure_route_row("core.list", "count_where", "jet_list_count_where", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .SortBy -> return ir_closure_route_row("core.list", "sort_by", "jet_list_sort_by", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .SortByDesc -> return ir_closure_route_row("core.list", "sort_by_desc", "jet_list_sort_by_desc", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .TrySortBy -> return ir_closure_route_row("core.list", "try_sort_by", "jet_list_try_sort_by", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .TrySortByDesc -> return ir_closure_route_row("core.list", "try_sort_by_desc", "jet_list_try_sort_by_desc", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .SortByCompare -> return ir_closure_route_row("core.list", "sort_by_compare", "jet_list_sort_by_compare", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .ParaMap -> return ir_closure_route_row("core.list", "para_map", "jet_list_para_map", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        .ParaFilter -> return ir_closure_route_row("core.list", "para_filter", "jet_list_para_filter", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .ParaPartition -> return ir_closure_route_row("core.list", "para_partition", "jet_list_para_partition", 2, [Bool]{false, false}, None, MIRPreludeABI.Aggregate)
        .ParaFold -> return ir_closure_route_row("core.list", "para_fold", "jet_list_para_fold", 4, [Bool]{false, false, false, false}, None, MIRPreludeABI.Value)
        .DedupBy -> return ir_closure_route_row("core.iter", "dedup_by", "jet_iter_dedup_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .IsSortedBy -> return ir_closure_route_row("core.iter", "is_sorted_by", "jet_iter_is_sorted_by", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .ChunkWhile -> return ir_closure_route_row("core.iter", "chunk_while", "jet_iter_chunk_while", 2, [Bool]{false, false}, None, MIRPreludeABI.Value)
        .Fold -> return ir_closure_route_row("core.list", "fold", "jet_list_fold", 3, [Bool]{false, false, false}, None, MIRPreludeABI.Value)
        .ViewFold -> return ir_closure_route_row("core.view", "fold", "jet_view_fold", 3, [Bool]{true, false, false}, None, MIRPreludeABI.Value)
        .ViewMap -> return ir_closure_route_row("core.view", "map", "jet_view_map", 2, [Bool]{true, false}, None, MIRPreludeABI.Value)
        .UpdateFirst -> return ir_closure_route_row("core.list", "update_first", "jet_list_update_first", 3, [Bool]{true, false, false}, Val(Effect.Mem), MIRPreludeABI.Value)
        .Partition -> return ir_closure_route_row("core.list", "partition", "jet_list_partition", 2, [Bool]{false, false}, None, MIRPreludeABI.Aggregate)
        .Map | .MapMut | .TryMap | .Filter | .TryFilter | .Each | .EachMut | .Find | .Any | .BagAny | .All | .Reduce | .TakeWhile | .SkipWhile | .FlatMap | .Position | .MinBy | .MaxBy | .GroupBy | .CountBy | .FilterMap | .Scan | .OptionMap -> return ir_collection_closure_route(operation, receiver)
        else -> panic("checked TClosureOp has no canonical Prelude route")
    }
}
