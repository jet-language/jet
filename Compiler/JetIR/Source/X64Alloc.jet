// Slot homes and linear-scan register allocation for x86-64 selection.
//
// Every slot that holds a value has one place for the whole function: a
// register for the whole of its live range, or its frame home. A General
// slot's register is callee-saved (rbx, r12-r15), or r8 or r9 (which no
// one has to save) for a slot whose range holds no instruction that may
// call (ir_x64_silent), which it takes first; in a leaf (a function whose
// selection makes no call, ir_x64_leaf) every slot's range is such a one.
// A Float slot's is one of xmm2-xmm15, which the C
// ABI lets a call clobber, so around every call inside its range the slot
// is stored to its home and loaded back (X64Select.jet ir_x64_call_out),
// except a stop poll's, which keeps them. Selection then uses rax, rcx,
// rdx, rsi, rdi, r8-r11, xmm0 and xmm1 as scratch inside one instruction
// only (r8 and r9 only for a call's arguments, and xmm0-xmm7 for the Float
// arguments of a call), and structured control never needs moves on its
// edges.
//
// A slot's live range is the span of instruction indexes that reference it
// (parameters start at -1, before the first instruction). Because control is
// structured, the span is exact up to loops: a range that overlaps a Loop but
// does not lie inside it, or whose first reference inside the loop reads the
// slot, is live around the back edge and grows to cover the whole loop. The
// scan takes ranges by start; when no register is free the range with the
// least spill weight (ir_x64_lighter; its references, each weighing
// IR_X64_LOOP_WEIGHT per enclosing loop up to three, but in an If arm that
// leaves the function only per loop inside that arm) lives in its frame
// home, the one that ends last among equals. A register weighs its owner's
// weight plus that of the copies riding on it (ir_x64_aliases), which lose
// it with the owner: a light value never takes a hot copy down with it.
// An evicted owner goes home over all of its range, so afterwards each
// range left in its home, heaviest first, takes a register that no range
// holds anywhere over it (ir_x64_fill_homes).
// A value a hot Loop shares with the code around it has a slot of its own
// in the Loop at O2 (OptSplit.jet), so the Loop's range alone competes.
//
// Frame: `push rbp; mov rbp, rsp`, the used callee-saved registers, then
// `sub rsp` for the frame homes, StackAddress storage and the result storage
// of calls that return an aggregate, rounded so rsp stays 16-byte aligned
// at every call.

use jet_foundation.[Type, compiler_threads_single, name_rows_set]

// Callee-saved registers handed to General slots, in preference order.
IR_X64_SLOT_REGISTERS: [Int]{3, 12, 13, 14, 15}
// A leaf's: r8 and r9 first, then the callee-saved ones.
IR_X64_LEAF_REGISTERS: [Int]{8, 9, 3, 12, 13, 14, 15}
// Any other function's: the callee-saved ones, then r8 and r9 for a slot
// whose range holds no instruction that may call (ir_x64_silent).
IR_X64_QUIET_REGISTERS: [Int]{3, 12, 13, 14, 15, 8, 9}
// The xmm registers handed to Float slots, in preference order. From row
// IR_X64_XMM_OPEN on, those a call's third to eighth Float arguments fill:
// only for a Float slot other than a parameter (whose own arrives in one of
// them) and whose range holds no call passing more than two Floats.
IR_X64_XMM_REGISTERS: [Int]{8, 9, 10, 11, 12, 13, 14, 15, 2, 3, 4, 5, 6, 7}
IR_X64_XMM_OPEN: 8
IR_X64_LOOP_WEIGHT: 16

// How a slot's value is held.
IRX64Class: enum {
    // Unit: nothing is stored.
    Empty
    // A word in a general register or an 8-byte home (Bool, Int, fixed-width
    // integers, Char, String, raw and owned pointers, and an aggregate's
    // pointer to its bytes).
    General
    // Float bits in an xmm register (a Float32 in its low half) or an 8-byte
    // home (a Float32 zero-extended).
    Float
}

// The layout facts selection reads of a type row: scalars only, so a copy
// never copies the checked type.
IRX64Shape: struct {
    kind: IRTypeKind
    size: Int
    align: Int
    signed: Bool
    bits: Int
}

ir_x64_shape: fn(ty: IRType) -> IRX64Shape Never! {
    IRX64Shape{kind: ty.kind, size: ty.size, align: ty.align, signed: ty.signed, bits: ty.bits}
}

ir_x64_class: fn(ty: IRX64Shape) -> IRX64Class Never! {
    if ty.kind == {
        .Unit -> IRX64Class.Empty
        .Float | .Float32 -> IRX64Class.Float
        .Bool | .Int | .Word | .Char | .String | .Pointer | .Aggregate -> IRX64Class.General
    }
}

ir_x64_row_class: fn(m: IRModule, row: Int) -> IRX64Class Never! {
    ir_x64_class(ir_x64_shape(m.types[row]))
}

IRX64Allocation: struct {
    // Per slot: the register holding it (callee-saved, or r8 or r9 in a
    // leaf), -1 for none.
    regs: [Int]
    // Per slot: the xmm register holding a Float slot, -1 for none; and the
    // slots holding one, in slot order.
    xmms: [Int]
    xmm_slots: [Int]
    // Per slot: the rbp displacement of its frame home (0 for a slot in a
    // callee-saved register, a constant slot, a frame address or a Unit slot).
    homes: [Int]
    // Per slot: whether it is a constant (a General temporary whose only
    // write is a Const): it has no place, every read is its immediate
    // `values[slot]` and its Const emits nothing.
    consts: [Bool]
    values: [Int]
    // Per slot: the rbp displacement of the storage a frame address (a
    // General temporary whose only write is a StackAddress, or a temporary
    // or local whose only write is a copy, move or in-bounds Offset of a
    // frame address, as a local aggregate variable's) points at, 0 for any
    // other slot: it has no place, its write emits nothing, a Load, Store,
    // Offset or CopyBytes through it addresses rbp directly and any other
    // read is a `lea`. A named one is its variable's FrameAddress for the
    // debugger (X64Select.jet ir_x64_variables).
    frames: [Int]
    // Per slot: the first and last instruction index of its live range
    // (-1 for a parameter's start); start > end when it is never referenced.
    starts: [Int]
    ends: [Int]
    // Per instruction: the rbp displacement of a StackAddress's storage or
    // of an aggregate-returning call's result storage (0 for none).
    stack: [Int]
    // The callee-saved registers the slots use, in push order.
    saved: [Int]
    // Bytes `sub rsp` reserves below the saved registers.
    frame_bytes: Int
    // rbp displacement of the hidden result pointer of a function that
    // returns an aggregate, 0 for none.
    result_home: Int
    // The slot whose StackAddress storage is the caller's result storage
    // (ir_x64_result_storage), -1 for none: its StackAddress loads the
    // hidden result pointer and a Return of it copies nothing.
    result_storage: Int
}

// Which operands of an instruction are slots it reads: none; `a`; `a` and
// `b`; the `c` call arguments from `b`; `a` and those arguments; `a` and
// `c`; `a` when it is a slot (a Return's value).
IR_X64_READS_NONE: 0
IR_X64_READS_A: 1
IR_X64_READS_AB: 2
IR_X64_READS_ARGS: 3
IR_X64_READS_A_ARGS: 4
IR_X64_READS_AC: 5
IR_X64_READS_RESULT: 6

ir_x64_read_form: fn(op: IROp) -> Int Never! {
    if op == {
        .Copy | .Move | .Drop | .Close | .Neg | .Not | .Sqrt | .IntBig | .Convert | .Load | .Offset | .If | .BrIf -> IR_X64_READS_A
        .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Concat | .CopyBytes -> IR_X64_READS_AB
        .Call | .CallRuntime -> IR_X64_READS_ARGS
        .CallIndirect -> IR_X64_READS_A_ARGS
        .Store | .StreamStore -> IR_X64_READS_AC
        .Return -> IR_X64_READS_RESULT
        .Nop | .Const | .ConstText | .ConstBigInt | .FunctionAddress | .DataAddress | .StackAddress | .Block | .Loop | .Else | .End | .Br | .Unreachable -> IR_X64_READS_NONE
    }
}

// The slots instruction `at` reads, into `reads` (cleared first), in
// operand order.
ir_x64_reads_into: fn(f: IRFunction, at: Int, reads: &[Int]) Never! {
    reads.clear()
    form: ir_x64_read_form(f.op[at])
    if form == IR_X64_READS_NONE -> return
    a: f.a[at]
    if form != IR_X64_READS_ARGS && (form != IR_X64_READS_RESULT || a >= 0) -> reads.push(a)
    if form == IR_X64_READS_AB -> reads.push(f.b[at])
    if form == IR_X64_READS_AC -> reads.push(f.c[at])
    if form == IR_X64_READS_ARGS || form == IR_X64_READS_A_ARGS {
        b: f.b[at]
        loop index in b..<(b + f.c[at]) -> reads.push(f.args[index])
    }
}

// The slot instruction `at` writes, or -1.
ir_x64_write: fn(f: IRFunction, at: Int) -> Int Never! {
    if f.op[at] == {
        .Drop | .Close | .Store | .StreamStore | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Nop -> -1
        .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .StackAddress | .Offset | .Sqrt | .IntBig -> f.dst[at]
    }
}

// Whether value instruction `at` selects with no call and no slow path, in
// rax, rcx, r10 and r11 (and rdx for an unsigned 64-bit Mul) at most: a
// plain move (no clone, which calls: X64Select.jet ir_x64_transfer); a
// word's (or a wrapping Int's) comparison, bitwise operation, wrapping Add,
// Sub, Mul or negation, `not`, or shift by a wrapping or constant in-range
// count; a Float's + - * /, comparison or negation; a Bool's `not`; an
// address; or the inline jet_rt_block_unique (X64Select.jet
// ir_x64_block_unique). Division, a checked shift and Int arithmetic may
// stop; a Float `%` or floor division calls. `consts` and `values` are the
// allocation's (IRX64Allocation).
ir_x64_quiet: fn(m: IRModule, f: IRFunction, consts: [Bool], values: [Int], at: Int) -> Bool Never! {
    op: f.op[at]
    if op == .ConstText || op == .DataAddress || op == .FunctionAddress -> return true
    if op == .CallRuntime -> return ir_x64_inline_unique(m, f, at)
    // The rest read slot `a`; any other instruction is no quiet value.
    reads_slot: if op == {
        .Copy | .Move | .Add | .Sub | .Mul | .Div | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not -> true
        .Nop | .Const | .ConstText | .ConstBigInt | .Drop | .Close | .Rem | .FloorDiv | .Mod | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> false
    }
    if !reads_slot || f.a[at] < 0 -> return false
    row: m.types[f.slot_type[f.a[at]]]
    if op == .Copy || op == .Move -> return op == .Move || row.drop == "" || row.kind == .Aggregate || ir_clone_shares(row.clone)
    kind: row.kind
    wrap: f.c[at] == IR_OVERFLOW_WRAP
    float: kind == .Float || kind == .Float32
    word: kind == .Word || kind == .Bool || kind == .Char || kind == .Pointer || (kind == .Int && wrap)
    if op == {
        .Eq | .Ne | .Lt | .Le | .Gt | .Ge -> float || word
        .Add | .Sub | .Mul -> float || (word && wrap)
        .Div -> float
        .BitAnd | .BitOr | .BitXor -> word
        .Shl | .Shr -> {
            if kind != .Word && !(kind == .Int && wrap) -> return false
            if wrap -> return true
            count: f.b[at]
            bits: if kind == .Word -> row.bits else -> 64
            count >= 0 && consts[count] && values[count] >= 0 && values[count] < bits
        }
        .Neg -> float || (kind == .Word && wrap)
        .Not -> kind == .Bool || kind == .Word
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Rem | .FloorDiv | .Mod | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> false
    }
}

// Whether `at` calls jet_rt_block_unique, which is selected inline
// (X64Select.jet ir_x64_block_unique).
ir_x64_inline_unique: fn(m: IRModule, f: IRFunction, at: Int) -> Bool Never! {
    f.op[at] == .CallRuntime && f.c[at] == 1 && f.dst[at] >= 0 && f.a[at] >= 0 && f.a[at] < m.names.len() && m.names[f.a[at]] == "jet_rt_block_unique"
}

// Whether selecting instruction `at` makes no call, in its body or in a
// slow path, and leaves r8 and r9 alone: structure, a constant, a memory
// access, a frame address or byte copy, or a quiet value (ir_x64_quiet).
ir_x64_silent: fn(m: IRModule, f: IRFunction, consts: [Bool], values: [Int], at: Int) -> Bool Never! {
    if f.op[at] == {
        .Nop | .Const | .Load | .Store | .StreamStore | .Offset | .StackAddress | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Unreachable -> true
        .Return -> f.b[at] != IR_TAIL_JUMP
        .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Sqrt | .IntBig -> ir_x64_quiet(m, f, consts, values, at)
    }
}

// Per slot: whether it is a `general` slot other than a parameter whose
// range (`starts`..`ends`) holds only silent instructions (ir_x64_silent),
// so r8 and r9 may hold it.
ir_x64_silent_slots: fn(m: IRModule, f: IRFunction, consts: [Bool], values: [Int], general: [Bool], starts: [Int], ends: [Int]) -> [Bool] Never! {
    // Per instruction, how many before it may call.
    noisy := [Int]{0}
    loop at in 0..<f.op.len() -> noisy.push(noisy[at] + (if ir_x64_silent(m, f, consts, values, at) -> 0 else -> 1))
    loop slot in 0..<starts.len() -> general[slot] && slot >= f.param_count && starts[slot] >= 0 && noisy[ends[slot] + 1] == noisy[starts[slot]]
}

// Whether selecting `f` makes no call, in its body or in a slow path, so
// its General slots may live in r8 and r9: every instruction is silent
// (ir_x64_silent), and its General arguments (an aggregate result's hidden
// pointer first) are at most four, in rdi, rsi, rdx and rcx.
ir_x64_leaf: fn(m: IRModule, f: IRFunction, classes: [IRX64Class], consts: [Bool], values: [Int]) -> Bool Never! {
    general := if f.result >= 0 && m.types[f.result].kind == .Aggregate -> 1 else -> 0
    loop slot in 0..<f.param_count {
        if classes[slot] == .General -> general += 1
    }
    if general > 4 -> return false
    loop at in 0..<f.op.len() {
        if !ir_x64_silent(m, f, consts, values, at) -> return false
    }
    true
}

ir_x64_align: fn(value: Int, align: Int) -> Int Never! {
    if align <= 1 || value % align == 0 -> return value
    value + align - value % align
}

// Grows `slot`'s range to the whole loop `head`..`tail` when the range is
// live around its back edge: it overlaps the loop without lying inside it,
// or lies inside but its first reference reads it. Whether it changed.
ir_x64_grow_range: fn(starts: &[Int], ends: &[Int], slot: Int, head: Int, tail: Int, first_write: Bool) -> Bool Never! {
    if ends[slot] < head || starts[slot] > tail -> return false
    if starts[slot] > head && ends[slot] <= tail && first_write -> return false
    changed := false
    if starts[slot] > head {
        starts[slot] = head
        changed = true
    }
    if ends[slot] < tail {
        ends[slot] = tail
        changed = true
    }
    changed
}

// For an arm `lo`..=`hi` of the If at `head` that never goes on past the
// If's End (its last instruction is a Return, an Unreachable or a Br, and
// no Br inside goes to that End), so runs at most once per pass of the
// loops around the places it leaves to: the base each instruction in it
// counts its loops from is the If's loop depth less the most loops around
// such a place (the deepest such arm's). `around` holds per instruction the
// innermost Block, Loop or If around it.
ir_x64_one_shot: fn(f: IRFunction, depths: [Int], around: [Int], bases: &[Int], head: Int, lo: Int, hi: Int) Never! {
    if hi < lo -> return
    last := hi
    loop last >= lo && f.op[last] == .Nop {
        last -= 1
    }
    if last < lo || (f.op[last] != .Return && f.op[last] != .Unreachable && f.op[last] != .Br) -> return
    // The most loops around a place the arm leaves to.
    outer := 0
    loop at in lo..<(hi + 1) {
        op: f.op[at]
        if op != .Br && op != .BrIf -> next
        hops: if op == .Br -> f.a[at] else -> f.b[at]
        place := around[at]
        loop _ in 0..<hops {
            if place >= 0 -> place = around[place]
        }
        if place >= head {
            // A branch to the If's End goes on past it.
            if place == head -> return
            next
        }
        // Past a Block's or an If's End the loops around it go on; a Loop
        // runs its body again.
        loops: if place < 0 -> 0 else if f.op[place] == .Loop -> depths[place] + 1 else -> depths[place]
        if loops > outer -> outer = loops
    }
    base: depths[head] - outer
    loop at in lo..<(hi + 1) {
        if bases[at] < base -> bases[at] = base
    }
}

// The frame homes of the slots `homed` marks, as rbp displacements below
// the `below` bytes the saved registers take (0 for every other slot). A
// temporary shares a home with the others whose ranges (`starts`..`ends`,
// loop-grown) lie wholly apart from its own, taken in order of first use; a
// `named` slot keeps its home to itself, the place its variable lives over
// the whole body (ir_x64_variables). The homes the most references (`refs`)
// go through sit nearest rbp, where a displacement takes one byte (down to
// rbp - 128) instead of four; ties keep first-use order.
ir_x64_homes: fn(starts: [Int], ends: [Int], refs: [Int], homed: [Bool], named: [Bool], below: Int) -> [Int] Never! {
    count: starts.len()
    firsts := [Int]{}
    loop slot in 0..<count {
        if homed[slot] -> firsts.push((starts[slot] + 1) * count + slot)
    }
    firsts.sort()
    // Per slot its home's index (-1 none); per home the references through
    // it, the end of its last range, and whether a named slot keeps it.
    home_of := loop _ in 0..<count -> -1
    home_refs := [Int]{}
    home_ends := [Int]{}
    home_kept := [Bool]{}
    loop key in firsts {
        slot: key % count
        home := -1
        if !named[slot] {
            loop index in 0..<home_ends.len() {
                if !home_kept[index] && home_ends[index] < starts[slot] {
                    home = index
                    break
                }
            }
        }
        if home < 0 {
            home = home_ends.len()
            home_refs.push(0)
            home_ends.push(0)
            home_kept.push(named[slot])
        }
        home_of[slot] = home
        home_refs[home] = home_refs[home] + refs[slot]
        home_ends[home] = ends[slot]
    }
    total: home_refs.len()
    bound := 1
    loop n in home_refs -> bound += n
    order := [Int]{}
    loop home in 0..<total -> order.push((bound - home_refs[home]) * total + home)
    order.sort()
    offsets := loop _ in 0..<total -> 0
    loop (nth, key) in order -> offsets[key % total] = 0 - below - 8 * (nth + 1)
    loop slot in 0..<count -> if home_of[slot] >= 0 -> offsets[home_of[slot]] else -> 0
}

// Five slots over two saved registers (16 bytes): 1 follows 0 and 4
// follows 1 in one home; 3 overlaps 1, and 2 is named, so each has its own.
// Most references first: 3's home (10), 2's (5), then the shared one (3);
// 5 has no home.
#Test("Temporaries whose ranges lie apart share a home, the busiest nearest rbp") {
    starts: [Int]{0, 3, 1, 4, 7, 0}
    ends: [Int]{2, 5, 6, 9, 8, 9}
    refs: [Int]{1, 1, 5, 10, 1, 4}
    homed: [Bool]{true, true, true, true, true, false}
    named: [Bool]{false, false, true, false, false, false}
    homes: ir_x64_homes(starts, ends, refs, homed, named, 16)
    assert_eq(homes[0], -40)
    assert_eq(homes[1], -40)
    assert_eq(homes[2], -32)
    assert_eq(homes[3], -24)
    assert_eq(homes[4], -40)
    assert_eq(homes[5], 0)
}

ir_x64_allocate: fn(m: IRModule, f: IRFunction) -> IRX64Allocation Never! {
    count: f.slot_type.len()
    starts := [Int]{}
    ends := [Int]{}
    // Whether the slot's first reference (in index order) writes it.
    first_writes := [Bool]{}
    loop slot in 0..<count {
        if slot < f.param_count {
            starts.push(-1)
            ends.push(-1)
            first_writes.push(true)
        } else {
            starts.push(f.op.len())
            ends.push(-1)
            first_writes.push(false)
        }
    }
    // Loop depth per instruction (a Loop's body and its End are inside it),
    // and each reference's spill weight: by the loops around it, but in an
    // If arm that never goes on past its If (ir_x64_one_shot) only by those
    // inside it and around the places it leaves to.
    nesting := [Int]{}
    loop _ in 0..<(f.op.len() + 1) -> nesting.push(0)
    loop at in 0..<f.op.len() {
        if f.op[at] == .Loop && f.a[at] > at && f.a[at] < f.op.len() {
            nesting[at + 1] = nesting[at + 1] + 1
            nesting[f.a[at] + 1] = nesting[f.a[at] + 1] - 1
        }
    }
    depths := [Int]{}
    depth_now := 0
    loop at in 0..<f.op.len() {
        depth_now += nesting[at]
        depths.push(depth_now)
    }
    around := [Int]{}
    openers := [Int]{}
    loop at in 0..<f.op.len() {
        op: f.op[at]
        if op == .End -> _ := openers.pop()
        around.push(if openers.len() > 0 -> openers[openers.len() - 1] else -> -1)
        if op == .Block || op == .Loop || op == .If -> openers.push(at)
    }
    bases := loop _ in 0..<f.op.len() -> 0
    loop at in 0..<f.op.len() {
        if f.op[at] != .If || f.c[at] <= at || f.c[at] >= f.op.len() -> next
        middle: if f.b[at] > at && f.b[at] < f.c[at] -> f.b[at] else -> f.c[at]
        ir_x64_one_shot(f, depths, around, bases, at, at + 1, middle - 1)
        if middle < f.c[at] -> ir_x64_one_shot(f, depths, around, bases, at, middle + 1, f.c[at] - 1)
    }
    weight_at := [Int]{}
    loop at in 0..<f.op.len() {
        hot: depths[at] - bases[at]
        weight_at.push(if hot <= 0 -> 1 else if hot == 1 -> IR_X64_LOOP_WEIGHT else if hot == 2 -> IR_X64_LOOP_WEIGHT * IR_X64_LOOP_WEIGHT else -> IR_X64_LOOP_WEIGHT * IR_X64_LOOP_WEIGHT * IR_X64_LOOP_WEIGHT)
    }
    reads := [Int]{}
    writes := [Int]{}
    last_write := [Int]{}
    weights := [Int]{}
    // References per slot, as the code reads them: a frame home's count of
    // rbp displacements (homes below).
    refs := [Int]{}
    // Per instruction, whether it reads its first operand field `a` as a
    // slot (ir_x64_scan's partners).
    left_reads := [Bool]{}
    loop _ in 0..<count {
        writes.push(0)
        last_write.push(-1)
        weights.push(0)
        refs.push(0)
    }
    loop at in 0..<f.op.len() {
        ir_x64_reads_into(f, at, reads)
        left := false
        loop slot in reads {
            if slot < 0 || slot >= count -> next
            if slot == f.a[at] -> left = true
            if at < starts[slot] {
                starts[slot] = at
                first_writes[slot] = false
            }
            if at > ends[slot] -> ends[slot] = at
            weights[slot] = weights[slot] + weight_at[at]
            refs[slot] = refs[slot] + 1
        }
        written: ir_x64_write(f, at)
        if written >= 0 && written < count {
            if at < starts[written] {
                starts[written] = at
                first_writes[written] = true
            }
            if at > ends[written] -> ends[written] = at
            writes[written] = writes[written] + 1
            weights[written] = weights[written] + weight_at[at]
            refs[written] = refs[written] + 1
            last_write[written] = at
        }
        left_reads.push(left)
    }
    classes: loop slot in 0..<count -> ir_x64_row_class(m, f.slot_type[slot])
    consts := [Bool]{}
    values := [Int]{}
    addressed := [Bool]{}
    loop slot in 0..<count {
        at: last_write[slot]
        constant: slot >= f.param_count && f.slot_kind[slot] == .Temp && writes[slot] == 1 && f.op[at] == .Const && classes[slot] == .General
        consts.push(constant)
        values.push(if constant -> f.a[at] else -> 0)
        addressed.push(slot >= f.param_count && f.slot_kind[slot] == .Temp && writes[slot] == 1 && f.op[at] == .StackAddress && classes[slot] == .General)
    }
    result_storage: ir_x64_result_storage(m, f, last_write, writes)
    // It holds the hidden pointer, so no address derives from rbp.
    if result_storage >= 0 -> addressed[result_storage] = false
    // Frame addresses derived from one: per slot the StackAddress slot it
    // points into (-1: none) and how far. Each derived slot is written once,
    // so it holds that address wherever it is read.
    roots := [Int]{}
    shifts := [Int]{}
    loop slot in 0..<count {
        roots.push(if addressed[slot] -> slot else -> -1)
        shifts.push(0)
    }
    derived := true
    loop derived {
        derived = false
        loop slot in 0..<count {
            at: last_write[slot]
            if roots[slot] >= 0 || at < 0 || slot < f.param_count || writes[slot] != 1 || classes[slot] != .General -> next
            op: f.op[at]
            if op != .Copy && op != .Move && op != .Offset -> next
            source: f.a[at]
            if source < 0 || source >= count || roots[source] < 0 -> next
            // A Copy that clones (ir_x64_transfer) makes a value of its own.
            row: m.types[f.slot_type[source]]
            if op == .Copy && row.drop != "" && row.kind != .Aggregate -> next
            root: roots[source]
            shift: shifts[source] + (if op == .Offset -> f.b[at] else -> 0)
            // Only inside the storage: a displacement of 0 would be no frame.
            if shift < 0 || shift >= ir_x64_storage_size(f, last_write[root]) -> next
            roots[slot] = root
            shifts[slot] = shift
            addressed[slot] = true
            derived = true
        }
    }
    // Loops, as (start, end) instruction pairs, and their nest: per
    // instruction the innermost loop holding it (in its body or as its End;
    // a Loop instruction itself sits in the enclosing loop) and the loop it
    // heads, per loop the loop holding it.
    loop_starts := [Int]{}
    loop_ends := [Int]{}
    loop at in 0..<f.op.len() {
        if f.op[at] == .Loop {
            loop_starts.push(at)
            loop_ends.push(f.a[at])
        }
    }
    inner := [Int]{}
    heads := [Int]{}
    parents := [Int]{}
    open := [Int]{}
    nested := true
    loop at in 0..<f.op.len() {
        loop open.len() > 0 && loop_ends[open[open.len() - 1]] < at {
            _ := open.pop()
        }
        holder: if open.len() > 0 -> open[open.len() - 1] else -> -1
        inner.push(holder)
        if f.op[at] == .Loop {
            row: parents.len()
            heads.push(row)
            parents.push(holder)
            if loop_ends[row] <= at || loop_ends[row] >= f.op.len() || (holder >= 0 && loop_ends[row] > loop_ends[holder]) -> nested = false
            open.push(row)
        } else {
            heads.push(-1)
        }
    }
    // Grow every range that is live around a back edge to its whole loop,
    // until no range changes. Growing is monotone, so every order of trying
    // the loops reaches the same ranges. Only a loop holding the range's
    // start in its body, or its end in its body or at its head, can change
    // it: with nested loops each range walks just those two chains of
    // enclosing loops; otherwise it tries every loop.
    loop slot in 0..<count {
        if starts[slot] > ends[slot] || ends[slot] < 0 -> next
        changed := true
        loop changed {
            changed = false
            if nested {
                row := if starts[slot] >= 0 -> inner[starts[slot]] else -> -1
                loop row >= 0 {
                    if ir_x64_grow_range(starts, ends, slot, loop_starts[row], loop_ends[row], first_writes[slot]) -> changed = true
                    row = parents[row]
                }
                row = if heads[ends[slot]] >= 0 -> heads[ends[slot]] else -> inner[ends[slot]]
                loop row >= 0 {
                    if ir_x64_grow_range(starts, ends, slot, loop_starts[row], loop_ends[row], first_writes[slot]) -> changed = true
                    row = parents[row]
                }
            } else {
                loop row in 0..<loop_starts.len() {
                    if ir_x64_grow_range(starts, ends, slot, loop_starts[row], loop_ends[row], first_writes[slot]) -> changed = true
                }
            }
        }
    }

    // Linear scan: the General slots over the callee-saved registers and,
    // for those whose ranges hold no instruction that may call (r8 and r9
    // carry only a call's arguments: ir_x64_silent), r8 and r9 first (in a
    // leaf every slot's range is such a one); the Float slots over
    // xmm8-xmm15 and, for those whose ranges hold no call passing more than
    // two Floats, xmm2-xmm7 (IR_X64_XMM_REGISTERS). A
    // slot that starts with its write may take the register of one its
    // writer reads last, that of the writer's first operand first
    // (`partners`), an If's result that of its then arm's source
    // (ir_x64_phis), and a copy that may share its source's register
    // (ir_x64_aliases) rides on it. Sharing holds for Float slots across the
    // calls inside an instruction too: before the call ir_x64_keep_xmms
    // stores every slot sharing the register, all of them holding the same
    // value, and after it loads them all back.
    general: loop slot in 0..<count -> starts[slot] <= ends[slot] && !consts[slot] && !addressed[slot] && classes[slot] == .General
    floating: loop slot in 0..<count -> starts[slot] <= ends[slot] && classes[slot] == .Float
    fresh: loop slot in 0..<count -> first_writes[slot] && starts[slot] >= 0 && ir_x64_write(f, starts[slot]) == slot
    partners: loop slot in 0..<count -> if fresh[slot] && left_reads[starts[slot]] -> f.a[starts[slot]] else -> -1
    phis: ir_x64_phis(m, f, starts, ends, last_write, writes, classes, consts, addressed, around)
    aliases: ir_x64_aliases(m, f, starts, ends, last_write, writes, classes, consts, addressed)
    regs: if {
        ir_x64_leaf(m, f, classes, consts, values) -> ir_x64_scan(starts, ends, weights, general, general, IR_X64_LEAF_REGISTERS.len(), 0, fresh, partners, phis, aliases, IR_X64_LEAF_REGISTERS)
        else -> ir_x64_scan(starts, ends, weights, general, ir_x64_silent_slots(m, f, consts, values, general, starts, ends), IR_X64_SLOT_REGISTERS.len(), IR_X64_SLOT_REGISTERS.len(), fresh, partners, phis, aliases, IR_X64_QUIET_REGISTERS)
    }
    // Per instruction, how many before it pass more than two Float
    // arguments.
    crowded := [Int]{0}
    loop at in 0..<f.op.len() {
        op: f.op[at]
        floats := 0
        if op == .Call || op == .CallRuntime || op == .CallIndirect {
            loop index in f.b[at]..<(f.b[at] + f.c[at]) {
                arg: f.args[index]
                if arg >= 0 && arg < count && classes[arg] == .Float -> floats += 1
            }
        }
        crowded.push(crowded[at] + (if floats > 2 -> 1 else -> 0))
    }
    roomy: loop slot in 0..<count -> floating[slot] && slot >= f.param_count && starts[slot] >= 0 && crowded[ends[slot] + 1] == crowded[starts[slot]]
    xmms: ir_x64_scan(starts, ends, weights, floating, roomy, IR_X64_XMM_OPEN, 0, fresh, partners, phis, aliases, IR_X64_XMM_REGISTERS)
    xmm_slots := [Int]{}
    loop slot in 0..<count {
        if xmms[slot] >= 0 -> xmm_slots.push(slot)
    }
    // The callee-saved registers some slot ends up with (a stolen register
    // may hold none), in push order.
    kept := [Int]{}
    loop reg in IR_X64_SLOT_REGISTERS {
        holds := false
        loop slot in 0..<count {
            if regs[slot] == reg -> holds = true
        }
        if holds -> kept.push(reg)
    }

    // Frame homes below the saved registers, for the referenced slots
    // without a callee-saved register or a constant (a Float slot in an xmm
    // register keeps its home across the calls it lives through).
    homed: loop slot in 0..<count -> regs[slot] < 0 && !consts[slot] && !addressed[slot] && starts[slot] <= ends[slot] && classes[slot] != .Empty
    named: loop slot in 0..<count -> f.slot_name[slot] >= 0
    homes: ir_x64_homes(starts, ends, refs, homed, named, 8 * kept.len())
    depth := 8 * kept.len()
    loop home in homes {
        if 0 - home > depth -> depth = 0 - home
    }
    result_home := 0
    if f.result >= 0 && m.types[f.result].kind == .Aggregate {
        depth += 8
        result_home = 0 - depth
    }
    stack := [Int]{}
    loop at in 0..<f.op.len() {
        disp := 0
        op: f.op[at]
        if op == .StackAddress && (result_storage < 0 || at != last_write[result_storage]) {
            size: ir_x64_storage_size(f, at)
            align: if f.b[at] > 16 -> 16 else if f.b[at] < 1 -> 1 else -> f.b[at]
            depth = ir_x64_align(depth + size, align)
            disp = 0 - depth
        }
        // An aggregate result lands in caller storage the hidden first
        // argument points at, one per call site.
        if (op == .Call || op == .CallRuntime || op == .CallIndirect) && f.dst[at] >= 0 {
            dst_row: f.slot_type[f.dst[at]]
            if m.types[dst_row].kind == .Aggregate {
                align: if m.types[dst_row].align > 16 -> 16 else if m.types[dst_row].align < 8 -> 8 else -> m.types[dst_row].align
                depth = ir_x64_align(depth + ir_x64_align(m.types[dst_row].size, 8), align)
                disp = 0 - depth
            }
        }
        stack.push(disp)
    }
    frames := [Int]{}
    loop slot in 0..<count -> frames.push(if roots[slot] >= 0 -> stack[last_write[roots[slot]]] + shifts[slot] else -> 0)
    total: ir_x64_align(depth, 16)
    frame_bytes: total - 8 * kept.len()
    IRX64Allocation{regs: regs.move(), xmms: xmms.move(), xmm_slots: xmm_slots.move(), homes: homes.move(), consts: consts.move(), values: values.move(), frames: frames.move(), starts: starts.move(), ends: ends.move(), stack: stack.move(), saved: kept.move(), frame_bytes: frame_bytes, result_home: result_home, result_storage: result_storage}
}

// IR_X64_ALIAS_SPAN: the most instructions a copy's range may cover to
// share its source's register.
IR_X64_ALIAS_SPAN: 256

// Per slot, the slot whose register it shares (-1: none): a General or
// Float slot written once, first, by a Move, or by a Copy that does not
// clone, of an 8-byte slot of its class that holds a register's worth (no
// constant or frame address) and that, live across the copy's whole range,
// is not written inside it. Both then hold the same bits wherever the copy
// is live, so one register serves both and the copy is no instruction.
ir_x64_aliases: fn(m: IRModule, f: IRFunction, starts: [Int], ends: [Int], last_write: [Int], writes: [Int], classes: [IRX64Class], consts: [Bool], addressed: [Bool]) -> [Int] Never! {
    count: f.slot_type.len()
    aliases := [Int]{}
    loop slot in 0..<count {
        aliases.push(-1)
        at: last_write[slot]
        if slot < f.param_count || at < 0 || writes[slot] != 1 || starts[slot] != at || ends[slot] - at > IR_X64_ALIAS_SPAN -> next
        if (classes[slot] != .General && classes[slot] != .Float) || consts[slot] || addressed[slot] || m.types[f.slot_type[slot]].size != 8 -> next
        op: f.op[at]
        if op != .Move && op != .Copy -> next
        source: f.a[at]
        if source < 0 || source >= count || source == slot || classes[source] != classes[slot] || consts[source] || addressed[source] -> next
        row: m.types[f.slot_type[source]]
        if row.size != 8 || (op == .Copy && row.drop != "" && row.kind != .Aggregate && !ir_clone_shares(row.clone)) -> next
        if starts[source] > at || ends[source] < ends[slot] -> next
        written := false
        loop k in (at + 1)..<(ends[slot] + 1) {
            if ir_x64_write(f, k) == source {
                written = true
                break
            }
        }
        if !written -> aliases[slot] = source
    }
    aliases
}

// Per slot, the slot whose register it may take while that one is still
// live (-1: none): an If's result, a General or Float 8-byte slot written
// twice, by a Move or a Copy that does not clone of `source` (of its class)
// directly in the If's then arm (its first reference) and once in the else
// arm. The source is not read again in the then arm, it is read in the else
// arm only up to and at that second write, never after the If, and never
// written while the result is live; the result is not read in the else arm
// up to that write. So no path holds both values apart: one register serves
// both, the copy is no instruction and the else arm overwrites the source
// only once done with it.
ir_x64_phis: fn(m: IRModule, f: IRFunction, starts: [Int], ends: [Int], last_write: [Int], writes: [Int], classes: [IRX64Class], consts: [Bool], addressed: [Bool], around: [Int]) -> [Int] Never! {
    count: f.slot_type.len()
    phis := [Int]{}
    reads := [Int]{}
    loop slot in 0..<count {
        phis.push(-1)
        at: starts[slot]
        if slot < f.param_count || at < 0 || writes[slot] != 2 || ir_x64_write(f, at) != slot || ends[slot] - at > IR_X64_ALIAS_SPAN -> next
        if (classes[slot] != .General && classes[slot] != .Float) || consts[slot] || addressed[slot] || m.types[f.slot_type[slot]].size != 8 -> next
        op: f.op[at]
        if op != .Move && op != .Copy -> next
        source: f.a[at]
        if source < 0 || source >= count || source == slot || classes[source] != classes[slot] || consts[source] || addressed[source] -> next
        row: m.types[f.slot_type[source]]
        if row.size != 8 || (op == .Copy && row.drop != "" && row.kind != .Aggregate && !ir_clone_shares(row.clone)) -> next
        branch: around[at]
        if branch < 0 || f.op[branch] != .If -> next
        middle: f.b[branch]
        end: f.c[branch]
        if middle <= at || middle >= end || end >= f.op.len() -> next
        other: last_write[slot]
        if other <= middle || other >= end || ends[source] > other -> next
        safe := true
        loop k in (at + 1)..<(ends[slot] + 1) {
            if ir_x64_write(f, k) == source {
                safe = false
                break
            }
            if k > other -> next
            ir_x64_reads_into(f, k, reads)
            loop read in reads {
                if (read == source && k < middle) || (read == slot && k > middle) -> safe = false
            }
            if !safe -> break
        }
        if safe -> phis[slot] = source
    }
    phis
}

// The slot an aggregate-returning function builds its result in, when the
// caller's result storage can take that place: every Return with a value
// returns it, its only write is a StackAddress of exactly the result's size
// and no stricter alignment than 8, and no parameter can carry an address
// (an aggregate, pointer or String), so no argument can point into the
// caller's storage the result overwrites. -1 otherwise.
ir_x64_result_storage: fn(m: IRModule, f: IRFunction, last_write: [Int], writes: [Int]) -> Int Never! {
    if f.result < 0 || m.types[f.result].kind != .Aggregate -> return -1
    loop slot in 0..<f.param_count {
        kind: m.types[f.slot_type[slot]].kind
        if kind == .Aggregate || kind == .Pointer || kind == .String -> return -1
    }
    found := -1
    loop at in 0..<f.op.len() {
        if f.op[at] != .Return || f.a[at] < 0 -> next
        if found >= 0 && f.a[at] != found -> return -1
        found = f.a[at]
    }
    if found < f.param_count || f.slot_kind[found] != .Temp || writes[found] != 1 -> return -1
    at: last_write[found]
    if at < 0 || f.op[at] != .StackAddress || ir_x64_storage_size(f, at) != m.types[f.result].size || f.b[at] > 8 -> return -1
    found
}

// The bytes of the storage the StackAddress at `at` reserves.
ir_x64_storage_size: fn(f: IRFunction, at: Int) -> Int Never! {
    if f.a[at] > 0 -> f.a[at] else -> 8
}

// Linear scan of the `eligible` slots over the registers of `pool`, by start
// then slot: one sort of the keys (start + 1) * count + slot (a parameter
// starts at -1). The rows of `pool` from `wide` on go only to the `open`
// slots, which look for a free register from row `open_first` on first (0:
// from the first row), keeping the rows before it for the slots that may
// take no other. A copy that
// may share its source's register (`aliases`,
// ir_x64_aliases) rides on it while the source has one, taking none of its
// own, and loses it with the source; its range lies inside the source's.
// A range whose first reference writes it (`fresh`) may take the register
// of one whose last reference is that same instruction: selection reads
// every operand of an instruction before it writes the result. It takes
// that of its `partners` slot (the writer's first operand, -1 none) before
// any other, so a two-address instruction computes in place with no copy.
// An If's result takes the register of its `phis` slot (ir_x64_phis) while
// that one still owns it, live or not; the source then rides on it until it
// ends. When every register is taken, the register whose owner and live
// riders weigh least together (ir_x64_lighter) goes to the range if they
// are lighter than it; else the range stays in its home, until
// ir_x64_fill_homes finds it a register no range kept over all of it. Per
// slot: its register, -1 for none.
ir_x64_scan: fn(starts: [Int], ends: [Int], weights: [Int], eligible: [Bool], open: [Bool], wide: Int, open_first: Int, fresh: [Bool], partners: [Int], phis: [Int], aliases: [Int], pool: [Int]) -> [Int] Never! {
    count: starts.len()
    regs := [Int]{}
    loop _ in 0..<count -> regs.push(-1)
    keys := [Int]{}
    loop slot in 0..<count {
        if eligible[slot] -> keys.push((starts[slot] + 1) * count + slot)
    }
    keys.sort()
    owners := [Int]{}
    loop _ in 0..<pool.len() -> owners.push(-1)
    riders := [Int]{}
    loop key in keys {
        slot: key %% count
        start: starts[slot]
        // Expire ranges that ended before this one starts.
        loop row in 0..<pool.len() {
            owner: owners[row]
            if owner >= 0 && ends[owner] < start -> owners[row] = -1
        }
        source: aliases[slot]
        if source >= 0 && regs[source] >= 0 {
            regs[slot] = regs[source]
            riders.push(slot)
            next
        }
        rows: if open[slot] -> pool.len() else -> wide
        // A fresh range may also take a register whose range ends where it
        // starts, its partner's first.
        shares: fresh[slot] && start >= 0
        partner: partners[slot]
        free := -1
        phi: phis[slot]
        if shares && phi >= 0 {
            loop row in 0..<rows {
                if owners[row] == phi -> free = row
            }
            if free >= 0 && ends[phi] > start -> riders.push(phi)
        }
        if free < 0 && shares && partner >= 0 && ends[partner] == start {
            loop row in 0..<rows {
                if owners[row] == partner -> free = row
            }
        }
        first: if open[slot] && open_first < rows -> open_first else -> 0
        loop step in 0..<rows {
            row: (step + first) %% rows
            if free < 0 && (owners[row] < 0 || (shares && ends[owners[row]] == start)) -> free = row
        }
        if free >= 0 {
            owners[free] = slot
            regs[slot] = pool[free]
            next
        }
        // A register holds its owner's spill weight plus that of the copies
        // riding on it that are still live: evicting the owner evicts them
        // too. Riders that ended are dropped here, so the list stays the
        // live ones. Every row up to `rows` has an owner here.
        live := [Int]{}
        held := loop row in 0..<pool.len() -> if owners[row] >= 0 -> weights[owners[row]] else -> 0
        loop rider in riders {
            if ends[rider] < start -> next
            live.push(rider)
            loop row in 0..<pool.len() {
                if regs[rider] == pool[row] -> held[row] = held[row] + weights[rider]
            }
        }
        riders = live.move()
        victim := 0
        loop row in 1..<rows {
            if ir_x64_lighter(held[row], ends[owners[row]], held[victim], ends[owners[victim]]) -> victim = row
        }
        loser: owners[victim]
        if ir_x64_lighter(held[victim], ends[loser], weights[slot], ends[slot]) {
            regs[loser] = -1
            kept := [Int]{}
            loop rider in riders {
                if regs[rider] == pool[victim] {
                    regs[rider] = -1
                    next
                }
                kept.push(rider)
            }
            riders = kept.move()
            owners[victim] = slot
            regs[slot] = pool[victim]
        }
    }
    ir_x64_fill_homes(starts, ends, weights, eligible, open, wide, open_first, pool, regs)
    regs
}

// IR_X64_FILL_WORK: the instructions ir_x64_fill_homes looks at, per
// instruction and slot of the function, at most.
IR_X64_FILL_WORK: 64

// The scan decides each range once, as it starts: an owner that a later,
// heavier range evicts goes home over all of its range, so the rows it held
// stand free over the stretches where the scan had sent other ranges home
// for want of them. Each such range (`eligible`, no register in `regs`),
// heaviest first, takes the first row of `pool` it may have (from
// `open_first` on for an `open` one, which may have them all; the rows
// before `wide` for any other) whose register no range holds anywhere over
// it. Bounded by IR_X64_FILL_WORK.
ir_x64_fill_homes: fn(starts: [Int], ends: [Int], weights: [Int], eligible: [Bool], open: [Bool], wide: Int, open_first: Int, pool: [Int], regs: &[Int]) Never! {
    count: starts.len()
    // Per instruction (from -1, a parameter's start): the pool rows whose
    // registers a range holds there, one bit each.
    span := 0
    loop slot in 0..<count {
        if eligible[slot] && ends[slot] + 2 > span -> span = ends[slot] + 2
    }
    held := loop _ in 0..<span -> 0
    loop slot in 0..<count {
        if !eligible[slot] || regs[slot] < 0 -> next
        bit := 0
        loop row in 0..<pool.len() {
            if pool[row] == regs[slot] -> bit = 1 << row
        }
        loop at in (starts[slot] + 1)..<(ends[slot] + 2) -> held[at] = held[at].bit_or(bit)
    }
    keys := [Int]{}
    heaviest := 0
    loop slot in 0..<count {
        if eligible[slot] && regs[slot] < 0 && weights[slot] > heaviest -> heaviest = weights[slot]
    }
    loop slot in 0..<count {
        if eligible[slot] && regs[slot] < 0 -> keys.push((heaviest - weights[slot]) * count + slot)
    }
    keys.sort()
    work := IR_X64_FILL_WORK * (span + count)
    loop key in keys {
        slot: key %% count
        lo: starts[slot] + 1
        hi: ends[slot] + 1
        work -= hi - lo + 1
        if work < 0 -> return
        taken := 0
        loop at in lo..<(hi + 1) -> taken = taken.bit_or(held[at])
        rows: if open[slot] -> pool.len() else -> wide
        first: if open[slot] && open_first < rows -> open_first else -> 0
        free := -1
        loop step in 0..<rows {
            row: (step + first) %% rows
            if free < 0 && taken.bit_and(1 << row) == 0 -> free = row
        }
        if free < 0 -> next
        regs[slot] = pool[free]
        loop at in lo..<(hi + 1) -> held[at] = held[at].bit_or(1 << free)
    }
}

// One register: slot 0 (0..9, weight 5) takes it, slot 1 (2..4, weight 1)
// starts while slot 0 holds it and goes home, then slot 2 (5..8, weight
// 20) evicts slot 0, which goes home over all of its range. The register
// stands free over slot 1's, which takes it; slot 0's overlaps slot 2's.
#Test("A range sent home takes a register an eviction left free over all of it") {
    starts: [Int]{0, 2, 5}
    ends: [Int]{9, 4, 8}
    weights: [Int]{5, 1, 20}
    eligible: [Bool]{true, true, true}
    fresh: [Bool]{true, true, true}
    none: [Int]{-1, -1, -1}
    regs: ir_x64_scan(starts, ends, weights, eligible, eligible, 1, 0, fresh, none, none, none, [Int]{3})
    assert_eq(regs[2], 3)
    assert_eq(regs[1], 3)
    assert_eq(regs[0], -1)
}

// Whether a register holding spill weight `a` up to `a_end` should go before
// one holding `b` up to `b_end`: it holds less, or as much and ends later.
ir_x64_lighter: fn(a: Int, a_end: Int, b: Int, b_end: Int) -> Bool Never! {
    a < b || (a == b && a_end > b_end)
}

// One register: a light value (weight 1) whose hot copy (weight 100) rides
// on it, then a range of weight 50. Evicting the value would evict the copy
// too, 101 against 50, so the new range stays in its home.
#Test("A copy riding on a register adds its weight to the register's") {
    starts: [Int]{0, 1, 2}
    ends: [Int]{10, 5, 8}
    weights: [Int]{1, 100, 50}
    eligible: [Bool]{true, true, true}
    fresh: [Bool]{true, true, true}
    aliases: [Int]{-1, 0, -1}
    partners: [Int]{-1, -1, -1}
    regs: ir_x64_scan(starts, ends, weights, eligible, eligible, 1, 0, fresh, partners, partners, aliases, [Int]{3})
    assert_eq(regs[0], 3)
    assert_eq(regs[1], 3)
    assert_eq(regs[2], -1)
    // Without the copy riding, the value alone is lighter and goes home.
    alone: ir_x64_scan(starts, ends, weights, eligible, eligible, 1, 0, fresh, partners, partners, [Int]{-1, -1, -1}, [Int]{3})
    assert_eq(alone[0], -1)
}

// Two ranges end at instruction 5, where a third starts with its write:
// it takes the register of its writer's first operand (slot 1), which the
// instruction then computes in place, rather than the first one free.
#Test("A result takes its first operand's register when that operand ends there") {
    starts: [Int]{0, 1, 5}
    ends: [Int]{5, 5, 9}
    weights: [Int]{1, 1, 1}
    eligible: [Bool]{true, true, true}
    fresh: [Bool]{true, true, true}
    aliases: [Int]{-1, -1, -1}
    pool: [Int]{3, 12}
    regs: ir_x64_scan(starts, ends, weights, eligible, eligible, 2, 0, fresh, [Int]{-1, -1, 1}, aliases, aliases, pool)
    assert_eq(regs[0], 3)
    assert_eq(regs[1], 12)
    assert_eq(regs[2], 12)
    first: ir_x64_scan(starts, ends, weights, eligible, eligible, 2, 0, fresh, aliases, aliases, aliases, pool)
    assert_eq(first[2], 3)
}

// if c { x = y } else { x = g(y) }: y (slot 1, 1..6) is still live in the
// else arm when x (slot 2) starts with the then arm's copy at 3. As y's
// phi, x takes y's register with y riding on it; else both registers are
// held by heavier ranges and x stays in its home.
#Test("An If's result takes its then arm's source's register") {
    starts: [Int]{0, 1, 3}
    ends: [Int]{9, 6, 9}
    weights: [Int]{10, 10, 1}
    eligible: [Bool]{true, true, true}
    fresh: [Bool]{true, true, true}
    none: [Int]{-1, -1, -1}
    pool: [Int]{3, 12}
    regs: ir_x64_scan(starts, ends, weights, eligible, eligible, 2, 0, fresh, none, [Int]{-1, -1, 1}, none, pool)
    assert_eq(regs[0], 3)
    assert_eq(regs[1], 12)
    assert_eq(regs[2], 12)
    apart: ir_x64_scan(starts, ends, weights, eligible, eligible, 2, 0, fresh, none, none, none, pool)
    assert_eq(apart[2], -1)
}

// rbx, r12 and r8: a short range with no call in it (slot 1) takes r8
// first, so a range that may hold a call and starts while it lives (slot 2)
// still finds r12. Without the rotation slot 1 takes r12, and slot 2, no
// heavier than it, stays in its home.
#Test("A range that holds no call takes r8 before a callee-saved register") {
    starts: [Int]{0, 2, 3}
    ends: [Int]{9, 4, 8}
    weights: [Int]{100, 10, 10}
    eligible: [Bool]{true, true, true}
    open: [Bool]{false, true, false}
    fresh: [Bool]{true, true, true}
    none: [Int]{-1, -1, -1}
    pool: [Int]{3, 12, 8}
    regs: ir_x64_scan(starts, ends, weights, eligible, open, 2, 2, fresh, none, none, none, pool)
    assert_eq(regs[0], 3)
    assert_eq(regs[1], 8)
    assert_eq(regs[2], 12)
    plain: ir_x64_scan(starts, ends, weights, eligible, open, 2, 0, fresh, none, none, none, pool)
    assert_eq(plain[1], 12)
    assert_eq(plain[2], -1)
}

// f(x) = g(x - 1) + x: the Call is the last read of x - 1 and writes g's
// result, which takes its register; the Add, the last read of both x and
// that result, writes the sum into one of theirs. Two callee-saved
// registers serve four slots.
#Test("A result takes a register its instruction reads for the last time") {
    m := ir_module_new()
    word: ir_type_row(m, Type.IntN{signed: true, bits: 64}) ?? panic("no I64 row")
    g := ir_function_new("g", "test:share.jet::g", "", "share.jet", 1)
    v: ir_slot(g, word, IRSlotKind.Param, ir_intern_name(m, "v"), 1)
    g.result = word
    _ := ir_emit(g, IROp.Return, -1, v, -1, -1, 1)
    g_row: m.functions.len()
    name_rows_set(m.function_rows, g.key, g_row)
    m.functions.push(g)
    f := ir_function_new("f", "test:share.jet::f", "", "share.jet", 3)
    x: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "x"), 3)
    f.result = word
    one: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Const, one, 1, -1, -1, 4)
    less: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Sub, less, x, one, IR_OVERFLOW_WRAP, 4)
    args: ir_args(f, [Int]{less})
    got: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Call, got, g_row, args, 1, 4)
    sum: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Add, sum, got, x, IR_OVERFLOW_WRAP, 4)
    _ := ir_emit(f, IROp.Return, -1, sum, -1, -1, 4)
    al: ir_x64_allocate(m, f)
    assert(al.regs[less] >= 0 && al.regs[less] != al.regs[x])
    assert_eq(al.regs[got], al.regs[less])
    assert(al.regs[sum] == al.regs[x] || al.regs[sum] == al.regs[got])
    assert_eq(al.saved.len(), 2)
}

// f(x, y) = ((x * y) + y) * x, then that through a Move: each Float result
// takes the xmm register of the first operand its instruction reads for
// the last time, and the Move's copy shares it, so one register serves the
// product, the sum and both copies: no movaps between them.
#Test("A Float result takes the xmm register its instruction reads for the last time") {
    m := ir_module_new()
    float: ir_type_row(m, Type.Float) ?? panic("no Float row")
    f := ir_function_new("f", "test:share.jet::f", "", "share.jet", 2)
    x: ir_slot(f, float, IRSlotKind.Param, ir_intern_name(m, "x"), 2)
    y: ir_slot(f, float, IRSlotKind.Param, ir_intern_name(m, "y"), 2)
    f.result = float
    product: ir_slot(f, float, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Mul, product, x, y, -1, 3)
    sum: ir_slot(f, float, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Add, sum, product, y, -1, 3)
    scaled: ir_slot(f, float, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Mul, scaled, sum, x, -1, 3)
    copied: ir_slot(f, float, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Move, copied, scaled, -1, -1, 3)
    _ := ir_emit(f, IROp.Return, -1, copied, -1, -1, 3)
    al: ir_x64_allocate(m, f)
    assert(al.xmms[product] >= 0)
    assert_eq(al.xmms[sum], al.xmms[product])
    assert_eq(al.xmms[scaled], al.xmms[sum])
    assert_eq(al.xmms[copied], al.xmms[scaled])
}

// f(x) squares x ten times over and sums the squares: all ten are live at
// the first Add, more than xmm8-xmm15 hold, so the ones left over take
// xmm2-xmm7. With a call passing x three times among the squares, which
// fills xmm0-xmm2 with arguments, the ones left over stay in their homes.
#Test("Float slots left over take xmm2-xmm7 only past calls with at most two Float arguments") {
    loop round in 0..<2 {
        crowded: round == 1
        m := ir_module_new()
        float: ir_type_row(m, Type.Float) ?? panic("no Float row")
        f := ir_function_new("f", "test:low.jet::f", "", "low.jet", 1)
        x: ir_slot(f, float, IRSlotKind.Param, ir_intern_name(m, "x"), 2)
        f.result = float
        squares := [Int]{}
        loop _ in 0..<10 {
            square: ir_slot(f, float, IRSlotKind.Temp, -1, 0)
            _ := ir_emit(f, IROp.Mul, square, x, x, -1, 3)
            squares.push(square)
        }
        if crowded {
            passed: ir_args(f, [Int]{x, x, x})
            _ := ir_emit(f, IROp.CallRuntime, -1, ir_intern_name(m, "use3"), passed, 3, 4)
        }
        sum := squares[0]
        loop index in 1..<10 {
            next: ir_slot(f, float, IRSlotKind.Temp, -1, 0)
            _ := ir_emit(f, IROp.Add, next, sum, squares[index], -1, 5)
            sum = next
        }
        _ := ir_emit(f, IROp.Return, -1, sum, -1, -1, 6)
        al: ir_x64_allocate(m, f)
        low := 0
        homed := 0
        loop square in squares {
            if al.xmms[square] >= 2 && al.xmms[square] < 8 -> low += 1
            if al.xmms[square] < 0 -> homed += 1
        }
        assert(al.xmms[x] < 2 || al.xmms[x] >= 8)
        assert_eq(low == 0, crowded)
        assert_eq(homed > 0, crowded)
    }
}

// make(x) builds a Pair from a scalar: in the caller's storage. swap(p)
// reads a Pair parameter, which may point into that storage: in its own.
// Callees stay out of line, so each is checked as selection sees it after
// the level's passes.
#Test("A function builds its aggregate result in the caller's storage only when no argument can alias it") {
    loop level in 0..<3 {
        m := ir_module_new()
        word: ir_type_row(m, Type.IntN{signed: true, bits: 64}) ?? panic("no I64 row")
        pair: ir_intern_type(m, "Pair", IRType{ty: Type.Named{name: "Pair"}, kind: IRTypeKind.Aggregate, size: 16, align: 8, class: IRClass.Pointer, signed: false, bits: 64, drop: ""})
        make := ir_function_new("make", "test:pair.jet::make", "", "pair.jet", 1)
        x: ir_slot(make, word, IRSlotKind.Param, ir_intern_name(m, "x"), 1)
        make.result = pair
        built: ir_slot(make, pair, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(make, IROp.StackAddress, built, 16, 8, -1, 2)
        _ := ir_emit(make, IROp.Store, -1, built, 0, x, 2)
        _ := ir_emit(make, IROp.Store, -1, built, 8, x, 2)
        _ := ir_emit(make, IROp.Return, -1, built, -1, -1, 2)
        make_row: m.functions.len()
        name_rows_set(m.function_rows, make.key, make_row)
        m.functions.push(make)
        swap := ir_function_new("swap", "test:pair.jet::swap", "", "pair.jet", 4)
        p: ir_slot(swap, pair, IRSlotKind.Param, ir_intern_name(m, "p"), 4)
        swap.result = pair
        left: ir_slot(swap, word, IRSlotKind.Temp, -1, 0)
        right: ir_slot(swap, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(swap, IROp.Load, left, p, 0, -1, 5)
        _ := ir_emit(swap, IROp.Load, right, p, 8, -1, 5)
        swapped: ir_slot(swap, pair, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(swap, IROp.StackAddress, swapped, 16, 8, -1, 5)
        _ := ir_emit(swap, IROp.Store, -1, swapped, 0, right, 5)
        _ := ir_emit(swap, IROp.Store, -1, swapped, 8, left, 5)
        _ := ir_emit(swap, IROp.Return, -1, swapped, -1, -1, 5)
        swap_row: m.functions.len()
        name_rows_set(m.function_rows, swap.key, swap_row)
        m.functions.push(swap)
        run := ir_function_new("run", "test:pair.jet::run", "", "pair.jet", 7)
        seed: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(run, IROp.Const, seed, 3, -1, -1, 8)
        made: ir_slot(run, pair, IRSlotKind.Local, ir_intern_name(m, "a"), 8)
        make_args: ir_args(run, [Int]{seed})
        _ := ir_emit(run, IROp.Call, made, make_row, make_args, 1, 8)
        turned: ir_slot(run, pair, IRSlotKind.Local, ir_intern_name(m, "b"), 9)
        swap_args: ir_args(run, [Int]{made})
        _ := ir_emit(run, IROp.Call, turned, swap_row, swap_args, 1, 9)
        _ := ir_emit(run, IROp.Return, -1, -1, -1, -1, 10)
        m.entry = m.functions.len()
        name_rows_set(m.function_rows, run.key, m.entry)
        m.functions.push(run)
        if level > 0 {
            options := ir_opt_options(level)
            options.inline = IROptInline.Off
            _ := ir_optimize_module(m, options, compiler_threads_single())
        }
        made_in_place: ir_x64_allocate(m, m.functions[make_row])
        assert(made_in_place.result_storage >= 0)
        assert_eq(ir_x64_allocate(m, m.functions[swap_row]).result_storage, -1)
    }
}
