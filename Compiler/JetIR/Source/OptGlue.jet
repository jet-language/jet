// Drop glue as calls (O1, O2): a Drop of a value whose drop routine is a
// module function (BuildOwn.jet ir_drop_glue: a counted buffer's release, a
// struct's member drops) is selected as that function's call (X64Select
// ir_x64_drop). Before the call graph is built such a Drop becomes that
// Call when it runs often: inside a Loop, or in a glue itself (a list's
// release drops each element in its loop). So the glue is optimized before
// its users and inlining can take a small glue into them. After inlining, a
// Call of a glue left in place is a Drop again, which scalar replacement
// lends storage to (OptScalar.jet).

// `glue` is ir_opt_glue_table's: per type row, its glue function or -1.
fn ir_opt_glue_calls(f: &IRFunction, glue: [Int]) Never! {
    in_glue :: f.name == "drop" && f.source_file == ""
    // Open Loops around `at` (an End's `a` is its opener).
    loops := 0
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        if op == .Loop -> loops += 1
        if op == .End && f.a[at] >= 0 && f.op[f.a[at]] == .Loop -> loops -= 1
        if op != .Drop || f.a[at] < 0 || (!in_glue && loops == 0) -> next
        slot :: f.a[at]
        id :: glue[f.slot_type[slot]]
        if id < 0 -> next
        start :: f.args.len()
        &f.args.push(slot)
        f.op[at] = .Call
        f.dst[at] = -1
        f.a[at] = id
        f.b[at] = start
        f.c[at] = 1
    }
}

fn ir_opt_glue_drops(f: &IRFunction, m: IRModule, keys: [String]) Never! {
    loop at in 0..<f.op.len() {
        if f.op[at] != .Call || f.dst[at] >= 0 || f.c[at] != 1 -> next
        callee :: f.a[at]
        if callee < 0 || callee >= keys.len() -> next
        slot :: f.args[f.b[at]]
        if slot < 0 || m.types[f.slot_type[slot]].drop != keys[callee] -> next
        f.op[at] = .Drop
        f.a[at] = slot
        f.b[at] = -1
        f.c[at] = -1
    }
}
