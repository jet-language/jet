// Fixed timing in the selected code: which slots of a function hold a
// `timing: .Fixed` value, the x86-64 table of the instructions such a value
// may meet, and the validator that checks a function's selected code
// against it (the wasm32 table and validator are JetWeb Web/Timing.jet's).
//
// A function is checked when a slot of it is marked (IRFunction.slot_fixed,
// ir_timing_marked). Its fixed slots are the marked ones and each one a
// data instruction writes from one (ir_timing_fixed): the values IR Lint's
// fixed rule follows after every pass (Lint.jet ir_lint_fixed). A function
// with no marked slot is selected as before: its encoder keeps no log and
// nothing is allocated for the check.
//
// x86-64. For a data instruction with a fixed operand the selector
// (X64Select.jet) writes the general-purpose instructions ir_timing_x64_row
// names, and re-extends a result narrower than a word with MOVZX or MOVSX.
// Each is on Intel's list of data operand independent timing instructions:
// Intel, "Data Operand Independent Timing Instruction Set Architecture (ISA)
// Guidance" (2022), whose timing holds on a processor that enumerates DOITM
// while IA32_UARCH_MISC_CTL.DOITM is set. DIV and IDIV are not on the list.
// AMD publishes no such list: the same code on an AMD processor is
// unconfirmed. The encoder's emission log (JetBackend X64/Encoder.jet
// X64EmitRow) holds every branch, memory operand, division, string
// operation, register call and template the selector wrote, by IR
// instruction; ir_timing_x64_check refuses each one a fixed value decides.

use {
    jet_foundation.[Type]
    jet_backend.[X64EmitRow, X64_RBP, X64_RSP, x64_emit_row_text]
}

// Whether a slot of `f` is marked fixed.
ir_timing_marked: fn(f: IRFunction) -> Bool Never! {
    loop bit in f.slot_fixed {
        if bit -> return true
    }
    false
}

// The fixed slots of `f`: the marked ones and, to a fixed point, each one a
// data instruction writes from a fixed operand (ir_timing_flows).
ir_timing_fixed: fn(f: IRFunction) -> [Bool] Never! {
    fixed := f.slot_fixed.copy()
    grew := true
    loop grew {
        grew = false
        loop at in 0..<f.op.len() {
            dst: f.dst[at]
            if dst < 0 || fixed[dst] -> next
            if ir_timing_flows(f, fixed, at) {
                fixed[dst] = true
                grew = true
            }
        }
    }
    fixed
}

// Whether instruction `at` writes its destination from a fixed operand: a
// Copy, Move, arithmetic, bit, shift, compare, Neg, Not, Convert, Sqrt or
// IntBig, an Offset of a fixed address or a Load from one. A call's result
// and a load of a public address are fixed only as marked.
ir_timing_flows: fn(f: IRFunction, fixed: [Bool], at: Int) -> Bool Never! {
    if f.op[at] == {
        .Copy | .Move | .Neg | .Not | .Convert | .Sqrt | .IntBig | .Offset | .Load -> ir_timing_at(fixed, f.a[at])
        .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge -> ir_timing_at(fixed, f.a[at]) || ir_timing_at(fixed, f.b[at])
        .Nop | .Const | .ConstText | .ConstBigInt | .Drop | .Close | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Store | .StackAddress | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .StreamStore -> false
    }
}

ir_timing_at: fn(fixed: [Bool], slot: Int) -> Bool Never! {
    slot >= 0 && slot < fixed.len() && fixed[slot]
}

ir_timing_any: fn(fixed: [Bool], slots: [Int]) -> Bool Never! {
    loop slot in slots {
        if ir_timing_at(fixed, slot) -> return true
    }
    false
}

// The x86-64 table: the instructions the selector writes for instruction
// `at` of `f` when an operand of it is fixed, "" when its op has no row (a
// fixed operand may not meet it). A word's wrapping arithmetic, bit
// operations, shifts by a public count, comparisons, negation, conversion
// to a word, Bool or Char, and the moves of a copy, a store of a fixed
// value, a call's arguments and a return's result.
ir_timing_x64_row: fn(m: IRModule, f: IRFunction, at: Int) -> String Never! {
    if f.op[at] == {
        .Copy | .Move | .Store -> "MOV"
        .Add -> "ADD, LEA"
        .Sub -> "SUB"
        .Mul -> "IMUL, MUL"
        .BitAnd -> "AND"
        .BitOr -> "OR"
        .BitXor -> "XOR"
        .Shl -> "SHL"
        .Shr -> "SHR, SAR"
        .Eq | .Ne | .Lt | .Le | .Gt | .Ge -> "CMP, TEST, SETcc, CMOVcc"
        .Neg -> "NEG"
        .Not -> "NOT, XOR"
        .Convert -> if m.types[f.slot_type[f.dst[at]]].kind == {
            .Word | .Bool | .Char -> "MOV, MOVZX, MOVSX, AND"
            .Unit | .Int | .Float | .Float32 | .String | .Pointer | .Aggregate -> ""
        }
        .Call | .CallRuntime | .CallIndirect | .Return -> "MOV"
        .Drop -> if m.types[f.slot_type[f.a[at]]].drop == "" -> "none" else -> ""
        .Nop | .Const | .ConstText | .ConstBigInt | .Close | .Div | .Rem | .FloorDiv | .Mod | .Concat | .FunctionAddress | .DataAddress | .Load | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Unreachable | .Sqrt | .IntBig | .StreamStore -> ""
    }
}

// The findings of the code selected for `f`, whose emission log is `log`,
// into `errors`: a fixed operand of an instruction the x86-64 table has no
// row for or of an inline-asm leaf's call, a branch or stop a fixed value
// decides, a memory operand off the frame at a fixed address (or in an
// instruction with a fixed operand that is no load, store or copy), a
// division, string operation or template with a fixed operand, and a call
// through a fixed register.
ir_timing_x64_check: fn(m: IRModule, f: IRFunction, log: [X64EmitRow], errors: &[String]) Never! {
    fixed: ir_timing_fixed(f)
    reads := [Int]{}
    loop at in 0..<f.op.len() {
        ir_x64_reads_into(f, at, reads)
        if !ir_timing_any(fixed, reads) -> next
        if ir_timing_x64_row(m, f, at) == "" -> errors.push(ir_timing_finding(f, at, "a fixed operand meets an instruction the x86-64 table has no row for"))
        callee: f.a[at]
        if f.op[at] == .Call && callee >= 0 && callee < m.functions.len() && m.functions[callee].asm != None -> errors.push(ir_timing_finding(f, at, "a fixed operand reaches an inline-asm template, whose bytes are not checked"))
    }
    loop row in log {
        at: row.at
        if at < 0 || at >= f.op.len() -> next
        ir_x64_reads_into(f, at, reads)
        operand: ir_timing_any(fixed, reads)
        op: f.op[at]
        what: if row.kind == {
            .Jcc -> {
                decided: if row.tests >= 0 -> ir_timing_at(fixed, row.tests) else -> operand
                if !decided -> "" else if row.stop -> "a stop decided by a fixed value" else -> "a branch decided by a fixed value"
            }
            .Memory -> ir_timing_x64_memory(f, fixed, row, operand)
            .Div -> if operand -> "a division of a fixed value" else -> ""
            // A copy's byte count is an immediate (IR.jet CopyBytes): its
            // string instruction runs a fixed length.
            .String -> if op != .CopyBytes && operand -> "a string operation with a fixed operand" else -> ""
            .CallReg -> if op == .CallIndirect && ir_timing_at(fixed, f.a[at]) -> "a call through a fixed register" else -> ""
            .Asm -> if operand -> "an inline-asm template given a fixed value, whose bytes are not checked" else -> ""
            .Jmp | .Call -> ""
        }
        if what != "" -> errors.push(ir_timing_finding(f, at, "{what} (`{x64_emit_row_text(row)}`)"))
    }
}

// The finding of memory operand `row` of instruction `row.at`, "" for none:
// one off the frame at a fixed address, or in an instruction with a fixed
// operand (`operand`) that is no load, store or copy.
ir_timing_x64_memory: fn(f: IRFunction, fixed: [Bool], row: X64EmitRow, operand: Bool) -> String Never! {
    if ir_timing_frame(row.base) && ir_timing_frame(row.index) -> return ""
    at: row.at
    op: f.op[at]
    if op == .Load || op == .Store || op == .StreamStore {
        if ir_timing_at(fixed, f.a[at]) -> return "a memory access at a fixed address"
        return ""
    }
    if op == .CopyBytes {
        if ir_timing_at(fixed, f.a[at]) || ir_timing_at(fixed, f.b[at]) -> return "a memory copy at a fixed address"
        return ""
    }
    if operand -> return "a memory operand of an instruction with a fixed operand"
    ""
}

// Whether register `reg` addresses the frame: rbp, rsp or none.
ir_timing_frame: fn(reg: Int) -> Bool Never! {
    reg < 0 || reg == X64_RBP || reg == X64_RSP
}

// A finding at instruction `at` of `f`, with its source line.
ir_timing_finding: fn(f: IRFunction, at: Int, message: String) -> String Never! {
    line: if at < f.code_line.len() -> ir_code_line_source(f.code_line[at]) else -> 0
    "{f.name}: instruction {at} ({ir_op_name(f.op[at])}) at {f.source_file}:{line}: fixed timing: {message}"
}

// mix(key, data) = (key ^ data) + data, wrapping, with `key` fixed.
ir_timing_test_function: fn(m: &IRModule, op: IROp, overflow: Int) -> IRFunction Never! {
    word: ir_type_row(m, Type.IntN{signed: false, bits: 64}) ?? panic("no U64 row")
    f := ir_function_new("mix", "test:timing.jet::mix", "", "timing.jet", 1)
    key: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "key"), 1)
    data: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "data"), 1)
    f.result = word
    mixed: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    sum: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    f.slot_fixed[key] = true
    _ := ir_emit(f, op, mixed, key, data, overflow, 2)
    _ := ir_emit(f, IROp.Add, sum, mixed, data, IR_OVERFLOW_WRAP, 3)
    _ := ir_emit(f, IROp.Return, -1, sum, -1, -1, 3)
    f
}

ir_timing_test_errors: fn(op: IROp, overflow: Int) -> [String] Never! {
    m := ir_module_new()
    f: ir_timing_test_function(m, op, overflow)
    m.functions.push(f)
    compiled := ir_x64_compile_function(m, ir_x64_tables(m), 0)
    compiled.errors.move()
}

ir_timing_test_has: fn(errors: [String], text: String) -> Bool Never! {
    loop error in errors {
        if error.contains(text) -> return true
    }
    false
}

#Test("A fixed word's bit operations and wrapping arithmetic pass the x86-64 validator") {
    assert_eq(ir_timing_test_errors(IROp.BitXor, IR_OVERFLOW_WRAP).len(), 0)
    assert_eq(ir_timing_test_errors(IROp.Mul, IR_OVERFLOW_WRAP).len(), 0)
}

#Test("The x86-64 validator refuses a division of a fixed word") {
    errors: ir_timing_test_errors(IROp.Div, IR_OVERFLOW_WRAP)
    assert(errors.len() > 0)
    assert(errors[0].starts_with("mix: instruction 0 (div) at timing.jet:2: fixed timing: "))
    assert(ir_timing_test_has(errors, "the x86-64 table has no row for"))
    assert(ir_timing_test_has(errors, "a division of a fixed value (`emit 0 div"))
}

#Test("The x86-64 validator refuses a stop decided by a fixed word") {
    errors: ir_timing_test_errors(IROp.Add, IR_OVERFLOW_TRAP)
    assert(ir_timing_test_has(errors, "a stop decided by a fixed value (`emit 0 jcc"))
}
