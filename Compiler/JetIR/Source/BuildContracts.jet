// The IR builder's `#Pre`/`#Post` contracts (codegen Statements.jet
// jet_codegen_lower_contract_scope). A checked clause is a `require` of its
// condition with its message; a function with contracts has its body in a
// ContractScope whose `pre` clauses run on entry and whose `post` clauses run
// at every return, with the returned carrier (or its success payload) bound
// to `result`.

use jet_foundation.[Span, TContract, TContractResult, TPanicLoc, TPanicLocal, TRequireKind, TStmt]

// An open contract scope: the result binding and the `post` clauses each
// return checks.
struct IRContractFrame { result: TContractResult, post: [TContract] }

// One checked clause (codegen Statements.jet jet_codegen_lower_contract):
// a proven or stripped clause emits nothing. Its report quotes the clause's
// source line (jet_codegen_contract_context).
fn ir_contract(m: &IRModule, p: &IRProgram, b: &IRBuilder, contract: TContract) Never! {
    if contract.disposition != .Check -> return
    if contract.file != b.f.source_file -> return ir_fail(&b, contract.span, "contract source differs from its function source")
    source_line :: ir_source_line_text(p, contract.file, contract.line) ?? return ir_fail(&b, contract.span, "contract line {contract.line} is outside its source")
    site :: b.line
    b.line = contract.line
    location :: TPanicLoc{file: contract.file, source_line: source_line, line: contract.line, column: 0, caret: 0, function: "", locals: [TPanicLocal]{}}
    _ :: ir_require_stop(&m, &p, &b, TRequireKind.Require{cond: contract.condition, msg: Val(contract.message)}, location, false, contract.span)
    b.line = site
}

fn ir_contract_scope(m: &IRModule, p: &IRProgram, b: &IRBuilder, pre: [TContract], body: [TStmt], post: [TContract], result: TContractResult, span: Span) Never! {
    loop contract in pre {
        if ir_failed(b) -> return
        ir_contract(&m, &p, &b, contract)
    }
    &b.contracts.push(IRContractFrame{result: result, post: post})
    ir_stmts(&m, &p, &b, body)
    // The body's own end returns through the scope.
    if !ir_failed(b) -> ir_return_fallthrough(&m, &p, &b)
    _ :: &b.contracts.pop()
}

// The `post` clauses of the innermost scope at a return of the carrier
// `slot` (-1: Unit; codegen jet_codegen_lower_contract_return): `result` is
// the carrier itself, or its Ok/Val payload, and a failed carrier returns
// unchecked.
fn ir_contract_return(m: &IRModule, p: &IRProgram, b: &IRBuilder, slot: Int, span: Span) Never! {
    if b.contracts.len() == 0 -> return
    frame :: b.contracts[b.contracts.len() - 1]
    // A clause's own exits are not contract returns.
    open :: b.contracts
    b.contracts = [IRContractFrame]{}
    mark :: b.bindings.len()
    if frame.result.mode == {
        .Direct -> {
            ir_contract_bind(&b, frame.result, slot)
            ir_contract_posts(&m, &p, &b, frame.post)
        }
        .ResultPayload | .OptionPayload -> {
            if slot < 0 {
                ir_fail(&b, span, "contract return of a payload carrier without a value")
            } else {
                result_mode :: frame.result.mode == .ResultPayload
                present :: if result_mode -> ir_result_is_ok(&m, &b, slot) else -> ir_option_is_some(&m, &b, slot)
                ir_open_if(&b.f, present, b.line)
                binding_row :: ir_value_type(&m, p, frame.result.binding_ty) ?? -1
                payload := -1
                if binding_row >= 0 {
                    offset :: if result_mode -> 8 else -> 0
                    payload = ir_load_at(&m, &b, slot, offset, binding_row)
                }
                ir_contract_bind(&b, frame.result, slot)
                ir_contract_bind_payload(&b, frame.result, payload)
                ir_contract_posts(&m, &p, &b, frame.post)
                ir_end(&b.f, b.line)
            }
        }
    }
    ir_truncate_bindings(&b, mark)
    b.contracts = open
}

fn ir_contract_posts(m: &IRModule, p: &IRProgram, b: &IRBuilder, post: [TContract]) Never! {
    loop contract in post {
        if ir_failed(b) -> return
        ir_contract(&m, &p, &b, contract)
    }
}

// `result`'s carrier variable names the returned `slot` (not owned: the
// return hands it on).
fn ir_contract_bind(b: &IRBuilder, result: TContractResult, slot: Int) Never! {
    if slot < 0 -> return
    local :: result.carrier_local
    symbol :: if local.symbol_id == .Val(id) -> id.key else -> ""
    &b.bindings.push(IRBinding{name: local.name, slot: slot, owned: false, symbol: symbol})
}

fn ir_contract_bind_payload(b: &IRBuilder, result: TContractResult, payload: Int) Never! {
    if payload < 0 -> return
    local :: result.binding_local
    symbol :: if local.symbol_id == .Val(id) -> id.key else -> ""
    &b.bindings.push(IRBinding{name: local.name, slot: payload, owned: false, symbol: symbol})
}
