// The IR builder's `#Pre`/`#Post` contracts. A checked clause tests its
// condition and, when it is false, stops with E3005 and the clause's report;
// a function with contracts has its body in a ContractScope whose `pre`
// clauses run on entry and whose `post` clauses run at every return, with the
// returned carrier (or its success payload) bound to `result`.

use jet_foundation.[Span, Type, BodyContract, TContractResult, TPanicLoc, TPanicLocal]

// An open contract scope: the result binding and the `post` clauses each
// return checks.
IRContractFrame: struct { result: TContractResult, post: [BodyContract] }

// One checked clause: a proven or stripped clause emits nothing. A failed
// clause is the E3005 stop (runtime ordinal 3) whose message is
// `#Pre contract failed: {msg}` or `#Post contract failed: {msg}`, the
// registry row's what. Its report quotes the clause's source line with the
// caret under its span: the callee name of a `#Pre` call site, the clause of
// a `#Post`. In a test image (IRProgram.contract_records) the clause first
// reports whether it held, at its declared site.
ir_contract: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, contract: BodyContract) Never! {
    if contract.disposition != .Check -> return
    if contract.file != b.f.source_file -> return ir_fail(&b, contract.span, "contract source differs from its function source")
    source_line: ir_source_line_text(p, contract.file, contract.line) ?? return ir_fail(&b, contract.span, "contract line {contract.line} is outside its source")
    column: ir_source_column(p, contract.file, contract.span.start) ?? return ir_fail(&b, contract.span, "contract span falls outside its source")
    site: b.line
    b.line = contract.line
    location: TPanicLoc{file: contract.file, source_line: source_line, line: contract.line, column: column, caret: contract.span.end - contract.span.start, function: "", locals: [TPanicLocal]{}}
    report: ir_report_location(p, location)
    condition: ir_expr(&m, p, &b, contract.condition)
    if ir_failed(b) || condition < 0 {
        b.line = site
        return
    }
    bool_row: ir_type_row(&m, Type.Bool) ?? 0
    if p.contract_records && !contract.site.core {
        // A test image reports the clause's outcome at its declared site,
        // `{marker}\t{line}\t{column}\t{file}` (JetRuntime TestContracts.jet).
        // Core's own clauses are its implementation, not the program's claims.
        marker: if contract.kind == .Pre -> "Pre" else -> "Post"
        args := ir_static_text(&m, &b, "{marker}\t{contract.site.line}\t{contract.site.column}\t{contract.site.file}")
        &args.push(condition)
        _: ir_runtime(&m, &b, "jet_rt_test_contract", args, -1)
    }
    failed: ir_temp(&m, &b, bool_row)
    ir_emit(&b.f, IROp.Not, failed, condition, -1, -1, b.line)
    ir_open_if(&b.f, failed, b.line)
    slot: ir_expr(&m, p, &b, contract.message)
    if ir_failed(b) -> return
    message_ty: ir_ty(p, b, contract.message)
    text: ir_render(&m, p, &b, message_ty, slot, IRRender.Display, contract.span)
    if ir_failed(b) -> return
    pointer_row: ir_pointer_row(&m)
    builder: ir_runtime(&m, &b, "jet_rt_string_builder_new", [Int]{}, pointer_row)
    b.fresh[builder] = false
    ir_push_static(&m, &b, builder, if contract.kind == .Pre -> "#Pre contract failed: " else -> "#Post contract failed: ")
    _: ir_runtime(&m, &b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
    string_row: ir_string_row(&m)
    message: ir_runtime(&m, &b, "jet_rt_string_builder_finish", [Int]{builder}, string_row)
    null: ir_word_const(&m, &b, 0)
    ir_stop(&m, p, &b, 3, message, null, null, report)
    ir_end(&b.f, b.line)
    b.line = site
}

ir_contract_scope: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, pre: [BodyContract], body: [Int], post: [BodyContract], result: TContractResult, span: Span) Never! {
    loop contract in pre {
        if ir_failed(b) -> return
        ir_contract(&m, p, &b, contract)
    }
    &b.contracts.push(IRContractFrame{result: result, post: post})
    ir_stmts(&m, p, &b, body)
    // The body's own end returns through the scope.
    if !ir_failed(b) -> ir_return_fallthrough(&m, p, &b)
    _: &b.contracts.pop()
}

// The `post` clauses of the innermost scope at a return of the carrier `slot`
// (-1: Unit): `result` is the carrier itself, or its Ok/Val payload, and a
// failed carrier returns unchecked.
ir_contract_return: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int, span: Span) Never! {
    if b.contracts.len() == 0 -> return
    frame: b.contracts[b.contracts.len() - 1]
    // A clause's own exits are not contract returns.
    open: b.contracts
    b.contracts = [IRContractFrame]{}
    mark: b.bindings.len()
    // The clauses borrow the returned carrier: a test on `result` must not
    // hold it as its own fresh box (ir_hold), or the clause scope would drop
    // the value the return hands on.
    fresh: slot >= 0 && b.fresh[slot]
    if slot >= 0 -> b.fresh[slot] = false
    if frame.result.mode == {
        .Direct -> {
            ir_contract_bind(&m, p, &b, frame.result, slot, span)
            ir_contract_posts(&m, p, &b, frame.post)
        }
        .ResultPayload | .OptionPayload -> {
            if slot < 0 {
                ir_fail(&b, span, "contract return of a payload carrier without a value")
            } else {
                result_mode: frame.result.mode == .ResultPayload
                present: if result_mode -> ir_result_is_ok(&m, &b, slot) else -> ir_option_is_some(&m, &b, slot)
                ir_open_if(&b.f, present, b.line)
                binding_ty: ir_fact(p, &b, frame.result.binding_ty, span)
                binding_row: ir_value_type(&m, p, binding_ty) ?? -1
                payload := -1
                if binding_row >= 0 {
                    payload = if result_mode -> ir_load_at(&m, &b, slot, 8, binding_row) else -> ir_option_payload(&m, &b, slot, binding_row)
                }
                ir_contract_bind(&m, p, &b, frame.result, slot, span)
                ir_contract_bind_payload(&b, frame.result, payload)
                ir_contract_posts(&m, p, &b, frame.post)
                ir_end(&b.f, b.line)
            }
        }
    }
    ir_truncate_bindings(&b, mark)
    if slot >= 0 -> b.fresh[slot] = fresh
    b.contracts = open
}

ir_contract_posts: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, post: [BodyContract]) Never! {
    loop contract in post {
        if ir_failed(b) -> return
        ir_contract(&m, p, &b, contract)
    }
}

// `result`'s carrier variable names the returned `slot` (not owned: the
// return hands it on).
ir_contract_bind: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, result: TContractResult, slot: Int, span: Span) Never! {
    if slot < 0 -> return
    local: result.carrier_local
    _: ir_binder_holds(&m, p, &b, local, slot, span)
    symbol: if local.symbol_id == .Val(id) -> id.key else -> ""
    &b.bindings.push(IRBinding{name: local.name, slot: slot, owned: false, symbol: symbol})
}

ir_contract_bind_payload: fn(b: &IRBuilder, result: TContractResult, payload: Int) Never! {
    if payload < 0 -> return
    local: result.binding_local
    symbol: if local.symbol_id == .Val(id) -> id.key else -> ""
    &b.bindings.push(IRBinding{name: local.name, slot: payload, owned: false, symbol: symbol})
}
