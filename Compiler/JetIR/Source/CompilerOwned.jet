// The compiler-owned records whose fields are typed by the Core record rows
// (Rust compiler_owned_core_record): `FieldError`, the geometry points,
// `DataPivotCell`, `AllocError`, `DataSummary` and the Core records, by
// name, all read in one pass over the rows.
ir_compiler_owned_core_fields: fn() -> [String:[TypeTupleField]] Never! {
    records := [IRCompilerOwnedRecord]{
        {name: "FieldError", fields: [String]{"path", "reason"}},
        {name: "DataPivotCell", fields: [String]{"row_key", "column_key", "count", "sum", "mean"}},
        {name: "AllocError", fields: [String]{"requested_bytes", "allocator"}},
        {name: "DataSummary", fields: [String]{"count", "sum", "mean", "min", "max", "median", "variance", "stddev"}},
    }
    loop name in IR_COMPILER_OWNED_GEOMETRY_POINTS {
        records.push(IRCompilerOwnedRecord{name: name.copy(), fields: [String]{"x", "y"}})
    }
    loop record in IR_COMPILER_OWNED_CORE_RECORDS -> records.push(record.copy())
    owners := [String]{}
    fields := [[String]]{}
    seen := [String:Bool]{}
    loop record in records {
        if seen.get(record.name) != None -> next
        seen[record.name] = true
        owners.push(record.name.copy())
        fields.push(record.fields.copy())
    }
    types: core_record_field_table(owners, fields)
    out := [String:[TypeTupleField]]{}
    loop (k, owner) in owners {
        row := [TypeTupleField]{}
        loop (f, field) in fields[k] {
            ty: types[k][f] ?? panic("missing canonical Core field {owner}.{field}")
            row.push(TypeTupleField{name: field.copy(), ty: ty.copy()})
        }
        // A written marker argument's value: the compiler answers
        // `info.marker(T)` from it, so compile-time code carries it as a host
        // word (ir_comptime_struct); elsewhere the word is 0.
        if owner == "MarkerArgInfo" {
            row.push(TypeTupleField{name: "value", ty: Type.Named{name: IR_MARKER_ARG_VALUE}})
        }
        out[owner] = row
    }
    out
}

// The fields of the compiler-owned record row spelled `name`, written over the
// row's own type parameters (`ir_compiler_owned_generic_params`), or
// None when no such row exists; `core` is ir_compiler_owned_core_fields.
// Rows follow Rust compiler_owned_type_defs:
// `FieldError`, `Range`, the generic Core carriers, the geometry records, the
// keyed-vault records, the data summaries, `AllocError`,
// `VJPRun`, the Core records and the math records. Callers resolve declared
// nominals first, as Rust's rows dedupe by key in favor of declarations.
ir_compiler_owned_record_fields: fn(name: String, core: [String:[TypeTupleField]]) -> [TypeTupleField]? Never! {
    if name == IR_RANGE_RECORD -> return Val(ir_range_record_fields())
    t: Type.Named{name: "T"}
    bytes: Type.List{element: Type.IntN{signed: false, bits: 8}}
    if name == "DataJoin" {
        return Val([TypeTupleField]{TypeTupleField{name: "left", ty: Type.Named{name: "L"}}, TypeTupleField{name: "right", ty: Type.Named{name: "R"}}})
    }
    if name == "Group" {
        return Val([TypeTupleField]{TypeTupleField{name: "key", ty: Type.Named{name: "K"}}, TypeTupleField{name: "value", ty: Type.Named{name: "V"}}})
    }
    if name == "DataSnapshot" {
        return Val([TypeTupleField]{
            {name: "value", ty: t},
            {name: "identity", ty: Type.Named{name: "DataSnapshotIdentity"}},
            {name: "provenance", ty: Type.Named{name: "DataProvenance"}},
            {name: "schema", ty: Type.Named{name: "DataSchema"}},
            {name: "status", ty: Type.Named{name: "DataLoaderStatus"}},
            {name: "content", ty: bytes},
        })
    }
    if name == "Point2" || name == "Delta2" {
        return Val([TypeTupleField]{TypeTupleField{name: "x", ty: t}, TypeTupleField{name: "y", ty: t}})
    }
    if name == "Ray2" {
        space: Type.Named{name: "To"}
        return Val([TypeTupleField]{
            {name: "origin", ty: Type.Apply{name: "Point2", args: [Type]{t, space}}},
            {name: "direction", ty: Type.Apply{name: "Delta2", args: [Type]{t, space}}},
        })
    }
    if name == "Transform" || name == "Transform2" {
        scalar: if name == "Transform" -> Type.Float else -> t
        names: [String]{"m00", "m01", "m10", "m11", "tx", "ty"}
        fields := [TypeTupleField]{}
        loop field in names -> fields.push(TypeTupleField{name: field, ty: scalar})
        return Val(fields)
    }
    if name == "KeyRef" || name == "MutationPlan" || name == "VaultWrite" {
        return Val([TypeTupleField]{})
    }
    if name == "Rotation" {
        key: Type.Apply{name: "KeyRef", args: [Type]{t}}
        return Val([TypeTupleField]{TypeTupleField{name: "previous", ty: key}, TypeTupleField{name: "current", ty: key}})
    }
    if name == "VJPRun" {
        tensor: Type.Named{name: "Tensor"}
        return Val([TypeTupleField]{
            {name: "value", ty: tensor},
            {name: "pull", ty: Type.Fn{params: [Type]{tensor}, ret: Val(t), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}},
            {name: "grads", ty: t},
        })
    }
    if core.get(name) == .Val(fields) -> return Val(fields)
    loop record in IR_COMPILER_OWNED_MATH_RECORDS {
        if record.name != name -> next
        scalar: ir_math_scalar_type(name)
        fields := [TypeTupleField]{}
        loop field in record.fields -> fields.push(TypeTupleField{name: field, ty: scalar.copy()})
        return Val(fields)
    }
    None
}

// The non-generic geometry carriers (Rust COMPILER_OWNED_GEOMETRY_RECORDS
// rows without type parameters); their `x`/`y` types are Core record rows.
IR_COMPILER_OWNED_GEOMETRY_POINTS: #run { [String]{
    "ScreenPoint",
    "WorldPoint",
    "ViewPoint",
    "CameraPoint",
    "DevicePoint",
    "ScreenDelta",
    "WorldDelta",
    "ViewDelta",
    "CameraDelta",
    "DeviceDelta",
} }

// Each field is the type's scalar.
IR_COMPILER_OWNED_MATH_RECORDS: #run { [IRCompilerOwnedRecord]{
    {name: "F32x4", fields: [String]{"x", "y", "z", "w"}},
    {name: "F64x2", fields: [String]{"x", "y"}},
    {name: "Vec2", fields: [String]{"x", "y"}},
    {name: "Vec3", fields: [String]{"x", "y", "z"}},
    {name: "Vec4", fields: [String]{"x", "y", "z", "w"}},
} }

// The carrier record rows of Rust compiler_owned_type_defs between `Range`
// and the Core records (generic Core carriers, geometry, keyed vault,
// data summaries, `AllocError`, `VJPRun`), in program order.
IR_COMPILER_OWNED_CARRIER_RECORDS: #run { [String]{
    "DataJoin",
    "Group",
    "DataSnapshot",
    "Point2",
    "Delta2",
    "ScreenPoint",
    "WorldPoint",
    "ViewPoint",
    "CameraPoint",
    "DevicePoint",
    "ScreenDelta",
    "WorldDelta",
    "ViewDelta",
    "CameraDelta",
    "DeviceDelta",
    "Ray2",
    "Transform",
    "Transform2",
    "KeyRef",
    "MutationPlan",
    "VaultWrite",
    "Rotation",
    "DataPivotCell",
    "AllocError",
    "DataSummary",
    "VJPRun",
} }

// The type parameters of a compiler-owned row (Rust compiler_owned_type_defs
// `generic_params`); empty for every other row.
ir_compiler_owned_generic_params: fn(name: String) -> [String] Never! {
    if name == "HookDecision" || name == "HookOutcome" -> return [String]{"T", "E"}
    if name == "DataJoin" -> return [String]{"L", "R"}
    if name == "Group" -> return [String]{"K", "V"}
    if name == "Point2" || name == "Delta2" -> return [String]{"T", "Space"}
    if name == "Ray2" || name == "Transform2" -> return [String]{"T", "From", "To"}
    if name == "Transform" -> return [String]{"From", "To"}
    if name == "DataSnapshot" || name == "KeyRef" || name == "MutationPlan" || name == "VaultWrite" || name == "Rotation" || name == "VJPRun" {
        return [String]{"T"}
    }
    if name == "DispatchFailure" -> return [String]{"E"}
    [String]{}
}

// One compiler-owned runtime enum: its bare canonical name and its variants
// in declaration order; payloads are `ir_compiler_owned_enum_payload`.
IRCompilerOwnedEnum: struct {
    name: String,
    variants: [String],
}

// Compiler-owned runtime enums (`IOError`, `Dyn`, `Ordering`, ...): enums no
// Core source declares. Each joins every program as one row under its bare
// canonical key, so an enum literal, a variant pattern and the backends name
// the same IR type as the Rust runtime does. A Core-declared enum needs no
// row here: its Core declaration claims the bare name wherever its module is
// loaded. Where its module line lists its cases, that CORE_ENUM_CASE_ROWS row
// stands in when no single declaration is loaded, carrying the family's Core
// payload rows (ir_core_enum_payload), so a program that holds a `Key` or a
// `DataEvent` without loading the declaring module lays it out the same.
IR_COMPILER_OWNED_ENUMS: #run { [IRCompilerOwnedEnum]{
    {name: "HookOutcome", variants: [String]{"Continue", "Cancel", "Fail"}},
    {name: "HookDecision", variants: [String]{"Continue", "Transform", "Cancel", "Fail"}},
    {name: "DispatchFailure", variants: [String]{"Handler", "Panic"}},
    {name: "Ordering", variants: [String]{"Less", "Equal", "Greater"}},
    {name: "RemoveBy", variants: [String]{"Val", "Slot"}},
    {name: "TaskPauseMode", variants: [String]{"WaitPoints", "CheckLoops"}},
    {name: "IOError", variants: [String]{"InvalidInput", "NotFound", "PermissionDenied", "TimedOut", "Canceled", "Closed", "Protocol", "Other", "ResourceLimit", "AlreadyExists", "Unsupported"}},
    {name: "DurationUnit", variants: [String]{"Nanoseconds", "Microseconds", "Milliseconds", "Seconds", "Minutes", "Hours"}},
    {name: "Dyn", variants: [String]{"Null", "Bool", "Int", "Float", "Number", "Text", "Bytes", "DateTime", "Array", "Object"}},
    // The closed reflection detail menus sema types fact reads with
    // (sema_fact_enum_variants): a read `EXACTNESS.kind` or
    // `OBLIGATION.param_contract[0].zone` is a runtime value of these rows.
    {name: "ReflectionKind", variants: [String]{"Effect", "State", "Tag", "Nominal", "Range", "Layout", "Measure", "Dimension", "Classification", "Exactness", "Obligation", "Flow", "Taint", "Duty", "Effects", "States", "Sendability", "ViewProvenance", "Movedness", "Attribution", "Origin", "UnitScaleProvenance", "Maturity"}},
    {name: "ExactnessKind", variants: [String]{"Exact", "Approximate", "Measured"}},
    {name: "ParamZone", variants: [String]{"PositionalOnly", "Either", "LabelOnly"}},
    {name: "ParamAccess", variants: [String]{"Read", "Write", "Move"}},
    {name: "CallingConvention", variants: [String]{"Jet", "Kernel", "Foreign"}},
    {name: "ContributionKind", variants: [String]{"Declaration", "Profile", "Build", "CommandLine"}},
    {name: "CommentKind", variants: [String]{"Line", "Block", "Documentation"}},
    {name: "DeclarationKind", variants: [String]{"Module", "Function", "Method", "Struct", "Enum", "Distinct", "Alias", "Tag", "UnitFamily", "ForeignHandle", "AssociatedType", "Builtin", "Trait", "Impl", "Constant", "Field", "Variant", "Parameter", "Local", "Import", "Foreign", "Label"}},
    {name: "CaptureMode", variants: [String]{"Read", "Write", "Copy", "Materialize", "Move"}},
    {name: "UnitScaleProvenanceKind", variants: [String]{"Rational", "SymbolicPi", "Conventional", "Measured"}},
    // A reflected compile-time value; its payloads are the Core enum rows.
    {name: "PreparedValue", variants: [String]{"Int", "Float", "Bool", "Char", "String", "Enum", "List", "Struct", "Unit"}},
} }

// The payload of one compiler-owned enum variant. A copy of `CasePayload` in
// Core/Prelude/Prelude.jet, in its order (the closed-list mirror ledger):
// edit `CasePayload`, then copy it here.
IRCompilerOwnedPayload: enum {
    Unit,
    Single(ty: Type),
    Named(fields: [TypeTupleField]),
}

ir_compiler_owned_single: fn(ty: Type) -> IRCompilerOwnedPayload Never! {
    IRCompilerOwnedPayload.Single{ty: ty}
}

// The payload of `name.variant` on a COMPILER_OWNED_ENUMS row, written over
// the row's type parameters.
ir_compiler_owned_enum_payload: fn(name: String, variant: String) -> IRCompilerOwnedPayload Never! {
    bytes: Type.List{element: Type.IntN{signed: false, bits: 8}}
    if name == "HookDecision" || name == "HookOutcome" {
        carries_value: if name == "HookDecision" -> "Transform" else -> "Continue"
        if variant == carries_value -> return ir_compiler_owned_single(Type.Named{name: "T"})
        if variant == "Fail" -> return ir_compiler_owned_single(Type.Named{name: "E"})
        return IRCompilerOwnedPayload.Unit
    }
    if name == "DispatchFailure" {
        if variant == "Handler" -> return ir_compiler_owned_single(Type.Named{name: "E"})
        return ir_compiler_owned_single(Type.String)
    }
    if name == "IOError" {
        if variant == "ResourceLimit" {
            return ir_compiler_owned_single(Type.Named{name: "ProcessResourceLimit"})
        }
        return ir_compiler_owned_single(Type.Named{name: "IOContext"})
    }
    // A reflected PreparedValue's cases are the Core payload rows.
    if name == "PreparedValue" -> return ir_core_enum_payload(name, variant)
    if name == "Dyn" {
        if variant == "Bool" -> return ir_compiler_owned_single(Type.Bool)
        if variant == "Int" -> return ir_compiler_owned_single(Type.Int)
        if variant == "Float" -> return ir_compiler_owned_single(Type.Float)
        if variant == "Bytes" -> return ir_compiler_owned_single(bytes)
        if variant == "DateTime" {
            return ir_compiler_owned_single(Type.Named{name: "ZonedDateTime"})
        }
        tree: Type.Named{name: "Dyn"}
        if variant == "Number" || variant == "Text" -> return ir_compiler_owned_single(Type.String)
        if variant == "Array" -> return ir_compiler_owned_single(Type.List{element: tree})
        if variant == "Object" {
            return ir_compiler_owned_single(Type.List{element: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: Type.String}, TypeTupleField{name: "value", ty: tree}}}})
        }
        return IRCompilerOwnedPayload.Unit
    }
    IRCompilerOwnedPayload.Unit
}

// The payload of `name.variant` from the family's Core payload row: its one
// slot, or unit for a unit variant and a family with no rows.
ir_core_enum_payload: fn(name: String, variant: String) -> IRCompilerOwnedPayload Never! {
    payload: core_enum_variant_payload(name, variant) ?? return IRCompilerOwnedPayload.Unit
    if payload.len() == 1 -> return ir_compiler_owned_single(payload[0])
    IRCompilerOwnedPayload.Unit
}
