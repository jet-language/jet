// Backend-neutral lowering from checked semantic types to canonical IR types.
// This is the only Type -> IR type projection; semantic identity and ABI facts
// are retained instead of reconstructed by an emitter.
use jet_foundation.[
    Type,
    TypeTupleField,
    core_enum_variant_payload,
    core_record_field,
    type_name,
]

// The compiler-owned `Range` record a range value constructs. It has no
// source declaration; Codegen adds its row to every program
// (`jet_codegen_compiler_owned_record_definition`) under its bare canonical key.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_type_defs
IR_RANGE_RECORD :: "Range"

fn ir_range_record_fields() -> [TypeTupleField] Never! {
    [TypeTupleField]{
        {name: "start", ty: Type.Int},
        {name: "end", ty: Type.Int},
        {name: "exclusive", ty: Type.Bool},
    }
}

// One compiler-owned Core record: its bare canonical name and the Core record
// oracle's field vocabulary, in row order.
struct IRCompilerOwnedRecord {
    name: String
    fields: [String]
}

// Compiler-owned Core records (`ProcessReceipt`, `IOContext`, ...) are checked
// runtime values with no Jet declaration. Like `Range`, each joins every
// program as one row under its bare canonical key
// (`jet_codegen_compiler_owned_record_definition`), so a field projection on
// one resolves to the same nominal identity as in Rust. Field types are read
// from the Core record rows (`core_record_field`), never guessed. The rows
// carry no `MarkerArgInfo.value` (its type is computed from the policy rule
// argument declarations), so neither does this table.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::COMPILER_OWNED_CORE_RECORDS
IR_COMPILER_OWNED_CORE_RECORDS :: prep { [IRCompilerOwnedRecord]{
