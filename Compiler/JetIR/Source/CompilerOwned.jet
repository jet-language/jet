    {name: "TestComparison", fields: [String]{"status", "relation", "source", "tool", "target", "seed", "case_ids", "inputs", "reference", "candidate", "first_difference", "reason", "universal_proof"}},
    {name: "ProcessReceipt", fields: [String]{"code", "output", "errors", "success", "signal", "timed_out", "executable_identity", "argv", "input_digest", "policy_digest", "backend", "authority", "descendants", "limits", "outputs", "redacted", "pid", "limit_hit", "peak_memory_bytes", "user_cpu_ns", "system_cpu_ns"}},
    {name: "ProcessPlan", fields: [String]{"executable_identity", "argv", "input_digest", "policy_digest", "backend", "authority", "descendants", "limits", "outputs"}},
    {name: "ProcessChild", fields: [String]{"stdin", "stdout", "stderr", "terminal"}},
    {name: "TerminalSize", fields: [String]{"cols", "rows"}},
    {name: "TerminalPolicy", fields: [String]{"size", "mode"}},
    {name: "XMLCanonical", fields: [String]{"mode", "comments", "inclusive_prefixes"}},
    {name: "Size", fields: [String]{"width", "height"}},
    {name: "JSONLWriter", fields: [String]{}},
    {name: "JSONLReader", fields: [String]{}},
    {name: "DirEntry", fields: [String]{"name", "path", "is_dir"}},
    {name: "WalkEntry", fields: [String]{"path", "relative", "is_dir", "depth"}},
    {name: "TempDir", fields: [String]{"path"}},
    {name: "TempFile", fields: [String]{"path"}},
    {name: "FileLock", fields: [String]{"path"}},
    {name: "WatchEvent", fields: [String]{"path", "domain", "kind"}},
    {name: "DataColumn", fields: [String]{"id", "name", "type_name", "nullable"}},
    {name: "DataStatus", fields: [String]{"step", "path", "clone_value", "ownership", "trust", "fallback", "replacement"}},
    {name: "UIFileFilter", fields: [String]{"label", "extensions", "mime_types"}},
    {name: "UIFSGrant", fields: [String]{"root", "rights"}},
