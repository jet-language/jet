    {name: "AssociatedTypeInfo", fields: [String]{"name", "type"}},
    {name: "ConstantInfo", fields: [String]{"name", "trait_name", "type", "value", "identity", "scope"}},
    {name: "GenericBindingInfo", fields: [String]{"name", "type"}},
    {name: "NumericInfo", fields: [String]{"signed", "bits", "is_float"}},
