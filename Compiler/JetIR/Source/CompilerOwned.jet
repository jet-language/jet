// Backend-neutral lowering from checked semantic types to canonical IR types.
// This is the only Type -> IR type projection; semantic identity and ABI facts
// are retained instead of reconstructed by an emitter.
use jet_foundation.[
    IR_MARKER_ARG_VALUE,
    Type,
    TypeTupleField,
    core_enum_variant_payload,
    core_record_field_table,
]

// The compiler-owned `Range` record a range value constructs. It has no
// source declaration; every program has its row under its bare canonical
// key.
IR_RANGE_RECORD: "Range"

ir_range_record_fields: fn() -> [TypeTupleField] Never! {
    [TypeTupleField]{
        {name: "start", ty: Type.Int},
        {name: "end", ty: Type.Int},
        {name: "exclusive", ty: Type.Bool},
    }
}

// One compiler-owned Core record: its bare canonical name and the Core record
// oracle's field vocabulary, in row order.
IRCompilerOwnedRecord: struct {
    name: String,
    fields: [String],
}

// Compiler-owned Core records (`ProcessReceipt`, `IOContext`, ...) are checked
// runtime values with no Jet declaration. Like `Range`, each joins every
// program as one row under its bare canonical key, so a field projection on
// one resolves to that one nominal identity. Field types are read from the
// Core record rows (`core_record_field`), never guessed. The rows carry no
// `MarkerArgInfo.value` (its type is the marker parameter's, so no program
// names it); ir_compiler_owned_core_fields adds it as a host word.
IR_COMPILER_OWNED_CORE_RECORDS: #run { [IRCompilerOwnedRecord]{
    {name: "PluginFrame", fields: [String]{"function", "component", "offset"}},
    {name: "PluginFault", fields: [String]{"export", "message", "frames"}},
    {name: "RangeError", fields: [String]{"reason"}},
    // Core's text failure record (CoreRecordLiteralRow, constructed by
    // Core/Time civil_format_checked): like RangeError a declaration-less
    // record, so its literal and field reads need this row.
    {name: "TextError", fields: [String]{"message"}},
    // String.from_bytes's failure record: a declaration-less record like
    // TextError, so `error.message` needs this row.
    {name: "UTF8Error", fields: [String]{"message"}},
    {name: "IOContext", fields: [String]{"operation", "resource", "os_code", "cause"}},
    {name: "NetErrorDetail", fields: [String]{"operation", "address", "name", "message", "os_code"}},
    {name: "ResolveError", fields: [String]{"kind", "has_os_code", "os_code", "message"}},
    {name: "AsyncPolicy", fields: [String]{"capacity", "overflow"}},
    {name: "CSVRow", fields: [String]{"fields", "line"}},
    {name: "DataLineOptions", fields: [String]{"title", "x_label", "y_label", "markers", "reference", "style", "color", "legend"}},
    {name: "DataLimits", fields: [String]{"encoding", "max_groups", "max_sort_rows", "max_join_rows", "max_output_rows"}},
    {name: "DataSourceIdentity", fields: [String]{"kind", "locator", "member", "parameters"}},
    {name: "DataAuthority", fields: [String]{"scope", "revision"}},
    {name: "DataError", fields: [String]{"kind", "operation", "row", "column", "index", "reason", "cause"}},
    {name: "EncodingCause", fields: [String]{"kind", "os_code", "message"}},
    {name: "EncodingError", fields: [String]{"format", "kind", "byte_offset", "line", "column", "path", "reason", "cause"}},
    {name: "EncodingLimits", fields: [String]{"buffer_bytes", "max_depth", "max_item_bytes", "max_total_bytes", "max_expansion_depth", "max_expansion_bytes"}},
    // Core/Compute's CPU oracle storage record (core-library.md
    // `core.compute`: the registered vocabulary is the sole nominal owner),
    // private to Core like its device, stream and CSR storage (core_only
    // field rows).
    {name: "Tensor", fields: [String]{"shape", "data", "device", "numeric_profile", "requested", "reason", "transfer", "node"}},
    {name: "ComputeDevice", fields: [String]{"name"}},
    {name: "ComputeStream", fields: [String]{"device"}},
    {name: "SparseTensor", fields: [String]{"rows", "cols", "row_ptr", "col_idx", "values"}},
    {name: "CBOROptions", fields: [String]{"max_depth", "max_items", "max_bytes", "require_canonical"}},
    {name: "CBORError", fields: [String]{"kind", "byte_offset", "path", "reason"}},
    {name: "XMLLimits", fields: [String]{"max_depth", "max_nodes", "max_attributes_per_element", "max_name_bytes", "max_text_bytes", "max_entity_declarations", "max_entity_depth", "max_entity_replacement_bytes"}},
    {name: "XMLParseOptions", fields: [String]{"entities", "limits"}},
    {name: "XMLRenderOptions", fields: [String]{"encoding", "lexical"}},
    {name: "XMLCanonical", fields: [String]{"mode", "comments", "inclusive_prefixes"}},
    {name: "XMLError", fields: [String]{"kind", "byte_offset", "line", "column", "path", "reason"}},
    {name: "DataProvenance", fields: [String]{"source", "format", "authority"}},
    {name: "DataSchema", fields: [String]{"identity", "format", "columns", "projection"}},
    {name: "DataSnapshotIdentity", fields: [String]{"id", "source", "content", "schema", "format"}},
    {name: "DataLoaderStatus", fields: [String]{"identity", "freshness", "invalidated_by", "error", "cleanup", "buffered_bytes", "backpressure", "last_good"}},
    {name: "WebTableState", fields: [String]{"sort", "filter", "page_index", "page_size", "selected_keys", "selection_anchor", "focus_key", "page_mode"}},
    {name: "WebTablePage", fields: [String]{"rows", "row_keys", "total_rows", "page_index", "page_size", "page_count"}},
    {name: "WebVirtualPlan", fields: [String]{"total_count", "scroll_offset", "viewport_width", "viewport_height", "estimated_item_size", "overscan", "start", "end", "total_size", "measured_count", "anchor_index", "anchor_offset", "measurements"}},
    {name: "MemoStats", fields: [String]{"hits", "misses", "size", "bound"}},
    {name: "GameScene", fields: [String]{"assets", "input"}},
    {name: "GameFrame", fields: [String]{"index", "input"}},
    {name: "GameAssets", fields: [String]{}},
    {name: "GameInputMap", fields: [String]{}},
