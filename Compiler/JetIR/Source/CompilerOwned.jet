// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_core_record
fn ir_compiler_owned_core_record_fields(record: IRCompilerOwnedRecord) -> [TypeTupleField] Never! {
    fields := [TypeTupleField]{}
    loop field in record.fields {
        ty :: core_record_field(record.name, field) ?? panic("missing canonical Core field {record.name}.{field}")
        &fields.push(TypeTupleField{name: field, ty: ty})
    }
    fields
}

// The fields of the compiler-owned record row spelled `name`, written over the
// row's own type parameters (`ir_compiler_owned_generic_params`), or
// None when no such row exists. Rows follow Rust compiler_owned_type_defs:
// `FieldError`, `Range`, the generic Core carriers, the geometry records, the
// keyed-vault records, the data summaries, `AllocError`,
// `VJPRun`, the Core records and the math records. Callers resolve declared
// nominals first, as Rust's rows dedupe by key in favour of declarations.
fn ir_compiler_owned_record_fields(name: String) -> [TypeTupleField]? Never! {
    if name == IR_RANGE_RECORD -> return Val(ir_range_record_fields())
    t :: Type.Named{name: "T"}
    bytes :: Type.List{element: Type.IntN{signed: false, bits: 8}}
    if name == "FieldError" -> return Val(ir_compiler_owned_core_record_fields(IRCompilerOwnedRecord{name: name, fields: [String]{"path", "reason"}}))
    if name == "DataJoin" -> return Val([TypeTupleField]{TypeTupleField{name: "left", ty: Type.Named{name: "L"}}, TypeTupleField{name: "right", ty: Type.Named{name: "R"}}})
    if name == "Group" -> return Val([TypeTupleField]{TypeTupleField{name: "key", ty: Type.Named{name: "K"}}, TypeTupleField{name: "value", ty: Type.Named{name: "V"}}})
    if name == "DataSnapshot" {
        return Val([TypeTupleField]{
            {name: "value", ty: t},
            {name: "identity", ty: Type.Named{name: "DataSnapshotIdentity"}},
            {name: "provenance", ty: Type.Named{name: "DataProvenance"}},
            {name: "schema", ty: Type.Named{name: "DataSchema"}},
            {name: "status", ty: Type.Named{name: "DataLoaderStatus"}},
            {name: "content", ty: bytes},
        })
    }
    if name == "Point2" || name == "Delta2" -> return Val([TypeTupleField]{TypeTupleField{name: "x", ty: t}, TypeTupleField{name: "y", ty: t}})
    if name == "Ray2" {
        space :: Type.Named{name: "To"}
        return Val([TypeTupleField]{
            {name: "origin", ty: Type.Apply{name: "Point2", args: [Type]{t, space}}},
            {name: "direction", ty: Type.Apply{name: "Delta2", args: [Type]{t, space}}},
        })
    }
    if name == "Transform" || name == "Transform2" {
        scalar :: if name == "Transform" -> Type.Float else -> t
        names :: [String]{"m00", "m01", "m10", "m11", "tx", "ty"}
        fields := [TypeTupleField]{}
        loop field in names -> &fields.push(TypeTupleField{name: field, ty: scalar})
        return Val(fields)
    }
    if IR_COMPILER_OWNED_GEOMETRY_POINTS.contains(name) -> return Val(ir_compiler_owned_core_record_fields(IRCompilerOwnedRecord{name: name, fields: [String]{"x", "y"}}))
    if name == "KeyRef" || name == "MutationPlan" || name == "VaultWrite" -> return Val([TypeTupleField]{})
    if name == "Rotation" {
        key :: Type.Apply{name: "KeyRef", args: [Type]{t}}
        return Val([TypeTupleField]{TypeTupleField{name: "previous", ty: key}, TypeTupleField{name: "current", ty: key}})
    }
    if name == "DataPivotCell" -> return Val(ir_compiler_owned_core_record_fields(IRCompilerOwnedRecord{name: name, fields: [String]{"row_key", "column_key", "count", "sum", "mean"}}))
    if name == "AllocError" -> return Val(ir_compiler_owned_core_record_fields(IRCompilerOwnedRecord{name: name, fields: [String]{"requested_bytes", "allocator"}}))
    if name == "DataSummary" -> return Val(ir_compiler_owned_core_record_fields(IRCompilerOwnedRecord{name: name, fields: [String]{"count", "sum", "mean", "min", "max", "median", "variance", "stddev"}}))
    if name == "VJPRun" {
        tensor :: Type.Named{name: "Tensor"}
        return Val([TypeTupleField]{
            {name: "value", ty: tensor},
            {name: "pull", ty: Type.Fn{params: [Type]{tensor}, ret: Val(t), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}},
            {name: "grads", ty: Type.Fn{params: [Type]{}, ret: Val(t), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}},
        })
    }
    loop record in IR_COMPILER_OWNED_CORE_RECORDS {
        if record.name == name -> return Val(ir_compiler_owned_core_record_fields(record))
    }
    loop record in IR_COMPILER_OWNED_MATH_RECORDS {
        if record.name != name -> next
        scalar :: ir_math_scalar_type(name)
        fields := [TypeTupleField]{}
        loop field in record.fields -> &fields.push(TypeTupleField{name: field, ty: scalar})
        return Val(fields)
    }
    None
}

// The non-generic geometry carriers (Rust COMPILER_OWNED_GEOMETRY_RECORDS
// rows without type parameters); their `x`/`y` types are Core record rows.
IR_COMPILER_OWNED_GEOMETRY_POINTS :: prep { [String]{
    "ScreenPoint", "WorldPoint", "ViewPoint", "CameraPoint", "DevicePoint",
    "ScreenDelta", "WorldDelta", "ViewDelta", "CameraDelta", "DeviceDelta",
} }

// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::COMPILER_OWNED_MATH_RECORDS
// (each field is the type's scalar, Rust `math_scalar_ty`).
IR_COMPILER_OWNED_MATH_RECORDS :: prep { [IRCompilerOwnedRecord]{
    {name: "F32x4", fields: [String]{"x", "y", "z", "w"}},
    {name: "F64x2", fields: [String]{"x", "y"}},
    {name: "Vec2", fields: [String]{"x", "y"}},
    {name: "Vec3", fields: [String]{"x", "y", "z"}},
    {name: "Vec4", fields: [String]{"x", "y", "z", "w"}},
} }

// The carrier record rows of Rust compiler_owned_type_defs between `Range`
// and the Core records (generic Core carriers, geometry, keyed vault,
// data summaries, `AllocError`, `VJPRun`), in program order.
IR_COMPILER_OWNED_CARRIER_RECORDS :: prep { [String]{
    "DataJoin", "Group", "DataSnapshot",
    "Point2", "Delta2", "ScreenPoint", "WorldPoint", "ViewPoint", "CameraPoint", "DevicePoint",
    "ScreenDelta", "WorldDelta", "ViewDelta", "CameraDelta", "DeviceDelta", "Ray2", "Transform", "Transform2",
    "KeyRef", "MutationPlan", "VaultWrite", "Rotation", "DataPivotCell", "AllocError", "DataSummary", "VJPRun",
} }

// The type parameters of a compiler-owned row (Rust compiler_owned_type_defs
// `generic_params`); empty for every other row.
fn ir_compiler_owned_generic_params(name: String) -> [String] Never! {
    if name == "HookDecision" || name == "HookOutcome" -> return [String]{"T", "E"}
    if name == "DataJoin" -> return [String]{"L", "R"}
    if name == "Group" -> return [String]{"K", "V"}
    if name == "Point2" || name == "Delta2" -> return [String]{"T", "Space"}
    if name == "Ray2" || name == "Transform2" -> return [String]{"T", "From", "To"}
    if name == "Transform" -> return [String]{"From", "To"}
    if name == "DataSnapshot" || name == "KeyRef" || name == "MutationPlan" || name == "VaultWrite" || name == "Rotation" || name == "VJPRun" -> return [String]{"T"}
    [String]{}
}

// One compiler-owned runtime enum: its bare canonical name and its variants
// in declaration order; payloads are `ir_compiler_owned_enum_payload`.
struct IRCompilerOwnedEnum {
    name: String
    variants: [String]
}

// Compiler-owned runtime enums (`ProcessStreamMode`, `IOError`, `Key`, ...)
// are checked values with no Jet declaration. Each joins every program as one
// row under its bare canonical key, so an enum literal, a variant pattern and
// the backends name the same IR type as the Rust runtime does.
IR_COMPILER_OWNED_ENUMS :: prep { [IRCompilerOwnedEnum]{
    {name: "Overflow", variants: [String]{"Block", "DropNewest", "DropOldest"}},
    {name: "FailurePolicy", variants: [String]{"StopFirst", "Collect", "Log", "Ignore"}},
    {name: "HookPolicy", variants: [String]{"FirstCancelElseTransform"}},
    {name: "HookOutcome", variants: [String]{"Continue", "Cancel", "Fail"}},
    {name: "HookDecision", variants: [String]{"Continue", "Transform", "Cancel", "Fail"}},
    {name: "DispatchState", variants: [String]{"Delivered", "HandlerFailed", "DroppedNewest", "DroppedOldest", "Closed", "Cancelled", "DeadlineExceeded"}},
    {name: "Ordering", variants: [String]{"Less", "Equal", "Greater"}},
    {name: "RemoveBy", variants: [String]{"Val", "Slot"}},
    {name: "TaskFailure", variants: [String]{"Cancelled", "DeadlineBlown", "Panicked"}},
    {name: "TaskOutcome", variants: [String]{"Finished", "Panicked", "Cancelled", "DeadlineBlown"}},
    {name: "TaskStatus", variants: [String]{"Running", "Paused", "CancelRequested"}},
    {name: "DeliveryState", variants: [String]{"Pending", "Accepted", "Delivering", "Delivered", "DeadLettered", "Cancelled"}},
    {name: "IOError", variants: [String]{"InvalidInput", "NotFound", "PermissionDenied", "TimedOut", "Cancelled", "Closed", "Protocol", "Other", "ResourceLimit", "AlreadyExists", "Unsupported"}},
    {name: "Key", variants: [String]{"Char", "Enter", "Escape", "Backspace", "Tab", "Delete", "Up", "Down", "Left", "Right", "F", "Ctrl", "Unknown"}},
    {name: "IOOperation", variants: [String]{"Read", "Write", "Flush", "Connect", "Accept", "Close", "Resolve", "Codec"}},
    {name: "ProcessResourceLimit", variants: [String]{"WallTime", "CpuTime", "Memory", "OpenFiles", "Output"}},
    {name: "ProcessStreamMode", variants: [String]{"Stream", "Inherit", "Capture"}},
    {name: "TerminalMode", variants: [String]{"Raw", "Cooked"}},
    {name: "DurationUnit", variants: [String]{"Nanoseconds", "Microseconds", "Milliseconds", "Seconds", "Minutes", "Hours"}},
    {name: "FontStyle", variants: [String]{"Body", "Title", "Monospace"}},
    {name: "GlyphShaper", variants: [String]{"HarfBuzz", "HeadlessFallback"}},
    {name: "WebFormValueType", variants: [String]{"String", "Int", "Bool", "Float"}},
    {name: "WebFormControl", variants: [String]{"Text", "Email", "URL", "Password", "Number", "Date", "Checkbox", "Hidden"}},
    {name: "DataLoaderKind", variants: [String]{"File", "URL", "Database", "Value"}},
    {name: "DataErrorKind", variants: [String]{"Decode", "Limit", "IO", "Empty", "InvalidArgument", "NonFinite", "Overflow", "State", "Bridge", "Unsupported", "DuplicateKey", "MissingKey", "WrongOwner", "StaleRevision", "InvalidValue"}},
    {name: "DataFormat", variants: [String]{"CSV", "JSON", "JSONL", "Parquet", "Arrow"}},
    {name: "DataFreshness", variants: [String]{"Pending", "Fresh", "Stale", "Error", "Offline", "Cancelled"}},
    {name: "DataInvalidationCause", variants: [String]{"NoCause", "Loader", "Input", "ArchiveMember", "Parameters", "Credential", "Capability", "Manual"}},
    {name: "Dyn", variants: [String]{"Null", "Bool", "Int", "Float", "Number", "Text", "Bytes", "DateTime", "Array", "Object"}},
    {name: "DataEvent", variants: [String]{"Null", "Bool", "Int", "Float", "Number", "Text", "Bytes", "ArrayStart", "ArrayEnd", "ObjectStart", "Key", "ObjectEnd"}},
    {name: "XMLCanonicalMode", variants: [String]{"Inclusive11", "Exclusive10"}},
    {name: "PluginLimit", variants: [String]{"Fuel", "Memory", "Table", "Time", "Wire"}},
    {name: "PluginError", variants: [String]{"Guest", "Denied", "Budget", "Defect"}},
    {name: "EmailError", variants: [String]{"Configuration", "DNS", "Connect", "TLS", "Auth", "Protocol", "Rejected", "Transient", "TimedOut", "Cancelled", "DeliveryUnknown"}},
    {name: "SMTPSecurity", variants: [String]{"StartTLS", "TLS"}},
    {name: "RecipientPolicy", variants: [String]{"RequireAll", "DeliverAccepted"}},
    {name: "SMTPAuth", variants: [String]{"None", "Password"}},
    {name: "TLSTrust", variants: [String]{"System", "SystemPlusCa"}},
    {name: "TLSVersion", variants: [String]{"TLS12", "TLS13"}},
    {name: "TLSClientTrust", variants: [String]{"System", "SystemPlus", "CustomOnly"}},
    {name: "NetDNSError", variants: [String]{"NotFound", "Failure"}},
    {name: "NetError", variants: [String]{"InvalidInput", "PermissionDenied", "AddressInUse", "AddressUnavailable", "ConnectionRefused", "ConnectionReset", "NotConnected", "Closed", "Timeout", "Cancelled", "Unsupported", "TLS", "Protocol", "Other", "DNS"}},
    {name: "NetShutdown", variants: [String]{"Read", "Write", "Both"}},
    {name: "WatchDomain", variants: [String]{"File", "Process", "Port"}},
    {name: "WatchKind", variants: [String]{"Created", "Modified", "Removed", "Error", "Exited", "Ready"}},
    {name: "NetReadyInterest", variants: [String]{"Read", "Write", "ReadWrite"}},
    {name: "WsError", variants: [String]{"InvalidURL", "InvalidHandshake", "Protocol", "Timeout", "Closed", "Cancelled", "UnsupportedTarget", "MessageTooLarge", "IO"}},
    // The Core lane-reduction enum sema reads from the Core
    // enum payload rows (no Core.jet declaration, no Rust COMPILER_OWNED_ENUMS
    // row: Rust lowers `v.reduce(.Op)` as a marker and never compiles Core
    // math's `reduce(op)`). The runtime pack does, so its `op == .Add` test,
    // its `.Add` literals and its `ReduceOp` parameters need this canonical row.
    {name: "ReduceOp", variants: [String]{"Add", "Mul", "Min", "Max", "Avg"}},
} }

// The payload of one compiler-owned enum variant.
enum IRCompilerOwnedPayload {
    Unit
    Single(ty: Type)
    Named(fields: [TypeTupleField])
}

fn ir_compiler_owned_single(ty: Type) -> IRCompilerOwnedPayload Never! {
    IRCompilerOwnedPayload.Single{ty: ty}
}

fn ir_compiler_owned_named(fields: [TypeTupleField]) -> IRCompilerOwnedPayload Never! {
    IRCompilerOwnedPayload.Named{fields: fields}
}

// The payload of `name.variant` on a COMPILER_OWNED_ENUMS row, written over
// the row's type parameters; a plain Core enum row's variants are all unit.
// Rust: crates/jet-codegen/src/Codegen/TIR/tir_to_mir_types.rs::compiler_owned_type_defs
// (and jet-sema core_net_error_variants for NetError/NetDNSError).
fn ir_compiler_owned_enum_payload(name: String, variant: String) -> IRCompilerOwnedPayload Never! {
    bytes :: Type.List{element: Type.IntN{signed: false, bits: 8}}
    if name == "TaskFailure" || name == "TaskOutcome" {
        if variant == "Panicked" -> return ir_compiler_owned_single(Type.String)
        return IRCompilerOwnedPayload.Unit
    }
    if name == "HookDecision" || name == "HookOutcome" {
        carries_value :: if name == "HookDecision" -> "Transform" else -> "Continue"
        if variant == carries_value -> return ir_compiler_owned_single(Type.Named{name: "T"})
        if variant == "Fail" -> return ir_compiler_owned_single(Type.Named{name: "E"})
        return IRCompilerOwnedPayload.Unit
    }
    if name == "DataEvent" {
        if variant == "Bool" -> return ir_compiler_owned_single(Type.Bool)
        if variant == "Int" -> return ir_compiler_owned_single(Type.Int)
        if variant == "Float" -> return ir_compiler_owned_single(Type.Float)
        if variant == "Number" || variant == "Text" || variant == "Key" -> return ir_compiler_owned_single(Type.String)
        if variant == "Bytes" -> return ir_compiler_owned_single(Type.List{element: Type.IntN{signed: false, bits: 8}})
        return IRCompilerOwnedPayload.Unit
    }
    if name == "WsError" {
        if variant == "MessageTooLarge" -> return ir_compiler_owned_named([TypeTupleField]{TypeTupleField{name: "limit", ty: Type.Int}})
        if variant == "IO" -> return ir_compiler_owned_named([TypeTupleField]{TypeTupleField{name: "operation", ty: Type.String}})
        return IRCompilerOwnedPayload.Unit
    }
    if name == "IOError" {
        if variant == "ResourceLimit" -> return ir_compiler_owned_single(Type.Named{name: "ProcessResourceLimit"})
        return ir_compiler_owned_single(Type.Named{name: "IOContext"})
    }
    if name == "Key" {
        if variant == "Char" || variant == "Ctrl" -> return ir_compiler_owned_single(Type.Char)
        if variant == "F" -> return ir_compiler_owned_single(Type.Int)
        return IRCompilerOwnedPayload.Unit
    }
    if name == "PluginError" {
        if variant == "Budget" -> return ir_compiler_owned_named([TypeTupleField]{TypeTupleField{name: "limit", ty: Type.Named{name: "PluginLimit"}}, TypeTupleField{name: "fault", ty: Type.Named{name: "PluginFault"}}})
        return ir_compiler_owned_single(Type.Named{name: "PluginFault"})
    }
    if name == "EmailError" {
        return ir_compiler_owned_named([TypeTupleField]{
            {name: "operation", ty: Type.String},
            {name: "server", ty: Type.Option{inner: Type.String}},
            {name: "code", ty: Type.Option{inner: Type.Int}},
            {name: "reason", ty: Type.String},
        })
    }
    if name == "SMTPAuth" && variant == "Password" -> return ir_compiler_owned_named([TypeTupleField]{TypeTupleField{name: "username", ty: Type.String}, TypeTupleField{name: "password", ty: Type.Named{name: "Secret"}}})
    if name == "TLSTrust" && variant == "SystemPlusCa" -> return ir_compiler_owned_named([TypeTupleField]{TypeTupleField{name: "pem", ty: bytes}})
    if name == "TLSClientTrust" {
        if variant == "SystemPlus" || variant == "CustomOnly" -> return ir_compiler_owned_single(Type.Named{name: "TLSRootCertificates"})
        return IRCompilerOwnedPayload.Unit
    }
    // The canonical twelve DataEvent payloads are the
    // generated Core payload rows (Rust core_types.rs data_event_payload).
    if name == "DataEvent" {
        payload :: core_enum_variant_payload(name, variant) ?? return IRCompilerOwnedPayload.Unit
        if payload.len() == 1 -> return ir_compiler_owned_single(payload[0])
        return IRCompilerOwnedPayload.Unit
    }
    if name == "Dyn" {
        if variant == "Bool" -> return ir_compiler_owned_single(Type.Bool)
        if variant == "Int" -> return ir_compiler_owned_single(Type.Int)
        if variant == "Float" -> return ir_compiler_owned_single(Type.Float)
        if variant == "Bytes" -> return ir_compiler_owned_single(bytes)
        if variant == "DateTime" -> return ir_compiler_owned_single(Type.Named{name: "ZonedDateTime"})
        tree :: Type.Named{name: "Dyn"}
        if variant == "Number" || variant == "Text" -> return ir_compiler_owned_single(Type.String)
        if variant == "Array" -> return ir_compiler_owned_single(Type.List{element: tree})
        if variant == "Object" -> return ir_compiler_owned_single(Type.List{element: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: Type.String}, TypeTupleField{name: "value", ty: tree}}}})
        return IRCompilerOwnedPayload.Unit
    }
    if name == "NetDNSError" -> return ir_compiler_owned_single(Type.String)
    if name == "NetError" {
        if variant == "DNS" -> return ir_compiler_owned_single(Type.Named{name: "NetDNSError"})
        return ir_compiler_owned_single(Type.Named{name: "NetErrorDetail"})
    }
    IRCompilerOwnedPayload.Unit
}
