    {name: "TypeInfo", fields: [String]{"name", "path", "module", "identity", "kind", "layout", "fields", "methods", "type_params", "markers", "expanded_markers", "traits", "constants", "generic_bindings", "numeric", "states", "transitions", "facts", "dimensions", "span", "base", "location", "documentation", "cases"}},
    {name: "LayoutInfo", fields: [String]{"kind", "target", "guarantee", "source", "size", "alignment", "stride", "requested_alignment", "effective_alignment", "fields"}},
