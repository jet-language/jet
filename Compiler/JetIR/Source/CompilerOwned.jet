    {name: "CaseInfo", fields: [String]{"name", "path", "index", "wire_name", "payload", "discriminant", "markers", "span", "location", "documentation"}},
    // `meta.add_struct`'s field, which a build writes as a record literal.
    {name: "CompilerField", fields: [String]{"name", "type"}},
    {name: "DefaultInfo", fields: [String]{"source"}},
    {name: "ParamInfo", fields: [String]{"name", "label", "zone", "type", "access", "default", "variadic"}},
    {name: "TypeParamInfo", fields: [String]{"name", "bounds", "span"}},
