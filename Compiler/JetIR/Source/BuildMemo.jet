// `#Memo` result caching (D-MEMO1=A; A memoized function keeps its results in a
// store of entries, most recently used first, at most its bound
// (FnBody.memo_bound; memo_unbounded: none). An entry is a heap block holding
// copies of the arguments (receiver first), then a copy of the result. On entry
// the arguments are compared with each entry's under the store's lock: a hit
// moves the entry first and returns a copy of its result without running the
// body; a miss opens an entry with copies of the arguments, and each return of
// the body files a copy of its result there (ir_memo_file), dropping the entry
// the bound evicts. The runtime (JetRuntime Memo.jet) only orders and counts
// the entry pointers; the layout, comparison, copies and drops are built here.
// The store is the function's zeroed static cell. No stop check runs while the
// lock is held: a stop the comparison publishes is taken at the next check
// after unlock.

use jet_foundation.[DeclID, FnBody, Span, Type, decl_id_index, name_rows_set, name_rows_value]

IR_MEMO_CELL_BYTES: 48

// Opens the store of a memoized `function` once its parameters are bound and
// its result row is known: the hit path returns, the miss path goes on into
// the body with b.memo set. Nothing for a function that is not memoized.
ir_memo_enter: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, function: FnBody) Never! {
    bound := -1
    if function.memo_bound == .Val(limit) {
        bound = limit
    } else if !function.memo_unbounded {
        return
    }
    span: function.source_span
    result_row: b.f.result
    rows := [Int]{}
    offsets := [Int]{}
    keys := [Int]{}
    size := 0
    loop binding in b.bindings {
        if binding.indirect >= 0 || binding.write -> return ir_fail(b, span, "memo key through the write parameter {binding.name}")
        row: b.f.slot_type[binding.slot]
        rows.push(row)
        offsets.push(size)
        keys.push(binding.slot)
        size += ir_align8(m.types[row].size)
    }
    value_offset: size
    if result_row >= 0 -> size += ir_align8(m.types[result_row].size)
    if size == 0 -> size = 8
    key: b.f.key.copy()
    cell: ir_memo_cell(m, b, key)
    word_row: ir_word_row(m)
    stopping: b.stopping
    b.stopping = true
    _: ir_runtime(m, b, "jet_rt_memo_lock", [Int]{cell}, -1)
    count: ir_runtime(m, b, "jet_rt_memo_len", [Int]{cell}, word_row)
    index: ir_word_const(m, b, 0)
    one: ir_word_const(m, b, 1)
    missed: ir_open(b.f, IROp.Block, b.line)
    _: ir_open(b.f, IROp.Loop, b.line)
    more: ir_bool_op(m, b, IROp.Lt, index, count)
    ir_exit_unless(m, b, more, missed)
    entry: ir_runtime(m, b, "jet_rt_memo_entry", [Int]{cell, index}, word_row)
    differ: ir_open(b.f, IROp.Block, b.line)
    loop at in 0..<keys.len() {
        stored: ir_load_at(m, b, entry, offsets[at], rows[at])
        if stored >= 0 -> ir_equal_into(m, p, b, rows[at], keys[at], stored, differ, true, span)
    }
    if ir_failed(b) -> return
    _: ir_runtime(m, b, "jet_rt_memo_hit", [Int]{cell, index}, -1)
    result := -1
    if result_row >= 0 {
        stored: ir_load_at(m, b, entry, value_offset, result_row)
        if stored >= 0 -> result = ir_copy_value(m, p, b, stored, span)
    }
    _: ir_runtime(m, b, "jet_rt_memo_unlock", [Int]{cell}, -1)
    b.stopping = stopping
    ir_emit_return(m, b, result)
    ir_end(b.f, b.line)
    ir_emit(b.f, IROp.Add, index, index, one, IR_OVERFLOW_WRAP, b.line)
    ir_emit(b.f, IROp.Br, -1, 0, -1, -1, b.line)
    ir_end(b.f, b.line)
    // The scan ran past the last entry: the miss path follows `missed`.
    ir_end(b.f, b.line)
    b.stopping = true
    _: ir_runtime(m, b, "jet_rt_memo_miss", [Int]{cell}, -1)
    _: ir_runtime(m, b, "jet_rt_memo_unlock", [Int]{cell}, -1)
    b.stopping = stopping
    bytes: ir_word_const(m, b, size)
    align: ir_word_const(m, b, 8)
    opened: ir_runtime(m, b, "jet_rt_alloc", [Int]{bytes, align}, word_row)
    loop at in 0..<keys.len() {
        if m.types[rows[at]].kind == .Unit -> next
        duplicate: ir_copy_value(m, p, b, keys[at], span)
        ir_store_at(m, p, b, opened, offsets[at], duplicate)
    }
    b.memo = Val(IRMemo{cell: cell, entry: opened, rows: rows, offsets: offsets, value_offset: value_offset, size: size, bound: bound})
}

// The slot holding the address of the store cell of the function keyed
// `key`, a zeroed writable static object (Memo.jet's [mutex, count,
// capacity, entries, hits, misses]) per function instance.
ir_memo_cell: fn(m: &IRModule, b: &IRBuilder, key: String) -> Int Never! {
    object_key: "memo:{key}"
    object := name_rows_value(m.constant_rows, object_key) ?? -1
    if object < 0 {
        object = m.data.len()
        cell := [U8]{}
        loop _ in 0..<IR_MEMO_CELL_BYTES -> cell.push(U8{0})
        m.data.push(cell)
        // No address words; the entry marks a word-aligned static object.
        m.data_relocs[object] = [IRDataReloc]{}
        name_rows_set(m.constant_rows, object_key, object)
    }
    pointer_row: ir_pointer_row(m)
    address: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.DataAddress, address, object, -1, -1, b.line)
    address
}

// `name.cache()` (THostCall.MemoStats): the `MemoStats` record of the
// memoized `function`'s store, with its written bound ("128", "none"). The
// runtime answers a `JetMemoStats` record handle, which crosses into the
// program's layout like any route's handle result (ir_route_plain).
ir_memo_stats: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, function: DeclID, bound: String, span: Span) -> Int Never! {
    row: ir_decl_row(p, function)
    if row < 0 -> return ir_fail_slot(b, span, "memo statistics of a function (declaration {decl_id_index(function)}) outside the checked program")
    cell: ir_memo_cell(m, b, p.functions[row].key)
    string_row: ir_string_row(m)
    text: ir_temp(m, b, string_row)
    ir_emit(b.f, IROp.ConstText, text, ir_intern_text(m, bound), -1, -1, b.line)
    ir_route_plain(m, p, b, "jet_rt_memo_stats", [Int]{cell, text}, IRRouteCarrier.Handle{name: "MemoStats"}, ty, span)
}

// A return of `slot` (-1: nothing) from a memoized body: a copy of the result
// goes into the entry the miss opened, the entry is filed first in the store,
// and the entry the bound evicts is dropped. Nothing outside a memoized body.
ir_memo_file: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, slot: Int, span: Span) Never! {
    memo: b.memo ?? return
    result_row: b.f.result
    slot_row: if slot >= 0 -> b.f.slot_type[slot] else -> -1
    if slot >= 0 && slot_row != result_row -> return ir_fail(b, span, "memo result of type row {slot_row}, not the function's result row {result_row}")
    if slot >= 0 && m.types[result_row].kind != .Unit {
        duplicate: ir_copy_value(m, p, b, slot, span)
        ir_store_at(m, p, b, memo.entry, memo.value_offset, duplicate)
    }
    word_row: ir_word_row(m)
    stopping: b.stopping
    b.stopping = true
    _: ir_runtime(m, b, "jet_rt_memo_lock", [Int]{memo.cell}, -1)
    bound: ir_word_const(m, b, memo.bound)
    evicted: ir_runtime(m, b, "jet_rt_memo_file", [Int]{memo.cell, memo.entry, bound}, word_row)
    _: ir_runtime(m, b, "jet_rt_memo_unlock", [Int]{memo.cell}, -1)
    b.stopping = stopping
    zero: ir_word_const(m, b, 0)
    some: ir_bool_op(m, b, IROp.Ne, evicted, zero)
    ir_open_if(b.f, some, b.line)
    loop at in 0..<memo.rows.len() {
        row: memo.rows[at]
        if m.types[row].drop == "" -> next
        stored: ir_load_at(m, b, evicted, memo.offsets[at], row)
        ir_emit(b.f, IROp.Drop, -1, stored, -1, -1, b.line)
    }
    if result_row >= 0 && m.types[result_row].drop != "" {
        stored: ir_load_at(m, b, evicted, memo.value_offset, result_row)
        ir_emit(b.f, IROp.Drop, -1, stored, -1, -1, b.line)
    }
    bytes: ir_word_const(m, b, memo.size)
    align: ir_word_const(m, b, 8)
    _: ir_runtime(m, b, "jet_rt_free", [Int]{evicted, bytes, align}, -1)
    ir_end(b.f, b.line)
}
