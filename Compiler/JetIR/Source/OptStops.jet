// Stop points right after their calls (O1, O2, last): a stop point
// (Build.jet ir_stop_point) after a direct call, or a call through a
// function value, whose argument temporaries are dropped between the two,
//
//     r := g(t); drop t; stopped := poll(); if stopped { E }
//
// becomes
//
//     r := g(t); stopped := poll(); if stopped { drop t; E }; drop t
//
// so the poll follows its call and the selector tests the stop g reports
// in edx instead of calling the poll (X64Select ir_x64_stop_point). A turn
// poll (an entry check or a loop's turn folded into the call's poll,
// ir_opt_fold_polls) moves the same way. Only
// drops of Int and word slots move (no code of theirs can publish or mask
// a stop), and only into an edge E that never comes back
// (OptUnique.jet ir_opt_dead_end), so each path drops once.
use jet_foundation.[CompilerThreads, Type, compiler_take_rows, compiler_threads_admit, compiler_threads_joined, compiler_threads_partition, compiler_transfer_rows, name_intern]

ir_opt_stops_after_calls: fn(f: ^IRFunction, m: IRModule, keys: [String]) Never! {
    poll := ir_interned_name(m, IR_STOP_POLL_KEY) ?? -1
    turn := ir_interned_name(m, IR_STOP_TURN_KEY) ?? -1
    if poll < 0 && turn < 0 {
        poll = ir_keyed_function(m, IR_STOP_POLL_KEY) ?? -1
        turn = ir_keyed_function(m, IR_STOP_TURN_KEY) ?? -1
        if poll < 0 && turn < 0 {
            return
        }
    }
    count: f.op.len()
    // A moved call's poll (-1: none), and the call whose drops follow each End.
    poll_of := [Int]{}
    after := [Int]{}
    moved := false
    loop site in 0..<count {
        if f.op[site] != .Call && f.op[site] != .CallIndirect -> next
        k := site + 1
        loop k < count && f.op[k] == .Drop && ir_opt_stops_plain(m, f, f.a[k]) -> k += 1
        if k == site + 1 || !ir_opt_stops_any_poll(f, poll, turn, k) -> next
        if ir_opt_dead_end(f, k + 1) < 0 -> next
        if !moved {
            poll_of.try_reserve(count) ?? ()
            after.try_reserve(count) ?? ()
            loop _ in 0..<count {
                poll_of.push(-1)
                after.push(-1)
            }
            moved = true
        }
        poll_of[site] = k
        after[f.c[k + 1]] = site
    }
    if !moved {
        return
    }
    code := IROptCode{op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, line: [Int]{}}
    at := 0
    loop at < count {
        ir_opt_code_put(code, f.op[at], f.dst[at], f.a[at], f.b[at], f.c[at], f.code_line[at])
        if after[at] >= 0 -> ir_opt_stops_drops(code, f, after[at] + 1, poll_of[after[at]])
        poll_at: poll_of[at]
        if poll_at < 0 {
            at += 1
            next
        }
        // The poll, its If, then the drops at the start of the edge.
        loop k in poll_at..<(poll_at + 2) {
            ir_opt_code_put(code, f.op[k], f.dst[k], f.a[k], f.b[k], f.c[k], f.code_line[k])
        }
        ir_opt_stops_drops(code, f, at + 1, poll_at)
        at = poll_at + 2
    }
    f.op = code.op.move()
    f.dst = code.dst.move()
    f.a = code.a.move()
    f.b = code.b.move()
    f.c = code.c.move()
    f.code_line = code.line.move()
    ir_opt_compact(f)
}

// Whether `slot` is an Int or word slot.
ir_opt_stops_plain: fn(m: IRModule, f: IRFunction, slot: Int) -> Bool Never! {
    if slot < 0 || slot >= f.slot_type.len() -> return false
    kind: m.types[f.slot_type[slot]].kind
    kind == .Int || kind == .Word
}

// Whether `at` is `stopped := poll()` followed by `if stopped` with no Else.
ir_opt_stops_poll: fn(f: IRFunction, keys: [String], at: Int) -> Bool Never! {
    if at + 1 >= f.op.len() || f.op[at] != .Call || f.c[at] != 0 || f.dst[at] < 0 -> return false
    callee: f.a[at]
    if callee < 0 || callee >= keys.len() || keys[callee] != IR_STOP_POLL_KEY -> return false
    f.op[at + 1] == .If && f.a[at + 1] == f.dst[at] && f.b[at + 1] < 0
}

// Whether `at` is `stopped := poll()` or `stopped := turn()` followed by
// `if stopped` with no Else.
ir_opt_stops_point: fn(f: IRFunction, keys: [String], at: Int) -> Bool Never! {
    if at + 1 >= f.op.len() || f.op[at] != .Call || f.c[at] != 0 || f.dst[at] < 0 -> return false
    callee: f.a[at]
    if callee < 0 || callee >= keys.len() -> return false
    if keys[callee] != IR_STOP_POLL_KEY && keys[callee] != IR_STOP_TURN_KEY -> return false
    f.op[at + 1] == .If && f.a[at + 1] == f.dst[at] && f.b[at + 1] < 0
}

// Whether `at` is a call of the stop or turn poll (functions `poll` and
// `turn`) followed by `if stopped` with no Else.
ir_opt_stops_any_poll: fn(f: IRFunction, poll: Int, turn: Int, at: Int) -> Bool Never! {
    if at + 1 >= f.op.len() || f.op[at] != .Call || f.c[at] != 0 || f.dst[at] < 0 -> return false
    callee: f.a[at]
    if callee < 0 || (callee != poll && callee != turn) -> return false
    f.op[at + 1] == .If && f.a[at + 1] == f.dst[at] && f.b[at + 1] < 0
}

ir_opt_stops_drops: fn(code: ^IROptCode, f: IRFunction, start: Int, end: Int) Never! {
    loop k in start..<end {
        ir_opt_code_put(code, f.op[k], f.dst[k], f.a[k], f.b[k], f.c[k], f.code_line[k])
    }
}

// Stop edges handed off (O1, O2, after the polls fold): inside a construct
// (the Block an inlined body leaves), a stop point's edge that only drops
// and branches to the construct's End hands its stop on to the stop or
// turn poll after that End (past the drops there), whose own edge E never
// comes back:
//
//     block { r := g(t); s := poll(); if s { drop t; br 1 } ... }
//     drop c; stopped := poll(); if stopped { E }
//
// The edge takes the drops and E itself instead of branching:
//
//     block { r := g(t); s := poll(); if s { drop t; drop c; E } ... }
//     drop c; stopped := poll(); if stopped { E }
//
// A delivered stop stays until a boundary takes it, so the later poll
// would have taken it into E after the same drops: each path does what it
// did. With no stop handed on (ir_opt_polls_hands_on), the later poll
// checks only what came before the construct (ir_opt_polls_checked), and
// where that is no call that can stop, the selector tests the armed word
// inline instead of calling the poll (X64Select.jet ir_x64_stop_point).
// An edge inside a loop within the construct keeps its branch: the loop's
// exits stay as the module passes after (Opt.jet ir_optimize_module's
// entry versions, OptReduce.jet) read them, so a loop they left alone
// before stays so.
ir_opt_stops_hand_off: fn(f: ^IRFunction, m: IRModule) Never! {
    poll: ir_interned_name(m, IR_STOP_POLL_KEY) ?? -1
    turn: ir_interned_name(m, IR_STOP_TURN_KEY) ?? -1
    if poll < 0 && turn < 0 {
        return
    }
    trap: ir_interned_name(m, IR_STOP_TRAP_KEY) ?? -1
    count: f.op.len()
    // The poll whose drops and edge replace each handing Br (-1: none).
    into := [Int]{}
    handed := false
    loop at in 0..<count {
        if !ir_opt_stops_any_poll(f, poll, turn, at) || ir_opt_dead_end(f, at + 1) < 0 -> next
        end: ir_opt_stops_before_drops(f, at)
        if end < 0 || f.op[end] != .End -> next
        edge := f.a[end]
        loop edge < end {
            if f.op[edge] == .Loop {
                edge = f.a[edge] + 1
                next
            }
            br: ir_opt_stops_handing(f, poll, trap, turn, edge, end)
            if br >= 0 {
                if !handed {
                    into.try_reserve(count) ?? ()
                    loop _ in 0..<count -> into.push(-1)
                    handed = true
                }
                into[br] = at
            }
            edge += 1
        }
    }
    if !handed {
        return
    }
    code := IROptCode{op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, line: [Int]{}}
    loop at in 0..<count {
        target: into[at]
        if target < 0 {
            ir_opt_code_put(code, f.op[at], f.dst[at], f.a[at], f.b[at], f.c[at], f.code_line[at])
            next
        }
        ir_opt_stops_drops(code, f, ir_opt_stops_before_drops(f, target) + 1, target)
        ir_opt_stops_edge_copy(code, f, target + 2, f.c[target + 1])
    }
    f.op = code.op.move()
    f.dst = code.dst.move()
    f.a = code.a.move()
    f.b = code.b.move()
    f.c = code.c.move()
    f.code_line = code.line.move()
    ir_opt_compact(f)
}

// The last instruction before `at` that is no Drop, or -1.
ir_opt_stops_before_drops: fn(f: IRFunction, at: Int) -> Int Never! {
    k := at - 1
    loop k >= 0 && f.op[k] == .Drop -> k -= 1
    k
}

// Instructions `start` to `end` of `f` into `code`, a second copy of a stop
// edge that stays where it is: each call gets operands of its own in `f`'s
// args pool, as no two calls share one entry (the SSA form maps each
// entry's read to one value, Ssa.jet IRSsa.use_args).
ir_opt_stops_edge_copy: fn(code: ^IROptCode, f: ^IRFunction, start: Int, end: Int) Never! {
    loop k in start..<end {
        op: f.op[k]
        b := f.b[k]
        if op == .Call || op == .CallRuntime || op == .CallIndirect {
            b = f.args.len()
            loop index in f.b[k]..<(f.b[k] + f.c[k]) {
                operand: f.args[index]
                f.args.push(operand)
            }
        }
        ir_opt_code_put(code, op, f.dst[k], f.a[k], b, f.c[k], f.code_line[k])
    }
}

// The Br of the stop edge at `edge` (an If, with no Else, on what a stop,
// trap or turn poll just returned) when the edge only drops and then
// branches to the End at `end`; else -1.
ir_opt_stops_handing: fn(f: IRFunction, poll: Int, trap: Int, turn: Int, edge: Int, end: Int) -> Int Never! {
    if edge == 0 || f.op[edge] != .If || f.b[edge] >= 0 || f.op[edge - 1] != .Call -> return -1
    callee: f.a[edge - 1]
    if callee < 0 || (callee != poll && callee != trap && callee != turn) || f.a[edge] != f.dst[edge - 1] {
        return -1
    }
    br: f.c[edge] - 1
    if br <= edge || f.op[br] != .Br -> return -1
    loop k in (edge + 1)..<br {
        if f.op[k] != .Drop -> return -1
    }
    if ir_opt_polls_br_end(f, br, f.a[br]) == end -> br else -> -1
}

// Stop facts (O1, O2, over the module once every body is optimized). A
// body reports a stop to its caller (edx, X64Select ir_x64_stop_point) only
// from a stop edge or a slow path that publishes a stop. A body that starts
// none (ir_opt_stops_starts), whose calls of bodies all reach bodies that
// report none either, never reports one: the stop points right after calls
// of it go, so its callers neither test edx there nor lay out the edge.
// Each body's scan (the bodies it calls, whether it starts a stop) and,
// once the reports are known, its removals read only its own instructions,
// so the functions split into consecutive parts (compiler_threads_partition
// by size) for both, one thread each, that read the keys, bodies and reports
// and own their part; the reports are found between the two walks on the
// calling thread, over the scans in function order.
ir_opt_stop_facts: fn(m: IRModule, functions: ^[IRFunction], threads: CompilerThreads) Never! {
    count: functions.len()
    keys := [String]{}
    bodies := [Bool]{}
    weights := [Int]{}
    total := 0
    loop f in functions {
        keys.push(f.key.copy())
        bodies.push(f.asm == None && !ir_stop_key(f.key))
        weights.push(1 + f.op.len())
        total += 1 + f.op.len()
    }
    workers: compiler_threads_admit(threads, count, total, IR_OPT_MIN_INSTRUCTIONS_PER_THREAD, 0, 0)
    if workers <= 1 {
        scan := ir_opt_stops_scan_new()
        loop id in 0..<count -> ir_opt_stops_scan(m, functions[id], id, keys, bodies, scan)
        reports: ir_opt_stops_reports(scan)
        loop id in 0..<count {
            if bodies[id] -> ir_opt_stops_unreported(functions[id], keys, bodies, reports)
        }
        return
    }
    bounds: compiler_threads_partition(weights, workers)
    // Parts leave the list last-first: part `workers - 1` pops first.
    parts := [IROptStopsPart]{}
    part := workers - 1
    loop part >= 0 {
        rows := [IRFunction]{}
        loop functions.len() > bounds[part] {
            row: functions.pop() ?? break
            rows.push(row)
        }
        rows.reverse()
        parts.push(IROptStopsPart{functions: rows.move(), start: bounds[part], scan: ir_opt_stops_scan_new()})
        part -= 1
    }
    parts.reverse()
    // The scans, then the removals.
    parts = ir_opt_stops_walks(m, keys, bodies, [Bool]{}, parts.move())
    reports: ir_opt_stops_reported(parts)
    parts = ir_opt_stops_walks(m, keys, bodies, reports, parts.move())
    loop at in 0..<parts.len() {
        functions.extend(compiler_take_rows<IRFunction>(parts[at].functions))
    }
}

// Per function in order, whether it starts a stop and the bodies it calls
// (calls[ends[id - 1]..<ends[id]], from 0 for the first).
IROptStopsScan: struct {
    starts: [Bool],
    calls: [Int],
    ends: [Int],
}

ir_opt_stops_scan_new: fn() -> IROptStopsScan Never! {
    IROptStopsScan{starts: [Bool]{}, calls: [Int]{}, ends: [Int]{}}
}

// Appends function `f`, function `id`, to `scan`.
ir_opt_stops_scan: fn(m: IRModule, f: IRFunction, id: Int, keys: [String], bodies: [Bool], scan: ^IROptStopsScan) Never! {
    body: bodies[id]
    if body {
        loop at in 0..<f.op.len() {
            if f.op[at] != .Call -> next
            callee: f.a[at]
            if callee >= 0 && callee < bodies.len() && bodies[callee] -> scan.calls.push(callee)
        }
    }
    scan.starts.push(body && ir_opt_stops_starts(m, f, keys, bodies))
    scan.ends.push(scan.calls.len())
}

// Per function whether it reports a stop: it starts one, or it calls a
// body that reports one.
ir_opt_stops_reports: fn(scan: IROptStopsScan) -> [Bool] Never! {
    count: scan.starts.len()
    // Per body the bodies that call it.
    callers := [[Int]]{}
    reports := [Bool]{}
    loop _ in 0..<count {
        callers.push([Int]{})
        reports.push(false)
    }
    work := [Int]{}
    from := 0
    loop id in 0..<count {
        loop k in from..<scan.ends[id] -> callers[scan.calls[k]].push(id)
        from = scan.ends[id]
        if scan.starts[id] {
            reports[id] = true
            work.push(id)
        }
    }
    loop work.len() > 0 {
        callee: work.pop() ?? {
            break
        }
        loop caller in callers[callee] {
            if reports[caller] -> next
            reports[caller] = true
            work.push(caller)
        }
    }
    reports
}

// The functions of one thread of ir_opt_stop_facts, in order, from
// function `start`, and their scan.
IROptStopsPart: struct {
    functions: [IRFunction],
    start: Int,
    scan: IROptStopsScan,
}

// Walks `parts` (ir_opt_stops_part), in part order: the last part on its
// own thread, the ones before it the same way, and the first on this one.
ir_opt_stops_walks: fn(m: IRModule, keys: [String], bodies: [Bool], reports: [Bool], parts: ^^[IROptStopsPart]) -> [IROptStopsPart] Never! {
    rest := parts.move()
    last: rest.pop() ?? return rest
    if rest.len() == 0 {
        rest.push(ir_opt_stops_part(m, keys, bodies, reports, last.move()))
        return rest
    }
    done := [IROptStopsPart]{}
    task.group ir_opt_stops_threads {
        head: task ir_opt_stops_part(m, keys, bodies, reports, last.move())
        done = ir_opt_stops_walks(m, keys, bodies, reports, rest.move())
        done.push(compiler_threads_joined(head))
    }
    done
}

// One part's walk: its functions' scan while there are no reports, else
// their removals.
ir_opt_stops_part: fn(m: IRModule, keys: [String], bodies: [Bool], reports: [Bool], part: ^^IROptStopsPart) -> IROptStopsPart Never! {
    walked := part.move()
    start: walked.start
    scanning: reports.len() == 0
    loop row in 0..<walked.functions.len() {
        if {
            scanning -> {
                ir_opt_stops_scan(m, walked.functions[row], start + row, keys, bodies, walked.scan)
            }
            bodies[start + row] -> {
                ir_opt_stops_unreported(walked.functions[row], keys, bodies, reports)
            }
            else -> {}
        }
    }
    walked
}

// The reports of every function, from the parts' scans in function order.
ir_opt_stops_reported: fn(parts: ^[IROptStopsPart]) -> [Bool] Never! {
    scan := ir_opt_stops_scan_new()
    loop at in 0..<parts.len() -> ir_opt_stops_scan_take(scan, parts[at].scan)
    ir_opt_stops_reports(scan)
}

// Appends `part`'s scan to `scan`, its call ends shifted past the calls
// already there.
ir_opt_stops_scan_take: fn(scan: ^IROptStopsScan, part: ^IROptStopsScan) Never! {
    base: scan.calls.len()
    compiler_transfer_rows<Bool>(scan.starts, part.starts)
    compiler_transfer_rows<Int>(scan.calls, part.calls)
    loop end in part.ends -> scan.ends.push(base + end)
}

// Whether body `f` can start a stop: an instruction whose selection can
// publish one (ir_opt_stops_quiet), a turn poll (a passed deadline), or a
// poll that checks no direct call of a body (a stop another task asked
// for, or one a runtime routine published), counting a poll a tail call may
// move before its jump (TailCalls.jet). A trap's stop point takes only the
// stops of the slow paths before it, judged at their instructions. A body
// with no instructions is not known.
ir_opt_stops_starts: fn(m: IRModule, f: IRFunction, keys: [String], bodies: [Bool]) -> Bool Never! {
    if f.op.len() == 0 -> return true
    loop at in 0..<f.op.len() {
        if f.op[at] != .Call {
            if !ir_opt_stops_quiet(m, f, at) -> return true
            next
        }
        callee: f.a[at]
        if callee < 0 || callee >= keys.len() || keys[callee] == IR_STOP_TURN_KEY -> return true
        if keys[callee] != IR_STOP_POLL_KEY -> next
        if !ir_opt_stops_poll(f, keys, at) || !ir_opt_stops_checks_body(f, bodies, at) {
            return true
        }
        if ir_opt_stops_tail(f, f.c[at + 1] + 1) -> return true
    }
    false
}

// Whether the poll at `at` follows a direct call of a body.
ir_opt_stops_checks_body: fn(f: IRFunction, bodies: [Bool], at: Int) -> Bool Never! {
    if at == 0 || f.op[at - 1] != .Call -> return false
    callee: f.a[at - 1]
    callee >= 0 && callee < bodies.len() && bodies[callee]
}

// Whether only Drops, Moves and Copies lie between `start` and a Return or
// another call: the shape of a tail call (TailCalls.jet ir_tail_site).
ir_opt_stops_tail: fn(f: IRFunction, start: Int) -> Bool Never! {
    at := start
    loop at < f.op.len() && (f.op[at] == .Drop || f.op[at] == .Move || f.op[at] == .Copy || f.op[at] == .Nop) {
        at += 1
    }
    at < f.op.len() && (f.op[at] == .Return || f.op[at] == .Call)
}

// Whether the selection of instruction `at` can publish no stop of its own
// (X64Select: the slow paths that publish one belong to a trapping
// fixed-width operation or negation, a division not proven to have an
// inline dividend and a positive divisor, and a shift).
ir_opt_stops_quiet: fn(m: IRModule, f: IRFunction, at: Int) -> Bool Never! {
    op: f.op[at]
    if op == {
        .Add | .Sub | .Mul | .Neg -> {
            kind: ir_opt_stops_kind(m, f, f.a[at])
            kind == .Int || kind == .Float || kind == .Float32 || f.c[at] == IR_OVERFLOW_WRAP
        }
        .Div | .Rem | .FloorDiv | .Mod -> {
            kind: ir_opt_stops_kind(m, f, f.a[at])
            kind == .Float || kind == .Float32 || (kind == .Int && ir_overflow_wraps(f.c[at]))
        }
        .Nop | .Const | .ConstText | .ConstBigInt | .Copy | .Move | .Drop | .Close | .BitAnd | .BitOr | .BitXor | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Not | .Sqrt | .IntBig | .Convert | .Concat | .Call | .CallRuntime | .CallIndirect | .FunctionAddress | .DataAddress | .Load | .Store | .StreamStore | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable -> true
        .Shl | .Shr -> false
    }
}

ir_opt_stops_kind: fn(m: IRModule, f: IRFunction, slot: Int) -> IRTypeKind Never! {
    if slot < 0 || slot >= f.slot_type.len() -> return IRTypeKind.Unit
    m.types[f.slot_type[slot]].kind
}

// Removes from body `f` each stop point right after a call of a body that
// reports no stop.
ir_opt_stops_unreported: fn(f: ^IRFunction, keys: [String], bodies: [Bool], reports: [Bool]) Never! {
    removed := false
    loop at in 1..<f.op.len() {
        if !ir_opt_stops_poll(f, keys, at) || !ir_opt_stops_checks_body(f, bodies, at) || reports[f.a[at - 1]] {
            next
        }
        loop k in at..<(f.c[at + 1] + 1) -> ir_opt_kill(f, k)
        removed = true
    }
    if removed -> ir_opt_compact(f)
}

// Polls folded into a later one (O1, O2, after inlining and again after the
// other passes, before the stop points move after their calls). A poll
// that checks no call (since the last check only an inlined body,
// arithmetic or other stop points, and no stop edge of the constructs just
// closed lands on it) can observe only a stop another task asked for, which
// any later poll that does not follow a call right away observes as well:
// one that checks no call reads the armed word, any other calls the poll.
// A poll right after a call may test only what the call returned
// (X64Select.jet ir_x64_stop_point), so it does not count. When every path
// from it reaches such a poll, with no Loop, Return or branch on the way
// that could skip it, the earlier one goes: a stop asked for meanwhile is
// delivered a little later, at the later stop point, while every stop a
// call or a trap publishes is still taken where it was. So an inlined
// recursive body's entry check folds into the poll after its body. A turn
// poll folded so makes the later one a turn poll, which still delivers a
// passed deadline once per iteration. A poll right after an exact Int's
// widening that cannot fail (ir_opt_widen_exact) counts as after what came
// before the widening, which publishes no stop: so a loop's turn passes it
// and a zone site's arguments around it may be skipped (X64Select.jet
// ir_x64_zone_regions). The stop points' and the widening's ids are the
// module's (ir_opt_view names them in `m`).
ir_opt_fold_polls: fn(f: ^IRFunction, m: IRModule) Never! {
    poll: ir_interned_name(m, IR_STOP_POLL_KEY) ?? -1
    turn: ir_interned_name(m, IR_STOP_TURN_KEY) ?? -1
    if poll < 0 && turn < 0 {
        return
    }
    trap: ir_interned_name(m, IR_STOP_TRAP_KEY) ?? -1
    widen: ir_interned_name(m, "jet_int_checked_widen") ?? -2
    folded := false
    loop at in 0..<f.op.len() {
        if !ir_opt_stops_any_poll(f, poll, turn, at) -> next
        if ir_opt_polls_checks_call(m, f, poll, trap, turn, at) && !ir_opt_polls_after_exact(m, f, poll, trap, turn, widen, at) {
            next
        }
        end: f.c[at + 1]
        later: ir_opt_polls_reach(f, poll, trap, turn, end + 1)
        if later < 0 -> next
        if f.a[at] == turn -> f.a[later] = turn
        loop k in at..<(end + 1) -> ir_opt_kill(f, k)
        folded = true
    }
    if folded -> ir_opt_compact(f)
}

// Whether the poll at `at` comes right after an exact widening (route
// `widen`) and, past it, checks no call.
ir_opt_polls_after_exact: fn(m: IRModule, f: IRFunction, poll: Int, trap: Int, turn: Int, widen: Int, at: Int) -> Bool Never! {
    if at == 0 || f.op[at - 1] != .CallRuntime || f.a[at - 1] != widen -> return false
    ir_opt_widen_exact(f, at - 1) && !ir_opt_polls_checks_call(m, f, poll, trap, turn, at - 1)
}

// Whether the jet_int_checked_widen(value, f32, file, line) call at `at`
// (BuildTypes.jet ir_checked_widen) widens a value in -2^24..2^24, which
// every Float target holds exactly, so it never stops: the only write of
// `value`, before `at`, is a constant there, or an exact Int's Rem or Mod by
// a constant whose magnitude is at most 2^24 and is not 0 (whose result is
// smaller than it).
ir_opt_widen_exact: fn(f: IRFunction, at: Int) -> Bool Never! {
    if f.c[at] != 4 -> return false
    writer: ir_opt_only_write(f, f.args[f.b[at]])
    if writer < 0 || writer >= at -> return false
    if f.op[writer] == .Const -> return ir_opt_widen_small(f.a[writer])
    if f.op[writer] != .Rem && f.op[writer] != .Mod -> return false
    divisor: ir_opt_only_write(f, f.b[writer])
    divisor >= 0 && divisor < writer && f.op[divisor] == .Const && f.a[divisor] != 0 && ir_opt_widen_small(f.a[divisor])
}

ir_opt_widen_small: fn(value: Int) -> Bool Never! { value >= -(1 << 24) && value <= 1 << 24 }

// The only instruction writing `slot`, or -1 (a parameter, or written by
// none or more than one).
ir_opt_only_write: fn(f: IRFunction, slot: Int) -> Int Never! {
    if slot < f.param_count -> return -1
    writer := -1
    loop at in 0..<f.op.len() {
        if f.dst[at] != slot -> next
        if writer >= 0 -> return -1
        writer = at
    }
    writer
}

// Whether the poll at `at` checks a call: walking back to the first call
// that is no stop point's (whose callee is no function `poll`, `trap` or
// `turn`) and no runtime route the runtime's stops receipt proves quiet
// (Build.jet ir_route_can_stop, by `m`'s names: the optimizer's view
// names none, so there every route counts), or the first construct
// opened, a call met first, or a construct closed on the way holding a
// stop edge that branches (an inlined body handing its callee's stop on
// to the poll after it). X64Select.jet ir_x64_stop_point reads it too.
ir_opt_polls_checks_call: fn(m: IRModule, f: IRFunction, poll: Int, trap: Int, turn: Int, at: Int) -> Bool Never! {
    ir_opt_polls_checked(m, f, poll, trap, turn, at) >= 0
}

// Where the poll at `at` meets the call it checks
// (ir_opt_polls_checks_call): the call, or the End of the construct whose
// stop edge hands one on; -1 when it checks none. X64Select.jet
// ir_x64_zone_holds reads it too.
ir_opt_polls_checked: fn(m: IRModule, f: IRFunction, poll: Int, trap: Int, turn: Int, at: Int) -> Int Never! {
    k := at - 1
    loop k >= 0 {
        op: f.op[k]
        if op == .End {
            if ir_opt_polls_hands_on(f, f.a[k], k) -> return k
            k = f.a[k] - 1
            next
        }
        if (op == .Call && (f.a[k] < 0 || (f.a[k] != poll && f.a[k] != trap && f.a[k] != turn))) || (op == .CallRuntime && !ir_opt_route_quiet(m, f.a[k])) || op == .CallIndirect {
            return k
        }
        if op == .Block || op == .Loop || op == .If || op == .Else -> return -1
        k -= 1
    }
    -1
}

// Whether runtime route `id` (of `m`'s names) publishes no stop
// (Build.jet ir_route_can_stop).
ir_opt_route_quiet: fn(m: IRModule, id: Int) -> Bool Never! {
    id >= 0 && id < m.names.len() && !ir_route_can_stop(m, m.names[id])
}

// Whether a stop edge (an If testing what a call just returned) from
// `start` to `end` branches rather than ending in a Return.
ir_opt_polls_hands_on: fn(f: IRFunction, start: Int, end: Int) -> Bool Never! {
    loop k in start..<end {
        if k == 0 || f.op[k] != .If || f.b[k] >= 0 || ir_opt_dead_end(f, k) >= 0 -> next
        call: f.op[k - 1]
        if (call != .Call && call != .CallRuntime && call != .CallIndirect) || f.a[k] != f.dst[k - 1] {
            next
        }
        loop j in (k + 1)..<f.c[k] {
            if f.op[j] == .Br || f.op[j] == .BrIf -> return true
        }
    }
    false
}

// The first poll every path from `start` reaches that does not follow a
// call right away (ir_opt_polls_after_call) outside any construct opened on
// the way, or -1. A construct closing goes on after it (a Loop's ends the
// search), an Else on after its If, a Br leaving the constructs opened on
// after the End it lands on; a poll counts only past every such End a
// branch skipped to. A Loop, Return, Unreachable or a branch back to a
// Loop's head ends the search. Edges that never come back (ir_opt_dead_end:
// a trap's or failure's cleanup) are passed over.
ir_opt_polls_reach: fn(f: IRFunction, poll: Int, trap: Int, turn: Int, start: Int) -> Int Never! {
    depth := 0
    past := -1
    at := start
    loop at < f.op.len() {
        exit: ir_opt_dead_end(f, at)
        if exit > at {
            at = exit + 1
            next
        }
        op: f.op[at]
        if depth == 0 && at > past && ir_opt_stops_any_poll(f, poll, turn, at) && !ir_opt_polls_after_call(f, poll, trap, turn, at) {
            return at
        }
        if op == .Loop || op == .Return || op == .Unreachable -> return -1
        if op == .Block || op == .If -> depth += 1 else if op == .Else {
            if depth == 0 -> at = f.a[at] - 1
        } else if op == .End {
            if depth == 0 && f.op[f.a[at]] == .Loop -> return -1
            if depth > 0 -> depth -= 1
        } else if op == .Br || op == .BrIf {
            level: if op == .Br -> f.a[at] else -> f.b[at]
            if level >= depth {
                target: ir_opt_polls_br_end(f, at, level)
                if target < 0 -> return -1
                if op == .Br && depth == 0 -> at = target else if target > past -> past = target
            }
        }
        at += 1
    }
    -1
}

// Whether the poll at `at` comes right after a call that is no stop
// point's (whose callee is no function `poll`, `trap` or `turn`): after a
// direct call of a body, or a call through a function value, it tests only
// what the call returned (X64Select.jet ir_x64_stop_point, JetWeb
// Select.jet web_stop_point).
ir_opt_polls_after_call: fn(f: IRFunction, poll: Int, trap: Int, turn: Int, at: Int) -> Bool Never! {
    if at == 0 -> return false
    if f.op[at - 1] == .CallIndirect -> return true
    f.op[at - 1] == .Call && f.a[at - 1] != poll && f.a[at - 1] != trap && f.a[at - 1] != turn
}

// The End a Br at `at` with depth `level` lands after, or -1 when it
// targets a Loop (a jump back to its head).
ir_opt_polls_br_end: fn(f: IRFunction, at: Int, level: Int) -> Int Never! {
    open := 0
    left := level
    k := at + 1
    loop k < f.op.len() {
        op: f.op[k]
        if op == .Block || op == .Loop || op == .If -> open += 1 else if op == .End {
            if open > 0 -> open -= 1 else {
                if left == 0 -> return if f.op[f.a[k]] == .Loop -> -1 else -> k
                left -= 1
            }
        }
        k += 1
    }
    -1
}

// Counted-loop stop-poll strip-mining (O1, O2, after reduce/licm/strength):
// hoists an inner counted loop's armed-word `jet_ir_stop_turn` check into a
// chunked outer loop (IR_STRIP_MINE_CHUNK = 4096 iterations per poll), leaving
// zero stop-poll instructions inside the hot inner loop while preserving
// cancellation/deadline latency within microseconds. Only applies to tight,
// non-trapping, call-free counted innermost loops with a single constant
// positive step and a single top-level latch back-edge.
IR_STRIP_MINE_CHUNK: 4096

IRStripMineLoop: struct {
    loop_at: Int,
    loop_end: Int,
    head: Int,
    exit_at: Int,
    poll_at: Int,
    poll_end: Int,
    idx: Int,
    limit: Int,
    step: Int,
    is_int: Bool,
    safe_limit: Bool,
}

ir_opt_strip_mine: fn(m: IRModule, f: ^IRFunction) -> Int Never! {
    if f.asm != None || f.cold || f.op.len() == 0 -> return 0
    poll: ir_keyed_function(m, IR_STOP_POLL_KEY) ?? -1
    trap: ir_keyed_function(m, IR_STOP_TRAP_KEY) ?? -1
    turn: ir_keyed_function(m, IR_STOP_TURN_KEY) ?? -1
    ir_opt_strip_mine_with(m, f, poll, trap, turn)
}

ir_opt_strip_mine_with: fn(m: IRModule, f: ^IRFunction, poll: Int, trap: Int, turn: Int) -> Int Never! {
    if f.asm != None || f.cold || f.op.len() == 0 || turn < 0 -> return 0
    has_turn := false
    loop at in 0..<f.op.len() {
        if f.op[at] == .Call && f.a[at] == turn {
            has_turn = true
            break
        }
    }
    if !has_turn -> return 0
    ir_opt_compact(f)
    facts: ir_opt_facts(f)
    plans := [IRStripMineLoop]{}
    skip_until := -1
    loop at in 0..<f.op.len() {
        if at <= skip_until || f.op[at] != .Loop -> next
        plan: ir_opt_strip_mine_find(m, f, facts, poll, trap, turn, at)
        if plan.loop_at >= 0 {
            skip_until = plan.loop_end
            plans.push(plan)
        }
    }
    if plans.len() == 0 -> return 0
    code := IROptCode{op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, line: [Int]{}}
    p := 0
    at := 0
    loop at < f.op.len() {
        if p >= plans.len() || at != plans[p].loop_at {
            ir_opt_code_put(code, f.op[at], f.dst[at], f.a[at], f.b[at], f.c[at], f.code_line[at])
            at += 1
            next
        }
        ir_opt_strip_mine_emit(f, code, plans[p])
        at = plans[p].loop_end + 1
        p += 1
    }
    f.op = code.op.move()
    f.dst = code.dst.move()
    f.a = code.a.move()
    f.b = code.b.move()
    f.c = code.c.move()
    f.code_line = code.line.move()
    ir_opt_compact(f)
    plans.len()
}

ir_opt_strip_mine_none: fn() -> IRStripMineLoop Never! {
    IRStripMineLoop{loop_at: -1, loop_end: -1, head: -1, exit_at: -1, poll_at: -1, poll_end: -1, idx: -1, limit: -1, step: 0, is_int: false, safe_limit: false}
}

ir_opt_strip_mine_find: fn(m: IRModule, f: IRFunction, facts: OptFacts, poll: Int, trap: Int, turn: Int, at: Int) -> IRStripMineLoop Never! {
    none: ir_opt_strip_mine_none()
    end: f.a[at]
    if end <= at + 4 || end - at > 48 -> return none
    if f.op[end - 1] != .Br || f.a[end - 1] != 0 -> return none
    if ir_version_holds_loop(f, at, end) -> return none
    head := at + 1
    loop head < end && f.op[head] == .Nop -> head += 1
    if head + 1 >= end || f.dst[head] < 0 -> return none
    test: f.op[head]
    exit_at: if f.op[head + 1] == .Not && head + 2 < end && f.a[head + 1] == f.dst[head] -> head + 2 else -> head + 1
    if f.op[exit_at] != .BrIf || f.a[exit_at] != f.dst[exit_at - 1] || f.b[exit_at] < 1 {
        return none
    }
    negated: exit_at == head + 2
    idx := -1
    limit := -1
    if negated {
        if test == .Lt {
            idx = f.a[head]
            limit = f.b[head]
        } else if test == .Gt {
            idx = f.b[head]
            limit = f.a[head]
        } else { return none }
    } else {
        if test == .Ge {
            idx = f.a[head]
            limit = f.b[head]
        } else if test == .Le {
            idx = f.b[head]
            limit = f.a[head]
        } else { return none }
    }
    if idx < 0 || limit < 0 || idx == limit -> return none
    if f.slot_type[idx] != f.slot_type[limit] -> return none
    idx_row: f.slot_type[idx]
    idx_kind: m.types[idx_row].kind
    is_int: idx_kind == .Int
    is_word: idx_kind == .Word && m.types[idx_row].signed && m.types[idx_row].size == 8
    if !is_int && !is_word -> return none
    if is_int && !ir_overflow_wraps(f.c[head]) -> return none
    if ir_version_writes(f, at, end, limit) -> return none
    // Scan loop body (exit_at + 1)..<(end - 1): require exactly one
    // call-free stop_turn at depth 0, no other calls/IntBig/trapping ops,
    // no early loop back-edges, and exactly one constant positive step on idx.
    poll_at := -1
    poll_end := -1
    step := -1
    depth := 0
    k := exit_at + 1
    loop k < end - 1 {
        op: f.op[k]
        if op == .End {
            if depth <= 0 -> return none
            depth -= 1
            k += 1
            next
        }
        if depth == 0 && op == .Call && f.a[k] == turn && ir_opt_stops_any_poll(f, poll, turn, k) {
            if poll_at >= 0 || ir_opt_polls_checks_call(m, f, poll, trap, turn, k) -> return none
            p_end: f.c[k + 1]
            if p_end >= end - 1 -> return none
            // Stop edge must not branch back to the loop head.
            p_depth := 0
            loop j in (k + 2)..<p_end {
                jop: f.op[j]
                if jop == .Block || jop == .Loop || jop == .If -> p_depth += 1
                if jop == .End -> p_depth -= 1
                if jop == .Br && f.a[j] == p_depth + 1 -> return none
                if jop == .BrIf && f.b[j] == p_depth + 1 -> return none
            }
            poll_at = k
            poll_end = p_end
            k = p_end + 1
            next
        }
        // Skip dead-end cold arms (e.g. bounds traps ending in Unreachable).
        if op == .If && f.b[k] < 0 && ir_version_exit_arm(f, k + 1, f.c[k]) {
            k = f.c[k] + 1
            next
        }
        if op == .Block || op == .Loop || op == .If {
            if op == .Loop -> return none
            depth += 1
            k += 1
            next
        }
        if op == .IntBig || op == .Call || op == .CallRuntime || op == .CallIndirect -> return none
        if op == .Br && f.a[k] == depth -> return none
        if op == .BrIf && f.b[k] == depth -> return none
        if op == .Add || op == .Sub || op == .Mul || op == .Div || op == .Rem || op == .FloorDiv || op == .Mod || op == .Neg || op == .Shl || op == .Shr {
            if f.a[k] >= 0 {
                op_kind: m.types[f.slot_type[f.a[k]]].kind
                if (op_kind == .Int || op_kind == .Word) && f.c[k] != IR_OVERFLOW_WRAP && f.c[k] != IR_OVERFLOW_NONNEG {
                    return none
                }
            }
        }
        if ir_x64_write(f, k) == idx {
            if depth != 0 || step >= 0 || op != .Add || f.c[k] != IR_OVERFLOW_WRAP -> return none
            other: if f.a[k] == idx -> f.b[k] else if f.b[k] == idx -> f.a[k] else -> -1
            if other < 0 || !ir_version_constant(f, facts, other) -> return none
            s: f.a[facts.def_at[other]]
            if s < 1 || s > 262144 -> return none
            step = s
        }
        k += 1
    }
    if depth != 0 || poll_at < 0 || step < 1 -> return none
    // Hoisting stop_turn above (exit_at + 1)..<poll_at is sound only if the
    // stop edge reads no slot written between exit_at + 1 and poll_at.
    if poll_at > exit_at + 1 {
        reads := [Int]{}
        loop j in poll_at..<(poll_end + 1) {
            ir_x64_reads_into(f, j, reads)
            if f.op[j] == .If -> reads.push(f.a[j])
            loop slot in reads {
                if slot < 0 -> next
                loop pre in (exit_at + 1)..<poll_at {
                    if ir_x64_write(f, pre) == slot -> return none
                }
            }
        }
    }
    safe_limit: ir_opt_strip_mine_safe_limit(m, f, facts, at, limit, is_int)
    IRStripMineLoop{loop_at: at, loop_end: end, head: head, exit_at: exit_at, poll_at: poll_at, poll_end: poll_end, idx: idx, limit: limit, step: step, is_int: is_int, safe_limit: safe_limit}
}

// Whether `limit` is guaranteed <= MAX - chunk_span so `idx + chunk_span`
// cannot overflow (a List/String length for Word/8, or an Int guarded by a
// dominating preheader `IntBig(limit, bits <= 61); BrIf` before `loop_at`).
ir_opt_strip_mine_safe_limit: fn(m: IRModule, f: IRFunction, facts: OptFacts, loop_at: Int, limit: Int, is_int: Bool) -> Bool Never! {
    slot := limit
    k := loop_at - 1
    steps := 0
    loop k >= 0 && steps < 32 {
        op: f.op[k]
        if op == .Loop || op == .If || op == .Else || op == .End || op == .Return || op == .Unreachable {
            break
        }
        if is_int && op == .BrIf && k > 0 && f.op[k - 1] == .IntBig && f.a[k] == f.dst[k - 1] && f.a[k - 1] == slot && f.b[k - 1] <= 61 {
            return true
        }
        if ir_x64_write(f, k) == slot {
            if !is_int && (ir_range_length_load(m, f, k) || ir_opt_calls_route(m, f, k, "jet_string_bytes") || ir_opt_calls_route(m, f, k, "jet_char_len")) {
                return true
            }
            if op == .Copy || op == .Move -> slot = f.a[k] else { break }
        }
        k -= 1
        steps += 1
    }
    if !is_int && slot >= f.param_count && facts.defs[slot] == 1 && facts.def_at[slot] >= 0 {
        def: facts.def_at[slot]
        if ir_range_length_load(m, f, def) || ir_opt_calls_route(m, f, def, "jet_string_bytes") || ir_opt_calls_route(m, f, def, "jet_char_len") {
            return true
        }
    }
    false
}

ir_opt_strip_mine_emit: fn(f: ^IRFunction, code: ^IROptCode, plan: IRStripMineLoop) Never! {
    line: f.code_line[plan.loop_at]
    idx_row: f.slot_type[plan.idx]
    bool_row: f.slot_type[f.dst[plan.head]]
    cmp_c: if plan.is_int -> IR_OVERFLOW_WRAP else -> -1
    chunk_span: IR_STRIP_MINE_CHUNK * plan.step
    chunk_end: ir_slot(f, idx_row, .Temp, -1, line)
    span_slot: ir_slot(f, idx_row, .Temp, -1, line)
    cand: ir_slot(f, idx_row, .Temp, -1, line)
    use_cand: ir_slot(f, bool_row, .Temp, -1, line)
    cont: ir_slot(f, bool_row, .Temp, -1, line)
    // Outer Loop (same depth as original Loop): test exit, poll stop_turn once
    // per chunk, compute chunk_end = min(idx + chunk_span, limit), then run
    // tight bottom-tested inner loop with zero stop polls.
    ir_opt_code_put(code, .Loop, -1, -1, f.b[plan.loop_at], -1, line)
    loop k in plan.head..<(plan.exit_at + 1) {
        ir_opt_code_put(code, f.op[k], f.dst[k], f.a[k], f.b[k], f.c[k], f.code_line[k])
    }
    loop k in plan.poll_at..<(plan.poll_end + 1) {
        ir_opt_code_put(code, f.op[k], f.dst[k], f.a[k], f.b[k], f.c[k], f.code_line[k])
    }
    if plan.safe_limit {
        ir_opt_code_put(code, .Const, span_slot, chunk_span, -1, -1, line)
        ir_opt_code_put(code, .Add, cand, plan.idx, span_slot, IR_OVERFLOW_WRAP, line)
        ir_opt_code_put(code, .Lt, use_cand, cand, plan.limit, cmp_c, line)
        ir_opt_code_put(code, .If, -1, use_cand, -1, -1, line)
        ir_opt_code_put(code, .Move, chunk_end, cand, -1, -1, line)
        ir_opt_code_put(code, .Else, -1, -1, -1, -1, line)
        ir_opt_code_put(code, .Move, chunk_end, plan.limit, -1, -1, line)
        ir_opt_code_put(code, .End, -1, -1, -1, -1, line)
    } else {
        max_slot: ir_slot(f, idx_row, .Temp, -1, line)
        safe: ir_slot(f, bool_row, .Temp, -1, line)
        max_val: if plan.is_int -> IR_RANGE_HIGH - chunk_span else -> 9223372036854775807 - chunk_span
        ir_opt_code_put(code, .Const, max_slot, max_val, -1, -1, line)
        ir_opt_code_put(code, .Le, safe, plan.idx, max_slot, cmp_c, line)
        ir_opt_code_put(code, .If, -1, safe, -1, -1, line)
        ir_opt_code_put(code, .Const, span_slot, chunk_span, -1, -1, line)
        ir_opt_code_put(code, .Add, cand, plan.idx, span_slot, IR_OVERFLOW_WRAP, line)
        ir_opt_code_put(code, .Lt, use_cand, cand, plan.limit, cmp_c, line)
        ir_opt_code_put(code, .If, -1, use_cand, -1, -1, line)
        ir_opt_code_put(code, .Move, chunk_end, cand, -1, -1, line)
        ir_opt_code_put(code, .Else, -1, -1, -1, -1, line)
        ir_opt_code_put(code, .Move, chunk_end, plan.limit, -1, -1, line)
        ir_opt_code_put(code, .End, -1, -1, -1, -1, line)
        ir_opt_code_put(code, .Else, -1, -1, -1, -1, line)
        ir_opt_code_put(code, .Move, chunk_end, plan.limit, -1, -1, line)
        ir_opt_code_put(code, .End, -1, -1, -1, -1, line)
    }
    // Inner Loop (bottom-tested; idx < chunk_end holds on entry): zero stop polls.
    ir_opt_code_put(code, .Loop, -1, -1, f.b[plan.loop_at], -1, line)
    open := 0
    k := plan.exit_at + 1
    loop k < plan.loop_end - 1 {
        if k == plan.poll_at {
            k = plan.poll_end + 1
            next
        }
        op: f.op[k]
        if op == .End -> open -= 1
        a := f.a[k]
        b := f.b[k]
        if op == .Br && a > open -> a += 1
        if op == .BrIf && b > open -> b += 1
        ir_opt_code_put(code, op, f.dst[k], a, b, f.c[k], f.code_line[k])
        if op == .Block || op == .Loop || op == .If -> open += 1
        k += 1
    }
    ir_opt_code_put(code, .Lt, cont, plan.idx, chunk_end, cmp_c, line)
    ir_opt_code_put(code, .BrIf, -1, cont, 0, -1, line)
    ir_opt_code_put(code, .End, -1, -1, -1, -1, line)
    ir_opt_code_put(code, .Br, -1, 0, -1, -1, line)
    ir_opt_code_put(code, .End, -1, -1, -1, -1, line)
}

// A loop's turn right after Float{total %% 1000} (an exact Int's widening
// of a remainder by a constant, which cannot fail) folds into the poll past
// the plot after it, so nothing between the widening and the plot's own
// stop points needs the turn; a remainder by a parameter may be any size,
// so its widening may stop and the turn stays right after it.
#Test("A loop's turn passes a widening that cannot fail") {
    loop proven in ([Bool]{true, false}) {
        m := ir_module_new()
        int_row: ir_scalar_type_row(m, Type.Int)
        float: ir_scalar_type_row(m, Type.Float)
        flag: ir_scalar_type_row(m, Type.Bool)
        text: ir_scalar_type_row(m, Type.String)
        word: ir_word_row(m)
        poll: ir_stop_poll(m, IR_STOP_POLL_KEY)
        turn: ir_stop_poll(m, IR_STOP_TURN_KEY)
        widen: ir_intern_name(m, "jet_int_checked_widen")
        plot: ir_intern_name(m, "jet_perf_plot_float")
        f := ir_function_new("spin", "test:spin.jet.spin", "", "spin.jet", 1)
        total: ir_slot(f, int_row, IRSlotKind.Param, ir_intern_name(m, "total"), 1)
        _ := ir_open(f, IROp.Loop, 2)
        divisor := total
        if proven {
            divisor = ir_slot(f, int_row, IRSlotKind.Temp, -1, 0)
            _ := ir_emit(f, IROp.Const, divisor, 1000, -1, -1, 2)
        }
        kept: ir_slot(f, int_row, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(f, IROp.Rem, kept, total, divisor, IR_OVERFLOW_NONNEG, 2)
        single: ir_slot(f, flag, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(f, IROp.Const, single, 0, -1, -1, 2)
        file: ir_slot(f, text, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(f, IROp.ConstText, file, ir_intern_text(m, "spin.jet"), -1, -1, 2)
        line: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(f, IROp.Const, line, 2, -1, -1, 2)
        value: ir_slot(f, float, IRSlotKind.Temp, -1, 0)
        operands: ir_args(f, [Int]{kept, single, file, line})
        widened: ir_emit(f, IROp.CallRuntime, value, widen, operands, 4, 2)
        ir_x64_test_stop_edge(f, flag, turn, IROp.Return, 2)
        _ := ir_open(f, IROp.Block, 3)
        name: ir_slot(f, text, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(f, IROp.ConstText, name, ir_intern_text(m, "total"), -1, -1, 3)
        plotted: ir_args(f, [Int]{name, value})
        _ := ir_emit(f, IROp.CallRuntime, -1, plot, plotted, 2, 3)
        ir_x64_test_stop_edge(f, flag, poll, IROp.Br, 3)
        ir_end(f, 3)
        ir_x64_test_stop_edge(f, flag, poll, IROp.Return, 4)
        _ := ir_emit(f, IROp.Br, -1, 0, -1, -1, 4)
        ir_end(f, 4)
        _ := ir_emit(f, IROp.Return, -1, -1, -1, -1, 5)
        view: ir_opt_view(m, [String]{})
        ir_opt_fold_polls(f, view)
        turns := [Int]{}
        loop at in 0..<f.op.len() {
            if f.op[at] == .Call && f.a[at] == turn -> turns.push(at)
        }
        assert_eq(turns.len(), 1)
        assert_eq(turns[0] == widened + 1, !proven)
        if proven -> assert(f.op[turns[0] - 1] == .End && f.op[f.a[turns[0] - 1]] == .Block)
    }
}

// An entry poll before r := code(x), a call through a function value, stays:
// the poll after that call tests only what the call returned, so it can't
// take a stop another task asked for. With arithmetic in place of the call,
// the later poll checks no call and the entry poll folds into it.
#Test("A poll does not fold into the poll after a call through a function value") {
    loop indirect in ([Bool]{false, true}) {
        m := ir_module_new()
        int_row: ir_scalar_type_row(m, Type.Int)
        flag: ir_scalar_type_row(m, Type.Bool)
        word: ir_word_row(m)
        poll: ir_stop_poll(m, IR_STOP_POLL_KEY)
        f := ir_function_new("f", "test:fold.jet.f", "", "fold.jet", 1)
        x: ir_slot(f, int_row, IRSlotKind.Param, ir_intern_name(m, "x"), 1)
        code: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "code"), 1)
        f.result = int_row
        r: ir_slot(f, int_row, IRSlotKind.Temp, -1, 0)
        ir_x64_test_stop_edge(f, flag, poll, IROp.Return, 1)
        passed: ir_args(f, [Int]{x})
        _ := if indirect -> ir_emit(f, IROp.CallIndirect, r, code, passed, 1, 2) else -> ir_emit(f, IROp.Add, r, x, x, 0, 2)
        ir_x64_test_stop_edge(f, flag, poll, IROp.Return, 2)
        _ := ir_emit(f, IROp.Return, -1, r, -1, -1, 3)
        ir_opt_fold_polls(f, ir_opt_view(m, [String]{}))
        polls := 0
        loop (at, op) in f.op {
            if op == .Call && f.a[at] == poll -> polls += 1
        }
        assert_eq(polls, if indirect -> 2 else -> 1)
    }
}

// r := g(t) or r := code(t) through a function value, then drop t, then a
// stop or turn poll whose edge returns: the poll moves right after the
// call, and t's drop goes after the poll and into its edge.
#Test("A stop or turn poll moves right after a direct or indirect call") {
    loop key in ([String]{IR_STOP_POLL_KEY, IR_STOP_TURN_KEY}) {
        loop indirect in ([Bool]{false, true}) {
            m := ir_module_new()
            int_row: ir_scalar_type_row(m, Type.Int)
            flag: ir_scalar_type_row(m, Type.Bool)
            word: ir_word_row(m)
            poll: ir_stop_poll(m, key)
            m.functions.push(ir_function_new("g", "test:moves.jet.g", "", "moves.jet", 1))
            f := ir_function_new("f", "test:moves.jet.f", "", "moves.jet", 2)
            x: ir_slot(f, int_row, IRSlotKind.Param, ir_intern_name(m, "x"), 2)
            code: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "code"), 2)
            f.result = int_row
            t: ir_slot(f, int_row, IRSlotKind.Temp, -1, 0)
            r: ir_slot(f, int_row, IRSlotKind.Temp, -1, 0)
            _ := ir_emit(f, IROp.Add, t, x, x, 0, 3)
            passed: ir_args(f, [Int]{t})
            call: if indirect -> ir_emit(f, IROp.CallIndirect, r, code, passed, 1, 3) else -> ir_emit(f, IROp.Call, r, poll + 1, passed, 1, 3)
            _ := ir_emit(f, IROp.Drop, -1, t, -1, -1, 3)
            ir_x64_test_stop_edge(f, flag, poll, IROp.Return, 3)
            _ := ir_emit(f, IROp.Return, -1, r, -1, -1, 4)
            keys: loop g in m.functions -> g.key
            ir_opt_stops_after_calls(f, m, keys)
            assert(f.op[call + 1] == .Call && f.a[call + 1] == poll)
            assert(f.op[call + 2] == .If && f.op[call + 3] == .Drop && f.a[call + 3] == t)
            drops := 0
            loop (at, op) in f.op {
                if op == .Drop && f.a[at] == t -> drops += 1
            }
            assert_eq(drops, 2)
        }
    }
}

// An inlined body (a Block) whose stop edge after r := code(x) drops and
// branches to the Block's End, then drop t and a turn poll whose edge
// returns: the edge takes drop t and the turn's edge instead of branching,
// so no Br is left, each path drops t once, and the turn, which checked
// the stop the body handed on, checks no call.
#Test("An inlined body's stop edge takes the edge of the poll after the body") {
    m := ir_module_new()
    int_row: ir_scalar_type_row(m, Type.Int)
    flag: ir_scalar_type_row(m, Type.Bool)
    word: ir_word_row(m)
    poll: ir_stop_poll(m, IR_STOP_POLL_KEY)
    turn: ir_stop_poll(m, IR_STOP_TURN_KEY)
    f := ir_function_new("f", "test:handoff.jet.f", "", "handoff.jet", 1)
    x: ir_slot(f, int_row, IRSlotKind.Param, ir_intern_name(m, "x"), 1)
    code: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "code"), 1)
    f.result = int_row
    t: ir_slot(f, int_row, IRSlotKind.Temp, -1, 0)
    r: ir_slot(f, int_row, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Add, t, x, x, 0, 2)
    _ := ir_open(f, IROp.Block, 2)
    passed: ir_args(f, [Int]{x})
    _ := ir_emit(f, IROp.CallIndirect, r, code, passed, 1, 2)
    ir_x64_test_stop_edge(f, flag, poll, IROp.Br, 2)
    ir_end(f, 2)
    _ := ir_emit(f, IROp.Drop, -1, t, -1, -1, 3)
    ir_x64_test_stop_edge(f, flag, turn, IROp.Return, 3)
    _ := ir_emit(f, IROp.Return, -1, r, -1, -1, 4)
    view: ir_opt_view(m, [String]{})
    // The turn's call: its If, the edge's Return, the End and the Return follow.
    assert(ir_opt_polls_checks_call(view, f, poll, -1, turn, f.op.len() - 5))
    ir_opt_stops_hand_off(f, view)
    brs := 0
    drops := 0
    returns := 0
    turns := [Int]{}
    loop (at, op) in f.op {
        if op == .Br -> brs += 1
        if op == .Drop && f.a[at] == t -> drops += 1
        if op == .Return -> returns += 1
        if op == .Call && f.a[at] == turn -> turns.push(at)
    }
    assert_eq(brs, 0)
    assert_eq(drops, 2)
    assert_eq(returns, 3)
    assert_eq(turns.len(), 1)
    assert(!ir_opt_polls_checks_call(view, f, poll, -1, turn, turns[0]))
}

// The same body with a turn whose edge takes a cleanup token and hands it
// back: the copy in the body's stop edge gets operands of its own, so the
// SSA form reads each copy's token where that copy took it.
#Test("A stop edge's copy of the later edge has call operands of its own") {
    m := ir_module_new()
    int_row: ir_scalar_type_row(m, Type.Int)
    flag: ir_scalar_type_row(m, Type.Bool)
    word: ir_word_row(m)
    poll: ir_stop_poll(m, IR_STOP_POLL_KEY)
    turn: ir_stop_poll(m, IR_STOP_TURN_KEY)
    enter: ir_intern_name(m, "jet_rt_cleanup_enter")
    leave: ir_intern_name(m, "jet_rt_cleanup_leave")
    f := ir_function_new("f", "test:handoff.jet.f", "", "handoff.jet", 1)
    x: ir_slot(f, int_row, IRSlotKind.Param, ir_intern_name(m, "x"), 1)
    code: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "code"), 1)
    f.result = int_row
    r: ir_slot(f, int_row, IRSlotKind.Temp, -1, 0)
    stopped: ir_slot(f, flag, IRSlotKind.Temp, -1, 0)
    token: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_open(f, IROp.Block, 2)
    passed: ir_args(f, [Int]{x})
    _ := ir_emit(f, IROp.CallIndirect, r, code, passed, 1, 2)
    ir_x64_test_stop_edge(f, flag, poll, IROp.Br, 2)
    ir_end(f, 2)
    none: ir_args(f, [Int]{})
    _ := ir_emit(f, IROp.Call, stopped, turn, none, 0, 3)
    _ := ir_open_if(f, stopped, 3)
    _ := ir_emit(f, IROp.CallRuntime, token, enter, none, 0, 3)
    handed: ir_args(f, [Int]{token})
    _ := ir_emit(f, IROp.CallRuntime, -1, leave, handed, 1, 3)
    _ := ir_emit(f, IROp.Return, -1, -1, -1, -1, 3)
    ir_end(f, 3)
    _ := ir_emit(f, IROp.Return, -1, r, -1, -1, 4)
    ir_opt_stops_hand_off(f, ir_opt_view(m, [String]{}))
    starts := [Int]{}
    loop (at, op) in f.op {
        if op != .CallRuntime || f.a[at] != leave -> next
        assert_eq(f.args[f.b[at]], token)
        starts.push(f.b[at])
    }
    assert_eq(starts.len(), 2)
    assert(starts[0] != starts[1])
    assert_eq(ir_ssa_verify(f, ir_ssa_build(f)).len(), 0)
}

// The same body with its call in a loop: the stop edge branches out of the
// loop to the body's End, and it keeps that branch.
#Test("A stop edge inside a loop of an inlined body keeps its branch") {
    m := ir_module_new()
    int_row: ir_scalar_type_row(m, Type.Int)
    flag: ir_scalar_type_row(m, Type.Bool)
    word: ir_word_row(m)
    poll: ir_stop_poll(m, IR_STOP_POLL_KEY)
    turn: ir_stop_poll(m, IR_STOP_TURN_KEY)
    f := ir_function_new("f", "test:handoff.jet.f", "", "handoff.jet", 1)
    x: ir_slot(f, int_row, IRSlotKind.Param, ir_intern_name(m, "x"), 1)
    code: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "code"), 1)
    f.result = int_row
    r: ir_slot(f, int_row, IRSlotKind.Temp, -1, 0)
    stopped: ir_slot(f, flag, IRSlotKind.Temp, -1, 0)
    _ := ir_open(f, IROp.Block, 2)
    _ := ir_open(f, IROp.Loop, 2)
    passed: ir_args(f, [Int]{x})
    _ := ir_emit(f, IROp.CallIndirect, r, code, passed, 1, 2)
    none: ir_args(f, [Int]{})
    _ := ir_emit(f, IROp.Call, stopped, poll, none, 0, 2)
    _ := ir_open_if(f, stopped, 2)
    // Out of the If, the Loop and the Block.
    _ := ir_emit(f, IROp.Br, -1, 2, -1, -1, 2)
    ir_end(f, 2)
    _ := ir_emit(f, IROp.Br, -1, 0, -1, -1, 2)
    ir_end(f, 2)
    ir_end(f, 2)
    ir_x64_test_stop_edge(f, flag, turn, IROp.Return, 3)
    _ := ir_emit(f, IROp.Return, -1, r, -1, -1, 4)
    count: f.op.len()
    ir_opt_stops_hand_off(f, ir_opt_view(m, [String]{}))
    brs := 0
    loop op in f.op {
        if op == .Br -> brs += 1
    }
    assert_eq(brs, 2)
    assert_eq(f.op.len(), count)
}

// A poll after a runtime route checks it unless the module's stops receipt
// proves the route quiet; the optimizer's view names no route, so there
// every route counts.
#Test("A poll after a quiet runtime route checks no call") {
    loop quiet in ([Bool]{false, true}) {
        m := ir_module_new()
        flag: ir_scalar_type_row(m, Type.Bool)
        word: ir_word_row(m)
        poll: ir_stop_poll(m, IR_STOP_POLL_KEY)
        route: ir_intern_name(m, "jet_rt_alloc")
        if quiet -> _ := name_intern(m.quiet_routes, "jet_rt_alloc")
        f := ir_function_new("f", "test:quiet.jet.f", "", "quiet.jet", 1)
        size: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "size"), 1)
        box: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
        sizes: ir_args(f, [Int]{size, size})
        _ := ir_emit(f, IROp.CallRuntime, box, route, sizes, 2, 2)
        at: f.op.len()
        ir_x64_test_stop_edge(f, flag, poll, IROp.Return, 2)
        _ := ir_emit(f, IROp.Return, -1, -1, -1, -1, 3)
        assert_eq(ir_opt_polls_checks_call(m, f, poll, -1, -1, at), !quiet)
        assert(ir_opt_polls_checks_call(ir_opt_view(m, [String]{}), f, poll, -1, -1, at))
    }
}

// A tight counted loop with a single call-free stop_turn poll is strip-mined
// into an outer chunked loop (containing the stop_turn) wrapping a bottom-tested
// inner loop with zero stop_turn calls, and passes IR Lint cleanly.
#Test("A counted inner loop's stop_turn poll is strip-mined into a chunked outer loop") {
    m := ir_module_new()
    flag: ir_scalar_type_row(m, Type.Bool)
    word: ir_word_row(m)
    turn: ir_stop_poll(m, IR_STOP_TURN_KEY)
    f := ir_function_new("scan", "test:strip.jet.scan", "", "strip.jet", 1)
    n: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "n"), 1)
    f.result = word
    i: ir_slot(f, word, IRSlotKind.Local, ir_intern_name(m, "i"), 2)
    acc: ir_slot(f, word, IRSlotKind.Local, ir_intern_name(m, "acc"), 2)
    step: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    done: ir_slot(f, flag, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Const, i, 0, -1, -1, 2)
    _ := ir_emit(f, IROp.Const, acc, 0, -1, -1, 2)
    _ := ir_emit(f, IROp.Const, step, 3, -1, -1, 2)
    _ := ir_open(f, IROp.Block, 3)
    _ := ir_open(f, IROp.Loop, 3)
    _ := ir_emit(f, IROp.Ge, done, i, n, -1, 3)
    _ := ir_emit(f, IROp.BrIf, -1, done, 1, -1, 3)
    ir_x64_test_stop_edge(f, flag, turn, IROp.Return, 3)
    _ := ir_emit(f, IROp.Add, acc, acc, i, IR_OVERFLOW_WRAP, 4)
    _ := ir_emit(f, IROp.Add, i, i, step, IR_OVERFLOW_WRAP, 5)
    _ := ir_emit(f, IROp.Br, -1, 0, -1, -1, 5)
    ir_end(f, 5)
    ir_end(f, 5)
    _ := ir_emit(f, IROp.Return, -1, acc, -1, -1, 6)
    lint: ir_lint_context(m)
    report := ir_opt_report(2)
    mined: ir_opt_strip_mine(m, f)
    assert_eq(mined, 1)
    assert(ir_opt_lint(m, lint, f, "stripmine", report))
    loops := [Int]{}
    loop (at, op) in f.op {
        if op == .Loop -> loops.push(at)
    }
    assert_eq(loops.len(), 2)
    inner_at: loops[1]
    inner_end: f.a[inner_at]
    inner_turns := 0
    loop k in (inner_at + 1)..<inner_end {
        if f.op[k] == .Call && f.a[k] == turn -> inner_turns += 1
    }
    assert_eq(inner_turns, 0)
}
