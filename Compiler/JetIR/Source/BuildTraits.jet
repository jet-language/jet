// The IR builder's trait values: an owned trait value is a counted box
// holding its concrete payload's key word at 0 and the payload at 8; a
// dynamic call loads the key and calls the matching implementation, an
// unknown key stops at jet_rt_unreachable. A copy is one more owner of the
// same box, and the last owner drops the payload and frees the box
// (ir_trait_drop_body).

use jet_foundation.[Span, SymbolID, BodyCallArg, NodeKind, TMethodRef, TTryConvert, Type, name_rows_set, name_rows_value, sha256_bytes, type_carrier_identity]

// The payload key of concrete type `ty`: a function of its identity alone
// (56 bits of the identity's SHA-256, from 1), so it does not depend on the
// order the build met the types in. `m.trait_keys` holds the keys given, and
// two identities that would share a key stop the build.
ir_trait_key: fn(m: &IRModule, p: IRProgram, ty: Type) -> Int Never! {
    identity: ir_trait_identity(p, ty)
    if name_rows_value(m.trait_keys, identity) == .Val(key) -> return key
    bytes: identity.bytes()
    digest: sha256_bytes(bytes[0..<bytes.len()])
    key := 0
    loop index in 0..<7 -> key = key * 256 + (Int{digest[index]})
    key += 1
    loop (index, given) in m.trait_keys.rows {
        if given == key -> panic("trait payload keys of {m.trait_keys.texts[index]} and {identity} collide")
    }
    name_rows_set(m.trait_keys, identity, key)
    key
}

// The clone key of a trait value row: a copy retains the box (ir_clone).
ir_trait_share: fn() -> String Never! { "#trait.share" }

// `row`, a trait value row, drops through its glue and copies by sharing.
ir_mark_trait: fn(m: &IRModule, row: Int) -> Int Never! {
    if m.types[row].drop == "" {
        m.types[row].drop = ir_drop_key(m, row)
        m.types[row].clone = ir_trait_share()
    }
    row
}

// Whether `row` is a trait value row (ir_mark_trait).
ir_trait_row: fn(m: IRModule, row: Int) -> Bool Never! {
    m.types[row].clone == ir_trait_share()
}

// The concrete types a value of trait `bound` may hold, each once: the
// owners of the trait's non-generic implementations, as ir_trait_methods
// files them (a TraitMethod of the trait, or a Method its implementation
// slot names the trait for). A dynamic call selects among the same owners.
ir_trait_implementers: fn(p: IRProgram, bound: String) -> [Type] Never! {
    short: ir_short_name(bound)
    seen := [String:Bool]{}
    owners := [Type]{}
    loop function in p.functions {
        if function.generic_params.len() > 0 -> next
        owner := Type?{None}
        if function.kind == {
            .TraitMethod(_, _, owner_type, trait_name, _) -> {
                if ir_short_name(trait_name.key) == short -> owner = Val(owner_type.copy())
            }
            .Method(_, owner_type) -> {
                owner_key: ir_render_type_key(p.type_rows, p.types, owner_type)
                slot: p.impl_slots.get("{function.module_identity.id}|{owner_key}|{function.name}") ?? -1
                if slot >= 0 {
                    loop trait_short in p.impl_traits[slot] {
                        if trait_short == short -> owner = Val(owner_type.copy())
                    }
                }
            }
            .TopLevel -> {}
        }
        concrete: owner ?? next
        identity: ir_trait_identity(p, concrete)
        if seen.get(identity) != None -> next
        seen[identity] = true
        owners.push(concrete)
    }
    owners
}

// The drop of the trait value box at `at` (trait value row `row`): a null
// box holds nothing; the last owner calls the row's one last-owner routine
// (ir_trait_last_helper).
ir_trait_drop_body: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int, at: Int) Never! {
    present: ir_option_is_some(m, b, at)
    ir_open_if(b.f, present, b.line)
    bool_row: ir_type_row(m, Type.Bool) ?? 0
    last: ir_runtime(m, b, "jet_rt_block_release", [Int]{at}, bool_row)
    ir_open_if(b.f, last, b.line)
    helper: ir_trait_last_helper(m, p, b, row)
    ir_last_owner_call(b, helper, [Int]{at})
    ir_end(b.f, b.line)
    ir_end(b.f, b.line)
}

// The routine the last owner of a trait value box of row `row` calls: the
// payload key selects the concrete type, whose payload is dropped as any
// holder's (ir_glue_drops: a handle payload is left to the move that reads
// it out) and whose box (ir_trait_box_bytes) is freed. A key of no
// implementer (a generic owner's, which no dynamic call selects either)
// leaves the box as it is. Built once per row and never inlined.
ir_trait_last_helper: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, row: Int) -> Int Never! {
    helper_key: "#trait.last<{ir_row_key(m, row)}>"
    known: name_rows_value(m.function_rows, helper_key) ?? -1
    if known >= 0 -> return known
    id: m.functions.len()
    m.functions.push(ir_hashed_function(IR_LAST_OWNER, helper_key, "jet_ir_last_", "", 0))
    name_rows_set(m.function_rows, helper_key, id)
    a := ir_builder_new(m.functions[id].copy())
    at: ir_new_slot(a, row, IRSlotKind.Param, ir_intern_name(m, "value"))
    bounds: if ir_untag(m.types[row].ty) == .TraitObject(names) -> names.copy() else -> [String]{}
    owners: if bounds.len() == 1 -> ir_trait_implementers(p, bounds[0]) else -> [Type]{}
    key: ir_load_word(m, a, at, 0)
    loop concrete in owners {
        payload_row := -1
        if !ir_unit_type(concrete) -> payload_row = ir_value_type(m, p, concrete) ?? next
        payload_key: ir_trait_key(m, p, concrete)
        expected: ir_word_const(m, a, payload_key)
        selected: ir_bool_op(m, a, IROp.Eq, key, expected)
        ir_open_if(a.f, selected, a.line)
        if payload_row >= 0 && ir_glue_drops(m, payload_row) {
            payload: ir_load_at(m, a, at, 8, payload_row)
            ir_emit(a.f, IROp.Drop, -1, payload, -1, -1, a.line)
        }
        box_bytes: ir_trait_box_bytes(m, payload_row)
        bytes: ir_word_const(m, a, box_bytes)
        ir_free(m, a, at, bytes)
        ir_end(a.f, a.line)
    }
    ir_last_helper_finish(m, b, a, id, helper_key)
}

// The bytes of the box of a trait value holding a payload of row
// `payload_row` (-1: a Unit payload): its key word and the payload.
ir_trait_box_bytes: fn(m: IRModule, payload_row: Int) -> Int Never! {
    if payload_row < 0 -> return 8
    8 + ir_align8(m.types[payload_row].size)
}

// A concrete receiver type's identity, the same however the checked type
// spells the name: a boxed value's type is module-qualified, an
// implementation's owner type is the name its body wrote.
ir_trait_identity: fn(p: IRProgram, ty: Type) -> String Never! {
    plain: ir_untag(ty)
    if plain == .Named(_) -> return ir_render_type_key(p.type_rows, p.types, plain)
    type_carrier_identity(plain)
}

// Whether `receiver` is a trait value whose `method` dispatches dynamically.
ir_trait_receiver: fn(m: IRModule, p: IRProgram, receiver: Type, method: TMethodRef) -> Bool Never! {
    if method.trait_owner == None -> return false
    ir_untag(receiver) == .TraitObject(_)
}

// The function a method call names: its own checked row, else the trait
// implementation of the concrete receiver (a bounded generic's receiver is
// concrete per instance). An implementation for the receiver's exact type
// wins; else the generic owner's (`impl Point2.Trait` for a `Point2<Float, W>`
// receiver), whose instance the call builds from the receiver's arguments.
ir_method_key: fn(m: IRModule, p: IRProgram, receiver: Type, method: TMethodRef) -> String Never! {
    if ir_function_row(p, method.symbol.key) != None -> return method.symbol.key.copy()
    owner: method.trait_owner ?? return method.symbol.key.copy()
    concrete: ir_trait_identity(p, receiver)
    candidates: p.trait_methods.get("{ir_short_name(owner.key)}|{method.name}") ?? [Int]{}
    loop row in candidates {
        implementer: ir_trait_implementer(p, row, owner) ?? next
        if ir_trait_identity(p, implementer) == concrete -> return p.functions[row].key.copy()
    }
    head: ir_trait_head_identity(p, receiver) ?? return method.symbol.key.copy()
    loop row in candidates {
        implementer: ir_trait_implementer(p, row, owner) ?? next
        implementer_head: ir_trait_head_identity(p, implementer) ?? ir_trait_identity(p, implementer)
        if implementer_head == head -> return p.functions[row].key.copy()
    }
    method.symbol.key.copy()
}

// The identity of generic application `ty`'s nominal head, None for any
// other type.
ir_trait_head_identity: fn(p: IRProgram, ty: Type) -> String? Never! {
    if ir_untag(ty) == .Apply(name, _) -> return Val(ir_trait_identity(p, Type.Named{name: name.copy()}))
    None
}

// The constant key of trait constant `name` of the implementation of trait
// `trait_short` (its short name) for the type of identity `owner`.
ir_trait_constant_key: fn(trait_short: String, owner: String, name: String) -> String Never! {
    "trait-constant:{trait_short}|{owner}|{name}"
}

// `T.name` over a type parameter: the constant of the implementation of
// `trait_short` the instance's concrete `owner` has; an implementation for
// the exact type wins, else the generic owner's (`impl Box.Shape` for a
// `Box<Int>`).
ir_trait_constant: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, owner: Type, trait_short: String, name: String, span: Span) -> Int Never! {
    concrete: ir_fact(p, b, owner, span)
    exact: ir_trait_constant_key(trait_short, ir_trait_identity(p, concrete), name)
    if p.constants.get(exact) != None -> return ir_constant(m, p, b, ty, exact, span)
    head: ir_trait_head_identity(p, concrete) ?? return ir_fail_slot(b, span, "no `{trait_short}` constant `{name}` for {ir_type_name(concrete)}")
    ir_constant(m, p, b, ty, ir_trait_constant_key(trait_short, head, name), span)
}

// The concrete owner of function `row` when it implements a method of the
// trait `owner` (p.trait_methods lists it under the trait's name): a
// TraitMethod of that very trait, or a plain Method of an implementation
// declared outside the trait's module.
ir_trait_implementer: fn(p: IRProgram, row: Int, owner: SymbolID) -> Type? Never! {
    if p.functions[row].kind == {
        .Method(_, owner_type) -> return Val(owner_type.copy())
        .TraitMethod(_, _, owner_type, trait_name, _) -> {
            if trait_name.key == owner.key -> return Val(owner_type.copy())
        }
        .TopLevel -> {}
    }
    None
}

// The list literal values boxed as trait values of `target`.
ir_trait_boxes: fn(p: IRProgram, b: &IRBuilder, values: [Int], target: Type) -> [Int] Never! {
    boxed := [Int]{}
    loop value in values {
        value_span: ir_body_node(p, b, value).span
        boxed.push(ir_node(b, target, NodeKind.TraitBox{value: value, target: target}, value_span))
    }
    boxed
}

// `value` boxed as a trait value of `target`: a box of 8 + its payload size
// (at least a word) holding the concrete type's key at 0 and the payload at
// 8. A value that already is a trait value is kept. The box owns its payload,
// except that a read call argument (`lend`) another holder keeps is lent: its
// bits go into the box with no new owner, as ir_union_lend lends a union's,
// and `lends` gets the box, which ir_box_lends_end ends after the call.
ir_trait_box: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, value: Int, written: Type, lend: Bool, lends: &[IRBoxLend], span: Span) -> Int Never! {
    target: ir_fact(p, b, written, span)
    if ir_failed(b) -> return -1
    bounds: if ir_untag(target) == .TraitObject(names) -> names else -> { return ir_fail_slot(b, span, "trait boxing target {ir_type_name(target)} is not a single checked trait") }
    if bounds.len() != 1 -> return ir_fail_slot(b, span, "trait boxing target {ir_type_name(target)} is not a single checked trait")
    concrete: ir_ty(p, b, value)
    if ir_untag(concrete) == .TraitObject(_) -> return ir_expr(m, p, b, value)
    row: ir_value_type(m, p, target) ?? return ir_type_fail(b, span, target)
    payload_row := -1
    if !ir_unit_type(concrete) -> payload_row = ir_value_type(m, p, concrete) ?? return ir_type_fail(b, span, concrete)
    slot: ir_expr(m, p, b, value)
    if ir_failed(b) -> return -1
    payload_key: ir_trait_key(m, p, concrete)
    box_bytes: ir_trait_box_bytes(m, payload_row)
    boxed: ir_box_alloc(m, b, box_bytes, row)
    key: ir_word_const(m, b, payload_key)
    ir_emit(b.f, IROp.Store, -1, boxed, 0, key, b.line)
    if lend && slot >= 0 && payload_row >= 0 && !b.fresh[slot] && ir_has_drop(m, b, slot) {
        ir_store_lent(m, b, boxed, 8, slot, payload_row)
        lends.push(IRBoxLend{boxed: boxed, box_bytes: box_bytes, wrapper: -1, wrapper_bytes: 0, row: payload_row, offset: 8})
        b.fresh[boxed] = false
        return boxed
    }
    if slot >= 0 {
        owned: ir_own(m, p, b, slot)
        ir_store_at(m, p, b, boxed, 8, owned)
        // The trait box is the heap's: its payload moves there
        // (BuildMove.jet).
        ir_move_stored(m, p, b, payload_row, boxed, 8)
    }
    b.fresh[boxed] = true
    boxed
}

// One implementation a dynamic call may select: its function key, concrete
// receiver type and receiver convention.
IRTraitTarget: struct { key: String, concrete: Type, access: String }

// `receiver.method(args)` on a trait value: the payload key selects the
// implementation of the method's trait for the boxed concrete type; its
// receiver is the payload's address (a write receiver or an aggregate) or the
// payload value. A method every implementation takes by move (`&&self`)
// consumes the trait value as sema reads it: the call owns the box
// (ir_move_receiver), which hands the payload over to the implementation
// (ir_box_hand_over), so only the implementation ends it. A move
// implementation of a method the trait value is only read for gets a copy of
// the payload, which the box keeps. No implementation, or an unknown key,
// stops at jet_rt_unreachable; `ty` is the call's checked type.
ir_trait_call: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, receiver: Int, method: TMethodRef, type_args: [Type], args: [BodyCallArg], ty: Type, span: Span) -> Int Never! {
    if type_args.len() > 0 -> return ir_fail_slot(b, span, "generic dynamic trait receivers are not object-safe")
    owner: method.trait_owner ?? return ir_fail_slot(b, span, "trait call has no trait owner")
    targets := [IRTraitTarget]{}
    returned := Type.Named{name: "Unit"}
    seen := [String:Bool]{}
    candidates: p.trait_methods.get("{ir_short_name(owner.key)}|{method.name}") ?? [Int]{}
    loop index in candidates {
        if p.functions[index].generic_params.len() > 0 -> next
        if ir_function_row(p, p.functions[index].key) != (Val(index)) -> next
        implementer: ir_trait_implementer(p, index, owner) ?? next
        // One implementation per concrete type: its payload key selects it.
        identity: ir_trait_identity(p, implementer)
        if seen.get(identity) != None -> next
        seen[identity] = true
        if targets.len() == 0 -> returned = ir_executable_return(p.functions[index]) ?? Type.Named{name: "Unit"}
        targets.push(IRTraitTarget{key: p.functions[index].key.copy(), concrete: implementer, access: ir_receiver_access(p.functions[index].kind)})
    }
    consumes := targets.len() > 0
    loop target in targets {
        if target.access != "move" -> consumes = false
    }
    boxed := -1
    if consumes {
        taken: ir_move_receiver(m, p, b, receiver, span)
        if ir_failed(b) -> return -1
        boxed = ir_own(m, p, b, taken)
    } else {
        boxed = ir_expr(m, p, b, receiver)
    }
    if ir_failed(b) -> return -1
    if targets.len() == 0 {
        ir_release(m, b, boxed)
        ir_trait_unreachable(m, b)
        return ir_unreachable_value(m, p, b, ty)
    }
    result := -1
    if !ir_unit_type(returned) {
        result_row: ir_value_type(m, p, returned) ?? return ir_type_fail(b, span, returned)
        result = ir_temp(m, b, result_row)
    }
    key: ir_load_word(m, b, boxed, 0)
    // Each implementation's path builds the arguments again, from the
    // ownership before the dispatch; the paths meet innermost first as their
    // Ifs close (ir_close_arms), and the unknown-key path stops.
    before: ir_own_states(b, b.bindings.len())
    tests := [Int]{}
    arm_states := [[IROwnState]]{}
    arm_leaves := [Bool]{}
    loop target in targets {
        target_key: ir_trait_key(m, p, target.concrete)
        expected: ir_word_const(m, b, target_key)
        selected: ir_bool_op(m, b, IROp.Eq, key, expected)
        ir_open_if(b.f, selected, b.line)
        if ir_unit_type(target.concrete) -> return ir_fail_slot(b, span, "dynamic trait method lacks a receiver")
        concrete_row: ir_value_type(m, p, target.concrete) ?? return ir_type_fail(b, span, target.concrete)
        inline: m.types[concrete_row].kind == .Aggregate
        self_slot := -1
        if consumes {
            payload: ir_load_at(m, b, boxed, 8, concrete_row)
            box_bytes: ir_trait_box_bytes(m, concrete_row)
            self_slot = ir_box_hand_over(m, p, b, boxed, payload, concrete_row, box_bytes)
        } else if target.access == "write" && !inline {
            self_slot = ir_address_at(m, b, boxed, 8)
        } else {
            self_slot = ir_load_at(m, b, boxed, 8, concrete_row)
            if target.access == "move" && self_slot >= 0 -> self_slot = ir_copy_value(m, p, b, self_slot, span)
        }
        value: ir_call(m, p, b, target.key, [Type]{}, self_slot, [IRWriteBack]{}, args, span)
        if ir_failed(b) -> return -1
        if result >= 0 && value >= 0 {
            // One implementation may return its plain success where another
            // returns the `T Never!` carrier (ir_plain_return).
            result_row: b.f.slot_type[result]
            adapted: ir_adapt(m, p, b, value, result_row, span)
            if ir_failed(b) -> return -1
            ir_emit(b.f, IROp.Copy, result, adapted, -1, -1, b.line)
            b.fresh[value] = false
            b.fresh[adapted] = false
        }
        tests.push(selected)
        arm_states.push(ir_own_states(b, before.len()))
        arm_leaves.push(false)
        ir_else(b.f, b.line)
        ir_set_own_states(b, before)
    }
    ir_trait_unreachable(m, b)
    ir_close_arms(m, b, tests, arm_states, arm_leaves, true)
    // A consumed box went to the implementation; any other fresh one ends here.
    if consumes {
        b.fresh[boxed] = false
    } else {
        ir_release(m, b, boxed)
    }
    if result >= 0 -> b.fresh[result] = ir_has_drop(m, b, result)
    ir_trait_propagate(m, p, b, method, result, ty, span)
}

// Sema types a trait-owned call by the method's success value while the
// implementation returns its failure carrier: the carrier is propagated at
// the call.
ir_trait_propagate: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, method: TMethodRef, slot: Int, checked: Type, span: Span) -> Int Never! {
    if method.trait_owner == None || slot < 0 || ir_failed(b) -> return slot
    returned: m.types[b.f.slot_type[slot]].ty
    carried: if ir_untag(returned) == {
        .Result(_, _) -> !(ir_untag(checked) == .Result(_, _))
        .Option(_) -> !(ir_untag(checked) == .Option(_))
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    if !carried -> return slot
    ir_try_slot(m, p, b, slot, returned, TTryConvert.NoConversion, None, span)
}

ir_trait_unreachable: fn(m: &IRModule, b: &IRBuilder) Never! {
    message: ir_static_text(m, b, "unknown native trait method key")
    _: ir_runtime(m, b, "jet_rt_unreachable", message, -1)
    ir_emit(b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
}
