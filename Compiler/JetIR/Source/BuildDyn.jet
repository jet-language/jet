// The native Dyn tree's handle methods. A key lookup scans the borrowed
// native Object in place; the scalar reads and Field/At cross the
// encoding.dyn routes, whose Dyn operand ir_route converts to a runtime tree
// for the call; a path write or a remove lends the receiver place's Dyn to
// the runtime and stores the rebuilt tree back; `decode<T>()` calls T's
// Decode implementation, a container's Core decode helper or the runtime's
// scalar Decode adapter.

use jet_foundation.[Span, TBuiltinOp, BodyCallArg, NodeKind, BodyHandleOp, TPanicLoc, Type, checked_generated_local, checked_user_local, StmtKind]

// The lowering of `receiver.operation(args)` when the receiver is the
// canonical Dyn and the operation is one of the tree methods here; None
// leaves the operation to ir_handle_method.
fn ir_dyn_method(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, operation: BodyHandleOp, args: [Int], span: Span) -> Int? Never! {
    dyn_row :: ir_dyn_def(p, ir_ty(p, b, receiver)) ?? return None
    if operation == {
        .DynGetKey -> return Val(ir_dyn_key_lookup(&m, p, &b, ty, dyn_row, receiver, args, false, span))
        .DynHas -> return Val(ir_dyn_key_lookup(&m, p, &b, ty, dyn_row, receiver, args, true, span))
        .DynSetPath(keys, site, location) -> return Val(ir_dyn_set_path(&m, p, &b, dyn_row, receiver, keys, site, location, args, span))
        .DynRemove -> return Val(ir_dyn_remove(&m, p, &b, ty, dyn_row, receiver, args, span))
        .DynDecode(target) -> return Val(ir_dyn_decode(&m, p, &b, ty, receiver, target, args, span))
        .DynIndexKey(site, location) -> return Val(ir_dyn_index(&m, p, &b, ty, receiver, "jet_dyn_index_key", true, site, location, args, span))
        .DynIndexAt(site, location) -> return Val(ir_dyn_index(&m, p, &b, ty, receiver, "jet_dyn_index_at", false, site, location, args, span))
        else -> {}
    }
    // The encoding.dyn routes: the tree is borrowed, an index moves.
    route :: if operation == {
        .DynField | .JSONField -> (symbol: "jet_dyn_field", arity: 1, mask: [Bool]{true, true})
        .DynAt | .JSONAt -> (symbol: "jet_dyn_at", arity: 1, mask: [Bool]{true, false})
        .DynGetAt -> (symbol: "jet_dyn_get_at", arity: 1, mask: [Bool]{true, false})
        .DynInt | .JSONInt -> (symbol: "jet_dyn_int", arity: 0, mask: [Bool]{true})
        .DynText | .JSONText -> (symbol: "jet_dyn_text", arity: 0, mask: [Bool]{true})
        .DynBool | .JSONBool -> (symbol: "jet_dyn_bool", arity: 0, mask: [Bool]{true})
        .DynFloat | .JSONFloat -> (symbol: "jet_dyn_float", arity: 0, mask: [Bool]{true})
        .DynKeys -> (symbol: "jet_dyn_keys", arity: 0, mask: [Bool]{true})
        else -> { return None }
    }
    if args.len() != route.arity -> return Val(ir_fail_slot(&b, span, "handle method {route.symbol} with {args.len()} arguments"))
    operands := [Int]{}
    tree :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) -> return Val(-1)
    &operands.push(tree)
    loop arg in args {
        slot :: ir_expr(&m, p, &b, arg)
        if ir_failed(b) -> return Val(-1)
        &operands.push(slot)
    }
    Val(ir_route(&m, p, &b, route.symbol, operands, route.mask, ty, span))
}

// `tree[key]` / `tree[index]`: the jet_dyn_index_key / jet_dyn_index_at route
// gives Ok(a new owner of the entry) or Err(its stop detail), and an Err
// stops at the index's line, its source quoted with the caret at the line
// start (DynRuntime.rs).
fn ir_dyn_index(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, symbol: String, keyed: Bool, site_text: String, location: TPanicLoc, args: [Int], span: Span) -> Int Never! {
    if args.len() != 1 -> return ir_fail_slot(&b, span, "Dyn index with {args.len()} arguments")
    row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    tree :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || tree < 0 -> return -1
    index :: ir_expr(&m, p, &b, args[0])
    if ir_failed(b) || index < 0 -> return -1
    string_row :: ir_string_row(&m)
    site :: ir_temp(&m, &b, string_row)
    ir_emit(&b.f, IROp.ConstText, site, ir_intern_text(&m, site_text), -1, -1, b.line)
    result_ty :: Type.Result{ok: ir_subst(m, ty), err: Type.String}
    outcome :: ir_route(&m, p, &b, symbol, [Int]{tree, index, site}, [Bool]{true, keyed, true}, result_ty, span)
    if ir_failed(b) || outcome < 0 -> return -1
    bool_row :: ir_type_row(&m, Type.Bool) ?? 0
    failed :: ir_temp(&m, &b, bool_row)
    ok :: ir_result_is_ok(&m, &b, outcome)
    ir_emit(&b.f, IROp.Not, failed, ok, -1, -1, b.line)
    ir_open_if(&b.f, failed, b.line)
    message :: ir_load_at(&m, &b, outcome, 8, string_row)
    null :: ir_word_const(&m, &b, 0)
    at := location.copy()
    at.column = 0
    at.caret = 0
    ir_stop(&m, p, &b, 2, message, null, null, ir_report_location(p, at))
    ir_end(&b.f, b.line)
    if ir_failed(b) -> return -1
    ir_box_take(&m, p, &b, outcome, 8, row)
}

// `tree.get(key)` / `tree.has(key)` (JetRuntime Dyn.jet jet_dyn_get_key,
// jet_dyn_has over data_tree_object_find): the first entry of a native
// Object whose key equals `key`, read in place. get gives Some(a new owner
// of the entry's value), else None, as has gives whether it exists; any
// other variant has no keys.
fn ir_dyn_key_lookup(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, dyn_row: Int, receiver: Int, args: [Int], has: Bool, span: Span) -> Int Never! {
    if args.len() != 1 -> return ir_fail_slot(&b, span, "Dyn key lookup with {args.len()} arguments")
    object :: ir_variant_index(p, dyn_row, "Object") ?? return ir_fail_slot(&b, span, "canonical Dyn has no Object variant")
    members :: ir_variant_members(&m, p, dyn_row, [Type]{}, object) ?? return ir_fail_slot(&b, span, "Dyn.Object has no payload layout")
    if members.len() != 1 -> return ir_fail_slot(&b, span, "Dyn.Object has no payload layout")
    payload :: members[0]
    entry_ty :: if ir_untag(m.types[payload.ty].ty) == .List(element) -> element else -> { return ir_fail_slot(&b, span, "Dyn.Object payload is not its checked ordered List") }
    entry_row :: ir_value_type(&m, p, entry_ty) ?? return ir_type_fail(&b, span, entry_ty)
    entry_members :: ir_inline_members(&m, p, entry_row) ?? return ir_fail_slot(&b, span, "Dyn.Object entries are not checked key/value records")
    if entry_members.len() != 2 || entry_members[0].name != "key" || entry_members[1].name != "value" -> return ir_fail_slot(&b, span, "Dyn.Object entries are not checked key/value records")
    result_row :: ir_value_type(&m, p, ty) ?? return ir_type_fail(&b, span, ty)
    if has && m.types[result_row].kind != .Bool -> return ir_fail_slot(&b, span, "Dyn.has as {ir_type_name(ty)}")
    if !has {
        _ :: if ir_untag(ty) == .Option(inner) -> inner else -> { return ir_fail_slot(&b, span, "Dyn.get as {ir_type_name(ty)}") }
    }
    tree :: ir_expr(&m, p, &b, receiver)
    key :: ir_expr(&m, p, &b, args[0])
    if ir_failed(b) || tree < 0 || key < 0 -> return -1
    if ir_kind_of(m, b, key) != .String {
        key_ty :: ir_ty(p, b, args[0])
        return ir_fail_slot(&b, span, "Dyn key lookup by {ir_type_name(key_ty)}")
    }
    pointer_row :: ir_pointer_row(&m)
    zero :: ir_word_const(&m, &b, 0)
    hit :: ir_temp(&m, &b, pointer_row)
    ir_emit(&b.f, IROp.Const, hit, 0, -1, -1, b.line)
    selector :: ir_load_word(&m, &b, tree, 0)
    expected :: ir_word_const(&m, &b, object)
    is_object :: ir_bool_op(&m, &b, IROp.Eq, selector, expected)
    ir_open_if(&b.f, is_object, b.line)
    holder :: if payload.boxed -> ir_load_word(&m, &b, tree, payload.offset) else -> tree
    entries :: ir_load_at(&m, &b, holder, if payload.boxed -> 0 else -> payload.offset, payload.ty)
    length :: ir_load_word(&m, &b, entries, 0)
    data :: ir_load_word(&m, &b, entries, 16)
    stride :: ir_list_stride(m, entry_row)
    index :: ir_count_open(&m, &b, length)
    missing :: ir_bool_op(&m, &b, IROp.Eq, hit, zero)
    ir_open_if(&b.f, missing, b.line)
    entry :: ir_element_address(&m, &b, data, index, stride)
    name :: ir_load_at(&m, &b, entry, entry_members[0].offset, entry_members[0].ty)
    same :: ir_bool_op(&m, &b, IROp.Eq, name, key)
    ir_open_if(&b.f, same, b.line)
    ir_emit(&b.f, IROp.Copy, hit, entry, -1, -1, b.line)
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    ir_count_close(&m, &b, index)
    ir_end(&b.f, b.line)
    if has {
        found :: ir_bool_op(&m, &b, IROp.Ne, hit, zero)
        ir_release(&m, &b, tree)
        ir_release(&m, &b, key)
        return found
    }
    value_row :: entry_members[1].ty
    result :: ir_temp(&m, &b, result_row)
    ir_emit(&b.f, IROp.Const, result, 0, -1, -1, b.line)
    present :: ir_bool_op(&m, &b, IROp.Ne, hit, zero)
    ir_open_if(&b.f, present, b.line)
    value :: ir_load_at(&m, &b, hit, entry_members[1].offset, value_row)
    owned :: ir_copy_value(&m, p, &b, value, span)
    width :: ir_align8(m.types[value_row].size)
    boxed :: ir_box_alloc(&m, &b, width, result_row)
    ir_store_at(&m, p, &b, boxed, 0, owned)
    ir_emit(&b.f, IROp.Copy, result, boxed, -1, -1, b.line)
    b.fresh[boxed] = false
    ir_end(&b.f, b.line)
    ir_release(&m, &b, tree)
    ir_release(&m, &b, key)
    b.fresh[result] = true
    result
}

// The receiver place of a Dyn mutation: its storage cell, the native Dyn it
// held and the runtime tree built from that Dyn for the route.
struct IRDynPlace { cell: Int, current: Int, tree: Int, backs: [IRWriteBack] }

fn ir_dyn_place_open(m: &IRModule, p: IRProgram, b: &IRBuilder, dyn_row: Int, receiver: Int, span: Span) -> IRDynPlace? Never! {
    receiver_ty :: ir_ty(p, b, receiver)
    value_row :: ir_value_type(&m, p, receiver_ty) ?? {
        _ :: ir_type_fail(&b, span, receiver_ty)
        return None
    }
    backs := [IRWriteBack]{}
    cell :: ir_place_address(&m, p, &b, receiver, &backs, span)
    if ir_failed(b) || cell < 0 -> return None
    current :: ir_temp(&m, &b, value_row)
    ir_emit(&b.f, IROp.Load, current, cell, 0, -1, b.line)
    tree :: ir_dyn_to_runtime(&m, p, &b, dyn_row, current, span)
    if tree < 0 -> return None
    Val(IRDynPlace{cell: cell, current: current, tree: tree, backs: backs})
}

// The mutated runtime tree becomes the place's native Dyn; the one it
// replaced drops, and a variable's write cell is read back.
fn ir_dyn_place_close(m: &IRModule, p: IRProgram, b: &IRBuilder, dyn_row: Int, place: IRDynPlace, span: Span) Never! {
    value_row :: b.f.slot_type[place.current]
    updated :: ir_dyn_from_runtime(&m, p, &b, dyn_row, place.tree, value_row, span)
    if updated < 0 -> return
    ir_emit(&b.f, IROp.Drop, -1, place.current, -1, -1, b.line)
    ir_emit(&b.f, IROp.Store, -1, place.cell, 0, updated, b.line)
    b.fresh[updated] = false
    loop back in place.backs -> ir_emit(&b.f, IROp.Load, back.slot, back.cell, 0, -1, b.line)
}

// `tree.a[0].b = value` (JetRuntime jet_dyn_set_path): the steps cross as one
// runtime Array of Text keys and Int indexes, the owned value as a runtime
// tree the route adopts; a refused step stops with the route's "{site}: ..."
// text at the checked location.
fn ir_dyn_set_path(m: &IRModule, p: IRProgram, b: &IRBuilder, dyn_row: Int, receiver: Int, keys: [Bool], site_text: String, location: TPanicLoc, args: [Int], span: Span) -> Int Never! {
    if args.len() != keys.len() + 1 -> return ir_fail_slot(&b, span, "Dyn path write with {args.len()} operands for {keys.len()} steps")
    value_expr :: args[keys.len()]
    value_ty :: ir_ty(p, b, value_expr)
    if ir_dyn_def(p, value_ty) == None -> return ir_fail_slot(&b, span, "Dyn path value of type {ir_type_name(value_ty)} is not the canonical Dyn")
    pointer_row :: ir_pointer_row(&m)
    word_row :: ir_word_row(&m)
    string_row :: ir_string_row(&m)
    count :: ir_word_const(&m, &b, keys.len())
    sequence :: ir_runtime(&m, &b, "jet_rt_record_seq_list_rec_dyn_new", [Int]{count}, pointer_row)
    loop (index, key) in keys {
        step :: ir_expr(&m, p, &b, args[index])
        if ir_failed(b) || step < 0 -> return -1
        expected :: if key -> IRTypeKind.String else -> IRTypeKind.Int
        if ir_kind_of(m, b, step) != expected {
            step_ty :: ir_ty(p, b, args[index])
            return ir_fail_slot(&b, span, "Dyn path step {index} of type {ir_type_name(step_ty)} is neither a String key nor an Int index")
        }
        item :: ir_runtime(&m, &b, if key -> "jet_rt_record_new_dyn_text" else -> "jet_rt_record_new_dyn_int", [Int]{step}, pointer_row)
        _ :: ir_runtime(&m, &b, "jet_rt_record_seq_list_rec_dyn_push", [Int]{sequence, item}, -1)
        ir_release(&m, &b, step)
    }
    steps :: ir_runtime(&m, &b, "jet_rt_record_new_dyn_array", [Int]{sequence}, pointer_row)
    value :: ir_expr(&m, p, &b, value_expr)
    if ir_failed(b) || value < 0 -> return -1
    adopted :: ir_dyn_to_runtime(&m, p, &b, dyn_row, value, span)
    if adopted < 0 -> return -1
    ir_release(&m, &b, value)
    place :: ir_dyn_place_open(&m, p, &b, dyn_row, receiver, span) ?? return -1
    site :: ir_temp(&m, &b, string_row)
    ir_emit(&b.f, IROp.ConstText, site, ir_intern_text(&m, site_text), -1, -1, b.line)
    out :: ir_out_slot(&m, &b, 1)
    selector :: ir_runtime(&m, &b, "jet_dyn_set_path", [Int]{place.tree, steps, adopted, site, out}, word_row)
    _ :: ir_runtime(&m, &b, "jet_rt_handle_drop_dyn", [Int]{steps}, -1)
    zero :: ir_word_const(&m, &b, 0)
    refused :: ir_bool_op(&m, &b, IROp.Eq, selector, zero)
    ir_open_if(&b.f, refused, b.line)
    message :: ir_temp(&m, &b, string_row)
    ir_emit(&b.f, IROp.Load, message, out, 0, -1, b.line)
    // A cancelled task refuses without a stop text: it propagates.
    worded :: ir_bool_op(&m, &b, IROp.Ne, message, zero)
    ir_open_if(&b.f, worded, b.line)
    ir_stop(&m, p, &b, 2, message, zero, zero, ir_report_location(p, location))
    ir_end(&b.f, b.line)
    ir_end(&b.f, b.line)
    ir_dyn_place_close(&m, p, &b, dyn_row, place, span)
    return -1
}

// `tree.remove(key)` (JetRuntime jet_dyn_remove): the receiver's first
// Object entry named `key` leaves it; Some(its value), else None.
fn ir_dyn_remove(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, dyn_row: Int, receiver: Int, args: [Int], span: Span) -> Int Never! {
    if args.len() != 1 -> return ir_fail_slot(&b, span, "Dyn.remove with {args.len()} arguments")
    _ :: if ir_untag(ty) == .Option(inner) -> inner else -> { return ir_fail_slot(&b, span, "Dyn.remove as {ir_type_name(ty)}") }
    key :: ir_expr(&m, p, &b, args[0])
    if ir_failed(b) || key < 0 -> return -1
    if ir_kind_of(m, b, key) != .String {
        key_ty :: ir_ty(p, b, args[0])
        return ir_fail_slot(&b, span, "Dyn.remove by {ir_type_name(key_ty)}")
    }
    place :: ir_dyn_place_open(&m, p, &b, dyn_row, receiver, span) ?? return -1
    removed :: ir_route_option(&m, p, &b, "jet_dyn_remove", [Int]{place.tree, key}, IRRouteCarrier.Handle{name: "Dyn"}, ty, span)
    if ir_failed(b) -> return -1
    ir_release(&m, &b, key)
    ir_dyn_place_close(&m, p, &b, dyn_row, place, span)
    removed
}

// `tree.decode<T>()`: T's own Decode implementation, called with the tree; a
// container or Dyn target's Core/Encoding/Encoding.jet decode helper
// (ir_codec_decode_helper); else the runtime's canonical scalar adapter
// jet_rt_codec_decode_<scalar>, which borrows the tree.
fn ir_dyn_decode(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, target: Type, args: [Int], span: Span) -> Int Never! {
    if args.len() != 0 -> return ir_fail_slot(&b, span, "Dyn.decode with {args.len()} arguments")
    concrete :: ir_subst(m, target)
    tree_arg :: ir_codec_arg(receiver)
    if ir_codec_impl(p, concrete, "Decode", "decode") == .Val(found) -> return ir_call(&m, p, &b, found.key, found.args, -1, [IRWriteBack]{}, [BodyCallArg]{tree_arg}, span)
    if ir_codec_decode_helper(p, concrete) == .Val(helper) {
        helper_key :: ir_codec_decode_key(p, helper.name) ?? return ir_fail_slot(&b, span, "Dyn.decode into {ir_type_name(concrete)}: Core/Encoding/Encoding.jet {helper.name} is outside the checked program")
        return ir_call(&m, p, &b, helper_key, helper.type_args, -1, [IRWriteBack]{}, [BodyCallArg]{tree_arg}, span)
    }
    scalar :: ir_codec_scalar(concrete) ?? return ir_fail_slot(&b, span, "Dyn.decode into {ir_type_name(concrete)} without its Decode implementation")
    tree :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || tree < 0 -> return -1
    result_ty :: ir_subst(m, ty)
    ir_route(&m, p, &b, "jet_rt_codec_decode_{scalar}", [Int]{tree}, [Bool]{true}, result_ty, span)
}

// `FieldError.under(segment, inner)`: Core/Encoding/Encoding.jet
// __decode_under frames every error of the inner Result under `segment` and
// passes a success through.
fn ir_decode_under(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, segment: Int, inner: Int, span: Span) -> Int Never! {
    success :: if ir_untag(ir_subst(m, ty)) == {
        .Result(ok, _) -> ok.copy()
        else -> { return ir_fail_slot(&b, span, "FieldError.under as {ir_type_name(ty)}") }
    }
    key :: ir_codec_decode_key(p, "__decode_under") ?? return ir_fail_slot(&b, span, "FieldError.under: Core/Encoding/Encoding.jet __decode_under is outside the checked program")
    args :: [BodyCallArg]{ir_codec_arg(segment), ir_codec_arg(inner)}
    ir_call(&m, p, &b, key, [Type]{success}, -1, [IRWriteBack]{}, args, span)
}

// A plain positional call argument for a by-name Core codec helper.
fn ir_codec_arg(value: Int) -> BodyCallArg Never! {
    BodyCallArg{value: value, template_items: [], borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
}

// The Core decode helper for a target with no Decode implementation of its
// own, and its type arguments: a List (a byte List also takes Bytes and
// base64 Text), an Option, a String-keyed Map and Dyn itself.
fn ir_codec_decode_helper(p: IRProgram, target: Type) -> (name: String, type_args: [Type])? Never! {
    if ir_dyn_def(p, target) != None -> return Val((name: "__decode_dyn", type_args: [Type]{}))
    if ir_untag(target) == {
        .List(element) -> {
            if ir_untag(element) == (Type.IntN{signed: false, bits: 8}) -> return Val((name: "__decode_bytes", type_args: [Type]{}))
            Val((name: "__decode_list", type_args: [Type]{element.copy()}))
        }
        .Option(inner) -> Val((name: "__decode_option", type_args: [Type]{inner.copy()}))
        .Map(key, _, value) -> {
            if ir_untag(key) != Type.String -> return None
            Val((name: "__decode_map", type_args: [Type]{value.copy()}))
        }
        else -> None
    }
}

// The checked key of the Core decode helper `name`, or None when the program
// does not hold it (CoreReach.jet ir_codec_decode_source).
fn ir_codec_decode_key(p: IRProgram, name: String) -> String? Never! {
    loop (index, function) in p.functions {
        if function.name == name && ir_codec_decode_source(function.module_identity, function.source_file, function.kind, function.name) && p.rows.get(function.key) == (Val(index)) -> return Val(function.key.copy())
    }
    None
}

// The runtime scalar Decode adapter's suffix for `target`, or None for a
// non-scalar target.
fn ir_codec_scalar(target: Type) -> String? Never! {
    if ir_untag(target) == {
        .Int -> Val("int")
        .Bool -> Val("bool")
        .Float -> Val("float")
        .String -> Val("string")
        .Char -> Val("char")
        .IntN(signed, bits) -> {
            if bits != 8 && bits != 16 && bits != 32 && bits != 64 -> return None
            Val("{if signed -> "i" else -> "u"}{bits}")
        }
        else -> None
    }
}

// `value.encode()` into a Dyn: a Dyn is itself, a type with its own Encode
// implementation calls it, an Int, fixed-width integer, Float, Bool, Char or
// String value is boxed as its Dyn variant (a Char is the Text of its one
// character), and a String-keyed Map or a List encodes as an Object or Array
// of its encoded values. The builtin and typed codec routes have no lowering
// here.
fn ir_serde_encode(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, span: Span) -> Int Never! {
    concrete :: ir_subst(m, ir_ty(p, b, receiver))
    if ir_dyn_def(p, concrete) != None -> return ir_expr(&m, p, &b, receiver)
    if ir_codec_impl(p, concrete, "Encode", "encode") == .Val(found) {
        self_slot :: ir_expr(&m, p, &b, receiver)
        if ir_failed(b) || self_slot < 0 -> return -1
        return ir_call(&m, p, &b, found.key, found.args, self_slot, [IRWriteBack]{}, [BodyCallArg]{}, span)
    }
    if ir_dyn_def(p, ir_subst(m, ty)) != None {
        receiver_node :: ir_body_node(p, b, receiver)
        typed :: ir_node(&b, concrete, receiver_node.kind.copy(), receiver_node.span)
        if ir_untag(concrete) == .Map(map_key, _, _) {
            if ir_untag(map_key) == Type.String -> return ir_dyn_object_encode(&m, p, &b, ty, typed, span)
        }
        if ir_untag(concrete) == .List(element) -> return ir_dyn_array_encode(&m, p, &b, ty, typed, element, span)
    }
    variant :: if ir_untag(concrete) == {
        .Int | .IntN(_, _) -> "Int"
        .Float -> "Float"
        .Bool -> "Bool"
        .String | .Char -> "Text"
        else -> ""
    }
    if variant == "" || ir_dyn_def(p, ir_subst(m, ty)) == None -> return ir_fail_slot(&b, span, "handle method SerdeEncode of {ir_type_name(concrete)}")
    slot :: ir_expr(&m, p, &b, receiver)
    if ir_failed(b) || slot < 0 -> return -1
    payload := slot
    if ir_untag(concrete) == .IntN(_, _) {
        int_row :: ir_value_type(&m, p, Type.Int) ?? return ir_type_fail(&b, span, Type.Int)
        payload = ir_numeric_cast(&m, p, &b, slot, int_row, span)
        if ir_failed(b) -> return -1
    }
    if ir_untag(concrete) == Type.Char {
        string_row :: ir_string_row(&m)
        payload = ir_runtime(&m, &b, "jet_rt_char_to_string", [Int]{slot}, string_row)
        if ir_failed(b) -> return -1
    }
    ir_dyn_box(&m, p, &b, ty, variant, payload, span)
}

// A List's `encode()`: the Array of each item's encode(), in order, built by
// a loop over the list the way ir_dyn_object_encode builds an Object.
fn ir_dyn_array_encode(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, value: Int, element: Type, span: Span) -> Int Never! {
    output_ty :: Type.List{element: ty}
    output_row :: ir_value_type(&m, p, output_ty) ?? return ir_type_fail(&b, span, output_ty)
    ir_scope_open(&b)
    source :: ir_expr(&m, p, &b, value)
    if ir_failed(b) || source < 0 {
        ir_scope_close(&m, &b)
        return -1
    }
    source_local :: checked_generated_local("encode_source_{source}", span)
    source_owned :: b.fresh[source] && ir_has_drop(m, b, source)
    &b.bindings.push(IRBinding{name: source_local.name.copy(), slot: source, owned: source_owned})
    b.fresh[source] = false
    // The item List leaves the scope as the payload: its binding never owns it.
    output :: ir_list_empty(&m, &b, output_row)
    b.fresh[output] = false
    output_local :: checked_generated_local("encode_output_{output}", span)
    &b.bindings.push(IRBinding{name: output_local.name.copy(), slot: output})
    item_local :: checked_user_local("encode_item_{output}", span)
    item_expr :: ir_node(&b, element, NodeKind.Local{local: item_local}, span)
    encoded :: ir_node(&b, ty, NodeKind.HandleMethod{receiver: item_expr, operation: BodyHandleOp.SerdeEncode, args: [Int]{}}, span)
    output_expr :: ir_node(&b, output_ty, NodeKind.Local{local: output_local}, span)
    push :: ir_node(&b, Type.Named{name: "Unit"}, NodeKind.BuiltinMethod{receiver: output_expr, operation: TBuiltinOp.Push, args: [Int]{encoded}}, span)
    value_ty :: ir_ty(p, b, value)
    source_expr :: ir_node(&b, value_ty, NodeKind.Local{local: source_local}, span)
    push_stmt :: ir_stmt_node(&b, StmtKind.ExprStmt{value: push, span: span})
    walk :: ir_stmt_node(&b, StmtKind.ForIn{label: None, variable: item_local, variable_two: None, source: source_expr, collection: source_expr, step: None, method_kind: None, columnar: false, by_value: false, source_stable: false, body: [Int]{push_stmt}, span: span})
    ir_stmt(&m, p, &b, walk)
    ir_scope_close(&m, &b)
    if ir_failed(b) -> return -1
    b.fresh[output] = true
    ir_dyn_box(&m, p, &b, ty, "Array", output, span)
}

// `concrete`'s own `codec` implementation method (`Decode|decode`,
// `Encode|encode`) and the owner arguments its instance binds (`[Int]` for a
// derived `Wrap<T>` at `Wrap<Int>`), or None when it has none. A generic
// owner matches any instance of its declaration; any other owner matches
// only its own type.
fn ir_codec_impl(p: IRProgram, concrete: Type, codec: String, method: String) -> (key: String, args: [Type])? Never! {
    identity :: ir_trait_identity(p, concrete)
    declaration :: ir_render_type_key(p.type_rows, p.types, concrete)
    candidates :: p.trait_methods.get("{codec}|{method}") ?? [Int]{}
    loop row in candidates {
        if p.rows.get(p.functions[row].key) != (Val(row)) -> next
        owner := Type?{None}
        if p.functions[row].kind == {
            .Method(_, owner_type) -> owner = Val(owner_type.copy())
            .TraitMethod(_, _, owner_type, trait_name, _) -> {
                if ir_short_name(trait_name.key) == codec -> owner = Val(owner_type.copy())
            }
            .TopLevel -> {}
        }
        implementer :: owner ?? next
        if ir_owner_binders(p, p.functions[row]).len() == 0 {
            if ir_trait_identity(p, implementer) == identity -> return Val((key: p.functions[row].key.copy(), args: [Type]{}))
            next
        }
        if ir_render_type_key(p.type_rows, p.types, implementer) != declaration -> next
        args :: ir_owner_args(p, p.functions[row], concrete) ?? next
        return Val((key: p.functions[row].key.copy(), args: args))
    }
    None
}
