// Channels: a Sender<T> or Receiver<T> is an owned runtime channel endpoint
// handle; `channel<T>()` writes both endpoints of one runtime channel into
// the tuple, the endpoint methods cross the native channel exports, and `loop
// value in rx` walks the receiver as an Iter.

use jet_foundation.[Span, BodyHandleOp, TLocal, Type, type_carrier_identity]

// The element of a `Sender<T>` / `Receiver<T>` endpoint.
ir_channel_element: fn(ty: Type, endpoint: String) -> Type? Never! {
    if ir_untag(ty) == .Apply(name, args) {
        if name == endpoint && args.len() == 1 -> return Val(args[0].copy())
    }
    None
}

// The row of a channel endpoint: the owned runtime channel, whose drop
// retires the endpoint and whose clone adds one.
ir_channel_row: fn(m: &IRModule, ty: Type, endpoint: String) -> Int Never! {
    atom: if endpoint == "Sender" -> "sender" else -> "receiver"
    ir_intern_type(m, type_carrier_identity(ty), ir_owned_layout(IRTypeKind.Pointer, ty, "jet_rt_native_{atom}_drop", "jet_rt_native_{atom}_clone"))
}

// `channel<T>()` / `channel_bounded<T>(capacity)`: both endpoints of one
// runtime channel, written into the result tuple; the bound crosses as its
// exact Int.
ir_channel_new: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, result_ty: Type, bounded: Bool, args: [Int], span: Span) -> Int Never! {
    fields: if ir_untag(result_ty) == .Tuple(items) -> items else -> { return ir_fail_slot(b, span, "channel producing {ir_type_name(result_ty)}") }
    members: ir_tuple_members(m, p, fields) ?? return ir_type_fail(b, span, result_ty)
    // The pair's checked tuple names its halves by type: positional
    // `(Sender<T>, Receiver<T>)` or a labeled pair in either order.
    sender_index := -1
    receiver_index := -1
    loop (index, member) in members {
        if ir_channel_element(m.types[member.ty].ty, "Sender") != None -> sender_index = index
        if ir_channel_element(m.types[member.ty].ty, "Receiver") != None -> receiver_index = index
    }
    if members.len() != 2 || sender_index < 0 || receiver_index < 0 {
        return ir_fail_slot(b, span, "channel producing {ir_type_name(result_ty)}")
    }
    if args.len() != (if bounded -> 1 else -> 0) -> return ir_fail_slot(b, span, "channel with {args.len()} arguments")
    row: ir_value_type(m, p, result_ty) ?? return ir_type_fail(b, span, result_ty)
    capacity := ir_word_const(m, b, 0)
    if bounded {
        capacity = ir_expr(m, p, b, args[0])
        if ir_failed(b) || capacity < 0 -> return -1
        // The reference scheduler stops a bound below 1; the native channel
        // export only clamps it.
        word_row: ir_word_row(m)
        bound: ir_runtime(m, b, "jet_int_owned_to_i64", [Int]{capacity}, word_row)
        one: ir_word_const(m, b, 1)
        short: ir_bool_op(m, b, IROp.Lt, bound, one)
        ir_open_if(b.f, short, b.line)
        ir_channel_capacity_stop(m, p, b, capacity, span)
        ir_end(b.f, b.line)
        if ir_failed(b) -> return -1
    }
    storage: ir_fresh_temp(m, b, row)
    ir_emit(b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
    tx: ir_address_at(m, b, storage, members[sender_index].offset)
    rx: ir_address_at(m, b, storage, members[receiver_index].offset)
    flag: ir_word_const(m, b, if bounded -> 1 else -> 0)
    _: ir_runtime(m, b, "jet_rt_native_channel", [Int]{flag, capacity, tx, rx}, -1)
    if bounded -> ir_release(m, b, capacity)
    storage
}

// `after(delay, value)`: a timer Receiver<T> that delivers the value once
// the delay passes. The delay crosses as its exact nanoseconds; the value
// moves into the runtime by slot with its element descriptor, which the
// runtime copies, as Sender.send's does.
ir_timer_after: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, result_ty: Type, args: [Int], span: Span) -> Int Never! {
    element: ir_channel_element(ir_untag(result_ty), "Receiver") ?? return ir_fail_slot(b, span, "after producing {ir_type_name(result_ty)}")
    if args.len() != 2 -> return ir_fail_slot(b, span, "after with {args.len()} arguments")
    row: ir_value_type(m, p, result_ty) ?? return ir_type_fail(b, span, result_ty)
    delay: ir_expr(m, p, b, args[0])
    if ir_failed(b) || delay < 0 -> return -1
    nanoseconds: ir_route(m, p, b, "jet_duration_ns_value", [Int]{delay}, [Bool]{true}, Type.Int, span)
    if ir_failed(b) -> return -1
    ir_release(m, b, delay)
    value: ir_expr(m, p, b, args[1])
    if ir_failed(b) || value < 0 -> return -1
    owned: if b.fresh[value] -> value else -> ir_copy_value(m, p, b, value, span)
    if ir_failed(b) -> return -1
    b.fresh[owned] = false
    slot: ir_lazy_value_slot(m, b, owned)
    meta: ir_lazy_meta(m, p, b, element, span)
    if meta < 0 -> return -1
    receiver: ir_runtime(m, b, "after_value", [Int]{nanoseconds, slot, meta}, row)
    ir_release(m, b, nanoseconds)
    receiver
}

// `panic: channel capacity must be at least 1, got {capacity}`: an E3001
// stop whose zeroed descriptor carries no source location, as the
// reference scheduler's runtime stop reports it.
ir_channel_capacity_stop: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, capacity: Int, span: Span) Never! {
    pointer_row: ir_pointer_row(m)
    builder: ir_runtime(m, b, "jet_rt_string_builder_new", [Int]{}, pointer_row)
    b.fresh[builder] = false
    ir_push_static(m, b, builder, "channel capacity must be at least 1, got ")
    text: ir_render(m, p, b, Type.Int, capacity, IRRender.Display, span)
    if ir_failed(b) -> return
    _: ir_runtime(m, b, "jet_rt_string_builder_push", [Int]{builder, text}, -1)
    string_row: ir_string_row(m)
    message: ir_runtime(m, b, "jet_rt_string_builder_finish", [Int]{builder}, string_row)
    descriptor: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.StackAddress, descriptor, 88, 8, -1, b.line)
    zero: ir_word_const(m, b, 0)
    loop index in 0..<11 -> ir_emit(b.f, IROp.Store, -1, descriptor, 8 * index, zero, b.line)
    panic_kind: ir_word_const(m, b, 2)
    _: ir_runtime(m, b, "jet_rt_require_stop", [Int]{panic_kind, descriptor, message, zero, zero, zero}, -1)
    ir_emit(b.f, IROp.Unreachable, -1, -1, -1, -1, b.line)
}

// An endpoint method: close on either endpoint, send on a Sender (an owned
// copy of the value moves into the channel, or back out in the `SendError`
// of a refused send), is_ready, the timer metadata reads, try_receive and
// receive on a Receiver. None leaves any other operation to ir_handle_method.
ir_channel_method: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, receiver: Int, operation: BodyHandleOp, args: [Int], span: Span) -> Int? Never! {
    receiver_ty: ir_ty(p, b, receiver)
    sender: ir_channel_element(receiver_ty, "Sender")
    receiving: ir_channel_element(receiver_ty, "Receiver")
    element: sender ?? (receiving ?? return None)
    is_sender: sender != None
    handled: if operation == {
        .ChannelClose -> true
        .SenderSend -> is_sender
        .ChannelIsReady | .ChannelIsTimer | .ChannelIsInterval | .ChannelIsCancelled | .ChannelDelayMs | .ChannelTryReceive | .ChannelReceive -> !is_sender
        .Hardware(_) | .DurationNew(_, _) | .FileReaderReadLine | .FileReaderRead(_) | .FileReaderSeek | .FileReaderPath | .MappedFileWindow | .MappedFileWindowLen | .MappedFileLines | .LinesIter | .MappedFileLen | .MappedFileIsEmpty | .FileWriterWriteLine | .FileWriterFlush | .FileWriterWriteAll | .FileWriterFsync | .FileWriterPath | .JSONReaderNext | .JSONWriterWrite | .JSONWriterFlush | .JSONWriterFinish | .JSONLReaderNext | .JSONLWriterWrite | .JSONLWriterFlush | .JSONLWriterFinish | .DataStreamNext | .XMLReaderNext | .XMLWriterWrite | .XMLWriterFlush | .XMLWriterFinish | .CBORReaderNext | .CBORWriterWrite | .CBORWriterFlush | .CBORWriterFinish | .StdinReadLine | .StdoutWrite | .StdoutWriteLine | .StdoutWriteBytes | .StdoutFlush | .StdoutIsTTY | .StderrWrite | .StderrWriteLine | .StderrWriteBytes | .StderrFlush | .StderrIsTTY | .WorldNow | .WorldAdvance | .WorldWaitIdle | .WorldHistory | .RealtimeNextDeadline | .RealtimeReceipt | .RealtimeCancel | .RealtimeIsCancelled | .GameSceneNew | .GameReplayRecord | .GameBackendHeadless | .GameBackendShouldContinue | .GameBackendPresent | .GameSceneOnFrame(_, _) | .GameSceneComponent | .GameSceneQuery | .GameAssetsImage | .GameAssetsSound | .GameInputBind | .GameInputPressed | .RNGInt | .RNGFloat | .RNGFloatRange | .RNGBool | .RNGBoolP | .RNGNormal | .RNGExponential | .RNGBytes | .RNGSplit | .RNGPick | .RNGWeightedPick | .RNGSample | .RNGShuffle | .DurationIn | .DurationIsZero | .DurationTotalSeconds | .DurationDifference | .TestSuiteRun | .TestSetting | .DurationAbs | .DurationNegated | .DurationSign | .DurationTotalIn | .DurationRound | .DurationNsValue | .DurationScale | .DurationDivide | .AllocAlloc | .AllocTryAlloc | .AllocReset | .PreciseMethod(_, _) | .TCPListenerAccept | .TCPListenerAcceptDeadline | .TCPListenerLocalAddr | .TCPStreamRead | .TCPStreamPeerAddr | .TCPStreamLocalAddr | .TCPStreamClose | .TCPStreamReadBytes(_) | .TCPStreamReadBytesDeadline(_) | .TCPStreamReadText | .TCPStreamReadTextDeadline | .TCPStreamWriteBytes | .TCPStreamWriteBytesDeadline | .TCPStreamWriteAllBytes | .TCPStreamWriteAllBytesDeadline | .TCPStreamWriteText | .TCPStreamWriteTextDeadline | .TCPStreamShutdown | .TCPStreamReady | .UDPSocketReady | .UDPSocketClose | .UDPSocketReceiveDeadline | .UDPSocketSendToDeadline | .UnixListenerAcceptDeadline | .UnixStreamReadDeadline(_) | .UnixStreamWriteAllDeadline | .UnixStreamReady | .UnixStreamClose | .UnixStreamSetTimeout | .HTTPClientNew | .ArgsSpecFlag | .ArgsSpecFlagShort | .ArgsSpecOption | .ArgsSpecOptionShort | .ArgsSpecOptionDefault | .ArgsSpecOptionEnv | .ArgsSpecOptionInt | .ArgsSpecOptionFloat | .ArgsSpecOptionChoice | .ArgsSpecRepeat | .ArgsSpecRequiredOption | .ArgsSpecPositional | .ArgsSpecDescription | .ArgsSpecSubcommand | .ArgsSpecVersion | .ArgsSpecCompletion | .ArgsSpecHelp | .ArgsSpecParse | .ArgsSpecParseOrExit | .ParsedArgsFlag | .ParsedArgsOption | .ParsedArgsOptionInt | .ParsedArgsOptionFloat | .ParsedArgsOptions | .ParsedArgsSubcommand | .ParsedArgsPositional | .ProcessSpecMethod(_, _) | .ProcessChildMethod(_) | .TerminalSessionResize | .ProcessStdinWrite | .ProcessStdinWriteText | .ProcessStdinClose | .ProcessStdinWriteAll | .ProcessStdoutRead | .ProcessStderrRead | .ReflectValueTypeName | .ReflectValuePath | .ReflectValueDisplay | .ReflectValueFields | .ReflectFieldName | .ReflectFieldValue | .TaskJoin | .TaskDetach | .TaskPause | .TaskResume | .TaskCancel | .MathMethod(_, _) | .ReactiveGet | .ReactiveSet | .ReactiveEffectMethod | .EventMethod(_) | .LayoutMethod(_) | .LoadableMethod(_) | .CivilTimeMethod(_, _) | .HTTPClientMethod(_, _) | .HTTPServerMethod(_, _) | .DynField | .DynAt | .DynInt | .DynText | .DynBool | .DynFloat | .DynToText | .DynEqualUnordered | .DynDecode(_) | .DynIndexKey(_, _) | .DynIndexAt(_, _) | .DynGetKey | .DynGetAt | .DynHas | .DynKeys | .DynLen(_, _) | .DynRemove | .DynBinary(_, _, _) | .DynCompare(_, _, _) | .DynSetPath(_, _, _) | .SerdeEncode | .JSONField | .JSONAt | .JSONInt | .JSONText | .JSONBool | .JSONFloat | .JSONToText | .JSONEqualUnordered | .PathFrom | .PathHome | .PathJoin | .PathParent | .PathExtension | .PathStem | .PathNormalize | .PathIsWithin | .PathToString | .PathWalk | .PluginInvoke(_, _) | .ReaderOver(_) | .ReaderReadU8 | .ReaderReadI8 | .ReaderReadU16Le | .ReaderReadU16Be | .ReaderReadI16Le | .ReaderReadI16Be | .ReaderReadU32Le | .ReaderReadU32Be | .ReaderReadI32Le | .ReaderReadI32Be | .ReaderReadU64Le | .ReaderReadU64Be | .ReaderReadI64Le | .ReaderReadI64Be | .ReaderReadF32Le | .ReaderReadF32Be | .ReaderReadF64Le | .ReaderReadF64Be | .ReaderPeek | .ReaderSeek | .ReaderSkip | .ReaderTake | .ReaderRemaining | .ReaderAtEnd | .CursorOver | .CursorTakeUntil | .CursorSkipWs | .CursorTakePattern(_, _) | .ReaderTakePattern(_, _) | .ProcessLines -> false
    }
    if !handled -> return None
    handle: ir_expr(m, p, b, receiver)
    if ir_failed(b) || handle < 0 -> return Val(-1)
    result := -1
    if operation == {
        .ChannelClose -> {
            if args.len() != 0 -> return Val(ir_fail_slot(b, span, "close with {args.len()} arguments"))
            atom: if is_sender -> "sender" else -> "receiver"
            _: ir_runtime(m, b, "jet_rt_native_{atom}_close", [Int]{handle}, -1)
        }
        .SenderSend -> {
            if args.len() != 1 -> return Val(ir_fail_slot(b, span, "Sender.send with {args.len()} arguments"))
            err_ty: if ir_untag(ty) == .Result(_, err) -> err else -> { return Val(ir_fail_slot(b, span, "Sender.send as {ir_type_name(ty)}")) }
            err_row: ir_value_type(m, p, err_ty) ?? return Val(ir_type_fail(b, span, err_ty))
            if m.types[err_row].kind != .Aggregate -> return Val(ir_fail_slot(b, span, "Sender.send failing with {ir_type_name(err_ty)}"))
            member: ir_member_of_row(m, p, err_row, "value") ?? return Val(ir_fail_slot(b, span, "{ir_type_name(err_ty)} without its value"))
            value: ir_expr(m, p, b, args[0])
            if ir_failed(b) || value < 0 -> return Val(-1)
            owned: if b.fresh[value] -> value else -> ir_copy_value(m, p, b, value, span)
            if ir_failed(b) -> return Val(-1)
            b.fresh[owned] = false
            // The channel's buffer is the heap's: the value moves there
            // (BuildMove.jet).
            ir_move_heap(m, p, b, owned)
            slot: ir_lazy_value_slot(m, b, owned)
            meta: ir_lazy_meta(m, p, b, element, span)
            if meta < 0 -> return Val(-1)
            // The runtime answers 1 when the channel took the value, the
            // Result's selector. On 0 it kept nothing, and the value comes
            // back as the error's `value` (as ir_task_outcome).
            boxed: ir_result_box(m, p, b, ty, true, -1)
            word_row: ir_word_row(m)
            verdict: ir_runtime(m, b, "jet_rt_native_sender_send", [Int]{handle, slot, meta}, word_row)
            ir_emit(b.f, IROp.Store, -1, boxed, 0, verdict, b.line)
            zero: ir_word_const(m, b, 0)
            refused: ir_bool_op(m, b, IROp.Eq, verdict, zero)
            ir_open_if(b.f, refused, b.line)
            storage: ir_fresh_temp(m, b, err_row)
            ir_emit(b.f, IROp.StackAddress, storage, m.types[err_row].size, 8, -1, b.line)
            b.fresh[owned] = true
            ir_member_write(m, p, b, storage, member, owned, -1)
            ir_store_at(m, p, b, boxed, 8, storage)
            ir_end(b.f, b.line)
            b.fresh[owned] = false
            b.fresh[boxed] = true
            result = boxed
        }
        .ChannelIsReady | .ChannelIsTimer | .ChannelIsInterval | .ChannelIsCancelled | .ChannelDelayMs -> {
            row: ir_value_type(m, p, ty) ?? return Val(ir_type_fail(b, span, ty))
            read: if operation == {
                .ChannelIsTimer -> "is_timer"
                .ChannelIsInterval -> "is_interval"
                .ChannelIsCancelled -> "is_cancelled"
                .ChannelDelayMs -> "delay_ms"
                .Hardware(_) | .DurationNew(_, _) | .FileReaderReadLine | .FileReaderRead(_) | .FileReaderSeek | .FileReaderPath | .MappedFileWindow | .MappedFileWindowLen | .MappedFileLines | .LinesIter | .MappedFileLen | .MappedFileIsEmpty | .FileWriterWriteLine | .FileWriterFlush | .FileWriterWriteAll | .FileWriterFsync | .FileWriterPath | .JSONReaderNext | .JSONWriterWrite | .JSONWriterFlush | .JSONWriterFinish | .JSONLReaderNext | .JSONLWriterWrite | .JSONLWriterFlush | .JSONLWriterFinish | .DataStreamNext | .XMLReaderNext | .XMLWriterWrite | .XMLWriterFlush | .XMLWriterFinish | .CBORReaderNext | .CBORWriterWrite | .CBORWriterFlush | .CBORWriterFinish | .StdinReadLine | .StdoutWrite | .StdoutWriteLine | .StdoutWriteBytes | .StdoutFlush | .StdoutIsTTY | .StderrWrite | .StderrWriteLine | .StderrWriteBytes | .StderrFlush | .StderrIsTTY | .WorldNow | .WorldAdvance | .WorldWaitIdle | .WorldHistory | .RealtimeNextDeadline | .RealtimeReceipt | .RealtimeCancel | .RealtimeIsCancelled | .GameSceneNew | .GameReplayRecord | .GameBackendHeadless | .GameBackendShouldContinue | .GameBackendPresent | .GameSceneOnFrame(_, _) | .GameSceneComponent | .GameSceneQuery | .GameAssetsImage | .GameAssetsSound | .GameInputBind | .GameInputPressed | .RNGInt | .RNGFloat | .RNGFloatRange | .RNGBool | .RNGBoolP | .RNGNormal | .RNGExponential | .RNGBytes | .RNGSplit | .RNGPick | .RNGWeightedPick | .RNGSample | .RNGShuffle | .DurationIn | .DurationIsZero | .DurationTotalSeconds | .DurationDifference | .TestSuiteRun | .TestSetting | .DurationAbs | .DurationNegated | .DurationSign | .DurationTotalIn | .DurationRound | .DurationNsValue | .DurationScale | .DurationDivide | .AllocAlloc | .AllocTryAlloc | .AllocReset | .PreciseMethod(_, _) | .TCPListenerAccept | .TCPListenerAcceptDeadline | .TCPListenerLocalAddr | .TCPStreamRead | .TCPStreamPeerAddr | .TCPStreamLocalAddr | .TCPStreamClose | .TCPStreamReadBytes(_) | .TCPStreamReadBytesDeadline(_) | .TCPStreamReadText | .TCPStreamReadTextDeadline | .