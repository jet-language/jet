            }
            result = ir_runtime(m, b, "jet_rt_native_receiver_{read}", [Int]{handle}, row)
        }
        .ChannelTryReceive -> {
            row: ir_value_type(m, p, ty) ?? return Val(ir_type_fail(b, span, ty))
            meta: ir_lazy_meta(m, p, b, element, span)
            if meta < 0 -> return Val(-1)
            if ir_option_inline(m, row) {
                // The runtime answers its generic Option box (ir_option_unbox).
                pointer_row: ir_pointer_row(m)
                boxed: ir_runtime(m, b, "jet_rt_native_receiver_try_receive", [Int]{handle, meta}, pointer_row)
                result = ir_option_unbox(m, p, b, boxed, row)
            } else {
                result = ir_runtime(m, b, "jet_rt_native_receiver_try_receive", [Int]{handle, meta}, row)
            }
            b.fresh[result] = m.types[row].drop != ""
        }
        .ChannelReceive -> {
            err_ty: if ir_untag(ty) == .Result(_, err) -> err else -> { return Val(ir_fail_slot(b, span, "Receiver.receive as {ir_type_name(ty)}")) }
            result = ir_task_outcome(m, p, b, "jet_rt_native_receiver_receive", [Int]{handle}, ty, err_ty, span)
        }
        .Hardware(_) | .DurationNew(_, _) | .FileReaderReadLine | .FileReaderRead(_) | .FileReaderSeek | .FileReaderPath | .MappedFileWindow | .MappedFileWindowLen | .MappedFileLines | .LinesIter | .MappedFileLen | .MappedFileIsEmpty | .FileWriterWriteLine | .FileWriterFlush | .FileWriterWriteAll | .FileWriterFsync | .FileWriterPath | .JSONReaderNext | .JSONWriterWrite | .JSONWriterFlush | .JSONWriterFinish | .JSONLReaderNext | .JSONLWriterWrite | .JSONLWriterFlush | .JSONLWriterFinish | .DataStreamNext | .XMLReaderNext | .XMLWriterWrite | .XMLWriterFlush | .XMLWriterFinish | .CBORReaderNext | .CBORWriterWrite | .CBORWriterFlush | .CBORWriterFinish | .StdinReadLine | .StdoutWrite | .StdoutWriteLine | .StdoutWriteBytes | .StdoutFlush | .StdoutIsTTY | .StderrWrite | .StderrWriteLine | .StderrWriteBytes | .StderrFlush | .StderrIsTTY | .WorldNow | .WorldAdvance | .WorldWaitIdle | .WorldHistory | .RealtimeNextDeadline | .RealtimeReceipt | .RealtimeCancel | .RealtimeIsCancelled | .GameSceneNew | .GameReplayRecord | .GameBackendHeadless | .GameBackendShouldContinue | .GameBackendPresent | .GameSceneOnFrame(_, _) | .GameSceneComponent | .GameSceneQuery | .GameAssetsImage | .GameAssetsSound | .GameInputBind | .GameInputPressed | .RNGInt | .RNGFloat | .RNGFloatRange | .RNGBool | .RNGBoolP | .RNGNormal | .RNGExponential | .RNGBytes | .RNGSplit | .RNGPick | .RNGWeightedPick | .RNGSample | .RNGShuffle | .DurationIn | .DurationIsZero | .DurationTotalSeconds | .DurationDifference | .TestSuiteRun | .TestSetting | .DurationAbs | .DurationNegated | .DurationSign | .DurationTotalIn | .DurationRound | .DurationNsValue | .DurationScale | .DurationDivide | .AllocAlloc | .AllocTryAlloc | .AllocReset | .PreciseMethod(_, _) | .TCPListenerAccept | .TCPListenerAcceptDeadline | .TCPListenerLocalAddr | .TCPStreamRead | .TCPStreamPeerAddr | .TCPStreamLocalAddr | .TCPStreamClose | .TCPStreamReadBytes(_) | .TCPStreamReadBytesDeadline(_) | .TCPStreamReadText | .TCPStreamReadTextDeadline | .TCPStrea