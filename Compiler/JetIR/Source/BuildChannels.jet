    }
    ir_release(m, b, handle)
    Val(result)
}

// `loop value in rx`: the receiver becomes a runtime Iter over the values it
// receives, which takes a fresh endpoint over and adds one for a kept
// receiver; the Iter is then walked as any other.
ir_channel_walk: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, label: String?, variable: TLocal, variable_two: TLocal?, collection: Int, step: Int?, body: [Int], span: Span) Never! {
    collection_ty: ir_ty(p, b, collection)
    element: ir_channel_element(collection_ty, "Receiver") ?? return ir_fail(b, span, "channel loop over {ir_type_name(collection_ty)}")
    iter_ty: Type.Apply{name: "Iter", args: [Type]{element}}
    iter_row: ir_value_type(m, p, iter_ty) ?? return ir_fail(b, span, "type {ir_type_name(iter_ty)}")
    item_row: ir_value_type(m, p, element) ?? return ir_fail(b, span, "type {ir_type_name(element)}")
    handle: ir_expr(m, p, b, collection)
    if ir_failed(b) || handle < 0 -> return
    stride: ir_walk_stride(m, p, b, step)
    if ir_failed(b) || (step != None && stride < 0) -> return
    meta: ir_lazy_meta(m, p, b, element, span)
    if ir_failed(b) -> return
    moved: ir_lazy_moved(m, b, handle)
    source: ir_runtime(m, b, "jet_rt_native_receiver_iter", [Int]{handle, moved, meta}, iter_row)
    ir_release(m, b, handle)
    ir_lazy_walk_source(m, p, b, label, variable, variable_two, source, item_row, stride, body, span)
}

// `select { ... }`: the readiness table's receivers and timer deadlines
// (exact nanoseconds) become two owned Lists, which the runtime empties, and
// the runtime writes the ready arm and its payload (the received value's
// box, or None for a timer) into the result tuple.
ir_select_wait: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, result_ty: Type, table: Int, nonblocking: Bool, span: Span) -> Int Never! {
    fields: if ir_untag(result_ty) == .Tuple(items) -> items else -> { return ir_fail_slot(b, span, "select producing {ir_type_name(result_ty)}") }
    members: ir_tuple_members(m, p, fields) ?? return ir_type_fail(b, span, result_ty)
    if members.len() != 2 -> return ir_fail_slot(b, span, "select producing {ir_type_name(result_ty)}")
    receivers := [Int]{}
    durations := [Int]{}
    if !ir_select_table(p, b, table, receivers, durations) -> return ir_fail_slot(b, span, "select over a non-canonical readiness table")
    payload: ir_select_payload_type(result_ty)
    receiver_list_ty: Type.List{element: Type.Apply{name: "Receiver", args: [Type]{payload}}}
    recvs: ir_list_literal(m, p, b, receiver_list_ty, receivers, span)
    if ir_failed(b) || recvs < 0 -> return -1
    int_row: ir_value_type(m, p, Type.Int) ?? return ir_type_fail(b, span, Type.Int)
    nanoseconds := [Int]{}
    loop duration in durations {
        value: ir_expr(m, p, b, duration)
        if ir_failed(b) || value < 0 -> return -1
        nanoseconds.push(ir_route(m, p, b, "jet_duration_ns_value", [Int]{value}, [Bool]{true}, Type.Int, span))
        if ir_failed(b) -> return -1
        ir_release(m, b, value)
    }
    timer_list_ty: Type.List{element: Type.Int}
    timer_row: ir_value_type(m, p, timer_list_ty) ?? return ir_type_fail(b, span, timer_list_ty)
    timers: ir_list_from(m, p, b, timer_row, int_row, nanoseconds)
    if ir_failed(b) -> return -1
    row: ir_value_type(m, p, result_ty) ?? return ir_type_fail(b, span, result_ty)
    storage: ir_fresh_temp(m, b, row)
    ir_emit(b.f, IROp.StackAddress, storage, m.types[row].size, 8, -1, b.line)
    arm: ir_address_at(m, b, storage, members[0].offset)
    value: ir_address_at(m, b, storage, members[1].offset)
    mode: ir_word_const(m, b, if nonblocking -> 1 else -> 0)
    _: ir_runtime(m, b, "jet_rt_native_select_wait", [Int]{recvs, timers, mode, arm, value}, -1)
    ir_release(m, b, recvs)
    ir_release(m, b, timers)
    storage
}

// The received value's type of a select over `ty`: through Result/Option
// wrappers to the `Task<T>` payload T; any other type is its own payload.
ir_select_payload_type: fn(ty: Type) -> Type Never! {
    if ir_untag(ty) == {
        .Result(ok, _) | .Option(ok) -> ir_select_payload_type(ok)
        .Apply(name, args) -> if name == "Task" && args.len() == 1 -> args[0] else -> ty
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ty
    }
}

// The receivers and timer durations of a readiness table, latest arm first;
// false for any other builder.
ir_select_table: fn(p: IRProgram, b: IRBuilder, table: Int, receivers: &[Int], durations: &[Int]) -> Bool Never! {
    if ir_body_node(p, b, table).kind == {
        .SelectStart -> return true
        .SelectRecv(previous, channel) -> {
            receivers.push(channel.copy())
            return ir_select_table(p, b, previous, receivers, durations)
        }
        .SelectAfter(previous, duration, value) -> {
            if value != None -> return false
            durations.push(duration.copy())
            return ir_select_table(p, b, previous, receivers, durations)
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> return false
    }
}
