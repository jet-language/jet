// Tail calls: on every level, compile-time code included, a
// Call whose result its function returns is a jump (X64Select.jet
// ir_x64_tail_jump), so tail recursion, mutual recursion too, runs in
// constant stack. ir_tail_calls runs on the module just before selection.
//
// The shape is the Call, then only Drops, the stop poll after the call (its
// If returning on a stop, with drops of its own) and Moves or Copies of the
// result, then the Return of the result (or of nothing, when the function
// has no result). The Drops after the call are of values the function owns.
// An argument among them is handed to the callee together with its drop:
// the call jumps to a variant of the callee (key `<key>#own<mask>`, bit i
// for parameter i) that owns those parameters, dropping each before every
// Return or handing it on to a tail call of its own. A variant's owned
// parameter that its tail call does not hand on is dropped before the jump,
// as is every other value dropped after the call. The stop poll moves before
// the jump, so an endless tail recursion still stops like a loop; a stop the
// callee meets reaches the caller's caller as its return does (edx).
//
// The call stays a call when:
//   - the callee has no instructions (an asm leaf, a stop poll);
//   - an argument does not fit an argument register;
//   - the result is an Aggregate;
//   - an argument that is not handed over may point into the frame: a
//     String, Pointer or Aggregate that is not a parameter the function
//     only borrows, or an Int not computed in place;
//   - an argument that is dropped after the call cannot be handed over
//     (the callee writes that parameter, or the value is passed twice).
// A value with visible cleanup (Close, defer) leaves its cleanup after the
// call, so that call never has the shape; sema's tail_call_blocked lint
// names it. Neither has a value whose Drop is not memory only (a process
// Child's Drop kills its tree, a handle's may close a resource): the jump
// would run that Drop before the callee instead of after it,
// so a call after which one is dropped stays a call (ir_tail_memory_only).
// A panic unwinding a variant does not drop its owned parameters.

use jet_foundation.[name_rows, name_rows_set, name_rows_value]

// Return.b of the Return after a tail Call: the Call is the jump.
IR_TAIL_JUMP: 1

// One function's tail calls: per call its index, its Return's index, the
// function it jumps to, the handed-over mask, the stop poll after it (-1:
// none) and the values dropped before the jump
// (drops[drop_start[k]..<drop_start[k + 1]]).
IRTailPlan: struct {
    calls: [Int]
    returns: [Int]
    targets: [Int]
    masks: [Int]
    polls: [Int]
    drop_start: [Int]
    drops: [Int]
}

// One tail call's shape (call -1: none): the handed-over mask, the stop
// poll after the call and the values dropped before the jump.
IRTailSite: struct {
    call: Int
    mask: Int
    poll: Int
    drops: [Int]
}

ir_tail_calls: fn(m: &IRModule) Never! {
    count: m.functions.len()
    poll: name_rows_value(m.function_rows, IR_STOP_POLL_KEY) ?? -1
    trap: name_rows_value(m.function_rows, IR_STOP_TRAP_KEY) ?? -1
    ownable := [Int]{}
    loop f in m.functions -> ownable.push(ir_tail_ownable(m, f))
    // Work items: item k < count is function k as built; each later one a
    // variant (function id k) of function sources[k] owning masks[k].
    sources := [Int]{}
    masks := [Int]{}
    loop id in 0..<count {
        sources.push(id)
        masks.push(0)
    }
    rows := name_rows()
    plans := [IRTailPlan]{}
    item := 0
    loop item < sources.len() {
        plan: ir_tail_plan(m, m.functions[sources[item]], masks[item], poll, trap, ownable, rows, sources, masks)
        plans.push(plan)
        item += 1
    }
    // The variants copy the bodies as built, before those are rewritten.
    loop variant in count..<sources.len() {
        source: sources[variant]
        v := m.functions[source].copy()
        base: if v.symbol != "" -> v.symbol.copy() else -> v.key.copy()
        v.key = "{v.key}#own<{masks[variant]}>"
        v.symbol = "{base}.own{masks[variant]}"
        v.symbol_hash = U64{0}
        ir_tail_rewrite(v, plans[variant], masks[variant])
        name_rows_set(m.function_rows, v.key, m.functions.len())
        m.functions.push(v)
    }
    loop id in 0..<count {
        if plans[id].calls.len() > 0 -> ir_tail_rewrite(m.functions[id], plans[id], 0)
    }
}

// The parameters of `f` a variant may own: bit i when parameter i is not an
// Aggregate and no instruction writes it.
ir_tail_ownable: fn(m: IRModule, f: IRFunction) -> Int Never! {
    if f.asm != None || f.param_count > 62 -> return 0
    written := [Bool]{}
    loop _ in 0..<f.param_count -> written.push(false)
    loop at in 0..<f.op.len() {
        slot: ir_x64_write(f, at)
        if slot >= 0 && slot < f.param_count -> written[slot] = true
    }
    mask := 0
    bit := 1
    loop slot in 0..<f.param_count {
        if !written[slot] && m.types[f.slot_type[slot]].kind != .Aggregate -> mask += bit
        bit *= 2
    }
    mask
}

// The tail calls of `f` owning the parameters in `owned`; a call handing
// values over names the variant it jumps to, queued as a work item when new.
ir_tail_plan: fn(m: IRModule, f: IRFunction, owned: Int, poll: Int, trap: Int, ownable: [Int], rows: &NameRows, sources: &[Int], masks: &[Int]) -> IRTailPlan Never! {
    plan := IRTailPlan{calls: [Int]{}, returns: [Int]{}, targets: [Int]{}, masks: [Int]{}, polls: [Int]{}, drop_start: [Int]{0}, drops: [Int]{}}
    if f.asm != None -> return plan
    loop at in 0..<f.op.len() {
        if f.op[at] != .Return -> next
        site: ir_tail_site(m, f, at, owned, poll, trap, ownable)
        if site.call < 0 -> next
        // Sites never overlap: a Return inside an earlier site's stop poll
        // has no Call shape of its own.
        if plan.returns.len() > 0 && site.call <= plan.returns[plan.returns.len() - 1] -> next
        callee: f.a[site.call]
        target := callee
        if site.mask != 0 {
            key: "{callee}#{site.mask}"
            target = name_rows_value(rows, key) ?? -1
            if target < 0 {
                target = sources.len()
                sources.push(callee)
                masks.push(site.mask)
                name_rows_set(rows, key, target)
            }
        }
        plan.calls.push(site.call)
        plan.returns.push(at)
        plan.targets.push(target)
        plan.masks.push(site.mask)
        plan.polls.push(site.poll)
        loop slot in site.drops -> plan.drops.push(slot)
        plan.drop_start.push(plan.drops.len())
    }
    plan
}

ir_tail_none: fn() -> IRTailSite Never! {
    IRTailSite{call: -1, mask: 0, poll: -1, drops: [Int]{}}
}

// The tail call the Return at `ret` ends, when it has the shape and its
// arguments allow a jump (ir_tail_calls).
ir_tail_site: fn(m: IRModule, f: IRFunction, ret: Int, owned: Int, poll: Int, trap: Int, ownable: [Int]) -> IRTailSite Never! {
    // Back from the Return over Drops, Moves, Copies and stop polls.
    at := ret - 1
    loop at >= 0 {
        op: f.op[at]
        if op == .Drop || op == .Move || op == .Copy {
            at -= 1
            next
        }
        if op != .End -> break
        opener: f.a[at]
        if !ir_tail_poll(m, f, opener, at, poll, trap) -> return ir_tail_none()
        at = opener - 2
    }
    if at < 0 || f.op[at] != .Call -> return ir_tail_none()
    call: at
    callee: f.a[call]
    if callee < 0 || callee >= m.functions.len() || callee == poll || callee == trap -> return ir_tail_none()
    if m.functions[callee].asm != None || m.functions[callee].op.len() == 0 -> return ir_tail_none()
    if f.c[call] != m.functions[callee].param_count -> return ir_tail_none()
    // Forward: the result's Moves, the Drops (of values other than it).
    dst: f.dst[call]
    current := dst
    dropped := [Int]{}
    stopped := [Int]{}
    stop_poll := -1
    at = call + 1
    loop at < ret {
        op: f.op[at]
        if op == .Call {
            // A stop poll the walk back checked: its If drops on a stop.
            if stop_poll < 0 -> stop_poll = at
            end: f.c[at + 1]
            loop inner in (at + 2)..<(end - 1) {
                if f.op[inner] == .Drop -> stopped.push(f.a[inner])
            }
            at = end + 1
            next
        }
        if op == .Drop {
            slot: f.a[at]
            if slot < 0 || slot == current || dropped.contains(slot) -> return ir_tail_none()
            dropped.push(slot)
        } else {
            if current < 0 || f.a[at] != current -> return ir_tail_none()
            current = f.dst[at]
        }
        at += 1
    }
    // A value the stop edge drops is one the call's path drops too.
    loop slot in stopped {
        if !dropped.contains(slot) -> return ir_tail_none()
    }
    returned: f.a[ret]
    if returned >= 0 {
        if returned != current || dropped.contains(current) -> return ir_tail_none()
        if m.types[f.slot_type[returned]].kind == .Aggregate -> return ir_tail_none()
    } else {
        if f.result >= 0 && m.types[f.result].kind != .Unit -> return ir_tail_none()
    }
    if dst >= 0 && m.types[f.slot_type[dst]].kind == .Aggregate -> return ir_tail_none()
    // Every argument in a register; the ones dropped after the call (or the
    // owned parameters) handed over, the others safe past the frame.
    general := 0
    floats := 0
    mask := 0
    bit := 1
    handed := [Int]{}
    start: f.b[call]
    loop position in start..<(start + f.c[call]) {
        slot: f.args[position]
        class: ir_x64_slot_class(m, f, slot)
        if class == .Float {
            floats += 1
        } else if class != .Empty {
            general += 1
        }
        own: ownable[callee].bit_and(bit) != 0 && !handed.contains(slot)
        param_owned: slot < f.param_count && ir_tail_has(owned, slot)
        if own && (dropped.contains(slot) || param_owned) {
            mask += bit
            handed.push(slot)
        } else if dropped.contains(slot) || param_owned || !ir_tail_safe(m, f, slot) {
            return ir_tail_none()
        }
        bit *= 2
    }
    if general > IR_X64_ARGUMENT_REGISTERS.len() || floats > 8 -> return ir_tail_none()
    drops := [Int]{}
    loop slot in dropped {
        if !handed.contains(slot) -> drops.push(slot)
    }
    loop slot in 0..<f.param_count {
        if ir_tail_has(owned, slot) && !handed.contains(slot) -> drops.push(slot)
    }
    loop slot in drops {
        if !ir_tail_memory_only(m, f.slot_type[slot]) -> return ir_tail_none()
    }
    IRTailSite{call: call, mask: mask, poll: stop_poll, drops: drops.move()}
}

// Whether dropping a value of type row `ty` only frees memory, so nothing
// can observe it running before the tail jump: a trivial Drop, a String or
// an Int. Every other Drop (a handle's, an Aggregate's glue, which may reach
// one) may close or stop something, and keeps its place after the call.
ir_tail_memory_only: fn(m: IRModule, ty: Int) -> Bool Never! {
    t: m.types[ty]
    t.drop == "" || t.kind == .String || t.kind == .Int
}

ir_tail_bit: fn(index: Int) -> Int Never! {
    bit := 1
    loop _ in 0..<index -> bit *= 2
    bit
}

// Whether `mask` has bit `index`.
ir_tail_has: fn(mask: Int, index: Int) -> Bool Never! {
    mask.bit_and(ir_tail_bit(index)) != 0
}

// Whether the If at `opener` (its End at `end`) is the stop poll after a
// call: `call s <- poll`, `if s`, Drops (inside the runtime cleanup scope
// jet_rt_cleanup_enter/leave when there are any), `return`, `end`.
ir_tail_poll: fn(m: IRModule, f: IRFunction, opener: Int, end: Int, poll: Int, trap: Int) -> Bool Never! {
    if opener < 1 || f.op[opener] != .If || f.b[opener] >= 0 -> return false
    check: opener - 1
    if f.op[check] != .Call || (f.a[check] != poll && f.a[check] != trap) || f.dst[check] != f.a[opener] -> return false
    if end - 1 <= opener || f.op[end - 1] != .Return || f.a[end - 1] >= 0 -> return false
    loop at in (opener + 1)..<(end - 1) {
        if f.op[at] == .Drop -> next
        if f.op[at] == .CallRuntime && (m.names[f.a[at]] == "jet_rt_cleanup_enter" || m.names[f.a[at]] == "jet_rt_cleanup_leave") -> next
        return false
    }
    true
}

// Whether argument `slot`, not handed over, stays valid once the frame is
// gone: a value of no storage, a parameter the function borrows, or an Int
// computed in place (one not dropped after the call is inline).
ir_tail_safe: fn(m: IRModule, f: IRFunction, slot: Int) -> Bool Never! {
    kind: m.types[f.slot_type[slot]].kind
    if kind == {
        .Unit | .Bool | .Word | .Float | .Float32 | .Char -> return true
        else -> {}
    }
    if slot < f.param_count -> return true
    if kind != .Int -> return false
    loop at in 0..<f.op.len() {
        if ir_x64_write(f, at) != slot -> next
        if f.op[at] == {
            .Const | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Neg -> {}
            else -> return false
        }
    }
    true
}

// Rewrites `f` (owning the parameters in `owned`) by `plan`: each tail call
// drops its values, then polls for a stop as it did after the call (on a
// stop it drops the values it would hand over and returns), then is the Call
// to its target and a marked Return; each other Return first drops the owned
// parameters it does not return (itself or by a Move of it).
ir_tail_rewrite: fn(f: &IRFunction, plan: IRTailPlan, owned: Int) Never! {
    code := IROptCode{op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, line: [Int]{}}
    params := [Int]{}
    loop slot in 0..<f.param_count {
        if ir_tail_has(owned, slot) -> params.push(slot)
    }
    site := 0
    at := 0
    loop at < f.op.len() {
        line: f.code_line[at]
        if site < plan.calls.len() && at == plan.calls[site] {
            loop k in plan.drop_start[site]..<plan.drop_start[site + 1] -> ir_opt_code_put(code, .Drop, -1, plan.drops[k], -1, -1, line)
            poll: plan.polls[site]
            if poll >= 0 {
                // The stop edge as built, its Drops those of the values the
                // jump would hand over, inside its cleanup scope if it has one.
                stop: f.c[poll + 1] - 1
                ir_opt_code_put(code, .Call, f.dst[poll], f.a[poll], f.b[poll], f.c[poll], f.code_line[poll])
                ir_opt_code_put(code, .If, -1, f.a[poll + 1], -1, -1, f.code_line[poll])
                scoped := false
                loop inner in (poll + 2)..<stop {
                    if f.op[inner] == .CallRuntime && f.dst[inner] >= 0 -> scoped = true
                }
                if !scoped -> ir_tail_put_handed(code, f, at, plan.masks[site], line)
                loop inner in (poll + 2)..<stop {
                    if f.op[inner] == .Drop -> next
                    ir_opt_code_put(code, f.op[inner], f.dst[inner], f.a[inner], f.b[inner], f.c[inner], f.code_line[inner])
                    if scoped && f.dst[inner] >= 0 -> ir_tail_put_handed(code, f, at, plan.masks[site], line)
                }
                ir_opt_code_put(code, .Return, f.dst[stop], f.a[stop], f.b[stop], f.c[stop], f.code_line[stop])
                ir_opt_code_put(code, .End, -1, -1, -1, -1, f.code_line[poll])
            }
            ir_opt_code_put(code, .Call, f.dst[at], plan.targets[site], f.b[at], f.c[at], line)
            ret: plan.returns[site]
            returned: if f.a[ret] >= 0 -> f.dst[at] else -> -1
            ir_opt_code_put(code, .Return, -1, returned, IR_TAIL_JUMP, -1, f.code_line[ret])
            at = ret + 1
            site += 1
            next
        }
        if f.op[at] == .Return {
            loop slot in params {
                if !ir_tail_returns(f, f.a[at], slot) -> ir_opt_code_put(code, .Drop, -1, slot, -1, -1, line)
            }
        }
        ir_opt_code_put(code, f.op[at], f.dst[at], f.a[at], f.b[at], f.c[at], line)
        at += 1
    }
    count: f.op.len()
    if params.len() > 0 && (count == 0 || (f.op[count - 1] != .Return && f.op[count - 1] != .Unreachable)) {
        loop slot in params -> ir_opt_code_put(code, .Drop, -1, slot, -1, -1, f.line)
        ir_opt_code_put(code, .Return, -1, -1, -1, -1, f.line)
    }
    f.op = code.op.move()
    f.dst = code.dst.move()
    f.a = code.a.move()
    f.b = code.b.move()
    f.c = code.c.move()
    f.code_line = code.line.move()
    ir_opt_compact(f)
}

// Drops of the arguments of the Call at `call` that `mask` hands over.
ir_tail_put_handed: fn(code: &IROptCode, f: IRFunction, call: Int, mask: Int, line: Int) Never! {
    loop position in 0..<f.c[call] {
        if ir_tail_has(mask, position) -> ir_opt_code_put(code, .Drop, -1, f.args[f.b[call] + position], -1, -1, line)
    }
}

// Whether `returned` is parameter `slot` or a Move of it.
ir_tail_returns: fn(f: IRFunction, returned: Int, slot: Int) -> Bool Never! {
    if returned < 0 -> return false
    if returned == slot -> return true
    loop at in 0..<f.op.len() {
        if f.dst[at] == returned && f.op[at] == .Move && f.a[at] == slot -> return true
    }
    false
}
