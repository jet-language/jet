// Scalar replacement of frame aggregates (O1 and O2): frame storage
// (StackAddress, written once) whose address is the base of Loads and
// Stores at constant offsets becomes one slot per field, so its fields live
// in registers instead of memory. A Store becomes a move into the field's
// slot and a Load a move out of it: the bytes a Store writes and a Load of
// the same type reads back are exactly the slot's value. The address may
// pass through aliases (slots written once by a Move of it, such as an
// inlined call's result); their Loads and Stores are the storage's own and
// their Moves go with it.
//
// With `promote`, the address may also be lent out: to a Drop, or to a call
// or CopyBytes outside every Loop. The storage then stays, and the fields
// go back to it before each such use (every field: the stored bytes are
// what the memory form would hold) and, unless it is a Drop, come back from
// it after (the callee may have changed them). A call can only borrow the
// address for its own duration, so nothing reaches the storage between
// these points but the field slots.
//
// A CopyBytes into or out of the storage, at its address or through a view
// (an Offset of it that only CopyBytes read), at any depth, is no loan: it
// becomes moves between the fields of two replaced storages (each then gets
// the other's fields inside the copied range too), Loads from the source
// address into the target's fields, or Stores of the source's fields to the
// target address. The bytes a replaced storage holds are its fields, so no
// field may straddle the copied range's edge, a copy out of one to memory
// needs fields covering the range, and so does a copy into one that is
// also lent (its storage gets only the fields back). A copy that cannot be
// rewritten so is a loan where one is allowed and refuses the storage
// otherwise.
//
// Refused for the whole storage when its address is used any other way
// (stored, returned, offset other than as a view, lent inside a Loop),
// when two accesses of one offset have different types, when fields
// overlap or leave the storage, or when a field is itself an aggregate.
use jet_foundation.[compiler_threads_single]

ir_opt_scalar_replace: fn(m: IRModule, f: ^IRFunction, promote: Bool) -> Int Never! {
    has_stack := false
    loop op in f.op {
        if op == .StackAddress {
            has_stack = true
            break
        }
    }
    if !has_stack -> return 0
    facts: ir_opt_facts(f)
    count: f.slot_type.len()
    candidate := [Bool]{}
    loop slot in 0..<count {
        def: if slot >= f.param_count && facts.defs[slot] == 1 -> facts.def_at[slot] else -> -1
        candidate.push(def >= 0 && f.op[def] == .StackAddress)
    }
    // Aliases: a slot written once, by a Move of a candidate's address or of
    // another alias (an inlined call's result, a variable bound to it). Its
    // Loads and Stores are the storage's own; any other use refuses it.
    root := [Int]{}
    loop _ in 0..<count -> root.push(-1)
    loop at in 0..<f.op.len() {
        if f.op[at] != .Move -> next
        dst: f.dst[at]
        source: f.a[at]
        if dst < f.param_count || dst >= count || source < 0 || facts.defs[dst] != 1 || candidate[dst] {
            next
        }
        if candidate[source] -> root[dst] = source else if root[source] >= 0 {
            root[dst] = root[source]
        }
    }
    offsets := [[Int]]{}
    rows := [[Int]]{}
    lent := [Bool]{}
    loop _ in 0..<count {
        offsets.push([Int]{})
        rows.push([Int]{})
        lent.push(false)
    }
    // CopyBytes with a candidate's storage on a side, at its address or
    // through a view: an Offset of it that only CopyBytes read.
    copies := [OptScalarCopy]{}
    view_slot := [Int]{}
    view_offset := [Int]{}
    view_reads := [Int]{}
    loop _ in 0..<count {
        view_slot.push(-1)
        view_offset.push(0)
        view_reads.push(0)
    }
    // Open Loops around each instruction.
    depth := 0
    open := [IROp]{}
    reads := [Int]{}
    loop at in 0..<f.op.len() {
        op: f.op[at]
        if op == .End || op == .Else {
            closed: open.pop() ?? panic("ir_opt_scalar_replace: End without an open construct")
            if closed == .Loop -> depth -= 1
        }
        if op == .Block || op == .Loop || op == .If || op == .Else {
            open.push(op.copy())
            if op == .Loop -> depth += 1
        }
        if op == .Offset && f.a[at] >= 0 && candidate[f.a[at]] && f.dst[at] >= 0 && f.dst[at] != f.a[at] && facts.defs[f.dst[at]] == 1 {
            view_slot[f.dst[at]] = f.a[at]
            view_offset[f.dst[at]] = f.b[at]
            next
        }
        // A copy through an alias is a use of its storage like any other.
        if op == .CopyBytes && f.a[at] != f.b[at] && (f.a[at] < 0 || root[f.a[at]] < 0) && (f.b[at] < 0 || root[f.b[at]] < 0) {
            target: ir_opt_copy_side(f, facts, candidate, view_slot, view_offset, f.a[at], f.c[at])
            source: ir_opt_copy_side(f, facts, candidate, view_slot, view_offset, f.b[at], f.c[at])
            // A copy within one storage could overwrite fields it still reads.
            if target.slot > -2 && source.slot > -2 && (target.slot >= 0 || source.slot >= 0) && target.slot != source.slot {
                loose: promote && depth == 0
                copies.push(OptScalarCopy{at: at, target: target.slot, target_offset: target.offset, target_loose: loose && target.slot == f.a[at], source: source.slot, source_offset: source.offset, source_loose: loose && source.slot == f.b[at], size: f.c[at]})
                if target.slot >= 0 && target.slot != f.a[at] {
                    view_reads[f.a[at]] = view_reads[f.a[at]] + 1
                }
                if source.slot >= 0 && source.slot != f.b[at] {
                    view_reads[f.b[at]] = view_reads[f.b[at]] + 1
                }
                next
            }
        }
        ir_x64_reads_into(f, at, reads)
        loop read in reads {
            if read < 0 -> next
            // The Move that makes an alias is no use of the storage.
            if op == .Move && f.dst[at] >= 0 && root[f.dst[at]] >= 0 -> next
            if view_slot[read] >= 0 {
                candidate[view_slot[read]] = false
                next
            }
            slot: if root[read] >= 0 -> root[read] else -> read
            if !candidate[slot] -> next
            if op == .Load && f.a[at] == read {
                offsets[slot].push(f.b[at])
                rows[slot].push(f.slot_type[f.dst[at]])
            } else if op == .Store && f.a[at] == read && f.c[at] != read {
                offsets[slot].push(f.b[at])
                rows[slot].push(f.slot_type[f.c[at]])
            } else if promote && read == slot && ir_opt_lends(f, at, slot, depth) {
                lent[slot] = true
            } else { candidate[slot] = false }
        }
    }
    // A view read any other way (or before its Offset) refuses its storage.
    loop view in 0..<count {
        if view_slot[view] >= 0 && view_reads[view] != facts.uses[view] {
            candidate[view_slot[view]] = false
        }
    }
    // Own accesses that do not fit refuse the storage before copies settle,
    // which then only add fields that fit (checked as they settle).
    loop slot in 0..<count {
        if candidate[slot] && !ir_opt_fields_fit(m, offsets[slot], rows[slot], f.a[facts.def_at[slot]]) {
            candidate[slot] = false
        }
    }
    rewrite := [Bool]{}
    loop _ in copies -> rewrite.push(true)
    if copies.len() > 0 {
        extras: ir_opt_resolve_copies(m, copies, rewrite, candidate, lent, offsets, rows)
        // Each storage also gets the fields copies bring it, after its own
        // accesses (the rewrite below walks only those, in order).
        loop slot in 0..<count {
            if !candidate[slot] -> next
            loop k in 0..<extras.offsets[slot].len() {
                offsets[slot].push(extras.offsets[slot][k])
                rows[slot].push(extras.rows[slot][k])
            }
        }
    }
    replaced := 0
    // fields[slot][k]: offsets[slot][k]'s new slot; distinct[slot]: each
    // new slot once, as (offset, slot) pairs.
    fields := [[Int]]{}
    distinct := [[Int]]{}
    loop slot in 0..<count {
        fields.push([Int]{})
        distinct.push([Int]{})
        if !candidate[slot] || offsets[slot].len() == 0 -> next
        size: f.a[facts.def_at[slot]]
        if !ir_opt_fields_fit(m, offsets[slot], rows[slot], size) {
            candidate[slot] = false
            next
        }
        // One new slot per distinct offset, in first-access order.
        seen := [Int:Int]{}
        loop k in 0..<offsets[slot].len() {
            offset: offsets[slot][k]
            found: seen.get(offset) ?? -1
            if found >= 0 {
                fields[slot].push(found)
                next
            }
            field: ir_slot(f, rows[slot][k], IRSlotKind.Local, -1, 0)
            seen[offset] = field
            fields[slot].push(field)
            distinct[slot].push(offset)
            distinct[slot].push(field)
        }
        replaced += 1
    }
    if replaced == 0 -> return 0
    // Lent storage stays, its bytes the fields only around each loan, so
    // its address and the aliases of it no longer locate a variable
    // (IRFunction.scattered).
    loop slot in 0..<count {
        base: if candidate[slot] -> slot else -> root[slot]
        if base < 0 || !candidate[base] || offsets[base].len() == 0 || !lent[base] || f.scattered.contains(slot) {
            next
        }
        f.scattered.push(slot)
    }
    // Rewrite the accesses in the order they were recorded; lent storage
    // gets its fields back around each loan.
    cursor := [Int]{}
    loop _ in 0..<count -> cursor.push(0)
    code := IROptCode{op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, line: [Int]{}}
    next_copy := 0
    loop at in 0..<f.op.len() {
        op: f.op[at]
        line: f.code_line[at]
        loop next_copy < copies.len() && copies[next_copy].at < at -> next_copy += 1
        if next_copy < copies.len() && copies[next_copy].at == at && rewrite[next_copy] {
            ir_opt_copy_fields(code, f, candidate, distinct, copies[next_copy], line)
            next
        }
        // A view of replaced storage: every copy through it was rewritten.
        if op == .Offset && f.dst[at] >= 0 && view_slot[f.dst[at]] >= 0 && candidate[view_slot[f.dst[at]]] {
            next
        }
        if op == .StackAddress && f.dst[at] >= 0 && candidate[f.dst[at]] && offsets[f.dst[at]].len() > 0 && !lent[f.dst[at]] {
            next
        }
        // An alias of storage that is gone has nothing left to name.
        if op == .Move && f.dst[at] >= 0 && root[f.dst[at]] >= 0 && candidate[root[f.dst[at]]] && offsets[root[f.dst[at]]].len() > 0 && !lent[root[f.dst[at]]] {
            next
        }
        access: if (op == .Load || op == .Store) && f.a[at] >= 0 && root[f.a[at]] >= 0 -> root[f.a[at]] else -> f.a[at]
        if (op == .Load || op == .Store) && access >= 0 && candidate[access] && !(op == .Store && f.c[at] == f.a[at]) {
            base: access
            field: fields[base][cursor[base]]
            cursor[base] = cursor[base] + 1
            if op == .Load -> ir_opt_code_put(code, .Move, f.dst[at], field, -1, -1, line) else {
                ir_opt_code_put(code, .Move, field, f.c[at], -1, -1, line)
            }
            next
        }
        // Loans: the fields go back before, and come back after.
        ir_x64_reads_into(f, at, reads)
        loans := [Int]{}
        loop slot in reads {
            if slot < 0 || !candidate[slot] || offsets[slot].len() == 0 || loans.contains(slot) {
                next
            }
            loans.push(slot)
            k := 0
            loop k < distinct[slot].len() {
                ir_opt_code_put(code, .Store, -1, slot, distinct[slot][k], distinct[slot][k + 1], line)
                k += 2
            }
        }
        ir_opt_code_put(code, op, f.dst[at], f.a[at], f.b[at], f.c[at], line)
        if op == .Drop -> next
        loop slot in loans {
            k := 0
            loop k < distinct[slot].len() {
                ir_opt_code_put(code, .Load, distinct[slot][k + 1], slot, distinct[slot][k], -1, line)
                k += 2
            }
        }
    }
    f.op = code.op.move()
    f.dst = code.dst.move()
    f.a = code.a.move()
    f.b = code.b.move()
    f.c = code.c.move()
    f.code_line = code.line.move()
    ir_opt_compact(f)
    replaced
}

// A CopyBytes the pass may rewrite. Each side is a candidate's storage at a
// byte offset (`target`/`source` the candidate slot), or memory at the
// instruction's own operand (-1, offset 0). A side may fall back to a loan
// (`*_loose`) when it is the storage's address itself, outside every Loop,
// with `promote`.
OptScalarCopy: struct {
    at: Int,
    target: Int,
    target_offset: Int,
    target_loose: Bool,
    source: Int,
    source_offset: Int,
    source_loose: Bool,
    size: Int,
}

// One side of a CopyBytes of `size` bytes through address `slot`: the
// candidate and offset it copies, -1 for memory, or -2 when it is a
// candidate's address or view but the bytes leave the storage.
OptScalarSide: struct {
    slot: Int,
    offset: Int,
}

ir_opt_copy_side: fn(f: IRFunction, facts: OptFacts, candidate: [Bool], view_slot: [Int], view_offset: [Int], slot: Int, size: Int) -> OptScalarSide Never! {
    if slot < 0 -> return OptScalarSide{slot: -1, offset: 0}
    storage := slot
    offset := 0
    if !candidate[slot] {
        if view_slot[slot] < 0 || !candidate[view_slot[slot]] {
            return OptScalarSide{slot: -1, offset: 0}
        }
        storage = view_slot[slot]
        offset = view_offset[slot]
    }
    if offset < 0 || size <= 0 || offset + size > f.a[facts.def_at[storage]] {
        return OptScalarSide{slot: -2, offset: 0}
    }
    OptScalarSide{slot: storage, offset: offset}
}

// The fields copies bring each candidate beyond its own accesses, as
// parallel offset and row lists per slot.
OptScalarExtras: struct {
    offsets: [[Int]],
    rows: [[Int]],
}

// Settles which copies are rewritten (see the head comment). A copy that is
// not lends its candidate sides where they are loose and refuses them
// otherwise, which can unsettle other copies, so this repeats until nothing
// changes. Returns the fields the rewritten copies bring.
ir_opt_resolve_copies: fn(m: IRModule, copies: [OptScalarCopy], rewrite: ^[Bool], candidate: ^[Bool], lent: ^[Bool], offsets: [[Int]], rows: [[Int]]) -> OptScalarExtras Never! {
    loop {
        extras := OptScalarExtras{offsets: [[Int]]{}, rows: [[Int]]{}}
        loop _ in 0..<candidate.len() {
            extras.offsets.push([Int]{})
            extras.rows.push([Int]{})
        }
        clash := [Bool]{}
        loop _ in copies -> clash.push(false)
        // Between two candidates, a field of either side inside the copied
        // range is a field of the other at the same place in it.
        grown := true
        loop grown {
            grown = false
            loop k in 0..<copies.len() {
                entry: copies[k]
                if !rewrite[k] || entry.target < 0 || entry.source < 0 || !candidate[entry.target] || !candidate[entry.source] {
                    next
                }
                loop way in 0..<2 {
                    from: if way == 0 -> entry.source else -> entry.target
                    from_offset: if way == 0 -> entry.source_offset else -> entry.target_offset
                    into: if way == 0 -> entry.target else -> entry.source
                    into_offset: if way == 0 -> entry.target_offset else -> entry.source_offset
                    total: offsets[from].len() + extras.offsets[from].len()
                    loop index in 0..<total {
                        own: index < offsets[from].len()
                        offset: if own -> offsets[from][index] else -> extras.offsets[from][index - offsets[from].len()]
                        row: if own -> rows[from][index] else -> extras.rows[from][index - offsets[from].len()]
                        if offset < from_offset || offset >= from_offset + entry.size -> next
                        placed: offset - from_offset + into_offset
                        found: ir_opt_row_at(offsets[into], rows[into], extras.offsets[into], extras.rows[into], placed)
                        if found == row -> next
                        if found >= 0 {
                            clash[k] = true
                            next
                        }
                        extras.offsets[into].push(placed)
                        extras.rows[into].push(row)
                        grown = true
                    }
                }
            }
        }
        changed := false
        loop k in 0..<copies.len() {
            if !rewrite[k] -> next
            entry: copies[k]
            target: entry.target >= 0 && candidate[entry.target]
            source: entry.source >= 0 && candidate[entry.source]
            if !target && !source {
                rewrite[k] = false
                next
            }
            ok := !clash[k]
            if ok && target {
                covered: ir_opt_range_covered(m, offsets[entry.target], rows[entry.target], extras.offsets[entry.target], extras.rows[entry.target], entry.target_offset, entry.size)
                ok = covered >= 0 && (!lent[entry.target] || covered == entry.size)
            }
            if ok && source {
                covered: ir_opt_range_covered(m, offsets[entry.source], rows[entry.source], extras.offsets[entry.source], extras.rows[entry.source], entry.source_offset, entry.size)
                ok = covered >= 0 && (target || covered == entry.size)
            }
            if ok -> next
            rewrite[k] = false
            changed = true
            if target {
                if entry.target_loose -> lent[entry.target] = true else {
                    candidate[entry.target] = false
                }
            }
            if source {
                if entry.source_loose -> lent[entry.source] = true else {
                    candidate[entry.source] = false
                }
            }
        }
        if !changed -> return extras
    }
}

// The row of the field at `offset` among a candidate's own accesses and its
// extras, or -1 for none.
ir_opt_row_at: fn(offsets: [Int], rows: [Int], extra_offsets: [Int], extra_rows: [Int], offset: Int) -> Int Never! {
    loop k in 0..<offsets.len() {
        if offsets[k] == offset -> return rows[k]
    }
    loop k in 0..<extra_offsets.len() {
        if extra_offsets[k] == offset -> return extra_rows[k]
    }
    -1
}

// The bytes of `start`..<`start + size` that a candidate's fields (own and
// extra) cover, when they do not overlap or disagree on a type and none
// straddles the range's edge; -1 otherwise.
ir_opt_range_covered: fn(m: IRModule, offsets: [Int], rows: [Int], extra_offsets: [Int], extra_rows: [Int], start: Int, size: Int) -> Int Never! {
    all_offsets := offsets.copy()  // copy: the candidate keeps its own accesses
    all_rows := rows.copy()  // copy: as above
    loop k in 0..<extra_offsets.len() {
        all_offsets.push(extra_offsets[k])
        all_rows.push(extra_rows[k])
    }
    // Every field lies inside its storage already (own accesses are checked
    // after this, extras come from inside a copied range), so the bound
    // here only lets the overlap and type checks run.
    if !ir_opt_fields_fit(m, all_offsets, all_rows, ir_opt_fields_end(m, all_offsets, all_rows)) {
        return -1
    }
    seen := [Int]{}
    covered := 0
    loop k in 0..<all_offsets.len() {
        offset: all_offsets[k]
        if seen.contains(offset) -> next
        seen.push(offset)
        width: ir_x64_value_width(ir_x64_shape(m.types[all_rows[k]]))
        if offset + width <= start || offset >= start + size -> next
        if offset < start || offset + width > start + size -> return -1
        covered += width
    }
    covered
}

// One past the last byte any of the fields reaches.
ir_opt_fields_end: fn(m: IRModule, offsets: [Int], rows: [Int]) -> Int Never! {
    end := 0
    loop k in 0..<offsets.len() {
        reach: offsets[k] + ir_x64_value_width(ir_x64_shape(m.types[rows[k]]))
        if reach > end -> end = reach
    }
    end
}

// A rewritten copy: moves between the fields of two candidates, Loads from
// the source address into the target's fields, or Stores of the source's
// fields to the target address; only fields inside the copied range. An
// address operand points at the range's first byte, whether it is a
// storage's own address or a view.
ir_opt_copy_fields: fn(code: ^IROptCode, f: IRFunction, candidate: [Bool], distinct: [[Int]], entry: OptScalarCopy, line: Int) Never! {
    target: entry.target >= 0 && candidate[entry.target]
    source: entry.source >= 0 && candidate[entry.source]
    k := 0
    if target {
        pairs: distinct[entry.target]
        loop k < pairs.len() {
            offset: pairs[k]
            field: pairs[k + 1]
            k += 2
            if offset < entry.target_offset || offset >= entry.target_offset + entry.size -> next
            placed: offset - entry.target_offset
            if source {
                ir_opt_code_put(code, .Move, field, ir_opt_field_at(distinct[entry.source], placed + entry.source_offset), -1, -1, line)
            } else { ir_opt_code_put(code, .Load, field, f.b[entry.at], placed, -1, line) }
        }
        return
    }
    pairs: distinct[entry.source]
    loop k < pairs.len() {
        offset: pairs[k]
        field: pairs[k + 1]
        k += 2
        if offset < entry.source_offset || offset >= entry.source_offset + entry.size -> next
        ir_opt_code_put(code, .Store, -1, f.a[entry.at], offset - entry.source_offset, field, line)
    }
}

// The field slot at `offset` among (offset, slot) pairs.
ir_opt_field_at: fn(pairs: [Int], offset: Int) -> Int Never! {
    k := 0
    loop k < pairs.len() {
        if pairs[k] == offset -> return pairs[k + 1]
        k += 2
    }
    panic("ir_opt_field_at: no field at offset {offset}")
}

// Whether instruction `at`, `depth` Loops deep, only lends the address in
// `slot` for its own duration: a Drop of the storage, or outside every Loop
// a call argument or a CopyBytes operand.
ir_opt_lends: fn(f: IRFunction, at: Int, slot: Int, depth: Int) -> Bool Never! {
    op: f.op[at]
    if op == .Drop -> return f.a[at] == slot
    if depth > 0 -> return false
    if op == .Call || op == .CallRuntime || op == .CallIndirect {
        return f.dst[at] != slot && (op != .CallIndirect || f.a[at] != slot)
    }
    op == .CopyBytes
}

// The code a pass writes back (call arguments stay in `args`).
IROptCode: struct {
    op: [IROp],
    dst: [Int],
    a: [Int],
    b: [Int],
    c: [Int],
    line: [Int],
}

ir_opt_code_put: fn(code: ^IROptCode, op: IROp, dst: Int, a: Int, b: Int, c: Int, line: Int) Never! {
    code.op.push(op.copy())
    code.dst.push(dst)
    code.a.push(a)
    code.b.push(b)
    code.c.push(c)
    code.line.push(line)
}

// Whether the accesses (offset, slot type row) of one storage of `size`
// bytes describe disjoint, same-typed, non-aggregate fields inside it.
ir_opt_fields_fit: fn(m: IRModule, offsets: [Int], rows: [Int], size: Int) -> Bool Never! {
    loop k in 0..<offsets.len() {
        ty: ir_x64_shape(m.types[rows[k]])
        if ty.kind == .Aggregate || ty.kind == .Unit || ty.size > 8 -> return false
        width: ir_x64_value_width(ty)
        if offsets[k] < 0 || offsets[k] + width > size -> return false
        loop other in 0..<offsets.len() {
            if offsets[other] == offsets[k] {
                if rows[other] != rows[k] -> return false
                next
            }
            other_width: ir_x64_value_width(ir_x64_shape(m.types[rows[other]]))
            if offsets[k] < offsets[other] + other_width && offsets[other] < offsets[k] + width {
                return false
            }
        }
    }
    true
}

// rec(): a 16-byte frame record, its address bound to the named `items`,
// one field stored and loaded back through it. Lent to a Drop (with
// `promote`), the storage stays for the loan with its field in a slot, so
// the address and its alias are scattered (IRFunction.scattered): no
// variable is located in its stale bytes. Not lent, the storage goes and
// nothing is scattered.
#Test("Lent storage split into fields leaves its address and aliases scattered") {
    cases: [Bool]{true, false}
    loop lent in cases {
        m := ir_module_new()
        word: ir_word_row(m)
        f := ir_function_new("rec", "test:rec.jet.rec", "", "rec.jet", 1)
        base: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
        items: ir_slot(f, word, IRSlotKind.Local, ir_intern_name(m, "items"), 2)
        v: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
        got: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(f, IROp.StackAddress, base, 16, -1, -1, 1)
        _ := ir_emit(f, IROp.Move, items, base, -1, -1, 2)
        _ := ir_emit(f, IROp.Const, v, 7, -1, -1, 2)
        _ := ir_emit(f, IROp.Store, -1, items, 0, v, 2)
        _ := ir_emit(f, IROp.Load, got, items, 0, -1, 3)
        if lent -> _ := ir_emit(f, IROp.Drop, -1, base, -1, -1, 4)
        _ := ir_emit(f, IROp.Return, -1, got, -1, -1, 4)
        assert_eq(ir_opt_scalar_replace(m, f, true), 1)
        if lent {
            assert(f.scattered.contains(base), "the lent storage's address")
            assert(f.scattered.contains(items), "its alias, the named items")
            assert_eq(f.scattered.len(), 2)
        } else {
            assert_eq(f.scattered.len(), 0)
            loop op in f.op -> assert(op != .StackAddress, "storage with no loan goes")
        }
    }
}

#Test("Disjoint field borrows of one local survive &self calls across O0, O1, and O2") {
    loop level in ([Int]{0, 1, 2}) {
        m := ir_module_new()
        word: ir_word_row(m)
        ptr: ir_pointer_row(m)
        // Callee 0: record_log(^self, delta) mutates field at offset 0 only.
        callee := ir_function_new("record_log", "test:disjoint.jet.record_log", "", "disjoint.jet", 1)
        p_self: ir_slot(callee, ptr, IRSlotKind.Param, ir_intern_name(m, "self"), 1)
        p_delta: ir_slot(callee, word, IRSlotKind.Param, ir_intern_name(m, "delta"), 1)
        callee.param_count = 2
        cur: ir_slot(callee, word, IRSlotKind.Temp, -1, 0)
        next_val: ir_slot(callee, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(callee, IROp.Load, cur, p_self, 0, -1, 2)
        _ := ir_emit(callee, IROp.Add, next_val, cur, p_delta, IR_OVERFLOW_WRAP, 2)
        _ := ir_emit(callee, IROp.Store, -1, p_self, 0, next_val, 2)
        _ := ir_emit(callee, IROp.Return, -1, -1, -1, -1, 3)
        callee_id: m.functions.len()
        ir_function_bind(m, callee.key, callee_id)
        m.functions.push(callee)

        // Callee 1: bump(&x) mutates the disjoint field passed by address.
        bump := ir_function_new("bump", "test:disjoint.jet.bump", "", "disjoint.jet", 5)
        b_ptr: ir_slot(bump, ptr, IRSlotKind.Param, ir_intern_name(m, "x"), 5)
        bump.param_count = 1
        b_cur: ir_slot(bump, word, IRSlotKind.Temp, -1, 0)
        b_one: ir_slot(bump, word, IRSlotKind.Temp, -1, 0)
        b_out: ir_slot(bump, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(bump, IROp.Load, b_cur, b_ptr, 0, -1, 6)
        _ := ir_emit(bump, IROp.Const, b_one, 7, -1, -1, 6)
        _ := ir_emit(bump, IROp.Add, b_out, b_cur, b_one, IR_OVERFLOW_WRAP, 6)
        _ := ir_emit(bump, IROp.Store, -1, b_ptr, 0, b_out, 6)
        _ := ir_emit(bump, IROp.Return, -1, -1, -1, -1, 7)
        bump_id: m.functions.len()
        ir_function_bind(m, bump.key, bump_id)
        m.functions.push(bump)

        // Caller: 24-byte local struct `s` (log@0, hits@8, tag@16); holds two
        // disjoint field borrows `h = ^s.hits` and `t = ^s.tag` across
        // `^self.log` calls `record_log(s, 5)` and `record_log(s, 3)` plus `bump(h)`.
        run := ir_function_new("run", "test:disjoint.jet.run", "", "disjoint.jet", 10)
        run.result = word
        s: ir_slot(run, ptr, IRSlotKind.Local, ir_intern_name(m, "s"), 10)
        c0: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        c10: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        c100: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        h: ir_slot(run, ptr, IRSlotKind.Local, ir_intern_name(m, "h"), 11)
        t: ir_slot(run, ptr, IRSlotKind.Local, ir_intern_name(m, "t"), 12)
        d5: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        d3: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        tv: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        c20: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        tv2: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        r_log: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        r_h: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        r_t: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        sum1: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        sum2: ir_slot(run, word, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(run, IROp.StackAddress, s, 24, 8, -1, 10)
        _ := ir_emit(run, IROp.Const, c0, 0, -1, -1, 10)
        _ := ir_emit(run, IROp.Const, c10, 10, -1, -1, 10)
        _ := ir_emit(run, IROp.Const, c100, 100, -1, -1, 10)
        _ := ir_emit(run, IROp.Store, -1, s, 0, c0, 10)
        _ := ir_emit(run, IROp.Store, -1, s, 8, c10, 10)
        _ := ir_emit(run, IROp.Store, -1, s, 16, c100, 10)
        _ := ir_emit(run, IROp.Offset, h, s, 8, -1, 11)
        _ := ir_emit(run, IROp.Offset, t, s, 16, -1, 12)
        _ := ir_emit(run, IROp.Const, d5, 5, -1, -1, 13)
        a1: ir_args(run, [Int]{s, d5})
        _ := ir_emit(run, IROp.Call, -1, callee_id, a1, 2, 13)
        a_bump: ir_args(run, [Int]{h})
        _ := ir_emit(run, IROp.Call, -1, bump_id, a_bump, 1, 14)
        _ := ir_emit(run, IROp.Const, d3, 3, -1, -1, 15)
        a2: ir_args(run, [Int]{s, d3})
        _ := ir_emit(run, IROp.Call, -1, callee_id, a2, 2, 15)
        _ := ir_emit(run, IROp.Load, tv, t, 0, -1, 16)
        _ := ir_emit(run, IROp.Const, c20, 20, -1, -1, 16)
        _ := ir_emit(run, IROp.Add, tv2, tv, c20, IR_OVERFLOW_WRAP, 16)
        _ := ir_emit(run, IROp.Store, -1, t, 0, tv2, 16)
        _ := ir_emit(run, IROp.Load, r_log, s, 0, -1, 17)
        _ := ir_emit(run, IROp.Load, r_h, h, 0, -1, 17)
        _ := ir_emit(run, IROp.Load, r_t, t, 0, -1, 17)
        _ := ir_emit(run, IROp.Add, sum1, r_log, r_h, IR_OVERFLOW_WRAP, 17)
        _ := ir_emit(run, IROp.Add, sum2, sum1, r_t, IR_OVERFLOW_WRAP, 17)
        _ := ir_emit(run, IROp.Return, -1, sum2, -1, -1, 17)
        run_id: m.functions.len()
        ir_function_bind(m, run.key, run_id)
        m.functions.push(run)
        m.entry = run_id

        opts := ir_opt_options(level)
        opts.verify = true
        opts.inline = IROptInline.Marked
        report: ir_optimize_module(m, opts, compiler_threads_single())
        assert_eq(report.lint.len(), 0)
        // Because `h` escapes to the non-inlined `bump`, `s` must remain stack-backed at every O-level.
        has_stack := false
        loop op in m.functions[run_id].op {
            if op == .StackAddress -> has_stack = true
        }
        assert(has_stack, "local storage with live disjoint field borrow passed to call keeps its stack frame")
        compiled: ir_x64_compile_module(m, compiler_threads_single())
        assert_eq(compiled.errors.len(), 0)
    }
}
