// Typed expression lowering helpers: the jet_builtins roles of precise
// builtins and checked numeric bounds.
use {
    math: core.math
    jet_foundation.[
        TFailureCarrier,
        Type,
        type_name,
    ]
}

// The jet_builtins role (Core/Builtins/Builtins.jet `RoleKind`) whose Core
// function a typed `abs`, a Float or F32 `pow`, or a step of a Fraction `/`
// (ir_precise_division) runs: lowering finds that function by the role it
// fills (ir_core_role_row), not by its name.
ir_precise_source_role: fn(owner: String, operation: String) -> String? Never! {
    if operation == "abs" {
        if owner == "Float" -> return Val("AbsFloat")
        if owner == "F32" -> return Val("AbsF32")
        if owner == "I64" -> return Val("AbsI64")
    }
    if operation == "pow" {
        if owner == "Float" -> return Val("PowFloat")
        if owner == "F32" -> return Val("PowF32")
    }
    if owner == "Fraction" {
        if operation == "is_zero" -> return Val("FractionIsZero")
        if operation == "from_parts" -> return Val("FractionFromParts")
        if operation == "div" -> return Val("FractionDiv")
    }
    None
}

ir_failure_carrier_for_type: fn(ty: Type) -> TFailureCarrier Never! {
    if ty == {
        // copy: `ok` and `err` are payloads of read parameter `ty`, which keeps the originals; the new TFailureCarrier.Result's fields own `ok` and `err`
        .Result(ok, err) -> TFailureCarrier.Result{success: ok.copy(), error: err.copy()}
        // copy: `value` is a payload of read parameter `ty`, which keeps the original; field `value` of the new TFailureCarrier.Optional owns this one
        .Option(value) -> TFailureCarrier.Optional{value: value.copy()}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> TFailureCarrier.Infallible
    }
}

ir_math_scalar_type: fn(type_name: String) -> Type Never! {
    if type_name == "F32x4" || type_name == "F32x8" -> return Type.Float32
    if type_name.starts_with("I8x") -> return Type.IntN{signed: true, bits: 8}
    if type_name.starts_with("I16x") -> return Type.IntN{signed: true, bits: 16}
    if type_name.starts_with("I32x") -> return Type.IntN{signed: true, bits: 32}
    if type_name.starts_with("I64x") -> return Type.IntN{signed: true, bits: 64}
    if type_name.starts_with("U8x") -> return Type.IntN{signed: false, bits: 8}
    if type_name.starts_with("U16x") -> return Type.IntN{signed: false, bits: 16}
    if type_name.starts_with("U32x") -> return Type.IntN{signed: false, bits: 32}
    if type_name.starts_with("U64x") -> return Type.IntN{signed: false, bits: 64}
    Type.Float
}

// The positive quiet NaN 0x7FF8000000000000, from its bits. `0.0 / 0.0` is
// not a constant: folding it at compile time yields this value while a
// natively built compiler divides at run time and gets x86's negative
// default NaN 0xFFF8000000000000, so the emitted bits would depend on which
// compiler built the compiler.
ir_canonical_nan: fn() -> Float Never! { math.from_bits(0x7FF8000000000000) }

// A checked numeric bound (`Int.MAX`, `U64.MAX`, `Float.NAN`, ...). Every integer bound fits a
// word: `U64.MAX` keeps its two-complement bits (-1).
IRNumericBound: enum {
    Float(value: Float, f32: Bool),
    Int(value: Int),
}

ir_numeric_bound_constant: fn(ty: Type, member: String) -> IRNumericBound? {
    if ty == Type.Float32 {
        if member == "MAX" {
            return Val(IRNumericBound.Float{value: 3.4028234663852886e38, f32: true})
        }
        if member == "MIN" {
            return Val(IRNumericBound.Float{value: -3.4028234663852886e38, f32: true})
        }
        if member == "NAN" -> return Val(IRNumericBound.Float{value: ir_canonical_nan(), f32: true})
        if member == "INFINITY" -> return Val(IRNumericBound.Float{value: 1.0 / 0.0, f32: true})
        if member == "NEG_INFINITY" {
            return Val(IRNumericBound.Float{value: -(1.0 / 0.0), f32: true})
        }
        if member == "EPSILON" {
            return Val(IRNumericBound.Float{value: 1.1920928955078125e-7, f32: true})
        }
    }
    if ty == Type.Float {
        if member == "MAX" {
            return Val(IRNumericBound.Float{value: 1.7976931348623157e308, f32: false})
        }
        if member == "MIN" {
            return Val(IRNumericBound.Float{value: -1.7976931348623157e308, f32: false})
        }
        if member == "NAN" {
            return Val(IRNumericBound.Float{value: ir_canonical_nan(), f32: false})
        }
        if member == "INFINITY" -> return Val(IRNumericBound.Float{value: 1.0 / 0.0, f32: false})
        if member == "NEG_INFINITY" {
            return Val(IRNumericBound.Float{value: -(1.0 / 0.0), f32: false})
        }
        if member == "EPSILON" {
            return Val(IRNumericBound.Float{value: 2.220446049250313e-16, f32: false})
        }
    }
    if ty == Type.Int {
        if member == "MAX" -> return Val(IRNumericBound.Int{value: 9223372036854775807})
        if member == "MIN" -> return Val(IRNumericBound.Int{value: -9223372036854775808})
    }
    if ty == {
        .IntN(signed, bits) -> {
            if bits < 1 || bits > 64 || (member != "MAX" && member != "MIN") -> return None
            value := 0
            if {
                member == "MAX" -> {
                    if {
                        signed -> {
                            if {
                                bits == 64 -> { value = 9223372036854775807 }
                                else -> { value = (1 << (bits - 1)) - 1 }
                            }
                        }
                        bits == 64 -> { value = -1 }
                        bits == 63 -> { value = 9223372036854775807 }
                        else -> { value = (1 << bits) - 1 }
                    }
                }
                signed -> {
                    if {
                        bits == 64 -> { value = -9223372036854775808 }
                        else -> { value = -(1 << (bits - 1)) }
                    }
                }
            }
            return Val(IRNumericBound.Int{value: value})
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

#Test("the typed abs, the Float and F32 powers and a Fraction division's steps are jet_builtins roles") {
    assert_eq(ir_precise_source_role("Float", "abs"), Val("AbsFloat"))
    assert_eq(ir_precise_source_role("F32", "abs"), Val("AbsF32"))
    assert_eq(ir_precise_source_role("I64", "abs"), Val("AbsI64"))
    assert_eq(ir_precise_source_role("Float", "pow"), Val("PowFloat"))
    assert_eq(ir_precise_source_role("F32", "pow"), Val("PowF32"))
    assert_eq(ir_precise_source_role("Fraction", "is_zero"), Val("FractionIsZero"))
    assert_eq(ir_precise_source_role("Fraction", "from_parts"), Val("FractionFromParts"))
    assert_eq(ir_precise_source_role("Fraction", "div"), Val("FractionDiv"))
    assert_eq(ir_precise_source_role("Int", "abs"), None)
    assert_eq(ir_precise_source_role("Fraction", "add"), None)
}
