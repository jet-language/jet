// The merge of built parts into the program's module (BuildWaves.jet builds
// one part per thread). Every function, type row, name and data row gets
// its number by first use in a walk from the build's jobs, so a number
// depends on what the program reaches and on the job order, never on which
// part built a row or which memo interned it first. The walk visits the job
// functions in job order, then each function it reached, in the order it
// reached them: a function's slot types and names, then its instructions'
// operands in order (IR.jet's operand table: ConstText/DataAddress a=data
// row, ConstBigInt/CallRuntime a=name, Close b=name, Call/FunctionAddress
// a=function); a type row reaches the module function its drop names, a
// data row the rows its relocations name. Rows nothing reaches are dropped.
//
// Parts share a row by content: a function by key (a job's body is the part
// that built it; any other function is a helper its part built whole), a
// type row by its intern key, a name by its text, a data row by its text or
// bytes key or, for a constant's static object, by the constant and type
// (m.constant_rows). A data row with no key belongs to its part alone.
// Before the walk every part row is put in its sharing group: each part's
// keys are sorted into one ascending run (its key tables are hashed, its
// functions listed by row) and one merge of those runs numbers the groups,
// so the walk itself compares no keys.
//
// What the merge reads of a part apart from its rows is made on the part's
// own build thread before the merge (ir_merge_prepare): its key runs and,
// per function, the rows it uses in walk order, each row once. The walk then
// steps through those short lists instead of every function's instructions;
// a row's second use in a function finds its number already given, so the
// numbering is the same.
use jet_foundation.[CompilerTraceSink, Interner, InternerMarks, InternerRemap, Name, TypeID, compiler_take_rows, compiler_threads_failure_text, compiler_transfer_rows, delta_has_rows, interner_empty, interner_merge_delta, name_column_get, name_column_set, name_column_sorted, name_column_value, type_id_remap]

// A function the walk starts from: function `local` of part `part`.
IRMergeRoot: struct {
    part: Int,
    local: Int,
}

// One part's rows under the merged numbering (-1: not reached).
IRMergeSide: struct {
    function_new: [Int],
    type_new: [Int],
    name_new: [Int],
    data_new: [Int],
}

// A part's merge input, made on its build thread (ir_merge_prepare): its
// key runs in ascending key order (the function run sorted), and per
// function `local` the rows it uses, in walk order and each row once, as
// (kind, row) pairs `uses[use_starts[local]..<use_starts[local + 1]]`
// (kinds: IR_MERGE_USE_*).
IRMergePrep: struct {
    functions: [{key: String, local: Int}],
    types: [{key: String, local: Int}],
    names: [{key: String, local: Int}],
    texts: [{key: String, local: Int}],
    constants: [{key: String, local: Int}],
    use_starts: [Int],
    uses: [Int],
    call_starts: [Int],
    calls: [Int],
    addr_starts: [Int],
    addrs: [Int],
    has_entry_check: Bool,
}

IR_MERGE_USE_TYPE: 0

IR_MERGE_USE_NAME: 1

IR_MERGE_USE_DATA: 2

IR_MERGE_USE_FUNCTION: 3

// The merge's side work (grouping the type, name and data keys; dropping the
// parts) runs on threads of its own only when the parts hold at least this
// many rows (functions, types, names and data) in all, so a small program
// merges on the calling thread.
IR_MERGE_MIN_ROWS_FOR_THREADS: 4096

// The rows the merge's side work handles: every part's functions, types,
// names and data.
ir_merge_row_count: fn(parts: [IRModule]) -> Int Never! {
    rows := 0
    loop m in parts -> rows += m.functions.len() + m.types.len() + m.names.len() + m.data.len()
    rows
}

// Per row kind, the function that last used each row (ir_merge_uses).
IRMergeSeen: struct {
    types: [Int],
    names: [Int],
    data: [Int],
    functions: [Int],
    calls: [Int],
    addrs: [Int],
}

// The merged rows (each one's part and row there); each part row's sharing
// group (`*_group[part][row]`; data: -1 for a row only its part holds); per
// group its key and merged row (-1: not reached yet). `function_job` is the
// first root whose function is in the group (-1: none). The data groups
// below `data_texts` are text or bytes keys, the rest constants' static
// objects. Per part, its functions' uses (IRMergePrep), read by the walk.
IRMerge: struct {
    sides: [IRMergeSide],
    roots: [IRMergeRoot],
    function_part: [Int],
    function_local: [Int],
    function_group: [[Int]],
    function_keys: [String],
    function_ids: [Int],
    function_job: [Int],
    type_part: [Int],
    type_local: [Int],
    type_group: [[Int]],
    type_keys: [String],
    type_ids: [Int],
    name_part: [Int],
    name_local: [Int],
    name_group: [[Int]],
    name_keys: [String],
    name_ids: [Int],
    data_part: [Int],
    data_local: [Int],
    data_group: [[Int]],
    data_keys: [String],
    data_texts: Int,
    data_ids: [Int],
    use_starts: [[Int]],
    uses: [[Int]],
    call_starts: [[Int]],
    calls: [[Int]],
    addr_starts: [[Int]],
    addrs: [[Int]],
    has_entry_check: Bool,
}

// The module of one part built in queue order (ir_build_tests): its queue,
// then its entry, are the roots.
ir_merge_serial: fn(built: ^^IRModule) -> IRModule Never! {
    m := built.move()
    roots := [IRMergeRoot]{}
    loop queued in m.queue -> roots.push(IRMergeRoot{part: 0, local: queued.id})
    entry := -1
    if m.entry >= 0 {
        entry = roots.len()
        roots.push(IRMergeRoot{part: 0, local: m.entry})
    }
    prepared := [IRMergePrep]{}
    prepared.push(ir_merge_prepare(m))
    base_interner := m.interner.pop() ?? interner_empty()
    parts := [IRModule]{}
    parts.push(m)
    ir_merge(parts, prepared, roots, entry, base_interner.move(), None)
}

// Merges `built` (each part's preparation in `prepared`, ir_merge_prepare)
// from the job functions `roots` (in job order); `entry` is the root of the
// program entry (-1: none). The merged module's layout and build memos start
// empty (they name part rows); its key maps name the merged rows. With
// `trace_sink` each step is a span: `ir.merge.group` (ir_merge_new),
// `ir.merge.walk`, `ir.merge.functions` and `ir.merge.rows` (the reached
// functions, then the other rows, taken out of the parts) and
// `ir.merge.keys` (the key maps, while the parts drop).
ir_merge: fn(built: ^^[IRModule], prepared: ^^[IRMergePrep], roots: [IRMergeRoot], entry: Int, base_interner: ^^Interner, trace_sink: CompilerTraceSink?) -> IRModule Never! {
    ir_merge_with(built, prepared, roots, entry, base_interner.move(), false, trace_sink)
}

ir_merge_with: fn(built: ^^[IRModule], prepared: ^^[IRMergePrep], roots: [IRMergeRoot], entry: Int, base_interner: ^^Interner, run_recursion: Bool, trace_sink: CompilerTraceSink?) -> IRModule Never! {
    parts := built.move()
    if trace_sink == .Val(sink) -> sink.begin("ir.merge.group", "", -1, -1)
    g := ir_merge_new(parts, prepared, roots)
    if trace_sink == .Val(sink) -> sink.end("ir.merge.group", g.function_keys.len())
    if trace_sink == .Val(sink) -> sink.begin("ir.merge.walk", "", -1, -1)
    loop root in roots -> _: ir_merge_function(g, parts, root.part, root.local)
    cursor := 0
    loop cursor < g.function_part.len() {
        part: g.function_part[cursor]
        local: g.function_local[cursor]
        ir_merge_scan(g, parts, part, local)
        cursor += 1
    }
    if trace_sink == .Val(sink) -> sink.end("ir.merge.walk", cursor)
    if trace_sink == .Val(sink) -> sink.begin("ir.merge.functions", "", -1, -1)
    out := ir_module_new()
    if ir_interner_live(base_interner) -> out.interner.push(base_interner.move())
    part_remaps := [InternerRemap]{}
    loop p_idx in 0..<parts.len() {
        if parts[p_idx].type_delta.len() > 0 {
            if parts[p_idx].type_delta.pop() == .Val(delta) {
                mut_delta := delta
                if delta_has_rows(mut_delta) {
                    part_remaps.push(interner_merge_delta(out.interner[0], mut_delta))
                    next
                }
            }
        }
        part_remaps.push(InternerRemap{marks: InternerMarks{names: 0, types: 0, key_spans: 0, measures: 0, ranges: 0, tags: 0, dimensions: 0, functions: 0}, names: [Name]{}, types: [TypeID]{}})
    }
    if parts.len() > 0 {
        out.stop_points = parts[0].stop_points
        out.user_values = parts[0].user_values
        out.alloc_types = parts[0].alloc_types
        out.zones_stripped = parts[0].zones_stripped
        out.zone_table = parts[0].zone_table
    }
    recursive := if run_recursion && (g.has_entry_check || out.stop_points) -> ir_merge_recursive(g) else -> [Bool]{}
    dead := IRMergeDead{
        use_starts: compiler_take_rows<[Int]>(g.use_starts),
        uses: compiler_take_rows<[Int]>(g.uses),
        function_group: compiler_take_rows<[Int]>(g.function_group),
        function_job: compiler_take_rows<Int>(g.function_job),
        name_group: compiler_take_rows<[Int]>(g.name_group),
        data_group: compiler_take_rows<[Int]>(g.data_group),
        call_starts: compiler_take_rows<[Int]>(g.call_starts),
        calls: compiler_take_rows<[Int]>(g.calls),
        addr_starts: compiler_take_rows<[Int]>(g.addr_starts),
        addrs: compiler_take_rows<[Int]>(g.addrs),
    }
    ir_merge_take_functions_and_rows(out, parts, g, roots, entry, recursive, dead, part_remaps)
    if trace_sink == .Val(sink) -> sink.end("ir.merge.functions", out.functions.len())
    if trace_sink == .Val(sink) -> sink.begin("ir.merge.rows", "", -1, -1)
    if trace_sink == .Val(sink) -> sink.end("ir.merge.rows", out.types.len())
    // The parts are read no more. Past IR_MERGE_MIN_ROWS_FOR_THREADS they drop
    // on threads of their own while this one fills the merged key maps; a
    // smaller merge fills them here and its parts drop as it returns. A
    // task's arguments stay shared with the thread that spawns it, which drops
    // them after the join, so each part reaches its thread through
    // `released`: the thread pops it off.
    if trace_sink == .Val(sink) -> sink.begin("ir.merge.keys", "", -1, -1)
    if ir_merge_row_count(parts) < IR_MERGE_MIN_ROWS_FOR_THREADS {
        ir_merge_key_rows(out, g)
        if trace_sink == .Val(sink) -> sink.end("ir.merge.keys", -1)
        return out
    }
    released: Shared{[IRModule]{}}
    ir_merge_release_fill(released, parts)
    task.group ir_merge_release_group {
        dropped: task ir_merge_release(released, -1)
        ir_merge_key_rows(out, g)
        _: dropped.join() ?? panic(compiler_threads_failure_text(err))
    }
    if trace_sink == .Val(sink) -> sink.end("ir.merge.keys", -1)
    out
}

ir_merge_rows: fn(out: ^IRModule, parts: ^[IRModule], g: IRMerge, roots: [IRMergeRoot], entry: Int, part_remaps: [InternerRemap]) Never! {
    if entry >= 0 -> out.entry = g.sides[roots[entry].part].function_new[roots[entry].local]
    out.types.try_reserve(g.type_part.len()) ?? ()
    out.type_keys.try_reserve(g.type_part.len()) ?? ()
    loop (row, part) in g.type_part {
        local: g.type_local[row]
        ty_row := parts[part].types[local].copy()
        ty_row.ty = type_id_remap(ty_row.ty, part_remaps[part])
        out.types.push(ty_row)
        out.type_keys.push(parts[part].type_keys[local].copy())
    }
    // Each struct or tuple row's members as its layout placed them
    // (BuildTypes.jet ir_debug_members_keep), each variant row's variants
    // (BuildOwn.jet ir_debug_variants) and each List row's element row, for
    // the DWARF types, from the first part that holds them: the parts that
    // interned one key laid it out alike, and a member's or element's row is
    // the merged row of its sharing group, whichever part reached it, so none
    // depends on which part built what. Each struct's members are also one
    // line each as the emission log prints them (X64Module.jet
    // ir_x64_log_fields), in merged row order.
    loop part in 0..<parts.len() {
        // The part's member lists the merged rows take, by list.
        wanted := [Int:Int]{}
        loop (local, list) in parts[part].debug_members {
            row: ir_merge_reached_type(g, part, local)
            if row < 0 || out.debug_members.get(row) != None -> next
            out.debug_members[row] = -1
            wanted[list] = row
        }
        lists := compiler_take_rows<[IRMember]>(parts[part].member_lists)
        loop lists.len() > 0 {
            list: lists.len() - 1
            members := lists.pop() ?? panic("a nonempty member list failed to pop")
            row: wanted.get(list) ?? next
            loop index in 0..<members.len() {
                members[index].ty = ir_merge_reached_type(g, part, members[index].ty)
            }
            out.debug_members[row] = out.member_lists.len()
            out.member_lists.push(members.move())
        }
        loop (local, element) in parts[part].list_elements {
            row: ir_merge_reached_type(g, part, local)
            reached: ir_merge_reached_type(g, part, element)
            if row < 0 || reached < 0 || out.list_elements.get(row) != None -> next
            out.list_elements[row] = reached
        }
        loop (local, count) in parts[part].fixed_counts {
            row: ir_merge_reached_type(g, part, local)
            if row < 0 || out.fixed_counts.get(row) != None -> next
            out.fixed_counts[row] = count
        }
        loop (local, held) in parts[part].alloc_held {
            row: ir_merge_reached_type(g, part, local)
            reached: ir_merge_reached_type(g, part, held)
            if row < 0 || reached < 0 || out.alloc_held.get(row) != None -> next
            out.alloc_held[row] = reached
        }
        // The part's variant lists the merged rows take, by list.
        shaped := [Int:Int]{}
        loop (local, list) in parts[part].debug_variants {
            row: ir_merge_reached_type(g, part, local)
            if row < 0 || out.debug_variants.get(row) != None -> next
            out.debug_variants[row] = -1
            shaped[list] = row
        }
        described := compiler_take_rows<IRDebugVariants>(parts[part].variant_lists)
        loop described.len() > 0 {
            list: described.len() - 1
            found := described.pop() ?? panic("a nonempty variant list failed to pop")
            row: shaped.get(list) ?? next
            loop variant in 0..<found.variants.len() {
                loop index in 0..<found.variants[variant].members.len() {
                    found.variants[variant].members[index].ty = ir_merge_reached_type(g, part, found.variants[variant].members[index].ty)
                }
            }
            out.debug_variants[row] = out.variant_lists.len()
            out.variant_lists.push(found.move())
        }
    }
    out.names.try_reserve(g.name_part.len()) ?? ()
    loop (row, part) in g.name_part -> out.names.push(parts[part].names[g.name_local[row]].copy())
    out.data.try_reserve(g.data_part.len()) ?? ()
    loop (row, part) in g.data_part {
        local: g.data_local[row]
        out.data.push(parts[part].data[local].copy())
        if parts[part].data_relocs.get(local) == .Val(words) {
            out.data_relocs[row] = loop word in words -> IRDataReloc{offset: word.offset, target: g.sides[part].data_new[word.target], addend: word.addend, text: word.text}
        }
    }
    loop group in 0..<g.data_texts {
        row: g.data_ids[group]
        if row >= 0 -> name_column_set(out.data_rows_keys, out.data_rows, g.data_keys[group], row)
    }
    // A constant's static object (and a storage, memo or Shared site cell)
    // keeps its key: the runtime library finds its lifecycle guards and the
    // Core library its cells by it (m.constant_rows).
    loop group in g.data_texts..<g.data_keys.len() {
        row: g.data_ids[group]
        if row >= 0 -> name_column_set(out.constant_rows_keys, out.constant_rows, g.data_keys[group], row)
    }
    // A host literal's key names its function and a slot of its body, so the
    // parts that built one function hold the one value under it.
    loop part in 0..<parts.len() {
        loop key in parts[part].host_literals_keys.texts {
            row: name_column_get(parts[part].host_literals_keys, parts[part].host_literals, key) ?? next
            if name_column_get(out.host_literals_keys, out.host_literals, key) != None -> next
            name_column_set(out.host_literals_keys, out.host_literals, key, out.host_literal_values.len())
            out.host_literal_values.push(parts[part].host_literal_values[row].copy())
        }
    }
}

// Fills `out`'s key maps from the merged groups `g`, and stops the build when
// two function keys hash alike.
ir_merge_key_rows: fn(out: ^IRModule, g: IRMerge) Never! {
    loop (group, id) in g.type_ids {
        if id >= 0 -> name_column_set(out.type_rows_keys, out.type_rows, g.type_keys[group], id)
    }
    loop (group, id) in g.name_ids {
        if id >= 0 -> name_column_set(out.name_rows_keys, out.name_rows, g.name_keys[group], id)
    }
    loop (group, id) in g.function_ids {
        if id >= 0 -> ir_function_bind(out, g.function_keys[group], id)
    }
    // A hashed symbol ends with its key's 64-bit stable id (IR.jet
    // ir_hashed_function). Two keys can hash alike, which would name two
    // functions with one symbol: that stops the build. Keys are compared
    // only when two hashes meet.
    hashed := [U64:Int]{}
    loop (id, f) in out.functions {
        if (f.symbol_hash == U64{0}) { next }
        if hashed.get(f.symbol_hash) == .Val(other) {
            if out.functions[other].key != f.key {
                panic("internal error: the symbol hash of {out.functions[other].key} and {f.key} is the same")
            }
            next
        }
        hashed[f.symbol_hash] = id
    }
}

// Moves `parts` into `released`.
ir_merge_release_fill: fn(released: Shared<[IRModule]>, parts: ^^[IRModule]) Never! {
    rows := parts.move()
    permit: released.guard_edit()
    compiler_transfer_rows<IRModule>(permit.value, rows)
}

// Drops `count` parts of `released` (-1: all of them), each on a thread of
// its own and the last on this one; returns how many it dropped.
ir_merge_release: fn(released: Shared<[IRModule]>, count: Int) -> Int Never! {
    if count < 0 -> return ir_merge_release(released, ir_merge_release_count(released))
    if count == 0 -> return 0
    if count == 1 -> return ir_merge_release_part(released)
    dropped := 0
    task.group ir_merge_release_parts {
        head: task ir_merge_release_part(released)
        dropped = ir_merge_release(released, count - 1)
        dropped += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    dropped
}

// Pops a part off `released` and drops it here, outside the lock; returns
// how many it dropped (one, or none when none was left).
ir_merge_release_part: fn(released: Shared<[IRModule]>) -> Int Never! {
    part: ir_merge_release_pop(released)
    part.len()
}

ir_merge_release_pop: fn(released: Shared<[IRModule]>) -> [IRModule] Never! {
    permit: released.guard_edit()
    part := [IRModule]{}
    if permit.value.len() > 0 {
        row := permit.value.pop() ?? panic("a nonempty released part list failed to pop")
        part.push(row)
    }
    part
}

ir_merge_release_count: fn(released: Shared<[IRModule]>) -> Int Never! {
    permit: released.guard_read()
    permit.value.len()
}

// Each part's rows as runs in ascending key order (`(key, local)`: the key
// and the part's row), from its preparation (ir_merge_prepare); data groups
// are the text and bytes keys, then the constants' static objects. Past
// IR_MERGE_MIN_ROWS_FOR_THREADS the types, names and data are grouped on
// threads of their own while this one groups the functions; a smaller merge
// groups them all here, in the same order. A task is handed keys and row
// counts only, never a part: a part it shared would be copied when the merge
// rewrites it.
ir_merge_new: fn(parts: [IRModule], prepared: ^^[IRMergePrep], roots: [IRMergeRoot]) -> IRMerge Never! {
    sides := [IRMergeSide]{}
    function_group := [[Int]]{}
    type_counts := [Int]{}
    name_counts := [Int]{}
    data_counts := [Int]{}

    loop m in parts {
        sides.push(IRMergeSide{function_new: ir_merge_unset(m.functions.len()), type_new: ir_merge_unset(m.types.len()), name_new: ir_merge_unset(m.names.len()), data_new: ir_merge_unset(m.data.len())})
        function_group.push(ir_merge_unset(m.functions.len()))
        type_counts.push(m.types.len())
        name_counts.push(m.names.len())
        data_counts.push(m.data.len())
    }
    preps := prepared.move()
    if preps.len() != parts.len() {
        panic("the merge has {preps.len()} part preparations for {parts.len()} parts")
    }
    functions := [[{key: String, local: Int}]]{}
    types := [[{key: String, local: Int}]]{}
    names := [[{key: String, local: Int}]]{}
    texts := [[{key: String, local: Int}]]{}
    constants := [[{key: String, local: Int}]]{}
    use_starts := [[Int]]{}
    uses := [[Int]]{}
    call_starts := [[Int]]{}
    calls := [[Int]]{}
    addr_starts := [[Int]]{}
    addrs := [[Int]]{}
    has_entry_check := false
    // Popped from the last part down, then put back in part order.
    loop preps.len() > 0 {
        prep := preps.pop() ?? panic("a nonempty part preparation list failed to pop")
        functions.push(prep.functions.move())
        types.push(prep.types.move())
        names.push(prep.names.move())
        texts.push(prep.texts.move())
        constants.push(prep.constants.move())
        use_starts.push(prep.use_starts.move())
        uses.push(prep.uses.move())
        call_starts.push(prep.call_starts.move())
        calls.push(prep.calls.move())
        addr_starts.push(prep.addr_starts.move())
        addrs.push(prep.addrs.move())
        if prep.has_entry_check -> has_entry_check = true
    }
    functions.reverse()
    types.reverse()
    names.reverse()
    texts.reverse()
    constants.reverse()
    use_starts.reverse()
    uses.reverse()
    call_starts.reverse()
    calls.reverse()
    addr_starts.reverse()
    addrs.reverse()
    function_keys := [String]{}
    grouped := [IRMergeGroups]{}
    if {
        ir_merge_row_count(parts) < IR_MERGE_MIN_ROWS_FOR_THREADS -> {
            ir_merge_group(functions, function_group, function_keys)
            grouped.push(ir_merge_grouped(types, [[{key: String, local: Int}]]{}, type_counts))
            grouped.push(ir_merge_grouped(names, [[{key: String, local: Int}]]{}, name_counts))
            grouped.push(ir_merge_grouped(texts, constants, data_counts))
        }
        else -> {
            task.group ir_merge_groups {
                typed: task ir_merge_grouped(types, [[{key: String, local: Int}]]{}, type_counts)
                named: task ir_merge_grouped(names, [[{key: String, local: Int}]]{}, name_counts)
                data: task ir_merge_grouped(texts, constants, data_counts)
                ir_merge_group(functions, function_group, function_keys)
                grouped.push(typed.join() ?? panic(compiler_threads_failure_text(err)))
                grouped.push(named.join() ?? panic(compiler_threads_failure_text(err)))
                grouped.push(data.join() ?? panic(compiler_threads_failure_text(err)))
            }
        }
    }
    data_groups := grouped.pop() ?? panic("the merge lost its data groups")
    name_groups := grouped.pop() ?? panic("the merge lost its name groups")
    type_groups := grouped.pop() ?? panic("the merge lost its type groups")
    function_job := ir_merge_unset(function_keys.len())
    loop (index, root) in roots {
        group: function_group[root.part][root.local]
        if function_job[group] < 0 -> function_job[group] = index
    }
    function_ids: ir_merge_unset(function_keys.len())
    type_ids: ir_merge_unset(type_groups.keys.len())
    name_ids: ir_merge_unset(name_groups.keys.len())
    data_ids: ir_merge_unset(data_groups.keys.len())
    IRMerge{sides: sides, roots: roots.copy(), function_part: [Int]{}, function_local: [Int]{}, function_group: function_group, function_keys: function_keys, function_ids: function_ids, function_job: function_job, type_part: [Int]{}, type_local: [Int]{}, type_group: type_groups.groups.move(), type_keys: type_groups.keys.move(), type_ids: type_ids, name_part: [Int]{}, name_local: [Int]{}, name_group: name_groups.groups.move(), name_keys: name_groups.keys.move(), name_ids: name_ids, data_part: [Int]{}, data_local: [Int]{}, data_group: data_groups.groups.move(), data_keys: data_groups.keys.move(), data_texts: data_groups.texts, data_ids: data_ids, use_starts: use_starts.move(), uses: uses.move(), call_starts: call_starts.move(), calls: calls.move(), addr_starts: addr_starts.move(), addrs: addrs.move(), has_entry_check: has_entry_check}
}

// Part `m`'s merge input (IRMergePrep), made on the thread that built it:
// its key runs as ir_merge_new groups them (each sorted; a constant whose
// value is built at each read (-1) shares no row, so its run leaves it out:
// name_column_sorted keeps rows >= 0) and its functions' uses (ir_merge_uses).
ir_merge_prepare: fn(m: IRModule) -> IRMergePrep Never! {
    functions := [{key: String, local: Int}]{}
    loop (local, f) in m.functions -> functions.push({key: f.key.copy(), local: local})
    functions.sort()
    fn_count: m.functions.len()
    seen := IRMergeSeen{types: ir_merge_unset(m.types.len()), names: ir_merge_unset(m.names.len()), data: ir_merge_unset(m.data.len()), functions: ir_merge_unset(fn_count), calls: ir_merge_unset(fn_count), addrs: ir_merge_unset(fn_count)}
    use_starts := [Int]{}
    uses := [Int]{}
    call_starts := [Int]{}
    calls := [Int]{}
    addr_starts := [Int]{}
    addrs := [Int]{}
    has_entry_check := false
    loop (local, f) in m.functions {
        if f.entry_check >= 0 -> has_entry_check = true
        use_starts.push(uses.len())
        call_starts.push(calls.len())
        addr_starts.push(addrs.len())
        ir_merge_uses(f, local, seen, uses, calls, addrs)
    }
    use_starts.push(uses.len())
    call_starts.push(calls.len())
    addr_starts.push(addrs.len())
    IRMergePrep{functions: functions.move(), types: name_column_sorted(m.type_rows_keys, m.type_rows), names: name_column_sorted(m.name_rows_keys, m.name_rows), texts: name_column_sorted(m.data_rows_keys, m.data_rows), constants: name_column_sorted(m.constant_rows_keys, m.constant_rows), use_starts: use_starts.move(), uses: uses.move(), call_starts: call_starts.move(), calls: calls.move(), addr_starts: addr_starts.move(), addrs: addrs.move(), has_entry_check: has_entry_check}
}

// What function `local` (`f`) uses, in the walk's order (ir_merge_scan
// numbers them so): its slot types and names, its result type, then its
// instructions' operands (IR.jet's operand table), each row once, as
// (kind, row) pairs on `uses`. `seen` holds per row the function that last
// used it. Also records deduplicated direct-call targets (plus -1 for
// CallIndirect) on `calls` and FunctionAddress targets on `addrs`.
ir_merge_uses: fn(f: IRFunction, local: Int, seen: ^IRMergeSeen, uses: ^[Int], calls: ^[Int], addrs: ^[Int]) Never! {
    loop slot in 0..<f.slot_type.len() {
        ir_merge_use(seen.types, IR_MERGE_USE_TYPE, f.slot_type[slot], local, uses)
        ir_merge_use(seen.names, IR_MERGE_USE_NAME, f.slot_name[slot], local, uses)
    }
    ir_merge_use(seen.types, IR_MERGE_USE_TYPE, f.result, local, uses)
    indirect := false
    loop at in 0..<f.op.len() {
        op: f.op[at]
        if op == {
            .ConstText | .DataAddress -> {
                ir_merge_use(seen.data, IR_MERGE_USE_DATA, f.a[at], local, uses)
            }
            .ConstBigInt | .CallRuntime -> {
                ir_merge_use(seen.names, IR_MERGE_USE_NAME, f.a[at], local, uses)
            }
            .Close -> { ir_merge_use(seen.names, IR_MERGE_USE_NAME, f.b[at], local, uses) }
            .Call -> {
                target: f.a[at]
                ir_merge_use(seen.functions, IR_MERGE_USE_FUNCTION, target, local, uses)
                if target >= 0 && seen.calls[target] != local {
                    seen.calls[target] = local
                    calls.push(target)
                }
            }
            .FunctionAddress -> {
                target: f.a[at]
                ir_merge_use(seen.functions, IR_MERGE_USE_FUNCTION, target, local, uses)
                if target >= 0 && seen.addrs[target] != local {
                    seen.addrs[target] = local
                    addrs.push(target)
                }
            }
            .CallIndirect -> { indirect = true }
            .Nop | .Const | .Copy | .Move | .Drop | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> {}
        }
    }
    if indirect -> calls.push(-1)
}

// Puts row `row` (none when negative) of kind `kind` on `uses` unless
// function `local` used it already.
ir_merge_use: fn(seen: ^[Int], kind: Int, row: Int, local: Int, uses: ^[Int]) Never! {
    if row < 0 || seen[row] == local {
        return
    }
    seen[row] = local
    uses.push(kind)
    uses.push(row)
}

// One kind's sharing groups (ir_merge_group): per part row its group and
// per group its key, the groups of `runs` before those of `later`;
// `texts`: how many groups `runs` has. `counts`: per part its rows.
IRMergeGroups: struct {
    groups: [[Int]],
    keys: [String],
    texts: Int,
}

ir_merge_grouped: fn(runs: ^^[[{key: String, local: Int}]], later: ^^[[{key: String, local: Int}]], counts: ^^[Int]) -> IRMergeGroups Never! {
    leading := runs.move()
    trailing := later.move()
    grouped := [[Int]]{}
    loop count in counts.move() -> grouped.push(ir_merge_unset(count))
    keys := [String]{}
    ir_merge_group(leading, grouped, keys)
    texts: keys.len()
    ir_merge_group(trailing, grouped, keys)
    IRMergeGroups{groups: grouped, keys: keys, texts: texts}
}

ir_merge_unset: fn(count: Int) -> [Int] Never! {
    rows := [Int]{}
    if count > 0 -> rows.try_reserve(count) ?? ()
    loop _ in 0..<count -> rows.push(-1)
    rows
}

// Numbers the groups of `runs` (one ascending run per part) after the ones
// already in `keys`: one group per distinct key, ascending, its key appended
// to `keys` and its number put in `groups[part][local]` for each row with
// that key. A row is in one group: every key names a row its module made for
// it (IR.jet ir_intern_*, BuildStatic), so no data row has a text key and a
// constant key.
ir_merge_group: fn(runs: [[{key: String, local: Int}]], groups: ^[[Int]], keys: ^[String]) Never! {
    nparts: runs.len()
    heads := ir_merge_unset(nparts)
    active := [Int]{}
    max_run := 0
    loop part in 0..<nparts {
        heads[part] = 0
        rlen: runs[part].len()
        if rlen > 0 {
            active.push(part)
            if rlen > max_run -> max_run = rlen
        }
    }
    if max_run > 0 -> keys.try_reserve(keys.len() + max_run) ?? ()
    if nparts <= 62 {
        loop active.len() > 0 {
            least := active[0]
            ties := 1 << least
            loop idx in 1..<active.len() {
                part: active[idx]
                cmp: runs[part][heads[part]].key <=> runs[least][heads[least]].key
                if cmp == .Less {
                    least = part
                    ties = 1 << part
                } else if cmp == .Equal { ties = ties | (1 << part) }
            }
            group: keys.len()
            keys.push(runs[least][heads[least]].key.copy())
            i := 0
            loop i < active.len() {
                part: active[i]
                if (ties & (1 << part)) == 0 {
                    i += 1
                    next
                }
                h := heads[part]
                rlen: runs[part].len()
                loop h < rlen {
                    if h > heads[part] && runs[part][h].key != keys[group] -> break
                    local: runs[part][h].local
                    if groups[part][local] >= 0 {
                        panic("build part {part} row {local} has two sharing keys")
                    }
                    groups[part][local] = group
                    h += 1
                }
                heads[part] = h
                if h >= rlen {
                    last_part: active.pop() ?? break
                    if i < active.len() -> active[i] = last_part
                } else { i += 1 }
            }
        }
        return
    }
    loop {
        // The first part whose next key is the least; parts before it are past that key.
        least := -1
        loop part in 0..<nparts {
            if heads[part] >= runs[part].len() -> next
            if least < 0 || runs[part][heads[part]].key < runs[least][heads[least]].key {
                least = part
            }
        }
        if least < 0 -> break
        group: keys.len()
        keys.push(runs[least][heads[least]].key)
        loop part in least..<nparts {
            loop heads[part] < runs[part].len() && runs[part][heads[part]].key == keys[group] {
                local: runs[part][heads[part]].local
                if groups[part][local] >= 0 {
                    panic("build part {part} row {local} has two sharing keys")
                }
                groups[part][local] = group
                heads[part] = heads[part] + 1
            }
        }
    }
}

// The merged id of function `local` of part `part`. A job's id stands for
// the body the job's own part built.
ir_merge_function: fn(g: ^IRMerge, parts: [IRModule], part: Int, local: Int) -> Int Never! {
    if local < 0 -> return -1
    known: g.sides[part].function_new[local]
    if known >= 0 -> return known
    group: g.function_group[part][local]
    id := g.function_ids[group]
    if id < 0 {
        source_part := part
        source_local := local
        job: g.function_job[group]
        if job >= 0 {
            source_part = g.roots[job].part
            source_local = g.roots[job].local
        }
        id = g.function_part.len()
        g.function_part.push(source_part)
        g.function_local.push(source_local)
        g.function_ids[group] = id
        g.sides[source_part].function_new[source_local] = id
    }
    g.sides[part].function_new[local] = id
    id
}

// The merged row of type row `row` of part `part`. Parts that interned the
// same key must agree on its layout and ownership.
ir_merge_type: fn(g: ^IRMerge, parts: [IRModule], part: Int, row: Int) -> Int Never! {
    if row < 0 -> return row
    known: g.sides[part].type_new[row]
    if known >= 0 -> return known
    group: g.type_group[part][row]
    id: g.type_ids[group]
    if id >= 0 {
        if !ir_merge_same_type(parts[g.type_part[id]].types[g.type_local[id]], parts[part].types[row]) {
            panic("type {g.type_keys[group]} differs between build parts")
        }
        g.sides[part].type_new[row] = id
        return id
    }
    added: g.type_part.len()
    g.type_part.push(part)
    g.type_local.push(row)
    g.type_ids[group] = added
    g.sides[part].type_new[row] = added
    drop: parts[part].types[row].drop
    if drop != "" {
        glue: ir_keyed_function(parts[part], drop) ?? -1
        _: ir_merge_function(g, parts, part, glue)
    }
    added
}

ir_merge_same_type: fn(a: IRType, b: IRType) -> Bool Never! {
    a.kind == b.kind && a.size == b.size && a.align == b.align && a.drop == b.drop && a.clone == b.clone
}

// The merged row of type row `local` of part `part`: its sharing group's,
// whichever part's function reached it; -1 when the walk never did (or
// `local` is negative).
ir_merge_reached_type: fn(g: IRMerge, part: Int, local: Int) -> Int Never! {
    if local < 0 -> return -1
    group: g.type_group[part][local]
    if group < 0 -> return -1
    g.type_ids[group]
}

ir_merge_name: fn(g: ^IRMerge, parts: [IRModule], part: Int, name: Int) -> Int Never! {
    if name < 0 -> return name
    known: g.sides[part].name_new[name]
    if known >= 0 -> return known
    group: g.name_group[part][name]
    id := g.name_ids[group]
    if id < 0 {
        id = g.name_part.len()
        g.name_part.push(part)
        g.name_local.push(name)
        g.name_ids[group] = id
    }
    g.sides[part].name_new[name] = id
    id
}

ir_merge_data: fn(g: ^IRMerge, parts: [IRModule], part: Int, row: Int) -> Int Never! {
    if row < 0 -> return row
    known: g.sides[part].data_new[row]
    if known >= 0 -> return known
    group: g.data_group[part][row]
    if group >= 0 {
        found: g.data_ids[group]
        if found >= 0 {
            g.sides[part].data_new[row] = found
            return found
        }
    }
    id: g.data_part.len()
    g.data_part.push(part)
    g.data_local.push(row)
    if group >= 0 -> g.data_ids[group] = id
    g.sides[part].data_new[row] = id
    if parts[part].data_relocs.get(row) == .Val(words) {
        loop word in words -> _: ir_merge_data(g, parts, part, word.target)
    }
    id
}

// Numbers what function `local` of part `part` uses, in order, from its
// uses (ir_merge_uses).
ir_merge_scan: fn(g: ^IRMerge, parts: [IRModule], part: Int, local: Int) Never! {
    at := g.use_starts[part][local]
    end: g.use_starts[part][local + 1]
    loop at < end {
        kind: g.uses[part][at]
        row: g.uses[part][at + 1]
        at += 2
        if kind == IR_MERGE_USE_TYPE {
            _: ir_merge_type(g, parts, part, row)
            next
        }
        if kind == IR_MERGE_USE_NAME {
            _: ir_merge_name(g, parts, part, row)
            next
        }
        if kind == IR_MERGE_USE_DATA {
            _: ir_merge_data(g, parts, part, row)
            next
        }
        _: ir_merge_function(g, parts, part, row)
    }
}

// Rewrites a merged function's operands from its part's rows to the merged ones.
ir_merge_rewrite: fn(side: IRMergeSide, f: ^IRFunction) Never! {
    loop slot in 0..<f.slot_type.len() {
        ty: f.slot_type[slot]
        if ty >= 0 -> f.slot_type[slot] = side.type_new[ty]
        name: f.slot_name[slot]
        if name >= 0 -> f.slot_name[slot] = side.name_new[name]
    }
    if f.result >= 0 {
        result: side.type_new[f.result]
        f.result = result
    }
    loop at in 0..<f.op.len() {
        if f.op[at] == {
            .ConstText | .DataAddress -> {
                a: f.a[at]
                if a >= 0 -> f.a[at] = side.data_new[a]
            }
            .ConstBigInt | .CallRuntime -> {
                a: f.a[at]
                if a >= 0 -> f.a[at] = side.name_new[a]
            }
            .Close -> {
                name: f.b[at]
                if name >= 0 -> f.b[at] = side.name_new[name]
            }
            .Call | .FunctionAddress -> {
                a: f.a[at]
                if a >= 0 -> f.a[at] = side.function_new[a]
            }
            .Nop | .Const | .Copy | .Move | .Drop | .Add | .Sub | .Mul | .Div | .Rem | .FloorDiv | .Mod | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Neg | .Not | .Convert | .Concat | .CallIndirect | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> {}
        }
    }
}

// Dead merge index tables moved onto a background drop task while the parts
// rewrite their functions, keeping large `[[Int]]` frees off the critical path.
IRMergeDead: struct {
    use_starts: [[Int]],
    uses: [[Int]],
    function_group: [[Int]],
    function_job: [Int],
    name_group: [[Int]],
    data_group: [[Int]],
    call_starts: [[Int]],
    calls: [[Int]],
    addr_starts: [[Int]],
    addrs: [[Int]],
}

ir_merge_drop_dead: fn(dead: ^^IRMergeDead) -> Int Never! {
    owned: dead.move()
    owned.use_starts.len()
}

// Computes the cycle-membership table (`recursive[id]`) over the merged
// function graph directly from the per-part call/address edges gathered in
// `ir_merge_prepare`, avoiding a full post-merge scan of all IR bodies.
ir_merge_recursive: fn(g: IRMerge) -> [Bool] Never! {
    count: g.function_part.len()
    calls := OptCalls{start: [Int]{}, to: [Int]{}}
    calls.start.try_reserve(count + 2) ?? ()
    taken := [Int]{}
    taken_seen := [Bool]{}
    taken_seen.try_reserve(count) ?? ()
    loop _ in 0..<count -> taken_seen.push(false)
    loop id in 0..<count {
        part: g.function_part[id]
        local: g.function_local[id]
        fn_map: g.sides[part].function_new
        calls.start.push(calls.to.len())
        c_start: g.call_starts[part][local]
        c_end: g.call_starts[part][local + 1]
        loop k in c_start..<c_end {
            raw: g.calls[part][k]
            if raw < 0 -> calls.to.push(count) else {
                callee: fn_map[raw]
                if callee >= 0 && callee < count -> calls.to.push(callee)
            }
        }
        a_start: g.addr_starts[part][local]
        a_end: g.addr_starts[part][local + 1]
        loop k in a_start..<a_end {
            target: fn_map[g.addrs[part][k]]
            if target >= 0 && target < count && !taken_seen[target] {
                taken_seen[target] = true
                taken.push(target)
            }
        }
    }
    calls.start.push(calls.to.len())
    compiler_transfer_rows<Int>(calls.to, taken)
    calls.start.push(calls.to.len())
    ir_opt_bottom_up(calls).recursive
}

// A merged function and its merged id, as a part's rewrite hands it back.
IRMergeTaken: struct {
    id: Int,
    function: IRFunction,
}

// Owned work bundle moved into the rewriting task so every part's function
// list keeps refcount 1 while ir_merge_rows runs in parallel on the caller.
IRMergeRewriteWork: struct {
    lists: [[IRFunction]],
    ids: [[Int]],
}

ir_merge_rewrite_owned_work: fn(work: ^^IRMergeRewriteWork, sides: [IRMergeSide], recursive: [Bool], stop_points: Bool) -> [[IRMergeTaken]] Never! {
    owned := work.move()
    lists := compiler_take_rows<[IRFunction]>(owned.lists)
    ids := compiler_take_rows<[Int]>(owned.ids)
    ir_merge_rewrite_parts(lists, sides, ids, recursive, stop_points)
}

// Moves the merged functions out of their parts into `out.functions`, in
// merged order (no function is copied), while merging `out`'s non-function
// rows (`ir_merge_rows`) and dropping dead merge index tables in parallel.
ir_merge_take_functions_and_rows: fn(out: ^IRModule, parts: ^[IRModule], g: IRMerge, roots: [IRMergeRoot], entry: Int, recursive: [Bool], dead: ^^IRMergeDead, part_remaps: [InternerRemap]) Never! {
    count: g.function_part.len()
    lists := ir_merge_function_lists(parts)
    // Per part row its merged id (-1: not merged).
    ids := loop list in lists -> ir_merge_unset(list.len())
    loop id in 0..<count -> ids[g.function_part[id]][g.function_local[id]] = id
    dead_tables := dead.move()
    taken := [[IRMergeTaken]]{}
    if lists.len() > 1 {
        work := IRMergeRewriteWork{lists: lists.move(), ids: ids.move()}
        task.group ir_merge_take_group {
            dropping: task ^^dead_tables {
                ir_merge_drop_dead(dead_tables)
            }
            rewriting: task ^^work {
                ir_merge_rewrite_owned_work(work.move(), g.sides, recursive, out.stop_points)
            }
            ir_merge_rows(out, parts, g, roots, entry, part_remaps)
            taken = rewriting.join() ?? panic(compiler_threads_failure_text(err))
            _: dropping.join() ?? panic(compiler_threads_failure_text(err))
        }
    } else {
        taken = ir_merge_rewrite_parts(lists, g.sides, ids, recursive, out.stop_points)
        ir_merge_rows(out, parts, g, roots, entry, part_remaps)
    }
    out.functions.try_reserve(count) ?? ()
    loop _ in 0..<count -> out.functions.push(ir_function_new("", "", "", "", 0))
    loop taken.len() > 0 {
        part_taken := taken.pop() ?? panic("a nonempty merged part list failed to pop")
        loop part_taken.len() > 0 {
            row := part_taken.pop() ?? panic("a nonempty merged function list failed to pop")
            id: row.id
            out.functions[id] = row.function.move()
        }
    }
}

// Each part's function list, in part order, moved out whole and the part left
// with none: the parts pop off `parts` and go back in order, so no function
// moves one at a time.
ir_merge_function_lists: fn(parts: ^[IRModule]) -> [[IRFunction]] Never! {
    lists := [[IRFunction]]{}
    kept := [IRModule]{}
    loop parts.len() > 0 {
        part := parts.pop() ?? panic("a nonempty part list failed to pop")
        lists.push(part.functions.move())
        part.functions = [IRFunction]{}
        kept.push(part)
    }
    loop kept.len() > 0 {
        part: kept.pop() ?? panic("a nonempty kept part list failed to pop")
        parts.push(part)
    }
    lists.reverse()
    lists
}

// One part's functions and, per row, its merged id (-1: not merged), moved
// into the thread that rewrites them (ir_merge_rewrite_parts).
IRMergePart: struct {
    functions: [IRFunction],
    ids: [Int],
}

// The rewritten merged functions of every part in `lists`, in part order:
// each part's on its own thread and the first part's on this one
// (ir_merge_rewrite_part). The parts pop off `lists` and `ids` whole, last
// first, so no row moves one at a time. A task's arguments stay shared with
// the thread that spawns it, which drops them after the join, so a part
// moves into its task's capture instead: the thread owns it alone and drops
// what the merge does not keep there.
ir_merge_rewrite_parts: fn(lists: ^[[IRFunction]], sides: [IRMergeSide], ids: ^[[Int]], recursive: [Bool], stop_points: Bool) -> [[IRMergeTaken]] Never! {
    at: lists.len() - 1
    if at < 0 -> return [[IRMergeTaken]]{}
    functions := lists.pop() ?? panic("a nonempty part function list failed to pop")
    part_ids := ids.pop() ?? panic("a nonempty part id list failed to pop")
    if at == 0 {
        return [[IRMergeTaken]]{ir_merge_rewrite_part(functions.move(), sides[0], part_ids.move(), recursive, stop_points)}
    }
    part := IRMergePart{functions: functions.move(), ids: part_ids.move()}
    taken := [[IRMergeTaken]]{}
    task.group ir_merge_rewrite_threads {
        last: task ^^part {
            ir_merge_rewrite_owned_part(part.move(), sides[at], recursive, stop_points)
        }
        taken = ir_merge_rewrite_parts(lists, sides, ids, recursive, stop_points)
        taken.push(last.join() ?? panic(compiler_threads_failure_text(err)))
    }
    taken
}

// Moves `part`'s function and id rows out of the struct before rewriting so
// the worker holds the sole reference to every kept IRFunction and rewrites
// its operand arrays in place with zero copy-on-write cloning.
ir_merge_rewrite_owned_part: fn(part: ^^IRMergePart, side: IRMergeSide, recursive: [Bool], stop_points: Bool) -> [IRMergeTaken] Never! {
    owned := part.move()
    fns := compiler_take_rows<IRFunction>(owned.functions)
    pids := compiler_take_rows<Int>(owned.ids)
    ir_merge_rewrite_part(fns.move(), side, pids.move(), recursive, stop_points)
}

// One part's functions (`ids`: per row its merged id, -1: not merged): the
// merged ones rewritten to the merged rows with their ids (and recursion
// checks applied in place when `recursive` is non-empty); the rest drop
// here, on the part's thread.
ir_merge_rewrite_part: fn(functions: ^^[IRFunction], side: IRMergeSide, ids: ^^[Int], recursive: [Bool], stop_points: Bool) -> [IRMergeTaken] Never! {
    rows := functions.move()
    row_ids: ids.move()
    kept := 0
    loop id in row_ids {
        if id >= 0 -> kept += 1
    }
    taken := [IRMergeTaken]{}
    taken.try_reserve(kept) ?? ()
    do_recursion: recursive.len() > 0
    loop rows.len() > 0 {
        id: row_ids[rows.len() - 1]
        row := rows.pop() ?? panic("a nonempty part function list failed to pop")
        if id < 0 -> next
        ir_merge_rewrite(side, row)
        if do_recursion -> ir_recursion_entry(row, recursive, id, stop_points)
        taken.push(IRMergeTaken{id: id, function: row.move()})
    }
    taken
}

#Test("a merge keeps the constant keys of the data rows it merges") {
    parts := [IRModule]{}
    loop part in 0..<2 {
        m := ir_module_new()
        f := ir_function_new("f{part}", "test:merge.jet.f{part}", "f{part}", "merge.jet", 1)
        keys: [String]{"storage:shared", "storage:own{part}"}
        loop key in keys {
            row: m.data.len()
            m.data.push([U8]{U8{0}})
            name_column_set(m.constant_rows_keys, m.constant_rows, key, row)
            _: ir_emit(f, IROp.DataAddress, -1, row, -1, -1, 1)
        }
        m.functions.push(f)
        parts.push(m)
    }
    preps := [IRMergePrep]{}
    loop m in parts -> preps.push(ir_merge_prepare(m))
    merged: ir_merge(parts, preps, [IRMergeRoot]{IRMergeRoot{part: 0, local: 0}, IRMergeRoot{part: 1, local: 0}}, -1, interner_empty(), None)
    assert_eq(merged.data.len(), 3)
    shared: name_column_value(merged.constant_rows_keys, merged.constant_rows, "storage:shared") ?? -1
    own0: name_column_value(merged.constant_rows_keys, merged.constant_rows, "storage:own0") ?? -1
    own1: name_column_value(merged.constant_rows_keys, merged.constant_rows, "storage:own1") ?? -1
    assert(shared >= 0 && own0 >= 0 && own1 >= 0, "every keyed data row keeps its key")
    assert(shared != own0 && shared != own1 && own0 != own1, "each key names its own merged row")
    assert_eq(merged.functions[0].a[0], shared)
}
