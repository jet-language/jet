// x86-64 code for a whole IR module, and its relocatable object through the
// existing object writer (JetBackend Image/Object.jet). The writer and its
// DWARF read an X64ObjectModule (Image/Emission.jet): the IR data rows as
// X64Data (same ids), then an immortal String header per ConstText row and
// the texts the selector names itself (source paths, stop messages,
// big-integer decimals); the debug files and types; and per IR function its
// name, file, line and debug variables.
use {
    jet_foundation.[CompilerThreads, compiler_apply_order, compiler_take_rows, compiler_threads_admit, compiler_threads_failure_text, compiler_threads_heaviest_first, compiler_transfer_rows]
    jet_backend.[
        X64CompiledFunction,
        X64Data,
        X64DataExport,
        X64DataID,
        X64DataReloc,
        X64DebugEncoding,
        X64DebugMember,
        X64DebugType,
        X64DebugTypeKind,
        X64DebugVariable,
        X64ExecutableResult,
        X64FunctionDebug,
        X64FunctionID,
        X64FunctionSource,
        X64InlineSite,
        X64LineRow,
        X64ModuleDebug,
        X64ObjectModule,
        X64Reloc,
        X64RelocTarget,
        X64RuntimeExport,
        X64VariableRange,
        X64_FUNCTION_ALIGN,
        x64_object_functions_threads,
        x64_object_main,
        x64_object_main_debug,
    ]
}

// The module-wide rows the object writer reads: the IR data rows, then the
// selector rows every function's selection named (ir_x64_tables_add).
IRX64Tables: struct {
    // The IR data rows (same ids), then headers and texts.
    data: [X64Data],
    // Byte length of every data row.
    lengths: [Int],
    // Per IR data row: the data row of its immortal String header, -1 when
    // no ConstText names it.
    headers: [Int],
    // Selector texts (source paths, stop messages, big-integer decimals) -> data row.
    texts: [String:Int],
    // Big-integer decimals -> the data row of the word that is their static
    // exact Int (ir_x64_static_int).
    ints: [String:Int],
    // DWARF: the source files (row per distinct path) and a debug type per
    // IR type row (debug row r describes m.types[r]), then the rows they name.
    files: [String],
    file_rows: [String:Int],
    debug_types: [X64DebugType],
    // The data row of the byte caching whether the CPU has FMA3 (X64Select.jet
    // ir_x64_fma), -1 when no function calls jet_std_math_fma.
    fma: Int,
    // Per data row, whether code that goes on reads it (ir_x64_tables_heat);
    // rows past its end are not.
    hot: [Bool]{[Bool]{}},
}

// A data row a function's selection names besides the IR data rows: a
// selector text, the String header of an IR data row, a big-integer
// decimal's static Int word, the FMA byte.
IRX64Use: enum {
    Text(text: String),
    Header(row: Int),
    StaticInt(text: String),
    Fma,
}

// Use k of a function's selection is data row IR_X64_LOCAL_DATA + k in its
// code until ir_x64_resolve points it at the module's row: above every
// module row, so the two never meet.
IR_X64_LOCAL_DATA: 1099511627776

// One function's own selector rows (ir_x64_function_tables): each row it
// names once, in the order the walk meets it, and the lookups its selection
// reads. Its selection reads no module-wide table, so any thread selects
// any function with no walk over the module first; the module gives the
// uses their rows afterwards, in function order (ir_x64_tables_add), the
// rows one walk over the whole module would give them.
IRX64FunctionTables: struct {
    uses: [IRX64Use],
    // Per use: the byte length of its data.
    lengths: [Int],
    // Selector texts, IR data rows with a String header, big-integer
    // decimals with a static Int -> local data row.
    texts: [String:Int],
    headers: [Int:Int],
    ints: [String:Int],
    // The local data row of the FMA byte, -1 when the function calls no
    // jet_std_math_fma.
    fma: Int,
    // Whether the selection keeps an emission log (JET_X64_EMIT_LOG,
    // ir_x64_compile_module_logged).
    logged: Bool,
    // The data rows its DataAddress and ConstText instructions read (module
    // rows, a header as its local row), `cold` those on the way to a stop
    // (ir_x64_dying), `hot` the others; ir_x64_tables_heat marks them.
    hot: [Int]{[Int]{}},
    cold: [Int]{[Int]{}},
}

// Whether JET_X64_EMIT_LOG entry list `names` names function `f`: an entry
// is a function's name, or, holding a `/`, a part of its source path.
ir_x64_log_names: fn(f: IRFunction, names: [String]) -> Bool Never! {
    loop name in names {
        if name == f.name -> return true
        if name.contains("/") && f.source_file.contains(name) -> return true
    }
    false
}

// The module moves in and comes back in `program`, so the object writer
// reads the same rows the selection read without a copy.
IRX64Result: struct {
    program: IRModule,
    functions: [X64CompiledFunction],
    debug: [X64FunctionDebug],
    // Per function: the debug variables its ranges index.
    variables: [[X64DebugVariable]],
    errors: [String],
    tables: IRX64Tables,
    threads: CompilerThreads,
    // The logged functions' emission logs, in function order
    // (ir_x64_log_text), one line per row.
    log: [String],
}

ir_x64_add_text: fn(tables: &IRX64Tables, text: String) -> Int Never! {
    found: tables.texts.get(text) ?? -1
    if found >= 0 -> return found
    id: tables.data.len()
    bytes: text.bytes()
    tables.lengths.push(bytes.len())
    tables.data.push(X64Data{id: X64DataID{value: id}, bytes: bytes, align: 1, relocs: [X64DataReloc]{}, read_only: true})
    tables.texts[text] = id
    id
}

// A big-integer decimal's exact Int as process-lifetime data
// (JetRuntime Int.jet's 48-byte carrier and its base-1e9 u32 limbs), and
// the data word holding the tagged Int that names it, so a ConstBigInt is
// one load instead of a runtime parse and allocation per evaluation. The
// carrier starts with 2^62 references: every owner a load hands out is
// dropped once and a clone adds its own, so no run reaches the count zero
// that would free it. A decimal the carrier can't hold canonically (one in
// the inline range, or not plain digits) keeps the runtime parse.
ir_x64_static_int: fn(tables: &IRX64Tables, text: String) Never! {
    if tables.ints.get(text) != None || !ir_x64_static_int_fits(text) {
        return
    }
    bytes := [Int]{}
    loop byte in text.bytes() -> bytes.push(Int{byte})
    negative: bytes[0] == 45
    first: if negative -> 1 else -> 0
    limbs := [U8]{}
    count := 0
    end := bytes.len()
    loop end > first {
        start: if end - 9 > first -> end - 9 else -> first
        limb := 0
        loop at in start..<end -> limb = limb * 10 + bytes[at] - 48
        loop shift in 0..<4 -> limbs.push(U8{(limb >> (8 * shift)) & 255})
        count += 1
        end = start
    }
    limbs_row: tables.data.len()
    tables.lengths.push(limbs.len())
    tables.data.push(X64Data{id: X64DataID{value: limbs_row}, bytes: limbs.move(), align: 4, relocs: [X64DataReloc]{}})
    // refs, retired_next, negative, limbs (relocated), len, cap.
    words: [Int]{4611686018427387904, 0, if negative -> 1 else -> 0, 0, count, count}
    carrier := [U8]{}
    loop word in words {
        loop shift in 0..<8 -> carrier.push(U8{(word >> (8 * shift)) & 255})
    }
    carrier_row: tables.data.len()
    tables.lengths.push(48)
    tables.data.push(X64Data{id: X64DataID{value: carrier_row}, bytes: carrier.move(), align: 8, relocs: [X64DataReloc]{X64DataReloc{offset: 24, target: X64DataID{value: limbs_row}, addend: 0}}})
    // The Int word is the carrier's address with bit 62 set (Int.jet int_tag).
    tagged := [U8]{}
    loop _ in 0..<8 -> tagged.push(U8{0})
    word_row: tables.data.len()
    tables.lengths.push(8)
    tables.data.push(X64Data{id: X64DataID{value: word_row}, bytes: tagged.move(), align: 8, relocs: [X64DataReloc]{X64DataReloc{offset: 0, target: X64DataID{value: carrier_row}, addend: 4611686018427387904}}})
    tables.ints[text] = word_row
}

// Whether ir_x64_static_int makes a static Int for decimal `text`: plain
// digits, an optional `-`, no leading zero, outside the inline range.
ir_x64_static_int_fits: fn(text: String) -> Bool Never! {
    bytes := [Int]{}
    loop byte in text.bytes() -> bytes.push(Int{byte})
    negative: bytes.len() > 0 && bytes[0] == 45
    first: if negative -> 1 else -> 0
    digits: bytes.len() - first
    if digits < 19 || bytes[first] == 48 -> return false
    loop at in first..<bytes.len() {
        if bytes[at] < 48 || bytes[at] > 57 -> return false
    }
    // A 19-digit magnitude up to 2^62 - 1 (2^62 when negative) is an inline Int.
    if digits == 19 {
        bound: (if negative -> "4611686018427387904" else -> "4611686018427387903").bytes()
        at := 0
        loop at < 19 && bytes[first + at] == (Int{bound[at]}) -> at += 1
        if at == 19 || bytes[first + at] < (Int{bound[at]}) -> return false
    }
    true
}

// The shared rows the DWARF types of the IR type rows name.
IRX64DebugRows: struct {
    // A machine word (I64), a byte (U8) and an untyped pointer.
    word: Int,
    byte: Int,
    pointer: Int,
    // The exact Int: the word under its own name, which a debugger shows
    // so a reader knows to decode a tagged carrier (JetRuntime Int.jet).
    int: Int,
    // The pointee structs, made on first use (-1 before).
    string: Int,
    decimal: Int,
    fraction: Int,
}

// Appends `ty` to the debug types; returns its row.
ir_x64_debug_add: fn(tables: &IRX64Tables, ty: &&X64DebugType) -> Int Never! {
    row: tables.debug_types.len()
    tables.debug_types.push(ty)
    row
}

// A pointer to debug row `target`.
ir_x64_debug_pointer: fn(tables: &IRX64Tables, target: Int) -> Int Never! {
    ir_x64_debug_add(tables, X64DebugType{name: "", size: 8, kind: X64DebugTypeKind.Pointer{target: target}})
}

// The DWARF type of every IR type row, by its checked type and machine
// layout: debug row r describes m.types[r]; the rows they name follow. A
// String is a pointer to its header [data, byte length, cap]; a List its
// inline header [len, cap, data], data pointing at its element row
// (IRModule.list_elements); a struct its members at their offsets
// (IRModule.debug_members); a Decimal or Fraction a pointer to its runtime
// handle's two exact Ints (JetRuntime RoutePrecise.jet). Any other
// aggregate stays opaque.
ir_x64_debug_types: fn(m: IRModule, tables: &IRX64Tables) Never! {
    loop _ in 0..<m.types.len() {
        tables.debug_types.push(X64DebugType{name: "", size: 0, kind: X64DebugTypeKind.Opaque})
    }
    word: ir_x64_debug_add(tables, X64DebugType{name: "I64", size: 8, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Signed}})
    byte: ir_x64_debug_add(tables, X64DebugType{name: "U8", size: 1, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Unsigned}})
    pointer: ir_x64_debug_pointer(tables, -1)
    int: ir_x64_debug_add(tables, X64DebugType{name: "Int", size: 8, kind: X64DebugTypeKind.Typedef{target: word}})
    shared := IRX64DebugRows{word: word, byte: byte, pointer: pointer, int: int, string: -1, decimal: -1, fraction: -1}
    loop (row, ty) in m.types {
        described: ir_x64_debug_type(m, tables, shared, row, ty)
        tables.debug_types[row] = described
    }
}

// The DWARF description of IR type row `row`.
ir_x64_debug_type: fn(m: IRModule, tables: &IRX64Tables, shared: &IRX64DebugRows, row: Int, ty: IRType) -> X64DebugType Never! {
    if ty.kind == {
        .Unit -> X64DebugType{name: "Unit", size: 0, kind: X64DebugTypeKind.Opaque}
        .Bool -> X64DebugType{name: "Bool", size: 1, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Bool}}
        .Int -> X64DebugType{name: "Int", size: 8, kind: X64DebugTypeKind.Typedef{target: shared.word}}
        .Word -> {
            bits: ir_x64_bits(ir_x64_shape(ty))
            // Whole bytes, rounded up: a U4 is 1 byte.
            X64DebugType{name: "{if ty.signed -> "I" else -> "U"}{bits}", size: (bits + 7) /% 8, kind: X64DebugTypeKind.Base{encoding: if ty.signed -> X64DebugEncoding.Signed else -> X64DebugEncoding.Unsigned}}
        }
        .Float -> X64DebugType{name: "Float", size: 8, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Float}}
        .Float32 -> X64DebugType{name: "F32", size: 4, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Float}}
        .Char -> X64DebugType{name: "Char", size: 4, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Char}}
        .String -> {
            if shared.string < 0 {
                data: ir_x64_debug_pointer(tables, shared.byte)
                members: [X64DebugMember]{X64DebugMember{name: "data", offset: 0, ty: data}, X64DebugMember{name: "len", offset: 8, ty: shared.word}, X64DebugMember{name: "cap", offset: 16, ty: shared.word}}
                header: ir_x64_debug_add(tables, X64DebugType{name: "String", size: 24, kind: X64DebugTypeKind.Struct{members: members}})
                shared.string = ir_x64_debug_pointer(tables, header)
            }
            X64DebugType{name: "String", size: 8, kind: X64DebugTypeKind.Typedef{target: shared.string}}
        }
        .Pointer -> {
            precise: ir_short_name(ir_nominal_name(ir_untag(ty.ty)) ?? "")
            if precise == "Decimal" {
                if shared.decimal < 0 {
                    shared.decimal = ir_x64_debug_handle(tables, "Decimal", "coefficient", "scale", shared.int, shared.word)
                }
                return X64DebugType{name: "Decimal", size: 8, kind: X64DebugTypeKind.Typedef{target: shared.decimal}}
            }
            if precise == "Fraction" {
                if shared.fraction < 0 {
                    shared.fraction = ir_x64_debug_handle(tables, "Fraction", "numerator", "denominator", shared.int, shared.int)
                }
                return X64DebugType{name: "Fraction", size: 8, kind: X64DebugTypeKind.Typedef{target: shared.fraction}}
            }
            X64DebugType{name: "Pointer", size: 8, kind: X64DebugTypeKind.Pointer{target: -1}}
        }
        .Aggregate -> {
            if ir_untag(ty.ty) == .List(_) {
                target: m.list_elements.get(row) ?? -1
                data: ir_x64_debug_pointer(tables, target)
                members: [X64DebugMember]{X64DebugMember{name: "len", offset: 0, ty: shared.word}, X64DebugMember{name: "cap", offset: 8, ty: shared.word}, X64DebugMember{name: "data", offset: 16, ty: data}}
                return X64DebugType{name: ir_type_name(ty.ty), size: ty.size, kind: X64DebugTypeKind.Struct{members: members}}
            }
            list: m.debug_members.get(row) ?? -1
            if list >= 0 {
                members: loop field in m.member_lists[list] -> X64DebugMember{name: field.name, offset: field.offset, ty: if field.boxed -> shared.pointer else -> field.ty}
                return X64DebugType{name: ir_type_name(ty.ty), size: ty.size, kind: X64DebugTypeKind.Struct{members: members}}
            }
            X64DebugType{name: "Aggregate", size: ty.size, kind: X64DebugTypeKind.Opaque}
        }
    }
}

// A pointer to a runtime handle of two words named `first` and `second`.
ir_x64_debug_handle: fn(tables: &IRX64Tables, name: String, first: String, second: String, first_ty: Int, second_ty: Int) -> Int Never! {
    members: [X64DebugMember]{X64DebugMember{name: first, offset: 0, ty: first_ty}, X64DebugMember{name: second, offset: 8, ty: second_ty}}
    handle: ir_x64_debug_add(tables, X64DebugType{name: name, size: 16, kind: X64DebugTypeKind.Struct{members: members}})
    ir_x64_debug_pointer(tables, handle)
}

// The tables of all of `m` at once: what ir_x64_compile_module_logged
// builds from the functions' selections, for a reader that selects no
// function first (the Web back end, ir_x64_compile_function).
ir_x64_tables: fn(m: IRModule) -> IRX64Tables Never! {
    tables := ir_x64_tables_start(m)
    loop (row, f) in m.functions {
        local: ir_x64_function_tables(m, row, [String]{})
        rows: ir_x64_tables_add(tables, f, local.uses)
        ir_x64_tables_heat(tables, rows, local.hot, local.cold)
    }
    ir_x64_tables_finish(m, tables)
    tables
}

// The module's tables before any function's uses: its IR data rows.
ir_x64_tables_start: fn(m: IRModule) -> IRX64Tables Never! {
    tables := IRX64Tables{data: [X64Data]{}, lengths: [Int]{}, headers: [Int]{}, texts: [String:Int]{}, ints: [String:Int]{}, files: [String]{}, file_rows: [String:Int]{}, debug_types: [X64DebugType]{}, fma: -1}
    loop (row, bytes) in m.data {
        // A static object (BuildStatic.jet) holds words, which the program
        // may write; a text row is read-only bytes (IR.jet ir_intern_text).
        object: m.data_relocs.get(row) != None
        align: if object -> 8 else -> 1
        tables.data.push(X64Data{id: X64DataID{value: row}, bytes: bytes, align: align, relocs: [X64DataReloc]{}, read_only: !object})
        tables.lengths.push(bytes.len())
        tables.headers.push(-1)
    }
    tables
}

// Gives the uses of function `f`, the next in function order, their module
// rows, adding its source file and the rows no function before it named;
// returns the row of each use, for ir_x64_resolve.
ir_x64_tables_add: fn(tables: &IRX64Tables, f: IRFunction, uses: [IRX64Use]) -> [Int] Never! {
    if f.source_file != "" && tables.file_rows.get(f.source_file) == None {
        tables.file_rows[f.source_file] = tables.files.len()
        tables.files.push(f.source_file)
    }
    rows := [Int]{}
    loop wanted in uses {
        row: if wanted == {
            .Text(text) -> ir_x64_add_text(tables, text)
            .Header(data) -> ir_x64_text_header(tables, data)
            .StaticInt(text) -> {
                ir_x64_static_int(tables, text)
                tables.ints.get(text) ?? -1
            }
            .Fma -> {
                if tables.fma < 0 {
                    tables.fma = tables.data.len()
                    tables.lengths.push(1)
                    tables.data.push(X64Data{id: X64DataID{value: tables.fma}, bytes: [U8]{U8{0}}, align: 1, relocs: [X64DataReloc]{}})
                }
                tables.fma
            }
        }
        rows.push(row)
    }
    rows
}

// The rows of `uses` in tables that hold them all already (ir_x64_tables).
ir_x64_use_rows: fn(tables: IRX64Tables, uses: [IRX64Use]) -> [Int] Never! {
    rows := [Int]{}
    loop wanted in uses {
        row: if wanted == {
            .Text(text) -> tables.texts.get(text) ?? -1
            .Header(data) -> tables.headers[data]
            .StaticInt(text) -> tables.ints.get(text) ?? -1
            .Fma -> tables.fma
        }
        rows.push(row)
    }
    rows
}

// After every function's uses: a static object's address words (a data
// row's address, or the String header a ConstText of the target row
// reads) and the debug types.
ir_x64_tables_finish: fn(m: IRModule, tables: &IRX64Tables) Never! {
    loop row in 0..<m.data.len() {
        relocs: m.data_relocs.get(row) ?? next
        loop reloc in relocs {
            target: if reloc.text -> ir_x64_text_header(tables, reloc.target) else -> reloc.target
            tables.data[row].relocs.push(X64DataReloc{offset: reloc.offset, target: X64DataID{value: target}, addend: reloc.addend})
        }
    }
    ir_x64_debug_types(m, tables)
}

// Marks the data rows a function's code reads (IRX64FunctionTables hot and
// cold; use k as IR_X64_LOCAL_DATA + k, which `rows`, the module rows of its
// uses, resolves), the next in function order: a row only code on its way
// to a stop reads is cold (X64Data.cold), so the object writer lays it
// after what running code reads. Any order of the functions marks the same.
ir_x64_tables_heat: fn(tables: &IRX64Tables, rows: [Int], hot: [Int], cold: [Int]) Never! {
    loop wanted in hot {
        row: if wanted >= IR_X64_LOCAL_DATA -> rows[wanted - IR_X64_LOCAL_DATA] else -> wanted
        if row < 0 || row >= tables.data.len() -> next
        loop tables.hot.len() <= row -> tables.hot.push(false)
        tables.hot[row] = true
        tables.data[row].cold = false
    }
    loop wanted in cold {
        row: if wanted >= IR_X64_LOCAL_DATA -> rows[wanted - IR_X64_LOCAL_DATA] else -> wanted
        if row < 0 || row >= tables.data.len() || (row < tables.hot.len() && tables.hot[row]) {
            next
        }
        tables.data[row].cold = true
    }
}

// Points each data relocation of `function` at use k (data row
// IR_X64_LOCAL_DATA + k) at `rows[k]`, the module's row of that use.
ir_x64_resolve: fn(function: &X64CompiledFunction, rows: [Int]) Never! {
    loop at in 0..<function.relocs.len() {
        if function.relocs[at].target == .Data(id) && id.value >= IR_X64_LOCAL_DATA {
            function.relocs[at].target = X64RelocTarget.Data{id: X64DataID{value: rows[id.value - IR_X64_LOCAL_DATA]}}
        }
    }
}

// The selector rows function row `row` of `m` names, in the order its
// instructions name them: its source file's text, then per instruction the
// texts of its numeric stops (ir_x64_add_stop_texts), a ConstText's String
// header, a ConstBigInt's decimal and static Int, the FMA byte of a
// jet_std_math_fma call. Its selection keeps an emission log when
// JET_X64_EMIT_LOG entry list `names` names it (ir_x64_log_names). The
// data rows its DataAddress and ConstText instructions read go in `hot`, or
// in `cold` when the instruction is on its way to a stop (ir_x64_dying).
ir_x64_function_tables: fn(m: IRModule, row: Int, names: [String]) -> IRX64FunctionTables Never! {
    f: m.functions[row]
    tables := IRX64FunctionTables{uses: [IRX64Use]{}, lengths: [Int]{}, texts: [String:Int]{}, headers: [Int:Int]{}, ints: [String:Int]{}, fma: -1, logged: ir_x64_log_names(f, names)}
    _ := ir_x64_use_text(tables, f.source_file)
    // The stop texts already in (ir_x64_add_stop_texts).
    stops := [Bool]{false, false, false, false}
    // The DataAddress and ConstText instructions, with the row each reads.
    reads := [Int]{}
    read_rows := [Int]{}
    loop at in 0..<f.op.len() {
        ir_x64_add_stop_texts(tables, stops, m, f, at)
        if f.op[at] == .DataAddress && f.a[at] >= 0 && f.a[at] < m.data.len() {
            reads.push(at)
            read_rows.push(f.a[at])
        }
        if f.op[at] == .ConstText {
            data: f.a[at]
            if data >= 0 && data < m.data.len() {
                if tables.headers.get(data) == None {
                    tables.headers[data] = ir_x64_add_use(tables, IRX64Use.Header{row: data}, 24)
                }
                reads.push(at)
                read_rows.push(tables.headers[data])
            }
        }
        if f.op[at] == .ConstBigInt && f.a[at] >= 0 && f.a[at] < m.names.len() {
            text: m.names[f.a[at]]
            _ := ir_x64_use_text(tables, text)
            if tables.ints.get(text) == None && ir_x64_static_int_fits(text) {
                tables.ints[text] = ir_x64_add_use(tables, IRX64Use.StaticInt{text: text}, 8)
            }
        }
        if f.op[at] == .CallRuntime && tables.fma < 0 && f.a[at] >= 0 && f.a[at] < m.names.len() && m.names[f.a[at]] == "jet_std_math_fma" {
            tables.fma = ir_x64_add_use(tables, IRX64Use.Fma, 1)
        }
    }
    if reads.len() > 0 {
        dying: ir_x64_dying(f)
        loop (index, at) in reads {
            if dying[at] -> tables.cold.push(read_rows[index]) else {
                tables.hot.push(read_rows[index])
            }
        }
    }
    tables
}

// Per instruction of `f`, whether every way on from it ends at an
// Unreachable: the arm of a stop that builds its report and calls the
// runtime function that ends the program. Read backward: an Unreachable
// starts such a run and a Br, BrIf or Return ends it (control may leave);
// an arm's last instruction goes on to what follows its End (a Loop's
// too: its End falls through), an If's start is such when both its arms'
// starts are (an If without Else: its then arm's and what follows its End),
// and a Block's or Loop's when its body's start is.
ir_x64_dying: fn(f: IRFunction) -> [Bool] Never! {
    count: f.op.len()
    dying := [Bool]{}
    loop _ in 0..<count -> dying.push(false)
    // Per construct open in the backward walk: whether what follows its
    // End dies, and whether its else arm's start dies (what follows the End
    // until an Else is met).
    after := [Bool]{}
    other := [Bool]{}
    dies := false
    at := count - 1
    loop at >= 0 {
        op: f.op[at]
        if op == .Unreachable -> dies = true else if op == .Br || op == .BrIf || op == .Return {
            dies = false
        } else if op == .End {
            after.push(dies)
            other.push(dies)
        } else if op == .Else {
            if other.len() > 0 {
                other[other.len() - 1] = dies
                dies = after[after.len() - 1]
            }
        } else if op == .If {
            else_dies: other.pop() ?? false
            _ := after.pop()
            dies = dies && else_dies
        } else if op == .Block || op == .Loop {
            _ := other.pop()
            _ := after.pop()
        }
        dying[at] = dies
        at -= 1
    }
    dying
}

#Test("The instructions on the way to an Unreachable are the dying ones") {
    f := ir_function_new("f", "f", "", "f.jet", 1)
    _ := ir_emit(f, IROp.DataAddress, -1, 0, -1, -1, 1)
    // A stop's then arm and an else arm that goes on.
    _ := ir_open_if(f, -1, 1)
    _ := ir_emit(f, IROp.DataAddress, -1, 0, -1, -1, 1)
    _ := ir_emit(f, IROp.Unreachable, -1, -1, -1, -1, 1)
    ir_else(f, 1)
    _ := ir_emit(f, IROp.DataAddress, -1, 0, -1, -1, 1)
    ir_end(f, 1)
    // A Block a BrIf leaves, ahead of the Unreachable after it.
    _ := ir_open(f, IROp.Block, 1)
    _ := ir_open_if(f, -1, 1)
    _ := ir_emit(f, IROp.DataAddress, -1, 0, -1, -1, 1)
    _ := ir_emit(f, IROp.Unreachable, -1, -1, -1, -1, 1)
    ir_end(f, 1)
    _ := ir_emit(f, IROp.BrIf, -1, -1, 0, -1, 1)
    _ := ir_emit(f, IROp.DataAddress, -1, 0, -1, -1, 1)
    ir_end(f, 1)
    _ := ir_emit(f, IROp.Unreachable, -1, -1, -1, -1, 1)
    assert_eq(ir_x64_dying(f), [Bool]{false, false, true, true, false, false, false, false, false, true, true, false, false, true, true, true})
}

// Adds use `wanted`, of `length` bytes; returns its local data row.
ir_x64_add_use: fn(tables: &IRX64FunctionTables, wanted: &&IRX64Use, length: Int) -> Int Never! {
    id: IR_X64_LOCAL_DATA + tables.uses.len()
    tables.uses.push(wanted)
    tables.lengths.push(length)
    id
}

// The local data row of selector text `text`, added on first use.
ir_x64_use_text: fn(tables: &IRX64FunctionTables, text: String) -> Int Never! {
    found: tables.texts.get(text) ?? -1
    if found >= 0 -> return found
    id: ir_x64_add_use(tables, IRX64Use.Text{text: text}, text.bytes().len())
    tables.texts[text] = id
    id
}

// The byte length of local data row `id`.
ir_x64_use_length: fn(tables: IRX64FunctionTables, id: Int) -> Int Never! {
    tables.lengths[id - IR_X64_LOCAL_DATA]
}

// The process-lifetime String header [data, byte length, cap 0] over data
// row `row`'s bytes, which the runtime recognizes as immortal: clone returns
// it and drop ignores it. One per row.
ir_x64_text_header: fn(tables: &IRX64Tables, row: Int) -> Int Never! {
    if tables.headers[row] >= 0 -> return tables.headers[row]
    header: tables.data.len()
    bytes := [U8]{}
    loop _ in 0..<24 -> bytes.push(U8{0})
    length := tables.lengths[row]
    loop index in 0..<8 {
        bytes[8 + index] = U8{length & 255}
        length = length >> 8
    }
    tables.data.push(X64Data{id: X64DataID{value: header}, bytes: bytes, align: 8, relocs: [X64DataReloc]{X64DataReloc{offset: 0, target: X64DataID{value: row}, addend: 0}}})
    tables.lengths.push(24)
    tables.headers[row] = header
    header
}

// x64 selection admission. A pass over a module's functions on k threads
// takes about total * ns / k of wall, where `total` is the module's IR
// instructions and `ns` the pass's cost per instruction on one thread, plus
// IR_X64_THREAD_NS per thread. Going from k - 1 threads to k saves
// total * ns / (k * (k - 1)), so a pass admits the most threads whose last
// one saves more than it costs (ir_x64_admit): a module of a few thousand
// instructions selects on a few threads, a small one on the calling thread.
//
// Measured by timing whole selections at forced thread counts on a
// 16-CPU host already running other work: selection costs 700 to 850 ns per
// instruction on one thread (modules of 2,000 to 87,000 instructions), and a
// selecting thread about 0.4 ms of wall in the median (its start and join
// are a few microseconds; the rest is its cold caches and its share of busy
// cores), less on an idle host.
IR_X64_THREAD_NS: 400000

// Selection's cost per IR instruction on one thread.
IR_X64_SELECT_NS_PER_INSTRUCTION: 800

// The threads `threads` admits for a pass over `count` functions holding
// `total` IR instructions that costs `ns_per_instruction` each on one
// thread: the most k with total * ns_per_instruction >= k * (k - 1) *
// IR_X64_THREAD_NS.
ir_x64_admit: fn(threads: CompilerThreads, count: Int, total: Int, ns_per_instruction: Int) -> Int Never! {
    workers := compiler_threads_admit(threads, count, total, 1, 0, 0)
    work: total * ns_per_instruction
    loop workers > 1 && workers * (workers - 1) * IR_X64_THREAD_NS > work -> workers -= 1
    workers
}

// Compiles every function of `program` (function row = X64CompiledFunction
// id), collecting every function's selection errors, on as many threads as
// x64 selection admission (ir_x64_admit) gives its instructions. Threads
// claim functions heaviest first, each selecting against its own selector
// rows (ir_x64_select_function), and each result lands in its function's
// row; the module's tables then give the uses their rows in function order
// (ir_x64_tables_add), so the rows, errors, tables and bytes are those of
// the one-thread loop for any thread count. A thread that stops (an
// internal panic) costs only the function it was selecting: that function
// gets an error row and fresh threads select the rest.
ir_x64_compile_module: fn(program: &&IRModule, threads: CompilerThreads) -> IRX64Result Never! {
    ir_x64_compile_module_logged(program, threads, [String]{})
}

// The same, keeping the emission log (X64Code) of each function `names`
// names (ir_x64_log_names) in IRX64Result.log, after the members of the
// module's structs (IRModule.struct_fields), so a reader of the log names
// the member an `offset` or `load` reaches.
ir_x64_compile_module_logged: fn(program: &&IRModule, threads: CompilerThreads, names: [String]) -> IRX64Result Never! {
    m := program.move()
    ir_drop_early(m, threads)
    ir_tail_calls(m, threads)
    log := [String]{}
    if names.len() > 0 {
        loop line in m.struct_fields -> log.push(line.copy())
    }
    count: m.functions.len()
    weights := [Int]{}
    total := 0
    loop f in m.functions {
        weight: 1 + f.op.len()
        weights.push(weight)
        total += weight
    }
    workers: ir_x64_admit(threads, count, total, IR_X64_SELECT_NS_PER_INSTRUCTION)
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    variables := [[X64DebugVariable]]{}
    errors := [String]{}
    if workers <= 1 {
        tables := ir_x64_tables_start(m)
        loop row in 0..<count {
            compiled := ir_x64_select_function(m, row, names)
            rows: ir_x64_tables_add(tables, m.functions[row], compiled.uses)
            ir_x64_resolve(compiled.function, rows)
            ir_x64_tables_heat(tables, rows, compiled.hot, compiled.cold)
            errors.extend(compiler_take_rows<String>(compiled.errors))
            log.extend(compiler_take_rows<String>(compiled.log))
            functions.push(compiled.function.move())
            debug.push(compiled.debug.move())
            variables.push(compiled.variables.move())
        }
        ir_x64_tables_finish(m, tables)
        return IRX64Result{program: m.move(), functions: functions.move(), debug: debug.move(), variables: variables.move(), errors: errors.move(), tables: tables.move(), threads: threads, log: log.move()}
    }
    seats := [IRX64Seat]{}
    loop _ in 0..<workers -> seats.push(IRX64Seat{row: -1})
    inputs: Shared{IRX64Inputs{programs: [IRModule]{m.move()}, names: names, order: compiler_threads_heaviest_first(weights), next: 0, seats: seats.move()}}
    outputs := [[IRX64FunctionResult]]{}
    stops := [String]{}
    loop _ in 0..<count {
        outputs.push([IRX64FunctionResult]{})
        stops.push("")
    }
    ir_x64_select_rows(inputs, workers, outputs, stops)
    shells := ir_x64_take_inputs(inputs)
    // The rows leave their lists last-first (moved, never copied) and are
    // reversed into function order.
    row_errors := [[String]]{}
    row_logs := [[String]]{}
    row_uses := [[IRX64Use]]{}
    row_hot := [[Int]]{}
    row_cold := [[Int]]{}
    row := count - 1
    loop row >= 0 {
        taken := outputs.pop() ?? panic("the x64 selection lost a function row")
        stop: stops.pop() ?? ""
        if (taken.pop()) == .Val(compiled) {
            selected := compiled.move()
            row_errors.push(compiler_take_rows<String>(selected.errors))
            row_logs.push(compiler_take_rows<String>(selected.log))
            row_uses.push(compiler_take_rows<IRX64Use>(selected.uses))
            row_hot.push(compiler_take_rows<Int>(selected.hot))
            row_cold.push(compiler_take_rows<Int>(selected.cold))
            functions.push(selected.function.move())
            debug.push(selected.debug.move())
            variables.push(selected.variables.move())
        } else {
            row_errors.push([String]{"{shells.programs[0].functions[row].name}: selection stopped: {stop}"})
            row_logs.push([String]{})
            row_uses.push([IRX64Use]{})
            row_hot.push([Int]{})
            row_cold.push([Int]{})
            functions.push(X64CompiledFunction{id: X64FunctionID{value: row}, name: shells.programs[0].functions[row].name, code: [U8]{}, relocs: [X64Reloc]{}, align: X64_FUNCTION_ALIGN})
            debug.push(X64FunctionDebug{lines: [X64LineRow]{}, body: 0, cfi: [U8]{}, ranges: [X64VariableRange]{}})
            variables.push([X64DebugVariable]{})
        }
        row -= 1
    }
    functions.reverse()
    debug.reverse()
    variables.reverse()
    row_uses.reverse()
    row_hot.reverse()
    row_cold.reverse()
    loop row_errors.len() > 0 {
        listed := row_errors.pop() ?? {
            break
        }
        errors.extend(listed)
    }
    loop row_logs.len() > 0 {
        listed := row_logs.pop() ?? {
            break
        }
        log.extend(listed)
    }
    program_back := shells.programs.pop() ?? panic("the x64 selection inputs lost the module")
    tables := ir_x64_tables_start(program_back)
    loop (at, uses) in row_uses {
        rows: ir_x64_tables_add(tables, program_back.functions[at], uses)
        ir_x64_resolve(functions[at], rows)
        ir_x64_tables_heat(tables, rows, row_hot[at], row_cold[at])
    }
    ir_x64_tables_finish(program_back, tables)
    IRX64Result{program: program_back.move(), functions: functions.move(), debug: debug.move(), variables: variables.move(), errors: errors.move(), tables: tables.move(), threads: threads, log: log.move()}
}

// The selecting threads' inputs, read-only while they run: the module
// (moved in and taken back after the join), the JET_X64_EMIT_LOG names
// (ir_x64_log_names), the claim order (heaviest first) and its next rank,
// which a thread takes with one atomic add, and per seat the row its thread
// is selecting (-1 none).
IRX64Inputs: struct {
    programs: [IRModule],
    names: [String],
    order: [Int],
    next: Atomic<Int>,
    seats: [IRX64Seat],
}

IRX64Seat: struct {
    row: Atomic<Int>,
}

// A function row and its selection, kept by the thread that selected it
// until the join.
IRX64Selected: struct {
    row: Int,
    compiled: IRX64FunctionResult,
}

// Runs the selecting threads until every row of `outputs` holds its result
// or `stops` the panic text of a thread that stopped on it. A stopped
// thread's finished rows go with it and are selected again (selection is
// deterministic), so a round that leaves rows behind has stopped on one.
ir_x64_select_rows: fn(inputs: Shared<IRX64Inputs>, workers: Int, outputs: &[[IRX64FunctionResult]], stops: &[String]) {
    loop {
        parts := ir_x64_claimers(inputs, 0, workers, stops) ?? panic("the x64 selection threads failed")
        loop parts.len() > 0 {
            part := parts.pop() ?? {
                break
            }
            loop part.len() > 0 {
                selected := part.pop() ?? {
                    break
                }
                outputs[selected.row].push(selected.compiled.move())
            }
        }
        missing := [Int]{}
        stopped := 0
        loop row in 0..<outputs.len() {
            if stops[row] != "" -> stopped += 1 else if outputs[row].len() == 0 -> missing.push(row)
        }
        if missing.len() == 0 {
            return
        }
        if stopped == 0 {
            panic("the x64 selection threads left {missing.len()} functions unselected")
        }
        ir_x64_reclaim(inputs, missing)
    }
}

// The next round claims `rows`.
ir_x64_reclaim: fn(inputs: Shared<IRX64Inputs>, rows: &&[Int]) {
    permit := inputs.guard_edit()
    permit.value.order = rows.move()
    permit.value.next.store(0)
}

// Runs `tasks` claiming threads from seat `seat` on, one task each; returns
// their selections. A stopped thread's function keeps its panic text in
// `stops` (ir_x64_stopped).
ir_x64_claimers: fn(inputs: Shared<IRX64Inputs>, seat: Int, tasks: Int, stops: &[String]) -> [[IRX64Selected]] {
    if tasks <= 0 -> return [[IRX64Selected]]{}
    parts := [[IRX64Selected]]{}
    task.group ir_x64_threads {
        head: task ir_x64_claimed(inputs, seat)
        parts = ir_x64_claimers(inputs, seat + 1, tasks - 1, stops)
        part: head.join() ?? ir_x64_stopped(inputs, seat, err, stops)
        parts.push(part)
    }
    parts
}

// One thread at `seat`: claims and selects functions until none is left.
ir_x64_claimed: fn(inputs: Shared<IRX64Inputs>, seat: Int) -> [IRX64Selected] {
    reads: inputs.guard_read()
    selected := [IRX64Selected]{}
    loop {
        rank: reads.value.next.add(1)
        if rank >= reads.value.order.len() -> break
        row: reads.value.order[rank]
        reads.value.seats[seat].row.store(row)
        compiled := ir_x64_select_function(reads.value.programs[0], row, reads.value.names)
        selected.push(IRX64Selected{row: row, compiled: compiled.move()})
    }
    reads.value.seats[seat].row.store(-1)
    selected
}

// A thread at `seat` stopped: the function it was selecting keeps the panic text.
ir_x64_stopped: fn(inputs: Shared<IRX64Inputs>, seat: Int, failure: TaskFailure, stops: &[String]) -> [IRX64Selected] {
    reads: inputs.guard_read()
    row: reads.value.seats[seat].row.load()
    if row >= 0 {
        stops[row] = compiler_threads_failure_text(failure)
        reads.value.seats[seat].row.store(-1)
    }
    [IRX64Selected]{}
}

ir_x64_take_inputs: fn(inputs: Shared<IRX64Inputs>) -> IRX64Inputs {
    permit := inputs.guard_edit()
    IRX64Inputs{programs: compiler_take_rows<IRModule>(permit.value.programs), names: [String]{}, order: [Int]{}, next: 0, seats: [IRX64Seat]{}}
}

// The relocatable object of `compiled` (moved in, every row moved on): its
// functions behind a global `main` that runs the module's entry function
// (no parameters, no result) through the runtime's jet_rt_main, as the old
// native route's object, or itself when the program owns its main
// (IRModule.owned_main), attaching its thread first when
// IRModule.owned_attach, and a global symbol for each runtime provider hook
// the program defines (IRModule.hooks), which the link binds the runtime's
// calls of the hook to. `debug_info` false (the build option) leaves the
// DWARF sections empty.
ir_x64_object: fn(compiled: &&IRX64Result, debug_info: Bool) -> X64ExecutableResult Never! {
    owned := compiled.move()
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    errors := ir_x64_main_rows(owned, functions, debug)
    if errors.len() > 0 -> return X64ExecutableResult{bytes: [U8]{}, errors: errors.move()}
    exports := [X64RuntimeExport]{X64RuntimeExport{function: X64FunctionID{value: -1}, symbol: "main"}}
    loop hook in compiler_take_rows<IRLibraryExport>(owned.program.hooks) {
        exports.push(X64RuntimeExport{function: X64FunctionID{value: hook.function}, symbol: hook.symbol})
    }
    program: ir_x64_object_module(owned)
    threads: CompilerThreads{cap: owned.threads.cap, cores: owned.threads.cores, memory_available: owned.threads.memory_available}
    // What is left of the compile (its IR module above all) is read no more.
    // When its instructions admit threads (ir_x64_release_ways) it drops on
    // tasks of their own while the object is written; a smaller compile
    // drops here, after the object is written, as `owned` goes.
    ways: ir_x64_release_ways(owned.program, threads)
    if ways <= 1 {
        return x64_object_functions_threads(program, functions, debug, exports, [X64DataExport]{}, threads, debug_info, false)
    }
    released: Shared{IRX64Released{runs: [[IRFunction]]{}, rest: [IRX64Result]{}}}
    ir_x64_release_fill(released, owned, ways)
    objects := [X64ExecutableResult]{}
    task.group ir_x64_object_release {
        rest: task ir_x64_release_rest(released)
        dropped: task ir_x64_release_runs(released, -1)
        objects.push(x64_object_functions_threads(program, functions, debug, exports, [X64DataExport]{}, threads, debug_info, false))
        _: rest.join() ?? panic(compiler_threads_failure_text(err))
        _: dropped.join() ?? panic(compiler_threads_failure_text(err))
    }
    objects.pop() ?? panic("the object writer lost its object")
}

// What ir_x64_object writes without debug info, unwritten: the data of the
// module (the object reads no debug file, type or source then), `main` and
// the functions it or a kept root reaches with their debug rows, for a bind
// straight from them (JetBackend Image/DirectBind.jet
// x64_bind_functions_at); else `errors`, ir_x64_object's.
IRX64Program: struct {
    program: X64ObjectModule,
    functions: [X64CompiledFunction],
    debug: [X64FunctionDebug],
    threads: CompilerThreads,
    errors: [String],
}

// The program of `compiled` (moved in, its rows moved on; the rest drops
// here).
ir_x64_program: fn(compiled: &&IRX64Result) -> IRX64Program Never! {
    owned := compiled.move()
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    errors := ir_x64_main_rows(owned, functions, debug)
    IRX64Program{
        program: X64ObjectModule{data: compiler_take_rows<X64Data>(owned.tables.data), debug: X64ModuleDebug{directory: "", files: [String]{}, types: [X64DebugType]{}}, functions: [X64FunctionSource]{}},
        functions: functions.move(),
        debug: debug.move(),
        threads: CompilerThreads{cap: owned.threads.cap, cores: owned.threads.cores, memory_available: owned.threads.memory_available},
        errors: errors.move(),
    }
}

// The object's functions of `owned` into `functions`, with their debug rows
// into `debug`: `main` for its entry function (x64_object_main), then the
// compiled functions it or a kept root reaches (ir_x64_reached_only). Else
// why there are none: the compile's errors, or an entry `main` can't run.
ir_x64_main_rows: fn(owned: &IRX64Result, functions: &[X64CompiledFunction], debug: &[X64FunctionDebug]) -> [String] Never! {
    if owned.errors.len() > 0 -> return compiler_take_rows<String>(owned.errors)
    entry: owned.program.entry
    if entry < 0 || entry >= owned.program.functions.len() {
        return [String]{"entry function {entry} is not in the module"}
    }
    if owned.program.functions[entry].param_count != 0 || owned.program.functions[entry].result >= 0 {
        return [String]{"entry function {owned.program.functions[entry].name} must take no parameters and return nothing"}
    }
    main: x64_object_main(X64FunctionID{value: entry}, owned.program.owned_main, owned.program.owned_attach)
    debug.push(x64_object_main_debug(main))
    debug.extend(compiler_take_rows<X64FunctionDebug>(owned.debug))
    functions.push(main.move())
    functions.extend(compiler_take_rows<X64CompiledFunction>(owned.functions))
    ir_x64_reached_only(functions, debug, owned.program.kept)
    [String]{}
}

// Keeps the rows of `functions` (with their `debug` rows) whose function the
// first row, `main`, or a `dead_code: keep` root (`roots`, IRModule.kept)
// reaches through function relocations. The optimizer keeps every body it
// inlined (ir_optimize_module), so a function whose calls were all inlined
// has none left; a program object is one `.text`, which the static link
// keeps whole, so its dead functions go here.
ir_x64_reached_only: fn(functions: &[X64CompiledFunction], debug: &[X64FunctionDebug], roots: [Int]) Never! {
    if functions.len() != debug.len() {
        panic("the object writer has {functions.len()} functions and {debug.len()} debug rows")
    }
    max_id := -1
    loop function in functions {
        if function.id.value > max_id -> max_id = function.id.value
    }
    // Per function id + 1 its rows, and whether it is reached.
    id_rows := [[Int]]{}
    reached := [Bool]{}
    loop _ in 0..<(max_id + 2) {
        id_rows.push([Int]{})
        reached.push(false)
    }
    loop (index, function) in functions {
        if function.id.value >= -1 -> id_rows[function.id.value + 1].push(index)
    }
    work := [Int]{functions[0].id.value}
    reached[functions[0].id.value + 1] = true
    loop id in roots {
        if id + 1 < 0 || id + 1 >= reached.len() || reached[id + 1] -> next
        reached[id + 1] = true
        work.push(id)
    }
    loop work.len() > 0 {
        id: work.pop() ?? {
            break
        }
        loop row in id_rows[id + 1] {
            loop reloc in functions[row].relocs {
                if reloc.target == {
                    .Function(target) -> {
                        at: target.value + 1
                        if at >= 0 && at < reached.len() && !reached[at] {
                            reached[at] = true
                            work.push(target.value)
                        }
                    }
                    .Runtime(_) | .Data(_) | .RuntimeData(_) -> {}
                }
            }
        }
    }
    kept := [X64CompiledFunction]{}
    kept_debug := [X64FunctionDebug]{}
    loop functions.len() > 0 {
        function := functions.pop() ?? {
            break
        }
        facts := debug.pop() ?? panic("the object writer lost a debug row")
        at: function.id.value + 1
        if at >= 0 && reached[at] {
            kept.push(function)
            kept_debug.push(facts)
        }
    }
    kept.reverse()
    kept_debug.reverse()
    compiler_transfer_rows<X64CompiledFunction>(functions, kept)
    compiler_transfer_rows<X64FunctionDebug>(debug, kept_debug)
}

// What ir_x64_object releases: the compile's IR functions in runs, each
// dropped on a thread of its own, and the `rest` of the compile. A task's
// arguments stay shared with the thread that spawns it, which drops them
// after the join, so what a task drops reaches it here: it pops it off.
IRX64Released: struct {
    runs: [[IRFunction]],
    rest: [IRX64Result],
}

// The most runs the IR functions of an object's compile drop in
// (ir_x64_release_fill): on one thread their drop outlasts the object write.
IR_X64_RELEASE_WAYS: 4

// Dropping an IR function's instructions costs about this much per
// instruction (measured as above).
IR_X64_RELEASE_NS_PER_INSTRUCTION: 15

// The runs `program`'s IR functions drop in: the threads x64 selection
// admission (ir_x64_admit) gives their drop, up to IR_X64_RELEASE_WAYS. One
// run means the compile is too small for a thread to pay off.
ir_x64_release_ways: fn(program: IRModule, threads: CompilerThreads) -> Int Never! {
    total := 0
    loop f in program.functions -> total += 1 + f.op.len()
    admitted: ir_x64_admit(threads, program.functions.len(), total, IR_X64_RELEASE_NS_PER_INSTRUCTION)
    if admitted > IR_X64_RELEASE_WAYS -> IR_X64_RELEASE_WAYS else -> admitted
}

// Moves `compiled` into `released`: its IR functions in `ways` runs
// (ir_x64_release_ways), then the rest.
ir_x64_release_fill: fn(released: Shared<IRX64Released>, compiled: &&IRX64Result, ways: Int) Never! {
    owned := compiled.move()
    share: owned.program.functions.len() /% ways + 1
    permit: released.guard_edit()
    loop owned.program.functions.len() > 0 {
        run := [IRFunction]{}
        loop run.len() < share && owned.program.functions.len() > 0 {
            row := owned.program.functions.pop() ?? panic("a nonempty IR function list failed to pop")
            run.push(row)
        }
        permit.value.runs.push(run)
    }
    permit.value.rest.push(owned)
}

// Drops `runs` runs of `released` (-1: all of them), each on a thread of its
// own and the last on this one; returns how many IR functions they held.
ir_x64_release_runs: fn(released: Shared<IRX64Released>, runs: Int) -> Int Never! {
    if runs < 0 -> return ir_x64_release_runs(released, ir_x64_release_count(released))
    if runs == 0 -> return 0
    if runs == 1 -> return ir_x64_release_run(released)
    count := 0
    task.group ir_x64_release_threads {
        head: task ir_x64_release_run(released)
        count = ir_x64_release_runs(released, runs - 1)
        count += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    count
}

// Pops a run off `released` and drops it here, outside the lock; returns how
// many IR functions it held.
ir_x64_release_run: fn(released: Shared<IRX64Released>) -> Int Never! {
    run: ir_x64_release_pop_run(released)
    run.len()
}

ir_x64_release_pop_run: fn(released: Shared<IRX64Released>) -> [IRFunction] Never! {
    permit: released.guard_edit()
    permit.value.runs.pop() ?? [IRFunction]{}
}

ir_x64_release_count: fn(released: Shared<IRX64Released>) -> Int Never! {
    permit: released.guard_read()
    permit.value.runs.len()
}

// Pops the rest of the compile off `released` and drops it here, outside the
// lock; returns how many rows of it there were (one).
ir_x64_release_rest: fn(released: Shared<IRX64Released>) -> Int Never! {
    rest: ir_x64_release_pop_rest(released)
    rest.len()
}

ir_x64_release_pop_rest: fn(released: Shared<IRX64Released>) -> [IRX64Result] Never! {
    permit: released.guard_edit()
    compiler_take_rows<IRX64Result>(permit.value.rest)
}

// Order the functions of `compiled` (and their debug rows) for the object's
// text: those `hot` names first, in the list's order, then the rest, each
// group in function order. `hot` lists the functions short cold runs enter,
// a hello `jet run`'s first (Compiler/JetCLI/hot-text.list, written by
// Tools/Perf/HotText.mjs), so their code shares pages: the kernel maps a
// read fault's neighboring pages with it, and a run that touches few
// windows of the image keeps few pages resident. JetBackend Object.jet lays
// `.data` out in the order this text references it. Returns how many names of
// `hot` name no function.
//
// A closure's, instance's or helper's symbol ends with its key's hash
// (ir_hashed_function), and the hash changes as the types its key spells
// do, so the list goes stale on those first; each of them a run enters then
// sits alone among the cold functions and costs the run a window of pages.
// A listed name no function has therefore hands its place to an unlisted
// function whose symbol differs from it only in that hash, in the list's
// and the functions' order, when the list's missing names of that stem are
// at least as many as such functions: a function's closures, or a generic
// function's instances, renamed together. A stem shared by more functions
// than missing names (a drop or copy helper's) says nothing of which one
// the list meant, and its functions stay cold.
ir_x64_hot_order: fn(compiled: &IRX64Result, hot: [String]) -> Int Never! {
    if hot.len() == 0 -> return 0
    ranks := [String:Int]{}
    loop (position, name) in hot {
        if ranks.get(name) == None -> ranks[name.copy()] = position
    }
    count: compiled.functions.len()
    // Per function its rank, -1 when not listed; per rank whether a
    // function has its name.
    found := [Int]{}
    named := [Bool]{}
    loop _ in 0..<hot.len() -> named.push(false)
    loop index in 0..<count {
        listed: ranks.get(compiled.functions[index].name) ?? -1
        found.push(listed)
        if listed >= 0 -> named[listed] = true
    }
    // The stems of the missing hashed names (side 0, at their rank) and of
    // the unlisted hashed functions (side 1, at their index), sorted so each
    // stem's ranks come in list order and then its functions in function
    // order.
    missing := 0
    stems := [{stem: String, side: Int, at: Int}]{}
    loop (position, name) in hot {
        if named[position] || (ranks.get(name) ?? -1) != position -> next
        missing += 1
        start: ir_x64_hash_start(name)
        if start >= 0 -> stems.push({stem: name.slice(0, start), side: 0, at: position})
    }
    if stems.len() > 0 {
        loop index in 0..<count {
            if found[index] >= 0 -> next
            name: compiled.functions[index].name
            start: ir_x64_hash_start(name)
            if start >= 0 -> stems.push({stem: name.slice(0, start), side: 1, at: index})
        }
        stems.sort_by(fn(left: {stem: String, side: Int, at: Int}, right: {stem: String, side: Int, at: Int}) { (left.stem <=> right.stem).then(left.side <=> right.side).then(left.at <=> right.at) })
        first := 0
        loop first < stems.len() {
            functions := first
            loop functions < stems.len() && stems[functions].stem == stems[first].stem && stems[functions].side == 0 {
                functions += 1
            }
            last := functions
            loop last < stems.len() && stems[last].stem == stems[first].stem -> last += 1
            if last - functions <= functions - first {
                loop at in functions..<last {
                    found[stems[at].at] = stems[first + at - functions].at
                }
            }
            first = last
        }
    }
    // Per rank where its functions start in the new order (a counting sort
    // keeps function order within a rank).
    starts := [Int]{}
    loop _ in 0..<hot.len() + 1 -> starts.push(0)
    loop level in found {
        if level >= 0 -> starts[level + 1] = starts[level + 1] + 1
    }
    loop place in 0..<hot.len() -> starts[place + 1] = starts[place + 1] + starts[place]
    order := [Int]{}
    loop _ in 0..<count -> order.push(0)
    cold := starts[hot.len()]
    loop index in 0..<count {
        level: found[index]
        if level >= 0 {
            order[starts[level]] = index
            starts[level] = starts[level] + 1
        } else {
            order[cold] = index
            cold += 1
        }
    }
    compiler_apply_order<X64CompiledFunction>(compiled.functions, order.copy())
    compiler_apply_order<X64FunctionDebug>(compiled.debug, order)
    missing
}

// Where the key hash ends `symbol` (ir_hashed_function): the offset of its
// last 16 bytes when they are lowercase hex digits after a `_`, else -1.
ir_x64_hash_start: fn(symbol: String) -> Int Never! {
    bytes: symbol.bytes()
    start: bytes.len() - 16
    if start < 1 || bytes[start - 1] != 95 -> return -1
    loop at in start..<bytes.len() {
        byte: bytes[at]
        digit: byte >= U8{48} && byte <= U8{57}
        letter: byte >= U8{97} && byte <= U8{102}
        if !digit && !letter -> return -1
    }
    start
}

// The relocatable object of a library module (moved in, every row moved
// on): its functions with no `main`, each of `exports` (ir_build_library)
// a global symbol of its IR function and, with a priority, a constructor or
// destructor hook, and each of `data_exports` a global symbol of its data
// object. `debug_info` as ir_x64_object. With `own_sections` every function
// and data object is in a section of its own, so a link keeps only what it
// reaches; past the section indices ELF's headers hold (the Core library)
// the object numbers them through section 0 and `.symtab_shndx`.
ir_x64_library_object: fn(compiled: &&IRX64Result, exports: [IRLibraryExport], data_exports: [X64DataExport], debug_info: Bool, own_sections: Bool) -> X64ExecutableResult Never! {
    owned := compiled.move()
    if owned.errors.len() > 0 {
        return X64ExecutableResult{bytes: [U8]{}, errors: owned.errors.move()}
    }
    program := ir_x64_object_module(owned)
    debug := compiler_take_rows<X64FunctionDebug>(owned.debug)
    functions := compiler_take_rows<X64CompiledFunction>(owned.functions)
    globals: loop row in exports -> X64RuntimeExport{function: X64FunctionID{value: row.function}, symbol: row.symbol, init_priority: row.init_priority, fini_priority: row.fini_priority, guards: row.guards.copy()}
    x64_object_functions_threads(program, functions, debug, globals, data_exports, owned.threads, debug_info, own_sections)
}

// The object writer's module of `owned`: its data, debug files and types
// and per IR function its name, file, line, debug variables (taken) and
// inline sites.
ir_x64_object_module: fn(owned: &IRX64Result) -> X64ObjectModule Never! {
    // Popped in function order.
    variables := compiler_take_rows<[X64DebugVariable]>(owned.variables)
    variables.reverse()
    sources := [X64FunctionSource]{}
    loop f in owned.program.functions {
        file: owned.tables.file_rows.get(f.source_file) ?? -1
        listed := variables.pop() ?? [X64DebugVariable]{}
        inlines := [X64InlineSite]{}
        loop site in 1..<(f.inline_sites.len() /% IR_INLINE_SITE_WORDS + 1) {
            word: IR_INLINE_SITE_WORDS * (site - 1)
            row: f.inline_sites[word]
            parent: ir_inline_site_parent(f, site)
            call_line: f.inline_sites[word + 2]
            if row < 0 || row >= owned.program.functions.len() {
                inlines.push(X64InlineSite{function: -1, name: "?", file: -1, line: 0, parent: parent, call_line: call_line})
                next
            }
            callee: owned.program.functions[row]
            inlines.push(X64InlineSite{function: row, name: callee.name, file: owned.tables.file_rows.get(callee.source_file) ?? -1, line: callee.line, parent: parent, call_line: call_line})
        }
        sources.push(X64FunctionSource{name: f.name, file: file, line: f.line, variables: listed.move(), inlines: inlines.move()})
    }
    X64ObjectModule{
        data: compiler_take_rows<X64Data>(owned.tables.data),
        debug: X64ModuleDebug{directory: owned.program.debug_directory.copy(), files: compiler_take_rows<String>(owned.tables.files), types: compiler_take_rows<X64DebugType>(owned.tables.debug_types)},
        functions: sources.move(),
    }
}
