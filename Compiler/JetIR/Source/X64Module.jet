// x86-64 code for a whole IR module, and its relocatable object through the
// existing object writer (JetBackend Image/Object.jet). The writer and its
// DWARF read an X64ObjectModule (Image/Emission.jet): the IR data rows as
// X64Data (same ids), then an immortal String header per ConstText row and
// the texts the selector names itself (source paths, stop messages,
// big-integer decimals); the debug files and types; and per IR function its
// name, file, line and debug variables.
use {
    jet_foundation.[interner_empty, CompilerThreads, CompilerTraceSink, FnBody, NameTable, TConstantDef, TImplDef, TTypeDef, Type, compiler_apply_order, compiler_take_rows, compiler_threads_admit, compiler_threads_failure_text, compiler_threads_joined, compiler_threads_taken, compiler_threads_heaviest_first, compiler_threads_single, compiler_transfer_rows, module_none, name_find, name_index, name_intern, name_table_sized, sha256_hex, symbol_table]
    jet_sema.[sema_inline_member_module, sema_inline_member_source_name]
    jet_backend.[
        TIME_DURATION_NS,
        X64CompiledFunction,
        X64Data,
        X64DataExport,
        X64DataID,
        X64DataReloc,
        X64DebugEncoding,
        X64DebugEnumerator,
        X64DebugMember,
        X64DebugSource,
        X64DebugType,
        X64DebugTypeKind,
        X64DebugVariant,
        X64DebugVariable,
        X64DwarfSymbols,
        X64ExecutableResult,
        X64FunctionDebug,
        X64FunctionID,
        X64FunctionSource,
        X64InlineSite,
        X64LineRow,
        X64ModuleDebug,
        X64ObjectModule,
        X64Reloc,
        X64RuntimeExport,
        X64VariableRange,
        X64_FUNCTION_ALIGN,
        X64_RELOC_DATA,
        X64_RELOC_FUNCTION,
        dwarf_test_bytes,
        x64_dwarf_sections,
        x64_object_functions_threads,
        x64_object_main,
        x64_object_main_debug,
        x64_object_zone_sites,
    ]
}

// Texts and a row each names: `rows[id]` is the row of the text `names`
// interns as `id`, -1 when none is set (ir_x64_text_rows_get).
IRX64TextRows: struct {
    names: NameTable{name_table_sized(16)},
    rows: [Int]{[Int]{-1}},
}

// The row `table` names for `text`, -1 when it names none.
ir_x64_text_rows_get: fn(table: IRX64TextRows, text: String) -> Int Never! {
    found: name_find(table.names, text) ?? return -1
    table.rows[name_index(found)]
}

// Names `row` for `text` in `table`.
ir_x64_text_rows_set: fn(table: ^IRX64TextRows, text: String, row: Int) Never! {
    id: name_index(name_intern(table.names, text))
    loop table.rows.len() <= id -> table.rows.push(-1)
    table.rows[id] = row
}

// The module-wide rows the object writer reads: the IR data rows, then the
// selector rows every function's selection named (ir_x64_tables_add).
IRX64Tables: struct {
    // The IR data rows (same ids), then headers and texts.
    data: [X64Data],
    // Byte length of every data row.
    lengths: [Int],
    // Per IR data row: the data row of its immortal String header, -1 when
    // no ConstText names it.
    headers: [Int],
    // Selector texts (source paths, stop messages, big-integer decimals) -> data row.
    texts: IRX64TextRows,
    // Big-integer decimals -> the data row of the word that is their static
    // exact Int (ir_x64_static_int).
    ints: IRX64TextRows,
    // DWARF: the source files (row per distinct path) and a debug type per
    // IR type row (debug row r describes m.types[r]), then the rows they name.
    files: [String],
    file_rows: IRX64TextRows,
    debug_types: [X64DebugType],
    // The data row of the byte caching whether the CPU has FMA3 (X64Select.jet
    // ir_x64_fma), -1 when no function calls jet_std_math_fma.
    fma: Int,
    // The data row of the byte caching the CPU SIMD level (0=unprobed, 1=SSE2,
    // 2=AVX2+POPCNT, 3=AVX-512+POPCNT) for reduction asm leaves, -1 if unused.
    simd: Int,
    // Per data row, whether code that goes on reads it (ir_x64_tables_heat);
    // rows past its end are not.
    hot: [Bool]{[Bool]{}},
    last_file: String{""},
    last_text: String{""},
    last_text_row: Int{-1},
    // Module-wide interned runtime symbol names for indexed X64Reloc targets.
    runtime_symbols: [String]{[String]{}},
}

// The data rows a function's selection names besides the IR data rows, a
// row per use: a selector text, the String header of an IR data row, a
// big-integer decimal's static Int word, the FMA byte, or the SIMD level byte.
// Per use its kind, the IR data row a Header names (-1 for the others), and
// the text a Text or StaticInt names ("" for the others).
IRX64Uses: struct {
    kinds: [IRX64UseKind]{[IRX64UseKind]{}},
    data: [Int]{[Int]{}},
    texts: [String]{[String]{}},
}

IRX64UseKind: enum {
    Text,
    Header,
    StaticInt,
    Fma,
    Simd,
}

// Use k of a function's selection is data row IR_X64_LOCAL_DATA + k in its
// code until ir_x64_resolve points it at the module's row: above every
// module row, so the two never meet.
IR_X64_LOCAL_DATA: 1099511627776

// One function's own selector rows (ir_x64_function_tables): each row it
// names once, in the order the walk meets it, and the lookups its selection
// reads. Its selection reads no module-wide table, so any thread selects
// any function with no walk over the module first; the module gives the
// uses their rows afterwards, in function order (ir_x64_tables_add), the
// rows one walk over the whole module would give them.
IRX64FunctionTables: struct {
    uses: IRX64Uses,
    // Per use: the byte length of its data.
    lengths: [Int],
    // Selector texts, IR data rows with a String header, big-integer
    // decimals with a static Int -> local data row.
    texts: IRX64TextRows,
    headers: [Int:Int],
    ints: IRX64TextRows,
    // The local data row of the FMA byte, -1 when the function calls no
    // jet_std_math_fma.
    fma: Int,
    // The local data row of the SIMD level byte, -1 when not a SIMD reduction leaf.
    simd: Int,
    // Whether the selection keeps an emission log (JET_X64_EMIT_LOG,
    // ir_x64_compile_module_logged).
    logged: Bool,
    // The data rows its DataAddress and ConstText instructions read (module
    // rows, a header as its local row), `cold` those on the way to a stop
    // (ir_x64_dying), `hot` the others; ir_x64_tables_heat marks them.
    hot: [Int]{[Int]{}},
    cold: [Int]{[Int]{}},
}

// Whether JET_X64_EMIT_LOG entry list `names` names function `f`: an entry
// is a function's name, or, holding a `/`, a part of its source path.
ir_x64_log_names: fn(f: IRFunction, names: [String]) -> Bool Never! {
    loop name in names {
        if name == f.name -> return true
        if name.contains("/") && f.source_file.contains(name) -> return true
    }
    false
}

// The module moves in and comes back in `program`, so the object writer
// reads the same rows the selection read without a copy.
IRX64Result: struct {
    program: IRModule,
    functions: [X64CompiledFunction],
    debug: [X64FunctionDebug],
    // Per function: the debug variables its ranges index.
    variables: [[X64DebugVariable]],
    errors: [String],
    tables: IRX64Tables,
    threads: CompilerThreads,
    // The logged functions' emission logs, in function order
    // (ir_x64_log_text), one line per row.
    log: [String],
}

ir_x64_add_text: fn(tables: ^IRX64Tables, text: String) -> Int Never! {
    if tables.last_text_row >= 0 && text == tables.last_text -> return tables.last_text_row
    found: ir_x64_text_rows_get(tables.texts, text)
    if found >= 0 {
        tables.last_text = text
        tables.last_text_row = found
        return found
    }
    id: tables.data.len()
    bytes: text.bytes()
    tables.lengths.push(bytes.len())
    tables.data.push(X64Data{id: X64DataID{value: id}, bytes: bytes, align: 1, relocs: [X64DataReloc]{}, read_only: true})
    ir_x64_text_rows_set(tables.texts, text, id)
    tables.last_text = text
    tables.last_text_row = id
    id
}

// A big-integer decimal's exact Int as process-lifetime data
// (JetRuntime Int.jet's 48-byte carrier and its base-1e9 u32 limbs), and
// the data word holding the tagged Int that names it, so a ConstBigInt is
// one load instead of a runtime parse and allocation per evaluation. The
// carrier starts with 2^62 references: every owner a load hands out is
// dropped once and a clone adds its own, so no run reaches the count zero
// that would free it. A decimal the carrier can't hold canonically (one in
// the inline range, or not plain digits) keeps the runtime parse.
ir_x64_static_int: fn(tables: ^IRX64Tables, text: String) Never! {
    if ir_x64_text_rows_get(tables.ints, text) >= 0 || !ir_x64_static_int_fits(text) {
        return
    }
    bytes := [Int]{}
    loop byte in text.bytes() -> bytes.push(Int{byte})
    negative: bytes[0] == 45
    first: if negative -> 1 else -> 0
    limbs := [U8]{}
    count := 0
    end := bytes.len()
    loop end > first {
        start: if end - 9 > first -> end - 9 else -> first
        limb := 0
        loop at in start..<end -> limb = limb * 10 + bytes[at] - 48
        loop shift in 0..<4 -> limbs.push(U8{(limb >> (8 * shift)) & 255})
        count += 1
        end = start
    }
    limbs_row: tables.data.len()
    tables.lengths.push(limbs.len())
    tables.data.push(X64Data{id: X64DataID{value: limbs_row}, bytes: limbs.move(), align: 4, relocs: [X64DataReloc]{}})
    // refs, retired_next, negative, limbs (relocated), len, cap.
    words: [Int]{4611686018427387904, 0, if negative -> 1 else -> 0, 0, count, count}
    carrier := [U8]{}
    loop word in words {
        loop shift in 0..<8 -> carrier.push(U8{(word >> (8 * shift)) & 255})
    }
    carrier_row: tables.data.len()
    tables.lengths.push(48)
    tables.data.push(X64Data{id: X64DataID{value: carrier_row}, bytes: carrier.move(), align: 8, relocs: [X64DataReloc]{X64DataReloc{offset: 24, target: X64DataID{value: limbs_row}, addend: 0}}})
    // The Int word is the carrier's address with bit 62 set (Int.jet int_tag).
    tagged := [U8]{}
    loop _ in 0..<8 -> tagged.push(U8{0})
    word_row: tables.data.len()
    tables.lengths.push(8)
    tables.data.push(X64Data{id: X64DataID{value: word_row}, bytes: tagged.move(), align: 8, relocs: [X64DataReloc]{X64DataReloc{offset: 0, target: X64DataID{value: carrier_row}, addend: 4611686018427387904}}})
    ir_x64_text_rows_set(tables.ints, text, word_row)
}

// Whether ir_x64_static_int makes a static Int for decimal `text`: plain
// digits, an optional `-`, no leading zero, outside the inline range.
ir_x64_static_int_fits: fn(text: String) -> Bool Never! {
    bytes := [Int]{}
    loop byte in text.bytes() -> bytes.push(Int{byte})
    negative: bytes.len() > 0 && bytes[0] == 45
    first: if negative -> 1 else -> 0
    digits: bytes.len() - first
    if digits < 19 || bytes[first] == 48 -> return false
    loop at in first..<bytes.len() {
        if bytes[at] < 48 || bytes[at] > 57 -> return false
    }
    // A 19-digit magnitude up to 2^62 - 1 (2^62 when negative) is an inline Int.
    if digits == 19 {
        bound: (if negative -> "4611686018427387904" else -> "4611686018427387903").bytes()
        at := 0
        loop at < 19 && bytes[first + at] == (Int{bound[at]}) -> at += 1
        if at == 19 || bytes[first + at] < (Int{bound[at]}) -> return false
    }
    true
}

// The shared rows the DWARF types of the IR type rows name.
IRX64DebugRows: struct {
    // A machine word (I64), a byte (U8) and an untyped pointer.
    word: Int,
    byte: Int,
    pointer: Int,
    // The exact Int: the word under its own name, which a debugger shows
    // so a reader knows to decode a tagged carrier (JetRuntime Int.jet).
    int: Int,
    // The pointee structs, made on first use (-1 before).
    string: Int,
    decimal: Int,
    fraction: Int,
    duration: Int,
}

// Appends `ty` to the debug types; returns its row.
ir_x64_debug_add: fn(tables: ^IRX64Tables, ty: ^^X64DebugType) -> Int Never! {
    row: tables.debug_types.len()
    tables.debug_types.push(ty)
    row
}

// A pointer to debug row `target`.
ir_x64_debug_pointer: fn(tables: ^IRX64Tables, target: Int) -> Int Never! {
    ir_x64_debug_add(tables, X64DebugType{name: "", size: 8, kind: X64DebugTypeKind.Pointer{target: target}})
}

// A Shared value's runtime cell keeps the pointer to its value's bytes at
// this offset (JetRuntime Shared.jet, Cell104's payload word).
IR_X64_SHARED_PAYLOAD: 64

// The DWARF type of every IR type row, by its checked type and machine
// layout: debug row r describes m.types[r]; the rows they name follow. A
// String is a pointer to its header [data, byte length, cap]; a List its
// inline header [len, cap, data], data pointing at its element row
// (IRModule.list_elements), and a Map the same header, data pointing at its
// entry tuple row; a struct or tuple its members at their offsets
// (IRModule.debug_members); an enum, union, Option or Result its variants
// (IRModule.debug_variants, ir_x64_debug_variants); a Decimal or Fraction a
// pointer to its runtime handle's two exact Ints (JetRuntime
// RoutePrecise.jet); a Duration a typedef of a pointer to its runtime
// record's nanoseconds word (JetRuntime TimeGlue.jet); a Shared a typedef,
// named as Jet spells it, of a pointer to its cell, whose payload word
// points at its value's row (IRModule.list_elements); a Task, Sender,
// Receiver or any other runtime handle a typedef, named as Jet spells it, of
// its runtime state's pointer; an allocation word a typedef of what its
// block holds (ir_x64_debug_alloc). Any other aggregate stays opaque.
ir_x64_debug_types: fn(m: IRModule, tables: ^IRX64Tables) Never! {
    loop _ in 0..<m.types.len() {
        tables.debug_types.push(X64DebugType{name: "", size: 0, kind: X64DebugTypeKind.Opaque})
    }
    word: ir_x64_debug_add(tables, X64DebugType{name: "I64", size: 8, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Signed}})
    byte: ir_x64_debug_add(tables, X64DebugType{name: "U8", size: 1, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Unsigned}})
    pointer: ir_x64_debug_pointer(tables, -1)
    int: ir_x64_debug_add(tables, X64DebugType{name: "Int", size: 8, kind: X64DebugTypeKind.Typedef{target: word}})
    shared := IRX64DebugRows{word: word, byte: byte, pointer: pointer, int: int, string: -1, decimal: -1, fraction: -1, duration: -1}
    loop (row, ty) in m.types {
        described: ir_x64_debug_type(m, tables, shared, row, ty)
        tables.debug_types[row] = described
    }
}

// The DWARF description of IR type row `row`.
ir_x64_debug_type: fn(m: IRModule, tables: ^IRX64Tables, shared: ^IRX64DebugRows, row: Int, ty: IRType) -> X64DebugType Never! {
    if ir_alloc_served(m, row) == .Val(served) -> return ir_x64_debug_alloc(tables, served)
    if ir_x64_debug_variants(m, tables, shared, row, ty) == .Val(described) -> return described
    if ty.kind == {
        .Unit -> X64DebugType{name: "Unit", size: 0, kind: X64DebugTypeKind.Opaque}
        .Bool -> X64DebugType{name: "Bool", size: 1, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Bool}}
        .Int -> X64DebugType{name: "Int", size: 8, kind: X64DebugTypeKind.Typedef{target: shared.word}}
        .Word -> {
            bits: ir_x64_bits(ir_x64_shape(ty))
            // Whole bytes, rounded up: a U4 is 1 byte.
            X64DebugType{name: "{if ty.signed -> "I" else -> "U"}{bits}", size: (bits + 7) /% 8, kind: X64DebugTypeKind.Base{encoding: if ty.signed -> X64DebugEncoding.Signed else -> X64DebugEncoding.Unsigned}}
        }
        .Float -> X64DebugType{name: "Float", size: 8, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Float}}
        .Float32 -> X64DebugType{name: "F32", size: 4, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Float}}
        .Char -> X64DebugType{name: "Char", size: 4, kind: X64DebugTypeKind.Base{encoding: X64DebugEncoding.Char}}
        .String -> {
            if shared.string < 0 {
                data: ir_x64_debug_pointer(tables, shared.byte)
                members: [X64DebugMember]{X64DebugMember{name: "data", offset: 0, ty: data}, X64DebugMember{name: "len", offset: 8, ty: shared.word}, X64DebugMember{name: "cap", offset: 16, ty: shared.word}}
                header: ir_x64_debug_add(tables, X64DebugType{name: "String", size: 24, kind: X64DebugTypeKind.Struct{members: members}})
                shared.string = ir_x64_debug_pointer(tables, header)
            }
            X64DebugType{name: "String", size: 8, kind: X64DebugTypeKind.Typedef{target: shared.string}}
        }
        .Pointer -> {
            // A precise number's or a Duration's handle, known by its row
            // (the row's type is a table spelling, keyed or bare).
            if ir_handle_row_is(m, row, "JetDecimal") {
                if shared.decimal < 0 {
                    shared.decimal = ir_x64_debug_handle(tables, "Decimal", "coefficient", "scale", shared.int, shared.word)
                }
                return X64DebugType{name: "Decimal", size: 8, kind: X64DebugTypeKind.Typedef{target: shared.decimal}}
            }
            if ir_handle_row_is(m, row, "JetFraction") {
                if shared.fraction < 0 {
                    shared.fraction = ir_x64_debug_handle(tables, "Fraction", "numerator", "denominator", shared.int, shared.int)
                }
                return X64DebugType{name: "Fraction", size: 8, kind: X64DebugTypeKind.Typedef{target: shared.fraction}}
            }
            if ir_handle_row_is(m, row, "Duration") {
                if shared.duration < 0 {
                    members: [X64DebugMember]{X64DebugMember{name: "ns", offset: Int{TIME_DURATION_NS}, ty: shared.word}}
                    record: ir_x64_debug_add(tables, X64DebugType{name: "Duration", size: 8, kind: X64DebugTypeKind.Struct{members: members}})
                    shared.duration = ir_x64_debug_pointer(tables, record)
                }
                return X64DebugType{name: "Duration", size: 8, kind: X64DebugTypeKind.Typedef{target: shared.duration}}
            }
            // A Shared handle: named as Jet spells it, a typedef of the
            // pointer to its runtime cell, which points at the value's bytes
            // (IRModule.list_elements) from its payload word. The debugger
            // shows the cell, its one unnamed member, as `Shared{value}`.
            written: ir_module_row_ty(m, row)
            if ir_untag(written) == .Shared(_) {
                value: ir_x64_debug_pointer(tables, m.list_elements.get(row) ?? -1)
                members: [X64DebugMember]{X64DebugMember{name: "", offset: IR_X64_SHARED_PAYLOAD, ty: value}}
                cell: ir_x64_debug_add(tables, X64DebugType{name: "Shared", size: IR_X64_SHARED_PAYLOAD + 8, kind: X64DebugTypeKind.Struct{members: members}})
                return X64DebugType{name: ir_type_name(written), size: 8, kind: X64DebugTypeKind.Typedef{target: ir_x64_debug_pointer(tables, cell)}}
            }
            // Any other runtime handle (a task's, a channel endpoint's,
            // Bytes, a Clock): named as Jet spells it, a typedef of the
            // runtime state's pointer, which the debugger reads by that name
            // (JetDebug Native.jet native_debug_runtime_handle).
            if ir_task_element(written) != None || ir_channel_element(written, "Sender") != None || ir_channel_element(written, "Receiver") != None || ir_runtime_handle(ir_nominal_name(ir_untag(written)) ?? "") != None {
                return X64DebugType{name: ir_type_name(written), size: 8, kind: X64DebugTypeKind.Typedef{target: shared.pointer}}
            }
            X64DebugType{name: "Pointer", size: 8, kind: X64DebugTypeKind.Pointer{target: -1}}
        }
        .Aggregate -> {
            written: ir_module_row_ty(m, row)
            if ir_untag(written) == .List(_) || ir_untag(written) == .Map(_, _, _) {
                target: m.list_elements.get(row) ?? -1
                data: ir_x64_debug_pointer(tables, target)
                members: [X64DebugMember]{X64DebugMember{name: "len", offset: 0, ty: shared.word}, X64DebugMember{name: "cap", offset: 8, ty: shared.word}, X64DebugMember{name: "data", offset: 16, ty: data}}
                return X64DebugType{name: ir_type_name(written), size: ty.size, kind: X64DebugTypeKind.Struct{members: members}}
            }
            list: m.debug_members.get(row) ?? -1
            if list >= 0 {
                members: loop field in m.member_lists[list] -> X64DebugMember{name: field.name, offset: field.offset, ty: if field.boxed -> shared.pointer else -> field.ty}
                return X64DebugType{name: ir_type_name(written), size: ty.size, kind: X64DebugTypeKind.Struct{members: members}}
            }
            X64DebugType{name: "Aggregate", size: ty.size, kind: X64DebugTypeKind.Opaque}
        }
    }
}

// An allocation word's (Build.jet ir_alloc_served): a typedef named as Jet
// spells the type its block serves, of a pointer to the row its block
// holds values laid out as (a List's elements, a struct's or tuple's
// members), else to unknown bytes.
ir_x64_debug_alloc: fn(tables: ^IRX64Tables, served: IRAllocServed) -> X64DebugType Never! {
    X64DebugType{name: served.name, size: 8, kind: X64DebugTypeKind.Typedef{target: ir_x64_debug_pointer(tables, served.held)}}
}

// A pointer to a runtime handle of two words named `first` and `second`.
ir_x64_debug_handle: fn(tables: ^IRX64Tables, name: String, first: String, second: String, first_ty: Int, second_ty: Int) -> Int Never! {
    members: [X64DebugMember]{X64DebugMember{name: first, offset: 0, ty: first_ty}, X64DebugMember{name: second, offset: 8, ty: second_ty}}
    handle: ir_x64_debug_add(tables, X64DebugType{name: name, size: 16, kind: X64DebugTypeKind.Struct{members: members}})
    ir_x64_debug_pointer(tables, handle)
}

// The DWARF description of a row with variants (IRModule.debug_variants),
// None for any other row. A payload-free enum is an enumeration of its
// variant indexes. Any other is a struct whose discriminant selects its
// variant: the value's own word (an inline Option), its own box pointer (a
// boxed Option, null when absent), or, through a typedef of the box
// pointer, the box's selector word at 0 (an enum, union or Result box).
ir_x64_debug_variants: fn(m: IRModule, tables: ^IRX64Tables, shared: ^IRX64DebugRows, row: Int, ty: IRType) -> X64DebugType? Never! {
    list: m.debug_variants.get(row) ?? return None
    if list < 0 -> return None
    described: m.variant_lists[list]
    name: ir_type_name(ir_module_row_ty(m, row))
    payload_free := described.selector == .Word
    loop variant in described.variants {
        if variant.selector < 0 || variant.members.len() > 0 -> payload_free = false
    }
    if payload_free {
        enumerators: loop variant in described.variants -> X64DebugEnumerator{name: ir_short_name(variant.name), value: variant.selector}
        return Val(X64DebugType{name: name, size: ty.size, kind: X64DebugTypeKind.Enum{enumerators: enumerators}})
    }
    arms := [X64DebugVariant]{}
    box_size := 8
    loop variant in described.variants {
        member: ir_x64_debug_arm(tables, shared, described.selector, variant)
        arms.push(X64DebugVariant{value: if variant.selector < 0 -> None else -> Val(variant.selector), member: member})
        if variant.end > box_size -> box_size = variant.end
    }
    if described.selector == {
        .Box -> {
            selector: X64DebugMember{name: "tag", offset: 0, ty: shared.word}
            box: ir_x64_debug_add(tables, X64DebugType{name: name, size: box_size, kind: X64DebugTypeKind.Variants{discriminant: selector, variants: arms}})
            Val(X64DebugType{name: name, size: 8, kind: X64DebugTypeKind.Typedef{target: ir_x64_debug_pointer(tables, box)}})
        }
        .Word -> Val(X64DebugType{name: name, size: 8, kind: X64DebugTypeKind.Variants{discriminant: X64DebugMember{name: "word", offset: 0, ty: shared.word}, variants: arms}})
        .Pointer -> Val(X64DebugType{name: name, size: 8, kind: X64DebugTypeKind.Variants{discriminant: X64DebugMember{name: "box", offset: 0, ty: shared.pointer}, variants: arms}})
    }
}

// The member a value holds while `variant` is selected: its one unnamed
// payload member itself (a present Option's value, behind the box pointer
// for a Pointer selector; a union's member), else a struct named as Jet
// spells the variant whose members are its payload at their offsets.
ir_x64_debug_arm: fn(tables: ^IRX64Tables, shared: ^IRX64DebugRows, selector: IRDebugSelector, variant: IRDebugVariant) -> X64DebugMember Never! {
    if variant.name == "" && variant.members.len() == 1 {
        held: variant.members[0]
        target: if held.boxed -> shared.pointer else -> held.ty
        if selector == .Pointer {
            return X64DebugMember{name: "", offset: 0, ty: ir_x64_debug_pointer(tables, target)}
        }
        return X64DebugMember{name: "", offset: held.offset, ty: target}
    }
    members: loop held in variant.members -> X64DebugMember{name: held.name, offset: held.offset, ty: if held.boxed -> shared.pointer else -> held.ty}
    payload: ir_x64_debug_add(tables, X64DebugType{name: variant.name, size: variant.end, kind: X64DebugTypeKind.Struct{members: members}})
    X64DebugMember{name: variant.name, offset: 0, ty: payload}
}

// The tables of all of `m` at once: what ir_x64_compile_module_logged
// builds from the functions' selections, for a reader that selects no
// function first (the Web back end, ir_x64_compile_function).
ir_x64_tables: fn(m: IRModule) -> IRX64Tables Never! {
    tables := ir_x64_tables_start(m)
    loop (row, f) in m.functions {
        local: ir_x64_function_tables(m, row, [String]{})
        rows: ir_x64_tables_add(tables, f, local.uses)
        ir_x64_tables_heat(tables, rows, local.hot, local.cold)
    }
    ir_x64_tables_finish(m, tables)
    tables
}

// The module's tables before any function's uses: its IR data rows.
ir_x64_tables_start: fn(m: IRModule) -> IRX64Tables Never! {
    tables := IRX64Tables{data: [X64Data]{}, lengths: [Int]{}, headers: [Int]{}, texts: IRX64TextRows{}, ints: IRX64TextRows{}, files: [String]{}, file_rows: IRX64TextRows{}, debug_types: [X64DebugType]{}, fma: -1, simd: -1}
    loop (row, bytes) in m.data {
        // A static object (BuildStatic.jet) holds words, which the program
        // may write; a text row is read-only bytes (IR.jet ir_intern_text).
        object: m.data_relocs.get(row) != None
        align: if object -> 8 else -> 1
        tables.data.push(X64Data{id: X64DataID{value: row}, bytes: bytes, align: align, relocs: [X64DataReloc]{}, read_only: !object})
        tables.lengths.push(bytes.len())
        tables.headers.push(-1)
    }
    tables
}

ir_x64_tables_add_file: fn(tables: ^IRX64Tables, f: IRFunction) Never! {
    if f.source_file != "" && f.source_file != tables.last_file {
        tables.last_file = f.source_file
        if ir_x64_text_rows_get(tables.file_rows, tables.last_file) < 0 {
            ir_x64_text_rows_set(tables.file_rows, tables.last_file, tables.files.len())
            tables.files.push(tables.last_file)
        }
    }
}

// Gives the uses of function `f`, the next in function order, their module
// rows, adding its source file and the rows no function before it named;
// returns the row of each use, for ir_x64_resolve.
ir_x64_tables_add: fn(tables: ^IRX64Tables, f: IRFunction, uses: IRX64Uses) -> [Int] Never! {
    rows := [Int]{}
    ir_x64_tables_add_into(tables, f, uses, rows)
    rows
}

ir_x64_tables_add_into: fn(tables: ^IRX64Tables, f: IRFunction, uses: IRX64Uses, rows: ^[Int]) Never! {
    ir_x64_tables_add_file(tables, f)
    if rows.len() > 0 -> rows.clear()
    loop (at, kind) in uses.kinds {
        text: uses.texts[at]
        row: if kind == {
            .Text -> ir_x64_add_text(tables, text)
            .Header -> ir_x64_text_header(tables, uses.data[at])
            .StaticInt -> {
                ir_x64_static_int(tables, text)
                ir_x64_text_rows_get(tables.ints, text)
            }
            .Fma -> {
                if tables.fma < 0 {
                    tables.fma = tables.data.len()
                    tables.lengths.push(1)
                    tables.data.push(X64Data{id: X64DataID{value: tables.fma}, bytes: [U8]{U8{0}}, align: 1, relocs: [X64DataReloc]{}})
                }
                tables.fma
            }
            .Simd -> {
                if tables.simd < 0 {
                    tables.simd = tables.data.len()
                    tables.lengths.push(1)
                    tables.data.push(X64Data{id: X64DataID{value: tables.simd}, bytes: [U8]{U8{0}}, align: 1, relocs: [X64DataReloc]{}})
                }
                tables.simd
            }
        }
        rows.push(row)
    }
}

// The rows of `uses` in tables that hold them all already (ir_x64_tables).
ir_x64_use_rows: fn(tables: IRX64Tables, uses: IRX64Uses) -> [Int] Never! {
    rows := [Int]{}
    loop (at, kind) in uses.kinds {
        row: if kind == {
            .Text -> ir_x64_text_rows_get(tables.texts, uses.texts[at])
            .Header -> tables.headers[uses.data[at]]
            .StaticInt -> ir_x64_text_rows_get(tables.ints, uses.texts[at])
            .Fma -> tables.fma
            .Simd -> tables.simd
        }
        rows.push(row)
    }
    rows
}

// After every function's uses: a static object's address words (a data
// row's address, or the String header a ConstText of the target row
// reads) and the debug types.
ir_x64_tables_finish: fn(m: IRModule, tables: ^IRX64Tables) Never! {
    loop row in 0..<m.data.len() {
        relocs: m.data_relocs.get(row) ?? next
        loop reloc in relocs {
            target: if reloc.text -> ir_x64_text_header(tables, reloc.target) else -> reloc.target
            tables.data[row].relocs.push(X64DataReloc{offset: reloc.offset, target: X64DataID{value: target}, addend: reloc.addend})
        }
    }
    if tables.debug_types.len() == 0 -> ir_x64_debug_types(m, tables)
}

// Marks the data rows a function's code reads (IRX64FunctionTables hot and
// cold; use k as IR_X64_LOCAL_DATA + k, which `rows`, the module rows of its
// uses, resolves), the next in function order: a row only code on its way
// to a stop reads is cold (X64Data.cold), so the object writer lays it
// after what running code reads. Any order of the functions marks the same.
ir_x64_tables_heat: fn(tables: ^IRX64Tables, rows: [Int], hot: [Int], cold: [Int]) Never! {
    loop wanted in hot {
        row: if wanted >= IR_X64_LOCAL_DATA -> rows[wanted - IR_X64_LOCAL_DATA] else -> wanted
        if row < 0 || row >= tables.data.len() -> next
        loop tables.hot.len() <= row -> tables.hot.push(false)
        tables.hot[row] = true
        tables.data[row].cold = false
    }
    loop wanted in cold {
        row: if wanted >= IR_X64_LOCAL_DATA -> rows[wanted - IR_X64_LOCAL_DATA] else -> wanted
        if row < 0 || row >= tables.data.len() || (row < tables.hot.len() && tables.hot[row]) {
            next
        }
        tables.data[row].cold = true
    }
}

// Points each data relocation of `function` at use k (data row
// IR_X64_LOCAL_DATA + k) at `rows[k]`, the module's row of that use.
ir_x64_resolve: fn(function: ^X64CompiledFunction, rows: [Int]) Never! {
    loop at in 0..<function.relocs.len() {
        if function.relocs[at].kind == X64_RELOC_DATA && function.relocs[at].target >= IR_X64_LOCAL_DATA {
            function.relocs[at].target = rows[function.relocs[at].target - IR_X64_LOCAL_DATA]
        }
    }
}

// Same as ir_x64_resolve, visiting only the local-data relocation indices
// precomputed on the selecting worker thread.
ir_x64_resolve_at: fn(function: ^X64CompiledFunction, rows: [Int], local_relocs: [Int]) Never! {
    loop at in local_relocs {
        if function.relocs[at].kind == X64_RELOC_DATA && function.relocs[at].target >= IR_X64_LOCAL_DATA {
            function.relocs[at].target = rows[function.relocs[at].target - IR_X64_LOCAL_DATA]
        }
    }
}

// The selector rows function row `row` of `m` names, in the order its
// instructions name them: its source file's text, then per instruction the
// texts of its numeric stops (ir_x64_add_stop_texts), a ConstText's String
// header, a ConstBigInt's decimal and static Int, the FMA byte of a
// jet_std_math_fma call. Its selection keeps an emission log when
// JET_X64_EMIT_LOG entry list `names` names it (ir_x64_log_names). The
// data rows its DataAddress and ConstText instructions read go in `hot`, or
// in `cold` when the instruction is on its way to a stop (ir_x64_dying).
ir_x64_function_tables: fn(m: IRModule, row: Int, names: [String]) -> IRX64FunctionTables Never! {
    ir_x64_function_tables_in(m, m.functions[row], names)
}

ir_x64_function_tables_in: fn(m: IRModule, f: IRFunction, names: [String]) -> IRX64FunctionTables Never! {
    tables := IRX64FunctionTables{uses: IRX64Uses{}, lengths: [Int]{}, texts: IRX64TextRows{}, headers: [Int:Int]{}, ints: IRX64TextRows{}, fma: -1, simd: -1, logged: ir_x64_log_names(f, names)}
    _ := ir_x64_use_text(tables, f.source_file)
    if f.asm != None && ir_x64_simd_leaf_kind(f.key) >= 0 {
        tables.simd = ir_x64_add_use(tables, IRX64UseKind.Simd, -1, "", 1)
    }
    // The stop texts already in (ir_x64_add_stop_texts).
    stops := [Bool]{false, false, false, false}
    // The DataAddress and ConstText instructions, with the row each reads.
    reads := [Int]{}
    read_rows := [Int]{}
    data_len: m.data.len()
    names_len: m.names.len()
    loop at in 0..<f.op.len() {
        op: f.op[at]
        if op == {
            .Add | .Sub | .Neg | .Mul | .Div | .Rem | .FloorDiv | .Mod -> {
                ir_x64_add_stop_texts(tables, stops, m, f, at)
            }
            .DataAddress -> {
                data: f.a[at]
                if data >= 0 && data < data_len {
                    reads.push(at)
                    read_rows.push(data)
                }
            }
            .ConstText -> {
                data: f.a[at]
                if data >= 0 && data < data_len {
                    if tables.headers.get(data) == None {
                        tables.headers[data] = ir_x64_add_use(tables, IRX64UseKind.Header, data, "", 24)
                    }
                    reads.push(at)
                    read_rows.push(tables.headers[data])
                }
            }
            .ConstBigInt -> {
                name_row: f.a[at]
                if name_row >= 0 && name_row < names_len {
                    text: m.names[name_row]
                    _ := ir_x64_use_text(tables, text)
                    if ir_x64_text_rows_get(tables.ints, text) < 0 && ir_x64_static_int_fits(text) {
                        word: ir_x64_add_use(tables, IRX64UseKind.StaticInt, -1, text.copy(), 8)
                        ir_x64_text_rows_set(tables.ints, text, word)
                    }
                }
            }
            .CallRuntime -> {
                if tables.fma < 0 {
                    name_row: f.a[at]
                    if name_row >= 0 && name_row < names_len && m.names[name_row] == "jet_std_math_fma" {
                        tables.fma = ir_x64_add_use(tables, IRX64UseKind.Fma, -1, "", 1)
                    }
                }
            }
            .Nop | .Const | .Copy | .Move | .Drop | .Close | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Le | .Gt | .Ge | .Not | .Convert | .Concat | .Call | .CallIndirect | .FunctionAddress | .Load | .Store | .StackAddress | .Offset | .CopyBytes | .Block | .Loop | .If | .Else | .End | .Br | .BrIf | .Return | .Unreachable | .Sqrt | .IntBig | .StreamStore -> {}
        }
    }
    if reads.len() > 0 {
        dying: ir_x64_dying(f)
        loop (index, at) in reads {
            if dying[at] -> tables.cold.push(read_rows[index]) else {
                tables.hot.push(read_rows[index])
            }
        }
    }
    tables
}

// Per instruction of `f`, whether every way on from it ends at an
// Unreachable: the arm of a stop that builds its report and calls the
// runtime function that ends the program. Read backward: an Unreachable
// starts such a run and a Br, BrIf or Return ends it (control may leave);
// an arm's last instruction goes on to what follows its End (a Loop's
// too: its End falls through), an If's start is such when both its arms'
// starts are (an If without Else: its then arm's and what follows its End),
// and a Block's or Loop's when its body's start is.
ir_x64_dying: fn(f: IRFunction) -> [Bool] Never! {
    count: f.op.len()
    dying := [Bool]{}
    loop _ in 0..<count -> dying.push(false)
    // Per construct open in the backward walk: whether what follows its
    // End dies, and whether its else arm's start dies (what follows the End
    // until an Else is met).
    after := [Bool]{}
    other := [Bool]{}
    dies := false
    at := count - 1
    loop at >= 0 {
        op: f.op[at]
        if op == .Unreachable -> dies = true else if op == .Br || op == .BrIf || op == .Return {
            dies = false
        } else if op == .End {
            after.push(dies)
            other.push(dies)
        } else if op == .Else {
            if other.len() > 0 {
                other[other.len() - 1] = dies
                dies = after[after.len() - 1]
            }
        } else if op == .If {
            else_dies: other.pop() ?? false
            _ := after.pop()
            dies = dies && else_dies
        } else if op == .Block || op == .Loop {
            _ := other.pop()
            _ := after.pop()
        }
        dying[at] = dies
        at -= 1
    }
    dying
}

#Test("The instructions on the way to an Unreachable are the dying ones") {
    f := ir_function_new("f", "f", "", "f.jet", 1)
    _ := ir_emit(f, IROp.DataAddress, -1, 0, -1, -1, 1)
    // A stop's then arm and an else arm that goes on.
    _ := ir_open_if(f, -1, 1)
    _ := ir_emit(f, IROp.DataAddress, -1, 0, -1, -1, 1)
    _ := ir_emit(f, IROp.Unreachable, -1, -1, -1, -1, 1)
    ir_else(f, 1)
    _ := ir_emit(f, IROp.DataAddress, -1, 0, -1, -1, 1)
    ir_end(f, 1)
    // A Block a BrIf leaves, ahead of the Unreachable after it.
    _ := ir_open(f, IROp.Block, 1)
    _ := ir_open_if(f, -1, 1)
    _ := ir_emit(f, IROp.DataAddress, -1, 0, -1, -1, 1)
    _ := ir_emit(f, IROp.Unreachable, -1, -1, -1, -1, 1)
    ir_end(f, 1)
    _ := ir_emit(f, IROp.BrIf, -1, -1, 0, -1, 1)
    _ := ir_emit(f, IROp.DataAddress, -1, 0, -1, -1, 1)
    ir_end(f, 1)
    _ := ir_emit(f, IROp.Unreachable, -1, -1, -1, -1, 1)
    assert_eq(ir_x64_dying(f), [Bool]{false, false, true, true, false, false, false, false, false, true, true, false, false, true, true, true})
}

// Adds a use of kind `kind` (naming IR data row `data` or text `text`, as
// IRX64Uses keeps them), of `length` bytes; returns its local data row.
ir_x64_add_use: fn(tables: ^IRX64FunctionTables, kind: ^^IRX64UseKind, data: Int, text: ^^String, length: Int) -> Int Never! {
    id: IR_X64_LOCAL_DATA + tables.uses.kinds.len()
    tables.uses.kinds.push(kind)
    tables.uses.data.push(data)
    tables.uses.texts.push(text)
    tables.lengths.push(length)
    id
}

// The local data row of selector text `text`, added on first use.
ir_x64_use_text: fn(tables: ^IRX64FunctionTables, text: String) -> Int Never! {
    found: ir_x64_text_rows_get(tables.texts, text)
    if found >= 0 -> return found
    id: ir_x64_add_use(tables, IRX64UseKind.Text, -1, text.copy(), text.bytes().len())
    ir_x64_text_rows_set(tables.texts, text, id)
    id
}

// The byte length of local data row `id`.
ir_x64_use_length: fn(tables: IRX64FunctionTables, id: Int) -> Int Never! {
    tables.lengths[id - IR_X64_LOCAL_DATA]
}

// The process-lifetime String header [data, byte length, cap 0] over data
// row `row`'s bytes, which the runtime recognizes as immortal: clone returns
// it and drop ignores it. One per row.
ir_x64_text_header: fn(tables: ^IRX64Tables, row: Int) -> Int Never! {
    if tables.headers[row] >= 0 -> return tables.headers[row]
    header: tables.data.len()
    bytes := [U8]{}
    loop _ in 0..<24 -> bytes.push(U8{0})
    length := tables.lengths[row]
    loop index in 0..<8 {
        bytes[8 + index] = U8{length & 255}
        length = length >> 8
    }
    tables.data.push(X64Data{id: X64DataID{value: header}, bytes: bytes, align: 8, relocs: [X64DataReloc]{X64DataReloc{offset: 0, target: X64DataID{value: row}, addend: 0}}})
    tables.lengths.push(24)
    tables.headers[row] = header
    header
}

// x64 selection admission. A pass over a module's functions on k threads
// takes about total * ns / k of wall, where `total` is the module's IR
// instructions and `ns` the pass's cost per instruction on one thread, plus
// IR_X64_THREAD_NS per thread. Going from k - 1 threads to k saves
// total * ns / (k * (k - 1)), so a pass admits the most threads whose last
// one saves more than it costs (ir_x64_admit): a module of a few thousand
// instructions selects on a few threads, a small one on the calling thread.
//
// Measured by timing whole selections at forced thread counts on a
// 16-CPU host already running other work: selection costs 700 to 850 ns per
// instruction on one thread (modules of 2,000 to 87,000 instructions), and a
// selecting thread about 0.4 ms of wall in the median (its start and join
// are a few microseconds; the rest is its cold caches and its share of busy
// cores), less on an idle host.
IR_X64_THREAD_NS: 400000

// Selection's cost per IR instruction on one thread.
IR_X64_SELECT_NS_PER_INSTRUCTION: 800

// The threads `threads` admits for a pass over `count` functions holding
// `total` IR instructions that costs `ns_per_instruction` each on one
// thread: the most k with total * ns_per_instruction >= k * (k - 1) *
// IR_X64_THREAD_NS.
ir_x64_admit: fn(threads: CompilerThreads, count: Int, total: Int, ns_per_instruction: Int) -> Int Never! {
    workers := compiler_threads_admit(threads, count, total, 1, 0, 0)
    work: total * ns_per_instruction
    loop workers > 1 && workers * (workers - 1) * IR_X64_THREAD_NS > work -> workers -= 1
    workers
}

// Compiles every function of `program` (function row = X64CompiledFunction
// id), collecting every function's selection errors, on as many threads as
// x64 selection admission (ir_x64_admit) gives its instructions. Threads
// claim functions heaviest first, each selecting against its own selector
// rows (ir_x64_select_function), and each result lands in its function's
// row; the module's tables then give the uses their rows in function order
// (ir_x64_tables_add), so the rows, errors, tables and bytes are those of
// the one-thread loop for any thread count. A thread that stops (an
// internal panic) costs only the function it was selecting: that function
// gets an error row and fresh threads select the rest.
ir_x64_compile_module: fn(program: ^^IRModule, threads: CompilerThreads) -> IRX64Result Never! {
    ir_x64_compile_module_logged(program, threads, [String]{})
}

// The same, keeping the emission log (X64Code) of each function `names`
// names (ir_x64_log_names) in IRX64Result.log, after the members of the
// module's structs (IRModule.struct_fields), so a reader of the log names
// the member an `offset` or `load` reaches.
ir_x64_compile_module_logged: fn(program: ^^IRModule, threads: CompilerThreads, names: [String], trace_sink: CompilerTraceSink?{None}) -> IRX64Result Never! {
    m := program.move()
    // A fast O0 module moves its Drops per body (Opt.jet ir_opt_o0_bodies,
    // or ir_x64_select_function_in's drop plan); its tail calls are jumps
    // as on every level, so the tail-call pass runs for it
    // too and the stencil emitter jumps (X64Patch.jet patch_tail_jump).
    if !m.fast_o0 {
        if trace_sink == .Val(sink) -> sink.begin("ir.x64.drop_early", "", -1, -1)
        ir_drop_early(m, threads)
        if trace_sink == .Val(sink) -> sink.end("ir.x64.drop_early", m.functions.len())
    }
    if trace_sink == .Val(sink) -> sink.begin("ir.x64.tail_calls", "", -1, -1)
    ir_tail_calls(m, threads)
    if trace_sink == .Val(sink) -> sink.end("ir.x64.tail_calls", m.functions.len())
    log := [String]{}
    if names.len() > 0 {
        if m.struct_fields.len() > 0 {
            loop line in m.struct_fields -> log.push(line.copy())
        } else {
            loop row in 0..<m.types.len() {
                list: m.debug_members.get(row) ?? next
                identity: ir_module_row_identity(m, row)
                loop member in m.member_lists[list] {
                    size: if member.boxed || member.ty < 0 -> 8 else -> m.types[member.ty].size
                    ty: if {
                        member.boxed -> "box"
                        member.ty < 0 -> "-"
                        else -> ir_module_row_identity(m, member.ty)
                    }
                    log.push("field {identity} {member.offset} {size} {member.name} {ty}")
                }
            }
        }
    }
    count: m.functions.len()
    poll: ir_keyed_function(m, IR_STOP_POLL_KEY) ?? -1
    trap: ir_keyed_function(m, IR_STOP_TRAP_KEY) ?? -1
    turn: ir_keyed_function(m, IR_STOP_TURN_KEY) ?? -1
    zone_plot: ir_interned_name(m, "jet_perf_plot_float") ?? -1
    zone_frame: ir_interned_name(m, "jet_perf_frame") ?? -1
    if trace_sink == .Val(sink) -> sink.begin("ir.x64.select", "", -1, -1)
    weights := [Int]{}
    weights.try_reserve(count) ?? ()
    total := 0
    loop f in m.functions {
        weight: 1 + f.op.len()
        weights.push(weight)
        total += weight
    }
    workers: ir_x64_admit(threads, count, total, IR_X64_SELECT_NS_PER_INSTRUCTION)
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    variables := [[X64DebugVariable]]{}
    errors := [String]{}
    if workers <= 1 {
        fast := if m.fast_o0 -> ir_x64_fast_module_new(m, true) else -> ir_x64_fast_module_empty()
        tables := ir_x64_tables_start(m)
        patch := ir_patch_emitter_new()
        rows := [Int]{}
        loop row in 0..<count {
            compiled := ir_x64_select_function_in(m, fast, row, names, poll, trap, turn, zone_plot, zone_frame, patch)
            if compiled.uses.kinds.len() > 0 {
                ir_x64_tables_add_into(tables, m.functions[row], compiled.uses, rows)
                if compiled.local_relocs.len() > 0 {
                    ir_x64_resolve_at(compiled.function, rows, compiled.local_relocs)
                }
                if compiled.hot.len() > 0 || compiled.cold.len() > 0 {
                    ir_x64_tables_heat(tables, rows, compiled.hot, compiled.cold)
                }
            } else {
                ir_x64_tables_add_file(tables, m.functions[row])
                if compiled.hot.len() > 0 || compiled.cold.len() > 0 {
                    ir_x64_tables_heat(tables, [Int]{}, compiled.hot, compiled.cold)
                }
            }
            if compiled.errors.len() > 0 {
                errors.extend(compiler_take_rows<String>(compiled.errors))
            }
            if compiled.log.len() > 0 -> log.extend(compiler_take_rows<String>(compiled.log))
            functions.push(compiled.function.move())
            debug.push(compiled.debug.move())
            variables.push(compiled.variables.move())
        }
        if fast.use_indexed_rt -> tables.runtime_symbols = fast.runtime_symbols.move()
        if trace_sink == .Val(sink) -> sink.end("ir.x64.select", count)
        if trace_sink == .Val(sink) -> sink.begin("ir.x64.tables_finish", "", -1, -1)
        ir_x64_tables_finish(m, tables)
        if trace_sink == .Val(sink) -> sink.end("ir.x64.tables_finish", m.types.len())
        return IRX64Result{program: m.move(), functions: functions.move(), debug: debug.move(), variables: variables.move(), errors: errors.move(), tables: tables.move(), threads: threads, log: log.move()}
    }
    seats := [IRX64Seat]{}
    loop _ in 0..<workers -> seats.push(IRX64Seat{row: -1})
    order: if m.fast_o0 -> ir_x64_fast_order(weights) else -> compiler_threads_heaviest_first(weights)
    fast := if m.fast_o0 -> ir_x64_fast_module_new(m, true) else -> ir_x64_fast_module_empty()
    inputs: Shared{IRX64Inputs{programs: [IRModule]{m.move()}, fast: fast.move(), names: names, order: order, next: 0, seats: seats.move(), poll: poll, trap: trap, turn: turn, zone_plot: zone_plot, zone_frame: zone_frame}}
    outputs := [IRX64FunctionResult?]{}
    stops := [String]{}
    outputs.try_reserve(count) ?? ()
    loop _ in 0..<count -> outputs.push(None)
    tables_box := [IRX64Tables]{}
    task.group ir_x64_select_and_tables {
        starting: task {
            reads: inputs.guard_read()
            t := ir_x64_tables_start(reads.value.programs[0])
            ir_x64_debug_types(reads.value.programs[0], t)
            t.move()
        }
        ir_x64_select_rows(inputs, workers, outputs, stops)
        tables_box.push(compiler_threads_joined(starting))
    }
    if trace_sink == .Val(sink) -> sink.end("ir.x64.select", count)
    if trace_sink == .Val(sink) -> sink.begin("ir.x64.scatter", "", -1, -1)
    shells := ir_x64_take_inputs(inputs)
    program_back := shells.programs.pop() ?? panic("the x64 selection inputs lost the module")
    tables := compiler_threads_taken(tables_box)
    if shells.fast.use_indexed_rt -> tables.runtime_symbols = shells.fast.runtime_symbols.move()
    has_stops: stops.len() == count
    functions.try_reserve(count) ?? ()
    debug.try_reserve(count) ?? ()
    variables.try_reserve(count) ?? ()
    // Reverse once so popping yields rows 0..<count in forward order, avoiding
    // temporary 60k-row staging arrays and extra reversals.
    outputs.reverse()
    if has_stops -> stops.reverse()
    rows := [Int]{}
    loop row in 0..<count {
        taken := outputs.pop() ?? break
        stop: if has_stops -> (stops.pop() ?? "") else -> ""
        if taken.move() == .Val(compiled) {
            selected := compiled.move()
            if selected.errors.len() > 0 -> errors.extend(selected.errors.move())
            if selected.log.len() > 0 -> log.extend(selected.log.move())
            fn_out := selected.function.move()
            if selected.uses.kinds.len() > 0 {
                ir_x64_tables_add_into(tables, program_back.functions[row], selected.uses, rows)
                if selected.local_relocs.len() > 0 {
                    ir_x64_resolve_at(fn_out, rows, selected.local_relocs)
                }
                if selected.hot.len() > 0 || selected.cold.len() > 0 {
                    ir_x64_tables_heat(tables, rows, selected.hot, selected.cold)
                }
            } else {
                ir_x64_tables_add_file(tables, program_back.functions[row])
                if selected.hot.len() > 0 || selected.cold.len() > 0 {
                    ir_x64_tables_heat(tables, [Int]{}, selected.hot, selected.cold)
                }
            }
            functions.push(fn_out.move())
            debug.push(selected.debug.move())
            variables.push(selected.variables.move())
        } else {
            errors.push("{program_back.functions[row].name}: selection stopped: {stop}")
            ir_x64_tables_add_into(tables, program_back.functions[row], IRX64Uses{}, rows)
            ir_x64_tables_heat(tables, rows, [Int]{}, [Int]{})
            functions.push(X64CompiledFunction{id: X64FunctionID{value: row}, name: program_back.functions[row].name, code: [U8]{}, relocs: [X64Reloc]{}, align: X64_FUNCTION_ALIGN})
            debug.push(X64FunctionDebug{lines: [X64LineRow]{}, body: 0, cfi: [U8]{}, ranges: [X64VariableRange]{}})
            variables.push([X64DebugVariable]{})
        }
    }
    if trace_sink == .Val(sink) -> sink.end("ir.x64.scatter", count)
    if trace_sink == .Val(sink) -> sink.begin("ir.x64.tables_finish", "", -1, -1)
    ir_x64_tables_finish(program_back, tables)
    if trace_sink == .Val(sink) -> sink.end("ir.x64.tables_finish", program_back.types.len())
    IRX64Result{program: program_back.move(), functions: functions.move(), debug: debug.move(), variables: variables.move(), errors: errors.move(), tables: tables.move(), threads: threads, log: log.move()}
}

// O(N) 3-bucket claim order for fast_o0: heavy functions (>= 512 ops, sorted
// heaviest first so no mega-function trails the parallel wave), followed by
// medium (>= 64), then tiny functions (claimed in chunks of 16).
ir_x64_fast_order: fn(weights: [Int]) -> [Int] Never! {
    count: weights.len()
    heavy := [Int]{}
    med := [Int]{}
    small := [Int]{}
    small.try_reserve(count) ?? ()
    loop row in 0..<count {
        w: weights[row]
        if w >= 512 -> heavy.push(row) else if w >= 64 -> med.push(row) else -> small.push(row)
    }
    if heavy.len() > 1 {
        heavy.sort_by(fn(left: Int, right: Int) { weights[right] <=> weights[left] })
    }
    order := [Int]{}
    order.try_reserve(count) ?? ()
    loop row in heavy -> order.push(row)
    loop row in med -> order.push(row)
    loop row in small -> order.push(row)
    order
}

// Precomputed O0 module-wide read-only tables (built once per module in
// O(types + names + functions) and shared across worker threads with zero
// per-instruction string compares or hash lookups).
O0_CLS_EMPTY: U8{0}

O0_CLS_GENERAL: U8{1}

O0_CLS_FLOAT: U8{2}

O0_KIND_UNIT: U8{0}

O0_KIND_BOOL: U8{1}

O0_KIND_INT: U8{2}

O0_KIND_WORD: U8{3}

O0_KIND_FLOAT: U8{4}

O0_KIND_FLOAT32: U8{5}

O0_KIND_CHAR: U8{6}

O0_KIND_STRING: U8{7}

O0_KIND_POINTER: U8{8}

O0_KIND_AGGREGATE: U8{9}

O0_RTTAG_PLAIN: U8{0}

O0_RTTAG_BLOCK_UNIQUE: U8{1}

O0_RTTAG_BLOCK_RETAIN: U8{2}

O0_RTTAG_BLOCK_RELEASE: U8{3}

O0_RTTAG_INT_TO_I64: U8{4}

O0_RTTAG_INT_CLONE: U8{5}

O0_RTTAG_INT_FROM_I64: U8{6}

O0_RTTAG_MATH_TO_BITS: U8{7}

O0_RTTAG_MATH_FROM_BITS: U8{8}

O0_RTTAG_INT_CHECKED_FIXED: U8{9}

O0_RTTAG_INT_NATIVE_I64: U8{10}

O0_RTTAG_INT_CHECKED_WIDEN: U8{11}

O0_RTTAG_ZONE_OPEN: U8{12}

O0_RTTAG_ZONE_CLOSE: U8{13}

O0_RTTAG_ZONE_FRAME: U8{14}

O0_RTTAG_ZONE_PLOT: U8{15}

O0_RTTAG_ALLOC: U8{16}

O0_RTTAG_ALLOC_VALUE: U8{17}

O0_RTTAG_FREE: U8{18}

O0_RTTAG_ATOMIC_INIT: U8{19}

O0_RTTAG_ATOMIC_LOAD: U8{20}

O0_RTTAG_ATOMIC_STORE: U8{21}

O0_RTTAG_ATOMIC_ADD: U8{22}

O0_RTTAG_ATOMIC_CAS: U8{23}

O0_RTTAG_CLEANUP_ENTER: U8{24}

O0_RTTAG_CLEANUP_LEAVE: U8{25}

O0_RT_INT_ADD: 0

O0_RT_INT_SUB: 1

O0_RT_INT_MUL: 2

O0_RT_INT_DIV: 3

O0_RT_INT_REM: 4

O0_RT_INT_FLOORDIV: 5

O0_RT_INT_MOD: 6

O0_RT_INT_SHL: 7

O0_RT_INT_SHR: 8

O0_RT_INT_BIT_AND: 9

O0_RT_INT_BIT_OR: 10

O0_RT_INT_BIT_XOR: 11

O0_RT_INT_COMPARE: 12

O0_RT_INT_CLONE: 13

O0_RT_INT_DROP: 14

O0_RT_INT_FROM_STATIC: 15

O0_RT_INT_OWNED_FROM_I64: 16

O0_RT_STRING_CLONE: 17

O0_RT_STRING_EQ: 18

O0_RT_STRING_COMPARE: 19

O0_RT_STRING_CONCAT: 20

O0_RT_STRING_CONCAT_VALUE: 21

O0_RT_BLOCK_RELEASE: 22

O0_RT_PANIC_OVERFLOW: 23

O0_RT_NUMERIC_STOP: 24

O0_RT_FIXED_SHIFT_STOP: 25

O0_RT_SESSION_PROPAGATE: 26

O0_RT_CLEANUP_ENTER: 27

O0_RT_CLEANUP_LEAVE: 28

O0_RT_STACK_GROW: 29

O0_RT_STACK_SHRINK: 30

O0_RT_ALLOC_8: 31

O0_RT_ALLOC_VALUE_8: 32

O0_RT_FREE_8: 33

O0_RT_FMOD: 34

O0_RT_FMODF: 35

O0_RT_FLOOR: 36

O0_RT_FLOORF: 37

O0_RT_CHECKS_ARMED: 38

O0_RT_PROCESS_ENDING: 39

O0_RT_PERF_ZONES: 40

O0_RT_STRING_DROP: 41

O0_RT_COMPTIME_STEPS: 42

IRX64FastModule: struct {
    type_class: [U8],
    type_kind: [U8],
    type_size: [Int],
    type_align: [Int],
    type_bits: [Int],
    type_signed: [Bool],
    type_is_str_drop: [Bool],
    type_has_drop: [Bool],
    type_drop_is_int: [Bool],
    type_drop_is_str_rt: [Bool],
    type_copy_clones: [Bool],
    type_clone_is_int: [Bool],
    type_drop_fn: [Int],
    type_drop_rt_id: [Int],
    type_is_alloc_row: [Bool],
    name_rt_tag: [U8],
    name_rt_sym_id: [Int],
    name_is_alloc: [Bool],
    fn_is_unique: [Bool],
    fn_has_asm: [Bool],
    fn_is_stop: [Bool],
    data_core_cell_rt_id: [Int],
    runtime_symbols: [String],
    use_indexed_rt: Bool{false},
}

ir_x64_fast_module_empty: fn() -> IRX64FastModule Never! {
    IRX64FastModule{
        type_class: [U8]{},
        type_kind: [U8]{},
        type_size: [Int]{},
        type_align: [Int]{},
        type_bits: [Int]{},
        type_signed: [Bool]{},
        type_is_str_drop: [Bool]{},
        type_has_drop: [Bool]{},
        type_drop_is_int: [Bool]{},
        type_drop_is_str_rt: [Bool]{},
        type_copy_clones: [Bool]{},
        type_clone_is_int: [Bool]{},
        type_drop_fn: [Int]{},
        type_drop_rt_id: [Int]{},
        type_is_alloc_row: [Bool]{},
        name_rt_tag: [U8]{},
        name_rt_sym_id: [Int]{},
        name_is_alloc: [Bool]{},
        fn_is_unique: [Bool]{},
        fn_has_asm: [Bool]{},
        fn_is_stop: [Bool]{},
        data_core_cell_rt_id: [Int]{},
        runtime_symbols: [String]{},
        use_indexed_rt: false,
    }
}

ir_x64_fast_intern_rt: fn(table: ^IRX64TextRows, symbols: ^[String], name: String) -> Int Never! {
    existing: ir_x64_text_rows_get(table, name)
    if existing >= 0 -> return existing
    id: symbols.len()
    symbols.push("{name}")
    ir_x64_text_rows_set(table, symbols[id], id)
    id
}

ir_x64_fast_module_new: fn(m: IRModule, use_indexed_rt: Bool) -> IRX64FastModule Never! {
    rt_table := IRX64TextRows{}
    rt_syms := [String]{}
    rt_syms.try_reserve(128) ?? ()
    // Fixed slots 0..41 matching O0_RT_* compile-time constants.
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_add")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_sub")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_mul")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_div")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_rem")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_floor_div")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_mod")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_shl")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_shr")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_bit_and")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_bit_or")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_bit_xor")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_compare")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_int_clone")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_int_drop")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_int_from_static")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_int_owned_from_i64")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_string_clone")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_string_eq")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_string_compare")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_string_concat")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_string_concat_value")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_block_release")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_panic_overflow")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_numeric_stop")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_fixed_shift_stop")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_session_propagate")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_cleanup_enter")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_cleanup_leave")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_stack_grow")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_stack_shrink")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_alloc_8")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_alloc_value_8")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_free_8")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "fmod")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "fmodf")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "floor")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "floorf")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, IR_X64_CHECKS_ARMED_SYMBOL)
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, IR_X64_PROCESS_ENDING_SYMBOL)
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, IR_X64_PERF_ZONES_SYMBOL)
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, "jet_rt_string_drop")
    _ := ir_x64_fast_intern_rt(rt_table, rt_syms, IR_X64_COMPTIME_STEPS_SYMBOL)

    tcount: m.types.len()
    type_class := [U8]{}
    type_kind := [U8]{}
    type_size := [Int]{}
    type_align := [Int]{}
    type_bits := [Int]{}
    type_signed := [Bool]{}
    type_is_str_drop := [Bool]{}
    type_has_drop := [Bool]{}
    type_drop_is_int := [Bool]{}
    type_drop_is_str_rt := [Bool]{}
    type_copy_clones := [Bool]{}
    type_clone_is_int := [Bool]{}
    type_drop_fn := [Int]{}
    type_drop_rt_id := [Int]{}
    type_is_alloc_row := [Bool]{}
    type_class.try_reserve(tcount) ?? ()
    type_kind.try_reserve(tcount) ?? ()
    type_size.try_reserve(tcount) ?? ()
    type_align.try_reserve(tcount) ?? ()
    type_bits.try_reserve(tcount) ?? ()
    type_signed.try_reserve(tcount) ?? ()
    type_is_str_drop.try_reserve(tcount) ?? ()
    type_has_drop.try_reserve(tcount) ?? ()
    type_drop_is_int.try_reserve(tcount) ?? ()
    type_drop_is_str_rt.try_reserve(tcount) ?? ()
    type_copy_clones.try_reserve(tcount) ?? ()
    type_clone_is_int.try_reserve(tcount) ?? ()
    type_drop_fn.try_reserve(tcount) ?? ()
    type_drop_rt_id.try_reserve(tcount) ?? ()
    type_is_alloc_row.try_reserve(tcount) ?? ()
    loop (row, ty) in m.types {
        k: if ty.kind == {
            .Unit -> O0_KIND_UNIT
            .Bool -> O0_KIND_BOOL
            .Int -> O0_KIND_INT
            .Word -> O0_KIND_WORD
            .Float -> O0_KIND_FLOAT
            .Float32 -> O0_KIND_FLOAT32
            .Char -> O0_KIND_CHAR
            .String -> O0_KIND_STRING
            .Pointer -> O0_KIND_POINTER
            .Aggregate -> O0_KIND_AGGREGATE
        }
        cls: if k == O0_KIND_UNIT -> O0_CLS_EMPTY else if k == O0_KIND_FLOAT || k == O0_KIND_FLOAT32 -> O0_CLS_FLOAT else -> O0_CLS_GENERAL
        type_class.push(cls)
        type_kind.push(k)
        type_size.push(ty.size)
        type_align.push(ty.align)
        type_bits.push(if ty.bits > 0 -> ty.bits else -> 64)
        type_signed.push(ty.signed)
        has_d: ty.drop != ""
        type_has_drop.push(has_d)
        type_is_str_drop.push(k == O0_KIND_STRING && has_d)
        type_drop_is_int.push(k == O0_KIND_INT || ty.drop == "jet_rt_int_drop")
        type_drop_is_str_rt.push(k == O0_KIND_STRING && ty.drop == "jet_rt_string_drop")
        type_copy_clones.push(has_d && k != O0_KIND_AGGREGATE && !ir_clone_shares(ty.clone))
        type_clone_is_int.push(k == O0_KIND_INT || ty.clone == "jet_rt_int_clone")
        if has_d {
            if ir_keyed_function(m, ty.drop) == .Val(fid) {
                type_drop_fn.push(fid)
                type_drop_rt_id.push(-1)
            } else {
                type_drop_fn.push(-1)
                type_drop_rt_id.push(ir_x64_fast_intern_rt(rt_table, rt_syms, ty.drop))
            }
        } else {
            type_drop_fn.push(-1)
            type_drop_rt_id.push(-1)
        }
        is_alloc := false
        if m.alloc_types {
            if ir_box_row(m, row) -> is_alloc = true else if ir_module_row_ty(m, row) == .Apply(aname, _) {
                if aname == IR_ALLOC_TYPE -> is_alloc = true
            }
        }
        type_is_alloc_row.push(is_alloc)
    }

    ncount: m.names.len()
    name_rt_tag := [U8]{}
    name_rt_sym_id := [Int]{}
    name_is_alloc := [Bool]{}
    name_rt_tag.try_reserve(ncount) ?? ()
    name_rt_sym_id.try_reserve(ncount) ?? ()
    name_is_alloc.try_reserve(ncount) ?? ()
    loop name in m.names {
        tag: if name == {
            "jet_rt_block_unique" -> O0_RTTAG_BLOCK_UNIQUE
            "jet_rt_block_retain" -> O0_RTTAG_BLOCK_RETAIN
            "jet_rt_block_release" -> O0_RTTAG_BLOCK_RELEASE
            "jet_int_owned_to_i64" -> O0_RTTAG_INT_TO_I64
            "jet_rt_int_clone" -> O0_RTTAG_INT_CLONE
            "jet_int_owned_from_i64" -> O0_RTTAG_INT_FROM_I64
            "jet_std_math_to_bits" -> O0_RTTAG_MATH_TO_BITS
            "jet_std_math_from_bits" -> O0_RTTAG_MATH_FROM_BITS
            "jet_int_checked_fixed" -> O0_RTTAG_INT_CHECKED_FIXED
            "jet_int_native_i64_at" -> O0_RTTAG_INT_NATIVE_I64
            "jet_int_checked_widen" -> O0_RTTAG_INT_CHECKED_WIDEN
            "jet_perf_zone_open_named" -> O0_RTTAG_ZONE_OPEN
            "jet_perf_zone_close" -> O0_RTTAG_ZONE_CLOSE
            "jet_perf_frame" -> O0_RTTAG_ZONE_FRAME
            "jet_perf_plot_float" -> O0_RTTAG_ZONE_PLOT
            "jet_rt_alloc" -> O0_RTTAG_ALLOC
            "jet_rt_alloc_value" -> O0_RTTAG_ALLOC_VALUE
            "jet_rt_free" -> O0_RTTAG_FREE
            "jet_rt_atomic_i64_init" | "jet_rt_atomic_u64_init" -> O0_RTTAG_ATOMIC_INIT
            "jet_rt_atomic_i64_load" | "jet_rt_atomic_u64_load" -> O0_RTTAG_ATOMIC_LOAD
            "jet_rt_atomic_i64_store" | "jet_rt_atomic_u64_store" -> O0_RTTAG_ATOMIC_STORE
            "jet_rt_atomic_i64_add" | "jet_rt_atomic_u64_add" -> O0_RTTAG_ATOMIC_ADD
            "jet_rt_atomic_i64_compare_exchange" | "jet_rt_atomic_u64_compare_exchange" -> O0_RTTAG_ATOMIC_CAS
            "jet_rt_cleanup_enter" -> O0_RTTAG_CLEANUP_ENTER
            "jet_rt_cleanup_leave" -> O0_RTTAG_CLEANUP_LEAVE
            else -> O0_RTTAG_PLAIN
        }
        name_rt_tag.push(tag)
        is_alloc: m.alloc_types && name.starts_with("jet_rt_alloc")
        name_is_alloc.push(is_alloc)
        if tag != O0_RTTAG_PLAIN || is_alloc || name.starts_with("jet_") {
            name_rt_sym_id.push(ir_x64_fast_intern_rt(rt_table, rt_syms, name))
        } else {
            name_rt_sym_id.push(-1)
        }
    }

    fcount: m.functions.len()
    fn_is_unique := [Bool]{}
    fn_has_asm := [Bool]{}
    fn_is_stop := [Bool]{}
    fn_is_unique.try_reserve(fcount) ?? ()
    fn_has_asm.try_reserve(fcount) ?? ()
    fn_is_stop.try_reserve(fcount) ?? ()
    loop f in m.functions {
        fn_is_unique.push(f.key.starts_with("#unique<"))
        fn_has_asm.push(f.asm != None)
        fn_is_stop.push(ir_stop_key(f.key))
    }

    dcount: m.data.len()
    data_core_cell_rt_id := [Int]{}
    data_core_cell_rt_id.try_reserve(dcount) ?? ()
    loop _ in 0..<dcount -> data_core_cell_rt_id.push(-1)
    loop (drow, symbol) in m.core_cells {
        if drow >= 0 && drow < dcount {
            data_core_cell_rt_id[drow] = ir_x64_fast_intern_rt(rt_table, rt_syms, symbol)
        }
    }

    IRX64FastModule{
        type_class: type_class.move(),
        type_kind: type_kind.move(),
        type_size: type_size.move(),
        type_align: type_align.move(),
        type_bits: type_bits.move(),
        type_signed: type_signed.move(),
        type_is_str_drop: type_is_str_drop.move(),
        type_has_drop: type_has_drop.move(),
        type_drop_is_int: type_drop_is_int.move(),
        type_drop_is_str_rt: type_drop_is_str_rt.move(),
        type_copy_clones: type_copy_clones.move(),
        type_clone_is_int: type_clone_is_int.move(),
        type_drop_fn: type_drop_fn.move(),
        type_drop_rt_id: type_drop_rt_id.move(),
        type_is_alloc_row: type_is_alloc_row.move(),
        name_rt_tag: name_rt_tag.move(),
        name_rt_sym_id: name_rt_sym_id.move(),
        name_is_alloc: name_is_alloc.move(),
        fn_is_unique: fn_is_unique.move(),
        fn_has_asm: fn_has_asm.move(),
        fn_is_stop: fn_is_stop.move(),
        data_core_cell_rt_id: data_core_cell_rt_id.move(),
        runtime_symbols: rt_syms.move(),
        use_indexed_rt: use_indexed_rt,
    }
}

// The selecting threads' inputs, read-only while they run: the module
// (moved in and taken back after the join), the JET_X64_EMIT_LOG names
// (ir_x64_log_names), the claim order (heaviest first) and its next rank,
// which a thread takes with one atomic add, and per seat the row its thread
// is selecting (-1 none).
IRX64Inputs: struct {
    programs: [IRModule],
    fast: IRX64FastModule{ir_x64_fast_module_empty()},
    names: [String],
    order: [Int],
    next: Atomic<Int>,
    seats: [IRX64Seat],
    poll: Int{-1},
    trap: Int{-1},
    turn: Int{-1},
    zone_plot: Int{-1},
    zone_frame: Int{-1},
}

// Cache-line padded per-worker seat (64 bytes) to eliminate false sharing across workers.
IRX64Seat: struct {
    row: Atomic<Int>,
    pad0: Int{0},
    pad1: Int{0},
    pad2: Int{0},
    pad3: Int{0},
    pad4: Int{0},
    pad5: Int{0},
    pad6: Int{0},
}

// A function row and its selection, kept by the thread that selected it
// until the join.
IRX64Selected: struct {
    row: Int,
    compiled: IRX64FunctionResult,
}

// Runs the selecting threads until every row of `outputs` holds its result
// or `stops` the panic text of a thread that stopped on it. A stopped
// thread's finished rows go with it and are selected again (selection is
// deterministic), so a round that leaves rows behind has stopped on one.
ir_x64_select_rows: fn(inputs: Shared<IRX64Inputs>, workers: Int, outputs: ^[IRX64FunctionResult?], stops: ^[String]) {
    total: outputs.len()
    filled := 0
    loop {
        parts := ir_x64_claimers(inputs, 0, workers, stops) ?? panic("the x64 selection threads failed")
        loop parts.len() > 0 {
            part := parts.pop() ?? {
                break
            }
            loop part.len() > 0 {
                selected := part.pop() ?? {
                    break
                }
                if outputs[selected.row] == None -> filled += 1
                outputs[selected.row] = Val(selected.compiled.move())
            }
        }
        if filled == total {
            return
        }
        missing := [Int]{}
        stopped := 0
        has_stops: stops.len() == total
        loop row in 0..<total {
            if has_stops && stops[row] != "" -> stopped += 1 else if outputs[row] == None {
                missing.push(row)
            }
        }
        if missing.len() == 0 {
            return
        }
        if stopped == 0 {
            panic("the x64 selection threads left {missing.len()} functions unselected")
        }
        ir_x64_reclaim(inputs, missing)
    }
}

// The next round claims `rows`.
ir_x64_reclaim: fn(inputs: Shared<IRX64Inputs>, rows: ^^[Int]) {
    permit := inputs.guard_edit()
    permit.value.order = rows.move()
    permit.value.next.store(0)
}

// Runs `tasks` claiming threads from seat `seat` on, one task each; returns
// their selections. A stopped thread's function keeps its panic text in
// `stops` (ir_x64_stopped).
ir_x64_claimers: fn(inputs: Shared<IRX64Inputs>, seat: Int, tasks: Int, stops: ^[String]) -> [[IRX64Selected]] {
    if tasks <= 0 -> return [[IRX64Selected]]{}
    parts := [[IRX64Selected]]{}
    task.group ir_x64_threads {
        head: task ir_x64_claimed(inputs, seat)
        parts = ir_x64_claimers(inputs, seat + 1, tasks - 1, stops)
        part: head.join() ?? ir_x64_stopped(inputs, seat, err, stops)
        parts.push(part)
    }
    parts
}

// One thread at `seat`: claims and selects functions until none is left.
// Reuses one IRPatchEmitter per worker (eliminating per-function scratch heap
// allocations) and claims small functions in chunks of 16 to cut atomic RMW
// contention across 24+ cores.
ir_x64_claimed: fn(inputs: Shared<IRX64Inputs>, seat: Int) -> [IRX64Selected] {
    reads: inputs.guard_read()
    order_len: reads.value.order.len()
    selected := [IRX64Selected]{}
    est: order_len.div_euclid(reads.value.seats.len() + 1) + 16
    selected.try_reserve(est) ?? ()
    poll: reads.value.poll
    trap: reads.value.trap
    turn: reads.value.turn
    zone_plot: reads.value.zone_plot
    zone_frame: reads.value.zone_frame
    heavy_limit: reads.value.seats.len() * 4
    patch := ir_patch_emitter_new()
    loop {
        cur: reads.value.next.load()
        if cur >= order_len -> break
        step: if cur < heavy_limit -> 1 else -> 16
        first: reads.value.next.add(step)
        if first >= order_len -> break
        end: if first + step < order_len -> first + step else -> order_len
        loop rank in first..<end {
            row: reads.value.order[rank]
            reads.value.seats[seat].row.store(row)
            compiled := ir_x64_select_function_in(reads.value.programs[0], reads.value.fast, row, reads.value.names, poll, trap, turn, zone_plot, zone_frame, patch)
            selected.push(IRX64Selected{row: row, compiled: compiled.move()})
        }
    }
    reads.value.seats[seat].row.store(-1)
    selected
}

// A thread at `seat` stopped: the function it was selecting keeps the panic text.
ir_x64_stopped: fn(inputs: Shared<IRX64Inputs>, seat: Int, failure: TaskFailure, stops: ^[String]) -> [IRX64Selected] {
    reads: inputs.guard_read()
    row: reads.value.seats[seat].row.load()
    if row >= 0 {
        total: reads.value.programs[0].functions.len()
        if stops.len() < total {
            stops.try_reserve(total) ?? ()
            loop stops.len() < total -> stops.push("")
        }
        stops[row] = compiler_threads_failure_text(failure)
        reads.value.seats[seat].row.store(-1)
    }
    [IRX64Selected]{}
}

ir_x64_take_inputs: fn(inputs: Shared<IRX64Inputs>) -> IRX64Inputs {
    permit := inputs.guard_edit()
    fast_out := ir_x64_fast_module_empty()
    fast_out.runtime_symbols = compiler_take_rows<String>(permit.value.fast.runtime_symbols)
    fast_out.use_indexed_rt = permit.value.fast.use_indexed_rt
    IRX64Inputs{programs: compiler_take_rows<IRModule>(permit.value.programs), fast: fast_out.move(), names: [String]{}, order: [Int]{}, next: 0, seats: [IRX64Seat]{}}
}

// The relocatable object of `compiled` (moved in, every row moved on): its
// functions behind a global `main` that runs the module's entry function
// (no parameters, no result) through the runtime's jet_rt_main, as the old
// native route's object, or itself when the program owns its main
// (IRModule.owned_main), attaching its thread first when
// IRModule.owned_attach, and a global symbol for each runtime provider hook
// the program defines (IRModule.hooks), which the link binds the runtime's
// calls of the hook to. The link names the patchable zone sites of the
// functions `main` reaches in the image's part note (JetBackend
// Image/StaticLink.jet link_zone_write); no code registers them.
// `debug_info` false (the build option) leaves the DWARF sections empty;
// true also names each of the program's own writable cells by a global
// symbol (ir_debug_cell_exports), which a debugger's evaluation addresses
// them by.
IRX64ReachedPair: struct {
    functions: [X64CompiledFunction],
    debug: [X64FunctionDebug],
}

ir_x64_reached_pair: fn(functions_in: ^^[X64CompiledFunction], debug_in: ^^[X64FunctionDebug], roots: [Int], main: Bool) -> IRX64ReachedPair Never! {
    functions := functions_in.move()
    debug := debug_in.move()
    ir_x64_reached_only(functions, debug, roots, main)
    IRX64ReachedPair{functions: functions.move(), debug: debug.move()}
}

ir_x64_write_with_release: fn(owned_in: ^^IRX64Result, program: ^^X64ObjectModule, functions: ^^[X64CompiledFunction], debug: ^^[X64FunctionDebug], exports: [X64RuntimeExport], data_exports: [X64DataExport], threads: CompilerThreads, debug_info: Bool, own_sections: Bool, split: Bool, ways: Int) -> X64ExecutableResult Never! {
    owned := owned_in.move()
    if ways <= 1 {
        return x64_object_functions_threads(program, functions, debug, exports, data_exports, threads, debug_info, own_sections, split)
    }
    released: Shared{IRX64Released{runs: [[IRFunction]]{}, rest: [IRX64Result]{}}}
    ir_x64_release_fill(released, owned, ways)
    objects := [X64ExecutableResult]{}
    task.group ir_x64_object_release {
        rest: task ir_x64_release_rest(released)
        dropped: task ir_x64_release_runs(released, -1)
        objects.push(x64_object_functions_threads(program, functions, debug, exports, data_exports, threads, debug_info, own_sections, split))
        _: compiler_threads_joined(rest)
        _: compiler_threads_joined(dropped)
    }
    compiler_threads_taken(objects)
}

ir_x64_object: fn(compiled: ^^IRX64Result, debug_info: Bool, split: Bool{false}) -> X64ExecutableResult Never! {
    owned := compiled.move()
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    errors := ir_x64_main_rows_collect(owned, functions, debug)
    if errors.len() > 0 -> return X64ExecutableResult{bytes: [U8]{}, errors: errors.move()}
    has_main: owned.program.entry >= 0
    kept_roots: compiler_take_rows<Int>(owned.program.kept)
    exports := [X64RuntimeExport]{X64RuntimeExport{function: X64FunctionID{value: -1}, symbol: "main"}}
    loop hook in compiler_take_rows<IRLibraryExport>(owned.program.hooks) {
        exports.push(X64RuntimeExport{function: X64FunctionID{value: hook.function}, symbol: hook.symbol})
    }
    cells: if debug_info -> ir_debug_cell_exports(owned.program) else -> [X64DataExport]{}
    threads: CompilerThreads{cap: owned.threads.cap, cores: owned.threads.cores, memory_available: owned.threads.memory_available}
    // What is left of the compile (its IR module above all) is read no more.
    // When its instructions admit threads (ir_x64_release_ways) it drops on
    // tasks of their own while the object is written; a smaller compile
    // drops here, after the object is written, as `owned` goes.
    ways: ir_x64_release_ways(owned.program, threads)
    programs := [X64ObjectModule]{}
    if ways > 1 {
        task.group ir_x64_object_prep {
            reached: task ir_x64_reached_pair(functions.move(), debug.move(), kept_roots, has_main)
            programs.push(ir_x64_object_module(owned))
            pair := compiler_threads_joined(reached)
            functions = pair.functions.move()
            debug = pair.debug.move()
        }
    } else {
        ir_x64_reached_only(functions, debug, kept_roots, has_main)
        programs.push(ir_x64_object_module(owned))
    }
    program: compiler_threads_taken(programs)
    ir_x64_write_with_release(owned, program, functions, debug, exports, cells, threads, debug_info, false, split, ways)
}

// What ir_x64_object writes without debug info, unwritten: the data of the
// module (the object reads no debug file, type or source then), `main` and
// the functions it or a kept root reaches with their debug rows, for a bind
// straight from them (JetBackend Image/DirectBind.jet
// x64_bind_functions_at); else `errors`, ir_x64_object's.
IRX64Program: struct {
    program: X64ObjectModule,
    functions: [X64CompiledFunction],
    debug: [X64FunctionDebug],
    threads: CompilerThreads,
    errors: [String],
}

// The program of `compiled` (moved in, its rows moved on; the rest drops
// here).
ir_x64_program: fn(compiled: ^^IRX64Result) -> IRX64Program Never! {
    owned := compiled.move()
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    errors := ir_x64_main_rows(owned, functions, debug)
    IRX64Program{
        program: X64ObjectModule{data: compiler_take_rows<X64Data>(owned.tables.data), debug: X64ModuleDebug{directory: "", files: [String]{}, types: [X64DebugType]{}}, functions: [X64FunctionSource]{}, runtime_symbols: compiler_take_rows<String>(owned.tables.runtime_symbols)},
        functions: functions.move(),
        debug: debug.move(),
        threads: CompilerThreads{cap: owned.threads.cap, cores: owned.threads.cores, memory_available: owned.threads.memory_available},
        errors: errors.move(),
    }
}

// The program of `compiled` as ir_x64_object writes it with debug info,
// unwritten: the module with its debug files, types and function sources
// beside its data, `main` and the functions it reaches with their debug
// rows. `jet debug`'s `fix` swaps these into a running image (JetDebug
// NativeFix.jet); their zone sites join no table, so they stay off.
ir_x64_debug_program: fn(compiled: ^^IRX64Result) -> IRX64Program Never! {
    owned := compiled.move()
    functions := [X64CompiledFunction]{}
    debug := [X64FunctionDebug]{}
    errors := ir_x64_main_rows(owned, functions, debug)
    IRX64Program{
        program: ir_x64_object_module(owned),
        functions: functions.move(),
        debug: debug.move(),
        threads: CompilerThreads{cap: owned.threads.cap, cores: owned.threads.cores, memory_available: owned.threads.memory_available},
        errors: errors.move(),
    }
}

// The object's functions of `owned` into `functions`, with their debug rows
// into `debug`: `main` for its entry function (x64_object_main), then the
// compiled functions it or a kept root reaches (ir_x64_reached_only). A
// module with no entry but kept roots, a debugger's held evaluation (JetIR
// Build.jet ir_build_held_root), has no `main`: its functions are those its
// kept roots reach. Else why there are none: the compile's errors, or an
// entry `main` can't run.
ir_x64_main_rows: fn(owned: ^IRX64Result, functions: ^[X64CompiledFunction], debug: ^[X64FunctionDebug]) -> [String] Never! {
    errors := ir_x64_main_rows_collect(owned, functions, debug)
    if errors.len() > 0 -> return errors
    ir_x64_reached_only(functions, debug, owned.program.kept, owned.program.entry >= 0)
    [String]{}
}

ir_x64_main_rows_collect: fn(owned: ^IRX64Result, functions: ^[X64CompiledFunction], debug: ^[X64FunctionDebug]) -> [String] Never! {
    if owned.errors.len() > 0 -> return compiler_take_rows<String>(owned.errors)
    entry: owned.program.entry
    if entry < 0 && owned.program.kept.len() > 0 {
        debug.extend(compiler_take_rows<X64FunctionDebug>(owned.debug))
        functions.extend(compiler_take_rows<X64CompiledFunction>(owned.functions))
        return [String]{}
    }
    if entry < 0 || entry >= owned.program.functions.len() {
        return [String]{"entry function {entry} is not in the module"}
    }
    if owned.program.functions[entry].param_count != 0 || owned.program.functions[entry].result >= 0 {
        return [String]{"entry function {owned.program.functions[entry].name} must take no parameters and return nothing"}
    }
    main: x64_object_main(X64FunctionID{value: entry}, owned.program.owned_main, owned.program.owned_attach, owned.program.owned_observe)
    need: owned.functions.len() + 1
    debug.try_reserve(need) ?? ()
    functions.try_reserve(need) ?? ()
    debug.push(x64_object_main_debug(main))
    debug.extend(compiler_take_rows<X64FunctionDebug>(owned.debug))
    functions.push(main.move())
    functions.extend(compiler_take_rows<X64CompiledFunction>(owned.functions))
    [String]{}
}

// The function that registers a library's zone-site table from its init
// array (ir_x64_library_object). A program's sites are in its image's part
// note instead (JetBackend Image/StaticLink.jet link_zone_write).
IR_X64_ZONE_SITES_NAME: "jet_perf_zone_sites"

// A library's site registration runs after every runtime init hook
// (Compiler/JetRuntime/lifecycle.list); it needs none of them.
IR_X64_ZONE_SITES_PRIORITY: 100

// The id of the function that registers the zone-site table of `functions`
// (ir_x64_zone_sites), one past the largest of theirs; None when none has a
// patchable site (X64Select.jet ir_x64_zone_stub).
ir_x64_zone_sites_id: fn(functions: [X64CompiledFunction]) -> X64FunctionID? Never! {
    max_id := -1
    listed := false
    loop function in functions {
        if function.id.value > max_id -> max_id = function.id.value
        if function.zones.len() > 0 -> listed = true
    }
    if listed -> Val(X64FunctionID{value: max_id + 1}) else -> None
}

// Appends to `functions`, with an empty `debug` row, function `id` named
// `name`: it registers the table of every patchable zone site `functions`
// holds with the runtime (JetBackend Image/Object.jet
// x64_object_zone_sites), which turns them on when zones are (JetRuntime
// PerfSamples.jet perf_zones_set). The table names each site by its
// function, so the sites are where the link put their functions.
ir_x64_zone_sites: fn(functions: ^[X64CompiledFunction], debug: ^[X64FunctionDebug], id: X64FunctionID, name: String) Never! {
    sites := [Int]{}
    loop function in functions {
        loop at in function.zones {
            sites.push(function.id.value)
            sites.push(at)
        }
    }
    functions.push(x64_object_zone_sites(id, name, sites))
    debug.push(X64FunctionDebug{lines: [X64LineRow]{}, body: 0, cfi: [U8]{}, ranges: [X64VariableRange]{}})
}

// Keeps the rows of `functions` (with their `debug` rows) whose function the
// first row, `main` when `main` holds, or a `dead_code: keep` root (`roots`,
// IRModule.kept) reaches through function relocations. The optimizer keeps
// every body it inlined (ir_optimize_module), so a function whose calls were
// all inlined has none left; a program object is one `.text`, which the
// static link keeps whole, so its dead functions go here.
ir_x64_reached_only: fn(functions: ^[X64CompiledFunction], debug: ^[X64FunctionDebug], roots: [Int], main: Bool) Never! {
    if functions.len() != debug.len() {
        panic("the object writer has {functions.len()} functions and {debug.len()} debug rows")
    }
    max_id := -1
    loop function in functions {
        if function.id.value > max_id -> max_id = function.id.value
    }
    // Flat singly-linked lists per function id + 1 (`id_first` / `id_next`),
    // avoiding one heap list allocation per function.
    span: max_id + 2
    id_first := [Int]{}
    reached := [Bool]{}
    id_first.try_reserve(span) ?? ()
    reached.try_reserve(span) ?? ()
    loop _ in 0..<span {
        id_first.push(-1)
        reached.push(false)
    }
    id_next := [Int]{}
    id_next.try_reserve(functions.len()) ?? ()
    loop _ in 0..<functions.len() -> id_next.push(-1)
    loop (index, function) in functions {
        at: function.id.value + 1
        if at >= 0 {
            id_next[index] = id_first[at]
            id_first[at] = index
        }
    }
    work := [Int]{}
    if main && functions.len() > 0 {
        work.push(functions[0].id.value)
        reached[functions[0].id.value + 1] = true
    }
    loop id in roots {
        if id + 1 < 0 || id + 1 >= reached.len() || reached[id + 1] -> next
        reached[id + 1] = true
        work.push(id)
    }
    loop work.len() > 0 {
        id: work.pop() ?? {
            break
        }
        row := id_first[id + 1]
        loop row >= 0 {
            loop reloc in functions[row].relocs {
                if reloc.kind == X64_RELOC_FUNCTION {
                    at: reloc.target + 1
                    if at >= 0 && at < reached.len() && !reached[at] {
                        reached[at] = true
                        work.push(reloc.target)
                    }
                }
            }
            row = id_next[row]
        }
    }
    all_kept := true
    loop function in functions {
        at: function.id.value + 1
        if at < 0 || !reached[at] {
            all_kept = false
            break
        }
    }
    if all_kept {
        return
    }
    kept := [X64CompiledFunction]{}
    kept_debug := [X64FunctionDebug]{}
    loop functions.len() > 0 {
        function := functions.pop() ?? {
            break
        }
        facts := debug.pop() ?? panic("the object writer lost a debug row")
        at: function.id.value + 1
        if at >= 0 && reached[at] {
            kept.push(function)
            kept_debug.push(facts)
        }
    }
    kept.reverse()
    kept_debug.reverse()
    compiler_transfer_rows<X64CompiledFunction>(functions, kept)
    compiler_transfer_rows<X64FunctionDebug>(debug, kept_debug)
}

// What ir_x64_object releases: the compile's IR functions in runs, each
// dropped on a thread of its own, and the `rest` of the compile. A task's
// arguments stay shared with the thread that spawns it, which drops them
// after the join, so what a task drops reaches it here: it pops it off.
IRX64Released: struct {
    runs: [[IRFunction]],
    rest: [IRX64Result],
}

// The most runs the IR functions of an object's compile drop in
// (ir_x64_release_fill): on one thread their drop outlasts the object write.
IR_X64_RELEASE_WAYS: 4

// Dropping an IR function's instructions costs about this much per
// instruction (measured as above).
IR_X64_RELEASE_NS_PER_INSTRUCTION: 15

// The runs `program`'s IR functions drop in: the threads x64 selection
// admission (ir_x64_admit) gives their drop, up to IR_X64_RELEASE_WAYS. One
// run means the compile is too small for a thread to pay off.
ir_x64_release_ways: fn(program: IRModule, threads: CompilerThreads) -> Int Never! {
    total := 0
    loop f in program.functions -> total += 1 + f.op.len()
    admitted: ir_x64_admit(threads, program.functions.len(), total, IR_X64_RELEASE_NS_PER_INSTRUCTION)
    if admitted > IR_X64_RELEASE_WAYS -> IR_X64_RELEASE_WAYS else -> admitted
}

// Moves `compiled` into `released` in O(1): its IR functions list moves
// whole, and `ir_x64_release_runs` splits it into `ways` chunks off the main
// thread so x64_object_functions_threads starts immediately.
ir_x64_release_fill: fn(released: Shared<IRX64Released>, compiled: ^^IRX64Result, ways: Int) Never! {
    owned := compiled.move()
    all := compiler_take_rows<IRFunction>(owned.program.functions)
    permit: released.guard_edit()
    if all.len() > 0 -> permit.value.runs.push(all.move())
    permit.value.rest.push(owned)
}

// Splits the queued IR function list into up to IR_X64_RELEASE_WAYS runs off
// the main thread and drops each run on a thread of its own.
ir_x64_release_runs: fn(released: Shared<IRX64Released>, runs: Int) -> Int Never! {
    if runs < 0 {
        all := ir_x64_release_pop_run(released)
        if all.len() == 0 -> return 0
        ways: if IR_X64_RELEASE_WAYS > 1 -> IR_X64_RELEASE_WAYS else -> 1
        share: all.len() /% ways + 1
        chunks := [[IRFunction]]{}
        loop all.len() > 0 {
            run := [IRFunction]{}
            run.try_reserve(share) ?? ()
            loop run.len() < share && all.len() > 0 {
                row := all.pop() ?? break
                run.push(row)
            }
            chunks.push(run)
        }
        count: chunks.len()
        ir_x64_release_push_runs(released, chunks)
        return ir_x64_release_runs(released, count)
    }
    if runs == 0 -> return 0
    if runs == 1 -> return ir_x64_release_run(released)
    count := 0
    task.group ir_x64_release_threads {
        head: task ir_x64_release_run(released)
        count = ir_x64_release_runs(released, runs - 1)
        count += compiler_threads_joined(head)
    }
    count
}

// Pops a run off `released` and drops it here, outside the lock; returns how
// many IR functions it held.
ir_x64_release_run: fn(released: Shared<IRX64Released>) -> Int Never! {
    run: ir_x64_release_pop_run(released)
    run.len()
}

ir_x64_release_pop_run: fn(released: Shared<IRX64Released>) -> [IRFunction] Never! {
    permit: released.guard_edit()
    permit.value.runs.pop() ?? [IRFunction]{}
}

ir_x64_release_push_runs: fn(released: Shared<IRX64Released>, chunks: ^[[IRFunction]]) Never! {
    permit: released.guard_edit()
    loop chunks.len() > 0 {
        chunk := chunks.pop() ?? break
        permit.value.runs.push(chunk)
    }
}

// Pops the rest of the compile off `released` and drops it here, outside the
// lock; returns how many rows of it there were (one).
ir_x64_release_rest: fn(released: Shared<IRX64Released>) -> Int Never! {
    rest: ir_x64_release_pop_rest(released)
    rest.len()
}

ir_x64_release_pop_rest: fn(released: Shared<IRX64Released>) -> [IRX64Result] Never! {
    permit: released.guard_edit()
    compiler_take_rows<IRX64Result>(permit.value.rest)
}

// Order the functions of `compiled` (and their debug rows) for the object's
// text: those `hot` names first, in the list's order, then the rest, each
// group in function order. `hot` lists the functions short cold runs enter,
// a hello `jet run`'s first (Compiler/JetCLI/hot-text.list, written by
// Tools/Perf/HotText.mjs), so their code shares pages: the kernel maps a
// read fault's neighboring pages with it, and a run that touches few
// windows of the image keeps few pages resident. JetBackend Object.jet lays
// `.data` out in the order this text references it. Returns how many names of
// `hot` name no function.
//
// A closure's, instance's or helper's symbol ends with its key's hash
// (ir_hashed_function), and the hash changes as the types its key spells
// do, so the list goes stale on those first; each of them a run enters then
// sits alone among the cold functions and costs the run a window of pages.
// A listed name no function has therefore hands its place to an unlisted
// function whose symbol differs from it only in that hash, in the list's
// and the functions' order, when the list's missing names of that stem are
// at least as many as such functions: a function's closures, or a generic
// function's instances, renamed together. A stem shared by more functions
// than missing names (a drop or copy helper's) says nothing of which one
// the list meant, and its functions stay cold.
ir_x64_hot_order: fn(compiled: ^IRX64Result, hot: [String]) -> Int Never! {
    if hot.len() == 0 -> return 0
    ranks := IRX64TextRows{}
    loop (position, name) in hot {
        if ir_x64_text_rows_get(ranks, name) < 0 -> ir_x64_text_rows_set(ranks, name, position)
    }
    count: compiled.functions.len()
    // Per function its rank, -1 when not listed; per rank whether a
    // function has its name.
    found := [Int]{}
    named := [Bool]{}
    loop _ in 0..<hot.len() -> named.push(false)
    loop index in 0..<count {
        listed: ir_x64_text_rows_get(ranks, compiled.functions[index].name)
        found.push(listed)
        if listed >= 0 -> named[listed] = true
    }
    // The stems of the missing hashed names (side 0, at their rank) and of
    // the unlisted hashed functions (side 1, at their index), sorted so each
    // stem's ranks come in list order and then its functions in function
    // order.
    missing := 0
    stems := [{stem: String, side: Int, at: Int}]{}
    loop (position, name) in hot {
        if named[position] || ir_x64_text_rows_get(ranks, name) != position -> next
        missing += 1
        start: ir_x64_hash_start(name)
        if start >= 0 -> stems.push({stem: name.slice(0, start), side: 0, at: position})
    }
    if stems.len() > 0 {
        loop index in 0..<count {
            if found[index] >= 0 -> next
            name: compiled.functions[index].name
            start: ir_x64_hash_start(name)
            if start >= 0 -> stems.push({stem: name.slice(0, start), side: 1, at: index})
        }
        stems.sort_by(fn(left: {stem: String, side: Int, at: Int}, right: {stem: String, side: Int, at: Int}) { (left.stem <=> right.stem).then(left.side <=> right.side).then(left.at <=> right.at) })
        first := 0
        loop first < stems.len() {
            functions := first
            loop functions < stems.len() && stems[functions].stem == stems[first].stem && stems[functions].side == 0 {
                functions += 1
            }
            last := functions
            loop last < stems.len() && stems[last].stem == stems[first].stem -> last += 1
            if last - functions <= functions - first {
                loop at in functions..<last {
                    found[stems[at].at] = stems[first + at - functions].at
                }
            }
            first = last
        }
    }
    // Per rank where its functions start in the new order (a counting sort
    // keeps function order within a rank).
    starts := [Int]{}
    loop _ in 0..<hot.len() + 1 -> starts.push(0)
    loop level in found {
        if level >= 0 -> starts[level + 1] = starts[level + 1] + 1
    }
    loop place in 0..<hot.len() -> starts[place + 1] = starts[place + 1] + starts[place]
    order := [Int]{}
    loop _ in 0..<count -> order.push(0)
    cold := starts[hot.len()]
    loop index in 0..<count {
        level: found[index]
        if level >= 0 {
            order[starts[level]] = index
            starts[level] = starts[level] + 1
        } else {
            order[cold] = index
            cold += 1
        }
    }
    compiler_apply_order<X64CompiledFunction>(compiled.functions, order.copy())
    compiler_apply_order<X64FunctionDebug>(compiled.debug, order)
    missing
}

// Where the key hash ends `symbol` (ir_hashed_function): the offset of its
// last 16 bytes when they are lowercase hex digits after a `_`, else -1.
ir_x64_hash_start: fn(symbol: String) -> Int Never! {
    bytes: symbol.bytes()
    start: bytes.len() - 16
    if start < 1 || bytes[start - 1] != 95 -> return -1
    loop at in start..<bytes.len() {
        byte: bytes[at]
        digit: byte >= U8{48} && byte <= U8{57}
        letter: byte >= U8{97} && byte <= U8{102}
        if !digit && !letter -> return -1
    }
    start
}

// The relocatable object of a library module (moved in, every row moved
// on): its functions with no `main`, each of `exports` (ir_build_library)
// a global symbol of its IR function and, with a priority, a constructor or
// destructor hook, and each of `data_exports` a global symbol of its data
// object. When its functions have patchable zone sites, a constructor
// registers their table (ir_x64_zone_sites), under a global symbol of its
// own (ir_x64_zone_sites_symbol). `debug_info` as ir_x64_object. With
// `own_sections` every function and data object is in a section of its
// own, so a link keeps only what it reaches; past the section indices
// ELF's headers hold (the Core library) the object numbers them through
// section 0 and `.symtab_shndx`.
ir_x64_library_globals: fn(program: IRModule, functions: ^[X64CompiledFunction], debug: ^[X64FunctionDebug], exports: [IRLibraryExport]) -> [X64RuntimeExport] Never! {
    globals := [X64RuntimeExport]{}
    globals.try_reserve(exports.len() + 1) ?? ()
    loop row in exports {
        globals.push(X64RuntimeExport{function: X64FunctionID{value: row.function}, symbol: row.symbol, init_priority: row.init_priority, fini_priority: row.fini_priority, guards: row.guards.copy()})
    }
    if ir_x64_zone_sites_id(functions) == .Val(id) {
        ir_x64_zone_sites(functions, debug, id, IR_X64_ZONE_SITES_NAME)
        globals.push(X64RuntimeExport{function: id, symbol: ir_x64_zone_sites_symbol(program), init_priority: IR_X64_ZONE_SITES_PRIORITY})
    }
    globals
}

ir_x64_library_object: fn(compiled: ^^IRX64Result, exports: [IRLibraryExport], data_exports: [X64DataExport], debug_info: Bool, own_sections: Bool) -> X64ExecutableResult Never! {
    owned := compiled.move()
    if owned.errors.len() > 0 {
        return X64ExecutableResult{bytes: [U8]{}, errors: compiler_take_rows<String>(owned.errors)}
    }
    program := ir_x64_object_module(owned)
    debug := compiler_take_rows<X64FunctionDebug>(owned.debug)
    functions := compiler_take_rows<X64CompiledFunction>(owned.functions)
    globals: ir_x64_library_globals(owned.program, functions, debug, exports)
    threads: CompilerThreads{cap: owned.threads.cap, cores: owned.threads.cores, memory_available: owned.threads.memory_available}
    ways: ir_x64_release_ways(owned.program, threads)
    ir_x64_write_with_release(owned, program, functions, debug, globals, data_exports, threads, debug_info, own_sections, false, ways)
}

// Same as ir_x64_library_object, borrowing `owned` so `owned.program` stays
// intact when the caller still needs it for another partition (such as the
// runtime's web partition after unblocking Core).
ir_x64_library_object_into: fn(owned: ^IRX64Result, exports: [IRLibraryExport], data_exports: [X64DataExport], debug_info: Bool, own_sections: Bool) -> X64ExecutableResult Never! {
    if owned.errors.len() > 0 {
        return X64ExecutableResult{bytes: [U8]{}, errors: compiler_take_rows<String>(owned.errors)}
    }
    program := ir_x64_object_module(owned)
    debug := compiler_take_rows<X64FunctionDebug>(owned.debug)
    functions := compiler_take_rows<X64CompiledFunction>(owned.functions)
    globals: ir_x64_library_globals(owned.program, functions, debug, exports)
    x64_object_functions_threads(program, functions, debug, globals, data_exports, owned.threads, debug_info, own_sections)
}

// The global symbol of a library's site registration: the init array names
// it, so each library's is its own, from the names of its functions.
ir_x64_zone_sites_symbol: fn(m: IRModule) -> String Never! {
    digest: sha256_hex(m.function_rows_keys.texts.join("\n"))
    "{IR_X64_ZONE_SITES_NAME}_{digest.slice(0..<16)}"
}

// The object writer's module of `owned`: its data, debug files, types and
// sources (taken) and per IR function its name as its source spells it
// (ir_x64_member_name), file, line, debug variables (taken) and inline
// sites.
ir_x64_object_module: fn(owned: ^IRX64Result) -> X64ObjectModule Never! {
    // Popped in function order.
    variables := compiler_take_rows<[X64DebugVariable]>(owned.variables)
    variables.reverse()
    sources := [X64FunctionSource]{}
    sources.try_reserve(owned.program.functions.len()) ?? ()
    last_file := ""
    last_file_row := -1
    loop f in owned.program.functions {
        file: if f.source_file == last_file -> last_file_row else -> {
            last_file = f.source_file
            last_file_row = ir_x64_text_rows_get(owned.tables.file_rows, f.source_file)
            last_file_row
        }
        listed := variables.pop() ?? [X64DebugVariable]{}
        inlines := [X64InlineSite]{}
        loop site in 1..<(f.inline_sites.len() /% IR_INLINE_SITE_WORDS + 1) {
            word: IR_INLINE_SITE_WORDS * (site - 1)
            row: f.inline_sites[word]
            parent: ir_inline_site_parent(f, site)
            call_line: f.inline_sites[word + 2]
            if row < 0 || row >= owned.program.functions.len() {
                inlines.push(X64InlineSite{function: -1, name: "?", file: -1, line: 0, parent: parent, call_line: call_line})
                next
            }
            callee: owned.program.functions[row]
            inlines.push(X64InlineSite{function: row, name: ir_x64_member_name(callee.name) ?? callee.name, file: ir_x64_text_rows_get(owned.tables.file_rows, callee.source_file), line: callee.line, parent: parent, call_line: call_line})
        }
        sources.push(X64FunctionSource{name: ir_x64_member_name(f.name) ?? f.name, file: file, line: f.line, variables: listed.move(), inlines: inlines.move()})
    }
    X64ObjectModule{
        data: compiler_take_rows<X64Data>(owned.tables.data),
        debug: X64ModuleDebug{directory: owned.program.debug_directory.copy(), files: compiler_take_rows<String>(owned.tables.files), types: compiler_take_rows<X64DebugType>(owned.tables.debug_types), level: owned.program.debug_level, sources: compiler_take_rows<X64DebugSource>(owned.program.debug_sources)},
        functions: sources.move(),
        runtime_symbols: compiler_take_rows<String>(owned.tables.runtime_symbols),
    }
}

// A lifted module member's name as its source spells it, its module path
// and its own name (`__jet_small_dbump`, an instance `small` of a generic
// module: `small.bump`, InlineModules.jet sema_inline_generated_path), and a
// lambda's in one (`__jet_small_dbump.lambda@40`: `small.bump.lambda@40`),
// so a debugger's frames, `break small.bump` and a profile's functions read
// it as written. None for any other name, which is already as written.
ir_x64_member_name: fn(name: String) -> String? Never! {
    if !name.starts_with("__jet_") -> return None
    parts: name.partition(".")
    path: sema_inline_member_module(parts.head)
    if path == "" -> return None
    Val("{path}.{sema_inline_member_source_name(parts.head)}{parts.sep}{parts.tail}")
}

#Test("A lifted module member's debug name is its module path and its own name") {
    assert_eq(ir_x64_member_name("__jet_small_dbump"), Val("small.bump"))
    assert_eq(ir_x64_member_name("__jet_db_dinner_ddeep"), Val("db.inner.deep"))
    assert_eq(ir_x64_member_name("__jet_small_dbump.lambda@40"), Val("small.bump.lambda@40"))
    assert_eq(ir_x64_member_name("run"), None)
    assert_eq(ir_x64_member_name("run.lambda@12"), None)
    assert_eq(ir_x64_member_name("__jet_lambda_7"), None)
}

// A Shared handle of an Int: a typedef named as Jet spells it, of a pointer
// to the cell, whose one unnamed member at the payload word points at the
// Int's row.
#Test("A Shared handle's debug type reaches its value through its cell's payload word") {
    m := ir_module_new()
    int_row: ir_scalar_type_row(m, Type.Int)
    handle: Type.Shared{inner: Type.Int}
    handle_tid: ir_module_intern_tid(m, handle)
    row: ir_intern_type(m, ir_type_name(handle), ir_owned_layout(IRTypeKind.Pointer, handle_tid, "jet_rt_native_shared_drop", "jet_rt_native_shared_clone"))
    m.list_elements[row] = int_row
    tables := ir_x64_tables_start(m)
    ir_x64_debug_types(m, tables)
    described: tables.debug_types[row]
    assert_eq(described.name, ir_type_name(handle))
    to_cell: if described.kind == .Typedef(target) -> target else -> -1
    assert(to_cell >= 0, "the handle is a typedef of a pointer")
    cell: if tables.debug_types[to_cell].kind == .Pointer(target) -> target else -> -1
    assert(cell >= 0, "the pointer points at the cell")
    members: if tables.debug_types[cell].kind == .Struct(listed) -> listed else -> [X64DebugMember]{}
    assert(members.len() == 1 && members[0].name == "" && members[0].offset == IR_X64_SHARED_PAYLOAD, "the cell's one member is its payload word")
    value: if tables.debug_types[members[0].ty].kind == .Pointer(target) -> target else -> -1
    assert_eq(value, int_row)
}

// Two parts of a parallel build may reach one type row by different
// spellings, in either order: a runtime handle by its bare name or by its
// declaration's key, a union with its members in either order. Each row is
// named by one spelling whichever reached it first, so the parts' rows
// describe the same types and their `.debug_info` is the same bytes.
#Test("a type row's debug name does not depend on which spelling reached it first") {
    members: [Type]{Type.Int, Type.String}
    defs := [TTypeDef]{ir_union_def(module_none(), ir_union_key(Type.Union{members: members}), members)}
    p := ir_program_declared(defs, [TImplDef]{}, [TConstantDef]{}, [FnBody]{}, symbol_table(), interner_empty())
    spellings: [[Type]]{
        [Type]{Type.Named{name: "FileReader"}, Type.Named{name: "<corelib>/core.files.FileReader"}},
        [Type]{Type.Union{members: [Type]{Type.Int, Type.String}}, Type.Union{members: [Type]{Type.String, Type.Int}}},
    }
    names := [[String]]{}
    infos := [[U8]]{}
    loop later in 0..<2 {
        m := ir_module_new()
        order: [Int]{1 - later, later}
        loop pair in spellings {
            loop at in order {
                _: ir_value_type(m, p, pair[at]) ?? panic("{ir_type_name(pair[at])} has no row")
            }
        }
        named: loop row in 0..<m.types.len() -> ir_type_name(ir_module_row_ty(m, row))
        names.push(named)
        tables := ir_x64_tables_start(m)
        ir_x64_debug_types(m, tables)
        program: X64ObjectModule{data: [X64Data]{}, debug: X64ModuleDebug{directory: "", files: [String]{}, types: compiler_take_rows<X64DebugType>(tables.debug_types)}, functions: [X64FunctionSource]{}}
        symbols: X64DwarfSymbols{text: 1, abbrev: 2, line: 3, loclists: 4, addr: 5, rnglists: 6, functions: [Int]{}}
        built: x64_dwarf_sections(program, [X64CompiledFunction]{}, [X64FunctionDebug]{}, [Int]{}, [Int]{}, 0, symbols, compiler_threads_single(), true)
        infos.push(dwarf_test_bytes(built.info))
    }
    assert_eq(names[0], names[1])
    assert(names[0].contains("<corelib>/core.files.FileReader"), "the handle is named by its declaration's key")
    assert(names[0].contains("Int | String"), "the union is named with its members in layout order")
    assert(infos[0].len() > 0, "the types are described")
    assert_eq(infos[0], infos[1])
}

// A Decimal's, Fraction's or Duration's row takes the table spelling that
// reached it first, keyed or bare, so the debugger's handle types are found
// by the row, never by its type's name.
#Test("a precise number's or a Duration's row is described as its handle by either spelling") {
    p: ir_program_declared([TTypeDef]{}, [TImplDef]{}, [TConstantDef]{}, [FnBody]{}, symbol_table(), interner_empty())
    spellings: [Type]{Type.Named{name: "<corelib>/core.math.Fraction"}, Type.Named{name: "Fraction"}, Type.Named{name: "<corelib>/core.math.Decimal"}, Type.Named{name: "Decimal"}, Type.Named{name: "Duration"}}
    shown: [String]{"Fraction", "Fraction", "Decimal", "Decimal", "Duration"}
    runtimes: [String]{"JetFraction", "JetFraction", "JetDecimal", "JetDecimal", "Duration"}
    m := ir_module_new()
    rows: loop ty in spellings -> ir_value_type(m, p, ty) ?? panic("{ir_type_name(ty)} has no row")
    assert_eq(rows[0], rows[1])
    assert_eq(rows[2], rows[3])
    tables := ir_x64_tables_start(m)
    ir_x64_debug_types(m, tables)
    loop (at, row) in rows {
        assert(ir_handle_row_is(m, row, runtimes[at]), "{shown[at]} is its runtime's handle row")
        described: tables.debug_types[row]
        assert_eq(described.name, shown[at])
        to_handle: if described.kind == .Typedef(target) -> target else -> -1
        assert(to_handle >= 0, "{shown[at]} is a typedef of its handle's pointer")
    }
}

// walk(n, acc) returns walk(n - 1, acc + n): in a fast O0 module, which the
// stencil emitter compiles, the call is a jump to walk, so the
// recursion runs in constant stack; no `call` reaches walk.
#Test("a fast O0 module's tail call is a jump") {
    m := ir_module_new()
    m.fast_o0 = true
    word: ir_scalar_type_row(m, Type.IntN{signed: true, bits: 64})
    bool_row: ir_scalar_type_row(m, Type.Bool)
    f := ir_function_new("walk", "test:walk.jet.walk", "", "walk.jet", 1)
    n: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "n"), 1)
    acc: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "acc"), 1)
    f.result = word
    zero: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    done: ir_slot(f, bool_row, IRSlotKind.Temp, -1, 0)
    one: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    left: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    sum: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    walked: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Const, zero, 0, -1, -1, 2)
    _ := ir_emit(f, IROp.Eq, done, n, zero, IR_OVERFLOW_WRAP, 2)
    _ := ir_open_if(f, done, 2)
    _ := ir_emit(f, IROp.Return, -1, acc, -1, -1, 2)
    ir_end(f, 2)
    _ := ir_emit(f, IROp.Const, one, 1, -1, -1, 3)
    _ := ir_emit(f, IROp.Sub, left, n, one, IR_OVERFLOW_WRAP, 3)
    _ := ir_emit(f, IROp.Add, sum, acc, n, IR_OVERFLOW_WRAP, 3)
    passed: ir_args(f, [Int]{left, sum})
    _ := ir_emit(f, IROp.Call, walked, 0, passed, 2, 3)
    _ := ir_emit(f, IROp.Return, -1, walked, -1, -1, 3)
    m.functions.push(f)
    compiled: ir_x64_compile_module(m, compiler_threads_single())
    assert(compiled.errors.is_empty(), compiled.errors.join("; "))
    code: compiled.functions[0].code
    jumps := 0
    loop reloc in compiled.functions[0].relocs {
        if reloc.kind != X64_RELOC_FUNCTION || reloc.target != 0 -> next
        assert(reloc.at > 0 && code[reloc.at - 1] == U8{0xE9}, "walk reaches walk only by a jmp")
        jumps += 1
    }
    assert_eq(jumps, 1)
}
