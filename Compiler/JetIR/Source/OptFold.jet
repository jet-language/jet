// Identical glue (O1, O2, once every body is optimized): the functions the
// build makes itself (drop, copy and unique glue, map and order helpers: no
// source file) are built per checked type, and
// rows that differ only in the type they spell (a map keyed by a string and
// one keyed by a Name) have the same layout, so their glue comes out the same,
// instruction for instruction. Such copies become one: every direct call of
// a copy and every row whose drop or clone routine is a copy name the first
// of them instead, and the object writer keeps only what its entry reaches
// (X64Module.jet ir_x64_reached_only), so the copy leaves the image. Two
// bodies are the same when their instructions are, a routine they reach
// (a direct call, or the drop routine of a dropped slot's row) counting by
// its class, and their slots' rows are, read as layouts (ir_opt_fold_row).
// Glue reaches itself (its parameter's row drops through it) and other
// glue, so the classes start as one and split until no class holds bodies
// that differ: copies that only reach copies of each other stay one. A
// function whose address is taken keeps it.
use jet_foundation.[CompilerThreads, compiler_take_rows, compiler_threads_admit, compiler_threads_joined, compiler_threads_partition, compiler_threads_single, compiler_transfer_rows, name_hash, name_index, name_intern, name_table]

// Folds the copies among `m.functions`' bodies `functions`; returns how many
// functions nothing reaches any more.
ir_opt_fold_identical: fn(m: ^IRModule, functions: ^[IRFunction], threads: CompilerThreads) -> Int Never! {
    count: functions.len()
    // Each function's class to start: every candidate's is the first one.
    start := [Int]{}
    lowest := -1
    total := 0
    loop f in functions {
        candidate: ir_opt_fold_candidate(f)
        if candidate && lowest < 0 -> lowest = start.len()
        if candidate -> total += 1 + f.op.len()
        start.push(if candidate -> 0 else -> -1)
    }
    loop id in 0..<count {
        if start[id] == 0 -> start[id] = lowest
    }
    classes := if lowest < 0 -> 0 else -> 1
    // Each candidate's body is spelled once, as its shape: everything but
    // the functions it reaches, which a round reads by their class. Bodies
    // of one shape number the same: the first of them.
    found: ir_opt_fold_shapes(m, functions, threads)
    admitted: compiler_threads_admit(threads, count, total, IR_OPT_MIN_INSTRUCTIONS_PER_THREAD, 0, 0)
    groups := IROptFoldGroups{first: start.move(), shape_of: [Int]{}, shapes: found.move(), workers: if admitted < 1 -> 1 else -> admitted, rounds: 0}
    _: ir_opt_fold_grouped(groups, count)
    loop classes > 0 {
        found_classes: ir_opt_fold_grouped(groups, count)
        if found_classes == classes -> break
        classes = found_classes
    }
    first: compiler_take_rows<Int>(groups.first)
    folded := 0
    loop id in 0..<count {
        if first[id] >= 0 && first[id] != id -> folded += 1
    }
    if folded == 0 -> return 0
    loop id in 0..<count -> ir_opt_fold_calls(functions[id], first)
    loop row in 0..<m.types.len() {
        m.types[row].drop = ir_opt_fold_name(m, functions, m.types[row].drop, first)
        m.types[row].clone = ir_opt_fold_name(m, functions, m.types[row].clone, first)
    }
    folded
}

// Whether ir_opt_fold_identical may fold `f`: a body the build made itself.
ir_opt_fold_candidate: fn(f: IRFunction) -> Bool Never! {
    f.source_file == "" && f.asm == None && f.op.len() > 0
}

// Each body's shape (ir_opt_fold_shape; none for a body that is no
// candidate). A shape reads only its body and the module's rows, which the
// threads read and none writes, so the bodies split into consecutive parts
// (compiler_threads_partition by size), one thread each, joined in part
// order: the shapes are the same for any thread count.
ir_opt_fold_shapes: fn(m: IRModule, functions: ^[IRFunction], threads: CompilerThreads) -> [IROptFoldShape] Never! {
    rows: ir_opt_fold_rows(m)
    count: functions.len()
    weights := [Int]{}
    total := 0
    loop f in functions {
        weight: if ir_opt_fold_candidate(f) -> 1 + f.op.len() else -> 1
        weights.push(weight)
        total += weight
    }
    found := [IROptFoldShape]{}
    workers: compiler_threads_admit(threads, count, total, IR_OPT_MIN_INSTRUCTIONS_PER_THREAD, 0, 0)
    if workers <= 1 {
        loop f in functions -> found.push(ir_opt_fold_shape_of(m, f, rows))
        return found
    }
    bounds: compiler_threads_partition(weights, workers)
    // Parts leave the list last-first: part `workers - 1` pops first.
    parts := [[IRFunction]]{}
    part := workers - 1
    loop part >= 0 {
        bodies := [IRFunction]{}
        loop functions.len() > bounds[part] {
            body: functions.pop() ?? break
            bodies.push(body)
        }
        bodies.reverse()
        parts.push(bodies.move())
        part -= 1
    }
    parts.reverse()
    shaped := ir_opt_fold_shape_parts(m, rows, parts, 0)
    loop at in 0..<shaped.len() {
        functions.extend(compiler_take_rows<IRFunction>(shaped[at].functions))
        found.extend(compiler_take_rows<IROptFoldShape>(shaped[at].shapes))
    }
    found
}

// Body `f`'s shape when it is a candidate, else an empty one.
ir_opt_fold_shape_of: fn(m: IRModule, f: IRFunction, rows: [Int]) -> IROptFoldShape Never! {
    if !ir_opt_fold_candidate(f) -> return IROptFoldShape{text: "", reached: [Int]{}, spread: 0}
    ir_opt_fold_shape(m, f, rows)
}

// The functions of one thread of ir_opt_fold_shapes, in order, and their
// shapes.
IROptFoldPart: struct {
    functions: [IRFunction],
    shapes: [IROptFoldShape],
}

// Parts `at` on, in part order, each shaped on its own thread and the last
// on this one (ir_opt_fold_part).
ir_opt_fold_shape_parts: fn(m: IRModule, rows: [Int], parts: ^[[IRFunction]], at: Int) -> [IROptFoldPart] Never! {
    done := [IROptFoldPart]{}
    if at >= parts.len() -> return done
    if at == parts.len() - 1 {
        done.push(ir_opt_fold_part(m, rows, compiler_take_rows<IRFunction>(parts[at])))
        return done
    }
    task.group ir_opt_fold_group {
        head: task ir_opt_fold_part(m, rows, compiler_take_rows<IRFunction>(parts[at]))
        rest: ir_opt_fold_shape_parts(m, rows, parts, at + 1)
        done.push(compiler_threads_joined(head))
        loop part in rest.move() -> done.push(part)
    }
    done
}

// One part's functions and their shapes.
ir_opt_fold_part: fn(m: IRModule, rows: [Int], functions: ^^[IRFunction]) -> IROptFoldPart Never! {
    part := IROptFoldPart{functions: functions.move(), shapes: [IROptFoldShape]{}}
    loop row in 0..<part.functions.len() {
        part.shapes.push(ir_opt_fold_shape_of(m, part.functions[row], rows))
    }
    part
}

// The candidates of ir_opt_fold_identical grouped by their shape (its first
// walk), then in each round by their key (ir_opt_fold_key). Equal shapes or
// keys spread to the same of `workers` buckets (a shape by its spread, a key
// by its shape's number), and each bucket groups its own, one thread each,
// so a candidate's group is the first candidate of equal text: the same for
// any thread count.
IROptFoldGroups: struct {
    // Per function its class (-1: no candidate), its shape's number (the
    // first body of its shape; empty until the first walk), and its shape.
    first: [Int],
    shape_of: [Int],
    shapes: [IROptFoldShape],
    workers: Int,
    // The walks so far: 0 groups shapes, a later one is a round.
    rounds: Int,
}

// One bucket of a walk: its candidates in order, with the first of their
// group, and how many groups it found.
IROptFoldBucket: struct {
    ids: [Int],
    firsts: [Int],
    keys: Int,
}

// Groups the candidates once (shapes, then a round), taking the first
// walk's groups as the shapes' numbers and a round's as the classes;
// returns how many groups there are.
ir_opt_fold_grouped: fn(groups: ^IROptFoldGroups, count: Int) -> Int Never! {
    found: ir_opt_fold_buckets(groups, 0)
    result := [Int]{}
    loop _ in 0..<count -> result.push(-1)
    keys := 0
    loop bucket in found {
        loop k in 0..<bucket.ids.len() -> result[bucket.ids[k]] = bucket.firsts[k]
        keys += bucket.keys
    }
    if {
        groups.rounds == 0 -> groups.shape_of = result.move()
        else -> groups.first = result.move()
    }
    groups.rounds += 1
    keys
}

// Buckets `at` on, in order, each grouped on its own thread and the last
// on this one (ir_opt_fold_bucket).
ir_opt_fold_buckets: fn(groups: IROptFoldGroups, at: Int) -> [IROptFoldBucket] Never! {
    done := [IROptFoldBucket]{}
    if at >= groups.workers -> return done
    if at == groups.workers - 1 {
        done.push(ir_opt_fold_bucket(groups, at))
        return done
    }
    task.group ir_opt_fold_grouping {
        head: task ir_opt_fold_bucket(groups, at)
        rest: ir_opt_fold_buckets(groups, at + 1)
        done.push(compiler_threads_joined(head))
        loop bucket in rest.move() -> done.push(bucket)
    }
    done
}

// Groups bucket `bucket`'s candidates, in order, by their shape's text
// (the first walk) or their key.
ir_opt_fold_bucket: fn(groups: IROptFoldGroups, bucket: Int) -> IROptFoldBucket Never! {
    shaping: groups.rounds == 0
    found := IROptFoldBucket{ids: [Int]{}, firsts: [Int]{}, keys: 0}
    // Each text's first candidate, by the text's id in `seen`; NameTable id
    // 0 is the empty text, which no candidate has.
    seen := name_table()
    first_of := [Int]{-1}
    loop id in 0..<groups.first.len() {
        if groups.first[id] < 0 -> next
        spread: if shaping -> groups.shapes[id].spread else -> groups.shape_of[id]
        if spread % groups.workers != bucket -> next
        text: if shaping -> groups.shapes[id].text else -> ir_opt_fold_key(groups.first, id, groups.shape_of[id], groups.shapes[id].reached)
        key: name_index(name_intern(seen, text))
        if key == first_of.len() -> first_of.push(id)
        found.ids.push(id)
        found.firsts.push(first_of[key])
    }
    found.keys = first_of.len() - 1
    found
}

// The key of the function a row's routine `name` names once copies are
// one; a name of no function stays.
ir_opt_fold_name: fn(m: IRModule, functions: [IRFunction], name: String, first: [Int]) -> String Never! {
    if name == "" -> return name.copy()
    id: ir_keyed_function(m, name) ?? return name.copy()
    target: ir_opt_fold_callee(first, id)
    if target == id || target >= functions.len() -> return name.copy()
    functions[target].key.copy()
}

// Points each direct call of `f` at the function it reaches once copies
// are one.
ir_opt_fold_calls: fn(f: ^IRFunction, first: [Int]) Never! {
    loop at in 0..<f.op.len() {
        if f.op[at] == .Call -> f.a[at] = ir_opt_fold_callee(first, f.a[at])
    }
}

// The function a direct call of `callee` reaches once copies are one.
ir_opt_fold_callee: fn(first: [Int], callee: Int) -> Int Never! {
    if callee < 0 || callee >= first.len() || first[callee] < 0 -> return callee
    first[callee]
}

// Per type row of `m`, its layout (ir_opt_fold_row) as a number, its id in
// `layouts`: rows of the same layout share one.
ir_opt_fold_rows: fn(m: IRModule) -> [Int] Never! {
    layouts := name_table()
    rows := [Int]{}
    loop ty in m.types -> rows.push(name_index(name_intern(layouts, ir_opt_fold_row(m, ty))))
    rows
}

// What selection reads of a row besides a Drop's routine: its kind and
// layout, whether its values drop, and the runtime routines that drop and
// copy them, which it routes by name. Glue the module builds is called only
// by a Drop (ir_opt_fold_key) or a direct call.
ir_opt_fold_row: fn(m: IRModule, ty: IRType) -> String Never! {
    class: if ty.class == {
        .Integer -> "i"
        .Pointer -> "p"
        .Float -> "f"
        .Memory -> "m"
    }
    "{ir_kind_name(ty.kind)} {ty.size} {ty.align} {class} {ty.signed} {ty.bits} {ir_opt_fold_runtime(m, ty.drop)} {ir_opt_fold_runtime(m, ty.clone)}"
}

// A routine symbol as a row names it: a runtime routine by its name, a
// function of the module as one.
ir_opt_fold_runtime: fn(m: IRModule, symbol: String) -> String Never! {
    if ir_keyed_function(m, symbol) != None -> return "#"
    symbol.copy()
}

// Body `f` as ir_opt_fold_identical compares it, apart from the functions
// it reaches: `text` spells the rest, with `#` where a direct call's callee
// or a dropped slot's routine names a function of the module, `reached`
// lists those functions in that order, and `spread` is a hash of the text
// (ir_opt_fold_spread).
IROptFoldShape: struct {
    text: String,
    reached: [Int],
    spread: Int,
}

ir_opt_fold_shape: fn(m: IRModule, f: IRFunction, rows: [Int]) -> IROptFoldShape Never! {
    result: if f.result < 0 -> -1 else -> rows[f.result]
    parts := [String]{"{f.param_count} {result}"}
    reached := [Int]{}
    loop slot in 0..<f.slot_type.len() {
        kind: if f.slot_kind[slot] == {
            .Param -> "p"
            .Local -> "l"
            .Temp -> "t"
        }
        parts.push("{kind}{rows[f.slot_type[slot]]}")
    }
    loop at in 0..<f.op.len() {
        a: f.a[at]
        if f.op[at] == .Call {
            parts.push("{ir_op_name(f.op[at])} {f.dst[at]} # {f.b[at]} {f.c[at]}")
            reached.push(a)
            next
        }
        parts.push("{ir_op_name(f.op[at])} {f.dst[at]} {a} {f.b[at]} {f.c[at]}")
        if f.op[at] == .Drop && a >= 0 {
            routine: m.types[f.slot_type[a]].drop
            if ir_keyed_function(m, routine) == {
                .Val(id) -> {
                    parts.push("#")
                    reached.push(id)
                }
                .None -> parts.push(routine.copy())
            }
        }
    }
    loop arg in f.args -> parts.push("{arg}")
    text: parts.join("|")
    spread: ir_opt_fold_spread(text)
    IROptFoldShape{text: text, reached: reached, spread: spread}
}

// A cheap hash of shape text `text` that spreads shapes over the grouping
// buckets (IROptFoldGroups): its length and its last bytes, so equal texts
// spread alike.
ir_opt_fold_spread: fn(text: String) -> Int Never! {
    bytes: text.bytes()
    from: if bytes.len() > 64 -> bytes.len() - 64 else -> 0
    name_hash(bytes, from, bytes.len()) + bytes.len()
}

// Body `id` as a round of ir_opt_fold_identical compares it: its class, its
// shape's number, and the class of each function it reaches.
ir_opt_fold_key: fn(first: [Int], id: Int, shape: Int, reached: [Int]) -> String Never! {
    parts := [String]{"{first[id]}", "{shape}"}
    loop callee in reached -> parts.push("{ir_opt_fold_callee(first, callee)}")
    parts.join("|")
}

#Test("Folding finds the same copies for any thread count") {
    one := ir_opt_slot_test_wide(12, false)
    eight := ir_opt_slot_test_wide(12, false)
    // The callers of make are the same body, built by the build.
    loop id in 1..<one.functions.len() {
        one.functions[id].source_file = ""
        eight.functions[id].source_file = ""
    }
    alone := [IRFunction]{}
    compiler_transfer_rows<IRFunction>(alone, one.functions)
    shared := [IRFunction]{}
    compiler_transfer_rows<IRFunction>(shared, eight.functions)
    assert_eq(ir_opt_fold_identical(one, alone, compiler_threads_single()), 11)
    assert_eq(ir_opt_fold_identical(eight, shared, CompilerThreads{cap: Val(8), cores: 8, memory_available: None}), 11)
    assert_eq(shared.len(), alone.len())
    loop id in 0..<alone.len() {
        assert_eq(ir_function_text(eight, shared[id]), ir_function_text(one, alone[id]))
    }
}
