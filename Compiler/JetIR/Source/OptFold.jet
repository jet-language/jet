// Identical glue (O1, O2, once every body is optimized): the functions the
// build makes itself (drop, copy and unique glue, map and order helpers: no
// source file) are built per checked type, and
// rows that differ only in the type they spell (`[String: Int]`,
// `[Name: Int]`) have the same layout, so their glue comes out the same,
// instruction for instruction. Such copies become one: every direct call of
// a copy and every row whose drop or clone routine is a copy name the first
// of them instead, and the object writer keeps only what its entry reaches
// (X64Module.jet ir_x64_reached_only), so the copy leaves the image. Two
// bodies are the same when their instructions are, a routine they reach
// (a direct call, or the drop routine of a dropped slot's row) counting by
// its class, and their slots' rows are, read as layouts (ir_opt_fold_row).
// Glue reaches itself (its parameter's row drops through it) and other
// glue, so the classes start as one and split until no class holds bodies
// that differ: copies that only reach copies of each other stay one. A
// function whose address is taken keeps it.

use jet_foundation.[CompilerThreads, compiler_take_rows, compiler_threads_admit, compiler_threads_partition, compiler_threads_single, compiler_transfer_rows, name_rows_value]

// Folds the copies among `m.functions`' bodies `functions`; returns how many
// functions nothing reaches any more.
ir_opt_fold_identical: fn(m: &IRModule, functions: &[IRFunction], threads: CompilerThreads) -> Int Never! {
    count: functions.len()
    first := [Int]{}
    lowest := -1
    loop f in functions {
        candidate: ir_opt_fold_candidate(f)
        if candidate && lowest < 0 -> lowest = first.len()
        first.push(if candidate -> 0 else -> -1)
    }
    loop id in 0..<count {
        if first[id] == 0 -> first[id] = lowest
    }
    classes := if lowest < 0 -> 0 else -> 1
    // Each candidate's body is spelled once, as its shape: everything but
    // the functions it reaches, which a round reads by their class. Bodies
    // of one shape number the same.
    found := ir_opt_fold_shapes(m, functions, threads)
    shapes := [String:Int]{}
    shape_of := [Int]{}
    reached := [[Int]]{}
    loop id in 0..<count {
        if first[id] < 0 {
            shape_of.push(-1)
            reached.push([Int]{})
            next
        }
        known := shapes.get(found[id].text) ?? -1
        if known < 0 {
            known = shapes.len()
            shapes[found[id].text] = known
        }
        shape_of.push(known)
        reached.push(compiler_take_rows<Int>(found[id].reached))
    }
    loop classes > 0 {
        seen := [String:Int]{}
        split := [Int]{}
        loop id in 0..<count {
            if first[id] < 0 {
                split.push(-1)
                next
            }
            key: ir_opt_fold_key(first, id, shape_of[id], reached[id])
            known: seen.get(key) ?? -1
            if known < 0 -> seen[key] = id
            split.push(if known < 0 -> id else -> known)
        }
        first = split
        if seen.len() == classes -> break
        classes = seen.len()
    }
    folded := 0
    loop id in 0..<count {
        if first[id] >= 0 && first[id] != id -> folded += 1
    }
    if folded == 0 -> return 0
    loop id in 0..<count -> ir_opt_fold_calls(functions[id], first)
    loop row in 0..<m.types.len() {
        m.types[row].drop = ir_opt_fold_name(m, functions, m.types[row].drop, first)
        m.types[row].clone = ir_opt_fold_name(m, functions, m.types[row].clone, first)
    }
    folded
}

// Whether ir_opt_fold_identical may fold `f`: a body the build made itself.
ir_opt_fold_candidate: fn(f: IRFunction) -> Bool Never! {
    f.source_file == "" && f.asm == None && f.op.len() > 0
}

// Each body's shape (ir_opt_fold_shape; none for a body that is no
// candidate). A shape reads only its body and the module's rows, which the
// threads read lent (ir_opt_lend), so the bodies split into consecutive
// parts (compiler_threads_partition by size), one thread each, joined in
// part order: the shapes are the same for any thread count.
ir_opt_fold_shapes: fn(m: &IRModule, functions: &[IRFunction], threads: CompilerThreads) -> [IROptFoldShape] Never! {
    rows: ir_opt_fold_rows(m)
    count: functions.len()
    weights := [Int]{}
    total := 0
    loop f in functions {
        weight: if ir_opt_fold_candidate(f) -> 1 + f.op.len() else -> 1
        weights.push(weight)
        total += weight
    }
    found := [IROptFoldShape]{}
    workers: compiler_threads_admit(threads, count, total, IR_OPT_MIN_INSTRUCTIONS_PER_THREAD, 0, 0)
    if workers <= 1 {
        loop f in functions -> found.push(ir_opt_fold_shape_of(m, f, rows))
        return found
    }
    bounds: compiler_threads_partition(weights, workers)
    // Parts leave the list last-first: part `workers - 1` pops first.
    slots := [Shared<IROptFoldPart>]{}
    part := workers - 1
    loop part >= 0 {
        bodies := [IRFunction]{}
        loop functions.len() > bounds[part] {
            body: functions.pop() ?? panic("the IR optimizer lost a function to its folding")
            bodies.push(body)
        }
        bodies.reverse()
        slots.push(Shared{IROptFoldPart{functions: bodies.move(), shapes: [IROptFoldShape]{}}})
        part -= 1
    }
    slots.reverse()
    lent: ir_opt_lend(m)
    shared: Shared{IROptFoldView{views: [IRModule]{lent.move()}, rows: rows.move()}}
    _: ir_opt_fold_shapers(slots, shared, 0) ?? panic("the IR folding threads failed")
    loop slot in slots {
        held := slot.guard_edit()
        functions.extend(compiler_take_rows<IRFunction>(held.value.functions))
        found.extend(compiler_take_rows<IROptFoldShape>(held.value.shapes))
    }
    held := shared.guard_edit()
    ir_opt_lend_into(m, held.value.views[0])
    found
}

// Body `f`'s shape when it is a candidate, else an empty one.
ir_opt_fold_shape_of: fn(m: IRModule, f: IRFunction, rows: [Int]) -> IROptFoldShape Never! {
    if !ir_opt_fold_candidate(f) -> return IROptFoldShape{text: "", reached: [Int]{}}
    ir_opt_fold_shape(m, f, rows)
}

// The functions of one thread of ir_opt_fold_shapes, in order, and their
// shapes.
IROptFoldPart: struct {
    functions: [IRFunction]
    shapes: [IROptFoldShape]
}

// What every thread of ir_opt_fold_shapes reads: the module's lent rows
// (ir_opt_lend), in a list of one, and each type row's layout number.
IROptFoldView: struct {
    views: [IRModule]
    rows: [Int]
}

// Runs a shape thread per slot from `at`; returns the functions they read.
ir_opt_fold_shapers: fn(slots: [Shared<IROptFoldPart>], shared: Shared<IROptFoldView>, at: Int) -> Int {
    if at >= slots.len() -> return 0
    read := 0
    task.group ir_opt_fold_group {
        head: task ir_opt_fold_part(slots[at], shared)
        read = ir_opt_fold_shapers(slots, shared, at + 1)
        read += head.join() ?? ir_opt_prepare_stopped(err)
    }
    read
}

ir_opt_fold_part: fn(slot: Shared<IROptFoldPart>, shared: Shared<IROptFoldView>) -> Int {
    reads: shared.guard_read()
    held := slot.guard_edit()
    loop row in 0..<held.value.functions.len() -> held.value.shapes.push(ir_opt_fold_shape_of(reads.value.views[0], held.value.functions[row], reads.value.rows))
    held.value.functions.len()
}

// The key of the function a row's routine `name` names once copies are
// one; a name of no function stays.
ir_opt_fold_name: fn(m: IRModule, functions: [IRFunction], name: String, first: [Int]) -> String Never! {
    if name == "" -> return name.copy()
    id: name_rows_value(m.function_rows, name) ?? return name.copy()
    target: ir_opt_fold_callee(first, id)
    if target == id || target >= functions.len() -> return name.copy()
    functions[target].key.copy()
}

// Points each direct call of `f` at the function it reaches once copies
// are one.
ir_opt_fold_calls: fn(f: &IRFunction, first: [Int]) Never! {
    loop at in 0..<f.op.len() {
        if f.op[at] == .Call -> f.a[at] = ir_opt_fold_callee(first, f.a[at])
    }
}

// The function a direct call of `callee` reaches once copies are one.
ir_opt_fold_callee: fn(first: [Int], callee: Int) -> Int Never! {
    if callee < 0 || callee >= first.len() || first[callee] < 0 -> return callee
    first[callee]
}

// Per type row of `m`, its layout (ir_opt_fold_row) as a number: rows of
// the same layout share one.
ir_opt_fold_rows: fn(m: IRModule) -> [Int] Never! {
    layouts := [String:Int]{}
    rows := [Int]{}
    loop ty in m.types {
        layout: ir_opt_fold_row(m, ty)
        known := layouts.get(layout) ?? -1
        if known < 0 {
            known = layouts.len()
            layouts[layout] = known
        }
        rows.push(known)
    }
    rows
}

// What selection reads of a row besides a Drop's routine: its kind and
// layout, whether its values drop, and the runtime routines that drop and
// copy them, which it routes by name. Glue the module builds is called only
// by a Drop (ir_opt_fold_key) or a direct call.
ir_opt_fold_row: fn(m: IRModule, ty: IRType) -> String Never! {
    class: if ty.class == {
        .Integer -> "i"
        .Pointer -> "p"
        .Float -> "f"
        .Memory -> "m"
    }
    "{ir_kind_name(ty.kind)} {ty.size} {ty.align} {class} {ty.signed} {ty.bits} {ir_opt_fold_runtime(m, ty.drop)} {ir_opt_fold_runtime(m, ty.clone)}"
}

// A routine symbol as a row names it: a runtime routine by its name, a
// function of the module as one.
ir_opt_fold_runtime: fn(m: IRModule, symbol: String) -> String Never! {
    if name_rows_value(m.function_rows, symbol) != None -> return "#"
    symbol.copy()
}

// Body `f` as ir_opt_fold_identical compares it, apart from the functions
// it reaches: `text` spells the rest, with `#` where a direct call's callee
// or a dropped slot's routine names a function of the module, and
// `reached` lists those functions in that order.
IROptFoldShape: struct {
    text: String
    reached: [Int]
}

ir_opt_fold_shape: fn(m: IRModule, f: IRFunction, rows: [Int]) -> IROptFoldShape Never! {
    result: if f.result < 0 -> -1 else -> rows[f.result]
    parts := [String]{"{f.param_count} {result}"}
    reached := [Int]{}
    loop slot in 0..<f.slot_type.len() {
        kind: if f.slot_kind[slot] == {
            .Param -> "p"
            .Local -> "l"
            .Temp -> "t"
        }
        parts.push("{kind}{rows[f.slot_type[slot]]}")
    }
    loop at in 0..<f.op.len() {
        a: f.a[at]
        if f.op[at] == .Call {
            parts.push("{ir_op_name(f.op[at])} {f.dst[at]} # {f.b[at]} {f.c[at]}")
            reached.push(a)
            next
        }
        parts.push("{ir_op_name(f.op[at])} {f.dst[at]} {a} {f.b[at]} {f.c[at]}")
        if f.op[at] == .Drop && a >= 0 {
            routine: m.types[f.slot_type[a]].drop
            if name_rows_value(m.function_rows, routine) == {
                .Val(id) -> {
                    parts.push("#")
                    reached.push(id)
                }
                .None -> parts.push(routine.copy())
            }
        }
    }
    loop arg in f.args -> parts.push("{arg}")
    IROptFoldShape{text: parts.join("|"), reached}
}

// Body `id` as a round of ir_opt_fold_identical compares it: its class, its
// shape's number, and the class of each function it reaches.
ir_opt_fold_key: fn(first: [Int], id: Int, shape: Int, reached: [Int]) -> String Never! {
    parts := [String]{"{first[id]}", "{shape}"}
    loop callee in reached -> parts.push("{ir_opt_fold_callee(first, callee)}")
    parts.join("|")
}

#Test("Folding finds the same copies for any thread count") {
    one := ir_opt_slot_test_wide(12, false)
    eight := ir_opt_slot_test_wide(12, false)
    // The callers of make are the same body, built by the build.
    loop id in 1..<one.functions.len() {
        one.functions[id].source_file = ""
        eight.functions[id].source_file = ""
    }
    alone := [IRFunction]{}
    compiler_transfer_rows<IRFunction>(alone, one.functions)
    shared := [IRFunction]{}
    compiler_transfer_rows<IRFunction>(shared, eight.functions)
    assert_eq(ir_opt_fold_identical(one, alone, compiler_threads_single()), 11)
    assert_eq(ir_opt_fold_identical(eight, shared, CompilerThreads{cap: Val(8), cores: 8, memory_available: None}), 11)
    assert_eq(shared.len(), alone.len())
    loop id in 0..<alone.len() -> assert_eq(ir_function_text(eight, shared[id]), ir_function_text(one, alone[id]))
}
