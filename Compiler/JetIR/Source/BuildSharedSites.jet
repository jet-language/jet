// Core-only Shared sites (Docs/spec/stdlib-api-laws.md "Internal Core Shared
// publication"): `core.mem.__process_shared(init)` and its World, Thread and
// Attempt forms (NodeKind.GlobalShared). Each initializer has one zeroed
// writable static word, its site, which built parts share by its key
// (m.constant_rows). A Process or World site holds the published owner: the
// read is a Load of it, and a reader that finds it empty runs the initializer
// and publishes through jet_rt_shared_site_publish, which keeps the first
// owner, drops a racing loser's candidate and registers a World site for the
// quiescent world reset. A Thread or Attempt site holds its TLS key
// (jet_rt_tls_shared_key; scope 0 retires at thread exit, scope 1 at the
// attempt reset as well), and the owner lives in this thread's slot of that
// key, whose destructor releases it. Every read returns an owning clone.

use jet_foundation.[DeclID, SharedLifetime, Span, TConstantDef, Type, name_rows_set, name_rows_value]

IR_SHARED_SITE_BYTES: 8

ir_shared_site: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, ty: Type, initializer: DeclID, lifetime: SharedLifetime, span: Span) -> Int Never! {
    row: ir_decl_row(p, initializer)
    if row < 0 -> return ir_fail_slot(b, span, "Shared site initializer outside the checked program (declaration row {initializer.row.index()})")
    shared_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    site: ir_shared_site_word(m, b, p.functions[row].key)
    word_row: ir_word_row(m)
    zero: ir_word_const(m, b, 0)
    if lifetime == .Process || lifetime == .World {
        current: ir_load_at(m, b, site, 0, word_row)
        empty: ir_bool_op(m, b, IROp.Eq, current, zero)
        ir_open_if(b.f, empty, b.line)
        candidate: ir_call_row_values(m, p, b, row, [Int]{}, span)
        if ir_failed(b) -> return -1
        world: ir_word_const(m, b, if lifetime == .World -> 1 else -> 0)
        _: ir_runtime(m, b, "jet_rt_shared_site_publish", [Int]{site, candidate, world}, word_row)
        b.fresh[candidate] = false
        ir_end(b.f, b.line)
        owner: ir_load_at(m, b, site, 0, shared_row)
        return ir_clone(m, b, owner, shared_row)
    }
    scope: ir_word_const(m, b, if lifetime == .Attempt -> 1 else -> 0)
    key: ir_runtime(m, b, "jet_rt_tls_shared_key", [Int]{site, scope}, word_row)
    current: ir_runtime(m, b, "jet_rt_tls_get", [Int]{key}, word_row)
    empty: ir_bool_op(m, b, IROp.Eq, current, zero)
    ir_open_if(b.f, empty, b.line)
    candidate: ir_call_row_values(m, p, b, row, [Int]{}, span)
    if ir_failed(b) -> return -1
    _: ir_runtime(m, b, "jet_rt_tls_set", [Int]{key, candidate}, -1)
    b.fresh[candidate] = false
    ir_end(b.f, b.line)
    // The thread's slot keeps owning the value; the read borrows it.
    owner: ir_runtime(m, b, "jet_rt_tls_get", [Int]{key}, shared_row)
    b.fresh[owner] = false
    ir_clone(m, b, owner, shared_row)
}

// A read of module `Shared{X}` holder `definition` (TConstantDef.shared_holder),
// a Process site keyed by the constant: a reader that finds the site empty
// puts a copy of the payload the build folded into a new cell and publishes
// it; every read returns an owning clone of the published cell.
ir_shared_holder_read: fn(m: &IRModule, p: IRProgram, b: &IRBuilder, definition: TConstantDef, span: Span) -> Int Never! {
    inner: if ir_untag(definition.ty) == .Shared(value) -> value else -> { return ir_fail_slot(b, span, "shared holder {definition.name} of {ir_type_name(definition.ty)}") }
    shared_row: ir_value_type(m, p, definition.ty) ?? return ir_type_fail(b, span, definition.ty)
    site: ir_shared_site_word(m, b, "holder:{definition.key}")
    word_row: ir_word_row(m)
    zero: ir_word_const(m, b, 0)
    current: ir_load_at(m, b, site, 0, word_row)
    empty: ir_bool_op(m, b, IROp.Eq, current, zero)
    ir_open_if(b.f, empty, b.line)
    static_payload: ir_static_read(m, p, b, inner, "{definition.key}#payload", definition.value)
    payload: if static_payload >= 0 -> static_payload else -> ir_comptime(m, p, b, inner, definition.value, span)
    if ir_failed(b) -> return -1
    candidate: ir_shared_new(m, p, b, [Int]{payload}, definition.ty, span)
    if ir_failed(b) -> return -1
    process: ir_word_const(m, b, 0)
    _: ir_runtime(m, b, "jet_rt_shared_site_publish", [Int]{site, candidate, process}, word_row)
    b.fresh[candidate] = false
    ir_end(b.f, b.line)
    owner: ir_load_at(m, b, site, 0, shared_row)
    ir_clone(m, b, owner, shared_row)
}

// The slot holding the address of the site word of the initializer keyed
// `key`.
ir_shared_site_word: fn(m: &IRModule, b: &IRBuilder, key: String) -> Int Never! {
    object_key: "shared-site:{key}"
    object := name_rows_value(m.constant_rows, object_key) ?? -1
    if object < 0 {
        object = m.data.len()
        word := [U8]{}
        loop _ in 0..<IR_SHARED_SITE_BYTES -> word.push(U8{0})
        m.data.push(word)
        // No address words; the entry marks a word-aligned static object.
        m.data_relocs[object] = [IRDataReloc]{}
        name_rows_set(m.constant_rows, object_key, object)
    }
    pointer_row: ir_pointer_row(m)
    address: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.DataAddress, address, object, -1, -1, b.line)
    address
}
