// Core-only Shared sites (Docs/Spec/stdlib-api-laws.md "Internal Core Shared
// publication"): `core.mem.__process_shared(init)` and its World, Thread and
// Attempt forms (NodeKind.GlobalShared). Each initializer has one zeroed
// writable static word, its site, which built parts share by its key
// (m.constant_rows). A Process or World site holds the published owner: the
// read is a Load of it, and a reader that finds it empty runs the initializer
// and publishes through jet_rt_shared_site_publish, which keeps the first
// owner, drops a racing loser's candidate and registers a World site for the
// quiescent world reset. A Thread or Attempt site holds its TLS key
// (jet_rt_tls_shared_key; scope 0 retires at thread exit, scope 1 at the
// attempt reset as well), and the owner lives in this thread's slot of that
// key, whose destructor releases it. Every read returns an owning clone. A
// site's owner outlives any `#Context(allocator:)` block, so its candidate is
// built in the program heap, its destination's allocator (jet_rt_move_enter
// of 0 and jet_rt_move_leave).
use jet_foundation.[DeclID, SharedLifetime, Span, TConstantDef, Type, name_column_set, name_column_value]

IR_SHARED_SITE_BYTES: 8

ir_shared_site: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, ty: Type, initializer: DeclID, lifetime: SharedLifetime, span: Span) -> Int Never! {
    row: ir_decl_row(p, initializer)
    if row < 0 {
        return ir_fail_slot(b, span, "Shared site initializer outside the checked program (declaration row {initializer.row.index()})")
    }
    shared_row: ir_value_type(m, p, ty) ?? return ir_type_fail(b, span, ty)
    site: ir_shared_site_word(m, b, p.functions[row].key)
    word_row: ir_word_row(m)
    zero: ir_word_const(m, b, 0)
    if lifetime == .Process || lifetime == .World {
        current: ir_load_at(m, b, site, 0, word_row)
        empty: ir_bool_op(m, b, IROp.Eq, current, zero)
        ir_open_if(b.f, empty, b.line)
        held: ir_runtime(m, b, "jet_rt_move_enter", [Int]{zero}, word_row)
        candidate: ir_call_row_values(m, p, b, row, [Int]{}, span)
        if ir_failed(b) -> return -1
        _: ir_runtime(m, b, "jet_rt_move_leave", [Int]{held}, -1)
        world: ir_word_const(m, b, if lifetime == .World -> 1 else -> 0)
        _: ir_runtime(m, b, "jet_rt_shared_site_publish", [Int]{site, candidate, world}, word_row)
        b.fresh[candidate] = false
        ir_end(b.f, b.line)
        owner: ir_load_at(m, b, site, 0, shared_row)
        return ir_clone(m, b, owner, shared_row)
    }
    scope: ir_word_const(m, b, if lifetime == .Attempt -> 1 else -> 0)
    key: ir_runtime(m, b, "jet_rt_tls_shared_key", [Int]{site, scope}, word_row)
    current: ir_runtime(m, b, "jet_rt_tls_get", [Int]{key}, word_row)
    empty: ir_bool_op(m, b, IROp.Eq, current, zero)
    ir_open_if(b.f, empty, b.line)
    held: ir_runtime(m, b, "jet_rt_move_enter", [Int]{zero}, word_row)
    candidate: ir_call_row_values(m, p, b, row, [Int]{}, span)
    if ir_failed(b) -> return -1
    _: ir_runtime(m, b, "jet_rt_move_leave", [Int]{held}, -1)
    _: ir_runtime(m, b, "jet_rt_tls_set", [Int]{key, candidate}, -1)
    b.fresh[candidate] = false
    ir_end(b.f, b.line)
    // The thread's slot keeps owning the value; the read borrows it.
    owner: ir_runtime(m, b, "jet_rt_tls_get", [Int]{key}, shared_row)
    b.fresh[owner] = false
    ir_clone(m, b, owner, shared_row)
}

// A read of module `Shared{X}` holder `definition` (TConstantDef.shared_holder),
// a Process site keyed by the constant: a reader that finds the site empty
// puts a copy of the payload the build folded into a new cell and publishes
// it; every read returns an owning clone of the published cell.
ir_shared_holder_read: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, definition: TConstantDef, span: Span) -> Int Never! {
    inner: if ir_untag(definition.ty) == .Shared(value) -> value else -> {
        return ir_fail_slot(b, span, "shared holder {definition.name} of {ir_type_name(definition.ty)}")
    }
    shared_row: ir_value_type(m, p, definition.ty) ?? return ir_type_fail(b, span, definition.ty)
    site: ir_shared_site_word(m, b, "holder:{definition.key}")
    word_row: ir_word_row(m)
    zero: ir_word_const(m, b, 0)
    current: ir_load_at(m, b, site, 0, word_row)
    empty: ir_bool_op(m, b, IROp.Eq, current, zero)
    ir_open_if(b.f, empty, b.line)
    held: ir_runtime(m, b, "jet_rt_move_enter", [Int]{zero}, word_row)
    static_payload: ir_static_read(m, p, b, inner, "{definition.key}#payload", definition.value)
    payload: if static_payload >= 0 -> static_payload else -> ir_comptime(m, p, b, inner, definition.value, span)
    if ir_failed(b) -> return -1
    candidate: ir_shared_new(m, p, b, [Int]{payload}, definition.ty, span)
    if ir_failed(b) -> return -1
    _: ir_runtime(m, b, "jet_rt_move_leave", [Int]{held}, -1)
    lifetime: ir_word_const(m, b, if m.test_reset -> 1 else -> 0)
    _: ir_runtime(m, b, "jet_rt_shared_site_publish", [Int]{site, candidate, lifetime}, word_row)
    b.fresh[candidate] = false
    ir_end(b.f, b.line)
    owner: ir_load_at(m, b, site, 0, shared_row)
    ir_clone(m, b, owner, shared_row)
}

// A read of a constant its compile-time program computes by calling item
// function `item` (keyed `item_key`, TConstantDef.item_function): a Process
// site keyed by that function holds the cell of the value its first reader
// computed, and every read borrows that value in place. A batch's items run
// one after another in one child, so each constant the batch computes runs
// once for every read of it in the batch, not once per read. The published
// cell is never edited and lives as long as the loaded batch, so its value
// is read without a permit. A value no cell keeps (Unit, a value with no
// clone glue, a pointer Option, or one holding a compiler value, which the
// call's host holds only for that call) is computed by each read.
ir_computed_constant_read: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, item_key: String, item: Int, span: Span) -> Int Never! {
    inner: p.functions[item].ret ?? return ir_call_row_values(m, p, b, item, [Int]{}, span)
    if ir_unit_type(inner) || ir_never_type(inner) || ir_host_value_held(p, inner) || !ir_lazy_type_can_clone(m, p, inner) {
        return ir_call_row_values(m, p, b, item, [Int]{}, span)
    }
    row: ir_value_type(m, p, inner) ?? return ir_type_fail(b, span, inner)
    if m.types[row].kind == .Unit || m.types[row].option_null {
        return ir_call_row_values(m, p, b, item, [Int]{}, span)
    }
    site: ir_shared_site_word(m, b, "computed:{item_key}")
    held: ir_process_cell_open(m, b, site)
    value: ir_call_row_values(m, p, b, item, [Int]{}, span)
    if ir_failed(b) -> return -1
    ir_process_cell_read(m, p, b, site, held, value, inner, row, false, span)
}

// A read of declared point `definition` (`clicked: event.point<Int>()`, an
// Event, Hook or DecisionHook constant whose landed value is its
// construction option, sema_comptime_module_point): a Process site keyed by
// the constant holds the cell of the carrier its first reader made, and
// every read borrows that carrier in place, so every reader shares its
// listeners. In a test build the cell resets between tests so listeners do
// not leak from one test to the next.
ir_point_holder_read: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, definition: TConstantDef, span: Span) -[]> Int {
    row: ir_value_type(m, p, definition.ty) ?? return ir_type_fail(b, span, definition.ty)
    site: ir_shared_site_word(m, b, "point:{definition.key}")
    held: ir_process_cell_open(m, b, site)
    point: ir_point_new(m, p, b, definition, span)
    if ir_failed(b) -> return -1
    ir_process_cell_read(m, p, b, site, held, point, definition.ty, row, m.test_reset, span)
}

// Opens the first reader's branch of Process cell site `site`, taken while
// the site is empty, which builds the cell's value in the program heap: the
// value outlives any `#Context(allocator:)` block. Gives the heap mark
// ir_process_cell_read restores.
ir_process_cell_open: fn(m: ^IRModule, b: ^IRBuilder, site: Int) -> Int Never! {
    word_row: ir_word_row(m)
    zero: ir_word_const(m, b, 0)
    current: ir_load_at(m, b, site, 0, word_row)
    empty: ir_bool_op(m, b, IROp.Eq, current, zero)
    ir_open_if(b.f, empty, b.line)
    ir_runtime(m, b, "jet_rt_move_enter", [Int]{zero}, word_row)
}

// Closes the branch ir_process_cell_open opened (`held` its heap mark) by
// publishing `value`, of type `inner` and row `row`, in a new cell, the
// first reader's cell standing, and borrows the published cell's value in
// place. The published cell is never edited, so its value is read without
// a permit.
ir_process_cell_read: fn(m: ^IRModule, p: IRProgram, b: ^IRBuilder, site: Int, held: Int, value: Int, inner: Type, row: Int, world_reset: Bool, span: Span) -> Int Never! {
    candidate: ir_shared_new(m, p, b, [Int]{value}, Type.Shared{inner: inner}, span)
    if ir_failed(b) -> return -1
    _: ir_runtime(m, b, "jet_rt_move_leave", [Int]{held}, -1)
    word_row: ir_word_row(m)
    pointer_row: ir_pointer_row(m)
    lifetime: ir_word_const(m, b, if world_reset -> 1 else -> 0)
    _: ir_runtime(m, b, "jet_rt_shared_site_publish", [Int]{site, candidate, lifetime}, word_row)
    b.fresh[candidate] = false
    ir_end(b.f, b.line)
    owner: ir_load_at(m, b, site, 0, pointer_row)
    payload: ir_runtime(m, b, "jet_rt_native_shared_guard_payload", [Int]{owner}, pointer_row)
    b.fresh[payload] = false
    ir_load_at(m, b, payload, 0, row)
}

// The static data row index of the site word keyed `key`.
ir_shared_site_object: fn(m: ^IRModule, key: String) -> Int Never! {
    object_key: "shared-site:{key}"
    ^object: name_column_value(m.constant_rows_keys, m.constant_rows, object_key) ?? -1
    if object < 0 {
        object = m.data.len()
        ^word: [U8]{}
        loop _ in 0..<IR_SHARED_SITE_BYTES -> word.push(U8{0})
        m.data.push(word)
        // No address words; the entry marks a word-aligned static object.
        m.data_relocs[object] = [IRDataReloc]{}
        name_column_set(m.constant_rows_keys, m.constant_rows, object_key, object)
    }
    object
}

// The slot holding the address of the site word of the initializer keyed
// `key`.
ir_shared_site_word: fn(m: ^IRModule, b: ^IRBuilder, key: String) -> Int Never! {
    object: ir_shared_site_object(m, key)
    pointer_row: ir_pointer_row(m)
    address: ir_temp(m, b, pointer_row)
    ir_emit(b.f, IROp.DataAddress, address, object, -1, -1, b.line)
    address
}
