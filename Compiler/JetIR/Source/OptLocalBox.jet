// Local boxes (O1, O2, pass "localbox", after Simplify, which runs again
// when a box moved, and before scalar replacement): a small fresh box
// (`jet_rt_alloc(size, 8)`, size at most 64) that never leaves its function
// becomes frame storage (StackAddress), such as the Result box an inlined
// `route() ?? return` builds around each call of a runtime route. The box
// never leaves when its slot is written only by the allocation and every
// read of it is one of:
//
// - the base of a Load or of a Store (of another slot) of at most 8 bytes
//   inside the box, or the source or destination of a CopyBytes inside it;
// - the base of an Offset inside the box (a field's address, such as the
//   payload a `?? return` moves out with one CopyBytes), when the Offset's
//   own slot is read only as such a Load, Store or CopyBytes base, inside
//   the box;
// - the unique test (`jet_rt_block_unique`) or the release
//   (`jet_rt_block_release`): frame storage has no other owner, so both
//   become 1 and the code they guard runs as it does for the last owner;
// - the first argument of its `jet_rt_free`, which goes;
// - a Drop, when nothing stored in the box has a Drop (its drop routine
//   then only frees the box), which goes;
// - an Eq or Ne against a constant 0 (the null test of an Option's None):
//   an address is never null, so it becomes that constant;
// - anything in the Else of an If on the box's unique test: a box nothing
//   else reaches is always unique, so that arm (the shared owner's release
//   and its last-owner routine) never runs, on the heap or in the frame.
//
// Any other read (a Move, a Store of the box itself, a Return, a call
// argument, any other use of a field's address) keeps the heap box: the
// box could outlive the frame or reach code that reads its block header. A
// box made inside a Loop gets the same storage each round; only the box's
// own slot and its fields' addresses hold it, and the round's allocation
// and Offsets rewrite those slots, so no two rounds' boxes are ever
// reachable together. The heap's payload is not zeroed either, so a Load
// before any Store reads unknown bytes in both forms. Scalar replacement
// (OptScalar.jet) then puts the storage's fields in registers.

use jet_foundation.[Type, compiler_threads_single, name_rows_set, name_rows_value]

// Turns each local box of `f` into frame storage; returns how many.
fn ir_opt_local_boxes(m: IRModule, f: &IRFunction) -> Int Never! {
    alloc :: name_rows_value(m.name_rows, "jet_rt_alloc") ?? return 0
    unique :: name_rows_value(m.name_rows, "jet_rt_block_unique") ?? -2
    release :: name_rows_value(m.name_rows, "jet_rt_block_release") ?? -2
    free :: name_rows_value(m.name_rows, "jet_rt_free") ?? -2
    if f.asm != None || f.op.len() == 0 -> return 0
    facts :: ir_opt_facts(f)
    count :: f.slot_type.len()
    // Each candidate slot's box size (-1: not a local box).
    size := [Int]{}
    loop _ in 0..<count -> &size.push(-1)
    loop at in 0..<f.op.len() {
        if f.op[at] != .CallRuntime || f.a[at] != alloc || f.c[at] != 2 || f.dst[at] < f.param_count -> next
        boxed :: f.dst[at]
        if facts.defs[boxed] != 1 -> next
        bytes :: ir_opt_const_at(f, facts, f.args[f.b[at]], at) ?? -1
        align :: ir_opt_const_at(f, facts, f.args[f.b[at] + 1], at) ?? -1
        if bytes >= 8 && bytes <= 64 && align == 8 -> size[boxed] = bytes
    }
    // Until no candidate drops out: an Else arm is dead only while its box
    // stays a candidate, and the reads in it then count again.
    reads := [Int]{}
    changed := true
    loop changed {
        changed = false
        // The Else arms of the Ifs on a candidate's unique test.
        dead := [Bool]{}
        loop _ in 0..<f.op.len() -> &dead.push(false)
        loop at in 0..<f.op.len() {
            if f.op[at] != .If || f.b[at] < 0 || f.a[at] < 0 || facts.defs[f.a[at]] != 1 -> next
            test :: facts.def_at[f.a[at]]
            if test < 0 || f.op[test] != .CallRuntime || f.a[test] != unique || f.c[test] != 1 || size[f.args[f.b[test]]] < 0 -> next
            loop k in (f.b[at] + 1)..<f.c[at] -> dead[k] = true
        }
        // Each Offset inside a candidate: its slot is that field's address
        // (`base` the box, `shift` the field's place in it).
        base := [Int]{}
        shift := [Int]{}
        loop _ in 0..<count {
            &base.push(-1)
            &shift.push(0)
        }
        loop at in 0..<f.op.len() {
            if dead[at] || f.op[at] != .Offset || f.dst[at] < f.param_count || f.a[at] < 0 || size[f.a[at]] < 0 || facts.defs[f.dst[at]] != 1 -> next
            if f.b[at] >= 0 && f.b[at] < size[f.a[at]] {
                base[f.dst[at]] = f.a[at]
                shift[f.dst[at]] = f.b[at]
            }
        }
        // A Drop of a box is its drop routine; it only frees the box when
        // nothing stored in it has a Drop (bytes a CopyBytes brings in may).
        dropped := [Bool]{}
        stored_drop := [Bool]{}
        loop _ in 0..<count {
            &dropped.push(false)
            &stored_drop.push(false)
        }
        loop at in 0..<f.op.len() {
            op :: f.op[at]
            if dead[at] -> next
            if op == .Store && f.a[at] >= 0 && f.c[at] >= 0 && m.types[f.slot_type[f.c[at]]].drop != "" -> stored_drop[ir_opt_local_box_of(base, f.a[at])] = true
            if op == .CopyBytes && f.a[at] >= 0 -> stored_drop[ir_opt_local_box_of(base, f.a[at])] = true
            ir_x64_reads_into(f, at, &reads)
            loop slot in reads {
                if slot < 0 || slot >= count -> next
                boxed :: ir_opt_local_box_of(base, slot)
                if size[boxed] < 0 -> next
                if op == .Drop && boxed == slot {
                    dropped[slot] = true
                } else if !ir_opt_local_box_read(m, f, facts, at, slot, boxed, shift[slot], size[boxed], base, unique, release, free) {
                    size[boxed] = -1
                    changed = true
                }
            }
        }
        loop slot in 0..<count {
            if size[slot] >= 0 && dropped[slot] && stored_drop[slot] {
                size[slot] = -1
                changed = true
            }
        }
    }
    made := 0
    loop slot in 0..<count {
        if size[slot] >= 0 -> made += 1
    }
    if made == 0 -> return 0
    loop at in 0..<f.op.len() {
        op :: f.op[at]
        if op == .CallRuntime && f.a[at] == alloc && f.dst[at] >= 0 && size[f.dst[at]] >= 0 {
            f.op[at] = .StackAddress
            f.a[at] = size[f.dst[at]]
            f.b[at] = 8
            f.c[at] = -1
        } else if op == .CallRuntime && f.c[at] >= 1 && size[f.args[f.b[at]]] >= 0 {
            if f.a[at] == free || f.dst[at] < 0 {
                ir_opt_kill(&f, at)
            } else {
                // The unique test or the release: the only owner.
                f.op[at] = .Const
                f.a[at] = 1
                f.b[at] = -1
                f.c[at] = -1
            }
        } else if op == .Drop && f.a[at] >= 0 && size[f.a[at]] >= 0 {
            ir_opt_kill(&f, at)
        } else if (op == .Eq || op == .Ne) && ((f.a[at] >= 0 && size[f.a[at]] >= 0) || (f.b[at] >= 0 && size[f.b[at]] >= 0)) {
            f.op[at] = .Const
            f.a[at] = if op == .Ne -> 1 else -> 0
            f.b[at] = -1
            f.c[at] = -1
        }
    }
    ir_opt_compact(&f)
    made
}

// The box whose storage `slot` addresses: the box itself, or the box an
// Offset inside it took (`base`); `slot` when it is neither.
fn ir_opt_local_box_of(base: [Int], slot: Int) -> Int Never! {
    if slot >= 0 && slot < base.len() && base[slot] >= 0 -> return base[slot]
    slot
}

// Whether instruction `at` of `f` reads `read`, the box `boxed` (of `bytes`
// bytes) or the address `shift` bytes into it, only as a local box may be
// read (Drops are counted apart).
fn ir_opt_local_box_read(m: IRModule, f: IRFunction, facts: OptFacts, at: Int, read: Int, boxed: Int, shift: Int, bytes: Int, base: [Int], unique: Int, release: Int, free: Int) -> Bool Never! {
    op :: f.op[at]
    if op == .Load {
        width :: m.types[f.slot_type[f.dst[at]]].size
        return f.a[at] == read && f.b[at] >= 0 && width >= 1 && width <= 8 && shift + f.b[at] + width <= bytes
    }
    if op == .Store {
        if f.a[at] != read || f.c[at] == read || f.c[at] < 0 -> return false
        width :: m.types[f.slot_type[f.c[at]]].size
        return f.b[at] >= 0 && width >= 1 && width <= 8 && shift + f.b[at] + width <= bytes
    }
    if op == .CopyBytes -> return f.c[at] >= 0 && shift + f.c[at] <= bytes
    // The field's address itself: its reads are checked as its own.
    if op == .Offset -> return read == boxed && f.dst[at] >= 0 && base[f.dst[at]] == boxed
    if read != boxed -> return false
    if op == .CallRuntime {
        first :: f.args[f.b[at]]
        if (f.a[at] == unique || f.a[at] == release) -> return f.c[at] == 1
        if f.a[at] == free -> return f.c[at] == 3 && first == boxed && f.args[f.b[at] + 1] != boxed && f.args[f.b[at] + 2] != boxed
        return false
    }
    if op == .Eq || op == .Ne {
        other :: if f.a[at] == boxed -> f.b[at] else -> f.a[at]
        return other != boxed && (ir_opt_const_at(f, facts, other, at) ?? -1) == 0
    }
    false
}

// run() boxes a tag and 3 (jet_rt_alloc(16, 8), two Stores), tests the box
// against null, reads both words and ends the box (its unique test, free
// and Drop). With `moved`, the second word is read the way a move out of a
// box reads its payload: by its address (an Offset), one CopyBytes into
// frame storage and a Load there. With `escape`, the box's own address
// (with `moved`, the second word's address) is stored, so it outlives the
// reads.
fn ir_opt_local_box_test_module(escape: Bool, moved: Bool) -> IRModule Never! {
    m := ir_module_new()
    word :: ir_type_row(&m, Type.IntN{signed: true, bits: 64}) ?? panic("no I64 row")
    flag :: ir_type_row(&m, Type.Bool) ?? panic("no Bool row")
    res :: ir_intern_type(&m, "Res", ir_layout(IRTypeKind.Pointer, Type.Named{name: "Res"}, 8, 8, IRClass.Pointer, false, 64, ""))
    boxed :: ir_mark_box(&m, res)
    alloc :: ir_intern_name(&m, "jet_rt_alloc")
    unique :: ir_intern_name(&m, "jet_rt_block_unique")
    free :: ir_intern_name(&m, "jet_rt_free")
    run := ir_function_new("run", "test:box.jet::run", "", "box.jet", 1)
    run.result = word
    size :: ir_slot(&run, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&run, IROp.Const, size, 16, -1, -1, 2)
    align :: ir_slot(&run, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&run, IROp.Const, align, 8, -1, -1, 2)
    box :: ir_slot(&run, boxed, IRSlotKind.Temp, -1, 0)
    sized :: ir_args(&run, [Int]{size, align})
    _ := ir_emit(&run, IROp.CallRuntime, box, alloc, sized, 2, 2)
    marked :: ir_slot(&run, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&run, IROp.Const, marked, 1, -1, -1, 3)
    _ := ir_emit(&run, IROp.Store, -1, box, 0, marked, 3)
    three :: ir_slot(&run, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&run, IROp.Const, three, 3, -1, -1, 3)
    _ := ir_emit(&run, IROp.Store, -1, box, 8, three, 3)
    zero :: ir_slot(&run, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&run, IROp.Const, zero, 0, -1, -1, 4)
    present :: ir_slot(&run, flag, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&run, IROp.Ne, present, box, zero, -1, 4)
    _ := ir_emit(&run, IROp.If, -1, present, -1, -1, 4)
    _ := ir_emit(&run, IROp.Else, -1, -1, -1, -1, 4)
    _ := ir_emit(&run, IROp.Unreachable, -1, -1, -1, -1, 4)
    _ := ir_emit(&run, IROp.End, -1, -1, -1, -1, 4)
    if escape && !moved -> _ := ir_emit(&run, IROp.Store, -1, box, 8, box, 5)
    first :: ir_slot(&run, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&run, IROp.Load, first, box, 0, -1, 5)
    second :: ir_slot(&run, word, IRSlotKind.Temp, -1, 0)
    if moved {
        field :: ir_slot(&run, res, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&run, IROp.Offset, field, box, 8, -1, 5)
        frame :: ir_slot(&run, res, IRSlotKind.Temp, -1, 0)
        _ := ir_emit(&run, IROp.StackAddress, frame, 16, 8, -1, 5)
        _ := ir_emit(&run, IROp.CopyBytes, -1, frame, field, 8, 5)
        if escape -> _ := ir_emit(&run, IROp.Store, -1, frame, 8, field, 5)
        _ := ir_emit(&run, IROp.Load, second, frame, 0, -1, 5)
    } else {
        _ := ir_emit(&run, IROp.Load, second, box, 8, -1, 5)
    }
    alone :: ir_slot(&run, flag, IRSlotKind.Temp, -1, 0)
    tested :: ir_args(&run, [Int]{box})
    _ := ir_emit(&run, IROp.CallRuntime, alone, unique, tested, 1, 6)
    _ := ir_emit(&run, IROp.If, -1, alone, -1, -1, 6)
    bytes :: ir_slot(&run, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&run, IROp.Const, bytes, 16, -1, -1, 6)
    eight :: ir_slot(&run, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&run, IROp.Const, eight, 8, -1, -1, 6)
    freed :: ir_args(&run, [Int]{box, bytes, eight})
    _ := ir_emit(&run, IROp.CallRuntime, -1, free, freed, 3, 6)
    _ := ir_emit(&run, IROp.Else, -1, -1, -1, -1, 6)
    _ := ir_emit(&run, IROp.Drop, -1, box, -1, -1, 6)
    _ := ir_emit(&run, IROp.End, -1, -1, -1, -1, 6)
    sum :: ir_slot(&run, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(&run, IROp.Add, sum, first, second, IR_OVERFLOW_WRAP, 7)
    _ := ir_emit(&run, IROp.Return, -1, sum, -1, -1, 7)
    ir_opt_compact(&run)
    m.entry = 0
    name_rows_set(&m.function_rows, run.key, 0)
    &m.functions.push(run)
    m
}

#Test("A small box that never leaves its function lives in its frame, then in registers") {
    loop level in 1..<3 {
        m := ir_opt_local_box_test_module(false, false)
        options := ir_opt_options(level)
        options.inline = IROptInline.Off
        options.verify = true
        report :: ir_optimize_module(&m, options, compiler_threads_single())
        assert_eq(report.lint.len(), 0)
        assert_eq(ir_opt_slot_test_calls(m, "jet_rt_alloc"), 0)
        assert_eq(ir_opt_slot_test_calls(m, "jet_rt_free"), 0)
        assert_eq(ir_opt_slot_test_calls(m, "jet_rt_block_unique"), 0)
        loop at in 0..<m.functions[0].op.len() {
            op :: m.functions[0].op[at]
            // Scalar replacement took the storage's two words.
            assert(op != .Drop && op != .Load && op != .Store)
        }
    }
}

#Test("A box whose field is copied out by address lives in its frame") {
    loop level in 1..<3 {
        m := ir_opt_local_box_test_module(false, true)
        options := ir_opt_options(level)
        options.inline = IROptInline.Off
        options.verify = true
        report :: ir_optimize_module(&m, options, compiler_threads_single())
        assert_eq(report.lint.len(), 0)
        assert_eq(ir_opt_slot_test_calls(m, "jet_rt_alloc"), 0)
        assert_eq(ir_opt_slot_test_calls(m, "jet_rt_free"), 0)
        assert_eq(ir_opt_slot_test_calls(m, "jet_rt_block_unique"), 0)
    }
}

#Test("A box whose address or a field's address is stored keeps its heap block") {
    loop round in 0..<2 {
        m := ir_opt_local_box_test_module(true, round == 1)
        options := ir_opt_options(1)
        options.inline = IROptInline.Off
        options.verify = true
        report :: ir_optimize_module(&m, options, compiler_threads_single())
        assert_eq(report.lint.len(), 0)
        assert_eq(ir_opt_slot_test_calls(m, "jet_rt_alloc"), 1)
        assert_eq(ir_opt_slot_test_calls(m, "jet_rt_free"), 1)
    }
}
