IR_NATIVE_PROVIDER_HANDLE_KEYS :: prep { [String]{
    "<corelib>/core.process::ProcessStderrStream",
    "<corelib>/core.process::ProcessStdin",
    "<corelib>/core.process::ProcessStdoutStream",
    "ProcessStderrStream",
    "ProcessStdin",
    "ProcessStdoutStream",
} }
IR_NATIVE_PROVIDER_HANDLE_KEY_ROWS :: prep { [Int]{
    4,
    2,
    0,
    5,
    3,
    1,
} }

fn ir_runtime_handle(name: String) -> IRRuntimeHandle? {
    if ir_key_row(IR_RUNTIME_HANDLE_KEYS, IR_RUNTIME_HANDLE_KEY_ROWS, name) == .Val(position) {
        // copy: the caller gets an owned handle row, while the row stays in the global
        // IR_RUNTIME_HANDLES table, which can't be moved from.
        return Val(IR_RUNTIME_HANDLES[position].copy())
    }
    // Existing Rust rows win in seed mode; absent nominals may use a provider.
    position :: ir_key_row(IR_NATIVE_PROVIDER_HANDLE_KEYS, IR_NATIVE_PROVIDER_HANDLE_KEY_ROWS, name) ?? return None
    // copy: the caller gets an owned handle row, while the row stays in the global
    // IR_NATIVE_PROVIDER_HANDLES table, which can't be moved from.
    Val(IR_NATIVE_PROVIDER_HANDLES[position].copy())
}

