ir_runtime_route_keys: fn() -> [String] Never! {
    loop route in IR_RUNTIME_ROUTES -> route.symbol.copy() // copy: the global route table can't be moved from
}

IR_RUNTIME_ROUTE_KEY_ROWS: #run ir_key_index(ir_runtime_route_keys())
IR_RUNTIME_ROUTE_KEYS: #run ir_key_index_keys(ir_runtime_route_keys(), IR_RUNTIME_ROUTE_KEY_ROWS)

ir_runtime_route: fn(symbol: String) -> IRRoute? {
    position: ir_key_row(IR_RUNTIME_ROUTE_KEYS, IR_RUNTIME_ROUTE_KEY_ROWS, symbol) ?? return None
    // copy: the caller gets an owned route row, while the row stays in the global
    // IR_RUNTIME_ROUTES table, which can't be moved from.
    Val(IR_RUNTIME_ROUTES[position].copy())
}


// Opaque native providers: physical ownership ABI only, no Rust schema. A
// Core-declared shape here crosses a route as a heap shell of its declared
// bytes (ir_route_shell): `KeyRef<T>` from jet_vault_current_impl.
IR_NATIVE_PROVIDER_HANDLES: #run { [IRRuntimeHandle]{
    IRRuntimeHandle{jet_name: "<corelib>/core.crypto.vault::KeyRef", runtime: "JetVaultKeyRef", clone: false, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "<corelib>/core.process::ProcessStdoutStream", runtime: "ProcessStdoutStream", clone: true, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "ProcessStdoutStream", runtime: "ProcessStdoutStream", clone: true, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "<corelib>/core.process::ProcessStdin", runtime: "ProcessStdin", clone: true, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "ProcessStdin", runtime: "ProcessStdin", clone: true, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "<corelib>/core.process::ProcessStderrStream", runtime: "ProcessStderrStream", clone: true, display: false, show: false, debug: false, eq: false},
    IRRuntimeHandle{jet_name: "ProcessStderrStream", runtime: "ProcessStderrStream", clone: true, display: false, show: false, debug: false, eq: false},
} }

IR_NATIVE_PROVIDER_HANDLE_KEY_ROWS: #run ir_key_index(ir_runtime_handle_keys(IR_NATIVE_PROVIDER_HANDLES))
IR_NATIVE_PROVIDER_HANDLE_KEYS: #run ir_key_index_keys(ir_runtime_handle_keys(IR_NATIVE_PROVIDER_HANDLES), IR_NATIVE_PROVIDER_HANDLE_KEY_ROWS)

// The runtime's C export table (RUNTIME_C_EXPORTS, generated from every
// JetRuntime #Export(c)), indexed for halving search.
IR_RUNTIME_EXPORT_KEY_ROWS: #run ir_key_index(RUNTIME_C_EXPORTS)
IR_RUNTIME_EXPORT_KEYS: #run ir_key_index_keys(RUNTIME_C_EXPORTS, IR_RUNTIME_EXPORT_KEY_ROWS)

// Whether the runtime exports C symbol `symbol`.
ir_runtime_exports: fn(symbol: String) -> Bool Never! {
    ir_key_row(IR_RUNTIME_EXPORT_KEYS, IR_RUNTIME_EXPORT_KEY_ROWS, symbol) != None
}

// Whether the runtime exports the drop of runtime handle type `runtime`: the
// symbol every route, layout and record getter of the handle is named from.
ir_runtime_handle_exported: fn(runtime: String) -> Bool Never! {
    ir_runtime_exports("jet_rt_handle_drop_{runtime_abi_atom(runtime)}")
}

// The runtime handle row of Jet type `name`. A Core declaration's canonical
// identity (`<corelib>/core.encoding::EncodingCause`) names the runtime type
// its bare spelling's row does: the route names
// (`jet_rt_handle_drop_<runtime>`, `jet_rt_record_get_<runtime>_<member>`)
// must be the runtime's own exports, and a checked jet.runtime binding spells
// its Core types by identity.
ir_runtime_handle: fn(name: String) -> IRRuntimeHandle? {
    if ir_runtime_handle_row(name) == .Val(position) {
        // copy: the caller gets an owned handle row, while the row stays in the global
        // IR_RUNTIME_HANDLES table, which can't be moved from.
        return Val(IR_RUNTIME_HANDLES[position].copy())
    }
    // Existing Rust rows win in seed mode; absent nominals may use a provider.
    position: ir_key_row(IR_NATIVE_PROVIDER_HANDLE_KEYS, IR_NATIVE_PROVIDER_HANDLE_KEY_ROWS, name) ?? return None
    // copy: the caller gets an owned handle row, while the row stays in the global
    // IR_NATIVE_PROVIDER_HANDLES table, which can't be moved from.
    Val(IR_NATIVE_PROVIDER_HANDLES[position].copy())
}

// Core records the runtime's generated record exports carry (Records.jet),
// keyed by runtime type: a struct's fields in constructor order or an enum's
// variants in index order, each `name=kind` when it carries a member (Text,
// Int, U64, Flag, Float, Tag.<enum>, Rec.<record>, Opt<kind>; a variant's
// named members joined by `+`). Every row is read: its key is a runtime
// handle row's runtime type or a route carrier's, or a member of another
// row; a Core type whose declaration moved to Core source keeps no row here.
IR_GENERATED_RECORDS: #run { [IRRecordSchema]{
    IRRecordSchema{jet_name: "__jet__x3ccorelib_x3e_score_dcrypto_dvault_c_cKeyStatus", variants: "Active,Retired,Revoked", fields: ""},
