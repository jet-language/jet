    IRNativeType{jet_name: "<corelib>/core.net::SRVRecord", declaration: "<corelib>/core.net::SRVRecord", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.net.url::URL", declaration: "<corelib>/core.net.url::URL", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.process::ProcessSignal", declaration: "<corelib>/core.process::ProcessSignal", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.service::DeliveryEvent", declaration: "<corelib>/core.service::DeliveryEvent", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.sync::RowPolicy", declaration: "<corelib>/core.sync::RowPolicy", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.testing::Fake", declaration: "<corelib>/core.testing::Fake", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.time::Clock", declaration: "<corelib>/core.time::Clock", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.time::DateTime", declaration: "<corelib>/core.time::DateTime", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.time::Instant", declaration: "<corelib>/core.time::Instant", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.time::LocalDate", declaration: "<corelib>/core.time::LocalDate", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.time::LocalTime", declaration: "<corelib>/core.time::LocalTime", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.time::Period", declaration: "<corelib>/core.time::Period", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.time::Stopwatch", declaration: "<corelib>/core.time::Stopwatch", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.time::TimeError", declaration: "<corelib>/core.time::TimeError", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.time::Zone", declaration: "<corelib>/core.time::Zone", arguments: ""},
    IRNativeType{jet_name: "<corelib>/core.time::ZonedDateTime", declaration: "<corelib>/core.time::ZonedDateTime", arguments: ""},
} }

ir_native_type_keys: fn() -> [String] Never! {
    loop row in IR_NATIVE_TYPES -> row.jet_name.copy() // copy: the global native type table can't be moved from
}

IR_NATIVE_TYPE_KEY_ROWS: #run ir_key_index(ir_native_type_keys())
IR_NATIVE_TYPE_KEYS: #run ir_key_index_keys(ir_native_type_keys(), IR_NATIVE_TYPE_KEY_ROWS)

ir_native_type: fn(name: String) -> IRNativeType? {
    position: ir_key_row(IR_NATIVE_TYPE_KEYS, IR_NATIVE_TYPE_KEY_ROWS, name) ?? return None
    // copy: the caller gets an owned type row, while the row stays in the global IR_NATIVE_TYPES
    // table, which can't be moved from.
    Val(IR_NATIVE_TYPES[position].copy())
}

// The names a generated record row can be read by: a route carrier's
// handle or tag, and its members'.
ir_route_carrier_names: fn(carrier: IRRouteCarrier, out: &[String]) Never! {
    if carrier == {
        .Handle(name) | .HandleMut(name) -> out.push(name.copy())
        .Tag(name, _) -> out.push(name.copy())
        .List(elem) | .ListMut(elem) -> ir_route_carrier_names(elem, out)
        .Option(some) -> ir_route_carrier_names(some, out)
        .Tuple(items) -> { loop item in items -> ir_route_carrier_names(item, out) }
        .Word | .Flag | .Float | .Text | .Unit -> {}
    }
}

#Test("every generated record row is read by a runtime handle, a route or another row") {
    readers := [String]{}
    loop handle in IR_RUNTIME_HANDLES -> readers.push(handle.runtime.copy())
    loop handle in IR_NATIVE_PROVIDER_HANDLES -> readers.push(handle.runtime.copy())
    loop route in IR_RUNTIME_ROUTES {
        loop param in route.params -> ir_route_carrier_names(param, readers)
        if route.result == {
            .Plain(carrier) -> ir_route_carrier_names(carrier, readers)
            .Option(some) -> ir_route_carrier_names(some, readers)
            .Result(ok, err) -> {
                ir_route_carrier_names(ok, readers)
                ir_route_carrier_names(err, readers)
            }
            .Tuple(items) -> { loop item in items -> ir_route_carrier_names(item, readers) }
        }
    }
    loop row in IR_GENERATED_RECORDS {
        loop part in "{row.variants},{row.fields}".split(",") {
            loop kind in part.split("+") {
                if kind.contains("Tag.") -> readers.push(kind.split("Tag.").to_list()[1].copy())
                if kind.contains("Rec.") -> readers.push(kind.split("Rec.").to_list()[1].copy())
            }
        }
    }
    unread := [String]{}
    loop row in IR_GENERATED_RECORDS {
        if !readers.contains(row.jet_name) -> unread.push(row.jet_name.copy())
    }
    assert_eq(unread, [String]{})
}

// Every Core declaration's identity whose bare spelling has a runtime handle
// the runtime exports names an exported runtime handle in its own row, each
// error and record type alike (EncodingCause, EncodingError, XMLError, the
// math and time handles): no lookup stands in for the row.
#Test("a Core identity's runtime handle is the runtime's exported one") {
    unexported := [String]{}
    loop row in IR_RUNTIME_HANDLES {
        if !row.jet_name.starts_with("<corelib>/") -> next
        if !row.jet_name.contains("::") -> next
        parts: row.jet_name.split("::").to_list()
        bare: ir_core_bare_handle(row.jet_name, parts[parts.len() - 1]) ?? next
        if !ir_runtime_handle_exported(bare.runtime) -> next
        if !ir_runtime_handle_exported(row.runtime) -> unexported.push(row.jet_name.copy())
    }
    assert_eq(unexported, [String]{})
    cause: ir_runtime_handle("<corelib>/core.encoding::EncodingCause") ?? panic("EncodingCause lost its handle")
    assert_eq(cause.runtime, "EncodingCause")
    assert(ir_runtime_exports("jet_rt_handle_drop_encoding_cause"))
}
