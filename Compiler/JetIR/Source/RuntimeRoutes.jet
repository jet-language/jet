fn ir_runtime_route(symbol: String) -> IRRoute? {
    position :: ir_key_row(IR_RUNTIME_ROUTE_KEYS, IR_RUNTIME_ROUTE_KEY_ROWS, symbol) ?? return None
    // copy: the caller gets an owned route row, while the row stays in the global
    // IR_RUNTIME_ROUTES table, which can't be moved from.
    Val(IR_RUNTIME_ROUTES[position].copy())
}

// The runtime handle type a Jet type generated Rust holds natively crosses the
// boundary as, keyed by the Jet name the checker spells it with: a Core table name
// (`LocalDate`), or a canonical Core source identity
// (`<corelib>/core.net::TCPStream`) whose own Jet shape
// generated Rust replaces. It is dropped by `jet_rt_handle_drop_<runtime>`;
// copied by `jet_rt_handle_clone_<runtime>` when `clone`; rendered by
// `jet_rt_handle_display_<runtime>` / `jet_rt_handle_show_<runtime>` /
// `jet_rt_handle_debug_<runtime>` when `display` / `show` / `debug`; compared
// by `jet_rt_handle_eq_<runtime>` when `eq`.
struct IRRuntimeHandle { jet_name: String, runtime: String, clone: Bool, display: Bool, show: Bool, debug: Bool, eq: Bool }

