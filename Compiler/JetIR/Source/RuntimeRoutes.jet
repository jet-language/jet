// Shared carriers of runtime C-ABI routes, each defined by a Jet runtime
// #Export(c), keyed by the route's Prelude symbol; `export` is the C name
// (its last segment). This is authored Jet source and the routes' only home:
// keep every row table sorted by hand. Each table's KEYS/KEY_ROWS lookup
// index is computed from the table at build time (ir_key_index).

use jet_foundation.[IRRuntimeHandle, IR_RUNTIME_HANDLES, RUNTIME_C_EXPORTS, ir_key_index, ir_key_index_keys, ir_key_row, ir_runtime_handle_keys, ir_runtime_handle_row]

// The runtime ABI atom projection; nominal identities stay unchanged.
runtime_abi_atom: fn(name: String) -> String Never! {
    bytes: name.bytes()
    out := [U8]{}
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if code == 46 || code == 95 {
            if out.len() > 0 && out[out.len() - 1] != (U8{95}) -> out.push(U8{95})
            next
        }
        upper: code >= 65 && code <= 90
        if upper && index > 0 && out.len() > 0 && out[out.len() - 1] != (U8{95}) {
            previous: Int.from_u8(bytes[index - 1])
            next_code: if index + 1 < bytes.len() -> Int.from_u8(bytes[index + 1]) else -> 0
            previous_upper: previous >= 65 && previous <= 90
            next_lower: next_code >= 97 && next_code <= 122
            if !previous_upper || next_lower -> out.push(U8{95})
        }
        out.push(U8{if upper -> code + 32 else -> code})
    }
    if out.len() > 0 && out[out.len() - 1] == (U8{95}) {
        _: out.pop() ?? panic("a nonempty runtime ABI atom failed to pop")
    }
    String.from_bytes(out) ?? panic("runtime ABI atom is not ASCII")
}

// `HandleMut` lends the handle of the caller's Write place: the runtime
// mutates the value in that box. A Tuple writes its flattened carrier
// slots through out pointers (zeroed eight-byte slots); an Option item
// writes a 0/1 tag followed by its payload slots and returns nothing. A
// Tuple carrier (an Option's tuple payload) writes its items' slots in the
// checked tuple's member order. `ListMut` lends a `&` List argument's
// 24-byte header in place (one word): the route rewrites its length inside
// the buffer it already has, never growing it.
IRRouteCarrier: enum { Word Flag Float Text Unit Handle(name: String) HandleMut(name: String) List(elem: IRRouteCarrier) ListMut(elem: IRRouteCarrier) Option(some: IRRouteCarrier) Tag(name: String, variants: String) Tuple(items: [IRRouteCarrier]) }

IRRouteResult: enum {
    Plain(carrier: IRRouteCarrier)
    Option(some: IRRouteCarrier)
    Result(ok: IRRouteCarrier, err: IRRouteCarrier)
    Tuple(items: [IRRouteCarrier])
}

IRRoute: struct { symbol: String, export: String, native_lists: Bool, params: [IRRouteCarrier], result: IRRouteResult }

IR_RUNTIME_ROUTES: #run { [IRRoute]{
    IRRoute{symbol: "jet_app_auth", export: "jet_app_auth", native_lists: false, params: [IRRouteCarrier]{IRRouteCarrier.Text}, result: IRRouteResult.Plain{carrier: IRRouteCarrier.Handle{name: "JetAuthApp"}}},
