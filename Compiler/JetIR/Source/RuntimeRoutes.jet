// #5001: each table below is read in place, and its lookup is keyed: the
// table's distinct keys in ascending byte order with each key's first row,
// frozen at build time, searched by halving instead of a scan of every row.
fn ir_key_row(keys: [String], rows: [Int], key: String) -> Int? Never! {
    low := 0
    high := keys.len()
    loop low < high {
        middle :: low + (high - low) /% 2
        if {
            keys[middle] == key -> return Val(rows[middle])
            keys[middle] < key -> low = middle + 1
            else -> high = middle
        }
    }
    None
}

