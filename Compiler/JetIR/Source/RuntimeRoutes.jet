fn ir_runtime_handle_field(runtime: String, field: String) -> IRHandleField? {
    position :: ir_key_row(IR_HANDLE_FIELD_KEYS, IR_HANDLE_FIELD_KEY_ROWS, "{runtime} {field}") ?? return None
    // copy: the caller gets an owned field row, while the row stays in the global
    // IR_HANDLE_FIELDS table, which can't be moved from.
    Val(IR_HANDLE_FIELDS[position].copy())
}
enum IREnvironmentOp { Bytes Set Remove Columns Compare Seed Text }
struct IREnvironmentRoute { symbol: String, export: String, op: IREnvironmentOp, arity: Int }
IR_ENVIRONMENT_ROUTES :: prep { [IREnvironmentRoute]{
    IREnvironmentRoute{symbol: "jet_sys_env_value_raw", export: "jet_rt_logical_env_get_os", op: IREnvironmentOp.Bytes, arity: 1},
    IREnvironmentRoute{symbol: "jet_std_env_try_set", export: "jet_rt_logical_env_set", op: IREnvironmentOp.Set, arity: 2},
    IREnvironmentRoute{symbol: "jet_std_env_unset", export: "jet_rt_logical_env_unset", op: IREnvironmentOp.Remove, arity: 1},
    IREnvironmentRoute{symbol: "jet_sys_env_columns_raw", export: "jet_rt_logical_env_columns", op: IREnvironmentOp.Columns, arity: 0},
    IREnvironmentRoute{symbol: "jet_sys_startup_env_columns_raw", export: "jet_rt_startup_env_columns", op: IREnvironmentOp.Columns, arity: 0},
    IREnvironmentRoute{symbol: "jet_sys_env_key_compare_raw", export: "jet_rt_env_key_compare", op: IREnvironmentOp.Compare, arity: 2},
    IREnvironmentRoute{symbol: "jet_std_env_init", export: "jet_rt_logical_env_seed", op: IREnvironmentOp.Seed, arity: 0},
    IREnvironmentRoute{symbol: "jet_rt_logical_env_get", export: "jet_rt_logical_env_get", op: IREnvironmentOp.Text, arity: 1},
} }
fn ir_environment_route(symbol: String) -> IREnvironmentRoute? {
    // copy: the caller gets an owned route row, while the row stays in the global
    // IR_ENVIRONMENT_ROUTES table, which can't be moved from.
    loop route in IR_ENVIRONMENT_ROUTES { if route.symbol == symbol -> return Val(route.copy()) }
    None
}

