// Loop splits (O2), once every body is optimized: a word slot a Loop reads
// or writes that is also referenced outside the Loop gets a slot of its
// own inside it. The backend's allocator (X64Alloc.jet) gives a slot one
// place over its whole range, so without the split a value a hot Loop
// shares with the code around it, where registers run short, stays in its
// home in the Loop too; its slot inside the Loop has the Loop's range only
// and competes for a register there alone.
//
// Before the Loop, its slot takes the value (a Move). A Loop that writes
// the value hands it back after the Block around it, so only when that
// Block holds just the Loop and no BrIf inside leaves further than it; a Br
// that leaves further hands it back right before it (a Return leaves the
// function). A Move makes no value of its own (no clone, no drop), so the
// two slots hold the one value and the code reads, writes and drops it as
// before. Constants and frame addresses keep their slot: the backend holds
// them in no place.

use jet_foundation.[Type]

// Splits `f`'s Loops (the header comment); returns how many slots it split.
ir_opt_split_loops: fn(m: IRModule, f: &IRFunction) -> Int Never! {
    count: f.op.len()
    slots: f.slot_type.len()
    reads := [Int]{}
    // Per slot: its references, its writes and its last write.
    uses := [Int]{}
    writes := [Int]{}
    last_write := [Int]{}
    loop _ in 0..<slots {
        uses.push(0)
        writes.push(0)
        last_write.push(-1)
    }
    loop at in 0..<count {
        ir_x64_reads_into(f, at, reads)
        loop slot in reads {
            if slot >= 0 && slot < slots -> uses[slot] = uses[slot] + 1
        }
        written: ir_x64_write(f, at)
        if written >= 0 && written < slots {
            uses[written] = uses[written] + 1
            writes[written] = writes[written] + 1
            last_write[written] = at
        }
    }
    splittable: loop slot in 0..<slots -> ir_opt_splittable(m, f, slot, writes[slot], last_write[slot])
    // Per Loop with splits, in order: its rows of the split columns, from
    // first[row] for counts[row], and the Loop's instruction.
    first := [Int]{}
    counts := [Int]{}
    heads := [Int]{}
    split_slot := [Int]{}
    split_new := [Int]{}
    split_old := [Int]{}
    split_written := [Bool]{}
    // Per instruction: the row whose splits move in before it (a Loop),
    // end at it (the Loop's End) and move back after it (the End of the
    // Block around the Loop); -1 for none.
    enter_of := loop _ in 0..<count -> -1
    close_of := loop _ in 0..<count -> -1
    back_of := loop _ in 0..<count -> -1
    // Per slot: the last Loop that counted it, its references in that Loop
    // and whether that Loop writes it.
    mark := loop _ in 0..<slots -> -1
    inside := loop _ in 0..<slots -> 0
    changed := loop _ in 0..<slots -> false
    touched := [Int]{}
    loop head in 0..<count {
        if f.op[head] != .Loop -> next
        tail: f.a[head]
        if tail <= head || tail >= count -> next
        exits: ir_opt_split_exits(f, head, tail)
        touched.clear()
        loop at in head..<(tail + 1) {
            ir_x64_reads_into(f, at, reads)
            loop slot in reads -> ir_opt_split_note(mark, inside, changed, touched, slot, head, false)
            ir_opt_split_note(mark, inside, changed, touched, ir_x64_write(f, at), head, true)
        }
        start: split_slot.len()
        loop slot in touched {
            if !splittable[slot] || inside[slot] == uses[slot] || (changed[slot] && !exits) -> next
            split_slot.push(slot)
            split_new.push(ir_slot(f, f.slot_type[slot], .Temp, -1, f.slot_line[slot]))
            split_old.push(-1)
            split_written.push(changed[slot])
        }
        if split_slot.len() == start -> next
        row: first.len()
        first.push(start)
        counts.push(split_slot.len() - start)
        heads.push(head)
        enter_of[head] = row
        close_of[tail] = row
        if exits -> back_of[tail + 1] = row
    }
    if split_slot.len() == 0 -> return 0
    // The name each slot has at the current instruction, the open Loops
    // with splits (innermost last) and the open Blocks, Loops and Ifs.
    current := loop slot in 0..<f.slot_type.len() -> slot
    open_rows := [Int]{}
    opens := [Int]{}
    code := IROptCode{op: [IROp]{}, dst: [Int]{}, a: [Int]{}, b: [Int]{}, c: [Int]{}, line: [Int]{}}
    loop at in 0..<count {
        line: f.code_line[at]
        op: f.op[at]
        enter: enter_of[at]
        if enter >= 0 {
            loop k in first[enter]..<(first[enter] + counts[enter]) {
                slot: split_slot[k]
                ir_opt_code_put(code, .Move, split_new[k], current[slot], -1, -1, line)
                split_old[k] = current[slot]
                current[slot] = split_new[k]
            }
            open_rows.push(enter)
        }
        // A Br past the Block around a Loop hands its written splits back
        // first, innermost Loop first.
        if op == .Br && f.a[at] >= 0 && f.a[at] < opens.len() {
            target: opens[opens.len() - 1 - f.a[at]]
            row_at := open_rows.len() - 1
            loop row_at >= 0 && target < heads[open_rows[row_at]] - 1 {
                row: open_rows[row_at]
                loop k in first[row]..<(first[row] + counts[row]) {
                    if split_written[k] -> ir_opt_code_put(code, .Move, split_old[k], split_new[k], -1, -1, line)
                }
                row_at -= 1
            }
        }
        ir_opt_split_put(code, f, current, at)
        if op == .Block || op == .Loop || op == .If -> opens.push(at)
        if op == .End -> _ := opens.pop()
        closing: close_of[at]
        if closing >= 0 {
            loop k in first[closing]..<(first[closing] + counts[closing]) -> current[split_slot[k]] = split_old[k]
            _ := open_rows.pop()
        }
        back: back_of[at]
        if back >= 0 {
            loop k in first[back]..<(first[back] + counts[back]) {
                if split_written[k] -> ir_opt_code_put(code, .Move, split_old[k], split_new[k], -1, -1, line)
            }
        }
    }
    f.op = code.op.move()
    f.dst = code.dst.move()
    f.a = code.a.move()
    f.b = code.b.move()
    f.c = code.c.move()
    f.code_line = code.line.move()
    ir_opt_compact(f)
    split_slot.len()
}

// Whether `slot` may be split: a word (Bool, Int, Word or Pointer) held in
// a general register, and no constant or frame address (one write by a
// Const, a StackAddress or an Offset of a temp).
ir_opt_splittable: fn(m: IRModule, f: IRFunction, slot: Int, writes: Int, last: Int) -> Bool Never! {
    row: m.types[f.slot_type[slot]]
    if row.kind != .Bool && row.kind != .Int && row.kind != .Word && row.kind != .Pointer -> return false
    if ir_x64_class(ir_x64_shape(row)) != .General -> return false
    if writes != 1 || f.slot_kind[slot] != .Temp -> return true
    op: f.op[last]
    op != .Const && op != .StackAddress && op != .Offset
}

// Counts a reference to `slot` (-1: none) in the Loop at `head`.
ir_opt_split_note: fn(mark: &[Int], inside: &[Int], changed: &[Bool], touched: &[Int], slot: Int, head: Int, write: Bool) Never! {
    if slot < 0 || slot >= mark.len() -> return
    if mark[slot] != head {
        mark[slot] = head
        inside[slot] = 0
        changed[slot] = false
        touched.push(slot)
    }
    inside[slot] = inside[slot] + 1
    if write -> changed[slot] = true
}

// Whether every way out of the Loop `head`..=`tail` but a Br or a Return
// goes through the End of a Block around just it: the Block opens right
// before the Loop and ends right after it, and no BrIf inside leaves
// further.
ir_opt_split_exits: fn(f: IRFunction, head: Int, tail: Int) -> Bool Never! {
    if head == 0 || f.op[head - 1] != .Block || f.a[head - 1] != tail + 1 -> return false
    nest := 0
    loop at in (head + 1)..<tail {
        op: f.op[at]
        if op == .Block || op == .Loop || op == .If -> nest += 1
        if op == .End -> nest -= 1
        if op == .BrIf && f.b[at] > nest + 1 -> return false
    }
    true
}

// Puts instruction `at` with each slot it reads or writes under its
// `current` name; renamed call arguments get a list of their own.
ir_opt_split_put: fn(code: &IROptCode, f: &IRFunction, current: [Int], at: Int) Never! {
    op: f.op[at]
    form: ir_x64_read_form(op)
    a := f.a[at]
    b := f.b[at]
    c := f.c[at]
    dst := f.dst[at]
    if form != IR_X64_READS_NONE && form != IR_X64_READS_ARGS && a >= 0 -> a = current[a]
    if form == IR_X64_READS_AB && b >= 0 -> b = current[b]
    if form == IR_X64_READS_AC && c >= 0 -> c = current[c]
    if form == IR_X64_READS_ARGS || form == IR_X64_READS_A_ARGS {
        renamed := false
        loop index in b..<(b + c) {
            value: f.args[index]
            if value >= 0 && current[value] != value -> renamed = true
        }
        if renamed {
            start: f.args.len()
            loop index in b..<(b + c) {
                value: f.args[index]
                f.args.push(if value >= 0 -> current[value] else -> value)
            }
            b = start
        }
    }
    if ir_x64_write(f, at) >= 0 && dst >= 0 -> dst = current[dst]
    ir_opt_code_put(code, op, dst, a, b, c, f.code_line[at])
}

// count(n): total and i live before, in and after the Loop, which writes
// both; n and the Loop's 1 live in it only. The Loop's Br out of both
// Blocks hands the two back before it, the Block's End after it.
#Test("A Loop gets slots of its own for the words it shares and hands written ones back on every way out") {
    m := ir_module_new()
    word: ir_type_row(m, Type.IntN{signed: true, bits: 64}) ?? panic("no I64 row")
    truth: ir_type_row(m, Type.Bool) ?? panic("no Bool row")
    f := ir_function_new("count", "test:split.jet::count", "", "split.jet", 1)
    n: ir_slot(f, word, IRSlotKind.Param, ir_intern_name(m, "n"), 1)
    f.result = word
    total: ir_slot(f, word, IRSlotKind.Local, ir_intern_name(m, "total"), 2)
    i: ir_slot(f, word, IRSlotKind.Local, ir_intern_name(m, "i"), 3)
    done: ir_slot(f, truth, IRSlotKind.Temp, -1, 0)
    hit: ir_slot(f, truth, IRSlotKind.Temp, -1, 0)
    one: ir_slot(f, word, IRSlotKind.Temp, -1, 0)
    _ := ir_emit(f, IROp.Const, total, 0, -1, -1, 2)
    _ := ir_emit(f, IROp.Const, i, 0, -1, -1, 3)
    _ := ir_emit(f, IROp.Block, -1, 17, -1, -1, 4)
    _ := ir_emit(f, IROp.Block, -1, 16, -1, -1, 4)
    _ := ir_emit(f, IROp.Loop, -1, 15, -1, -1, 4)
    _ := ir_emit(f, IROp.Ge, done, i, n, -1, 4)
    _ := ir_emit(f, IROp.BrIf, -1, done, 1, -1, 4)
    _ := ir_emit(f, IROp.Eq, hit, total, n, -1, 5)
    _ := ir_emit(f, IROp.If, -1, hit, -1, 10, 5)
    _ := ir_emit(f, IROp.Br, -1, 3, -1, -1, 5)
    _ := ir_emit(f, IROp.End, -1, 8, -1, -1, 5)
    _ := ir_emit(f, IROp.Add, total, total, i, IR_OVERFLOW_WRAP, 6)
    _ := ir_emit(f, IROp.Const, one, 1, -1, -1, 7)
    _ := ir_emit(f, IROp.Add, i, i, one, IR_OVERFLOW_WRAP, 7)
    _ := ir_emit(f, IROp.Br, -1, 0, -1, -1, 7)
    _ := ir_emit(f, IROp.End, -1, 4, -1, -1, 7)
    _ := ir_emit(f, IROp.End, -1, 3, -1, -1, 7)
    _ := ir_emit(f, IROp.End, -1, 2, -1, -1, 7)
    _ := ir_emit(f, IROp.Return, -1, total, -1, -1, 8)
    assert_eq(ir_opt_split_loops(m, f), 2)
    // Before the Loop: i and total move in (in the order the Loop first
    // references them); n and the 1 keep their slots.
    assert_eq(f.op.len(), 25)
    assert(f.op[4] == .Move && f.a[4] == i && f.op[5] == .Move && f.a[5] == total && f.op[6] == .Loop)
    inner_i: f.dst[4]
    inner_total: f.dst[5]
    assert(f.op[7] == .Ge && f.a[7] == inner_i && f.b[7] == n)
    assert(f.op[15] == .Add && f.dst[15] == inner_total && f.a[15] == inner_total && f.b[15] == inner_i)
    assert(f.op[16] == .Const && f.dst[16] == one)
    // Right before the Br out of both Blocks, and after the inner Block's
    // End, both move back.
    assert(f.op[11] == .Move && f.dst[11] == i && f.a[11] == inner_i)
    assert(f.op[12] == .Move && f.dst[12] == total && f.a[12] == inner_total)
    assert(f.op[13] == .Br && f.a[13] == 3)
    assert(f.op[20] == .End && f.op[21] == .Move && f.dst[21] == i && f.a[21] == inner_i)
    assert(f.op[22] == .Move && f.dst[22] == total && f.a[22] == inner_total)
    assert(f.op[24] == .Return && f.a[24] == total)
    m.functions.push(f)
    found := [IRLintFinding]{}
    ir_lint_function(m, ir_lint_context(m), m.functions[0], "split", found)
    assert_eq(found.len(), 0)
}
