// The plugin engine's build half: the link step that turns each literal
// `plugin.load` artifact (a WebAssembly Component, binary or text) into
// JetIR — the flattened core instances, one IR function per guest
// function, the entry thunks and the descriptor the runtime host
// (JetRuntime PluginHost.jet) instantiates from. Guest code runs as
// native code in the host process behind that one host interface.
name: "jet_plugin"
version: "0.0.1"
edition: "2026"
deps: {
    jet_foundation: ../JetFoundation,
    jet_ir: ../JetIR,
    jet_wasm: ../JetWasm,
}
