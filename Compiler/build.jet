// `jet build Compiler/`: the toolchain. The `jet` executable is JetCli's run
// entry, compiled with every package it depends on (JetCli/package.jet lists
// them). The `prelude-sources` and `lexer-keywords` steps first regenerate
// the sources that copy or project other sources (Toolchain/PreludeSources.jet,
// Toolchain/LexerKeywordRows.jet); git keeps them, so a stale one is
// rewritten and a hand edit is refused. The `runtime` step puts jet's runtime
// pack and IDENTITY beside it (Toolchain/RuntimePack.jet): the jet this build
// made lowers the runtime, and no C compiler runs. The pack carries no C or
// libc: a program's C closure links the musl sysroot of jet's C toolchain
// pack (JetCli ForeignLink.jet).
RUNTIME_DIR: "JetCli/.jet/build/jet-runtime"
RUNTIME_FILES: [String]{
    "jet_runtime_jet.o", "runtime.abi.json", "runtime.exports", "runtime.threads",
    "jet_runtime.pack.o", "jet_runtime.image", "jet_runtime.wasm", "jet_runtime.wasm.tsv",
    "provenance.json", "native.key",
}
// The runtime's folder, then the IR builder, optimizer and selector, the
// x86-64 encoder, object writer and linker, and the WebAssembly selector and
// encoder that make it.
RUNTIME_TREES: [String]{"JetRuntime", "JetIR/Source", "JetBackend/Source", "JetWeb/Source", "JetWasm/Source"}

// The Prelude sources and the files that carry their text into the compiler.
PRELUDE_SOURCES: [String]{"Prelude/Markers.jet", "Prelude/Derives.jet", "Prelude/Errors.jet", "Prelude/Units.jet"}
PRELUDE_COPIES: [String]{
    "JetFoundation/Source/Policy/PreludeMarkers.jet",
    "JetSema/Source/Sema/Registration/PreludeDerives.jet",
    "JetSema/Source/Sema/Registration/PreludeUnits.jet",
}
// The keyword table, token kinds and token tags the keyword spans project.
KEYWORD_SOURCES: [String]{"JetLexer/Data/Lexer/Keywords.jet", "JetLexer/Source/Lexer/Tokens.jet", "JetLexer/Source/Lexer/Terminators.jet"}

build: fn(b: Build) -[Exec, FS]> {
    #Impure("run the source generators and the runtime pack step with jet") {
        prelude: b.run("prelude-sources", b.jet(), ["Exec", "FS"])
        prelude.arg("run")
        prelude.arg("--allow=FS")
        prelude.input("Toolchain/PreludeSources.jet")
        prelude.arg("--")
        prelude.arg("--write")
        loop source in PRELUDE_SOURCES -> prelude.reads(source)
        loop target in PRELUDE_COPIES -> prelude.writes(target, kept: true)
        keywords: b.run("lexer-keywords", b.jet(), ["Exec", "FS"])
        keywords.arg("run")
        keywords.arg("--allow=FS")
        keywords.input("Toolchain/LexerKeywordRows.jet")
        keywords.arg("--")
        keywords.arg("--write")
        keywords.file(b.folder("JetFoundation/Data/Syntax"), flag: "--syntax=")
        loop source in KEYWORD_SOURCES -> keywords.reads(source)
        keywords.writes("JetLexer/Source/Lexer/KeywordSpans.jet", kept: true)
        jet: b.add_executable("jet", ["JetCli/run.jet"], [prelude, keywords])
        runtime: b.run("runtime", b.jet(), ["Exec", "FS"])
        runtime.arg("run")
        runtime.arg("--allow=Env,Exec,FS")
        runtime.input("Toolchain/RuntimePack.jet")
        runtime.arg("--")
        runtime.arg("pack")
        runtime.file(b.host(jet), flag: "--jet=")
        loop tree in RUNTIME_TREES -> runtime.file(b.folder(tree), flag: "--tree=")
        runtime.arg("--out={RUNTIME_DIR}")
        loop file in RUNTIME_FILES -> runtime.writes("{RUNTIME_DIR}/{file}")
        runtime.output("JetCli/.jet/build/IDENTITY", flag: "--identity=")
        runtime.timeout(10min)
        toolchain: b.add_install("toolchain", [], [runtime], [jet])
        b.default(toolchain)
    }
}
