// `jet build Compiler/`: the toolchain. The `jet` executable is JetCli's run
// entry, compiled with every package it depends on (JetCli/package.jet lists
// them). The `prelude-sources` and `lexer-keywords` steps first regenerate
// the sources that copy or project other sources (Toolchain/PreludeSources.jet,
// Toolchain/LexerKeywordRows.jet); git keeps them, so a stale one is
// rewritten and a hand edit is refused. That compile is `jet-bare`. The
// `runtime` step lowers jet's runtime pack with it into jet-runtime/
// (Toolchain/RuntimePack.jet), with IDENTITY, jet-bare's identity: its
// bytes name the compiler, and no C compiler runs. It also fails when the
// jet.runtime interface jet embeds (JetFoundation Registry/RuntimeInterface.jet)
// disagrees with the one the runtime source renders. The `core-record` step
// then runs jet-bare to check Core and the Prelude and writes `jet`, the same
// executable with their precompiled record, each runtime file and jet's own
// identity added as parts it maps at load (JetCli CoreRecordCheck.jet
// `--embed`), and that identity to IDENTITY beside it for the tools that
// name a jet without running it. So the record is the Core of that very
// compiler, a compile outside a toolchain tree takes its Core modules from
// the record, not from Core's sources, and jet reads no runtime or identity
// file: only jet-bare reads jet-runtime/. jet-bare has no
// runtime image, so neither step can run Core code at compile time: every
// Core module value must be a constant the compiler folds, and one that
// calls Core code is E0643 here (Core/Ui Draw.jet's built-in face is a
// `#Memo` function for this). The pack carries no C or libc: a program's C
// closure links the musl sysroot of jet's C toolchain pack (JetCli
// ForeignLink.jet). The Core library (jet_core.o, core.exports,
// core.threads: jet's embedded Core as global symbols) is off until #5479
// S7b binds programs to it (Toolchain/RuntimePack.jet CORE_LIBRARY); S7b
// adds its three files here when it turns it on.
RUNTIME_DIR: "JetCli/.jet/build/jet-runtime"
RUNTIME_FILES: [String]{
    "jet_runtime_jet.o", "runtime.abi.json", "runtime.exports", "runtime.threads",
    "jet_runtime.pack.o", "jet_runtime.image", "jet_runtime.wasm", "jet_runtime.wasm.tsv",
    "provenance.json", "native.key",
}
// The runtime's folder, then the IR builder, optimizer and selector, the
// x86-64 encoder, object writer and linker, and the WebAssembly selector and
// encoder that make it.
RUNTIME_TREES: [String]{"JetRuntime", "JetIR/Source", "JetBackend/Source", "JetWeb/Source", "JetWasm/Source"}

// The Prelude sources and the files that carry their text into the compiler.
PRELUDE_SOURCES: [String]{"Prelude/Markers.jet", "Prelude/Derives.jet", "Prelude/Errors.jet", "Prelude/Units.jet"}
PRELUDE_COPIES: [String]{
    "JetFoundation/Source/Policy/PreludeMarkers.jet",
    "JetSema/Source/Sema/Registration/PreludeDerives.jet",
    "JetSema/Source/Sema/Registration/PreludeUnits.jet",
}
// The keyword table, token kinds and token tags the keyword spans project.
KEYWORD_SOURCES: [String]{"JetLexer/Data/Lexer/Keywords.jet", "JetLexer/Source/Lexer/Tokens.jet", "JetLexer/Source/Lexer/Terminators.jet"}

build: fn(b: Build) -[Exec, FS]> {
    #Impure("run the source generators, the Core record step and the runtime pack step") {
        prelude: b.run("prelude-sources", b.jet(), ["Exec", "FS"])
        prelude.arg("run")
        prelude.arg("--allow=FS")
        prelude.input("Toolchain/PreludeSources.jet")
        prelude.arg("--")
        prelude.arg("--write")
        loop source in PRELUDE_SOURCES -> prelude.reads(source)
        loop target in PRELUDE_COPIES -> prelude.writes(target, kept: true)
        keywords: b.run("lexer-keywords", b.jet(), ["Exec", "FS"])
        keywords.arg("run")
        keywords.arg("--allow=FS")
        keywords.input("Toolchain/LexerKeywordRows.jet")
        keywords.arg("--")
        keywords.arg("--write")
        keywords.file(b.folder("JetFoundation/Data/Syntax"), flag: "--syntax=")
        loop source in KEYWORD_SOURCES -> keywords.reads(source)
        keywords.writes("JetLexer/Source/Lexer/KeywordSpans.jet", kept: true)
        bare: b.add_executable("jet-bare", ["JetCli/run.jet"], [prelude, keywords])
        runtime: b.run("runtime", b.jet(), ["Exec", "FS"])
        runtime.arg("run")
        runtime.arg("--allow=Env,Exec,FS")
        runtime.input("Toolchain/RuntimePack.jet")
        runtime.arg("--")
        runtime.arg("pack")
        runtime.file(b.host(bare), flag: "--jet=")
        loop tree in RUNTIME_TREES -> runtime.file(b.folder(tree), flag: "--tree=")
        runtime.reads("JetFoundation/Source/Registry/RuntimeInterface.jet")
        runtime.arg("--out={RUNTIME_DIR}")
        loop file in RUNTIME_FILES -> runtime.writes("{RUNTIME_DIR}/{file}")
        runtime.output("{RUNTIME_DIR}/IDENTITY", flag: "--identity=")
        runtime.timeout(10min)
        core: b.run("core-record", b.host(bare), ["Exec", "FS"])
        core.arg("self")
        core.arg("devtools")
        core.arg("core-record")
        core.arg("--embed")
        core.file(b.host(bare))
        // The runtime step's folder: the step reads each file it embeds.
        core.arg(RUNTIME_DIR)
        loop file in RUNTIME_FILES -> core.reads("{RUNTIME_DIR}/{file}")
        core.reads("{RUNTIME_DIR}/IDENTITY")
        core.output("JetCli/.jet/build/jet")
        core.output("JetCli/.jet/build/IDENTITY")
        // Checking every Core body takes most of it (a v5 write took 14 min).
        core.timeout(30min)
        toolchain: b.add_install("toolchain", [], [runtime, core], [bare])
        b.default(toolchain)
    }
}
