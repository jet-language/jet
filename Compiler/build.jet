// `jet build Compiler/`: the toolchain. The `jet` executable is JetCli's run
// entry, compiled with every package it depends on (JetCli/package.jet lists
// them). The `prelude-sources` and `lexer-keywords` steps first regenerate
// the sources that copy or project other sources (Toolchain/PreludeSources.jet,
// Toolchain/LexerKeywordRows.jet); git keeps them, so a stale one is
// rewritten and a hand edit is refused. That compile is `jet-bare`. The
// `runtime` step lowers jet's runtime pack with it into jet-runtime/, run by
// `runtime-pack`, Toolchain/RuntimePack.jet built for this machine: a script
// target reads only itself, so it compiles while the generators run, and the
// step starts the moment jet-bare links. It writes IDENTITY, jet-bare's
// identity: its bytes name the compiler, and no C compiler runs. It also
// fails when the jet.runtime interface jet embeds (JetFoundation
// Registry/RuntimeInterface.jet) disagrees with the one the runtime source
// renders. The same step checks
// Core and the Prelude once, with jet-bare, and builds the Core library
// below from that check (JetCli CoreLibrary.jet). The `core-embed` step then
// writes `jet`, the same executable with each runtime file and jet's own
// identity added as parts it maps at load (JetCli RuntimeEmbed.jet), and
// that identity to IDENTITY beside it for the tools that name a jet without
// running it. So jet reads no runtime or identity file: only jet-bare reads
// jet-runtime/. jet-bare has no runtime image, so the runtime step can't run
// Core code at compile time: every
// Core module value must be a constant the compiler folds, and one that
// calls Core code is E0643 here (Core/Ui Draw.jet's built-in face is a
// `#Memo` function for this). The pack carries no C or libc: a program's C
// closure links the musl sysroot of jet's C toolchain pack (JetCli
// ForeignLink.jet). The Core library (jet_core.o, core.exports, core.facts,
// core.seal, core.threads: jet's embedded Core as global symbols, which of
// them a bound program may take as sealed, and what it may know of them
// unchecked) lands here too: the image links its
// object beside the runtime, and jet carries the object and its lists as
// parts, by which a `jet run` binds its Core calls to the image's Core code,
// or to the object's in a full link (JetCli Host.jet). So do
// core.interface, each embedded Core unit's load rows and function body
// spans (JetDriver CoreInterface.jet), and core.bodies, the Prelude's
// function checks as the Core library's check left them (JetSema
// CoreBodies.jet), which jet carries as parts too.
RUNTIME_DIR: "JetCli/.jet/build/jet-runtime"
RUNTIME_FILES: [String]{
    "jet_runtime_jet.o", "runtime.abi.json", "runtime.exports", "runtime.threads",
    "jet_core.o", "core.exports", "core.facts", "core.seal", "core.threads", "core.interface", "core.bodies",
    "jet_runtime.pack.o", "jet_runtime.image", "jet_runtime.wasm", "jet_runtime.wasm.tsv",
    "provenance.json", "native.key",
}
// The runtime's folder, then the IR builder, optimizer and selector, the
// x86-64 encoder, object writer and linker, and the WebAssembly selector and
// encoder that make it.
RUNTIME_TREES: [String]{"JetRuntime", "JetIR/Source", "JetBackend/Source", "JetWeb/Source", "JetWasm/Source"}

// The Prelude sources and the files that carry their text into the compiler.
PRELUDE_SOURCES: [String]{"Prelude/Markers.jet", "Prelude/Derives.jet", "Prelude/Errors.jet", "Prelude/Units.jet"}
PRELUDE_COPIES: [String]{
    "JetFoundation/Source/Policy/PreludeMarkers.jet",
    "JetSema/Source/Sema/Registration/PreludeDerives.jet",
    "JetSema/Source/Sema/Registration/PreludeUnits.jet",
}
// The keyword table, token kinds and token tags the keyword spans project.
KEYWORD_SOURCES: [String]{"JetLexer/Data/Lexer/Keywords.jet", "JetLexer/Source/Lexer/Tokens.jet", "JetLexer/Source/Lexer/Terminators.jet"}

build: fn(b: Build) -[Exec, FS]> {
    #Impure("run the source generators, the runtime pack step and the Core embed step") {
        prelude: b.run("prelude-sources", b.jet(), ["Exec", "FS"])
        prelude.arg("run")
        prelude.arg("--allow=FS")
        prelude.input("Toolchain/PreludeSources.jet")
        prelude.arg("--")
        prelude.arg("--write")
        loop source in PRELUDE_SOURCES -> prelude.reads(source)
        loop target in PRELUDE_COPIES -> prelude.writes(target, kept: true)
        keywords: b.run("lexer-keywords", b.jet(), ["Exec", "FS"])
        keywords.arg("run")
        keywords.arg("--allow=FS")
        keywords.input("Toolchain/LexerKeywordRows.jet")
        keywords.arg("--")
        keywords.arg("--write")
        keywords.file(b.folder("JetFoundation/Data/Syntax"), flag: "--syntax=")
        loop source in KEYWORD_SOURCES -> keywords.reads(source)
        keywords.writes("JetLexer/Source/Lexer/KeywordSpans.jet", kept: true)
        bare: b.add_executable("jet-bare", ["JetCli/run.jet"], [prelude, keywords])
        pack: b.add_executable("runtime-pack", ["Toolchain/RuntimePack.jet"], [])
        runtime: b.run("runtime", b.host(pack), ["Exec", "FS"])
        runtime.arg("pack")
        runtime.file(b.host(bare), flag: "--jet=")
        loop tree in RUNTIME_TREES -> runtime.file(b.folder(tree), flag: "--tree=")
        runtime.reads("JetFoundation/Source/Registry/RuntimeInterface.jet")
        // The backend's package.jet beside its JetBackend/Source tree: its
        // `policy.memory` is the kernel of the backend sources the unit holds.
        runtime.reads("JetBackend/package.jet")
        runtime.arg("--out={RUNTIME_DIR}")
        loop file in RUNTIME_FILES -> runtime.writes("{RUNTIME_DIR}/{file}")
        runtime.output("{RUNTIME_DIR}/IDENTITY", flag: "--identity=")
        // Lowering the runtime, checking every Core body and building the
        // Core library.
        runtime.timeout(30min)
        embed: b.run("core-embed", b.host(bare), ["Exec", "FS"])
        embed.arg("self")
        embed.arg("devtools")
        embed.arg("embed")
        embed.file(b.host(bare))
        // The runtime step's folder: the step reads each file it embeds.
        embed.arg(RUNTIME_DIR)
        loop file in RUNTIME_FILES -> embed.reads("{RUNTIME_DIR}/{file}")
        embed.reads("{RUNTIME_DIR}/IDENTITY")
        embed.output("JetCli/.jet/build/jet")
        embed.output("JetCli/.jet/build/IDENTITY")
        embed.timeout(10min)
        toolchain: b.add_install("toolchain", [], [runtime, embed], [bare])
        b.default(toolchain)
    }
}
