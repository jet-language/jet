// Core body text lives at the first consuming compiler layer; metadata stays
// in Foundation so changing a body does not rebuild lexer/parser/comptime.
// Rust: crates/jet-sema/src/CoreSources.rs:9
use jet_foundation.CoreSourceParts.[CORE_TEXT_STRING_MODULE]
// Rust: crates/jet-sema/src/CoreSources.rs:11
use CoreSourceTexts.[CORE_SOURCE_TEXTS]

// Rust: crates/jet-sema/src/CoreSources.rs:13
CORE_PRIVATE_SOURCE_TEXTS :: prep { [(String, String)]{
    (CORE_TEXT_STRING_MODULE, #Embed("../../../Core/text/string.jet"))
} }

// Rust: crates/jet-sema/src/CoreSources.rs:18
pub fn core_source_text(module: String) -> String? Never! {
    loop (name, text) in CORE_SOURCE_TEXTS {
        if name == module -> return Val(text)
    }
    loop (name, text) in CORE_PRIVATE_SOURCE_TEXTS {
        if name == module -> return Val(text)
    }
    None
}
