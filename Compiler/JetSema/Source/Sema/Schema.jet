//RS     pub names: HashMap<String, String>,
//RS     /// Current JSON keys, excluding fields marked `#Skip`.
//RS     pub current: BTreeSet<String>,
//RS     /// Historical JSON-key sets, oldest first.
//RS     pub historical: Vec<Vec<String>>,
//RS     /// Current skipped JSON keys, retained for snapshot consumers.
//RS     pub skipped: BTreeSet<String>,
//RS     rename_all: Option<String>,
