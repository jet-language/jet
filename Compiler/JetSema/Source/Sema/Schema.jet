// Published-schema snapshots: the durable, lockfile-style schema contract.
use jet_foundation.[CtValue, Expr, MigrationDecl, MigrationOp, StructDef, StructLayout, Type, Marker, StrPart, ShapeDimensions, ShapeEncoding, ShapeError, ShapeFact, ShapeFieldFact, ShapeIdentity, ShapeLayoutFact, ShapeProvenance, ShapeType, ShapeDefault, ShapeProjectionKind]
use jet_foundation.Syntax as Syntax
use jet_foundation.CLISchema.[shape_field_names]
use jet_foundation.CheckReads as CheckReads
use core.files as files

// Rust: crates/jet-sema/src/Sema/Schema.rs:28
pub fn shape_fact_from_struct(source: String, structure: StructDef) -> ShapeFact ShapeError! {
    fields := [ShapeFieldFact]{}
    loop (order, field) in structure.fields.enumerate() {
        ty :: shape_type(source, field.ty)
        encoding :: shape_encoding(ty)
        names :: shape_field_names(structure, field)
        fact := ShapeFieldFact.new(field.name, ty, order).with_names(names).with_encoding(encoding)
        if field.computed != None || field.serde_markers.any(fn(marker) { marker.name == Syntax.MARKER_SKIP }) -> fact = fact.skipped()
        if field.default_ct.and_then(shape_default) == .Val(default) -> fact = fact.with_default(default)
        if field.serde_markers.find(fn(marker) { marker.name == Syntax.MARKER_SHORT }).and_then(fn(marker) { shape_marker_string(marker, None) }) == .Val(short) -> fact = fact.with_short(short)
        &fields.push(fact)
    }
    fact :: ShapeFact.new(ShapeIdentity.new(source, structure.name), ShapeDimensions.record(fields.len()), fields, ShapeEncoding.Object, ShapeProvenance.declared().with_declaration(structure.name))?
    fact.with_layout(shape_layout(structure))
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:76
fn shape_layout(structure: StructDef) -> ShapeLayoutFact Never! {
    if structure.layout == {
        .Val(.C) -> ShapeLayoutFact.c()
        .Val(.CAligned{alignment, target}) -> ShapeLayoutFact.c_aligned_with_mode(alignment, target)
        .Val(.Columnar) -> ShapeLayoutFact.columnar()
        .None -> ShapeLayoutFact.default()
    }
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:89
fn shape_marker_string(marker: Marker, label: String?) -> String? Never! {
    expression :: if label == {
        .Val(label) -> {
            index :: marker.arg_labels.enumerate().find(fn(row) { row.1.map(fn(value) { value.0 == label }) ?? false }).map(fn(row) { row.0 }) ?? return None
            arg :: marker.args.get(index) ?? return None
            arg.as_expr() ?? return None
        }
        .None -> marker.expr_arg(0) ?? return None
    }
    shape_static_string(expression)
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:103
fn shape_static_string(expression: Expr) -> String? Never! {
    if expression == .Str(parts, _) {
        part :: parts.first() ?? return None
        if part == .Lit(value) -> return Val(value)
    }
    None
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:112
fn shape_rename_all_style(structure: StructDef) -> String? Never! {
    marker :: structure.serde_markers.find(fn(marker) { marker.name == Syntax.MARKER_RENAME_ALL }) ?? return None
    expression :: marker.expr_arg(0) ?? return None
    if expression == .Ident(name, _) -> Val(name) else -> None
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:124
fn shape_rename_all_name(style: String?, name: String) -> String Never! {
    if style == {
        .Val("camel") -> Syntax.to_camel_acronym(name)
        .Val("kebab") -> Syntax.to_snake_acronym(name).replace('_', "-")
        .Val("screaming") -> Syntax.to_shouty_acronym(name)
        .Val("pascal") -> Syntax.to_pascal_acronym(name)
        .Val("snake") -> Syntax.to_snake_acronym(name)
        else -> name
    }
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:139
pub struct CanonicalMigrationShape {
    pub names: [String:String]
    pub current: [String:Bool]
    pub historical: [[String]]
    pub skipped: [String:Bool]
    rename_all: String?
    // Rust: crates/jet-sema/src/Sema/Schema.rs:157
    pub fn json_key(self, field: String) -> String Never! {
        self.names.get(field) ?? shape_rename_all_name(self.rename_all, field)
    }
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:167
pub fn canonical_migration_shape(source: String, structure: StructDef, blocks: [MigrationDecl]) -> CanonicalMigrationShape ShapeError! {
    fact :: shape_fact_from_struct(source, structure)?
    names := [String:String]{}
    current := [String:Bool]{}
    skipped := [String:Bool]{}
    loop field in fact.fields {
        json_name :: field.names.name_for(ShapeProjectionKind.Json).expect("canonical shape field must have a JSON projection name").to_string()
        names[field.name] = json_name
        if field.skip -> skipped[json_name] = true else -> current[json_name] = true
    }
    rename_all :: shape_rename_all_style(structure)
    json_key :: fn(field: String) -> String Never! { names.get(field) ?? shape_rename_all_name(rename_all, field) }
    shape := ~current
    historical := [[String]]{}
    loop block in blocks.rev() {
        loop op in block.ops {
            if op == {
                .Add{field, ..} -> { _ :: &shape.remove(json_key(field)) }
                .Remove{field, ..} -> shape[json_key(field)] = true
                .Rename{from, to, ..} -> { _ :: &shape.remove(json_key(to)); shape[json_key(from)] = true }
                .Change{..} -> {}
            }
        }
        keys := shape.keys().to_array()
        &keys.sort()
        &historical.push(keys)
    }
    &historical.reverse()
    Ok(CanonicalMigrationShape{names: names, current: current, historical: historical, skipped: skipped, rename_all: rename_all})
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:226
fn shape_type(source: String, ty: Type) -> ShapeType Never! {
    if ty == {
        .Int | .IntN{..} -> ShapeType.Int
        .Float | .Float32 -> ShapeType.Float
        .Bool -> ShapeType.Bool
        .String | .Char -> ShapeType.Text
        .List(inner) | .FixedList{elem: inner, ..} -> ShapeType.Array(shape_type(source, inner))
        .Option(inner) -> ShapeType.Optional(shape_type(source, inner))
        .Shared(inner) | .InlineRange{base: inner, ..} | .Tagged{inner, ..} | .Quantity{base: inner, ..} -> shape_type(source, inner)
        .Named(name) -> if name == {
            "Bool" -> ShapeType.Bool
            "Int" | "I8" | "I16" | "I32" | "I64" | "U8" | "U16" | "U32" | "U64" -> ShapeType.Int
            "Float" | "F32" | "F64" -> ShapeType.Float
            "String" | "Char" -> ShapeType.Text
            "Bytes" -> ShapeType.Bytes
            "Number" -> ShapeType.Number
            else -> ShapeType.Object(ShapeIdentity.new(source, name))
        }
        .Apply{name, ..} -> ShapeType.Unknown(name)
        .Map{..} -> ShapeType.Unknown("Map")
        .Result{..} | .Fn{..} | .TraitObject(_) | .Tuple(_) | .Union(_) | .Measure(_) -> ShapeType.Unknown(ty.name())
    }
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:262
fn shape_encoding(ty: ShapeType) -> ShapeEncoding Never! {
    if ty == {
        .Null -> ShapeEncoding.Null
        .Bool -> ShapeEncoding.Bool
        .Int -> ShapeEncoding.Int
        .Float -> ShapeEncoding.Float
        .Number -> ShapeEncoding.Number
        .Text | .Bytes -> ShapeEncoding.Text
        .Array(_) -> ShapeEncoding.Array
        .Optional(inner) -> shape_encoding(inner)
        .Object(_) | .Unknown(_) -> ShapeEncoding.Object
    }
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:276
fn shape_default(value: CtValue) -> ShapeDefault? Never! {
    if value == {
        .Int(value) -> Val(ShapeDefault.Int(I128{value}))
        .Float(value) -> Val(ShapeDefault.Float("{value:?}"))
        .Bool(value) -> Val(ShapeDefault.Bool(value))
        .Char(value) -> Val(ShapeDefault.Text(value.to_string()))
        .Str(value) -> Val(ShapeDefault.Text(value))
        .Bytes(value) -> Val(ShapeDefault.Bytes(value))
        .Present(value) -> shape_default(value)
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:289
pub SNAPSHOT_VERSION :: U32{1}
// Rust: crates/jet-sema/src/Sema/Schema.rs:294
pub struct SnapshotField { pub name: String, pub ty: String }
// Rust: crates/jet-sema/src/Sema/Schema.rs:301
pub struct SchemaSnapshot {
    pub schema_version: U32
    pub type_name: String
    pub published_version: String
    // Squashing makes these fields the authoritative baseline before this version.
    pub squashed_before: String?
    pub fields: [SnapshotField]
    // Rust: crates/jet-sema/src/Sema/Schema.rs:316
    pub fn write(self) -> String Never! {
        out := "schema_version = {self.schema_version}\ntype = {self.type_name}\npublished_version = {self.published_version}\n"
        if self.squashed_before == .Val(before) -> &out.push_str("squashed_before = {before}\n")
        loop field in self.fields -> &out.push_str("field {field.name}: {field.ty}\n")
        out
    }
    // Rust: crates/jet-sema/src/Sema/Schema.rs:331
    pub fn parse(raw: String) -> SchemaSnapshot Err! {
        schema_version := U32?{None}
        type_name := String?{None}
        published_version := String?{None}
        squashed_before := String?{None}
        fields := [SnapshotField]{}
        loop line in raw.lines() {
            line := line.trim() // #4303
            if line.is_empty() -> next
            if line.strip_prefix("schema_version = ") == .Val(rest) {
                schema_version = Val(U32.parse(rest).map_err(fn(_) { "invalid schema_version: {rest}" })?)
            } else if line.strip_prefix("type = ") == .Val(rest) {
                type_name = Val(rest.to_string())
            } else if line.strip_prefix("published_version = ") == .Val(rest) {
                published_version = Val(rest.to_string())
            } else if line.strip_prefix("squashed_before = ") == .Val(rest) {
                squashed_before = Val(rest.to_string())
            } else if line.strip_prefix("field ") == .Val(rest) {
                colon :: rest.find(':') ?? return Err("malformed field line: {line}")
                name := rest.slice(0, colon).trim() // #4303
                ty := rest.slice(colon + 1, rest.len()).trim() // #4303
                &fields.push(SnapshotField{name: name.to_string(), ty: ty.to_string()})
            } else -> return Err("unknown line in schema snapshot: {line}")
        }
        version :: schema_version ?? return Err("missing schema_version")
        name :: type_name ?? return Err("missing type")
        published :: published_version ?? return Err("missing published_version")
        Ok(SchemaSnapshot{schema_version: version, type_name: name, published_version: published, squashed_before: squashed_before, fields: fields})
    }
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:378
pub fn snapshot_from_struct(s: StructDef, version: String) -> SchemaSnapshot Never! {
    SchemaSnapshot{schema_version: SNAPSHOT_VERSION, type_name: s.name, published_version: version, squashed_before: None, fields: loop field in s.fields -> SnapshotField{name: field.name, ty: field.ty.name()}}
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:397
pub fn load_snapshot(project_root: OSPath, type_name: String) -> SchemaSnapshot? -[Env, FS.Read]> {
    base :: if CheckReads.env_var("JET_SCHEMA_CACHE_DIR") == .Val(override_dir) -> OSPath.from(override_dir) else -> project_root.join(Syntax.SOURCE_ROOT_DIR).join(Syntax.SCHEMA_CACHE_SUBDIR)
    raw :: CheckReads.read_to_string(base.join("{type_name}.snapshot")).ok() ?? return None
    SchemaSnapshot.parse(raw).ok()
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:411
pub fn save_snapshot(project_root: OSPath, snap: SchemaSnapshot) Err! -[FS]> {
    dir :: project_root.join(Syntax.SOURCE_ROOT_DIR).join(Syntax.SCHEMA_CACHE_SUBDIR)
    files.mkdir(dir, true).map_err(fn(error) { "could not create schema cache dir: {error}" })?
    files.write(dir.join("{snap.type_name}.snapshot"), snap.write()).map_err(fn(error) { "could not write schema snapshot: {error}" })
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:424
pub fn schema_cache_dir(project_root: OSPath) -> OSPath -[Env]> {
    if CheckReads.env_var("JET_SCHEMA_CACHE_DIR") == .Val(override_dir) -> OSPath.from(override_dir) else -> project_root.join(Syntax.SOURCE_ROOT_DIR).join(Syntax.SCHEMA_CACHE_SUBDIR)
}
// Rust: crates/jet-sema/src/Sema/Schema.rs:436
pub fn load_all_snapshots(project_root: OSPath) -> [SchemaSnapshot] -[Env, FS.Read]> {
    out := [SchemaSnapshot]{}
    if CheckReads.read_dir_sorted(schema_cache_dir(project_root)) == .Ok(entries) {
        loop path in entries {
            if path.extension().and_then(fn(value) { value.to_str() }) != Val("snapshot") -> next
            if CheckReads.read_to_string(path) == .Ok(raw) {
                if SchemaSnapshot.parse(raw) == .Ok(snap) -> &out.push(snap)
            }
        }
    }
    &out.sort_by(fn(a, b) { a.type_name <=> b.type_name })
    out
}
