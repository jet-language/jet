// The Core seal: what a program bound to the Core image may know of a Core
// function without checking its body or any body it reaches. The Core
// library's check, with every Core body checked (JetCLI CoreLibrary.jet),
// summarizes each Core function whose whole reach leaves the passes after
// the body checks nothing a program can change (sema_core_seal_lines), and
// the library writes the summaries as `{prefix}.seal`, one line each:
//
//   key<TAB>flags[<TAB>effect]...
//
// sorted by key. The flags are letters, in this order:
//   S  a stand-in: a program may take this summary for the function's body
//      and everything it reaches (sema_core_seal_stand_in_effects,
//      sema_core_seal_stand_in_failure);
//   P  it reaches a stop (`Panic`);
//   W  it, or a function it reaches, writes module state;
//   I  the failure solve proves it infallible over what it reaches alone,
//      none of it taken as a value;
//   G  its failure union is the general `Err` (sema_failure_union_infer).
// The effects of an S line are its solved row without the stop, which is
// also every direct effect of its reach: a stand-in's own direct row.
//
// A line with I but not S names a function a stand-in may rely on: a
// program that takes it as a value makes it fallible to the solve, so such
// a program checks the Core bodies it reaches instead. The library writes
// an S only on a function its machine code seals (sema_core_seal_bound).
use jet_foundation.[
    Span,
    TEffectFacts,
    TEffectSpan,
    decl_id_index,
    decl_table_find,
    symbol_table_key,
]

// The flag letters of a seal line (above).
SEMA_CORE_SEAL_STAND_IN: "S"

SEMA_CORE_SEAL_PANIC: "P"

SEMA_CORE_SEAL_WRITES: "W"

SEMA_CORE_SEAL_INFALLIBLE: "I"

SEMA_CORE_SEAL_GENERAL: "G"

// The edge a body that may stop has (sema_effect_solve).
SEMA_CORE_SEAL_PANIC_EDGE: "__jet_panic__"

// One Core function's effect summary from the Core library's effect graph
// (sema_effect_core_seal_rows): its key, its solved row without the stop,
// whether it reaches a stop, and whether its reach writes module state.
SemaCoreSealEffects: struct {
    key: String,
    effects: [String],
    panic: Bool,
    writes: Bool,
}

// The failure summaries of the Core library's check
// (sema_core_seal_failure), by callable row (decl_id_index): the keys the
// solve proves infallible over their own reach (`infallible`, true), the
// unannotated top-level functions whose joined union may hold a member
// (`unclean`) and those whose union is the general `Err` (`general`).
// `keys` lists the inferred ones' keys. `views`: the functions whose
// checked return carries view provenance, which a caller's check reads
// from the checked body, so none of them is a stand-in.
SemaCoreSealFailure: struct {
    infallible: [Int:Bool],
    unclean: [Int:Bool],
    general: [Int:Bool],
    keys: [String],
    views: [Int:Bool]{[Int:Bool]{}},
}

sema_core_seal_failure_none: fn() -> SemaCoreSealFailure Never! {
    SemaCoreSealFailure{infallible: [Int:Bool]{}, unclean: [Int:Bool]{}, general: [Int:Bool]{}, keys: [String]{}}
}

// The callable row of `key` in `graph`'s declaration table.
sema_core_seal_row: fn(graph: SemaRegistrationGraph, key: String) -> Int? Never! {
    id: decl_table_find(graph.decls, graph.symbols, key) ?? return None
    Val(decl_id_index(id))
}

// The failure summaries of every checked body in `modules` but the entry
// module's (the Core check's scratch entry, which no Core code calls), read
// before the solve's projections change any declaration
// (sema_finalize_program). The solve is sema_failure_solve's with no
// function taken as a value, so each key's verdict depends on its own reach
// alone; the union rows are sema_failure_union_infer's, joined over their
// edges.
sema_core_seal_failure: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult]) -> SemaCoreSealFailure Never! {
    seal := sema_core_seal_failure_none()
    entry_index: sema_registration_module_index(graph, graph.entry_module_identity) ?? -1
    // The solve's candidates, each with its edges' rows (-1: no callable).
    rows := [Int]{}
    edges := [[Int]]{}
    loop module_result in modules {
        source_index: sema_registration_module_index(graph, module_result.module_identity) ?? next
        if source_index == entry_index -> next
        loop function in module_result.functions {
            if function.return_view_provenance == None -> next
            row: sema_core_seal_row(graph, function.key) ?? next
            seal.views[row] = true
        }
        loop facts in module_result.failure_facts {
            if facts.direct -> next
            callable: sema_registration_callable_row(graph, facts.function_key) ?? next
            if !sema_failure_row_in_module(graph, callable, source_index) || !sema_failure_row_candidate(graph, callable) {
                next
            }
            row: sema_core_seal_row(graph, facts.function_key) ?? next
            if seal.infallible.get(row) == None -> seal.keys.push(facts.function_key)
            seal.infallible[row] = true
            rows.push(row)
            edges.push(loop edge in facts.edges -> sema_core_seal_row(graph, edge) ?? -1)
        }
    }
    // A per-callable `#Import(c)` declaration's body is empty: a candidate
    // with no edge, as sema_failure_solve has it.
    loop module_index in 0..<graph.modules.len() {
        if module_index == entry_index -> next
        loop function_index in 0..<graph.modules[module_index].functions.len() {
            declaration: graph.modules[module_index].functions[function_index].declaration
            if !sema_function_is_guest_import(declaration) || !sema_failure_inference_candidate(declaration) {
                next
            }
            key: symbol_table_key(graph.symbols, graph.modules[module_index].functions[function_index].symbol.id)
            row: sema_core_seal_row(graph, key) ?? next
            if seal.infallible.get(row) != None -> next
            seal.infallible[row] = true
            seal.keys.push(key)
            rows.push(row)
            edges.push([Int]{})
        }
    }
    sema_core_seal_fixpoint(seal.infallible, rows, edges)
    inferred := [String]{}
    loop key in seal.keys {
        row: sema_core_seal_row(graph, key) ?? next
        if seal.infallible.get(row) ?? false -> inferred.push(key)
    }
    seal.keys = inferred.move()
    sema_core_seal_unions(graph, modules, seal)
    seal
}

// sema_failure_fixpoint over callable rows: each candidate of `rows` starts
// inferred in `inferred`; one with an edge to a row that is not, or is no
// longer, falls, and its fall reaches every candidate with an edge to it.
sema_core_seal_fixpoint: fn(inferred: &[Int:Bool], rows: [Int], edges: [[Int]]) Never! {
    slots := [Int:Int]{}
    dependents := [[Int]]{}
    fallen := [Int]{}
    loop at in 0..<rows.len() {
        loop edge in edges[at] {
            if !(inferred.get(edge) ?? false) {
                if inferred.get(rows[at]) ?? false {
                    inferred[rows[at]] = false
                    fallen.push(rows[at])
                }
                next
            }
            slot := slots.get(edge) ?? -1
            if slot < 0 {
                slot = dependents.len()
                slots[edge] = slot
                dependents.push([Int]{})
            }
            dependents[slot].push(at)
        }
    }
    loop fallen.len() > 0 {
        row: fallen.pop() ?? break
        slot: slots.get(row) ?? next
        loop at in dependents[slot] {
            if inferred.get(rows[at]) ?? false {
                inferred[rows[at]] = false
                fallen.push(rows[at])
            }
        }
    }
}

// The union rows of sema_failure_union_infer (the unannotated top-level
// functions, but the entry module's `run`), joined over their edges: a row
// is unclean when it, or a row it reaches, holds a member or mints a case,
// and general when it is, or an edge leaves the rows or reaches a general
// one.
sema_core_seal_unions: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], seal: &SemaCoreSealFailure) Never! {
    entry_index: sema_registration_module_index(graph, graph.entry_module_identity) ?? -1
    rows := [Int]{}
    edges := [[Int]]{}
    loop module_result in modules {
        module_index: sema_registration_module_index(graph, module_result.module_identity) ?? next
        loop facts in module_result.failure_facts {
            function_row: sema_failure_function_row(graph, module_index, facts.function_key)
            if function_row < 0 || !sema_failure_inference_candidate(graph.modules[module_index].functions[function_row].declaration) {
                next
            }
            if module_index == entry_index && graph.modules[module_index].functions[function_row].declaration.name == "run" {
                next
            }
            row: sema_core_seal_row(graph, facts.function_key) ?? next
            unclean: facts.union_members.len() > 0 || facts.union_cases.len() > 0
            seal.unclean[row] = (seal.unclean.get(row) ?? false) || unclean
            seal.general[row] = (seal.general.get(row) ?? false) || facts.union_general
            rows.push(row)
            edges.push(loop edge in facts.union_edges -> sema_core_seal_row(graph, edge) ?? -1)
        }
    }
    changed := true
    loop changed {
        changed = false
        loop at in 0..<rows.len() {
            row: rows[at]
            loop edge in edges[at] {
                if edge == row -> next
                reached_unclean: seal.unclean.get(edge) ?? false
                reached_general: if seal.general.get(edge) == .Val(general) -> general else -> true
                if reached_unclean && !(seal.unclean.get(row) ?? false) {
                    seal.unclean[row] = true
                    changed = true
                }
                if reached_general && !(seal.general.get(row) ?? false) {
                    seal.general[row] = true
                    changed = true
                }
            }
        }
    }
}

// The seal lines (above) of the Core library's check: a stand-in line for
// each Core function `effects` summarizes whose union row, if it has one,
// is clean and whose return carries no view provenance, and an I line for
// each other inferred-infallible key; sorted.
sema_core_seal_lines: fn(graph: SemaRegistrationGraph, failure: SemaCoreSealFailure, effects: [SemaCoreSealEffects]) -> [String] Never! {
    lines := [String]{}
    stood := [Int:Bool]{}
    loop summary in effects {
        row: sema_core_seal_row(graph, summary.key) ?? next
        if failure.unclean.get(row) ?? false -> next
        if failure.views.get(row) != None -> next
        flags := SEMA_CORE_SEAL_STAND_IN
        if summary.panic -> flags = "{flags}{SEMA_CORE_SEAL_PANIC}"
        if summary.writes -> flags = "{flags}{SEMA_CORE_SEAL_WRITES}"
        if failure.infallible.get(row) ?? false -> flags = "{flags}{SEMA_CORE_SEAL_INFALLIBLE}"
        if failure.general.get(row) ?? false -> flags = "{flags}{SEMA_CORE_SEAL_GENERAL}"
        line := "{summary.key}\t{flags}"
        loop name in summary.effects -> line = "{line}\t{name}"
        lines.push(line)
        stood[row] = true
    }
    loop key in failure.keys {
        row: sema_core_seal_row(graph, key) ?? next
        if stood.get(row) != None -> next
        lines.push("{key}\t{SEMA_CORE_SEAL_INFALLIBLE}")
    }
    lines.sort()
    lines
}

// A seal as a program reads it: the seal's bytes, the lines of
// sema_core_seal_lines joined by newlines, sorted by key, as the Core
// library wrote them (sema_core_seal_bound). A program finds each line by
// its key when its Core demand names the function (sema_core_seal_line), so
// it reads only the lines of the Core functions it names, never the whole
// seal.
SemaCoreSeal: struct {
    bytes: [U8],
}

// One seal line: its flags and its effects.
SemaCoreSealLine: struct {
    flags: String,
    effects: [String],
}

// The newline that ends a seal line, and the tab that ends its key.
SEMA_CORE_SEAL_NEWLINE: U8{10}

SEMA_CORE_SEAL_TAB: U8{9}

// The seal `lines` (sema_core_seal_lines) of a Core library whose machine
// code seals the keys `sealed`, both sorted: a stand-in line whose key
// `sealed` does not list loses its S, as no call of it binds to the
// library's code, and a line left with no flag is left out. The Core
// library writes its seal so (JetCLI CoreLibrary.jet), and a program reads
// it as written.
sema_core_seal_bound: fn(lines: &&[String], sealed: [String]) -> [String] Never! {
    bound := [String]{}
    at := 0
    loop line in lines.move() {
        columns := line.split("\t").to_list()
        if columns.len() < 2 -> next
        loop at < sealed.len() && sealed[at] < columns[0] -> at += 1
        if at < sealed.len() && sealed[at] == columns[0] {
            bound.push(line)
            next
        }
        columns[1] = columns[1].replace(SEMA_CORE_SEAL_STAND_IN, "")
        if columns[1] == "" -> next
        bound.push(columns.join("\t"))
    }
    bound
}

// The line of `key` in `seal`, by a binary search over its bytes: each
// probe compares the key of the one line around its middle byte with
// `key`'s bytes, and only `key`'s line is split. None when the seal holds
// no line for `key`, or its line is not `key<TAB>flags[<TAB>effect]...`.
sema_core_seal_line: fn(seal: SemaCoreSeal, key: String) -> SemaCoreSealLine? Never! {
    wanted: key.bytes()
    low := 0
    high := seal.bytes.len()
    loop low < high {
        start := (low + high) /% 2
        loop start > low && seal.bytes[start - 1] != SEMA_CORE_SEAL_NEWLINE -> start -= 1
        order: sema_core_seal_key_order(seal.bytes, start, wanted)
        end := start
        loop end < seal.bytes.len() && seal.bytes[end] != SEMA_CORE_SEAL_NEWLINE -> end += 1
        if order == 0 {
            line: String.from_bytes(seal.bytes.slice(start, end)) ?? return None
            columns: line.split("\t").to_list()
            if columns.len() < 2 || columns[1] == "" -> return None
            return Val(SemaCoreSealLine{flags: columns[1], effects: loop index in 2..<columns.len() -> columns[index]})
        }
        if {
            order < 0 -> low = end + 1
            else -> high = start
        }
    }
    None
}

// How the key of the seal line at byte `start` of `bytes` sorts against the
// key bytes `wanted`: below 0 before it, 0 the same, above 0 after it. Byte
// order is the order the seal's lines are sorted in, as a line's key ends
// at a tab, below every byte a key spells.
sema_core_seal_key_order: fn(bytes: [U8], start: Int, wanted: [U8]) -> Int Never! {
    at := start
    loop {
        index: at - start
        if at == bytes.len() || bytes[at] == SEMA_CORE_SEAL_NEWLINE || bytes[at] == SEMA_CORE_SEAL_TAB {
            return if index < wanted.len() -> -1 else -> 0
        }
        if index == wanted.len() -> return 1
        if bytes[at] != wanted[index] -> return if bytes[at] < wanted[index] -> -1 else -> 1
        at += 1
    }
}

// The host's read of the Core seal of a `jet run` that binds to the Core
// image (SemaRegistrationHostHooks.core_seal), which the host offers only to
// a run whose Core is the image's. The Core demand reads it once, when it
// first names a deferred Core body (CoreDemand.jet sema_core_stand_in_bind),
// so a run whose demand names none never reads the seal.
SemaCoreSealSource: trait {
    read: fn(self) -[FS, Env]> SemaCoreSeal?,
}

// Whether the host hooks behind `access` hold a Core seal not yet read.
sema_core_seal_offered: fn(access: SemaHostHookAccess?) -> Bool {
    hooks: sema_host_hook_callbacks(access) ?? return false
    permit: hooks.guard_read()
    permit.value.core_seal != None
}

// `key`'s line in `seal` when it is a stand-in line.
sema_core_seal_stand_in: fn(seal: SemaCoreSeal, key: String) -> SemaCoreSealLine? Never! {
    line: sema_core_seal_line(seal, key) ?? return None
    if !line.flags.contains(SEMA_CORE_SEAL_STAND_IN) -> return None
    Val(line)
}

// Whether a program that takes `key` as a value changes what a stand-in of
// `seal` may assume: a stand-in itself, or an inferred-infallible key one
// may reach.
sema_core_seal_valued: fn(seal: SemaCoreSeal, key: String) -> Bool Never! {
    line: sema_core_seal_line(seal, key) ?? return false
    line.flags.contains(SEMA_CORE_SEAL_STAND_IN) || line.flags.contains(SEMA_CORE_SEAL_INFALLIBLE)
}

// The effect facts of the stand-in `line`, whose source is `span`: its
// effects as its direct row, the stop edge when it reaches one, and one
// write when its reach writes module state, named by `key`. The effect
// graph solves it to the library's row (sema_effect_solve), and the
// driver's walks find the same direct effects as along the bodies it
// stands for (JetDriver Pipeline.jet jet_driver_required_effects).
sema_core_seal_stand_in_effects: fn(line: SemaCoreSealLine, key: String, span: Span) -> TEffectFacts Never! {
    edges := [String]{}
    if line.flags.contains(SEMA_CORE_SEAL_PANIC) -> edges.push(SEMA_CORE_SEAL_PANIC_EDGE)
    writes := [TEffectSpan]{}
    if line.flags.contains(SEMA_CORE_SEAL_WRITES) -> writes.push(TEffectSpan{name: key, span: span})
    spans: loop name in line.effects -> TEffectSpan{name: name, span: span}
    TEffectFacts{direct: line.effects, solved: [String]{}, call_edges: edges, maximal: false, direct_spans: spans, module_writes: writes}
}

// The failure facts of the stand-in `line` for `key`: a failure source of
// its own unless the solve proved it infallible, no edge, and an empty
// union row, general as the library joined it.
sema_core_seal_stand_in_failure: fn(line: SemaCoreSealLine, key: String) -> SemaFunctionFailureFacts Never! {
    SemaFunctionFailureFacts{
        function_key: key,
        direct: !line.flags.contains(SEMA_CORE_SEAL_INFALLIBLE),
        edges: [String]{},
        union_general: line.flags.contains(SEMA_CORE_SEAL_GENERAL),
    }
}

// What the check of a stand-in takes from the Core seal for its body.
SemaCoreStandIn: struct {
    effects: TEffectFacts,
    failure: SemaFunctionFailureFacts,
}

// The seal facts of the function `key`, whose source is `span`, when its
// check is a stand-in's: a body of a stand-in wave of a bound run's Core
// demand (CoreDemand.jet sema_core_stand_in_flush), whose bodies all have
// stand-in lines in the run's seal (graph.core_stand_ins).
sema_core_stand_in: fn(program: SemaProgramTables, key: String, span: Span) -> SemaCoreStandIn? Never! {
    if program.registration_graph == .Val(graph) {
        if !graph.core_stand_in_wave || graph.core_wave_rows.get(key) == None -> return None
        if graph.core_stand_ins == .Val(seal) {
            line: sema_core_seal_stand_in(seal, key) ?? return None
            return Val(SemaCoreStandIn{effects: sema_core_seal_stand_in_effects(line, key, span), failure: sema_core_seal_stand_in_failure(line, key)})
        }
    }
    None
}
