// Retain the declaration-comptime result on the same AST field that owns it.
// Schema.shape_fact_from_struct reads Field.default_ct, not source expressions.
use jet_foundation.[Program, Item, TComptimeValue, SymbolID, SymbolTable, symbol_find]

sema_checked_shape_defaults: fn(program: ^^Program, registered: SemaRegistrationModule, symbols: SymbolTable, values: [SemaComptimeItemValue]) -> Program Never! {
    ^updated_program: program.move()
    ^defaults: [U32:TComptimeValue]{}
    loop value in values {
        if value.module_identity != registered.module_identity || value.kind != SemaComptimeItemKind.FieldDefault {
            next
        }
        destination: symbol_find(symbols, value.destination_key) ?? next
        if defaults.get(destination.id) == .None -> defaults[destination.id] = value.value
    }
    if defaults.len() == 0 -> return updated_program
    ^reversed: [Item]{}
    loop updated_program.items.len() > 0 {
        if updated_program.items.pop() == .Val(item) -> reversed.push(item)
    }
    loop reversed.len() > 0 {
        item: reversed.pop() ?? break
        ^nominal_index: Int?{None}
        if item == .Struct(definition) {
            loop (candidate_index, candidate) in registered.nominals {
                if candidate.symbol.name == definition.name -> nominal_index = Val(candidate_index)
            }
        }
        if nominal_index == .Val(owner_index) {
            if item.move() == .Struct(source_definition) {
                ^updated: source_definition.move()
                owner: registered.nominals[owner_index]
                loop field_index in 0..<updated.fields.len() {
                    field: updated.fields[field_index]
                    if field.default_ct != None -> next
                    ^destination: SymbolID?{None}
                    loop checked in owner.fields {
                        if checked.symbol.name == field.name -> destination = Val(checked.symbol.id)
                    }
                    found: destination ?? next
                    value: defaults.get(found.id) ?? next
                    retained: sema_user_template_ct_value(value) ?? next
                    updated.fields[field_index].default_ct = Val(retained)
                }
                updated_program.items.push(Item.Struct{value: updated})
            }
            next
        }
        updated_program.items.push(item)
    }
    updated_program
}
