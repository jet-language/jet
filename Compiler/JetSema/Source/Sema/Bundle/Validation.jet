//RS         ct_keys: Vec<String>,
//RS         /// A method is checked with its owner's generic parameters in scope;
//RS         /// these are the parameters its declaration keeps afterwards.
//RS         restore_type_params: Option<Vec<crate::AST::TypeParam>>,
//RS         /// For a method of a compiler-generated trait-impl block, the block's
//RS         /// trait span (the derived type's name): where its diagnostics land.
//RS         generated_anchor: Option<crate::Diagnostics::Span>,
