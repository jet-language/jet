        if self.kind == .InlineModule(function: f, ..) -> return @f
        if self.kind == .Test(function: f, ..) -> return @f
        if self.kind == .ErrorConv(function: f, ..) -> return @f
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1233
    fn function_mut(&self) -> &Func Never! from self {
        if self.kind == .Function(function: f, ..) -> return &f
        if self.kind == .InlineModule(function: f, ..) -> return &f
        if self.kind == .Test(function: f, ..) -> return &f
        if self.kind == .ErrorConv(function: f, ..) -> return &f
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1246
fn collect_body_jobs(items: &[Item], st: ModuleState, module_key: String, mode: CompileMode, invalid_serde_impls: [(String, String):Bool]) -> [BodyJob] Never! from items {
    jobs := [BodyJob]{}
    loop &item in &items {
        if item == .Func(f) -> &jobs.push(BodyJob{owner: None, raw_protocol_return: false, kind: .Function(function: &f, cache_key: "{module_key}::fn:{f.name}", ct_keys: [~f.name], restore_type_params: None, generated_anchor: None)})
        if item == .Struct(s) -> push_owner_method_jobs(&jobs, module_key, "struct", s.name, s.type_params, &s.methods, &s.trait_impls)
        if item == .Enum(e) -> push_owner_method_jobs(&jobs, module_key, "enum", e.name, e.type_params, &e.methods, &e.trait_impls)
        if item == .Impl(i) {
            if i.trait_name == .Val(trait_name) && i.is_generated_serde && invalid_serde_impls.has_key((i.type_name, trait_name)) -> continue
            owner_params :: st.trait_reg.struct_params.get(i.type_name).or_else(fn() { st.trait_reg.enum_params.get(i.type_name) })
            type_name :: ~i.type_name
            trait_name :: ~i.trait_name
            loop &m in &i.methods {
                own_params :: ^m.type_params
                m.type_params = if own_params.is_empty() { owner_params.cloned().unwrap_or_default() } else { ~own_params }
                raw :: uses_raw_protocol_function_return(trait_name, false, m)
                &jobs.push(BodyJob{owner: Val(~type_name), raw_protocol_return: raw, kind: .Function(function: &m, cache_key: "{module_key}::impl:{type_name}::{trait_name.unwrap_or("inherent")}::method:{m.name}", ct_keys: ["{type_name}::{m.name}", ~m.name], restore_type_params: Val(own_params), generated_anchor: None)})
            }
        }
        if item == .Test(t) && (mode == CompileMode.Test || mode == CompileMode.TestOverride) {
            if t.name == .Val(test_name) {
                param_diagnostics :: t.params.filter_map(fn(p) { property_param_unsupported(p.ty, p.ty_span) }).collect()
                body :: ^t.body
                t.body = []
                function := Func.implicit_run(body, t.span)
                function.name = "__test_{test_name}"
                function.name_span = t.name_span
                function.params = ~t.params
                &jobs.push(BodyJob{owner: None, raw_protocol_return: false, kind: .Test(test: &t, function: ^function, param_diagnostics: param_diagnostics)})
            }
        }
        if item == .CodeModule(cm) {
            module :: ~cm.name
            if cm.body == .Val(body) {
                loop &inner in &body -> if inner == .Func(f) -> &jobs.push(BodyJob{owner: None, raw_protocol_return: false, kind: .InlineModule(function: &f, module: ~module)})
            }
        }
        if item == .ErrorConv(ec) {
            function :: error_conversion_function(&ec)
            &jobs.push(BodyJob{owner: Val(~ec.from_ty), raw_protocol_return: false, kind: .ErrorConv(conversion: &ec, function: function)})
        }
    }
    jobs
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1405
fn push_owner_method_jobs(jobs: &[BodyJob], module_key: String, kind: String, owner: String, owner_params: [TypeParam], methods: &[Func], trait_impls: &[TraitImplBlock]) Never! {
    loop &m in &methods {
        own_params :: ^m.type_params
        m.type_params = if own_params.is_empty() { ~owner_params } else { [] }
        &jobs.push(BodyJob{owner: Val(~owner), raw_protocol_return: false, kind: .Function(function: &m, cache_key: "{module_key}::{kind}:{owner}::method:{m.name}", ct_keys: ["{owner}::{m.name}", ~m.name], restore_type_params: Val(own_params), generated_anchor: None)})
    }
    loop &block in &trait_impls {
        trait_name :: ~block.trait_name
        compiler_generated :: block.compiler_generated
        generated_anchor :: if compiler_generated { Val(block.trait_span) } else { None }
        loop &m in &block.methods {
            own_params :: ^m.type_params
            m.type_params = if own_params.is_empty() { ~owner_params } else { ~own_params }
            restore_type_params :: if trait_name == ENCODE || trait_name == DECODE { [] } else { own_params }
            raw :: uses_raw_protocol_function_return(Val(trait_name), compiler_generated, m)
            &jobs.push(BodyJob{owner: Val(~owner), raw_protocol_return: raw, kind: .Function(function: &m, cache_key: "{module_key}::{kind}:{owner}::trait:{trait_name}::method:{m.name}", ct_keys: ["{owner}::{m.name}", ~m.name], restore_type_params: Val(restore_type_params), generated_anchor: generated_anchor)})
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1474
struct BodyOutcome { diagnostics: [Diagnostic], products: BodyProducts, ledger: NameLedger }
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1481
fn check_body_job(cx: BodyContext, job: &BodyJob, checked_ct_funcs: [String:Func], name_ledger: NameLedger, cache: &IncrementalSemaCache?, cache_allowed: Bool) -> BodyOutcome Never! {
    ledger := name_ledger.body_snapshot()
    products := BodyProducts.default()
    owner :: job.owner
    raw :: job.raw_protocol_return
    diagnostics := [Diagnostic]{}
    if job.kind == .Function(function: function, cache_key: cache_key, ..) {
        tracked :: cache_allowed && ItemReuse.tracks(cx.module_idx)
        if tracked && ItemReuse.reuse(cx.module_idx, cache_key, &function, owner, raw, &ledger, &products) -> return BodyOutcome{diagnostics: [], products: ^products, ledger: ^ledger}
        pristine :: if tracked { Val(~function) } else { None }
        if cache == .Val(c) {
            diagnostics = check_func_body_cached(cx, ~cache_key, &function, owner, raw, checked_ct_funcs, &ledger, &products, &c, cache_allowed)
        } else {
            diagnostics = check_func_body(cx, &function, owner, raw, None, Val(checked_ct_funcs), &ledger, &products)
        }
        if pristine == .Val(pristine_function) -> ItemReuse.record(cx.module_idx, cache_key, pristine_function, function, owner, raw, diagnostics, products, ledger)
    }
    if job.kind == .Test(function: function, ..) -> diagnostics = check_func_body(cx, &function, None, false, None, Val(checked_ct_funcs), &ledger, &products)
    if job.kind == .InlineModule(function: function, module: module) -> diagnostics = check_func_body(cx, &function, None, false, Val(module), Val(checked_ct_funcs), &ledger, &products)
    if job.kind == .ErrorConv(function: function, ..) {
        conversion_cx :: BodyContext{no_os: false, gates: GateSet.default(), ..cx}
        diagnostics = check_func_body(conversion_cx, &function, owner, false, None, Val(checked_ct_funcs), &ledger, &products)
    }
    BodyOutcome{diagnostics: ^diagnostics, products: ^products, ledger: ^ledger}
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1609
struct MainBodyPass {
    cx: @BodyContext, checked_ct_funcs: &[String:Func], name_ledger: &NameLedger, products: &BodyProducts,
    diags: &[Diagnostic], incremental: &IncrementalSemaCache?, cache_allowed: Bool
