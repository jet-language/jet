// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:795
fn named_callable_policy_targets(items: [Item], names: [String:Bool], targets: &[Func]) Never! {
    loop item in items {
        if item == .Func(f) && names.has_key(f.name) -> &targets.push(~f)
        if item == .Struct(d) {
            collect_named_callable_policy_functions(d.methods, names, &targets)
            loop i in d.trait_impls -> collect_named_callable_policy_functions(i.methods, names, &targets)
        }
        if item == .Enum(d) {
            collect_named_callable_policy_functions(d.methods, names, &targets)
            loop i in d.trait_impls -> collect_named_callable_policy_functions(i.methods, names, &targets)
        }
        if item == .Impl(i) -> collect_named_callable_policy_functions(i.methods, names, &targets)
        if item == .CodeModule(m) && m.body == .Val(body) -> named_callable_policy_targets(body, names, &targets)
        if item == .GenericModule(m) -> named_callable_policy_targets(m.body, names, &targets)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:844
fn callable_policy_wrapper_name(policy: String, target: String) -> String Never! { CallablePolicyChain.user_wrapper_name(policy, target) }
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:848
struct ComptimeStageJob { owner: String?, raw_protocol_return: Bool, function: @Func }
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:857
fn comptime_stage_jobs(items: [Item]) -> [String:ComptimeStageJob] Never! {
    jobs := [String:ComptimeStageJob]{}
    insert :: fn(key: String, owner: String?, raw: Bool, function: @Func) Never! { jobs[^key] = ComptimeStageJob{owner: owner, raw_protocol_return: raw, function: function} }
    loop item in items {
        if item == .Func(f) -> insert(~f.name, None, false, @f)
        if item == .Struct(d) {
            loop f in d.methods -> insert("{d.name}::{f.name}", Val(~d.name), false, @f)
            loop i in d.trait_impls -> loop f in i.methods -> insert("{d.name}::{f.name}", Val(~d.name), uses_raw_protocol_function_return(Val(i.trait_name), i.compiler_generated, f), @f)
        }
        if item == .Enum(d) {
            loop f in d.methods -> insert("{d.name}::{f.name}", Val(~d.name), false, @f)
            loop i in d.trait_impls -> loop f in i.methods -> insert("{d.name}::{f.name}", Val(~d.name), uses_raw_protocol_function_return(Val(i.trait_name), i.compiler_generated, f), @f)
        }
        if item == .Impl(i) -> loop f in i.methods -> insert("{i.type_name}::{f.name}", Val(~i.type_name), uses_raw_protocol_function_return(i.trait_name, false, f), @f)
    }
    jobs
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:942
fn comptime_stage_roots(items: [Item], raw_funcs: [String:@Func]) -> ([String:Bool], Bool) Never! {
    roots := [String:Bool]{}
    all_methods := false
    visit_function :: fn(f: Func) Never! {
        if !stmts_have_comptime_evaluation(f.body) -> return
        loop statement in f.body {
            statement.for_each_expr(fn(expression: Expr) Never! {
                if expression == .MethodCall(recv_type: None, ..) -> all_methods = true
                if expression is Expr.Call || expression is Expr.Ident || expression is Expr.MethodCall -> reachable_owned_function_roots(expression, raw_funcs, &roots)
            })
        }
    }
    loop item in items {
        if item == .Func(f) -> visit_function(f)
        if item == .Struct(d) {
            loop f in d.methods -> visit_function(f)
            loop i in d.trait_impls -> loop f in i.methods -> visit_function(f)
        }
        if item == .Enum(d) {
            loop f in d.methods -> visit_function(f)
            loop i in d.trait_impls -> loop f in i.methods -> visit_function(f)
        }
        if item == .Impl(i) -> loop f in i.methods -> visit_function(f)
    }
    (reachable_owned_function_closure(roots, raw_funcs), all_methods)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1016
fn stage_comptime_functions(cx: BodyContext, items: [Item], ct_funcs: [String:Func], name_ledger: NameLedger) -> [String:Func] Never! {
    stage_jobs :: comptime_stage_jobs(items)
    raw_eval_funcs := [String:@Func]{}
    loop (name, f) in ct_funcs -> raw_eval_funcs[~name] = @f
    loop (key, job) in stage_jobs -> raw_eval_funcs[~key] = job.function
    (stage_names, stage_all_methods) :: comptime_stage_roots(items, raw_eval_funcs)
    stage_keys := [String]{}
    loop (key, job) in stage_jobs -> if (stage_all_methods && job.owner != None) || stage_names.has_key(key) || stage_names.has_key(job.function.name) -> &stage_keys.push(~key)
    &stage_keys.sort()
    staged_unqualified := ~stage_names
    loop key in stage_keys -> if stage_jobs.get(key) == .Val(job) -> staged_unqualified[~job.function.name] = true
    stage :: fn(owner: String?, raw: Bool, original: Func) -> Func? Never! {
        function := ~original
        ledger := name_ledger.body_snapshot()
        products := BodyProducts.default()
        diagnostics :: check_func_body(cx, &function, owner, raw, None, None, &ledger, &products)
        if products.uses_exact_int -> cx.states[cx.module_idx].exact_int_reachable.set(true)
        if diagnostics.all(fn(d) { d.severity != Severity.Error }) -> return Val(^function)
        None
    }
    keyed :: stage_keys.filter_map(fn(key) { stage_jobs.get(key).map(fn(job) { (key, job) }) }).collect()
    staged :: Parallel.map_checked(keyed, fn(pair) { (pair.0, ~pair.1.owner, stage(pair.1.owner, pair.1.raw_protocol_return, pair.1.function)) })
    checked_ct_funcs := [String:Func]{}
    loop (key, owner, maybe_function) in staged {
        if maybe_function == .Val(function) {
            checked_ct_funcs[key] = ~function
            if owner == .Val(owner_name) -> checked_ct_funcs["{owner_name}::{function.name}"] = ~function
            checked_ct_funcs[~function.name] = ^function
        }
    }
    unqualified_keys := staged_unqualified.keys().collect()
    &unqualified_keys.sort()
    unqualified :: unqualified_keys.filter(fn(name) { !checked_ct_funcs.has_key(name) }).filter_map(fn(name) { ct_funcs.get(name).map(fn(f) { (name, f) }) }).collect()
    staged :: Parallel.map_checked(unqualified, fn(pair) { (pair.0, stage(None, false, pair.1)) })
    loop (name, maybe_function) in staged {
        if maybe_function == .Val(function) {
            checked_ct_funcs[name] = ~function
            checked_ct_funcs[~function.name] = ^function
        }
    }
    checked_ct_funcs
}
