        }
        if job.kind == .Test(test: test, function: f, param_diagnostics: param_diagnostics) {
            &self.diags.extend(param_diagnostics)
            &self.diags.extend(diagnostics)
            &self.merge_ledger(ledger)
            &self.products.absorb(^body)
            test.body = ^f.body
        }
        if job.kind == .InlineModule(function: f, module: module) {
            &self.diags.extend(diagnostics)
            &self.merge_ledger(ledger)
            summary :: &body.summaries.remove(f.name)
            function_key :: member_name(module, f.name)
            loop &pending in &body.pending_diagnostics -> pending.function_key = ~function_key
            &self.products.absorb(^body)
