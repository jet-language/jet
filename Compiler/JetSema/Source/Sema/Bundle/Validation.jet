// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:19
fn uses_raw_protocol_return(trait_name: String?, implementation_generated: Bool, function_generated: Bool) -> Bool Never! {
    if trait_name == .Val(name) {
        if name == DISPLAY || name == DEBUG || name == ENCODE || name == DECODE || name == EQUATABLE || name == COMPARABLE || name == ADD || name == SUB || name == MUL || name == DIV -> return true
    }
    implementation_generated && function_generated
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:44
fn uses_raw_protocol_function_return(trait_name: String?, implementation_generated: Bool, function: Func) -> Bool Never! {
    uses_raw_protocol_return(trait_name, implementation_generated, function.compiler_generated) || (function.compiler_generated && function.state_transition != None)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:61
fn qualified_effect_facts(modules: [(String, [String:EffectSummary])], sealed: [(String, [(String, EffectSummary)])], taint_seeds: [String:[String:Bool]]) -> ([String:EffectSummary], ReachabilityResult) Never! {
    locations := [String:[String]]{}
    aliases := [String:Bool]{}
    loop (alias, summaries) in modules {
        aliases[~alias] = true
        loop key in summaries.keys() -> &locations.entry(~key).or_default().push("{alias}::{key}")
    }
    loop (alias, nodes) in sealed -> loop (key, _) in nodes -> &locations.entry(~key).or_default().push("{alias}::{key}")
    qualified := [String:EffectSummary]{}
    loop (alias, nodes) in sealed -> loop (key, summary) in nodes -> qualified["{alias}::{key}"] = ~summary
    loop (alias, summaries) in modules {
        local_keys := [String:Bool]{}
        loop key in summaries.keys() -> local_keys[~key] = true
        resolve_edge :: fn(edge: String) -> String Never! {
            if edge == "__jet_panic__" -> return ~edge
            if local_keys.has_key(edge) -> return "{alias}::{edge}"
            if edge.split_once('.') == .Val((module, symbol)) && aliases.has_key(module) -> return "{module}::{symbol}"
            if locations.get(edge) == .Val(values) && values.len() == 1 -> return ~values[0]
            ~edge
        }
        loop (key, original) in summaries {
            summary := ~original
            summary.edges = summary.edges.map(resolve_edge).collect()
            loop &region in &summary.regions -> region.edges = region.edges.map(resolve_edge).collect()
            loop &obligation in &summary.callback_obligations -> obligation.edges = obligation.edges.map(resolve_edge).collect()
            loop &obligation in &summary.autodiff_obligations -> obligation.target = resolve_edge(obligation.target)
            loop &fact in &summary.discarded_results -> fact.callee = resolve_edge(fact.callee)
            loop &call in &summary.memory.calls -> call.callee = resolve_edge(call.callee)
            loop &region in &summary.memory.regions {
                region.edges = region.edges.map(resolve_edge).collect()
                loop &call in &region.calls -> call.callee = resolve_edge(call.callee)
            }
            qualified["{alias}::{key}"] = ^summary
        }
    }
    reachability := solve_reachability(qualified, taint_seeds)
    loop (short, values) in locations {
        if values.len() != 1 -> continue
        qualified_key :: values[0]
        if qualified.get(qualified_key) == .Val(summary) -> qualified[~short] = ~summary
        &reachability.copy_node(short, qualified_key)
    }
    (^qualified, ^reachability)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:206
fn taint_check_item(item: Item, scrubbers: [String:String], facts: FactRegistry, returns: [String:TagSet], return_types: ReturnTypes, field_tags: FieldTags, field_types: FieldTypes, core_imports: [String:String], diags: &[Diagnostic]) Never! {
    if item == .Func(f) -> &diags.extend(check_func_taint(f, None, scrubbers, facts, returns, return_types, field_tags, field_types, core_imports, diags))
    if item == .Impl(i) -> loop m in i.methods -> &diags.extend(check_func_taint(m, Val(i.type_name), scrubbers, facts, returns, return_types, field_tags, field_types, core_imports, diags))
    if item == .Struct(s) {
        loop m in s.methods -> &diags.extend(check_func_taint(m, Val(s.name), scrubbers, facts, returns, return_types, field_tags, field_types, core_imports, diags))
        loop block in s.trait_impls -> loop m in block.methods -> &diags.extend(check_func_taint(m, Val(s.name), scrubbers, facts, returns, return_types, field_tags, field_types, core_imports, diags))
    }
    if item == .Enum(e) -> loop m in e.methods -> &diags.extend(check_func_taint(m, Val(e.name), scrubbers, facts, returns, return_types, field_tags, field_types, core_imports, diags))
    if item == .Test(t) -> &diags.extend(check_body_tags(t.body, scrubbers, facts, returns, return_types, field_tags, field_types, core_imports, diags))
    if item == .ErrorConv(ec) -> &diags.extend(check_body_tags(ec.body, scrubbers, facts, returns, return_types, field_tags, field_types, core_imports, diags))
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:333
fn register_func_item(f: Func, st: &ModuleState, diags: &[Diagnostic], prelude_enabled: Bool) Never! {
    if f.name == BUILTIN_ASSERT_EQ {
        &diags.push(Diagnostic.error("E0106", "the name `{f.name}` is built in and can't be redefined", "`{f.name}` is provided by the language itself", "choose a different name for this function", Val(f.name_span)))
        return
    }
    if prelude_enabled && is_prelude_name(f.name) -> &diags.push(shadow_warning(f.name, f.name_span))
    if name_defined(f.name, st.funcs, st.registry, st.consts) {
        &diags.push(Diagnostic.error("E0105", "`{f.name}` is defined twice", "every function needs a unique name so calls aren't ambiguous", "rename or remove one of the definitions", Val(f.name_span)))
        return
    }
    if f.is_pub {
        loop p in f.params {
            if p.ty == Type.Bool && p.name != KW_SELF && p.default == None -> &diags.push(Diagnostic.lint("L2401", "public function `{f.name}` has a positional `Bool` parameter `{p.name}`", "positional booleans are easy to transpose at the call site", "callers can write `{p.name}: true` to make the intent clear (S61 labels)", Val(p.name_span)))
        }
    }
    check_default_forward_refs(f.params, f.name, &diags)
    st.funcs[~f.name] = func_to_sig(f)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:390
fn is_encoding_surface_type(name: String) -> Bool Never! {
    base :: name.rsplit('.').next().unwrap_or(name)
    base == "DataTree" || base == "EncodingFormat" || base == "DataJoin" || base == "Query" || base == "DataGroupedQuery" || base == "Group" || base == "EncodingLimits" || base == "EncodingError" || base == "CBOROptions" || base == "CBORError" || base == "CBORErrorKind" || base == "EncodingCause" || base == "EncodingErrorKind" || base == "DataEvent" || base == "JSONReader" || base == "JSONWriter" || base == "JSONLReader" || base == "JSONLWriter" || base == "CSVReader" || base == "CSVWriter" || base == "XMLReader" || base == "XMLWriter" || base == "CBORReader" || base == "CBORWriter"
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:425
fn type_mentions_encoding_surface(ty: Type) -> Bool Never! {
    if ty == .Named(name) -> return is_encoding_surface_type(name)
    if ty == .Apply(name, args) -> return is_encoding_surface_type(name) || args.any(type_mentions_encoding_surface)
    if ty == .TraitObject(names) -> return names.any(is_encoding_surface_type)
    if ty == .List(inner) -> return type_mentions_encoding_surface(inner)
    if ty == .Shared(inner) -> return type_mentions_encoding_surface(inner)
    if ty == .Option(inner) -> return type_mentions_encoding_surface(inner)
    if ty == .Tagged(inner, _) -> return type_mentions_encoding_surface(inner)
    if ty == .InlineRange(base: inner, ..) -> return type_mentions_encoding_surface(inner)
    if ty == .FixedList(elem: elem, ..) -> return type_mentions_encoding_surface(elem)
    if ty == .Map(key: key, value: value, ..) -> return type_mentions_encoding_surface(key) || type_mentions_encoding_surface(value)
    if ty == .Result(ok: ok, err: err) -> return type_mentions_encoding_surface(ok) || type_mentions_encoding_surface(err)
    if ty == .Fn(params: params, ret: ret, ..) -> return params.any(type_mentions_encoding_surface) || ret.is_some_and(type_mentions_encoding_surface)
    if ty == .Tuple(fields) -> return fields.any(fn(field) { type_mentions_encoding_surface(field.1) })
    if ty == .Union(members) -> return members.any(type_mentions_encoding_surface)
    if ty == .Quantity(base: base, ..) -> return type_mentions_encoding_surface(base)
    false
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:465
fn func_sig_mentions_encoding_surface(f: Func) -> Bool Never! {
    f.params.any(fn(p) { type_mentions_encoding_surface(p.ty) }) || f.return_type.is_some_and(type_mentions_encoding_surface)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:479
fn module_annotations_mention_encoding_surface(module: LoadedModule) -> Bool Never! {
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:480
    variant_payload_mentions :: fn(payload: VariantPayload) -> Bool Never! {
        if payload == .Single(ty, _) -> return type_mentions_encoding_surface(ty)
        if payload == .Named(fields) -> return fields.any(fn(f) { type_mentions_encoding_surface(f.ty) })
        false
    }
    loop item in module.items {
        if item == .Func(f) && func_sig_mentions_encoding_surface(f) -> return true
        if item == .Struct(s) {
            if s.fields.any(fn(f) { type_mentions_encoding_surface(f.ty) }) || s.methods.any(func_sig_mentions_encoding_surface) || s.trait_impls.any(fn(b) { b.methods.any(func_sig_mentions_encoding_surface) }) -> return true
        }
        if item == .Enum(e) {
            if e.variants.any(fn(v) { variant_payload_mentions(v.payload) }) || e.methods.any(func_sig_mentions_encoding_surface) || e.trait_impls.any(fn(b) { b.methods.any(func_sig_mentions_encoding_surface) }) -> return true
        }
        if item == .Impl(i) && (i.methods.any(func_sig_mentions_encoding_surface) || i.assoc_type_impls.any(fn(entry) { type_mentions_encoding_surface(entry.2) })) -> return true
        if item == .Trait(t) && t.methods.any(fn(m) { m.params.any(fn(p) { type_mentions_encoding_surface(p.ty) }) || m.return_type.is_some_and(type_mentions_encoding_surface) }) -> return true
        if item == .TypeAlias(a) && type_mentions_encoding_surface(a.target) -> return true
    }
    false
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:532
fn check_func_body_cached(cx: BodyContext, key: String, function: &Func, owner_type: String?, raw_protocol_return: Bool, ct_checked_funcs: [String:Func], ledger: &NameLedger, products: &BodyProducts, cache: &IncrementalSemaCache, cache_allowed: Bool) -> [Diagnostic] Never! {
    check :: fn(function: &Func, ledger: &NameLedger, products: &BodyProducts) { check_func_body(cx, &function, owner_type, raw_protocol_return, None, Val(ct_checked_funcs), &ledger, &products) }
    if !(cache_allowed && !stmts_have_comptime_evaluation(function.body)) {
        &cache.record_recompute(key)
        return check(&function, &ledger, &products)
    }
    input := debug_bytes(function)
    &input.push(if raw_protocol_return { 1 } else { 0 })
    if cache.get(key, input) == .Val(hit) {
        function = ^hit.function
        &products.summaries.extend(^hit.summaries)
        &products.embed_inputs.extend(^hit.comptime_inputs)
        &products.addr_taken.extend(^hit.address_taken)
        &ledger.merge_references(hit.name_ledger)
        &ledger.merge_structure_facts(hit.name_ledger)
        &products.pending_diagnostics.extend(^hit.pending_diagnostics)
        products.uses_exact_int |= hit.uses_exact_int
        &products.devtools_publications.extend(^hit.devtools_publications)
        return ^hit.diagnostics
    }
    diagnostics :: check(&function, &ledger, &products)
    if !products.embed_inputs.is_empty() {
        &cache.record_recompute(key)
        return diagnostics
    }
    &cache.store(key, CachedFunctionBody{input: ^input, function: ~function, diagnostics: ~diagnostics, summaries: ~products.summaries, comptime_inputs: [], address_taken: ~products.addr_taken, name_ledger: ~ledger, pending_diagnostics: ~products.pending_diagnostics, uses_exact_int: products.uses_exact_int, devtools_publications: ~products.devtools_publications})
    diagnostics
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:624
fn author_facing_diagnostics(generated_anchor: Span?, diagnostics: ^[Diagnostic]) -> [Diagnostic] Never! {
    if generated_anchor == .Val(anchor) {
        &diagnostics.retain(fn(d) { d.severity == Severity.Error })
        loop &diagnostic in &diagnostics {
            diagnostic.span = Val(anchor)
            &diagnostic.labels.clear()
        }
        &diagnostics.dedup_by(fn(later, earlier) { later.code == earlier.code && later.what == earlier.what })
    }
    ^diagnostics
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:642
fn has_callable_policy(function: Func) -> Bool Never! {
    function.markers.any(fn(marker) { marker.name == MARKER_POLICY && CallablePolicyChain.parse(marker.expr_args_owned()).is_ok() })
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:649
fn collect_callable_policy_functions(functions: [Func], targets: &[Func]) Never! {
    loop function in functions -> if has_callable_policy(function) -> &targets.push(~function)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:656
fn callable_policy_targets(items: [Item]) -> [Func] Never! {
    targets := [Func]{}
    loop item in items {
        if item == .Func(function) && has_callable_policy(function) -> &targets.push(~function)
        if item == .Struct(d) {
            collect_callable_policy_functions(d.methods, &targets)
            loop implementation in d.trait_impls -> collect_callable_policy_functions(implementation.methods, &targets)
        }
        if item == .Enum(d) {
            collect_callable_policy_functions(d.methods, &targets)
            loop implementation in d.trait_impls -> collect_callable_policy_functions(implementation.methods, &targets)
        }
        if item == .Impl(i) -> collect_callable_policy_functions(i.methods, &targets)
        if item == .CodeModule(m) && m.body == .Val(body) -> &targets.extend(callable_policy_targets(body))
        if item == .GenericModule(m) -> &targets.extend(callable_policy_targets(m.body))
    }
    targets
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:692
fn collect_callable_policy_apply_uses(items: &[Item], uses: &[String:[String]]) Never! {
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:696
    collect_func :: fn(function: &Func, uses: &[String:[String]]) Never! {
        loop &statement in &function.body {
            &statement.for_each_expr_mut(fn(expr: &Expr) Never! {
                if expr == .Call(call) {
                    if call.name != "apply" || call.args.is_empty() -> return
                    last :: call.args[call.args.len() - 1]
                    if last.flags.callable_policy == .Val(chain) {
                        target_name := None as String?
                        if last.expr == .Ident(name, _) -> target_name = Val(~name)
                        if last.expr == .Paren(inner, _) && inner == .Ident(name, _) -> target_name = Val(~name)
                        if target_name == .Val(name) {
                            policy_names :: chain.policies.filter(fn(policy) { !CallablePolicyChain.is_builtin(policy.name) }).map(fn(policy) { ~policy.name }).collect()
                            if policy_names.is_empty() -> return
                            entry := &uses.entry(name).or_default()
                            loop policy_name in policy_names -> if !entry.contains(policy_name) -> &entry.push(policy_name)
                        }
                    }
                }
            })
        }
    }
    loop &item in &items {
        if item == .Func(f) -> collect_func(&f, &uses)
        if item == .Struct(d) {
            loop &f in &d.methods -> collect_func(&f, &uses)
            loop &i in &d.trait_impls -> loop &f in &i.methods -> collect_func(&f, &uses)
        }
        if item == .Enum(d) {
            loop &f in &d.methods -> collect_func(&f, &uses)
            loop &i in &d.trait_impls -> loop &f in &i.methods -> collect_func(&f, &uses)
        }
        if item == .Impl(i) -> loop &f in &i.methods -> collect_func(&f, &uses)
        if item == .CodeModule(m) && m.body == .Val(body) -> collect_callable_policy_apply_uses(&body, &uses)
        if item == .GenericModule(m) -> collect_callable_policy_apply_uses(&m.body, &uses)
    }
}
