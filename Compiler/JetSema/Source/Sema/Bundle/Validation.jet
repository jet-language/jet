//RS     /// A `#Test` block, checked as a synthetic function.
//RS     Test {
//RS         test: &'m mut crate::AST::TestDef,
//RS         function: Func,
//RS         param_diagnostics: Vec<Diagnostic>,
//RS     },
//RS     /// A function of an inline code module, checked under its imports.
//RS     InlineModule { function: &'m mut Func, module: String },
//RS     /// An error conversion, checked as a synthetic function.
//RS     ErrorConv {
//RS         conversion: &'m mut crate::AST::ErrorConvDef,
//RS         function: Func,
//RS     },
//RS }
