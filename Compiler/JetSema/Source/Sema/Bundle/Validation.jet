//RS 
//RS /// I4: a diagnostic is a product, and a lint is advice addressed to whoever
//RS /// wrote the code. A compiler-generated derive body has no author and no
//RS /// user-typeable span: it is expanded from the provider template in
//RS /// `Prelude/Derives.jet`, so its spans are template offsets, not positions in
//RS /// the file that declares the type. A lint from that body names a construct
//RS /// the user never wrote. `L0502` did exactly that for any struct or enum with
//RS /// a `Float` field, because the package auto-derive default gives every type
//RS /// an `Equatable.equal` body.
//RS ///
//RS /// `TraitImplBlock::compiler_generated` is the parser-unforgeable provenance
//RS /// (a source `impl T.Trait` is always `false`; jet-foundation `AST/items.rs`),
//RS /// and it is the only fact consulted here — no second gate, table, or lint
//RS /// exemption list (I8). Errors are kept, not silenced; they land on `anchor`,
//RS /// the block's trait span, which a derive sets to the type's name (the only
//RS /// authored location the derive has), so an edit to the template never moves
//RS /// them onto an unrelated line of the author's file.
//RS fn author_facing_diagnostics(
//RS     generated_anchor: Option<crate::Diagnostics::Span>,
//RS     mut diagnostics: Vec<Diagnostic>,
//RS ) -> Vec<Diagnostic> {
//RS     let Some(anchor) = generated_anchor else {
//RS         return diagnostics;
//RS     };
//RS     diagnostics.retain(|d| matches!(d.severity, crate::Diagnostics::Severity::Error));
//RS     for diagnostic in &mut diagnostics {
//RS         diagnostic.span = Some(anchor);
//RS         diagnostic.labels.clear();
//RS     }
//RS     // Every statement of the body now reports at the same place; one report
//RS     // per distinct problem is enough.
//RS     diagnostics.dedup_by(|later, earlier| later.code == earlier.code && later.what == earlier.what);
//RS     diagnostics
//RS }
