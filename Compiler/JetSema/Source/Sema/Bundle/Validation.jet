        body := ^outcome.products
        ledger :: ^outcome.ledger
        if body.uses_exact_int -> self.cx.states[self.cx.module_idx].exact_int_reachable.set(true)
        if job.kind == .Function(function: f, ct_keys: ct_keys, restore_type_params: restore, generated_anchor: anchor, ..) {
            &self.diags.extend(author_facing_diagnostics(anchor, diagnostics))
            &self.merge_ledger(ledger)
            &self.products.absorb(^body)
            loop key in ct_keys -> self.checked_ct_funcs[key] = ~f
