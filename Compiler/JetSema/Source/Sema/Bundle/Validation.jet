struct BodyJob { owner: String?, raw_protocol_return: Bool, kind: BodyJobKind }
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1194
// GATE #4494: mutable retained views remain disjoint across bounded worker jobs.
enum BodyJobKind {
    Function(function: &Func, cache_key: String, ct_keys: [String], restore_type_params: [TypeParam]?, generated_anchor: Span?)
    Test(test: &TestDef, function: Func, param_diagnostics: [Diagnostic])
