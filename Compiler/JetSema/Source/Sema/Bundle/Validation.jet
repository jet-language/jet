//RS             owner: Some(owner.to_string()),
//RS             raw_protocol_return: false,
//RS             kind: BodyJobKind::Function {
//RS                 cache_key: format!("{module_key}::{kind}:{owner}::method:{}", m.name),
//RS                 ct_keys: vec![format!("{owner}::{}", m.name), m.name.clone()],
//RS                 restore_type_params: Some(own_params),
//RS                 generated_anchor: None,
//RS                 function: m,
//RS             },
//RS         });
//RS     }
//RS     for block in trait_impls.iter_mut() {
//RS         let trait_name = block.trait_name.clone();
//RS         let compiler_generated = block.compiler_generated;
//RS         let generated_anchor = compiler_generated.then_some(block.trait_span);
