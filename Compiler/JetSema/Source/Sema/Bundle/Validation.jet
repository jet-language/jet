        previous_round = Val(^round)
    }
    cache_allowed :: view_jobs.is_empty()
    module_key :: ~module.display
    pass := MainBodyPass{cx: @cx, checked_ct_funcs: &checked_ct_funcs, name_ledger: &name_ledger, products: &products, diags: &diags, incremental: incremental, cache_allowed: cache_allowed}
    declared_items :: module.items.len()
    &pass.run(collect_body_jobs(&module.items, st, module_key, mode, invalid_serde_impls))
    &pass.diags.extend(inject_exercised_error_conversions(&module))
    &pass.run(collect_body_jobs(&module.items[declared_items..], st, module_key, mode, invalid_serde_impls))
    trait_view_contracts := [(String, String):(ViewProvenanceMap, Span)]{}
    record_trait_methods :: fn(trait_name: String, methods: [Func], diags: &[Diagnostic]) Never! {
        loop method in methods {
            if method.return_view_provenance == .Val(provenance) {
                if provenance.is_empty() -> continue
                key :: (~trait_name, ~method.name)
                if trait_view_contracts.get_mut(key) == .Val((existing, _)) {
                    if !merge_view_provenance(&existing, provenance) -> &diags.push(Diagnostic.error("E2305", "implementations of `{trait_name}.{method.name}` disagree about returned view slots", "dynamic dispatch can union possible owners, but every implementation must return the same view-bearing shape and access marker", "return the same read or write view slots in every implementation", Val(method.name_span)))
                } else { trait_view_contracts[key] = (~provenance, method.name_span) }
            }
        }
    }
    loop item in module.items {
        if item == .Impl(i) && i.trait_name == .Val(trait_name) -> record_trait_methods(trait_name, i.methods, &diags)
        if item == .Struct(d) -> loop i in d.trait_impls -> record_trait_methods(i.trait_name, i.methods, &diags)
        if item == .Enum(d) -> loop i in d.trait_impls -> record_trait_methods(i.trait_name, i.methods, &diags)
    }
    loop ((trait_name, method_name), (provenance, _)) in trait_view_contracts {
        if st.trait_reg.traits.get(trait_name) == .Val(info) && info.methods.get(method_name) == .Val(signature) && signature.declared_return_view_provenance == None -> _ :: signature.return_view_provenance.set(provenance)
    }
    loop item in module.items {
        if item == .Trait(trait_def) {
            loop method in trait_def.methods {
                if method.declared_return_view_provenance == .Val(declared) && st.trait_reg.traits.get(trait_def.name) == .Val(info) && info.methods.get(method.name) == .Val(signature) -> _ :: signature.return_view_provenance.set(~declared)
            }
        }
    }
    generated_policy_wrappers := [Item]{}
    generated_policy_wrapper_names := [String:Bool]{}
    apply_policy_uses := [String:[String]]{}
    collect_callable_policy_apply_uses(&module.items, &apply_policy_uses)
    apply_target_names := [String:Bool]{}
    loop name in apply_policy_uses.keys() -> apply_target_names[~name] = true
    policy_targets := callable_policy_targets(module.items)
    named_callable_policy_targets(module.items, apply_target_names, &policy_targets)
    loop target in policy_targets {
        target_sig :: st.funcs.get(target.name).cloned().unwrap_or_else(fn() { func_to_sig(target) })
        call_ty :: func_sig_to_fn_type(target_sig)
        policy_names := [String]{}
        loop marker in target.markers {
            if marker.name != MARKER_POLICY -> continue
            if CallablePolicyChain.parse(marker.expr_args_owned()) == .Ok(chain) -> loop policy in chain.policies -> if !policy_names.contains(policy.name) -> &policy_names.push(policy.name)
        }
        if apply_policy_uses.get(target.name) == .Val(applied_policies) -> loop policy_name in applied_policies -> if !policy_names.contains(policy_name) -> &policy_names.push(~policy_name)
        loop policy_name in policy_names {
            policy_key :: (~st.package_scope, ~policy_name)
            if st.callable_policy_declarations.get(policy_key) == .Val((_declaring_module, declaration)) {
                wrapper_name :: callable_policy_wrapper_name(policy_name, target.name)
                wrapper := Func.implicit_run(~declaration.body, declaration.span)
                wrapper.name = ~wrapper_name
                wrapper.name_span = declaration.name_span
                wrapper.params = ~declaration.params
                &wrapper.params.push(Param{convention: AccessConvention.Read, root: false, name: "call", name_span: declaration.name_span, public_label: None, zone: ParamZone.Either, ty: ~call_ty, ty_span: declaration.name_span, default: None, variadic: false, variadic_bound_list: None, declared_view_from_names: None})
                loop original in target.params {
                    param := ~original
                    param.default = None
                    &wrapper.params.push(^param)
                }
                wrapper.return_type = ~target_sig.return_type
                wrapper.return_type_span = target.return_type_span
                wrapper.return_view_provenance = ~target.return_view_provenance
                wrapper.declared_return_view_provenance = ~target.declared_return_view_provenance
                wrapper.compiler_generated = true
                wrapper_ledger := name_ledger.body_snapshot()
                wrapper_products := BodyProducts.default()
                &diags.extend(check_func_body(cx, &wrapper, None, false, None, Val(checked_ct_funcs), &wrapper_ledger, &wrapper_products))
                if wrapper_products.uses_exact_int -> st.exact_int_reachable.set(true)
                loop &pending in &wrapper_products.pending_diagnostics -> pending.function_key = "policy:{policy_name}::{target.name}"
                &products.pending_diagnostics.extend(^wrapper_products.pending_diagnostics)
                &products.devtools_publications.extend(^wrapper_products.devtools_publications)
                if !generated_policy_wrapper_names.has_key(wrapper.name) {
                    generated_policy_wrapper_names[~wrapper.name] = true
                    &generated_policy_wrappers.push(Item.Func(^wrapper))
                }
            }
        }
    }
    &module.items.extend(^generated_policy_wrappers)
    diags
}
