            conversion.body = ^f.body
        }
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1757
    fn merge_ledger(&self, ledger: NameLedger) Never! {
        &self.name_ledger.merge_references(ledger)
        &self.name_ledger.merge_structure_facts(ledger)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1819
struct ViewSummaryJob { key: String, owner: String?, trait_name: String?, raw_protocol_return: Bool, function: @Func }
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1917
fn contains_view(registry: TypeRegistry, ty: Type, seen: &[String:Bool]) -> Bool Never! {
    if ty == .Apply(name, args) {
        if (name == "View" || name == "ViewMut" || name == TYPE_PIN) && args.len() == 1 -> return true
        if args.any(fn(arg) { contains_view(registry, arg, &seen) }) -> return true
        if !seen.has_key(name) {
            seen[~name] = true
            if registry.struct_fields(name) == .Val(fields) -> return fields.any(fn(field) { contains_view(registry, field.2, &seen) })
        }
        return false
    }
    if ty == .Named(name) {
        if seen.has_key(name) -> return false
        seen[~name] = true
        if registry.struct_fields(name) == .Val(fields) -> return fields.any(fn(field) { contains_view(registry, field.2, &seen) })
        return false
    }
    if ty == .Option(inner) -> return contains_view(registry, inner, &seen)
    if ty == .List(inner) -> return contains_view(registry, inner, &seen)
    if ty == .Shared(inner) -> return contains_view(registry, inner, &seen)
    if ty == .Tagged(inner: inner, ..) -> return contains_view(registry, inner, &seen)
    if ty == .Result(ok: ok, err: err) -> return contains_view(registry, ok, &seen) || contains_view(registry, err, &seen)
    if ty == .Map(key: key, value: value, ..) -> return contains_view(registry, key, &seen) || contains_view(registry, value, &seen)
    if ty == .Tuple(fields) -> return fields.any(fn(field) { contains_view(registry, field.1, &seen) })
    if ty == .FixedList(elem: elem, ..) -> return contains_view(registry, elem, &seen)
    if ty == .Fn(params: params, ret: ret, ..) -> return params.any(fn(param) { contains_view(registry, param, &seen) }) || ret.is_some_and(fn(ret) { contains_view(registry, ret, &seen) })
    false
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation.rs:1769
fn check_module_bodies(module: &LoadedModule, module_idx: Int, states: [ModuleState], plugin_interfaces: PluginInterfaceRegistry, devtools_registry: DevtoolsRegistry, effect_facts: FactRegistry, mode: CompileMode, no_os: Bool, gates: GateSet, name_ledger: &NameLedger, products: &BodyProducts, incremental: &IncrementalSemaCache?) -> [Diagnostic] Never! {
    st :: states[module_idx]
    nominal_memo :: st.registry.open_nominal_memo()
    diags := [Diagnostic]{}
    (ct_funcs, ct_externs, ct_globals) :: comptime_context_from_items(module.items)
    invalid_serde_impls :: invalid_serde_derive_impls(module.items, st.trait_reg)
    ct_base_dir :: module.path.parent().map(fn(p) { p.to_path_buf() }).unwrap_or_else(fn() { OSPath.from(".") })
    cx :: BodyContext{module_idx: module_idx, states: states, plugin_interfaces: plugin_interfaces, devtools_registry: devtools_registry, effect_facts: effect_facts, ct_funcs: @ct_funcs, ct_externs: @ct_externs, ct_base_dir: @ct_base_dir, ct_globals: @ct_globals, no_os: no_os, gates: gates, no_prelude: module.no_prelude}
    checked_ct_funcs := stage_comptime_functions(cx, module.items, ct_funcs, name_ledger)
    view_jobs := [ViewSummaryJob]{}
    loop item in module.items {
        if item == .Func(f) -> &view_jobs.push(ViewSummaryJob{key: ~f.name, owner: None, trait_name: None, raw_protocol_return: false, function: @f})
        if item == .Struct(d) {
            loop f in d.methods -> &view_jobs.push(ViewSummaryJob{key: "{d.name}::{f.name}", owner: Val(~d.name), trait_name: None, raw_protocol_return: false, function: @f})
            loop i in d.trait_impls -> loop f in i.methods -> &view_jobs.push(ViewSummaryJob{key: "{d.name}::{i.trait_name}::{f.name}", owner: Val(~d.name), trait_name: Val(~i.trait_name), raw_protocol_return: uses_raw_protocol_function_return(Val(i.trait_name), i.compiler_generated, f), function: @f})
        }
        if item == .Enum(d) {
            loop f in d.methods -> &view_jobs.push(ViewSummaryJob{key: "{d.name}::{f.name}", owner: Val(~d.name), trait_name: None, raw_protocol_return: false, function: @f})
            loop i in d.trait_impls -> loop f in i.methods -> &view_jobs.push(ViewSummaryJob{key: "{d.name}::{i.trait_name}::{f.name}", owner: Val(~d.name), trait_name: Val(~i.trait_name), raw_protocol_return: uses_raw_protocol_function_return(Val(i.trait_name), i.compiler_generated, f), function: @f})
        }
        if item == .Impl(i) -> loop f in i.methods -> &view_jobs.push(ViewSummaryJob{key: "{i.type_name}::{i.trait_name.unwrap_or("inherent")}::{f.name}", owner: Val(~i.type_name), trait_name: ~i.trait_name, raw_protocol_return: uses_raw_protocol_function_return(i.trait_name, false, f), function: @f})
