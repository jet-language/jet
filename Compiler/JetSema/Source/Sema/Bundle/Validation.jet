    &view_jobs.sort_by(fn(left, right) { left.key.cmp(right.key) })
    trait_job_counts := [(String, String):Int]{}
    loop job in view_jobs -> if job.trait_name == .Val(trait_name) -> &trait_job_counts.entry((~trait_name, ~job.function.name)).or_default() += 1
    previous_round := None as [ViewProvenanceMap?]?
    loop _ in 0..=view_jobs.len() {
        trait_candidates := [(String, String):[ViewProvenanceMap]]{}
        round := [ViewProvenanceMap?].with_capacity(view_jobs.len())
        loop job in view_jobs {
            function := ~job.function
            scratch_ledger := name_ledger.body_snapshot()
            scratch := BodyProducts.default()
            _ :: check_func_body(cx, &function, job.owner, job.raw_protocol_return, None, Val(checked_ct_funcs), &scratch_ledger, &scratch)
            if scratch.uses_exact_int -> st.exact_int_reachable.set(true)
            &round.push(~function.return_view_provenance)
            if job.trait_name == .Val(trait_name) && function.return_view_provenance == .Val(provenance) -> &trait_candidates.entry((~trait_name, ~function.name)).or_default().push(provenance)
        }
        loop (key, candidates) in trait_candidates {
            if candidates.len() != trait_job_counts.get(key).copied().unwrap_or(0) || candidates.is_empty() -> continue
            contract := ~candidates[0]
            merged := true
            loop index in 1..<candidates.len() {
                if !merge_view_provenance(&contract, candidates[index]) { merged = false; break }
            }
            if !merged -> continue
            if st.trait_reg.traits.get(key.0) == .Val(info) && info.methods.get(key.1) == .Val(signature) -> _ :: signature.return_view_provenance.set(contract)
        }
