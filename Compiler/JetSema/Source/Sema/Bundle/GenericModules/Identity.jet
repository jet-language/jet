// Native bundle identity publication; reuse canonical full-key framing and pure manifest kernels.
use jet_foundation.[Type, ProgramBundle, ModuleAliasDef, ModuleArg, ModuleInstanceIdentity, ModuleInstanceApplication, Expr, Span, type_name]
use jet_foundation.CheckReads
use jet_foundation.Syntax.[UNIFIED_LOCK_FILE, PACKAGE_FILE, PAYLOAD_FILE]
