// Pure kernels have one current owner; integration publishes these inward from Driver.
use jet_driver.Driver.GenericModuleIdentity.[jet_driver_genmod_quoted_field, jet_driver_genmod_semver, jet_driver_genmod_lock_value, jet_driver_genmod_inline_value, jet_driver_genmod_clean_git]

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:3
fn frame_text(out: &[U8], text: String) -> Unit { sema_genmod_frame_text(&out, text) }
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:7
// Includes nested write (8), every type tag 1..22, erased Tagged metadata and exact big-endian framing.
pub fn type_full_key(ty: Type) -> [U8] { sema_genmod_type_full_key(ty) }
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:123
pub fn parameter_bytes(params: [SemaGenericModuleParam]) -> [U8] { sema_genmod_parameter_bytes(params) }
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:144
pub fn definition_full_key(package_identity: String, module_path: String, lexical_path: String, name: String) -> [U8] {
    sema_genmod_definition_full_key(package_identity, module_path, lexical_path, name)
}
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:160
fn quoted_field(text: String, field: String) -> String? { jet_driver_genmod_quoted_field(text, field) }
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:174
fn canonical_semver(version: String) -> String { jet_driver_genmod_semver(version) }
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:207
fn lock_value(line: String, field: String) -> String? { jet_driver_genmod_lock_value(line, field) }
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:212
fn inline_lock_value(table: String, field: String) -> String? { jet_driver_genmod_inline_value(table, field) }
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:220
