// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:240
fn canonical_lock_source(project_root: OSPath, package_root: OSPath, dependency_name: String?, package_name: String) -> String {
    if dependency_name == None { return "workspace" }
    // GATE #4494: audited CheckReads retains absent-file dependencies as well as present reads.
    raw :: CheckReads.read_to_string(project_root.join(UNIFIED_LOCK_FILE)).unwrap_or("")
    wanted :: dependency_name ?? package_name
    current := false
    name := ""
    version := ""
    source := ""
    locked := ""
    content_hash := ""
    records := [(String, String, String, String, String)]{}
    for original in raw.lines() {
        line := original.trim() // #4303
        if line.is_empty() || line.starts_with("#") { continue }
        if line.starts_with("[") {
            if current {
                &records.push((^name, ^version, ^source, ^locked, ^content_hash))
                name = ""
                version = ""
                source = ""
                locked = ""
                content_hash = ""
            }
            current = line == "[[package]]"
            continue
        }
        if !current { continue }
        if lock_value(line, "name") == .Val(value) { name = value }
        else if lock_value(line, "version") == .Val(value) { version = value }
        else if lock_value(line, "source") == .Val(value) { source = value }
        else if lock_value(line, "locked") == .Val(value) { locked = value }
        else if lock_value(line, "content-hash") == .Val(value) { content_hash = value }
    }
    if current { &records.push((^name, ^version, ^source, ^locked, ^content_hash)) }
    if records.iter().find(fn(record) { record.0 == wanted || record.0 == package_name }) == .Val(record) {
        (_, locked_version, source, locked, content_hash) :: record
        if inline_lock_value(source, "path") == .Val(path) {
            if path.strip_prefix("registry:") == .Val(registry) { return "registry:{registry}@{canonical_semver(locked_version)}#{content_hash}" }
            // GATE #4500: native absolute-path classification.
            canonical :: if OSPath.from(path).is_absolute() { ~wanted } else {
                path.replace("\\", "/").split("/").filter(fn(part) { !part.is_empty() && part != "." }).collect().join("/")
            }
            content :: if !content_hash.is_empty() { content_hash } else { inline_lock_value(locked, "tree-hash") ?? "unlocked" }
            return "path:{canonical}#{content}"
        }
        if inline_lock_value(source, "git") == .Val(url) {
            rev :: inline_lock_value(locked, "rev") ?? ""
            tree :: inline_lock_value(locked, "tree-hash") ?? content_hash
            return "git:{credential_free_git_url(url)}@{rev}#{tree}"
        }
    }
    relative :: package_root.strip_prefix(project_root).ok().and_then(fn(path) { path.to_str() })
        .filter(fn(path) { !path.is_empty() }).map(fn(path) { path.replace("\\", "/") }).unwrap_or(wanted)
    "path:{relative}"
}
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:338
pub fn owning_package(bundle: ProgramBundle, module_path: OSPath) -> (OSPath, String?) {
    // GATE #4500: borrowed native path components and root-prefix selection.
    selected := None as (OSPath, String?)?
    longest := 0
    for (name, root) in bundle.dep_roots {
        if !module_path.starts_with(root) { continue }
        length :: root.components().count()
        // Iterator max_by_key retains the last equal-length root, like Rust.
        if selected == None || length >= longest { selected = Val((root, Val(name))); longest = length }
    }
    selected ?? (bundle.project_root, None)
}
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:351
pub fn package_identity(bundle: ProgramBundle, root: OSPath, dependency_name: String?) -> String {
    manifest := ""
    for candidate in [PACKAGE_FILE, PAYLOAD_FILE] {
        if CheckReads.read_to_string(root.join(candidate)) == .Ok(contents) { manifest = ^contents; break }
    }
    name :: quoted_field(manifest, "name") ?? dependency_name ?? "workspace"
    version :: canonical_semver(quoted_field(manifest, "version") ?? "0.0.0+workspace")
    source :: canonical_lock_source(bundle.project_root, root, dependency_name, name)
    bytes := [U8]{}
    sema_genmod_frame(&bytes, "jet.package.identity.v2".bytes())
    frame_text(&bytes, name)
    frame_text(&bytes, version)
    frame_text(&bytes, source)
    sha256_hex(bytes)
}
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:377
pub fn instance_identity(key: ModuleInstanceKey, template: TemplateInfo, alias: ModuleAliasDef, source_module: String, args: [ResolvedModuleArg]) -> ModuleInstanceIdentity {
    full_key :: key.bytes()
    fingerprint :: sha256_hex(full_key)
    argument_values := [String]{}
    for arg in args { &argument_values.push(resolved_argument_value(arg)) }
    argument_provenance_rows := [[String]]{}
    for arg in alias.args { &argument_provenance_rows.push(argument_provenance(arg, template)) }
    ModuleInstanceIdentity(full_key: full_key, fingerprint: ~fingerprint, definition_id: ~template.definition_id,
        argument_keys: ~key.args, argument_values: ^argument_values, argument_provenance: ^argument_provenance_rows,
        template_span: template.def.span, applications: [ModuleInstanceApplication(name: ~alias.name, source_module: ~source_module, semantic_identity: "instance:{fingerprint}", span: alias.name_span)])
}
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:407
fn resolved_argument_value(arg: ResolvedModuleArg) -> String {
    arg == {
        .Type(ty) -> "type:{type_name(ty)}"
        .Value(value, _) -> "value:{value.jet_show()}"
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:414
fn argument_provenance(arg: ModuleArg, template: TemplateInfo) -> [String] {
    sema_genmod_argument_provenance(arg, template.build_facts)
}
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:434
fn module_expr_path(expr: Expr) -> String? { sema_genmod_expr_path(expr) }
// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Identity.rs:443
pub fn register_instance_fingerprint(registry: &[String:[U8]], identity: ModuleInstanceIdentity, span: Span) -> Unit {
    if registry.get(identity.fingerprint) == .Val(previous) {
        if previous != identity.full_key {
            hex :: fn(bytes: [U8]) {
                digits :: "0123456789abcdef".bytes()
                rendered := [U8].with_capacity(bytes.len() * 2)
                for byte in bytes {
                    &rendered.push(digits[(byte >> 4) as Int])
                    &rendered.push(digits[(byte & U8{15}) as Int])
                }
                String.from_bytes(rendered).expect("hexadecimal is UTF-8")
            }
            // GATE #4409: canonical internal compiler error stops before codegen.
            jet_foundation.ice(Val(span), "E0859 generic module instance fingerprint collision: digest={identity.fingerprint} first-full-key={hex(previous)} second-full-key={hex(identity.full_key)}; compilation stopped before codegen")
        }
    } else {
        registry[identity.fingerprint] = ~identity.full_key
    }
}
