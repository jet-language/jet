use jet_foundation.[Expr, Type, CtValue, Span, MetaAttr, MetaField, Marker, StrPart, TryConvert, BinOp, TypedLitBody, EnumLitArg, OrFallback, LambdaBody, Stmt, Binding, ForKind]
use jet_sema.[specialize_module_type, error_conv_fn_name]
use jet_sema.Generics

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Substitution.rs:3
fn ct_value_expr(value: CtValue, span: Span) -> Expr {
    return if value == {
        .Bool(v) -> .Bool(v, span)
        .Int(v) -> .Int(v, span, None, None)
        .Char(v) -> .Char(v, span)
        .Str(v) -> .Str([.Lit(~v)], span)
        .Enum{type_name, variant, args} if args.is_empty() -> .EnumLit{type_name: ~type_name, variant: ~variant, variant_span: None, args: [], leading_dot: false, span: span}
        else -> panic("generic-module value domain was checked before substitution")
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Substitution.rs:24
pub fn substitute_meta(meta: &MetaAttr?, types: [String:Type], values: [String:CtValue]) -> {
    if meta == .Val(attr) {
        loop field in &attr.fields {
            if field == {
                .Category{value, ..} | .Maturity{value, ..} -> substitute_expr(&value, types, values)
                .Unknown{value: .Val(value), ..} -> substitute_expr(&value, types, values)
                .Tunable{..} | .Unknown{value: None, ..} -> {}
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Substitution.rs:47
pub fn substitute_marker(marker: &Marker, types: [String:Type], values: [String:CtValue]) -> {
    loop arg in &marker.args {
        if arg.as_expr_mut() == .Val(expr) -> substitute_expr(&expr, types, values)
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Substitution.rs:59
pub fn substitute_markers(markers: &[Marker], types: [String:Type], values: [String:CtValue]) -> {
    loop marker in &markers -> substitute_marker(&marker, types, values)
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Substitution.rs:69
pub fn substitute_expr(expr: &Expr, types: [String:Type], values: [String:CtValue]) -> {
    if expr == .Ident(name, span) {
        if values.get(name) == .Val(value) {
            expr = ct_value_expr(value, span)
            return
        }
    }
    // D-META-STAGE1=B: @ is part of the identifier; substitute its written spelling.
    if expr == .ComptimeName{name, span, ..} {
        if values.get(name) == .Val(value) {
            expr = ct_value_expr(value, span)
            return
        }
    }
    if expr == {
        .Ident(..) | .Char(..) | .Int(..) | .Float(..) | .Bool(..) | .Unit(..)
        | .Absent(..) | .ReduceMarker(..) | .Todo{..} | .NoElse(_)
        | .UnitLit{..} | .ComptimeName{..} | .StrMatchLit(..) | .BinMatchLit(..) -> {}
        .Str(parts, _) -> {
            loop part in &parts {
                if part == .Interp(inner, _) -> substitute_expr(&inner, types, values)
            }
        }
        .Call(call) -> {
            loop ty in &call.type_args -> ty = Generics.substitute_type(ty, types)
            if call.resolved_ret == .Val(ty) -> ty = Generics.substitute_type(ty, types)
            loop arg in &call.args -> substitute_expr(&arg.expr, types, values)
        }
        .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _)
        | .Place(inner, _, _) | .Field(inner, _, _) | .Tainted(inner, _, _)
        | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Paren(inner, _)
        | .Spread(inner, _) -> substitute_expr(&inner, types, values)
        .Try(inner, _, convert, note) -> {
            substitute_expr(&inner, types, values)
            if convert == .Typed{fn_name, source, target} {
                source = Generics.substitute_type(source, types)
                target = Generics.substitute_type(target, types)
                fn_name = error_conv_fn_name(source.name(), target.name())
            }
            if note == .Val(value) -> substitute_expr(&value, types, values)
        }
        .MemberSpread{base, ..} | .OptField{base, ..} -> substitute_expr(&base, types, values)
        .Range{start, end, ..} -> {
            substitute_expr(&start, types, values)
            substitute_expr(&end, types, values)
        }
        .MethodCall{receiver, method, method_span, owner_type_args, type_args, args, recv_type, resolved_ret, operator_rhs, ..} -> {
            if receiver == .Ident(name, _) {
                if types.get(name) == .Val(.Named(resolved)) -> name = ~resolved
            }
            substitute_expr(&receiver, types, values)
            loop ty in &owner_type_args -> ty = Generics.substitute_type(ty, types)
            loop ty in &type_args -> ty = Generics.substitute_type(ty, types)
            if resolved_ret == .Val(ty) -> ty = Generics.substitute_type(ty, types)
            if operator_rhs == .Val(ty) -> ty = Generics.substitute_type(ty, types)
            loop arg in &args -> substitute_expr(&arg.expr, types, values)
            // Rewrite recorded receiver ownership for monomorphized JIT/AOT bodies.
            if recv_type == .Val(name) {
                if types.get(name) == {
                    .Val(.Named(resolved)) | .Val(.Apply{name: resolved, ..}) -> name = ~resolved
                    else -> {}
                }
            }
            primitive := false
            if recv_type == .Val(name) {
                if types.get(name) == .Val(ty) {
                    primitive = if ty == {
                        .Int | .Float | .Bool | .Char | .String -> true
                        else -> false
                    }
                }
            }
            op: BinOp? :: if method == {
                "add" -> Val(.Add)
                "sub" -> Val(.Sub)
                "mul" -> Val(.Mul)
                "div" -> Val(.Div)
                "equal" -> Val(.Eq)
                else -> None
            }
            if primitive && args.len() == 1 {
                if op == .Val(operator) -> expr = .Binary(operator, ~receiver, ~args[0].expr, method_span)
            }
        }
        .StructLit{type_name, type_args, import_ns, fields, span, ..} -> {
            loop ty in &type_args -> ty = Generics.substitute_type(ty, types)
            loop (_, _, value) in &fields -> substitute_expr(&value, types, values)
            qualified: String? :: if import_ns == {
                .Val(namespace) -> Val("{namespace}.{type_name}")
                else -> None
            }
            resolved: Type? := None
            if qualified == .Val(name) -> resolved = types.get(name)
            if resolved == None -> resolved = types.get(type_name)
            if resolved == {
                .Val(.Named(name)) -> {
                    type_name = ~name
                    import_ns = None
                }
                .Val(ty) -> {
                    // A builtin instantiation needs TypedLit, not an unnameable StructLit.
                    body :: if fields.len() == 1 {
                        .Value(fields.remove(0).2)
                    } else {
                        taken :: ^fields
                        fields = []
                        .Fields(taken)
                    }
                    expr = .TypedLit{head: Val(~ty), body: body, span: span}
                }
                None -> {}
            }
        }
        .TypedLit{head, body, ..} -> {
            if head == .Val(ty) -> ty = Generics.substitute_type(ty, types)
            &body.for_each_expr_mut((e) -> substitute_expr(&e, types, values))
        }
        .EnumLit{type_name, args, ..} -> {
            if types.get(type_name) == .Val(.Named(resolved)) -> type_name = ~resolved
            loop arg in &args {
                if arg == {
                    .Positional(value) | .Named{expr: value, ..} -> substitute_expr(&value, types, values)
                }
            }
        }
        .OrFallback{value, fallback, ..} -> {
            substitute_expr(&value, types, values)
            if fallback == {
                .Value(value) | .Return(.Val(value), _) -> substitute_expr(&value, types, values)
                .Block{body, value, ..} -> {
                    substitute_stmts(&body, types, values)
                    if value == .Val(inner) -> substitute_expr(&inner, types, values)
                }
                .Panic{args, ..} -> {
                    loop arg in &args -> substitute_expr(&arg.expr, types, values)
                }
                .Return(None, _) | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            }
        }
        .PatternTest{subject, ..} -> substitute_expr(&subject, types, values)
        .Binary(_, left, right, _) -> {
            substitute_expr(&left, types, values)
            substitute_expr(&right, types, values)
        }
        .CompareChain{operands, ..} | .ListLit(operands, _) -> {
            loop value in &operands -> substitute_expr(&value, types, values)
        }
        .TupleLit(fields, _, inferred) -> {
            loop (_, value) in &fields -> substitute_expr(&value, types, values)
            if inferred == .Val(ty) -> ty = Generics.substitute_type(ty, types)
        }
        .MapLit(entries, _) -> {
            loop (key, value) in &entries {
                substitute_expr(&key, types, values)
                substitute_expr(&value, types, values)
            }
        }
        .Index{base, index, ..} -> {
            substitute_expr(&base, types, values)
            substitute_expr(&index, types, values)
        }
        .Slice{base, start, end, range, ..} -> {
            substitute_expr(&base, types, values)
            if range == .Val(value) {
                substitute_expr(&value, types, values)
            } else {
                substitute_expr(&start, types, values)
                substitute_expr(&end, types, values)
            }
        }
        .CallValue{callee, args, ..} -> {
            substitute_expr(&callee, types, values)
            loop arg in &args -> substitute_expr(&arg.expr, types, values)
        }
        .Lambda(lambda) -> {
            loop param in &lambda.params {
                if param.ty == .Val(ty) -> ty = Generics.substitute_type(ty, types)
            }
            if lambda.body == {
                .Expr(value) -> substitute_expr(&value, types, values)
                .Block(body) -> substitute_stmts(&body, types, values)
            }
        }
        .If{cond, then_body, then_value, else_body, else_value, ..} -> {
            substitute_expr(&cond, types, values)
            substitute_stmts(&then_body, types, values)
            substitute_expr(&then_value, types, values)
            substitute_stmts(&else_body, types, values)
            substitute_expr(&else_value, types, values)
        }
        .PtrFromAddr{elem, addr, ..} -> {
            elem = Generics.substitute_type(elem, types)
            substitute_expr(&addr, types, values)
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Substitution.rs:386
pub fn substitute_stmts(stmts: &[Stmt], types: [String:Type], outer_values: [String:CtValue]) -> {
    // Bindings shadow module values only within their lexical block.
    values := ~outer_values

    // Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Substitution.rs:395
    fn substitute_binding(binding: &Binding, types: [String:Type], values: [String:CtValue]) -> {
        substitute_markers(&binding.markers, types, values)
        substitute_meta(&binding.meta, types, values)
        if binding.ty == .Val(ty) -> ty = specialize_module_type(ty, types, values)
        substitute_expr(&binding.init, types, values)
    }

    loop stmt in &stmts {
        if stmt == {
            .Expr(value) | .Yield(value, _) | .DeferClose{close: value, ..} -> substitute_expr(&value, types, values)
            .Val(binding) -> {
                substitute_binding(&binding, types, values)
                _ :: &values.remove(binding.name)
            }
            .Assign{value, ..} | .Return(.Val(value), _) -> substitute_expr(&value, types, values)
            .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> substitute_expr(&value, types, values)
            .Return(None, _) | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            .While{cond, body, ..} -> {
                substitute_expr(&cond, types, values)
                substitute_stmts(&body, types, values)
            }
            .For{kind, body, ..} -> {
                if kind == {
                    .Range{start, end, step, exclusive: _} -> {
                        substitute_expr(&start, types, values)
                        substitute_expr(&end, types, values)
                        if step == .Val(value) -> substitute_expr(&value, types, values)
                    }
                    .In{collection, step} -> {
                        substitute_expr(&collection, types, values)
                        if step == .Val(value) -> substitute_expr(&value, types, values)
                    }
                }
                substitute_stmts(&body, types, values)
            }
            .Switch{subject, arms, else_body, ..} | .ComptimeSwitch{subject, arms, else_body, ..} -> {
                substitute_expr(&subject, types, values)
                loop arm in &arms {
                    substitute_expr(&arm.cond, types, values)
                    substitute_stmts(&arm.body, types, values)
                }
                if else_body == .Val(body) -> substitute_stmts(&body, types, values)
            }
            .CountedLoop{init, cond, step, body, ..} -> {
                loop_values := ~values
                substitute_binding(&init, types, loop_values)
                _ :: &loop_values.remove(init.name)
                substitute_expr(&cond, types, loop_values)
                if step == .Val(step_stmt) {
                    // GATE #4494: mutable singleton slice preserves the step's AST identity.
                    substitute_stmts(std.slice.from_mut(&step_stmt), types, loop_values)
                }
                substitute_stmts(&body, types, loop_values)
            }
            .Loop{body, ..} | .Reactive{body, ..} | .Shield{body, ..} | .Region{body, ..}
            | .Policy{body, ..} | .TaskGroup{body, ..} | .Layout{body, ..}
            | .AuthorityScope{body, ..} | .Transact{body, ..} | .ComptimeBlock{body, ..}
            | .Live{body, ..} -> substitute_stmts(&body, types, values)
            .Unsafe{audit_expr, body, ..} -> {
                if audit_expr == .Val(value) -> substitute_expr(&value, types, values)
                substitute_stmts(&body, types, values)
            }
            .Impure{reason_expr, body, ..} -> {
                if reason_expr == .Val(value) -> substitute_expr(&value, types, values)
                substitute_stmts(&body, types, values)
            }
            .Switched{marker, body, ..} -> {
                substitute_marker(&marker, types, values)
                substitute_stmts(&body, types, values)
            }
            .AssumeDet{reason_expr, body, ..} -> {
                substitute_expr(&reason_expr, types, values)
                substitute_stmts(&body, types, values)
            }
            .ScopeMember{args, body, ..} -> {
                loop arg in &args -> substitute_expr(&arg, types, values)
                substitute_stmts(&body, types, values)
            }
            .ComptimeIf{cond, then_body, else_body, ..} -> {
                substitute_expr(&cond, types, values)
                substitute_stmts(&then_body, types, values)
                if else_body == .Val(body) -> substitute_stmts(&body, types, values)
            }
            .ContextBlock{fields, body, ..} -> {
                loop (_, value, _) in &fields -> substitute_expr(&value, types, values)
                substitute_stmts(&body, types, values)
            }
        }
    }
}
