use jet_foundation.[ProgramBundle, Diagnostic, Item, Type, CodeModule, CtValue, Func, Span, ModuleAliasDef, AppliedRuleApplication, ModuleInstanceApplication, import_alias, import_walk_bindings]
use jet_sema.[TemplateInfo, ModuleInstanceKey, AliasExpansion, TraitRegistry, clone_definition_items, owning_package, package_identity, definition_full_key, resolve_params, collect_generic_module_spans, report_generic_module_cycles, local_alias_depth, alias_chain_contains, resolve_local_alias, resolve_args, instance_key, expand_alias, instance_identity, register_instance_fingerprint, module_type_prefix, module_type_name, rewrite_inline_calls_stmts, substitute_stmts, substitute_expr, specialize_function_types, specialize_func, specialize_struct, specialize_enum, specialize_trait, specialize_tag, specialize_impl, specialize_module_type]
use jet_foundation.SHA256
use jet_sema.Comptime
use jet_sema.Generics
use std.path.Path // GATE #4494: target-native path construction.

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Expansion.rs:3
pub fn expand_generic_module_aliases(bundle: &ProgramBundle, diags: &[Diagnostic]) Never! {
    build_facts :: ~bundle.build_facts
    template_snapshots := [[String:TemplateInfo]]{}
    loop (source_module, module) in bundle.modules {
        enums := [String:Bool]{}
        funcs := [String:Func]{}
        has_generic := false
        loop item in module.items {
            if item == {
                .Enum(def) -> enums[def.name] = def.variants.all((variant) -> variant.payload == .Unit)
                .Func(def) -> funcs[def.name] = def
                .GenericModule(_) -> has_generic = true
                else -> {}
            }
        }
        source_values := [String:CtValue]{}
        if has_generic {
            loop item in module.items {
                if item == .Const(def) {
                    if Comptime.evaluate_closed_value(def.value, funcs, Set.new<String>(), Path.new("."), source_values, build_facts) == .Ok(value) -> source_values[def.name] = value
                }
            }
        }
        source_items :: clone_definition_items(module.items)
        templates := [String:TemplateInfo]{}
        loop item in module.items {
            if item == .GenericModule(gm) {
                (package_root, dependency_name) :: owning_package(bundle, module.path)
                identity :: package_identity(bundle, package_root, dependency_name)
                module_path :: (module.path.strip_prefix(package_root) ?? module.path).to_string_lossy().replace("\\", "/")
                full_key :: definition_full_key(identity, module_path, "", gm.name)
                templates[gm.name] = TemplateInfo{def: ~gm, definition_id: SHA256.sha256_hex(full_key), definition_full_key: full_key, params: resolve_params(gm, enums, &diags), source_module: source_module, source_items: clone_definition_items(source_items), source_values: ~source_values, source_rule_facts: ~module.rule_facts, build_facts: ~build_facts}
            }
        }
        &template_snapshots.push(^templates)
    }
    // Unqualified imports resolve through the namespace that established their alias.
    import_bindings := [[String:Int]]{}
    module_aliases := [String]{}
    loop (module_idx, module) in bundle.modules {
        bindings := [String:Int]{}
        loop import in module.imports {
            if import.kind == .Unqualified(_, _, _, _, _) -> continue
            if bundle.name_ledger.import_target(module_idx, import.span) == .Val(target) -> bindings[import_alias(import)] = target
        }
        &import_bindings.push(^bindings)
        &module_aliases.push(module.alias)
    }
    bundle_instances := [ModuleInstanceKey:String]{}
    bundle_instance_nominals := [String:[String]]{}
    fingerprint_keys := [String:[U8]]{}
    instance_applications := [String:[ModuleInstanceApplication]]{}
    loop (module_idx, module) in &bundle.modules {
        generic_module_spans := [Span]{}
        collect_generic_module_spans(module.items, &generic_module_spans)
        if report_generic_module_cycles(module.items, &diags) -> continue
        traits := TraitRegistry.default()
        &traits.register_synthetic_rollback()
        &traits.register_synthetic_display_debug()
        &traits.register_synthetic_close()
        &traits.register_synthetic_operators()
        &traits.register_synthetic_iter_index()
        &traits.register_synthetic_io()
        &traits.register_synthetic_driver()
        discarded := [Diagnostic]{}
        &traits.register_items(module.items, &discarded)
        enums := [String:Bool]{}
        funcs := [String:Func]{}
        has_alias := false
        loop item in module.items {
            if item == {
                .Enum(def) -> enums[def.name] = def.variants.all((variant) -> variant.payload == .Unit)
                .Func(def) -> funcs[def.name] = def
                .ModuleAlias(_) -> has_alias = true
                else -> {}
            }
        }
        globals := [String:CtValue]{}
        if has_alias {
            loop item in module.items {
                if item == .Const(c) {
                    if Comptime.evaluate_closed_value(c.value, funcs, Set.new<String>(), Path.new("."), globals, build_facts) == .Ok(value) -> globals[c.name] = value
                }
            }
        }
        templates := ~template_snapshots[module_idx]
        denied_templates := Set.new<String>()
        loop import in &module.imports {
            if import.kind != .Unqualified(_, _, _, _, _) -> continue
            if import.kind == .Unqualified(module_alias, _, _, _, _) {
                source_idx :: import_bindings[module_idx].get(module_alias) ?? continue
                bindings :: import_walk_bindings(import)
                consumed := Set.new<String>()
                loop binding in bindings {
                    original :: binding.original.expect("member walker returned a binding without a member")
                    source :: template_snapshots[source_idx].get(original) ?? continue
                    &consumed.insert(original)
                    local :: binding.local
                    if !source.def.is_pub && !source.def.is_package_pub {
                        &denied_templates.insert(local)
                        &diags.push(Diagnostic.error("E0609", "`{original}` is private in module `{module_aliases[source_idx]}`", "only `pub` items can be brought into scope with `use`", "add `pub` before `module {original}` in the defining file", Val(import.span)))
                        continue
                    }
                    templates[local] = ~source
                }
                if import.kind == .Unqualified(_, _, items, _, _) -> &items.retain((item) -> !consumed.contains(item.original))
            }
        }
        aliases := [String:ModuleAliasDef]{}
        type_aliases := [String:Type]{}
        ordered_aliases := [(Int, ModuleAliasDef)]{}
        loop (idx, item) in module.items {
            if item == {
                .ModuleAlias(alias) -> {
                    aliases[alias.name] = alias
                    &ordered_aliases.push((idx, alias))
                }
                .TypeAlias(alias) -> type_aliases[alias.name] = alias.target
                else -> {}
            }
        }
        projections := [String:String]{}
        loop alias in aliases.values() {
            if aliases.has_key(alias.target) {
                terminal := aliases[alias.target]
                loop aliases.get(terminal.target) == .Val(next) -> terminal = next
                projections[alias.name] = terminal.name
            }
        }
        expansions := [(Int, AliasExpansion)]{}
        &ordered_aliases.sort_by((left, right) -> local_alias_depth(left.1, aliases) <=> local_alias_depth(right.1, aliases))
        invalid_aliases := Set.new<String>()
        loop (idx, alias) in ordered_aliases {
            if alias_chain_contains(alias, aliases, invalid_aliases) -> continue
            resolved_option :: resolve_local_alias(alias, aliases, templates, &diags)
            if resolved_option == .None {
                &invalid_aliases.insert(alias.name)
                continue
            }
            resolved :: resolved_option.unwrap()
            if denied_templates.contains(resolved.target) {
                &invalid_aliases.insert(alias.name)
                continue
            }
            if aliases.has_key(alias.target) -> continue
            info_option :: templates.get(resolved.target)
            if info_option == .None {
                &diags.push(Diagnostic.error("E0850", "generic module `{resolved.target}` not found in this scope", "check the module template name and make sure it is defined in the same file", "example: `module {resolved.name} :: MyTemplate<String>`", Val(resolved.target_span)))
                &invalid_aliases.insert(alias.name)
                continue
            }
            info :: info_option.unwrap()
            args_option :: resolve_args(resolved, info, traits, funcs, globals, build_facts, enums, &diags)
            if args_option == .None {
                &invalid_aliases.insert(alias.name)
                continue
            }
            args :: args_option.unwrap()
            key :: instance_key(info, args, type_aliases)
            fingerprint :: SHA256.sha256_hex(key.bytes())
            applications := instance_applications.get(fingerprint) ?? []
            &applications.push(ModuleInstanceApplication{name: resolved.name, source_module: module.display, semantic_identity: "instance:{fingerprint}", span: resolved.name_span})
            instance_applications[fingerprint] = ^applications
            if bundle_instances.get(key) == .Val(canonical) {
                projections[alias.name] = canonical
                if bundle_instance_nominals.get(canonical) == .Val(nominals) -> bundle_instance_nominals[alias.name] = ~nominals
                continue
            }
            identity_args :: ~args
            cm_option :: expand_alias(resolved, module_idx, module.display, key.bytes(), templates, &diags, traits, funcs, globals, build_facts, enums, &bundle_instances, &fingerprint_keys, &instance_applications, Val(^args))
            if cm_option == .Val(cm) {
                identity :: instance_identity(key, info, resolved, module.display, identity_args)
                register_instance_fingerprint(&fingerprint_keys, identity, alias.span)
                cm.module.instance_identity = Val(identity)
                nominals := [String]{}
                loop item in cm.declarations {
                    if item == { .Struct(def) -> &nominals.push(def.name), .Enum(def) -> &nominals.push(def.name), else -> {} }
                }
                bundle_instance_nominals[alias.name] = ^nominals
                bundle_instances[key] = alias.name
                &expansions.push((idx, ^cm))
            } else -> &invalid_aliases.insert(alias.name)
        }
        declarations := [Item]{}
        generated_rule_facts := [AppliedRuleApplication]{}
        loop (idx, expansion) in expansions {
            module.items[idx] = Item.CodeModule(^expansion.module)
            &declarations.extend(^expansion.declarations)
            &generated_rule_facts.extend(^expansion.rule_facts)
        }
        &module.rule_facts.retain((application) -> !generic_module_spans.any((generic) -> application.marker.span.start >= generic.start && application.marker.span.end <= generic.end))
        &module.rule_facts.extend(^generated_rule_facts)
        &module.rule_facts.sort_by((a, b) -> a.marker.span.start <=> b.marker.span.start)
        projection_names :: projections.keys().collect()
        loop alias in projection_names {
            canonical := projections[alias]
            seen := Set.new<String>()
            loop !seen.contains(canonical) {
                &seen.insert(canonical)
                next :: projections.get(canonical) ?? break
                canonical = next
            }
            projections[alias] = canonical
        }
        projection_types := [String:Type]{}
        loop (alias, nominals) in bundle_instance_nominals {
            canonical :: projections.get(alias) ?? alias
            prefix :: module_type_prefix(canonical)
            loop canonical_name in nominals {
                if !canonical_name.starts_with(prefix) -> continue
                suffix := canonical_name.after(prefix) // #4303
                resolved :: Type.Named(canonical_name)
                projection_types["{alias}.{suffix}"] = resolved
                projection_types[module_type_name(alias, suffix)] = resolved
            }
        }
        loop (alias, canonical) in projections {
            prefix :: module_type_prefix(canonical)
            loop canonical_name in bundle_instance_nominals.get(canonical) ?? [] {
                if canonical_name.starts_with(prefix) {
                    suffix := canonical_name.after(prefix) // #4303
                    resolved :: Type.Named(canonical_name)
                    projection_types["{alias}.{suffix}"] = resolved
                    projection_types[module_type_name(alias, suffix)] = resolved
                }
            }
        }
        loop (alias, canonical) in projections {
            names :: Set.from([alias])
            loop item in &module.items {
                if item == .Func(func) -> rewrite_inline_calls_stmts(&func.body, names, canonical)
            }
        }
        loop item in &module.items {
            if item == .Func(func) {
                loop param in &func.params -> param.ty = Generics.substitute_type(param.ty, projection_types)
                if func.return_type == .Val(ret) -> func.return_type = Val(Generics.substitute_type(ret, projection_types))
                substitute_stmts(&func.body, projection_types, [:])
            }
        }
        &module.items.retain((item) -> if item == { .GenericModule(_) -> false, .ModuleAlias(_) -> false, else -> true })
        &module.items.extend(^declarations)
        debug_assert(!module.items.any((item) -> item == .ModuleAlias(_)))
    }
    loop module in &bundle.modules {
        loop item in &module.items {
            if item == .CodeModule(instance) {
                if instance.instance_identity == .Val(identity) {
                    if instance_applications.get(identity.fingerprint) == .Val(applications) -> identity.applications = ~applications
                }
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Expansion.rs:518
pub fn hoist_inline_module_member_types(bundle: &ProgramBundle) Never! {
    loop module in &bundle.modules {
        declarations := [Item]{}
        exported := [String:Type]{}
        loop item in &module.items {
            if item == .CodeModule(code_module) {
                source_path :: code_module.name
                _ :: hoist_inline_module_types(&code_module, source_path, &declarations, &exported)
            }
        }
        if declarations.is_empty() -> continue
        if !exported.is_empty() -> rewrite_exported_inline_types(&module.items, exported)
        &module.items.extend(^declarations)
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Expansion.rs:546
fn rewrite_exported_inline_types(items: &[Item], exported: [String:Type]) Never! {
    loop item in &items {
        if item == {
            .Func(func) -> func = specialize_function_types(^func, exported)
            .CodeModule(module) -> {
                if module.body == .Val(body) -> rewrite_exported_inline_types(&body, exported)
            }
            else -> {}
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Expansion.rs:562
pub fn inline_type_alias(source_path: String) -> String Never! { source_path.replace(".", "_") }

// Rust: crates/jet-sema/src/Sema/Bundle/GenericModules/Expansion.rs:566
fn hoist_inline_module_types(code_module: &CodeModule, source_path: String, declarations: &[Item], exported: &[String:Type]) -> [String:Type] Never! {
    if code_module.instance_identity != .None -> return [:]
    if code_module.body == .None -> return [:]
    body := &code_module.body.unwrap()
    module_alias :: inline_type_alias(source_path)
    module_name :: code_module.name
    direct_types := [String:Type]{}
    direct_names := [String]{}
    display_alias :: inline_type_alias(module_name)
    loop inner in body {
        name := ""
        is_pub := false
        if inner == {
            .Struct(def) -> { name = def.name; is_pub = def.is_pub || def.is_package_pub }
            .Enum(def) -> { name = def.name; is_pub = def.is_pub || def.is_package_pub }
            .Trait(def) -> { name = def.name; is_pub = def.is_pub || def.is_package_pub }
            .Tag(def) -> { name = def.name; is_pub = def.is_pub || def.is_package_pub }
            else -> continue
        }
        resolved :: Type.Named(module_type_name(module_alias, name))
        direct_types[name] = resolved
        direct_types["{module_name}.{name}"] = resolved
        direct_types["{source_path}.{name}"] = resolved
        direct_types[module_type_name(display_alias, name)] = resolved
        &direct_names.push(name)
        if is_pub {
            exported["{source_path}.{name}"] = resolved
            exported["{module_name}.{name}"] = resolved
        }
    }
    kept := [Item].with_capacity(body.len())
    lifted := [Item]{}
    descendant_types := [String:Type]{}
    old_body :: &body.replace([])
    loop inner in old_body {
        if inner == {
            .CodeModule(child) -> {
                child_path :: "{source_path}.{child.name}"
                &descendant_types.extend(hoist_inline_module_types(&child, child_path, &declarations, &exported))
                &kept.push(Item.CodeModule(^child))
            }
            .Struct(_) -> &lifted.push(^inner)
            .Enum(_) -> &lifted.push(^inner)
            .Trait(_) -> &lifted.push(^inner)
            .Tag(_) -> &lifted.push(^inner)
            .Impl(_) -> &lifted.push(^inner)
            else -> &kept.push(^inner)
        }
    }
    visible_types := ~direct_types
    loop (full_path, ty) in descendant_types {
        visible_types[full_path] = ty
        prefix :: "{source_path}."
        if full_path.starts_with(prefix) {
            relative := full_path.after(prefix) // #4303
            visible_types[relative] = ty
        }
    }
    values :: [String:CtValue]{}
    loop inner in &kept {
        if inner == {
            .Func(def) -> def = specialize_func(^def, [], [], visible_types, values)
            .Const(def) -> {
                substitute_expr(&def.value, visible_types, values)
                if def.ty == .Val(ty) -> def.ty = Val(specialize_module_type(ty, visible_types, values))
            }
            else -> {}
        }
    }
    loop inner in lifted {
        if inner == {
            .Struct(def) -> &declarations.push(Item.Struct(specialize_struct(def, module_alias, [], [], visible_types, values)))
            .Enum(def) -> &declarations.push(Item.Enum(specialize_enum(def, module_alias, [], [], visible_types, values)))
            .Trait(def) -> &declarations.push(Item.Trait(specialize_trait(def, [], [], visible_types, values)))
            .Tag(def) -> &declarations.push(Item.Tag(specialize_tag(def, visible_types, values)))
            .Impl(def) -> &declarations.push(Item.Impl(specialize_impl(def, [], [], visible_types, values)))
            else -> unreachable("only type declarations and impls are lifted")
        }
    }
    body = ^kept
    all_types := [String:Type]{}
    loop name in direct_names {
        if direct_types.get(name) == .Val(ty) -> all_types["{source_path}.{name}"] = ty
    }
    &all_types.extend(^descendant_types)
    all_types
}
