//RS 
//RS /// Give an inline module's member TYPES the same lifted member
//RS /// identity its member functions already have.
//RS ///
//RS /// Registration and every engine only ever learn TOP-LEVEL type declarations:
//RS /// `Bundle/Pipeline.rs`'s `Item::CodeModule` arm registers member `Item::Func`
//RS /// rows only, and codegen's item loops list `Item::CodeModule` among the items
//RS /// that declare no type. So a `struct` written inside `module bank { … }` was
//RS /// invisible everywhere — E0119 "there's no type called `Account`" inside its
//RS /// own module (card #2054), while a generic module's member struct worked
//RS /// because `expand_alias` renames and lifts it.
//RS ///
//RS /// This is that same mechanism, with no arguments to substitute: one member
//RS /// naming scheme (`module_type_name`), one lifting step, one display
//RS /// projection (`plain_inline_module_display_paths`), no engine change. Generic
//RS /// instances are skipped — `expand_alias` already lifted their members.
//RS ///
//RS /// Visibility is preserved: the bare name and the qualified `bank.Account`
//RS /// spelling resolve inside the module body, but only a `pub` member's
//RS /// qualified spelling resolves in the rest of the file, so a private member
//RS /// stays unreachable from outside exactly as `pub` promises.
//RS pub(crate) fn hoist_inline_module_member_types(bundle: &mut ProgramBundle) {
//RS     for module in bundle.modules.iter_mut() {
//RS         let mut declarations: Vec<Item> = Vec::new();
//RS         let mut exported: HashMap<String, Type> = HashMap::new();
//RS         for item in module.items.iter_mut() {
//RS             let Item::CodeModule(code_module) = item else {
//RS                 continue;
//RS             };
//RS             let source_path = code_module.name.clone();
//RS             hoist_inline_module_types(code_module, &source_path, &mut declarations, &mut exported);
//RS         }
//RS         if declarations.is_empty() {
//RS             continue;
//RS         }
//RS         // The rest of the file reaches a lifted member only through its
//RS         // qualified `module.Type` spelling, and only when it is `pub` — the
//RS         // same consumer rewrite generic-module instances get.
//RS         if !exported.is_empty() {
//RS             rewrite_exported_inline_types(&mut module.items, &exported);
//RS         }
//RS         module.items.extend(declarations);
//RS     }
//RS }
//RS 
//RS /// Rewrite public inline-module type projections in every function scope in
//RS /// one file. A sibling inline module is outside the declaring module's body,
//RS /// but it still uses the enclosing file's public module surface. Private
//RS /// members never enter `exported`, so this cannot widen their reach.
//RS fn rewrite_exported_inline_types(items: &mut [Item], exported: &HashMap<String, Type>) {
//RS     for item in items {
//RS         match item {
//RS             Item::Func(func) => {
