//RS             }
//RS             Item::CodeModule(module) => {
//RS                 if let Some(body) = &mut module.body {
//RS                     rewrite_exported_inline_types(body, exported);
//RS                 }
//RS             }
//RS             _ => {}
//RS         }
//RS     }
//RS }
