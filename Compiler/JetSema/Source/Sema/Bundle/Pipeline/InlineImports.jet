use JetSema.Sema.Bundle.Pipeline.*
use jet_foundation.[AST, Syntax, Names]
use jet_foundation.Diagnostics.[Diagnostic, Span]
use JetSema.Sema.CheckerCoreLib as CheckerCoreLib

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/InlineImports.rs:175
// GATE #4499: tuple keys retain exact structural equality and hashing.
enum Target {
    Inline{alias: String, mangled: String}
    File{name: String, module_idx: USize}
    Core{module: String, item: String?}
    Item{target: String, module_idx: USize, span: Span}
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/InlineImports.rs:3
pub fn resolve_inline_module_imports(bundle: &ProgramBundle, states: &[ModuleState], name_ledger: &Names.NameLedger, diags: &[Diagnostic]) {
    loop idx in 0..<bundle.modules.len() {
        inline_imports := [(String, [AST.ImportDecl])]{}
        loop item in bundle.modules[idx].items {
            if item is .CodeModule(cm) && cm.body != None && !cm.imports.is_empty() -> inline_imports.push((cm.name, cm.imports.clone()))
        }
        loop (inline_name, imports) in inline_imports {
            inline_names := [String:Bool]{}
            loop imp in imports {
                if imp.core_module_path() is module {
                    if !Syntax.is_known_core_module(module) {
                        diags.push(CheckerCoreLib.unknown_core_module(module, imp.span))
                        next
                    }
                    if Syntax.core_module_layer(module) is mod_layer {
                        if bundle.layer_ceiling is ceiling && mod_layer > ceiling {
                            diags.push(Syntax.layer_ceiling_exceeded(module, mod_layer, ceiling, Val(imp.span), Val("`use {module}`")))
                            next
                        }
                        if mod_layer > bundle.inferred_layer -> bundle.inferred_layer = mod_layer
                    }
                    local :: imp.walk_bindings().first().map(fn(binding) { binding.local }) ?? imp.import_alias()
                    if inline_names.contains_key(local) {
                        diags.push(Diagnostic.error("E0105", "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with `{Syntax.KW_AS} alias`", Val(imp.alias_span)))
                        next
                    }
                    inline_names.insert(local, true)
                    states[idx].inline_core_imports.insert((inline_name, local), module)
                    next
                }
                foreign :: foreign_imports_after_validation(imp)
                if !foreign.is_empty() {
                    group_failed := false
                    resolved := [(String, USize)]{}
                    group_names := [String]{}
                    loop (namespace, alias) in foreign {
                        if inline_names.contains_key(alias) {
                            group_failed = true
                            diags.push(Diagnostic.error("E0105", "the import name `{alias}` is used twice", "each import needs a unique namespace name in this file", "rename one with `{Syntax.KW_AS} alias`", Val(imp.alias_span)))
                            next
                        }
                        inline_names.insert(alias, true)
                        group_names.push(alias)
                        target :: if namespace.language == AST.ForeignLanguage.C {
                            bundle.cffi.target_for_scope(idx, Val(inline_name), alias)
                        } else {
                            bundle.modules.iter().position(fn(candidate) { candidate.display == namespace.display() })
                        }
                        if target is found {
                            resolved.push((alias, found))
                        } else {
                            group_failed = true
                            root :: namespace.language.root()
                            diags.push(Diagnostic.error("E1002", "`{root}` is reserved for first-party or foreign packages", "a foreign namespace must resolve to a mounted library before it can be imported", "make the `{root}` binding available or rename the import", Val(imp.alias_span)))
                        }
                    }
                    if !group_failed {
                        loop (alias, target) in resolved {
                            states[idx].inline_foreign_imports.insert((inline_name, alias), target)
                            if imp.is_pub -> states[idx].inline_reexport_foreign.insert((inline_name, alias), target)
                        }
                    } else {
                        loop alias in group_names -> inline_names.remove(alias)
                    }
                    next
                }
                if imp.kind is .Unqualified{module_alias, module_alias_span, ..} {
                    bindings :: imp.walk_bindings()
                    group_diagnostics :: diags.len()
                    group_names := [String]{}
                    inserted_inline := [(String, String)]{}
                    inserted_file := [(String, String)]{}
                    inserted_core := [(String, String)]{}
                    inserted_core_items := [(String, String)]{}
                    inserted_reexport_inline := [(String, String)]{}
                    inserted_reexport_file := [(String, String)]{}
                    inserted_reexport_core := [(String, String)]{}
                    pending_item_aliases := [(String, String, USize, Span)]{}
                    loop binding in bindings {
                        orig :: binding.original ?? panic("member walker returned a binding without a member")
                        local :: binding.local
                        if inline_names.contains_key(local) {
                            diags.push(Diagnostic.error("E0105", "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with `{Syntax.KW_AS} alias`", Val(imp.alias_span)))
                            next
                        }
                        inline_names.insert(local, true)
                        group_names.push(local)
                        resolved := None as Target?
                        if states[idx].code_modules.get(module_alias) is canonical {
                            mangled :: Names.member_name(canonical, orig)
                            if !states[idx].funcs.contains_key(mangled) {
                                diags.push(Diagnostic.error("E0611", "`{orig}` is not defined in module `{module_alias}`", "check the module body for the item you are importing", "make sure the name is spelled correctly", Val(module_alias_span)))
                            } else if !name_ledger.exported(idx, mangled) {
                                diags.push(Diagnostic.error("E0609", "`{orig}` is private in module `{module_alias}`", "only public items can be brought into scope with use", "add pub before fn {orig} in module {module_alias}", Val(module_alias_span)))
                            } else {
                                resolved = Val(Target.Inline{alias: module_alias, mangled: mangled})
                            }
                        } else if AST.core_list_prefix(module_alias) is core_prefix {
                            full :: "{core_prefix}.{orig}"
                            target := None as (String, String?)?
                            if AST.core_list_path(module_alias, orig) == {
                                .Module(module) -> { target = Val((module, None)) }
                                .Item{module, item} -> {
                                    if CheckerCoreLib.core_module_items(module).iter().any(fn(known) { known == item }) -> target = Val((module, Val(item)))
                                }
                                else -> {}
                            }
                            if target is (module, item) {
                                resolved = Val(Target.Core{module: module, item: item})
                            } else {
                                if Syntax.is_known_core_module(core_prefix) {
                                    diags.push(CheckerCoreLib.unknown_core_item(core_prefix, orig, binding.item_span ?? module_alias_span))
                                } else {
                                    diags.push(CheckerCoreLib.unknown_core_module(full, module_alias_span))
                                }
                            }
                        } else if states[idx].imports.get(module_alias) is target_idx {
                            visible :: name_ledger.visible(idx, target_idx, orig)
                            is_function :: states[target_idx].funcs.contains_key(orig)
                            is_other_item :: !is_function && name_ledger.declaration(target_idx, orig).map(fn(declaration) {
                                if declaration.kind == { "type" | "trait" | "const" | "tag" | "protocol" -> true else -> false }
                            }) == Val(true)
                            if !is_function && !is_other_item {
                                diags.push(Diagnostic.error("E0611", "`{orig}` is not defined in module `{module_alias}`", "check the module for the item you are importing", "make sure the name is spelled correctly", Val(module_alias_span)))
                            } else if !visible {
                                fix :: if is_function { "add pub before fn {orig} in the imported file" } else { "add pub before the declaration of {orig} in the imported file" }
                                diags.push(Diagnostic.error("E0609", "`{orig}` is private in module `{module_alias}`", "only public items can be brought into scope with use", fix, Val(module_alias_span)))
                            } else if is_other_item {
                                item_target :: "{bundle.modules[target_idx].alias}.{orig}"
                                if name_ledger.alias(idx, local).map(fn(existing) { existing.target != item_target }) == Val(true) {
                                    diags.push(Diagnostic.error("E0105", "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with `{Syntax.KW_AS} alias`", Val(imp.alias_span)))
                                } else {
                                    resolved = Val(Target.Item{target: item_target, module_idx: target_idx, span: binding.local_span})
                                }
                            } else {
                                resolved = Val(Target.File{name: orig, module_idx: target_idx})
                            }
                        } else {
                            diags.push(Diagnostic.error("E0610", "no module named {module_alias} in scope", "the alias must refer to a module in the enclosing file", "import a module as {module_alias} before this use", Val(module_alias_span)))
                        }
                        target :: resolved ?? next
                        key :: (inline_name, local)
                        if target == {
                            .Inline{alias, mangled} -> {
                                states[idx].inline_unqualified.insert(key, mangled)
                                inserted_inline.push(key)
                                if imp.is_pub {
                                    states[idx].inline_reexport_inline.insert(key, (alias, mangled))
                                    inserted_reexport_inline.push(key)
                                }
                            }
                            .File{name, module_idx} -> {
                                states[idx].inline_unqualified_file.insert(key, (name, module_idx))
                                inserted_file.push(key)
                                if imp.is_pub {
                                    states[idx].inline_reexport_file.insert(key, (name, module_idx))
                                    inserted_reexport_file.push(key)
                                }
                            }
                            .Core{module, item} -> {
                                states[idx].inline_core_imports.insert(key, module)
                                inserted_core.push(key)
                                if item is member {
                                    states[idx].inline_core_items.insert(key, member)
                                    inserted_core_items.push(key)
                                    if imp.is_pub {
                                        states[idx].inline_reexport_core.insert(key, (module, member))
                                        inserted_reexport_core.push(key)
                                    }
                                }
                            }
                            .Item{target, module_idx, span} -> { pending_item_aliases.push((local, target, module_idx, span)) }
                        }
                    }
                    if diags.len() == group_diagnostics {
                        loop (local, target, target_idx, span) in pending_item_aliases -> name_ledger.record_alias(idx, local, target, Val(target_idx), span, Names.NameVisibility.Private)
                    } else {
                        loop key in inserted_inline -> states[idx].inline_unqualified.remove(key)
                        loop key in inserted_file -> states[idx].inline_unqualified_file.remove(key)
                        loop key in inserted_core -> states[idx].inline_core_imports.remove(key)
                        loop key in inserted_core_items -> states[idx].inline_core_items.remove(key)
                        loop key in inserted_reexport_inline -> states[idx].inline_reexport_inline.remove(key)
                        loop key in inserted_reexport_file -> states[idx].inline_reexport_file.remove(key)
                        loop key in inserted_reexport_core -> states[idx].inline_reexport_core.remove(key)
                        loop name in group_names -> inline_names.remove(name)
                    }
                }
            }
        }
    }
}
