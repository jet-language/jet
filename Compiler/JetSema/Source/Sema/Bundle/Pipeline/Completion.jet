use JetSema.Sema.Bundle.Pipeline.*
use JetSema.Sema.Bundle.Validation.[check_ui_capabilities]
use JetSema.Sema.Bundle as Bundle
use JetSema.Sema.Bundle.Pipeline.FailureUnion as FailureUnion
use JetSema.Sema.Bundle.PackageSeal as PackageSeal
use JetSema.Sema.Bundle.Liveness as Liveness
use JetSema.Sema.Effects as Effects
use JetSema.Sema.Taint as Taint
use JetSema.Sema.MemoryFacts as MemoryFacts
use JetSema.Sema.App as App
use JetSema.Sema.CheckerCoreLib as CheckerCoreLib
use JetSema.Sema.[solve_inferred_failure]
use jet_foundation.[AST, Names, Facts, Syntax, Policy, CLISchema, CheckReads]
use jet_foundation.Diagnostics.[Diagnostic, DiagnosticOrigin, Span, Severity, order_diagnostics_root_first]
use std.collections.HashSet
use std.sync.Arc
use std.mem
use std.slice

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/Completion.rs:4
pub fn complete_bundle_check(bundle: &ProgramBundle, states_mut: &[ModuleState], plugin_interfaces: PluginInterfaceRegistry, devtools_registry: &AST.DevtoolsRegistry, mode: CompileMode, no_os: Bool, gates: Policy.GateSet, explicit_output: String?, incremental: &IncrementalSemaCache?, allow_compiler_api: Bool, name_ledger: Names.NameLedger, diags: [Diagnostic]) -> ([Diagnostic], Effects.SemIndexEffectFacts) Never! {
    ledger := ^name_ledger
    diagnostics := ^diags
    cache := incremental
    states :: states_mut
    populate_name_ledger(bundle, states, &ledger)
    Bundle.record_state_marker_references(bundle, &ledger)
    record_import_edge_facts(bundle, &ledger)
    check_strong_shared_cycles(states, ledger, &diagnostics)
    loop idx in 0..<bundle.modules.len() {
        loop item in bundle.modules[idx].items {
            if item is .Impl(i) && i.type_name.contains('.') {
                if !impl_type_exists(i.type_name, states[idx].registry, states[idx].imports, Val(states)) -> diagnostics.push(e0301_impl_target(i))
            }
        }
    }
    resolve_outputs(bundle, states, &ledger, mode, explicit_output, &diagnostics)
    loop module in &bundle.modules {
        const_names := [String]{}
        loop item in module.items -> if item is .Const(c) -> const_names.push(c.name)
        address_taken := HashSet<String>.new()
        loop item in module.items {
            if item == {
                .Func(f) -> { walk_stmts_for_const_refs(f.body, const_names, &address_taken) }
                .Struct(s) -> { loop m in s.methods -> walk_stmts_for_const_refs(m.body, const_names, &address_taken) }
                .Enum(e) -> { loop m in e.methods -> walk_stmts_for_const_refs(m.body, const_names, &address_taken) }
                .Impl(i) -> { loop m in i.methods -> walk_stmts_for_const_refs(m.body, const_names, &address_taken) }
                .Test(t) -> { walk_stmts_for_const_refs(t.body, const_names, &address_taken) }
                else -> {}
            }
        }
        loop item in &module.items {
            if item is .Const(c) {
                force_static :: c.is_persist || c.mutable || c.attrs.contains(AST.ConstAttr.ForceStatic)
                c.rust_kind = if force_static || address_taken.contains(c.name) { AST.RustConstKind.Static } else { AST.RustConstKind.Const }
            }
        }
    }
    loop (idx, m) in bundle.modules.enumerate() {
        if idx == bundle.entry -> next
        if states[bundle.entry].registry.contains(m.alias) -> diagnostics.push(Diagnostic.error("E0105", "the type `{m.alias}` clashes with the imported file `{m.display}`", "a type and an imported module can't share a name", "rename the type, or import with `{Syntax.KW_AS} other_name`", None))
    }
    if mode == CompileMode.Run || mode == CompileMode.Eval {
        entry_items :: bundle.modules[bundle.entry].items
        has_selected_output :: entry_items.iter().any(fn(item) {
            if item is .Const(value) -> return value.resolved_output.map(fn(output) { output.selected }) == Val(true)
            false
        })
        if !has_selected_output {
            run_fn :: entry_items.iter().find_map(fn(item) {
                if item is .Func(f) && f.name == "run" -> return Val(f)
                None
            })
            if run_fn is run {
                direct_cli :: CLISchema.is_direct_run_entry(entry_items)
                if !direct_cli {
                    if run.params.len() == 1 {
                        param :: run.params[0]
                        cli_module :: CLISchema.entry_type_module(bundle) ?? bundle.entry
                        if CheckReads.env_var_os("JET_DEBUG_CLI") != None {
                            // GATE #4494: native stderr diagnostic output.
                            eprintln("cli-debug sema module={cli_module} param={param.ty:?} cli={states[cli_module].trait_reg.implements_trait(\"RunArgs\", \"CLI\"):?} derives={states[cli_module].trait_reg.derives.keys().collect():?}")
                        }
                        if cli_entry_param_shape(bundle.modules[cli_module].items, param.ty, states[cli_module].trait_reg) == {
                            .Struct -> {}
                            .Invalid -> { diagnostics.push(e1308(Val(param.ty_span))) }
                        }
                    } else if run.params.len() > 1 -> diagnostics.push(e1308(Val(run.name_span)))
                }
            } else -> diagnostics.push(no_run_error())
        }
    }
    if mode == CompileMode.Test && !states.iter().any(fn(state) { !state.tests.is_empty() }) && !bundle.modules[bundle.entry].items.iter().any(fn(item) {
        if item is .Const(value) -> return value.resolved_output.map(fn(output) { output.selected && output.kind == AST.OutputKind.Check }) == Val(true)
        false
    }) {
        diagnostics.push(Diagnostic.error("E0601", "no `#{Syntax.KW_TEST}` blocks found to run", "add at least one top-level block: #{Syntax.KW_TEST}(\"describes what this checks\") {{ ... }}", "use `{Syntax.BUILTIN_ASSERT}` and `{Syntax.BUILTIN_ASSERT_EQ}` inside the block to check results", None))
    }
    declared_effect_facts := Facts.FactRegistry.default()
    register_effect_facts(bundle, &declared_effect_facts)
    diagnostics.extend(validate_declared_effects(bundle, declared_effect_facts))
    if mode == CompileMode.Check {
        if cache is &active -> active.begin_bundle(bundle, ledger, plugin_interfaces)
    } else -> cache = None
    embed_inputs := mem.take(&bundle.comptime_inputs)
    effect_summaries := [String:EffectSummary]{}
    module_effect_summaries := [(String, [String:EffectSummary])]{}
    diagnostics.extend(check_job_collisions(bundle.modules))
    diagnostics.extend(check_job_graph(bundle))
    global_addr_taken := HashSet<String>.new()
    FailureUnion.infer_failure_unions(bundle, states_mut, plugin_interfaces, devtools_registry, declared_effect_facts, no_os, gates, ledger, &diagnostics)
    seal := if mode == CompileMode.Check { PackageSeal.SealPlan.begin(bundle, ledger, plugin_interfaces.digest()) } else { None }
    module_pending_diagnostics := [[PendingFunctionDiagnostic]]{}
    sealed_nodes := [(String, [(String, EffectSummary)])]{}
    sealed_inferred := [USize:HashSet<String>]{}
    devtools_publications := [AST.DevtoolsFactPublication]{}
    loop (idx, module) in &bundle.modules.enumerate() {
        module_alias :: ledger.module_alias(idx) ?? module.alias
        sealed := None
        if seal is &plan -> sealed = plan.modules.get_mut(idx)
        if sealed is &record {
            global_addr_taken.extend(record.address_taken.iter())
            if record.exact_int -> states[idx].exact_int_reachable.set(true)
            sealed_inferred.insert(idx, mem.take(&record.inferred_infallible))
            sealed_nodes.push((module_alias, mem.take(&record.summaries)))
            module_pending_diagnostics.push([PendingFunctionDiagnostic]{})
            module_effect_summaries.push((module_alias, [String:EffectSummary]{}))
            next
        }
        // GATE #4494: shared native diagnostic-origin ownership.
        origin :: Arc.new(DiagnosticOrigin.new(module.display, module.path.to_string_lossy().to_string(), module.source))
        products := BodyProducts.default()
        module_diags := check_module_bodies(module, idx, states, plugin_interfaces, devtools_registry, declared_effect_facts, mode, no_os, gates, &ledger, &products, cache)
        local_summaries := ^products.summaries
        module_inputs :: ^products.embed_inputs
        local_addr_taken :: ^products.addr_taken
        local_pending_diagnostics := ^products.pending_diagnostics
        module_publications :: ^products.devtools_publications
        global_addr_taken.extend(local_addr_taken.iter())
        devtools_publications.extend(^module_publications)
        if seal is &plan -> plan.outputs.insert(idx, PackageSeal.ModuleOutputs{address_taken: local_addr_taken, discovered_inputs: !module_inputs.is_empty()})
        embed_inputs.extend(^module_inputs)
        dedupe_unknown_names(&module_diags)
        Bundle.prune_conversion_cascades(&module_diags)
        dedupe_soft_public_lints(&module_diags)
        loop diagnostic in &module_diags -> if !preserve_inline_foreign_caller_path(diagnostic) -> diagnostic.set_origin(origin.clone())
        loop pending in &local_pending_diagnostics -> if !preserve_inline_foreign_caller_path(pending.diagnostic) -> pending.diagnostic.set_origin(origin.clone())
        attach_known_cause_links(&module_diags)
        diagnostics.extend(^module_diags)
        loop pending in &local_pending_diagnostics -> pending.function_key = ledger.semantic_identity(idx, pending.function_key) ?? "{module.alias}::{pending.function_key}"
        module_pending_diagnostics.push(^local_pending_diagnostics)
        Effects.collect_lambda_effect_summaries(slice.from_mut(module), ledger, &local_summaries)
        seed_trait_dispatch_effects(module.items, &local_summaries)
        ignored_diags := [Diagnostic]{}
        apply_effect_via(module.items, &local_summaries, &ignored_diags)
        effect_summaries.extend(local_summaries.clone())
        module_effect_summaries.push((module_alias, ^local_summaries))
    }
    inferred_sets :: solve_inferred_failure(bundle, module_effect_summaries, global_addr_taken, sealed_inferred, ledger, &diagnostics)
    inferred_infallible := HashSet<String>.new()
    loop (names, (alias, _)) in inferred_sets.iter().zip(module_effect_summaries) -> loop name in names -> inferred_infallible.insert("{alias}::{name}")
    loop publication in devtools_publications {
        if devtools_registry.publications().iter().any(fn(existing) { existing.span == publication.span }) -> next
        devtools_registry.register_publication(publication) ?? diagnostics.push(registry_error(err))
    }
    check_unfed_state_fields(devtools_registry, &diagnostics)
    bundle.devtools_registry = devtools_registry.clone()
    bundle.comptime_inputs = ^embed_inputs
    failed_diagnostic_phases := HashSet<String>.new()
    loop (module_index, module) in bundle.modules.enumerate() {
        phase_diagnostic_start :: diagnostics.len()
        loop item in module.items {
            if item is .Func(f) && f.is_inline_always && global_addr_taken.contains(f.name) -> diagnostics.push(e0918_address_taken(f.name, f.inline_span ?? f.name_span))
        }
        mark_failed_pending_functions(diagnostics[phase_diagnostic_start..], module_pending_diagnostics[module_index], &failed_diagnostic_phases)
    }
    loop (module_index, module) in bundle.modules.enumerate() {
        phase_diagnostic_start :: diagnostics.len()
        apply_effect_via(module.items, &effect_summaries, &diagnostics)
        mark_failed_pending_functions(diagnostics[phase_diagnostic_start..], module_pending_diagnostics[module_index], &failed_diagnostic_phases)
    }
    taint_returns := [String:HashSet<String>]{}
    return_types := [String:AST.Type]{}
    loop module in bundle.modules -> Taint.collect_return_tag_facts(module.items, &taint_returns, &return_types)
    (public_summaries, public_reachability) :: qualified_effect_facts(module_effect_summaries, sealed_nodes, taint_returns)
    public_solved := [String:EffectSet]{}
    loop key in public_summaries.keys() {
        if public_reachability.row("effects") is row {
            if row.get(key) is effects -> public_solved.insert(key, effects.clone())
        }
    }
    Effects.project_lambda_effect_facts(&bundle.modules, ledger, public_summaries, public_reachability)
    bundle.package_guarantees.application_authority.required_effects = Effects.program_effects(bundle, public_solved, "run")
    CheckerCoreLib.validate_service_handlers(bundle, public_summaries, public_solved, &diagnostics)
    if public_reachability.row("taint") is row -> loop (key, tags) in row -> if !tags.is_empty() -> taint_returns.insert(key, tags.clone())
    loop module in &bundle.modules {
        display :: module.display
        loop item in &module.items {
            if item is .Const(value) {
                if value.resolved_output is &output {
                    alias :: ledger.module_alias(output.module) ?? states[output.module].module_alias
                    identity :: ledger.semantic_identity(output.module, output.semantic_name) ?? "{alias}::{output.semantic_name}"
                    local_identity :: "{alias}::{output.semantic_name}"
                    effects :: public_solved.get(identity) ?? public_solved.get(local_identity)
                    output.effects = effects.map(fn(row) { row.iter().collect() }) ?? [String]{}
                    ledger.record_reference(display, output.reference.start, output.reference.end, Names.NameReference{module_path: output.source_path, kind: "function", def_span: output.definition, semantic_identity: Val(identity)})
                }
            }
        }
    }
    module_aliases := [String]{}
    loop (module_idx, module) in bundle.modules.enumerate() -> module_aliases.push("{ledger.module_alias(module_idx) ?? module.alias}::")
    validation_summaries := [String:EffectSummary]{}
    loop (key, summary) in public_summaries -> if module_aliases.iter().any(fn(prefix) { key.starts_with(prefix) }) -> validation_summaries.insert(key, summary.clone())
    Effects.check_autodiff_purity(validation_summaries, public_solved, &diagnostics)
    loop (module_index, module) in bundle.modules.enumerate() {
        phase_diagnostic_start :: diagnostics.len()
        prefix :: "{ledger.module_alias(module_index) ?? module.alias}::"
        local_solved := [String:EffectSet]{}
        loop (key, row) in public_solved -> if key.strip_prefix(prefix) is local -> local_solved.insert(local.to_string(), row.clone())
        local_summaries := [String:EffectSummary]{}
        loop (key, summary) in validation_summaries {
            if key.strip_prefix(prefix) is local {
                projected := summary.clone()
                projected.edges = summary.edges.iter().map(fn(edge) { (edge.strip_prefix(prefix) ?? edge).to_string() }).collect()
                loop call in &projected.memory.calls -> call.callee = (call.callee.strip_prefix(prefix) ?? call.callee).to_string()
                local_summaries.insert(local.to_string(), ^projected)
            } else -> local_summaries.insert(key, summary.clone())
        }
        check_effect_boundaries(module.items, local_solved, local_summaries, &diagnostics)
        module_alias :: ledger.module_alias(module_index) ?? module.alias
        Effects.check_inferred_purity(module.items, module_alias, validation_summaries, public_solved, public_reachability, &diagnostics)
        check_replayable_effects(module.items, local_solved, &diagnostics)
        check_secret_grants(module.items, module_alias, public_reachability.nodes_with("secret", Effect.Secret.name()), &diagnostics)
        mark_failed_pending_functions(diagnostics[phase_diagnostic_start..], module_pending_diagnostics[module_index], &failed_diagnostic_phases)
    }
    check_region_caps(validation_summaries, public_solved, &failed_diagnostic_phases, &diagnostics)
    check_callback_bounds(validation_summaries, public_solved, &failed_diagnostic_phases, &diagnostics)
    Effects.check_discarded_results(validation_summaries, public_summaries, public_solved, inferred_infallible, &diagnostics)
    loop (module_index, pending_diagnostics) in module_pending_diagnostics.enumerate() {
        module_alias :: ledger.module_alias(module_index) ?? bundle.modules[module_index].alias
        identity_prefix :: ledger.module_identity(module_index).map(fn(identity) { "{identity}::" })
        loop pending in pending_diagnostics {
            loader_key :: identity_prefix.and_then(fn(prefix) { pending.function_key.strip_prefix(prefix).map(fn(local) { "{module_alias}::{local}" }) })
            if !failed_diagnostic_phases.contains(pending.function_key) && loader_key.map(fn(key) { failed_diagnostic_phases.contains(key) }) != Val(true) -> diagnostics.push(pending.diagnostic)
        }
    }
    (memory_summaries, memory_declarations) :: MemoryFacts.bundle_memory_inputs(bundle, public_summaries)
    // GATE #4499: exact composite memory-fact keys.
    memory_projections := [:]
    loop declaration in memory_declarations -> loop root in declaration.roots -> memory_projections.insert((root, declaration.fact), MemoryFacts.project_memory_fact(declaration.fact, root, memory_summaries))
    diagnostics.extend(MemoryFacts.check_memory_facts(memory_declarations, memory_summaries))
    diagnostics.extend(check_web_partition(bundle, public_summaries, public_solved))
    (app_graph, app_diags) :: App.extract_app_graph_with_effects_and_registry(bundle, public_solved, states[bundle.entry].trait_reg)
    diagnostics.extend(^app_diags)
    diagnostics.extend(Liveness.check_liveness(bundle, &ledger, app_graph))
    diagnostics.extend(check_os_target(bundle, no_os))
    fact_registry :: check_fact_tags_and_states(bundle, states, taint_returns, return_types, &diagnostics)
    (used_core_value, usage_spans, ffi_callback_fns) :: collect_used_core(bundle, states)
    used_core := ^used_core_value
    if bundle.modules.iter().any(fn(m) { m.items.iter().any(fn(i) {
        if i == {
            .Struct(s) -> s.derives.iter().any(fn(t) { t.0 == "CLI" })
            .Func(f) -> f.is_job
            else -> false
        }
    }) }) -> used_core.insert("core.args::spec")
    if bundle.modules.iter().any(fn(m) { m.source.contains("Pool<") || m.source.contains("Shared<") || m.source.contains("shared ") || m.source.contains("Cell<") || m.source.contains("Cell.new(") || m.source.contains("ID<") }) -> used_core.insert("core.mem::pool_shared")
    if bundle.modules.iter().any(fn(m) { m.source.contains("Matrix<") || m.source.contains("Vec<") }) -> used_core.insert("core.compute::shape_alias")
    if bundle.modules.iter().any(fn(m) { m.items.iter().any(fn(i) {
        if i is .Struct(s) -> return !s.validate_block.is_empty()
        false
    }) }) -> used_core.insert("core.validate::field_error")
    expand_core_reachable_closure(&used_core)
    diagnostics.extend(check_ui_capabilities(bundle, used_core, usage_spans))
    bundle.used_core = ^used_core
    bundle.ffi_callback_fns = ^ffi_callback_fns
    diagnostics.extend(MemoryFacts.annotate_scoped_gc_promotions(bundle))
    apply_helper_layer_inference(bundle, states, usage_spans, &diagnostics)
    bundle.name_ledger = ledger.clone()
    if !allow_compiler_api && mode != CompileMode.Check -> Bundle.strip_build_only_entries(bundle)
    suppress_duplicate_root_panic(bundle, ledger, public_summaries, &public_solved)
    if seal is plan {
        sealed_paths :: plan.sealed_paths(bundle)
        exact_int :: states.iter().map(fn(state) { state.exact_int_reachable.get() }).collect()
        plan.finish(bundle, ledger, public_summaries, inferred_sets, exact_int, diagnostics)
        diagnostics.retain(fn(diagnostic) { diagnostic.origin().map(fn(origin) { sealed_paths.contains(origin.path) }) != Val(true) })
    }
    diagnostics.retain(fn(diagnostic) { diagnostic.severity != Severity.Lint || diagnostic.origin().map(fn(origin) { origin.is_core_source() }) != Val(true) })
    order_diagnostics_root_first(&diagnostics)
    (^diagnostics, Effects.SemIndexEffectFacts{summaries: public_summaries, solved: ^public_solved, reachability: public_reachability, memory_declarations: memory_declarations, memory_projections: ^memory_projections, name_ledger: ledger.clone(), web_app: app_graph, fact_registry: fact_registry})
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/Completion.rs:256
fn preserve_inline_foreign_caller_path(diagnostic: Diagnostic) -> Bool Never! {
    if diagnostic.code == { "E3102" | "E3215" | "E3222" | "E3223" -> true else -> false }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/Completion.rs:876
fn suppress_duplicate_root_panic(bundle: ProgramBundle, ledger: Names.NameLedger, summaries: [String:EffectSummary], solved: &[String:EffectSet]) {
    root_aliases := HashSet<String>.new()
    dependency_aliases := HashSet<String>.new()
    loop (module_index, module) in bundle.modules.enumerate() {
        aliases :: [String]{module.alias, ledger.module_alias(module_index) ?? module.alias}
        owner :: bundle.dep_roots.iter().find(fn(pair) { module.path.starts_with(pair.1) }).map(fn(pair) { pair.0 })
        if owner is dependency {
            if dependency_boundary_span(bundle, dependency) != None -> dependency_aliases.extend(aliases)
        } else -> root_aliases.extend(aliases)
    }
    if root_aliases.is_empty() || dependency_aliases.is_empty() -> return
    root_keys :: solved.keys().filter(fn(key) { key.split_once("::").map(fn(pair) { root_aliases.contains(pair.0) }) == Val(true) }).collect()
    loop key in root_keys {
        effects :: &solved.get_mut(key) ?? next
        if !effect_set_has_root(effects, Effect.Panic) -> next
        seen := HashSet<String>.new()
        site :: panic_site_for_budget(key, summaries, &seen) ?? next
        site_alias :: site.split_once("::").map(fn(pair) { pair.0 })
        root_seen := HashSet<String>.new()
        if site_alias.map(fn(alias) { dependency_aliases.contains(alias) }) != Val(true) || panic_reaches_root(key, summaries, root_aliases, &root_seen) -> next
        effects.retain(fn(effect) { effect_root(effect) != Effect.Panic.name() })
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/Completion.rs:934
fn dependency_boundary_span(bundle: ProgramBundle, dependency: String) -> Span? Never! {
    entry :: bundle.modules.get(bundle.entry) ?? return None
    loop import in entry.imports {
        if import.kind == {
            .Module(name, span) -> { if name == dependency -> return Val(span) }
            .Unqualified{module_alias, module_alias_span, ..} -> { if module_alias == dependency -> return Val(module_alias_span) }
            else -> {}
        }
    }
    None
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/Completion.rs:951
fn panic_site_for_budget(key: String, summaries: [String:EffectSummary], seen: &HashSet<String>) -> String? Never! {
    if !seen.insert(key) -> return None
    summary :: summaries.get(key) ?? return None
    if summary.maximal || effect_set_has_root(summary.direct, Effect.Panic) || summary.edges.contains("__jet_panic__") -> return Val(key)
    loop callee in summary.edges {
        if panic_site_for_budget(callee, summaries, seen) is site -> return Val(site)
    }
    None
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/Completion.rs:972
fn panic_reaches_root(key: String, summaries: [String:EffectSummary], root_aliases: HashSet<String>, seen: &HashSet<String>) -> Bool Never! {
    if !seen.insert(key) -> return false
    summary :: summaries.get(key) ?? return false
    is_root :: key.split_once("::").map(fn(pair) { root_aliases.contains(pair.0) }) == Val(true)
    if is_root && (summary.maximal || effect_set_has_root(summary.direct, Effect.Panic) || summary.edges.contains("__jet_panic__")) -> return true
    loop callee in summary.edges -> if panic_reaches_root(callee, summaries, root_aliases, seen) -> return true
    false
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/Completion.rs:1006
fn attach_known_cause_links(diagnostics: &[Diagnostic]) {
    loop index in 0..<diagnostics.len() {
        dependent :: diagnostics[index]
        if dependent.code != "E2404" || !dependent.cause.is_empty() -> next
        span :: dependent.span ?? next
        cause := None as Diagnostic?
        loop (candidate_index, candidate) in diagnostics.enumerate() {
            if candidate_index != index && candidate.code == "E0104" && candidate.span == Val(span) {
                cause = Val(candidate.clone())
                break
            }
        }
        if cause is root -> diagnostics[index] = dependent.clone().caused_by(root)
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/Completion.rs:1034
fn record_import_edge_facts(bundle: ProgramBundle, ledger: &Names.NameLedger) {
    loop (module_idx, module) in bundle.modules.enumerate() {
        source :: ledger.module_path(module_idx) ?? module.display
        loop import in module.imports {
            target_idx :: ledger.import_target(module_idx, import.span) ?? next
            target :: ledger.module_path(target_idx) ?? next
            if ledger.structure_facts().iter().any(fn(fact) { fact.kind == Names.StructureFactKind.ImportEdge && fact.source == source && fact.span == import.span }) -> next
            ledger.record_structure_fact(Names.StructureFact.new(Names.StructureFactKind.ImportEdge, "{source} -> {target}", source, import.span, "resolved", "resolved import edge", None))
        }
    }
}
