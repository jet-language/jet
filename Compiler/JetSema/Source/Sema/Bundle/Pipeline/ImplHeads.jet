use JetSema.Sema.Bundle.Pipeline.*
use jet_foundation.Diagnostics.[Span]

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/ImplHeads.rs:5
pub struct QualifiedImplTrait {
    pub key: String
    pub target: USize
    pub leaf: String
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/ImplHeads.rs:20
pub fn normalize_qualified_impl_heads(bundle: &ProgramBundle) -> [[QualifiedImplTrait]] Never! {
    qualified_traits := [[QualifiedImplTrait]]{}
    loop idx in 0..<bundle.modules.len() {
        aliases := [String:USize]{}
        loop import in bundle.modules[idx].imports {
            if import.kind == { .Unqualified{..} -> true else -> false } -> next
            if bundle.name_ledger.import_target(idx, import.span) is target {
                aliases.insert(import.import_alias(), target)
            }
        }
        traits := [QualifiedImplTrait]{}
        if aliases.is_empty() {
            qualified_traits.push(^traits)
            next
        }
        same_package := [USize:Bool]{}
        module_identities := [USize:String]{}
        loop target in aliases.values() {
            same_package.insert(target, bundle.name_ledger.same_namespace(idx, target))
            if bundle.name_ledger.module_identity(target) is identity -> module_identities.insert(target, identity)
        }
        used_aliases := [String]{}
        loop item in &bundle.modules[idx].items {
            if item is .Impl(implementation) {
                trait_name :: implementation.trait_name ?? next
                segments := [String]{}
                loop segment in implementation.type_name.split('.') -> segments.push(segment.to_string())
                loop segment in trait_name.split('.') -> segments.push(segment.to_string())
                paths := [(USize?, String, String)]{}
                at := 0
                loop at < segments.len() {
                    target :: aliases.get(segments[at])
                    if target is owner && at + 1 < segments.len() {
                        paths.push((Val(owner), "{segments[at]}.{segments[at + 1]}", segments[at + 1]))
                        at += 2
                    } else {
                        paths.push((None, segments[at], segments[at]))
                        at += 1
                    }
                }
                if paths.len() > 2 || paths.iter().all(fn(path) { path.0 == None }) -> next
                loop (target, written, _) in paths {
                    if target != None {
                        if written.split_once('.') is (alias, _) -> used_aliases.push(alias.to_string())
                    }
                }
                resolved :: fn(path: (USize?, String, String)) -> String Never! {
                    if path.0 is target && same_package[target] -> return path.2
                    path.1
                }
                start :: implementation.type_span.start
                end :: implementation.trait_span.map(fn(span) { span.end }) ?? implementation.type_span.end
                first_end :: start + paths[0].1.len()
                type_name :: resolved(paths[0])
                if paths.get(1) is trait_path {
                    trait_key := resolved(trait_path)
                    if trait_path.0 is target && !same_package[target] {
                        if module_identities.get(target) is identity -> trait_key = "{identity}::{trait_path.2}"
                    }
                    if trait_path.0 is target -> traits.push(QualifiedImplTrait{key: trait_key, target: target, leaf: trait_path.2})
                    implementation.type_name = type_name
                    implementation.type_span = Span.new(start, first_end)
                    implementation.trait_name = Val(trait_key)
                    implementation.trait_span = Val(Span.new(end - trait_path.1.len(), end))
                } else {
                    implementation.type_name = type_name
                    implementation.type_span = Span.new(start, end)
                    implementation.trait_name = None
                    implementation.trait_span = None
                }
            }
        }
        // Record rewritten alias uses at the loader-owned alias-span key.
        loop alias in used_aliases {
            span :: bundle.modules[idx].imports.iter().find(fn(import) { import.import_alias() == alias }).map(fn(import) { import.alias_span })
            if span is found -> bundle.name_ledger.record_loader_alias_use(idx, found)
        }
        qualified_traits.push(^traits)
    }
    qualified_traits
}
