// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/CheckInner.rs:3
fn check_bundle_opts_for_output_inner(bundle: &ProgramBundle, mode: CompileMode, no_os: Bool, gates: GateSet, explicit_output: String?, incremental: IncrementalSemaCache?, allow_compiler_api: Bool) -> ([Diagnostic], SemIndexEffectFacts) Never! {
    guard_fact_registry_law()
    foreign_diags :: validate_foreign_imports(bundle)
    if !foreign_diags.is_empty() -> return (foreign_diags, SemIndexEffectFacts.default())
    diags := [Diagnostic]{}
    &diags.extend(validate_script_entries(bundle))
    default_entry_return(bundle)
    &diags.extend(inject_units_prelude(bundle))
    Prelude.inject(bundle)
    &diags.extend(Casing.validate_bundle(bundle))
    os_switches_before :: canonical_pass_ast_payload(bundle)
    os_switches_identity_before :: canonical_pass_ast_identity(bundle)
    &diags.extend(desugar_os_switches(bundle))
    canonical_pass_record("lowering", "sema.desugar-os-switches", "crates/jet-sema/src/Sema/OSTarget.rs", "ast", ^os_switches_before, ^os_switches_identity_before, "ast", ^canonical_pass_ast_payload(bundle), ^canonical_pass_ast_identity(bundle), "preserve")
    migrations_before :: canonical_pass_ast_payload(bundle)
    migrations_identity_before :: canonical_pass_ast_identity(bundle)
    desugar_migrations(bundle)
    canonical_pass_record("lowering", "sema.desugar-migrations", "crates/jet-sema/src/Sema/SchemaMigration.rs", "ast", ^migrations_before, ^migrations_identity_before, "ast", ^canonical_pass_ast_payload(bundle), ^canonical_pass_ast_identity(bundle), "preserve")
    spreads_before :: canonical_pass_ast_payload(bundle)
    spreads_identity_before :: canonical_pass_ast_identity(bundle)
    desugar_member_spreads(bundle)
    canonical_pass_record("lowering", "sema.desugar-member-spreads", "crates/jet-sema/src/Sema/MemberSpread.rs", "ast", ^spreads_before, ^spreads_identity_before, "ast", ^canonical_pass_ast_payload(bundle), ^canonical_pass_ast_identity(bundle), "preserve")
    expand_generic_module_aliases(bundle, &diags)
    multi_head_before :: canonical_pass_ast_payload(bundle)
    multi_head_identity_before :: canonical_pass_ast_identity(bundle)
    desugar_multi_head_functions(bundle, &diags)
    canonical_pass_record("lowering", "sema.desugar-multi-head-functions", "crates/jet-sema/src/Sema/Bundle.rs", "ast", ^multi_head_before, ^multi_head_identity_before, "ast", ^canonical_pass_ast_payload(bundle), ^canonical_pass_ast_identity(bundle), "preserve")
    hoist_inline_module_member_types(bundle)
    qualified_impl_traits :: normalize_qualified_impl_heads(bundle)
    mangle_inline_sibling_calls(bundle)
    &diags.extend(UnsafeObligations.check_and_strip_with_gates(bundle, gates))
    // #4499: package/name tuple keys preserve exact nominal identity.
    callable_policy_declarations := [(String, String):(Int, UserPolicyDecl)]{}
    loop (module_idx, module) in bundle.modules {
        package_scope :: package_scope_for(module.path, bundle.project_root)
        loop declaration in module.user_policy_declarations {
            if CallablePolicyChain.is_builtin(declaration.name) {
                &diags.push(Diagnostic.error("E0105", "policy setting `{declaration.name}` redeclares a compiler-owned setting", "built-in callable policies and package settings share one nominal vocabulary", "choose a different policy setting name", Val(declaration.name_span)))
                next
            }
            key :: (package_scope, declaration.name)
            if callable_policy_declarations.get(key) == .Val((first_module, first)) {
                &diags.push(Diagnostic.error("E0105", "policy setting `{declaration.name}` is declared twice (spans {first.name_span.start}..{first.name_span.end} and {declaration.name_span.start}..{declaration.name_span.end})", "one package-owned policy name must resolve to one checked wrapper", "rename or remove one of the policy declarations", Val(declaration.name_span)).with_detail("first declaration: module {first_module}, span {first.span.start}..{first.span.end}\nsecond declaration: module {module_idx}, span {declaration.span.start}..{declaration.span.end}"))
            } else -> callable_policy_declarations[key] = (module_idx, declaration)
        }
    }
    states := [ModuleState]{}
    loop (module_idx, m) in bundle.modules {
        &states.push(ModuleState{
            module_path: m.display, source: m.source,
            package_scope: package_scope_for(m.path, bundle.project_root), module_alias: m.alias,
            items: ~m.items, build_facts: bundle.build_facts,
            allow_compiler_api: allow_compiler_api && module_idx == bundle.entry,
            exact_int_reachable: [], diverging_functions: [:], fixed_length_write_params: [:],
            funcs: [:], registry: builtin_type_registry(), consts: [:], imports: [:],
            inline_foreign_imports: [:], inline_reexport_foreign: [:], core_imports: [:], tests: [:],
            trait_reg: TraitRegistry.default(), fact_registry: StateTable.declaration_facts(m.items),
            policy_declarations: m.policy_declarations, callable_policy_declarations: callable_policy_declarations,
            rule_facts: m.rule_facts, code_modules: [:], code_module_identities: [:], unqualified: [:],
            unqualified_file: [:], core_item_imports: [:], reexports: [:], inline_unqualified: [:],
            inline_unqualified_file: [:], inline_core_imports: [:], inline_core_items: [:],
            inline_reexport_inline: [:], inline_reexport_file: [:], inline_reexport_core: [:]
        })
    }
    initial_items :: || bundle.modules.iter().flat_map(|module| module.items.iter())
    initial_fact_registry := StateTable.declaration_facts(initial_items())
    loop (type_name, graph) in checked_state_graphs(initial_items()) -> initial_fact_registry.set_state_graph("{type_name}.State", graph)
    loop state in &states -> state.fact_registry = initial_fact_registry
    name_ledger := ^bundle.name_ledger
    name_ledger.clear_sema_facts()
    shared_instance_nominals := [(Int, Item)]{}
    loop (owner, module) in bundle.modules {
        prefixes := [String]{}
        loop item in module.items {
            if item == .CodeModule(cm) { if cm.instance_identity != None -> &prefixes.push(GenericModules.module_type_prefix(cm.name)) }
        }
        loop item in module.items {
            if item == {
                .Struct(def) -> { if prefixes.iter().any(|prefix| def.name.starts_with(prefix)) -> &shared_instance_nominals.push((owner, .Struct(clone_struct(def)))) }
                .Enum(def) -> { if prefixes.iter().any(|prefix| def.name.starts_with(prefix)) -> &shared_instance_nominals.push((owner, .Enum(clone_enum(def)))) }
                else -> {}
            }
        }
    }
    loop (owner, item) in shared_instance_nominals {
        loop (consumer, st) in &states {
            if consumer == owner -> next
            generated_name :: if item == {
                .Struct(def) -> {
                    register_struct(def, &st.registry, &diags, st.funcs, st.consts, TargetLayout.from_build_facts(st.build_facts))
                    def.name
                }
                .Enum(def) -> {
                    register_enum(def, &st.registry, &diags, st.funcs, st.consts)
                    def.name
                }
                else -> panic("shared instance nominal must be struct or enum")
            }
            module_alias :: bundle.modules[consumer].alias
            declare_item_names(&name_ledger, consumer, module_alias, item)
            display := String?{None}
            loop owner_item in bundle.modules[owner].items {
                if owner_item == .CodeModule(instance) {
                    if instance.instance_identity == None -> next
                    loop (internal, path) in GenericModules.top_level_instance_display_paths(instance, bundle.modules[owner].items) {
                        if internal == generated_name { display = Val(path); break }
                    }
                    if display != None -> break
                }
            }
            if display == .Val(path) -> name_ledger.record_display_path(consumer, "{module_alias}.{generated_name}", path)
        }
    }
    populate_name_ledger(bundle, states, &name_ledger)
    bundle.name_ledger = ^name_ledger
    &diags.extend(resolve_unit_dimensions(bundle))
    name_ledger = ^bundle.name_ledger
    derive_providers := [(Int, String, String, [DeriveBodyItem], [String:Func])]{}
    loop (origin, module) in bundle.modules {
        helpers := [String:Func]{}
        loop item in module.items { if item == .Func(f) -> helpers[f.name] = f }
        loop item in module.items { if item == .UserDerive(d) -> &derive_providers.push((origin, d.trait_name, d.type_param, d.body, helpers)) }
    }
    marker_declarations := [MarkerDecl]{}
    marker_declaration_spans := [String:(Int, Span)]{}
    fact_declaration_spans := [String:(Int, Span, String)]{}
    loop (module_idx, module) in bundle.modules {
        loop item in module.items {
            if item == {
                .MarkerDecl(declaration) -> {
                    previous :: marker_declaration_spans.get(declaration.name)
                    marker_declaration_spans[declaration.name] = (module_idx, declaration.name_span)
                    if previous == .Val((first_module, first_span)) {
                        &diags.push(Diagnostic.error("E0105", "marker `{declaration.name}` is declared twice (spans {first_span.start}..{first_span.end} and {declaration.name_span.start}..{declaration.name_span.end})", "one rule name must resolve to one declaration in the loaded bundle", "rename or remove one of the marker declarations", Val(declaration.name_span)).with_detail("first declaration: module {first_module}, span {first_span.start}..{first_span.end}\nsecond declaration: module {module_idx}, span {declaration.name_span.start}..{declaration.name_span.end}"))
                    } else -> &marker_declarations.push(declaration)
                }
                .FactDecl(declaration) -> register_fact_declaration(declaration, module_idx, &fact_declaration_spans, &diags)
                else -> {}
            }
        }
    }
    marker_vocabulary :: MarkerVocabulary.with_derives_and_declarations(derive_providers.iter().map(|(_, name, _, _, _)| name), marker_declarations)
    ct_core_imports := [[String:String]]{}
    ct_core_item_imports := [[String:String]]{}
    loop module in bundle.modules {
        (imports, items) :: core_import_maps(module.imports)
        &ct_core_imports.push(imports)
        &ct_core_item_imports.push(items)
    }
    loop module in &bundle.modules {
        Protocol.expand_module_protocols(&module.items, &diags)
        process_computed_fields(&module.items, &diags)
        process_validate_blocks(&module.items, &diags)
        inject_patchable_types(&module.items, &diags)
    }
    plugin_interfaces :: PluginInterfaceRegistry.from_bundle(bundle)
    devtools_registry := DevtoolsRegistry.default()
    needs_comptime_checking :: bundle.modules.iter().any(|module| module.items.iter().any(|item| if item == .Const(constant) -> Registration.const_evaluated_at_build(constant) else -> false))
    comptime_states := [ModuleState]{}
    if needs_comptime_checking {
        parked_items := [[Item]]{}
        loop state in &states -> &parked_items.push(^state.items)
        comptime_states = ~states
        loop (idx, items) in parked_items -> states[idx].items = ^items
    }
    loop idx in 0..<comptime_states.len() {
        module :: bundle.modules[idx]
        comptime_states[idx].items = ~module.items
        comptime_states[idx].core_imports = ct_core_imports[idx]
        comptime_states[idx].core_item_imports = ct_core_item_imports[idx]
        loop import in module.imports {
            if name_ledger.import_target(idx, import.span) == .Val(target) -> comptime_states[idx].imports[import.import_alias()] = target
        }
        Registration.register_comptime_declarations(module.items, &comptime_states[idx], !module.no_prelude)
    }
    loop idx in 0..<comptime_states.len() {
        loop import in bundle.modules[idx].imports {
            if import.kind != .Unqualified(module_alias, _) -> next
            target :: comptime_states[idx].imports.get(module_alias) ?? next
            candidates := [Int]{target}
            &candidates.extend(name_ledger.namespace_siblings(target))
            loop binding in import.walk_bindings() {
                original :: binding.original ?? next
                loop candidate in candidates {
                    if comptime_states[candidate].funcs.contains_key(original) {
                        comptime_states[idx].unqualified_file[binding.local] = (original, candidate)
                        break
                    }
                }
            }
        }
    }
    imported_traits := [[(String, TraitDef, Bool)]]{}
    loop (idx, module) in bundle.modules {
        package :: package_scope_for(module.path, bundle.project_root)
        traits := [(String, TraitDef, Bool)]{}
        loop imp in module.imports {
            if imp.kind != .Unqualified(module_alias, _) -> next
            target := Int?{None}
            loop candidate in module.imports {
                if candidate.kind == .Unqualified(_, _) -> next
                if candidate.import_alias() == module_alias {
                    if name_ledger.import_target(idx, candidate.span) == .Val(found) { target = Val(found); break }
                }
            }
            target_idx :: target ?? next
            target_module :: bundle.modules[target_idx]
            same_package :: package_scope_for(target_module.path, bundle.project_root) == package
            same_namespace :: name_ledger.same_namespace(idx, target_idx)
            loop binding in imp.walk_bindings() {
                original :: binding.original ?? next
                loop item in target_module.items {
                    if item == .Trait(definition) {
                        if definition.name == original && (definition.is_pub || same_namespace || (definition.is_package_pub && same_package)) {
                            &traits.push((binding.local, definition, same_package)); break
                        }
                    }
                }
            }
        }
        loop qualified in qualified_impl_traits.get(idx) ?? [] {
            same_package :: name_ledger.same_namespace(idx, qualified.target)
            loop item in bundle.modules[qualified.target].items {
                if item == .Trait(definition) {
                    if definition.name == qualified.leaf && (same_package || definition.is_pub) {
                        &traits.push((qualified.key, definition, same_package)); break
                    }
                }
            }
        }
        &imported_traits.push(traits)
    }
    namespace_type_owners := [String:[Int]]{}
    loop (idx, module) in bundle.modules {
        if name_ledger.namespace_siblings(idx).is_empty() -> next
        loop item in module.items {
            name :: if item == {
                .Struct(definition) | .Enum(definition) | .Distinct(definition) -> definition.name
                else -> next
            }
            owners := namespace_type_owners.get(name) ?? []
            &owners.push(idx)
            namespace_type_owners[name] = owners
        }
    }
    sibling_type_owner :: |ledger, idx, type_name| namespace_type_owners.get(type_name).and_then(|owners| owners.iter().find(|owner| owner != idx && ledger.same_namespace(idx, owner)))
    top_level_embed_inputs := []
    module_count :: bundle.modules.len()
    comptime_reuse :: ComptimeReuse.environment(bundle)
    module_comptime_types := [[String:Ty]].repeat([:], module_count)
    if needs_comptime_checking {
        loop idx in comptime_module_order(bundle, name_ledger) {
            module_diag_start :: diags.len()
            module := &bundle.modules[idx]
            base :: module.path.parent() ?? OSPath.from(".")
            eval_comptime_items(&module.items, &module_comptime_types[idx], base, &diags, idx, &name_ledger, ct_core_imports[idx], ct_core_item_imports[idx], bundle.build_facts, &comptime_states, plugin_interfaces, devtools_registry, no_os, gates, module.no_prelude, Val(&top_level_embed_inputs), comptime_reuse)
            attach_module_origin(module, idx == bundle.entry, &diags[module_diag_start..])
            drop_core_source_lints(module, &diags, module_diag_start)
        }
    }
    _ :: ^comptime_states
    loop (idx, module) in &bundle.modules {
        module_diag_start :: diags.len()
        base :: module.path.parent() ?? OSPath.from(".")
        comptime_types :: ^module_comptime_types[idx]
        expand_item_template_loops(&module.items, base, &diags)
        states[idx].items = ~module.items
        Registration.resolve_comptime_declaration_values(&module.items, base, ct_core_imports[idx], &diags)
        CheckerMarkers.resolve_static_rule_products(module, base, ct_core_imports[idx], &diags)
        ffi_named_types := [String:TypeDef]?{None}
        if module.items.iter().any(|item| if item == .CModule(_) -> true else -> false) {
            types := [String:TypeDef]{}
            loop preceding in states[..idx] { loop (k, v) in preceding.registry.types -> types[k] = v }
            ffi_named_types = Val(types)
        }
        st := &states[idx]
        loop item in module.items {
            if item == .MarkerDecl(_) || item == .FactDecl(_) -> next
            if item == {
                .Func(f) -> register_func_item(f, st, &diags, !module.no_prelude)
                .Struct(s) -> register_struct(s, &st.registry, &diags, st.funcs, st.consts, TargetLayout.from_build_facts(st.build_facts))
                .Enum(e) -> register_enum(e, &st.registry, &diags, st.funcs, st.consts)
                .Impl(i) -> {
                    if !i.type_name.contains(".") && !st.registry.contains(i.type_name) && sibling_type_owner(name_ledger, idx, i.type_name) == None && !opmix_allows_builtin_impl(i, module.items) -> &diags.push(e0301_impl_target(i))
                }
                .Const(c) -> {
                    if c.meta == .Val(meta) -> &diags.extend(CheckerCore.check_meta_attr_fields(meta))
                    register_const(c, &st.consts, &diags, st.funcs, st.registry)
                }
                .Distinct(d) -> register_distinct(d, &st.registry, &diags, st.funcs, st.consts)
                .TypeAlias(a) -> register_type_alias(a, &st.registry, &diags, st.funcs, st.consts)
                .UnitFamily(uf) -> {
                    dimension :: uf.resolved_dimension
                    loop d in uf.distinct_defs() {
                        register_distinct(d, &st.registry, &diags, st.funcs, st.consts)
                        st.registry.unit_types[d.name] = true
                        if uf.resolved_owner == .Val(owner) {
                            if uf.base != None || dimension != None {
                                if unit_fact(uf, d.name, dimension, OSPath.from(owner)) == .Val(fact) -> st.registry.unit_facts[d.name] = fact
                            }
                        }
                    }
                    if uf.is_canonical_time() {
                        loop member in uf.members -> st.registry.literal_facts["{uf.family}::{member.name}"] = UnitFact{package: OSPath.from(uf.resolved_owner ?? "core.units"), family: uf.family, member: member.name, dimension: dimension, scale: member.scale, scale_provenance: member.scale_provenance, offset: UnitRatio.zero(), kind: QuantityKind.Delta}
                    }
                }
                .Test(t) -> register_test_item(t, st, &diags)
                .ExternRust(block) -> {
                    if check_extern_block(block, st.registry, &diags) {
                        register_foreign_close_impls(block.functions, &st.trait_reg)
                        loop ef in block.functions -> register_extern_fn(ef, &st.funcs, st.registry, st.consts, &diags, false, !module.no_prelude)
                    }
                }
                .CModule(cm) -> {
                    merged_registry := TypeRegistry?{None}
                    if ffi_named_types == .Val(extra) {
                        types := ~st.registry.types
                        loop (k, v) in extra { if !types.contains_key(k) -> types[k] = v }
                        merged_registry = Val(TypeRegistry{types: types, error_types: st.registry.error_types, unit_types: st.registry.unit_types, unit_facts: st.registry.unit_facts, literal_facts: st.registry.literal_facts, computed_fields: st.registry.computed_fields, field_defaults: st.registry.field_defaults, receipt_sections: st.registry.receipt_sections, nominal_memo: [:]})
                    }
                    check_registry :: merged_registry ?? st.registry
                    handle_facts :: bundle.cffi.handle_facts.iter().filter(|fact| fact.lib == cm.lib).collect()
                    close_adapters :: bundle.cffi.close_adapters.iter().filter(|adapter| adapter.lib == cm.lib).collect()
                    if check_c_module_with_facts(cm, check_registry, handle_facts, close_adapters, bundle.cffi.boundary_for(cm.lib), &diags) {
                        register_foreign_close_impls(cm.functions, &st.trait_reg)
                        loop ef in cm.functions -> register_extern_fn(ef, &st.funcs, check_registry, st.consts, &diags, true, !module.no_prelude)
                    }
                }
                .CodeModule(cm) -> {
                    if cm.body == .Val(body) {
                        st.code_modules[cm.name] = cm.name
                        st.code_module_identities[cm.name] = if cm.instance_identity == .Val(identity) -> "instance:{identity.fingerprint}" else -> "module:{st.module_path}::{cm.name}"
                        loop inner in body {
                            if inner == .Func(f) {
                                mangled :: member_name(cm.name, f.name)
                                st.funcs[mangled] = func_to_sig(f)
                                if !f.type_params.is_empty() -> st.trait_reg.fn_params[mangled] = f.type_params
                            }
                        }
                    }
                }
                .MarkerDecl(_) | .FactDecl(_) -> panic("declaration items are consumed by the bundle registry")
                .Tag(_) | .Trait(_) | .Module(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .EffectDecl(_) | .GenericModule(_) | .ModuleAlias(_) -> {}
            }
        }
        generated_test_spans := [Span]{}
        if !derive_providers.is_empty() {
            struct_infos :: module.items.iter().filter_map(|item| if item == .Struct(s) -> Val(s) else -> None).collect()
            new_items := [Item]{}
            checked_nominals :: CheckerCore.checked_comptime_nominals_for_context(states, idx, name_ledger)
            st = &states[idx]
            loop s in struct_infos {
                existing_member_sites := [String:(String, Span)]{}
                loop item in module.items {
                    if item == {
                        .Struct(candidate) -> {
                            if candidate.name == s.name {
                                loop field in candidate.fields -> existing_member_sites[field.name] = ("existing field `{s.name}.{field.name}`", field.name_span)
                                loop method in candidate.methods -> existing_member_sites[method.name] = ("existing method `{s.name}.{method.name}`", method.name_span)
                            }
                        }
                        .Impl(candidate) -> {
                            if candidate.type_name == s.name {
                                loop method in candidate.methods -> existing_member_sites[method.name] = ("existing method `{s.name}.{method.name}`", method.name_span)
                            }
                        }
                        else -> {}
                    }
                }
                generated_method_spans := [String:(String, Span)]{}
                loop (derive_name, _derive_span) in s.derives {
                    provider :: derive_providers.iter().filter(|(_, name, _, _, _)| name == derive_name).min_by_key(|(origin, _, _, _, _)| if origin == 0 -> 0 else if origin == idx -> 1 else -> 2) ?? next
                    (provider_idx, _, type_param, body, helper_funcs) :: provider
                    if idx > 0 && provider_idx > 0 {
                        &diags.push(Diagnostic.error("E2711", "derive orphan rule: neither `derive T.{derive_name}` nor `{s.name}` is local", "a generated implementation is owned locally only when the derive provider or target type lives in the entry module", "define `derive T.{derive_name}` or `{s.name}` in the entry module", None))
                        next
                    }
                    state_members :: initial_fact_registry.state_members(s.name) ?? []
                    type_path :: name_ledger.canonical_path(idx, s.name) ?? panic("derive target missing from the name ledger")
                    layout_engine :: TargetLayoutEngine.new(module.items.iter(), TargetLayout.from_build_facts(bundle.build_facts))
                    type_info :: Comptime.build_struct_type_info_with_path_and_vocabulary_and_engine(s, state_members, type_path, None, layout_engine)
                    if Comptime.expand_derive_body(body, type_param, type_info, helper_funcs, bundle.project_root, checked_nominals) == {
                        .Ok(expanded) -> {
                            methods := [Func]{}
                            loop item in expanded {
                                if item == .Func(function) {
                                    if existing_member_sites.get(function.name) == .Val((existing_site, existing_span)) {
                                        &diags.push(derive_member_collision(derive_name, s.name, function, existing_site, existing_span))
                                        next
                                    }
                                    if generated_method_spans.get(function.name) == .Val((generated_derive, generated_span)) {
                                        existing_site :: "generated member `{function.name}` from `derive T.{generated_derive}`"
                                        &diags.push(derive_member_collision(derive_name, s.name, function, existing_site, generated_span))
                                        next
                                    }
                                    generated_method_spans[function.name] = (derive_name, function.name_span)
                                    &methods.push(function)
                                } else -> &new_items.push(item)
                            }
                            if !methods.is_empty() -> &new_items.push(.Impl(ImplDef{span: s.span, type_name: s.name, type_span: s.name_span, trait_name: None, trait_span: None, operator_rhs: None, operator_marker: None, methods: methods, delegation_field: None, assoc_type_impls: [], is_generated_serde: false, os_target: None}))
                        }
                        .Err(inner) -> &diags.push(inner)
                    }
                }
            }
            loop item in new_items {
                if item == {
                    .Func(f) -> register_func_item(f, st, &diags, !module.no_prelude)
                    .Struct(s) -> register_struct(s, &st.registry, &diags, st.funcs, st.consts, TargetLayout.from_build_facts(st.build_facts))
                    .Enum(e) -> register_enum(e, &st.registry, &diags, st.funcs, st.consts)
                    else -> {}
                }
                if item == .Test(test) -> &generated_test_spans.push(test.name_span)
            }
            &module.items.extend(^new_items)
        }
        {
            declared_targets := [(StructDef, Marker, MarkerDecl)]{}
            helper_funcs_owned := [String:Func]{}
            loop item in module.items {
                if item == .Struct(def) {
                    loop marker in def.type_markers {
                        declaration :: marker_vocabulary.declaration(marker.name) ?? next
                        if declaration.body == None -> next
                        &declared_targets.push((def, marker, declaration))
                    }
                }
                if item == .Func(function) -> helper_funcs_owned[function.name] = function
            }
            new_items := [Item]{}
            checked_nominals :: CheckerCore.checked_comptime_nominals_for_context(states, idx, name_ledger)
            st = &states[idx]
            loop (target, marker, declaration) in declared_targets {
                if marker.negated -> next
                body :: declaration.body ?? next
                state_members :: initial_fact_registry.state_members(target.name) ?? []
                type_path :: name_ledger.canonical_path(idx, target.name) ?? panic("declared rule target missing from the name ledger")
                layout_engine :: TargetLayoutEngine.new(module.items.iter(), TargetLayout.from_build_facts(bundle.build_facts))
                type_info :: Comptime.build_struct_type_info_with_path_and_vocabulary_and_engine(target, state_members, type_path, Val(marker_vocabulary), layout_engine)
                if Comptime.expand_derive_body(body, "target", type_info, helper_funcs_owned, bundle.project_root, checked_nominals) == {
                    .Ok(expanded) -> {
                        loop item in expanded {
                            if item != .Impl(implementation) { &new_items.push(item); next }
                            accepted := implementation
                            type_name :: accepted.type_name
                            &accepted.methods.retain(|method| {
                                existing :: existing_member_span(module.items, type_name, method.name) ?? existing_member_span(new_items, type_name, method.name)
                                if existing == .Val(span) {
                                    &diags.push(Diagnostic.error("E0105", "generated member `{method.name}` would change or shadow `{method.name}` on `{type_name}`", "a rule may add a member but cannot change or shadow a written member", "rename the generated member or remove the existing member", Val(method.name_span)).with_detail("generated member `{method.name}` from rule `{declaration.name}` at span {method.name_span.start}..{method.name_span.end}\nexisting member `{type_name}.{method.name}` at span {span.start}..{span.end}"))
                                    return false
                                }
                                true
                            })
                            if !accepted.methods.is_empty() -> &new_items.push(.Impl(^accepted))
                        }
                    }
                    .Err(inner) -> &diags.push(inner)
                }
            }
            declared_function_targets := [(Func, Marker, MarkerDecl)]{}
            loop item in module.items {
                if item == .Func(function) {
                    loop marker in function.markers {
                        declaration :: marker_vocabulary.declaration(marker.name) ?? next
                        if declaration.body == None -> next
                        &declared_function_targets.push((function, marker, declaration))
                    }
                }
            }
            loop (target, marker, declaration) in declared_function_targets {
                if marker.negated -> next
                body :: declaration.body ?? next
                target_info :: Comptime.build_function_type_info(target)
                if Comptime.expand_derive_body(body, "target", target_info, helper_funcs_owned, bundle.project_root, checked_nominals) == {
                    .Ok(expanded) -> &new_items.extend(expanded)
                    .Err(inner) -> &diags.push(inner)
                }
            }
            declared_text_blocks := [(String, String, Span)]{}
            loop item in module.items -> collect_item_declared_text_blocks(item, module.source, module.block_spans, &declared_text_blocks)
            loop (block_name, block_text, _block_span) in declared_text_blocks {
                declaration :: marker_vocabulary.declaration(block_name) ?? next
                body :: declaration.body ?? next
                if Comptime.expand_derive_body(body, "target", CtValue.Str(block_text), helper_funcs_owned, bundle.project_root, checked_nominals) == {
                    .Ok(expanded) -> &new_items.extend(expanded)
                    .Err(inner) -> &diags.push(inner)
                }
            }
            loop item in new_items {
                if item == {
                    .Func(function) -> register_func_item(function, st, &diags, !module.no_prelude)
                    .Struct(def) -> register_struct(def, &st.registry, &diags, st.funcs, st.consts, TargetLayout.from_build_facts(st.build_facts))
                    .Enum(def) -> register_enum(def, &st.registry, &diags, st.funcs, st.consts)
                    else -> {}
                }
                if item == .Test(test) -> &generated_test_spans.push(test.name_span)
            }
            &module.items.extend(^new_items)
        }
        CheckerMarkers.resolve_static_rule_products(module, base, ct_core_imports[idx], &diags)
        loop item in module.items {
            if item == .Test(test) {
                if generated_test_spans.contains(test.name_span) -> register_test_item(test, st, &diags)
            }
        }
        &st.consts.extend(comptime_types)
        union_item_start :: module.items.len()
        Registration.inject_anonymous_union_items(&module.items)
        loop item in module.items[union_item_start..] {
            if item == .Enum(definition) -> register_enum(definition, &st.registry, &diags, st.funcs, st.consts)
        }
        known_functions := [String:Bool]{}
        loop item in module.items { if item == .Func(function) -> known_functions[function.name] = true }
        Registration.expand_builtin_derive_items(&module.items, &diags)
        loop item in module.items {
            if item == .Func(function) { if !known_functions.contains_key(function.name) -> register_func_item(function, st, &diags, !module.no_prelude) }
        }
        Registration.expand_builtin_serde_items(&module.items, &diags)
        register_generated_union_enums(module.items, st, &diags)
        synthesize_impls(&module.items)
        st.trait_reg.register_synthetic_rollback()
        st.trait_reg.register_synthetic_display_debug()
        st.trait_reg.register_synthetic_close()
        st.trait_reg.register_synthetic_operators()
        st.trait_reg.register_synthetic_iter_index()
        st.trait_reg.register_synthetic_io()
        st.trait_reg.register_synthetic_driver()
        loop (local, definition, same_package) in imported_traits[idx] -> st.trait_reg.register_imported_trait(local, definition, same_package)
        st.trait_reg.register_items(module.items, &diags)
        Registration.normalize_operator_rhs(&module.items)
        register_type_methods(module.items, &st.registry, &diags)
        register_patchable_methods(module.items, &st.registry)
        register_cli_merge_methods(module.items, &st.registry)
        register_impl_methods(module.items, &st.registry, &diags)
        loop type_name in st.registry.unit_types.keys() -> st.trait_reg.trait_impls[(type_name, DISPLAY)] = true
        loop (type_name, fact) in st.registry.unit_facts {
            st.trait_reg.trait_impls[(type_name, quantity_bound(fact.family, fact.kind.name()))] = true
            derives := st.trait_reg.derives.get(type_name) ?? [:]
            derives[ENCODE] = true
            derives[DECODE] = true
            st.trait_reg.derives[type_name] = derives
        }
        &diags.extend(validate_serde_items(module.items, st.trait_reg))
        &diags.extend(check_marker_vocabulary(module.items, module.rule_facts, marker_vocabulary))
        &diags.extend(check_deprecated_visibility(module.items))
        &diags.extend(check_declared_rule_facts(module.rule_facts, marker_vocabulary))
        &diags.extend(validate_cli_items(module.items, st.trait_reg))
        &diags.extend(check_schema_migrations(module.items, bundle.project_root, st.trait_reg))
        attach_module_origin(module, idx == bundle.entry, &diags[module_diag_start..])
        drop_core_source_lints(module, &diags, module_diag_start)
    }
    loop idx in 0..<bundle.modules.len() {
        loop item in bundle.modules[idx].items {
            if item != .Impl(implementation) -> next
            if implementation.type_name.contains(".") || states[idx].registry.contains(implementation.type_name) -> next
            if sibling_type_owner(name_ledger, idx, implementation.type_name) == .Val(owner) -> register_impl_methods([item], &states[owner].registry, &diags)
        }
    }
    loop (idx, module) in bundle.modules -> check_guest_import_surface(module.items, states[idx].registry, &diags)
    if bundle.modules.get(bundle.entry) == .Val(module) {
        if states.get(bundle.entry) == .Val(state) -> check_guest_export_surface(module.items, state.registry, &diags)
    }
    check_guest_symbol_collisions(bundle, &diags)
    loop (module_idx, module) in bundle.modules {
        importer_set := [Int:Bool]{}
        loop link in bundle.cffi.import_links { if link.target_idx == module_idx -> importer_set[link.importing_idx] = true }
        importers := importer_set.keys().to_list()
        &importers.sort()
        if importers.is_empty() {
            validate_foreign_undo_contracts(module.items, states[module_idx].funcs, &diags)
            next
        }
        loop contract in foreign_undo_contracts(module.items) {
            owners :: importers.iter().filter(|owner| states[owner].funcs.contains_key(contract.inverse)).collect()
            if owners.len() == {
                1 -> validate_foreign_undo_contract(contract, states[owners[0]].funcs, &diags)
                0 -> validate_foreign_undo_contract(contract, states[module_idx].funcs, &diags)
                else -> {
                    modules :: owners.iter().map(|owner| bundle.modules[owner].display).collect().join(", ")
                    &diags.push(Diagnostic.error("E0105", "undo function `{contract.inverse}` is ambiguous for foreign binding `{contract.forward_name}`", "the shared C binding is imported by more than one module that defines `{contract.inverse}`: {modules}", "give the foreign binding one uniquely named inverse in one defining module", Val(contract.inverse_span)))
                }
            }
        }
    }
    bundle_auto_derives :: TraitRegistry.bundle_auto_derives(bundle, name_ledger)
    loop idx in 0..<states.len() {
        module_diag_start :: diags.len()
        auto_derives :: bundle_auto_derives[idx]
        states[idx].trait_reg.merge_auto_derives(auto_derives)
        module := &bundle.modules[idx]
        Registration.expand_builtin_derive_items_with_auto(&module.items, auto_derives, &diags)
        loop item in module.items {
            if item == .Func(function) { if !states[idx].funcs.contains_key(function.name) -> register_func_item(function, &states[idx], &diags, !module.no_prelude) }
        }
        serde_item_start :: module.items.len()
        Registration.expand_builtin_serde_items_with_auto(&module.items, auto_derives, &diags)
        register_generated_union_enums(module.items, &states[idx], &diags)
        Registration.normalize_operator_rhs(&module.items)
        register_impl_methods(module.items[serde_item_start..], &states[idx].registry, &diags)
        register_missing_type_methods(module.items, &states[idx].registry, &diags)
        attach_module_origin(module, idx == bundle.entry, &diags[module_diag_start..])
        drop_core_source_lints(module, &diags, module_diag_start)
    }
    &bundle.comptime_inputs.extend(^top_level_embed_inputs)
    &diags.extend(BudgetSpecs.validate_bundle(bundle))
    loop (idx, module) in bundle.modules {
        st :: states[idx]
        loop item in module.items {
            if item == .Impl(i) {
                if i.trait_name == .Val(trait_name) {
                    if i.delegation_field == .Val(field_name) {
                        if st.registry.struct_fields(i.type_name) == .Val(fields) {
                            field :: fields.iter().find(|(n, _, _)| n == field_name)
                            if field == .Val((_, _, field_ty)) {
                                field_type_name :: field_ty.name()
                                if !st.trait_reg.implements_trait(field_type_name, trait_name) {
                                    &diags.push(Diagnostic.error("E2401", "`{field_type_name}` doesn't implement `{trait_name}`, so it can't delegate", "`impl {i.type_name}.{trait_name} using {field_name}` forwards `{trait_name}` methods to the `{field_name}` field, but `{field_type_name}` doesn't implement `{trait_name}`", "implement `impl {field_type_name}: {trait_name}` on the field's type, or choose a different field", Val(i.type_span)))
                                }
                            } else -> &diags.push(Diagnostic.error("E2401", "`{i.type_name}` has no field `{field_name}`", "`impl {i.type_name}.{trait_name} using {field_name}` needs `{i.type_name}` to have a field named `{field_name}`", "add `{field_name}: Type` to `struct {i.type_name}`", Val(i.type_span)))
                        }
                    }
                }
            }
        }
    }
    populate_name_ledger(bundle, states, &name_ledger)
    loop (idx, module) in bundle.modules {
        st := &states[idx]
        loop imp in module.imports {
            if imp.kind == .Unqualified(_, _, _) {
                foreign :: foreign_imports_after_validation(imp)
                if foreign.is_empty() -> next
                group_failed := false
                resolved := [(String, Int)]{}
                names := [String:Bool]{}
                loop (namespace, alias) in foreign {
                    if st.imports.contains_key(alias) || st.core_imports.contains_key(alias) || names.contains_key(alias) {
                        group_failed = true
                        &diags.push(Diagnostic.error("E0105", "the import name `{alias}` is used twice", "each import needs a unique namespace name in this file", "rename one with `{KW_AS} alias`", Val(imp.alias_span)))
                        next
                    }
                    names[alias] = true
                    target :: if namespace.language == ForeignLanguage.C -> bundle.cffi.target_for(idx, alias) else -> bundle.modules.iter().position(|candidate| candidate.display == namespace.display())
                    if target == .Val(found) -> &resolved.push((alias, found))
                    else {
                        group_failed = true
                        root :: namespace.language.root()
                        &diags.push(Diagnostic.error("E1002", "`{root}` is reserved for first-party or foreign packages", "a foreign namespace must resolve to a mounted library before it can be imported", "make the `{root}` binding available or rename the import", Val(imp.alias_span)))
                    }
                }
                if !group_failed { loop (alias, target) in resolved -> st.imports[alias] = target }
                next
            }
            alias :: imp.import_alias()
            if st.imports.contains_key(alias) || st.core_imports.contains_key(alias) {
                &diags.push(Diagnostic.error("E0105", "the import name `{alias}` is used twice", "each import needs a unique namespace name in this file", "rename one with `{KW_AS} alias`", Val(imp.alias_span)))
                next
            }
            if imp.kind == .Module(name, _) {
                if is_legacy_std_import(name) {
                    &diags.push(Diagnostic.error("E0019", "`{name}` is the old standard-library import spelling", "the standard library module was renamed to `core`", "use `import {CORE_SHORT}` or `import {CORE_SHORT}.fs as fs`", Val(imp.span)))
                    next
                }
                if name.strip_prefix("jet.") == .Val(ring) {
                    if is_ring_module(ring) {
                        canonical :: canonical_ring_module(ring)
                        &diags.push(Diagnostic.error("E0341", "`use jet.{ring}` is the old first-party library spelling", "first-party libraries moved to the `core.*` namespace (D-CORENS1)", "write `use {canonical}` instead", Val(imp.span)))
                        next
                    }
                }
            }
            if target_profile_path(imp) == .Val(profile) { st.core_imports[alias] = profile; next }
            if imp.core_module_path() == .Val(core_module) {
                if !is_known_core_module(core_module) { &diags.push(CheckerCoreLib.unknown_core_module(core_module, imp.span)); next }
                if core_module_layer(core_module) == .Val(mod_layer) {
                    if bundle.layer_ceiling == .Val(ceiling) {
                        if mod_layer > ceiling {
                            &diags.push(layer_ceiling_exceeded(core_module, mod_layer, ceiling, Val(imp.span), Val("`use {core_module}`")))
                            next
                        }
                    }
                    if mod_layer > bundle.inferred_layer -> bundle.inferred_layer = mod_layer
                }
                st.core_imports[alias] = core_module
                next
            }
            if imp.kind == .File(path, _) {
                if path.ends_with(".h") {
                    target :: bundle.cffi.target_for(idx, alias) ?? panic("C header import target missing after CFFI assembly: module={idx} alias={alias}")
                    st.imports[alias] = target
                    name_ledger.record_import_target(idx, imp.span, target)
                    next
                }
            }
            foreign :: foreign_imports_after_validation(imp)
            if !foreign.is_empty() {
                group_failed := false
                resolved := [(String, Int)]{}
                loop (namespace, foreign_alias) in foreign {
                    target :: if namespace.language == ForeignLanguage.C -> bundle.cffi.target_for(idx, foreign_alias) else -> bundle.modules.iter().position(|candidate| candidate.display == namespace.display())
                    if target == .Val(found) -> &resolved.push((foreign_alias, found))
                    else {
                        group_failed = true
                        root :: namespace.language.root()
                        &diags.push(Diagnostic.error("E1002", "`{root}` is reserved for first-party or foreign packages", "a foreign namespace must resolve to a mounted library before it can be imported", "make the `{root}` binding available or rename the import", Val(imp.alias_span)))
                    }
                }
                if !group_failed {
                    loop (foreign_alias, target) in resolved -> st.imports[foreign_alias] = target
                    if st.imports.get(alias) == .Val(target) -> name_ledger.record_import_target(idx, imp.span, target)
                }
                next
            }
            if is_c_import_after_validation(imp) {
                if bundle.cffi.target_for(idx, alias) == .Val(target) { st.imports[alias] = target; name_ledger.record_import_target(idx, imp.span, target) }
                next
            }
            if name_ledger.import_target(idx, imp.span) == .Val(target) -> st.imports[alias] = target
        }
    }
    loop link in bundle.cffi.import_links {
        target_state :: states.get(link.target_idx) ?? next
        close_impls :: target_state.trait_reg.trait_impls.keys().filter(|(_, trait_name)| trait_name == TRAIT_CLOSE).collect()
        loop close_impl in close_impls -> states[link.importing_idx].trait_reg.trait_impls[close_impl] = true
    }
    loop (idx, module) in bundle.modules {
        module_diag_start :: diags.len()
        loop imp in module.imports {
            if imp.kind != .Unqualified(module_alias, module_alias_span, _) -> next
            if !foreign_imports_after_validation(imp).is_empty() -> next
            bindings :: imp.walk_bindings()
            group_diagnostics :: diags.len()
            inserted_unqualified := [String]{}
            inserted_reexports := [String]{}
            inserted_core := [String]{}
            inserted_core_items := [String]{}
            inserted_file := [String]{}
            inserted_imports := [String]{}
            pending_item_aliases := [(String, String, Int, Span)]{}
            if states[idx].code_modules.get(module_alias) == .Val(canonical) {
                st := &states[idx]
                loop binding in bindings {
                    orig :: binding.original ?? panic("member walker returned a binding without a member")
                    local :: binding.local
                    mangled :: member_name(canonical, orig)
                    if st.unqualified.contains_key(local) || st.unqualified_file.contains_key(local) || st.core_imports.contains_key(local) {
                        &diags.push(Diagnostic.error("E0105", "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with `{KW_AS} alias`", Val(imp.alias_span)))
                    } else if !st.funcs.contains_key(mangled) {
                        &diags.push(Diagnostic.error("E0611", "`{orig}` is not defined in module `{module_alias}`", "check the module body for the item you're importing", "make sure the name is spelled correctly", Val(module_alias_span)))
                    } else if !name_ledger.exported(idx, mangled) {
                        &diags.push(Diagnostic.error("E0609", "`{orig}` is private in module `{module_alias}`", "only `pub` items can be brought into scope with `use`", "add `pub` before `fn {orig}` in module `{module_alias}`", Val(module_alias_span)))
                    } else {
                        st.unqualified[local] = mangled
                        &inserted_unqualified.push(local)
                        if imp.is_pub { st.reexports[local] = (mangled, idx); &inserted_reexports.push(local) }
                    }
                }
            } else if core_list_prefix(module_alias) == .Val(core_prefix) {
                st := &states[idx]
                loop binding in bindings {
                    orig :: binding.original ?? panic("member walker returned a binding without a member")
                    local :: binding.local
                    full :: "{core_prefix}.{orig}"
                    target :: if core_list_path(module_alias, orig) == {
                        .Val(.Module(core_module)) -> Val((core_module, None))
                        .Val(.Item(core_module, item)) -> {
                            if CheckerCoreLib.core_module_items(core_module).contains(item) -> Val((core_module, Val(item))) else -> None
                        }
                        else -> None
                    }
                    if target != .Val((core_module, item)) {
                        if is_known_core_module(core_prefix) -> &diags.push(CheckerCoreLib.unknown_core_item(core_prefix, orig, binding.item_span ?? module_alias_span))
                        else -> &diags.push(CheckerCoreLib.unknown_core_module(full, module_alias_span))
                        next
                    }
                    if st.core_imports.contains_key(local) || st.unqualified.contains_key(local) || st.unqualified_file.contains_key(local) {
                        &diags.push(Diagnostic.error("E0105", "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with `{KW_AS} alias`", Val(imp.alias_span)))
                    } else {
                        if core_module_layer(core_module) == .Val(mod_layer) {
                            if bundle.layer_ceiling == .Val(ceiling) {
                                if mod_layer > ceiling {
                                    &diags.push(layer_ceiling_exceeded(core_module, mod_layer, ceiling, Val(module_alias_span), Val("`use {core_prefix}.{orig}`")))
                                    next
                                }
                            }
                            if mod_layer > bundle.inferred_layer -> bundle.inferred_layer = mod_layer
                        }
                        st.core_imports[local] = core_module
                        &inserted_core.push(local)
                        if item == .Val(member) { st.core_item_imports[local] = member; &inserted_core_items.push(local) }
                    }
                }
            } else if states[idx].imports.get(module_alias) == .Val(imported_idx) {
                is_reexport :: imp.is_pub
                loop binding in bindings {
                    orig :: binding.original ?? panic("member walker returned a binding without a member")
                    local :: binding.local
                    declares :: |candidate| states[candidate].funcs.contains_key(orig) || name_ledger.declaration(candidate, orig) != None
                    target_idx :: if declares(imported_idx) -> imported_idx else -> name_ledger.namespace_siblings(imported_idx).iter().find(|candidate| declares(candidate)) ?? imported_idx
                    is_pub :: name_ledger.visible(idx, target_idx, orig)
                    file_module_target :: states[target_idx].imports.get(orig).filter(|_| name_ledger.declaration(target_idx, orig).is_some_and(|declaration| declaration.kind == "file_module"))
                    if states[idx].unqualified.contains_key(local) || states[idx].unqualified_file.contains_key(local) || states[idx].core_imports.contains_key(local) {
                        &diags.push(Diagnostic.error("E0105", "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with `{KW_AS} alias`", Val(imp.alias_span)))
                    } else if file_module_target == .Val(target) {
                        if !is_pub -> &diags.push(Diagnostic.error("E0609", "`{orig}` is private in module `{module_alias}`", "only public modules can be brought into scope with `use`", "add `pub` before `module {orig}` in the imported file", Val(module_alias_span)))
                        else { states[idx].imports[local] = target; &inserted_imports.push(local) }
                        next
                    }
                    is_function :: states[target_idx].funcs.contains_key(orig)
                    declaration_kind :: name_ledger.declaration(target_idx, orig).map(|declaration| declaration.kind)
                    is_other_item :: !is_function && (declaration_kind == Val("type") || declaration_kind == Val("trait") || declaration_kind == Val("const") || declaration_kind == Val("tag") || declaration_kind == Val("protocol"))
                    if !is_function && !is_other_item {
                        &diags.push(Diagnostic.error("E0611", "`{orig}` is not defined in module `{module_alias}`", "check the module for the item you're importing", "make sure the name is spelled correctly", Val(module_alias_span)))
                    } else if !is_pub {
                        fix :: if is_function -> "add `pub` before `fn {orig}` in the imported file" else -> "add `pub` before the declaration of `{orig}` in the imported file"
                        &diags.push(Diagnostic.error("E0609", "`{orig}` is private in module `{module_alias}`", "only `pub` items can be brought into scope with `use`", fix, Val(module_alias_span)))
                    } else if is_other_item {
                        &pending_item_aliases.push((local, "{bundle.modules[target_idx].alias}.{orig}", target_idx, binding.local_span))
                    } else {
                        states[idx].unqualified_file[local] = (orig, target_idx)
                        &inserted_file.push(local)
                        if is_reexport { states[idx].reexports[local] = (orig, target_idx); &inserted_reexports.push(local) }
                    }
                }
            } else {
                &diags.push(Diagnostic.error("E0610", "no module named `{module_alias}` in scope", "the alias must refer to a module imported earlier in this file", "add `import … as {module_alias}`  before this `use`", Val(module_alias_span)))
            }
            if diags.len() == group_diagnostics {
                visibility :: NameVisibility.from_flags(imp.is_pub, imp.is_package_pub)
                loop (local, target, target_idx, span) in pending_item_aliases -> name_ledger.record_alias(idx, local, target, Val(target_idx), span, visibility)
            } else {
                st := &states[idx]
                loop name in inserted_unqualified -> _ :: &st.unqualified.remove(name)
                loop name in inserted_reexports -> _ :: &st.reexports.remove(name)
                loop name in inserted_core -> _ :: &st.core_imports.remove(name)
                loop name in inserted_core_items -> _ :: &st.core_item_imports.remove(name)
                loop name in inserted_file -> _ :: &st.unqualified_file.remove(name)
                loop name in inserted_imports -> _ :: &st.imports.remove(name)
            }
        }
        attach_module_origin(module, idx == bundle.entry, &diags[module_diag_start..])
    }
    loop (idx, module) in bundle.modules {
        module_diag_start :: diags.len()
        &diags.extend(ScopeMembers.check(module.items, marker_vocabulary))
        attach_module_origin(module, idx == bundle.entry, &diags[module_diag_start..])
    }
    resolve_inline_module_imports(bundle, &states, &name_ledger, &diags)
    all_items :: || bundle.modules.iter().flat_map(|module| module.items.iter())
    all_state_graphs :: checked_state_graphs(all_items())
    final_fact_registry := StateTable.declaration_facts(all_items())
    loop (type_name, graph) in all_state_graphs -> final_fact_registry.set_state_graph("{type_name}.State", graph)
    loop (idx, state) in &states {
        state.items = ~bundle.modules[idx].items
        state.fact_registry = final_fact_registry
    }
    diverging_functions :: Validation.collect_diverging_functions(states)
    Validation.project_divergence_facts(bundle, diverging_functions)
    fixed_length_write_params :: Validation.collect_fixed_length_write_params(states)
    loop state in &states {
        state.diverging_functions = diverging_functions
        state.fixed_length_write_params = fixed_length_write_params
    }
    devtools_items := [String:[(String, [Item])]]{}
    loop (idx, module) in bundle.modules {
        state :: states[idx]
        modules := devtools_items.get(state.package_scope) ?? []
        &modules.push((state.module_path, module.items))
        devtools_items[state.package_scope] = modules
    }
    packages := devtools_items.keys().to_list()
    &packages.sort()
    loop package in packages {
        modules :: devtools_items[package]
        package_items :: modules.iter().flat_map(|(_, items)| items.iter()).collect()
        loop (module, items) in modules -> check_devtools_panels(package, module, package_items, items, &devtools_registry, &diags)
    }
    complete_bundle_check(bundle, &states, plugin_interfaces, &devtools_registry, mode, no_os, gates, explicit_output, incremental, allow_compiler_api, ^name_ledger, ^diags)
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/CheckInner.rs:2371
fn drop_core_source_lints(module: LoadedModule, diags: &[Diagnostic], module_diag_start: Int) Never! {
    if module.is_core_source() {
        // Retain the prefix untouched; compact only this module's suffix.
        write := module_diag_start
        loop read in module_diag_start..<diags.len() {
            if diags[read].severity != Severity.Lint {
                if write != read -> diags[write] = ^diags[read]
                write += 1
            }
        }
        &diags.truncate(write)
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/CheckInner.rs:2389
fn attach_module_origin(module: LoadedModule, is_entry: Bool, diags: &[Diagnostic]) Never! {
    unowned :: |diagnostic| diagnostic.origin() == None && diagnostic.span != None
    if is_entry || !diags.iter().any(|diagnostic| unowned(diagnostic)) -> return
    // #4494: shared origin carrier is the canonical diagnostic Arc allocation.
    origin :: Arc.new(DiagnosticOrigin.new(module.display, module.path.to_string_lossy(), module.source))
    loop diagnostic in &diags { if unowned(diagnostic) -> diagnostic.set_origin(origin.clone()) }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline/CheckInner.rs:2414
fn comptime_module_order(bundle: ProgramBundle, name_ledger: NameLedger) -> [Int] Never! {
    module_count :: bundle.modules.len()
    declared := [[String:Bool]]{}
    loop module in bundle.modules {
        names := [String:Bool]{}
        loop item in module.items {
            if item == .Const(constant) { if Registration.const_evaluated_at_build(constant) -> names[constant.name] = true }
        }
        &declared.push(names)
    }
    reads := [[Int]].repeat([], module_count)
    loop (idx, module) in bundle.modules {
        if declared[idx].is_empty() -> next
        siblings :: name_ledger.namespace_siblings(idx)
        if siblings.is_empty() -> next
        names := [String:Bool]{}
        loop item in module.items {
            if item == .Const(constant) {
                if Registration.const_evaluated_at_build(constant) {
                    constant.value.for_each_expr(|expr| { if expr == .Ident(name, _) -> names[name] = true })
                }
            }
        }
        loop name in names.keys() {
            if declared[idx].contains_key(name) -> next
            if siblings.iter().find(|sibling| declared[sibling].contains_key(name)) == .Val(owner) {
                if !reads[idx].contains(owner) -> &reads[idx].push(owner)
            }
        }
    }
    order := [Int]{}
    visited := [Bool].repeat(false, module_count)
    loop root in 0..<module_count {
        if visited[root] -> next
        visited[root] = true
        stack := [(Int, Int)]{(root, 0)}
        loop !stack.is_empty() {
            (module, next_read) :: &stack.pop() ?? panic("nonempty comptime traversal stack")
            if reads[module].get(next_read) == .Val(read) {
                &stack.push((module, next_read + 1))
                if !visited[read] { visited[read] = true; &stack.push((read, 0)) }
            } else -> &order.push(module)
        }
    }
    order
}
