// Bundle-facing unit resolution. Canonical dimension algebra and source indexes are reused.
use jet_foundation.[Diagnostic, Span, Item, Expr, BinOp, ProgramBundle, UnitFamilyDef, UnitDimensionDecl, Dimension, unit_family_distinct_defs, unit_family_type_name, dimension_base, dimension_multiply, dimension_divide, foundation_embedded_core]
use jet_lexer.lex_generated
use jet_parser.parse
use jet_sema.GenericModules
use Sema.Units.Mentions.[SemaUnitSourceMentions, sema_units_source_mentions, sema_units_identifier, sema_units_member, sema_units_identifier_span, sema_units_member_span]
use Sema.Units.Dimensions.[SemaUnitDimensionLookup, sema_units_resolve_standard, sema_units_dimension_dependencies, sema_units_dimension_aliases]

// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:13
pub fn inject_units_prelude(bundle: &ProgramBundle) -> [Diagnostic] {
    // The canonical source owner publishes exactly the ordinary Prelude/Units.jet catalog.
    (tokens, diagnostics) := lex_generated(foundation_embedded_core().unit_source())
    program :: parse(tokens) == {
        .Ok(program) -> program
        .Err(parse_diagnostics) -> {
            &diagnostics.extend(^parse_diagnostics)
            return ^diagnostics
        }
    }
    prelude := [UnitFamilyDef]{}
    for item in program.items { if item == .UnitFamily(family) { &prelude.push(^family) } }
    resolve_standard_unit_dimensions(&prelude)
    for module in &bundle.modules {
        if module.no_prelude { continue }
        occupied := [String:Bool]{}
        local := [String:Bool]{}
        for item in module.items {
            item == {
                .UnitFamily(family) -> {
                    local[family.family] = true
                    for definition in unit_family_distinct_defs(family) { occupied[definition.name] = true }
                }
                .Distinct(definition) -> occupied[definition.name] = true
                .Struct(definition) -> occupied[definition.name] = true
                .Enum(definition) -> occupied[definition.name] = true
                .TypeAlias(definition) -> occupied[definition.name] = true
                else -> {}
            }
        }
        mentions :: sema_units_source_mentions(module.source)
        selected := [String:Bool]{}
        rows := [String:Int]{}
        queue := [Int]{}
        for (index, family) in prelude {
            rows[family.family] = index
            if sema_units_identifier(mentions, family.family) || family.members.iter().any(fn(member) { sema_units_member(mentions, member.name) }) {
                selected[family.family] = true
                &queue.push(index)
            }
        }
        at := 0
        loop at < queue.len() {
            family :: prelude[queue[at]]
            at += 1
            if family.dimension == .Val(.Derived(expression)) {
                for dependency in dimension_dependencies(expression) {
                    if selected.get(dependency) != None { continue }
                    selected[dependency] = true
                    if rows.get(dependency) == .Val(index) { &queue.push(index) }
                }
            }
        }
        for standard in prelude {
            if local.get(standard.family) != None || selected.get(standard.family) == None { continue }
            family := ~standard
            &family.members.retain(fn(member) {
                is_base :: family.base.is_some_and(fn(base) { base.name == member.name })
                (is_base || sema_units_member(mentions, member.name)) && occupied.get(unit_family_type_name(member.name)) == None
            })
            family_anchor :: family.members.iter().find_map(fn(member) { sema_units_member_span(mentions, member.name) })
                ?? sema_units_identifier_span(mentions, family.family) ?? Span(start: 0, end: 0)
            for member in &family.members { member.name_span = sema_units_member_span(mentions, member.name) ?? family_anchor }
            &module.items.push(Item.UnitFamily(^family))
        }
    }
    ^diagnostics
}
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:122
fn dimension_dependencies(expression: Expr) -> [String] {
    names := [String]{}
    sema_units_dimension_dependencies(expression, &names)
    ^names
}
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:137
// SourceMentions/new (148), is_ident (149), run_at (153), identifier (193),
// unit_member (199) -> Units/Mentions.jet:11-85. One UTF-8 byte index and sorted suffix lookup.
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:213
fn source_unit_member_span(source: String, member: String) -> Span? {
    sema_units_member_span(sema_units_source_mentions(source), member)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:234
fn source_identifier_span(source: String, name: String) -> Span? {
    sema_units_identifier_span(sema_units_source_mentions(source), name)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:246
fn resolve_standard_unit_dimensions(prelude: &[UnitFamilyDef]) -> Unit {
    sema_units_resolve_standard(&prelude)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:295
fn stable_unit_owner(bundle: ProgramBundle, module_index: Int) -> (String, String) {
    module :: bundle.modules[module_index]
    (package_root, dependency_name) :: GenericModules.owning_package(bundle, module.path)
    package :: GenericModules.package_identity(bundle, package_root, dependency_name)
    // GATE #4500: native path prefix and lossy display conversion.
    module_path :: module.path.strip_prefix(package_root).unwrap_or(module.path).to_string_lossy().replace("\\", "/")
    (~package, "{package}::{module_path}")
}
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:311
pub fn resolve_unit_dimensions(bundle: &ProgramBundle) -> [Diagnostic] {
    // Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:313
    struct Declaration { module: Int, item: Int, family: String, span: Span, is_pub: Bool, claim: UnitDimensionDecl, preset: Dimension? }
    declarations := [Declaration]{}
    // Index the same first declaration Rust's find() selects; retain duplicate declarations for updates/diagnostics.
    locals := [[String:Int]]{}
    exports := [[String:Int]]{}
    for (module_index, module) in bundle.modules {
        local := [String:Int]{}
        public := [String:Int]{}
        for (item_index, item) in module.items {
            if item == .UnitFamily(family) {
                if family.dimension == .Val(claim) {
                    row :: declarations.len()
                    if local.get(family.family) == None { local[family.family] = row }
                    if family.is_pub && public.get(family.family) == None { public[family.family] = row }
                    &declarations.push(Declaration(module: module_index, item: item_index, family: ~family.family, span: family.family_span, is_pub: family.is_pub, claim: ~claim, preset: ~family.resolved_dimension))
                }
            }
        }
        &locals.push(^local)
        &exports.push(^public)
    }
    imported_modules := [[Int]]{}
    import_aliases := [[String:Int]]{}
    for (module_index, module) in bundle.modules {
        targets := [Int]{}
        aliases := [String:Int]{}
        for import in module.imports {
            if bundle.name_ledger.import_target(module_index, import.span) == .Val(target) {
                &targets.push(target)
                aliases[import.import_alias()] = target
            }
        }
        &imported_modules.push(^targets)
        &import_aliases.push(^aliases)
    }
    for declaration in declarations {
        if declaration.claim == .Derived(expression) {
            aliases := [String:Bool]{}
            dimension_aliases(expression, &aliases)
            for (alias, _) in aliases {
                span :: bundle.name_ledger.alias(declaration.module, alias).map(fn(binding) { binding.span })
                if span == .Val(value) { &bundle.name_ledger.record_alias_use(declaration.module, value) }
            }
            unqualified_names := [String:Bool]{}
            dimension_unqualified_names(expression, &unqualified_names)
            for (name, _) in unqualified_names {
                if locals[declaration.module].get(name) != None { continue }
                imported_targets := [Int:Bool]{}
                for target in imported_modules[declaration.module] {
                    if exports[target].get(name) != None { imported_targets[target] = true }
                }
                for (alias, target) in import_aliases[declaration.module] {
                    if imported_targets.get(target) == None { continue }
                    if bundle.name_ledger.alias(declaration.module, alias).map(fn(binding) { binding.span }) == .Val(span) {
                        &bundle.name_ledger.record_alias_use(declaration.module, span)
                    }
                }
            }
        }
    }
    // GATE #4499: tuple-key maps preserve exact (module, family) identity.
    known := [(Int, String):Dimension]{}
    for declaration in declarations {
        if declaration.preset == .Val(dimension) {
            known[(declaration.module, declaration.family)] = ~dimension
        } else if declaration.claim == .Base(_) {
            (_, module_identity) :: stable_unit_owner(bundle, declaration.module)
            known[(declaration.module, declaration.family)] = dimension_base("{module_identity}::{declaration.family}")
        }
    }
    pending := declarations.iter().filter(fn(declaration) { declaration.preset == None && declaration.claim == { .Derived(_) -> true, else -> false } }).cloned().collect()
    loop {
        progress := false
        &pending.retain(fn(declaration) {
            expression :: declaration.claim == { .Derived(expression) -> expression, else -> { panic("derived pending declaration") } }
            visible :: fn(qualifier: String?, name: String) {
                if qualifier == .Val(alias) {
                    target :: import_aliases[declaration.module].get(alias) ?? { return SemaUnitDimensionLookup.Missing }
                    row :: exports[target].get(name) ?? { return SemaUnitDimensionLookup.Missing }
                    candidate :: declarations[row]
                    return known.get((candidate.module, candidate.family)).map(fn(value) { SemaUnitDimensionLookup.Found(value) }) ?? SemaUnitDimensionLookup.Missing
                }
                if locals[declaration.module].get(name) != None {
                    return known.get((declaration.module, name)).map(fn(value) { SemaUnitDimensionLookup.Found(value) }) ?? SemaUnitDimensionLookup.Missing
                }
                candidates := [Int:Bool]{}
                for target in imported_modules[declaration.module] { if exports[target].get(name) != None { candidates[target] = true } }
                if candidates.len() > 1 { return SemaUnitDimensionLookup.Ambiguous(name) }
                target :: candidates.keys().next() ?? { return SemaUnitDimensionLookup.Missing }
                known.get((target, name)).map(fn(value) { SemaUnitDimensionLookup.Found(value) }) ?? SemaUnitDimensionLookup.Missing
            }
            dimension :: resolve_dimension_expression(expression, visible) == {
                .Found(dimension) -> dimension
                else -> { return true }
            }
            known[(declaration.module, declaration.family)] = dimension
            progress = true
            false
        })
        if !progress { break }
    }
    diagnostics := [Diagnostic]{}
    for declaration in declarations {
        resolved :: known.get((declaration.module, declaration.family))
        if resolved == None {
            ambiguity := None as String?
            if declaration.claim == .Derived(expression) {
                visible :: fn(qualifier: String?, name: String) {
                    if qualifier != None || locals[declaration.module].get(name) != None { return SemaUnitDimensionLookup.Missing }
                    matches := [Int:Bool]{}
                    for target in imported_modules[declaration.module] { if exports[target].get(name) != None { matches[target] = true } }
                    if matches.len() > 1 { SemaUnitDimensionLookup.Ambiguous(name) } else { SemaUnitDimensionLookup.Missing }
                }
                if resolve_dimension_expression(expression, visible) == .Ambiguous(name) { ambiguity = Val(name) }
            }
            diagnostic :: if ambiguity == .Val(name) {
                Diagnostic.error("E0905", "dimension name `{name}` is ambiguous", "more than one imported module exports that dimension", "qualify it with the intended module alias, such as `dep.{name}`", Val(declaration.span))
            } else {
                Diagnostic.error("E0905", "dimension `{declaration.family}` cannot be resolved", "derived dimensions can use visible declared dimensions and cannot form a cycle", "import or declare every base dimension and remove any dimension cycle", Val(declaration.span))
            }
            &diagnostics.push(diagnostic)
        }
        (owner, _) :: stable_unit_owner(bundle, declaration.module)
        if bundle.modules[declaration.module].items[declaration.item] == .UnitFamily(definition) {
            updated := ^definition
            updated.resolved_dimension = resolved
            if updated.resolved_owner == None { updated.resolved_owner = Val(owner) }
            bundle.modules[declaration.module].items[declaration.item] = Item.UnitFamily(^updated)
        }
    }
    // D-DIMENSION-OPEN1=D: owner facts exist even without a dimension claim.
    owners := [String]{}
    for module in 0..<bundle.modules.len() { &owners.push(stable_unit_owner(bundle, module).0) }
    for (module, owner) in owners {
        for item in &bundle.modules[module].items {
            if item == .UnitFamily(definition) {
                if definition.resolved_owner == None { definition.resolved_owner = Val(~owner) }
            }
        }
    }
    ^diagnostics
}
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:601
fn dimension_aliases(expression: Expr, aliases: &[String:Bool]) -> Unit {
    sema_units_dimension_aliases(expression, &aliases)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:617
fn dimension_unqualified_names(expression: Expr, names: &[String:Bool]) -> Unit {
    expression == {
        .Ident(name, _) -> names[name] = true
        .Binary(_, left, right, _) -> { dimension_unqualified_names(left, &names); dimension_unqualified_names(right, &names) }
        .Field(_, _, _) -> {}
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:631
// DimensionLookup -> canonical SemaUnitDimensionLookup (Units/Dimensions.jet:4).
// Rust: crates/jet-sema/src/Sema/Bundle/Units.rs:637
fn resolve_dimension_expression(expression: Expr, visible: fn(String?, String) -> SemaUnitDimensionLookup) -> SemaUnitDimensionLookup {
    expression == {
        .Ident(name, _) -> visible(None, name)
        .Field(base, name, _) -> base == { .Ident(alias, _) -> visible(Val(alias), name), else -> SemaUnitDimensionLookup.Missing }
        .Binary(op, left, right, _) -> {
            if op != BinOp.Mul && op != BinOp.Div { return SemaUnitDimensionLookup.Missing }
            left_value :: resolve_dimension_expression(left, visible)
            right_value :: resolve_dimension_expression(right, visible)
            if left_value == .Ambiguous(name) { return SemaUnitDimensionLookup.Ambiguous(name) }
            if right_value == .Ambiguous(name) { return SemaUnitDimensionLookup.Ambiguous(name) }
            if left_value == .Found(left_dimension) {
                if right_value == .Found(right_dimension) {
                    dimension :: if op == BinOp.Mul { dimension_multiply(left_dimension, right_dimension) } else { dimension_divide(left_dimension, right_dimension) }
                    return dimension.map(fn(value) { SemaUnitDimensionLookup.Found(value) }) ?? SemaUnitDimensionLookup.Missing
                }
            }
            SemaUnitDimensionLookup.Missing
        }
        else -> SemaUnitDimensionLookup.Missing
    }
}
