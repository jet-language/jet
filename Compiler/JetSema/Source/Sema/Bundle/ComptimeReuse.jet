// #2517: successful compile-time values reused under complete evaluation-input keys.
// Keys cover compiler/check environment (clock only when read), other loaded
// modules, local non-function items, transitively reached functions, prior
// constant values, and the checked initializer. Values must roundtrip exactly.
use jet_comptime.[CtValue]
use jet_foundation.[Expr, Func, Item, ProgramBundle, KeyHasher, RecordReader, RecordSection, RecordValue, encode_record, record_map, sha256_hex, package_edition, canonical_fragment]
use jet_sema.Sema.Bundle.BodyDelta.[decode_value, encode_value]
use jet_sema.Sema.Bundle.PackageSeal.[PackageRecordStore, session_store]
use jet_sema.Sema.Bundle.ItemReuse.[same_debug]
use jet_sema.Sema.Bundle.[incremental_global_environment]
// GATE #4494: shared ownership, interior borrowing, and once-cell primitives.
use std.cell.[RefCell, OnceCell]
use std.sync.[Arc]

// Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:39
COMPTIME_VALUE_SCHEMA :: "jet.comptime-value/v1"
// Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:40
SECTION_VALUE :: U64{1}

// Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:44
pub struct ComptimeReuseEnv {
    store: Arc<PackageRecordStore>,
    environment: String,
    modules: [String],
    pending: RefCell<Pending>,

    // Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:114
    fn drop(self: &ComptimeReuseEnv) {
        pending :: self.pending.get_mut().take()
        if pending.touched.len() != 0 || pending.records.len() != 0 {
            self.store.publish_batch(COMPTIME_VALUE_SCHEMA, pending.touched, ^pending.records)
        }
    }

    // Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:125
    pub fn load(self: ComptimeReuseEnv, key: String) -> CtValue? {
        bytes :: self.store.load_untouched(COMPTIME_VALUE_SCHEMA, key) ?? return None
        reader :: RecordReader.open_schema(bytes, COMPTIME_VALUE_SCHEMA) !? return None
        entry :: reader.element(SECTION_VALUE, 0) !? return None
        field :: entry.field("value") !? return None
        if field != .Bytes(encoded) -> return None
        checked :: entry.field("checked") !? return None
        digest :: checked.as_str() !? return None
        if sha256_hex(encoded) != digest -> return None
        value :: decode_value(encoded) ?? return None
        &self.pending.borrow_mut().touched.push(~key)
        Val(value)
    }

    // Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:142
    pub fn record(self: ComptimeReuseEnv, key: ^String, value: CtValue) {
        encoded :: encode_value(value) !? return
        decoded :: decode_value(encoded) ?? return
        if !same_debug(decoded, value) -> return
        checked :: sha256_hex(encoded)
        entry :: record_map([("value", RecordValue.Bytes{value: ^encoded}), ("checked", RecordValue.Str{value: ^checked})])
        bytes :: encode_record(COMPTIME_VALUE_SCHEMA, [RecordSection.new(SECTION_VALUE, [entry])]) !? return
        &self.pending.borrow_mut().records.push((^key, ^bytes))
    }

    // Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:163
    pub fn value_digest(self: ComptimeReuseEnv, value: CtValue) -> String? {
        encoded :: encode_value(value) !? return None
        Val(sha256_hex(encoded))
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:53
struct Pending {
    touched: [String]{[]},
    records: [(String, [U8])]{[]},
}

// Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:61
pub fn environment(bundle: ProgramBundle) -> ComptimeReuseEnv? {
    store :: session_store() ?? return None
    hasher := KeyHasher.new(COMPTIME_VALUE_SCHEMA)
    &hasher.field(store.compiler_identity())
    &hasher.field(sha256_hex(incremental_global_environment(bundle, "")))
    &hasher.field(package_edition())
    if bundle.modules.any(module -> reads_build_stamp(module.source)) -> &hasher.field(bundle.build_facts.stamp.at)
    modules := [String]{}
    loop module in bundle.modules {
        digest := KeyHasher.new(COMPTIME_VALUE_SCHEMA)
        &digest.field(module.display)
        &digest.field(module.path.to_string_lossy())
        &digest.field(module.alias)
        &digest.field(sha256_hex(module.source.bytes()))
        &modules.push(digest.finish())
    }
    Val(ComptimeReuseEnv{store: ^store, environment: hasher.finish(), modules: ^modules, pending: RefCell.new(Pending{})})
}

// Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:102
fn reads_build_stamp(source: String) -> Bool Never! {
    loop (at, found) in source.match_indices("$build") {
        tail := source.slice(at + found.len(), source.len()).trim_start() // #4303
        if tail.strip_prefix(".") == .Val(rest) {
            trimmed := rest.trim_start() // #4303
            if trimmed.starts_with("stamp") -> return true
        }
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:171
pub struct ModuleComptime {
    module: String,
    by_name: [String:[Int]],
    // Borrowed functions; no AST cloning for keys or lazy units.
    functions: [(&Func, OnceCell<FunctionUnit>)],
    always: [Int:Bool],

    // Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:191
    pub fn new(env: ComptimeReuseEnv, module_idx: Int, items: [Item], context: String) -> ModuleComptime {
        hasher := KeyHasher.new(COMPTIME_VALUE_SCHEMA)
        &hasher.field(env.environment)
        &hasher.field(module_idx.to_string())
        &hasher.field(context)
        loop index in 0..<env.modules.len() {
            if index != module_idx -> &hasher.field(env.modules[index])
        }
        by_name := [String:[Int]]{}
        functions := [(&Func, OnceCell<FunctionUnit>)]{}
        seeds := [String]{}
        loop item in items {
            if item == .Func(function) {
                &by_name.entry(function.name).or_default().push(functions.len())
                &functions.push((&function, OnceCell.new()))
                next
            }
            text :: canonical_fragment(item)
            &hasher.field(sha256_hex(text))
            &seeds.extend(quoted_names(text))
        }
        module := ModuleComptime{module: hasher.finish(), by_name: ^by_name, functions: ^functions, always: [Int:Bool]{}}
        module.always = module.reach([Int:Bool]{}, ^seeds)
        module
    }

    // Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:230
    pub fn key(self: ModuleComptime, name: String, value: Expr, globals: [String:String?]) -> String? {
        text :: canonical_fragment(value)
        reached :: self.reach(~self.always, quoted_names(text))
        hasher := KeyHasher.new(COMPTIME_VALUE_SCHEMA)
        &hasher.field(self.module)
        &hasher.field(name)
        &hasher.field(sha256_hex(text))
        indices := reached.keys().collect()
        &indices.sort()
        loop index in indices -> &hasher.field(self.unit(index).digest)
        names := globals.keys().collect()
        &names.sort()
        loop global in names {
            digest :: globals[global] ?? return None
            &hasher.field(global)
            &hasher.field(digest)
        }
        Val(hasher.finish())
    }

    // Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:254
    fn reach(self: ModuleComptime, reached: ^[Int:Bool], names: ^[String]) -> [Int:Bool] {
        visited := reached
        pending := names
        loop pending.pop() == .Val(name) {
            if self.by_name.get(name) == .Val(indices) {
                loop index in indices {
                    if !visited.contains_key(index) {
                        visited[index] = true
                        loop next_name in self.unit(index).names -> &pending.push(~next_name)
                    }
                }
            }
        }
        visited
    }

    // Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:265
    fn unit(self: ModuleComptime, index: Int) -> &FunctionUnit {
        (function, unit) :: self.functions[index]
        unit.get_or_init(() -> {
            text :: canonical_fragment(function)
            FunctionUnit{digest: sha256_hex(text), names: quoted_names(text)}
        })
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:183
struct FunctionUnit { digest: String, names: [String] }

// Rust: crates/jet-sema/src/Sema/Bundle/ComptimeReuse.rs:280
fn quoted_names(text: [U8]) -> [String] Never! {
    names := [String]{}
    at := 0
    loop at < text.len() {
        quote :: text[at]
        if quote != U8{34} && quote != U8{39} {
            at += 1
            next
        }
        start :: at + 1
        at = start
        loop at < text.len() && text[at] != quote {
            at += if text[at] == U8{92} -> 2 else -> 1
        }
        if quote == U8{34} {
            end :: if at < text.len() -> at else -> text.len()
            &names.push(String.from_utf8_lossy(text[start..<end]))
        }
        at += 1
    }
    names
}
