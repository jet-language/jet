use jet_foundation.[Type, Item, FuncSig, TraitRegistry, Diagnostic, Span, Expr, StrPart, EnumLitArg, ProgramBundle, NameLedger, NameVisibility, OutputKind, ResolvedOutput, OutputCallableAuthority, expr_span, mangle, member_name, type_is_app, INTERNAL_UNIT_TYPE, TYPE_OUTPUT_DEFAULTS, TYPE_OUTPUT, OUTPUT_KINDS, OUTPUT_FIELD_NAME, OUTPUT_FIELD_ENTRY, OUTPUT_DEFAULT_RUN]
use jet_sema.Sema.Bundle.[ModuleState, CompileMode]

// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:3
pub fn is_fallible_void_entry_return(ty: Type) -> Bool Never! {
    if ty == .Result(ok, _) { if ok == .Named(name) -> return name == INTERNAL_UNIT_TYPE }
    false
}
// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:11
pub enum CLIEntryShape { Struct, Invalid }
// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:21
pub fn cli_entry_param_shape(_items: [Item], ty: Type, reg: TraitRegistry) -> CLIEntryShape Never! {
    if ty != .Named(qualified) -> return CLIEntryShape.Invalid
    name := qualified
    if name.rsplit_once("::") == .Val((_, leaf)) -> name = leaf
    if name.rsplit_once(".") == .Val((_, leaf)) -> name = leaf
    if reg.implements_trait(name, "CLI") -> return CLIEntryShape.Struct
    CLIEntryShape.Invalid
}
// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:40
pub fn no_run_error() -> Diagnostic Never! {
    Diagnostic.error("E0101", "this program has no `run` function", "running a program starts at `fn run`, and the entry file doesn't define one", "add `fn run() {{ ... }}` to the entry file", None)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:50
fn output_error(what: String, why: String, fix: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E1321", what, why, fix, Val(span))
}
// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:53
fn validate_entry_contract(kind: OutputKind, source_name: String, signature: FuncSig, module_items: [Item], trait_reg: TraitRegistry, span: Span, fix: String, diags: &[Diagnostic]) -> Bool Never! {
    params_ok :: if kind == {
        .Executable -> if signature.params.len() == 1 -> cli_entry_param_shape(module_items, signature.params[0].1, trait_reg) == CLIEntryShape.Struct else -> signature.params.is_empty()
        .Service | .Check -> signature.params.is_empty()
        _ -> false
    }
    return_ok :: signature.return_type.is_none_or(ty -> if ty == {
        .Named(name) -> name == INTERNAL_UNIT_TYPE
        _ -> is_fallible_void_entry_return(ty)
    })
    if params_ok && return_ok -> return true
    contract :: if kind == OutputKind.Executable -> "an Executable takes zero or one typed CLI parameter and returns `()` or `() ?`" else -> "a Service or Check takes no parameters and returns `()` or `() ?`"
    &diags.push(output_error("Output entry `{source_name}` has the wrong callable contract", contract, fix, span))
    false
}

// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:98
fn output_string(expr: Expr) -> String? Never! {
    if expr == .Str(parts, _) {
        if parts.len() == 1 && parts[0] == .Lit(value) -> return Val(~value)
    }
    None
}
// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:108
fn output_fields(args: [EnumLitArg], span: Span, diags: &[Diagnostic]) -> [String:&Expr]? Never! {
    fields := [String:&Expr]{}
    loop arg in args {
        if arg != .Named(label, expr) {
            &diags.push(output_error("an Output payload uses named fields", "Output facts need stable field names for checking and inspection", "write `.Executable.{{ name: \"app\", entry: run }}`", span))
            return None
        }
        previous :: &fields.insert(label, &expr)
        if previous.is_some() {
            &diags.push(output_error("Output field `{label}` is written twice", "one Output field has one checked value", "remove one `{label}:` field", expr_span(expr)))
            return None
        }
    }
    Val(fields)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:137
fn output_module_path(entry: Expr) -> (String, Span, [(String, Span)])? Never! {
    members := [(String, Span)]{}
    cursor := entry
    loop cursor == .Field(base, member, span) {
        &members.push((~member, span))
        cursor = base
    }
    if cursor != .Ident(alias, alias_span) -> return None
    &members.reverse()
    Val((~alias, alias_span, ^members))
}
// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:151
fn record_output_import_use(name_ledger: &NameLedger, module_idx: Int, name: String) Never! {
    if name_ledger.effective_alias(module_idx, name) == .Val(alias) -> name_ledger.record_alias_use(module_idx, alias.span)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:164
fn output_module_alias_visible(from_module: Int, owner_module: Int, alias: String, name_ledger: NameLedger) -> Bool Never! {
    import :: name_ledger.alias(owner_module, alias) ?? return false
    if import.visibility == {
        .Public -> true
        .Package -> {
            from :: name_ledger.module(from_module) ?? return false
            owner :: name_ledger.module(owner_module) ?? return false
            from.package == owner.package
        }
        .Private -> from_module == owner_module
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:183
fn resolve_output_callable(module_idx: Int, address: ^String, kind: OutputKind, output_name: ^String, entry: Expr, bundle: ProgramBundle, states: [ModuleState], name_ledger: &NameLedger, diags: &[Diagnostic]) -> ResolvedOutput? Never! {
    (target, source_name, lowered_name) :: if entry == {
        .Ident(name, span) -> {
            state :: states[module_idx]
            if state.funcs.contains_key(name) -> (module_idx, ~name, ~name)
            else if state.unqualified.get(name) == .Val(mangled) {
                record_output_import_use(&name_ledger, module_idx, name)
                (module_idx, ~name, ~mangled)
            } else if state.unqualified_file.get(name) == .Val((real, target)) {
                record_output_import_use(&name_ledger, module_idx, name)
                (target, ~real, ~real)
            } else {
                &diags.push(output_error("Output entry `{name}` does not resolve to a function", "an Output entry is an ordinary checked function reference, not a text lookup", "define `fn {name}(...)`, import it, or update `entry:`", span))
                return None
            }
        }
        .Field(..) -> {
            path :: output_module_path(entry) ?? {
                &diags.push(output_error("Output entry has no resolvable module owner", "qualified function references use one imported or inline module alias", "write `entry: module_name.function`", expr_span(entry)))
                return None
            }
            (alias, alias_span, members) :: path
            member_path :: members.map(member -> member.0).join(".")
            record_output_import_use(&name_ledger, module_idx, alias)
            state :: states[module_idx]
            if state.code_modules.get(alias) == .Val(canonical) {
                if members.len() != 1 {
                    span :: members.last().map(member -> member.1) ?? expr_span(entry)
                    &diags.push(output_error("module `{alias}` has no function `{member_path}`", "Output entries use ordinary module member resolution", "update `entry:` to a function that exists", span))
                    return None
                }
                (member, span) :: members[0]
                lowered :: member_name(canonical, member)
                if !state.funcs.contains_key(lowered) {
                    &diags.push(output_error("module `{alias}` has no function `{member}`", "Output entries use ordinary module member resolution", "update `entry:` to a function that exists", span))
                    return None
                }
                (module_idx, ~member, lowered)
            } else if state.imports.get(alias) == .Val(first) {
                current := first
                resolved := (Int, String, String)?{None}
                loop index in 0..<members.len() {
                    (member, member_span) :: members[index]
                    is_last :: index + 1 == members.len()
                    if states[current].imports.get(member) == .Val(next_module) {
                        record_output_import_use(&name_ledger, current, member)
                        if current != module_idx && !output_module_alias_visible(module_idx, current, member, name_ledger) {
                            &diags.push(output_error("module `{alias}.{member_path}` is private", "an Output can only invoke code visible from its declaring module", "make the `{member}` module import public, or keep the Output beside it", member_span))
                            return None
                        }
                        if is_last {
                            &diags.push(output_error("module `{alias}` has no function `{member_path}`", "Output entries use ordinary module member resolution", "update `entry:` to a function that exists", member_span))
                            return None
                        }
                        current = next_module
                        next
                    }
                    if !is_last {
                        &diags.push(output_error("module `{alias}` has no function `{member_path}`", "Output entries use ordinary module member resolution", "update `entry:` to a function that exists", member_span))
                        return None
                    }
                    if states[current].reexports.get(member) == .Val((real, owner)) {
                        record_output_import_use(&name_ledger, current, member)
                        if !name_ledger.visible(module_idx, owner, real) {
                            &diags.push(output_error("function `{alias}.{member_path}` is private", "an Output can only invoke code visible from its declaring module", "make `fn {real}` public to this package, or keep the Output beside it", member_span))
                            return None
                        }
                        resolved = Val((owner, ~real, ~real))
                    } else if states[current].unqualified_file.get(member) == .Val((real, owner)) {
                        record_output_import_use(&name_ledger, current, member)
                        if current != module_idx && !output_module_alias_visible(module_idx, current, member, name_ledger) {
                            &diags.push(output_error("function `{alias}.{member_path}` is private", "an Output can only invoke code visible from its declaring module", "make the `{member}` import public, or keep the Output beside it", member_span))
                            return None
                        }
                        if !name_ledger.visible(module_idx, owner, real) {
                            &diags.push(output_error("function `{alias}.{member_path}` is private", "an Output can only invoke code visible from its declaring module", "make `fn {real}` public to this package, or keep the Output beside it", member_span))
                            return None
                        }
                        resolved = Val((owner, ~real, ~real))
                    } else if states[current].funcs.contains_key(member) {
                        if !name_ledger.visible(module_idx, current, member) {
                            &diags.push(output_error("function `{alias}.{member_path}` is private", "an Output can only invoke code visible from its declaring module", "make `fn {member}` public to this package, or keep the Output beside it", member_span))
                            return None
                        }
                        resolved = Val((current, ~member, ~member))
                    } else {
                        &diags.push(output_error("module `{alias}` has no function `{member_path}`", "Output entries use ordinary module member resolution", "update `entry:` to a function that exists", member_span))
                        return None
                    }
                }
                resolved ?? return None
            } else {
                &diags.push(output_error("no module named `{alias}` is in scope", "qualified Output entries use ordinary imported module aliases", "import the module before `entry: {alias}.{member_path}`", alias_span))
                return None
            }
        }
        _ -> {
            &diags.push(output_error("Output entry is not a function reference", "text names, calls, and runtime reflection are not Output links", "write a bare or qualified function reference, such as `entry: run`", expr_span(entry)))
            return None
        }
    }
    semantic_name :: lowered_name
    signature :: states[target].funcs.get(semantic_name).or_else(() -> states[target].funcs.get(source_name)) ?? return None
    failure_contract :: signature.failure_contract()
    if signature.is_extern || signature.is_unsafe {
        &diags.push(output_error("Output entry `{source_name}` is not an ordinary safe Jet function", "package tools invoke checked Jet functions without granting an FFI or unsafe authority boundary", "wrap the boundary in an ordinary safe Jet function and reference that function", expr_span(entry)))
        return None
    }
    if !validate_entry_contract(kind, source_name, signature, bundle.modules[target].items, states[target].trait_reg, expr_span(entry), "change `fn {source_name}` to match the {kind:Debug} contract", &diags) -> return None
    module_alias :: name_ledger.module_alias(target) ?? bundle.modules[target].alias
    lowered_path :: if target == bundle.entry -> mangle(semantic_name) else -> "{mangle(module_alias)}::{mangle(source_name)}"
    definition :: name_ledger.declaration(target, semantic_name).or_else(() -> name_ledger.declaration(target, source_name))
    Val(ResolvedOutput{
        address: ^address, kind: kind, output_name: ^output_name, module: target,
        source_path: ~bundle.modules[target].display, source_name: ~source_name,
        semantic_name: ^semantic_name, lowered_name: lowered_path,
        params: ~signature.params, return_type: ~signature.return_type,
        failure_contract: failure_contract, reference: expr_span(entry),
        definition: definition.map(declaration -> declaration.span) ?? expr_span(entry),
        authority: OutputCallableAuthority.SafeJet, effects: [], selected: false,
        selection_reason: "not selected",
    })
}

// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:469
fn output_default(bundle: ProgramBundle, field: String, diags: &[Diagnostic]) -> String? Never! {
    value := Expr?{None}
    loop item in bundle.modules[bundle.entry].items {
        if item == .Const(constant) {
            if constant.ty == .Val(.Named(name)) && name == TYPE_OUTPUT_DEFAULTS {
                value = Val(constant.value)
                break
            }
        }
    }
    defaults :: value ?? return None
    if defaults != .StructLit(_, fields, ..) {
        &diags.push(output_error("`defaults:` needs one checked record", "Output defaults map singular tool intents to Output addresses", "write `defaults: {{ run: app }}`", expr_span(defaults)))
        return None
    }
    // Rust find_map continues after an invalid matching field.
    loop (name, _, expr) in fields {
        if name != field -> next
        if expr == .Ident(address, _) -> return Val(~address)
        &diags.push(output_error("default `{field}` is not an Output address", "defaults use checked Output references, not text or calls", "write `{field}: output_name`", expr_span(expr)))
    }
    None
}

// Rust: crates/jet-sema/src/Sema/Bundle/Outputs.rs:509
pub fn resolve_outputs(bundle: &ProgramBundle, states: [ModuleState], name_ledger: &NameLedger, mode: CompileMode, explicit: String?, diags: &[Diagnostic]) Never! {
    resolved := [(Int, Int, ResolvedOutput)]{}
    loop module_idx in 0..<bundle.modules.len() {
        module :: bundle.modules[module_idx]
        loop item_idx in 0..<module.items.len() {
            if module.items[item_idx] != .Const(value) -> next
            if value.ty != .Val(.Named(name)) || name != TYPE_OUTPUT -> next
            if value.value != .EnumLit(_, variant, args, span) {
                &diags.push(output_error("Output needs one closed kind", "Output is the closed sum of the nine ratified kinds", "write `.Executable.{{ ... }}`, `.Service.{{ ... }}`, or another Output kind", expr_span(value.value)))
                next
            }
            kind :: OutputKind.from_name(variant) ?? {
                &diags.push(output_error("`{variant}` is not an Output kind", "Output has exactly nine ratified kinds", "use one of: {OUTPUT_KINDS.join(\", \")}", span))
                next
            }
            fields :: output_fields(args, span, &diags) ?? next
            name_expr :: fields.get(OUTPUT_FIELD_NAME) ?? {
                &diags.push(output_error("Output is missing `name:`", "every Output has one stable user-facing name", "add `name: \"...\"`", span))
                next
            }
            output_name :: output_string(name_expr) ?? {
                &diags.push(output_error("Output `name:` must be fixed text", "graph identity cannot depend on runtime interpolation", "write a plain string literal", expr_span(name_expr)))
                next
            }
            if !kind.is_runnable() {
                if fields.get(OUTPUT_FIELD_ENTRY) == .Val(entry) -> &diags.push(output_error("{kind:Debug} Output is not runnable", "only Executable, Service, and Check link to functions", "remove `entry:` from this Output", expr_span(entry)))
                next
            }
            invalid_field := false
            loop arg in args {
                if arg == .Named(label, expr) {
                    if label != OUTPUT_FIELD_NAME && label != OUTPUT_FIELD_ENTRY {
                        &diags.push(output_error("`{label}:` is not a runnable Output field", "Executable, Service, and Check Outputs contain only their stable name and checked entry reference", "remove `{label}:` from this Output", expr_span(expr)))
                        invalid_field = true
                        break
                    }
                }
            }
            if invalid_field -> next
            entry :: fields.get(OUTPUT_FIELD_ENTRY) ?? {
                &diags.push(output_error("{kind:Debug} Output is missing `entry:`", "every runnable Output links to one checked function", "add `entry: function_name`", span))
                next
            }
            if resolve_output_callable(module_idx, ~value.name, kind, ^output_name, entry, bundle, states, &name_ledger, &diags) == .Val(fact) -> &resolved.push((module_idx, item_idx, ^fact))
        }
    }
    has_legacy_run :: bundle.modules[bundle.entry].items.any(item -> if item == {
        .Func(function) -> function.name == "run"
        _ -> false
    })
    run_default :: output_default(bundle, OUTPUT_DEFAULT_RUN, &diags)
    run_default_index := Int?{None}
    if run_default == .Val(address) {
        loop index in 0..<resolved.len() {
            if resolved[index].2.kind == OutputKind.Executable && resolved[index].2.address == address {
                run_default_index = Val(index)
                break
            }
        }
        if run_default_index.is_none() -> &diags.push(output_error("default `run` names incompatible Output `{address}`", "the run default must name an Executable Output in this Package", "point `defaults.run` at one checked Executable address", Span{start: 0, end: 0}))
    }
    if mode == CompileMode.Run {
        if explicit == .Val(address) {
            selected := false
            loop index in 0..<resolved.len() {
                fact :: resolved[index].2
                if fact.address == address && (fact.kind == OutputKind.Executable || fact.kind == OutputKind.Service) {
                    resolved[index].2.selected = true
                    resolved[index].2.selection_reason = "explicit address"
                    selected = true
                    break
                }
            }
            if !selected {
                choices := [String]{}
                loop (_, _, fact) in resolved { if fact.kind == OutputKind.Executable || fact.kind == OutputKind.Service -> &choices.push(~fact.address) }
                &choices.sort()
                &diags.push(output_error("`{address}` is not an Output compatible with `jet run`", "an explicit run address must name one checked Executable or Service Output", "choose one of: {choices.join(\", \")}", Span{start: 0, end: 0}))
            }
        } else if !has_legacy_run {
            executable := [Int]{}
            loop index in 0..<resolved.len() { if resolved[index].2.kind == OutputKind.Executable -> &executable.push(index) }
            if executable.len() == 1 {
                resolved[executable[0]].2.selected = true
                resolved[executable[0]].2.selection_reason = "sole compatible Output"
            } else if executable.len() > 1 {
                if run_default_index == .Val(index) {
                    resolved[index].2.selected = true
                    resolved[index].2.selection_reason = "checked defaults.run"
                } else if run_default.is_none() {
                    names := [String]{}
                    loop index in executable -> &names.push(~resolved[index].2.address)
                    &names.sort()
                    &diags.push(Diagnostic.error("E1321", "this Package has more than one runnable Executable", "without `fn run`, a singular run selects only a sole compatible Output or a checked default", "choose an explicit Output or add `defaults: {{ run: {names[0]} }}`; candidates: {names.join(\", \")}", None))
                }
            }
        }
    } else if mode == CompileMode.Test || mode == CompileMode.TestOverride {
        loop index in 0..<resolved.len() {
            resolved[index].2.selected = resolved[index].2.kind == OutputKind.Check
            if resolved[index].2.selected -> resolved[index].2.selection_reason = "all Check Outputs"
        }
    }
    selected_output :: resolved.any(row -> row.2.selected)
    if has_legacy_run && (mode == CompileMode.Run || mode == CompileMode.Check) && !selected_output {
        if states[bundle.entry].funcs.get("run") == .Val(signature) {
            span := Span{start: 0, end: 0}
            loop item in bundle.modules[bundle.entry].items {
                if item == .Func(function) && function.name == "run" {
                    span = function.span
                    break
                }
            }
            // D-WEBAPP1=D: App-returning run serves, rather than executing once.
            if !signature.return_type.is_some_and(type_is_app) {
                _ :: validate_entry_contract(OutputKind.Executable, "run", signature, bundle.modules[bundle.entry].items, states[bundle.entry].trait_reg, span, "declare the entry as `fn run()` or `fn run() ()?`", &diags)
            }
        }
    }
    loop (module, item, fact) in resolved {
        if bundle.modules[module].items[item] == .Const(value) -> value.resolved_output = Val(^fact)
    }
}
