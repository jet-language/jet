// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! #2517 stage S2: dependency packages checked once, reused from records.
//RS //!
//RS //! A `jet check` runs inside a package-record session (`with_package_records`).
//RS //! After registration and the failure-union probe, every package of the
//RS //! bundle gets its check key: compiler identity, the target facts and check
//RS //! environment sema reads, the package's source digest, and the interface
//RS //! digests its direct dependencies produced in this run. A dependency package
//RS //! (Core, or a package under a dependency root) whose key has a stored record
//RS //! is **sealed**: its bodies are erased, it is not body-checked, and its item
//RS //! records seed the facts its bodies would have produced. Every other
//RS //! package is checked, and each clean dependency package publishes its
//RS //! record for the next run.
//RS //!
//RS //! The record is a bundle of item records (design section 3.5): one entry
//RS //! per effect-graph node the package owns, with its summary and summary
//RS //! digest, plus the per-module facts that are not keyed by item yet
//RS //! (address-taken names, the #3708 inferred-infallible set, exact-int use).
//RS //! Call edges are stored with stable module identities, never loader
//RS //! aliases, and are mapped back to the current bundle's aliases when seeded.
//RS //! Spans are module-absolute; a sealed package has the recorded bytes, so
//RS //! they stay valid. Item reuse inside a checked package (stage S3R,
//RS //! `ItemReuse`) stores item-relative spans in its own item records.
//RS //!
//RS //! A package is not published when the codec cannot carry one of its facts,
//RS //! when its bodies evaluate at compile time or discovered inputs, or when its
//RS //! check reported a diagnostic that reaches the importer's output. Such a
//RS //! package is checked on every run.
//RS 
//RS use crate::Diagnostics::Span;
//RS use crate::Sema::Effects::{
//RS     AuthorityDelegation, AutodiffObligation, CallbackObligation, ComputeCallFact,
//RS     DiscardedResultFact, EffectSummary, RegionSummary,
//RS };
//RS use crate::Sema::MemoryFacts::{
//RS     MemoryCall, MemoryEvent, MemoryEventKind, MemorySummary, OpenMemoryDispatch,
//RS };
//RS use crate::AST::{Func, Item, ProgramBundle};
//RS use jet_foundation::PackageIdentity::{self as identity, PackageGraph, PackageKind};
//RS use jet_foundation::RecordCodec::{
//RS     encode_record, record_digest, record_map, RecordError, RecordReader, RecordSection,
//RS     RecordValue,
//RS };
//RS use std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};
//RS use std::sync::{Arc, Mutex};
//RS 
//RS /// Schema of the package check record (an action record under the key).
//RS pub const PKG_CHECK_SCHEMA: &str = "jet.pkg-check/v1";
//RS /// Schema of the item bundle the check record points to (content addressed).
//RS pub const ITEMS_SCHEMA: &str = "jet.items/v1";
//RS const ITEM_SUMMARY_SCHEMA: &str = "jet.item-summary/v1";
//RS 
//RS const SECTION_HEADER: u64 = 1;
//RS const SECTION_MODULES: u64 = 2;
//RS const SECTION_ITEMS: u64 = 3;
//RS 
//RS /// The record store a package-record session reads and writes. The CLI
//RS /// implements it over the shared `jet-store` cache.
//RS pub trait PackageRecordStore: Send + Sync {
//RS     /// Compiler and Core identity; part of every key.
//RS     fn compiler_identity(&self) -> String;
//RS     /// A stored record of `schema` under `key`, or `None` on a miss.
//RS     fn load(&self, schema: &str, key: &str) -> Option<Vec<u8>>;
//RS     /// Publish a record. Content-addressed schemas use the SHA-256 hex of
//RS     /// `bytes` as `key`. Failing to publish only costs speed.
//RS     fn publish(&self, schema: &str, key: &str, bytes: &[u8]);
//RS     /// A stored action record without recording its use. A check that reads
//RS     /// one record per item uses this and records the uses in `publish_batch`.
//RS     fn load_untouched(&self, schema: &str, key: &str) -> Option<Vec<u8>>;
//RS     /// Record the uses of the `touched` action records and publish `records`
//RS     /// (action records under their keys) in one store transaction. Failing
//RS     /// only costs speed.
//RS     fn publish_batch(&self, schema: &str, touched: &[String], records: Vec<(String, Vec<u8>)>);
//RS     /// The manifest bytes of a package directory.
//RS     fn manifest(&self, root: &std::path::Path) -> Option<Vec<u8>>;
//RS }
