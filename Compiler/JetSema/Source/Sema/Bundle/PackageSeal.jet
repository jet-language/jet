}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:107
struct Session { store: Arc[PackageRecordStore] rows: [PackageReuseRow] }
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:112
// GATE #4494: actual native mutex, not thread-local or unsynchronized state.
static SESSION: Mutex[Session?] = Mutex.new(None)
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:114
fn session() -> MutexGuard[Session?] Never! {
    SESSION.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() }) // GATE #4494
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:118
struct SessionGuard {
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:121
    fn drop(self: &SessionGuard) Never! {
        state := session()
        _ :: state.take()
        state.release() // GATE #4494: release before ItemReuse cleanup.
        ItemReuse.end()
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:130
pub fn with_package_records[R](^store: Arc[PackageRecordStore], check: fn() -> R) -> (R, [PackageReuseRow]) Never! {
    state := session()
    state.set(Val(Session{store: ^store, rows: [PackageReuseRow]{}}))
    state.release() // GATE #4494
    guard := SessionGuard{}
    result := check()
    state = session()
    rows := [PackageReuseRow]{}
    if state.get_mut() == .Val(active) { rows = ^active.rows; active.rows = [PackageReuseRow]{} }
    state.release() // GATE #4494
    guard.drop()
    (^result, ^rows)
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:146
pub fn sealed_package_count() -> USize Never! {
    state := session()
    count := USize{0}
    if state.get() == .Val(active) {
        loop row in active.rows { if row.reuse == PackageReuse.Reused { count += 1 } }
    }
    state.release() // GATE #4494
    count
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:157
pub fn session_store() -> Arc[PackageRecordStore]? Never! {
    state := session()
    store := None as Arc[PackageRecordStore]?
    if state.get() == .Val(active) { store = Val(active.store.clone()) }
    state.release() // GATE #4494
    ^store
}
