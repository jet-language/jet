// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:58
pub trait PackageRecordStore {
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:60
    fn compiler_identity(self) -> String Never!
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:62
    fn load(self, schema: String, key: String) -> [U8]? Never!
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:65
    fn publish(self, schema: String, key: String, bytes: [U8]) Never!
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:68
    fn load_untouched(self, schema: String, key: String) -> [U8]? Never!
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:72
    fn publish_batch(self, schema: String, touched: [String], ^records: [(String, [U8])]) Never!
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:74
    fn manifest(self, root: OSPath) -> [U8]? Never!
}
