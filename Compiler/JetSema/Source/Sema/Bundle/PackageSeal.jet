// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:179
pub struct SealPlan {
    store: Arc[PackageRecordStore]
    graph: PackageGraph
    keys: [String]
    eligible: [String?]
    sealed: [Bool]
    module_identity: [String?]
    comptime: [Bool]
    pub modules: [USize:SealedModule]
    pub outputs: [USize:ModuleOutputs]

    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:228
    pub fn begin(bundle: &ProgramBundle, ledger: NameLedger, plugin_digest: String) -> SealPlan? Never! {
        store := session_store() ?? return None
        graph := PackageGraph.from_ledger(bundle, ledger)
        if !graph.is_acyclic() -> return None
        // Runnable roots need every body for whole-program cost lowering.
        loop item in bundle.modules[bundle.entry].items {
            if item == {
                .Func(function) -> { if function.name == "run" -> return None }
                .Const(constant) -> { if constant.resolved_output.is_some() -> return None }
                _ -> {}
            }
        }
        environment := identity.KeyHasher.new(identity.TARGET_FACTS_SCHEMA)
        environment.field(identity.target_facts_digest(identity.target_fact_pairs(bundle)))
        environment.field(sha256_hex(incremental_global_environment(bundle, plugin_digest)))
        target :: environment.finish()
        compiler :: store.compiler_identity()
        count :: graph.packages.len()
        interfaces := [String].repeat("", count)
        keys := [String].repeat("", count)
        loop component in graph.components() {
            loop index in component { interfaces[index] = graph.interface_digest(bundle, index, [String:String]{}) }
            loop index in component {
                package :: graph.packages[index]
                manifest := None as [U8]?
                if package.root == .Val(root) { manifest = store.manifest(root) }
                source :: graph.source_digest(bundle, index, manifest)
                dependencies := [(String, String)]{}
                loop dependency in package.dependencies { dependencies.push((graph.packages[dependency].identity.clone(), interfaces[dependency].clone())) }
                keys[index] = identity.package_check_key(compiler, target, package.identity, source, dependencies)
            }
        }
        module_identity := [String?]{}
        comptime := [Bool]{}
        loop module in 0..bundle.modules.len() {
            module_identity.push(ledger.module_identity(module))
            has_comptime := false
            loop item in bundle.modules[module].items { if sealed_body(item) { has_comptime = true; break } }
            comptime.push(has_comptime)
        }
        eligible := [String?]{}
        loop package in graph.packages {
            if package.modules.contains(bundle.entry) { eligible.push(Val("the checked package itself")); continue }
            dependency := package.kind == PackageKind.Core
            if !dependency {
                dependency = true
                loop module in package.modules {
                    path :: bundle.modules[module].path
                    under_root := false
                    loop root in bundle.dep_roots.values() { if path.starts_with(root) { under_root = true; break } }
                    if !under_root { dependency = false; break }
                }
            }
            if !dependency { eligible.push(Val("not a dependency package")); continue }
            missing_identity := false
            loop module in package.modules { if module_identity[module].is_none() { missing_identity = true; break } }
            if missing_identity { eligible.push(Val("a module has no stable identity")); continue }
            eligible.push(None)
        }
        plan := SealPlan{store: ^store, graph: ^graph, keys: ^keys, eligible: ^eligible, sealed: [Bool].repeat(false, count), module_identity: ^module_identity, comptime: ^comptime, modules: [USize:SealedModule]{}, outputs: [USize:ModuleOutputs]{}}
        aliases :: plan.identity_aliases(ledger, bundle)
        loop index in 0..count {
            if plan.eligible[index].is_some() -> continue
            if plan.load(index, aliases) == .Val(modules) { plan.sealed[index] = true; plan.modules.extend(modules) }
        }
        checked := [USize]{}
        package_mates := [[USize]]{}
        loop module in 0..bundle.modules.len() {
            if !plan.modules.contains_key(module) && !plan.comptime[module] && plan.module_identity[module].is_some() {
                is_core := false
                if plan.graph.package_of(module) == .Val(package) { is_core = plan.graph.packages[package].kind == PackageKind.Core }
                if !is_core { checked.push(module) }
            }
            if plan.graph.package_of(module) == .Val(package) { package_mates.push(plan.graph.packages[package].modules.clone()) }
            else { package_mates.push([USize]{module}) }
        }
        ItemReuse.begin(plan.store.clone(), bundle, ledger, "{compiler}{TEXT_NUL}{target}", checked, package_mates, plan.module_identity, aliases)
        loop module in plan.modules.keys() { erase_bodies(&bundle.modules[module].items) }
        Val(^plan)
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:374
    fn identity_aliases(self, ledger: NameLedger, bundle: ProgramBundle) -> [String:String] Never! {
        aliases := [String:String]{}
        loop module in 0..self.module_identity.len() {
            if self.module_identity[module] == .Val(identity) {
                alias :: ledger.module_alias(module) ?? bundle.modules[module].alias
                aliases[identity.clone()] = alias.to_string()
            }
        }
        ^aliases
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:389
    fn load(self, index: USize, aliases: [String:String]) -> [USize:SealedModule]? Never! {
        package :: self.graph.packages[index]
        check_bytes :: self.store.load(PKG_CHECK_SCHEMA, self.keys[index]) ?? return None
        check :: RecordReader.open_schema(check_bytes, PKG_CHECK_SCHEMA).ok() ?? return None
        header :: check.element(SECTION_HEADER, 0).ok() ?? return None
        package_identity :: (header.field("package").ok() ?? return None).as_str().ok() ?? return None
        key :: (header.field("key").ok() ?? return None).as_str().ok() ?? return None
        if package_identity != package.identity || key != self.keys[index] -> return None
        items_key :: (header.field("items").ok() ?? return None).as_str().ok() ?? return None
        items_bytes :: self.store.load(ITEMS_SCHEMA, items_key) ?? return None
        items :: RecordReader.open_schema(items_bytes, ITEMS_SCHEMA).ok() ?? return None
        by_identity := [String:USize]{}
        loop module in package.modules { by_identity[self.module_identity[module] ?? ""] = module }
        modules := [USize:SealedModule]{}
        values :: items.elements(SECTION_MODULES).ok() ?? return None
        loop value in values {
            identity :: (value.field("module").ok() ?? return None).as_str().ok() ?? return None
            module :: by_identity.get(identity) ?? return None
            address_taken :: (value.field("address_taken").ok() ?? return None).str_list().ok() ?? return None
            inferred :: (value.field("inferred_infallible").ok() ?? return None).str_list().ok() ?? return None
            exact_int :: (value.field("exact_int").ok() ?? return None).as_bool().ok() ?? return None
            modules[module] = SealedModule{summaries: [(String, EffectSummary)]{}, address_taken: address_taken, inferred_infallible: inferred.collect(), exact_int: exact_int}
        }
        if modules.len() != package.modules.len() -> return None
        values_items :: items.elements(SECTION_ITEMS).ok() ?? return None
        loop value in values_items {
            identity :: (value.field("module").ok() ?? return None).as_str().ok() ?? return None
            module :: by_identity.get(identity) ?? return None
            key :: ((value.field("key").ok() ?? return None).as_str().ok() ?? return None).to_string()
            summary := decode_summary(value.field("summary").ok() ?? return None).ok() ?? return None
            map_edges(&summary, fn(edge: String) -> String Never! { to_alias(edge, aliases) })
            target := modules.get_mut(module) ?? return None
            target.summaries.push((key, ^summary))
        }
        Val(^modules)
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:442
    pub fn sealed_paths(self, bundle: ProgramBundle) -> HashSet[String] Never! {
        paths := HashSet[String].new()
        loop module in self.modules.keys() { _ :: paths.insert(bundle.modules[module].path.to_string_lossy().to_string()) }
        ^paths
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:452
    pub fn finish(^self, bundle: ProgramBundle, ledger: NameLedger, public_summaries: [String:EffectSummary], inferred: [HashSet[String]], exact_int: [Bool], diagnostics: [Diagnostic]) Never! {
        aliases :: self.identity_aliases(ledger, bundle)
        identities := [String:String]{}
        loop (identity, alias) in aliases { identities[alias.clone()] = identity.clone() }
        module_of_path := [String:USize]{}
        loop module in 0..bundle.modules.len() { module_of_path[bundle.modules[module].path.to_string_lossy().to_string()] = module }
        reported := [Bool].repeat(false, self.graph.packages.len())
        unattributed := false
        loop diagnostic in diagnostics {
            core_lint :: diagnostic.severity == Severity.Lint
            error :: diagnostic.severity == Severity.Error
            origin :: diagnostic.origin() ?? continue
            package := None as USize?
            if module_of_path.get(origin.path) == .Val(module) { package = self.graph.package_of(module) }
            if package == {
                .Val(index) -> {
                    core :: self.graph.packages[index].kind == PackageKind.Core
                    if error || (core && !core_lint) { reported[index] = true }
                }
                .None -> { unattributed = unattributed || error }
            }
        }
        rows := [PackageReuseRow]{}
        loop index in 0..self.graph.packages.len() {
            package :: self.graph.packages[index]
            has_comptime := false
            discovered_inputs := false
            loop module in package.modules {
                has_comptime = has_comptime || self.comptime[module]
                if self.outputs.get(module) == .Val(outputs) { discovered_inputs = discovered_inputs || outputs.discovered_inputs }
            }
            reuse := PackageReuse.Checked
            detail := ""
            if self.sealed[index] { reuse = .Reused; detail = "green:key" }
            else if self.eligible[index] == .Val(reason) { detail = reason.clone() }
            else if reported[index] || unattributed { detail = "its check reported diagnostics" }
            else if has_comptime { detail = "a body evaluates at compile time" }
            else if discovered_inputs { detail = "its check discovered inputs" }
            else {
                published :: self.publish(index, bundle, ledger, identities, public_summaries, inferred, exact_int)
                if published == { .Ok(_) -> { reuse = .CheckedPublished; detail = "red" } .Err(reason) -> { detail = reason } }
            }
            if ItemReuse.package_detail(package.modules) == .Val(items) { detail = "{detail}; {items}" }
            rows.push(PackageReuseRow{identity: package.identity.clone(), key: self.keys[index].clone(), reuse: reuse, modules: package.modules.len(), detail: ^detail})
        }
        ItemReuse.end()
        state := session()
        if state.get_mut() == .Val(active) { active.rows.extend(^rows) }
        state.release() // GATE #4494
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:535
    fn publish(self, index: USize, bundle: ProgramBundle, ledger: NameLedger, identities: [String:String], public_summaries: [String:EffectSummary], inferred: [HashSet[String]], exact_int: [Bool]) Err! {
        package :: self.graph.packages[index]
        modules := [RecordValue]{}
        items := [RecordValue]{}
        loop module in package.modules {
            identity :: self.module_identity[module] ?? ""
            alias :: ledger.module_alias(module) ?? bundle.modules[module].alias
            prefix :: "{alias}::"
            nodes := [String:EffectSummary]{}
            loop (key, summary) in public_summaries {
                if key.strip_prefix(prefix) == .Val(local) { nodes[local.to_string()] = summary }
            }
            node_keys := nodes.keys().collect()
            node_keys.sort()
            loop local in node_keys {
                summary := nodes[local].clone()
                map_edges(&summary, fn(edge: String) -> String Never! { to_identity(edge, identities) })
                encoded :: encode_summary(summary)!
                digest :: record_digest(ITEM_SUMMARY_SCHEMA, [RecordSection]{RecordSection.new(U64{1}, [RecordValue]{encoded.clone()})}).map_err(fn(error) { error.to_string() })!
                items.push(record_map([(String, RecordValue)]{("module", RecordValue.str(identity)), ("key", RecordValue.str(local)), ("summary_digest", RecordValue.Digest{value: digest}), ("summary", encoded)}))
            }
            address_taken := [String]{}
            if self.outputs.get(module) == .Val(outputs) { address_taken = outputs.address_taken.iter().cloned().collect() }
            address_taken.sort()
            infallible := [String]{}
            if inferred.get(module) == .Val(names) { infallible = names.iter().cloned().collect() }
            infallible.sort()
            modules.push(record_map([(String, RecordValue)]{("module", RecordValue.str(identity)), ("address_taken", RecordValue.list_of_str(address_taken)), ("inferred_infallible", RecordValue.list_of_str(infallible)), ("exact_int", RecordValue.Bool{value: exact_int.get(module) ?? false})}))
        }
        header :: record_map([(String, RecordValue)]{("package", RecordValue.str(package.identity))})
        item_bytes :: encode_record(ITEMS_SCHEMA, [RecordSection]{RecordSection.new(SECTION_HEADER, [RecordValue]{header}), RecordSection.new(SECTION_MODULES, ^modules), RecordSection.new(SECTION_ITEMS, ^items)}).map_err(fn(error) { error.to_string() })!
        items_key :: sha256_hex(item_bytes)
        self.store.publish(ITEMS_SCHEMA, items_key, item_bytes)
        check :: encode_record(PKG_CHECK_SCHEMA, [RecordSection]{RecordSection.new(SECTION_HEADER, [RecordValue]{record_map([(String, RecordValue)]{("package", RecordValue.str(package.identity)), ("key", RecordValue.str(self.keys[index])), ("items", RecordValue.Str{value: items_key})})})}).map_err(fn(error) { error.to_string() })!
        self.store.publish(PKG_CHECK_SCHEMA, self.keys[index], check)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:191
fn sealed_body(item: Item) -> Bool Never! {
    if item == .Const(_) -> return false
    item_has_comptime_evaluation(item)
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:195
fn erase_function(function: &Func) Never! { function.body.clear() }
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:201
fn erase_bodies(items: &[Item]) Never! {
    loop &item in items {
        if item == {
            .Func(function) -> erase_function(&function)
            .Struct(definition) -> {
                loop &function in definition.methods { erase_function(&function) }
                loop &implementation in definition.trait_impls { loop &function in implementation.methods { erase_function(&function) } }
            }
            .Enum(definition) -> {
                loop &function in definition.methods { erase_function(&function) }
                loop &implementation in definition.trait_impls { loop &function in implementation.methods { erase_function(&function) } }
            }
            .Impl(implementation) -> { loop &function in implementation.methods { erase_function(&function) } }
            .Test(test) -> test.body.clear()
            _ -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:624
pub fn to_identity(edge: String, identities: [String:String]) -> String Never! {
    if edge.split_once("::") == .Val(parts) {
        (alias, rest) :: parts
        if identities.get(alias) == .Val(identity) -> return "{{{identity}}}::{rest}"
    }
    edge.to_string()
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:634
pub fn to_alias(edge: String, aliases: [String:String]) -> String Never! {
    stable :: edge.strip_prefix('{') ?? return edge.to_string()
    if stable.split_once("}::") == .Val(parts) {
        (identity, rest) :: parts
        if aliases.get(identity) == .Val(alias) -> return "{alias}::{rest}"
    }
    edge.to_string()
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:649
pub fn map_edges(summary: &EffectSummary, map: fn(String) -> String) Never! {
    set :: fn(edges: BTreeSet[String]) -> BTreeSet[String] Never! {
        mapped := BTreeSet[String].new()
        loop edge in edges { _ :: mapped.insert(map(edge)) }
        ^mapped
    }
    summary.edges = set(summary.edges)
    loop &region in summary.regions { region.edges = set(region.edges) }
    loop &obligation in summary.callback_obligations { obligation.edges = set(obligation.edges) }
    loop &obligation in summary.autodiff_obligations { obligation.target = map(obligation.target) }
    loop &fact in summary.discarded_results { fact.callee = map(fact.callee) }
    loop &call in summary.memory.calls { call.callee = map(call.callee) }
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:671
fn span_value(span: Span) -> RecordValue Never! {
    RecordValue.List{value: [RecordValue]{RecordValue.Int{value: I64{span.start}}, RecordValue.Int{value: I64{span.end}}}}
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:678
fn span_of(value: RecordValue) -> Span RecordError! {
    pair :: value.as_list()!
    if pair.len() != 2 -> throw RecordError.Malformed{message: "span is not a pair"}
    Span.new(pair[0].as_usize()!, pair[1].as_usize()!)
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:685
fn strings(values: BTreeSet[String]) -> RecordValue Never! {
    RecordValue.list_of_str(values)
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:689
fn string_set(value: RecordValue) -> BTreeSet[String] RecordError! { value.str_list()!.collect() }
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:693
fn count_value(value: U64?) -> RecordValue Never! {
    if value == { .None -> RecordValue.Null .Val(count) -> RecordValue.Int{value: I64{count}} }
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:697
fn count_of(value: RecordValue) -> U64? RecordError! {
    if value.is_null() -> return None
    count :: value.as_int()!
    if count < 0 -> throw RecordError.Malformed{message: "negative count"}
    Val(U64{count})
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:706
fn text(value: RecordValue, name: String) -> String RecordError! { value.field(name)!.as_str()!.to_string() }
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:710
fn list[T](value: RecordValue, name: String, decode: fn(RecordValue) -> T RecordError!) -> [T] RecordError! {
    result := [T]{}
    loop entry in value.field(name)!.as_list()! { result.push(decode(entry)!) }
    ^result
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:720
pub fn encode_summary(summary: EffectSummary) -> RecordValue Err! {
    // Keep exhaustive destructuring: every summary field must be carried.
    EffectSummary{direct, direct_spans, edges, maximal, maximal_span, unbounded_trait_dispatch, regions, authority_delegations, callback_obligations, autodiff_obligations, compute_calls, autodiff_safe_panic, autodiff_unsafe_panic, memory, discarded_results, failure_direct} :: summary
    MemorySummary{events, open_dispatches, regions: memory_regions, unbounded_control, calls} :: memory
    if !memory_regions.is_empty() -> throw "a memory policy region is not recordable yet"
    spans := [RecordValue]{}
    span_keys := direct_spans.keys().collect()
    span_keys.sort()
    loop effect in span_keys { spans.push(record_map([(String, RecordValue)]{("effect", RecordValue.str(effect)), ("span", span_value(direct_spans[effect]))})) }
    region_values := [RecordValue]{}
    loop region in regions {
        region_values.push(record_map([(String, RecordValue)]{("caps", strings(region.caps)), ("direct", strings(region.direct)), ("edges", strings(region.edges)), ("maximal", RecordValue.Bool{value: region.maximal}), ("caps_span", span_value(region.caps_span))}))
    }
    delegation_values := [RecordValue]{}
    loop delegation in authority_delegations {
        delegation_values.push(record_map([(String, RecordValue)]{("scope_span", span_value(delegation.scope_span)), ("binding", RecordValue.str(delegation.binding)), ("resource", RecordValue.str(delegation.resource)), ("operation", RecordValue.str(delegation.operation)), ("span", span_value(delegation.span))}))
    }
    callback_values := [RecordValue]{}
    loop obligation in callback_obligations {
        callback_values.push(record_map([(String, RecordValue)]{("bound", strings(obligation.bound)), ("direct", strings(obligation.direct)), ("edges", strings(obligation.edges)), ("maximal", RecordValue.Bool{value: obligation.maximal}), ("span", span_value(obligation.span))}))
    }
    autodiff_values := [RecordValue]{}
    loop obligation in autodiff_obligations {
        autodiff_values.push(record_map([(String, RecordValue)]{("method", RecordValue.str(obligation.method)), ("target", RecordValue.str(obligation.target)), ("span", span_value(obligation.span))}))
    }
    compute_values := [RecordValue]{}
    loop call in compute_calls { compute_values.push(record_map([(String, RecordValue)]{("method", RecordValue.str(call.method)), ("span", span_value(call.span))})) }
    event_values := [RecordValue]{}
    loop event in events {
        (kind, bytes) :: if event.kind == {
            .Allocation -> ("alloc", RecordValue.Null)
            .RetainRelease -> ("rc", RecordValue.Null)
            .ArenaBytes(count) -> ("arena", count_value(count))
        }
        event_values.push(record_map([(String, RecordValue)]{("kind", RecordValue.str(kind)), ("bytes", bytes), ("span", span_value(event.span)), ("source", RecordValue.str(event.source)), ("operation", RecordValue.str(event.operation)), ("provenance", RecordValue.str(event.provenance)), ("executions", count_value(event.executions))}))
    }
    dispatch_values := [RecordValue]{}
    loop dispatch in open_dispatches {
        dispatch_values.push(record_map([(String, RecordValue)]{("span", span_value(dispatch.span)), ("source", RecordValue.str(dispatch.source)), ("reason", RecordValue.str(dispatch.reason))}))
    }
    control_values := [RecordValue]{}
    loop span in unbounded_control { control_values.push(span_value(span)) }
    call_values := [RecordValue]{}
    loop call in calls {
        call_values.push(record_map([(String, RecordValue)]{("callee", RecordValue.str(call.callee)), ("span", span_value(call.span)), ("source", RecordValue.str(call.source)), ("executions", count_value(call.executions))}))
    }
    discarded_values := [RecordValue]{}
    loop fact in discarded_results {
        discarded_values.push(record_map([(String, RecordValue)]{("callee", RecordValue.str(fact.callee)), ("callee_name", RecordValue.str(fact.callee_name)), ("call_text", RecordValue.str(fact.call_text)), ("span", span_value(fact.span)), ("failure_open", RecordValue.Bool{value: fact.failure_open})}))
    }
    maximal_span_value :: if maximal_span == { .None -> RecordValue.Null .Val(span) -> span_value(span) }
    record_map([(String, RecordValue)]{
        ("direct", strings(direct)), ("direct_spans", RecordValue.List{value: ^spans}), ("edges", strings(edges)),
        ("maximal", RecordValue.Bool{value: maximal}), ("maximal_span", maximal_span_value), ("unbounded_trait_dispatch", RecordValue.Bool{value: unbounded_trait_dispatch}),
        ("regions", RecordValue.List{value: ^region_values}), ("authority_delegations", RecordValue.List{value: ^delegation_values}),
        ("callback_obligations", RecordValue.List{value: ^callback_values}), ("autodiff_obligations", RecordValue.List{value: ^autodiff_values}), ("compute_calls", RecordValue.List{value: ^compute_values}),
        ("autodiff_safe_panic", RecordValue.Bool{value: autodiff_safe_panic}), ("autodiff_unsafe_panic", RecordValue.Bool{value: autodiff_unsafe_panic}),
        ("memory_events", RecordValue.List{value: ^event_values}), ("memory_open_dispatches", RecordValue.List{value: ^dispatch_values}),
        ("memory_unbounded_control", RecordValue.List{value: ^control_values}), ("memory_calls", RecordValue.List{value: ^call_values}),
        ("discarded_results", RecordValue.List{value: ^discarded_values}), ("failure_direct", RecordValue.Bool{value: failure_direct})
    })
}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:926
pub fn decode_summary(value: RecordValue) -> EffectSummary RecordError! {
    flag :: fn(name: String) -> Bool RecordError! { value.field(name)!.as_bool()! }
    maximal_span_value :: value.field("maximal_span")!
    maximal_span :: if maximal_span_value.is_null() -> None else -> Val(span_of(maximal_span_value)!)
    direct_spans := [String:Span]{}
    loop entry in value.field("direct_spans")!.as_list()! { direct_spans[text(entry, "effect")!] = span_of(entry.field("span")!)! }
    EffectSummary{
        direct: string_set(value.field("direct")!)!, direct_spans: ^direct_spans, edges: string_set(value.field("edges")!)!, maximal: flag("maximal")!, maximal_span: maximal_span, unbounded_trait_dispatch: flag("unbounded_trait_dispatch")!,
        regions: list(value, "regions", fn(entry: RecordValue) -> RegionSummary RecordError! {
            RegionSummary{caps: string_set(entry.field("caps")!)!, direct: string_set(entry.field("direct")!)!, edges: string_set(entry.field("edges")!)!, maximal: entry.field("maximal")!.as_bool()!, caps_span: span_of(entry.field("caps_span")!)!}
        })!,
        authority_delegations: list(value, "authority_delegations", fn(entry: RecordValue) -> AuthorityDelegation RecordError! {
            AuthorityDelegation{scope_span: span_of(entry.field("scope_span")!)!, binding: text(entry, "binding")!, resource: text(entry, "resource")!, operation: text(entry, "operation")!, span: span_of(entry.field("span")!)!}
        })!,
        callback_obligations: list(value, "callback_obligations", fn(entry: RecordValue) -> CallbackObligation RecordError! {
            CallbackObligation{bound: string_set(entry.field("bound")!)!, direct: string_set(entry.field("direct")!)!, edges: string_set(entry.field("edges")!)!, maximal: entry.field("maximal")!.as_bool()!, span: span_of(entry.field("span")!)!}
        })!,
        autodiff_obligations: list(value, "autodiff_obligations", fn(entry: RecordValue) -> AutodiffObligation RecordError! {
            AutodiffObligation{method: text(entry, "method")!, target: text(entry, "target")!, span: span_of(entry.field("span")!)!}
        })!,
        compute_calls: list(value, "compute_calls", fn(entry: RecordValue) -> ComputeCallFact RecordError! {
            ComputeCallFact{method: text(entry, "method")!, span: span_of(entry.field("span")!)!}
        })!,
        autodiff_safe_panic: flag("autodiff_safe_panic")!, autodiff_unsafe_panic: flag("autodiff_unsafe_panic")!,
        memory: MemorySummary{
            events: list(value, "memory_events", fn(entry: RecordValue) -> MemoryEvent RecordError! {
                kind_name :: entry.field("kind")!.as_str()!
                kind :: if kind_name == {
                    "alloc" -> MemoryEventKind.Allocation
                    "rc" -> MemoryEventKind.RetainRelease
                    "arena" -> MemoryEventKind.ArenaBytes{bytes: count_of(entry.field("bytes")!)!}
                    other -> throw RecordError.Malformed{message: "memory event kind `{other}`"}
                }
                MemoryEvent{kind: kind, span: span_of(entry.field("span")!)!, source: text(entry, "source")!, operation: text(entry, "operation")!, provenance: text(entry, "provenance")!, executions: count_of(entry.field("executions")!)!}
            })!,
            open_dispatches: list(value, "memory_open_dispatches", fn(entry: RecordValue) -> OpenMemoryDispatch RecordError! {
                OpenMemoryDispatch{span: span_of(entry.field("span")!)!, source: text(entry, "source")!, reason: text(entry, "reason")!}
            })!,
            regions: [], unbounded_control: list(value, "memory_unbounded_control", span_of)!,
            calls: list(value, "memory_calls", fn(entry: RecordValue) -> MemoryCall RecordError! {
                MemoryCall{callee: text(entry, "callee")!, span: span_of(entry.field("span")!)!, source: text(entry, "source")!, executions: count_of(entry.field("executions")!)!}
            })!
        },
        discarded_results: list(value, "discarded_results", fn(entry: RecordValue) -> DiscardedResultFact RecordError! {
            DiscardedResultFact{callee: text(entry, "callee")!, callee_name: text(entry, "callee_name")!, call_text: text(entry, "call_text")!, span: span_of(entry.field("span")!)!, failure_open: entry.field("failure_open")!.as_bool()!}
        })!,
        failure_direct: flag("failure_direct")!
    }
}
