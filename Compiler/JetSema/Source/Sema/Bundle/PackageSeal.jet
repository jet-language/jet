// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:49
pub const ITEMS_SCHEMA: String = "jet.items/v1"
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:50
const ITEM_SUMMARY_SCHEMA: String = "jet.item-summary/v1"
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:52
const SECTION_HEADER: U64 = U64{1}
// Rust: crates/jet-sema/src/Sema/Bundle/PackageSeal.rs:53
const SECTION_MODULES: U64 = U64{2}
