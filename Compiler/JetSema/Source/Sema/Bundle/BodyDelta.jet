impl<T: Codec> Codec for T? {
    fn put(self, writer: &Writer) Err! {
        if self == { .None -> writer.byte(U8{0}); .Val(value) -> { writer.byte(U8{1}); value.put(&writer)? } }
        Ok(())
    }
    fn get(reader: &Reader) -> Self? Never! { if reader.byte() ?? return None == { U8{0} -> Val(None); U8{1} -> Val(Val(T.get(&reader) ?? return None)); else -> None } }
}
