// GATE #4499: composite CtKey ordering/equality for ordered map encoding.
impl<K: Codec + Ord, V: Codec> Codec for [K:V] {
    fn put(self, writer: &Writer) Err! {
        writer.uint(U64{self.len()})
        keys := self.keys().to_array()
        &keys.sort()
        loop key in keys { key.put(&writer)?; self[key].put(&writer)? }
        Ok(())
    }
    fn get(reader: &Reader) -> Self? Never! {
        count :: reader.count() ?? return None
        map := [K:V]{}
        loop _ in 0..<count {
            key :: K.get(&reader) ?? return None
            value :: V.get(&reader) ?? return None
            if map.contains_key(key) -> return None
            map[^key] = ^value
        }
        Val(^map)
    }
}
