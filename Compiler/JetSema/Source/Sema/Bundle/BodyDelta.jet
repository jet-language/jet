// #2517 S3R: lossless checked-body deltas with item-relative, parser-authored spans.
// Every unlisted AST variant and nonempty uncarried sema field is refused.
use jet_foundation.[AccessConvention, ArithmeticMode, ArithmeticOperation, ArithmeticPolicyFact, BinOp, BindName, BindPattern, Binding, BinderRef, ByteTextPart, Call, CallArg, CallArgFlags, CallContractRow, CallLabel, ContextField, CtBigInt, CtFloat, CtKey, CtReport, CtValue, EffectRowEntry, EnumLitArg, Expr, ExprField, ExprMember, ExprPair, ForKind, Func, IndexKind, IntegerWidth, InternalTag, LValue, NamedSpan, OrFallback, Param, ParamZone, PatSlot, Pattern, PlaceAccess, Span, Stmt, StrFormat, StrPart, StructPatField, SwitchArm, TagMarker, TryConvert, TupleField, Type, TypeTupleField, TypedLitBody, UnOp, UnitFormat]

