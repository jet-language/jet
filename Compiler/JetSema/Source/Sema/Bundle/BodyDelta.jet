        }
        Ok(())
    }
    fn get(r: &Reader) -> Self? Never! {
        Val(if r.byte() ?? return None == {
            U8{0} -> Self.Int
            U8{1} -> Self.Float
            U8{2} -> Self.Bool
            U8{3} -> Self.String
            U8{4} -> Self.Char
            U8{5} -> Self.List(Type.get(&r) ?? return None)
            U8{6} -> Self.Map(Type.get(&r) ?? return None, Span?.get(&r) ?? return None, Type.get(&r) ?? return None)
            U8{7} -> Self.Shared(Type.get(&r) ?? return None)
            U8{8} -> Self.Option(Type.get(&r) ?? return None)
            U8{9} -> Self.Result(Type.get(&r) ?? return None, Type.get(&r) ?? return None)
            U8{10} -> Self.Fn([Type].get(&r) ?? return None, Type?.get(&r) ?? return None, [EffectRowEntry]?.get(&r) ?? return None, [CallContractRow]?.get(&r) ?? return None, None, None)
            U8{11} -> Self.Named(String.get(&r) ?? return None)
            U8{12} -> Self.Apply(String.get(&r) ?? return None, [Type].get(&r) ?? return None)
            U8{13} -> Self.TraitObject([String].get(&r) ?? return None)
            U8{14} -> Self.Tuple([TypeTupleField].get(&r) ?? return None)
            U8{15} -> Self.IntN(Bool.get(&r) ?? return None, Int{U8.get(&r) ?? return None})
            U8{16} -> Self.InlineRange(Type.get(&r) ?? return None, Int.get(&r) ?? return None, Int.get(&r) ?? return None)
            U8{17} -> Self.Float32
            U8{18} -> Self.Tagged(TagMarker.get(&r) ?? return None, Type.get(&r) ?? return None)
            U8{19} -> Self.Union([Type].get(&r) ?? return None)
            else -> return None
        })
    }
}
