            .Float(value) -> { w.byte(U8{1}); value.put(&w)? }
            .Bool(value) -> { w.byte(U8{2}); value.put(&w)? }
            .Char(value) -> { w.byte(U8{3}); value.put(&w)? }
            .Str(value) -> { w.byte(U8{4}); value.put(&w)? }
            .BigInt(value) -> { w.byte(U8{5}); CtBigInt.put(value, &w)? }
            .Bytes(value) -> { w.byte(U8{6}); value.put(&w)? }
            .List(values) -> { w.byte(U8{7}); values.put(&w)? }
            .Map(entries) -> { w.byte(U8{8}); [CtKey:CtValue].put(entries, &w)? }
            .Struct(type_name, fields) -> { w.byte(U8{9}); type_name.put(&w)?; fields.put(&w)? }
            .Enum(type_name, variant, args) -> { w.byte(U8{10}); type_name.put(&w)?; variant.put(&w)?; args.put(&w)? }
            .Present(value) -> { w.byte(U8{11}); value.put(&w)? }
            .Failed(report) -> { w.byte(U8{12}); report.put(&w)? }
            .Unit -> w.byte(U8{13})
            else -> return Err("unsupported CtValue node")
        }
        Ok(())
    }
    fn get(r: &Reader) -> Self? Never! { Val(if r.byte() ?? return None == {
        U8{0} -> Self.Int(Int.get(&r) ?? return None)
        U8{1} -> Self.Float(CtFloat.get(&r) ?? return None)
        U8{2} -> Self.Bool(Bool.get(&r) ?? return None)
        U8{3} -> Self.Char(Char.get(&r) ?? return None)
        U8{4} -> Self.Str(String.get(&r) ?? return None)
        U8{5} -> Self.BigInt(CtBigInt.get(&r) ?? return None)
        U8{6} -> Self.Bytes([U8].get(&r) ?? return None)
        U8{7} -> Self.List([CtValue].get(&r) ?? return None)
        U8{8} -> Self.Map([CtKey:CtValue].get(&r) ?? return None)
        U8{9} -> Self.Struct(String.get(&r) ?? return None, [jet_foundation.NamedCtValue].get(&r) ?? return None)
        U8{10} -> Self.Enum(String.get(&r) ?? return None, String.get(&r) ?? return None, [jet_foundation.CtEnumArg].get(&r) ?? return None)
        U8{11} -> Self.Present(CtValue.get(&r) ?? return None)
        U8{12} -> Self.Failed(CtReport.get(&r) ?? return None)
        U8{13} -> Self.Unit
        else -> return None
    }) }
}

