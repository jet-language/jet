            .Char -> w.byte(U8{4})
            .List(elem) -> { w.byte(U8{5}); elem.put(&w)? }
            .Map(key, key_span, value) -> { w.byte(U8{6}); key.put(&w)?; key_span.put(&w)?; value.put(&w)? }
            .Shared(inner) -> { w.byte(U8{7}); inner.put(&w)? }
            .Option(inner) -> { w.byte(U8{8}); inner.put(&w)? }
            .Result(ok, err) -> { w.byte(U8{9}); ok.put(&w)?; err.put(&w)? }
            .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> { w.byte(U8{10}); params.put(&w)?; ret.put(&w)?; effect_bound.put(&w)?; param_contract.put(&w)?; put_absent(call_metadata, "call_metadata")?; put_absent(return_view_provenance, "return_view_provenance")? }
            .Named(name) -> { w.byte(U8{11}); name.put(&w)? }
            .Apply(name, args) -> { w.byte(U8{12}); name.put(&w)?; args.put(&w)? }
            .TraitObject(names) -> { w.byte(U8{13}); names.put(&w)? }
            .Tuple(fields) -> { w.byte(U8{14}); fields.put(&w)? }
            .IntN(signed, bits) -> { w.byte(U8{15}); signed.put(&w)?; U8{bits}.put(&w)? }
            .InlineRange(base, lo, hi) -> { w.byte(U8{16}); base.put(&w)?; lo.put(&w)?; hi.put(&w)? }
            .Float32 -> w.byte(U8{17})
            .Tagged(marker, inner) -> { w.byte(U8{18}); marker.put(&w)?; inner.put(&w)? }
            .Union(members) -> { w.byte(U8{19}); members.put(&w)? }
