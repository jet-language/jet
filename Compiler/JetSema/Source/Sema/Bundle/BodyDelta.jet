            .Switch(subject, arms, else_body, span) -> { w.byte(U8{6}); subject.put(&w)?; arms.put(&w)?; else_body.put(&w)?; span.put(&w)? }
            .Break(span) -> { w.byte(U8{7}); span.put(&w)? }
            .BreakValue(value, span) -> { w.byte(U8{8}); value.put(&w)?; span.put(&w)? }
