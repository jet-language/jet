// Refusal is the String Err! rail, retaining each exact static refusal text.
// Rust: crates/jet-sema/src/Sema/Bundle/BodyDelta.rs:42
pub fn encode(pristine: Func, checked: Func) -> [U8] Err! {
    if checked.return_view_provenance != None -> return Err("view provenance")
    authored := Writer{bytes: [], start: pristine.span.start, end: pristine.span.end, spans: Spans.Collect{spans: [:]}}
    pristine.params.put(&authored)?
    pristine.return_type.put(&authored)?
    pristine.body.put(&authored)?
    spans :: if authored.spans == { .Collect(spans) | .Require(spans) -> ^spans }
    writer := Writer{bytes: [], start: checked.span.start, end: checked.span.end, spans: Spans.Require{spans: ^spans}}
    checked.params.put(&writer)?
    checked.return_type.put(&writer)?
    checked.body.put(&writer)?
    checked.reactive_upgrades.put(&writer)?
    Ok(^writer.bytes)
}
// Rust: crates/jet-sema/src/Sema/Bundle/BodyDelta.rs:75
pub fn apply(function: &Func, bytes: [U8]) -> Unit? {
    reader := Reader{bytes: bytes.view(), at: 0, start: function.span.start}
    params :: [Param].get(&reader) ?? return None
    return_type :: Type?.get(&reader) ?? return None
    body :: [Stmt].get(&reader) ?? return None
    reactive_upgrades :: [String].get(&reader) ?? return None
    if reader.at != bytes.len() -> return None
    function.params = ^params
    function.return_type = ^return_type
    function.body = ^body
    function.reactive_upgrades = ^reactive_upgrades
    Val(())
}
// Rust: crates/jet-sema/src/Sema/Bundle/BodyDelta.rs:98
pub fn encode_value(value: CtValue) -> [U8] Err! {
    writer := Writer{bytes: [], start: 1, end: 1, spans: Spans.Require{spans: [:]}}
    value.put(&writer)?
    Ok(^writer.bytes)
}
// Rust: crates/jet-sema/src/Sema/Bundle/BodyDelta.rs:113
pub fn decode_value(bytes: [U8]) -> CtValue? {
    reader := Reader{bytes: bytes.view(), at: 0, start: 1}
    value :: CtValue.get(&reader) ?? return None
    if reader.at != bytes.len() -> return None
    Val(^value)
}
