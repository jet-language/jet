// Rust: crates/jet-sema/src/Sema/Bundle/BodyDelta.rs:335-376
impl Codec for Span {
    fn put(self, writer: &Writer) Err! {
        if self.start == 0 && self.end == 0 {
            if writer.start == 0 -> return Err("ambiguous empty span")
            writer.byte(U8{0})
            return Ok(())
        }
        if self.start < writer.start || self.end < self.start || self.end > writer.end -> return Err("span outside the item")
        if writer.spans == {
            .Collect(spans) -> spans[(self.start, self.end)] = true
            .Require(spans) -> if !spans.contains_key((self.start, self.end)) -> return Err("span not authored by the item")
        }
        writer.byte(U8{1})
        writer.uint(U64{self.start - writer.start})
        writer.uint(U64{self.end - self.start})
        Ok(())
    }
    fn get(reader: &Reader) -> Span? Never! {
        if reader.byte() ?? return None == {
            U8{0} -> Val(Span{start: 0, end: 0})
            U8{1} -> {
                start :: checked_usize_add(reader.start, reader.size() ?? return None) ?? return None
                end :: checked_usize_add(start, reader.size() ?? return None) ?? return None
                Val(Span{start: start, end: end})
            }
            else -> None
        }
    }
}
