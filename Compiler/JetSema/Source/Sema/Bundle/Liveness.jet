// D-STRUCT-LIVE1=A: liveness projects the semantic name ledger, never generated code.
use jet_foundation.[Diagnostic, DiagnosticOrigin, TextEdit, Span, Func, ImportKind, Item, ProgramBundle, AppGraph, NameAlias, NameDeclaration, NameLedger, NameVisibility, StructureFact, StructureFactKind, WebPartitionMarker, GENERATED_NAME_PREFIX]
use jet_sema.Sema.[record_comptime_import_alias_uses]
use jet_sema.Sema.Bundle.[is_build_entry]
// GATE #4494: shared diagnostic origins retain source ownership.
use std.sync.[Arc]

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:14
struct LivenessCandidate {
    code: String, name: String, module: Int, span: Span, detail: String, edit: TextEdit,
    // Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:24
    fn diagnostic(self: LivenessCandidate) -> Diagnostic {
        Diagnostic.from_row(self.code, [("name", self.name)], Val(self.span)).with_edit(~self.edit)
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:29
    fn fact(self: LivenessCandidate, source: String) -> StructureFact {
        StructureFact.new(StructureFactKind.Liveness, ~self.name, ~source, self.span, "unreachable", self.detail, Val("_name"))
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:46
// GATE #4499: exact composite-key hash/equality, no text encoding.
struct LivenessIndex {
    functions: [(Int, Span):&Func],
    references: [(String, Span):[ReferenceSite]],
    modules: [String:Int],
    // Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:65
    fn new(bundle: ProgramBundle, ledger: NameLedger) -> LivenessIndex {
        functions := [(Int, Span):&Func]{}
        loop module_idx in 0..<bundle.modules.len() -> index_functions(module_idx, bundle.modules[module_idx].items, &functions)
        references := [(String, Span):[ReferenceSite]]{}
        loop ((source, start, end), reference) in ledger.references() {
            &references.entry((reference.module_path, reference.def_span)).or_default().push(ReferenceSite{source: source, start: start, end: end, kind: reference.kind})
        }
        modules := [String:Int]{}
        loop index in 0..<bundle.modules.len() -> &modules.entry(bundle.modules[index].display).or_insert(index)
        LivenessIndex{functions: ^functions, references: ^references, modules: ^modules}
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:93
    fn function(self: LivenessIndex, module: Int, name_span: Span) -> (&Func)? Never! {
        self.functions.get((module, name_span))
    }
    // Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:97
    fn references_to(self: LivenessIndex, module_path: String, def_span: Span) -> [ReferenceSite] Never! {
        self.references.get((module_path, def_span)) ?? []
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:56
struct ReferenceSite { source: String, start: Int, end: Int, kind: String }

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:107
pub fn check_liveness(bundle: ProgramBundle, ledger: &NameLedger, app_graph: AppGraph?) -> [Diagnostic] {
    candidates := [LivenessCandidate]{}
    record_materialized_comptime_alias_uses(bundle, &ledger)
    index :: LivenessIndex.new(bundle, ledger)
    collect_unused_imports(bundle, ledger, &candidates)
    collect_unused_private_functions(bundle, ledger, index, app_graph, &candidates)
    collect_unreachable_exports(bundle, ledger, index, app_graph, &candidates)
    &candidates.sort_by((a, b) -> bundle.modules[a.module].display.cmp(bundle.modules[b.module].display)
        .then(a.span.start.cmp(b.span.start)).then(a.code.cmp(b.code)).then(a.name.cmp(b.name)))
    origins := [Int:Arc<DiagnosticOrigin>]{}
    diagnostics := [Diagnostic]{}
    loop candidate in candidates {
        module :: bundle.modules[candidate.module]
        origin :: &origins.entry(candidate.module).or_insert_with(() -> Arc.new(DiagnosticOrigin.new(~module.display, module.path.to_string_lossy(), ~module.source)))
        ledger.record_structure_fact(candidate.fact(module.display))
        diagnostic := candidate.diagnostic()
        &diagnostic.set_origin(origin.clone())
        &diagnostics.push(^diagnostic)
    }
    diagnostics
}

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:156
// Reused/materialized prep values still own their original semantic import reads.
fn record_materialized_comptime_alias_uses(bundle: ProgramBundle, ledger: &NameLedger) {
    loop module_idx in 0..<bundle.modules.len() {
        module :: bundle.modules[module_idx]
        imports := [String:String]{}
        loop import in module.imports {
            path :: import.core_module_path() ?? ""
            loop binding in import.walk_bindings() -> imports[binding.local] = ~path
            imports[import.import_alias()] = path
        }
        if imports.len() == 0 -> next
        globals := [String:jet_comptime.CtValue]{}
        loop item in module.items {
            if item == .Const(constant) {
                if constant.is_comptime && constant.ct == .Val(value) -> globals[constant.name] = ~value
            }
        }
        loop item in module.items {
            if item == .Const(constant) {
                if constant.is_comptime && constant.ct.is_some() -> record_comptime_import_alias_uses(&ledger, module_idx, constant.value, imports, globals)
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:200
fn collect_unused_imports(bundle: ProgramBundle, ledger: NameLedger, candidates: &[LivenessCandidate]) {
    loop module_idx in 0..<bundle.modules.len() {
        loop import in bundle.modules[module_idx].imports {
            jet_file :: if import.kind == {
                .File(path, _) -> !path.ends_with(".h")
                _ -> false
            }
            if jet_file && !import.is_pub && !import.is_package_pub && !ignored_name(import.alias) {
                if ledger.alias(module_idx, import.alias) == .Val(alias) {
                    if alias.span.start < alias.span.end && !alias_used(ledger, alias) {
                        explicit_alias :: import.alias_span.start > import.span.start
                        span :: if explicit_alias -> alias.span else -> import.span
                        edit :: if explicit_alias -> rename_edit(span, import.alias) else -> TextEdit{span: import.span, new_text: ""}
                        &candidates.push(LivenessCandidate{code: "L0103", name: ~import.alias, module: module_idx, span: span, detail: "import is never read", edit: edit})
                    }
                }
            }
            loop binding in import.walk_bindings() {
                if binding.is_pub || binding.is_package_pub || ignored_name(binding.local) -> next
                alias :: ledger.alias(module_idx, binding.local) ?? next
                if alias.span.start >= alias.span.end || alias_used(ledger, alias) -> next
                &candidates.push(LivenessCandidate{code: "L0103", name: ~binding.local, module: module_idx, span: alias.span, detail: "import is never read", edit: rename_edit(alias.span, binding.local)})
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:274
fn collect_unused_private_functions(bundle: ProgramBundle, ledger: NameLedger, index: LivenessIndex, app_graph: AppGraph?, candidates: &[LivenessCandidate]) {
    loop declaration in ledger.declarations() {
        if declaration.visibility != NameVisibility.Private || declaration.kind != "function" || ignored_name(declaration.name) || declaration.span.start >= declaration.span.end -> next
        if function_is_root(bundle, index, declaration, app_graph) || private_function_used(bundle, ledger, index, declaration) -> next
        if bundle.modules.get(declaration.module).is_none() -> next
        name :: display_name(declaration)
        edit := rename_edit(declaration.span, name)
        if index.function(declaration.module, declaration.span) == .Val(function) {
            if removable_private_function(function) -> edit = TextEdit{span: function.span, new_text: ""}
        }
        &candidates.push(LivenessCandidate{code: "L0104", name: name, module: declaration.module, span: declaration.span, detail: "private function is never reached", edit: edit})
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:317
fn collect_unreachable_exports(bundle: ProgramBundle, ledger: NameLedger, index: LivenessIndex, app_graph: AppGraph?, candidates: &[LivenessCandidate]) {
    loop declaration in ledger.declarations() {
        if declaration.visibility != NameVisibility.Package || !export_kind(declaration.kind) || ignored_name(declaration.name) || declaration.name.contains(".") || declaration.span.start >= declaration.span.end -> next
        if function_is_root(bundle, index, declaration, app_graph) || declaration_reached_from_package(bundle, ledger, index, declaration) -> next
        if bundle.modules.get(declaration.module).is_none() -> next
        name :: display_name(declaration)
        &candidates.push(LivenessCandidate{code: "L0105", name: ~name, module: declaration.module, span: declaration.span, detail: "package export is unreachable", edit: rename_edit(declaration.span, name)})
    }
    // Source-backed package reexports only; compiler-prelude aliases are invisible.
    loop module_idx in 0..<bundle.modules.len() {
        loop import in bundle.modules[module_idx].imports {
            loop binding in import.walk_bindings() {
                if !binding.is_package_pub || ignored_name(binding.local) -> next
                alias :: ledger.alias(module_idx, binding.local) ?? next
                if alias.span.start >= alias.span.end || alias_reached_from_package(bundle, ledger, alias) -> next
                &candidates.push(LivenessCandidate{code: "L0105", name: ~binding.local, module: module_idx, span: alias.span, detail: "package re-export is unreachable", edit: rename_edit(alias.span, binding.local)})
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:386
fn ignored_name(name: String) -> Bool Never! { name.is_empty() || name.starts_with("_") || name.starts_with(GENERATED_NAME_PREFIX) }
// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:390
fn rename_edit(span: Span, name: String) -> TextEdit Never! { TextEdit{span: span, new_text: "_{name}"} }
// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:397
fn removable_private_function(function: Func) -> Bool Never! {
    function.body.is_empty() && function.meta.is_none() && function.markers.is_empty()
        && function.external_type.is_none() && function.inline_foreign.is_none()
        && function.undo.is_none() && function.web_marker.is_none()
        && function.pre.is_empty() && function.post.is_empty() && !function.compiler_generated
        && !function.is_unsafe && !function.is_pure && !function.is_reactive
        && !function.is_replayable && !function.is_job && function.every.is_none()
        && !function.is_must_use && function.kernel.is_none()
}
// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:418
fn export_kind(kind: String) -> Bool Never! {
    kind == "function" || kind == "type" || kind == "const" || kind == "trait"
        || kind == "protocol" || kind == "state" || kind == "tag" || kind == "module"
        || kind == "file_module" || kind == "extern"
}
// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:434
fn display_name(declaration: NameDeclaration) -> String Never! {
    if declaration.name.rsplit_once(".") == .Val((_, leaf)) -> return ~leaf
    ~declaration.name
}
// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:442
fn alias_used(ledger: NameLedger, alias: NameAlias) -> Bool Never! { ledger.alias_used(alias.module, alias) }

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:446
fn private_function_used(bundle: ProgramBundle, ledger: NameLedger, index: LivenessIndex, declaration: NameDeclaration) -> Bool Never! {
    target_module :: bundle.modules.get(declaration.module) ?? return false
    function_span :: index.function(declaration.module, declaration.span).map(function -> function.span)
    siblings := [String:Bool]{}
    loop sibling in ledger.namespace_siblings(declaration.module) {
        if bundle.modules.get(sibling) == .Val(module) -> siblings[module.display] = true
    }
    loop site in index.references_to(target_module.display, declaration.span) {
        if site.kind != "function" -> next
        if site.source == target_module.display {
            if !function_span.is_some_and(span -> site.start >= span.start && site.end <= span.end) -> return true
        } else { if siblings.contains_key(site.source) -> return true }
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:484
fn declaration_reached_from_package(bundle: ProgramBundle, ledger: NameLedger, index: LivenessIndex, declaration: NameDeclaration) -> Bool Never! {
    target_module :: bundle.modules.get(declaration.module) ?? return false
    target :: ledger.module(declaration.module) ?? return false
    loop site in index.references_to(target_module.display, declaration.span) {
        if index.modules.get(site.source) == .Val(source_idx) {
            if source_idx != declaration.module && ledger.module(source_idx).is_some_and(source -> source.package == target.package) -> return true
        }
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:509
fn alias_reached_from_package(bundle: ProgramBundle, ledger: NameLedger, alias: NameAlias) -> Bool Never! {
    owner :: ledger.module(alias.module) ?? return false
    loop consumer in ledger.aliases() {
        if consumer.module == alias.module || consumer.target_module != Val(alias.module) -> next
        if !consumer.target.rsplit_once(".").is_some_and(pair -> pair.1 == alias.name) -> next
        if ledger.module(consumer.module).is_some_and(module -> module.package == owner.package)
            && bundle.modules.get(consumer.module).is_some_and(module -> module.display != owner.path) -> return true
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:534
fn function_is_root(bundle: ProgramBundle, index: LivenessIndex, declaration: NameDeclaration, app_graph: AppGraph?) -> Bool Never! {
    function :: index.function(declaration.module, declaration.span) ?? return false
    if is_build_entry(function) -> return true
    if function.is_job || function.web_marker == Val(WebPartitionMarker.WasmExport) -> return true
    if declaration.module == bundle.entry && function.name == "run" -> return true
    graph :: app_graph ?? return false
    if declaration.module != bundle.entry -> return false
    graph.routes.any(route -> route.handler == function.name)
        || graph.actions.any(action -> action.handler == function.name)
        || graph.mounts.any(mount -> mount.handler == function.name)
}

// Rust: crates/jet-sema/src/Sema/Bundle/Liveness.rs:569
fn index_functions(module: Int, items: [Item], functions: &[(Int, Span):&Func]) Never! {
    loop item in items {
        if item == {
            .Func(function) -> &functions.entry((module, function.name_span)).or_insert(&function)
            .Struct(definition) -> {
                loop function in definition.methods -> &functions.entry((module, function.name_span)).or_insert(&function)
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods -> &functions.entry((module, function.name_span)).or_insert(&function)
                }
            }
            .Enum(definition) -> {
                loop function in definition.methods -> &functions.entry((module, function.name_span)).or_insert(&function)
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods -> &functions.entry((module, function.name_span)).or_insert(&function)
                }
            }
            .Impl(implementation) -> {
                loop function in implementation.methods -> &functions.entry((module, function.name_span)).or_insert(&function)
            }
            .CodeModule(code_module) -> { if code_module.body == .Val(body) -> index_functions(module, body, &functions) }
            _ -> {}
        }
    }
}
