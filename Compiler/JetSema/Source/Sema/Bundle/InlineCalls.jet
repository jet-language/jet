use jet_foundation.[ProgramBundle, Item, Stmt, ForKind, Expr, StrPart, EnumLitArg, OrFallback, LambdaBody, member_name]

// Rust: crates/jet-sema/src/Sema/Bundle/InlineCalls.rs:6
// Keep inline sibling resolution identical in registration, checking, and codegen.
pub fn mangle_inline_sibling_calls(bundle: &ProgramBundle) Never! {
    loop module_index in 0..<bundle.modules.len() {
        loop item_index in 0..<bundle.modules[module_index].items.len() {
            if bundle.modules[module_index].items[item_index] == .CodeModule(cm) {
                if cm.body == .Val(body) {
                    siblings := [String:Bool]{}
                    loop inner in body { if inner == .Func(function) -> siblings[function.name] = true }
                    if siblings.len() == 0 -> next
                    loop index in 0..<body.len() {
                        if body[index] == .Func(function) -> rewrite_inline_calls_stmts(&function.body, siblings, cm.name)
                    }
                }
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/InlineCalls.rs:30
pub fn rewrite_inline_calls_stmts(stmts: &[Stmt], siblings: [String:Bool], modname: String) Never! {
    loop index in 0..<stmts.len() {
        if stmts[index] == {
            .Expr(e) | .Yield(e, _) | .DeferClose(e, _) -> rewrite_inline_calls_expr(&e, siblings, modname)
            .Val(binding) -> rewrite_inline_calls_expr(&binding.init, siblings, modname)
            .Assign(_, value, _) -> rewrite_inline_calls_expr(&value, siblings, modname)
            .Return(.Val(e), _) | .BreakValue(e, _) | .BreakLabelValue(_, _, e, _) -> rewrite_inline_calls_expr(&e, siblings, modname)
            .Return(.None, _) | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            .While(cond, body, _) -> {
                rewrite_inline_calls_expr(&cond, siblings, modname)
                rewrite_inline_calls_stmts(&body, siblings, modname)
            }
            .For(_, kind, body, _) -> {
                if kind == {
                    .Range(start, end, step, _) -> {
                        rewrite_inline_calls_expr(&start, siblings, modname)
                        rewrite_inline_calls_expr(&end, siblings, modname)
                        if step == .Val(value) -> rewrite_inline_calls_expr(&value, siblings, modname)
                    }
                    .In(collection, step) -> {
                        rewrite_inline_calls_expr(&collection, siblings, modname)
                        if step == .Val(value) -> rewrite_inline_calls_expr(&value, siblings, modname)
                    }
                }
                rewrite_inline_calls_stmts(&body, siblings, modname)
            }
            .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
                rewrite_inline_calls_expr(&subject, siblings, modname)
                loop arm_index in 0..<arms.len() {
                    rewrite_inline_calls_expr(&arms[arm_index].cond, siblings, modname)
                    rewrite_inline_calls_stmts(&arms[arm_index].body, siblings, modname)
                }
                if else_body == .Val(body) -> rewrite_inline_calls_stmts(&body, siblings, modname)
            }
            .CountedLoop(init, cond, _, inner, _) -> {
                rewrite_inline_calls_expr(&init.init, siblings, modname)
                rewrite_inline_calls_expr(&cond, siblings, modname)
                rewrite_inline_calls_stmts(&inner, siblings, modname)
            }
            .Loop(inner, _) | .Unsafe(inner, _) | .Impure(inner, _) | .Reactive(inner, _)
            | .Shield(inner, _) | .Switched(inner, _) | .Region(inner, _)
            | .Policy(_, inner, _) | .TaskGroup(_, inner, _) | .Layout(_, inner, _)
            | .AuthorityScope(_, inner, _) | .Transact(inner, _) | .AssumeDet(inner, _)
            | .ComptimeBlock(inner, _) | .Live(_, inner, _) | .ScopeMember(_, inner, _) -> rewrite_inline_calls_stmts(&inner, siblings, modname)
            // D-WHEN1: visit both arms, independent of comptime selection.
            .ComptimeIf(cond, then_body, else_body, _) -> {
                rewrite_inline_calls_expr(&cond, siblings, modname)
                rewrite_inline_calls_stmts(&then_body, siblings, modname)
                if else_body == .Val(body) -> rewrite_inline_calls_stmts(&body, siblings, modname)
            }
            .ContextBlock(fields, body, _) -> {
                loop field_index in 0..<fields.len() -> rewrite_inline_calls_expr(&fields[field_index].1, siblings, modname)
                rewrite_inline_calls_stmts(&body, siblings, modname)
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/InlineCalls.rs:159
pub fn rewrite_inline_calls_expr(expr: &Expr, siblings: [String:Bool], modname: String) Never! {
    if expr == {
        .Call(call) -> {
            if siblings.contains_key(call.name) -> call.name = member_name(modname, call.name)
            loop index in 0..<call.args.len() -> rewrite_inline_calls_expr(&call.args[index].expr, siblings, modname)
        }
        .PtrFromAddr(addr, _) -> rewrite_inline_calls_expr(&addr, siblings, modname)
        .Ident(name, _) -> { if siblings.contains_key(name) -> name = ~modname }
        .Char(..) | .Int(..) | .Float(..) | .Bool(..) | .Unit(_)
        | .Absent(_) | .ReduceMarker(..) | .Todo(..) | .NoElse(_) | .UnitLit(..)
        | .ComptimeName(..) | .StrMatchLit(..) | .BinMatchLit(..) -> {}
        .Str(parts, _) -> {
            loop index in 0..<parts.len() {
                if parts[index] == .Interp(value, _) -> rewrite_inline_calls_expr(&value, siblings, modname)
            }
        }
        .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _)
        | .Place(inner, _, _) | .Field(inner, _, _) | .Tainted(inner, _, _)
        | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _)
        | .Paren(inner, _) | .Spread(inner, _) -> rewrite_inline_calls_expr(&inner, siblings, modname)
        .Try(inner, _, _, note) -> {
            rewrite_inline_calls_expr(&inner, siblings, modname)
            if note == .Val(value) -> rewrite_inline_calls_expr(&value, siblings, modname)
        }
        .OptField(base, _, _) | .MemberSpread(base, _) -> rewrite_inline_calls_expr(&base, siblings, modname)
        .Range(start, end, _, _) -> {
            rewrite_inline_calls_expr(&start, siblings, modname)
            rewrite_inline_calls_expr(&end, siblings, modname)
        }
        .MethodCall(receiver, _, args, ..) -> {
            rewrite_inline_calls_expr(&receiver, siblings, modname)
            loop index in 0..<args.len() -> rewrite_inline_calls_expr(&args[index].expr, siblings, modname)
        }
        .StructLit(_, fields, ..) -> {
            loop index in 0..<fields.len() -> rewrite_inline_calls_expr(&fields[index].2, siblings, modname)
        }
        .TypedLit(_, body, _) -> body.for_each_expr_mut(value -> rewrite_inline_calls_expr(&value, siblings, modname))
        .EnumLit(_, _, args, ..) -> {
            loop index in 0..<args.len() {
                if args[index] == {
                    .Positional(value) | .Named(_, _, value) -> rewrite_inline_calls_expr(&value, siblings, modname)
                }
            }
        }
        .OrFallback(value, fallback, _) -> {
            rewrite_inline_calls_expr(&value, siblings, modname)
            if fallback == {
                .Value(inner) | .Return(.Val(inner), _) -> rewrite_inline_calls_expr(&inner, siblings, modname)
                .Block(body, inner, _) -> {
                    rewrite_inline_calls_stmts(&body, siblings, modname)
                    if inner == .Val(value) -> rewrite_inline_calls_expr(&value, siblings, modname)
                }
                .Return(.None, _) | .Panic(..) | .Break(_) | .Continue(_)
                | .BreakLabel(..) | .ContinueLabel(..) -> {}
            }
        }
        .PatternTest(subject, ..) -> rewrite_inline_calls_expr(&subject, siblings, modname)
        .Binary(_, left, right, _) -> {
            rewrite_inline_calls_expr(&left, siblings, modname)
            rewrite_inline_calls_expr(&right, siblings, modname)
        }
        .CompareChain(operands, _, _) | .ListLit(operands, _) -> {
            loop index in 0..<operands.len() -> rewrite_inline_calls_expr(&operands[index], siblings, modname)
        }
        .TupleLit(fields, _, _) -> {
            loop index in 0..<fields.len() -> rewrite_inline_calls_expr(&fields[index].1, siblings, modname)
        }
        .MapLit(entries, _) -> {
            loop index in 0..<entries.len() {
                rewrite_inline_calls_expr(&entries[index].0, siblings, modname)
                rewrite_inline_calls_expr(&entries[index].1, siblings, modname)
            }
        }
        .Index(base, index, _) -> {
            rewrite_inline_calls_expr(&base, siblings, modname)
            rewrite_inline_calls_expr(&index, siblings, modname)
        }
        .Slice(base, start, end, range, _) -> {
            rewrite_inline_calls_expr(&base, siblings, modname)
            if range == .Val(value) { rewrite_inline_calls_expr(&value, siblings, modname) }
            else {
                rewrite_inline_calls_expr(&start, siblings, modname)
                rewrite_inline_calls_expr(&end, siblings, modname)
            }
        }
        .CallValue(callee, args, _) -> {
            rewrite_inline_calls_expr(&callee, siblings, modname)
            loop index in 0..<args.len() -> rewrite_inline_calls_expr(&args[index].expr, siblings, modname)
        }
        .Lambda(lambda) -> if lambda.body == {
            .Expr(value) -> rewrite_inline_calls_expr(&value, siblings, modname)
            .Block(body) -> rewrite_inline_calls_stmts(&body, siblings, modname)
        }
        .If(cond, then_body, then_value, else_body, else_value, _) -> {
            rewrite_inline_calls_expr(&cond, siblings, modname)
            rewrite_inline_calls_stmts(&then_body, siblings, modname)
            rewrite_inline_calls_expr(&then_value, siblings, modname)
            rewrite_inline_calls_stmts(&else_body, siblings, modname)
            rewrite_inline_calls_expr(&else_value, siblings, modname)
        }
    }
}
