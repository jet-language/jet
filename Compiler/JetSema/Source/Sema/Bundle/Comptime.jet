// Compile-time evaluation detection over the bundle AST.
use jet_foundation.[DeriveBodyItem, EnumLitArg, Expr, ForKind, Func, Item, LambdaBody, OrFallback, Pattern, ProgramBundle, Stmt, StrPart, StructPatField]

// Rust: crates/jet-sema/src/Sema/Bundle/Comptime.rs:11
pub fn bundle_has_comptime_evaluation(bundle: ProgramBundle) -> Bool Never! {
    loop module in bundle.modules {
        loop item in module.items { if item_has_comptime_evaluation(item) -> return true }
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Bundle/Comptime.rs:19
pub fn item_has_comptime_evaluation(item: Item) -> Bool Never! {
    function :: (value: Func) -> stmts_have_comptime_evaluation(value.body)
    if item == {
        .Func(value) -> function(value)
        .Struct(value) -> {
            if value.methods.any(function) -> return true
            loop implementation in value.trait_impls { if implementation.methods.any(function) -> return true }
            false
        }
        .Enum(value) -> {
            if value.methods.any(function) -> return true
            loop implementation in value.trait_impls { if implementation.methods.any(function) -> return true }
            false
        }
        .Trait(value) -> {
            loop method in value.methods {
                if method.default_body == .Val(body) { if stmts_have_comptime_evaluation(body) -> return true }
            }
            false
        }
        .Impl(value) -> value.methods.any(function)
        .Const(value) -> value.is_comptime
        .Test(value) -> stmts_have_comptime_evaluation(value.body)
        .CodeModule(value) -> {
            if value.body == .Val(body) -> return body.any(item_has_comptime_evaluation)
            false
        }
        .ErrorConv(value) -> stmts_have_comptime_evaluation(value.body)
        .UserDerive(value) -> derive_body_has_comptime_evaluation(value.body)
        // D-STRUCT-ONCE1=A: root loops are compile-time templates.
        .TemplateLoop(value) -> expr_has_comptime_evaluation(value.source) || derive_body_has_comptime_evaluation(value.body)
        .GenericModule(value) -> value.body.any(item_has_comptime_evaluation)
        _ -> false
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Comptime.rs:64
fn derive_body_has_comptime_evaluation(body: [DeriveBodyItem]) -> Bool Never! {
    loop item in body {
        hit :: if item == {
            .Item(value) -> item_has_comptime_evaluation(value)
            .Stmt(stmt) -> stmt_has_comptime_evaluation(stmt)
            .Loop(source, inner, _) -> expr_has_comptime_evaluation(source) || derive_body_has_comptime_evaluation(inner)
        }
        if hit -> return true
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Bundle/Comptime.rs:74
pub fn stmts_have_comptime_evaluation(stmts: [Stmt]) -> Bool Never! {
    stmts.any(stmt_has_comptime_evaluation)
}
// Single borrowed statement avoids constructing a one-element AST array.
fn stmt_has_comptime_evaluation(stmt: Stmt) -> Bool Never! {
    if stmt == {
        .Expr(value) | .Yield(value, _) | .DeferClose(value, _) -> expr_has_comptime_evaluation(value)
        .Val(binding) -> binding.is_comptime || expr_has_comptime_evaluation(binding.init)
        .Assign(_, value, _) -> expr_has_comptime_evaluation(value)
        .Return(.Val(value), _) | .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> expr_has_comptime_evaluation(value)
        .Return(.None, _) -> false
        .While(cond, body, _) -> expr_has_comptime_evaluation(cond) || stmts_have_comptime_evaluation(body)
        .For(_, kind, body, _) -> {
            iterable :: if kind == {
                .Range(start, end, step, _) -> expr_has_comptime_evaluation(start) || expr_has_comptime_evaluation(end) || step.is_some_and(expr_has_comptime_evaluation)
                .In(collection, step) -> expr_has_comptime_evaluation(collection) || step.is_some_and(expr_has_comptime_evaluation)
            }
            iterable || stmts_have_comptime_evaluation(body)
        }
        .Switch(subject, arms, else_body, _) -> {
            expr_has_comptime_evaluation(subject)
                || arms.any(arm -> expr_has_comptime_evaluation(arm.cond) || stmts_have_comptime_evaluation(arm.body))
                || else_body.is_some_and(stmts_have_comptime_evaluation)
        }
        .CountedLoop(init, cond, step, body, _) -> {
            init.is_comptime || expr_has_comptime_evaluation(init.init)
                || expr_has_comptime_evaluation(cond)
                || step.is_some_and(stmt_has_comptime_evaluation)
                || stmts_have_comptime_evaluation(body)
        }
        .Loop(body, _) | .Unsafe(body, _) | .Impure(body, _) | .Reactive(body, _)
        | .Shield(body, _) | .Switched(body, _) | .Region(body, _) | .Policy(_, body, _)
        | .TaskGroup(_, body, _) | .Layout(_, body, _) | .AuthorityScope(_, body, _)
        | .Transact(body, _) | .AssumeDet(body, _) | .Live(_, body, _)
        | .ScopeMember(_, body, _) -> stmts_have_comptime_evaluation(body)
        .ContextBlock(fields, body, _) -> fields.any(field -> expr_has_comptime_evaluation(field.1)) || stmts_have_comptime_evaluation(body)
        .ComptimeIf(..) | .ComptimeSwitch(..) | .ComptimeBlock(..) -> true
        .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> false
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Comptime.rs:166
fn expr_has_comptime_evaluation(expr: Expr) -> Bool Never! {
    argument :: arg -> expr_has_comptime_evaluation(arg.expr)
    if expr == {
        .Str(parts, _) -> parts.any(part -> if part == {
            .Interp(value, _) -> expr_has_comptime_evaluation(value)
            .Lit(_) -> false
        })
        .ListLit(values, _) -> values.any(expr_has_comptime_evaluation)
        .MemberSpread(base, _) -> expr_has_comptime_evaluation(base)
        .Spread(value, _) | .Unary(_, value, _) | .Deref(value, _)
        | .RawOf(value, _) | .Copy(value, _) | .Place(value, _, _)
        | .Field(value, _, _) | .Tainted(value, _, _) | .Present(value, _)
        | .Ok(value, _) | .Err(value, _) | .Paren(value, _)
        | .PtrFromAddr(value, _) -> expr_has_comptime_evaluation(value)
        .Try(value, _, _, note) -> expr_has_comptime_evaluation(value) || note.is_some_and(expr_has_comptime_evaluation)
        .MapLit(entries, _) -> entries.any(entry -> expr_has_comptime_evaluation(entry.0) || expr_has_comptime_evaluation(entry.1))
        .Index(base, index, _) -> expr_has_comptime_evaluation(base) || expr_has_comptime_evaluation(index)
        .Slice(base, start, end, range, _) -> {
            expr_has_comptime_evaluation(base) || if range == {
                .Val(value) -> expr_has_comptime_evaluation(value)
                .None -> expr_has_comptime_evaluation(start) || expr_has_comptime_evaluation(end)
            }
        }
        .Range(start, end, _, _) -> expr_has_comptime_evaluation(start) || expr_has_comptime_evaluation(end)
        .Call(call) -> call.args.any(argument)
        .Binary(_, left, right, _) -> expr_has_comptime_evaluation(left) || expr_has_comptime_evaluation(right)
        .CompareChain(operands, _, _) -> operands.any(expr_has_comptime_evaluation)
        .OptField(base, _, _) -> expr_has_comptime_evaluation(base)
        .MethodCall(receiver, _, args, ..) -> expr_has_comptime_evaluation(receiver) || args.any(argument)
        .StructLit(_, fields, ..) -> fields.any(field -> expr_has_comptime_evaluation(field.2))
        .TypedLit(_, body, _) -> {
            hit := false
            body.for_each_expr(value -> { if expr_has_comptime_evaluation(value) -> hit = true })
            hit
        }
        .EnumLit(_, _, args, ..) -> args.any(arg -> if arg == {
            .Positional(value) | .Named(_, _, value) -> expr_has_comptime_evaluation(value)
        })
        .PatternTest(subject, pattern, ..) -> {
            expr_has_comptime_evaluation(subject) || if pattern == {
                .Struct(_, fields, ..) -> fields.any(field -> if field == {
                    .Value(_, value, _) -> expr_has_comptime_evaluation(value)
                    .Bind(..) -> false
                })
                _ -> false
            }
        }
        .OrFallback(value, fallback, _) -> {
            expr_has_comptime_evaluation(value) || if fallback == {
                .Value(inner) | .Return(.Val(inner), _) -> expr_has_comptime_evaluation(inner)
                .Block(body, inner, _) -> stmts_have_comptime_evaluation(body) || inner.is_some_and(expr_has_comptime_evaluation)
                _ -> false
            }
        }
        .If(cond, then_body, then_value, else_body, else_value, _) -> {
            expr_has_comptime_evaluation(cond) || stmts_have_comptime_evaluation(then_body)
                || expr_has_comptime_evaluation(then_value) || stmts_have_comptime_evaluation(else_body)
                || expr_has_comptime_evaluation(else_value)
        }
        .TupleLit(fields, _, _) -> fields.any(field -> expr_has_comptime_evaluation(field.1))
        .Lambda(lambda) -> if lambda.body == {
            .Expr(value) -> expr_has_comptime_evaluation(value)
            .Block(body) -> stmts_have_comptime_evaluation(body)
        }
        .CallValue(callee, args, _) -> expr_has_comptime_evaluation(callee) || args.any(argument)
        .ComptimeName(..) -> true
        .Int(..) | .Float(..) | .Bool(..) | .Unit(..) | .Char(..)
        | .StrMatchLit(..) | .BinMatchLit(..) | .Ident(..) | .UnitLit(..)
        | .Absent(_) | .Todo(..) | .NoElse(_) | .ReduceMarker(..) -> false
    }
}
