// Core symbol reachability plus compiler-owned source/intrinsic closure.
use jet_foundation.[Diagnostic, Span, ExternFn, Func, Param, TraitMethodSig, Type, Item, ProgramBundle, Stmt, ForKind, LValue, Expr, StrPart, VariantPayload, Field, TraitImplBlock, TagMarker, InternalTag, EnumLitArg, OrFallback, LambdaBody, CtValue, expr_span, readiness_head]
use jet_foundation.CoreModuleExports.[core_source_module, core_type_modules]
use jet_foundation.RingLayer.[expand_prelude_closure, classify_prelude_closure]
use jet_syntax as Syntax
use jet_sema.Sema.[TypeRegistry, ModuleState]
use jet_sema.Sema.CheckerCoreLib.[is_geometry_type, core_module_type_item]
use jet_sema.Sema.Expressions02.is_math_type
use jet_sema.Sema.Calls.Data02.is_json_type_name
use jet_sema.Sema.Bundle.Validation.module_annotations_mention_encoding_surface

// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:10
CORE_SOURCE_MARKER_PREFIX :: "__core_source::"
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:11
CORE_INTRINSIC_MARKER_PREFIX :: "__core_intrinsic::"
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:12
CORE_MATH_TYPES_USAGE :: "core.math::__mathtypes__"
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:14
fn is_core_closure_marker(usage: String) -> Bool {
    usage.starts_with(CORE_SOURCE_MARKER_PREFIX) || usage.starts_with(CORE_INTRINSIC_MARKER_PREFIX)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:22
fn has_core_source_package(module: String) -> Bool { core_source_module(module) != None }
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:30
fn expand_core_reachable_closure(used: &[String:Bool]) {
    direct :: used.keys().filter(fn(usage) { !is_core_closure_marker(usage) }).collect()
    loop usage in direct {
        (module, helper) :: if usage.split_once("::") == .Val(pair) -> (pair.0, Val(pair.1)) else -> (usage, None)
        if has_core_source_package(module) {
            used["{CORE_SOURCE_MARKER_PREFIX}{module}"] = true
            if helper == .Val(h) { if !h.is_empty() -> used["{CORE_SOURCE_MARKER_PREFIX}{usage}"] = true }
        }
        intrinsic :: if module == "core.archive" -> "archive.abi" else -> module
        used["{CORE_INTRINSIC_MARKER_PREFIX}{intrinsic}"] = true
        if helper == .Val(h) { if !h.is_empty() -> used["{CORE_INTRINSIC_MARKER_PREFIX}{intrinsic}::{h}"] = true }
    }
    // Idempotent complete emitted Prelude closure, including late generated roots.
    expand_prelude_closure(&used)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:69
fn collect_used_core(bundle: ProgramBundle, states: [ModuleState]) -> ([String:Bool], [String:Span], [String:Bool]) {
    used := [String:Bool]{}
    spans := [String:Span]{}
    if states.any(fn(state) { state.exact_int_reachable.get() }) -> used["core.math::__exact_int__"] = true
    ffi_cb := [String:Bool]{}
    loop (idx, module) in bundle.modules {
        imports :: states[idx].core_imports
        registry :: states[idx].registry
        if module_annotations_mention_encoding_surface(module) -> used["core.encoding::types"] = true
        module_imports := imports.clone()
        loop ((scope, name), (core_module, core_item)) in states[idx].inline_reexport_core -> module_imports["{scope}.{name}"] = "{core_module}::{core_item}"
        loop item in module.items {
            if item == {
                .Func(f) -> collect_core_func(f, module_imports, registry, &used, &spans, &ffi_cb)
                .Struct(s) -> {
                    loop field in s.fields -> collect_core_field(field, module_imports, registry, &used, &spans, &ffi_cb)
                    loop method in s.methods -> collect_core_func(method, module_imports, registry, &used, &spans, &ffi_cb)
                    loop block in s.trait_impls -> collect_core_trait_impl(block, module_imports, registry, &used, &spans, &ffi_cb)
                    collect_core_stmts(s.validate_block, module_imports, registry, &used, &spans, &ffi_cb)
                    loop binding in s.cli_bindings -> collect_core_expr(binding.target, module_imports, registry, &used, &spans, &ffi_cb)
                }
                .Enum(e) -> {
                    loop variant in e.variants {
                        if variant.payload == {
                            .Single(ty, span) -> collect_core_type_usage(ty, registry, &used, &spans, Val(span))
                            .Named(fields) -> { loop field in fields -> collect_core_type_usage(field.ty, registry, &used, &spans, Val(field.ty_span)) }
                            .Unit -> {}
                        }
                        if variant.discriminant_expr == .Val(expression) -> collect_core_expr(expression, module_imports, registry, &used, &spans, &ffi_cb)
                    }
                    loop method in e.methods -> collect_core_func(method, module_imports, registry, &used, &spans, &ffi_cb)
                    loop block in e.trait_impls -> collect_core_trait_impl(block, module_imports, registry, &used, &spans, &ffi_cb)
                }
                .Impl(i) -> {
                    loop method in i.methods -> collect_core_func(method, module_imports, registry, &used, &spans, &ffi_cb)
                    loop (_, span, ty) in i.assoc_type_impls -> collect_core_type_usage(ty, registry, &used, &spans, Val(span))
                }
                .Test(t) -> {
                    collect_core_params(t.params, module_imports, registry, &used, &spans, &ffi_cb)
                    collect_core_stmts(t.body, module_imports, registry, &used, &spans, &ffi_cb)
                }
                .Const(c) -> {
                    if c.ty == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, Val(c.name_span))
                    collect_core_expr(c.value, module_imports, registry, &used, &spans, &ffi_cb)
                }
                .Trait(t) -> { loop method in t.methods -> collect_core_trait_method(method, module_imports, registry, &used, &spans, &ffi_cb) }
                .ExternRust(block) -> { loop function in block.functions -> collect_core_extern_fn(function, module_imports, registry, &used, &spans, &ffi_cb) }
                .Distinct(d) -> collect_core_type_usage(d.base, registry, &used, &spans, Val(d.base_span))
                .ErrorConv(d) -> collect_core_stmts(d.body, module_imports, registry, &used, &spans, &ffi_cb)
                .CodeModule(cm) -> {
                    body :: cm.body ?? next
                    scoped_imports := module_imports.clone()
                    loop ((scope, name), core_module) in states[idx].inline_core_imports {
                        if scope == cm.name -> scoped_imports[name] = core_module
                    }
                    loop ((scope, name), (core_module, core_item)) in states[idx].inline_reexport_core {
                        if scope == cm.name -> scoped_imports["{scope}.{name}"] = "{core_module}::{core_item}"
                    }
                    loop inner in body {
                        if inner == {
                            .Func(f) -> collect_core_func(f, scoped_imports, registry, &used, &spans, &ffi_cb)
                            .Struct(s) -> {
                                loop field in s.fields -> collect_core_field(field, scoped_imports, registry, &used, &spans, &ffi_cb)
                                loop method in s.methods -> collect_core_func(method, scoped_imports, registry, &used, &spans, &ffi_cb)
                                loop block in s.trait_impls -> collect_core_trait_impl(block, scoped_imports, registry, &used, &spans, &ffi_cb)
                            }
                            .Enum(e) -> {
                                loop variant in e.variants {
                                    if variant.payload == {
                                        .Single(ty, span) -> collect_core_type_usage(ty, registry, &used, &spans, Val(span))
                                        .Named(fields) -> { loop field in fields -> collect_core_type_usage(field.ty, registry, &used, &spans, Val(field.ty_span)) }
                                        .Unit -> {}
                                    }
                                }
                                loop method in e.methods -> collect_core_func(method, scoped_imports, registry, &used, &spans, &ffi_cb)
                                loop block in e.trait_impls -> collect_core_trait_impl(block, scoped_imports, registry, &used, &spans, &ffi_cb)
                            }
                            .Impl(i) -> {
                                loop method in i.methods -> collect_core_func(method, scoped_imports, registry, &used, &spans, &ffi_cb)
                                loop (_, span, ty) in i.assoc_type_impls -> collect_core_type_usage(ty, registry, &used, &spans, Val(span))
                            }
                            .Trait(t) -> { loop method in t.methods -> collect_core_trait_method(method, scoped_imports, registry, &used, &spans, &ffi_cb) }
                            .Distinct(d) -> collect_core_type_usage(d.base, registry, &used, &spans, Val(d.base_span))
                            .Const(c) -> {
                                if c.ty == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, Val(c.name_span))
                                collect_core_expr(c.value, scoped_imports, registry, &used, &spans, &ffi_cb)
                            }
                            else -> {}
                        }
                    }
                }
                // Expanded or erased declarations carry no runtime Core use.
                .EffectDecl(_) | .MarkerDecl(_) | .FactDecl(_) | .Tag(_) | .Module(_)
                | .TypeAlias(_) | .UnitFamily(_) | .CModule(_) | .Migration(_)
                | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) -> {}
            }
        }
    }
    expand_core_reachable_closure(&used)
    (used, spans, ffi_cb)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:517
fn check_ui_capabilities(bundle: ProgramBundle, used_core: [String:Bool], usage_spans: [String:Span]) -> [Diagnostic] {
    diagnostics := [Diagnostic][]
    declared :: bundle.package_guarantees.authority_needs
    loop (usage, _) in used_core {
        (module, member) :: usage.split_once("::") ?? next
        row :: Syntax.core_call(module, member) ?? next
        loop capability in row.ui_capabilities() {
            if declared.contains(capability) -> next
            service :: "{module}.{member}"
            &diagnostics.push(Diagnostic.from_row("E2937", [("capability", capability), ("service", service)], usage_spans.get(usage)))
        }
    }
    diagnostics
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:547
fn note_core_usage(used: &[String:Bool], spans: &[String:Span], key: String, span: Span?) {
    used[key] = true
    if span == .Val(s) { if !spans.has_key(key) -> spans[key] = s }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:560
fn note_builtin_math_type(name: String, registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], span: Span?) {
    if !registry.contains(name) && (is_math_type(name) || is_geometry_type(name)) -> note_core_usage(&used, &spans, CORE_MATH_TYPES_USAGE, span)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:576
fn collect_core_params(params: [Param], imports: [String:String], registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], ffi_cb: &[String:Bool]) {
    loop param in params {
        collect_core_type_usage(param.ty, registry, &used, &spans, Val(param.ty_span))
        if param.default == .Val(value) -> collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:592
fn collect_core_func_signature(function: Func, imports: [String:String], registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], ffi_cb: &[String:Bool]) {
    if function.markers.any(fn(marker) { marker.name == Syntax.MARKER_SCALAR }) -> note_core_usage(&used, &spans, CORE_MATH_TYPES_USAGE, Val(function.name_span))
    collect_core_params(function.params, imports, registry, &used, &spans, &ffi_cb)
    if function.return_type == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, function.return_type_span.or(Val(function.name_span)))
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:621
fn collect_core_func(function: Func, imports: [String:String], registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], ffi_cb: &[String:Bool]) {
    collect_core_func_signature(function, imports, registry, &used, &spans, &ffi_cb)
    collect_core_stmts(function.body, imports, registry, &used, &spans, &ffi_cb)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:633
fn collect_core_trait_method(method: TraitMethodSig, imports: [String:String], registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], ffi_cb: &[String:Bool]) {
    collect_core_params(method.params, imports, registry, &used, &spans, &ffi_cb)
    if method.return_type == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, Val(method.name_span))
    if method.default_body == .Val(body) -> collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:650
fn collect_core_extern_fn(function: ExternFn, imports: [String:String], registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], ffi_cb: &[String:Bool]) {
    collect_core_params(function.params, imports, registry, &used, &spans, &ffi_cb)
    if function.return_type == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, function.return_type_span.or(Val(function.name_span)))
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:670
fn collect_core_field(field: Field, imports: [String:String], registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], ffi_cb: &[String:Bool]) {
    collect_core_type_usage(field.ty, registry, &used, &spans, Val(field.ty_span))
    if field.computed == .Val(value) -> collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
    if field.default == .Val(value) -> collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:687
fn collect_core_trait_impl(trait_impl: TraitImplBlock, imports: [String:String], registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], ffi_cb: &[String:Bool]) {
    loop method in trait_impl.methods -> collect_core_func(method, imports, registry, &used, &spans, &ffi_cb)
    loop (_, span, ty) in trait_impl.assoc_type_impls -> collect_core_type_usage(ty, registry, &used, &spans, Val(span))
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:702
fn note_core_type_modules(name: String, registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], span: Span?) {
    if registry.contains(name) -> return
    loop module in core_type_modules(name) -> note_core_usage(&used, &spans, "{module}::__type__", span)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:718
fn collect_core_type_usage(ty: Type, registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], span: Span?) {
    if ty == {
        .Named(name) | .Apply(name, _) -> note_core_type_modules(name, registry, &used, &spans, span)
        else -> {}
    }
    if ty == {
        .Named(name) -> {
            if !registry.contains(name) && (is_math_type(name) || is_geometry_type(name)) -> note_core_usage(&used, &spans, CORE_MATH_TYPES_USAGE, span)
            else if ["Secret", "SigningKey", "X25519SecretKey", "SharedSecret"].contains(name.rsplit('.').next() ?? "") -> note_core_usage(&used, &spans, "core.crypto::__nominal__", span)
        }
        .Apply(name, args) -> {
            if !registry.contains(name) && is_geometry_type(name) -> note_core_usage(&used, &spans, CORE_MATH_TYPES_USAGE, span)
            else if name == "Atomic" || name.ends_with(".Atomic") -> note_core_usage(&used, &spans, "core.mem::atomic", span)
            loop arg in args -> collect_core_type_usage(arg, registry, &used, &spans, span)
        }
        .Tagged(marker, inner) -> {
            if marker == TagMarker.Internal(InternalTag.CoreCryptoNominal) -> note_core_usage(&used, &spans, "core.crypto::__nominal__", span)
            collect_core_type_usage(inner, registry, &used, &spans, span)
        }
        .List(inner) | .Option(inner) | .Shared(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) -> collect_core_type_usage(inner, registry, &used, &spans, span)
        .Map(key, _, value) | .Result(key, value) -> {
            collect_core_type_usage(key, registry, &used, &spans, span)
            collect_core_type_usage(value, registry, &used, &spans, span)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params -> collect_core_type_usage(param, registry, &used, &spans, span)
            if ret == .Val(value) -> collect_core_type_usage(value, registry, &used, &spans, span)
        }
        .Tuple(fields) -> { loop field in fields -> collect_core_type_usage(field.ty, registry, &used, &spans, span) }
        .Union(args) -> { loop arg in args -> collect_core_type_usage(arg, registry, &used, &spans, span) }
        .Quantity(base, _) -> collect_core_type_usage(base, registry, &used, &spans, span)
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:813
fn note_typed_head_core_usage(used: &[String:Bool], spans: &[String:Span], name: String, span: Span?) {
    if name == Syntax.TYPE_REGEX { note_core_usage(&used, &spans, "core.regex::literal", span); return }
    kind :: Syntax.typed_head_kind(name) ?? return
    if !kind.is_boundary() -> return
    module :: kind.core_owner_module() ?? return
    note_core_usage(&used, &spans, "{module}::typed_head", span)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:838
fn is_http_nominal_type(name: String) -> Bool {
    ["HTTPMethod", "HTTPStatus", "HTTPVersion", "HTTPHeaderName", "HTTPHeaderValue", "Headers", "Body"].contains(name)
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:853
fn apply_helper_layer_inference(bundle: &ProgramBundle, states: [ModuleState], usage_spans: [String:Span], diags: &[Diagnostic]) {
    core_imports := [String:String]{}
    loop st in states { loop (alias, module) in st.core_imports -> core_imports[alias] = module }
    closure :: classify_prelude_closure(bundle.used_core.keys())
    loop (usage, required) in closure {
        if required > bundle.inferred_layer -> bundle.inferred_layer = required
        ceiling :: bundle.layer_ceiling ?? next
        if required <= ceiling -> next
        chain :: helper_import_chain(usage, core_imports)
        &diags.push(Syntax.layer_ceiling_exceeded(usage, required, ceiling, usage_spans.get(usage), Val(chain)))
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:886
fn helper_import_chain(usage: String, core_imports: [String:String]) -> String {
    if usage == "core.term::input" -> return "ambient `input()` (helper `{usage}`)"
    if usage.split_once("::") == .Val(pair) {
        loop (alias, imported) in core_imports {
            if imported == pair.0 -> return "`use {imported} as {alias}` → `{usage}`"
        }
    }
    "prelude helper `{usage}`"
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:899
fn collect_core_stmts(stmts: [Stmt], imports: [String:String], registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], ffi_cb: &[String:Bool]) {
    loop stmt in stmts {
        if stmt == {
            .Expr(e) | .Yield(e, _) | .DeferClose(e, _) -> collect_core_expr(e, imports, registry, &used, &spans, &ffi_cb)
            .Val(b) -> {
                if b.ty == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, b.ty_span)
                collect_core_expr(b.init, imports, registry, &used, &spans, &ffi_cb)
            }
            .Assign(target, _, _, value) -> {
                collect_core_lvalue(target, imports, registry, &used, &spans, &ffi_cb)
                collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
            }
            .Return(.Val(e), _) | .BreakValue(e, _) | .BreakLabelValue(_, _, e, _) -> collect_core_expr(e, imports, registry, &used, &spans, &ffi_cb)
            .Return(None, _) -> {}
            .While(cond, body, ..) -> {
                collect_core_expr(cond, imports, registry, &used, &spans, &ffi_cb)
                collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
            }
            .For(_, _, _, kind, body, ..) -> {
                if kind == {
                    .Range(start, end, step, _) -> {
                        collect_core_expr(start, imports, registry, &used, &spans, &ffi_cb)
                        collect_core_expr(end, imports, registry, &used, &spans, &ffi_cb)
                        if step == .Val(value) -> collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
                    }
                    .In(collection, step) -> {
                        collect_core_expr(collection, imports, registry, &used, &spans, &ffi_cb)
                        if step == .Val(value) -> collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
                    }
                }
                collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
            }
            .Switch(subject, arms, else_body, span) | .ComptimeSwitch(subject, arms, else_body, span) -> {
                if arms.any(fn(arm) { readiness_head(arm.cond) != None }) -> note_core_usage(&used, &spans, "core.concurrency::select", Val(span))
                collect_core_expr(subject, imports, registry, &used, &spans, &ffi_cb)
                loop arm in arms {
                    collect_core_expr(arm.cond, imports, registry, &used, &spans, &ffi_cb)
                    collect_core_stmts(arm.body, imports, registry, &used, &spans, &ffi_cb)
                }
                if else_body == .Val(body) -> collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
            }
            .CountedLoop(init, cond, step, body, ..) -> {
                if init.ty == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, init.ty_span)
                collect_core_expr(init.init, imports, registry, &used, &spans, &ffi_cb)
                collect_core_expr(cond, imports, registry, &used, &spans, &ffi_cb)
                collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
                if step == .Val(value) -> collect_core_stmts([value], imports, registry, &used, &spans, &ffi_cb)
            }
            .TaskGroup(_, _, _, body, span) -> {
                note_core_usage(&used, &spans, "core.concurrency::task", Val(span))
                collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
            }
            .Loop(body, ..) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _)
            | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _)
            | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _)
            | .Transact(_, _, body, _, _) | .AssumeDet(_, _, body, _)
            | .ComptimeBlock(body, _, _) | .ScopeMember(_, _, _, _, body, ..) -> collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
            .Shield(body, span) -> {
                note_core_usage(&used, &spans, "core.concurrency::shield", Val(span))
                collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
            }
            .Reactive(body, span) -> {
                note_core_usage(&used, &spans, "core.reactive", Val(span))
                collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
            }
            .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            .ComptimeIf(cond, _, then_body, else_body, ..) -> {
                collect_core_expr(cond, imports, registry, &used, &spans, &ffi_cb)
                collect_core_stmts(then_body, imports, registry, &used, &spans, &ffi_cb)
                if else_body == .Val(body) -> collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
            }
            .ContextBlock(fields, body, _) -> {
                loop field in fields -> collect_core_expr(field.value, imports, registry, &used, &spans, &ffi_cb)
                collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
            }
            .Live(body, span) -> {
                note_core_usage(&used, &spans, "core.term", Val(span))
                collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
            }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:1084
fn collect_core_lvalue(lv: LValue, imports: [String:String], registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], ffi_cb: &[String:Bool]) {
    if lv == {
        .Local(..) -> {}
        .Index(base, index, ..) -> {
            collect_core_expr(base, imports, registry, &used, &spans, &ffi_cb)
            collect_core_expr(index, imports, registry, &used, &spans, &ffi_cb)
        }
        .Field(base, ..) -> collect_core_expr(base, imports, registry, &used, &spans, &ffi_cb)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/Validation/CoreUsage.rs:1105
fn collect_core_expr(expr: Expr, imports: [String:String], registry: TypeRegistry, used: &[String:Bool], spans: &[String:Span], ffi_cb: &[String:Bool]) {
    // Typed call facts are collected before recursively walking values.
    if expr == {
        .Call(c) -> {
            note_builtin_math_type(c.name, registry, &used, &spans, Val(c.name_span))
            if [Syntax.TYPE_DECIMAL, Syntax.TYPE_FRACTION, Syntax.TYPE_COMPLEX].contains(c.name) -> note_core_usage(&used, &spans, "core.math::__precise__", Val(c.name_span))
            loop ty in c.type_args -> collect_core_type_usage(ty, registry, &used, &spans, Val(c.name_span))
            if c.resolved_ret == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, Val(c.name_span))
        }
        .MethodCall(receiver, _, method_span, owner_type_args, type_args, _, _, resolved_ret, _, _) -> {
            if receiver == .Ident(n, _) {
                note_builtin_math_type(n, registry, &used, &spans, Val(method_span))
                if n == "Path" -> note_core_usage(&used, &spans, "core.files::__pathapi__", Val(method_span))
            }
            loop ty in owner_type_args -> collect_core_type_usage(ty, registry, &used, &spans, Val(method_span))
            loop ty in type_args -> collect_core_type_usage(ty, registry, &used, &spans, Val(method_span))
            if resolved_ret == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, Val(method_span))
        }
        else -> {}
    }
    if expr == {
        .PtrFromAddr(_, _, elem, addr, span) -> {
            collect_core_type_usage(elem, registry, &used, &spans, Val(span))
            collect_core_expr(addr, imports, registry, &used, &spans, &ffi_cb)
        }
        .MethodCall(receiver, method, method_span, _, _, args, recv_type, _, _, _) -> {
            if receiver == .Ident(n, _) {
                if n == Syntax.INTERNAL_TASK_RECEIVER -> note_core_usage(&used, &spans, "core.concurrency::task", Val(method_span))
            }
            if recv_type == Val(Syntax.INTERNAL_TASK_SURFACE_TYPE) || recv_type == Val(Syntax.INTERNAL_TASK_GROUP_SURFACE_TYPE) -> note_core_usage(&used, &spans, "core.concurrency::task", Val(method_span))
            if recv_type == .Val(t) -> note_builtin_math_type(t, registry, &used, &spans, Val(method_span))
            if (recv_type == Val("Float") || recv_type == Val("F32")) && ["is_nan", "is_infinite", "is_finite"].contains(method) -> note_core_usage(&used, &spans, "core.math::__scalar_predicates__", Val(method_span))
            if ["trim_start", "trim_end", "pad_start", "pad_end", "is_alphabetic", "is_numeric", "is_whitespace", "is_ascii", "to_title", "is_lower", "is_upper", "capitalize", "swapcase", "normalize", "last_index_of", "remove_prefix", "remove_suffix"].contains(method) -> note_core_usage(&used, &spans, "core.text::__string_surface__", Val(method_span))
            if recv_type == .Val(t) {
                if [Syntax.TYPE_DECIMAL, Syntax.TYPE_FRACTION, Syntax.TYPE_COMPLEX].contains(t) -> note_core_usage(&used, &spans, "core.math::__precise__", Val(method_span))
                if ["Secret", "SigningKey", "VerifyKey", "X25519SecretKey", "X25519PublicKey", "SharedSecret", "Signature", "Sealed", "WrappedKey", "Digest256", "Digest512", "PasswordHash"].contains(t) -> note_core_usage(&used, &spans, "core.crypto::__nominal__.{method}", Val(method_span))
            }
            http_nominal := false
            duration := recv_type == Val(Syntax.DURATION_TYPE)
            if recv_type == .Val(t) -> http_nominal = is_http_nominal_type(t)
            if receiver == .Ident(n, _) {
                http_nominal = http_nominal || is_http_nominal_type(n)
                duration = duration || n == Syntax.DURATION_TYPE
                if method == "cmd" && (n.is_empty() || n == "UIShortcut") -> note_core_usage(&used, &spans, "core.ui.host::shortcut", Val(method_span))
            }
            if http_nominal -> note_core_usage(&used, &spans, "core.http::__nominal__", Val(method_span))
            if duration -> note_core_usage(&used, &spans, "core.time::__duration__", Val(method_span))
            if recv_type == Val(Syntax.SOLVER_TYPE) -> note_core_usage(&used, &spans, "{Syntax.CORE_SOLVE_MODULE}::{method}", Val(method_span))
            if ["bytes", "from_bytes", "elapsed_millis"].contains(method) -> note_core_usage(&used, &spans, "core::{method}", Val(method_span))
            if receiver == .Ident(alias, _) {
                if imports.get("{alias}.{method}") == .Val(imported) {
                    if imported.split_once("::") == .Val(pair) -> note_core_usage(&used, &spans, "{pair.0}::{pair.1}", Val(method_span))
                } else if imports.get(alias) == .Val(module) -> note_core_usage(&used, &spans, "{module}::{method}", Val(method_span))
            }
            if receiver == .Field(base, leaf, _) {
                if base == .Ident(alias, _) {
                    if imports.get(alias) == .Val(ns) {
                        submodule :: "{ns}.{leaf}"
                        if Syntax.is_known_core_module(submodule) -> note_core_usage(&used, &spans, "{submodule}::{method}", Val(method_span))
                        else if core_module_type_item(ns, leaf) -> note_core_usage(&used, &spans, "{ns}::{leaf}.{method}", Val(method_span))
                    }
                }
            }
            collect_core_expr(receiver, imports, registry, &used, &spans, &ffi_cb)
            loop arg in args {
                if arg.flags.c_callback_function_key == .Val(key) -> ffi_cb[key] = true
                collect_core_expr(arg.expr, imports, registry, &used, &spans, &ffi_cb)
            }
        }
        .Call(c) -> {
            if c.name == Syntax.BUILTIN_INPUT -> note_core_usage(&used, &spans, "core.term::input", Val(c.name_span))
            if c.name == "measurement" {
                if c.resolved_ret == .Val(.Apply(name, args)) {
                    if name == Syntax.TYPE_MEASUREMENT && args == [Type.Float] -> note_core_usage(&used, &spans, "core.units::from", Val(c.name_span))
                }
            }
            note_typed_head_core_usage(&used, &spans, c.name, Val(c.name_span))
            lone_literal := false
            if c.args.len() == 1 { if c.args[0].expr == .Str(..) -> lone_literal = true }
            if c.name == Syntax.BUILTIN_PRINT && !lone_literal -> note_core_usage(&used, &spans, "core.text.fmt::interpolation", Val(c.name_span))
            loop arg in c.args {
                if arg.flags.c_callback_function_key == .Val(key) -> ffi_cb[key] = true
                collect_core_expr(arg.expr, imports, registry, &used, &spans, &ffi_cb)
            }
        }
        .CallValue(callee, args, _) -> {
            collect_core_expr(callee, imports, registry, &used, &spans, &ffi_cb)
            loop arg in args -> collect_core_expr(arg.expr, imports, registry, &used, &spans, &ffi_cb)
        }
        .Field(inner, member, span) -> {
            if inner == .Ident(alias, _) {
                if imports.get(alias) == Val("core.math") && member == "pi" -> note_core_usage(&used, &spans, "core.math::pi", Val(span))
                if is_json_type_name(alias) && member == "Null" -> note_core_usage(&used, &spans, "core::json", Val(span))
            }
            collect_core_expr(inner, imports, registry, &used, &spans, &ffi_cb)
        }
        .OptField(base, ..) -> collect_core_expr(base, imports, registry, &used, &spans, &ffi_cb)
        .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _)
        | .Place(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _)
        | .Paren(inner, _) | .Spread(inner, _) | .MemberSpread(inner, _, _) -> collect_core_expr(inner, imports, registry, &used, &spans, &ffi_cb)
        .Try(inner, _, _, note) -> {
            collect_core_expr(inner, imports, registry, &used, &spans, &ffi_cb)
            if note == .Val(value) -> collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
        }
        .Binary(_, lhs, rhs, _) | .Index(lhs, rhs, _, _) -> {
            collect_core_expr(lhs, imports, registry, &used, &spans, &ffi_cb)
            collect_core_expr(rhs, imports, registry, &used, &spans, &ffi_cb)
        }
        .CompareChain(operands, ..) -> { loop value in operands -> collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb) }
        .Slice(base, start, end, range, _) -> {
            collect_core_expr(base, imports, registry, &used, &spans, &ffi_cb)
            if range == .Val(value) -> collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
            else {
                collect_core_expr(start, imports, registry, &used, &spans, &ffi_cb)
                collect_core_expr(end, imports, registry, &used, &spans, &ffi_cb)
            }
        }
        .Range(start, end, _, _) -> {
            collect_core_expr(start, imports, registry, &used, &spans, &ffi_cb)
            collect_core_expr(end, imports, registry, &used, &spans, &ffi_cb)
        }
        .Str(parts, _) -> {
            loop part in parts {
                if part == .Interp(value, _) {
                    note_core_usage(&used, &spans, "core.text.fmt::interpolation", Val(expr_span(value)))
                    collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
                }
            }
        }
        .ListLit(items, _) -> { loop value in items -> collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb) }
        .TupleLit(fields, span, ty) -> {
            if ty == .Val(t) -> collect_core_type_usage(t, registry, &used, &spans, Val(span))
            loop field in fields -> collect_core_expr(field.value, imports, registry, &used, &spans, &ffi_cb)
        }
        .MapLit(items, _) -> {
            loop pair in items {
                collect_core_expr(pair.key, imports, registry, &used, &spans, &ffi_cb)
                collect_core_expr(pair.value, imports, registry, &used, &spans, &ffi_cb)
            }
        }
        .StructLit(type_name, type_args, _, _, fields, _, span) -> {
            note_builtin_math_type(type_name, registry, &used, &spans, Val(span))
            loop ty in type_args -> collect_core_type_usage(ty, registry, &used, &spans, Val(span))
            loop field in fields -> collect_core_expr(field.value, imports, registry, &used, &spans, &ffi_cb)
        }
        .TypedLit(head, body, span) -> {
            if head == .Val(ty) {
                collect_core_type_usage(ty, registry, &used, &spans, Val(span))
                if ty == .Named(name) -> note_typed_head_core_usage(&used, &spans, name, Val(span))
            }
            body.for_each_expr(fn(value) { collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb) })
        }
        .EnumLit(_, _, _, args, _, _) -> {
            loop arg in args {
                if arg == {
                    .Positional(value) | .Named(_, value) -> collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
                }
            }
        }
        .PatternTest(subject, ..) -> collect_core_expr(subject, imports, registry, &used, &spans, &ffi_cb)
        .OrFallback(value, fallback, _, _) -> {
            collect_core_expr(value, imports, registry, &used, &spans, &ffi_cb)
            if fallback == {
                .Value(e) -> collect_core_expr(e, imports, registry, &used, &spans, &ffi_cb)
                .Block(body, value, _) -> {
                    collect_core_stmts(body, imports, registry, &used, &spans, &ffi_cb)
                    if value == .Val(e) -> collect_core_expr(e, imports, registry, &used, &spans, &ffi_cb)
                }
                .Return(.Val(e), _) -> collect_core_expr(e, imports, registry, &used, &spans, &ffi_cb)
                .Return(None, _) -> {}
                .Panic(args, _) -> { loop arg in args -> collect_core_expr(arg.expr, imports, registry, &used, &spans, &ffi_cb) }
                .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            }
        }
        .Lambda(lam) -> {
            loop param in lam.params { if param.ty == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, param.ty_span) }
            if lam.result_type == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, Val(lam.span))
            if lam.error_type == .Val(ty) -> collect_core_type_usage(ty, registry, &used, &spans, Val(lam.span))
            if lam.body == {
                .Expr(e) -> collect_core_expr(e, imports, registry, &used, &spans, &ffi_cb)
                .Block(stmts) -> collect_core_stmts(stmts, imports, registry, &used, &spans, &ffi_cb)
            }
        }
        .If(cond, then_body, then_value, else_body, else_value, _) -> {
            collect_core_expr(cond, imports, registry, &used, &spans, &ffi_cb)
            collect_core_stmts(then_body, imports, registry, &used, &spans, &ffi_cb)
            collect_core_expr(then_value, imports, registry, &used, &spans, &ffi_cb)
            collect_core_stmts(else_body, imports, registry, &used, &spans, &ffi_cb)
            collect_core_expr(else_value, imports, registry, &used, &spans, &ffi_cb)
        }
        .ComptimeName(_, span, value) -> {
            if value == .Val(.Struct(type_name, ..)) {
                if type_name == Syntax.TYPE_MEASUREMENT -> note_core_usage(&used, &spans, "core.units::from", Val(span))
            }
        }
        .Int(..) | .Float(..) | .Bool(..) | .Unit(_) | .Char(..) | .Ident(..)
        | .Absent(_) | .ReduceMarker(..) | .Todo(..) | .NoElse(_) | .UnitLit(..)
        | .StrMatchLit(..) | .BinMatchLit(..) -> {}
    }
}
