//RS pub(crate) fn collect_core_expr(
//RS     expr: &Expr,
//RS     imports: &HashMap<String, String>,
//RS     registry: &TypeRegistry,
//RS     used: &mut HashSet<String>,
//RS     spans: &mut HashMap<String, crate::Diagnostics::Span>,
//RS     ffi_cb: &mut HashSet<String>,
//RS ) {
//RS     // D-SIMD2 / D-LINALG1: a built-in math type used anywhere (constructor,
//RS     // static method, or instance method on an inferred math-typed receiver)
//RS     // pulls in the CoreLib prelude that defines the `jet_math_*` helpers.
//RS     // A constructor and static `T.method(...)` surface the type NAME; an
//RS     // instance receiver can instead be a local or field, so use its inferred
//RS     // `recv_type` below.
//RS     match expr {
//RS         Expr::Call(c) => {
//RS             note_builtin_math_type(&c.name, registry, used, spans, Some(c.name_span));
//RS             if matches!(
//RS                 c.name.as_str(),
//RS                 crate::Syntax::TYPE_DECIMAL
//RS                     | crate::Syntax::TYPE_FRACTION
//RS                     | crate::Syntax::TYPE_COMPLEX
//RS             ) {
//RS                 note_core_usage(used, spans, "core.math::__precise__", Some(c.name_span));
//RS             }
//RS             for ty in &c.type_args {
//RS                 collect_core_type_usage(ty, registry, used, spans, Some(c.name_span));
//RS             }
//RS             if let Some(return_type) = &c.resolved_ret {
//RS                 collect_core_type_usage(return_type, registry, used, spans, Some(c.name_span));
//RS             }
//RS         }
//RS         Expr::MethodCall {
//RS             receiver,
//RS             method_span,
//RS             owner_type_args,
//RS             type_args,
//RS             resolved_ret,
//RS             ..
//RS         } => {
//RS             if let Expr::Ident(n, _) = receiver.as_ref() {
//RS                 note_builtin_math_type(n, registry, used, spans, Some(*method_span));
//RS                 // D-PATHFS1: `Path.from(...)` or any Path static call triggers path prelude.
//RS                 if n == "Path" {
//RS                     note_core_usage(used, spans, "core.files::__pathapi__", Some(*method_span));
//RS                 }
//RS             }
//RS             for ty in owner_type_args.iter().chain(type_args.iter()) {
//RS                 collect_core_type_usage(ty, registry, used, spans, Some(*method_span));
//RS             }
//RS             if let Some(return_type) = resolved_ret {
//RS                 collect_core_type_usage(return_type, registry, used, spans, Some(*method_span));
//RS             }
//RS         }
//RS         _ => {}
//RS     }
//RS     match expr {
//RS         Expr::PtrFromAddr { elem, addr, span, .. } => {
//RS             collect_core_type_usage(elem, registry, used, spans, Some(*span));
//RS             collect_core_expr(addr, imports, registry, used, spans, ffi_cb);
//RS         }
//RS         Expr::MethodCall {
//RS             receiver,
//RS             method,
//RS             method_span,
//RS             args,
//RS             recv_type,
//RS             ..
//RS         } => {
//RS             // D-CONC-SPAWN1=D: bare `task expr`/`task.all|race|any { … }` parse
//RS             // into a method call on the parser-private `INTERNAL_TASK_RECEIVER`
//RS             // ident (set before sema ever runs), so this is available even
//RS             // though `recv_type` isn't filled in until inference. Needs the
//RS             // same embedded `jet_std` runtime as `task.group` above, with no
//RS             // `use core.X` import required.
//RS             if matches!(receiver.as_ref(), Expr::Ident(n, _) if n == crate::Syntax::INTERNAL_TASK_RECEIVER)
//RS             {
//RS                 note_core_usage(used, spans, "core.concurrency::task", Some(*method_span));
//RS             }
//RS             // D-CONC-SPAWN1=D: `task`/`task.all`/`task.race`/`task.any`
//RS             // are compiler-owned syntax, not Core imports. Sema records their
//RS             // private dispatch type so this late reachability walk can pull in
//RS             // the scheduler kernel without relying on source spelling.
