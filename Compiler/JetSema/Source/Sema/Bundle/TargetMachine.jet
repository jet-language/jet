// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:17
// Expand the same Prelude graph as sema, including generated hardware roots.
pub fn target_machine_use(bundle: ProgramBundle) -> TargetMachineUse Never! {
    used_core := bundle.used_core.clone()
    hardware :: target_hardware_use(bundle)
    if !hardware.register_accesses.is_empty() || !hardware.interrupt_handlers.is_empty() || !hardware.dma_operations.is_empty() || !hardware.unresolved_references.is_empty() {
        _ :: used_core.insert("core.hardware")
    }
    closure :: classify_prelude_closure(used_core.iter())
    usage := TargetMachineUse.from_core_apis(closure.keys())
    usage.core_apis = closure.keys().collect()
    ^usage
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:37
pub fn target_hardware_profile(bundle: ProgramBundle) -> TargetHardwareFacts? Never! {
    selected :: selected_hardware_profile(bundle) ?? return None
    Val(selected.1)
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:42
pub fn target_hardware_profile_id(bundle: ProgramBundle) -> String? Never! {
    selected :: selected_hardware_profile(bundle) ?? return None
    Val(selected.0)
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:47
pub fn target_hardware_capabilities(bundle: ProgramBundle) -> [String] Never! {
    selected :: selected_hardware_profile(bundle) ?? return [String]{}
    facts :: selected.1
    capabilities := [String]{}
    loop block in facts.register_blocks {
        loop register in block.registers { capabilities.push("register.{block.name}.{register.name}") }
    }
    loop interrupt in facts.interrupts { capabilities.push("interrupt.{interrupt.name}") }
    loop channel in facts.dma_channels { capabilities.push("dma.{channel.name}") }
    ^capabilities
}
