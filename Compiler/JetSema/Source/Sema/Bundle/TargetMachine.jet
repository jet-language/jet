// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:84
fn selected_hardware_profile(bundle: ProgramBundle) -> (String, TargetHardwareFacts)? Never! {
    entry :: bundle.modules.get(bundle.entry) ?? return None
    loop (_, import) in walk_imports(entry) {
        if target_profile_path(import) == .Val(profile) {
            if hardware_facts_for_profile(profile) == .Val(facts) -> return Val((profile, facts))
        }
    }
    if entry.default_target == .Val(profile) {
        if hardware_facts_for_profile(profile) == .Val(facts) -> return Val((profile, facts))
    }
    None
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:101
fn hardware_facts_for_profile(profile: String) -> TargetHardwareFacts? Never! {
    if profile == {
        "board.sensor_v1" -> Val(TargetMachine.board_sensor_v1().hardware)
        "board.virt_aarch64" -> Val(TargetMachine.board_virt_aarch64().hardware)
        _ -> None
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:109
fn project_target_hardware(bundle: ProgramBundle, effect_facts: SemIndexEffectFacts?) -> TargetHardwareUse Never! {
    hardware := TargetHardwareUse.default()
    loop module in bundle.modules {
        aliases :: profile_aliases(module)
        alias_keys := aliases.keys().collect()
        alias_keys.sort()
        profile_facts := None as TargetHardwareFacts?
        loop key in alias_keys {
            if hardware_facts_for_profile(aliases[key]) == .Val(facts) { profile_facts = Val(facts); break }
        }
        loop item in module.items {
            if item == {
                .Func(function) -> project_function(function, module.alias, aliases, profile_facts, effect_facts, &hardware)
                .Struct(definition) -> {
                    loop function in definition.methods { project_function(function, module.alias, aliases, profile_facts, effect_facts, &hardware) }
                    loop implementation in definition.trait_impls {
                        loop function in implementation.methods { project_function(function, module.alias, aliases, profile_facts, effect_facts, &hardware) }
                    }
                }
                .Enum(definition) -> {
                    loop function in definition.methods { project_function(function, module.alias, aliases, profile_facts, effect_facts, &hardware) }
                    loop implementation in definition.trait_impls {
                        loop function in implementation.methods { project_function(function, module.alias, aliases, profile_facts, effect_facts, &hardware) }
                    }
                }
                .Impl(implementation) -> {
                    loop function in implementation.methods { project_function(function, module.alias, aliases, profile_facts, effect_facts, &hardware) }
                }
                _ -> {}
            }
        }
    }
    hardware.unresolved_references.sort()
    hardware.unresolved_references.dedup()
    ^hardware
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:198
fn profile_aliases(module: LoadedModule) -> [String:String] Never! {
    aliases := [String:String]{}
    loop (_, import) in walk_imports(module) {
        if target_profile_path(import) == .Val(profile) { aliases[import.import_alias()] = profile }
    }
    ^aliases
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:207
fn project_function(function: Func, module_alias: String, aliases: [String:String], profile_facts: TargetHardwareFacts?, effect_facts: SemIndexEffectFacts?, hardware: &TargetHardwareUse) Never! {
    loop marker in function.markers {
        if marker.name != MARKER_INTERRUPT -> continue
        argument :: marker.expr_arg(0) ?? continue
        interrupt :: interrupt_name(argument, aliases, profile_facts, &hardware.unresolved_references) ?? continue
        effects := declared_or_direct_effects(function, module_alias, effect_facts)
        handler := TargetInterruptHandlerFact.new(interrupt, function.name.clone(), ^effects, true)
        handler.forbidden_effects = marker_effect_row(marker)
        hardware.interrupt_handlers.push(^handler)
    }
    transfers := [String:(String, String)]{}
    in_flight := [String:String]{}
    loop statement in function.body {
        moved := [String:Bool]{}
        statement.for_each_expr(fn(expr: Expr) Never! {
            if dma_start(expr, aliases, profile_facts, &hardware.unresolved_references) == .Val(start) {
                if start.2 == AccessConvention.Move { moved[start.1] = true }
            }
        })
        if statement == .Val(binding) {
            if dma_start(binding.init, aliases, profile_facts, &hardware.unresolved_references) == .Val(start) {
                if !binding.name.is_empty() { transfers[binding.name.clone()] = (start.0, start.1) }
            }
        }
        statement.for_each_expr(fn(expr: Expr) Never! {
            project_hardware_expr(expr, aliases, profile_facts, moved, &transfers, &in_flight, hardware)
        })
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:290
fn declared_or_direct_effects(function: Func, module_alias: String, effect_facts: SemIndexEffectFacts?) -> EffectSet Never! {
    effects := EffectSet.new()
    if function.declared_effects == .Val(declared) {
        loop (effect, _) in declared { _ :: effects.insert(effect.clone()) }
    }
    loop statement in function.body {
        statement.for_each_expr(fn(expr: Expr) Never! { collect_direct_effect(expr, &effects) })
    }
    if effect_facts == .Val(facts) {
        qualified :: "{module_alias}::{function.name}"
        solved :: facts.solved.get(qualified).or_else(fn() -> EffectSet? Never! { facts.solved.get(function.name) })
        if solved == .Val(row) { loop effect in row { _ :: effects.insert(effect.clone()) } }
    }
    ^effects
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:311
fn collect_direct_effect(expr: Expr, effects: &EffectSet) Never! {
    if expr == {
        .Call(call) -> {
            if call.name == {
                "alloc" | "try_alloc" -> { _ :: effects.insert("Mem.Alloc") }
                "wait" -> { _ :: effects.insert("Time.Wait") }
                "sleep" -> { _ :: effects.insert("Time.Sleep") }
                _ -> {}
            }
        }
        .MethodCall(_, method, ..) -> {
            if method == "alloc" || method == "try_alloc" { _ :: effects.insert("Mem.Alloc") }
            else if method == "wait" { _ :: effects.insert("Time.Wait") }
            else if method == "sleep" { _ :: effects.insert("Time.Sleep") }
        }
        _ -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:341
fn marker_effect_row(marker: Marker) -> EffectSet Never! {
    effects := EffectSet.new()
    argument :: marker.args.get(1) ?? return ^effects
    if argument == .EffectRow(row, ..) {
        loop (effect, _) in row {
            name := effect.trim_start_matches('!') // #4303
            _ :: effects.insert(name.to_string())
        }
    }
    ^effects
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:355
fn project_hardware_expr(expr: Expr, aliases: [String:String], profile_facts: TargetHardwareFacts?, moved: [String:Bool], transfers: &[String:(String, String)], in_flight: &[String:String], hardware: &TargetHardwareUse) Never! {
    if expr == {
        .Ident(name, _) -> {
            if in_flight.contains_key(name) && !moved.contains_key(name) {
                hardware.dma_operations.push(TargetDmaOperationFact.use_buffer(name.clone()))
            }
        }
        .MethodCall(receiver, method, _, _, _, args, ..) -> {
            if dma_start(expr, aliases, profile_facts, &hardware.unresolved_references) == .Val(start) {
                (channel, buffer, convention) :: start
                operation := TargetDmaOperationFact.start(channel.clone(), buffer.clone())
                if convention != AccessConvention.Move { operation.owner = TargetDmaOwner.Device }
                hardware.dma_operations.push(^operation)
                in_flight[buffer] = channel
                return
            }
            if method == "wait" {
                if receiver == .Ident(transfer, _) {
                    if transfers.get(transfer) == .Val(active) {
                        (channel, buffer) :: active
                        hardware.dma_operations.push(TargetDmaOperationFact.wait(channel.clone(), buffer.clone()))
                        _ :: in_flight.remove(buffer)
                        return
                    }
                }
            }
            if expr_path(receiver) == .Val(path) {
                if register_for_path(path, aliases, profile_facts, &hardware.unresolved_references) == .Val(register_fact) {
                    (block, register, width) :: register_fact
                    if method == {
                        "read" -> hardware.register_accesses.push(TargetRegisterAccessFact.read(block, register, width))
                        "write" | "set" | "clear" -> hardware.register_accesses.push(TargetRegisterAccessFact.write(block, register, width))
                        _ -> {}
                    }
                }
            }
            // The ordinary recursive visitor owns nested arguments. Only moved
            // arguments are exempted at the statement level.
            _ :: args
        }
        _ -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:431
fn dma_start(expr: Expr, aliases: [String:String], profile_facts: TargetHardwareFacts?, unresolved: &[TargetHardwareUnresolvedReference]) -> (String, String, AccessConvention)? Never! {
    if expr == .MethodCall(receiver, method, _, _, _, args, ..) {
        if method != "start" || args.len() < 2 -> return None
        if receiver == { .Ident(name, _) -> { if name != "dma" -> return None } _ -> return None }
        channel_path :: expr_path(args[0].expr) ?? return None
        channel :: channel_for_path(channel_path, aliases, profile_facts, unresolved) ?? return None
        buffer :: expr_name(args[1].expr) ?? return None
        return Val((channel, buffer, args[1].convention))
    }
    None
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:458
fn channel_for_path(path: [String], aliases: [String:String], profile_facts: TargetHardwareFacts?, unresolved: &[TargetHardwareUnresolvedReference]) -> String? Never! {
    if path.len() < 3 || !aliases.contains_key(path[0]) -> return None
    requested :: "{path[1].to_ascii_uppercase()}_{path[2].to_ascii_uppercase()}"
    if profile_facts == .Val(facts) {
        loop channel in facts.dma_channels {
            if channel.name.eq_ignore_ascii_case(requested) -> return Val(channel.name.clone())
        }
    }
    unresolved.push(TargetHardwareUnresolvedReference.DmaChannel{channel: requested})
    None
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:487
fn interrupt_name(expr: Expr, aliases: [String:String], profile_facts: TargetHardwareFacts?, unresolved: &[TargetHardwareUnresolvedReference]) -> String? Never! {
    path :: expr_path(expr) ?? return None
    if path.len() < 2 || !aliases.contains_key(path[0]) -> return None
    requested :: (path.last() ?? return None).clone()
    if profile_facts == .Val(facts) {
        loop interrupt in facts.interrupts {
            if interrupt.name.eq_ignore_ascii_case(requested) -> return Val(interrupt.name.clone())
        }
    }
    unresolved.push(TargetHardwareUnresolvedReference.Interrupt{interrupt: requested})
    None
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:517
fn register_for_path(path: [String], aliases: [String:String], profile_facts: TargetHardwareFacts?, unresolved: &[TargetHardwareUnresolvedReference]) -> (String, String, RegisterWidth)? Never! {
    if path.len() < 3 || !aliases.contains_key(path[0]) -> return None
    requested_block :: path[1].to_ascii_uppercase()
    requested_register :: path[2]
    if profile_facts == .Val(facts) {
        loop block in facts.register_blocks {
            if !block.name.eq_ignore_ascii_case(requested_block) -> continue
            if block.register(requested_register) == .Val(register) -> return Val((block.name.clone(), register.name.clone(), register.width))
            loop register in block.registers {
                if register.name.eq_ignore_ascii_case(requested_register) -> return Val((block.name.clone(), register.name.clone(), register.width))
            }
            unresolved.push(TargetHardwareUnresolvedReference.Register{block: block.name.clone(), register: requested_register.clone()})
            return None
        }
    }
    unresolved.push(TargetHardwareUnresolvedReference.RegisterBlock{block: requested_block})
    None
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:562
fn expr_path(expr: Expr) -> [String]? Never! {
    if expr == {
        .Ident(name, _) -> Val([String]{name.clone()})
        .Field(base, member, _) -> {
            path := expr_path(base) ?? return None
            path.push(member.clone())
            Val(^path)
        }
        .Paren(inner, _) -> expr_path(inner)
        _ -> None
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:575
fn expr_name(expr: Expr) -> String? Never! {
    if expr == { .Ident(name, _) -> Val(name.clone()) .Paren(inner, _) -> expr_name(inner) _ -> None }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:586
pub fn check_target_machine(machine: TargetMachine, usage: TargetMachineUse) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    loop error in machine.validate(usage) { diagnostics.push(diagnostic_for_error(machine, error)) }
    ^diagnostics
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:602
pub fn validate_target_hardware(machine: TargetMachine, hardware: TargetHardwareUse) -> [Diagnostic] Never! {
    errors := machine.validate_hardware(hardware)
    validate_interrupt_handlers(machine, hardware, &errors)
    validate_dma_operations(machine, hardware, &errors)
    diagnostics := [Diagnostic]{}
    loop error in errors { diagnostics.push(diagnostic_for_error(machine, error)) }
    ^diagnostics
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:615
fn validate_interrupt_handlers(machine: TargetMachine, hardware: TargetHardwareUse, errors: &[TargetMachineError]) Never! {
    loop handler in hardware.interrupt_handlers {
        interrupt :: machine.hardware.interrupt(handler.interrupt) ?? {
            errors.push(TargetMachineError.UnknownInterrupt{interrupt: handler.interrupt.clone()})
            continue
        }
        if interrupt.bounded && !handler.bounded {
            errors.push(TargetMachineError.InterruptHandlerUnbounded{interrupt: interrupt.name.clone(), handler: handler.handler.clone()})
        }
        loop effect in handler.effects {
            baseline_forbidden :: effect_is_allocation(effect) || effect_is_wait(effect)
            profile_forbidden := false
            loop bound in interrupt.forbidden_effects { if effect_covers(bound, effect) { profile_forbidden = true; break } }
            if !profile_forbidden {
                loop bound in handler.forbidden_effects { if effect_covers(bound, effect) { profile_forbidden = true; break } }
            }
            if baseline_forbidden || profile_forbidden {
                errors.push(TargetMachineError.InterruptEffectForbidden{interrupt: interrupt.name.clone(), handler: handler.handler.clone(), effect: effect.clone()})
            }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:652
fn effect_is_allocation(effect: String) -> Bool Never! {
    effect == "Mem" || effect == "Mem.Alloc" || effect.starts_with("Mem.Alloc(")
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:656
fn effect_is_wait(effect: String) -> Bool Never! {
    if effect == "Time" -> return true
    if effect == "Time.Wait" || effect.starts_with("Time.Wait.") -> return true
    if effect == "Time.Sleep" || effect.starts_with("Time.Sleep.") -> return true
    effect_root(effect) == "Time" && effect.ends_with(".Wait")
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:669
fn validate_dma_operations(machine: TargetMachine, hardware: TargetHardwareUse, errors: &[TargetMachineError]) Never! {
    in_flight := [String:String]{}
    loop operation in hardware.dma_operations {
        if operation.operation == {
            .UseBuffer -> {
                if operation.owner != TargetDmaOwner.Cpu {
                    errors.push(TargetMachineError.DmaOwnershipMismatch{channel: operation.channel.clone(), buffer: operation.buffer.clone(), expected: .Cpu, actual: operation.owner})
                }
                if in_flight.get(operation.buffer) == .Val(channel) {
                    errors.push(TargetMachineError.DmaBufferUnavailable{channel: channel.clone(), buffer: operation.buffer.clone()})
                }
            }
            .Start | .Wait -> {
                channel :: machine.hardware.dma_channel(operation.channel) ?? {
                    errors.push(TargetMachineError.UnknownDmaChannel{channel: operation.channel.clone()})
                    continue
                }
                if channel.ownership != TargetDmaOwnership.Transfer -> continue
                if operation.operation == {
                    .Start -> {
                        if operation.owner != TargetDmaOwner.Cpu {
                            errors.push(TargetMachineError.DmaOwnershipMismatch{channel: channel.name.clone(), buffer: operation.buffer.clone(), expected: .Cpu, actual: operation.owner})
                        }
                        already_active :: in_flight.contains_key(operation.buffer)
                        in_flight[operation.buffer.clone()] = channel.name.clone()
                        if already_active {
                            errors.push(TargetMachineError.DmaStartWhileInFlight{channel: channel.name.clone(), buffer: operation.buffer.clone()})
                        }
                    }
                    .Wait -> {
                        if operation.owner != TargetDmaOwner.Device {
                            errors.push(TargetMachineError.DmaOwnershipMismatch{channel: channel.name.clone(), buffer: operation.buffer.clone(), expected: .Device, actual: operation.owner})
                        }
                        if in_flight.get(operation.buffer) == {
                            .None -> errors.push(TargetMachineError.DmaWaitWithoutTransfer{channel: channel.name.clone(), buffer: operation.buffer.clone()})
                            .Val(active) -> {
                                if active != channel.name {
                                    errors.push(TargetMachineError.DmaWaitChannelMismatch{channel: channel.name.clone(), buffer: operation.buffer.clone()})
                                } else { _ :: in_flight.remove(operation.buffer) }
                            }
                        }
                    }
                    .UseBuffer -> unreachable()
                }
            }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:756
fn diagnostic_for_error(machine: TargetMachine, error: TargetMachineError) -> Diagnostic Never! {
    target :: target_name(machine)
    if error == {
        .CoreApiUnavailable(api, required, available) -> Diagnostic.from_row("E3310", [(String, String)]{("api", api), ("required", required.as_str()), ("available", available.as_str()), ("target", target)}, None)
        .HeapRequiresAllocator | .MissingAllocatorPolicy -> Diagnostic.from_row("E3303", [(String, String)]{}, None)
        .MissingTargetCapability(capability) | .HostedCapabilityRequiresOs(capability) -> Diagnostic.from_row("E3311", [(String, String)]{("target", target), ("capability", capability)}, None)
        .InvalidProviderContract(capability, provider, sha256) -> Diagnostic.from_row("E3312", [(String, String)]{("target", target), ("capability", capability), ("provider", provider), ("sha256", sha256)}, None)
        .MmioOutsideRegion(address, size_bytes) -> mmio_diagnostic(target, "address 0x{address:X} ({size_bytes} bytes) is outside a declared MMIO region")
        .MmioMissingUnsafeGate(address) -> mmio_diagnostic(target, "address 0x{address:X} has no #Unsafe gate")
        .MmioEmptyUnsafeReason(address) -> mmio_diagnostic(target, "address 0x{address:X} has an empty #Unsafe reason")
        _ -> {
            (fact, detail) :: generic_detail(error)
            Diagnostic.from_row("E3314", [(String, String)]{("target", target), ("fact", fact), ("detail", detail)}, None)
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:832
fn target_name(machine: TargetMachine) -> String from machine {
    name := machine.name.trim() // #4303
    if name.is_empty() -> machine.triple else -> machine.name
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:840
fn mmio_diagnostic(target: String, detail: String) -> Diagnostic Never! {
    Diagnostic.from_row("E3313", [(String, String)]{("target", target), ("detail", detail)}, None)
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:844
fn generic_detail(error: TargetMachineError) -> (String, String) Never! {
    if error == {
        .MissingTargetTriple -> ("target triple", "the selected target triple is empty")
        .MissingMemoryKind(kind) -> ("memory", "the target is missing a {memory_kind_name(kind)} memory region")
        .DuplicateMemoryRegion(name) -> ("memory", "memory region `{name}` is declared more than once")
        .EmptyMemoryRegion(name) -> ("memory", "memory region `{name}` has zero size")
        .MemoryAddressOverflow(name) -> ("memory", "memory region `{name}` overflows the address space")
        .OverlappingMemoryRegions(first, second) -> ("memory", "memory regions `{first}` and `{second}` overlap")
        .MissingLinkerInput -> ("linker", "the no-OS target has no linker input")
        .LinkerFileMissingPath -> ("linker", "the linker file path is empty")
        .LinkerFileMissingHash(path) -> ("linker", "linker file `{path}` has no valid sha256 provenance")
        .AllocatorRegionUnknown(region) -> ("allocator", "allocator region `{region}` does not exist")
        .AllocatorRegionNotRam(region) -> ("allocator", "allocator region `{region}` is not RAM")
        .AllocatorRegionTooSmall(region, requested_bytes, available_bytes) -> ("allocator", "allocator region `{region}` has {available_bytes} bytes but needs {requested_bytes}")
        .HostedAllocatorRequiresOs -> ("allocator", "a hosted system allocator cannot be selected on a no-OS target")
        .MissingPanicPolicy -> ("panic", "the no-OS target has no panic policy")
        .RamOverflow(used_bytes, ram_bytes) -> ("memory", "RAM use ({used_bytes} bytes) exceeds {ram_bytes} bytes")
        .HostedHasNoLinkerScript -> ("linker", "hosted targets do not have a generated linker script")
        .HostedHasNoStartup -> ("startup", "hosted targets do not have generated startup glue")
        .UnsupportedStartupTriple(triple) -> ("startup", "target triple `{triple}` has no startup generator")
        .ExecutionTierUnsupported(tier, machine) -> ("execution", "target machine `{machine}` does not support the `{tier}` tier")
        .FirmwareToolchainMissing(tool) -> ("toolchain", "required firmware tool `{tool}` is unavailable")
        .FirmwareBuildFailed(detail) -> ("firmware", detail.clone())
        .SizeBudgetExceeded(report) -> ("size budget", "artifact={report.artifact_bytes} flash={report.flash_bytes} ram={report.ram_bytes} used_ram={report.ram_used_bytes}")
        .HardwareFactsMissingSvd -> ("hardware profile", "register, interrupt, or DMA facts require SVD provenance")
        .InvalidHardwareSvd(source, sha256) -> ("hardware profile", "SVD `{source}` has invalid sha256 provenance `{sha256}`")
        .HardwareFactEmptyName(kind) -> ("hardware profile", "{kind} fact has an empty name")
        .DuplicateRegisterBlock(name) -> ("registers", "register block `{name}` is declared more than once")
        .RegisterBlockEmpty(name) -> ("registers", "register block `{name}` has zero size")
        .RegisterBlockAddressOverflow(name) -> ("registers", "register block `{name}` overflows the address space")
        .RegisterBlockOutsideRegion(name, address, size_bytes) -> ("registers", "register block `{name}` at 0x{address:X} ({size_bytes} bytes) is outside a declared MMIO region")
        .DuplicateRegister(block, register) -> ("registers", "register `{register}` is declared more than once in `{block}`")
        .RegisterAddressOverflow(block, register) -> ("registers", "register `{block}.{register}` overflows the address space")
        .RegisterOutsideBlock(block, register) -> ("registers", "register `{block}.{register}` lies outside its block")
        .UnknownRegisterBlock(block) -> ("registers", "register block `{block}` is not in the target SVD")
        .UnknownRegister(block, register) -> ("registers", "register `{block}.{register}` is not in the target SVD")
        .RegisterWidthMismatch(block, register, expected, actual) -> ("registers", "`{block}.{register}` requires {expected.as_str()} but operation requested {actual.as_str()}")
        .RegisterReadDenied(block, register) -> ("registers", "register `{block}.{register}` is not readable")
        .RegisterWriteDenied(block, register) -> ("registers", "register `{block}.{register}` is not writable")
        .DuplicateInterrupt(name) -> ("interrupts", "interrupt `{name}` is declared more than once")
        .DuplicateInterruptVector(vector) -> ("interrupts", "interrupt vector {vector} is declared more than once")
        .InvalidInterruptEffect(interrupt, effect) -> ("interrupts", "interrupt `{interrupt}` has invalid effect `{effect}`")
        .UnknownInterrupt(interrupt) -> ("interrupts", "interrupt `{interrupt}` is not in the target vector table")
        .InterruptEffectForbidden(interrupt, handler, effect) -> ("interrupts", "handler `{handler}` for `{interrupt}` uses forbidden effect `{effect}`")
        .InterruptHandlerUnbounded(interrupt, handler) -> ("interrupts", "handler `{handler}` for `{interrupt}` is not bounded")
        .DuplicateDmaChannel(name) -> ("DMA", "DMA channel `{name}` is declared more than once")
        .DuplicateDmaChannelNumber(channel) -> ("DMA", "DMA channel number {channel} is declared more than once")
        .DmaTransferSizeZero(channel) -> ("DMA", "DMA channel `{channel}` has a zero transfer limit")
        .UnknownDmaChannel(channel) -> ("DMA", "DMA channel `{channel}` is not in the target profile")
        .DmaOwnershipMismatch(channel, buffer, expected, actual) -> ("DMA", "DMA `{channel}` buffer `{buffer}` expects {dma_owner_name(expected)} ownership, got {dma_owner_name(actual)}")
        .DmaStartWhileInFlight(channel, buffer) -> ("DMA", "DMA `{channel}` cannot start while buffer `{buffer}` is in flight")
        .DmaWaitWithoutTransfer(channel, buffer) -> ("DMA", "DMA `{channel}` cannot wait for buffer `{buffer}` before start")
        .DmaBufferUnavailable(channel, buffer) -> ("DMA", "buffer `{buffer}` is unavailable while DMA `{channel}` owns it")
        .DmaWaitChannelMismatch(channel, buffer) -> ("DMA", "DMA `{channel}` does not own in-flight buffer `{buffer}`")
        _ -> ("target", "the selected target fact is invalid")
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:1089
fn memory_kind_name(kind: MemoryKind) -> String Never! {
    if kind == { .Flash -> "flash" .Ram -> "RAM" .Mmio -> "MMIO" .Reserved -> "reserved" }
}
// Rust: crates/jet-sema/src/Sema/Bundle/TargetMachine.rs:1098
fn dma_owner_name(owner: TargetDmaOwner) -> String Never! {
    if owner == { .Cpu -> "CPU" .Device -> "device" }
}
