// PORT-PENDING 0353 crates-jet-sema-src-sema-bundle-itemreuse: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:1-865
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! #2517 stage S3R: item reuse inside a checked package.
//RS //!
//RS //! In a package-record session (`PackageSeal`), every function and method
//RS //! body of a checked module has an item check key: the module's reads (the
//RS //! check environment, and the declarations and templates of every module
//RS //! its package and its imports reach), the item's identity, and its
//RS //! span-free syntax. A body whose key has a stored record is not checked
//RS //! again. The record's outputs (effect summaries, address-taken names, name
//RS //! references, import-alias uses, exact-`Int` use) are seeded where the
//RS //! check would have produced them. Callers read signatures, not effect
//RS //! rows, so a body edit that changes a summary keeps its callers green; the
//RS //! effect, failure and post phases solve again over the seeded summaries
//RS //! (item-level early cutoff).
//RS //!
//RS //! A body is recorded only when its check produced no diagnostic, pending
//RS //! diagnostic, publication, discovered input, or structure fact. The record
//RS //! carries the checked-body delta (`BodyDelta`): the parts of the function
//RS //! the checker rewrote, as they were after the check. A reuse installs them
//RS //! on the parsed function, so the bundle after a reuse is the bundle a cold
//RS //! check builds and every later phase that walks bodies sees the same input.
//RS //! A delta is recorded only when installing it on the parsed function
//RS //! rebuilds the checked function exactly; the key covers the item's source
//RS //! text, so its spans are exact, and the record's text and delta digests are
//RS //! verified again when it is replayed.
//RS //!
//RS //! Spans in a record are relative to the item, so an edit that moves an
//RS //! item does not invalidate it. A reference into another declaration is
//RS //! anchored to the nearest callable of the defining module and must name
//RS //! the same source text when replayed; otherwise the body is checked again.
//RS 
//RS use super::BodyProducts;
//RS use super::PackageSeal::{
//RS     decode_summary, encode_summary, map_edges, to_alias, to_identity, PackageRecordStore,
//RS };
//RS use crate::Diagnostics::{Diagnostic, Span};
//RS use crate::Sema::Effects::EffectSummary;
//RS use crate::AST::{Func, Item, LoadedModule, ProgramBundle};
//RS use jet_foundation::Names::{NameLedger, NameReference};
//RS use jet_foundation::PackageIdentity::KeyHasher;
//RS use jet_foundation::RecordCodec::{
//RS     encode_record, record_map, RecordReader, RecordSection, RecordValue,
//RS };
//RS use std::collections::{BTreeSet, HashMap, HashSet};
//RS use std::sync::{Arc, Mutex};
