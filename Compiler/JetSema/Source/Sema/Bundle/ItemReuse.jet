    // Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:781
    fn decode(module: Int, span: Span, item_text: String, bytes: [U8]) -> Seed? {
        start :: span.start
        reader :: RecordReader.open_schema(bytes, ITEM_CHECK_SCHEMA) !? return None
        item :: reader.element(SECTION_ITEM, 0) !? return None
        recorded_text :: item.field("text") !? return None
        if (recorded_text.as_str() !? return None) != item_text -> return None
        body_field :: item.field("body") !? return None
        body :: if body_field == .Bytes(value) -> value else -> return None
        checked :: item.field("checked") !? return None
        if sha256_hex(body) != (checked.as_str() !? return None) -> return None
        summaries := [(String, EffectSummary)][]
        entries :: item.field("summaries") !? return None
        loop entry in entries.as_list() !? return None {
            key_field :: entry.field("key") !? return None
            key :: key_field.as_str() !? return None
            summary_field :: entry.field("summary") !? return None
            summary := decode_summary(summary_field) !? return None
            map_edges(&summary, fn(edge) { to_alias(edge, self.aliases) })
            _ :: each_span(&summary, fn(s: &Span) { s = Span.new(s.start + start, s.end + start); true })
            &summaries.push((key, summary))
        }
        references := [(Int, Int, NameReference)][]
        refs :: item.field("references") !? return None
        loop entry in refs.as_list() !? return None {
            number :: fn(name: String) -> Int? {
                field :: entry.field(name) !? return None
                Val(field.as_usize() !? return None)
            }
            module_field :: entry.field("module") !? return None
            def_module :: self.by_identity.get(module_field.as_str() !? return None) ?? return None
            offset :: number("offset") ?? return None
            index :: number("index") ?? return None
            callables :: (self.anchors.get(def_module) ?? return None).callables
            mode_field :: entry.field("mode") !? return None
            def_start :: if (mode_field.as_str() !? return None) == {
                "own" -> if def_module == module -> start + offset else -> return None
                "in" -> (callables.get(index) ?? return None).0 + offset
                "after" -> (callables.get(index) ?? return None).1 + offset
                "file" -> offset
                else -> return None
            }
            def_end :: def_start + (number("len") ?? return None)
            text_field :: entry.field("text") !? return None
            text :: text_field.as_str() !? return None
            if !text.is_empty() && (self.text(def_module, def_start, def_end) ?? return None) != text -> return None
            identity :: entry.field("identity") !? return None
            kind :: entry.field("kind") !? return None
            &references.push((start + (number("start") ?? return None), start + (number("end") ?? return None), NameReference{
                module_path: self.paths[def_module] ?? return None,
                kind: kind.as_str() !? return None,
                def_span: Span.new(def_start, def_end),
                semantic_identity: if identity.is_null() -> None else -> Val(identity.as_str() !? return None),
            }))
        }
        alias_uses := [(Int, Span)][]
        uses :: item.field("alias_uses") !? return None
        loop entry in uses.as_list() !? return None {
            module_field :: entry.field("module") !? return None
            alias_module :: self.by_identity.get(module_field.as_str() !? return None) ?? return None
            start_field :: entry.field("start") !? return None
            end_field :: entry.field("end") !? return None
            s :: Span.new(start_field.as_usize() !? return None, end_field.as_usize() !? return None)
            text_field :: entry.field("text") !? return None
            if (self.text(alias_module, s.start, s.end) ?? return None) != (text_field.as_str() !? return None) -> return None
            &alias_uses.push((alias_module, s))
        }
        addresses :: item.field("addr_taken") !? return None
        exact :: item.field("exact_int") !? return None
        Val(Seed{summaries: summaries, addr_taken: addresses.str_list() !? return None, exact_int: exact.as_bool() !? return None, references: references, alias_uses: alias_uses, body: body.clone()})
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:93
struct Pending { touched: [String] = [], records: [(String, [U8])] = [] }
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:98
STATE := Mutex<Arc<ItemState>?>.new(None) // GATE #4494: static native lock.
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:100
fn current() -> Arc<ItemState>? {
    STATE.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() }).clone()
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:111
fn begin(store: Arc<PackageRecordStore>, bundle: ProgramBundle, ledger: NameLedger, environment: String, checked: [Int], package_mates: [[Int]], identity: [String?], aliases: [String:String]) {
    displays := [String:Int]{}
    loop (index, module) in bundle.modules -> displays[module.display] = index
    dependencies :: incremental_module_dependencies_with_ledger(bundle, ledger)
    declarations := [String][]
    loop module in bundle.modules {
        hasher := KeyHasher.new(ITEM_CHECK_SCHEMA)
        &hasher.field(sha256_hex(incremental_module_interface(module))).field(template_digest(module))
        &declarations.push(hasher.finish())
    }
    modules := [Int:ModuleItems]{}
    loop module in checked {
        reads := [Int:Bool]{}
        pending := package_mates[module].clone()
        &pending.push(module)
        loop {
            next_module :: &pending.pop() ?? break
            if reads.has_key(next_module) -> next
            reads[next_module] = true
            if dependencies.get(bundle.modules[next_module].display) == .Val(imported) {
                loop display in imported { if displays.get(display) == .Val(index) -> &pending.push(index) }
            }
        }
        hasher := KeyHasher.new(ITEM_CHECK_SCHEMA)
        &hasher.field(environment)
        ordered_reads := reads.keys().collect()
        &ordered_reads.sort()
        loop read in ordered_reads -> &hasher.field(identity[read] ?? bundle.modules[read].display).field(declarations[read])
        modules[module] = ModuleItems{reads: hasher.finish(), display: bundle.modules[module].display}
    }
    paths := [String?][]
    by_path := [String:Int]{}
    by_identity := [String:Int]{}
    anchors := [Anchors][]
    loop (index, module) in bundle.modules {
        path :: ledger.module_path(index)
        &paths.push(path)
        if path == .Val(value) -> by_path[value] = index
        if identity[index] == .Val(value) -> by_identity[value] = index
        &anchors.push(Anchors{source: module.source.clone(), callables: callable_spans(module.items)})
    }
    identities := [String:String]{}
    loop (id, alias) in aliases -> identities[alias] = id
    state := STATE.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
    state = Val(Arc.new(ItemState{store: store, modules: modules, anchors: anchors, paths: paths, by_path: by_path, identity: identity.clone(), by_identity: by_identity, identities: identities, aliases: aliases, tally: Mutex.new([Int:Tally]{}), pending: Mutex.new(Pending{})}))
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:216
fn end() {
    state := STATE.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
    taken :: &state.take()
    if taken == .Val(owner) {
        pending := owner.pending.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
        work :: std.mem.take(&pending)
        if !work.touched.is_empty() || !work.records.is_empty() -> owner.store.publish_batch(ITEM_CHECK_SCHEMA, work.touched, ^work.records)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:229
fn tracks(module: Int) -> Bool {
    state :: current() ?? return false
    state.modules.has_key(module)
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:235
fn package_detail(modules: [Int]) -> String? {
    state :: current() ?? return None
    tally :: state.tally.lock().unwrap_or_else(fn(poisoned) { poisoned.into_inner() })
    seen := false
    reused := 0
    unrecordable := [String:Int]{}
    checked := [String][]
    loop module in modules {
        if tally.get(module) == .Val(entry) {
            seen = true
            reused += entry.reused
            loop (reason, count) in entry.unrecordable -> unrecordable[reason] = (unrecordable.get(reason) ?? 0) + count
            &checked.extend(entry.checked)
        }
    }
    if !seen -> return None
    &checked.sort()
    names :: if !checked.is_empty() && checked.len() <= 8 -> " [{checked.join(", ")}]" else -> ""
    total := 0
    reason_keys := unrecordable.keys().collect()
    &reason_keys.sort()
    reason_rows := [String][]
    loop reason in reason_keys {
        count :: unrecordable[reason]
        total += count
        &reason_rows.push("{reason}: {count}")
    }
    reasons :: if reason_rows.is_empty() -> "" else -> " ({reason_rows.join(", ")})"
    Val("items: {reused} reused, {checked.len()} checked{names}, {total} not recordable{reasons}")
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:281
fn reuse(module: Int, cache_key: String, function: &Func, owner: String?, raw_protocol_return: Bool, ledger: &NameLedger, products: &BodyProducts) -> Bool {
    state :: current() ?? return false
    items :: state.modules.get(module) ?? return false
    text :: state.text_digest(module, function.span) ?? return false
    key :: item_key(items.reads, cache_key, function, text, owner, raw_protocol_return)
    bytes :: state.store.load_untouched(ITEM_CHECK_SCHEMA, key) ?? return false
    seed :: state.decode(module, function.span, text, bytes) ?? return false
    _ :: BodyDelta.apply(&function, seed.body) ?? return false
    &products.summaries.extend(seed.summaries)
    &products.addr_taken.extend(seed.addr_taken)
    products.uses_exact_int = products.uses_exact_int || seed.exact_int
    loop (start, end, reference) in seed.references {
        if state.paths[module] == .Val(path) -> ledger.record_reference(path, start, end, reference)
    }
    loop (alias_module, span) in seed.alias_uses -> ledger.record_alias_use(alias_module, span)
    state.defer(fn(p: &Pending) { &p.touched.push(key) })
    state.count(module, fn(t: &Tally) { t.reused += 1 })
    true
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:329
fn record(module: Int, cache_key: String, pristine: Func, checked: Func, owner: String?, raw_protocol_return: Bool, diagnostics: [Diagnostic], products: BodyProducts, ledger: NameLedger) {
    state :: current() ?? return
    items :: state.modules.get(module) ?? return
    name :: cache_key.strip_prefix("{items.display}::") ?? cache_key
    reason := None as String?
    if !diagnostics.is_empty() -> reason = Val("diagnostics")
    else if !products.pending_diagnostics.is_empty() -> reason = Val("pending diagnostics")
    else if !products.devtools_publications.is_empty() -> reason = Val("publications")
    else if !products.embed_inputs.is_empty() || products.ran_ct_evaluator -> reason = Val("compile-time evaluation")
    else if !ledger.structure_facts().is_empty() -> reason = Val("structure facts")
    state.count(module, fn(t: &Tally) { &t.checked.push(name) })
    mark :: fn(why: String) { state.count(module, fn(t: &Tally) { t.unrecordable[why] = (t.unrecordable.get(why) ?? 0) + 1 }) }
    if reason == .Val(why) { mark(why); return }
    span :: pristine.span
    text :: state.text_digest(module, span) ?? { mark("item span outside its module"); return }
    key :: item_key(items.reads, cache_key, pristine, text, owner, raw_protocol_return)
    delta :: verified_delta(^pristine, checked) !? { mark(error.message); return }
    bytes :: state.encode(module, cache_key, span, text, delta, products, ledger) !? { mark(error.message); return }
    state.defer(fn(p: &Pending) { &p.records.push((key, bytes)) })
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:391
fn verified_delta(pristine: Func, checked: Func) -> [U8] Err! {
    parsed := ^pristine
    delta :: BodyDelta.encode(parsed, checked)!
    _ :: BodyDelta.apply(&parsed, delta) ?? return Err("delta does not decode")
    if !same_debug(parsed, checked) -> return Err("delta does not rebuild the checked body")
    delta
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:403
struct Against {
    rest: String,
    // Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:409
    fn write_str(text: String) Err! {
        remainder :: self.rest.strip_prefix(text) ?? return Err("format error")
        self.rest = remainder // #4303: borrowed remaining render view.
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:416
RENDERED :: ThreadLocal<RefCell<String>>.new(fn() { RefCell.new("") }) // GATE #4494
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:403
fn same_debug<T: Debug>(actual: T, expected: T) -> Bool {
    RENDERED.with(fn(buffer) {
        rendered := buffer.borrow_mut()
        &rendered.clear()
        write_debug(&rendered, expected) !? return false
        against := Against{rest: rendered}
        write_debug(&against, actual) !? return false
        against.rest.is_empty()
    })
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:431
fn item_key(reads: String, cache_key: String, function: Func, text: String, owner: String?, raw_protocol_return: Bool) -> String {
    hasher := KeyHasher.new(ITEM_CHECK_SCHEMA)
    &hasher.field(reads).field(cache_key).field(owner ?? "").field(if raw_protocol_return -> "raw" else -> "plain").field(text).field(sha256_hex(canonical_fragment(function)))
    hasher.finish()
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:454
fn template_digest(module: LoadedModule) -> String {
    // Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:455
    add :: fn(bytes: &[U8], function: Func, generic_owner: Bool) {
        if generic_owner || !function.type_params.is_empty() || function.is_inline_always -> &bytes.extend(canonical_fragment(function))
    }
    generic_types := [String:Bool]{}
    loop item in module.items {
        if item == {
            .Struct(d) -> if !d.type_params.is_empty() -> generic_types[d.name] = true
            .Enum(d) -> if !d.type_params.is_empty() -> generic_types[d.name] = true
            else -> {}
        }
    }
    bytes := [U8][]
    loop item in module.items {
        if item == {
            .Func(f) -> add(&bytes, f, false)
            .Struct(d) -> {
                generic :: !d.type_params.is_empty()
                loop f in d.methods -> add(&bytes, f, generic)
                loop block in d.trait_impls { loop f in block.methods -> add(&bytes, f, generic) }
            }
            .Enum(d) -> {
                generic :: !d.type_params.is_empty()
                loop f in d.methods -> add(&bytes, f, generic)
                loop block in d.trait_impls { loop f in block.methods -> add(&bytes, f, generic) }
            }
            .Impl(i) -> { loop f in i.methods -> add(&bytes, f, generic_types.has_key(i.type_name)) }
            .Trait(d) -> &bytes.extend(canonical_fragment(d))
            else -> {}
        }
    }
    sha256_hex(bytes)
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:514
fn callable_spans(items: [Item]) -> [(Int, Int)] {
    spans := [(Int, Int)][]
    push :: fn(f: Func) { &spans.push((f.span.start, f.span.end)) }
    loop item in items {
        if item == {
            .Func(f) -> push(f)
            .Struct(d) -> { loop f in d.methods -> push(f); loop block in d.trait_impls { loop f in block.methods -> push(f) } }
            .Enum(d) -> { loop f in d.methods -> push(f); loop block in d.trait_impls { loop f in block.methods -> push(f) } }
            .Impl(i) -> { loop f in i.methods -> push(f) }
            else -> {}
        }
    }
    &spans.sort()
    spans
}
// Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:541
fn each_span(summary: &EffectSummary, visit: Fn(&Span) -> Bool) -> Bool {
    ok := true
    go :: fn(s: &Span) { result :: visit(&s); ok = ok && result }
    loop (_, s) in &summary.direct_spans -> go(&s)
    if summary.maximal_span == .Val(s) { go(&s); summary.maximal_span = Val(s) }
    loop region in &summary.regions -> go(&region.caps_span)
    loop delegation in &summary.authority_delegations { go(&delegation.scope_span); go(&delegation.span) }
