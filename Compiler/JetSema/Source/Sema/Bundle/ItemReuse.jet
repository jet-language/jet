use jet_foundation.[Diagnostic, Span, Func, Item, LoadedModule, ProgramBundle, NameLedger, NameReference, KeyHasher, encode_record, record_map, RecordReader, RecordSection, RecordValue, sha256_hex]
use std.sync.[Arc, Mutex] // GATE #4494: native shared ownership and poison-aware locks.
use std.cell.[RefCell, ThreadLocal] // GATE #4494: retained per-thread render buffer.
use std.fmt.[Debug, Write, write_debug] // GATE #4494: streaming Debug writer.
use jet_sema.CanonicalAST.canonical_fragment
use jet_sema.Sema.Bundle.PackageSeal.[decode_summary, encode_summary, map_edges, to_alias, to_identity, PackageRecordStore]

