//RS /// Where a referenced declaration sits, relative to something that moves
//RS /// with it.
//RS enum Anchor {
//RS     /// Inside the referencing item; offset from its start.
//RS     Own,
//RS     /// Inside callable `n` of the defining module; offset from its start.
//RS     In(usize),
//RS     /// After callable `n` of the defining module; offset from its end.
//RS     After(usize),
//RS     /// Before every callable; offset from the start of the file.
//RS     File,
//RS }
