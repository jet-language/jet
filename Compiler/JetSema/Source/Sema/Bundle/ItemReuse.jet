            &summaries.push(record_map([("key", RecordValue.str(key)), ("summary", encoded)]))
        }
        sites := ledger.references().iter().collect()
        &sites.sort_by(fn(left, right) { (left.0.1, left.0.2, left.0.0).compare((right.0.1, right.0.2, right.0.0)) })
        references := [RecordValue][]
