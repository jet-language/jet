    // Rust: crates/jet-sema/src/Sema/Bundle/ItemReuse.rs:632
    fn encode(module: Int, cache_key: String, span: Span, item_text: String, delta: [U8], products: BodyProducts, ledger: NameLedger) -> [U8] Err! {
        start :: span.start
        end :: span.end
        own_path :: self.paths[module] ?? return Err("module has no ledger path")
        keys := products.summaries.keys().collect()
